// Peano arithmetic, imported: the theory lives in peano.bpa; this file
// demonstrates namespaced imports, selective aliases, and citation across the
// import boundary.

import peano <<< "peano.bpa"

// aliases are views, not copies: local names for the SAME entities, so
// theorems proved through either spelling interoperate
sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add

// Strategy: the heavy lifting happened in peano.bpa; cite it across the
// boundary. The statement deliberately mixes aliased and qualified spellings —
// they denote the same entities, so the theorem is exactly addIsCommutative.
theorem addStillCommutes: forall a, b: Nat; add(a, b) = peano.add(b, a)
proof
  @conclusion |
    forall a, b: Nat; add(a, b) = peano.add(b, a)
    [using import(peano) addIsCommutative]
qed
