// Gauss's summation formula: 1 + 2 + ... + n = n(n+1)/2.
//
// This is the automation-assisted twin of examples/gauss-pure.b4m: same
// theory, same theorem, but the sum-reordering that the by-hand version
// needed a 40-line `sumSwap` exchange lemma (plus a tower of forall_elim
// specializations) for is now a single `[using assoc_commut]` step. `ac` reorders a sum
// by associativity and commutativity over arbitrary opaque summands — here
// the opaque term is sumTo(k) — and emits a pure kernel certificate, so the
// whole file still passes `--pure`.
//
// Nat has no division, so we prove the equivalent DOUBLED form
//   2 * sumTo(n) = n * (n + 1).

import peano <<< "std/peano.b4m"

// -- the arithmetic vocabulary (aliased from std/peano) ---------------------

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
func mul = peano.mul

// recursion facts, plus the AC lemmas `ac` looks up by name
axiom addZeroLeft = peano.addZeroLeft
axiom addSuccLeft = peano.addSuccLeft
axiom mulZeroLeft = peano.mulZeroLeft
axiom mulSuccLeft = peano.mulSuccLeft
theorem addZeroRight = peano.addZeroRight
theorem addSuccRight = peano.addSuccRight
theorem mulZeroRight = peano.mulZeroRight
theorem mulSuccRight = peano.mulSuccRight
theorem addIsAssociative = peano.addIsAssociative
theorem addIsCommutative = peano.addIsCommutative
theorem addLeftSwap = peano.addLeftSwap

// the induction schema (a stored form; checked at each instantiation)
axiom induction = peano.induction

// -- the summation function -------------------------------------------------

// sumTo(n) = 0 + 1 + ... + n, defined by recursion on n.
func sumTo(n: Nat) => Nat
axiom sumToZero: sumTo(ZERO) = ZERO
axiom sumToSucc: forall n: Nat; sumTo(succ(n)) = add(sumTo(n), succ(n))

// -- the theorem ------------------------------------------------------------

// 2 * sumTo(n) = n * (n + 1). Induction on n:
//   base   2 * sumTo(0) = 0 = 0 * 1
//   step   assuming 2 * sumTo(k) = k * (k+1),
//          2 * sumTo(k+1) = 2 * (sumTo(k) + (k+1))
//                         = 2*sumTo(k) + 2*(k+1)       ([using assoc_commut] regroups)
//                         = k*(k+1) + 2*(k+1)          (inductive hypothesis)
//                         = (k+1) * (k+2)              (simplify)
theorem gaussSum: forall n: Nat; add(sumTo(n), sumTo(n)) = mul(n, succ(n))
proof
  // base case: 2 * sumTo(0) = 0 = 0 * succ(0)
  @base-case |
    add(sumTo(ZERO), sumTo(ZERO)) = mul(ZERO, succ(ZERO))
    [using simplify sumToZero addZeroLeft mulZeroLeft]

  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume add(sumTo(k), sumTo(k)) = mul(k, succ(k)) {
          @inductive-hypothesis |
            add(sumTo(k), sumTo(k)) = mul(k, succ(k))
            [by hypothesis given-inductive-hypothesis]

          // unfold both copies of sumTo(succ k) = sumTo(k) + succ(k)
          @unfolded |
            add(sumTo(succ(k)), sumTo(succ(k))) = add(add(sumTo(k), succ(k)), add(sumTo(k), succ(k)))
            [using simplify sumToSucc]

          // regroup (s+c)+(s+c) into (s+s)+(c+c) — one linear-arithmetic step
          @regrouped |
            add(sumTo(succ(k)), sumTo(succ(k))) = add(add(sumTo(k), sumTo(k)), add(succ(k), succ(k)))
            [using arithmetic unfolded]

          // fold the inductive hypothesis into the first summand
          @with-ih |
            add(sumTo(succ(k)), sumTo(succ(k))) = add(mul(k, succ(k)), add(succ(k), succ(k)))
            [using arithmetic regrouped inductive-hypothesis]

          // k*(k+1) + 2*(k+1) = (k+1)*(k+2): `arithmetic` expands both products itself.
          @succ-case |
            add(sumTo(succ(k)), sumTo(succ(k))) = mul(succ(k), succ(succ(k)))
            [using arithmetic with-ih]
        }
      @induction-step-at-k |
        add(sumTo(k), sumTo(k)) = mul(k, succ(k)) -> add(sumTo(succ(k)), sumTo(succ(k))) = mul(succ(k), succ(succ(k)))
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; add(sumTo(k), sumTo(k)) = mul(k, succ(k)) -> add(sumTo(succ(k)), sumTo(succ(k))) = mul(succ(k), succ(succ(k)))
    [by forall_intro induction-step]

  @conclusion |
    forall n: Nat; add(sumTo(n), sumTo(n)) = mul(n, succ(n))
    [using instantiation induction((fun k: Nat => add(sumTo(k), sumTo(k)) = mul(k, succ(k)))) base-case induction-step-for-all-k]
qed
