// Gauss's summation formula: 1 + 2 + ... + n = n(n+1)/2.
//
// This is the by-hand version: the one sum-reordering that commutes past the
// opaque term sumTo(k) is proved as an explicit exchange lemma up front. The
// automation-assisted twin, examples/gauss.bpa, replaces that lemma with a
// single `[using assoc_commut]` step — diff them to see what the AC tactic buys.
//
// Nat has no division, so we prove the equivalent DOUBLED form
//   2 * sumTo(n) = n * (n + 1)
// which is exact over the naturals. The summation function itself is
// axiomatized by its recursion equations (as any Peano development
// axiomatizes add and mul); the closed form is the theorem we PROVE, by
// induction on n.
//
// The arithmetic base is imported from the standard library. The
// equational grind in each case is handled by `simplify`, which
// normalizes with the recursion equations as left-to-right rewrite rules
// and emits a pure kernel certificate. Associativity is a usable rewrite
// rule (it right-nests sums to a canonical shape); commutativity is NOT
// (an unoriented reorder rule loops the rewriter), so the one place a sum
// must be re-ordered uses an explicit exchange lemma proven up front.

import peano <<< "std/peano.bpa"

// -- the arithmetic vocabulary (aliased from std/peano) ---------------------

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
func mul = peano.mul

// recursion facts, oriented left-to-right; addIsAssociative right-nests sums
axiom addZeroLeft = peano.addZeroLeft
axiom addSuccLeft = peano.addSuccLeft
axiom mulZeroLeft = peano.mulZeroLeft
axiom mulSuccLeft = peano.mulSuccLeft
theorem addZeroRight = peano.addZeroRight
theorem addSuccRight = peano.addSuccRight
theorem mulZeroRight = peano.mulZeroRight
theorem mulSuccRight = peano.mulSuccRight
theorem addIsAssociative = peano.addIsAssociative
theorem addLeftSwap = peano.addLeftSwap

// the induction schema (a stored form; checked at each instantiation)
axiom induction = peano.induction

// -- a reusable additive-exchange lemma -------------------------------------

// (a + b) + (c + d) = (a + c) + (b + d). Pure rearrangement, proven with
// directed single rewrites so it holds for ANY summands — including the
// opaque term sumTo(k), which the automated tactics cannot reorder past.
theorem sumSwap: forall a, b, c, d: Nat;
  add(add(a, b), add(c, d)) = add(add(a, c), add(b, d))
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-c |
            fix c: Nat {
              @generalize-d |
                fix d: Nat {
                  // right-nest the left side: (a+b)+(c+d) = a+(b+(c+d))
                  @lhs-right-nested |
                    add(add(a, b), add(c, d)) = add(a, add(b, add(c, d)))
                    [using simplify addIsAssociative]
                  // swap b past c inside the inner triple
                  @b-swaps-past-c |
                    add(b, add(c, d)) = add(c, add(b, d))
                    [using specialize addLeftSwap(b, c, d)]
                  @lhs-with-b-c-swapped |
                    add(add(a, b), add(c, d)) = add(a, add(c, add(b, d)))
                    [by rewrite b-swaps-past-c lhs-right-nested]
                  // right-nest the target's right side identically, then flip it so
                  // the shared form a+(c+(b+d)) can be rewritten back
                  @rhs-right-nested |
                    add(add(a, c), add(b, d)) = add(a, add(c, add(b, d)))
                    [using simplify addIsAssociative]
                  @rhs-refl |
                    add(add(a, c), add(b, d)) = add(add(a, c), add(b, d))
                    [by reflexivity]
                  @rhs-nesting-flipped |
                    add(a, add(c, add(b, d))) = add(add(a, c), add(b, d))
                    [by rewrite rhs-right-nested rhs-refl]
                  @quadruple-sum-rearranged |
                    add(add(a, b), add(c, d)) = add(add(a, c), add(b, d))
                    [by rewrite rhs-nesting-flipped lhs-with-b-c-swapped]
                }
              @discharge-d |
                forall d: Nat; add(add(a, b), add(c, d)) = add(add(a, c), add(b, d))
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Nat; add(add(a, b), add(c, d)) = add(add(a, c), add(b, d))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Nat; add(add(a, b), add(c, d)) = add(add(a, c), add(b, d))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Nat; add(add(a, b), add(c, d)) = add(add(a, c), add(b, d))
    [by forall_intro generalize-a]
qed

// -- the summation function -------------------------------------------------

// sumTo(n) = 0 + 1 + ... + n, defined by recursion on n.
func sumTo(n: Nat): Nat
axiom sumToZero: sumTo(ZERO) = ZERO
axiom sumToSucc: forall n: Nat; sumTo(succ(n)) = add(sumTo(n), succ(n))

// -- the theorem ------------------------------------------------------------

// 2 * sumTo(n) = n * (n + 1). Induction on n:
//   base   2 * sumTo(0) = 0 = 0 * 1
//   step   assuming 2 * sumTo(k) = k * (k+1),
//          2 * sumTo(k+1) = 2 * (sumTo(k) + (k+1))
//                         = 2*sumTo(k) + 2*(k+1)       (sumSwap regroups)
//                         = k*(k+1) + 2*(k+1)          (inductive hypothesis)
//                         = (k+1) * (k+2)              (simplify)
theorem gaussSum: forall n: Nat; add(sumTo(n), sumTo(n)) = mul(n, succ(n))
proof
  // base case: 2 * sumTo(0) = 0 = 0 * succ(0)
  @base-case |
    add(sumTo(ZERO), sumTo(ZERO)) = mul(ZERO, succ(ZERO))
    [using simplify sumToZero addZeroLeft mulZeroLeft]

  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume add(sumTo(k), sumTo(k)) = mul(k, succ(k)) {
          @inductive-hypothesis |
            add(sumTo(k), sumTo(k)) = mul(k, succ(k))
            [by hypothesis given-inductive-hypothesis]

          // unfold both copies of sumTo(succ k) = sumTo(k) + succ(k)
          @both-copies-unfolded |
            add(sumTo(succ(k)), sumTo(succ(k))) = add(add(sumTo(k), succ(k)), add(sumTo(k), succ(k)))
            [using simplify sumToSucc]

          // regroup (s+c)+(s+c) into (s+s)+(c+c) via the exchange lemma,
          // instantiated at a = c' = sumTo(k), b = d' = succ(k)
          // (binders bind a, b, c, d outermost-first)
          @exchange-groups-the-sums |
            add(add(sumTo(k), succ(k)), add(sumTo(k), succ(k))) = add(add(sumTo(k), sumTo(k)), add(succ(k), succ(k)))
            [using specialize sumSwap(sumTo(k), succ(k), sumTo(k), succ(k))]
          @regrouped-into-sums-and-successors |
            add(sumTo(succ(k)), sumTo(succ(k))) = add(add(sumTo(k), sumTo(k)), add(succ(k), succ(k)))
            [by rewrite exchange-groups-the-sums both-copies-unfolded]

          // fold the inductive hypothesis into the first summand
          @first-summand-is-k-times-succ-k |
            add(sumTo(succ(k)), sumTo(succ(k))) = add(mul(k, succ(k)), add(succ(k), succ(k)))
            [by rewrite inductive-hypothesis regrouped-into-sums-and-successors]

          // k*(k+1) + 2*(k+1) = (k+1)*(k+2): expand every product and right-nest
          // the additive residue; both sides normalize to succ(succ(k*k + 3k))
          @arithmetic-closes-the-product |
            add(mul(k, succ(k)), add(succ(k), succ(k))) = mul(succ(k), succ(succ(k)))
            [using simplify mulSuccLeft mulSuccRight addSuccLeft addSuccRight addZeroLeft addZeroRight mulZeroLeft mulZeroRight addIsAssociative]

          @succ-case |
            add(sumTo(succ(k)), sumTo(succ(k))) = mul(succ(k), succ(succ(k)))
            [by rewrite arithmetic-closes-the-product first-summand-is-k-times-succ-k]
        }
      @induction-step-at-k |
        add(sumTo(k), sumTo(k)) = mul(k, succ(k)) -> add(sumTo(succ(k)), sumTo(succ(k))) = mul(succ(k), succ(succ(k)))
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; add(sumTo(k), sumTo(k)) = mul(k, succ(k)) -> add(sumTo(succ(k)), sumTo(succ(k))) = mul(succ(k), succ(succ(k)))
    [by forall_intro induction-step]

  @conclusion |
    forall n: Nat; add(sumTo(n), sumTo(n)) = mul(n, succ(n))
    [using instantiation induction((fun k: Nat => add(sumTo(k), sumTo(k)) = mul(k, succ(k)))) base-case induction-step-for-all-k]
qed
