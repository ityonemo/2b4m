// What failure looks like: three plausible but WRONG proofs, each rejected by
// the checker with a precise diagnostic. Run:
//
//   bpa check examples/incorrect.bpa
//
// Every diagnostic names the exact step, what was claimed, and what the rule
// actually derives — one error per broken theorem, no cascade noise.

// -- signature --------------------------------------------------------------

sort Nat
const ZERO: Nat
func div(a: Nat, b: Nat): Nat requires b != ZERO
pred raining
pred wet
pred is_zero(n: Nat)

axiom rainMakesWet: raining -> wet
axiom zeroIsZero: is_zero(ZERO)

// -- wrong proof 1: affirming the consequent --------------------------------

// WRONG: from raining -> wet and wet we may NOT conclude raining — the street
// could be wet for other reasons. modus_ponens needs the ANTECEDENT.
// The checker answers, pointing at the second reference:
//   error: modus_ponens: expected antecedent 'raining', got 'wet'
theorem affirmingTheConsequent: wet -> raining
proof
  @suppose-wet |
    assume wet {
      @have-wet |
        wet
        [by hypothesis suppose-wet]
      @rain-makes-wet |
        raining -> wet
        [by cite rainMakesWet]
      @oops |
        raining
        [by modus_ponens rain-makes-wet have-wet]
    }
  @conclusion |
    wet -> raining
    [by implies_intro suppose-wet]
qed

// -- wrong proof 2: generalizing from a special case ------------------------

// WRONG: inside `fix n` we only ever proved a fact about ZERO, not about the
// arbitrary n — forall_intro closes over what was actually derived.
// The checker answers with expected-vs-got:
//   error: step claims 'forall n: Nat; is_zero(n)'
//          but forall_intro derives 'forall n: Nat; is_zero(ZERO)'
theorem everythingIsZero: forall n: Nat; is_zero(n)
proof
  @generalize-n |
    fix n: Nat {
      @zero-is-zero |
        is_zero(ZERO)
        [by cite zeroIsZero]
    }
  @conclusion |
    forall n: Nat; is_zero(n)
    [by forall_intro generalize-n]
qed

// -- wrong proof 3: ignoring a guard ----------------------------------------

// WRONG: div requires its divisor to be nonzero, and ZERO != ZERO has no
// proof (there is none). The statement itself owes the obligation — the
// proof body is never even reached. The checker answers with the exact
// obligation, copy-pasteable as a lemma statement (good luck):
//   error: unproved obligation: 'ZERO != ZERO'
theorem unguardedDivision: div(ZERO, ZERO) = ZERO
proof
  @conclusion |
    div(ZERO, ZERO) = ZERO
    [by reflexivity]
qed
