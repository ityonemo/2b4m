// examples/sqrt2.bpa — the irrationality of √2, stated over ℕ.
//
// bpa is over the naturals (no reals), so "√2 is irrational" is phrased as a
// fact about naturals: no fraction in lowest terms squares to 2. Concretely,
// there is no coprime pair (p, q) with p² = 2q².
//
//   theorem sqrtTwoIrrational:
//     forall p, q; gcd(p, q) = ONE -> p·p != 2·(q·q)
//
// Proof (by contradiction): assume p² = 2q². Then 2 | p², so 2 | p (the parity
// crux `evenSquareEven`); write p = 2k. Substituting and cancelling a 2 gives
// q² = 2k², so 2 | q. Now 2 divides both p and q, hence 2 | gcd(p, q) = 1 — but
// nothing but 1 divides 1 (`twoNotDivideOne`). Contradiction.
//
// Everything is ELABORATED — no accelerated step. The nonlinear algebra is `polynomial(peano)`;
// the cancellation is `mulCancelLeft`; the parity is `std/peano-parity.bpa`.

import peano <<< "std/peano.bpa"
import ordering <<< "std/peano-order.bpa"
import peano_divides <<< "std/peano-divides.bpa"
import parity <<< "std/peano-parity.bpa"

sort Nat = peano.Nat
const ZERO = peano.ZERO
const ONE = peano.ONE
func succ = peano.succ
func add = peano.add
func mul = peano.mul
func gcd = peano_divides.gcd
define divides(d, n) = peano_divides.divides(d, n)

axiom succNotZero = peano.succNotZero
axiom oneIsSuccZero = peano.oneIsSuccZero
axiom addSuccLeft = peano.addSuccLeft
theorem mulCancelLeft = ordering.mulCancelLeft
theorem gcdGreatest = peano_divides.gcdGreatest
theorem evenSquareEven = parity.evenSquareEven
theorem twoNotDivideOne = parity.twoNotDivideOne

// TWO must match parity's definition (add(ONE, ONE)) so evenSquareEven,
// twoNotDivideOne and the polynomial algebra all line up on the same term.
define TWO = add(ONE, ONE)

theorem sqrtTwoIrrational: forall p, q: Nat; gcd(p, q) = ONE -> mul(p, p) != mul(TWO, mul(q, q))
proof
  @generalize-p |
    fix p: Nat {
      @generalize-q |
        fix q: Nat {
          @given-coprime |
            assume gcd(p, q) = ONE {
              @coprime |
                gcd(p, q) = ONE
                [by hypothesis given-coprime]
              @suppose-square |
                assume mul(p, p) = mul(TWO, mul(q, q)) {
                  @square-eq |
                    mul(p, p) = mul(TWO, mul(q, q))
                    [by hypothesis suppose-square]

                  // 2 | p²  (witness q²)
                  @two-div-psq |
                    divides(TWO, mul(p, p))
                    [by exists_intro(mul(q, q)) square-eq]

                  // 2 | p
                  @two-div-p |
                    divides(TWO, p)
                    [using specialize evenSquareEven(p) two-div-psq]

                  // p = 2k
                  @with-k |
                    unpack k: Nat from two-div-p {
                      @p-is-2k |
                        p = mul(TWO, k)
                        [by hypothesis with-k]

                      // substitute p = 2k into p² = 2q²
                      @sq-refl |
                        mul(p, p) = mul(p, p)
                        [by reflexivity]
                      @sq-1 |
                        mul(p, p) = mul(mul(TWO, k), p)
                        [by rewrite p-is-2k sq-refl]
                      @sq-2 |
                        mul(p, p) = mul(mul(TWO, k), mul(TWO, k))
                        [by rewrite p-is-2k sq-1]

                      // (2k)² = 2·(2·k²)
                      @expand |
                        mul(mul(TWO, k), mul(TWO, k)) = mul(TWO, mul(TWO, mul(k, k)))
                        [using polynomial(peano)]
                      @lhs-expanded |
                        mul(p, p) = mul(TWO, mul(TWO, mul(k, k)))
                        [by rewrite expand sq-2]
                      // so 2·(2k²) = 2q²
                      @two-two-ksq-eq-two-qsq |
                        mul(TWO, mul(TWO, mul(k, k))) = mul(TWO, mul(q, q))
                        [by rewrite lhs-expanded square-eq]

                      // cancel the left 2:  2k² = q²  (TWO = 1+1 = succ(1) != 0)
                      @two-as-succ |
                        add(ONE, ONE) = succ(add(ZERO, ONE))
                        [using simplify addSuccLeft oneIsSuccZero]
                      @succ-form-not-zero |
                        succ(add(ZERO, ONE)) != ZERO
                        [using specialize succNotZero(add(ZERO, ONE))]
                      @two-nonzero |
                        TWO != ZERO
                        [by rewrite two-as-succ succ-form-not-zero]
                      @two-ksq-eq-qsq |
                        mul(TWO, mul(k, k)) = mul(q, q)
                        [using specialize mulCancelLeft(TWO, mul(TWO, mul(k, k)), mul(q, q)) two-nonzero two-two-ksq-eq-two-qsq]
                      @qsq-eq-two-ksq |
                        mul(q, q) = mul(TWO, mul(k, k))
                        [by symmetry two-ksq-eq-qsq]

                      // 2 | q²  (witness k²), then 2 | q
                      @two-div-qsq |
                        divides(TWO, mul(q, q))
                        [by exists_intro(mul(k, k)) qsq-eq-two-ksq]
                      @two-div-q |
                        divides(TWO, q)
                        [using specialize evenSquareEven(q) two-div-qsq]

                      // 2 | gcd(p, q) = 1
                      @two-div-gcd |
                        divides(TWO, gcd(p, q))
                        [using specialize gcdGreatest(TWO, p, q) two-div-p two-div-q]
                      @two-div-one |
                        divides(TWO, ONE)
                        [by rewrite coprime two-div-gcd]

                      // but 2 does not divide 1
                      @not-two-div-one |
                        not divides(TWO, ONE)
                        [by cite twoNotDivideOne]
                      @contradiction |
                        mul(p, p) != mul(TWO, mul(q, q))
                        [by absurd two-div-one not-two-div-one]
                    }
                  @square-impossible |
                    mul(p, p) != mul(TWO, mul(q, q))
                    [by exists_elim with-k]
                }
              @conclusion-p-squared-is-not-twice-q-squared |
                mul(p, p) != mul(TWO, mul(q, q))
                [by not_intro suppose-square square-eq square-impossible]
            }
          @discharge-coprime |
            gcd(p, q) = ONE -> mul(p, p) != mul(TWO, mul(q, q))
            [by implies_intro given-coprime]
        }
      @discharge-q |
        forall q: Nat; gcd(p, q) = ONE -> mul(p, p) != mul(TWO, mul(q, q))
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall p, q: Nat; gcd(p, q) = ONE -> mul(p, p) != mul(TWO, mul(q, q))
    [by forall_intro generalize-p]
qed
