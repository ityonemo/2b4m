// std/subgroup.bpa — the theory of a SUBGROUP, as a STANDALONE,
// reusable component (the dependency INVERSION).
//
// A subgroup is a group in its own right — a subset of a group's underlying sort that is
// itself a group under the restricted operation. Rather than importing `std/group.bpa`
// and bolting a membership predicate onto it, this theory is SELF-CONTAINED: it
// declares its own abstract PARENT GROUP (a subgroup's parent IS a group), the
// membership predicate `inSubgroup` + the three subgroup-criterion conditions, and
// the derived theorems — all over that local vocabulary.
//
// It is authored to PLUG INTO `std/group.bpa`: a concrete subgroup MODELS this theory
// (mapping its `Grp` to the ambient group, `inSubgroup` to the membership predicate),
// and `group` then plugs onto that concrete subgroup via a two-layer model stack,
// TRANSFERRING the whole group corpus onto the subgroup for free
// (tests/cases/model_subgroup_transfer.bpa demonstrates the stack end to end).
//
// The parent-group vocabulary is `grp*` (a naming concession pending the import-
// hygiene pass): THREE axioms (grpAssoc/grpIdentityLeft/grpInverseLeft) with the
// right-sided laws + inverseUnique/invInvolution PROVEN from them. The like-named
// THEOREMS `opAssoc`/`opIdentity*`/`opInverse*` prove each law holds ON THE SUBGROUP
// (over `Sub`) — these are what a group-model @-projects.
// the abstract PARENT GROUP's THREE axioms (declared locally — the dependency
// inversion): associativity + LEFT identity + LEFT inverse. The right-sided laws
// (grpIdentityRight/grpInverseRight) are THEOREMS, proved below (one-sided suffices).
// Named `grp*`; the FIVE like-named THEOREMS further down (opAssoc, …) prove each law
// holds ON THE SUBGROUP and are what HGroup @-projects.
sort Grp
const E: Grp
func op(a: Grp, b: Grp): Grp
func inverse(a: Grp): Grp
axiom grpAssoc: forall a, b, c: Grp; op(op(a, b), c) = op(a, op(b, c))
axiom grpIdentityLeft: forall a: Grp; op(E, a) = a
axiom grpInverseLeft: forall a: Grp; op(inverse(a), a) = E

// right-sided laws, derived from the left axioms (one-sided suffices).
theorem grpInverseRight: forall a: Grp; op(a, inverse(a)) = E
proof
  @generalize-a |
    fix a: Grp {
      @ia-is-E |
        op(inverse(a), a) = E
        [using specialize grpInverseLeft(a)]
      @idAtai |
        op(E, op(a, inverse(a))) = op(a, inverse(a))
        [using specialize grpIdentityLeft(op(a, inverse(a)))]
      @invi-i-is-E |
        op(inverse(inverse(a)), inverse(a)) = E
        [using specialize grpInverseLeft(inverse(a))]
      @assoc1 |
        op(op(inverse(inverse(a)), inverse(a)), op(a, inverse(a))) = op(inverse(inverse(a)), op(inverse(a), op(a, inverse(a))))
        [using specialize grpAssoc(inverse(inverse(a)), inverse(a), op(a, inverse(a)))]
      @assoc2 |
        op(op(inverse(a), a), inverse(a)) = op(inverse(a), op(a, inverse(a)))
        [using specialize grpAssoc(inverse(a), a, inverse(a))]
      @Ei-is-i |
        op(E, inverse(a)) = inverse(a)
        [using specialize grpIdentityLeft(inverse(a))]
      // a·a⁻¹ = e·(a·a⁻¹) = (a⁻¹⁻¹·a⁻¹)·(a·a⁻¹) = a⁻¹⁻¹·(a⁻¹·(a·a⁻¹))
      //   = a⁻¹⁻¹·((a⁻¹·a)·a⁻¹) = a⁻¹⁻¹·(e·a⁻¹) = a⁻¹⁻¹·a⁻¹ = e
      @conclusion-ai |
        op(a, inverse(a)) = E
        [using chain idAtai invi-i-is-E assoc1 assoc2 ia-is-E Ei-is-i]
    }
  @conclusion |
    forall a: Grp; op(a, inverse(a)) = E
    [by forall_intro generalize-a]
qed

theorem grpIdentityRight: forall a: Grp; op(a, E) = a
proof
  @generalize-a |
    fix a: Grp {
      @ia-is-E |
        op(inverse(a), a) = E
        [using specialize grpInverseLeft(a)]
      @assoc1 |
        op(op(a, inverse(a)), a) = op(a, op(inverse(a), a))
        [using specialize grpAssoc(a, inverse(a), a)]
      @aInv-is-E |
        op(a, inverse(a)) = E
        [using specialize grpInverseRight(a)]
      @Ea-is-a |
        op(E, a) = a
        [using specialize grpIdentityLeft(a)]
      // a·e = a·(a⁻¹·a) = (a·a⁻¹)·a = e·a = a
      @conclusion-aE |
        op(a, E) = a
        [using chain ia-is-E assoc1 aInv-is-E Ea-is-a]
    }
  @conclusion |
    forall a: Grp; op(a, E) = a
    [by forall_intro generalize-a]
qed

// Two parent-group THEOREMS a subgroup-specific proof cites, proved from the grp*
// axioms (not postulated). `inverseUnique` → `invInvolution` (the double-inverse law).
theorem inverseUnique: forall a, b: Grp; op(a, b) = E -> b = inverse(a)
proof
  @generalize-a |
    fix a: Grp {
      @generalize-b |
        fix b: Grp {
          @given-b-is-right-inverse-of-a |
            assume op(a, b) = E {
              @ab-is-E |
                op(a, b) = E
                [by hypothesis given-b-is-right-inverse-of-a]
              @b-eq |
                op(E, b) = b
                [using specialize grpIdentityLeft(b)]
              @inva-a-is-E |
                op(inverse(a), a) = E
                [using specialize grpInverseLeft(a)]
              @assoc-step |
                op(op(inverse(a), a), b) = op(inverse(a), op(a, b))
                [using specialize grpAssoc(inverse(a), a, b)]
              @inva-E-is-inva |
                op(inverse(a), E) = inverse(a)
                [using specialize grpIdentityRight(inverse(a))]
              // b = e·b = (a⁻¹·a)·b = a⁻¹·(a·b) = a⁻¹·e = a⁻¹
              @b-is-inva |
                b = inverse(a)
                [using chain b-eq inva-a-is-E assoc-step ab-is-E inva-E-is-inva]
            }
          @discharge |
            op(a, b) = E -> b = inverse(a)
            [by implies_intro given-b-is-right-inverse-of-a]
        }
      @discharge-b |
        forall b: Grp; op(a, b) = E -> b = inverse(a)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Grp; op(a, b) = E -> b = inverse(a)
    [by forall_intro generalize-a]
qed

theorem invInvolution: forall a: Grp; inverse(inverse(a)) = a
proof
  @generalize-a |
    fix a: Grp {
      @inva-a-is-E |
        op(inverse(a), a) = E
        [using specialize grpInverseLeft(a)]
      @a-is-invinva |
        a = inverse(inverse(a))
        [using specialize inverseUnique(inverse(a), a) inva-a-is-E]
      @invinva-is-a |
        inverse(inverse(a)) = a
        [by symmetry a-is-invinva]
    }
  @conclusion |
    forall a: Grp; inverse(inverse(a)) = a
    [by forall_intro generalize-a]
qed

// More parent-group derived laws a subgroup-specific proof may cite, proved from
// the grp* axioms (Judson has each by §3.2). They live here rather than being
// imported from std/group.bpa so this theory stays self-contained — a subgroup's
// PARENT is a group, so these hold on `Grp` and a §3.3 proof cites them directly
// instead of re-deriving them inline.

// (ab)⁻¹ = b⁻¹a⁻¹ — the inverse of a product reverses the factors. From
// (ab)(b⁻¹a⁻¹) = e and inverseUnique.
theorem invProduct: forall a, b: Grp; inverse(op(a, b)) = op(inverse(b), inverse(a))
proof
  @generalize-a |
    fix a: Grp {
      @generalize-b |
        fix b: Grp {
          @rearrange |
            op(op(a, b), op(inverse(b), inverse(a))) = op(a, op(op(b, inverse(b)), inverse(a)))
            [using assoc(grpAssoc)]
          @b-times-inverse-b-is-identity |
            op(b, inverse(b)) = E
            [using specialize grpInverseRight(b)]
          @identity-times-inverse-a |
            op(E, inverse(a)) = inverse(a)
            [using specialize grpIdentityLeft(inverse(a))]
          @a-times-inverse-a-is-identity |
            op(a, inverse(a)) = E
            [using specialize grpInverseRight(a)]
          // (ab)(b⁻¹a⁻¹) = a((bb⁻¹)a⁻¹) = a(e·a⁻¹) = a·a⁻¹ = e
          @product-is-identity |
            op(op(a, b), op(inverse(b), inverse(a))) = E
            [using chain rearrange b-times-inverse-b-is-identity identity-times-inverse-a a-times-inverse-a-is-identity]
          @inverses-swapped-is-the-inverse |
            op(inverse(b), inverse(a)) = inverse(op(a, b))
            [using specialize inverseUnique(op(a, b), op(inverse(b), inverse(a))) product-is-identity]
          @conclusion-inverse-of-product |
            inverse(op(a, b)) = op(inverse(b), inverse(a))
            [by symmetry inverses-swapped-is-the-inverse]
        }
      @discharge-b |
        forall b: Grp; inverse(op(a, b)) = op(inverse(b), inverse(a))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Grp; inverse(op(a, b)) = op(inverse(b), inverse(a))
    [by forall_intro generalize-a]
qed

// Right cancellation: ba = ca ⟹ b = c. Multiply on the right by a⁻¹.
theorem cancelRight: forall b, a, c: Grp; op(b, a) = op(c, a) -> b = c
proof
  @generalize-b |
    fix b: Grp {
      @generalize-a |
        fix a: Grp {
          @generalize-c |
            fix c: Grp {
              @given-right-products-equal |
                assume op(b, a) = op(c, a) {
                  @right-products-equal |
                    op(b, a) = op(c, a)
                    [by hypothesis given-right-products-equal]
                  @reassociate-around-b |
                    op(op(b, a), inverse(a)) = op(b, op(a, inverse(a)))
                    [using specialize grpAssoc(b, a, inverse(a))]
                  @a-times-inverse-a-is-identity |
                    op(a, inverse(a)) = E
                    [using specialize grpInverseRight(a)]
                  @identity-cancels-on-b |
                    op(b, E) = b
                    [using specialize grpIdentityRight(b)]
                  @reassociate-around-c |
                    op(op(c, a), inverse(a)) = op(c, op(a, inverse(a)))
                    [using specialize grpAssoc(c, a, inverse(a))]
                  @identity-cancels-on-c |
                    op(c, E) = c
                    [using specialize grpIdentityRight(c)]
                  // b = b·e = b·(a·a⁻¹) = (b·a)·a⁻¹ = (c·a)·a⁻¹ = c·(a·a⁻¹) = c·e = c
                  @b-is-c |
                    b = c
                    [using chain identity-cancels-on-b a-times-inverse-a-is-identity reassociate-around-b right-products-equal reassociate-around-c identity-cancels-on-c]
                }
              @discharge |
                op(b, a) = op(c, a) -> b = c
                [by implies_intro given-right-products-equal]
            }
          @discharge-c |
            forall c: Grp; op(b, a) = op(c, a) -> b = c
            [by forall_intro generalize-c]
        }
      @discharge-a |
        forall a, c: Grp; op(b, a) = op(c, a) -> b = c
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a, c: Grp; op(b, a) = op(c, a) -> b = c
    [by forall_intro generalize-b]
qed

// Left cancellation: ab = ac ⟹ b = c. Multiply on the left by a⁻¹.
theorem cancelLeft: forall a, b, c: Grp; op(a, b) = op(a, c) -> b = c
proof
  @generalize-a |
    fix a: Grp {
      @generalize-b |
        fix b: Grp {
          @generalize-c |
            fix c: Grp {
              @given-left-products-equal |
                assume op(a, b) = op(a, c) {
                  @left-products-equal |
                    op(a, b) = op(a, c)
                    [by hypothesis given-left-products-equal]
                  @reassociate-around-b |
                    op(op(inverse(a), a), b) = op(inverse(a), op(a, b))
                    [using specialize grpAssoc(inverse(a), a, b)]
                  @inverse-a-times-a-is-identity |
                    op(inverse(a), a) = E
                    [using specialize grpInverseLeft(a)]
                  @identity-cancels-on-b |
                    op(E, b) = b
                    [using specialize grpIdentityLeft(b)]
                  @reassociate-around-c |
                    op(op(inverse(a), a), c) = op(inverse(a), op(a, c))
                    [using specialize grpAssoc(inverse(a), a, c)]
                  @identity-cancels-on-c |
                    op(E, c) = c
                    [using specialize grpIdentityLeft(c)]
                  // b = e·b = (a⁻¹·a)·b = a⁻¹·(a·b) = a⁻¹·(a·c) = (a⁻¹·a)·c = e·c = c
                  @b-is-c |
                    b = c
                    [using chain identity-cancels-on-b inverse-a-times-a-is-identity reassociate-around-b left-products-equal reassociate-around-c identity-cancels-on-c]
                }
              @discharge |
                op(a, b) = op(a, c) -> b = c
                [by implies_intro given-left-products-equal]
            }
          @discharge-c |
            forall c: Grp; op(a, b) = op(a, c) -> b = c
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Grp; op(a, b) = op(a, c) -> b = c
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Grp; op(a, b) = op(a, c) -> b = c
    [by forall_intro generalize-a]
qed

// The subgroup, as a membership predicate over the group's sort, characterized by
// the three subgroup-criterion conditions.
pred inSubgroup(g: Grp)

axiom subgroupHasIdentity: inSubgroup(E)
axiom subgroupClosedOp: forall a, b: Grp; inSubgroup(a) -> inSubgroup(b) -> inSubgroup(op(a, b))
axiom subgroupClosedInverse: forall a: Grp; inSubgroup(a) -> inSubgroup(inverse(a))

// The subgroup's underlying sort as a PREDICATED SORT: `Sub` is `Grp` restricted to members.
// A statement `∀g: Sub; …` reads as "for every subgroup element" and desugars to
// `∀g: Grp; inSubgroup(g) -> …` — the same theorem, but the membership hypotheses
// stay implicit in the binder (surfaced in a proof with `[by predicate <fix>]`).
// NOTE: we do NOT give `op`/`inverse` a `Sub` result — closure is PROVEN below, not
// asserted by a signature. `Sub` is used only for legibility of the statements.
sort Sub = Grp where inSubgroup

// ── THE FIVE GROUP AXIOMS, PROVEN ON THE SUBGROUP. ───────────────────────────
// Each states that a group axiom holds over the subgroup sort `Sub` (the law
// holds on all of Grp, so it restricts to the subset). These are the five theorems
// HGroup @-projects to discharge group's axiom obligations onto the subgroup.
theorem opAssoc: forall a, b, c: Sub; op(op(a, b), c) = op(a, op(b, c))
proof
  @generalize-a |
    fix p: Sub {
      @generalize-b |
        fix q: Sub {
          @generalize-c |
            fix r: Sub {
              @conclusion-at-pqr |
                op(op(p, q), r) = op(p, op(q, r))
                [using specialize grpAssoc(p, q, r)]
            }
          @discharge-c |
            forall c: Sub; op(op(p, q), c) = op(p, op(q, c))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Sub; op(op(p, b), c) = op(p, op(b, c))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Sub; op(op(a, b), c) = op(a, op(b, c))
    [by forall_intro generalize-a]
qed

theorem opIdentityLeft: forall a: Sub; op(E, a) = a
proof
  @generalize-a |
    fix p: Sub {
      @conclusion-at-p |
        op(E, p) = p
        [using specialize grpIdentityLeft(p)]
    }
  @conclusion |
    forall a: Sub; op(E, a) = a
    [by forall_intro generalize-a]
qed

theorem opIdentityRight: forall a: Sub; op(a, E) = a
proof
  @generalize-a |
    fix p: Sub {
      @conclusion-at-p |
        op(p, E) = p
        [using specialize grpIdentityRight(p)]
    }
  @conclusion |
    forall a: Sub; op(a, E) = a
    [by forall_intro generalize-a]
qed

theorem opInverseLeft: forall a: Sub; op(inverse(a), a) = E
proof
  @generalize-a |
    fix p: Sub {
      @conclusion-at-p |
        op(inverse(p), p) = E
        [using specialize grpInverseLeft(p)]
    }
  @conclusion |
    forall a: Sub; op(inverse(a), a) = E
    [by forall_intro generalize-a]
qed

theorem opInverseRight: forall a: Sub; op(a, inverse(a)) = E
proof
  @generalize-a |
    fix p: Sub {
      @conclusion-at-p |
        op(p, inverse(p)) = E
        [using specialize grpInverseRight(p)]
    }
  @conclusion |
    forall a: Sub; op(a, inverse(a)) = E
    [by forall_intro generalize-a]
qed

// One-step subgroup test, FORWARD: a subgroup is closed under
// the "divide" operation g·h⁻¹. Since h ∈ H, its inverse h⁻¹ ∈ H (closedInverse);
// then by closure under the operation, g·h⁻¹ ∈ H (closedOp).
theorem subgroupClosedDivide: forall g, h: Sub; inSubgroup(op(g, inverse(h)))
proof
  @generalize-g |
    fix g: Sub {
      @g-is-a-member |
        inSubgroup(g)
        [by predicate generalize-g]
      @generalize-h |
        fix h: Sub {
          @h-is-a-member |
            inSubgroup(h)
            [by predicate generalize-h]
          @inverse-of-h-in-H |
            inSubgroup(inverse(h))
            [using specialize subgroupClosedInverse(h) h-is-a-member]
          @divide-is-a-member |
            inSubgroup(op(g, inverse(h)))
            [using specialize subgroupClosedOp(g, inverse(h)) g-is-a-member inverse-of-h-in-H]
        }
      @discharge-h |
        forall h: Sub; inSubgroup(op(g, inverse(h)))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Sub; inSubgroup(op(g, inverse(h)))
    [by forall_intro generalize-g]
qed

// ── One-step test, CONVERSE ──────────────────────────────────────────────────
// The other half of the test: a NONEMPTY subset closed under g·h⁻¹ satisfies the
// three subgroup conditions, hence is a subgroup. Since bpa cannot quantify over
// predicates, we express "an arbitrary subset with those two properties" as a
// second membership predicate `oneStepSubset` constrained by exactly the one-step
// hypotheses, and derive the three conditions as theorems.
pred oneStepSubset(g: Grp)

axiom oneStepInhabited: exists g: Grp; oneStepSubset(g)
axiom oneStepClosedDivide: forall a, b: Grp; oneStepSubset(a) -> oneStepSubset(b) -> oneStepSubset(op(a, inverse(b)))

// Condition 1 (identity): pick any member g; then g·g⁻¹ = e is in the subset.
theorem oneStepHasIdentity: oneStepSubset(E)
proof
  @some-member-exists |
    exists g: Grp; oneStepSubset(g)
    [by cite oneStepInhabited]
  @with-member |
    unpack g: Grp from some-member-exists {
      @member-in-subset |
        oneStepSubset(g)
        [by hypothesis with-member]
      @self-divide-in-subset |
        oneStepSubset(op(g, inverse(g)))
        [using specialize oneStepClosedDivide(g, g) member-in-subset member-in-subset]
      @self-divide-is-identity |
        op(g, inverse(g)) = E
        [using specialize grpInverseRight(g)]
      @conclusion-identity-in-subset |
        oneStepSubset(E)
        [by rewrite self-divide-is-identity self-divide-in-subset]
    }
  @conclusion |
    oneStepSubset(E)
    [by exists_elim with-member]
qed

// Condition 3 (inverses): for any member g, dividing the identity by g gives
// e·g⁻¹ = g⁻¹, which is in the subset. (Uses condition 1: e is in the subset.)
theorem oneStepClosedInverse: forall g: Grp; oneStepSubset(g) -> oneStepSubset(inverse(g))
proof
  @generalize-g |
    fix g: Grp {
      @given-g-in-subset |
        assume oneStepSubset(g) {
          @g-in-subset |
            oneStepSubset(g)
            [by hypothesis given-g-in-subset]
          @identity-in-subset |
            oneStepSubset(E)
            [by cite oneStepHasIdentity]
          @identity-divide-g-in-subset |
            oneStepSubset(op(E, inverse(g)))
            [using specialize oneStepClosedDivide(E, g) identity-in-subset g-in-subset]
          @identity-divide-g-is-inverse |
            op(E, inverse(g)) = inverse(g)
            [using specialize grpIdentityLeft(inverse(g))]
          @conclusion-inverse-in-subset |
            oneStepSubset(inverse(g))
            [by rewrite identity-divide-g-is-inverse identity-divide-g-in-subset]
        }
      @g-in-subset-implies-inverse |
        oneStepSubset(g) -> oneStepSubset(inverse(g))
        [by implies_intro given-g-in-subset]
    }
  @conclusion |
    forall g: Grp; oneStepSubset(g) -> oneStepSubset(inverse(g))
    [by forall_intro generalize-g]
qed

// Condition 2 (products): given h1, h2 in the subset, h2⁻¹ is in it (condition 3),
// so dividing h1 by h2⁻¹ gives h1·(h2⁻¹)⁻¹ = h1·h2, which is in the subset. The
// double inverse (h2⁻¹)⁻¹ = h2 is `invInvolution`.
theorem oneStepClosedOp: forall h1, h2: Grp; oneStepSubset(h1) -> oneStepSubset(h2) -> oneStepSubset(op(h1, h2))
proof
  @generalize-h1 |
    fix h1: Grp {
      @generalize-h2 |
        fix h2: Grp {
          @given-h1-in-subset |
            assume oneStepSubset(h1) {
              @given-h2-in-subset |
                assume oneStepSubset(h2) {
                  @h1-in-subset |
                    oneStepSubset(h1)
                    [by hypothesis given-h1-in-subset]
                  @h2-in-subset |
                    oneStepSubset(h2)
                    [by hypothesis given-h2-in-subset]
                  @inverse-h2-in-subset |
                    oneStepSubset(inverse(h2))
                    [using specialize oneStepClosedInverse(h2) h2-in-subset]
                  @h1-divide-inverse-h2-in-subset |
                    oneStepSubset(op(h1, inverse(inverse(h2))))
                    [using specialize oneStepClosedDivide(h1, inverse(h2)) h1-in-subset inverse-h2-in-subset]
                  @double-inverse-h2 |
                    inverse(inverse(h2)) = h2
                    [using specialize invInvolution(h2)]
                  @conclusion-product-in-subset |
                    oneStepSubset(op(h1, h2))
                    [by rewrite double-inverse-h2 h1-divide-inverse-h2-in-subset]
                }
              @h2-in-subset-implies-product |
                oneStepSubset(h2) -> oneStepSubset(op(h1, h2))
                [by implies_intro given-h2-in-subset]
            }
          @h1-in-subset-implies-rest |
            oneStepSubset(h1) -> oneStepSubset(h2) -> oneStepSubset(op(h1, h2))
            [by implies_intro given-h1-in-subset]
        }
      @discharge-h2 |
        forall h2: Grp; oneStepSubset(h1) -> oneStepSubset(h2) -> oneStepSubset(op(h1, h2))
        [by forall_intro generalize-h2]
    }
  @conclusion |
    forall h1, h2: Grp; oneStepSubset(h1) -> oneStepSubset(h2) -> oneStepSubset(op(h1, h2))
    [by forall_intro generalize-h1]
qed

// ── Intersection of subgroups ────────────────────────────────────────────────
// The intersection H ∩ K of two subgroups is a subgroup. We model a SECOND
// subgroup with its own membership predicate `inSubgroup2` (same three axioms),
// define intersection membership as the conjunction, and prove the three subgroup
// conditions for the conjunction — each follows by applying the corresponding
// condition in H and in K.
pred inSubgroup2(g: Grp)

axiom subgroup2HasIdentity: inSubgroup2(E)
axiom subgroup2ClosedOp: forall a, b: Grp; inSubgroup2(a) -> inSubgroup2(b) -> inSubgroup2(op(a, b))
axiom subgroup2ClosedInverse: forall a: Grp; inSubgroup2(a) -> inSubgroup2(inverse(a))

// Intersection, condition 1: e is in both, hence in the intersection.
theorem intersectionHasIdentity: inSubgroup(E) and inSubgroup2(E)
proof
  @identity-in-first |
    inSubgroup(E)
    [by cite subgroupHasIdentity]
  @identity-in-second |
    inSubgroup2(E)
    [by cite subgroup2HasIdentity]
  @conclusion |
    inSubgroup(E) and inSubgroup2(E)
    [by and_intro identity-in-first identity-in-second]
qed

// Intersection, condition 2: if a and b are in both, their product is in both.
theorem intersectionClosedOp: forall a, b: Grp; (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(b) and inSubgroup2(b)) -> (inSubgroup(op(a, b)) and inSubgroup2(op(a, b)))
proof
  @generalize-a |
    fix a: Grp {
      @generalize-b |
        fix b: Grp {
          @given-a-in-both |
            assume inSubgroup(a) and inSubgroup2(a) {
              @given-b-in-both |
                assume inSubgroup(b) and inSubgroup2(b) {
                  @a-in-both |
                    inSubgroup(a) and inSubgroup2(a)
                    [by hypothesis given-a-in-both]
                  @b-in-both |
                    inSubgroup(b) and inSubgroup2(b)
                    [by hypothesis given-b-in-both]
                  @a-in-first |
                    inSubgroup(a)
                    [by and_elim_left a-in-both]
                  @a-in-second |
                    inSubgroup2(a)
                    [by and_elim_right a-in-both]
                  @b-in-first |
                    inSubgroup(b)
                    [by and_elim_left b-in-both]
                  @b-in-second |
                    inSubgroup2(b)
                    [by and_elim_right b-in-both]
                  @product-in-first |
                    inSubgroup(op(a, b))
                    [using specialize subgroupClosedOp(a, b) a-in-first b-in-first]
                  @product-in-second |
                    inSubgroup2(op(a, b))
                    [using specialize subgroup2ClosedOp(a, b) a-in-second b-in-second]
                  @conclusion-product-in-both |
                    inSubgroup(op(a, b)) and inSubgroup2(op(a, b))
                    [by and_intro product-in-first product-in-second]
                }
              @b-in-both-implies-product |
                (inSubgroup(b) and inSubgroup2(b)) -> (inSubgroup(op(a, b)) and inSubgroup2(op(a, b)))
                [by implies_intro given-b-in-both]
            }
          @a-in-both-implies-rest |
            (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(b) and inSubgroup2(b)) -> (inSubgroup(op(a, b)) and inSubgroup2(op(a, b)))
            [by implies_intro given-a-in-both]
        }
      @discharge-b |
        forall b: Grp; (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(b) and inSubgroup2(b)) -> (inSubgroup(op(a, b)) and inSubgroup2(op(a, b)))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Grp; (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(b) and inSubgroup2(b)) -> (inSubgroup(op(a, b)) and inSubgroup2(op(a, b)))
    [by forall_intro generalize-a]
qed

// Intersection, condition 3: if a is in both, its inverse is in both.
theorem intersectionClosedInverse: forall a: Grp; (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(inverse(a)) and inSubgroup2(inverse(a)))
proof
  @generalize-a |
    fix a: Grp {
      @given-a-in-both |
        assume inSubgroup(a) and inSubgroup2(a) {
          @a-in-both |
            inSubgroup(a) and inSubgroup2(a)
            [by hypothesis given-a-in-both]
          @a-in-first |
            inSubgroup(a)
            [by and_elim_left a-in-both]
          @a-in-second |
            inSubgroup2(a)
            [by and_elim_right a-in-both]
          @inverse-in-first |
            inSubgroup(inverse(a))
            [using specialize subgroupClosedInverse(a) a-in-first]
          @inverse-in-second |
            inSubgroup2(inverse(a))
            [using specialize subgroup2ClosedInverse(a) a-in-second]
          @conclusion-inverse-in-both |
            inSubgroup(inverse(a)) and inSubgroup2(inverse(a))
            [by and_intro inverse-in-first inverse-in-second]
        }
      @a-in-both-implies-inverse |
        (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(inverse(a)) and inSubgroup2(inverse(a)))
        [by implies_intro given-a-in-both]
    }
  @conclusion |
    forall a: Grp; (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(inverse(a)) and inSubgroup2(inverse(a)))
    [by forall_intro generalize-a]
qed

// ── CANARY (do NOT cite) ─────────────────────────────────────────────────────
// A liveness check for the PREDICATED-SORT machinery on the real `Sub` sort. It
// declares Sub-RESULT operations (which ASSERT closure by their signature — the
// opposite of the proofs above, which PROVE it) and shows a downstream use composes
// through the result-postcondition surfacing: `subCombine(g, h)` lands in `Sub`, so
// the `Sub`-argument `subConsume` accepts it with no explicit closure step. If
// predicated sorts ever regress, this canary breaks first. It is NOT part of the
// subgroup theory — nothing cites it, and it may be deleted/rewritten freely
// (tectonic shifts to this file are expected).
func subCombine(a: Sub, b: Sub): Sub // asserts: Sub is closed under this op
func subConsume(x: Sub): Grp // needs a Sub argument

theorem canaryClosureComposes: forall g, h: Sub; subConsume(subCombine(g, h)) = subConsume(subCombine(g, h))
proof
  @generalize-g |
    fix g: Sub {
      @generalize-h |
        fix h: Sub {
          @reflexive |
            subConsume(subCombine(g, h)) = subConsume(subCombine(g, h))
            [by reflexivity]
        }
      @discharge-h |
        forall h: Sub; subConsume(subCombine(g, h)) = subConsume(subCombine(g, h))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Sub; subConsume(subCombine(g, h)) = subConsume(subCombine(g, h))
    [by forall_intro generalize-g]
qed
