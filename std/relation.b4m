// std/relation.b4m — binary relations and equivalence relations over the shared
// element sort (std/element.b4m).
//
// A relation on X is modeled as a binary predicate `related(x, y)` over the
// shared `Element` sort (the analogue of `member` for sets / `apply` for
// functions). Its structural properties — reflexive, symmetric, transitive, and
// being an equivalence relation — are predicates fixed by defining axioms (each
// an `iff` biconditional), exactly like `injective` / `surjective` in
// std/function.b4m.
//
// Ranging over the SHARED element sort (not a private one) is what lets a theory
// that shares that sort — e.g. sets in std/set.b4m — compose with relations
// and REUSE these theorems directly (see std/equivalence.b4m).
//
// This is the FOL-tractable layer of relations. What it does NOT model:
// equivalence CLASSES `[a]` and PARTITIONS (a set X = ⋃[x] of classes) — those
// need a quotient / sets-of-sets structure, deferred to a later theory. Every
// theorem here is about the relation itself, membershipwise-free.

import element <<< "std/element.b4m"

sort Element = element.Element
pred related(x: Element, y: Element)

// The relation PROPERTIES are transparent (macro) definitions: each IS its body,
// so a proof gets the body for free (no `reflexiveDef` cite/unfold). `related`
// itself stays an opaque `pred` — it is the theory's free parameter, and a model
// remaps it. (Defines ride along on `related` when a model transfers.)

// reflexive: x ∼ x for every x.
define reflexive = forall x: Element; related(x, x)

// symmetric: x ∼ y implies y ∼ x.
define symmetric = forall x, y: Element; related(x, y) -> related(y, x)

// transitive: x ∼ y and y ∼ z imply x ∼ z.
define transitive = forall x, y, z: Element; related(x, y) -> related(y, z) -> related(x, z)

// an equivalence relation is reflexive, symmetric, and transitive.
define equivalence = reflexive and symmetric and transitive
