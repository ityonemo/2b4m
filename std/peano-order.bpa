// std/peano-order.bpa — the strict order on Nat and everything built on
// it: the `less_than` intro/elim axioms, the order theory (monotonicity,
// transitivity, trichotomy, ...), and strong (course-of-values) induction.
//
// Split out of std/peano.bpa: peano is the arithmetic core (add/mul), and the
// order is a separate theory layered on top — order is *defined* via addition
// (a < b iff b = a + (d+1)), so it depends on arithmetic but arithmetic never
// depends on it. Everything here is PURE; strong induction is derived from
// peano's `induction` axiom, adding no trust surface.

import peano <<< "std/peano.bpa"

// -- vocabulary (aliased from std/peano; single-use names are qualified
//    inline at their call site) ---------------------------------------------

sort Nat = peano.Nat
const ZERO = peano.ZERO
const ONE = peano.ONE
func succ = peano.succ
func add = peano.add
func mul = peano.mul
axiom succInjective = peano.succInjective
axiom succNotZero = peano.succNotZero
axiom addZeroLeft = peano.addZeroLeft
axiom addSuccLeft = peano.addSuccLeft
axiom oneIsSuccZero = peano.oneIsSuccZero
axiom induction = peano.induction
theorem addZeroRight = peano.addZeroRight
theorem addSuccRight = peano.addSuccRight
theorem addIsAssociative = peano.addIsAssociative
theorem addIsCommutative = peano.addIsCommutative
theorem addSuccNeverSelf = peano.addSuccNeverSelf
theorem zeroOrSucc = peano.zeroOrSucc

// a < b iff b is a plus a nonzero (succ) amount. `less_than` stays an OPAQUE
// `pred` (NOT a define): the arithmetic/Farkas accelerator pattern-matches on the
// `less_than` symbol + its `lessThanElim` fact, which an eager-`define` expansion
// would dissolve. So it keeps the intro/elim axiom pair.
pred less_than(a: Nat, b: Nat)
axiom lessThanIntro: forall a, d, b: Nat; add(a, succ(d)) = b -> less_than(a, b)
axiom lessThanElim: forall a, b: Nat; less_than(a, b) -> exists d: Nat; add(a, succ(d)) = b

// a <= b iff a < b or a = b — the honest definition, built transparently ON TOP
// of `less_than`. `less_or_equal` is a `define` (nothing pattern-matches on it;
// Farkas depends only on `less_than`), so a proof sees `less_than(a, b) or a = b`
// directly — the </<= bridge facts are now definitional (or_intro / a case split),
// not separate theorems. `lessOrEqualIsGapExistential` (below) proves this body is
// identical to the old gap-existential characterization `exists d; add(a, d) = b`.
define less_or_equal(a: Nat, b: Nat) = less_than(a, b) or a = b

// -- forwarded theorems -----------------------------------------------------

// addition
intheory succPreservesOrder
intheory succReflectsOrder
intheory lessThanTransitive
intheory lessThanIrreflexive
intheory additionPreservesOrder
intheory multiplicationPreservesOrder
intheory oneCoversZero
intheory trichotomy
intheory notLessThanZero
intheory lessThanSuccRight
intheory lessThanAddCancelLeft
intheory lessOrEqualToLessThanSucc
intheory lessThanSuccToLessOrEqual
intheory lessOrEqualRefl
intheory lessThanToLessOrEqual
intheory lessOrEqualTransitive
intheory lessOrEqualSplit
intheory lessOrEqualAntisymmetric
intheory lessThanSelf
intheory lessThanSuccSplit
intheory strongInduction
intheory mulCancelLeft
intheory lessOrEqualIsGapExistential

// -- order theory ----------------------------------------------------------

theorem succPreservesOrder: forall a, b: Nat; less_than(a, b) -> less_than(succ(a), succ(b))
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @given-a-below-b |
            assume less_than(a, b) {
              @a-below-b |
                less_than(a, b)
                [by hypothesis given-a-below-b]
              @gap-exists |
                exists w: Nat; add(a, succ(w)) = b
                [using specialize lessThanElim(a, b) a-below-b]
              @with-gap-u |
                unpack u: Nat from gap-exists {
                  @gap-witnesses-b |
                    add(a, succ(u)) = b
                    [by hypothesis with-gap-u]
                  @successor-gap-witnesses-succ-b |
                    add(succ(a), succ(u)) = succ(b)
                    [using simplify addSuccLeft gap-witnesses-b]
                  @successors-preserve-order |
                    less_than(succ(a), succ(b))
                    [using specialize lessThanIntro(succ(a), u, succ(b)) successor-gap-witnesses-succ-b]
                }
              @successors-preserve-order |
                less_than(succ(a), succ(b))
                [by exists_elim with-gap-u]
            }
          @a-below-b-implies-successors-below |
            less_than(a, b) -> less_than(succ(a), succ(b))
            [by implies_intro given-a-below-b]
        }
      @discharge-b |
        forall b: Nat; less_than(a, b) -> less_than(succ(a), succ(b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; less_than(a, b) -> less_than(succ(a), succ(b))
    [by forall_intro generalize-a]
qed

// The inverse of succPreservesOrder: stripping a common successor preserves
// the strict order. (Needed to reason about measures under subtraction.)
theorem succReflectsOrder: forall a, b: Nat; less_than(succ(a), succ(b)) -> less_than(a, b)
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @given-successors-below |
            assume less_than(succ(a), succ(b)) {
              @successors-below |
                less_than(succ(a), succ(b))
                [by hypothesis given-successors-below]
              @successor-gap-exists |
                exists d: Nat; add(succ(a), succ(d)) = succ(b)
                [using specialize lessThanElim(succ(a), succ(b)) successors-below]
              @with-gap-d |
                unpack d0: Nat from successor-gap-exists {
                  @successor-gap-witnesses-succ-b |
                    add(succ(a), succ(d0)) = succ(b)
                    [by hypothesis with-gap-d]
                  @successor-gap-unfolds |
                    add(succ(a), succ(d0)) = succ(add(a, succ(d0)))
                    [using simplify addSuccLeft]
                  @succ-of-gap-is-succ-b |
                    succ(add(a, succ(d0))) = succ(b)
                    [by rewrite successor-gap-unfolds successor-gap-witnesses-succ-b]
                  @gap-witnesses-b |
                    add(a, succ(d0)) = b
                    [using specialize succInjective(add(a, succ(d0)), b) succ-of-gap-is-succ-b]
                  @a-below-b |
                    less_than(a, b)
                    [using specialize lessThanIntro(a, d0, b) gap-witnesses-b]
                }
              @a-below-b |
                less_than(a, b)
                [by exists_elim with-gap-d]
            }
          @successors-below-implies-a-below-b |
            less_than(succ(a), succ(b)) -> less_than(a, b)
            [by implies_intro given-successors-below]
        }
      @discharge-b |
        forall b: Nat; less_than(succ(a), succ(b)) -> less_than(a, b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; less_than(succ(a), succ(b)) -> less_than(a, b)
    [by forall_intro generalize-a]
qed

// Strategy: unpack both witnesses; the combined gap is add(u, succ(v)),
// assembled with associativity and one succ-pull.
theorem lessThanTransitive: forall a, b, c: Nat; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-c |
            fix c: Nat {
              @given-a-below-b |
                assume less_than(a, b) {
                  @given-b-below-c |
                    assume less_than(b, c) {
                      @a-below-b |
                        less_than(a, b)
                        [by hypothesis given-a-below-b]
                      @gap-ab-exists |
                        exists w: Nat; add(a, succ(w)) = b
                        [using specialize lessThanElim(a, b) a-below-b]
                      @b-below-c |
                        less_than(b, c)
                        [by hypothesis given-b-below-c]
                      @gap-bc-exists |
                        exists w: Nat; add(b, succ(w)) = c
                        [using specialize lessThanElim(b, c) b-below-c]
                      @with-gap-u |
                        unpack u: Nat from gap-ab-exists {
                          @with-gap-v |
                            unpack v: Nat from gap-bc-exists {
                              @gap-u-witnesses-b |
                                add(a, succ(u)) = b
                                [by hypothesis with-gap-u]
                              @gap-v-witnesses-c |
                                add(b, succ(v)) = c
                                [by hypothesis with-gap-v]
                              @nested-gaps-regroup |
                                add(add(a, succ(u)), succ(v)) = add(a, add(succ(u), succ(v)))
                                [using simplify addIsAssociative]
                              @combined-gap-is-successor |
                                add(succ(u), succ(v)) = succ(add(u, succ(v)))
                                [using simplify addSuccLeft]
                              // add(a, succ(add(u, succ(v)))) = add(a, add(succ(u), succ(v))) = add(add(a, succ(u)), succ(v)) = add(b, succ(v)) = c
                              @successor-gap-reaches-c |
                                add(a, succ(add(u, succ(v)))) = c
                                [using chain combined-gap-is-successor nested-gaps-regroup gap-u-witnesses-b gap-v-witnesses-c]
                              @a-below-c |
                                less_than(a, c)
                                [using specialize lessThanIntro(a, add(u, succ(v)), c) successor-gap-reaches-c]
                            }
                          @a-below-c |
                            less_than(a, c)
                            [by exists_elim with-gap-v]
                        }
                      @a-below-c |
                        less_than(a, c)
                        [by exists_elim with-gap-u]
                    }
                  @b-below-c-implies-a-below-c |
                    less_than(b, c) -> less_than(a, c)
                    [by implies_intro given-b-below-c]
                }
              @a-below-b-implies-transitively-below-c |
                less_than(a, b) -> less_than(b, c) -> less_than(a, c)
                [by implies_intro given-a-below-b]
            }
          @discharge-c |
            forall c: Nat; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Nat; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Nat; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
    [by forall_intro generalize-a]
qed

// Strategy: a witness for n < n would make add(n, succ(w)) = n, contradicting
// addSuccNeverSelf.
theorem lessThanIrreflexive: forall n: Nat; not less_than(n, n)
proof
  @generalize-n |
    fix n: Nat {
      @given-n-below-n |
        assume less_than(n, n) {
          @n-below-n |
            less_than(n, n)
            [by hypothesis given-n-below-n]
          @self-gap-exists |
            exists w: Nat; add(n, succ(w)) = n
            [using specialize lessThanElim(n, n) n-below-n]
          @with-gap-u |
            unpack u: Nat from self-gap-exists {
              @gap-witnesses-self |
                add(n, succ(u)) = n
                [by hypothesis with-gap-u]
              @gap-cannot-witness-self |
                add(n, succ(u)) != n
                [using specialize addSuccNeverSelf(n, u)]
              @not-n-below-n |
                not less_than(n, n)
                [by absurd gap-witnesses-self gap-cannot-witness-self]
            }
          @not-n-below-n |
            not less_than(n, n)
            [by exists_elim with-gap-u]
          @n-below-n-restated |
            less_than(n, n)
            [by hypothesis given-n-below-n]
        }
      @no-n-below-n |
        not less_than(n, n)
        [by not_intro given-n-below-n n-below-n-restated not-n-below-n]
    }
  @conclusion |
    forall n: Nat; not less_than(n, n)
    [by forall_intro generalize-n]
qed

// Strategy: the same witness works after adding c on the left, regrouped with
// associativity.
theorem additionPreservesOrder: forall a, b, c: Nat; less_than(a, b) -> less_than(add(c, a), add(c, b))
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-c |
            fix c: Nat {
              @given-a-below-b |
                assume less_than(a, b) {
                  @a-below-b |
                    less_than(a, b)
                    [by hypothesis given-a-below-b]
                  @gap-exists |
                    exists w: Nat; add(a, succ(w)) = b
                    [using specialize lessThanElim(a, b) a-below-b]
                  @with-gap-u |
                    unpack u: Nat from gap-exists {
                      @gap-witnesses-b |
                        add(a, succ(u)) = b
                        [by hypothesis with-gap-u]
                      @shifted-gap-witnesses-c-plus-b |
                        add(add(c, a), succ(u)) = add(c, b)
                        [using simplify addIsAssociative gap-witnesses-b]
                      @shifted-preserves-order |
                        less_than(add(c, a), add(c, b))
                        [using specialize lessThanIntro(add(c, a), u, add(c, b)) shifted-gap-witnesses-c-plus-b]
                    }
                  @shifted-preserves-order |
                    less_than(add(c, a), add(c, b))
                    [by exists_elim with-gap-u]
                }
              @a-below-b-implies-shifted-below |
                less_than(a, b) -> less_than(add(c, a), add(c, b))
                [by implies_intro given-a-below-b]
            }
          @discharge-c |
            forall c: Nat; less_than(a, b) -> less_than(add(c, a), add(c, b))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Nat; less_than(a, b) -> less_than(add(c, a), add(c, b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Nat; less_than(a, b) -> less_than(add(c, a), add(c, b))
    [by forall_intro generalize-a]
qed

// Strategy: induction; every natural is ZERO or a successor. The case-split
// helper for trichotomy.
theorem multiplicationPreservesOrder: forall a, b, c: Nat; less_than(a, b) -> less_than(mul(succ(c), a), mul(succ(c), b))
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-c |
            fix c: Nat {
              @given-a-below-b |
                assume less_than(a, b) {
                  @a-below-b |
                    less_than(a, b)
                    [by hypothesis given-a-below-b]
                  @gap-exists |
                    exists w: Nat; add(a, succ(w)) = b
                    [using specialize lessThanElim(a, b) a-below-b]
                  @with-gap-u |
                    unpack u: Nat from gap-exists {
                      @gap-witnesses-b |
                        add(a, succ(u)) = b
                        [by hypothesis with-gap-u]
                      @b-is-a-plus-gap |
                        b = add(a, succ(u))
                        [by symmetry gap-witnesses-b]
                      @scaled-b-distributed |
                        mul(succ(c), b) = add(mul(succ(c), a), mul(succ(c), succ(u)))
                        [using simplify b-is-a-plus-gap peano.mulAddDistribLeft]
                      @scaled-gap-total |
                        mul(succ(c), succ(u)) = succ(add(mul(c, succ(u)), u))
                        [using simplify peano.mulSuccLeft addSuccRight]
                      @scaled-b-has-successor-gap |
                        mul(succ(c), b) = add(mul(succ(c), a), succ(add(mul(c, succ(u)), u)))
                        [by rewrite scaled-gap-total scaled-b-distributed]
                      @scaled-gap-witnesses-scaled-b |
                        add(mul(succ(c), a), succ(add(mul(c, succ(u)), u))) = mul(succ(c), b)
                        [by symmetry scaled-b-has-successor-gap]
                      @scaling-preserves-order |
                        less_than(mul(succ(c), a), mul(succ(c), b))
                        [using specialize lessThanIntro(mul(succ(c), a), add(mul(c, succ(u)), u), mul(succ(c), b)) scaled-gap-witnesses-scaled-b]
                    }
                  @scaling-preserves-order |
                    less_than(mul(succ(c), a), mul(succ(c), b))
                    [by exists_elim with-gap-u]
                }
              @a-below-b-implies-scaling-preserves-order |
                less_than(a, b) -> less_than(mul(succ(c), a), mul(succ(c), b))
                [by implies_intro given-a-below-b]
            }
          @discharge-c |
            forall c: Nat; less_than(a, b) -> less_than(mul(succ(c), a), mul(succ(c), b))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Nat; less_than(a, b) -> less_than(mul(succ(c), a), mul(succ(c), b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Nat; less_than(a, b) -> less_than(mul(succ(c), a), mul(succ(c), b))
    [by forall_intro generalize-a]
qed

// Strategy: ONE covers ZERO — ZERO < ONE, and nothing sits strictly between:
// a middle n would be a successor whose combined gap makes succ(...) = ZERO.
theorem oneCoversZero: less_than(ZERO, ONE) and (forall n: Nat; not (less_than(ZERO, n) and less_than(n, ONE)))
proof
  // part 1: ZERO < ONE, witness ZERO
  @zero-gap-reaches-one |
    add(ZERO, succ(ZERO)) = ONE
    [using simplify addZeroLeft oneIsSuccZero]
  @part-one |
    less_than(ZERO, ONE)
    [using specialize lessThanIntro(ZERO, ZERO, ONE) zero-gap-reaches-one]

  // part 2: no n strictly between ZERO and ONE
  @generalize-n |
    fix n: Nat {
      @given-n-between-zero-and-one |
        assume less_than(ZERO, n) and less_than(n, ONE) {
          @n-is-strictly-between |
            less_than(ZERO, n) and less_than(n, ONE)
            [by hypothesis given-n-between-zero-and-one]
          @zero-below-n |
            less_than(ZERO, n)
            [by and_elim_left n-is-strictly-between]
          @n-below-one |
            less_than(n, ONE)
            [by and_elim_right n-is-strictly-between]
          @lower-gap-exists |
            exists w: Nat; add(ZERO, succ(w)) = n
            [using specialize lessThanElim(ZERO, n) zero-below-n]
          @upper-gap-exists |
            exists w: Nat; add(n, succ(w)) = ONE
            [using specialize lessThanElim(n, ONE) n-below-one]
          @with-lower-gap-u |
            unpack u: Nat from lower-gap-exists {
              @lower-gap-witnesses-n |
                add(ZERO, succ(u)) = n
                [by hypothesis with-lower-gap-u]
              @n-is-lower-gap |
                n = add(ZERO, succ(u))
                [by symmetry lower-gap-witnesses-n]
              @n-is-succ-u |
                n = succ(u)
                [using simplify n-is-lower-gap addZeroLeft]
              @with-upper-gap-v |
                unpack v: Nat from upper-gap-exists {
                  @upper-gap-witnesses-one |
                    add(n, succ(v)) = ONE
                    [by hypothesis with-upper-gap-v]
                  @one-def-in |
                    ONE = succ(ZERO)
                    [by cite oneIsSuccZero]
                  @combined-gap-unfolds |
                    add(succ(u), succ(v)) = succ(add(u, succ(v)))
                    [using simplify addSuccLeft]
                  // succ(add(u, succ(v))) = add(succ(u), succ(v)) = add(n, succ(v)) = ONE = succ(ZERO)
                  @succ-of-inner-gap-is-succ-zero |
                    succ(add(u, succ(v))) = succ(ZERO)
                    [using chain combined-gap-unfolds n-is-succ-u upper-gap-witnesses-one one-def-in]
                  @inner-gap-is-zero |
                    add(u, succ(v)) = ZERO
                    [using specialize succInjective(add(u, succ(v)), ZERO) succ-of-inner-gap-is-succ-zero]
                  @inner-gap-unfolds |
                    add(u, succ(v)) = succ(add(u, v))
                    [using simplify addSuccRight]
                  // succ(add(u, v)) = add(u, succ(v)) = ZERO
                  @succ-of-sum-is-zero |
                    succ(add(u, v)) = ZERO
                    [using chain inner-gap-unfolds inner-gap-is-zero]
                  @succ-of-sum-is-nonzero |
                    succ(add(u, v)) != ZERO
                    [using specialize succNotZero(add(u, v))]
                  @nothing-lies-between |
                    not (less_than(ZERO, n) and less_than(n, ONE))
                    [by absurd succ-of-sum-is-zero succ-of-sum-is-nonzero]
                }
              @nothing-lies-between |
                not (less_than(ZERO, n) and less_than(n, ONE))
                [by exists_elim with-upper-gap-v]
            }
          @nothing-lies-between |
            not (less_than(ZERO, n) and less_than(n, ONE))
            [by exists_elim with-lower-gap-u]
        }
      @no-middle |
        not (less_than(ZERO, n) and less_than(n, ONE))
        [by not_intro given-n-between-zero-and-one n-is-strictly-between nothing-lies-between]
    }
  @part-two |
    forall n: Nat; not (less_than(ZERO, n) and less_than(n, ONE))
    [by forall_intro generalize-n]

  @conclusion |
    less_than(ZERO, ONE) and (forall n: Nat; not (less_than(ZERO, n) and less_than(n, ONE)))
    [by and_intro part-one part-two]
qed

// Strategy: induction on a with prop(k) := forall b; k < b or k = b or b < k.
// The base and the step both case-split b via zeroOrSucc; the step's successor
// case splits three ways on the inductive hypothesis — an or_elim tree with
// succPreservesOrder carrying the strict branches.
theorem trichotomy: forall a, b: Nat; less_than(a, b) or a = b or less_than(b, a)
proof
  // base: ZERO against any b
  @base-case-proof |
    fix bb: Nat {
      @b-is-zero-or-successor |
        bb = ZERO or (exists m: Nat; bb = succ(m))
        [using specialize zeroOrSucc(bb)]
      @when-b-is-zero |
        assume bb = ZERO {
          @b-is-zero |
            bb = ZERO
            [by hypothesis when-b-is-zero]
          @zero-equals-b |
            ZERO = bb
            [by symmetry b-is-zero]
          @below-or-equal |
            less_than(ZERO, bb) or ZERO = bb
            [by or_intro_right zero-equals-b]
          @trichotomy-at-zero |
            less_than(ZERO, bb) or ZERO = bb or less_than(bb, ZERO)
            [by or_intro_left below-or-equal]
        }
      @when-b-is-successor |
        assume exists m: Nat; bb = succ(m) {
          @b-is-some-successor |
            exists m: Nat; bb = succ(m)
            [by hypothesis when-b-is-successor]
          @with-predecessor-m |
            unpack m0: Nat from b-is-some-successor {
              @b-is-succ-m |
                bb = succ(m0)
                [by hypothesis with-predecessor-m]
              @zero-gap-reaches-succ-m |
                add(ZERO, succ(m0)) = succ(m0)
                [using simplify addZeroLeft]
              @zero-below-succ-m |
                less_than(ZERO, succ(m0))
                [using specialize lessThanIntro(ZERO, m0, succ(m0)) zero-gap-reaches-succ-m]
              @zero-below-b |
                less_than(ZERO, bb)
                [by rewrite b-is-succ-m zero-below-succ-m]
              @below-or-equal |
                less_than(ZERO, bb) or ZERO = bb
                [by or_intro_left zero-below-b]
              @trichotomy-at-zero |
                less_than(ZERO, bb) or ZERO = bb or less_than(bb, ZERO)
                [by or_intro_left below-or-equal]
            }
          @trichotomy-at-zero |
            less_than(ZERO, bb) or ZERO = bb or less_than(bb, ZERO)
            [by exists_elim with-predecessor-m]
        }
      @trichotomy-at-zero |
        less_than(ZERO, bb) or ZERO = bb or less_than(bb, ZERO)
        [by or_elim b-is-zero-or-successor when-b-is-zero when-b-is-successor]
    }
  @base-case |
    forall b: Nat; less_than(ZERO, b) or ZERO = b or less_than(b, ZERO)
    [by forall_intro base-case-proof]

  // step: succ(k) against any b, splitting b and then the inductive hypothesis
  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume forall b: Nat; less_than(k, b) or k = b or less_than(b, k) {
          @pointwise |
            fix b2: Nat {
              @b-is-zero-or-successor |
                b2 = ZERO or (exists m: Nat; b2 = succ(m))
                [using specialize zeroOrSucc(b2)]
              @when-b-is-zero |
                assume b2 = ZERO {
                  @zero-gap-reaches-succ-k |
                    add(ZERO, succ(k)) = succ(k)
                    [using simplify addZeroLeft]
                  @zero-below-succ-k |
                    less_than(ZERO, succ(k))
                    [using specialize lessThanIntro(ZERO, k, succ(k)) zero-gap-reaches-succ-k]
                  @b-is-zero |
                    b2 = ZERO
                    [by hypothesis when-b-is-zero]
                  @zero-equals-b |
                    ZERO = b2
                    [by symmetry b-is-zero]
                  @b-below-succ-k |
                    less_than(b2, succ(k))
                    [by rewrite zero-equals-b zero-below-succ-k]
                  @trichotomy-at-succ-k |
                    less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                    [by or_intro_right b-below-succ-k]
                }
              @when-b-is-successor |
                assume exists m: Nat; b2 = succ(m) {
                  @b-is-some-successor |
                    exists m: Nat; b2 = succ(m)
                    [by hypothesis when-b-is-successor]
                  @with-predecessor-m |
                    unpack m1: Nat from b-is-some-successor {
                      @b-is-succ-m |
                        b2 = succ(m1)
                        [by hypothesis with-predecessor-m]
                      @inductive-hypothesis |
                        forall b: Nat; less_than(k, b) or k = b or less_than(b, k)
                        [by hypothesis given-inductive-hypothesis]
                      @trichotomy-k-against-m |
                        less_than(k, m1) or k = m1 or less_than(m1, k)
                        [by forall_elim(m1) inductive-hypothesis]
                      @when-k-below-or-equal-m |
                        assume less_than(k, m1) or k = m1 {
                          @k-below-or-equal-m |
                            less_than(k, m1) or k = m1
                            [by hypothesis when-k-below-or-equal-m]
                          @when-k-below-m |
                            assume less_than(k, m1) {
                              @k-below-m |
                                less_than(k, m1)
                                [by hypothesis when-k-below-m]
                              @succ-k-below-succ-m |
                                less_than(succ(k), succ(m1))
                                [using specialize succPreservesOrder(k, m1) k-below-m]
                              @succ-k-below-b |
                                less_than(succ(k), b2)
                                [by rewrite b-is-succ-m succ-k-below-succ-m]
                              @below-or-equal |
                                less_than(succ(k), b2) or succ(k) = b2
                                [by or_intro_left succ-k-below-b]
                              @trichotomy-at-succ-k |
                                less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                                [by or_intro_left below-or-equal]
                            }
                          @when-k-equals-m |
                            assume k = m1 {
                              @k-equals-m |
                                k = m1
                                [by hypothesis when-k-equals-m]
                              @succ-k-equals-succ-m |
                                succ(k) = succ(m1)
                                [using simplify k-equals-m]
                              @succ-k-equals-b |
                                succ(k) = b2
                                [by rewrite b-is-succ-m succ-k-equals-succ-m]
                              @below-or-equal |
                                less_than(succ(k), b2) or succ(k) = b2
                                [by or_intro_right succ-k-equals-b]
                              @trichotomy-at-succ-k |
                                less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                                [by or_intro_left below-or-equal]
                            }
                          @trichotomy-at-succ-k |
                            less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                            [by or_elim k-below-or-equal-m when-k-below-m when-k-equals-m]
                        }
                      @when-m-below-k |
                        assume less_than(m1, k) {
                          @m-below-k |
                            less_than(m1, k)
                            [by hypothesis when-m-below-k]
                          @succ-m-below-succ-k |
                            less_than(succ(m1), succ(k))
                            [using specialize succPreservesOrder(m1, k) m-below-k]
                          @b-below-succ-k |
                            less_than(b2, succ(k))
                            [by rewrite b-is-succ-m succ-m-below-succ-k]
                          @trichotomy-at-succ-k |
                            less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                            [by or_intro_right b-below-succ-k]
                        }
                      @trichotomy-at-succ-k |
                        less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                        [by or_elim trichotomy-k-against-m when-k-below-or-equal-m when-m-below-k]
                    }
                  @trichotomy-at-succ-k |
                    less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                    [by exists_elim with-predecessor-m]
                }
              @trichotomy-at-succ-k |
                less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                [by or_elim b-is-zero-or-successor when-b-is-zero when-b-is-successor]
            }
          @discharge-b |
            forall b: Nat; less_than(succ(k), b) or succ(k) = b or less_than(b, succ(k))
            [by forall_intro pointwise]
        }
      @induction-step-at-k |
        (forall b: Nat; less_than(k, b) or k = b or less_than(b, k)) -> forall b: Nat; less_than(succ(k), b) or succ(k) = b or less_than(b, succ(k))
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; (forall b: Nat; less_than(k, b) or k = b or less_than(b, k)) -> forall b: Nat; less_than(succ(k), b) or succ(k) = b or less_than(b, succ(k))
    [by forall_intro induction-step]

  @conclusion |
    forall a, b: Nat; less_than(a, b) or a = b or less_than(b, a)
    [using instantiation induction((fun k: Nat => forall b: Nat; less_than(k, b) or k = b or less_than(b, k))) base-case induction-step-for-all-k]
qed

// Nothing sits below ZERO: a witness would make succ(add(a, u)) = ZERO,
// contradicting succNotZero. (simplify handles the addSuccRight push.)
theorem notLessThanZero: forall a: Nat; not less_than(a, ZERO)
proof
  @generalize-a |
    fix a: Nat {
      @given-a-below-zero |
        assume less_than(a, ZERO) {
          @a-below-zero |
            less_than(a, ZERO)
            [by hypothesis given-a-below-zero]
          @gap-to-zero-exists |
            exists w: Nat; add(a, succ(w)) = ZERO
            [using specialize lessThanElim(a, ZERO) a-below-zero]
          @with-gap-u |
            unpack u: Nat from gap-to-zero-exists {
              @gap-reaches-zero |
                add(a, succ(u)) = ZERO
                [by hypothesis with-gap-u]
              @gap-is-successor |
                add(a, succ(u)) = succ(add(a, u))
                [using simplify addSuccRight]
              @successor-is-zero |
                succ(add(a, u)) = ZERO
                [by rewrite gap-is-successor gap-reaches-zero]
              @successor-is-nonzero |
                succ(add(a, u)) != ZERO
                [using specialize succNotZero(add(a, u))]
              @not-a-below-zero |
                not less_than(a, ZERO)
                [by absurd successor-is-zero successor-is-nonzero]
            }
          @not-a-below-zero |
            not less_than(a, ZERO)
            [by exists_elim with-gap-u]
          @a-below-zero-restated |
            less_than(a, ZERO)
            [by hypothesis given-a-below-zero]
        }
      @no-a-below-zero |
        not less_than(a, ZERO)
        [by not_intro given-a-below-zero a-below-zero-restated not-a-below-zero]
    }
  @conclusion |
    forall a: Nat; not less_than(a, ZERO)
    [by forall_intro generalize-a]
qed

// Growing the bound preserves order: the witness for a < b grows by one.
theorem lessThanSuccRight: forall a, b: Nat; less_than(a, b) -> less_than(a, succ(b))
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @given-a-below-b |
            assume less_than(a, b) {
              @a-below-b |
                less_than(a, b)
                [by hypothesis given-a-below-b]
              @gap-exists |
                exists w: Nat; add(a, succ(w)) = b
                [using specialize lessThanElim(a, b) a-below-b]
              @with-gap-u |
                unpack u: Nat from gap-exists {
                  @gap-witnesses-b |
                    add(a, succ(u)) = b
                    [by hypothesis with-gap-u]
                  @grown-gap-is-successor |
                    add(a, succ(succ(u))) = succ(add(a, succ(u)))
                    [using simplify addSuccRight]
                  @grown-gap-reaches-succ-b |
                    add(a, succ(succ(u))) = succ(b)
                    [by rewrite gap-witnesses-b grown-gap-is-successor]
                  @a-below-succ-b |
                    less_than(a, succ(b))
                    [using specialize lessThanIntro(a, succ(u), succ(b)) grown-gap-reaches-succ-b]
                }
              @a-below-succ-b |
                less_than(a, succ(b))
                [by exists_elim with-gap-u]
            }
          @a-below-b-implies-a-below-succ-b |
            less_than(a, b) -> less_than(a, succ(b))
            [by implies_intro given-a-below-b]
        }
      @discharge-b |
        forall b: Nat; less_than(a, b) -> less_than(a, succ(b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; less_than(a, b) -> less_than(a, succ(b))
    [by forall_intro generalize-a]
qed

// Strategy: induction on c with
// prop(k) := forall a, b: Nat; add(k, a) = add(k, b) -> a = b.
// Base strips add(ZERO, _); the step peels one succ with succInjective.
theorem lessThanAddCancelLeft: forall c, a, b: Nat; less_than(add(c, a), add(c, b)) -> less_than(a, b)
proof
  @generalize-c |
    fix c: Nat {
      @generalize-a |
        fix a: Nat {
          @generalize-b |
            fix b: Nat {
              @given-shifted-below |
                assume less_than(add(c, a), add(c, b)) {
                  @shifted-below |
                    less_than(add(c, a), add(c, b))
                    [by hypothesis given-shifted-below]
                  @shifted-gap-exists |
                    exists w: Nat; add(add(c, a), succ(w)) = add(c, b)
                    [using specialize lessThanElim(add(c, a), add(c, b)) shifted-below]
                  @with-gap-u |
                    unpack u: Nat from shifted-gap-exists {
                      @shifted-gap-witnesses-c-plus-b |
                        add(add(c, a), succ(u)) = add(c, b)
                        [by hypothesis with-gap-u]
                      @shifted-gap-regroups |
                        add(add(c, a), succ(u)) = add(c, add(a, succ(u)))
                        [using simplify addIsAssociative]
                      @c-plus-gap-is-c-plus-b |
                        add(c, add(a, succ(u))) = add(c, b)
                        [by rewrite shifted-gap-regroups shifted-gap-witnesses-c-plus-b]
                      @gap-witnesses-b |
                        add(a, succ(u)) = b
                        [using specialize peano.addCancelLeft(c, add(a, succ(u)), b) c-plus-gap-is-c-plus-b]
                      @a-below-b |
                        less_than(a, b)
                        [using specialize lessThanIntro(a, u, b) gap-witnesses-b]
                    }
                  @a-below-b |
                    less_than(a, b)
                    [by exists_elim with-gap-u]
                }
              @shifted-below-implies-a-below-b |
                less_than(add(c, a), add(c, b)) -> less_than(a, b)
                [by implies_intro given-shifted-below]
            }
          @discharge-b |
            forall b: Nat; less_than(add(c, a), add(c, b)) -> less_than(a, b)
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Nat; less_than(add(c, a), add(c, b)) -> less_than(a, b)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall c, a, b: Nat; less_than(add(c, a), add(c, b)) -> less_than(a, b)
    [by forall_intro generalize-c]
qed

// Swap the two outermost addends of a right-nested sum: the primitive move
// for sorting sums under associativity (used by certificate emitters).

// -- order helpers + strong induction (course-of-values) -------------------

theorem lessThanSelf: forall n: Nat; less_than(n, succ(n))
proof
  @generalize-n |
    fix n: Nat {
      // add(n, succ(ZERO)) = succ(n), so lessThanIntro gives n < succ(n)
      @unit-gap-reaches-succ-n |
        add(n, succ(ZERO)) = succ(n)
        [using simplify addSuccRight addZeroRight]
      @n-below-succ-n |
        less_than(n, succ(n))
        [using specialize lessThanIntro(n, ZERO, succ(n)) unit-gap-reaches-succ-n]
    }
  @conclusion |
    forall n: Nat; less_than(n, succ(n))
    [by forall_intro generalize-n]
qed

// m < succ(k)  ->  (m < k or m = k). The "predecessor bound": splits a
// strict-below-successor into strictly-below-or-equal. (trichotomy gives the
// three-way split; this is the two-way form the induction step needs.)
theorem lessThanSuccSplit: forall m, k: Nat; less_than(m, succ(k)) -> (less_than(m, k) or m = k)
proof
  @generalize-m |
    fix m: Nat {
      @generalize-k |
        fix k: Nat {
          @given-m-below-succ-k |
            assume less_than(m, succ(k)) {
              @m-below-succ-k |
                less_than(m, succ(k))
                [by hypothesis given-m-below-succ-k]
              @gap-exists |
                exists d: Nat; add(m, succ(d)) = succ(k)
                [using specialize lessThanElim(m, succ(k)) m-below-succ-k]
              @with-gap-d |
                unpack d0: Nat from gap-exists {
                  @gap-reaches-succ-k |
                    add(m, succ(d0)) = succ(k)
                    [by hypothesis with-gap-d]
                  @gap-is-zero-or-successor |
                    d0 = ZERO or (exists mm: Nat; d0 = succ(mm))
                    [using specialize zeroOrSucc(d0)]
                  // d0 = ZERO: add(m, succ(ZERO)) = succ(k), so succ(m) = succ(k), m = k
                  @when-gap-is-zero |
                    assume d0 = ZERO {
                      @gap-is-zero |
                        d0 = ZERO
                        [by hypothesis when-gap-is-zero]
                      @unit-gap-reaches-succ-k |
                        add(m, succ(ZERO)) = succ(k)
                        [by rewrite gap-is-zero gap-reaches-succ-k]
                      @unit-gap-is-succ-m |
                        add(m, succ(ZERO)) = succ(m)
                        [using simplify addSuccRight addZeroRight]
                      @succ-m-equals-succ-k |
                        succ(m) = succ(k)
                        [by rewrite unit-gap-is-succ-m unit-gap-reaches-succ-k]
                      @m-equals-k |
                        m = k
                        [using specialize succInjective(m, k) succ-m-equals-succ-k]
                      @below-or-equal |
                        less_than(m, k) or m = k
                        [by or_intro_right m-equals-k]
                    }
                  // d0 = succ(e0): add(m, succ(succ(e0))) = succ(k), so add(m,succ(e0)) = k, m < k
                  @when-gap-is-successor |
                    assume exists mm: Nat; d0 = succ(mm) {
                      @gap-is-some-successor |
                        exists mm: Nat; d0 = succ(mm)
                        [by hypothesis when-gap-is-successor]
                      @with-predecessor-e |
                        unpack e0: Nat from gap-is-some-successor {
                          @gap-is-succ-e |
                            d0 = succ(e0)
                            [by hypothesis with-predecessor-e]
                          @successor-gap-reaches-succ-k |
                            add(m, succ(succ(e0))) = succ(k)
                            [by rewrite gap-is-succ-e gap-reaches-succ-k]
                          @successor-gap-unfolds |
                            add(m, succ(succ(e0))) = succ(add(m, succ(e0)))
                            [using simplify addSuccRight]
                          @succ-of-inner-gap-is-succ-k |
                            succ(add(m, succ(e0))) = succ(k)
                            [by rewrite successor-gap-unfolds successor-gap-reaches-succ-k]
                          @inner-gap-reaches-k |
                            add(m, succ(e0)) = k
                            [using specialize succInjective(add(m, succ(e0)), k) succ-of-inner-gap-is-succ-k]
                          @m-below-k |
                            less_than(m, k)
                            [using specialize lessThanIntro(m, e0, k) inner-gap-reaches-k]
                          @below-or-equal |
                            less_than(m, k) or m = k
                            [by or_intro_left m-below-k]
                        }
                      @below-or-equal |
                        less_than(m, k) or m = k
                        [by exists_elim with-predecessor-e]
                    }
                  @below-or-equal |
                    less_than(m, k) or m = k
                    [by or_elim gap-is-zero-or-successor when-gap-is-zero when-gap-is-successor]
                }
              @below-or-equal |
                less_than(m, k) or m = k
                [by exists_elim with-gap-d]
            }
          @m-below-succ-k-implies-below-or-equal |
            less_than(m, succ(k)) -> (less_than(m, k) or m = k)
            [by implies_intro given-m-below-succ-k]
        }
      @discharge-k |
        forall k: Nat; less_than(m, succ(k)) -> (less_than(m, k) or m = k)
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall m, k: Nat; less_than(m, succ(k)) -> (less_than(m, k) or m = k)
    [by forall_intro generalize-m]
qed

// -- strong induction -------------------------------------------------------

// Course-of-values induction: to prove P(n) for all n, it suffices to prove
// P(n) from the assumption that P(m) holds for every m < n.
//
// Derived from plain `induction` on the auxiliary predicate
//   Q(n) := forall m; m < n -> prop(m).
// Base Q(ZERO) is vacuous (nothing is below ZERO); the step Q(k) -> Q(succ k)
// uses lessThanSuccSplit to reduce m < succ(k) to m < k (use Q(k)) or m = k
// (use the strong step at k). Then prop(n) follows from Q(succ n) at m = n.
theorem strongInduction(prop: Nat -> Prop):
  (forall n: Nat; (forall m: Nat; less_than(m, n) -> prop(m)) -> prop(n))
  -> forall n: Nat; prop(n)
proof
  @given-strong-step |
    assume forall n: Nat; (forall m: Nat; less_than(m, n) -> prop(m)) -> prop(n) {
      // base: Q(ZERO) = forall m; m < ZERO -> prop(m), vacuously true
      @base-case-proof |
        fix m0: Nat {
          @given-m-below-zero |
            assume less_than(m0, ZERO) {
              @m-below-zero |
                less_than(m0, ZERO)
                [by hypothesis given-m-below-zero]
              @m-not-below-zero |
                not less_than(m0, ZERO)
                [using specialize notLessThanZero(m0)]
              @prop-holds-vacuously |
                prop(m0)
                [by absurd m-below-zero m-not-below-zero]
            }
          @below-zero-implies-prop |
            less_than(m0, ZERO) -> prop(m0)
            [by implies_intro given-m-below-zero]
        }
      @base-case |
        forall m: Nat; less_than(m, ZERO) -> prop(m)
        [by forall_intro base-case-proof]

      // step: Q(k) -> Q(succ k)
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume forall m: Nat; less_than(m, k) -> prop(m) {
              @inductive-hypothesis |
                forall m: Nat; less_than(m, k) -> prop(m)
                [by hypothesis given-inductive-hypothesis]
              // prop(k), from the strong step applied to Q(k)
              @strong-step |
                forall n: Nat; (forall m: Nat; less_than(m, n) -> prop(m)) -> prop(n)
                [by hypothesis given-strong-step]
              @prop-k |
                prop(k)
                [using specialize strong-step(k) inductive-hypothesis]
              // Q(succ k): forall m; m < succ k -> prop(m)
              @generalize-m |
                fix m1: Nat {
                  @given-m-below-succ-k |
                    assume less_than(m1, succ(k)) {
                      @m-below-succ-k |
                        less_than(m1, succ(k))
                        [by hypothesis given-m-below-succ-k]
                      @m-below-k-or-equal |
                        less_than(m1, k) or m1 = k
                        [using specialize lessThanSuccSplit(m1, k) m-below-succ-k]
                      @when-m-below-k |
                        assume less_than(m1, k) {
                          @m-below-k |
                            less_than(m1, k)
                            [by hypothesis when-m-below-k]
                          @prop-m |
                            prop(m1)
                            [using specialize inductive-hypothesis(m1) m-below-k]
                        }
                      @when-m-equals-k |
                        assume m1 = k {
                          @m-equals-k |
                            m1 = k
                            [by hypothesis when-m-equals-k]
                          @prop-m |
                            prop(m1)
                            [by rewrite m-equals-k prop-k]
                        }
                      @prop-m |
                        prop(m1)
                        [by or_elim m-below-k-or-equal when-m-below-k when-m-equals-k]
                    }
                  @below-succ-k-implies-prop |
                    less_than(m1, succ(k)) -> prop(m1)
                    [by implies_intro given-m-below-succ-k]
                }
              @prop-holds-below-succ-k |
                forall m: Nat; less_than(m, succ(k)) -> prop(m)
                [by forall_intro generalize-m]
            }
          @induction-step-at-k |
            (forall m: Nat; less_than(m, k) -> prop(m)) -> forall m: Nat; less_than(m, succ(k)) -> prop(m)
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; (forall m: Nat; less_than(m, k) -> prop(m)) -> forall m: Nat; less_than(m, succ(k)) -> prop(m)
        [by forall_intro induction-step]

      // forall n; Q(n), by ordinary induction on the auxiliary predicate
      @prop-holds-below-every-n |
        forall n: Nat; forall m: Nat; less_than(m, n) -> prop(m)
        [using instantiation induction((fun j: Nat => forall m: Nat; less_than(m, j) -> prop(m))) base-case induction-step-for-all-k]

      // prop(n) from Q(succ n) applied at m = n (using n < succ n)
      @generalize-n |
        fix n1: Nat {
          @prop-holds-below-succ-n |
            forall m: Nat; less_than(m, succ(n1)) -> prop(m)
            [by forall_elim(succ(n1)) prop-holds-below-every-n]
          @n-below-succ-n |
            less_than(n1, succ(n1))
            [using specialize lessThanSelf(n1)]
          @prop-n |
            prop(n1)
            [using specialize prop-holds-below-succ-n(n1) n-below-succ-n]
        }
      @prop-holds-for-all |
        forall n: Nat; prop(n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    (forall n: Nat; (forall m: Nat; less_than(m, n) -> prop(m)) -> prop(n)) -> forall n: Nat; prop(n)
    [by implies_intro given-strong-step]
qed

// -- the less_or_equal relation -------------------------------------------

// `less_or_equal(a, b)` unfolds to the disjunction `less_than(a, b) or a = b`.
// This anchor theorem proves that body is EXACTLY the old gap-existential
// characterization `exists d; add(a, d) = b` — so the redefinition of
// less_or_equal (from an opaque gap-existential pred to `less_than or =`) is
// faithful. Forward: case-split the disjunction — a strict gap becomes a
// (succ d) gap via lessThanElim; equality is the ZERO gap. Backward: split the
// gap d on zeroOrSucc — a ZERO gap forces a = b, a succ gap gives less_than via
// lessThanIntro.
theorem lessOrEqualIsGapExistential: forall a, b: Nat; less_or_equal(a, b) iff (exists d: Nat; add(a, d) = b)
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          // forward: less_than(a, b) or a = b  ->  exists d; add(a, d) = b
          @given-a-at-most-b |
            assume less_or_equal(a, b) {
              @a-below-b-or-equal |
                less_than(a, b) or a = b
                [by hypothesis given-a-at-most-b]
              @gap-exists |
                exists d: Nat; add(a, d) = b
                case a-below-b-or-equal {
                  @when-a-below-b |
                    assume less_than(a, b) {
                      @a-below-b |
                        less_than(a, b)
                        [by hypothesis when-a-below-b]
                      @strict-gap-exists |
                        exists d: Nat; add(a, succ(d)) = b
                        [using specialize lessThanElim(a, b) a-below-b]
                      @with-strict-gap-d |
                        unpack d0: Nat from strict-gap-exists {
                          @strict-gap-witnesses-b |
                            add(a, succ(d0)) = b
                            [by hypothesis with-strict-gap-d]
                          @conclusion-gap-exists |
                            exists d: Nat; add(a, d) = b
                            [by exists_intro(succ(d0)) strict-gap-witnesses-b]
                        }
                      @conclusion-gap-exists |
                        exists d: Nat; add(a, d) = b
                        [by exists_elim with-strict-gap-d]
                    }
                  @when-a-equals-b |
                    assume a = b {
                      @a-equals-b |
                        a = b
                        [by hypothesis when-a-equals-b]
                      @zero-gap-reaches-a |
                        add(a, ZERO) = a
                        [using simplify addZeroRight]
                      @zero-gap-reaches-b |
                        add(a, ZERO) = b
                        [by rewrite a-equals-b zero-gap-reaches-a]
                      @conclusion-gap-exists |
                        exists d: Nat; add(a, d) = b
                        [by exists_intro(ZERO) zero-gap-reaches-b]
                    }
                }
            }
          @at-most-implies-gap-exists |
            less_or_equal(a, b) -> (exists d: Nat; add(a, d) = b)
            [by implies_intro given-a-at-most-b]

          // backward: exists d; add(a, d) = b  ->  less_than(a, b) or a = b
          @given-gap-exists |
            assume exists d: Nat; add(a, d) = b {
              @gap-exists |
                exists d: Nat; add(a, d) = b
                [by hypothesis given-gap-exists]
              @with-gap-d |
                unpack d0: Nat from gap-exists {
                  @gap-witnesses-b |
                    add(a, d0) = b
                    [by hypothesis with-gap-d]
                  @gap-is-zero-or-successor |
                    d0 = ZERO or (exists m: Nat; d0 = succ(m))
                    [using specialize zeroOrSucc(d0)]
                  @a-below-b-or-equal |
                    less_than(a, b) or a = b
                    case gap-is-zero-or-successor {
                      @when-gap-is-zero |
                        assume d0 = ZERO {
                          @gap-is-zero |
                            d0 = ZERO
                            [by hypothesis when-gap-is-zero]
                          @zero-gap-reaches-b |
                            add(a, ZERO) = b
                            [by rewrite gap-is-zero gap-witnesses-b]
                          @zero-gap-is-a |
                            add(a, ZERO) = a
                            [using simplify addZeroRight]
                          @a-equals-b |
                            a = b
                            [by rewrite zero-gap-is-a zero-gap-reaches-b]
                          @conclusion-below-or-equal |
                            less_than(a, b) or a = b
                            [by or_intro_right a-equals-b]
                        }
                      @when-gap-is-successor |
                        assume exists m: Nat; d0 = succ(m) {
                          @gap-is-some-successor |
                            exists m: Nat; d0 = succ(m)
                            [by hypothesis when-gap-is-successor]
                          @with-predecessor-e |
                            unpack e0: Nat from gap-is-some-successor {
                              @gap-is-succ-e |
                                d0 = succ(e0)
                                [by hypothesis with-predecessor-e]
                              @strict-gap-witnesses-b |
                                add(a, succ(e0)) = b
                                [by rewrite gap-is-succ-e gap-witnesses-b]
                              @a-below-b |
                                less_than(a, b)
                                [using specialize lessThanIntro(a, e0, b) strict-gap-witnesses-b]
                              @conclusion-below-or-equal |
                                less_than(a, b) or a = b
                                [by or_intro_left a-below-b]
                            }
                          @conclusion-below-or-equal |
                            less_than(a, b) or a = b
                            [by exists_elim with-predecessor-e]
                        }
                    }
                  @a-at-most-b |
                    less_or_equal(a, b)
                    [using tautology a-below-b-or-equal]
                }
              @a-at-most-b |
                less_or_equal(a, b)
                [by exists_elim with-gap-d]
            }
          @gap-exists-implies-at-most |
            (exists d: Nat; add(a, d) = b) -> less_or_equal(a, b)
            [by implies_intro given-gap-exists]

          @at-most-iff-gap-exists |
            less_or_equal(a, b) iff (exists d: Nat; add(a, d) = b)
            [by iff_intro at-most-implies-gap-exists gap-exists-implies-at-most]
        }
      @discharge-b |
        forall b: Nat; less_or_equal(a, b) iff (exists d: Nat; add(a, d) = b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; less_or_equal(a, b) iff (exists d: Nat; add(a, d) = b)
    [by forall_intro generalize-a]
qed

// Bridge 1: less_or_equal(a, b) -> less_than(a, succ b). Case-split the
// disjunction: a < b grows to a < succ b (lessThanSuccRight); a = b gives
// a < succ a (lessThanSelf), rewritten to a < succ b.
theorem lessOrEqualToLessThanSucc: forall a, b: Nat; less_or_equal(a, b) -> less_than(a, succ(b))
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @given-a-at-most-b |
            assume less_or_equal(a, b) {
              @a-below-b-or-equal |
                less_than(a, b) or a = b
                [by hypothesis given-a-at-most-b]
              @a-below-succ-b |
                less_than(a, succ(b))
                case a-below-b-or-equal {
                  @when-a-below-b |
                    assume less_than(a, b) {
                      @a-below-b |
                        less_than(a, b)
                        [by hypothesis when-a-below-b]
                      @conclusion-a-below-succ-b |
                        less_than(a, succ(b))
                        [using specialize lessThanSuccRight(a, b) a-below-b]
                    }
                  @when-a-equals-b |
                    assume a = b {
                      @a-equals-b |
                        a = b
                        [by hypothesis when-a-equals-b]
                      @a-below-succ-a |
                        less_than(a, succ(a))
                        [using specialize lessThanSelf(a)]
                      @conclusion-a-below-succ-b |
                        less_than(a, succ(b))
                        [by rewrite a-equals-b a-below-succ-a]
                    }
                }
            }
          @at-most-b-implies-below-succ-b |
            less_or_equal(a, b) -> less_than(a, succ(b))
            [by implies_intro given-a-at-most-b]
        }
      @discharge-b |
        forall b: Nat; less_or_equal(a, b) -> less_than(a, succ(b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; less_or_equal(a, b) -> less_than(a, succ(b))
    [by forall_intro generalize-a]
qed

// Bridge 2 (reverse): less_than(a, succ b) -> le(a, b). lessThanSuccSplit turns
// a < succ b into (a < b or a = b), which IS the unfolded less_or_equal body.
theorem lessThanSuccToLessOrEqual: forall a, b: Nat; less_than(a, succ(b)) -> less_or_equal(a, b)
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @given-a-below-succ-b |
            assume less_than(a, succ(b)) {
              @a-below-succ-b |
                less_than(a, succ(b))
                [by hypothesis given-a-below-succ-b]
              @a-below-b-or-equal |
                less_than(a, b) or a = b
                [using specialize lessThanSuccSplit(a, b) a-below-succ-b]
              @a-at-most-b |
                less_or_equal(a, b)
                [using tautology a-below-b-or-equal]
            }
          @below-succ-b-implies-at-most-b |
            less_than(a, succ(b)) -> less_or_equal(a, b)
            [by implies_intro given-a-below-succ-b]
        }
      @discharge-b |
        forall b: Nat; less_than(a, succ(b)) -> less_or_equal(a, b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; less_than(a, succ(b)) -> less_or_equal(a, b)
    [by forall_intro generalize-a]
qed

// reflexivity: le(a, a). The right disjunct a = a holds by reflexivity.
theorem lessOrEqualRefl: forall a: Nat; less_or_equal(a, a)
proof
  @generalize-a |
    fix a: Nat {
      @a-equals-a |
        a = a
        [by reflexivity]
      @a-below-a-or-equal |
        less_than(a, a) or a = a
        [by or_intro_right a-equals-a]
      @a-at-most-a |
        less_or_equal(a, a)
        [using tautology a-below-a-or-equal]
    }
  @conclusion |
    forall a: Nat; less_or_equal(a, a)
    [by forall_intro generalize-a]
qed

// less_than implies less_or_equal — the left disjunct directly.
theorem lessThanToLessOrEqual: forall a, b: Nat; less_than(a, b) -> less_or_equal(a, b)
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @given-a-below-b |
            assume less_than(a, b) {
              @a-below-b |
                less_than(a, b)
                [by hypothesis given-a-below-b]
              @a-below-b-or-equal |
                less_than(a, b) or a = b
                [by or_intro_left a-below-b]
              @a-at-most-b |
                less_or_equal(a, b)
                [using tautology a-below-b-or-equal]
            }
          @below-b-implies-at-most-b |
            less_than(a, b) -> less_or_equal(a, b)
            [by implies_intro given-a-below-b]
        }
      @discharge-b |
        forall b: Nat; less_than(a, b) -> less_or_equal(a, b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; less_than(a, b) -> less_or_equal(a, b)
    [by forall_intro generalize-a]
qed

// transitivity: le(a,b) -> le(b,c) -> le(a,c). Split le(a,b) and le(b,c) each
// into strict-or-equal; the three nontrivial combinations chain via
// lessThanTransitive / rewriting, then re-wrap with lessThanToLessOrEqual.
theorem lessOrEqualTransitive: forall a, b, c: Nat; less_or_equal(a, b) -> less_or_equal(b, c) -> less_or_equal(a, c)
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-c |
            fix c: Nat {
              @given-a-at-most-b |
                assume less_or_equal(a, b) {
                  @given-b-at-most-c |
                    assume less_or_equal(b, c) {
                      @a-below-b-or-equal |
                        less_than(a, b) or a = b
                        [by hypothesis given-a-at-most-b]
                      @b-below-c-or-equal |
                        less_than(b, c) or b = c
                        [by hypothesis given-b-at-most-c]
                      // split le(a,b): a < b or a = b
                      @a-at-most-c |
                        less_or_equal(a, c)
                        case a-below-b-or-equal {
                          @when-a-below-b |
                            assume less_than(a, b) {
                              @a-below-b |
                                less_than(a, b)
                                [by hypothesis when-a-below-b]
                              // split le(b,c): b < c or b = c
                              @conclusion-a-at-most-c |
                                less_or_equal(a, c)
                                case b-below-c-or-equal {
                                  @when-b-below-c |
                                    assume less_than(b, c) {
                                      @b-below-c |
                                        less_than(b, c)
                                        [by hypothesis when-b-below-c]
                                      @a-below-c |
                                        less_than(a, c)
                                        [using specialize lessThanTransitive(a, b, c) a-below-b b-below-c]
                                      @conclusion-a-at-most-c |
                                        less_or_equal(a, c)
                                        [using specialize lessThanToLessOrEqual(a, c) a-below-c]
                                    }
                                  @when-b-equals-c |
                                    assume b = c {
                                      @b-equals-c |
                                        b = c
                                        [by hypothesis when-b-equals-c]
                                      @a-below-c |
                                        less_than(a, c)
                                        [by rewrite b-equals-c a-below-b]
                                      @conclusion-a-at-most-c |
                                        less_or_equal(a, c)
                                        [using specialize lessThanToLessOrEqual(a, c) a-below-c]
                                    }
                                }
                            }
                          @when-a-equals-b |
                            assume a = b {
                              @a-equals-b |
                                a = b
                                [by hypothesis when-a-equals-b]
                              // le(b,c) with a = b gives le(a,c) by rewriting b -> a
                              @b-at-most-c |
                                less_or_equal(b, c)
                                [by hypothesis given-b-at-most-c]
                              @conclusion-a-at-most-c |
                                less_or_equal(a, c)
                                [by rewrite a-equals-b b-at-most-c]
                            }
                        }
                    }
                  @b-at-most-c-implies-a-at-most-c |
                    less_or_equal(b, c) -> less_or_equal(a, c)
                    [by implies_intro given-b-at-most-c]
                }
              @a-at-most-b-implies-transitively-at-most-c |
                less_or_equal(a, b) -> less_or_equal(b, c) -> less_or_equal(a, c)
                [by implies_intro given-a-at-most-b]
            }
          @discharge-c |
            forall c: Nat; less_or_equal(a, b) -> less_or_equal(b, c) -> less_or_equal(a, c)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Nat; less_or_equal(a, b) -> less_or_equal(b, c) -> less_or_equal(a, c)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Nat; less_or_equal(a, b) -> less_or_equal(b, c) -> less_or_equal(a, c)
    [by forall_intro generalize-a]
qed

// disjunctive form: le(a,b) -> (a < b or a = b). Now definitional — the body of
// less_or_equal IS this disjunction.
theorem lessOrEqualSplit: forall a, b: Nat; less_or_equal(a, b) -> (less_than(a, b) or a = b)
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @given-a-at-most-b |
            assume less_or_equal(a, b) {
              @a-below-b-or-equal |
                less_than(a, b) or a = b
                [by hypothesis given-a-at-most-b]
            }
          @at-most-b-implies-below-or-equal |
            less_or_equal(a, b) -> (less_than(a, b) or a = b)
            [by implies_intro given-a-at-most-b]
        }
      @discharge-b |
        forall b: Nat; less_or_equal(a, b) -> (less_than(a, b) or a = b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; less_or_equal(a, b) -> (less_than(a, b) or a = b)
    [by forall_intro generalize-a]
qed

// equal-or-less builds le the other way: a = b -> le(a,b) is refl+rewrite; a<b -> le is lessThanToLessOrEqual.
// antisymmetry: le(a,b) -> le(b,a) -> a = b. Use split: a<b or a=b; if a<b and b<=a then a<a (contra via transitive+irrefl).
theorem lessOrEqualAntisymmetric: forall a, b: Nat; less_or_equal(a, b) -> less_or_equal(b, a) -> a = b
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @given-a-at-most-b |
            assume less_or_equal(a, b) {
              @given-b-at-most-a |
                assume less_or_equal(b, a) {
                  @a-at-most-b |
                    less_or_equal(a, b)
                    [by hypothesis given-a-at-most-b]
                  @b-at-most-a |
                    less_or_equal(b, a)
                    [by hypothesis given-b-at-most-a]
                  // split le(a,b): a<b or a=b
                  @a-below-b-or-equal |
                    less_than(a, b) or a = b
                    [using specialize lessOrEqualSplit(a, b) a-at-most-b]
                  @when-a-below-b |
                    assume less_than(a, b) {
                      @a-below-b |
                        less_than(a, b)
                        [by hypothesis when-a-below-b]
                      // le(b,a) and a<b: split le(b,a) -> b<a or b=a
                      @b-below-a-or-equal |
                        less_than(b, a) or b = a
                        [using specialize lessOrEqualSplit(b, a) b-at-most-a]
                      @when-b-below-a |
                        assume less_than(b, a) {
                          @b-below-a |
                            less_than(b, a)
                            [by hypothesis when-b-below-a]
                          // a<b and b<a -> a<a via transitive, contradiction with irreflexive
                          @a-below-a |
                            less_than(a, a)
                            [using specialize lessThanTransitive(a, b, a) a-below-b b-below-a]
                          @not-a-below-a |
                            not less_than(a, a)
                            [using specialize lessThanIrreflexive(a)]
                          @a-equals-b-vacuously |
                            a = b
                            [by absurd a-below-a not-a-below-a]
                        }
                      @when-b-equals-a |
                        assume b = a {
                          @b-equals-a |
                            b = a
                            [by hypothesis when-b-equals-a]
                          @a-equals-b |
                            a = b
                            [by symmetry b-equals-a]
                        }
                      @a-equals-b |
                        a = b
                        [by or_elim b-below-a-or-equal when-b-below-a when-b-equals-a]
                    }
                  @when-a-equals-b |
                    assume a = b {
                      @a-equals-b |
                        a = b
                        [by hypothesis when-a-equals-b]
                    }
                  @a-equals-b |
                    a = b
                    [by or_elim a-below-b-or-equal when-a-below-b when-a-equals-b]
                }
              @b-at-most-a-implies-equal |
                less_or_equal(b, a) -> a = b
                [by implies_intro given-b-at-most-a]
            }
          @at-most-both-ways-implies-equal |
            less_or_equal(a, b) -> less_or_equal(b, a) -> a = b
            [by implies_intro given-a-at-most-b]
        }
      @discharge-b |
        forall b: Nat; less_or_equal(a, b) -> less_or_equal(b, a) -> a = b
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; less_or_equal(a, b) -> less_or_equal(b, a) -> a = b
    [by forall_intro generalize-a]
qed

// Left multiplicative cancellation: a nonzero common left factor cancels.
// Strategy: c = succ(c'); trichotomy on a, b; the two strict arms multiply
// through by succ(c') (multiplicationPreservesOrder) to contradict
// mul(c, a) = mul(c, b) via lessThanIrreflexive.
theorem mulCancelLeft: forall c, a, b: Nat; c != ZERO -> mul(c, a) = mul(c, b) -> a = b
proof
  @generalize-c |
    fix c: Nat {
      @generalize-a |
        fix a: Nat {
          @generalize-b |
            fix b: Nat {
              @given-c-nonzero |
                assume c != ZERO {
                  @given-products-equal |
                    assume mul(c, a) = mul(c, b) {
                      @products-equal |
                        mul(c, a) = mul(c, b)
                        [by hypothesis given-products-equal]
                      @c-nonzero |
                        c != ZERO
                        [by hypothesis given-c-nonzero]
                      @c-is-zero-or-succ |
                        c = ZERO or (exists m: Nat; c = succ(m))
                        [using specialize zeroOrSucc(c)]
                      @c-is-succ |
                        exists m: Nat; c = succ(m)
                        [using tautology c-is-zero-or-succ c-nonzero]
                      @with-c-pred |
                        unpack cp: Nat from c-is-succ {
                          @c-equals-succ-cp |
                            c = succ(cp)
                            [by hypothesis with-c-pred]
                          @tri |
                            less_than(a, b) or a = b or less_than(b, a)
                            [using specialize trichotomy(a, b)]
                          @equal-conclusion |
                            a = b
                            case tri {
                              @a-below-b |
                                assume less_than(a, b) {
                                  @a-lt-b |
                                    less_than(a, b)
                                    [by hypothesis a-below-b]
                                  @scaled |
                                    less_than(mul(succ(cp), a), mul(succ(cp), b))
                                    [using specialize multiplicationPreservesOrder(a, b, cp) a-lt-b]
                                  @scaled-c |
                                    less_than(mul(c, a), mul(c, b))
                                    [by rewrite c-equals-succ-cp scaled]
                                  @self-lt |
                                    less_than(mul(c, a), mul(c, a))
                                    [by rewrite products-equal scaled-c]
                                  @not-self-lt |
                                    not less_than(mul(c, a), mul(c, a))
                                    [using specialize lessThanIrreflexive(mul(c, a))]
                                  @absurd-a-below-b |
                                    a = b
                                    [by absurd self-lt not-self-lt]
                                }
                              @a-equals-b |
                                assume a = b {
                                  @a-and-b-coincide |
                                    a = b
                                    [by hypothesis a-equals-b]
                                }
                              @b-below-a |
                                assume less_than(b, a) {
                                  @b-lt-a |
                                    less_than(b, a)
                                    [by hypothesis b-below-a]
                                  @scaled |
                                    less_than(mul(succ(cp), b), mul(succ(cp), a))
                                    [using specialize multiplicationPreservesOrder(b, a, cp) b-lt-a]
                                  @scaled-c |
                                    less_than(mul(c, b), mul(c, a))
                                    [by rewrite c-equals-succ-cp scaled]
                                  @self-lt |
                                    less_than(mul(c, b), mul(c, b))
                                    [by rewrite products-equal scaled-c]
                                  @not-self-lt |
                                    not less_than(mul(c, b), mul(c, b))
                                    [using specialize lessThanIrreflexive(mul(c, b))]
                                  @absurd-b-below-a |
                                    a = b
                                    [by absurd self-lt not-self-lt]
                                }
                            }
                        }
                      @conclusion-a-equals-b |
                        a = b
                        [by exists_elim with-c-pred]
                    }
                  @discharge-products |
                    mul(c, a) = mul(c, b) -> a = b
                    [by implies_intro given-products-equal]
                }
              @discharge-nonzero |
                c != ZERO -> mul(c, a) = mul(c, b) -> a = b
                [by implies_intro given-c-nonzero]
            }
          @discharge-b |
            forall b: Nat; c != ZERO -> mul(c, a) = mul(c, b) -> a = b
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Nat; c != ZERO -> mul(c, a) = mul(c, b) -> a = b
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall c, a, b: Nat; c != ZERO -> mul(c, a) = mul(c, b) -> a = b
    [by forall_intro generalize-c]
qed

// -- the Principle of Well-Ordering ---------------------------------------

// Principle of Well-Ordering (over ℕ): every nonempty subset — a nonempty
// membership predicate `prop` — has a least element.
//
// Proof by strong induction on the negation. Let Q(n) := not prop(n). Show the
// strong step: if every m < n fails prop, then n fails prop too — for if prop(n)
// held, n would BE a least element (any m with prop(m): by trichotomy n < m or
// n = m give n ≤ m, and m < n is impossible since the IH says prop(m) fails),
// contradicting the standing "no least element" assumption. Strong induction then
// makes prop empty, contradicting nonemptiness.
theorem wellOrdering(prop: Nat -> Prop):
  (exists n: Nat; prop(n))
  -> exists least: Nat; prop(least) and (forall m: Nat; prop(m) -> less_or_equal(least, m))
proof
  @given-inhabited |
    assume exists n: Nat; prop(n) {
      @some-element-satisfies |
        exists n: Nat; prop(n)
        [by hypothesis given-inhabited]
      // suppose, for contradiction, there is NO least element.
      @given-no-least |
        assume not (exists least: Nat; prop(least) and (forall m: Nat; prop(m) -> less_or_equal(least, m))) {
          @no-least |
            not (exists least: Nat; prop(least) and (forall m: Nat; prop(m) -> less_or_equal(least, m)))
            [by hypothesis given-no-least]
          // strong step: (forall m < n; not prop(m)) -> (not prop(n)).
          @strong-step |
            fix n: Nat {
              @given-all-below-fail |
                assume forall m: Nat; less_than(m, n) -> (not prop(m)) {
                  @all-below-fail |
                    forall m: Nat; less_than(m, n) -> (not prop(m))
                    [by hypothesis given-all-below-fail]
                  @given-n-satisfies |
                    assume prop(n) {
                      @n-satisfies |
                        prop(n)
                        [by hypothesis given-n-satisfies]
                      // n is a lower bound for prop: for any m with prop(m), n ≤ m.
                      @n-is-lower-bound |
                        fix m: Nat {
                          @given-m-satisfies |
                            assume prop(m) {
                              @m-satisfies |
                                prop(m)
                                [by hypothesis given-m-satisfies]
                              @trichotomy-n-m |
                                less_than(n, m) or n = m or less_than(m, n)
                                [using specialize trichotomy(n, m)]
                              @n-le-m-in-all-cases |
                                less_or_equal(n, m)
                                case trichotomy-n-m {
                                  @when-n-below-m |
                                    assume less_than(n, m) {
                                      @n-below-m |
                                        less_than(n, m)
                                        [by hypothesis when-n-below-m]
                                      @conclusion-n-le-m |
                                        less_or_equal(n, m)
                                        [using specialize lessThanToLessOrEqual(n, m) n-below-m]
                                    }
                                  @when-n-equals-m |
                                    assume n = m {
                                      @n-equals-m |
                                        n = m
                                        [by hypothesis when-n-equals-m]
                                      @n-le-n |
                                        less_or_equal(n, n)
                                        [using specialize lessOrEqualRefl(n)]
                                      @conclusion-n-le-m |
                                        less_or_equal(n, m)
                                        [by rewrite n-equals-m n-le-n]
                                    }
                                  @when-m-below-n |
                                    assume less_than(m, n) {
                                      @m-below-n |
                                        less_than(m, n)
                                        [by hypothesis when-m-below-n]
                                      @m-fails |
                                        not prop(m)
                                        [using specialize all-below-fail(m) m-below-n]
                                      @conclusion-n-le-m |
                                        less_or_equal(n, m)
                                        [by absurd m-satisfies m-fails]
                                    }
                                }
                            }
                          @m-satisfies-implies-n-le-m |
                            prop(m) -> less_or_equal(n, m)
                            [by implies_intro given-m-satisfies]
                        }
                      @n-is-lower-bound-forall |
                        forall m: Nat; prop(m) -> less_or_equal(n, m)
                        [by forall_intro n-is-lower-bound]
                      @n-is-least |
                        prop(n) and (forall m: Nat; prop(m) -> less_or_equal(n, m))
                        [by and_intro n-satisfies n-is-lower-bound-forall]
                      @least-exists |
                        exists least: Nat; prop(least) and (forall m: Nat; prop(m) -> less_or_equal(least, m))
                        [by exists_intro(n) n-is-least]
                      @contradiction-from-n |
                        not prop(n)
                        [by absurd least-exists no-least]
                    }
                  // discharge: prop(n) leads to a least element, which contradicts
                  // no-least; so not prop(n).
                  @n-satisfies-implies-not-prop |
                    prop(n) -> (not prop(n))
                    [by implies_intro given-n-satisfies]
                  @not-prop-n |
                    not prop(n)
                    [using tautology n-satisfies-implies-not-prop]
                }
              @all-below-fail-implies-n-fails |
                (forall m: Nat; less_than(m, n) -> (not prop(m))) -> (not prop(n))
                [by implies_intro given-all-below-fail]
            }
          @strong-step-forall |
            forall n: Nat; (forall m: Nat; less_than(m, n) -> (not prop(m))) -> (not prop(n))
            [by forall_intro strong-step]
          @nothing-satisfies |
            forall n: Nat; not prop(n)
            [using instantiation strongInduction((fun k: Nat => not prop(k))) strong-step-forall]
          // but something DOES satisfy prop; unpack that witness and specialize
          // `nothing-satisfies` to it for a literal clash.
          @with-witness-w |
            unpack w: Nat from some-element-satisfies {
              @w-satisfies |
                prop(w)
                [by hypothesis with-witness-w]
              @w-fails |
                not prop(w)
                [by forall_elim(w) nothing-satisfies]
              @least-exists-at-witness |
                exists least: Nat; prop(least) and (forall m: Nat; prop(m) -> less_or_equal(least, m))
                [by absurd w-satisfies w-fails]
            }
          @least-exists-from-witness |
            exists least: Nat; prop(least) and (forall m: Nat; prop(m) -> less_or_equal(least, m))
            [by exists_elim with-witness-w]
        }
      @least-exists-double-negated |
        not not (exists least: Nat; prop(least) and (forall m: Nat; prop(m) -> less_or_equal(least, m)))
        [by not_intro given-no-least least-exists-from-witness no-least]
      @least-exists-by-contradiction |
        exists least: Nat; prop(least) and (forall m: Nat; prop(m) -> less_or_equal(least, m))
        [by double_negation least-exists-double-negated]
    }
  @conclusion |
    (exists n: Nat; prop(n))
      -> exists least: Nat; prop(least) and (forall m: Nat; prop(m) -> less_or_equal(least, m))
    [by implies_intro given-inhabited]
qed
