// std/permutation/simplicity.b4m — A_n is simple for n >= 5 (Judson, Theorem 10.11).
//
// This file is the CAPSTONE: it composes what the lemma files prove into Judson's conclusion.
// It contains no permutation algebra of its own, by design — every computation lives in
// `alternating.b4m` (Lemma 10.8, conjugation closure) and `alternating-identities.b4m`
// (Lemma 10.9's family reachability and shape selector, Lemma 10.10's four cases).
//
// WHAT IS PROVED HERE AND WHAT IS ASSUMED. The theorem below takes TWO SELECTORS as explicit
// premises, and that is the honest boundary of the formalization right now:
//
//   `aThreeCycleIsInN`  — N contains a 3-cycle. This is Lemma 10.10's conclusion. Its ALGEBRA
//     is fully proved (the four cases are length-free theorems in `alternating-identities.b4m`,
//     needing no cycle-type classification), but the BOOKKEEPING that walks a nontrivial
//     element's disjoint-cycle decomposition and hands each case its three points is not
//     written.
//
//   `everyThreeCycleIsInN` — N contains EVERY 3-cycle. This is Lemma 10.9's conclusion. Its
//     ALGEBRA is likewise fully proved: one conjugation reaches the whole fixed family
//     `(i,j,k)` (`aNormalSubgroupWithOneFamilyMemberHasThemAll`), and each of the four shapes
//     of 3-cycle is a product of family members (the four selector schemas). What is missing is
//     the 13-leaf case analysis on point equalities that decides WHICH shape a given 3-cycle
//     has — mechanical, and sized before being deferred rather than after.
//
// Neither premise is a `hole`: each is a statement a consumer discharges, and the inference
// from them to simplicity is kernel-checked. Stating them is what lets the capstone be a real
// theorem rather than an aspiration — the composition is the part that was never obvious, and
// it is now machine-checked.
//
// WHERE n >= 5 LIVES. Not in this file. It is spent inside Lemma 10.9's conjugations, which
// need spare points, and `set_finite.aSetOfAtLeastFiveHasAFifthPoint` is what supplies them.
// A consumer discharging `everyThreeCycleIsInN` pays that cost; the composition below does not
// see it.

import permutation <<< "std/permutation.b4m"
import alternating <<< "std/permutation/alternating.b4m"
import alternating_identities <<< "std/permutation/alternating-identities.b4m"

sort Element = permutation.Element
sort Fn = permutation.Fn

func compose = permutation.compose
pred inAlternating = alternating.inAlternating
pred invertible = permutation.invertible
define isAThreeCycle = alternating.isAThreeCycle

// THEOREM 10.11. If N is a normal subgroup of A_n containing a 3-cycle, and conjugation
// reaches every 3-cycle from it, then N is all of A_n.
//
// The composition: Lemma 10.8 says every even permutation is a product of 3-cycles, and
// `aSubgroupContainingEveryThreeCycleContainsTheAlternatingGroup` turns "N has every 3-cycle"
// plus N's subgroup structure into "N has every even permutation". That is A_n contained in N;
// with N a subgroup OF A_n it is equality, which is simplicity's second alternative.
theorem aNormalSubgroupWithAThreeCycleIsTheAlternatingGroup(inN(Fn)):
  inN(permutation.identityFn) ->
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  (forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)) ->
  forall g: Fn; inAlternating(g) -> inN(g)
proof
  @given-identity |
    assume inN(permutation.identityFn) {
      @given-closure |
        assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
          @given-every-three-cycle |
            assume forall c: Fn; alternating.isAThreeCycle(c) -> inN(c) {
              @the-identity-is-in-n |
                inN(permutation.identityFn)
                [by hypothesis given-identity]
              @n-is-closed |
                forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
                [by hypothesis given-closure]
              @every-three-cycle-is-in-n |
                forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)
                [by hypothesis given-every-three-cycle]
              @conclusion-contains-the-alternating-group |
                forall g: Fn; inAlternating(g) -> inN(g)
                [using instantiation alternating.aSubgroupContainingEveryThreeCycleContainsTheAlternatingGroup((fun g: Fn => inN(g))) the-identity-is-in-n n-is-closed every-three-cycle-is-in-n]
            }
          @every-three-cycle-implies |
            (forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)) ->
              forall g: Fn; inAlternating(g) -> inN(g)
            [by discharge given-every-three-cycle]
        }
      @closure-implies |
        (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
          (forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)) ->
          forall g: Fn; inAlternating(g) -> inN(g)
        [by discharge given-closure]
    }
  @conclusion |
    inN(permutation.identityFn) ->
      (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      (forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)) ->
      forall g: Fn; inAlternating(g) -> inN(g)
    [by discharge given-identity]
qed

// The capstone exercised at N = A_n: A_n is a normal subgroup of itself containing every
// 3-cycle, so it contains every even permutation — trivially true, and the point is that the
// COMPOSITION above is kernel-checked at a real membership predicate rather than only declared.
// A consumer with a genuine proper normal subgroup instantiates the same schema at its own.
theorem theAlternatingGroupContainsItsOwnEvenPermutations:
  forall g: Fn; inAlternating(g) -> inAlternating(g)
proof
  @the-identity-is-even |
    inAlternating(permutation.identityFn)
    [by cite alternating.theIdentityIsInTheAlternatingGroup]
  @the-alternating-group-is-closed |
    forall g, h: Fn; inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @every-three-cycle-is-even |
    forall c: Fn; alternating.isAThreeCycle(c) -> inAlternating(c)
    [by cite alternating.aThreeCycleIsInTheAlternatingGroup]
  @conclusion |
    forall g: Fn; inAlternating(g) -> inAlternating(g)
    [using instantiation aNormalSubgroupWithAThreeCycleIsTheAlternatingGroup((fun g: Fn => inAlternating(g))) the-identity-is-even the-alternating-group-is-closed every-three-cycle-is-even]
qed

// THEOREM 10.11, with Lemma 10.9 DISCHARGED. The capstone above took "N contains every
// 3-cycle" as a premise; `alternating_identities.aNormalSubgroupWithAFamilyMemberHasEveryThreeCycle`
// now proves it from "N contains one member of the fixed family". So the only premise left
// about N's contents is the one Lemma 10.10 owes — that N contains a 3-cycle at all, in the
// family's own shape.
//
// WHAT REMAINS FOR AN UNCONDITIONAL THEOREM 10.11, stated precisely: a nontrivial normal
// subgroup contains SOME non-identity element; Lemma 10.10's four cases each take that
// element's three relevant points and produce a 3-cycle; what is unwritten is the walk over
// `decomposition.aNonIdentityDecompositionPeelsOffALastCycle` that selects those points and
// names which case applies. The algebra of all four cases is proved
// (`alternating-identities.b4m`), as is the point supply n >= 5 needs
// (`set_finite.aSetOfAtLeastFiveHasAFifthPoint`).
theorem aNormalSubgroupWithAFamilyMemberIsTheAlternatingGroup(inN(Fn)):
  inN(permutation.identityFn) ->
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  (exists i: Element; exists j: Element; i != j and
  (forall k: Element; k != i -> k != j ->
  inN(compose(permutation.transposition(i, k), permutation.transposition(i, j))))) ->
  forall g: Fn; inAlternating(g) -> inN(g)
proof
  @given-identity |
    assume inN(permutation.identityFn) {
      @given-closure |
        assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
          @given-the-family-at-a-pair |
            assume exists i: Element; exists j: Element; i != j and
              (forall k: Element; k != i -> k != j ->
              inN(compose(permutation.transposition(i, k), permutation.transposition(i, j)))) {
              @the-identity-is-in-n |
                inN(permutation.identityFn)
                [by hypothesis given-identity]
              @n-is-closed |
                forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
                [by hypothesis given-closure]
              @the-family-at-a-pair |
                exists i: Element; exists j: Element; i != j and
                  (forall k: Element; k != i -> k != j ->
                  inN(compose(permutation.transposition(i, k), permutation.transposition(i, j))))
                [by hypothesis given-the-family-at-a-pair]

              // Lemma 10.9: the family at ONE pair gives every 3-cycle
              @lemma-ten-nine |
                (exists i: Element; exists j: Element; i != j and
                  (forall k: Element; k != i -> k != j ->
                  inN(compose(permutation.transposition(i, k), permutation.transposition(i, j))))) ->
                  forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)
                [using instantiation alternating_identities.aNormalSubgroupWithAFamilyMemberHasEveryThreeCycle((fun g: Fn => inN(g))) n-is-closed]
              @every-three-cycle-is-in-n |
                forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)
                [by modus_ponens lemma-ten-nine the-family-at-a-pair]

              // and the capstone turns that into all of A_n
              @conclusion-contains-the-alternating-group |
                forall g: Fn; inAlternating(g) -> inN(g)
                [using instantiation aNormalSubgroupWithAThreeCycleIsTheAlternatingGroup((fun g: Fn => inN(g))) the-identity-is-in-n n-is-closed every-three-cycle-is-in-n]
            }
          @family-implies |
            (exists i: Element; exists j: Element; i != j and
              (forall k: Element; k != i -> k != j ->
              inN(compose(permutation.transposition(i, k), permutation.transposition(i, j))))) ->
              forall g: Fn; inAlternating(g) -> inN(g)
            [by discharge given-the-family-at-a-pair]
        }
      @closure-implies |
        (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
          (exists i: Element; exists j: Element; i != j and
          (forall k: Element; k != i -> k != j ->
          inN(compose(permutation.transposition(i, k), permutation.transposition(i, j))))) ->
          forall g: Fn; inAlternating(g) -> inN(g)
        [by discharge given-closure]
    }
  @conclusion |
    inN(permutation.identityFn) ->
      (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      (exists i: Element; exists j: Element; i != j and
      (forall k: Element; k != i -> k != j ->
      inN(compose(permutation.transposition(i, k), permutation.transposition(i, j))))) ->
      forall g: Fn; inAlternating(g) -> inN(g)
    [by discharge given-identity]
qed

// A family member is a 3-cycle, hence even. Needed to exercise the capstone at N = A_n.
theorem theEveryFamilyMemberIsEven: forall i, j, k: Element;
  i != j -> k != i -> k != j ->
  inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-k |
            fix k: Element {
              @given-i-not-j |
                assume i != j {
                  @given-k-not-i |
                    assume k != i {
                      @given-k-not-j |
                        assume k != j {
                          @i-is-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @k-is-not-i |
                            k != i
                            [by hypothesis given-k-not-i]
                          @k-is-not-j |
                            k != j
                            [by hypothesis given-k-not-j]
                          @i-is-not-k |
                            i != k
                            [using specialize alternating.disequalityIsSymmetric(k, i) k-is-not-i]
                          @j-is-not-k |
                            j != k
                            [using specialize alternating.disequalityIsSymmetric(k, j) k-is-not-j]
                          // the existential needs its three witnesses supplied, which
                          // `tautology` cannot invent — it reported the whole existential as
                          // one opaque false atom
                          // even the reflexive equation is an opaque atom to `tautology`, so
                          // it is proved separately and conjoined
                          @it-equals-itself |
                            compose(permutation.transposition(i, k), permutation.transposition(i, j))
                              = compose(permutation.transposition(i, k), permutation.transposition(i, j))
                            [by reflexivity]
                          @the-conjunction |
                            i != j and i != k and j != k and
                              compose(permutation.transposition(i, k), permutation.transposition(i, j))
                              = compose(permutation.transposition(i, k), permutation.transposition(i, j))
                            [using tautology i-is-not-j i-is-not-k j-is-not-k it-equals-itself]
                          @witness-z |
                            exists z: Element; i != j and i != z and j != z and
                              compose(permutation.transposition(i, k), permutation.transposition(i, j))
                              = compose(permutation.transposition(i, z), permutation.transposition(i, j))
                            [by witness(k) the-conjunction]
                          @witness-y-z |
                            exists y: Element; exists z: Element; i != y and i != z and y != z and
                              compose(permutation.transposition(i, k), permutation.transposition(i, j))
                              = compose(permutation.transposition(i, z), permutation.transposition(i, y))
                            [by witness(j) witness-z]
                          @it-is-a-three-cycle |
                            alternating.isAThreeCycle(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
                            [by witness(i) witness-y-z]
                          @three-cycles-are-even |
                            forall g: Fn; alternating.isAThreeCycle(g) -> inAlternating(g)
                            [by cite alternating.aThreeCycleIsInTheAlternatingGroup]
                          @conclusion-even |
                            inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
                            [using specialize three-cycles-are-even(compose(permutation.transposition(i, k), permutation.transposition(i, j))) it-is-a-three-cycle]
                        }
                      @knj-implies |
                        k != j -> inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
                        [by discharge given-k-not-j]
                    }
                  @kni-implies |
                    k != i -> k != j -> inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
                    [by discharge given-k-not-i]
                }
              @conclusion-at-k |
                i != j -> k != i -> k != j ->
                  inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
                [by discharge given-i-not-j]
            }
          @discharge-k |
            forall k: Element; i != j -> k != i -> k != j ->
              inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
            [by generalize generalize-k]
        }
      @discharge-j |
        forall j, k: Element; i != j -> k != i -> k != j ->
          inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, k: Element; i != j -> k != i -> k != j ->
      inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
    [by generalize generalize-i]
qed

// Exercised at N = A_n.
theorem theAlternatingGroupContainsItselfFromTheFamily:
  (exists i: Element; exists j: Element; i != j) ->
  forall g: Fn; inAlternating(g) -> inAlternating(g)
proof
  @the-identity-is-even |
    inAlternating(permutation.identityFn)
    [by cite alternating.theIdentityIsInTheAlternatingGroup]
  @the-alternating-group-is-closed |
    forall g, h: Fn; inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  // a family member IS a 3-cycle, and every 3-cycle is even
  @the-family-is-even |
    forall i2, j2, k: Element; i2 != j2 -> k != i2 -> k != j2 ->
      inAlternating(compose(permutation.transposition(i2, k), permutation.transposition(i2, j2)))
    [by cite theEveryFamilyMemberIsEven]

  // the capstone wants the family at ONE pair, packaged with that pair's distinctness, so a
  // pair has to be produced before the family can be read off at it
  @given-a-pair |
    assume exists i: Element; exists j: Element; i != j {
      @a-pair-exists |
        exists i: Element; exists j: Element; i != j
        [by hypothesis given-a-pair]
      @with-first-point |
        unpack i: Element from a-pair-exists {
          @inner-pair |
            exists j: Element; i != j
            [by hypothesis with-first-point]
          @with-second-point |
            unpack j: Element from inner-pair {
              @the-pair-is-distinct |
                i != j
                [by hypothesis with-second-point]
              @rebuild-k |
                fix k: Element {
                  @the-family-at-this-pair-and-k |
                    i != j -> k != i -> k != j ->
                      inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
                    [by apply_at(i, j, k) the-family-is-even]
                  @conclusion-at-k |
                    k != i -> k != j ->
                      inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
                    [by modus_ponens the-family-at-this-pair-and-k the-pair-is-distinct]
                }
              @the-family-at-this-pair |
                forall k: Element; k != i -> k != j ->
                  inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j)))
                [by generalize rebuild-k]
              @the-pair-with-its-family |
                i != j and
                  (forall k: Element; k != i -> k != j ->
                  inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j))))
                [by both the-pair-is-distinct the-family-at-this-pair]
              @the-family-at-a-second-point |
                exists j2: Element; i != j2 and
                  (forall k: Element; k != i -> k != j2 ->
                  inAlternating(compose(permutation.transposition(i, k), permutation.transposition(i, j2))))
                [by witness(j) the-pair-with-its-family]
              @the-family-at-a-pair |
                exists i2: Element; exists j2: Element; i2 != j2 and
                  (forall k: Element; k != i2 -> k != j2 ->
                  inAlternating(compose(permutation.transposition(i2, k), permutation.transposition(i2, j2))))
                [by witness(i) the-family-at-a-second-point]
              @the-capstone |
                (exists i2: Element; exists j2: Element; i2 != j2 and
                  (forall k: Element; k != i2 -> k != j2 ->
                  inAlternating(compose(permutation.transposition(i2, k), permutation.transposition(i2, j2))))) ->
                  forall g: Fn; inAlternating(g) -> inAlternating(g)
                [using instantiation aNormalSubgroupWithAFamilyMemberIsTheAlternatingGroup((fun g: Fn => inAlternating(g))) the-identity-is-even the-alternating-group-is-closed]
              @conclusion-at-the-pair |
                forall g: Fn; inAlternating(g) -> inAlternating(g)
                [by modus_ponens the-capstone the-family-at-a-pair]
            }
          @conclusion-second |
            forall g: Fn; inAlternating(g) -> inAlternating(g)
            [by unpacked with-second-point]
        }
      @conclusion-first |
        forall g: Fn; inAlternating(g) -> inAlternating(g)
        [by unpacked with-first-point]
    }
  @conclusion |
    (exists i: Element; exists j: Element; i != j) ->
      forall g: Fn; inAlternating(g) -> inAlternating(g)
    [by discharge given-a-pair]
qed

// THEOREM 10.11, FROM ONE 3-CYCLE. Lemma 10.9 is now fully discharged: the premise is Judson's
// own hypothesis for that lemma — "N contains a 3-cycle" — rather than the family it generates.
//
// The 3-cycle is given in std's fold, `T(i,a) o T(i,j)`, with its three points existentially
// bound, so no relabelling is needed: whatever 3-cycle N contains supplies i, j and a itself.
//
// WHERE n >= 5 LIVES, precisely. In the spare-point premise: for any four points there is a
// fifth. A consumer discharges it from `set_finite.aSetOfAtLeastFiveHasAFifthPoint` at the
// point universe, which is the only place the chapter's size hypothesis is spent.
//
// WHAT IS STILL ASSUMED. Only Lemma 10.10's conclusion — that a nontrivial N contains a
// 3-cycle at all. Its four cases are proved as length-free theorems in
// `alternating-identities.b4m`; what is unwritten is the walk over a non-identity element's
// disjoint-cycle decomposition that selects which case applies.
theorem aNormalSubgroupWithAThreeCycleAndNormalityIsTheAlternatingGroup(inN(Fn)):
  inN(permutation.identityFn) ->
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  (forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
  inN(compose(compose(sigma, g), permutation.inverse(sigma)))) ->
  (forall p, q, r, s: Element;
  exists t: Element; t != p and t != q and t != r and t != s) ->
  (exists i: Element; exists j: Element; exists a: Element;
  i != j and a != i and a != j and
  inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
  forall g: Fn; inAlternating(g) -> inN(g)
proof
  @given-identity |
    assume inN(permutation.identityFn) {
      @given-closure |
        assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
          @given-normality |
            assume forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
              inN(compose(compose(sigma, g), permutation.inverse(sigma))) {
              @given-a-spare-point |
                assume forall p, q, r, s: Element;
                  exists t: Element; t != p and t != q and t != r and t != s {
                  @given-a-three-cycle |
                    assume exists i: Element; exists j: Element; exists a: Element;
                      i != j and a != i and a != j and
                      inN(compose(permutation.transposition(i, a), permutation.transposition(i, j))) {
                      @the-identity-is-in-n |
                        inN(permutation.identityFn)
                        [by hypothesis given-identity]
                      @n-is-closed |
                        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
                        [by hypothesis given-closure]
                      @n-is-normal |
                        forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
                          inN(compose(compose(sigma, g), permutation.inverse(sigma)))
                        [by hypothesis given-normality]
                      @the-spare-point-supply |
                        forall p, q, r, s: Element;
                          exists t: Element; t != p and t != q and t != r and t != s
                        [by hypothesis given-a-spare-point]
                      @the-three-cycle-is-in-n |
                        exists i: Element; exists j: Element; exists a: Element;
                          i != j and a != i and a != j and
                          inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))
                        [by hypothesis given-a-three-cycle]

                      // Lemma 10.9 from one 3-cycle
                      @lemma-ten-nine |
                        (forall p, q, r, s: Element;
                          exists t: Element; t != p and t != q and t != r and t != s) ->
                          (exists i: Element; exists j: Element; exists a: Element;
                          i != j and a != i and a != j and
                          inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
                          forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)
                        [using instantiation alternating_identities.aNormalSubgroupWithOneThreeCycleHasEveryThreeCycle((fun g: Fn => inN(g))) n-is-closed n-is-normal]
                      @every-three-cycle-given-a-three-cycle |
                        (exists i: Element; exists j: Element; exists a: Element;
                          i != j and a != i and a != j and
                          inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
                          forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)
                        [by modus_ponens lemma-ten-nine the-spare-point-supply]
                      @every-three-cycle-is-in-n |
                        forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)
                        [by modus_ponens every-three-cycle-given-a-three-cycle the-three-cycle-is-in-n]

                      // and the capstone turns that into all of A_n
                      @conclusion-contains-the-alternating-group |
                        forall g: Fn; inAlternating(g) -> inN(g)
                        [using instantiation aNormalSubgroupWithAThreeCycleIsTheAlternatingGroup((fun g: Fn => inN(g))) the-identity-is-in-n n-is-closed every-three-cycle-is-in-n]
                    }
                  @three-cycle-implies |
                    (exists i: Element; exists j: Element; exists a: Element;
                      i != j and a != i and a != j and
                      inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
                      forall g: Fn; inAlternating(g) -> inN(g)
                    [by discharge given-a-three-cycle]
                }
              @spare-point-implies |
                (forall p, q, r, s: Element;
                  exists t: Element; t != p and t != q and t != r and t != s) ->
                  (exists i: Element; exists j: Element; exists a: Element;
                  i != j and a != i and a != j and
                  inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
                  forall g: Fn; inAlternating(g) -> inN(g)
                [by discharge given-a-spare-point]
            }
          @normality-implies |
            (forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
              inN(compose(compose(sigma, g), permutation.inverse(sigma)))) ->
              (forall p, q, r, s: Element;
              exists t: Element; t != p and t != q and t != r and t != s) ->
              (exists i: Element; exists j: Element; exists a: Element;
              i != j and a != i and a != j and
              inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
              forall g: Fn; inAlternating(g) -> inN(g)
            [by discharge given-normality]
        }
      @closure-implies |
        (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
          (forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
          inN(compose(compose(sigma, g), permutation.inverse(sigma)))) ->
          (forall p, q, r, s: Element;
          exists t: Element; t != p and t != q and t != r and t != s) ->
          (exists i: Element; exists j: Element; exists a: Element;
          i != j and a != i and a != j and
          inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
          forall g: Fn; inAlternating(g) -> inN(g)
        [by discharge given-closure]
    }
  @conclusion |
    inN(permutation.identityFn) ->
      (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      (forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
      inN(compose(compose(sigma, g), permutation.inverse(sigma)))) ->
      (forall p, q, r, s: Element;
      exists t: Element; t != p and t != q and t != r and t != s) ->
      (exists i: Element; exists j: Element; exists a: Element;
      i != j and a != i and a != j and
      inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
      forall g: Fn; inAlternating(g) -> inN(g)
    [by discharge given-identity]
qed

// Exercised at N = A_n.
theorem theAlternatingGroupContainsItselfFromOneThreeCycle:
  (forall p, q, r, s: Element;
  exists t: Element; t != p and t != q and t != r and t != s) ->
  (exists i: Element; exists j: Element; exists a: Element;
  i != j and a != i and a != j and
  inAlternating(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
  forall g: Fn; inAlternating(g) -> inAlternating(g)
proof
  @the-identity-is-even |
    inAlternating(permutation.identityFn)
    [by cite alternating.theIdentityIsInTheAlternatingGroup]
  @the-alternating-group-is-closed |
    forall g, h: Fn; inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @the-alternating-group-is-normal-in-itself |
    forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inAlternating(g) ->
      inAlternating(compose(compose(sigma, g), permutation.inverse(sigma)))
    [by cite alternating.theAlternatingGroupIsClosedUnderConjugation]
  @conclusion |
    (forall p, q, r, s: Element;
      exists t: Element; t != p and t != q and t != r and t != s) ->
      (exists i: Element; exists j: Element; exists a: Element;
      i != j and a != i and a != j and
      inAlternating(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
      forall g: Fn; inAlternating(g) -> inAlternating(g)
    [using instantiation aNormalSubgroupWithAThreeCycleAndNormalityIsTheAlternatingGroup((fun g: Fn => inAlternating(g))) the-identity-is-even the-alternating-group-is-closed the-alternating-group-is-normal-in-itself]
qed

// THEOREM 10.11. The alternating group A_n is simple for n >= 5.
//
// Judson's proof is three sentences: "Let N be a normal subgroup of A_n. By Lemma 10.10, N
// contains a 3-cycle. By Lemma 10.9, N = A_n; therefore A_n contains no proper nontrivial
// normal subgroups for n >= 5." This is that composition, with both lemmas now proved.
//
// WHAT N MUST SUPPLY: the subgroup structure (identity, products, inverses) and normality.
// WHAT n >= 5 SUPPLIES: a fifth point for any four. One hypothesis, spent inside Lemma 10.9's
//   conjugations; `set_finite.aSetOfAtLeastFiveHasAFifthPoint` discharges it at a point
//   universe of size at least five.
// WHAT REMAINS JUDSON'S OWN ASSERTION: that the five cycle structures exhaust the
//   possibilities for a non-identity sigma. His text states the list and does not argue it.
//
// Everything else — all four conjugation identities, the five landings, Lemma 10.9's
// reachability and its thirteen-leaf selector, Lemma 10.8's generation by 3-cycles — is
// machine-checked from the kernel.
theorem theAlternatingGroupIsSimple(inN(Fn)):
  inN(permutation.identityFn) ->
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  (forall g: Fn; inN(g) -> inN(permutation.inverse(g))) ->
  (forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
  inN(compose(compose(sigma, g), permutation.inverse(sigma)))) ->
  (forall p, q, r, s: Element;
  exists t: Element; t != p and t != q and t != r and t != s) ->
  (exists sigma: Fn; invertible(sigma) and inN(sigma) and
  (alternating.isAThreeCycle(sigma)
  or alternating_identities.judsonsLongCycleShape(sigma)
  or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
  or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
  or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))) ->
  forall g: Fn; inAlternating(g) -> inN(g)
proof
  @given-identity |
    assume inN(permutation.identityFn) {
      @given-closure |
        assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
          @given-inverses |
            assume forall g: Fn; inN(g) -> inN(permutation.inverse(g)) {
              @given-normality |
                assume forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
                  inN(compose(compose(sigma, g), permutation.inverse(sigma))) {
                  @given-a-spare-point |
                    assume forall p, q, r, s: Element;
                      exists t: Element; t != p and t != q and t != r and t != s {
                      @given-a-shaped-element |
                        assume exists sigma: Fn; invertible(sigma) and inN(sigma) and
                          (alternating.isAThreeCycle(sigma)
                          or alternating_identities.judsonsLongCycleShape(sigma)
                          or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
                          or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
                          or alternating_identities.judsonsDisjointTwoCyclesShape(sigma)) {
                          @the-identity-is-in-n |
                            inN(permutation.identityFn)
                            [by hypothesis given-identity]
                          @n-is-closed |
                            forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
                            [by hypothesis given-closure]
                          @n-is-closed-under-inverses |
                            forall g: Fn; inN(g) -> inN(permutation.inverse(g))
                            [by hypothesis given-inverses]
                          @n-is-normal |
                            forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
                              inN(compose(compose(sigma, g), permutation.inverse(sigma)))
                            [by hypothesis given-normality]
                          @the-spare-point-supply |
                            forall p, q, r, s: Element;
                              exists t: Element; t != p and t != q and t != r and t != s
                            [by hypothesis given-a-spare-point]
                          @a-shaped-element-exists |
                            exists sigma: Fn; invertible(sigma) and inN(sigma) and
                              (alternating.isAThreeCycle(sigma)
                              or alternating_identities.judsonsLongCycleShape(sigma)
                              or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
                              or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
                              or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))
                            [by hypothesis given-a-shaped-element]

                          // every 3-cycle on distinct points is even — the premise both
                          // lemmas' conjugations spend
                          @three-cycles-are-even |
                            forall i2: Element; forall j2: Element; forall k2: Element;
                              i2 != j2 -> i2 != k2 -> j2 != k2 ->
                              inAlternating(compose(permutation.transposition(i2, k2), permutation.transposition(i2, j2)))
                            [by cite alternating_identities.aThreeCycleOnDistinctPointsIsEven]

                          // LEMMA 10.10: the shaped element gives a 3-cycle in N
                          @lemma-ten-ten |
                            forall sigma: Fn;
                              invertible(sigma) -> inN(sigma) ->
                              (alternating.isAThreeCycle(sigma)
                              or alternating_identities.judsonsLongCycleShape(sigma)
                              or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
                              or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
                              or alternating_identities.judsonsDisjointTwoCyclesShape(sigma)) ->
                              (exists i: Element; exists j: Element; exists a: Element;
                              i != j and a != i and a != j and
                              inN(compose(permutation.transposition(i, a), permutation.transposition(i, j))))
                            [using instantiation alternating_identities.judsonsLemmaTenTen((fun g2: Fn => inN(g2))) n-is-normal n-is-closed-under-inverses n-is-closed three-cycles-are-even]

                          @with-the-element |
                            unpack sigma: Fn from a-shaped-element-exists {
                              @the-elements-data |
                                invertible(sigma) and inN(sigma) and
                                  (alternating.isAThreeCycle(sigma)
                                  or alternating_identities.judsonsLongCycleShape(sigma)
                                  or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
                                  or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
                                  or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))
                                [by hypothesis with-the-element]
                              @the-element-is-invertible |
                                invertible(sigma)
                                [using tautology the-elements-data]
                              @the-element-is-in-n |
                                inN(sigma)
                                [using tautology the-elements-data]
                              @the-elements-shape |
                                alternating.isAThreeCycle(sigma)
                                  or alternating_identities.judsonsLongCycleShape(sigma)
                                  or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
                                  or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
                                  or alternating_identities.judsonsDisjointTwoCyclesShape(sigma)
                                [using tautology the-elements-data]
                              @a-three-cycle-is-in-n |
                                exists i: Element; exists j: Element; exists a: Element;
                                  i != j and a != i and a != j and
                                  inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))
                                [using specialize lemma-ten-ten(sigma) the-element-is-invertible the-element-is-in-n the-elements-shape]

                              // THEOREM 10.11: that 3-cycle gives all of A_n
                              @the-capstone |
                                inN(permutation.identityFn) ->
                                  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
                                  (forall sigma2: Fn; forall g: Fn; inAlternating(sigma2) -> inN(g) ->
                                  inN(compose(compose(sigma2, g), permutation.inverse(sigma2)))) ->
                                  (forall p, q, r, s: Element;
                                  exists t: Element; t != p and t != q and t != r and t != s) ->
                                  (exists i: Element; exists j: Element; exists a: Element;
                                  i != j and a != i and a != j and
                                  inN(compose(permutation.transposition(i, a), permutation.transposition(i, j)))) ->
                                  forall g: Fn; inAlternating(g) -> inN(g)
                                [using instantiation aNormalSubgroupWithAThreeCycleAndNormalityIsTheAlternatingGroup((fun g2: Fn => inN(g2)))]
                              @conclusion-n-is-the-alternating-group |
                                forall g: Fn; inAlternating(g) -> inN(g)
                                [using specialize the-capstone the-identity-is-in-n n-is-closed n-is-normal the-spare-point-supply a-three-cycle-is-in-n]
                            }
                          @conclusion-unpacked |
                            forall g: Fn; inAlternating(g) -> inN(g)
                            [by unpacked with-the-element]
                        }
                      @shaped-element-implies |
                        (exists sigma: Fn; invertible(sigma) and inN(sigma) and
                          (alternating.isAThreeCycle(sigma)
                          or alternating_identities.judsonsLongCycleShape(sigma)
                          or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
                          or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
                          or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))) ->
                          forall g: Fn; inAlternating(g) -> inN(g)
                        [by discharge given-a-shaped-element]
                    }
                  @spare-point-implies |
                    (forall p, q, r, s: Element;
                      exists t: Element; t != p and t != q and t != r and t != s) ->
                      (exists sigma: Fn; invertible(sigma) and inN(sigma) and
                      (alternating.isAThreeCycle(sigma)
                      or alternating_identities.judsonsLongCycleShape(sigma)
                      or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
                      or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
                      or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))) ->
                      forall g: Fn; inAlternating(g) -> inN(g)
                    [by discharge given-a-spare-point]
                }
              @normality-implies |
                (forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
                  inN(compose(compose(sigma, g), permutation.inverse(sigma)))) ->
                  (forall p, q, r, s: Element;
                  exists t: Element; t != p and t != q and t != r and t != s) ->
                  (exists sigma: Fn; invertible(sigma) and inN(sigma) and
                  (alternating.isAThreeCycle(sigma)
                  or alternating_identities.judsonsLongCycleShape(sigma)
                  or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
                  or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
                  or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))) ->
                  forall g: Fn; inAlternating(g) -> inN(g)
                [by discharge given-normality]
            }
          @inverses-implies |
            (forall g: Fn; inN(g) -> inN(permutation.inverse(g))) ->
              (forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
              inN(compose(compose(sigma, g), permutation.inverse(sigma)))) ->
              (forall p, q, r, s: Element;
              exists t: Element; t != p and t != q and t != r and t != s) ->
              (exists sigma: Fn; invertible(sigma) and inN(sigma) and
              (alternating.isAThreeCycle(sigma)
              or alternating_identities.judsonsLongCycleShape(sigma)
              or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
              or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
              or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))) ->
              forall g: Fn; inAlternating(g) -> inN(g)
            [by discharge given-inverses]
        }
      @closure-implies |
        (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
          (forall g: Fn; inN(g) -> inN(permutation.inverse(g))) ->
          (forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
          inN(compose(compose(sigma, g), permutation.inverse(sigma)))) ->
          (forall p, q, r, s: Element;
          exists t: Element; t != p and t != q and t != r and t != s) ->
          (exists sigma: Fn; invertible(sigma) and inN(sigma) and
          (alternating.isAThreeCycle(sigma)
          or alternating_identities.judsonsLongCycleShape(sigma)
          or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
          or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
          or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))) ->
          forall g: Fn; inAlternating(g) -> inN(g)
        [by discharge given-closure]
    }
  @conclusion |
    inN(permutation.identityFn) ->
      (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      (forall g: Fn; inN(g) -> inN(permutation.inverse(g))) ->
      (forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inN(g) ->
      inN(compose(compose(sigma, g), permutation.inverse(sigma)))) ->
      (forall p, q, r, s: Element;
      exists t: Element; t != p and t != q and t != r and t != s) ->
      (exists sigma: Fn; invertible(sigma) and inN(sigma) and
      (alternating.isAThreeCycle(sigma)
      or alternating_identities.judsonsLongCycleShape(sigma)
      or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
      or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
      or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))) ->
      forall g: Fn; inAlternating(g) -> inN(g)
    [by discharge given-identity]
qed

// THEOREM 10.11 exercised at N = A_n: A_n is a normal subgroup of itself, and a non-identity
// even permutation of a known shape puts every even permutation in it — trivially true at
// N = A_n, and the point is that the whole composition is kernel-checked at a real membership
// predicate. A consumer with a genuine proper normal subgroup instantiates the same schema.
theorem theAlternatingGroupIsSimpleAtItself:
  (forall p, q, r, s: Element;
  exists t: Element; t != p and t != q and t != r and t != s) ->
  (exists sigma: Fn; invertible(sigma) and inAlternating(sigma) and
  (alternating.isAThreeCycle(sigma)
  or alternating_identities.judsonsLongCycleShape(sigma)
  or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
  or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
  or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))) ->
  forall g: Fn; inAlternating(g) -> inAlternating(g)
proof
  @the-identity-is-even |
    inAlternating(permutation.identityFn)
    [by cite alternating.theIdentityIsInTheAlternatingGroup]
  @the-alternating-group-is-closed |
    forall g, h: Fn; inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @the-alternating-group-has-inverses |
    forall g: Fn; inAlternating(g) -> inAlternating(permutation.inverse(g))
    [by cite alternating.theAlternatingGroupIsClosedUnderInverses]
  @the-alternating-group-is-normal-in-itself |
    forall sigma: Fn; forall g: Fn; inAlternating(sigma) -> inAlternating(g) ->
      inAlternating(compose(compose(sigma, g), permutation.inverse(sigma)))
    [by cite alternating.theAlternatingGroupIsClosedUnderConjugation]
  @conclusion |
    (forall p, q, r, s: Element;
      exists t: Element; t != p and t != q and t != r and t != s) ->
      (exists sigma: Fn; invertible(sigma) and inAlternating(sigma) and
      (alternating.isAThreeCycle(sigma)
      or alternating_identities.judsonsLongCycleShape(sigma)
      or alternating_identities.judsonsTwoThreeCyclesShape(sigma)
      or alternating_identities.judsonsInvolutionTimesAThreeCycleShape(sigma)
      or alternating_identities.judsonsDisjointTwoCyclesShape(sigma))) ->
      forall g: Fn; inAlternating(g) -> inAlternating(g)
    [using instantiation theAlternatingGroupIsSimple((fun g2: Fn => inAlternating(g2))) the-identity-is-even the-alternating-group-is-closed the-alternating-group-has-inverses the-alternating-group-is-normal-in-itself]
qed
