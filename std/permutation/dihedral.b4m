// std/permutation/dihedral.b4m — THE DIHEDRAL GROUP D_n of the regular n-gon, and |D_n| = 2n.
//
// The n-gon's vertices are the letters {0, …, n-1} (numerals in the segment). A RIGID MOTION
// is a permutation of the n letters that preserves ADJACENCY: vertex i is adjacent to vertex
// i+1, and vertex n-1 to vertex 0. Judson's count (AATA §5.2): a motion sends vertex 0 to some
// vertex k (n choices) and then vertex 1 to a neighbour of k (2 choices), and everything else
// is forced — so 2n motions: the n rotations ρ^k and the n reflections ρ^k ∘ σ.
//
// ρ is the n-cycle (0 1 … n-1) — std/permutation/cycle.b4m's cycle on the list of numerals
// — and σ the reflection fixing 0 (i ↦ n - i). Both are characterized by their values on the
// letters; the file carries them as any ρ, σ satisfying `isTheRotation` / `isTheReflection`.

import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import peano_subtraction <<< "std/peano/subtraction.b4m"
import element <<< "std/element.b4m"
import set <<< "std/set.b4m"
import set_finite <<< "std/set/finite.b4m"
import function <<< "std/function.b4m"
import function_invertible <<< "std/function/invertible.b4m"
import function_iterate <<< "std/function/iterate.b4m"
import permutation <<< "std/permutation.b4m"
import permutation_sequence <<< "std/permutation/sequence.b4m"
import permutation_count <<< "std/permutation/count.b4m"
import cycle_theory <<< "std/permutation/cycle.b4m"

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
func sub = peano.sub
pred less_than = peano.less_than
axiom induction = peano.induction
axiom succNotZero = peano.succNotZero
axiom succInjective = peano.succInjective
axiom addZeroLeft = peano.addZeroLeft
axiom addSuccLeft = peano.addSuccLeft
theorem addZeroRight = peano.addZeroRight
theorem addSuccRight = peano.addSuccRight
theorem zeroOrSucc = peano.zeroOrSucc
axiom lessThanIntro = peano_order.lessThanIntro
axiom lessThanElim = peano_order.lessThanElim
theorem notLessThanZero = peano_order.notLessThanZero
theorem lessThanSelf = peano_order.lessThanSelf
theorem lessThanSuccRight = peano_order.lessThanSuccRight
theorem lessThanSuccSplit = peano_order.lessThanSuccSplit
theorem lessThanIrreflexive = peano_order.lessThanIrreflexive
theorem lessThanTransitive = peano_order.lessThanTransitive
theorem succReflectsOrder = peano_order.succReflectsOrder
theorem succPreservesOrder = peano_order.succPreservesOrder
theorem addIsCommutative = peano.addIsCommutative
theorem subAddCancel = peano_subtraction.subAddCancel
theorem subStrictlyDecreases = peano_subtraction.subStrictlyDecreases
axiom subSuccSucc = peano_subtraction.subSuccSucc
axiom subZeroRight = peano_subtraction.subZeroRight
theorem zeroBelowSucc = cycle_theory.zeroBelowSucc
axiom invertibleDef = function.invertibleDef
axiom functionFromGraph = function.functionFromGraph

sort Element = element.Element
sort Set = set.Set
pred member = set.member

sort Fn = function.Fn
const identityFn = function.identityFn
func apply = function.apply
func compose = function.compose
pred invertible = function.invertible
func inverse = function.inverse
axiom composeApply = function.composeApply
axiom identityApply = function.identityApply
axiom funcExtensionality = function.funcExtensionality
theorem composeAssoc = function_invertible.composeAssoc
theorem composeIdentityLeft = function_invertible.composeIdentityLeft
theorem composeIdentityRight = function_invertible.composeIdentityRight
theorem identityIsAPermutation = permutation.identityIsAPermutation
theorem composeIsAPermutation = permutation.composeIsAPermutation
theorem permutationIsInjective = permutation.permutationIsInjective
theorem inverseUndoesPermutation = permutation.inverseUndoesPermutation
theorem permutationUndoesInverse = permutation.permutationUndoesInverse
theorem identityPermutes = permutation.identityPermutes
func iterate = function_iterate.iterate
axiom iterateZero = function_iterate.iterateZero
axiom iterateSucc = function_iterate.iterateSucc

func numeral = set_finite.numeral
func segment = set_finite.segment
axiom numeralInjective = set_finite.numeralInjective
axiom segmentMember = set_finite.segmentMember
theorem numeralInSegment = set_finite.numeralInSegment

sort Points = cycle_theory.Points
func pointAt = cycle_theory.at
axiom pointsSingleton = cycle_theory.pointsSingleton
axiom pointsPrepend = cycle_theory.pointsPrepend
func cycle = cycle_theory.cycle
theorem cycleIsAPermutation = cycle_theory.cycleIsAPermutation
theorem cycleAdvances = cycle_theory.cycleAdvances
theorem cycleWrapsAround = cycle_theory.cycleWrapsAround
theorem cycleFixesTheUnlisted = cycle_theory.cycleFixesTheUnlisted

sort Seq = permutation_sequence.Seq
func at = permutation_sequence.at
axiom seqSingleton = permutation_sequence.seqSingleton
axiom atIsAPermutation = permutation_sequence.atIsAPermutation
axiom seqConcat = permutation_sequence.seqConcat

define permutes(f, a) = permutation.permutes(f, a)
define distinct(s, n) = cycle_theory.distinct(s, n)
define avoids(x, s, n) = cycle_theory.avoids(x, s, n)
define permutesTheSegment(t, n) = permutation_count.permutesTheSegment(t, n)
theorem composingPermutationsOfTheSegment = permutation_count.composingPermutationsOfTheSegment
theorem indexSplits = permutation_count.indexSplits
theorem belowTheBaseIsBelowTheSum = permutation_count.belowTheBaseIsBelowTheSum
theorem additionPreservesOrder = peano_order.additionPreservesOrder

// -- arithmetic helpers ----------------------------------------------------------------------

// Below n means the successor is below n or is n.
theorem successorBelowOrIs: forall i: Nat; forall n: Nat;
  less_than(i, n) -> (less_than(succ(i), n) or succ(i) = n)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-n |
        fix n: Nat {
          @given-below |
            assume less_than(i, n) {
              @below |
                less_than(i, n)
                [by hypothesis given-below]
              @gap-exists |
                exists d: Nat; add(i, succ(d)) = n
                [using specialize lessThanElim(i, n) below]
              @with-gap-d |
                unpack d: Nat from gap-exists {
                  @gap |
                    add(i, succ(d)) = n
                    [by hypothesis with-gap-d]
                  @d-zero-or-succ |
                    d = ZERO or (exists d2: Nat; d = succ(d2))
                    [using specialize zeroOrSucc(d)]
                  @conclusion-split |
                    less_than(succ(i), n) or succ(i) = n
                    case d-zero-or-succ {
                      @when-d-zero |
                        assume d = ZERO {
                          @d-is-zero |
                            d = ZERO
                            [by hypothesis when-d-zero]
                          @gap-at-zero |
                            add(i, succ(ZERO)) = n
                            [by rewrite d-is-zero gap]
                          @succ-pulls-out |
                            add(i, succ(ZERO)) = succ(add(i, ZERO))
                            [using specialize addSuccRight(i, ZERO)]
                          @i-plus-zero |
                            add(i, ZERO) = i
                            [using specialize addZeroRight(i)]
                          @succ-i-is-the-sum |
                            add(i, succ(ZERO)) = succ(i)
                            [by rewrite i-plus-zero succ-pulls-out]
                          @succ-i-is-n |
                            succ(i) = n
                            [by rewrite succ-i-is-the-sum gap-at-zero]
                          @conclusion-when-zero |
                            less_than(succ(i), n) or succ(i) = n
                            [by or_intro_right succ-i-is-n]
                        }
                      @when-d-succ |
                        assume exists d2: Nat; d = succ(d2) {
                          @predecessor-exists |
                            exists d2: Nat; d = succ(d2)
                            [by hypothesis when-d-succ]
                          @with-predecessor-d2 |
                            unpack d2: Nat from predecessor-exists {
                              @d-is-succ |
                                d = succ(d2)
                                [by hypothesis with-predecessor-d2]
                              @gap-at-succ |
                                add(i, succ(succ(d2))) = n
                                [by rewrite d-is-succ gap]
                              @succ-pulls-out |
                                add(i, succ(succ(d2))) = succ(add(i, succ(d2)))
                                [using specialize addSuccRight(i, succ(d2))]
                              @succ-pushes-in |
                                add(succ(i), succ(d2)) = succ(add(i, succ(d2)))
                                [using specialize addSuccLeft(i, succ(d2))]
                              @gap-from-succ-i |
                                add(succ(i), succ(d2)) = add(i, succ(succ(d2)))
                                [by rewrite succ-pulls-out succ-pushes-in]
                              @gap-from-succ-i-is-n |
                                add(succ(i), succ(d2)) = n
                                [using chain gap-from-succ-i gap-at-succ]
                              @succ-i-below-n |
                                less_than(succ(i), n)
                                [using specialize lessThanIntro(succ(i), d2, n) gap-from-succ-i-is-n]
                              @conclusion-when-succ-at-d2 |
                                less_than(succ(i), n) or succ(i) = n
                                [by or_intro_left succ-i-below-n]
                            }
                          @conclusion-when-succ |
                            less_than(succ(i), n) or succ(i) = n
                            [by exists_elim with-predecessor-d2]
                        }
                    }
                }
              @conclusion-split-at-d |
                less_than(succ(i), n) or succ(i) = n
                [by exists_elim with-gap-d]
            }
          @conclusion-at-n |
            less_than(i, n) -> (less_than(succ(i), n) or succ(i) = n)
            [by implies_intro given-below]
        }
      @discharge-n |
        forall n: Nat; less_than(i, n) -> (less_than(succ(i), n) or succ(i) = n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall i: Nat; forall n: Nat; less_than(i, n) -> (less_than(succ(i), n) or succ(i) = n)
    [by forall_intro generalize-i]
qed

// A number with something below it is a successor.
theorem positiveIsASuccessor: forall i: Nat; forall n: Nat; less_than(i, n) -> exists m: Nat; n = succ(m)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-n |
        fix n: Nat {
          @given-below |
            assume less_than(i, n) {
              @below |
                less_than(i, n)
                [by hypothesis given-below]
              @n-zero-or-succ |
                n = ZERO or (exists m: Nat; n = succ(m))
                [using specialize zeroOrSucc(n)]
              @nothing-below-zero |
                not less_than(i, ZERO)
                [using specialize notLessThanZero(i)]
              @conclusion-successor |
                exists m: Nat; n = succ(m)
                case n-zero-or-succ {
                  @when-zero |
                    assume n = ZERO {
                      @n-is-zero |
                        n = ZERO
                        [by hypothesis when-zero]
                      @below-zero |
                        less_than(i, ZERO)
                        [by rewrite n-is-zero below]
                      @conclusion-when-zero |
                        exists m: Nat; n = succ(m)
                        [by absurd below-zero nothing-below-zero]
                    }
                  @when-succ |
                    assume exists m: Nat; n = succ(m) {
                      @conclusion-when-succ |
                        exists m: Nat; n = succ(m)
                        [by hypothesis when-succ]
                    }
                }
            }
          @conclusion-at-n |
            less_than(i, n) -> exists m: Nat; n = succ(m)
            [by implies_intro given-below]
        }
      @discharge-n |
        forall n: Nat; less_than(i, n) -> exists m: Nat; n = succ(m)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall i: Nat; forall n: Nat; less_than(i, n) -> exists m: Nat; n = succ(m)
    [by forall_intro generalize-i]
qed

// -- the list of letters ----------------------------------------------------------------------

// A list whose i-th entry is the letter b + i, for i below n: induction on n with the base
// letter quantified inside — prepend the letter b to the list starting at b + 1.
theorem letterListExists: forall n: Nat; forall b: Nat;
  exists s: Points; forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(add(b, i))
proof
  @base-case-proof |
    fix b: Nat {
      @singleton-exists |
        exists s: Points; pointAt(s, ZERO) = numeral(b)
        [using specialize pointsSingleton(numeral(b))]
      @with-singleton-s |
        unpack s: Points from singleton-exists {
          @vacuous |
            fix i: Nat {
              @nothing-below-zero |
                not less_than(i, ZERO)
                [using specialize notLessThanZero(i)]
              @conclusion-vacuous-entry |
                less_than(i, ZERO) -> pointAt(s, i) = numeral(add(b, i))
                [using tautology nothing-below-zero]
            }
          @no-entries |
            forall i: Nat; less_than(i, ZERO) -> pointAt(s, i) = numeral(add(b, i))
            [by forall_intro vacuous]
          @conclusion-witness-s |
            exists s2: Points; forall i: Nat; less_than(i, ZERO) -> pointAt(s2, i) = numeral(add(b, i))
            [by exists_intro(s) no-entries]
        }
      @conclusion-base-at-b |
        exists s2: Points; forall i: Nat; less_than(i, ZERO) -> pointAt(s2, i) = numeral(add(b, i))
        [by exists_elim with-singleton-s]
    }
  @base-case |
    forall b: Nat; exists s2: Points; forall i: Nat; less_than(i, ZERO) -> pointAt(s2, i) = numeral(add(b, i))
    [by forall_intro base-case-proof]
  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume forall b: Nat; exists s2: Points; forall i: Nat; less_than(i, k) -> pointAt(s2, i) = numeral(add(b, i)) {
          @inductive-hypothesis |
            forall b: Nat; exists s2: Points; forall i: Nat; less_than(i, k) -> pointAt(s2, i) = numeral(add(b, i))
            [by hypothesis given-inductive-hypothesis]
          @generalize-b |
            fix b: Nat {
              @tail-exists |
                exists s2: Points; forall i: Nat; less_than(i, k) -> pointAt(s2, i) = numeral(add(succ(b), i))
                [using specialize inductive-hypothesis(succ(b))]
              @with-tail-s |
                unpack s: Points from tail-exists {
                  @tail-entries |
                    forall i: Nat; less_than(i, k) -> pointAt(s, i) = numeral(add(succ(b), i))
                    [by hypothesis with-tail-s]
                  @prepended-exists |
                    exists u: Points; pointAt(u, ZERO) = numeral(b) and (forall i: Nat; pointAt(u, succ(i)) = pointAt(s, i))
                    [using specialize pointsPrepend(numeral(b), s)]
                  @with-prepended-u |
                    unpack u: Points from prepended-exists {
                      @prepended-facts |
                        pointAt(u, ZERO) = numeral(b) and (forall i: Nat; pointAt(u, succ(i)) = pointAt(s, i))
                        [by hypothesis with-prepended-u]
                      @head |
                        pointAt(u, ZERO) = numeral(b)
                        [by and_elim_left prepended-facts]
                      @tail |
                        forall i: Nat; pointAt(u, succ(i)) = pointAt(s, i)
                        [by and_elim_right prepended-facts]
                      @generalize-i |
                        fix i: Nat {
                          @given-i-in-range |
                            assume less_than(i, succ(k)) {
                              @i-in-range |
                                less_than(i, succ(k))
                                [by hypothesis given-i-in-range]
                              @i-zero-or-succ |
                                i = ZERO or (exists i2: Nat; i = succ(i2))
                                [using specialize zeroOrSucc(i)]
                              @conclusion-entry |
                                pointAt(u, i) = numeral(add(b, i))
                                case i-zero-or-succ {
                                  @when-zero |
                                    assume i = ZERO {
                                      @i-is-zero |
                                        i = ZERO
                                        [by hypothesis when-zero]
                                      @b-plus-zero |
                                        add(b, ZERO) = b
                                        [using specialize addZeroRight(b)]
                                      @head-as-a-sum |
                                        pointAt(u, ZERO) = numeral(add(b, ZERO))
                                        [by rewrite b-plus-zero head]
                                      @conclusion-head-entry |
                                        pointAt(u, i) = numeral(add(b, i))
                                        [by rewrite i-is-zero head-as-a-sum]
                                    }
                                  @when-succ |
                                    assume exists i2: Nat; i = succ(i2) {
                                      @predecessor-exists |
                                        exists i2: Nat; i = succ(i2)
                                        [by hypothesis when-succ]
                                      @with-predecessor-i2 |
                                        unpack i2: Nat from predecessor-exists {
                                          @i-is-succ |
                                            i = succ(i2)
                                            [by hypothesis with-predecessor-i2]
                                          @succ-i2-in-range |
                                            less_than(succ(i2), succ(k))
                                            [by rewrite i-is-succ i-in-range]
                                          @i2-in-range |
                                            less_than(i2, k)
                                            [using specialize succReflectsOrder(i2, k) succ-i2-in-range]
                                          @tail-entry |
                                            pointAt(s, i2) = numeral(add(succ(b), i2))
                                            [using specialize tail-entries(i2) i2-in-range]
                                          @shifted |
                                            pointAt(u, succ(i2)) = pointAt(s, i2)
                                            [using specialize tail(i2)]
                                          @shifted-entry |
                                            pointAt(u, succ(i2)) = numeral(add(succ(b), i2))
                                            [using chain shifted tail-entry]
                                          @succ-on-the-left |
                                            add(succ(b), i2) = succ(add(b, i2))
                                            [using specialize addSuccLeft(b, i2)]
                                          @succ-on-the-right |
                                            add(b, succ(i2)) = succ(add(b, i2))
                                            [using specialize addSuccRight(b, i2)]
                                          @shifted-entry-succ |
                                            pointAt(u, succ(i2)) = numeral(succ(add(b, i2)))
                                            [by rewrite succ-on-the-left shifted-entry]
                                          @shifted-entry-as-a-sum |
                                            pointAt(u, succ(i2)) = numeral(add(b, succ(i2)))
                                            [by rewrite succ-on-the-right shifted-entry-succ]
                                          @conclusion-shifted-entry |
                                            pointAt(u, i) = numeral(add(b, i))
                                            [by rewrite i-is-succ shifted-entry-as-a-sum]
                                        }
                                      @conclusion-when-succ |
                                        pointAt(u, i) = numeral(add(b, i))
                                        [by exists_elim with-predecessor-i2]
                                    }
                                }
                            }
                          @conclusion-entry-clause |
                            less_than(i, succ(k)) -> pointAt(u, i) = numeral(add(b, i))
                            [by implies_intro given-i-in-range]
                        }
                      @all-entries |
                        forall i: Nat; less_than(i, succ(k)) -> pointAt(u, i) = numeral(add(b, i))
                        [by forall_intro generalize-i]
                      @conclusion-witness-u |
                        exists s2: Points; forall i: Nat; less_than(i, succ(k)) -> pointAt(s2, i) = numeral(add(b, i))
                        [by exists_intro(u) all-entries]
                    }
                  @conclusion-with-u |
                    exists s2: Points; forall i: Nat; less_than(i, succ(k)) -> pointAt(s2, i) = numeral(add(b, i))
                    [by exists_elim with-prepended-u]
                }
              @conclusion-with-s |
                exists s2: Points; forall i: Nat; less_than(i, succ(k)) -> pointAt(s2, i) = numeral(add(b, i))
                [by exists_elim with-tail-s]
            }
          @conclusion-step |
            forall b: Nat; exists s2: Points; forall i: Nat; less_than(i, succ(k)) -> pointAt(s2, i) = numeral(add(b, i))
            [by forall_intro generalize-b]
        }
      @induction-step-at-k |
        (forall b: Nat; exists s2: Points; forall i: Nat; less_than(i, k) -> pointAt(s2, i) = numeral(add(b, i))) -> (forall b: Nat; exists s2: Points; forall i: Nat; less_than(i, succ(k)) -> pointAt(s2, i) = numeral(add(b, i)))
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; (forall b: Nat; exists s2: Points; forall i: Nat; less_than(i, k) -> pointAt(s2, i) = numeral(add(b, i))) -> (forall b: Nat; exists s2: Points; forall i: Nat; less_than(i, succ(k)) -> pointAt(s2, i) = numeral(add(b, i)))
    [by forall_intro induction-step]
  @conclusion |
    forall n: Nat; forall b: Nat; exists s: Points; forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(add(b, i))
    [using instantiation induction((fun k: Nat => forall b: Nat; exists s2: Points; forall i: Nat; less_than(i, k) -> pointAt(s2, i) = numeral(add(b, i)))) base-case induction-step-for-all-k]
qed

// The list of the n letters 0, …, n-1, which is distinct (numerals are injective).
theorem lettersListExists: forall n: Nat;
  exists s: Points; (forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(i)) and distinct(s, n)
proof
  @generalize-n |
    fix n: Nat {
      @offset-list-exists |
        exists s: Points; forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(add(ZERO, i))
        [using specialize letterListExists(n, ZERO)]
      @with-list-s |
        unpack s: Points from offset-list-exists {
          @offset-entries |
            forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(add(ZERO, i))
            [by hypothesis with-list-s]
          @generalize-i |
            fix i: Nat {
              @given-i-in-range |
                assume less_than(i, n) {
                  @i-in-range |
                    less_than(i, n)
                    [by hypothesis given-i-in-range]
                  @offset-entry |
                    pointAt(s, i) = numeral(add(ZERO, i))
                    [using specialize offset-entries(i) i-in-range]
                  @zero-plus-i |
                    add(ZERO, i) = i
                    [using specialize addZeroLeft(i)]
                  @conclusion-entry |
                    pointAt(s, i) = numeral(i)
                    [by rewrite zero-plus-i offset-entry]
                }
              @conclusion-entry-clause |
                less_than(i, n) -> pointAt(s, i) = numeral(i)
                [by implies_intro given-i-in-range]
            }
          @entries |
            forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(i)
            [by forall_intro generalize-i]
          @generalize-i-for-distinct |
            fix i: Nat {
              @generalize-j-for-distinct |
                fix j: Nat {
                  @given-i-below |
                    assume less_than(i, n) {
                      @given-j-below |
                        assume less_than(j, n) {
                          @given-entries-equal |
                            assume pointAt(s, i) = pointAt(s, j) {
                              @i-below |
                                less_than(i, n)
                                [by hypothesis given-i-below]
                              @j-below |
                                less_than(j, n)
                                [by hypothesis given-j-below]
                              @entries-equal |
                                pointAt(s, i) = pointAt(s, j)
                                [by hypothesis given-entries-equal]
                              @entry-i |
                                pointAt(s, i) = numeral(i)
                                [using specialize entries(i) i-below]
                              @entry-j |
                                pointAt(s, j) = numeral(j)
                                [using specialize entries(j) j-below]
                              @letter-i-is-entry-j |
                                numeral(i) = pointAt(s, j)
                                [by rewrite entry-i entries-equal]
                              @letters-equal |
                                numeral(i) = numeral(j)
                                [by rewrite entry-j letter-i-is-entry-j]
                              @conclusion-indices-equal |
                                i = j
                                [using specialize numeralInjective(i, j) letters-equal]
                            }
                          @conclusion-given-equal |
                            pointAt(s, i) = pointAt(s, j) -> i = j
                            [by implies_intro given-entries-equal]
                        }
                      @conclusion-given-j |
                        less_than(j, n) -> pointAt(s, i) = pointAt(s, j) -> i = j
                        [by implies_intro given-j-below]
                    }
                  @conclusion-distinct-at-i-j |
                    less_than(i, n) -> less_than(j, n) -> pointAt(s, i) = pointAt(s, j) -> i = j
                    [by implies_intro given-i-below]
                }
              @discharge-j-for-distinct |
                forall j: Nat; less_than(i, n) -> less_than(j, n) -> pointAt(s, i) = pointAt(s, j) -> i = j
                [by forall_intro generalize-j-for-distinct]
            }
          @list-distinct |
            distinct(s, n)
            [by forall_intro generalize-i-for-distinct]
          @entries-and-distinct |
            (forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(i)) and distinct(s, n)
            [by and_intro entries list-distinct]
          @conclusion-witness-s |
            exists s2: Points; (forall i: Nat; less_than(i, n) -> pointAt(s2, i) = numeral(i)) and distinct(s2, n)
            [by exists_intro(s) entries-and-distinct]
        }
      @conclusion-letters-list |
        exists s2: Points; (forall i: Nat; less_than(i, n) -> pointAt(s2, i) = numeral(i)) and distinct(s2, n)
        [by exists_elim with-list-s]
    }
  @conclusion |
    forall n: Nat; exists s: Points; (forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(i)) and distinct(s, n)
    [by forall_intro generalize-n]
qed

// -- the rotation -----------------------------------------------------------------------------

// ρ IS THE ROTATION of the n-gon: invertible, sends letter i to letter i+1 (i+1 < n), the last
// letter n-1 to letter 0, and fixes everything outside the segment.
define isTheRotation(rho, n) =
  invertible(rho)
  and (forall i: Nat; less_than(succ(i), n) -> apply(rho, numeral(i)) = numeral(succ(i)))
  and (forall m: Nat; n = succ(m) -> apply(rho, numeral(m)) = numeral(ZERO))
  and (forall x: Element; (not member(x, segment(n))) -> apply(rho, x) = x)

// The rotation exists: it is the n-cycle (0 1 … n-1) on the list of letters, whose advance,
// wrap-around and fixing of unlisted points are the cycle theory's theorems.
theorem rotationExists: forall n: Nat; exists rho: Fn; isTheRotation(rho, n)
proof
  @generalize-n |
    fix n: Nat {
      @letters-exist |
        exists s: Points; (forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(i)) and distinct(s, n)
        [using specialize lettersListExists(n)]
      @with-letters-s |
        unpack s: Points from letters-exist {
          @letters-facts |
            (forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(i)) and distinct(s, n)
            [by hypothesis with-letters-s]
          @entries |
            forall i: Nat; less_than(i, n) -> pointAt(s, i) = numeral(i)
            [by and_elim_left letters-facts]
          @letters-distinct |
            distinct(s, n)
            [by and_elim_right letters-facts]
          @cycle-invertible |
            invertible(cycle(s, n))
            [using specialize cycleIsAPermutation(s, n)]

          // advance
          @generalize-i-for-advance |
            fix i: Nat {
              @given-succ-i-in-range |
                assume less_than(succ(i), n) {
                  @succ-i-in-range |
                    less_than(succ(i), n)
                    [by hypothesis given-succ-i-in-range]
                  @i-below-succ-i |
                    less_than(i, succ(i))
                    [using specialize lessThanSelf(i)]
                  @i-in-range |
                    less_than(i, n)
                    [using specialize lessThanTransitive(i, succ(i), n) i-below-succ-i succ-i-in-range]
                  @n-is-a-successor |
                    exists m: Nat; n = succ(m)
                    [using specialize positiveIsASuccessor(succ(i), n) succ-i-in-range]
                  @entry-i |
                    pointAt(s, i) = numeral(i)
                    [using specialize entries(i) i-in-range]
                  @entry-succ-i |
                    pointAt(s, succ(i)) = numeral(succ(i))
                    [using specialize entries(succ(i)) succ-i-in-range]
                  @with-predecessor-m |
                    unpack m: Nat from n-is-a-successor {
                      @n-is-succ-m |
                        n = succ(m)
                        [by hypothesis with-predecessor-m]
                      @letters-distinct-to-succ-m |
                        distinct(s, succ(m))
                        [by rewrite n-is-succ-m letters-distinct]
                      @succ-i-below-succ-m |
                        less_than(succ(i), succ(m))
                        [by rewrite n-is-succ-m succ-i-in-range]
                      @i-below-m |
                        less_than(i, m)
                        [using specialize succReflectsOrder(i, m) succ-i-below-succ-m]
                      @cycle-advances-at-i |
                        apply(cycle(s, succ(m)), pointAt(s, i)) = pointAt(s, succ(i))
                        [using specialize cycleAdvances(s, m, i) letters-distinct-to-succ-m i-below-m]
                      @cycle-advances-from-letter-i |
                        apply(cycle(s, succ(m)), numeral(i)) = pointAt(s, succ(i))
                        [by rewrite entry-i cycle-advances-at-i]
                      @cycle-advances-on-letters-at-succ-m |
                        apply(cycle(s, succ(m)), numeral(i)) = numeral(succ(i))
                        [by rewrite entry-succ-i cycle-advances-from-letter-i]
                      @conclusion-advance-at-m |
                        apply(cycle(s, n), numeral(i)) = numeral(succ(i))
                        [by rewrite n-is-succ-m cycle-advances-on-letters-at-succ-m]
                    }
                  @conclusion-advance |
                    apply(cycle(s, n), numeral(i)) = numeral(succ(i))
                    [by exists_elim with-predecessor-m]
                }
              @conclusion-advance-clause |
                less_than(succ(i), n) -> apply(cycle(s, n), numeral(i)) = numeral(succ(i))
                [by implies_intro given-succ-i-in-range]
            }
          @cycle-advances-on-letters |
            forall i: Nat; less_than(succ(i), n) -> apply(cycle(s, n), numeral(i)) = numeral(succ(i))
            [by forall_intro generalize-i-for-advance]

          // wrap-around
          @generalize-m-for-wrap |
            fix m: Nat {
              @given-n-is-succ-m |
                assume n = succ(m) {
                  @n-is-succ-m |
                    n = succ(m)
                    [by hypothesis given-n-is-succ-m]
                  @letters-distinct-to-succ-m |
                    distinct(s, succ(m))
                    [by rewrite n-is-succ-m letters-distinct]
                  @cycle-wraps |
                    apply(cycle(s, succ(m)), pointAt(s, m)) = pointAt(s, ZERO)
                    [using specialize cycleWrapsAround(s, m) letters-distinct-to-succ-m]
                  @m-below-succ-m |
                    less_than(m, succ(m))
                    [using specialize lessThanSelf(m)]
                  @m-in-range |
                    less_than(m, n)
                    [by rewrite n-is-succ-m m-below-succ-m]
                  @zero-below-succ-m |
                    less_than(ZERO, succ(m))
                    [using specialize zeroBelowSucc(m)]
                  @zero-in-range |
                    less_than(ZERO, n)
                    [by rewrite n-is-succ-m zero-below-succ-m]
                  @entry-m |
                    pointAt(s, m) = numeral(m)
                    [using specialize entries(m) m-in-range]
                  @entry-zero |
                    pointAt(s, ZERO) = numeral(ZERO)
                    [using specialize entries(ZERO) zero-in-range]
                  @cycle-wraps-from-letter-m |
                    apply(cycle(s, succ(m)), numeral(m)) = pointAt(s, ZERO)
                    [by rewrite entry-m cycle-wraps]
                  @cycle-wraps-on-letters-at-succ-m |
                    apply(cycle(s, succ(m)), numeral(m)) = numeral(ZERO)
                    [by rewrite entry-zero cycle-wraps-from-letter-m]
                  @conclusion-wrap |
                    apply(cycle(s, n), numeral(m)) = numeral(ZERO)
                    [by rewrite n-is-succ-m cycle-wraps-on-letters-at-succ-m]
                }
              @conclusion-wrap-clause |
                n = succ(m) -> apply(cycle(s, n), numeral(m)) = numeral(ZERO)
                [by implies_intro given-n-is-succ-m]
            }
          @cycle-wraps-on-letters |
            forall m: Nat; n = succ(m) -> apply(cycle(s, n), numeral(m)) = numeral(ZERO)
            [by forall_intro generalize-m-for-wrap]

          // fixing the rest
          @generalize-x |
            fix x: Element {
              @given-x-outside |
                assume not member(x, segment(n)) {
                  @x-outside |
                    not member(x, segment(n))
                    [by hypothesis given-x-outside]
                  @generalize-i-for-avoids |
                    fix i: Nat {
                      @given-i-in-range |
                        assume less_than(i, n) {
                          @i-in-range |
                            less_than(i, n)
                            [by hypothesis given-i-in-range]
                          @entry-i |
                            pointAt(s, i) = numeral(i)
                            [using specialize entries(i) i-in-range]
                          @letter-membership |
                            member(numeral(i), segment(n)) iff less_than(i, n)
                            [using specialize numeralInSegment(n, i)]
                          @letter-in-segment |
                            member(numeral(i), segment(n))
                            [using tautology letter-membership i-in-range]
                          @suppose-x-is-the-entry |
                            assume x = pointAt(s, i) {
                              @x-is-the-entry |
                                x = pointAt(s, i)
                                [by hypothesis suppose-x-is-the-entry]
                              @x-is-the-letter |
                                x = numeral(i)
                                [using chain x-is-the-entry entry-i]
                              @x-in-segment |
                                member(x, segment(n))
                                [by rewrite x-is-the-letter letter-in-segment]
                            }
                          @conclusion-x-avoids-entry |
                            x != pointAt(s, i)
                            [by not_intro suppose-x-is-the-entry x-in-segment x-outside]
                        }
                      @conclusion-avoids-clause |
                        less_than(i, n) -> x != pointAt(s, i)
                        [by implies_intro given-i-in-range]
                    }
                  @x-avoids-the-letters |
                    avoids(x, s, n)
                    [by forall_intro generalize-i-for-avoids]
                  @conclusion-x-fixed |
                    apply(cycle(s, n), x) = x
                    [using specialize cycleFixesTheUnlisted(s, n, x) x-avoids-the-letters]
                }
              @conclusion-fixes-clause |
                (not member(x, segment(n))) -> apply(cycle(s, n), x) = x
                [by implies_intro given-x-outside]
            }
          @cycle-fixes-outside |
            forall x: Element; (not member(x, segment(n))) -> apply(cycle(s, n), x) = x
            [by forall_intro generalize-x]
          @cycle-is-the-rotation |
            isTheRotation(cycle(s, n), n)
            [using tautology cycle-invertible cycle-advances-on-letters cycle-wraps-on-letters cycle-fixes-outside]
          @conclusion-witness-cycle |
            exists rho: Fn; isTheRotation(rho, n)
            [by exists_intro(cycle(s, n)) cycle-is-the-rotation]
        }
      @conclusion-rotation-exists |
        exists rho: Fn; isTheRotation(rho, n)
        [by exists_elim with-letters-s]
    }
  @conclusion |
    forall n: Nat; exists rho: Fn; isTheRotation(rho, n)
    [by forall_intro generalize-n]
qed

// -- powers of a map ----------------------------------------------------------------------------

// f^k as a MAP (std/function/iterate.b4m's `iterate` is the pointwise f^k(x)): f^0 = id,
// f^(k+1) = f ∘ f^k. (Axioms, not a definition block: a bare constant on a clause's
// right-hand side is read as a clause variable.)
func power(f: Fn, k: Nat) => Fn
axiom powerZero: forall f: Fn; power(f, ZERO) = identityFn
axiom powerSucc: forall f: Fn; forall k: Nat; power(f, succ(k)) = compose(f, power(f, k))

// f^k applied is the k-th iterate.
theorem powerApply: forall f: Fn; forall x: Element; forall k: Nat; apply(power(f, k), x) = iterate(f, k, x)
proof
  @generalize-f |
    fix f: Fn {
      @generalize-x |
        fix x: Element {
          @zeroth-power |
            power(f, ZERO) = identityFn
            [using specialize powerZero(f)]
          @identity-at-x |
            apply(identityFn, x) = x
            [using specialize identityApply(x)]
          @zeroth-power-at-x |
            apply(power(f, ZERO), x) = x
            [by rewrite zeroth-power identity-at-x]
          @zeroth-iterate |
            iterate(f, ZERO, x) = x
            [using specialize iterateZero(f, x)]
          @base-case |
            apply(power(f, ZERO), x) = iterate(f, ZERO, x)
            [by rewrite zeroth-iterate zeroth-power-at-x]
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume apply(power(f, k), x) = iterate(f, k, x) {
                  @inductive-hypothesis |
                    apply(power(f, k), x) = iterate(f, k, x)
                    [by hypothesis given-inductive-hypothesis]
                  @next-power |
                    power(f, succ(k)) = compose(f, power(f, k))
                    [using specialize powerSucc(f, k)]
                  @composite-at-x |
                    apply(compose(f, power(f, k)), x) = apply(f, apply(power(f, k), x))
                    [using specialize composeApply(f, power(f, k), x)]
                  @next-power-at-x |
                    apply(power(f, succ(k)), x) = apply(f, apply(power(f, k), x))
                    [by rewrite next-power composite-at-x]
                  @next-power-at-x-via-iterate |
                    apply(power(f, succ(k)), x) = apply(f, iterate(f, k, x))
                    [by rewrite inductive-hypothesis next-power-at-x]
                  @next-iterate |
                    iterate(f, succ(k), x) = apply(f, iterate(f, k, x))
                    [using specialize iterateSucc(f, k, x)]
                  @conclusion-step |
                    apply(power(f, succ(k)), x) = iterate(f, succ(k), x)
                    [by rewrite next-iterate next-power-at-x-via-iterate]
                }
              @induction-step-at-k |
                apply(power(f, k), x) = iterate(f, k, x) -> apply(power(f, succ(k)), x) = iterate(f, succ(k), x)
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat; apply(power(f, k), x) = iterate(f, k, x) -> apply(power(f, succ(k)), x) = iterate(f, succ(k), x)
            [by forall_intro induction-step]
          @conclusion-for-all-k |
            forall k: Nat; apply(power(f, k), x) = iterate(f, k, x)
            [using instantiation induction((fun k: Nat => apply(power(f, k), x) = iterate(f, k, x))) base-case induction-step-for-all-k]
        }
      @discharge-x |
        forall x: Element; forall k: Nat; apply(power(f, k), x) = iterate(f, k, x)
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall f: Fn; forall x: Element; forall k: Nat; apply(power(f, k), x) = iterate(f, k, x)
    [by forall_intro generalize-f]
qed

// A power of a permutation is a permutation.
theorem powerIsAPermutation: forall f: Fn; invertible(f) -> forall k: Nat; invertible(power(f, k))
proof
  @generalize-f |
    fix f: Fn {
      @given-invertible |
        assume invertible(f) {
          @f-invertible |
            invertible(f)
            [by hypothesis given-invertible]
          @zeroth-power |
            power(f, ZERO) = identityFn
            [using specialize powerZero(f)]
          @identity-invertible |
            invertible(identityFn)
            [by cite identityIsAPermutation]
          @base-case |
            invertible(power(f, ZERO))
            [by rewrite zeroth-power identity-invertible]
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume invertible(power(f, k)) {
                  @inductive-hypothesis |
                    invertible(power(f, k))
                    [by hypothesis given-inductive-hypothesis]
                  @next-power |
                    power(f, succ(k)) = compose(f, power(f, k))
                    [using specialize powerSucc(f, k)]
                  @composite-invertible |
                    invertible(compose(f, power(f, k)))
                    [using specialize composeIsAPermutation(f, power(f, k)) f-invertible inductive-hypothesis]
                  @conclusion-step |
                    invertible(power(f, succ(k)))
                    [by rewrite next-power composite-invertible]
                }
              @induction-step-at-k |
                invertible(power(f, k)) -> invertible(power(f, succ(k)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat; invertible(power(f, k)) -> invertible(power(f, succ(k)))
            [by forall_intro induction-step]
          @conclusion-for-all-k |
            forall k: Nat; invertible(power(f, k))
            [using instantiation induction((fun k: Nat => invertible(power(f, k)))) base-case induction-step-for-all-k]
        }
      @conclusion-at-f |
        invertible(f) -> forall k: Nat; invertible(power(f, k))
        [by implies_intro given-invertible]
    }
  @conclusion |
    forall f: Fn; invertible(f) -> forall k: Nat; invertible(power(f, k))
    [by forall_intro generalize-f]
qed

// f commutes with its powers: f ∘ f^k = f^k ∘ f.
theorem powerCommutes: forall f: Fn; forall k: Nat; compose(f, power(f, k)) = compose(power(f, k), f)
proof
  @generalize-f |
    fix f: Fn {
      @zeroth-power |
        power(f, ZERO) = identityFn
        [using specialize powerZero(f)]
      @identity-on-the-right |
        compose(f, identityFn) = f
        [using specialize composeIdentityRight(f)]
      @identity-on-the-left |
        compose(identityFn, f) = f
        [using specialize composeIdentityLeft(f)]
      @identity-commutes |
        compose(f, identityFn) = compose(identityFn, f)
        [by rewrite identity-on-the-left identity-on-the-right]
      @base-case |
        compose(f, power(f, ZERO)) = compose(power(f, ZERO), f)
        [by rewrite zeroth-power identity-commutes]
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume compose(f, power(f, k)) = compose(power(f, k), f) {
              @inductive-hypothesis |
                compose(f, power(f, k)) = compose(power(f, k), f)
                [by hypothesis given-inductive-hypothesis]
              @next-power |
                power(f, succ(k)) = compose(f, power(f, k))
                [using specialize powerSucc(f, k)]
              @reassociated |
                compose(compose(f, power(f, k)), f) = compose(f, compose(power(f, k), f))
                [using specialize composeAssoc(f, power(f, k), f)]
              @reassociated-via-hypothesis |
                compose(compose(f, power(f, k)), f) = compose(f, compose(f, power(f, k)))
                [by rewrite inductive-hypothesis reassociated]
              @flipped |
                compose(f, compose(f, power(f, k))) = compose(compose(f, power(f, k)), f)
                [by symmetry reassociated-via-hypothesis]
              @conclusion-step |
                compose(f, power(f, succ(k))) = compose(power(f, succ(k)), f)
                [by rewrite next-power flipped]
            }
          @induction-step-at-k |
            compose(f, power(f, k)) = compose(power(f, k), f) -> compose(f, power(f, succ(k))) = compose(power(f, succ(k)), f)
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; compose(f, power(f, k)) = compose(power(f, k), f) -> compose(f, power(f, succ(k))) = compose(power(f, succ(k)), f)
        [by forall_intro induction-step]
      @conclusion-for-all-k |
        forall k: Nat; compose(f, power(f, k)) = compose(power(f, k), f)
        [using instantiation induction((fun k: Nat => compose(f, power(f, k)) = compose(power(f, k), f))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall f: Fn; forall k: Nat; compose(f, power(f, k)) = compose(power(f, k), f)
    [by forall_intro generalize-f]
qed

// Pointwise: f^k(f(x)) = f(f^k(x)).
theorem powerCommutesPointwise: forall f: Fn; forall k: Nat; forall x: Element;
  apply(power(f, k), apply(f, x)) = apply(f, apply(power(f, k), x))
proof
  @generalize-f |
    fix f: Fn {
      @generalize-k |
        fix k: Nat {
          @commutes |
            compose(f, power(f, k)) = compose(power(f, k), f)
            [using specialize powerCommutes(f, k)]
          @generalize-x |
            fix x: Element {
              @left-unfolds |
                apply(compose(f, power(f, k)), x) = apply(f, apply(power(f, k), x))
                [using specialize composeApply(f, power(f, k), x)]
              @right-unfolds |
                apply(compose(power(f, k), f), x) = apply(power(f, k), apply(f, x))
                [using specialize composeApply(power(f, k), f, x)]
              @left-as-right |
                apply(compose(power(f, k), f), x) = apply(f, apply(power(f, k), x))
                [by rewrite commutes left-unfolds]
              @conclusion-pointwise |
                apply(power(f, k), apply(f, x)) = apply(f, apply(power(f, k), x))
                [by rewrite right-unfolds left-as-right]
            }
          @discharge-x |
            forall x: Element; apply(power(f, k), apply(f, x)) = apply(f, apply(power(f, k), x))
            [by forall_intro generalize-x]
        }
      @discharge-k |
        forall k: Nat; forall x: Element; apply(power(f, k), apply(f, x)) = apply(f, apply(power(f, k), x))
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall f: Fn; forall k: Nat; forall x: Element; apply(power(f, k), apply(f, x)) = apply(f, apply(power(f, k), x))
    [by forall_intro generalize-f]
qed

// And with the inverse: f^k(f⁻¹(x)) = f⁻¹(f^k(x)) — write x = f(y) and commute f past f^k.
theorem powerCommutesWithInverse: forall f: Fn; invertible(f) -> forall k: Nat; forall x: Element;
  apply(power(f, k), apply(inverse(f), x)) = apply(inverse(f), apply(power(f, k), x))
proof
  @generalize-f |
    fix f: Fn {
      @given-invertible |
        assume invertible(f) {
          @f-invertible |
            invertible(f)
            [by hypothesis given-invertible]
          @generalize-k |
            fix k: Nat {
              @generalize-x |
                fix x: Element {
                  @x-recovered |
                    apply(f, apply(inverse(f), x)) = x
                    [using specialize permutationUndoesInverse(f, x)]
                  @commuted-at-the-preimage |
                    apply(power(f, k), apply(f, apply(inverse(f), x))) = apply(f, apply(power(f, k), apply(inverse(f), x)))
                    [using specialize powerCommutesPointwise(f, k, apply(inverse(f), x))]
                  @commuted-at-x |
                    apply(power(f, k), x) = apply(f, apply(power(f, k), apply(inverse(f), x)))
                    [by rewrite x-recovered commuted-at-the-preimage]
                  @inverse-undoes |
                    apply(inverse(f), apply(f, apply(power(f, k), apply(inverse(f), x)))) = apply(power(f, k), apply(inverse(f), x))
                    [using specialize inverseUndoesPermutation(f, apply(power(f, k), apply(inverse(f), x)))]
                  @inverse-at-the-image |
                    apply(inverse(f), apply(power(f, k), x)) = apply(power(f, k), apply(inverse(f), x))
                    [by rewrite commuted-at-x inverse-undoes]
                  @conclusion-commuted |
                    apply(power(f, k), apply(inverse(f), x)) = apply(inverse(f), apply(power(f, k), x))
                    [by symmetry inverse-at-the-image]
                }
              @discharge-x |
                forall x: Element; apply(power(f, k), apply(inverse(f), x)) = apply(inverse(f), apply(power(f, k), x))
                [by forall_intro generalize-x]
            }
          @discharge-k |
            forall k: Nat; forall x: Element; apply(power(f, k), apply(inverse(f), x)) = apply(inverse(f), apply(power(f, k), x))
            [by forall_intro generalize-k]
        }
      @conclusion-at-f |
        invertible(f) -> forall k: Nat; forall x: Element; apply(power(f, k), apply(inverse(f), x)) = apply(inverse(f), apply(power(f, k), x))
        [by implies_intro given-invertible]
    }
  @conclusion |
    forall f: Fn; invertible(f) -> forall k: Nat; forall x: Element;
      apply(power(f, k), apply(inverse(f), x)) = apply(inverse(f), apply(power(f, k), x))
    [by forall_intro generalize-f]
qed

// A fixed point of f is fixed by every power.
theorem powerFixesAFixedPoint: forall f: Fn; forall x: Element; apply(f, x) = x -> forall k: Nat; apply(power(f, k), x) = x
proof
  @generalize-f |
    fix f: Fn {
      @generalize-x |
        fix x: Element {
          @given-fixed |
            assume apply(f, x) = x {
              @fixed |
                apply(f, x) = x
                [by hypothesis given-fixed]
              @zeroth-power |
                power(f, ZERO) = identityFn
                [using specialize powerZero(f)]
              @identity-at-x |
                apply(identityFn, x) = x
                [using specialize identityApply(x)]
              @base-case |
                apply(power(f, ZERO), x) = x
                [by rewrite zeroth-power identity-at-x]
              @induction-step |
                fix k: Nat {
                  @given-inductive-hypothesis |
                    assume apply(power(f, k), x) = x {
                      @inductive-hypothesis |
                        apply(power(f, k), x) = x
                        [by hypothesis given-inductive-hypothesis]
                      @next-power |
                        power(f, succ(k)) = compose(f, power(f, k))
                        [using specialize powerSucc(f, k)]
                      @composite-at-x |
                        apply(compose(f, power(f, k)), x) = apply(f, apply(power(f, k), x))
                        [using specialize composeApply(f, power(f, k), x)]
                      @composite-after-power |
                        apply(compose(f, power(f, k)), x) = apply(f, x)
                        [by rewrite inductive-hypothesis composite-at-x]
                      @composite-fixes-x |
                        apply(compose(f, power(f, k)), x) = x
                        [by rewrite fixed composite-after-power]
                      @conclusion-step |
                        apply(power(f, succ(k)), x) = x
                        [by rewrite next-power composite-fixes-x]
                    }
                  @induction-step-at-k |
                    apply(power(f, k), x) = x -> apply(power(f, succ(k)), x) = x
                    [by implies_intro given-inductive-hypothesis]
                }
              @induction-step-for-all-k |
                forall k: Nat; apply(power(f, k), x) = x -> apply(power(f, succ(k)), x) = x
                [by forall_intro induction-step]
              @conclusion-for-all-k |
                forall k: Nat; apply(power(f, k), x) = x
                [using instantiation induction((fun k: Nat => apply(power(f, k), x) = x)) base-case induction-step-for-all-k]
            }
          @conclusion-at-x |
            apply(f, x) = x -> forall k: Nat; apply(power(f, k), x) = x
            [by implies_intro given-fixed]
        }
      @discharge-x |
        forall x: Element; apply(f, x) = x -> forall k: Nat; apply(power(f, k), x) = x
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall f: Fn; forall x: Element; apply(f, x) = x -> forall k: Nat; apply(power(f, k), x) = x
    [by forall_intro generalize-f]
qed

// The identity is a permutation of n letters.
theorem identityPermutesTheSegment: forall n: Nat; permutesTheSegment(identityFn, n)
proof
  @generalize-n |
    fix n: Nat {
      @identity-invertible |
        invertible(identityFn)
        [by cite identityIsAPermutation]
      @identity-permutes |
        permutes(identityFn, segment(n))
        [using specialize identityPermutes(segment(n))]
      @generalize-x |
        fix x: Element {
          @identity-fixes-x |
            apply(identityFn, x) = x
            [using specialize identityApply(x)]
          @conclusion-fixes-clause |
            (not member(x, segment(n))) -> apply(identityFn, x) = x
            [using tautology identity-fixes-x]
        }
      @identity-fixes-outside |
        forall x: Element; (not member(x, segment(n))) -> apply(identityFn, x) = x
        [by forall_intro generalize-x]
      @conclusion-identity-permutes-letters |
        permutesTheSegment(identityFn, n)
        [using tautology identity-invertible identity-permutes identity-fixes-outside]
    }
  @conclusion |
    forall n: Nat; permutesTheSegment(identityFn, n)
    [by forall_intro generalize-n]
qed

// Powers of a permutation of n letters permute the n letters.
theorem powerPermutesTheSegment: forall f: Fn; forall n: Nat; permutesTheSegment(f, n) ->
  forall k: Nat; permutesTheSegment(power(f, k), n)
proof
  @generalize-f |
    fix f: Fn {
      @generalize-n |
        fix n: Nat {
          @given-permutes |
            assume permutesTheSegment(f, n) {
              @permutes-letters |
                permutesTheSegment(f, n)
                [by hypothesis given-permutes]
              @zeroth-power |
                power(f, ZERO) = identityFn
                [using specialize powerZero(f)]
              @identity-permutes-letters |
                permutesTheSegment(identityFn, n)
                [using specialize identityPermutesTheSegment(n)]
              @base-case |
                permutesTheSegment(power(f, ZERO), n)
                [by rewrite zeroth-power identity-permutes-letters]
              @induction-step |
                fix k: Nat {
                  @given-inductive-hypothesis |
                    assume permutesTheSegment(power(f, k), n) {
                      @inductive-hypothesis |
                        permutesTheSegment(power(f, k), n)
                        [by hypothesis given-inductive-hypothesis]
                      @next-power |
                        power(f, succ(k)) = compose(f, power(f, k))
                        [using specialize powerSucc(f, k)]
                      @composite-permutes |
                        permutesTheSegment(compose(f, power(f, k)), n)
                        [using specialize composingPermutationsOfTheSegment(power(f, k), f, n) inductive-hypothesis permutes-letters]
                      @conclusion-step |
                        permutesTheSegment(power(f, succ(k)), n)
                        [by rewrite next-power composite-permutes]
                    }
                  @induction-step-at-k |
                    permutesTheSegment(power(f, k), n) -> permutesTheSegment(power(f, succ(k)), n)
                    [by implies_intro given-inductive-hypothesis]
                }
              @induction-step-for-all-k |
                forall k: Nat; permutesTheSegment(power(f, k), n) -> permutesTheSegment(power(f, succ(k)), n)
                [by forall_intro induction-step]
              @conclusion-for-all-k |
                forall k: Nat; permutesTheSegment(power(f, k), n)
                [using instantiation induction((fun k: Nat => permutesTheSegment(power(f, k), n))) base-case induction-step-for-all-k]
            }
          @conclusion-at-n |
            permutesTheSegment(f, n) -> forall k: Nat; permutesTheSegment(power(f, k), n)
            [by implies_intro given-permutes]
        }
      @discharge-n |
        forall n: Nat; permutesTheSegment(f, n) -> forall k: Nat; permutesTheSegment(power(f, k), n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall f: Fn; forall n: Nat; permutesTheSegment(f, n) -> forall k: Nat; permutesTheSegment(power(f, k), n)
    [by forall_intro generalize-f]
qed

// The rotation is a permutation of the n letters: it maps the segment into itself (advance
// or wrap), is injective (invertible), and covers the segment (letter 0 from the last
// letter, letter j+1 from letter j).
theorem rotationPermutesTheSegment: forall rho: Fn; forall n: Nat; isTheRotation(rho, n) -> permutesTheSegment(rho, n)
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-n |
        fix n: Nat {
          @given-rotation |
            assume isTheRotation(rho, n) {
              @rotation |
                isTheRotation(rho, n)
                [by hypothesis given-rotation]
              @rho-invertible |
                invertible(rho)
                [using tautology rotation]
              @advances |
                forall i: Nat; less_than(succ(i), n) -> apply(rho, numeral(i)) = numeral(succ(i))
                [using tautology rotation]
              @wraps |
                forall m: Nat; n = succ(m) -> apply(rho, numeral(m)) = numeral(ZERO)
                [using tautology rotation]
              @fixes-outside |
                forall x: Element; (not member(x, segment(n))) -> apply(rho, x) = x
                [using tautology rotation]

              // maps into
              @generalize-x |
                fix x: Element {
                  @given-x-in |
                    assume member(x, segment(n)) {
                      @x-in |
                        member(x, segment(n))
                        [by hypothesis given-x-in]
                      @x-membership |
                        member(x, segment(n)) iff (exists i: Nat; less_than(i, n) and x = numeral(i))
                        [using specialize segmentMember(n, x)]
                      @x-is-a-letter |
                        exists i: Nat; less_than(i, n) and x = numeral(i)
                        [using tautology x-membership x-in]
                      @with-index-i |
                        unpack i: Nat from x-is-a-letter {
                          @letter-facts |
                            less_than(i, n) and x = numeral(i)
                            [by hypothesis with-index-i]
                          @i-in-range |
                            less_than(i, n)
                            [by and_elim_left letter-facts]
                          @x-is-letter-i |
                            x = numeral(i)
                            [by and_elim_right letter-facts]
                          @succ-i-below-or-is |
                            less_than(succ(i), n) or succ(i) = n
                            [using specialize successorBelowOrIs(i, n) i-in-range]
                          @conclusion-image-in |
                            member(apply(rho, x), segment(n))
                            case succ-i-below-or-is {
                              @when-advance |
                                assume less_than(succ(i), n) {
                                  @succ-i-in-range |
                                    less_than(succ(i), n)
                                    [by hypothesis when-advance]
                                  @image-is-next-letter |
                                    apply(rho, numeral(i)) = numeral(succ(i))
                                    [using specialize advances(i) succ-i-in-range]
                                  @next-letter-membership |
                                    member(numeral(succ(i)), segment(n)) iff less_than(succ(i), n)
                                    [using specialize numeralInSegment(n, succ(i))]
                                  @next-letter-in |
                                    member(numeral(succ(i)), segment(n))
                                    [using tautology next-letter-membership succ-i-in-range]
                                  @image-of-letter-in |
                                    member(apply(rho, numeral(i)), segment(n))
                                    [by rewrite image-is-next-letter next-letter-in]
                                  @conclusion-advanced-in |
                                    member(apply(rho, x), segment(n))
                                    [by rewrite x-is-letter-i image-of-letter-in]
                                }
                              @when-wrap |
                                assume succ(i) = n {
                                  @succ-i-is-n |
                                    succ(i) = n
                                    [by hypothesis when-wrap]
                                  @n-is-succ-i |
                                    n = succ(i)
                                    [by symmetry succ-i-is-n]
                                  @image-is-zero |
                                    apply(rho, numeral(i)) = numeral(ZERO)
                                    [using specialize wraps(i) n-is-succ-i]
                                  @zero-below-succ-i |
                                    less_than(ZERO, succ(i))
                                    [using specialize zeroBelowSucc(i)]
                                  @zero-in-range |
                                    less_than(ZERO, n)
                                    [by rewrite n-is-succ-i zero-below-succ-i]
                                  @zero-membership |
                                    member(numeral(ZERO), segment(n)) iff less_than(ZERO, n)
                                    [using specialize numeralInSegment(n, ZERO)]
                                  @zero-in |
                                    member(numeral(ZERO), segment(n))
                                    [using tautology zero-membership zero-in-range]
                                  @image-of-letter-in |
                                    member(apply(rho, numeral(i)), segment(n))
                                    [by rewrite image-is-zero zero-in]
                                  @conclusion-wrapped-in |
                                    member(apply(rho, x), segment(n))
                                    [by rewrite x-is-letter-i image-of-letter-in]
                                }
                            }
                        }
                      @conclusion-image-in-at-x |
                        member(apply(rho, x), segment(n))
                        [by exists_elim with-index-i]
                    }
                  @conclusion-maps-into-at-x |
                    member(x, segment(n)) -> member(apply(rho, x), segment(n))
                    [by implies_intro given-x-in]
                }
              @maps-into |
                forall x: Element; member(x, segment(n)) -> member(apply(rho, x), segment(n))
                [by forall_intro generalize-x]

              // injective on
              @injective |
                forall a: Element; forall b: Element; apply(rho, a) = apply(rho, b) -> a = b
                [using specialize permutationIsInjective(rho)]
              @generalize-x-for-injective |
                fix x: Element {
                  @generalize-y-for-injective |
                    fix y: Element {
                      @injective-at-x-y |
                        apply(rho, x) = apply(rho, y) -> x = y
                        [using specialize injective(x, y)]
                      @conclusion-injective-clause |
                        member(x, segment(n)) -> member(y, segment(n)) -> apply(rho, x) = apply(rho, y) -> x = y
                        [using tautology injective-at-x-y]
                    }
                  @discharge-y-for-injective |
                    forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> apply(rho, x) = apply(rho, y) -> x = y
                    [by forall_intro generalize-y-for-injective]
                }
              @injective-on |
                forall x: Element; forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> apply(rho, x) = apply(rho, y) -> x = y
                [by forall_intro generalize-x-for-injective]

              // covers
              @generalize-y |
                fix y: Element {
                  @given-y-in |
                    assume member(y, segment(n)) {
                      @y-in |
                        member(y, segment(n))
                        [by hypothesis given-y-in]
                      @y-membership |
                        member(y, segment(n)) iff (exists j: Nat; less_than(j, n) and y = numeral(j))
                        [using specialize segmentMember(n, y)]
                      @y-is-a-letter |
                        exists j: Nat; less_than(j, n) and y = numeral(j)
                        [using tautology y-membership y-in]
                      @with-index-j |
                        unpack j: Nat from y-is-a-letter {
                          @letter-facts |
                            less_than(j, n) and y = numeral(j)
                            [by hypothesis with-index-j]
                          @j-in-range |
                            less_than(j, n)
                            [by and_elim_left letter-facts]
                          @y-is-letter-j |
                            y = numeral(j)
                            [by and_elim_right letter-facts]
                          @j-zero-or-succ |
                            j = ZERO or (exists j2: Nat; j = succ(j2))
                            [using specialize zeroOrSucc(j)]
                          @conclusion-y-is-hit |
                            exists x: Element; member(x, segment(n)) and apply(rho, x) = y
                            case j-zero-or-succ {
                              @when-zero |
                                assume j = ZERO {
                                  @j-is-zero |
                                    j = ZERO
                                    [by hypothesis when-zero]
                                  @y-is-zero |
                                    y = numeral(ZERO)
                                    [by rewrite j-is-zero y-is-letter-j]
                                  @n-is-a-successor |
                                    exists m: Nat; n = succ(m)
                                    [using specialize positiveIsASuccessor(j, n) j-in-range]
                                  @with-last-m |
                                    unpack m: Nat from n-is-a-successor {
                                      @n-is-succ-m |
                                        n = succ(m)
                                        [by hypothesis with-last-m]
                                      @last-wraps |
                                        apply(rho, numeral(m)) = numeral(ZERO)
                                        [using specialize wraps(m) n-is-succ-m]
                                      @last-hits-y |
                                        apply(rho, numeral(m)) = y
                                        [by rewrite y-is-zero last-wraps]
                                      @m-below-succ-m |
                                        less_than(m, succ(m))
                                        [using specialize lessThanSelf(m)]
                                      @m-in-range |
                                        less_than(m, n)
                                        [by rewrite n-is-succ-m m-below-succ-m]
                                      @last-membership |
                                        member(numeral(m), segment(n)) iff less_than(m, n)
                                        [using specialize numeralInSegment(n, m)]
                                      @last-in |
                                        member(numeral(m), segment(n))
                                        [using tautology last-membership m-in-range]
                                      @last-in-and-hits |
                                        member(numeral(m), segment(n)) and apply(rho, numeral(m)) = y
                                        [by and_intro last-in last-hits-y]
                                      @conclusion-witness-last |
                                        exists x: Element; member(x, segment(n)) and apply(rho, x) = y
                                        [by exists_intro(numeral(m)) last-in-and-hits]
                                    }
                                  @conclusion-when-zero |
                                    exists x: Element; member(x, segment(n)) and apply(rho, x) = y
                                    [by exists_elim with-last-m]
                                }
                              @when-succ |
                                assume exists j2: Nat; j = succ(j2) {
                                  @predecessor-exists |
                                    exists j2: Nat; j = succ(j2)
                                    [by hypothesis when-succ]
                                  @with-predecessor-j2 |
                                    unpack j2: Nat from predecessor-exists {
                                      @j-is-succ |
                                        j = succ(j2)
                                        [by hypothesis with-predecessor-j2]
                                      @succ-j2-in-range |
                                        less_than(succ(j2), n)
                                        [by rewrite j-is-succ j-in-range]
                                      @previous-advances |
                                        apply(rho, numeral(j2)) = numeral(succ(j2))
                                        [using specialize advances(j2) succ-j2-in-range]
                                      @y-is-letter-succ-j2 |
                                        y = numeral(succ(j2))
                                        [by rewrite j-is-succ y-is-letter-j]
                                      @previous-hits-y |
                                        apply(rho, numeral(j2)) = y
                                        [by rewrite y-is-letter-succ-j2 previous-advances]
                                      @j2-below-succ-j2 |
                                        less_than(j2, succ(j2))
                                        [using specialize lessThanSelf(j2)]
                                      @j2-in-range |
                                        less_than(j2, n)
                                        [using specialize lessThanTransitive(j2, succ(j2), n) j2-below-succ-j2 succ-j2-in-range]
                                      @previous-membership |
                                        member(numeral(j2), segment(n)) iff less_than(j2, n)
                                        [using specialize numeralInSegment(n, j2)]
                                      @previous-in |
                                        member(numeral(j2), segment(n))
                                        [using tautology previous-membership j2-in-range]
                                      @previous-in-and-hits |
                                        member(numeral(j2), segment(n)) and apply(rho, numeral(j2)) = y
                                        [by and_intro previous-in previous-hits-y]
                                      @conclusion-witness-previous |
                                        exists x: Element; member(x, segment(n)) and apply(rho, x) = y
                                        [by exists_intro(numeral(j2)) previous-in-and-hits]
                                    }
                                  @conclusion-when-succ |
                                    exists x: Element; member(x, segment(n)) and apply(rho, x) = y
                                    [by exists_elim with-predecessor-j2]
                                }
                            }
                        }
                      @conclusion-y-is-hit-at-y |
                        exists x: Element; member(x, segment(n)) and apply(rho, x) = y
                        [by exists_elim with-index-j]
                    }
                  @conclusion-covers-at-y |
                    member(y, segment(n)) -> exists x: Element; member(x, segment(n)) and apply(rho, x) = y
                    [by implies_intro given-y-in]
                }
              @covers |
                forall y: Element; member(y, segment(n)) -> exists x: Element; member(x, segment(n)) and apply(rho, x) = y
                [by forall_intro generalize-y]
              @conclusion-rho-permutes |
                permutesTheSegment(rho, n)
                [using tautology rho-invertible maps-into injective-on covers fixes-outside]
            }
          @conclusion-at-n |
            isTheRotation(rho, n) -> permutesTheSegment(rho, n)
            [by implies_intro given-rotation]
        }
      @discharge-n |
        forall n: Nat; isTheRotation(rho, n) -> permutesTheSegment(rho, n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall rho: Fn; forall n: Nat; isTheRotation(rho, n) -> permutesTheSegment(rho, n)
    [by forall_intro generalize-rho]
qed

// ρ^k sends letter 0 to letter k, for k below n: induction on k, advancing one letter each step.
theorem rotationPowerAtZero: forall rho: Fn; forall n: Nat; isTheRotation(rho, n) ->
  forall k: Nat; less_than(k, n) -> apply(power(rho, k), numeral(ZERO)) = numeral(k)
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-n |
        fix n: Nat {
          @given-rotation |
            assume isTheRotation(rho, n) {
              @rotation |
                isTheRotation(rho, n)
                [by hypothesis given-rotation]
              @advances |
                forall i: Nat; less_than(succ(i), n) -> apply(rho, numeral(i)) = numeral(succ(i))
                [using tautology rotation]
              @zeroth-power |
                power(rho, ZERO) = identityFn
                [using specialize powerZero(rho)]
              @identity-at-zero |
                apply(identityFn, numeral(ZERO)) = numeral(ZERO)
                [using specialize identityApply(numeral(ZERO))]
              @zeroth-power-at-zero |
                apply(power(rho, ZERO), numeral(ZERO)) = numeral(ZERO)
                [by rewrite zeroth-power identity-at-zero]
              @base-case |
                less_than(ZERO, n) -> apply(power(rho, ZERO), numeral(ZERO)) = numeral(ZERO)
                [using tautology zeroth-power-at-zero]
              @induction-step |
                fix k: Nat {
                  @given-inductive-hypothesis |
                    assume less_than(k, n) -> apply(power(rho, k), numeral(ZERO)) = numeral(k) {
                      @inductive-hypothesis |
                        less_than(k, n) -> apply(power(rho, k), numeral(ZERO)) = numeral(k)
                        [by hypothesis given-inductive-hypothesis]
                      @given-succ-k-in-range |
                        assume less_than(succ(k), n) {
                          @succ-k-in-range |
                            less_than(succ(k), n)
                            [by hypothesis given-succ-k-in-range]
                          @k-below-succ-k |
                            less_than(k, succ(k))
                            [using specialize lessThanSelf(k)]
                          @k-in-range |
                            less_than(k, n)
                            [using specialize lessThanTransitive(k, succ(k), n) k-below-succ-k succ-k-in-range]
                          @power-k-at-zero |
                            apply(power(rho, k), numeral(ZERO)) = numeral(k)
                            [by modus_ponens inductive-hypothesis k-in-range]
                          @next-power |
                            power(rho, succ(k)) = compose(rho, power(rho, k))
                            [using specialize powerSucc(rho, k)]
                          @composite-at-zero |
                            apply(compose(rho, power(rho, k)), numeral(ZERO)) = apply(rho, apply(power(rho, k), numeral(ZERO)))
                            [using specialize composeApply(rho, power(rho, k), numeral(ZERO))]
                          @composite-at-zero-via-k |
                            apply(compose(rho, power(rho, k)), numeral(ZERO)) = apply(rho, numeral(k))
                            [by rewrite power-k-at-zero composite-at-zero]
                          @k-advances |
                            apply(rho, numeral(k)) = numeral(succ(k))
                            [using specialize advances(k) succ-k-in-range]
                          @composite-at-zero-is-succ-k |
                            apply(compose(rho, power(rho, k)), numeral(ZERO)) = numeral(succ(k))
                            [using chain composite-at-zero-via-k k-advances]
                          @conclusion-step |
                            apply(power(rho, succ(k)), numeral(ZERO)) = numeral(succ(k))
                            [by rewrite next-power composite-at-zero-is-succ-k]
                        }
                      @conclusion-step-clause |
                        less_than(succ(k), n) -> apply(power(rho, succ(k)), numeral(ZERO)) = numeral(succ(k))
                        [by implies_intro given-succ-k-in-range]
                    }
                  @induction-step-at-k |
                    (less_than(k, n) -> apply(power(rho, k), numeral(ZERO)) = numeral(k)) -> (less_than(succ(k), n) -> apply(power(rho, succ(k)), numeral(ZERO)) = numeral(succ(k)))
                    [by implies_intro given-inductive-hypothesis]
                }
              @induction-step-for-all-k |
                forall k: Nat; (less_than(k, n) -> apply(power(rho, k), numeral(ZERO)) = numeral(k)) -> (less_than(succ(k), n) -> apply(power(rho, succ(k)), numeral(ZERO)) = numeral(succ(k)))
                [by forall_intro induction-step]
              @conclusion-for-all-k |
                forall k: Nat; less_than(k, n) -> apply(power(rho, k), numeral(ZERO)) = numeral(k)
                [using instantiation induction((fun k: Nat => less_than(k, n) -> apply(power(rho, k), numeral(ZERO)) = numeral(k))) base-case induction-step-for-all-k]
            }
          @conclusion-at-n |
            isTheRotation(rho, n) -> forall k: Nat; less_than(k, n) -> apply(power(rho, k), numeral(ZERO)) = numeral(k)
            [by implies_intro given-rotation]
        }
      @discharge-n |
        forall n: Nat; isTheRotation(rho, n) -> forall k: Nat; less_than(k, n) -> apply(power(rho, k), numeral(ZERO)) = numeral(k)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall rho: Fn; forall n: Nat; isTheRotation(rho, n) ->
      forall k: Nat; less_than(k, n) -> apply(power(rho, k), numeral(ZERO)) = numeral(k)
    [by forall_intro generalize-rho]
qed

// ρ⁻¹ sends letter i+1 back to letter i, and letter 0 back to the last letter.
theorem rotationUndoesAdvance: forall rho: Fn; forall n: Nat; isTheRotation(rho, n) ->
  forall i: Nat; less_than(succ(i), n) -> apply(inverse(rho), numeral(succ(i))) = numeral(i)
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-n |
        fix n: Nat {
          @given-rotation |
            assume isTheRotation(rho, n) {
              @rotation |
                isTheRotation(rho, n)
                [by hypothesis given-rotation]
              @rho-invertible |
                invertible(rho)
                [using tautology rotation]
              @advances |
                forall i: Nat; less_than(succ(i), n) -> apply(rho, numeral(i)) = numeral(succ(i))
                [using tautology rotation]
              @generalize-i |
                fix i: Nat {
                  @given-succ-i-in-range |
                    assume less_than(succ(i), n) {
                      @succ-i-in-range |
                        less_than(succ(i), n)
                        [by hypothesis given-succ-i-in-range]
                      @i-advances |
                        apply(rho, numeral(i)) = numeral(succ(i))
                        [using specialize advances(i) succ-i-in-range]
                      @inverse-undoes |
                        apply(inverse(rho), apply(rho, numeral(i))) = numeral(i)
                        [using specialize inverseUndoesPermutation(rho, numeral(i))]
                      @conclusion-undone |
                        apply(inverse(rho), numeral(succ(i))) = numeral(i)
                        [by rewrite i-advances inverse-undoes]
                    }
                  @conclusion-undo-clause |
                    less_than(succ(i), n) -> apply(inverse(rho), numeral(succ(i))) = numeral(i)
                    [by implies_intro given-succ-i-in-range]
                }
              @discharge-i |
                forall i: Nat; less_than(succ(i), n) -> apply(inverse(rho), numeral(succ(i))) = numeral(i)
                [by forall_intro generalize-i]
            }
          @conclusion-at-n |
            isTheRotation(rho, n) -> forall i: Nat; less_than(succ(i), n) -> apply(inverse(rho), numeral(succ(i))) = numeral(i)
            [by implies_intro given-rotation]
        }
      @discharge-n |
        forall n: Nat; isTheRotation(rho, n) -> forall i: Nat; less_than(succ(i), n) -> apply(inverse(rho), numeral(succ(i))) = numeral(i)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall rho: Fn; forall n: Nat; isTheRotation(rho, n) ->
      forall i: Nat; less_than(succ(i), n) -> apply(inverse(rho), numeral(succ(i))) = numeral(i)
    [by forall_intro generalize-rho]
qed

theorem rotationUndoesWrap: forall rho: Fn; forall n: Nat; isTheRotation(rho, n) ->
  forall m: Nat; n = succ(m) -> apply(inverse(rho), numeral(ZERO)) = numeral(m)
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-n |
        fix n: Nat {
          @given-rotation |
            assume isTheRotation(rho, n) {
              @rotation |
                isTheRotation(rho, n)
                [by hypothesis given-rotation]
              @rho-invertible |
                invertible(rho)
                [using tautology rotation]
              @wraps |
                forall m: Nat; n = succ(m) -> apply(rho, numeral(m)) = numeral(ZERO)
                [using tautology rotation]
              @generalize-m |
                fix m: Nat {
                  @given-n-is-succ-m |
                    assume n = succ(m) {
                      @n-is-succ-m |
                        n = succ(m)
                        [by hypothesis given-n-is-succ-m]
                      @m-wraps |
                        apply(rho, numeral(m)) = numeral(ZERO)
                        [using specialize wraps(m) n-is-succ-m]
                      @inverse-undoes |
                        apply(inverse(rho), apply(rho, numeral(m))) = numeral(m)
                        [using specialize inverseUndoesPermutation(rho, numeral(m))]
                      @conclusion-undone |
                        apply(inverse(rho), numeral(ZERO)) = numeral(m)
                        [by rewrite m-wraps inverse-undoes]
                    }
                  @conclusion-undo-clause |
                    n = succ(m) -> apply(inverse(rho), numeral(ZERO)) = numeral(m)
                    [by implies_intro given-n-is-succ-m]
                }
              @discharge-m |
                forall m: Nat; n = succ(m) -> apply(inverse(rho), numeral(ZERO)) = numeral(m)
                [by forall_intro generalize-m]
            }
          @conclusion-at-n |
            isTheRotation(rho, n) -> forall m: Nat; n = succ(m) -> apply(inverse(rho), numeral(ZERO)) = numeral(m)
            [by implies_intro given-rotation]
        }
      @discharge-n |
        forall n: Nat; isTheRotation(rho, n) -> forall m: Nat; n = succ(m) -> apply(inverse(rho), numeral(ZERO)) = numeral(m)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall rho: Fn; forall n: Nat; isTheRotation(rho, n) ->
      forall m: Nat; n = succ(m) -> apply(inverse(rho), numeral(ZERO)) = numeral(m)
    [by forall_intro generalize-rho]
qed

// -- complements of letters ---------------------------------------------------------------------
//
// The reflection sends letter i to letter n - i. The arithmetic of that complement, from the
// gap d with n = i + (d + 1).

theorem subOfGap: forall i: Nat; forall d: Nat; sub(add(i, succ(d)), i) = succ(d)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-d |
        fix d: Nat {
          @commuted |
            add(i, succ(d)) = add(succ(d), i)
            [using specialize addIsCommutative(i, succ(d))]
          @cancelled |
            sub(add(succ(d), i), i) = succ(d)
            [using specialize subAddCancel(succ(d), i)]
          @conclusion-gap |
            sub(add(i, succ(d)), i) = succ(d)
            [by rewrite commuted cancelled]
        }
      @discharge-d |
        forall d: Nat; sub(add(i, succ(d)), i) = succ(d)
        [by forall_intro generalize-d]
    }
  @conclusion |
    forall i: Nat; forall d: Nat; sub(add(i, succ(d)), i) = succ(d)
    [by forall_intro generalize-i]
qed

// The complement of a letter below n is positive, and below n when the letter is positive.
theorem complementIsPositive: forall i: Nat; forall n: Nat; less_than(i, n) -> less_than(ZERO, sub(n, i))
proof
  @generalize-i |
    fix i: Nat {
      @generalize-n |
        fix n: Nat {
          @given-below |
            assume less_than(i, n) {
              @below |
                less_than(i, n)
                [by hypothesis given-below]
              @gap-exists |
                exists d: Nat; add(i, succ(d)) = n
                [using specialize lessThanElim(i, n) below]
              @with-gap-d |
                unpack d: Nat from gap-exists {
                  @gap |
                    add(i, succ(d)) = n
                    [by hypothesis with-gap-d]
                  @complement-of-the-sum |
                    sub(add(i, succ(d)), i) = succ(d)
                    [using specialize subOfGap(i, d)]
                  @complement |
                    sub(n, i) = succ(d)
                    [by rewrite gap complement-of-the-sum]
                  @zero-below-succ-d |
                    less_than(ZERO, succ(d))
                    [using specialize zeroBelowSucc(d)]
                  @conclusion-positive |
                    less_than(ZERO, sub(n, i))
                    [by rewrite complement zero-below-succ-d]
                }
              @conclusion-positive-at-d |
                less_than(ZERO, sub(n, i))
                [by exists_elim with-gap-d]
            }
          @conclusion-at-n |
            less_than(i, n) -> less_than(ZERO, sub(n, i))
            [by implies_intro given-below]
        }
      @discharge-n |
        forall n: Nat; less_than(i, n) -> less_than(ZERO, sub(n, i))
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall i: Nat; forall n: Nat; less_than(i, n) -> less_than(ZERO, sub(n, i))
    [by forall_intro generalize-i]
qed

theorem complementIsBelow: forall i: Nat; forall n: Nat; less_than(ZERO, i) -> less_than(i, n) -> less_than(sub(n, i), n)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-n |
        fix n: Nat {
          @given-positive |
            assume less_than(ZERO, i) {
              @given-below |
                assume less_than(i, n) {
                  @positive |
                    less_than(ZERO, i)
                    [by hypothesis given-positive]
                  @below |
                    less_than(i, n)
                    [by hypothesis given-below]
                  @below-succ |
                    less_than(i, succ(n))
                    [using specialize lessThanSuccRight(i, n) below]
                  @conclusion-complement-below |
                    less_than(sub(n, i), n)
                    [using specialize subStrictlyDecreases(i, n) positive below-succ]
                }
              @conclusion-given-below |
                less_than(i, n) -> less_than(sub(n, i), n)
                [by implies_intro given-below]
            }
          @conclusion-at-n |
            less_than(ZERO, i) -> less_than(i, n) -> less_than(sub(n, i), n)
            [by implies_intro given-positive]
        }
      @discharge-n |
        forall n: Nat; less_than(ZERO, i) -> less_than(i, n) -> less_than(sub(n, i), n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall i: Nat; forall n: Nat; less_than(ZERO, i) -> less_than(i, n) -> less_than(sub(n, i), n)
    [by forall_intro generalize-i]
qed

// Complementing twice gives the letter back.
theorem complementOfComplement: forall i: Nat; forall n: Nat; less_than(i, n) -> sub(n, sub(n, i)) = i
proof
  @generalize-i |
    fix i: Nat {
      @generalize-n |
        fix n: Nat {
          @given-below |
            assume less_than(i, n) {
              @below |
                less_than(i, n)
                [by hypothesis given-below]
              @gap-exists |
                exists d: Nat; add(i, succ(d)) = n
                [using specialize lessThanElim(i, n) below]
              @with-gap-d |
                unpack d: Nat from gap-exists {
                  @gap |
                    add(i, succ(d)) = n
                    [by hypothesis with-gap-d]
                  @complement-of-the-sum |
                    sub(add(i, succ(d)), i) = succ(d)
                    [using specialize subOfGap(i, d)]
                  @complement |
                    sub(n, i) = succ(d)
                    [by rewrite gap complement-of-the-sum]
                  @cancelled |
                    sub(add(i, succ(d)), succ(d)) = i
                    [using specialize subAddCancel(i, succ(d))]
                  @complement-of-succ-d |
                    sub(n, succ(d)) = i
                    [by rewrite gap cancelled]
                  @conclusion-twice |
                    sub(n, sub(n, i)) = i
                    [by rewrite complement complement-of-succ-d]
                }
              @conclusion-twice-at-d |
                sub(n, sub(n, i)) = i
                [by exists_elim with-gap-d]
            }
          @conclusion-at-n |
            less_than(i, n) -> sub(n, sub(n, i)) = i
            [by implies_intro given-below]
        }
      @discharge-n |
        forall n: Nat; less_than(i, n) -> sub(n, sub(n, i)) = i
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall i: Nat; forall n: Nat; less_than(i, n) -> sub(n, sub(n, i)) = i
    [by forall_intro generalize-i]
qed

// The complement of i+1 is one below the complement of i.
theorem complementOfSuccessor: forall i: Nat; forall n: Nat; less_than(succ(i), n) -> succ(sub(n, succ(i))) = sub(n, i)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-n |
        fix n: Nat {
          @given-below |
            assume less_than(succ(i), n) {
              @below |
                less_than(succ(i), n)
                [by hypothesis given-below]
              @gap-exists |
                exists d: Nat; add(succ(i), succ(d)) = n
                [using specialize lessThanElim(succ(i), n) below]
              @with-gap-d |
                unpack d: Nat from gap-exists {
                  @gap |
                    add(succ(i), succ(d)) = n
                    [by hypothesis with-gap-d]
                  @complement-of-the-sum |
                    sub(add(succ(i), succ(d)), succ(i)) = succ(d)
                    [using specialize subOfGap(succ(i), d)]
                  @complement-of-succ-i |
                    sub(n, succ(i)) = succ(d)
                    [by rewrite gap complement-of-the-sum]
                  @succ-pushed-out |
                    add(succ(i), succ(d)) = succ(add(i, succ(d)))
                    [using specialize addSuccLeft(i, succ(d))]
                  @succ-pulled-in |
                    add(i, succ(succ(d))) = succ(add(i, succ(d)))
                    [using specialize addSuccRight(i, succ(d))]
                  @gap-from-i |
                    add(i, succ(succ(d))) = add(succ(i), succ(d))
                    [by rewrite succ-pushed-out succ-pulled-in]
                  @gap-from-i-is-n |
                    add(i, succ(succ(d))) = n
                    [using chain gap-from-i gap]
                  @complement-of-the-longer-sum |
                    sub(add(i, succ(succ(d))), i) = succ(succ(d))
                    [using specialize subOfGap(i, succ(d))]
                  @complement-of-i |
                    sub(n, i) = succ(succ(d))
                    [by rewrite gap-from-i-is-n complement-of-the-longer-sum]
                  @complement-of-i-flipped |
                    succ(succ(d)) = sub(n, i)
                    [by symmetry complement-of-i]
                  @conclusion-shifted |
                    succ(sub(n, succ(i))) = sub(n, i)
                    [by rewrite complement-of-succ-i complement-of-i-flipped]
                }
              @conclusion-shifted-at-d |
                succ(sub(n, succ(i))) = sub(n, i)
                [by exists_elim with-gap-d]
            }
          @conclusion-at-n |
            less_than(succ(i), n) -> succ(sub(n, succ(i))) = sub(n, i)
            [by implies_intro given-below]
        }
      @discharge-n |
        forall n: Nat; less_than(succ(i), n) -> succ(sub(n, succ(i))) = sub(n, i)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall i: Nat; forall n: Nat; less_than(succ(i), n) -> succ(sub(n, succ(i))) = sub(n, i)
    [by forall_intro generalize-i]
qed

// The complement of letter 1 is the last letter.
theorem complementOfOne: forall m: Nat; sub(succ(m), succ(ZERO)) = m
proof
  @generalize-m |
    fix m: Nat {
      @both-successors |
        sub(succ(m), succ(ZERO)) = sub(m, ZERO)
        [using specialize subSuccSucc(m, ZERO)]
      @minus-zero |
        sub(m, ZERO) = m
        [using specialize subZeroRight(m)]
      @conclusion-last |
        sub(succ(m), succ(ZERO)) = m
        [using chain both-successors minus-zero]
    }
  @conclusion |
    forall m: Nat; sub(succ(m), succ(ZERO)) = m
    [by forall_intro generalize-m]
qed

// -- the reflection -----------------------------------------------------------------------------

// σ IS THE REFLECTION of the n-gon fixing letter 0: invertible, fixes 0, sends letter i to
// letter n - i (0 < i < n), and fixes everything outside the segment.
define isTheReflection(sigma, n) =
  invertible(sigma)
  and apply(sigma, numeral(ZERO)) = numeral(ZERO)
  and (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(sigma, numeral(i)) = numeral(sub(n, i)))
  and (forall x: Element; (not member(x, segment(n))) -> apply(sigma, x) = x)

// Its graph, for the definite description: letter 0 stays, a positive letter goes to its
// complement, anything outside the segment stays.
define reflectionSpec(n, x, y) =
  (x = numeral(ZERO) and y = numeral(ZERO))
  or (exists i: Nat; less_than(ZERO, i) and less_than(i, n) and x = numeral(i) and y = numeral(sub(n, i)))
  or ((not member(x, segment(n))) and y = x)

// The spec is TOTAL and SINGLE-VALUED: a letter is 0 or positive, or the point is outside.
theorem reflectionSpecIsTotalAndSingleValued: forall n: Nat; forall x: Element;
  exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-x |
        fix x: Element {
          @x-in-or-out |
            member(x, segment(n)) or (not member(x, segment(n)))
            [using tautology]
          @conclusion-unique-image |
            exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
            case x-in-or-out {
              @when-x-in |
                assume member(x, segment(n)) {
                  @x-in |
                    member(x, segment(n))
                    [by hypothesis when-x-in]
                  @x-membership |
                    member(x, segment(n)) iff (exists i: Nat; less_than(i, n) and x = numeral(i))
                    [using specialize segmentMember(n, x)]
                  @x-is-a-letter |
                    exists i: Nat; less_than(i, n) and x = numeral(i)
                    [using tautology x-membership x-in]
                  @with-index-i |
                    unpack i: Nat from x-is-a-letter {
                      @letter-facts |
                        less_than(i, n) and x = numeral(i)
                        [by hypothesis with-index-i]
                      @i-in-range |
                        less_than(i, n)
                        [by and_elim_left letter-facts]
                      @x-is-letter-i |
                        x = numeral(i)
                        [by and_elim_right letter-facts]
                      @i-zero-or-succ |
                        i = ZERO or (exists i2: Nat; i = succ(i2))
                        [using specialize zeroOrSucc(i)]
                      @conclusion-unique-image-at-i |
                        exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
                        case i-zero-or-succ {
                          @when-zero |
                            assume i = ZERO {
                              @i-is-zero |
                                i = ZERO
                                [by hypothesis when-zero]
                              @x-is-zero |
                                x = numeral(ZERO)
                                [by rewrite i-is-zero x-is-letter-i]
                              @zero-is-itself |
                                numeral(ZERO) = numeral(ZERO)
                                [by reflexivity]
                              @spec-holds |
                                reflectionSpec(n, x, numeral(ZERO))
                                [using tautology x-is-zero zero-is-itself]
                              @generalize-y2 |
                                fix y2: Element {
                                  @given-spec-at-y2 |
                                    assume reflectionSpec(n, x, y2) {
                                      @spec-at-y2 |
                                        reflectionSpec(n, x, y2)
                                        [by hypothesis given-spec-at-y2]
                                      @conclusion-y2-is-zero |
                                        numeral(ZERO) = y2
                                        case spec-at-y2 {
                                          @when-stays |
                                            assume x = numeral(ZERO) and y2 = numeral(ZERO) {
                                              @stays |
                                                x = numeral(ZERO) and y2 = numeral(ZERO)
                                                [by hypothesis when-stays]
                                              @y2-is-zero |
                                                y2 = numeral(ZERO)
                                                [by and_elim_right stays]
                                              @conclusion-when-stays |
                                                numeral(ZERO) = y2
                                                [by symmetry y2-is-zero]
                                            }
                                          @when-complemented |
                                            assume exists i2: Nat; less_than(ZERO, i2) and less_than(i2, n) and x = numeral(i2) and y2 = numeral(sub(n, i2)) {
                                              @complemented-exists |
                                                exists i2: Nat; less_than(ZERO, i2) and less_than(i2, n) and x = numeral(i2) and y2 = numeral(sub(n, i2))
                                                [by hypothesis when-complemented]
                                              @with-index-i2 |
                                                unpack i2: Nat from complemented-exists {
                                                  @complemented-facts |
                                                    less_than(ZERO, i2) and less_than(i2, n) and x = numeral(i2) and y2 = numeral(sub(n, i2))
                                                    [by hypothesis with-index-i2]
                                                  @i2-positive |
                                                    less_than(ZERO, i2)
                                                    [using tautology complemented-facts]
                                                  @x-is-letter-i2 |
                                                    x = numeral(i2)
                                                    [using tautology complemented-facts]
                                                  @letters-agree |
                                                    numeral(ZERO) = numeral(i2)
                                                    [by rewrite x-is-zero x-is-letter-i2]
                                                  @i2-is-zero |
                                                    ZERO = i2
                                                    [using specialize numeralInjective(ZERO, i2) letters-agree]
                                                  @zero-positive |
                                                    less_than(ZERO, ZERO)
                                                    [by rewrite i2-is-zero i2-positive]
                                                  @zero-not-positive |
                                                    not less_than(ZERO, ZERO)
                                                    [using specialize lessThanIrreflexive(ZERO)]
                                                  @conclusion-complemented-absurd |
                                                    numeral(ZERO) = y2
                                                    [by absurd zero-positive zero-not-positive]
                                                }
                                              @conclusion-when-complemented |
                                                numeral(ZERO) = y2
                                                [by exists_elim with-index-i2]
                                            }
                                          @when-outside |
                                            assume (not member(x, segment(n))) and y2 = x {
                                              @outside |
                                                (not member(x, segment(n))) and y2 = x
                                                [by hypothesis when-outside]
                                              @x-out |
                                                not member(x, segment(n))
                                                [by and_elim_left outside]
                                              @conclusion-outside-absurd |
                                                numeral(ZERO) = y2
                                                [by absurd x-in x-out]
                                            }
                                        }
                                    }
                                  @conclusion-uniqueness-clause |
                                    reflectionSpec(n, x, y2) -> numeral(ZERO) = y2
                                    [by implies_intro given-spec-at-y2]
                                }
                              @image-is-unique |
                                forall y2: Element; reflectionSpec(n, x, y2) -> numeral(ZERO) = y2
                                [by forall_intro generalize-y2]
                              @spec-and-unique |
                                reflectionSpec(n, x, numeral(ZERO)) and (forall y2: Element; reflectionSpec(n, x, y2) -> numeral(ZERO) = y2)
                                [by and_intro spec-holds image-is-unique]
                              @conclusion-when-letter-zero |
                                exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
                                [by exists_intro(numeral(ZERO)) spec-and-unique]
                            }
                          @when-succ |
                            assume exists i2: Nat; i = succ(i2) {
                              @predecessor-exists |
                                exists i2: Nat; i = succ(i2)
                                [by hypothesis when-succ]
                              @with-predecessor-i2 |
                                unpack i2: Nat from predecessor-exists {
                                  @i-is-succ |
                                    i = succ(i2)
                                    [by hypothesis with-predecessor-i2]
                                  @zero-below-succ-i2 |
                                    less_than(ZERO, succ(i2))
                                    [using specialize zeroBelowSucc(i2)]
                                  @i-positive |
                                    less_than(ZERO, i)
                                    [by rewrite i-is-succ zero-below-succ-i2]
                                  @complement-is-itself |
                                    numeral(sub(n, i)) = numeral(sub(n, i))
                                    [by reflexivity]
                                  @complemented-facts |
                                    less_than(ZERO, i) and less_than(i, n) and x = numeral(i) and numeral(sub(n, i)) = numeral(sub(n, i))
                                    [using tautology i-positive i-in-range x-is-letter-i complement-is-itself]
                                  @complemented-witness |
                                    exists i3: Nat; less_than(ZERO, i3) and less_than(i3, n) and x = numeral(i3) and numeral(sub(n, i)) = numeral(sub(n, i3))
                                    [by exists_intro(i) complemented-facts]
                                  @spec-holds |
                                    reflectionSpec(n, x, numeral(sub(n, i)))
                                    [using tautology complemented-witness]
                                  @generalize-y2 |
                                    fix y2: Element {
                                      @given-spec-at-y2 |
                                        assume reflectionSpec(n, x, y2) {
                                          @spec-at-y2 |
                                            reflectionSpec(n, x, y2)
                                            [by hypothesis given-spec-at-y2]
                                          @conclusion-y2-is-the-complement |
                                            numeral(sub(n, i)) = y2
                                            case spec-at-y2 {
                                              @when-stays |
                                                assume x = numeral(ZERO) and y2 = numeral(ZERO) {
                                                  @stays |
                                                    x = numeral(ZERO) and y2 = numeral(ZERO)
                                                    [by hypothesis when-stays]
                                                  @x-is-zero |
                                                    x = numeral(ZERO)
                                                    [by and_elim_left stays]
                                                  @letters-agree |
                                                    numeral(i) = numeral(ZERO)
                                                    [by rewrite x-is-letter-i x-is-zero]
                                                  @i-is-zero |
                                                    i = ZERO
                                                    [using specialize numeralInjective(i, ZERO) letters-agree]
                                                  @zero-positive |
                                                    less_than(ZERO, ZERO)
                                                    [by rewrite i-is-zero i-positive]
                                                  @zero-not-positive |
                                                    not less_than(ZERO, ZERO)
                                                    [using specialize lessThanIrreflexive(ZERO)]
                                                  @conclusion-stays-absurd |
                                                    numeral(sub(n, i)) = y2
                                                    [by absurd zero-positive zero-not-positive]
                                                }
                                              @when-complemented |
                                                assume exists i3: Nat; less_than(ZERO, i3) and less_than(i3, n) and x = numeral(i3) and y2 = numeral(sub(n, i3)) {
                                                  @complemented-exists |
                                                    exists i3: Nat; less_than(ZERO, i3) and less_than(i3, n) and x = numeral(i3) and y2 = numeral(sub(n, i3))
                                                    [by hypothesis when-complemented]
                                                  @with-index-i3 |
                                                    unpack i3: Nat from complemented-exists {
                                                      @complemented-facts-at-i3 |
                                                        less_than(ZERO, i3) and less_than(i3, n) and x = numeral(i3) and y2 = numeral(sub(n, i3))
                                                        [by hypothesis with-index-i3]
                                                      @x-is-letter-i3 |
                                                        x = numeral(i3)
                                                        [using tautology complemented-facts-at-i3]
                                                      @y2-is-complement-of-i3 |
                                                        y2 = numeral(sub(n, i3))
                                                        [using tautology complemented-facts-at-i3]
                                                      @letters-agree |
                                                        numeral(i) = numeral(i3)
                                                        [by rewrite x-is-letter-i x-is-letter-i3]
                                                      @indices-agree |
                                                        i = i3
                                                        [using specialize numeralInjective(i, i3) letters-agree]
                                                      @y2-is-complement-of-i |
                                                        y2 = numeral(sub(n, i))
                                                        [by rewrite indices-agree y2-is-complement-of-i3]
                                                      @conclusion-complements-agree |
                                                        numeral(sub(n, i)) = y2
                                                        [by symmetry y2-is-complement-of-i]
                                                    }
                                                  @conclusion-when-complemented |
                                                    numeral(sub(n, i)) = y2
                                                    [by exists_elim with-index-i3]
                                                }
                                              @when-outside |
                                                assume (not member(x, segment(n))) and y2 = x {
                                                  @outside |
                                                    (not member(x, segment(n))) and y2 = x
                                                    [by hypothesis when-outside]
                                                  @x-out |
                                                    not member(x, segment(n))
                                                    [by and_elim_left outside]
                                                  @conclusion-outside-absurd |
                                                    numeral(sub(n, i)) = y2
                                                    [by absurd x-in x-out]
                                                }
                                            }
                                        }
                                      @conclusion-uniqueness-clause |
                                        reflectionSpec(n, x, y2) -> numeral(sub(n, i)) = y2
                                        [by implies_intro given-spec-at-y2]
                                    }
                                  @image-is-unique |
                                    forall y2: Element; reflectionSpec(n, x, y2) -> numeral(sub(n, i)) = y2
                                    [by forall_intro generalize-y2]
                                  @spec-and-unique |
                                    reflectionSpec(n, x, numeral(sub(n, i))) and (forall y2: Element; reflectionSpec(n, x, y2) -> numeral(sub(n, i)) = y2)
                                    [by and_intro spec-holds image-is-unique]
                                  @conclusion-witness-complement |
                                    exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
                                    [by exists_intro(numeral(sub(n, i))) spec-and-unique]
                                }
                              @conclusion-when-positive-letter |
                                exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
                                [by exists_elim with-predecessor-i2]
                            }
                        }
                    }
                  @conclusion-when-in |
                    exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
                    [by exists_elim with-index-i]
                }
              @when-x-out |
                assume not member(x, segment(n)) {
                  @x-out |
                    not member(x, segment(n))
                    [by hypothesis when-x-out]
                  @x-is-itself |
                    x = x
                    [by reflexivity]
                  @spec-holds |
                    reflectionSpec(n, x, x)
                    [using tautology x-out x-is-itself]
                  @generalize-y2 |
                    fix y2: Element {
                      @given-spec-at-y2 |
                        assume reflectionSpec(n, x, y2) {
                          @spec-at-y2 |
                            reflectionSpec(n, x, y2)
                            [by hypothesis given-spec-at-y2]
                          @conclusion-y2-is-x |
                            x = y2
                            case spec-at-y2 {
                              @when-stays |
                                assume x = numeral(ZERO) and y2 = numeral(ZERO) {
                                  @stays |
                                    x = numeral(ZERO) and y2 = numeral(ZERO)
                                    [by hypothesis when-stays]
                                  @x-is-zero |
                                    x = numeral(ZERO)
                                    [by and_elim_left stays]
                                  @y2-is-zero |
                                    y2 = numeral(ZERO)
                                    [by and_elim_right stays]
                                  @conclusion-when-stays |
                                    x = y2
                                    [by rewrite y2-is-zero x-is-zero]
                                }
                              @when-complemented |
                                assume exists i2: Nat; less_than(ZERO, i2) and less_than(i2, n) and x = numeral(i2) and y2 = numeral(sub(n, i2)) {
                                  @complemented-exists |
                                    exists i2: Nat; less_than(ZERO, i2) and less_than(i2, n) and x = numeral(i2) and y2 = numeral(sub(n, i2))
                                    [by hypothesis when-complemented]
                                  @with-index-i2 |
                                    unpack i2: Nat from complemented-exists {
                                      @complemented-facts |
                                        less_than(ZERO, i2) and less_than(i2, n) and x = numeral(i2) and y2 = numeral(sub(n, i2))
                                        [by hypothesis with-index-i2]
                                      @i2-in-range |
                                        less_than(i2, n)
                                        [using tautology complemented-facts]
                                      @x-is-letter-i2 |
                                        x = numeral(i2)
                                        [using tautology complemented-facts]
                                      @letter-membership |
                                        member(numeral(i2), segment(n)) iff less_than(i2, n)
                                        [using specialize numeralInSegment(n, i2)]
                                      @letter-in |
                                        member(numeral(i2), segment(n))
                                        [using tautology letter-membership i2-in-range]
                                      @x-in |
                                        member(x, segment(n))
                                        [by rewrite x-is-letter-i2 letter-in]
                                      @conclusion-complemented-absurd |
                                        x = y2
                                        [by absurd x-in x-out]
                                    }
                                  @conclusion-when-complemented |
                                    x = y2
                                    [by exists_elim with-index-i2]
                                }
                              @when-outside |
                                assume (not member(x, segment(n))) and y2 = x {
                                  @outside |
                                    (not member(x, segment(n))) and y2 = x
                                    [by hypothesis when-outside]
                                  @y2-is-x |
                                    y2 = x
                                    [by and_elim_right outside]
                                  @conclusion-when-outside |
                                    x = y2
                                    [by symmetry y2-is-x]
                                }
                            }
                        }
                      @conclusion-uniqueness-clause |
                        reflectionSpec(n, x, y2) -> x = y2
                        [by implies_intro given-spec-at-y2]
                    }
                  @image-is-unique |
                    forall y2: Element; reflectionSpec(n, x, y2) -> x = y2
                    [by forall_intro generalize-y2]
                  @spec-and-unique |
                    reflectionSpec(n, x, x) and (forall y2: Element; reflectionSpec(n, x, y2) -> x = y2)
                    [by and_intro spec-holds image-is-unique]
                  @conclusion-when-out |
                    exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
                    [by exists_intro(x) spec-and-unique]
                }
            }
        }
      @discharge-x |
        forall x: Element; exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall n: Nat; forall x: Element;
      exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
    [by forall_intro generalize-n]
qed

// A map whose graph is the spec has the reflection's three values.
theorem reflectionSpecValues: forall n: Nat; forall g: Fn; (forall x: Element; reflectionSpec(n, x, apply(g, x))) ->
  (apply(g, numeral(ZERO)) = numeral(ZERO)
  and (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i)))
  and (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x))
proof
  @generalize-n |
    fix n: Nat {
      @generalize-g |
        fix g: Fn {
          @given-graph |
            assume forall x: Element; reflectionSpec(n, x, apply(g, x)) {
              @graph |
                forall x: Element; reflectionSpec(n, x, apply(g, x))
                [by hypothesis given-graph]

              // at letter 0
              @spec-at-zero |
                reflectionSpec(n, numeral(ZERO), apply(g, numeral(ZERO)))
                [using specialize graph(numeral(ZERO))]
              @fixes-zero |
                apply(g, numeral(ZERO)) = numeral(ZERO)
                case spec-at-zero {
                  @when-stays |
                    assume numeral(ZERO) = numeral(ZERO) and apply(g, numeral(ZERO)) = numeral(ZERO) {
                      @stays |
                        numeral(ZERO) = numeral(ZERO) and apply(g, numeral(ZERO)) = numeral(ZERO)
                        [by hypothesis when-stays]
                      @conclusion-when-stays |
                        apply(g, numeral(ZERO)) = numeral(ZERO)
                        [by and_elim_right stays]
                    }
                  @when-complemented |
                    assume exists i: Nat; less_than(ZERO, i) and less_than(i, n) and numeral(ZERO) = numeral(i) and apply(g, numeral(ZERO)) = numeral(sub(n, i)) {
                      @complemented-exists |
                        exists i: Nat; less_than(ZERO, i) and less_than(i, n) and numeral(ZERO) = numeral(i) and apply(g, numeral(ZERO)) = numeral(sub(n, i))
                        [by hypothesis when-complemented]
                      @with-index-i |
                        unpack i: Nat from complemented-exists {
                          @complemented-facts |
                            less_than(ZERO, i) and less_than(i, n) and numeral(ZERO) = numeral(i) and apply(g, numeral(ZERO)) = numeral(sub(n, i))
                            [by hypothesis with-index-i]
                          @i-positive |
                            less_than(ZERO, i)
                            [using tautology complemented-facts]
                          @letters-agree |
                            numeral(ZERO) = numeral(i)
                            [using tautology complemented-facts]
                          @i-is-zero |
                            ZERO = i
                            [using specialize numeralInjective(ZERO, i) letters-agree]
                          @zero-positive |
                            less_than(ZERO, ZERO)
                            [by rewrite i-is-zero i-positive]
                          @zero-not-positive |
                            not less_than(ZERO, ZERO)
                            [using specialize lessThanIrreflexive(ZERO)]
                          @conclusion-complemented-absurd |
                            apply(g, numeral(ZERO)) = numeral(ZERO)
                            [by absurd zero-positive zero-not-positive]
                        }
                      @conclusion-when-complemented |
                        apply(g, numeral(ZERO)) = numeral(ZERO)
                        [by exists_elim with-index-i]
                    }
                  @when-outside |
                    assume (not member(numeral(ZERO), segment(n))) and apply(g, numeral(ZERO)) = numeral(ZERO) {
                      @outside |
                        (not member(numeral(ZERO), segment(n))) and apply(g, numeral(ZERO)) = numeral(ZERO)
                        [by hypothesis when-outside]
                      @conclusion-when-outside |
                        apply(g, numeral(ZERO)) = numeral(ZERO)
                        [by and_elim_right outside]
                    }
                }

              // at a positive letter
              @generalize-i |
                fix i: Nat {
                  @given-positive |
                    assume less_than(ZERO, i) {
                      @given-in-range |
                        assume less_than(i, n) {
                          @positive |
                            less_than(ZERO, i)
                            [by hypothesis given-positive]
                          @in-range |
                            less_than(i, n)
                            [by hypothesis given-in-range]
                          @spec-at-i |
                            reflectionSpec(n, numeral(i), apply(g, numeral(i)))
                            [using specialize graph(numeral(i))]
                          @conclusion-complemented |
                            apply(g, numeral(i)) = numeral(sub(n, i))
                            case spec-at-i {
                              @when-stays |
                                assume numeral(i) = numeral(ZERO) and apply(g, numeral(i)) = numeral(ZERO) {
                                  @stays |
                                    numeral(i) = numeral(ZERO) and apply(g, numeral(i)) = numeral(ZERO)
                                    [by hypothesis when-stays]
                                  @letters-agree |
                                    numeral(i) = numeral(ZERO)
                                    [by and_elim_left stays]
                                  @i-is-zero |
                                    i = ZERO
                                    [using specialize numeralInjective(i, ZERO) letters-agree]
                                  @zero-positive |
                                    less_than(ZERO, ZERO)
                                    [by rewrite i-is-zero positive]
                                  @zero-not-positive |
                                    not less_than(ZERO, ZERO)
                                    [using specialize lessThanIrreflexive(ZERO)]
                                  @conclusion-stays-absurd |
                                    apply(g, numeral(i)) = numeral(sub(n, i))
                                    [by absurd zero-positive zero-not-positive]
                                }
                              @when-complemented |
                                assume exists i2: Nat; less_than(ZERO, i2) and less_than(i2, n) and numeral(i) = numeral(i2) and apply(g, numeral(i)) = numeral(sub(n, i2)) {
                                  @complemented-exists |
                                    exists i2: Nat; less_than(ZERO, i2) and less_than(i2, n) and numeral(i) = numeral(i2) and apply(g, numeral(i)) = numeral(sub(n, i2))
                                    [by hypothesis when-complemented]
                                  @with-index-i2 |
                                    unpack i2: Nat from complemented-exists {
                                      @complemented-facts |
                                        less_than(ZERO, i2) and less_than(i2, n) and numeral(i) = numeral(i2) and apply(g, numeral(i)) = numeral(sub(n, i2))
                                        [by hypothesis with-index-i2]
                                      @letters-agree |
                                        numeral(i) = numeral(i2)
                                        [using tautology complemented-facts]
                                      @image-is-complement-of-i2 |
                                        apply(g, numeral(i)) = numeral(sub(n, i2))
                                        [using tautology complemented-facts]
                                      @indices-agree |
                                        i = i2
                                        [using specialize numeralInjective(i, i2) letters-agree]
                                      @conclusion-complement-of-i |
                                        apply(g, numeral(i)) = numeral(sub(n, i))
                                        [by rewrite indices-agree image-is-complement-of-i2]
                                    }
                                  @conclusion-when-complemented |
                                    apply(g, numeral(i)) = numeral(sub(n, i))
                                    [by exists_elim with-index-i2]
                                }
                              @when-outside |
                                assume (not member(numeral(i), segment(n))) and apply(g, numeral(i)) = numeral(i) {
                                  @outside |
                                    (not member(numeral(i), segment(n))) and apply(g, numeral(i)) = numeral(i)
                                    [by hypothesis when-outside]
                                  @letter-out |
                                    not member(numeral(i), segment(n))
                                    [by and_elim_left outside]
                                  @letter-membership |
                                    member(numeral(i), segment(n)) iff less_than(i, n)
                                    [using specialize numeralInSegment(n, i)]
                                  @letter-in |
                                    member(numeral(i), segment(n))
                                    [using tautology letter-membership in-range]
                                  @conclusion-outside-absurd |
                                    apply(g, numeral(i)) = numeral(sub(n, i))
                                    [by absurd letter-in letter-out]
                                }
                            }
                        }
                      @conclusion-given-in-range |
                        less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))
                        [by implies_intro given-in-range]
                    }
                  @conclusion-complement-clause |
                    less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))
                    [by implies_intro given-positive]
                }
              @complements |
                forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))
                [by forall_intro generalize-i]

              // outside the segment
              @generalize-x |
                fix x: Element {
                  @given-x-out |
                    assume not member(x, segment(n)) {
                      @x-out |
                        not member(x, segment(n))
                        [by hypothesis given-x-out]
                      @spec-at-x |
                        reflectionSpec(n, x, apply(g, x))
                        [using specialize graph(x)]
                      @conclusion-x-fixed |
                        apply(g, x) = x
                        case spec-at-x {
                          @when-stays |
                            assume x = numeral(ZERO) and apply(g, x) = numeral(ZERO) {
                              @stays |
                                x = numeral(ZERO) and apply(g, x) = numeral(ZERO)
                                [by hypothesis when-stays]
                              @x-is-zero |
                                x = numeral(ZERO)
                                [by and_elim_left stays]
                              @image-is-zero |
                                apply(g, x) = numeral(ZERO)
                                [by and_elim_right stays]
                              @conclusion-when-stays |
                                apply(g, x) = x
                                [by rewrite x-is-zero image-is-zero]
                            }
                          @when-complemented |
                            assume exists i: Nat; less_than(ZERO, i) and less_than(i, n) and x = numeral(i) and apply(g, x) = numeral(sub(n, i)) {
                              @complemented-exists |
                                exists i: Nat; less_than(ZERO, i) and less_than(i, n) and x = numeral(i) and apply(g, x) = numeral(sub(n, i))
                                [by hypothesis when-complemented]
                              @with-index-i |
                                unpack i: Nat from complemented-exists {
                                  @complemented-facts |
                                    less_than(ZERO, i) and less_than(i, n) and x = numeral(i) and apply(g, x) = numeral(sub(n, i))
                                    [by hypothesis with-index-i]
                                  @i-in-range |
                                    less_than(i, n)
                                    [using tautology complemented-facts]
                                  @x-is-letter-i |
                                    x = numeral(i)
                                    [using tautology complemented-facts]
                                  @letter-membership |
                                    member(numeral(i), segment(n)) iff less_than(i, n)
                                    [using specialize numeralInSegment(n, i)]
                                  @letter-in |
                                    member(numeral(i), segment(n))
                                    [using tautology letter-membership i-in-range]
                                  @x-in |
                                    member(x, segment(n))
                                    [by rewrite x-is-letter-i letter-in]
                                  @conclusion-complemented-absurd |
                                    apply(g, x) = x
                                    [by absurd x-in x-out]
                                }
                              @conclusion-when-complemented |
                                apply(g, x) = x
                                [by exists_elim with-index-i]
                            }
                          @when-outside |
                            assume (not member(x, segment(n))) and apply(g, x) = x {
                              @outside |
                                (not member(x, segment(n))) and apply(g, x) = x
                                [by hypothesis when-outside]
                              @conclusion-when-outside |
                                apply(g, x) = x
                                [by and_elim_right outside]
                            }
                        }
                    }
                  @conclusion-fixes-clause |
                    (not member(x, segment(n))) -> apply(g, x) = x
                    [by implies_intro given-x-out]
                }
              @fixes-outside |
                forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x
                [by forall_intro generalize-x]
              @conclusion-values |
                apply(g, numeral(ZERO)) = numeral(ZERO) and (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))) and (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x)
                [using tautology fixes-zero complements fixes-outside]
            }
          @conclusion-at-g |
            (forall x: Element; reflectionSpec(n, x, apply(g, x))) -> (apply(g, numeral(ZERO)) = numeral(ZERO) and (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))) and (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x))
            [by implies_intro given-graph]
        }
      @discharge-g |
        forall g: Fn; (forall x: Element; reflectionSpec(n, x, apply(g, x))) -> (apply(g, numeral(ZERO)) = numeral(ZERO) and (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))) and (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x))
        [by forall_intro generalize-g]
    }
  @conclusion |
    forall n: Nat; forall g: Fn; (forall x: Element; reflectionSpec(n, x, apply(g, x))) ->
      (apply(g, numeral(ZERO)) = numeral(ZERO)
      and (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i)))
      and (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x))
    [by forall_intro generalize-n]
qed

// A map with the reflection's values undoes itself: the complement of the complement is the
// letter, and letter 0 and the outside are fixed.
theorem reflectionValuesInvolute: forall n: Nat; forall g: Fn;
  apply(g, numeral(ZERO)) = numeral(ZERO) ->
  (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))) ->
  (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x) ->
  forall x: Element; apply(g, apply(g, x)) = x
proof
  @generalize-n |
    fix n: Nat {
      @generalize-g |
        fix g: Fn {
          @given-fixes-zero |
            assume apply(g, numeral(ZERO)) = numeral(ZERO) {
              @given-complements |
                assume forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i)) {
                  @given-fixes-outside |
                    assume forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x {
                      @fixes-zero |
                        apply(g, numeral(ZERO)) = numeral(ZERO)
                        [by hypothesis given-fixes-zero]
                      @complements |
                        forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))
                        [by hypothesis given-complements]
                      @fixes-outside |
                        forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x
                        [by hypothesis given-fixes-outside]
                      @generalize-x |
                        fix x: Element {
                          @x-in-or-out |
                            member(x, segment(n)) or (not member(x, segment(n)))
                            [using tautology]
                          @conclusion-twice-is-identity |
                            apply(g, apply(g, x)) = x
                            case x-in-or-out {
                              @when-x-in |
                                assume member(x, segment(n)) {
                                  @x-in |
                                    member(x, segment(n))
                                    [by hypothesis when-x-in]
                                  @x-membership |
                                    member(x, segment(n)) iff (exists i: Nat; less_than(i, n) and x = numeral(i))
                                    [using specialize segmentMember(n, x)]
                                  @x-is-a-letter |
                                    exists i: Nat; less_than(i, n) and x = numeral(i)
                                    [using tautology x-membership x-in]
                                  @with-index-i |
                                    unpack i: Nat from x-is-a-letter {
                                      @letter-facts |
                                        less_than(i, n) and x = numeral(i)
                                        [by hypothesis with-index-i]
                                      @i-in-range |
                                        less_than(i, n)
                                        [by and_elim_left letter-facts]
                                      @x-is-letter-i |
                                        x = numeral(i)
                                        [by and_elim_right letter-facts]
                                      @i-zero-or-succ |
                                        i = ZERO or (exists i2: Nat; i = succ(i2))
                                        [using specialize zeroOrSucc(i)]
                                      @conclusion-twice-at-letter |
                                        apply(g, apply(g, x)) = x
                                        case i-zero-or-succ {
                                          @when-zero |
                                            assume i = ZERO {
                                              @i-is-zero |
                                                i = ZERO
                                                [by hypothesis when-zero]
                                              @x-is-zero |
                                                x = numeral(ZERO)
                                                [by rewrite i-is-zero x-is-letter-i]
                                              @twice-at-zero |
                                                apply(g, apply(g, numeral(ZERO))) = numeral(ZERO)
                                                [by rewrite fixes-zero fixes-zero]
                                              @conclusion-when-zero |
                                                apply(g, apply(g, x)) = x
                                                [by rewrite x-is-zero twice-at-zero]
                                            }
                                          @when-succ |
                                            assume exists i2: Nat; i = succ(i2) {
                                              @predecessor-exists |
                                                exists i2: Nat; i = succ(i2)
                                                [by hypothesis when-succ]
                                              @with-predecessor-i2 |
                                                unpack i2: Nat from predecessor-exists {
                                                  @i-is-succ |
                                                    i = succ(i2)
                                                    [by hypothesis with-predecessor-i2]
                                                  @zero-below-succ-i2 |
                                                    less_than(ZERO, succ(i2))
                                                    [using specialize zeroBelowSucc(i2)]
                                                  @i-positive |
                                                    less_than(ZERO, i)
                                                    [by rewrite i-is-succ zero-below-succ-i2]
                                                  @image-is-complement |
                                                    apply(g, numeral(i)) = numeral(sub(n, i))
                                                    [using specialize complements(i) i-positive i-in-range]
                                                  @complement-positive |
                                                    less_than(ZERO, sub(n, i))
                                                    [using specialize complementIsPositive(i, n) i-in-range]
                                                  @complement-below |
                                                    less_than(sub(n, i), n)
                                                    [using specialize complementIsBelow(i, n) i-positive i-in-range]
                                                  @image-of-complement |
                                                    apply(g, numeral(sub(n, i))) = numeral(sub(n, sub(n, i)))
                                                    [using specialize complements(sub(n, i)) complement-positive complement-below]
                                                  @complement-twice |
                                                    sub(n, sub(n, i)) = i
                                                    [using specialize complementOfComplement(i, n) i-in-range]
                                                  @image-of-complement-is-the-letter |
                                                    apply(g, numeral(sub(n, i))) = numeral(i)
                                                    [by rewrite complement-twice image-of-complement]
                                                  @twice-at-letter |
                                                    apply(g, apply(g, numeral(i))) = numeral(i)
                                                    [by rewrite image-is-complement image-of-complement-is-the-letter]
                                                  @conclusion-when-succ-at-i2 |
                                                    apply(g, apply(g, x)) = x
                                                    [by rewrite x-is-letter-i twice-at-letter]
                                                }
                                              @conclusion-when-succ |
                                                apply(g, apply(g, x)) = x
                                                [by exists_elim with-predecessor-i2]
                                            }
                                        }
                                    }
                                  @conclusion-when-in |
                                    apply(g, apply(g, x)) = x
                                    [by exists_elim with-index-i]
                                }
                              @when-x-out |
                                assume not member(x, segment(n)) {
                                  @x-out |
                                    not member(x, segment(n))
                                    [by hypothesis when-x-out]
                                  @x-fixed |
                                    apply(g, x) = x
                                    [using specialize fixes-outside(x) x-out]
                                  @conclusion-when-out |
                                    apply(g, apply(g, x)) = x
                                    [by rewrite x-fixed x-fixed]
                                }
                            }
                        }
                      @twice-is-identity |
                        forall x: Element; apply(g, apply(g, x)) = x
                        [by forall_intro generalize-x]
                    }
                  @conclusion-given-fixes-outside |
                    (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x) -> forall x: Element; apply(g, apply(g, x)) = x
                    [by implies_intro given-fixes-outside]
                }
              @conclusion-given-complements |
                (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))) -> (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x) -> forall x: Element; apply(g, apply(g, x)) = x
                [by implies_intro given-complements]
            }
          @conclusion-at-g |
            apply(g, numeral(ZERO)) = numeral(ZERO) -> (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))) -> (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x) -> forall x: Element; apply(g, apply(g, x)) = x
            [by implies_intro given-fixes-zero]
        }
      @discharge-g |
        forall g: Fn; apply(g, numeral(ZERO)) = numeral(ZERO) -> (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))) -> (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x) -> forall x: Element; apply(g, apply(g, x)) = x
        [by forall_intro generalize-g]
    }
  @conclusion |
    forall n: Nat; forall g: Fn;
      apply(g, numeral(ZERO)) = numeral(ZERO) ->
      (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))) ->
      (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x) ->
      forall x: Element; apply(g, apply(g, x)) = x
    [by forall_intro generalize-n]
qed

// A map that undoes itself is invertible (it is its own two-sided inverse).
theorem selfUndoingIsInvertible: forall g: Fn; (forall x: Element; apply(g, apply(g, x)) = x) -> invertible(g)
proof
  @generalize-g |
    fix g: Fn {
      @given-self-undoing |
        assume forall x: Element; apply(g, apply(g, x)) = x {
          @self-undoing |
            forall x: Element; apply(g, apply(g, x)) = x
            [by hypothesis given-self-undoing]
          @generalize-x |
            fix x: Element {
              @composite-at-x |
                apply(compose(g, g), x) = apply(g, apply(g, x))
                [using specialize composeApply(g, g, x)]
              @undone-at-x |
                apply(g, apply(g, x)) = x
                [using specialize self-undoing(x)]
              @identity-at-x |
                apply(identityFn, x) = x
                [using specialize identityApply(x)]
              @composite-is-x |
                apply(compose(g, g), x) = x
                [using chain composite-at-x undone-at-x]
              @conclusion-agree-at-x |
                apply(compose(g, g), x) = apply(identityFn, x)
                [by rewrite identity-at-x composite-is-x]
            }
          @composite-agrees-with-identity |
            forall x: Element; apply(compose(g, g), x) = apply(identityFn, x)
            [by forall_intro generalize-x]
          @composite-is-identity |
            compose(g, g) = identityFn
            [using specialize funcExtensionality(compose(g, g), identityFn) composite-agrees-with-identity]
          @two-sided |
            compose(g, g) = identityFn and compose(g, g) = identityFn
            [by and_intro composite-is-identity composite-is-identity]
          @inverse-exists |
            exists h: Fn; compose(h, g) = identityFn and compose(g, h) = identityFn
            [by exists_intro(g) two-sided]
          @invertibility |
            invertible(g) iff (exists h: Fn; compose(h, g) = identityFn and compose(g, h) = identityFn)
            [using specialize invertibleDef(g)]
          @conclusion-invertible |
            invertible(g)
            [using tautology invertibility inverse-exists]
        }
      @conclusion-at-g |
        (forall x: Element; apply(g, apply(g, x)) = x) -> invertible(g)
        [by implies_intro given-self-undoing]
    }
  @conclusion |
    forall g: Fn; (forall x: Element; apply(g, apply(g, x)) = x) -> invertible(g)
    [by forall_intro generalize-g]
qed

// The reflection exists: the map with the spec's graph, invertible since it undoes itself.
theorem reflectionExists: forall n: Nat; exists sigma: Fn; isTheReflection(sigma, n)
proof
  @generalize-n |
    fix n: Nat {
      @spec-total-and-single-valued |
        forall x: Element; exists y: Element; reflectionSpec(n, x, y) and (forall y2: Element; reflectionSpec(n, x, y2) -> y = y2)
        [using specialize reflectionSpecIsTotalAndSingleValued(n)]
      @map-exists |
        exists g: Fn; forall x: Element; reflectionSpec(n, x, apply(g, x))
        [using instantiation functionFromGraph(fun x, y: Element => reflectionSpec(n, x, y)) spec-total-and-single-valued]
      @with-map-g |
        unpack g: Fn from map-exists {
          @graph |
            forall x: Element; reflectionSpec(n, x, apply(g, x))
            [by hypothesis with-map-g]
          @values |
            apply(g, numeral(ZERO)) = numeral(ZERO) and (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))) and (forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x)
            [using specialize reflectionSpecValues(n, g) graph]
          @fixes-zero |
            apply(g, numeral(ZERO)) = numeral(ZERO)
            [using tautology values]
          @complements |
            forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(g, numeral(i)) = numeral(sub(n, i))
            [using tautology values]
          @fixes-outside |
            forall x: Element; (not member(x, segment(n))) -> apply(g, x) = x
            [using tautology values]
          @self-undoing |
            forall x: Element; apply(g, apply(g, x)) = x
            [using specialize reflectionValuesInvolute(n, g) fixes-zero complements fixes-outside]
          @g-invertible |
            invertible(g)
            [using specialize selfUndoingIsInvertible(g) self-undoing]
          @g-is-the-reflection |
            isTheReflection(g, n)
            [using tautology g-invertible fixes-zero complements fixes-outside]
          @conclusion-witness-g |
            exists sigma: Fn; isTheReflection(sigma, n)
            [by exists_intro(g) g-is-the-reflection]
        }
      @conclusion-reflection-exists |
        exists sigma: Fn; isTheReflection(sigma, n)
        [by exists_elim with-map-g]
    }
  @conclusion |
    forall n: Nat; exists sigma: Fn; isTheReflection(sigma, n)
    [by forall_intro generalize-n]
qed

// The reflection undoes itself.
theorem reflectionUndoesItself: forall sigma: Fn; forall n: Nat; isTheReflection(sigma, n) ->
  forall x: Element; apply(sigma, apply(sigma, x)) = x
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-n |
        fix n: Nat {
          @given-reflection |
            assume isTheReflection(sigma, n) {
              @reflection |
                isTheReflection(sigma, n)
                [by hypothesis given-reflection]
              @fixes-zero |
                apply(sigma, numeral(ZERO)) = numeral(ZERO)
                [using tautology reflection]
              @complements |
                forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(sigma, numeral(i)) = numeral(sub(n, i))
                [using tautology reflection]
              @fixes-outside |
                forall x: Element; (not member(x, segment(n))) -> apply(sigma, x) = x
                [using tautology reflection]
              @conclusion-self-undoing |
                forall x: Element; apply(sigma, apply(sigma, x)) = x
                [using specialize reflectionValuesInvolute(n, sigma) fixes-zero complements fixes-outside]
            }
          @conclusion-at-n |
            isTheReflection(sigma, n) -> forall x: Element; apply(sigma, apply(sigma, x)) = x
            [by implies_intro given-reflection]
        }
      @discharge-n |
        forall n: Nat; isTheReflection(sigma, n) -> forall x: Element; apply(sigma, apply(sigma, x)) = x
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall sigma: Fn; forall n: Nat; isTheReflection(sigma, n) -> forall x: Element; apply(sigma, apply(sigma, x)) = x
    [by forall_intro generalize-sigma]
qed

// The reflection is a permutation of the n letters: it maps the segment into itself (letter
// 0 stays, a positive letter's complement is below n), is injective (invertible), and covers
// the segment (each letter is the image of its own image).
theorem reflectionPermutesTheSegment: forall sigma: Fn; forall n: Nat; isTheReflection(sigma, n) -> permutesTheSegment(sigma, n)
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-n |
        fix n: Nat {
          @given-reflection |
            assume isTheReflection(sigma, n) {
              @reflection |
                isTheReflection(sigma, n)
                [by hypothesis given-reflection]
              @sigma-invertible |
                invertible(sigma)
                [using tautology reflection]
              @fixes-zero |
                apply(sigma, numeral(ZERO)) = numeral(ZERO)
                [using tautology reflection]
              @complements |
                forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(sigma, numeral(i)) = numeral(sub(n, i))
                [using tautology reflection]
              @fixes-outside |
                forall x: Element; (not member(x, segment(n))) -> apply(sigma, x) = x
                [using tautology reflection]
              @self-undoing |
                forall x: Element; apply(sigma, apply(sigma, x)) = x
                [using specialize reflectionUndoesItself(sigma, n) reflection]

              // maps into
              @generalize-x |
                fix x: Element {
                  @given-x-in |
                    assume member(x, segment(n)) {
                      @x-in |
                        member(x, segment(n))
                        [by hypothesis given-x-in]
                      @x-membership |
                        member(x, segment(n)) iff (exists i: Nat; less_than(i, n) and x = numeral(i))
                        [using specialize segmentMember(n, x)]
                      @x-is-a-letter |
                        exists i: Nat; less_than(i, n) and x = numeral(i)
                        [using tautology x-membership x-in]
                      @with-index-i |
                        unpack i: Nat from x-is-a-letter {
                          @letter-facts |
                            less_than(i, n) and x = numeral(i)
                            [by hypothesis with-index-i]
                          @i-in-range |
                            less_than(i, n)
                            [by and_elim_left letter-facts]
                          @x-is-letter-i |
                            x = numeral(i)
                            [by and_elim_right letter-facts]
                          @i-zero-or-succ |
                            i = ZERO or (exists i2: Nat; i = succ(i2))
                            [using specialize zeroOrSucc(i)]
                          @conclusion-image-in |
                            member(apply(sigma, x), segment(n))
                            case i-zero-or-succ {
                              @when-zero |
                                assume i = ZERO {
                                  @i-is-zero |
                                    i = ZERO
                                    [by hypothesis when-zero]
                                  @x-is-zero |
                                    x = numeral(ZERO)
                                    [by rewrite i-is-zero x-is-letter-i]
                                  @x-fixed |
                                    apply(sigma, x) = x
                                    [by rewrite x-is-zero fixes-zero]
                                  @conclusion-fixed-in |
                                    member(apply(sigma, x), segment(n))
                                    [by rewrite x-fixed x-in]
                                }
                              @when-succ |
                                assume exists i2: Nat; i = succ(i2) {
                                  @predecessor-exists |
                                    exists i2: Nat; i = succ(i2)
                                    [by hypothesis when-succ]
                                  @with-predecessor-i2 |
                                    unpack i2: Nat from predecessor-exists {
                                      @i-is-succ |
                                        i = succ(i2)
                                        [by hypothesis with-predecessor-i2]
                                      @zero-below-succ-i2 |
                                        less_than(ZERO, succ(i2))
                                        [using specialize zeroBelowSucc(i2)]
                                      @i-positive |
                                        less_than(ZERO, i)
                                        [by rewrite i-is-succ zero-below-succ-i2]
                                      @image-is-complement |
                                        apply(sigma, numeral(i)) = numeral(sub(n, i))
                                        [using specialize complements(i) i-positive i-in-range]
                                      @complement-below |
                                        less_than(sub(n, i), n)
                                        [using specialize complementIsBelow(i, n) i-positive i-in-range]
                                      @complement-membership |
                                        member(numeral(sub(n, i)), segment(n)) iff less_than(sub(n, i), n)
                                        [using specialize numeralInSegment(n, sub(n, i))]
                                      @complement-in |
                                        member(numeral(sub(n, i)), segment(n))
                                        [using tautology complement-membership complement-below]
                                      @image-of-letter-in |
                                        member(apply(sigma, numeral(i)), segment(n))
                                        [by rewrite image-is-complement complement-in]
                                      @conclusion-complemented-in |
                                        member(apply(sigma, x), segment(n))
                                        [by rewrite x-is-letter-i image-of-letter-in]
                                    }
                                  @conclusion-when-succ |
                                    member(apply(sigma, x), segment(n))
                                    [by exists_elim with-predecessor-i2]
                                }
                            }
                        }
                      @conclusion-image-in-at-x |
                        member(apply(sigma, x), segment(n))
                        [by exists_elim with-index-i]
                    }
                  @conclusion-maps-into-at-x |
                    member(x, segment(n)) -> member(apply(sigma, x), segment(n))
                    [by implies_intro given-x-in]
                }
              @maps-into |
                forall x: Element; member(x, segment(n)) -> member(apply(sigma, x), segment(n))
                [by forall_intro generalize-x]

              // injective on
              @injective |
                forall a: Element; forall b: Element; apply(sigma, a) = apply(sigma, b) -> a = b
                [using specialize permutationIsInjective(sigma)]
              @generalize-x-for-injective |
                fix x: Element {
                  @generalize-y-for-injective |
                    fix y: Element {
                      @injective-at-x-y |
                        apply(sigma, x) = apply(sigma, y) -> x = y
                        [using specialize injective(x, y)]
                      @conclusion-injective-clause |
                        member(x, segment(n)) -> member(y, segment(n)) -> apply(sigma, x) = apply(sigma, y) -> x = y
                        [using tautology injective-at-x-y]
                    }
                  @discharge-y-for-injective |
                    forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> apply(sigma, x) = apply(sigma, y) -> x = y
                    [by forall_intro generalize-y-for-injective]
                }
              @injective-on |
                forall x: Element; forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> apply(sigma, x) = apply(sigma, y) -> x = y
                [by forall_intro generalize-x-for-injective]

              // covers
              @generalize-y |
                fix y: Element {
                  @given-y-in |
                    assume member(y, segment(n)) {
                      @y-in |
                        member(y, segment(n))
                        [by hypothesis given-y-in]
                      @image-in |
                        member(apply(sigma, y), segment(n))
                        [using specialize maps-into(y) y-in]
                      @image-undone |
                        apply(sigma, apply(sigma, y)) = y
                        [using specialize self-undoing(y)]
                      @image-in-and-hits |
                        member(apply(sigma, y), segment(n)) and apply(sigma, apply(sigma, y)) = y
                        [by and_intro image-in image-undone]
                      @conclusion-y-is-hit |
                        exists x: Element; member(x, segment(n)) and apply(sigma, x) = y
                        [by exists_intro(apply(sigma, y)) image-in-and-hits]
                    }
                  @conclusion-covers-at-y |
                    member(y, segment(n)) -> exists x: Element; member(x, segment(n)) and apply(sigma, x) = y
                    [by implies_intro given-y-in]
                }
              @covers |
                forall y: Element; member(y, segment(n)) -> exists x: Element; member(x, segment(n)) and apply(sigma, x) = y
                [by forall_intro generalize-y]
              @conclusion-sigma-permutes |
                permutesTheSegment(sigma, n)
                [using tautology sigma-invertible maps-into injective-on covers fixes-outside]
            }
          @conclusion-at-n |
            isTheReflection(sigma, n) -> permutesTheSegment(sigma, n)
            [by implies_intro given-reflection]
        }
      @discharge-n |
        forall n: Nat; isTheReflection(sigma, n) -> permutesTheSegment(sigma, n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall sigma: Fn; forall n: Nat; isTheReflection(sigma, n) -> permutesTheSegment(sigma, n)
    [by forall_intro generalize-sigma]
qed

// THE RELATION σρ = ρ⁻¹σ, on the letters: the reflection of letter i+1 is one step back
// from the reflection of letter i. Letter 1 reflects to the last letter, which is one step
// back from letter 0; a positive letter's complement is one below the previous complement.
theorem reflectionReversesAdvance: forall rho: Fn; forall sigma: Fn; forall n: Nat;
  isTheRotation(rho, n) -> isTheReflection(sigma, n) ->
  forall i: Nat; less_than(succ(i), n) -> apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-sigma |
        fix sigma: Fn {
          @generalize-n |
            fix n: Nat {
              @given-rotation |
                assume isTheRotation(rho, n) {
                  @given-reflection |
                    assume isTheReflection(sigma, n) {
                      @rotation |
                        isTheRotation(rho, n)
                        [by hypothesis given-rotation]
                      @reflection |
                        isTheReflection(sigma, n)
                        [by hypothesis given-reflection]
                      @fixes-zero |
                        apply(sigma, numeral(ZERO)) = numeral(ZERO)
                        [using tautology reflection]
                      @complements |
                        forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(sigma, numeral(i)) = numeral(sub(n, i))
                        [using tautology reflection]
                      @generalize-i |
                        fix i: Nat {
                          @given-succ-i-in-range |
                            assume less_than(succ(i), n) {
                              @succ-i-in-range |
                                less_than(succ(i), n)
                                [by hypothesis given-succ-i-in-range]
                              @zero-below-succ-i |
                                less_than(ZERO, succ(i))
                                [using specialize zeroBelowSucc(i)]
                              @reflection-of-succ-i |
                                apply(sigma, numeral(succ(i))) = numeral(sub(n, succ(i)))
                                [using specialize complements(succ(i)) zero-below-succ-i succ-i-in-range]
                              @i-zero-or-succ |
                                i = ZERO or (exists i2: Nat; i = succ(i2))
                                [using specialize zeroOrSucc(i)]
                              @conclusion-reversed |
                                apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                                case i-zero-or-succ {
                                  @when-zero |
                                    assume i = ZERO {
                                      @i-is-zero |
                                        i = ZERO
                                        [by hypothesis when-zero]
                                      @one-in-range |
                                        less_than(succ(ZERO), n)
                                        [by rewrite i-is-zero succ-i-in-range]
                                      @n-is-a-successor |
                                        exists m: Nat; n = succ(m)
                                        [using specialize positiveIsASuccessor(succ(ZERO), n) one-in-range]
                                      @with-last-m |
                                        unpack m: Nat from n-is-a-successor {
                                          @n-is-succ-m |
                                            n = succ(m)
                                            [by hypothesis with-last-m]
                                          @reflection-of-one |
                                            apply(sigma, numeral(succ(ZERO))) = numeral(sub(n, succ(ZERO)))
                                            [by rewrite i-is-zero reflection-of-succ-i]
                                          @complement-of-one-at-succ-m |
                                            sub(succ(m), succ(ZERO)) = m
                                            [using specialize complementOfOne(m)]
                                          @complement-of-one |
                                            sub(n, succ(ZERO)) = m
                                            [by rewrite n-is-succ-m complement-of-one-at-succ-m]
                                          @reflection-of-one-is-last |
                                            apply(sigma, numeral(succ(ZERO))) = numeral(m)
                                            [by rewrite complement-of-one reflection-of-one]
                                          @back-from-zero |
                                            apply(inverse(rho), numeral(ZERO)) = numeral(m)
                                            [using specialize rotationUndoesWrap(rho, n, m) rotation n-is-succ-m]
                                          @back-from-reflection-of-zero |
                                            apply(inverse(rho), apply(sigma, numeral(ZERO))) = numeral(m)
                                            [by rewrite fixes-zero back-from-zero]
                                          @reversed-at-zero |
                                            apply(sigma, numeral(succ(ZERO))) = apply(inverse(rho), apply(sigma, numeral(ZERO)))
                                            [by rewrite back-from-reflection-of-zero reflection-of-one-is-last]
                                          @conclusion-when-zero-at-m |
                                            apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                                            [by rewrite i-is-zero reversed-at-zero]
                                        }
                                      @conclusion-when-zero |
                                        apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                                        [by exists_elim with-last-m]
                                    }
                                  @when-succ |
                                    assume exists i2: Nat; i = succ(i2) {
                                      @predecessor-exists |
                                        exists i2: Nat; i = succ(i2)
                                        [by hypothesis when-succ]
                                      @with-predecessor-i2 |
                                        unpack i2: Nat from predecessor-exists {
                                          @i-is-succ |
                                            i = succ(i2)
                                            [by hypothesis with-predecessor-i2]
                                          @zero-below-succ-i2 |
                                            less_than(ZERO, succ(i2))
                                            [using specialize zeroBelowSucc(i2)]
                                          @i-positive |
                                            less_than(ZERO, i)
                                            [by rewrite i-is-succ zero-below-succ-i2]
                                          @i-below-succ-i |
                                            less_than(i, succ(i))
                                            [using specialize lessThanSelf(i)]
                                          @i-in-range |
                                            less_than(i, n)
                                            [using specialize lessThanTransitive(i, succ(i), n) i-below-succ-i succ-i-in-range]
                                          @reflection-of-i |
                                            apply(sigma, numeral(i)) = numeral(sub(n, i))
                                            [using specialize complements(i) i-positive i-in-range]
                                          @complement-shifts |
                                            succ(sub(n, succ(i))) = sub(n, i)
                                            [using specialize complementOfSuccessor(i, n) succ-i-in-range]
                                          @complement-below |
                                            less_than(sub(n, i), n)
                                            [using specialize complementIsBelow(i, n) i-positive i-in-range]
                                          @shifted-complement-below |
                                            less_than(succ(sub(n, succ(i))), n)
                                            [by rewrite complement-shifts complement-below]
                                          @back-from-shifted-complement |
                                            apply(inverse(rho), numeral(succ(sub(n, succ(i))))) = numeral(sub(n, succ(i)))
                                            [using specialize rotationUndoesAdvance(rho, n, sub(n, succ(i))) rotation shifted-complement-below]
                                          @back-from-complement |
                                            apply(inverse(rho), numeral(sub(n, i))) = numeral(sub(n, succ(i)))
                                            [by rewrite complement-shifts back-from-shifted-complement]
                                          @back-from-reflection-of-i |
                                            apply(inverse(rho), apply(sigma, numeral(i))) = numeral(sub(n, succ(i)))
                                            [by rewrite reflection-of-i back-from-complement]
                                          @conclusion-reversed-at-i2 |
                                            apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                                            [by rewrite back-from-reflection-of-i reflection-of-succ-i]
                                        }
                                      @conclusion-when-succ |
                                        apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                                        [by exists_elim with-predecessor-i2]
                                    }
                                }
                            }
                          @conclusion-reversed-clause |
                            less_than(succ(i), n) -> apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                            [by implies_intro given-succ-i-in-range]
                        }
                      @discharge-i |
                        forall i: Nat; less_than(succ(i), n) -> apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                        [by forall_intro generalize-i]
                    }
                  @conclusion-given-reflection |
                    isTheReflection(sigma, n) -> forall i: Nat; less_than(succ(i), n) -> apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                    [by implies_intro given-reflection]
                }
              @conclusion-at-n |
                isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall i: Nat; less_than(succ(i), n) -> apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                [by implies_intro given-rotation]
            }
          @discharge-n |
            forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall i: Nat; less_than(succ(i), n) -> apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
            [by forall_intro generalize-n]
        }
      @discharge-sigma |
        forall sigma: Fn; forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall i: Nat; less_than(succ(i), n) -> apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
        [by forall_intro generalize-sigma]
    }
  @conclusion |
    forall rho: Fn; forall sigma: Fn; forall n: Nat;
      isTheRotation(rho, n) -> isTheReflection(sigma, n) ->
      forall i: Nat; less_than(succ(i), n) -> apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
    [by forall_intro generalize-rho]
qed

// The relation on every letter, including the wrap: σ(ρ(x)) = ρ⁻¹(σ(x)) for x in the segment.
// At the last letter ρ wraps to 0, which σ fixes; and the last letter's complement is 1,
// which ρ⁻¹ sends to 0 (for n ≥ 2; n = 1 has ρ = σ = id on the one letter).
theorem reflectionReversesTheRotation: forall rho: Fn; forall sigma: Fn; forall n: Nat;
  isTheRotation(rho, n) -> isTheReflection(sigma, n) ->
  forall x: Element; member(x, segment(n)) -> apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-sigma |
        fix sigma: Fn {
          @generalize-n |
            fix n: Nat {
              @given-rotation |
                assume isTheRotation(rho, n) {
                  @given-reflection |
                    assume isTheReflection(sigma, n) {
                      @rotation |
                        isTheRotation(rho, n)
                        [by hypothesis given-rotation]
                      @reflection |
                        isTheReflection(sigma, n)
                        [by hypothesis given-reflection]
                      @advances |
                        forall i: Nat; less_than(succ(i), n) -> apply(rho, numeral(i)) = numeral(succ(i))
                        [using tautology rotation]
                      @wraps |
                        forall m: Nat; n = succ(m) -> apply(rho, numeral(m)) = numeral(ZERO)
                        [using tautology rotation]
                      @fixes-zero |
                        apply(sigma, numeral(ZERO)) = numeral(ZERO)
                        [using tautology reflection]
                      @complements |
                        forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(sigma, numeral(i)) = numeral(sub(n, i))
                        [using tautology reflection]
                      @generalize-x |
                        fix x: Element {
                          @given-x-in |
                            assume member(x, segment(n)) {
                              @x-in |
                                member(x, segment(n))
                                [by hypothesis given-x-in]
                              @x-membership |
                                member(x, segment(n)) iff (exists i: Nat; less_than(i, n) and x = numeral(i))
                                [using specialize segmentMember(n, x)]
                              @x-is-a-letter |
                                exists i: Nat; less_than(i, n) and x = numeral(i)
                                [using tautology x-membership x-in]
                              @with-index-i |
                                unpack i: Nat from x-is-a-letter {
                                  @letter-facts |
                                    less_than(i, n) and x = numeral(i)
                                    [by hypothesis with-index-i]
                                  @i-in-range |
                                    less_than(i, n)
                                    [by and_elim_left letter-facts]
                                  @x-is-letter-i |
                                    x = numeral(i)
                                    [by and_elim_right letter-facts]
                                  @succ-i-below-or-is |
                                    less_than(succ(i), n) or succ(i) = n
                                    [using specialize successorBelowOrIs(i, n) i-in-range]
                                  @conclusion-relation-at-letter |
                                    apply(sigma, apply(rho, numeral(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                                    case succ-i-below-or-is {
                                      @when-advance |
                                        assume less_than(succ(i), n) {
                                          @succ-i-in-range |
                                            less_than(succ(i), n)
                                            [by hypothesis when-advance]
                                          @i-advances |
                                            apply(rho, numeral(i)) = numeral(succ(i))
                                            [using specialize advances(i) succ-i-in-range]
                                          @reversed |
                                            apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                                            [using specialize reflectionReversesAdvance(rho, sigma, n, i) rotation reflection succ-i-in-range]
                                          @conclusion-when-advance |
                                            apply(sigma, apply(rho, numeral(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                                            [by rewrite i-advances reversed]
                                        }
                                      @when-wrap |
                                        assume succ(i) = n {
                                          @succ-i-is-n |
                                            succ(i) = n
                                            [by hypothesis when-wrap]
                                          @n-is-succ-i |
                                            n = succ(i)
                                            [by symmetry succ-i-is-n]
                                          @i-wraps |
                                            apply(rho, numeral(i)) = numeral(ZERO)
                                            [using specialize wraps(i) n-is-succ-i]
                                          @reflection-of-the-image |
                                            apply(sigma, apply(rho, numeral(i))) = numeral(ZERO)
                                            [by rewrite i-wraps fixes-zero]
                                          @i-zero-or-succ |
                                            i = ZERO or (exists i2: Nat; i = succ(i2))
                                            [using specialize zeroOrSucc(i)]
                                          @back-from-the-reflection |
                                            apply(inverse(rho), apply(sigma, numeral(i))) = numeral(ZERO)
                                            case i-zero-or-succ {
                                              @when-zero |
                                                assume i = ZERO {
                                                  @i-is-zero |
                                                    i = ZERO
                                                    [by hypothesis when-zero]
                                                  @back-from-zero |
                                                    apply(inverse(rho), numeral(ZERO)) = numeral(i)
                                                    [using specialize rotationUndoesWrap(rho, n, i) rotation n-is-succ-i]
                                                  @back-from-zero-is-zero |
                                                    apply(inverse(rho), numeral(ZERO)) = numeral(ZERO)
                                                    [by rewrite i-is-zero back-from-zero]
                                                  @reflection-of-i-is-zero |
                                                    apply(sigma, numeral(i)) = numeral(ZERO)
                                                    [by rewrite i-is-zero fixes-zero]
                                                  @conclusion-when-zero |
                                                    apply(inverse(rho), apply(sigma, numeral(i))) = numeral(ZERO)
                                                    [by rewrite reflection-of-i-is-zero back-from-zero-is-zero]
                                                }
                                              @when-succ |
                                                assume exists i2: Nat; i = succ(i2) {
                                                  @predecessor-exists |
                                                    exists i2: Nat; i = succ(i2)
                                                    [by hypothesis when-succ]
                                                  @with-predecessor-i2 |
                                                    unpack i2: Nat from predecessor-exists {
                                                      @i-is-succ |
                                                        i = succ(i2)
                                                        [by hypothesis with-predecessor-i2]
                                                      @zero-below-succ-i2 |
                                                        less_than(ZERO, succ(i2))
                                                        [using specialize zeroBelowSucc(i2)]
                                                      @i-positive |
                                                        less_than(ZERO, i)
                                                        [by rewrite i-is-succ zero-below-succ-i2]
                                                      @reflection-of-i |
                                                        apply(sigma, numeral(i)) = numeral(sub(n, i))
                                                        [using specialize complements(i) i-positive i-in-range]
                                                      @i-plus-one-unfolds |
                                                        add(i, succ(ZERO)) = succ(add(i, ZERO))
                                                        [using specialize addSuccRight(i, ZERO)]
                                                      @i-plus-zero |
                                                        add(i, ZERO) = i
                                                        [using specialize addZeroRight(i)]
                                                      @i-plus-one |
                                                        add(i, succ(ZERO)) = succ(i)
                                                        [by rewrite i-plus-zero i-plus-one-unfolds]
                                                      @complement-of-i-in-the-sum |
                                                        sub(add(i, succ(ZERO)), i) = succ(ZERO)
                                                        [using specialize subOfGap(i, ZERO)]
                                                      @complement-of-i-in-succ-i |
                                                        sub(succ(i), i) = succ(ZERO)
                                                        [by rewrite i-plus-one complement-of-i-in-the-sum]
                                                      @complement-of-i |
                                                        sub(n, i) = succ(ZERO)
                                                        [by rewrite n-is-succ-i complement-of-i-in-succ-i]
                                                      @reflection-of-i-is-one |
                                                        apply(sigma, numeral(i)) = numeral(succ(ZERO))
                                                        [by rewrite complement-of-i reflection-of-i]
                                                      @one-below-succ-i |
                                                        less_than(succ(ZERO), succ(i))
                                                        [using specialize succPreservesOrder(ZERO, i) i-positive]
                                                      @one-in-range |
                                                        less_than(succ(ZERO), n)
                                                        [by rewrite n-is-succ-i one-below-succ-i]
                                                      @back-from-one |
                                                        apply(inverse(rho), numeral(succ(ZERO))) = numeral(ZERO)
                                                        [using specialize rotationUndoesAdvance(rho, n, ZERO) rotation one-in-range]
                                                      @conclusion-when-succ-at-i2 |
                                                        apply(inverse(rho), apply(sigma, numeral(i))) = numeral(ZERO)
                                                        [by rewrite reflection-of-i-is-one back-from-one]
                                                    }
                                                  @conclusion-when-succ |
                                                    apply(inverse(rho), apply(sigma, numeral(i))) = numeral(ZERO)
                                                    [by exists_elim with-predecessor-i2]
                                                }
                                            }
                                          @conclusion-when-wrap |
                                            apply(sigma, apply(rho, numeral(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                                            [by rewrite back-from-the-reflection reflection-of-the-image]
                                        }
                                    }
                                  @conclusion-relation-at-x |
                                    apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
                                    [by rewrite x-is-letter-i conclusion-relation-at-letter]
                                }
                              @conclusion-relation |
                                apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
                                [by exists_elim with-index-i]
                            }
                          @conclusion-relation-clause |
                            member(x, segment(n)) -> apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
                            [by implies_intro given-x-in]
                        }
                      @discharge-x |
                        forall x: Element; member(x, segment(n)) -> apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
                        [by forall_intro generalize-x]
                    }
                  @conclusion-given-reflection |
                    isTheReflection(sigma, n) -> forall x: Element; member(x, segment(n)) -> apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
                    [by implies_intro given-reflection]
                }
              @conclusion-at-n |
                isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall x: Element; member(x, segment(n)) -> apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
                [by implies_intro given-rotation]
            }
          @discharge-n |
            forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall x: Element; member(x, segment(n)) -> apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
            [by forall_intro generalize-n]
        }
      @discharge-sigma |
        forall sigma: Fn; forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall x: Element; member(x, segment(n)) -> apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
        [by forall_intro generalize-sigma]
    }
  @conclusion |
    forall rho: Fn; forall sigma: Fn; forall n: Nat;
      isTheRotation(rho, n) -> isTheReflection(sigma, n) ->
      forall x: Element; member(x, segment(n)) -> apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
    [by forall_intro generalize-rho]
qed

// -- rigid motions ------------------------------------------------------------------------------

// Two points are ADJACENT (for the rotation ρ) when one is ρ of the other: neighbouring
// vertices of the n-gon.
define adjacent(rho, x, y) = apply(rho, x) = y or apply(rho, y) = x

// A RIGID MOTION of the n-gon: a permutation of the n letters that sends adjacent vertices to
// adjacent vertices.
define isARigidMotion(t, rho, n) =
  permutesTheSegment(t, n)
  and (forall x: Element; forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(t, x), apply(t, y)))

// Every power of the rotation is a rigid motion: ρ^k commutes with ρ, so it carries ρx = y
// to ρ(ρ^k x) = ρ^k y.
theorem rotationPowerIsAMotion: forall rho: Fn; forall n: Nat; isTheRotation(rho, n) ->
  forall k: Nat; isARigidMotion(power(rho, k), rho, n)
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-n |
        fix n: Nat {
          @given-rotation |
            assume isTheRotation(rho, n) {
              @rotation |
                isTheRotation(rho, n)
                [by hypothesis given-rotation]
              @rho-permutes |
                permutesTheSegment(rho, n)
                [using specialize rotationPermutesTheSegment(rho, n) rotation]
              @generalize-k |
                fix k: Nat {
                  @power-permutes |
                    permutesTheSegment(power(rho, k), n)
                    [using specialize powerPermutesTheSegment(rho, n, k) rho-permutes]
                  @generalize-x |
                    fix x: Element {
                      @generalize-y |
                        fix y: Element {
                          @given-x-in |
                            assume member(x, segment(n)) {
                              @given-y-in |
                                assume member(y, segment(n)) {
                                  @given-adjacent |
                                    assume adjacent(rho, x, y) {
                                      @adjacent-x-y |
                                        adjacent(rho, x, y)
                                        [by hypothesis given-adjacent]
                                      @commuted-at-x |
                                        apply(power(rho, k), apply(rho, x)) = apply(rho, apply(power(rho, k), x))
                                        [using specialize powerCommutesPointwise(rho, k, x)]
                                      @commuted-at-y |
                                        apply(power(rho, k), apply(rho, y)) = apply(rho, apply(power(rho, k), y))
                                        [using specialize powerCommutesPointwise(rho, k, y)]
                                      @conclusion-images-adjacent |
                                        adjacent(rho, apply(power(rho, k), x), apply(power(rho, k), y))
                                        case adjacent-x-y {
                                          @when-x-to-y |
                                            assume apply(rho, x) = y {
                                              @x-to-y |
                                                apply(rho, x) = y
                                                [by hypothesis when-x-to-y]
                                              @image-of-y |
                                                apply(power(rho, k), y) = apply(rho, apply(power(rho, k), x))
                                                [by rewrite x-to-y commuted-at-x]
                                              @image-x-to-image-y |
                                                apply(rho, apply(power(rho, k), x)) = apply(power(rho, k), y)
                                                [by symmetry image-of-y]
                                              @conclusion-when-x-to-y |
                                                adjacent(rho, apply(power(rho, k), x), apply(power(rho, k), y))
                                                [using tautology image-x-to-image-y]
                                            }
                                          @when-y-to-x |
                                            assume apply(rho, y) = x {
                                              @y-to-x |
                                                apply(rho, y) = x
                                                [by hypothesis when-y-to-x]
                                              @image-of-x |
                                                apply(power(rho, k), x) = apply(rho, apply(power(rho, k), y))
                                                [by rewrite y-to-x commuted-at-y]
                                              @image-y-to-image-x |
                                                apply(rho, apply(power(rho, k), y)) = apply(power(rho, k), x)
                                                [by symmetry image-of-x]
                                              @conclusion-when-y-to-x |
                                                adjacent(rho, apply(power(rho, k), x), apply(power(rho, k), y))
                                                [using tautology image-y-to-image-x]
                                            }
                                        }
                                    }
                                  @conclusion-given-adjacent |
                                    adjacent(rho, x, y) -> adjacent(rho, apply(power(rho, k), x), apply(power(rho, k), y))
                                    [by implies_intro given-adjacent]
                                }
                              @conclusion-given-y-in |
                                member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(power(rho, k), x), apply(power(rho, k), y))
                                [by implies_intro given-y-in]
                            }
                          @conclusion-preserves-at-x-y |
                            member(x, segment(n)) -> member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(power(rho, k), x), apply(power(rho, k), y))
                            [by implies_intro given-x-in]
                        }
                      @discharge-y |
                        forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(power(rho, k), x), apply(power(rho, k), y))
                        [by forall_intro generalize-y]
                    }
                  @preserves-adjacency |
                    forall x: Element; forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(power(rho, k), x), apply(power(rho, k), y))
                    [by forall_intro generalize-x]
                  @conclusion-power-is-a-motion |
                    isARigidMotion(power(rho, k), rho, n)
                    [by and_intro power-permutes preserves-adjacency]
                }
              @discharge-k |
                forall k: Nat; isARigidMotion(power(rho, k), rho, n)
                [by forall_intro generalize-k]
            }
          @conclusion-at-n |
            isTheRotation(rho, n) -> forall k: Nat; isARigidMotion(power(rho, k), rho, n)
            [by implies_intro given-rotation]
        }
      @discharge-n |
        forall n: Nat; isTheRotation(rho, n) -> forall k: Nat; isARigidMotion(power(rho, k), rho, n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall rho: Fn; forall n: Nat; isTheRotation(rho, n) -> forall k: Nat; isARigidMotion(power(rho, k), rho, n)
    [by forall_intro generalize-rho]
qed

// Every ρ^k ∘ σ is a rigid motion: σ reverses ρ (the relation), ρ^k commutes with ρ⁻¹, so ρx = y
// gives ρ(ρ^k σ y) = ρ^k σ x — adjacent the other way round.
theorem reflectedPowerIsAMotion: forall rho: Fn; forall sigma: Fn; forall n: Nat;
  isTheRotation(rho, n) -> isTheReflection(sigma, n) ->
  forall k: Nat; isARigidMotion(compose(power(rho, k), sigma), rho, n)
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-sigma |
        fix sigma: Fn {
          @generalize-n |
            fix n: Nat {
              @given-rotation |
                assume isTheRotation(rho, n) {
                  @given-reflection |
                    assume isTheReflection(sigma, n) {
                      @rotation |
                        isTheRotation(rho, n)
                        [by hypothesis given-rotation]
                      @reflection |
                        isTheReflection(sigma, n)
                        [by hypothesis given-reflection]
                      @rho-invertible |
                        invertible(rho)
                        [using tautology rotation]
                      @rho-permutes |
                        permutesTheSegment(rho, n)
                        [using specialize rotationPermutesTheSegment(rho, n) rotation]
                      @sigma-permutes |
                        permutesTheSegment(sigma, n)
                        [using specialize reflectionPermutesTheSegment(sigma, n) reflection]
                      @relation |
                        forall x: Element; member(x, segment(n)) -> apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
                        [using specialize reflectionReversesTheRotation(rho, sigma, n) rotation reflection]
                      @generalize-k |
                        fix k: Nat {
                          @power-permutes |
                            permutesTheSegment(power(rho, k), n)
                            [using specialize powerPermutesTheSegment(rho, n, k) rho-permutes]
                          @composite-permutes |
                            permutesTheSegment(compose(power(rho, k), sigma), n)
                            [using specialize composingPermutationsOfTheSegment(sigma, power(rho, k), n) sigma-permutes power-permutes]
                          @generalize-x |
                            fix x: Element {
                              @generalize-y |
                                fix y: Element {
                                  @given-x-in |
                                    assume member(x, segment(n)) {
                                      @given-y-in |
                                        assume member(y, segment(n)) {
                                          @given-adjacent |
                                            assume adjacent(rho, x, y) {
                                              @x-in |
                                                member(x, segment(n))
                                                [by hypothesis given-x-in]
                                              @y-in |
                                                member(y, segment(n))
                                                [by hypothesis given-y-in]
                                              @adjacent-x-y |
                                                adjacent(rho, x, y)
                                                [by hypothesis given-adjacent]
                                              @composite-at-x |
                                                apply(compose(power(rho, k), sigma), x) = apply(power(rho, k), apply(sigma, x))
                                                [using specialize composeApply(power(rho, k), sigma, x)]
                                              @composite-at-y |
                                                apply(compose(power(rho, k), sigma), y) = apply(power(rho, k), apply(sigma, y))
                                                [using specialize composeApply(power(rho, k), sigma, y)]
                                              @conclusion-images-adjacent |
                                                adjacent(rho, apply(compose(power(rho, k), sigma), x), apply(compose(power(rho, k), sigma), y))
                                                case adjacent-x-y {
                                                  @when-x-to-y |
                                                    assume apply(rho, x) = y {
                                                      @x-to-y |
                                                        apply(rho, x) = y
                                                        [by hypothesis when-x-to-y]
                                                      @relation-at-x |
                                                        apply(sigma, apply(rho, x)) = apply(inverse(rho), apply(sigma, x))
                                                        [using specialize relation(x) x-in]
                                                      @reflection-of-y |
                                                        apply(sigma, y) = apply(inverse(rho), apply(sigma, x))
                                                        [by rewrite x-to-y relation-at-x]
                                                      @power-commutes-with-inverse |
                                                        apply(power(rho, k), apply(inverse(rho), apply(sigma, x))) = apply(inverse(rho), apply(power(rho, k), apply(sigma, x)))
                                                        [using specialize powerCommutesWithInverse(rho, k, apply(sigma, x)) rho-invertible]
                                                      @image-of-y |
                                                        apply(power(rho, k), apply(sigma, y)) = apply(inverse(rho), apply(power(rho, k), apply(sigma, x)))
                                                        [by rewrite reflection-of-y power-commutes-with-inverse]
                                                      @rho-undoes-inverse |
                                                        apply(rho, apply(inverse(rho), apply(power(rho, k), apply(sigma, x)))) = apply(power(rho, k), apply(sigma, x))
                                                        [using specialize permutationUndoesInverse(rho, apply(power(rho, k), apply(sigma, x)))]
                                                      @image-y-to-image-x |
                                                        apply(rho, apply(power(rho, k), apply(sigma, y))) = apply(power(rho, k), apply(sigma, x))
                                                        [by rewrite image-of-y rho-undoes-inverse]
                                                      @image-y-to-image-x-half-composed |
                                                        apply(rho, apply(power(rho, k), apply(sigma, y))) = apply(compose(power(rho, k), sigma), x)
                                                        [by rewrite composite-at-x image-y-to-image-x]
                                                      @image-y-to-image-x-composed |
                                                        apply(rho, apply(compose(power(rho, k), sigma), y)) = apply(compose(power(rho, k), sigma), x)
                                                        [by rewrite composite-at-y image-y-to-image-x-half-composed]
                                                      @conclusion-when-x-to-y |
                                                        adjacent(rho, apply(compose(power(rho, k), sigma), x), apply(compose(power(rho, k), sigma), y))
                                                        [using tautology image-y-to-image-x-composed]
                                                    }
                                                  @when-y-to-x |
                                                    assume apply(rho, y) = x {
                                                      @y-to-x |
                                                        apply(rho, y) = x
                                                        [by hypothesis when-y-to-x]
                                                      @relation-at-y |
                                                        apply(sigma, apply(rho, y)) = apply(inverse(rho), apply(sigma, y))
                                                        [using specialize relation(y) y-in]
                                                      @reflection-of-x |
                                                        apply(sigma, x) = apply(inverse(rho), apply(sigma, y))
                                                        [by rewrite y-to-x relation-at-y]
                                                      @power-commutes-with-inverse |
                                                        apply(power(rho, k), apply(inverse(rho), apply(sigma, y))) = apply(inverse(rho), apply(power(rho, k), apply(sigma, y)))
                                                        [using specialize powerCommutesWithInverse(rho, k, apply(sigma, y)) rho-invertible]
                                                      @image-of-x |
                                                        apply(power(rho, k), apply(sigma, x)) = apply(inverse(rho), apply(power(rho, k), apply(sigma, y)))
                                                        [by rewrite reflection-of-x power-commutes-with-inverse]
                                                      @rho-undoes-inverse |
                                                        apply(rho, apply(inverse(rho), apply(power(rho, k), apply(sigma, y)))) = apply(power(rho, k), apply(sigma, y))
                                                        [using specialize permutationUndoesInverse(rho, apply(power(rho, k), apply(sigma, y)))]
                                                      @image-x-to-image-y |
                                                        apply(rho, apply(power(rho, k), apply(sigma, x))) = apply(power(rho, k), apply(sigma, y))
                                                        [by rewrite image-of-x rho-undoes-inverse]
                                                      @image-x-to-image-y-half-composed |
                                                        apply(rho, apply(power(rho, k), apply(sigma, x))) = apply(compose(power(rho, k), sigma), y)
                                                        [by rewrite composite-at-y image-x-to-image-y]
                                                      @image-x-to-image-y-composed |
                                                        apply(rho, apply(compose(power(rho, k), sigma), x)) = apply(compose(power(rho, k), sigma), y)
                                                        [by rewrite composite-at-x image-x-to-image-y-half-composed]
                                                      @conclusion-when-y-to-x |
                                                        adjacent(rho, apply(compose(power(rho, k), sigma), x), apply(compose(power(rho, k), sigma), y))
                                                        [using tautology image-x-to-image-y-composed]
                                                    }
                                                }
                                            }
                                          @conclusion-given-adjacent |
                                            adjacent(rho, x, y) -> adjacent(rho, apply(compose(power(rho, k), sigma), x), apply(compose(power(rho, k), sigma), y))
                                            [by implies_intro given-adjacent]
                                        }
                                      @conclusion-given-y-in |
                                        member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(compose(power(rho, k), sigma), x), apply(compose(power(rho, k), sigma), y))
                                        [by implies_intro given-y-in]
                                    }
                                  @conclusion-preserves-at-x-y |
                                    member(x, segment(n)) -> member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(compose(power(rho, k), sigma), x), apply(compose(power(rho, k), sigma), y))
                                    [by implies_intro given-x-in]
                                }
                              @discharge-y |
                                forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(compose(power(rho, k), sigma), x), apply(compose(power(rho, k), sigma), y))
                                [by forall_intro generalize-y]
                            }
                          @preserves-adjacency |
                            forall x: Element; forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(compose(power(rho, k), sigma), x), apply(compose(power(rho, k), sigma), y))
                            [by forall_intro generalize-x]
                          @conclusion-reflected-power-is-a-motion |
                            isARigidMotion(compose(power(rho, k), sigma), rho, n)
                            [by and_intro composite-permutes preserves-adjacency]
                        }
                      @discharge-k |
                        forall k: Nat; isARigidMotion(compose(power(rho, k), sigma), rho, n)
                        [by forall_intro generalize-k]
                    }
                  @conclusion-given-reflection |
                    isTheReflection(sigma, n) -> forall k: Nat; isARigidMotion(compose(power(rho, k), sigma), rho, n)
                    [by implies_intro given-reflection]
                }
              @conclusion-at-n |
                isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall k: Nat; isARigidMotion(compose(power(rho, k), sigma), rho, n)
                [by implies_intro given-rotation]
            }
          @discharge-n |
            forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall k: Nat; isARigidMotion(compose(power(rho, k), sigma), rho, n)
            [by forall_intro generalize-n]
        }
      @discharge-sigma |
        forall sigma: Fn; forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall k: Nat; isARigidMotion(compose(power(rho, k), sigma), rho, n)
        [by forall_intro generalize-sigma]
    }
  @conclusion |
    forall rho: Fn; forall sigma: Fn; forall n: Nat;
      isTheRotation(rho, n) -> isTheReflection(sigma, n) ->
      forall k: Nat; isARigidMotion(compose(power(rho, k), sigma), rho, n)
    [by forall_intro generalize-rho]
qed

// -- every motion is a rotation or a reflection ------------------------------------------------

theorem succSuccNotSelf: forall k: Nat; succ(succ(k)) != k
proof
  @generalize-k |
    fix k: Nat {
      @k-below-succ-k |
        less_than(k, succ(k))
        [using specialize lessThanSelf(k)]
      @succ-k-below-succ-succ-k |
        less_than(succ(k), succ(succ(k)))
        [using specialize lessThanSelf(succ(k))]
      @k-below-succ-succ-k |
        less_than(k, succ(succ(k)))
        [using specialize lessThanTransitive(k, succ(k), succ(succ(k))) k-below-succ-k succ-k-below-succ-succ-k]
      @suppose-equal |
        assume succ(succ(k)) = k {
          @equal |
            succ(succ(k)) = k
            [by hypothesis suppose-equal]
          @k-below-itself |
            less_than(k, k)
            [by rewrite equal k-below-succ-succ-k]
        }
      @k-not-below-itself |
        not less_than(k, k)
        [using specialize lessThanIrreflexive(k)]
      @conclusion-not-self |
        succ(succ(k)) != k
        [by not_intro suppose-equal k-below-itself k-not-below-itself]
    }
  @conclusion |
    forall k: Nat; succ(succ(k)) != k
    [by forall_intro generalize-k]
qed

// WALKING THE LETTERS — Judson's "everything else is forced". A rigid motion t that agrees
// with a candidate u on letters 0 and 1 agrees with it everywhere, provided u steps through
// the letters by a fixed direction d (ρ or ρ⁻¹, with dback the other) and fixes the outside.
// At each step t(i+2) is adjacent to t(i+1) = u(i+1), so it is one of u(i+1)'s two
// neighbours u(i+2) and u(i); it is not u(i) = t(i) since t is injective; so it is u(i+2).
theorem walkingTheLetters: forall rho: Fn; forall n: Nat; isTheRotation(rho, n) -> less_than(succ(ZERO), n) ->
  forall t: Fn; isARigidMotion(t, rho, n) ->
  forall u: Fn; forall d: Fn; forall dback: Fn;
  ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) ->
  (forall z: Element; apply(dback, apply(d, z)) = z) ->
  (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) ->
  (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) ->
  apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) ->
  apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) ->
  t = u
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-n |
        fix n: Nat {
          @given-rotation |
            assume isTheRotation(rho, n) {
              @given-two-letters |
                assume less_than(succ(ZERO), n) {
                  @rotation |
                    isTheRotation(rho, n)
                    [by hypothesis given-rotation]
                  @two-letters |
                    less_than(succ(ZERO), n)
                    [by hypothesis given-two-letters]
                  @advances |
                    forall i: Nat; less_than(succ(i), n) -> apply(rho, numeral(i)) = numeral(succ(i))
                    [using tautology rotation]
                  @generalize-t |
                    fix t: Fn {
                      @given-motion |
                        assume isARigidMotion(t, rho, n) {
                          @motion |
                            isARigidMotion(t, rho, n)
                            [by hypothesis given-motion]
                          @t-permutes |
                            permutesTheSegment(t, n)
                            [using tautology motion]
                          @t-preserves-adjacency |
                            forall x: Element; forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(t, x), apply(t, y))
                            [using tautology motion]
                          @t-invertible |
                            invertible(t)
                            [using tautology t-permutes]
                          @t-fixes-outside |
                            forall x: Element; (not member(x, segment(n))) -> apply(t, x) = x
                            [using tautology t-permutes]
                          @t-injective |
                            forall a: Element; forall b: Element; apply(t, a) = apply(t, b) -> a = b
                            [using specialize permutationIsInjective(t)]
                          @generalize-u |
                            fix u: Fn {
                              @generalize-d |
                                fix d: Fn {
                                  @generalize-dback |
                                    fix dback: Fn {
                                      @given-direction |
                                        assume (d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho) {
                                          @given-undo |
                                            assume forall z: Element; apply(dback, apply(d, z)) = z {
                                              @given-steps |
                                                assume forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i))) {
                                                  @given-u-fixes-outside |
                                                    assume forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x {
                                                      @given-agree-at-zero |
                                                        assume apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) {
                                                          @given-agree-at-one |
                                                            assume apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) {
                                                              @direction |
                                                                (d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)
                                                                [by hypothesis given-direction]
                                                              @undo |
                                                                forall z: Element; apply(dback, apply(d, z)) = z
                                                                [by hypothesis given-undo]
                                                              @steps |
                                                                forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))
                                                                [by hypothesis given-steps]
                                                              @u-fixes-outside |
                                                                forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x
                                                                [by hypothesis given-u-fixes-outside]
                                                              @agree-at-zero |
                                                                apply(t, numeral(ZERO)) = apply(u, numeral(ZERO))
                                                                [by hypothesis given-agree-at-zero]
                                                              @agree-at-one |
                                                                apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO)))
                                                                [by hypothesis given-agree-at-one]

                                                              // the two-step induction along the letters
                                                              @base-case |
                                                                less_than(succ(ZERO), n) -> (apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) and apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))))
                                                                [using tautology agree-at-zero agree-at-one]
                                                              @induction-step |
                                                                fix k: Nat {
                                                                  @given-inductive-hypothesis |
                                                                    assume less_than(succ(k), n) -> (apply(t, numeral(k)) = apply(u, numeral(k)) and apply(t, numeral(succ(k))) = apply(u, numeral(succ(k)))) {
                                                                      @inductive-hypothesis |
                                                                        less_than(succ(k), n) -> (apply(t, numeral(k)) = apply(u, numeral(k)) and apply(t, numeral(succ(k))) = apply(u, numeral(succ(k))))
                                                                        [by hypothesis given-inductive-hypothesis]
                                                                      @given-two-more-in-range |
                                                                        assume less_than(succ(succ(k)), n) {
                                                                          @two-more-in-range |
                                                                            less_than(succ(succ(k)), n)
                                                                            [by hypothesis given-two-more-in-range]
                                                                          @succ-k-below-succ-succ-k |
                                                                            less_than(succ(k), succ(succ(k)))
                                                                            [using specialize lessThanSelf(succ(k))]
                                                                          @one-more-in-range |
                                                                            less_than(succ(k), n)
                                                                            [using specialize lessThanTransitive(succ(k), succ(succ(k)), n) succ-k-below-succ-succ-k two-more-in-range]
                                                                          @agree-so-far |
                                                                            apply(t, numeral(k)) = apply(u, numeral(k)) and apply(t, numeral(succ(k))) = apply(u, numeral(succ(k)))
                                                                            [by modus_ponens inductive-hypothesis one-more-in-range]
                                                                          @agree-at-k |
                                                                            apply(t, numeral(k)) = apply(u, numeral(k))
                                                                            [by and_elim_left agree-so-far]
                                                                          @agree-at-succ-k |
                                                                            apply(t, numeral(succ(k))) = apply(u, numeral(succ(k)))
                                                                            [by and_elim_right agree-so-far]

                                                                          // t(k+2) is a neighbour of u(k+1)
                                                                          @succ-k-advances |
                                                                            apply(rho, numeral(succ(k))) = numeral(succ(succ(k)))
                                                                            [using specialize advances(succ(k)) two-more-in-range]
                                                                          @consecutive-adjacent |
                                                                            adjacent(rho, numeral(succ(k)), numeral(succ(succ(k))))
                                                                            [using tautology succ-k-advances]
                                                                          @succ-k-membership |
                                                                            member(numeral(succ(k)), segment(n)) iff less_than(succ(k), n)
                                                                            [using specialize numeralInSegment(n, succ(k))]
                                                                          @succ-k-in |
                                                                            member(numeral(succ(k)), segment(n))
                                                                            [using tautology succ-k-membership one-more-in-range]
                                                                          @succ-succ-k-membership |
                                                                            member(numeral(succ(succ(k))), segment(n)) iff less_than(succ(succ(k)), n)
                                                                            [using specialize numeralInSegment(n, succ(succ(k)))]
                                                                          @succ-succ-k-in |
                                                                            member(numeral(succ(succ(k))), segment(n))
                                                                            [using tautology succ-succ-k-membership two-more-in-range]
                                                                          @images-adjacent |
                                                                            adjacent(rho, apply(t, numeral(succ(k))), apply(t, numeral(succ(succ(k)))))
                                                                            [using specialize t-preserves-adjacency(numeral(succ(k)), numeral(succ(succ(k)))) succ-k-in succ-succ-k-in consecutive-adjacent]
                                                                          @images-adjacent-via-u |
                                                                            adjacent(rho, apply(u, numeral(succ(k))), apply(t, numeral(succ(succ(k)))))
                                                                            [by rewrite agree-at-succ-k images-adjacent]
                                                                          @next-image-is-a-neighbour |
                                                                            apply(t, numeral(succ(succ(k)))) = apply(rho, apply(u, numeral(succ(k)))) or apply(t, numeral(succ(succ(k)))) = apply(inverse(rho), apply(u, numeral(succ(k))))
                                                                            case images-adjacent-via-u {
                                                                              @when-forward |
                                                                                assume apply(rho, apply(u, numeral(succ(k)))) = apply(t, numeral(succ(succ(k)))) {
                                                                                  @forward |
                                                                                    apply(rho, apply(u, numeral(succ(k)))) = apply(t, numeral(succ(succ(k))))
                                                                                    [by hypothesis when-forward]
                                                                                  @forward-flipped |
                                                                                    apply(t, numeral(succ(succ(k)))) = apply(rho, apply(u, numeral(succ(k))))
                                                                                    [by symmetry forward]
                                                                                  @conclusion-when-forward |
                                                                                    apply(t, numeral(succ(succ(k)))) = apply(rho, apply(u, numeral(succ(k)))) or apply(t, numeral(succ(succ(k)))) = apply(inverse(rho), apply(u, numeral(succ(k))))
                                                                                    [using tautology forward-flipped]
                                                                                }
                                                                              @when-backward |
                                                                                assume apply(rho, apply(t, numeral(succ(succ(k))))) = apply(u, numeral(succ(k))) {
                                                                                  @backward |
                                                                                    apply(rho, apply(t, numeral(succ(succ(k))))) = apply(u, numeral(succ(k)))
                                                                                    [by hypothesis when-backward]
                                                                                  @inverse-undoes |
                                                                                    apply(inverse(rho), apply(rho, apply(t, numeral(succ(succ(k)))))) = apply(t, numeral(succ(succ(k))))
                                                                                    [using specialize inverseUndoesPermutation(rho, apply(t, numeral(succ(succ(k)))))]
                                                                                  @back-from-u |
                                                                                    apply(inverse(rho), apply(u, numeral(succ(k)))) = apply(t, numeral(succ(succ(k))))
                                                                                    [by rewrite backward inverse-undoes]
                                                                                  @back-from-u-flipped |
                                                                                    apply(t, numeral(succ(succ(k)))) = apply(inverse(rho), apply(u, numeral(succ(k))))
                                                                                    [by symmetry back-from-u]
                                                                                  @conclusion-when-backward |
                                                                                    apply(t, numeral(succ(succ(k)))) = apply(rho, apply(u, numeral(succ(k)))) or apply(t, numeral(succ(succ(k)))) = apply(inverse(rho), apply(u, numeral(succ(k))))
                                                                                    [using tautology back-from-u-flipped]
                                                                                }
                                                                            }

                                                                          // u(k+2) and u(k) are those two neighbours
                                                                          @u-steps-to-succ-succ-k |
                                                                            apply(u, numeral(succ(succ(k)))) = apply(d, apply(u, numeral(succ(k))))
                                                                            [using specialize steps(succ(k)) two-more-in-range]
                                                                          @u-steps-to-succ-k |
                                                                            apply(u, numeral(succ(k))) = apply(d, apply(u, numeral(k)))
                                                                            [using specialize steps(k) one-more-in-range]
                                                                          @undo-at-u-k |
                                                                            apply(dback, apply(d, apply(u, numeral(k)))) = apply(u, numeral(k))
                                                                            [using specialize undo(apply(u, numeral(k)))]
                                                                          @back-from-u-succ-k |
                                                                            apply(dback, apply(u, numeral(succ(k)))) = apply(u, numeral(k))
                                                                            [by rewrite u-steps-to-succ-k undo-at-u-k]
                                                                          @u-k-is-back |
                                                                            apply(u, numeral(k)) = apply(dback, apply(u, numeral(succ(k))))
                                                                            [by symmetry back-from-u-succ-k]

                                                                          // t(k+2) is not t(k) = u(k)
                                                                          @suppose-returns |
                                                                            assume apply(t, numeral(succ(succ(k)))) = apply(t, numeral(k)) {
                                                                              @returns |
                                                                                apply(t, numeral(succ(succ(k)))) = apply(t, numeral(k))
                                                                                [by hypothesis suppose-returns]
                                                                              @letters-agree |
                                                                                numeral(succ(succ(k))) = numeral(k)
                                                                                [using specialize t-injective(numeral(succ(succ(k))), numeral(k)) returns]
                                                                              @indices-agree |
                                                                                succ(succ(k)) = k
                                                                                [using specialize numeralInjective(succ(succ(k)), k) letters-agree]
                                                                            }
                                                                          @indices-differ |
                                                                            succ(succ(k)) != k
                                                                            [using specialize succSuccNotSelf(k)]
                                                                          @does-not-return |
                                                                            apply(t, numeral(succ(succ(k)))) != apply(t, numeral(k))
                                                                            [by not_intro suppose-returns indices-agree indices-differ]
                                                                          @does-not-return-to-u |
                                                                            apply(t, numeral(succ(succ(k)))) != apply(u, numeral(k))
                                                                            [by rewrite agree-at-k does-not-return]

                                                                          // so it is u(k+2), in either direction
                                                                          @agree-at-succ-succ-k |
                                                                            apply(t, numeral(succ(succ(k)))) = apply(u, numeral(succ(succ(k))))
                                                                            case direction {
                                                                              @when-forward-direction |
                                                                                assume d = rho and dback = inverse(rho) {
                                                                                  @forward-direction |
                                                                                    d = rho and dback = inverse(rho)
                                                                                    [by hypothesis when-forward-direction]
                                                                                  @d-is-rho |
                                                                                    d = rho
                                                                                    [by and_elim_left forward-direction]
                                                                                  @dback-is-inverse |
                                                                                    dback = inverse(rho)
                                                                                    [by and_elim_right forward-direction]
                                                                                  @u-succ-succ-k-forward |
                                                                                    apply(u, numeral(succ(succ(k)))) = apply(rho, apply(u, numeral(succ(k))))
                                                                                    [by rewrite d-is-rho u-steps-to-succ-succ-k]
                                                                                  @u-k-backward |
                                                                                    apply(u, numeral(k)) = apply(inverse(rho), apply(u, numeral(succ(k))))
                                                                                    [by rewrite dback-is-inverse u-k-is-back]
                                                                                  @neighbour-named-once |
                                                                                    apply(t, numeral(succ(succ(k)))) = apply(u, numeral(succ(succ(k)))) or apply(t, numeral(succ(succ(k)))) = apply(inverse(rho), apply(u, numeral(succ(k))))
                                                                                    [by rewrite u-succ-succ-k-forward next-image-is-a-neighbour]
                                                                                  @neighbours-named |
                                                                                    apply(t, numeral(succ(succ(k)))) = apply(u, numeral(succ(succ(k)))) or apply(t, numeral(succ(succ(k)))) = apply(u, numeral(k))
                                                                                    [by rewrite u-k-backward neighbour-named-once]
                                                                                  @conclusion-forward-direction |
                                                                                    apply(t, numeral(succ(succ(k)))) = apply(u, numeral(succ(succ(k))))
                                                                                    [using tautology neighbours-named does-not-return-to-u]
                                                                                }
                                                                              @when-backward-direction |
                                                                                assume d = inverse(rho) and dback = rho {
                                                                                  @backward-direction |
                                                                                    d = inverse(rho) and dback = rho
                                                                                    [by hypothesis when-backward-direction]
                                                                                  @d-is-inverse |
                                                                                    d = inverse(rho)
                                                                                    [by and_elim_left backward-direction]
                                                                                  @dback-is-rho |
                                                                                    dback = rho
                                                                                    [by and_elim_right backward-direction]
                                                                                  @u-succ-succ-k-backward |
                                                                                    apply(u, numeral(succ(succ(k)))) = apply(inverse(rho), apply(u, numeral(succ(k))))
                                                                                    [by rewrite d-is-inverse u-steps-to-succ-succ-k]
                                                                                  @u-k-forward |
                                                                                    apply(u, numeral(k)) = apply(rho, apply(u, numeral(succ(k))))
                                                                                    [by rewrite dback-is-rho u-k-is-back]
                                                                                  @neighbour-named-once |
                                                                                    apply(t, numeral(succ(succ(k)))) = apply(u, numeral(k)) or apply(t, numeral(succ(succ(k)))) = apply(inverse(rho), apply(u, numeral(succ(k))))
                                                                                    [by rewrite u-k-forward next-image-is-a-neighbour]
                                                                                  @neighbours-named |
                                                                                    apply(t, numeral(succ(succ(k)))) = apply(u, numeral(k)) or apply(t, numeral(succ(succ(k)))) = apply(u, numeral(succ(succ(k))))
                                                                                    [by rewrite u-succ-succ-k-backward neighbour-named-once]
                                                                                  @conclusion-backward-direction |
                                                                                    apply(t, numeral(succ(succ(k)))) = apply(u, numeral(succ(succ(k))))
                                                                                    [using tautology neighbours-named does-not-return-to-u]
                                                                                }
                                                                            }
                                                                          @conclusion-agree-one-further |
                                                                            apply(t, numeral(succ(k))) = apply(u, numeral(succ(k))) and apply(t, numeral(succ(succ(k)))) = apply(u, numeral(succ(succ(k))))
                                                                            [by and_intro agree-at-succ-k agree-at-succ-succ-k]
                                                                        }
                                                                      @conclusion-step |
                                                                        less_than(succ(succ(k)), n) -> (apply(t, numeral(succ(k))) = apply(u, numeral(succ(k))) and apply(t, numeral(succ(succ(k)))) = apply(u, numeral(succ(succ(k)))))
                                                                        [by implies_intro given-two-more-in-range]
                                                                    }
                                                                  @induction-step-at-k |
                                                                    (less_than(succ(k), n) -> (apply(t, numeral(k)) = apply(u, numeral(k)) and apply(t, numeral(succ(k))) = apply(u, numeral(succ(k))))) -> (less_than(succ(succ(k)), n) -> (apply(t, numeral(succ(k))) = apply(u, numeral(succ(k))) and apply(t, numeral(succ(succ(k)))) = apply(u, numeral(succ(succ(k))))))
                                                                    [by implies_intro given-inductive-hypothesis]
                                                                }
                                                              @induction-step-for-all-k |
                                                                forall k: Nat; (less_than(succ(k), n) -> (apply(t, numeral(k)) = apply(u, numeral(k)) and apply(t, numeral(succ(k))) = apply(u, numeral(succ(k))))) -> (less_than(succ(succ(k)), n) -> (apply(t, numeral(succ(k))) = apply(u, numeral(succ(k))) and apply(t, numeral(succ(succ(k)))) = apply(u, numeral(succ(succ(k))))))
                                                                [by forall_intro induction-step]
                                                              @agree-along-the-letters |
                                                                forall i: Nat; less_than(succ(i), n) -> (apply(t, numeral(i)) = apply(u, numeral(i)) and apply(t, numeral(succ(i))) = apply(u, numeral(succ(i))))
                                                                [using instantiation induction((fun i: Nat => less_than(succ(i), n) -> (apply(t, numeral(i)) = apply(u, numeral(i)) and apply(t, numeral(succ(i))) = apply(u, numeral(succ(i)))))) base-case induction-step-for-all-k]

                                                              // hence everywhere
                                                              @generalize-x |
                                                                fix x: Element {
                                                                  @x-in-or-out |
                                                                    member(x, segment(n)) or (not member(x, segment(n)))
                                                                    [using tautology]
                                                                  @conclusion-agree-at-x |
                                                                    apply(t, x) = apply(u, x)
                                                                    case x-in-or-out {
                                                                      @when-x-in |
                                                                        assume member(x, segment(n)) {
                                                                          @x-in |
                                                                            member(x, segment(n))
                                                                            [by hypothesis when-x-in]
                                                                          @x-membership |
                                                                            member(x, segment(n)) iff (exists i: Nat; less_than(i, n) and x = numeral(i))
                                                                            [using specialize segmentMember(n, x)]
                                                                          @x-is-a-letter |
                                                                            exists i: Nat; less_than(i, n) and x = numeral(i)
                                                                            [using tautology x-membership x-in]
                                                                          @with-index-i |
                                                                            unpack i: Nat from x-is-a-letter {
                                                                              @letter-facts |
                                                                                less_than(i, n) and x = numeral(i)
                                                                                [by hypothesis with-index-i]
                                                                              @i-in-range |
                                                                                less_than(i, n)
                                                                                [by and_elim_left letter-facts]
                                                                              @x-is-letter-i |
                                                                                x = numeral(i)
                                                                                [by and_elim_right letter-facts]
                                                                              @succ-i-below-or-is |
                                                                                less_than(succ(i), n) or succ(i) = n
                                                                                [using specialize successorBelowOrIs(i, n) i-in-range]
                                                                              @conclusion-agree-at-letter |
                                                                                apply(t, numeral(i)) = apply(u, numeral(i))
                                                                                case succ-i-below-or-is {
                                                                                  @when-not-last |
                                                                                    assume less_than(succ(i), n) {
                                                                                      @succ-i-in-range |
                                                                                        less_than(succ(i), n)
                                                                                        [by hypothesis when-not-last]
                                                                                      @agree-at-i-and-next |
                                                                                        apply(t, numeral(i)) = apply(u, numeral(i)) and apply(t, numeral(succ(i))) = apply(u, numeral(succ(i)))
                                                                                        [using specialize agree-along-the-letters(i) succ-i-in-range]
                                                                                      @conclusion-when-not-last |
                                                                                        apply(t, numeral(i)) = apply(u, numeral(i))
                                                                                        [by and_elim_left agree-at-i-and-next]
                                                                                    }
                                                                                  @when-last |
                                                                                    assume succ(i) = n {
                                                                                      @succ-i-is-n |
                                                                                        succ(i) = n
                                                                                        [by hypothesis when-last]
                                                                                      @i-zero-or-succ |
                                                                                        i = ZERO or (exists i2: Nat; i = succ(i2))
                                                                                        [using specialize zeroOrSucc(i)]
                                                                                      @conclusion-when-last |
                                                                                        apply(t, numeral(i)) = apply(u, numeral(i))
                                                                                        case i-zero-or-succ {
                                                                                          @when-zero |
                                                                                            assume i = ZERO {
                                                                                              @i-is-zero |
                                                                                                i = ZERO
                                                                                                [by hypothesis when-zero]
                                                                                              @one-is-n |
                                                                                                succ(ZERO) = n
                                                                                                [by rewrite i-is-zero succ-i-is-n]
                                                                                              @one-below-itself |
                                                                                                less_than(succ(ZERO), succ(ZERO))
                                                                                                [by rewrite one-is-n two-letters]
                                                                                              @one-not-below-itself |
                                                                                                not less_than(succ(ZERO), succ(ZERO))
                                                                                                [using specialize lessThanIrreflexive(succ(ZERO))]
                                                                                              @conclusion-when-zero |
                                                                                                apply(t, numeral(i)) = apply(u, numeral(i))
                                                                                                [by absurd one-below-itself one-not-below-itself]
                                                                                            }
                                                                                          @when-succ |
                                                                                            assume exists i2: Nat; i = succ(i2) {
                                                                                              @predecessor-exists |
                                                                                                exists i2: Nat; i = succ(i2)
                                                                                                [by hypothesis when-succ]
                                                                                              @with-predecessor-i2 |
                                                                                                unpack i2: Nat from predecessor-exists {
                                                                                                  @i-is-succ |
                                                                                                    i = succ(i2)
                                                                                                    [by hypothesis with-predecessor-i2]
                                                                                                  @succ-i2-in-range |
                                                                                                    less_than(succ(i2), n)
                                                                                                    [by rewrite i-is-succ i-in-range]
                                                                                                  @agree-at-i2-and-next |
                                                                                                    apply(t, numeral(i2)) = apply(u, numeral(i2)) and apply(t, numeral(succ(i2))) = apply(u, numeral(succ(i2)))
                                                                                                    [using specialize agree-along-the-letters(i2) succ-i2-in-range]
                                                                                                  @agree-at-succ-i2 |
                                                                                                    apply(t, numeral(succ(i2))) = apply(u, numeral(succ(i2)))
                                                                                                    [by and_elim_right agree-at-i2-and-next]
                                                                                                  @conclusion-when-succ-at-i2 |
                                                                                                    apply(t, numeral(i)) = apply(u, numeral(i))
                                                                                                    [by rewrite i-is-succ agree-at-succ-i2]
                                                                                                }
                                                                                              @conclusion-when-succ |
                                                                                                apply(t, numeral(i)) = apply(u, numeral(i))
                                                                                                [by exists_elim with-predecessor-i2]
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                              @conclusion-agree-at-x-as-letter |
                                                                                apply(t, x) = apply(u, x)
                                                                                [by rewrite x-is-letter-i conclusion-agree-at-letter]
                                                                            }
                                                                          @conclusion-when-in |
                                                                            apply(t, x) = apply(u, x)
                                                                            [by exists_elim with-index-i]
                                                                        }
                                                                      @when-x-out |
                                                                        assume not member(x, segment(n)) {
                                                                          @x-out |
                                                                            not member(x, segment(n))
                                                                            [by hypothesis when-x-out]
                                                                          @t-fixes-x |
                                                                            apply(t, x) = x
                                                                            [using specialize t-fixes-outside(x) x-out]
                                                                          @u-fixes-x |
                                                                            apply(u, x) = x
                                                                            [using specialize u-fixes-outside(x) x-out]
                                                                          @conclusion-when-out |
                                                                            apply(t, x) = apply(u, x)
                                                                            [by rewrite u-fixes-x t-fixes-x]
                                                                        }
                                                                    }
                                                                }
                                                              @agree-everywhere |
                                                                forall x: Element; apply(t, x) = apply(u, x)
                                                                [by forall_intro generalize-x]
                                                              @conclusion-t-is-u |
                                                                t = u
                                                                [using specialize funcExtensionality(t, u) agree-everywhere]
                                                            }
                                                          @conclusion-given-agree-at-one |
                                                            apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                                                            [by implies_intro given-agree-at-one]
                                                        }
                                                      @conclusion-given-agree-at-zero |
                                                        apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                                                        [by implies_intro given-agree-at-zero]
                                                    }
                                                  @conclusion-given-u-fixes |
                                                    (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                                                    [by implies_intro given-u-fixes-outside]
                                                }
                                              @conclusion-given-steps |
                                                (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                                                [by implies_intro given-steps]
                                            }
                                          @conclusion-given-undo |
                                            (forall z: Element; apply(dback, apply(d, z)) = z) -> (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                                            [by implies_intro given-undo]
                                        }
                                      @conclusion-given-direction |
                                        ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) -> (forall z: Element; apply(dback, apply(d, z)) = z) -> (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                                        [by implies_intro given-direction]
                                    }
                                  @discharge-dback |
                                    forall dback: Fn; ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) -> (forall z: Element; apply(dback, apply(d, z)) = z) -> (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                                    [by forall_intro generalize-dback]
                                }
                              @discharge-d |
                                forall d: Fn; forall dback: Fn; ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) -> (forall z: Element; apply(dback, apply(d, z)) = z) -> (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                                [by forall_intro generalize-d]
                            }
                          @discharge-u |
                            forall u: Fn; forall d: Fn; forall dback: Fn; ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) -> (forall z: Element; apply(dback, apply(d, z)) = z) -> (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                            [by forall_intro generalize-u]
                        }
                      @conclusion-at-t |
                        isARigidMotion(t, rho, n) -> forall u: Fn; forall d: Fn; forall dback: Fn; ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) -> (forall z: Element; apply(dback, apply(d, z)) = z) -> (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                        [by implies_intro given-motion]
                    }
                  @discharge-t |
                    forall t: Fn; isARigidMotion(t, rho, n) -> forall u: Fn; forall d: Fn; forall dback: Fn; ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) -> (forall z: Element; apply(dback, apply(d, z)) = z) -> (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                    [by forall_intro generalize-t]
                }
              @conclusion-given-two-letters |
                less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall u: Fn; forall d: Fn; forall dback: Fn; ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) -> (forall z: Element; apply(dback, apply(d, z)) = z) -> (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
                [by implies_intro given-two-letters]
            }
          @conclusion-at-n |
            isTheRotation(rho, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall u: Fn; forall d: Fn; forall dback: Fn; ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) -> (forall z: Element; apply(dback, apply(d, z)) = z) -> (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
            [by implies_intro given-rotation]
        }
      @discharge-n |
        forall n: Nat; isTheRotation(rho, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall u: Fn; forall d: Fn; forall dback: Fn; ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) -> (forall z: Element; apply(dback, apply(d, z)) = z) -> (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) -> (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) -> apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) -> apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) -> t = u
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall rho: Fn; forall n: Nat; isTheRotation(rho, n) -> less_than(succ(ZERO), n) ->
      forall t: Fn; isARigidMotion(t, rho, n) ->
      forall u: Fn; forall d: Fn; forall dback: Fn;
      ((d = rho and dback = inverse(rho)) or (d = inverse(rho) and dback = rho)) ->
      (forall z: Element; apply(dback, apply(d, z)) = z) ->
      (forall i: Nat; less_than(succ(i), n) -> apply(u, numeral(succ(i))) = apply(d, apply(u, numeral(i)))) ->
      (forall x: Element; (not member(x, segment(n))) -> apply(u, x) = x) ->
      apply(t, numeral(ZERO)) = apply(u, numeral(ZERO)) ->
      apply(t, numeral(succ(ZERO))) = apply(u, numeral(succ(ZERO))) ->
      t = u
    [by forall_intro generalize-rho]
qed

// A motion sending letter 0 to letter k and letter 1 to ρ(k) IS ρ^k: ρ^k steps forward, fixes
// the outside, sends 0 to k and 1 to ρ(k).
theorem motionSteppingForwardIsAPower: forall rho: Fn; forall n: Nat; isTheRotation(rho, n) -> less_than(succ(ZERO), n) ->
  forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) ->
  apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) ->
  t = power(rho, k)
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-n |
        fix n: Nat {
          @given-rotation |
            assume isTheRotation(rho, n) {
              @given-two-letters |
                assume less_than(succ(ZERO), n) {
                  @rotation |
                    isTheRotation(rho, n)
                    [by hypothesis given-rotation]
                  @two-letters |
                    less_than(succ(ZERO), n)
                    [by hypothesis given-two-letters]
                  @rho-invertible |
                    invertible(rho)
                    [using tautology rotation]
                  @advances |
                    forall i: Nat; less_than(succ(i), n) -> apply(rho, numeral(i)) = numeral(succ(i))
                    [using tautology rotation]
                  @rho-fixes-outside |
                    forall x: Element; (not member(x, segment(n))) -> apply(rho, x) = x
                    [using tautology rotation]
                  @rho-is-rho |
                    rho = rho
                    [by reflexivity]
                  @inverse-is-inverse |
                    inverse(rho) = inverse(rho)
                    [by reflexivity]
                  @forward-direction |
                    (rho = rho and inverse(rho) = inverse(rho)) or (rho = inverse(rho) and inverse(rho) = rho)
                    [using tautology rho-is-rho inverse-is-inverse]
                  @generalize-z |
                    fix z: Element {
                      @conclusion-undo-at-z |
                        apply(inverse(rho), apply(rho, z)) = z
                        [using specialize inverseUndoesPermutation(rho, z)]
                    }
                  @undo |
                    forall z: Element; apply(inverse(rho), apply(rho, z)) = z
                    [by forall_intro generalize-z]
                  @generalize-t |
                    fix t: Fn {
                      @given-motion |
                        assume isARigidMotion(t, rho, n) {
                          @motion |
                            isARigidMotion(t, rho, n)
                            [by hypothesis given-motion]
                          @generalize-k |
                            fix k: Nat {
                              @given-k-in-range |
                                assume less_than(k, n) {
                                  @given-zero-to-k |
                                    assume apply(t, numeral(ZERO)) = numeral(k) {
                                      @given-one-forward |
                                        assume apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) {
                                          @k-in-range |
                                            less_than(k, n)
                                            [by hypothesis given-k-in-range]
                                          @zero-to-k |
                                            apply(t, numeral(ZERO)) = numeral(k)
                                            [by hypothesis given-zero-to-k]
                                          @one-forward |
                                            apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k))
                                            [by hypothesis given-one-forward]
                                          @power-at-zero |
                                            apply(power(rho, k), numeral(ZERO)) = numeral(k)
                                            [using specialize rotationPowerAtZero(rho, n, k) rotation k-in-range]
                                          @agree-at-zero |
                                            apply(t, numeral(ZERO)) = apply(power(rho, k), numeral(ZERO))
                                            [by rewrite power-at-zero zero-to-k]

                                          // ρ^k steps forward
                                          @generalize-i |
                                            fix i: Nat {
                                              @given-succ-i-in-range |
                                                assume less_than(succ(i), n) {
                                                  @succ-i-in-range |
                                                    less_than(succ(i), n)
                                                    [by hypothesis given-succ-i-in-range]
                                                  @i-advances |
                                                    apply(rho, numeral(i)) = numeral(succ(i))
                                                    [using specialize advances(i) succ-i-in-range]
                                                  @commuted |
                                                    apply(power(rho, k), apply(rho, numeral(i))) = apply(rho, apply(power(rho, k), numeral(i)))
                                                    [using specialize powerCommutesPointwise(rho, k, numeral(i))]
                                                  @conclusion-step-at-i |
                                                    apply(power(rho, k), numeral(succ(i))) = apply(rho, apply(power(rho, k), numeral(i)))
                                                    [by rewrite i-advances commuted]
                                                }
                                              @conclusion-step-clause |
                                                less_than(succ(i), n) -> apply(power(rho, k), numeral(succ(i))) = apply(rho, apply(power(rho, k), numeral(i)))
                                                [by implies_intro given-succ-i-in-range]
                                            }
                                          @steps |
                                            forall i: Nat; less_than(succ(i), n) -> apply(power(rho, k), numeral(succ(i))) = apply(rho, apply(power(rho, k), numeral(i)))
                                            [by forall_intro generalize-i]
                                          @one-in-range |
                                            less_than(succ(ZERO), n)
                                            [using tautology two-letters]
                                          @power-steps-at-zero |
                                            apply(power(rho, k), numeral(succ(ZERO))) = apply(rho, apply(power(rho, k), numeral(ZERO)))
                                            [using specialize steps(ZERO) one-in-range]
                                          @power-at-one |
                                            apply(power(rho, k), numeral(succ(ZERO))) = apply(rho, numeral(k))
                                            [by rewrite power-at-zero power-steps-at-zero]
                                          @agree-at-one |
                                            apply(t, numeral(succ(ZERO))) = apply(power(rho, k), numeral(succ(ZERO)))
                                            [by rewrite power-at-one one-forward]

                                          // ρ^k fixes the outside
                                          @generalize-x |
                                            fix x: Element {
                                              @given-x-out |
                                                assume not member(x, segment(n)) {
                                                  @x-out |
                                                    not member(x, segment(n))
                                                    [by hypothesis given-x-out]
                                                  @rho-fixes-x |
                                                    apply(rho, x) = x
                                                    [using specialize rho-fixes-outside(x) x-out]
                                                  @conclusion-power-fixes-x |
                                                    apply(power(rho, k), x) = x
                                                    [using specialize powerFixesAFixedPoint(rho, x, k) rho-fixes-x]
                                                }
                                              @conclusion-fixes-clause |
                                                (not member(x, segment(n))) -> apply(power(rho, k), x) = x
                                                [by implies_intro given-x-out]
                                            }
                                          @power-fixes-outside |
                                            forall x: Element; (not member(x, segment(n))) -> apply(power(rho, k), x) = x
                                            [by forall_intro generalize-x]
                                          @conclusion-t-is-the-power |
                                            t = power(rho, k)
                                            [using specialize walkingTheLetters(rho, n, t, power(rho, k), rho, inverse(rho)) rotation two-letters motion forward-direction undo steps power-fixes-outside agree-at-zero agree-at-one]
                                        }
                                      @conclusion-given-one-forward |
                                        apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) -> t = power(rho, k)
                                        [by implies_intro given-one-forward]
                                    }
                                  @conclusion-given-zero-to-k |
                                    apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) -> t = power(rho, k)
                                    [by implies_intro given-zero-to-k]
                                }
                              @conclusion-at-k |
                                less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) -> t = power(rho, k)
                                [by implies_intro given-k-in-range]
                            }
                          @discharge-k |
                            forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) -> t = power(rho, k)
                            [by forall_intro generalize-k]
                        }
                      @conclusion-at-t |
                        isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) -> t = power(rho, k)
                        [by implies_intro given-motion]
                    }
                  @discharge-t |
                    forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) -> t = power(rho, k)
                    [by forall_intro generalize-t]
                }
              @conclusion-given-two-letters |
                less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) -> t = power(rho, k)
                [by implies_intro given-two-letters]
            }
          @conclusion-at-n |
            isTheRotation(rho, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) -> t = power(rho, k)
            [by implies_intro given-rotation]
        }
      @discharge-n |
        forall n: Nat; isTheRotation(rho, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) -> t = power(rho, k)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall rho: Fn; forall n: Nat; isTheRotation(rho, n) -> less_than(succ(ZERO), n) ->
      forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) ->
      apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k)) ->
      t = power(rho, k)
    [by forall_intro generalize-rho]
qed

// A motion sending letter 0 to letter k and letter 1 to ρ⁻¹(k) IS ρ^k ∘ σ: it steps backward
// (σ reverses ρ, ρ^k commutes with ρ⁻¹), fixes the outside, sends 0 to k and 1 to ρ⁻¹(k).
theorem motionSteppingBackwardIsAReflectedPower: forall rho: Fn; forall sigma: Fn; forall n: Nat;
  isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(ZERO), n) ->
  forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) ->
  apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) ->
  t = compose(power(rho, k), sigma)
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-sigma |
        fix sigma: Fn {
          @generalize-n |
            fix n: Nat {
              @given-rotation |
                assume isTheRotation(rho, n) {
                  @given-reflection |
                    assume isTheReflection(sigma, n) {
                      @given-two-letters |
                        assume less_than(succ(ZERO), n) {
                          @rotation |
                            isTheRotation(rho, n)
                            [by hypothesis given-rotation]
                          @reflection |
                            isTheReflection(sigma, n)
                            [by hypothesis given-reflection]
                          @two-letters |
                            less_than(succ(ZERO), n)
                            [by hypothesis given-two-letters]
                          @rho-invertible |
                            invertible(rho)
                            [using tautology rotation]
                          @rho-fixes-outside |
                            forall x: Element; (not member(x, segment(n))) -> apply(rho, x) = x
                            [using tautology rotation]
                          @sigma-fixes-zero |
                            apply(sigma, numeral(ZERO)) = numeral(ZERO)
                            [using tautology reflection]
                          @sigma-fixes-outside |
                            forall x: Element; (not member(x, segment(n))) -> apply(sigma, x) = x
                            [using tautology reflection]
                          @reverses |
                            forall i: Nat; less_than(succ(i), n) -> apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                            [using specialize reflectionReversesAdvance(rho, sigma, n) rotation reflection]
                          @inverse-is-inverse |
                            inverse(rho) = inverse(rho)
                            [by reflexivity]
                          @rho-is-rho |
                            rho = rho
                            [by reflexivity]
                          @backward-direction |
                            (inverse(rho) = rho and rho = inverse(rho)) or (inverse(rho) = inverse(rho) and rho = rho)
                            [using tautology inverse-is-inverse rho-is-rho]
                          @generalize-z |
                            fix z: Element {
                              @conclusion-undo-at-z |
                                apply(rho, apply(inverse(rho), z)) = z
                                [using specialize permutationUndoesInverse(rho, z)]
                            }
                          @undo |
                            forall z: Element; apply(rho, apply(inverse(rho), z)) = z
                            [by forall_intro generalize-z]
                          @generalize-t |
                            fix t: Fn {
                              @given-motion |
                                assume isARigidMotion(t, rho, n) {
                                  @motion |
                                    isARigidMotion(t, rho, n)
                                    [by hypothesis given-motion]
                                  @generalize-k |
                                    fix k: Nat {
                                      @given-k-in-range |
                                        assume less_than(k, n) {
                                          @given-zero-to-k |
                                            assume apply(t, numeral(ZERO)) = numeral(k) {
                                              @given-one-backward |
                                                assume apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) {
                                                  @k-in-range |
                                                    less_than(k, n)
                                                    [by hypothesis given-k-in-range]
                                                  @zero-to-k |
                                                    apply(t, numeral(ZERO)) = numeral(k)
                                                    [by hypothesis given-zero-to-k]
                                                  @one-backward |
                                                    apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k))
                                                    [by hypothesis given-one-backward]
                                                  @power-at-zero |
                                                    apply(power(rho, k), numeral(ZERO)) = numeral(k)
                                                    [using specialize rotationPowerAtZero(rho, n, k) rotation k-in-range]
                                                  @composite-at-zero |
                                                    apply(compose(power(rho, k), sigma), numeral(ZERO)) = apply(power(rho, k), apply(sigma, numeral(ZERO)))
                                                    [using specialize composeApply(power(rho, k), sigma, numeral(ZERO))]
                                                  @composite-at-zero-via-sigma |
                                                    apply(compose(power(rho, k), sigma), numeral(ZERO)) = apply(power(rho, k), numeral(ZERO))
                                                    [by rewrite sigma-fixes-zero composite-at-zero]
                                                  @composite-at-zero-is-k |
                                                    apply(compose(power(rho, k), sigma), numeral(ZERO)) = numeral(k)
                                                    [using chain composite-at-zero-via-sigma power-at-zero]
                                                  @agree-at-zero |
                                                    apply(t, numeral(ZERO)) = apply(compose(power(rho, k), sigma), numeral(ZERO))
                                                    [by rewrite composite-at-zero-is-k zero-to-k]

                                                  // ρ^k ∘ σ steps backward
                                                  @generalize-i |
                                                    fix i: Nat {
                                                      @given-succ-i-in-range |
                                                        assume less_than(succ(i), n) {
                                                          @succ-i-in-range |
                                                            less_than(succ(i), n)
                                                            [by hypothesis given-succ-i-in-range]
                                                          @sigma-reverses-at-i |
                                                            apply(sigma, numeral(succ(i))) = apply(inverse(rho), apply(sigma, numeral(i)))
                                                            [using specialize reverses(i) succ-i-in-range]
                                                          @composite-at-succ-i |
                                                            apply(compose(power(rho, k), sigma), numeral(succ(i))) = apply(power(rho, k), apply(sigma, numeral(succ(i))))
                                                            [using specialize composeApply(power(rho, k), sigma, numeral(succ(i)))]
                                                          @composite-at-i |
                                                            apply(compose(power(rho, k), sigma), numeral(i)) = apply(power(rho, k), apply(sigma, numeral(i)))
                                                            [using specialize composeApply(power(rho, k), sigma, numeral(i))]
                                                          @composite-at-succ-i-reversed |
                                                            apply(compose(power(rho, k), sigma), numeral(succ(i))) = apply(power(rho, k), apply(inverse(rho), apply(sigma, numeral(i))))
                                                            [by rewrite sigma-reverses-at-i composite-at-succ-i]
                                                          @commuted |
                                                            apply(power(rho, k), apply(inverse(rho), apply(sigma, numeral(i)))) = apply(inverse(rho), apply(power(rho, k), apply(sigma, numeral(i))))
                                                            [using specialize powerCommutesWithInverse(rho, k, apply(sigma, numeral(i))) rho-invertible]
                                                          @composite-at-succ-i-commuted |
                                                            apply(compose(power(rho, k), sigma), numeral(succ(i))) = apply(inverse(rho), apply(power(rho, k), apply(sigma, numeral(i))))
                                                            [using chain composite-at-succ-i-reversed commuted]
                                                          @conclusion-step-at-i |
                                                            apply(compose(power(rho, k), sigma), numeral(succ(i))) = apply(inverse(rho), apply(compose(power(rho, k), sigma), numeral(i)))
                                                            [by rewrite composite-at-i composite-at-succ-i-commuted]
                                                        }
                                                      @conclusion-step-clause |
                                                        less_than(succ(i), n) -> apply(compose(power(rho, k), sigma), numeral(succ(i))) = apply(inverse(rho), apply(compose(power(rho, k), sigma), numeral(i)))
                                                        [by implies_intro given-succ-i-in-range]
                                                    }
                                                  @steps |
                                                    forall i: Nat; less_than(succ(i), n) -> apply(compose(power(rho, k), sigma), numeral(succ(i))) = apply(inverse(rho), apply(compose(power(rho, k), sigma), numeral(i)))
                                                    [by forall_intro generalize-i]
                                                  @one-in-range |
                                                    less_than(succ(ZERO), n)
                                                    [using tautology two-letters]
                                                  @composite-steps-at-zero |
                                                    apply(compose(power(rho, k), sigma), numeral(succ(ZERO))) = apply(inverse(rho), apply(compose(power(rho, k), sigma), numeral(ZERO)))
                                                    [using specialize steps(ZERO) one-in-range]
                                                  @composite-at-one |
                                                    apply(compose(power(rho, k), sigma), numeral(succ(ZERO))) = apply(inverse(rho), numeral(k))
                                                    [by rewrite composite-at-zero-is-k composite-steps-at-zero]
                                                  @agree-at-one |
                                                    apply(t, numeral(succ(ZERO))) = apply(compose(power(rho, k), sigma), numeral(succ(ZERO)))
                                                    [by rewrite composite-at-one one-backward]

                                                  // ρ^k ∘ σ fixes the outside
                                                  @generalize-x |
                                                    fix x: Element {
                                                      @given-x-out |
                                                        assume not member(x, segment(n)) {
                                                          @x-out |
                                                            not member(x, segment(n))
                                                            [by hypothesis given-x-out]
                                                          @rho-fixes-x |
                                                            apply(rho, x) = x
                                                            [using specialize rho-fixes-outside(x) x-out]
                                                          @sigma-fixes-x |
                                                            apply(sigma, x) = x
                                                            [using specialize sigma-fixes-outside(x) x-out]
                                                          @power-fixes-x |
                                                            apply(power(rho, k), x) = x
                                                            [using specialize powerFixesAFixedPoint(rho, x, k) rho-fixes-x]
                                                          @composite-at-x |
                                                            apply(compose(power(rho, k), sigma), x) = apply(power(rho, k), apply(sigma, x))
                                                            [using specialize composeApply(power(rho, k), sigma, x)]
                                                          @composite-at-x-via-sigma |
                                                            apply(compose(power(rho, k), sigma), x) = apply(power(rho, k), x)
                                                            [by rewrite sigma-fixes-x composite-at-x]
                                                          @conclusion-composite-fixes-x |
                                                            apply(compose(power(rho, k), sigma), x) = x
                                                            [using chain composite-at-x-via-sigma power-fixes-x]
                                                        }
                                                      @conclusion-fixes-clause |
                                                        (not member(x, segment(n))) -> apply(compose(power(rho, k), sigma), x) = x
                                                        [by implies_intro given-x-out]
                                                    }
                                                  @composite-fixes-outside |
                                                    forall x: Element; (not member(x, segment(n))) -> apply(compose(power(rho, k), sigma), x) = x
                                                    [by forall_intro generalize-x]
                                                  @conclusion-t-is-the-reflected-power |
                                                    t = compose(power(rho, k), sigma)
                                                    [using specialize walkingTheLetters(rho, n, t, compose(power(rho, k), sigma), inverse(rho), rho) rotation two-letters motion backward-direction undo steps composite-fixes-outside agree-at-zero agree-at-one]
                                                }
                                              @conclusion-given-one-backward |
                                                apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
                                                [by implies_intro given-one-backward]
                                            }
                                          @conclusion-given-zero-to-k |
                                            apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
                                            [by implies_intro given-zero-to-k]
                                        }
                                      @conclusion-at-k |
                                        less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
                                        [by implies_intro given-k-in-range]
                                    }
                                  @discharge-k |
                                    forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
                                    [by forall_intro generalize-k]
                                }
                              @conclusion-at-t |
                                isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
                                [by implies_intro given-motion]
                            }
                          @discharge-t |
                            forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
                            [by forall_intro generalize-t]
                        }
                      @conclusion-given-two-letters |
                        less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
                        [by implies_intro given-two-letters]
                    }
                  @conclusion-given-reflection |
                    isTheReflection(sigma, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
                    [by implies_intro given-reflection]
                }
              @conclusion-at-n |
                isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
                [by implies_intro given-rotation]
            }
          @discharge-n |
            forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
            [by forall_intro generalize-n]
        }
      @discharge-sigma |
        forall sigma: Fn; forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) -> apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) -> t = compose(power(rho, k), sigma)
        [by forall_intro generalize-sigma]
    }
  @conclusion |
    forall rho: Fn; forall sigma: Fn; forall n: Nat;
      isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(ZERO), n) ->
      forall t: Fn; isARigidMotion(t, rho, n) -> forall k: Nat; less_than(k, n) ->
      apply(t, numeral(ZERO)) = numeral(k) -> apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k)) ->
      t = compose(power(rho, k), sigma)
    [by forall_intro generalize-rho]
qed

// EXHAUSTION: every rigid motion is ρ^k or ρ^k ∘ σ for the k with t(0) = k. Letter 1 is
// adjacent to letter 0, so t(1) is adjacent to t(0) = k: it is ρ(k) or ρ⁻¹(k).
theorem everyMotionIsARotationOrAReflection: forall rho: Fn; forall sigma: Fn; forall n: Nat;
  isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(ZERO), n) ->
  forall t: Fn; isARigidMotion(t, rho, n) ->
  exists k: Nat; less_than(k, n) and (t = power(rho, k) or t = compose(power(rho, k), sigma))
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-sigma |
        fix sigma: Fn {
          @generalize-n |
            fix n: Nat {
              @given-rotation |
                assume isTheRotation(rho, n) {
                  @given-reflection |
                    assume isTheReflection(sigma, n) {
                      @given-two-letters |
                        assume less_than(succ(ZERO), n) {
                          @rotation |
                            isTheRotation(rho, n)
                            [by hypothesis given-rotation]
                          @reflection |
                            isTheReflection(sigma, n)
                            [by hypothesis given-reflection]
                          @two-letters |
                            less_than(succ(ZERO), n)
                            [by hypothesis given-two-letters]
                          @advances |
                            forall i: Nat; less_than(succ(i), n) -> apply(rho, numeral(i)) = numeral(succ(i))
                            [using tautology rotation]
                          @zero-advances |
                            apply(rho, numeral(ZERO)) = numeral(succ(ZERO))
                            [using specialize advances(ZERO) two-letters]
                          @first-two-adjacent |
                            adjacent(rho, numeral(ZERO), numeral(succ(ZERO)))
                            [using tautology zero-advances]
                          @zero-below-one |
                            less_than(ZERO, succ(ZERO))
                            [using specialize zeroBelowSucc(ZERO)]
                          @zero-in-range |
                            less_than(ZERO, n)
                            [using specialize lessThanTransitive(ZERO, succ(ZERO), n) zero-below-one two-letters]
                          @zero-membership |
                            member(numeral(ZERO), segment(n)) iff less_than(ZERO, n)
                            [using specialize numeralInSegment(n, ZERO)]
                          @zero-in |
                            member(numeral(ZERO), segment(n))
                            [using tautology zero-membership zero-in-range]
                          @one-membership |
                            member(numeral(succ(ZERO)), segment(n)) iff less_than(succ(ZERO), n)
                            [using specialize numeralInSegment(n, succ(ZERO))]
                          @one-in |
                            member(numeral(succ(ZERO)), segment(n))
                            [using tautology one-membership two-letters]
                          @generalize-t |
                            fix t: Fn {
                              @given-motion |
                                assume isARigidMotion(t, rho, n) {
                                  @motion |
                                    isARigidMotion(t, rho, n)
                                    [by hypothesis given-motion]
                                  @t-permutes |
                                    permutesTheSegment(t, n)
                                    [using tautology motion]
                                  @t-preserves-adjacency |
                                    forall x: Element; forall y: Element; member(x, segment(n)) -> member(y, segment(n)) -> adjacent(rho, x, y) -> adjacent(rho, apply(t, x), apply(t, y))
                                    [using tautology motion]
                                  @t-maps-into |
                                    forall x: Element; member(x, segment(n)) -> member(apply(t, x), segment(n))
                                    [using tautology t-permutes]
                                  @image-of-zero-in |
                                    member(apply(t, numeral(ZERO)), segment(n))
                                    [using specialize t-maps-into(numeral(ZERO)) zero-in]
                                  @image-of-zero-membership |
                                    member(apply(t, numeral(ZERO)), segment(n)) iff (exists k: Nat; less_than(k, n) and apply(t, numeral(ZERO)) = numeral(k))
                                    [using specialize segmentMember(n, apply(t, numeral(ZERO)))]
                                  @image-of-zero-is-a-letter |
                                    exists k: Nat; less_than(k, n) and apply(t, numeral(ZERO)) = numeral(k)
                                    [using tautology image-of-zero-membership image-of-zero-in]
                                  @images-adjacent |
                                    adjacent(rho, apply(t, numeral(ZERO)), apply(t, numeral(succ(ZERO))))
                                    [using specialize t-preserves-adjacency(numeral(ZERO), numeral(succ(ZERO))) zero-in one-in first-two-adjacent]
                                  @with-letter-k |
                                    unpack k: Nat from image-of-zero-is-a-letter {
                                      @letter-facts |
                                        less_than(k, n) and apply(t, numeral(ZERO)) = numeral(k)
                                        [by hypothesis with-letter-k]
                                      @k-in-range |
                                        less_than(k, n)
                                        [by and_elim_left letter-facts]
                                      @zero-to-k |
                                        apply(t, numeral(ZERO)) = numeral(k)
                                        [by and_elim_right letter-facts]
                                      @images-adjacent-at-k |
                                        adjacent(rho, numeral(k), apply(t, numeral(succ(ZERO))))
                                        [by rewrite zero-to-k images-adjacent]
                                      @conclusion-shape |
                                        t = power(rho, k) or t = compose(power(rho, k), sigma)
                                        case images-adjacent-at-k {
                                          @when-forward |
                                            assume apply(rho, numeral(k)) = apply(t, numeral(succ(ZERO))) {
                                              @forward |
                                                apply(rho, numeral(k)) = apply(t, numeral(succ(ZERO)))
                                                [by hypothesis when-forward]
                                              @one-forward |
                                                apply(t, numeral(succ(ZERO))) = apply(rho, numeral(k))
                                                [by symmetry forward]
                                              @t-is-the-power |
                                                t = power(rho, k)
                                                [using specialize motionSteppingForwardIsAPower(rho, n, t, k) rotation two-letters motion k-in-range zero-to-k one-forward]
                                              @conclusion-when-forward |
                                                t = power(rho, k) or t = compose(power(rho, k), sigma)
                                                [by or_intro_left t-is-the-power]
                                            }
                                          @when-backward |
                                            assume apply(rho, apply(t, numeral(succ(ZERO)))) = numeral(k) {
                                              @backward |
                                                apply(rho, apply(t, numeral(succ(ZERO)))) = numeral(k)
                                                [by hypothesis when-backward]
                                              @inverse-undoes |
                                                apply(inverse(rho), apply(rho, apply(t, numeral(succ(ZERO))))) = apply(t, numeral(succ(ZERO)))
                                                [using specialize inverseUndoesPermutation(rho, apply(t, numeral(succ(ZERO))))]
                                              @back-from-k |
                                                apply(inverse(rho), numeral(k)) = apply(t, numeral(succ(ZERO)))
                                                [by rewrite backward inverse-undoes]
                                              @one-backward |
                                                apply(t, numeral(succ(ZERO))) = apply(inverse(rho), numeral(k))
                                                [by symmetry back-from-k]
                                              @t-is-the-reflected-power |
                                                t = compose(power(rho, k), sigma)
                                                [using specialize motionSteppingBackwardIsAReflectedPower(rho, sigma, n, t, k) rotation reflection two-letters motion k-in-range zero-to-k one-backward]
                                              @conclusion-when-backward |
                                                t = power(rho, k) or t = compose(power(rho, k), sigma)
                                                [by or_intro_right t-is-the-reflected-power]
                                            }
                                        }
                                      @k-in-range-and-shape |
                                        less_than(k, n) and (t = power(rho, k) or t = compose(power(rho, k), sigma))
                                        [by and_intro k-in-range conclusion-shape]
                                      @conclusion-witness-k |
                                        exists k2: Nat; less_than(k2, n) and (t = power(rho, k2) or t = compose(power(rho, k2), sigma))
                                        [by exists_intro(k) k-in-range-and-shape]
                                    }
                                  @conclusion-exhausted |
                                    exists k2: Nat; less_than(k2, n) and (t = power(rho, k2) or t = compose(power(rho, k2), sigma))
                                    [by exists_elim with-letter-k]
                                }
                              @conclusion-at-t |
                                isARigidMotion(t, rho, n) -> exists k2: Nat; less_than(k2, n) and (t = power(rho, k2) or t = compose(power(rho, k2), sigma))
                                [by implies_intro given-motion]
                            }
                          @discharge-t |
                            forall t: Fn; isARigidMotion(t, rho, n) -> exists k2: Nat; less_than(k2, n) and (t = power(rho, k2) or t = compose(power(rho, k2), sigma))
                            [by forall_intro generalize-t]
                        }
                      @conclusion-given-two-letters |
                        less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> exists k2: Nat; less_than(k2, n) and (t = power(rho, k2) or t = compose(power(rho, k2), sigma))
                        [by implies_intro given-two-letters]
                    }
                  @conclusion-given-reflection |
                    isTheReflection(sigma, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> exists k2: Nat; less_than(k2, n) and (t = power(rho, k2) or t = compose(power(rho, k2), sigma))
                    [by implies_intro given-reflection]
                }
              @conclusion-at-n |
                isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> exists k2: Nat; less_than(k2, n) and (t = power(rho, k2) or t = compose(power(rho, k2), sigma))
                [by implies_intro given-rotation]
            }
          @discharge-n |
            forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> exists k2: Nat; less_than(k2, n) and (t = power(rho, k2) or t = compose(power(rho, k2), sigma))
            [by forall_intro generalize-n]
        }
      @discharge-sigma |
        forall sigma: Fn; forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(ZERO), n) -> forall t: Fn; isARigidMotion(t, rho, n) -> exists k2: Nat; less_than(k2, n) and (t = power(rho, k2) or t = compose(power(rho, k2), sigma))
        [by forall_intro generalize-sigma]
    }
  @conclusion |
    forall rho: Fn; forall sigma: Fn; forall n: Nat;
      isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(ZERO), n) ->
      forall t: Fn; isARigidMotion(t, rho, n) ->
      exists k: Nat; less_than(k, n) and (t = power(rho, k) or t = compose(power(rho, k), sigma))
    [by forall_intro generalize-rho]
qed

// -- listing the motions --------------------------------------------------------------------------

// A sequence whose first m entries are f^0, …, f^(m-1): induction on m, appending f^m.
theorem powersSequenceExists: forall f: Fn; invertible(f) -> forall m: Nat;
  exists w: Seq; forall k: Nat; less_than(k, m) -> at(w, k) = power(f, k)
proof
  @generalize-f |
    fix f: Fn {
      @given-invertible |
        assume invertible(f) {
          @f-invertible |
            invertible(f)
            [by hypothesis given-invertible]
          @identity-invertible |
            invertible(identityFn)
            [by cite identityIsAPermutation]
          @some-sequence-exists |
            exists w: Seq; at(w, ZERO) = identityFn and permutation_sequence.productUpTo(w, succ(ZERO)) = identityFn
            [using specialize seqSingleton(identityFn) identity-invertible]
          @base-case-proof |
            unpack w: Seq from some-sequence-exists {
              @vacuous |
                fix k: Nat {
                  @nothing-below-zero |
                    not less_than(k, ZERO)
                    [using specialize notLessThanZero(k)]
                  @conclusion-vacuous-entry |
                    less_than(k, ZERO) -> at(w, k) = power(f, k)
                    [using tautology nothing-below-zero]
                }
              @no-entries |
                forall k: Nat; less_than(k, ZERO) -> at(w, k) = power(f, k)
                [by forall_intro vacuous]
              @conclusion-base-witness |
                exists w2: Seq; forall k: Nat; less_than(k, ZERO) -> at(w2, k) = power(f, k)
                [by exists_intro(w) no-entries]
            }
          @base-case |
            exists w2: Seq; forall k: Nat; less_than(k, ZERO) -> at(w2, k) = power(f, k)
            [by exists_elim base-case-proof]
          @induction-step |
            fix m: Nat {
              @given-inductive-hypothesis |
                assume exists w2: Seq; forall k: Nat; less_than(k, m) -> at(w2, k) = power(f, k) {
                  @inductive-hypothesis |
                    exists w2: Seq; forall k: Nat; less_than(k, m) -> at(w2, k) = power(f, k)
                    [by hypothesis given-inductive-hypothesis]
                  @with-prefix-w |
                    unpack w: Seq from inductive-hypothesis {
                      @prefix-entries |
                        forall k: Nat; less_than(k, m) -> at(w, k) = power(f, k)
                        [by hypothesis with-prefix-w]
                      @next-power-invertible |
                        invertible(power(f, m))
                        [using specialize powerIsAPermutation(f, m) f-invertible]
                      @singleton-exists |
                        exists s: Seq; at(s, ZERO) = power(f, m) and permutation_sequence.productUpTo(s, succ(ZERO)) = power(f, m)
                        [using specialize seqSingleton(power(f, m)) next-power-invertible]
                      @with-singleton-s |
                        unpack s: Seq from singleton-exists {
                          @singleton-facts |
                            at(s, ZERO) = power(f, m) and permutation_sequence.productUpTo(s, succ(ZERO)) = power(f, m)
                            [by hypothesis with-singleton-s]
                          @singleton-head |
                            at(s, ZERO) = power(f, m)
                            [by and_elim_left singleton-facts]
                          @concatenation-exists |
                            exists u: Seq; (forall i: Nat; less_than(i, m) -> at(u, i) = at(w, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(m, i)) = at(s, i)) and permutation_sequence.productUpTo(u, add(m, succ(ZERO))) = compose(permutation_sequence.productUpTo(w, m), permutation_sequence.productUpTo(s, succ(ZERO)))
                            [using specialize seqConcat(w, s, m, succ(ZERO))]
                          @with-concatenation-u |
                            unpack u: Seq from concatenation-exists {
                              @concatenation-facts |
                                (forall i: Nat; less_than(i, m) -> at(u, i) = at(w, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(m, i)) = at(s, i)) and permutation_sequence.productUpTo(u, add(m, succ(ZERO))) = compose(permutation_sequence.productUpTo(w, m), permutation_sequence.productUpTo(s, succ(ZERO)))
                                [by hypothesis with-concatenation-u]
                              @agreement-pair |
                                (forall i: Nat; less_than(i, m) -> at(u, i) = at(w, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(m, i)) = at(s, i))
                                [by and_elim_left concatenation-facts]
                              @prefix-agrees |
                                forall i: Nat; less_than(i, m) -> at(u, i) = at(w, i)
                                [by and_elim_left agreement-pair]
                              @block-agrees |
                                forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(m, i)) = at(s, i)
                                [by and_elim_right agreement-pair]
                              @zero-below-one |
                                less_than(ZERO, succ(ZERO))
                                [using specialize lessThanSelf(ZERO)]
                              @u-at-m-plus-zero |
                                at(u, add(m, ZERO)) = at(s, ZERO)
                                [using specialize block-agrees(ZERO) zero-below-one]
                              @m-plus-zero-is-m |
                                add(m, ZERO) = m
                                [using specialize addZeroRight(m)]
                              @u-at-m |
                                at(u, m) = at(s, ZERO)
                                [by rewrite m-plus-zero-is-m u-at-m-plus-zero]
                              @last-entry-is-the-next-power |
                                at(u, m) = power(f, m)
                                [using chain u-at-m singleton-head]
                              @generalize-k |
                                fix k: Nat {
                                  @given-k-in-range |
                                    assume less_than(k, succ(m)) {
                                      @k-in-range |
                                        less_than(k, succ(m))
                                        [by hypothesis given-k-in-range]
                                      @k-splits |
                                        less_than(k, m) or k = m
                                        [using specialize lessThanSuccSplit(k, m) k-in-range]
                                      @conclusion-entry-k |
                                        at(u, k) = power(f, k)
                                        case k-splits {
                                          @when-old |
                                            assume less_than(k, m) {
                                              @k-old |
                                                less_than(k, m)
                                                [by hypothesis when-old]
                                              @entry-is-old-entry |
                                                at(u, k) = at(w, k)
                                                [using specialize prefix-agrees(k) k-old]
                                              @old-entry-is-the-power |
                                                at(w, k) = power(f, k)
                                                [using specialize prefix-entries(k) k-old]
                                              @conclusion-when-old |
                                                at(u, k) = power(f, k)
                                                [using chain entry-is-old-entry old-entry-is-the-power]
                                            }
                                          @when-new |
                                            assume k = m {
                                              @k-is-m |
                                                k = m
                                                [by hypothesis when-new]
                                              @conclusion-when-new |
                                                at(u, k) = power(f, k)
                                                [by rewrite k-is-m last-entry-is-the-next-power]
                                            }
                                        }
                                    }
                                  @conclusion-entry-clause |
                                    less_than(k, succ(m)) -> at(u, k) = power(f, k)
                                    [by implies_intro given-k-in-range]
                                }
                              @all-entries |
                                forall k: Nat; less_than(k, succ(m)) -> at(u, k) = power(f, k)
                                [by forall_intro generalize-k]
                              @conclusion-witness-u |
                                exists w2: Seq; forall k: Nat; less_than(k, succ(m)) -> at(w2, k) = power(f, k)
                                [by exists_intro(u) all-entries]
                            }
                          @conclusion-with-u |
                            exists w2: Seq; forall k: Nat; less_than(k, succ(m)) -> at(w2, k) = power(f, k)
                            [by exists_elim with-concatenation-u]
                        }
                      @conclusion-with-s |
                        exists w2: Seq; forall k: Nat; less_than(k, succ(m)) -> at(w2, k) = power(f, k)
                        [by exists_elim with-singleton-s]
                    }
                  @conclusion-step |
                    exists w2: Seq; forall k: Nat; less_than(k, succ(m)) -> at(w2, k) = power(f, k)
                    [by exists_elim with-prefix-w]
                }
              @induction-step-at-m |
                (exists w2: Seq; forall k: Nat; less_than(k, m) -> at(w2, k) = power(f, k)) -> (exists w2: Seq; forall k: Nat; less_than(k, succ(m)) -> at(w2, k) = power(f, k))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-for-all-m |
            forall m: Nat; (exists w2: Seq; forall k: Nat; less_than(k, m) -> at(w2, k) = power(f, k)) -> (exists w2: Seq; forall k: Nat; less_than(k, succ(m)) -> at(w2, k) = power(f, k))
            [by forall_intro induction-step]
          @conclusion-for-all-m |
            forall m: Nat; exists w: Seq; forall k: Nat; less_than(k, m) -> at(w, k) = power(f, k)
            [using instantiation induction((fun m: Nat => exists w2: Seq; forall k: Nat; less_than(k, m) -> at(w2, k) = power(f, k))) base-case induction-step-for-all-m]
        }
      @conclusion-at-f |
        invertible(f) -> forall m: Nat; exists w: Seq; forall k: Nat; less_than(k, m) -> at(w, k) = power(f, k)
        [by implies_intro given-invertible]
    }
  @conclusion |
    forall f: Fn; invertible(f) -> forall m: Nat; exists w: Seq; forall k: Nat; less_than(k, m) -> at(w, k) = power(f, k)
    [by forall_intro generalize-f]
qed

// A sequence whose first m entries are w_0 ∘ t, …, w_(m-1) ∘ t (the mirror of the sequence
// theory's mappedSequenceExists): induction on m, appending w_m ∘ t.
theorem rightMappedSequenceExists: forall t: Fn; invertible(t) -> forall w: Seq; forall m: Nat;
  exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = compose(at(w, j), t)
proof
  @generalize-t |
    fix t: Fn {
      @given-invertible |
        assume invertible(t) {
          @t-invertible |
            invertible(t)
            [by hypothesis given-invertible]
          @generalize-w |
            fix w: Seq {
              @identity-invertible |
                invertible(identityFn)
                [by cite identityIsAPermutation]
              @some-sequence-exists |
                exists v: Seq; at(v, ZERO) = identityFn and permutation_sequence.productUpTo(v, succ(ZERO)) = identityFn
                [using specialize seqSingleton(identityFn) identity-invertible]
              @base-case-proof |
                unpack v: Seq from some-sequence-exists {
                  @vacuous |
                    fix j: Nat {
                      @nothing-below-zero |
                        not less_than(j, ZERO)
                        [using specialize notLessThanZero(j)]
                      @conclusion-vacuous-entry |
                        less_than(j, ZERO) -> at(v, j) = compose(at(w, j), t)
                        [using tautology nothing-below-zero]
                    }
                  @no-entries |
                    forall j: Nat; less_than(j, ZERO) -> at(v, j) = compose(at(w, j), t)
                    [by forall_intro vacuous]
                  @conclusion-base-witness |
                    exists v2: Seq; forall j: Nat; less_than(j, ZERO) -> at(v2, j) = compose(at(w, j), t)
                    [by exists_intro(v) no-entries]
                }
              @base-case |
                exists v2: Seq; forall j: Nat; less_than(j, ZERO) -> at(v2, j) = compose(at(w, j), t)
                [by exists_elim base-case-proof]
              @induction-step |
                fix k: Nat {
                  @given-inductive-hypothesis |
                    assume exists v2: Seq; forall j: Nat; less_than(j, k) -> at(v2, j) = compose(at(w, j), t) {
                      @inductive-hypothesis |
                        exists v2: Seq; forall j: Nat; less_than(j, k) -> at(v2, j) = compose(at(w, j), t)
                        [by hypothesis given-inductive-hypothesis]
                      @with-prefix-v |
                        unpack v: Seq from inductive-hypothesis {
                          @prefix-entries |
                            forall j: Nat; less_than(j, k) -> at(v, j) = compose(at(w, j), t)
                            [by hypothesis with-prefix-v]
                          @entry-k-invertible |
                            invertible(at(w, k))
                            [using specialize atIsAPermutation(w, k)]
                          @mapped-entry-invertible |
                            invertible(compose(at(w, k), t))
                            [using specialize composeIsAPermutation(at(w, k), t) entry-k-invertible t-invertible]
                          @singleton-exists |
                            exists s: Seq; at(s, ZERO) = compose(at(w, k), t) and permutation_sequence.productUpTo(s, succ(ZERO)) = compose(at(w, k), t)
                            [using specialize seqSingleton(compose(at(w, k), t)) mapped-entry-invertible]
                          @with-singleton-s |
                            unpack s: Seq from singleton-exists {
                              @singleton-facts |
                                at(s, ZERO) = compose(at(w, k), t) and permutation_sequence.productUpTo(s, succ(ZERO)) = compose(at(w, k), t)
                                [by hypothesis with-singleton-s]
                              @singleton-head |
                                at(s, ZERO) = compose(at(w, k), t)
                                [by and_elim_left singleton-facts]
                              @concatenation-exists |
                                exists u: Seq; (forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i)) and permutation_sequence.productUpTo(u, add(k, succ(ZERO))) = compose(permutation_sequence.productUpTo(v, k), permutation_sequence.productUpTo(s, succ(ZERO)))
                                [using specialize seqConcat(v, s, k, succ(ZERO))]
                              @with-concatenation-u |
                                unpack u: Seq from concatenation-exists {
                                  @concatenation-facts |
                                    (forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i)) and permutation_sequence.productUpTo(u, add(k, succ(ZERO))) = compose(permutation_sequence.productUpTo(v, k), permutation_sequence.productUpTo(s, succ(ZERO)))
                                    [by hypothesis with-concatenation-u]
                                  @agreement-pair |
                                    (forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i))
                                    [by and_elim_left concatenation-facts]
                                  @prefix-agrees |
                                    forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)
                                    [by and_elim_left agreement-pair]
                                  @block-agrees |
                                    forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i)
                                    [by and_elim_right agreement-pair]
                                  @zero-below-one |
                                    less_than(ZERO, succ(ZERO))
                                    [using specialize lessThanSelf(ZERO)]
                                  @u-at-k-plus-zero |
                                    at(u, add(k, ZERO)) = at(s, ZERO)
                                    [using specialize block-agrees(ZERO) zero-below-one]
                                  @k-plus-zero-is-k |
                                    add(k, ZERO) = k
                                    [using specialize addZeroRight(k)]
                                  @u-at-k |
                                    at(u, k) = at(s, ZERO)
                                    [by rewrite k-plus-zero-is-k u-at-k-plus-zero]
                                  @last-entry-is-the-mapped-entry |
                                    at(u, k) = compose(at(w, k), t)
                                    [using chain u-at-k singleton-head]
                                  @generalize-j |
                                    fix j: Nat {
                                      @given-j-in-range |
                                        assume less_than(j, succ(k)) {
                                          @j-in-range |
                                            less_than(j, succ(k))
                                            [by hypothesis given-j-in-range]
                                          @j-splits |
                                            less_than(j, k) or j = k
                                            [using specialize lessThanSuccSplit(j, k) j-in-range]
                                          @conclusion-entry-j |
                                            at(u, j) = compose(at(w, j), t)
                                            case j-splits {
                                              @when-old |
                                                assume less_than(j, k) {
                                                  @j-old |
                                                    less_than(j, k)
                                                    [by hypothesis when-old]
                                                  @entry-is-old-entry |
                                                    at(u, j) = at(v, j)
                                                    [using specialize prefix-agrees(j) j-old]
                                                  @old-entry-is-mapped |
                                                    at(v, j) = compose(at(w, j), t)
                                                    [using specialize prefix-entries(j) j-old]
                                                  @conclusion-when-old |
                                                    at(u, j) = compose(at(w, j), t)
                                                    [using chain entry-is-old-entry old-entry-is-mapped]
                                                }
                                              @when-new |
                                                assume j = k {
                                                  @j-is-k |
                                                    j = k
                                                    [by hypothesis when-new]
                                                  @conclusion-when-new |
                                                    at(u, j) = compose(at(w, j), t)
                                                    [by rewrite j-is-k last-entry-is-the-mapped-entry]
                                                }
                                            }
                                        }
                                      @conclusion-entry-clause |
                                        less_than(j, succ(k)) -> at(u, j) = compose(at(w, j), t)
                                        [by implies_intro given-j-in-range]
                                    }
                                  @all-entries |
                                    forall j: Nat; less_than(j, succ(k)) -> at(u, j) = compose(at(w, j), t)
                                    [by forall_intro generalize-j]
                                  @conclusion-witness-u |
                                    exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(at(w, j), t)
                                    [by exists_intro(u) all-entries]
                                }
                              @conclusion-with-u |
                                exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(at(w, j), t)
                                [by exists_elim with-concatenation-u]
                            }
                          @conclusion-with-s |
                            exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(at(w, j), t)
                            [by exists_elim with-singleton-s]
                        }
                      @conclusion-step |
                        exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(at(w, j), t)
                        [by exists_elim with-prefix-v]
                    }
                  @induction-step-at-k |
                    (exists v2: Seq; forall j: Nat; less_than(j, k) -> at(v2, j) = compose(at(w, j), t)) -> (exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(at(w, j), t))
                    [by implies_intro given-inductive-hypothesis]
                }
              @induction-step-for-all-k |
                forall k: Nat; (exists v2: Seq; forall j: Nat; less_than(j, k) -> at(v2, j) = compose(at(w, j), t)) -> (exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(at(w, j), t))
                [by forall_intro induction-step]
              @conclusion-for-all-m |
                forall m: Nat; exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = compose(at(w, j), t)
                [using instantiation induction((fun k: Nat => exists v2: Seq; forall j: Nat; less_than(j, k) -> at(v2, j) = compose(at(w, j), t))) base-case induction-step-for-all-k]
            }
          @discharge-w |
            forall w: Seq; forall m: Nat; exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = compose(at(w, j), t)
            [by forall_intro generalize-w]
        }
      @conclusion-at-t |
        invertible(t) -> forall w: Seq; forall m: Nat; exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = compose(at(w, j), t)
        [by implies_intro given-invertible]
    }
  @conclusion |
    forall t: Fn; invertible(t) -> forall w: Seq; forall m: Nat;
      exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = compose(at(w, j), t)
    [by forall_intro generalize-t]
qed

// The listing of D_n: the n powers of ρ, then the n powers of ρ composed with σ.
theorem dihedralListingExists: forall rho: Fn; forall sigma: Fn; forall n: Nat; invertible(rho) -> invertible(sigma) ->
  exists w: Seq;
  (forall k: Nat; less_than(k, n) -> at(w, k) = power(rho, k))
  and (forall k: Nat; less_than(k, n) -> at(w, add(n, k)) = compose(power(rho, k), sigma))
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-sigma |
        fix sigma: Fn {
          @generalize-n |
            fix n: Nat {
              @given-rho-invertible |
                assume invertible(rho) {
                  @given-sigma-invertible |
                    assume invertible(sigma) {
                      @rho-invertible |
                        invertible(rho)
                        [by hypothesis given-rho-invertible]
                      @sigma-invertible |
                        invertible(sigma)
                        [by hypothesis given-sigma-invertible]
                      @powers-exist |
                        exists w: Seq; forall k: Nat; less_than(k, n) -> at(w, k) = power(rho, k)
                        [using specialize powersSequenceExists(rho, n) rho-invertible]
                      @with-powers-w |
                        unpack w: Seq from powers-exist {
                          @powers |
                            forall k: Nat; less_than(k, n) -> at(w, k) = power(rho, k)
                            [by hypothesis with-powers-w]
                          @reflected-exist |
                            exists v: Seq; forall j: Nat; less_than(j, n) -> at(v, j) = compose(at(w, j), sigma)
                            [using specialize rightMappedSequenceExists(sigma, w, n) sigma-invertible]
                          @with-reflected-v |
                            unpack v: Seq from reflected-exist {
                              @reflected |
                                forall j: Nat; less_than(j, n) -> at(v, j) = compose(at(w, j), sigma)
                                [by hypothesis with-reflected-v]
                              @concatenation-exists |
                                exists u: Seq; (forall i: Nat; less_than(i, n) -> at(u, i) = at(w, i)) and (forall i: Nat; less_than(i, n) -> at(u, add(n, i)) = at(v, i)) and permutation_sequence.productUpTo(u, add(n, n)) = compose(permutation_sequence.productUpTo(w, n), permutation_sequence.productUpTo(v, n))
                                [using specialize seqConcat(w, v, n, n)]
                              @with-concatenation-u |
                                unpack u: Seq from concatenation-exists {
                                  @concatenation-facts |
                                    (forall i: Nat; less_than(i, n) -> at(u, i) = at(w, i)) and (forall i: Nat; less_than(i, n) -> at(u, add(n, i)) = at(v, i)) and permutation_sequence.productUpTo(u, add(n, n)) = compose(permutation_sequence.productUpTo(w, n), permutation_sequence.productUpTo(v, n))
                                    [by hypothesis with-concatenation-u]
                                  @agreement-pair |
                                    (forall i: Nat; less_than(i, n) -> at(u, i) = at(w, i)) and (forall i: Nat; less_than(i, n) -> at(u, add(n, i)) = at(v, i))
                                    [by and_elim_left concatenation-facts]
                                  @prefix-agrees |
                                    forall i: Nat; less_than(i, n) -> at(u, i) = at(w, i)
                                    [by and_elim_left agreement-pair]
                                  @block-agrees |
                                    forall i: Nat; less_than(i, n) -> at(u, add(n, i)) = at(v, i)
                                    [by and_elim_right agreement-pair]
                                  @generalize-k-for-rotations |
                                    fix k: Nat {
                                      @given-k-in-range |
                                        assume less_than(k, n) {
                                          @k-in-range |
                                            less_than(k, n)
                                            [by hypothesis given-k-in-range]
                                          @entry-is-power-entry |
                                            at(u, k) = at(w, k)
                                            [using specialize prefix-agrees(k) k-in-range]
                                          @power-entry |
                                            at(w, k) = power(rho, k)
                                            [using specialize powers(k) k-in-range]
                                          @conclusion-rotation-entry |
                                            at(u, k) = power(rho, k)
                                            [using chain entry-is-power-entry power-entry]
                                        }
                                      @conclusion-rotation-clause |
                                        less_than(k, n) -> at(u, k) = power(rho, k)
                                        [by implies_intro given-k-in-range]
                                    }
                                  @rotation-entries |
                                    forall k: Nat; less_than(k, n) -> at(u, k) = power(rho, k)
                                    [by forall_intro generalize-k-for-rotations]
                                  @generalize-k-for-reflections |
                                    fix k: Nat {
                                      @given-k-in-range |
                                        assume less_than(k, n) {
                                          @k-in-range |
                                            less_than(k, n)
                                            [by hypothesis given-k-in-range]
                                          @entry-is-reflected-entry |
                                            at(u, add(n, k)) = at(v, k)
                                            [using specialize block-agrees(k) k-in-range]
                                          @reflected-entry |
                                            at(v, k) = compose(at(w, k), sigma)
                                            [using specialize reflected(k) k-in-range]
                                          @power-entry |
                                            at(w, k) = power(rho, k)
                                            [using specialize powers(k) k-in-range]
                                          @reflected-entry-is-a-reflected-power |
                                            at(v, k) = compose(power(rho, k), sigma)
                                            [by rewrite power-entry reflected-entry]
                                          @conclusion-reflection-entry |
                                            at(u, add(n, k)) = compose(power(rho, k), sigma)
                                            [using chain entry-is-reflected-entry reflected-entry-is-a-reflected-power]
                                        }
                                      @conclusion-reflection-clause |
                                        less_than(k, n) -> at(u, add(n, k)) = compose(power(rho, k), sigma)
                                        [by implies_intro given-k-in-range]
                                    }
                                  @reflection-entries |
                                    forall k: Nat; less_than(k, n) -> at(u, add(n, k)) = compose(power(rho, k), sigma)
                                    [by forall_intro generalize-k-for-reflections]
                                  @both-halves |
                                    (forall k: Nat; less_than(k, n) -> at(u, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(u, add(n, k)) = compose(power(rho, k), sigma))
                                    [by and_intro rotation-entries reflection-entries]
                                  @conclusion-witness-u |
                                    exists w2: Seq; (forall k: Nat; less_than(k, n) -> at(w2, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(w2, add(n, k)) = compose(power(rho, k), sigma))
                                    [by exists_intro(u) both-halves]
                                }
                              @conclusion-with-u |
                                exists w2: Seq; (forall k: Nat; less_than(k, n) -> at(w2, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(w2, add(n, k)) = compose(power(rho, k), sigma))
                                [by exists_elim with-concatenation-u]
                            }
                          @conclusion-with-v |
                            exists w2: Seq; (forall k: Nat; less_than(k, n) -> at(w2, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(w2, add(n, k)) = compose(power(rho, k), sigma))
                            [by exists_elim with-reflected-v]
                        }
                      @conclusion-listing |
                        exists w2: Seq; (forall k: Nat; less_than(k, n) -> at(w2, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(w2, add(n, k)) = compose(power(rho, k), sigma))
                        [by exists_elim with-powers-w]
                    }
                  @conclusion-given-sigma |
                    invertible(sigma) -> exists w2: Seq; (forall k: Nat; less_than(k, n) -> at(w2, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(w2, add(n, k)) = compose(power(rho, k), sigma))
                    [by implies_intro given-sigma-invertible]
                }
              @conclusion-at-n |
                invertible(rho) -> invertible(sigma) -> exists w2: Seq; (forall k: Nat; less_than(k, n) -> at(w2, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(w2, add(n, k)) = compose(power(rho, k), sigma))
                [by implies_intro given-rho-invertible]
            }
          @discharge-n |
            forall n: Nat; invertible(rho) -> invertible(sigma) -> exists w2: Seq; (forall k: Nat; less_than(k, n) -> at(w2, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(w2, add(n, k)) = compose(power(rho, k), sigma))
            [by forall_intro generalize-n]
        }
      @discharge-sigma |
        forall sigma: Fn; forall n: Nat; invertible(rho) -> invertible(sigma) -> exists w2: Seq; (forall k: Nat; less_than(k, n) -> at(w2, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(w2, add(n, k)) = compose(power(rho, k), sigma))
        [by forall_intro generalize-sigma]
    }
  @conclusion |
    forall rho: Fn; forall sigma: Fn; forall n: Nat; invertible(rho) -> invertible(sigma) ->
      exists w: Seq;
      (forall k: Nat; less_than(k, n) -> at(w, k) = power(rho, k))
      and (forall k: Nat; less_than(k, n) -> at(w, add(n, k)) = compose(power(rho, k), sigma))
    [by forall_intro generalize-rho]
qed

// -- the entries are pairwise distinct ------------------------------------------------------------

// Distinct powers of the rotation differ: they send letter 0 to different letters.
theorem powersOfTheRotationDiffer: forall rho: Fn; forall n: Nat; isTheRotation(rho, n) ->
  forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) = power(rho, j) -> i = j
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-n |
        fix n: Nat {
          @given-rotation |
            assume isTheRotation(rho, n) {
              @rotation |
                isTheRotation(rho, n)
                [by hypothesis given-rotation]
              @generalize-i |
                fix i: Nat {
                  @generalize-j |
                    fix j: Nat {
                      @given-i-in-range |
                        assume less_than(i, n) {
                          @given-j-in-range |
                            assume less_than(j, n) {
                              @given-powers-equal |
                                assume power(rho, i) = power(rho, j) {
                                  @i-in-range |
                                    less_than(i, n)
                                    [by hypothesis given-i-in-range]
                                  @j-in-range |
                                    less_than(j, n)
                                    [by hypothesis given-j-in-range]
                                  @powers-equal |
                                    power(rho, i) = power(rho, j)
                                    [by hypothesis given-powers-equal]
                                  @power-i-at-zero |
                                    apply(power(rho, i), numeral(ZERO)) = numeral(i)
                                    [using specialize rotationPowerAtZero(rho, n, i) rotation i-in-range]
                                  @power-j-at-zero |
                                    apply(power(rho, j), numeral(ZERO)) = numeral(j)
                                    [using specialize rotationPowerAtZero(rho, n, j) rotation j-in-range]
                                  @power-j-at-zero-is-i |
                                    apply(power(rho, j), numeral(ZERO)) = numeral(i)
                                    [by rewrite powers-equal power-i-at-zero]
                                  @letters-agree |
                                    numeral(j) = numeral(i)
                                    [by rewrite power-j-at-zero power-j-at-zero-is-i]
                                  @indices-agree |
                                    j = i
                                    [using specialize numeralInjective(j, i) letters-agree]
                                  @conclusion-equal |
                                    i = j
                                    [by symmetry indices-agree]
                                }
                              @conclusion-given-equal |
                                power(rho, i) = power(rho, j) -> i = j
                                [by implies_intro given-powers-equal]
                            }
                          @conclusion-given-j |
                            less_than(j, n) -> power(rho, i) = power(rho, j) -> i = j
                            [by implies_intro given-j-in-range]
                        }
                      @conclusion-at-i-j |
                        less_than(i, n) -> less_than(j, n) -> power(rho, i) = power(rho, j) -> i = j
                        [by implies_intro given-i-in-range]
                    }
                  @discharge-j |
                    forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) = power(rho, j) -> i = j
                    [by forall_intro generalize-j]
                }
              @discharge-i |
                forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) = power(rho, j) -> i = j
                [by forall_intro generalize-i]
            }
          @conclusion-at-n |
            isTheRotation(rho, n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) = power(rho, j) -> i = j
            [by implies_intro given-rotation]
        }
      @discharge-n |
        forall n: Nat; isTheRotation(rho, n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) = power(rho, j) -> i = j
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall rho: Fn; forall n: Nat; isTheRotation(rho, n) ->
      forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) = power(rho, j) -> i = j
    [by forall_intro generalize-rho]
qed

// The reflection squared is the identity, as a map.
theorem reflectionSquaredIsIdentity: forall sigma: Fn; forall n: Nat; isTheReflection(sigma, n) -> compose(sigma, sigma) = identityFn
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-n |
        fix n: Nat {
          @given-reflection |
            assume isTheReflection(sigma, n) {
              @reflection |
                isTheReflection(sigma, n)
                [by hypothesis given-reflection]
              @self-undoing |
                forall x: Element; apply(sigma, apply(sigma, x)) = x
                [using specialize reflectionUndoesItself(sigma, n) reflection]
              @generalize-x |
                fix x: Element {
                  @composite-at-x |
                    apply(compose(sigma, sigma), x) = apply(sigma, apply(sigma, x))
                    [using specialize composeApply(sigma, sigma, x)]
                  @undone-at-x |
                    apply(sigma, apply(sigma, x)) = x
                    [using specialize self-undoing(x)]
                  @identity-at-x |
                    apply(identityFn, x) = x
                    [using specialize identityApply(x)]
                  @composite-is-x |
                    apply(compose(sigma, sigma), x) = x
                    [using chain composite-at-x undone-at-x]
                  @conclusion-agree-at-x |
                    apply(compose(sigma, sigma), x) = apply(identityFn, x)
                    [by rewrite identity-at-x composite-is-x]
                }
              @agree-everywhere |
                forall x: Element; apply(compose(sigma, sigma), x) = apply(identityFn, x)
                [by forall_intro generalize-x]
              @conclusion-squared |
                compose(sigma, sigma) = identityFn
                [using specialize funcExtensionality(compose(sigma, sigma), identityFn) agree-everywhere]
            }
          @conclusion-at-n |
            isTheReflection(sigma, n) -> compose(sigma, sigma) = identityFn
            [by implies_intro given-reflection]
        }
      @discharge-n |
        forall n: Nat; isTheReflection(sigma, n) -> compose(sigma, sigma) = identityFn
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall sigma: Fn; forall n: Nat; isTheReflection(sigma, n) -> compose(sigma, sigma) = identityFn
    [by forall_intro generalize-sigma]
qed

// Distinct reflected powers differ: cancel σ on the right (σσ = id) and compare the powers.
theorem reflectedPowersDiffer: forall rho: Fn; forall sigma: Fn; forall n: Nat;
  isTheRotation(rho, n) -> isTheReflection(sigma, n) ->
  forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) ->
  compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-sigma |
        fix sigma: Fn {
          @generalize-n |
            fix n: Nat {
              @given-rotation |
                assume isTheRotation(rho, n) {
                  @given-reflection |
                    assume isTheReflection(sigma, n) {
                      @rotation |
                        isTheRotation(rho, n)
                        [by hypothesis given-rotation]
                      @reflection |
                        isTheReflection(sigma, n)
                        [by hypothesis given-reflection]
                      @sigma-squared |
                        compose(sigma, sigma) = identityFn
                        [using specialize reflectionSquaredIsIdentity(sigma, n) reflection]
                      @generalize-i |
                        fix i: Nat {
                          @generalize-j |
                            fix j: Nat {
                              @given-i-in-range |
                                assume less_than(i, n) {
                                  @given-j-in-range |
                                    assume less_than(j, n) {
                                      @given-reflected-equal |
                                        assume compose(power(rho, i), sigma) = compose(power(rho, j), sigma) {
                                          @i-in-range |
                                            less_than(i, n)
                                            [by hypothesis given-i-in-range]
                                          @j-in-range |
                                            less_than(j, n)
                                            [by hypothesis given-j-in-range]
                                          @reflected-equal |
                                            compose(power(rho, i), sigma) = compose(power(rho, j), sigma)
                                            [by hypothesis given-reflected-equal]
                                          @reassociated-i |
                                            compose(compose(power(rho, i), sigma), sigma) = compose(power(rho, i), compose(sigma, sigma))
                                            [using specialize composeAssoc(power(rho, i), sigma, sigma)]
                                          @cancelled-i-a |
                                            compose(compose(power(rho, i), sigma), sigma) = compose(power(rho, i), identityFn)
                                            [by rewrite sigma-squared reassociated-i]
                                          @identity-on-the-right-i |
                                            compose(power(rho, i), identityFn) = power(rho, i)
                                            [using specialize composeIdentityRight(power(rho, i))]
                                          @cancelled-i |
                                            compose(compose(power(rho, i), sigma), sigma) = power(rho, i)
                                            [using chain cancelled-i-a identity-on-the-right-i]
                                          @reassociated-j |
                                            compose(compose(power(rho, j), sigma), sigma) = compose(power(rho, j), compose(sigma, sigma))
                                            [using specialize composeAssoc(power(rho, j), sigma, sigma)]
                                          @cancelled-j-a |
                                            compose(compose(power(rho, j), sigma), sigma) = compose(power(rho, j), identityFn)
                                            [by rewrite sigma-squared reassociated-j]
                                          @identity-on-the-right-j |
                                            compose(power(rho, j), identityFn) = power(rho, j)
                                            [using specialize composeIdentityRight(power(rho, j))]
                                          @cancelled-j |
                                            compose(compose(power(rho, j), sigma), sigma) = power(rho, j)
                                            [using chain cancelled-j-a identity-on-the-right-j]
                                          @cancelled-crossed |
                                            compose(compose(power(rho, j), sigma), sigma) = power(rho, i)
                                            [by rewrite reflected-equal cancelled-i]
                                          @powers-equal |
                                            power(rho, j) = power(rho, i)
                                            [by rewrite cancelled-j cancelled-crossed]
                                          @indices-agree |
                                            j = i
                                            [using specialize powersOfTheRotationDiffer(rho, n, j, i) rotation j-in-range i-in-range powers-equal]
                                          @conclusion-equal |
                                            i = j
                                            [by symmetry indices-agree]
                                        }
                                      @conclusion-given-equal |
                                        compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
                                        [by implies_intro given-reflected-equal]
                                    }
                                  @conclusion-given-j |
                                    less_than(j, n) -> compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
                                    [by implies_intro given-j-in-range]
                                }
                              @conclusion-at-i-j |
                                less_than(i, n) -> less_than(j, n) -> compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
                                [by implies_intro given-i-in-range]
                            }
                          @discharge-j |
                            forall j: Nat; less_than(i, n) -> less_than(j, n) -> compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
                            [by forall_intro generalize-j]
                        }
                      @discharge-i |
                        forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
                        [by forall_intro generalize-i]
                    }
                  @conclusion-given-reflection |
                    isTheReflection(sigma, n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
                    [by implies_intro given-reflection]
                }
              @conclusion-at-n |
                isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
                [by implies_intro given-rotation]
            }
          @discharge-n |
            forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
            [by forall_intro generalize-n]
        }
      @discharge-sigma |
        forall sigma: Fn; forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
        [by forall_intro generalize-sigma]
    }
  @conclusion |
    forall rho: Fn; forall sigma: Fn; forall n: Nat;
      isTheRotation(rho, n) -> isTheReflection(sigma, n) ->
      forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) ->
      compose(power(rho, i), sigma) = compose(power(rho, j), sigma) -> i = j
    [by forall_intro generalize-rho]
qed

// A rotation is never a reflection (n ≥ 3): both would send letter 0 to the same letter, so
// the powers agree, and then letter 1 would be its own complement n - 1 — i.e. n = 2.
theorem rotationIsNotAReflection: forall rho: Fn; forall sigma: Fn; forall n: Nat;
  isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(succ(ZERO)), n) ->
  forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) ->
  power(rho, i) != compose(power(rho, j), sigma)
proof
  @generalize-rho |
    fix rho: Fn {
      @generalize-sigma |
        fix sigma: Fn {
          @generalize-n |
            fix n: Nat {
              @given-rotation |
                assume isTheRotation(rho, n) {
                  @given-reflection |
                    assume isTheReflection(sigma, n) {
                      @given-three-letters |
                        assume less_than(succ(succ(ZERO)), n) {
                          @rotation |
                            isTheRotation(rho, n)
                            [by hypothesis given-rotation]
                          @reflection |
                            isTheReflection(sigma, n)
                            [by hypothesis given-reflection]
                          @three-letters |
                            less_than(succ(succ(ZERO)), n)
                            [by hypothesis given-three-letters]
                          @rho-invertible |
                            invertible(rho)
                            [using tautology rotation]
                          @sigma-fixes-zero |
                            apply(sigma, numeral(ZERO)) = numeral(ZERO)
                            [using tautology reflection]
                          @complements |
                            forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(sigma, numeral(i)) = numeral(sub(n, i))
                            [using tautology reflection]
                          @one-below-two |
                            less_than(succ(ZERO), succ(succ(ZERO)))
                            [using specialize lessThanSelf(succ(ZERO))]
                          @one-in-range |
                            less_than(succ(ZERO), n)
                            [using specialize lessThanTransitive(succ(ZERO), succ(succ(ZERO)), n) one-below-two three-letters]
                          @zero-below-one |
                            less_than(ZERO, succ(ZERO))
                            [using specialize zeroBelowSucc(ZERO)]
                          @reflection-of-one |
                            apply(sigma, numeral(succ(ZERO))) = numeral(sub(n, succ(ZERO)))
                            [using specialize complements(succ(ZERO)) zero-below-one one-in-range]
                          @n-is-a-successor |
                            exists m: Nat; n = succ(m)
                            [using specialize positiveIsASuccessor(succ(ZERO), n) one-in-range]
                          @generalize-i |
                            fix i: Nat {
                              @generalize-j |
                                fix j: Nat {
                                  @given-i-in-range |
                                    assume less_than(i, n) {
                                      @given-j-in-range |
                                        assume less_than(j, n) {
                                          @i-in-range |
                                            less_than(i, n)
                                            [by hypothesis given-i-in-range]
                                          @j-in-range |
                                            less_than(j, n)
                                            [by hypothesis given-j-in-range]
                                          @suppose-equal |
                                            assume power(rho, i) = compose(power(rho, j), sigma) {
                                              @equal |
                                                power(rho, i) = compose(power(rho, j), sigma)
                                                [by hypothesis suppose-equal]
                                              @power-i-at-zero |
                                                apply(power(rho, i), numeral(ZERO)) = numeral(i)
                                                [using specialize rotationPowerAtZero(rho, n, i) rotation i-in-range]
                                              @power-j-at-zero |
                                                apply(power(rho, j), numeral(ZERO)) = numeral(j)
                                                [using specialize rotationPowerAtZero(rho, n, j) rotation j-in-range]
                                              @composite-at-zero |
                                                apply(compose(power(rho, j), sigma), numeral(ZERO)) = apply(power(rho, j), apply(sigma, numeral(ZERO)))
                                                [using specialize composeApply(power(rho, j), sigma, numeral(ZERO))]
                                              @composite-at-zero-via-sigma |
                                                apply(compose(power(rho, j), sigma), numeral(ZERO)) = apply(power(rho, j), numeral(ZERO))
                                                [by rewrite sigma-fixes-zero composite-at-zero]
                                              @composite-at-zero-is-j |
                                                apply(compose(power(rho, j), sigma), numeral(ZERO)) = numeral(j)
                                                [using chain composite-at-zero-via-sigma power-j-at-zero]
                                              @composite-at-zero-is-i |
                                                apply(compose(power(rho, j), sigma), numeral(ZERO)) = numeral(i)
                                                [by rewrite equal power-i-at-zero]
                                              @letters-agree |
                                                numeral(j) = numeral(i)
                                                [by rewrite composite-at-zero-is-j composite-at-zero-is-i]
                                              @indices-agree |
                                                j = i
                                                [using specialize numeralInjective(j, i) letters-agree]
                                              @equal-at-i |
                                                power(rho, i) = compose(power(rho, i), sigma)
                                                [by rewrite indices-agree equal]
                                              @composite-at-one |
                                                apply(compose(power(rho, i), sigma), numeral(succ(ZERO))) = apply(power(rho, i), apply(sigma, numeral(succ(ZERO))))
                                                [using specialize composeApply(power(rho, i), sigma, numeral(succ(ZERO)))]
                                              @power-at-one-both-ways |
                                                apply(power(rho, i), numeral(succ(ZERO))) = apply(power(rho, i), apply(sigma, numeral(succ(ZERO))))
                                                [by rewrite equal-at-i composite-at-one]
                                              @power-invertible |
                                                invertible(power(rho, i))
                                                [using specialize powerIsAPermutation(rho, i) rho-invertible]
                                              @power-injective |
                                                forall a: Element; forall b: Element; apply(power(rho, i), a) = apply(power(rho, i), b) -> a = b
                                                [using specialize permutationIsInjective(power(rho, i))]
                                              @one-is-its-reflection |
                                                numeral(succ(ZERO)) = apply(sigma, numeral(succ(ZERO)))
                                                [using specialize power-injective(numeral(succ(ZERO)), apply(sigma, numeral(succ(ZERO)))) power-at-one-both-ways]
                                              @one-is-its-complement |
                                                numeral(succ(ZERO)) = numeral(sub(n, succ(ZERO)))
                                                [by rewrite reflection-of-one one-is-its-reflection]
                                              @one-equals-its-complement |
                                                succ(ZERO) = sub(n, succ(ZERO))
                                                [using specialize numeralInjective(succ(ZERO), sub(n, succ(ZERO))) one-is-its-complement]
                                              @with-last-m |
                                                unpack m: Nat from n-is-a-successor {
                                                  @n-is-succ-m |
                                                    n = succ(m)
                                                    [by hypothesis with-last-m]
                                                  @complement-of-one-at-succ-m |
                                                    sub(succ(m), succ(ZERO)) = m
                                                    [using specialize complementOfOne(m)]
                                                  @complement-of-one |
                                                    sub(n, succ(ZERO)) = m
                                                    [by rewrite n-is-succ-m complement-of-one-at-succ-m]
                                                  @one-is-m |
                                                    succ(ZERO) = m
                                                    [using chain one-equals-its-complement complement-of-one]
                                                  @n-is-two |
                                                    n = succ(succ(ZERO))
                                                    [by rewrite one-is-m n-is-succ-m]
                                                  @two-below-itself |
                                                    less_than(succ(succ(ZERO)), succ(succ(ZERO)))
                                                    [by rewrite n-is-two three-letters]
                                                  @two-not-below-itself |
                                                    not less_than(succ(succ(ZERO)), succ(succ(ZERO)))
                                                    [using specialize lessThanIrreflexive(succ(succ(ZERO)))]
                                                  @conclusion-two-letters-absurd |
                                                    less_than(ZERO, ZERO)
                                                    [by absurd two-below-itself two-not-below-itself]
                                                }
                                              @zero-below-zero |
                                                less_than(ZERO, ZERO)
                                                [by exists_elim with-last-m]
                                            }
                                          @zero-not-below-zero |
                                            not less_than(ZERO, ZERO)
                                            [using specialize lessThanIrreflexive(ZERO)]
                                          @conclusion-differ |
                                            power(rho, i) != compose(power(rho, j), sigma)
                                            [by not_intro suppose-equal zero-below-zero zero-not-below-zero]
                                        }
                                      @conclusion-given-j |
                                        less_than(j, n) -> power(rho, i) != compose(power(rho, j), sigma)
                                        [by implies_intro given-j-in-range]
                                    }
                                  @conclusion-at-i-j |
                                    less_than(i, n) -> less_than(j, n) -> power(rho, i) != compose(power(rho, j), sigma)
                                    [by implies_intro given-i-in-range]
                                }
                              @discharge-j |
                                forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) != compose(power(rho, j), sigma)
                                [by forall_intro generalize-j]
                            }
                          @discharge-i |
                            forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) != compose(power(rho, j), sigma)
                            [by forall_intro generalize-i]
                        }
                      @conclusion-given-three-letters |
                        less_than(succ(succ(ZERO)), n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) != compose(power(rho, j), sigma)
                        [by implies_intro given-three-letters]
                    }
                  @conclusion-given-reflection |
                    isTheReflection(sigma, n) -> less_than(succ(succ(ZERO)), n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) != compose(power(rho, j), sigma)
                    [by implies_intro given-reflection]
                }
              @conclusion-at-n |
                isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(succ(ZERO)), n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) != compose(power(rho, j), sigma)
                [by implies_intro given-rotation]
            }
          @discharge-n |
            forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(succ(ZERO)), n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) != compose(power(rho, j), sigma)
            [by forall_intro generalize-n]
        }
      @discharge-sigma |
        forall sigma: Fn; forall n: Nat; isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(succ(ZERO)), n) -> forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> power(rho, i) != compose(power(rho, j), sigma)
        [by forall_intro generalize-sigma]
    }
  @conclusion |
    forall rho: Fn; forall sigma: Fn; forall n: Nat;
      isTheRotation(rho, n) -> isTheReflection(sigma, n) -> less_than(succ(succ(ZERO)), n) ->
      forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) ->
      power(rho, i) != compose(power(rho, j), sigma)
    [by forall_intro generalize-rho]
qed

// -- |D_n| = 2n -----------------------------------------------------------------------------------

// THE COUNT: for n ≥ 3 the dihedral group of the n-gon has 2n elements — some sequence lists
// the rigid motions with n + n entries, pairwise distinct, every motion among them: the n
// rotations ρ^k and the n reflections ρ^k ∘ σ (Judson's count: vertex 0 goes to any of n
// vertices, vertex 1 to either neighbour, and the rest is forced).
theorem dihedralGroupHasTwiceNElements: forall n: Nat; less_than(succ(succ(ZERO)), n) ->
  exists rho: Fn; exists sigma: Fn; isTheRotation(rho, n) and isTheReflection(sigma, n) and
  (exists w: Seq;
  (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w, i), rho, n))
  and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w, i) = at(w, j) -> i = j)
  and (forall t: Fn; isARigidMotion(t, rho, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w, i) = t))
proof
  @generalize-n |
    fix n: Nat {
      @given-three-letters |
        assume less_than(succ(succ(ZERO)), n) {
          @three-letters |
            less_than(succ(succ(ZERO)), n)
            [by hypothesis given-three-letters]
          @one-below-two |
            less_than(succ(ZERO), succ(succ(ZERO)))
            [using specialize lessThanSelf(succ(ZERO))]
          @two-letters |
            less_than(succ(ZERO), n)
            [using specialize lessThanTransitive(succ(ZERO), succ(succ(ZERO)), n) one-below-two three-letters]
          @rotation-exists |
            exists rho: Fn; isTheRotation(rho, n)
            [using specialize rotationExists(n)]
          @reflection-exists |
            exists sigma: Fn; isTheReflection(sigma, n)
            [using specialize reflectionExists(n)]
          @with-rotation-rho |
            unpack rho: Fn from rotation-exists {
              @rotation |
                isTheRotation(rho, n)
                [by hypothesis with-rotation-rho]
              @rho-invertible |
                invertible(rho)
                [using tautology rotation]
              @with-reflection-sigma |
                unpack sigma: Fn from reflection-exists {
                  @reflection |
                    isTheReflection(sigma, n)
                    [by hypothesis with-reflection-sigma]
                  @sigma-invertible |
                    invertible(sigma)
                    [using tautology reflection]
                  @listing-exists |
                    exists w: Seq; (forall k: Nat; less_than(k, n) -> at(w, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(w, add(n, k)) = compose(power(rho, k), sigma))
                    [using specialize dihedralListingExists(rho, sigma, n) rho-invertible sigma-invertible]
                  @with-listing-w |
                    unpack w: Seq from listing-exists {
                      @listing-facts |
                        (forall k: Nat; less_than(k, n) -> at(w, k) = power(rho, k)) and (forall k: Nat; less_than(k, n) -> at(w, add(n, k)) = compose(power(rho, k), sigma))
                        [by hypothesis with-listing-w]
                      @rotation-entries |
                        forall k: Nat; less_than(k, n) -> at(w, k) = power(rho, k)
                        [by and_elim_left listing-facts]
                      @reflection-entries |
                        forall k: Nat; less_than(k, n) -> at(w, add(n, k)) = compose(power(rho, k), sigma)
                        [by and_elim_right listing-facts]

                      // every entry is a motion
                      @generalize-i-for-entries |
                        fix i: Nat {
                          @given-i-in-range |
                            assume less_than(i, add(n, n)) {
                              @i-in-range |
                                less_than(i, add(n, n))
                                [by hypothesis given-i-in-range]
                              @i-splits |
                                less_than(i, n) or (exists j: Nat; less_than(j, n) and i = add(n, j))
                                [using specialize indexSplits(n, n, i) i-in-range]
                              @conclusion-entry-is-a-motion |
                                isARigidMotion(at(w, i), rho, n)
                                case i-splits {
                                  @when-rotation |
                                    assume less_than(i, n) {
                                      @i-below-n |
                                        less_than(i, n)
                                        [by hypothesis when-rotation]
                                      @entry-is-a-power |
                                        at(w, i) = power(rho, i)
                                        [using specialize rotation-entries(i) i-below-n]
                                      @power-is-a-motion |
                                        isARigidMotion(power(rho, i), rho, n)
                                        [using specialize rotationPowerIsAMotion(rho, n, i) rotation]
                                      @conclusion-when-rotation |
                                        isARigidMotion(at(w, i), rho, n)
                                        [by rewrite entry-is-a-power power-is-a-motion]
                                    }
                                  @when-reflection |
                                    assume exists j: Nat; less_than(j, n) and i = add(n, j) {
                                      @offset-exists |
                                        exists j: Nat; less_than(j, n) and i = add(n, j)
                                        [by hypothesis when-reflection]
                                      @with-offset-j |
                                        unpack j: Nat from offset-exists {
                                          @offset-facts |
                                            less_than(j, n) and i = add(n, j)
                                            [by hypothesis with-offset-j]
                                          @j-below-n |
                                            less_than(j, n)
                                            [by and_elim_left offset-facts]
                                          @i-is-offset |
                                            i = add(n, j)
                                            [by and_elim_right offset-facts]
                                          @offset-entry-is-a-reflected-power |
                                            at(w, add(n, j)) = compose(power(rho, j), sigma)
                                            [using specialize reflection-entries(j) j-below-n]
                                          @entry-is-a-reflected-power |
                                            at(w, i) = compose(power(rho, j), sigma)
                                            [by rewrite i-is-offset offset-entry-is-a-reflected-power]
                                          @reflected-power-is-a-motion |
                                            isARigidMotion(compose(power(rho, j), sigma), rho, n)
                                            [using specialize reflectedPowerIsAMotion(rho, sigma, n, j) rotation reflection]
                                          @conclusion-entry-motion-at-j |
                                            isARigidMotion(at(w, i), rho, n)
                                            [by rewrite entry-is-a-reflected-power reflected-power-is-a-motion]
                                        }
                                      @conclusion-when-reflection |
                                        isARigidMotion(at(w, i), rho, n)
                                        [by exists_elim with-offset-j]
                                    }
                                }
                            }
                          @conclusion-entry-clause |
                            less_than(i, add(n, n)) -> isARigidMotion(at(w, i), rho, n)
                            [by implies_intro given-i-in-range]
                        }
                      @entries-are-motions |
                        forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w, i), rho, n)
                        [by forall_intro generalize-i-for-entries]

                      // no entry repeats
                      @generalize-i-for-injective |
                        fix i: Nat {
                          @generalize-j-for-injective |
                            fix j: Nat {
                              @given-i-in-range-too |
                                assume less_than(i, add(n, n)) {
                                  @given-j-in-range |
                                    assume less_than(j, add(n, n)) {
                                      @given-entries-equal |
                                        assume at(w, i) = at(w, j) {
                                          @i-in-range-too |
                                            less_than(i, add(n, n))
                                            [by hypothesis given-i-in-range-too]
                                          @j-in-range |
                                            less_than(j, add(n, n))
                                            [by hypothesis given-j-in-range]
                                          @entries-equal |
                                            at(w, i) = at(w, j)
                                            [by hypothesis given-entries-equal]
                                          @i-splits |
                                            less_than(i, n) or (exists i2: Nat; less_than(i2, n) and i = add(n, i2))
                                            [using specialize indexSplits(n, n, i) i-in-range-too]
                                          @j-splits |
                                            less_than(j, n) or (exists j2: Nat; less_than(j2, n) and j = add(n, j2))
                                            [using specialize indexSplits(n, n, j) j-in-range]
                                          @conclusion-indices-equal |
                                            i = j
                                            case i-splits {
                                              @when-i-rotation |
                                                assume less_than(i, n) {
                                                  @i-below-n |
                                                    less_than(i, n)
                                                    [by hypothesis when-i-rotation]
                                                  @entry-i-is-a-power |
                                                    at(w, i) = power(rho, i)
                                                    [using specialize rotation-entries(i) i-below-n]
                                                  @conclusion-from-rotation-i |
                                                    i = j
                                                    case j-splits {
                                                      @when-j-rotation |
                                                        assume less_than(j, n) {
                                                          @j-below-n |
                                                            less_than(j, n)
                                                            [by hypothesis when-j-rotation]
                                                          @entry-j-is-a-power |
                                                            at(w, j) = power(rho, j)
                                                            [using specialize rotation-entries(j) j-below-n]
                                                          @power-i-is-entry-j |
                                                            power(rho, i) = at(w, j)
                                                            [by rewrite entry-i-is-a-power entries-equal]
                                                          @powers-equal |
                                                            power(rho, i) = power(rho, j)
                                                            [by rewrite entry-j-is-a-power power-i-is-entry-j]
                                                          @conclusion-both-rotations |
                                                            i = j
                                                            [using specialize powersOfTheRotationDiffer(rho, n, i, j) rotation i-below-n j-below-n powers-equal]
                                                        }
                                                      @when-j-reflection |
                                                        assume exists j2: Nat; less_than(j2, n) and j = add(n, j2) {
                                                          @j-offset-exists |
                                                            exists j2: Nat; less_than(j2, n) and j = add(n, j2)
                                                            [by hypothesis when-j-reflection]
                                                          @with-offset-j2 |
                                                            unpack j2: Nat from j-offset-exists {
                                                              @j-offset-facts |
                                                                less_than(j2, n) and j = add(n, j2)
                                                                [by hypothesis with-offset-j2]
                                                              @j2-below-n |
                                                                less_than(j2, n)
                                                                [by and_elim_left j-offset-facts]
                                                              @j-is-offset |
                                                                j = add(n, j2)
                                                                [by and_elim_right j-offset-facts]
                                                              @offset-entry-j |
                                                                at(w, add(n, j2)) = compose(power(rho, j2), sigma)
                                                                [using specialize reflection-entries(j2) j2-below-n]
                                                              @entry-j-is-reflected |
                                                                at(w, j) = compose(power(rho, j2), sigma)
                                                                [by rewrite j-is-offset offset-entry-j]
                                                              @power-i-is-entry-j |
                                                                power(rho, i) = at(w, j)
                                                                [by rewrite entry-i-is-a-power entries-equal]
                                                              @power-is-reflected |
                                                                power(rho, i) = compose(power(rho, j2), sigma)
                                                                [by rewrite entry-j-is-reflected power-i-is-entry-j]
                                                              @power-is-not-reflected |
                                                                power(rho, i) != compose(power(rho, j2), sigma)
                                                                [using specialize rotationIsNotAReflection(rho, sigma, n, i, j2) rotation reflection three-letters i-below-n j2-below-n]
                                                              @conclusion-rotation-reflection-absurd |
                                                                i = j
                                                                [by absurd power-is-reflected power-is-not-reflected]
                                                            }
                                                          @conclusion-rotation-then-reflection |
                                                            i = j
                                                            [by exists_elim with-offset-j2]
                                                        }
                                                    }
                                                }
                                              @when-i-reflection |
                                                assume exists i2: Nat; less_than(i2, n) and i = add(n, i2) {
                                                  @i-offset-exists |
                                                    exists i2: Nat; less_than(i2, n) and i = add(n, i2)
                                                    [by hypothesis when-i-reflection]
                                                  @with-offset-i2 |
                                                    unpack i2: Nat from i-offset-exists {
                                                      @i-offset-facts |
                                                        less_than(i2, n) and i = add(n, i2)
                                                        [by hypothesis with-offset-i2]
                                                      @i2-below-n |
                                                        less_than(i2, n)
                                                        [by and_elim_left i-offset-facts]
                                                      @i-is-offset |
                                                        i = add(n, i2)
                                                        [by and_elim_right i-offset-facts]
                                                      @offset-entry-i |
                                                        at(w, add(n, i2)) = compose(power(rho, i2), sigma)
                                                        [using specialize reflection-entries(i2) i2-below-n]
                                                      @entry-i-is-reflected |
                                                        at(w, i) = compose(power(rho, i2), sigma)
                                                        [by rewrite i-is-offset offset-entry-i]
                                                      @conclusion-from-reflection-i |
                                                        i = j
                                                        case j-splits {
                                                          @when-j-rotation |
                                                            assume less_than(j, n) {
                                                              @j-below-n |
                                                                less_than(j, n)
                                                                [by hypothesis when-j-rotation]
                                                              @entry-j-is-a-power |
                                                                at(w, j) = power(rho, j)
                                                                [using specialize rotation-entries(j) j-below-n]
                                                              @reflected-i-is-entry-j |
                                                                compose(power(rho, i2), sigma) = at(w, j)
                                                                [by rewrite entry-i-is-reflected entries-equal]
                                                              @reflected-is-power |
                                                                compose(power(rho, i2), sigma) = power(rho, j)
                                                                [by rewrite entry-j-is-a-power reflected-i-is-entry-j]
                                                              @power-is-reflected |
                                                                power(rho, j) = compose(power(rho, i2), sigma)
                                                                [by symmetry reflected-is-power]
                                                              @power-is-not-reflected |
                                                                power(rho, j) != compose(power(rho, i2), sigma)
                                                                [using specialize rotationIsNotAReflection(rho, sigma, n, j, i2) rotation reflection three-letters j-below-n i2-below-n]
                                                              @conclusion-reflection-rotation-absurd |
                                                                i = j
                                                                [by absurd power-is-reflected power-is-not-reflected]
                                                            }
                                                          @when-j-reflection |
                                                            assume exists j2: Nat; less_than(j2, n) and j = add(n, j2) {
                                                              @j-offset-exists |
                                                                exists j2: Nat; less_than(j2, n) and j = add(n, j2)
                                                                [by hypothesis when-j-reflection]
                                                              @with-offset-j2 |
                                                                unpack j2: Nat from j-offset-exists {
                                                                  @j-offset-facts |
                                                                    less_than(j2, n) and j = add(n, j2)
                                                                    [by hypothesis with-offset-j2]
                                                                  @j2-below-n |
                                                                    less_than(j2, n)
                                                                    [by and_elim_left j-offset-facts]
                                                                  @j-is-offset |
                                                                    j = add(n, j2)
                                                                    [by and_elim_right j-offset-facts]
                                                                  @offset-entry-j |
                                                                    at(w, add(n, j2)) = compose(power(rho, j2), sigma)
                                                                    [using specialize reflection-entries(j2) j2-below-n]
                                                                  @entry-j-is-reflected |
                                                                    at(w, j) = compose(power(rho, j2), sigma)
                                                                    [by rewrite j-is-offset offset-entry-j]
                                                                  @reflected-i-is-entry-j |
                                                                    compose(power(rho, i2), sigma) = at(w, j)
                                                                    [by rewrite entry-i-is-reflected entries-equal]
                                                                  @reflected-equal |
                                                                    compose(power(rho, i2), sigma) = compose(power(rho, j2), sigma)
                                                                    [by rewrite entry-j-is-reflected reflected-i-is-entry-j]
                                                                  @offsets-equal |
                                                                    i2 = j2
                                                                    [using specialize reflectedPowersDiffer(rho, sigma, n, i2, j2) rotation reflection i2-below-n j2-below-n reflected-equal]
                                                                  @i-is-j-offset |
                                                                    i = add(n, j2)
                                                                    [by rewrite offsets-equal i-is-offset]
                                                                  @conclusion-both-reflections |
                                                                    i = j
                                                                    [by rewrite j-is-offset i-is-j-offset]
                                                                }
                                                              @conclusion-reflection-then-reflection |
                                                                i = j
                                                                [by exists_elim with-offset-j2]
                                                            }
                                                        }
                                                    }
                                                  @conclusion-with-offset-i2 |
                                                    i = j
                                                    [by exists_elim with-offset-i2]
                                                }
                                            }
                                        }
                                      @conclusion-given-equal |
                                        at(w, i) = at(w, j) -> i = j
                                        [by implies_intro given-entries-equal]
                                    }
                                  @conclusion-given-j |
                                    less_than(j, add(n, n)) -> at(w, i) = at(w, j) -> i = j
                                    [by implies_intro given-j-in-range]
                                }
                              @conclusion-injective-at-i-j |
                                less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w, i) = at(w, j) -> i = j
                                [by implies_intro given-i-in-range-too]
                            }
                          @discharge-j-for-injective |
                            forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w, i) = at(w, j) -> i = j
                            [by forall_intro generalize-j-for-injective]
                        }
                      @entries-distinct |
                        forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w, i) = at(w, j) -> i = j
                        [by forall_intro generalize-i-for-injective]

                      // every motion is an entry
                      @generalize-t |
                        fix t: Fn {
                          @given-motion |
                            assume isARigidMotion(t, rho, n) {
                              @motion |
                                isARigidMotion(t, rho, n)
                                [by hypothesis given-motion]
                              @shape-exists |
                                exists k: Nat; less_than(k, n) and (t = power(rho, k) or t = compose(power(rho, k), sigma))
                                [using specialize everyMotionIsARotationOrAReflection(rho, sigma, n, t) rotation reflection two-letters motion]
                              @with-index-k |
                                unpack k: Nat from shape-exists {
                                  @shape-facts |
                                    less_than(k, n) and (t = power(rho, k) or t = compose(power(rho, k), sigma))
                                    [by hypothesis with-index-k]
                                  @k-below-n |
                                    less_than(k, n)
                                    [by and_elim_left shape-facts]
                                  @shape |
                                    t = power(rho, k) or t = compose(power(rho, k), sigma)
                                    [by and_elim_right shape-facts]
                                  @conclusion-t-is-listed |
                                    exists i: Nat; less_than(i, add(n, n)) and at(w, i) = t
                                    case shape {
                                      @when-rotation |
                                        assume t = power(rho, k) {
                                          @t-is-a-power |
                                            t = power(rho, k)
                                            [by hypothesis when-rotation]
                                          @k-in-range |
                                            less_than(k, add(n, n))
                                            [using specialize belowTheBaseIsBelowTheSum(n, n, k) k-below-n]
                                          @entry-k |
                                            at(w, k) = power(rho, k)
                                            [using specialize rotation-entries(k) k-below-n]
                                          @entry-k-is-t |
                                            at(w, k) = t
                                            [by rewrite t-is-a-power entry-k]
                                          @k-in-range-and-hits |
                                            less_than(k, add(n, n)) and at(w, k) = t
                                            [by and_intro k-in-range entry-k-is-t]
                                          @conclusion-when-rotation |
                                            exists i: Nat; less_than(i, add(n, n)) and at(w, i) = t
                                            [by exists_intro(k) k-in-range-and-hits]
                                        }
                                      @when-reflection |
                                        assume t = compose(power(rho, k), sigma) {
                                          @t-is-reflected |
                                            t = compose(power(rho, k), sigma)
                                            [by hypothesis when-reflection]
                                          @offset-in-range |
                                            less_than(add(n, k), add(n, n))
                                            [using specialize additionPreservesOrder(k, n, n) k-below-n]
                                          @offset-entry |
                                            at(w, add(n, k)) = compose(power(rho, k), sigma)
                                            [using specialize reflection-entries(k) k-below-n]
                                          @offset-entry-is-t |
                                            at(w, add(n, k)) = t
                                            [by rewrite t-is-reflected offset-entry]
                                          @offset-in-range-and-hits |
                                            less_than(add(n, k), add(n, n)) and at(w, add(n, k)) = t
                                            [by and_intro offset-in-range offset-entry-is-t]
                                          @conclusion-when-reflection |
                                            exists i: Nat; less_than(i, add(n, n)) and at(w, i) = t
                                            [by exists_intro(add(n, k)) offset-in-range-and-hits]
                                        }
                                    }
                                }
                              @conclusion-listed |
                                exists i: Nat; less_than(i, add(n, n)) and at(w, i) = t
                                [by exists_elim with-index-k]
                            }
                          @conclusion-covers-at-t |
                            isARigidMotion(t, rho, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w, i) = t
                            [by implies_intro given-motion]
                        }
                      @every-motion-is-listed |
                        forall t: Fn; isARigidMotion(t, rho, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w, i) = t
                        [by forall_intro generalize-t]
                      @w-lists-the-motions |
                        (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w, i), rho, n)) and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w, i) = at(w, j) -> i = j) and (forall t: Fn; isARigidMotion(t, rho, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w, i) = t)
                        [using tautology entries-are-motions entries-distinct every-motion-is-listed]
                      @some-listing |
                        exists w2: Seq; (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w2, i), rho, n)) and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w2, i) = at(w2, j) -> i = j) and (forall t: Fn; isARigidMotion(t, rho, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w2, i) = t)
                        [by exists_intro(w) w-lists-the-motions]
                      @rotation-reflection-and-listing |
                        isTheRotation(rho, n) and isTheReflection(sigma, n) and (exists w2: Seq; (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w2, i), rho, n)) and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w2, i) = at(w2, j) -> i = j) and (forall t: Fn; isARigidMotion(t, rho, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w2, i) = t))
                        [using tautology rotation reflection some-listing]
                      @with-sigma |
                        exists sigma2: Fn; isTheRotation(rho, n) and isTheReflection(sigma2, n) and (exists w2: Seq; (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w2, i), rho, n)) and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w2, i) = at(w2, j) -> i = j) and (forall t: Fn; isARigidMotion(t, rho, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w2, i) = t))
                        [by exists_intro(sigma) rotation-reflection-and-listing]
                      @conclusion-witness-rho |
                        exists rho2: Fn; exists sigma2: Fn; isTheRotation(rho2, n) and isTheReflection(sigma2, n) and (exists w2: Seq; (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w2, i), rho2, n)) and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w2, i) = at(w2, j) -> i = j) and (forall t: Fn; isARigidMotion(t, rho2, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w2, i) = t))
                        [by exists_intro(rho) with-sigma]
                    }
                  @conclusion-with-w |
                    exists rho2: Fn; exists sigma2: Fn; isTheRotation(rho2, n) and isTheReflection(sigma2, n) and (exists w2: Seq; (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w2, i), rho2, n)) and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w2, i) = at(w2, j) -> i = j) and (forall t: Fn; isARigidMotion(t, rho2, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w2, i) = t))
                    [by exists_elim with-listing-w]
                }
              @conclusion-with-sigma |
                exists rho2: Fn; exists sigma2: Fn; isTheRotation(rho2, n) and isTheReflection(sigma2, n) and (exists w2: Seq; (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w2, i), rho2, n)) and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w2, i) = at(w2, j) -> i = j) and (forall t: Fn; isARigidMotion(t, rho2, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w2, i) = t))
                [by exists_elim with-reflection-sigma]
            }
          @conclusion-count |
            exists rho2: Fn; exists sigma2: Fn; isTheRotation(rho2, n) and isTheReflection(sigma2, n) and (exists w2: Seq; (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w2, i), rho2, n)) and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w2, i) = at(w2, j) -> i = j) and (forall t: Fn; isARigidMotion(t, rho2, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w2, i) = t))
            [by exists_elim with-rotation-rho]
        }
      @conclusion-at-n |
        less_than(succ(succ(ZERO)), n) -> exists rho2: Fn; exists sigma2: Fn; isTheRotation(rho2, n) and isTheReflection(sigma2, n) and (exists w2: Seq; (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w2, i), rho2, n)) and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w2, i) = at(w2, j) -> i = j) and (forall t: Fn; isARigidMotion(t, rho2, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w2, i) = t))
        [by implies_intro given-three-letters]
    }
  @conclusion |
    forall n: Nat; less_than(succ(succ(ZERO)), n) ->
      exists rho: Fn; exists sigma: Fn; isTheRotation(rho, n) and isTheReflection(sigma, n) and
      (exists w: Seq;
      (forall i: Nat; less_than(i, add(n, n)) -> isARigidMotion(at(w, i), rho, n))
      and (forall i: Nat; forall j: Nat; less_than(i, add(n, n)) -> less_than(j, add(n, n)) -> at(w, i) = at(w, j) -> i = j)
      and (forall t: Fn; isARigidMotion(t, rho, n) -> exists i: Nat; less_than(i, add(n, n)) and at(w, i) = t))
    [by forall_intro generalize-n]
qed
