// The ALTERNATING GROUP A_n — the even permutations.
//
// Judson defines a permutation to be EVEN (ODD) when it is SOME product of an even (odd)
// number of transpositions. "Some" is the load-bearing word: a permutation has many
// factorizations, and that they all share a parity is the PARITY LEMMA, proved in
// std/permutation/parity.b4m (`identityIsEvenLengthForAnySequence`). This file layers the
// predicates on that lemma and shows the even permutations are a SUBGROUP — the three
// closure conditions, which is what makes A_n a group at all.
//
// A_n is stated as a MEMBERSHIP PREDICATE (`inAlternating`) over `Perm`, not as a sort of
// subgroups: there is no sort of subgroups, so a subgroup is the predicate its consumer
// carries (the pattern std/subgroup.b4m uses throughout).
import function <<< "std/function.b4m"
import function_invertible <<< "std/function/invertible.b4m"
import permutation <<< "std/permutation.b4m"
import permutation_sequence <<< "std/permutation/sequence.b4m"
import permutation_parity <<< "std/permutation/parity.b4m"
import peano <<< "std/peano.b4m"
import peano_divides <<< "std/peano/divides.b4m"
import peano_parity <<< "std/peano/parity.b4m"
import peano_order <<< "std/peano/order.b4m"
import peano_subtraction <<< "std/peano/subtraction.b4m"
import permutation_transpositions <<< "std/permutation/transpositions.b4m"

// -- the vocabulary ------------------------------------------------------------------------

sort Element = permutation.Element
sort Fn = permutation.Fn
sort Perm = permutation.Perm
sort Seq = permutation_sequence.Seq
sort Nat = peano.Nat

func compose = permutation.compose
func inverse = permutation.inverse
const identityFn = permutation.identityFn
func transposition = permutation.transposition
pred invertible = permutation.invertible

func apply = permutation.apply
axiom composeApply = function.composeApply
axiom funcExtensionality = function.funcExtensionality
theorem transpositionAtFirst = permutation.transpositionAtFirst
theorem transpositionAtSecond = permutation.transpositionAtSecond
theorem transpositionElsewhere = permutation.transpositionElsewhere

func at = permutation_sequence.at
func productUpTo = permutation_sequence.productUpTo

const NZERO = peano.ZERO
func succ = peano.succ
const TWO = peano_parity.TWO
pred divides = peano_divides.divides
pred nat_less_than = peano.less_than

theorem identityIsAPermutation = permutation.identityIsAPermutation
theorem composeIsAPermutation = permutation.composeIsAPermutation
theorem inverseIsAPermutation = permutation.inverseIsAPermutation

// `isTransposition` / `allTranspositions` are parity.b4m's, under local names: a factorization
// is a Seq every one of whose first n entries is a transposition.
// std/permutation/transpositions.b4m already names this; use ITS spelling rather than
// declaring a twin (a second name for one notion makes the two invisible to each other).
define isTransposition(t) = permutation_transpositions.isATransposition(t)

pred allTranspositions(s: Seq, n: Nat)
axiom allTranspositionsDef: forall s: Seq; forall n: Nat;
  allTranspositions(s, n) iff (forall i: Nat; nat_less_than(i, n) -> isTransposition(at(s, i)))

// -- even and odd --------------------------------------------------------------------------

// Judson's definition, verbatim: g is EVEN when SOME product of an even number of
// transpositions equals it. A real `pred` rather than a `define`, so it can be cited,
// model-mapped, and named where a symbol is required. (The long form, not a definition
// block: a clause whose body quantifies cannot settle its binders' sorts from use.)
pred isEvenPerm(g: Fn)
axiom isEvenPermDef: forall g: Fn;
  isEvenPerm(g) iff (exists s: Seq; exists m: Nat;
  allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m))

pred isOddPerm(g: Fn)
axiom isOddPermDef: forall g: Fn;
  isOddPerm(g) iff (exists s: Seq; exists m: Nat;
  allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, succ(m)))

// A_n's membership predicate: the even permutations.
pred inAlternating(g: Fn)
axiom inAlternatingDef: forall g: Fn;
  inAlternating(g) iff (invertible(g) and isEvenPerm(g))

// -- A_n is a subgroup: the three closure conditions ---------------------------------------

theorem productUpToZero = permutation_sequence.productUpToZero
theorem seqSingleton = permutation_sequence.seqSingleton
theorem dividesZero = peano_divides.dividesZero

// Below ZERO there is no index, so every entry is vacuously a transposition — the empty
// factorization's side condition.
theorem nothingBelowZeroIsATransposition: forall s: Seq;
  forall i: Nat; nat_less_than(i, NZERO) -> isTransposition(at(s, i))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-i |
        fix i: Nat {
          @nothing-is-below-zero |
            not nat_less_than(i, NZERO)
            [using specialize peano.notLessThanZero(i)]
          @vacuous |
            nat_less_than(i, NZERO) -> isTransposition(at(s, i))
            [using tautology nothing-is-below-zero]
        }
      @discharge-i |
        forall i: Nat; nat_less_than(i, NZERO) -> isTransposition(at(s, i))
        [by forall_intro generalize-i]
    }
  @conclusion |
    forall s: Seq; forall i: Nat; nat_less_than(i, NZERO) -> isTransposition(at(s, i))
    [by forall_intro generalize-s]
qed

// (i) the IDENTITY is even: it is the EMPTY product of transpositions, and 0 is even.
theorem identityIsEven: isEvenPerm(identityFn)
proof
  @the-identity-is-a-permutation |
    invertible(identityFn)
    [by cite identityIsAPermutation]
  @some-sequence-exists |
    exists s: Seq; at(s, NZERO) = identityFn and productUpTo(s, succ(NZERO)) = identityFn
    [using specialize seqSingleton(identityFn) the-identity-is-a-permutation]
  @with-a-sequence |
    unpack s: Seq from some-sequence-exists {
      @empty-product |
        productUpTo(s, NZERO) = identityFn
        [using specialize productUpToZero(s)]
      @vacuously-transpositions |
        forall i: Nat; nat_less_than(i, NZERO) -> isTransposition(at(s, i))
        [using specialize nothingBelowZeroIsATransposition(s)]
      @what-all-transpositions-means |
        allTranspositions(s, NZERO) iff (forall i: Nat; nat_less_than(i, NZERO) -> isTransposition(at(s, i)))
        [using specialize allTranspositionsDef(s, NZERO)]
      @all-entries-are-transpositions |
        allTranspositions(s, NZERO)
        [using tautology what-all-transpositions-means vacuously-transpositions]
      @zero-is-even |
        divides(TWO, NZERO)
        [using specialize dividesZero(TWO)]
      @all-three |
        allTranspositions(s, NZERO) and productUpTo(s, NZERO) = identityFn and divides(TWO, NZERO)
        [using tautology all-entries-are-transpositions empty-product zero-is-even]
      @inner-witness |
        exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = identityFn and divides(TWO, m)
        [by exists_intro(NZERO) all-three]
      @a-factorization-exists |
        exists s2: Seq; exists m: Nat; allTranspositions(s2, m) and productUpTo(s2, m) = identityFn and divides(TWO, m)
        [by exists_intro(s) inner-witness]
      @what-even-means |
        isEvenPerm(identityFn) iff (exists s2: Seq; exists m: Nat; allTranspositions(s2, m) and productUpTo(s2, m) = identityFn and divides(TWO, m))
        [using specialize isEvenPermDef(identityFn)]
      @conclusion-the-identity-is-even |
        isEvenPerm(identityFn)
        [using tautology what-even-means a-factorization-exists]
    }
  @conclusion |
    isEvenPerm(identityFn)
    [by exists_elim with-a-sequence]
qed

// -- the reversed factorization ------------------------------------------------------------

func sub = peano.sub
func revProductUpTo = permutation_sequence.revProductUpTo
axiom seqReverse = permutation_sequence.seqReverse
theorem invOfProduct = permutation_sequence.invOfProduct

// The arithmetic Judson leaves silent when he writes "σ_m ⋯ σ_1": reversing an index keeps
// it in range — i < n implies n-(i+1) < n.
theorem reversedIndexInRange: forall n: Nat; forall i: Nat;
  nat_less_than(i, n) -> nat_less_than(sub(n, succ(i)), n)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-i |
        fix i: Nat {
          @given-i-below-n |
            assume nat_less_than(i, n) {
              @i-below-n |
                nat_less_than(i, n)
                [by hypothesis given-i-below-n]
              @zero-plus-successor |
                peano.add(NZERO, succ(i)) = succ(i)
                [using specialize peano.addZeroLeft(succ(i))]
              @successor-is-positive |
                nat_less_than(NZERO, succ(i))
                [using specialize peano_order.lessThanIntro(NZERO, i, succ(i)) zero-plus-successor]
              @successor-below-successor |
                nat_less_than(succ(i), succ(n))
                [using specialize peano_order.succPreservesOrder(i, n) i-below-n]
              @conclusion-in-range |
                nat_less_than(sub(n, succ(i)), n)
                [using specialize peano_subtraction.subStrictlyDecreases(succ(i), n) successor-is-positive successor-below-successor]
            }
          @conclusion-implication |
            nat_less_than(i, n) -> nat_less_than(sub(n, succ(i)), n)
            [by implies_intro given-i-below-n]
        }
      @discharge-i |
        forall i: Nat; nat_less_than(i, n) -> nat_less_than(sub(n, succ(i)), n)
        [by forall_intro generalize-i]
    }
  @conclusion |
    forall n: Nat; forall i: Nat; nat_less_than(i, n) -> nat_less_than(sub(n, succ(i)), n)
    [by forall_intro generalize-n]
qed

// A REVERSED transposition sequence is still a transposition sequence, and its product is
// the inverse of the original's. (Judson: "the inverse of σ is σ_m ⋯ σ_1" — he can say it
// in one line because each σ_i is its own inverse.)
theorem reversedIsTranspositions: forall s: Seq; forall n: Nat;
  allTranspositions(s, n) ->
  exists r: Seq; allTranspositions(r, n) and productUpTo(r, n) = inverse(productUpTo(s, n))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-n |
        fix n: Nat {
          @given-all-transpositions |
            assume allTranspositions(s, n) {
              @the-reversal-exists |
                exists r: Seq;
                  (forall i: Nat; nat_less_than(i, n) -> at(r, i) = at(s, sub(n, succ(i))))
                  and productUpTo(r, n) = revProductUpTo(s, n)
                [using specialize seqReverse(s, n)]
              @with-reversal-r |
                unpack r: Seq from the-reversal-exists {
                  @reversal-properties |
                    (forall i: Nat; nat_less_than(i, n) -> at(r, i) = at(s, sub(n, succ(i))))
                      and productUpTo(r, n) = revProductUpTo(s, n)
                    [by hypothesis with-reversal-r]
                  @entries-are-s-entries |
                    forall i: Nat; nat_less_than(i, n) -> at(r, i) = at(s, sub(n, succ(i)))
                    [by and_elim_left reversal-properties]
                  @product-is-the-reversed-product |
                    productUpTo(r, n) = revProductUpTo(s, n)
                    [by and_elim_right reversal-properties]
                  @reversed-product-is-the-inverse |
                    inverse(productUpTo(s, n)) = revProductUpTo(s, n)
                    [using specialize invOfProduct(s, n)]
                  @product-of-r-is-the-inverse |
                    productUpTo(r, n) = inverse(productUpTo(s, n))
                    [using chain product-is-the-reversed-product reversed-product-is-the-inverse]
                  @s-is-a-transposition-sequence |
                    allTranspositions(s, n)
                    [by hypothesis given-all-transpositions]
                  @what-s-being-transpositions-means |
                    allTranspositions(s, n) iff (forall i: Nat; nat_less_than(i, n) -> isTransposition(at(s, i)))
                    [using specialize allTranspositionsDef(s, n)]
                  @s-entries-are-transpositions |
                    forall i: Nat; nat_less_than(i, n) -> isTransposition(at(s, i))
                    [using tautology what-s-being-transpositions-means s-is-a-transposition-sequence]
                  @reversed-index-in-range |
                    forall i: Nat; nat_less_than(i, n) -> nat_less_than(sub(n, succ(i)), n)
                    [using specialize reversedIndexInRange(n)]
                  // per entry: fix i below n, rewrite r's entry to s's at the reversed
                  // index, and apply s's hypothesis THERE (which needs the index bound).
                  @generalize-entry |
                    fix i: Nat {
                      @given-i-below-n |
                        assume nat_less_than(i, n) {
                          @i-below-n |
                            nat_less_than(i, n)
                            [by hypothesis given-i-below-n]
                          @r-entry-is-an-s-entry |
                            at(r, i) = at(s, sub(n, succ(i)))
                            [using specialize entries-are-s-entries(i) i-below-n]
                          @reversed-index-below-n |
                            nat_less_than(sub(n, succ(i)), n)
                            [using specialize reversed-index-in-range(i) i-below-n]
                          @s-entry-is-a-transposition |
                            isTransposition(at(s, sub(n, succ(i))))
                            [using specialize s-entries-are-transpositions(sub(n, succ(i))) reversed-index-below-n]
                          @conclusion-entry |
                            isTransposition(at(r, i))
                            [by rewrite r-entry-is-an-s-entry s-entry-is-a-transposition]
                        }
                      @conclusion-entry-implication |
                        nat_less_than(i, n) -> isTransposition(at(r, i))
                        [by implies_intro given-i-below-n]
                    }
                  @every-entry-of-r-is-a-transposition |
                    forall i: Nat; nat_less_than(i, n) -> isTransposition(at(r, i))
                    [by forall_intro generalize-entry]
                  @what-r-being-transpositions-means |
                    allTranspositions(r, n) iff (forall i: Nat; nat_less_than(i, n) -> isTransposition(at(r, i)))
                    [using specialize allTranspositionsDef(r, n)]
                  @r-is-a-transposition-sequence |
                    allTranspositions(r, n)
                    [using tautology what-r-being-transpositions-means every-entry-of-r-is-a-transposition]
                  @r-is-a-transposition-sequence-with-the-inverse-product |
                    allTranspositions(r, n) and productUpTo(r, n) = inverse(productUpTo(s, n))
                    [by and_intro r-is-a-transposition-sequence product-of-r-is-the-inverse]
                  @conclusion-witness |
                    exists r2: Seq; allTranspositions(r2, n) and productUpTo(r2, n) = inverse(productUpTo(s, n))
                    [by exists_intro(r) r-is-a-transposition-sequence-with-the-inverse-product]
                }
              @conclusion-unpacked |
                exists r2: Seq; allTranspositions(r2, n) and productUpTo(r2, n) = inverse(productUpTo(s, n))
                [by exists_elim with-reversal-r]
            }
          @conclusion-implication |
            allTranspositions(s, n) ->
              exists r2: Seq; allTranspositions(r2, n) and productUpTo(r2, n) = inverse(productUpTo(s, n))
            [by implies_intro given-all-transpositions]
        }
      @discharge-n |
        forall n: Nat; allTranspositions(s, n) ->
          exists r2: Seq; allTranspositions(r2, n) and productUpTo(r2, n) = inverse(productUpTo(s, n))
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall s: Seq; forall n: Nat; allTranspositions(s, n) ->
      exists r2: Seq; allTranspositions(r2, n) and productUpTo(r2, n) = inverse(productUpTo(s, n))
    [by forall_intro generalize-s]
qed

// -- (ii) an even permutation's inverse is even --------------------------------------------

// Judson: "the inverse of any transposition is itself, so σ⁻¹ = σ_r ⋯ σ_1 is also in A_n" —
// the reversed sequence, same length, hence the same parity.
theorem inverseOfEvenIsEven: forall g: Fn; isEvenPerm(g) -> isEvenPerm(inverse(g))
proof
  @generalize-g |
    fix g: Fn {
      @given-even |
        assume isEvenPerm(g) {
          @g-is-even |
            isEvenPerm(g)
            [by hypothesis given-even]
          @what-even-means-for-g |
            isEvenPerm(g) iff (exists s: Seq; exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m))
            [using specialize isEvenPermDef(g)]
          @the-witness |
            exists s: Seq; exists m: Nat;
              allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
            [using tautology what-even-means-for-g g-is-even]
          @with-sequence |
            unpack s: Seq from the-witness {
              @inner |
                exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                [by hypothesis with-sequence]
              @with-length |
                unpack m: Nat from inner {
                  @facts |
                    allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                    [by hypothesis with-length]
                  @first-two |
                    allTranspositions(s, m) and productUpTo(s, m) = g
                    [by and_elim_left facts]
                  @transpositions |
                    allTranspositions(s, m)
                    [by and_elim_left first-two]
                  @product-is-g |
                    productUpTo(s, m) = g
                    [by and_elim_right first-two]
                  @m-is-even |
                    divides(TWO, m)
                    [by and_elim_right facts]
                  // the REVERSED sequence: same length m, still transpositions, product g⁻¹
                  @reversal-exists |
                    exists r: Seq; allTranspositions(r, m) and productUpTo(r, m) = inverse(productUpTo(s, m))
                    [using specialize reversedIsTranspositions(s, m) transpositions]
                  @with-reversal |
                    unpack r: Seq from reversal-exists {
                      @reversal-facts |
                        allTranspositions(r, m) and productUpTo(r, m) = inverse(productUpTo(s, m))
                        [by hypothesis with-reversal]
                      @r-transpositions |
                        allTranspositions(r, m)
                        [by and_elim_left reversal-facts]
                      @r-product |
                        productUpTo(r, m) = inverse(productUpTo(s, m))
                        [by and_elim_right reversal-facts]
                      @r-product-is-g-inverse |
                        productUpTo(r, m) = inverse(g)
                        [by rewrite product-is-g r-product]
                      @r-all-three |
                        allTranspositions(r, m) and productUpTo(r, m) = inverse(g) and divides(TWO, m)
                        [using tautology r-transpositions r-product-is-g-inverse m-is-even]
                      @inner-witness |
                        exists m2: Nat; allTranspositions(r, m2) and productUpTo(r, m2) = inverse(g) and divides(TWO, m2)
                        [by exists_intro(m) r-all-three]
                      @a-factorization-exists |
                        exists r2: Seq; exists m2: Nat; allTranspositions(r2, m2) and productUpTo(r2, m2) = inverse(g) and divides(TWO, m2)
                        [by exists_intro(r) inner-witness]
                      @what-even-means-for-the-inverse |
                        isEvenPerm(inverse(g)) iff (exists r2: Seq; exists m2: Nat; allTranspositions(r2, m2) and productUpTo(r2, m2) = inverse(g) and divides(TWO, m2))
                        [using specialize isEvenPermDef(inverse(g))]
                      @conclusion-witness |
                        isEvenPerm(inverse(g))
                        [using tautology what-even-means-for-the-inverse a-factorization-exists]
                    }
                  @conclusion-reversal |
                    isEvenPerm(inverse(g))
                    [by exists_elim with-reversal]
                }
              @conclusion-length |
                isEvenPerm(inverse(g))
                [by exists_elim with-length]
            }
          @conclusion-sequence |
            isEvenPerm(inverse(g))
            [by exists_elim with-sequence]
        }
      @conclusion-implication |
        isEvenPerm(g) -> isEvenPerm(inverse(g))
        [by implies_intro given-even]
    }
  @conclusion |
    forall g: Fn; isEvenPerm(g) -> isEvenPerm(inverse(g))
    [by forall_intro generalize-g]
qed

// -- (iii) the product of two even permutations is even ------------------------------------

func nadd = peano.add
theorem dividesAdd = peano_divides.dividesAdd
theorem concatenationPreservesTranspositions = permutation_transpositions.concatenationPreservesTranspositions
axiom seqConcat = permutation_sequence.seqConcat

// Judson's "since the product of two even permutations must also be an even permutation,
// A_n is closed": concatenate the two transposition sequences — the lengths ADD, and even
// plus even is even.
theorem productOfEvensIsEven: forall g: Fn; forall h: Fn;
  isEvenPerm(g) -> isEvenPerm(h) -> isEvenPerm(compose(g, h))
proof
  @generalize-g |
    fix g: Fn {
      @generalize-h |
        fix h: Fn {
          @given-g-even |
            assume isEvenPerm(g) {
              @given-h-even |
                assume isEvenPerm(h) {
                  @g-is-even |
                    isEvenPerm(g)
                    [by hypothesis given-g-even]
                  @h-is-even |
                    isEvenPerm(h)
                    [by hypothesis given-h-even]
                  @what-even-means-for-g |
                    isEvenPerm(g) iff (exists s: Seq; exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m))
                    [using specialize isEvenPermDef(g)]
                  @what-even-means-for-h |
                    isEvenPerm(h) iff (exists t: Seq; exists n: Nat; allTranspositions(t, n) and productUpTo(t, n) = h and divides(TWO, n))
                    [using specialize isEvenPermDef(h)]
                  @g-witness |
                    exists s: Seq; exists m: Nat;
                      allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                    [using tautology what-even-means-for-g g-is-even]
                  @h-witness |
                    exists t: Seq; exists n: Nat;
                      allTranspositions(t, n) and productUpTo(t, n) = h and divides(TWO, n)
                    [using tautology what-even-means-for-h h-is-even]
                  @with-g-seq |
                    unpack s: Seq from g-witness {
                      @g-inner |
                        exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                        [by hypothesis with-g-seq]
                      @with-g-len |
                        unpack m: Nat from g-inner {
                          @g-facts |
                            allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                            [by hypothesis with-g-len]
                          @g-pair |
                            allTranspositions(s, m) and productUpTo(s, m) = g
                            [by and_elim_left g-facts]
                          @g-transpositions |
                            allTranspositions(s, m)
                            [by and_elim_left g-pair]
                          @g-product |
                            productUpTo(s, m) = g
                            [by and_elim_right g-pair]
                          @g-even |
                            divides(TWO, m)
                            [by and_elim_right g-facts]
                          @with-h-seq |
                            unpack t: Seq from h-witness {
                              @h-inner |
                                exists n: Nat; allTranspositions(t, n) and productUpTo(t, n) = h and divides(TWO, n)
                                [by hypothesis with-h-seq]
                              @with-h-len |
                                unpack n: Nat from h-inner {
                                  @h-facts |
                                    allTranspositions(t, n) and productUpTo(t, n) = h and divides(TWO, n)
                                    [by hypothesis with-h-len]
                                  @h-pair |
                                    allTranspositions(t, n) and productUpTo(t, n) = h
                                    [by and_elim_left h-facts]
                                  @h-transpositions |
                                    allTranspositions(t, n)
                                    [by and_elim_left h-pair]
                                  @h-product |
                                    productUpTo(t, n) = h
                                    [by and_elim_right h-pair]
                                  @h-even |
                                    divides(TWO, n)
                                    [by and_elim_right h-facts]
                                  // std's concatenation lemma takes the UNFOLDED per-entry
                                  // forms, so unpack both `allTranspositions` here.
                                  @what-g-transpositions-means |
                                    allTranspositions(s, m) iff (forall i: Nat; nat_less_than(i, m) -> isTransposition(at(s, i)))
                                    [using specialize allTranspositionsDef(s, m)]
                                  @g-entries |
                                    forall i: Nat; nat_less_than(i, m) -> isTransposition(at(s, i))
                                    [using tautology what-g-transpositions-means g-transpositions]
                                  @what-h-transpositions-means |
                                    allTranspositions(t, n) iff (forall i: Nat; nat_less_than(i, n) -> isTransposition(at(t, i)))
                                    [using specialize allTranspositionsDef(t, n)]
                                  @h-entries |
                                    forall i: Nat; nat_less_than(i, n) -> isTransposition(at(t, i))
                                    [using tautology what-h-transpositions-means h-transpositions]
                                  // concatenate s (length m) with t (length n)
                                  @concat-exists |
                                    exists u: Seq;
                                      (forall i: Nat; nat_less_than(i, m) -> at(u, i) = at(s, i))
                                      and (forall i: Nat; nat_less_than(i, n) -> at(u, nadd(m, i)) = at(t, i))
                                      and productUpTo(u, nadd(m, n)) = compose(productUpTo(s, m), productUpTo(t, n))
                                    [using specialize seqConcat(s, t, m, n)]
                                  @with-concat |
                                    unpack u: Seq from concat-exists {
                                      @concat-facts |
                                        (forall i: Nat; nat_less_than(i, m) -> at(u, i) = at(s, i))
                                          and (forall i: Nat; nat_less_than(i, n) -> at(u, nadd(m, i)) = at(t, i))
                                          and productUpTo(u, nadd(m, n)) = compose(productUpTo(s, m), productUpTo(t, n))
                                        [by hypothesis with-concat]
                                      @agreement-pair |
                                        (forall i: Nat; nat_less_than(i, m) -> at(u, i) = at(s, i))
                                          and (forall i: Nat; nat_less_than(i, n) -> at(u, nadd(m, i)) = at(t, i))
                                        [by and_elim_left concat-facts]
                                      @agrees-with-s |
                                        forall i: Nat; nat_less_than(i, m) -> at(u, i) = at(s, i)
                                        [by and_elim_left agreement-pair]
                                      @agrees-with-t |
                                        forall i: Nat; nat_less_than(i, n) -> at(u, nadd(m, i)) = at(t, i)
                                        [by and_elim_right agreement-pair]
                                      @concat-product |
                                        productUpTo(u, nadd(m, n)) = compose(productUpTo(s, m), productUpTo(t, n))
                                        [by and_elim_right concat-facts]
                                      @u-entries |
                                        forall i: Nat; nat_less_than(i, nadd(m, n)) -> isTransposition(at(u, i))
                                        [using specialize concatenationPreservesTranspositions(u, s, t, m, n) agrees-with-s agrees-with-t g-entries h-entries]
                                      @what-u-transpositions-means |
                                        allTranspositions(u, nadd(m, n)) iff (forall i: Nat; nat_less_than(i, nadd(m, n)) -> isTransposition(at(u, i)))
                                        [using specialize allTranspositionsDef(u, nadd(m, n))]
                                      @u-transpositions |
                                        allTranspositions(u, nadd(m, n))
                                        [using tautology what-u-transpositions-means u-entries]
                                      @product-with-g |
                                        productUpTo(u, nadd(m, n)) = compose(g, productUpTo(t, n))
                                        [by rewrite g-product concat-product]
                                      @product-is-gh |
                                        productUpTo(u, nadd(m, n)) = compose(g, h)
                                        [by rewrite h-product product-with-g]
                                      @length-is-even |
                                        divides(TWO, nadd(m, n))
                                        [using specialize dividesAdd(TWO, m, n) g-even h-even]
                                      @u-all-three |
                                        allTranspositions(u, nadd(m, n)) and productUpTo(u, nadd(m, n)) = compose(g, h) and divides(TWO, nadd(m, n))
                                        [using tautology u-transpositions product-is-gh length-is-even]
                                      @inner-witness |
                                        exists k: Nat; allTranspositions(u, k) and productUpTo(u, k) = compose(g, h) and divides(TWO, k)
                                        [by exists_intro(nadd(m, n)) u-all-three]
                                      @a-factorization-exists |
                                        exists u2: Seq; exists k: Nat; allTranspositions(u2, k) and productUpTo(u2, k) = compose(g, h) and divides(TWO, k)
                                        [by exists_intro(u) inner-witness]
                                      @what-even-means-for-the-product |
                                        isEvenPerm(compose(g, h)) iff (exists u2: Seq; exists k: Nat; allTranspositions(u2, k) and productUpTo(u2, k) = compose(g, h) and divides(TWO, k))
                                        [using specialize isEvenPermDef(compose(g, h))]
                                      @conclusion-witness |
                                        isEvenPerm(compose(g, h))
                                        [using tautology what-even-means-for-the-product a-factorization-exists]
                                    }
                                  @conclusion-concat |
                                    isEvenPerm(compose(g, h))
                                    [by exists_elim with-concat]
                                }
                              @conclusion-h-len |
                                isEvenPerm(compose(g, h))
                                [by exists_elim with-h-len]
                            }
                          @conclusion-h-seq |
                            isEvenPerm(compose(g, h))
                            [by exists_elim with-h-seq]
                        }
                      @conclusion-g-len |
                        isEvenPerm(compose(g, h))
                        [by exists_elim with-g-len]
                    }
                  @conclusion-g-seq |
                    isEvenPerm(compose(g, h))
                    [by exists_elim with-g-seq]
                }
              @conclusion-h |
                isEvenPerm(h) -> isEvenPerm(compose(g, h))
                [by implies_intro given-h-even]
            }
          @conclusion-g |
            isEvenPerm(g) -> isEvenPerm(h) -> isEvenPerm(compose(g, h))
            [by implies_intro given-g-even]
        }
      @discharge-h |
        forall h: Fn; isEvenPerm(g) -> isEvenPerm(h) -> isEvenPerm(compose(g, h))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g: Fn; forall h: Fn; isEvenPerm(g) -> isEvenPerm(h) -> isEvenPerm(compose(g, h))
    [by forall_intro generalize-g]
qed

// -- A_n as a subgroup ---------------------------------------------------------------------

// The three closure conditions in `inAlternating` terms — the form a consumer wants when it
// plugs A_n in as a subgroup of the permutations.
theorem theIdentityIsInTheAlternatingGroup: inAlternating(identityFn)
proof
  @the-identity-is-a-permutation |
    invertible(identityFn)
    [by cite identityIsAPermutation]
  @the-identity-is-even |
    isEvenPerm(identityFn)
    [by cite identityIsEven]
  @both |
    invertible(identityFn) and isEvenPerm(identityFn)
    [by and_intro the-identity-is-a-permutation the-identity-is-even]
  @what-membership-means |
    inAlternating(identityFn) iff (invertible(identityFn) and isEvenPerm(identityFn))
    [using specialize inAlternatingDef(identityFn)]
  @conclusion |
    inAlternating(identityFn)
    [using tautology what-membership-means both]
qed

theorem theAlternatingGroupIsClosedUnderInverses: forall g: Fn;
  inAlternating(g) -> inAlternating(inverse(g))
proof
  @generalize-g |
    fix g: Fn {
      @given-in |
        assume inAlternating(g) {
          @g-is-in |
            inAlternating(g)
            [by hypothesis given-in]
          @what-membership-means-for-g |
            inAlternating(g) iff (invertible(g) and isEvenPerm(g))
            [using specialize inAlternatingDef(g)]
          @g-is-a-permutation |
            invertible(g)
            [using tautology what-membership-means-for-g g-is-in]
          @g-is-even |
            isEvenPerm(g)
            [using tautology what-membership-means-for-g g-is-in]
          @the-inverse-is-a-permutation |
            invertible(inverse(g))
            [using specialize inverseIsAPermutation(g) g-is-a-permutation]
          @the-inverse-is-even |
            isEvenPerm(inverse(g))
            [using specialize inverseOfEvenIsEven(g) g-is-even]
          @both |
            invertible(inverse(g)) and isEvenPerm(inverse(g))
            [by and_intro the-inverse-is-a-permutation the-inverse-is-even]
          @what-membership-means-for-the-inverse |
            inAlternating(inverse(g)) iff (invertible(inverse(g)) and isEvenPerm(inverse(g)))
            [using specialize inAlternatingDef(inverse(g))]
          @conclusion-in |
            inAlternating(inverse(g))
            [using tautology what-membership-means-for-the-inverse both]
        }
      @conclusion-implication |
        inAlternating(g) -> inAlternating(inverse(g))
        [by implies_intro given-in]
    }
  @conclusion |
    forall g: Fn; inAlternating(g) -> inAlternating(inverse(g))
    [by forall_intro generalize-g]
qed

theorem theAlternatingGroupIsClosedUnderComposition: forall g: Fn; forall h: Fn;
  inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
proof
  @generalize-g |
    fix g: Fn {
      @generalize-h |
        fix h: Fn {
          @given-g-in |
            assume inAlternating(g) {
              @given-h-in |
                assume inAlternating(h) {
                  @g-is-in |
                    inAlternating(g)
                    [by hypothesis given-g-in]
                  @h-is-in |
                    inAlternating(h)
                    [by hypothesis given-h-in]
                  @what-membership-means-for-g |
                    inAlternating(g) iff (invertible(g) and isEvenPerm(g))
                    [using specialize inAlternatingDef(g)]
                  @what-membership-means-for-h |
                    inAlternating(h) iff (invertible(h) and isEvenPerm(h))
                    [using specialize inAlternatingDef(h)]
                  @g-is-a-permutation |
                    invertible(g)
                    [using tautology what-membership-means-for-g g-is-in]
                  @g-is-even |
                    isEvenPerm(g)
                    [using tautology what-membership-means-for-g g-is-in]
                  @h-is-a-permutation |
                    invertible(h)
                    [using tautology what-membership-means-for-h h-is-in]
                  @h-is-even |
                    isEvenPerm(h)
                    [using tautology what-membership-means-for-h h-is-in]
                  @the-product-is-a-permutation |
                    invertible(compose(g, h))
                    [using specialize composeIsAPermutation(g, h) g-is-a-permutation h-is-a-permutation]
                  @the-product-is-even |
                    isEvenPerm(compose(g, h))
                    [using specialize productOfEvensIsEven(g, h) g-is-even h-is-even]
                  @both |
                    invertible(compose(g, h)) and isEvenPerm(compose(g, h))
                    [by and_intro the-product-is-a-permutation the-product-is-even]
                  @what-membership-means-for-the-product |
                    inAlternating(compose(g, h)) iff (invertible(compose(g, h)) and isEvenPerm(compose(g, h)))
                    [using specialize inAlternatingDef(compose(g, h))]
                  @conclusion-in |
                    inAlternating(compose(g, h))
                    [using tautology what-membership-means-for-the-product both]
                }
              @conclusion-h |
                inAlternating(h) -> inAlternating(compose(g, h))
                [by implies_intro given-h-in]
            }
          @conclusion-g |
            inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
            [by implies_intro given-g-in]
        }
      @discharge-h |
        forall h: Fn; inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g: Fn; forall h: Fn; inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
    [by forall_intro generalize-g]
qed

// -- parity is well defined ----------------------------------------------------------------

theorem identityIsEvenLength = permutation_parity.identityIsEvenLengthForAnySequence
theorem inverseRight = function.inverseRight

// THE keystone of the even/odd theory: any two transposition factorizations of the SAME
// permutation have the same parity. Judson states it as "no permutation is both even and
// odd"; this is the form the proof needs. The argument: reverse s to factor sigma-inverse,
// concatenate with t, and the joined product is sigma * sigma-inverse = 1 — so the parity
// lemma applies to a product of length n+m, giving 2 | n+m; with 2 | m that yields 2 | n.
//
// `sigma` is a plain `Fn` with `invertible(sigma)` as a HYPOTHESIS (aata/5.1 fixes it in the
// guarded sort `Perm`, where the guard arrives via `[by predicate]`; in std this file keeps
// the unguarded carrier so the statement composes with the rest of the sequence theory).
theorem parityIsWellDefined: forall sigma: Fn; forall s: Seq; forall m: Nat; forall t: Seq; forall n: Nat;
  invertible(sigma) ->
  allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) ->
  allTranspositions(t, n) -> productUpTo(t, n) = sigma ->
  divides(TWO, n)
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-s |
        fix s: Seq {
          @generalize-m |
            fix m: Nat {
              @generalize-t |
                fix t: Seq {
                  @generalize-n |
                    fix n: Nat {
                      @given-sigma-invertible |
                        assume invertible(sigma) {
                          @given-s-transpositions |
                            assume allTranspositions(s, m) {
                              @given-s-product |
                                assume productUpTo(s, m) = sigma {
                                  @given-m-even |
                                    assume divides(TWO, m) {
                                      @given-t-transpositions |
                                        assume allTranspositions(t, n) {
                                          @given-t-product |
                                            assume productUpTo(t, n) = sigma {
                                              @s-transpositions |
                                                allTranspositions(s, m)
                                                [by hypothesis given-s-transpositions]
                                              @t-transpositions |
                                                allTranspositions(t, n)
                                                [by hypothesis given-t-transpositions]
                                              @s-product |
                                                productUpTo(s, m) = sigma
                                                [by hypothesis given-s-product]
                                              @t-product |
                                                productUpTo(t, n) = sigma
                                                [by hypothesis given-t-product]
                                              @m-even |
                                                divides(TWO, m)
                                                [by hypothesis given-m-even]
                                              // σ⁻¹ as a transposition product: reverse s.
                                              @reversal-exists |
                                                exists r: Seq; allTranspositions(r, m) and productUpTo(r, m) = inverse(productUpTo(s, m))
                                                [using specialize reversedIsTranspositions(s, m) s-transpositions]
                                              @with-reversal |
                                                unpack r: Seq from reversal-exists {
                                                  @reversal-facts |
                                                    allTranspositions(r, m) and productUpTo(r, m) = inverse(productUpTo(s, m))
                                                    [by hypothesis with-reversal]
                                                  @r-transpositions |
                                                    allTranspositions(r, m)
                                                    [by and_elim_left reversal-facts]
                                                  @r-product-is-inverse |
                                                    productUpTo(r, m) = inverse(productUpTo(s, m))
                                                    [by and_elim_right reversal-facts]
                                                  // 1 = τ₁⋯τ_n · σ_m⋯σ₁ : concatenate t with r.
                                                  @concat-exists |
                                                    exists u: Seq;
                                                      (forall i: Nat; nat_less_than(i, n) -> at(u, i) = at(t, i))
                                                      and (forall i: Nat; nat_less_than(i, m) -> at(u, nadd(n, i)) = at(r, i))
                                                      and productUpTo(u, nadd(n, m)) = compose(productUpTo(t, n), productUpTo(r, m))
                                                    [using specialize seqConcat(t, r, n, m)]
                                                  @with-concat |
                                                    unpack u: Seq from concat-exists {
                                                      @concat-facts |
                                                        (forall i: Nat; nat_less_than(i, n) -> at(u, i) = at(t, i))
                                                          and (forall i: Nat; nat_less_than(i, m) -> at(u, nadd(n, i)) = at(r, i))
                                                          and productUpTo(u, nadd(n, m)) = compose(productUpTo(t, n), productUpTo(r, m))
                                                        [by hypothesis with-concat]
                                                      // the conjunction nests LEFT: (A and B) and C
                                                      @u-agreement-pair |
                                                        (forall i: Nat; nat_less_than(i, n) -> at(u, i) = at(t, i))
                                                          and (forall i: Nat; nat_less_than(i, m) -> at(u, nadd(n, i)) = at(r, i))
                                                        [by and_elim_left concat-facts]
                                                      @u-agrees-with-t |
                                                        forall i: Nat; nat_less_than(i, n) -> at(u, i) = at(t, i)
                                                        [by and_elim_left u-agreement-pair]
                                                      @u-agrees-with-r |
                                                        forall i: Nat; nat_less_than(i, m) -> at(u, nadd(n, i)) = at(r, i)
                                                        [by and_elim_right u-agreement-pair]
                                                      @concat-product |
                                                        productUpTo(u, nadd(n, m)) = compose(productUpTo(t, n), productUpTo(r, m))
                                                        [by and_elim_right concat-facts]
                                                      // the joined product is σ·σ⁻¹ = 1.
                                                      @r-product-is-sigma-inverse |
                                                        productUpTo(r, m) = inverse(sigma)
                                                        [by rewrite s-product r-product-is-inverse]
                                                      @joined-is-sigma-times-its-inverse |
                                                        productUpTo(u, nadd(n, m)) = compose(sigma, inverse(sigma))
                                                        [using simplify concat-product t-product r-product-is-sigma-inverse]
                                                      @sigma-is-a-permutation |
                                                        invertible(sigma)
                                                        [by hypothesis given-sigma-invertible]
                                                      @sigma-times-inverse-is-identity |
                                                        compose(sigma, inverse(sigma)) = identityFn
                                                        [using specialize inverseRight(sigma) sigma-is-a-permutation]
                                                      @joined-is-identity |
                                                        productUpTo(u, nadd(n, m)) = identityFn
                                                        [using chain joined-is-sigma-times-its-inverse sigma-times-inverse-is-identity]
                                                      @what-t-transpositions-means |
                                                        allTranspositions(t, n) iff (forall i: Nat; nat_less_than(i, n) -> isTransposition(at(t, i)))
                                                        [using specialize allTranspositionsDef(t, n)]
                                                      @t-entries |
                                                        forall i: Nat; nat_less_than(i, n) -> isTransposition(at(t, i))
                                                        [using tautology what-t-transpositions-means t-transpositions]
                                                      @what-r-transpositions-means |
                                                        allTranspositions(r, m) iff (forall i: Nat; nat_less_than(i, m) -> isTransposition(at(r, i)))
                                                        [using specialize allTranspositionsDef(r, m)]
                                                      @r-entries |
                                                        forall i: Nat; nat_less_than(i, m) -> isTransposition(at(r, i))
                                                        [using tautology what-r-transpositions-means r-transpositions]
                                                      @joined-entries |
                                                        forall i: Nat; nat_less_than(i, nadd(n, m)) -> isTransposition(at(u, i))
                                                        [using specialize concatenationPreservesTranspositions(u, t, r, n, m) u-agrees-with-t u-agrees-with-r t-entries r-entries]
                                                      @joined-length-is-even |
                                                        divides(TWO, nadd(n, m))
                                                        [using specialize identityIsEvenLength(u, nadd(n, m)) joined-entries joined-is-identity]
                                                      // 2 | (n+m) and 2 | m give 2 | (n+m)-m = n.
                                                      @total-minus-m-is-even |
                                                        divides(TWO, sub(nadd(n, m), m))
                                                        [using specialize peano_divides.dividesSub(TWO, nadd(n, m), m) joined-length-is-even m-even]
                                                      @total-minus-m-is-n |
                                                        sub(nadd(n, m), m) = n
                                                        [using specialize peano_subtraction.subAddCancel(n, m)]
                                                      @conclusion-n-even |
                                                        divides(TWO, n)
                                                        [by rewrite total-minus-m-is-n total-minus-m-is-even]
                                                    }
                                                  @conclusion-concat |
                                                    divides(TWO, n)
                                                    [by exists_elim with-concat]
                                                }
                                              @conclusion-reversal |
                                                divides(TWO, n)
                                                [by exists_elim with-reversal]
                                            }
                                          @conclusion-t-product |
                                            productUpTo(t, n) = sigma -> divides(TWO, n)
                                            [by implies_intro given-t-product]
                                        }
                                      @conclusion-t-transpositions |
                                        allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                                        [by implies_intro given-t-transpositions]
                                    }
                                  @conclusion-m-even |
                                    divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                                    [by implies_intro given-m-even]
                                }
                              @conclusion-s-product |
                                productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                                [by implies_intro given-s-product]
                            }
                          @conclusion-s-transpositions |
                            allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                            [by implies_intro given-s-transpositions]
                        }
                      @conclusion-sigma-invertible |
                        invertible(sigma) -> allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                        [by implies_intro given-sigma-invertible]
                    }
                  @discharge-n |
                    forall n: Nat; invertible(sigma) -> allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                    [by forall_intro generalize-n]
                }
              @discharge-t |
                forall t: Seq; forall n: Nat; invertible(sigma) -> allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                [by forall_intro generalize-t]
            }
          @discharge-m |
            forall m: Nat; forall t: Seq; forall n: Nat; invertible(sigma) -> allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
            [by forall_intro generalize-m]
        }
      @discharge-s |
        forall s: Seq; forall m: Nat; forall t: Seq; forall n: Nat; invertible(sigma) -> allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
        [by forall_intro generalize-s]
    }
  @conclusion |
    forall sigma: Fn; forall s: Seq; forall m: Nat; forall t: Seq; forall n: Nat;
      invertible(sigma) ->
      allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) ->
      allTranspositions(t, n) -> productUpTo(t, n) = sigma ->
      divides(TWO, n)
    [by forall_intro generalize-sigma]
qed

// -- no permutation is both even and odd ---------------------------------------------------

theorem productUpToIsAPermutation = permutation_sequence.productUpToIsAPermutation
theorem twoDividesNoTwoConsecutive = peano_parity.twoDividesNoTwoConsecutive

// Judson's "no permutation is both even and odd" — immediate from `parityIsWellDefined`
// (both factorizations have the same parity) and the fact that m and m+1 are never both
// even. This is what makes EVEN and ODD a genuine dichotomy, so A_n is a proper subgroup.
theorem evenIsNotOdd: forall t: Fn; isEvenPerm(t) -> (not isOddPerm(t))
proof
  @generalize-t |
    fix t: Fn {
      @given-even |
        assume isEvenPerm(t) {
          @even |
            isEvenPerm(t)
            [by hypothesis given-even]
          @what-even-means |
            isEvenPerm(t) iff (exists s: Seq; exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = t and divides(TWO, m))
            [using specialize isEvenPermDef(t)]
          @even-witness |
            exists s: Seq; exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = t and divides(TWO, m)
            [using tautology what-even-means even]
          @suppose-odd |
            assume isOddPerm(t) {
              @odd |
                isOddPerm(t)
                [by hypothesis suppose-odd]
              @what-odd-means |
                isOddPerm(t) iff (exists s3: Seq; exists m3: Nat; allTranspositions(s3, m3) and productUpTo(s3, m3) = t and divides(TWO, succ(m3)))
                [using specialize isOddPermDef(t)]
              @odd-witness |
                exists s3: Seq; exists m3: Nat; allTranspositions(s3, m3) and productUpTo(s3, m3) = t and divides(TWO, succ(m3))
                [using tautology what-odd-means odd]
              @with-even-sequence-s |
                unpack s: Seq from even-witness {
                  @after-s |
                    exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = t and divides(TWO, m)
                    [by hypothesis with-even-sequence-s]
                  @with-even-length-m |
                    unpack m: Nat from after-s {
                      @even-facts |
                        allTranspositions(s, m) and productUpTo(s, m) = t and divides(TWO, m)
                        [by hypothesis with-even-length-m]
                      @even-transpositions |
                        allTranspositions(s, m)
                        [using tautology even-facts]
                      @even-product |
                        productUpTo(s, m) = t
                        [using tautology even-facts]
                      @m-even |
                        divides(TWO, m)
                        [using tautology even-facts]
                      @product-invertible |
                        invertible(productUpTo(s, m))
                        [using specialize productUpToIsAPermutation(s, m)]
                      @t-invertible |
                        invertible(t)
                        [by rewrite even-product product-invertible]
                      @with-odd-sequence-s2 |
                        unpack s2: Seq from odd-witness {
                          @after-s2 |
                            exists m2: Nat; allTranspositions(s2, m2) and productUpTo(s2, m2) = t and divides(TWO, succ(m2))
                            [by hypothesis with-odd-sequence-s2]
                          @with-odd-length-m2 |
                            unpack m2: Nat from after-s2 {
                              @odd-facts |
                                allTranspositions(s2, m2) and productUpTo(s2, m2) = t and divides(TWO, succ(m2))
                                [by hypothesis with-odd-length-m2]
                              @odd-transpositions |
                                allTranspositions(s2, m2)
                                [using tautology odd-facts]
                              @odd-product |
                                productUpTo(s2, m2) = t
                                [using tautology odd-facts]
                              @succ-m2-even |
                                divides(TWO, succ(m2))
                                [using tautology odd-facts]
                              @m2-even |
                                divides(TWO, m2)
                                [using specialize parityIsWellDefined(t, s, m, s2, m2) t-invertible even-transpositions even-product m-even odd-transpositions odd-product]
                              @succ-m2-not-even |
                                not divides(TWO, succ(m2))
                                [using specialize twoDividesNoTwoConsecutive(m2) m2-even]
                              @conclusion-clash |
                                not isEvenPerm(t)
                                [by absurd succ-m2-even succ-m2-not-even]
                            }
                          @conclusion-with-m2 |
                            not isEvenPerm(t)
                            [by exists_elim with-odd-length-m2]
                        }
                      @conclusion-with-s2 |
                        not isEvenPerm(t)
                        [by exists_elim with-odd-sequence-s2]
                    }
                  @conclusion-with-m |
                    not isEvenPerm(t)
                    [by exists_elim with-even-length-m]
                }
              @not-even |
                not isEvenPerm(t)
                [by exists_elim with-even-sequence-s]
            }
          @conclusion-not-odd |
            not isOddPerm(t)
            [by not_intro suppose-odd even not-even]
        }
      @conclusion-at-t |
        isEvenPerm(t) -> (not isOddPerm(t))
        [by implies_intro given-even]
    }
  @conclusion |
    forall t: Fn; isEvenPerm(t) -> (not isOddPerm(t))
    [by forall_intro generalize-t]
qed

// -- Judson Lemma 1: A_n is generated by 3-cycles --------------------------------------
//
// "To show that the 3-cycles generate A_n, we need only show that any pair of
// transpositions can be written as the product of 3-cycles. Since (a,b) = (b,a), every
// pair of transpositions must be one of the following:"
//
//     (a,b)(a,b) = identity        -- std's `transpositionIsAnInvolution`
//     (a,b)(c,d) = (a,c,b)(a,c,d)  -- `aPairOfDisjointTranspositionsIsAProductOfThreeCycles`
//     (a,b)(a,c) = (a,c,b)         -- DEFINITIONAL, see below
//
// A 3-cycle needs no new sort. std's cycle fold (`cycleSucc`) makes
// `cycle(s, 3) = (a0 a2) o (a0 a1) o ((a0 a0) o id)`, so a 3-cycle IS a composite of two
// transpositions sharing their first point — which is why the third identity is a reading
// of the definition rather than a theorem, and why the second carries the content.
//   (a,c,b) = (a,b)o(a,c)   and   (a,c,d) = (a,d)o(a,c)
// so the RHS is [(a,b)o(a,c)] o [(a,d)o(a,c)].

// the value of a four-factor composite at a point, as a chain of composeApply steps
theorem fourFactorValue: forall p, q, r, t: Fn; forall x: Element;
  apply(compose(compose(p, q), compose(r, t)), x) = apply(p, apply(q, apply(r, apply(t, x))))
proof
  @generalize-p |
    fix p: Fn {
      @generalize-q |
        fix q: Fn {
          @generalize-r |
            fix r: Fn {
              @generalize-t |
                fix t: Fn {
                  @generalize-x |
                    fix x: Element {
                      @split-outer |
                        apply(compose(compose(p, q), compose(r, t)), x) = apply(compose(p, q), apply(compose(r, t), x))
                        [using specialize composeApply(compose(p, q), compose(r, t), x)]
                      @split-left |
                        apply(compose(p, q), apply(compose(r, t), x)) = apply(p, apply(q, apply(compose(r, t), x)))
                        [using specialize composeApply(p, q, apply(compose(r, t), x))]
                      @split-right |
                        apply(compose(r, t), x) = apply(r, apply(t, x))
                        [using specialize composeApply(r, t, x)]
                      @conclusion-value |
                        apply(compose(compose(p, q), compose(r, t)), x) = apply(p, apply(q, apply(r, apply(t, x))))
                        [using chain split-outer split-left split-right]
                    }
                  @discharge-x |
                    forall x: Element; apply(compose(compose(p, q), compose(r, t)), x) = apply(p, apply(q, apply(r, apply(t, x))))
                    [by forall_intro generalize-x]
                }
              @discharge-t |
                forall t: Fn; forall x: Element; apply(compose(compose(p, q), compose(r, t)), x) = apply(p, apply(q, apply(r, apply(t, x))))
                [by forall_intro generalize-t]
            }
          @discharge-r |
            forall r, t: Fn; forall x: Element; apply(compose(compose(p, q), compose(r, t)), x) = apply(p, apply(q, apply(r, apply(t, x))))
            [by forall_intro generalize-r]
        }
      @discharge-q |
        forall q, r, t: Fn; forall x: Element; apply(compose(compose(p, q), compose(r, t)), x) = apply(p, apply(q, apply(r, apply(t, x))))
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall p, q, r, t: Fn; forall x: Element; apply(compose(compose(p, q), compose(r, t)), x) = apply(p, apply(q, apply(r, apply(t, x))))
    [by forall_intro generalize-p]
qed

// -- the two sides' values at a point ------------------------------------------------------

// LHS (a,b)o(c,d) at x, as a nested apply
theorem twoFactorValue: forall p, q: Fn; forall x: Element;
  apply(compose(p, q), x) = apply(p, apply(q, x))
proof
  @conclusion |
    forall p, q: Fn; forall x: Element; apply(compose(p, q), x) = apply(p, apply(q, x))
    [by cite composeApply]
qed

//        (a,c): a->c ; (a,d) fixes c (c!=a, c!=d) ; (a,c): c->a ; (a,b): a->b.  = b

// `tautology` sees `a != c` and `c != a` as UNRELATED atoms, so symmetry of disequality
// is a real step. Needed in every case below, hence its own lemma.
theorem disequalityIsSymmetric: forall u, v: Element; u != v -> v != u
proof
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @given-u-not-v |
            assume u != v {
              @u-not-v |
                u != v
                [by hypothesis given-u-not-v]
              @suppose-v-equals-u |
                assume v = u {
                  @v-is-u |
                    v = u
                    [by hypothesis suppose-v-equals-u]
                  @u-is-v |
                    u = v
                    [by symmetry v-is-u]
                }
              @conclusion-v-not-u |
                v != u
                [by not_intro suppose-v-equals-u u-is-v u-not-v]
            }
          @conclusion-implication |
            u != v -> v != u
            [by implies_intro given-u-not-v]
        }
      @discharge-v |
        forall v: Element; u != v -> v != u
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall u, v: Element; u != v -> v != u
    [by forall_intro generalize-u]
qed

theorem bothSidesAgreeAtA: forall a, b, c, d: Element;
  a != c -> a != d -> c != d ->
  apply(compose(transposition(a, b), transposition(c, d)), a) =
  apply(compose(compose(transposition(a, b), transposition(a, c)),
  compose(transposition(a, d), transposition(a, c))), a)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-c |
                    assume a != c {
                      @given-a-d |
                        assume a != d {
                          @given-c-d |
                            assume c != d {
                              @a-not-c |
                                a != c
                                [by hypothesis given-a-c]
                              @a-not-d |
                                a != d
                                [by hypothesis given-a-d]
                              @c-not-d |
                                c != d
                                [by hypothesis given-c-d]
                              // LHS = b
                              @lhs-split |
                                apply(compose(transposition(a, b), transposition(c, d)), a) = apply(transposition(a, b), apply(transposition(c, d), a))
                                [using specialize composeApply(transposition(a, b), transposition(c, d), a)]
                              @inner-fixes-a |
                                apply(transposition(c, d), a) = a
                                [using specialize transpositionElsewhere(c, d, a) a-not-c a-not-d]
                              @ab-sends-a |
                                apply(transposition(a, b), a) = b
                                [using specialize transpositionAtFirst(a, b)]
                              @lhs-is-b |
                                apply(compose(transposition(a, b), transposition(c, d)), a) = b
                                [using chain lhs-split inner-fixes-a ab-sends-a]
                              // RHS = b, innermost first
                              @rhs-split |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a) =
                                  apply(transposition(a, b), apply(transposition(a, c), apply(transposition(a, d), apply(transposition(a, c), a))))
                                [using specialize fourFactorValue(transposition(a, b), transposition(a, c), transposition(a, d), transposition(a, c), a)]
                              @ac-sends-a |
                                apply(transposition(a, c), a) = c
                                [using specialize transpositionAtFirst(a, c)]
                              @c-not-a |
                                c != a
                                [using specialize disequalityIsSymmetric(a, c) a-not-c]
                              @ad-fixes-c |
                                apply(transposition(a, d), c) = c
                                [using specialize transpositionElsewhere(a, d, c) c-not-a c-not-d]
                              @ac-sends-c |
                                apply(transposition(a, c), c) = a
                                [using specialize transpositionAtSecond(a, c)]
                              @rhs-is-b |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a) = b
                                [using chain rhs-split ac-sends-a ad-fixes-c ac-sends-c ab-sends-a]
                              @conclusion-agree |
                                apply(compose(transposition(a, b), transposition(c, d)), a) =
                                  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                                [using chain lhs-is-b rhs-is-b]
                            }
                          @conclusion-c-d |
                            c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                            [by implies_intro given-c-d]
                        }
                      @conclusion-a-d |
                        a != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                        [by implies_intro given-a-d]
                    }
                  @conclusion-a-c |
                    a != c -> a != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                    [by implies_intro given-a-c]
                }
              @discharge-d |
                forall d: Element; a != c -> a != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != c -> a != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != c -> a != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != c -> a != d -> c != d ->
      apply(compose(transposition(a, b), transposition(c, d)), a) =
      apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
    [by forall_intro generalize-a]
qed

// -- identity (2)'s remaining four point-cases ---------------------------------------------
// Each is the same shape as `bothSidesAgreeAtA`: expand both sides to nested `apply`s
// (`twoFactorValue` / `fourFactorValue`), evaluate factor by factor with the three
// transposition point lemmas, and `chain` the two values together.

// at b: LHS (c,d) fixes b, then (a,b): b -> a.  RHS: all three (a,·) fix b, then (a,b): b -> a.
theorem bothSidesAgreeAtB: forall a, b, c, d: Element;
  a != b -> b != c -> b != d ->
  apply(compose(transposition(a, b), transposition(c, d)), b) =
  apply(compose(compose(transposition(a, b), transposition(a, c)),
  compose(transposition(a, d), transposition(a, c))), b)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-b |
                    assume a != b {
                      @given-b-c |
                        assume b != c {
                          @given-b-d |
                            assume b != d {
                              @a-not-b |
                                a != b
                                [by hypothesis given-a-b]
                              @b-not-c |
                                b != c
                                [by hypothesis given-b-c]
                              @b-not-d |
                                b != d
                                [by hypothesis given-b-d]
                              @b-not-a |
                                b != a
                                [using specialize disequalityIsSymmetric(a, b) a-not-b]
                              @ab-sends-b |
                                apply(transposition(a, b), b) = a
                                [using specialize transpositionAtSecond(a, b)]
                              @ac-fixes-b |
                                apply(transposition(a, c), b) = b
                                [using specialize transpositionElsewhere(a, c, b) b-not-a b-not-c]
                              @ad-fixes-b |
                                apply(transposition(a, d), b) = b
                                [using specialize transpositionElsewhere(a, d, b) b-not-a b-not-d]
                              @cd-fixes-b |
                                apply(transposition(c, d), b) = b
                                [using specialize transpositionElsewhere(c, d, b) b-not-c b-not-d]
                              @lhs-split |
                                apply(compose(transposition(a, b), transposition(c, d)), b) = apply(transposition(a, b), apply(transposition(c, d), b))
                                [using specialize twoFactorValue(transposition(a, b), transposition(c, d), b)]
                              @lhs-is-a |
                                apply(compose(transposition(a, b), transposition(c, d)), b) = a
                                [using chain lhs-split cd-fixes-b ab-sends-b]
                              @rhs-split |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b) =
                                  apply(transposition(a, b), apply(transposition(a, c), apply(transposition(a, d), apply(transposition(a, c), b))))
                                [using specialize fourFactorValue(transposition(a, b), transposition(a, c), transposition(a, d), transposition(a, c), b)]
                              @rhs-is-a |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b) = a
                                [using chain rhs-split ac-fixes-b ad-fixes-b ab-sends-b]
                              @conclusion-agree |
                                apply(compose(transposition(a, b), transposition(c, d)), b) =
                                  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                                [using chain lhs-is-a rhs-is-a]
                            }
                          @conclusion-b-d |
                            b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                            [by implies_intro given-b-d]
                        }
                      @conclusion-b-c |
                        b != c -> b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                        [by implies_intro given-b-c]
                    }
                  @conclusion-a-b |
                    a != b -> b != c -> b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                    [by implies_intro given-a-b]
                }
              @discharge-d |
                forall d: Element; a != b -> b != c -> b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != b -> b != c -> b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != b -> b != c -> b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != b -> b != c -> b != d ->
      apply(compose(transposition(a, b), transposition(c, d)), b) =
      apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
    [by forall_intro generalize-a]
qed

// at c: LHS (c,d): c->d then (a,b) fixes d.
//       RHS (a,c): c->a; (a,d): a->d; (a,c) fixes d; (a,b) fixes d.
theorem bothSidesAgreeAtC: forall a, b, c, d: Element;
  a != d -> b != d -> c != d ->
  apply(compose(transposition(a, b), transposition(c, d)), c) =
  apply(compose(compose(transposition(a, b), transposition(a, c)),
  compose(transposition(a, d), transposition(a, c))), c)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-d |
                    assume a != d {
                      @given-b-d |
                        assume b != d {
                          @given-c-d |
                            assume c != d {
                              @a-not-d |
                                a != d
                                [by hypothesis given-a-d]
                              @b-not-d |
                                b != d
                                [by hypothesis given-b-d]
                              @c-not-d |
                                c != d
                                [by hypothesis given-c-d]
                              @d-not-a |
                                d != a
                                [using specialize disequalityIsSymmetric(a, d) a-not-d]
                              @d-not-b |
                                d != b
                                [using specialize disequalityIsSymmetric(b, d) b-not-d]
                              @d-not-c |
                                d != c
                                [using specialize disequalityIsSymmetric(c, d) c-not-d]
                              @cd-sends-c |
                                apply(transposition(c, d), c) = d
                                [using specialize transpositionAtFirst(c, d)]
                              @ab-fixes-d |
                                apply(transposition(a, b), d) = d
                                [using specialize transpositionElsewhere(a, b, d) d-not-a d-not-b]
                              @ac-sends-c |
                                apply(transposition(a, c), c) = a
                                [using specialize transpositionAtSecond(a, c)]
                              @ad-sends-a |
                                apply(transposition(a, d), a) = d
                                [using specialize transpositionAtFirst(a, d)]
                              @ac-fixes-d |
                                apply(transposition(a, c), d) = d
                                [using specialize transpositionElsewhere(a, c, d) d-not-a d-not-c]
                              @lhs-split |
                                apply(compose(transposition(a, b), transposition(c, d)), c) = apply(transposition(a, b), apply(transposition(c, d), c))
                                [using specialize twoFactorValue(transposition(a, b), transposition(c, d), c)]
                              @lhs-value |
                                apply(compose(transposition(a, b), transposition(c, d)), c) = d
                                [using chain lhs-split cd-sends-c ab-fixes-d]
                              @rhs-split |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c) =
                                  apply(transposition(a, b), apply(transposition(a, c), apply(transposition(a, d), apply(transposition(a, c), c))))
                                [using specialize fourFactorValue(transposition(a, b), transposition(a, c), transposition(a, d), transposition(a, c), c)]
                              @rhs-value |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c) = d
                                [using chain rhs-split ac-sends-c ad-sends-a ac-fixes-d ab-fixes-d]
                              @conclusion-agree |
                                apply(compose(transposition(a, b), transposition(c, d)), c) =
                                  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-c-d |
                            c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                            [by implies_intro given-c-d]
                        }
                      @conclusion-b-d |
                        b != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                        [by implies_intro given-b-d]
                    }
                  @conclusion-a-d |
                    a != d -> b != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                    [by implies_intro given-a-d]
                }
              @discharge-d |
                forall d: Element; a != d -> b != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != d -> b != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != d -> b != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != d -> b != d -> c != d ->
      apply(compose(transposition(a, b), transposition(c, d)), c) =
      apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
    [by forall_intro generalize-a]
qed

theorem bothSidesAgreeAtD: forall a, b, c, d: Element;
  a != c -> a != d -> b != c -> c != d ->
  apply(compose(transposition(a, b), transposition(c, d)), d) =
  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-not-c |
                    assume a != c {
                      @given-a-not-d |
                        assume a != d {
                          @given-b-not-c |
                            assume b != c {
                              @given-c-not-d |
                                assume c != d {
                                  @a-not-c |
                                    a != c
                                    [by hypothesis given-a-not-c]
                                  @a-not-d |
                                    a != d
                                    [by hypothesis given-a-not-d]
                                  @b-not-c |
                                    b != c
                                    [by hypothesis given-b-not-c]
                                  @c-not-d |
                                    c != d
                                    [by hypothesis given-c-not-d]
                                  @c-not-a |
                                    c != a
                                    [using specialize disequalityIsSymmetric(a, c) a-not-c]
                                  @d-not-a |
                                    d != a
                                    [using specialize disequalityIsSymmetric(a, d) a-not-d]
                                  @c-not-b |
                                    c != b
                                    [using specialize disequalityIsSymmetric(b, c) b-not-c]
                                  @d-not-c |
                                    d != c
                                    [using specialize disequalityIsSymmetric(c, d) c-not-d]
                                  @cd-sends-d |
                                    apply(transposition(c, d), d) = c
                                    [using specialize transpositionAtSecond(c, d)]
                                  @ab-fixes-c |
                                    apply(transposition(a, b), c) = c
                                    [using specialize transpositionElsewhere(a, b, c) c-not-a c-not-b]
                                  @ac-fixes-d |
                                    apply(transposition(a, c), d) = d
                                    [using specialize transpositionElsewhere(a, c, d) d-not-a d-not-c]
                                  @ad-sends-d |
                                    apply(transposition(a, d), d) = a
                                    [using specialize transpositionAtSecond(a, d)]
                                  @ac-sends-a |
                                    apply(transposition(a, c), a) = c
                                    [using specialize transpositionAtFirst(a, c)]
                                  @lhs-split |
                                    apply(compose(transposition(a, b), transposition(c, d)), d) = apply(transposition(a, b), apply(transposition(c, d), d))
                                    [using specialize twoFactorValue(transposition(a, b), transposition(c, d), d)]
                                  @lhs-value |
                                    apply(compose(transposition(a, b), transposition(c, d)), d) = c
                                    [using chain lhs-split cd-sends-d ab-fixes-c]
                                  @rhs-split |
                                    apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d) =
                                      apply(transposition(a, b), apply(transposition(a, c), apply(transposition(a, d), apply(transposition(a, c), d))))
                                    [using specialize fourFactorValue(transposition(a, b), transposition(a, c), transposition(a, d), transposition(a, c), d)]
                                  @rhs-value |
                                    apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d) = c
                                    [using chain rhs-split ac-fixes-d ad-sends-d ac-sends-a ab-fixes-c]
                                  @conclusion-agree |
                                    apply(compose(transposition(a, b), transposition(c, d)), d) =
                                      apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                                    [using chain lhs-value rhs-value]
                                }
                              @conclusion-c-not-d |
                                c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                                [by implies_intro given-c-not-d]
                            }
                          @conclusion-b-not-c |
                            b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                            [by implies_intro given-b-not-c]
                        }
                      @conclusion-a-not-d |
                        a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                        [by implies_intro given-a-not-d]
                    }
                  @conclusion-a-not-c |
                    a != c -> a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                    [by implies_intro given-a-not-c]
                }
              @discharge-d |
                forall d: Element; a != c -> a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != c -> a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != c -> a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != c -> a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
    [by forall_intro generalize-a]
qed

// elsewhere: x is none of a,b,c,d, so every factor fixes it.
theorem bothSidesAgreeAtElsewhere: forall a, b, c, d, x: Element;
  x != a -> x != b -> x != c -> x != d ->
  apply(compose(transposition(a, b), transposition(c, d)), x) =
  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @generalize-x |
                    fix x: Element {
                      @given-x-not-a |
                        assume x != a {
                          @given-x-not-b |
                            assume x != b {
                              @given-x-not-c |
                                assume x != c {
                                  @given-x-not-d |
                                    assume x != d {
                                      @x-not-a |
                                        x != a
                                        [by hypothesis given-x-not-a]
                                      @x-not-b |
                                        x != b
                                        [by hypothesis given-x-not-b]
                                      @x-not-c |
                                        x != c
                                        [by hypothesis given-x-not-c]
                                      @x-not-d |
                                        x != d
                                        [by hypothesis given-x-not-d]
                                      @cd-fixes-x |
                                        apply(transposition(c, d), x) = x
                                        [using specialize transpositionElsewhere(c, d, x) x-not-c x-not-d]
                                      @ab-fixes-x |
                                        apply(transposition(a, b), x) = x
                                        [using specialize transpositionElsewhere(a, b, x) x-not-a x-not-b]
                                      @ac-fixes-x |
                                        apply(transposition(a, c), x) = x
                                        [using specialize transpositionElsewhere(a, c, x) x-not-a x-not-c]
                                      @ad-fixes-x |
                                        apply(transposition(a, d), x) = x
                                        [using specialize transpositionElsewhere(a, d, x) x-not-a x-not-d]
                                      @lhs-split |
                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(transposition(a, b), apply(transposition(c, d), x))
                                        [using specialize twoFactorValue(transposition(a, b), transposition(c, d), x)]
                                      @lhs-value |
                                        apply(compose(transposition(a, b), transposition(c, d)), x) = x
                                        [using chain lhs-split cd-fixes-x ab-fixes-x]
                                      @rhs-split |
                                        apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x) =
                                          apply(transposition(a, b), apply(transposition(a, c), apply(transposition(a, d), apply(transposition(a, c), x))))
                                        [using specialize fourFactorValue(transposition(a, b), transposition(a, c), transposition(a, d), transposition(a, c), x)]
                                      @rhs-value |
                                        apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x) = x
                                        [using chain rhs-split ac-fixes-x ad-fixes-x ab-fixes-x]
                                      @conclusion-agree |
                                        apply(compose(transposition(a, b), transposition(c, d)), x) =
                                          apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                        [using chain lhs-value rhs-value]
                                    }
                                  @conclusion-x-not-d |
                                    x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                    [by implies_intro given-x-not-d]
                                }
                              @conclusion-x-not-c |
                                x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                [by implies_intro given-x-not-c]
                            }
                          @conclusion-x-not-b |
                            x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                            [by implies_intro given-x-not-b]
                        }
                      @conclusion-x-not-a |
                        x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                        [by implies_intro given-x-not-a]
                    }
                  @discharge-x |
                    forall x: Element; x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                    [by forall_intro generalize-x]
                }
              @discharge-d |
                forall d, x: Element; x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d, x: Element; x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d, x: Element; x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d, x: Element; x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
    [by forall_intro generalize-a]
qed

// The pointwise agreement behind identity (2): five cases on where x sits.
theorem agreeAtEveryPoint: forall a, b, c, d: Element;
  a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
  forall x: Element;
  apply(compose(transposition(a, b), transposition(c, d)), x) =
  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-not-b |
                    assume a != b {
                      @given-a-not-c |
                        assume a != c {
                          @given-a-not-d |
                            assume a != d {
                              @given-b-not-c |
                                assume b != c {
                                  @given-b-not-d |
                                    assume b != d {
                                      @given-c-not-d |
                                        assume c != d {
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-not-b]
                                          @a-not-c |
                                            a != c
                                            [by hypothesis given-a-not-c]
                                          @a-not-d |
                                            a != d
                                            [by hypothesis given-a-not-d]
                                          @b-not-c |
                                            b != c
                                            [by hypothesis given-b-not-c]
                                          @b-not-d |
                                            b != d
                                            [by hypothesis given-b-not-d]
                                          @c-not-d |
                                            c != d
                                            [by hypothesis given-c-not-d]
                                          @generalize-x |
                                            fix x: Element {
                                              @cases |
                                                x = a or x = b or x = c or x = d or (x != a and x != b and x != c and x != d)
                                                [using tautology]
                                              @conclusion-at-x |
                                                apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                case cases {
                                                  @when-x-is-a |
                                                    assume x = a {
                                                      @x-is-a |
                                                        x = a
                                                        [by hypothesis when-x-is-a]
                                                      @agree-at-a |
                                                        apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                                                        [using specialize bothSidesAgreeAtA(a, b, c, d) a-not-c a-not-d c-not-d]
                                                      @conclusion-when-x-is-a |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                        [by rewrite x-is-a agree-at-a]
                                                    }
                                                  @when-x-is-b |
                                                    assume x = b {
                                                      @x-is-b |
                                                        x = b
                                                        [by hypothesis when-x-is-b]
                                                      @agree-at-b |
                                                        apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                                                        [using specialize bothSidesAgreeAtB(a, b, c, d) a-not-b b-not-c b-not-d]
                                                      @conclusion-when-x-is-b |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                        [by rewrite x-is-b agree-at-b]
                                                    }
                                                  @when-x-is-c |
                                                    assume x = c {
                                                      @x-is-c |
                                                        x = c
                                                        [by hypothesis when-x-is-c]
                                                      @agree-at-c |
                                                        apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                                                        [using specialize bothSidesAgreeAtC(a, b, c, d) a-not-d b-not-d c-not-d]
                                                      @conclusion-when-x-is-c |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                        [by rewrite x-is-c agree-at-c]
                                                    }
                                                  @when-x-is-d |
                                                    assume x = d {
                                                      @x-is-d |
                                                        x = d
                                                        [by hypothesis when-x-is-d]
                                                      @agree-at-d |
                                                        apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                                                        [using specialize bothSidesAgreeAtD(a, b, c, d) a-not-c a-not-d b-not-c c-not-d]
                                                      @conclusion-when-x-is-d |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                        [by rewrite x-is-d agree-at-d]
                                                    }
                                                  @when-x-is-elsewhere |
                                                    assume x != a and x != b and x != c and x != d {
                                                      @x-is-elsewhere |
                                                        x != a and x != b and x != c and x != d
                                                        [by hypothesis when-x-is-elsewhere]
                                                      @x-not-a |
                                                        x != a
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-b |
                                                        x != b
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-c |
                                                        x != c
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-d |
                                                        x != d
                                                        [using tautology x-is-elsewhere]
                                                      @conclusion-when-x-is-elsewhere |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                        [using specialize bothSidesAgreeAtElsewhere(a, b, c, d, x) x-not-a x-not-b x-not-c x-not-d]
                                                    }
                                                }
                                            }
                                          @discharge-x |
                                            forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                            [by forall_intro generalize-x]
                                        }
                                      @conclusion-c-not-d |
                                        c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                        [by implies_intro given-c-not-d]
                                    }
                                  @conclusion-b-not-d |
                                    b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                    [by implies_intro given-b-not-d]
                                }
                              @conclusion-b-not-c |
                                b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                [by implies_intro given-b-not-c]
                            }
                          @conclusion-a-not-d |
                            a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                            [by implies_intro given-a-not-d]
                        }
                      @conclusion-a-not-c |
                        a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                        [by implies_intro given-a-not-c]
                    }
                  @conclusion-a-not-b |
                    a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                    [by implies_intro given-a-not-b]
                }
              @discharge-d |
                forall d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
    [by forall_intro generalize-a]
qed

// -- Judson Lemma 1, identity (2) -----------------------------------------------------------
// (a,b)(c,d) = (a,c,b)(a,c,d) for a,b,c,d distinct. As composites of transpositions
// (a 3-cycle (x,y,z) is (x,z)o(x,y)), that reads
//   (a,b)o(c,d) = [(a,b)o(a,c)] o [(a,d)o(a,c)].
// Extensionality over the five point-cases proved above.
theorem aPairOfDisjointTranspositionsIsAProductOfThreeCycles:
  forall a, b, c, d: Element;
  a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
  compose(transposition(a, b), transposition(c, d)) =
  compose(compose(transposition(a, b), transposition(a, c)),
  compose(transposition(a, d), transposition(a, c)))
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-b |
                    assume a != b {
                      @given-a-c |
                        assume a != c {
                          @given-a-d |
                            assume a != d {
                              @given-b-c |
                                assume b != c {
                                  @given-b-d |
                                    assume b != d {
                                      @given-c-d |
                                        assume c != d {
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-b]
                                          @a-not-c |
                                            a != c
                                            [by hypothesis given-a-c]
                                          @a-not-d |
                                            a != d
                                            [by hypothesis given-a-d]
                                          @b-not-c |
                                            b != c
                                            [by hypothesis given-b-c]
                                          @b-not-d |
                                            b != d
                                            [by hypothesis given-b-d]
                                          @c-not-d |
                                            c != d
                                            [by hypothesis given-c-d]
                                          @agree-everywhere |
                                            forall x: Element;
                                              apply(compose(transposition(a, b), transposition(c, d)), x) =
                                              apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                            [using specialize agreeAtEveryPoint(a, b, c, d) a-not-b a-not-c a-not-d b-not-c b-not-d c-not-d]
                                          @conclusion-equal |
                                            compose(transposition(a, b), transposition(c, d)) =
                                              compose(compose(transposition(a, b), transposition(a, c)),
                                              compose(transposition(a, d), transposition(a, c)))
                                            [using specialize funcExtensionality(compose(transposition(a, b), transposition(c, d)), compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))) agree-everywhere]
                                        }
                                      @conclusion-c-d |
                                        c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                                        [by implies_intro given-c-d]
                                    }
                                  @conclusion-b-d |
                                    b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                                    [by implies_intro given-b-d]
                                }
                              @conclusion-b-c |
                                b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                                [by implies_intro given-b-c]
                            }
                          @conclusion-a-d |
                            a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                            [by implies_intro given-a-d]
                        }
                      @conclusion-a-c |
                        a != c -> a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                        [by implies_intro given-a-c]
                    }
                  @conclusion-a-b |
                    a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                    [by implies_intro given-a-b]
                }
              @discharge-d |
                forall d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
      compose(transposition(a, b), transposition(c, d)) =
      compose(compose(transposition(a, b), transposition(a, c)),
      compose(transposition(a, d), transposition(a, c)))
    [by forall_intro generalize-a]
qed

// -- Judson Lemma 2, identity (1): (i,a,j) = (i,j,a)^2 ------------------------------------

theorem squareAgreesAtI: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, j), transposition(i, a)), i) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @a-not-i |
                            a != i
                            [using specialize disequalityIsSymmetric(i, a) i-not-a]
                          @a-not-j |
                            a != j
                            [using specialize disequalityIsSymmetric(j, a) j-not-a]
                          @j-not-i |
                            j != i
                            [using specialize disequalityIsSymmetric(i, j) i-not-j]
                          @ia-sends-i |
                            apply(transposition(i, a), i) = a
                            [using specialize transpositionAtFirst(i, a)]
                          @ij-sends-i |
                            apply(transposition(i, j), i) = j
                            [using specialize transpositionAtFirst(i, j)]
                          @ij-fixes-a |
                            apply(transposition(i, j), a) = a
                            [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                          @ia-fixes-j |
                            apply(transposition(i, a), j) = j
                            [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                          @ij-sends-j |
                            apply(transposition(i, j), j) = i
                            [using specialize transpositionAtSecond(i, j)]
                          @lhs-split |
                            apply(compose(transposition(i, j), transposition(i, a)), i) = apply(transposition(i, j), apply(transposition(i, a), i))
                            [using specialize twoFactorValue(transposition(i, j), transposition(i, a), i)]
                          @lhs-value |
                            apply(compose(transposition(i, j), transposition(i, a)), i) = a
                            [using chain lhs-split ia-sends-i ij-fixes-a]
                          @rhs-split |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i) =
                              apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), i))))
                            [using specialize fourFactorValue(transposition(i, a), transposition(i, j), transposition(i, a), transposition(i, j), i)]
                          @rhs-value |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i) = a
                            [using chain rhs-split ij-sends-i ia-fixes-j ij-sends-j ia-sends-i]
                          @conclusion-agree |
                            apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                            [using chain lhs-value rhs-value]
                        }
                      @conclusion-j-not-a |
                        j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                    [by implies_intro given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                [by implies_intro given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
    [by forall_intro generalize-i]
qed

theorem squareAgreesAtA: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, j), transposition(i, a)), a) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @a-not-i |
                            a != i
                            [using specialize disequalityIsSymmetric(i, a) i-not-a]
                          @a-not-j |
                            a != j
                            [using specialize disequalityIsSymmetric(j, a) j-not-a]
                          @j-not-i |
                            j != i
                            [using specialize disequalityIsSymmetric(i, j) i-not-j]
                          @ia-sends-a |
                            apply(transposition(i, a), a) = i
                            [using specialize transpositionAtSecond(i, a)]
                          @ij-sends-i |
                            apply(transposition(i, j), i) = j
                            [using specialize transpositionAtFirst(i, j)]
                          @ij-fixes-a |
                            apply(transposition(i, j), a) = a
                            [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                          @ia-fixes-j |
                            apply(transposition(i, a), j) = j
                            [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                          @lhs-split |
                            apply(compose(transposition(i, j), transposition(i, a)), a) = apply(transposition(i, j), apply(transposition(i, a), a))
                            [using specialize twoFactorValue(transposition(i, j), transposition(i, a), a)]
                          @lhs-value |
                            apply(compose(transposition(i, j), transposition(i, a)), a) = j
                            [using chain lhs-split ia-sends-a ij-sends-i]
                          @rhs-split |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a) =
                              apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), a))))
                            [using specialize fourFactorValue(transposition(i, a), transposition(i, j), transposition(i, a), transposition(i, j), a)]
                          @rhs-value |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a) = j
                            [using chain rhs-split ij-fixes-a ia-sends-a ij-sends-i ia-fixes-j]
                          @conclusion-agree |
                            apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                            [using chain lhs-value rhs-value]
                        }
                      @conclusion-j-not-a |
                        j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                    [by implies_intro given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                [by implies_intro given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
    [by forall_intro generalize-i]
qed

theorem squareAgreesAtJ: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, j), transposition(i, a)), j) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @a-not-i |
                            a != i
                            [using specialize disequalityIsSymmetric(i, a) i-not-a]
                          @a-not-j |
                            a != j
                            [using specialize disequalityIsSymmetric(j, a) j-not-a]
                          @j-not-i |
                            j != i
                            [using specialize disequalityIsSymmetric(i, j) i-not-j]
                          @ia-fixes-j |
                            apply(transposition(i, a), j) = j
                            [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                          @ij-sends-j |
                            apply(transposition(i, j), j) = i
                            [using specialize transpositionAtSecond(i, j)]
                          @ia-sends-i |
                            apply(transposition(i, a), i) = a
                            [using specialize transpositionAtFirst(i, a)]
                          @ij-fixes-a |
                            apply(transposition(i, j), a) = a
                            [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                          @ia-sends-a |
                            apply(transposition(i, a), a) = i
                            [using specialize transpositionAtSecond(i, a)]
                          @lhs-split |
                            apply(compose(transposition(i, j), transposition(i, a)), j) = apply(transposition(i, j), apply(transposition(i, a), j))
                            [using specialize twoFactorValue(transposition(i, j), transposition(i, a), j)]
                          @lhs-value |
                            apply(compose(transposition(i, j), transposition(i, a)), j) = i
                            [using chain lhs-split ia-fixes-j ij-sends-j]
                          @rhs-split |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j) =
                              apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), j))))
                            [using specialize fourFactorValue(transposition(i, a), transposition(i, j), transposition(i, a), transposition(i, j), j)]
                          @rhs-value |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j) = i
                            [using chain rhs-split ij-sends-j ia-sends-i ij-fixes-a ia-sends-a]
                          @conclusion-agree |
                            apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                            [using chain lhs-value rhs-value]
                        }
                      @conclusion-j-not-a |
                        j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                    [by implies_intro given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                [by implies_intro given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
    [by forall_intro generalize-i]
qed

theorem squareAgreesAtElsewhere: forall i, j, a, x: Element;
  x != i -> x != j -> x != a ->
  apply(compose(transposition(i, j), transposition(i, a)), x) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-x |
                fix x: Element {
                  @given-x-not-i |
                    assume x != i {
                      @given-x-not-j |
                        assume x != j {
                          @given-x-not-a |
                            assume x != a {
                              @x-not-i |
                                x != i
                                [by hypothesis given-x-not-i]
                              @x-not-j |
                                x != j
                                [by hypothesis given-x-not-j]
                              @x-not-a |
                                x != a
                                [by hypothesis given-x-not-a]
                              @ij-fixes-x |
                                apply(transposition(i, j), x) = x
                                [using specialize transpositionElsewhere(i, j, x) x-not-i x-not-j]
                              @ia-fixes-x |
                                apply(transposition(i, a), x) = x
                                [using specialize transpositionElsewhere(i, a, x) x-not-i x-not-a]
                              @lhs-split |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = apply(transposition(i, j), apply(transposition(i, a), x))
                                [using specialize twoFactorValue(transposition(i, j), transposition(i, a), x)]
                              @lhs-value |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = x
                                [using chain lhs-split ia-fixes-x ij-fixes-x]
                              @rhs-split |
                                apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x) =
                                  apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), x))))
                                [using specialize fourFactorValue(transposition(i, a), transposition(i, j), transposition(i, a), transposition(i, j), x)]
                              @rhs-value |
                                apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x) = x
                                [using chain rhs-split ij-fixes-x ia-fixes-x]
                              @conclusion-agree |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-x-not-a |
                            x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                            [by implies_intro given-x-not-a]
                        }
                      @conclusion-x-not-j |
                        x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                        [by implies_intro given-x-not-j]
                    }
                  @conclusion-x-not-i |
                    x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                    [by implies_intro given-x-not-i]
                }
              @discharge-x |
                forall x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                [by forall_intro generalize-x]
            }
          @discharge-a |
            forall a, x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
    [by forall_intro generalize-i]
qed

// The pointwise agreement behind identity (1): four cases on where x sits.
theorem theSquareAgreesEverywhere: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  forall x: Element;
  apply(compose(transposition(i, j), transposition(i, a)), x) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @generalize-x |
                            fix x: Element {
                              @cases |
                                x = i or x = j or x = a or (x != i and x != j and x != a)
                                [using tautology]
                              @conclusion-at-x |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                case cases {
                                  @when-x-is-i |
                                    assume x = i {
                                      @x-is-i |
                                        x = i
                                        [by hypothesis when-x-is-i]
                                      @agree-at-i |
                                        apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                                        [using specialize squareAgreesAtI(i, j, a) i-not-j i-not-a j-not-a]
                                      @conclusion-when-x-is-i |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [by rewrite x-is-i agree-at-i]
                                    }
                                  @when-x-is-j |
                                    assume x = j {
                                      @x-is-j |
                                        x = j
                                        [by hypothesis when-x-is-j]
                                      @agree-at-j |
                                        apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                                        [using specialize squareAgreesAtJ(i, j, a) i-not-j i-not-a j-not-a]
                                      @conclusion-when-x-is-j |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [by rewrite x-is-j agree-at-j]
                                    }
                                  @when-x-is-a |
                                    assume x = a {
                                      @x-is-a |
                                        x = a
                                        [by hypothesis when-x-is-a]
                                      @agree-at-a |
                                        apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                                        [using specialize squareAgreesAtA(i, j, a) i-not-j i-not-a j-not-a]
                                      @conclusion-when-x-is-a |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [by rewrite x-is-a agree-at-a]
                                    }
                                  @when-x-is-elsewhere |
                                    assume x != i and x != j and x != a {
                                      @x-is-elsewhere |
                                        x != i and x != j and x != a
                                        [by hypothesis when-x-is-elsewhere]
                                      @x-not-i |
                                        x != i
                                        [using tautology x-is-elsewhere]
                                      @x-not-j |
                                        x != j
                                        [using tautology x-is-elsewhere]
                                      @x-not-a |
                                        x != a
                                        [using tautology x-is-elsewhere]
                                      @conclusion-when-x-is-elsewhere |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [using specialize squareAgreesAtElsewhere(i, j, a, x) x-not-i x-not-j x-not-a]
                                    }
                                }
                            }
                          @discharge-x |
                            forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                            [by forall_intro generalize-x]
                        }
                      @conclusion-j-not-a |
                        j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                    [by implies_intro given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                [by implies_intro given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
    [by forall_intro generalize-i]
qed

// Judson Lemma 2, identity (1): (i,a,j) = (i,j,a)^2.
theorem aThreeCycleIsTheSquareOfItsTwist: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @agree-everywhere |
                            forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                            [using specialize theSquareAgreesEverywhere(i, j, a) i-not-j i-not-a j-not-a]
                          @conclusion-equal |
                            compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                            [using specialize funcExtensionality(compose(transposition(i, j), transposition(i, a)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))) agree-everywhere]
                        }
                      @conclusion-j-not-a |
                        j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                    [by implies_intro given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                [by implies_intro given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a ->
      compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
    [by forall_intro generalize-i]
qed
