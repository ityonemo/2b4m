// The ALTERNATING GROUP A_n — the even permutations.
//
// Judson defines a permutation to be EVEN (ODD) when it is SOME product of an even (odd)
// number of transpositions. "Some" is the load-bearing word: a permutation has many
// factorizations, and that they all share a parity is the PARITY LEMMA, proved in
// std/permutation/parity.b4m (`identityIsEvenLengthForAnySequence`). This file layers the
// predicates on that lemma and shows the even permutations are a SUBGROUP — the three
// closure conditions, which is what makes A_n a group at all.
//
// A_n is stated as a MEMBERSHIP PREDICATE (`inAlternating`) over `Perm`, not as a sort of
// subgroups: there is no sort of subgroups, so a subgroup is the predicate its consumer
// carries (the pattern std/subgroup.b4m uses throughout).
import function <<< "std/function.b4m"
import function_invertible <<< "std/function/invertible.b4m"
import permutation <<< "std/permutation.b4m"
import permutation_sequence <<< "std/permutation/sequence.b4m"
import permutation_parity <<< "std/permutation/parity.b4m"
import peano <<< "std/peano.b4m"
import peano_divides <<< "std/peano/divides.b4m"
import peano_parity <<< "std/peano/parity.b4m"
import peano_order <<< "std/peano/order.b4m"
import peano_subtraction <<< "std/peano/subtraction.b4m"
import permutation_transpositions <<< "std/permutation/transpositions.b4m"

// -- the vocabulary ------------------------------------------------------------------------

sort Element = permutation.Element
sort Fn = permutation.Fn
sort Perm = permutation.Perm
sort Seq = permutation_sequence.Seq
sort Nat = peano.Nat

func compose = permutation.compose
func inverse = permutation.inverse
const identityFn = permutation.identityFn
func transposition = permutation.transposition
pred invertible = permutation.invertible

func apply = permutation.apply
axiom composeApply = function.composeApply
axiom funcExtensionality = function.funcExtensionality
theorem transpositionAtFirst = permutation.transpositionAtFirst
theorem transpositionAtSecond = permutation.transpositionAtSecond
theorem transpositionElsewhere = permutation.transpositionElsewhere
theorem transpositionIsAnInvolution = permutation.transpositionIsAnInvolution
theorem transpositionIsSymmetric = permutation_parity.transpositionIsSymmetric

func at = permutation_sequence.at
func productUpTo = permutation_sequence.productUpTo

const ZERO = peano.ZERO
func succ = peano.succ
const TWO = peano_parity.TWO
pred divides = peano_divides.divides
pred less_than = peano.less_than

theorem identityIsAPermutation = permutation.identityIsAPermutation
theorem transpositionIsAPermutation = permutation.transpositionIsAPermutation
theorem lessThanSuccSplit = peano_order.lessThanSuccSplit
func mul = peano.mul
axiom induction = peano.induction
theorem composeAssoc = function.composeAssoc
theorem lessThanSelf = peano_order.lessThanSelf
theorem lessThanSuccRight = peano_order.lessThanSuccRight
axiom productUpToSucc = permutation_sequence.productUpToSucc
theorem notLessThanZero = peano_order.notLessThanZero
theorem composeIsAPermutation = permutation.composeIsAPermutation
theorem inverseIsAPermutation = permutation.inverseIsAPermutation

// `isTransposition` / `allTranspositions` are parity.b4m's, under local names: a factorization
// is a Seq every one of whose first n entries is a transposition.
// std/permutation/transpositions.b4m already names this; use ITS spelling rather than
// declaring a twin (a second name for one notion makes the two invisible to each other).
define isTransposition(t) = permutation_transpositions.isATransposition(t)

pred allTranspositions(s: Seq, n: Nat)
axiom allTranspositionsDef: forall s: Seq; forall n: Nat;
  allTranspositions(s, n) iff (forall i: Nat; less_than(i, n) -> isTransposition(at(s, i)))

// -- even and odd --------------------------------------------------------------------------

// Judson's definition, verbatim: g is EVEN when SOME product of an even number of
// transpositions equals it. A real `pred` rather than a `define`, so it can be cited,
// model-mapped, and named where a symbol is required. (The long form, not a definition
// block: a clause whose body quantifies cannot settle its binders' sorts from use.)
pred isEvenPerm(g: Fn)
axiom isEvenPermDef: forall g: Fn;
  isEvenPerm(g) iff (exists s: Seq; exists m: Nat;
  allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m))

pred isOddPerm(g: Fn)
axiom isOddPermDef: forall g: Fn;
  isOddPerm(g) iff (exists s: Seq; exists m: Nat;
  allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, succ(m)))

// A_n's membership predicate: the even permutations.
pred inAlternating(g: Fn)
axiom inAlternatingDef: forall g: Fn;
  inAlternating(g) iff (invertible(g) and isEvenPerm(g))

// -- A_n is a subgroup: the three closure conditions ---------------------------------------

theorem productUpToZero = permutation_sequence.productUpToZero
theorem seqSingleton = permutation_sequence.seqSingleton
theorem dividesZero = peano_divides.dividesZero

// Below ZERO there is no index, so every entry is vacuously a transposition — the empty
// factorization's side condition.
theorem nothingBelowZeroIsATransposition: forall s: Seq;
  forall i: Nat; less_than(i, ZERO) -> isTransposition(at(s, i))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-i |
        fix i: Nat {
          @nothing-is-below-zero |
            not less_than(i, ZERO)
            [using specialize peano.notLessThanZero(i)]
          @vacuous |
            less_than(i, ZERO) -> isTransposition(at(s, i))
            [using tautology nothing-is-below-zero]
        }
      @discharge-i |
        forall i: Nat; less_than(i, ZERO) -> isTransposition(at(s, i))
        [by forall_intro generalize-i]
    }
  @conclusion |
    forall s: Seq; forall i: Nat; less_than(i, ZERO) -> isTransposition(at(s, i))
    [by forall_intro generalize-s]
qed

// (i) the IDENTITY is even: it is the EMPTY product of transpositions, and 0 is even.
theorem identityIsEven: isEvenPerm(identityFn)
proof
  @the-identity-is-a-permutation |
    invertible(identityFn)
    [by cite identityIsAPermutation]
  @some-sequence-exists |
    exists s: Seq; at(s, ZERO) = identityFn and productUpTo(s, succ(ZERO)) = identityFn
    [using specialize seqSingleton(identityFn) the-identity-is-a-permutation]
  @with-a-sequence |
    unpack s: Seq from some-sequence-exists {
      @empty-product |
        productUpTo(s, ZERO) = identityFn
        [using specialize productUpToZero(s)]
      @vacuously-transpositions |
        forall i: Nat; less_than(i, ZERO) -> isTransposition(at(s, i))
        [using specialize nothingBelowZeroIsATransposition(s)]
      @what-all-transpositions-means |
        allTranspositions(s, ZERO) iff (forall i: Nat; less_than(i, ZERO) -> isTransposition(at(s, i)))
        [using specialize allTranspositionsDef(s, ZERO)]
      @all-entries-are-transpositions |
        allTranspositions(s, ZERO)
        [using tautology what-all-transpositions-means vacuously-transpositions]
      @zero-is-even |
        divides(TWO, ZERO)
        [using specialize dividesZero(TWO)]
      @all-three |
        allTranspositions(s, ZERO) and productUpTo(s, ZERO) = identityFn and divides(TWO, ZERO)
        [using tautology all-entries-are-transpositions empty-product zero-is-even]
      @inner-witness |
        exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = identityFn and divides(TWO, m)
        [by exists_intro(ZERO) all-three]
      @a-factorization-exists |
        exists s2: Seq; exists m: Nat; allTranspositions(s2, m) and productUpTo(s2, m) = identityFn and divides(TWO, m)
        [by exists_intro(s) inner-witness]
      @what-even-means |
        isEvenPerm(identityFn) iff (exists s2: Seq; exists m: Nat; allTranspositions(s2, m) and productUpTo(s2, m) = identityFn and divides(TWO, m))
        [using specialize isEvenPermDef(identityFn)]
      @conclusion-the-identity-is-even |
        isEvenPerm(identityFn)
        [using tautology what-even-means a-factorization-exists]
    }
  @conclusion |
    isEvenPerm(identityFn)
    [by exists_elim with-a-sequence]
qed

// -- the reversed factorization ------------------------------------------------------------

func sub = peano.sub
func revProductUpTo = permutation_sequence.revProductUpTo
axiom seqReverse = permutation_sequence.seqReverse
theorem invOfProduct = permutation_sequence.invOfProduct

// The arithmetic Judson leaves silent when he writes "σ_m ⋯ σ_1": reversing an index keeps
// it in range — i < n implies n-(i+1) < n.
theorem reversedIndexInRange: forall n: Nat; forall i: Nat;
  less_than(i, n) -> less_than(sub(n, succ(i)), n)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-i |
        fix i: Nat {
          @given-i-below-n |
            assume less_than(i, n) {
              @i-below-n |
                less_than(i, n)
                [by hypothesis given-i-below-n]
              @zero-plus-successor |
                peano.add(ZERO, succ(i)) = succ(i)
                [using specialize peano.addZeroLeft(succ(i))]
              @successor-is-positive |
                less_than(ZERO, succ(i))
                [using specialize peano_order.lessThanIntro(ZERO, i, succ(i)) zero-plus-successor]
              @successor-below-successor |
                less_than(succ(i), succ(n))
                [using specialize peano_order.succPreservesOrder(i, n) i-below-n]
              @conclusion-in-range |
                less_than(sub(n, succ(i)), n)
                [using specialize peano_subtraction.subStrictlyDecreases(succ(i), n) successor-is-positive successor-below-successor]
            }
          @conclusion-implication |
            less_than(i, n) -> less_than(sub(n, succ(i)), n)
            [by implies_intro given-i-below-n]
        }
      @discharge-i |
        forall i: Nat; less_than(i, n) -> less_than(sub(n, succ(i)), n)
        [by forall_intro generalize-i]
    }
  @conclusion |
    forall n: Nat; forall i: Nat; less_than(i, n) -> less_than(sub(n, succ(i)), n)
    [by forall_intro generalize-n]
qed

// A REVERSED transposition sequence is still a transposition sequence, and its product is
// the inverse of the original's. (Judson: "the inverse of σ is σ_m ⋯ σ_1" — he can say it
// in one line because each σ_i is its own inverse.)
theorem reversedIsTranspositions: forall s: Seq; forall n: Nat;
  allTranspositions(s, n) ->
  exists r: Seq; allTranspositions(r, n) and productUpTo(r, n) = inverse(productUpTo(s, n))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-n |
        fix n: Nat {
          @given-all-transpositions |
            assume allTranspositions(s, n) {
              @the-reversal-exists |
                exists r: Seq;
                  (forall i: Nat; less_than(i, n) -> at(r, i) = at(s, sub(n, succ(i))))
                  and productUpTo(r, n) = revProductUpTo(s, n)
                [using specialize seqReverse(s, n)]
              @with-reversal-r |
                unpack r: Seq from the-reversal-exists {
                  @reversal-properties |
                    (forall i: Nat; less_than(i, n) -> at(r, i) = at(s, sub(n, succ(i))))
                      and productUpTo(r, n) = revProductUpTo(s, n)
                    [by hypothesis with-reversal-r]
                  @entries-are-s-entries |
                    forall i: Nat; less_than(i, n) -> at(r, i) = at(s, sub(n, succ(i)))
                    [by and_elim_left reversal-properties]
                  @product-is-the-reversed-product |
                    productUpTo(r, n) = revProductUpTo(s, n)
                    [by and_elim_right reversal-properties]
                  @reversed-product-is-the-inverse |
                    inverse(productUpTo(s, n)) = revProductUpTo(s, n)
                    [using specialize invOfProduct(s, n)]
                  @product-of-r-is-the-inverse |
                    productUpTo(r, n) = inverse(productUpTo(s, n))
                    [using chain product-is-the-reversed-product reversed-product-is-the-inverse]
                  @s-is-a-transposition-sequence |
                    allTranspositions(s, n)
                    [by hypothesis given-all-transpositions]
                  @what-s-being-transpositions-means |
                    allTranspositions(s, n) iff (forall i: Nat; less_than(i, n) -> isTransposition(at(s, i)))
                    [using specialize allTranspositionsDef(s, n)]
                  @s-entries-are-transpositions |
                    forall i: Nat; less_than(i, n) -> isTransposition(at(s, i))
                    [using tautology what-s-being-transpositions-means s-is-a-transposition-sequence]
                  @reversed-index-in-range |
                    forall i: Nat; less_than(i, n) -> less_than(sub(n, succ(i)), n)
                    [using specialize reversedIndexInRange(n)]
                  // per entry: fix i below n, rewrite r's entry to s's at the reversed
                  // index, and apply s's hypothesis THERE (which needs the index bound).
                  @generalize-entry |
                    fix i: Nat {
                      @given-i-below-n |
                        assume less_than(i, n) {
                          @i-below-n |
                            less_than(i, n)
                            [by hypothesis given-i-below-n]
                          @r-entry-is-an-s-entry |
                            at(r, i) = at(s, sub(n, succ(i)))
                            [using specialize entries-are-s-entries(i) i-below-n]
                          @reversed-index-below-n |
                            less_than(sub(n, succ(i)), n)
                            [using specialize reversed-index-in-range(i) i-below-n]
                          @s-entry-is-a-transposition |
                            isTransposition(at(s, sub(n, succ(i))))
                            [using specialize s-entries-are-transpositions(sub(n, succ(i))) reversed-index-below-n]
                          @conclusion-entry |
                            isTransposition(at(r, i))
                            [by rewrite r-entry-is-an-s-entry s-entry-is-a-transposition]
                        }
                      @conclusion-entry-implication |
                        less_than(i, n) -> isTransposition(at(r, i))
                        [by implies_intro given-i-below-n]
                    }
                  @every-entry-of-r-is-a-transposition |
                    forall i: Nat; less_than(i, n) -> isTransposition(at(r, i))
                    [by forall_intro generalize-entry]
                  @what-r-being-transpositions-means |
                    allTranspositions(r, n) iff (forall i: Nat; less_than(i, n) -> isTransposition(at(r, i)))
                    [using specialize allTranspositionsDef(r, n)]
                  @r-is-a-transposition-sequence |
                    allTranspositions(r, n)
                    [using tautology what-r-being-transpositions-means every-entry-of-r-is-a-transposition]
                  @r-is-a-transposition-sequence-with-the-inverse-product |
                    allTranspositions(r, n) and productUpTo(r, n) = inverse(productUpTo(s, n))
                    [by and_intro r-is-a-transposition-sequence product-of-r-is-the-inverse]
                  @conclusion-witness |
                    exists r2: Seq; allTranspositions(r2, n) and productUpTo(r2, n) = inverse(productUpTo(s, n))
                    [by exists_intro(r) r-is-a-transposition-sequence-with-the-inverse-product]
                }
              @conclusion-unpacked |
                exists r2: Seq; allTranspositions(r2, n) and productUpTo(r2, n) = inverse(productUpTo(s, n))
                [by exists_elim with-reversal-r]
            }
          @conclusion-implication |
            allTranspositions(s, n) ->
              exists r2: Seq; allTranspositions(r2, n) and productUpTo(r2, n) = inverse(productUpTo(s, n))
            [by implies_intro given-all-transpositions]
        }
      @discharge-n |
        forall n: Nat; allTranspositions(s, n) ->
          exists r2: Seq; allTranspositions(r2, n) and productUpTo(r2, n) = inverse(productUpTo(s, n))
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall s: Seq; forall n: Nat; allTranspositions(s, n) ->
      exists r2: Seq; allTranspositions(r2, n) and productUpTo(r2, n) = inverse(productUpTo(s, n))
    [by forall_intro generalize-s]
qed

// -- (ii) an even permutation's inverse is even --------------------------------------------

// Judson: "the inverse of any transposition is itself, so σ⁻¹ = σ_r ⋯ σ_1 is also in A_n" —
// the reversed sequence, same length, hence the same parity.
theorem inverseOfEvenIsEven: forall g: Fn; isEvenPerm(g) -> isEvenPerm(inverse(g))
proof
  @generalize-g |
    fix g: Fn {
      @given-even |
        assume isEvenPerm(g) {
          @g-is-even |
            isEvenPerm(g)
            [by hypothesis given-even]
          @what-even-means-for-g |
            isEvenPerm(g) iff (exists s: Seq; exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m))
            [using specialize isEvenPermDef(g)]
          @the-witness |
            exists s: Seq; exists m: Nat;
              allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
            [using tautology what-even-means-for-g g-is-even]
          @with-sequence |
            unpack s: Seq from the-witness {
              @inner |
                exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                [by hypothesis with-sequence]
              @with-length |
                unpack m: Nat from inner {
                  @facts |
                    allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                    [by hypothesis with-length]
                  @first-two |
                    allTranspositions(s, m) and productUpTo(s, m) = g
                    [by and_elim_left facts]
                  @transpositions |
                    allTranspositions(s, m)
                    [by and_elim_left first-two]
                  @product-is-g |
                    productUpTo(s, m) = g
                    [by and_elim_right first-two]
                  @m-is-even |
                    divides(TWO, m)
                    [by and_elim_right facts]
                  // the REVERSED sequence: same length m, still transpositions, product g⁻¹
                  @reversal-exists |
                    exists r: Seq; allTranspositions(r, m) and productUpTo(r, m) = inverse(productUpTo(s, m))
                    [using specialize reversedIsTranspositions(s, m) transpositions]
                  @with-reversal |
                    unpack r: Seq from reversal-exists {
                      @reversal-facts |
                        allTranspositions(r, m) and productUpTo(r, m) = inverse(productUpTo(s, m))
                        [by hypothesis with-reversal]
                      @r-transpositions |
                        allTranspositions(r, m)
                        [by and_elim_left reversal-facts]
                      @r-product |
                        productUpTo(r, m) = inverse(productUpTo(s, m))
                        [by and_elim_right reversal-facts]
                      @r-product-is-g-inverse |
                        productUpTo(r, m) = inverse(g)
                        [by rewrite product-is-g r-product]
                      @r-all-three |
                        allTranspositions(r, m) and productUpTo(r, m) = inverse(g) and divides(TWO, m)
                        [using tautology r-transpositions r-product-is-g-inverse m-is-even]
                      @inner-witness |
                        exists m2: Nat; allTranspositions(r, m2) and productUpTo(r, m2) = inverse(g) and divides(TWO, m2)
                        [by exists_intro(m) r-all-three]
                      @a-factorization-exists |
                        exists r2: Seq; exists m2: Nat; allTranspositions(r2, m2) and productUpTo(r2, m2) = inverse(g) and divides(TWO, m2)
                        [by exists_intro(r) inner-witness]
                      @what-even-means-for-the-inverse |
                        isEvenPerm(inverse(g)) iff (exists r2: Seq; exists m2: Nat; allTranspositions(r2, m2) and productUpTo(r2, m2) = inverse(g) and divides(TWO, m2))
                        [using specialize isEvenPermDef(inverse(g))]
                      @conclusion-witness |
                        isEvenPerm(inverse(g))
                        [using tautology what-even-means-for-the-inverse a-factorization-exists]
                    }
                  @conclusion-reversal |
                    isEvenPerm(inverse(g))
                    [by exists_elim with-reversal]
                }
              @conclusion-length |
                isEvenPerm(inverse(g))
                [by exists_elim with-length]
            }
          @conclusion-sequence |
            isEvenPerm(inverse(g))
            [by exists_elim with-sequence]
        }
      @conclusion-implication |
        isEvenPerm(g) -> isEvenPerm(inverse(g))
        [by implies_intro given-even]
    }
  @conclusion |
    forall g: Fn; isEvenPerm(g) -> isEvenPerm(inverse(g))
    [by forall_intro generalize-g]
qed

// -- (iii) the product of two even permutations is even ------------------------------------

func add = peano.add
theorem dividesAdd = peano_divides.dividesAdd
theorem concatenationPreservesTranspositions = permutation_transpositions.concatenationPreservesTranspositions
axiom seqConcat = permutation_sequence.seqConcat

// Judson's "since the product of two even permutations must also be an even permutation,
// A_n is closed": concatenate the two transposition sequences — the lengths ADD, and even
// plus even is even.
theorem productOfEvensIsEven: forall g: Fn; forall h: Fn;
  isEvenPerm(g) -> isEvenPerm(h) -> isEvenPerm(compose(g, h))
proof
  @generalize-g |
    fix g: Fn {
      @generalize-h |
        fix h: Fn {
          @given-g-even |
            assume isEvenPerm(g) {
              @given-h-even |
                assume isEvenPerm(h) {
                  @g-is-even |
                    isEvenPerm(g)
                    [by hypothesis given-g-even]
                  @h-is-even |
                    isEvenPerm(h)
                    [by hypothesis given-h-even]
                  @what-even-means-for-g |
                    isEvenPerm(g) iff (exists s: Seq; exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m))
                    [using specialize isEvenPermDef(g)]
                  @what-even-means-for-h |
                    isEvenPerm(h) iff (exists t: Seq; exists n: Nat; allTranspositions(t, n) and productUpTo(t, n) = h and divides(TWO, n))
                    [using specialize isEvenPermDef(h)]
                  @g-witness |
                    exists s: Seq; exists m: Nat;
                      allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                    [using tautology what-even-means-for-g g-is-even]
                  @h-witness |
                    exists t: Seq; exists n: Nat;
                      allTranspositions(t, n) and productUpTo(t, n) = h and divides(TWO, n)
                    [using tautology what-even-means-for-h h-is-even]
                  @with-g-seq |
                    unpack s: Seq from g-witness {
                      @g-inner |
                        exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                        [by hypothesis with-g-seq]
                      @with-g-len |
                        unpack m: Nat from g-inner {
                          @g-facts |
                            allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                            [by hypothesis with-g-len]
                          @g-pair |
                            allTranspositions(s, m) and productUpTo(s, m) = g
                            [by and_elim_left g-facts]
                          @g-transpositions |
                            allTranspositions(s, m)
                            [by and_elim_left g-pair]
                          @g-product |
                            productUpTo(s, m) = g
                            [by and_elim_right g-pair]
                          @g-even |
                            divides(TWO, m)
                            [by and_elim_right g-facts]
                          @with-h-seq |
                            unpack t: Seq from h-witness {
                              @h-inner |
                                exists n: Nat; allTranspositions(t, n) and productUpTo(t, n) = h and divides(TWO, n)
                                [by hypothesis with-h-seq]
                              @with-h-len |
                                unpack n: Nat from h-inner {
                                  @h-facts |
                                    allTranspositions(t, n) and productUpTo(t, n) = h and divides(TWO, n)
                                    [by hypothesis with-h-len]
                                  @h-pair |
                                    allTranspositions(t, n) and productUpTo(t, n) = h
                                    [by and_elim_left h-facts]
                                  @h-transpositions |
                                    allTranspositions(t, n)
                                    [by and_elim_left h-pair]
                                  @h-product |
                                    productUpTo(t, n) = h
                                    [by and_elim_right h-pair]
                                  @h-even |
                                    divides(TWO, n)
                                    [by and_elim_right h-facts]
                                  // std's concatenation lemma takes the UNFOLDED per-entry
                                  // forms, so unpack both `allTranspositions` here.
                                  @what-g-transpositions-means |
                                    allTranspositions(s, m) iff (forall i: Nat; less_than(i, m) -> isTransposition(at(s, i)))
                                    [using specialize allTranspositionsDef(s, m)]
                                  @g-entries |
                                    forall i: Nat; less_than(i, m) -> isTransposition(at(s, i))
                                    [using tautology what-g-transpositions-means g-transpositions]
                                  @what-h-transpositions-means |
                                    allTranspositions(t, n) iff (forall i: Nat; less_than(i, n) -> isTransposition(at(t, i)))
                                    [using specialize allTranspositionsDef(t, n)]
                                  @h-entries |
                                    forall i: Nat; less_than(i, n) -> isTransposition(at(t, i))
                                    [using tautology what-h-transpositions-means h-transpositions]
                                  // concatenate s (length m) with t (length n)
                                  @concat-exists |
                                    exists u: Seq;
                                      (forall i: Nat; less_than(i, m) -> at(u, i) = at(s, i))
                                      and (forall i: Nat; less_than(i, n) -> at(u, add(m, i)) = at(t, i))
                                      and productUpTo(u, add(m, n)) = compose(productUpTo(s, m), productUpTo(t, n))
                                    [using specialize seqConcat(s, t, m, n)]
                                  @with-concat |
                                    unpack u: Seq from concat-exists {
                                      @concat-facts |
                                        (forall i: Nat; less_than(i, m) -> at(u, i) = at(s, i))
                                          and (forall i: Nat; less_than(i, n) -> at(u, add(m, i)) = at(t, i))
                                          and productUpTo(u, add(m, n)) = compose(productUpTo(s, m), productUpTo(t, n))
                                        [by hypothesis with-concat]
                                      @agreement-pair |
                                        (forall i: Nat; less_than(i, m) -> at(u, i) = at(s, i))
                                          and (forall i: Nat; less_than(i, n) -> at(u, add(m, i)) = at(t, i))
                                        [by and_elim_left concat-facts]
                                      @agrees-with-s |
                                        forall i: Nat; less_than(i, m) -> at(u, i) = at(s, i)
                                        [by and_elim_left agreement-pair]
                                      @agrees-with-t |
                                        forall i: Nat; less_than(i, n) -> at(u, add(m, i)) = at(t, i)
                                        [by and_elim_right agreement-pair]
                                      @concat-product |
                                        productUpTo(u, add(m, n)) = compose(productUpTo(s, m), productUpTo(t, n))
                                        [by and_elim_right concat-facts]
                                      @u-entries |
                                        forall i: Nat; less_than(i, add(m, n)) -> isTransposition(at(u, i))
                                        [using specialize concatenationPreservesTranspositions(u, s, t, m, n) agrees-with-s agrees-with-t g-entries h-entries]
                                      @what-u-transpositions-means |
                                        allTranspositions(u, add(m, n)) iff (forall i: Nat; less_than(i, add(m, n)) -> isTransposition(at(u, i)))
                                        [using specialize allTranspositionsDef(u, add(m, n))]
                                      @u-transpositions |
                                        allTranspositions(u, add(m, n))
                                        [using tautology what-u-transpositions-means u-entries]
                                      @product-with-g |
                                        productUpTo(u, add(m, n)) = compose(g, productUpTo(t, n))
                                        [by rewrite g-product concat-product]
                                      @product-is-gh |
                                        productUpTo(u, add(m, n)) = compose(g, h)
                                        [by rewrite h-product product-with-g]
                                      @length-is-even |
                                        divides(TWO, add(m, n))
                                        [using specialize dividesAdd(TWO, m, n) g-even h-even]
                                      @u-all-three |
                                        allTranspositions(u, add(m, n)) and productUpTo(u, add(m, n)) = compose(g, h) and divides(TWO, add(m, n))
                                        [using tautology u-transpositions product-is-gh length-is-even]
                                      @inner-witness |
                                        exists k: Nat; allTranspositions(u, k) and productUpTo(u, k) = compose(g, h) and divides(TWO, k)
                                        [by exists_intro(add(m, n)) u-all-three]
                                      @a-factorization-exists |
                                        exists u2: Seq; exists k: Nat; allTranspositions(u2, k) and productUpTo(u2, k) = compose(g, h) and divides(TWO, k)
                                        [by exists_intro(u) inner-witness]
                                      @what-even-means-for-the-product |
                                        isEvenPerm(compose(g, h)) iff (exists u2: Seq; exists k: Nat; allTranspositions(u2, k) and productUpTo(u2, k) = compose(g, h) and divides(TWO, k))
                                        [using specialize isEvenPermDef(compose(g, h))]
                                      @conclusion-witness |
                                        isEvenPerm(compose(g, h))
                                        [using tautology what-even-means-for-the-product a-factorization-exists]
                                    }
                                  @conclusion-concat |
                                    isEvenPerm(compose(g, h))
                                    [by exists_elim with-concat]
                                }
                              @conclusion-h-len |
                                isEvenPerm(compose(g, h))
                                [by exists_elim with-h-len]
                            }
                          @conclusion-h-seq |
                            isEvenPerm(compose(g, h))
                            [by exists_elim with-h-seq]
                        }
                      @conclusion-g-len |
                        isEvenPerm(compose(g, h))
                        [by exists_elim with-g-len]
                    }
                  @conclusion-g-seq |
                    isEvenPerm(compose(g, h))
                    [by exists_elim with-g-seq]
                }
              @conclusion-h |
                isEvenPerm(h) -> isEvenPerm(compose(g, h))
                [by implies_intro given-h-even]
            }
          @conclusion-g |
            isEvenPerm(g) -> isEvenPerm(h) -> isEvenPerm(compose(g, h))
            [by implies_intro given-g-even]
        }
      @discharge-h |
        forall h: Fn; isEvenPerm(g) -> isEvenPerm(h) -> isEvenPerm(compose(g, h))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g: Fn; forall h: Fn; isEvenPerm(g) -> isEvenPerm(h) -> isEvenPerm(compose(g, h))
    [by forall_intro generalize-g]
qed

// -- A_n as a subgroup ---------------------------------------------------------------------

// The three closure conditions in `inAlternating` terms — the form a consumer wants when it
// plugs A_n in as a subgroup of the permutations.
theorem theIdentityIsInTheAlternatingGroup: inAlternating(identityFn)
proof
  @the-identity-is-a-permutation |
    invertible(identityFn)
    [by cite identityIsAPermutation]
  @the-identity-is-even |
    isEvenPerm(identityFn)
    [by cite identityIsEven]
  @both |
    invertible(identityFn) and isEvenPerm(identityFn)
    [by and_intro the-identity-is-a-permutation the-identity-is-even]
  @what-membership-means |
    inAlternating(identityFn) iff (invertible(identityFn) and isEvenPerm(identityFn))
    [using specialize inAlternatingDef(identityFn)]
  @conclusion |
    inAlternating(identityFn)
    [using tautology what-membership-means both]
qed

theorem theAlternatingGroupIsClosedUnderInverses: forall g: Fn;
  inAlternating(g) -> inAlternating(inverse(g))
proof
  @generalize-g |
    fix g: Fn {
      @given-in |
        assume inAlternating(g) {
          @g-is-in |
            inAlternating(g)
            [by hypothesis given-in]
          @what-membership-means-for-g |
            inAlternating(g) iff (invertible(g) and isEvenPerm(g))
            [using specialize inAlternatingDef(g)]
          @g-is-a-permutation |
            invertible(g)
            [using tautology what-membership-means-for-g g-is-in]
          @g-is-even |
            isEvenPerm(g)
            [using tautology what-membership-means-for-g g-is-in]
          @the-inverse-is-a-permutation |
            invertible(inverse(g))
            [using specialize inverseIsAPermutation(g) g-is-a-permutation]
          @the-inverse-is-even |
            isEvenPerm(inverse(g))
            [using specialize inverseOfEvenIsEven(g) g-is-even]
          @both |
            invertible(inverse(g)) and isEvenPerm(inverse(g))
            [by and_intro the-inverse-is-a-permutation the-inverse-is-even]
          @what-membership-means-for-the-inverse |
            inAlternating(inverse(g)) iff (invertible(inverse(g)) and isEvenPerm(inverse(g)))
            [using specialize inAlternatingDef(inverse(g))]
          @conclusion-in |
            inAlternating(inverse(g))
            [using tautology what-membership-means-for-the-inverse both]
        }
      @conclusion-implication |
        inAlternating(g) -> inAlternating(inverse(g))
        [by implies_intro given-in]
    }
  @conclusion |
    forall g: Fn; inAlternating(g) -> inAlternating(inverse(g))
    [by forall_intro generalize-g]
qed

theorem theAlternatingGroupIsClosedUnderComposition: forall g: Fn; forall h: Fn;
  inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
proof
  @generalize-g |
    fix g: Fn {
      @generalize-h |
        fix h: Fn {
          @given-g-in |
            assume inAlternating(g) {
              @given-h-in |
                assume inAlternating(h) {
                  @g-is-in |
                    inAlternating(g)
                    [by hypothesis given-g-in]
                  @h-is-in |
                    inAlternating(h)
                    [by hypothesis given-h-in]
                  @what-membership-means-for-g |
                    inAlternating(g) iff (invertible(g) and isEvenPerm(g))
                    [using specialize inAlternatingDef(g)]
                  @what-membership-means-for-h |
                    inAlternating(h) iff (invertible(h) and isEvenPerm(h))
                    [using specialize inAlternatingDef(h)]
                  @g-is-a-permutation |
                    invertible(g)
                    [using tautology what-membership-means-for-g g-is-in]
                  @g-is-even |
                    isEvenPerm(g)
                    [using tautology what-membership-means-for-g g-is-in]
                  @h-is-a-permutation |
                    invertible(h)
                    [using tautology what-membership-means-for-h h-is-in]
                  @h-is-even |
                    isEvenPerm(h)
                    [using tautology what-membership-means-for-h h-is-in]
                  @the-product-is-a-permutation |
                    invertible(compose(g, h))
                    [using specialize composeIsAPermutation(g, h) g-is-a-permutation h-is-a-permutation]
                  @the-product-is-even |
                    isEvenPerm(compose(g, h))
                    [using specialize productOfEvensIsEven(g, h) g-is-even h-is-even]
                  @both |
                    invertible(compose(g, h)) and isEvenPerm(compose(g, h))
                    [by and_intro the-product-is-a-permutation the-product-is-even]
                  @what-membership-means-for-the-product |
                    inAlternating(compose(g, h)) iff (invertible(compose(g, h)) and isEvenPerm(compose(g, h)))
                    [using specialize inAlternatingDef(compose(g, h))]
                  @conclusion-in |
                    inAlternating(compose(g, h))
                    [using tautology what-membership-means-for-the-product both]
                }
              @conclusion-h |
                inAlternating(h) -> inAlternating(compose(g, h))
                [by implies_intro given-h-in]
            }
          @conclusion-g |
            inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
            [by implies_intro given-g-in]
        }
      @discharge-h |
        forall h: Fn; inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g: Fn; forall h: Fn; inAlternating(g) -> inAlternating(h) -> inAlternating(compose(g, h))
    [by forall_intro generalize-g]
qed

// -- parity is well defined ----------------------------------------------------------------

theorem identityIsEvenLength = permutation_parity.identityIsEvenLengthForAnySequence
theorem inverseRight = function.inverseRight

// THE keystone of the even/odd theory: any two transposition factorizations of the SAME
// permutation have the same parity. Judson states it as "no permutation is both even and
// odd"; this is the form the proof needs. The argument: reverse s to factor sigma-inverse,
// concatenate with t, and the joined product is sigma * sigma-inverse = 1 — so the parity
// lemma applies to a product of length n+m, giving 2 | n+m; with 2 | m that yields 2 | n.
//
// `sigma` is a plain `Fn` with `invertible(sigma)` as a HYPOTHESIS (aata/5.1 fixes it in the
// guarded sort `Perm`, where the guard arrives via `[by predicate]`; in std this file keeps
// the unguarded carrier so the statement composes with the rest of the sequence theory).
theorem parityIsWellDefined: forall sigma: Fn; forall s: Seq; forall m: Nat; forall t: Seq; forall n: Nat;
  invertible(sigma) ->
  allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) ->
  allTranspositions(t, n) -> productUpTo(t, n) = sigma ->
  divides(TWO, n)
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-s |
        fix s: Seq {
          @generalize-m |
            fix m: Nat {
              @generalize-t |
                fix t: Seq {
                  @generalize-n |
                    fix n: Nat {
                      @given-sigma-invertible |
                        assume invertible(sigma) {
                          @given-s-transpositions |
                            assume allTranspositions(s, m) {
                              @given-s-product |
                                assume productUpTo(s, m) = sigma {
                                  @given-m-even |
                                    assume divides(TWO, m) {
                                      @given-t-transpositions |
                                        assume allTranspositions(t, n) {
                                          @given-t-product |
                                            assume productUpTo(t, n) = sigma {
                                              @s-transpositions |
                                                allTranspositions(s, m)
                                                [by hypothesis given-s-transpositions]
                                              @t-transpositions |
                                                allTranspositions(t, n)
                                                [by hypothesis given-t-transpositions]
                                              @s-product |
                                                productUpTo(s, m) = sigma
                                                [by hypothesis given-s-product]
                                              @t-product |
                                                productUpTo(t, n) = sigma
                                                [by hypothesis given-t-product]
                                              @m-even |
                                                divides(TWO, m)
                                                [by hypothesis given-m-even]
                                              // σ⁻¹ as a transposition product: reverse s.
                                              @reversal-exists |
                                                exists r: Seq; allTranspositions(r, m) and productUpTo(r, m) = inverse(productUpTo(s, m))
                                                [using specialize reversedIsTranspositions(s, m) s-transpositions]
                                              @with-reversal |
                                                unpack r: Seq from reversal-exists {
                                                  @reversal-facts |
                                                    allTranspositions(r, m) and productUpTo(r, m) = inverse(productUpTo(s, m))
                                                    [by hypothesis with-reversal]
                                                  @r-transpositions |
                                                    allTranspositions(r, m)
                                                    [by and_elim_left reversal-facts]
                                                  @r-product-is-inverse |
                                                    productUpTo(r, m) = inverse(productUpTo(s, m))
                                                    [by and_elim_right reversal-facts]
                                                  // 1 = τ₁⋯τ_n · σ_m⋯σ₁ : concatenate t with r.
                                                  @concat-exists |
                                                    exists u: Seq;
                                                      (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i))
                                                      and (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i))
                                                      and productUpTo(u, add(n, m)) = compose(productUpTo(t, n), productUpTo(r, m))
                                                    [using specialize seqConcat(t, r, n, m)]
                                                  @with-concat |
                                                    unpack u: Seq from concat-exists {
                                                      @concat-facts |
                                                        (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i))
                                                          and (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i))
                                                          and productUpTo(u, add(n, m)) = compose(productUpTo(t, n), productUpTo(r, m))
                                                        [by hypothesis with-concat]
                                                      // the conjunction nests LEFT: (A and B) and C
                                                      @u-agreement-pair |
                                                        (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i))
                                                          and (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i))
                                                        [by and_elim_left concat-facts]
                                                      @u-agrees-with-t |
                                                        forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)
                                                        [by and_elim_left u-agreement-pair]
                                                      @u-agrees-with-r |
                                                        forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)
                                                        [by and_elim_right u-agreement-pair]
                                                      @concat-product |
                                                        productUpTo(u, add(n, m)) = compose(productUpTo(t, n), productUpTo(r, m))
                                                        [by and_elim_right concat-facts]
                                                      // the joined product is σ·σ⁻¹ = 1.
                                                      @r-product-is-sigma-inverse |
                                                        productUpTo(r, m) = inverse(sigma)
                                                        [by rewrite s-product r-product-is-inverse]
                                                      @joined-is-sigma-times-its-inverse |
                                                        productUpTo(u, add(n, m)) = compose(sigma, inverse(sigma))
                                                        [using simplify concat-product t-product r-product-is-sigma-inverse]
                                                      @sigma-is-a-permutation |
                                                        invertible(sigma)
                                                        [by hypothesis given-sigma-invertible]
                                                      @sigma-times-inverse-is-identity |
                                                        compose(sigma, inverse(sigma)) = identityFn
                                                        [using specialize inverseRight(sigma) sigma-is-a-permutation]
                                                      @joined-is-identity |
                                                        productUpTo(u, add(n, m)) = identityFn
                                                        [using chain joined-is-sigma-times-its-inverse sigma-times-inverse-is-identity]
                                                      @what-t-transpositions-means |
                                                        allTranspositions(t, n) iff (forall i: Nat; less_than(i, n) -> isTransposition(at(t, i)))
                                                        [using specialize allTranspositionsDef(t, n)]
                                                      @t-entries |
                                                        forall i: Nat; less_than(i, n) -> isTransposition(at(t, i))
                                                        [using tautology what-t-transpositions-means t-transpositions]
                                                      @what-r-transpositions-means |
                                                        allTranspositions(r, m) iff (forall i: Nat; less_than(i, m) -> isTransposition(at(r, i)))
                                                        [using specialize allTranspositionsDef(r, m)]
                                                      @r-entries |
                                                        forall i: Nat; less_than(i, m) -> isTransposition(at(r, i))
                                                        [using tautology what-r-transpositions-means r-transpositions]
                                                      @joined-entries |
                                                        forall i: Nat; less_than(i, add(n, m)) -> isTransposition(at(u, i))
                                                        [using specialize concatenationPreservesTranspositions(u, t, r, n, m) u-agrees-with-t u-agrees-with-r t-entries r-entries]
                                                      @joined-length-is-even |
                                                        divides(TWO, add(n, m))
                                                        [using specialize identityIsEvenLength(u, add(n, m)) joined-entries joined-is-identity]
                                                      // 2 | (n+m) and 2 | m give 2 | (n+m)-m = n.
                                                      @total-minus-m-is-even |
                                                        divides(TWO, sub(add(n, m), m))
                                                        [using specialize peano_divides.dividesSub(TWO, add(n, m), m) joined-length-is-even m-even]
                                                      @total-minus-m-is-n |
                                                        sub(add(n, m), m) = n
                                                        [using specialize peano_subtraction.subAddCancel(n, m)]
                                                      @conclusion-n-even |
                                                        divides(TWO, n)
                                                        [by rewrite total-minus-m-is-n total-minus-m-is-even]
                                                    }
                                                  @conclusion-concat |
                                                    divides(TWO, n)
                                                    [by exists_elim with-concat]
                                                }
                                              @conclusion-reversal |
                                                divides(TWO, n)
                                                [by exists_elim with-reversal]
                                            }
                                          @conclusion-t-product |
                                            productUpTo(t, n) = sigma -> divides(TWO, n)
                                            [by implies_intro given-t-product]
                                        }
                                      @conclusion-t-transpositions |
                                        allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                                        [by implies_intro given-t-transpositions]
                                    }
                                  @conclusion-m-even |
                                    divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                                    [by implies_intro given-m-even]
                                }
                              @conclusion-s-product |
                                productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                                [by implies_intro given-s-product]
                            }
                          @conclusion-s-transpositions |
                            allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                            [by implies_intro given-s-transpositions]
                        }
                      @conclusion-sigma-invertible |
                        invertible(sigma) -> allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                        [by implies_intro given-sigma-invertible]
                    }
                  @discharge-n |
                    forall n: Nat; invertible(sigma) -> allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                    [by forall_intro generalize-n]
                }
              @discharge-t |
                forall t: Seq; forall n: Nat; invertible(sigma) -> allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
                [by forall_intro generalize-t]
            }
          @discharge-m |
            forall m: Nat; forall t: Seq; forall n: Nat; invertible(sigma) -> allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
            [by forall_intro generalize-m]
        }
      @discharge-s |
        forall s: Seq; forall m: Nat; forall t: Seq; forall n: Nat; invertible(sigma) -> allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) -> allTranspositions(t, n) -> productUpTo(t, n) = sigma -> divides(TWO, n)
        [by forall_intro generalize-s]
    }
  @conclusion |
    forall sigma: Fn; forall s: Seq; forall m: Nat; forall t: Seq; forall n: Nat;
      invertible(sigma) ->
      allTranspositions(s, m) -> productUpTo(s, m) = sigma -> divides(TWO, m) ->
      allTranspositions(t, n) -> productUpTo(t, n) = sigma ->
      divides(TWO, n)
    [by forall_intro generalize-sigma]
qed

// -- no permutation is both even and odd ---------------------------------------------------

theorem productUpToIsAPermutation = permutation_sequence.productUpToIsAPermutation
theorem twoDividesNoTwoConsecutive = peano_parity.twoDividesNoTwoConsecutive

// Judson's "no permutation is both even and odd" — immediate from `parityIsWellDefined`
// (both factorizations have the same parity) and the fact that m and m+1 are never both
// even. This is what makes EVEN and ODD a genuine dichotomy, so A_n is a proper subgroup.
theorem evenIsNotOdd: forall t: Fn; isEvenPerm(t) -> (not isOddPerm(t))
proof
  @generalize-t |
    fix t: Fn {
      @given-even |
        assume isEvenPerm(t) {
          @even |
            isEvenPerm(t)
            [by hypothesis given-even]
          @what-even-means |
            isEvenPerm(t) iff (exists s: Seq; exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = t and divides(TWO, m))
            [using specialize isEvenPermDef(t)]
          @even-witness |
            exists s: Seq; exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = t and divides(TWO, m)
            [using tautology what-even-means even]
          @suppose-odd |
            assume isOddPerm(t) {
              @odd |
                isOddPerm(t)
                [by hypothesis suppose-odd]
              @what-odd-means |
                isOddPerm(t) iff (exists s3: Seq; exists m3: Nat; allTranspositions(s3, m3) and productUpTo(s3, m3) = t and divides(TWO, succ(m3)))
                [using specialize isOddPermDef(t)]
              @odd-witness |
                exists s3: Seq; exists m3: Nat; allTranspositions(s3, m3) and productUpTo(s3, m3) = t and divides(TWO, succ(m3))
                [using tautology what-odd-means odd]
              @with-even-sequence-s |
                unpack s: Seq from even-witness {
                  @after-s |
                    exists m: Nat; allTranspositions(s, m) and productUpTo(s, m) = t and divides(TWO, m)
                    [by hypothesis with-even-sequence-s]
                  @with-even-length-m |
                    unpack m: Nat from after-s {
                      @even-facts |
                        allTranspositions(s, m) and productUpTo(s, m) = t and divides(TWO, m)
                        [by hypothesis with-even-length-m]
                      @even-transpositions |
                        allTranspositions(s, m)
                        [using tautology even-facts]
                      @even-product |
                        productUpTo(s, m) = t
                        [using tautology even-facts]
                      @m-even |
                        divides(TWO, m)
                        [using tautology even-facts]
                      @product-invertible |
                        invertible(productUpTo(s, m))
                        [using specialize productUpToIsAPermutation(s, m)]
                      @t-invertible |
                        invertible(t)
                        [by rewrite even-product product-invertible]
                      @with-odd-sequence-s2 |
                        unpack s2: Seq from odd-witness {
                          @after-s2 |
                            exists m2: Nat; allTranspositions(s2, m2) and productUpTo(s2, m2) = t and divides(TWO, succ(m2))
                            [by hypothesis with-odd-sequence-s2]
                          @with-odd-length-m2 |
                            unpack m2: Nat from after-s2 {
                              @odd-facts |
                                allTranspositions(s2, m2) and productUpTo(s2, m2) = t and divides(TWO, succ(m2))
                                [by hypothesis with-odd-length-m2]
                              @odd-transpositions |
                                allTranspositions(s2, m2)
                                [using tautology odd-facts]
                              @odd-product |
                                productUpTo(s2, m2) = t
                                [using tautology odd-facts]
                              @succ-m2-even |
                                divides(TWO, succ(m2))
                                [using tautology odd-facts]
                              @m2-even |
                                divides(TWO, m2)
                                [using specialize parityIsWellDefined(t, s, m, s2, m2) t-invertible even-transpositions even-product m-even odd-transpositions odd-product]
                              @succ-m2-not-even |
                                not divides(TWO, succ(m2))
                                [using specialize twoDividesNoTwoConsecutive(m2) m2-even]
                              @conclusion-clash |
                                not isEvenPerm(t)
                                [by absurd succ-m2-even succ-m2-not-even]
                            }
                          @conclusion-with-m2 |
                            not isEvenPerm(t)
                            [by exists_elim with-odd-length-m2]
                        }
                      @conclusion-with-s2 |
                        not isEvenPerm(t)
                        [by exists_elim with-odd-sequence-s2]
                    }
                  @conclusion-with-m |
                    not isEvenPerm(t)
                    [by exists_elim with-even-length-m]
                }
              @not-even |
                not isEvenPerm(t)
                [by exists_elim with-even-sequence-s]
            }
          @conclusion-not-odd |
            not isOddPerm(t)
            [by not_intro suppose-odd even not-even]
        }
      @conclusion-at-t |
        isEvenPerm(t) -> (not isOddPerm(t))
        [by implies_intro given-even]
    }
  @conclusion |
    forall t: Fn; isEvenPerm(t) -> (not isOddPerm(t))
    [by forall_intro generalize-t]
qed

// -- Judson Lemma 1: A_n is generated by 3-cycles --------------------------------------
//
// "To show that the 3-cycles generate A_n, we need only show that any pair of
// transpositions can be written as the product of 3-cycles. Since (a,b) = (b,a), every
// pair of transpositions must be one of the following:"
//
//     (a,b)(a,b) = identity        -- std's `transpositionIsAnInvolution`
//     (a,b)(c,d) = (a,c,b)(a,c,d)  -- `aPairOfDisjointTranspositionsIsAProductOfThreeCycles`
//     (a,b)(a,c) = (a,c,b)         -- DEFINITIONAL, see below
//
// A 3-cycle needs no new sort. std's cycle fold (`cycleSucc`) makes
// `cycle(s, 3) = (a0 a2) o (a0 a1) o ((a0 a0) o id)`, so a 3-cycle IS a composite of two
// transpositions sharing their first point — which is why the third identity is a reading
// of the definition rather than a theorem, and why the second carries the content.
//   (a,c,b) = (a,b)o(a,c)   and   (a,c,d) = (a,d)o(a,c)
// so the RHS is [(a,b)o(a,c)] o [(a,d)o(a,c)].

// -- the two sides' values at a point ------------------------------------------------------

//        (a,c): a->c ; (a,d) fixes c (c!=a, c!=d) ; (a,c): c->a ; (a,b): a->b.  = b

// `tautology` sees `a != c` and `c != a` as UNRELATED atoms, so symmetry of disequality
// is a real step. Needed in every case below, hence its own lemma.
theorem disequalityIsSymmetric: forall u, v: Element; u != v -> v != u
proof
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @given-u-not-v |
            assume u != v {
              @u-not-v |
                u != v
                [by hypothesis given-u-not-v]
              @suppose-v-equals-u |
                assume v = u {
                  @v-is-u |
                    v = u
                    [by hypothesis suppose-v-equals-u]
                  @u-is-v |
                    u = v
                    [by symmetry v-is-u]
                }
              @conclusion-v-not-u |
                v != u
                [by not_intro suppose-v-equals-u u-is-v u-not-v]
            }
          @conclusion-implication |
            u != v -> v != u
            [by implies_intro given-u-not-v]
        }
      @discharge-v |
        forall v: Element; u != v -> v != u
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall u, v: Element; u != v -> v != u
    [by forall_intro generalize-u]
qed

theorem bothSidesAgreeAtA: forall a, b, c, d: Element;
  a != c -> a != d -> c != d ->
  apply(compose(transposition(a, b), transposition(c, d)), a) =
  apply(compose(compose(transposition(a, b), transposition(a, c)),
  compose(transposition(a, d), transposition(a, c))), a)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-c |
                    assume a != c {
                      @given-a-d |
                        assume a != d {
                          @given-c-d |
                            assume c != d {
                              @a-not-c |
                                a != c
                                [by hypothesis given-a-c]
                              @a-not-d |
                                a != d
                                [by hypothesis given-a-d]
                              @c-not-d |
                                c != d
                                [by hypothesis given-c-d]
                              // LHS = b
                              @lhs-split |
                                apply(compose(transposition(a, b), transposition(c, d)), a) = apply(transposition(a, b), apply(transposition(c, d), a))
                                [using specialize composeApply(transposition(a, b), transposition(c, d), a)]
                              @inner-fixes-a |
                                apply(transposition(c, d), a) = a
                                [using specialize transpositionElsewhere(c, d, a) a-not-c a-not-d]
                              @ab-sends-a |
                                apply(transposition(a, b), a) = b
                                [using specialize transpositionAtFirst(a, b)]
                              @lhs-is-b |
                                apply(compose(transposition(a, b), transposition(c, d)), a) = b
                                [using chain lhs-split inner-fixes-a ab-sends-a]
                              // RHS = b, innermost first
                              @rhs-split |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a) =
                                  apply(transposition(a, b), apply(transposition(a, c), apply(transposition(a, d), apply(transposition(a, c), a))))
                                [using simplify composeApply]
                              @ac-sends-a |
                                apply(transposition(a, c), a) = c
                                [using specialize transpositionAtFirst(a, c)]
                              @c-not-a |
                                c != a
                                [using specialize disequalityIsSymmetric(a, c) a-not-c]
                              @ad-fixes-c |
                                apply(transposition(a, d), c) = c
                                [using specialize transpositionElsewhere(a, d, c) c-not-a c-not-d]
                              @ac-sends-c |
                                apply(transposition(a, c), c) = a
                                [using specialize transpositionAtSecond(a, c)]
                              @rhs-is-b |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a) = b
                                [using chain rhs-split ac-sends-a ad-fixes-c ac-sends-c ab-sends-a]
                              @conclusion-agree |
                                apply(compose(transposition(a, b), transposition(c, d)), a) =
                                  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                                [using chain lhs-is-b rhs-is-b]
                            }
                          @conclusion-c-d |
                            c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                            [by implies_intro given-c-d]
                        }
                      @conclusion-a-d |
                        a != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                        [by implies_intro given-a-d]
                    }
                  @conclusion-a-c |
                    a != c -> a != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                    [by implies_intro given-a-c]
                }
              @discharge-d |
                forall d: Element; a != c -> a != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != c -> a != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != c -> a != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != c -> a != d -> c != d ->
      apply(compose(transposition(a, b), transposition(c, d)), a) =
      apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
    [by forall_intro generalize-a]
qed

// -- identity (2)'s remaining four point-cases ---------------------------------------------
// Each is the same shape as `bothSidesAgreeAtA`: expand both sides to nested `apply`s
// (`twoFactorValue` / `fourFactorValue`), evaluate factor by factor with the three
// transposition point lemmas, and `chain` the two values together.

// at b: LHS (c,d) fixes b, then (a,b): b -> a.  RHS: all three (a,·) fix b, then (a,b): b -> a.
theorem bothSidesAgreeAtB: forall a, b, c, d: Element;
  a != b -> b != c -> b != d ->
  apply(compose(transposition(a, b), transposition(c, d)), b) =
  apply(compose(compose(transposition(a, b), transposition(a, c)),
  compose(transposition(a, d), transposition(a, c))), b)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-b |
                    assume a != b {
                      @given-b-c |
                        assume b != c {
                          @given-b-d |
                            assume b != d {
                              @a-not-b |
                                a != b
                                [by hypothesis given-a-b]
                              @b-not-c |
                                b != c
                                [by hypothesis given-b-c]
                              @b-not-d |
                                b != d
                                [by hypothesis given-b-d]
                              @b-not-a |
                                b != a
                                [using specialize disequalityIsSymmetric(a, b) a-not-b]
                              @ab-sends-b |
                                apply(transposition(a, b), b) = a
                                [using specialize transpositionAtSecond(a, b)]
                              @ac-fixes-b |
                                apply(transposition(a, c), b) = b
                                [using specialize transpositionElsewhere(a, c, b) b-not-a b-not-c]
                              @ad-fixes-b |
                                apply(transposition(a, d), b) = b
                                [using specialize transpositionElsewhere(a, d, b) b-not-a b-not-d]
                              @cd-fixes-b |
                                apply(transposition(c, d), b) = b
                                [using specialize transpositionElsewhere(c, d, b) b-not-c b-not-d]
                              @lhs-split |
                                apply(compose(transposition(a, b), transposition(c, d)), b) = apply(transposition(a, b), apply(transposition(c, d), b))
                                [using simplify composeApply]
                              @lhs-is-a |
                                apply(compose(transposition(a, b), transposition(c, d)), b) = a
                                [using chain lhs-split cd-fixes-b ab-sends-b]
                              @rhs-split |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b) =
                                  apply(transposition(a, b), apply(transposition(a, c), apply(transposition(a, d), apply(transposition(a, c), b))))
                                [using simplify composeApply]
                              @rhs-is-a |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b) = a
                                [using chain rhs-split ac-fixes-b ad-fixes-b ab-sends-b]
                              @conclusion-agree |
                                apply(compose(transposition(a, b), transposition(c, d)), b) =
                                  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                                [using chain lhs-is-a rhs-is-a]
                            }
                          @conclusion-b-d |
                            b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                            [by implies_intro given-b-d]
                        }
                      @conclusion-b-c |
                        b != c -> b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                        [by implies_intro given-b-c]
                    }
                  @conclusion-a-b |
                    a != b -> b != c -> b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                    [by implies_intro given-a-b]
                }
              @discharge-d |
                forall d: Element; a != b -> b != c -> b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != b -> b != c -> b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != b -> b != c -> b != d -> apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != b -> b != c -> b != d ->
      apply(compose(transposition(a, b), transposition(c, d)), b) =
      apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
    [by forall_intro generalize-a]
qed

// at c: LHS (c,d): c->d then (a,b) fixes d.
//       RHS (a,c): c->a; (a,d): a->d; (a,c) fixes d; (a,b) fixes d.
theorem bothSidesAgreeAtC: forall a, b, c, d: Element;
  a != d -> b != d -> c != d ->
  apply(compose(transposition(a, b), transposition(c, d)), c) =
  apply(compose(compose(transposition(a, b), transposition(a, c)),
  compose(transposition(a, d), transposition(a, c))), c)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-d |
                    assume a != d {
                      @given-b-d |
                        assume b != d {
                          @given-c-d |
                            assume c != d {
                              @a-not-d |
                                a != d
                                [by hypothesis given-a-d]
                              @b-not-d |
                                b != d
                                [by hypothesis given-b-d]
                              @c-not-d |
                                c != d
                                [by hypothesis given-c-d]
                              @d-not-a |
                                d != a
                                [using specialize disequalityIsSymmetric(a, d) a-not-d]
                              @d-not-b |
                                d != b
                                [using specialize disequalityIsSymmetric(b, d) b-not-d]
                              @d-not-c |
                                d != c
                                [using specialize disequalityIsSymmetric(c, d) c-not-d]
                              @cd-sends-c |
                                apply(transposition(c, d), c) = d
                                [using specialize transpositionAtFirst(c, d)]
                              @ab-fixes-d |
                                apply(transposition(a, b), d) = d
                                [using specialize transpositionElsewhere(a, b, d) d-not-a d-not-b]
                              @ac-sends-c |
                                apply(transposition(a, c), c) = a
                                [using specialize transpositionAtSecond(a, c)]
                              @ad-sends-a |
                                apply(transposition(a, d), a) = d
                                [using specialize transpositionAtFirst(a, d)]
                              @ac-fixes-d |
                                apply(transposition(a, c), d) = d
                                [using specialize transpositionElsewhere(a, c, d) d-not-a d-not-c]
                              @lhs-split |
                                apply(compose(transposition(a, b), transposition(c, d)), c) = apply(transposition(a, b), apply(transposition(c, d), c))
                                [using simplify composeApply]
                              @lhs-value |
                                apply(compose(transposition(a, b), transposition(c, d)), c) = d
                                [using chain lhs-split cd-sends-c ab-fixes-d]
                              @rhs-split |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c) =
                                  apply(transposition(a, b), apply(transposition(a, c), apply(transposition(a, d), apply(transposition(a, c), c))))
                                [using simplify composeApply]
                              @rhs-value |
                                apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c) = d
                                [using chain rhs-split ac-sends-c ad-sends-a ac-fixes-d ab-fixes-d]
                              @conclusion-agree |
                                apply(compose(transposition(a, b), transposition(c, d)), c) =
                                  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-c-d |
                            c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                            [by implies_intro given-c-d]
                        }
                      @conclusion-b-d |
                        b != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                        [by implies_intro given-b-d]
                    }
                  @conclusion-a-d |
                    a != d -> b != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                    [by implies_intro given-a-d]
                }
              @discharge-d |
                forall d: Element; a != d -> b != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != d -> b != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != d -> b != d -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != d -> b != d -> c != d ->
      apply(compose(transposition(a, b), transposition(c, d)), c) =
      apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
    [by forall_intro generalize-a]
qed

theorem bothSidesAgreeAtD: forall a, b, c, d: Element;
  a != c -> a != d -> b != c -> c != d ->
  apply(compose(transposition(a, b), transposition(c, d)), d) =
  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-not-c |
                    assume a != c {
                      @given-a-not-d |
                        assume a != d {
                          @given-b-not-c |
                            assume b != c {
                              @given-c-not-d |
                                assume c != d {
                                  @a-not-c |
                                    a != c
                                    [by hypothesis given-a-not-c]
                                  @a-not-d |
                                    a != d
                                    [by hypothesis given-a-not-d]
                                  @b-not-c |
                                    b != c
                                    [by hypothesis given-b-not-c]
                                  @c-not-d |
                                    c != d
                                    [by hypothesis given-c-not-d]
                                  @c-not-a |
                                    c != a
                                    [using specialize disequalityIsSymmetric(a, c) a-not-c]
                                  @d-not-a |
                                    d != a
                                    [using specialize disequalityIsSymmetric(a, d) a-not-d]
                                  @c-not-b |
                                    c != b
                                    [using specialize disequalityIsSymmetric(b, c) b-not-c]
                                  @d-not-c |
                                    d != c
                                    [using specialize disequalityIsSymmetric(c, d) c-not-d]
                                  @cd-sends-d |
                                    apply(transposition(c, d), d) = c
                                    [using specialize transpositionAtSecond(c, d)]
                                  @ab-fixes-c |
                                    apply(transposition(a, b), c) = c
                                    [using specialize transpositionElsewhere(a, b, c) c-not-a c-not-b]
                                  @ac-fixes-d |
                                    apply(transposition(a, c), d) = d
                                    [using specialize transpositionElsewhere(a, c, d) d-not-a d-not-c]
                                  @ad-sends-d |
                                    apply(transposition(a, d), d) = a
                                    [using specialize transpositionAtSecond(a, d)]
                                  @ac-sends-a |
                                    apply(transposition(a, c), a) = c
                                    [using specialize transpositionAtFirst(a, c)]
                                  @lhs-split |
                                    apply(compose(transposition(a, b), transposition(c, d)), d) = apply(transposition(a, b), apply(transposition(c, d), d))
                                    [using simplify composeApply]
                                  @lhs-value |
                                    apply(compose(transposition(a, b), transposition(c, d)), d) = c
                                    [using chain lhs-split cd-sends-d ab-fixes-c]
                                  @rhs-split |
                                    apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d) =
                                      apply(transposition(a, b), apply(transposition(a, c), apply(transposition(a, d), apply(transposition(a, c), d))))
                                    [using simplify composeApply]
                                  @rhs-value |
                                    apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d) = c
                                    [using chain rhs-split ac-fixes-d ad-sends-d ac-sends-a ab-fixes-c]
                                  @conclusion-agree |
                                    apply(compose(transposition(a, b), transposition(c, d)), d) =
                                      apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                                    [using chain lhs-value rhs-value]
                                }
                              @conclusion-c-not-d |
                                c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                                [by implies_intro given-c-not-d]
                            }
                          @conclusion-b-not-c |
                            b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                            [by implies_intro given-b-not-c]
                        }
                      @conclusion-a-not-d |
                        a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                        [by implies_intro given-a-not-d]
                    }
                  @conclusion-a-not-c |
                    a != c -> a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                    [by implies_intro given-a-not-c]
                }
              @discharge-d |
                forall d: Element; a != c -> a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != c -> a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != c -> a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != c -> a != d -> b != c -> c != d -> apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
    [by forall_intro generalize-a]
qed

// elsewhere: x is none of a,b,c,d, so every factor fixes it.
theorem bothSidesAgreeAtElsewhere: forall a, b, c, d, x: Element;
  x != a -> x != b -> x != c -> x != d ->
  apply(compose(transposition(a, b), transposition(c, d)), x) =
  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @generalize-x |
                    fix x: Element {
                      @given-x-not-a |
                        assume x != a {
                          @given-x-not-b |
                            assume x != b {
                              @given-x-not-c |
                                assume x != c {
                                  @given-x-not-d |
                                    assume x != d {
                                      @x-not-a |
                                        x != a
                                        [by hypothesis given-x-not-a]
                                      @x-not-b |
                                        x != b
                                        [by hypothesis given-x-not-b]
                                      @x-not-c |
                                        x != c
                                        [by hypothesis given-x-not-c]
                                      @x-not-d |
                                        x != d
                                        [by hypothesis given-x-not-d]
                                      @cd-fixes-x |
                                        apply(transposition(c, d), x) = x
                                        [using specialize transpositionElsewhere(c, d, x) x-not-c x-not-d]
                                      @ab-fixes-x |
                                        apply(transposition(a, b), x) = x
                                        [using specialize transpositionElsewhere(a, b, x) x-not-a x-not-b]
                                      @ac-fixes-x |
                                        apply(transposition(a, c), x) = x
                                        [using specialize transpositionElsewhere(a, c, x) x-not-a x-not-c]
                                      @ad-fixes-x |
                                        apply(transposition(a, d), x) = x
                                        [using specialize transpositionElsewhere(a, d, x) x-not-a x-not-d]
                                      @lhs-split |
                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(transposition(a, b), apply(transposition(c, d), x))
                                        [using simplify composeApply]
                                      @lhs-value |
                                        apply(compose(transposition(a, b), transposition(c, d)), x) = x
                                        [using chain lhs-split cd-fixes-x ab-fixes-x]
                                      @rhs-split |
                                        apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x) =
                                          apply(transposition(a, b), apply(transposition(a, c), apply(transposition(a, d), apply(transposition(a, c), x))))
                                        [using simplify composeApply]
                                      @rhs-value |
                                        apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x) = x
                                        [using chain rhs-split ac-fixes-x ad-fixes-x ab-fixes-x]
                                      @conclusion-agree |
                                        apply(compose(transposition(a, b), transposition(c, d)), x) =
                                          apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                        [using chain lhs-value rhs-value]
                                    }
                                  @conclusion-x-not-d |
                                    x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                    [by implies_intro given-x-not-d]
                                }
                              @conclusion-x-not-c |
                                x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                [by implies_intro given-x-not-c]
                            }
                          @conclusion-x-not-b |
                            x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                            [by implies_intro given-x-not-b]
                        }
                      @conclusion-x-not-a |
                        x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                        [by implies_intro given-x-not-a]
                    }
                  @discharge-x |
                    forall x: Element; x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                    [by forall_intro generalize-x]
                }
              @discharge-d |
                forall d, x: Element; x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d, x: Element; x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d, x: Element; x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d, x: Element; x != a -> x != b -> x != c -> x != d -> apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
    [by forall_intro generalize-a]
qed

// The pointwise agreement behind identity (2): five cases on where x sits.
theorem agreeAtEveryPoint: forall a, b, c, d: Element;
  a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
  forall x: Element;
  apply(compose(transposition(a, b), transposition(c, d)), x) =
  apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-not-b |
                    assume a != b {
                      @given-a-not-c |
                        assume a != c {
                          @given-a-not-d |
                            assume a != d {
                              @given-b-not-c |
                                assume b != c {
                                  @given-b-not-d |
                                    assume b != d {
                                      @given-c-not-d |
                                        assume c != d {
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-not-b]
                                          @a-not-c |
                                            a != c
                                            [by hypothesis given-a-not-c]
                                          @a-not-d |
                                            a != d
                                            [by hypothesis given-a-not-d]
                                          @b-not-c |
                                            b != c
                                            [by hypothesis given-b-not-c]
                                          @b-not-d |
                                            b != d
                                            [by hypothesis given-b-not-d]
                                          @c-not-d |
                                            c != d
                                            [by hypothesis given-c-not-d]
                                          @generalize-x |
                                            fix x: Element {
                                              @cases |
                                                x = a or x = b or x = c or x = d or (x != a and x != b and x != c and x != d)
                                                [using tautology]
                                              @conclusion-at-x |
                                                apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                case cases {
                                                  @when-x-is-a |
                                                    assume x = a {
                                                      @x-is-a |
                                                        x = a
                                                        [by hypothesis when-x-is-a]
                                                      @agree-at-a |
                                                        apply(compose(transposition(a, b), transposition(c, d)), a) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), a)
                                                        [using specialize bothSidesAgreeAtA(a, b, c, d) a-not-c a-not-d c-not-d]
                                                      @conclusion-when-x-is-a |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                        [by rewrite x-is-a agree-at-a]
                                                    }
                                                  @when-x-is-b |
                                                    assume x = b {
                                                      @x-is-b |
                                                        x = b
                                                        [by hypothesis when-x-is-b]
                                                      @agree-at-b |
                                                        apply(compose(transposition(a, b), transposition(c, d)), b) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), b)
                                                        [using specialize bothSidesAgreeAtB(a, b, c, d) a-not-b b-not-c b-not-d]
                                                      @conclusion-when-x-is-b |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                        [by rewrite x-is-b agree-at-b]
                                                    }
                                                  @when-x-is-c |
                                                    assume x = c {
                                                      @x-is-c |
                                                        x = c
                                                        [by hypothesis when-x-is-c]
                                                      @agree-at-c |
                                                        apply(compose(transposition(a, b), transposition(c, d)), c) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), c)
                                                        [using specialize bothSidesAgreeAtC(a, b, c, d) a-not-d b-not-d c-not-d]
                                                      @conclusion-when-x-is-c |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                        [by rewrite x-is-c agree-at-c]
                                                    }
                                                  @when-x-is-d |
                                                    assume x = d {
                                                      @x-is-d |
                                                        x = d
                                                        [by hypothesis when-x-is-d]
                                                      @agree-at-d |
                                                        apply(compose(transposition(a, b), transposition(c, d)), d) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), d)
                                                        [using specialize bothSidesAgreeAtD(a, b, c, d) a-not-c a-not-d b-not-c c-not-d]
                                                      @conclusion-when-x-is-d |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                        [by rewrite x-is-d agree-at-d]
                                                    }
                                                  @when-x-is-elsewhere |
                                                    assume x != a and x != b and x != c and x != d {
                                                      @x-is-elsewhere |
                                                        x != a and x != b and x != c and x != d
                                                        [by hypothesis when-x-is-elsewhere]
                                                      @x-not-a |
                                                        x != a
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-b |
                                                        x != b
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-c |
                                                        x != c
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-d |
                                                        x != d
                                                        [using tautology x-is-elsewhere]
                                                      @conclusion-when-x-is-elsewhere |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                                        [using specialize bothSidesAgreeAtElsewhere(a, b, c, d, x) x-not-a x-not-b x-not-c x-not-d]
                                                    }
                                                }
                                            }
                                          @discharge-x |
                                            forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                            [by forall_intro generalize-x]
                                        }
                                      @conclusion-c-not-d |
                                        c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                        [by implies_intro given-c-not-d]
                                    }
                                  @conclusion-b-not-d |
                                    b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                    [by implies_intro given-b-not-d]
                                }
                              @conclusion-b-not-c |
                                b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                [by implies_intro given-b-not-c]
                            }
                          @conclusion-a-not-d |
                            a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                            [by implies_intro given-a-not-d]
                        }
                      @conclusion-a-not-c |
                        a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                        [by implies_intro given-a-not-c]
                    }
                  @conclusion-a-not-b |
                    a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                    [by implies_intro given-a-not-b]
                }
              @discharge-d |
                forall d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> forall x: Element; apply(compose(transposition(a, b), transposition(c, d)), x) = apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
    [by forall_intro generalize-a]
qed

// -- Judson Lemma 1, identity (2) -----------------------------------------------------------
// (a,b)(c,d) = (a,c,b)(a,c,d) for a,b,c,d distinct. As composites of transpositions
// (a 3-cycle (x,y,z) is (x,z)o(x,y)), that reads
//   (a,b)o(c,d) = [(a,b)o(a,c)] o [(a,d)o(a,c)].
// Extensionality over the five point-cases proved above.
theorem aPairOfDisjointTranspositionsIsAProductOfThreeCycles:
  forall a, b, c, d: Element;
  a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
  compose(transposition(a, b), transposition(c, d)) =
  compose(compose(transposition(a, b), transposition(a, c)),
  compose(transposition(a, d), transposition(a, c)))
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-b |
                    assume a != b {
                      @given-a-c |
                        assume a != c {
                          @given-a-d |
                            assume a != d {
                              @given-b-c |
                                assume b != c {
                                  @given-b-d |
                                    assume b != d {
                                      @given-c-d |
                                        assume c != d {
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-b]
                                          @a-not-c |
                                            a != c
                                            [by hypothesis given-a-c]
                                          @a-not-d |
                                            a != d
                                            [by hypothesis given-a-d]
                                          @b-not-c |
                                            b != c
                                            [by hypothesis given-b-c]
                                          @b-not-d |
                                            b != d
                                            [by hypothesis given-b-d]
                                          @c-not-d |
                                            c != d
                                            [by hypothesis given-c-d]
                                          @agree-everywhere |
                                            forall x: Element;
                                              apply(compose(transposition(a, b), transposition(c, d)), x) =
                                              apply(compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c))), x)
                                            [using specialize agreeAtEveryPoint(a, b, c, d) a-not-b a-not-c a-not-d b-not-c b-not-d c-not-d]
                                          @conclusion-equal |
                                            compose(transposition(a, b), transposition(c, d)) =
                                              compose(compose(transposition(a, b), transposition(a, c)),
                                              compose(transposition(a, d), transposition(a, c)))
                                            [using specialize funcExtensionality(compose(transposition(a, b), transposition(c, d)), compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))) agree-everywhere]
                                        }
                                      @conclusion-c-d |
                                        c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                                        [by implies_intro given-c-d]
                                    }
                                  @conclusion-b-d |
                                    b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                                    [by implies_intro given-b-d]
                                }
                              @conclusion-b-c |
                                b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                                [by implies_intro given-b-c]
                            }
                          @conclusion-a-d |
                            a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                            [by implies_intro given-a-d]
                        }
                      @conclusion-a-c |
                        a != c -> a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                        [by implies_intro given-a-c]
                    }
                  @conclusion-a-b |
                    a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                    [by implies_intro given-a-b]
                }
              @discharge-d |
                forall d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> compose(transposition(a, b), transposition(c, d)) = compose(compose(transposition(a, b), transposition(a, c)), compose(transposition(a, d), transposition(a, c)))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
      compose(transposition(a, b), transposition(c, d)) =
      compose(compose(transposition(a, b), transposition(a, c)),
      compose(transposition(a, d), transposition(a, c)))
    [by forall_intro generalize-a]
qed

// -- Lemma 10.8: generation by 3-cycles -----------------------------------------------------
//
// Judson shows every PAIR of transpositions is a product of 3-cycles, in three cases:
//   (a,b)(a,b) = id      (a,b)(a,c) = (a,c,b)      (a,b)(c,d) = (a,c,b)(a,c,d)
// which is exactly the trichotomy on how {a,b} and {c,d} meet: equal as sets, sharing one
// point, or disjoint. Enumerating every assignment of four points confirms the split is
// exhaustive (seven reachable equality patterns: one disjoint, four sharing a point, two
// equal), so Judson's "every pair must be one of" is provable rather than asserted.
//
// The 3-cycle needs no new sort: std's cycle fold (`cycleSucc`) makes (x,y,z) the composite
// T(x,z) o T(x,y), so `isAThreeCycle` is stated directly on that form -- which is why the
// sharing-one-point case below is DEFINITIONAL rather than a computation.

// A 3-CYCLE, in std's own fold: (x,y,z) = T(x,z) o T(x,y) (`cycleSucc`), so a 3-cycle needs
// no new sort — it IS a composite of two transpositions through a common first point.
define isAThreeCycle(g) = exists x: Element; exists y: Element; exists z: Element;
  x != y and x != z and y != z and
  g = compose(transposition(x, z), transposition(x, y))

// A pair of transpositions SHARING ONE POINT is a single 3-cycle. With s the shared point,
// p the first's other point and q the second's, T(s,p) o T(s,q) = (s,q,p) — and in std's
// fold (s,q,p) is T(s,p) o T(s,q), so this is DEFINITIONAL, not a computation. Stated for
// all four sharing patterns because `transposition` is symmetric in its arguments.
theorem aPairSharingOnePointIsAThreeCycle: forall s, p, q: Element;
  s != p -> s != q -> p != q ->
  isAThreeCycle(compose(transposition(s, p), transposition(s, q)))
proof
  @generalize-s |
    fix s: Element {
      @generalize-p |
        fix p: Element {
          @generalize-q |
            fix q: Element {
              @given-s-differs-from-p |
                assume s != p {
                  @s-differs-from-p |
                    s != p
                    [by hypothesis given-s-differs-from-p]
                  @given-s-differs-from-q |
                    assume s != q {
                      @s-differs-from-q |
                        s != q
                        [by hypothesis given-s-differs-from-q]
                      @given-p-differs-from-q |
                        assume p != q {
                          @p-differs-from-q |
                            p != q
                            [by hypothesis given-p-differs-from-q]
                          // witness x := s, y := q, z := p
                          @q-differs-from-p |
                            q != p
                            [using specialize disequalityIsSymmetric(p, q) p-differs-from-q]
                          @the-witnesses-differ |
                            s != q and s != p and q != p
                            [using tautology s-differs-from-q s-differs-from-p q-differs-from-p]
                          @the-composite-is-the-fold |
                            compose(transposition(s, p), transposition(s, q)) =
                              compose(transposition(s, p), transposition(s, q))
                            [by reflexivity]
                          @the-witnesses-work |
                            (s != q and s != p and q != p) and
                              compose(transposition(s, p), transposition(s, q)) =
                              compose(transposition(s, p), transposition(s, q))
                            [by and_intro the-witnesses-differ the-composite-is-the-fold]
                          @a-third-point-exists |
                            exists z: Element; (s != q and s != z and q != z) and
                              compose(transposition(s, p), transposition(s, q)) =
                              compose(transposition(s, z), transposition(s, q))
                            [by exists_intro(p) the-witnesses-work]
                          @a-second-point-exists |
                            exists y: Element; exists z: Element; (s != y and s != z and y != z) and
                              compose(transposition(s, p), transposition(s, q)) =
                              compose(transposition(s, z), transposition(s, y))
                            [by exists_intro(q) a-third-point-exists]
                          @conclusion-is-a-three-cycle |
                            isAThreeCycle(compose(transposition(s, p), transposition(s, q)))
                            [by exists_intro(s) a-second-point-exists]
                        }
                      @conclusion-p-differs-gives-three-cycle |
                        p != q -> isAThreeCycle(compose(transposition(s, p), transposition(s, q)))
                        [by implies_intro given-p-differs-from-q]
                    }
                  @conclusion-s-differs-from-q-gives |
                    s != q -> p != q ->
                      isAThreeCycle(compose(transposition(s, p), transposition(s, q)))
                    [by implies_intro given-s-differs-from-q]
                }
              @conclusion-for-q |
                s != p -> s != q -> p != q ->
                  isAThreeCycle(compose(transposition(s, p), transposition(s, q)))
                [by implies_intro given-s-differs-from-p]
            }
          @discharge-q |
            forall q: Element; s != p -> s != q -> p != q ->
              isAThreeCycle(compose(transposition(s, p), transposition(s, q)))
            [by forall_intro generalize-q]
        }
      @discharge-p |
        forall p, q: Element; s != p -> s != q -> p != q ->
          isAThreeCycle(compose(transposition(s, p), transposition(s, q)))
        [by forall_intro generalize-p]
    }
  @conclusion |
    forall s, p, q: Element; s != p -> s != q -> p != q ->
      isAThreeCycle(compose(transposition(s, p), transposition(s, q)))
    [by forall_intro generalize-s]
qed

// A pair of DISJOINT transpositions is a product of TWO 3-cycles:
// (a,b)(c,d) = (a,c,b)(a,c,d), which in std's fold is
// [T(a,b)oT(a,c)] o [T(a,d)oT(a,c)] — `aPairOfDisjointTranspositionsIsAProductOfThreeCycles`
// proves that equation; this repackages it as "a composite of two things, each a 3-cycle".
theorem aPairOfDisjointTranspositionsIsTwoThreeCycles: forall a, b, c, d: Element;
  a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
  exists g, h: Fn;
  isAThreeCycle(g) and isAThreeCycle(h) and
  compose(transposition(a, b), transposition(c, d)) = compose(g, h)
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-differs-from-b |
                    assume a != b {
                      @a-differs-from-b |
                        a != b
                        [by hypothesis given-a-differs-from-b]
                      @given-a-differs-from-c |
                        assume a != c {
                          @a-differs-from-c |
                            a != c
                            [by hypothesis given-a-differs-from-c]
                          @given-a-differs-from-d |
                            assume a != d {
                              @a-differs-from-d |
                                a != d
                                [by hypothesis given-a-differs-from-d]
                              @given-b-differs-from-c |
                                assume b != c {
                                  @b-differs-from-c |
                                    b != c
                                    [by hypothesis given-b-differs-from-c]
                                  @given-b-differs-from-d |
                                    assume b != d {
                                      @b-differs-from-d |
                                        b != d
                                        [by hypothesis given-b-differs-from-d]
                                      @given-c-differs-from-d |
                                        assume c != d {
                                          @c-differs-from-d |
                                            c != d
                                            [by hypothesis given-c-differs-from-d]
                                          @the-pair-splits |
                                            compose(transposition(a, b), transposition(c, d)) =
                                              compose(compose(transposition(a, b), transposition(a, c)),
                                              compose(transposition(a, d), transposition(a, c)))
                                            [using specialize aPairOfDisjointTranspositionsIsAProductOfThreeCycles(a, b, c, d) a-differs-from-b a-differs-from-c a-differs-from-d b-differs-from-c b-differs-from-d c-differs-from-d]
                                          // the first factor T(a,b)oT(a,c) shares the point a:
                                          // it is the 3-cycle (a,c,b).
                                          @the-first-factor-is-a-three-cycle |
                                            isAThreeCycle(compose(transposition(a, b), transposition(a, c)))
                                            [using specialize aPairSharingOnePointIsAThreeCycle(a, b, c) a-differs-from-b a-differs-from-c b-differs-from-c]
                                          @d-differs-from-c |
                                            d != c
                                            [using specialize disequalityIsSymmetric(c, d) c-differs-from-d]
                                          // the second factor T(a,d)oT(a,c) likewise: (a,c,d).
                                          @the-second-factor-is-a-three-cycle |
                                            isAThreeCycle(compose(transposition(a, d), transposition(a, c)))
                                            [using specialize aPairSharingOnePointIsAThreeCycle(a, d, c) a-differs-from-d a-differs-from-c d-differs-from-c]
                                          @both-factors-are-three-cycles |
                                            isAThreeCycle(compose(transposition(a, b), transposition(a, c)))
                                              and isAThreeCycle(compose(transposition(a, d), transposition(a, c)))
                                            [by and_intro the-first-factor-is-a-three-cycle the-second-factor-is-a-three-cycle]
                                          @the-factors-work |
                                            (isAThreeCycle(compose(transposition(a, b), transposition(a, c)))
                                              and isAThreeCycle(compose(transposition(a, d), transposition(a, c))))
                                              and compose(transposition(a, b), transposition(c, d)) =
                                              compose(compose(transposition(a, b), transposition(a, c)),
                                              compose(transposition(a, d), transposition(a, c)))
                                            [by and_intro both-factors-are-three-cycles the-pair-splits]
                                          @a-second-factor-exists |
                                            exists h: Fn;
                                              (isAThreeCycle(compose(transposition(a, b), transposition(a, c)))
                                              and isAThreeCycle(h))
                                              and compose(transposition(a, b), transposition(c, d)) =
                                              compose(compose(transposition(a, b), transposition(a, c)), h)
                                            [by exists_intro(compose(transposition(a, d), transposition(a, c))) the-factors-work]
                                          @conclusion-two-three-cycles |
                                            exists g, h: Fn;
                                              isAThreeCycle(g) and isAThreeCycle(h) and
                                              compose(transposition(a, b), transposition(c, d)) = compose(g, h)
                                            [by exists_intro(compose(transposition(a, b), transposition(a, c))) a-second-factor-exists]
                                        }
                                      @conclusion-c-differs-gives |
                                        c != d -> (exists g, h: Fn;
                                          isAThreeCycle(g) and isAThreeCycle(h) and
                                          compose(transposition(a, b), transposition(c, d)) = compose(g, h))
                                        [by implies_intro given-c-differs-from-d]
                                    }
                                  @conclusion-b-differs-from-d-gives |
                                    b != d -> c != d -> (exists g, h: Fn;
                                      isAThreeCycle(g) and isAThreeCycle(h) and
                                      compose(transposition(a, b), transposition(c, d)) = compose(g, h))
                                    [by implies_intro given-b-differs-from-d]
                                }
                              @conclusion-b-differs-from-c-gives |
                                b != c -> b != d -> c != d -> (exists g, h: Fn;
                                  isAThreeCycle(g) and isAThreeCycle(h) and
                                  compose(transposition(a, b), transposition(c, d)) = compose(g, h))
                                [by implies_intro given-b-differs-from-c]
                            }
                          @conclusion-a-differs-from-d-gives |
                            a != d -> b != c -> b != d -> c != d -> (exists g, h: Fn;
                              isAThreeCycle(g) and isAThreeCycle(h) and
                              compose(transposition(a, b), transposition(c, d)) = compose(g, h))
                            [by implies_intro given-a-differs-from-d]
                        }
                      @conclusion-a-differs-from-c-gives |
                        a != c -> a != d -> b != c -> b != d -> c != d -> (exists g, h: Fn;
                          isAThreeCycle(g) and isAThreeCycle(h) and
                          compose(transposition(a, b), transposition(c, d)) = compose(g, h))
                        [by implies_intro given-a-differs-from-c]
                    }
                  @conclusion-for-d |
                    a != b -> a != c -> a != d -> b != c -> b != d -> c != d -> (exists g, h: Fn;
                      isAThreeCycle(g) and isAThreeCycle(h) and
                      compose(transposition(a, b), transposition(c, d)) = compose(g, h))
                    [by implies_intro given-a-differs-from-b]
                }
              @discharge-d |
                forall d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
                  (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                  compose(transposition(a, b), transposition(c, d)) = compose(g, h))
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
              (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
              compose(transposition(a, b), transposition(c, d)) = compose(g, h))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
          (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
          compose(transposition(a, b), transposition(c, d)) = compose(g, h))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element;
      a != b -> a != c -> a != d -> b != c -> b != d -> c != d ->
      exists g, h: Fn;
      isAThreeCycle(g) and isAThreeCycle(h) and
      compose(transposition(a, b), transposition(c, d)) = compose(g, h)
    [by forall_intro generalize-a]
qed

// A pair THROUGH A COMMON FIRST POINT is the identity (when the other two points coincide)
// or a single 3-cycle. Proved once, on the NORMALIZED form T(s,p) o T(s,q); the four ways a
// pair of transpositions can share a point all rewrite to this by `transpositionIsSymmetric`,
// so the general pair theorem below cites this rather than repeating the argument four times.
theorem aPairThroughACommonPointIsTheIdentityOrAThreeCycle: forall s, p, q: Element;
  s != p -> s != q ->
  ((compose(transposition(s, p), transposition(s, q)) = identityFn)
  or isAThreeCycle(compose(transposition(s, p), transposition(s, q))))
proof
  @generalize-s |
    fix s: Element {
      @generalize-p |
        fix p: Element {
          @generalize-q |
            fix q: Element {
              @given-s-differs-from-p |
                assume s != p {
                  @s-differs-from-p |
                    s != p
                    [by hypothesis given-s-differs-from-p]
                  @given-s-differs-from-q |
                    assume s != q {
                      @s-differs-from-q |
                        s != q
                        [by hypothesis given-s-differs-from-q]
                      @the-other-points-agree-or-differ |
                        p = q or p != q
                        [using tautology]
                      @conclusion-identity-or-three-cycle |
                        ((compose(transposition(s, p), transposition(s, q)) = identityFn)
                          or isAThreeCycle(compose(transposition(s, p), transposition(s, q))))
                        case the-other-points-agree-or-differ {
                          @when-the-other-points-agree |
                            assume p = q {
                              @the-other-points-agree |
                                p = q
                                [by hypothesis when-the-other-points-agree]
                              @the-doubled-transposition-is-the-identity |
                                compose(transposition(s, p), transposition(s, p)) = identityFn
                                [using specialize transpositionIsAnInvolution(s, p)]
                              @the-pair-is-the-identity |
                                compose(transposition(s, p), transposition(s, q)) = identityFn
                                [by rewrite the-other-points-agree the-doubled-transposition-is-the-identity]
                              @conclusion-when-the-other-points-agree |
                                ((compose(transposition(s, p), transposition(s, q)) = identityFn)
                                  or isAThreeCycle(compose(transposition(s, p), transposition(s, q))))
                                [by or_intro_left the-pair-is-the-identity]
                            }
                          @when-the-other-points-differ |
                            assume p != q {
                              @the-other-points-differ |
                                p != q
                                [by hypothesis when-the-other-points-differ]
                              @the-pair-is-a-three-cycle |
                                isAThreeCycle(compose(transposition(s, p), transposition(s, q)))
                                [using specialize aPairSharingOnePointIsAThreeCycle(s, p, q) s-differs-from-p s-differs-from-q the-other-points-differ]
                              @conclusion-when-the-other-points-differ |
                                ((compose(transposition(s, p), transposition(s, q)) = identityFn)
                                  or isAThreeCycle(compose(transposition(s, p), transposition(s, q))))
                                [by or_intro_right the-pair-is-a-three-cycle]
                            }
                        }
                    }
                  @conclusion-s-differs-from-q-gives |
                    s != q ->
                      ((compose(transposition(s, p), transposition(s, q)) = identityFn)
                      or isAThreeCycle(compose(transposition(s, p), transposition(s, q))))
                    [by implies_intro given-s-differs-from-q]
                }
              @conclusion-for-q |
                s != p -> s != q ->
                  ((compose(transposition(s, p), transposition(s, q)) = identityFn)
                  or isAThreeCycle(compose(transposition(s, p), transposition(s, q))))
                [by implies_intro given-s-differs-from-p]
            }
          @discharge-q |
            forall q: Element; s != p -> s != q ->
              ((compose(transposition(s, p), transposition(s, q)) = identityFn)
              or isAThreeCycle(compose(transposition(s, p), transposition(s, q))))
            [by forall_intro generalize-q]
        }
      @discharge-p |
        forall p, q: Element; s != p -> s != q ->
          ((compose(transposition(s, p), transposition(s, q)) = identityFn)
          or isAThreeCycle(compose(transposition(s, p), transposition(s, q))))
        [by forall_intro generalize-p]
    }
  @conclusion |
    forall s, p, q: Element; s != p -> s != q ->
      ((compose(transposition(s, p), transposition(s, q)) = identityFn)
      or isAThreeCycle(compose(transposition(s, p), transposition(s, q))))
    [by forall_intro generalize-s]
qed

// LEMMA 10.8's pair step: any pair of transpositions is the identity, one 3-cycle, or two.
// The split is the trichotomy on how {a,b} meets {c,d} — four shared-point leads (each a
// rewrite into `commonPoint`'s normalized form) and the disjoint case. Exhaustive by
// tautology over the four equality atoms.
theorem aPairOfTranspositionsIsAtMostTwoThreeCycles: forall a, b, c, d: Element;
  a != b -> c != d ->
  ((compose(transposition(a, b), transposition(c, d)) = identityFn)
  or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
  or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
  compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-differs-from-b |
                    assume a != b {
                      @a-differs-from-b |
                        a != b
                        [by hypothesis given-a-differs-from-b]
                      @given-c-differs-from-d |
                        assume c != d {
                          @c-differs-from-d |
                            c != d
                            [by hypothesis given-c-differs-from-d]
                          @b-differs-from-a |
                            b != a
                            [using specialize disequalityIsSymmetric(a, b) a-differs-from-b]
                          @d-differs-from-c |
                            d != c
                            [using specialize disequalityIsSymmetric(c, d) c-differs-from-d]
                          @how-the-pairs-meet |
                            a = c or a = d or b = c or b = d
                              or (a != c and a != d and b != c and b != d)
                            [using tautology]
                          @conclusion-at-most-two |
                            ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                              or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                              or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                              compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
                            case how-the-pairs-meet {
                              // a = c: the pair is already T(a,b) o T(a,d) — no flip needed.
                              @when-the-first-points-agree |
                                assume a = c {
                                  @the-first-points-agree |
                                    a = c
                                    [by hypothesis when-the-first-points-agree]
                                  @a-differs-from-d-here |
                                    a != d
                                    [by rewrite the-first-points-agree c-differs-from-d]
                                  @normalized-resolves-here |
                                    ((compose(transposition(a, b), transposition(a, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(a, d))))
                                    [using specialize aPairThroughACommonPointIsTheIdentityOrAThreeCycle(a, b, d) a-differs-from-b a-differs-from-d-here]
                                  @pair-resolves-here |
                                    ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, d))))
                                    [by rewrite the-first-points-agree normalized-resolves-here]
                                  @conclusion-first-points-agree |
                                    ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                                      or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                                      compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
                                    [using tautology pair-resolves-here]
                                }
                              // a = d: flip the SECOND, T(c,a) = T(a,c).
                              @when-the-first-meets-the-last |
                                assume a = d {
                                  @the-first-meets-the-last |
                                    a = d
                                    [by hypothesis when-the-first-meets-the-last]
                                  @a-differs-from-c-here |
                                    a != c
                                    [by rewrite the-first-meets-the-last d-differs-from-c]
                                  @the-second-flips |
                                    transposition(a, c) = transposition(c, a)
                                    [using specialize transpositionIsSymmetric(a, c)]
                                  @normalized-resolves-there |
                                    ((compose(transposition(a, b), transposition(a, c)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(a, c))))
                                    [using specialize aPairThroughACommonPointIsTheIdentityOrAThreeCycle(a, b, c) a-differs-from-b a-differs-from-c-here]
                                  @flipped-resolves-there |
                                    ((compose(transposition(a, b), transposition(c, a)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, a))))
                                    [by rewrite the-second-flips normalized-resolves-there]
                                  @pair-resolves-there |
                                    ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, d))))
                                    [by rewrite the-first-meets-the-last flipped-resolves-there]
                                  @conclusion-first-meets-the-last |
                                    ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                                      or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                                      compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
                                    [using tautology pair-resolves-there]
                                }
                              // b = c: flip the FIRST, T(a,b) = T(b,a).
                              @when-the-last-meets-the-first |
                                assume b = c {
                                  @the-last-meets-the-first |
                                    b = c
                                    [by hypothesis when-the-last-meets-the-first]
                                  @b-differs-from-d-here |
                                    b != d
                                    [by rewrite the-last-meets-the-first c-differs-from-d]
                                  @the-first-flips |
                                    transposition(a, b) = transposition(b, a)
                                    [using specialize transpositionIsSymmetric(a, b)]
                                  @normalized-resolves-flipped |
                                    ((compose(transposition(b, a), transposition(b, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(b, a), transposition(b, d))))
                                    [using specialize aPairThroughACommonPointIsTheIdentityOrAThreeCycle(b, a, d) b-differs-from-a b-differs-from-d-here]
                                  @restored-resolves-flipped |
                                    ((compose(transposition(a, b), transposition(b, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(b, d))))
                                    [by rewrite the-first-flips normalized-resolves-flipped]
                                  @pair-resolves-flipped |
                                    ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, d))))
                                    [by rewrite the-last-meets-the-first restored-resolves-flipped]
                                  @conclusion-last-meets-the-first |
                                    ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                                      or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                                      compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
                                    [using tautology pair-resolves-flipped]
                                }
                              // b = d: flip BOTH.
                              @when-the-last-points-agree |
                                assume b = d {
                                  @the-last-points-agree |
                                    b = d
                                    [by hypothesis when-the-last-points-agree]
                                  @b-differs-from-c-here |
                                    b != c
                                    [by rewrite the-last-points-agree d-differs-from-c]
                                  @the-first-flips-too |
                                    transposition(a, b) = transposition(b, a)
                                    [using specialize transpositionIsSymmetric(a, b)]
                                  @the-second-flips-too |
                                    transposition(b, c) = transposition(c, b)
                                    [using specialize transpositionIsSymmetric(b, c)]
                                  @normalized-resolves-both |
                                    ((compose(transposition(b, a), transposition(b, c)) = identityFn)
                                      or isAThreeCycle(compose(transposition(b, a), transposition(b, c))))
                                    [using specialize aPairThroughACommonPointIsTheIdentityOrAThreeCycle(b, a, c) b-differs-from-a b-differs-from-c-here]
                                  @second-restored-both |
                                    ((compose(transposition(b, a), transposition(c, b)) = identityFn)
                                      or isAThreeCycle(compose(transposition(b, a), transposition(c, b))))
                                    [by rewrite the-second-flips-too normalized-resolves-both]
                                  @first-restored-both |
                                    ((compose(transposition(a, b), transposition(c, b)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, b))))
                                    [by rewrite the-first-flips-too second-restored-both]
                                  @pair-resolves-both |
                                    ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, d))))
                                    [by rewrite the-last-points-agree first-restored-both]
                                  @conclusion-last-points-agree |
                                    ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                                      or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                                      compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
                                    [using tautology pair-resolves-both]
                                }
                              // disjoint: two 3-cycles, by Judson's (a,b)(c,d) = (a,c,b)(a,c,d).
                              @when-the-pairs-are-disjoint |
                                assume a != c and a != d and b != c and b != d {
                                  @the-pairs-are-disjoint |
                                    a != c and a != d and b != c and b != d
                                    [by hypothesis when-the-pairs-are-disjoint]
                                  @a-differs-from-c-disjoint |
                                    a != c
                                    [using tautology the-pairs-are-disjoint]
                                  @a-differs-from-d-disjoint |
                                    a != d
                                    [using tautology the-pairs-are-disjoint]
                                  @b-differs-from-c-disjoint |
                                    b != c
                                    [using tautology the-pairs-are-disjoint]
                                  @b-differs-from-d-disjoint |
                                    b != d
                                    [using tautology the-pairs-are-disjoint]
                                  @two-three-cycles |
                                    exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                                      compose(transposition(a, b), transposition(c, d)) = compose(g, h)
                                    [using specialize aPairOfDisjointTranspositionsIsTwoThreeCycles(a, b, c, d) a-differs-from-b a-differs-from-c-disjoint a-differs-from-d-disjoint b-differs-from-c-disjoint b-differs-from-d-disjoint c-differs-from-d]
                                  @conclusion-pairs-are-disjoint |
                                    ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                                      or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                                      or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                                      compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
                                    [using tautology two-three-cycles]
                                }
                            }
                        }
                      @conclusion-c-differs-gives |
                        c != d ->
                          ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                          or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                          or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                          compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
                        [by implies_intro given-c-differs-from-d]
                    }
                  @conclusion-for-d |
                    a != b -> c != d ->
                      ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                      or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                      or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                      compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
                    [by implies_intro given-a-differs-from-b]
                }
              @discharge-d |
                forall d: Element; a != b -> c != d ->
                  ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                  or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                  or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                  compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != b -> c != d ->
              ((compose(transposition(a, b), transposition(c, d)) = identityFn)
              or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
              or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
              compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != b -> c != d ->
          ((compose(transposition(a, b), transposition(c, d)) = identityFn)
          or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
          or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
          compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != b -> c != d ->
      ((compose(transposition(a, b), transposition(c, d)) = identityFn)
      or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
      or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
      compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
    [by forall_intro generalize-a]
qed

theorem concatenationPreservesEntryProperty = permutation_transpositions.concatenationPreservesEntryProperty

// The 3-cycle instance of the concatenation lemma: joining two runs of 3-cycles gives a run
// of 3-cycles. The schema lives in std/permutation/transpositions.b4m, where the same proof
// serves `isATransposition`.
theorem concatenationPreservesThreeCycles: forall u: Seq; forall t: Seq; forall r: Seq; forall n: Nat; forall m: Nat;
  (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)) ->
  (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)) ->
  (forall i: Nat; less_than(i, n) -> isAThreeCycle(at(t, i))) ->
  (forall i: Nat; less_than(i, m) -> isAThreeCycle(at(r, i))) ->
  forall i: Nat; less_than(i, add(n, m)) -> isAThreeCycle(at(u, i))
proof
  @conclusion |
    forall u: Seq; forall t: Seq; forall r: Seq; forall n: Nat; forall m: Nat;
      (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)) ->
      (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)) ->
      (forall i: Nat; less_than(i, n) -> isAThreeCycle(at(t, i))) ->
      (forall i: Nat; less_than(i, m) -> isAThreeCycle(at(r, i))) ->
      forall i: Nat; less_than(i, add(n, m)) -> isAThreeCycle(at(u, i))
    [using instantiation concatenationPreservesEntryProperty((fun g: Fn => isAThreeCycle(g)))]
qed

// -- a RUN of 3-cycles -----------------------------------------------------------------------
//
// Lemma 10.8's conclusion: an even permutation is a product of 3-cycles. A RUN rather than a
// fixed count, because the length is what the induction on the transposition count produces,
// and `aProductOfSubgroupEntriesIsInTheSubgroup` (Lemma 10.9's consumer) takes a run.

define isAProductOfThreeCycles(g) = exists s: Seq; exists n: Nat;
  (forall i: Nat; less_than(i, n) -> isAThreeCycle(at(s, i)))
  and productUpTo(s, n) = g

// The identity is the EMPTY run: n = ZERO, where the entry condition is vacuous and the
// product is the identity by `productUpToZero`.
theorem theIdentityIsAProductOfThreeCycles: isAProductOfThreeCycles(identityFn)
proof
  @the-identity-is-a-permutation |
    invertible(identityFn)
    [by cite identityIsAPermutation]
  @a-sequence-exists |
    exists s: Seq; at(s, ZERO) = identityFn and productUpTo(s, succ(ZERO)) = identityFn
    [using specialize seqSingleton(identityFn) the-identity-is-a-permutation]
  @with-some-sequence |
    unpack s: Seq from a-sequence-exists {
      @the-empty-product-is-the-identity |
        productUpTo(s, ZERO) = identityFn
        [using specialize productUpToZero(s)]
      @generalize-i |
        fix i: Nat {
          @nothing-is-below-zero |
            not less_than(i, ZERO)
            [using specialize notLessThanZero(i)]
          @conclusion-vacuous-at-i |
            less_than(i, ZERO) -> isAThreeCycle(at(s, i))
            [using tautology nothing-is-below-zero]
        }
      @every-entry-below-zero-is-a-three-cycle |
        forall i: Nat; less_than(i, ZERO) -> isAThreeCycle(at(s, i))
        [by forall_intro generalize-i]
      @the-empty-run-works |
        (forall i: Nat; less_than(i, ZERO) -> isAThreeCycle(at(s, i)))
          and productUpTo(s, ZERO) = identityFn
        [by and_intro every-entry-below-zero-is-a-three-cycle the-empty-product-is-the-identity]
      @a-length-exists |
        exists n: Nat; (forall i: Nat; less_than(i, n) -> isAThreeCycle(at(s, i)))
          and productUpTo(s, n) = identityFn
        [by exists_intro(ZERO) the-empty-run-works]
      @conclusion-inner |
        isAProductOfThreeCycles(identityFn)
        [by exists_intro(s) a-length-exists]
    }
  @conclusion |
    isAProductOfThreeCycles(identityFn)
    [by exists_elim with-some-sequence]
qed

// A 3-CYCLE IS A PERMUTATION — it is a composite of two transpositions (std's fold), each a
// permutation. Needed before a 3-cycle can be put into a `Seq` (`seqSingleton` is guarded on
// invertibility).
theorem aThreeCycleIsAPermutation: forall g: Fn; isAThreeCycle(g) -> invertible(g)
proof
  @generalize-g |
    fix g: Fn {
      @given-a-three-cycle |
        assume isAThreeCycle(g) {
          @the-three-cycle |
            isAThreeCycle(g)
            [by hypothesis given-a-three-cycle]
          @with-the-first-point |
            unpack x: Element from the-three-cycle {
              @the-remaining-points-exist |
                exists y: Element; exists z: Element;
                  x != y and x != z and y != z and
                  g = compose(transposition(x, z), transposition(x, y))
                [by hypothesis with-the-first-point]
              @with-the-second-point |
                unpack y: Element from the-remaining-points-exist {
                  @the-third-point-exists |
                    exists z: Element;
                      x != y and x != z and y != z and
                      g = compose(transposition(x, z), transposition(x, y))
                    [by hypothesis with-the-second-point]
                  @with-the-third-point |
                    unpack z: Element from the-third-point-exists {
                      @the-points-and-the-fold |
                        x != y and x != z and y != z and
                          g = compose(transposition(x, z), transposition(x, y))
                        [by hypothesis with-the-third-point]
                      @the-fold |
                        g = compose(transposition(x, z), transposition(x, y))
                        [using tautology the-points-and-the-fold]
                      @the-outer-transposition-is-a-permutation |
                        invertible(transposition(x, z))
                        [using specialize transpositionIsAPermutation(x, z)]
                      @the-inner-transposition-is-a-permutation |
                        invertible(transposition(x, y))
                        [using specialize transpositionIsAPermutation(x, y)]
                      @the-fold-is-a-permutation |
                        invertible(compose(transposition(x, z), transposition(x, y)))
                        [using specialize composeIsAPermutation(transposition(x, z), transposition(x, y)) the-outer-transposition-is-a-permutation the-inner-transposition-is-a-permutation]
                      @conclusion-at-the-third-point |
                        invertible(g)
                        [by rewrite the-fold the-fold-is-a-permutation]
                    }
                  @conclusion-at-the-second-point |
                    invertible(g)
                    [by exists_elim with-the-third-point]
                }
              @conclusion-at-the-first-point |
                invertible(g)
                [by exists_elim with-the-second-point]
            }
          @conclusion-invertible |
            invertible(g)
            [by exists_elim with-the-first-point]
        }
      @conclusion-for-g |
        isAThreeCycle(g) -> invertible(g)
        [by implies_intro given-a-three-cycle]
    }
  @conclusion |
    forall g: Fn; isAThreeCycle(g) -> invertible(g)
    [by forall_intro generalize-g]
qed

// A PRODUCT of two 3-cycle runs is a 3-cycle run — `seqConcat` joins the sequences and
// `concatenationPreservesThreeCycles` says the joined run's entries are still 3-cycles.
// This is what lets the induction below absorb each transposition pair into the run it is
// building, and what makes `isAProductOfThreeCycles` closed under composition.
theorem aProductOfThreeCycleRunsIsAThreeCycleRun: forall g, h: Fn;
  isAProductOfThreeCycles(g) -> isAProductOfThreeCycles(h) ->
  isAProductOfThreeCycles(compose(g, h))
proof
  @generalize-g |
    fix g: Fn {
      @generalize-h |
        fix h: Fn {
          @given-g-is-a-run |
            assume isAProductOfThreeCycles(g) {
              @g-is-a-run |
                isAProductOfThreeCycles(g)
                [by hypothesis given-g-is-a-run]
              @given-h-is-a-run |
                assume isAProductOfThreeCycles(h) {
                  @h-is-a-run |
                    isAProductOfThreeCycles(h)
                    [by hypothesis given-h-is-a-run]
                  @with-g-sequence |
                    unpack s: Seq from g-is-a-run {
                      @g-length-exists |
                        exists n: Nat;
                          (forall i: Nat; less_than(i, n) -> isAThreeCycle(at(s, i)))
                          and productUpTo(s, n) = g
                        [by hypothesis with-g-sequence]
                      @with-g-length |
                        unpack m: Nat from g-length-exists {
                          @g-run-facts |
                            (forall i: Nat; less_than(i, m) -> isAThreeCycle(at(s, i)))
                              and productUpTo(s, m) = g
                            [by hypothesis with-g-length]
                          @g-entries-are-three-cycles |
                            forall i: Nat; less_than(i, m) -> isAThreeCycle(at(s, i))
                            [by and_elim_left g-run-facts]
                          @g-is-the-prefix-product |
                            productUpTo(s, m) = g
                            [by and_elim_right g-run-facts]
                          @with-h-sequence |
                            unpack t: Seq from h-is-a-run {
                              @h-length-exists |
                                exists n: Nat;
                                  (forall i: Nat; less_than(i, n) -> isAThreeCycle(at(t, i)))
                                  and productUpTo(t, n) = h
                                [by hypothesis with-h-sequence]
                              @with-h-length |
                                unpack n: Nat from h-length-exists {
                                  @h-run-facts |
                                    (forall i: Nat; less_than(i, n) -> isAThreeCycle(at(t, i)))
                                      and productUpTo(t, n) = h
                                    [by hypothesis with-h-length]
                                  @h-entries-are-three-cycles |
                                    forall i: Nat; less_than(i, n) -> isAThreeCycle(at(t, i))
                                    [by and_elim_left h-run-facts]
                                  @h-is-the-suffix-product |
                                    productUpTo(t, n) = h
                                    [by and_elim_right h-run-facts]
                                  @a-joined-sequence-exists |
                                    exists u: Seq;
                                      (forall i: Nat; less_than(i, m) -> at(u, i) = at(s, i))
                                      and (forall i: Nat; less_than(i, n) -> at(u, add(m, i)) = at(t, i))
                                      and productUpTo(u, add(m, n)) = compose(productUpTo(s, m), productUpTo(t, n))
                                    [using specialize seqConcat(s, t, m, n)]
                                  @with-the-joined-sequence |
                                    unpack u: Seq from a-joined-sequence-exists {
                                      @join-facts |
                                        (forall i: Nat; less_than(i, m) -> at(u, i) = at(s, i))
                                          and (forall i: Nat; less_than(i, n) -> at(u, add(m, i)) = at(t, i))
                                          and productUpTo(u, add(m, n)) = compose(productUpTo(s, m), productUpTo(t, n))
                                        [by hypothesis with-the-joined-sequence]
                                      @the-two-agreements |
                                        (forall i: Nat; less_than(i, m) -> at(u, i) = at(s, i))
                                          and (forall i: Nat; less_than(i, n) -> at(u, add(m, i)) = at(t, i))
                                        [by and_elim_left join-facts]
                                      @the-joined-product |
                                        productUpTo(u, add(m, n)) = compose(productUpTo(s, m), productUpTo(t, n))
                                        [by and_elim_right join-facts]
                                      @the-prefix-agrees |
                                        forall i: Nat; less_than(i, m) -> at(u, i) = at(s, i)
                                        [by and_elim_left the-two-agreements]
                                      @the-suffix-agrees |
                                        forall i: Nat; less_than(i, n) -> at(u, add(m, i)) = at(t, i)
                                        [by and_elim_right the-two-agreements]
                                      @the-joined-entries-are-three-cycles |
                                        forall i: Nat; less_than(i, add(m, n)) -> isAThreeCycle(at(u, i))
                                        [using specialize concatenationPreservesThreeCycles(u, s, t, m, n) the-prefix-agrees the-suffix-agrees g-entries-are-three-cycles h-entries-are-three-cycles]
                                      @the-joined-product-is-the-composite |
                                        productUpTo(u, add(m, n)) = compose(g, h)
                                        [using chain the-joined-product g-is-the-prefix-product h-is-the-suffix-product]
                                      @the-joined-run-works |
                                        (forall i: Nat; less_than(i, add(m, n)) -> isAThreeCycle(at(u, i)))
                                          and productUpTo(u, add(m, n)) = compose(g, h)
                                        [by and_intro the-joined-entries-are-three-cycles the-joined-product-is-the-composite]
                                      @a-joined-length-exists |
                                        exists k: Nat;
                                          (forall i: Nat; less_than(i, k) -> isAThreeCycle(at(u, i)))
                                          and productUpTo(u, k) = compose(g, h)
                                        [by exists_intro(add(m, n)) the-joined-run-works]
                                      @conclusion-at-the-joined-sequence |
                                        isAProductOfThreeCycles(compose(g, h))
                                        [by exists_intro(u) a-joined-length-exists]
                                    }
                                  @conclusion-at-the-h-length |
                                    isAProductOfThreeCycles(compose(g, h))
                                    [by exists_elim with-the-joined-sequence]
                                }
                              @conclusion-at-the-h-sequence |
                                isAProductOfThreeCycles(compose(g, h))
                                [by exists_elim with-h-length]
                            }
                          @conclusion-at-the-g-length |
                            isAProductOfThreeCycles(compose(g, h))
                            [by exists_elim with-h-sequence]
                        }
                      @conclusion-at-the-g-sequence |
                        isAProductOfThreeCycles(compose(g, h))
                        [by exists_elim with-g-length]
                    }
                  @conclusion-closed |
                    isAProductOfThreeCycles(compose(g, h))
                    [by exists_elim with-g-sequence]
                }
              @conclusion-h-run-gives |
                isAProductOfThreeCycles(h) -> isAProductOfThreeCycles(compose(g, h))
                [by implies_intro given-h-is-a-run]
            }
          @conclusion-for-h |
            isAProductOfThreeCycles(g) -> isAProductOfThreeCycles(h) ->
              isAProductOfThreeCycles(compose(g, h))
            [by implies_intro given-g-is-a-run]
        }
      @discharge-h |
        forall h: Fn; isAProductOfThreeCycles(g) -> isAProductOfThreeCycles(h) ->
          isAProductOfThreeCycles(compose(g, h))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Fn;
      isAProductOfThreeCycles(g) -> isAProductOfThreeCycles(h) ->
      isAProductOfThreeCycles(compose(g, h))
    [by forall_intro generalize-g]
qed

// A SINGLE 3-cycle is a run of length one. `seqSingleton` puts it in a sequence (guarded on
// invertibility — hence `aThreeCycleIsAPermutation`), and the only index below succ(ZERO) is
// ZERO, where the entry IS the 3-cycle.
theorem aThreeCycleIsAProductOfThreeCycles: forall g: Fn;
  isAThreeCycle(g) -> isAProductOfThreeCycles(g)
proof
  @generalize-g |
    fix g: Fn {
      @given-a-three-cycle |
        assume isAThreeCycle(g) {
          @the-three-cycle |
            isAThreeCycle(g)
            [by hypothesis given-a-three-cycle]
          @the-three-cycle-is-a-permutation |
            invertible(g)
            [using specialize aThreeCycleIsAPermutation(g) the-three-cycle]
          @a-sequence-exists |
            exists s: Seq; at(s, ZERO) = g and productUpTo(s, succ(ZERO)) = g
            [using specialize seqSingleton(g) the-three-cycle-is-a-permutation]
          @with-the-sequence |
            unpack s: Seq from a-sequence-exists {
              @the-sequence-facts |
                at(s, ZERO) = g and productUpTo(s, succ(ZERO)) = g
                [by hypothesis with-the-sequence]
              @the-entry-is-the-three-cycle |
                at(s, ZERO) = g
                [by and_elim_left the-sequence-facts]
              @the-product-is-the-three-cycle |
                productUpTo(s, succ(ZERO)) = g
                [by and_elim_right the-sequence-facts]
              @the-zeroth-entry-is-a-three-cycle |
                isAThreeCycle(at(s, ZERO))
                [by rewrite the-entry-is-the-three-cycle the-three-cycle]
              @generalize-i |
                fix i: Nat {
                  @given-i-below-one |
                    assume less_than(i, succ(ZERO)) {
                      @i-below-one |
                        less_than(i, succ(ZERO))
                        [by hypothesis given-i-below-one]
                      @i-is-below-zero-or-is-zero |
                        less_than(i, ZERO) or i = ZERO
                        [using specialize lessThanSuccSplit(i, ZERO) i-below-one]
                      @nothing-is-below-zero |
                        not less_than(i, ZERO)
                        [using specialize notLessThanZero(i)]
                      @i-is-zero |
                        i = ZERO
                        [using tautology i-is-below-zero-or-is-zero nothing-is-below-zero]
                      @conclusion-entry-i-is-a-three-cycle |
                        isAThreeCycle(at(s, i))
                        [by rewrite i-is-zero the-zeroth-entry-is-a-three-cycle]
                    }
                  @conclusion-i-below-one-gives |
                    less_than(i, succ(ZERO)) -> isAThreeCycle(at(s, i))
                    [by implies_intro given-i-below-one]
                }
              @every-entry-is-a-three-cycle |
                forall i: Nat; less_than(i, succ(ZERO)) -> isAThreeCycle(at(s, i))
                [by forall_intro generalize-i]
              @the-singleton-run-works |
                (forall i: Nat; less_than(i, succ(ZERO)) -> isAThreeCycle(at(s, i)))
                  and productUpTo(s, succ(ZERO)) = g
                [by and_intro every-entry-is-a-three-cycle the-product-is-the-three-cycle]
              @a-length-exists |
                exists n: Nat;
                  (forall i: Nat; less_than(i, n) -> isAThreeCycle(at(s, i)))
                  and productUpTo(s, n) = g
                [by exists_intro(succ(ZERO)) the-singleton-run-works]
              @conclusion-at-the-sequence |
                isAProductOfThreeCycles(g)
                [by exists_intro(s) a-length-exists]
            }
          @conclusion-is-a-run |
            isAProductOfThreeCycles(g)
            [by exists_elim with-the-sequence]
        }
      @conclusion-for-g |
        isAThreeCycle(g) -> isAProductOfThreeCycles(g)
        [by implies_intro given-a-three-cycle]
    }
  @conclusion |
    forall g: Fn; isAThreeCycle(g) -> isAProductOfThreeCycles(g)
    [by forall_intro generalize-g]
qed

// Lemma 10.8's pair step, in RUN form: a pair of transpositions is a product of 3-cycles.
// The three outcomes of `aPairOfTranspositionsIsAtMostTwoThreeCycles` each become a run —
// the empty one, a singleton, or two singletons joined by closure.
theorem aPairOfTranspositionsIsAProductOfThreeCycles: forall a, b, c, d: Element;
  a != b -> c != d ->
  isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-a-differs-from-b |
                    assume a != b {
                      @a-differs-from-b |
                        a != b
                        [by hypothesis given-a-differs-from-b]
                      @given-c-differs-from-d |
                        assume c != d {
                          @c-differs-from-d |
                            c != d
                            [by hypothesis given-c-differs-from-d]
                          @the-pair-resolves |
                            ((compose(transposition(a, b), transposition(c, d)) = identityFn)
                              or isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                              or (exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                              compose(transposition(a, b), transposition(c, d)) = compose(g, h)))
                            [using specialize aPairOfTranspositionsIsAtMostTwoThreeCycles(a, b, c, d) a-differs-from-b c-differs-from-d]
                          @conclusion-pair-is-a-run |
                            isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
                            case the-pair-resolves {
                              @when-the-pair-is-the-identity |
                                assume compose(transposition(a, b), transposition(c, d)) = identityFn {
                                  @the-pair-is-the-identity |
                                    compose(transposition(a, b), transposition(c, d)) = identityFn
                                    [by hypothesis when-the-pair-is-the-identity]
                                  @the-identity-is-a-run |
                                    isAProductOfThreeCycles(identityFn)
                                    [by cite theIdentityIsAProductOfThreeCycles]
                                  @conclusion-identity-case |
                                    isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
                                    [by rewrite the-pair-is-the-identity the-identity-is-a-run]
                                }
                              @when-the-pair-is-a-three-cycle |
                                assume isAThreeCycle(compose(transposition(a, b), transposition(c, d))) {
                                  @the-pair-is-a-three-cycle |
                                    isAThreeCycle(compose(transposition(a, b), transposition(c, d)))
                                    [by hypothesis when-the-pair-is-a-three-cycle]
                                  @conclusion-three-cycle-case |
                                    isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
                                    [using specialize aThreeCycleIsAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d))) the-pair-is-a-three-cycle]
                                }
                              @when-the-pair-is-two-three-cycles |
                                assume exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                                  compose(transposition(a, b), transposition(c, d)) = compose(g, h) {
                                  @two-three-cycles-exist |
                                    exists g, h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                                      compose(transposition(a, b), transposition(c, d)) = compose(g, h)
                                    [by hypothesis when-the-pair-is-two-three-cycles]
                                  @with-the-first-factor |
                                    unpack g: Fn from two-three-cycles-exist {
                                      @the-second-factor-exists |
                                        exists h: Fn; isAThreeCycle(g) and isAThreeCycle(h) and
                                          compose(transposition(a, b), transposition(c, d)) = compose(g, h)
                                        [by hypothesis with-the-first-factor]
                                      @with-the-second-factor |
                                        unpack h: Fn from the-second-factor-exists {
                                          @the-factor-facts |
                                            isAThreeCycle(g) and isAThreeCycle(h) and
                                              compose(transposition(a, b), transposition(c, d)) = compose(g, h)
                                            [by hypothesis with-the-second-factor]
                                          @both-are-three-cycles |
                                            isAThreeCycle(g) and isAThreeCycle(h)
                                            [by and_elim_left the-factor-facts]
                                          @the-pair-splits |
                                            compose(transposition(a, b), transposition(c, d)) = compose(g, h)
                                            [by and_elim_right the-factor-facts]
                                          @the-first-is-a-three-cycle |
                                            isAThreeCycle(g)
                                            [by and_elim_left both-are-three-cycles]
                                          @the-second-is-a-three-cycle |
                                            isAThreeCycle(h)
                                            [by and_elim_right both-are-three-cycles]
                                          @the-first-is-a-run |
                                            isAProductOfThreeCycles(g)
                                            [using specialize aThreeCycleIsAProductOfThreeCycles(g) the-first-is-a-three-cycle]
                                          @the-second-is-a-run |
                                            isAProductOfThreeCycles(h)
                                            [using specialize aThreeCycleIsAProductOfThreeCycles(h) the-second-is-a-three-cycle]
                                          @the-composite-is-a-run |
                                            isAProductOfThreeCycles(compose(g, h))
                                            [using specialize aProductOfThreeCycleRunsIsAThreeCycleRun(g, h) the-first-is-a-run the-second-is-a-run]
                                          @conclusion-at-the-second-factor |
                                            isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
                                            [by rewrite the-pair-splits the-composite-is-a-run]
                                        }
                                      @conclusion-at-the-first-factor |
                                        isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
                                        [by exists_elim with-the-second-factor]
                                    }
                                  @conclusion-two-three-cycles-case |
                                    isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
                                    [by exists_elim with-the-first-factor]
                                }
                            }
                        }
                      @conclusion-c-differs-gives |
                        c != d -> isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
                        [by implies_intro given-c-differs-from-d]
                    }
                  @conclusion-for-d |
                    a != b -> c != d ->
                      isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
                    [by implies_intro given-a-differs-from-b]
                }
              @discharge-d |
                forall d: Element; a != b -> c != d ->
                  isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
                [by forall_intro generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != b -> c != d ->
              isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != b -> c != d ->
          isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != b -> c != d ->
      isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
    [by forall_intro generalize-a]
qed

// The pair step with the transpositions given ABSTRACTLY (as `isATransposition`) rather than
// as explicit point pairs — which is the form the induction meets, since a transposition run's
// entries are only known to satisfy `isATransposition`. Unpacking both gives the four points.
theorem aPairOfTranspositionEntriesIsAProductOfThreeCycles: forall t, u: Fn;
  isTransposition(t) -> isTransposition(u) -> isAProductOfThreeCycles(compose(t, u))
proof
  @generalize-t |
    fix t: Fn {
      @generalize-u |
        fix u: Fn {
          @given-t-is-a-transposition |
            assume isTransposition(t) {
              @t-is-a-transposition |
                isTransposition(t)
                [by hypothesis given-t-is-a-transposition]
              @given-u-is-a-transposition |
                assume isTransposition(u) {
                  @u-is-a-transposition |
                    isTransposition(u)
                    [by hypothesis given-u-is-a-transposition]
                  @with-the-first-point-of-t |
                    unpack a: Element from t-is-a-transposition {
                      @the-second-point-of-t-exists |
                        exists v: Element; a != v and t = transposition(a, v)
                        [by hypothesis with-the-first-point-of-t]
                      @with-the-second-point-of-t |
                        unpack b: Element from the-second-point-of-t-exists {
                          @the-points-of-t |
                            a != b and t = transposition(a, b)
                            [by hypothesis with-the-second-point-of-t]
                          @a-differs-from-b |
                            a != b
                            [by and_elim_left the-points-of-t]
                          @t-is-that-transposition |
                            t = transposition(a, b)
                            [by and_elim_right the-points-of-t]
                          @with-the-first-point-of-u |
                            unpack c: Element from u-is-a-transposition {
                              @the-second-point-of-u-exists |
                                exists v: Element; c != v and u = transposition(c, v)
                                [by hypothesis with-the-first-point-of-u]
                              @with-the-second-point-of-u |
                                unpack d: Element from the-second-point-of-u-exists {
                                  @the-points-of-u |
                                    c != d and u = transposition(c, d)
                                    [by hypothesis with-the-second-point-of-u]
                                  @c-differs-from-d |
                                    c != d
                                    [by and_elim_left the-points-of-u]
                                  @u-is-that-transposition |
                                    u = transposition(c, d)
                                    [by and_elim_right the-points-of-u]
                                  @the-explicit-pair-is-a-run |
                                    isAProductOfThreeCycles(compose(transposition(a, b), transposition(c, d)))
                                    [using specialize aPairOfTranspositionsIsAProductOfThreeCycles(a, b, c, d) a-differs-from-b c-differs-from-d]
                                  @with-u-restored |
                                    isAProductOfThreeCycles(compose(transposition(a, b), u))
                                    [by rewrite u-is-that-transposition the-explicit-pair-is-a-run]
                                  @conclusion-at-the-points-of-u |
                                    isAProductOfThreeCycles(compose(t, u))
                                    [by rewrite t-is-that-transposition with-u-restored]
                                }
                              @conclusion-at-the-first-point-of-u |
                                isAProductOfThreeCycles(compose(t, u))
                                [by exists_elim with-the-second-point-of-u]
                            }
                          @conclusion-at-the-second-point-of-t |
                            isAProductOfThreeCycles(compose(t, u))
                            [by exists_elim with-the-first-point-of-u]
                        }
                      @conclusion-at-the-first-point-of-t |
                        isAProductOfThreeCycles(compose(t, u))
                        [by exists_elim with-the-second-point-of-t]
                    }
                  @conclusion-pair-is-a-run |
                    isAProductOfThreeCycles(compose(t, u))
                    [by exists_elim with-the-first-point-of-t]
                }
              @conclusion-u-transposition-gives |
                isTransposition(u) -> isAProductOfThreeCycles(compose(t, u))
                [by implies_intro given-u-is-a-transposition]
            }
          @conclusion-for-u |
            isTransposition(t) -> isTransposition(u) -> isAProductOfThreeCycles(compose(t, u))
            [by implies_intro given-t-is-a-transposition]
        }
      @discharge-u |
        forall u: Fn; isTransposition(t) -> isTransposition(u) ->
          isAProductOfThreeCycles(compose(t, u))
        [by forall_intro generalize-u]
    }
  @conclusion |
    forall t, u: Fn;
      isTransposition(t) -> isTransposition(u) -> isAProductOfThreeCycles(compose(t, u))
    [by forall_intro generalize-t]
qed

// mul(TWO, succ(j)) = succ(succ(mul(TWO, j))) — the two-step each induction step takes.
theorem doublingASuccessorAddsTwo: forall j: Nat;
  mul(TWO, succ(j)) = succ(succ(mul(TWO, j)))
proof
  @generalize-j |
    fix j: Nat {
      @conclusion-at-j |
        mul(TWO, succ(j)) = succ(succ(mul(TWO, j)))
        [using arithmetic(peano)]
    }
  @conclusion |
    forall j: Nat; mul(TWO, succ(j)) = succ(succ(mul(TWO, j)))
    [by forall_intro generalize-j]
qed

// LEMMA 10.8's INDUCTION: an EVEN-length run of transpositions has a 3-cycle-run product.
// Induction on the number of PAIRS j, so the length is mul(TWO, j) and each step peels the
// last two entries: productUpTo(s, m+2) = productUpTo(s, m) o (at(s,m) o at(s,m+1)) after
// reassociating, where the prefix is a 3-cycle run by the hypothesis and the pair is one by
// `aPairOfTranspositionEntriesIsAProductOfThreeCycles`. Closure joins them.
theorem anEvenRunOfTranspositionsIsAProductOfThreeCycles: forall s: Seq; forall j: Nat;
  (forall i: Nat; less_than(i, mul(TWO, j)) -> isTransposition(at(s, i))) ->
  isAProductOfThreeCycles(productUpTo(s, mul(TWO, j)))
proof
  @generalize-s |
    fix s: Seq {
      // base case: zero pairs — the empty product is the identity, an empty 3-cycle run.
      @base-case-proof |
        assume forall i: Nat; less_than(i, mul(TWO, ZERO)) -> isTransposition(at(s, i)) {
          @no-pairs-is-no-entries |
            mul(TWO, ZERO) = ZERO
            [using arithmetic(peano)]
          @the-empty-product-is-the-identity |
            productUpTo(s, ZERO) = identityFn
            [using specialize productUpToZero(s)]
          @the-identity-is-a-run |
            isAProductOfThreeCycles(identityFn)
            [by cite theIdentityIsAProductOfThreeCycles]
          @the-empty-product-is-a-run |
            isAProductOfThreeCycles(productUpTo(s, ZERO))
            [by rewrite the-empty-product-is-the-identity the-identity-is-a-run]
          @conclusion-base |
            isAProductOfThreeCycles(productUpTo(s, mul(TWO, ZERO)))
            [by rewrite no-pairs-is-no-entries the-empty-product-is-a-run]
        }
      @base-case |
        (forall i: Nat; less_than(i, mul(TWO, ZERO)) -> isTransposition(at(s, i))) ->
          isAProductOfThreeCycles(productUpTo(s, mul(TWO, ZERO)))
        [by implies_intro base-case-proof]

      // inductive step: j pairs to j+1 pairs.
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume (forall i: Nat; less_than(i, mul(TWO, k)) -> isTransposition(at(s, i))) ->
              isAProductOfThreeCycles(productUpTo(s, mul(TWO, k))) {
              @inductive-hypothesis |
                (forall i: Nat; less_than(i, mul(TWO, k)) -> isTransposition(at(s, i))) ->
                  isAProductOfThreeCycles(productUpTo(s, mul(TWO, k)))
                [by hypothesis given-inductive-hypothesis]
              @given-entries-below-the-longer-run |
                assume forall i: Nat; less_than(i, mul(TWO, succ(k))) -> isTransposition(at(s, i)) {
                  @entries-below-the-longer-run |
                    forall i: Nat; less_than(i, mul(TWO, succ(k))) -> isTransposition(at(s, i))
                    [by hypothesis given-entries-below-the-longer-run]
                  @the-longer-run-is-two-more |
                    mul(TWO, succ(k)) = succ(succ(mul(TWO, k)))
                    [using specialize doublingASuccessorAddsTwo(k)]
                  @entries-below-two-more |
                    forall i: Nat; less_than(i, succ(succ(mul(TWO, k)))) -> isTransposition(at(s, i))
                    [by rewrite the-longer-run-is-two-more entries-below-the-longer-run]

                  // the prefix of mul(TWO,k) entries is a 3-cycle run
                  @generalize-i |
                    fix i: Nat {
                      @given-i-below-the-shorter-run |
                        assume less_than(i, mul(TWO, k)) {
                          @i-below-the-shorter-run |
                            less_than(i, mul(TWO, k))
                            [by hypothesis given-i-below-the-shorter-run]
                          @i-below-one-more |
                            less_than(i, succ(mul(TWO, k)))
                            [using specialize lessThanSuccRight(i, mul(TWO, k)) i-below-the-shorter-run]
                          @i-below-two-more |
                            less_than(i, succ(succ(mul(TWO, k))))
                            [using specialize lessThanSuccRight(i, succ(mul(TWO, k))) i-below-one-more]
                          @conclusion-entry-i-is-a-transposition |
                            isTransposition(at(s, i))
                            [using specialize entries-below-two-more(i) i-below-two-more]
                        }
                      @conclusion-i-below-shorter-gives |
                        less_than(i, mul(TWO, k)) -> isTransposition(at(s, i))
                        [by implies_intro given-i-below-the-shorter-run]
                    }
                  @entries-below-the-shorter-run |
                    forall i: Nat; less_than(i, mul(TWO, k)) -> isTransposition(at(s, i))
                    [by forall_intro generalize-i]
                  @the-prefix-is-a-run |
                    isAProductOfThreeCycles(productUpTo(s, mul(TWO, k)))
                    [by modus_ponens inductive-hypothesis entries-below-the-shorter-run]

                  // the two peeled entries are transpositions
                  @the-shorter-run-is-in-range |
                    less_than(mul(TWO, k), succ(mul(TWO, k)))
                    [using specialize lessThanSelf(mul(TWO, k))]
                  @the-shorter-run-is-below-two-more |
                    less_than(mul(TWO, k), succ(succ(mul(TWO, k))))
                    [using specialize lessThanSuccRight(mul(TWO, k), succ(mul(TWO, k))) the-shorter-run-is-in-range]
                  @the-first-peeled-entry-is-a-transposition |
                    isTransposition(at(s, mul(TWO, k)))
                    [using specialize entries-below-two-more(mul(TWO, k)) the-shorter-run-is-below-two-more]
                  @the-next-index-is-in-range |
                    less_than(succ(mul(TWO, k)), succ(succ(mul(TWO, k))))
                    [using specialize lessThanSelf(succ(mul(TWO, k)))]
                  @the-second-peeled-entry-is-a-transposition |
                    isTransposition(at(s, succ(mul(TWO, k))))
                    [using specialize entries-below-two-more(succ(mul(TWO, k))) the-next-index-is-in-range]
                  @the-peeled-pair-is-a-run |
                    isAProductOfThreeCycles(compose(at(s, mul(TWO, k)), at(s, succ(mul(TWO, k)))))
                    [using specialize aPairOfTranspositionEntriesIsAProductOfThreeCycles(at(s, mul(TWO, k)), at(s, succ(mul(TWO, k)))) the-first-peeled-entry-is-a-transposition the-second-peeled-entry-is-a-transposition]

                  // the product splits as prefix o (pair), after reassociating
                  @the-product-peels-once |
                    productUpTo(s, succ(mul(TWO, k))) = compose(productUpTo(s, mul(TWO, k)), at(s, mul(TWO, k)))
                    [using specialize productUpToSucc(s, mul(TWO, k))]
                  @the-product-peels-twice |
                    productUpTo(s, succ(succ(mul(TWO, k)))) =
                      compose(productUpTo(s, succ(mul(TWO, k))), at(s, succ(mul(TWO, k))))
                    [using specialize productUpToSucc(s, succ(mul(TWO, k)))]
                  @the-product-is-the-nested-composite |
                    productUpTo(s, succ(succ(mul(TWO, k)))) =
                      compose(compose(productUpTo(s, mul(TWO, k)), at(s, mul(TWO, k))), at(s, succ(mul(TWO, k))))
                    [using chain the-product-peels-twice the-product-peels-once]
                  @the-composite-reassociates |
                    compose(compose(productUpTo(s, mul(TWO, k)), at(s, mul(TWO, k))), at(s, succ(mul(TWO, k)))) =
                      compose(productUpTo(s, mul(TWO, k)), compose(at(s, mul(TWO, k)), at(s, succ(mul(TWO, k)))))
                    [using assoc(composeAssoc)]
                  @the-product-splits |
                    productUpTo(s, succ(succ(mul(TWO, k)))) =
                      compose(productUpTo(s, mul(TWO, k)), compose(at(s, mul(TWO, k)), at(s, succ(mul(TWO, k)))))
                    [using chain the-product-is-the-nested-composite the-composite-reassociates]
                  @the-split-is-a-run |
                    isAProductOfThreeCycles(compose(productUpTo(s, mul(TWO, k)), compose(at(s, mul(TWO, k)), at(s, succ(mul(TWO, k))))))
                    [using specialize aProductOfThreeCycleRunsIsAThreeCycleRun(productUpTo(s, mul(TWO, k)), compose(at(s, mul(TWO, k)), at(s, succ(mul(TWO, k))))) the-prefix-is-a-run the-peeled-pair-is-a-run]
                  @the-longer-product-is-a-run |
                    isAProductOfThreeCycles(productUpTo(s, succ(succ(mul(TWO, k)))))
                    [by rewrite the-product-splits the-split-is-a-run]
                  @conclusion-longer-run-is-a-run |
                    isAProductOfThreeCycles(productUpTo(s, mul(TWO, succ(k))))
                    [by rewrite the-longer-run-is-two-more the-longer-product-is-a-run]
                }
              @conclusion-implication-at-succ-k |
                (forall i: Nat; less_than(i, mul(TWO, succ(k))) -> isTransposition(at(s, i))) ->
                  isAProductOfThreeCycles(productUpTo(s, mul(TWO, succ(k))))
                [by implies_intro given-entries-below-the-longer-run]
            }
          @conclusion-induction-step-at-k |
            ((forall i: Nat; less_than(i, mul(TWO, k)) -> isTransposition(at(s, i))) ->
              isAProductOfThreeCycles(productUpTo(s, mul(TWO, k)))) ->
              ((forall i: Nat; less_than(i, mul(TWO, succ(k))) -> isTransposition(at(s, i))) ->
              isAProductOfThreeCycles(productUpTo(s, mul(TWO, succ(k)))))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          ((forall i: Nat; less_than(i, mul(TWO, k)) -> isTransposition(at(s, i))) ->
          isAProductOfThreeCycles(productUpTo(s, mul(TWO, k)))) ->
          ((forall i: Nat; less_than(i, mul(TWO, succ(k))) -> isTransposition(at(s, i))) ->
          isAProductOfThreeCycles(productUpTo(s, mul(TWO, succ(k)))))
        [by forall_intro induction-step]
      @conclusion-for-s |
        forall j: Nat;
          (forall i: Nat; less_than(i, mul(TWO, j)) -> isTransposition(at(s, i))) ->
          isAProductOfThreeCycles(productUpTo(s, mul(TWO, j)))
        [using instantiation induction((fun j: Nat => (forall i: Nat; less_than(i, mul(TWO, j)) -> isTransposition(at(s, i))) -> isAProductOfThreeCycles(productUpTo(s, mul(TWO, j))))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Seq; forall j: Nat;
      (forall i: Nat; less_than(i, mul(TWO, j)) -> isTransposition(at(s, i))) ->
      isAProductOfThreeCycles(productUpTo(s, mul(TWO, j)))
    [by forall_intro generalize-s]
qed

// LEMMA 10.8 (Judson): the alternating group is generated by 3-cycles. An even permutation
// has a transposition factorization of EVEN length (`isEvenPermDef`), so the length is
// mul(TWO, j) for some j, and the induction above turns that run into a 3-cycle run.
theorem everyEvenPermutationIsAProductOfThreeCycles: forall g: Fn;
  inAlternating(g) -> isAProductOfThreeCycles(g)
proof
  @generalize-g |
    fix g: Fn {
      @given-in-the-alternating-group |
        assume inAlternating(g) {
          @in-the-alternating-group |
            inAlternating(g)
            [by hypothesis given-in-the-alternating-group]
          @membership-unfolds |
            inAlternating(g) iff (invertible(g) and isEvenPerm(g))
            [using specialize inAlternatingDef(g)]
          @g-is-even |
            isEvenPerm(g)
            [using tautology membership-unfolds in-the-alternating-group]
          @evenness-unfolds |
            isEvenPerm(g) iff (exists s: Seq; exists m: Nat;
              allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m))
            [using specialize isEvenPermDef(g)]
          @a-factorization-exists |
            exists s: Seq; exists m: Nat;
              allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
            [using tautology evenness-unfolds g-is-even]
          @with-the-factorization |
            unpack s: Seq from a-factorization-exists {
              @a-length-exists |
                exists m: Nat;
                  allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                [by hypothesis with-the-factorization]
              @with-the-length |
                unpack m: Nat from a-length-exists {
                  @the-factorization-facts |
                    allTranspositions(s, m) and productUpTo(s, m) = g and divides(TWO, m)
                    [by hypothesis with-the-length]
                  @the-entries-and-the-product |
                    allTranspositions(s, m) and productUpTo(s, m) = g
                    [by and_elim_left the-factorization-facts]
                  @the-length-is-even |
                    divides(TWO, m)
                    [by and_elim_right the-factorization-facts]
                  @the-entries-are-transpositions |
                    allTranspositions(s, m)
                    [by and_elim_left the-entries-and-the-product]
                  @the-product-is-g |
                    productUpTo(s, m) = g
                    [by and_elim_right the-entries-and-the-product]
                  @the-entries-unfold |
                    allTranspositions(s, m) iff
                      (forall i: Nat; less_than(i, m) -> isTransposition(at(s, i)))
                    [using specialize allTranspositionsDef(s, m)]
                  @every-entry-is-a-transposition |
                    forall i: Nat; less_than(i, m) -> isTransposition(at(s, i))
                    [using tautology the-entries-unfold the-entries-are-transpositions]
                  // `divides` is transparent: divides(TWO, m) IS exists k; m = mul(TWO, k).
                  @with-the-half-length |
                    unpack j: Nat from the-length-is-even {
                      @the-length-is-a-double |
                        m = mul(TWO, j)
                        [by hypothesis with-the-half-length]
                      @every-entry-below-the-double-is-a-transposition |
                        forall i: Nat; less_than(i, mul(TWO, j)) -> isTransposition(at(s, i))
                        [by rewrite the-length-is-a-double every-entry-is-a-transposition]
                      @the-double-product-is-a-run |
                        isAProductOfThreeCycles(productUpTo(s, mul(TWO, j)))
                        [using specialize anEvenRunOfTranspositionsIsAProductOfThreeCycles(s, j) every-entry-below-the-double-is-a-transposition]
                      @the-product-is-a-run |
                        isAProductOfThreeCycles(productUpTo(s, m))
                        [by rewrite the-length-is-a-double the-double-product-is-a-run]
                      @conclusion-at-the-half-length |
                        isAProductOfThreeCycles(g)
                        [by rewrite the-product-is-g the-product-is-a-run]
                    }
                  @conclusion-at-the-length |
                    isAProductOfThreeCycles(g)
                    [by exists_elim with-the-half-length]
                }
              @conclusion-at-the-factorization |
                isAProductOfThreeCycles(g)
                [by exists_elim with-the-length]
            }
          @conclusion-is-a-run |
            isAProductOfThreeCycles(g)
            [by exists_elim with-the-factorization]
        }
      @conclusion-for-g |
        inAlternating(g) -> isAProductOfThreeCycles(g)
        [by implies_intro given-in-the-alternating-group]
    }
  @conclusion |
    forall g: Fn; inAlternating(g) -> isAProductOfThreeCycles(g)
    [by forall_intro generalize-g]
qed
