// std/permutation/cycle.b4m — CYCLE NOTATION: (a₀ a₁ … a_k) as a permutation.
//
// A cycle names a permutation by a finite LIST of points: it sends each listed point to the
// next, the last back to the first, and fixes every point not listed. The list is a `Points`
// sequence read through `at`; `distinct(s, n)` says its first n entries are pairwise
// different, which is what makes the description consistent.
//
// The cycle is DEFINED by Judson's factorization into transpositions,
//     (a₀ a₁ … a_k) = (a₀ a_k) ∘ (a₀ a₁ … a_{k-1}),      (a₀) = identity,
// rather than by clauses on its action: the recursion is consistent for ANY list (it is a
// composite of transpositions), makes "a cycle is a permutation" a one-line induction, and
// turns the textbook's description of the action — advance, wrap around, fix the rest —
// into THEOREMS (proved below, under distinctness). The factorization the book proves as
// its Proposition is then the definition read off.
//
// (The two clauses are axioms rather than a definition block: a block's clause variable
// takes the first parameter's sort, and a bare constant on a clause's right-hand side is
// read as a clause variable — see CHAPTER5-PAINPOINTS.)

import permutation <<< "std/permutation.b4m"
import function <<< "std/function.b4m"
import function_invertible <<< "std/function/invertible.b4m"
import element <<< "std/element.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

sort Element = element.Element
sort Fn = function.Fn
const identityFn = function.identityFn
func apply = function.apply
func compose = function.compose
pred invertible = function.invertible
fact composeApply = function.composeApply
fact identityApply = function.identityApply
func transposition = permutation.transposition
fact transpositionAtFirst = permutation.transpositionAtFirst
fact transpositionAtSecond = permutation.transpositionAtSecond
fact transpositionElsewhere = permutation.transpositionElsewhere
fact transpositionIsAPermutation = permutation.transpositionIsAPermutation
fact identityIsAPermutation = permutation.identityIsAPermutation
fact composeIsAPermutation = permutation.composeIsAPermutation
fact composeIdentityRight = function_invertible.composeIdentityRight
fact composeIdentityLeft = function_invertible.composeIdentityLeft
fact composeAssoc = function_invertible.composeAssoc
fact funcExtensionality = function.funcExtensionality
func inverseFn = function.inverse
fact inverseLeft = function.inverseLeft
fact inverseRight = function.inverseRight

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
pred less_than = peano.less_than
fact induction = peano.induction
fact succNotZero = peano.succNotZero
fact addZeroLeft = peano.addZeroLeft
fact lessThanIntro = peano_order.lessThanIntro
fact lessThanSelf = peano_order.lessThanSelf
fact lessThanSuccRight = peano_order.lessThanSuccRight
fact lessThanSuccSplit = peano_order.lessThanSuccSplit
fact lessThanIrreflexive = peano_order.lessThanIrreflexive
fact notLessThanZero = peano_order.notLessThanZero

// -- lists of points ----------------------------------------------------------------------

// A finite list of points, read by index, with the list-BUILDING postulates of
// std/sequence.b4m stated for points. (A fresh sort inherits no postulates; these are what
// lets a list be built from an orbit.)
sort Points
func at(s: Points, i: Nat) => Element

// the one-element list [x]
axiom pointsSingleton: forall x: Element; exists s: Points; at(s, ZERO) = x

// the prepend x :: s: head x, tail s shifted up by one
axiom pointsPrepend: forall x: Element; forall s: Points;
  exists u: Points; at(u, ZERO) = x and (forall i: Nat; at(u, succ(i)) = at(s, i))

// CONCATENATION: the first j entries of s followed by the first k of t. The group twin is
// `std/group/sequence.b4m`'s `seqConcat`, which additionally states how the PRODUCT over the
// join splits; `Points` carries no fold, so the two entry clauses are the whole content.
//
// Why this is needed and prepend is not enough: prepend only ever adds at the FRONT, so a list
// cannot be grown from its beginning and a list's TAIL is not reachable from an arbitrary list.
// Any construction that walks UP an index range — "the list whose i-th entry is f(sᵢ)", which
// is what conjugating a cycle needs — is unavailable without an append. See
// CHAPTER6-PAINPOINTS.
axiom pointsConcat: forall s: Points; forall t: Points; forall j: Nat; forall k: Nat;
  exists u: Points;
  (forall i: Nat; less_than(i, j) -> at(u, i) = at(s, i))
  and (forall i: Nat; less_than(i, k) -> at(u, add(j, i)) = at(t, i))

// the first n entries are pairwise different
define distinct(s, n) =
  forall i: Nat; forall j: Nat; less_than(i, n) -> less_than(j, n) -> at(s, i) = at(s, j) -> i = j

// x is none of the first n entries
define avoids(x, s, n) = forall i: Nat; less_than(i, n) -> x != at(s, i)

// -- the cycle ----------------------------------------------------------------------------

// (a₀ … a_k), by Judson's factorization; cycle(s, ZERO) is the identity (an empty cycle),
// cycle(s, succ(ZERO)) = (a₀ a₀) is the identity too (a one-cycle), and cycle(s, succ(succ(ZERO)))
// is the transposition (a₀ a₁).
func cycle(s: Points, k: Nat) => Fn
axiom cycleZero: forall s: Points; cycle(s, ZERO) = identityFn
axiom cycleSucc: forall s: Points; forall k: Nat;
  cycle(s, succ(k)) = compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k))

// -- arithmetic and list helpers ------------------------------------------------------------

fact zeroBelowSucc = peano_order.zeroBelowSucc

// Distinctness and avoidance of a longer prefix pass to a shorter one.
theorem distinctPrefix: forall s: Points; forall n: Nat; distinct(s, succ(n)) -> distinct(s, n)
proof
  @generalize-s |
    fix s: Points {
      @generalize-n |
        fix n: Nat {
          @given-distinct |
            assume distinct(s, succ(n)) {
              @distinct-longer |
                forall i: Nat; forall j: Nat; less_than(i, succ(n)) -> less_than(j, succ(n)) -> at(s, i) = at(s, j) -> i = j
                [by hypothesis given-distinct]
              @generalize-i |
                fix i: Nat {
                  @generalize-j |
                    fix j: Nat {
                      @given-i |
                        assume less_than(i, n) {
                          @given-j |
                            assume less_than(j, n) {
                              @given-equal |
                                assume at(s, i) = at(s, j) {
                                  @i-below-n |
                                    less_than(i, n)
                                    [by hypothesis given-i]
                                  @j-below-n |
                                    less_than(j, n)
                                    [by hypothesis given-j]
                                  @entries-equal |
                                    at(s, i) = at(s, j)
                                    [by hypothesis given-equal]
                                  @i-below-succ-n |
                                    less_than(i, succ(n))
                                    [using specialize lessThanSuccRight(i, n) i-below-n]
                                  @j-below-succ-n |
                                    less_than(j, succ(n))
                                    [using specialize lessThanSuccRight(j, n) j-below-n]
                                  @conclusion-same-index |
                                    i = j
                                    [using specialize distinct-longer(i, j) i-below-succ-n j-below-succ-n entries-equal]
                                }
                              @conclusion-equal |
                                at(s, i) = at(s, j) -> i = j
                                [by discharge given-equal]
                            }
                          @conclusion-j |
                            less_than(j, n) -> at(s, i) = at(s, j) -> i = j
                            [by discharge given-j]
                        }
                      @conclusion-i |
                        less_than(i, n) -> less_than(j, n) -> at(s, i) = at(s, j) -> i = j
                        [by discharge given-i]
                    }
                  @discharge-j |
                    forall j: Nat; less_than(i, n) -> less_than(j, n) -> at(s, i) = at(s, j) -> i = j
                    [by generalize generalize-j]
                }
              @conclusion-distinct-shorter |
                distinct(s, n)
                [by generalize generalize-i]
            }
          @conclusion-implication |
            distinct(s, succ(n)) -> distinct(s, n)
            [by discharge given-distinct]
        }
      @discharge-n |
        forall n: Nat; distinct(s, succ(n)) -> distinct(s, n)
        [by generalize generalize-n]
    }
  @conclusion |
    forall s: Points; forall n: Nat; distinct(s, succ(n)) -> distinct(s, n)
    [by generalize generalize-s]
qed

theorem avoidsPrefix: forall x: Element; forall s: Points; forall n: Nat; avoids(x, s, succ(n)) -> avoids(x, s, n)
proof
  @generalize-x |
    fix x: Element {
      @generalize-s |
        fix s: Points {
          @generalize-n |
            fix n: Nat {
              @given-avoids |
                assume avoids(x, s, succ(n)) {
                  @avoids-longer |
                    forall i: Nat; less_than(i, succ(n)) -> x != at(s, i)
                    [by hypothesis given-avoids]
                  @generalize-i |
                    fix i: Nat {
                      @given-i |
                        assume less_than(i, n) {
                          @i-below-n |
                            less_than(i, n)
                            [by hypothesis given-i]
                          @i-below-succ-n |
                            less_than(i, succ(n))
                            [using specialize lessThanSuccRight(i, n) i-below-n]
                          @conclusion-differs |
                            x != at(s, i)
                            [using specialize avoids-longer(i) i-below-succ-n]
                        }
                      @conclusion-i |
                        less_than(i, n) -> x != at(s, i)
                        [by discharge given-i]
                    }
                  @conclusion-avoids-shorter |
                    avoids(x, s, n)
                    [by generalize generalize-i]
                }
              @conclusion-implication |
                avoids(x, s, succ(n)) -> avoids(x, s, n)
                [by discharge given-avoids]
            }
          @discharge-n |
            forall n: Nat; avoids(x, s, succ(n)) -> avoids(x, s, n)
            [by generalize generalize-n]
        }
      @discharge-s |
        forall s: Points; forall n: Nat; avoids(x, s, succ(n)) -> avoids(x, s, n)
        [by generalize generalize-s]
    }
  @conclusion |
    forall x: Element; forall s: Points; forall n: Nat; avoids(x, s, succ(n)) -> avoids(x, s, n)
    [by generalize generalize-x]
qed

// Distinct entries at different indices differ.
theorem distinctEntriesDiffer: forall s: Points; forall n: Nat; forall i: Nat; forall j: Nat;
  distinct(s, n) -> less_than(i, n) -> less_than(j, n) -> i != j -> at(s, i) != at(s, j)
proof
  @generalize-s |
    fix s: Points {
      @generalize-n |
        fix n: Nat {
          @generalize-i |
            fix i: Nat {
              @generalize-j |
                fix j: Nat {
                  @given-distinct |
                    assume distinct(s, n) {
                      @given-i |
                        assume less_than(i, n) {
                          @given-j |
                            assume less_than(j, n) {
                              @given-different |
                                assume i != j {
                                  @distinct-entries |
                                    forall i2: Nat; forall j2: Nat; less_than(i2, n) -> less_than(j2, n) -> at(s, i2) = at(s, j2) -> i2 = j2
                                    [by hypothesis given-distinct]
                                  @i-below-n |
                                    less_than(i, n)
                                    [by hypothesis given-i]
                                  @j-below-n |
                                    less_than(j, n)
                                    [by hypothesis given-j]
                                  @indices-differ |
                                    i != j
                                    [by hypothesis given-different]
                                  @suppose-entries-equal |
                                    assume at(s, i) = at(s, j) {
                                      @entries-equal |
                                        at(s, i) = at(s, j)
                                        [by hypothesis suppose-entries-equal]
                                      @indices-equal |
                                        i = j
                                        [using specialize distinct-entries(i, j) i-below-n j-below-n entries-equal]
                                    }
                                  @conclusion-entries-differ |
                                    at(s, i) != at(s, j)
                                    [by contradiction suppose-entries-equal indices-equal indices-differ]
                                }
                              @conclusion-different |
                                i != j -> at(s, i) != at(s, j)
                                [by discharge given-different]
                            }
                          @conclusion-j |
                            less_than(j, n) -> i != j -> at(s, i) != at(s, j)
                            [by discharge given-j]
                        }
                      @conclusion-i |
                        less_than(i, n) -> less_than(j, n) -> i != j -> at(s, i) != at(s, j)
                        [by discharge given-i]
                    }
                  @conclusion-distinct |
                    distinct(s, n) -> less_than(i, n) -> less_than(j, n) -> i != j -> at(s, i) != at(s, j)
                    [by discharge given-distinct]
                }
              @discharge-j |
                forall j: Nat; distinct(s, n) -> less_than(i, n) -> less_than(j, n) -> i != j -> at(s, i) != at(s, j)
                [by generalize generalize-j]
            }
          @discharge-i |
            forall i: Nat; forall j: Nat; distinct(s, n) -> less_than(i, n) -> less_than(j, n) -> i != j -> at(s, i) != at(s, j)
            [by generalize generalize-i]
        }
      @discharge-n |
        forall n: Nat; forall i: Nat; forall j: Nat; distinct(s, n) -> less_than(i, n) -> less_than(j, n) -> i != j -> at(s, i) != at(s, j)
        [by generalize generalize-n]
    }
  @conclusion |
    forall s: Points; forall n: Nat; forall i: Nat; forall j: Nat;
      distinct(s, n) -> less_than(i, n) -> less_than(j, n) -> i != j -> at(s, i) != at(s, j)
    [by generalize generalize-s]
qed

// -- a cycle is a permutation ------------------------------------------------------------------

// Induction on the length: the empty cycle is the identity, and each step composes a
// transposition with a permutation.
theorem cycleIsAPermutation: forall s: Points; forall k: Nat; invertible(cycle(s, k))
proof
  @generalize-s |
    fix s: Points {
      @empty-cycle-is-identity |
        cycle(s, ZERO) = identityFn
        [using specialize cycleZero(s)]
      @identity-is-a-permutation |
        invertible(identityFn)
        [by cite identityIsAPermutation]
      @base-case |
        invertible(cycle(s, ZERO))
        [by rewrite empty-cycle-is-identity identity-is-a-permutation]
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume invertible(cycle(s, k)) {
              @inductive-hypothesis |
                invertible(cycle(s, k))
                [by hypothesis given-inductive-hypothesis]
              @transposition-is-a-permutation |
                invertible(transposition(at(s, ZERO), at(s, k)))
                [using specialize transpositionIsAPermutation(at(s, ZERO), at(s, k))]
              @composite-is-a-permutation |
                invertible(compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k)))
                [using specialize composeIsAPermutation(transposition(at(s, ZERO), at(s, k)), cycle(s, k)) transposition-is-a-permutation inductive-hypothesis]
              @longer-cycle-unfolds |
                cycle(s, succ(k)) = compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k))
                [using specialize cycleSucc(s, k)]
              @conclusion-longer-is-a-permutation |
                invertible(cycle(s, succ(k)))
                [by rewrite longer-cycle-unfolds composite-is-a-permutation]
            }
          @induction-step-at-k |
            invertible(cycle(s, k)) -> invertible(cycle(s, succ(k)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; invertible(cycle(s, k)) -> invertible(cycle(s, succ(k)))
        [by generalize induction-step]
      @conclusion-for-all-k |
        forall k: Nat; invertible(cycle(s, k))
        [using instantiation induction((fun k: Nat => invertible(cycle(s, k)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Points; forall k: Nat; invertible(cycle(s, k))
    [by generalize generalize-s]
qed

// -- the action: fix the rest, wrap around, advance --------------------------------------------

// A cycle FIXES every point it does not list. Induction on the length: the empty cycle is
// the identity; a longer cycle is a transposition of two listed points after a shorter cycle,
// and neither moves an unlisted point.
theorem cycleFixesTheUnlisted: forall s: Points; forall k: Nat; forall x: Element;
  avoids(x, s, k) -> apply(cycle(s, k), x) = x
proof
  @generalize-s |
    fix s: Points {
      // base case
      @base-case-proof |
        fix x: Element {
          @given-avoids-nothing |
            assume avoids(x, s, ZERO) {
              @empty-cycle-is-identity |
                cycle(s, ZERO) = identityFn
                [using specialize cycleZero(s)]
              @identity-fixes-x |
                apply(identityFn, x) = x
                [using specialize identityApply(x)]
              @conclusion-base-fixes |
                apply(cycle(s, ZERO), x) = x
                [by rewrite empty-cycle-is-identity identity-fixes-x]
            }
          @conclusion-base-implication |
            avoids(x, s, ZERO) -> apply(cycle(s, ZERO), x) = x
            [by discharge given-avoids-nothing]
        }
      @base-case |
        forall x: Element; avoids(x, s, ZERO) -> apply(cycle(s, ZERO), x) = x
        [by generalize base-case-proof]

      // inductive step
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume forall x: Element; avoids(x, s, k) -> apply(cycle(s, k), x) = x {
              @inductive-hypothesis |
                forall x: Element; avoids(x, s, k) -> apply(cycle(s, k), x) = x
                [by hypothesis given-inductive-hypothesis]
              @generalize-x |
                fix x: Element {
                  @given-avoids |
                    assume avoids(x, s, succ(k)) {
                      @avoids-longer |
                        forall i: Nat; less_than(i, succ(k)) -> x != at(s, i)
                        [by hypothesis given-avoids]
                      @avoids-shorter |
                        avoids(x, s, k)
                        [using specialize avoidsPrefix(x, s, k) avoids-longer]
                      @shorter-cycle-fixes-x |
                        apply(cycle(s, k), x) = x
                        [using specialize inductive-hypothesis(x) avoids-shorter]
                      @zero-listed |
                        less_than(ZERO, succ(k))
                        [using specialize zeroBelowSucc(k)]
                      @k-listed |
                        less_than(k, succ(k))
                        [using specialize lessThanSelf(k)]
                      @x-is-not-first |
                        x != at(s, ZERO)
                        [using specialize avoids-longer(ZERO) zero-listed]
                      @x-is-not-last |
                        x != at(s, k)
                        [using specialize avoids-longer(k) k-listed]
                      @transposition-fixes-x |
                        apply(transposition(at(s, ZERO), at(s, k)), x) = x
                        [using specialize transpositionElsewhere(at(s, ZERO), at(s, k), x) x-is-not-first x-is-not-last]
                      @longer-cycle-unfolds |
                        cycle(s, succ(k)) = compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k))
                        [using specialize cycleSucc(s, k)]
                      @composite-at-x |
                        apply(compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k)), x) = apply(transposition(at(s, ZERO), at(s, k)), apply(cycle(s, k), x))
                        [using specialize composeApply(transposition(at(s, ZERO), at(s, k)), cycle(s, k), x)]
                      @composite-is-transposition-at-x |
                        apply(compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k)), x) = apply(transposition(at(s, ZERO), at(s, k)), x)
                        [by rewrite shorter-cycle-fixes-x composite-at-x]
                      @composite-fixes-x |
                        apply(compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k)), x) = x
                        [using chain composite-is-transposition-at-x transposition-fixes-x]
                      @conclusion-longer-fixes-x |
                        apply(cycle(s, succ(k)), x) = x
                        [by rewrite longer-cycle-unfolds composite-fixes-x]
                    }
                  @conclusion-step-implication |
                    avoids(x, s, succ(k)) -> apply(cycle(s, succ(k)), x) = x
                    [by discharge given-avoids]
                }
              @discharge-x |
                forall x: Element; avoids(x, s, succ(k)) -> apply(cycle(s, succ(k)), x) = x
                [by generalize generalize-x]
            }
          @induction-step-at-k |
            (forall x: Element; avoids(x, s, k) -> apply(cycle(s, k), x) = x) -> (forall x: Element; avoids(x, s, succ(k)) -> apply(cycle(s, succ(k)), x) = x)
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; (forall x: Element; avoids(x, s, k) -> apply(cycle(s, k), x) = x) -> (forall x: Element; avoids(x, s, succ(k)) -> apply(cycle(s, succ(k)), x) = x)
        [by generalize induction-step]
      @conclusion-for-all-k |
        forall k: Nat; forall x: Element; avoids(x, s, k) -> apply(cycle(s, k), x) = x
        [using instantiation induction((fun k: Nat => forall x: Element; avoids(x, s, k) -> apply(cycle(s, k), x) = x)) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Points; forall k: Nat; forall x: Element; avoids(x, s, k) -> apply(cycle(s, k), x) = x
    [by generalize generalize-s]
qed

// The last listed point is none of the earlier ones (distinctness), so the shorter cycle
// fixes it and the transposition (a₀ a_k) sends it to a₀.
theorem lastEntryAvoidsTheRest: forall s: Points; forall k: Nat;
  distinct(s, succ(k)) -> avoids(at(s, k), s, k)
proof
  @generalize-s |
    fix s: Points {
      @generalize-k |
        fix k: Nat {
          @given-distinct |
            assume distinct(s, succ(k)) {
              @distinct-entries |
                distinct(s, succ(k))
                [by hypothesis given-distinct]
              @k-listed |
                less_than(k, succ(k))
                [using specialize lessThanSelf(k)]
              @generalize-i |
                fix i: Nat {
                  @given-i |
                    assume less_than(i, k) {
                      @i-below-k |
                        less_than(i, k)
                        [by hypothesis given-i]
                      @i-listed |
                        less_than(i, succ(k))
                        [using specialize lessThanSuccRight(i, k) i-below-k]
                      @suppose-same-index |
                        assume k = i {
                          @k-is-i |
                            k = i
                            [by hypothesis suppose-same-index]
                          @k-below-k |
                            less_than(k, k)
                            [by rewrite k-is-i i-below-k]
                        }
                      @k-not-below-k |
                        not less_than(k, k)
                        [using specialize lessThanIrreflexive(k)]
                      @indices-differ |
                        k != i
                        [by contradiction suppose-same-index k-below-k k-not-below-k]
                      @conclusion-entries-differ |
                        at(s, k) != at(s, i)
                        [using specialize distinctEntriesDiffer(s, succ(k), k, i) distinct-entries k-listed i-listed indices-differ]
                    }
                  @conclusion-i |
                    less_than(i, k) -> at(s, k) != at(s, i)
                    [by discharge given-i]
                }
              @conclusion-avoids |
                avoids(at(s, k), s, k)
                [by generalize generalize-i]
            }
          @conclusion-implication |
            distinct(s, succ(k)) -> avoids(at(s, k), s, k)
            [by discharge given-distinct]
        }
      @discharge-k |
        forall k: Nat; distinct(s, succ(k)) -> avoids(at(s, k), s, k)
        [by generalize generalize-k]
    }
  @conclusion |
    forall s: Points; forall k: Nat; distinct(s, succ(k)) -> avoids(at(s, k), s, k)
    [by generalize generalize-s]
qed

theorem cycleWrapsAround: forall s: Points; forall k: Nat;
  distinct(s, succ(k)) -> apply(cycle(s, succ(k)), at(s, k)) = at(s, ZERO)
proof
  @generalize-s |
    fix s: Points {
      @generalize-k |
        fix k: Nat {
          @given-distinct |
            assume distinct(s, succ(k)) {
              @distinct-entries |
                distinct(s, succ(k))
                [by hypothesis given-distinct]
              @last-avoids-the-rest |
                avoids(at(s, k), s, k)
                [using specialize lastEntryAvoidsTheRest(s, k) distinct-entries]
              @shorter-cycle-fixes-last |
                apply(cycle(s, k), at(s, k)) = at(s, k)
                [using specialize cycleFixesTheUnlisted(s, k, at(s, k)) last-avoids-the-rest]
              @transposition-sends-last-to-first |
                apply(transposition(at(s, ZERO), at(s, k)), at(s, k)) = at(s, ZERO)
                [using specialize transpositionAtSecond(at(s, ZERO), at(s, k))]
              @longer-cycle-unfolds |
                cycle(s, succ(k)) = compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k))
                [using specialize cycleSucc(s, k)]
              @composite-at-last |
                apply(compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k)), at(s, k)) = apply(transposition(at(s, ZERO), at(s, k)), apply(cycle(s, k), at(s, k)))
                [using specialize composeApply(transposition(at(s, ZERO), at(s, k)), cycle(s, k), at(s, k))]
              @composite-is-transposition-at-last |
                apply(compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k)), at(s, k)) = apply(transposition(at(s, ZERO), at(s, k)), at(s, k))
                [by rewrite shorter-cycle-fixes-last composite-at-last]
              @composite-sends-last-to-first |
                apply(compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k)), at(s, k)) = at(s, ZERO)
                [using chain composite-is-transposition-at-last transposition-sends-last-to-first]
              @conclusion-wraps |
                apply(cycle(s, succ(k)), at(s, k)) = at(s, ZERO)
                [by rewrite longer-cycle-unfolds composite-sends-last-to-first]
            }
          @conclusion-implication |
            distinct(s, succ(k)) -> apply(cycle(s, succ(k)), at(s, k)) = at(s, ZERO)
            [by discharge given-distinct]
        }
      @discharge-k |
        forall k: Nat; distinct(s, succ(k)) -> apply(cycle(s, succ(k)), at(s, k)) = at(s, ZERO)
        [by generalize generalize-k]
    }
  @conclusion |
    forall s: Points; forall k: Nat; distinct(s, succ(k)) -> apply(cycle(s, succ(k)), at(s, k)) = at(s, ZERO)
    [by generalize generalize-s]
qed

// A cycle ADVANCES each listed point but the last to the next. Induction on the length:
// for a point before the previous last, the shorter cycle already advances it and the new
// transposition (a₀ a_k) does not touch its image (which is neither a₀ nor a_k, by
// distinctness); for the previous last, the shorter cycle wraps it to a₀ and (a₀ a_k)
// carries a₀ on to a_k.
theorem cycleAdvances: forall s: Points; forall k: Nat;
  distinct(s, succ(k)) -> forall i: Nat; less_than(i, k) -> apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i))
proof
  @generalize-s |
    fix s: Points {
      // base case: no i is below ZERO
      @base-case-proof |
        assume distinct(s, succ(ZERO)) {
          @generalize-i-base |
            fix i: Nat {
              @nothing-below-zero |
                not less_than(i, ZERO)
                [using specialize notLessThanZero(i)]
              @vacuous |
                less_than(i, ZERO) -> apply(cycle(s, succ(ZERO)), at(s, i)) = at(s, succ(i))
                [using tautology nothing-below-zero]
            }
          @conclusion-base-vacuous |
            forall i: Nat; less_than(i, ZERO) -> apply(cycle(s, succ(ZERO)), at(s, i)) = at(s, succ(i))
            [by generalize generalize-i-base]
        }
      @base-case |
        distinct(s, succ(ZERO)) -> forall i: Nat; less_than(i, ZERO) -> apply(cycle(s, succ(ZERO)), at(s, i)) = at(s, succ(i))
        [by discharge base-case-proof]

      // inductive step
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume distinct(s, succ(k)) -> forall i: Nat; less_than(i, k) -> apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i)) {
              @inductive-hypothesis |
                distinct(s, succ(k)) -> forall i: Nat; less_than(i, k) -> apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i))
                [by hypothesis given-inductive-hypothesis]
              @given-distinct |
                assume distinct(s, succ(succ(k))) {
                  @distinct-longer |
                    distinct(s, succ(succ(k)))
                    [by hypothesis given-distinct]
                  @distinct-shorter |
                    distinct(s, succ(k))
                    [using specialize distinctPrefix(s, succ(k)) distinct-longer]
                  @shorter-cycle-advances |
                    forall i: Nat; less_than(i, k) -> apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i))
                    [by modus_ponens inductive-hypothesis distinct-shorter]
                  @longer-cycle-unfolds |
                    cycle(s, succ(succ(k))) = compose(transposition(at(s, ZERO), at(s, succ(k))), cycle(s, succ(k)))
                    [using specialize cycleSucc(s, succ(k))]
                  @zero-listed |
                    less_than(ZERO, succ(succ(k)))
                    [using specialize zeroBelowSucc(succ(k))]
                  @succ-k-listed |
                    less_than(succ(k), succ(succ(k)))
                    [using specialize lessThanSelf(succ(k))]
                  @generalize-i |
                    fix i: Nat {
                      @given-i |
                        assume less_than(i, succ(k)) {
                          @i-below-succ-k |
                            less_than(i, succ(k))
                            [by hypothesis given-i]
                          @composite-at-i |
                            apply(compose(transposition(at(s, ZERO), at(s, succ(k))), cycle(s, succ(k))), at(s, i)) = apply(transposition(at(s, ZERO), at(s, succ(k))), apply(cycle(s, succ(k)), at(s, i)))
                            [using specialize composeApply(transposition(at(s, ZERO), at(s, succ(k))), cycle(s, succ(k)), at(s, i))]
                          @i-below-k-or-is-k |
                            less_than(i, k) or i = k
                            [using specialize lessThanSuccSplit(i, k) i-below-succ-k]
                          @composite-advances-i |
                            apply(compose(transposition(at(s, ZERO), at(s, succ(k))), cycle(s, succ(k))), at(s, i)) = at(s, succ(i))
                            case i-below-k-or-is-k {
                              @when-before-the-previous-last |
                                assume less_than(i, k) {
                                  @i-below-k |
                                    less_than(i, k)
                                    [by hypothesis when-before-the-previous-last]
                                  @shorter-advances-i |
                                    apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i))
                                    [using specialize shorter-cycle-advances(i) i-below-k]
                                  @composite-is-transposition-at-next |
                                    apply(compose(transposition(at(s, ZERO), at(s, succ(k))), cycle(s, succ(k))), at(s, i)) = apply(transposition(at(s, ZERO), at(s, succ(k))), at(s, succ(i)))
                                    [by rewrite shorter-advances-i composite-at-i]
                                  // the next point is neither a₀ nor a_{k+1}
                                  @succ-i-below-succ-k |
                                    less_than(succ(i), succ(k))
                                    [using specialize peano_order.succPreservesOrder(i, k) i-below-k]
                                  @succ-i-listed |
                                    less_than(succ(i), succ(succ(k)))
                                    [using specialize lessThanSuccRight(succ(i), succ(k)) succ-i-below-succ-k]
                                  @succ-i-is-not-zero |
                                    succ(i) != ZERO
                                    [using specialize succNotZero(i)]
                                  @next-is-not-first |
                                    at(s, succ(i)) != at(s, ZERO)
                                    [using specialize distinctEntriesDiffer(s, succ(succ(k)), succ(i), ZERO) distinct-longer succ-i-listed zero-listed succ-i-is-not-zero]
                                  @succ-i-not-below-itself |
                                    not less_than(succ(i), succ(i))
                                    [using specialize lessThanIrreflexive(succ(i))]
                                  @suppose-next-index-is-last |
                                    assume succ(i) = succ(k) {
                                      @next-index-is-last |
                                        succ(i) = succ(k)
                                        [by hypothesis suppose-next-index-is-last]
                                      @succ-i-below-itself |
                                        less_than(succ(i), succ(i))
                                        [by rewrite next-index-is-last succ-i-below-succ-k]
                                    }
                                  @next-index-is-not-last |
                                    succ(i) != succ(k)
                                    [by contradiction suppose-next-index-is-last succ-i-below-itself succ-i-not-below-itself]
                                  @next-is-not-last |
                                    at(s, succ(i)) != at(s, succ(k))
                                    [using specialize distinctEntriesDiffer(s, succ(succ(k)), succ(i), succ(k)) distinct-longer succ-i-listed succ-k-listed next-index-is-not-last]
                                  @transposition-fixes-next |
                                    apply(transposition(at(s, ZERO), at(s, succ(k))), at(s, succ(i))) = at(s, succ(i))
                                    [using specialize transpositionElsewhere(at(s, ZERO), at(s, succ(k)), at(s, succ(i))) next-is-not-first next-is-not-last]
                                  @conclusion-before-last |
                                    apply(compose(transposition(at(s, ZERO), at(s, succ(k))), cycle(s, succ(k))), at(s, i)) = at(s, succ(i))
                                    [using chain composite-is-transposition-at-next transposition-fixes-next]
                                }
                              @when-the-previous-last |
                                assume i = k {
                                  @i-is-k |
                                    i = k
                                    [by hypothesis when-the-previous-last]
                                  @shorter-wraps-last |
                                    apply(cycle(s, succ(k)), at(s, k)) = at(s, ZERO)
                                    [using specialize cycleWrapsAround(s, k) distinct-shorter]
                                  @shorter-wraps-i |
                                    apply(cycle(s, succ(k)), at(s, i)) = at(s, ZERO)
                                    [by rewrite i-is-k shorter-wraps-last]
                                  @composite-is-transposition-at-first |
                                    apply(compose(transposition(at(s, ZERO), at(s, succ(k))), cycle(s, succ(k))), at(s, i)) = apply(transposition(at(s, ZERO), at(s, succ(k))), at(s, ZERO))
                                    [by rewrite shorter-wraps-i composite-at-i]
                                  @transposition-sends-first-to-last |
                                    apply(transposition(at(s, ZERO), at(s, succ(k))), at(s, ZERO)) = at(s, succ(k))
                                    [using specialize transpositionAtFirst(at(s, ZERO), at(s, succ(k)))]
                                  @composite-sends-i-to-last |
                                    apply(compose(transposition(at(s, ZERO), at(s, succ(k))), cycle(s, succ(k))), at(s, i)) = at(s, succ(k))
                                    [using chain composite-is-transposition-at-first transposition-sends-first-to-last]
                                  @conclusion-at-previous-last |
                                    apply(compose(transposition(at(s, ZERO), at(s, succ(k))), cycle(s, succ(k))), at(s, i)) = at(s, succ(i))
                                    [by rewrite i-is-k composite-sends-i-to-last]
                                }
                            }
                          @conclusion-longer-advances-i |
                            apply(cycle(s, succ(succ(k))), at(s, i)) = at(s, succ(i))
                            [by rewrite longer-cycle-unfolds composite-advances-i]
                        }
                      @conclusion-i |
                        less_than(i, succ(k)) -> apply(cycle(s, succ(succ(k))), at(s, i)) = at(s, succ(i))
                        [by discharge given-i]
                    }
                  @conclusion-longer-advances |
                    forall i: Nat; less_than(i, succ(k)) -> apply(cycle(s, succ(succ(k))), at(s, i)) = at(s, succ(i))
                    [by generalize generalize-i]
                }
              @conclusion-step-implication |
                distinct(s, succ(succ(k))) -> forall i: Nat; less_than(i, succ(k)) -> apply(cycle(s, succ(succ(k))), at(s, i)) = at(s, succ(i))
                [by discharge given-distinct]
            }
          @induction-step-at-k |
            (distinct(s, succ(k)) -> forall i: Nat; less_than(i, k) -> apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i))) -> (distinct(s, succ(succ(k))) -> forall i: Nat; less_than(i, succ(k)) -> apply(cycle(s, succ(succ(k))), at(s, i)) = at(s, succ(i)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; (distinct(s, succ(k)) -> forall i: Nat; less_than(i, k) -> apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i))) -> (distinct(s, succ(succ(k))) -> forall i: Nat; less_than(i, succ(k)) -> apply(cycle(s, succ(succ(k))), at(s, i)) = at(s, succ(i)))
        [by generalize induction-step]
      @conclusion-for-all-k |
        forall k: Nat; distinct(s, succ(k)) -> forall i: Nat; less_than(i, k) -> apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i))
        [using instantiation induction((fun k: Nat => distinct(s, succ(k)) -> forall i: Nat; less_than(i, k) -> apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Points; forall k: Nat;
      distinct(s, succ(k)) -> forall i: Nat; less_than(i, k) -> apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i))
    [by generalize generalize-s]
qed

// -- the shortest cycles ------------------------------------------------------------------

// (u u) is the identity: both clauses of the swap send u to u, and everything else stays.
theorem transpositionOfAPointWithItself: forall u: Element; transposition(u, u) = identityFn
proof
  @generalize-u |
    fix u: Element {
      @pointwise |
        fix x: Element {
          @identity-at-x |
            apply(identityFn, x) = x
            [using specialize identityApply(x)]
          @x-is-u-or-not |
            x = u or x != u
            [using tautology]
          @swap-fixes-x |
            apply(transposition(u, u), x) = x
            case x-is-u-or-not {
              @when-at-u |
                assume x = u {
                  @x-is-u |
                    x = u
                    [by hypothesis when-at-u]
                  @u-goes-to-u |
                    apply(transposition(u, u), u) = u
                    [using specialize transpositionAtFirst(u, u)]
                  @conclusion-at-u |
                    apply(transposition(u, u), x) = x
                    [by rewrite x-is-u u-goes-to-u]
                }
              @when-elsewhere |
                assume x != u {
                  @x-is-not-u |
                    x != u
                    [by hypothesis when-elsewhere]
                  @conclusion-elsewhere |
                    apply(transposition(u, u), x) = x
                    [using specialize transpositionElsewhere(u, u, x) x-is-not-u x-is-not-u]
                }
            }
          @x-is-identity-at-x |
            x = apply(identityFn, x)
            [by symmetry identity-at-x]
          @conclusion-agree-at-x |
            apply(transposition(u, u), x) = apply(identityFn, x)
            [using chain swap-fixes-x x-is-identity-at-x]
        }
      @agree-everywhere |
        forall x: Element; apply(transposition(u, u), x) = apply(identityFn, x)
        [by generalize pointwise]
      @conclusion-is-identity |
        transposition(u, u) = identityFn
        [using specialize funcExtensionality(transposition(u, u), identityFn) agree-everywhere]
    }
  @conclusion |
    forall u: Element; transposition(u, u) = identityFn
    [by generalize generalize-u]
qed

// A one-cycle is the identity, and a two-cycle (a₀ a₁) is the transposition — cycle
// notation agrees with Judson's at the shortest lengths.
theorem oneCycleIsTheIdentity: forall s: Points; cycle(s, succ(ZERO)) = identityFn
proof
  @generalize-s |
    fix s: Points {
      @one-cycle-unfolds |
        cycle(s, succ(ZERO)) = compose(transposition(at(s, ZERO), at(s, ZERO)), cycle(s, ZERO))
        [using specialize cycleSucc(s, ZERO)]
      @empty-cycle-is-identity |
        cycle(s, ZERO) = identityFn
        [using specialize cycleZero(s)]
      @self-swap-is-identity |
        transposition(at(s, ZERO), at(s, ZERO)) = identityFn
        [using specialize transpositionOfAPointWithItself(at(s, ZERO))]
      @one-cycle-is-a-composite-with-identity |
        cycle(s, succ(ZERO)) = compose(transposition(at(s, ZERO), at(s, ZERO)), identityFn)
        [by rewrite empty-cycle-is-identity one-cycle-unfolds]
      @identity-drops |
        compose(transposition(at(s, ZERO), at(s, ZERO)), identityFn) = transposition(at(s, ZERO), at(s, ZERO))
        [using specialize composeIdentityRight(transposition(at(s, ZERO), at(s, ZERO)))]
      @one-cycle-is-the-self-swap |
        cycle(s, succ(ZERO)) = transposition(at(s, ZERO), at(s, ZERO))
        [using chain one-cycle-is-a-composite-with-identity identity-drops]
      @conclusion-identity |
        cycle(s, succ(ZERO)) = identityFn
        [using chain one-cycle-is-the-self-swap self-swap-is-identity]
    }
  @conclusion |
    forall s: Points; cycle(s, succ(ZERO)) = identityFn
    [by generalize generalize-s]
qed

theorem twoCycleIsATransposition: forall s: Points;
  cycle(s, succ(succ(ZERO))) = transposition(at(s, ZERO), at(s, succ(ZERO)))
proof
  @generalize-s |
    fix s: Points {
      @two-cycle-unfolds |
        cycle(s, succ(succ(ZERO))) = compose(transposition(at(s, ZERO), at(s, succ(ZERO))), cycle(s, succ(ZERO)))
        [using specialize cycleSucc(s, succ(ZERO))]
      @one-cycle-is-identity |
        cycle(s, succ(ZERO)) = identityFn
        [using specialize oneCycleIsTheIdentity(s)]
      @two-cycle-is-a-composite-with-identity |
        cycle(s, succ(succ(ZERO))) = compose(transposition(at(s, ZERO), at(s, succ(ZERO))), identityFn)
        [by rewrite one-cycle-is-identity two-cycle-unfolds]
      @identity-drops |
        compose(transposition(at(s, ZERO), at(s, succ(ZERO))), identityFn) = transposition(at(s, ZERO), at(s, succ(ZERO)))
        [using specialize composeIdentityRight(transposition(at(s, ZERO), at(s, succ(ZERO))))]
      @conclusion-transposition |
        cycle(s, succ(succ(ZERO))) = transposition(at(s, ZERO), at(s, succ(ZERO)))
        [using chain two-cycle-is-a-composite-with-identity identity-drops]
    }
  @conclusion |
    forall s: Points; cycle(s, succ(succ(ZERO))) = transposition(at(s, ZERO), at(s, succ(ZERO)))
    [by generalize generalize-s]
qed

// A point whose σ-preimage differs from w differs from σw: if x were σw then σ⁻¹x would be
// σ⁻¹σw = w. Stated contrapositively because that is how the conjugation argument uses it, and
// it is where σ's one-to-one-ness is doing the work.
theorem aPreimageAwayFromAPointIsAwayFromItsImage: forall sigma: Fn; invertible(sigma) ->
  forall x: Element; forall w: Element; apply(inverseFn(sigma), x) != w -> x != apply(sigma, w)
proof
  @generalize-sigma |
    fix sigma: Fn {
      @given-invertible |
        assume invertible(sigma) {
          @sigma-invertible |
            invertible(sigma)
            [by hypothesis given-invertible]
          @inverse-on-the-left |
            compose(inverseFn(sigma), sigma) = identityFn
            [using specialize inverseLeft(sigma) sigma-invertible]
          @conclusion-away |
            forall x: Element; forall w: Element; apply(inverseFn(sigma), x) != w -> x != apply(sigma, w)
            [by generalize generalize-x]
          @generalize-x |
            fix x: Element {
              @generalize-w |
                fix w: Element {
                  @given-preimage-differs |
                    assume apply(inverseFn(sigma), x) != w {
                      @preimage-differs |
                        apply(inverseFn(sigma), x) != w
                        [by hypothesis given-preimage-differs]
                      @given-x-is-the-image |
                        assume x = apply(sigma, w) {
                          @x-is-the-image |
                            x = apply(sigma, w)
                            [by hypothesis given-x-is-the-image]
                          // σ⁻¹(σw) = w
                          @inverse-after-sigma |
                            apply(compose(inverseFn(sigma), sigma), w) = apply(inverseFn(sigma), apply(sigma, w))
                            [using specialize composeApply(inverseFn(sigma), sigma, w)]
                          @identity-at-w |
                            apply(identityFn, w) = w
                            [using specialize function.identityApply(w)]
                          @identity-applied |
                            apply(compose(inverseFn(sigma), sigma), w) = w
                            [by rewrite inverse-on-the-left identity-at-w]
                          @identity-applied-flipped |
                            w = apply(compose(inverseFn(sigma), sigma), w)
                            [by symmetry identity-applied]
                          @w-is-the-preimage-of-its-image |
                            w = apply(inverseFn(sigma), apply(sigma, w))
                            [using chain identity-applied-flipped inverse-after-sigma]
                          @preimage-is-w |
                            apply(inverseFn(sigma), x) = w
                            [by rewrite x-is-the-image w-is-the-preimage-of-its-image-flipped]
                          @w-is-the-preimage-of-its-image-flipped |
                            apply(inverseFn(sigma), apply(sigma, w)) = w
                            [by symmetry w-is-the-preimage-of-its-image]
                          @conclusion-contradiction |
                            x != apply(sigma, w)
                            [by ex_falso preimage-is-w preimage-differs]
                        }
                      @image-implies |
                        x = apply(sigma, w) -> x != apply(sigma, w)
                        [by discharge given-x-is-the-image]
                      @conclusion-differs |
                        x != apply(sigma, w)
                        [using tautology image-implies]
                    }
                  @preimage-differs-implies |
                    apply(inverseFn(sigma), x) != w -> x != apply(sigma, w)
                    [by discharge given-preimage-differs]
                }
              @discharge-w |
                forall w: Element; apply(inverseFn(sigma), x) != w -> x != apply(sigma, w)
                [by generalize generalize-w]
            }
        }
      @invertible-implies |
        invertible(sigma) -> forall x: Element; forall w: Element; apply(inverseFn(sigma), x) != w -> x != apply(sigma, w)
        [by discharge given-invertible]
    }
  @conclusion |
    forall sigma: Fn; invertible(sigma) -> forall x: Element; forall w: Element; apply(inverseFn(sigma), x) != w -> x != apply(sigma, w)
    [by generalize generalize-sigma]
qed

// -- CONJUGATION CARRIES A TRANSPOSITION TO THE TRANSPOSITION OF THE IMAGES --------------------
// σ(u v)σ⁻¹ = (σu σv). Extensionality plus three cases on where a point x lands: x = σu, x = σv,
// or neither — and in the last case σ⁻¹x is neither u nor v, which is where σ's INJECTIVITY is
// needed (x ≠ σu gives σ⁻¹x ≠ u only because σ is one-to-one).
//
// This is the engine of Judson's §6.2 cycle-length theorem: a cycle is a product of
// transpositions (`cycleSucc`), so conjugating a cycle conjugates each factor, and the result is
// the cycle on the image points.
theorem conjugateOfATransposition: forall sigma: Fn; invertible(sigma) -> forall u: Element; forall v: Element;
  compose(compose(sigma, transposition(u, v)), inverseFn(sigma)) = transposition(apply(sigma, u), apply(sigma, v))
proof
  @generalize-sigma |
    fix sigma: Fn {
      @given-invertible |
        assume invertible(sigma) {
          @sigma-invertible |
            invertible(sigma)
            [by hypothesis given-invertible]
          @inverse-on-the-right |
            compose(sigma, inverseFn(sigma)) = identityFn
            [using specialize inverseRight(sigma) sigma-invertible]
          @conclusion-conjugation |
            forall u: Element; forall v: Element; compose(compose(sigma, transposition(u, v)), inverseFn(sigma)) = transposition(apply(sigma, u), apply(sigma, v))
            [by generalize generalize-u]
          @generalize-u |
            fix u: Element {
              @generalize-v |
                fix v: Element {
                  // pointwise agreement, then extensionality
                  @agree-pointwise |
                    forall x: Element; apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(transposition(apply(sigma, u), apply(sigma, v)), x)
                    [by generalize agree-at-x]
                  @agree-at-x |
                    fix x: Element {
                      // unfold the two composes: the left side is σ((u v)(σ⁻¹x))
                      @outer-compose |
                        apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(compose(sigma, transposition(u, v)), apply(inverseFn(sigma), x))
                        [using specialize composeApply(compose(sigma, transposition(u, v)), inverseFn(sigma), x)]
                      @inner-compose |
                        apply(compose(sigma, transposition(u, v)), apply(inverseFn(sigma), x)) = apply(sigma, apply(transposition(u, v), apply(inverseFn(sigma), x)))
                        [using specialize composeApply(sigma, transposition(u, v), apply(inverseFn(sigma), x))]
                      @left-side |
                        apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(sigma, apply(transposition(u, v), apply(inverseFn(sigma), x)))
                        [using chain outer-compose inner-compose]
                      // σ(σ⁻¹x) = x, which is what each case needs to land back on x
                      @sigma-after-inverse |
                        apply(compose(sigma, inverseFn(sigma)), x) = apply(sigma, apply(inverseFn(sigma), x))
                        [using specialize composeApply(sigma, inverseFn(sigma), x)]
                      @identity-at-x |
                        apply(identityFn, x) = x
                        [using specialize function.identityApply(x)]
                      @identity-applied |
                        apply(compose(sigma, inverseFn(sigma)), x) = x
                        [by rewrite inverse-on-the-right identity-at-x]
                      @identity-applied-flipped |
                        x = apply(compose(sigma, inverseFn(sigma)), x)
                        [by symmetry identity-applied]
                      @sigma-undoes-inverse |
                        x = apply(sigma, apply(inverseFn(sigma), x))
                        [using chain identity-applied-flipped sigma-after-inverse]
                      @sigma-undoes-inverse-flipped |
                        apply(sigma, apply(inverseFn(sigma), x)) = x
                        [by symmetry sigma-undoes-inverse]
                      // three cases on σ⁻¹x
                      @where-is-the-preimage |
                        apply(inverseFn(sigma), x) = u or apply(inverseFn(sigma), x) != u
                        [using tautology]
                      @conclusion-agree-at-x |
                        apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(transposition(apply(sigma, u), apply(sigma, v)), x)
                        case where-is-the-preimage {
                          // σ⁻¹x = u: left side is σv, and x = σu so the right side is σv too
                          @when-preimage-is-u |
                            assume apply(inverseFn(sigma), x) = u {
                              @preimage-is-u |
                                apply(inverseFn(sigma), x) = u
                                [by hypothesis when-preimage-is-u]
                              @swap-at-u |
                                apply(transposition(u, v), u) = v
                                [using specialize transpositionAtFirst(u, v)]
                              @swap-at-preimage |
                                apply(transposition(u, v), apply(inverseFn(sigma), x)) = v
                                [by rewrite preimage-is-u swap-at-u]
                              @left-is-sigma-v |
                                apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(sigma, v)
                                [by rewrite swap-at-preimage left-side]
                              @x-is-sigma-u |
                                x = apply(sigma, u)
                                [by rewrite preimage-is-u sigma-undoes-inverse]
                              @right-at-sigma-u |
                                apply(transposition(apply(sigma, u), apply(sigma, v)), apply(sigma, u)) = apply(sigma, v)
                                [using specialize transpositionAtFirst(apply(sigma, u), apply(sigma, v))]
                              @right-is-sigma-v |
                                apply(transposition(apply(sigma, u), apply(sigma, v)), x) = apply(sigma, v)
                                [by rewrite x-is-sigma-u right-at-sigma-u]
                              @right-is-sigma-v-flipped |
                                apply(sigma, v) = apply(transposition(apply(sigma, u), apply(sigma, v)), x)
                                [by symmetry right-is-sigma-v]
                              @conclusion-case-u |
                                apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(transposition(apply(sigma, u), apply(sigma, v)), x)
                                [using chain left-is-sigma-v right-is-sigma-v-flipped]
                            }
                          @when-preimage-is-not-u |
                            assume apply(inverseFn(sigma), x) != u {
                              @preimage-is-not-u |
                                apply(inverseFn(sigma), x) != u
                                [by hypothesis when-preimage-is-not-u]
                              @where-else |
                                apply(inverseFn(sigma), x) = v or apply(inverseFn(sigma), x) != v
                                [using tautology]
                              @conclusion-not-u |
                                apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(transposition(apply(sigma, u), apply(sigma, v)), x)
                                case where-else {
                                  // σ⁻¹x = v: left side is σu, and x = σv so the right side is σu
                                  @when-preimage-is-v |
                                    assume apply(inverseFn(sigma), x) = v {
                                      @preimage-is-v |
                                        apply(inverseFn(sigma), x) = v
                                        [by hypothesis when-preimage-is-v]
                                      @swap-at-v |
                                        apply(transposition(u, v), v) = u
                                        [using specialize transpositionAtSecond(u, v)]
                                      @swap-at-preimage |
                                        apply(transposition(u, v), apply(inverseFn(sigma), x)) = u
                                        [by rewrite preimage-is-v swap-at-v]
                                      @left-is-sigma-u |
                                        apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(sigma, u)
                                        [by rewrite swap-at-preimage left-side]
                                      @x-is-sigma-v |
                                        x = apply(sigma, v)
                                        [by rewrite preimage-is-v sigma-undoes-inverse]
                                      @right-at-sigma-v |
                                        apply(transposition(apply(sigma, u), apply(sigma, v)), apply(sigma, v)) = apply(sigma, u)
                                        [using specialize transpositionAtSecond(apply(sigma, u), apply(sigma, v))]
                                      @right-is-sigma-u |
                                        apply(transposition(apply(sigma, u), apply(sigma, v)), x) = apply(sigma, u)
                                        [by rewrite x-is-sigma-v right-at-sigma-v]
                                      @right-is-sigma-u-flipped |
                                        apply(sigma, u) = apply(transposition(apply(sigma, u), apply(sigma, v)), x)
                                        [by symmetry right-is-sigma-u]
                                      @conclusion-case-v |
                                        apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(transposition(apply(sigma, u), apply(sigma, v)), x)
                                        [using chain left-is-sigma-u right-is-sigma-u-flipped]
                                    }
                                  // σ⁻¹x is neither: both sides fix x. The right side needs
                                  // x ≠ σu and x ≠ σv, which is where INJECTIVITY enters.
                                  @when-preimage-is-neither |
                                    assume apply(inverseFn(sigma), x) != v {
                                      @preimage-is-not-v |
                                        apply(inverseFn(sigma), x) != v
                                        [by hypothesis when-preimage-is-neither]
                                      @swap-fixes-preimage |
                                        apply(transposition(u, v), apply(inverseFn(sigma), x)) = apply(inverseFn(sigma), x)
                                        [using specialize transpositionElsewhere(u, v, apply(inverseFn(sigma), x)) preimage-is-not-u preimage-is-not-v]
                                      @left-is-x |
                                        apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = x
                                        [using chain left-side-rewritten sigma-undoes-inverse-flipped]
                                      @left-side-rewritten |
                                        apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(sigma, apply(inverseFn(sigma), x))
                                        [by rewrite swap-fixes-preimage left-side]
                                      // x ≠ σu: else σ⁻¹x = σ⁻¹σu = u
                                      @x-differs-from-sigma-u |
                                        x != apply(sigma, u)
                                        [using specialize aPreimageAwayFromAPointIsAwayFromItsImage(sigma, x, u) sigma-invertible preimage-is-not-u]
                                      @x-differs-from-sigma-v |
                                        x != apply(sigma, v)
                                        [using specialize aPreimageAwayFromAPointIsAwayFromItsImage(sigma, x, v) sigma-invertible preimage-is-not-v]
                                      @right-fixes-x |
                                        apply(transposition(apply(sigma, u), apply(sigma, v)), x) = x
                                        [using specialize transpositionElsewhere(apply(sigma, u), apply(sigma, v), x) x-differs-from-sigma-u x-differs-from-sigma-v]
                                      @right-fixes-x-flipped |
                                        x = apply(transposition(apply(sigma, u), apply(sigma, v)), x)
                                        [by symmetry right-fixes-x]
                                      @conclusion-case-neither |
                                        apply(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), x) = apply(transposition(apply(sigma, u), apply(sigma, v)), x)
                                        [using chain left-is-x right-fixes-x-flipped]
                                    }
                                }
                            }
                        }
                    }
                  @conclusion-extensional |
                    compose(compose(sigma, transposition(u, v)), inverseFn(sigma)) = transposition(apply(sigma, u), apply(sigma, v))
                    [using specialize funcExtensionality(compose(compose(sigma, transposition(u, v)), inverseFn(sigma)), transposition(apply(sigma, u), apply(sigma, v))) agree-pointwise]
                }
              @discharge-v |
                forall v: Element; compose(compose(sigma, transposition(u, v)), inverseFn(sigma)) = transposition(apply(sigma, u), apply(sigma, v))
                [by generalize generalize-v]
            }
        }
      @invertible-implies |
        invertible(sigma) -> forall u: Element; forall v: Element; compose(compose(sigma, transposition(u, v)), inverseFn(sigma)) = transposition(apply(sigma, u), apply(sigma, v))
        [by discharge given-invertible]
    }
  @conclusion |
    forall sigma: Fn; invertible(sigma) -> forall u: Element; forall v: Element; compose(compose(sigma, transposition(u, v)), inverseFn(sigma)) = transposition(apply(sigma, u), apply(sigma, v))
    [by generalize generalize-sigma]
qed

// -- THE IMAGE POINT-LIST ----------------------------------------------------------------------
// For a map σ and a point list s there is a list whose first m entries are σ(s₀), …, σ(s_{m−1}).
// Induction on m: extend by concatenating the singleton holding σ(s_m) after the first m entries
// (`pointsConcat` at j = m, k = 1). The same shape as
// `std/group/sequence.b4m`'s `translatedSequenceExists`, and it is what `pointsConcat` was added
// for — with prepend alone a prefix cannot be grown.
theorem imagePointsExist: forall sigma: Fn; forall s: Points; forall m: Nat;
  exists t: Points; forall i: Nat; less_than(i, m) -> at(t, i) = apply(sigma, at(s, i))
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-s |
        fix s: Points {
          // base: nothing is below ZERO, so any list serves — and one exists.
          @some-list-exists |
            exists t: Points; at(t, ZERO) = apply(sigma, at(s, ZERO))
            [using specialize pointsSingleton(apply(sigma, at(s, ZERO)))]
          @base-case |
            exists t: Points; forall i: Nat; less_than(i, ZERO) -> at(t, i) = apply(sigma, at(s, i))
            [by unpacked with-some-list]
          @with-some-list |
            unpack t0: Points from some-list-exists {
              @vacuous |
                forall i: Nat; less_than(i, ZERO) -> at(t0, i) = apply(sigma, at(s, i))
                [by generalize nothing-below-zero]
              @nothing-below-zero |
                fix i: Nat {
                  @given-below-zero |
                    assume less_than(i, ZERO) {
                      @below-zero |
                        less_than(i, ZERO)
                        [by hypothesis given-below-zero]
                      @not-below-zero |
                        not less_than(i, ZERO)
                        [using specialize notLessThanZero(i)]
                      @conclusion-vacuous |
                        at(t0, i) = apply(sigma, at(s, i))
                        [using tautology below-zero not-below-zero]
                    }
                  @below-zero-implies |
                    less_than(i, ZERO) -> at(t0, i) = apply(sigma, at(s, i))
                    [by discharge given-below-zero]
                }
              @conclusion-base-inner |
                exists t: Points; forall i: Nat; less_than(i, ZERO) -> at(t, i) = apply(sigma, at(s, i))
                [by witness(t0) vacuous]
            }
          // step: the singleton holding σ(s_k), concatenated after the first k entries.
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume exists t: Points; forall i: Nat; less_than(i, k) -> at(t, i) = apply(sigma, at(s, i)) {
                  @inductive-hypothesis |
                    exists t: Points; forall i: Nat; less_than(i, k) -> at(t, i) = apply(sigma, at(s, i))
                    [by hypothesis given-inductive-hypothesis]
                  @with-prefix |
                    unpack t: Points from inductive-hypothesis {
                      @prefix-matches |
                        forall i: Nat; less_than(i, k) -> at(t, i) = apply(sigma, at(s, i))
                        [by hypothesis with-prefix]
                      @singleton-exists |
                        exists w: Points; at(w, ZERO) = apply(sigma, at(s, k))
                        [using specialize pointsSingleton(apply(sigma, at(s, k)))]
                      @with-singleton |
                        unpack w: Points from singleton-exists {
                          @singleton-head |
                            at(w, ZERO) = apply(sigma, at(s, k))
                            [by hypothesis with-singleton]
                          @joined-exists |
                            exists u: Points; (forall i: Nat; less_than(i, k) -> at(u, i) = at(t, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(w, i))
                            [using specialize pointsConcat(t, w, k, succ(ZERO))]
                          @with-joined |
                            unpack u: Points from joined-exists {
                              @joined-facts |
                                (forall i: Nat; less_than(i, k) -> at(u, i) = at(t, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(w, i))
                                [by hypothesis with-joined]
                              @joined-below |
                                forall i: Nat; less_than(i, k) -> at(u, i) = at(t, i)
                                [by and_lhs joined-facts]
                              @joined-above |
                                forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(w, i)
                                [by and_rhs joined-facts]
                              // the new entry sits at index k = k + 0
                              @zero-below-one |
                                less_than(ZERO, succ(ZERO))
                                [using specialize zeroBelowSucc(ZERO)]
                              @joined-at-k-plus-zero |
                                at(u, add(k, ZERO)) = at(w, ZERO)
                                [using specialize joined-above(ZERO) zero-below-one]
                              @k-plus-zero |
                                add(k, ZERO) = k
                                [using specialize peano.addZeroRight(k)]
                              @joined-at-k |
                                at(u, k) = at(w, ZERO)
                                [by rewrite k-plus-zero joined-at-k-plus-zero]
                              @joined-at-k-is-the-image |
                                at(u, k) = apply(sigma, at(s, k))
                                [using chain joined-at-k singleton-head]
                              // every index below succ(k) is either below k or is k
                              @matches-below-succ-k |
                                forall i: Nat; less_than(i, succ(k)) -> at(u, i) = apply(sigma, at(s, i))
                                [by generalize matches-at-i]
                              @matches-at-i |
                                fix i: Nat {
                                  @given-i-below-succ-k |
                                    assume less_than(i, succ(k)) {
                                      @i-below-succ-k |
                                        less_than(i, succ(k))
                                        [by hypothesis given-i-below-succ-k]
                                      @i-splits |
                                        less_than(i, k) or i = k
                                        [using specialize lessThanSuccSplit(i, k) i-below-succ-k]
                                      @conclusion-matches-at-i |
                                        at(u, i) = apply(sigma, at(s, i))
                                        case i-splits {
                                          @when-i-is-in-the-prefix |
                                            assume less_than(i, k) {
                                              @i-below-k |
                                                less_than(i, k)
                                                [by hypothesis when-i-is-in-the-prefix]
                                              @joined-agrees-with-prefix |
                                                at(u, i) = at(t, i)
                                                [using specialize joined-below(i) i-below-k]
                                              @prefix-at-i |
                                                at(t, i) = apply(sigma, at(s, i))
                                                [using specialize prefix-matches(i) i-below-k]
                                              @conclusion-prefix-case |
                                                at(u, i) = apply(sigma, at(s, i))
                                                [using chain joined-agrees-with-prefix prefix-at-i]
                                            }
                                          @when-i-is-the-new-entry |
                                            assume i = k {
                                              @i-is-k |
                                                i = k
                                                [by hypothesis when-i-is-the-new-entry]
                                              @conclusion-new-entry-case |
                                                at(u, i) = apply(sigma, at(s, i))
                                                [by rewrite i-is-k joined-at-k-is-the-image]
                                            }
                                        }
                                    }
                                  @i-below-succ-k-implies |
                                    less_than(i, succ(k)) -> at(u, i) = apply(sigma, at(s, i))
                                    [by discharge given-i-below-succ-k]
                                }
                              @conclusion-extended-inner |
                                exists t2: Points; forall i: Nat; less_than(i, succ(k)) -> at(t2, i) = apply(sigma, at(s, i))
                                [by witness(u) matches-below-succ-k]
                            }
                          @conclusion-with-joined |
                            exists t2: Points; forall i: Nat; less_than(i, succ(k)) -> at(t2, i) = apply(sigma, at(s, i))
                            [by unpacked with-joined]
                        }
                      @conclusion-with-singleton |
                        exists t2: Points; forall i: Nat; less_than(i, succ(k)) -> at(t2, i) = apply(sigma, at(s, i))
                        [by unpacked with-singleton]
                    }
                  @conclusion-step |
                    exists t: Points; forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))
                    [by unpacked with-prefix]
                }
              @induction-step-at-k |
                (exists t: Points; forall i: Nat; less_than(i, k) -> at(t, i) = apply(sigma, at(s, i))) -> (exists t: Points; forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i)))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat; (exists t: Points; forall i: Nat; less_than(i, k) -> at(t, i) = apply(sigma, at(s, i))) -> (exists t: Points; forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i)))
            [by generalize induction-step]
          @conclusion-for-all-m |
            forall m: Nat; exists t: Points; forall i: Nat; less_than(i, m) -> at(t, i) = apply(sigma, at(s, i))
            [using instantiation induction((fun m: Nat => exists t: Points; forall i: Nat; less_than(i, m) -> at(t, i) = apply(sigma, at(s, i)))) base-case induction-step-for-all-k]
        }
      @discharge-s |
        forall s: Points; forall m: Nat; exists t: Points; forall i: Nat; less_than(i, m) -> at(t, i) = apply(sigma, at(s, i))
        [by generalize generalize-s]
    }
  @conclusion |
    forall sigma: Fn; forall s: Points; forall m: Nat; exists t: Points; forall i: Nat; less_than(i, m) -> at(t, i) = apply(sigma, at(s, i))
    [by generalize generalize-sigma]
qed

// Conjugation is MULTIPLICATIVE: σ(f∘g)σ⁻¹ = (σfσ⁻¹)(σgσ⁻¹). Pure composition algebra —
// insert σ⁻¹σ between the factors and reassociate. This is what lets an induction on a product
// conjugate one factor at a time.
theorem conjugationIsMultiplicative: forall sigma: Fn; invertible(sigma) -> forall f: Fn; forall g: Fn;
  compose(compose(sigma, compose(f, g)), inverseFn(sigma)) = compose(compose(compose(sigma, f), inverseFn(sigma)), compose(compose(sigma, g), inverseFn(sigma)))
proof
  @generalize-sigma |
    fix sigma: Fn {
      @given-invertible |
        assume invertible(sigma) {
          @sigma-invertible |
            invertible(sigma)
            [by hypothesis given-invertible]
          @inverse-on-the-left |
            compose(inverseFn(sigma), sigma) = identityFn
            [using specialize inverseLeft(sigma) sigma-invertible]
          @conclusion-multiplicative |
            forall f: Fn; forall g: Fn; compose(compose(sigma, compose(f, g)), inverseFn(sigma)) = compose(compose(compose(sigma, f), inverseFn(sigma)), compose(compose(sigma, g), inverseFn(sigma)))
            [by generalize generalize-f]
          @generalize-f |
            fix f: Fn {
              @generalize-g |
                fix g: Fn {
                  // work on the RIGHT side: cancel the inner σ⁻¹σ down to σ(f∘g)σ⁻¹.
                  // (σfσ⁻¹)(σgσ⁻¹) = (σf)(σ⁻¹(σ(gσ⁻¹))) by reassociating twice
                  @right-outer |
                    compose(compose(compose(sigma, f), inverseFn(sigma)), compose(compose(sigma, g), inverseFn(sigma))) = compose(compose(sigma, f), compose(inverseFn(sigma), compose(compose(sigma, g), inverseFn(sigma))))
                    [using specialize composeAssoc(compose(sigma, f), inverseFn(sigma), compose(compose(sigma, g), inverseFn(sigma)))]
                  @regroup-the-tail |
                    compose(compose(sigma, g), inverseFn(sigma)) = compose(sigma, compose(g, inverseFn(sigma)))
                    [using specialize composeAssoc(sigma, g, inverseFn(sigma))]
                  @right-with-tail-regrouped |
                    compose(compose(compose(sigma, f), inverseFn(sigma)), compose(compose(sigma, g), inverseFn(sigma))) = compose(compose(sigma, f), compose(inverseFn(sigma), compose(sigma, compose(g, inverseFn(sigma)))))
                    [by rewrite regroup-the-tail right-outer]
                  // σ⁻¹(σ·X) = (σ⁻¹σ)X = X
                  @cancel-regroup |
                    compose(compose(inverseFn(sigma), sigma), compose(g, inverseFn(sigma))) = compose(inverseFn(sigma), compose(sigma, compose(g, inverseFn(sigma))))
                    [using specialize composeAssoc(inverseFn(sigma), sigma, compose(g, inverseFn(sigma)))]
                  @cancel-to-identity |
                    compose(identityFn, compose(g, inverseFn(sigma))) = compose(inverseFn(sigma), compose(sigma, compose(g, inverseFn(sigma))))
                    [by rewrite inverse-on-the-left cancel-regroup]
                  @identity-drops |
                    compose(identityFn, compose(g, inverseFn(sigma))) = compose(g, inverseFn(sigma))
                    [using specialize composeIdentityLeft(compose(g, inverseFn(sigma)))]
                  @identity-drops-flipped |
                    compose(g, inverseFn(sigma)) = compose(identityFn, compose(g, inverseFn(sigma)))
                    [by symmetry identity-drops]
                  @cancelled |
                    compose(g, inverseFn(sigma)) = compose(inverseFn(sigma), compose(sigma, compose(g, inverseFn(sigma))))
                    [using chain identity-drops-flipped cancel-to-identity]
                  @cancelled-flipped |
                    compose(inverseFn(sigma), compose(sigma, compose(g, inverseFn(sigma)))) = compose(g, inverseFn(sigma))
                    [by symmetry cancelled]
                  @right-cancelled |
                    compose(compose(compose(sigma, f), inverseFn(sigma)), compose(compose(sigma, g), inverseFn(sigma))) = compose(compose(sigma, f), compose(g, inverseFn(sigma)))
                    [by rewrite cancelled-flipped right-with-tail-regrouped]
                  // and the LEFT side reassociates to the same thing
                  @left-regroup |
                    compose(compose(sigma, compose(f, g)), inverseFn(sigma)) = compose(sigma, compose(compose(f, g), inverseFn(sigma)))
                    [using specialize composeAssoc(sigma, compose(f, g), inverseFn(sigma))]
                  @inner-regroup |
                    compose(compose(f, g), inverseFn(sigma)) = compose(f, compose(g, inverseFn(sigma)))
                    [using specialize composeAssoc(f, g, inverseFn(sigma))]
                  @left-fully-regrouped |
                    compose(compose(sigma, compose(f, g)), inverseFn(sigma)) = compose(sigma, compose(f, compose(g, inverseFn(sigma))))
                    [by rewrite inner-regroup left-regroup]
                  @right-regroup |
                    compose(compose(sigma, f), compose(g, inverseFn(sigma))) = compose(sigma, compose(f, compose(g, inverseFn(sigma))))
                    [using specialize composeAssoc(sigma, f, compose(g, inverseFn(sigma)))]
                  @right-regroup-flipped |
                    compose(sigma, compose(f, compose(g, inverseFn(sigma)))) = compose(compose(sigma, f), compose(g, inverseFn(sigma)))
                    [by symmetry right-regroup]
                  @left-equals-the-middle |
                    compose(compose(sigma, compose(f, g)), inverseFn(sigma)) = compose(compose(sigma, f), compose(g, inverseFn(sigma)))
                    [using chain left-fully-regrouped right-regroup-flipped]
                  @right-cancelled-flipped |
                    compose(compose(sigma, f), compose(g, inverseFn(sigma))) = compose(compose(compose(sigma, f), inverseFn(sigma)), compose(compose(sigma, g), inverseFn(sigma)))
                    [by symmetry right-cancelled]
                  @conclusion-split |
                    compose(compose(sigma, compose(f, g)), inverseFn(sigma)) = compose(compose(compose(sigma, f), inverseFn(sigma)), compose(compose(sigma, g), inverseFn(sigma)))
                    [using chain left-equals-the-middle right-cancelled-flipped]
                }
              @discharge-g |
                forall g: Fn; compose(compose(sigma, compose(f, g)), inverseFn(sigma)) = compose(compose(compose(sigma, f), inverseFn(sigma)), compose(compose(sigma, g), inverseFn(sigma)))
                [by generalize generalize-g]
            }
        }
      @invertible-implies |
        invertible(sigma) -> forall f: Fn; forall g: Fn; compose(compose(sigma, compose(f, g)), inverseFn(sigma)) = compose(compose(compose(sigma, f), inverseFn(sigma)), compose(compose(sigma, g), inverseFn(sigma)))
        [by discharge given-invertible]
    }
  @conclusion |
    forall sigma: Fn; invertible(sigma) -> forall f: Fn; forall g: Fn; compose(compose(sigma, compose(f, g)), inverseFn(sigma)) = compose(compose(compose(sigma, f), inverseFn(sigma)), compose(compose(sigma, g), inverseFn(sigma)))
    [by generalize generalize-sigma]
qed

// -- CONJUGATING A CYCLE GIVES THE CYCLE ON THE IMAGE POINTS -----------------------------------
// σ·cycle(s, k)·σ⁻¹ = cycle(t, k) whenever t's first k entries are the σ-images of s's.
// Judson's §6.2: conjugate cycles are exactly the cycles of the same length, because
// conjugation relabels the points and nothing else.
//
// Induction on k. At ZERO both sides are the identity (σ·id·σ⁻¹ = σσ⁻¹ = id). At succ(k),
// `cycleSucc` splits each side into a transposition times the shorter cycle, and inserting
// σ⁻¹σ between the two factors turns one conjugate into the product of two:
//
//     σ(T·C)σ⁻¹ = (σTσ⁻¹)(σCσ⁻¹)
//
// the first factor by `conjugateOfATransposition` and the second by the hypothesis. The entry
// clause of the image list is what makes the transposition's endpoints line up — t's ZERO-th
// and k-th entries are σ(s₀) and σ(s_k), which is exactly what `cycleSucc` names.
theorem conjugateOfACycle: forall sigma: Fn; invertible(sigma) -> forall k: Nat; forall s: Points; forall t: Points;
  (forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))) ->
  compose(compose(sigma, cycle(s, k)), inverseFn(sigma)) = cycle(t, k)
proof
  @generalize-sigma |
    fix sigma: Fn {
      @given-invertible |
        assume invertible(sigma) {
          @sigma-invertible |
            invertible(sigma)
            [by hypothesis given-invertible]
          @inverse-on-the-right |
            compose(sigma, inverseFn(sigma)) = identityFn
            [using specialize inverseRight(sigma) sigma-invertible]
          // base: both sides are the identity.
          @base-case |
            forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(ZERO)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, ZERO)), inverseFn(sigma)) = cycle(t, ZERO)
            [by generalize base-at-s]
          @base-at-s |
            fix s: Points {
              @base-at-t |
                fix t: Points {
                  @given-base-entries |
                    assume forall i: Nat; less_than(i, succ(ZERO)) -> at(t, i) = apply(sigma, at(s, i)) {
                      @source-cycle-is-identity |
                        cycle(s, ZERO) = identityFn
                        [using specialize cycleZero(s)]
                      @image-cycle-is-identity |
                        cycle(t, ZERO) = identityFn
                        [using specialize cycleZero(t)]
                      @sigma-after-identity |
                        compose(sigma, identityFn) = sigma
                        [using specialize composeIdentityRight(sigma)]
                      @conjugate-of-identity |
                        compose(compose(sigma, identityFn), inverseFn(sigma)) = compose(sigma, inverseFn(sigma))
                        [by rewrite sigma-after-identity conjugate-is-itself]
                      @conjugate-is-itself |
                        compose(sigma, inverseFn(sigma)) = compose(sigma, inverseFn(sigma))
                        [by reflexivity]
                      @conjugate-of-identity-is-identity |
                        compose(compose(sigma, identityFn), inverseFn(sigma)) = identityFn
                        [using chain conjugate-of-identity inverse-on-the-right]
                      @identity-is-the-image-cycle |
                        identityFn = cycle(t, ZERO)
                        [by symmetry image-cycle-is-identity]
                      @conjugate-with-identity-is-image |
                        compose(compose(sigma, identityFn), inverseFn(sigma)) = cycle(t, ZERO)
                        [using chain conjugate-of-identity-is-identity identity-is-the-image-cycle]
                      @conclusion-base-entries |
                        compose(compose(sigma, cycle(s, ZERO)), inverseFn(sigma)) = cycle(t, ZERO)
                        [by rewrite source-cycle-is-identity conjugate-with-identity-is-image]
                    }
                  @base-entries-implies |
                    (forall i: Nat; less_than(i, succ(ZERO)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, ZERO)), inverseFn(sigma)) = cycle(t, ZERO)
                    [by discharge given-base-entries]
                }
              @discharge-base-t |
                forall t: Points; (forall i: Nat; less_than(i, succ(ZERO)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, ZERO)), inverseFn(sigma)) = cycle(t, ZERO)
                [by generalize base-at-t]
            }
          // step
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, k)), inverseFn(sigma)) = cycle(t, k) {
                  @inductive-hypothesis |
                    forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, k)), inverseFn(sigma)) = cycle(t, k)
                    [by hypothesis given-inductive-hypothesis]
                  @conclusion-step |
                    forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(succ(k))) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, succ(k))), inverseFn(sigma)) = cycle(t, succ(k))
                    [by generalize step-at-s]
                  @step-at-s |
                    fix s: Points {
                      @step-at-t |
                        fix t: Points {
                          @given-entries |
                            assume forall i: Nat; less_than(i, succ(succ(k))) -> at(t, i) = apply(sigma, at(s, i)) {
                              @entries |
                                forall i: Nat; less_than(i, succ(succ(k))) -> at(t, i) = apply(sigma, at(s, i))
                                [by hypothesis given-entries]
                              // the shorter prefix still matches, so the hypothesis applies
                              @shorter-entries |
                                forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))
                                [by generalize shorter-entry-at-i]
                              @shorter-entry-at-i |
                                fix i: Nat {
                                  @given-i-below-succ-k |
                                    assume less_than(i, succ(k)) {
                                      @i-below-succ-k |
                                        less_than(i, succ(k))
                                        [by hypothesis given-i-below-succ-k]
                                      @i-below-succ-succ-k |
                                        less_than(i, succ(succ(k)))
                                        [using specialize lessThanSuccRight(i, succ(k)) i-below-succ-k]
                                      @conclusion-shorter-entry |
                                        at(t, i) = apply(sigma, at(s, i))
                                        [using specialize entries(i) i-below-succ-succ-k]
                                    }
                                  @i-below-implies |
                                    less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))
                                    [by discharge given-i-below-succ-k]
                                }
                              @shorter-conjugate |
                                compose(compose(sigma, cycle(s, k)), inverseFn(sigma)) = cycle(t, k)
                                [using specialize inductive-hypothesis(s, t) shorter-entries]
                              // the two cycleSucc unfoldings
                              @source-unfolds |
                                cycle(s, succ(k)) = compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k))
                                [using specialize cycleSucc(s, k)]
                              @image-unfolds |
                                cycle(t, succ(k)) = compose(transposition(at(t, ZERO), at(t, k)), cycle(t, k))
                                [using specialize cycleSucc(t, k)]
                              // t's ZERO-th and k-th entries are the σ-images of s's
                              @zero-below |
                                less_than(ZERO, succ(succ(k)))
                                [using specialize zeroBelowSucc(succ(k))]
                              @k-below |
                                less_than(k, succ(succ(k)))
                                [using specialize lessThanSuccRight(k, succ(k)) k-below-succ-k]
                              @k-below-succ-k |
                                less_than(k, succ(k))
                                [using specialize lessThanSelf(k)]
                              @t-at-zero |
                                at(t, ZERO) = apply(sigma, at(s, ZERO))
                                [using specialize entries(ZERO) zero-below]
                              @t-at-k |
                                at(t, k) = apply(sigma, at(s, k))
                                [using specialize entries(k) k-below]
                              // the conjugate of the leading transposition
                              @conjugate-transposition |
                                compose(compose(sigma, transposition(at(s, ZERO), at(s, k))), inverseFn(sigma)) = transposition(apply(sigma, at(s, ZERO)), apply(sigma, at(s, k)))
                                [using specialize conjugateOfATransposition(sigma, at(s, ZERO), at(s, k)) sigma-invertible]
                              @conjugate-transposition-at-t-zero |
                                compose(compose(sigma, transposition(at(s, ZERO), at(s, k))), inverseFn(sigma)) = transposition(at(t, ZERO), apply(sigma, at(s, k)))
                                [by rewrite t-at-zero conjugate-transposition]
                              @conjugate-transposition-at-t |
                                compose(compose(sigma, transposition(at(s, ZERO), at(s, k))), inverseFn(sigma)) = transposition(at(t, ZERO), at(t, k))
                                [by rewrite t-at-k conjugate-transposition-at-t-zero]
                              // split the conjugate of the product into the product of conjugates
                              @conjugate-splits |
                                compose(compose(sigma, compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k))), inverseFn(sigma)) = compose(compose(compose(sigma, transposition(at(s, ZERO), at(s, k))), inverseFn(sigma)), compose(compose(sigma, cycle(s, k)), inverseFn(sigma)))
                                [using specialize conjugationIsMultiplicative(sigma, transposition(at(s, ZERO), at(s, k)), cycle(s, k)) sigma-invertible]
                              @split-with-transposition |
                                compose(compose(sigma, compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k))), inverseFn(sigma)) = compose(transposition(at(t, ZERO), at(t, k)), compose(compose(sigma, cycle(s, k)), inverseFn(sigma)))
                                [by rewrite conjugate-transposition-at-t conjugate-splits]
                              @split-fully |
                                compose(compose(sigma, compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k))), inverseFn(sigma)) = compose(transposition(at(t, ZERO), at(t, k)), cycle(t, k))
                                [by rewrite shorter-conjugate split-with-transposition]
                              @image-unfolds-flipped |
                                compose(transposition(at(t, ZERO), at(t, k)), cycle(t, k)) = cycle(t, succ(k))
                                [by symmetry image-unfolds]
                              @unfolded-conjugate-is-the-image |
                                compose(compose(sigma, compose(transposition(at(s, ZERO), at(s, k)), cycle(s, k))), inverseFn(sigma)) = cycle(t, succ(k))
                                [using chain split-fully image-unfolds-flipped]
                              @conclusion-step-entries |
                                compose(compose(sigma, cycle(s, succ(k))), inverseFn(sigma)) = cycle(t, succ(k))
                                [by rewrite source-unfolds unfolded-conjugate-is-the-image]
                            }
                          @entries-implies |
                            (forall i: Nat; less_than(i, succ(succ(k))) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, succ(k))), inverseFn(sigma)) = cycle(t, succ(k))
                            [by discharge given-entries]
                        }
                      @discharge-step-t |
                        forall t: Points; (forall i: Nat; less_than(i, succ(succ(k))) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, succ(k))), inverseFn(sigma)) = cycle(t, succ(k))
                        [by generalize step-at-t]
                    }
                }
              @induction-step-at-k |
                (forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, k)), inverseFn(sigma)) = cycle(t, k)) -> (forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(succ(k))) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, succ(k))), inverseFn(sigma)) = cycle(t, succ(k)))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat; (forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, k)), inverseFn(sigma)) = cycle(t, k)) -> (forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(succ(k))) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, succ(k))), inverseFn(sigma)) = cycle(t, succ(k)))
            [by generalize induction-step]
          @conclusion-for-all-k |
            forall k: Nat; forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, k)), inverseFn(sigma)) = cycle(t, k)
            [using instantiation induction((fun k: Nat => forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, k)), inverseFn(sigma)) = cycle(t, k))) base-case induction-step-for-all-k]
        }
      @invertible-implies |
        invertible(sigma) -> forall k: Nat; forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, k)), inverseFn(sigma)) = cycle(t, k)
        [by discharge given-invertible]
    }
  @conclusion |
    forall sigma: Fn; invertible(sigma) -> forall k: Nat; forall s: Points; forall t: Points; (forall i: Nat; less_than(i, succ(k)) -> at(t, i) = apply(sigma, at(s, i))) -> compose(compose(sigma, cycle(s, k)), inverseFn(sigma)) = cycle(t, k)
    [by generalize generalize-sigma]
qed

// -- how a cycle's INVERSE acts on its own points -------------------------------------------
//
// `cycleAdvances` / `cycleWrapsAround` say where a cycle SENDS each listed point. These say
// where its inverse sends them: back one, and the first back to the last. Conjugating by a
// cycle's inverse needs exactly this — and needs it at only a FEW points, which is what keeps
// a conjugation argument over a cycle of VARIABLE length from needing induction on that
// length (the conjugated object's point count is what bounds the work, not the cycle's).

// c⁻¹ undoes c at every point. (A local copy of decomposition.b4m's lemma, which sits in a
// file this one must not depend on; it is three lines from the inverse axioms.)
theorem anInverseUndoesItsMapAtAPoint: forall c: Fn; invertible(c) ->
  forall w: Element; apply(inverseFn(c), apply(c, w)) = w
proof
  @generalize-c |
    fix c: Fn {
      @given-invertible |
        assume invertible(c) {
          @c-invertible |
            invertible(c)
            [by hypothesis given-invertible]
          @inverse-cancels |
            compose(inverseFn(c), c) = identityFn
            [using specialize inverseLeft(c) c-invertible]
          @generalize-w |
            fix w: Element {
              @composite-applies |
                apply(compose(inverseFn(c), c), w) = apply(inverseFn(c), apply(c, w))
                [using specialize composeApply(inverseFn(c), c, w)]
              @identity-fixes-w |
                apply(identityFn, w) = w
                [using specialize identityApply(w)]
              @conclusion-undone-at-w |
                apply(inverseFn(c), apply(c, w)) = w
                [using chain composite-applies inverse-cancels identity-fixes-w]
            }
          @conclusion-undone |
            forall w: Element; apply(inverseFn(c), apply(c, w)) = w
            [by generalize generalize-w]
        }
      @conclusion-for-c |
        invertible(c) -> forall w: Element; apply(inverseFn(c), apply(c, w)) = w
        [by discharge given-invertible]
    }
  @conclusion |
    forall c: Fn; invertible(c) -> forall w: Element; apply(inverseFn(c), apply(c, w)) = w
    [by generalize generalize-c]
qed

// The INVERSE of a cycle RETREATS each listed point to the one before: c⁻¹(a_{i+1}) = a_i
// for i < k. Immediate from `cycleAdvances` (c carries a_i to a_{i+1}) composed with
// `anInverseUndoesItsMapAtAPoint`.
theorem aCycleInverseRetreats: forall s: Points; forall k: Nat;
  distinct(s, succ(k)) ->
  forall i: Nat; less_than(i, k) -> apply(inverseFn(cycle(s, succ(k))), at(s, succ(i))) = at(s, i)
proof
  @generalize-s |
    fix s: Points {
      @generalize-k |
        fix k: Nat {
          @given-distinct |
            assume distinct(s, succ(k)) {
              @the-points-are-distinct |
                distinct(s, succ(k))
                [by hypothesis given-distinct]
              @the-cycle-is-a-permutation |
                invertible(cycle(s, succ(k)))
                [using specialize cycleIsAPermutation(s, succ(k))]
              @the-inverse-undoes-the-cycle |
                forall w: Element; apply(inverseFn(cycle(s, succ(k))), apply(cycle(s, succ(k)), w)) = w
                [using specialize anInverseUndoesItsMapAtAPoint(cycle(s, succ(k))) the-cycle-is-a-permutation]
              @the-cycle-advances-its-points |
                forall i: Nat; less_than(i, k) -> apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i))
                [using specialize cycleAdvances(s, k) the-points-are-distinct]
              @generalize-i |
                fix i: Nat {
                  @given-i-below-k |
                    assume less_than(i, k) {
                      @i-below-k |
                        less_than(i, k)
                        [by hypothesis given-i-below-k]
                      @the-cycle-advances-point-i |
                        apply(cycle(s, succ(k)), at(s, i)) = at(s, succ(i))
                        [using specialize the-cycle-advances-its-points(i) i-below-k]
                      @the-inverse-undoes-point-i |
                        apply(inverseFn(cycle(s, succ(k))), apply(cycle(s, succ(k)), at(s, i))) = at(s, i)
                        [using specialize the-inverse-undoes-the-cycle(at(s, i))]
                      @conclusion-retreats-at-i |
                        apply(inverseFn(cycle(s, succ(k))), at(s, succ(i))) = at(s, i)
                        [using chain the-cycle-advances-point-i the-inverse-undoes-point-i]
                    }
                  @conclusion-i-below-k-retreats |
                    less_than(i, k) -> apply(inverseFn(cycle(s, succ(k))), at(s, succ(i))) = at(s, i)
                    [by discharge given-i-below-k]
                }
              @conclusion-retreats |
                forall i: Nat; less_than(i, k) -> apply(inverseFn(cycle(s, succ(k))), at(s, succ(i))) = at(s, i)
                [by generalize generalize-i]
            }
          @conclusion-for-k |
            distinct(s, succ(k)) ->
              forall i: Nat; less_than(i, k) -> apply(inverseFn(cycle(s, succ(k))), at(s, succ(i))) = at(s, i)
            [by discharge given-distinct]
        }
      @discharge-k |
        forall k: Nat; distinct(s, succ(k)) ->
          forall i: Nat; less_than(i, k) -> apply(inverseFn(cycle(s, succ(k))), at(s, succ(i))) = at(s, i)
        [by generalize generalize-k]
    }
  @conclusion |
    forall s: Points; forall k: Nat;
      distinct(s, succ(k)) ->
      forall i: Nat; less_than(i, k) -> apply(inverseFn(cycle(s, succ(k))), at(s, succ(i))) = at(s, i)
    [by generalize generalize-s]
qed

// ...and sends the FIRST point back to the LAST: c⁻¹(a₀) = a_k, by `cycleWrapsAround`.
theorem aCycleInverseWrapsBackward: forall s: Points; forall k: Nat;
  distinct(s, succ(k)) -> apply(inverseFn(cycle(s, succ(k))), at(s, ZERO)) = at(s, k)
proof
  @generalize-s |
    fix s: Points {
      @generalize-k |
        fix k: Nat {
          @given-distinct |
            assume distinct(s, succ(k)) {
              @the-points-are-distinct |
                distinct(s, succ(k))
                [by hypothesis given-distinct]
              @the-cycle-is-a-permutation |
                invertible(cycle(s, succ(k)))
                [using specialize cycleIsAPermutation(s, succ(k))]
              @the-cycle-wraps-the-last-point |
                apply(cycle(s, succ(k)), at(s, k)) = at(s, ZERO)
                [using specialize cycleWrapsAround(s, k) the-points-are-distinct]
              @the-inverse-undoes-the-cycle |
                forall w: Element; apply(inverseFn(cycle(s, succ(k))), apply(cycle(s, succ(k)), w)) = w
                [using specialize anInverseUndoesItsMapAtAPoint(cycle(s, succ(k))) the-cycle-is-a-permutation]
              @the-inverse-undoes-the-last-point |
                apply(inverseFn(cycle(s, succ(k))), apply(cycle(s, succ(k)), at(s, k))) = at(s, k)
                [using specialize the-inverse-undoes-the-cycle(at(s, k))]
              @conclusion-wraps-backward |
                apply(inverseFn(cycle(s, succ(k))), at(s, ZERO)) = at(s, k)
                [using chain the-cycle-wraps-the-last-point the-inverse-undoes-the-last-point]
            }
          @conclusion-for-k |
            distinct(s, succ(k)) -> apply(inverseFn(cycle(s, succ(k))), at(s, ZERO)) = at(s, k)
            [by discharge given-distinct]
        }
      @discharge-k |
        forall k: Nat; distinct(s, succ(k)) -> apply(inverseFn(cycle(s, succ(k))), at(s, ZERO)) = at(s, k)
        [by generalize generalize-k]
    }
  @conclusion |
    forall s: Points; forall k: Nat;
      distinct(s, succ(k)) -> apply(inverseFn(cycle(s, succ(k))), at(s, ZERO)) = at(s, k)
    [by generalize generalize-s]
qed
