// Judson's Lemma 10.2 identities — every 3-cycle in terms of a FIXED pair (i,j).
//
// Lemma 2 of §10.2 ("if a normal subgroup of A_n contains a 3-cycle, it is all of A_n")
// turns on rewriting an ARBITRARY 3-cycle as a product of 3-cycles of the single family
// `(i,j,k)` with i and j fixed and k varying. Judson gives four identities:
//
//     (i,a,j) = (i,j,a)^2
//     (i,a,b) = (i,j,b)(i,j,a)^2
//     (j,a,b) = (i,j,b)^2(i,j,a)
//     (a,b,c) = (i,j,a)^2(i,j,c)(i,j,b)^2(i,j,a)
//
// Each is proved the same way, and it is worth stating the method once because every proof
// below is an instance of it:
//
//   1. A 3-CYCLE IS TWO TRANSPOSITIONS. std's cycle fold gives
//      `cycle(s,3) = (a0 a2) o (a0 a1) o ((a0 a0) o id)`, so `(x,y,z)` is
//      `compose(transposition(x, z), transposition(x, y))` — see
//      `aThreeCycleIsTwoTranspositions` in alternating.b4m. Both sides of every identity
//      are therefore `compose`-trees of transpositions, and the right-hand sides run from
//      four factors up to TWELVE (six 3-cycles) for the last identity.
//   2. UNFOLD WITH THE ACCELERANT, not a helper. `[using simplify composeApply]` turns a
//      composite applied at a point into a nested `apply`, for any length and any nesting.
//      (An earlier draft hand-wrote `twoFactorValue`/`fourFactorValue`/`sixFactorValue`;
//      they were one fact — `composeApply` — restated per shape, and a treadmill. Deleted.)
//   3. EVALUATE FACTOR BY FACTOR with `transpositionAtFirst` / `AtSecond` / `Elsewhere`.
//   4. CASE SPLIT on where the point sits (each named letter, then "elsewhere"), and close
//      with `funcExtensionality`.
//
// Two toolchain facts this file depends on: `chain` is the orientation-free joiner (plain
// `simplify` cannot close these — it orients each equation left-to-right and the middle
// step must run backward), and `chain` REJECTS a repeated ref, so a value that recurs is
// stated once. `tautology` sees `a != c` and `c != a` as unrelated atoms, hence
// `disequalityIsSymmetric` from alternating.b4m.
//
// Every identity here was first verified COMPUTATIONALLY over the relevant points before
// any proof was written; that check caught a mis-trace in §10.2's Lemma 1 work.
import permutation <<< "std/permutation.b4m"
import function <<< "std/function.b4m"
import alternating <<< "std/permutation/alternating.b4m"
import permutation_parity <<< "std/permutation/parity.b4m"
import permutation_cycle <<< "std/permutation/cycle.b4m"

sort Element = permutation.Element
sort Fn = permutation.Fn

func compose = permutation.compose
func apply = permutation.apply
func transposition = permutation.transposition

fact composeApply = function.composeApply
fact funcExtensionality = function.funcExtensionality
fact transpositionAtFirst = permutation.transpositionAtFirst
fact transpositionAtSecond = permutation.transpositionAtSecond
fact transpositionElsewhere = permutation.transpositionElsewhere
fact disequalityIsSymmetric = alternating.disequalityIsSymmetric
const identityFn = permutation.identityFn
func inverse = permutation.inverse
pred invertible = permutation.invertible
fact composeAssoc = function.composeAssoc
fact composeIdentityRight = function.composeIdentityRight
fact composeIdentityLeft = function.composeIdentityLeft
fact transpositionIsAnInvolution = permutation.transpositionIsAnInvolution
fact disjointTranspositionsCommute = permutation_parity.disjointTranspositionsCommute
fact aTwoSidedInverseIsUnique = function.aTwoSidedInverseIsUnique
fact transpositionIsAPermutation = permutation.transpositionIsAPermutation
fact composeIsAPermutation = permutation.composeIsAPermutation
fact conjugationIsMultiplicative = permutation_cycle.conjugationIsMultiplicative
fact conjugateOfATransposition = permutation_cycle.conjugateOfATransposition
fact transpositionIsSymmetric = permutation_parity.transpositionIsSymmetric

// -- identity (1): (i,a,j) = (i,j,a)^2 -----------------------------------------------------

theorem squareAgreesAtI: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, j), transposition(i, a)), i) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @a-not-i |
                            a != i
                            [using specialize disequalityIsSymmetric(i, a) i-not-a]
                          @a-not-j |
                            a != j
                            [using specialize disequalityIsSymmetric(j, a) j-not-a]
                          @j-not-i |
                            j != i
                            [using specialize disequalityIsSymmetric(i, j) i-not-j]
                          @ia-sends-i |
                            apply(transposition(i, a), i) = a
                            [using specialize transpositionAtFirst(i, a)]
                          @ij-sends-i |
                            apply(transposition(i, j), i) = j
                            [using specialize transpositionAtFirst(i, j)]
                          @ij-fixes-a |
                            apply(transposition(i, j), a) = a
                            [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                          @ia-fixes-j |
                            apply(transposition(i, a), j) = j
                            [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                          @ij-sends-j |
                            apply(transposition(i, j), j) = i
                            [using specialize transpositionAtSecond(i, j)]
                          @lhs-split |
                            apply(compose(transposition(i, j), transposition(i, a)), i) = apply(transposition(i, j), apply(transposition(i, a), i))
                            [using simplify composeApply]
                          @lhs-value |
                            apply(compose(transposition(i, j), transposition(i, a)), i) = a
                            [using chain lhs-split ia-sends-i ij-fixes-a]
                          @rhs-split |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i) =
                              apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), i))))
                            [using simplify composeApply]
                          @rhs-value |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i) = a
                            [using chain rhs-split ij-sends-i ia-fixes-j ij-sends-j ia-sends-i]
                          @conclusion-agree |
                            apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                            [using chain lhs-value rhs-value]
                        }
                      @conclusion-j-not-a |
                        j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                        [by discharge given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                    [by discharge given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                [by discharge given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
    [by generalize generalize-i]
qed

theorem squareAgreesAtA: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, j), transposition(i, a)), a) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @a-not-i |
                            a != i
                            [using specialize disequalityIsSymmetric(i, a) i-not-a]
                          @a-not-j |
                            a != j
                            [using specialize disequalityIsSymmetric(j, a) j-not-a]
                          @j-not-i |
                            j != i
                            [using specialize disequalityIsSymmetric(i, j) i-not-j]
                          @ia-sends-a |
                            apply(transposition(i, a), a) = i
                            [using specialize transpositionAtSecond(i, a)]
                          @ij-sends-i |
                            apply(transposition(i, j), i) = j
                            [using specialize transpositionAtFirst(i, j)]
                          @ij-fixes-a |
                            apply(transposition(i, j), a) = a
                            [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                          @ia-fixes-j |
                            apply(transposition(i, a), j) = j
                            [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                          @lhs-split |
                            apply(compose(transposition(i, j), transposition(i, a)), a) = apply(transposition(i, j), apply(transposition(i, a), a))
                            [using simplify composeApply]
                          @lhs-value |
                            apply(compose(transposition(i, j), transposition(i, a)), a) = j
                            [using chain lhs-split ia-sends-a ij-sends-i]
                          @rhs-split |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a) =
                              apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), a))))
                            [using simplify composeApply]
                          @rhs-value |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a) = j
                            [using chain rhs-split ij-fixes-a ia-sends-a ij-sends-i ia-fixes-j]
                          @conclusion-agree |
                            apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                            [using chain lhs-value rhs-value]
                        }
                      @conclusion-j-not-a |
                        j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                        [by discharge given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                    [by discharge given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                [by discharge given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
    [by generalize generalize-i]
qed

theorem squareAgreesAtJ: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, j), transposition(i, a)), j) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @a-not-i |
                            a != i
                            [using specialize disequalityIsSymmetric(i, a) i-not-a]
                          @a-not-j |
                            a != j
                            [using specialize disequalityIsSymmetric(j, a) j-not-a]
                          @j-not-i |
                            j != i
                            [using specialize disequalityIsSymmetric(i, j) i-not-j]
                          @ia-fixes-j |
                            apply(transposition(i, a), j) = j
                            [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                          @ij-sends-j |
                            apply(transposition(i, j), j) = i
                            [using specialize transpositionAtSecond(i, j)]
                          @ia-sends-i |
                            apply(transposition(i, a), i) = a
                            [using specialize transpositionAtFirst(i, a)]
                          @ij-fixes-a |
                            apply(transposition(i, j), a) = a
                            [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                          @ia-sends-a |
                            apply(transposition(i, a), a) = i
                            [using specialize transpositionAtSecond(i, a)]
                          @lhs-split |
                            apply(compose(transposition(i, j), transposition(i, a)), j) = apply(transposition(i, j), apply(transposition(i, a), j))
                            [using simplify composeApply]
                          @lhs-value |
                            apply(compose(transposition(i, j), transposition(i, a)), j) = i
                            [using chain lhs-split ia-fixes-j ij-sends-j]
                          @rhs-split |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j) =
                              apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), j))))
                            [using simplify composeApply]
                          @rhs-value |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j) = i
                            [using chain rhs-split ij-sends-j ia-sends-i ij-fixes-a ia-sends-a]
                          @conclusion-agree |
                            apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                            [using chain lhs-value rhs-value]
                        }
                      @conclusion-j-not-a |
                        j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                        [by discharge given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                    [by discharge given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                [by discharge given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
    [by generalize generalize-i]
qed

theorem squareAgreesAtElsewhere: forall i, j, a, x: Element;
  x != i -> x != j -> x != a ->
  apply(compose(transposition(i, j), transposition(i, a)), x) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-x |
                fix x: Element {
                  @given-x-not-i |
                    assume x != i {
                      @given-x-not-j |
                        assume x != j {
                          @given-x-not-a |
                            assume x != a {
                              @x-not-i |
                                x != i
                                [by hypothesis given-x-not-i]
                              @x-not-j |
                                x != j
                                [by hypothesis given-x-not-j]
                              @x-not-a |
                                x != a
                                [by hypothesis given-x-not-a]
                              @ij-fixes-x |
                                apply(transposition(i, j), x) = x
                                [using specialize transpositionElsewhere(i, j, x) x-not-i x-not-j]
                              @ia-fixes-x |
                                apply(transposition(i, a), x) = x
                                [using specialize transpositionElsewhere(i, a, x) x-not-i x-not-a]
                              @lhs-split |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = apply(transposition(i, j), apply(transposition(i, a), x))
                                [using simplify composeApply]
                              @lhs-value |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = x
                                [using chain lhs-split ia-fixes-x ij-fixes-x]
                              @rhs-split |
                                apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x) =
                                  apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), x))))
                                [using simplify composeApply]
                              @rhs-value |
                                apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x) = x
                                [using chain rhs-split ij-fixes-x ia-fixes-x]
                              @conclusion-agree |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-x-not-a |
                            x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                            [by discharge given-x-not-a]
                        }
                      @conclusion-x-not-j |
                        x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                        [by discharge given-x-not-j]
                    }
                  @conclusion-x-not-i |
                    x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                    [by discharge given-x-not-i]
                }
              @discharge-x |
                forall x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                [by generalize generalize-x]
            }
          @discharge-a |
            forall a, x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
    [by generalize generalize-i]
qed

// The pointwise agreement behind identity (1): four cases on where x sits.
theorem theSquareAgreesEverywhere: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  forall x: Element;
  apply(compose(transposition(i, j), transposition(i, a)), x) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @generalize-x |
                            fix x: Element {
                              @cases |
                                x = i or x = j or x = a or (x != i and x != j and x != a)
                                [using tautology]
                              @conclusion-at-x |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                case cases {
                                  @when-x-is-i |
                                    assume x = i {
                                      @x-is-i |
                                        x = i
                                        [by hypothesis when-x-is-i]
                                      @agree-at-i |
                                        apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                                        [using specialize squareAgreesAtI(i, j, a) i-not-j i-not-a j-not-a]
                                      @conclusion-when-x-is-i |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [by rewrite x-is-i agree-at-i]
                                    }
                                  @when-x-is-j |
                                    assume x = j {
                                      @x-is-j |
                                        x = j
                                        [by hypothesis when-x-is-j]
                                      @agree-at-j |
                                        apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                                        [using specialize squareAgreesAtJ(i, j, a) i-not-j i-not-a j-not-a]
                                      @conclusion-when-x-is-j |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [by rewrite x-is-j agree-at-j]
                                    }
                                  @when-x-is-a |
                                    assume x = a {
                                      @x-is-a |
                                        x = a
                                        [by hypothesis when-x-is-a]
                                      @agree-at-a |
                                        apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                                        [using specialize squareAgreesAtA(i, j, a) i-not-j i-not-a j-not-a]
                                      @conclusion-when-x-is-a |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [by rewrite x-is-a agree-at-a]
                                    }
                                  @when-x-is-elsewhere |
                                    assume x != i and x != j and x != a {
                                      @x-is-elsewhere |
                                        x != i and x != j and x != a
                                        [by hypothesis when-x-is-elsewhere]
                                      @x-not-i |
                                        x != i
                                        [using tautology x-is-elsewhere]
                                      @x-not-j |
                                        x != j
                                        [using tautology x-is-elsewhere]
                                      @x-not-a |
                                        x != a
                                        [using tautology x-is-elsewhere]
                                      @conclusion-when-x-is-elsewhere |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [using specialize squareAgreesAtElsewhere(i, j, a, x) x-not-i x-not-j x-not-a]
                                    }
                                }
                            }
                          @discharge-x |
                            forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                            [by generalize generalize-x]
                        }
                      @conclusion-j-not-a |
                        j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                        [by discharge given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                    [by discharge given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                [by discharge given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
    [by generalize generalize-i]
qed

// Judson Lemma 2, identity (1): (i,a,j) = (i,j,a)^2.
theorem aThreeCycleIsTheSquareOfItsTwist: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @agree-everywhere |
                            forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                            [using specialize theSquareAgreesEverywhere(i, j, a) i-not-j i-not-a j-not-a]
                          @conclusion-equal |
                            compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                            [using specialize funcExtensionality(compose(transposition(i, j), transposition(i, a)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))) agree-everywhere]
                        }
                      @conclusion-j-not-a |
                        j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                        [by discharge given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                    [by discharge given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                [by discharge given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a ->
      compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
    [by generalize generalize-i]
qed

// -- identity (2): (i,a,b) = (i,j,b)(i,j,a)^2 ----------------------------------------------
//
// As transposition trees, with the rightmost factor applied first:
//     LHS  (i,a,b)            = (ib)(ia)
//     RHS  (i,j,b)(i,j,a)^2   = (ib)(ij) · (ia)(ij) · (ia)(ij)
// Six factors on the right, four letters, so five point-cases.

// at i: LHS (ia) sends i to a and (ib) fixes a.
//       RHS (ij): i->j, (ia) fixes j, (ij): j->i, (ia): i->a, then (ij) and (ib) fix a.
theorem secondIdentityAgreesAtI: forall i, j, a, b: Element;
  i != j -> i != a -> j != a -> a != b ->
  apply(compose(transposition(i, b), transposition(i, a)), i) =
  apply(compose(compose(transposition(i, b), transposition(i, j)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))), i)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-j-not-a |
                            assume j != a {
                              @given-a-not-b |
                                assume a != b {
                                  @i-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @i-not-a |
                                    i != a
                                    [by hypothesis given-i-not-a]
                                  @j-not-a |
                                    j != a
                                    [by hypothesis given-j-not-a]
                                  @a-not-b |
                                    a != b
                                    [by hypothesis given-a-not-b]
                                  @j-not-i |
                                    j != i
                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                  @a-not-i |
                                    a != i
                                    [using specialize disequalityIsSymmetric(i, a) i-not-a]
                                  @a-not-j |
                                    a != j
                                    [using specialize disequalityIsSymmetric(j, a) j-not-a]
                                  // the factor values this case needs
                                  @ia-sends-i |
                                    apply(transposition(i, a), i) = a
                                    [using specialize transpositionAtFirst(i, a)]
                                  @ib-fixes-a |
                                    apply(transposition(i, b), a) = a
                                    [using specialize transpositionElsewhere(i, b, a) a-not-i a-not-b]
                                  @ij-sends-i |
                                    apply(transposition(i, j), i) = j
                                    [using specialize transpositionAtFirst(i, j)]
                                  @ia-fixes-j |
                                    apply(transposition(i, a), j) = j
                                    [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                                  @ij-sends-j |
                                    apply(transposition(i, j), j) = i
                                    [using specialize transpositionAtSecond(i, j)]
                                  @ij-fixes-a |
                                    apply(transposition(i, j), a) = a
                                    [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                                  @lhs-split |
                                    apply(compose(transposition(i, b), transposition(i, a)), i) =
                                      apply(transposition(i, b), apply(transposition(i, a), i))
                                    [using simplify composeApply]
                                  @lhs-value |
                                    apply(compose(transposition(i, b), transposition(i, a)), i) = a
                                    [using chain lhs-split ia-sends-i ib-fixes-a]
                                  @rhs-split |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), i) =
                                      apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), i))))))
                                    [using simplify composeApply]
                                  @rhs-value |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), i) = a
                                    [using simplify rhs-split ij-sends-i ia-fixes-j ij-sends-j ia-sends-i ij-fixes-a ib-fixes-a]
                                  @conclusion-agree |
                                    apply(compose(transposition(i, b), transposition(i, a)), i) =
                                      apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), i)
                                    [using chain lhs-value rhs-value]
                                }
                              @conclusion-a-not-b |
                                a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                [by discharge given-a-not-b]
                            }
                          @conclusion-j-not-a |
                            j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                            [by discharge given-j-not-a]
                        }
                      @conclusion-i-not-a |
                        i != a -> j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                        [by discharge given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                    [by discharge given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element;
      i != j -> i != a -> j != a -> a != b ->
      apply(compose(transposition(i, b), transposition(i, a)), i) =
      apply(compose(compose(transposition(i, b), transposition(i, j)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))), i)
    [by generalize generalize-i]
qed

// at j: LHS both factors fix j.
//       RHS (ij): j->i, (ia): i->a, (ij) fixes a, (ia): a->i, (ij): i->j, (ib) fixes j.
theorem secondIdentityAgreesAtJ: forall i, j, a, b: Element;
  i != j -> i != a -> j != a -> j != b ->
  apply(compose(transposition(i, b), transposition(i, a)), j) =
  apply(compose(compose(transposition(i, b), transposition(i, j)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))), j)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-j-not-a |
                            assume j != a {
                              @given-j-not-b |
                                assume j != b {
                                  @i-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @i-not-a |
                                    i != a
                                    [by hypothesis given-i-not-a]
                                  @j-not-a |
                                    j != a
                                    [by hypothesis given-j-not-a]
                                  @j-not-b |
                                    j != b
                                    [by hypothesis given-j-not-b]
                                  @j-not-i |
                                    j != i
                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                  @a-not-i |
                                    a != i
                                    [using specialize disequalityIsSymmetric(i, a) i-not-a]
                                  @a-not-j |
                                    a != j
                                    [using specialize disequalityIsSymmetric(j, a) j-not-a]
                                  @ia-fixes-j |
                                    apply(transposition(i, a), j) = j
                                    [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                                  @ib-fixes-j |
                                    apply(transposition(i, b), j) = j
                                    [using specialize transpositionElsewhere(i, b, j) j-not-i j-not-b]
                                  @ij-sends-j |
                                    apply(transposition(i, j), j) = i
                                    [using specialize transpositionAtSecond(i, j)]
                                  @ia-sends-i |
                                    apply(transposition(i, a), i) = a
                                    [using specialize transpositionAtFirst(i, a)]
                                  @ij-fixes-a |
                                    apply(transposition(i, j), a) = a
                                    [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                                  @ia-sends-a |
                                    apply(transposition(i, a), a) = i
                                    [using specialize transpositionAtSecond(i, a)]
                                  @ij-sends-i |
                                    apply(transposition(i, j), i) = j
                                    [using specialize transpositionAtFirst(i, j)]
                                  @lhs-split |
                                    apply(compose(transposition(i, b), transposition(i, a)), j) =
                                      apply(transposition(i, b), apply(transposition(i, a), j))
                                    [using simplify composeApply]
                                  @lhs-value |
                                    apply(compose(transposition(i, b), transposition(i, a)), j) = j
                                    [using simplify lhs-split ia-fixes-j ib-fixes-j]
                                  @rhs-split |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), j) =
                                      apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), j))))))
                                    [using simplify composeApply]
                                  @rhs-value |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), j) = j
                                    [using simplify rhs-split ij-sends-j ia-sends-i ij-fixes-a ia-sends-a ij-sends-i ib-fixes-j]
                                  @conclusion-agree |
                                    apply(compose(transposition(i, b), transposition(i, a)), j) =
                                      apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), j)
                                    [using chain lhs-value rhs-value]
                                }
                              @conclusion-j-not-b |
                                j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                [by discharge given-j-not-b]
                            }
                          @conclusion-j-not-a |
                            j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                            [by discharge given-j-not-a]
                        }
                      @conclusion-i-not-a |
                        i != a -> j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                        [by discharge given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                    [by discharge given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element;
      i != j -> i != a -> j != a -> j != b ->
      apply(compose(transposition(i, b), transposition(i, a)), j) =
      apply(compose(compose(transposition(i, b), transposition(i, j)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))), j)
    [by generalize generalize-i]
qed

// at a: LHS (ia): a->i then (ib): i->b.
//       RHS (ij) fixes a, (ia): a->i, (ij): i->j, (ia) fixes j, (ij): j->i, (ib): i->b.
theorem secondIdentityAgreesAtA: forall i, j, a, b: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, b), transposition(i, a)), a) =
  apply(compose(compose(transposition(i, b), transposition(i, j)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))), a)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-j-not-a |
                            assume j != a {
                              @i-not-j |
                                i != j
                                [by hypothesis given-i-not-j]
                              @i-not-a |
                                i != a
                                [by hypothesis given-i-not-a]
                              @j-not-a |
                                j != a
                                [by hypothesis given-j-not-a]
                              @j-not-i |
                                j != i
                                [using specialize disequalityIsSymmetric(i, j) i-not-j]
                              @a-not-i |
                                a != i
                                [using specialize disequalityIsSymmetric(i, a) i-not-a]
                              @a-not-j |
                                a != j
                                [using specialize disequalityIsSymmetric(j, a) j-not-a]
                              @ia-sends-a |
                                apply(transposition(i, a), a) = i
                                [using specialize transpositionAtSecond(i, a)]
                              @ib-sends-i |
                                apply(transposition(i, b), i) = b
                                [using specialize transpositionAtFirst(i, b)]
                              @ij-fixes-a |
                                apply(transposition(i, j), a) = a
                                [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                              @ij-sends-i |
                                apply(transposition(i, j), i) = j
                                [using specialize transpositionAtFirst(i, j)]
                              @ia-fixes-j |
                                apply(transposition(i, a), j) = j
                                [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                              @ij-sends-j |
                                apply(transposition(i, j), j) = i
                                [using specialize transpositionAtSecond(i, j)]
                              @lhs-split |
                                apply(compose(transposition(i, b), transposition(i, a)), a) =
                                  apply(transposition(i, b), apply(transposition(i, a), a))
                                [using simplify composeApply]
                              @lhs-value |
                                apply(compose(transposition(i, b), transposition(i, a)), a) = b
                                [using simplify lhs-split ia-sends-a ib-sends-i]
                              @rhs-split |
                                apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), a) =
                                  apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), a))))))
                                [using simplify composeApply]
                              @rhs-value |
                                apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), a) = b
                                [using simplify rhs-split ij-fixes-a ia-sends-a ij-sends-i ia-fixes-j ij-sends-j ib-sends-i]
                              @conclusion-agree |
                                apply(compose(transposition(i, b), transposition(i, a)), a) =
                                  apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), a)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-j-not-a |
                            j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                            [by discharge given-j-not-a]
                        }
                      @conclusion-i-not-a |
                        i != a -> j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                        [by discharge given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                    [by discharge given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element;
      i != j -> i != a -> j != a ->
      apply(compose(transposition(i, b), transposition(i, a)), a) =
      apply(compose(compose(transposition(i, b), transposition(i, j)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))), a)
    [by generalize generalize-i]
qed

// at b: every (i,·) factor fixes b except the outermost (ib), which sends b to i.
theorem secondIdentityAgreesAtB: forall i, j, a, b: Element;
  b != i -> b != j -> b != a ->
  apply(compose(transposition(i, b), transposition(i, a)), b) =
  apply(compose(compose(transposition(i, b), transposition(i, j)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))), b)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-b-not-i |
                    assume b != i {
                      @given-b-not-j |
                        assume b != j {
                          @given-b-not-a |
                            assume b != a {
                              @b-not-i |
                                b != i
                                [by hypothesis given-b-not-i]
                              @b-not-j |
                                b != j
                                [by hypothesis given-b-not-j]
                              @b-not-a |
                                b != a
                                [by hypothesis given-b-not-a]
                              @ia-fixes-b |
                                apply(transposition(i, a), b) = b
                                [using specialize transpositionElsewhere(i, a, b) b-not-i b-not-a]
                              @ij-fixes-b |
                                apply(transposition(i, j), b) = b
                                [using specialize transpositionElsewhere(i, j, b) b-not-i b-not-j]
                              @ib-sends-b |
                                apply(transposition(i, b), b) = i
                                [using specialize transpositionAtSecond(i, b)]
                              @lhs-split |
                                apply(compose(transposition(i, b), transposition(i, a)), b) =
                                  apply(transposition(i, b), apply(transposition(i, a), b))
                                [using simplify composeApply]
                              @lhs-value |
                                apply(compose(transposition(i, b), transposition(i, a)), b) = i
                                [using simplify lhs-split ia-fixes-b ib-sends-b]
                              @rhs-split |
                                apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), b) =
                                  apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), b))))))
                                [using simplify composeApply]
                              @rhs-value |
                                apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), b) = i
                                [using simplify rhs-split ij-fixes-b ia-fixes-b ib-sends-b]
                              @conclusion-agree |
                                apply(compose(transposition(i, b), transposition(i, a)), b) =
                                  apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), b)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-b-not-a |
                            b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                            [by discharge given-b-not-a]
                        }
                      @conclusion-b-not-j |
                        b != j -> b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                        [by discharge given-b-not-j]
                    }
                  @conclusion-b-not-i |
                    b != i -> b != j -> b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                    [by discharge given-b-not-i]
                }
              @discharge-b |
                forall b: Element; b != i -> b != j -> b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; b != i -> b != j -> b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; b != i -> b != j -> b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element;
      b != i -> b != j -> b != a ->
      apply(compose(transposition(i, b), transposition(i, a)), b) =
      apply(compose(compose(transposition(i, b), transposition(i, j)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))), b)
    [by generalize generalize-i]
qed

// elsewhere: x is none of i, j, a, b, so every factor fixes it.
theorem secondIdentityAgreesElsewhere: forall i, j, a, b, x: Element;
  x != i -> x != j -> x != a -> x != b ->
  apply(compose(transposition(i, b), transposition(i, a)), x) =
  apply(compose(compose(transposition(i, b), transposition(i, j)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-x |
                    fix x: Element {
                      @given-x-not-i |
                        assume x != i {
                          @given-x-not-j |
                            assume x != j {
                              @given-x-not-a |
                                assume x != a {
                                  @given-x-not-b |
                                    assume x != b {
                                      @x-not-i |
                                        x != i
                                        [by hypothesis given-x-not-i]
                                      @x-not-j |
                                        x != j
                                        [by hypothesis given-x-not-j]
                                      @x-not-a |
                                        x != a
                                        [by hypothesis given-x-not-a]
                                      @x-not-b |
                                        x != b
                                        [by hypothesis given-x-not-b]
                                      @ia-fixes-x |
                                        apply(transposition(i, a), x) = x
                                        [using specialize transpositionElsewhere(i, a, x) x-not-i x-not-a]
                                      @ib-fixes-x |
                                        apply(transposition(i, b), x) = x
                                        [using specialize transpositionElsewhere(i, b, x) x-not-i x-not-b]
                                      @ij-fixes-x |
                                        apply(transposition(i, j), x) = x
                                        [using specialize transpositionElsewhere(i, j, x) x-not-i x-not-j]
                                      @lhs-split |
                                        apply(compose(transposition(i, b), transposition(i, a)), x) =
                                          apply(transposition(i, b), apply(transposition(i, a), x))
                                        [using simplify composeApply]
                                      @lhs-value |
                                        apply(compose(transposition(i, b), transposition(i, a)), x) = x
                                        [using simplify lhs-split ia-fixes-x ib-fixes-x]
                                      @rhs-split |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)),
                                          compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))), x) =
                                          apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), x))))))
                                        [using simplify composeApply]
                                      @rhs-value |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)),
                                          compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))), x) = x
                                        [using simplify rhs-split ij-fixes-x ia-fixes-x ib-fixes-x]
                                      @conclusion-agree |
                                        apply(compose(transposition(i, b), transposition(i, a)), x) =
                                          apply(compose(compose(transposition(i, b), transposition(i, j)),
                                          compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))), x)
                                        [using chain lhs-value rhs-value]
                                    }
                                  @conclusion-x-not-b |
                                    x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                    [by discharge given-x-not-b]
                                }
                              @conclusion-x-not-a |
                                x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                [by discharge given-x-not-a]
                            }
                          @conclusion-x-not-j |
                            x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                            [by discharge given-x-not-j]
                        }
                      @conclusion-x-not-i |
                        x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                        [by discharge given-x-not-i]
                    }
                  @discharge-x |
                    forall x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                    [by generalize generalize-x]
                }
              @discharge-b |
                forall b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b, x: Element;
      x != i -> x != j -> x != a -> x != b ->
      apply(compose(transposition(i, b), transposition(i, a)), x) =
      apply(compose(compose(transposition(i, b), transposition(i, j)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))), x)
    [by generalize generalize-i]
qed

// The pointwise agreement behind identity (2): five cases on where x sits. Each named
// letter uses only the distinctness facts its own trace cites, so the symmetric forms
// (`b != i` for the case at b) are derived here from the statement's hypotheses.
theorem theSecondIdentityAgreesEverywhere: forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  forall x: Element;
  apply(compose(transposition(i, b), transposition(i, a)), x) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-b |
                                    assume j != b {
                                      @given-a-not-b |
                                        assume a != b {
                                          @i-not-j |
                                            i != j
                                            [by hypothesis given-i-not-j]
                                          @i-not-a |
                                            i != a
                                            [by hypothesis given-i-not-a]
                                          @i-not-b |
                                            i != b
                                            [by hypothesis given-i-not-b]
                                          @j-not-a |
                                            j != a
                                            [by hypothesis given-j-not-a]
                                          @j-not-b |
                                            j != b
                                            [by hypothesis given-j-not-b]
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-not-b]
                                          @b-not-i |
                                            b != i
                                            [using specialize disequalityIsSymmetric(i, b) i-not-b]
                                          @b-not-j |
                                            b != j
                                            [using specialize disequalityIsSymmetric(j, b) j-not-b]
                                          @b-not-a |
                                            b != a
                                            [using specialize disequalityIsSymmetric(a, b) a-not-b]
                                          @generalize-x |
                                            fix x: Element {
                                              @cases |
                                                x = i or x = j or x = a or x = b or (x != i and x != j and x != a and x != b)
                                                [using tautology]
                                              @conclusion-at-x |
                                                apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                case cases {
                                                  @when-x-is-i |
                                                    assume x = i {
                                                      @x-is-i |
                                                        x = i
                                                        [by hypothesis when-x-is-i]
                                                      @agree-at-i |
                                                        apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                                        [using specialize secondIdentityAgreesAtI(i, j, a, b) i-not-j i-not-a j-not-a a-not-b]
                                                      @conclusion-when-x-is-i |
                                                        apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-i agree-at-i]
                                                    }
                                                  @when-x-is-j |
                                                    assume x = j {
                                                      @x-is-j |
                                                        x = j
                                                        [by hypothesis when-x-is-j]
                                                      @agree-at-j |
                                                        apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                                        [using specialize secondIdentityAgreesAtJ(i, j, a, b) i-not-j i-not-a j-not-a j-not-b]
                                                      @conclusion-when-x-is-j |
                                                        apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-j agree-at-j]
                                                    }
                                                  @when-x-is-a |
                                                    assume x = a {
                                                      @x-is-a |
                                                        x = a
                                                        [by hypothesis when-x-is-a]
                                                      @agree-at-a |
                                                        apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                                        [using specialize secondIdentityAgreesAtA(i, j, a, b) i-not-j i-not-a j-not-a]
                                                      @conclusion-when-x-is-a |
                                                        apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-a agree-at-a]
                                                    }
                                                  @when-x-is-b |
                                                    assume x = b {
                                                      @x-is-b |
                                                        x = b
                                                        [by hypothesis when-x-is-b]
                                                      @agree-at-b |
                                                        apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                                        [using specialize secondIdentityAgreesAtB(i, j, a, b) b-not-i b-not-j b-not-a]
                                                      @conclusion-when-x-is-b |
                                                        apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-b agree-at-b]
                                                    }
                                                  @when-x-is-elsewhere |
                                                    assume x != i and x != j and x != a and x != b {
                                                      @x-is-elsewhere |
                                                        x != i and x != j and x != a and x != b
                                                        [by hypothesis when-x-is-elsewhere]
                                                      @x-not-i |
                                                        x != i
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-j |
                                                        x != j
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-a |
                                                        x != a
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-b |
                                                        x != b
                                                        [using tautology x-is-elsewhere]
                                                      @conclusion-when-x-is-elsewhere |
                                                        apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [using specialize secondIdentityAgreesElsewhere(i, j, a, b, x) x-not-i x-not-j x-not-a x-not-b]
                                                    }
                                                }
                                            }
                                          @discharge-x |
                                            forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                            [by generalize generalize-x]
                                        }
                                      @conclusion-a-not-b |
                                        a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                        [by discharge given-a-not-b]
                                    }
                                  @conclusion-j-not-b |
                                    j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                    [by discharge given-j-not-b]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                [by discharge given-j-not-a]
                            }
                          @conclusion-i-not-b |
                            i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                            [by discharge given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                        [by discharge given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                    [by discharge given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
    [by generalize generalize-i]
qed

// Judson Lemma 2, identity (2): (i,a,b) = (i,j,b)(i,j,a)^2.
theorem aThreeCycleOffTheFixedPairFactors: forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  compose(transposition(i, b), transposition(i, a)) =
  compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-b |
                                    assume j != b {
                                      @given-a-not-b |
                                        assume a != b {
                                          @i-not-j |
                                            i != j
                                            [by hypothesis given-i-not-j]
                                          @i-not-a |
                                            i != a
                                            [by hypothesis given-i-not-a]
                                          @i-not-b |
                                            i != b
                                            [by hypothesis given-i-not-b]
                                          @j-not-a |
                                            j != a
                                            [by hypothesis given-j-not-a]
                                          @j-not-b |
                                            j != b
                                            [by hypothesis given-j-not-b]
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-not-b]
                                          @agree-everywhere |
                                            forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                            [using specialize theSecondIdentityAgreesEverywhere(i, j, a, b) i-not-j i-not-a i-not-b j-not-a j-not-b a-not-b]
                                          @conclusion-equal |
                                            compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                            [using specialize funcExtensionality(compose(transposition(i, b), transposition(i, a)), compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))) agree-everywhere]
                                        }
                                      @conclusion-a-not-b |
                                        a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                        [by discharge given-a-not-b]
                                    }
                                  @conclusion-j-not-b |
                                    j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                    [by discharge given-j-not-b]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                [by discharge given-j-not-a]
                            }
                          @conclusion-i-not-b |
                            i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                            [by discharge given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                        [by discharge given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                    [by discharge given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
      compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
    [by generalize generalize-i]
qed

// at i: LHS both (j,·) factors fix i.
//       RHS (ij): i->j, (ia) fixes j, (ij): j->i, (ib): i->b, (ij) fixes b, (ib): b->i.
theorem thirdIdentityAgreesAtI: forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b ->
  apply(compose(transposition(j, b), transposition(j, a)), i) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-b |
                                    assume j != b {
                                      @i-not-j |
                                        i != j
                                        [by hypothesis given-i-not-j]
                                      @i-not-a |
                                        i != a
                                        [by hypothesis given-i-not-a]
                                      @i-not-b |
                                        i != b
                                        [by hypothesis given-i-not-b]
                                      @j-not-a |
                                        j != a
                                        [by hypothesis given-j-not-a]
                                      @j-not-b |
                                        j != b
                                        [by hypothesis given-j-not-b]
                                      @j-not-i |
                                        j != i
                                        [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                      @b-not-i |
                                        b != i
                                        [using specialize disequalityIsSymmetric(i, b) i-not-b]
                                      @b-not-j |
                                        b != j
                                        [using specialize disequalityIsSymmetric(j, b) j-not-b]
                                      @ja-fixes-i |
                                        apply(transposition(j, a), i) = i
                                        [using specialize transpositionElsewhere(j, a, i) i-not-j i-not-a]
                                      @jb-fixes-i |
                                        apply(transposition(j, b), i) = i
                                        [using specialize transpositionElsewhere(j, b, i) i-not-j i-not-b]
                                      @ij-sends-i |
                                        apply(transposition(i, j), i) = j
                                        [using specialize transpositionAtFirst(i, j)]
                                      @ia-fixes-j |
                                        apply(transposition(i, a), j) = j
                                        [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                                      @ij-sends-j |
                                        apply(transposition(i, j), j) = i
                                        [using specialize transpositionAtSecond(i, j)]
                                      @ib-sends-i |
                                        apply(transposition(i, b), i) = b
                                        [using specialize transpositionAtFirst(i, b)]
                                      @ij-fixes-b |
                                        apply(transposition(i, j), b) = b
                                        [using specialize transpositionElsewhere(i, j, b) b-not-i b-not-j]
                                      @ib-sends-b |
                                        apply(transposition(i, b), b) = i
                                        [using specialize transpositionAtSecond(i, b)]
                                      @lhs-split |
                                        apply(compose(transposition(j, b), transposition(j, a)), i) = apply(transposition(j, b), apply(transposition(j, a), i))
                                        [using simplify composeApply]
                                      @lhs-value |
                                        apply(compose(transposition(j, b), transposition(j, a)), i) = i
                                        [using simplify lhs-split ja-fixes-i jb-fixes-i]
                                      @rhs-split |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i) =
                                          apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), i))))))
                                        [using simplify composeApply]
                                      @rhs-value |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i) = i
                                        [using simplify rhs-split ij-sends-i ia-fixes-j ij-sends-j ib-sends-i ij-fixes-b ib-sends-b]
                                      @conclusion-agree |
                                        apply(compose(transposition(j, b), transposition(j, a)), i) =
                                          apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                        [using chain lhs-value rhs-value]
                                    }
                                  @conclusion-j-not-b |
                                    j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                    [by discharge given-j-not-b]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                [by discharge given-j-not-a]
                            }
                          @conclusion-i-not-b |
                            i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                            [by discharge given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                        [by discharge given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                    [by discharge given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b ->
      apply(compose(transposition(j, b), transposition(j, a)), i) =
      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
    [by generalize generalize-i]
qed

// at j: LHS (ja): j->a then (jb) fixes a.
//       RHS (ij): j->i, (ia): i->a, then (ij) and both (ib) fix a.
theorem thirdIdentityAgreesAtJ: forall i, j, a, b: Element;
  i != a -> j != a -> a != b ->
  apply(compose(transposition(j, b), transposition(j, a)), j) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @given-a-not-b |
                            assume a != b {
                              @i-not-a |
                                i != a
                                [by hypothesis given-i-not-a]
                              @j-not-a |
                                j != a
                                [by hypothesis given-j-not-a]
                              @a-not-b |
                                a != b
                                [by hypothesis given-a-not-b]
                              @a-not-i |
                                a != i
                                [using specialize disequalityIsSymmetric(i, a) i-not-a]
                              @a-not-j |
                                a != j
                                [using specialize disequalityIsSymmetric(j, a) j-not-a]
                              @ja-sends-j |
                                apply(transposition(j, a), j) = a
                                [using specialize transpositionAtFirst(j, a)]
                              @jb-fixes-a |
                                apply(transposition(j, b), a) = a
                                [using specialize transpositionElsewhere(j, b, a) a-not-j a-not-b]
                              @ij-sends-j |
                                apply(transposition(i, j), j) = i
                                [using specialize transpositionAtSecond(i, j)]
                              @ia-sends-i |
                                apply(transposition(i, a), i) = a
                                [using specialize transpositionAtFirst(i, a)]
                              @ij-fixes-a |
                                apply(transposition(i, j), a) = a
                                [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                              @ib-fixes-a |
                                apply(transposition(i, b), a) = a
                                [using specialize transpositionElsewhere(i, b, a) a-not-i a-not-b]
                              @lhs-split |
                                apply(compose(transposition(j, b), transposition(j, a)), j) = apply(transposition(j, b), apply(transposition(j, a), j))
                                [using simplify composeApply]
                              @lhs-value |
                                apply(compose(transposition(j, b), transposition(j, a)), j) = a
                                [using simplify lhs-split ja-sends-j jb-fixes-a]
                              @rhs-split |
                                apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j) =
                                  apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), j))))))
                                [using simplify composeApply]
                              @rhs-value |
                                apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j) = a
                                [using simplify rhs-split ij-sends-j ia-sends-i ij-fixes-a ib-fixes-a]
                              @conclusion-agree |
                                apply(compose(transposition(j, b), transposition(j, a)), j) =
                                  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-a-not-b |
                            a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                            [by discharge given-a-not-b]
                        }
                      @conclusion-j-not-a |
                        j != a -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                        [by discharge given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                    [by discharge given-i-not-a]
                }
              @discharge-b |
                forall b: Element; i != a -> j != a -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != a -> j != a -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != a -> j != a -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != a -> j != a -> a != b ->
      apply(compose(transposition(j, b), transposition(j, a)), j) =
      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
    [by generalize generalize-i]
qed

// at a: LHS (ja): a->j then (jb): j->b.
//       RHS (ij) fixes a, (ia): a->i, (ij): i->j, (ib) fixes j, (ij): j->i, (ib): i->b.
theorem thirdIdentityAgreesAtA: forall i, j, a, b: Element;
  i != j -> j != b -> i != a -> j != a ->
  apply(compose(transposition(j, b), transposition(j, a)), a) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-j-not-b |
                        assume j != b {
                          @given-i-not-a |
                            assume i != a {
                              @given-j-not-a |
                                assume j != a {
                                  @i-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @j-not-b |
                                    j != b
                                    [by hypothesis given-j-not-b]
                                  @i-not-a |
                                    i != a
                                    [by hypothesis given-i-not-a]
                                  @j-not-a |
                                    j != a
                                    [by hypothesis given-j-not-a]
                                  @j-not-i |
                                    j != i
                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                  @a-not-i |
                                    a != i
                                    [using specialize disequalityIsSymmetric(i, a) i-not-a]
                                  @a-not-j |
                                    a != j
                                    [using specialize disequalityIsSymmetric(j, a) j-not-a]
                                  @ja-sends-a |
                                    apply(transposition(j, a), a) = j
                                    [using specialize transpositionAtSecond(j, a)]
                                  @jb-sends-j |
                                    apply(transposition(j, b), j) = b
                                    [using specialize transpositionAtFirst(j, b)]
                                  @ij-fixes-a |
                                    apply(transposition(i, j), a) = a
                                    [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                                  @ia-sends-a |
                                    apply(transposition(i, a), a) = i
                                    [using specialize transpositionAtSecond(i, a)]
                                  @ij-sends-i |
                                    apply(transposition(i, j), i) = j
                                    [using specialize transpositionAtFirst(i, j)]
                                  @ib-fixes-j |
                                    apply(transposition(i, b), j) = j
                                    [using specialize transpositionElsewhere(i, b, j) j-not-i j-not-b]
                                  @ij-sends-j |
                                    apply(transposition(i, j), j) = i
                                    [using specialize transpositionAtSecond(i, j)]
                                  @ib-sends-i |
                                    apply(transposition(i, b), i) = b
                                    [using specialize transpositionAtFirst(i, b)]
                                  @lhs-split |
                                    apply(compose(transposition(j, b), transposition(j, a)), a) = apply(transposition(j, b), apply(transposition(j, a), a))
                                    [using simplify composeApply]
                                  @lhs-value |
                                    apply(compose(transposition(j, b), transposition(j, a)), a) = b
                                    [using simplify lhs-split ja-sends-a jb-sends-j]
                                  @rhs-split |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a) =
                                      apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), a))))))
                                    [using simplify composeApply]
                                  @rhs-value |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a) = b
                                    [using simplify rhs-split ij-fixes-a ia-sends-a ij-sends-i ib-fixes-j ij-sends-j ib-sends-i]
                                  @conclusion-agree |
                                    apply(compose(transposition(j, b), transposition(j, a)), a) =
                                      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                    [using chain lhs-value rhs-value]
                                }
                              @conclusion-j-not-a |
                                j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                [by discharge given-j-not-a]
                            }
                          @conclusion-i-not-a |
                            i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                            [by discharge given-i-not-a]
                        }
                      @conclusion-j-not-b |
                        j != b -> i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                        [by discharge given-j-not-b]
                    }
                  @conclusion-i-not-j |
                    i != j -> j != b -> i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                    [by discharge given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> j != b -> i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> j != b -> i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> j != b -> i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> j != b -> i != a -> j != a ->
      apply(compose(transposition(j, b), transposition(j, a)), a) =
      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
    [by generalize generalize-i]
qed

// at b: LHS (ja) fixes b then (jb): b->j.
//       RHS (ij),(ia) fix b; (ib): b->i; (ij): i->j; (ib) fixes j.
theorem thirdIdentityAgreesAtB: forall i, j, a, b: Element;
  i != j -> j != b -> i != b -> a != b ->
  apply(compose(transposition(j, b), transposition(j, a)), b) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-j-not-b |
                        assume j != b {
                          @given-i-not-b |
                            assume i != b {
                              @given-a-not-b |
                                assume a != b {
                                  @i-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @j-not-b |
                                    j != b
                                    [by hypothesis given-j-not-b]
                                  @i-not-b |
                                    i != b
                                    [by hypothesis given-i-not-b]
                                  @a-not-b |
                                    a != b
                                    [by hypothesis given-a-not-b]
                                  @j-not-i |
                                    j != i
                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                  @b-not-i |
                                    b != i
                                    [using specialize disequalityIsSymmetric(i, b) i-not-b]
                                  @b-not-j |
                                    b != j
                                    [using specialize disequalityIsSymmetric(j, b) j-not-b]
                                  @b-not-a |
                                    b != a
                                    [using specialize disequalityIsSymmetric(a, b) a-not-b]
                                  @ja-fixes-b |
                                    apply(transposition(j, a), b) = b
                                    [using specialize transpositionElsewhere(j, a, b) b-not-j b-not-a]
                                  @jb-sends-b |
                                    apply(transposition(j, b), b) = j
                                    [using specialize transpositionAtSecond(j, b)]
                                  @ij-fixes-b |
                                    apply(transposition(i, j), b) = b
                                    [using specialize transpositionElsewhere(i, j, b) b-not-i b-not-j]
                                  @ia-fixes-b |
                                    apply(transposition(i, a), b) = b
                                    [using specialize transpositionElsewhere(i, a, b) b-not-i b-not-a]
                                  @ib-sends-b |
                                    apply(transposition(i, b), b) = i
                                    [using specialize transpositionAtSecond(i, b)]
                                  @ij-sends-i |
                                    apply(transposition(i, j), i) = j
                                    [using specialize transpositionAtFirst(i, j)]
                                  @ib-fixes-j |
                                    apply(transposition(i, b), j) = j
                                    [using specialize transpositionElsewhere(i, b, j) j-not-i j-not-b]
                                  @lhs-split |
                                    apply(compose(transposition(j, b), transposition(j, a)), b) = apply(transposition(j, b), apply(transposition(j, a), b))
                                    [using simplify composeApply]
                                  @lhs-value |
                                    apply(compose(transposition(j, b), transposition(j, a)), b) = j
                                    [using simplify lhs-split ja-fixes-b jb-sends-b]
                                  @rhs-split |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b) =
                                      apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), b))))))
                                    [using simplify composeApply]
                                  @rhs-value |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b) = j
                                    [using simplify rhs-split ij-fixes-b ia-fixes-b ib-sends-b ij-sends-i ib-fixes-j]
                                  @conclusion-agree |
                                    apply(compose(transposition(j, b), transposition(j, a)), b) =
                                      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                    [using chain lhs-value rhs-value]
                                }
                              @conclusion-a-not-b |
                                a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                [by discharge given-a-not-b]
                            }
                          @conclusion-i-not-b |
                            i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                            [by discharge given-i-not-b]
                        }
                      @conclusion-j-not-b |
                        j != b -> i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                        [by discharge given-j-not-b]
                    }
                  @conclusion-i-not-j |
                    i != j -> j != b -> i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                    [by discharge given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> j != b -> i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> j != b -> i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> j != b -> i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> j != b -> i != b -> a != b ->
      apply(compose(transposition(j, b), transposition(j, a)), b) =
      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
    [by generalize generalize-i]
qed

// elsewhere: x is none of i, j, a, b, so every factor fixes it.
theorem thirdIdentityAgreesElsewhere: forall i, j, a, b, x: Element;
  x != i -> x != j -> x != a -> x != b ->
  apply(compose(transposition(j, b), transposition(j, a)), x) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-x |
                    fix x: Element {
                      @given-x-not-i |
                        assume x != i {
                          @given-x-not-j |
                            assume x != j {
                              @given-x-not-a |
                                assume x != a {
                                  @given-x-not-b |
                                    assume x != b {
                                      @x-not-i |
                                        x != i
                                        [by hypothesis given-x-not-i]
                                      @x-not-j |
                                        x != j
                                        [by hypothesis given-x-not-j]
                                      @x-not-a |
                                        x != a
                                        [by hypothesis given-x-not-a]
                                      @x-not-b |
                                        x != b
                                        [by hypothesis given-x-not-b]
                                      @ja-fixes-x |
                                        apply(transposition(j, a), x) = x
                                        [using specialize transpositionElsewhere(j, a, x) x-not-j x-not-a]
                                      @jb-fixes-x |
                                        apply(transposition(j, b), x) = x
                                        [using specialize transpositionElsewhere(j, b, x) x-not-j x-not-b]
                                      @ij-fixes-x |
                                        apply(transposition(i, j), x) = x
                                        [using specialize transpositionElsewhere(i, j, x) x-not-i x-not-j]
                                      @ia-fixes-x |
                                        apply(transposition(i, a), x) = x
                                        [using specialize transpositionElsewhere(i, a, x) x-not-i x-not-a]
                                      @ib-fixes-x |
                                        apply(transposition(i, b), x) = x
                                        [using specialize transpositionElsewhere(i, b, x) x-not-i x-not-b]
                                      @lhs-split |
                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(transposition(j, b), apply(transposition(j, a), x))
                                        [using simplify composeApply]
                                      @lhs-value |
                                        apply(compose(transposition(j, b), transposition(j, a)), x) = x
                                        [using simplify lhs-split ja-fixes-x jb-fixes-x]
                                      @rhs-split |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x) =
                                          apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), x))))))
                                        [using simplify composeApply]
                                      @rhs-value |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x) = x
                                        [using simplify rhs-split ij-fixes-x ia-fixes-x ib-fixes-x]
                                      @conclusion-agree |
                                        apply(compose(transposition(j, b), transposition(j, a)), x) =
                                          apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                        [using chain lhs-value rhs-value]
                                    }
                                  @conclusion-x-not-b |
                                    x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                    [by discharge given-x-not-b]
                                }
                              @conclusion-x-not-a |
                                x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                [by discharge given-x-not-a]
                            }
                          @conclusion-x-not-j |
                            x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                            [by discharge given-x-not-j]
                        }
                      @conclusion-x-not-i |
                        x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                        [by discharge given-x-not-i]
                    }
                  @discharge-x |
                    forall x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                    [by generalize generalize-x]
                }
              @discharge-b |
                forall b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b, x: Element; x != i -> x != j -> x != a -> x != b ->
      apply(compose(transposition(j, b), transposition(j, a)), x) =
      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
    [by generalize generalize-i]
qed

// The pointwise agreement behind identity (3): five cases on where x sits.
theorem theThirdIdentityAgreesEverywhere: forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  forall x: Element;
  apply(compose(transposition(j, b), transposition(j, a)), x) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-b |
                                    assume j != b {
                                      @given-a-not-b |
                                        assume a != b {
                                          @i-not-j |
                                            i != j
                                            [by hypothesis given-i-not-j]
                                          @i-not-a |
                                            i != a
                                            [by hypothesis given-i-not-a]
                                          @i-not-b |
                                            i != b
                                            [by hypothesis given-i-not-b]
                                          @j-not-a |
                                            j != a
                                            [by hypothesis given-j-not-a]
                                          @j-not-b |
                                            j != b
                                            [by hypothesis given-j-not-b]
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-not-b]
                                          @generalize-x |
                                            fix x: Element {
                                              @cases |
                                                x = i or x = j or x = a or x = b or (x != i and x != j and x != a and x != b)
                                                [using tautology]
                                              @conclusion-at-x |
                                                apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                case cases {
                                                  @when-x-is-i |
                                                    assume x = i {
                                                      @x-is-i |
                                                        x = i
                                                        [by hypothesis when-x-is-i]
                                                      @agree-at-i |
                                                        apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                                        [using specialize thirdIdentityAgreesAtI(i, j, a, b) i-not-j i-not-a i-not-b j-not-a j-not-b]
                                                      @conclusion-when-x-is-i |
                                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-i agree-at-i]
                                                    }
                                                  @when-x-is-j |
                                                    assume x = j {
                                                      @x-is-j |
                                                        x = j
                                                        [by hypothesis when-x-is-j]
                                                      @agree-at-j |
                                                        apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                                        [using specialize thirdIdentityAgreesAtJ(i, j, a, b) i-not-a j-not-a a-not-b]
                                                      @conclusion-when-x-is-j |
                                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-j agree-at-j]
                                                    }
                                                  @when-x-is-a |
                                                    assume x = a {
                                                      @x-is-a |
                                                        x = a
                                                        [by hypothesis when-x-is-a]
                                                      @agree-at-a |
                                                        apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                                        [using specialize thirdIdentityAgreesAtA(i, j, a, b) i-not-j j-not-b i-not-a j-not-a]
                                                      @conclusion-when-x-is-a |
                                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-a agree-at-a]
                                                    }
                                                  @when-x-is-b |
                                                    assume x = b {
                                                      @x-is-b |
                                                        x = b
                                                        [by hypothesis when-x-is-b]
                                                      @agree-at-b |
                                                        apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                                        [using specialize thirdIdentityAgreesAtB(i, j, a, b) i-not-j j-not-b i-not-b a-not-b]
                                                      @conclusion-when-x-is-b |
                                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-b agree-at-b]
                                                    }
                                                  @when-x-is-elsewhere |
                                                    assume x != i and x != j and x != a and x != b {
                                                      @x-is-elsewhere |
                                                        x != i and x != j and x != a and x != b
                                                        [by hypothesis when-x-is-elsewhere]
                                                      @x-not-i |
                                                        x != i
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-j |
                                                        x != j
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-a |
                                                        x != a
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-b |
                                                        x != b
                                                        [using tautology x-is-elsewhere]
                                                      @conclusion-when-x-is-elsewhere |
                                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [using specialize thirdIdentityAgreesElsewhere(i, j, a, b, x) x-not-i x-not-j x-not-a x-not-b]
                                                    }
                                                }
                                            }
                                          @discharge-x |
                                            forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                            [by generalize generalize-x]
                                        }
                                      @conclusion-a-not-b |
                                        a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                        [by discharge given-a-not-b]
                                    }
                                  @conclusion-j-not-b |
                                    j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                    [by discharge given-j-not-b]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                [by discharge given-j-not-a]
                            }
                          @conclusion-i-not-b |
                            i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                            [by discharge given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                        [by discharge given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                    [by discharge given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
    [by generalize generalize-i]
qed

// Judson Lemma 2, identity (3): (j,a,b) = (i,j,b)^2(i,j,a).
theorem aThreeCycleThroughTheSecondFixedPointFactors: forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  compose(transposition(j, b), transposition(j, a)) =
  compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-b |
                                    assume j != b {
                                      @given-a-not-b |
                                        assume a != b {
                                          @i-not-j |
                                            i != j
                                            [by hypothesis given-i-not-j]
                                          @i-not-a |
                                            i != a
                                            [by hypothesis given-i-not-a]
                                          @i-not-b |
                                            i != b
                                            [by hypothesis given-i-not-b]
                                          @j-not-a |
                                            j != a
                                            [by hypothesis given-j-not-a]
                                          @j-not-b |
                                            j != b
                                            [by hypothesis given-j-not-b]
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-not-b]
                                          @agree-everywhere |
                                            forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                            [using specialize theThirdIdentityAgreesEverywhere(i, j, a, b) i-not-j i-not-a i-not-b j-not-a j-not-b a-not-b]
                                          @conclusion-equal |
                                            compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                            [using specialize funcExtensionality(compose(transposition(j, b), transposition(j, a)), compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))) agree-everywhere]
                                        }
                                      @conclusion-a-not-b |
                                        a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                        [by discharge given-a-not-b]
                                    }
                                  @conclusion-j-not-b |
                                    j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                    [by discharge given-j-not-b]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                [by discharge given-j-not-a]
                            }
                          @conclusion-i-not-b |
                            i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                            [by discharge given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                        [by discharge given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                    [by discharge given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
      compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
    [by generalize generalize-i]
qed

// at i.
theorem fourthIdentityAgreesAtI: forall i, j, a, b, c: Element;
  i != a -> i != b -> i != c -> i != j -> j != a -> j != c -> j != b ->
  apply(compose(transposition(a, c), transposition(a, b)), i) =
  apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-i-not-c |
                                assume i != c {
                                  @given-i-not-j |
                                    assume i != j {
                                      @given-j-not-a |
                                        assume j != a {
                                          @given-j-not-c |
                                            assume j != c {
                                              @given-j-not-b |
                                                assume j != b {
                                                  @i-not-a |
                                                    i != a
                                                    [by hypothesis given-i-not-a]
                                                  @i-not-b |
                                                    i != b
                                                    [by hypothesis given-i-not-b]
                                                  @i-not-c |
                                                    i != c
                                                    [by hypothesis given-i-not-c]
                                                  @i-not-j |
                                                    i != j
                                                    [by hypothesis given-i-not-j]
                                                  @j-not-a |
                                                    j != a
                                                    [by hypothesis given-j-not-a]
                                                  @j-not-c |
                                                    j != c
                                                    [by hypothesis given-j-not-c]
                                                  @j-not-b |
                                                    j != b
                                                    [by hypothesis given-j-not-b]
                                                  @j-not-i |
                                                    j != i
                                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                                  @a-not-i |
                                                    a != i
                                                    [using specialize disequalityIsSymmetric(i, a) i-not-a]
                                                  @a-not-j |
                                                    a != j
                                                    [using specialize disequalityIsSymmetric(j, a) j-not-a]
                                                  @b-not-i |
                                                    b != i
                                                    [using specialize disequalityIsSymmetric(i, b) i-not-b]
                                                  @b-not-j |
                                                    b != j
                                                    [using specialize disequalityIsSymmetric(j, b) j-not-b]
                                                  @ab-fixes-i |
                                                    apply(transposition(a, b), i) = i
                                                    [using specialize transpositionElsewhere(a, b, i) i-not-a i-not-b]
                                                  @ac-fixes-i |
                                                    apply(transposition(a, c), i) = i
                                                    [using specialize transpositionElsewhere(a, c, i) i-not-a i-not-c]
                                                  @ij-sends-i |
                                                    apply(transposition(i, j), i) = j
                                                    [using specialize transpositionAtFirst(i, j)]
                                                  @ia-fixes-j |
                                                    apply(transposition(i, a), j) = j
                                                    [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                                                  @ij-sends-j |
                                                    apply(transposition(i, j), j) = i
                                                    [using specialize transpositionAtSecond(i, j)]
                                                  @ib-sends-i |
                                                    apply(transposition(i, b), i) = b
                                                    [using specialize transpositionAtFirst(i, b)]
                                                  @ij-fixes-b |
                                                    apply(transposition(i, j), b) = b
                                                    [using specialize transpositionElsewhere(i, j, b) b-not-i b-not-j]
                                                  @ib-sends-b |
                                                    apply(transposition(i, b), b) = i
                                                    [using specialize transpositionAtSecond(i, b)]
                                                  @ic-fixes-j |
                                                    apply(transposition(i, c), j) = j
                                                    [using specialize transpositionElsewhere(i, c, j) j-not-i j-not-c]
                                                  @ia-sends-i |
                                                    apply(transposition(i, a), i) = a
                                                    [using specialize transpositionAtFirst(i, a)]
                                                  @ij-fixes-a |
                                                    apply(transposition(i, j), a) = a
                                                    [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                                                  @ia-sends-a |
                                                    apply(transposition(i, a), a) = i
                                                    [using specialize transpositionAtSecond(i, a)]
                                                  @lhs-split |
                                                    apply(compose(transposition(a, c), transposition(a, b)), i) = apply(transposition(a, c), apply(transposition(a, b), i))
                                                    [using simplify composeApply]
                                                  @lhs-value |
                                                    apply(compose(transposition(a, c), transposition(a, b)), i) = i
                                                    [using simplify lhs-split ab-fixes-i ac-fixes-i]
                                                  @rhs-split |
                                                    apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i) =
                                                      apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, c), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), i))))))))))))
                                                    [using simplify composeApply]
                                                  @rhs-value |
                                                    apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i) = i
                                                    [using simplify rhs-split ij-sends-i ia-fixes-j ij-sends-j ib-sends-i ij-fixes-b ib-sends-b ic-fixes-j ia-sends-i ij-fixes-a ia-sends-a]
                                                  @conclusion-agree |
                                                    apply(compose(transposition(a, c), transposition(a, b)), i) =
                                                      apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                                    [using chain lhs-value rhs-value]
                                                }
                                              @conclusion-j-not-b |
                                                j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                                [by discharge given-j-not-b]
                                            }
                                          @conclusion-j-not-c |
                                            j != c -> j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                            [by discharge given-j-not-c]
                                        }
                                      @conclusion-j-not-a |
                                        j != a -> j != c -> j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                        [by discharge given-j-not-a]
                                    }
                                  @conclusion-i-not-j |
                                    i != j -> j != a -> j != c -> j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                    [by discharge given-i-not-j]
                                }
                              @conclusion-i-not-c |
                                i != c -> i != j -> j != a -> j != c -> j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                [by discharge given-i-not-c]
                            }
                          @conclusion-i-not-b |
                            i != b -> i != c -> i != j -> j != a -> j != c -> j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                            [by discharge given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> i != c -> i != j -> j != a -> j != c -> j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                        [by discharge given-i-not-a]
                    }
                  @discharge-c |
                    forall c: Element; i != a -> i != b -> i != c -> i != j -> j != a -> j != c -> j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                    [by generalize generalize-c]
                }
              @discharge-b |
                forall b, c: Element; i != a -> i != b -> i != c -> i != j -> j != a -> j != c -> j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b, c: Element; i != a -> i != b -> i != c -> i != j -> j != a -> j != c -> j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b, c: Element; i != a -> i != b -> i != c -> i != j -> j != a -> j != c -> j != b -> apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b, c: Element; i != a -> i != b -> i != c -> i != j -> j != a -> j != c -> j != b ->
      apply(compose(transposition(a, c), transposition(a, b)), i) =
      apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
    [by generalize generalize-i]
qed

// at j.
theorem fourthIdentityAgreesAtJ: forall i, j, a, b, c: Element;
  i != j -> j != a -> j != b -> j != c -> i != a -> a != b -> a != c ->
  apply(compose(transposition(a, c), transposition(a, b)), j) =
  apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-j-not-a |
                            assume j != a {
                              @given-j-not-b |
                                assume j != b {
                                  @given-j-not-c |
                                    assume j != c {
                                      @given-i-not-a |
                                        assume i != a {
                                          @given-a-not-b |
                                            assume a != b {
                                              @given-a-not-c |
                                                assume a != c {
                                                  @i-not-j |
                                                    i != j
                                                    [by hypothesis given-i-not-j]
                                                  @j-not-a |
                                                    j != a
                                                    [by hypothesis given-j-not-a]
                                                  @j-not-b |
                                                    j != b
                                                    [by hypothesis given-j-not-b]
                                                  @j-not-c |
                                                    j != c
                                                    [by hypothesis given-j-not-c]
                                                  @i-not-a |
                                                    i != a
                                                    [by hypothesis given-i-not-a]
                                                  @a-not-b |
                                                    a != b
                                                    [by hypothesis given-a-not-b]
                                                  @a-not-c |
                                                    a != c
                                                    [by hypothesis given-a-not-c]
                                                  @j-not-i |
                                                    j != i
                                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                                  @a-not-i |
                                                    a != i
                                                    [using specialize disequalityIsSymmetric(i, a) i-not-a]
                                                  @a-not-j |
                                                    a != j
                                                    [using specialize disequalityIsSymmetric(j, a) j-not-a]
                                                  @ab-fixes-j |
                                                    apply(transposition(a, b), j) = j
                                                    [using specialize transpositionElsewhere(a, b, j) j-not-a j-not-b]
                                                  @ac-fixes-j |
                                                    apply(transposition(a, c), j) = j
                                                    [using specialize transpositionElsewhere(a, c, j) j-not-a j-not-c]
                                                  @ij-sends-j |
                                                    apply(transposition(i, j), j) = i
                                                    [using specialize transpositionAtSecond(i, j)]
                                                  @ia-sends-i |
                                                    apply(transposition(i, a), i) = a
                                                    [using specialize transpositionAtFirst(i, a)]
                                                  @ij-fixes-a |
                                                    apply(transposition(i, j), a) = a
                                                    [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                                                  @ib-fixes-a |
                                                    apply(transposition(i, b), a) = a
                                                    [using specialize transpositionElsewhere(i, b, a) a-not-i a-not-b]
                                                  @ic-fixes-a |
                                                    apply(transposition(i, c), a) = a
                                                    [using specialize transpositionElsewhere(i, c, a) a-not-i a-not-c]
                                                  @ia-sends-a |
                                                    apply(transposition(i, a), a) = i
                                                    [using specialize transpositionAtSecond(i, a)]
                                                  @ij-sends-i |
                                                    apply(transposition(i, j), i) = j
                                                    [using specialize transpositionAtFirst(i, j)]
                                                  @ia-fixes-j |
                                                    apply(transposition(i, a), j) = j
                                                    [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                                                  @lhs-split |
                                                    apply(compose(transposition(a, c), transposition(a, b)), j) = apply(transposition(a, c), apply(transposition(a, b), j))
                                                    [using simplify composeApply]
                                                  @lhs-value |
                                                    apply(compose(transposition(a, c), transposition(a, b)), j) = j
                                                    [using simplify lhs-split ab-fixes-j ac-fixes-j]
                                                  @rhs-split |
                                                    apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j) =
                                                      apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, c), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), j))))))))))))
                                                    [using simplify composeApply]
                                                  @rhs-value |
                                                    apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j) = j
                                                    [using simplify rhs-split ij-sends-j ia-sends-i ij-fixes-a ib-fixes-a ic-fixes-a ia-sends-a ij-sends-i ia-fixes-j]
                                                  @conclusion-agree |
                                                    apply(compose(transposition(a, c), transposition(a, b)), j) =
                                                      apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                                    [using chain lhs-value rhs-value]
                                                }
                                              @conclusion-a-not-c |
                                                a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                                [by discharge given-a-not-c]
                                            }
                                          @conclusion-a-not-b |
                                            a != b -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                            [by discharge given-a-not-b]
                                        }
                                      @conclusion-i-not-a |
                                        i != a -> a != b -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                        [by discharge given-i-not-a]
                                    }
                                  @conclusion-j-not-c |
                                    j != c -> i != a -> a != b -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                    [by discharge given-j-not-c]
                                }
                              @conclusion-j-not-b |
                                j != b -> j != c -> i != a -> a != b -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                [by discharge given-j-not-b]
                            }
                          @conclusion-j-not-a |
                            j != a -> j != b -> j != c -> i != a -> a != b -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                            [by discharge given-j-not-a]
                        }
                      @conclusion-i-not-j |
                        i != j -> j != a -> j != b -> j != c -> i != a -> a != b -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                        [by discharge given-i-not-j]
                    }
                  @discharge-c |
                    forall c: Element; i != j -> j != a -> j != b -> j != c -> i != a -> a != b -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                    [by generalize generalize-c]
                }
              @discharge-b |
                forall b, c: Element; i != j -> j != a -> j != b -> j != c -> i != a -> a != b -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b, c: Element; i != j -> j != a -> j != b -> j != c -> i != a -> a != b -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b, c: Element; i != j -> j != a -> j != b -> j != c -> i != a -> a != b -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b, c: Element; i != j -> j != a -> j != b -> j != c -> i != a -> a != b -> a != c ->
      apply(compose(transposition(a, c), transposition(a, b)), j) =
      apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
    [by generalize generalize-i]
qed

// at a: LHS (ab): a->b.
theorem fourthIdentityAgreesAtA: forall i, j, a, b, c: Element;
  i != j -> j != b -> i != a -> j != a -> i != b -> a != b -> b != c ->
  apply(compose(transposition(a, c), transposition(a, b)), a) =
  apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-j-not-b |
                            assume j != b {
                              @given-i-not-a |
                                assume i != a {
                                  @given-j-not-a |
                                    assume j != a {
                                      @given-i-not-b |
                                        assume i != b {
                                          @given-a-not-b |
                                            assume a != b {
                                              @given-b-not-c |
                                                assume b != c {
                                                  @i-not-j |
                                                    i != j
                                                    [by hypothesis given-i-not-j]
                                                  @j-not-b |
                                                    j != b
                                                    [by hypothesis given-j-not-b]
                                                  @i-not-a |
                                                    i != a
                                                    [by hypothesis given-i-not-a]
                                                  @j-not-a |
                                                    j != a
                                                    [by hypothesis given-j-not-a]
                                                  @i-not-b |
                                                    i != b
                                                    [by hypothesis given-i-not-b]
                                                  @a-not-b |
                                                    a != b
                                                    [by hypothesis given-a-not-b]
                                                  @b-not-c |
                                                    b != c
                                                    [by hypothesis given-b-not-c]
                                                  @j-not-i |
                                                    j != i
                                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                                  @a-not-i |
                                                    a != i
                                                    [using specialize disequalityIsSymmetric(i, a) i-not-a]
                                                  @a-not-j |
                                                    a != j
                                                    [using specialize disequalityIsSymmetric(j, a) j-not-a]
                                                  @b-not-i |
                                                    b != i
                                                    [using specialize disequalityIsSymmetric(i, b) i-not-b]
                                                  @b-not-j |
                                                    b != j
                                                    [using specialize disequalityIsSymmetric(j, b) j-not-b]
                                                  @b-not-a |
                                                    b != a
                                                    [using specialize disequalityIsSymmetric(a, b) a-not-b]
                                                  @ab-sends-a |
                                                    apply(transposition(a, b), a) = b
                                                    [using specialize transpositionAtFirst(a, b)]
                                                  @ac-fixes-b |
                                                    apply(transposition(a, c), b) = b
                                                    [using specialize transpositionElsewhere(a, c, b) b-not-a b-not-c]
                                                  @ij-fixes-a |
                                                    apply(transposition(i, j), a) = a
                                                    [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                                                  @ia-sends-a |
                                                    apply(transposition(i, a), a) = i
                                                    [using specialize transpositionAtSecond(i, a)]
                                                  @ij-sends-i |
                                                    apply(transposition(i, j), i) = j
                                                    [using specialize transpositionAtFirst(i, j)]
                                                  @ib-fixes-j |
                                                    apply(transposition(i, b), j) = j
                                                    [using specialize transpositionElsewhere(i, b, j) j-not-i j-not-b]
                                                  @ij-sends-j |
                                                    apply(transposition(i, j), j) = i
                                                    [using specialize transpositionAtSecond(i, j)]
                                                  @ib-sends-i |
                                                    apply(transposition(i, b), i) = b
                                                    [using specialize transpositionAtFirst(i, b)]
                                                  @ij-fixes-b |
                                                    apply(transposition(i, j), b) = b
                                                    [using specialize transpositionElsewhere(i, j, b) b-not-i b-not-j]
                                                  @ic-fixes-b |
                                                    apply(transposition(i, c), b) = b
                                                    [using specialize transpositionElsewhere(i, c, b) b-not-i b-not-c]
                                                  @ia-fixes-b |
                                                    apply(transposition(i, a), b) = b
                                                    [using specialize transpositionElsewhere(i, a, b) b-not-i b-not-a]
                                                  @lhs-split |
                                                    apply(compose(transposition(a, c), transposition(a, b)), a) = apply(transposition(a, c), apply(transposition(a, b), a))
                                                    [using simplify composeApply]
                                                  @lhs-value |
                                                    apply(compose(transposition(a, c), transposition(a, b)), a) = b
                                                    [using simplify lhs-split ab-sends-a ac-fixes-b]
                                                  @rhs-split |
                                                    apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a) =
                                                      apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, c), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), a))))))))))))
                                                    [using simplify composeApply]
                                                  @rhs-value |
                                                    apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a) = b
                                                    [using simplify rhs-split ij-fixes-a ia-sends-a ij-sends-i ib-fixes-j ij-sends-j ib-sends-i ij-fixes-b ic-fixes-b ia-fixes-b]
                                                  @conclusion-agree |
                                                    apply(compose(transposition(a, c), transposition(a, b)), a) =
                                                      apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                                    [using chain lhs-value rhs-value]
                                                }
                                              @conclusion-b-not-c |
                                                b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                                [by discharge given-b-not-c]
                                            }
                                          @conclusion-a-not-b |
                                            a != b -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                            [by discharge given-a-not-b]
                                        }
                                      @conclusion-i-not-b |
                                        i != b -> a != b -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                        [by discharge given-i-not-b]
                                    }
                                  @conclusion-j-not-a |
                                    j != a -> i != b -> a != b -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                    [by discharge given-j-not-a]
                                }
                              @conclusion-i-not-a |
                                i != a -> j != a -> i != b -> a != b -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                [by discharge given-i-not-a]
                            }
                          @conclusion-j-not-b |
                            j != b -> i != a -> j != a -> i != b -> a != b -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                            [by discharge given-j-not-b]
                        }
                      @conclusion-i-not-j |
                        i != j -> j != b -> i != a -> j != a -> i != b -> a != b -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                        [by discharge given-i-not-j]
                    }
                  @discharge-c |
                    forall c: Element; i != j -> j != b -> i != a -> j != a -> i != b -> a != b -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                    [by generalize generalize-c]
                }
              @discharge-b |
                forall b, c: Element; i != j -> j != b -> i != a -> j != a -> i != b -> a != b -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b, c: Element; i != j -> j != b -> i != a -> j != a -> i != b -> a != b -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b, c: Element; i != j -> j != b -> i != a -> j != a -> i != b -> a != b -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b, c: Element; i != j -> j != b -> i != a -> j != a -> i != b -> a != b -> b != c ->
      apply(compose(transposition(a, c), transposition(a, b)), a) =
      apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
    [by generalize generalize-i]
qed

// at b: LHS (ab): b->a then (ac): a->c.
theorem fourthIdentityAgreesAtB: forall i, j, a, b, c: Element;
  i != j -> j != b -> i != b -> a != b -> i != c -> j != c -> a != c ->
  apply(compose(transposition(a, c), transposition(a, b)), b) =
  apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-j-not-b |
                            assume j != b {
                              @given-i-not-b |
                                assume i != b {
                                  @given-a-not-b |
                                    assume a != b {
                                      @given-i-not-c |
                                        assume i != c {
                                          @given-j-not-c |
                                            assume j != c {
                                              @given-a-not-c |
                                                assume a != c {
                                                  @i-not-j |
                                                    i != j
                                                    [by hypothesis given-i-not-j]
                                                  @j-not-b |
                                                    j != b
                                                    [by hypothesis given-j-not-b]
                                                  @i-not-b |
                                                    i != b
                                                    [by hypothesis given-i-not-b]
                                                  @a-not-b |
                                                    a != b
                                                    [by hypothesis given-a-not-b]
                                                  @i-not-c |
                                                    i != c
                                                    [by hypothesis given-i-not-c]
                                                  @j-not-c |
                                                    j != c
                                                    [by hypothesis given-j-not-c]
                                                  @a-not-c |
                                                    a != c
                                                    [by hypothesis given-a-not-c]
                                                  @j-not-i |
                                                    j != i
                                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                                  @b-not-i |
                                                    b != i
                                                    [using specialize disequalityIsSymmetric(i, b) i-not-b]
                                                  @b-not-j |
                                                    b != j
                                                    [using specialize disequalityIsSymmetric(j, b) j-not-b]
                                                  @b-not-a |
                                                    b != a
                                                    [using specialize disequalityIsSymmetric(a, b) a-not-b]
                                                  @c-not-i |
                                                    c != i
                                                    [using specialize disequalityIsSymmetric(i, c) i-not-c]
                                                  @c-not-j |
                                                    c != j
                                                    [using specialize disequalityIsSymmetric(j, c) j-not-c]
                                                  @c-not-a |
                                                    c != a
                                                    [using specialize disequalityIsSymmetric(a, c) a-not-c]
                                                  @ab-sends-b |
                                                    apply(transposition(a, b), b) = a
                                                    [using specialize transpositionAtSecond(a, b)]
                                                  @ac-sends-a |
                                                    apply(transposition(a, c), a) = c
                                                    [using specialize transpositionAtFirst(a, c)]
                                                  @ij-fixes-b |
                                                    apply(transposition(i, j), b) = b
                                                    [using specialize transpositionElsewhere(i, j, b) b-not-i b-not-j]
                                                  @ia-fixes-b |
                                                    apply(transposition(i, a), b) = b
                                                    [using specialize transpositionElsewhere(i, a, b) b-not-i b-not-a]
                                                  @ib-sends-b |
                                                    apply(transposition(i, b), b) = i
                                                    [using specialize transpositionAtSecond(i, b)]
                                                  @ij-sends-i |
                                                    apply(transposition(i, j), i) = j
                                                    [using specialize transpositionAtFirst(i, j)]
                                                  @ib-fixes-j |
                                                    apply(transposition(i, b), j) = j
                                                    [using specialize transpositionElsewhere(i, b, j) j-not-i j-not-b]
                                                  @ij-sends-j |
                                                    apply(transposition(i, j), j) = i
                                                    [using specialize transpositionAtSecond(i, j)]
                                                  @ic-sends-i |
                                                    apply(transposition(i, c), i) = c
                                                    [using specialize transpositionAtFirst(i, c)]
                                                  @ij-fixes-c |
                                                    apply(transposition(i, j), c) = c
                                                    [using specialize transpositionElsewhere(i, j, c) c-not-i c-not-j]
                                                  @ia-fixes-c |
                                                    apply(transposition(i, a), c) = c
                                                    [using specialize transpositionElsewhere(i, a, c) c-not-i c-not-a]
                                                  @lhs-split |
                                                    apply(compose(transposition(a, c), transposition(a, b)), b) = apply(transposition(a, c), apply(transposition(a, b), b))
                                                    [using simplify composeApply]
                                                  @lhs-value |
                                                    apply(compose(transposition(a, c), transposition(a, b)), b) = c
                                                    [using simplify lhs-split ab-sends-b ac-sends-a]
                                                  @rhs-split |
                                                    apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b) =
                                                      apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, c), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), b))))))))))))
                                                    [using simplify composeApply]
                                                  @rhs-value |
                                                    apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b) = c
                                                    [using simplify rhs-split ij-fixes-b ia-fixes-b ib-sends-b ij-sends-i ib-fixes-j ij-sends-j ic-sends-i ij-fixes-c ia-fixes-c]
                                                  @conclusion-agree |
                                                    apply(compose(transposition(a, c), transposition(a, b)), b) =
                                                      apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                                    [using chain lhs-value rhs-value]
                                                }
                                              @conclusion-a-not-c |
                                                a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                                [by discharge given-a-not-c]
                                            }
                                          @conclusion-j-not-c |
                                            j != c -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                            [by discharge given-j-not-c]
                                        }
                                      @conclusion-i-not-c |
                                        i != c -> j != c -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                        [by discharge given-i-not-c]
                                    }
                                  @conclusion-a-not-b |
                                    a != b -> i != c -> j != c -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                    [by discharge given-a-not-b]
                                }
                              @conclusion-i-not-b |
                                i != b -> a != b -> i != c -> j != c -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                [by discharge given-i-not-b]
                            }
                          @conclusion-j-not-b |
                            j != b -> i != b -> a != b -> i != c -> j != c -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                            [by discharge given-j-not-b]
                        }
                      @conclusion-i-not-j |
                        i != j -> j != b -> i != b -> a != b -> i != c -> j != c -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                        [by discharge given-i-not-j]
                    }
                  @discharge-c |
                    forall c: Element; i != j -> j != b -> i != b -> a != b -> i != c -> j != c -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                    [by generalize generalize-c]
                }
              @discharge-b |
                forall b, c: Element; i != j -> j != b -> i != b -> a != b -> i != c -> j != c -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b, c: Element; i != j -> j != b -> i != b -> a != b -> i != c -> j != c -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b, c: Element; i != j -> j != b -> i != b -> a != b -> i != c -> j != c -> a != c -> apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b, c: Element; i != j -> j != b -> i != b -> a != b -> i != c -> j != c -> a != c ->
      apply(compose(transposition(a, c), transposition(a, b)), b) =
      apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
    [by generalize generalize-i]
qed

// at c: LHS (ab) fixes c then (ac): c->a.
theorem fourthIdentityAgreesAtC: forall i, j, a, b, c: Element;
  i != j -> j != a -> i != c -> j != c -> a != c -> b != c ->
  apply(compose(transposition(a, c), transposition(a, b)), c) =
  apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-j-not-a |
                            assume j != a {
                              @given-i-not-c |
                                assume i != c {
                                  @given-j-not-c |
                                    assume j != c {
                                      @given-a-not-c |
                                        assume a != c {
                                          @given-b-not-c |
                                            assume b != c {
                                              @i-not-j |
                                                i != j
                                                [by hypothesis given-i-not-j]
                                              @j-not-a |
                                                j != a
                                                [by hypothesis given-j-not-a]
                                              @i-not-c |
                                                i != c
                                                [by hypothesis given-i-not-c]
                                              @j-not-c |
                                                j != c
                                                [by hypothesis given-j-not-c]
                                              @a-not-c |
                                                a != c
                                                [by hypothesis given-a-not-c]
                                              @b-not-c |
                                                b != c
                                                [by hypothesis given-b-not-c]
                                              @j-not-i |
                                                j != i
                                                [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                              @c-not-i |
                                                c != i
                                                [using specialize disequalityIsSymmetric(i, c) i-not-c]
                                              @c-not-j |
                                                c != j
                                                [using specialize disequalityIsSymmetric(j, c) j-not-c]
                                              @c-not-a |
                                                c != a
                                                [using specialize disequalityIsSymmetric(a, c) a-not-c]
                                              @c-not-b |
                                                c != b
                                                [using specialize disequalityIsSymmetric(b, c) b-not-c]
                                              @ab-fixes-c |
                                                apply(transposition(a, b), c) = c
                                                [using specialize transpositionElsewhere(a, b, c) c-not-a c-not-b]
                                              @ac-sends-c |
                                                apply(transposition(a, c), c) = a
                                                [using specialize transpositionAtSecond(a, c)]
                                              @ij-fixes-c |
                                                apply(transposition(i, j), c) = c
                                                [using specialize transpositionElsewhere(i, j, c) c-not-i c-not-j]
                                              @ia-fixes-c |
                                                apply(transposition(i, a), c) = c
                                                [using specialize transpositionElsewhere(i, a, c) c-not-i c-not-a]
                                              @ib-fixes-c |
                                                apply(transposition(i, b), c) = c
                                                [using specialize transpositionElsewhere(i, b, c) c-not-i c-not-b]
                                              @ic-sends-c |
                                                apply(transposition(i, c), c) = i
                                                [using specialize transpositionAtSecond(i, c)]
                                              @ij-sends-i |
                                                apply(transposition(i, j), i) = j
                                                [using specialize transpositionAtFirst(i, j)]
                                              @ia-fixes-j |
                                                apply(transposition(i, a), j) = j
                                                [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                                              @ij-sends-j |
                                                apply(transposition(i, j), j) = i
                                                [using specialize transpositionAtSecond(i, j)]
                                              @ia-sends-i |
                                                apply(transposition(i, a), i) = a
                                                [using specialize transpositionAtFirst(i, a)]
                                              @lhs-split |
                                                apply(compose(transposition(a, c), transposition(a, b)), c) = apply(transposition(a, c), apply(transposition(a, b), c))
                                                [using simplify composeApply]
                                              @lhs-value |
                                                apply(compose(transposition(a, c), transposition(a, b)), c) = a
                                                [using simplify lhs-split ab-fixes-c ac-sends-c]
                                              @rhs-split |
                                                apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c) =
                                                  apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, c), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), c))))))))))))
                                                [using simplify composeApply]
                                              @rhs-value |
                                                apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c) = a
                                                [using simplify rhs-split ij-fixes-c ia-fixes-c ib-fixes-c ic-sends-c ij-sends-i ia-fixes-j ij-sends-j ia-sends-i]
                                              @conclusion-agree |
                                                apply(compose(transposition(a, c), transposition(a, b)), c) =
                                                  apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
                                                [using chain lhs-value rhs-value]
                                            }
                                          @conclusion-b-not-c |
                                            b != c -> apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
                                            [by discharge given-b-not-c]
                                        }
                                      @conclusion-a-not-c |
                                        a != c -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
                                        [by discharge given-a-not-c]
                                    }
                                  @conclusion-j-not-c |
                                    j != c -> a != c -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
                                    [by discharge given-j-not-c]
                                }
                              @conclusion-i-not-c |
                                i != c -> j != c -> a != c -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
                                [by discharge given-i-not-c]
                            }
                          @conclusion-j-not-a |
                            j != a -> i != c -> j != c -> a != c -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
                            [by discharge given-j-not-a]
                        }
                      @conclusion-i-not-j |
                        i != j -> j != a -> i != c -> j != c -> a != c -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
                        [by discharge given-i-not-j]
                    }
                  @discharge-c |
                    forall c: Element; i != j -> j != a -> i != c -> j != c -> a != c -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
                    [by generalize generalize-c]
                }
              @discharge-b |
                forall b, c: Element; i != j -> j != a -> i != c -> j != c -> a != c -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b, c: Element; i != j -> j != a -> i != c -> j != c -> a != c -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b, c: Element; i != j -> j != a -> i != c -> j != c -> a != c -> b != c -> apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b, c: Element; i != j -> j != a -> i != c -> j != c -> a != c -> b != c ->
      apply(compose(transposition(a, c), transposition(a, b)), c) =
      apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
    [by generalize generalize-i]
qed

// elsewhere: every factor fixes x.
theorem fourthIdentityAgreesElsewhere: forall i, j, a, b, c, x: Element;
  x != i -> x != j -> x != a -> x != b -> x != c ->
  apply(compose(transposition(a, c), transposition(a, b)), x) =
  apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @generalize-x |
                        fix x: Element {
                          @given-x-not-i |
                            assume x != i {
                              @given-x-not-j |
                                assume x != j {
                                  @given-x-not-a |
                                    assume x != a {
                                      @given-x-not-b |
                                        assume x != b {
                                          @given-x-not-c |
                                            assume x != c {
                                              @x-not-i |
                                                x != i
                                                [by hypothesis given-x-not-i]
                                              @x-not-j |
                                                x != j
                                                [by hypothesis given-x-not-j]
                                              @x-not-a |
                                                x != a
                                                [by hypothesis given-x-not-a]
                                              @x-not-b |
                                                x != b
                                                [by hypothesis given-x-not-b]
                                              @x-not-c |
                                                x != c
                                                [by hypothesis given-x-not-c]
                                              @ab-fixes-x |
                                                apply(transposition(a, b), x) = x
                                                [using specialize transpositionElsewhere(a, b, x) x-not-a x-not-b]
                                              @ac-fixes-x |
                                                apply(transposition(a, c), x) = x
                                                [using specialize transpositionElsewhere(a, c, x) x-not-a x-not-c]
                                              @ij-fixes-x |
                                                apply(transposition(i, j), x) = x
                                                [using specialize transpositionElsewhere(i, j, x) x-not-i x-not-j]
                                              @ia-fixes-x |
                                                apply(transposition(i, a), x) = x
                                                [using specialize transpositionElsewhere(i, a, x) x-not-i x-not-a]
                                              @ib-fixes-x |
                                                apply(transposition(i, b), x) = x
                                                [using specialize transpositionElsewhere(i, b, x) x-not-i x-not-b]
                                              @ic-fixes-x |
                                                apply(transposition(i, c), x) = x
                                                [using specialize transpositionElsewhere(i, c, x) x-not-i x-not-c]
                                              @lhs-split |
                                                apply(compose(transposition(a, c), transposition(a, b)), x) = apply(transposition(a, c), apply(transposition(a, b), x))
                                                [using simplify composeApply]
                                              @lhs-value |
                                                apply(compose(transposition(a, c), transposition(a, b)), x) = x
                                                [using simplify lhs-split ab-fixes-x ac-fixes-x]
                                              @rhs-split |
                                                apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x) =
                                                  apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, c), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), x))))))))))))
                                                [using simplify composeApply]
                                              @rhs-value |
                                                apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x) = x
                                                [using simplify rhs-split ij-fixes-x ia-fixes-x ib-fixes-x ic-fixes-x]
                                              @conclusion-agree |
                                                apply(compose(transposition(a, c), transposition(a, b)), x) =
                                                  apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                [using chain lhs-value rhs-value]
                                            }
                                          @conclusion-x-not-c |
                                            x != c -> apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                            [by discharge given-x-not-c]
                                        }
                                      @conclusion-x-not-b |
                                        x != b -> x != c -> apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                        [by discharge given-x-not-b]
                                    }
                                  @conclusion-x-not-a |
                                    x != a -> x != b -> x != c -> apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                    [by discharge given-x-not-a]
                                }
                              @conclusion-x-not-j |
                                x != j -> x != a -> x != b -> x != c -> apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                [by discharge given-x-not-j]
                            }
                          @conclusion-x-not-i |
                            x != i -> x != j -> x != a -> x != b -> x != c -> apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                            [by discharge given-x-not-i]
                        }
                      @discharge-x |
                        forall x: Element; x != i -> x != j -> x != a -> x != b -> x != c -> apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                        [by generalize generalize-x]
                    }
                  @discharge-c |
                    forall c, x: Element; x != i -> x != j -> x != a -> x != b -> x != c -> apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                    [by generalize generalize-c]
                }
              @discharge-b |
                forall b, c, x: Element; x != i -> x != j -> x != a -> x != b -> x != c -> apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b, c, x: Element; x != i -> x != j -> x != a -> x != b -> x != c -> apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b, c, x: Element; x != i -> x != j -> x != a -> x != b -> x != c -> apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b, c, x: Element; x != i -> x != j -> x != a -> x != b -> x != c ->
      apply(compose(transposition(a, c), transposition(a, b)), x) =
      apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
    [by generalize generalize-i]
qed

// The pointwise agreement behind identity (4): six cases on where x sits. The
// right-hand side is six 3-cycles — TWELVE transposition factors — so each case's
// nested `apply` is twelve deep; `simplify` reduces it, `chain` cannot.
theorem theFourthIdentityAgreesEverywhere: forall i, j, a, b, c: Element;
  i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
  forall x: Element;
  apply(compose(transposition(a, c), transposition(a, b)), x) =
  apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-i-not-a |
                            assume i != a {
                              @given-i-not-b |
                                assume i != b {
                                  @given-i-not-c |
                                    assume i != c {
                                      @given-j-not-a |
                                        assume j != a {
                                          @given-j-not-b |
                                            assume j != b {
                                              @given-j-not-c |
                                                assume j != c {
                                                  @given-a-not-b |
                                                    assume a != b {
                                                      @given-a-not-c |
                                                        assume a != c {
                                                          @given-b-not-c |
                                                            assume b != c {
                                                              @i-not-j |
                                                                i != j
                                                                [by hypothesis given-i-not-j]
                                                              @i-not-a |
                                                                i != a
                                                                [by hypothesis given-i-not-a]
                                                              @i-not-b |
                                                                i != b
                                                                [by hypothesis given-i-not-b]
                                                              @i-not-c |
                                                                i != c
                                                                [by hypothesis given-i-not-c]
                                                              @j-not-a |
                                                                j != a
                                                                [by hypothesis given-j-not-a]
                                                              @j-not-b |
                                                                j != b
                                                                [by hypothesis given-j-not-b]
                                                              @j-not-c |
                                                                j != c
                                                                [by hypothesis given-j-not-c]
                                                              @a-not-b |
                                                                a != b
                                                                [by hypothesis given-a-not-b]
                                                              @a-not-c |
                                                                a != c
                                                                [by hypothesis given-a-not-c]
                                                              @b-not-c |
                                                                b != c
                                                                [by hypothesis given-b-not-c]
                                                              @generalize-x |
                                                                fix x: Element {
                                                                  @cases |
                                                                    x = i or x = j or x = a or x = b or x = c or (x != i and x != j and x != a and x != b and x != c)
                                                                    [using tautology]
                                                                  @conclusion-at-x |
                                                                    apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                                    case cases {
                                                                      @when-x-is-i |
                                                                        assume x = i {
                                                                          @x-is-i |
                                                                            x = i
                                                                            [by hypothesis when-x-is-i]
                                                                          @agree-at-i |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), i) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                                                            [using specialize fourthIdentityAgreesAtI(i, j, a, b, c) i-not-a i-not-b i-not-c i-not-j j-not-a j-not-c j-not-b]
                                                                          @conclusion-when-x-is-i |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                                            [by rewrite x-is-i agree-at-i]
                                                                        }
                                                                      @when-x-is-j |
                                                                        assume x = j {
                                                                          @x-is-j |
                                                                            x = j
                                                                            [by hypothesis when-x-is-j]
                                                                          @agree-at-j |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), j) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                                                            [using specialize fourthIdentityAgreesAtJ(i, j, a, b, c) i-not-j j-not-a j-not-b j-not-c i-not-a a-not-b a-not-c]
                                                                          @conclusion-when-x-is-j |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                                            [by rewrite x-is-j agree-at-j]
                                                                        }
                                                                      @when-x-is-a |
                                                                        assume x = a {
                                                                          @x-is-a |
                                                                            x = a
                                                                            [by hypothesis when-x-is-a]
                                                                          @agree-at-a |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                                                            [using specialize fourthIdentityAgreesAtA(i, j, a, b, c) i-not-j j-not-b i-not-a j-not-a i-not-b a-not-b b-not-c]
                                                                          @conclusion-when-x-is-a |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                                            [by rewrite x-is-a agree-at-a]
                                                                        }
                                                                      @when-x-is-b |
                                                                        assume x = b {
                                                                          @x-is-b |
                                                                            x = b
                                                                            [by hypothesis when-x-is-b]
                                                                          @agree-at-b |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                                                            [using specialize fourthIdentityAgreesAtB(i, j, a, b, c) i-not-j j-not-b i-not-b a-not-b i-not-c j-not-c a-not-c]
                                                                          @conclusion-when-x-is-b |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                                            [by rewrite x-is-b agree-at-b]
                                                                        }
                                                                      @when-x-is-c |
                                                                        assume x = c {
                                                                          @x-is-c |
                                                                            x = c
                                                                            [by hypothesis when-x-is-c]
                                                                          @agree-at-c |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), c)
                                                                            [using specialize fourthIdentityAgreesAtC(i, j, a, b, c) i-not-j j-not-a i-not-c j-not-c a-not-c b-not-c]
                                                                          @conclusion-when-x-is-c |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                                            [by rewrite x-is-c agree-at-c]
                                                                        }
                                                                      @when-x-is-elsewhere |
                                                                        assume x != i and x != j and x != a and x != b and x != c {
                                                                          @x-is-elsewhere |
                                                                            x != i and x != j and x != a and x != b and x != c
                                                                            [by hypothesis when-x-is-elsewhere]
                                                                          @x-not-i |
                                                                            x != i
                                                                            [using tautology x-is-elsewhere]
                                                                          @x-not-j |
                                                                            x != j
                                                                            [using tautology x-is-elsewhere]
                                                                          @x-not-a |
                                                                            x != a
                                                                            [using tautology x-is-elsewhere]
                                                                          @x-not-b |
                                                                            x != b
                                                                            [using tautology x-is-elsewhere]
                                                                          @x-not-c |
                                                                            x != c
                                                                            [using tautology x-is-elsewhere]
                                                                          @conclusion-when-x-is-elsewhere |
                                                                            apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                                            [using specialize fourthIdentityAgreesElsewhere(i, j, a, b, c, x) x-not-i x-not-j x-not-a x-not-b x-not-c]
                                                                        }
                                                                    }
                                                                }
                                                              @discharge-x |
                                                                forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                                [by generalize generalize-x]
                                                            }
                                                          @conclusion-b-not-c |
                                                            b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                            [by discharge given-b-not-c]
                                                        }
                                                      @conclusion-a-not-c |
                                                        a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by discharge given-a-not-c]
                                                    }
                                                  @conclusion-a-not-b |
                                                    a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                    [by discharge given-a-not-b]
                                                }
                                              @conclusion-j-not-c |
                                                j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                [by discharge given-j-not-c]
                                            }
                                          @conclusion-j-not-b |
                                            j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                            [by discharge given-j-not-b]
                                        }
                                      @conclusion-j-not-a |
                                        j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                        [by discharge given-j-not-a]
                                    }
                                  @conclusion-i-not-c |
                                    i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                    [by discharge given-i-not-c]
                                }
                              @conclusion-i-not-b |
                                i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                [by discharge given-i-not-b]
                            }
                          @conclusion-i-not-a |
                            i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                            [by discharge given-i-not-a]
                        }
                      @conclusion-i-not-j |
                        i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                        [by discharge given-i-not-j]
                    }
                  @discharge-c |
                    forall c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                    [by generalize generalize-c]
                }
              @discharge-b |
                forall b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
    [by generalize generalize-i]
qed

// Judson Lemma 2, identity (4): (a,b,c) = (i,j,a)^2(i,j,c)(i,j,b)^2(i,j,a) — a 3-cycle
// on three points none of which is i or j, written in the fixed-(i,j) family.
theorem aThreeCycleAwayFromTheFixedPairFactors: forall i, j, a, b, c: Element;
  i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
  compose(transposition(a, c), transposition(a, b)) =
  compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-i-not-a |
                            assume i != a {
                              @given-i-not-b |
                                assume i != b {
                                  @given-i-not-c |
                                    assume i != c {
                                      @given-j-not-a |
                                        assume j != a {
                                          @given-j-not-b |
                                            assume j != b {
                                              @given-j-not-c |
                                                assume j != c {
                                                  @given-a-not-b |
                                                    assume a != b {
                                                      @given-a-not-c |
                                                        assume a != c {
                                                          @given-b-not-c |
                                                            assume b != c {
                                                              @i-not-j |
                                                                i != j
                                                                [by hypothesis given-i-not-j]
                                                              @i-not-a |
                                                                i != a
                                                                [by hypothesis given-i-not-a]
                                                              @i-not-b |
                                                                i != b
                                                                [by hypothesis given-i-not-b]
                                                              @i-not-c |
                                                                i != c
                                                                [by hypothesis given-i-not-c]
                                                              @j-not-a |
                                                                j != a
                                                                [by hypothesis given-j-not-a]
                                                              @j-not-b |
                                                                j != b
                                                                [by hypothesis given-j-not-b]
                                                              @j-not-c |
                                                                j != c
                                                                [by hypothesis given-j-not-c]
                                                              @a-not-b |
                                                                a != b
                                                                [by hypothesis given-a-not-b]
                                                              @a-not-c |
                                                                a != c
                                                                [by hypothesis given-a-not-c]
                                                              @b-not-c |
                                                                b != c
                                                                [by hypothesis given-b-not-c]
                                                              @agree-everywhere |
                                                                forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                                [using specialize theFourthIdentityAgreesEverywhere(i, j, a, b, c) i-not-j i-not-a i-not-b i-not-c j-not-a j-not-b j-not-c a-not-b a-not-c b-not-c]
                                                              @conclusion-equal |
                                                                compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                                [using specialize funcExtensionality(compose(transposition(a, c), transposition(a, b)), compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))) agree-everywhere]
                                                            }
                                                          @conclusion-b-not-c |
                                                            b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                            [by discharge given-b-not-c]
                                                        }
                                                      @conclusion-a-not-c |
                                                        a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                        [by discharge given-a-not-c]
                                                    }
                                                  @conclusion-a-not-b |
                                                    a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                    [by discharge given-a-not-b]
                                                }
                                              @conclusion-j-not-c |
                                                j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                [by discharge given-j-not-c]
                                            }
                                          @conclusion-j-not-b |
                                            j != b -> j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                            [by discharge given-j-not-b]
                                        }
                                      @conclusion-j-not-a |
                                        j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                        [by discharge given-j-not-a]
                                    }
                                  @conclusion-i-not-c |
                                    i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                    [by discharge given-i-not-c]
                                }
                              @conclusion-i-not-b |
                                i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                [by discharge given-i-not-b]
                            }
                          @conclusion-i-not-a |
                            i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                            [by discharge given-i-not-a]
                        }
                      @conclusion-i-not-j |
                        i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                        [by discharge given-i-not-j]
                    }
                  @discharge-c |
                    forall c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                    [by generalize generalize-c]
                }
              @discharge-b |
                forall b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c -> compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
      compose(transposition(a, c), transposition(a, b)) = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
    [by generalize generalize-i]
qed

// -- Judson's conjugation step -------------------------------------------------------------
//
// "Using the normality of N, we see that [(i,j)(a,k)](i,j,a)^2[(i,j)(a,k)]^-1 = (i,j,k) is
// in N." The conjugator sigma = (i,j)(a,k) is a product of DISJOINT transpositions, so it
// is its own inverse — which is what lets the statement avoid `inverse` entirely.

theorem aProductOfTwoDisjointTranspositionsSquaresToTheIdentity:
  forall i, j, a, k: Element;
  i != j -> a != k -> i != a -> i != k -> j != a -> j != k ->
  compose(compose(transposition(i, j), transposition(a, k)),
  compose(transposition(i, j), transposition(a, k))) = identityFn
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-k |
                fix k: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-a-not-k |
                        assume a != k {
                          @given-i-not-a |
                            assume i != a {
                              @given-i-not-k |
                                assume i != k {
                                  @given-j-not-a |
                                    assume j != a {
                                      @given-j-not-k |
                                        assume j != k {
                                          @i-not-j |
                                            i != j
                                            [by hypothesis given-i-not-j]
                                          @a-not-k |
                                            a != k
                                            [by hypothesis given-a-not-k]
                                          @i-not-a |
                                            i != a
                                            [by hypothesis given-i-not-a]
                                          @i-not-k |
                                            i != k
                                            [by hypothesis given-i-not-k]
                                          @j-not-a |
                                            j != a
                                            [by hypothesis given-j-not-a]
                                          @j-not-k |
                                            j != k
                                            [by hypothesis given-j-not-k]
                                          @ij-cancels |
                                            compose(transposition(i, j), transposition(i, j)) = identityFn
                                            [using specialize transpositionIsAnInvolution(i, j)]
                                          @ak-cancels |
                                            compose(transposition(a, k), transposition(a, k)) = identityFn
                                            [using specialize transpositionIsAnInvolution(a, k)]
                                          // `assoc(composeAssoc)` right-nests both sides, so the
                                          // regrouping is one step instead of four hand-written ones.
                                          @right-nested |
                                            compose(compose(transposition(i, j), transposition(a, k)),
                                              compose(transposition(i, j), transposition(a, k))) =
                                              compose(transposition(i, j),
                                              compose(transposition(a, k),
                                              compose(transposition(i, j), transposition(a, k))))
                                            [using assoc(composeAssoc)]
                                          // commute the inner (ak)(ij) -> (ij)(ak)
                                          @inner-commuted |
                                            compose(transposition(a, k), transposition(i, j)) = compose(transposition(i, j), transposition(a, k))
                                            [using specialize disjointTranspositionsCommute(i, j, a, k) i-not-j a-not-k i-not-a i-not-k j-not-a j-not-k]
                                          // after commuting, the tail is (ij)[(ak)(ak)] = (ij)·id
                                          @regrouped-after-commute |
                                            compose(transposition(a, k),
                                              compose(transposition(i, j), transposition(a, k))) =
                                              compose(compose(transposition(a, k), transposition(i, j)), transposition(a, k))
                                            [using assoc(composeAssoc)]
                                          @ij-times-identity |
                                            compose(transposition(i, j), identityFn) = transposition(i, j)
                                            [using specialize composeIdentityRight(transposition(i, j))]
                                          @tail-collapses |
                                            compose(compose(transposition(i, j), transposition(a, k)), transposition(a, k)) = transposition(i, j)
                                            [using simplify assocShift ak-cancels ij-times-identity]
                                          @assocShift |
                                            compose(compose(transposition(i, j), transposition(a, k)), transposition(a, k)) =
                                              compose(transposition(i, j), compose(transposition(a, k), transposition(a, k)))
                                            [using assoc(composeAssoc)]
                                          @conclusion-squares |
                                            compose(compose(transposition(i, j), transposition(a, k)),
                                              compose(transposition(i, j), transposition(a, k))) = identityFn
                                            [using simplify right-nested regrouped-after-commute inner-commuted tail-collapses ij-cancels]
                                        }
                                      @conclusion-j-not-k |
                                        j != k -> compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, j), transposition(a, k))) = identityFn
                                        [by discharge given-j-not-k]
                                    }
                                  @conclusion-j-not-a |
                                    j != a -> j != k -> compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, j), transposition(a, k))) = identityFn
                                    [by discharge given-j-not-a]
                                }
                              @conclusion-i-not-k |
                                i != k -> j != a -> j != k -> compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, j), transposition(a, k))) = identityFn
                                [by discharge given-i-not-k]
                            }
                          @conclusion-i-not-a |
                            i != a -> i != k -> j != a -> j != k -> compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, j), transposition(a, k))) = identityFn
                            [by discharge given-i-not-a]
                        }
                      @conclusion-a-not-k |
                        a != k -> i != a -> i != k -> j != a -> j != k -> compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, j), transposition(a, k))) = identityFn
                        [by discharge given-a-not-k]
                    }
                  @conclusion-i-not-j |
                    i != j -> a != k -> i != a -> i != k -> j != a -> j != k -> compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, j), transposition(a, k))) = identityFn
                    [by discharge given-i-not-j]
                }
              @discharge-k |
                forall k: Element; i != j -> a != k -> i != a -> i != k -> j != a -> j != k -> compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, j), transposition(a, k))) = identityFn
                [by generalize generalize-k]
            }
          @discharge-a |
            forall a, k: Element; i != j -> a != k -> i != a -> i != k -> j != a -> j != k -> compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, j), transposition(a, k))) = identityFn
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, k: Element; i != j -> a != k -> i != a -> i != k -> j != a -> j != k -> compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, j), transposition(a, k))) = identityFn
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, k: Element;
      i != j -> a != k -> i != a -> i != k -> j != a -> j != k ->
      compose(compose(transposition(i, j), transposition(a, k)),
      compose(transposition(i, j), transposition(a, k))) = identityFn
    [by generalize generalize-i]
qed

// sigma o sigma = id makes sigma its OWN two-sided inverse, so `inverse(sigma) = sigma`
// by uniqueness. This is what removes `inverse` from the conjugation statement.
theorem aProductOfTwoDisjointTranspositionsIsItsOwnInverse:
  forall i, j, a, k: Element;
  i != j -> a != k -> i != a -> i != k -> j != a -> j != k ->
  inverse(compose(transposition(i, j), transposition(a, k))) =
  compose(transposition(i, j), transposition(a, k))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-k |
                fix k: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-a-not-k |
                        assume a != k {
                          @given-i-not-a |
                            assume i != a {
                              @given-i-not-k |
                                assume i != k {
                                  @given-j-not-a |
                                    assume j != a {
                                      @given-j-not-k |
                                        assume j != k {
                                          @i-not-j |
                                            i != j
                                            [by hypothesis given-i-not-j]
                                          @a-not-k |
                                            a != k
                                            [by hypothesis given-a-not-k]
                                          @i-not-a |
                                            i != a
                                            [by hypothesis given-i-not-a]
                                          @i-not-k |
                                            i != k
                                            [by hypothesis given-i-not-k]
                                          @j-not-a |
                                            j != a
                                            [by hypothesis given-j-not-a]
                                          @j-not-k |
                                            j != k
                                            [by hypothesis given-j-not-k]
                                          @squares-to-identity |
                                            compose(compose(transposition(i, j), transposition(a, k)),
                                              compose(transposition(i, j), transposition(a, k))) = identityFn
                                            [using specialize aProductOfTwoDisjointTranspositionsSquaresToTheIdentity(i, j, a, k) i-not-j a-not-k i-not-a i-not-k j-not-a j-not-k]
                                          // sigma is invertible: it has sigma as a two-sided inverse
                                          @ij-is-a-permutation |
                                            invertible(transposition(i, j))
                                            [using specialize transpositionIsAPermutation(i, j)]
                                          @ak-is-a-permutation |
                                            invertible(transposition(a, k))
                                            [using specialize transpositionIsAPermutation(a, k)]
                                          @sigma-is-a-permutation |
                                            invertible(compose(transposition(i, j), transposition(a, k)))
                                            [using specialize composeIsAPermutation(transposition(i, j), transposition(a, k)) ij-is-a-permutation ak-is-a-permutation]
                                          @inverse-is-a-left-inverse |
                                            compose(inverse(compose(transposition(i, j), transposition(a, k))), compose(transposition(i, j), transposition(a, k))) = identityFn
                                            [using specialize function.inverseLeft(compose(transposition(i, j), transposition(a, k))) sigma-is-a-permutation]
                                          @conclusion-self-inverse |
                                            inverse(compose(transposition(i, j), transposition(a, k))) =
                                              compose(transposition(i, j), transposition(a, k))
                                            [using specialize aTwoSidedInverseIsUnique(compose(transposition(i, j), transposition(a, k)), inverse(compose(transposition(i, j), transposition(a, k))), compose(transposition(i, j), transposition(a, k))) inverse-is-a-left-inverse squares-to-identity]
                                        }
                                      @conclusion-j-not-k |
                                        j != k -> inverse(compose(transposition(i, j), transposition(a, k))) = compose(transposition(i, j), transposition(a, k))
                                        [by discharge given-j-not-k]
                                    }
                                  @conclusion-j-not-a |
                                    j != a -> j != k -> inverse(compose(transposition(i, j), transposition(a, k))) = compose(transposition(i, j), transposition(a, k))
                                    [by discharge given-j-not-a]
                                }
                              @conclusion-i-not-k |
                                i != k -> j != a -> j != k -> inverse(compose(transposition(i, j), transposition(a, k))) = compose(transposition(i, j), transposition(a, k))
                                [by discharge given-i-not-k]
                            }
                          @conclusion-i-not-a |
                            i != a -> i != k -> j != a -> j != k -> inverse(compose(transposition(i, j), transposition(a, k))) = compose(transposition(i, j), transposition(a, k))
                            [by discharge given-i-not-a]
                        }
                      @conclusion-a-not-k |
                        a != k -> i != a -> i != k -> j != a -> j != k -> inverse(compose(transposition(i, j), transposition(a, k))) = compose(transposition(i, j), transposition(a, k))
                        [by discharge given-a-not-k]
                    }
                  @conclusion-i-not-j |
                    i != j -> a != k -> i != a -> i != k -> j != a -> j != k -> inverse(compose(transposition(i, j), transposition(a, k))) = compose(transposition(i, j), transposition(a, k))
                    [by discharge given-i-not-j]
                }
              @discharge-k |
                forall k: Element; i != j -> a != k -> i != a -> i != k -> j != a -> j != k -> inverse(compose(transposition(i, j), transposition(a, k))) = compose(transposition(i, j), transposition(a, k))
                [by generalize generalize-k]
            }
          @discharge-a |
            forall a, k: Element; i != j -> a != k -> i != a -> i != k -> j != a -> j != k -> inverse(compose(transposition(i, j), transposition(a, k))) = compose(transposition(i, j), transposition(a, k))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, k: Element; i != j -> a != k -> i != a -> i != k -> j != a -> j != k -> inverse(compose(transposition(i, j), transposition(a, k))) = compose(transposition(i, j), transposition(a, k))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, k: Element;
      i != j -> a != k -> i != a -> i != k -> j != a -> j != k ->
      inverse(compose(transposition(i, j), transposition(a, k))) =
      compose(transposition(i, j), transposition(a, k))
    [by generalize generalize-i]
qed

// -- a 3-cycle is invariant under ROTATION of its points -----------------------------------
//
// `(j,k,i) = (i,j,k)`: the same cycle, started at a different point. Needed by the
// conjugation step, where conjugating `(i,j,a)^2` by `(i,j)(a,k)` lands on `(j,i,k)^2`,
// which identity (1) turns into `(j,k,i)` — and that is `(i,j,k)`, Judson's claim.

// at i.
theorem rotationAgreesAtI: forall i, j, k: Element;
  i != j -> i != k -> j != k ->
  apply(compose(transposition(j, i), transposition(j, k)), i) = apply(compose(transposition(i, k), transposition(i, j)), i)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-k |
            fix k: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-k |
                    assume i != k {
                      @given-j-not-k |
                        assume j != k {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-k |
                            i != k
                            [by hypothesis given-i-not-k]
                          @j-not-k |
                            j != k
                            [by hypothesis given-j-not-k]
                          @j-not-i |
                            j != i
                            [using specialize disequalityIsSymmetric(i, j) i-not-j]
                          @jk-fixes-i |
                            apply(transposition(j, k), i) = i
                            [using specialize transpositionElsewhere(j, k, i) i-not-j i-not-k]
                          @ji-sends-i |
                            apply(transposition(j, i), i) = j
                            [using specialize transpositionAtSecond(j, i)]
                          @ij-sends-i |
                            apply(transposition(i, j), i) = j
                            [using specialize transpositionAtFirst(i, j)]
                          @ik-fixes-j |
                            apply(transposition(i, k), j) = j
                            [using specialize transpositionElsewhere(i, k, j) j-not-i j-not-k]
                          @lhs-split |
                            apply(compose(transposition(j, i), transposition(j, k)), i) = apply(transposition(j, i), apply(transposition(j, k), i))
                            [using simplify composeApply]
                          @lhs-value |
                            apply(compose(transposition(j, i), transposition(j, k)), i) = j
                            [using simplify lhs-split jk-fixes-i ji-sends-i]
                          @rhs-split |
                            apply(compose(transposition(i, k), transposition(i, j)), i) = apply(transposition(i, k), apply(transposition(i, j), i))
                            [using simplify composeApply]
                          @rhs-value |
                            apply(compose(transposition(i, k), transposition(i, j)), i) = j
                            [using simplify rhs-split ij-sends-i ik-fixes-j]
                          @conclusion-agree |
                            apply(compose(transposition(j, i), transposition(j, k)), i) = apply(compose(transposition(i, k), transposition(i, j)), i)
                            [using chain lhs-value rhs-value]
                        }
                      @conclusion-j-not-k |
                        j != k -> apply(compose(transposition(j, i), transposition(j, k)), i) = apply(compose(transposition(i, k), transposition(i, j)), i)
                        [by discharge given-j-not-k]
                    }
                  @conclusion-i-not-k |
                    i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), i) = apply(compose(transposition(i, k), transposition(i, j)), i)
                    [by discharge given-i-not-k]
                }
              @conclusion-i-not-j |
                i != j -> i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), i) = apply(compose(transposition(i, k), transposition(i, j)), i)
                [by discharge given-i-not-j]
            }
          @discharge-k |
            forall k: Element; i != j -> i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), i) = apply(compose(transposition(i, k), transposition(i, j)), i)
            [by generalize generalize-k]
        }
      @discharge-j |
        forall j, k: Element; i != j -> i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), i) = apply(compose(transposition(i, k), transposition(i, j)), i)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, k: Element; i != j -> i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), i) = apply(compose(transposition(i, k), transposition(i, j)), i)
    [by generalize generalize-i]
qed

// at j.
theorem rotationAgreesAtJ: forall i, j, k: Element;
  i != k -> j != k ->
  apply(compose(transposition(j, i), transposition(j, k)), j) = apply(compose(transposition(i, k), transposition(i, j)), j)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-k |
            fix k: Element {
              @given-i-not-k |
                assume i != k {
                  @given-j-not-k |
                    assume j != k {
                      @i-not-k |
                        i != k
                        [by hypothesis given-i-not-k]
                      @j-not-k |
                        j != k
                        [by hypothesis given-j-not-k]
                      @k-not-i |
                        k != i
                        [using specialize disequalityIsSymmetric(i, k) i-not-k]
                      @k-not-j |
                        k != j
                        [using specialize disequalityIsSymmetric(j, k) j-not-k]
                      @jk-sends-j |
                        apply(transposition(j, k), j) = k
                        [using specialize transpositionAtFirst(j, k)]
                      @ji-fixes-k |
                        apply(transposition(j, i), k) = k
                        [using specialize transpositionElsewhere(j, i, k) k-not-j k-not-i]
                      @ij-sends-j |
                        apply(transposition(i, j), j) = i
                        [using specialize transpositionAtSecond(i, j)]
                      @ik-sends-i |
                        apply(transposition(i, k), i) = k
                        [using specialize transpositionAtFirst(i, k)]
                      @lhs-split |
                        apply(compose(transposition(j, i), transposition(j, k)), j) = apply(transposition(j, i), apply(transposition(j, k), j))
                        [using simplify composeApply]
                      @lhs-value |
                        apply(compose(transposition(j, i), transposition(j, k)), j) = k
                        [using simplify lhs-split jk-sends-j ji-fixes-k]
                      @rhs-split |
                        apply(compose(transposition(i, k), transposition(i, j)), j) = apply(transposition(i, k), apply(transposition(i, j), j))
                        [using simplify composeApply]
                      @rhs-value |
                        apply(compose(transposition(i, k), transposition(i, j)), j) = k
                        [using simplify rhs-split ij-sends-j ik-sends-i]
                      @conclusion-agree |
                        apply(compose(transposition(j, i), transposition(j, k)), j) = apply(compose(transposition(i, k), transposition(i, j)), j)
                        [using chain lhs-value rhs-value]
                    }
                  @conclusion-j-not-k |
                    j != k -> apply(compose(transposition(j, i), transposition(j, k)), j) = apply(compose(transposition(i, k), transposition(i, j)), j)
                    [by discharge given-j-not-k]
                }
              @conclusion-i-not-k |
                i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), j) = apply(compose(transposition(i, k), transposition(i, j)), j)
                [by discharge given-i-not-k]
            }
          @discharge-k |
            forall k: Element; i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), j) = apply(compose(transposition(i, k), transposition(i, j)), j)
            [by generalize generalize-k]
        }
      @discharge-j |
        forall j, k: Element; i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), j) = apply(compose(transposition(i, k), transposition(i, j)), j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, k: Element; i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), j) = apply(compose(transposition(i, k), transposition(i, j)), j)
    [by generalize generalize-i]
qed

// at k.
theorem rotationAgreesAtK: forall i, j, k: Element;
  i != k -> j != k ->
  apply(compose(transposition(j, i), transposition(j, k)), k) = apply(compose(transposition(i, k), transposition(i, j)), k)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-k |
            fix k: Element {
              @given-i-not-k |
                assume i != k {
                  @given-j-not-k |
                    assume j != k {
                      @i-not-k |
                        i != k
                        [by hypothesis given-i-not-k]
                      @j-not-k |
                        j != k
                        [by hypothesis given-j-not-k]
                      @k-not-i |
                        k != i
                        [using specialize disequalityIsSymmetric(i, k) i-not-k]
                      @k-not-j |
                        k != j
                        [using specialize disequalityIsSymmetric(j, k) j-not-k]
                      @jk-sends-k |
                        apply(transposition(j, k), k) = j
                        [using specialize transpositionAtSecond(j, k)]
                      @ji-sends-j |
                        apply(transposition(j, i), j) = i
                        [using specialize transpositionAtFirst(j, i)]
                      @ij-fixes-k |
                        apply(transposition(i, j), k) = k
                        [using specialize transpositionElsewhere(i, j, k) k-not-i k-not-j]
                      @ik-sends-k |
                        apply(transposition(i, k), k) = i
                        [using specialize transpositionAtSecond(i, k)]
                      @lhs-split |
                        apply(compose(transposition(j, i), transposition(j, k)), k) = apply(transposition(j, i), apply(transposition(j, k), k))
                        [using simplify composeApply]
                      @lhs-value |
                        apply(compose(transposition(j, i), transposition(j, k)), k) = i
                        [using simplify lhs-split jk-sends-k ji-sends-j]
                      @rhs-split |
                        apply(compose(transposition(i, k), transposition(i, j)), k) = apply(transposition(i, k), apply(transposition(i, j), k))
                        [using simplify composeApply]
                      @rhs-value |
                        apply(compose(transposition(i, k), transposition(i, j)), k) = i
                        [using simplify rhs-split ij-fixes-k ik-sends-k]
                      @conclusion-agree |
                        apply(compose(transposition(j, i), transposition(j, k)), k) = apply(compose(transposition(i, k), transposition(i, j)), k)
                        [using chain lhs-value rhs-value]
                    }
                  @conclusion-j-not-k |
                    j != k -> apply(compose(transposition(j, i), transposition(j, k)), k) = apply(compose(transposition(i, k), transposition(i, j)), k)
                    [by discharge given-j-not-k]
                }
              @conclusion-i-not-k |
                i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), k) = apply(compose(transposition(i, k), transposition(i, j)), k)
                [by discharge given-i-not-k]
            }
          @discharge-k |
            forall k: Element; i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), k) = apply(compose(transposition(i, k), transposition(i, j)), k)
            [by generalize generalize-k]
        }
      @discharge-j |
        forall j, k: Element; i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), k) = apply(compose(transposition(i, k), transposition(i, j)), k)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, k: Element; i != k -> j != k -> apply(compose(transposition(j, i), transposition(j, k)), k) = apply(compose(transposition(i, k), transposition(i, j)), k)
    [by generalize generalize-i]
qed

// elsewhere: every factor fixes x.
theorem rotationAgreesElsewhere: forall i, j, k, x: Element;
  x != i -> x != j -> x != k ->
  apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-k |
            fix k: Element {
              @generalize-x |
                fix x: Element {
                  @given-x-not-i |
                    assume x != i {
                      @given-x-not-j |
                        assume x != j {
                          @given-x-not-k |
                            assume x != k {
                              @x-not-i |
                                x != i
                                [by hypothesis given-x-not-i]
                              @x-not-j |
                                x != j
                                [by hypothesis given-x-not-j]
                              @x-not-k |
                                x != k
                                [by hypothesis given-x-not-k]
                              @jk-fixes-x |
                                apply(transposition(j, k), x) = x
                                [using specialize transpositionElsewhere(j, k, x) x-not-j x-not-k]
                              @ji-fixes-x |
                                apply(transposition(j, i), x) = x
                                [using specialize transpositionElsewhere(j, i, x) x-not-j x-not-i]
                              @ij-fixes-x |
                                apply(transposition(i, j), x) = x
                                [using specialize transpositionElsewhere(i, j, x) x-not-i x-not-j]
                              @ik-fixes-x |
                                apply(transposition(i, k), x) = x
                                [using specialize transpositionElsewhere(i, k, x) x-not-i x-not-k]
                              @lhs-split |
                                apply(compose(transposition(j, i), transposition(j, k)), x) = apply(transposition(j, i), apply(transposition(j, k), x))
                                [using simplify composeApply]
                              @lhs-value |
                                apply(compose(transposition(j, i), transposition(j, k)), x) = x
                                [using simplify lhs-split jk-fixes-x ji-fixes-x]
                              @rhs-split |
                                apply(compose(transposition(i, k), transposition(i, j)), x) = apply(transposition(i, k), apply(transposition(i, j), x))
                                [using simplify composeApply]
                              @rhs-value |
                                apply(compose(transposition(i, k), transposition(i, j)), x) = x
                                [using simplify rhs-split ij-fixes-x ik-fixes-x]
                              @conclusion-agree |
                                apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-x-not-k |
                            x != k -> apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                            [by discharge given-x-not-k]
                        }
                      @conclusion-x-not-j |
                        x != j -> x != k -> apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                        [by discharge given-x-not-j]
                    }
                  @conclusion-x-not-i |
                    x != i -> x != j -> x != k -> apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                    [by discharge given-x-not-i]
                }
              @discharge-x |
                forall x: Element; x != i -> x != j -> x != k -> apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                [by generalize generalize-x]
            }
          @discharge-k |
            forall k, x: Element; x != i -> x != j -> x != k -> apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
            [by generalize generalize-k]
        }
      @discharge-j |
        forall j, k, x: Element; x != i -> x != j -> x != k -> apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, k, x: Element; x != i -> x != j -> x != k -> apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
    [by generalize generalize-i]
qed

// pointwise agreement for the rotation, four cases.
theorem theRotationAgreesEverywhere: forall i, j, k: Element;
  i != j -> i != k -> j != k ->
  forall x: Element; apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-k |
            fix k: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-k |
                    assume i != k {
                      @given-j-not-k |
                        assume j != k {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-k |
                            i != k
                            [by hypothesis given-i-not-k]
                          @j-not-k |
                            j != k
                            [by hypothesis given-j-not-k]
                          @generalize-x |
                            fix x: Element {
                              @cases |
                                x = i or x = j or x = k or (x != i and x != j and x != k)
                                [using tautology]
                              @conclusion-at-x |
                                apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                                case cases {
                                  @when-x-is-i |
                                    assume x = i {
                                      @x-is-i |
                                        x = i
                                        [by hypothesis when-x-is-i]
                                      @agree-at-i |
                                        apply(compose(transposition(j, i), transposition(j, k)), i) = apply(compose(transposition(i, k), transposition(i, j)), i)
                                        [using specialize rotationAgreesAtI(i, j, k) i-not-j i-not-k j-not-k]
                                      @conclusion-when-x-is-i |
                                        apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                                        [by rewrite x-is-i agree-at-i]
                                    }
                                  @when-x-is-j |
                                    assume x = j {
                                      @x-is-j |
                                        x = j
                                        [by hypothesis when-x-is-j]
                                      @agree-at-j |
                                        apply(compose(transposition(j, i), transposition(j, k)), j) = apply(compose(transposition(i, k), transposition(i, j)), j)
                                        [using specialize rotationAgreesAtJ(i, j, k) i-not-k j-not-k]
                                      @conclusion-when-x-is-j |
                                        apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                                        [by rewrite x-is-j agree-at-j]
                                    }
                                  @when-x-is-k |
                                    assume x = k {
                                      @x-is-k |
                                        x = k
                                        [by hypothesis when-x-is-k]
                                      @agree-at-k |
                                        apply(compose(transposition(j, i), transposition(j, k)), k) = apply(compose(transposition(i, k), transposition(i, j)), k)
                                        [using specialize rotationAgreesAtK(i, j, k) i-not-k j-not-k]
                                      @conclusion-when-x-is-k |
                                        apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                                        [by rewrite x-is-k agree-at-k]
                                    }
                                  @when-x-is-elsewhere |
                                    assume x != i and x != j and x != k {
                                      @x-is-elsewhere |
                                        x != i and x != j and x != k
                                        [by hypothesis when-x-is-elsewhere]
                                      @x-not-i |
                                        x != i
                                        [using tautology x-is-elsewhere]
                                      @x-not-j |
                                        x != j
                                        [using tautology x-is-elsewhere]
                                      @x-not-k |
                                        x != k
                                        [using tautology x-is-elsewhere]
                                      @conclusion-when-x-is-elsewhere |
                                        apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                                        [using specialize rotationAgreesElsewhere(i, j, k, x) x-not-i x-not-j x-not-k]
                                    }
                                }
                            }
                          @discharge-x |
                            forall x: Element; apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                            [by generalize generalize-x]
                        }
                      @conclusion-j-not-k |
                        j != k -> forall x: Element; apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                        [by discharge given-j-not-k]
                    }
                  @conclusion-i-not-k |
                    i != k -> j != k -> forall x: Element; apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                    [by discharge given-i-not-k]
                }
              @conclusion-i-not-j |
                i != j -> i != k -> j != k -> forall x: Element; apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                [by discharge given-i-not-j]
            }
          @discharge-k |
            forall k: Element; i != j -> i != k -> j != k -> forall x: Element; apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
            [by generalize generalize-k]
        }
      @discharge-j |
        forall j, k: Element; i != j -> i != k -> j != k -> forall x: Element; apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, k: Element; i != j -> i != k -> j != k -> forall x: Element; apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
    [by generalize generalize-i]
qed

// (j,k,i) = (i,j,k) — a 3-cycle is the same permutation started at any of its points.
theorem aThreeCycleIsInvariantUnderRotation: forall i, j, k: Element;
  i != j -> i != k -> j != k ->
  compose(transposition(j, i), transposition(j, k)) = compose(transposition(i, k), transposition(i, j))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-k |
            fix k: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-k |
                    assume i != k {
                      @given-j-not-k |
                        assume j != k {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-k |
                            i != k
                            [by hypothesis given-i-not-k]
                          @j-not-k |
                            j != k
                            [by hypothesis given-j-not-k]
                          @agree-everywhere |
                            forall x: Element; apply(compose(transposition(j, i), transposition(j, k)), x) = apply(compose(transposition(i, k), transposition(i, j)), x)
                            [using specialize theRotationAgreesEverywhere(i, j, k) i-not-j i-not-k j-not-k]
                          @conclusion-equal |
                            compose(transposition(j, i), transposition(j, k)) = compose(transposition(i, k), transposition(i, j))
                            [using specialize funcExtensionality(compose(transposition(j, i), transposition(j, k)), compose(transposition(i, k), transposition(i, j))) agree-everywhere]
                        }
                      @conclusion-j-not-k |
                        j != k -> compose(transposition(j, i), transposition(j, k)) = compose(transposition(i, k), transposition(i, j))
                        [by discharge given-j-not-k]
                    }
                  @conclusion-i-not-k |
                    i != k -> j != k -> compose(transposition(j, i), transposition(j, k)) = compose(transposition(i, k), transposition(i, j))
                    [by discharge given-i-not-k]
                }
              @conclusion-i-not-j |
                i != j -> i != k -> j != k -> compose(transposition(j, i), transposition(j, k)) = compose(transposition(i, k), transposition(i, j))
                [by discharge given-i-not-j]
            }
          @discharge-k |
            forall k: Element; i != j -> i != k -> j != k -> compose(transposition(j, i), transposition(j, k)) = compose(transposition(i, k), transposition(i, j))
            [by generalize generalize-k]
        }
      @discharge-j |
        forall j, k: Element; i != j -> i != k -> j != k -> compose(transposition(j, i), transposition(j, k)) = compose(transposition(i, k), transposition(i, j))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, k: Element; i != j -> i != k -> j != k -> compose(transposition(j, i), transposition(j, k)) = compose(transposition(i, k), transposition(i, j))
    [by generalize generalize-i]
qed

// -- the conjugator's action on the four letters -------------------------------------------
// sigma = (i,j)(a,k) sends i<->j and a<->k. Each fact is two steps: the inner (ak) or the
// outer (ij) moves the point, the other fixes it.
// sigma(i) = j: (ak) fixes i, then (ij) sends i to j.
theorem theConjugatorSendsFirstToSecond: forall i, j, a, k: Element;
  i != a -> i != k ->
  apply(compose(transposition(i, j), transposition(a, k)), i) = j
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-k |
                fix k: Element {
                  @given-i-not-a |
                    assume i != a {
                      @given-i-not-k |
                        assume i != k {
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @i-not-k |
                            i != k
                            [by hypothesis given-i-not-k]
                          @ak-fixes-i |
                            apply(transposition(a, k), i) = i
                            [using specialize transpositionElsewhere(a, k, i) i-not-a i-not-k]
                          @ij-sends-i |
                            apply(transposition(i, j), i) = j
                            [using specialize transpositionAtFirst(i, j)]
                          @split |
                            apply(compose(transposition(i, j), transposition(a, k)), i) =
                              apply(transposition(i, j), apply(transposition(a, k), i))
                            [using simplify composeApply]
                          @conclusion-image |
                            apply(compose(transposition(i, j), transposition(a, k)), i) = j
                            [using simplify split ak-fixes-i ij-sends-i]
                        }
                      @conclusion-i-not-k |
                        i != k -> apply(compose(transposition(i, j), transposition(a, k)), i) = j
                        [by discharge given-i-not-k]
                    }
                  @conclusion-i-not-a |
                    i != a -> i != k -> apply(compose(transposition(i, j), transposition(a, k)), i) = j
                    [by discharge given-i-not-a]
                }
              @discharge-k |
                forall k: Element; i != a -> i != k -> apply(compose(transposition(i, j), transposition(a, k)), i) = j
                [by generalize generalize-k]
            }
          @discharge-a |
            forall a, k: Element; i != a -> i != k -> apply(compose(transposition(i, j), transposition(a, k)), i) = j
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, k: Element; i != a -> i != k -> apply(compose(transposition(i, j), transposition(a, k)), i) = j
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, k: Element; i != a -> i != k ->
      apply(compose(transposition(i, j), transposition(a, k)), i) = j
    [by generalize generalize-i]
qed

// sigma(j) = i: (ak) fixes j, then (ij) sends j to i.
theorem theConjugatorSendsSecondToFirst: forall i, j, a, k: Element;
  j != a -> j != k ->
  apply(compose(transposition(i, j), transposition(a, k)), j) = i
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-k |
                fix k: Element {
                  @given-j-not-a |
                    assume j != a {
                      @given-j-not-k |
                        assume j != k {
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @j-not-k |
                            j != k
                            [by hypothesis given-j-not-k]
                          @ak-fixes-j |
                            apply(transposition(a, k), j) = j
                            [using specialize transpositionElsewhere(a, k, j) j-not-a j-not-k]
                          @ij-sends-j |
                            apply(transposition(i, j), j) = i
                            [using specialize transpositionAtSecond(i, j)]
                          @split |
                            apply(compose(transposition(i, j), transposition(a, k)), j) = apply(transposition(i, j), apply(transposition(a, k), j))
                            [using simplify composeApply]
                          @conclusion-image |
                            apply(compose(transposition(i, j), transposition(a, k)), j) = i
                            [using simplify split ak-fixes-j ij-sends-j]
                        }
                      @conclusion-j-not-k |
                        j != k -> apply(compose(transposition(i, j), transposition(a, k)), j) = i
                        [by discharge given-j-not-k]
                    }
                  @conclusion-j-not-a |
                    j != a -> j != k -> apply(compose(transposition(i, j), transposition(a, k)), j) = i
                    [by discharge given-j-not-a]
                }
              @discharge-k |
                forall k: Element; j != a -> j != k -> apply(compose(transposition(i, j), transposition(a, k)), j) = i
                [by generalize generalize-k]
            }
          @discharge-a |
            forall a, k: Element; j != a -> j != k -> apply(compose(transposition(i, j), transposition(a, k)), j) = i
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, k: Element; j != a -> j != k -> apply(compose(transposition(i, j), transposition(a, k)), j) = i
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, k: Element; j != a -> j != k -> apply(compose(transposition(i, j), transposition(a, k)), j) = i
    [by generalize generalize-i]
qed

// sigma(a) = k: (ak) sends a to k, then (ij) fixes k.
theorem theConjugatorSendsThirdToFourth: forall i, j, a, k: Element;
  i != k -> j != k ->
  apply(compose(transposition(i, j), transposition(a, k)), a) = k
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-k |
                fix k: Element {
                  @given-i-not-k |
                    assume i != k {
                      @given-j-not-k |
                        assume j != k {
                          @i-not-k |
                            i != k
                            [by hypothesis given-i-not-k]
                          @j-not-k |
                            j != k
                            [by hypothesis given-j-not-k]
                          @k-not-i |
                            k != i
                            [using specialize disequalityIsSymmetric(i, k) i-not-k]
                          @k-not-j |
                            k != j
                            [using specialize disequalityIsSymmetric(j, k) j-not-k]
                          @ak-sends-a |
                            apply(transposition(a, k), a) = k
                            [using specialize transpositionAtFirst(a, k)]
                          @ij-fixes-k |
                            apply(transposition(i, j), k) = k
                            [using specialize transpositionElsewhere(i, j, k) k-not-i k-not-j]
                          @split |
                            apply(compose(transposition(i, j), transposition(a, k)), a) = apply(transposition(i, j), apply(transposition(a, k), a))
                            [using simplify composeApply]
                          @conclusion-image |
                            apply(compose(transposition(i, j), transposition(a, k)), a) = k
                            [using simplify split ak-sends-a ij-fixes-k]
                        }
                      @conclusion-j-not-k |
                        j != k -> apply(compose(transposition(i, j), transposition(a, k)), a) = k
                        [by discharge given-j-not-k]
                    }
                  @conclusion-i-not-k |
                    i != k -> j != k -> apply(compose(transposition(i, j), transposition(a, k)), a) = k
                    [by discharge given-i-not-k]
                }
              @discharge-k |
                forall k: Element; i != k -> j != k -> apply(compose(transposition(i, j), transposition(a, k)), a) = k
                [by generalize generalize-k]
            }
          @discharge-a |
            forall a, k: Element; i != k -> j != k -> apply(compose(transposition(i, j), transposition(a, k)), a) = k
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, k: Element; i != k -> j != k -> apply(compose(transposition(i, j), transposition(a, k)), a) = k
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, k: Element; i != k -> j != k -> apply(compose(transposition(i, j), transposition(a, k)), a) = k
    [by generalize generalize-i]
qed

// sigma(k) = a: (ak) sends k to a, then (ij) fixes a.
theorem theConjugatorSendsFourthToThird: forall i, j, a, k: Element;
  i != a -> j != a ->
  apply(compose(transposition(i, j), transposition(a, k)), k) = a
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-k |
                fix k: Element {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @a-not-i |
                            a != i
                            [using specialize disequalityIsSymmetric(i, a) i-not-a]
                          @a-not-j |
                            a != j
                            [using specialize disequalityIsSymmetric(j, a) j-not-a]
                          @ak-sends-k |
                            apply(transposition(a, k), k) = a
                            [using specialize transpositionAtSecond(a, k)]
                          @ij-fixes-a |
                            apply(transposition(i, j), a) = a
                            [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                          @split |
                            apply(compose(transposition(i, j), transposition(a, k)), k) = apply(transposition(i, j), apply(transposition(a, k), k))
                            [using simplify composeApply]
                          @conclusion-image |
                            apply(compose(transposition(i, j), transposition(a, k)), k) = a
                            [using simplify split ak-sends-k ij-fixes-a]
                        }
                      @conclusion-j-not-a |
                        j != a -> apply(compose(transposition(i, j), transposition(a, k)), k) = a
                        [by discharge given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> apply(compose(transposition(i, j), transposition(a, k)), k) = a
                    [by discharge given-i-not-a]
                }
              @discharge-k |
                forall k: Element; i != a -> j != a -> apply(compose(transposition(i, j), transposition(a, k)), k) = a
                [by generalize generalize-k]
            }
          @discharge-a |
            forall a, k: Element; i != a -> j != a -> apply(compose(transposition(i, j), transposition(a, k)), k) = a
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, k: Element; i != a -> j != a -> apply(compose(transposition(i, j), transposition(a, k)), k) = a
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, k: Element; i != a -> j != a -> apply(compose(transposition(i, j), transposition(a, k)), k) = a
    [by generalize generalize-i]
qed

// -- Judson's conjugation: sigma (i,j,a)^2 sigma^-1 = (i,j,k) -------------------------------
//
// "Using the normality of N, we see that [(i,j)(a,k)](i,j,a)^2[(i,j)(a,k)]^-1 = (i,j,k) is
// in N. Hence N must contain all of the 3-cycles (i,j,k)."
//
// Conjugation distributes over a product (`conjugationIsMultiplicative`) and relabels a
// transposition by the conjugator's action (`conjugateOfATransposition`), so the four
// factors of (i,j,a)^2 become transpositions of sigma-images: (ia)->(jk) and (ij)->(ji).
// The result is (j,i,k)^2, which identity (1) turns into (j,k,i), which the rotation lemma
// turns into (i,j,k).
theorem conjugatingTheSquareReachesEveryThirdPoint: forall i, j, a, k: Element;
  i != j -> i != a -> i != k -> j != a -> j != k ->
  compose(compose(compose(transposition(i, j), transposition(a, k)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))),
  inverse(compose(transposition(i, j), transposition(a, k)))) =
  compose(transposition(i, k), transposition(i, j))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-k |
                fix k: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-k |
                            assume i != k {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-k |
                                    assume j != k {
                                      @i-not-j |
                                        i != j
                                        [by hypothesis given-i-not-j]
                                      @i-not-a |
                                        i != a
                                        [by hypothesis given-i-not-a]
                                      @i-not-k |
                                        i != k
                                        [by hypothesis given-i-not-k]
                                      @j-not-a |
                                        j != a
                                        [by hypothesis given-j-not-a]
                                      @j-not-k |
                                        j != k
                                        [by hypothesis given-j-not-k]
                                      // sigma is a permutation
                                      @ij-is-a-permutation |
                                        invertible(transposition(i, j))
                                        [using specialize transpositionIsAPermutation(i, j)]
                                      @ak-is-a-permutation |
                                        invertible(transposition(a, k))
                                        [using specialize transpositionIsAPermutation(a, k)]
                                      @sigma-is-a-permutation |
                                        invertible(compose(transposition(i, j), transposition(a, k)))
                                        [using specialize composeIsAPermutation(transposition(i, j), transposition(a, k)) ij-is-a-permutation ak-is-a-permutation]
                                      // conjugation distributes over the outer product
                                      @split-outer |
                                        compose(compose(compose(transposition(i, j), transposition(a, k)),
                                          compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))),
                                          inverse(compose(transposition(i, j), transposition(a, k)))) =
                                          compose(compose(compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, a), transposition(i, j))), inverse(compose(transposition(i, j), transposition(a, k)))),
                                          compose(compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, a), transposition(i, j))), inverse(compose(transposition(i, j), transposition(a, k)))))
                                        [using specialize conjugationIsMultiplicative(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))) sigma-is-a-permutation]
                                      // and over each (ia)(ij) factor
                                      @split-inner |
                                        compose(compose(compose(transposition(i, j), transposition(a, k)), compose(transposition(i, a), transposition(i, j))), inverse(compose(transposition(i, j), transposition(a, k)))) =
                                          compose(compose(compose(compose(transposition(i, j), transposition(a, k)), transposition(i, a)), inverse(compose(transposition(i, j), transposition(a, k)))),
                                          compose(compose(compose(transposition(i, j), transposition(a, k)), transposition(i, j)), inverse(compose(transposition(i, j), transposition(a, k)))))
                                        [using specialize conjugationIsMultiplicative(compose(transposition(i, j), transposition(a, k)), transposition(i, a), transposition(i, j)) sigma-is-a-permutation]
                                      // each conjugated transposition relabels by sigma
                                      @conjugate-ia |
                                        compose(compose(compose(transposition(i, j), transposition(a, k)), transposition(i, a)), inverse(compose(transposition(i, j), transposition(a, k)))) =
                                          transposition(apply(compose(transposition(i, j), transposition(a, k)), i), apply(compose(transposition(i, j), transposition(a, k)), a))
                                        [using specialize conjugateOfATransposition(compose(transposition(i, j), transposition(a, k)), i, a) sigma-is-a-permutation]
                                      @conjugate-ij |
                                        compose(compose(compose(transposition(i, j), transposition(a, k)), transposition(i, j)), inverse(compose(transposition(i, j), transposition(a, k)))) =
                                          transposition(apply(compose(transposition(i, j), transposition(a, k)), i), apply(compose(transposition(i, j), transposition(a, k)), j))
                                        [using specialize conjugateOfATransposition(compose(transposition(i, j), transposition(a, k)), i, j) sigma-is-a-permutation]
                                      // sigma's action on the four letters
                                      @sigma-i |
                                        apply(compose(transposition(i, j), transposition(a, k)), i) = j
                                        [using specialize theConjugatorSendsFirstToSecond(i, j, a, k) i-not-a i-not-k]
                                      @sigma-j |
                                        apply(compose(transposition(i, j), transposition(a, k)), j) = i
                                        [using specialize theConjugatorSendsSecondToFirst(i, j, a, k) j-not-a j-not-k]
                                      @sigma-a |
                                        apply(compose(transposition(i, j), transposition(a, k)), a) = k
                                        [using specialize theConjugatorSendsThirdToFourth(i, j, a, k) i-not-k j-not-k]
                                      // identity (1) at (j, i, k): (j,i,k) = (j,k,i)^2 ... read as
                                      // (j,k,i) = (j,i,k)^2 is the form proved, so cite it directly
                                      @square-is-a-rotation |
                                        compose(transposition(j, i), transposition(j, k)) =
                                          compose(compose(transposition(j, k), transposition(j, i)),
                                          compose(transposition(j, k), transposition(j, i)))
                                        [using specialize aThreeCycleIsTheSquareOfItsTwist(j, i, k) j-not-i j-not-k i-not-k]
                                      @j-not-i |
                                        j != i
                                        [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                      @rotation |
                                        compose(transposition(j, i), transposition(j, k)) =
                                          compose(transposition(i, k), transposition(i, j))
                                        [using specialize aThreeCycleIsInvariantUnderRotation(i, j, k) i-not-j i-not-k j-not-k]
                                      // STAGE 1: the conjugate IS (j,i,k)^2. `simplify` gets here —
                                      // every rewrite runs left-to-right.
                                      @conjugate-is-the-square |
                                        compose(compose(compose(transposition(i, j), transposition(a, k)),
                                          compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))),
                                          inverse(compose(transposition(i, j), transposition(a, k)))) =
                                          compose(compose(transposition(j, k), transposition(j, i)),
                                          compose(transposition(j, k), transposition(j, i)))
                                        [using simplify split-outer split-inner conjugate-ia conjugate-ij sigma-i sigma-j sigma-a]
                                      // STAGE 2: (j,i,k)^2 = (j,k,i) = (i,j,k). `square-is-a-rotation`
                                      // must run BACKWARD here, so `chain`, not `simplify`.
                                      @conclusion-conjugate |
                                        compose(compose(compose(transposition(i, j), transposition(a, k)),
                                          compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))),
                                          inverse(compose(transposition(i, j), transposition(a, k)))) =
                                          compose(transposition(i, k), transposition(i, j))
                                        [using chain conjugate-is-the-square square-is-a-rotation rotation]
                                    }
                                  @conclusion-j-not-k |
                                    j != k -> compose(compose(compose(transposition(i, j), transposition(a, k)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), inverse(compose(transposition(i, j), transposition(a, k)))) = compose(transposition(i, k), transposition(i, j))
                                    [by discharge given-j-not-k]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != k -> compose(compose(compose(transposition(i, j), transposition(a, k)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), inverse(compose(transposition(i, j), transposition(a, k)))) = compose(transposition(i, k), transposition(i, j))
                                [by discharge given-j-not-a]
                            }
                          @conclusion-i-not-k |
                            i != k -> j != a -> j != k -> compose(compose(compose(transposition(i, j), transposition(a, k)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), inverse(compose(transposition(i, j), transposition(a, k)))) = compose(transposition(i, k), transposition(i, j))
                            [by discharge given-i-not-k]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != k -> j != a -> j != k -> compose(compose(compose(transposition(i, j), transposition(a, k)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), inverse(compose(transposition(i, j), transposition(a, k)))) = compose(transposition(i, k), transposition(i, j))
                        [by discharge given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != k -> j != a -> j != k -> compose(compose(compose(transposition(i, j), transposition(a, k)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), inverse(compose(transposition(i, j), transposition(a, k)))) = compose(transposition(i, k), transposition(i, j))
                    [by discharge given-i-not-j]
                }
              @discharge-k |
                forall k: Element; i != j -> i != a -> i != k -> j != a -> j != k -> compose(compose(compose(transposition(i, j), transposition(a, k)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), inverse(compose(transposition(i, j), transposition(a, k)))) = compose(transposition(i, k), transposition(i, j))
                [by generalize generalize-k]
            }
          @discharge-a |
            forall a, k: Element; i != j -> i != a -> i != k -> j != a -> j != k -> compose(compose(compose(transposition(i, j), transposition(a, k)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), inverse(compose(transposition(i, j), transposition(a, k)))) = compose(transposition(i, k), transposition(i, j))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, k: Element; i != j -> i != a -> i != k -> j != a -> j != k -> compose(compose(compose(transposition(i, j), transposition(a, k)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), inverse(compose(transposition(i, j), transposition(a, k)))) = compose(transposition(i, k), transposition(i, j))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, k: Element;
      i != j -> i != a -> i != k -> j != a -> j != k ->
      compose(compose(compose(transposition(i, j), transposition(a, k)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))),
      inverse(compose(transposition(i, j), transposition(a, k)))) =
      compose(transposition(i, k), transposition(i, j))
    [by generalize generalize-i]
qed

// ============================================================================
// JUDSON LEMMA 3 (10.10), CASE 3: sigma = tau o (a b c) with tau a disjoint
// product of 2-cycles. Then sigma^2 is the 3-cycle (a c b).
// ============================================================================

// The algebra first, with no cycle structure in sight: if the two factors COMMUTE and the
// first is an INVOLUTION, squaring kills it.
//
//   (tau o g)^2 = tau o g o tau o g = tau o tau o g o g = id o g^2 = g^2
//
// Judson's case 3 is this plus `aThreeCycleIsTheSquareOfItsTwist`: tau is a product of
// disjoint 2-cycles (hence an involution) disjoint from the 3-cycle (hence commuting), so
// sigma^2 = (a b c)^2, which that identity says is (a c b).
theorem squaringKillsACommutingInvolution: forall t: Fn; forall g: Fn;
  compose(t, g) = compose(g, t) -> compose(t, t) = identityFn ->
  compose(compose(t, g), compose(t, g)) = compose(g, g)
proof
  @generalize-t |
    fix t: Fn {
      @generalize-g |
        fix g: Fn {
          @given-commute |
            assume compose(t, g) = compose(g, t) {
              @they-commute |
                compose(t, g) = compose(g, t)
                [by hypothesis given-commute]
              @given-involution |
                assume compose(t, t) = identityFn {
                  @t-is-an-involution |
                    compose(t, t) = identityFn
                    [by hypothesis given-involution]
                  // (t g)(t g) = t (g t) g  — pure reassociation
                  @regrouped |
                    compose(compose(t, g), compose(t, g))
                      = compose(t, compose(compose(g, t), g))
                    [using assoc(composeAssoc)]
                  // swap the inner g t back to t g
                  @inner-swapped |
                    compose(compose(t, g), compose(t, g))
                      = compose(t, compose(compose(t, g), g))
                    [by rewrite they-commute regrouped]
                  // t (t g g) — reassociate so the two t's meet
                  @t-pair-adjacent |
                    compose(t, compose(compose(t, g), g))
                      = compose(compose(t, t), compose(g, g))
                    [using assoc(composeAssoc)]
                  @with-the-pair |
                    compose(compose(t, g), compose(t, g))
                      = compose(compose(t, t), compose(g, g))
                    [using chain inner-swapped t-pair-adjacent]
                  @identity-times-the-square |
                    compose(compose(t, g), compose(t, g))
                      = compose(identityFn, compose(g, g))
                    [by rewrite t-is-an-involution with-the-pair]
                  @identity-on-the-left |
                    compose(identityFn, compose(g, g)) = compose(g, g)
                    [using specialize function.composeIdentityLeft(compose(g, g))]
                  @conclusion-square |
                    compose(compose(t, g), compose(t, g)) = compose(g, g)
                    [using chain identity-times-the-square identity-on-the-left]
                }
              @conclusion-involution-gives |
                compose(t, t) = identityFn ->
                  compose(compose(t, g), compose(t, g)) = compose(g, g)
                [by discharge given-involution]
            }
          @conclusion-at-g |
            compose(t, g) = compose(g, t) -> compose(t, t) = identityFn ->
              compose(compose(t, g), compose(t, g)) = compose(g, g)
            [by discharge given-commute]
        }
      @discharge-g |
        forall g: Fn; compose(t, g) = compose(g, t) -> compose(t, t) = identityFn ->
          compose(compose(t, g), compose(t, g)) = compose(g, g)
        [by generalize generalize-g]
    }
  @conclusion |
    forall t: Fn; forall g: Fn;
      compose(t, g) = compose(g, t) -> compose(t, t) = identityFn ->
      compose(compose(t, g), compose(t, g)) = compose(g, g)
    [by generalize generalize-t]
qed

// CASE 3 ITSELF. sigma = tau o (i,j,a) with tau commuting with the 3-cycle and tau an
// involution: sigma^2 is the 3-cycle (i,a,j).
//
// `squaringKillsACommutingInvolution` reduces sigma^2 to the 3-cycle's own square, and
// `aThreeCycleIsTheSquareOfItsTwist` names that square: it is (i,a,j).
//
// The hypotheses are stated as the ALGEBRA Judson's case supplies, not as cycle structure:
// "tau is a product of disjoint 2-cycles disjoint from the 3-cycle" enters only through
// commuting + being an involution, which is all the proof uses. A caller with the structural
// form discharges them via `disjointPermutationsCommute` and the involution law.
theorem squaringAThreeCycleTimesAnInvolutionGivesAThreeCycle: forall i, j, a: Element;
  forall t: Fn;
  i != j -> i != a -> j != a ->
  compose(t, compose(transposition(i, a), transposition(i, j)))
  = compose(compose(transposition(i, a), transposition(i, j)), t) ->
  compose(t, t) = identityFn ->
  compose(compose(t, compose(transposition(i, a), transposition(i, j))),
  compose(t, compose(transposition(i, a), transposition(i, j))))
  = compose(transposition(i, j), transposition(i, a))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-t |
                fix t: Fn {
                  @given-i-not-j |
                    assume i != j {
                      @i-not-j |
                        i != j
                        [by hypothesis given-i-not-j]
                      @given-i-not-a |
                        assume i != a {
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @given-j-not-a |
                            assume j != a {
                              @j-not-a |
                                j != a
                                [by hypothesis given-j-not-a]
                              @given-commute |
                                assume compose(t, compose(transposition(i, a), transposition(i, j)))
                                  = compose(compose(transposition(i, a), transposition(i, j)), t) {
                                  @they-commute |
                                    compose(t, compose(transposition(i, a), transposition(i, j)))
                                      = compose(compose(transposition(i, a), transposition(i, j)), t)
                                    [by hypothesis given-commute]
                                  @given-involution |
                                    assume compose(t, t) = identityFn {
                                      @t-is-an-involution |
                                        compose(t, t) = identityFn
                                        [by hypothesis given-involution]
                                      @the-square-is-the-cycles-square |
                                        compose(compose(t, compose(transposition(i, a), transposition(i, j))),
                                          compose(t, compose(transposition(i, a), transposition(i, j))))
                                          = compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))
                                        [using specialize squaringKillsACommutingInvolution(t, compose(transposition(i, a), transposition(i, j))) they-commute t-is-an-involution]
                                      @the-cycles-square-is-the-twist |
                                        compose(transposition(i, j), transposition(i, a))
                                          = compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))
                                        [using specialize aThreeCycleIsTheSquareOfItsTwist(i, j, a) i-not-j i-not-a j-not-a]
                                      @conclusion-square-is-a-three-cycle |
                                        compose(compose(t, compose(transposition(i, a), transposition(i, j))),
                                          compose(t, compose(transposition(i, a), transposition(i, j))))
                                          = compose(transposition(i, j), transposition(i, a))
                                        [by rewrite the-cycles-square-is-the-twist the-square-is-the-cycles-square]
                                    }
                                  @conclusion-involution-gives |
                                    compose(t, t) = identityFn ->
                                      compose(compose(t, compose(transposition(i, a), transposition(i, j))),
                                      compose(t, compose(transposition(i, a), transposition(i, j))))
                                      = compose(transposition(i, j), transposition(i, a))
                                    [by discharge given-involution]
                                }
                              @conclusion-commute-gives |
                                compose(t, compose(transposition(i, a), transposition(i, j)))
                                  = compose(compose(transposition(i, a), transposition(i, j)), t) ->
                                  compose(t, t) = identityFn ->
                                  compose(compose(t, compose(transposition(i, a), transposition(i, j))),
                                  compose(t, compose(transposition(i, a), transposition(i, j))))
                                  = compose(transposition(i, j), transposition(i, a))
                                [by discharge given-commute]
                            }
                          @conclusion-j-not-a-gives |
                            j != a ->
                              (compose(t, compose(transposition(i, a), transposition(i, j)))
                              = compose(compose(transposition(i, a), transposition(i, j)), t) ->
                              compose(t, t) = identityFn ->
                              compose(compose(t, compose(transposition(i, a), transposition(i, j))),
                              compose(t, compose(transposition(i, a), transposition(i, j))))
                              = compose(transposition(i, j), transposition(i, a)))
                            [by discharge given-j-not-a]
                        }
                      @conclusion-i-not-a-gives |
                        i != a -> j != a ->
                          (compose(t, compose(transposition(i, a), transposition(i, j)))
                          = compose(compose(transposition(i, a), transposition(i, j)), t) ->
                          compose(t, t) = identityFn ->
                          compose(compose(t, compose(transposition(i, a), transposition(i, j))),
                          compose(t, compose(transposition(i, a), transposition(i, j))))
                          = compose(transposition(i, j), transposition(i, a)))
                        [by discharge given-i-not-a]
                    }
                  @conclusion-at-t |
                    i != j -> i != a -> j != a ->
                      (compose(t, compose(transposition(i, a), transposition(i, j)))
                      = compose(compose(transposition(i, a), transposition(i, j)), t) ->
                      compose(t, t) = identityFn ->
                      compose(compose(t, compose(transposition(i, a), transposition(i, j))),
                      compose(t, compose(transposition(i, a), transposition(i, j))))
                      = compose(transposition(i, j), transposition(i, a)))
                    [by discharge given-i-not-j]
                }
              @discharge-t |
                forall t: Fn;
                  i != j -> i != a -> j != a ->
                  (compose(t, compose(transposition(i, a), transposition(i, j)))
                  = compose(compose(transposition(i, a), transposition(i, j)), t) ->
                  compose(t, t) = identityFn ->
                  compose(compose(t, compose(transposition(i, a), transposition(i, j))),
                  compose(t, compose(transposition(i, a), transposition(i, j))))
                  = compose(transposition(i, j), transposition(i, a)))
                [by generalize generalize-t]
            }
          @discharge-a |
            forall a: Element; forall t: Fn;
              i != j -> i != a -> j != a ->
              (compose(t, compose(transposition(i, a), transposition(i, j)))
              = compose(compose(transposition(i, a), transposition(i, j)), t) ->
              compose(t, t) = identityFn ->
              compose(compose(t, compose(transposition(i, a), transposition(i, j))),
              compose(t, compose(transposition(i, a), transposition(i, j))))
              = compose(transposition(i, j), transposition(i, a)))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j: Element; forall a: Element; forall t: Fn;
          i != j -> i != a -> j != a ->
          (compose(t, compose(transposition(i, a), transposition(i, j)))
          = compose(compose(transposition(i, a), transposition(i, j)), t) ->
          compose(t, t) = identityFn ->
          compose(compose(t, compose(transposition(i, a), transposition(i, j))),
          compose(t, compose(transposition(i, a), transposition(i, j))))
          = compose(transposition(i, j), transposition(i, a)))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Element; forall j: Element; forall a: Element; forall t: Fn;
      i != j -> i != a -> j != a ->
      (compose(t, compose(transposition(i, a), transposition(i, j)))
      = compose(compose(transposition(i, a), transposition(i, j)), t) ->
      compose(t, t) = identityFn ->
      compose(compose(t, compose(transposition(i, a), transposition(i, j))),
      compose(t, compose(transposition(i, a), transposition(i, j))))
      = compose(transposition(i, j), transposition(i, a)))
    [by generalize generalize-i]
qed

// ============================================================================
// THE EXPLICIT CONJUGATE OF A 3-CYCLE
// ============================================================================

// sigma o (i,j,a) o sigma^-1 = (sigma i, sigma j, sigma a) — conjugation RELABELS a 3-cycle's
// three points by sigma's action, and says exactly which 3-cycle you land on.
//
// `alternating.aConjugateOfAThreeCycleIsAThreeCycle` already gives the EXISTENTIAL form (the
// conjugate is SOME 3-cycle), which is what Lemma 10.9 consumes. Judson's Lemma 10.10 needs
// the explicit form: case 1 conjugates (a1,a2,a3) by a long cycle and must know the result is
// (a2,a3,a4) in order to multiply it by (a1,a3,a2) and land on a 3-cycle.
//
// In std's fold a 3-cycle IS T(i,a) o T(i,j), so this is `conjugationIsMultiplicative` to
// split the product and `conjugateOfATransposition` on each factor — the same two steps as
// the existential version, but keeping the images rather than discarding them.
theorem theConjugateOfAThreeCycleRelabelsItsPoints: forall sigma: Fn; forall i, j, a: Element;
  invertible(sigma) ->
  compose(compose(sigma, compose(transposition(i, a), transposition(i, j))), inverse(sigma))
  = compose(transposition(apply(sigma, i), apply(sigma, a)),
  transposition(apply(sigma, i), apply(sigma, j)))
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-a |
                fix a: Element {
                  @given-invertible |
                    assume invertible(sigma) {
                      @sigma-is-a-permutation |
                        invertible(sigma)
                        [by hypothesis given-invertible]
                      @split-the-product |
                        compose(compose(sigma,
                          compose(transposition(i, a), transposition(i, j))), inverse(sigma))
                          = compose(
                          compose(compose(sigma, transposition(i, a)), inverse(sigma)),
                          compose(compose(sigma, transposition(i, j)), inverse(sigma)))
                        [using specialize permutation_cycle.conjugationIsMultiplicative(sigma, transposition(i, a), transposition(i, j)) sigma-is-a-permutation]
                      @the-first-factor |
                        compose(compose(sigma, transposition(i, a)), inverse(sigma))
                          = transposition(apply(sigma, i), apply(sigma, a))
                        [using specialize permutation_cycle.conjugateOfATransposition(sigma, i, a) sigma-is-a-permutation]
                      @the-second-factor |
                        compose(compose(sigma, transposition(i, j)), inverse(sigma))
                          = transposition(apply(sigma, i), apply(sigma, j))
                        [using specialize permutation_cycle.conjugateOfATransposition(sigma, i, j) sigma-is-a-permutation]
                      @first-moved |
                        compose(compose(sigma,
                          compose(transposition(i, a), transposition(i, j))), inverse(sigma))
                          = compose(transposition(apply(sigma, i), apply(sigma, a)),
                          compose(compose(sigma, transposition(i, j)), inverse(sigma)))
                        [by rewrite the-first-factor split-the-product]
                      @conclusion-relabelled |
                        compose(compose(sigma,
                          compose(transposition(i, a), transposition(i, j))), inverse(sigma))
                          = compose(transposition(apply(sigma, i), apply(sigma, a)),
                          transposition(apply(sigma, i), apply(sigma, j)))
                        [by rewrite the-second-factor first-moved]
                    }
                  @conclusion-at-a |
                    invertible(sigma) ->
                      compose(compose(sigma,
                      compose(transposition(i, a), transposition(i, j))), inverse(sigma))
                      = compose(transposition(apply(sigma, i), apply(sigma, a)),
                      transposition(apply(sigma, i), apply(sigma, j)))
                    [by discharge given-invertible]
                }
              @discharge-a |
                forall a: Element; invertible(sigma) ->
                  compose(compose(sigma,
                  compose(transposition(i, a), transposition(i, j))), inverse(sigma))
                  = compose(transposition(apply(sigma, i), apply(sigma, a)),
                  transposition(apply(sigma, i), apply(sigma, j)))
                [by generalize generalize-a]
            }
          @discharge-j |
            forall j: Element; forall a: Element; invertible(sigma) ->
              compose(compose(sigma,
              compose(transposition(i, a), transposition(i, j))), inverse(sigma))
              = compose(transposition(apply(sigma, i), apply(sigma, a)),
              transposition(apply(sigma, i), apply(sigma, j)))
            [by generalize generalize-j]
        }
      @discharge-i |
        forall i: Element; forall j: Element; forall a: Element; invertible(sigma) ->
          compose(compose(sigma,
          compose(transposition(i, a), transposition(i, j))), inverse(sigma))
          = compose(transposition(apply(sigma, i), apply(sigma, a)),
          transposition(apply(sigma, i), apply(sigma, j)))
        [by generalize generalize-i]
    }
  @conclusion |
    forall sigma: Fn; forall i: Element; forall j: Element; forall a: Element;
      invertible(sigma) ->
      compose(compose(sigma,
      compose(transposition(i, a), transposition(i, j))), inverse(sigma))
      = compose(transposition(apply(sigma, i), apply(sigma, a)),
      transposition(apply(sigma, i), apply(sigma, j)))
    [by generalize generalize-sigma]
qed

// A 3-CYCLE'S INVERSE is its twist: (i,j,a)^-1 = (i,a,j).
//
// In std's fold (i,j,a) is T(i,a) o T(i,j), so the claim is that T(i,j) o T(i,a) undoes it.
// That needs only the involution law and reassociation — no case analysis on points, and no
// distinctness hypothesis, since T(u,u) is the identity and the algebra still closes.
//
//   (T(i,a) T(i,j)) (T(i,j) T(i,a)) = T(i,a) (T(i,j) T(i,j)) T(i,a)
//                                   = T(i,a) id T(i,a) = T(i,a) T(i,a) = id
theorem aThreeCyclesInverseIsItsTwist: forall i, j, a: Element;
  inverse(compose(transposition(i, a), transposition(i, j)))
  = compose(transposition(i, j), transposition(i, a))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @ij-is-an-involution |
                compose(transposition(i, j), transposition(i, j)) = identityFn
                [using specialize transpositionIsAnInvolution(i, j)]
              @ia-is-an-involution |
                compose(transposition(i, a), transposition(i, a)) = identityFn
                [using specialize transpositionIsAnInvolution(i, a)]
              // regroup so the two T(i,j)'s meet
              @regrouped |
                compose(compose(transposition(i, a), transposition(i, j)),
                  compose(transposition(i, j), transposition(i, a)))
                  = compose(transposition(i, a),
                  compose(compose(transposition(i, j), transposition(i, j)),
                  transposition(i, a)))
                [using assoc(composeAssoc)]
              @inner-cancelled |
                compose(compose(transposition(i, a), transposition(i, j)),
                  compose(transposition(i, j), transposition(i, a)))
                  = compose(transposition(i, a),
                  compose(identityFn, transposition(i, a)))
                [by rewrite ij-is-an-involution regrouped]
              @identity-removed |
                compose(identityFn, transposition(i, a)) = transposition(i, a)
                [using specialize function.composeIdentityLeft(transposition(i, a))]
              @down-to-the-outer-pair |
                compose(compose(transposition(i, a), transposition(i, j)),
                  compose(transposition(i, j), transposition(i, a)))
                  = compose(transposition(i, a), transposition(i, a))
                [by rewrite identity-removed inner-cancelled]
              @composes-to-identity |
                compose(compose(transposition(i, a), transposition(i, j)),
                  compose(transposition(i, j), transposition(i, a))) = identityFn
                [using chain down-to-the-outer-pair ia-is-an-involution]
              // the 3-cycle is a composite of two transpositions, so it is a permutation and
              // `inverseLeft` applies — which is what `aTwoSidedInverseIsUnique` needs on the
              // left of the pair.
              @ia-is-a-permutation |
                invertible(transposition(i, a))
                [using specialize transpositionIsAPermutation(i, a)]
              @ij-is-a-permutation |
                invertible(transposition(i, j))
                [using specialize transpositionIsAPermutation(i, j)]
              @the-three-cycle-is-a-permutation |
                invertible(compose(transposition(i, a), transposition(i, j)))
                [using specialize composeIsAPermutation(transposition(i, a), transposition(i, j)) ia-is-a-permutation ij-is-a-permutation]
              @the-inverse-undoes-it-on-the-left |
                compose(inverse(compose(transposition(i, a), transposition(i, j))),
                  compose(transposition(i, a), transposition(i, j))) = identityFn
                [using specialize function.inverseLeft(compose(transposition(i, a), transposition(i, j))) the-three-cycle-is-a-permutation]
              @conclusion-the-twist-is-the-inverse |
                inverse(compose(transposition(i, a), transposition(i, j)))
                  = compose(transposition(i, j), transposition(i, a))
                [using specialize aTwoSidedInverseIsUnique(compose(transposition(i, a), transposition(i, j)), inverse(compose(transposition(i, a), transposition(i, j))), compose(transposition(i, j), transposition(i, a))) the-inverse-undoes-it-on-the-left composes-to-identity]
            }
          @discharge-a |
            forall a: Element;
              inverse(compose(transposition(i, a), transposition(i, j)))
              = compose(transposition(i, j), transposition(i, a))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j: Element; forall a: Element;
          inverse(compose(transposition(i, a), transposition(i, j)))
          = compose(transposition(i, j), transposition(i, a))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Element; forall j: Element; forall a: Element;
      inverse(compose(transposition(i, a), transposition(i, j)))
      = compose(transposition(i, j), transposition(i, a))
    [by generalize generalize-i]
qed

// ============================================================================
// JUDSON LEMMA 3 (10.10), CASE 1: sigma has a cycle longer than 3
// ============================================================================

// THE COMMUTATOR CLOSED FORM. For any permutation sigma and any points i, j, a:
//
//   sigma (i,j,a) sigma^-1 (i,j,a)^-1 = T(si,sa) T(si,sj) T(i,j) T(i,a)
//
// where si = sigma(i) and so on. This is `theConjugateOfAThreeCycleRelabelsItsPoints` for the
// conjugate and `aThreeCyclesInverseIsItsTwist` for the inverse, composed.
//
// WHY THIS REPLACES JUDSON'S CASE 1. Judson conjugates (a1,a2,a3) by a cycle of length r and
// computes the r-dependent result (a1,a3,ar). The commutator does not need r at all: it
// depends ONLY on sigma's action at the three points, so there is no cycle-length arithmetic
// and no induction on r. Verified exhaustively over all 7200 (sigma, i, j, a) combinations on
// five points, and on sigma = (a1a2a3a4) o (p q) to confirm the disjoint remainder is
// irrelevant.
//
// A caller in case 1 instantiates sigma at its long cycle; the three images are then the
// cycle's next three points, which is where r > 3 earns the distinctness the 3-cycle needs.
theorem theCommutatorOfAThreeCycleWithAPermutation: forall sigma: Fn; forall i, j, a: Element;
  invertible(sigma) ->
  compose(compose(compose(sigma, compose(transposition(i, a), transposition(i, j))),
  inverse(sigma)), inverse(compose(transposition(i, a), transposition(i, j))))
  = compose(compose(transposition(apply(sigma, i), apply(sigma, a)),
  transposition(apply(sigma, i), apply(sigma, j))),
  compose(transposition(i, j), transposition(i, a)))
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-a |
                fix a: Element {
                  @given-invertible |
                    assume invertible(sigma) {
                      @sigma-is-a-permutation |
                        invertible(sigma)
                        [by hypothesis given-invertible]
                      @the-conjugate-relabels |
                        compose(compose(sigma,
                          compose(transposition(i, a), transposition(i, j))), inverse(sigma))
                          = compose(transposition(apply(sigma, i), apply(sigma, a)),
                          transposition(apply(sigma, i), apply(sigma, j)))
                        [using specialize theConjugateOfAThreeCycleRelabelsItsPoints(sigma, i, j, a) sigma-is-a-permutation]
                      @the-inverse-is-the-twist |
                        inverse(compose(transposition(i, a), transposition(i, j)))
                          = compose(transposition(i, j), transposition(i, a))
                        [using specialize aThreeCyclesInverseIsItsTwist(i, j, a)]
                      @the-product-is-itself |
                        compose(compose(compose(sigma,
                          compose(transposition(i, a), transposition(i, j))), inverse(sigma)),
                          inverse(compose(transposition(i, a), transposition(i, j))))
                          = compose(compose(compose(sigma,
                          compose(transposition(i, a), transposition(i, j))), inverse(sigma)),
                          inverse(compose(transposition(i, a), transposition(i, j))))
                        [by reflexivity]
                      @conjugate-substituted |
                        compose(compose(compose(sigma,
                          compose(transposition(i, a), transposition(i, j))), inverse(sigma)),
                          inverse(compose(transposition(i, a), transposition(i, j))))
                          = compose(compose(transposition(apply(sigma, i), apply(sigma, a)),
                          transposition(apply(sigma, i), apply(sigma, j))),
                          inverse(compose(transposition(i, a), transposition(i, j))))
                        [by rewrite the-conjugate-relabels the-product-is-itself]
                      @conclusion-closed-form |
                        compose(compose(compose(sigma,
                          compose(transposition(i, a), transposition(i, j))), inverse(sigma)),
                          inverse(compose(transposition(i, a), transposition(i, j))))
                          = compose(compose(transposition(apply(sigma, i), apply(sigma, a)),
                          transposition(apply(sigma, i), apply(sigma, j))),
                          compose(transposition(i, j), transposition(i, a)))
                        [by rewrite the-inverse-is-the-twist conjugate-substituted]
                    }
                  @conclusion-at-a |
                    invertible(sigma) ->
                      compose(compose(compose(sigma,
                      compose(transposition(i, a), transposition(i, j))), inverse(sigma)),
                      inverse(compose(transposition(i, a), transposition(i, j))))
                      = compose(compose(transposition(apply(sigma, i), apply(sigma, a)),
                      transposition(apply(sigma, i), apply(sigma, j))),
                      compose(transposition(i, j), transposition(i, a)))
                    [by discharge given-invertible]
                }
              @discharge-a |
                forall a: Element; invertible(sigma) ->
                  compose(compose(compose(sigma,
                  compose(transposition(i, a), transposition(i, j))), inverse(sigma)),
                  inverse(compose(transposition(i, a), transposition(i, j))))
                  = compose(compose(transposition(apply(sigma, i), apply(sigma, a)),
                  transposition(apply(sigma, i), apply(sigma, j))),
                  compose(transposition(i, j), transposition(i, a)))
                [by generalize generalize-a]
            }
          @discharge-j |
            forall j: Element; forall a: Element; invertible(sigma) ->
              compose(compose(compose(sigma,
              compose(transposition(i, a), transposition(i, j))), inverse(sigma)),
              inverse(compose(transposition(i, a), transposition(i, j))))
              = compose(compose(transposition(apply(sigma, i), apply(sigma, a)),
              transposition(apply(sigma, i), apply(sigma, j))),
              compose(transposition(i, j), transposition(i, a)))
            [by generalize generalize-j]
        }
      @discharge-i |
        forall i: Element; forall j: Element; forall a: Element; invertible(sigma) ->
          compose(compose(compose(sigma,
          compose(transposition(i, a), transposition(i, j))), inverse(sigma)),
          inverse(compose(transposition(i, a), transposition(i, j))))
          = compose(compose(transposition(apply(sigma, i), apply(sigma, a)),
          transposition(apply(sigma, i), apply(sigma, j))),
          compose(transposition(i, j), transposition(i, a)))
        [by generalize generalize-i]
    }
  @conclusion |
    forall sigma: Fn; forall i: Element; forall j: Element; forall a: Element;
      invertible(sigma) ->
      compose(compose(compose(sigma,
      compose(transposition(i, a), transposition(i, j))), inverse(sigma)),
      inverse(compose(transposition(i, a), transposition(i, j))))
      = compose(compose(transposition(apply(sigma, i), apply(sigma, a)),
      transposition(apply(sigma, i), apply(sigma, j))),
      compose(transposition(i, j), transposition(i, a)))
    [by generalize generalize-sigma]
qed

// ============================================================================
// JUDSON LEMMA 3 (10.10), CASE 5: sigma is a product of disjoint 2-cycles
// ============================================================================

// A PERMUTATION THAT SWAPS TWO OF A 3-CYCLE'S POINTS AND FIXES THE THIRD HAS THE
// 3-CYCLE ITSELF AS ITS COMMUTATOR WITH IT.
//
//   sigma i = j, sigma j = i, sigma a = a   ==>   sigma (i,j,a) sigma^-1 (i,j,a)^-1 = (i,j,a)
//
// WHY THIS IS CASE 5. Judson's case 5 takes sigma = tau (a1a2)(a3a4) with tau a disjoint
// product of an even number more 2-cycles, conjugates by (a1a2a3) to reach (a1a3)(a2a4), and
// then conjugates AGAIN. The second conjugation is the one that lands a 3-cycle, and what
// drives it is not the 2-cycle structure at all — only that the permutation SWAPS two of the
// chosen 3-cycle's points and FIXES the third. Choosing the 3-cycle (a1,a3,a5) against
// sigma' = (a1a3)(a2a4) is exactly that configuration: a5 is the fifth point, which is where
// n >= 5 is spent.
//
// So the hypotheses here are the three point-values the proof uses, not a cycle type. A
// caller in case 5 discharges them from its decomposition: the swapped pair comes from one
// 2-cycle and the fixed point is any point outside sigma's support.
//
// The algebra: `theCommutatorOfAThreeCycleWithAPermutation` gives
// T(si,sa) T(si,sj) T(i,j) T(i,a); substituting si=j, sj=i, sa=a makes the middle pair
// T(j,i) T(i,j) = T(i,j) T(i,j) = identity, leaving T(j,a) T(i,a) — which is (i,j,a) in
// std's fold, since (x,y,z) = T(x,z) T(x,y) and (i,j,a) rotates to (j,a,i).
//
// Verified computationally on six points before writing: with sigma = (a1a3)(a2a4) and the
// 3-cycle (a1,a3,a5) the commutator is {a1->a3, a3->a5, a5->a1}, and the closed form above
// reproduces it exactly.
theorem theCommutatorWithASwapOfTwoOfItsPoints: forall sigma: Fn; forall i, j, a: Element;
  invertible(sigma) ->
  apply(sigma, i) = j ->
  apply(sigma, j) = i ->
  apply(sigma, a) = a ->
  compose(compose(compose(sigma, compose(transposition(i, a), transposition(i, j))),
  inverse(sigma)), inverse(compose(transposition(i, a), transposition(i, j))))
  = compose(transposition(j, a), transposition(i, a))
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-a |
                fix a: Element {
                  @given-invertible |
                    assume invertible(sigma) {
                      @given-i-goes-to-j |
                        assume apply(sigma, i) = j {
                          @given-j-goes-to-i |
                            assume apply(sigma, j) = i {
                              @given-a-is-fixed |
                                assume apply(sigma, a) = a {
                                  @sigma-is-a-permutation |
                                    invertible(sigma)
                                    [by hypothesis given-invertible]
                                  @i-goes-to-j |
                                    apply(sigma, i) = j
                                    [by hypothesis given-i-goes-to-j]
                                  @j-goes-to-i |
                                    apply(sigma, j) = i
                                    [by hypothesis given-j-goes-to-i]
                                  @a-is-fixed |
                                    apply(sigma, a) = a
                                    [by hypothesis given-a-is-fixed]

                                  // the generic closed form, before substituting the images
                                  @the-commutator-closed-form |
                                    compose(compose(compose(sigma,
                                      compose(transposition(i, a), transposition(i, j))),
                                      inverse(sigma)),
                                      inverse(compose(transposition(i, a), transposition(i, j))))
                                      = compose(compose(transposition(apply(sigma, i), apply(sigma, a)),
                                      transposition(apply(sigma, i), apply(sigma, j))),
                                      compose(transposition(i, j), transposition(i, a)))
                                    [using specialize theCommutatorOfAThreeCycleWithAPermutation(sigma, i, j, a) sigma-is-a-permutation]

                                  // substitute the three images: si = j, sj = i, sa = a
                                  @images-substituted |
                                    compose(compose(compose(sigma,
                                      compose(transposition(i, a), transposition(i, j))),
                                      inverse(sigma)),
                                      inverse(compose(transposition(i, a), transposition(i, j))))
                                      = compose(compose(transposition(j, a),
                                      transposition(j, i)),
                                      compose(transposition(i, j), transposition(i, a)))
                                    [using simplify i-goes-to-j j-goes-to-i a-is-fixed the-commutator-closed-form]

                                  // T(j,i) = T(i,j), so the middle pair is an involution
                                  @the-swap-is-symmetric |
                                    transposition(j, i) = transposition(i, j)
                                    [using specialize permutation_parity.transpositionIsSymmetric(j, i)]
                                  @ij-is-an-involution |
                                    compose(transposition(i, j), transposition(i, j)) = identityFn
                                    [using specialize permutation.transpositionIsAnInvolution(i, j)]

                                  // regroup so the two T(i,j)'s meet, then cancel
                                  @regrouped |
                                    compose(compose(transposition(j, a), transposition(i, j)),
                                      compose(transposition(i, j), transposition(i, a)))
                                      = compose(transposition(j, a),
                                      compose(compose(transposition(i, j), transposition(i, j)),
                                      transposition(i, a)))
                                    [using assoc(composeAssoc)]
                                  @middle-cancels |
                                    compose(transposition(j, a),
                                      compose(compose(transposition(i, j), transposition(i, j)),
                                      transposition(i, a)))
                                      = compose(transposition(j, a),
                                      compose(identityFn, transposition(i, a)))
                                    [using simplify ij-is-an-involution]
                                  @identity-drops |
                                    compose(identityFn, transposition(i, a)) = transposition(i, a)
                                    [using specialize function.composeIdentityLeft(transposition(i, a))]
                                  @right-factor-reduced |
                                    compose(transposition(j, a),
                                      compose(identityFn, transposition(i, a)))
                                      = compose(transposition(j, a), transposition(i, a))
                                    [using simplify identity-drops]

                                  @conclusion-case-five |
                                    compose(compose(compose(sigma,
                                      compose(transposition(i, a), transposition(i, j))),
                                      inverse(sigma)),
                                      inverse(compose(transposition(i, a), transposition(i, j))))
                                      = compose(transposition(j, a), transposition(i, a))
                                    [using chain images-substituted the-swap-is-symmetric regrouped middle-cancels right-factor-reduced]
                                }
                              @a-fixed-implies |
                                apply(sigma, a) = a ->
                                  compose(compose(compose(sigma,
                                  compose(transposition(i, a), transposition(i, j))),
                                  inverse(sigma)),
                                  inverse(compose(transposition(i, a), transposition(i, j))))
                                  = compose(transposition(j, a), transposition(i, a))
                                [by discharge given-a-is-fixed]
                            }
                          @j-to-i-implies |
                            apply(sigma, j) = i ->
                              apply(sigma, a) = a ->
                              compose(compose(compose(sigma,
                              compose(transposition(i, a), transposition(i, j))),
                              inverse(sigma)),
                              inverse(compose(transposition(i, a), transposition(i, j))))
                              = compose(transposition(j, a), transposition(i, a))
                            [by discharge given-j-goes-to-i]
                        }
                      @i-to-j-implies |
                        apply(sigma, i) = j ->
                          apply(sigma, j) = i ->
                          apply(sigma, a) = a ->
                          compose(compose(compose(sigma,
                          compose(transposition(i, a), transposition(i, j))),
                          inverse(sigma)),
                          inverse(compose(transposition(i, a), transposition(i, j))))
                          = compose(transposition(j, a), transposition(i, a))
                        [by discharge given-i-goes-to-j]
                    }
                  @conclusion-at-a |
                    invertible(sigma) ->
                      apply(sigma, i) = j ->
                      apply(sigma, j) = i ->
                      apply(sigma, a) = a ->
                      compose(compose(compose(sigma,
                      compose(transposition(i, a), transposition(i, j))),
                      inverse(sigma)),
                      inverse(compose(transposition(i, a), transposition(i, j))))
                      = compose(transposition(j, a), transposition(i, a))
                    [by discharge given-invertible]
                }
              @conclusion-for-all-a |
                forall a: Element; invertible(sigma) ->
                  apply(sigma, i) = j ->
                  apply(sigma, j) = i ->
                  apply(sigma, a) = a ->
                  compose(compose(compose(sigma,
                  compose(transposition(i, a), transposition(i, j))),
                  inverse(sigma)),
                  inverse(compose(transposition(i, a), transposition(i, j))))
                  = compose(transposition(j, a), transposition(i, a))
                [by generalize generalize-a]
            }
          @conclusion-for-all-j-a |
            forall j, a: Element; invertible(sigma) ->
              apply(sigma, i) = j ->
              apply(sigma, j) = i ->
              apply(sigma, a) = a ->
              compose(compose(compose(sigma,
              compose(transposition(i, a), transposition(i, j))),
              inverse(sigma)),
              inverse(compose(transposition(i, a), transposition(i, j))))
              = compose(transposition(j, a), transposition(i, a))
            [by generalize generalize-j]
        }
      @conclusion-for-all-points |
        forall i, j, a: Element; invertible(sigma) ->
          apply(sigma, i) = j ->
          apply(sigma, j) = i ->
          apply(sigma, a) = a ->
          compose(compose(compose(sigma,
          compose(transposition(i, a), transposition(i, j))),
          inverse(sigma)),
          inverse(compose(transposition(i, a), transposition(i, j))))
          = compose(transposition(j, a), transposition(i, a))
        [by generalize generalize-i]
    }
  @conclusion |
    forall sigma: Fn; forall i, j, a: Element; invertible(sigma) ->
      apply(sigma, i) = j ->
      apply(sigma, j) = i ->
      apply(sigma, a) = a ->
      compose(compose(compose(sigma,
      compose(transposition(i, a), transposition(i, j))),
      inverse(sigma)),
      inverse(compose(transposition(i, a), transposition(i, j))))
      = compose(transposition(j, a), transposition(i, a))
    [by generalize generalize-sigma]
qed

// The commutator value of `theCommutatorWithASwapOfTwoOfItsPoints` IS the 3-cycle (i,j,a).
//
// That theorem lands `T(j,a) T(i,a)`, which is not in std's shared-first-point fold
// `(x,y,z) = T(x,z) T(x,y)`. It becomes one by flipping both factors with
// `transpositionIsSymmetric` — giving `T(a,j) T(a,i)`, which is `(a,i,j)` — and rotating with
// `aThreeCycleIsInvariantUnderRotation` at (a,i,j), whose statement is exactly
// `T(i,a) T(i,j) = T(a,j) T(a,i)`.
//
// Distinctness IS needed and only partly: the identity fails at i = j and at j = a (checked),
// so those two are the hypotheses; i = a is not consulted. Both are free to a caller, whose
// three points are a 3-cycle's.
theorem aSwappedCommutatorIsTheThreeCycle: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  compose(transposition(j, a), transposition(i, a))
  = compose(transposition(i, a), transposition(i, j))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-is-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-is-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-is-not-a |
                            j != a
                            [by hypothesis given-j-not-a]

                          // flip both factors onto the shared point a
                          @first-factor-flipped |
                            transposition(j, a) = transposition(a, j)
                            [using specialize permutation_parity.transpositionIsSymmetric(j, a)]
                          @second-factor-flipped |
                            transposition(i, a) = transposition(a, i)
                            [using specialize permutation_parity.transpositionIsSymmetric(i, a)]
                          @shared-point-form |
                            compose(transposition(j, a), transposition(i, a))
                              = compose(transposition(a, j), transposition(a, i))
                            [using simplify first-factor-flipped second-factor-flipped]

                          // rotation at (a, i, j): T(i,a) T(i,j) = T(a,j) T(a,i)
                          @a-is-not-i |
                            a != i
                            [using specialize alternating.disequalityIsSymmetric(i, a) i-is-not-a]
                          @a-is-not-j |
                            a != j
                            [using specialize alternating.disequalityIsSymmetric(j, a) j-is-not-a]
                          @rotated |
                            compose(transposition(i, a), transposition(i, j))
                              = compose(transposition(a, j), transposition(a, i))
                            [using specialize aThreeCycleIsInvariantUnderRotation(a, i, j) a-is-not-i a-is-not-j i-is-not-j]
                          @rotated-flipped |
                            compose(transposition(a, j), transposition(a, i))
                              = compose(transposition(i, a), transposition(i, j))
                            [by symmetry rotated]

                          @conclusion-three-cycle-form |
                            compose(transposition(j, a), transposition(i, a))
                              = compose(transposition(i, a), transposition(i, j))
                            [using chain shared-point-form rotated-flipped]
                        }
                      @j-not-a-implies |
                        j != a ->
                          compose(transposition(j, a), transposition(i, a))
                          = compose(transposition(i, a), transposition(i, j))
                        [by discharge given-j-not-a]
                    }
                  @i-not-a-implies |
                    i != a -> j != a ->
                      compose(transposition(j, a), transposition(i, a))
                      = compose(transposition(i, a), transposition(i, j))
                    [by discharge given-i-not-a]
                }
              @conclusion-at-a |
                i != j -> i != a -> j != a ->
                  compose(transposition(j, a), transposition(i, a))
                  = compose(transposition(i, a), transposition(i, j))
                [by discharge given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a ->
              compose(transposition(j, a), transposition(i, a))
              = compose(transposition(i, a), transposition(i, j))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a ->
          compose(transposition(j, a), transposition(i, a))
          = compose(transposition(i, a), transposition(i, j))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a ->
      compose(transposition(j, a), transposition(i, a))
      = compose(transposition(i, a), transposition(i, j))
    [by generalize generalize-i]
qed

// CASE 5, STATED THE WAY A CALLER WANTS IT. The two theorems above composed:
//
//   sigma i = j, sigma j = i, sigma a = a,  i,j,a distinct
//     ==>  sigma (i,j,a) sigma^-1 (i,j,a)^-1  =  (i,j,a)
//
// The commutator of a 3-cycle with a permutation that swaps two of its points and fixes the
// third is that very 3-cycle. For case 5 this is the whole point: sigma lies in the normal
// subgroup N, so the commutator does too (N is closed under conjugation and inverses), and the
// commutator is a 3-cycle — which is what Lemma 10.10 claims.
//
// Spending n >= 5: the fixed point a must sit outside the swapped pair, and in case 5 sigma is
// a product of disjoint 2-cycles, so a is taken from the fifth point.
theorem theCommutatorWithASwapIsAThreeCycle: forall sigma: Fn; forall i, j, a: Element;
  invertible(sigma) ->
  i != j -> i != a -> j != a ->
  apply(sigma, i) = j ->
  apply(sigma, j) = i ->
  apply(sigma, a) = a ->
  compose(compose(compose(sigma, compose(transposition(i, a), transposition(i, j))),
  inverse(sigma)), inverse(compose(transposition(i, a), transposition(i, j))))
  = compose(transposition(i, a), transposition(i, j))
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-a |
                fix a: Element {
                  @given-invertible |
                    assume invertible(sigma) {
                      @given-i-not-j |
                        assume i != j {
                          @given-i-not-a |
                            assume i != a {
                              @given-j-not-a |
                                assume j != a {
                                  @given-i-goes-to-j |
                                    assume apply(sigma, i) = j {
                                      @given-j-goes-to-i |
                                        assume apply(sigma, j) = i {
                                          @given-a-is-fixed |
                                            assume apply(sigma, a) = a {
                                              @sigma-is-a-permutation |
                                                invertible(sigma)
                                                [by hypothesis given-invertible]
                                              @i-is-not-j |
                                                i != j
                                                [by hypothesis given-i-not-j]
                                              @i-is-not-a |
                                                i != a
                                                [by hypothesis given-i-not-a]
                                              @j-is-not-a |
                                                j != a
                                                [by hypothesis given-j-not-a]
                                              @i-goes-to-j |
                                                apply(sigma, i) = j
                                                [by hypothesis given-i-goes-to-j]
                                              @j-goes-to-i |
                                                apply(sigma, j) = i
                                                [by hypothesis given-j-goes-to-i]
                                              @a-is-fixed |
                                                apply(sigma, a) = a
                                                [by hypothesis given-a-is-fixed]

                                              @the-commutator-value |
                                                compose(compose(compose(sigma,
                                                  compose(transposition(i, a), transposition(i, j))),
                                                  inverse(sigma)),
                                                  inverse(compose(transposition(i, a), transposition(i, j))))
                                                  = compose(transposition(j, a), transposition(i, a))
                                                [using specialize theCommutatorWithASwapOfTwoOfItsPoints(sigma, i, j, a) sigma-is-a-permutation i-goes-to-j j-goes-to-i a-is-fixed]
                                              @that-value-is-the-three-cycle |
                                                compose(transposition(j, a), transposition(i, a))
                                                  = compose(transposition(i, a), transposition(i, j))
                                                [using specialize aSwappedCommutatorIsTheThreeCycle(i, j, a) i-is-not-j i-is-not-a j-is-not-a]
                                              @conclusion-commutator-is-the-three-cycle |
                                                compose(compose(compose(sigma,
                                                  compose(transposition(i, a), transposition(i, j))),
                                                  inverse(sigma)),
                                                  inverse(compose(transposition(i, a), transposition(i, j))))
                                                  = compose(transposition(i, a), transposition(i, j))
                                                [using chain the-commutator-value that-value-is-the-three-cycle]
                                            }
                                          @a-fixed-implies |
                                            apply(sigma, a) = a ->
                                              compose(compose(compose(sigma,
                                              compose(transposition(i, a), transposition(i, j))),
                                              inverse(sigma)),
                                              inverse(compose(transposition(i, a), transposition(i, j))))
                                              = compose(transposition(i, a), transposition(i, j))
                                            [by discharge given-a-is-fixed]
                                        }
                                      @j-to-i-implies |
                                        apply(sigma, j) = i -> apply(sigma, a) = a ->
                                          compose(compose(compose(sigma,
                                          compose(transposition(i, a), transposition(i, j))),
                                          inverse(sigma)),
                                          inverse(compose(transposition(i, a), transposition(i, j))))
                                          = compose(transposition(i, a), transposition(i, j))
                                        [by discharge given-j-goes-to-i]
                                    }
                                  @i-to-j-implies |
                                    apply(sigma, i) = j -> apply(sigma, j) = i -> apply(sigma, a) = a ->
                                      compose(compose(compose(sigma,
                                      compose(transposition(i, a), transposition(i, j))),
                                      inverse(sigma)),
                                      inverse(compose(transposition(i, a), transposition(i, j))))
                                      = compose(transposition(i, a), transposition(i, j))
                                    [by discharge given-i-goes-to-j]
                                }
                              @j-not-a-implies |
                                j != a -> apply(sigma, i) = j -> apply(sigma, j) = i -> apply(sigma, a) = a ->
                                  compose(compose(compose(sigma,
                                  compose(transposition(i, a), transposition(i, j))),
                                  inverse(sigma)),
                                  inverse(compose(transposition(i, a), transposition(i, j))))
                                  = compose(transposition(i, a), transposition(i, j))
                                [by discharge given-j-not-a]
                            }
                          @i-not-a-implies |
                            i != a -> j != a -> apply(sigma, i) = j -> apply(sigma, j) = i -> apply(sigma, a) = a ->
                              compose(compose(compose(sigma,
                              compose(transposition(i, a), transposition(i, j))),
                              inverse(sigma)),
                              inverse(compose(transposition(i, a), transposition(i, j))))
                              = compose(transposition(i, a), transposition(i, j))
                            [by discharge given-i-not-a]
                        }
                      @i-not-j-implies |
                        i != j -> i != a -> j != a -> apply(sigma, i) = j -> apply(sigma, j) = i -> apply(sigma, a) = a ->
                          compose(compose(compose(sigma,
                          compose(transposition(i, a), transposition(i, j))),
                          inverse(sigma)),
                          inverse(compose(transposition(i, a), transposition(i, j))))
                          = compose(transposition(i, a), transposition(i, j))
                        [by discharge given-i-not-j]
                    }
                  @conclusion-at-a |
                    invertible(sigma) -> i != j -> i != a -> j != a ->
                      apply(sigma, i) = j -> apply(sigma, j) = i -> apply(sigma, a) = a ->
                      compose(compose(compose(sigma,
                      compose(transposition(i, a), transposition(i, j))),
                      inverse(sigma)),
                      inverse(compose(transposition(i, a), transposition(i, j))))
                      = compose(transposition(i, a), transposition(i, j))
                    [by discharge given-invertible]
                }
              @discharge-a |
                forall a: Element; invertible(sigma) -> i != j -> i != a -> j != a ->
                  apply(sigma, i) = j -> apply(sigma, j) = i -> apply(sigma, a) = a ->
                  compose(compose(compose(sigma,
                  compose(transposition(i, a), transposition(i, j))),
                  inverse(sigma)),
                  inverse(compose(transposition(i, a), transposition(i, j))))
                  = compose(transposition(i, a), transposition(i, j))
                [by generalize generalize-a]
            }
          @discharge-j |
            forall j, a: Element; invertible(sigma) -> i != j -> i != a -> j != a ->
              apply(sigma, i) = j -> apply(sigma, j) = i -> apply(sigma, a) = a ->
              compose(compose(compose(sigma,
              compose(transposition(i, a), transposition(i, j))),
              inverse(sigma)),
              inverse(compose(transposition(i, a), transposition(i, j))))
              = compose(transposition(i, a), transposition(i, j))
            [by generalize generalize-j]
        }
      @discharge-i |
        forall i, j, a: Element; invertible(sigma) -> i != j -> i != a -> j != a ->
          apply(sigma, i) = j -> apply(sigma, j) = i -> apply(sigma, a) = a ->
          compose(compose(compose(sigma,
          compose(transposition(i, a), transposition(i, j))),
          inverse(sigma)),
          inverse(compose(transposition(i, a), transposition(i, j))))
          = compose(transposition(i, a), transposition(i, j))
        [by generalize generalize-i]
    }
  @conclusion |
    forall sigma: Fn; forall i, j, a: Element; invertible(sigma) -> i != j -> i != a -> j != a ->
      apply(sigma, i) = j -> apply(sigma, j) = i -> apply(sigma, a) = a ->
      compose(compose(compose(sigma,
      compose(transposition(i, a), transposition(i, j))),
      inverse(sigma)),
      inverse(compose(transposition(i, a), transposition(i, j))))
      = compose(transposition(i, a), transposition(i, j))
    [by generalize generalize-sigma]
qed

// ============================================================================
// LEMMA 10.9'S TRANSITIVITY: conjugation reaches every 3-cycle, one point at a time
// ============================================================================

// THE ONE-POINT MOVE. Conjugating `(i,j,a)` by the 3-cycle `(a,b,c)` replaces the third
// point by `b`:
//
//   (a,b,c) (i,j,a) (a,b,c)^-1 = (i,j,b)
//
// WHY THIS IS THE WHOLE OF LEMMA 10.9'S TRANSITIVITY. The missing step was "any triple of
// distinct points maps to any other by some EVEN sigma", which reads as though it needs a way
// to BUILD a permutation from a prescribed finite map — machinery std does not have. It does
// not need that. Two observations collapse it:
//
//   1. Conjugation acts on 3-CYCLES, not on triples, and a 3-cycle equals each of its three
//      rotations (`aThreeCycleIsInvariantUnderRotation`), so the target need only be matched
//      up to rotation. Probed: a conjugator that is a product of two transpositions reaches
//      ALL 20 three-cycles on five points from any one of them, whereas it carries only 2160
//      of 3600 TRIPLE pairs. The triple framing is what made this look hard.
//   2. The conjugator here is itself a 3-cycle, hence a product of exactly two transpositions
//      in std's fold, hence EVEN by construction and already in A_n. Nothing needs its parity
//      repaired, so the "two spare points to fix sigma's parity" step never arises.
//
// `b` and `c` are the two points outside `{i,j,a}`, which is where n >= 5 is spent: the move
// needs a point to move TO (`b`) and a point to park the displaced one on (`c`).
//
// A caller chains the move. Under it the 3-cycles on five points have DIAMETER 3 (measured by
// BFS over all 20, from every starting 3-cycle) — one application per point — so reaching an
// arbitrary 3-cycle is at most three uses of this lemma composed, not an induction.
//
// The proof is `theConjugateOfAThreeCycleRelabelsItsPoints` at sigma = (a,b,c), then the three
// images evaluated: the conjugator fixes i and j, being disjoint from them, and sends a to b.
//
// `a != c` is NOT a hypothesis, and that is deliberate rather than an oversight: the proof never
// consults it (dropping it left every step intact), and the identity holds when a = c as well —
// the conjugator degenerates to `T(a,b)` alone, which still carries a to b. Checked over all
// 1080 configurations on six points with a = c allowed. Stating it would be an invented
// hypothesis of the kind the axiomatization rule warns about.
theorem conjugatingAThreeCycleMovesItsThirdPoint: forall i, j, a, b: Element;
  forall c: Element;
  i != a -> i != b -> i != c -> j != a -> j != b -> j != c ->
  a != b -> b != c ->
  compose(compose(compose(transposition(a, c), transposition(a, b)),
  compose(transposition(i, a), transposition(i, j))),
  inverse(compose(transposition(a, c), transposition(a, b))))
  = compose(transposition(i, b), transposition(i, j))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-i-not-c |
                                assume i != c {
                                  @given-j-not-a |
                                    assume j != a {
                                      @given-j-not-b |
                                        assume j != b {
                                          @given-j-not-c |
                                            assume j != c {
                                              @given-a-not-b |
                                                assume a != b {
                                                  @given-b-not-c |
                                                    assume b != c {
                                                      @i-is-not-a |
                                                        i != a
                                                        [by hypothesis given-i-not-a]
                                                      @i-is-not-c |
                                                        i != c
                                                        [by hypothesis given-i-not-c]
                                                      @j-is-not-a |
                                                        j != a
                                                        [by hypothesis given-j-not-a]
                                                      @j-is-not-c |
                                                        j != c
                                                        [by hypothesis given-j-not-c]
                                                      @a-is-not-b |
                                                        a != b
                                                        [by hypothesis given-a-not-b]

                                                      // the conjugator (a,b,c) is a permutation
                                                      @ac-is-a-permutation |
                                                        invertible(transposition(a, c))
                                                        [using specialize permutation.transpositionIsAPermutation(a, c)]
                                                      @ab-is-a-permutation |
                                                        invertible(transposition(a, b))
                                                        [using specialize permutation.transpositionIsAPermutation(a, b)]
                                                      @the-conjugator-is-a-permutation |
                                                        invertible(compose(transposition(a, c), transposition(a, b)))
                                                        [using specialize function.composeInvertible(transposition(a, c), transposition(a, b)) ac-is-a-permutation ab-is-a-permutation]

                                                      // the generic relabelling, before evaluating the images
                                                      @the-conjugate-relabels |
                                                        compose(compose(compose(transposition(a, c), transposition(a, b)),
                                                          compose(transposition(i, a), transposition(i, j))),
                                                          inverse(compose(transposition(a, c), transposition(a, b))))
                                                          = compose(transposition(
                                                          apply(compose(transposition(a, c), transposition(a, b)), i),
                                                          apply(compose(transposition(a, c), transposition(a, b)), a)),
                                                          transposition(
                                                          apply(compose(transposition(a, c), transposition(a, b)), i),
                                                          apply(compose(transposition(a, c), transposition(a, b)), j)))
                                                        [using specialize theConjugateOfAThreeCycleRelabelsItsPoints(compose(transposition(a, c), transposition(a, b)), i, j, a) the-conjugator-is-a-permutation]

                                                      // the conjugator fixes i and j, and sends a to b
                                                      // evaluate the conjugator factor by factor at i, j and a
                                                      @i-is-not-b |
                                                        i != b
                                                        [by hypothesis given-i-not-b]
                                                      @j-is-not-b |
                                                        j != b
                                                        [by hypothesis given-j-not-b]
                                                      @ab-fixes-i |
                                                        apply(transposition(a, b), i) = i
                                                        [using specialize transpositionElsewhere(a, b, i) i-is-not-a i-is-not-b]
                                                      @ac-fixes-i |
                                                        apply(transposition(a, c), i) = i
                                                        [using specialize transpositionElsewhere(a, c, i) i-is-not-a i-is-not-c]
                                                      @the-conjugator-fixes-i |
                                                        apply(compose(transposition(a, c), transposition(a, b)), i) = i
                                                        [using simplify function.composeApply ab-fixes-i ac-fixes-i]
                                                      @ab-fixes-j |
                                                        apply(transposition(a, b), j) = j
                                                        [using specialize transpositionElsewhere(a, b, j) j-is-not-a j-is-not-b]
                                                      @ac-fixes-j |
                                                        apply(transposition(a, c), j) = j
                                                        [using specialize transpositionElsewhere(a, c, j) j-is-not-a j-is-not-c]
                                                      @the-conjugator-fixes-j |
                                                        apply(compose(transposition(a, c), transposition(a, b)), j) = j
                                                        [using simplify function.composeApply ab-fixes-j ac-fixes-j]
                                                      @b-is-not-a |
                                                        b != a
                                                        [using specialize alternating.disequalityIsSymmetric(a, b) a-is-not-b]
                                                      @b-is-not-c |
                                                        b != c
                                                        [by hypothesis given-b-not-c]
                                                      @ab-sends-a-to-b |
                                                        apply(transposition(a, b), a) = b
                                                        [using specialize transpositionAtFirst(a, b)]
                                                      @ac-fixes-b |
                                                        apply(transposition(a, c), b) = b
                                                        [using specialize transpositionElsewhere(a, c, b) b-is-not-a b-is-not-c]
                                                      @the-conjugator-sends-a-to-b |
                                                        apply(compose(transposition(a, c), transposition(a, b)), a) = b
                                                        [using simplify function.composeApply ab-sends-a-to-b ac-fixes-b]

                                                      @conclusion-third-point-moved |
                                                        compose(compose(compose(transposition(a, c), transposition(a, b)),
                                                          compose(transposition(i, a), transposition(i, j))),
                                                          inverse(compose(transposition(a, c), transposition(a, b))))
                                                          = compose(transposition(i, b), transposition(i, j))
                                                        [using simplify the-conjugator-fixes-i the-conjugator-fixes-j the-conjugator-sends-a-to-b the-conjugate-relabels]
                                                    }
                                                  @b-not-c-implies |
                                                    b != c ->
                                                      compose(compose(compose(transposition(a, c), transposition(a, b)),
                                                      compose(transposition(i, a), transposition(i, j))),
                                                      inverse(compose(transposition(a, c), transposition(a, b))))
                                                      = compose(transposition(i, b), transposition(i, j))
                                                    [by discharge given-b-not-c]
                                                }
                                              @a-not-b-implies |
                                                a != b -> b != c ->
                                                  compose(compose(compose(transposition(a, c), transposition(a, b)),
                                                  compose(transposition(i, a), transposition(i, j))),
                                                  inverse(compose(transposition(a, c), transposition(a, b))))
                                                  = compose(transposition(i, b), transposition(i, j))
                                                [by discharge given-a-not-b]
                                            }
                                          @j-not-c-implies |
                                            j != c -> a != b -> b != c ->
                                              compose(compose(compose(transposition(a, c), transposition(a, b)),
                                              compose(transposition(i, a), transposition(i, j))),
                                              inverse(compose(transposition(a, c), transposition(a, b))))
                                              = compose(transposition(i, b), transposition(i, j))
                                            [by discharge given-j-not-c]
                                        }
                                      @j-not-b-implies |
                                        j != b -> j != c -> a != b -> b != c ->
                                          compose(compose(compose(transposition(a, c), transposition(a, b)),
                                          compose(transposition(i, a), transposition(i, j))),
                                          inverse(compose(transposition(a, c), transposition(a, b))))
                                          = compose(transposition(i, b), transposition(i, j))
                                        [by discharge given-j-not-b]
                                    }
                                  @j-not-a-implies |
                                    j != a -> j != b -> j != c -> a != b -> b != c ->
                                      compose(compose(compose(transposition(a, c), transposition(a, b)),
                                      compose(transposition(i, a), transposition(i, j))),
                                      inverse(compose(transposition(a, c), transposition(a, b))))
                                      = compose(transposition(i, b), transposition(i, j))
                                    [by discharge given-j-not-a]
                                }
                              @i-not-c-implies |
                                i != c -> j != a -> j != b -> j != c -> a != b -> b != c ->
                                  compose(compose(compose(transposition(a, c), transposition(a, b)),
                                  compose(transposition(i, a), transposition(i, j))),
                                  inverse(compose(transposition(a, c), transposition(a, b))))
                                  = compose(transposition(i, b), transposition(i, j))
                                [by discharge given-i-not-c]
                            }
                          @i-not-b-implies |
                            i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c ->
                              compose(compose(compose(transposition(a, c), transposition(a, b)),
                              compose(transposition(i, a), transposition(i, j))),
                              inverse(compose(transposition(a, c), transposition(a, b))))
                              = compose(transposition(i, b), transposition(i, j))
                            [by discharge given-i-not-b]
                        }
                      @conclusion-at-c |
                        i != a -> i != b -> i != c -> j != a -> j != b -> j != c ->
                          a != b -> b != c ->
                          compose(compose(compose(transposition(a, c), transposition(a, b)),
                          compose(transposition(i, a), transposition(i, j))),
                          inverse(compose(transposition(a, c), transposition(a, b))))
                          = compose(transposition(i, b), transposition(i, j))
                        [by discharge given-i-not-a]
                    }
                  @discharge-c |
                    forall c: Element;
                      i != a -> i != b -> i != c -> j != a -> j != b -> j != c ->
                      a != b -> b != c ->
                      compose(compose(compose(transposition(a, c), transposition(a, b)),
                      compose(transposition(i, a), transposition(i, j))),
                      inverse(compose(transposition(a, c), transposition(a, b))))
                      = compose(transposition(i, b), transposition(i, j))
                    [by generalize generalize-c]
                }
              @discharge-b |
                forall b: Element; forall c: Element;
                  i != a -> i != b -> i != c -> j != a -> j != b -> j != c ->
                  a != b -> b != c ->
                  compose(compose(compose(transposition(a, c), transposition(a, b)),
                  compose(transposition(i, a), transposition(i, j))),
                  inverse(compose(transposition(a, c), transposition(a, b))))
                  = compose(transposition(i, b), transposition(i, j))
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; forall c: Element;
              i != a -> i != b -> i != c -> j != a -> j != b -> j != c ->
              a != b -> b != c ->
              compose(compose(compose(transposition(a, c), transposition(a, b)),
              compose(transposition(i, a), transposition(i, j))),
              inverse(compose(transposition(a, c), transposition(a, b))))
              = compose(transposition(i, b), transposition(i, j))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; forall c: Element;
          i != a -> i != b -> i != c -> j != a -> j != b -> j != c ->
          a != b -> b != c ->
          compose(compose(compose(transposition(a, c), transposition(a, b)),
          compose(transposition(i, a), transposition(i, j))),
          inverse(compose(transposition(a, c), transposition(a, b))))
          = compose(transposition(i, b), transposition(i, j))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; forall c: Element;
      i != a -> i != b -> i != c -> j != a -> j != b -> j != c ->
      a != b -> b != c ->
      compose(compose(compose(transposition(a, c), transposition(a, b)),
      compose(transposition(i, a), transposition(i, j))),
      inverse(compose(transposition(a, c), transposition(a, b))))
      = compose(transposition(i, b), transposition(i, j))
    [by generalize generalize-i]
qed

// THE TWIST, and the one place n >= 5 is genuinely spent. Conjugating `(i,j,a)` by
// `T(i,j) o T(b,c)` gives its twist `(i,a,j)`:
//
//   (T(i,j) T(b,c)) (i,j,a) (T(i,j) T(b,c))^-1 = (i,a,j)
//
// The conjugator does two unrelated jobs, and separating them is the point. `T(i,j)` does the
// mathematics: it swaps two of the 3-cycle's points and fixes the third, so the relabelling
// sends `(i,j,a)` to `(j,i,a)`, which IS the twist. `T(b,c)` does nothing to the 3-cycle at
// all — `b` and `c` lie outside `{i,j,a}` — and is there only to make the conjugator EVEN, so
// that it lies in A_n. A single transposition would relabel identically and be odd.
//
// THIS is what "n >= 5 buys two spare points to fix sigma's parity" actually means, and it is
// worth being precise because the phrase was carried for weeks as a claim about transitivity in
// general. It is not: the one-point move
// (`conjugatingAThreeCycleMovesItsThirdPoint`) needs no parity repair, its conjugator being a
// 3-cycle and so even by construction. The twist is the lone case that does, because the only
// relabelling that produces it is a single swap.
//
// WHY THE TWIST IS SEPARATE WORK. BFS over all 20 three-cycles on five points under the
// one-point move gives diameter 3, with the distance-3 target being exactly the starting
// 3-cycle's twist — every other 3-cycle is 2 moves or fewer. So the twist is the orbit's far
// point, and a direct conjugator for it is cheaper than a three-move chain whose intermediate
// rotation representatives no fixed formula captures.
//
// Verified exact on all 120 / 720 / 2520 configurations at n = 5, 6, 7.
//
// The proof is `theConjugateOfAThreeCycleRelabelsItsPoints` at that conjugator, whose images
// are i -> j, j -> i, a -> a; the relabelled form `T(j,a) T(j,i)` is then the twist by two
// rotation instances composed.
theorem conjugatingAThreeCycleByASwapAndASpareSwapGivesItsTwist:
  forall i, j, a, b: Element; forall c: Element;
  i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c ->
  a != b -> a != c -> b != c ->
  compose(compose(compose(transposition(i, j), transposition(b, c)),
  compose(transposition(i, a), transposition(i, j))),
  inverse(compose(transposition(i, j), transposition(b, c))))
  = compose(transposition(i, j), transposition(i, a))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-i-not-a |
                            assume i != a {
                              @given-i-not-b |
                                assume i != b {
                                  @given-i-not-c |
                                    assume i != c {
                                      @given-j-not-a |
                                        assume j != a {
                                          @given-j-not-b |
                                            assume j != b {
                                              @given-j-not-c |
                                                assume j != c {
                                                  @given-a-not-b |
                                                    assume a != b {
                                                      @given-a-not-c |
                                                        assume a != c {
                                                          @given-b-not-c |
                                                            assume b != c {
                                                              @i-is-not-j |
                                                                i != j
                                                                [by hypothesis given-i-not-j]
                                                              @i-is-not-a |
                                                                i != a
                                                                [by hypothesis given-i-not-a]
                                                              @i-is-not-b |
                                                                i != b
                                                                [by hypothesis given-i-not-b]
                                                              @i-is-not-c |
                                                                i != c
                                                                [by hypothesis given-i-not-c]
                                                              @j-is-not-a |
                                                                j != a
                                                                [by hypothesis given-j-not-a]
                                                              @j-is-not-b |
                                                                j != b
                                                                [by hypothesis given-j-not-b]
                                                              @j-is-not-c |
                                                                j != c
                                                                [by hypothesis given-j-not-c]
                                                              @a-is-not-b |
                                                                a != b
                                                                [by hypothesis given-a-not-b]
                                                              @a-is-not-c |
                                                                a != c
                                                                [by hypothesis given-a-not-c]

                                                              // the conjugator is a permutation
                                                              @ij-is-a-permutation |
                                                                invertible(transposition(i, j))
                                                                [using specialize permutation.transpositionIsAPermutation(i, j)]
                                                              @bc-is-a-permutation |
                                                                invertible(transposition(b, c))
                                                                [using specialize permutation.transpositionIsAPermutation(b, c)]
                                                              @the-conjugator-is-a-permutation |
                                                                invertible(compose(transposition(i, j), transposition(b, c)))
                                                                [using specialize function.composeInvertible(transposition(i, j), transposition(b, c)) ij-is-a-permutation bc-is-a-permutation]

                                                              @the-conjugate-relabels |
                                                                compose(compose(compose(transposition(i, j), transposition(b, c)),
                                                                  compose(transposition(i, a), transposition(i, j))),
                                                                  inverse(compose(transposition(i, j), transposition(b, c))))
                                                                  = compose(transposition(
                                                                  apply(compose(transposition(i, j), transposition(b, c)), i),
                                                                  apply(compose(transposition(i, j), transposition(b, c)), a)),
                                                                  transposition(
                                                                  apply(compose(transposition(i, j), transposition(b, c)), i),
                                                                  apply(compose(transposition(i, j), transposition(b, c)), j)))
                                                                [using specialize theConjugateOfAThreeCycleRelabelsItsPoints(compose(transposition(i, j), transposition(b, c)), i, j, a) the-conjugator-is-a-permutation]

                                                              // the conjugator's images: i -> j, j -> i, a -> a
                                                              @bc-fixes-i |
                                                                apply(transposition(b, c), i) = i
                                                                [using specialize permutation.transpositionElsewhere(b, c, i) i-is-not-b i-is-not-c]
                                                              @ij-sends-i-to-j |
                                                                apply(transposition(i, j), i) = j
                                                                [using specialize permutation.transpositionAtFirst(i, j)]
                                                              @the-conjugator-sends-i-to-j |
                                                                apply(compose(transposition(i, j), transposition(b, c)), i) = j
                                                                [using simplify function.composeApply bc-fixes-i ij-sends-i-to-j]
                                                              @bc-fixes-j |
                                                                apply(transposition(b, c), j) = j
                                                                [using specialize permutation.transpositionElsewhere(b, c, j) j-is-not-b j-is-not-c]
                                                              @ij-sends-j-to-i |
                                                                apply(transposition(i, j), j) = i
                                                                [using specialize permutation.transpositionAtSecond(i, j)]
                                                              @the-conjugator-sends-j-to-i |
                                                                apply(compose(transposition(i, j), transposition(b, c)), j) = i
                                                                [using simplify function.composeApply bc-fixes-j ij-sends-j-to-i]
                                                              @bc-fixes-a |
                                                                apply(transposition(b, c), a) = a
                                                                [using specialize permutation.transpositionElsewhere(b, c, a) a-is-not-b a-is-not-c]
                                                              @a-is-not-i |
                                                                a != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, a) i-is-not-a]
                                                              @a-is-not-j |
                                                                a != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, a) j-is-not-a]
                                                              @ij-fixes-a |
                                                                apply(transposition(i, j), a) = a
                                                                [using specialize permutation.transpositionElsewhere(i, j, a) a-is-not-i a-is-not-j]
                                                              @the-conjugator-fixes-a |
                                                                apply(compose(transposition(i, j), transposition(b, c)), a) = a
                                                                [using simplify function.composeApply bc-fixes-a ij-fixes-a]

                                                              @images-substituted |
                                                                compose(compose(compose(transposition(i, j), transposition(b, c)),
                                                                  compose(transposition(i, a), transposition(i, j))),
                                                                  inverse(compose(transposition(i, j), transposition(b, c))))
                                                                  = compose(transposition(j, a), transposition(j, i))
                                                                [using simplify the-conjugator-sends-i-to-j the-conjugator-sends-j-to-i the-conjugator-fixes-a the-conjugate-relabels]

                                                              // the relabelled form IS the twist, by two rotation instances
                                                              @rotated-once |
                                                                compose(transposition(j, a), transposition(j, i))
                                                                  = compose(transposition(a, i), transposition(a, j))
                                                                [using specialize aThreeCycleIsInvariantUnderRotation(a, j, i) a-is-not-j a-is-not-i j-is-not-i]
                                                              @j-is-not-i |
                                                                j != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, j) i-is-not-j]
                                                              @rotated-twice |
                                                                compose(transposition(a, i), transposition(a, j))
                                                                  = compose(transposition(i, j), transposition(i, a))
                                                                [using specialize aThreeCycleIsInvariantUnderRotation(i, a, j) i-is-not-a i-is-not-j a-is-not-j]

                                                              @conclusion-twist |
                                                                compose(compose(compose(transposition(i, j), transposition(b, c)),
                                                                  compose(transposition(i, a), transposition(i, j))),
                                                                  inverse(compose(transposition(i, j), transposition(b, c))))
                                                                  = compose(transposition(i, j), transposition(i, a))
                                                                [using chain images-substituted rotated-once rotated-twice]
                                                            }
                                                          @b-not-c-implies |
                                                            b != c ->
                                                              compose(compose(compose(transposition(i, j), transposition(b, c)),
                                                              compose(transposition(i, a), transposition(i, j))),
                                                              inverse(compose(transposition(i, j), transposition(b, c))))
                                                              = compose(transposition(i, j), transposition(i, a))
                                                            [by discharge given-b-not-c]
                                                        }
                                                      @a-not-c-implies |
                                                        a != c -> b != c ->
                                                          compose(compose(compose(transposition(i, j), transposition(b, c)),
                                                          compose(transposition(i, a), transposition(i, j))),
                                                          inverse(compose(transposition(i, j), transposition(b, c))))
                                                          = compose(transposition(i, j), transposition(i, a))
                                                        [by discharge given-a-not-c]
                                                    }
                                                  @a-not-b-implies |
                                                    a != b -> a != c -> b != c ->
                                                      compose(compose(compose(transposition(i, j), transposition(b, c)),
                                                      compose(transposition(i, a), transposition(i, j))),
                                                      inverse(compose(transposition(i, j), transposition(b, c))))
                                                      = compose(transposition(i, j), transposition(i, a))
                                                    [by discharge given-a-not-b]
                                                }
                                              @j-not-c-implies |
                                                j != c -> a != b -> a != c -> b != c ->
                                                  compose(compose(compose(transposition(i, j), transposition(b, c)),
                                                  compose(transposition(i, a), transposition(i, j))),
                                                  inverse(compose(transposition(i, j), transposition(b, c))))
                                                  = compose(transposition(i, j), transposition(i, a))
                                                [by discharge given-j-not-c]
                                            }
                                          @j-not-b-implies |
                                            j != b -> j != c -> a != b -> a != c -> b != c ->
                                              compose(compose(compose(transposition(i, j), transposition(b, c)),
                                              compose(transposition(i, a), transposition(i, j))),
                                              inverse(compose(transposition(i, j), transposition(b, c))))
                                              = compose(transposition(i, j), transposition(i, a))
                                            [by discharge given-j-not-b]
                                        }
                                      @j-not-a-implies |
                                        j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                                          compose(compose(compose(transposition(i, j), transposition(b, c)),
                                          compose(transposition(i, a), transposition(i, j))),
                                          inverse(compose(transposition(i, j), transposition(b, c))))
                                          = compose(transposition(i, j), transposition(i, a))
                                        [by discharge given-j-not-a]
                                    }
                                  @i-not-c-implies |
                                    i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                                      compose(compose(compose(transposition(i, j), transposition(b, c)),
                                      compose(transposition(i, a), transposition(i, j))),
                                      inverse(compose(transposition(i, j), transposition(b, c))))
                                      = compose(transposition(i, j), transposition(i, a))
                                    [by discharge given-i-not-c]
                                }
                              @i-not-b-implies |
                                i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                                  compose(compose(compose(transposition(i, j), transposition(b, c)),
                                  compose(transposition(i, a), transposition(i, j))),
                                  inverse(compose(transposition(i, j), transposition(b, c))))
                                  = compose(transposition(i, j), transposition(i, a))
                                [by discharge given-i-not-b]
                            }
                          @i-not-a-implies |
                            i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                              compose(compose(compose(transposition(i, j), transposition(b, c)),
                              compose(transposition(i, a), transposition(i, j))),
                              inverse(compose(transposition(i, j), transposition(b, c))))
                              = compose(transposition(i, j), transposition(i, a))
                            [by discharge given-i-not-a]
                        }
                      @i-not-j-implies |
                        i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                          compose(compose(compose(transposition(i, j), transposition(b, c)),
                          compose(transposition(i, a), transposition(i, j))),
                          inverse(compose(transposition(i, j), transposition(b, c))))
                          = compose(transposition(i, j), transposition(i, a))
                        [by discharge given-i-not-j]
                    }
                  @discharge-c |
                    forall c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                      compose(compose(compose(transposition(i, j), transposition(b, c)),
                      compose(transposition(i, a), transposition(i, j))),
                      inverse(compose(transposition(i, j), transposition(b, c))))
                      = compose(transposition(i, j), transposition(i, a))
                    [by generalize generalize-c]
                }
              @discharge-b |
                forall b: Element; forall c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                  compose(compose(compose(transposition(i, j), transposition(b, c)),
                  compose(transposition(i, a), transposition(i, j))),
                  inverse(compose(transposition(i, j), transposition(b, c))))
                  = compose(transposition(i, j), transposition(i, a))
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Element; forall c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
              compose(compose(compose(transposition(i, j), transposition(b, c)),
              compose(transposition(i, a), transposition(i, j))),
              inverse(compose(transposition(i, j), transposition(b, c))))
              = compose(transposition(i, j), transposition(i, a))
            [by generalize generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; forall c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
          compose(compose(compose(transposition(i, j), transposition(b, c)),
          compose(transposition(i, a), transposition(i, j))),
          inverse(compose(transposition(i, j), transposition(b, c))))
          = compose(transposition(i, j), transposition(i, a))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; forall c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
      compose(compose(compose(transposition(i, j), transposition(b, c)),
      compose(transposition(i, a), transposition(i, j))),
      inverse(compose(transposition(i, j), transposition(b, c))))
      = compose(transposition(i, j), transposition(i, a))
    [by generalize generalize-i]
qed

// ============================================================================
// LEMMA 10.9: from ONE 3-cycle in N to EVERY 3-cycle in N
// ============================================================================

// REACHING THE WHOLE FIXED FAMILY. If a normal subgroup N contains `(i,j,a)`, it contains
// `(i,j,k)` for every k outside {i,j}:
//
//   (i,j,a) in N  ==>  (i,j,k) in N
//
// WHY THE FIXED FAMILY IS THE RIGHT TARGET, and why this is one step rather than a chain.
// I first tried to reach an ARBITRARY 3-cycle by chaining
// `conjugatingAThreeCycleMovesItsThirdPoint`, and measured the cost: diameter 3 under that
// move alone (the far point being the twist, hence
// `conjugatingAThreeCycleByASwapAndASpareSwapGivesItsTwist`), or diameter 2 with the twist
// added. But the shortest chain's rotation representatives vary per target, so no fixed
// formula captures it, and a fixed 3-move pattern I tried was blocked on 3120 of 3600 pairs —
// the move cannot send a point to a value already in the triple.
//
// The fixed family dissolves that. Judson's four identities, all proved above, write ANY
// 3-cycle as a PRODUCT of members of the single family `(i,j,k)` with i and j fixed:
//
//   (i,a,j)   = (i,j,a)^2                            aThreeCycleIsTheSquareOfItsTwist
//   (i,a,b)   = (i,j,b)(i,j,a)^2                     aThreeCycleOffTheFixedPairFactors
//   (j,a,b)   = (i,j,b)^2(i,j,a)                     aThreeCycleThroughTheSecondFixedPointFactors
//   (a,b,c)   = (i,j,a)^2(i,j,c)(i,j,b)^2(i,j,a)     aThreeCycleAwayFromTheFixedPairFactors
//
// So N need only contain the FAMILY; closure under products (which a subgroup has) supplies
// everything else. And within the family exactly ONE point varies, which is precisely what the
// move changes — so reaching the whole family is a SINGLE conjugation, no chain and no case
// analysis on overlap. Verified: every family member is one move away at n = 5 and n = 6.
//
// Stated over a schema parameter `inN(Fn)` rather than through a `model`, matching
// `aSubgroupContainingEveryThreeCycleContainsTheAlternatingGroup`: N is a hypothesis here, not
// a fixed predicate, so a consumer supplies its own membership predicate.
theorem aNormalSubgroupWithOneFamilyMemberHasThemAll(inN(Fn)):
  (forall sigma: Fn; forall g: Fn; alternating.inAlternating(sigma) -> inN(g) ->
  inN(compose(compose(sigma, g), inverse(sigma)))) ->
  forall i, j, a, b, c: Element;
  i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c ->
  alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) ->
  inN(compose(transposition(i, a), transposition(i, j))) ->
  inN(compose(transposition(i, b), transposition(i, j)))
proof
  @given-normality |
    assume forall sigma: Fn; forall g: Fn; alternating.inAlternating(sigma) -> inN(g) ->
      inN(compose(compose(sigma, g), inverse(sigma))) {
      @normality |
        forall sigma: Fn; forall g: Fn; alternating.inAlternating(sigma) -> inN(g) ->
          inN(compose(compose(sigma, g), inverse(sigma)))
        [by hypothesis given-normality]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-a |
                fix a: Element {
                  @generalize-b |
                    fix b: Element {
                      @generalize-c |
                        fix c: Element {
                          @given-i-not-a |
                            assume i != a {
                              @given-i-not-b |
                                assume i != b {
                                  @given-i-not-c |
                                    assume i != c {
                                      @given-j-not-a |
                                        assume j != a {
                                          @given-j-not-b |
                                            assume j != b {
                                              @given-j-not-c |
                                                assume j != c {
                                                  @given-a-not-b |
                                                    assume a != b {
                                                      @given-b-not-c |
                                                        assume b != c {
                                                          @given-conjugator-is-even |
                                                            assume alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) {
                                                              @given-family-member-in-n |
                                                                assume inN(compose(transposition(i, a), transposition(i, j))) {
                                                                  @i-is-not-a |
                                                                    i != a
                                                                    [by hypothesis given-i-not-a]
                                                                  @i-is-not-b |
                                                                    i != b
                                                                    [by hypothesis given-i-not-b]
                                                                  @i-is-not-c |
                                                                    i != c
                                                                    [by hypothesis given-i-not-c]
                                                                  @j-is-not-a |
                                                                    j != a
                                                                    [by hypothesis given-j-not-a]
                                                                  @j-is-not-b |
                                                                    j != b
                                                                    [by hypothesis given-j-not-b]
                                                                  @j-is-not-c |
                                                                    j != c
                                                                    [by hypothesis given-j-not-c]
                                                                  @a-is-not-b |
                                                                    a != b
                                                                    [by hypothesis given-a-not-b]
                                                                  @b-is-not-c |
                                                                    b != c
                                                                    [by hypothesis given-b-not-c]
                                                                  @the-conjugator-is-even |
                                                                    alternating.inAlternating(compose(transposition(a, c), transposition(a, b)))
                                                                    [by hypothesis given-conjugator-is-even]
                                                                  @the-family-member-is-in-n |
                                                                    inN(compose(transposition(i, a), transposition(i, j)))
                                                                    [by hypothesis given-family-member-in-n]

                                                                  // normality puts the conjugate in N
                                                                  @the-conjugate-is-in-n |
                                                                    inN(compose(compose(compose(transposition(a, c), transposition(a, b)),
                                                                      compose(transposition(i, a), transposition(i, j))),
                                                                      inverse(compose(transposition(a, c), transposition(a, b)))))
                                                                    [using specialize normality(compose(transposition(a, c), transposition(a, b)), compose(transposition(i, a), transposition(i, j))) the-conjugator-is-even the-family-member-is-in-n]

                                                                  // and that conjugate IS the next family member
                                                                  @the-conjugate-moves-the-third-point |
                                                                    compose(compose(compose(transposition(a, c), transposition(a, b)),
                                                                      compose(transposition(i, a), transposition(i, j))),
                                                                      inverse(compose(transposition(a, c), transposition(a, b))))
                                                                      = compose(transposition(i, b), transposition(i, j))
                                                                    [using specialize conjugatingAThreeCycleMovesItsThirdPoint(i, j, a, b, c) i-is-not-a i-is-not-b i-is-not-c j-is-not-a j-is-not-b j-is-not-c a-is-not-b b-is-not-c]

                                                                  @conclusion-next-family-member |
                                                                    inN(compose(transposition(i, b), transposition(i, j)))
                                                                    [by rewrite the-conjugate-moves-the-third-point the-conjugate-is-in-n]
                                                                }
                                                              @family-member-in-n-implies |
                                                                inN(compose(transposition(i, a), transposition(i, j))) ->
                                                                  inN(compose(transposition(i, b), transposition(i, j)))
                                                                [by discharge given-family-member-in-n]
                                                            }
                                                          @conjugator-even-implies |
                                                            alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                                                              inN(compose(transposition(i, b), transposition(i, j)))
                                                            [by discharge given-conjugator-is-even]
                                                        }
                                                      @b-not-c-implies |
                                                        b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                                                          inN(compose(transposition(i, b), transposition(i, j)))
                                                        [by discharge given-b-not-c]
                                                    }
                                                  @a-not-b-implies |
                                                    a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                                                      inN(compose(transposition(i, b), transposition(i, j)))
                                                    [by discharge given-a-not-b]
                                                }
                                              @j-not-c-implies |
                                                j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                                                  inN(compose(transposition(i, b), transposition(i, j)))
                                                [by discharge given-j-not-c]
                                            }
                                          @j-not-b-implies |
                                            j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                                              inN(compose(transposition(i, b), transposition(i, j)))
                                            [by discharge given-j-not-b]
                                        }
                                      @j-not-a-implies |
                                        j != a -> j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                                          inN(compose(transposition(i, b), transposition(i, j)))
                                        [by discharge given-j-not-a]
                                    }
                                  @i-not-c-implies |
                                    i != c -> j != a -> j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                                      inN(compose(transposition(i, b), transposition(i, j)))
                                    [by discharge given-i-not-c]
                                }
                              @i-not-b-implies |
                                i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                                  inN(compose(transposition(i, b), transposition(i, j)))
                                [by discharge given-i-not-b]
                            }
                          @i-not-a-implies |
                            i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                              inN(compose(transposition(i, b), transposition(i, j)))
                            [by discharge given-i-not-a]
                        }
                      @discharge-c |
                        forall c: Element; i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                          inN(compose(transposition(i, b), transposition(i, j)))
                        [by generalize generalize-c]
                    }
                  @discharge-b |
                    forall b, c: Element; i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                      inN(compose(transposition(i, b), transposition(i, j)))
                    [by generalize generalize-b]
                }
              @discharge-a |
                forall a, b, c: Element; i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
                  inN(compose(transposition(i, b), transposition(i, j)))
                [by generalize generalize-a]
            }
          @discharge-j |
            forall j, a, b, c: Element; i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
              inN(compose(transposition(i, b), transposition(i, j)))
            [by generalize generalize-j]
        }
      @every-family-member |
        forall i, j, a, b, c: Element; i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
          inN(compose(transposition(i, b), transposition(i, j)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall sigma: Fn; forall g: Fn; alternating.inAlternating(sigma) -> inN(g) ->
      inN(compose(compose(sigma, g), inverse(sigma)))) ->
      forall i, j, a, b, c: Element; i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c -> alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) -> inN(compose(transposition(i, a), transposition(i, j))) ->
      inN(compose(transposition(i, b), transposition(i, j)))
    [by discharge given-normality]
qed

// The schema exercised at N = A_n, which is the honest demonstration: A_n is normal in itself
// (`theAlternatingGroupIsClosedUnderConjugation` is just closure under composition and
// inverses), so the move's conclusion must hold there. A consumer with a genuine proper normal
// subgroup instantiates the same schema at its own membership predicate.
theorem theAlternatingGroupHasEveryFamilyMember:
  forall i, j, a, b, c: Element;
  i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c ->
  alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) ->
  alternating.inAlternating(compose(transposition(i, a), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(i, b), transposition(i, j)))
proof
  @the-alternating-group-is-normal-in-itself |
    forall sigma: Fn; forall g: Fn; alternating.inAlternating(sigma) -> alternating.inAlternating(g) ->
      alternating.inAlternating(compose(compose(sigma, g), inverse(sigma)))
    [by cite alternating.theAlternatingGroupIsClosedUnderConjugation]
  @conclusion |
    forall i, j, a, b, c: Element;
      i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> b != c ->
      alternating.inAlternating(compose(transposition(a, c), transposition(a, b))) ->
      alternating.inAlternating(compose(transposition(i, a), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(i, b), transposition(i, j)))
    [using instantiation aNormalSubgroupWithOneFamilyMemberHasThemAll((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-normal-in-itself]
qed

// ============================================================================
// LEMMA 10.9, THE SELECTOR: every 3-cycle is a product of family members
// ============================================================================

// Each case below takes N's binary product closure plus "N has the whole family (i,j,k)" and
// places one SHAPE of 3-cycle in N, via the matching Judson identity. The shapes, by where the
// 3-cycle's points sit relative to the fixed pair (i,j), are exhaustive up to rotation —
// checked over all 120 triples on six points:
//
//   (i,j,k)   in the family already                   — no identity needed
//   (i,a,j)   = (i,j,a)^2                             aThreeCycleIsTheSquareOfItsTwist
//   (i,a,b)   = (i,j,b)(i,j,a)^2                      aThreeCycleOffTheFixedPairFactors
//   (j,a,b)   = (i,j,b)^2(i,j,a)                      aThreeCycleThroughTheSecondFixedPointFactors
//   (a,b,c)   = (i,j,a)^2(i,j,c)(i,j,b)^2(i,j,a)      aThreeCycleAwayFromTheFixedPairFactors
//
// No new mathematics here — every identity is proved above. What each case does is walk the
// identity's factors through N's closure, which is why the cases differ only in factor count
// (two, three, three, six).

// SHAPE (i,a,j): the twist of a family member, hence its square.
theorem aTwistOfAFamilyMemberIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  inN(compose(transposition(i, a), transposition(i, j))) ->
  inN(compose(transposition(i, j), transposition(i, a)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-a |
                fix a: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-j-not-a |
                            assume j != a {
                              @given-family-member |
                                assume inN(compose(transposition(i, a), transposition(i, j))) {
                                  @i-is-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @i-is-not-a |
                                    i != a
                                    [by hypothesis given-i-not-a]
                                  @j-is-not-a |
                                    j != a
                                    [by hypothesis given-j-not-a]
                                  @the-family-member-is-in-n |
                                    inN(compose(transposition(i, a), transposition(i, j)))
                                    [by hypothesis given-family-member]

                                  // the square is in N by closure
                                  @the-square-is-in-n |
                                    inN(compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j))))
                                    [using specialize closure(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))) the-family-member-is-in-n the-family-member-is-in-n]

                                  // and the square IS the twist
                                  @the-twist-is-the-square |
                                    compose(transposition(i, j), transposition(i, a))
                                      = compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))
                                    [using specialize aThreeCycleIsTheSquareOfItsTwist(i, j, a) i-is-not-j i-is-not-a j-is-not-a]

                                  @conclusion-twist-in-n |
                                    inN(compose(transposition(i, j), transposition(i, a)))
                                    [by rewrite the-twist-is-the-square the-square-is-in-n]
                                }
                              @family-member-implies |
                                inN(compose(transposition(i, a), transposition(i, j))) ->
                                  inN(compose(transposition(i, j), transposition(i, a)))
                                [by discharge given-family-member]
                            }
                          @j-not-a-implies |
                            j != a -> inN(compose(transposition(i, a), transposition(i, j))) ->
                              inN(compose(transposition(i, j), transposition(i, a)))
                            [by discharge given-j-not-a]
                        }
                      @i-not-a-implies |
                        i != a -> j != a -> inN(compose(transposition(i, a), transposition(i, j))) ->
                          inN(compose(transposition(i, j), transposition(i, a)))
                        [by discharge given-i-not-a]
                    }
                  @conclusion-at-a |
                    i != j -> i != a -> j != a ->
                      inN(compose(transposition(i, a), transposition(i, j))) ->
                      inN(compose(transposition(i, j), transposition(i, a)))
                    [by discharge given-i-not-j]
                }
              @discharge-a |
                forall a: Element; i != j -> i != a -> j != a ->
                  inN(compose(transposition(i, a), transposition(i, j))) ->
                  inN(compose(transposition(i, j), transposition(i, a)))
                [by generalize generalize-a]
            }
          @discharge-j |
            forall j, a: Element; i != j -> i != a -> j != a ->
              inN(compose(transposition(i, a), transposition(i, j))) ->
              inN(compose(transposition(i, j), transposition(i, a)))
            [by generalize generalize-j]
        }
      @every-twist |
        forall i, j, a: Element; i != j -> i != a -> j != a ->
          inN(compose(transposition(i, a), transposition(i, j))) ->
          inN(compose(transposition(i, j), transposition(i, a)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, a: Element; i != j -> i != a -> j != a ->
      inN(compose(transposition(i, a), transposition(i, j))) ->
      inN(compose(transposition(i, j), transposition(i, a)))
    [by discharge given-closure]
qed

// The shape-(i,a,j) case exercised at N = A_n.
theorem theAlternatingGroupHasTheTwists:
  forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  alternating.inAlternating(compose(transposition(i, a), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(i, j), transposition(i, a)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a ->
      alternating.inAlternating(compose(transposition(i, a), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(i, j), transposition(i, a)))
    [using instantiation aTwistOfAFamilyMemberIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// SHAPE (i,a,b): through the FIRST fixed point only.
theorem aThreeCycleOffTheFixedPairIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
  inN(compose(transposition(i, b), transposition(i, a)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-a |
                fix a: Element {
                  @generalize-b |
                    fix b: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-i-not-a |
                            assume i != a {
                              @given-i-not-b |
                                assume i != b {
                                  @given-j-not-a |
                                    assume j != a {
                                      @given-j-not-b |
                                        assume j != b {
                                          @given-a-not-b |
                                            assume a != b {
                                              @given-first-family-member |
                                                assume inN(compose(transposition(i, a), transposition(i, j))) {
                                                  @given-second-family-member |
                                                    assume inN(compose(transposition(i, b), transposition(i, j))) {
                                                      @i-is-not-j |
                                                        i != j
                                                        [by hypothesis given-i-not-j]
                                                      @i-is-not-a |
                                                        i != a
                                                        [by hypothesis given-i-not-a]
                                                      @i-is-not-b |
                                                        i != b
                                                        [by hypothesis given-i-not-b]
                                                      @j-is-not-a |
                                                        j != a
                                                        [by hypothesis given-j-not-a]
                                                      @j-is-not-b |
                                                        j != b
                                                        [by hypothesis given-j-not-b]
                                                      @a-is-not-b |
                                                        a != b
                                                        [by hypothesis given-a-not-b]
                                                      @first-is-in-n |
                                                        inN(compose(transposition(i, a), transposition(i, j)))
                                                        [by hypothesis given-first-family-member]
                                                      @second-is-in-n |
                                                        inN(compose(transposition(i, b), transposition(i, j)))
                                                        [by hypothesis given-second-family-member]

                                                      // walk the identity's factors through N's closure
                                                      @the-inner-product-is-in-n |
                                                        inN(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                        [using specialize closure(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))) first-is-in-n first-is-in-n]
                                                      @the-full-product-is-in-n |
                                                        inN(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))))
                                                        [using specialize closure(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))) second-is-in-n the-inner-product-is-in-n]
                                                      @the-identity |
                                                        compose(transposition(i, b), transposition(i, a))
                                                          = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                        [using specialize aThreeCycleOffTheFixedPairFactors(i, j, a, b) i-is-not-j i-is-not-a i-is-not-b j-is-not-a j-is-not-b a-is-not-b]
                                                      @conclusion-shape-in-n |
                                                        inN(compose(transposition(i, b), transposition(i, a)))
                                                        [by rewrite the-identity the-full-product-is-in-n]
                                                    }
                                                  @second-member-implies |
                                                    inN(compose(transposition(i, b), transposition(i, j))) ->
                                                      inN(compose(transposition(i, b), transposition(i, a)))
                                                    [by discharge given-second-family-member]
                                                }
                                              @first-member-implies |
                                                inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                                                  inN(compose(transposition(i, b), transposition(i, a)))
                                                [by discharge given-first-family-member]
                                            }
                                          @a-not-b-implies |
                                            a != b ->
                                              inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                                              inN(compose(transposition(i, b), transposition(i, a)))
                                            [by discharge given-a-not-b]
                                        }
                                      @j-not-b-implies |
                                        j != b -> a != b ->
                                          inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                                          inN(compose(transposition(i, b), transposition(i, a)))
                                        [by discharge given-j-not-b]
                                    }
                                  @j-not-a-implies |
                                    j != a -> j != b -> a != b ->
                                      inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                                      inN(compose(transposition(i, b), transposition(i, a)))
                                    [by discharge given-j-not-a]
                                }
                              @i-not-b-implies |
                                i != b -> j != a -> j != b -> a != b ->
                                  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                                  inN(compose(transposition(i, b), transposition(i, a)))
                                [by discharge given-i-not-b]
                            }
                          @i-not-a-implies |
                            i != a -> i != b -> j != a -> j != b -> a != b ->
                              inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                              inN(compose(transposition(i, b), transposition(i, a)))
                            [by discharge given-i-not-a]
                        }
                      @i-not-j-implies |
                        i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
                          inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                          inN(compose(transposition(i, b), transposition(i, a)))
                        [by discharge given-i-not-j]
                    }
                  @discharge-b |
                    forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
                      inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                      inN(compose(transposition(i, b), transposition(i, a)))
                    [by generalize generalize-b]
                }
              @discharge-a |
                forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
                  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                  inN(compose(transposition(i, b), transposition(i, a)))
                [by generalize generalize-a]
            }
          @discharge-j |
            forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
              inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
              inN(compose(transposition(i, b), transposition(i, a)))
            [by generalize generalize-j]
        }
      @every-such-shape |
        forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
          inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
          inN(compose(transposition(i, b), transposition(i, a)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
      inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
      inN(compose(transposition(i, b), transposition(i, a)))
    [by discharge given-closure]
qed

// SHAPE (i,a,b) exercised at N = A_n.
theorem theAlternatingGroupHasTheOffPairThreeCycles:
  forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  alternating.inAlternating(compose(transposition(i, a), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, b), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(i, b), transposition(i, a)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
      alternating.inAlternating(compose(transposition(i, a), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, b), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(i, b), transposition(i, a)))
    [using instantiation aThreeCycleOffTheFixedPairIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// SHAPE (j,a,b): through the SECOND fixed point only.
theorem aThreeCycleThroughTheSecondFixedPointIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
  inN(compose(transposition(j, b), transposition(j, a)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-a |
                fix a: Element {
                  @generalize-b |
                    fix b: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-i-not-a |
                            assume i != a {
                              @given-i-not-b |
                                assume i != b {
                                  @given-j-not-a |
                                    assume j != a {
                                      @given-j-not-b |
                                        assume j != b {
                                          @given-a-not-b |
                                            assume a != b {
                                              @given-first-family-member |
                                                assume inN(compose(transposition(i, a), transposition(i, j))) {
                                                  @given-second-family-member |
                                                    assume inN(compose(transposition(i, b), transposition(i, j))) {
                                                      @i-is-not-j |
                                                        i != j
                                                        [by hypothesis given-i-not-j]
                                                      @i-is-not-a |
                                                        i != a
                                                        [by hypothesis given-i-not-a]
                                                      @i-is-not-b |
                                                        i != b
                                                        [by hypothesis given-i-not-b]
                                                      @j-is-not-a |
                                                        j != a
                                                        [by hypothesis given-j-not-a]
                                                      @j-is-not-b |
                                                        j != b
                                                        [by hypothesis given-j-not-b]
                                                      @a-is-not-b |
                                                        a != b
                                                        [by hypothesis given-a-not-b]
                                                      @first-is-in-n |
                                                        inN(compose(transposition(i, a), transposition(i, j)))
                                                        [by hypothesis given-first-family-member]
                                                      @second-is-in-n |
                                                        inN(compose(transposition(i, b), transposition(i, j)))
                                                        [by hypothesis given-second-family-member]

                                                      // walk the identity's factors through N's closure
                                                      @the-inner-product-is-in-n |
                                                        inN(compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                        [using specialize closure(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))) second-is-in-n first-is-in-n]
                                                      @the-full-product-is-in-n |
                                                        inN(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))))
                                                        [using specialize closure(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))) second-is-in-n the-inner-product-is-in-n]
                                                      @the-identity |
                                                        compose(transposition(j, b), transposition(j, a))
                                                          = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                        [using specialize aThreeCycleThroughTheSecondFixedPointFactors(i, j, a, b) i-is-not-j i-is-not-a i-is-not-b j-is-not-a j-is-not-b a-is-not-b]
                                                      @conclusion-shape-in-n |
                                                        inN(compose(transposition(j, b), transposition(j, a)))
                                                        [by rewrite the-identity the-full-product-is-in-n]
                                                    }
                                                  @second-member-implies |
                                                    inN(compose(transposition(i, b), transposition(i, j))) ->
                                                      inN(compose(transposition(j, b), transposition(j, a)))
                                                    [by discharge given-second-family-member]
                                                }
                                              @first-member-implies |
                                                inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                                                  inN(compose(transposition(j, b), transposition(j, a)))
                                                [by discharge given-first-family-member]
                                            }
                                          @a-not-b-implies |
                                            a != b ->
                                              inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                                              inN(compose(transposition(j, b), transposition(j, a)))
                                            [by discharge given-a-not-b]
                                        }
                                      @j-not-b-implies |
                                        j != b -> a != b ->
                                          inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                                          inN(compose(transposition(j, b), transposition(j, a)))
                                        [by discharge given-j-not-b]
                                    }
                                  @j-not-a-implies |
                                    j != a -> j != b -> a != b ->
                                      inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                                      inN(compose(transposition(j, b), transposition(j, a)))
                                    [by discharge given-j-not-a]
                                }
                              @i-not-b-implies |
                                i != b -> j != a -> j != b -> a != b ->
                                  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                                  inN(compose(transposition(j, b), transposition(j, a)))
                                [by discharge given-i-not-b]
                            }
                          @i-not-a-implies |
                            i != a -> i != b -> j != a -> j != b -> a != b ->
                              inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                              inN(compose(transposition(j, b), transposition(j, a)))
                            [by discharge given-i-not-a]
                        }
                      @i-not-j-implies |
                        i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
                          inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                          inN(compose(transposition(j, b), transposition(j, a)))
                        [by discharge given-i-not-j]
                    }
                  @discharge-b |
                    forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
                      inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                      inN(compose(transposition(j, b), transposition(j, a)))
                    [by generalize generalize-b]
                }
              @discharge-a |
                forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
                  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
                  inN(compose(transposition(j, b), transposition(j, a)))
                [by generalize generalize-a]
            }
          @discharge-j |
            forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
              inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
              inN(compose(transposition(j, b), transposition(j, a)))
            [by generalize generalize-j]
        }
      @every-such-shape |
        forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
          inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
          inN(compose(transposition(j, b), transposition(j, a)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
      inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) ->
      inN(compose(transposition(j, b), transposition(j, a)))
    [by discharge given-closure]
qed

// SHAPE (j,a,b) exercised at N = A_n.
theorem theAlternatingGroupHasTheSecondPointThreeCycles:
  forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  alternating.inAlternating(compose(transposition(i, a), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, b), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(j, b), transposition(j, a)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
      alternating.inAlternating(compose(transposition(i, a), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, b), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(j, b), transposition(j, a)))
    [using instantiation aThreeCycleThroughTheSecondFixedPointIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// SHAPE (a,b,c): disjoint from the fixed pair. Judson's longest identity — six family
// members, nested ((Fa Fa)(Fc Fb))(Fb Fa) with Fk = (i,j,k) — so four binary closures.
theorem aThreeCycleAwayFromTheFixedPairIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, a, b, c: Element;
  i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
  inN(compose(transposition(a, c), transposition(a, b)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-a |
                fix a: Element {
                  @generalize-b |
                    fix b: Element {
                      @generalize-c |
                        fix c: Element {
                          @given-i-not-j |
                            assume i != j {
                              @given-i-not-a |
                                assume i != a {
                                  @given-i-not-b |
                                    assume i != b {
                                      @given-i-not-c |
                                        assume i != c {
                                          @given-j-not-a |
                                            assume j != a {
                                              @given-j-not-b |
                                                assume j != b {
                                                  @given-j-not-c |
                                                    assume j != c {
                                                      @given-a-not-b |
                                                        assume a != b {
                                                          @given-a-not-c |
                                                            assume a != c {
                                                              @given-b-not-c |
                                                                assume b != c {
                                                                  @given-family-member-a |
                                                                    assume inN(compose(transposition(i, a), transposition(i, j))) {
                                                                      @given-family-member-b |
                                                                        assume inN(compose(transposition(i, b), transposition(i, j))) {
                                                                          @given-family-member-c |
                                                                            assume inN(compose(transposition(i, c), transposition(i, j))) {
                                                                              @i-is-not-j |
                                                                                i != j
                                                                                [by hypothesis given-i-not-j]
                                                                              @i-is-not-a |
                                                                                i != a
                                                                                [by hypothesis given-i-not-a]
                                                                              @i-is-not-b |
                                                                                i != b
                                                                                [by hypothesis given-i-not-b]
                                                                              @i-is-not-c |
                                                                                i != c
                                                                                [by hypothesis given-i-not-c]
                                                                              @j-is-not-a |
                                                                                j != a
                                                                                [by hypothesis given-j-not-a]
                                                                              @j-is-not-b |
                                                                                j != b
                                                                                [by hypothesis given-j-not-b]
                                                                              @j-is-not-c |
                                                                                j != c
                                                                                [by hypothesis given-j-not-c]
                                                                              @a-is-not-b |
                                                                                a != b
                                                                                [by hypothesis given-a-not-b]
                                                                              @a-is-not-c |
                                                                                a != c
                                                                                [by hypothesis given-a-not-c]
                                                                              @b-is-not-c |
                                                                                b != c
                                                                                [by hypothesis given-b-not-c]
                                                                              @family-member-a-is-in-n |
                                                                                inN(compose(transposition(i, a), transposition(i, j)))
                                                                                [by hypothesis given-family-member-a]
                                                                              @family-member-b-is-in-n |
                                                                                inN(compose(transposition(i, b), transposition(i, j)))
                                                                                [by hypothesis given-family-member-b]
                                                                              @family-member-c-is-in-n |
                                                                                inN(compose(transposition(i, c), transposition(i, j)))
                                                                                [by hypothesis given-family-member-c]

                                                                              // four binary closures up the identity's nesting
                                                                              @a-squared-is-in-n |
                                                                                inN(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                                                [using specialize closure(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))) family-member-a-is-in-n family-member-a-is-in-n]
                                                                              @c-then-b-is-in-n |
                                                                                inN(compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j))))
                                                                                [using specialize closure(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j))) family-member-c-is-in-n family-member-b-is-in-n]
                                                                              @the-left-half-is-in-n |
                                                                                inN(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))))
                                                                                [using specialize closure(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))) a-squared-is-in-n c-then-b-is-in-n]
                                                                              @b-then-a-is-in-n |
                                                                                inN(compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                                                [using specialize closure(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))) family-member-b-is-in-n family-member-a-is-in-n]
                                                                              @the-full-product-is-in-n |
                                                                                inN(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))))
                                                                                [using specialize closure(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))) the-left-half-is-in-n b-then-a-is-in-n]
                                                                              @the-identity |
                                                                                compose(transposition(a, c), transposition(a, b))
                                                                                  = compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                                                                [using specialize aThreeCycleAwayFromTheFixedPairFactors(i, j, a, b, c) i-is-not-j i-is-not-a i-is-not-b i-is-not-c j-is-not-a j-is-not-b j-is-not-c a-is-not-b a-is-not-c b-is-not-c]
                                                                              @conclusion-shape-in-n |
                                                                                inN(compose(transposition(a, c), transposition(a, b)))
                                                                                [by rewrite the-identity the-full-product-is-in-n]
                                                                            }
                                                                          @member-c-implies |
                                                                            inN(compose(transposition(i, c), transposition(i, j))) ->
                                                                              inN(compose(transposition(a, c), transposition(a, b)))
                                                                            [by discharge given-family-member-c]
                                                                        }
                                                                      @member-b-implies |
                                                                        inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                                                          inN(compose(transposition(a, c), transposition(a, b)))
                                                                        [by discharge given-family-member-b]
                                                                    }
                                                                  @member-a-implies |
                                                                    inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                                                      inN(compose(transposition(a, c), transposition(a, b)))
                                                                    [by discharge given-family-member-a]
                                                                }
                                                              @b-not-c-implies |
                                                                b != c ->
                                                                  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                                                  inN(compose(transposition(a, c), transposition(a, b)))
                                                                [by discharge given-b-not-c]
                                                            }
                                                          @a-not-c-implies |
                                                            a != c -> b != c ->
                                                              inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                                              inN(compose(transposition(a, c), transposition(a, b)))
                                                            [by discharge given-a-not-c]
                                                        }
                                                      @a-not-b-implies |
                                                        a != b -> a != c -> b != c ->
                                                          inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                                          inN(compose(transposition(a, c), transposition(a, b)))
                                                        [by discharge given-a-not-b]
                                                    }
                                                  @j-not-c-implies |
                                                    j != c -> a != b -> a != c -> b != c ->
                                                      inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                                      inN(compose(transposition(a, c), transposition(a, b)))
                                                    [by discharge given-j-not-c]
                                                }
                                              @j-not-b-implies |
                                                j != b -> j != c -> a != b -> a != c -> b != c ->
                                                  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                                  inN(compose(transposition(a, c), transposition(a, b)))
                                                [by discharge given-j-not-b]
                                            }
                                          @j-not-a-implies |
                                            j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                                              inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                              inN(compose(transposition(a, c), transposition(a, b)))
                                            [by discharge given-j-not-a]
                                        }
                                      @i-not-c-implies |
                                        i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                                          inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                          inN(compose(transposition(a, c), transposition(a, b)))
                                        [by discharge given-i-not-c]
                                    }
                                  @i-not-b-implies |
                                    i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                                      inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                      inN(compose(transposition(a, c), transposition(a, b)))
                                    [by discharge given-i-not-b]
                                }
                              @i-not-a-implies |
                                i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                                  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                                  inN(compose(transposition(a, c), transposition(a, b)))
                                [by discharge given-i-not-a]
                            }
                          @i-not-j-implies |
                            i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                              inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                              inN(compose(transposition(a, c), transposition(a, b)))
                            [by discharge given-i-not-j]
                        }
                      @discharge-c |
                        forall c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                          inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                          inN(compose(transposition(a, c), transposition(a, b)))
                        [by generalize generalize-c]
                    }
                  @discharge-b |
                    forall b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                      inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                      inN(compose(transposition(a, c), transposition(a, b)))
                    [by generalize generalize-b]
                }
              @discharge-a |
                forall a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
                  inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
                  inN(compose(transposition(a, c), transposition(a, b)))
                [by generalize generalize-a]
            }
          @discharge-j |
            forall j, a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
              inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
              inN(compose(transposition(a, c), transposition(a, b)))
            [by generalize generalize-j]
        }
      @every-such-shape |
        forall i, j, a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
          inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
          inN(compose(transposition(a, c), transposition(a, b)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
      inN(compose(transposition(i, a), transposition(i, j))) -> inN(compose(transposition(i, b), transposition(i, j))) -> inN(compose(transposition(i, c), transposition(i, j))) ->
      inN(compose(transposition(a, c), transposition(a, b)))
    [by discharge given-closure]
qed

// Shape (a,b,c) exercised at N = A_n.
theorem theAlternatingGroupHasTheDisjointThreeCycles:
  forall i, j, a, b, c: Element;
  i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
  alternating.inAlternating(compose(transposition(i, a), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, b), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, c), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(a, c), transposition(a, b)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, a, b, c: Element; i != j -> i != a -> i != b -> i != c -> j != a -> j != b -> j != c -> a != b -> a != c -> b != c ->
      alternating.inAlternating(compose(transposition(i, a), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, b), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, c), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(a, c), transposition(a, b)))
    [using instantiation aThreeCycleAwayFromTheFixedPairIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// ============================================================================
// LEMMA 10.9, THE SHAPE SELECTOR: deciding which identity a 3-cycle needs
// ============================================================================
//
// The four shape theorems above each take a 3-cycle ALREADY in canonical position. A
// consumer holding an arbitrary 3-cycle must first decide which shape it has, and that
// decision is a case analysis on where its three points sit relative to the fixed pair
// (i,j). The tree has 13 leaves — 6 for "both i and j present" (three choices of which
// coordinate is i, two remaining for j), 3 each for "only i" and "only j", 1 for
// "neither" — and the canonical rotation is UNIQUE per leaf, verified over all 120 triples
// on six points, so the branching does not collapse.
//
// Built as one theorem per leaf GROUP rather than one 13-leaf monolith, matching how the
// shapes themselves are organised here, then composed by a four-way split.

// LEAF GROUP: {x,y,z} disjoint from {i,j} — the (a,b,c) shape, no rotation needed.
// The hypotheses arrive in the consumer's orientation (`x != i`) and the shape theorem
// wants the flip (`i != x`), so each is turned by `disequalityIsSymmetric`.
theorem aThreeCycleDisjointFromTheFixedPairIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, x, y, z: Element;
  i != j -> x != y -> x != z -> y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
  inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
  inN(compose(transposition(x, z), transposition(x, y)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-x |
                fix x: Element {
                  @generalize-y |
                    fix y: Element {
                      @generalize-z |
                        fix z: Element {
                          @given-i-not-j |
                            assume i != j {
                              @given-x-not-y |
                                assume x != y {
                                  @given-x-not-z |
                                    assume x != z {
                                      @given-y-not-z |
                                        assume y != z {
                                          @given-x-not-i |
                                            assume x != i {
                                              @given-y-not-i |
                                                assume y != i {
                                                  @given-z-not-i |
                                                    assume z != i {
                                                      @given-x-not-j |
                                                        assume x != j {
                                                          @given-y-not-j |
                                                            assume y != j {
                                                              @given-z-not-j |
                                                                assume z != j {
                                                                  @given-family-member-x |
                                                                    assume inN(compose(transposition(i, x), transposition(i, j))) {
                                                                      @given-family-member-y |
                                                                        assume inN(compose(transposition(i, y), transposition(i, j))) {
                                                                          @given-family-member-z |
                                                                            assume inN(compose(transposition(i, z), transposition(i, j))) {
                                                                              @i-is-not-j |
                                                                                i != j
                                                                                [by hypothesis given-i-not-j]
                                                                              @x-is-not-y |
                                                                                x != y
                                                                                [by hypothesis given-x-not-y]
                                                                              @x-is-not-z |
                                                                                x != z
                                                                                [by hypothesis given-x-not-z]
                                                                              @y-is-not-z |
                                                                                y != z
                                                                                [by hypothesis given-y-not-z]
                                                                              @x-is-not-i |
                                                                                x != i
                                                                                [by hypothesis given-x-not-i]
                                                                              @y-is-not-i |
                                                                                y != i
                                                                                [by hypothesis given-y-not-i]
                                                                              @z-is-not-i |
                                                                                z != i
                                                                                [by hypothesis given-z-not-i]
                                                                              @x-is-not-j |
                                                                                x != j
                                                                                [by hypothesis given-x-not-j]
                                                                              @y-is-not-j |
                                                                                y != j
                                                                                [by hypothesis given-y-not-j]
                                                                              @z-is-not-j |
                                                                                z != j
                                                                                [by hypothesis given-z-not-j]
                                                                              @family-member-x-is-in-n |
                                                                                inN(compose(transposition(i, x), transposition(i, j)))
                                                                                [by hypothesis given-family-member-x]
                                                                              @family-member-y-is-in-n |
                                                                                inN(compose(transposition(i, y), transposition(i, j)))
                                                                                [by hypothesis given-family-member-y]
                                                                              @family-member-z-is-in-n |
                                                                                inN(compose(transposition(i, z), transposition(i, j)))
                                                                                [by hypothesis given-family-member-z]

                                                                              // flip the six non-membership disequalities into the shape theorem's orientation
                                                                              @i-is-not-x |
                                                                                i != x
                                                                                [using specialize alternating.disequalityIsSymmetric(x, i) x-is-not-i]
                                                                              @i-is-not-y |
                                                                                i != y
                                                                                [using specialize alternating.disequalityIsSymmetric(y, i) y-is-not-i]
                                                                              @i-is-not-z |
                                                                                i != z
                                                                                [using specialize alternating.disequalityIsSymmetric(z, i) z-is-not-i]
                                                                              @j-is-not-x |
                                                                                j != x
                                                                                [using specialize alternating.disequalityIsSymmetric(x, j) x-is-not-j]
                                                                              @j-is-not-y |
                                                                                j != y
                                                                                [using specialize alternating.disequalityIsSymmetric(y, j) y-is-not-j]
                                                                              @j-is-not-z |
                                                                                j != z
                                                                                [using specialize alternating.disequalityIsSymmetric(z, j) z-is-not-j]

                                                                              // the (a,b,c) shape at (x,y,z)
                                                                              @the-disjoint-shape-schema |
                                                                                forall i2, j2, a, b, c: Element;
                                                                                  i2 != j2 -> i2 != a -> i2 != b -> i2 != c -> j2 != a -> j2 != b -> j2 != c -> a != b -> a != c -> b != c ->
                                                                                  inN(compose(transposition(i2, a), transposition(i2, j2))) ->
                                                                                  inN(compose(transposition(i2, b), transposition(i2, j2))) ->
                                                                                  inN(compose(transposition(i2, c), transposition(i2, j2))) ->
                                                                                  inN(compose(transposition(a, c), transposition(a, b)))
                                                                                [using instantiation aThreeCycleAwayFromTheFixedPairIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                                              @conclusion-disjoint-shape-in-n |
                                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                                [using specialize the-disjoint-shape-schema(i, j, x, y, z) i-is-not-j i-is-not-x i-is-not-y i-is-not-z j-is-not-x j-is-not-y j-is-not-z x-is-not-y x-is-not-z y-is-not-z family-member-x-is-in-n family-member-y-is-in-n family-member-z-is-in-n]
                                                                            }
                                                                          @member-z-implies |
                                                                            inN(compose(transposition(i, z), transposition(i, j))) ->
                                                                              inN(compose(transposition(x, z), transposition(x, y)))
                                                                            [by discharge given-family-member-z]
                                                                        }
                                                                      @member-y-implies |
                                                                        inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                                                          inN(compose(transposition(x, z), transposition(x, y)))
                                                                        [by discharge given-family-member-y]
                                                                    }
                                                                  @member-x-implies |
                                                                    inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                                                      inN(compose(transposition(x, z), transposition(x, y)))
                                                                    [by discharge given-family-member-x]
                                                                }
                                                              @z-not-j-implies |
                                                                z != j ->
                                                                  inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                                                  inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by discharge given-z-not-j]
                                                            }
                                                          @y-not-j-implies |
                                                            y != j -> z != j ->
                                                              inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                                              inN(compose(transposition(x, z), transposition(x, y)))
                                                            [by discharge given-y-not-j]
                                                        }
                                                      @x-not-j-implies |
                                                        x != j -> y != j -> z != j ->
                                                          inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                                          inN(compose(transposition(x, z), transposition(x, y)))
                                                        [by discharge given-x-not-j]
                                                    }
                                                  @z-not-i-implies |
                                                    z != i -> x != j -> y != j -> z != j ->
                                                      inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                                      inN(compose(transposition(x, z), transposition(x, y)))
                                                    [by discharge given-z-not-i]
                                                }
                                              @y-not-i-implies |
                                                y != i -> z != i -> x != j -> y != j -> z != j ->
                                                  inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                                  inN(compose(transposition(x, z), transposition(x, y)))
                                                [by discharge given-y-not-i]
                                            }
                                          @x-not-i-implies |
                                            x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
                                              inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                              inN(compose(transposition(x, z), transposition(x, y)))
                                            [by discharge given-x-not-i]
                                        }
                                      @y-not-z-implies |
                                        y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
                                          inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                          inN(compose(transposition(x, z), transposition(x, y)))
                                        [by discharge given-y-not-z]
                                    }
                                  @x-not-z-implies |
                                    x != z -> y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
                                      inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                      inN(compose(transposition(x, z), transposition(x, y)))
                                    [by discharge given-x-not-z]
                                }
                              @x-not-y-implies |
                                x != y -> x != z -> y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
                                  inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                                  inN(compose(transposition(x, z), transposition(x, y)))
                                [by discharge given-x-not-y]
                            }
                          @i-not-j-implies |
                            i != j -> x != y -> x != z -> y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
                              inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                              inN(compose(transposition(x, z), transposition(x, y)))
                            [by discharge given-i-not-j]
                        }
                      @discharge-z |
                        forall z: Element; i != j -> x != y -> x != z -> y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
                          inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                          inN(compose(transposition(x, z), transposition(x, y)))
                        [by generalize generalize-z]
                    }
                  @discharge-y |
                    forall y, z: Element; i != j -> x != y -> x != z -> y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
                      inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                      inN(compose(transposition(x, z), transposition(x, y)))
                    [by generalize generalize-y]
                }
              @discharge-x |
                forall x, y, z: Element; i != j -> x != y -> x != z -> y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
                  inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
                  inN(compose(transposition(x, z), transposition(x, y)))
                [by generalize generalize-x]
            }
          @discharge-j |
            forall j, x, y, z: Element; i != j -> x != y -> x != z -> y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
              inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
              inN(compose(transposition(x, z), transposition(x, y)))
            [by generalize generalize-j]
        }
      @every-disjoint-shape |
        forall i, j, x, y, z: Element; i != j -> x != y -> x != z -> y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
          inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
          inN(compose(transposition(x, z), transposition(x, y)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, x, y, z: Element; i != j -> x != y -> x != z -> y != z -> x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
      inN(compose(transposition(i, x), transposition(i, j))) -> inN(compose(transposition(i, y), transposition(i, j))) -> inN(compose(transposition(i, z), transposition(i, j))) ->
      inN(compose(transposition(x, z), transposition(x, y)))
    [by discharge given-closure]
qed

// The disjoint-shape leaf exercised at N = A_n.
theorem theAlternatingGroupHasTheDisjointShapes:
  forall i, j, x, y, z: Element;
  i != j -> x != y -> x != z -> y != z ->
  x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
  alternating.inAlternating(compose(transposition(i, x), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(i, y), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(i, z), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(x, z), transposition(x, y)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, x, y, z: Element;
      i != j -> x != y -> x != z -> y != z ->
      x != i -> y != i -> z != i -> x != j -> y != j -> z != j ->
      alternating.inAlternating(compose(transposition(i, x), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(i, y), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(i, z), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(x, z), transposition(x, y)))
    [using instantiation aThreeCycleDisjointFromTheFixedPairIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// ROTATION CARRIES MEMBERSHIP, and this is what collapses the selector.
//
// I first scoped the shape selector as a 13-leaf case tree over POSITIONS: six leaves for
// "both fixed points present", three each for "only i" and "only j", one for "neither", with
// the canonical rotation unique per leaf (verified over all 120 triples on six points) and so
// no collapse available. That was right about rotation uniqueness and wrong about what the
// formalization needs.
//
// A 3-cycle EQUALS each of its rotations as a permutation. So `inN(c)` for c in non-canonical
// position is the SAME PROPOSITION as `inN(c')` for its canonical rotation c' — not a different
// leaf needing its own theorem, just the same fact written differently. A consumer therefore
// needs the FOUR canonical shape theorems (all proved above) plus this lemma, which it applies
// when its 3-cycle is not already canonical.
//
// So the 13 leaves were an artifact of treating rotations as distinct cases. What genuinely
// remains of the selector is the four-way split that picks WHICH shape applies.
theorem rotationCarriesMembership(inN(Fn)):
  forall i, j, k: Element;
  i != j -> i != k -> j != k ->
  inN(compose(transposition(i, k), transposition(i, j))) ->
  inN(compose(transposition(j, i), transposition(j, k)))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-k |
            fix k: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-k |
                    assume i != k {
                      @given-j-not-k |
                        assume j != k {
                          @given-member |
                            assume inN(compose(transposition(i, k), transposition(i, j))) {
                              @i-is-not-j |
                                i != j
                                [by hypothesis given-i-not-j]
                              @i-is-not-k |
                                i != k
                                [by hypothesis given-i-not-k]
                              @j-is-not-k |
                                j != k
                                [by hypothesis given-j-not-k]
                              @the-member |
                                inN(compose(transposition(i, k), transposition(i, j)))
                                [by hypothesis given-member]
                              @the-rotation |
                                compose(transposition(j, i), transposition(j, k))
                                  = compose(transposition(i, k), transposition(i, j))
                                [using specialize aThreeCycleIsInvariantUnderRotation(i, j, k) i-is-not-j i-is-not-k j-is-not-k]
                              @conclusion-rotated-member |
                                inN(compose(transposition(j, i), transposition(j, k)))
                                [by rewrite the-rotation the-member]
                            }
                          @member-implies |
                            inN(compose(transposition(i, k), transposition(i, j))) ->
                              inN(compose(transposition(j, i), transposition(j, k)))
                            [by discharge given-member]
                        }
                      @jk-implies |
                        j != k -> inN(compose(transposition(i, k), transposition(i, j))) ->
                          inN(compose(transposition(j, i), transposition(j, k)))
                        [by discharge given-j-not-k]
                    }
                  @ik-implies |
                    i != k -> j != k -> inN(compose(transposition(i, k), transposition(i, j))) ->
                      inN(compose(transposition(j, i), transposition(j, k)))
                    [by discharge given-i-not-k]
                }
              @conclusion-at-k |
                i != j -> i != k -> j != k -> inN(compose(transposition(i, k), transposition(i, j))) ->
                  inN(compose(transposition(j, i), transposition(j, k)))
                [by discharge given-i-not-j]
            }
          @d-k |
            forall k: Element; i != j -> i != k -> j != k -> inN(compose(transposition(i, k), transposition(i, j))) ->
              inN(compose(transposition(j, i), transposition(j, k)))
            [by generalize generalize-k]
        }
      @d-j |
        forall j, k: Element; i != j -> i != k -> j != k -> inN(compose(transposition(i, k), transposition(i, j))) ->
          inN(compose(transposition(j, i), transposition(j, k)))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, k: Element; i != j -> i != k -> j != k -> inN(compose(transposition(i, k), transposition(i, j))) ->
      inN(compose(transposition(j, i), transposition(j, k)))
    [by generalize generalize-i]
qed

// Exercised at N = A_n.
theorem theAlternatingGroupCarriesRotations:
  forall i, j, k: Element;
  i != j -> i != k -> j != k ->
  alternating.inAlternating(compose(transposition(i, k), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(j, i), transposition(j, k)))
proof
  @conclusion |
    forall i, j, k: Element; i != j -> i != k -> j != k ->
      alternating.inAlternating(compose(transposition(i, k), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(j, i), transposition(j, k)))
    [using instantiation rotationCarriesMembership((fun g: Fn => alternating.inAlternating(g)))]
qed

// A REPRESENTATIVE SELECTOR LEAF, proved to validate the template the rest follow.
//
// This is the leaf "i is the MIDDLE point": the 3-cycle is `(x,i,z)`, which is one
// rotation away from nothing in particular — the off-pair shape theorem wants i FIRST, so
// the route is to derive the canonical `(i,z,x)` from the two family members, then rotate
// TWICE to land on `(x,i,z)`.
//
// Every one of the selector's 13 leaves has exactly this shape: zero to two applications
// of `rotationCarriesMembership`, then one cite of an already-proved shape theorem,
// instantiated at the leaf's own `inN`. No leaf introduces mathematics. What makes the
// selector large is the case tree, not any individual branch.
theorem aThreeCycleWithTheFirstFixedPointInTheMiddleIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, x, z: Element;
  i != j -> i != x -> i != z -> j != x -> j != z -> x != z ->
  inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
  inN(compose(transposition(x, z), transposition(x, i)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-x |
                fix x: Element {
                  @generalize-z |
                    fix z: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-i-not-x |
                            assume i != x {
                              @given-i-not-z |
                                assume i != z {
                                  @given-j-not-x |
                                    assume j != x {
                                      @given-j-not-z |
                                        assume j != z {
                                          @given-x-not-z |
                                            assume x != z {
                                              @given-family-member-z |
                                                assume inN(compose(transposition(i, z), transposition(i, j))) {
                                                  @given-family-member-x |
                                                    assume inN(compose(transposition(i, x), transposition(i, j))) {
                                                      @i-is-not-j |
                                                        i != j
                                                        [by hypothesis given-i-not-j]
                                                      @i-is-not-x |
                                                        i != x
                                                        [by hypothesis given-i-not-x]
                                                      @i-is-not-z |
                                                        i != z
                                                        [by hypothesis given-i-not-z]
                                                      @j-is-not-x |
                                                        j != x
                                                        [by hypothesis given-j-not-x]
                                                      @j-is-not-z |
                                                        j != z
                                                        [by hypothesis given-j-not-z]
                                                      @x-is-not-z |
                                                        x != z
                                                        [by hypothesis given-x-not-z]
                                                      @family-member-z-is-in-n |
                                                        inN(compose(transposition(i, z), transposition(i, j)))
                                                        [by hypothesis given-family-member-z]
                                                      @family-member-x-is-in-n |
                                                        inN(compose(transposition(i, x), transposition(i, j)))
                                                        [by hypothesis given-family-member-x]

                                                      // the flipped disequalities the cites below consume
                                                      @z-is-not-x |
                                                        z != x
                                                        [using specialize alternating.disequalityIsSymmetric(x, z) x-is-not-z]
                                                      @z-is-not-i |
                                                        z != i
                                                        [using specialize alternating.disequalityIsSymmetric(i, z) i-is-not-z]
                                                      @x-is-not-i |
                                                        x != i
                                                        [using specialize alternating.disequalityIsSymmetric(i, x) i-is-not-x]

                                                      // the canonical (i,z,x) from the off-pair shape, then two rotations to (x,i,z)
                                                      @the-off-pair-shape |
                                                        forall i2, j2, a, b: Element;
                                                          i2 != j2 -> i2 != a -> i2 != b -> j2 != a -> j2 != b -> a != b ->
                                                          inN(compose(transposition(i2, a), transposition(i2, j2))) ->
                                                          inN(compose(transposition(i2, b), transposition(i2, j2))) ->
                                                          inN(compose(transposition(i2, b), transposition(i2, a)))
                                                        [using instantiation aThreeCycleOffTheFixedPairIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                      @the-canonical-member |
                                                        inN(compose(transposition(i, x), transposition(i, z)))
                                                        [using specialize the-off-pair-shape(i, j, z, x) i-is-not-j i-is-not-z i-is-not-x j-is-not-z j-is-not-x z-is-not-x family-member-z-is-in-n family-member-x-is-in-n]
                                                      @the-rotation |
                                                        forall i2, j2, k: Element;
                                                          i2 != j2 -> i2 != k -> j2 != k ->
                                                          inN(compose(transposition(i2, k), transposition(i2, j2))) ->
                                                          inN(compose(transposition(j2, i2), transposition(j2, k)))
                                                        [using instantiation rotationCarriesMembership((fun g: Fn => inN(g)))]
                                                      @rotated-once |
                                                        inN(compose(transposition(z, i), transposition(z, x)))
                                                        [using specialize the-rotation(i, z, x) i-is-not-z i-is-not-x z-is-not-x the-canonical-member]
                                                      @conclusion-leaf |
                                                        inN(compose(transposition(x, z), transposition(x, i)))
                                                        [using specialize the-rotation(z, x, i) z-is-not-x z-is-not-i x-is-not-i rotated-once]
                                                    }
                                                  @member-x-implies |
                                                    inN(compose(transposition(i, x), transposition(i, j))) ->
                                                      inN(compose(transposition(x, z), transposition(x, i)))
                                                    [by discharge given-family-member-x]
                                                }
                                              @member-z-implies |
                                                inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
                                                  inN(compose(transposition(x, z), transposition(x, i)))
                                                [by discharge given-family-member-z]
                                            }
                                          @x-not-z-implies |
                                            x != z ->
                                              inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
                                              inN(compose(transposition(x, z), transposition(x, i)))
                                            [by discharge given-x-not-z]
                                        }
                                      @j-not-z-implies |
                                        j != z -> x != z ->
                                          inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
                                          inN(compose(transposition(x, z), transposition(x, i)))
                                        [by discharge given-j-not-z]
                                    }
                                  @j-not-x-implies |
                                    j != x -> j != z -> x != z ->
                                      inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
                                      inN(compose(transposition(x, z), transposition(x, i)))
                                    [by discharge given-j-not-x]
                                }
                              @i-not-z-implies |
                                i != z -> j != x -> j != z -> x != z ->
                                  inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
                                  inN(compose(transposition(x, z), transposition(x, i)))
                                [by discharge given-i-not-z]
                            }
                          @i-not-x-implies |
                            i != x -> i != z -> j != x -> j != z -> x != z ->
                              inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
                              inN(compose(transposition(x, z), transposition(x, i)))
                            [by discharge given-i-not-x]
                        }
                      @i-not-j-implies |
                        i != j -> i != x -> i != z -> j != x -> j != z -> x != z ->
                          inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
                          inN(compose(transposition(x, z), transposition(x, i)))
                        [by discharge given-i-not-j]
                    }
                  @discharge-z |
                    forall z: Element; i != j -> i != x -> i != z -> j != x -> j != z -> x != z ->
                      inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
                      inN(compose(transposition(x, z), transposition(x, i)))
                    [by generalize generalize-z]
                }
              @discharge-x |
                forall x, z: Element; i != j -> i != x -> i != z -> j != x -> j != z -> x != z ->
                  inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
                  inN(compose(transposition(x, z), transposition(x, i)))
                [by generalize generalize-x]
            }
          @discharge-j |
            forall j, x, z: Element; i != j -> i != x -> i != z -> j != x -> j != z -> x != z ->
              inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
              inN(compose(transposition(x, z), transposition(x, i)))
            [by generalize generalize-j]
        }
      @every-such-leaf |
        forall i, j, x, z: Element; i != j -> i != x -> i != z -> j != x -> j != z -> x != z ->
          inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
          inN(compose(transposition(x, z), transposition(x, i)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, x, z: Element; i != j -> i != x -> i != z -> j != x -> j != z -> x != z ->
      inN(compose(transposition(i, z), transposition(i, j))) -> inN(compose(transposition(i, x), transposition(i, j))) ->
      inN(compose(transposition(x, z), transposition(x, i)))
    [by discharge given-closure]
qed

// That leaf exercised at N = A_n.
theorem theAlternatingGroupHasTheMiddleFixedPointShapes:
  forall i, j, x, z: Element; i != j -> i != x -> i != z -> j != x -> j != z -> x != z ->
  alternating.inAlternating(compose(transposition(i, z), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, x), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(x, z), transposition(x, i)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, x, z: Element; i != j -> i != x -> i != z -> j != x -> j != z -> x != z ->
      alternating.inAlternating(compose(transposition(i, z), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, x), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(x, z), transposition(x, i)))
    [using instantiation aThreeCycleWithTheFirstFixedPointInTheMiddleIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// LEAF: the 3-cycle is `(j,i,p)` — two rotations from the twist `(i,p,j)`.
theorem aTwistStartingAtTheSecondFixedPointIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, p: Element;
  i != j -> i != p -> j != p ->
  inN(compose(transposition(i, p), transposition(i, j))) ->
  inN(compose(transposition(j, p), transposition(j, i)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-p |
                fix p: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-p |
                        assume i != p {
                          @given-j-not-p |
                            assume j != p {
                              @given-family-member-p |
                                assume inN(compose(transposition(i, p), transposition(i, j))) {
                                  @i-is-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @i-is-not-p |
                                    i != p
                                    [by hypothesis given-i-not-p]
                                  @j-is-not-p |
                                    j != p
                                    [by hypothesis given-j-not-p]
                                  @family-member-p-is-in-n |
                                    inN(compose(transposition(i, p), transposition(i, j)))
                                    [by hypothesis given-family-member-p]

                                  // the flipped disequalities the cites below consume
                                  @p-is-not-j |
                                    p != j
                                    [using specialize alternating.disequalityIsSymmetric(j, p) j-is-not-p]
                                  @p-is-not-i |
                                    p != i
                                    [using specialize alternating.disequalityIsSymmetric(i, p) i-is-not-p]
                                  @j-is-not-i |
                                    j != i
                                    [using specialize alternating.disequalityIsSymmetric(i, j) i-is-not-j]

                                  // the canonical form from its shape theorem
                                  @the-shape |
                                    forall i2, j2, a: Element;
                                      i2 != j2 -> i2 != a -> j2 != a ->
                                      inN(compose(transposition(i2, a), transposition(i2, j2))) ->
                                      inN(compose(transposition(i2, j2), transposition(i2, a)))
                                    [using instantiation aTwistOfAFamilyMemberIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                  @the-canonical-member |
                                    inN(compose(transposition(i, j), transposition(i, p)))
                                    [using specialize the-shape(i, j, p) i-is-not-j i-is-not-p j-is-not-p family-member-p-is-in-n]
                                  @the-rotation |
                                    forall i2, j2, k: Element;
                                      i2 != j2 -> i2 != k -> j2 != k ->
                                      inN(compose(transposition(i2, k), transposition(i2, j2))) ->
                                      inN(compose(transposition(j2, i2), transposition(j2, k)))
                                    [using instantiation rotationCarriesMembership((fun g: Fn => inN(g)))]
                                  @rotated-1 |
                                    inN(compose(transposition(p, i), transposition(p, j)))
                                    [using specialize the-rotation(i, p, j) i-is-not-p i-is-not-j p-is-not-j the-canonical-member]
                                  @conclusion-leaf |
                                    inN(compose(transposition(j, p), transposition(j, i)))
                                    [using specialize the-rotation(p, j, i) p-is-not-j p-is-not-i j-is-not-i rotated-1]
                                }
                              @member-p-implies |
                                inN(compose(transposition(i, p), transposition(i, j))) ->
                                  inN(compose(transposition(j, p), transposition(j, i)))
                                [by discharge given-family-member-p]
                            }
                          @j-not-p-implies |
                            j != p ->
                              inN(compose(transposition(i, p), transposition(i, j))) ->
                              inN(compose(transposition(j, p), transposition(j, i)))
                            [by discharge given-j-not-p]
                        }
                      @i-not-p-implies |
                        i != p -> j != p ->
                          inN(compose(transposition(i, p), transposition(i, j))) ->
                          inN(compose(transposition(j, p), transposition(j, i)))
                        [by discharge given-i-not-p]
                    }
                  @i-not-j-implies |
                    i != j -> i != p -> j != p ->
                      inN(compose(transposition(i, p), transposition(i, j))) ->
                      inN(compose(transposition(j, p), transposition(j, i)))
                    [by discharge given-i-not-j]
                }
              @discharge-p |
                forall p: Element; i != j -> i != p -> j != p ->
                  inN(compose(transposition(i, p), transposition(i, j))) ->
                  inN(compose(transposition(j, p), transposition(j, i)))
                [by generalize generalize-p]
            }
          @discharge-j |
            forall j, p: Element; i != j -> i != p -> j != p ->
              inN(compose(transposition(i, p), transposition(i, j))) ->
              inN(compose(transposition(j, p), transposition(j, i)))
            [by generalize generalize-j]
        }
      @every-such-leaf |
        forall i, j, p: Element; i != j -> i != p -> j != p ->
          inN(compose(transposition(i, p), transposition(i, j))) ->
          inN(compose(transposition(j, p), transposition(j, i)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, p: Element; i != j -> i != p -> j != p ->
      inN(compose(transposition(i, p), transposition(i, j))) ->
      inN(compose(transposition(j, p), transposition(j, i)))
    [by discharge given-closure]
qed

// aTwistStartingAtTheSecondFixedPoint leaf exercised at N = A_n.
theorem theAlternatingGroupHasTheSecondStartTwists:
  forall i, j, p: Element; i != j -> i != p -> j != p ->
  alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(j, p), transposition(j, i)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, p: Element; i != j -> i != p -> j != p ->
      alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(j, p), transposition(j, i)))
    [using instantiation aTwistStartingAtTheSecondFixedPointIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// LEAF: the 3-cycle is `(p,j,i)` — one rotation from the twist `(i,p,j)`.
theorem aTwistStartingOffTheFixedPairIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, p: Element;
  i != j -> i != p -> j != p ->
  inN(compose(transposition(i, p), transposition(i, j))) ->
  inN(compose(transposition(p, i), transposition(p, j)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-p |
                fix p: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-p |
                        assume i != p {
                          @given-j-not-p |
                            assume j != p {
                              @given-family-member-p |
                                assume inN(compose(transposition(i, p), transposition(i, j))) {
                                  @i-is-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @i-is-not-p |
                                    i != p
                                    [by hypothesis given-i-not-p]
                                  @j-is-not-p |
                                    j != p
                                    [by hypothesis given-j-not-p]
                                  @family-member-p-is-in-n |
                                    inN(compose(transposition(i, p), transposition(i, j)))
                                    [by hypothesis given-family-member-p]

                                  // the flipped disequalities the cites below consume
                                  @p-is-not-j |
                                    p != j
                                    [using specialize alternating.disequalityIsSymmetric(j, p) j-is-not-p]

                                  // the canonical form from its shape theorem
                                  @the-shape |
                                    forall i2, j2, a: Element;
                                      i2 != j2 -> i2 != a -> j2 != a ->
                                      inN(compose(transposition(i2, a), transposition(i2, j2))) ->
                                      inN(compose(transposition(i2, j2), transposition(i2, a)))
                                    [using instantiation aTwistOfAFamilyMemberIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                  @the-canonical-member |
                                    inN(compose(transposition(i, j), transposition(i, p)))
                                    [using specialize the-shape(i, j, p) i-is-not-j i-is-not-p j-is-not-p family-member-p-is-in-n]
                                  @the-rotation |
                                    forall i2, j2, k: Element;
                                      i2 != j2 -> i2 != k -> j2 != k ->
                                      inN(compose(transposition(i2, k), transposition(i2, j2))) ->
                                      inN(compose(transposition(j2, i2), transposition(j2, k)))
                                    [using instantiation rotationCarriesMembership((fun g: Fn => inN(g)))]
                                  @conclusion-leaf |
                                    inN(compose(transposition(p, i), transposition(p, j)))
                                    [using specialize the-rotation(i, p, j) i-is-not-p i-is-not-j p-is-not-j the-canonical-member]
                                }
                              @member-p-implies |
                                inN(compose(transposition(i, p), transposition(i, j))) ->
                                  inN(compose(transposition(p, i), transposition(p, j)))
                                [by discharge given-family-member-p]
                            }
                          @j-not-p-implies |
                            j != p ->
                              inN(compose(transposition(i, p), transposition(i, j))) ->
                              inN(compose(transposition(p, i), transposition(p, j)))
                            [by discharge given-j-not-p]
                        }
                      @i-not-p-implies |
                        i != p -> j != p ->
                          inN(compose(transposition(i, p), transposition(i, j))) ->
                          inN(compose(transposition(p, i), transposition(p, j)))
                        [by discharge given-i-not-p]
                    }
                  @i-not-j-implies |
                    i != j -> i != p -> j != p ->
                      inN(compose(transposition(i, p), transposition(i, j))) ->
                      inN(compose(transposition(p, i), transposition(p, j)))
                    [by discharge given-i-not-j]
                }
              @discharge-p |
                forall p: Element; i != j -> i != p -> j != p ->
                  inN(compose(transposition(i, p), transposition(i, j))) ->
                  inN(compose(transposition(p, i), transposition(p, j)))
                [by generalize generalize-p]
            }
          @discharge-j |
            forall j, p: Element; i != j -> i != p -> j != p ->
              inN(compose(transposition(i, p), transposition(i, j))) ->
              inN(compose(transposition(p, i), transposition(p, j)))
            [by generalize generalize-j]
        }
      @every-such-leaf |
        forall i, j, p: Element; i != j -> i != p -> j != p ->
          inN(compose(transposition(i, p), transposition(i, j))) ->
          inN(compose(transposition(p, i), transposition(p, j)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, p: Element; i != j -> i != p -> j != p ->
      inN(compose(transposition(i, p), transposition(i, j))) ->
      inN(compose(transposition(p, i), transposition(p, j)))
    [by discharge given-closure]
qed

// aTwistStartingOffTheFixedPair leaf exercised at N = A_n.
theorem theAlternatingGroupHasTheOffStartTwists:
  forall i, j, p: Element; i != j -> i != p -> j != p ->
  alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(p, i), transposition(p, j)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, p: Element; i != j -> i != p -> j != p ->
      alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(p, i), transposition(p, j)))
    [using instantiation aTwistStartingOffTheFixedPairIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// LEAF: the 3-cycle is `(p,q,i)` — one rotation from the off-pair canonical `(i,p,q)`.
theorem aThreeCycleEndingAtTheFirstFixedPointIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, p, q: Element;
  i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
  inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
  inN(compose(transposition(p, i), transposition(p, q)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-p |
                fix p: Element {
                  @generalize-q |
                    fix q: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-i-not-p |
                            assume i != p {
                              @given-i-not-q |
                                assume i != q {
                                  @given-j-not-p |
                                    assume j != p {
                                      @given-j-not-q |
                                        assume j != q {
                                          @given-p-not-q |
                                            assume p != q {
                                              @given-family-member-p |
                                                assume inN(compose(transposition(i, p), transposition(i, j))) {
                                                  @given-family-member-q |
                                                    assume inN(compose(transposition(i, q), transposition(i, j))) {
                                                      @i-is-not-j |
                                                        i != j
                                                        [by hypothesis given-i-not-j]
                                                      @i-is-not-p |
                                                        i != p
                                                        [by hypothesis given-i-not-p]
                                                      @i-is-not-q |
                                                        i != q
                                                        [by hypothesis given-i-not-q]
                                                      @j-is-not-p |
                                                        j != p
                                                        [by hypothesis given-j-not-p]
                                                      @j-is-not-q |
                                                        j != q
                                                        [by hypothesis given-j-not-q]
                                                      @p-is-not-q |
                                                        p != q
                                                        [by hypothesis given-p-not-q]
                                                      @family-member-p-is-in-n |
                                                        inN(compose(transposition(i, p), transposition(i, j)))
                                                        [by hypothesis given-family-member-p]
                                                      @family-member-q-is-in-n |
                                                        inN(compose(transposition(i, q), transposition(i, j)))
                                                        [by hypothesis given-family-member-q]

                                                      // the canonical form from its shape theorem
                                                      @the-shape |
                                                        forall i2, j2, a, b: Element;
                                                          i2 != j2 -> i2 != a -> i2 != b -> j2 != a -> j2 != b -> a != b ->
                                                          inN(compose(transposition(i2, a), transposition(i2, j2))) ->
                                                          inN(compose(transposition(i2, b), transposition(i2, j2))) ->
                                                          inN(compose(transposition(i2, b), transposition(i2, a)))
                                                        [using instantiation aThreeCycleOffTheFixedPairIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                      @the-canonical-member |
                                                        inN(compose(transposition(i, q), transposition(i, p)))
                                                        [using specialize the-shape(i, j, p, q) i-is-not-j i-is-not-p i-is-not-q j-is-not-p j-is-not-q p-is-not-q family-member-p-is-in-n family-member-q-is-in-n]
                                                      @the-rotation |
                                                        forall i2, j2, k: Element;
                                                          i2 != j2 -> i2 != k -> j2 != k ->
                                                          inN(compose(transposition(i2, k), transposition(i2, j2))) ->
                                                          inN(compose(transposition(j2, i2), transposition(j2, k)))
                                                        [using instantiation rotationCarriesMembership((fun g: Fn => inN(g)))]
                                                      @conclusion-leaf |
                                                        inN(compose(transposition(p, i), transposition(p, q)))
                                                        [using specialize the-rotation(i, p, q) i-is-not-p i-is-not-q p-is-not-q the-canonical-member]
                                                    }
                                                  @member-q-implies |
                                                    inN(compose(transposition(i, q), transposition(i, j))) ->
                                                      inN(compose(transposition(p, i), transposition(p, q)))
                                                    [by discharge given-family-member-q]
                                                }
                                              @member-p-implies |
                                                inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                                                  inN(compose(transposition(p, i), transposition(p, q)))
                                                [by discharge given-family-member-p]
                                            }
                                          @p-not-q-implies |
                                            p != q ->
                                              inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                                              inN(compose(transposition(p, i), transposition(p, q)))
                                            [by discharge given-p-not-q]
                                        }
                                      @j-not-q-implies |
                                        j != q -> p != q ->
                                          inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                                          inN(compose(transposition(p, i), transposition(p, q)))
                                        [by discharge given-j-not-q]
                                    }
                                  @j-not-p-implies |
                                    j != p -> j != q -> p != q ->
                                      inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                                      inN(compose(transposition(p, i), transposition(p, q)))
                                    [by discharge given-j-not-p]
                                }
                              @i-not-q-implies |
                                i != q -> j != p -> j != q -> p != q ->
                                  inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                                  inN(compose(transposition(p, i), transposition(p, q)))
                                [by discharge given-i-not-q]
                            }
                          @i-not-p-implies |
                            i != p -> i != q -> j != p -> j != q -> p != q ->
                              inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                              inN(compose(transposition(p, i), transposition(p, q)))
                            [by discharge given-i-not-p]
                        }
                      @i-not-j-implies |
                        i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
                          inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                          inN(compose(transposition(p, i), transposition(p, q)))
                        [by discharge given-i-not-j]
                    }
                  @discharge-q |
                    forall q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
                      inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                      inN(compose(transposition(p, i), transposition(p, q)))
                    [by generalize generalize-q]
                }
              @discharge-p |
                forall p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
                  inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                  inN(compose(transposition(p, i), transposition(p, q)))
                [by generalize generalize-p]
            }
          @discharge-j |
            forall j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
              inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
              inN(compose(transposition(p, i), transposition(p, q)))
            [by generalize generalize-j]
        }
      @every-such-leaf |
        forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
          inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
          inN(compose(transposition(p, i), transposition(p, q)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
      inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
      inN(compose(transposition(p, i), transposition(p, q)))
    [by discharge given-closure]
qed

// The EndingAtTheFirstFixedPoint leaf exercised at N = A_n.
theorem theAlternatingGroupHasTheFirstEndShapes:
  forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
  alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, q), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(p, i), transposition(p, q)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
      alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, q), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(p, i), transposition(p, q)))
    [using instantiation aThreeCycleEndingAtTheFirstFixedPointIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// LEAF: the 3-cycle is `(p,j,q)` — two rotations from the second-point canonical `(j,q,p)`.
theorem aThreeCycleWithTheSecondFixedPointInTheMiddleIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, p, q: Element;
  i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
  inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
  inN(compose(transposition(p, q), transposition(p, j)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-p |
                fix p: Element {
                  @generalize-q |
                    fix q: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-i-not-p |
                            assume i != p {
                              @given-i-not-q |
                                assume i != q {
                                  @given-j-not-p |
                                    assume j != p {
                                      @given-j-not-q |
                                        assume j != q {
                                          @given-p-not-q |
                                            assume p != q {
                                              @given-family-member-q |
                                                assume inN(compose(transposition(i, q), transposition(i, j))) {
                                                  @given-family-member-p |
                                                    assume inN(compose(transposition(i, p), transposition(i, j))) {
                                                      @i-is-not-j |
                                                        i != j
                                                        [by hypothesis given-i-not-j]
                                                      @i-is-not-p |
                                                        i != p
                                                        [by hypothesis given-i-not-p]
                                                      @i-is-not-q |
                                                        i != q
                                                        [by hypothesis given-i-not-q]
                                                      @j-is-not-p |
                                                        j != p
                                                        [by hypothesis given-j-not-p]
                                                      @j-is-not-q |
                                                        j != q
                                                        [by hypothesis given-j-not-q]
                                                      @p-is-not-q |
                                                        p != q
                                                        [by hypothesis given-p-not-q]
                                                      @family-member-q-is-in-n |
                                                        inN(compose(transposition(i, q), transposition(i, j)))
                                                        [by hypothesis given-family-member-q]
                                                      @family-member-p-is-in-n |
                                                        inN(compose(transposition(i, p), transposition(i, j)))
                                                        [by hypothesis given-family-member-p]

                                                      // the flipped disequalities the cites below consume
                                                      @q-is-not-p |
                                                        q != p
                                                        [using specialize alternating.disequalityIsSymmetric(p, q) p-is-not-q]
                                                      @q-is-not-j |
                                                        q != j
                                                        [using specialize alternating.disequalityIsSymmetric(j, q) j-is-not-q]
                                                      @p-is-not-j |
                                                        p != j
                                                        [using specialize alternating.disequalityIsSymmetric(j, p) j-is-not-p]

                                                      // the canonical form from its shape theorem
                                                      @the-shape |
                                                        forall i2, j2, a, b: Element;
                                                          i2 != j2 -> i2 != a -> i2 != b -> j2 != a -> j2 != b -> a != b ->
                                                          inN(compose(transposition(i2, a), transposition(i2, j2))) ->
                                                          inN(compose(transposition(i2, b), transposition(i2, j2))) ->
                                                          inN(compose(transposition(j2, b), transposition(j2, a)))
                                                        [using instantiation aThreeCycleThroughTheSecondFixedPointIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                      @the-canonical-member |
                                                        inN(compose(transposition(j, p), transposition(j, q)))
                                                        [using specialize the-shape(i, j, q, p) i-is-not-j i-is-not-q i-is-not-p j-is-not-q j-is-not-p q-is-not-p family-member-q-is-in-n family-member-p-is-in-n]
                                                      @the-rotation |
                                                        forall i2, j2, k: Element;
                                                          i2 != j2 -> i2 != k -> j2 != k ->
                                                          inN(compose(transposition(i2, k), transposition(i2, j2))) ->
                                                          inN(compose(transposition(j2, i2), transposition(j2, k)))
                                                        [using instantiation rotationCarriesMembership((fun g: Fn => inN(g)))]
                                                      @rotated-1 |
                                                        inN(compose(transposition(q, j), transposition(q, p)))
                                                        [using specialize the-rotation(j, q, p) j-is-not-q j-is-not-p q-is-not-p the-canonical-member]
                                                      @conclusion-leaf |
                                                        inN(compose(transposition(p, q), transposition(p, j)))
                                                        [using specialize the-rotation(q, p, j) q-is-not-p q-is-not-j p-is-not-j rotated-1]
                                                    }
                                                  @member-p-implies |
                                                    inN(compose(transposition(i, p), transposition(i, j))) ->
                                                      inN(compose(transposition(p, q), transposition(p, j)))
                                                    [by discharge given-family-member-p]
                                                }
                                              @member-q-implies |
                                                inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
                                                  inN(compose(transposition(p, q), transposition(p, j)))
                                                [by discharge given-family-member-q]
                                            }
                                          @p-not-q-implies |
                                            p != q ->
                                              inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
                                              inN(compose(transposition(p, q), transposition(p, j)))
                                            [by discharge given-p-not-q]
                                        }
                                      @j-not-q-implies |
                                        j != q -> p != q ->
                                          inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
                                          inN(compose(transposition(p, q), transposition(p, j)))
                                        [by discharge given-j-not-q]
                                    }
                                  @j-not-p-implies |
                                    j != p -> j != q -> p != q ->
                                      inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
                                      inN(compose(transposition(p, q), transposition(p, j)))
                                    [by discharge given-j-not-p]
                                }
                              @i-not-q-implies |
                                i != q -> j != p -> j != q -> p != q ->
                                  inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
                                  inN(compose(transposition(p, q), transposition(p, j)))
                                [by discharge given-i-not-q]
                            }
                          @i-not-p-implies |
                            i != p -> i != q -> j != p -> j != q -> p != q ->
                              inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
                              inN(compose(transposition(p, q), transposition(p, j)))
                            [by discharge given-i-not-p]
                        }
                      @i-not-j-implies |
                        i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
                          inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
                          inN(compose(transposition(p, q), transposition(p, j)))
                        [by discharge given-i-not-j]
                    }
                  @discharge-q |
                    forall q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
                      inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
                      inN(compose(transposition(p, q), transposition(p, j)))
                    [by generalize generalize-q]
                }
              @discharge-p |
                forall p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
                  inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
                  inN(compose(transposition(p, q), transposition(p, j)))
                [by generalize generalize-p]
            }
          @discharge-j |
            forall j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
              inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
              inN(compose(transposition(p, q), transposition(p, j)))
            [by generalize generalize-j]
        }
      @every-such-leaf |
        forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
          inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
          inN(compose(transposition(p, q), transposition(p, j)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
      inN(compose(transposition(i, q), transposition(i, j))) -> inN(compose(transposition(i, p), transposition(i, j))) ->
      inN(compose(transposition(p, q), transposition(p, j)))
    [by discharge given-closure]
qed

// The WithTheSecondFixedPointInTheMiddle leaf exercised at N = A_n.
theorem theAlternatingGroupHasTheSecondMiddleShapes:
  forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
  alternating.inAlternating(compose(transposition(i, q), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(p, q), transposition(p, j)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
      alternating.inAlternating(compose(transposition(i, q), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(p, q), transposition(p, j)))
    [using instantiation aThreeCycleWithTheSecondFixedPointInTheMiddleIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// LEAF: the 3-cycle is `(p,q,j)` — one rotation from the second-point canonical `(j,p,q)`.
theorem aThreeCycleEndingAtTheSecondFixedPointIsInTheSubgroup(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  forall i, j, p, q: Element;
  i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
  inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
  inN(compose(transposition(p, j), transposition(p, q)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @generalize-i |
        fix i: Element {
          @generalize-j |
            fix j: Element {
              @generalize-p |
                fix p: Element {
                  @generalize-q |
                    fix q: Element {
                      @given-i-not-j |
                        assume i != j {
                          @given-i-not-p |
                            assume i != p {
                              @given-i-not-q |
                                assume i != q {
                                  @given-j-not-p |
                                    assume j != p {
                                      @given-j-not-q |
                                        assume j != q {
                                          @given-p-not-q |
                                            assume p != q {
                                              @given-family-member-p |
                                                assume inN(compose(transposition(i, p), transposition(i, j))) {
                                                  @given-family-member-q |
                                                    assume inN(compose(transposition(i, q), transposition(i, j))) {
                                                      @i-is-not-j |
                                                        i != j
                                                        [by hypothesis given-i-not-j]
                                                      @i-is-not-p |
                                                        i != p
                                                        [by hypothesis given-i-not-p]
                                                      @i-is-not-q |
                                                        i != q
                                                        [by hypothesis given-i-not-q]
                                                      @j-is-not-p |
                                                        j != p
                                                        [by hypothesis given-j-not-p]
                                                      @j-is-not-q |
                                                        j != q
                                                        [by hypothesis given-j-not-q]
                                                      @p-is-not-q |
                                                        p != q
                                                        [by hypothesis given-p-not-q]
                                                      @family-member-p-is-in-n |
                                                        inN(compose(transposition(i, p), transposition(i, j)))
                                                        [by hypothesis given-family-member-p]
                                                      @family-member-q-is-in-n |
                                                        inN(compose(transposition(i, q), transposition(i, j)))
                                                        [by hypothesis given-family-member-q]

                                                      // the canonical form from its shape theorem
                                                      @the-shape |
                                                        forall i2, j2, a, b: Element;
                                                          i2 != j2 -> i2 != a -> i2 != b -> j2 != a -> j2 != b -> a != b ->
                                                          inN(compose(transposition(i2, a), transposition(i2, j2))) ->
                                                          inN(compose(transposition(i2, b), transposition(i2, j2))) ->
                                                          inN(compose(transposition(j2, b), transposition(j2, a)))
                                                        [using instantiation aThreeCycleThroughTheSecondFixedPointIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                      @the-canonical-member |
                                                        inN(compose(transposition(j, q), transposition(j, p)))
                                                        [using specialize the-shape(i, j, p, q) i-is-not-j i-is-not-p i-is-not-q j-is-not-p j-is-not-q p-is-not-q family-member-p-is-in-n family-member-q-is-in-n]
                                                      @the-rotation |
                                                        forall i2, j2, k: Element;
                                                          i2 != j2 -> i2 != k -> j2 != k ->
                                                          inN(compose(transposition(i2, k), transposition(i2, j2))) ->
                                                          inN(compose(transposition(j2, i2), transposition(j2, k)))
                                                        [using instantiation rotationCarriesMembership((fun g: Fn => inN(g)))]
                                                      @conclusion-leaf |
                                                        inN(compose(transposition(p, j), transposition(p, q)))
                                                        [using specialize the-rotation(j, p, q) j-is-not-p j-is-not-q p-is-not-q the-canonical-member]
                                                    }
                                                  @member-q-implies |
                                                    inN(compose(transposition(i, q), transposition(i, j))) ->
                                                      inN(compose(transposition(p, j), transposition(p, q)))
                                                    [by discharge given-family-member-q]
                                                }
                                              @member-p-implies |
                                                inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                                                  inN(compose(transposition(p, j), transposition(p, q)))
                                                [by discharge given-family-member-p]
                                            }
                                          @p-not-q-implies |
                                            p != q ->
                                              inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                                              inN(compose(transposition(p, j), transposition(p, q)))
                                            [by discharge given-p-not-q]
                                        }
                                      @j-not-q-implies |
                                        j != q -> p != q ->
                                          inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                                          inN(compose(transposition(p, j), transposition(p, q)))
                                        [by discharge given-j-not-q]
                                    }
                                  @j-not-p-implies |
                                    j != p -> j != q -> p != q ->
                                      inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                                      inN(compose(transposition(p, j), transposition(p, q)))
                                    [by discharge given-j-not-p]
                                }
                              @i-not-q-implies |
                                i != q -> j != p -> j != q -> p != q ->
                                  inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                                  inN(compose(transposition(p, j), transposition(p, q)))
                                [by discharge given-i-not-q]
                            }
                          @i-not-p-implies |
                            i != p -> i != q -> j != p -> j != q -> p != q ->
                              inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                              inN(compose(transposition(p, j), transposition(p, q)))
                            [by discharge given-i-not-p]
                        }
                      @i-not-j-implies |
                        i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
                          inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                          inN(compose(transposition(p, j), transposition(p, q)))
                        [by discharge given-i-not-j]
                    }
                  @discharge-q |
                    forall q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
                      inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                      inN(compose(transposition(p, j), transposition(p, q)))
                    [by generalize generalize-q]
                }
              @discharge-p |
                forall p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
                  inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
                  inN(compose(transposition(p, j), transposition(p, q)))
                [by generalize generalize-p]
            }
          @discharge-j |
            forall j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
              inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
              inN(compose(transposition(p, j), transposition(p, q)))
            [by generalize generalize-j]
        }
      @every-such-leaf |
        forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
          inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
          inN(compose(transposition(p, j), transposition(p, q)))
        [by generalize generalize-i]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
      inN(compose(transposition(i, p), transposition(i, j))) -> inN(compose(transposition(i, q), transposition(i, j))) ->
      inN(compose(transposition(p, j), transposition(p, q)))
    [by discharge given-closure]
qed

// The EndingAtTheSecondFixedPoint leaf exercised at N = A_n.
theorem theAlternatingGroupHasTheSecondEndShapes:
  forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
  alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, q), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(p, j), transposition(p, q)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall i, j, p, q: Element; i != j -> i != p -> i != q -> j != p -> j != q -> p != q ->
      alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) -> alternating.inAlternating(compose(transposition(i, q), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(p, j), transposition(p, q)))
    [using instantiation aThreeCycleEndingAtTheSecondFixedPointIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed

// FROM TRIPLES TO 3-CYCLES. `isAThreeCycle` is a `define` expanding to a nested existential —
// "some distinct x, y, z with g = T(x,z) o T(x,y)" — so a statement about every DISTINCT TRIPLE
// is already a statement about every 3-CYCLE. This lemma is that conversion, and it is the
// bridge between the selector (which reasons about named points) and the capstone's second
// premise (which quantifies over elements of Fn).
//
// It is worth its own lemma rather than being inlined because the unpack is three levels deep
// and every consumer of the selector needs exactly this shape. The conjunction comes out by
// `tautology`, which is sound here precisely because the four conjuncts are opaque atoms it
// need only project — no equational reasoning is being asked of it.
theorem everyTripleInTheSubgroupMeansEveryThreeCycle(inN(Fn)):
  (forall x, y, z: Element; x != y -> x != z -> y != z ->
  inN(compose(transposition(x, z), transposition(x, y)))) ->
  forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)
proof
  @given-all-triples |
    assume forall x, y, z: Element; x != y -> x != z -> y != z ->
      inN(compose(transposition(x, z), transposition(x, y))) {
      @all-triples |
        forall x, y, z: Element; x != y -> x != z -> y != z ->
          inN(compose(transposition(x, z), transposition(x, y)))
        [by hypothesis given-all-triples]
      @generalize-c |
        fix c: Fn {
          @given-three-cycle |
            assume alternating.isAThreeCycle(c) {
              @the-three-cycle |
                alternating.isAThreeCycle(c)
                [by hypothesis given-three-cycle]
              @unfolded |
                exists x: Element; exists y: Element; exists z: Element;
                  x != y and x != z and y != z and
                  c = compose(transposition(x, z), transposition(x, y))
                [using tautology the-three-cycle]
              @with-point-x |
                unpack x: Element from unfolded {
                  @inner-x |
                    exists y: Element; exists z: Element;
                      x != y and x != z and y != z and
                      c = compose(transposition(x, z), transposition(x, y))
                    [by hypothesis with-point-x]
                  @with-point-y |
                    unpack y: Element from inner-x {
                      @inner-y |
                        exists z: Element;
                          x != y and x != z and y != z and
                          c = compose(transposition(x, z), transposition(x, y))
                        [by hypothesis with-point-y]
                      @with-point-z |
                        unpack z: Element from inner-y {
                          @facts |
                            x != y and x != z and y != z and
                              c = compose(transposition(x, z), transposition(x, y))
                            [by hypothesis with-point-z]
                          @x-not-y |
                            x != y
                            [using tautology facts]
                          @x-not-z |
                            x != z
                            [using tautology facts]
                          @y-not-z |
                            y != z
                            [using tautology facts]
                          @c-is-the-triple |
                            c = compose(transposition(x, z), transposition(x, y))
                            [using tautology facts]
                          @triple-in-n |
                            inN(compose(transposition(x, z), transposition(x, y)))
                            [using specialize all-triples(x, y, z) x-not-y x-not-z y-not-z]
                          @conclusion-c-in-n |
                            inN(c)
                            [by rewrite c-is-the-triple triple-in-n]
                        }
                      @conclusion-inner-z |
                        inN(c)
                        [by unpacked with-point-z]
                    }
                  @conclusion-inner-y |
                    inN(c)
                    [by unpacked with-point-y]
                }
              @conclusion-unpacked |
                inN(c)
                [by unpacked with-point-x]
            }
          @three-cycle-implies |
            alternating.isAThreeCycle(c) -> inN(c)
            [by discharge given-three-cycle]
        }
      @all-c |
        forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)
        [by generalize generalize-c]
    }
  @conclusion |
    (forall x, y, z: Element; x != y -> x != z -> y != z ->
      inN(compose(transposition(x, z), transposition(x, y)))) ->
      forall c: Fn; alternating.isAThreeCycle(c) -> inN(c)
    [by discharge given-all-triples]
qed

// Exercised at N = A_n.
theorem theAlternatingGroupHasEveryThreeCycleFromItsTriples:
  (forall x, y, z: Element; x != y -> x != z -> y != z ->
  alternating.inAlternating(compose(transposition(x, z), transposition(x, y)))) ->
  forall c: Fn; alternating.isAThreeCycle(c) -> alternating.inAlternating(c)
proof
  @conclusion |
    (forall x, y, z: Element; x != y -> x != z -> y != z ->
      alternating.inAlternating(compose(transposition(x, z), transposition(x, y)))) ->
      forall c: Fn; alternating.isAThreeCycle(c) -> alternating.inAlternating(c)
    [using instantiation everyTripleInTheSubgroupMeansEveryThreeCycle((fun g: Fn => alternating.inAlternating(g)))]
qed

// LEAF: the 3-cycle is `(j,p,i)` — one rotation of the family member `(i,j,p)`.
//
// No shape theorem and no product closure — the canonical form IS the family member the
// consumer already holds, so the whole leaf is rotation. These two leaves are why the
// "rotation-only leaves need nothing" classification was wrong: the family premise
// supplies `(i,j,p)` and these goals are its rotations, which still want a theorem.
theorem aFamilyMemberStartingAtTheSecondFixedPointIsInTheSubgroup(inN(Fn)):
  forall i, j, p: Element;
  i != j -> i != p -> j != p ->
  inN(compose(transposition(i, p), transposition(i, j))) ->
  inN(compose(transposition(j, i), transposition(j, p)))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-p |
            fix p: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-p |
                    assume i != p {
                      @given-j-not-p |
                        assume j != p {
                          @given-family-member |
                            assume inN(compose(transposition(i, p), transposition(i, j))) {
                              @i-is-not-j |
                                i != j
                                [by hypothesis given-i-not-j]
                              @i-is-not-p |
                                i != p
                                [by hypothesis given-i-not-p]
                              @j-is-not-p |
                                j != p
                                [by hypothesis given-j-not-p]
                              @the-family-member |
                                inN(compose(transposition(i, p), transposition(i, j)))
                                [by hypothesis given-family-member]

                              // 1 rotation(s) of the family member
                              @the-rotation |
                                forall i2, j2, k: Element;
                                  i2 != j2 -> i2 != k -> j2 != k ->
                                  inN(compose(transposition(i2, k), transposition(i2, j2))) ->
                                  inN(compose(transposition(j2, i2), transposition(j2, k)))
                                [using instantiation rotationCarriesMembership((fun g: Fn => inN(g)))]
                              @conclusion-leaf |
                                inN(compose(transposition(j, i), transposition(j, p)))
                                [using specialize the-rotation(i, j, p) i-is-not-j i-is-not-p j-is-not-p the-family-member]
                            }
                          @family-member-implies |
                            inN(compose(transposition(i, p), transposition(i, j))) ->
                              inN(compose(transposition(j, i), transposition(j, p)))
                            [by discharge given-family-member]
                        }
                      @j-not-p-implies |
                        j != p ->
                          inN(compose(transposition(i, p), transposition(i, j))) ->
                          inN(compose(transposition(j, i), transposition(j, p)))
                        [by discharge given-j-not-p]
                    }
                  @i-not-p-implies |
                    i != p -> j != p ->
                      inN(compose(transposition(i, p), transposition(i, j))) ->
                      inN(compose(transposition(j, i), transposition(j, p)))
                    [by discharge given-i-not-p]
                }
              @i-not-j-implies |
                i != j -> i != p -> j != p ->
                  inN(compose(transposition(i, p), transposition(i, j))) ->
                  inN(compose(transposition(j, i), transposition(j, p)))
                [by discharge given-i-not-j]
            }
          @discharge-p |
            forall p: Element; i != j -> i != p -> j != p ->
              inN(compose(transposition(i, p), transposition(i, j))) ->
              inN(compose(transposition(j, i), transposition(j, p)))
            [by generalize generalize-p]
        }
      @discharge-j |
        forall j, p: Element; i != j -> i != p -> j != p ->
          inN(compose(transposition(i, p), transposition(i, j))) ->
          inN(compose(transposition(j, i), transposition(j, p)))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, p: Element; i != j -> i != p -> j != p ->
      inN(compose(transposition(i, p), transposition(i, j))) ->
      inN(compose(transposition(j, i), transposition(j, p)))
    [by generalize generalize-i]
qed

// Exercised at N = A_n.
theorem theAlternatingGroupHasTheSecondStartFamilyShapes:
  forall i, j, p: Element; i != j -> i != p -> j != p ->
  alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(j, i), transposition(j, p)))
proof
  @conclusion |
    forall i, j, p: Element; i != j -> i != p -> j != p ->
      alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(j, i), transposition(j, p)))
    [using instantiation aFamilyMemberStartingAtTheSecondFixedPointIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g)))]
qed

// LEAF: the 3-cycle is `(p,i,j)` — two rotations of the family member `(i,j,p)`.
//
// No shape theorem and no product closure — the canonical form IS the family member the
// consumer already holds, so the whole leaf is rotation. These two leaves are why the
// "rotation-only leaves need nothing" classification was wrong: the family premise
// supplies `(i,j,p)` and these goals are its rotations, which still want a theorem.
theorem aFamilyMemberEndingAtTheFixedPairIsInTheSubgroup(inN(Fn)):
  forall i, j, p: Element;
  i != j -> i != p -> j != p ->
  inN(compose(transposition(i, p), transposition(i, j))) ->
  inN(compose(transposition(p, j), transposition(p, i)))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-p |
            fix p: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-p |
                    assume i != p {
                      @given-j-not-p |
                        assume j != p {
                          @given-family-member |
                            assume inN(compose(transposition(i, p), transposition(i, j))) {
                              @i-is-not-j |
                                i != j
                                [by hypothesis given-i-not-j]
                              @i-is-not-p |
                                i != p
                                [by hypothesis given-i-not-p]
                              @j-is-not-p |
                                j != p
                                [by hypothesis given-j-not-p]
                              @the-family-member |
                                inN(compose(transposition(i, p), transposition(i, j)))
                                [by hypothesis given-family-member]

                              // the flipped disequalities the rotations consume
                              @j-is-not-i |
                                j != i
                                [using specialize alternating.disequalityIsSymmetric(i, j) i-is-not-j]
                              @p-is-not-i |
                                p != i
                                [using specialize alternating.disequalityIsSymmetric(i, p) i-is-not-p]

                              // 2 rotation(s) of the family member
                              @the-rotation |
                                forall i2, j2, k: Element;
                                  i2 != j2 -> i2 != k -> j2 != k ->
                                  inN(compose(transposition(i2, k), transposition(i2, j2))) ->
                                  inN(compose(transposition(j2, i2), transposition(j2, k)))
                                [using instantiation rotationCarriesMembership((fun g: Fn => inN(g)))]
                              @rotated-1 |
                                inN(compose(transposition(j, i), transposition(j, p)))
                                [using specialize the-rotation(i, j, p) i-is-not-j i-is-not-p j-is-not-p the-family-member]
                              @conclusion-leaf |
                                inN(compose(transposition(p, j), transposition(p, i)))
                                [using specialize the-rotation(j, p, i) j-is-not-p j-is-not-i p-is-not-i rotated-1]
                            }
                          @family-member-implies |
                            inN(compose(transposition(i, p), transposition(i, j))) ->
                              inN(compose(transposition(p, j), transposition(p, i)))
                            [by discharge given-family-member]
                        }
                      @j-not-p-implies |
                        j != p ->
                          inN(compose(transposition(i, p), transposition(i, j))) ->
                          inN(compose(transposition(p, j), transposition(p, i)))
                        [by discharge given-j-not-p]
                    }
                  @i-not-p-implies |
                    i != p -> j != p ->
                      inN(compose(transposition(i, p), transposition(i, j))) ->
                      inN(compose(transposition(p, j), transposition(p, i)))
                    [by discharge given-i-not-p]
                }
              @i-not-j-implies |
                i != j -> i != p -> j != p ->
                  inN(compose(transposition(i, p), transposition(i, j))) ->
                  inN(compose(transposition(p, j), transposition(p, i)))
                [by discharge given-i-not-j]
            }
          @discharge-p |
            forall p: Element; i != j -> i != p -> j != p ->
              inN(compose(transposition(i, p), transposition(i, j))) ->
              inN(compose(transposition(p, j), transposition(p, i)))
            [by generalize generalize-p]
        }
      @discharge-j |
        forall j, p: Element; i != j -> i != p -> j != p ->
          inN(compose(transposition(i, p), transposition(i, j))) ->
          inN(compose(transposition(p, j), transposition(p, i)))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, p: Element; i != j -> i != p -> j != p ->
      inN(compose(transposition(i, p), transposition(i, j))) ->
      inN(compose(transposition(p, j), transposition(p, i)))
    [by generalize generalize-i]
qed

// Exercised at N = A_n.
theorem theAlternatingGroupHasTheFixedPairEndShapes:
  forall i, j, p: Element; i != j -> i != p -> j != p ->
  alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) ->
  alternating.inAlternating(compose(transposition(p, j), transposition(p, i)))
proof
  @conclusion |
    forall i, j, p: Element; i != j -> i != p -> j != p ->
      alternating.inAlternating(compose(transposition(i, p), transposition(i, j))) ->
      alternating.inAlternating(compose(transposition(p, j), transposition(p, i)))
    [using instantiation aFamilyMemberEndingAtTheFixedPairIsInTheSubgroup((fun g: Fn => alternating.inAlternating(g)))]
qed

// The selector assembled: from the fixed family to every 3-cycle on distinct points.
//
// A 4 x 4 case tree on where the fixed pair sits — which coordinate of (x,y,z) equals i,
// crossed with the same for j. Thirteen arms are real leaves, each closing by one shape
// theorem proved above (the table is in CHAPTER10-PAINPOINTS, checked by script against
// this file). The three same-coordinate arms close by deriving i = j and discharging.
//
// Nested rather than one flat 13-way split because the flat disjunction is NOT a
// propositional tautology: it admits x = i and x = j both true, `tautology` seeing those
// and i != j as unrelated atoms. Each level here is a genuine tautology over its own three.
theorem everyThreeCycleIsInANormalSubgroupWithTheFamily(inN(Fn)):
  (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
  (forall i2, j2, k: Element; i2 != j2 -> k != i2 -> k != j2 ->
  inN(compose(transposition(i2, k), transposition(i2, j2)))) ->
  forall i, j, x, y, z: Element;
  i != j -> x != y -> x != z -> y != z ->
  inN(compose(transposition(x, z), transposition(x, y)))
proof
  @given-closure |
    assume forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h)) {
      @closure |
        forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))
        [by hypothesis given-closure]
      @given-family |
        assume forall i2, j2, k: Element; i2 != j2 -> k != i2 -> k != j2 ->
          inN(compose(transposition(i2, k), transposition(i2, j2))) {
          @family |
            forall i2, j2, k: Element; i2 != j2 -> k != i2 -> k != j2 ->
              inN(compose(transposition(i2, k), transposition(i2, j2)))
            [by hypothesis given-family]
          @generalize-i |
            fix i: Element {
              @generalize-j |
                fix j: Element {
                  @generalize-x |
                    fix x: Element {
                      @generalize-y |
                        fix y: Element {
                          @generalize-z |
                            fix z: Element {
                              @given-i-not-j |
                                assume i != j {
                                  @given-x-not-y |
                                    assume x != y {
                                      @given-x-not-z |
                                        assume x != z {
                                          @given-y-not-z |
                                            assume y != z {
                                              @i-is-not-j |
                                                i != j
                                                [by hypothesis given-i-not-j]
                                              @x-is-not-y |
                                                x != y
                                                [by hypothesis given-x-not-y]
                                              @x-is-not-z |
                                                x != z
                                                [by hypothesis given-x-not-z]
                                              @y-is-not-z |
                                                y != z
                                                [by hypothesis given-y-not-z]
                                              @where-i-sits |
                                                x = i or y = i or z = i or (x != i and y != i and z != i)
                                                [using tautology]
                                              @where-j-sits |
                                                x = j or y = j or z = j or (x != j and y != j and z != j)
                                                [using tautology]
                                              @conclusion-by-position |
                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                case where-i-sits {
                                                  @when-x-is-i |
                                                    assume x = i {
                                                      @inner-split-x-is-i |
                                                        inN(compose(transposition(x, z), transposition(x, y)))
                                                        case where-j-sits {
                                                          @when-x-is-j |
                                                            assume x = j {
                                                              @x-is-i-clash |
                                                                x = i
                                                                [by hypothesis when-x-is-i]
                                                              @x-is-j-clash |
                                                                x = j
                                                                [by hypothesis when-x-is-j]
                                                              @i-is-x-clash |
                                                                i = x
                                                                [by symmetry x-is-i-clash]
                                                              @i-equals-j-clash |
                                                                i = j
                                                                [by rewrite i-is-x-clash x-is-j-clash]
                                                              @i-is-not-j-clash |
                                                                i != j
                                                                [by hypothesis given-i-not-j]
                                                              @conclusion-clash-at-x |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by ex_falso i-equals-j-clash i-is-not-j-clash]
                                                            }
                                                          @when-y-is-j |
                                                            assume y = j {
                                                              @x-is-i |
                                                                x = i
                                                                [by hypothesis when-x-is-i]
                                                              @y-is-j |
                                                                y = j
                                                                [by hypothesis when-y-is-j]
                                                              @z-is-not-x |
                                                                z != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, z) x-is-not-z]
                                                              @z-is-not-i |
                                                                z != i
                                                                [by rewrite x-is-i z-is-not-x]
                                                              @z-is-not-y |
                                                                z != y
                                                                [using specialize alternating.disequalityIsSymmetric(y, z) y-is-not-z]
                                                              @z-is-not-j |
                                                                z != j
                                                                [by rewrite y-is-j z-is-not-y]
                                                              @the-family-member |
                                                                inN(compose(transposition(i, z), transposition(i, j)))
                                                                [using specialize family(i, j, z) i-is-not-j z-is-not-i z-is-not-j]
                                                              @x-is-i-and-y-is-j-back-x |
                                                                inN(compose(transposition(x, z), transposition(x, j)))
                                                                [by rewrite x-is-i the-family-member]
                                                              @conclusion-x-is-i-and-y-is-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite y-is-j x-is-i-and-y-is-j-back-x]
                                                            }
                                                          @when-z-is-j |
                                                            assume z = j {
                                                              @x-is-i |
                                                                x = i
                                                                [by hypothesis when-x-is-i]
                                                              @i-is-not-y |
                                                                i != y
                                                                [by rewrite x-is-i x-is-not-y]
                                                              @z-is-j |
                                                                z = j
                                                                [by hypothesis when-z-is-j]
                                                              @z-is-not-y |
                                                                z != y
                                                                [using specialize alternating.disequalityIsSymmetric(y, z) y-is-not-z]
                                                              @j-is-not-y |
                                                                j != y
                                                                [by rewrite z-is-j z-is-not-y]
                                                              @y-is-not-i |
                                                                y != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, y) i-is-not-y]
                                                              @y-is-not-j |
                                                                y != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, y) j-is-not-y]
                                                              @family-at-y |
                                                                inN(compose(transposition(i, y), transposition(i, j)))
                                                                [using specialize family(i, j, y) i-is-not-j y-is-not-i y-is-not-j]
                                                              @x-is-i-and-z-is-j-shape |
                                                                forall i2, j2, a: Element;
                                                                  i2 != j2 -> i2 != a -> j2 != a ->
                                                                  inN(compose(transposition(i2, a), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(i2, j2), transposition(i2, a)))
                                                                [using instantiation aTwistOfAFamilyMemberIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(i, j), transposition(i, y)))
                                                                [using specialize x-is-i-and-z-is-j-shape(i, j, y) i-is-not-j i-is-not-y j-is-not-y family-at-y]
                                                              @x-is-i-and-z-is-j-back-x |
                                                                inN(compose(transposition(x, j), transposition(x, y)))
                                                                [by rewrite x-is-i the-shaped-member]
                                                              @conclusion-x-is-i-and-z-is-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite z-is-j x-is-i-and-z-is-j-back-x]
                                                            }
                                                          @when-no-j |
                                                            assume x != j and y != j and z != j {
                                                              @x-is-i |
                                                                x = i
                                                                [by hypothesis when-x-is-i]
                                                              @i-is-not-y |
                                                                i != y
                                                                [by rewrite x-is-i x-is-not-y]
                                                              @i-is-not-z |
                                                                i != z
                                                                [by rewrite x-is-i x-is-not-z]
                                                              @j-is-not-y |
                                                                j != y
                                                                [using specialize alternating.disequalityIsSymmetric(y, j) y-is-not-j]
                                                              @j-is-not-z |
                                                                j != z
                                                                [using specialize alternating.disequalityIsSymmetric(z, j) z-is-not-j]
                                                              @when-no-j-holds |
                                                                x != j and y != j and z != j
                                                                [by hypothesis when-no-j]
                                                              @y-is-not-j |
                                                                y != j
                                                                [using tautology when-no-j-holds]
                                                              @y-is-not-i |
                                                                y != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, y) i-is-not-y]
                                                              @family-at-y |
                                                                inN(compose(transposition(i, y), transposition(i, j)))
                                                                [using specialize family(i, j, y) i-is-not-j y-is-not-i y-is-not-j]
                                                              @z-is-not-j |
                                                                z != j
                                                                [using tautology when-no-j-holds]
                                                              @z-is-not-i |
                                                                z != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, z) i-is-not-z]
                                                              @family-at-z |
                                                                inN(compose(transposition(i, z), transposition(i, j)))
                                                                [using specialize family(i, j, z) i-is-not-j z-is-not-i z-is-not-j]
                                                              @x-is-i-and-no-j-shape |
                                                                forall i2, j2, a, b: Element;
                                                                  i2 != j2 -> i2 != a -> i2 != b -> j2 != a -> j2 != b -> a != b ->
                                                                  inN(compose(transposition(i2, a), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(i2, b), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(i2, b), transposition(i2, a)))
                                                                [using instantiation aThreeCycleOffTheFixedPairIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(i, z), transposition(i, y)))
                                                                [using specialize x-is-i-and-no-j-shape(i, j, y, z) i-is-not-j i-is-not-y i-is-not-z j-is-not-y j-is-not-z y-is-not-z family-at-y family-at-z]
                                                              @conclusion-x-is-i-and-no-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite x-is-i the-shaped-member]
                                                            }
                                                        }
                                                    }
                                                  @when-y-is-i |
                                                    assume y = i {
                                                      @inner-split-y-is-i |
                                                        inN(compose(transposition(x, z), transposition(x, y)))
                                                        case where-j-sits {
                                                          @when-x-is-j |
                                                            assume x = j {
                                                              @y-is-i |
                                                                y = i
                                                                [by hypothesis when-y-is-i]
                                                              @i-is-not-z |
                                                                i != z
                                                                [by rewrite y-is-i y-is-not-z]
                                                              @x-is-j |
                                                                x = j
                                                                [by hypothesis when-x-is-j]
                                                              @j-is-not-z |
                                                                j != z
                                                                [by rewrite x-is-j x-is-not-z]
                                                              @z-is-not-i |
                                                                z != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, z) i-is-not-z]
                                                              @z-is-not-j |
                                                                z != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, z) j-is-not-z]
                                                              @family-at-z |
                                                                inN(compose(transposition(i, z), transposition(i, j)))
                                                                [using specialize family(i, j, z) i-is-not-j z-is-not-i z-is-not-j]
                                                              @y-is-i-and-x-is-j-shape |
                                                                forall i2, j2, p: Element;
                                                                  i2 != j2 -> i2 != p -> j2 != p ->
                                                                  inN(compose(transposition(i2, p), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(j2, p), transposition(j2, i2)))
                                                                [using instantiation aTwistStartingAtTheSecondFixedPointIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(j, z), transposition(j, i)))
                                                                [using specialize y-is-i-and-x-is-j-shape(i, j, z) i-is-not-j i-is-not-z j-is-not-z family-at-z]
                                                              @y-is-i-and-x-is-j-back-y |
                                                                inN(compose(transposition(j, z), transposition(j, y)))
                                                                [by rewrite y-is-i the-shaped-member]
                                                              @conclusion-y-is-i-and-x-is-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite x-is-j y-is-i-and-x-is-j-back-y]
                                                            }
                                                          @when-y-is-j |
                                                            assume y = j {
                                                              @y-is-i-clash |
                                                                y = i
                                                                [by hypothesis when-y-is-i]
                                                              @y-is-j-clash |
                                                                y = j
                                                                [by hypothesis when-y-is-j]
                                                              @i-is-y-clash |
                                                                i = y
                                                                [by symmetry y-is-i-clash]
                                                              @i-equals-j-clash |
                                                                i = j
                                                                [by rewrite i-is-y-clash y-is-j-clash]
                                                              @i-is-not-j-clash |
                                                                i != j
                                                                [by hypothesis given-i-not-j]
                                                              @conclusion-clash-at-y |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by ex_falso i-equals-j-clash i-is-not-j-clash]
                                                            }
                                                          @when-z-is-j |
                                                            assume z = j {
                                                              @y-is-i |
                                                                y = i
                                                                [by hypothesis when-y-is-i]
                                                              @y-is-not-x |
                                                                y != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, y) x-is-not-y]
                                                              @i-is-not-x |
                                                                i != x
                                                                [by rewrite y-is-i y-is-not-x]
                                                              @z-is-j |
                                                                z = j
                                                                [by hypothesis when-z-is-j]
                                                              @z-is-not-x |
                                                                z != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, z) x-is-not-z]
                                                              @j-is-not-x |
                                                                j != x
                                                                [by rewrite z-is-j z-is-not-x]
                                                              @x-is-not-i |
                                                                x != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, x) i-is-not-x]
                                                              @x-is-not-j |
                                                                x != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, x) j-is-not-x]
                                                              @family-at-x |
                                                                inN(compose(transposition(i, x), transposition(i, j)))
                                                                [using specialize family(i, j, x) i-is-not-j x-is-not-i x-is-not-j]
                                                              @y-is-i-and-z-is-j-shape |
                                                                forall i2, j2, p: Element;
                                                                  i2 != j2 -> i2 != p -> j2 != p ->
                                                                  inN(compose(transposition(i2, p), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(p, j2), transposition(p, i2)))
                                                                [using instantiation aFamilyMemberEndingAtTheFixedPairIsInTheSubgroup((fun g: Fn => inN(g)))]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(x, j), transposition(x, i)))
                                                                [using specialize y-is-i-and-z-is-j-shape(i, j, x) i-is-not-j i-is-not-x j-is-not-x family-at-x]
                                                              @y-is-i-and-z-is-j-back-y |
                                                                inN(compose(transposition(x, j), transposition(x, y)))
                                                                [by rewrite y-is-i the-shaped-member]
                                                              @conclusion-y-is-i-and-z-is-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite z-is-j y-is-i-and-z-is-j-back-y]
                                                            }
                                                          @when-no-j |
                                                            assume x != j and y != j and z != j {
                                                              @y-is-i |
                                                                y = i
                                                                [by hypothesis when-y-is-i]
                                                              @y-is-not-x |
                                                                y != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, y) x-is-not-y]
                                                              @i-is-not-x |
                                                                i != x
                                                                [by rewrite y-is-i y-is-not-x]
                                                              @i-is-not-z |
                                                                i != z
                                                                [by rewrite y-is-i y-is-not-z]
                                                              @j-is-not-x |
                                                                j != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, j) x-is-not-j]
                                                              @j-is-not-z |
                                                                j != z
                                                                [using specialize alternating.disequalityIsSymmetric(z, j) z-is-not-j]
                                                              @when-no-j-holds |
                                                                x != j and y != j and z != j
                                                                [by hypothesis when-no-j]
                                                              @z-is-not-j |
                                                                z != j
                                                                [using tautology when-no-j-holds]
                                                              @z-is-not-i |
                                                                z != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, z) i-is-not-z]
                                                              @family-at-z |
                                                                inN(compose(transposition(i, z), transposition(i, j)))
                                                                [using specialize family(i, j, z) i-is-not-j z-is-not-i z-is-not-j]
                                                              @x-is-not-j |
                                                                x != j
                                                                [using tautology when-no-j-holds]
                                                              @x-is-not-i |
                                                                x != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, x) i-is-not-x]
                                                              @family-at-x |
                                                                inN(compose(transposition(i, x), transposition(i, j)))
                                                                [using specialize family(i, j, x) i-is-not-j x-is-not-i x-is-not-j]
                                                              @y-is-i-and-no-j-shape |
                                                                forall i2, j2, x2, z2: Element;
                                                                  i2 != j2 -> i2 != x2 -> i2 != z2 -> j2 != x2 -> j2 != z2 -> x2 != z2 ->
                                                                  inN(compose(transposition(i2, z2), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(i2, x2), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(x2, z2), transposition(x2, i2)))
                                                                [using instantiation aThreeCycleWithTheFirstFixedPointInTheMiddleIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(x, z), transposition(x, i)))
                                                                [using specialize y-is-i-and-no-j-shape(i, j, x, z) i-is-not-j i-is-not-x i-is-not-z j-is-not-x j-is-not-z x-is-not-z family-at-z family-at-x]
                                                              @conclusion-y-is-i-and-no-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite y-is-i the-shaped-member]
                                                            }
                                                        }
                                                    }
                                                  @when-z-is-i |
                                                    assume z = i {
                                                      @inner-split-z-is-i |
                                                        inN(compose(transposition(x, z), transposition(x, y)))
                                                        case where-j-sits {
                                                          @when-x-is-j |
                                                            assume x = j {
                                                              @z-is-i |
                                                                z = i
                                                                [by hypothesis when-z-is-i]
                                                              @z-is-not-y |
                                                                z != y
                                                                [using specialize alternating.disequalityIsSymmetric(y, z) y-is-not-z]
                                                              @i-is-not-y |
                                                                i != y
                                                                [by rewrite z-is-i z-is-not-y]
                                                              @x-is-j |
                                                                x = j
                                                                [by hypothesis when-x-is-j]
                                                              @j-is-not-y |
                                                                j != y
                                                                [by rewrite x-is-j x-is-not-y]
                                                              @y-is-not-i |
                                                                y != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, y) i-is-not-y]
                                                              @y-is-not-j |
                                                                y != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, y) j-is-not-y]
                                                              @family-at-y |
                                                                inN(compose(transposition(i, y), transposition(i, j)))
                                                                [using specialize family(i, j, y) i-is-not-j y-is-not-i y-is-not-j]
                                                              @z-is-i-and-x-is-j-shape |
                                                                forall i2, j2, p: Element;
                                                                  i2 != j2 -> i2 != p -> j2 != p ->
                                                                  inN(compose(transposition(i2, p), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(j2, i2), transposition(j2, p)))
                                                                [using instantiation aFamilyMemberStartingAtTheSecondFixedPointIsInTheSubgroup((fun g: Fn => inN(g)))]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(j, i), transposition(j, y)))
                                                                [using specialize z-is-i-and-x-is-j-shape(i, j, y) i-is-not-j i-is-not-y j-is-not-y family-at-y]
                                                              @z-is-i-and-x-is-j-back-z |
                                                                inN(compose(transposition(j, z), transposition(j, y)))
                                                                [by rewrite z-is-i the-shaped-member]
                                                              @conclusion-z-is-i-and-x-is-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite x-is-j z-is-i-and-x-is-j-back-z]
                                                            }
                                                          @when-y-is-j |
                                                            assume y = j {
                                                              @z-is-i |
                                                                z = i
                                                                [by hypothesis when-z-is-i]
                                                              @z-is-not-x |
                                                                z != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, z) x-is-not-z]
                                                              @i-is-not-x |
                                                                i != x
                                                                [by rewrite z-is-i z-is-not-x]
                                                              @y-is-j |
                                                                y = j
                                                                [by hypothesis when-y-is-j]
                                                              @y-is-not-x |
                                                                y != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, y) x-is-not-y]
                                                              @j-is-not-x |
                                                                j != x
                                                                [by rewrite y-is-j y-is-not-x]
                                                              @x-is-not-i |
                                                                x != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, x) i-is-not-x]
                                                              @x-is-not-j |
                                                                x != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, x) j-is-not-x]
                                                              @family-at-x |
                                                                inN(compose(transposition(i, x), transposition(i, j)))
                                                                [using specialize family(i, j, x) i-is-not-j x-is-not-i x-is-not-j]
                                                              @z-is-i-and-y-is-j-shape |
                                                                forall i2, j2, p: Element;
                                                                  i2 != j2 -> i2 != p -> j2 != p ->
                                                                  inN(compose(transposition(i2, p), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(p, i2), transposition(p, j2)))
                                                                [using instantiation aTwistStartingOffTheFixedPairIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(x, i), transposition(x, j)))
                                                                [using specialize z-is-i-and-y-is-j-shape(i, j, x) i-is-not-j i-is-not-x j-is-not-x family-at-x]
                                                              @z-is-i-and-y-is-j-back-z |
                                                                inN(compose(transposition(x, z), transposition(x, j)))
                                                                [by rewrite z-is-i the-shaped-member]
                                                              @conclusion-z-is-i-and-y-is-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite y-is-j z-is-i-and-y-is-j-back-z]
                                                            }
                                                          @when-z-is-j |
                                                            assume z = j {
                                                              @z-is-i-clash |
                                                                z = i
                                                                [by hypothesis when-z-is-i]
                                                              @z-is-j-clash |
                                                                z = j
                                                                [by hypothesis when-z-is-j]
                                                              @i-is-z-clash |
                                                                i = z
                                                                [by symmetry z-is-i-clash]
                                                              @i-equals-j-clash |
                                                                i = j
                                                                [by rewrite i-is-z-clash z-is-j-clash]
                                                              @i-is-not-j-clash |
                                                                i != j
                                                                [by hypothesis given-i-not-j]
                                                              @conclusion-clash-at-z |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by ex_falso i-equals-j-clash i-is-not-j-clash]
                                                            }
                                                          @when-no-j |
                                                            assume x != j and y != j and z != j {
                                                              @z-is-i |
                                                                z = i
                                                                [by hypothesis when-z-is-i]
                                                              @z-is-not-x |
                                                                z != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, z) x-is-not-z]
                                                              @i-is-not-x |
                                                                i != x
                                                                [by rewrite z-is-i z-is-not-x]
                                                              @z-is-not-y |
                                                                z != y
                                                                [using specialize alternating.disequalityIsSymmetric(y, z) y-is-not-z]
                                                              @i-is-not-y |
                                                                i != y
                                                                [by rewrite z-is-i z-is-not-y]
                                                              @j-is-not-x |
                                                                j != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, j) x-is-not-j]
                                                              @j-is-not-y |
                                                                j != y
                                                                [using specialize alternating.disequalityIsSymmetric(y, j) y-is-not-j]
                                                              @when-no-j-holds |
                                                                x != j and y != j and z != j
                                                                [by hypothesis when-no-j]
                                                              @x-is-not-j |
                                                                x != j
                                                                [using tautology when-no-j-holds]
                                                              @x-is-not-i |
                                                                x != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, x) i-is-not-x]
                                                              @family-at-x |
                                                                inN(compose(transposition(i, x), transposition(i, j)))
                                                                [using specialize family(i, j, x) i-is-not-j x-is-not-i x-is-not-j]
                                                              @y-is-not-j |
                                                                y != j
                                                                [using tautology when-no-j-holds]
                                                              @y-is-not-i |
                                                                y != i
                                                                [using specialize alternating.disequalityIsSymmetric(i, y) i-is-not-y]
                                                              @family-at-y |
                                                                inN(compose(transposition(i, y), transposition(i, j)))
                                                                [using specialize family(i, j, y) i-is-not-j y-is-not-i y-is-not-j]
                                                              @z-is-i-and-no-j-shape |
                                                                forall i2, j2, p, q: Element;
                                                                  i2 != j2 -> i2 != p -> i2 != q -> j2 != p -> j2 != q -> p != q ->
                                                                  inN(compose(transposition(i2, p), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(i2, q), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(p, i2), transposition(p, q)))
                                                                [using instantiation aThreeCycleEndingAtTheFirstFixedPointIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(x, i), transposition(x, y)))
                                                                [using specialize z-is-i-and-no-j-shape(i, j, x, y) i-is-not-j i-is-not-x i-is-not-y j-is-not-x j-is-not-y x-is-not-y family-at-x family-at-y]
                                                              @conclusion-z-is-i-and-no-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite z-is-i the-shaped-member]
                                                            }
                                                        }
                                                    }
                                                  @when-no-i |
                                                    assume x != i and y != i and z != i {
                                                      @inner-split-no-i |
                                                        inN(compose(transposition(x, z), transposition(x, y)))
                                                        case where-j-sits {
                                                          @when-x-is-j |
                                                            assume x = j {
                                                              @i-is-not-y |
                                                                i != y
                                                                [using specialize alternating.disequalityIsSymmetric(y, i) y-is-not-i]
                                                              @i-is-not-z |
                                                                i != z
                                                                [using specialize alternating.disequalityIsSymmetric(z, i) z-is-not-i]
                                                              @x-is-j |
                                                                x = j
                                                                [by hypothesis when-x-is-j]
                                                              @j-is-not-y |
                                                                j != y
                                                                [by rewrite x-is-j x-is-not-y]
                                                              @j-is-not-z |
                                                                j != z
                                                                [by rewrite x-is-j x-is-not-z]
                                                              @when-no-i-holds |
                                                                x != i and y != i and z != i
                                                                [by hypothesis when-no-i]
                                                              @y-is-not-i |
                                                                y != i
                                                                [using tautology when-no-i-holds]
                                                              @y-is-not-j |
                                                                y != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, y) j-is-not-y]
                                                              @family-at-y |
                                                                inN(compose(transposition(i, y), transposition(i, j)))
                                                                [using specialize family(i, j, y) i-is-not-j y-is-not-i y-is-not-j]
                                                              @z-is-not-i |
                                                                z != i
                                                                [using tautology when-no-i-holds]
                                                              @z-is-not-j |
                                                                z != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, z) j-is-not-z]
                                                              @family-at-z |
                                                                inN(compose(transposition(i, z), transposition(i, j)))
                                                                [using specialize family(i, j, z) i-is-not-j z-is-not-i z-is-not-j]
                                                              @no-i-and-x-is-j-shape |
                                                                forall i2, j2, a, b: Element;
                                                                  i2 != j2 -> i2 != a -> i2 != b -> j2 != a -> j2 != b -> a != b ->
                                                                  inN(compose(transposition(i2, a), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(i2, b), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(j2, b), transposition(j2, a)))
                                                                [using instantiation aThreeCycleThroughTheSecondFixedPointIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(j, z), transposition(j, y)))
                                                                [using specialize no-i-and-x-is-j-shape(i, j, y, z) i-is-not-j i-is-not-y i-is-not-z j-is-not-y j-is-not-z y-is-not-z family-at-y family-at-z]
                                                              @conclusion-no-i-and-x-is-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite x-is-j the-shaped-member]
                                                            }
                                                          @when-y-is-j |
                                                            assume y = j {
                                                              @i-is-not-x |
                                                                i != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, i) x-is-not-i]
                                                              @i-is-not-z |
                                                                i != z
                                                                [using specialize alternating.disequalityIsSymmetric(z, i) z-is-not-i]
                                                              @y-is-j |
                                                                y = j
                                                                [by hypothesis when-y-is-j]
                                                              @y-is-not-x |
                                                                y != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, y) x-is-not-y]
                                                              @j-is-not-x |
                                                                j != x
                                                                [by rewrite y-is-j y-is-not-x]
                                                              @j-is-not-z |
                                                                j != z
                                                                [by rewrite y-is-j y-is-not-z]
                                                              @when-no-i-holds |
                                                                x != i and y != i and z != i
                                                                [by hypothesis when-no-i]
                                                              @z-is-not-i |
                                                                z != i
                                                                [using tautology when-no-i-holds]
                                                              @z-is-not-j |
                                                                z != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, z) j-is-not-z]
                                                              @family-at-z |
                                                                inN(compose(transposition(i, z), transposition(i, j)))
                                                                [using specialize family(i, j, z) i-is-not-j z-is-not-i z-is-not-j]
                                                              @x-is-not-i |
                                                                x != i
                                                                [using tautology when-no-i-holds]
                                                              @x-is-not-j |
                                                                x != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, x) j-is-not-x]
                                                              @family-at-x |
                                                                inN(compose(transposition(i, x), transposition(i, j)))
                                                                [using specialize family(i, j, x) i-is-not-j x-is-not-i x-is-not-j]
                                                              @no-i-and-y-is-j-shape |
                                                                forall i2, j2, p, q: Element;
                                                                  i2 != j2 -> i2 != p -> i2 != q -> j2 != p -> j2 != q -> p != q ->
                                                                  inN(compose(transposition(i2, q), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(i2, p), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(p, q), transposition(p, j2)))
                                                                [using instantiation aThreeCycleWithTheSecondFixedPointInTheMiddleIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(x, z), transposition(x, j)))
                                                                [using specialize no-i-and-y-is-j-shape(i, j, x, z) i-is-not-j i-is-not-x i-is-not-z j-is-not-x j-is-not-z x-is-not-z family-at-z family-at-x]
                                                              @conclusion-no-i-and-y-is-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite y-is-j the-shaped-member]
                                                            }
                                                          @when-z-is-j |
                                                            assume z = j {
                                                              @i-is-not-x |
                                                                i != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, i) x-is-not-i]
                                                              @i-is-not-y |
                                                                i != y
                                                                [using specialize alternating.disequalityIsSymmetric(y, i) y-is-not-i]
                                                              @z-is-j |
                                                                z = j
                                                                [by hypothesis when-z-is-j]
                                                              @z-is-not-x |
                                                                z != x
                                                                [using specialize alternating.disequalityIsSymmetric(x, z) x-is-not-z]
                                                              @j-is-not-x |
                                                                j != x
                                                                [by rewrite z-is-j z-is-not-x]
                                                              @z-is-not-y |
                                                                z != y
                                                                [using specialize alternating.disequalityIsSymmetric(y, z) y-is-not-z]
                                                              @j-is-not-y |
                                                                j != y
                                                                [by rewrite z-is-j z-is-not-y]
                                                              @when-no-i-holds |
                                                                x != i and y != i and z != i
                                                                [by hypothesis when-no-i]
                                                              @x-is-not-i |
                                                                x != i
                                                                [using tautology when-no-i-holds]
                                                              @x-is-not-j |
                                                                x != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, x) j-is-not-x]
                                                              @family-at-x |
                                                                inN(compose(transposition(i, x), transposition(i, j)))
                                                                [using specialize family(i, j, x) i-is-not-j x-is-not-i x-is-not-j]
                                                              @y-is-not-i |
                                                                y != i
                                                                [using tautology when-no-i-holds]
                                                              @y-is-not-j |
                                                                y != j
                                                                [using specialize alternating.disequalityIsSymmetric(j, y) j-is-not-y]
                                                              @family-at-y |
                                                                inN(compose(transposition(i, y), transposition(i, j)))
                                                                [using specialize family(i, j, y) i-is-not-j y-is-not-i y-is-not-j]
                                                              @no-i-and-z-is-j-shape |
                                                                forall i2, j2, p, q: Element;
                                                                  i2 != j2 -> i2 != p -> i2 != q -> j2 != p -> j2 != q -> p != q ->
                                                                  inN(compose(transposition(i2, p), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(i2, q), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(p, j2), transposition(p, q)))
                                                                [using instantiation aThreeCycleEndingAtTheSecondFixedPointIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(x, j), transposition(x, y)))
                                                                [using specialize no-i-and-z-is-j-shape(i, j, x, y) i-is-not-j i-is-not-x i-is-not-y j-is-not-x j-is-not-y x-is-not-y family-at-x family-at-y]
                                                              @conclusion-no-i-and-z-is-j |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [by rewrite z-is-j the-shaped-member]
                                                            }
                                                          @when-no-j |
                                                            assume x != j and y != j and z != j {
                                                              @when-no-i-holds |
                                                                x != i and y != i and z != i
                                                                [by hypothesis when-no-i]
                                                              @x-is-not-i |
                                                                x != i
                                                                [using tautology when-no-i-holds]
                                                              @y-is-not-i |
                                                                y != i
                                                                [using tautology when-no-i-holds]
                                                              @z-is-not-i |
                                                                z != i
                                                                [using tautology when-no-i-holds]
                                                              @when-no-j-holds |
                                                                x != j and y != j and z != j
                                                                [by hypothesis when-no-j]
                                                              @x-is-not-j |
                                                                x != j
                                                                [using tautology when-no-j-holds]
                                                              @y-is-not-j |
                                                                y != j
                                                                [using tautology when-no-j-holds]
                                                              @z-is-not-j |
                                                                z != j
                                                                [using tautology when-no-j-holds]
                                                              @family-at-x |
                                                                inN(compose(transposition(i, x), transposition(i, j)))
                                                                [using specialize family(i, j, x) i-is-not-j x-is-not-i x-is-not-j]
                                                              @family-at-y |
                                                                inN(compose(transposition(i, y), transposition(i, j)))
                                                                [using specialize family(i, j, y) i-is-not-j y-is-not-i y-is-not-j]
                                                              @family-at-z |
                                                                inN(compose(transposition(i, z), transposition(i, j)))
                                                                [using specialize family(i, j, z) i-is-not-j z-is-not-i z-is-not-j]
                                                              @no-i-and-no-j-shape |
                                                                forall i2, j2, x2, y2, z2: Element;
                                                                  i2 != j2 -> x2 != y2 -> x2 != z2 -> y2 != z2 ->
                                                                  x2 != i2 -> y2 != i2 -> z2 != i2 -> x2 != j2 -> y2 != j2 -> z2 != j2 ->
                                                                  inN(compose(transposition(i2, x2), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(i2, y2), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(i2, z2), transposition(i2, j2))) ->
                                                                  inN(compose(transposition(x2, z2), transposition(x2, y2)))
                                                                [using instantiation aThreeCycleDisjointFromTheFixedPairIsInTheSubgroup((fun g: Fn => inN(g))) closure]
                                                              @the-shaped-member |
                                                                inN(compose(transposition(x, z), transposition(x, y)))
                                                                [using specialize no-i-and-no-j-shape(i, j, x, y, z) i-is-not-j x-is-not-y x-is-not-z y-is-not-z x-is-not-i y-is-not-i z-is-not-i x-is-not-j y-is-not-j z-is-not-j family-at-x family-at-y family-at-z]
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                          @y-not-z-implies |
                                            y != z ->
                                              inN(compose(transposition(x, z), transposition(x, y)))
                                            [by discharge given-y-not-z]
                                        }
                                      @x-not-z-implies |
                                        x != z -> y != z ->
                                          inN(compose(transposition(x, z), transposition(x, y)))
                                        [by discharge given-x-not-z]
                                    }
                                  @x-not-y-implies |
                                    x != y -> x != z -> y != z ->
                                      inN(compose(transposition(x, z), transposition(x, y)))
                                    [by discharge given-x-not-y]
                                }
                              @i-not-j-implies |
                                i != j -> x != y -> x != z -> y != z ->
                                  inN(compose(transposition(x, z), transposition(x, y)))
                                [by discharge given-i-not-j]
                            }
                          @discharge-z |
                            forall z: Element; i != j -> x != y -> x != z -> y != z ->
                              inN(compose(transposition(x, z), transposition(x, y)))
                            [by generalize generalize-z]
                        }
                      @discharge-y |
                        forall y, z: Element; i != j -> x != y -> x != z -> y != z ->
                          inN(compose(transposition(x, z), transposition(x, y)))
                        [by generalize generalize-y]
                    }
                  @discharge-x |
                    forall x, y, z: Element; i != j -> x != y -> x != z -> y != z ->
                      inN(compose(transposition(x, z), transposition(x, y)))
                    [by generalize generalize-x]
                }
              @discharge-j |
                forall j, x, y, z: Element; i != j -> x != y -> x != z -> y != z ->
                  inN(compose(transposition(x, z), transposition(x, y)))
                [by generalize generalize-j]
            }
          @all-triples |
            forall i, j, x, y, z: Element; i != j -> x != y -> x != z -> y != z ->
              inN(compose(transposition(x, z), transposition(x, y)))
            [by generalize generalize-i]
        }
      @family-implies |
        (forall i2, j2, k: Element; i2 != j2 -> k != i2 -> k != j2 ->
          inN(compose(transposition(i2, k), transposition(i2, j2)))) ->
          forall i, j, x, y, z: Element; i != j -> x != y -> x != z -> y != z ->
          inN(compose(transposition(x, z), transposition(x, y)))
        [by discharge given-family]
    }
  @conclusion |
    (forall g, h: Fn; inN(g) -> inN(h) -> inN(compose(g, h))) ->
      (forall i2, j2, k: Element; i2 != j2 -> k != i2 -> k != j2 ->
      inN(compose(transposition(i2, k), transposition(i2, j2)))) ->
      forall i, j, x, y, z: Element; i != j -> x != y -> x != z -> y != z ->
      inN(compose(transposition(x, z), transposition(x, y)))
    [by discharge given-closure]
qed

// The assembled selector exercised at N = A_n.
theorem theAlternatingGroupHasEveryTriplesThreeCycle:
  (forall i2, j2, k: Element; i2 != j2 -> k != i2 -> k != j2 ->
  alternating.inAlternating(compose(transposition(i2, k), transposition(i2, j2)))) ->
  forall i, j, x, y, z: Element;
  i != j -> x != y -> x != z -> y != z ->
  alternating.inAlternating(compose(transposition(x, z), transposition(x, y)))
proof
  @the-alternating-group-is-closed |
    forall g, h: Fn; alternating.inAlternating(g) -> alternating.inAlternating(h) ->
      alternating.inAlternating(compose(g, h))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    (forall i2, j2, k: Element; i2 != j2 -> k != i2 -> k != j2 ->
      alternating.inAlternating(compose(transposition(i2, k), transposition(i2, j2)))) ->
      forall i, j, x, y, z: Element;
      i != j -> x != y -> x != z -> y != z ->
      alternating.inAlternating(compose(transposition(x, z), transposition(x, y)))
    [using instantiation everyThreeCycleIsInANormalSubgroupWithTheFamily((fun g: Fn => alternating.inAlternating(g))) the-alternating-group-is-closed]
qed
