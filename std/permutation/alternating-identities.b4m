// Judson's Lemma 10.2 identities — every 3-cycle in terms of a FIXED pair (i,j).
//
// Lemma 2 of §10.2 ("if a normal subgroup of A_n contains a 3-cycle, it is all of A_n")
// turns on rewriting an ARBITRARY 3-cycle as a product of 3-cycles of the single family
// `(i,j,k)` with i and j fixed and k varying. Judson gives four identities:
//
//     (i,a,j) = (i,j,a)^2
//     (i,a,b) = (i,j,b)(i,j,a)^2
//     (j,a,b) = (i,j,b)^2(i,j,a)
//     (a,b,c) = (i,j,a)^2(i,j,c)(i,j,b)^2(i,j,a)
//
// Each is proved the same way, and it is worth stating the method once because every proof
// below is an instance of it:
//
//   1. A 3-CYCLE IS TWO TRANSPOSITIONS. std's cycle fold gives
//      `cycle(s,3) = (a0 a2) o (a0 a1) o ((a0 a0) o id)`, so `(x,y,z)` is
//      `compose(transposition(x, z), transposition(x, y))` — see
//      `aThreeCycleIsTwoTranspositions` in alternating.b4m. Both sides of every identity
//      are therefore `compose`-trees of transpositions, and the right-hand sides run from
//      four factors up to TWELVE (six 3-cycles) for the last identity.
//   2. UNFOLD WITH THE ACCELERANT, not a helper. `[using simplify composeApply]` turns a
//      composite applied at a point into a nested `apply`, for any length and any nesting.
//      (An earlier draft hand-wrote `twoFactorValue`/`fourFactorValue`/`sixFactorValue`;
//      they were one fact — `composeApply` — restated per shape, and a treadmill. Deleted.)
//   3. EVALUATE FACTOR BY FACTOR with `transpositionAtFirst` / `AtSecond` / `Elsewhere`.
//   4. CASE SPLIT on where the point sits (each named letter, then "elsewhere"), and close
//      with `funcExtensionality`.
//
// Two toolchain facts this file depends on: `chain` is the orientation-free joiner (plain
// `simplify` cannot close these — it orients each equation left-to-right and the middle
// step must run backward), and `chain` REJECTS a repeated ref, so a value that recurs is
// stated once. `tautology` sees `a != c` and `c != a` as unrelated atoms, hence
// `disequalityIsSymmetric` from alternating.b4m.
//
// Every identity here was first verified COMPUTATIONALLY over the relevant points before
// any proof was written; that check caught a mis-trace in §10.2's Lemma 1 work.
import permutation <<< "std/permutation.b4m"
import function <<< "std/function.b4m"
import alternating <<< "std/permutation/alternating.b4m"

sort Element = permutation.Element
sort Fn = permutation.Fn

func compose = permutation.compose
func apply = permutation.apply
func transposition = permutation.transposition

axiom composeApply = function.composeApply
axiom funcExtensionality = function.funcExtensionality
theorem transpositionAtFirst = permutation.transpositionAtFirst
theorem transpositionAtSecond = permutation.transpositionAtSecond
theorem transpositionElsewhere = permutation.transpositionElsewhere
theorem disequalityIsSymmetric = alternating.disequalityIsSymmetric

// -- identity (1): (i,a,j) = (i,j,a)^2 -----------------------------------------------------

theorem squareAgreesAtI: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, j), transposition(i, a)), i) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @a-not-i |
                            a != i
                            [using specialize disequalityIsSymmetric(i, a) i-not-a]
                          @a-not-j |
                            a != j
                            [using specialize disequalityIsSymmetric(j, a) j-not-a]
                          @j-not-i |
                            j != i
                            [using specialize disequalityIsSymmetric(i, j) i-not-j]
                          @ia-sends-i |
                            apply(transposition(i, a), i) = a
                            [using specialize transpositionAtFirst(i, a)]
                          @ij-sends-i |
                            apply(transposition(i, j), i) = j
                            [using specialize transpositionAtFirst(i, j)]
                          @ij-fixes-a |
                            apply(transposition(i, j), a) = a
                            [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                          @ia-fixes-j |
                            apply(transposition(i, a), j) = j
                            [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                          @ij-sends-j |
                            apply(transposition(i, j), j) = i
                            [using specialize transpositionAtSecond(i, j)]
                          @lhs-split |
                            apply(compose(transposition(i, j), transposition(i, a)), i) = apply(transposition(i, j), apply(transposition(i, a), i))
                            [using simplify composeApply]
                          @lhs-value |
                            apply(compose(transposition(i, j), transposition(i, a)), i) = a
                            [using chain lhs-split ia-sends-i ij-fixes-a]
                          @rhs-split |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i) =
                              apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), i))))
                            [using simplify composeApply]
                          @rhs-value |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i) = a
                            [using chain rhs-split ij-sends-i ia-fixes-j ij-sends-j ia-sends-i]
                          @conclusion-agree |
                            apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                            [using chain lhs-value rhs-value]
                        }
                      @conclusion-j-not-a |
                        j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                    [by implies_intro given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                [by implies_intro given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
    [by forall_intro generalize-i]
qed

theorem squareAgreesAtA: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, j), transposition(i, a)), a) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @a-not-i |
                            a != i
                            [using specialize disequalityIsSymmetric(i, a) i-not-a]
                          @a-not-j |
                            a != j
                            [using specialize disequalityIsSymmetric(j, a) j-not-a]
                          @j-not-i |
                            j != i
                            [using specialize disequalityIsSymmetric(i, j) i-not-j]
                          @ia-sends-a |
                            apply(transposition(i, a), a) = i
                            [using specialize transpositionAtSecond(i, a)]
                          @ij-sends-i |
                            apply(transposition(i, j), i) = j
                            [using specialize transpositionAtFirst(i, j)]
                          @ij-fixes-a |
                            apply(transposition(i, j), a) = a
                            [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                          @ia-fixes-j |
                            apply(transposition(i, a), j) = j
                            [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                          @lhs-split |
                            apply(compose(transposition(i, j), transposition(i, a)), a) = apply(transposition(i, j), apply(transposition(i, a), a))
                            [using simplify composeApply]
                          @lhs-value |
                            apply(compose(transposition(i, j), transposition(i, a)), a) = j
                            [using chain lhs-split ia-sends-a ij-sends-i]
                          @rhs-split |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a) =
                              apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), a))))
                            [using simplify composeApply]
                          @rhs-value |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a) = j
                            [using chain rhs-split ij-fixes-a ia-sends-a ij-sends-i ia-fixes-j]
                          @conclusion-agree |
                            apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                            [using chain lhs-value rhs-value]
                        }
                      @conclusion-j-not-a |
                        j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                    [by implies_intro given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                [by implies_intro given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
    [by forall_intro generalize-i]
qed

theorem squareAgreesAtJ: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, j), transposition(i, a)), j) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @a-not-i |
                            a != i
                            [using specialize disequalityIsSymmetric(i, a) i-not-a]
                          @a-not-j |
                            a != j
                            [using specialize disequalityIsSymmetric(j, a) j-not-a]
                          @j-not-i |
                            j != i
                            [using specialize disequalityIsSymmetric(i, j) i-not-j]
                          @ia-fixes-j |
                            apply(transposition(i, a), j) = j
                            [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                          @ij-sends-j |
                            apply(transposition(i, j), j) = i
                            [using specialize transpositionAtSecond(i, j)]
                          @ia-sends-i |
                            apply(transposition(i, a), i) = a
                            [using specialize transpositionAtFirst(i, a)]
                          @ij-fixes-a |
                            apply(transposition(i, j), a) = a
                            [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                          @ia-sends-a |
                            apply(transposition(i, a), a) = i
                            [using specialize transpositionAtSecond(i, a)]
                          @lhs-split |
                            apply(compose(transposition(i, j), transposition(i, a)), j) = apply(transposition(i, j), apply(transposition(i, a), j))
                            [using simplify composeApply]
                          @lhs-value |
                            apply(compose(transposition(i, j), transposition(i, a)), j) = i
                            [using chain lhs-split ia-fixes-j ij-sends-j]
                          @rhs-split |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j) =
                              apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), j))))
                            [using simplify composeApply]
                          @rhs-value |
                            apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j) = i
                            [using chain rhs-split ij-sends-j ia-sends-i ij-fixes-a ia-sends-a]
                          @conclusion-agree |
                            apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                            [using chain lhs-value rhs-value]
                        }
                      @conclusion-j-not-a |
                        j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                    [by implies_intro given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                [by implies_intro given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
    [by forall_intro generalize-i]
qed

theorem squareAgreesAtElsewhere: forall i, j, a, x: Element;
  x != i -> x != j -> x != a ->
  apply(compose(transposition(i, j), transposition(i, a)), x) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-x |
                fix x: Element {
                  @given-x-not-i |
                    assume x != i {
                      @given-x-not-j |
                        assume x != j {
                          @given-x-not-a |
                            assume x != a {
                              @x-not-i |
                                x != i
                                [by hypothesis given-x-not-i]
                              @x-not-j |
                                x != j
                                [by hypothesis given-x-not-j]
                              @x-not-a |
                                x != a
                                [by hypothesis given-x-not-a]
                              @ij-fixes-x |
                                apply(transposition(i, j), x) = x
                                [using specialize transpositionElsewhere(i, j, x) x-not-i x-not-j]
                              @ia-fixes-x |
                                apply(transposition(i, a), x) = x
                                [using specialize transpositionElsewhere(i, a, x) x-not-i x-not-a]
                              @lhs-split |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = apply(transposition(i, j), apply(transposition(i, a), x))
                                [using simplify composeApply]
                              @lhs-value |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = x
                                [using chain lhs-split ia-fixes-x ij-fixes-x]
                              @rhs-split |
                                apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x) =
                                  apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), x))))
                                [using simplify composeApply]
                              @rhs-value |
                                apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x) = x
                                [using chain rhs-split ij-fixes-x ia-fixes-x]
                              @conclusion-agree |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-x-not-a |
                            x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                            [by implies_intro given-x-not-a]
                        }
                      @conclusion-x-not-j |
                        x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                        [by implies_intro given-x-not-j]
                    }
                  @conclusion-x-not-i |
                    x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                    [by implies_intro given-x-not-i]
                }
              @discharge-x |
                forall x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                [by forall_intro generalize-x]
            }
          @discharge-a |
            forall a, x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, x: Element; x != i -> x != j -> x != a -> apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
    [by forall_intro generalize-i]
qed

// The pointwise agreement behind identity (1): four cases on where x sits.
theorem theSquareAgreesEverywhere: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  forall x: Element;
  apply(compose(transposition(i, j), transposition(i, a)), x) =
  apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @generalize-x |
                            fix x: Element {
                              @cases |
                                x = i or x = j or x = a or (x != i and x != j and x != a)
                                [using tautology]
                              @conclusion-at-x |
                                apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                case cases {
                                  @when-x-is-i |
                                    assume x = i {
                                      @x-is-i |
                                        x = i
                                        [by hypothesis when-x-is-i]
                                      @agree-at-i |
                                        apply(compose(transposition(i, j), transposition(i, a)), i) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), i)
                                        [using specialize squareAgreesAtI(i, j, a) i-not-j i-not-a j-not-a]
                                      @conclusion-when-x-is-i |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [by rewrite x-is-i agree-at-i]
                                    }
                                  @when-x-is-j |
                                    assume x = j {
                                      @x-is-j |
                                        x = j
                                        [by hypothesis when-x-is-j]
                                      @agree-at-j |
                                        apply(compose(transposition(i, j), transposition(i, a)), j) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), j)
                                        [using specialize squareAgreesAtJ(i, j, a) i-not-j i-not-a j-not-a]
                                      @conclusion-when-x-is-j |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [by rewrite x-is-j agree-at-j]
                                    }
                                  @when-x-is-a |
                                    assume x = a {
                                      @x-is-a |
                                        x = a
                                        [by hypothesis when-x-is-a]
                                      @agree-at-a |
                                        apply(compose(transposition(i, j), transposition(i, a)), a) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), a)
                                        [using specialize squareAgreesAtA(i, j, a) i-not-j i-not-a j-not-a]
                                      @conclusion-when-x-is-a |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [by rewrite x-is-a agree-at-a]
                                    }
                                  @when-x-is-elsewhere |
                                    assume x != i and x != j and x != a {
                                      @x-is-elsewhere |
                                        x != i and x != j and x != a
                                        [by hypothesis when-x-is-elsewhere]
                                      @x-not-i |
                                        x != i
                                        [using tautology x-is-elsewhere]
                                      @x-not-j |
                                        x != j
                                        [using tautology x-is-elsewhere]
                                      @x-not-a |
                                        x != a
                                        [using tautology x-is-elsewhere]
                                      @conclusion-when-x-is-elsewhere |
                                        apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                                        [using specialize squareAgreesAtElsewhere(i, j, a, x) x-not-i x-not-j x-not-a]
                                    }
                                }
                            }
                          @discharge-x |
                            forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                            [by forall_intro generalize-x]
                        }
                      @conclusion-j-not-a |
                        j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                    [by implies_intro given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                [by implies_intro given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a -> forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
    [by forall_intro generalize-i]
qed

// Judson Lemma 2, identity (1): (i,a,j) = (i,j,a)^2.
theorem aThreeCycleIsTheSquareOfItsTwist: forall i, j, a: Element;
  i != j -> i != a -> j != a ->
  compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @given-i-not-j |
                assume i != j {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @i-not-j |
                            i != j
                            [by hypothesis given-i-not-j]
                          @i-not-a |
                            i != a
                            [by hypothesis given-i-not-a]
                          @j-not-a |
                            j != a
                            [by hypothesis given-j-not-a]
                          @agree-everywhere |
                            forall x: Element; apply(compose(transposition(i, j), transposition(i, a)), x) = apply(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), x)
                            [using specialize theSquareAgreesEverywhere(i, j, a) i-not-j i-not-a j-not-a]
                          @conclusion-equal |
                            compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                            [using specialize funcExtensionality(compose(transposition(i, j), transposition(i, a)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))) agree-everywhere]
                        }
                      @conclusion-j-not-a |
                        j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                    [by implies_intro given-i-not-a]
                }
              @conclusion-i-not-j |
                i != j -> i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
                [by implies_intro given-i-not-j]
            }
          @discharge-a |
            forall a: Element; i != j -> i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a: Element; i != j -> i != a -> j != a -> compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a: Element; i != j -> i != a -> j != a ->
      compose(transposition(i, j), transposition(i, a)) = compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))
    [by forall_intro generalize-i]
qed

// -- identity (2): (i,a,b) = (i,j,b)(i,j,a)^2 ----------------------------------------------
//
// As transposition trees, with the rightmost factor applied first:
//     LHS  (i,a,b)            = (ib)(ia)
//     RHS  (i,j,b)(i,j,a)^2   = (ib)(ij) · (ia)(ij) · (ia)(ij)
// Six factors on the right, four letters, so five point-cases.

// at i: LHS (ia) sends i to a and (ib) fixes a.
//       RHS (ij): i->j, (ia) fixes j, (ij): j->i, (ia): i->a, then (ij) and (ib) fix a.
theorem secondIdentityAgreesAtI: forall i, j, a, b: Element;
  i != j -> i != a -> j != a -> a != b ->
  apply(compose(transposition(i, b), transposition(i, a)), i) =
  apply(compose(compose(transposition(i, b), transposition(i, j)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))), i)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-j-not-a |
                            assume j != a {
                              @given-a-not-b |
                                assume a != b {
                                  @i-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @i-not-a |
                                    i != a
                                    [by hypothesis given-i-not-a]
                                  @j-not-a |
                                    j != a
                                    [by hypothesis given-j-not-a]
                                  @a-not-b |
                                    a != b
                                    [by hypothesis given-a-not-b]
                                  @j-not-i |
                                    j != i
                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                  @a-not-i |
                                    a != i
                                    [using specialize disequalityIsSymmetric(i, a) i-not-a]
                                  @a-not-j |
                                    a != j
                                    [using specialize disequalityIsSymmetric(j, a) j-not-a]
                                  // the factor values this case needs
                                  @ia-sends-i |
                                    apply(transposition(i, a), i) = a
                                    [using specialize transpositionAtFirst(i, a)]
                                  @ib-fixes-a |
                                    apply(transposition(i, b), a) = a
                                    [using specialize transpositionElsewhere(i, b, a) a-not-i a-not-b]
                                  @ij-sends-i |
                                    apply(transposition(i, j), i) = j
                                    [using specialize transpositionAtFirst(i, j)]
                                  @ia-fixes-j |
                                    apply(transposition(i, a), j) = j
                                    [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                                  @ij-sends-j |
                                    apply(transposition(i, j), j) = i
                                    [using specialize transpositionAtSecond(i, j)]
                                  @ij-fixes-a |
                                    apply(transposition(i, j), a) = a
                                    [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                                  @lhs-split |
                                    apply(compose(transposition(i, b), transposition(i, a)), i) =
                                      apply(transposition(i, b), apply(transposition(i, a), i))
                                    [using simplify composeApply]
                                  @lhs-value |
                                    apply(compose(transposition(i, b), transposition(i, a)), i) = a
                                    [using chain lhs-split ia-sends-i ib-fixes-a]
                                  @rhs-split |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), i) =
                                      apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), i))))))
                                    [using simplify composeApply]
                                  @rhs-value |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), i) = a
                                    [using simplify rhs-split ij-sends-i ia-fixes-j ij-sends-j ia-sends-i ij-fixes-a ib-fixes-a]
                                  @conclusion-agree |
                                    apply(compose(transposition(i, b), transposition(i, a)), i) =
                                      apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), i)
                                    [using chain lhs-value rhs-value]
                                }
                              @conclusion-a-not-b |
                                a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                [by implies_intro given-a-not-b]
                            }
                          @conclusion-j-not-a |
                            j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                            [by implies_intro given-j-not-a]
                        }
                      @conclusion-i-not-a |
                        i != a -> j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                        [by implies_intro given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                    [by implies_intro given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> j != a -> a != b -> apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element;
      i != j -> i != a -> j != a -> a != b ->
      apply(compose(transposition(i, b), transposition(i, a)), i) =
      apply(compose(compose(transposition(i, b), transposition(i, j)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))), i)
    [by forall_intro generalize-i]
qed

// at j: LHS both factors fix j.
//       RHS (ij): j->i, (ia): i->a, (ij) fixes a, (ia): a->i, (ij): i->j, (ib) fixes j.
theorem secondIdentityAgreesAtJ: forall i, j, a, b: Element;
  i != j -> i != a -> j != a -> j != b ->
  apply(compose(transposition(i, b), transposition(i, a)), j) =
  apply(compose(compose(transposition(i, b), transposition(i, j)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))), j)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-j-not-a |
                            assume j != a {
                              @given-j-not-b |
                                assume j != b {
                                  @i-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @i-not-a |
                                    i != a
                                    [by hypothesis given-i-not-a]
                                  @j-not-a |
                                    j != a
                                    [by hypothesis given-j-not-a]
                                  @j-not-b |
                                    j != b
                                    [by hypothesis given-j-not-b]
                                  @j-not-i |
                                    j != i
                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                  @a-not-i |
                                    a != i
                                    [using specialize disequalityIsSymmetric(i, a) i-not-a]
                                  @a-not-j |
                                    a != j
                                    [using specialize disequalityIsSymmetric(j, a) j-not-a]
                                  @ia-fixes-j |
                                    apply(transposition(i, a), j) = j
                                    [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                                  @ib-fixes-j |
                                    apply(transposition(i, b), j) = j
                                    [using specialize transpositionElsewhere(i, b, j) j-not-i j-not-b]
                                  @ij-sends-j |
                                    apply(transposition(i, j), j) = i
                                    [using specialize transpositionAtSecond(i, j)]
                                  @ia-sends-i |
                                    apply(transposition(i, a), i) = a
                                    [using specialize transpositionAtFirst(i, a)]
                                  @ij-fixes-a |
                                    apply(transposition(i, j), a) = a
                                    [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                                  @ia-sends-a |
                                    apply(transposition(i, a), a) = i
                                    [using specialize transpositionAtSecond(i, a)]
                                  @ij-sends-i |
                                    apply(transposition(i, j), i) = j
                                    [using specialize transpositionAtFirst(i, j)]
                                  @lhs-split |
                                    apply(compose(transposition(i, b), transposition(i, a)), j) =
                                      apply(transposition(i, b), apply(transposition(i, a), j))
                                    [using simplify composeApply]
                                  @lhs-value |
                                    apply(compose(transposition(i, b), transposition(i, a)), j) = j
                                    [using simplify lhs-split ia-fixes-j ib-fixes-j]
                                  @rhs-split |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), j) =
                                      apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), j))))))
                                    [using simplify composeApply]
                                  @rhs-value |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), j) = j
                                    [using simplify rhs-split ij-sends-j ia-sends-i ij-fixes-a ia-sends-a ij-sends-i ib-fixes-j]
                                  @conclusion-agree |
                                    apply(compose(transposition(i, b), transposition(i, a)), j) =
                                      apply(compose(compose(transposition(i, b), transposition(i, j)),
                                      compose(compose(transposition(i, a), transposition(i, j)),
                                      compose(transposition(i, a), transposition(i, j)))), j)
                                    [using chain lhs-value rhs-value]
                                }
                              @conclusion-j-not-b |
                                j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                [by implies_intro given-j-not-b]
                            }
                          @conclusion-j-not-a |
                            j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                            [by implies_intro given-j-not-a]
                        }
                      @conclusion-i-not-a |
                        i != a -> j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                        [by implies_intro given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                    [by implies_intro given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> j != a -> j != b -> apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element;
      i != j -> i != a -> j != a -> j != b ->
      apply(compose(transposition(i, b), transposition(i, a)), j) =
      apply(compose(compose(transposition(i, b), transposition(i, j)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))), j)
    [by forall_intro generalize-i]
qed

// at a: LHS (ia): a->i then (ib): i->b.
//       RHS (ij) fixes a, (ia): a->i, (ij): i->j, (ia) fixes j, (ij): j->i, (ib): i->b.
theorem secondIdentityAgreesAtA: forall i, j, a, b: Element;
  i != j -> i != a -> j != a ->
  apply(compose(transposition(i, b), transposition(i, a)), a) =
  apply(compose(compose(transposition(i, b), transposition(i, j)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))), a)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-j-not-a |
                            assume j != a {
                              @i-not-j |
                                i != j
                                [by hypothesis given-i-not-j]
                              @i-not-a |
                                i != a
                                [by hypothesis given-i-not-a]
                              @j-not-a |
                                j != a
                                [by hypothesis given-j-not-a]
                              @j-not-i |
                                j != i
                                [using specialize disequalityIsSymmetric(i, j) i-not-j]
                              @a-not-i |
                                a != i
                                [using specialize disequalityIsSymmetric(i, a) i-not-a]
                              @a-not-j |
                                a != j
                                [using specialize disequalityIsSymmetric(j, a) j-not-a]
                              @ia-sends-a |
                                apply(transposition(i, a), a) = i
                                [using specialize transpositionAtSecond(i, a)]
                              @ib-sends-i |
                                apply(transposition(i, b), i) = b
                                [using specialize transpositionAtFirst(i, b)]
                              @ij-fixes-a |
                                apply(transposition(i, j), a) = a
                                [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                              @ij-sends-i |
                                apply(transposition(i, j), i) = j
                                [using specialize transpositionAtFirst(i, j)]
                              @ia-fixes-j |
                                apply(transposition(i, a), j) = j
                                [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                              @ij-sends-j |
                                apply(transposition(i, j), j) = i
                                [using specialize transpositionAtSecond(i, j)]
                              @lhs-split |
                                apply(compose(transposition(i, b), transposition(i, a)), a) =
                                  apply(transposition(i, b), apply(transposition(i, a), a))
                                [using simplify composeApply]
                              @lhs-value |
                                apply(compose(transposition(i, b), transposition(i, a)), a) = b
                                [using simplify lhs-split ia-sends-a ib-sends-i]
                              @rhs-split |
                                apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), a) =
                                  apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), a))))))
                                [using simplify composeApply]
                              @rhs-value |
                                apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), a) = b
                                [using simplify rhs-split ij-fixes-a ia-sends-a ij-sends-i ia-fixes-j ij-sends-j ib-sends-i]
                              @conclusion-agree |
                                apply(compose(transposition(i, b), transposition(i, a)), a) =
                                  apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), a)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-j-not-a |
                            j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                            [by implies_intro given-j-not-a]
                        }
                      @conclusion-i-not-a |
                        i != a -> j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                        [by implies_intro given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                    [by implies_intro given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> j != a -> apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element;
      i != j -> i != a -> j != a ->
      apply(compose(transposition(i, b), transposition(i, a)), a) =
      apply(compose(compose(transposition(i, b), transposition(i, j)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))), a)
    [by forall_intro generalize-i]
qed

// at b: every (i,·) factor fixes b except the outermost (ib), which sends b to i.
theorem secondIdentityAgreesAtB: forall i, j, a, b: Element;
  b != i -> b != j -> b != a ->
  apply(compose(transposition(i, b), transposition(i, a)), b) =
  apply(compose(compose(transposition(i, b), transposition(i, j)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))), b)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-b-not-i |
                    assume b != i {
                      @given-b-not-j |
                        assume b != j {
                          @given-b-not-a |
                            assume b != a {
                              @b-not-i |
                                b != i
                                [by hypothesis given-b-not-i]
                              @b-not-j |
                                b != j
                                [by hypothesis given-b-not-j]
                              @b-not-a |
                                b != a
                                [by hypothesis given-b-not-a]
                              @ia-fixes-b |
                                apply(transposition(i, a), b) = b
                                [using specialize transpositionElsewhere(i, a, b) b-not-i b-not-a]
                              @ij-fixes-b |
                                apply(transposition(i, j), b) = b
                                [using specialize transpositionElsewhere(i, j, b) b-not-i b-not-j]
                              @ib-sends-b |
                                apply(transposition(i, b), b) = i
                                [using specialize transpositionAtSecond(i, b)]
                              @lhs-split |
                                apply(compose(transposition(i, b), transposition(i, a)), b) =
                                  apply(transposition(i, b), apply(transposition(i, a), b))
                                [using simplify composeApply]
                              @lhs-value |
                                apply(compose(transposition(i, b), transposition(i, a)), b) = i
                                [using simplify lhs-split ia-fixes-b ib-sends-b]
                              @rhs-split |
                                apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), b) =
                                  apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), b))))))
                                [using simplify composeApply]
                              @rhs-value |
                                apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), b) = i
                                [using simplify rhs-split ij-fixes-b ia-fixes-b ib-sends-b]
                              @conclusion-agree |
                                apply(compose(transposition(i, b), transposition(i, a)), b) =
                                  apply(compose(compose(transposition(i, b), transposition(i, j)),
                                  compose(compose(transposition(i, a), transposition(i, j)),
                                  compose(transposition(i, a), transposition(i, j)))), b)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-b-not-a |
                            b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                            [by implies_intro given-b-not-a]
                        }
                      @conclusion-b-not-j |
                        b != j -> b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                        [by implies_intro given-b-not-j]
                    }
                  @conclusion-b-not-i |
                    b != i -> b != j -> b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                    [by implies_intro given-b-not-i]
                }
              @discharge-b |
                forall b: Element; b != i -> b != j -> b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; b != i -> b != j -> b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; b != i -> b != j -> b != a -> apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element;
      b != i -> b != j -> b != a ->
      apply(compose(transposition(i, b), transposition(i, a)), b) =
      apply(compose(compose(transposition(i, b), transposition(i, j)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))), b)
    [by forall_intro generalize-i]
qed

// elsewhere: x is none of i, j, a, b, so every factor fixes it.
theorem secondIdentityAgreesElsewhere: forall i, j, a, b, x: Element;
  x != i -> x != j -> x != a -> x != b ->
  apply(compose(transposition(i, b), transposition(i, a)), x) =
  apply(compose(compose(transposition(i, b), transposition(i, j)),
  compose(compose(transposition(i, a), transposition(i, j)),
  compose(transposition(i, a), transposition(i, j)))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-x |
                    fix x: Element {
                      @given-x-not-i |
                        assume x != i {
                          @given-x-not-j |
                            assume x != j {
                              @given-x-not-a |
                                assume x != a {
                                  @given-x-not-b |
                                    assume x != b {
                                      @x-not-i |
                                        x != i
                                        [by hypothesis given-x-not-i]
                                      @x-not-j |
                                        x != j
                                        [by hypothesis given-x-not-j]
                                      @x-not-a |
                                        x != a
                                        [by hypothesis given-x-not-a]
                                      @x-not-b |
                                        x != b
                                        [by hypothesis given-x-not-b]
                                      @ia-fixes-x |
                                        apply(transposition(i, a), x) = x
                                        [using specialize transpositionElsewhere(i, a, x) x-not-i x-not-a]
                                      @ib-fixes-x |
                                        apply(transposition(i, b), x) = x
                                        [using specialize transpositionElsewhere(i, b, x) x-not-i x-not-b]
                                      @ij-fixes-x |
                                        apply(transposition(i, j), x) = x
                                        [using specialize transpositionElsewhere(i, j, x) x-not-i x-not-j]
                                      @lhs-split |
                                        apply(compose(transposition(i, b), transposition(i, a)), x) =
                                          apply(transposition(i, b), apply(transposition(i, a), x))
                                        [using simplify composeApply]
                                      @lhs-value |
                                        apply(compose(transposition(i, b), transposition(i, a)), x) = x
                                        [using simplify lhs-split ia-fixes-x ib-fixes-x]
                                      @rhs-split |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)),
                                          compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))), x) =
                                          apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), x))))))
                                        [using simplify composeApply]
                                      @rhs-value |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)),
                                          compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))), x) = x
                                        [using simplify rhs-split ij-fixes-x ia-fixes-x ib-fixes-x]
                                      @conclusion-agree |
                                        apply(compose(transposition(i, b), transposition(i, a)), x) =
                                          apply(compose(compose(transposition(i, b), transposition(i, j)),
                                          compose(compose(transposition(i, a), transposition(i, j)),
                                          compose(transposition(i, a), transposition(i, j)))), x)
                                        [using chain lhs-value rhs-value]
                                    }
                                  @conclusion-x-not-b |
                                    x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                    [by implies_intro given-x-not-b]
                                }
                              @conclusion-x-not-a |
                                x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                [by implies_intro given-x-not-a]
                            }
                          @conclusion-x-not-j |
                            x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                            [by implies_intro given-x-not-j]
                        }
                      @conclusion-x-not-i |
                        x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                        [by implies_intro given-x-not-i]
                    }
                  @discharge-x |
                    forall x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                    [by forall_intro generalize-x]
                }
              @discharge-b |
                forall b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b, x: Element;
      x != i -> x != j -> x != a -> x != b ->
      apply(compose(transposition(i, b), transposition(i, a)), x) =
      apply(compose(compose(transposition(i, b), transposition(i, j)),
      compose(compose(transposition(i, a), transposition(i, j)),
      compose(transposition(i, a), transposition(i, j)))), x)
    [by forall_intro generalize-i]
qed

// The pointwise agreement behind identity (2): five cases on where x sits. Each named
// letter uses only the distinctness facts its own trace cites, so the symmetric forms
// (`b != i` for the case at b) are derived here from the statement's hypotheses.
theorem theSecondIdentityAgreesEverywhere: forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  forall x: Element;
  apply(compose(transposition(i, b), transposition(i, a)), x) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-b |
                                    assume j != b {
                                      @given-a-not-b |
                                        assume a != b {
                                          @i-not-j |
                                            i != j
                                            [by hypothesis given-i-not-j]
                                          @i-not-a |
                                            i != a
                                            [by hypothesis given-i-not-a]
                                          @i-not-b |
                                            i != b
                                            [by hypothesis given-i-not-b]
                                          @j-not-a |
                                            j != a
                                            [by hypothesis given-j-not-a]
                                          @j-not-b |
                                            j != b
                                            [by hypothesis given-j-not-b]
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-not-b]
                                          @b-not-i |
                                            b != i
                                            [using specialize disequalityIsSymmetric(i, b) i-not-b]
                                          @b-not-j |
                                            b != j
                                            [using specialize disequalityIsSymmetric(j, b) j-not-b]
                                          @b-not-a |
                                            b != a
                                            [using specialize disequalityIsSymmetric(a, b) a-not-b]
                                          @generalize-x |
                                            fix x: Element {
                                              @cases |
                                                x = i or x = j or x = a or x = b or (x != i and x != j and x != a and x != b)
                                                [using tautology]
                                              @conclusion-at-x |
                                                apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                case cases {
                                                  @when-x-is-i |
                                                    assume x = i {
                                                      @x-is-i |
                                                        x = i
                                                        [by hypothesis when-x-is-i]
                                                      @agree-at-i |
                                                        apply(compose(transposition(i, b), transposition(i, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                                        [using specialize secondIdentityAgreesAtI(i, j, a, b) i-not-j i-not-a j-not-a a-not-b]
                                                      @conclusion-when-x-is-i |
                                                        apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-i agree-at-i]
                                                    }
                                                  @when-x-is-j |
                                                    assume x = j {
                                                      @x-is-j |
                                                        x = j
                                                        [by hypothesis when-x-is-j]
                                                      @agree-at-j |
                                                        apply(compose(transposition(i, b), transposition(i, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                                        [using specialize secondIdentityAgreesAtJ(i, j, a, b) i-not-j i-not-a j-not-a j-not-b]
                                                      @conclusion-when-x-is-j |
                                                        apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-j agree-at-j]
                                                    }
                                                  @when-x-is-a |
                                                    assume x = a {
                                                      @x-is-a |
                                                        x = a
                                                        [by hypothesis when-x-is-a]
                                                      @agree-at-a |
                                                        apply(compose(transposition(i, b), transposition(i, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                                        [using specialize secondIdentityAgreesAtA(i, j, a, b) i-not-j i-not-a j-not-a]
                                                      @conclusion-when-x-is-a |
                                                        apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-a agree-at-a]
                                                    }
                                                  @when-x-is-b |
                                                    assume x = b {
                                                      @x-is-b |
                                                        x = b
                                                        [by hypothesis when-x-is-b]
                                                      @agree-at-b |
                                                        apply(compose(transposition(i, b), transposition(i, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                                        [using specialize secondIdentityAgreesAtB(i, j, a, b) b-not-i b-not-j b-not-a]
                                                      @conclusion-when-x-is-b |
                                                        apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-b agree-at-b]
                                                    }
                                                  @when-x-is-elsewhere |
                                                    assume x != i and x != j and x != a and x != b {
                                                      @x-is-elsewhere |
                                                        x != i and x != j and x != a and x != b
                                                        [by hypothesis when-x-is-elsewhere]
                                                      @x-not-i |
                                                        x != i
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-j |
                                                        x != j
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-a |
                                                        x != a
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-b |
                                                        x != b
                                                        [using tautology x-is-elsewhere]
                                                      @conclusion-when-x-is-elsewhere |
                                                        apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [using specialize secondIdentityAgreesElsewhere(i, j, a, b, x) x-not-i x-not-j x-not-a x-not-b]
                                                    }
                                                }
                                            }
                                          @discharge-x |
                                            forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                            [by forall_intro generalize-x]
                                        }
                                      @conclusion-a-not-b |
                                        a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                        [by implies_intro given-a-not-b]
                                    }
                                  @conclusion-j-not-b |
                                    j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                    [by implies_intro given-j-not-b]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                [by implies_intro given-j-not-a]
                            }
                          @conclusion-i-not-b |
                            i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                            [by implies_intro given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                        [by implies_intro given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                    [by implies_intro given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
    [by forall_intro generalize-i]
qed

// Judson Lemma 2, identity (2): (i,a,b) = (i,j,b)(i,j,a)^2.
theorem aThreeCycleOffTheFixedPairFactors: forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  compose(transposition(i, b), transposition(i, a)) =
  compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-b |
                                    assume j != b {
                                      @given-a-not-b |
                                        assume a != b {
                                          @i-not-j |
                                            i != j
                                            [by hypothesis given-i-not-j]
                                          @i-not-a |
                                            i != a
                                            [by hypothesis given-i-not-a]
                                          @i-not-b |
                                            i != b
                                            [by hypothesis given-i-not-b]
                                          @j-not-a |
                                            j != a
                                            [by hypothesis given-j-not-a]
                                          @j-not-b |
                                            j != b
                                            [by hypothesis given-j-not-b]
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-not-b]
                                          @agree-everywhere |
                                            forall x: Element; apply(compose(transposition(i, b), transposition(i, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                            [using specialize theSecondIdentityAgreesEverywhere(i, j, a, b) i-not-j i-not-a i-not-b j-not-a j-not-b a-not-b]
                                          @conclusion-equal |
                                            compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                            [using specialize funcExtensionality(compose(transposition(i, b), transposition(i, a)), compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))) agree-everywhere]
                                        }
                                      @conclusion-a-not-b |
                                        a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                        [by implies_intro given-a-not-b]
                                    }
                                  @conclusion-j-not-b |
                                    j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                    [by implies_intro given-j-not-b]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                [by implies_intro given-j-not-a]
                            }
                          @conclusion-i-not-b |
                            i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                            [by implies_intro given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                        [by implies_intro given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                    [by implies_intro given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
      compose(transposition(i, b), transposition(i, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
    [by forall_intro generalize-i]
qed

// at i: LHS both (j,·) factors fix i.
//       RHS (ij): i->j, (ia) fixes j, (ij): j->i, (ib): i->b, (ij) fixes b, (ib): b->i.
theorem thirdIdentityAgreesAtI: forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b ->
  apply(compose(transposition(j, b), transposition(j, a)), i) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-b |
                                    assume j != b {
                                      @i-not-j |
                                        i != j
                                        [by hypothesis given-i-not-j]
                                      @i-not-a |
                                        i != a
                                        [by hypothesis given-i-not-a]
                                      @i-not-b |
                                        i != b
                                        [by hypothesis given-i-not-b]
                                      @j-not-a |
                                        j != a
                                        [by hypothesis given-j-not-a]
                                      @j-not-b |
                                        j != b
                                        [by hypothesis given-j-not-b]
                                      @j-not-i |
                                        j != i
                                        [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                      @b-not-i |
                                        b != i
                                        [using specialize disequalityIsSymmetric(i, b) i-not-b]
                                      @b-not-j |
                                        b != j
                                        [using specialize disequalityIsSymmetric(j, b) j-not-b]
                                      @ja-fixes-i |
                                        apply(transposition(j, a), i) = i
                                        [using specialize transpositionElsewhere(j, a, i) i-not-j i-not-a]
                                      @jb-fixes-i |
                                        apply(transposition(j, b), i) = i
                                        [using specialize transpositionElsewhere(j, b, i) i-not-j i-not-b]
                                      @ij-sends-i |
                                        apply(transposition(i, j), i) = j
                                        [using specialize transpositionAtFirst(i, j)]
                                      @ia-fixes-j |
                                        apply(transposition(i, a), j) = j
                                        [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                                      @ij-sends-j |
                                        apply(transposition(i, j), j) = i
                                        [using specialize transpositionAtSecond(i, j)]
                                      @ib-sends-i |
                                        apply(transposition(i, b), i) = b
                                        [using specialize transpositionAtFirst(i, b)]
                                      @ij-fixes-b |
                                        apply(transposition(i, j), b) = b
                                        [using specialize transpositionElsewhere(i, j, b) b-not-i b-not-j]
                                      @ib-sends-b |
                                        apply(transposition(i, b), b) = i
                                        [using specialize transpositionAtSecond(i, b)]
                                      @lhs-split |
                                        apply(compose(transposition(j, b), transposition(j, a)), i) = apply(transposition(j, b), apply(transposition(j, a), i))
                                        [using simplify composeApply]
                                      @lhs-value |
                                        apply(compose(transposition(j, b), transposition(j, a)), i) = i
                                        [using simplify lhs-split ja-fixes-i jb-fixes-i]
                                      @rhs-split |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i) =
                                          apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), i))))))
                                        [using simplify composeApply]
                                      @rhs-value |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i) = i
                                        [using simplify rhs-split ij-sends-i ia-fixes-j ij-sends-j ib-sends-i ij-fixes-b ib-sends-b]
                                      @conclusion-agree |
                                        apply(compose(transposition(j, b), transposition(j, a)), i) =
                                          apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                        [using chain lhs-value rhs-value]
                                    }
                                  @conclusion-j-not-b |
                                    j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                    [by implies_intro given-j-not-b]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                [by implies_intro given-j-not-a]
                            }
                          @conclusion-i-not-b |
                            i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                            [by implies_intro given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                        [by implies_intro given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                    [by implies_intro given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b ->
      apply(compose(transposition(j, b), transposition(j, a)), i) =
      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
    [by forall_intro generalize-i]
qed

// at j: LHS (ja): j->a then (jb) fixes a.
//       RHS (ij): j->i, (ia): i->a, then (ij) and both (ib) fix a.
theorem thirdIdentityAgreesAtJ: forall i, j, a, b: Element;
  i != a -> j != a -> a != b ->
  apply(compose(transposition(j, b), transposition(j, a)), j) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-a |
                    assume i != a {
                      @given-j-not-a |
                        assume j != a {
                          @given-a-not-b |
                            assume a != b {
                              @i-not-a |
                                i != a
                                [by hypothesis given-i-not-a]
                              @j-not-a |
                                j != a
                                [by hypothesis given-j-not-a]
                              @a-not-b |
                                a != b
                                [by hypothesis given-a-not-b]
                              @a-not-i |
                                a != i
                                [using specialize disequalityIsSymmetric(i, a) i-not-a]
                              @a-not-j |
                                a != j
                                [using specialize disequalityIsSymmetric(j, a) j-not-a]
                              @ja-sends-j |
                                apply(transposition(j, a), j) = a
                                [using specialize transpositionAtFirst(j, a)]
                              @jb-fixes-a |
                                apply(transposition(j, b), a) = a
                                [using specialize transpositionElsewhere(j, b, a) a-not-j a-not-b]
                              @ij-sends-j |
                                apply(transposition(i, j), j) = i
                                [using specialize transpositionAtSecond(i, j)]
                              @ia-sends-i |
                                apply(transposition(i, a), i) = a
                                [using specialize transpositionAtFirst(i, a)]
                              @ij-fixes-a |
                                apply(transposition(i, j), a) = a
                                [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                              @ib-fixes-a |
                                apply(transposition(i, b), a) = a
                                [using specialize transpositionElsewhere(i, b, a) a-not-i a-not-b]
                              @lhs-split |
                                apply(compose(transposition(j, b), transposition(j, a)), j) = apply(transposition(j, b), apply(transposition(j, a), j))
                                [using simplify composeApply]
                              @lhs-value |
                                apply(compose(transposition(j, b), transposition(j, a)), j) = a
                                [using simplify lhs-split ja-sends-j jb-fixes-a]
                              @rhs-split |
                                apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j) =
                                  apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), j))))))
                                [using simplify composeApply]
                              @rhs-value |
                                apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j) = a
                                [using simplify rhs-split ij-sends-j ia-sends-i ij-fixes-a ib-fixes-a]
                              @conclusion-agree |
                                apply(compose(transposition(j, b), transposition(j, a)), j) =
                                  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                [using chain lhs-value rhs-value]
                            }
                          @conclusion-a-not-b |
                            a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                            [by implies_intro given-a-not-b]
                        }
                      @conclusion-j-not-a |
                        j != a -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                        [by implies_intro given-j-not-a]
                    }
                  @conclusion-i-not-a |
                    i != a -> j != a -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                    [by implies_intro given-i-not-a]
                }
              @discharge-b |
                forall b: Element; i != a -> j != a -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != a -> j != a -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != a -> j != a -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != a -> j != a -> a != b ->
      apply(compose(transposition(j, b), transposition(j, a)), j) =
      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
    [by forall_intro generalize-i]
qed

// at a: LHS (ja): a->j then (jb): j->b.
//       RHS (ij) fixes a, (ia): a->i, (ij): i->j, (ib) fixes j, (ij): j->i, (ib): i->b.
theorem thirdIdentityAgreesAtA: forall i, j, a, b: Element;
  i != j -> j != b -> i != a -> j != a ->
  apply(compose(transposition(j, b), transposition(j, a)), a) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-j-not-b |
                        assume j != b {
                          @given-i-not-a |
                            assume i != a {
                              @given-j-not-a |
                                assume j != a {
                                  @i-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @j-not-b |
                                    j != b
                                    [by hypothesis given-j-not-b]
                                  @i-not-a |
                                    i != a
                                    [by hypothesis given-i-not-a]
                                  @j-not-a |
                                    j != a
                                    [by hypothesis given-j-not-a]
                                  @j-not-i |
                                    j != i
                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                  @a-not-i |
                                    a != i
                                    [using specialize disequalityIsSymmetric(i, a) i-not-a]
                                  @a-not-j |
                                    a != j
                                    [using specialize disequalityIsSymmetric(j, a) j-not-a]
                                  @ja-sends-a |
                                    apply(transposition(j, a), a) = j
                                    [using specialize transpositionAtSecond(j, a)]
                                  @jb-sends-j |
                                    apply(transposition(j, b), j) = b
                                    [using specialize transpositionAtFirst(j, b)]
                                  @ij-fixes-a |
                                    apply(transposition(i, j), a) = a
                                    [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                                  @ia-sends-a |
                                    apply(transposition(i, a), a) = i
                                    [using specialize transpositionAtSecond(i, a)]
                                  @ij-sends-i |
                                    apply(transposition(i, j), i) = j
                                    [using specialize transpositionAtFirst(i, j)]
                                  @ib-fixes-j |
                                    apply(transposition(i, b), j) = j
                                    [using specialize transpositionElsewhere(i, b, j) j-not-i j-not-b]
                                  @ij-sends-j |
                                    apply(transposition(i, j), j) = i
                                    [using specialize transpositionAtSecond(i, j)]
                                  @ib-sends-i |
                                    apply(transposition(i, b), i) = b
                                    [using specialize transpositionAtFirst(i, b)]
                                  @lhs-split |
                                    apply(compose(transposition(j, b), transposition(j, a)), a) = apply(transposition(j, b), apply(transposition(j, a), a))
                                    [using simplify composeApply]
                                  @lhs-value |
                                    apply(compose(transposition(j, b), transposition(j, a)), a) = b
                                    [using simplify lhs-split ja-sends-a jb-sends-j]
                                  @rhs-split |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a) =
                                      apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), a))))))
                                    [using simplify composeApply]
                                  @rhs-value |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a) = b
                                    [using simplify rhs-split ij-fixes-a ia-sends-a ij-sends-i ib-fixes-j ij-sends-j ib-sends-i]
                                  @conclusion-agree |
                                    apply(compose(transposition(j, b), transposition(j, a)), a) =
                                      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                    [using chain lhs-value rhs-value]
                                }
                              @conclusion-j-not-a |
                                j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                [by implies_intro given-j-not-a]
                            }
                          @conclusion-i-not-a |
                            i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                            [by implies_intro given-i-not-a]
                        }
                      @conclusion-j-not-b |
                        j != b -> i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                        [by implies_intro given-j-not-b]
                    }
                  @conclusion-i-not-j |
                    i != j -> j != b -> i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                    [by implies_intro given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> j != b -> i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> j != b -> i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> j != b -> i != a -> j != a -> apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> j != b -> i != a -> j != a ->
      apply(compose(transposition(j, b), transposition(j, a)), a) =
      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
    [by forall_intro generalize-i]
qed

// at b: LHS (ja) fixes b then (jb): b->j.
//       RHS (ij),(ia) fix b; (ib): b->i; (ij): i->j; (ib) fixes j.
theorem thirdIdentityAgreesAtB: forall i, j, a, b: Element;
  i != j -> j != b -> i != b -> a != b ->
  apply(compose(transposition(j, b), transposition(j, a)), b) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-j-not-b |
                        assume j != b {
                          @given-i-not-b |
                            assume i != b {
                              @given-a-not-b |
                                assume a != b {
                                  @i-not-j |
                                    i != j
                                    [by hypothesis given-i-not-j]
                                  @j-not-b |
                                    j != b
                                    [by hypothesis given-j-not-b]
                                  @i-not-b |
                                    i != b
                                    [by hypothesis given-i-not-b]
                                  @a-not-b |
                                    a != b
                                    [by hypothesis given-a-not-b]
                                  @j-not-i |
                                    j != i
                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                  @b-not-i |
                                    b != i
                                    [using specialize disequalityIsSymmetric(i, b) i-not-b]
                                  @b-not-j |
                                    b != j
                                    [using specialize disequalityIsSymmetric(j, b) j-not-b]
                                  @b-not-a |
                                    b != a
                                    [using specialize disequalityIsSymmetric(a, b) a-not-b]
                                  @ja-fixes-b |
                                    apply(transposition(j, a), b) = b
                                    [using specialize transpositionElsewhere(j, a, b) b-not-j b-not-a]
                                  @jb-sends-b |
                                    apply(transposition(j, b), b) = j
                                    [using specialize transpositionAtSecond(j, b)]
                                  @ij-fixes-b |
                                    apply(transposition(i, j), b) = b
                                    [using specialize transpositionElsewhere(i, j, b) b-not-i b-not-j]
                                  @ia-fixes-b |
                                    apply(transposition(i, a), b) = b
                                    [using specialize transpositionElsewhere(i, a, b) b-not-i b-not-a]
                                  @ib-sends-b |
                                    apply(transposition(i, b), b) = i
                                    [using specialize transpositionAtSecond(i, b)]
                                  @ij-sends-i |
                                    apply(transposition(i, j), i) = j
                                    [using specialize transpositionAtFirst(i, j)]
                                  @ib-fixes-j |
                                    apply(transposition(i, b), j) = j
                                    [using specialize transpositionElsewhere(i, b, j) j-not-i j-not-b]
                                  @lhs-split |
                                    apply(compose(transposition(j, b), transposition(j, a)), b) = apply(transposition(j, b), apply(transposition(j, a), b))
                                    [using simplify composeApply]
                                  @lhs-value |
                                    apply(compose(transposition(j, b), transposition(j, a)), b) = j
                                    [using simplify lhs-split ja-fixes-b jb-sends-b]
                                  @rhs-split |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b) =
                                      apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), b))))))
                                    [using simplify composeApply]
                                  @rhs-value |
                                    apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b) = j
                                    [using simplify rhs-split ij-fixes-b ia-fixes-b ib-sends-b ij-sends-i ib-fixes-j]
                                  @conclusion-agree |
                                    apply(compose(transposition(j, b), transposition(j, a)), b) =
                                      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                    [using chain lhs-value rhs-value]
                                }
                              @conclusion-a-not-b |
                                a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                [by implies_intro given-a-not-b]
                            }
                          @conclusion-i-not-b |
                            i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                            [by implies_intro given-i-not-b]
                        }
                      @conclusion-j-not-b |
                        j != b -> i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                        [by implies_intro given-j-not-b]
                    }
                  @conclusion-i-not-j |
                    i != j -> j != b -> i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                    [by implies_intro given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> j != b -> i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> j != b -> i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> j != b -> i != b -> a != b -> apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> j != b -> i != b -> a != b ->
      apply(compose(transposition(j, b), transposition(j, a)), b) =
      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
    [by forall_intro generalize-i]
qed

// elsewhere: x is none of i, j, a, b, so every factor fixes it.
theorem thirdIdentityAgreesElsewhere: forall i, j, a, b, x: Element;
  x != i -> x != j -> x != a -> x != b ->
  apply(compose(transposition(j, b), transposition(j, a)), x) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-x |
                    fix x: Element {
                      @given-x-not-i |
                        assume x != i {
                          @given-x-not-j |
                            assume x != j {
                              @given-x-not-a |
                                assume x != a {
                                  @given-x-not-b |
                                    assume x != b {
                                      @x-not-i |
                                        x != i
                                        [by hypothesis given-x-not-i]
                                      @x-not-j |
                                        x != j
                                        [by hypothesis given-x-not-j]
                                      @x-not-a |
                                        x != a
                                        [by hypothesis given-x-not-a]
                                      @x-not-b |
                                        x != b
                                        [by hypothesis given-x-not-b]
                                      @ja-fixes-x |
                                        apply(transposition(j, a), x) = x
                                        [using specialize transpositionElsewhere(j, a, x) x-not-j x-not-a]
                                      @jb-fixes-x |
                                        apply(transposition(j, b), x) = x
                                        [using specialize transpositionElsewhere(j, b, x) x-not-j x-not-b]
                                      @ij-fixes-x |
                                        apply(transposition(i, j), x) = x
                                        [using specialize transpositionElsewhere(i, j, x) x-not-i x-not-j]
                                      @ia-fixes-x |
                                        apply(transposition(i, a), x) = x
                                        [using specialize transpositionElsewhere(i, a, x) x-not-i x-not-a]
                                      @ib-fixes-x |
                                        apply(transposition(i, b), x) = x
                                        [using specialize transpositionElsewhere(i, b, x) x-not-i x-not-b]
                                      @lhs-split |
                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(transposition(j, b), apply(transposition(j, a), x))
                                        [using simplify composeApply]
                                      @lhs-value |
                                        apply(compose(transposition(j, b), transposition(j, a)), x) = x
                                        [using simplify lhs-split ja-fixes-x jb-fixes-x]
                                      @rhs-split |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x) =
                                          apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, b), apply(transposition(i, j), apply(transposition(i, a), apply(transposition(i, j), x))))))
                                        [using simplify composeApply]
                                      @rhs-value |
                                        apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x) = x
                                        [using simplify rhs-split ij-fixes-x ia-fixes-x ib-fixes-x]
                                      @conclusion-agree |
                                        apply(compose(transposition(j, b), transposition(j, a)), x) =
                                          apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                        [using chain lhs-value rhs-value]
                                    }
                                  @conclusion-x-not-b |
                                    x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                    [by implies_intro given-x-not-b]
                                }
                              @conclusion-x-not-a |
                                x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                [by implies_intro given-x-not-a]
                            }
                          @conclusion-x-not-j |
                            x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                            [by implies_intro given-x-not-j]
                        }
                      @conclusion-x-not-i |
                        x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                        [by implies_intro given-x-not-i]
                    }
                  @discharge-x |
                    forall x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                    [by forall_intro generalize-x]
                }
              @discharge-b |
                forall b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b, x: Element; x != i -> x != j -> x != a -> x != b -> apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b, x: Element; x != i -> x != j -> x != a -> x != b ->
      apply(compose(transposition(j, b), transposition(j, a)), x) =
      apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
    [by forall_intro generalize-i]
qed

// The pointwise agreement behind identity (3): five cases on where x sits.
theorem theThirdIdentityAgreesEverywhere: forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  forall x: Element;
  apply(compose(transposition(j, b), transposition(j, a)), x) =
  apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-b |
                                    assume j != b {
                                      @given-a-not-b |
                                        assume a != b {
                                          @i-not-j |
                                            i != j
                                            [by hypothesis given-i-not-j]
                                          @i-not-a |
                                            i != a
                                            [by hypothesis given-i-not-a]
                                          @i-not-b |
                                            i != b
                                            [by hypothesis given-i-not-b]
                                          @j-not-a |
                                            j != a
                                            [by hypothesis given-j-not-a]
                                          @j-not-b |
                                            j != b
                                            [by hypothesis given-j-not-b]
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-not-b]
                                          @generalize-x |
                                            fix x: Element {
                                              @cases |
                                                x = i or x = j or x = a or x = b or (x != i and x != j and x != a and x != b)
                                                [using tautology]
                                              @conclusion-at-x |
                                                apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                case cases {
                                                  @when-x-is-i |
                                                    assume x = i {
                                                      @x-is-i |
                                                        x = i
                                                        [by hypothesis when-x-is-i]
                                                      @agree-at-i |
                                                        apply(compose(transposition(j, b), transposition(j, a)), i) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
                                                        [using specialize thirdIdentityAgreesAtI(i, j, a, b) i-not-j i-not-a i-not-b j-not-a j-not-b]
                                                      @conclusion-when-x-is-i |
                                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-i agree-at-i]
                                                    }
                                                  @when-x-is-j |
                                                    assume x = j {
                                                      @x-is-j |
                                                        x = j
                                                        [by hypothesis when-x-is-j]
                                                      @agree-at-j |
                                                        apply(compose(transposition(j, b), transposition(j, a)), j) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), j)
                                                        [using specialize thirdIdentityAgreesAtJ(i, j, a, b) i-not-a j-not-a a-not-b]
                                                      @conclusion-when-x-is-j |
                                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-j agree-at-j]
                                                    }
                                                  @when-x-is-a |
                                                    assume x = a {
                                                      @x-is-a |
                                                        x = a
                                                        [by hypothesis when-x-is-a]
                                                      @agree-at-a |
                                                        apply(compose(transposition(j, b), transposition(j, a)), a) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), a)
                                                        [using specialize thirdIdentityAgreesAtA(i, j, a, b) i-not-j j-not-b i-not-a j-not-a]
                                                      @conclusion-when-x-is-a |
                                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-a agree-at-a]
                                                    }
                                                  @when-x-is-b |
                                                    assume x = b {
                                                      @x-is-b |
                                                        x = b
                                                        [by hypothesis when-x-is-b]
                                                      @agree-at-b |
                                                        apply(compose(transposition(j, b), transposition(j, a)), b) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), b)
                                                        [using specialize thirdIdentityAgreesAtB(i, j, a, b) i-not-j j-not-b i-not-b a-not-b]
                                                      @conclusion-when-x-is-b |
                                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [by rewrite x-is-b agree-at-b]
                                                    }
                                                  @when-x-is-elsewhere |
                                                    assume x != i and x != j and x != a and x != b {
                                                      @x-is-elsewhere |
                                                        x != i and x != j and x != a and x != b
                                                        [by hypothesis when-x-is-elsewhere]
                                                      @x-not-i |
                                                        x != i
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-j |
                                                        x != j
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-a |
                                                        x != a
                                                        [using tautology x-is-elsewhere]
                                                      @x-not-b |
                                                        x != b
                                                        [using tautology x-is-elsewhere]
                                                      @conclusion-when-x-is-elsewhere |
                                                        apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                                        [using specialize thirdIdentityAgreesElsewhere(i, j, a, b, x) x-not-i x-not-j x-not-a x-not-b]
                                                    }
                                                }
                                            }
                                          @discharge-x |
                                            forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                            [by forall_intro generalize-x]
                                        }
                                      @conclusion-a-not-b |
                                        a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                        [by implies_intro given-a-not-b]
                                    }
                                  @conclusion-j-not-b |
                                    j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                    [by implies_intro given-j-not-b]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                [by implies_intro given-j-not-a]
                            }
                          @conclusion-i-not-b |
                            i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                            [by implies_intro given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                        [by implies_intro given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                    [by implies_intro given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
    [by forall_intro generalize-i]
qed

// Judson Lemma 2, identity (3): (j,a,b) = (i,j,b)^2(i,j,a).
theorem aThreeCycleThroughTheSecondFixedPointFactors: forall i, j, a, b: Element;
  i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
  compose(transposition(j, b), transposition(j, a)) =
  compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @given-i-not-j |
                    assume i != j {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-j-not-a |
                                assume j != a {
                                  @given-j-not-b |
                                    assume j != b {
                                      @given-a-not-b |
                                        assume a != b {
                                          @i-not-j |
                                            i != j
                                            [by hypothesis given-i-not-j]
                                          @i-not-a |
                                            i != a
                                            [by hypothesis given-i-not-a]
                                          @i-not-b |
                                            i != b
                                            [by hypothesis given-i-not-b]
                                          @j-not-a |
                                            j != a
                                            [by hypothesis given-j-not-a]
                                          @j-not-b |
                                            j != b
                                            [by hypothesis given-j-not-b]
                                          @a-not-b |
                                            a != b
                                            [by hypothesis given-a-not-b]
                                          @agree-everywhere |
                                            forall x: Element; apply(compose(transposition(j, b), transposition(j, a)), x) = apply(compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), x)
                                            [using specialize theThirdIdentityAgreesEverywhere(i, j, a, b) i-not-j i-not-a i-not-b j-not-a j-not-b a-not-b]
                                          @conclusion-equal |
                                            compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                            [using specialize funcExtensionality(compose(transposition(j, b), transposition(j, a)), compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))) agree-everywhere]
                                        }
                                      @conclusion-a-not-b |
                                        a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                        [by implies_intro given-a-not-b]
                                    }
                                  @conclusion-j-not-b |
                                    j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                    [by implies_intro given-j-not-b]
                                }
                              @conclusion-j-not-a |
                                j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                                [by implies_intro given-j-not-a]
                            }
                          @conclusion-i-not-b |
                            i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                            [by implies_intro given-i-not-b]
                        }
                      @conclusion-i-not-a |
                        i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                        [by implies_intro given-i-not-a]
                    }
                  @conclusion-i-not-j |
                    i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                    [by implies_intro given-i-not-j]
                }
              @discharge-b |
                forall b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
            [by forall_intro generalize-a]
        }
      @discharge-j |
        forall j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b -> compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i, j, a, b: Element; i != j -> i != a -> i != b -> j != a -> j != b -> a != b ->
      compose(transposition(j, b), transposition(j, a)) = compose(compose(transposition(i, b), transposition(i, j)), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j))))
    [by forall_intro generalize-i]
qed

// at i.
theorem fourthIdentityAgreesAtI: forall i, j, a, b, c: Element;
  i != a -> i != b -> i != c -> i != j -> j != a -> j != c -> j != b ->
  apply(compose(transposition(a, c), transposition(a, b)), i) =
  apply(compose(compose(compose(compose(transposition(i, a), transposition(i, j)), compose(transposition(i, a), transposition(i, j))), compose(compose(transposition(i, c), transposition(i, j)), compose(transposition(i, b), transposition(i, j)))), compose(compose(transposition(i, b), transposition(i, j)), compose(transposition(i, a), transposition(i, j)))), i)
proof
  @generalize-i |
    fix i: Element {
      @generalize-j |
        fix j: Element {
          @generalize-a |
            fix a: Element {
              @generalize-b |
                fix b: Element {
                  @generalize-c |
                    fix c: Element {
                      @given-i-not-a |
                        assume i != a {
                          @given-i-not-b |
                            assume i != b {
                              @given-i-not-c |
                                assume i != c {
                                  @given-i-not-j |
                                    assume i != j {
                                      @given-j-not-a |
                                        assume j != a {
                                          @given-j-not-c |
                                            assume j != c {
                                              @given-j-not-b |
                                                assume j != b {
                                                  @i-not-a |
                                                    i != a
                                                    [by hypothesis given-i-not-a]
                                                  @i-not-b |
                                                    i != b
                                                    [by hypothesis given-i-not-b]
                                                  @i-not-c |
                                                    i != c
                                                    [by hypothesis given-i-not-c]
                                                  @i-not-j |
                                                    i != j
                                                    [by hypothesis given-i-not-j]
                                                  @j-not-a |
                                                    j != a
                                                    [by hypothesis given-j-not-a]
                                                  @j-not-c |
                                                    j != c
                                                    [by hypothesis given-j-not-c]
                                                  @j-not-b |
                                                    j != b
                                                    [by hypothesis given-j-not-b]
                                                  @j-not-i |
                                                    j != i
                                                    [using specialize disequalityIsSymmetric(i, j) i-not-j]
                                                  @a-not-i |
                                                    a != i
                                                    [using specialize disequalityIsSymmetric(i, a) i-not-a]
                                                  @a-not-j |
                                                    a != j
                                                    [using specialize disequalityIsSymmetric(j, a) j-not-a]
                                                  @b-not-i |
                                                    b != i
                                                    [using specialize disequalityIsSymmetric(i, b) i-not-b]
                                                  @b-not-j |
                                                    b != j
                                                    [using specialize disequalityIsSymmetric(j, b) j-not-b]
                                                  @ab-fixes-i |
                                                    apply(transposition(a, b), i) = i
                                                    [using specialize transpositionElsewhere(a, b, i) i-not-a i-not-b]
                                                  @ac-fixes-i |
                                                    apply(transposition(a, c), i) = i
                                                    [using specialize transpositionElsewhere(a, c, i) i-not-a i-not-c]
                                                  @ij-sends-i |
                                                    apply(transposition(i, j), i) = j
                                                    [using specialize transpositionAtFirst(i, j)]
                                                  @ia-fixes-j |
                                                    apply(transposition(i, a), j) = j
                                                    [using specialize transpositionElsewhere(i, a, j) j-not-i j-not-a]
                                                  @ij-sends-j |
                                                    apply(transposition(i, j), j) = i
                                                    [using specialize transpositionAtSecond(i, j)]
                                                  @ib-sends-i |
                                                    apply(transposition(i, b), i) = b
                                                    [using specialize transpositionAtFirst(i, b)]
                                                  @ij-fixes-b |
                                                    apply(transposition(i, j), b) = b
                                                    [using specialize transpositionElsewhere(i, j, b) b-not-i b-not-j]
                                                  @ib-sends-b |
                                                    apply(transposition(i, b), b) = i
                                                    [using specialize transpositionAtSecond(i, b)]
                                                  @ic-fixes-j |
                                                    apply(transposition(i, c), j) = j
                                                    [using specialize transpositionElsewhere(i, c, j) j-not-i j-not-c]
                                                  @ia-sends-i |
                                                    apply(transposition(i, a), i) = a
                                                    [using specialize transpositionAtFirst(i, a)]
                                                  @ij-fixes-a |
                                                    apply(transposition(i, j), a) = a
                                                    [using specialize transpositionElsewhere(i, j, a) a-not-i a-not-j]
                                                  @ia-sends-a |
                                                    apply(transposition(i, a), a) = i
                                                    [using specialize transpositionAtSecond(i, a)]
