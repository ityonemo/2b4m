          forall rho: Fn; forall s1: Points; forall s2: Points; invertible(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> invertible(permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> invertible(permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_cycle.distinct(s1, succ(succ(succ(ZERO)))) -> permutation_cycle.distinct(s2, succ(succ(succ(ZERO)))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> inN(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> alternating.inAlternating(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))))) ->
          inN(compose(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(succ(ZERO)))), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, succ(succ(ZERO))))),
          compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)))))
        [by discharge given-inv]
    }
  @conclusion |
    (forall g2: Fn; forall h2: Fn; alternating.inAlternating(g2) -> inN(h2) ->
      inN(compose(compose(g2, h2), inverse(g2)))) ->
      (forall g2: Fn; inN(g2) -> inN(inverse(g2))) ->
      (forall g2, h2: Fn; inN(g2) -> inN(h2) -> inN(compose(g2, h2))) ->
      forall rho: Fn; forall s1: Points; forall s2: Points; invertible(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> invertible(permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> invertible(permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_cycle.distinct(s1, succ(succ(succ(ZERO)))) -> permutation_cycle.distinct(s2, succ(succ(succ(ZERO)))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> inN(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> alternating.inAlternating(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))))) ->
      inN(compose(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(succ(ZERO)))), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, succ(succ(ZERO))))),
      compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)))))
    [by discharge given-normal]
qed

// Exercised at N = A_n.
theorem theAlternatingGroupGetsAFiveCycleFromJudsonsSecondCase:
  forall rho: Fn; forall s1: Points; forall s2: Points;
  invertible(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> invertible(permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> invertible(permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_cycle.distinct(s1, succ(succ(succ(ZERO)))) -> permutation_cycle.distinct(s2, succ(succ(succ(ZERO)))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> alternating.inAlternating(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> alternating.inAlternating(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))))) ->
  alternating.inAlternating(compose(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(succ(ZERO)))), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, succ(succ(ZERO))))),
  compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)))))
proof
  @normal |
    forall g2: Fn; forall h2: Fn; alternating.inAlternating(g2) -> alternating.inAlternating(h2) ->
      alternating.inAlternating(compose(compose(g2, h2), inverse(g2)))
    [by cite alternating.theAlternatingGroupIsClosedUnderConjugation]
  @invclosed |
    forall g2: Fn; alternating.inAlternating(g2) -> alternating.inAlternating(inverse(g2))
    [by cite alternating.theAlternatingGroupIsClosedUnderInverses]
  @prodclosed |
    forall g2, h2: Fn; alternating.inAlternating(g2) -> alternating.inAlternating(h2) ->
      alternating.inAlternating(compose(g2, h2))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall rho: Fn; forall s1: Points; forall s2: Points;
      invertible(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> invertible(permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> invertible(permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_cycle.distinct(s1, succ(succ(succ(ZERO)))) -> permutation_cycle.distinct(s2, succ(succ(succ(ZERO)))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> alternating.inAlternating(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> alternating.inAlternating(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))))) ->
      alternating.inAlternating(compose(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(succ(ZERO)))), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, succ(succ(ZERO))))),
      compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)))))
    [using instantiation judsonsSecondCasePutsAFiveCycleInTheSubgroup((fun g2: Fn => alternating.inAlternating(g2))) normal invclosed prodclosed]
qed

// CASE 4 STEP 1, REGROUPED FOR MEMBERSHIP. Judson's first conjugation in the all-2-cycles case,
// stated the way N's closure sees it:
//
//     sigma^-1 * (c sigma c^-1) = (a1a3)(a2a4)     where c = (a1, a2, a3)
//
// Same shape as `theLongCycleCommutatorIsAThreeCycle` for case 1: the commutator closed form at
// sigma^-1, with the three images substituted, then `composeAssoc` and `invInvolution` to put
// the grouping where normality and inverse-closure can act.
//
// Needs no distinctness at all — `theTwoCycleCommutatorIsADoubleTransposition` is
// unconditional, the middle pair cancelling by symmetry plus the involution law.
theorem theTwoCycleCommutatorRegrouped: forall sigma: Fn; forall a1, a2, a3, a4: Element;
  invertible(sigma) ->
  apply(inverse(sigma), a1) = a2 ->
  apply(inverse(sigma), a2) = a1 ->
  apply(inverse(sigma), a3) = a4 ->
  compose(inverse(sigma),
  compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
  inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
  = compose(transposition(a2, a4), transposition(a1, a3))
proof
  @generalize-sigma |
    fix sigma: Fn {
      @generalize-a1 |
        fix a1: Element {
          @generalize-a2 |
            fix a2: Element {
              @generalize-a3 |
                fix a3: Element {
                  @generalize-a4 |
                    fix a4: Element {
                      @given-invertible |
                        assume invertible(sigma) {
                          @given-im1 |
                            assume apply(inverse(sigma), a1) = a2 {
                              @given-im2 |
                                assume apply(inverse(sigma), a2) = a1 {
                                  @given-im3 |
                                    assume apply(inverse(sigma), a3) = a4 {
                                      @sigma-is-a-permutation |
                                        invertible(sigma)
                                        [by hypothesis given-invertible]
                                      @image-a1 |
                                        apply(inverse(sigma), a1) = a2
                                        [by hypothesis given-im1]
                                      @image-a2 |
                                        apply(inverse(sigma), a2) = a1
                                        [by hypothesis given-im2]
                                      @image-a3 |
                                        apply(inverse(sigma), a3) = a4
                                        [by hypothesis given-im3]

                                      @sigma-inverse-is-a-permutation |
                                        invertible(inverse(sigma))
                                        [using specialize permutation.inverseIsAPermutation(sigma) sigma-is-a-permutation]
                                      @the-closed-form |
                                        compose(compose(compose(inverse(sigma),
                                          compose(transposition(a1, a3), transposition(a1, a2))),
                                          inverse(inverse(sigma))),
                                          inverse(compose(transposition(a1, a3), transposition(a1, a2))))
                                          = compose(compose(transposition(apply(inverse(sigma), a1), apply(inverse(sigma), a3)),
                                          transposition(apply(inverse(sigma), a1), apply(inverse(sigma), a2))),
                                          compose(transposition(a1, a2), transposition(a1, a3)))
                                        [using specialize theCommutatorOfAThreeCycleWithAPermutation(inverse(sigma), a1, a2, a3) sigma-inverse-is-a-permutation]
                                      @images-substituted |
                                        compose(compose(compose(inverse(sigma),
                                          compose(transposition(a1, a3), transposition(a1, a2))),
                                          inverse(inverse(sigma))),
                                          inverse(compose(transposition(a1, a3), transposition(a1, a2))))
                                          = compose(compose(transposition(a2, a4), transposition(a2, a1)),
                                          compose(transposition(a1, a2), transposition(a1, a3)))
                                        [using simplify image-a1 image-a2 image-a3 the-closed-form]
                                      @the-cancellation |
                                        compose(compose(transposition(a2, a4), transposition(a2, a1)),
                                          compose(transposition(a1, a2), transposition(a1, a3)))
                                          = compose(transposition(a2, a4), transposition(a1, a3))
                                        [using specialize theTwoCycleCommutatorIsADoubleTransposition(a1, a2, a3, a4)]
                                      @double-inverse |
                                        inverse(inverse(sigma)) = sigma
                                        [using specialize function_invertible.invInvolution(sigma) sigma-is-a-permutation]
                                      @commutator-at-sigma |
                                        compose(compose(compose(inverse(sigma),
                                          compose(transposition(a1, a3), transposition(a1, a2))), sigma),
                                          inverse(compose(transposition(a1, a3), transposition(a1, a2))))
                                          = compose(compose(transposition(a2, a4), transposition(a2, a1)),
                                          compose(transposition(a1, a2), transposition(a1, a3)))
                                        [by rewrite double-inverse images-substituted]
                                      @regrouped |
                                        compose(inverse(sigma),
                                          compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
                                          inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
                                          = compose(compose(compose(inverse(sigma),
                                          compose(transposition(a1, a3), transposition(a1, a2))), sigma),
                                          inverse(compose(transposition(a1, a3), transposition(a1, a2))))
                                        [using assoc(composeAssoc)]
                                      @conclusion-regrouped |
                                        compose(inverse(sigma),
                                          compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
                                          inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
                                          = compose(transposition(a2, a4), transposition(a1, a3))
                                        [using chain regrouped commutator-at-sigma the-cancellation]
                                    }
                                  @im3-implies |
                                    apply(inverse(sigma), a3) = a4 ->
                                      compose(inverse(sigma),
                                      compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
                                      inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
                                      = compose(transposition(a2, a4), transposition(a1, a3))
                                    [by discharge given-im3]
                                }
                              @im2-implies |
                                apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 ->
                                  compose(inverse(sigma),
                                  compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
                                  inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
                                  = compose(transposition(a2, a4), transposition(a1, a3))
                                [by discharge given-im2]
                            }
                          @im1-implies |
                            apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 ->
                              compose(inverse(sigma),
                              compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
                              inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
                              = compose(transposition(a2, a4), transposition(a1, a3))
                            [by discharge given-im1]
                        }
                      @invertible-implies |
                        invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 ->
                          compose(inverse(sigma),
                          compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
                          inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
                          = compose(transposition(a2, a4), transposition(a1, a3))
                        [by discharge given-invertible]
                    }
                  @discharge-a4 |
                    forall a4: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 ->
                      compose(inverse(sigma),
                      compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
                      inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
                      = compose(transposition(a2, a4), transposition(a1, a3))
                    [by generalize generalize-a4]
                }
              @discharge-a3 |
                forall a3, a4: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 ->
                  compose(inverse(sigma),
                  compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
                  inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
                  = compose(transposition(a2, a4), transposition(a1, a3))
                [by generalize generalize-a3]
            }
          @discharge-a2 |
            forall a2, a3, a4: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 ->
              compose(inverse(sigma),
              compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
              inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
              = compose(transposition(a2, a4), transposition(a1, a3))
            [by generalize generalize-a2]
        }
      @discharge-a1 |
        forall a1, a2, a3, a4: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 ->
          compose(inverse(sigma),
          compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
          inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
          = compose(transposition(a2, a4), transposition(a1, a3))
        [by generalize generalize-a1]
    }
  @conclusion |
    forall sigma: Fn; forall a1, a2, a3, a4: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 ->
      compose(inverse(sigma),
      compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma),
      inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
      = compose(transposition(a2, a4), transposition(a1, a3))
    [by generalize generalize-sigma]
qed

// STEP 1'S OUTPUT, EVALUATED AT THE THREE POINTS ARM 4 NEEDS. The double transposition
// `(a1a3)(a2a4)` swaps a1 with a3, swaps a2 with a4, and fixes anything else — so with a fifth
// point a5 outside the four it swaps a1/a3 and fixes a5, which is exactly arm 4's hypothesis
// shape.
//
// Judson writes "a further conjugation" and moves on. Formally each conjugation needs its own
// point-values: step 2 reads them off step 1's OUTPUT, not off sigma, and this is that step.
theorem theDoubleTranspositionsValues: forall a1, a2, a3, a4, a5: Element;
  a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 ->
  a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
  (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
  and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
  and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
proof
  @g1 |
    fix a1: Element {
      @g2 |
        fix a2: Element {
          @g3 |
            fix a3: Element {
              @g4 |
                fix a4: Element {
                  @g5 |
                    fix a5: Element {
                      @h1 |
                        assume a1 != a2 {
                          @h2 |
                            assume a1 != a4 {
                              @h3 |
                                assume a3 != a2 {
                                  @h4 |
                                    assume a3 != a4 {
                                      @h5 |
                                        assume a5 != a1 {
                                          @h6 |
                                            assume a5 != a2 {
                                              @h7 |
                                                assume a5 != a3 {
                                                  @h8 |
                                                    assume a5 != a4 {
                                                      @a1-not-a2 |
                                                        a1 != a2
                                                        [by hypothesis h1]
                                                      @a1-not-a4 |
                                                        a1 != a4
                                                        [by hypothesis h2]
                                                      @a3-not-a2 |
                                                        a3 != a2
                                                        [by hypothesis h3]
                                                      @a3-not-a4 |
                                                        a3 != a4
                                                        [by hypothesis h4]
                                                      @a5-not-a1 |
                                                        a5 != a1
                                                        [by hypothesis h5]
                                                      @a5-not-a2 |
                                                        a5 != a2
                                                        [by hypothesis h6]
                                                      @a5-not-a3 |
                                                        a5 != a3
                                                        [by hypothesis h7]
                                                      @a5-not-a4 |
                                                        a5 != a4
                                                        [by hypothesis h8]

                                                      // at a1: T(a1,a3) sends it to a3, then T(a2,a4) fixes a3
                                                      @inner-at-a1 |
                                                        apply(transposition(a1, a3), a1) = a3
                                                        [using specialize transpositionAtFirst(a1, a3)]
                                                      @outer-fixes-a3 |
                                                        apply(transposition(a2, a4), a3) = a3
                                                        [using specialize transpositionElsewhere(a2, a4, a3) a3-not-a2 a3-not-a4]
                                                      @value-at-a1 |
                                                        apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                                        [using simplify function.composeApply inner-at-a1 outer-fixes-a3]

                                                      // at a3: T(a1,a3) sends it to a1, then T(a2,a4) fixes a1
                                                      @inner-at-a3 |
                                                        apply(transposition(a1, a3), a3) = a1
                                                        [using specialize transpositionAtSecond(a1, a3)]
                                                      @outer-fixes-a1 |
                                                        apply(transposition(a2, a4), a1) = a1
                                                        [using specialize transpositionElsewhere(a2, a4, a1) a1-not-a2 a1-not-a4]
                                                      @value-at-a3 |
                                                        apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                                                        [using simplify function.composeApply inner-at-a3 outer-fixes-a1]

                                                      // at a5: both factors fix it
                                                      @inner-fixes-a5 |
                                                        apply(transposition(a1, a3), a5) = a5
                                                        [using specialize transpositionElsewhere(a1, a3, a5) a5-not-a1 a5-not-a3]
                                                      @outer-fixes-a5 |
                                                        apply(transposition(a2, a4), a5) = a5
                                                        [using specialize transpositionElsewhere(a2, a4, a5) a5-not-a2 a5-not-a4]
                                                      @value-at-a5 |
                                                        apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5
                                                        [using simplify function.composeApply inner-fixes-a5 outer-fixes-a5]

                                                      @first-two |
                                                        (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                                          and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1)
                                                        [by both value-at-a1 value-at-a3]
                                                      @conclusion-values |
                                                        (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                                          and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                                                          and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                                                        [by both first-two value-at-a5]
                                                    }
                                                  @h8-implies |
                                                    a5 != a4 ->
                                                      (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                                      and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                                                      and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                                                    [by discharge h8]
                                                }
                                              @h7-implies |
                                                a5 != a3 -> a5 != a4 ->
                                                  (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                                  and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                                                  and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                                                [by discharge h7]
                                            }
                                          @h6-implies |
                                            a5 != a2 -> a5 != a3 -> a5 != a4 ->
                                              (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                              and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                                              and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                                            [by discharge h6]
                                        }
                                      @h5-implies |
                                        a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
                                          (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                          and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                                          and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                                        [by discharge h5]
                                    }
                                  @h4-implies |
                                    a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
                                      (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                      and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                                      and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                                    [by discharge h4]
                                }
                              @h3-implies |
                                a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
                                  (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                  and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                                  and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                                [by discharge h3]
                            }
                          @h2-implies |
                            a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
                              (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                              and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                              and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                            [by discharge h2]
                        }
                      @h1-implies |
                        a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
                          (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                          and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                          and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                        [by discharge h1]
                    }
                  @d-a5 |
                    forall a5: Element; a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
                      (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                      and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                      and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                    [by generalize g5]
                }
              @d-a4 |
                forall a4, a5: Element; a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
                  (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                  and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                  and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                [by generalize g4]
            }
          @d-a3 |
            forall a3, a4, a5: Element; a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
              (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
              and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
              and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
            [by generalize g3]
        }
      @d-a2 |
        forall a2, a3, a4, a5: Element; a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
          (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
          and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
          and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
        [by generalize g2]
    }
  @conclusion |
    forall a1, a2, a3, a4, a5: Element; a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 ->
      (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
      and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
      and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
    [by generalize g1]
qed

// JUDSON'S FOURTH CASE, COMPLETE. N containing `sigma = tau (a1a2)(a3a4)` — disjoint
// 2-cycles — contains a 3-cycle, after TWO conjugations.
//
// Step 1: `theTwoCycleCommutatorRegrouped` plus normality and closure put `(a1a3)(a2a4)` in N.
// Step 2: `theDoubleTranspositionsValues` gives that element's point-values, and arm 4 turns
// them into the 3-cycle `(a1, a3, a5)`.
//
// a5 is the fifth point — the one the double transposition fixes — and its four disequalities
// are where n >= 5 is spent in the whole chapter.
//
// Judson's "a further conjugation" is this entire theorem; the two conjugations each need their
// own point-values, step 2's being read off step 1's output rather than off sigma.
theorem judsonsFourthCasePutsAThreeCycleInTheSubgroup(inN(Fn)):
  (forall g2: Fn; forall h2: Fn; alternating.inAlternating(g2) -> inN(h2) ->
  inN(compose(compose(g2, h2), inverse(g2)))) ->
  (forall g2: Fn; inN(g2) -> inN(inverse(g2))) ->
  (forall g2, h2: Fn; inN(g2) -> inN(h2) -> inN(compose(g2, h2))) ->
  forall sigma: Fn; forall a1, a2, a3, a4, a5: Element;
  invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
  inN(compose(transposition(a1, a5), transposition(a1, a3)))
proof
  @given-normal |
    assume forall g2: Fn; forall h2: Fn; alternating.inAlternating(g2) -> inN(h2) ->
      inN(compose(compose(g2, h2), inverse(g2))) {
      @given-inv |
        assume forall g2: Fn; inN(g2) -> inN(inverse(g2)) {
          @given-prod |
            assume forall g2, h2: Fn; inN(g2) -> inN(h2) -> inN(compose(g2, h2)) {
              @normality |
                forall g2: Fn; forall h2: Fn; alternating.inAlternating(g2) -> inN(h2) ->
                  inN(compose(compose(g2, h2), inverse(g2)))
                [by hypothesis given-normal]
              @inverse-closed |
                forall g2: Fn; inN(g2) -> inN(inverse(g2))
                [by hypothesis given-inv]
              @product-closed |
                forall g2, h2: Fn; inN(g2) -> inN(h2) -> inN(compose(g2, h2))
                [by hypothesis given-prod]
              @gs |
                fix sigma: Fn {
                  @g-a1 |
                    fix a1: Element {
                      @g-a2 |
                        fix a2: Element {
                          @g-a3 |
                            fix a3: Element {
                              @g-a4 |
                                fix a4: Element {
                                  @g-a5 |
                                    fix a5: Element {
                                      @hs |
                                        assume invertible(sigma) {
                                          @v1 |
                                            assume apply(inverse(sigma), a1) = a2 {
                                              @v2 |
                                                assume apply(inverse(sigma), a2) = a1 {
                                                  @v3 |
                                                    assume apply(inverse(sigma), a3) = a4 {
                                                      @hn |
                                                        assume inN(sigma) {
                                                          @he1 |
                                                            assume alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) {
                                                              @d12 |
                                                                assume a1 != a2 {
                                                                  @d14 |
                                                                    assume a1 != a4 {
                                                                      @d32 |
                                                                        assume a3 != a2 {
                                                                          @d34 |
                                                                            assume a3 != a4 {
                                                                              @d51 |
                                                                                assume a5 != a1 {
                                                                                  @d52 |
                                                                                    assume a5 != a2 {
                                                                                      @d53 |
                                                                                        assume a5 != a3 {
                                                                                          @d54 |
                                                                                            assume a5 != a4 {
                                                                                              @d13 |
                                                                                                assume a1 != a3 {
                                                                                                  @d15 |
                                                                                                    assume a1 != a5 {
                                                                                                      @d35 |
                                                                                                        assume a3 != a5 {
                                                                                                          @hd |
                                                                                                            assume invertible(compose(transposition(a2, a4), transposition(a1, a3))) {
                                                                                                              @he2 |
                                                                                                                assume alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) {
                                                                                                                  @sigma-is-a-permutation |
                                                                                                                    invertible(sigma)
                                                                                                                    [by hypothesis hs]
                                                                                                                  @im1 |
                                                                                                                    apply(inverse(sigma), a1) = a2
                                                                                                                    [by hypothesis v1]
                                                                                                                  @im2 |
                                                                                                                    apply(inverse(sigma), a2) = a1
                                                                                                                    [by hypothesis v2]
                                                                                                                  @im3 |
                                                                                                                    apply(inverse(sigma), a3) = a4
                                                                                                                    [by hypothesis v3]
                                                                                                                  @sigma-in-n |
                                                                                                                    inN(sigma)
                                                                                                                    [by hypothesis hn]
                                                                                                                  @conj1-even |
                                                                                                                    alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2)))
                                                                                                                    [by hypothesis he1]
                                                                                                                  @a1-not-a2 |
                                                                                                                    a1 != a2
                                                                                                                    [by hypothesis d12]
                                                                                                                  @a1-not-a4 |
                                                                                                                    a1 != a4
                                                                                                                    [by hypothesis d14]
                                                                                                                  @a3-not-a2 |
                                                                                                                    a3 != a2
                                                                                                                    [by hypothesis d32]
                                                                                                                  @a3-not-a4 |
                                                                                                                    a3 != a4
                                                                                                                    [by hypothesis d34]
                                                                                                                  @a5-not-a1 |
                                                                                                                    a5 != a1
                                                                                                                    [by hypothesis d51]
                                                                                                                  @a5-not-a2 |
                                                                                                                    a5 != a2
                                                                                                                    [by hypothesis d52]
                                                                                                                  @a5-not-a3 |
                                                                                                                    a5 != a3
                                                                                                                    [by hypothesis d53]
                                                                                                                  @a5-not-a4 |
                                                                                                                    a5 != a4
                                                                                                                    [by hypothesis d54]
                                                                                                                  @a1-not-a3 |
                                                                                                                    a1 != a3
                                                                                                                    [by hypothesis d13]
                                                                                                                  @a1-not-a5 |
                                                                                                                    a1 != a5
                                                                                                                    [by hypothesis d15]
                                                                                                                  @a3-not-a5 |
                                                                                                                    a3 != a5
                                                                                                                    [by hypothesis d35]
                                                                                                                  @d-is-a-permutation |
                                                                                                                    invertible(compose(transposition(a2, a4), transposition(a1, a3)))
                                                                                                                    [by hypothesis hd]
                                                                                                                  @conj2-even |
                                                                                                                    alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                                                    [by hypothesis he2]

                                                                                                                  // STEP 1: normality and closure put the double transposition in N
                                                                                                                  @sigma-inverse-in-n |
                                                                                                                    inN(inverse(sigma))
                                                                                                                    [using specialize inverse-closed(sigma) sigma-in-n]
                                                                                                                  @the-conjugate-in-n |
                                                                                                                    inN(compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma), inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
                                                                                                                    [using specialize normality(compose(transposition(a1, a3), transposition(a1, a2)), sigma) conj1-even sigma-in-n]
                                                                                                                  @the-product-in-n |
                                                                                                                    inN(compose(inverse(sigma), compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma), inverse(compose(transposition(a1, a3), transposition(a1, a2))))))
                                                                                                                    [using specialize product-closed(inverse(sigma), compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma), inverse(compose(transposition(a1, a3), transposition(a1, a2))))) sigma-inverse-in-n the-conjugate-in-n]
                                                                                                                  @step-one-value |
                                                                                                                    compose(inverse(sigma), compose(compose(compose(transposition(a1, a3), transposition(a1, a2)), sigma), inverse(compose(transposition(a1, a3), transposition(a1, a2)))))
                                                                                                                      = compose(transposition(a2, a4), transposition(a1, a3))
                                                                                                                    [using specialize theTwoCycleCommutatorRegrouped(sigma, a1, a2, a3, a4) sigma-is-a-permutation im1 im2 im3]
                                                                                                                  @the-double-transposition-in-n |
                                                                                                                    inN(compose(transposition(a2, a4), transposition(a1, a3)))
                                                                                                                    [by rewrite step-one-value the-product-in-n]

                                                                                                                  // STEP 2: its point-values, then arm 4
                                                                                                                  @the-values |
                                                                                                                    (apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                                                                                                      and apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                                                                                                                      and apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5)
                                                                                                                    [using specialize theDoubleTranspositionsValues(a1, a2, a3, a4, a5) a1-not-a2 a1-not-a4 a3-not-a2 a3-not-a4 a5-not-a1 a5-not-a2 a5-not-a3 a5-not-a4]
                                                                                                                  @sends-a1 |
                                                                                                                    apply(compose(transposition(a2, a4), transposition(a1, a3)), a1) = a3
                                                                                                                    [using tautology the-values]
                                                                                                                  @sends-a3 |
                                                                                                                    apply(compose(transposition(a2, a4), transposition(a1, a3)), a3) = a1
                                                                                                                    [using tautology the-values]
                                                                                                                  @fixes-a5 |
                                                                                                                    apply(compose(transposition(a2, a4), transposition(a1, a3)), a5) = a5
                                                                                                                    [using tautology the-values]
                                                                                                                  @the-arm |
                                                                                                                    forall b1, b2, b3, b4, b5: Element;
                                                                                                                      b1 != b3 -> b1 != b5 -> b3 != b5 ->
                                                                                                                      b5 != b1 -> b5 != b2 -> b5 != b3 -> b5 != b4 ->
                                                                                                                      apply(compose(transposition(b2, b4), transposition(b1, b3)), b1) = b3 ->
                                                                                                                      apply(compose(transposition(b2, b4), transposition(b1, b3)), b3) = b1 ->
                                                                                                                      apply(compose(transposition(b2, b4), transposition(b1, b3)), b5) = b5 ->
                                                                                                                      invertible(compose(transposition(b2, b4), transposition(b1, b3))) ->
                                                                                                                      inN(compose(transposition(b2, b4), transposition(b1, b3))) ->
                                                                                                                      alternating.inAlternating(compose(transposition(b1, b5), transposition(b1, b3))) ->
                                                                                                                      inN(compose(transposition(b1, b5), transposition(b1, b3)))
                                                                                                                    [using instantiation disjointTwoCyclesPutAThreeCycleInTheSubgroup((fun g2: Fn => inN(g2))) normality inverse-closed product-closed]
                                                                                                                  @conclusion-fourth-case |
                                                                                                                    inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                                                    [using specialize the-arm(a1, a2, a3, a4, a5) a1-not-a3 a1-not-a5 a3-not-a5 a5-not-a1 a5-not-a2 a5-not-a3 a5-not-a4 sends-a1 sends-a3 fixes-a5 d-is-a-permutation the-double-transposition-in-n conj2-even]
                                                                                                                }
                                                                                                              @he2-implies |
                                                                                                                alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                                                                  inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                                                [by discharge he2]
                                                                                                            }
                                                                                                          @hd-implies |
                                                                                                            invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                                                              inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                                            [by discharge hd]
                                                                                                        }
                                                                                                      @d35-implies |
                                                                                                        a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                                                          inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                                        [by discharge d35]
                                                                                                    }
                                                                                                  @d15-implies |
                                                                                                    a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                                                      inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                                    [by discharge d15]
                                                                                                }
                                                                                              @d13-implies |
                                                                                                a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                                                  inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                                [by discharge d13]
                                                                                            }
                                                                                          @d54-implies |
                                                                                            a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                                              inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                            [by discharge d54]
                                                                                        }
                                                                                      @d53-implies |
                                                                                        a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                                          inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                        [by discharge d53]
                                                                                    }
                                                                                  @d52-implies |
                                                                                    a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                                      inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                    [by discharge d52]
                                                                                }
                                                                              @d51-implies |
                                                                                a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                                  inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                                [by discharge d51]
                                                                            }
                                                                          @d34-implies |
                                                                            a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                              inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                            [by discharge d34]
                                                                        }
                                                                      @d32-implies |
                                                                        a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                          inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                        [by discharge d32]
                                                                    }
                                                                  @d14-implies |
                                                                    a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                      inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                    [by discharge d14]
                                                                }
                                                              @d12-implies |
                                                                a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                                  inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                                [by discharge d12]
                                                            }
                                                          @he1-implies |
                                                            alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                              inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                            [by discharge he1]
                                                        }
                                                      @hn-implies |
                                                        inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                          inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                        [by discharge hn]
                                                    }
                                                  @v3-implies |
                                                    apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                      inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                    [by discharge v3]
                                                }
                                              @v2-implies |
                                                apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                                  inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                                [by discharge v2]
                                            }
                                          @v1-implies |
                                            apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                              inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                            [by discharge v1]
                                        }
                                      @hs-implies |
                                        invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                          inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                        [by discharge hs]
                                    }
                                  @d-a5 |
                                    forall a5: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                      inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                    [by generalize g-a5]
                                }
                              @d-a4 |
                                forall a4, a5: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                                  inN(compose(transposition(a1, a5), transposition(a1, a3)))
                                [by generalize g-a4]
                            }
                          @d-a3 |
                            forall a3, a4, a5: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                              inN(compose(transposition(a1, a5), transposition(a1, a3)))
                            [by generalize g-a3]
                        }
                      @d-a2 |
                        forall a2, a3, a4, a5: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                          inN(compose(transposition(a1, a5), transposition(a1, a3)))
                        [by generalize g-a2]
                    }
                  @d-a1 |
                    forall a1, a2, a3, a4, a5: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                      inN(compose(transposition(a1, a5), transposition(a1, a3)))
                    [by generalize g-a1]
                }
              @all-cases |
                forall sigma: Fn; forall a1, a2, a3, a4, a5: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
                  inN(compose(transposition(a1, a5), transposition(a1, a3)))
                [by generalize gs]
            }
          @prod-implies |
            (forall g2, h2: Fn; inN(g2) -> inN(h2) -> inN(compose(g2, h2))) ->
              forall sigma: Fn; forall a1, a2, a3, a4, a5: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
              inN(compose(transposition(a1, a5), transposition(a1, a3)))
            [by discharge given-prod]
        }
      @inv-implies |
        (forall g2: Fn; inN(g2) -> inN(inverse(g2))) ->
          (forall g2, h2: Fn; inN(g2) -> inN(h2) -> inN(compose(g2, h2))) ->
          forall sigma: Fn; forall a1, a2, a3, a4, a5: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
          inN(compose(transposition(a1, a5), transposition(a1, a3)))
        [by discharge given-inv]
    }
  @conclusion |
    (forall g2: Fn; forall h2: Fn; alternating.inAlternating(g2) -> inN(h2) ->
      inN(compose(compose(g2, h2), inverse(g2)))) ->
      (forall g2: Fn; inN(g2) -> inN(inverse(g2))) ->
      (forall g2, h2: Fn; inN(g2) -> inN(h2) -> inN(compose(g2, h2))) ->
      forall sigma: Fn; forall a1, a2, a3, a4, a5: Element; invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> inN(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
      inN(compose(transposition(a1, a5), transposition(a1, a3)))
    [by discharge given-normal]
qed

// Exercised at N = A_n.
theorem theAlternatingGroupGetsAThreeCycleFromJudsonsFourthCase:
  forall sigma: Fn; forall a1, a2, a3, a4, a5: Element;
  invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> alternating.inAlternating(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
  alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3)))
proof
  @normal |
    forall g2: Fn; forall h2: Fn; alternating.inAlternating(g2) -> alternating.inAlternating(h2) ->
      alternating.inAlternating(compose(compose(g2, h2), inverse(g2)))
    [by cite alternating.theAlternatingGroupIsClosedUnderConjugation]
  @invclosed |
    forall g2: Fn; alternating.inAlternating(g2) -> alternating.inAlternating(inverse(g2))
    [by cite alternating.theAlternatingGroupIsClosedUnderInverses]
  @prodclosed |
    forall g2, h2: Fn; alternating.inAlternating(g2) -> alternating.inAlternating(h2) ->
      alternating.inAlternating(compose(g2, h2))
    [by cite alternating.theAlternatingGroupIsClosedUnderComposition]
  @conclusion |
    forall sigma: Fn; forall a1, a2, a3, a4, a5: Element;
      invertible(sigma) -> apply(inverse(sigma), a1) = a2 -> apply(inverse(sigma), a2) = a1 -> apply(inverse(sigma), a3) = a4 -> alternating.inAlternating(sigma) -> alternating.inAlternating(compose(transposition(a1, a3), transposition(a1, a2))) -> a1 != a2 -> a1 != a4 -> a3 != a2 -> a3 != a4 -> a5 != a1 -> a5 != a2 -> a5 != a3 -> a5 != a4 -> a1 != a3 -> a1 != a5 -> a3 != a5 -> invertible(compose(transposition(a2, a4), transposition(a1, a3))) -> alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3))) ->
      alternating.inAlternating(compose(transposition(a1, a5), transposition(a1, a3)))
    [using instantiation judsonsFourthCasePutsAThreeCycleInTheSubgroup((fun g2: Fn => alternating.inAlternating(g2))) normal invclosed prodclosed]
qed
