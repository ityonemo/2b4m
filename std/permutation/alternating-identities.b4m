                  and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(succ(ZERO)))
                  and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, ZERO)
                  and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
                  and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s1, succ(succ(ZERO)))
                  and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, ZERO)
                  and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, succ(succ(ZERO)))
                  and permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, ZERO)
                  and permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, succ(succ(ZERO)))
                  and permutation_cycle.at(s2, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
                  and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, ZERO)) = permutation_cycle.at(s1, succ(succ(ZERO)))
                  and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, succ(ZERO))) = permutation_cycle.at(s1, ZERO)
                  and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s2, ZERO)) = permutation_cycle.at(s2, succ(succ(ZERO))))
                [by discharge hs]
            }
          @discharge-s2 |
            forall s2: Points; invertible(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> invertible(permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> invertible(permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_cycle.distinct(s1, succ(succ(succ(ZERO)))) -> permutation_cycle.distinct(s2, succ(succ(succ(ZERO)))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) ->
              (permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(ZERO))
              and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(succ(ZERO)))
              and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, ZERO)
              and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
              and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s1, succ(succ(ZERO)))
              and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, ZERO)
              and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, succ(succ(ZERO)))
              and permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, ZERO)
              and permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, succ(succ(ZERO)))
              and permutation_cycle.at(s2, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
              and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, ZERO)) = permutation_cycle.at(s1, succ(succ(ZERO)))
              and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, succ(ZERO))) = permutation_cycle.at(s1, ZERO)
              and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s2, ZERO)) = permutation_cycle.at(s2, succ(succ(ZERO))))
            [by generalize gs2]
        }
      @discharge-s1 |
        forall s1: Points; forall s2: Points; invertible(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> invertible(permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> invertible(permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_cycle.distinct(s1, succ(succ(succ(ZERO)))) -> permutation_cycle.distinct(s2, succ(succ(succ(ZERO)))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) ->
          (permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(ZERO))
          and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(succ(ZERO)))
          and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, ZERO)
          and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
          and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s1, succ(succ(ZERO)))
          and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, ZERO)
          and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, succ(succ(ZERO)))
          and permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, ZERO)
          and permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, succ(succ(ZERO)))
          and permutation_cycle.at(s2, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
          and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, ZERO)) = permutation_cycle.at(s1, succ(succ(ZERO)))
          and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, succ(ZERO))) = permutation_cycle.at(s1, ZERO)
          and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s2, ZERO)) = permutation_cycle.at(s2, succ(succ(ZERO))))
        [by generalize gs1]
    }
  @conclusion |
    forall rho: Fn; forall s1: Points; forall s2: Points; invertible(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> invertible(permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> invertible(permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_cycle.distinct(s1, succ(succ(succ(ZERO)))) -> permutation_cycle.distinct(s2, succ(succ(succ(ZERO)))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) ->
      (permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(ZERO))
      and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(succ(ZERO)))
      and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, ZERO)
      and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
      and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s1, succ(succ(ZERO)))
      and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, ZERO)
      and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, succ(succ(ZERO)))
      and permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, ZERO)
      and permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, succ(succ(ZERO)))
      and permutation_cycle.at(s2, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
      and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, ZERO)) = permutation_cycle.at(s1, succ(succ(ZERO)))
      and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, succ(ZERO))) = permutation_cycle.at(s1, ZERO)
      and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s2, ZERO)) = permutation_cycle.at(s2, succ(succ(ZERO))))
    [by generalize gr]
qed

// JUDSON'S SECOND CASE, COMPLETE. N containing `sigma = tau (a1 a2 a3)(a4 a5 a6)` — two
// disjoint 3-cycles — contains a 5-CYCLE. That is his case 2's conclusion, and the 5-cycle is
// case 1's shape, which is what makes his analysis terminate rather than recurse.
//
// The bridge supplies the point-values; arm 2 supplies the membership.
theorem judsonsSecondCasePutsAFiveCycleInTheSubgroup(inN(Fn)):
  (forall g2: Fn; forall h2: Fn; alternating.inAlternating(g2) -> inN(h2) ->
  inN(compose(compose(g2, h2), inverse(g2)))) ->
  (forall g2: Fn; inN(g2) -> inN(inverse(g2))) ->
  (forall g2, h2: Fn; inN(g2) -> inN(h2) -> inN(compose(g2, h2))) ->
  forall rho: Fn; forall s1: Points; forall s2: Points;
  invertible(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> invertible(permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> invertible(permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_cycle.distinct(s1, succ(succ(succ(ZERO)))) -> permutation_cycle.distinct(s2, succ(succ(succ(ZERO)))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> permutation_decomposition.disjointSupports(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) -> inN(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) -> alternating.inAlternating(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))))) ->
  inN(compose(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(succ(ZERO)))), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, succ(succ(ZERO))))),
  compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)))))
proof
  @given-normal |
    assume forall g2: Fn; forall h2: Fn; alternating.inAlternating(g2) -> inN(h2) ->
      inN(compose(compose(g2, h2), inverse(g2))) {
      @given-inv |
        assume forall g2: Fn; inN(g2) -> inN(inverse(g2)) {
          @given-prod |
            assume forall g2, h2: Fn; inN(g2) -> inN(h2) -> inN(compose(g2, h2)) {
              @normality |
                forall g2: Fn; forall h2: Fn; alternating.inAlternating(g2) -> inN(h2) ->
                  inN(compose(compose(g2, h2), inverse(g2)))
                [by hypothesis given-normal]
              @inverse-closed |
                forall g2: Fn; inN(g2) -> inN(inverse(g2))
                [by hypothesis given-inv]
              @product-closed |
                forall g2, h2: Fn; inN(g2) -> inN(h2) -> inN(compose(g2, h2))
                [by hypothesis given-prod]
              @gr |
                fix rho: Fn {
                  @gs1 |
                    fix s1: Points {
                      @gs2 |
                        fix s2: Points {
                          @hs |
                            assume invertible(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) {
                              @h1 |
                                assume invertible(permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) {
                                  @h2 |
                                    assume invertible(permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) {
                                      @hd1 |
                                        assume permutation_cycle.distinct(s1, succ(succ(succ(ZERO)))) {
                                          @hd2 |
                                            assume permutation_cycle.distinct(s2, succ(succ(succ(ZERO)))) {
                                              @hj1 |
                                                assume permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) {
                                                  @hj2 |
                                                    assume permutation_decomposition.disjointSupports(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))) {
                                                      @hj3 |
                                                        assume permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) {
                                                          @hj4 |
                                                            assume permutation_decomposition.disjointSupports(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s2, succ(succ(succ(ZERO))))) {
                                                              @hn |
                                                                assume inN(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))) {
                                                                  @he |
                                                                    assume alternating.inAlternating(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO))))) {
                                                                      @sigma-is-a-permutation |
                                                                        invertible(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))))))
                                                                        [by hypothesis hs]
                                                                      @c1-is-a-permutation |
                                                                        invertible(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))))
                                                                        [by hypothesis h1]
                                                                      @c2-is-a-permutation |
                                                                        invertible(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))))
                                                                        [by hypothesis h2]
                                                                      @distinct1 |
                                                                        permutation_cycle.distinct(s1, succ(succ(succ(ZERO))))
                                                                        [by hypothesis hd1]
                                                                      @distinct2 |
                                                                        permutation_cycle.distinct(s2, succ(succ(succ(ZERO))))
                                                                        [by hypothesis hd2]
                                                                      @rho-disjoint-c1 |
                                                                        permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))))
                                                                        [by hypothesis hj1]
                                                                      @c2-disjoint-c1 |
                                                                        permutation_decomposition.disjointSupports(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))))
                                                                        [by hypothesis hj2]
                                                                      @rho-disjoint-c2 |
                                                                        permutation_decomposition.disjointSupports(rho, permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))))
                                                                        [by hypothesis hj3]
                                                                      @c1-disjoint-c2 |
                                                                        permutation_decomposition.disjointSupports(permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))))
                                                                        [by hypothesis hj4]
                                                                      @sigma-in-n |
                                                                        inN(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO)))))))
                                                                        [by hypothesis hn]
                                                                      @the-conjugator-is-even |
                                                                        alternating.inAlternating(compose(transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s2, ZERO)), transposition(permutation_cycle.at(s1, ZERO), permutation_cycle.at(s1, succ(ZERO)))))
                                                                        [by hypothesis he]

                                                                      // the shape gives arm 2's pattern
                                                                      @the-pattern |
                                                                        (permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(ZERO))
                                                                          and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(succ(ZERO)))
                                                                          and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, ZERO)
                                                                          and permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
                                                                          and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s1, succ(succ(ZERO)))
                                                                          and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, ZERO)
                                                                          and permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, succ(succ(ZERO)))
                                                                          and permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, ZERO)
                                                                          and permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, succ(succ(ZERO)))
                                                                          and permutation_cycle.at(s2, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
                                                                          and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, ZERO)) = permutation_cycle.at(s1, succ(succ(ZERO)))
                                                                          and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, succ(ZERO))) = permutation_cycle.at(s1, ZERO)
                                                                          and apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s2, ZERO)) = permutation_cycle.at(s2, succ(succ(ZERO))))
                                                                        [using specialize aTwoThreeCycleFactorGivesTheSecondPattern(rho, s1, s2) sigma-is-a-permutation c1-is-a-permutation c2-is-a-permutation distinct1 distinct2 rho-disjoint-c1 c2-disjoint-c1 rho-disjoint-c2 c1-disjoint-c2]
                                                                      @d0 |
                                                                        permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(ZERO))
                                                                        [using tautology the-pattern]
                                                                      @d1 |
                                                                        permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s1, succ(succ(ZERO)))
                                                                        [using tautology the-pattern]
                                                                      @d2 |
                                                                        permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, ZERO)
                                                                        [using tautology the-pattern]
                                                                      @d3 |
                                                                        permutation_cycle.at(s1, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
                                                                        [using tautology the-pattern]
                                                                      @d4 |
                                                                        permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s1, succ(succ(ZERO)))
                                                                        [using tautology the-pattern]
                                                                      @d5 |
                                                                        permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, ZERO)
                                                                        [using tautology the-pattern]
                                                                      @d6 |
                                                                        permutation_cycle.at(s1, succ(ZERO)) != permutation_cycle.at(s2, succ(succ(ZERO)))
                                                                        [using tautology the-pattern]
                                                                      @d7 |
                                                                        permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, ZERO)
                                                                        [using tautology the-pattern]
                                                                      @d8 |
                                                                        permutation_cycle.at(s1, succ(succ(ZERO))) != permutation_cycle.at(s2, succ(succ(ZERO)))
                                                                        [using tautology the-pattern]
                                                                      @d9 |
                                                                        permutation_cycle.at(s2, ZERO) != permutation_cycle.at(s2, succ(succ(ZERO)))
                                                                        [using tautology the-pattern]
                                                                      @iv1 |
                                                                        apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, ZERO)) = permutation_cycle.at(s1, succ(succ(ZERO)))
                                                                        [using tautology the-pattern]
                                                                      @iv2 |
                                                                        apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s1, succ(ZERO))) = permutation_cycle.at(s1, ZERO)
                                                                        [using tautology the-pattern]
                                                                      @iv3 |
                                                                        apply(inverse(compose(rho, compose(permutation_cycle.cycle(s2, succ(succ(succ(ZERO)))), permutation_cycle.cycle(s1, succ(succ(succ(ZERO))))))), permutation_cycle.at(s2, ZERO)) = permutation_cycle.at(s2, succ(succ(ZERO)))
                                                                        [using tautology the-pattern]

                                                                      // arm 2
                                                                      @the-arm |
                                                                        forall sigma2: Fn; forall b1, b2, b3, b4, b6: Element;
