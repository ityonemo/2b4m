// std/permutation/sequence.b4m — SEQUENCES OF PERMUTATIONS and their finite products.
//
// A product of permutations τ₁ τ₂ ⋯ τ_n is what the parity theory of transpositions
// reasons about. The sequence sort is declared here with the same postulates as
// std/group/sequence.b4m states for a group (a fresh sort inherits none of them), with
// every entry an invertible map, and then std/group/sequence.b4m is MODELED onto the
// permutations — a GUARDED model, since `Perm` is `Fn where invertible` — so its product
// laws transfer. The model block names entities from two theories (group_sequence's and
// group's): a model is an overlay over the whole universe, and the transferred proofs
// borrow group theorems (inverseUnique, invProduct) through group_sequence's aliases.

import permutation <<< "std/permutation.b4m"
import function <<< "std/function.b4m"
import function_invertible <<< "std/function/invertible.b4m"
import group <<< "std/group.b4m"
import group_sequence <<< "std/group/sequence.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

sort Element = function.Element
sort Fn = function.Fn
func apply = function.apply
sort Perm = permutation.Perm
const identityFn = function.identityFn
func compose = function.compose
func inverse = function.inverse
pred invertible = function.invertible
axiom inverseLeft = function.inverseLeft
theorem identityIsAPermutation = permutation.identityIsAPermutation
theorem composeIsAPermutation = permutation.composeIsAPermutation
theorem inverseIsAPermutation = permutation.inverseIsAPermutation
theorem composeAssoc = function_invertible.composeAssoc
theorem composeIdentityLeft = function_invertible.composeIdentityLeft
theorem composeIdentityRight = function_invertible.composeIdentityRight
axiom inverseRight = function.inverseRight

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
func sub = peano.sub
pred less_than = peano.less_than
define at_most(a, b) = peano.less_or_equal(a, b)
axiom induction = peano.induction
theorem addZeroRight = peano.addZeroRight
theorem lessThanSuccSplit = peano_order.lessThanSuccSplit
theorem lessThanSelf = peano_order.lessThanSelf
theorem notLessThanZero = peano_order.notLessThanZero

// -- sequences of permutations ------------------------------------------------------

sort Seq
func at(s: Seq, i: Nat) => Fn
// every entry is a permutation
axiom atIsAPermutation: forall s: Seq; forall i: Nat; invertible(at(s, i))

// the product of the first k entries, left to right
func productUpTo(s: Seq, k: Nat) => Fn
axiom productUpToZero: forall s: Seq; productUpTo(s, ZERO) = identityFn
axiom productUpToSucc: forall s: Seq; forall k: Nat; productUpTo(s, succ(k)) = compose(productUpTo(s, k), at(s, k))

// the reversed product of inverses (a prepend fold, as in std/group/sequence.b4m)
func revProductUpTo(s: Seq, k: Nat) => Fn
axiom revProductZero: forall s: Seq; revProductUpTo(s, ZERO) = identityFn
axiom revProductSucc: forall s: Seq; forall k: Nat; revProductUpTo(s, succ(k)) = compose(inverse(at(s, k)), revProductUpTo(s, k))

// Products of permutations are permutations — the closure facts the guarded model needs.
theorem productUpToIsAPermutation: forall s: Seq; forall k: Nat; invertible(productUpTo(s, k))
proof
  @generalize-s |
    fix s: Seq {
      @product-at-zero |
        productUpTo(s, ZERO) = identityFn
        [using specialize productUpToZero(s)]
      @identity-is-a-permutation |
        invertible(identityFn)
        [by cite identityIsAPermutation]
      @base-case |
        invertible(productUpTo(s, ZERO))
        [by rewrite product-at-zero identity-is-a-permutation]
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume invertible(productUpTo(s, k)) {
              @inductive-hypothesis |
                invertible(productUpTo(s, k))
                [by hypothesis given-inductive-hypothesis]
              @entry-is-a-permutation |
                invertible(at(s, k))
                [using specialize atIsAPermutation(s, k)]
              @composite-is-a-permutation |
                invertible(compose(productUpTo(s, k), at(s, k)))
                [using specialize composeIsAPermutation(productUpTo(s, k), at(s, k)) inductive-hypothesis entry-is-a-permutation]
              @product-at-successor |
                productUpTo(s, succ(k)) = compose(productUpTo(s, k), at(s, k))
                [using specialize productUpToSucc(s, k)]
              @conclusion-successor-is-a-permutation |
                invertible(productUpTo(s, succ(k)))
                [by rewrite product-at-successor composite-is-a-permutation]
            }
          @induction-step-at-k |
            invertible(productUpTo(s, k)) -> invertible(productUpTo(s, succ(k)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; invertible(productUpTo(s, k)) -> invertible(productUpTo(s, succ(k)))
        [by generalize induction-step]
      @conclusion-for-all-k |
        forall k: Nat; invertible(productUpTo(s, k))
        [using instantiation induction((fun k: Nat => invertible(productUpTo(s, k)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Seq; forall k: Nat; invertible(productUpTo(s, k))
    [by generalize generalize-s]
qed

theorem revProductUpToIsAPermutation: forall s: Seq; forall k: Nat; invertible(revProductUpTo(s, k))
proof
  @generalize-s |
    fix s: Seq {
      @product-at-zero |
        revProductUpTo(s, ZERO) = identityFn
        [using specialize revProductZero(s)]
      @identity-is-a-permutation |
        invertible(identityFn)
        [by cite identityIsAPermutation]
      @base-case |
        invertible(revProductUpTo(s, ZERO))
        [by rewrite product-at-zero identity-is-a-permutation]
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume invertible(revProductUpTo(s, k)) {
              @inductive-hypothesis |
                invertible(revProductUpTo(s, k))
                [by hypothesis given-inductive-hypothesis]
              @entry-is-a-permutation |
                invertible(at(s, k))
                [using specialize atIsAPermutation(s, k)]
              @entry-inverse-is-a-permutation |
                invertible(inverse(at(s, k)))
                [using specialize inverseIsAPermutation(at(s, k)) entry-is-a-permutation]
              @composite-is-a-permutation |
                invertible(compose(inverse(at(s, k)), revProductUpTo(s, k)))
                [using specialize composeIsAPermutation(inverse(at(s, k)), revProductUpTo(s, k)) entry-inverse-is-a-permutation inductive-hypothesis]
              @product-at-successor |
                revProductUpTo(s, succ(k)) = compose(inverse(at(s, k)), revProductUpTo(s, k))
                [using specialize revProductSucc(s, k)]
              @conclusion-successor-is-a-permutation |
                invertible(revProductUpTo(s, succ(k)))
                [by rewrite product-at-successor composite-is-a-permutation]
            }
          @induction-step-at-k |
            invertible(revProductUpTo(s, k)) -> invertible(revProductUpTo(s, succ(k)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; invertible(revProductUpTo(s, k)) -> invertible(revProductUpTo(s, succ(k)))
        [by generalize induction-step]
      @conclusion-for-all-k |
        forall k: Nat; invertible(revProductUpTo(s, k))
        [using instantiation induction((fun k: Nat => invertible(revProductUpTo(s, k)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Seq; forall k: Nat; invertible(revProductUpTo(s, k))
    [by generalize generalize-s]
qed

// -- the sequence-BUILDING postulates, for permutations -------------------------------
//
// The same shape as std/group/sequence.b4m's, with the group's element sort read as
// "a permutation": a binder over a group element becomes a Fn binder guarded by
// `invertible`. Only the postulates the parity theory of transpositions uses are stated
// (singleton, prepend, concatenation, reversal); removal can be restated from the group file's
// when a consumer needs it — a library carries no axiom nothing in it rests on.

axiom seqSingleton: forall x: Fn; invertible(x) ->
  exists s: Seq; at(s, ZERO) = x and productUpTo(s, succ(ZERO)) = x

// the prepend x :: s: head x (a permutation), tail s shifted up by one
axiom seqPrepend: forall x: Fn; invertible(x) -> forall s: Seq;
  exists u: Seq; at(u, ZERO) = x and (forall i: Nat; at(u, succ(i)) = at(s, i))

axiom seqConcat: forall s: Seq; forall t: Seq; forall j: Nat; forall k: Nat;
  exists u: Seq;
  (forall i: Nat; less_than(i, j) -> at(u, i) = at(s, i))
  and (forall i: Nat; less_than(i, k) -> at(u, add(j, i)) = at(t, i))
  and productUpTo(u, add(j, k)) = compose(productUpTo(s, j), productUpTo(t, k))

axiom seqReverse: forall s: Seq; forall n: Nat;
  exists r: Seq;
  (forall i: Nat; less_than(i, n) -> at(r, i) = at(s, sub(n, succ(i))))
  and productUpTo(r, n) = revProductUpTo(s, n)

// -- two inverse laws over plain maps ---------------------------------------------------
//
// Stated over `Fn` with `invertible` as a HYPOTHESIS (not over `Perm`), so a consumer can
// apply them at a composite term whose invertibility it has in hand — a product, say.

// A left inverse IS the inverse: k = k(h h⁻¹) = (k h) h⁻¹ = h⁻¹.
theorem leftInverseIsTheInverse: forall h: Fn; forall k: Fn;
  invertible(h) -> compose(k, h) = identityFn -> k = inverse(h)
proof
  @generalize-h |
    fix h: Fn {
      @generalize-k |
        fix k: Fn {
          @given-invertible |
            assume invertible(h) {
              @given-left-inverse |
                assume compose(k, h) = identityFn {
                  @h-is-invertible |
                    invertible(h)
                    [by hypothesis given-invertible]
                  @k-undoes-h |
                    compose(k, h) = identityFn
                    [by hypothesis given-left-inverse]
                  @h-undoes-its-inverse |
                    compose(h, inverse(h)) = identityFn
                    [using specialize inverseRight(h) h-is-invertible]
                  @k-times-identity |
                    compose(k, identityFn) = k
                    [using specialize composeIdentityRight(k)]
                  @k-is-k-times-identity |
                    k = compose(k, identityFn)
                    [by symmetry k-times-identity]
                  @k-is-k-times-h-times-inverse |
                    k = compose(k, compose(h, inverse(h)))
                    [by rewrite h-undoes-its-inverse k-is-k-times-identity]
                  @reassociated |
                    compose(compose(k, h), inverse(h)) = compose(k, compose(h, inverse(h)))
                    [using specialize composeAssoc(k, h, inverse(h))]
                  @reassociated-flipped |
                    compose(k, compose(h, inverse(h))) = compose(compose(k, h), inverse(h))
                    [by symmetry reassociated]
                  @left-pair-cancels |
                    compose(k, compose(h, inverse(h))) = compose(identityFn, inverse(h))
                    [by rewrite k-undoes-h reassociated-flipped]
                  @identity-drops |
                    compose(identityFn, inverse(h)) = inverse(h)
                    [using specialize composeIdentityLeft(inverse(h))]
                  @conclusion-k-is-the-inverse |
                    k = inverse(h)
                    [using chain k-is-k-times-h-times-inverse left-pair-cancels identity-drops]
                }
              @conclusion-left-inverse |
                compose(k, h) = identityFn -> k = inverse(h)
                [by discharge given-left-inverse]
            }
          @conclusion-invertible |
            invertible(h) -> compose(k, h) = identityFn -> k = inverse(h)
            [by discharge given-invertible]
        }
      @discharge-k |
        forall k: Fn; invertible(h) -> compose(k, h) = identityFn -> k = inverse(h)
        [by generalize generalize-k]
    }
  @conclusion |
    forall h: Fn; forall k: Fn; invertible(h) -> compose(k, h) = identityFn -> k = inverse(h)
    [by generalize generalize-h]
qed

// (g f)⁻¹ = f⁻¹ g⁻¹: f⁻¹ g⁻¹ is a left inverse of g f, and left inverses are the inverse.
theorem inverseOfComposite: forall g: Fn; forall f: Fn;
  invertible(g) -> invertible(f) -> inverse(compose(g, f)) = compose(inverse(f), inverse(g))
proof
  @generalize-g |
    fix g: Fn {
      @generalize-f |
        fix f: Fn {
          @given-g |
            assume invertible(g) {
              @given-f |
                assume invertible(f) {
                  @g-is-invertible |
                    invertible(g)
                    [by hypothesis given-g]
                  @f-is-invertible |
                    invertible(f)
                    [by hypothesis given-f]
                  @composite-is-invertible |
                    invertible(compose(g, f))
                    [using specialize composeIsAPermutation(g, f) g-is-invertible f-is-invertible]
                  @g-inverse-undoes-g |
                    compose(inverse(g), g) = identityFn
                    [using specialize inverseLeft(g) g-is-invertible]
                  @f-inverse-undoes-f |
                    compose(inverse(f), f) = identityFn
                    [using specialize inverseLeft(f) f-is-invertible]
                  // (f⁻¹ g⁻¹)(g f) = f⁻¹ (g⁻¹ (g f)) = f⁻¹ ((g⁻¹ g) f) = f⁻¹ (id f) = f⁻¹ f = id
                  @outer-associated |
                    compose(compose(inverse(f), inverse(g)), compose(g, f)) = compose(inverse(f), compose(inverse(g), compose(g, f)))
                    [using specialize composeAssoc(inverse(f), inverse(g), compose(g, f))]
                  @inner-associated |
                    compose(compose(inverse(g), g), f) = compose(inverse(g), compose(g, f))
                    [using specialize composeAssoc(inverse(g), g, f)]
                  @inner-associated-flipped |
                    compose(inverse(g), compose(g, f)) = compose(compose(inverse(g), g), f)
                    [by symmetry inner-associated]
                  @inner-cancels |
                    compose(inverse(g), compose(g, f)) = compose(identityFn, f)
                    [by rewrite g-inverse-undoes-g inner-associated-flipped]
                  @identity-drops |
                    compose(identityFn, f) = f
                    [using specialize composeIdentityLeft(f)]
                  @inner-is-f |
                    compose(inverse(g), compose(g, f)) = f
                    [using chain inner-cancels identity-drops]
                  @outer-is-f-inverse-f |
                    compose(compose(inverse(f), inverse(g)), compose(g, f)) = compose(inverse(f), f)
                    [by rewrite inner-is-f outer-associated]
                  @candidate-is-a-left-inverse |
                    compose(compose(inverse(f), inverse(g)), compose(g, f)) = identityFn
                    [using chain outer-is-f-inverse-f f-inverse-undoes-f]
                  @conclusion-candidate-is-the-inverse |
                    compose(inverse(f), inverse(g)) = inverse(compose(g, f))
                    [using specialize leftInverseIsTheInverse(compose(g, f), compose(inverse(f), inverse(g))) composite-is-invertible candidate-is-a-left-inverse]
                  @conclusion-flipped |
                    inverse(compose(g, f)) = compose(inverse(f), inverse(g))
                    [by symmetry conclusion-candidate-is-the-inverse]
                }
              @conclusion-f |
                invertible(f) -> inverse(compose(g, f)) = compose(inverse(f), inverse(g))
                [by discharge given-f]
            }
          @conclusion-g |
            invertible(g) -> invertible(f) -> inverse(compose(g, f)) = compose(inverse(f), inverse(g))
            [by discharge given-g]
        }
      @discharge-f |
        forall f: Fn; invertible(g) -> invertible(f) -> inverse(compose(g, f)) = compose(inverse(f), inverse(g))
        [by generalize generalize-f]
    }
  @conclusion |
    forall g: Fn; forall f: Fn; invertible(g) -> invertible(f) -> inverse(compose(g, f)) = compose(inverse(f), inverse(g))
    [by generalize generalize-g]
qed

// -- the model: sequences of permutations ARE group sequences ----------------------------
//
// Mapping std/group/sequence.b4m's element sort onto `Perm` makes the model guarded: every
// mapped func nominates the closure fact that keeps its results invertible (`-|`), the
// identity its base fact, and the group axioms the group_sequence proofs rest on are
// discharged by the function library's laws — `group.opAssoc` is named directly, since
// group_sequence borrows it without aliasing it.
model PermSeq {
  group_sequence.Grp: Perm
  group_sequence.E: identityFn(identityIsAPermutation)
  group_sequence.op: compose -| composeIsAPermutation
  group_sequence.inverse: inverse -| inverseIsAPermutation
  group_sequence.Seq: Seq
  group_sequence.at: at -| atIsAPermutation
  group_sequence.productUpTo: productUpTo -| productUpToIsAPermutation
  group_sequence.revProductUpTo: revProductUpTo -| revProductUpToIsAPermutation
  group_sequence.productUpToZero <- productUpToZero
  group_sequence.productUpToSucc <- productUpToSucc
  group_sequence.revProductZero <- revProductZero
  group_sequence.revProductSucc <- revProductSucc
  group_sequence.seqSingleton <- seqSingleton
  group_sequence.seqConcat <- seqConcat
  group_sequence.seqReverse <- seqReverse
  group_sequence.opIdentityLeft <- composeIdentityLeft
  group.opAssoc <- composeAssoc
  group.opInverseLeft <- inverseLeft
}

// -- the product laws, transferred ---------------------------------------------------------

// The identity is its own inverse.
theorem inverseOfIdentity: inverse(identityFn) = identityFn
proof
  @conclusion |
    inverse(identityFn) = identityFn
    [using model(PermSeq) group_sequence.inverseIdentity]
qed

// (g₀ ⋯ gₙ₋₁)⁻¹ = gₙ₋₁⁻¹ ⋯ g₀⁻¹ for permutations.
theorem invOfProduct: forall s: Seq; forall n: Nat;
  inverse(productUpTo(s, n)) = revProductUpTo(s, n)
proof
  @conclusion |
    forall s: Seq; forall n: Nat; inverse(productUpTo(s, n)) = revProductUpTo(s, n)
    [using model(PermSeq) group_sequence.invOfProduct]
qed

// -- the product of a prepended sequence -------------------------------------------------------

// The product of the first n+1 entries of x :: s is x times the product of s's first n: the
// left fold peels its last factor, and associativity moves x to the front. Induction on n.
theorem productOfPrepend: forall x: Fn; forall s: Seq; forall u: Seq;
  at(u, ZERO) = x -> (forall i: Nat; at(u, succ(i)) = at(s, i)) ->
  forall n: Nat; productUpTo(u, succ(n)) = compose(x, productUpTo(s, n))
proof
  @generalize-x |
    fix x: Fn {
      @generalize-s |
        fix s: Seq {
          @generalize-u |
            fix u: Seq {
              @given-head |
                assume at(u, ZERO) = x {
                  @given-tail |
                    assume forall i: Nat; at(u, succ(i)) = at(s, i) {
                      @head |
                        at(u, ZERO) = x
                        [by hypothesis given-head]
                      @tail |
                        forall i: Nat; at(u, succ(i)) = at(s, i)
                        [by hypothesis given-tail]
                      // base case: one entry, the head
                      @one-unfolds |
                        productUpTo(u, succ(ZERO)) = compose(productUpTo(u, ZERO), at(u, ZERO))
                        [using specialize productUpToSucc(u, ZERO)]
                      @empty-is-identity |
                        productUpTo(u, ZERO) = identityFn
                        [using specialize productUpToZero(u)]
                      @one-is-identity-times-head |
                        productUpTo(u, succ(ZERO)) = compose(identityFn, at(u, ZERO))
                        [by rewrite empty-is-identity one-unfolds]
                      @identity-drops |
                        compose(identityFn, at(u, ZERO)) = at(u, ZERO)
                        [using specialize composeIdentityLeft(at(u, ZERO))]
                      @one-is-the-head |
                        productUpTo(u, succ(ZERO)) = at(u, ZERO)
                        [using chain one-is-identity-times-head identity-drops]
                      @one-is-x |
                        productUpTo(u, succ(ZERO)) = x
                        [using chain one-is-the-head head]
                      @tail-empty-is-identity |
                        productUpTo(s, ZERO) = identityFn
                        [using specialize productUpToZero(s)]
                      @x-times-identity |
                        compose(x, identityFn) = x
                        [using specialize composeIdentityRight(x)]
                      @x-is-x-times-identity |
                        x = compose(x, identityFn)
                        [by symmetry x-times-identity]
                      @x-is-x-times-empty-tail |
                        x = compose(x, productUpTo(s, ZERO))
                        [by rewrite tail-empty-is-identity x-is-x-times-identity]
                      @base-case |
                        productUpTo(u, succ(ZERO)) = compose(x, productUpTo(s, ZERO))
                        [using chain one-is-x x-is-x-times-empty-tail]
                      // inductive step
                      @induction-step |
                        fix k: Nat {
                          @given-inductive-hypothesis |
                            assume productUpTo(u, succ(k)) = compose(x, productUpTo(s, k)) {
                              @inductive-hypothesis |
                                productUpTo(u, succ(k)) = compose(x, productUpTo(s, k))
                                [by hypothesis given-inductive-hypothesis]
                              @next-unfolds |
                                productUpTo(u, succ(succ(k))) = compose(productUpTo(u, succ(k)), at(u, succ(k)))
                                [using specialize productUpToSucc(u, succ(k))]
                              @next-through-hypothesis |
                                productUpTo(u, succ(succ(k))) = compose(compose(x, productUpTo(s, k)), at(u, succ(k)))
                                [by rewrite inductive-hypothesis next-unfolds]
                              @shifted-entry |
                                at(u, succ(k)) = at(s, k)
                                [using specialize tail(k)]
                              @next-with-the-tail-entry |
                                productUpTo(u, succ(succ(k))) = compose(compose(x, productUpTo(s, k)), at(s, k))
                                [by rewrite shifted-entry next-through-hypothesis]
                              @reassociated |
                                compose(compose(x, productUpTo(s, k)), at(s, k)) = compose(x, compose(productUpTo(s, k), at(s, k)))
                                [using specialize composeAssoc(x, productUpTo(s, k), at(s, k))]
                              @next-reassociated |
                                productUpTo(u, succ(succ(k))) = compose(x, compose(productUpTo(s, k), at(s, k)))
                                [using chain next-with-the-tail-entry reassociated]
                              @tail-next-unfolds |
                                productUpTo(s, succ(k)) = compose(productUpTo(s, k), at(s, k))
                                [using specialize productUpToSucc(s, k)]
                              @conclusion-next |
                                productUpTo(u, succ(succ(k))) = compose(x, productUpTo(s, succ(k)))
                                [by rewrite tail-next-unfolds next-reassociated]
                            }
                          @induction-step-at-k |
                            productUpTo(u, succ(k)) = compose(x, productUpTo(s, k)) -> productUpTo(u, succ(succ(k))) = compose(x, productUpTo(s, succ(k)))
                            [by discharge given-inductive-hypothesis]
                        }
                      @induction-step-for-all-k |
                        forall k: Nat; productUpTo(u, succ(k)) = compose(x, productUpTo(s, k)) -> productUpTo(u, succ(succ(k))) = compose(x, productUpTo(s, succ(k)))
                        [by generalize induction-step]
                      @conclusion-for-all-n |
                        forall n: Nat; productUpTo(u, succ(n)) = compose(x, productUpTo(s, n))
                        [using instantiation induction((fun k: Nat => productUpTo(u, succ(k)) = compose(x, productUpTo(s, k)))) base-case induction-step-for-all-k]
                    }
                  @conclusion-tail |
                    (forall i: Nat; at(u, succ(i)) = at(s, i)) -> forall n: Nat; productUpTo(u, succ(n)) = compose(x, productUpTo(s, n))
                    [by discharge given-tail]
                }
              @conclusion-head |
                at(u, ZERO) = x -> (forall i: Nat; at(u, succ(i)) = at(s, i)) -> forall n: Nat; productUpTo(u, succ(n)) = compose(x, productUpTo(s, n))
                [by discharge given-head]
            }
          @discharge-u |
            forall u: Seq; at(u, ZERO) = x -> (forall i: Nat; at(u, succ(i)) = at(s, i)) -> forall n: Nat; productUpTo(u, succ(n)) = compose(x, productUpTo(s, n))
            [by generalize generalize-u]
        }
      @discharge-s |
        forall s: Seq; forall u: Seq; at(u, ZERO) = x -> (forall i: Nat; at(u, succ(i)) = at(s, i)) -> forall n: Nat; productUpTo(u, succ(n)) = compose(x, productUpTo(s, n))
        [by generalize generalize-s]
    }
  @conclusion |
    forall x: Fn; forall s: Seq; forall u: Seq;
      at(u, ZERO) = x -> (forall i: Nat; at(u, succ(i)) = at(s, i)) ->
      forall n: Nat; productUpTo(u, succ(n)) = compose(x, productUpTo(s, n))
    [by generalize generalize-x]
qed

// -- mapping a fixed permutation over a sequence -----------------------------------------------------

// For a permutation t and a sequence w, there is a sequence whose first m entries are
// t ∘ w_0, …, t ∘ w_{m-1}: induction on m, appending t ∘ w_m by concatenating with a
// singleton (the entries are invertible, so the singleton exists).
theorem mappedSequenceExists: forall t: Fn; invertible(t) -> forall w: Seq; forall m: Nat;
  exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = compose(t, at(w, j))
proof
  @generalize-t |
    fix t: Fn {
      @given-invertible |
        assume invertible(t) {
          @t-invertible |
            invertible(t)
            [by hypothesis given-invertible]
          @generalize-w |
            fix w: Seq {
              // base case: no entries are required, any sequence will do
              @identity-invertible |
                invertible(identityFn)
                [by cite identityIsAPermutation]
              @some-sequence-exists |
                exists v: Seq; at(v, ZERO) = identityFn and productUpTo(v, succ(ZERO)) = identityFn
                [using specialize seqSingleton(identityFn) identity-invertible]
              @base-case-proof |
                unpack v: Seq from some-sequence-exists {
                  @vacuous |
                    fix j: Nat {
                      @nothing-below-zero |
                        not less_than(j, ZERO)
                        [using specialize notLessThanZero(j)]
                      @entry-clause |
                        less_than(j, ZERO) -> at(v, j) = compose(t, at(w, j))
                        [using tautology nothing-below-zero]
                    }
                  @no-entries |
                    forall j: Nat; less_than(j, ZERO) -> at(v, j) = compose(t, at(w, j))
                    [by generalize vacuous]
                  @conclusion-base-witness |
                    exists v2: Seq; forall j: Nat; less_than(j, ZERO) -> at(v2, j) = compose(t, at(w, j))
                    [by witness(v) no-entries]
                }
              @base-case |
                exists v2: Seq; forall j: Nat; less_than(j, ZERO) -> at(v2, j) = compose(t, at(w, j))
                [by unpacked base-case-proof]
              // inductive step: append t ∘ w_k
              @induction-step |
                fix k: Nat {
                  @given-inductive-hypothesis |
                    assume exists v: Seq; forall j: Nat; less_than(j, k) -> at(v, j) = compose(t, at(w, j)) {
                      @inductive-hypothesis |
                        exists v: Seq; forall j: Nat; less_than(j, k) -> at(v, j) = compose(t, at(w, j))
                        [by hypothesis given-inductive-hypothesis]
                      @with-prefix-v |
                        unpack v: Seq from inductive-hypothesis {
                          @prefix-entries |
                            forall j: Nat; less_than(j, k) -> at(v, j) = compose(t, at(w, j))
                            [by hypothesis with-prefix-v]
                          @entry-k-invertible |
                            invertible(at(w, k))
                            [using specialize atIsAPermutation(w, k)]
                          @mapped-entry-invertible |
                            invertible(compose(t, at(w, k)))
                            [using specialize composeIsAPermutation(t, at(w, k)) t-invertible entry-k-invertible]
                          @singleton-exists |
                            exists s: Seq; at(s, ZERO) = compose(t, at(w, k)) and productUpTo(s, succ(ZERO)) = compose(t, at(w, k))
                            [using specialize seqSingleton(compose(t, at(w, k))) mapped-entry-invertible]
                          @with-singleton-s |
                            unpack s: Seq from singleton-exists {
                              @singleton-facts |
                                at(s, ZERO) = compose(t, at(w, k)) and productUpTo(s, succ(ZERO)) = compose(t, at(w, k))
                                [by hypothesis with-singleton-s]
                              @singleton-head |
                                at(s, ZERO) = compose(t, at(w, k))
                                [by and_lhs singleton-facts]
                              @concatenation-exists |
                                exists u: Seq; (forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i)) and productUpTo(u, add(k, succ(ZERO))) = compose(productUpTo(v, k), productUpTo(s, succ(ZERO)))
                                [using specialize seqConcat(v, s, k, succ(ZERO))]
                              @with-concatenation-u |
                                unpack u: Seq from concatenation-exists {
                                  @concatenation-facts |
                                    (forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i)) and productUpTo(u, add(k, succ(ZERO))) = compose(productUpTo(v, k), productUpTo(s, succ(ZERO)))
                                    [by hypothesis with-concatenation-u]
                                  @agreement-pair |
                                    (forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i))
                                    [by and_lhs concatenation-facts]
                                  @u-agrees-with-prefix |
                                    forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)
                                    [by and_lhs agreement-pair]
                                  @u-agrees-with-singleton |
                                    forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i)
                                    [by and_rhs agreement-pair]
                                  @zero-below-one |
                                    less_than(ZERO, succ(ZERO))
                                    [using specialize lessThanSelf(ZERO)]
                                  @u-at-k-plus-zero |
                                    at(u, add(k, ZERO)) = at(s, ZERO)
                                    [using specialize u-agrees-with-singleton(ZERO) zero-below-one]
                                  @k-plus-zero-is-k |
                                    add(k, ZERO) = k
                                    [using specialize addZeroRight(k)]
                                  @u-at-k |
                                    at(u, k) = at(s, ZERO)
                                    [by rewrite k-plus-zero-is-k u-at-k-plus-zero]
                                  @u-at-k-is-the-mapped-entry |
                                    at(u, k) = compose(t, at(w, k))
                                    [using chain u-at-k singleton-head]
                                  @generalize-j |
                                    fix j: Nat {
                                      @given-j-in-range |
                                        assume less_than(j, succ(k)) {
                                          @j-in-range |
                                            less_than(j, succ(k))
                                            [by hypothesis given-j-in-range]
                                          @j-below-k-or-is-k |
                                            less_than(j, k) or j = k
                                            [using specialize lessThanSuccSplit(j, k) j-in-range]
                                          @conclusion-entry-j |
                                            at(u, j) = compose(t, at(w, j))
                                            case j-below-k-or-is-k {
                                              @when-in-prefix |
                                                assume less_than(j, k) {
                                                  @j-below-k |
                                                    less_than(j, k)
                                                    [by hypothesis when-in-prefix]
                                                  @u-entry-is-prefix-entry |
                                                    at(u, j) = at(v, j)
                                                    [using specialize u-agrees-with-prefix(j) j-below-k]
                                                  @prefix-entry-is-mapped |
                                                    at(v, j) = compose(t, at(w, j))
                                                    [using specialize prefix-entries(j) j-below-k]
                                                  @conclusion-in-prefix |
                                                    at(u, j) = compose(t, at(w, j))
                                                    [using chain u-entry-is-prefix-entry prefix-entry-is-mapped]
                                                }
                                              @when-the-new-entry |
                                                assume j = k {
                                                  @j-is-k |
                                                    j = k
                                                    [by hypothesis when-the-new-entry]
                                                  @conclusion-new-entry |
                                                    at(u, j) = compose(t, at(w, j))
                                                    [by rewrite j-is-k u-at-k-is-the-mapped-entry]
                                                }
                                            }
                                        }
                                      @conclusion-entry-clause |
                                        less_than(j, succ(k)) -> at(u, j) = compose(t, at(w, j))
                                        [by discharge given-j-in-range]
                                    }
                                  @all-entries |
                                    forall j: Nat; less_than(j, succ(k)) -> at(u, j) = compose(t, at(w, j))
                                    [by generalize generalize-j]
                                  @conclusion-witness-u |
                                    exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(t, at(w, j))
                                    [by witness(u) all-entries]
                                }
                              @conclusion-with-u |
                                exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(t, at(w, j))
                                [by unpacked with-concatenation-u]
                            }
                          @conclusion-with-s |
                            exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(t, at(w, j))
                            [by unpacked with-singleton-s]
                        }
                      @conclusion-step |
                        exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(t, at(w, j))
                        [by unpacked with-prefix-v]
                    }
                  @induction-step-at-k |
                    (exists v: Seq; forall j: Nat; less_than(j, k) -> at(v, j) = compose(t, at(w, j))) -> (exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(t, at(w, j)))
                    [by discharge given-inductive-hypothesis]
                }
              @induction-step-for-all-k |
                forall k: Nat; (exists v: Seq; forall j: Nat; less_than(j, k) -> at(v, j) = compose(t, at(w, j))) -> (exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = compose(t, at(w, j)))
                [by generalize induction-step]
              @conclusion-for-all-m |
                forall m: Nat; exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = compose(t, at(w, j))
                [using instantiation induction((fun k: Nat => exists v: Seq; forall j: Nat; less_than(j, k) -> at(v, j) = compose(t, at(w, j)))) base-case induction-step-for-all-k]
            }
          @discharge-w |
            forall w: Seq; forall m: Nat; exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = compose(t, at(w, j))
            [by generalize generalize-w]
        }
      @conclusion-invertible |
        invertible(t) -> forall w: Seq; forall m: Nat; exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = compose(t, at(w, j))
        [by discharge given-invertible]
    }
  @conclusion |
    forall t: Fn; invertible(t) -> forall w: Seq; forall m: Nat;
      exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = compose(t, at(w, j))
    [by generalize generalize-t]
qed
theorem aCompositeFixesWhatBothFactorsFix = permutation.aCompositeFixesWhatBothFactorsFix
define disjointSupports(f, g) = permutation.disjointSupports(f, g)
theorem disjointSupportsFromPointwise = permutation.disjointSupportsFromPointwise
theorem aDisjointFactorFixesWhateverTheOtherMoves = permutation.aDisjointFactorFixesWhateverTheOtherMoves
axiom composeApply = function.composeApply
theorem lessThanSuccRight = peano_order.lessThanSuccRight
axiom identityApply = function.identityApply

// A PREFIX PRODUCT fixes whatever every one of its entries fixes — induction on the run
// length over `aCompositeFixesWhatBothFactorsFix`. This is what turns "each earlier cycle
// is disjoint from the last" into "the prefix product is disjoint from the last", which is
// how `f = tau o c` gets its disjointness hypothesis in a decomposition argument.
theorem aPrefixProductFixesWhatEveryEntryFixes: forall s: Seq; forall x: Element; forall m: Nat;
  (forall i: Nat; less_than(i, m) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, m), x) = x
proof
  @generalize-s |
    fix s: Seq {
      @generalize-x |
        fix x: Element {
          @empty-product |
            productUpTo(s, ZERO) = identityFn
            [using specialize productUpToZero(s)]
          @identity-fixes |
            apply(identityFn, x) = x
            [using specialize identityApply(x)]
          @base-at-zero |
            apply(productUpTo(s, ZERO), x) = x
            [by rewrite empty-product identity-fixes]
          @base-case |
            (forall i: Nat; less_than(i, ZERO) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, ZERO), x) = x
            [using tautology base-at-zero]
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume (forall i: Nat; less_than(i, k) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, k), x) = x {
                  @inductive-hypothesis |
                    (forall i: Nat; less_than(i, k) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, k), x) = x
                    [by hypothesis given-inductive-hypothesis]
                  @given-all-fix |
                    assume forall i: Nat; less_than(i, succ(k)) -> apply(at(s, i), x) = x {
                      @all-fix |
                        forall i: Nat; less_than(i, succ(k)) -> apply(at(s, i), x) = x
                        [by hypothesis given-all-fix]
                      @generalize-earlier |
                        fix i: Nat {
                          @given-i-below-k |
                            assume less_than(i, k) {
                              @i-below-k |
                                less_than(i, k)
                                [by hypothesis given-i-below-k]
                              @i-below-succ-k |
                                less_than(i, succ(k))
                                [using specialize lessThanSuccRight(i, k) i-below-k]
                              @conclusion-entry-fixes |
                                apply(at(s, i), x) = x
                                [using specialize all-fix(i) i-below-succ-k]
                            }
                          @conclusion-earlier |
                            less_than(i, k) -> apply(at(s, i), x) = x
                            [by discharge given-i-below-k]
                        }
                      @earlier-all-fix |
                        forall i: Nat; less_than(i, k) -> apply(at(s, i), x) = x
                        [by generalize generalize-earlier]
                      @prefix-fixes |
                        apply(productUpTo(s, k), x) = x
                        [by modus_ponens inductive-hypothesis earlier-all-fix]
                      @the-last-index-is-in-range |
                        less_than(k, succ(k))
                        [using specialize lessThanSelf(k)]
                      @entry-k-fixes |
                        apply(at(s, k), x) = x
                        [using specialize all-fix(k) the-last-index-is-in-range]
                      @run-splits |
                        productUpTo(s, succ(k)) = compose(productUpTo(s, k), at(s, k))
                        [using specialize productUpToSucc(s, k)]
                      @composite-fixes |
                        apply(compose(productUpTo(s, k), at(s, k)), x) = x
                        [using specialize aCompositeFixesWhatBothFactorsFix(productUpTo(s, k), at(s, k), x) entry-k-fixes prefix-fixes]
                      @conclusion-at-succ-k |
                        apply(productUpTo(s, succ(k)), x) = x
                        [by rewrite run-splits composite-fixes]
                    }
                  @conclusion-implication |
                    (forall i: Nat; less_than(i, succ(k)) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, succ(k)), x) = x
                    [by discharge given-all-fix]
                }
              @conclusion-step-at-k |
                ((forall i: Nat; less_than(i, k) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, k), x) = x) ->
                  ((forall i: Nat; less_than(i, succ(k)) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, succ(k)), x) = x)
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat;
              ((forall i: Nat; less_than(i, k) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, k), x) = x) ->
              ((forall i: Nat; less_than(i, succ(k)) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, succ(k)), x) = x)
            [by generalize induction-step]
          @conclusion-for-x |
            forall m: Nat; (forall i: Nat; less_than(i, m) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, m), x) = x
            [using instantiation induction((fun m: Nat => (forall i: Nat; less_than(i, m) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, m), x) = x)) base-case induction-step-for-all-k]
        }
      @discharge-x |
        forall x: Element; forall m: Nat; (forall i: Nat; less_than(i, m) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, m), x) = x
        [by generalize generalize-x]
    }
  @conclusion |
    forall s: Seq; forall x: Element; forall m: Nat;
      (forall i: Nat; less_than(i, m) -> apply(at(s, i), x) = x) -> apply(productUpTo(s, m), x) = x
    [by generalize generalize-s]
qed

// -- a prefix product inherits its entries' disjointness ------------------------------------
//
// The companion to `aPrefixProductFixesWhatEveryEntryFixes` above: that lemma says the prefix
// product fixes what EVERY entry fixes; these say it is DISJOINT from whatever every entry is
// disjoint from. Together they are what lets a decomposition argument peel the last cycle off
// a product — `f = productUpTo(w, k) o at(w, k)` with the two factors disjoint — which is the
// hypothesis every disjointness theorem in std/permutation.b4m wants.

// POINTWISE form, by induction on the run length: if every entry below m is disjoint from t,
// then wherever the prefix product moves a point, t fixes it.
theorem aPrefixProductIsPointwiseDisjointFromADisjointEntry:
  forall s: Seq; forall t: Fn; forall m: Nat;
  (forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)) ->
  (forall x: Element; apply(productUpTo(s, m), x) != x -> apply(t, x) = x)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-t |
        fix t: Fn {
          // base case: the empty product is the identity, which moves nothing.
          @base-case-proof |
            assume forall i: Nat; less_than(i, ZERO) -> disjointSupports(at(s, i), t) {
              @generalize-x-base |
                fix x: Element {
                  @empty-product |
                    productUpTo(s, ZERO) = identityFn
                    [using specialize productUpToZero(s)]
                  @identity-fixes-x |
                    apply(identityFn, x) = x
                    [using specialize identityApply(x)]
                  @empty-product-fixes-x |
                    apply(productUpTo(s, ZERO), x) = x
                    [using chain empty-product identity-fixes-x]
                  @conclusion-vacuous-at-x |
                    apply(productUpTo(s, ZERO), x) != x -> apply(t, x) = x
                    [using tautology empty-product-fixes-x]
                }
              @conclusion-base |
                forall x: Element; apply(productUpTo(s, ZERO), x) != x -> apply(t, x) = x
                [by generalize generalize-x-base]
            }
          @base-case |
            (forall i: Nat; less_than(i, ZERO) -> disjointSupports(at(s, i), t)) ->
              (forall x: Element; apply(productUpTo(s, ZERO), x) != x -> apply(t, x) = x)
            [by discharge base-case-proof]

          // inductive step: productUpTo(s, succ(k)) = prefix o at(s, k). A point the composite
          // moves is moved by at least one of the two factors, and each is disjoint from t.
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume (forall i: Nat; less_than(i, k) -> disjointSupports(at(s, i), t)) ->
                  (forall x: Element; apply(productUpTo(s, k), x) != x -> apply(t, x) = x) {
                  @inductive-hypothesis |
                    (forall i: Nat; less_than(i, k) -> disjointSupports(at(s, i), t)) ->
                      (forall x: Element; apply(productUpTo(s, k), x) != x -> apply(t, x) = x)
                    [by hypothesis given-inductive-hypothesis]
                  @given-entries-below-succ-k |
                    assume forall i: Nat; less_than(i, succ(k)) -> disjointSupports(at(s, i), t) {
                      @entries-below-succ-k |
                        forall i: Nat; less_than(i, succ(k)) -> disjointSupports(at(s, i), t)
                        [by hypothesis given-entries-below-succ-k]
                      @generalize-i-for-the-shorter-run |
                        fix i: Nat {
                          @given-i-below-k |
                            assume less_than(i, k) {
                              @i-below-k |
                                less_than(i, k)
                                [by hypothesis given-i-below-k]
                              @i-below-succ-k |
                                less_than(i, succ(k))
                                [using specialize lessThanSuccRight(i, k) i-below-k]
                              @conclusion-entry-i-disjoint |
                                disjointSupports(at(s, i), t)
                                [using specialize entries-below-succ-k(i) i-below-succ-k]
                            }
                          @conclusion-i-below-k-implies-disjoint |
                            less_than(i, k) -> disjointSupports(at(s, i), t)
                            [by discharge given-i-below-k]
                        }
                      @entries-below-k |
                        forall i: Nat; less_than(i, k) -> disjointSupports(at(s, i), t)
                        [by generalize generalize-i-for-the-shorter-run]
                      @prefix-pointwise |
                        forall x: Element; apply(productUpTo(s, k), x) != x -> apply(t, x) = x
                        [by modus_ponens inductive-hypothesis entries-below-k]
                      @the-last-index-is-in-range |
                        less_than(k, succ(k))
                        [using specialize lessThanSelf(k)]
                      @last-entry-disjoint |
                        disjointSupports(at(s, k), t)
                        [using specialize entries-below-succ-k(k) the-last-index-is-in-range]
                      @generalize-x-step |
                        fix x: Element {
                          @given-composite-moves-x |
                            assume apply(productUpTo(s, succ(k)), x) != x {
                              @composite-moves-x |
                                apply(productUpTo(s, succ(k)), x) != x
                                [by hypothesis given-composite-moves-x]
                              @split-the-product |
                                productUpTo(s, succ(k)) = compose(productUpTo(s, k), at(s, k))
                                [using specialize productUpToSucc(s, k)]
                              @composite-applies |
                                apply(productUpTo(s, succ(k)), x) =
                                  apply(productUpTo(s, k), apply(at(s, k), x))
                                [using simplify split-the-product composeApply]
                              // if the last entry moves x, t fixes x directly by disjointness;
                              // otherwise the prefix must move x, and the hypothesis applies.
                              @last-entry-moves-x-gives-t-fixes-x |
                                apply(at(s, k), x) != x -> apply(t, x) = x
                                [using specialize aDisjointFactorFixesWhateverTheOtherMoves(at(s, k), t, x) last-entry-disjoint]
                              @prefix-moves-x-gives-t-fixes-x |
                                apply(productUpTo(s, k), x) != x -> apply(t, x) = x
                                [using specialize prefix-pointwise(x)]
                              @given-last-entry-fixes-x |
                                assume apply(at(s, k), x) = x {
                                  @last-entry-fixes-x |
                                    apply(at(s, k), x) = x
                                    [by hypothesis given-last-entry-fixes-x]
                                  @prefix-at-x-is-the-composite |
                                    apply(productUpTo(s, succ(k)), x) = apply(productUpTo(s, k), x)
                                    [using chain composite-applies last-entry-fixes-x]
                                  @prefix-moves-x |
                                    apply(productUpTo(s, k), x) != x
                                    [by rewrite prefix-at-x-is-the-composite composite-moves-x]
                                  @conclusion-t-fixes-x-when-last-fixes |
                                    apply(t, x) = x
                                    [by modus_ponens prefix-moves-x-gives-t-fixes-x prefix-moves-x]
                                }
                              @last-entry-fixes-x-gives-t-fixes-x |
                                apply(at(s, k), x) = x -> apply(t, x) = x
                                [by discharge given-last-entry-fixes-x]
                              @conclusion-t-fixes-x |
                                apply(t, x) = x
                                [using tautology last-entry-moves-x-gives-t-fixes-x last-entry-fixes-x-gives-t-fixes-x]
                            }
                          @conclusion-composite-moves-x-implies-t-fixes-x |
                            apply(productUpTo(s, succ(k)), x) != x -> apply(t, x) = x
                            [by discharge given-composite-moves-x]
                        }
                      @conclusion-pointwise-at-succ-k |
                        forall x: Element; apply(productUpTo(s, succ(k)), x) != x -> apply(t, x) = x
                        [by generalize generalize-x-step]
                    }
                  @conclusion-implication-at-succ-k |
                    (forall i: Nat; less_than(i, succ(k)) -> disjointSupports(at(s, i), t)) ->
                      (forall x: Element; apply(productUpTo(s, succ(k)), x) != x -> apply(t, x) = x)
                    [by discharge given-entries-below-succ-k]
                }
              @conclusion-induction-step-at-k |
                ((forall i: Nat; less_than(i, k) -> disjointSupports(at(s, i), t)) ->
                  (forall x: Element; apply(productUpTo(s, k), x) != x -> apply(t, x) = x)) ->
                  ((forall i: Nat; less_than(i, succ(k)) -> disjointSupports(at(s, i), t)) ->
                  (forall x: Element; apply(productUpTo(s, succ(k)), x) != x -> apply(t, x) = x))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat;
              ((forall i: Nat; less_than(i, k) -> disjointSupports(at(s, i), t)) ->
              (forall x: Element; apply(productUpTo(s, k), x) != x -> apply(t, x) = x)) ->
              ((forall i: Nat; less_than(i, succ(k)) -> disjointSupports(at(s, i), t)) ->
              (forall x: Element; apply(productUpTo(s, succ(k)), x) != x -> apply(t, x) = x))
            [by generalize induction-step]
          @conclusion-for-t |
            forall m: Nat;
              (forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)) ->
              (forall x: Element; apply(productUpTo(s, m), x) != x -> apply(t, x) = x)
            [using instantiation induction((fun m: Nat => (forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)) -> (forall x: Element; apply(productUpTo(s, m), x) != x -> apply(t, x) = x))) base-case induction-step-for-all-k]
        }
      @discharge-t |
        forall t: Fn; forall m: Nat;
          (forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)) ->
          (forall x: Element; apply(productUpTo(s, m), x) != x -> apply(t, x) = x)
        [by generalize generalize-t]
    }
  @conclusion |
    forall s: Seq; forall t: Fn; forall m: Nat;
      (forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)) ->
      (forall x: Element; apply(productUpTo(s, m), x) != x -> apply(t, x) = x)
    [by generalize generalize-s]
qed

// SET-LEVEL: the prefix product's support is disjoint from the entry's. The pointwise form
// above plus `disjointSupportsFromPointwise`.
theorem aPrefixProductIsDisjointFromADisjointEntry:
  forall s: Seq; forall t: Fn; forall m: Nat;
  (forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)) ->
  disjointSupports(productUpTo(s, m), t)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-t |
        fix t: Fn {
          @generalize-m |
            fix m: Nat {
              @given-entries-disjoint |
                assume forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t) {
                  @entries-disjoint |
                    forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)
                    [by hypothesis given-entries-disjoint]
                  @pointwise-disjoint |
                    forall x: Element; apply(productUpTo(s, m), x) != x -> apply(t, x) = x
                    [using specialize aPrefixProductIsPointwiseDisjointFromADisjointEntry(s, t, m) entries-disjoint]
                  @conclusion-disjoint |
                    disjointSupports(productUpTo(s, m), t)
                    [using specialize disjointSupportsFromPointwise(productUpTo(s, m), t) pointwise-disjoint]
                }
              @conclusion-implication-at-m |
                (forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)) ->
                  disjointSupports(productUpTo(s, m), t)
                [by discharge given-entries-disjoint]
            }
          @discharge-m |
            forall m: Nat;
              (forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)) ->
              disjointSupports(productUpTo(s, m), t)
            [by generalize generalize-m]
        }
      @discharge-t |
        forall t: Fn; forall m: Nat;
          (forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)) ->
          disjointSupports(productUpTo(s, m), t)
        [by generalize generalize-t]
    }
  @conclusion |
    forall s: Seq; forall t: Fn; forall m: Nat;
      (forall i: Nat; less_than(i, m) -> disjointSupports(at(s, i), t)) ->
      disjointSupports(productUpTo(s, m), t)
    [by generalize generalize-s]
qed
