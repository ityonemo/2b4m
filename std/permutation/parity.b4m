// std/permutation/parity.b4m — JUDSON'S PARITY LEMMA, proved: if the identity is a product
// of r transpositions then r is even (AATA §5.1, permute-lemma-identity-even-trans).
//
// Judson's argument is a NESTED PAIR OF ORDINARY INDUCTIONS, not an induction over a
// lexicographic order (a misreading this file's predecessor note recorded for a year):
//
//   OUTER: strong induction on r. Every success case reduces the problem to r − 2.
//   INNER: with r FIXED, push the last occurrence of a chosen letter `a` leftward. Each
//          step either cancels a pair (exit to the outer hypothesis at r − 2) or moves
//          `a`'s last occurrence one position left. The position is bounded below by 0, so
//          the inner loop is ordinary downward ℕ induction and the outer measure never
//          moves while it runs.
//
// The rewriting is driven by Judson's four identities on the last two factors, which are
// equalities of CONCRETE maps and are proved here pointwise:
//
//   (ab)(ab) = 1        (bc)(ab) = (ac)(bc)        (cd)(ab) = (ab)(cd)        (ac)(ab) = (ab)(bc)
//
// This file proves the four identities. The inner/outer inductions and the "a cannot end up
// only in the first factor" argument build on them.

import function <<< "std/function.b4m"
import function_invertible <<< "std/function/invertible.b4m"
import permutation <<< "std/permutation.b4m"
import permutation_sequence <<< "std/permutation/sequence.b4m"
import element <<< "std/element.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import peano_divides <<< "std/peano/divides.b4m"
import peano_parity <<< "std/peano/parity.b4m"

sort Element = element.Element
sort Fn = function.Fn
const identityFn = function.identityFn
func compose = function.compose
func apply = function.apply
pred invertible = function.invertible
axiom funcExtensionality = function.funcExtensionality
axiom composeApply = function.composeApply
axiom identityApply = function.identityApply

func transposition = permutation.transposition
theorem composeAssoc = function_invertible.composeAssoc
theorem composeIdentityLeft = function_invertible.composeIdentityLeft
theorem composeIdentityRight = function_invertible.composeIdentityRight
theorem transpositionIsAPermutation = permutation.transpositionIsAPermutation

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
pred less_than = peano.less_than
// The SAME two the peano parity theory uses (add(ONE, ONE)), so `divides(TWO, r)` here is
// literally the proposition aata/5.1 states — not a variant the citer has to convert.
define NTWO = peano_parity.TWO
define ndivides(d, n) = peano_divides.divides(d, n)

// A map IS a transposition when it exchanges two DISTINCT points (without u != v the trivial
// swap would count and the parity lemma would be false — see the 2026-09-27 soundness fix).
define isTransposition(t) = exists u: Element; exists v: Element; u != v and t = transposition(u, v)
define allTranspositions(s, n) = forall i: Nat; less_than(i, n) -> isTransposition(at(s, i))
// The goal of the whole file, as a define so the inductions read cleanly: SOME product of
// exactly n transpositions is the identity.
define someProductOfLengthIsIdentity(n) = exists t: Seq; allTranspositions(t, n) and productUpTo(t, n) = identityFn
axiom natInduction = peano.induction
theorem strongInduction = peano_order.strongInduction
theorem natLessThanSuccSplit = peano_order.lessThanSuccSplit
theorem natNotLessThanZero = peano_order.notLessThanZero
theorem natLessThanSelf = peano_order.lessThanSelf

sort Seq = permutation_sequence.Seq
func at = permutation_sequence.at
func productUpTo = permutation_sequence.productUpTo
axiom atIsAPermutation = permutation_sequence.atIsAPermutation
axiom productUpToZero = permutation_sequence.productUpToZero
axiom productUpToSucc = permutation_sequence.productUpToSucc
theorem productUpToIsAPermutation = permutation_sequence.productUpToIsAPermutation
theorem transpositionAtFirst = permutation.transpositionAtFirst
theorem transpositionAtSecond = permutation.transpositionAtSecond
theorem transpositionElsewhere = permutation.transpositionElsewhere

// -- the value of a composite of two transpositions at a point -----------------------------
// Every identity below is proved by the same shape: compute both sides at a fixed point by
// `composeApply` plus the three action lemmas, then close by funcExtensionality. This helper
// removes the repetition — it is the "both sides agree at x" premise of extensionality.
theorem composedTranspositionsAgree: forall p, q, r, s: Fn; (forall x: Element; apply(compose(p, q), x) = apply(compose(r, s), x)) -> compose(p, q) = compose(r, s)
proof
  @generalize-p |
    fix p: Fn {
      @generalize-q |
        fix q: Fn {
          @generalize-r |
            fix r: Fn {
              @generalize-s |
                fix s: Fn {
                  @given-pointwise |
                    assume forall x: Element; apply(compose(p, q), x) = apply(compose(r, s), x) {
                      @pointwise |
                        forall x: Element; apply(compose(p, q), x) = apply(compose(r, s), x)
                        [by hypothesis given-pointwise]
                      @conclusion-equal |
                        compose(p, q) = compose(r, s)
                        [using specialize funcExtensionality(compose(p, q), compose(r, s)) pointwise]
                    }
                  @pointwise-implies |
                    (forall x: Element; apply(compose(p, q), x) = apply(compose(r, s), x)) -> compose(p, q) = compose(r, s)
                    [by discharge given-pointwise]
                }
              @discharge-s |
                forall s: Fn; (forall x: Element; apply(compose(p, q), x) = apply(compose(r, s), x)) -> compose(p, q) = compose(r, s)
                [by generalize generalize-s]
            }
          @discharge-r |
            forall r, s: Fn; (forall x: Element; apply(compose(p, q), x) = apply(compose(r, s), x)) -> compose(p, q) = compose(r, s)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r, s: Fn; (forall x: Element; apply(compose(p, q), x) = apply(compose(r, s), x)) -> compose(p, q) = compose(r, s)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r, s: Fn; (forall x: Element; apply(compose(p, q), x) = apply(compose(r, s), x)) -> compose(p, q) = compose(r, s)
    [by generalize generalize-p]
qed

// Judson's identity (1) is already proved in std: (ab)(ab) = 1.
theorem transpositionsCancel = permutation.transpositionIsAnInvolution

// -- the value of a transposition at a point, as a three-way case ---------------------------
// The single fact every identity below needs: (u v) sends u to v, v to u, and fixes anything
// else. Packaged as one theorem so each identity's case analysis is a chain of citations
// rather than a re-derivation.
theorem transpositionValue: forall u, v, x: Element; (x = u -> apply(transposition(u, v), x) = v) and (x = v -> apply(transposition(u, v), x) = u) and ((x != u and x != v) -> apply(transposition(u, v), x) = x)
proof
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @generalize-x |
            fix x: Element {
              @at-first |
                apply(transposition(u, v), u) = v
                [using specialize transpositionAtFirst(u, v)]
              @at-second |
                apply(transposition(u, v), v) = u
                [using specialize transpositionAtSecond(u, v)]
              @given-is-u |
                assume x = u {
                  @x-is-u |
                    x = u
                    [by hypothesis given-is-u]
                  @conclusion-at-u |
                    apply(transposition(u, v), x) = v
                    [by rewrite x-is-u at-first]
                }
              @is-u-implies |
                x = u -> apply(transposition(u, v), x) = v
                [by discharge given-is-u]
              @given-is-v |
                assume x = v {
                  @x-is-v |
                    x = v
                    [by hypothesis given-is-v]
                  @conclusion-at-v |
                    apply(transposition(u, v), x) = u
                    [by rewrite x-is-v at-second]
                }
              @is-v-implies |
                x = v -> apply(transposition(u, v), x) = u
                [by discharge given-is-v]
              @given-is-neither |
                assume x != u and x != v {
                  @neither |
                    x != u and x != v
                    [by hypothesis given-is-neither]
                  @not-u |
                    x != u
                    [by and_lhs neither]
                  @not-v |
                    x != v
                    [by and_rhs neither]
                  @conclusion-elsewhere |
                    apply(transposition(u, v), x) = x
                    [using specialize transpositionElsewhere(u, v, x) not-u not-v]
                }
              @is-neither-implies |
                (x != u and x != v) -> apply(transposition(u, v), x) = x
                [by discharge given-is-neither]
              @conclusion-three-cases |
                (x = u -> apply(transposition(u, v), x) = v) and (x = v -> apply(transposition(u, v), x) = u) and ((x != u and x != v) -> apply(transposition(u, v), x) = x)
                [using tautology is-u-implies is-v-implies is-neither-implies]
            }
          @discharge-x |
            forall x: Element; (x = u -> apply(transposition(u, v), x) = v) and (x = v -> apply(transposition(u, v), x) = u) and ((x != u and x != v) -> apply(transposition(u, v), x) = x)
            [by generalize generalize-x]
        }
      @discharge-v |
        forall v, x: Element; (x = u -> apply(transposition(u, v), x) = v) and (x = v -> apply(transposition(u, v), x) = u) and ((x != u and x != v) -> apply(transposition(u, v), x) = x)
        [by generalize generalize-v]
    }
  @conclusion |
    forall u, v, x: Element; (x = u -> apply(transposition(u, v), x) = v) and (x = v -> apply(transposition(u, v), x) = u) and ((x != u and x != v) -> apply(transposition(u, v), x) = x)
    [by generalize generalize-u]
qed

// -- the value of a composite at a point, as a single rewrite -------------------------------
// `composeApply` plus `transpositionValue` twice is the whole computation of ((u v)(p q))(x).
// Stating it as ONE equation per case keeps each of Judson's identities a comparison of two
// cited values instead of a fresh case analysis over four letters.
theorem compositeAtFirstOfInner: forall p, q, u, v: Element; apply(compose(transposition(u, v), transposition(p, q)), p) = apply(transposition(u, v), q)
proof
  @generalize-p |
    fix p: Element {
      @generalize-q |
        fix q: Element {
          @generalize-u |
            fix u: Element {
              @generalize-v |
                fix v: Element {
                  @composite-applies |
                    apply(compose(transposition(u, v), transposition(p, q)), p) = apply(transposition(u, v), apply(transposition(p, q), p))
                    [using specialize composeApply(transposition(u, v), transposition(p, q), p)]
                  @inner-at-p |
                    apply(transposition(p, q), p) = q
                    [using specialize transpositionAtFirst(p, q)]
                  @conclusion-value |
                    apply(compose(transposition(u, v), transposition(p, q)), p) = apply(transposition(u, v), q)
                    [by rewrite inner-at-p composite-applies]
                }
              @discharge-v |
                forall v: Element; apply(compose(transposition(u, v), transposition(p, q)), p) = apply(transposition(u, v), q)
                [by generalize generalize-v]
            }
          @discharge-u |
            forall u, v: Element; apply(compose(transposition(u, v), transposition(p, q)), p) = apply(transposition(u, v), q)
            [by generalize generalize-u]
        }
      @discharge-q |
        forall q, u, v: Element; apply(compose(transposition(u, v), transposition(p, q)), p) = apply(transposition(u, v), q)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, u, v: Element; apply(compose(transposition(u, v), transposition(p, q)), p) = apply(transposition(u, v), q)
    [by generalize generalize-p]
qed

theorem compositeAtSecondOfInner: forall p, q, u, v: Element; apply(compose(transposition(u, v), transposition(p, q)), q) = apply(transposition(u, v), p)
proof
  @generalize-p |
    fix p: Element {
      @generalize-q |
        fix q: Element {
          @generalize-u |
            fix u: Element {
              @generalize-v |
                fix v: Element {
                  @composite-applies |
                    apply(compose(transposition(u, v), transposition(p, q)), q) = apply(transposition(u, v), apply(transposition(p, q), q))
                    [using specialize composeApply(transposition(u, v), transposition(p, q), q)]
                  @inner-at-q |
                    apply(transposition(p, q), q) = p
                    [using specialize transpositionAtSecond(p, q)]
                  @conclusion-value |
                    apply(compose(transposition(u, v), transposition(p, q)), q) = apply(transposition(u, v), p)
                    [by rewrite inner-at-q composite-applies]
                }
              @discharge-v |
                forall v: Element; apply(compose(transposition(u, v), transposition(p, q)), q) = apply(transposition(u, v), p)
                [by generalize generalize-v]
            }
          @discharge-u |
            forall u, v: Element; apply(compose(transposition(u, v), transposition(p, q)), q) = apply(transposition(u, v), p)
            [by generalize generalize-u]
        }
      @discharge-q |
        forall q, u, v: Element; apply(compose(transposition(u, v), transposition(p, q)), q) = apply(transposition(u, v), p)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, u, v: Element; apply(compose(transposition(u, v), transposition(p, q)), q) = apply(transposition(u, v), p)
    [by generalize generalize-p]
qed

theorem compositeElsewhereOfInner: forall p, q, u, v, x: Element; x != p -> x != q -> apply(compose(transposition(u, v), transposition(p, q)), x) = apply(transposition(u, v), x)
proof
  @generalize-p |
    fix p: Element {
      @generalize-q |
        fix q: Element {
          @generalize-u |
            fix u: Element {
              @generalize-v |
                fix v: Element {
                  @generalize-x |
                    fix x: Element {
                      @given-not-p |
                        assume x != p {
                          @given-not-q |
                            assume x != q {
                              @not-p |
                                x != p
                                [by hypothesis given-not-p]
                              @not-q |
                                x != q
                                [by hypothesis given-not-q]
                              @composite-applies |
                                apply(compose(transposition(u, v), transposition(p, q)), x) = apply(transposition(u, v), apply(transposition(p, q), x))
                                [using specialize composeApply(transposition(u, v), transposition(p, q), x)]
                              @inner-fixes-x |
                                apply(transposition(p, q), x) = x
                                [using specialize transpositionElsewhere(p, q, x) not-p not-q]
                              @conclusion-value |
                                apply(compose(transposition(u, v), transposition(p, q)), x) = apply(transposition(u, v), x)
                                [by rewrite inner-fixes-x composite-applies]
                            }
                          @not-q-implies |
                            x != q -> apply(compose(transposition(u, v), transposition(p, q)), x) = apply(transposition(u, v), x)
                            [by discharge given-not-q]
                        }
                      @not-p-implies |
                        x != p -> x != q -> apply(compose(transposition(u, v), transposition(p, q)), x) = apply(transposition(u, v), x)
                        [by discharge given-not-p]
                    }
                  @discharge-x |
                    forall x: Element; x != p -> x != q -> apply(compose(transposition(u, v), transposition(p, q)), x) = apply(transposition(u, v), x)
                    [by generalize generalize-x]
                }
              @discharge-v |
                forall v, x: Element; x != p -> x != q -> apply(compose(transposition(u, v), transposition(p, q)), x) = apply(transposition(u, v), x)
                [by generalize generalize-v]
            }
          @discharge-u |
            forall u, v, x: Element; x != p -> x != q -> apply(compose(transposition(u, v), transposition(p, q)), x) = apply(transposition(u, v), x)
            [by generalize generalize-u]
        }
      @discharge-q |
        forall q, u, v, x: Element; x != p -> x != q -> apply(compose(transposition(u, v), transposition(p, q)), x) = apply(transposition(u, v), x)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, u, v, x: Element; x != p -> x != q -> apply(compose(transposition(u, v), transposition(p, q)), x) = apply(transposition(u, v), x)
    [by generalize generalize-p]
qed

// -- disequality is symmetric (not a propositional fact: `tautology` sees two atoms) --------
theorem distinctSymmetric: forall a, b: Element; a != b -> b != a
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @given-distinct |
            assume a != b {
              @distinct |
                a != b
                [by hypothesis given-distinct]
              @b-is-a-or-not |
                b = a or b != a
                [using tautology]
              @conclusion-flipped |
                b != a
                case b-is-a-or-not {
                  @when-b-is-a |
                    assume b = a {
                      @b-is-a |
                        b = a
                        [by hypothesis when-b-is-a]
                      @a-is-b |
                        a = b
                        [by symmetry b-is-a]
                      @conclusion-ex_falso |
                        b != a
                        [using tautology a-is-b distinct]
                    }
                  @when-b-is-not-a |
                    assume b != a {
                      @conclusion-directly |
                        b != a
                        [by hypothesis when-b-is-not-a]
                    }
                }
            }
          @distinct-implies |
            a != b -> b != a
            [by discharge given-distinct]
        }
      @discharge-b |
        forall b: Element; a != b -> b != a
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Element; a != b -> b != a
    [by generalize generalize-a]
qed

// -- Judson's identity (3): DISJOINT transpositions commute, (cd)(ab) = (ab)(cd) ------------
// At any point at most one of the two swaps moves it, so the order cannot matter. Five cases
// on where x sits; each is two citations of the composite-value lemmas above.
theorem disjointTranspositionsCommute: forall a, b, c, d: Element;
  a != b -> c != d -> a != c -> a != d -> b != c -> b != d ->
  compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @generalize-d |
                fix d: Element {
                  @given-ab |
                    assume a != b {
                      @given-cd |
                        assume c != d {
                          @given-ac |
                            assume a != c {
                              @given-ad |
                                assume a != d {
                                  @given-bc |
                                    assume b != c {
                                      @given-bd |
                                        assume b != d {
                                          @ac |
                                            a != c
                                            [by hypothesis given-ac]
                                          @ad |
                                            a != d
                                            [by hypothesis given-ad]
                                          @bc |
                                            b != c
                                            [by hypothesis given-bc]
                                          @bd |
                                            b != d
                                            [by hypothesis given-bd]
                                          @ca |
                                            c != a
                                            [using specialize distinctSymmetric(a, c) ac]
                                          @da |
                                            d != a
                                            [using specialize distinctSymmetric(a, d) ad]
                                          @cb |
                                            c != b
                                            [using specialize distinctSymmetric(b, c) bc]
                                          @db |
                                            d != b
                                            [using specialize distinctSymmetric(b, d) bd]
                                          // AT a: left = (cd)(b) = b; right = (ab)(a)… careful:
                                          // left  ((cd)(ab))(a) = (cd)(b) = b
                                          // right ((ab)(cd))(a) = (ab)(a) = b
                                          @left-at-a |
                                            apply(compose(transposition(c, d), transposition(a, b)), a) = apply(transposition(c, d), b)
                                            [using specialize compositeAtFirstOfInner(a, b, c, d)]
                                          @cd-fixes-b |
                                            apply(transposition(c, d), b) = b
                                            [using specialize transpositionElsewhere(c, d, b) bc bd]
                                          @left-at-a-is-b |
                                            apply(compose(transposition(c, d), transposition(a, b)), a) = b
                                            [using chain left-at-a cd-fixes-b]
                                          @right-at-a |
                                            apply(compose(transposition(a, b), transposition(c, d)), a) = apply(transposition(a, b), a)
                                            [using specialize compositeElsewhereOfInner(c, d, a, b, a) ac ad]
                                          @ab-at-a |
                                            apply(transposition(a, b), a) = b
                                            [using specialize transpositionAtFirst(a, b)]
                                          @right-at-a-is-b |
                                            apply(compose(transposition(a, b), transposition(c, d)), a) = b
                                            [using chain right-at-a ab-at-a]
                                          @b-is-right-at-a |
                                            b = apply(compose(transposition(a, b), transposition(c, d)), a)
                                            [by symmetry right-at-a-is-b]
                                          @agree-at-a |
                                            apply(compose(transposition(c, d), transposition(a, b)), a) = apply(compose(transposition(a, b), transposition(c, d)), a)
                                            [using chain left-at-a-is-b b-is-right-at-a]
                                          // AT b: left = (cd)(a) = a; right = (ab)(b) = a
                                          @left-at-b |
                                            apply(compose(transposition(c, d), transposition(a, b)), b) = apply(transposition(c, d), a)
                                            [using specialize compositeAtSecondOfInner(a, b, c, d)]
                                          @cd-fixes-a |
                                            apply(transposition(c, d), a) = a
                                            [using specialize transpositionElsewhere(c, d, a) ac ad]
                                          @left-at-b-is-a |
                                            apply(compose(transposition(c, d), transposition(a, b)), b) = a
                                            [using chain left-at-b cd-fixes-a]
                                          @right-at-b |
                                            apply(compose(transposition(a, b), transposition(c, d)), b) = apply(transposition(a, b), b)
                                            [using specialize compositeElsewhereOfInner(c, d, a, b, b) bc bd]
                                          @ab-at-b |
                                            apply(transposition(a, b), b) = a
                                            [using specialize transpositionAtSecond(a, b)]
                                          @right-at-b-is-a |
                                            apply(compose(transposition(a, b), transposition(c, d)), b) = a
                                            [using chain right-at-b ab-at-b]
                                          @a-is-right-at-b |
                                            a = apply(compose(transposition(a, b), transposition(c, d)), b)
                                            [by symmetry right-at-b-is-a]
                                          @agree-at-b |
                                            apply(compose(transposition(c, d), transposition(a, b)), b) = apply(compose(transposition(a, b), transposition(c, d)), b)
                                            [using chain left-at-b-is-a a-is-right-at-b]
                                          // AT c: left = (cd)(c) = d; right = (ab)(d) = d
                                          @left-at-c |
                                            apply(compose(transposition(c, d), transposition(a, b)), c) = apply(transposition(c, d), c)
                                            [using specialize compositeElsewhereOfInner(a, b, c, d, c) ca cb]
                                          @cd-at-c |
                                            apply(transposition(c, d), c) = d
                                            [using specialize transpositionAtFirst(c, d)]
                                          @left-at-c-is-d |
                                            apply(compose(transposition(c, d), transposition(a, b)), c) = d
                                            [using chain left-at-c cd-at-c]
                                          @right-at-c |
                                            apply(compose(transposition(a, b), transposition(c, d)), c) = apply(transposition(a, b), d)
                                            [using specialize compositeAtFirstOfInner(c, d, a, b)]
                                          @ab-fixes-d |
                                            apply(transposition(a, b), d) = d
                                            [using specialize transpositionElsewhere(a, b, d) da db]
                                          @right-at-c-is-d |
                                            apply(compose(transposition(a, b), transposition(c, d)), c) = d
                                            [using chain right-at-c ab-fixes-d]
                                          @d-is-right-at-c |
                                            d = apply(compose(transposition(a, b), transposition(c, d)), c)
                                            [by symmetry right-at-c-is-d]
                                          @agree-at-c |
                                            apply(compose(transposition(c, d), transposition(a, b)), c) = apply(compose(transposition(a, b), transposition(c, d)), c)
                                            [using chain left-at-c-is-d d-is-right-at-c]
                                          // AT d: left = (cd)(d) = c; right = (ab)(c) = c
                                          @left-at-d |
                                            apply(compose(transposition(c, d), transposition(a, b)), d) = apply(transposition(c, d), d)
                                            [using specialize compositeElsewhereOfInner(a, b, c, d, d) da db]
                                          @cd-at-d |
                                            apply(transposition(c, d), d) = c
                                            [using specialize transpositionAtSecond(c, d)]
                                          @left-at-d-is-c |
                                            apply(compose(transposition(c, d), transposition(a, b)), d) = c
                                            [using chain left-at-d cd-at-d]
                                          @right-at-d |
                                            apply(compose(transposition(a, b), transposition(c, d)), d) = apply(transposition(a, b), c)
                                            [using specialize compositeAtSecondOfInner(c, d, a, b)]
                                          @ab-fixes-c |
                                            apply(transposition(a, b), c) = c
                                            [using specialize transpositionElsewhere(a, b, c) ca cb]
                                          @right-at-d-is-c |
                                            apply(compose(transposition(a, b), transposition(c, d)), d) = c
                                            [using chain right-at-d ab-fixes-c]
                                          @c-is-right-at-d |
                                            c = apply(compose(transposition(a, b), transposition(c, d)), d)
                                            [by symmetry right-at-d-is-c]
                                          @agree-at-d |
                                            apply(compose(transposition(c, d), transposition(a, b)), d) = apply(compose(transposition(a, b), transposition(c, d)), d)
                                            [using chain left-at-d-is-c c-is-right-at-d]
                                          @generalize-x |
                                            fix x: Element {
                                              @x-cases |
                                                x = a or x = b or x = c or x = d or (x != a and x != b and x != c and x != d)
                                                [using tautology]
                                              @conclusion-agree-at-x |
                                                apply(compose(transposition(c, d), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(c, d)), x)
                                                case x-cases {
                                                  @when-x-is-a |
                                                    assume x = a {
                                                      @x-is-a |
                                                        x = a
                                                        [by hypothesis when-x-is-a]
                                                      @conclusion-at-a |
                                                        apply(compose(transposition(c, d), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(c, d)), x)
                                                        [by rewrite x-is-a agree-at-a]
                                                    }
                                                  @when-x-is-b |
                                                    assume x = b {
                                                      @x-is-b |
                                                        x = b
                                                        [by hypothesis when-x-is-b]
                                                      @conclusion-at-b |
                                                        apply(compose(transposition(c, d), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(c, d)), x)
                                                        [by rewrite x-is-b agree-at-b]
                                                    }
                                                  @when-x-is-c |
                                                    assume x = c {
                                                      @x-is-c |
                                                        x = c
                                                        [by hypothesis when-x-is-c]
                                                      @conclusion-at-c |
                                                        apply(compose(transposition(c, d), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(c, d)), x)
                                                        [by rewrite x-is-c agree-at-c]
                                                    }
                                                  @when-x-is-d |
                                                    assume x = d {
                                                      @x-is-d |
                                                        x = d
                                                        [by hypothesis when-x-is-d]
                                                      @conclusion-at-d |
                                                        apply(compose(transposition(c, d), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(c, d)), x)
                                                        [by rewrite x-is-d agree-at-d]
                                                    }
                                                  @when-x-is-none |
                                                    assume x != a and x != b and x != c and x != d {
                                                      @none |
                                                        x != a and x != b and x != c and x != d
                                                        [by hypothesis when-x-is-none]
                                                      @not-a |
                                                        x != a
                                                        [using tautology none]
                                                      @not-b |
                                                        x != b
                                                        [using tautology none]
                                                      @not-c |
                                                        x != c
                                                        [using tautology none]
                                                      @not-d |
                                                        x != d
                                                        [using tautology none]
                                                      @left-outer |
                                                        apply(compose(transposition(c, d), transposition(a, b)), x) = apply(transposition(c, d), x)
                                                        [using specialize compositeElsewhereOfInner(a, b, c, d, x) not-a not-b]
                                                      @cd-fixes-x |
                                                        apply(transposition(c, d), x) = x
                                                        [using specialize transpositionElsewhere(c, d, x) not-c not-d]
                                                      @left-is-x |
                                                        apply(compose(transposition(c, d), transposition(a, b)), x) = x
                                                        [using chain left-outer cd-fixes-x]
                                                      @right-outer |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = apply(transposition(a, b), x)
                                                        [using specialize compositeElsewhereOfInner(c, d, a, b, x) not-c not-d]
                                                      @ab-fixes-x |
                                                        apply(transposition(a, b), x) = x
                                                        [using specialize transpositionElsewhere(a, b, x) not-a not-b]
                                                      @right-is-x |
                                                        apply(compose(transposition(a, b), transposition(c, d)), x) = x
                                                        [using chain right-outer ab-fixes-x]
                                                      @x-is-right |
                                                        x = apply(compose(transposition(a, b), transposition(c, d)), x)
                                                        [by symmetry right-is-x]
                                                      @conclusion-at-none |
                                                        apply(compose(transposition(c, d), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(c, d)), x)
                                                        [using chain left-is-x x-is-right]
                                                    }
                                                }
                                            }
                                          @pointwise |
                                            forall x: Element; apply(compose(transposition(c, d), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(c, d)), x)
                                            [by generalize generalize-x]
                                          @conclusion-commute |
                                            compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
                                            [using specialize composedTranspositionsAgree(transposition(c, d), transposition(a, b), transposition(a, b), transposition(c, d)) pointwise]
                                        }
                                      @bd-implies |
                                        b != d -> compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
                                        [by discharge given-bd]
                                    }
                                  @bc-implies |
                                    b != c -> b != d -> compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
                                    [by discharge given-bc]
                                }
                              @ad-implies |
                                a != d -> b != c -> b != d -> compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
                                [by discharge given-ad]
                            }
                          @ac-implies |
                            a != c -> a != d -> b != c -> b != d -> compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
                            [by discharge given-ac]
                        }
                      @cd-implies |
                        c != d -> a != c -> a != d -> b != c -> b != d -> compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
                        [by discharge given-cd]
                    }
                  @ab-implies |
                    a != b -> c != d -> a != c -> a != d -> b != c -> b != d -> compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
                    [by discharge given-ab]
                }
              @discharge-d |
                forall d: Element; a != b -> c != d -> a != c -> a != d -> b != c -> b != d -> compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
                [by generalize generalize-d]
            }
          @discharge-c |
            forall c, d: Element; a != b -> c != d -> a != c -> a != d -> b != c -> b != d -> compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
            [by generalize generalize-c]
        }
      @discharge-b |
        forall b, c, d: Element; a != b -> c != d -> a != c -> a != d -> b != c -> b != d -> compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, c, d: Element; a != b -> c != d -> a != c -> a != d -> b != c -> b != d -> compose(transposition(c, d), transposition(a, b)) = compose(transposition(a, b), transposition(c, d))
    [by generalize generalize-a]
qed

// -- Judson's identity (2): (bc)(ab) = (ac)(bc) ---------------------------------------------
theorem shiftTheSharedLetter: forall a, b, c: Element; a != b -> b != c -> a != c -> compose(transposition(b, c), transposition(a, b)) = compose(transposition(a, c), transposition(b, c))
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @given-ab |
                assume a != b {
                  @given-bc |
                    assume b != c {
                      @given-ac |
                        assume a != c {
                          @ab |
                            a != b
                            [by hypothesis given-ab]
                          @bc |
                            b != c
                            [by hypothesis given-bc]
                          @ac |
                            a != c
                            [by hypothesis given-ac]
                          @ba |
                            b != a
                            [using specialize distinctSymmetric(a, b) ab]
                          @cb |
                            c != b
                            [using specialize distinctSymmetric(b, c) bc]
                          @ca |
                            c != a
                            [using specialize distinctSymmetric(a, c) ac]
                          @left-at-a |
                            apply(compose(transposition(b, c), transposition(a, b)), a) = apply(transposition(b, c), b)
                            [using specialize compositeAtFirstOfInner(a, b, b, c)]
                          @bc-at-b |
                            apply(transposition(b, c), b) = c
                            [using specialize transpositionAtFirst(b, c)]
                          @left-at-a-is-c |
                            apply(compose(transposition(b, c), transposition(a, b)), a) = c
                            [using chain left-at-a bc-at-b]
                          @right-at-a |
                            apply(compose(transposition(a, c), transposition(b, c)), a) = apply(transposition(a, c), a)
                            [using specialize compositeElsewhereOfInner(b, c, a, c, a) ab ac]
                          @ac-at-a |
                            apply(transposition(a, c), a) = c
                            [using specialize transpositionAtFirst(a, c)]
                          @right-at-a-is-c |
                            apply(compose(transposition(a, c), transposition(b, c)), a) = c
                            [using chain right-at-a ac-at-a]
                          @c-is-right-at-a |
                            c = apply(compose(transposition(a, c), transposition(b, c)), a)
                            [by symmetry right-at-a-is-c]
                          @agree-at-a |
                            apply(compose(transposition(b, c), transposition(a, b)), a) = apply(compose(transposition(a, c), transposition(b, c)), a)
                            [using chain left-at-a-is-c c-is-right-at-a]
                          @left-at-b |
                            apply(compose(transposition(b, c), transposition(a, b)), b) = apply(transposition(b, c), a)
                            [using specialize compositeAtSecondOfInner(a, b, b, c)]
                          @bc-fixes-a |
                            apply(transposition(b, c), a) = a
                            [using specialize transpositionElsewhere(b, c, a) ab ac]
                          @left-at-b-is-a |
                            apply(compose(transposition(b, c), transposition(a, b)), b) = a
                            [using chain left-at-b bc-fixes-a]
                          @right-at-b |
                            apply(compose(transposition(a, c), transposition(b, c)), b) = apply(transposition(a, c), c)
                            [using specialize compositeAtFirstOfInner(b, c, a, c)]
                          @ac-at-c |
                            apply(transposition(a, c), c) = a
                            [using specialize transpositionAtSecond(a, c)]
                          @right-at-b-is-a |
                            apply(compose(transposition(a, c), transposition(b, c)), b) = a
                            [using chain right-at-b ac-at-c]
                          @a-is-right-at-b |
                            a = apply(compose(transposition(a, c), transposition(b, c)), b)
                            [by symmetry right-at-b-is-a]
                          @agree-at-b |
                            apply(compose(transposition(b, c), transposition(a, b)), b) = apply(compose(transposition(a, c), transposition(b, c)), b)
                            [using chain left-at-b-is-a a-is-right-at-b]
                          @left-at-c |
                            apply(compose(transposition(b, c), transposition(a, b)), c) = apply(transposition(b, c), c)
                            [using specialize compositeElsewhereOfInner(a, b, b, c, c) ca cb]
                          @bc-at-c |
                            apply(transposition(b, c), c) = b
                            [using specialize transpositionAtSecond(b, c)]
                          @left-at-c-is-b |
                            apply(compose(transposition(b, c), transposition(a, b)), c) = b
                            [using chain left-at-c bc-at-c]
                          @right-at-c |
                            apply(compose(transposition(a, c), transposition(b, c)), c) = apply(transposition(a, c), b)
                            [using specialize compositeAtSecondOfInner(b, c, a, c)]
                          @ac-fixes-b |
                            apply(transposition(a, c), b) = b
                            [using specialize transpositionElsewhere(a, c, b) ba bc]
                          @right-at-c-is-b |
                            apply(compose(transposition(a, c), transposition(b, c)), c) = b
                            [using chain right-at-c ac-fixes-b]
                          @b-is-right-at-c |
                            b = apply(compose(transposition(a, c), transposition(b, c)), c)
                            [by symmetry right-at-c-is-b]
                          @agree-at-c |
                            apply(compose(transposition(b, c), transposition(a, b)), c) = apply(compose(transposition(a, c), transposition(b, c)), c)
                            [using chain left-at-c-is-b b-is-right-at-c]
                          @generalize-x |
                            fix x: Element {
                              @x-cases |
                                x = a or x = b or x = c or (x != a and x != b and x != c)
                                [using tautology]
                              @conclusion-agree-at-x |
                                apply(compose(transposition(b, c), transposition(a, b)), x) = apply(compose(transposition(a, c), transposition(b, c)), x)
                                case x-cases {
                                  @when-x-is-a |
                                    assume x = a {
                                      @x-is-a |
                                        x = a
                                        [by hypothesis when-x-is-a]
                                      @conclusion-at-a |
                                        apply(compose(transposition(b, c), transposition(a, b)), x) = apply(compose(transposition(a, c), transposition(b, c)), x)
                                        [by rewrite x-is-a agree-at-a]
                                    }
                                  @when-x-is-b |
                                    assume x = b {
                                      @x-is-b |
                                        x = b
                                        [by hypothesis when-x-is-b]
                                      @conclusion-at-b |
                                        apply(compose(transposition(b, c), transposition(a, b)), x) = apply(compose(transposition(a, c), transposition(b, c)), x)
                                        [by rewrite x-is-b agree-at-b]
                                    }
                                  @when-x-is-c |
                                    assume x = c {
                                      @x-is-c |
                                        x = c
                                        [by hypothesis when-x-is-c]
                                      @conclusion-at-c |
                                        apply(compose(transposition(b, c), transposition(a, b)), x) = apply(compose(transposition(a, c), transposition(b, c)), x)
                                        [by rewrite x-is-c agree-at-c]
                                    }
                                  @when-x-is-none |
                                    assume x != a and x != b and x != c {
                                      @none |
                                        x != a and x != b and x != c
                                        [by hypothesis when-x-is-none]
                                      @not-a |
                                        x != a
                                        [using tautology none]
                                      @not-b |
                                        x != b
                                        [using tautology none]
                                      @not-c |
                                        x != c
                                        [using tautology none]
                                      @left-outer |
                                        apply(compose(transposition(b, c), transposition(a, b)), x) = apply(transposition(b, c), x)
                                        [using specialize compositeElsewhereOfInner(a, b, b, c, x) not-a not-b]
                                      @bc-fixes-x |
                                        apply(transposition(b, c), x) = x
                                        [using specialize transpositionElsewhere(b, c, x) not-b not-c]
                                      @left-is-x |
                                        apply(compose(transposition(b, c), transposition(a, b)), x) = x
                                        [using chain left-outer bc-fixes-x]
                                      @right-outer |
                                        apply(compose(transposition(a, c), transposition(b, c)), x) = apply(transposition(a, c), x)
                                        [using specialize compositeElsewhereOfInner(b, c, a, c, x) not-b not-c]
                                      @ac-fixes-x |
                                        apply(transposition(a, c), x) = x
                                        [using specialize transpositionElsewhere(a, c, x) not-a not-c]
                                      @right-is-x |
                                        apply(compose(transposition(a, c), transposition(b, c)), x) = x
                                        [using chain right-outer ac-fixes-x]
                                      @x-is-right |
                                        x = apply(compose(transposition(a, c), transposition(b, c)), x)
                                        [by symmetry right-is-x]
                                      @conclusion-at-none |
                                        apply(compose(transposition(b, c), transposition(a, b)), x) = apply(compose(transposition(a, c), transposition(b, c)), x)
                                        [using chain left-is-x x-is-right]
                                    }
                                }
                            }
                          @pointwise |
                            forall x: Element; apply(compose(transposition(b, c), transposition(a, b)), x) = apply(compose(transposition(a, c), transposition(b, c)), x)
                            [by generalize generalize-x]
                          @conclusion-identity |
                            compose(transposition(b, c), transposition(a, b)) = compose(transposition(a, c), transposition(b, c))
                            [using specialize composedTranspositionsAgree(transposition(b, c), transposition(a, b), transposition(a, c), transposition(b, c)) pointwise]
                        }
                      @ac-implies |
                        a != c -> compose(transposition(b, c), transposition(a, b)) = compose(transposition(a, c), transposition(b, c))
                        [by discharge given-ac]
                    }
                  @bc-implies |
                    b != c -> a != c -> compose(transposition(b, c), transposition(a, b)) = compose(transposition(a, c), transposition(b, c))
                    [by discharge given-bc]
                }
              @ab-implies |
                a != b -> b != c -> a != c -> compose(transposition(b, c), transposition(a, b)) = compose(transposition(a, c), transposition(b, c))
                [by discharge given-ab]
            }
          @discharge-c |
            forall c: Element; a != b -> b != c -> a != c -> compose(transposition(b, c), transposition(a, b)) = compose(transposition(a, c), transposition(b, c))
            [by generalize generalize-c]
        }
      @discharge-b |
        forall b, c: Element; a != b -> b != c -> a != c -> compose(transposition(b, c), transposition(a, b)) = compose(transposition(a, c), transposition(b, c))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, c: Element; a != b -> b != c -> a != c -> compose(transposition(b, c), transposition(a, b)) = compose(transposition(a, c), transposition(b, c))
    [by generalize generalize-a]
qed

// -- Judson's identity (4): (ac)(ab) = (ab)(bc) ---------------------------------------------
// The remaining rewrite. Same four-case pointwise comparison; both sides send a to b, b to c,
// c to a, and fix everything else — the 3-cycle (a b c), reached two different ways.
theorem rotateTheSharedLetter: forall a, b, c: Element; a != b -> b != c -> a != c -> compose(transposition(a, c), transposition(a, b)) = compose(transposition(a, b), transposition(b, c))
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-c |
            fix c: Element {
              @given-ab |
                assume a != b {
                  @given-bc |
                    assume b != c {
                      @given-ac |
                        assume a != c {
                          @ab |
                            a != b
                            [by hypothesis given-ab]
                          @bc |
                            b != c
                            [by hypothesis given-bc]
                          @ac |
                            a != c
                            [by hypothesis given-ac]
                          @ba |
                            b != a
                            [using specialize distinctSymmetric(a, b) ab]
                          @cb |
                            c != b
                            [using specialize distinctSymmetric(b, c) bc]
                          @ca |
                            c != a
                            [using specialize distinctSymmetric(a, c) ac]
                          @left-at-a |
                            apply(compose(transposition(a, c), transposition(a, b)), a) = apply(transposition(a, c), b)
                            [using specialize compositeAtFirstOfInner(a, b, a, c)]
                          @ac-fixes-b |
                            apply(transposition(a, c), b) = b
                            [using specialize transpositionElsewhere(a, c, b) ba bc]
                          @left-at-a-is-b |
                            apply(compose(transposition(a, c), transposition(a, b)), a) = b
                            [using chain left-at-a ac-fixes-b]
                          @right-at-a |
                            apply(compose(transposition(a, b), transposition(b, c)), a) = apply(transposition(a, b), a)
                            [using specialize compositeElsewhereOfInner(b, c, a, b, a) ab ac]
                          @ab-at-a |
                            apply(transposition(a, b), a) = b
                            [using specialize transpositionAtFirst(a, b)]
                          @right-at-a-is-b |
                            apply(compose(transposition(a, b), transposition(b, c)), a) = b
                            [using chain right-at-a ab-at-a]
                          @b-is-right-at-a |
                            b = apply(compose(transposition(a, b), transposition(b, c)), a)
                            [by symmetry right-at-a-is-b]
                          @agree-at-a |
                            apply(compose(transposition(a, c), transposition(a, b)), a) = apply(compose(transposition(a, b), transposition(b, c)), a)
                            [using chain left-at-a-is-b b-is-right-at-a]
                          @left-at-b |
                            apply(compose(transposition(a, c), transposition(a, b)), b) = apply(transposition(a, c), a)
                            [using specialize compositeAtSecondOfInner(a, b, a, c)]
                          @ac-at-a |
                            apply(transposition(a, c), a) = c
                            [using specialize transpositionAtFirst(a, c)]
                          @left-at-b-is-c |
                            apply(compose(transposition(a, c), transposition(a, b)), b) = c
                            [using chain left-at-b ac-at-a]
                          @right-at-b |
                            apply(compose(transposition(a, b), transposition(b, c)), b) = apply(transposition(a, b), c)
                            [using specialize compositeAtFirstOfInner(b, c, a, b)]
                          @ab-fixes-c |
                            apply(transposition(a, b), c) = c
                            [using specialize transpositionElsewhere(a, b, c) ca cb]
                          @right-at-b-is-c |
                            apply(compose(transposition(a, b), transposition(b, c)), b) = c
                            [using chain right-at-b ab-fixes-c]
                          @c-is-right-at-b |
                            c = apply(compose(transposition(a, b), transposition(b, c)), b)
                            [by symmetry right-at-b-is-c]
                          @agree-at-b |
                            apply(compose(transposition(a, c), transposition(a, b)), b) = apply(compose(transposition(a, b), transposition(b, c)), b)
                            [using chain left-at-b-is-c c-is-right-at-b]
                          @left-at-c |
                            apply(compose(transposition(a, c), transposition(a, b)), c) = apply(transposition(a, c), c)
                            [using specialize compositeElsewhereOfInner(a, b, a, c, c) ca cb]
                          @ac-at-c |
                            apply(transposition(a, c), c) = a
                            [using specialize transpositionAtSecond(a, c)]
                          @left-at-c-is-a |
                            apply(compose(transposition(a, c), transposition(a, b)), c) = a
                            [using chain left-at-c ac-at-c]
                          @right-at-c |
                            apply(compose(transposition(a, b), transposition(b, c)), c) = apply(transposition(a, b), b)
                            [using specialize compositeAtSecondOfInner(b, c, a, b)]
                          @ab-at-b |
                            apply(transposition(a, b), b) = a
                            [using specialize transpositionAtSecond(a, b)]
                          @right-at-c-is-a |
                            apply(compose(transposition(a, b), transposition(b, c)), c) = a
                            [using chain right-at-c ab-at-b]
                          @a-is-right-at-c |
                            a = apply(compose(transposition(a, b), transposition(b, c)), c)
                            [by symmetry right-at-c-is-a]
                          @agree-at-c |
                            apply(compose(transposition(a, c), transposition(a, b)), c) = apply(compose(transposition(a, b), transposition(b, c)), c)
                            [using chain left-at-c-is-a a-is-right-at-c]
                          @generalize-x |
                            fix x: Element {
                              @x-cases |
                                x = a or x = b or x = c or (x != a and x != b and x != c)
                                [using tautology]
                              @conclusion-agree-at-x |
                                apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(b, c)), x)
                                case x-cases {
                                  @when-x-is-a |
                                    assume x = a {
                                      @x-is-a |
                                        x = a
                                        [by hypothesis when-x-is-a]
                                      @conclusion-at-a |
                                        apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(b, c)), x)
                                        [by rewrite x-is-a agree-at-a]
                                    }
                                  @when-x-is-b |
                                    assume x = b {
                                      @x-is-b |
                                        x = b
                                        [by hypothesis when-x-is-b]
                                      @conclusion-at-b |
                                        apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(b, c)), x)
                                        [by rewrite x-is-b agree-at-b]
                                    }
                                  @when-x-is-c |
                                    assume x = c {
                                      @x-is-c |
                                        x = c
                                        [by hypothesis when-x-is-c]
                                      @conclusion-at-c |
                                        apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(b, c)), x)
                                        [by rewrite x-is-c agree-at-c]
                                    }
                                  @when-x-is-none |
                                    assume x != a and x != b and x != c {
                                      @none |
                                        x != a and x != b and x != c
                                        [by hypothesis when-x-is-none]
                                      @not-a |
                                        x != a
                                        [using tautology none]
                                      @not-b |
                                        x != b
                                        [using tautology none]
                                      @not-c |
                                        x != c
                                        [using tautology none]
                                      @left-outer |
                                        apply(compose(transposition(a, c), transposition(a, b)), x) = apply(transposition(a, c), x)
                                        [using specialize compositeElsewhereOfInner(a, b, a, c, x) not-a not-b]
                                      @ac-fixes-x |
                                        apply(transposition(a, c), x) = x
                                        [using specialize transpositionElsewhere(a, c, x) not-a not-c]
                                      @left-is-x |
                                        apply(compose(transposition(a, c), transposition(a, b)), x) = x
                                        [using chain left-outer ac-fixes-x]
                                      @right-outer |
                                        apply(compose(transposition(a, b), transposition(b, c)), x) = apply(transposition(a, b), x)
                                        [using specialize compositeElsewhereOfInner(b, c, a, b, x) not-b not-c]
                                      @ab-fixes-x |
                                        apply(transposition(a, b), x) = x
                                        [using specialize transpositionElsewhere(a, b, x) not-a not-b]
                                      @right-is-x |
                                        apply(compose(transposition(a, b), transposition(b, c)), x) = x
                                        [using chain right-outer ab-fixes-x]
                                      @x-is-right |
                                        x = apply(compose(transposition(a, b), transposition(b, c)), x)
                                        [by symmetry right-is-x]
                                      @conclusion-at-none |
                                        apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(b, c)), x)
                                        [using chain left-is-x x-is-right]
                                    }
                                }
                            }
                          @pointwise |
                            forall x: Element; apply(compose(transposition(a, c), transposition(a, b)), x) = apply(compose(transposition(a, b), transposition(b, c)), x)
                            [by generalize generalize-x]
                          @conclusion-identity |
                            compose(transposition(a, c), transposition(a, b)) = compose(transposition(a, b), transposition(b, c))
                            [using specialize composedTranspositionsAgree(transposition(a, c), transposition(a, b), transposition(a, b), transposition(b, c)) pointwise]
                        }
                      @ac-implies |
                        a != c -> compose(transposition(a, c), transposition(a, b)) = compose(transposition(a, b), transposition(b, c))
                        [by discharge given-ac]
                    }
                  @bc-implies |
                    b != c -> a != c -> compose(transposition(a, c), transposition(a, b)) = compose(transposition(a, b), transposition(b, c))
                    [by discharge given-bc]
                }
              @ab-implies |
                a != b -> b != c -> a != c -> compose(transposition(a, c), transposition(a, b)) = compose(transposition(a, b), transposition(b, c))
                [by discharge given-ab]
            }
          @discharge-c |
            forall c: Element; a != b -> b != c -> a != c -> compose(transposition(a, c), transposition(a, b)) = compose(transposition(a, b), transposition(b, c))
            [by generalize generalize-c]
        }
      @discharge-b |
        forall b, c: Element; a != b -> b != c -> a != c -> compose(transposition(a, c), transposition(a, b)) = compose(transposition(a, b), transposition(b, c))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, c: Element; a != b -> b != c -> a != c -> compose(transposition(a, c), transposition(a, b)) = compose(transposition(a, b), transposition(b, c))
    [by generalize generalize-a]
qed

// -- THE REWRITING STEP: replacing two adjacent factors -------------------------------------
// Each of Judson's identities rewrites the pair at positions (k, k+1) of a product. The
// sequence surgery is an existence postulate in the style of this layer's other sequence
// axioms; the PAYOFF below is that the product is unchanged when the new pair composes to the
// old one. Entries outside the replaced positions are untouched, which is what lets the inner
// induction carry "every entry above j fixes `a`" across a rewrite.
axiom seqReplaceTwo: forall s: Seq; forall k: Nat; forall p: Fn; forall q: Fn;
  invertible(p) -> invertible(q) ->
  exists u: Seq;
  at(u, k) = p
  and at(u, succ(k)) = q
  and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i))
  and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i))
// Replacing the pair at (k, k+1) by a composite EQUAL to it leaves the product up to k+2
// unchanged: productUpTo(u, k+2) = ((prefix)·p)·q and the prefix is shared.
theorem replacingAPairKeepsTheProduct: forall s: Seq; forall u: Seq; forall k: Nat;
  (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) ->
  compose(at(u, k), at(u, succ(k))) = compose(at(s, k), at(s, succ(k))) ->
  productUpTo(u, k) = productUpTo(s, k) ->
  productUpTo(u, succ(succ(k))) = productUpTo(s, succ(succ(k)))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-u |
        fix u: Seq {
          @generalize-k |
            fix k: Nat {
              @given-prefix |
                assume forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i) {
                  @given-pair |
                    assume compose(at(u, k), at(u, succ(k))) = compose(at(s, k), at(s, succ(k))) {
                      @given-prefix-product |
                        assume productUpTo(u, k) = productUpTo(s, k) {
                          @pair-equal |
                            compose(at(u, k), at(u, succ(k))) = compose(at(s, k), at(s, succ(k)))
                            [by hypothesis given-pair]
                          @prefix-product-equal |
                            productUpTo(u, k) = productUpTo(s, k)
                            [by hypothesis given-prefix-product]
                          // productUpTo(·, k+2) = ((·|k) ∘ at(·,k)) ∘ at(·,k+1), regrouped to
                          // (·|k) ∘ (at(·,k) ∘ at(·,k+1)) so the pair appears as one factor.
                          @u-unfolds-once |
                            productUpTo(u, succ(succ(k))) = compose(productUpTo(u, succ(k)), at(u, succ(k)))
                            [using specialize productUpToSucc(u, succ(k))]
                          @u-unfolds-twice |
                            productUpTo(u, succ(k)) = compose(productUpTo(u, k), at(u, k))
                            [using specialize productUpToSucc(u, k)]
                          @u-expanded |
                            productUpTo(u, succ(succ(k))) = compose(compose(productUpTo(u, k), at(u, k)), at(u, succ(k)))
                            [by rewrite u-unfolds-twice u-unfolds-once]
                          @u-regrouped |
                            compose(compose(productUpTo(u, k), at(u, k)), at(u, succ(k))) = compose(productUpTo(u, k), compose(at(u, k), at(u, succ(k))))
                            [using assoc(composeAssoc)]
                          @u-as-prefix-times-pair |
                            productUpTo(u, succ(succ(k))) = compose(productUpTo(u, k), compose(at(u, k), at(u, succ(k))))
                            [using chain u-expanded u-regrouped]
                          @s-unfolds-once |
                            productUpTo(s, succ(succ(k))) = compose(productUpTo(s, succ(k)), at(s, succ(k)))
                            [using specialize productUpToSucc(s, succ(k))]
                          @s-unfolds-twice |
                            productUpTo(s, succ(k)) = compose(productUpTo(s, k), at(s, k))
                            [using specialize productUpToSucc(s, k)]
                          @s-expanded |
                            productUpTo(s, succ(succ(k))) = compose(compose(productUpTo(s, k), at(s, k)), at(s, succ(k)))
                            [by rewrite s-unfolds-twice s-unfolds-once]
                          @s-regrouped |
                            compose(compose(productUpTo(s, k), at(s, k)), at(s, succ(k))) = compose(productUpTo(s, k), compose(at(s, k), at(s, succ(k))))
                            [using assoc(composeAssoc)]
                          @s-as-prefix-times-pair |
                            productUpTo(s, succ(succ(k))) = compose(productUpTo(s, k), compose(at(s, k), at(s, succ(k))))
                            [using chain s-expanded s-regrouped]
                          // substitute the equal pair, then the equal prefix
                          @u-with-s-pair |
                            productUpTo(u, succ(succ(k))) = compose(productUpTo(u, k), compose(at(s, k), at(s, succ(k))))
                            [by rewrite pair-equal u-as-prefix-times-pair]
                          @u-with-s-prefix |
                            productUpTo(u, succ(succ(k))) = compose(productUpTo(s, k), compose(at(s, k), at(s, succ(k))))
                            [by rewrite prefix-product-equal u-with-s-pair]
                          @s-flipped |
                            compose(productUpTo(s, k), compose(at(s, k), at(s, succ(k)))) = productUpTo(s, succ(succ(k)))
                            [by symmetry s-as-prefix-times-pair]
                          @conclusion-products-agree |
                            productUpTo(u, succ(succ(k))) = productUpTo(s, succ(succ(k)))
                            [using chain u-with-s-prefix s-flipped]
                        }
                      @prefix-product-implies |
                        productUpTo(u, k) = productUpTo(s, k) -> productUpTo(u, succ(succ(k))) = productUpTo(s, succ(succ(k)))
                        [by discharge given-prefix-product]
                    }
                  @pair-implies |
                    compose(at(u, k), at(u, succ(k))) = compose(at(s, k), at(s, succ(k))) -> productUpTo(u, k) = productUpTo(s, k) -> productUpTo(u, succ(succ(k))) = productUpTo(s, succ(succ(k)))
                    [by discharge given-pair]
                }
              @prefix-implies |
                (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> compose(at(u, k), at(u, succ(k))) = compose(at(s, k), at(s, succ(k))) -> productUpTo(u, k) = productUpTo(s, k) -> productUpTo(u, succ(succ(k))) = productUpTo(s, succ(succ(k)))
                [by discharge given-prefix]
            }
          @discharge-k |
            forall k: Nat; (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> compose(at(u, k), at(u, succ(k))) = compose(at(s, k), at(s, succ(k))) -> productUpTo(u, k) = productUpTo(s, k) -> productUpTo(u, succ(succ(k))) = productUpTo(s, succ(succ(k)))
            [by generalize generalize-k]
        }
      @discharge-u |
        forall u: Seq; forall k: Nat; (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> compose(at(u, k), at(u, succ(k))) = compose(at(s, k), at(s, succ(k))) -> productUpTo(u, k) = productUpTo(s, k) -> productUpTo(u, succ(succ(k))) = productUpTo(s, succ(succ(k)))
        [by generalize generalize-u]
    }
  @conclusion |
    forall s: Seq; forall u: Seq; forall k: Nat; (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> compose(at(u, k), at(u, succ(k))) = compose(at(s, k), at(s, succ(k))) -> productUpTo(u, k) = productUpTo(s, k) -> productUpTo(u, succ(succ(k))) = productUpTo(s, succ(succ(k)))
    [by generalize generalize-s]
qed

// -- DELETING a cancelling pair --------------------------------------------------------------
// The other exit from the inner loop. As above, the `seqDeleteTwo` surgery postulate waits for
// its consumer; the product fact is what matters and needs no surgery to state.
// Deleting a pair that composes to the identity keeps every product from k+2 onward: the
// prefix is shared, and productUpTo(u, k) = productUpTo(s, k) = productUpTo(s, k+2).
theorem deletingACancellingPairKeepsTheProduct: forall s: Seq; forall k: Nat;
  compose(at(s, k), at(s, succ(k))) = identityFn ->
  productUpTo(s, succ(succ(k))) = productUpTo(s, k)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-k |
        fix k: Nat {
          @given-cancels |
            assume compose(at(s, k), at(s, succ(k))) = identityFn {
              @cancels |
                compose(at(s, k), at(s, succ(k))) = identityFn
                [by hypothesis given-cancels]
              @unfolds-once |
                productUpTo(s, succ(succ(k))) = compose(productUpTo(s, succ(k)), at(s, succ(k)))
                [using specialize productUpToSucc(s, succ(k))]
              @unfolds-twice |
                productUpTo(s, succ(k)) = compose(productUpTo(s, k), at(s, k))
                [using specialize productUpToSucc(s, k)]
              @expanded |
                productUpTo(s, succ(succ(k))) = compose(compose(productUpTo(s, k), at(s, k)), at(s, succ(k)))
                [by rewrite unfolds-twice unfolds-once]
              @regrouped |
                compose(compose(productUpTo(s, k), at(s, k)), at(s, succ(k))) = compose(productUpTo(s, k), compose(at(s, k), at(s, succ(k))))
                [using assoc(composeAssoc)]
              @as-prefix-times-pair |
                productUpTo(s, succ(succ(k))) = compose(productUpTo(s, k), compose(at(s, k), at(s, succ(k))))
                [using chain expanded regrouped]
              @with-identity |
                productUpTo(s, succ(succ(k))) = compose(productUpTo(s, k), identityFn)
                [by rewrite cancels as-prefix-times-pair]
              @identity-on-the-right |
                compose(productUpTo(s, k), identityFn) = productUpTo(s, k)
                [using specialize composeIdentityRight(productUpTo(s, k))]
              @conclusion-drops-by-two |
                productUpTo(s, succ(succ(k))) = productUpTo(s, k)
                [using chain with-identity identity-on-the-right]
            }
          @cancels-implies |
            compose(at(s, k), at(s, succ(k))) = identityFn -> productUpTo(s, succ(succ(k))) = productUpTo(s, k)
            [by discharge given-cancels]
        }
      @discharge-k |
        forall k: Nat; compose(at(s, k), at(s, succ(k))) = identityFn -> productUpTo(s, succ(succ(k))) = productUpTo(s, k)
        [by generalize generalize-k]
    }
  @conclusion |
    forall s: Seq; forall k: Nat; compose(at(s, k), at(s, succ(k))) = identityFn -> productUpTo(s, succ(succ(k))) = productUpTo(s, k)
    [by generalize generalize-s]
qed

// -- WHAT REMAINS (updated 2026-09-29) --------------------------------------------------------
// STEPS 1 and 3 are DONE (adjacentPairCancelsOrShiftsOff; productActsAsItsFirstFactor +
// identityProductForcesFirstFactorToFix). What is left is STEP 2, the inner induction, and
// STEP 4, the outer one. The design below is unchanged; two notes from attempting STEP 2:
//
//  * State the inner step at `succ(m)` rather than at `j`, so the predecessor is literally `m`
//    and no truncating `sub` appears. Its conclusion is a DISJUNCTION (cancellation available,
//    or a new sequence with the letter pushed one place left), so every enclosing `->` needs
//    explicit parens — the checker rejects `A or B -> C` outright.
//  * The surgery postulate STEP 2 will need, held back until then so the library gate stays
//    honest:
//      axiom seqReplaceTwo: forall s: Seq; forall k: Nat; forall p: Fn; forall q: Fn;
//        invertible(p) -> invertible(q) ->
//        exists u: Seq; at(u, k) = p and at(u, succ(k)) = q
//        and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i))
//        and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i))
//  * The letter `a` must be CHOSEN as one that entry 0 moves; that is where isTransposition's
//    existential gets unpacked (entry 0 = (u v) with u != v, so it moves u). Without that
//    choice the fixed-point argument at j = 0 has nothing to contradict.
//
// -- THE ORIGINAL DESIGN ----------------------------------------------------------------------
// Everything above is the algebraic and structural input to Judson's lemma. The remaining
// piece is ONE induction plus a fixed-point argument, specified here so it can be picked up
// without re-deriving the design.
//
// `moves(t, x)` — the predicate the loop tracks — is `apply(t, x) != x`.
//
// STEP 1: CLASSIFY an adjacent pair whose RIGHT factor moves `a`. For a ≠ b and u ≠ v,
//   (u v)(a b) either composes to the identity (when (u v) = (a b)) or equals a pair whose
//   right factor FIXES `a`:
//     (u v) = (b c), c ∉ {a,b}  → (a c)(b c)   [shiftTheSharedLetter]
//     (u v) = (a c), c ∉ {a,b}  → (a b)(b c)   [rotateTheSharedLetter]
//     (u v) = (c d) disjoint    → (a b)(c d)   [disjointTranspositionsCommute]
//   The bookkeeping is the six-way split on how {u,v} meets {a,b} (u=a, u=b, v=a, v=b, both,
//   neither) plus assembling each branch's distinctness facts. Every algebraic fact it needs
//   is already proved above; this is case analysis, not new mathematics.
//
// STEP 2: the INNER induction. With r fixed, on j descending: if there is a product of r
//   transpositions equal to the identity in which `a` is moved by no entry above index j,
//   then either some product of r − 2 transpositions equals the identity (a cancellation was
//   reached), or the same holds for j − 1 (apply STEP 1 at (j−1, j), rewrite by
//   seqReplaceTwo + replacingAPairKeepsTheProduct). Ordinary downward ℕ induction; the outer
//   measure r never moves.
//
// STEP 3: the FIXED-POINT argument. At j = 0 only entry 0 can move `a`, so the product moves
//   `a` — but the product is the identity, which fixes it. Contradiction, so STEP 2 always
//   exits by cancellation.
//
// STEP 4: the OUTER induction — strongInduction on r. r = 0 is even. r = 1 is impossible (a
//   transposition is not the identity: it moves its two letters). For r ≥ 2, STEP 2+3 give a
//   product of r − 2, even by the hypothesis, so r is even.
//
// Then `aata/5.1-permutation-groups.md` replaces `axiom identityIsEvenLength` with a citation
// and the chapter's last assumption of its own making is gone.

// -- two small facts the classification needs ------------------------------------------------
// (u v) and (v u) are the same map: both exchange the two letters and fix the rest.
theorem transpositionIsSymmetric: forall u, v: Element; transposition(u, v) = transposition(v, u)
proof
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @generalize-x |
            fix x: Element {
              @left-value |
                (x = u -> apply(transposition(u, v), x) = v) and (x = v -> apply(transposition(u, v), x) = u) and ((x != u and x != v) -> apply(transposition(u, v), x) = x)
                [using specialize transpositionValue(u, v, x)]
              @right-value |
                (x = v -> apply(transposition(v, u), x) = u) and (x = u -> apply(transposition(v, u), x) = v) and ((x != v and x != u) -> apply(transposition(v, u), x) = x)
                [using specialize transpositionValue(v, u, x)]
              @x-cases |
                x = u or x = v or (x != u and x != v)
                [using tautology]
              @conclusion-agree |
                apply(transposition(u, v), x) = apply(transposition(v, u), x)
                case x-cases {
                  @when-x-is-u |
                    assume x = u {
                      @x-is-u |
                        x = u
                        [by hypothesis when-x-is-u]
                      @left-at-u |
                        apply(transposition(u, v), x) = v
                        [using tautology left-value x-is-u]
                      @right-at-u |
                        apply(transposition(v, u), x) = v
                        [using tautology right-value x-is-u]
                      @v-is-right |
                        v = apply(transposition(v, u), x)
                        [by symmetry right-at-u]
                      @conclusion-at-u |
                        apply(transposition(u, v), x) = apply(transposition(v, u), x)
                        [using chain left-at-u v-is-right]
                    }
                  @when-x-is-v |
                    assume x = v {
                      @x-is-v |
                        x = v
                        [by hypothesis when-x-is-v]
                      @left-at-v |
                        apply(transposition(u, v), x) = u
                        [using tautology left-value x-is-v]
                      @right-at-v |
                        apply(transposition(v, u), x) = u
                        [using tautology right-value x-is-v]
                      @u-is-right |
                        u = apply(transposition(v, u), x)
                        [by symmetry right-at-v]
                      @conclusion-at-v |
                        apply(transposition(u, v), x) = apply(transposition(v, u), x)
                        [using chain left-at-v u-is-right]
                    }
                  @when-x-is-neither |
                    assume x != u and x != v {
                      @neither |
                        x != u and x != v
                        [by hypothesis when-x-is-neither]
                      @not-u |
                        x != u
                        [using tautology neither]
                      @not-v |
                        x != v
                        [using tautology neither]
                      @left-fixes |
                        apply(transposition(u, v), x) = x
                        [using specialize transpositionElsewhere(u, v, x) not-u not-v]
                      @right-fixes |
                        apply(transposition(v, u), x) = x
                        [using specialize transpositionElsewhere(v, u, x) not-v not-u]
                      @x-is-right |
                        x = apply(transposition(v, u), x)
                        [by symmetry right-fixes]
                      @conclusion-at-neither |
                        apply(transposition(u, v), x) = apply(transposition(v, u), x)
                        [using chain left-fixes x-is-right]
                    }
                }
            }
          @pointwise |
            forall x: Element; apply(transposition(u, v), x) = apply(transposition(v, u), x)
            [by generalize generalize-x]
          @conclusion-symmetric |
            transposition(u, v) = transposition(v, u)
            [using specialize funcExtensionality(transposition(u, v), transposition(v, u)) pointwise]
        }
      @discharge-v |
        forall v: Element; transposition(u, v) = transposition(v, u)
        [by generalize generalize-v]
    }
  @conclusion |
    forall u, v: Element; transposition(u, v) = transposition(v, u)
    [by generalize generalize-u]
qed

// (b a)(a b) = identity — the reversed pair cancels too, since (b a) IS (a b).
theorem transpositionPairCancelsReversed: forall a, b: Element; compose(transposition(b, a), transposition(a, b)) = identityFn
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @reversed-is-same |
            transposition(b, a) = transposition(a, b)
            [using specialize transpositionIsSymmetric(b, a)]
          @ab-cancels |
            compose(transposition(a, b), transposition(a, b)) = identityFn
            [using specialize transpositionsCancel(a, b)]
          @conclusion-cancels |
            compose(transposition(b, a), transposition(a, b)) = identityFn
            [by rewrite reversed-is-same ab-cancels]
        }
      @discharge-b |
        forall b: Element; compose(transposition(b, a), transposition(a, b)) = identityFn
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Element; compose(transposition(b, a), transposition(a, b)) = identityFn
    [by generalize generalize-a]
qed

// A swap of two DISTINCT letters is a transposition — the existential, witnessed by the letters
// themselves. Needed because the classification below must report that its witnesses are
// transpositions, so a rewrite keeps the sequence's entries transpositions.
theorem swapIsATransposition: forall x, y: Element; x != y -> isTransposition(transposition(x, y))
proof
  @generalize-x |
    fix x: Element {
      @generalize-y |
        fix y: Element {
          @given-distinct |
            assume x != y {
              @distinct |
                x != y
                [by hypothesis given-distinct]
              @reflexive |
                transposition(x, y) = transposition(x, y)
                [by reflexivity]
              @witnessed |
                x != y and transposition(x, y) = transposition(x, y)
                [by both distinct reflexive]
              @inner-exists |
                exists v: Element; x != v and transposition(x, y) = transposition(x, v)
                [by witness(y) witnessed]
              @conclusion-is-a-transposition |
                isTransposition(transposition(x, y))
                [by witness(x) inner-exists]
            }
          @distinct-implies |
            x != y -> isTransposition(transposition(x, y))
            [by discharge given-distinct]
        }
      @discharge-y |
        forall y: Element; x != y -> isTransposition(transposition(x, y))
        [by generalize generalize-y]
    }
  @conclusion |
    forall x, y: Element; x != y -> isTransposition(transposition(x, y))
    [by generalize generalize-x]
qed

// -- CLASSIFYING an adjacent pair whose right factor moves `a` -------------------------------
// The engine of the inner loop. For a != b and u != v the pair (u v)(a b) — whose RIGHT factor
// moves `a` — either composes to the identity, or equals a pair whose right factor FIXES `a`.
// Which of Judson's identities applies is decided by how {u, v} meets {a, b}: six branches,
// two of them cancellations, the other four citing the identity proved for that shape above.
theorem adjacentPairCancelsOrShiftsOff: forall a, b, u, v: Element; a != b -> u != v ->
  (compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a))
proof
  @generalize-a |
    fix a: Element {
      @generalize-b |
        fix b: Element {
          @generalize-u |
            fix u: Element {
              @generalize-v |
                fix v: Element {
                  @given-ab |
                    assume a != b {
                      @given-uv |
                        assume u != v {
                          @ab |
                            a != b
                            [by hypothesis given-ab]
                          @uv |
                            u != v
                            [by hypothesis given-uv]
                          @u-cases |
                            u = a or u = b or (u != a and u != b)
                            [using tautology]
                          @conclusion-classified |
                            compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                            case u-cases {
                              @when-u-is-a |
                                assume u = a {
                                  @u-is-a |
                                    u = a
                                    [by hypothesis when-u-is-a]
                                  @a-not-v |
                                    a != v
                                    [by rewrite u-is-a uv]
                                  @v-is-b-or-not |
                                    v = b or v != b
                                    [using tautology]
                                  @conclusion-u-is-a |
                                    compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                                    case v-is-b-or-not {
                                      @when-v-is-b |
                                        assume v = b {
                                          @v-is-b |
                                            v = b
                                            [by hypothesis when-v-is-b]
                                          @ab-cancels |
                                            compose(transposition(a, b), transposition(a, b)) = identityFn
                                            [using specialize transpositionsCancel(a, b)]
                                          @pair-at-u |
                                            compose(transposition(u, b), transposition(a, b)) = identityFn
                                            [by rewrite u-is-a ab-cancels]
                                          @pair-cancels |
                                            compose(transposition(u, v), transposition(a, b)) = identityFn
                                            [by rewrite v-is-b pair-at-u]
                                          @conclusion-cancel |
                                            compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                                            [by either_left pair-cancels]
                                        }
                                      @when-v-is-not-b |
                                        assume v != b {
                                          @v-not-b |
                                            v != b
                                            [by hypothesis when-v-is-not-b]
                                          @bv |
                                            b != v
                                            [using specialize distinctSymmetric(v, b) v-not-b]
                                          @rotates |
                                            compose(transposition(a, v), transposition(a, b)) = compose(transposition(a, b), transposition(b, v))
                                            [using specialize rotateTheSharedLetter(a, b, v) ab bv a-not-v]
                                          @rotates-at-u |
                                            compose(transposition(u, v), transposition(a, b)) = compose(transposition(a, b), transposition(b, v))
                                            [by rewrite u-is-a rotates]
                                          @pair-flipped |
                                            compose(transposition(a, b), transposition(b, v)) = compose(transposition(u, v), transposition(a, b))
                                            [by symmetry rotates-at-u]
                                          @right-fixes-a |
                                            apply(transposition(b, v), a) = a
                                            [using specialize transpositionElsewhere(b, v, a) ab a-not-v]
                                          @left-is-a-transposition |
                                            isTransposition(transposition(a, b))
                                            [using specialize swapIsATransposition(a, b) ab]
                                          @right-is-a-transposition |
                                            isTransposition(transposition(b, v))
                                            [using specialize swapIsATransposition(b, v) bv]
                                          @left-sends-a-to-its-partner |
                                            apply(transposition(a, b), a) = b
                                            [using specialize transpositionAtFirst(a, b)]
                                          @given-left-fixes-a |
                                            assume apply(transposition(a, b), a) = a {
                                              @left-fixes-a |
                                                apply(transposition(a, b), a) = a
                                                [by hypothesis given-left-fixes-a]
                                              @partner-is-a |
                                                b = a
                                                [using chain partner-flipped left-fixes-a]
                                              @partner-flipped |
                                                b = apply(transposition(a, b), a)
                                                [by symmetry left-sends-a-to-its-partner]
                                              @conclusion-a-is-partner |
                                                a = b
                                                [by symmetry partner-is-a]
                                            }
                                          @left-fixes-implies |
                                            apply(transposition(a, b), a) = a -> a = b
                                            [by discharge given-left-fixes-a]
                                          @left-moves-a |
                                            apply(transposition(a, b), a) != a
                                            [using tautology left-fixes-implies ab]
                                          @witnessed |
                                            isTransposition(transposition(a, b)) and isTransposition(transposition(b, v)) and compose(transposition(a, b), transposition(b, v)) = compose(transposition(u, v), transposition(a, b)) and apply(transposition(b, v), a) = a and apply(transposition(a, b), a) != a
                                            [using tautology left-is-a-transposition right-is-a-transposition pair-flipped right-fixes-a left-moves-a]
                                          @inner-exists |
                                            exists q: Fn; isTransposition(transposition(a, b)) and isTransposition(q) and compose(transposition(a, b), q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(transposition(a, b), a) != a
                                            [by witness(transposition(b, v)) witnessed]
                                          @outer-exists |
                                            exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                            [by witness(transposition(a, b)) inner-exists]
                                          @conclusion-shift |
                                            compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                                            [by either_right outer-exists]
                                        }
                                    }
                                }
                              @when-u-is-b |
                                assume u = b {
                                  @u-is-b |
                                    u = b
                                    [by hypothesis when-u-is-b]
                                  @b-not-v |
                                    b != v
                                    [by rewrite u-is-b uv]
                                  @v-is-a-or-not |
                                    v = a or v != a
                                    [using tautology]
                                  @conclusion-u-is-b |
                                    compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                                    case v-is-a-or-not {
                                      @when-v-is-a |
                                        assume v = a {
                                          @v-is-a |
                                            v = a
                                            [by hypothesis when-v-is-a]
                                          @ba-ab-cancels |
                                            compose(transposition(b, a), transposition(a, b)) = identityFn
                                            [using specialize transpositionPairCancelsReversed(a, b)]
                                          @pair-at-u |
                                            compose(transposition(u, a), transposition(a, b)) = identityFn
                                            [by rewrite u-is-b ba-ab-cancels]
                                          @pair-cancels |
                                            compose(transposition(u, v), transposition(a, b)) = identityFn
                                            [by rewrite v-is-a pair-at-u]
                                          @conclusion-cancel |
                                            compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                                            [by either_left pair-cancels]
                                        }
                                      @when-v-is-not-a |
                                        assume v != a {
                                          @v-not-a |
                                            v != a
                                            [by hypothesis when-v-is-not-a]
                                          @av |
                                            a != v
                                            [using specialize distinctSymmetric(v, a) v-not-a]
                                          @shifts |
                                            compose(transposition(b, v), transposition(a, b)) = compose(transposition(a, v), transposition(b, v))
                                            [using specialize shiftTheSharedLetter(a, b, v) ab b-not-v av]
                                          @shifts-at-u |
                                            compose(transposition(u, v), transposition(a, b)) = compose(transposition(a, v), transposition(b, v))
                                            [by rewrite u-is-b shifts]
                                          @pair-flipped |
                                            compose(transposition(a, v), transposition(b, v)) = compose(transposition(u, v), transposition(a, b))
                                            [by symmetry shifts-at-u]
                                          @right-fixes-a |
                                            apply(transposition(b, v), a) = a
                                            [using specialize transpositionElsewhere(b, v, a) ab av]
                                          @left-is-a-transposition |
                                            isTransposition(transposition(a, v))
                                            [using specialize swapIsATransposition(a, v) av]
                                          @right-is-a-transposition |
                                            isTransposition(transposition(b, v))
                                            [using specialize swapIsATransposition(b, v) b-not-v]
                                          @left-sends-a-to-its-partner |
                                            apply(transposition(a, v), a) = v
                                            [using specialize transpositionAtFirst(a, v)]
                                          @given-left-fixes-a |
                                            assume apply(transposition(a, v), a) = a {
                                              @left-fixes-a |
                                                apply(transposition(a, v), a) = a
                                                [by hypothesis given-left-fixes-a]
                                              @partner-is-a |
                                                v = a
                                                [using chain partner-flipped left-fixes-a]
                                              @partner-flipped |
                                                v = apply(transposition(a, v), a)
                                                [by symmetry left-sends-a-to-its-partner]
                                              @conclusion-a-is-partner |
                                                a = v
                                                [by symmetry partner-is-a]
                                            }
                                          @left-fixes-implies |
                                            apply(transposition(a, v), a) = a -> a = v
                                            [by discharge given-left-fixes-a]
                                          @left-moves-a |
                                            apply(transposition(a, v), a) != a
                                            [using tautology left-fixes-implies av]
                                          @witnessed |
                                            isTransposition(transposition(a, v)) and isTransposition(transposition(b, v)) and compose(transposition(a, v), transposition(b, v)) = compose(transposition(u, v), transposition(a, b)) and apply(transposition(b, v), a) = a and apply(transposition(a, v), a) != a
                                            [using tautology left-is-a-transposition right-is-a-transposition pair-flipped right-fixes-a left-moves-a]
                                          @inner-exists |
                                            exists q: Fn; isTransposition(transposition(a, v)) and isTransposition(q) and compose(transposition(a, v), q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(transposition(a, v), a) != a
                                            [by witness(transposition(b, v)) witnessed]
                                          @outer-exists |
                                            exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                            [by witness(transposition(a, v)) inner-exists]
                                          @conclusion-shift |
                                            compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                                            [by either_right outer-exists]
                                        }
                                    }
                                }
                              @when-u-is-neither |
                                assume u != a and u != b {
                                  @u-neither |
                                    u != a and u != b
                                    [by hypothesis when-u-is-neither]
                                  @u-not-a |
                                    u != a
                                    [using tautology u-neither]
                                  @u-not-b |
                                    u != b
                                    [using tautology u-neither]
                                  @au |
                                    a != u
                                    [using specialize distinctSymmetric(u, a) u-not-a]
                                  @bu |
                                    b != u
                                    [using specialize distinctSymmetric(u, b) u-not-b]
                                  @v-cases |
                                    v = a or v = b or (v != a and v != b)
                                    [using tautology]
                                  @conclusion-u-neither |
                                    compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                                    case v-cases {
                                      @when-v-is-a |
                                        assume v = a {
                                          @v-is-a |
                                            v = a
                                            [by hypothesis when-v-is-a]
                                          @swap-symmetric |
                                            transposition(u, a) = transposition(a, u)
                                            [using specialize transpositionIsSymmetric(u, a)]
                                          @rotates |
                                            compose(transposition(a, u), transposition(a, b)) = compose(transposition(a, b), transposition(b, u))
                                            [using specialize rotateTheSharedLetter(a, b, u) ab bu au]
                                          @pair-as-au |
                                            compose(transposition(u, a), transposition(a, b)) = compose(transposition(a, b), transposition(b, u))
                                            [by rewrite swap-symmetric rotates]
                                          @pair-at-v |
                                            compose(transposition(u, v), transposition(a, b)) = compose(transposition(a, b), transposition(b, u))
                                            [by rewrite v-is-a pair-as-au]
                                          @pair-flipped |
                                            compose(transposition(a, b), transposition(b, u)) = compose(transposition(u, v), transposition(a, b))
                                            [by symmetry pair-at-v]
                                          @right-fixes-a |
                                            apply(transposition(b, u), a) = a
                                            [using specialize transpositionElsewhere(b, u, a) ab au]
                                          @left-is-a-transposition |
                                            isTransposition(transposition(a, b))
                                            [using specialize swapIsATransposition(a, b) ab]
                                          @right-is-a-transposition |
                                            isTransposition(transposition(b, u))
                                            [using specialize swapIsATransposition(b, u) bu]
                                          @left-sends-a-to-its-partner |
                                            apply(transposition(a, b), a) = b
                                            [using specialize transpositionAtFirst(a, b)]
                                          @given-left-fixes-a |
                                            assume apply(transposition(a, b), a) = a {
                                              @left-fixes-a |
                                                apply(transposition(a, b), a) = a
                                                [by hypothesis given-left-fixes-a]
                                              @partner-is-a |
                                                b = a
                                                [using chain partner-flipped left-fixes-a]
                                              @partner-flipped |
                                                b = apply(transposition(a, b), a)
                                                [by symmetry left-sends-a-to-its-partner]
                                              @conclusion-a-is-partner |
                                                a = b
                                                [by symmetry partner-is-a]
                                            }
                                          @left-fixes-implies |
                                            apply(transposition(a, b), a) = a -> a = b
                                            [by discharge given-left-fixes-a]
                                          @left-moves-a |
                                            apply(transposition(a, b), a) != a
                                            [using tautology left-fixes-implies ab]
                                          @witnessed |
                                            isTransposition(transposition(a, b)) and isTransposition(transposition(b, u)) and compose(transposition(a, b), transposition(b, u)) = compose(transposition(u, v), transposition(a, b)) and apply(transposition(b, u), a) = a and apply(transposition(a, b), a) != a
                                            [using tautology left-is-a-transposition right-is-a-transposition pair-flipped right-fixes-a left-moves-a]
                                          @inner-exists |
                                            exists q: Fn; isTransposition(transposition(a, b)) and isTransposition(q) and compose(transposition(a, b), q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(transposition(a, b), a) != a
                                            [by witness(transposition(b, u)) witnessed]
                                          @outer-exists |
                                            exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                            [by witness(transposition(a, b)) inner-exists]
                                          @conclusion-shift |
                                            compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                                            [by either_right outer-exists]
                                        }
                                      @when-v-is-b |
                                        assume v = b {
                                          @v-is-b |
                                            v = b
                                            [by hypothesis when-v-is-b]
                                          @swap-symmetric |
                                            transposition(u, b) = transposition(b, u)
                                            [using specialize transpositionIsSymmetric(u, b)]
                                          @shifts |
                                            compose(transposition(b, u), transposition(a, b)) = compose(transposition(a, u), transposition(b, u))
                                            [using specialize shiftTheSharedLetter(a, b, u) ab bu au]
                                          @pair-as-bu |
                                            compose(transposition(u, b), transposition(a, b)) = compose(transposition(a, u), transposition(b, u))
                                            [by rewrite swap-symmetric shifts]
                                          @pair-at-v |
                                            compose(transposition(u, v), transposition(a, b)) = compose(transposition(a, u), transposition(b, u))
                                            [by rewrite v-is-b pair-as-bu]
                                          @pair-flipped |
                                            compose(transposition(a, u), transposition(b, u)) = compose(transposition(u, v), transposition(a, b))
                                            [by symmetry pair-at-v]
                                          @right-fixes-a |
                                            apply(transposition(b, u), a) = a
                                            [using specialize transpositionElsewhere(b, u, a) ab au]
                                          @left-is-a-transposition |
                                            isTransposition(transposition(a, u))
                                            [using specialize swapIsATransposition(a, u) au]
                                          @right-is-a-transposition |
                                            isTransposition(transposition(b, u))
                                            [using specialize swapIsATransposition(b, u) bu]
                                          @left-sends-a-to-its-partner |
                                            apply(transposition(a, u), a) = u
                                            [using specialize transpositionAtFirst(a, u)]
                                          @given-left-fixes-a |
                                            assume apply(transposition(a, u), a) = a {
                                              @left-fixes-a |
                                                apply(transposition(a, u), a) = a
                                                [by hypothesis given-left-fixes-a]
                                              @partner-is-a |
                                                u = a
                                                [using chain partner-flipped left-fixes-a]
                                              @partner-flipped |
                                                u = apply(transposition(a, u), a)
                                                [by symmetry left-sends-a-to-its-partner]
                                              @conclusion-a-is-partner |
                                                a = u
                                                [by symmetry partner-is-a]
                                            }
                                          @left-fixes-implies |
                                            apply(transposition(a, u), a) = a -> a = u
                                            [by discharge given-left-fixes-a]
                                          @left-moves-a |
                                            apply(transposition(a, u), a) != a
                                            [using tautology left-fixes-implies au]
                                          @witnessed |
                                            isTransposition(transposition(a, u)) and isTransposition(transposition(b, u)) and compose(transposition(a, u), transposition(b, u)) = compose(transposition(u, v), transposition(a, b)) and apply(transposition(b, u), a) = a and apply(transposition(a, u), a) != a
                                            [using tautology left-is-a-transposition right-is-a-transposition pair-flipped right-fixes-a left-moves-a]
                                          @inner-exists |
                                            exists q: Fn; isTransposition(transposition(a, u)) and isTransposition(q) and compose(transposition(a, u), q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(transposition(a, u), a) != a
                                            [by witness(transposition(b, u)) witnessed]
                                          @outer-exists |
                                            exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                            [by witness(transposition(a, u)) inner-exists]
                                          @conclusion-shift |
                                            compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                                            [by either_right outer-exists]
                                        }
                                      @when-v-is-neither |
                                        assume v != a and v != b {
                                          @v-neither |
                                            v != a and v != b
                                            [by hypothesis when-v-is-neither]
                                          @v-not-a |
                                            v != a
                                            [using tautology v-neither]
                                          @v-not-b |
                                            v != b
                                            [using tautology v-neither]
                                          @av |
                                            a != v
                                            [using specialize distinctSymmetric(v, a) v-not-a]
                                          @bv |
                                            b != v
                                            [using specialize distinctSymmetric(v, b) v-not-b]
                                          @commutes |
                                            compose(transposition(u, v), transposition(a, b)) = compose(transposition(a, b), transposition(u, v))
                                            [using specialize disjointTranspositionsCommute(a, b, u, v) ab uv au av bu bv]
                                          @pair-flipped |
                                            compose(transposition(a, b), transposition(u, v)) = compose(transposition(u, v), transposition(a, b))
                                            [by symmetry commutes]
                                          @right-fixes-a |
                                            apply(transposition(u, v), a) = a
                                            [using specialize transpositionElsewhere(u, v, a) au av]
                                          @left-is-a-transposition |
                                            isTransposition(transposition(a, b))
                                            [using specialize swapIsATransposition(a, b) ab]
                                          @right-is-a-transposition |
                                            isTransposition(transposition(u, v))
                                            [using specialize swapIsATransposition(u, v) uv]
                                          @left-sends-a-to-its-partner |
                                            apply(transposition(a, b), a) = b
                                            [using specialize transpositionAtFirst(a, b)]
                                          @given-left-fixes-a |
                                            assume apply(transposition(a, b), a) = a {
                                              @left-fixes-a |
                                                apply(transposition(a, b), a) = a
                                                [by hypothesis given-left-fixes-a]
                                              @partner-is-a |
                                                b = a
                                                [using chain partner-flipped left-fixes-a]
                                              @partner-flipped |
                                                b = apply(transposition(a, b), a)
                                                [by symmetry left-sends-a-to-its-partner]
                                              @conclusion-a-is-partner |
                                                a = b
                                                [by symmetry partner-is-a]
                                            }
                                          @left-fixes-implies |
                                            apply(transposition(a, b), a) = a -> a = b
                                            [by discharge given-left-fixes-a]
                                          @left-moves-a |
                                            apply(transposition(a, b), a) != a
                                            [using tautology left-fixes-implies ab]
                                          @witnessed |
                                            isTransposition(transposition(a, b)) and isTransposition(transposition(u, v)) and compose(transposition(a, b), transposition(u, v)) = compose(transposition(u, v), transposition(a, b)) and apply(transposition(u, v), a) = a and apply(transposition(a, b), a) != a
                                            [using tautology left-is-a-transposition right-is-a-transposition pair-flipped right-fixes-a left-moves-a]
                                          @inner-exists |
                                            exists q: Fn; isTransposition(transposition(a, b)) and isTransposition(q) and compose(transposition(a, b), q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(transposition(a, b), a) != a
                                            [by witness(transposition(u, v)) witnessed]
                                          @outer-exists |
                                            exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                            [by witness(transposition(a, b)) inner-exists]
                                          @conclusion-shift |
                                            compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a)
                                            [by either_right outer-exists]
                                        }
                                    }
                                }
                            }
                        }
                      @uv-implies |
                        u != v -> (compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a))
                        [by discharge given-uv]
                    }
                  @ab-implies |
                    a != b -> u != v -> (compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a))
                    [by discharge given-ab]
                }
              @discharge-v |
                forall v: Element; a != b -> u != v -> (compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a))
                [by generalize generalize-v]
            }
          @discharge-u |
            forall u, v: Element; a != b -> u != v -> (compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a))
            [by generalize generalize-u]
        }
      @discharge-b |
        forall b, u, v: Element; a != b -> u != v -> (compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, u, v: Element; a != b -> u != v -> (compose(transposition(u, v), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(u, v), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a))
    [by generalize generalize-a]
qed

// ZERO is below every successor — ordinary induction: ZERO < succ(ZERO) is lessThanSelf at
// ZERO, and ZERO < succ(k) gives ZERO < succ(succ(k)) by lessThanSuccRight.
theorem zeroIsBelowEverySuccessor: forall n: Nat; less_than(ZERO, succ(n))
proof
  @base-case |
    less_than(ZERO, succ(ZERO))
    [using specialize natLessThanSelf(ZERO)]
  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume less_than(ZERO, succ(k)) {
          @inductive-hypothesis |
            less_than(ZERO, succ(k))
            [by hypothesis given-inductive-hypothesis]
          @conclusion-next |
            less_than(ZERO, succ(succ(k)))
            [using specialize peano_order.lessThanSuccRight(ZERO, succ(k)) inductive-hypothesis]
        }
      @induction-step-at-k |
        less_than(ZERO, succ(k)) -> less_than(ZERO, succ(succ(k)))
        [by discharge given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; less_than(ZERO, succ(k)) -> less_than(ZERO, succ(succ(k)))
    [by generalize induction-step]
  @conclusion |
    forall n: Nat; less_than(ZERO, succ(n))
    [using instantiation natInduction((fun n: Nat => less_than(ZERO, succ(n)))) base-case induction-step-for-all-k]
qed

// A natural is ZERO or POSITIVE — `zeroOrSucc` phrased for the order, which is the form the
// induction below splits on.
theorem zeroOrPositive: forall n: Nat; n = ZERO or less_than(ZERO, n)
proof
  @generalize-n |
    fix n: Nat {
      @cases |
        n = ZERO or (exists m: Nat; n = succ(m))
        [using specialize peano.zeroOrSucc(n)]
      @conclusion-split |
        n = ZERO or less_than(ZERO, n)
        case cases {
          @when-zero |
            assume n = ZERO {
              @is-zero |
                n = ZERO
                [by hypothesis when-zero]
              @conclusion-zero |
                n = ZERO or less_than(ZERO, n)
                [by either_left is-zero]
            }
          @when-successor |
            assume exists m: Nat; n = succ(m) {
              @is-a-successor |
                exists m: Nat; n = succ(m)
                [by hypothesis when-successor]
              @with-predecessor |
                unpack m: Nat from is-a-successor {
                  @is-succ-m |
                    n = succ(m)
                    [by hypothesis with-predecessor]
                  // ZERO < succ(m): ZERO < succ(ZERO) by lessThanSelf, and m = ZERO or
                  // ZERO < m gives ZERO < succ(m) either way — but the direct route is
                  // simpler: zeroIsBelowEverySuccessor, proved just above.
                  @zero-below-succ |
                    less_than(ZERO, succ(m))
                    [using specialize zeroIsBelowEverySuccessor(m)]
                  @zero-below-n |
                    less_than(ZERO, n)
                    [by rewrite is-succ-m zero-below-succ]
                  @conclusion-positive-inner |
                    n = ZERO or less_than(ZERO, n)
                    [by either_right zero-below-n]
                }
              @conclusion-positive |
                n = ZERO or less_than(ZERO, n)
                [by unpacked with-predecessor]
            }
        }
    }
  @conclusion |
    forall n: Nat; n = ZERO or less_than(ZERO, n)
    [by generalize generalize-n]
qed

// -- STEP 3: the product cannot leave `a` in only the first factor ----------------------------
// Judson's "the latter case cannot occur". If every factor above index 0 fixes `a`, the whole
// product sends `a` wherever entry 0 does — so if the product is the identity, entry 0 fixes
// `a` too. Proved as the positive statement: a product whose factors above 0 all fix `a` acts
// on `a` exactly as its first factor does.
theorem productActsAsItsFirstFactor: forall s: Seq; forall a: Element; forall n: Nat;
  (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) ->
  less_than(ZERO, n) ->
  apply(productUpTo(s, n), a) = apply(at(s, ZERO), a)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-a |
        fix a: Element {
          // induction on n, carrying the whole statement (the hypothesis mentions n).
          @base-case |
            (forall i: Nat; less_than(ZERO, i) -> less_than(i, ZERO) -> apply(at(s, i), a) = a) -> less_than(ZERO, ZERO) -> apply(productUpTo(s, ZERO), a) = apply(at(s, ZERO), a)
            [using tautology zero-not-below-zero]
          @zero-not-below-zero |
            not less_than(ZERO, ZERO)
            [using specialize peano_order.lessThanIrreflexive(ZERO)]
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume (forall i: Nat; less_than(ZERO, i) -> less_than(i, k) -> apply(at(s, i), a) = a) -> less_than(ZERO, k) -> apply(productUpTo(s, k), a) = apply(at(s, ZERO), a) {
                  @inductive-hypothesis |
                    (forall i: Nat; less_than(ZERO, i) -> less_than(i, k) -> apply(at(s, i), a) = a) -> less_than(ZERO, k) -> apply(productUpTo(s, k), a) = apply(at(s, ZERO), a)
                    [by hypothesis given-inductive-hypothesis]
                  @given-fixed-above |
                    assume forall i: Nat; less_than(ZERO, i) -> less_than(i, succ(k)) -> apply(at(s, i), a) = a {
                      @fixed-above |
                        forall i: Nat; less_than(ZERO, i) -> less_than(i, succ(k)) -> apply(at(s, i), a) = a
                        [by hypothesis given-fixed-above]
                      @given-positive |
                        assume less_than(ZERO, succ(k)) {
                          // the product up to k+1 is (product up to k) ∘ entry k.
                          @unfolds |
                            productUpTo(s, succ(k)) = compose(productUpTo(s, k), at(s, k))
                            [using specialize productUpToSucc(s, k)]
                          @applies |
                            apply(compose(productUpTo(s, k), at(s, k)), a) = apply(productUpTo(s, k), apply(at(s, k), a))
                            [using specialize composeApply(productUpTo(s, k), at(s, k), a)]
                          @product-at-a |
                            apply(productUpTo(s, succ(k)), a) = apply(productUpTo(s, k), apply(at(s, k), a))
                            [by rewrite unfolds applies]
                          // k is either 0 (so the product IS entry 0 composed with the empty
                          // product) or positive (so entry k fixes a, and the hypothesis applies).
                          @k-is-zero-or-positive |
                            k = ZERO or less_than(ZERO, k)
                            [using specialize zeroOrPositive(k)]
                          @conclusion-acts-as-first |
                            apply(productUpTo(s, succ(k)), a) = apply(at(s, ZERO), a)
                            case k-is-zero-or-positive {
                              @when-k-is-zero |
                                assume k = ZERO {
                                  @k-is-zero |
                                    k = ZERO
                                    [by hypothesis when-k-is-zero]
                                  @empty-product |
                                    productUpTo(s, ZERO) = identityFn
                                    [using specialize productUpToZero(s)]
                                  @product-at-zero |
                                    apply(productUpTo(s, succ(k)), a) = apply(productUpTo(s, ZERO), apply(at(s, ZERO), a))
                                    [by rewrite k-is-zero product-at-a]
                                  @with-identity |
                                    apply(productUpTo(s, succ(k)), a) = apply(identityFn, apply(at(s, ZERO), a))
                                    [by rewrite empty-product product-at-zero]
                                  @identity-applies |
                                    apply(identityFn, apply(at(s, ZERO), a)) = apply(at(s, ZERO), a)
                                    [using specialize identityApply(apply(at(s, ZERO), a))]
                                  @conclusion-when-zero |
                                    apply(productUpTo(s, succ(k)), a) = apply(at(s, ZERO), a)
                                    [using chain with-identity identity-applies]
                                }
                              @when-k-is-positive |
                                assume less_than(ZERO, k) {
                                  @k-positive |
                                    less_than(ZERO, k)
                                    [by hypothesis when-k-is-positive]
                                  @k-below-succ |
                                    less_than(k, succ(k))
                                    [using specialize natLessThanSelf(k)]
                                  @entry-k-fixes-a |
                                    apply(at(s, k), a) = a
                                    [using specialize fixed-above(k) k-positive k-below-succ]
                                  @product-collapses |
                                    apply(productUpTo(s, succ(k)), a) = apply(productUpTo(s, k), a)
                                    [by rewrite entry-k-fixes-a product-at-a]
                                  // the hypothesis needs "fixes above 0, below k", weaker than
                                  // what we have (below k+1).
                                  @fixed-below-k |
                                    forall i: Nat; less_than(ZERO, i) -> less_than(i, k) -> apply(at(s, i), a) = a
                                    [by generalize weaken-bound]
                                  @weaken-bound |
                                    fix i: Nat {
                                      @given-i-positive |
                                        assume less_than(ZERO, i) {
                                          @given-i-below-k |
                                            assume less_than(i, k) {
                                              @i-positive |
                                                less_than(ZERO, i)
                                                [by hypothesis given-i-positive]
                                              @i-below-k |
                                                less_than(i, k)
                                                [by hypothesis given-i-below-k]
                                              @i-below-succ-k |
                                                less_than(i, succ(k))
                                                [using specialize peano_order.lessThanSuccRight(i, k) i-below-k]
                                              @conclusion-i-fixes |
                                                apply(at(s, i), a) = a
                                                [using specialize fixed-above(i) i-positive i-below-succ-k]
                                            }
                                          @below-k-implies |
                                            less_than(i, k) -> apply(at(s, i), a) = a
                                            [by discharge given-i-below-k]
                                        }
                                      @positive-implies |
                                        less_than(ZERO, i) -> less_than(i, k) -> apply(at(s, i), a) = a
                                        [by discharge given-i-positive]
                                    }
                                  @product-up-to-k |
                                    apply(productUpTo(s, k), a) = apply(at(s, ZERO), a)
                                    [using tautology inductive-hypothesis fixed-below-k k-positive]
                                  @conclusion-when-positive |
                                    apply(productUpTo(s, succ(k)), a) = apply(at(s, ZERO), a)
                                    [using chain product-collapses product-up-to-k]
                                }
                            }
                        }
                      @positive-implies |
                        less_than(ZERO, succ(k)) -> apply(productUpTo(s, succ(k)), a) = apply(at(s, ZERO), a)
                        [by discharge given-positive]
                    }
                  @fixed-implies |
                    (forall i: Nat; less_than(ZERO, i) -> less_than(i, succ(k)) -> apply(at(s, i), a) = a) -> less_than(ZERO, succ(k)) -> apply(productUpTo(s, succ(k)), a) = apply(at(s, ZERO), a)
                    [by discharge given-fixed-above]
                }
              @induction-step-at-k |
                ((forall i: Nat; less_than(ZERO, i) -> less_than(i, k) -> apply(at(s, i), a) = a) -> less_than(ZERO, k) -> apply(productUpTo(s, k), a) = apply(at(s, ZERO), a)) -> ((forall i: Nat; less_than(ZERO, i) -> less_than(i, succ(k)) -> apply(at(s, i), a) = a) -> less_than(ZERO, succ(k)) -> apply(productUpTo(s, succ(k)), a) = apply(at(s, ZERO), a))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat; ((forall i: Nat; less_than(ZERO, i) -> less_than(i, k) -> apply(at(s, i), a) = a) -> less_than(ZERO, k) -> apply(productUpTo(s, k), a) = apply(at(s, ZERO), a)) -> ((forall i: Nat; less_than(ZERO, i) -> less_than(i, succ(k)) -> apply(at(s, i), a) = a) -> less_than(ZERO, succ(k)) -> apply(productUpTo(s, succ(k)), a) = apply(at(s, ZERO), a))
            [by generalize induction-step]
          @conclusion-for-all-n |
            forall n: Nat; (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) -> less_than(ZERO, n) -> apply(productUpTo(s, n), a) = apply(at(s, ZERO), a)
            [using instantiation natInduction((fun n: Nat => (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) -> less_than(ZERO, n) -> apply(productUpTo(s, n), a) = apply(at(s, ZERO), a))) base-case induction-step-for-all-k]
        }
      @discharge-a |
        forall a: Element; forall n: Nat; (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) -> less_than(ZERO, n) -> apply(productUpTo(s, n), a) = apply(at(s, ZERO), a)
        [by generalize generalize-a]
    }
  @conclusion |
    forall s: Seq; forall a: Element; forall n: Nat; (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) -> less_than(ZERO, n) -> apply(productUpTo(s, n), a) = apply(at(s, ZERO), a)
    [by generalize generalize-s]
qed

// The contradiction Judson draws from it: if the product is the IDENTITY and every factor above
// index 0 fixes `a`, then entry 0 fixes `a` too. So a letter moved by entry 0 must be moved by
// some later entry as well — which is what forbids the inner loop from running off the end.
theorem identityProductForcesFirstFactorToFix: forall s: Seq; forall a: Element; forall n: Nat;
  productUpTo(s, n) = identityFn ->
  (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) ->
  less_than(ZERO, n) ->
  apply(at(s, ZERO), a) = a
proof
  @generalize-s |
    fix s: Seq {
      @generalize-a |
        fix a: Element {
          @generalize-n |
            fix n: Nat {
              @given-identity |
                assume productUpTo(s, n) = identityFn {
                  @given-fixed-above |
                    assume forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a {
                      @given-positive |
                        assume less_than(ZERO, n) {
                          @is-identity |
                            productUpTo(s, n) = identityFn
                            [by hypothesis given-identity]
                          @fixed-above |
                            forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a
                            [by hypothesis given-fixed-above]
                          @positive |
                            less_than(ZERO, n)
                            [by hypothesis given-positive]
                          @acts-as-first |
                            apply(productUpTo(s, n), a) = apply(at(s, ZERO), a)
                            [using specialize productActsAsItsFirstFactor(s, a, n) fixed-above positive]
                          @identity-at-a |
                            apply(identityFn, a) = a
                            [using specialize identityApply(a)]
                          @product-at-a-is-a |
                            apply(productUpTo(s, n), a) = a
                            [by rewrite is-identity identity-at-a]
                          @a-is-first-image |
                            a = apply(at(s, ZERO), a)
                            [using chain product-at-a-is-a-flipped acts-as-first]
                          @product-at-a-is-a-flipped |
                            a = apply(productUpTo(s, n), a)
                            [by symmetry product-at-a-is-a]
                          @conclusion-first-fixes |
                            apply(at(s, ZERO), a) = a
                            [by symmetry a-is-first-image]
                        }
                      @positive-implies |
                        less_than(ZERO, n) -> apply(at(s, ZERO), a) = a
                        [by discharge given-positive]
                    }
                  @fixed-implies |
                    (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) -> less_than(ZERO, n) -> apply(at(s, ZERO), a) = a
                    [by discharge given-fixed-above]
                }
              @identity-implies |
                productUpTo(s, n) = identityFn -> (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) -> less_than(ZERO, n) -> apply(at(s, ZERO), a) = a
                [by discharge given-identity]
            }
          @discharge-n |
            forall n: Nat; productUpTo(s, n) = identityFn -> (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) -> less_than(ZERO, n) -> apply(at(s, ZERO), a) = a
            [by generalize generalize-n]
        }
      @discharge-a |
        forall a: Element; forall n: Nat; productUpTo(s, n) = identityFn -> (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) -> less_than(ZERO, n) -> apply(at(s, ZERO), a) = a
        [by generalize generalize-a]
    }
  @conclusion |
    forall s: Seq; forall a: Element; forall n: Nat; productUpTo(s, n) = identityFn -> (forall i: Nat; less_than(ZERO, i) -> less_than(i, n) -> apply(at(s, i), a) = a) -> less_than(ZERO, n) -> apply(at(s, ZERO), a) = a
    [by generalize generalize-s]
qed

// -- carrying a product equality past the replaced pair ---------------------------------------
// Two bridges the inner induction needs. First: sequences agreeing below k have equal products
// up to k (ordinary induction on k).
theorem agreeingPrefixesHaveEqualProducts: forall s: Seq; forall u: Seq; forall k: Nat;
  (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) ->
  productUpTo(u, k) = productUpTo(s, k)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-u |
        fix u: Seq {
          @base-case |
            (forall i: Nat; less_than(i, ZERO) -> at(u, i) = at(s, i)) -> productUpTo(u, ZERO) = productUpTo(s, ZERO)
            [using tautology empty-products-agree]
          @empty-products-agree |
            productUpTo(u, ZERO) = productUpTo(s, ZERO)
            [using chain u-empty s-empty-flipped]
          @u-empty |
            productUpTo(u, ZERO) = identityFn
            [using specialize productUpToZero(u)]
          @s-empty-flipped |
            identityFn = productUpTo(s, ZERO)
            [by symmetry s-empty]
          @s-empty |
            productUpTo(s, ZERO) = identityFn
            [using specialize productUpToZero(s)]
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> productUpTo(u, k) = productUpTo(s, k) {
                  @inductive-hypothesis |
                    (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> productUpTo(u, k) = productUpTo(s, k)
                    [by hypothesis given-inductive-hypothesis]
                  @given-agree-below-succ |
                    assume forall i: Nat; less_than(i, succ(k)) -> at(u, i) = at(s, i) {
                      @agree-below-succ |
                        forall i: Nat; less_than(i, succ(k)) -> at(u, i) = at(s, i)
                        [by hypothesis given-agree-below-succ]
                      @agree-below-k |
                        forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)
                        [by generalize weaken]
                      @weaken |
                        fix i: Nat {
                          @given-below-k |
                            assume less_than(i, k) {
                              @below-k |
                                less_than(i, k)
                                [by hypothesis given-below-k]
                              @below-succ-k |
                                less_than(i, succ(k))
                                [using specialize peano_order.lessThanSuccRight(i, k) below-k]
                              @conclusion-agree-at-i |
                                at(u, i) = at(s, i)
                                [using specialize agree-below-succ(i) below-succ-k]
                            }
                          @below-k-implies |
                            less_than(i, k) -> at(u, i) = at(s, i)
                            [by discharge given-below-k]
                        }
                      @prefixes-agree |
                        productUpTo(u, k) = productUpTo(s, k)
                        [using tautology inductive-hypothesis agree-below-k]
                      @k-below-succ-k |
                        less_than(k, succ(k))
                        [using specialize natLessThanSelf(k)]
                      @entries-agree-at-k |
                        at(u, k) = at(s, k)
                        [using specialize agree-below-succ(k) k-below-succ-k]
                      @u-unfolds |
                        productUpTo(u, succ(k)) = compose(productUpTo(u, k), at(u, k))
                        [using specialize productUpToSucc(u, k)]
                      @s-unfolds |
                        productUpTo(s, succ(k)) = compose(productUpTo(s, k), at(s, k))
                        [using specialize productUpToSucc(s, k)]
                      @u-with-s-prefix |
                        productUpTo(u, succ(k)) = compose(productUpTo(s, k), at(u, k))
                        [by rewrite prefixes-agree u-unfolds]
                      @u-with-s-entry |
                        productUpTo(u, succ(k)) = compose(productUpTo(s, k), at(s, k))
                        [by rewrite entries-agree-at-k u-with-s-prefix]
                      @s-flipped |
                        compose(productUpTo(s, k), at(s, k)) = productUpTo(s, succ(k))
                        [by symmetry s-unfolds]
                      @conclusion-products-agree |
                        productUpTo(u, succ(k)) = productUpTo(s, succ(k))
                        [using chain u-with-s-entry s-flipped]
                    }
                  @agree-implies |
                    (forall i: Nat; less_than(i, succ(k)) -> at(u, i) = at(s, i)) -> productUpTo(u, succ(k)) = productUpTo(s, succ(k))
                    [by discharge given-agree-below-succ]
                }
              @induction-step-at-k |
                ((forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> productUpTo(u, k) = productUpTo(s, k)) -> ((forall i: Nat; less_than(i, succ(k)) -> at(u, i) = at(s, i)) -> productUpTo(u, succ(k)) = productUpTo(s, succ(k)))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat; ((forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> productUpTo(u, k) = productUpTo(s, k)) -> ((forall i: Nat; less_than(i, succ(k)) -> at(u, i) = at(s, i)) -> productUpTo(u, succ(k)) = productUpTo(s, succ(k)))
            [by generalize induction-step]
          @conclusion-for-all-k |
            forall k: Nat; (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> productUpTo(u, k) = productUpTo(s, k)
            [using instantiation natInduction((fun k: Nat => (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> productUpTo(u, k) = productUpTo(s, k))) base-case induction-step-for-all-k]
        }
      @discharge-u |
        forall u: Seq; forall k: Nat; (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> productUpTo(u, k) = productUpTo(s, k)
        [by generalize generalize-u]
    }
  @conclusion |
    forall s: Seq; forall u: Seq; forall k: Nat; (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> productUpTo(u, k) = productUpTo(s, k)
    [by generalize generalize-s]
qed

// Second bridge: equal products at length b, with all entries from b upward identical, keeps
// them equal at every length b + d (ordinary induction on the overshoot d).
theorem equalProductsExtendUpward: forall s: Seq; forall u: Seq; forall b: Nat;
  productUpTo(u, b) = productUpTo(s, b) ->
  (forall i: Nat; at(u, add(b, i)) = at(s, add(b, i))) ->
  forall d: Nat; productUpTo(u, add(b, d)) = productUpTo(s, add(b, d))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-u |
        fix u: Seq {
          @generalize-b |
            fix b: Nat {
              @given-equal-at-b |
                assume productUpTo(u, b) = productUpTo(s, b) {
                  @given-tails-agree |
                    assume forall i: Nat; at(u, add(b, i)) = at(s, add(b, i)) {
                      @equal-at-b |
                        productUpTo(u, b) = productUpTo(s, b)
                        [by hypothesis given-equal-at-b]
                      @tails-agree |
                        forall i: Nat; at(u, add(b, i)) = at(s, add(b, i))
                        [by hypothesis given-tails-agree]
                      @base-case |
                        productUpTo(u, add(b, ZERO)) = productUpTo(s, add(b, ZERO))
                        [by rewrite b-plus-zero equal-at-b]
                      @b-plus-zero |
                        add(b, ZERO) = b
                        [using specialize peano.addZeroRight(b)]
                      @induction-step |
                        fix d: Nat {
                          @given-inductive-hypothesis |
                            assume productUpTo(u, add(b, d)) = productUpTo(s, add(b, d)) {
                              @inductive-hypothesis |
                                productUpTo(u, add(b, d)) = productUpTo(s, add(b, d))
                                [by hypothesis given-inductive-hypothesis]
                              @b-plus-succ |
                                add(b, succ(d)) = succ(add(b, d))
                                [using specialize peano.addSuccRight(b, d)]
                              @u-unfolds |
                                productUpTo(u, succ(add(b, d))) = compose(productUpTo(u, add(b, d)), at(u, add(b, d)))
                                [using specialize productUpToSucc(u, add(b, d))]
                              @s-unfolds |
                                productUpTo(s, succ(add(b, d))) = compose(productUpTo(s, add(b, d)), at(s, add(b, d)))
                                [using specialize productUpToSucc(s, add(b, d))]
                              @entries-agree |
                                at(u, add(b, d)) = at(s, add(b, d))
                                [using specialize tails-agree(d)]
                              @u-with-s-prefix |
                                productUpTo(u, succ(add(b, d))) = compose(productUpTo(s, add(b, d)), at(u, add(b, d)))
                                [by rewrite inductive-hypothesis u-unfolds]
                              @u-with-s-entry |
                                productUpTo(u, succ(add(b, d))) = compose(productUpTo(s, add(b, d)), at(s, add(b, d)))
                                [by rewrite entries-agree u-with-s-prefix]
                              @s-flipped |
                                compose(productUpTo(s, add(b, d)), at(s, add(b, d))) = productUpTo(s, succ(add(b, d)))
                                [by symmetry s-unfolds]
                              @equal-at-succ |
                                productUpTo(u, succ(add(b, d))) = productUpTo(s, succ(add(b, d)))
                                [using chain u-with-s-entry s-flipped]
                              @conclusion-next |
                                productUpTo(u, add(b, succ(d))) = productUpTo(s, add(b, succ(d)))
                                [by rewrite b-plus-succ equal-at-succ]
                            }
                          @induction-step-at-d |
                            productUpTo(u, add(b, d)) = productUpTo(s, add(b, d)) -> productUpTo(u, add(b, succ(d))) = productUpTo(s, add(b, succ(d)))
                            [by discharge given-inductive-hypothesis]
                        }
                      @induction-step-for-all-d |
                        forall d: Nat; productUpTo(u, add(b, d)) = productUpTo(s, add(b, d)) -> productUpTo(u, add(b, succ(d))) = productUpTo(s, add(b, succ(d)))
                        [by generalize induction-step]
                      @conclusion-for-all-d |
                        forall d: Nat; productUpTo(u, add(b, d)) = productUpTo(s, add(b, d))
                        [using instantiation natInduction((fun d: Nat => productUpTo(u, add(b, d)) = productUpTo(s, add(b, d)))) base-case induction-step-for-all-d]
                    }
                  @tails-implies |
                    (forall i: Nat; at(u, add(b, i)) = at(s, add(b, i))) -> forall d: Nat; productUpTo(u, add(b, d)) = productUpTo(s, add(b, d))
                    [by discharge given-tails-agree]
                }
              @equal-implies |
                productUpTo(u, b) = productUpTo(s, b) -> (forall i: Nat; at(u, add(b, i)) = at(s, add(b, i))) -> forall d: Nat; productUpTo(u, add(b, d)) = productUpTo(s, add(b, d))
                [by discharge given-equal-at-b]
            }
          @discharge-b |
            forall b: Nat; productUpTo(u, b) = productUpTo(s, b) -> (forall i: Nat; at(u, add(b, i)) = at(s, add(b, i))) -> forall d: Nat; productUpTo(u, add(b, d)) = productUpTo(s, add(b, d))
            [by generalize generalize-b]
        }
      @discharge-u |
        forall u: Seq; forall b: Nat; productUpTo(u, b) = productUpTo(s, b) -> (forall i: Nat; at(u, add(b, i)) = at(s, add(b, i))) -> forall d: Nat; productUpTo(u, add(b, d)) = productUpTo(s, add(b, d))
        [by generalize generalize-u]
    }
  @conclusion |
    forall s: Seq; forall u: Seq; forall b: Nat; productUpTo(u, b) = productUpTo(s, b) -> (forall i: Nat; at(u, add(b, i)) = at(s, add(b, i))) -> forall d: Nat; productUpTo(u, add(b, d)) = productUpTo(s, add(b, d))
    [by generalize generalize-s]
qed

// a < b implies a < b + i: adding on the right only increases (ordinary induction on i).
theorem weakLeftBound: forall a: Nat; forall b: Nat; less_than(a, b) -> forall i: Nat; less_than(a, add(b, i))
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @given-below |
            assume less_than(a, b) {
              @below |
                less_than(a, b)
                [by hypothesis given-below]
              @b-plus-zero |
                add(b, ZERO) = b
                [using specialize peano.addZeroRight(b)]
              @base-case |
                less_than(a, add(b, ZERO))
                [by rewrite b-plus-zero below]
              @induction-step |
                fix i: Nat {
                  @given-inductive-hypothesis |
                    assume less_than(a, add(b, i)) {
                      @inductive-hypothesis |
                        less_than(a, add(b, i))
                        [by hypothesis given-inductive-hypothesis]
                      @b-plus-succ |
                        add(b, succ(i)) = succ(add(b, i))
                        [using specialize peano.addSuccRight(b, i)]
                      @below-succ |
                        less_than(a, succ(add(b, i)))
                        [using specialize peano_order.lessThanSuccRight(a, add(b, i)) inductive-hypothesis]
                      @conclusion-next |
                        less_than(a, add(b, succ(i)))
                        [by rewrite b-plus-succ below-succ]
                    }
                  @induction-step-at-i |
                    less_than(a, add(b, i)) -> less_than(a, add(b, succ(i)))
                    [by discharge given-inductive-hypothesis]
                }
              @induction-step-for-all-i |
                forall i: Nat; less_than(a, add(b, i)) -> less_than(a, add(b, succ(i)))
                [by generalize induction-step]
              @conclusion-for-all-i |
                forall i: Nat; less_than(a, add(b, i))
                [using instantiation natInduction((fun i: Nat => less_than(a, add(b, i)))) base-case induction-step-for-all-i]
            }
          @below-implies |
            less_than(a, b) -> forall i: Nat; less_than(a, add(b, i))
            [by discharge given-below]
        }
      @discharge-b |
        forall b: Nat; less_than(a, b) -> forall i: Nat; less_than(a, add(b, i))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a: Nat; forall b: Nat; less_than(a, b) -> forall i: Nat; less_than(a, add(b, i))
    [by generalize generalize-a]
qed

// succ(k) < (k+2) + i — the arithmetic that says the untouched tail really is above the pair.
theorem succKIsBelowTheTail: forall k: Nat; forall i: Nat; less_than(succ(k), add(succ(succ(k)), i))
proof
  @generalize-k |
    fix k: Nat {
      @generalize-i |
        fix i: Nat {
          @succ-k-below-succ-succ-k |
            less_than(succ(k), succ(succ(k)))
            [using specialize natLessThanSelf(succ(k))]
          @bound-at-k |
            forall i2: Nat; less_than(succ(k), add(succ(succ(k)), i2))
            [using specialize weakLeftBound(succ(k), succ(succ(k))) succ-k-below-succ-succ-k]
          @conclusion-below-tail |
            less_than(succ(k), add(succ(succ(k)), i))
            [using specialize bound-at-k(i)]
        }
      @discharge-i |
        forall i: Nat; less_than(succ(k), add(succ(succ(k)), i))
        [by generalize generalize-i]
    }
  @conclusion |
    forall k: Nat; forall i: Nat; less_than(succ(k), add(succ(succ(k)), i))
    [by generalize generalize-k]
qed

// -- THE REWRITE, assembled -------------------------------------------------------------------
// Given a product of length r = (k+2) + d and a pair (p, q) composing to the pair at (k, k+1),
// there is a sequence with that pair in place, the SAME product at length r, and every entry
// outside {k, k+1} untouched. Assembles seqReplaceTwo with the two bridges above.
theorem rewritingAPairKeepsTheWholeProduct: forall s: Seq; forall k: Nat; forall d: Nat; forall p: Fn; forall q: Fn;
  invertible(p) -> invertible(q) ->
  compose(p, q) = compose(at(s, k), at(s, succ(k))) ->
  (exists u: Seq;
  at(u, k) = p
  and at(u, succ(k)) = q
  and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i))
  and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i))
  and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d)))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-k |
        fix k: Nat {
          @generalize-d |
            fix d: Nat {
              @generalize-p |
                fix p: Fn {
                  @generalize-q |
                    fix q: Fn {
                      @given-p |
                        assume invertible(p) {
                          @given-q |
                            assume invertible(q) {
                              @given-pair |
                                assume compose(p, q) = compose(at(s, k), at(s, succ(k))) {
                                  @p-invertible |
                                    invertible(p)
                                    [by hypothesis given-p]
                                  @q-invertible |
                                    invertible(q)
                                    [by hypothesis given-q]
                                  @pair-composes |
                                    compose(p, q) = compose(at(s, k), at(s, succ(k)))
                                    [by hypothesis given-pair]
                                  @surgery-exists |
                                    exists u: Seq; at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i))
                                    [using specialize seqReplaceTwo(s, k, p, q) p-invertible q-invertible]
                                  @with-rewritten-u |
                                    unpack u: Seq from surgery-exists {
                                      @u-facts |
                                        at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i))
                                        [by hypothesis with-rewritten-u]
                                      @u-at-k |
                                        at(u, k) = p
                                        [using tautology u-facts]
                                      @u-at-succ-k |
                                        at(u, succ(k)) = q
                                        [using tautology u-facts]
                                      @u-below |
                                        forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)
                                        [using tautology u-facts]
                                      @u-above |
                                        forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)
                                        [using tautology u-facts]
                                      // the pair in u composes to the pair in s
                                      @u-pair-is-p-q |
                                        compose(at(u, k), at(u, succ(k))) = compose(p, at(u, succ(k)))
                                        [by rewrite u-at-k u-pair-reflexive]
                                      @u-pair-reflexive |
                                        compose(at(u, k), at(u, succ(k))) = compose(at(u, k), at(u, succ(k)))
                                        [by reflexivity]
                                      @u-pair-fully |
                                        compose(at(u, k), at(u, succ(k))) = compose(p, q)
                                        [by rewrite u-at-succ-k u-pair-is-p-q]
                                      @u-pair-matches |
                                        compose(at(u, k), at(u, succ(k))) = compose(at(s, k), at(s, succ(k)))
                                        [using chain u-pair-fully pair-composes]
                                      @prefixes-equal |
                                        productUpTo(u, k) = productUpTo(s, k)
                                        [using specialize agreeingPrefixesHaveEqualProducts(s, u, k) u-below]
                                      @equal-at-k-plus-two |
                                        productUpTo(u, succ(succ(k))) = productUpTo(s, succ(succ(k)))
                                        [using specialize replacingAPairKeepsTheProduct(s, u, k) u-below u-pair-matches prefixes-equal]
                                      // entries from k+2 upward are untouched, so the equality extends
                                      @tails-agree |
                                        forall i: Nat; at(u, add(succ(succ(k)), i)) = at(s, add(succ(succ(k)), i))
                                        [by generalize tail-entry]
                                      @tail-entry |
                                        fix i: Nat {
                                          @succ-k-below |
                                            less_than(succ(k), add(succ(succ(k)), i))
                                            [using specialize succKIsBelowTheTail(k, i)]
                                          @conclusion-tail-agrees |
                                            at(u, add(succ(succ(k)), i)) = at(s, add(succ(succ(k)), i))
                                            [using specialize u-above(add(succ(succ(k)), i)) succ-k-below]
                                        }
                                      @products-agree-everywhere |
                                        forall d2: Nat; productUpTo(u, add(succ(succ(k)), d2)) = productUpTo(s, add(succ(succ(k)), d2))
                                        [using specialize equalProductsExtendUpward(s, u, succ(succ(k))) equal-at-k-plus-two tails-agree]
                                      @products-agree-at-d |
                                        productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d))
                                        [using specialize products-agree-everywhere(d)]
                                      @all-facts |
                                        at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d))
                                        [using tautology u-facts products-agree-at-d]
                                      @conclusion-witnessed |
                                        exists u2: Seq; at(u2, k) = p and at(u2, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u2, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u2, i) = at(s, i)) and productUpTo(u2, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d))
                                        [by witness(u) all-facts]
                                    }
                                  @conclusion-exists |
                                    exists u: Seq; at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d))
                                    [by unpacked with-rewritten-u]
                                }
                              @pair-implies |
                                compose(p, q) = compose(at(s, k), at(s, succ(k))) -> (exists u: Seq; at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d)))
                                [by discharge given-pair]
                            }
                          @q-implies |
                            invertible(q) -> compose(p, q) = compose(at(s, k), at(s, succ(k))) -> (exists u: Seq; at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d)))
                            [by discharge given-q]
                        }
                      @p-implies |
                        invertible(p) -> invertible(q) -> compose(p, q) = compose(at(s, k), at(s, succ(k))) -> (exists u: Seq; at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d)))
                        [by discharge given-p]
                    }
                  @discharge-q |
                    forall q: Fn; invertible(p) -> invertible(q) -> compose(p, q) = compose(at(s, k), at(s, succ(k))) -> (exists u: Seq; at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d)))
                    [by generalize generalize-q]
                }
              @discharge-p |
                forall p, q: Fn; invertible(p) -> invertible(q) -> compose(p, q) = compose(at(s, k), at(s, succ(k))) -> (exists u: Seq; at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d)))
                [by generalize generalize-p]
            }
          @discharge-d |
            forall d: Nat; forall p, q: Fn; invertible(p) -> invertible(q) -> compose(p, q) = compose(at(s, k), at(s, succ(k))) -> (exists u: Seq; at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d)))
            [by generalize generalize-d]
        }
      @discharge-k |
        forall k: Nat; forall d: Nat; forall p, q: Fn; invertible(p) -> invertible(q) -> compose(p, q) = compose(at(s, k), at(s, succ(k))) -> (exists u: Seq; at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d)))
        [by generalize generalize-k]
    }
  @conclusion |
    forall s: Seq; forall k: Nat; forall d: Nat; forall p, q: Fn; invertible(p) -> invertible(q) -> compose(p, q) = compose(at(s, k), at(s, succ(k))) -> (exists u: Seq; at(u, k) = p and at(u, succ(k)) = q and (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) and (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) and productUpTo(u, add(succ(succ(k)), d)) = productUpTo(s, add(succ(succ(k)), d)))
    [by generalize generalize-s]
qed

// -- a transposition is not the identity ------------------------------------------------------
// Needed to kill the r = 1 case of the outer induction: (u v) sends u to v, and u != v.
theorem transpositionIsNotIdentity: forall t: Fn; isTransposition(t) -> t != identityFn
proof
  @generalize-t |
    fix t: Fn {
      @given-transposition |
        assume isTransposition(t) {
          @is-a-transposition |
            isTransposition(t)
            [by hypothesis given-transposition]
          @letters-exist |
            exists u: Element; exists v: Element; u != v and t = transposition(u, v)
            [using tautology is-a-transposition]
          @with-first-letter |
            unpack u: Element from letters-exist {
              @second-exists |
                exists v: Element; u != v and t = transposition(u, v)
                [by hypothesis with-first-letter]
              @with-second-letter |
                unpack v: Element from second-exists {
                  @letter-facts |
                    u != v and t = transposition(u, v)
                    [by hypothesis with-second-letter]
                  @distinct |
                    u != v
                    [by and_lhs letter-facts]
                  @t-is-the-swap |
                    t = transposition(u, v)
                    [by and_rhs letter-facts]
                  @swap-at-u |
                    apply(transposition(u, v), u) = v
                    [using specialize transpositionAtFirst(u, v)]
                  @given-t-is-identity |
                    assume t = identityFn {
                      @t-is-identity |
                        t = identityFn
                        [by hypothesis given-t-is-identity]
                      @swap-is-identity |
                        transposition(u, v) = identityFn
                        [using chain swap-flipped t-is-identity]
                      @swap-flipped |
                        transposition(u, v) = t
                        [by symmetry t-is-the-swap]
                      @identity-at-u |
                        apply(identityFn, u) = u
                        [using specialize identityApply(u)]
                      @swap-at-u-is-u |
                        apply(transposition(u, v), u) = u
                        [by rewrite swap-is-identity identity-at-u]
                      @v-is-u |
                        v = u
                        [using chain swap-at-u-flipped swap-at-u-is-u]
                      @swap-at-u-flipped |
                        v = apply(transposition(u, v), u)
                        [by symmetry swap-at-u]
                      @u-is-v |
                        u = v
                        [by symmetry v-is-u]
                      @conclusion-contradiction |
                        t != identityFn
                        [using tautology u-is-v distinct]
                    }
                  @identity-implies |
                    t = identityFn -> t != identityFn
                    [by discharge given-t-is-identity]
                  @t-is-identity-or-not |
                    t = identityFn or t != identityFn
                    [using tautology]
                  @conclusion-not-identity-inner |
                    t != identityFn
                    [using tautology identity-implies t-is-identity-or-not]
                }
              @conclusion-not-identity-mid |
                t != identityFn
                [by unpacked with-second-letter]
            }
          @conclusion-not-identity |
            t != identityFn
            [by unpacked with-first-letter]
        }
      @transposition-implies |
        isTransposition(t) -> t != identityFn
        [by discharge given-transposition]
    }
  @conclusion |
    forall t: Fn; isTransposition(t) -> t != identityFn
    [by generalize generalize-t]
qed

// k < i means i is the very next value or strictly beyond it — succ(k) <= i split.
theorem successorSplit: forall k: Nat; forall i: Nat; less_than(k, i) -> (i = succ(k) or less_than(succ(k), i))
proof
  @generalize-k |
    fix k: Nat {
      @generalize-i |
        fix i: Nat {
          @given-above |
            assume less_than(k, i) {
              @above |
                less_than(k, i)
                [by hypothesis given-above]
              // k < i gives succ(k) < succ(i), and lessThanSuccSplit on that gives
              // succ(k) < i or succ(k) = i.
              @succ-below-succ |
                less_than(succ(k), succ(i))
                [using specialize peano_order.succPreservesOrder(k, i) above]
              @split |
                less_than(succ(k), i) or succ(k) = i
                [using specialize natLessThanSuccSplit(succ(k), i) succ-below-succ]
              @conclusion-split |
                i = succ(k) or less_than(succ(k), i)
                case split {
                  @when-strictly-below |
                    assume less_than(succ(k), i) {
                      @strictly-below |
                        less_than(succ(k), i)
                        [by hypothesis when-strictly-below]
                      @conclusion-strict |
                        i = succ(k) or less_than(succ(k), i)
                        [by either_right strictly-below]
                    }
                  @when-equal |
                    assume succ(k) = i {
                      @succ-is-i |
                        succ(k) = i
                        [by hypothesis when-equal]
                      @i-is-succ |
                        i = succ(k)
                        [by symmetry succ-is-i]
                      @conclusion-eq |
                        i = succ(k) or less_than(succ(k), i)
                        [by either_left i-is-succ]
                    }
                }
            }
          @above-implies |
            less_than(k, i) -> (i = succ(k) or less_than(succ(k), i))
            [by discharge given-above]
        }
      @discharge-i |
        forall i: Nat; less_than(k, i) -> (i = succ(k) or less_than(succ(k), i))
        [by generalize generalize-i]
    }
  @conclusion |
    forall k: Nat; forall i: Nat; less_than(k, i) -> (i = succ(k) or less_than(succ(k), i))
    [by generalize generalize-k]
qed

// An index sits below a pair, at its first slot, at its second, or above it.
theorem positionRelativeToAPair: forall i: Nat; forall k: Nat;
  less_than(i, k) or i = k or i = succ(k) or less_than(succ(k), i)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-k |
        fix k: Nat {
          @below-or-not |
            less_than(i, k) or i = k or less_than(k, i)
            [using specialize peano_order.trichotomy(i, k)]
          @conclusion-position |
            less_than(i, k) or i = k or i = succ(k) or less_than(succ(k), i)
            case below-or-not {
              @when-below |
                assume less_than(i, k) {
                  @below |
                    less_than(i, k)
                    [by hypothesis when-below]
                  @conclusion-below |
                    less_than(i, k) or i = k or i = succ(k) or less_than(succ(k), i)
                    [using tautology below]
                }
              @when-equal |
                assume i = k {
                  @equal |
                    i = k
                    [by hypothesis when-equal]
                  @conclusion-equal |
                    less_than(i, k) or i = k or i = succ(k) or less_than(succ(k), i)
                    [using tautology equal]
                }
              @when-above |
                assume less_than(k, i) {
                  @above |
                    less_than(k, i)
                    [by hypothesis when-above]
                  // k < i splits as succ(k) = i or succ(k) < i.
                  @succ-k-at-most-i |
                    i = succ(k) or less_than(succ(k), i)
                    [using specialize successorSplit(k, i) above]
                  @conclusion-above |
                    less_than(i, k) or i = k or i = succ(k) or less_than(succ(k), i)
                    [using tautology succ-k-at-most-i]
                }
            }
        }
      @discharge-k |
        forall k: Nat; less_than(i, k) or i = k or i = succ(k) or less_than(succ(k), i)
        [by generalize generalize-k]
    }
  @conclusion |
    forall i: Nat; forall k: Nat; less_than(i, k) or i = k or i = succ(k) or less_than(succ(k), i)
    [by generalize generalize-i]
qed

// -- a rewritten sequence is still all transpositions -----------------------------------------
// Entries below k and above k+1 are copied from a sequence that was all transpositions; the two
// replaced entries are transpositions by hypothesis. So every index below the length qualifies.
theorem rewrittenSequenceIsAllTranspositions: forall s: Seq; forall u: Seq; forall k: Nat; forall n: Nat;
  allTranspositions(s, n) ->
  isTransposition(at(u, k)) ->
  isTransposition(at(u, succ(k))) ->
  (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) ->
  (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) ->
  allTranspositions(u, n)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-u |
        fix u: Seq {
          @generalize-k |
            fix k: Nat {
              @generalize-n |
                fix n: Nat {
                  @given-all |
                    assume allTranspositions(s, n) {
                      @given-at-k |
                        assume isTransposition(at(u, k)) {
                          @given-at-succ-k |
                            assume isTransposition(at(u, succ(k))) {
                              @given-below |
                                assume forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i) {
                                  @given-above |
                                    assume forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i) {
                                      @s-all |
                                        allTranspositions(s, n)
                                        [by hypothesis given-all]
                                      @u-at-k |
                                        isTransposition(at(u, k))
                                        [by hypothesis given-at-k]
                                      @u-at-succ-k |
                                        isTransposition(at(u, succ(k)))
                                        [by hypothesis given-at-succ-k]
                                      @u-below |
                                        forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)
                                        [by hypothesis given-below]
                                      @u-above |
                                        forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)
                                        [by hypothesis given-above]
                                      @generalize-i |
                                        fix i: Nat {
                                          @given-i-below-n |
                                            assume less_than(i, n) {
                                              @i-below-n |
                                                less_than(i, n)
                                                [by hypothesis given-i-below-n]
                                              @s-at-i |
                                                isTransposition(at(s, i))
                                                [using specialize s-all(i) i-below-n]
                                              // i is below k, equal to k, equal to k+1, or above k+1.
                                              @i-position |
                                                less_than(i, k) or i = k or i = succ(k) or less_than(succ(k), i)
                                                [using specialize positionRelativeToAPair(i, k)]
                                              @conclusion-i-is-a-transposition |
                                                isTransposition(at(u, i))
                                                case i-position {
                                                  @when-below |
                                                    assume less_than(i, k) {
                                                      @below |
                                                        less_than(i, k)
                                                        [by hypothesis when-below]
                                                      @copied |
                                                        at(u, i) = at(s, i)
                                                        [using specialize u-below(i) below]
                                                      @conclusion-below |
                                                        isTransposition(at(u, i))
                                                        [by rewrite copied s-at-i]
                                                    }
                                                  @when-at-k |
                                                    assume i = k {
                                                      @at-k |
                                                        i = k
                                                        [by hypothesis when-at-k]
                                                      @conclusion-at-k |
                                                        isTransposition(at(u, i))
                                                        [by rewrite at-k u-at-k]
                                                    }
                                                  @when-at-succ-k |
                                                    assume i = succ(k) {
                                                      @at-succ-k |
                                                        i = succ(k)
                                                        [by hypothesis when-at-succ-k]
                                                      @conclusion-at-succ-k |
                                                        isTransposition(at(u, i))
                                                        [by rewrite at-succ-k u-at-succ-k]
                                                    }
                                                  @when-above |
                                                    assume less_than(succ(k), i) {
                                                      @above |
                                                        less_than(succ(k), i)
                                                        [by hypothesis when-above]
                                                      @copied-above |
                                                        at(u, i) = at(s, i)
                                                        [using specialize u-above(i) above]
                                                      @conclusion-above |
                                                        isTransposition(at(u, i))
                                                        [by rewrite copied-above s-at-i]
                                                    }
                                                }
                                            }
                                          @i-below-implies |
                                            less_than(i, n) -> isTransposition(at(u, i))
                                            [by discharge given-i-below-n]
                                        }
                                      @conclusion-u-all |
                                        allTranspositions(u, n)
                                        [by generalize generalize-i]
                                    }
                                  @above-implies |
                                    (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) -> allTranspositions(u, n)
                                    [by discharge given-above]
                                }
                              @below-implies |
                                (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) -> allTranspositions(u, n)
                                [by discharge given-below]
                            }
                          @at-succ-k-implies |
                            isTransposition(at(u, succ(k))) -> (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) -> allTranspositions(u, n)
                            [by discharge given-at-succ-k]
                        }
                      @at-k-implies |
                        isTransposition(at(u, k)) -> isTransposition(at(u, succ(k))) -> (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) -> allTranspositions(u, n)
                        [by discharge given-at-k]
                    }
                  @all-implies |
                    allTranspositions(s, n) -> isTransposition(at(u, k)) -> isTransposition(at(u, succ(k))) -> (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) -> allTranspositions(u, n)
                    [by discharge given-all]
                }
              @discharge-n |
                forall n: Nat; allTranspositions(s, n) -> isTransposition(at(u, k)) -> isTransposition(at(u, succ(k))) -> (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) -> allTranspositions(u, n)
                [by generalize generalize-n]
            }
          @discharge-k |
            forall k: Nat; forall n: Nat; allTranspositions(s, n) -> isTransposition(at(u, k)) -> isTransposition(at(u, succ(k))) -> (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) -> allTranspositions(u, n)
            [by generalize generalize-k]
        }
      @discharge-u |
        forall u: Seq; forall k: Nat; forall n: Nat; allTranspositions(s, n) -> isTransposition(at(u, k)) -> isTransposition(at(u, succ(k))) -> (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) -> allTranspositions(u, n)
        [by generalize generalize-u]
    }
  @conclusion |
    forall s: Seq; forall u: Seq; forall k: Nat; forall n: Nat; allTranspositions(s, n) -> isTransposition(at(u, k)) -> isTransposition(at(u, succ(k))) -> (forall i: Nat; less_than(i, k) -> at(u, i) = at(s, i)) -> (forall i: Nat; less_than(succ(k), i) -> at(u, i) = at(s, i)) -> allTranspositions(u, n)
    [by generalize generalize-s]
qed

// A point moved by a swap must be one of the two letters — the contrapositive of
// transpositionElsewhere.
theorem movedBySwapIsOneOfItsLetters: forall x, y, z: Element; apply(transposition(x, y), z) != z -> (z = x or z = y)
proof
  @generalize-x |
    fix x: Element {
      @generalize-y |
        fix y: Element {
          @generalize-z |
            fix z: Element {
              @given-moved |
                assume apply(transposition(x, y), z) != z {
                  @moved |
                    apply(transposition(x, y), z) != z
                    [by hypothesis given-moved]
                  @is-x-or-not |
                    z = x or z != x
                    [using tautology]
                  @conclusion-one-of-them |
                    z = x or z = y
                    case is-x-or-not {
                      @when-is-x |
                        assume z = x {
                          @is-x |
                            z = x
                            [by hypothesis when-is-x]
                          @conclusion-is-x |
                            z = x or z = y
                            [by either_left is-x]
                        }
                      @when-not-x |
                        assume z != x {
                          @not-x |
                            z != x
                            [by hypothesis when-not-x]
                          @is-y-or-not |
                            z = y or z != y
                            [using tautology]
                          @conclusion-not-x |
                            z = x or z = y
                            case is-y-or-not {
                              @when-is-y |
                                assume z = y {
                                  @is-y |
                                    z = y
                                    [by hypothesis when-is-y]
                                  @conclusion-is-y |
                                    z = x or z = y
                                    [by either_right is-y]
                                }
                              @when-not-y |
                                assume z != y {
                                  @not-y |
                                    z != y
                                    [by hypothesis when-not-y]
                                  @fixed |
                                    apply(transposition(x, y), z) = z
                                    [using specialize transpositionElsewhere(x, y, z) not-x not-y]
                                  @conclusion-ex_falso |
                                    z = x or z = y
                                    [using tautology fixed moved]
                                }
                            }
                        }
                    }
                }
              @moved-implies |
                apply(transposition(x, y), z) != z -> (z = x or z = y)
                [by discharge given-moved]
            }
          @discharge-z |
            forall z: Element; apply(transposition(x, y), z) != z -> (z = x or z = y)
            [by generalize generalize-z]
        }
      @discharge-y |
        forall y, z: Element; apply(transposition(x, y), z) != z -> (z = x or z = y)
        [by generalize generalize-y]
    }
  @conclusion |
    forall x, y, z: Element; apply(transposition(x, y), z) != z -> (z = x or z = y)
    [by generalize generalize-x]
qed

// A transposition moves something — its first letter.
theorem aTranspositionMovesSomething: forall t: Fn; isTransposition(t) -> exists z: Element; apply(t, z) != z
proof
  @generalize-t |
    fix t: Fn {
      @given-transposition |
        assume isTransposition(t) {
          @is-a-transposition |
            isTransposition(t)
            [by hypothesis given-transposition]
          @letters-exist |
            exists x: Element; exists y: Element; x != y and t = transposition(x, y)
            [using tautology is-a-transposition]
          @with-first |
            unpack x: Element from letters-exist {
              @second-exists |
                exists y: Element; x != y and t = transposition(x, y)
                [by hypothesis with-first]
              @with-second |
                unpack y: Element from second-exists {
                  @facts |
                    x != y and t = transposition(x, y)
                    [by hypothesis with-second]
                  @distinct |
                    x != y
                    [by and_lhs facts]
                  @t-is-the-swap |
                    t = transposition(x, y)
                    [by and_rhs facts]
                  @swap-at-x |
                    apply(transposition(x, y), x) = y
                    [using specialize transpositionAtFirst(x, y)]
                  @t-at-x |
                    apply(t, x) = y
                    [by rewrite t-is-the-swap swap-at-x]
                  @given-fixed |
                    assume apply(t, x) = x {
                      @fixed |
                        apply(t, x) = x
                        [by hypothesis given-fixed]
                      @y-is-x |
                        y = x
                        [using chain t-at-x-flipped fixed]
                      @t-at-x-flipped |
                        y = apply(t, x)
                        [by symmetry t-at-x]
                      @x-is-y |
                        x = y
                        [by symmetry y-is-x]
                      @conclusion-ex_falso |
                        apply(t, x) != x
                        [using tautology x-is-y distinct]
                    }
                  @fixed-implies |
                    apply(t, x) = x -> apply(t, x) != x
                    [by discharge given-fixed]
                  @fixed-or-not |
                    apply(t, x) = x or apply(t, x) != x
                    [using tautology]
                  @t-moves-x |
                    apply(t, x) != x
                    [using tautology fixed-implies fixed-or-not]
                  @conclusion-witness |
                    exists z: Element; apply(t, z) != z
                    [by witness(x) t-moves-x]
                }
              @conclusion-second |
                exists z: Element; apply(t, z) != z
                [by unpacked with-second]
            }
          @conclusion-first |
            exists z: Element; apply(t, z) != z
            [by unpacked with-first]
        }
      @transposition-implies |
        isTransposition(t) -> exists z: Element; apply(t, z) != z
        [by discharge given-transposition]
    }
  @conclusion |
    forall t: Fn; isTransposition(t) -> exists z: Element; apply(t, z) != z
    [by generalize generalize-t]
qed

// A transposition is a permutation — the invertibility the surgery postulate demands.
theorem transpositionsAreInvertible: forall t: Fn; isTransposition(t) -> invertible(t)
proof
  @generalize-t |
    fix t: Fn {
      @given-transposition |
        assume isTransposition(t) {
          @is-a-transposition |
            isTransposition(t)
            [by hypothesis given-transposition]
          @letters-exist |
            exists x: Element; exists y: Element; x != y and t = transposition(x, y)
            [using tautology is-a-transposition]
          @with-first |
            unpack x: Element from letters-exist {
              @second-exists |
                exists y: Element; x != y and t = transposition(x, y)
                [by hypothesis with-first]
              @with-second |
                unpack y: Element from second-exists {
                  @facts |
                    x != y and t = transposition(x, y)
                    [by hypothesis with-second]
                  @t-is-the-swap |
                    t = transposition(x, y)
                    [by and_rhs facts]
                  @swap-is-a-permutation |
                    invertible(transposition(x, y))
                    [using specialize transpositionIsAPermutation(x, y)]
                  @conclusion-invertible-inner |
                    invertible(t)
                    [by rewrite t-is-the-swap swap-is-a-permutation]
                }
              @conclusion-invertible-second |
                invertible(t)
                [by unpacked with-second]
            }
          @conclusion-invertible |
            invertible(t)
            [by unpacked with-first]
        }
      @transposition-implies |
        isTransposition(t) -> invertible(t)
        [by discharge given-transposition]
    }
  @conclusion |
    forall t: Fn; isTransposition(t) -> invertible(t)
    [by generalize generalize-t]
qed

theorem atLeastTwoOrSmall: forall r: Nat; r = ZERO or r = succ(ZERO) or (exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d))
proof
  @generalize-r |
    fix r: Nat {
      @outer-cases |
        r = ZERO or (exists p: Nat; r = succ(p))
        [using specialize peano.zeroOrSucc(r)]
      @conclusion-shape |
        r = ZERO or r = succ(ZERO) or (exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d))
        case outer-cases {
          @when-zero |
            assume r = ZERO {
              @is-zero |
                r = ZERO
                [by hypothesis when-zero]
              @conclusion-zero |
                r = ZERO or r = succ(ZERO) or (exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d))
                [using tautology is-zero]
            }
          @when-successor |
            assume exists p: Nat; r = succ(p) {
              @has-predecessor |
                exists p: Nat; r = succ(p)
                [by hypothesis when-successor]
              @with-predecessor |
                unpack p: Nat from has-predecessor {
                  @r-is-succ-p |
                    r = succ(p)
                    [by hypothesis with-predecessor]
                  @inner-cases |
                    p = ZERO or (exists q: Nat; p = succ(q))
                    [using specialize peano.zeroOrSucc(p)]
                  @conclusion-successor |
                    r = ZERO or r = succ(ZERO) or (exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d))
                    case inner-cases {
                      @when-p-zero |
                        assume p = ZERO {
                          @p-is-zero |
                            p = ZERO
                            [by hypothesis when-p-zero]
                          @r-is-one |
                            r = succ(ZERO)
                            [by rewrite p-is-zero r-is-succ-p]
                          @conclusion-one |
                            r = ZERO or r = succ(ZERO) or (exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d))
                            [using tautology r-is-one]
                        }
                      @when-p-successor |
                        assume exists q: Nat; p = succ(q) {
                          @p-has-predecessor |
                            exists q: Nat; p = succ(q)
                            [by hypothesis when-p-successor]
                          @with-p-predecessor |
                            unpack q: Nat from p-has-predecessor {
                              @p-is-succ-q |
                                p = succ(q)
                                [by hypothesis with-p-predecessor]
                              @r-is-two-more |
                                r = succ(succ(q))
                                [by rewrite p-is-succ-q r-is-succ-p]
                              @sum-at-zero |
                                add(succ(succ(q)), ZERO) = succ(succ(q))
                                [using specialize peano.addZeroRight(succ(succ(q)))]
                              @sum-flipped |
                                succ(succ(q)) = add(succ(succ(q)), ZERO)
                                [by symmetry sum-at-zero]
                              @r-is-the-sum |
                                r = add(succ(succ(q)), ZERO)
                                [using chain r-is-two-more sum-flipped]
                              @inner-witness |
                                exists d: Nat; r = add(succ(succ(q)), d)
                                [by witness(ZERO) r-is-the-sum]
                              @outer-witness |
                                exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d)
                                [by witness(q) inner-witness]
                              @conclusion-at-least-two-inner |
                                r = ZERO or r = succ(ZERO) or (exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d))
                                [using tautology outer-witness]
                            }
                          @conclusion-at-least-two |
                            r = ZERO or r = succ(ZERO) or (exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d))
                            [by unpacked with-p-predecessor]
                        }
                    }
                }
              @conclusion-with-predecessor |
                r = ZERO or r = succ(ZERO) or (exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d))
                [by unpacked with-predecessor]
            }
        }
    }
  @conclusion |
    forall r: Nat; r = ZERO or r = succ(ZERO) or (exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d))
    [by generalize generalize-r]
qed
// A ONE-factor product is its single transposition, which is not the identity.
theorem noOneFactorIdentity: not someProductOfLengthIsIdentity(succ(ZERO))
proof
  @given-such-a-product |
    assume someProductOfLengthIsIdentity(succ(ZERO)) {
      @such-a-product |
        someProductOfLengthIsIdentity(succ(ZERO))
        [by hypothesis given-such-a-product]
      @sequence-exists |
        exists t: Seq; allTranspositions(t, succ(ZERO)) and productUpTo(t, succ(ZERO)) = identityFn
        [using tautology such-a-product]
      @with-sequence |
        unpack t: Seq from sequence-exists {
          @t-facts |
            allTranspositions(t, succ(ZERO)) and productUpTo(t, succ(ZERO)) = identityFn
            [by hypothesis with-sequence]
          @t-all |
            allTranspositions(t, succ(ZERO))
            [by and_lhs t-facts]
          @t-product-is-identity |
            productUpTo(t, succ(ZERO)) = identityFn
            [by and_rhs t-facts]
          @zero-below-one |
            less_than(ZERO, succ(ZERO))
            [using specialize natLessThanSelf(ZERO)]
          @entry-is-a-transposition |
            isTransposition(at(t, ZERO))
            [using specialize t-all(ZERO) zero-below-one]
          // the one-factor product IS that entry: identity ∘ at(t,0) = at(t,0).
          @unfolds |
            productUpTo(t, succ(ZERO)) = compose(productUpTo(t, ZERO), at(t, ZERO))
            [using specialize productUpToSucc(t, ZERO)]
          @empty-is-identity |
            productUpTo(t, ZERO) = identityFn
            [using specialize productUpToZero(t)]
          @with-identity |
            productUpTo(t, succ(ZERO)) = compose(identityFn, at(t, ZERO))
            [by rewrite empty-is-identity unfolds]
          @identity-composes-away |
            compose(identityFn, at(t, ZERO)) = at(t, ZERO)
            [using specialize composeIdentityLeft(at(t, ZERO))]
          @product-is-the-entry |
            productUpTo(t, succ(ZERO)) = at(t, ZERO)
            [using chain with-identity identity-composes-away]
          @entry-is-identity |
            at(t, ZERO) = identityFn
            [using chain product-is-the-entry-flipped t-product-is-identity]
          @product-is-the-entry-flipped |
            at(t, ZERO) = productUpTo(t, succ(ZERO))
            [by symmetry product-is-the-entry]
          @entry-is-not-identity |
            at(t, ZERO) != identityFn
            [using specialize transpositionIsNotIdentity(at(t, ZERO)) entry-is-a-transposition]
          @conclusion-contradiction |
            less_than(ZERO, ZERO)
            [using tautology entry-is-identity entry-is-not-identity]
        }
      @contradiction |
        less_than(ZERO, ZERO)
        [by unpacked with-sequence]
    }
  @product-implies-absurdity |
    someProductOfLengthIsIdentity(succ(ZERO)) -> less_than(ZERO, ZERO)
    [by discharge given-such-a-product]
  @zero-not-below-itself |
    not less_than(ZERO, ZERO)
    [using specialize peano_order.lessThanIrreflexive(ZERO)]
  @conclusion |
    not someProductOfLengthIsIdentity(succ(ZERO))
    [using tautology product-implies-absurdity zero-not-below-itself]
qed
theorem twoMoreCommutes: forall m: Nat; forall d: Nat; add(succ(succ(m)), d) = succ(succ(add(m, d)))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-d |
        fix d: Nat {
          @peel-outer |
            add(succ(succ(m)), d) = succ(add(succ(m), d))
            [using specialize peano.addSuccLeft(succ(m), d)]
          @peel-inner |
            add(succ(m), d) = succ(add(m, d))
            [using specialize peano.addSuccLeft(m, d)]
          @conclusion-commutes |
            add(succ(succ(m)), d) = succ(succ(add(m, d)))
            [by rewrite peel-inner peel-outer]
        }
      @discharge-d |
        forall d: Nat; add(succ(succ(m)), d) = succ(succ(add(m, d)))
        [by generalize generalize-d]
    }
  @conclusion |
    forall m: Nat; forall d: Nat; add(succ(succ(m)), d) = succ(succ(add(m, d)))
    [by generalize generalize-m]
qed

theorem droppingTwoIsSmaller: forall m: Nat; forall d: Nat; less_than(add(m, d), add(succ(succ(m)), d))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-d |
        fix d: Nat {
          @sum-is-two-more |
            add(succ(succ(m)), d) = succ(succ(add(m, d)))
            [using specialize twoMoreCommutes(m, d)]
          @below-own-successor |
            less_than(add(m, d), succ(add(m, d)))
            [using specialize natLessThanSelf(add(m, d))]
          @below-two-more |
            less_than(add(m, d), succ(succ(add(m, d))))
            [using specialize peano_order.lessThanSuccRight(add(m, d), succ(add(m, d))) below-own-successor]
          @conclusion-smaller |
            less_than(add(m, d), add(succ(succ(m)), d))
            [by rewrite sum-is-two-more below-two-more]
        }
      @discharge-d |
        forall d: Nat; less_than(add(m, d), add(succ(succ(m)), d))
        [by generalize generalize-d]
    }
  @conclusion |
    forall m: Nat; forall d: Nat; less_than(add(m, d), add(succ(succ(m)), d))
    [by generalize generalize-m]
qed

// add(ONE, ONE) = succ(succ(ZERO)) — the two spellings of two, bridged once.
theorem twoIsSuccSuccZero: NTWO = succ(succ(ZERO))
proof
  @one-is-succ-zero |
    peano.ONE = succ(ZERO)
    [by cite peano.oneIsSuccZero]
  @two-at-succ-zero |
    add(peano.ONE, succ(ZERO)) = succ(add(peano.ONE, ZERO))
    [using specialize peano.addSuccRight(peano.ONE, ZERO)]
  @two-unfolds |
    add(peano.ONE, peano.ONE) = succ(add(peano.ONE, ZERO))
    [by rewrite one-is-succ-zero two-at-succ-zero]
  @sum-at-zero |
    add(peano.ONE, ZERO) = peano.ONE
    [using specialize peano.addZeroRight(peano.ONE)]
  @two-is-succ-one |
    add(peano.ONE, peano.ONE) = succ(peano.ONE)
    [by rewrite sum-at-zero two-unfolds]
  @conclusion |
    NTWO = succ(succ(ZERO))
    [by rewrite one-is-succ-zero two-is-succ-one]
qed

theorem twoDividesPlusTwo: forall n: Nat; forall r: Nat; ndivides(NTWO, n) -> r = succ(succ(n)) -> ndivides(NTWO, r)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-r |
        fix r: Nat {
          @given-divides |
            assume ndivides(NTWO, n) {
              @given-two-more |
                assume r = succ(succ(n)) {
                  @divides-n |
                    ndivides(NTWO, n)
                    [by hypothesis given-divides]
                  @is-two-more |
                    r = succ(succ(n))
                    [by hypothesis given-two-more]
                  @two-divides-two |
                    ndivides(NTWO, NTWO)
                    [using specialize peano_divides.dividesRefl(NTWO)]
                  @divides-the-sum |
                    ndivides(NTWO, add(n, NTWO))
                    [using specialize peano_divides.dividesAdd(NTWO, n, NTWO) divides-n two-divides-two]
                  // n + 2 = succ(succ(n))
                  @sum-peels-once |
                    add(n, succ(succ(ZERO))) = succ(add(n, succ(ZERO)))
                    [using specialize peano.addSuccRight(n, succ(ZERO))]
                  @sum-peels-twice |
                    add(n, succ(ZERO)) = succ(add(n, ZERO))
                    [using specialize peano.addSuccRight(n, ZERO)]
                  @sum-at-zero |
                    add(n, ZERO) = n
                    [using specialize peano.addZeroRight(n)]
                  @sum-is-succ-n |
                    add(n, succ(ZERO)) = succ(n)
                    [by rewrite sum-at-zero sum-peels-twice]
                  @sum-is-two-more |
                    add(n, succ(succ(ZERO))) = succ(succ(n))
                    [by rewrite sum-is-succ-n sum-peels-once]
                  // NTWO is `add(ONE, ONE)`; the peeling above is stated over the successor
                  // tower, so bridge the two spellings once.
                  @two-is-the-tower |
                    NTWO = succ(succ(ZERO))
                    [by cite twoIsSuccSuccZero]
                  @sum-at-the-tower |
                    add(n, NTWO) = succ(succ(n))
                    [by rewrite two-is-the-tower sum-is-two-more]
                  @divides-two-more |
                    ndivides(NTWO, succ(succ(n)))
                    [by rewrite sum-at-the-tower divides-the-sum]
                  @conclusion-divides-r |
                    ndivides(NTWO, r)
                    [by rewrite is-two-more divides-two-more]
                }
              @two-more-implies |
                r = succ(succ(n)) -> ndivides(NTWO, r)
                [by discharge given-two-more]
            }
          @divides-implies |
            ndivides(NTWO, n) -> r = succ(succ(n)) -> ndivides(NTWO, r)
            [by discharge given-divides]
        }
      @discharge-r |
        forall r: Nat; ndivides(NTWO, n) -> r = succ(succ(n)) -> ndivides(NTWO, r)
        [by generalize generalize-r]
    }
  @conclusion |
    forall n: Nat; forall r: Nat; ndivides(NTWO, n) -> r = succ(succ(n)) -> ndivides(NTWO, r)
    [by generalize generalize-n]
qed

// -- STEP 4: THE PARITY LEMMA, by strong induction on the factor count ------------------------
// r = 0 is even. r = 1 is impossible: a one-factor product is its single transposition, which is
// not the identity. For r >= 2 the inner loop gives a product of r − 2, even by the hypothesis,
// so r is even.
theorem identityIsEvenLength: forall r: Nat; someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r)
proof
  @strong-step |
    fix r: Nat {
      @given-smaller-cases |
        assume forall q: Nat; less_than(q, r) -> (someProductOfLengthIsIdentity(q) -> ndivides(NTWO, q)) {
          @smaller-cases |
            forall q: Nat; less_than(q, r) -> (someProductOfLengthIsIdentity(q) -> ndivides(NTWO, q))
            [by hypothesis given-smaller-cases]
          @given-identity-product |
            assume someProductOfLengthIsIdentity(r) {
              @identity-product |
                someProductOfLengthIsIdentity(r)
                [by hypothesis given-identity-product]
              // r is 0, 1, or at least 2 — and only the last needs the loop.
              @r-shape |
                r = ZERO or r = succ(ZERO) or (exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d))
                [using specialize atLeastTwoOrSmall(r)]
              @conclusion-even |
                ndivides(NTWO, r)
                case r-shape {
                  @when-zero |
                    assume r = ZERO {
                      @is-zero |
                        r = ZERO
                        [by hypothesis when-zero]
                      @two-divides-zero |
                        ndivides(NTWO, ZERO)
                        [using specialize peano_divides.dividesZero(NTWO)]
                      @conclusion-zero-is-even |
                        ndivides(NTWO, r)
                        [by rewrite is-zero two-divides-zero]
                    }
                  @when-one |
                    assume r = succ(ZERO) {
                      @is-one |
                        r = succ(ZERO)
                        [by hypothesis when-one]
                      @one-product |
                        someProductOfLengthIsIdentity(succ(ZERO))
                        [by rewrite is-one identity-product]
                      @no-single-transposition |
                        not someProductOfLengthIsIdentity(succ(ZERO))
                        [by cite noOneFactorIdentity]
                      @conclusion-one-ex_falso |
                        ndivides(NTWO, r)
                        [using tautology one-product no-single-transposition]
                    }
                  @when-at-least-two |
                    assume exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d) {
                      @decomposes |
                        exists m: Nat; exists d: Nat; r = add(succ(succ(m)), d)
                        [by hypothesis when-at-least-two]
                      @with-m |
                        unpack m: Nat from decomposes {
                          @d-exists |
                            exists d: Nat; r = add(succ(succ(m)), d)
                            [by hypothesis with-m]
                          @with-d |
                            unpack d: Nat from d-exists {
                              @r-is-sum |
                                r = add(succ(succ(m)), d)
                                [by hypothesis with-d]
                              @product-at-sum |
                                someProductOfLengthIsIdentity(add(succ(succ(m)), d))
                                [by rewrite r-is-sum identity-product]
                              @shorter-product |
                                someProductOfLengthIsIdentity(add(m, d))
                                [using specialize innerLoopDropsTwo(m, d) product-at-sum]
                              @shorter-is-smaller |
                                less_than(add(m, d), r)
                                [by rewrite r-is-sum shorter-below-sum]
                              @shorter-below-sum |
                                less_than(add(m, d), add(succ(succ(m)), d))
                                [using specialize droppingTwoIsSmaller(m, d)]
                              @shorter-is-even |
                                ndivides(NTWO, add(m, d))
                                [using specialize smaller-cases(add(m, d)) shorter-is-smaller shorter-product]
                              @conclusion-sum-is-even |
                                ndivides(NTWO, r)
                                [using specialize twoDividesPlusTwo(add(m, d), r) shorter-is-even r-is-two-more]
                              @r-is-two-more |
                                r = succ(succ(add(m, d)))
                                [using chain r-is-sum sum-is-two-more]
                              @sum-is-two-more |
                                add(succ(succ(m)), d) = succ(succ(add(m, d)))
                                [using specialize twoMoreCommutes(m, d)]
                            }
                          @conclusion-with-d |
                            ndivides(NTWO, r)
                            [by unpacked with-d]
                        }
                      @conclusion-at-least-two |
                        ndivides(NTWO, r)
                        [by unpacked with-m]
                    }
                }
            }
          @product-implies |
            someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r)
            [by discharge given-identity-product]
        }
      @strong-step-at-r |
        (forall q: Nat; less_than(q, r) -> (someProductOfLengthIsIdentity(q) -> ndivides(NTWO, q))) -> (someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r))
        [by discharge given-smaller-cases]
    }
  @strong-step-for-all |
    forall r: Nat; (forall q: Nat; less_than(q, r) -> (someProductOfLengthIsIdentity(q) -> ndivides(NTWO, q))) -> (someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r))
    [by generalize strong-step]
  @conclusion |
    forall r: Nat; someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r)
    [using instantiation strongInduction((fun r: Nat => someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r))) strong-step-for-all]
qed

// -- the loop invariant, and the descending loop as its own hole -------------------------------
// Writing the ENDPOINT first exposed what two bottom-up attempts had missed: the invariant must
// be TWO-SIDED. "Every entry above j fixes `a`" alone is not contradictory at j = 0 — STEP 3
// then says entry 0 fixes `a`, which is merely true. The contradiction needs the other half,
// that entry j MOVES `a`: at j = 0 the letter is moved by entry 0 and by nothing above it, so
// the product moves it, and the product is the identity.
// FIFTH CONJUNCT `less_than(j, r)`, added 2026-09-30: without it the invariant does not
// place j inside the sequence, so the body cannot conclude that entries j and j+1 are
// transpositions (allTranspositions only speaks about indices below the length). It is not
// derivable from the other four — `at(w, j)` is defined at every index, so "entry j moves `a`"
// says nothing about j being in range. It comes free wherever the invariant is established.
define loopInvariant(a, j, r) = exists w: Seq; allTranspositions(w, r) and productUpTo(w, r) = identityFn and apply(at(w, j), a) != a and (forall i: Nat; less_than(j, i) -> less_than(i, r) -> apply(at(w, i), a) = a) and less_than(j, r)

// The invariant holds at the TOP INDEX, for free — and getting this right needed a correction.
// I first stated it at index m+1 of a length-((m+2)+d) product, which is WRONG: the d entries
// above m+1 are not known to fix `a`, so the invariant's "above" clause is unmet. The fix is to
// take the letter from the LAST entry. Over a length `succ(q)` the top index is q, and "every
// entry strictly above q and below succ(q)" is VACUOUS — there are no such indices. So the
// sequence itself witnesses the invariant, with no tail to clear.
theorem invariantHoldsAtTheTop: forall a: Element; forall s: Seq; forall q: Nat;
  allTranspositions(s, succ(q)) ->
  productUpTo(s, succ(q)) = identityFn ->
  apply(at(s, q), a) != a ->
  loopInvariant(a, q, succ(q))
proof
  @generalize-a |
    fix a: Element {
      @generalize-s |
        fix s: Seq {
          @generalize-q |
            fix q: Nat {
              @given-all |
                assume allTranspositions(s, succ(q)) {
                  @given-identity |
                    assume productUpTo(s, succ(q)) = identityFn {
                      @given-moves |
                        assume apply(at(s, q), a) != a {
                          @all-transpositions |
                            allTranspositions(s, succ(q))
                            [by hypothesis given-all]
                          @is-identity |
                            productUpTo(s, succ(q)) = identityFn
                            [by hypothesis given-identity]
                          @top-moves-a |
                            apply(at(s, q), a) != a
                            [by hypothesis given-moves]
                          // nothing is strictly above q and strictly below succ(q).
                          @nothing-above |
                            forall i: Nat; less_than(q, i) -> less_than(i, succ(q)) -> apply(at(s, i), a) = a
                            [by generalize vacuous]
                          @vacuous |
                            fix i: Nat {
                              @given-above-q |
                                assume less_than(q, i) {
                                  @given-below-succ-q |
                                    assume less_than(i, succ(q)) {
                                      @above-q |
                                        less_than(q, i)
                                        [by hypothesis given-above-q]
                                      @below-succ-q |
                                        less_than(i, succ(q))
                                        [by hypothesis given-below-succ-q]
                                      @at-most-q |
                                        less_than(i, q) or i = q
                                        [using specialize peano_order.lessThanSuccSplit(i, q) below-succ-q]
                                      @q-below-q |
                                        less_than(q, q)
                                        [using tautology at-most-q above-q q-transitive q-self]
                                      @q-transitive |
                                        less_than(q, i) -> less_than(i, q) -> less_than(q, q)
                                        [using specialize transitivityAsImplication(q, i, q)]
                                      @q-self |
                                        i = q -> less_than(q, q)
                                        [using specialize rewriteAboveIntoSelf(q, i) above-q]
                                      @not-q-below-q |
                                        not less_than(q, q)
                                        [using specialize peano_order.lessThanIrreflexive(q)]
                                      @conclusion-vacuously |
                                        apply(at(s, i), a) = a
                                        [using tautology q-below-q not-q-below-q]
                                    }
                                  @below-implies |
                                    less_than(i, succ(q)) -> apply(at(s, i), a) = a
                                    [by discharge given-below-succ-q]
                                }
                              @above-implies |
                                less_than(q, i) -> less_than(i, succ(q)) -> apply(at(s, i), a) = a
                                [by discharge given-above-q]
                            }
                          @q-below-succ-q |
                            less_than(q, succ(q))
                            [using specialize natLessThanSelf(q)]
                          @all-facts |
                            allTranspositions(s, succ(q)) and productUpTo(s, succ(q)) = identityFn and apply(at(s, q), a) != a and (forall i: Nat; less_than(q, i) -> less_than(i, succ(q)) -> apply(at(s, i), a) = a) and less_than(q, succ(q))
                            [using tautology all-transpositions is-identity top-moves-a nothing-above q-below-succ-q]
                          @conclusion-invariant |
                            loopInvariant(a, q, succ(q))
                            [by witness(s) all-facts]
                        }
                      @moves-implies |
                        apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
                        [by discharge given-moves]
                    }
                  @identity-implies |
                    productUpTo(s, succ(q)) = identityFn -> apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
                    [by discharge given-identity]
                }
              @all-implies |
                allTranspositions(s, succ(q)) -> productUpTo(s, succ(q)) = identityFn -> apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
                [by discharge given-all]
            }
          @discharge-q |
            forall q: Nat; allTranspositions(s, succ(q)) -> productUpTo(s, succ(q)) = identityFn -> apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
            [by generalize generalize-q]
        }
      @discharge-s |
        forall s: Seq; forall q: Nat; allTranspositions(s, succ(q)) -> productUpTo(s, succ(q)) = identityFn -> apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
        [by generalize generalize-s]
    }
  @conclusion |
    forall a: Element; forall s: Seq; forall q: Nat; allTranspositions(s, succ(q)) -> productUpTo(s, succ(q)) = identityFn -> apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
    [by generalize generalize-a]
qed

theorem transitivityAsImplication = peano_order.lessThanTransitive

// q < i and i = q give q < q — a rewrite, packaged as the implication `tautology` needs
// (it cannot see that an equation relates two of its atoms).
theorem rewriteAboveIntoSelf: forall q: Nat; forall i: Nat; less_than(q, i) -> (i = q -> less_than(q, q))
proof
  @generalize-q |
    fix q: Nat {
      @generalize-i |
        fix i: Nat {
          @given-above |
            assume less_than(q, i) {
              @above |
                less_than(q, i)
                [by hypothesis given-above]
              @given-equal |
                assume i = q {
                  @equal |
                    i = q
                    [by hypothesis given-equal]
                  @conclusion-self |
                    less_than(q, q)
                    [by rewrite equal above]
                }
              @equal-implies |
                i = q -> less_than(q, q)
                [by discharge given-equal]
            }
          @above-implies |
            less_than(q, i) -> (i = q -> less_than(q, q))
            [by discharge given-above]
        }
      @discharge-i |
        forall i: Nat; less_than(q, i) -> (i = q -> less_than(q, q))
        [by generalize generalize-i]
    }
  @conclusion |
    forall q: Nat; forall i: Nat; less_than(q, i) -> (i = q -> less_than(q, q))
    [by generalize generalize-q]
qed

// NOTE on a hole that turned out to be unnecessary. I first stated a separate `loopDescends`
// for the loop BODY (invariant at succ(j) gives either the drop or the invariant at j). Nothing
// cites it: `loopTerminates` below is the descent AND its termination in one statement, and its
// proof will do the body inline. The checker did not complain — an uncited hole is simply not a
// hole anyone depends on — so it was removed by hand. Worth knowing: holes are disclosed by what
// DEPENDS on them, which means a stub you never wire up is invisible rather than flagged.

// A length above succ(j) decomposes as (j+2)+e — the form the surgery states its product
// equality in. Straight from lessThanElim's gap.
theorem lengthDecomposesAboveThePair: forall j: Nat; forall r: Nat;
  less_than(succ(j), r) -> exists e: Nat; r = add(succ(succ(j)), e)
proof
  @generalize-j |
    fix j: Nat {
      @generalize-r |
        fix r: Nat {
          @given-above |
            assume less_than(succ(j), r) {
              @above |
                less_than(succ(j), r)
                [by hypothesis given-above]
              @gap-exists |
                exists g: Nat; add(succ(j), succ(g)) = r
                [using specialize peano_order.lessThanElim(succ(j), r) above]
              @with-gap |
                unpack g: Nat from gap-exists {
                  @gap |
                    add(succ(j), succ(g)) = r
                    [by hypothesis with-gap]
                  // (j+1) + (g+1) = (j+2) + g
                  @shift-the-successor |
                    add(succ(j), succ(g)) = succ(add(succ(j), g))
                    [using specialize peano.addSuccRight(succ(j), g)]
                  @peel-the-left |
                    add(succ(succ(j)), g) = succ(add(succ(j), g))
                    [using specialize peano.addSuccLeft(succ(j), g)]
                  @same-value |
                    add(succ(j), succ(g)) = add(succ(succ(j)), g)
                    [using chain shift-the-successor peel-the-left-flipped]
                  @peel-the-left-flipped |
                    succ(add(succ(j), g)) = add(succ(succ(j)), g)
                    [by symmetry peel-the-left]
                  @r-is-the-sum |
                    r = add(succ(succ(j)), g)
                    [using chain gap-flipped same-value]
                  @gap-flipped |
                    r = add(succ(j), succ(g))
                    [by symmetry gap]
                  @conclusion-witnessed |
                    exists e: Nat; r = add(succ(succ(j)), e)
                    [by witness(g) r-is-the-sum]
                }
              @conclusion-decomposes |
                exists e: Nat; r = add(succ(succ(j)), e)
                [by unpacked with-gap]
            }
          @above-implies |
            less_than(succ(j), r) -> exists e: Nat; r = add(succ(succ(j)), e)
            [by discharge given-above]
        }
      @discharge-r |
        forall r: Nat; less_than(succ(j), r) -> exists e: Nat; r = add(succ(succ(j)), e)
        [by generalize generalize-r]
    }
  @conclusion |
    forall j: Nat; forall r: Nat; less_than(succ(j), r) -> exists e: Nat; r = add(succ(succ(j)), e)
    [by generalize generalize-j]
qed

// -- DELETING the cancelling pair ------------------------------------------------------------
// The cancel branch needs a sequence of length r − 2. Deleting positions (j, j+1) gives one,
// and — following this layer's idiom, where a sequence postulate carries its own product law
// (compare `seqConcat`, `seqReverse` in std/permutation/sequence.b4m) — the postulate states
// the product directly rather than leaving a fold argument to the caller. Sound because the
// deleted pair composes to the identity, so it contributes nothing to the fold.
axiom seqDeleteCancellingPair: forall s: Seq; forall j: Nat; forall e: Nat;
  compose(at(s, j), at(s, succ(j))) = identityFn ->
  exists v: Seq;
  (forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i))
  and (forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i)))
  and productUpTo(v, add(j, e)) = productUpTo(s, add(succ(succ(j)), e))

// Its entries are all transpositions when `s`'s are: every entry is copied from `s`, either
// from below j or from two positions further up.
theorem deletedSequenceIsAllTranspositions: forall s: Seq; forall v: Seq; forall j: Nat; forall n: Nat; forall e: Nat;
  allTranspositions(s, add(succ(succ(j)), e)) ->
  (forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i)) ->
  (forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i))) ->
  n = add(j, e) ->
  allTranspositions(v, n)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-v |
        fix v: Seq {
          @generalize-j |
            fix j: Nat {
              @generalize-n |
                fix n: Nat {
                  @generalize-e |
                    fix e: Nat {
                      @given-all |
                        assume allTranspositions(s, add(succ(succ(j)), e)) {
                          @given-below |
                            assume forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i) {
                              @given-tail |
                                assume forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i)) {
                                  @given-length |
                                    assume n = add(j, e) {
                                      @s-all |
                                        allTranspositions(s, add(succ(succ(j)), e))
                                        [by hypothesis given-all]
                                      @v-below |
                                        forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i)
                                        [by hypothesis given-below]
                                      @v-tail |
                                        forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i))
                                        [by hypothesis given-tail]
                                      @length |
                                        n = add(j, e)
                                        [by hypothesis given-length]
                                      @generalize-i |
                                        fix i: Nat {
                                          @given-below-n |
                                            assume less_than(i, n) {
                                              @i-below-n |
                                                less_than(i, n)
                                                [by hypothesis given-below-n]
                                              @i-below-sum |
                                                less_than(i, add(j, e))
                                                [by rewrite length i-below-n]
                                              @i-position |
                                                less_than(i, j) or (exists g: Nat; i = add(j, g) and less_than(g, e))
                                                [using specialize splitBelowASum(i, j, e) i-below-sum]
                                              @conclusion-i-is-a-transposition |
                                                isTransposition(at(v, i))
                                                case i-position {
                                                  @when-below |
                                                    assume less_than(i, j) {
                                                      @below |
                                                        less_than(i, j)
                                                        [by hypothesis when-below]
                                                      @copied |
                                                        at(v, i) = at(s, i)
                                                        [using specialize v-below(i) below]
                                                      @i-below-the-length |
                                                        less_than(i, add(succ(succ(j)), e))
                                                        [using specialize belowJIsBelowTheLength(i, j, e) below]
                                                      @s-at-i |
                                                        isTransposition(at(s, i))
                                                        [using specialize s-all(i) i-below-the-length]
                                                      @conclusion-below |
                                                        isTransposition(at(v, i))
                                                        [by rewrite copied s-at-i]
                                                    }
                                                  @when-in-the-tail |
                                                    assume exists g: Nat; i = add(j, g) and less_than(g, e) {
                                                      @tail-index-exists |
                                                        exists g: Nat; i = add(j, g) and less_than(g, e)
                                                        [by hypothesis when-in-the-tail]
                                                      @with-tail-index |
                                                        unpack g: Nat from tail-index-exists {
                                                          @g-facts |
                                                            i = add(j, g) and less_than(g, e)
                                                            [by hypothesis with-tail-index]
                                                          @i-is-shifted |
                                                            i = add(j, g)
                                                            [by and_lhs g-facts]
                                                          @g-below-e |
                                                            less_than(g, e)
                                                            [by and_rhs g-facts]
                                                          @copied-from-the-tail |
                                                            at(v, add(j, g)) = at(s, add(succ(succ(j)), g))
                                                            [using specialize v-tail(g)]
                                                          @source-below-the-length |
                                                            less_than(add(succ(succ(j)), g), add(succ(succ(j)), e))
                                                            [using specialize additionPreservesOrderOnTheRight(g, e, succ(succ(j))) g-below-e]
                                                          @s-at-the-source |
                                                            isTransposition(at(s, add(succ(succ(j)), g)))
                                                            [using specialize s-all(add(succ(succ(j)), g)) source-below-the-length]
                                                          @v-at-shifted |
                                                            isTransposition(at(v, add(j, g)))
                                                            [by rewrite copied-from-the-tail s-at-the-source]
                                                          @conclusion-in-the-tail-inner |
                                                            isTransposition(at(v, i))
                                                            [by rewrite i-is-shifted v-at-shifted]
                                                        }
                                                      @conclusion-in-the-tail |
                                                        isTransposition(at(v, i))
                                                        [by unpacked with-tail-index]
                                                    }
                                                }
                                            }
                                          @below-n-implies |
                                            less_than(i, n) -> isTransposition(at(v, i))
                                            [by discharge given-below-n]
                                        }
                                      @conclusion-v-all |
                                        allTranspositions(v, n)
                                        [by generalize generalize-i]
                                    }
                                  @length-implies |
                                    n = add(j, e) -> allTranspositions(v, n)
                                    [by discharge given-length]
                                }
                              @tail-implies |
                                (forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i))) -> n = add(j, e) -> allTranspositions(v, n)
                                [by discharge given-tail]
                            }
                          @below-implies |
                            (forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i))) -> n = add(j, e) -> allTranspositions(v, n)
                            [by discharge given-below]
                        }
                      @all-implies |
                        allTranspositions(s, add(succ(succ(j)), e)) -> (forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i))) -> n = add(j, e) -> allTranspositions(v, n)
                        [by discharge given-all]
                    }
                  @discharge-e |
                    forall e: Nat; allTranspositions(s, add(succ(succ(j)), e)) -> (forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i))) -> n = add(j, e) -> allTranspositions(v, n)
                    [by generalize generalize-e]
                }
              @discharge-n |
                forall n: Nat; forall e: Nat; allTranspositions(s, add(succ(succ(j)), e)) -> (forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i))) -> n = add(j, e) -> allTranspositions(v, n)
                [by generalize generalize-n]
            }
          @discharge-j |
            forall j: Nat; forall n: Nat; forall e: Nat; allTranspositions(s, add(succ(succ(j)), e)) -> (forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i))) -> n = add(j, e) -> allTranspositions(v, n)
            [by generalize generalize-j]
        }
      @discharge-v |
        forall v: Seq; forall j: Nat; forall n: Nat; forall e: Nat; allTranspositions(s, add(succ(succ(j)), e)) -> (forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i))) -> n = add(j, e) -> allTranspositions(v, n)
        [by generalize generalize-v]
    }
  @conclusion |
    forall s: Seq; forall v: Seq; forall j: Nat; forall n: Nat; forall e: Nat; allTranspositions(s, add(succ(succ(j)), e)) -> (forall i: Nat; less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, add(j, i)) = at(s, add(succ(succ(j)), i))) -> n = add(j, e) -> allTranspositions(v, n)
    [by generalize generalize-s]
qed

theorem additionPreservesOrderOnTheRight = peano_order.additionPreservesOrder

// i < j gives i < (j+2)+e: j <= j+2 <= (j+2)+e.
theorem belowJIsBelowTheLength: forall i: Nat; forall j: Nat; forall e: Nat; less_than(i, j) -> less_than(i, add(succ(succ(j)), e))
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @generalize-e |
            fix e: Nat {
              @given-below |
                assume less_than(i, j) {
                  @below |
                    less_than(i, j)
                    [by hypothesis given-below]
                  @j-below-succ |
                    less_than(j, succ(j))
                    [using specialize natLessThanSelf(j)]
                  @j-below-two-more |
                    less_than(j, succ(succ(j)))
                    [using specialize peano_order.lessThanSuccRight(j, succ(j)) j-below-succ]
                  @i-below-two-more |
                    less_than(i, succ(succ(j)))
                    [using specialize peano_order.lessThanTransitive(i, j, succ(succ(j))) below j-below-two-more]
                  @bound-at-every-overshoot |
                    forall e2: Nat; less_than(i, add(succ(succ(j)), e2))
                    [using specialize weakLeftBound(i, succ(succ(j))) i-below-two-more]
                  @conclusion-below-the-length |
                    less_than(i, add(succ(succ(j)), e))
                    [using specialize bound-at-every-overshoot(e)]
                }
              @below-implies |
                less_than(i, j) -> less_than(i, add(succ(succ(j)), e))
                [by discharge given-below]
            }
          @discharge-e |
            forall e: Nat; less_than(i, j) -> less_than(i, add(succ(succ(j)), e))
            [by generalize generalize-e]
        }
      @discharge-j |
        forall j: Nat; forall e: Nat; less_than(i, j) -> less_than(i, add(succ(succ(j)), e))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; forall e: Nat; less_than(i, j) -> less_than(i, add(succ(succ(j)), e))
    [by generalize generalize-i]
qed

// An index below j+e is either below j, or is j+g for some g below e. Trichotomy splits at j;
// on the upper side `lessOrEqualIsGapExistential` names the gap, and cancelling j off the
// original bound puts the gap below e.
theorem splitBelowASum: forall i: Nat; forall j: Nat; forall e: Nat; less_than(i, add(j, e)) -> (less_than(i, j) or (exists g: Nat; i = add(j, g) and less_than(g, e)))
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @generalize-e |
            fix e: Nat {
              @given-below-sum |
                assume less_than(i, add(j, e)) {
                  @below-sum |
                    less_than(i, add(j, e))
                    [by hypothesis given-below-sum]
                  @split-at-j |
                    less_than(i, j) or i = j or less_than(j, i)
                    [using specialize peano_order.trichotomy(i, j)]
                  @conclusion-split |
                    less_than(i, j) or (exists g: Nat; i = add(j, g) and less_than(g, e))
                    case split-at-j {
                      @when-below-j |
                        assume less_than(i, j) {
                          @below-j |
                            less_than(i, j)
                            [by hypothesis when-below-j]
                          @conclusion-below |
                            less_than(i, j) or (exists g: Nat; i = add(j, g) and less_than(g, e))
                            [by either_left below-j]
                        }
                      @when-equal |
                        assume i = j {
                          @equal |
                            i = j
                            [by hypothesis when-equal]
                          // i = j = j + 0, and 0 < e because i < j+e forces e positive.
                          @j-plus-zero |
                            add(j, ZERO) = j
                            [using specialize peano.addZeroRight(j)]
                          @j-is-j-plus-zero |
                            j = add(j, ZERO)
                            [by symmetry j-plus-zero]
                          @i-is-j-plus-zero |
                            i = add(j, ZERO)
                            [using chain equal j-is-j-plus-zero]
                          @zero-below-e |
                            less_than(ZERO, e)
                            [using specialize overshootIsPositive(i, j, e) below-sum equal]
                          @witnessed |
                            i = add(j, ZERO) and less_than(ZERO, e)
                            [by both i-is-j-plus-zero zero-below-e]
                          @gap-exists |
                            exists g: Nat; i = add(j, g) and less_than(g, e)
                            [by witness(ZERO) witnessed]
                          @conclusion-equal |
                            less_than(i, j) or (exists g: Nat; i = add(j, g) and less_than(g, e))
                            [by either_right gap-exists]
                        }
                      @when-above-j |
                        assume less_than(j, i) {
                          @above-j |
                            less_than(j, i)
                            [by hypothesis when-above-j]
                          @gap-to-i-exists |
                            exists g: Nat; add(j, succ(g)) = i
                            [using specialize peano_order.lessThanElim(j, i) above-j]
                          @with-gap |
                            unpack g: Nat from gap-to-i-exists {
                              @gap |
                                add(j, succ(g)) = i
                                [by hypothesis with-gap]
                              @i-is-shifted |
                                i = add(j, succ(g))
                                [by symmetry gap]
                              // j + succ(g) < j + e cancels to succ(g) < e.
                              @shifted-below-sum |
                                less_than(add(j, succ(g)), add(j, e))
                                [by rewrite i-is-shifted below-sum]
                              @overshoot-below-e |
                                less_than(succ(g), e)
                                [using specialize peano_order.lessThanAddCancelLeft(j, succ(g), e) shifted-below-sum]
                              @witnessed |
                                i = add(j, succ(g)) and less_than(succ(g), e)
                                [by both i-is-shifted overshoot-below-e]
                              @gap-witnessed |
                                exists g2: Nat; i = add(j, g2) and less_than(g2, e)
                                [by witness(succ(g)) witnessed]
                              @conclusion-above-inner |
                                less_than(i, j) or (exists g2: Nat; i = add(j, g2) and less_than(g2, e))
                                [by either_right gap-witnessed]
                            }
                          @conclusion-above |
                            less_than(i, j) or (exists g: Nat; i = add(j, g) and less_than(g, e))
                            [by unpacked with-gap]
                        }
                    }
                }
              @below-sum-implies |
                less_than(i, add(j, e)) -> (less_than(i, j) or (exists g: Nat; i = add(j, g) and less_than(g, e)))
                [by discharge given-below-sum]
            }
          @discharge-e |
            forall e: Nat; less_than(i, add(j, e)) -> (less_than(i, j) or (exists g: Nat; i = add(j, g) and less_than(g, e)))
            [by generalize generalize-e]
        }
      @discharge-j |
        forall j: Nat; forall e: Nat; less_than(i, add(j, e)) -> (less_than(i, j) or (exists g: Nat; i = add(j, g) and less_than(g, e)))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; forall e: Nat; less_than(i, add(j, e)) -> (less_than(i, j) or (exists g: Nat; i = add(j, g) and less_than(g, e)))
    [by generalize generalize-i]
qed

// i = j and i < j+e force 0 < e: were e ZERO, j+e would be j and j < j.
theorem overshootIsPositive: forall i: Nat; forall j: Nat; forall e: Nat; less_than(i, add(j, e)) -> i = j -> less_than(ZERO, e)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @generalize-e |
            fix e: Nat {
              @given-below |
                assume less_than(i, add(j, e)) {
                  @given-equal |
                    assume i = j {
                      @below |
                        less_than(i, add(j, e))
                        [by hypothesis given-below]
                      @equal |
                        i = j
                        [by hypothesis given-equal]
                      @j-below-sum |
                        less_than(j, add(j, e))
                        [by rewrite equal below]
                      @e-shape |
                        e = ZERO or less_than(ZERO, e)
                        [using specialize zeroOrPositive(e)]
                      @conclusion-positive |
                        less_than(ZERO, e)
                        case e-shape {
                          @when-zero |
                            assume e = ZERO {
                              @e-is-zero |
                                e = ZERO
                                [by hypothesis when-zero]
                              @j-plus-zero |
                                add(j, ZERO) = j
                                [using specialize peano.addZeroRight(j)]
                              @j-below-j-plus-zero |
                                less_than(j, add(j, ZERO))
                                [by rewrite e-is-zero j-below-sum]
                              @j-below-itself |
                                less_than(j, j)
                                [by rewrite j-plus-zero j-below-j-plus-zero]
                              @not-below-itself |
                                not less_than(j, j)
                                [using specialize peano_order.lessThanIrreflexive(j)]
                              @conclusion-ex_falso |
                                less_than(ZERO, e)
                                [using tautology j-below-itself not-below-itself]
                            }
                          @when-positive |
                            assume less_than(ZERO, e) {
                              @conclusion-directly |
                                less_than(ZERO, e)
                                [by hypothesis when-positive]
                            }
                        }
                    }
                  @equal-implies |
                    i = j -> less_than(ZERO, e)
                    [by discharge given-equal]
                }
              @below-implies |
                less_than(i, add(j, e)) -> i = j -> less_than(ZERO, e)
                [by discharge given-below]
            }
          @discharge-e |
            forall e: Nat; less_than(i, add(j, e)) -> i = j -> less_than(ZERO, e)
            [by generalize generalize-e]
        }
      @discharge-j |
        forall j: Nat; forall e: Nat; less_than(i, add(j, e)) -> i = j -> less_than(ZERO, e)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; forall e: Nat; less_than(i, add(j, e)) -> i = j -> less_than(ZERO, e)
    [by generalize generalize-i]
qed

// A transposition that MOVES `a` can be written with `a` FIRST — which is the form the
// classification demands of its right factor. `a` is one of the two letters
// (movedBySwapIsOneOfItsLetters); if it is the second, transpositionIsSymmetric swaps them.
theorem movingTranspositionWithTheLetterFirst: forall t: Fn; forall a: Element;
  isTransposition(t) -> apply(t, a) != a ->
  (exists b: Element; a != b and t = transposition(a, b))
proof
  @generalize-t |
    fix t: Fn {
      @generalize-a |
        fix a: Element {
          @given-transposition |
            assume isTransposition(t) {
              @given-moves |
                assume apply(t, a) != a {
                  @is-a-transposition |
                    isTransposition(t)
                    [by hypothesis given-transposition]
                  @moves-a |
                    apply(t, a) != a
                    [by hypothesis given-moves]
                  @letters-exist |
                    exists x: Element; exists y: Element; x != y and t = transposition(x, y)
                    [using tautology is-a-transposition]
                  @with-first |
                    unpack x: Element from letters-exist {
                      @second-exists |
                        exists y: Element; x != y and t = transposition(x, y)
                        [by hypothesis with-first]
                      @with-second |
                        unpack y: Element from second-exists {
                          @facts |
                            x != y and t = transposition(x, y)
                            [by hypothesis with-second]
                          @xy |
                            x != y
                            [by and_lhs facts]
                          @t-is-the-swap |
                            t = transposition(x, y)
                            [by and_rhs facts]
                          @swap-moves-a |
                            apply(transposition(x, y), a) != a
                            [by rewrite t-is-the-swap moves-a]
                          @a-is-a-letter |
                            a = x or a = y
                            [using specialize movedBySwapIsOneOfItsLetters(x, y, a) swap-moves-a]
                          @conclusion-normalized |
                            exists b: Element; a != b and t = transposition(a, b)
                            case a-is-a-letter {
                              @when-a-is-x |
                                assume a = x {
                                  @a-is-x |
                                    a = x
                                    [by hypothesis when-a-is-x]
                                  @distinct-at-a |
                                    a != y
                                    [by rewrite a-is-x xy]
                                  @swap-at-a |
                                    t = transposition(a, y)
                                    [by rewrite a-is-x t-is-the-swap]
                                  @witnessed |
                                    a != y and t = transposition(a, y)
                                    [by both distinct-at-a swap-at-a]
                                  @conclusion-a-first |
                                    exists b: Element; a != b and t = transposition(a, b)
                                    [by witness(y) witnessed]
                                }
                              @when-a-is-y |
                                assume a = y {
                                  @a-is-y |
                                    a = y
                                    [by hypothesis when-a-is-y]
                                  // t = (x y) = (y x) = (a x), and x != a.
                                  @reversed |
                                    transposition(x, y) = transposition(y, x)
                                    [using specialize transpositionIsSymmetric(x, y)]
                                  @t-reversed |
                                    t = transposition(y, x)
                                    [using chain t-is-the-swap reversed]
                                  @t-at-a |
                                    t = transposition(a, x)
                                    [by rewrite a-is-y t-reversed]
                                  @y-not-x |
                                    y != x
                                    [using specialize distinctSymmetric(x, y) xy]
                                  @distinct-at-a |
                                    a != x
                                    [by rewrite a-is-y y-not-x]
                                  @witnessed |
                                    a != x and t = transposition(a, x)
                                    [by both distinct-at-a t-at-a]
                                  @conclusion-a-first |
                                    exists b: Element; a != b and t = transposition(a, b)
                                    [by witness(x) witnessed]
                                }
                            }
                        }
                      @conclusion-second |
                        exists b: Element; a != b and t = transposition(a, b)
                        [by unpacked with-second]
                    }
                  @conclusion-normalized-outer |
                    exists b: Element; a != b and t = transposition(a, b)
                    [by unpacked with-first]
                }
              @moves-implies |
                apply(t, a) != a -> (exists b: Element; a != b and t = transposition(a, b))
                [by discharge given-moves]
            }
          @transposition-implies |
            isTransposition(t) -> apply(t, a) != a -> (exists b: Element; a != b and t = transposition(a, b))
            [by discharge given-transposition]
        }
      @discharge-a |
        forall a: Element; isTransposition(t) -> apply(t, a) != a -> (exists b: Element; a != b and t = transposition(a, b))
        [by generalize generalize-a]
    }
  @conclusion |
    forall t: Fn; forall a: Element; isTransposition(t) -> apply(t, a) != a -> (exists b: Element; a != b and t = transposition(a, b))
    [by generalize generalize-t]
qed

// -- the CANCEL branch, on its own ------------------------------------------------------------
// The pair at (j, j+1) composes to the identity: delete it. The shortened sequence has length
// (m+d), is all transpositions, and its product is the original's — the identity.
theorem cancelBranchDropsTwo: forall w: Seq; forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat;
  allTranspositions(w, add(succ(succ(m)), d)) ->
  productUpTo(w, add(succ(succ(m)), d)) = identityFn ->
  add(succ(succ(m)), d) = add(succ(succ(j)), e) ->
  add(m, d) = add(j, e) ->
  compose(at(w, j), at(w, succ(j))) = identityFn ->
  someProductOfLengthIsIdentity(add(m, d))
proof
  @generalize-w |
    fix w: Seq {
      @generalize-j |
        fix j: Nat {
          @generalize-m |
            fix m: Nat {
              @generalize-d |
                fix d: Nat {
                  @generalize-e |
                    fix e: Nat {
                      @given-all |
                        assume allTranspositions(w, add(succ(succ(m)), d)) {
                          @given-identity |
                            assume productUpTo(w, add(succ(succ(m)), d)) = identityFn {
                              @given-length |
                                assume add(succ(succ(m)), d) = add(succ(succ(j)), e) {
                                  @given-short |
                                    assume add(m, d) = add(j, e) {
                                      @given-cancels |
                                        assume compose(at(w, j), at(w, succ(j))) = identityFn {
                                          @w-all |
                                            allTranspositions(w, add(succ(succ(m)), d))
                                            [by hypothesis given-all]
                                          @w-identity |
                                            productUpTo(w, add(succ(succ(m)), d)) = identityFn
                                            [by hypothesis given-identity]
                                          @length-form |
                                            add(succ(succ(m)), d) = add(succ(succ(j)), e)
                                            [by hypothesis given-length]
                                          @short-form |
                                            add(m, d) = add(j, e)
                                            [by hypothesis given-short]
                                          @cancels |
                                            compose(at(w, j), at(w, succ(j))) = identityFn
                                            [by hypothesis given-cancels]
                                          @w-all-at-form |
                                            allTranspositions(w, add(succ(succ(j)), e))
                                            [by rewrite length-form w-all]
                                          @w-identity-at-form |
                                            productUpTo(w, add(succ(succ(j)), e)) = identityFn
                                            [by rewrite length-form w-identity]
                                          @deleted-exists |
                                            exists v: Seq; (forall i: Nat; less_than(i, j) -> at(v, i) = at(w, i)) and (forall i: Nat; at(v, add(j, i)) = at(w, add(succ(succ(j)), i))) and productUpTo(v, add(j, e)) = productUpTo(w, add(succ(succ(j)), e))
                                            [using specialize seqDeleteCancellingPair(w, j, e) cancels]
                                          @with-deleted |
                                            unpack v: Seq from deleted-exists {
                                              @v-facts |
                                                (forall i: Nat; less_than(i, j) -> at(v, i) = at(w, i)) and (forall i: Nat; at(v, add(j, i)) = at(w, add(succ(succ(j)), i))) and productUpTo(v, add(j, e)) = productUpTo(w, add(succ(succ(j)), e))
                                                [by hypothesis with-deleted]
                                              @v-below |
                                                forall i: Nat; less_than(i, j) -> at(v, i) = at(w, i)
                                                [using tautology v-facts]
                                              @v-tail |
                                                forall i: Nat; at(v, add(j, i)) = at(w, add(succ(succ(j)), i))
                                                [using tautology v-facts]
                                              @v-product |
                                                productUpTo(v, add(j, e)) = productUpTo(w, add(succ(succ(j)), e))
                                                [using tautology v-facts]
                                              @v-product-is-identity |
                                                productUpTo(v, add(j, e)) = identityFn
                                                [using chain v-product w-identity-at-form]
                                              @v-product-at-short |
                                                productUpTo(v, add(m, d)) = identityFn
                                                [by rewrite short-form v-product-is-identity]
                                              @v-all |
                                                allTranspositions(v, add(m, d))
                                                [using specialize deletedSequenceIsAllTranspositions(w, v, j, add(m, d), e) w-all-at-form v-below v-tail short-form]
                                              @witnessed |
                                                allTranspositions(v, add(m, d)) and productUpTo(v, add(m, d)) = identityFn
                                                [by both v-all v-product-at-short]
                                              @conclusion-shorter-inner |
                                                someProductOfLengthIsIdentity(add(m, d))
                                                [by witness(v) witnessed]
                                            }
                                          @conclusion-shorter |
                                            someProductOfLengthIsIdentity(add(m, d))
                                            [by unpacked with-deleted]
                                        }
                                      @cancels-implies |
                                        compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(add(m, d))
                                        [by discharge given-cancels]
                                    }
                                  @short-implies |
                                    add(m, d) = add(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(add(m, d))
                                    [by discharge given-short]
                                }
                              @length-implies |
                                add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(add(m, d))
                                [by discharge given-length]
                            }
                          @identity-implies |
                            productUpTo(w, add(succ(succ(m)), d)) = identityFn -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(add(m, d))
                            [by discharge given-identity]
                        }
                      @all-implies |
                        allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(add(m, d))
                        [by discharge given-all]
                    }
                  @discharge-e |
                    forall e: Nat; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(add(m, d))
                    [by generalize generalize-e]
                }
              @discharge-d |
                forall d: Nat; forall e: Nat; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(add(m, d))
                [by generalize generalize-d]
            }
          @discharge-m |
            forall m: Nat; forall d: Nat; forall e: Nat; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(add(m, d))
            [by generalize generalize-m]
        }
      @discharge-j |
        forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(add(m, d))
        [by generalize generalize-j]
    }
  @conclusion |
    forall w: Seq; forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(add(m, d))
    [by generalize generalize-w]
qed

// -- the SHIFT branch, on its own -------------------------------------------------------------
// The pair at (j, j+1) equals (p, q) with q FIXING `a` and p MOVING it. Rewrite it in place:
// the product is unchanged (still the identity), entries outside {j, j+1} are untouched (so
// everything above j+1 still fixes `a`), position j+1 now holds q which fixes `a`, and
// position j holds p which moves it. That is exactly the invariant at j.
theorem shiftBranchKeepsTheInvariant: forall w: Seq; forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
proof
  @generalize-w |
    fix w: Seq {
      @generalize-a |
        fix a: Element {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @generalize-d |
                    fix d: Nat {
                      @generalize-e |
                        fix e: Nat {
                          @generalize-p |
                            fix p: Fn {
                              @generalize-q |
                                fix q: Fn {
                                  @given-all |
                                    assume allTranspositions(w, add(succ(succ(m)), d)) {
                                      @given-identity |
                                        assume productUpTo(w, add(succ(succ(m)), d)) = identityFn {
                                          @given-above |
                                            assume forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a {
                                              @given-length |
                                                assume add(succ(succ(m)), d) = add(succ(succ(j)), e) {
                                                  @given-p-trans |
                                                    assume isTransposition(p) {
                                                      @given-q-trans |
                                                        assume isTransposition(q) {
                                                          @given-pair |
                                                            assume compose(p, q) = compose(at(w, j), at(w, succ(j))) {
                                                              @given-q-fixes |
                                                                assume apply(q, a) = a {
                                                                  @given-p-moves |
                                                                    assume apply(p, a) != a {
                                                                      @all |
                                                                        allTranspositions(w, add(succ(succ(m)), d))
                                                                        [by hypothesis given-all]
                                                                      @identity |
                                                                        productUpTo(w, add(succ(succ(m)), d)) = identityFn
                                                                        [by hypothesis given-identity]
                                                                      @above |
                                                                        forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a
                                                                        [by hypothesis given-above]
                                                                      @length |
                                                                        add(succ(succ(m)), d) = add(succ(succ(j)), e)
                                                                        [by hypothesis given-length]
                                                                      @p-trans |
                                                                        isTransposition(p)
                                                                        [by hypothesis given-p-trans]
                                                                      @q-trans |
                                                                        isTransposition(q)
                                                                        [by hypothesis given-q-trans]
                                                                      @pair |
                                                                        compose(p, q) = compose(at(w, j), at(w, succ(j)))
                                                                        [by hypothesis given-pair]
                                                                      @q-fixes |
                                                                        apply(q, a) = a
                                                                        [by hypothesis given-q-fixes]
                                                                      @p-moves |
                                                                        apply(p, a) != a
                                                                        [by hypothesis given-p-moves]
                                                                      @p-invertible |
                                                                        invertible(p)
                                                                        [using specialize transpositionsAreInvertible(p) p-trans]
                                                                      @q-invertible |
                                                                        invertible(q)
                                                                        [using specialize transpositionsAreInvertible(q) q-trans]
                                                                      @rewritten-exists |
                                                                        exists u: Seq; at(u, j) = p and at(u, succ(j)) = q and (forall i: Nat; less_than(i, j) -> at(u, i) = at(w, i)) and (forall i: Nat; less_than(succ(j), i) -> at(u, i) = at(w, i)) and productUpTo(u, add(succ(succ(j)), e)) = productUpTo(w, add(succ(succ(j)), e))
                                                                        [using specialize rewritingAPairKeepsTheWholeProduct(w, j, e, p, q) p-invertible q-invertible pair]
                                                                      @with-rewritten |
                                                                        unpack u: Seq from rewritten-exists {
                                                                          @u-facts |
                                                                            at(u, j) = p and at(u, succ(j)) = q and (forall i: Nat; less_than(i, j) -> at(u, i) = at(w, i)) and (forall i: Nat; less_than(succ(j), i) -> at(u, i) = at(w, i)) and productUpTo(u, add(succ(succ(j)), e)) = productUpTo(w, add(succ(succ(j)), e))
                                                                            [by hypothesis with-rewritten]
                                                                          @u-at-j |
                                                                            at(u, j) = p
                                                                            [using tautology u-facts]
                                                                          @u-at-succ-j |
                                                                            at(u, succ(j)) = q
                                                                            [using tautology u-facts]
                                                                          @u-below |
                                                                            forall i: Nat; less_than(i, j) -> at(u, i) = at(w, i)
                                                                            [using tautology u-facts]
                                                                          @u-above |
                                                                            forall i: Nat; less_than(succ(j), i) -> at(u, i) = at(w, i)
                                                                            [using tautology u-facts]
                                                                          @u-product |
                                                                            productUpTo(u, add(succ(succ(j)), e)) = productUpTo(w, add(succ(succ(j)), e))
                                                                            [using tautology u-facts]
                                                                          @u-at-j-is-a-transposition |
                                                                            isTransposition(at(u, j))
                                                                            [by rewrite u-at-j p-trans]
                                                                          @u-at-succ-j-is-a-transposition |
                                                                            isTransposition(at(u, succ(j)))
                                                                            [by rewrite u-at-succ-j q-trans]
                                                                          @u-all |
                                                                            allTranspositions(u, add(succ(succ(m)), d))
                                                                            [using specialize rewrittenSequenceIsAllTranspositions(w, u, j, add(succ(succ(m)), d)) all u-at-j-is-a-transposition u-at-succ-j-is-a-transposition u-below u-above]
                                                                          @w-product-at-form |
                                                                            productUpTo(w, add(succ(succ(j)), e)) = identityFn
                                                                            [by rewrite length identity]
                                                                          @u-product-at-form |
                                                                            productUpTo(u, add(succ(succ(j)), e)) = identityFn
                                                                            [using chain u-product w-product-at-form]
                                                                          @u-product-at-the-length |
                                                                            productUpTo(u, add(succ(succ(m)), d)) = identityFn
                                                                            [by rewrite length u-product-at-form]
                                                                          @u-at-j-moves-a |
                                                                            apply(at(u, j), a) != a
                                                                            [by rewrite u-at-j p-moves]
                                                                          @u-above-fixes |
                                                                            forall i: Nat; less_than(j, i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(u, i), a) = a
                                                                            [by generalize above-j-fixes]
                                                                          @above-j-fixes |
                                                                            fix i: Nat {
                                                                              @given-above-j |
                                                                                assume less_than(j, i) {
                                                                                  @given-below-length |
                                                                                    assume less_than(i, add(succ(succ(m)), d)) {
                                                                                      @above-j |
                                                                                        less_than(j, i)
                                                                                        [by hypothesis given-above-j]
                                                                                      @below-length |
                                                                                        less_than(i, add(succ(succ(m)), d))
                                                                                        [by hypothesis given-below-length]
                                                                                      @position |
                                                                                        i = succ(j) or less_than(succ(j), i)
                                                                                        [using specialize successorSplit(j, i) above-j]
                                                                                      @conclusion-fixes |
                                                                                        apply(at(u, i), a) = a
                                                                                        case position {
                                                                                          @when-at-succ-j |
                                                                                            assume i = succ(j) {
                                                                                              @at-succ-j |
                                                                                                i = succ(j)
                                                                                                [by hypothesis when-at-succ-j]
                                                                                              @entry-is-q |
                                                                                                at(u, i) = q
                                                                                                [by rewrite at-succ-j u-at-succ-j]
                                                                                              @conclusion-q-fixes |
                                                                                                apply(at(u, i), a) = a
                                                                                                [by rewrite entry-is-q q-fixes]
                                                                                            }
                                                                                          @when-strictly-above |
                                                                                            assume less_than(succ(j), i) {
                                                                                              @strictly-above |
                                                                                                less_than(succ(j), i)
                                                                                                [by hypothesis when-strictly-above]
                                                                                              @copied |
                                                                                                at(u, i) = at(w, i)
                                                                                                [using specialize u-above(i) strictly-above]
                                                                                              @w-fixes |
                                                                                                apply(at(w, i), a) = a
                                                                                                [using specialize above(i) strictly-above below-length]
                                                                                              @conclusion-copied-fixes |
                                                                                                apply(at(u, i), a) = a
                                                                                                [by rewrite copied w-fixes]
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                  @below-implies |
                                                                                    less_than(i, add(succ(succ(m)), d)) -> apply(at(u, i), a) = a
                                                                                    [by discharge given-below-length]
                                                                                }
                                                                              @above-implies |
                                                                                less_than(j, i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(u, i), a) = a
                                                                                [by discharge given-above-j]
                                                                            }
                                                                          @j-below-succ-j |
                                                                            less_than(j, succ(j))
                                                                            [using specialize natLessThanSelf(j)]
                                                                          @succ-j-below-the-length |
                                                                            less_than(succ(j), add(succ(succ(m)), d))
                                                                            [by rewrite length succ-j-below-at-form]
                                                                          @succ-j-below-at-form |
                                                                            less_than(succ(j), add(succ(succ(j)), e))
                                                                            [using specialize succKIsBelowTheTail(j, e)]
                                                                          @j-below-the-length |
                                                                            less_than(j, add(succ(succ(m)), d))
                                                                            [using specialize peano_order.lessThanTransitive(j, succ(j), add(succ(succ(m)), d)) j-below-succ-j succ-j-below-the-length]
                                                                          @all-four |
                                                                            allTranspositions(u, add(succ(succ(m)), d)) and productUpTo(u, add(succ(succ(m)), d)) = identityFn and apply(at(u, j), a) != a and (forall i: Nat; less_than(j, i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(u, i), a) = a) and less_than(j, add(succ(succ(m)), d))
                                                                            [using tautology u-all u-product-at-the-length u-at-j-moves-a u-above-fixes j-below-the-length]
                                                                          @conclusion-invariant-inner |
                                                                            loopInvariant(a, j, add(succ(succ(m)), d))
                                                                            [by witness(u) all-four]
                                                                        }
                                                                      @conclusion-invariant |
                                                                        loopInvariant(a, j, add(succ(succ(m)), d))
                                                                        [by unpacked with-rewritten]
                                                                    }
                                                                  @p-moves-implies |
                                                                    apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                                                                    [by discharge given-p-moves]
                                                                }
                                                              @q-fixes-implies |
                                                                apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                                                                [by discharge given-q-fixes]
                                                            }
                                                          @pair-implies |
                                                            compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                                                            [by discharge given-pair]
                                                        }
                                                      @q-trans-implies |
                                                        isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                                                        [by discharge given-q-trans]
                                                    }
                                                  @p-trans-implies |
                                                    isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                                                    [by discharge given-p-trans]
                                                }
                                              @length-implies |
                                                add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                                                [by discharge given-length]
                                            }
                                          @above-implies |
                                            (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                                            [by discharge given-above]
                                        }
                                      @identity-implies |
                                        productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                                        [by discharge given-identity]
                                    }
                                  @all-implies |
                                    allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                                    [by discharge given-all]
                                }
                              @discharge-q |
                                forall q: Fn; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                                [by generalize generalize-q]
                            }
                          @discharge-p |
                            forall p: Fn; forall q: Fn; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                            [by generalize generalize-p]
                        }
                      @discharge-e |
                        forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                        [by generalize generalize-e]
                    }
                  @discharge-d |
                    forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                    [by generalize generalize-d]
                }
              @discharge-m |
                forall m: Nat; forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
            [by generalize generalize-j]
        }
      @discharge-a |
        forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
        [by generalize generalize-a]
    }
  @conclusion |
    forall w: Seq; forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, add(succ(succ(m)), d)) -> productUpTo(w, add(succ(succ(m)), d)) = identityFn -> (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> add(succ(succ(m)), d) = add(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, add(succ(succ(m)), d))
    [by generalize generalize-w]
qed

// (m+2)+d = (j+2)+e cancels the two successors: m+d = j+e. Both sides are
// succ(succ(·)) of the shorter sums (twoMoreCommutes), so succInjective twice finishes it.
theorem shortLengthMatches: forall m: Nat; forall d: Nat; forall j: Nat; forall e: Nat;
  add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e)
proof
  @generalize-m |
    fix m: Nat {
      @generalize-d |
        fix d: Nat {
          @generalize-j |
            fix j: Nat {
              @generalize-e |
                fix e: Nat {
                  @given-equal |
                    assume add(succ(succ(m)), d) = add(succ(succ(j)), e) {
                      @equal |
                        add(succ(succ(m)), d) = add(succ(succ(j)), e)
                        [by hypothesis given-equal]
                      @left-form |
                        add(succ(succ(m)), d) = succ(succ(add(m, d)))
                        [using specialize twoMoreCommutes(m, d)]
                      @right-form |
                        add(succ(succ(j)), e) = succ(succ(add(j, e)))
                        [using specialize twoMoreCommutes(j, e)]
                      @left-is-right-form |
                        succ(succ(add(m, d))) = add(succ(succ(j)), e)
                        [using chain left-form-flipped equal]
                      @left-form-flipped |
                        succ(succ(add(m, d))) = add(succ(succ(m)), d)
                        [by symmetry left-form]
                      @successors-equal |
                        succ(succ(add(m, d))) = succ(succ(add(j, e)))
                        [using chain left-is-right-form right-form]
                      @once-cancelled |
                        succ(add(m, d)) = succ(add(j, e))
                        [using specialize peano.succInjective(succ(add(m, d)), succ(add(j, e))) successors-equal]
                      @conclusion-cancelled |
                        add(m, d) = add(j, e)
                        [using specialize peano.succInjective(add(m, d), add(j, e)) once-cancelled]
                    }
                  @equal-implies |
                    add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e)
                    [by discharge given-equal]
                }
              @discharge-e |
                forall e: Nat; add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e)
                [by generalize generalize-e]
            }
          @discharge-j |
            forall j: Nat; forall e: Nat; add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e)
            [by generalize generalize-j]
        }
      @discharge-d |
        forall d: Nat; forall j: Nat; forall e: Nat; add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e)
        [by generalize generalize-d]
    }
  @conclusion |
    forall m: Nat; forall d: Nat; forall j: Nat; forall e: Nat; add(succ(succ(m)), d) = add(succ(succ(j)), e) -> add(m, d) = add(j, e)
    [by generalize generalize-m]
qed

// The loop BODY: from the invariant at succ(j), either the length has dropped or the
// invariant holds at j. This is where the classification meets the surgery.
// loopBody's conclusion stated with the `loopInvariant` DEFINE rather than expanded, which is
// the form loopTerminates cites (the expanded form binds its witness under a generated name).
theorem loopBodyAsInvariant: forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat;
  loopInvariant(a, succ(j), add(succ(succ(m)), d)) ->
  (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
proof
  @conclusion |
    forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; loopInvariant(a, succ(j), add(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
    [by cite loopBody]
qed

// -- THE LOOP BODY, assembled -----------------------------------------------------------------
// One turn of Judson's loop. Unpack the invariant at j+1, name the letters of the two entries,
// normalize entry j+1 so the letter comes first, classify the pair, and dispatch to whichever
// branch the classification returns. Both branches are proved above.
theorem loopBody: forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; loopInvariant(a, succ(j), add(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
proof
  @generalize-a |
    fix a: Element {
      @generalize-j |
        fix j: Nat {
          @generalize-m |
            fix m: Nat {
              @generalize-d |
                fix d: Nat {
                  @given-invariant |
                    assume loopInvariant(a, succ(j), add(succ(succ(m)), d)) {
                      @invariant |
                        loopInvariant(a, succ(j), add(succ(succ(m)), d))
                        [by hypothesis given-invariant]
                      @witness-exists |
                        exists w: Seq; allTranspositions(w, add(succ(succ(m)), d)) and productUpTo(w, add(succ(succ(m)), d)) = identityFn and apply(at(w, succ(j)), a) != a and (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) and less_than(succ(j), add(succ(succ(m)), d))
                        [using tautology invariant]
                      @with-witness |
                        unpack w: Seq from witness-exists {
                          @w-facts |
                            allTranspositions(w, add(succ(succ(m)), d)) and productUpTo(w, add(succ(succ(m)), d)) = identityFn and apply(at(w, succ(j)), a) != a and (forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a) and less_than(succ(j), add(succ(succ(m)), d))
                            [by hypothesis with-witness]
                          @w-all |
                            allTranspositions(w, add(succ(succ(m)), d))
                            [using tautology w-facts]
                          @w-identity |
                            productUpTo(w, add(succ(succ(m)), d)) = identityFn
                            [using tautology w-facts]
                          @top-moves-a |
                            apply(at(w, succ(j)), a) != a
                            [using tautology w-facts]
                          @above-fixed |
                            forall i: Nat; less_than(succ(j), i) -> less_than(i, add(succ(succ(m)), d)) -> apply(at(w, i), a) = a
                            [using tautology w-facts]
                          @succ-j-below |
                            less_than(succ(j), add(succ(succ(m)), d))
                            [using tautology w-facts]
                          @j-below-succ-j |
                            less_than(j, succ(j))
                            [using specialize natLessThanSelf(j)]
                          @j-below |
                            less_than(j, add(succ(succ(m)), d))
                            [using specialize peano_order.lessThanTransitive(j, succ(j), add(succ(succ(m)), d)) j-below-succ-j succ-j-below]
                          @entry-j-trans |
                            isTransposition(at(w, j))
                            [using specialize w-all(j) j-below]
                          @entry-top-trans |
                            isTransposition(at(w, succ(j)))
                            [using specialize w-all(succ(j)) succ-j-below]
                          @length-decomposes |
                            exists e: Nat; add(succ(succ(m)), d) = add(succ(succ(j)), e)
                            [using specialize lengthDecomposesAboveThePair(j, add(succ(succ(m)), d)) succ-j-below]
                          @top-normalized |
                            exists b: Element; a != b and at(w, succ(j)) = transposition(a, b)
                            [using specialize movingTranspositionWithTheLetterFirst(at(w, succ(j)), a) entry-top-trans top-moves-a]
                          @j-letters |
                            exists x: Element; exists y: Element; x != y and at(w, j) = transposition(x, y)
                            [using tautology entry-j-trans]
                          @with-e |
                            unpack e: Nat from length-decomposes {
                              @length-form |
                                add(succ(succ(m)), d) = add(succ(succ(j)), e)
                                [by hypothesis with-e]
                              @short-form |
                                add(m, d) = add(j, e)
                                [using specialize shortLengthMatches(m, d, j, e) length-form]
                              @with-b |
                                unpack b: Element from top-normalized {
                                  @b-facts |
                                    a != b and at(w, succ(j)) = transposition(a, b)
                                    [by hypothesis with-b]
                                  @ab |
                                    a != b
                                    [by and_lhs b-facts]
                                  @top-is-ab |
                                    at(w, succ(j)) = transposition(a, b)
                                    [by and_rhs b-facts]
                                  @with-x |
                                    unpack x: Element from j-letters {
                                      @y-exists |
                                        exists y: Element; x != y and at(w, j) = transposition(x, y)
                                        [by hypothesis with-x]
                                      @with-y |
                                        unpack y: Element from y-exists {
                                          @xy-facts |
                                            x != y and at(w, j) = transposition(x, y)
                                            [by hypothesis with-y]
                                          @xy |
                                            x != y
                                            [by and_lhs xy-facts]
                                          @j-is-xy |
                                            at(w, j) = transposition(x, y)
                                            [by and_rhs xy-facts]
                                          @classified |
                                            (compose(transposition(x, y), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(x, y), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a))
                                            [using specialize adjacentPairCancelsOrShiftsOff(a, b, x, y) ab xy]
                                          @pair-is-the-entries |
                                            compose(at(w, j), at(w, succ(j))) = compose(transposition(x, y), transposition(a, b))
                                            [using chain pair-with-j pair-with-top]
                                          @pair-with-j |
                                            compose(at(w, j), at(w, succ(j))) = compose(transposition(x, y), at(w, succ(j)))
                                            [by rewrite j-is-xy pair-reflexive]
                                          @pair-reflexive |
                                            compose(at(w, j), at(w, succ(j))) = compose(at(w, j), at(w, succ(j)))
                                            [by reflexivity]
                                          @pair-with-top |
                                            compose(transposition(x, y), at(w, succ(j))) = compose(transposition(x, y), transposition(a, b))
                                            [by rewrite top-is-ab pair-with-top-reflexive]
                                          @pair-with-top-reflexive |
                                            compose(transposition(x, y), at(w, succ(j))) = compose(transposition(x, y), at(w, succ(j)))
                                            [by reflexivity]
                                          @conclusion-dispatch |
                                            (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                                            case classified {
                                              @when-cancels |
                                                assume compose(transposition(x, y), transposition(a, b)) = identityFn {
                                                  @cancels-at-letters |
                                                    compose(transposition(x, y), transposition(a, b)) = identityFn
                                                    [by hypothesis when-cancels]
                                                  @cancels |
                                                    compose(at(w, j), at(w, succ(j))) = identityFn
                                                    [using chain pair-is-the-entries cancels-at-letters]
                                                  @shorter |
                                                    someProductOfLengthIsIdentity(add(m, d))
                                                    [using specialize cancelBranchDropsTwo(w, j, m, d, e) w-all w-identity length-form short-form cancels]
                                                  @conclusion-cancel |
                                                    (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                                                    [by either_left shorter]
                                                }
                                              @when-shifts |
                                                assume exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(x, y), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a {
                                                  @shift-exists |
                                                    exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(x, y), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                                    [by hypothesis when-shifts]
                                                  @with-p |
                                                    unpack p: Fn from shift-exists {
                                                      @q-exists |
                                                        exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(x, y), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                                        [by hypothesis with-p]
                                                      @with-q |
                                                        unpack q: Fn from q-exists {
                                                          @pq-facts |
                                                            isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(x, y), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                                            [by hypothesis with-q]
                                                          @p-trans |
                                                            isTransposition(p)
                                                            [using tautology pq-facts]
                                                          @q-trans |
                                                            isTransposition(q)
                                                            [using tautology pq-facts]
                                                          @pq-composes-at-letters |
                                                            compose(p, q) = compose(transposition(x, y), transposition(a, b))
                                                            [using tautology pq-facts]
                                                          @q-fixes |
                                                            apply(q, a) = a
                                                            [using tautology pq-facts]
                                                          @p-moves |
                                                            apply(p, a) != a
                                                            [using tautology pq-facts]
                                                          @entries-flipped |
                                                            compose(transposition(x, y), transposition(a, b)) = compose(at(w, j), at(w, succ(j)))
                                                            [by symmetry pair-is-the-entries]
                                                          @pq-composes |
                                                            compose(p, q) = compose(at(w, j), at(w, succ(j)))
                                                            [using chain pq-composes-at-letters entries-flipped]
                                                          @invariant-at-j |
                                                            loopInvariant(a, j, add(succ(succ(m)), d))
                                                            [using specialize shiftBranchKeepsTheInvariant(w, a, j, m, d, e, p, q) w-all w-identity above-fixed length-form p-trans q-trans pq-composes q-fixes p-moves]
                                                          @conclusion-shift-inner |
                                                            (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                                                            [by either_right invariant-at-j]
                                                        }
                                                      @conclusion-shift-q |
                                                        (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                                                        [by unpacked with-q]
                                                    }
                                                  @conclusion-shift |
                                                    (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                                                    [by unpacked with-p]
                                                }
                                            }
                                        }
                                      @conclusion-y |
                                        (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                                        [by unpacked with-y]
                                    }
                                  @conclusion-x |
                                    (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                                    [by unpacked with-x]
                                }
                              @conclusion-b |
                                (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                                [by unpacked with-b]
                            }
                          @conclusion-e |
                            (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                            [by unpacked with-e]
                        }
                      @conclusion-witness |
                        (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                        [by unpacked with-witness]
                    }
                  @invariant-implies |
                    loopInvariant(a, succ(j), add(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                    [by discharge given-invariant]
                }
              @discharge-d |
                forall d: Nat; loopInvariant(a, succ(j), add(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
                [by generalize generalize-d]
            }
          @discharge-m |
            forall m: Nat; forall d: Nat; loopInvariant(a, succ(j), add(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
            [by generalize generalize-m]
        }
      @discharge-j |
        forall j: Nat; forall m: Nat; forall d: Nat; loopInvariant(a, succ(j), add(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
        [by generalize generalize-j]
    }
  @conclusion |
    forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; loopInvariant(a, succ(j), add(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(add(m, d)) or loopInvariant(a, j, add(succ(succ(m)), d)))
    [by generalize generalize-a]
qed

// At position ZERO the invariant is IMPOSSIBLE: entry 0 moves `a` and everything above it
// fixes `a`, so the product moves `a` — but the product is the identity. STEP 3, packaged.
theorem invariantFailsAtZero: forall a: Element; forall r: Nat;
  less_than(ZERO, r) -> (not loopInvariant(a, ZERO, r))
proof
  @generalize-a |
    fix a: Element {
      @generalize-r |
        fix r: Nat {
          @given-positive |
            assume less_than(ZERO, r) {
              @positive |
                less_than(ZERO, r)
                [by hypothesis given-positive]
              @given-invariant |
                assume loopInvariant(a, ZERO, r) {
                  @invariant |
                    loopInvariant(a, ZERO, r)
                    [by hypothesis given-invariant]
                  @witness-exists |
                    exists w: Seq; allTranspositions(w, r) and productUpTo(w, r) = identityFn and apply(at(w, ZERO), a) != a and (forall i: Nat; less_than(ZERO, i) -> less_than(i, r) -> apply(at(w, i), a) = a) and less_than(ZERO, r)
                    [using tautology invariant]
                  @with-witness |
                    unpack w: Seq from witness-exists {
                      @w-facts |
                        allTranspositions(w, r) and productUpTo(w, r) = identityFn and apply(at(w, ZERO), a) != a and (forall i: Nat; less_than(ZERO, i) -> less_than(i, r) -> apply(at(w, i), a) = a) and less_than(ZERO, r)
                        [by hypothesis with-witness]
                      @is-identity |
                        productUpTo(w, r) = identityFn
                        [using tautology w-facts]
                      @first-moves-a |
                        apply(at(w, ZERO), a) != a
                        [using tautology w-facts]
                      @above-fixed |
                        forall i: Nat; less_than(ZERO, i) -> less_than(i, r) -> apply(at(w, i), a) = a
                        [using tautology w-facts]
                      // STEP 3: the product is the identity and everything above 0 fixes `a`,
                      // so entry 0 fixes `a` — contradicting that it moves it.
                      @first-fixes-a |
                        apply(at(w, ZERO), a) = a
                        [using specialize identityProductForcesFirstFactorToFix(w, a, r) is-identity above-fixed positive]
                      @conclusion-contradiction |
                        less_than(ZERO, ZERO)
                        [using tautology first-fixes-a first-moves-a]
                    }
                  @contradiction |
                    less_than(ZERO, ZERO)
                    [by unpacked with-witness]
                }
              @invariant-implies-absurdity |
                loopInvariant(a, ZERO, r) -> less_than(ZERO, ZERO)
                [by discharge given-invariant]
              @zero-not-below-itself |
                not less_than(ZERO, ZERO)
                [using specialize peano_order.lessThanIrreflexive(ZERO)]
              @conclusion-impossible |
                not loopInvariant(a, ZERO, r)
                [using tautology invariant-implies-absurdity zero-not-below-itself]
            }
          @positive-implies |
            less_than(ZERO, r) -> (not loopInvariant(a, ZERO, r))
            [by discharge given-positive]
        }
      @discharge-r |
        forall r: Nat; less_than(ZERO, r) -> (not loopInvariant(a, ZERO, r))
        [by generalize generalize-r]
    }
  @conclusion |
    forall a: Element; forall r: Nat; less_than(ZERO, r) -> (not loopInvariant(a, ZERO, r))
    [by generalize generalize-a]
qed

// The loop RUN: strong induction on the position. At 0 the invariant is impossible, so the
// length must already have dropped; above 0 the body either drops it or descends.
theorem loopTerminates: forall a: Element; forall base: Nat; forall d: Nat; forall j: Nat;
  loopInvariant(a, j, add(succ(succ(base)), d)) ->
  someProductOfLengthIsIdentity(add(base, d))
proof
  @generalize-a |
    fix a: Element {
      @generalize-base |
        fix base: Nat {
          @generalize-d |
            fix d: Nat {
              @length-is-positive |
                less_than(ZERO, add(succ(succ(base)), d))
                [using specialize zeroIsBelowTheLength(base, d)]
              @strong-step |
                fix j: Nat {
                  @given-smaller |
                    assume forall k: Nat; less_than(k, j) -> (loopInvariant(a, k, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d))) {
                      @smaller-cases |
                        forall k: Nat; less_than(k, j) -> (loopInvariant(a, k, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d)))
                        [by hypothesis given-smaller]
                      @given-invariant |
                        assume loopInvariant(a, j, add(succ(succ(base)), d)) {
                          @invariant |
                            loopInvariant(a, j, add(succ(succ(base)), d))
                            [by hypothesis given-invariant]
                          @j-shape |
                            j = ZERO or (exists p: Nat; j = succ(p))
                            [using specialize peano.zeroOrSucc(j)]
                          @conclusion-drops |
                            someProductOfLengthIsIdentity(add(base, d))
                            case j-shape {
                              @when-zero |
                                assume j = ZERO {
                                  @j-is-zero |
                                    j = ZERO
                                    [by hypothesis when-zero]
                                  @invariant-at-zero |
                                    loopInvariant(a, ZERO, add(succ(succ(base)), d))
                                    [by rewrite j-is-zero invariant]
                                  @impossible |
                                    not loopInvariant(a, ZERO, add(succ(succ(base)), d))
                                    [using specialize invariantFailsAtZero(a, add(succ(succ(base)), d)) length-is-positive]
                                  @conclusion-ex_falso |
                                    someProductOfLengthIsIdentity(add(base, d))
                                    [using tautology invariant-at-zero impossible]
                                }
                              @when-successor |
                                assume exists p: Nat; j = succ(p) {
                                  @has-predecessor |
                                    exists p: Nat; j = succ(p)
                                    [by hypothesis when-successor]
                                  @with-predecessor |
                                    unpack p: Nat from has-predecessor {
                                      @j-is-succ-p |
                                        j = succ(p)
                                        [by hypothesis with-predecessor]
                                      @invariant-at-succ-p |
                                        loopInvariant(a, succ(p), add(succ(succ(base)), d))
                                        [by rewrite j-is-succ-p invariant]
                                      @body |
                                        someProductOfLengthIsIdentity(add(base, d)) or loopInvariant(a, p, add(succ(succ(base)), d))
                                        [using specialize loopBodyAsInvariant(a, p, base, d) invariant-at-succ-p]
                                      @p-below-j |
                                        less_than(p, j)
                                        [by rewrite j-is-succ-p p-below-succ-p]
                                      @p-below-succ-p |
                                        less_than(p, succ(p))
                                        [using specialize natLessThanSelf(p)]
                                      @descend |
                                        loopInvariant(a, p, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d))
                                        [using specialize smaller-cases(p) p-below-j]
                                      @conclusion-either-way |
                                        someProductOfLengthIsIdentity(add(base, d))
                                        [using tautology body descend]
                                    }
                                  @conclusion-with-predecessor |
                                    someProductOfLengthIsIdentity(add(base, d))
                                    [by unpacked with-predecessor]
                                }
                            }
                        }
                      @invariant-implies |
                        loopInvariant(a, j, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d))
                        [by discharge given-invariant]
                    }
                  @strong-step-at-j |
                    (forall k: Nat; less_than(k, j) -> (loopInvariant(a, k, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d)))) -> (loopInvariant(a, j, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d)))
                    [by discharge given-smaller]
                }
              @strong-step-for-all |
                forall j: Nat; (forall k: Nat; less_than(k, j) -> (loopInvariant(a, k, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d)))) -> (loopInvariant(a, j, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d)))
                [by generalize strong-step]
              @conclusion-for-all-j |
                forall j: Nat; loopInvariant(a, j, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d))
                [using instantiation strongInduction((fun j: Nat => loopInvariant(a, j, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d)))) strong-step-for-all]
            }
          @discharge-d |
            forall d: Nat; forall j: Nat; loopInvariant(a, j, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d))
            [by generalize generalize-d]
        }
      @discharge-base |
        forall base: Nat; forall d: Nat; forall j: Nat; loopInvariant(a, j, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d))
        [by generalize generalize-base]
    }
  @conclusion |
    forall a: Element; forall base: Nat; forall d: Nat; forall j: Nat; loopInvariant(a, j, add(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(add(base, d))
    [by generalize generalize-a]
qed

theorem zeroIsBelowTheLength: forall m: Nat; forall d: Nat; less_than(ZERO, add(succ(succ(m)), d))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-d |
        fix d: Nat {
          @length-is-a-successor |
            add(succ(succ(m)), d) = succ(add(succ(m), d))
            [using specialize peano.addSuccLeft(succ(m), d)]
          @zero-below-successor |
            less_than(ZERO, succ(add(succ(m), d)))
            [using specialize zeroIsBelowEverySuccessor(add(succ(m), d))]
          @conclusion-positive |
            less_than(ZERO, add(succ(succ(m)), d))
            [by rewrite length-is-a-successor zero-below-successor]
        }
      @discharge-d |
        forall d: Nat; less_than(ZERO, add(succ(succ(m)), d))
        [by generalize generalize-d]
    }
  @conclusion |
    forall m: Nat; forall d: Nat; less_than(ZERO, add(succ(succ(m)), d))
    [by generalize generalize-m]
qed

// -- and the hole the outer induction consumes, now PROVED from those --------------------------
theorem innerLoopDropsTwo: forall m: Nat; forall d: Nat;
  someProductOfLengthIsIdentity(add(succ(succ(m)), d)) ->
  someProductOfLengthIsIdentity(add(m, d))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-d |
        fix d: Nat {
          @given-product |
            assume someProductOfLengthIsIdentity(add(succ(succ(m)), d)) {
              @product |
                someProductOfLengthIsIdentity(add(succ(succ(m)), d))
                [by hypothesis given-product]
              @sequence-exists |
                exists w: Seq; allTranspositions(w, add(succ(succ(m)), d)) and productUpTo(w, add(succ(succ(m)), d)) = identityFn
                [using tautology product]
              @with-sequence |
                unpack s: Seq from sequence-exists {
                  @s-facts |
                    allTranspositions(s, add(succ(succ(m)), d)) and productUpTo(s, add(succ(succ(m)), d)) = identityFn
                    [by hypothesis with-sequence]
                  @s-all |
                    allTranspositions(s, add(succ(succ(m)), d))
                    [by and_lhs s-facts]
                  @s-identity |
                    productUpTo(s, add(succ(succ(m)), d)) = identityFn
                    [by and_rhs s-facts]
                  // The length is a SUCCESSOR: (m+2)+d = succ(succ(m)+d). Write q for its
                  // predecessor — the LAST index — and take `a` from that last entry, so the
                  // invariant's "every entry above q" clause is vacuous (see
                  // invariantHoldsAtTheTop; taking the letter from entry m+1 instead was the
                  // error this restatement fixes).
                  @length-is-a-successor |
                    add(succ(succ(m)), d) = succ(add(succ(m), d))
                    [using specialize peano.addSuccLeft(succ(m), d)]
                  @s-all-at-successor |
                    allTranspositions(s, succ(add(succ(m), d)))
                    [by rewrite length-is-a-successor s-all]
                  @s-identity-at-successor |
                    productUpTo(s, succ(add(succ(m), d))) = identityFn
                    [by rewrite length-is-a-successor s-identity]
                  @top-below-length |
                    less_than(add(succ(m), d), succ(add(succ(m), d)))
                    [using specialize natLessThanSelf(add(succ(m), d))]
                  @top-entry-is-a-transposition |
                    isTransposition(at(s, add(succ(m), d)))
                    [using specialize s-all-at-successor(add(succ(m), d)) top-below-length]
                  @moved-letter-exists |
                    exists a: Element; apply(at(s, add(succ(m), d)), a) != a
                    [using specialize aTranspositionMovesSomething(at(s, add(succ(m), d))) top-entry-is-a-transposition]
                  @with-moved-letter |
                    unpack a: Element from moved-letter-exists {
                      @top-moves-a |
                        apply(at(s, add(succ(m), d)), a) != a
                        [by hypothesis with-moved-letter]
                      @invariant-at-top |
                        loopInvariant(a, add(succ(m), d), succ(add(succ(m), d)))
                        [using specialize invariantHoldsAtTheTop(a, s, add(succ(m), d)) s-all-at-successor s-identity-at-successor top-moves-a]
                      @invariant-at-the-original-length |
                        loopInvariant(a, add(succ(m), d), add(succ(succ(m)), d))
                        [by rewrite length-is-a-successor invariant-at-top]
                      @conclusion-drops |
                        someProductOfLengthIsIdentity(add(m, d))
                        [using specialize loopTerminates(a, m, d, add(succ(m), d)) invariant-at-the-original-length]
                    }
                  @conclusion-with-letter |
                    someProductOfLengthIsIdentity(add(m, d))
                    [by unpacked with-moved-letter]
                }
              @conclusion-unpacked |
                someProductOfLengthIsIdentity(add(m, d))
                [by unpacked with-sequence]
            }
          @product-implies |
            someProductOfLengthIsIdentity(add(succ(succ(m)), d)) -> someProductOfLengthIsIdentity(add(m, d))
            [by discharge given-product]
        }
      @discharge-d |
        forall d: Nat; someProductOfLengthIsIdentity(add(succ(succ(m)), d)) -> someProductOfLengthIsIdentity(add(m, d))
        [by generalize generalize-d]
    }
  @conclusion |
    forall m: Nat; forall d: Nat; someProductOfLengthIsIdentity(add(succ(succ(m)), d)) -> someProductOfLengthIsIdentity(add(m, d))
    [by generalize generalize-m]
qed

// The lemma in the PER-SEQUENCE form aata/5.1 states it in: this sequence's product being the
// identity makes this length even. Immediate from the exists-form, witnessed by the sequence.
theorem identityIsEvenLengthForAnySequence: forall s: Seq; forall r: Nat;
  allTranspositions(s, r) -> productUpTo(s, r) = identityFn -> ndivides(NTWO, r)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-r |
        fix r: Nat {
          @given-all |
            assume allTranspositions(s, r) {
              @given-identity |
                assume productUpTo(s, r) = identityFn {
                  @all-transpositions |
                    allTranspositions(s, r)
                    [by hypothesis given-all]
                  @is-identity |
                    productUpTo(s, r) = identityFn
                    [by hypothesis given-identity]
                  @witnessed |
                    allTranspositions(s, r) and productUpTo(s, r) = identityFn
                    [by both all-transpositions is-identity]
                  @some-product |
                    someProductOfLengthIsIdentity(r)
                    [by witness(s) witnessed]
                  @conclusion-even |
                    ndivides(NTWO, r)
                    [using specialize identityIsEvenLength(r) some-product]
                }
              @identity-implies |
                productUpTo(s, r) = identityFn -> ndivides(NTWO, r)
                [by discharge given-identity]
            }
          @all-implies |
            allTranspositions(s, r) -> productUpTo(s, r) = identityFn -> ndivides(NTWO, r)
            [by discharge given-all]
        }
      @discharge-r |
        forall r: Nat; allTranspositions(s, r) -> productUpTo(s, r) = identityFn -> ndivides(NTWO, r)
        [by generalize generalize-r]
    }
  @conclusion |
    forall s: Seq; forall r: Nat; allTranspositions(s, r) -> productUpTo(s, r) = identityFn -> ndivides(NTWO, r)
    [by generalize generalize-s]
qed
