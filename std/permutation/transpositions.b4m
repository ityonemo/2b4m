// std/permutation/transpositions.b4m — PRODUCTS OF TRANSPOSITIONS.
//
// A cycle is a product of transpositions by its very definition, (a₀ … a_k) = (a₀ a_k) ∘
// (a₀ … a_{k-1}); read as a sequence, that recursion is the list (a₀ a_k), (a₀ a_{k-1}), …,
// (a₀ a₁) folded into a product. Concatenating the lists of the disjoint cycles of a
// permutation then writes the permutation itself as a product of transpositions — Judson's
// Proposition 5.12, without his "at least two elements" (the identity is the empty product).

import permutation <<< "std/permutation.b4m"
import cycle_theory <<< "std/permutation/cycle.b4m"
import permutation_sequence <<< "std/permutation/sequence.b4m"
import decomposition <<< "std/permutation/decomposition.b4m"
import function <<< "std/function.b4m"
import set <<< "std/set.b4m"
import element <<< "std/element.b4m"
import set_finite <<< "std/set/finite.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import peano_subtraction <<< "std/peano/subtraction.b4m"

sort Element = element.Element
sort Fn = function.Fn
const identityFn = function.identityFn
func compose = function.compose
pred invertible = function.invertible
sort Perm = permutation.Perm
func support = permutation.support
func transposition = permutation.transposition
theorem transpositionIsAPermutation = permutation.transpositionIsAPermutation
theorem identityIsAPermutation = permutation.identityIsAPermutation

sort Points = cycle_theory.Points
func cycle = cycle_theory.cycle
axiom cycleSucc = cycle_theory.cycleSucc
theorem oneCycleIsTheIdentity = cycle_theory.oneCycleIsTheIdentity
define isACycle(g) = decomposition.isACycle(g)
define decomposesIntoDisjointCycles(f) = decomposition.decomposesIntoDisjointCycles(f)
theorem everyPermutationOfAFiniteSetIsAProductOfDisjointCycles = decomposition.everyPermutationOfAFiniteSetIsAProductOfDisjointCycles
define isFinite(a) = set_finite.isFinite(a)

sort Seq = permutation_sequence.Seq
func at = permutation_sequence.at
func productUpTo = permutation_sequence.productUpTo
axiom productUpToZero = permutation_sequence.productUpToZero
axiom productUpToSucc = permutation_sequence.productUpToSucc
axiom seqSingleton = permutation_sequence.seqSingleton
axiom seqPrepend = permutation_sequence.seqPrepend
axiom seqConcat = permutation_sequence.seqConcat
theorem productOfPrepend = permutation_sequence.productOfPrepend

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
func sub = peano.sub
pred less_than = peano.less_than
axiom induction = peano.induction
theorem zeroOrSucc = peano.zeroOrSucc
theorem notLessThanZero = peano_order.notLessThanZero
theorem succReflectsOrder = peano_order.succReflectsOrder
theorem trichotomy = peano_order.trichotomy
theorem lessThanAddCancelLeft = peano_order.lessThanAddCancelLeft
theorem lessThanSelf = peano_order.lessThanSelf
theorem lessThanTransitive = peano_order.lessThanTransitive
theorem addZeroRight = peano.addZeroRight
theorem addIsCommutative = peano.addIsCommutative
theorem addSubCancel = peano_subtraction.addSubCancel
theorem zeroBelowSucc = cycle_theory.zeroBelowSucc

// t IS A TRANSPOSITION: it exchanges some two points
define isATransposition(t) = exists u: Element; exists v: Element; t = transposition(u, v)

// g IS A PRODUCT OF TRANSPOSITIONS: some sequence of r transpositions multiplies to g
define isAProductOfTranspositions(g) = exists w: Seq; exists r: Nat;
  (forall i: Nat; less_than(i, r) -> isATransposition(at(w, i))) and productUpTo(w, r) = g

// -- a cycle is a product of transpositions -------------------------------------------------------

// Induction on the length: the one-cycle is the identity, the empty product of any
// sequence; and (a₀ … a_{k+1}) = (a₀ a_{k+1}) ∘ (a₀ … a_k) is that transposition prepended
// to the sequence for the shorter cycle.
theorem cycleIsAProductOfTranspositions: forall s: Points; forall k: Nat;
  exists w: Seq; (forall i: Nat; less_than(i, k) -> isATransposition(at(w, i))) and productUpTo(w, k) = cycle(s, succ(k))
proof
  @generalize-s |
    fix s: Points {
      // base case: the one-cycle is the identity, which is the empty product
      @identity-invertible |
        invertible(identityFn)
        [by cite identityIsAPermutation]
      @some-sequence-exists |
        exists w: Seq; at(w, ZERO) = identityFn and productUpTo(w, succ(ZERO)) = identityFn
        [using specialize seqSingleton(identityFn) identity-invertible]
      @base-case-proof |
        unpack w: Seq from some-sequence-exists {
          @empty-product-is-identity |
            productUpTo(w, ZERO) = identityFn
            [using specialize productUpToZero(w)]
          @one-cycle-is-identity |
            cycle(s, succ(ZERO)) = identityFn
            [using specialize oneCycleIsTheIdentity(s)]
          @identity-is-the-one-cycle |
            identityFn = cycle(s, succ(ZERO))
            [by symmetry one-cycle-is-identity]
          @empty-product-is-the-one-cycle |
            productUpTo(w, ZERO) = cycle(s, succ(ZERO))
            [using chain empty-product-is-identity identity-is-the-one-cycle]
          @vacuous-entries |
            fix i: Nat {
              @nothing-below-zero |
                not less_than(i, ZERO)
                [using specialize notLessThanZero(i)]
              @entry-clause |
                less_than(i, ZERO) -> isATransposition(at(w, i))
                [using tautology nothing-below-zero]
            }
          @no-entries |
            forall i: Nat; less_than(i, ZERO) -> isATransposition(at(w, i))
            [by forall_intro vacuous-entries]
          @base-clauses |
            (forall i: Nat; less_than(i, ZERO) -> isATransposition(at(w, i))) and productUpTo(w, ZERO) = cycle(s, succ(ZERO))
            [by and_intro no-entries empty-product-is-the-one-cycle]
          @conclusion-base-witness |
            exists w2: Seq; (forall i: Nat; less_than(i, ZERO) -> isATransposition(at(w2, i))) and productUpTo(w2, ZERO) = cycle(s, succ(ZERO))
            [by exists_intro(w) base-clauses]
        }
      @base-case |
        exists w2: Seq; (forall i: Nat; less_than(i, ZERO) -> isATransposition(at(w2, i))) and productUpTo(w2, ZERO) = cycle(s, succ(ZERO))
        [by exists_elim base-case-proof]
      // inductive step: prepend the new transposition
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume exists w: Seq; (forall i: Nat; less_than(i, k) -> isATransposition(at(w, i))) and productUpTo(w, k) = cycle(s, succ(k)) {
              @inductive-hypothesis |
                exists w: Seq; (forall i: Nat; less_than(i, k) -> isATransposition(at(w, i))) and productUpTo(w, k) = cycle(s, succ(k))
                [by hypothesis given-inductive-hypothesis]
              @with-sequence-w |
                unpack w: Seq from inductive-hypothesis {
                  @sequence-facts |
                    (forall i: Nat; less_than(i, k) -> isATransposition(at(w, i))) and productUpTo(w, k) = cycle(s, succ(k))
                    [by hypothesis with-sequence-w]
                  @entries-are-transpositions |
                    forall i: Nat; less_than(i, k) -> isATransposition(at(w, i))
                    [by and_elim_left sequence-facts]
                  @product-is-the-shorter-cycle |
                    productUpTo(w, k) = cycle(s, succ(k))
                    [by and_elim_right sequence-facts]
                  @new-transposition-invertible |
                    invertible(transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))))
                    [using specialize transpositionIsAPermutation(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k)))]
                  @prepend-for-it |
                    forall t: Seq; exists u: Seq; at(u, ZERO) = transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))) and (forall i: Nat; at(u, succ(i)) = at(t, i))
                    [using specialize seqPrepend(transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k)))) new-transposition-invertible]
                  @prepended-exists |
                    exists u: Seq; at(u, ZERO) = transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))) and (forall i: Nat; at(u, succ(i)) = at(w, i))
                    [using specialize prepend-for-it(w)]
                  @with-prepended-u |
                    unpack u: Seq from prepended-exists {
                      @prepend-facts |
                        at(u, ZERO) = transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))) and (forall i: Nat; at(u, succ(i)) = at(w, i))
                        [by hypothesis with-prepended-u]
                      @head-is-the-transposition |
                        at(u, ZERO) = transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k)))
                        [by and_elim_left prepend-facts]
                      @tail-shifts |
                        forall i: Nat; at(u, succ(i)) = at(w, i)
                        [by and_elim_right prepend-facts]
                      @product-of-prepend |
                        forall n: Nat; productUpTo(u, succ(n)) = compose(transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))), productUpTo(w, n))
                        [using specialize productOfPrepend(transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))), w, u) head-is-the-transposition tail-shifts]
                      @product-at-k |
                        productUpTo(u, succ(k)) = compose(transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))), productUpTo(w, k))
                        [using specialize product-of-prepend(k)]
                      @product-through-the-shorter-cycle |
                        productUpTo(u, succ(k)) = compose(transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))), cycle(s, succ(k)))
                        [by rewrite product-is-the-shorter-cycle product-at-k]
                      @longer-cycle-unfolds |
                        cycle(s, succ(succ(k))) = compose(transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))), cycle(s, succ(k)))
                        [using specialize cycleSucc(s, succ(k))]
                      @product-is-the-longer-cycle |
                        productUpTo(u, succ(k)) = cycle(s, succ(succ(k)))
                        [by rewrite longer-cycle-unfolds product-through-the-shorter-cycle]
                      // every entry is a transposition
                      @generalize-i |
                        fix i: Nat {
                          @given-i-in-range |
                            assume less_than(i, succ(k)) {
                              @i-in-range |
                                less_than(i, succ(k))
                                [by hypothesis given-i-in-range]
                              @i-is-zero-or-a-successor |
                                i = ZERO or (exists i2: Nat; i = succ(i2))
                                [using specialize zeroOrSucc(i)]
                              @conclusion-entry |
                                isATransposition(at(u, i))
                                case i-is-zero-or-a-successor {
                                  @when-head |
                                    assume i = ZERO {
                                      @i-is-zero |
                                        i = ZERO
                                        [by hypothesis when-head]
                                      @the-transposition-is-itself |
                                        transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))) = transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k)))
                                        [by reflexivity]
                                      @inner-witness |
                                        exists v: Element; transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))) = transposition(cycle_theory.at(s, ZERO), v)
                                        [by exists_intro(cycle_theory.at(s, succ(k))) the-transposition-is-itself]
                                      @head-value-is-a-transposition |
                                        isATransposition(transposition(cycle_theory.at(s, ZERO), cycle_theory.at(s, succ(k))))
                                        [by exists_intro(cycle_theory.at(s, ZERO)) inner-witness]
                                      @head-is-a-transposition |
                                        isATransposition(at(u, ZERO))
                                        [by rewrite head-is-the-transposition head-value-is-a-transposition]
                                      @conclusion-head |
                                        isATransposition(at(u, i))
                                        [by rewrite i-is-zero head-is-a-transposition]
                                    }
                                  @when-tail |
                                    assume exists i2: Nat; i = succ(i2) {
                                      @predecessor-exists |
                                        exists i2: Nat; i = succ(i2)
                                        [by hypothesis when-tail]
                                      @with-predecessor-i2 |
                                        unpack i2: Nat from predecessor-exists {
                                          @i-is-succ-i2 |
                                            i = succ(i2)
                                            [by hypothesis with-predecessor-i2]
                                          @succ-i2-in-range |
                                            less_than(succ(i2), succ(k))
                                            [by rewrite i-is-succ-i2 i-in-range]
                                          @i2-in-range |
                                            less_than(i2, k)
                                            [using specialize succReflectsOrder(i2, k) succ-i2-in-range]
                                          @tail-entry-is-a-transposition |
                                            isATransposition(at(w, i2))
                                            [using specialize entries-are-transpositions(i2) i2-in-range]
                                          @shifted |
                                            at(u, succ(i2)) = at(w, i2)
                                            [using specialize tail-shifts(i2)]
                                          @shifted-is-a-transposition |
                                            isATransposition(at(u, succ(i2)))
                                            [by rewrite shifted tail-entry-is-a-transposition]
                                          @conclusion-tail |
                                            isATransposition(at(u, i))
                                            [by rewrite i-is-succ-i2 shifted-is-a-transposition]
                                        }
                                      @conclusion-when-tail |
                                        isATransposition(at(u, i))
                                        [by exists_elim with-predecessor-i2]
                                    }
                                }
                            }
                          @conclusion-entry-clause |
                            less_than(i, succ(k)) -> isATransposition(at(u, i))
                            [by implies_intro given-i-in-range]
                        }
                      @all-entries |
                        forall i: Nat; less_than(i, succ(k)) -> isATransposition(at(u, i))
                        [by forall_intro generalize-i]
                      @step-clauses |
                        (forall i: Nat; less_than(i, succ(k)) -> isATransposition(at(u, i))) and productUpTo(u, succ(k)) = cycle(s, succ(succ(k)))
                        [by and_intro all-entries product-is-the-longer-cycle]
                      @conclusion-step-witness |
                        exists w2: Seq; (forall i: Nat; less_than(i, succ(k)) -> isATransposition(at(w2, i))) and productUpTo(w2, succ(k)) = cycle(s, succ(succ(k)))
                        [by exists_intro(u) step-clauses]
                    }
                  @conclusion-with-u |
                    exists w2: Seq; (forall i: Nat; less_than(i, succ(k)) -> isATransposition(at(w2, i))) and productUpTo(w2, succ(k)) = cycle(s, succ(succ(k)))
                    [by exists_elim with-prepended-u]
                }
              @conclusion-step |
                exists w2: Seq; (forall i: Nat; less_than(i, succ(k)) -> isATransposition(at(w2, i))) and productUpTo(w2, succ(k)) = cycle(s, succ(succ(k)))
                [by exists_elim with-sequence-w]
            }
          @induction-step-at-k |
            (exists w: Seq; (forall i: Nat; less_than(i, k) -> isATransposition(at(w, i))) and productUpTo(w, k) = cycle(s, succ(k))) -> (exists w2: Seq; (forall i: Nat; less_than(i, succ(k)) -> isATransposition(at(w2, i))) and productUpTo(w2, succ(k)) = cycle(s, succ(succ(k))))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; (exists w: Seq; (forall i: Nat; less_than(i, k) -> isATransposition(at(w, i))) and productUpTo(w, k) = cycle(s, succ(k))) -> (exists w2: Seq; (forall i: Nat; less_than(i, succ(k)) -> isATransposition(at(w2, i))) and productUpTo(w2, succ(k)) = cycle(s, succ(succ(k))))
        [by forall_intro induction-step]
      @conclusion-for-all-k |
        forall k: Nat; exists w: Seq; (forall i: Nat; less_than(i, k) -> isATransposition(at(w, i))) and productUpTo(w, k) = cycle(s, succ(k))
        [using instantiation induction((fun k: Nat => exists w: Seq; (forall i: Nat; less_than(i, k) -> isATransposition(at(w, i))) and productUpTo(w, k) = cycle(s, succ(k)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Points; forall k: Nat;
      exists w: Seq; (forall i: Nat; less_than(i, k) -> isATransposition(at(w, i))) and productUpTo(w, k) = cycle(s, succ(k))
    [by forall_intro generalize-s]
qed

// -- concatenation keeps "every entry is a transposition" ---------------------------------------

// An index below n+m lands in the first segment (i < n, where u agrees with t) or the second
// (n ≤ i, where i = n + (i-n) and u agrees with r at the offset i-n). The second needs the
// arithmetic: addSubCancel recovers i from its offset, which lies below m.
theorem concatenationPreservesTranspositions: forall u: Seq; forall t: Seq; forall r: Seq; forall n: Nat; forall m: Nat;
  (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)) ->
  (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)) ->
  (forall i: Nat; less_than(i, n) -> isATransposition(at(t, i))) ->
  (forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))) ->
  forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
proof
  @generalize-u |
    fix u: Seq {
      @generalize-t |
        fix t: Seq {
          @generalize-r |
            fix r: Seq {
              @generalize-n |
                fix n: Nat {
                  @generalize-m |
                    fix m: Nat {
                      @given-agrees-t |
                        assume forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i) {
                          @given-agrees-r |
                            assume forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i) {
                              @given-t |
                                assume forall i: Nat; less_than(i, n) -> isATransposition(at(t, i)) {
                                  @given-r |
                                    assume forall i: Nat; less_than(i, m) -> isATransposition(at(r, i)) {
                                      @agrees-t |
                                        forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)
                                        [by hypothesis given-agrees-t]
                                      @agrees-r |
                                        forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)
                                        [by hypothesis given-agrees-r]
                                      @t-transpositions |
                                        forall i: Nat; less_than(i, n) -> isATransposition(at(t, i))
                                        [by hypothesis given-t]
                                      @r-transpositions |
                                        forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))
                                        [by hypothesis given-r]
                                      @generalize-i |
                                        fix i: Nat {
                                          @given-i-in-range |
                                            assume less_than(i, add(n, m)) {
                                              @i-in-range |
                                                less_than(i, add(n, m))
                                                [by hypothesis given-i-in-range]
                                              @i-before-or-after-n |
                                                less_than(i, n) or i = n or less_than(n, i)
                                                [using specialize trichotomy(i, n)]
                                              @conclusion-entry |
                                                isATransposition(at(u, i))
                                                case i-before-or-after-n {
                                                  @when-in-first |
                                                    assume less_than(i, n) {
                                                      @i-below-n |
                                                        less_than(i, n)
                                                        [by hypothesis when-in-first]
                                                      @u-entry-is-t-entry |
                                                        at(u, i) = at(t, i)
                                                        [using specialize agrees-t(i) i-below-n]
                                                      @t-entry-is-a-transposition |
                                                        isATransposition(at(t, i))
                                                        [using specialize t-transpositions(i) i-below-n]
                                                      @conclusion-in-first |
                                                        isATransposition(at(u, i))
                                                        [by rewrite u-entry-is-t-entry t-entry-is-a-transposition]
                                                    }
                                                  @when-at-the-boundary |
                                                    assume i = n {
                                                      @i-is-n |
                                                        i = n
                                                        [by hypothesis when-at-the-boundary]
                                                      @n-below-total |
                                                        less_than(n, add(n, m))
                                                        [by rewrite i-is-n i-in-range]
                                                      @n-plus-zero-is-n |
                                                        add(n, ZERO) = n
                                                        [using specialize addZeroRight(n)]
                                                      @n-plus-zero-below-total |
                                                        less_than(add(n, ZERO), add(n, m))
                                                        [by rewrite n-plus-zero-is-n n-below-total]
                                                      @m-is-positive |
                                                        less_than(ZERO, m)
                                                        [using specialize lessThanAddCancelLeft(n, ZERO, m) n-plus-zero-below-total]
                                                      @u-entry-at-offset-zero |
                                                        at(u, add(n, ZERO)) = at(r, ZERO)
                                                        [using specialize agrees-r(ZERO) m-is-positive]
                                                      @u-entry-at-n |
                                                        at(u, n) = at(r, ZERO)
                                                        [by rewrite n-plus-zero-is-n u-entry-at-offset-zero]
                                                      @r-first-is-a-transposition |
                                                        isATransposition(at(r, ZERO))
                                                        [using specialize r-transpositions(ZERO) m-is-positive]
                                                      @u-entry-at-n-is-a-transposition |
                                                        isATransposition(at(u, n))
                                                        [by rewrite u-entry-at-n r-first-is-a-transposition]
                                                      @conclusion-at-the-boundary |
                                                        isATransposition(at(u, i))
                                                        [by rewrite i-is-n u-entry-at-n-is-a-transposition]
                                                    }
                                                  @when-in-second |
                                                    assume less_than(n, i) {
                                                      @n-below-i |
                                                        less_than(n, i)
                                                        [by hypothesis when-in-second]
                                                      @successor-exceeds-i |
                                                        less_than(i, succ(i))
                                                        [using specialize lessThanSelf(i)]
                                                      @n-below-successor-of-i |
                                                        less_than(n, succ(i))
                                                        [using specialize lessThanTransitive(n, i, succ(i)) n-below-i successor-exceeds-i]
                                                      @offset-plus-n-is-i |
                                                        add(sub(i, n), n) = i
                                                        [using specialize addSubCancel(n, i) n-below-successor-of-i]
                                                      @offset-commuted |
                                                        add(sub(i, n), n) = add(n, sub(i, n))
                                                        [using specialize addIsCommutative(sub(i, n), n)]
                                                      @offset-recovers-i |
                                                        add(n, sub(i, n)) = i
                                                        [by rewrite offset-commuted offset-plus-n-is-i]
                                                      @offset-form-below-total |
                                                        less_than(add(n, sub(i, n)), add(n, m))
                                                        [by rewrite offset-recovers-i i-in-range]
                                                      @offset-below-m |
                                                        less_than(sub(i, n), m)
                                                        [using specialize lessThanAddCancelLeft(n, sub(i, n), m) offset-form-below-total]
                                                      @u-entry-at-offset |
                                                        at(u, add(n, sub(i, n))) = at(r, sub(i, n))
                                                        [using specialize agrees-r(sub(i, n)) offset-below-m]
                                                      @u-entry-is-r-entry |
                                                        at(u, i) = at(r, sub(i, n))
                                                        [by rewrite offset-recovers-i u-entry-at-offset]
                                                      @r-entry-is-a-transposition |
                                                        isATransposition(at(r, sub(i, n)))
                                                        [using specialize r-transpositions(sub(i, n)) offset-below-m]
                                                      @conclusion-in-second |
                                                        isATransposition(at(u, i))
                                                        [by rewrite u-entry-is-r-entry r-entry-is-a-transposition]
                                                    }
                                                }
                                            }
                                          @conclusion-entry-implication |
                                            less_than(i, add(n, m)) -> isATransposition(at(u, i))
                                            [by implies_intro given-i-in-range]
                                        }
                                      @conclusion-all |
                                        forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
                                        [by forall_intro generalize-i]
                                    }
                                  @conclusion-r |
                                    (forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))) -> forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
                                    [by implies_intro given-r]
                                }
                              @conclusion-t |
                                (forall i: Nat; less_than(i, n) -> isATransposition(at(t, i))) -> (forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))) -> forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
                                [by implies_intro given-t]
                            }
                          @conclusion-agrees-r |
                            (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)) -> (forall i: Nat; less_than(i, n) -> isATransposition(at(t, i))) -> (forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))) -> forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
                            [by implies_intro given-agrees-r]
                        }
                      @conclusion-agrees-t |
                        (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)) -> (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)) -> (forall i: Nat; less_than(i, n) -> isATransposition(at(t, i))) -> (forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))) -> forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
                        [by implies_intro given-agrees-t]
                    }
                  @discharge-m |
                    forall m: Nat; (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)) -> (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)) -> (forall i: Nat; less_than(i, n) -> isATransposition(at(t, i))) -> (forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))) -> forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
                    [by forall_intro generalize-m]
                }
              @discharge-n |
                forall n: Nat; forall m: Nat; (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)) -> (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)) -> (forall i: Nat; less_than(i, n) -> isATransposition(at(t, i))) -> (forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))) -> forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
                [by forall_intro generalize-n]
            }
          @discharge-r |
            forall r: Seq; forall n: Nat; forall m: Nat; (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)) -> (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)) -> (forall i: Nat; less_than(i, n) -> isATransposition(at(t, i))) -> (forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))) -> forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
            [by forall_intro generalize-r]
        }
      @discharge-t |
        forall t: Seq; forall r: Seq; forall n: Nat; forall m: Nat; (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)) -> (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)) -> (forall i: Nat; less_than(i, n) -> isATransposition(at(t, i))) -> (forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))) -> forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
        [by forall_intro generalize-t]
    }
  @conclusion |
    forall u: Seq; forall t: Seq; forall r: Seq; forall n: Nat; forall m: Nat;
      (forall i: Nat; less_than(i, n) -> at(u, i) = at(t, i)) ->
      (forall i: Nat; less_than(i, m) -> at(u, add(n, i)) = at(r, i)) ->
      (forall i: Nat; less_than(i, n) -> isATransposition(at(t, i))) ->
      (forall i: Nat; less_than(i, m) -> isATransposition(at(r, i))) ->
      forall i: Nat; less_than(i, add(n, m)) -> isATransposition(at(u, i))
    [by forall_intro generalize-u]
qed

// -- a product of products of transpositions is one ------------------------------------------------

// Induction on the number of factors: the empty product is the identity, the empty product
// of transpositions; a product of k+1 factors is the product of k, times the last — each a
// product of transpositions, and concatenating their sequences multiplies to the whole.
theorem productOfProductsOfTranspositions: forall w: Seq; forall m: Nat;
  (forall i: Nat; less_than(i, m) -> isAProductOfTranspositions(at(w, i))) ->
  isAProductOfTranspositions(productUpTo(w, m))
proof
  @generalize-w |
    fix w: Seq {
      // base case: the empty product
      @identity-invertible |
        invertible(identityFn)
        [by cite identityIsAPermutation]
      @some-sequence-exists |
        exists v: Seq; at(v, ZERO) = identityFn and productUpTo(v, succ(ZERO)) = identityFn
        [using specialize seqSingleton(identityFn) identity-invertible]
      @base-case-proof |
        unpack v: Seq from some-sequence-exists {
          @empty-product-of-v |
            productUpTo(v, ZERO) = identityFn
            [using specialize productUpToZero(v)]
          @empty-product-of-w |
            productUpTo(w, ZERO) = identityFn
            [using specialize productUpToZero(w)]
          @identity-is-empty-product-of-w |
            identityFn = productUpTo(w, ZERO)
            [by symmetry empty-product-of-w]
          @empty-products-agree |
            productUpTo(v, ZERO) = productUpTo(w, ZERO)
            [using chain empty-product-of-v identity-is-empty-product-of-w]
          @vacuous-entries |
            fix i: Nat {
              @nothing-below-zero |
                not less_than(i, ZERO)
                [using specialize notLessThanZero(i)]
              @entry-clause |
                less_than(i, ZERO) -> isATransposition(at(v, i))
                [using tautology nothing-below-zero]
            }
          @no-entries |
            forall i: Nat; less_than(i, ZERO) -> isATransposition(at(v, i))
            [by forall_intro vacuous-entries]
          @base-clauses |
            (forall i: Nat; less_than(i, ZERO) -> isATransposition(at(v, i))) and productUpTo(v, ZERO) = productUpTo(w, ZERO)
            [by and_intro no-entries empty-products-agree]
          @inner-base-witness |
            exists r: Nat; (forall i: Nat; less_than(i, r) -> isATransposition(at(v, i))) and productUpTo(v, r) = productUpTo(w, ZERO)
            [by exists_intro(ZERO) base-clauses]
          @conclusion-base-witness |
            isAProductOfTranspositions(productUpTo(w, ZERO))
            [by exists_intro(v) inner-base-witness]
        }
      @base-value |
        isAProductOfTranspositions(productUpTo(w, ZERO))
        [by exists_elim base-case-proof]
      @base-case |
        (forall i: Nat; less_than(i, ZERO) -> isAProductOfTranspositions(at(w, i))) -> isAProductOfTranspositions(productUpTo(w, ZERO))
        [using tautology base-value]
      // inductive step
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume (forall i: Nat; less_than(i, k) -> isAProductOfTranspositions(at(w, i))) -> isAProductOfTranspositions(productUpTo(w, k)) {
              @inductive-hypothesis |
                (forall i: Nat; less_than(i, k) -> isAProductOfTranspositions(at(w, i))) -> isAProductOfTranspositions(productUpTo(w, k))
                [by hypothesis given-inductive-hypothesis]
              @given-factors |
                assume forall i: Nat; less_than(i, succ(k)) -> isAProductOfTranspositions(at(w, i)) {
                  @factors |
                    forall i: Nat; less_than(i, succ(k)) -> isAProductOfTranspositions(at(w, i))
                    [by hypothesis given-factors]
                  @generalize-i |
                    fix i: Nat {
                      @given-i-below-k |
                        assume less_than(i, k) {
                          @i-below-k |
                            less_than(i, k)
                            [by hypothesis given-i-below-k]
                          @i-below-succ-k |
                            less_than(i, succ(k))
                            [using specialize peano_order.lessThanSuccRight(i, k) i-below-k]
                          @conclusion-factor-i |
                            isAProductOfTranspositions(at(w, i))
                            [using specialize factors(i) i-below-succ-k]
                        }
                      @conclusion-factor-clause |
                        less_than(i, k) -> isAProductOfTranspositions(at(w, i))
                        [by implies_intro given-i-below-k]
                    }
                  @first-k-factors |
                    forall i: Nat; less_than(i, k) -> isAProductOfTranspositions(at(w, i))
                    [by forall_intro generalize-i]
                  @product-of-first-k |
                    isAProductOfTranspositions(productUpTo(w, k))
                    [by modus_ponens inductive-hypothesis first-k-factors]
                  @k-below-succ-k |
                    less_than(k, succ(k))
                    [using specialize lessThanSelf(k)]
                  @last-factor |
                    isAProductOfTranspositions(at(w, k))
                    [using specialize factors(k) k-below-succ-k]
                  @next-product-unfolds |
                    productUpTo(w, succ(k)) = compose(productUpTo(w, k), at(w, k))
                    [using specialize productUpToSucc(w, k)]
                  @with-first-sequence-a |
                    unpack a: Seq from product-of-first-k {
                      @first-inner |
                        exists q: Nat; (forall i: Nat; less_than(i, q) -> isATransposition(at(a, i))) and productUpTo(a, q) = productUpTo(w, k)
                        [by hypothesis with-first-sequence-a]
                      @with-first-length-q |
                        unpack q: Nat from first-inner {
                          @first-facts |
                            (forall i: Nat; less_than(i, q) -> isATransposition(at(a, i))) and productUpTo(a, q) = productUpTo(w, k)
                            [by hypothesis with-first-length-q]
                          @a-transpositions |
                            forall i: Nat; less_than(i, q) -> isATransposition(at(a, i))
                            [by and_elim_left first-facts]
                          @a-product |
                            productUpTo(a, q) = productUpTo(w, k)
                            [by and_elim_right first-facts]
                          @with-last-sequence-b |
                            unpack b: Seq from last-factor {
                              @last-inner |
                                exists r: Nat; (forall i: Nat; less_than(i, r) -> isATransposition(at(b, i))) and productUpTo(b, r) = at(w, k)
                                [by hypothesis with-last-sequence-b]
                              @with-last-length-r |
                                unpack r: Nat from last-inner {
                                  @last-facts |
                                    (forall i: Nat; less_than(i, r) -> isATransposition(at(b, i))) and productUpTo(b, r) = at(w, k)
                                    [by hypothesis with-last-length-r]
                                  @b-transpositions |
                                    forall i: Nat; less_than(i, r) -> isATransposition(at(b, i))
                                    [by and_elim_left last-facts]
                                  @b-product |
                                    productUpTo(b, r) = at(w, k)
                                    [by and_elim_right last-facts]
                                  @concatenation-exists |
                                    exists c: Seq; (forall i: Nat; less_than(i, q) -> at(c, i) = at(a, i)) and (forall i: Nat; less_than(i, r) -> at(c, add(q, i)) = at(b, i)) and productUpTo(c, add(q, r)) = compose(productUpTo(a, q), productUpTo(b, r))
                                    [using specialize seqConcat(a, b, q, r)]
                                  @with-concatenation-c |
                                    unpack c: Seq from concatenation-exists {
                                      @concatenation-facts |
                                        (forall i: Nat; less_than(i, q) -> at(c, i) = at(a, i)) and (forall i: Nat; less_than(i, r) -> at(c, add(q, i)) = at(b, i)) and productUpTo(c, add(q, r)) = compose(productUpTo(a, q), productUpTo(b, r))
                                        [by hypothesis with-concatenation-c]
                                      @agreement-pair |
                                        (forall i: Nat; less_than(i, q) -> at(c, i) = at(a, i)) and (forall i: Nat; less_than(i, r) -> at(c, add(q, i)) = at(b, i))
                                        [by and_elim_left concatenation-facts]
                                      @c-agrees-with-a |
                                        forall i: Nat; less_than(i, q) -> at(c, i) = at(a, i)
                                        [by and_elim_left agreement-pair]
                                      @c-agrees-with-b |
                                        forall i: Nat; less_than(i, r) -> at(c, add(q, i)) = at(b, i)
                                        [by and_elim_right agreement-pair]
                                      @c-product |
                                        productUpTo(c, add(q, r)) = compose(productUpTo(a, q), productUpTo(b, r))
                                        [by and_elim_right concatenation-facts]
                                      @c-transpositions |
                                        forall i: Nat; less_than(i, add(q, r)) -> isATransposition(at(c, i))
                                        [using specialize concatenationPreservesTranspositions(c, a, b, q, r) c-agrees-with-a c-agrees-with-b a-transpositions b-transpositions]
                                      @c-product-with-a |
                                        productUpTo(c, add(q, r)) = compose(productUpTo(w, k), productUpTo(b, r))
                                        [by rewrite a-product c-product]
                                      @c-product-with-both |
                                        productUpTo(c, add(q, r)) = compose(productUpTo(w, k), at(w, k))
                                        [by rewrite b-product c-product-with-a]
                                      @c-product-is-the-next |
                                        productUpTo(c, add(q, r)) = productUpTo(w, succ(k))
                                        [by rewrite next-product-unfolds c-product-with-both]
                                      @step-clauses |
                                        (forall i: Nat; less_than(i, add(q, r)) -> isATransposition(at(c, i))) and productUpTo(c, add(q, r)) = productUpTo(w, succ(k))
                                        [by and_intro c-transpositions c-product-is-the-next]
                                      @inner-step-witness |
                                        exists r2: Nat; (forall i: Nat; less_than(i, r2) -> isATransposition(at(c, i))) and productUpTo(c, r2) = productUpTo(w, succ(k))
                                        [by exists_intro(add(q, r)) step-clauses]
                                      @conclusion-step-witness |
                                        isAProductOfTranspositions(productUpTo(w, succ(k)))
                                        [by exists_intro(c) inner-step-witness]
                                    }
                                  @conclusion-with-c |
                                    isAProductOfTranspositions(productUpTo(w, succ(k)))
                                    [by exists_elim with-concatenation-c]
                                }
                              @conclusion-with-r |
                                isAProductOfTranspositions(productUpTo(w, succ(k)))
                                [by exists_elim with-last-length-r]
                            }
                          @conclusion-with-b |
                            isAProductOfTranspositions(productUpTo(w, succ(k)))
                            [by exists_elim with-last-sequence-b]
                        }
                      @conclusion-with-q |
                        isAProductOfTranspositions(productUpTo(w, succ(k)))
                        [by exists_elim with-first-length-q]
                    }
                  @conclusion-with-a |
                    isAProductOfTranspositions(productUpTo(w, succ(k)))
                    [by exists_elim with-first-sequence-a]
                }
              @conclusion-step-implication |
                (forall i: Nat; less_than(i, succ(k)) -> isAProductOfTranspositions(at(w, i))) -> isAProductOfTranspositions(productUpTo(w, succ(k)))
                [by implies_intro given-factors]
            }
          @induction-step-at-k |
            ((forall i: Nat; less_than(i, k) -> isAProductOfTranspositions(at(w, i))) -> isAProductOfTranspositions(productUpTo(w, k))) -> ((forall i: Nat; less_than(i, succ(k)) -> isAProductOfTranspositions(at(w, i))) -> isAProductOfTranspositions(productUpTo(w, succ(k))))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; ((forall i: Nat; less_than(i, k) -> isAProductOfTranspositions(at(w, i))) -> isAProductOfTranspositions(productUpTo(w, k))) -> ((forall i: Nat; less_than(i, succ(k)) -> isAProductOfTranspositions(at(w, i))) -> isAProductOfTranspositions(productUpTo(w, succ(k))))
        [by forall_intro induction-step]
      @conclusion-for-all-m |
        forall m: Nat; (forall i: Nat; less_than(i, m) -> isAProductOfTranspositions(at(w, i))) -> isAProductOfTranspositions(productUpTo(w, m))
        [using instantiation induction((fun k: Nat => (forall i: Nat; less_than(i, k) -> isAProductOfTranspositions(at(w, i))) -> isAProductOfTranspositions(productUpTo(w, k)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall w: Seq; forall m: Nat;
      (forall i: Nat; less_than(i, m) -> isAProductOfTranspositions(at(w, i))) ->
      isAProductOfTranspositions(productUpTo(w, m))
    [by forall_intro generalize-w]
qed

// -- Judson's Proposition 5.12 ------------------------------------------------------------------------

// A cycle is a product of transpositions, so a permutation of a finite set — a product of
// disjoint cycles — is a product of transpositions. (The identity is the empty product, so
// Judson's "containing at least two elements" is not needed.)
theorem everyPermutationOfAFiniteSetIsAProductOfTranspositions: forall f: Perm;
  isFinite(support(f)) -> isAProductOfTranspositions(f)
proof
  @generalize-f |
    fix f: Perm {
      @given-finite |
        assume isFinite(support(f)) {
          @support-is-finite |
            isFinite(support(f))
            [by hypothesis given-finite]
          @decomposes |
            decomposesIntoDisjointCycles(f)
            [using specialize everyPermutationOfAFiniteSetIsAProductOfDisjointCycles(f) support-is-finite]
          @with-cycle-sequence-w |
            unpack w: Seq from decomposes {
              @inner |
                exists m: Nat; (forall i: Nat; less_than(i, m) -> isACycle(at(w, i))) and (forall i: Nat; less_than(i, m) -> set.subset(support(at(w, i)), support(f))) and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> i != j -> permutation.disjointSupports(at(w, i), at(w, j))) and productUpTo(w, m) = f
                [by hypothesis with-cycle-sequence-w]
              @with-count-m |
                unpack m: Nat from inner {
                  @decomposition-facts |
                    (forall i: Nat; less_than(i, m) -> isACycle(at(w, i))) and (forall i: Nat; less_than(i, m) -> set.subset(support(at(w, i)), support(f))) and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> i != j -> permutation.disjointSupports(at(w, i), at(w, j))) and productUpTo(w, m) = f
                    [by hypothesis with-count-m]
                  @first-three |
                    (forall i: Nat; less_than(i, m) -> isACycle(at(w, i))) and (forall i: Nat; less_than(i, m) -> set.subset(support(at(w, i)), support(f))) and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> i != j -> permutation.disjointSupports(at(w, i), at(w, j)))
                    [by and_elim_left decomposition-facts]
                  @product-is-f |
                    productUpTo(w, m) = f
                    [by and_elim_right decomposition-facts]
                  @first-two |
                    (forall i: Nat; less_than(i, m) -> isACycle(at(w, i))) and (forall i: Nat; less_than(i, m) -> set.subset(support(at(w, i)), support(f)))
                    [by and_elim_left first-three]
                  @entries-are-cycles |
                    forall i: Nat; less_than(i, m) -> isACycle(at(w, i))
                    [by and_elim_left first-two]
                  // each cycle is a product of transpositions
                  @generalize-i |
                    fix i: Nat {
                      @given-i-in-range |
                        assume less_than(i, m) {
                          @i-in-range |
                            less_than(i, m)
                            [by hypothesis given-i-in-range]
                          @entry-is-a-cycle |
                            isACycle(at(w, i))
                            [using specialize entries-are-cycles(i) i-in-range]
                          @with-list-s |
                            unpack s: Points from entry-is-a-cycle {
                              @cycle-inner |
                                exists p: Nat; cycle_theory.distinct(s, succ(p)) and at(w, i) = cycle(s, succ(p))
                                [by hypothesis with-list-s]
                              @with-length-p |
                                unpack p: Nat from cycle-inner {
                                  @cycle-facts |
                                    cycle_theory.distinct(s, succ(p)) and at(w, i) = cycle(s, succ(p))
                                    [by hypothesis with-length-p]
                                  @entry-is-the-cycle |
                                    at(w, i) = cycle(s, succ(p))
                                    [by and_elim_right cycle-facts]
                                  @cycle-is-a-product |
                                    exists v: Seq; (forall j: Nat; less_than(j, p) -> isATransposition(at(v, j))) and productUpTo(v, p) = cycle(s, succ(p))
                                    [using specialize cycleIsAProductOfTranspositions(s, p)]
                                  @with-transposition-sequence-v |
                                    unpack v: Seq from cycle-is-a-product {
                                      @v-facts |
                                        (forall j: Nat; less_than(j, p) -> isATransposition(at(v, j))) and productUpTo(v, p) = cycle(s, succ(p))
                                        [by hypothesis with-transposition-sequence-v]
                                      @v-transpositions |
                                        forall j: Nat; less_than(j, p) -> isATransposition(at(v, j))
                                        [by and_elim_left v-facts]
                                      @v-product |
                                        productUpTo(v, p) = cycle(s, succ(p))
                                        [by and_elim_right v-facts]
                                      @v-product-is-the-entry |
                                        productUpTo(v, p) = at(w, i)
                                        [by rewrite entry-is-the-cycle v-product]
                                      @v-clauses |
                                        (forall j: Nat; less_than(j, p) -> isATransposition(at(v, j))) and productUpTo(v, p) = at(w, i)
                                        [by and_intro v-transpositions v-product-is-the-entry]
                                      @inner-witness |
                                        exists r: Nat; (forall j: Nat; less_than(j, r) -> isATransposition(at(v, j))) and productUpTo(v, r) = at(w, i)
                                        [by exists_intro(p) v-clauses]
                                      @conclusion-entry-witness |
                                        isAProductOfTranspositions(at(w, i))
                                        [by exists_intro(v) inner-witness]
                                    }
                                  @conclusion-with-v |
                                    isAProductOfTranspositions(at(w, i))
                                    [by exists_elim with-transposition-sequence-v]
                                }
                              @conclusion-with-p |
                                isAProductOfTranspositions(at(w, i))
                                [by exists_elim with-length-p]
                            }
                          @conclusion-with-s |
                            isAProductOfTranspositions(at(w, i))
                            [by exists_elim with-list-s]
                        }
                      @conclusion-entry-clause |
                        less_than(i, m) -> isAProductOfTranspositions(at(w, i))
                        [by implies_intro given-i-in-range]
                    }
                  @entries-are-products |
                    forall i: Nat; less_than(i, m) -> isAProductOfTranspositions(at(w, i))
                    [by forall_intro generalize-i]
                  @product-is-a-product-of-transpositions |
                    isAProductOfTranspositions(productUpTo(w, m))
                    [using specialize productOfProductsOfTranspositions(w, m) entries-are-products]
                  @conclusion-f-is |
                    isAProductOfTranspositions(f)
                    [by rewrite product-is-f product-is-a-product-of-transpositions]
                }
              @conclusion-with-m |
                isAProductOfTranspositions(f)
                [by exists_elim with-count-m]
            }
          @conclusion-with-w |
            isAProductOfTranspositions(f)
            [by exists_elim with-cycle-sequence-w]
        }
      @conclusion-implication |
        isFinite(support(f)) -> isAProductOfTranspositions(f)
        [by implies_intro given-finite]
    }
  @conclusion |
    forall f: Perm; isFinite(support(f)) -> isAProductOfTranspositions(f)
    [by forall_intro generalize-f]
qed
