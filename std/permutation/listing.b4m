// std/permutation/listing.b4m — SUB-LISTINGS and COMPARING listings.
//
// Two generic tools over the listings of std/permutation/count.b4m, for counting a CLASS of
// permutations of n letters (the even ones, say) once the whole group is listed:
//
//   * SPLITTING a listing by a predicate: the entries satisfying it, and those not, are
//     each listed without repetition, and the two lengths add up to the whole.
//   * EQUAL LENGTHS: two listings whose entries correspond one-to-one (here through a fixed
//     invertible map s, entry ↦ s ∘ entry) have the same length — the segment-size
//     uniqueness of std/set/finite.b4m, applied to the map on indices.
//
// A predicate over Fn cannot be a `define` parameter, so the lemmas about "the entries
// satisfying prop" are theorem SCHEMAS in `prop`, with the listing conditions spelled out.

import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import element <<< "std/element.b4m"
import set <<< "std/set.b4m"
import set_finite <<< "std/set/finite.b4m"
import function <<< "std/function.b4m"
import function_invertible <<< "std/function/invertible.b4m"
import permutation <<< "std/permutation.b4m"
import permutation_sequence <<< "std/permutation/sequence.b4m"
import indexed <<< "std/indexed.b4m"
import permutation_count <<< "std/permutation/count.b4m"

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
pred less_than = peano.less_than
fact induction = peano.induction
fact addSuccLeft = peano.addSuccLeft
fact addZeroLeft = peano.addZeroLeft
fact addZeroRight = peano.addZeroRight
fact addSuccRight = peano.addSuccRight
fact notLessThanZero = peano_order.notLessThanZero
fact lessThanSelf = peano_order.lessThanSelf
fact lessThanSuccRight = peano_order.lessThanSuccRight
fact lessThanSuccSplit = peano_order.lessThanSuccSplit
fact lessThanIrreflexive = peano_order.lessThanIrreflexive
fact lessThanTransitive = peano_order.lessThanTransitive
fact succReflectsOrder = peano_order.succReflectsOrder

sort Element = element.Element
sort Set = set.Set
pred member = set.member

sort Fn = function.Fn
const identityFn = function.identityFn
func apply = function.apply
func compose = function.compose
pred invertible = function.invertible
func inverse = function.inverse
fact inverseLeft = function.inverseLeft
fact functionFromGraph = function.functionFromGraph
fact composeAssoc = function_invertible.composeAssoc
fact composeIdentityLeft = function_invertible.composeIdentityLeft
fact identityIsAPermutation = permutation.identityIsAPermutation
fact transpositionIsAPermutation = permutation.transpositionIsAPermutation
fact transpositionPermutes = permutation.transpositionPermutes

func numeral = set_finite.numeral
func segment = set_finite.segment
func swap = set_finite.swap
fact numeralInjective = set_finite.numeralInjective
fact segmentMember = set_finite.segmentMember
fact numeralInSegment = set_finite.numeralInSegment
fact swapElsewhere = set_finite.swapElsewhere
fact segmentSizeIsUnique = set_finite.segmentSizeIsUnique

sort Seq = permutation_sequence.Seq
func at = permutation_sequence.at
fact atIsAPermutation = permutation_sequence.atIsAPermutation
fact seqSingleton = permutation_sequence.seqSingleton
fact seqConcat = permutation_sequence.seqConcat

define permutes(f, a) = permutation.permutes(f, a)
define bijectsOnto(f, a, b) = set_finite.bijectsOnto(f, a, b)
define equinumerous(a, b) = set_finite.equinumerous(a, b)
define permutesTheSegment(t, n) = permutation_count.permutesTheSegment(t, n)
define enumerates(w, n, m) = permutation_count.enumerates(w, n, m)

// -- two small tools -------------------------------------------------------------------------

// Composing with s and then with its inverse is the identity: reassociate and cancel.
theorem cancellingOnTheLeft: forall s: Fn; invertible(s) -> forall f: Fn;
  compose(inverse(s), compose(s, f)) = f
proof
  @generalize-s |
    fix s: Fn {
      @given-invertible |
        assume invertible(s) {
          @s-invertible |
            invertible(s)
            [by hypothesis given-invertible]
          @inverse-undoes-s |
            compose(inverse(s), s) = identityFn
            [using specialize inverseLeft(s) s-invertible]
          @generalize-f |
            fix f: Fn {
              @reassociated |
                compose(compose(inverse(s), s), f) = compose(inverse(s), compose(s, f))
                [using specialize composeAssoc(inverse(s), s, f)]
              @identity-times-f |
                compose(identityFn, f) = compose(inverse(s), compose(s, f))
                [by rewrite inverse-undoes-s reassociated]
              @identity-is-neutral |
                compose(identityFn, f) = f
                [using specialize composeIdentityLeft(f)]
              @conclusion-cancelled |
                compose(inverse(s), compose(s, f)) = f
                [by rewrite identity-times-f identity-is-neutral]
            }
          @discharge-f |
            forall f: Fn; compose(inverse(s), compose(s, f)) = f
            [by generalize generalize-f]
        }
      @conclusion-at-s |
        invertible(s) -> forall f: Fn; compose(inverse(s), compose(s, f)) = f
        [by discharge given-invertible]
    }
  @conclusion |
    forall s: Fn; invertible(s) -> forall f: Fn; compose(inverse(s), compose(s, f)) = f
    [by generalize generalize-s]
qed

// The transposition of two letters of the segment is a permutation of n letters (the
// general form of count.b4m's swappingWithTheTop).
theorem swappingTwoLetters: forall n: Nat; forall a: Nat; forall b: Nat;
  less_than(a, n) -> less_than(b, n) -> permutesTheSegment(swap(numeral(a), numeral(b)), n)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-a |
        fix a: Nat {
          @generalize-b |
            fix b: Nat {
              @given-a-in-range |
                assume less_than(a, n) {
                  @given-b-in-range |
                    assume less_than(b, n) {
                      @a-in-range |
                        less_than(a, n)
                        [by hypothesis given-a-in-range]
                      @b-in-range |
                        less_than(b, n)
                        [by hypothesis given-b-in-range]
                      @a-membership |
                        member(numeral(a), segment(n)) iff less_than(a, n)
                        [using specialize numeralInSegment(n, a)]
                      @b-membership |
                        member(numeral(b), segment(n)) iff less_than(b, n)
                        [using specialize numeralInSegment(n, b)]
                      @a-in-segment |
                        member(numeral(a), segment(n))
                        [using tautology a-membership a-in-range]
                      @b-in-segment |
                        member(numeral(b), segment(n))
                        [using tautology b-membership b-in-range]
                      @swap-invertible |
                        invertible(swap(numeral(a), numeral(b)))
                        [using specialize transpositionIsAPermutation(numeral(a), numeral(b))]
                      @swap-bijects |
                        permutes(swap(numeral(a), numeral(b)), segment(n))
                        [using specialize transpositionPermutes(numeral(a), numeral(b), segment(n)) a-in-segment b-in-segment]
                      @generalize-x |
                        fix x: Element {
                          @given-x-outside |
                            assume not member(x, segment(n)) {
                              @x-outside |
                                not member(x, segment(n))
                                [by hypothesis given-x-outside]
                              @suppose-x-is-a |
                                assume x = numeral(a) {
                                  @x-is-a |
                                    x = numeral(a)
                                    [by hypothesis suppose-x-is-a]
                                  @x-in-segment-as-a |
                                    member(x, segment(n))
                                    [by rewrite x-is-a a-in-segment]
                                }
                              @x-is-not-a |
                                x != numeral(a)
                                [by contradiction suppose-x-is-a x-in-segment-as-a x-outside]
                              @suppose-x-is-b |
                                assume x = numeral(b) {
                                  @x-is-b |
                                    x = numeral(b)
                                    [by hypothesis suppose-x-is-b]
                                  @x-in-segment-as-b |
                                    member(x, segment(n))
                                    [by rewrite x-is-b b-in-segment]
                                }
                              @x-is-not-b |
                                x != numeral(b)
                                [by contradiction suppose-x-is-b x-in-segment-as-b x-outside]
                              @conclusion-swap-fixes-x |
                                apply(swap(numeral(a), numeral(b)), x) = x
                                [using specialize swapElsewhere(numeral(a), numeral(b), x) x-is-not-a x-is-not-b]
                            }
                          @conclusion-fixes-at-x |
                            (not member(x, segment(n))) -> apply(swap(numeral(a), numeral(b)), x) = x
                            [by discharge given-x-outside]
                        }
                      @swap-fixes-outside |
                        forall x: Element; (not member(x, segment(n))) -> apply(swap(numeral(a), numeral(b)), x) = x
                        [by generalize generalize-x]
                      @conclusion-swap-permutes |
                        permutesTheSegment(swap(numeral(a), numeral(b)), n)
                        [using tautology swap-invertible swap-bijects swap-fixes-outside]
                    }
                  @conclusion-given-b |
                    less_than(b, n) -> permutesTheSegment(swap(numeral(a), numeral(b)), n)
                    [by discharge given-b-in-range]
                }
              @conclusion-at-b |
                less_than(a, n) -> less_than(b, n) -> permutesTheSegment(swap(numeral(a), numeral(b)), n)
                [by discharge given-a-in-range]
            }
          @discharge-b |
            forall b: Nat; less_than(a, n) -> less_than(b, n) -> permutesTheSegment(swap(numeral(a), numeral(b)), n)
            [by generalize generalize-b]
        }
      @discharge-a |
        forall a: Nat; forall b: Nat; less_than(a, n) -> less_than(b, n) -> permutesTheSegment(swap(numeral(a), numeral(b)), n)
        [by generalize generalize-a]
    }
  @conclusion |
    forall n: Nat; forall a: Nat; forall b: Nat;
      less_than(a, n) -> less_than(b, n) -> permutesTheSegment(swap(numeral(a), numeral(b)), n)
    [by generalize generalize-n]
qed

// -- sub-listings -----------------------------------------------------------------------------
//
// `v` (first p entries) is the SUB-LISTING of w's entries below k satisfying prop when: every
// entry of v is some w-entry below k satisfying prop; v does not repeat; and every w-entry
// below k satisfying prop is an entry of v. Spelled out at each use (prop is a schema
// parameter):
//
//   (forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i)))
//   and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
//   and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))

// Skipping an entry that fails prop: the sub-listing below k is the sub-listing below k+1.
// `Seq` over `Fn` IS an indexed container: model std/indexed.b4m for its generic listing
// lemmas. Only the postulates those lemmas actually USE need discharging — `skippingAnEntry`
// is pure index bookkeeping and uses none, so the guarded `seqSingleton`/`seqPrepend` (whose
// `invertible(x) ->` premise the abstract container does not carry) never come up.
model PermSeqIsIndexed {
  indexed.Indexed: Seq
  indexed.Item: Fn
  indexed.at: at
}

// Appending an entry that satisfies prop: concatenate the sub-listing with the singleton
// (at(w, k)); the new last entry is at(w, k), which differs from every earlier entry since w
// does not repeat below m.
theorem extendingASublisting(prop(Fn)): forall w: Seq; forall m: Nat;
  (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) ->
  forall k: Nat; less_than(k, m) -> prop(at(w, k)) ->
  forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) ->
  exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
proof
  @generalize-w |
    fix w: Seq {
      @generalize-m |
        fix m: Nat {
          @given-w-injective |
            assume (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) {
              @w-injective |
                (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j)
                [by hypothesis given-w-injective]
              @generalize-k |
                fix k: Nat {
                  @given-k-in-range |
                    assume less_than(k, m) {
                      @given-entry-satisfies |
                        assume prop(at(w, k)) {
                          @k-in-range |
                            less_than(k, m)
                            [by hypothesis given-k-in-range]
                          @entry-k-satisfies |
                            prop(at(w, k))
                            [by hypothesis given-entry-satisfies]
                          @generalize-v |
                            fix v: Seq {
                              @generalize-p |
                                fix p: Nat {
                                  @given-sublisting |
                                    assume ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) {
                                      @sublisting |
                                        ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                                        [by hypothesis given-sublisting]
                                      @entries |
                                        forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                        [using tautology sublisting]
                                      @injective |
                                        forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j
                                        [using tautology sublisting]
                                      @covers |
                                        forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                        [using tautology sublisting]
                                      @entry-k-invertible |
                                        invertible(at(w, k))
                                        [using specialize atIsAPermutation(w, k)]
                                      @singleton-exists |
                                        exists s: Seq; at(s, ZERO) = at(w, k) and permutation_sequence.productUpTo(s, succ(ZERO)) = at(w, k)
                                        [using specialize seqSingleton(at(w, k)) entry-k-invertible]
                                      @k-below-succ-k |
                                        less_than(k, succ(k))
                                        [using specialize lessThanSelf(k)]
                                      @p-below-succ-p |
                                        less_than(p, succ(p))
                                        [using specialize lessThanSelf(p)]
                                      @with-singleton-s |
                                        unpack s: Seq from singleton-exists {
                                          @singleton-facts |
                                            at(s, ZERO) = at(w, k) and permutation_sequence.productUpTo(s, succ(ZERO)) = at(w, k)
                                            [by hypothesis with-singleton-s]
                                          @singleton-head |
                                            at(s, ZERO) = at(w, k)
                                            [by and_lhs singleton-facts]
                                          @concatenation-exists |
                                            exists u: Seq; (forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i)) and permutation_sequence.productUpTo(u, add(p, succ(ZERO))) = compose(permutation_sequence.productUpTo(v, p), permutation_sequence.productUpTo(s, succ(ZERO)))
                                            [using specialize seqConcat(v, s, p, succ(ZERO))]
                                          @with-concatenation-u |
                                            unpack u: Seq from concatenation-exists {
                                              @concatenation-facts |
                                                (forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i)) and permutation_sequence.productUpTo(u, add(p, succ(ZERO))) = compose(permutation_sequence.productUpTo(v, p), permutation_sequence.productUpTo(s, succ(ZERO)))
                                                [by hypothesis with-concatenation-u]
                                              @agreement-pair |
                                                (forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i))
                                                [by and_lhs concatenation-facts]
                                              @prefix-agrees |
                                                forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)
                                                [by and_lhs agreement-pair]
                                              @block-agrees |
                                                forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i)
                                                [by and_rhs agreement-pair]
                                              @zero-below-one |
                                                less_than(ZERO, succ(ZERO))
                                                [using specialize lessThanSelf(ZERO)]
                                              @u-at-p-plus-zero |
                                                at(u, add(p, ZERO)) = at(s, ZERO)
                                                [using specialize block-agrees(ZERO) zero-below-one]
                                              @p-plus-zero-is-p |
                                                add(p, ZERO) = p
                                                [using specialize addZeroRight(p)]
                                              @u-at-p |
                                                at(u, p) = at(s, ZERO)
                                                [by rewrite p-plus-zero-is-p u-at-p-plus-zero]
                                              @last-entry-is-entry-k |
                                                at(u, p) = at(w, k)
                                                [using chain u-at-p singleton-head]

                                              // entries: the old ones, and the new last one
                                              @generalize-j-for-entries |
                                                fix j: Nat {
                                                  @given-j-in-range |
                                                    assume less_than(j, succ(p)) {
                                                      @j-in-range |
                                                        less_than(j, succ(p))
                                                        [by hypothesis given-j-in-range]
                                                      @j-splits |
                                                        less_than(j, p) or j = p
                                                        [using specialize lessThanSuccSplit(j, p) j-in-range]
                                                      @conclusion-entry-has-a-source |
                                                        exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                        case j-splits {
                                                          @when-j-old |
                                                            assume less_than(j, p) {
                                                              @j-old |
                                                                less_than(j, p)
                                                                [by hypothesis when-j-old]
                                                              @entry-is-old-entry |
                                                                at(u, j) = at(v, j)
                                                                [using specialize prefix-agrees(j) j-old]
                                                              @source-exists |
                                                                exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                                                [using specialize entries(j) j-old]
                                                              @with-source-i |
                                                                unpack i: Nat from source-exists {
                                                                  @source-facts |
                                                                    less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                                                    [by hypothesis with-source-i]
                                                                  @i-below-k |
                                                                    less_than(i, k)
                                                                    [using tautology source-facts]
                                                                  @old-entry-is-source |
                                                                    at(v, j) = at(w, i)
                                                                    [using tautology source-facts]
                                                                  @i-below-succ-k |
                                                                    less_than(i, succ(k))
                                                                    [using specialize lessThanSuccRight(i, k) i-below-k]
                                                                  @entry-is-source |
                                                                    at(u, j) = at(w, i)
                                                                    [using chain entry-is-old-entry old-entry-is-source]
                                                                  @source-facts-for-u |
                                                                    less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                                    [using tautology source-facts i-below-succ-k entry-is-source]
                                                                  @conclusion-witness-i |
                                                                    exists i2: Nat; less_than(i2, succ(k)) and at(u, j) = at(w, i2) and prop(at(w, i2))
                                                                    [by witness(i) source-facts-for-u]
                                                                }
                                                              @conclusion-old-source |
                                                                exists i2: Nat; less_than(i2, succ(k)) and at(u, j) = at(w, i2) and prop(at(w, i2))
                                                                [by unpacked with-source-i]
                                                            }
                                                          @when-j-new |
                                                            assume j = p {
                                                              @j-new |
                                                                j = p
                                                                [by hypothesis when-j-new]
                                                              @entry-is-entry-k |
                                                                at(u, j) = at(w, k)
                                                                [by rewrite j-new last-entry-is-entry-k]
                                                              @source-facts-for-k |
                                                                less_than(k, succ(k)) and at(u, j) = at(w, k) and prop(at(w, k))
                                                                [using tautology k-below-succ-k entry-is-entry-k entry-k-satisfies]
                                                              @conclusion-new-source |
                                                                exists i2: Nat; less_than(i2, succ(k)) and at(u, j) = at(w, i2) and prop(at(w, i2))
                                                                [by witness(k) source-facts-for-k]
                                                            }
                                                        }
                                                    }
                                                  @conclusion-entry-clause |
                                                    less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                    [by discharge given-j-in-range]
                                                }
                                              @entries-extended |
                                                forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                [by generalize generalize-j-for-entries]

                                              // no repeats: an old entry is some at(w, i0) with i0 < k, never at(w, k)
                                              @generalize-i-for-injective |
                                                fix i: Nat {
                                                  @generalize-j-for-injective |
                                                    fix j: Nat {
                                                      @given-i-in-range |
                                                        assume less_than(i, succ(p)) {
                                                          @given-j-in-range-too |
                                                            assume less_than(j, succ(p)) {
                                                              @given-entries-equal |
                                                                assume at(u, i) = at(u, j) {
                                                                  @i-in-range |
                                                                    less_than(i, succ(p))
                                                                    [by hypothesis given-i-in-range]
                                                                  @j-in-range-too |
                                                                    less_than(j, succ(p))
                                                                    [by hypothesis given-j-in-range-too]
                                                                  @entries-equal |
                                                                    at(u, i) = at(u, j)
                                                                    [by hypothesis given-entries-equal]
                                                                  @i-splits |
                                                                    less_than(i, p) or i = p
                                                                    [using specialize lessThanSuccSplit(i, p) i-in-range]
                                                                  @j-splits |
                                                                    less_than(j, p) or j = p
                                                                    [using specialize lessThanSuccSplit(j, p) j-in-range-too]
                                                                  @conclusion-indices-equal |
                                                                    i = j
                                                                    case i-splits {
                                                                      @when-i-old |
                                                                        assume less_than(i, p) {
                                                                          @i-old |
                                                                            less_than(i, p)
                                                                            [by hypothesis when-i-old]
                                                                          @entry-i-is-old |
                                                                            at(u, i) = at(v, i)
                                                                            [using specialize prefix-agrees(i) i-old]
                                                                          @conclusion-from-old-i |
                                                                            i = j
                                                                            case j-splits {
                                                                              @when-j-old |
                                                                                assume less_than(j, p) {
                                                                                  @j-old |
                                                                                    less_than(j, p)
                                                                                    [by hypothesis when-j-old]
                                                                                  @entry-j-is-old |
                                                                                    at(u, j) = at(v, j)
                                                                                    [using specialize prefix-agrees(j) j-old]
                                                                                  @old-i-is-entry-j |
                                                                                    at(v, i) = at(u, j)
                                                                                    [by rewrite entry-i-is-old entries-equal]
                                                                                  @old-entries-equal |
                                                                                    at(v, i) = at(v, j)
                                                                                    [by rewrite entry-j-is-old old-i-is-entry-j]
                                                                                  @conclusion-both-old |
                                                                                    i = j
                                                                                    [using specialize injective(i, j) i-old j-old old-entries-equal]
                                                                                }
                                                                              @when-j-new |
                                                                                assume j = p {
                                                                                  @j-new |
                                                                                    j = p
                                                                                    [by hypothesis when-j-new]
                                                                                  @entry-j-is-entry-k |
                                                                                    at(u, j) = at(w, k)
                                                                                    [by rewrite j-new last-entry-is-entry-k]
                                                                                  @old-i-is-entry-j |
                                                                                    at(v, i) = at(u, j)
                                                                                    [by rewrite entry-i-is-old entries-equal]
                                                                                  @old-i-is-entry-k |
                                                                                    at(v, i) = at(w, k)
                                                                                    [by rewrite entry-j-is-entry-k old-i-is-entry-j]
                                                                                  @source-exists |
                                                                                    exists i0: Nat; less_than(i0, k) and at(v, i) = at(w, i0) and prop(at(w, i0))
                                                                                    [using specialize entries(i) i-old]
                                                                                  @with-source-i0 |
                                                                                    unpack i0: Nat from source-exists {
                                                                                      @source-facts |
                                                                                        less_than(i0, k) and at(v, i) = at(w, i0) and prop(at(w, i0))
                                                                                        [by hypothesis with-source-i0]
                                                                                      @i0-below-k |
                                                                                        less_than(i0, k)
                                                                                        [using tautology source-facts]
                                                                                      @old-i-is-source |
                                                                                        at(v, i) = at(w, i0)
                                                                                        [using tautology source-facts]
                                                                                      @i0-in-range |
                                                                                        less_than(i0, m)
                                                                                        [using specialize lessThanTransitive(i0, k, m) i0-below-k k-in-range]
                                                                                      @source-is-entry-k |
                                                                                        at(w, i0) = at(w, k)
                                                                                        [by rewrite old-i-is-source old-i-is-entry-k]
                                                                                      @i0-is-k |
                                                                                        i0 = k
                                                                                        [using specialize w-injective(i0, k) i0-in-range k-in-range source-is-entry-k]
                                                                                      @k-below-itself |
                                                                                        less_than(k, k)
                                                                                        [by rewrite i0-is-k i0-below-k]
                                                                                      @k-not-below-itself |
                                                                                        not less_than(k, k)
                                                                                        [using specialize lessThanIrreflexive(k)]
                                                                                      @conclusion-old-new-ex_falso |
                                                                                        i = j
                                                                                        [by ex_falso k-below-itself k-not-below-itself]
                                                                                    }
                                                                                  @conclusion-old-then-new |
                                                                                    i = j
                                                                                    [by unpacked with-source-i0]
                                                                                }
                                                                            }
                                                                        }
                                                                      @when-i-new |
                                                                        assume i = p {
                                                                          @i-new |
                                                                            i = p
                                                                            [by hypothesis when-i-new]
                                                                          @entry-i-is-entry-k |
                                                                            at(u, i) = at(w, k)
                                                                            [by rewrite i-new last-entry-is-entry-k]
                                                                          @conclusion-from-new-i |
                                                                            i = j
                                                                            case j-splits {
                                                                              @when-j-old |
                                                                                assume less_than(j, p) {
                                                                                  @j-old |
                                                                                    less_than(j, p)
                                                                                    [by hypothesis when-j-old]
                                                                                  @entry-j-is-old |
                                                                                    at(u, j) = at(v, j)
                                                                                    [using specialize prefix-agrees(j) j-old]
                                                                                  @entry-i-is-old-j |
                                                                                    at(u, i) = at(v, j)
                                                                                    [by rewrite entry-j-is-old entries-equal]
                                                                                  @old-j-is-entry-k |
                                                                                    at(v, j) = at(w, k)
                                                                                    [by rewrite entry-i-is-old-j entry-i-is-entry-k]
                                                                                  @source-exists |
                                                                                    exists j0: Nat; less_than(j0, k) and at(v, j) = at(w, j0) and prop(at(w, j0))
                                                                                    [using specialize entries(j) j-old]
                                                                                  @with-source-j0 |
                                                                                    unpack j0: Nat from source-exists {
                                                                                      @source-facts |
                                                                                        less_than(j0, k) and at(v, j) = at(w, j0) and prop(at(w, j0))
                                                                                        [by hypothesis with-source-j0]
                                                                                      @j0-below-k |
                                                                                        less_than(j0, k)
                                                                                        [using tautology source-facts]
                                                                                      @old-j-is-source |
                                                                                        at(v, j) = at(w, j0)
                                                                                        [using tautology source-facts]
                                                                                      @j0-in-range |
                                                                                        less_than(j0, m)
                                                                                        [using specialize lessThanTransitive(j0, k, m) j0-below-k k-in-range]
                                                                                      @source-is-entry-k |
                                                                                        at(w, j0) = at(w, k)
                                                                                        [by rewrite old-j-is-source old-j-is-entry-k]
                                                                                      @j0-is-k |
                                                                                        j0 = k
                                                                                        [using specialize w-injective(j0, k) j0-in-range k-in-range source-is-entry-k]
                                                                                      @k-below-itself |
                                                                                        less_than(k, k)
                                                                                        [by rewrite j0-is-k j0-below-k]
                                                                                      @k-not-below-itself |
                                                                                        not less_than(k, k)
                                                                                        [using specialize lessThanIrreflexive(k)]
                                                                                      @conclusion-new-old-ex_falso |
                                                                                        i = j
                                                                                        [by ex_falso k-below-itself k-not-below-itself]
                                                                                    }
                                                                                  @conclusion-new-then-old |
                                                                                    i = j
                                                                                    [by unpacked with-source-j0]
                                                                                }
                                                                              @when-j-new |
                                                                                assume j = p {
                                                                                  @j-new |
                                                                                    j = p
                                                                                    [by hypothesis when-j-new]
                                                                                  @conclusion-both-new |
                                                                                    i = j
                                                                                    [by rewrite j-new i-new]
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                              @conclusion-given-equal |
                                                                at(u, i) = at(u, j) -> i = j
                                                                [by discharge given-entries-equal]
                                                            }
                                                          @conclusion-given-j |
                                                            less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                            [by discharge given-j-in-range-too]
                                                        }
                                                      @conclusion-injective-at-i-j |
                                                        less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                        [by discharge given-i-in-range]
                                                    }
                                                  @discharge-j-for-injective |
                                                    forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                    [by generalize generalize-j-for-injective]
                                                }
                                              @injective-extended |
                                                forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                [by generalize generalize-i-for-injective]

                                              // covering: an old source is covered as before, the new one by the last entry
                                              @generalize-i-for-covers |
                                                fix i: Nat {
                                                  @given-i-below-succ-k |
                                                    assume less_than(i, succ(k)) {
                                                      @given-i-satisfies |
                                                        assume prop(at(w, i)) {
                                                          @i-below-succ-k |
                                                            less_than(i, succ(k))
                                                            [by hypothesis given-i-below-succ-k]
                                                          @i-satisfies |
                                                            prop(at(w, i))
                                                            [by hypothesis given-i-satisfies]
                                                          @i-splits |
                                                            less_than(i, k) or i = k
                                                            [using specialize lessThanSuccSplit(i, k) i-below-succ-k]
                                                          @conclusion-covered |
                                                            exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                            case i-splits {
                                                              @when-i-below-k |
                                                                assume less_than(i, k) {
                                                                  @i-below-k |
                                                                    less_than(i, k)
                                                                    [by hypothesis when-i-below-k]
                                                                  @old-index-exists |
                                                                    exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                                                    [using specialize covers(i) i-below-k i-satisfies]
                                                                  @with-old-index-j |
                                                                    unpack j: Nat from old-index-exists {
                                                                      @old-index-facts |
                                                                        less_than(j, p) and at(v, j) = at(w, i)
                                                                        [by hypothesis with-old-index-j]
                                                                      @j-old |
                                                                        less_than(j, p)
                                                                        [by and_lhs old-index-facts]
                                                                      @old-entry-is-source |
                                                                        at(v, j) = at(w, i)
                                                                        [by and_rhs old-index-facts]
                                                                      @j-in-range |
                                                                        less_than(j, succ(p))
                                                                        [using specialize lessThanSuccRight(j, p) j-old]
                                                                      @entry-is-old-entry |
                                                                        at(u, j) = at(v, j)
                                                                        [using specialize prefix-agrees(j) j-old]
                                                                      @entry-is-source |
                                                                        at(u, j) = at(w, i)
                                                                        [using chain entry-is-old-entry old-entry-is-source]
                                                                      @j-in-range-and-hits |
                                                                        less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                                        [by both j-in-range entry-is-source]
                                                                      @conclusion-witness-j |
                                                                        exists j2: Nat; less_than(j2, succ(p)) and at(u, j2) = at(w, i)
                                                                        [by witness(j) j-in-range-and-hits]
                                                                    }
                                                                  @conclusion-covered-below |
                                                                    exists j2: Nat; less_than(j2, succ(p)) and at(u, j2) = at(w, i)
                                                                    [by unpacked with-old-index-j]
                                                                }
                                                              @when-i-is-k |
                                                                assume i = k {
                                                                  @i-is-k |
                                                                    i = k
                                                                    [by hypothesis when-i-is-k]
                                                                  @last-entry-is-source |
                                                                    at(u, p) = at(w, i)
                                                                    [by rewrite i-is-k last-entry-is-entry-k]
                                                                  @p-in-range-and-hits |
                                                                    less_than(p, succ(p)) and at(u, p) = at(w, i)
                                                                    [by both p-below-succ-p last-entry-is-source]
                                                                  @conclusion-covered-by-last |
                                                                    exists j2: Nat; less_than(j2, succ(p)) and at(u, j2) = at(w, i)
                                                                    [by witness(p) p-in-range-and-hits]
                                                                }
                                                            }
                                                        }
                                                      @conclusion-given-satisfies |
                                                        prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                        [by discharge given-i-satisfies]
                                                    }
                                                  @conclusion-covers-at-i |
                                                    less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                    [by discharge given-i-below-succ-k]
                                                }
                                              @covers-extended |
                                                forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                [by generalize generalize-i-for-covers]
                                              @extended-sublisting |
                                                ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)))
                                                [using tautology entries-extended injective-extended covers-extended]
                                              @conclusion-witness-u |
                                                exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                                [by witness(u) extended-sublisting]
                                            }
                                          @conclusion-with-u |
                                            exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                            [by unpacked with-concatenation-u]
                                        }
                                      @conclusion-with-s |
                                        exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                        [by unpacked with-singleton-s]
                                    }
                                  @conclusion-at-p |
                                    ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                    [by discharge given-sublisting]
                                }
                              @discharge-p |
                                forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                [by generalize generalize-p]
                            }
                          @discharge-v |
                            forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                            [by generalize generalize-v]
                        }
                      @conclusion-given-satisfies |
                        prop(at(w, k)) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                        [by discharge given-entry-satisfies]
                    }
                  @conclusion-at-k |
                    less_than(k, m) -> prop(at(w, k)) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                    [by discharge given-k-in-range]
                }
              @discharge-k |
                forall k: Nat; less_than(k, m) -> prop(at(w, k)) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                [by generalize generalize-k]
            }
          @conclusion-at-m |
            (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, m) -> prop(at(w, k)) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
            [by discharge given-w-injective]
        }
      @discharge-m |
        forall m: Nat; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, m) -> prop(at(w, k)) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
        [by generalize generalize-m]
    }
  @conclusion |
    forall w: Seq; forall m: Nat;
      (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) ->
      forall k: Nat; less_than(k, m) -> prop(at(w, k)) ->
      forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) ->
      exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
    [by generalize generalize-w]
qed

// The entries of w below k split into those satisfying prop and those not, each listed
// without repetition, with lengths adding to k: induction on k, extending one sub-listing
// and skipping in the other according to whether at(w, k) satisfies prop.
theorem splittingAPrefix(prop(Fn)): forall w: Seq; forall m: Nat; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, succ(m)) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
proof
  @generalize-w |
    fix w: Seq {
      @generalize-m |
        fix m: Nat {
          @given-w-injective |
            assume (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) {
              @w-injective |
                (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j)
                [by hypothesis given-w-injective]

              // base case: nothing below ZERO, so the empty sub-listings (any sequence, length ZERO)
              @base-case-proof |
                assume less_than(ZERO, succ(m)) {
                  @identity-invertible |
                    invertible(identityFn)
                    [by cite identityIsAPermutation]
                  @some-sequence-exists |
                    exists u: Seq; at(u, ZERO) = identityFn and permutation_sequence.productUpTo(u, succ(ZERO)) = identityFn
                    [using specialize seqSingleton(identityFn) identity-invertible]
                  @zero-plus-zero |
                    add(ZERO, ZERO) = ZERO
                    [using specialize addZeroLeft(ZERO)]
                  @with-any-u |
                    unpack u: Seq from some-sequence-exists {
                      @vacuous-entries |
                        fix j: Nat {
                          @nothing-below-zero |
                            not less_than(j, ZERO)
                            [using specialize notLessThanZero(j)]
                          @conclusion-vacuous-entry |
                            less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))
                            [using tautology nothing-below-zero]
                        }
                      @no-entries |
                        forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))
                        [by generalize vacuous-entries]
                      @vacuous-entries-complement |
                        fix j: Nat {
                          @nothing-below-zero |
                            not less_than(j, ZERO)
                            [using specialize notLessThanZero(j)]
                          @conclusion-vacuous-entry-complement |
                            less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and (not prop(at(w, i)))
                            [using tautology nothing-below-zero]
                        }
                      @no-entries-complement |
                        forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and (not prop(at(w, i)))
                        [by generalize vacuous-entries-complement]
                      @vacuous-injective |
                        fix i: Nat {
                          @vacuous-injective-inner |
                            fix j: Nat {
                              @nothing-below-zero |
                                not less_than(i, ZERO)
                                [using specialize notLessThanZero(i)]
                              @conclusion-vacuous-injective-clause |
                                less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j
                                [using tautology nothing-below-zero]
                            }
                          @discharge-j-vacuous |
                            forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j
                            [by generalize vacuous-injective-inner]
                        }
                      @no-collisions |
                        forall i: Nat; forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j
                        [by generalize vacuous-injective]
                      @vacuous-covers |
                        fix i: Nat {
                          @nothing-below-zero |
                            not less_than(i, ZERO)
                            [using specialize notLessThanZero(i)]
                          @conclusion-vacuous-covers-clause |
                            less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i)
                            [using tautology nothing-below-zero]
                        }
                      @nothing-to-cover |
                        forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i)
                        [by generalize vacuous-covers]
                      @vacuous-covers-complement |
                        fix i: Nat {
                          @nothing-below-zero |
                            not less_than(i, ZERO)
                            [using specialize notLessThanZero(i)]
                          @conclusion-vacuous-covers-complement-clause |
                            less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i)
                            [using tautology nothing-below-zero]
                        }
                      @nothing-to-cover-complement |
                        forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i)
                        [by generalize vacuous-covers-complement]
                      @empty-sublistings |
                        add(ZERO, ZERO) = ZERO and ((forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i))) and ((forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i)))
                        [using tautology zero-plus-zero no-entries no-collisions nothing-to-cover no-entries-complement nothing-to-cover-complement]
                      @with-q |
                        exists q: Nat; add(ZERO, q) = ZERO and ((forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(u, j) = at(w, i)))
                        [by witness(ZERO) empty-sublistings]
                      @with-v2 |
                        exists v2: Seq; exists q: Nat; add(ZERO, q) = ZERO and ((forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [by witness(u) with-q]
                      @with-p |
                        exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = ZERO and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(u, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [by witness(ZERO) with-v2]
                      @conclusion-witness-u |
                        exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = ZERO and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, ZERO) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [by witness(u) with-p]
                    }
                  @conclusion-base |
                    exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = ZERO and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, ZERO) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                    [by unpacked with-any-u]
                }
              @base-case |
                less_than(ZERO, succ(m)) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = ZERO and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, ZERO) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                [by discharge base-case-proof]

              // inductive step
              @induction-step |
                fix k: Nat {
                  @given-inductive-hypothesis |
                    assume less_than(k, succ(m)) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i))) {
                      @inductive-hypothesis |
                        less_than(k, succ(m)) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [by hypothesis given-inductive-hypothesis]
                      @given-succ-k-in-range |
                        assume less_than(succ(k), succ(m)) {
                          @succ-k-in-range |
                            less_than(succ(k), succ(m))
                            [by hypothesis given-succ-k-in-range]
                          @k-below-m |
                            less_than(k, m)
                            [using specialize succReflectsOrder(k, m) succ-k-in-range]
                          @k-in-range |
                            less_than(k, succ(m))
                            [using specialize lessThanSuccRight(k, m) k-below-m]
                          @split-below-k |
                            exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                            [by modus_ponens inductive-hypothesis k-in-range]
                          @extending-satisfying |
                            forall w0: Seq; forall m0: Nat; (forall i: Nat; forall j: Nat; less_than(i, m0) -> less_than(j, m0) -> at(w0, i) = at(w0, j) -> i = j) -> forall k0: Nat; less_than(k0, m0) -> prop(at(w0, k0)) -> forall v0: Seq; forall p0: Nat; ((forall j: Nat; less_than(j, p0) -> exists i: Nat; less_than(i, k0) and at(v0, j) = at(w0, i) and prop(at(w0, i))) and (forall i: Nat; forall j: Nat; less_than(i, p0) -> less_than(j, p0) -> at(v0, i) = at(v0, j) -> i = j) and (forall i: Nat; less_than(i, k0) -> prop(at(w0, i)) -> exists j: Nat; less_than(j, p0) and at(v0, j) = at(w0, i))) -> exists v20: Seq; ((forall j: Nat; less_than(j, succ(p0)) -> exists i: Nat; less_than(i, succ(k0)) and at(v20, j) = at(w0, i) and prop(at(w0, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p0)) -> less_than(j, succ(p0)) -> at(v20, i) = at(v20, j) -> i = j) and (forall i: Nat; less_than(i, succ(k0)) -> prop(at(w0, i)) -> exists j: Nat; less_than(j, succ(p0)) and at(v20, j) = at(w0, i)))
                            [using instantiation extendingASublisting((fun f: Fn => prop(f)))]
                          @extending-failing |
                            forall w0: Seq; forall m0: Nat; (forall i: Nat; forall j: Nat; less_than(i, m0) -> less_than(j, m0) -> at(w0, i) = at(w0, j) -> i = j) -> forall k0: Nat; less_than(k0, m0) -> (not prop(at(w0, k0))) -> forall v0: Seq; forall p0: Nat; ((forall j: Nat; less_than(j, p0) -> exists i: Nat; less_than(i, k0) and at(v0, j) = at(w0, i) and (not prop(at(w0, i)))) and (forall i: Nat; forall j: Nat; less_than(i, p0) -> less_than(j, p0) -> at(v0, i) = at(v0, j) -> i = j) and (forall i: Nat; less_than(i, k0) -> (not prop(at(w0, i))) -> exists j: Nat; less_than(j, p0) and at(v0, j) = at(w0, i))) -> exists v20: Seq; ((forall j: Nat; less_than(j, succ(p0)) -> exists i: Nat; less_than(i, succ(k0)) and at(v20, j) = at(w0, i) and (not prop(at(w0, i)))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p0)) -> less_than(j, succ(p0)) -> at(v20, i) = at(v20, j) -> i = j) and (forall i: Nat; less_than(i, succ(k0)) -> (not prop(at(w0, i))) -> exists j: Nat; less_than(j, succ(p0)) and at(v20, j) = at(w0, i)))
                            [using instantiation extendingASublisting((fun f: Fn => not prop(f)))]
                          @skipping-satisfying |
