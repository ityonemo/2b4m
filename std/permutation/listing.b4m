// A sub-listing of a listing of the permutations of n letters, taken over the whole listing,
// lists the permutations of n letters satisfying prop: entries are entries of w (so they
// permute the segment), and a permutation satisfying prop is an entry of w, hence of v.
theorem translatingASublisting(prop(Fn)): forall n: Nat; forall m: Nat; forall w: Seq; enumerates(w, n, m) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t))
proof
  @generalize-n |
    fix n: Nat {
      @generalize-m |
        fix m: Nat {
          @generalize-w |
            fix w: Seq {
              @given-enumeration |
                assume enumerates(w, n, m) {
                  @enumeration |
                    enumerates(w, n, m)
                    [by hypothesis given-enumeration]
                  @w-entries |
                    forall j: Nat; less_than(j, m) -> permutesTheSegment(at(w, j), n)
                    [using tautology enumeration]
                  @w-covers |
                    forall t: Fn; permutesTheSegment(t, n) -> exists j: Nat; less_than(j, m) and at(w, j) = t
                    [using tautology enumeration]
                  @generalize-v |
                    fix v: Seq {
                      @generalize-p |
                        fix p: Nat {
                          @given-sublisting |
                            assume ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) {
                              @sublisting |
                                ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                                [by hypothesis given-sublisting]
                              @entries |
                                forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))
                                [using tautology sublisting]
                              @injective |
                                forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j
                                [using tautology sublisting]
                              @covers |
                                forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                [using tautology sublisting]

                              // entries permute the segment and satisfy prop
                              @generalize-j |
                                fix j: Nat {
                                  @given-j-in-range |
                                    assume less_than(j, p) {
                                      @j-in-range |
                                        less_than(j, p)
                                        [by hypothesis given-j-in-range]
                                      @source-exists |
                                        exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))
                                        [using specialize entries(j) j-in-range]
                                      @with-source-i |
                                        unpack i: Nat from source-exists {
                                          @source-facts |
                                            less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))
                                            [by hypothesis with-source-i]
                                          @i-in-range |
                                            less_than(i, m)
                                            [using tautology source-facts]
                                          @entry-is-source |
                                            at(v, j) = at(w, i)
                                            [using tautology source-facts]
                                          @source-satisfies |
                                            prop(at(w, i))
                                            [using tautology source-facts]
                                          @source-permutes |
                                            permutesTheSegment(at(w, i), n)
                                            [using specialize w-entries(i) i-in-range]
                                          @entry-permutes |
                                            permutesTheSegment(at(v, j), n)
                                            [by rewrite entry-is-source source-permutes]
                                          @entry-satisfies |
                                            prop(at(v, j))
                                            [by rewrite entry-is-source source-satisfies]
                                          @conclusion-entry-in-class |
                                            permutesTheSegment(at(v, j), n) and prop(at(v, j))
                                            [by both entry-permutes entry-satisfies]
                                        }
                                      @conclusion-entry-in-class-at-j |
                                        permutesTheSegment(at(v, j), n) and prop(at(v, j))
                                        [by unpacked with-source-i]
                                    }
                                  @conclusion-entry-clause |
                                    less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))
                                    [by discharge given-j-in-range]
                                }
                              @entries-in-class |
                                forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))
                                [by generalize generalize-j]

                              // every permutation of the segment satisfying prop is an entry
                              @generalize-t |
                                fix t: Fn {
                                  @given-t-permutes |
                                    assume permutesTheSegment(t, n) {
                                      @given-t-satisfies |
                                        assume prop(t) {
                                          @t-permutes |
                                            permutesTheSegment(t, n)
                                            [by hypothesis given-t-permutes]
                                          @t-satisfies |
                                            prop(t)
                                            [by hypothesis given-t-satisfies]
                                          @w-index-exists |
                                            exists i: Nat; less_than(i, m) and at(w, i) = t
                                            [using specialize w-covers(t) t-permutes]
                                          @with-w-index-i |
                                            unpack i: Nat from w-index-exists {
                                              @w-index-facts |
                                                less_than(i, m) and at(w, i) = t
                                                [by hypothesis with-w-index-i]
                                              @i-in-range |
                                                less_than(i, m)
                                                [by and_lhs w-index-facts]
                                              @w-entry-is-t |
                                                at(w, i) = t
                                                [by and_rhs w-index-facts]
                                              @w-entry-satisfies |
                                                prop(at(w, i))
                                                [by rewrite w-entry-is-t t-satisfies]
                                              @v-index-exists |
                                                exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                                [using specialize covers(i) i-in-range w-entry-satisfies]
                                              @with-v-index-j |
                                                unpack j: Nat from v-index-exists {
                                                  @v-index-facts |
                                                    less_than(j, p) and at(v, j) = at(w, i)
                                                    [by hypothesis with-v-index-j]
                                                  @j-in-range |
                                                    less_than(j, p)
                                                    [by and_lhs v-index-facts]
                                                  @v-entry-is-w-entry |
                                                    at(v, j) = at(w, i)
                                                    [by and_rhs v-index-facts]
                                                  @v-entry-is-t |
                                                    at(v, j) = t
                                                    [using chain v-entry-is-w-entry w-entry-is-t]
                                                  @j-in-range-and-hits |
                                                    less_than(j, p) and at(v, j) = t
                                                    [by both j-in-range v-entry-is-t]
                                                  @conclusion-witness-j |
                                                    exists j2: Nat; less_than(j2, p) and at(v, j2) = t
                                                    [by witness(j) j-in-range-and-hits]
                                                }
                                              @conclusion-with-j |
                                                exists j2: Nat; less_than(j2, p) and at(v, j2) = t
                                                [by unpacked with-v-index-j]
                                            }
                                          @conclusion-t-is-listed |
                                            exists j2: Nat; less_than(j2, p) and at(v, j2) = t
                                            [by unpacked with-w-index-i]
                                        }
                                      @conclusion-given-satisfies |
                                        prop(t) -> exists j2: Nat; less_than(j2, p) and at(v, j2) = t
                                        [by discharge given-t-satisfies]
                                    }
                                  @conclusion-covers-at-t |
                                    permutesTheSegment(t, n) -> prop(t) -> exists j2: Nat; less_than(j2, p) and at(v, j2) = t
                                    [by discharge given-t-permutes]
                                }
                              @class-is-covered |
                                forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j2: Nat; less_than(j2, p) and at(v, j2) = t
                                [by generalize generalize-t]
                              @conclusion-lists-the-class |
                                ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t))
                                [using tautology entries-in-class injective class-is-covered]
                            }
                          @conclusion-at-p |
                            ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t))
                            [by discharge given-sublisting]
                        }
                      @discharge-p |
                        forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t))
                        [by generalize generalize-p]
                    }
                  @discharge-v |
                    forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t))
                    [by generalize generalize-v]
                }
              @conclusion-given-enumeration |
                enumerates(w, n, m) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t))
                [by discharge given-enumeration]
            }
          @discharge-w |
            forall w: Seq; enumerates(w, n, m) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t))
            [by generalize generalize-w]
        }
      @discharge-m |
        forall m: Nat; forall w: Seq; enumerates(w, n, m) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t))
        [by generalize generalize-m]
    }
  @conclusion |
    forall n: Nat; forall m: Nat; forall w: Seq; enumerates(w, n, m) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t))
    [by generalize generalize-n]
qed

// SPLITTING A LISTING: the permutations of n letters satisfying prop, and those not, are
// each listed without repetition, with lengths adding to the whole listing's.
theorem splittingAListing(prop(Fn)): forall n: Nat; forall m: Nat; forall w: Seq; enumerates(w, n, m) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t)) and ((forall j: Nat; less_than(j, q) -> (permutesTheSegment(at(v2, j), n) and (not prop(at(v2, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q) and at(v2, j) = t))
proof
  @generalize-n |
    fix n: Nat {
      @generalize-m |
        fix m: Nat {
          @generalize-w |
            fix w: Seq {
              @given-enumeration |
                assume enumerates(w, n, m) {
                  @enumeration |
                    enumerates(w, n, m)
                    [by hypothesis given-enumeration]
                  @w-injective |
                    (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j)
                    [using tautology enumeration]
                  @m-below-succ-m |
                    less_than(m, succ(m))
                    [using specialize lessThanSelf(m)]
                  @prefix-splitting |
                    forall w0: Seq; forall m0: Nat; (forall i: Nat; forall j: Nat; less_than(i, m0) -> less_than(j, m0) -> at(w0, i) = at(w0, j) -> i = j) -> forall k0: Nat; less_than(k0, succ(m0)) -> exists v0: Seq; exists p0: Nat; exists v20: Seq; exists q0: Nat; add(p0, q0) = k0 and ((forall j: Nat; less_than(j, p0) -> exists i: Nat; less_than(i, k0) and at(v0, j) = at(w0, i) and prop(at(w0, i))) and (forall i: Nat; forall j: Nat; less_than(i, p0) -> less_than(j, p0) -> at(v0, i) = at(v0, j) -> i = j) and (forall i: Nat; less_than(i, k0) -> prop(at(w0, i)) -> exists j: Nat; less_than(j, p0) and at(v0, j) = at(w0, i))) and ((forall j: Nat; less_than(j, q0) -> exists i: Nat; less_than(i, k0) and at(v20, j) = at(w0, i) and (not prop(at(w0, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q0) -> less_than(j, q0) -> at(v20, i) = at(v20, j) -> i = j) and (forall i: Nat; less_than(i, k0) -> (not prop(at(w0, i))) -> exists j: Nat; less_than(j, q0) and at(v20, j) = at(w0, i)))
                    [using instantiation splittingAPrefix((fun f: Fn => prop(f)))]
                  @translating-satisfying |
                    forall n0: Nat; forall m0: Nat; forall w0: Seq; enumerates(w0, n0, m0) -> forall v0: Seq; forall p0: Nat; ((forall j: Nat; less_than(j, p0) -> exists i: Nat; less_than(i, m0) and at(v0, j) = at(w0, i) and prop(at(w0, i))) and (forall i: Nat; forall j: Nat; less_than(i, p0) -> less_than(j, p0) -> at(v0, i) = at(v0, j) -> i = j) and (forall i: Nat; less_than(i, m0) -> prop(at(w0, i)) -> exists j: Nat; less_than(j, p0) and at(v0, j) = at(w0, i))) -> ((forall j: Nat; less_than(j, p0) -> (permutesTheSegment(at(v0, j), n0) and prop(at(v0, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p0) -> less_than(j, p0) -> at(v0, i) = at(v0, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n0) -> prop(t) -> exists j: Nat; less_than(j, p0) and at(v0, j) = t))
                    [using instantiation translatingASublisting((fun f: Fn => prop(f)))]
                  @translating-failing |
                    forall n0: Nat; forall m0: Nat; forall w0: Seq; enumerates(w0, n0, m0) -> forall v0: Seq; forall p0: Nat; ((forall j: Nat; less_than(j, p0) -> exists i: Nat; less_than(i, m0) and at(v0, j) = at(w0, i) and (not prop(at(w0, i)))) and (forall i: Nat; forall j: Nat; less_than(i, p0) -> less_than(j, p0) -> at(v0, i) = at(v0, j) -> i = j) and (forall i: Nat; less_than(i, m0) -> (not prop(at(w0, i))) -> exists j: Nat; less_than(j, p0) and at(v0, j) = at(w0, i))) -> ((forall j: Nat; less_than(j, p0) -> (permutesTheSegment(at(v0, j), n0) and (not prop(at(v0, j))))) and (forall i: Nat; forall j: Nat; less_than(i, p0) -> less_than(j, p0) -> at(v0, i) = at(v0, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n0) -> (not prop(t)) -> exists j: Nat; less_than(j, p0) and at(v0, j) = t))
                    [using instantiation translatingASublisting((fun f: Fn => not prop(f)))]
                  @whole-split |
                    exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                    [using specialize prefix-splitting(w, m, m) w-injective m-below-succ-m]
                  @with-v |
                    unpack v: Seq from whole-split {
                      @after-v |
                        exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [by hypothesis with-v]
                      @with-p |
                        unpack p: Nat from after-v {
                          @after-p |
                            exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                            [by hypothesis with-p]
                          @with-v2 |
                            unpack v2: Seq from after-p {
                              @after-v2 |
                                exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                [by hypothesis with-v2]
                              @with-q |
                                unpack q: Nat from after-v2 {
                                  @split-facts |
                                    add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                    [by hypothesis with-q]
                                  @lengths-add |
                                    add(p, q) = m
                                    [using tautology split-facts]
                                  @satisfying-sublisting |
                                    ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                                    [using tautology split-facts]
                                  @failing-sublisting |
                                    ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                    [using tautology split-facts]
                                  @satisfying-listed |
                                    ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t))
                                    [using specialize translating-satisfying(n, m, w, v, p) enumeration satisfying-sublisting]
                                  @failing-listed |
                                    ((forall j: Nat; less_than(j, q) -> (permutesTheSegment(at(v2, j), n) and (not prop(at(v2, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q) and at(v2, j) = t))
                                    [using specialize translating-failing(n, m, w, v2, q) enumeration failing-sublisting]
                                  @both-listed |
                                    add(p, q) = m and ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t)) and ((forall j: Nat; less_than(j, q) -> (permutesTheSegment(at(v2, j), n) and (not prop(at(v2, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q) and at(v2, j) = t))
                                    [using tautology lengths-add satisfying-listed failing-listed]
                                  @with-q3 |
                                    exists q3: Nat; add(p, q3) = m and ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v2, j), n) and (not prop(at(v2, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v2, i) = at(v2, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v2, j) = t))
                                    [by witness(q) both-listed]
                                  @with-v4 |
                                    exists v4: Seq; exists q3: Nat; add(p, q3) = m and ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v4, j), n) and (not prop(at(v4, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v4, j) = t))
                                    [by witness(v2) with-q3]
                                  @with-p3 |
                                    exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = m and ((forall j: Nat; less_than(j, p3) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p3) and at(v, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v4, j), n) and (not prop(at(v4, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v4, j) = t))
                                    [by witness(p) with-v4]
                                  @conclusion-witness-v |
                                    exists v3: Seq; exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = m and ((forall j: Nat; less_than(j, p3) -> (permutesTheSegment(at(v3, j), n) and prop(at(v3, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p3) and at(v3, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v4, j), n) and (not prop(at(v4, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v4, j) = t))
                                    [by witness(v) with-p3]
                                }
                              @conclusion-with-q |
                                exists v3: Seq; exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = m and ((forall j: Nat; less_than(j, p3) -> (permutesTheSegment(at(v3, j), n) and prop(at(v3, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p3) and at(v3, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v4, j), n) and (not prop(at(v4, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v4, j) = t))
                                [by unpacked with-q]
                            }
                          @conclusion-with-v2 |
                            exists v3: Seq; exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = m and ((forall j: Nat; less_than(j, p3) -> (permutesTheSegment(at(v3, j), n) and prop(at(v3, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p3) and at(v3, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v4, j), n) and (not prop(at(v4, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v4, j) = t))
                            [by unpacked with-v2]
                        }
                      @conclusion-with-p |
                        exists v3: Seq; exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = m and ((forall j: Nat; less_than(j, p3) -> (permutesTheSegment(at(v3, j), n) and prop(at(v3, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p3) and at(v3, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v4, j), n) and (not prop(at(v4, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v4, j) = t))
                        [by unpacked with-p]
                    }
                  @conclusion-split |
                    exists v3: Seq; exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = m and ((forall j: Nat; less_than(j, p3) -> (permutesTheSegment(at(v3, j), n) and prop(at(v3, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p3) and at(v3, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v4, j), n) and (not prop(at(v4, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v4, j) = t))
                    [by unpacked with-v]
                }
              @conclusion-given-enumeration |
                enumerates(w, n, m) -> exists v3: Seq; exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = m and ((forall j: Nat; less_than(j, p3) -> (permutesTheSegment(at(v3, j), n) and prop(at(v3, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p3) and at(v3, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v4, j), n) and (not prop(at(v4, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v4, j) = t))
                [by discharge given-enumeration]
            }
          @discharge-w |
            forall w: Seq; enumerates(w, n, m) -> exists v3: Seq; exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = m and ((forall j: Nat; less_than(j, p3) -> (permutesTheSegment(at(v3, j), n) and prop(at(v3, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p3) and at(v3, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v4, j), n) and (not prop(at(v4, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v4, j) = t))
            [by generalize generalize-w]
        }
      @discharge-m |
        forall m: Nat; forall w: Seq; enumerates(w, n, m) -> exists v3: Seq; exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = m and ((forall j: Nat; less_than(j, p3) -> (permutesTheSegment(at(v3, j), n) and prop(at(v3, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p3) and at(v3, j) = t)) and ((forall j: Nat; less_than(j, q3) -> (permutesTheSegment(at(v4, j), n) and (not prop(at(v4, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q3) and at(v4, j) = t))
        [by generalize generalize-m]
    }
  @conclusion |
    forall n: Nat; forall m: Nat; forall w: Seq; enumerates(w, n, m) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and prop(at(v, j)))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> prop(t) -> exists j: Nat; less_than(j, p) and at(v, j) = t)) and ((forall j: Nat; less_than(j, q) -> (permutesTheSegment(at(v2, j), n) and (not prop(at(v2, j))))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall t: Fn; permutesTheSegment(t, n) -> (not prop(t)) -> exists j: Nat; less_than(j, q) and at(v2, j) = t))
    [by generalize generalize-n]
qed

// A concrete instance, so the schemas above are exercised here: splitting a listing of the
// permutations of n letters into the identity and the rest.
theorem splittingOffTheIdentity: forall n: Nat; forall m: Nat; forall w: Seq; enumerates(w, n, m) ->
  exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat;
  add(p, q) = m
  and ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and at(v, j) = identityFn))
  and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
  and (forall t: Fn; permutesTheSegment(t, n) -> t = identityFn -> exists j: Nat; less_than(j, p) and at(v, j) = t))
  and ((forall j: Nat; less_than(j, q) -> (permutesTheSegment(at(v2, j), n) and (not (at(v2, j) = identityFn))))
  and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j)
  and (forall t: Fn; permutesTheSegment(t, n) -> (not (t = identityFn)) -> exists j: Nat; less_than(j, q) and at(v2, j) = t))
proof
  @conclusion |
    forall n: Nat; forall m: Nat; forall w: Seq; enumerates(w, n, m) ->
      exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat;
      add(p, q) = m
      and ((forall j: Nat; less_than(j, p) -> (permutesTheSegment(at(v, j), n) and at(v, j) = identityFn))
      and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
      and (forall t: Fn; permutesTheSegment(t, n) -> t = identityFn -> exists j: Nat; less_than(j, p) and at(v, j) = t))
      and ((forall j: Nat; less_than(j, q) -> (permutesTheSegment(at(v2, j), n) and (not (at(v2, j) = identityFn))))
      and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j)
      and (forall t: Fn; permutesTheSegment(t, n) -> (not (t = identityFn)) -> exists j: Nat; less_than(j, q) and at(v2, j) = t))
    [using instantiation splittingAListing((fun f: Fn => f = identityFn))]
qed

// -- comparing listings ----------------------------------------------------------------------
//
// Two listings v (length p) and v2 (length q), both without repetition, whose entries
// correspond through a fixed invertible s — every s ∘ (entry of v) is an entry of v2, and
// every entry of v2 is such — have the same length. The correspondence is turned into a
// bijection segment(p) → segment(q) on the index letters (by definite description, as
// std/set/finite.b4m builds inverses), and segmentSizeIsUnique does the rest.

// The graph of the index map: the letter i (below p) goes to the letter j (below q) whose
// v2-entry is s ∘ (the i-th entry of v); letters outside segment(p) stay put.
define matchSpec(s, v, p, v2, q, y, z) =
  (exists i: Nat; less_than(i, p) and y = numeral(i)
  and (exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))))
  or ((not member(y, segment(p))) and z = y)

// At a letter of segment(p) the spec is its left disjunct, with the letter's own index.
theorem matchSpecAtALetter: forall s: Fn; forall v: Seq; forall p: Nat; forall v2: Seq; forall q: Nat;
  forall i: Nat; less_than(i, p) -> forall z: Element;
  matchSpec(s, v, p, v2, q, numeral(i), z) ->
  exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
proof
  @generalize-s |
    fix s: Fn {
      @generalize-v |
        fix v: Seq {
          @generalize-p |
            fix p: Nat {
              @generalize-v2 |
                fix v2: Seq {
                  @generalize-q |
                    fix q: Nat {
                      @generalize-i |
                        fix i: Nat {
                          @given-i-in-range |
                            assume less_than(i, p) {
                              @i-in-range |
                                less_than(i, p)
                                [by hypothesis given-i-in-range]
                              @letter-membership |
                                member(numeral(i), segment(p)) iff less_than(i, p)
                                [using specialize numeralInSegment(p, i)]
                              @letter-in-segment |
                                member(numeral(i), segment(p))
                                [using tautology letter-membership i-in-range]
                              @generalize-z |
                                fix z: Element {
                                  @given-spec |
                                    assume matchSpec(s, v, p, v2, q, numeral(i), z) {
                                      @spec |
                                        matchSpec(s, v, p, v2, q, numeral(i), z)
                                        [by hypothesis given-spec]
                                      @conclusion-matched |
                                        exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
                                        case spec {
                                          @when-matched |
                                            assume exists i2: Nat; less_than(i2, p) and numeral(i) = numeral(i2) and (exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i2))) {
                                              @match-exists |
                                                exists i2: Nat; less_than(i2, p) and numeral(i) = numeral(i2) and (exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i2)))
                                                [by hypothesis when-matched]
                                              @with-index-i2 |
                                                unpack i2: Nat from match-exists {
                                                  @match-facts |
                                                    less_than(i2, p) and numeral(i) = numeral(i2) and (exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i2)))
                                                    [by hypothesis with-index-i2]
                                                  @letters-agree |
                                                    numeral(i) = numeral(i2)
                                                    [using tautology match-facts]
                                                  @target-exists-at-i2 |
                                                    exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i2))
                                                    [using tautology match-facts]
                                                  @indices-agree |
                                                    i = i2
                                                    [using specialize numeralInjective(i, i2) letters-agree]
                                                  @conclusion-target-at-i |
                                                    exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
                                                    [by rewrite indices-agree target-exists-at-i2]
                                                }
                                              @conclusion-when-matched |
                                                exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
                                                [by unpacked with-index-i2]
                                            }
                                          @when-outside |
                                            assume (not member(numeral(i), segment(p))) and z = numeral(i) {
                                              @outside-facts |
                                                (not member(numeral(i), segment(p))) and z = numeral(i)
                                                [by hypothesis when-outside]
                                              @letter-outside |
                                                not member(numeral(i), segment(p))
                                                [by and_lhs outside-facts]
                                              @conclusion-when-outside |
                                                exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
                                                [by ex_falso letter-in-segment letter-outside]
                                            }
                                        }
                                    }
                                  @conclusion-at-z |
                                    matchSpec(s, v, p, v2, q, numeral(i), z) -> exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
                                    [by discharge given-spec]
                                }
                              @discharge-z |
                                forall z: Element; matchSpec(s, v, p, v2, q, numeral(i), z) -> exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
                                [by generalize generalize-z]
                            }
                          @conclusion-at-i |
                            less_than(i, p) -> forall z: Element; matchSpec(s, v, p, v2, q, numeral(i), z) -> exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
                            [by discharge given-i-in-range]
                        }
                      @discharge-i |
                        forall i: Nat; less_than(i, p) -> forall z: Element; matchSpec(s, v, p, v2, q, numeral(i), z) -> exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
                        [by generalize generalize-i]
                    }
                  @discharge-q |
                    forall q: Nat; forall i: Nat; less_than(i, p) -> forall z: Element; matchSpec(s, v, p, v2, q, numeral(i), z) -> exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
                    [by generalize generalize-q]
                }
              @discharge-v2 |
                forall v2: Seq; forall q: Nat; forall i: Nat; less_than(i, p) -> forall z: Element; matchSpec(s, v, p, v2, q, numeral(i), z) -> exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
                [by generalize generalize-v2]
            }
          @discharge-p |
            forall p: Nat; forall v2: Seq; forall q: Nat; forall i: Nat; less_than(i, p) -> forall z: Element; matchSpec(s, v, p, v2, q, numeral(i), z) -> exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
            [by generalize generalize-p]
        }
      @discharge-v |
        forall v: Seq; forall p: Nat; forall v2: Seq; forall q: Nat; forall i: Nat; less_than(i, p) -> forall z: Element; matchSpec(s, v, p, v2, q, numeral(i), z) -> exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
        [by generalize generalize-v]
    }
  @conclusion |
    forall s: Fn; forall v: Seq; forall p: Nat; forall v2: Seq; forall q: Nat;
      forall i: Nat; less_than(i, p) -> forall z: Element;
      matchSpec(s, v, p, v2, q, numeral(i), z) ->
      exists j: Nat; less_than(j, q) and z = numeral(j) and at(v2, j) = compose(s, at(v, i))
    [by generalize generalize-s]
qed

// The spec is TOTAL and SINGLE-VALUED when v2 does not repeat and every s ∘ (entry of v) is
// an entry of v2: a letter of segment(p) goes to the (unique, by v2's injectivity) index of
// that entry; any other point goes to itself.
theorem matchSpecIsTotalAndSingleValued: forall s: Fn; forall v: Seq; forall p: Nat; forall v2: Seq; forall q: Nat;
  (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) ->
  (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) ->
  forall y: Element; exists z: Element;
  matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
proof
  @generalize-s |
    fix s: Fn {
      @generalize-v |
        fix v: Seq {
          @generalize-p |
            fix p: Nat {
              @generalize-v2 |
                fix v2: Seq {
                  @generalize-q |
                    fix q: Nat {
                      @given-v2-injective |
                        assume forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j {
                          @given-forward |
                            assume forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i)) {
                              @v2-injective |
                                forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j
                                [by hypothesis given-v2-injective]
                              @forward |
                                forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))
                                [by hypothesis given-forward]
                              @generalize-y |
                                fix y: Element {
                                  @y-in-or-out |
                                    member(y, segment(p)) or (not member(y, segment(p)))
                                    [using tautology]
                                  @conclusion-unique-image |
                                    exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                                    case y-in-or-out {
                                      @when-y-in |
                                        assume member(y, segment(p)) {
                                          @y-in |
                                            member(y, segment(p))
                                            [by hypothesis when-y-in]
                                          @segment-membership |
                                            member(y, segment(p)) iff (exists i: Nat; less_than(i, p) and y = numeral(i))
                                            [using specialize segmentMember(p, y)]
                                          @y-is-a-letter |
                                            exists i: Nat; less_than(i, p) and y = numeral(i)
                                            [using tautology segment-membership y-in]
                                          @with-index-i |
                                            unpack i: Nat from y-is-a-letter {
                                              @letter-facts |
                                                less_than(i, p) and y = numeral(i)
                                                [by hypothesis with-index-i]
                                              @i-in-range |
                                                less_than(i, p)
                                                [by and_lhs letter-facts]
                                              @y-is-letter-i |
                                                y = numeral(i)
                                                [by and_rhs letter-facts]
                                              @target-exists |
                                                exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))
                                                [using specialize forward(i) i-in-range]
                                              @with-target-j |
                                                unpack j: Nat from target-exists {
                                                  @target-facts |
                                                    less_than(j, q) and at(v2, j) = compose(s, at(v, i))
                                                    [by hypothesis with-target-j]
                                                  @j-in-range |
                                                    less_than(j, q)
                                                    [by and_lhs target-facts]
                                                  @target-entry |
                                                    at(v2, j) = compose(s, at(v, i))
                                                    [by and_rhs target-facts]
                                                  @letter-j-is-itself |
                                                    numeral(j) = numeral(j)
                                                    [by reflexivity]
                                                  @inner-facts |
                                                    less_than(j, q) and numeral(j) = numeral(j) and at(v2, j) = compose(s, at(v, i))
                                                    [using tautology j-in-range letter-j-is-itself target-entry]
                                                  @inner-witness |
                                                    exists j2: Nat; less_than(j2, q) and numeral(j) = numeral(j2) and at(v2, j2) = compose(s, at(v, i))
                                                    [by witness(j) inner-facts]
                                                  @outer-facts |
                                                    less_than(i, p) and y = numeral(i) and (exists j2: Nat; less_than(j2, q) and numeral(j) = numeral(j2) and at(v2, j2) = compose(s, at(v, i)))
                                                    [using tautology i-in-range y-is-letter-i inner-witness]
                                                  @outer-witness |
                                                    exists i2: Nat; less_than(i2, p) and y = numeral(i2) and (exists j2: Nat; less_than(j2, q) and numeral(j) = numeral(j2) and at(v2, j2) = compose(s, at(v, i2)))
                                                    [by witness(i) outer-facts]
                                                  @spec-holds |
                                                    matchSpec(s, v, p, v2, q, y, numeral(j))
                                                    [by either_left outer-witness]
                                                  @generalize-z2 |
                                                    fix z2: Element {
                                                      @given-spec-at-z2 |
                                                        assume matchSpec(s, v, p, v2, q, y, z2) {
                                                          @spec-at-z2 |
                                                            matchSpec(s, v, p, v2, q, y, z2)
                                                            [by hypothesis given-spec-at-z2]
                                                          @spec-at-letter-z2 |
                                                            matchSpec(s, v, p, v2, q, numeral(i), z2)
                                                            [by rewrite y-is-letter-i spec-at-z2]
                                                          @z2-matched |
                                                            exists j2: Nat; less_than(j2, q) and z2 = numeral(j2) and at(v2, j2) = compose(s, at(v, i))
                                                            [using specialize matchSpecAtALetter(s, v, p, v2, q, i, z2) i-in-range spec-at-letter-z2]
                                                          @with-index-j2 |
                                                            unpack j2: Nat from z2-matched {
                                                              @z2-facts |
                                                                less_than(j2, q) and z2 = numeral(j2) and at(v2, j2) = compose(s, at(v, i))
                                                                [by hypothesis with-index-j2]
                                                              @j2-in-range |
                                                                less_than(j2, q)
                                                                [using tautology z2-facts]
                                                              @z2-is-letter-j2 |
                                                                z2 = numeral(j2)
                                                                [using tautology z2-facts]
                                                              @entry-j2 |
                                                                at(v2, j2) = compose(s, at(v, i))
                                                                [using tautology z2-facts]
                                                              @entries-agree |
                                                                at(v2, j) = at(v2, j2)
                                                                [by rewrite entry-j2 target-entry]
                                                              @indices-agree |
                                                                j = j2
                                                                [using specialize v2-injective(j, j2) j-in-range j2-in-range entries-agree]
                                                              @z2-is-letter-j |
                                                                z2 = numeral(j)
                                                                [by rewrite indices-agree z2-is-letter-j2]
                                                              @conclusion-z2-is-the-image |
                                                                numeral(j) = z2
                                                                [by symmetry z2-is-letter-j]
                                                            }
                                                          @conclusion-unique-at-z2 |
                                                            numeral(j) = z2
                                                            [by unpacked with-index-j2]
                                                        }
                                                      @conclusion-uniqueness-clause |
                                                        matchSpec(s, v, p, v2, q, y, z2) -> numeral(j) = z2
                                                        [by discharge given-spec-at-z2]
                                                    }
                                                  @image-is-unique |
                                                    forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> numeral(j) = z2
                                                    [by generalize generalize-z2]
                                                  @spec-and-unique |
                                                    matchSpec(s, v, p, v2, q, y, numeral(j)) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> numeral(j) = z2)
                                                    [by both spec-holds image-is-unique]
                                                  @conclusion-witness-letter-j |
                                                    exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                                                    [by witness(numeral(j)) spec-and-unique]
                                                }
                                              @conclusion-with-j |
                                                exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                                                [by unpacked with-target-j]
                                            }
                                          @conclusion-when-in |
                                            exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                                            [by unpacked with-index-i]
                                        }
                                      @when-y-out |
                                        assume not member(y, segment(p)) {
                                          @y-out |
                                            not member(y, segment(p))
                                            [by hypothesis when-y-out]
                                          @y-is-itself |
                                            y = y
                                            [by reflexivity]
                                          @outside-facts |
                                            (not member(y, segment(p))) and y = y
                                            [by both y-out y-is-itself]
                                          @spec-holds |
                                            matchSpec(s, v, p, v2, q, y, y)
                                            [by either_right outside-facts]
                                          @generalize-z2 |
                                            fix z2: Element {
                                              @given-spec-at-z2 |
                                                assume matchSpec(s, v, p, v2, q, y, z2) {
                                                  @spec-at-z2 |
                                                    matchSpec(s, v, p, v2, q, y, z2)
                                                    [by hypothesis given-spec-at-z2]
                                                  @conclusion-z2-is-y |
                                                    y = z2
                                                    case spec-at-z2 {
                                                      @when-matched |
                                                        assume exists i: Nat; less_than(i, p) and y = numeral(i) and (exists j: Nat; less_than(j, q) and z2 = numeral(j) and at(v2, j) = compose(s, at(v, i))) {
                                                          @match-exists |
                                                            exists i: Nat; less_than(i, p) and y = numeral(i) and (exists j: Nat; less_than(j, q) and z2 = numeral(j) and at(v2, j) = compose(s, at(v, i)))
                                                            [by hypothesis when-matched]
                                                          @with-index-i |
                                                            unpack i: Nat from match-exists {
                                                              @match-facts |
                                                                less_than(i, p) and y = numeral(i) and (exists j: Nat; less_than(j, q) and z2 = numeral(j) and at(v2, j) = compose(s, at(v, i)))
                                                                [by hypothesis with-index-i]
                                                              @i-in-range |
                                                                less_than(i, p)
                                                                [using tautology match-facts]
                                                              @y-is-letter-i |
                                                                y = numeral(i)
                                                                [using tautology match-facts]
                                                              @letter-membership |
                                                                member(numeral(i), segment(p)) iff less_than(i, p)
                                                                [using specialize numeralInSegment(p, i)]
                                                              @letter-in-segment |
                                                                member(numeral(i), segment(p))
                                                                [using tautology letter-membership i-in-range]
                                                              @y-in |
                                                                member(y, segment(p))
                                                                [by rewrite y-is-letter-i letter-in-segment]
                                                              @conclusion-matched-ex_falso |
                                                                y = z2
                                                                [by ex_falso y-in y-out]
                                                            }
                                                          @conclusion-when-matched |
                                                            y = z2
                                                            [by unpacked with-index-i]
                                                        }
                                                      @when-outside |
                                                        assume (not member(y, segment(p))) and z2 = y {
                                                          @outside-facts-at-z2 |
                                                            (not member(y, segment(p))) and z2 = y
                                                            [by hypothesis when-outside]
                                                          @z2-is-y |
                                                            z2 = y
                                                            [by and_rhs outside-facts-at-z2]
                                                          @conclusion-when-outside |
                                                            y = z2
                                                            [by symmetry z2-is-y]
                                                        }
                                                    }
                                                }
                                              @conclusion-uniqueness-clause |
                                                matchSpec(s, v, p, v2, q, y, z2) -> y = z2
                                                [by discharge given-spec-at-z2]
                                            }
                                          @image-is-unique |
                                            forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> y = z2
                                            [by generalize generalize-z2]
                                          @spec-and-unique |
                                            matchSpec(s, v, p, v2, q, y, y) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> y = z2)
                                            [by both spec-holds image-is-unique]
                                          @conclusion-when-out |
                                            exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                                            [by witness(y) spec-and-unique]
                                        }
                                    }
                                }
                              @spec-total-and-single-valued |
                                forall y: Element; exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                                [by generalize generalize-y]
                            }
                          @conclusion-given-forward |
                            (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> forall y: Element; exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                            [by discharge given-forward]
                        }
                      @conclusion-at-q |
                        (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> forall y: Element; exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                        [by discharge given-v2-injective]
                    }
                  @discharge-q |
                    forall q: Nat; (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> forall y: Element; exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                    [by generalize generalize-q]
                }
              @discharge-v2 |
                forall v2: Seq; forall q: Nat; (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> forall y: Element; exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                [by generalize generalize-v2]
            }
          @discharge-p |
            forall p: Nat; forall v2: Seq; forall q: Nat; (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> forall y: Element; exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
            [by generalize generalize-p]
        }
      @discharge-v |
        forall v: Seq; forall p: Nat; forall v2: Seq; forall q: Nat; (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> forall y: Element; exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
        [by generalize generalize-v]
    }
  @conclusion |
    forall s: Fn; forall v: Seq; forall p: Nat; forall v2: Seq; forall q: Nat;
      (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) ->
      (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) ->
      forall y: Element; exists z: Element;
      matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
    [by generalize generalize-s]
qed

// EQUAL LENGTHS: listings v (length p) and v2 (length q), neither repeating, whose entries
// correspond through an invertible s (every s ∘ (entry of v) is an entry of v2, and every
// entry of v2 is one) have p = q. The index map i ↦ j with at(v2, j) = s ∘ at(v, i), as a
// function on letters, bijects segment(p) onto segment(q).
theorem listingsInBijectionHaveEqualLengths: forall s: Fn; invertible(s) ->
  forall p: Nat; forall q: Nat; forall v: Seq; forall v2: Seq;
  (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) ->
  (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) ->
  (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) ->
  (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) ->
  p = q
proof
  @generalize-s |
    fix s: Fn {
      @given-s-invertible |
        assume invertible(s) {
          @s-invertible |
            invertible(s)
            [by hypothesis given-s-invertible]
          @cancel |
            forall f: Fn; compose(inverse(s), compose(s, f)) = f
            [using specialize cancellingOnTheLeft(s) s-invertible]
          @generalize-p |
            fix p: Nat {
              @generalize-q |
                fix q: Nat {
                  @generalize-v |
                    fix v: Seq {
                      @generalize-v2 |
                        fix v2: Seq {
                          @given-v-injective |
                            assume forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j {
                              @given-v2-injective |
                                assume forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j {
                                  @given-forward |
                                    assume forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i)) {
                                      @given-backward |
                                        assume forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i)) {
                                          @v-injective |
                                            forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j
                                            [by hypothesis given-v-injective]
                                          @v2-injective |
                                            forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j
                                            [by hypothesis given-v2-injective]
                                          @forward |
                                            forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))
                                            [by hypothesis given-forward]
                                          @backward |
                                            forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))
                                            [by hypothesis given-backward]
                                          @spec-total-and-single-valued |
                                            forall y: Element; exists z: Element; matchSpec(s, v, p, v2, q, y, z) and (forall z2: Element; matchSpec(s, v, p, v2, q, y, z2) -> z = z2)
                                            [using specialize matchSpecIsTotalAndSingleValued(s, v, p, v2, q) v2-injective forward]
                                          @index-map-exists |
                                            exists g: Fn; forall y: Element; matchSpec(s, v, p, v2, q, y, apply(g, y))
                                            [using instantiation functionFromGraph(fun y, z: Element => matchSpec(s, v, p, v2, q, y, z)) spec-total-and-single-valued]
                                          @with-index-map-g |
                                            unpack g: Fn from index-map-exists {
                                              @g-spec |
                                                forall y: Element; matchSpec(s, v, p, v2, q, y, apply(g, y))
                                                [by hypothesis with-index-map-g]

                                              // g maps segment(p) into segment(q)
                                              @generalize-y-for-maps-into |
                                                fix y: Element {
                                                  @given-y-in |
                                                    assume member(y, segment(p)) {
                                                      @y-in |
                                                        member(y, segment(p))
                                                        [by hypothesis given-y-in]
                                                      @segment-membership |
                                                        member(y, segment(p)) iff (exists i: Nat; less_than(i, p) and y = numeral(i))
                                                        [using specialize segmentMember(p, y)]
                                                      @y-is-a-letter |
                                                        exists i: Nat; less_than(i, p) and y = numeral(i)
                                                        [using tautology segment-membership y-in]
                                                      @with-index-i |
                                                        unpack i: Nat from y-is-a-letter {
                                                          @letter-facts |
                                                            less_than(i, p) and y = numeral(i)
                                                            [by hypothesis with-index-i]
                                                          @i-in-range |
                                                            less_than(i, p)
                                                            [by and_lhs letter-facts]
                                                          @y-is-letter-i |
                                                            y = numeral(i)
                                                            [by and_rhs letter-facts]
                                                          @g-spec-at-y |
                                                            matchSpec(s, v, p, v2, q, y, apply(g, y))
                                                            [using specialize g-spec(y)]
                                                          @g-spec-at-letter-i |
                                                            matchSpec(s, v, p, v2, q, numeral(i), apply(g, numeral(i)))
                                                            [by rewrite y-is-letter-i g-spec-at-y]
                                                          @image-matched |
                                                            exists j: Nat; less_than(j, q) and apply(g, numeral(i)) = numeral(j) and at(v2, j) = compose(s, at(v, i))
                                                            [using specialize matchSpecAtALetter(s, v, p, v2, q, i, apply(g, numeral(i))) i-in-range g-spec-at-letter-i]
                                                          @with-target-j |
                                                            unpack j: Nat from image-matched {
                                                              @target-facts |
                                                                less_than(j, q) and apply(g, numeral(i)) = numeral(j) and at(v2, j) = compose(s, at(v, i))
                                                                [by hypothesis with-target-j]
                                                              @j-in-range |
                                                                less_than(j, q)
                                                                [using tautology target-facts]
                                                              @image-is-letter-j |
                                                                apply(g, numeral(i)) = numeral(j)
                                                                [using tautology target-facts]
                                                              @letter-j-membership |
                                                                member(numeral(j), segment(q)) iff less_than(j, q)
                                                                [using specialize numeralInSegment(q, j)]
                                                              @letter-j-in-segment |
                                                                member(numeral(j), segment(q))
                                                                [using tautology letter-j-membership j-in-range]
                                                              @image-of-letter-in-segment |
                                                                member(apply(g, numeral(i)), segment(q))
                                                                [by rewrite image-is-letter-j letter-j-in-segment]
                                                              @conclusion-image-in-segment |
                                                                member(apply(g, y), segment(q))
                                                                [by rewrite y-is-letter-i image-of-letter-in-segment]
                                                            }
                                                          @conclusion-with-j |
                                                            member(apply(g, y), segment(q))
                                                            [by unpacked with-target-j]
                                                        }
                                                      @conclusion-maps-y |
                                                        member(apply(g, y), segment(q))
                                                        [by unpacked with-index-i]
                                                    }
                                                  @conclusion-maps-into-at-y |
                                                    member(y, segment(p)) -> member(apply(g, y), segment(q))
                                                    [by discharge given-y-in]
                                                }
                                              @g-maps-into |
                                                forall y: Element; member(y, segment(p)) -> member(apply(g, y), segment(q))
                                                [by generalize generalize-y-for-maps-into]

                                              // g is injective on segment(p): equal images give equal target indices, then
                                              // equal v2-entries, cancel s, equal v-entries, equal source indices
                                              @generalize-y1 |
                                                fix y1: Element {
                                                  @generalize-y2 |
                                                    fix y2: Element {
                                                      @given-y1-in |
                                                        assume member(y1, segment(p)) {
                                                          @given-y2-in |
                                                            assume member(y2, segment(p)) {
                                                              @given-images-equal |
                                                                assume apply(g, y1) = apply(g, y2) {
                                                                  @y1-in |
                                                                    member(y1, segment(p))
                                                                    [by hypothesis given-y1-in]
                                                                  @y2-in |
                                                                    member(y2, segment(p))
                                                                    [by hypothesis given-y2-in]
                                                                  @images-equal |
                                                                    apply(g, y1) = apply(g, y2)
                                                                    [by hypothesis given-images-equal]
                                                                  @y1-membership |
                                                                    member(y1, segment(p)) iff (exists i: Nat; less_than(i, p) and y1 = numeral(i))
                                                                    [using specialize segmentMember(p, y1)]
                                                                  @y2-membership |
                                                                    member(y2, segment(p)) iff (exists i: Nat; less_than(i, p) and y2 = numeral(i))
                                                                    [using specialize segmentMember(p, y2)]
                                                                  @y1-is-a-letter |
                                                                    exists i: Nat; less_than(i, p) and y1 = numeral(i)
                                                                    [using tautology y1-membership y1-in]
                                                                  @y2-is-a-letter |
                                                                    exists i: Nat; less_than(i, p) and y2 = numeral(i)
                                                                    [using tautology y2-membership y2-in]
                                                                  @with-index-i1 |
                                                                    unpack i1: Nat from y1-is-a-letter {
                                                                      @letter-facts-1 |
                                                                        less_than(i1, p) and y1 = numeral(i1)
                                                                        [by hypothesis with-index-i1]
                                                                      @i1-in-range |
                                                                        less_than(i1, p)
                                                                        [by and_lhs letter-facts-1]
                                                                      @y1-is-letter-i1 |
                                                                        y1 = numeral(i1)
                                                                        [by and_rhs letter-facts-1]
                                                                      @with-index-i2 |
                                                                        unpack i2: Nat from y2-is-a-letter {
                                                                          @letter-facts-2 |
                                                                            less_than(i2, p) and y2 = numeral(i2)
                                                                            [by hypothesis with-index-i2]
                                                                          @i2-in-range |
                                                                            less_than(i2, p)
                                                                            [by and_lhs letter-facts-2]
                                                                          @y2-is-letter-i2 |
                                                                            y2 = numeral(i2)
                                                                            [by and_rhs letter-facts-2]
                                                                          @g-spec-at-y1 |
                                                                            matchSpec(s, v, p, v2, q, y1, apply(g, y1))
                                                                            [using specialize g-spec(y1)]
                                                                          @g-spec-at-letter-i1 |
                                                                            matchSpec(s, v, p, v2, q, numeral(i1), apply(g, numeral(i1)))
                                                                            [by rewrite y1-is-letter-i1 g-spec-at-y1]
                                                                          @image-1-matched |
                                                                            exists j: Nat; less_than(j, q) and apply(g, numeral(i1)) = numeral(j) and at(v2, j) = compose(s, at(v, i1))
                                                                            [using specialize matchSpecAtALetter(s, v, p, v2, q, i1, apply(g, numeral(i1))) i1-in-range g-spec-at-letter-i1]
                                                                          @g-spec-at-y2 |
                                                                            matchSpec(s, v, p, v2, q, y2, apply(g, y2))
                                                                            [using specialize g-spec(y2)]
                                                                          @g-spec-at-letter-i2 |
                                                                            matchSpec(s, v, p, v2, q, numeral(i2), apply(g, numeral(i2)))
                                                                            [by rewrite y2-is-letter-i2 g-spec-at-y2]
                                                                          @image-2-matched |
                                                                            exists j: Nat; less_than(j, q) and apply(g, numeral(i2)) = numeral(j) and at(v2, j) = compose(s, at(v, i2))
                                                                            [using specialize matchSpecAtALetter(s, v, p, v2, q, i2, apply(g, numeral(i2))) i2-in-range g-spec-at-letter-i2]
                                                                          @images-equal-at-letter-i1 |
                                                                            apply(g, numeral(i1)) = apply(g, y2)
                                                                            [by rewrite y1-is-letter-i1 images-equal]
                                                                          @images-equal-at-letters |
                                                                            apply(g, numeral(i1)) = apply(g, numeral(i2))
                                                                            [by rewrite y2-is-letter-i2 images-equal-at-letter-i1]
                                                                          @with-target-j1 |
                                                                            unpack j1: Nat from image-1-matched {
                                                                              @target-facts-1 |
                                                                                less_than(j1, q) and apply(g, numeral(i1)) = numeral(j1) and at(v2, j1) = compose(s, at(v, i1))
                                                                                [by hypothesis with-target-j1]
                                                                              @image-1-is-letter-j1 |
                                                                                apply(g, numeral(i1)) = numeral(j1)
                                                                                [using tautology target-facts-1]
                                                                              @entry-j1 |
                                                                                at(v2, j1) = compose(s, at(v, i1))
                                                                                [using tautology target-facts-1]
                                                                              @with-target-j2 |
                                                                                unpack j2: Nat from image-2-matched {
                                                                                  @target-facts-2 |
                                                                                    less_than(j2, q) and apply(g, numeral(i2)) = numeral(j2) and at(v2, j2) = compose(s, at(v, i2))
                                                                                    [by hypothesis with-target-j2]
                                                                                  @image-2-is-letter-j2 |
                                                                                    apply(g, numeral(i2)) = numeral(j2)
                                                                                    [using tautology target-facts-2]
                                                                                  @entry-j2 |
                                                                                    at(v2, j2) = compose(s, at(v, i2))
                                                                                    [using tautology target-facts-2]
                                                                                  @letter-j1-is-image-2 |
                                                                                    numeral(j1) = apply(g, numeral(i2))
                                                                                    [by rewrite image-1-is-letter-j1 images-equal-at-letters]
                                                                                  @target-letters-agree |
                                                                                    numeral(j1) = numeral(j2)
                                                                                    [by rewrite image-2-is-letter-j2 letter-j1-is-image-2]
                                                                                  @target-indices-agree |
                                                                                    j1 = j2
                                                                                    [using specialize numeralInjective(j1, j2) target-letters-agree]
                                                                                  @entry-j2-from-i1 |
                                                                                    at(v2, j2) = compose(s, at(v, i1))
                                                                                    [by rewrite target-indices-agree entry-j1]
                                                                                  @composites-equal |
                                                                                    compose(s, at(v, i2)) = compose(s, at(v, i1))
                                                                                    [by rewrite entry-j2 entry-j2-from-i1]
                                                                                  @cancel-at-i1 |
                                                                                    compose(inverse(s), compose(s, at(v, i1))) = at(v, i1)
                                                                                    [using specialize cancel(at(v, i1))]
                                                                                  @cancel-at-i2 |
                                                                                    compose(inverse(s), compose(s, at(v, i2))) = at(v, i2)
                                                                                    [using specialize cancel(at(v, i2))]
                                                                                  @cancel-crossed |
                                                                                    compose(inverse(s), compose(s, at(v, i2))) = at(v, i1)
                                                                                    [by rewrite composites-equal cancel-at-i1]
                                                                                  @source-entries-agree |
                                                                                    at(v, i2) = at(v, i1)
                                                                                    [by rewrite cancel-at-i2 cancel-crossed]
                                                                                  @source-indices-agree |
                                                                                    i2 = i1
                                                                                    [using specialize v-injective(i2, i1) i2-in-range i1-in-range source-entries-agree]
                                                                                  @y2-is-letter-i1 |
                                                                                    y2 = numeral(i1)
                                                                                    [by rewrite source-indices-agree y2-is-letter-i2]
                                                                                  @letter-i1-is-y2 |
                                                                                    numeral(i1) = y2
                                                                                    [by symmetry y2-is-letter-i1]
                                                                                  @conclusion-points-agree |
                                                                                    y1 = y2
                                                                                    [using chain y1-is-letter-i1 letter-i1-is-y2]
                                                                                }
                                                                              @conclusion-with-j2 |
                                                                                y1 = y2
                                                                                [by unpacked with-target-j2]
                                                                            }
                                                                          @conclusion-with-j1 |
                                                                            y1 = y2
                                                                            [by unpacked with-target-j1]
                                                                        }
                                                                      @conclusion-with-i2 |
                                                                        y1 = y2
                                                                        [by unpacked with-index-i2]
                                                                    }
                                                                  @conclusion-with-i1 |
                                                                    y1 = y2
                                                                    [by unpacked with-index-i1]
                                                                }
                                                              @conclusion-given-images-equal |
                                                                apply(g, y1) = apply(g, y2) -> y1 = y2
                                                                [by discharge given-images-equal]
                                                            }
                                                          @conclusion-given-y2-in |
                                                            member(y2, segment(p)) -> apply(g, y1) = apply(g, y2) -> y1 = y2
                                                            [by discharge given-y2-in]
                                                        }
                                                      @conclusion-injective-at-y1-y2 |
                                                        member(y1, segment(p)) -> member(y2, segment(p)) -> apply(g, y1) = apply(g, y2) -> y1 = y2
                                                        [by discharge given-y1-in]
                                                    }
                                                  @discharge-y2 |
                                                    forall y2: Element; member(y1, segment(p)) -> member(y2, segment(p)) -> apply(g, y1) = apply(g, y2) -> y1 = y2
                                                    [by generalize generalize-y2]
                                                }
                                              @g-injective-on |
                                                forall y1: Element; forall y2: Element; member(y1, segment(p)) -> member(y2, segment(p)) -> apply(g, y1) = apply(g, y2) -> y1 = y2
                                                [by generalize generalize-y1]

                                              // g covers segment(q): a target letter j has a source i (backward), and g sends
                                              // the letter i to the (unique) index of s ∘ at(v, i), which is j
                                              @generalize-z |
                                                fix z: Element {
                                                  @given-z-in |
                                                    assume member(z, segment(q)) {
                                                      @z-in |
                                                        member(z, segment(q))
                                                        [by hypothesis given-z-in]
                                                      @z-membership |
                                                        member(z, segment(q)) iff (exists j: Nat; less_than(j, q) and z = numeral(j))
                                                        [using specialize segmentMember(q, z)]
                                                      @z-is-a-letter |
                                                        exists j: Nat; less_than(j, q) and z = numeral(j)
                                                        [using tautology z-membership z-in]
                                                      @with-index-j |
                                                        unpack j: Nat from z-is-a-letter {
                                                          @letter-facts |
                                                            less_than(j, q) and z = numeral(j)
                                                            [by hypothesis with-index-j]
                                                          @j-in-range |
                                                            less_than(j, q)
                                                            [by and_lhs letter-facts]
                                                          @z-is-letter-j |
                                                            z = numeral(j)
                                                            [by and_rhs letter-facts]
                                                          @source-exists |
                                                            exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))
                                                            [using specialize backward(j) j-in-range]
                                                          @with-source-i |
                                                            unpack i: Nat from source-exists {
                                                              @source-facts |
                                                                less_than(i, p) and at(v2, j) = compose(s, at(v, i))
                                                                [by hypothesis with-source-i]
                                                              @i-in-range |
                                                                less_than(i, p)
                                                                [by and_lhs source-facts]
                                                              @entry-j |
                                                                at(v2, j) = compose(s, at(v, i))
                                                                [by and_rhs source-facts]
                                                              @letter-i-membership |
                                                                member(numeral(i), segment(p)) iff less_than(i, p)
                                                                [using specialize numeralInSegment(p, i)]
                                                              @letter-i-in-segment |
                                                                member(numeral(i), segment(p))
                                                                [using tautology letter-i-membership i-in-range]
                                                              @g-spec-at-letter-i |
                                                                matchSpec(s, v, p, v2, q, numeral(i), apply(g, numeral(i)))
                                                                [using specialize g-spec(numeral(i))]
                                                              @image-matched |
                                                                exists j2: Nat; less_than(j2, q) and apply(g, numeral(i)) = numeral(j2) and at(v2, j2) = compose(s, at(v, i))
                                                                [using specialize matchSpecAtALetter(s, v, p, v2, q, i, apply(g, numeral(i))) i-in-range g-spec-at-letter-i]
                                                              @with-target-j2 |
                                                                unpack j2: Nat from image-matched {
                                                                  @target-facts |
                                                                    less_than(j2, q) and apply(g, numeral(i)) = numeral(j2) and at(v2, j2) = compose(s, at(v, i))
                                                                    [by hypothesis with-target-j2]
                                                                  @j2-in-range |
                                                                    less_than(j2, q)
                                                                    [using tautology target-facts]
                                                                  @image-is-letter-j2 |
                                                                    apply(g, numeral(i)) = numeral(j2)
                                                                    [using tautology target-facts]
                                                                  @entry-j2 |
                                                                    at(v2, j2) = compose(s, at(v, i))
                                                                    [using tautology target-facts]
                                                                  @entries-agree |
                                                                    at(v2, j2) = at(v2, j)
                                                                    [by rewrite entry-j entry-j2]
                                                                  @indices-agree |
                                                                    j2 = j
                                                                    [using specialize v2-injective(j2, j) j2-in-range j-in-range entries-agree]
                                                                  @image-is-letter-j |
                                                                    apply(g, numeral(i)) = numeral(j)
                                                                    [by rewrite indices-agree image-is-letter-j2]
                                                                  @image-is-z |
                                                                    apply(g, numeral(i)) = z
                                                                    [by rewrite z-is-letter-j image-is-letter-j]
                                                                  @source-in-segment-and-hits |
                                                                    member(numeral(i), segment(p)) and apply(g, numeral(i)) = z
                                                                    [by both letter-i-in-segment image-is-z]
                                                                  @conclusion-witness-letter-i |
                                                                    exists x: Element; member(x, segment(p)) and apply(g, x) = z
                                                                    [by witness(numeral(i)) source-in-segment-and-hits]
                                                                }
                                                              @conclusion-with-j2 |
                                                                exists x: Element; member(x, segment(p)) and apply(g, x) = z
                                                                [by unpacked with-target-j2]
                                                            }
                                                          @conclusion-with-i |
                                                            exists x: Element; member(x, segment(p)) and apply(g, x) = z
                                                            [by unpacked with-source-i]
                                                        }
                                                      @conclusion-z-is-hit |
                                                        exists x: Element; member(x, segment(p)) and apply(g, x) = z
                                                        [by unpacked with-index-j]
                                                    }
                                                  @conclusion-covers-at-z |
                                                    member(z, segment(q)) -> exists x: Element; member(x, segment(p)) and apply(g, x) = z
                                                    [by discharge given-z-in]
                                                }
                                              @g-covers |
                                                forall z: Element; member(z, segment(q)) -> exists x: Element; member(x, segment(p)) and apply(g, x) = z
                                                [by generalize generalize-z]
                                              @g-bijects |
                                                bijectsOnto(g, segment(p), segment(q))
                                                [using tautology g-maps-into g-injective-on g-covers]
                                              @segments-equinumerous |
                                                equinumerous(segment(p), segment(q))
                                                [by witness(g) g-bijects]
                                              @conclusion-lengths-agree |
                                                p = q
                                                [using specialize segmentSizeIsUnique(p, q) segments-equinumerous]
                                            }
                                          @conclusion-with-g |
                                            p = q
                                            [by unpacked with-index-map-g]
                                        }
                                      @conclusion-given-backward |
                                        (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) -> p = q
                                        [by discharge given-backward]
                                    }
                                  @conclusion-given-forward |
                                    (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) -> p = q
                                    [by discharge given-forward]
                                }
                              @conclusion-given-v2-injective |
                                (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) -> p = q
                                [by discharge given-v2-injective]
                            }
                          @conclusion-at-v2 |
                            (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) -> (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) -> p = q
                            [by discharge given-v-injective]
                        }
                      @discharge-v2 |
                        forall v2: Seq; (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) -> (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) -> p = q
                        [by generalize generalize-v2]
                    }
                  @discharge-v |
                    forall v: Seq; forall v2: Seq; (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) -> (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) -> p = q
                    [by generalize generalize-v]
                }
              @discharge-q |
                forall q: Nat; forall v: Seq; forall v2: Seq; (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) -> (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) -> p = q
                [by generalize generalize-q]
            }
          @discharge-p |
            forall p: Nat; forall q: Nat; forall v: Seq; forall v2: Seq; (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) -> (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) -> p = q
            [by generalize generalize-p]
        }
      @conclusion-at-s |
        invertible(s) -> forall p: Nat; forall q: Nat; forall v: Seq; forall v2: Seq; (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) -> (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) -> (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) -> (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) -> p = q
        [by discharge given-s-invertible]
    }
  @conclusion |
    forall s: Fn; invertible(s) ->
      forall p: Nat; forall q: Nat; forall v: Seq; forall v2: Seq;
      (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) ->
      (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) ->
      (forall i: Nat; less_than(i, p) -> exists j: Nat; less_than(j, q) and at(v2, j) = compose(s, at(v, i))) ->
      (forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, p) and at(v2, j) = compose(s, at(v, i))) ->
      p = q
    [by generalize generalize-s]
qed
