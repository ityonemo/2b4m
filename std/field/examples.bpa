// Worked examples for `std/field.bpa`'s nondegeneracy axiom and
// `std/field/order.bpa`'s translation-cancellation axiom.
//
// Why this file exists: `oneNotZero` is what stops the one-element ring from counting as
// a field, and `lessThanAddCancel` is the half of "addition is translation-invariant"
// that the ordered-field theory states for callers but never uses. Every concrete field
// discharges both when modeling these theories, so nothing inside std/ ever rests on
// them — and an axiom no derivation touches could have its hypothesis and conclusion
// swapped unnoticed.
import field <<< "std/field.bpa"
import field_order <<< "std/field/order.bpa"

sort Field = field.Field
sort OrderedField = field_order.OrderedField
const ZERO = field.ZERO
const ONE = field.ONE
func mul = field.mul
func recip = field.recip
func add = field_order.add
pred less_than = field_order.less_than

axiom oneNotZero = field.oneNotZero
axiom fieldInverse = field.fieldInverse
axiom lessThanAddRight = field_order.lessThanAddRight
axiom lessThanAddCancel = field_order.lessThanAddCancel

// ===========================================================================
// field: nondegeneracy
// ===========================================================================

// Because 1 ≠ 0, the inverse axiom applies AT one: 1 · 1⁻¹ = 1. A degenerate "field"
// where 1 = 0 could not take this step, which is exactly what the axiom rules out.
theorem oneHasAnInverse: mul(ONE, recip(ONE)) = ONE
proof
  @one-is-not-zero |
    ONE != ZERO
    [by cite oneNotZero]
  @conclusion |
    mul(ONE, recip(ONE)) = ONE
    [using specialize fieldInverse(ONE) one-is-not-zero]
qed

// ===========================================================================
// field-order: translation invariance, both halves
// ===========================================================================

// Translating and then cancelling is the identity on an order fact: shift a < b up by c,
// then cancel c back off. Both halves in sequence, which is the only way to catch a
// direction error in either.
theorem translationRoundTrips: forall a, b, c: OrderedField; less_than(a, b) -> less_than(a, b)
proof
  @generalize-a |
    fix a: OrderedField {
      @generalize-b |
        fix b: OrderedField {
          @generalize-c |
            fix c: OrderedField {
              @given-a-below-b |
                assume less_than(a, b) {
                  @a-is-below-b |
                    less_than(a, b)
                    [by hypothesis given-a-below-b]
                  @translated-up-by-c |
                    less_than(add(a, c), add(b, c))
                    [using specialize lessThanAddRight(a, b, c) a-is-below-b]
                  @conclusion-cancelled-back |
                    less_than(a, b)
                    [using specialize lessThanAddCancel(a, b, c) translated-up-by-c]
                }
              @conclusion-round-trip |
                less_than(a, b) -> less_than(a, b)
                [by implies_intro given-a-below-b]
            }
          @discharge-c |
            forall c: OrderedField; less_than(a, b) -> less_than(a, b)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: OrderedField; less_than(a, b) -> less_than(a, b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: OrderedField; less_than(a, b) -> less_than(a, b)
    [by forall_intro generalize-a]
qed
