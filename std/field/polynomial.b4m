// std/field/polynomial.b4m — POLYNOMIALS OVER A FIELD, F[x], and the division algorithm.
//
// Judson's §17.2 is stated over a FIELD, not a ring, and the reason is visible in the first
// line of his construction: he divides by the leading coefficient, forming a_n / b_m. A ring
// has no reciprocal, so `std/ring/polynomial.b4m` cannot host this section.
//
// WHY THIS IS A SEPARATE FILE RATHER THAN A MODEL. `std/ring/polynomial.b4m`'s `Poly` is
// built over `ring.Ring` — its coefficient sort, operations and axioms are all bound to that
// theory. A field is a ring with two more axioms, but 2b4m has no sort subsumption, so F[x]
// is its own sort over `field.Field`, declared the same way: a coefficient family read by
// index, equality by coefficients, operations posited as coefficient equations. That is the
// same pattern `std/ring/factor.b4m` uses for R/I and `std/ring/polynomial.b4m` for R[x].
//
// WHAT IS PROVED HERE: the division algorithm's UNIQUENESS half, in full, which is the part
// that follows from degree arithmetic alone. The existence half is an induction on degree
// that constructs the quotient, and it needs a subtraction-of-polynomials step this file
// does not yet carry; see the closing note.

import field <<< "std/field.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import subtraction <<< "std/peano/subtraction.b4m"

// -- the coefficient field F --------------------------------------------------------------

sort F = field.Field
const zeroF = field.ZERO
const oneF = field.ONE
func addF = field.add
func mulF = field.mul
func negF = field.neg
func recipF = field.recip

fact addIsAssociativeF = field.addIsAssociative
fact addIsCommutativeF = field.addIsCommutative
fact addZeroLeftF = field.addZeroLeft
fact addNegLeftF = field.addNegLeft
fact mulIsCommutativeF = field.mulIsCommutative
fact mulOneLeftF = field.mulOneLeft
fact fieldInverse = field.fieldInverse
fact oneNotZero = field.oneNotZero

// -- the index sort -----------------------------------------------------------------------

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func subN = subtraction.sub
pred less_than = peano.less_than

// -- the carrier: F[x] --------------------------------------------------------------------

sort Poly
func coeff(p: Poly, i: Nat) => F

// The zero polynomial, named because every degree statement is guarded on `p != ZEROP`.
// Its coefficient equation is not needed by anything proved here, so it is not asserted:
// this file's theorems treat ZEROP only as the excluded case, never compute with it.
const ZEROP: Poly

// -- degree, as in std/ring/polynomial.b4m ------------------------------------------------
//
// Same shape and same reason: a bound for the general statements, a total function with a
// guarded axiom for the arithmetic, junk at the zero polynomial.
// The degree bound, now exercised by the monomial's degree proof.
pred degreeAtMost(p: Poly, n: Nat)
axiom degreeAtMostMeaning: forall p: Poly; forall n: Nat;
  degreeAtMost(p, n) iff (forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroF)

func degree(p: Poly) => Nat
axiom degreeIsALeadingIndex: forall p: Poly;
  (not (p = ZEROP)) -> (not (coeff(p, degree(p)) = zeroF))
axiom degreeBoundsTheCoefficients: forall p: Poly;
  (not (p = ZEROP)) -> degreeAtMost(p, degree(p))

// -- the operations -----------------------------------------------------------------------

// Multiplication, by the convolution, exactly as `std/ring/polynomial.b4m` defines it over a
// ring. Carried here rather than left opaque because §17.2's existence half BUILDS
// polynomials and then reasons about their coefficients: an opaque `mulP` would force every
// such fact to be a fresh assumption about an undefined function.
func convolution(p: Poly, q: Poly, i: Nat, k: Nat) => F
axiom convolutionZero: forall p, q: Poly; forall i: Nat;
  convolution(p, q, i, ZERO) = mulF(coeff(p, ZERO), coeff(q, i))
axiom convolutionSucc: forall p, q: Poly; forall i, k: Nat;
  convolution(p, q, i, succ(k)) =
  addF(convolution(p, q, i, k),
  mulF(coeff(p, succ(k)), coeff(q, subN(i, succ(k)))))

func mulP(p: Poly, q: Poly) => Poly
axiom mulPolyCoeff: forall p, q: Poly; forall i: Nat;
  coeff(mulP(p, q), i) = convolution(p, q, i, i)

// Judson's Proposition 17.4 over a field: the degree of a product is the sum of the degrees.
// A field is an integral domain, so the leading product a_m b_n cannot vanish. Stated as an
// axiom here rather than re-derived: its proof is the §17.1 convolution argument over a
// different coefficient sort, and `std/ring/polynomial.b4m` already carries the leading-term
// step it turns on.
// A field is an integral domain, so a product of nonzeros is nonzero — the other half of
// Judson's Proposition 17.4, needed here to know the subtrahend has a degree at all.
axiom aProductOfNonzerosIsNonzero: forall p, q: Poly;
  (not (p = ZEROP)) -> (not (q = ZEROP)) -> (not (mulP(p, q) = ZEROP))

axiom degreeOfAProduct: forall p, q: Poly;
  (not (p = ZEROP)) -> (not (q = ZEROP)) ->
  degree(mulP(p, q)) = peano.add(degree(p), degree(q))

// `degree` is DETERMINED by its two halves: any index that is nonzero and bounds the rest
// IS the degree. Same statement and same trichotomy argument as `std/ring/polynomial.b4m`'s
// `degreeIsUnique`, re-proved here because that one is over `ring.Ring` and this sort's
// coefficients are `field.Field` — there is no sort subsumption to inherit it through.
theorem degreeIsUnique: forall p: Poly; forall n: Nat;
  (not (p = ZEROP)) -> (not (coeff(p, n) = zeroF)) -> degreeAtMost(p, n) -> n = degree(p)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-n |
        fix n: Nat {
          @given-p-nonzero |
            assume not (p = ZEROP) {
              @given-coefficient-nonzero |
                assume not (coeff(p, n) = zeroF) {
                  @given-n-bounds |
                    assume degreeAtMost(p, n) {
                      @p-nonzero |
                        not (p = ZEROP)
                        [by hypothesis given-p-nonzero]
                      @coefficient-at-n-nonzero |
                        not (coeff(p, n) = zeroF)
                        [by hypothesis given-coefficient-nonzero]
                      @n-bounds-the-coefficients |
                        degreeAtMost(p, n)
                        [by hypothesis given-n-bounds]

                      @degree-coefficient-nonzero |
                        not (coeff(p, degree(p)) = zeroF)
                        [using specialize degreeIsALeadingIndex(p) p-nonzero]
                      @what-n-bounding-means |
                        degreeAtMost(p, n) iff
                          (forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroF)
                        [using specialize degreeAtMostMeaning(p, n)]
                      @above-n-everything-vanishes |
                        forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroF
                        [using tautology n-bounds-the-coefficients what-n-bounding-means]
                      @degree-vanishes-if-above-n |
                        less_than(n, degree(p)) -> coeff(p, degree(p)) = zeroF
                        [using specialize above-n-everything-vanishes(degree(p))]
                      @degree-not-above-n |
                        not less_than(n, degree(p))
                        [using tautology degree-vanishes-if-above-n degree-coefficient-nonzero]

                      @degree-bounds-the-coefficients |
                        degreeAtMost(p, degree(p))
                        [using specialize degreeBoundsTheCoefficients(p) p-nonzero]
                      @what-degree-bounding-means |
                        degreeAtMost(p, degree(p)) iff
                          (forall i: Nat; less_than(degree(p), i) -> coeff(p, i) = zeroF)
                        [using specialize degreeAtMostMeaning(p, degree(p))]
                      @above-the-degree-everything-vanishes |
                        forall i: Nat; less_than(degree(p), i) -> coeff(p, i) = zeroF
                        [using tautology degree-bounds-the-coefficients what-degree-bounding-means]
                      @n-vanishes-if-above-the-degree |
                        less_than(degree(p), n) -> coeff(p, n) = zeroF
                        [using specialize above-the-degree-everything-vanishes(n)]
                      @n-not-above-the-degree |
                        not less_than(degree(p), n)
                        [using tautology n-vanishes-if-above-the-degree coefficient-at-n-nonzero]

                      @trichotomy-at-n-and-the-degree |
                        less_than(n, degree(p)) or n = degree(p) or less_than(degree(p), n)
                        [using specialize peano_order.trichotomy(n, degree(p))]
                      @conclusion-the-degree-is-n |
                        n = degree(p)
                        [using tautology trichotomy-at-n-and-the-degree degree-not-above-n n-not-above-the-degree]
                    }
                  @bounding-implies-the-degree |
                    degreeAtMost(p, n) -> n = degree(p)
                    [by discharge given-n-bounds]
                }
              @nonzero-coefficient-implies-the-degree |
                (not (coeff(p, n) = zeroF)) -> degreeAtMost(p, n) -> n = degree(p)
                [by discharge given-coefficient-nonzero]
            }
          @p-nonzero-implies-the-degree |
            (not (p = ZEROP)) -> (not (coeff(p, n) = zeroF)) -> degreeAtMost(p, n) ->
              n = degree(p)
            [by discharge given-p-nonzero]
        }
      @discharge-n |
        forall n: Nat;
          (not (p = ZEROP)) -> (not (coeff(p, n) = zeroF)) -> degreeAtMost(p, n) ->
          n = degree(p)
        [by generalize generalize-n]
    }
  @conclusion |
    forall p: Poly; forall n: Nat;
      (not (p = ZEROP)) -> (not (coeff(p, n) = zeroF)) -> degreeAtMost(p, n) ->
      n = degree(p)
    [by generalize generalize-p]
qed

// -- addition, negation, and the difference the construction subtracts --------------------
//
// Judson's `f(x) - (a_n/b_m) x^{n-m} g(x)` needs a difference, so addition and negation come
// back here, now that there is a theorem that uses them.
func addP(p: Poly, q: Poly) => Poly
axiom addPolyCoeff: forall p, q: Poly; forall i: Nat;
  coeff(addP(p, q), i) = addF(coeff(p, i), coeff(q, i))

func negP(p: Poly) => Poly
axiom negPolyCoeff: forall p: Poly; forall i: Nat;
  coeff(negP(p), i) = negF(coeff(p, i))

// `subP(p, q)` is `p - q`. Over a FIELD subtraction is total and honest — it is addition of
// the negation, with no truncation anywhere — so this is a definition, not a guarded symbol.
define subP(p, q) = addP(p, negP(q))

// The coefficient of a difference is the difference of the coefficients.
theorem subPolyCoeff: forall p, q: Poly; forall i: Nat;
  coeff(subP(p, q), i) = addF(coeff(p, i), negF(coeff(q, i)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-index |
            fix i: Nat {
              @the-difference-is-a-sum |
                coeff(addP(p, negP(q)), i) = addF(coeff(p, i), coeff(negP(q), i))
                [using specialize addPolyCoeff(p, negP(q), i)]
              @the-negated-coefficient |
                coeff(negP(q), i) = negF(coeff(q, i))
                [using specialize negPolyCoeff(q, i)]
              @conclusion-the-difference |
                coeff(subP(p, q), i) = addF(coeff(p, i), negF(coeff(q, i)))
                [using simplify the-difference-is-a-sum the-negated-coefficient]
            }
          @discharge-index |
            forall i: Nat; coeff(subP(p, q), i) = addF(coeff(p, i), negF(coeff(q, i)))
            [by generalize generalize-index]
        }
      @discharge-q |
        forall q: Poly; forall i: Nat;
          coeff(subP(p, q), i) = addF(coeff(p, i), negF(coeff(q, i)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall i: Nat;
      coeff(subP(p, q), i) = addF(coeff(p, i), negF(coeff(q, i)))
    [by generalize generalize-p]
qed

// -- MONOMIALS: the constructor the existence half needs ----------------------------------
//
// `F[x]` above is observe-only — `coeff` reads a polynomial and only `ZEROP` is named, so
// nothing BUILDS one. Judson's construction needs `(a_n / b_m) x^{n-m}`, a single term, so
// that is the constructor to add: `monomial(a, k)` is the polynomial `a x^k`.
func monomial(a: F, k: Nat) => Poly
axiom monomialCoeffAtItsIndex: forall a: F; forall k: Nat; coeff(monomial(a, k), k) = a
axiom monomialCoeffElsewhere: forall a: F; forall k, i: Nat;
  (not (i = k)) -> coeff(monomial(a, k), i) = zeroF

// A nonzero coefficient makes the monomial's degree exactly its index. This is the first
// thing the construction needs: `(a_n/b_m) x^{n-m}` has degree n - m, which is what makes
// the assembled quotient have the right degree.
theorem aNonzeroMonomialHasItsIndexAsDegree: forall a: F; forall k: Nat;
  (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP)) -> degree(monomial(a, k)) = k
proof
  @generalize-a |
    fix a: F {
      @generalize-k |
        fix k: Nat {
          @given-the-coefficient-is-nonzero |
            assume not (a = zeroF) {
              @given-the-monomial-is-nonzero |
                assume not (monomial(a, k) = ZEROP) {
                  @the-coefficient-is-nonzero |
                    not (a = zeroF)
                    [by hypothesis given-the-coefficient-is-nonzero]
                  @the-monomial-is-nonzero |
                    not (monomial(a, k) = ZEROP)
                    [by hypothesis given-the-monomial-is-nonzero]

                  // its k-th coefficient is a, which is nonzero
                  @the-coefficient-at-k |
                    coeff(monomial(a, k), k) = a
                    [using specialize monomialCoeffAtItsIndex(a, k)]
                  @the-coefficient-at-k-is-nonzero |
                    not (coeff(monomial(a, k), k) = zeroF)
                    [by rewrite the-coefficient-at-k the-coefficient-is-nonzero]

                  // and everything above k vanishes, since those indices differ from k
                  @generalize-index |
                    fix i: Nat {
                      @given-the-index-is-above |
                        assume less_than(k, i) {
                          @the-index-is-above |
                            less_than(k, i)
                            [by hypothesis given-the-index-is-above]
                          @being-above-makes-it-different |
                            k != i
                            [using specialize peano_order.lessThanIsStrict(k, i) the-index-is-above]
                          @the-index-differs-from-k |
                            i != k
                            [using specialize peano_order.natDisequalityIsSymmetric(k, i) being-above-makes-it-different]
                          @the-coefficient-vanishes |
                            coeff(monomial(a, k), i) = zeroF
                            [using specialize monomialCoeffElsewhere(a, k, i) the-index-differs-from-k]
                        }
                      @above-implies-vanishing |
                        less_than(k, i) -> coeff(monomial(a, k), i) = zeroF
                        [by discharge given-the-index-is-above]
                    }
                  @everything-above-k-vanishes |
                    forall i: Nat; less_than(k, i) -> coeff(monomial(a, k), i) = zeroF
                    [by generalize generalize-index]
                  @what-bounding-means |
                    degreeAtMost(monomial(a, k), k) iff
                      (forall i: Nat; less_than(k, i) -> coeff(monomial(a, k), i) = zeroF)
                    [using specialize degreeAtMostMeaning(monomial(a, k), k)]
                  @k-bounds-the-monomial |
                    degreeAtMost(monomial(a, k), k)
                    [using tautology everything-above-k-vanishes what-bounding-means]

                  // nonzero at k and bounded by k: by uniqueness, k IS the degree
                  @k-is-the-degree |
                    k = degree(monomial(a, k))
                    [using specialize degreeIsUnique(monomial(a, k), k) the-monomial-is-nonzero the-coefficient-at-k-is-nonzero k-bounds-the-monomial]
                  @conclusion-the-degree-is-k |
                    degree(monomial(a, k)) = k
                    [by symmetry k-is-the-degree]
                }
              @the-monomial-being-nonzero-gives-the-degree |
                (not (monomial(a, k) = ZEROP)) -> degree(monomial(a, k)) = k
                [by discharge given-the-monomial-is-nonzero]
            }
          @a-nonzero-coefficient-gives-the-degree |
            (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP)) ->
              degree(monomial(a, k)) = k
            [by discharge given-the-coefficient-is-nonzero]
        }
      @discharge-k |
        forall k: Nat;
          (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP)) ->
          degree(monomial(a, k)) = k
        [by generalize generalize-k]
    }
  @conclusion |
    forall a: F; forall k: Nat;
      (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP)) ->
      degree(monomial(a, k)) = k
    [by generalize generalize-a]
qed

// -- THE MONOMIAL-SHIFT LAW ---------------------------------------------------------------
//
// Multiplying by `a x^k` shifts the coefficient family: the i-th coefficient of
// `monomial(c,k) * g` is `c * g_{i-k}`. This is the law Judson's construction needs, because
// his `f(x) - (a_n/b_m) x^{n-m} g(x)` only cancels the leading term if the product's n-th
// coefficient is exactly `(a_n/b_m) * b_m`.
//
// The convolution sum has exactly ONE surviving term — every `j != k` contributes
// `0 * g_{i-j}` — so the proof is two inductions on the fold's limit: below k the sum is
// still empty, and at k the single term appears and nothing after changes it.

// PHASE ONE: summing to any limit strictly below k contributes nothing, since every index
// reached so far misses k.
theorem theMonomialConvolutionIsEmptyBelowItsIndex: forall g: Poly; forall c: F;
  forall k, i, t: Nat;
  less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
proof
  @generalize-g |
    fix g: Poly {
      @generalize-c |
        fix c: F {
          @generalize-k |
            fix k: Nat {
              @generalize-i |
                fix i: Nat {
                  // base: the t = 0 term is m_0 * g_i, and 0 != k because 0 < k.
                  @given-zero-below-k |
                    assume less_than(ZERO, k) {
                      @zero-below-k |
                        less_than(ZERO, k)
                        [by hypothesis given-zero-below-k]
                      @the-base-term |
                        convolution(monomial(c, k), g, i, ZERO) =
                          mulF(coeff(monomial(c, k), ZERO), coeff(g, i))
                        [using specialize convolutionZero(monomial(c, k), g, i)]
                      @zero-differs-from-k |
                        ZERO != k
                        [using specialize peano_order.lessThanIsStrict(ZERO, k) zero-below-k]
                      @the-monomial-vanishes-at-zero |
                        coeff(monomial(c, k), ZERO) = zeroF
                        [using specialize monomialCoeffElsewhere(c, k, ZERO) zero-differs-from-k]
                      @zero-times-anything |
                        mulF(zeroF, coeff(g, i)) = zeroF
                        [using specialize field.mulZeroLeft(coeff(g, i))]
                      @base-case-value |
                        convolution(monomial(c, k), g, i, ZERO) = zeroF
                        [using simplify the-base-term the-monomial-vanishes-at-zero zero-times-anything]
                    }
                  @base-case |
                    less_than(ZERO, k) -> convolution(monomial(c, k), g, i, ZERO) = zeroF
                    [by discharge given-zero-below-k]

                  // step: one more term, whose index succ(t) is still below k, so it misses k.
                  @induction-step |
                    fix t: Nat {
                      @given-inductive-hypothesis |
                        assume less_than(t, k) ->
                          convolution(monomial(c, k), g, i, t) = zeroF {
                          @inductive-hypothesis |
                            less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
                            [by hypothesis given-inductive-hypothesis]
                          @given-successor-below-k |
                            assume less_than(succ(t), k) {
                              @successor-below-k |
                                less_than(succ(t), k)
                                [by hypothesis given-successor-below-k]
                              @t-below-k |
                                less_than(t, k)
                                [using specialize peano_order.lessThanTransitive(t, succ(t), k) t-below-its-successor successor-below-k]
                              @t-below-its-successor |
                                less_than(t, succ(t))
                                [using specialize peano_order.lessThanSelf(t)]
                              @the-sum-so-far-vanishes |
                                convolution(monomial(c, k), g, i, t) = zeroF
                                [using tautology inductive-hypothesis t-below-k]
                              @one-more-term |
                                convolution(monomial(c, k), g, i, succ(t)) =
                                  addF(convolution(monomial(c, k), g, i, t),
                                  mulF(coeff(monomial(c, k), succ(t)),
                                  coeff(g, subN(i, succ(t)))))
                                [using specialize convolutionSucc(monomial(c, k), g, i, t)]
                              @the-successor-differs-from-k |
                                succ(t) != k
                                [using specialize peano_order.lessThanIsStrict(succ(t), k) successor-below-k]
                              @the-monomial-vanishes-here |
                                coeff(monomial(c, k), succ(t)) = zeroF
                                [using specialize monomialCoeffElsewhere(c, k, succ(t)) the-successor-differs-from-k]
                              @the-new-term-is-zero |
                                mulF(zeroF, coeff(g, subN(i, succ(t)))) = zeroF
                                [using specialize field.mulZeroLeft(coeff(g, subN(i, succ(t))))]
                              @the-sum-is-zero-plus-zero |
                                convolution(monomial(c, k), g, i, succ(t)) = addF(zeroF, zeroF)
                                [using simplify one-more-term the-sum-so-far-vanishes the-monomial-vanishes-here the-new-term-is-zero]
                              @zero-plus-zero |
                                addF(zeroF, zeroF) = zeroF
                                [using specialize addZeroLeftF(zeroF)]
                              @conclusion-successor |
                                convolution(monomial(c, k), g, i, succ(t)) = zeroF
                                [using chain the-sum-is-zero-plus-zero zero-plus-zero]
                            }
                          @successor-below-k-implies-vanishing |
                            less_than(succ(t), k) ->
                              convolution(monomial(c, k), g, i, succ(t)) = zeroF
                            [by discharge given-successor-below-k]
                        }
                      @induction-step-at-t |
                        (less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF) ->
                          (less_than(succ(t), k) ->
                          convolution(monomial(c, k), g, i, succ(t)) = zeroF)
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-for-all-t |
                    forall t: Nat;
                      (less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF) ->
                      (less_than(succ(t), k) ->
                      convolution(monomial(c, k), g, i, succ(t)) = zeroF)
                    [by generalize induction-step]
                  @conclusion-for-all-t |
                    forall t: Nat;
                      less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
                    [using instantiation peano.induction((fun t: Nat => less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF)) base-case induction-step-for-all-t]
                }
              @discharge-i |
                forall i: Nat; forall t: Nat;
                  less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
                [by generalize generalize-i]
            }
          @discharge-k |
            forall k: Nat; forall i, t: Nat;
              less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
            [by generalize generalize-k]
        }
      @discharge-c |
        forall c: F; forall k, i, t: Nat;
          less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
        [by generalize generalize-c]
    }
  @conclusion |
    forall g: Poly; forall c: F; forall k, i, t: Nat;
      less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
    [by generalize generalize-g]
qed

// PHASE TWO: at the limit k the single surviving term appears, and the sum from there is
// `c * g_{i-k}` for good. The pivot is the step from k-1 to k, where phase one's "still
// empty" meets the one index that does not miss.
theorem theMonomialConvolutionIsTheShiftedTerm: forall g: Poly; forall c: F;
  forall k, i: Nat;
  convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
proof
  @generalize-g |
    fix g: Poly {
      @generalize-c |
        fix c: F {
          @generalize-k |
            fix k: Nat {
              @generalize-i |
                fix i: Nat {
                  // Two cases on k, because the k = 0 sum has no predecessor to be empty.
                  @k-is-zero-or-a-successor |
                    k = ZERO or (exists t: Nat; k = succ(t))
                    [using specialize peano.zeroOrSucc(k)]

                  @when-k-is-zero |
                    assume k = ZERO {
                      @k-is-zero |
                        k = ZERO
                        [by hypothesis when-k-is-zero]
                      // the whole sum IS the base term, c * g_i, and i - 0 = i
                      @the-base-term |
                        convolution(monomial(c, ZERO), g, i, ZERO) =
                          mulF(coeff(monomial(c, ZERO), ZERO), coeff(g, i))
                        [using specialize convolutionZero(monomial(c, ZERO), g, i)]
                      @the-monomial-at-its-own-index |
                        coeff(monomial(c, ZERO), ZERO) = c
                        [using specialize monomialCoeffAtItsIndex(c, ZERO)]
                      @subtracting-zero |
                        subN(i, ZERO) = i
                        [using specialize subtraction.subZeroRight(i)]
                      @the-value-at-zero |
                        convolution(monomial(c, ZERO), g, i, ZERO) =
                          mulF(c, coeff(g, subN(i, ZERO)))
                        [using simplify the-base-term the-monomial-at-its-own-index subtracting-zero]
                      @conclusion-when-zero |
                        convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
                        [by rewrite k-is-zero-flipped the-value-at-zero]
                      @k-is-zero-flipped |
                        ZERO = k
                        [by symmetry k-is-zero]
                    }

                  @when-k-is-a-successor |
                    assume exists t: Nat; k = succ(t) {
                      @the-predecessor-exists |
                        exists t: Nat; k = succ(t)
                        [by hypothesis when-k-is-a-successor]
                      @with-predecessor-t |
                        unpack t: Nat from the-predecessor-exists {
                          @k-is-the-successor |
                            k = succ(t)
                            [by hypothesis with-predecessor-t]
                          // the sum to t is empty (t < k), and the k-th term is c * g_{i-k}
                          @t-is-below-k |
                            less_than(t, succ(t))
                            [using specialize peano_order.lessThanSelf(t)]
                          @t-is-below-k-itself |
                            less_than(t, k)
                            [by rewrite k-is-the-successor-flipped t-is-below-k]
                          @k-is-the-successor-flipped |
                            succ(t) = k
                            [by symmetry k-is-the-successor]
                          @the-sum-to-t-is-empty |
                            convolution(monomial(c, k), g, i, t) = zeroF
                            [using specialize theMonomialConvolutionIsEmptyBelowItsIndex(g, c, k, i, t) t-is-below-k-itself]
                          @one-more-term |
                            convolution(monomial(c, k), g, i, succ(t)) =
                              addF(convolution(monomial(c, k), g, i, t),
                              mulF(coeff(monomial(c, k), succ(t)),
                              coeff(g, subN(i, succ(t)))))
                            [using specialize convolutionSucc(monomial(c, k), g, i, t)]
                          @the-monomial-at-its-own-index |
                            coeff(monomial(c, k), k) = c
                            [using specialize monomialCoeffAtItsIndex(c, k)]
                          @the-surviving-term |
                            coeff(monomial(c, k), succ(t)) = c
                            [by rewrite k-is-the-successor-flipped the-monomial-at-its-own-index]
                          @the-sum-is-zero-plus-the-term |
                            convolution(monomial(c, k), g, i, succ(t)) =
                              addF(zeroF, mulF(c, coeff(g, subN(i, succ(t)))))
                            [using simplify one-more-term the-sum-to-t-is-empty the-surviving-term]
                          @zero-plus-the-term |
                            addF(zeroF, mulF(c, coeff(g, subN(i, succ(t))))) =
                              mulF(c, coeff(g, subN(i, succ(t))))
                            [using specialize addZeroLeftF(mulF(c, coeff(g, subN(i, succ(t)))))]
                          @the-value-at-the-successor |
                            convolution(monomial(c, k), g, i, succ(t)) =
                              mulF(c, coeff(g, subN(i, succ(t))))
                            [using chain the-sum-is-zero-plus-the-term zero-plus-the-term]
                          @conclusion-when-a-successor |
                            convolution(monomial(c, k), g, i, k) =
                              mulF(c, coeff(g, subN(i, k)))
                            [by rewrite k-is-the-successor the-value-at-the-successor]
                        }
                      @the-value-when-a-successor |
                        convolution(monomial(c, k), g, i, k) =
                          mulF(c, coeff(g, subN(i, k)))
                        [by unpacked with-predecessor-t]
                    }

                  @conclusion-either-way |
                    convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
                    [by common_conclusion k-is-zero-or-a-successor when-k-is-zero when-k-is-a-successor]
                }
              @discharge-i |
                forall i: Nat;
                  convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
                [by generalize generalize-i]
            }
          @discharge-k |
            forall k: Nat; forall i: Nat;
              convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
            [by generalize generalize-k]
        }
      @discharge-c |
        forall c: F; forall k, i: Nat;
          convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
        [by generalize generalize-c]
    }
  @conclusion |
    forall g: Poly; forall c: F; forall k, i: Nat;
      convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
    [by generalize generalize-g]
qed

// PHASE THREE: above k the sum STABILIZES — every further term is `0 * g`, so extending the
// limit past k changes nothing. This is what carries the shift law from the special index k
// to a general index, which is what the cancellation needs: it reads the product's n-th
// coefficient, and that sum runs to n, not to k.
theorem theMonomialConvolutionStabilizesAboveItsIndex: forall g: Poly; forall c: F;
  forall k, i, t: Nat;
  convolution(monomial(c, k), g, i, peano.add(k, t)) =
  convolution(monomial(c, k), g, i, k)
proof
  @generalize-g |
    fix g: Poly {
      @generalize-c |
        fix c: F {
          @generalize-k |
            fix k: Nat {
              @generalize-i |
                fix i: Nat {
                  // base: adding nothing to the limit.
                  @adding-zero |
                    peano.add(k, ZERO) = k
                    [using specialize peano.addZeroRight(k)]
                  @base-case |
                    convolution(monomial(c, k), g, i, peano.add(k, ZERO)) =
                      convolution(monomial(c, k), g, i, k)
                    [by rewrite adding-zero the-sum-at-k-is-itself]
                  @the-sum-at-k-is-itself |
                    convolution(monomial(c, k), g, i, k) =
                      convolution(monomial(c, k), g, i, k)
                    [by reflexivity]

                  // step: the next index is k + succ(t), which is strictly above k, so the
                  // monomial vanishes there and the term adds nothing.
                  @induction-step |
                    fix t: Nat {
                      @given-inductive-hypothesis |
                        assume convolution(monomial(c, k), g, i, peano.add(k, t)) =
                          convolution(monomial(c, k), g, i, k) {
                          @inductive-hypothesis |
                            convolution(monomial(c, k), g, i, peano.add(k, t)) =
                              convolution(monomial(c, k), g, i, k)
                            [by hypothesis given-inductive-hypothesis]
                          @the-next-limit |
                            peano.add(k, succ(t)) = succ(peano.add(k, t))
                            [using specialize peano.addSuccRight(k, t)]
                          @one-more-term |
                            convolution(monomial(c, k), g, i, succ(peano.add(k, t))) =
                              addF(convolution(monomial(c, k), g, i, peano.add(k, t)),
                              mulF(coeff(monomial(c, k), succ(peano.add(k, t))),
                              coeff(g, subN(i, succ(peano.add(k, t))))))
                            [using specialize convolutionSucc(monomial(c, k), g, i, peano.add(k, t))]
                          // succ(k+t) is strictly above k, hence differs from it
                          // k <= k + t (t is the gap), so k < succ(k + t).
                          //
                          // NOT `[using arithmetic(peano)]`: that decision is SORT-AGNOSTIC
                          // and pure-ℤ unless a `nonneg` predicate is in scope, so it reads
                          // `t` as possibly negative and reports the statement FALSE. Strict
                          // certified it anyway, so this was a `--fast`/strict divergence
                          // until it was proved from ℕ's own order instead.
                          @the-gap-exists |
                            exists d: Nat; peano.add(k, d) = peano.add(k, t)
                            [by witness(t) the-sum-is-itself]
                          @the-sum-is-itself |
                            peano.add(k, t) = peano.add(k, t)
                            [by reflexivity]
                          @what-a-bound-means |
                            peano_order.less_or_equal(k, peano.add(k, t)) iff
                              (exists d: Nat; peano.add(k, d) = peano.add(k, t))
                            [using specialize peano_order.lessOrEqualIsGapExistential(k, peano.add(k, t))]
                          @k-is-bounded-by-the-sum |
                            peano_order.less_or_equal(k, peano.add(k, t))
                            [using tautology the-gap-exists what-a-bound-means]
                          @k-is-below-the-next-index |
                            less_than(k, succ(peano.add(k, t)))
                            [using specialize peano_order.lessOrEqualToLessThanSucc(k, peano.add(k, t)) k-is-bounded-by-the-sum]
                          @k-differs-from-the-next-index |
                            k != succ(peano.add(k, t))
                            [using specialize peano_order.lessThanIsStrict(k, succ(peano.add(k, t))) k-is-below-the-next-index]
                          @the-next-index-differs-from-k |
                            succ(peano.add(k, t)) != k
                            [using specialize peano_order.natDisequalityIsSymmetric(k, succ(peano.add(k, t))) k-differs-from-the-next-index]
                          @the-monomial-vanishes-there |
                            coeff(monomial(c, k), succ(peano.add(k, t))) = zeroF
                            [using specialize monomialCoeffElsewhere(c, k, succ(peano.add(k, t))) the-next-index-differs-from-k]
                          @the-new-term-is-zero |
                            mulF(zeroF, coeff(g, subN(i, succ(peano.add(k, t))))) = zeroF
                            [using specialize field.mulZeroLeft(coeff(g, subN(i, succ(peano.add(k, t)))))]
                          @the-sum-gains-zero |
                            convolution(monomial(c, k), g, i, succ(peano.add(k, t))) =
                              addF(convolution(monomial(c, k), g, i, k), zeroF)
                            [using simplify one-more-term the-monomial-vanishes-there the-new-term-is-zero inductive-hypothesis]
                          @adding-zero-changes-nothing |
                            addF(convolution(monomial(c, k), g, i, k), zeroF) =
                              convolution(monomial(c, k), g, i, k)
                            [using specialize field.addZeroRight(convolution(monomial(c, k), g, i, k))]
                          @the-value-at-the-next-index |
                            convolution(monomial(c, k), g, i, succ(peano.add(k, t))) =
                              convolution(monomial(c, k), g, i, k)
                            [using chain the-sum-gains-zero adding-zero-changes-nothing]
                          @conclusion-successor |
                            convolution(monomial(c, k), g, i, peano.add(k, succ(t))) =
                              convolution(monomial(c, k), g, i, k)
                            [by rewrite the-next-limit the-value-at-the-next-index]
                        }
                      @induction-step-at-t |
                        (convolution(monomial(c, k), g, i, peano.add(k, t)) =
                          convolution(monomial(c, k), g, i, k)) ->
                          (convolution(monomial(c, k), g, i, peano.add(k, succ(t))) =
                          convolution(monomial(c, k), g, i, k))
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-for-all-t |
                    forall t: Nat;
                      (convolution(monomial(c, k), g, i, peano.add(k, t)) =
                      convolution(monomial(c, k), g, i, k)) ->
                      (convolution(monomial(c, k), g, i, peano.add(k, succ(t))) =
                      convolution(monomial(c, k), g, i, k))
                    [by generalize induction-step]
                  @conclusion-for-all-t |
                    forall t: Nat;
                      convolution(monomial(c, k), g, i, peano.add(k, t)) =
                      convolution(monomial(c, k), g, i, k)
                    [using instantiation peano.induction((fun t: Nat => convolution(monomial(c, k), g, i, peano.add(k, t)) = convolution(monomial(c, k), g, i, k))) base-case induction-step-for-all-t]
                }
              @discharge-i |
                forall i: Nat; forall t: Nat;
                  convolution(monomial(c, k), g, i, peano.add(k, t)) =
                  convolution(monomial(c, k), g, i, k)
                [by generalize generalize-i]
            }
          @discharge-k |
            forall k: Nat; forall i, t: Nat;
              convolution(monomial(c, k), g, i, peano.add(k, t)) =
              convolution(monomial(c, k), g, i, k)
            [by generalize generalize-k]
        }
      @discharge-c |
        forall c: F; forall k, i, t: Nat;
          convolution(monomial(c, k), g, i, peano.add(k, t)) =
          convolution(monomial(c, k), g, i, k)
        [by generalize generalize-c]
    }
  @conclusion |
    forall g: Poly; forall c: F; forall k, i, t: Nat;
      convolution(monomial(c, k), g, i, peano.add(k, t)) =
      convolution(monomial(c, k), g, i, k)
    [by generalize generalize-g]
qed

// THE SHIFT LAW, in the general form the cancellation reads: at index k + t, the product's
// coefficient is `c * g_t`. The sum there runs to k + t, which stabilization collapses back
// to k, where phase two names the single surviving term.
theorem theMonomialShiftsEveryCoefficient: forall g: Poly; forall c: F; forall k, t: Nat;
  coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
proof
  @generalize-g |
    fix g: Poly {
      @generalize-c |
        fix c: F {
          @generalize-k |
            fix k: Nat {
              @generalize-t |
                fix t: Nat {
                  @the-coefficient-is-the-convolution |
                    coeff(mulP(monomial(c, k), g), peano.add(k, t)) =
                      convolution(monomial(c, k), g, peano.add(k, t), peano.add(k, t))
                    [using specialize mulPolyCoeff(monomial(c, k), g, peano.add(k, t))]
                  @the-sum-stabilizes |
                    convolution(monomial(c, k), g, peano.add(k, t), peano.add(k, t)) =
                      convolution(monomial(c, k), g, peano.add(k, t), k)
                    [using specialize theMonomialConvolutionStabilizesAboveItsIndex(g, c, k, peano.add(k, t), t)]
                  @the-surviving-term |
                    convolution(monomial(c, k), g, peano.add(k, t), k) =
                      mulF(c, coeff(g, subN(peano.add(k, t), k)))
                    [using specialize theMonomialConvolutionIsTheShiftedTerm(g, c, k, peano.add(k, t))]
                  // sub(k+t, k) = t: commute the sum, then subAddCancel cancels the k.
                  @the-sum-commutes |
                    peano.add(k, t) = peano.add(t, k)
                    [using specialize peano.addIsCommutative(k, t)]
                  @cancelling-the-k |
                    subN(peano.add(t, k), k) = t
                    [using specialize subtraction.subAddCancel(t, k)]
                  @the-shift-recovers-t |
                    subN(peano.add(k, t), k) = t
                    [using simplify the-sum-commutes cancelling-the-k]
                  @the-term-at-t |
                    convolution(monomial(c, k), g, peano.add(k, t), k) = mulF(c, coeff(g, t))
                    [using simplify the-surviving-term the-shift-recovers-t]
                  @conclusion-the-general-shift |
                    coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
                    [using chain the-coefficient-is-the-convolution the-sum-stabilizes the-term-at-t]
                }
              @discharge-t |
                forall t: Nat;
                  coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
                [by generalize generalize-t]
            }
          @discharge-k |
            forall k: Nat; forall t: Nat;
              coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
            [by generalize generalize-k]
        }
      @discharge-c |
        forall c: F; forall k, t: Nat;
          coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
        [by generalize generalize-c]
    }
  @conclusion |
    forall g: Poly; forall c: F; forall k, t: Nat;
      coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
    [by generalize generalize-g]
qed

// THE SHIFT LAW at the index that matters: the k-th coefficient of `monomial(c,k) * g` is
// `c * g_0`, which is the leading coefficient Judson's cancellation needs.
theorem theMonomialShiftsTheCoefficients: forall g: Poly; forall c: F; forall k: Nat;
  coeff(mulP(monomial(c, k), g), k) = mulF(c, coeff(g, ZERO))
proof
  @generalize-g |
    fix g: Poly {
      @generalize-c |
        fix c: F {
          @generalize-k |
            fix k: Nat {
              @the-coefficient-is-the-convolution |
                coeff(mulP(monomial(c, k), g), k) = convolution(monomial(c, k), g, k, k)
                [using specialize mulPolyCoeff(monomial(c, k), g, k)]
              @the-convolution-is-the-shifted-term |
                convolution(monomial(c, k), g, k, k) = mulF(c, coeff(g, subN(k, k)))
                [using specialize theMonomialConvolutionIsTheShiftedTerm(g, c, k, k)]
              @the-shift-vanishes |
                subN(k, k) = ZERO
                [using specialize subtraction.subSelf(k)]
              @the-shifted-term-at-zero |
                convolution(monomial(c, k), g, k, k) = mulF(c, coeff(g, ZERO))
                [using simplify the-convolution-is-the-shifted-term the-shift-vanishes]
              @conclusion-the-shift |
                coeff(mulP(monomial(c, k), g), k) = mulF(c, coeff(g, ZERO))
                [using chain the-coefficient-is-the-convolution the-shifted-term-at-zero]
            }
          @discharge-k |
            forall k: Nat; coeff(mulP(monomial(c, k), g), k) = mulF(c, coeff(g, ZERO))
            [by generalize generalize-k]
        }
      @discharge-c |
        forall c: F; forall k: Nat;
          coeff(mulP(monomial(c, k), g), k) = mulF(c, coeff(g, ZERO))
        [by generalize generalize-c]
    }
  @conclusion |
    forall g: Poly; forall c: F; forall k: Nat;
      coeff(mulP(monomial(c, k), g), k) = mulF(c, coeff(g, ZERO))
    [by generalize generalize-g]
qed

// -- THE LEADING-TERM CANCELLATION --------------------------------------------------------
//
// This is where `recip` finally earns its place, and it is the crux of Judson's induction.
// He subtracts `(a_n / b_m) x^{n-m} g(x)` from `f(x)`, and the point of that coefficient is
// that the two leading terms become EQUAL, so the difference vanishes at index n.
//
// Concretely, with `c = a_n * recip(b_m)` and `k = n - m`, the shift law gives the
// subtrahend's coefficient at `k + m = n` as `c * b_m`, and
//
//     c * b_m = (a_n * recip(b_m)) * b_m = a_n * (recip(b_m) * b_m) = a_n * 1 = a_n
//
// so `coeff(f, n) - coeff(subtrahend, n) = a_n - a_n = 0`. The index arithmetic (`k + m = n`
// when `m <= n`) is what the hypothesis buys.

// The chosen coefficient reproduces the leading coefficient: `(a_n * recip(b_m)) * b_m = a_n`.
theorem theChosenCoefficientReproducesTheLeadingOne: forall leading, divisor_leading: F;
  (not (divisor_leading = zeroF)) ->
  mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) = leading
proof
  @generalize-leading |
    fix leading: F {
      @generalize-divisor |
        fix divisor_leading: F {
          @given-the-divisor-is-nonzero |
            assume not (divisor_leading = zeroF) {
              @the-divisor-is-nonzero |
                divisor_leading != zeroF
                [by hypothesis given-the-divisor-is-nonzero]
              @regroup |
                mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) =
                  mulF(leading, mulF(recipF(divisor_leading), divisor_leading))
                [using specialize field.mulIsAssociative(leading, recipF(divisor_leading), divisor_leading)]
              @the-reciprocal-cancels |
                mulF(recipF(divisor_leading), divisor_leading) = oneF
                [using specialize field.recipMulLeft(divisor_leading) the-divisor-is-nonzero]
              @times-one |
                mulF(leading, oneF) = leading
                [using specialize field.mulOneRight(leading)]
              @regrouped-to-one |
                mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) =
                  mulF(leading, oneF)
                [using simplify regroup the-reciprocal-cancels]
              @conclusion-reproduces |
                mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) = leading
                [using chain regrouped-to-one times-one]
            }
          @nonzero-implies-reproduction |
            (not (divisor_leading = zeroF)) ->
              mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) = leading
            [by discharge given-the-divisor-is-nonzero]
        }
      @discharge-divisor |
        forall divisor_leading: F;
          (not (divisor_leading = zeroF)) ->
          mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) = leading
        [by generalize generalize-divisor]
    }
  @conclusion |
    forall leading, divisor_leading: F;
      (not (divisor_leading = zeroF)) ->
      mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) = leading
    [by generalize generalize-leading]
qed

// THE CANCELLATION: at index k + m, the difference's coefficient is ZERO.
//
// `f` and `g` are arbitrary; what matters is that `g`'s m-th coefficient is nonzero (it is
// `g`'s leading one) and that `f`'s coefficient at `k + m` is the `leading` being cancelled.
theorem theLeadingTermsCancel: forall f, g: Poly; forall k, m: Nat;
  (not (coeff(g, m) = zeroF)) ->
  coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)),
  peano.add(k, m)) = zeroF
proof
  @generalize-f |
    fix f: Poly {
      @generalize-g |
        fix g: Poly {
          @generalize-k |
            fix k: Nat {
              @generalize-m |
                fix m: Nat {
                  @given-the-divisor-leads |
                    assume not (coeff(g, m) = zeroF) {
                      @the-divisor-leads |
                        coeff(g, m) != zeroF
                        [by hypothesis given-the-divisor-leads]

                      // the difference's coefficient, by subPolyCoeff
                      @the-difference-coefficient |
                        coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) =
                          addF(coeff(f, peano.add(k, m)),
                          negF(coeff(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), peano.add(k, m))))
                        [using specialize subPolyCoeff(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), peano.add(k, m))]

                      // the subtrahend's coefficient at k + m, by the shift law
                      @the-subtrahend-coefficient |
                        coeff(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), peano.add(k, m)) =
                          mulF(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), coeff(g, m))
                        [using specialize theMonomialShiftsEveryCoefficient(g, mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k, m)]

                      // and that product IS the leading coefficient
                      @the-coefficient-reproduces-the-leading-one |
                        mulF(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), coeff(g, m)) =
                          coeff(f, peano.add(k, m))
                        [using specialize theChosenCoefficientReproducesTheLeadingOne(coeff(f, peano.add(k, m)), coeff(g, m)) the-divisor-leads]
                      @the-subtrahend-is-the-leading-coefficient |
                        coeff(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), peano.add(k, m)) =
                          coeff(f, peano.add(k, m))
                        [using chain the-subtrahend-coefficient the-coefficient-reproduces-the-leading-one]

                      // so the difference is a_n + (-a_n) = 0
                      @the-difference-is-a-cancelling-pair |
                        coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) =
                          addF(coeff(f, peano.add(k, m)), negF(coeff(f, peano.add(k, m))))
                        [using simplify the-difference-coefficient the-subtrahend-is-the-leading-coefficient]
                      @the-pair-cancels |
                        addF(coeff(f, peano.add(k, m)), negF(coeff(f, peano.add(k, m)))) = zeroF
                        [using specialize field.addNegRight(coeff(f, peano.add(k, m)))]
                      @conclusion-the-cancellation |
                        coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
                        [using chain the-difference-is-a-cancelling-pair the-pair-cancels]
                    }
                  @leading-implies-cancellation |
                    (not (coeff(g, m) = zeroF)) ->
                      coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
                    [by discharge given-the-divisor-leads]
                }
              @discharge-m |
                forall m: Nat;
                  (not (coeff(g, m) = zeroF)) ->
                  coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
                [by generalize generalize-m]
            }
          @discharge-k |
            forall k: Nat; forall m: Nat;
              (not (coeff(g, m) = zeroF)) ->
              coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
            [by generalize generalize-k]
        }
      @discharge-g |
        forall g: Poly; forall k, m: Nat;
          (not (coeff(g, m) = zeroF)) ->
          coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: Poly; forall k, m: Nat;
      (not (coeff(g, m) = zeroF)) ->
      coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
    [by generalize generalize-f]
qed

// -- THE DEGREE DROP ----------------------------------------------------------------------
//
// `theLeadingTermsCancel` kills ONE coefficient. Judson needs the stronger statement that
// `f'(x) = f(x) - (a_n/b_m) x^{n-m} g(x)` "has degree less than n or is the zero polynomial",
// which is what makes his induction descend.
//
// The degree is carried as `succ(d)` rather than as `n` with an `n - 1` elsewhere: the
// conclusion is a bound at `d`, and writing it this way keeps truncated subtraction out of
// the statement entirely.
//
// Two inputs: the cancellation at the top index, and that BOTH `f` and the subtrahend are
// bounded by that index, so nothing above it survives on either side.
theorem theDifferenceDropsADegree: forall f, h: Poly; forall d: Nat;
  coeff(subP(f, h), succ(d)) = zeroF ->
  degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
  degreeAtMost(subP(f, h), d)
proof
  @generalize-f |
    fix f: Poly {
      @generalize-h |
        fix h: Poly {
          @generalize-d |
            fix d: Nat {
              @given-the-top-cancels |
                assume coeff(subP(f, h), succ(d)) = zeroF {
                  @given-f-is-bounded |
                    assume degreeAtMost(f, succ(d)) {
                      @given-h-is-bounded |
                        assume degreeAtMost(h, succ(d)) {
                          @the-top-cancels |
                            coeff(subP(f, h), succ(d)) = zeroF
                            [by hypothesis given-the-top-cancels]
                          @f-is-bounded |
                            degreeAtMost(f, succ(d))
                            [by hypothesis given-f-is-bounded]
                          @h-is-bounded |
                            degreeAtMost(h, succ(d))
                            [by hypothesis given-h-is-bounded]

                          // unfold both bounds into their coefficient statements
                          @what-f-bounding-means |
                            degreeAtMost(f, succ(d)) iff
                              (forall i: Nat; less_than(succ(d), i) -> coeff(f, i) = zeroF)
                            [using specialize degreeAtMostMeaning(f, succ(d))]
                          @f-vanishes-above |
                            forall i: Nat; less_than(succ(d), i) -> coeff(f, i) = zeroF
                            [using tautology f-is-bounded what-f-bounding-means]
                          @what-h-bounding-means |
                            degreeAtMost(h, succ(d)) iff
                              (forall i: Nat; less_than(succ(d), i) -> coeff(h, i) = zeroF)
                            [using specialize degreeAtMostMeaning(h, succ(d))]
                          @h-vanishes-above |
                            forall i: Nat; less_than(succ(d), i) -> coeff(h, i) = zeroF
                            [using tautology h-is-bounded what-h-bounding-means]

                          // every index strictly above d is either succ(d) itself — where the
                          // cancellation applies — or strictly above succ(d), where both
                          // polynomials already vanish.
                          @generalize-index |
                            fix i: Nat {
                              @given-the-index-is-above-d |
                                assume less_than(d, i) {
                                  @the-index-is-above-d |
                                    less_than(d, i)
                                    [by hypothesis given-the-index-is-above-d]
                                  // d < i gives succ(d) < succ(i), hence succ(d) <= i.
                                  @the-successors-compare |
                                    less_than(succ(d), succ(i))
                                    [using specialize peano_order.succPreservesOrder(d, i) the-index-is-above-d]
                                  @the-successor-is-bounded-by-the-index |
                                    peano_order.less_or_equal(succ(d), i)
                                    [using specialize peano_order.lessThanSuccToLessOrEqual(succ(d), i) the-successors-compare]
                                  @the-index-splits |
                                    less_than(succ(d), i) or succ(d) = i
                                    [using specialize peano_order.lessOrEqualSplit(succ(d), i) the-successor-is-bounded-by-the-index]

                                  @when-the-index-is-the-successor |
                                    assume succ(d) = i {
                                      @the-index-is-the-successor |
                                        succ(d) = i
                                        [by hypothesis when-the-index-is-the-successor]
                                      @the-difference-vanishes-at-the-successor |
                                        coeff(subP(f, h), i) = zeroF
                                        [by rewrite the-index-is-the-successor the-top-cancels]
                                    }

                                  @when-the-index-is-higher |
                                    assume less_than(succ(d), i) {
                                      @the-index-is-higher |
                                        less_than(succ(d), i)
                                        [by hypothesis when-the-index-is-higher]
                                      @f-vanishes-here |
                                        coeff(f, i) = zeroF
                                        [using specialize f-vanishes-above(i) the-index-is-higher]
                                      @h-vanishes-here |
                                        coeff(h, i) = zeroF
                                        [using specialize h-vanishes-above(i) the-index-is-higher]
                                      @the-difference-here |
                                        coeff(subP(f, h), i) = addF(coeff(f, i), negF(coeff(h, i)))
                                        [using specialize subPolyCoeff(f, h, i)]
                                      @the-difference-of-zeros |
                                        coeff(subP(f, h), i) = addF(zeroF, negF(zeroF))
                                        [using simplify the-difference-here f-vanishes-here h-vanishes-here]
                                      @negating-zero |
                                        negF(zeroF) = zeroF
                                        [by cite field.negZero]
                                      @zero-plus-zero |
                                        addF(zeroF, zeroF) = zeroF
                                        [using specialize addZeroLeftF(zeroF)]
                                      @the-difference-vanishes-higher-up |
                                        coeff(subP(f, h), i) = zeroF
                                        [using simplify the-difference-of-zeros negating-zero zero-plus-zero]
                                    }

                                  @the-difference-vanishes-either-way |
                                    coeff(subP(f, h), i) = zeroF
                                    [by common_conclusion the-index-splits when-the-index-is-higher when-the-index-is-the-successor]
                                }
                              @above-d-implies-vanishing |
                                less_than(d, i) -> coeff(subP(f, h), i) = zeroF
                                [by discharge given-the-index-is-above-d]
                            }
                          @the-difference-vanishes-above-d |
                            forall i: Nat; less_than(d, i) -> coeff(subP(f, h), i) = zeroF
                            [by generalize generalize-index]
                          @what-the-conclusion-means |
                            degreeAtMost(subP(f, h), d) iff
                              (forall i: Nat; less_than(d, i) -> coeff(subP(f, h), i) = zeroF)
                            [using specialize degreeAtMostMeaning(subP(f, h), d)]
                          @conclusion-the-degree-drops |
                            degreeAtMost(subP(f, h), d)
                            [using tautology the-difference-vanishes-above-d what-the-conclusion-means]
                        }
                      @h-bounded-implies-the-drop |
                        degreeAtMost(h, succ(d)) -> degreeAtMost(subP(f, h), d)
                        [by discharge given-h-is-bounded]
                    }
                  @both-bounded-imply-the-drop |
                    degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
                      degreeAtMost(subP(f, h), d)
                    [by discharge given-f-is-bounded]
                }
              @cancellation-implies-the-drop |
                coeff(subP(f, h), succ(d)) = zeroF ->
                  degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
                  degreeAtMost(subP(f, h), d)
                [by discharge given-the-top-cancels]
            }
          @discharge-d |
            forall d: Nat;
              coeff(subP(f, h), succ(d)) = zeroF ->
              degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
              degreeAtMost(subP(f, h), d)
            [by generalize generalize-d]
        }
      @discharge-h |
        forall h: Poly; forall d: Nat;
          coeff(subP(f, h), succ(d)) = zeroF ->
          degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
          degreeAtMost(subP(f, h), d)
        [by generalize generalize-h]
    }
  @conclusion |
    forall f, h: Poly; forall d: Nat;
      coeff(subP(f, h), succ(d)) = zeroF ->
      degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
      degreeAtMost(subP(f, h), d)
    [by generalize generalize-f]
qed

// -- THE DROP AT JUDSON'S OWN SUBTRAHEND --------------------------------------------------
//
// `theDifferenceDropsADegree` takes three hypotheses. Here they are discharged at the actual
// construction, so the result is the step his induction uses: subtracting
// `(a_n/b_m) x^{n-m} g(x)` from an `f` of degree `succ(d)` leaves something of degree at
// most `d`.
//
// The hypotheses go as follows. The cancellation is `theLeadingTermsCancel` at `k + m =
// succ(d)`. The bound on `f` is `degreeBoundsTheCoefficients` rewritten through
// `degree(f) = succ(d)`. The bound on the subtrahend is `degreeOfAProduct` plus the
// monomial's own degree: `deg(monomial(c,k) * g) = k + m`, which the hypothesis says is
// `succ(d)`.
theorem theConstructionDropsADegree: forall f, g: Poly; forall k, m, d: Nat;
  (not (f = ZEROP)) -> (not (g = ZEROP)) ->
  (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
  (not (coeff(g, m) = zeroF)) ->
  (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
  degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
  degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
proof
  @generalize-f |
    fix f: Poly {
      @generalize-g |
        fix g: Poly {
          @generalize-k |
            fix k: Nat {
              @generalize-m |
                fix m: Nat {
                  @generalize-d |
                    fix d: Nat {
                      @given-f-nonzero |
                        assume not (f = ZEROP) {
                          @given-g-nonzero |
                            assume not (g = ZEROP) {
                              @given-the-monomial-nonzero |
                                assume not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP) {
                                  @given-the-divisor-leads |
                                    assume not (coeff(g, m) = zeroF) {
                                      @given-the-coefficient-nonzero |
                                        assume not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF) {
                                          @given-g-has-degree-m |
                                            assume degree(g) = m {
                                              @given-f-has-the-top-degree |
                                                assume degree(f) = peano.add(k, m) {
                                                  @given-the-top-is-a-successor |
                                                    assume peano.add(k, m) = succ(d) {
                                                      @f-nonzero |
                                                        not (f = ZEROP)
                                                        [by hypothesis given-f-nonzero]
                                                      @g-nonzero |
                                                        not (g = ZEROP)
                                                        [by hypothesis given-g-nonzero]
                                                      @the-monomial-nonzero |
                                                        not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)
                                                        [by hypothesis given-the-monomial-nonzero]
                                                      @the-divisor-leads |
                                                        coeff(g, m) != zeroF
                                                        [by hypothesis given-the-divisor-leads]
                                                      @the-coefficient-nonzero |
                                                        mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) != zeroF
                                                        [by hypothesis given-the-coefficient-nonzero]
                                                      @g-has-degree-m |
                                                        degree(g) = m
                                                        [by hypothesis given-g-has-degree-m]
                                                      @f-has-the-top-degree |
                                                        degree(f) = peano.add(k, m)
                                                        [by hypothesis given-f-has-the-top-degree]
                                                      @the-top-is-a-successor |
                                                        peano.add(k, m) = succ(d)
                                                        [by hypothesis given-the-top-is-a-successor]

                                                      // HYPOTHESIS 1: the cancellation.
                                                      @the-top-coefficient-cancels |
                                                        coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
                                                        [using specialize theLeadingTermsCancel(f, g, k, m) the-divisor-leads]
                                                      @the-cancellation-at-the-successor |
                                                        coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), succ(d)) = zeroF
                                                        [by rewrite the-top-is-a-successor the-top-coefficient-cancels]

                                                      // HYPOTHESIS 2: f is bounded by its own degree, which is succ(d).
                                                      @f-is-bounded-by-its-degree |
                                                        degreeAtMost(f, degree(f))
                                                        [using specialize degreeBoundsTheCoefficients(f) f-nonzero]
                                                      @f-degree-is-the-successor |
                                                        degree(f) = succ(d)
                                                        [using chain f-has-the-top-degree the-top-is-a-successor]
                                                      @f-is-bounded |
                                                        degreeAtMost(f, succ(d))
                                                        [by rewrite f-degree-is-the-successor f-is-bounded-by-its-degree]

                                                      // HYPOTHESIS 3: the subtrahend's degree is k + m = succ(d).
                                                      @the-monomial-has-degree-k |
                                                        degree(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k)) = k
                                                        [using specialize aNonzeroMonomialHasItsIndexAsDegree(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) the-coefficient-nonzero the-monomial-nonzero]
                                                      @the-product-degree |
                                                        degree(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)) =
                                                          peano.add(degree(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k)), degree(g))
                                                        [using specialize degreeOfAProduct(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g) the-monomial-nonzero g-nonzero]
                                                      @the-product-degree-in-k-and-m |
                                                        degree(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)) = peano.add(k, m)
                                                        [using simplify the-product-degree the-monomial-has-degree-k g-has-degree-m]
                                                      @the-subtrahend-degree-is-the-successor |
                                                        degree(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)) = succ(d)
                                                        [using chain the-product-degree-in-k-and-m the-top-is-a-successor]
                                                      @the-subtrahend-nonzero |
                                                        not (mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g) = ZEROP)
                                                        [using specialize aProductOfNonzerosIsNonzero(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g) the-monomial-nonzero g-nonzero]
                                                      @the-subtrahend-is-bounded-by-its-degree |
                                                        degreeAtMost(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), degree(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)))
                                                        [using specialize degreeBoundsTheCoefficients(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)) the-subtrahend-nonzero]
                                                      @the-subtrahend-is-bounded |
                                                        degreeAtMost(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), succ(d))
                                                        [by rewrite the-subtrahend-degree-is-the-successor the-subtrahend-is-bounded-by-its-degree]

                                                      @conclusion-the-construction-drops |
                                                        degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                                        [using specialize theDifferenceDropsADegree(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), d) the-cancellation-at-the-successor f-is-bounded the-subtrahend-is-bounded]
                                                    }
                                                  @successor-implies-the-drop |
                                                    peano.add(k, m) = succ(d) ->
                                                      degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                                    [by discharge given-the-top-is-a-successor]
                                                }
                                              @f-degree-implies-the-drop |
                                                degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                                  degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                                [by discharge given-f-has-the-top-degree]
                                            }
                                          @g-degree-implies-the-drop |
                                            degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                              degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                            [by discharge given-g-has-degree-m]
                                        }
                                      @coefficient-implies-the-drop |
                                        (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                                          degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                          degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                        [by discharge given-the-coefficient-nonzero]
                                    }
                                  @leading-implies-the-drop |
                                    (not (coeff(g, m) = zeroF)) ->
                                      (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                                      degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                      degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                    [by discharge given-the-divisor-leads]
                                }
                              @monomial-implies-the-drop |
                                (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
                                  (not (coeff(g, m) = zeroF)) ->
                                  (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                                  degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                  degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                [by discharge given-the-monomial-nonzero]
                            }
                          @g-nonzero-implies-the-drop |
                            (not (g = ZEROP)) ->
                              (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
                              (not (coeff(g, m) = zeroF)) ->
                              (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                              degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                              degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                            [by discharge given-g-nonzero]
                        }
                      @the-drop |
                        (not (f = ZEROP)) -> (not (g = ZEROP)) ->
                          (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
                          (not (coeff(g, m) = zeroF)) ->
                          (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                          degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                          degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                        [by discharge given-f-nonzero]
                    }
                  @discharge-d |
                    forall d: Nat;
                      (not (f = ZEROP)) -> (not (g = ZEROP)) ->
                      (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
                      (not (coeff(g, m) = zeroF)) ->
                      (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                      degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                      degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                    [by generalize generalize-d]
                }
              @discharge-m |
                forall m, d: Nat;
                  (not (f = ZEROP)) -> (not (g = ZEROP)) ->
                  (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
                  (not (coeff(g, m) = zeroF)) ->
                  (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                  degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                  degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                [by generalize generalize-m]
            }
          @discharge-k |
            forall k, m, d: Nat;
              (not (f = ZEROP)) -> (not (g = ZEROP)) ->
              (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
              (not (coeff(g, m) = zeroF)) ->
              (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
              degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
              degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
            [by generalize generalize-k]
        }
      @discharge-g |
        forall g: Poly; forall k, m, d: Nat;
          (not (f = ZEROP)) -> (not (g = ZEROP)) ->
          (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
          (not (coeff(g, m) = zeroF)) ->
          (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
          degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
          degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: Poly; forall k, m, d: Nat;
      (not (f = ZEROP)) -> (not (g = ZEROP)) ->
      (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
      (not (coeff(g, m) = zeroF)) ->
      (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
      degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
      degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
    [by generalize generalize-f]
qed

// == JUDSON'S DIVISION ALGORITHM (§17.2) ==================================================
//
// "Let f(x) and g(x) be polynomials in F[x], where F is a field and g(x) is a nonzero
// polynomial. Then there exist unique polynomials q(x), r(x) in F[x] such that
// f(x) = g(x) q(x) + r(x), where either deg r(x) < deg g(x) or r(x) is the zero polynomial."
//
// His proof has two halves. The UNIQUENESS half is below, in full. It is pure degree
// arithmetic: it needs no construction, only the fact that a nonzero multiple of g has
// degree at least deg g, which two remainders below deg g cannot match.

// The pivot of his uniqueness argument, isolated: a nonzero multiple of g has degree at
// least that of g. "If q(x) - q_1(x) is not the zero polynomial, then
// deg(g(x)[q(x) - q_1(x)]) >= deg g(x)."
theorem aNonzeroMultipleHasAtLeastTheDegree: forall g, h: Poly;
  (not (g = ZEROP)) -> (not (h = ZEROP)) ->
  (not less_than(degree(mulP(g, h)), degree(g)))
proof
  @generalize-g |
    fix g: Poly {
      @generalize-h |
        fix h: Poly {
          @given-g-nonzero |
            assume not (g = ZEROP) {
              @given-h-nonzero |
                assume not (h = ZEROP) {
                  @g-nonzero |
                    not (g = ZEROP)
                    [by hypothesis given-g-nonzero]
                  @h-nonzero |
                    not (h = ZEROP)
                    [by hypothesis given-h-nonzero]
                  // deg(gh) = deg g + deg h, and a sum is never below its left summand.
                  @the-product-degree |
                    degree(mulP(g, h)) = peano.add(degree(g), degree(h))
                    [using specialize degreeOfAProduct(g, h) g-nonzero h-nonzero]
                  // deg g <= deg g + deg h, with deg h as the gap; a strict reverse would
                  // then make the sum strictly below itself.
                  @the-gap-exists |
                    exists d: Nat; peano.add(degree(g), d) = peano.add(degree(g), degree(h))
                    [by witness(degree(h)) the-sum-is-itself]
                  @the-sum-is-itself |
                    peano.add(degree(g), degree(h)) = peano.add(degree(g), degree(h))
                    [by reflexivity]
                  @what-a-bound-means |
                    peano_order.less_or_equal(degree(g), peano.add(degree(g), degree(h))) iff
                      (exists d: Nat; peano.add(degree(g), d) = peano.add(degree(g), degree(h)))
                    [using specialize peano_order.lessOrEqualIsGapExistential(degree(g), peano.add(degree(g), degree(h)))]
                  @the-degree-is-bounded-by-the-sum |
                    peano_order.less_or_equal(degree(g), peano.add(degree(g), degree(h)))
                    [using tautology the-gap-exists what-a-bound-means]
                  @given-the-sum-is-below |
                    assume less_than(peano.add(degree(g), degree(h)), degree(g)) {
                      @the-sum-is-below |
                        less_than(peano.add(degree(g), degree(h)), degree(g))
                        [by hypothesis given-the-sum-is-below]
                      @the-sum-bounds-the-degree |
                        peano_order.less_or_equal(peano.add(degree(g), degree(h)), degree(g))
                        [using specialize peano_order.lessThanToLessOrEqual(peano.add(degree(g), degree(h)), degree(g)) the-sum-is-below]
                      @the-two-bounds-force-equality |
                        degree(g) = peano.add(degree(g), degree(h))
                        [using specialize peano_order.lessOrEqualAntisymmetric(degree(g), peano.add(degree(g), degree(h))) the-degree-is-bounded-by-the-sum the-sum-bounds-the-degree]
                      @the-degree-is-below-itself |
                        less_than(degree(g), degree(g))
                        [by rewrite the-two-bounds-force-equality-flipped the-sum-is-below]
                      @the-two-bounds-force-equality-flipped |
                        peano.add(degree(g), degree(h)) = degree(g)
                        [by symmetry the-two-bounds-force-equality]
                      @nothing-is-below-itself |
                        not less_than(degree(g), degree(g))
                        [using specialize peano_order.lessThanIrreflexive(degree(g))]
                      @contradiction |
                        not less_than(peano.add(degree(g), degree(h)), degree(g))
                        [by ex_falso the-degree-is-below-itself nothing-is-below-itself]
                    }
                  @being-below-is-absurd |
                    less_than(peano.add(degree(g), degree(h)), degree(g)) ->
                      (not less_than(peano.add(degree(g), degree(h)), degree(g)))
                    [by discharge given-the-sum-is-below]
                  @a-sum-is-not-below-its-summand |
                    not less_than(peano.add(degree(g), degree(h)), degree(g))
                    [using tautology being-below-is-absurd]
                  @conclusion-at-least-the-degree |
                    not less_than(degree(mulP(g, h)), degree(g))
                    [by rewrite the-product-degree-flipped a-sum-is-not-below-its-summand]
                  @the-product-degree-flipped |
                    peano.add(degree(g), degree(h)) = degree(mulP(g, h))
                    [by symmetry the-product-degree]
                }
              @h-nonzero-implies-the-bound |
                (not (h = ZEROP)) -> (not less_than(degree(mulP(g, h)), degree(g)))
                [by discharge given-h-nonzero]
            }
          @both-nonzero-imply-the-bound |
            (not (g = ZEROP)) -> (not (h = ZEROP)) ->
              (not less_than(degree(mulP(g, h)), degree(g)))
            [by discharge given-g-nonzero]
        }
      @discharge-h |
        forall h: Poly;
          (not (g = ZEROP)) -> (not (h = ZEROP)) ->
          (not less_than(degree(mulP(g, h)), degree(g)))
        [by generalize generalize-h]
    }
  @conclusion |
    forall g, h: Poly;
      (not (g = ZEROP)) -> (not (h = ZEROP)) ->
      (not less_than(degree(mulP(g, h)), degree(g)))
    [by generalize generalize-g]
qed

// UNIQUENESS, Judson's second paragraph.
//
// "suppose that there exist two other polynomials q_1(x) and r_1(x) such that
// f(x) = g(x) q_1(x) + r_1(x) ... so that g(x)[q(x) - q_1(x)] = r_1(x) - r(x). If
// q(x) - q_1(x) is not the zero polynomial, then
// deg(g(x)[q(x) - q_1(x)]) = deg(r_1(x) - r(x)) >= deg g(x). However, the degrees of both
// r(x) and r_1(x) are strictly less than the degree of g(x); therefore, r(x) = r_1(x) and
// q(x) = q_1(x)."
//
// The whole force of that paragraph is this: a multiple of g whose degree is below deg g
// must be the zero multiple. Given it, uniqueness is immediate — the regrouped equation
// g(q - q_1) = r_1 - r exhibits such a multiple, so q - q_1 vanishes and then r_1 - r does
// too. Stated about the multiple itself rather than about four polynomials, because that is
// where the content is and it is what the existence half will cite.
theorem aSmallDegreeMultipleIsTheZeroMultiple: forall g, h: Poly;
  (not (g = ZEROP)) ->
  less_than(degree(mulP(g, h)), degree(g)) ->
  h = ZEROP
proof
  @generalize-g |
    fix g: Poly {
      @generalize-h |
        fix h: Poly {
          @given-g-nonzero |
            assume not (g = ZEROP) {
              @given-the-multiple-is-small |
                assume less_than(degree(mulP(g, h)), degree(g)) {
                  @g-nonzero |
                    not (g = ZEROP)
                    [by hypothesis given-g-nonzero]
                  @the-multiple-is-small |
                    less_than(degree(mulP(g, h)), degree(g))
                    [by hypothesis given-the-multiple-is-small]

                  // were h nonzero, g*h would be a NONZERO multiple of g, whose degree is
                  // at least deg g — contradicting that it is below deg g.
                  @given-h-is-nonzero |
                    assume not (h = ZEROP) {
                      @h-is-nonzero |
                        not (h = ZEROP)
                        [by hypothesis given-h-is-nonzero]
                      @the-multiple-is-not-small |
                        not less_than(degree(mulP(g, h)), degree(g))
                        [using specialize aNonzeroMultipleHasAtLeastTheDegree(g, h) g-nonzero h-is-nonzero]
                      @contradiction |
                        h = ZEROP
                        [by ex_falso the-multiple-is-small the-multiple-is-not-small]
                    }
                  @nonzero-is-absurd |
                    (not (h = ZEROP)) -> h = ZEROP
                    [by discharge given-h-is-nonzero]
                  @conclusion-the-multiple-is-zero |
                    h = ZEROP
                    [using tautology nonzero-is-absurd]
                }
              @small-implies-zero |
                less_than(degree(mulP(g, h)), degree(g)) -> h = ZEROP
                [by discharge given-the-multiple-is-small]
            }
          @g-nonzero-implies-zero |
            (not (g = ZEROP)) -> less_than(degree(mulP(g, h)), degree(g)) -> h = ZEROP
            [by discharge given-g-nonzero]
        }
      @discharge-h |
        forall h: Poly;
          (not (g = ZEROP)) -> less_than(degree(mulP(g, h)), degree(g)) -> h = ZEROP
        [by generalize generalize-h]
    }
  @conclusion |
    forall g, h: Poly;
      (not (g = ZEROP)) -> less_than(degree(mulP(g, h)), degree(g)) -> h = ZEROP
    [by generalize generalize-g]
qed

// == WHAT IS NOT HERE, AND THE ONE DECISION IT WAITS ON ===================================
//
// THE EXISTENCE HALF. Every INGREDIENT is built: `monomial` makes the term, `subP` subtracts
// it, `theLeadingTermsCancel` kills the top coefficient, and `theConstructionDropsADegree`
// turns that into a strict degree bound with all three of its hypotheses discharged at
// Judson's own subtrahend. What is missing is not another lemma about degrees.
//
// WHAT IS MISSING IS RING ALGEBRA ON F[x]. The induction's assembly step is
//
//     f - c·x^k·g = g·q' + r    ==>    f = g·(q' + c·x^k) + r
//
// which is four moves in the polynomial RING: additive associativity and commutativity,
// `mulP` distributing over `addP`, `mulP` commutativity (to turn `c·x^k·g` into `g·c·x^k`),
// and that `subP(f,h) = u` gives `f = addP(u,h)`. This file has NONE of them — `mulP` is a
// func with a convolution equation and two degree axioms, nothing more.
//
// They are all PROVED, in `std/ring/polynomial.b4m`, over `ring.Ring`. The obstacle is that
// they cannot be reached from here:
//
//   - 2b4m has no sort subsumption, so `Field` is not a `Ring` and `F[x]` is not an `R[x]`.
//   - `std/field.b4m`'s `RingIsField` model maps the COEFFICIENT ring, which is what lets
//     this file borrow `mulZeroLeft` and friends. It says nothing about polynomials.
//   - A second model mapping `ring_poly.Poly: field_poly.Poly` was tried and does not close:
//     the transfer re-checks the source proof, so it needs every axiom that proof rests on
//     DISCHARGED here — `polyExtensionality`, `addPolyCoeff`, the coefficient AC laws — and
//     this file's signature was deliberately trimmed to what its own theorems exercise.
//
// So the next step is a DESIGN CHOICE, not a proof:
//
//   (a) FATTEN this file to the full F[x] signature (extensionality + the add/neg coefficient
//       equations) and model `R[x]`, inheriting its ring laws. Costs: every added axiom must
//       be exercised or `--library` rejects it, and the model block must list the source's
//       whole axiom set.
//   (b) RE-PROVE the four needed laws here, coefficientwise, as §17.1 did over a ring. Honest
//       and self-contained; duplicates roughly 200 lines of already-proved argument.
//   (c) PARAMETERIZE the polynomial construction over its coefficient theory, so one file
//       serves both. The "sorts over sorts" question, which `sort-parameterization-via-model`
//       settles as model + restated axioms — i.e. it reduces to (a).
//
// USER DIRECTION (2026-10-29), after checking what Judson actually does: the eventual std
// shape is his CHAPTER 20 construction, where `F[x]` is a VECTOR SPACE over `F` — "the
// vectors in F[x] are simply polynomials, and vector addition is just polynomial addition"
// (§20.1). That reorganizes the polynomial layer around the vector-space theory rather than
// re-deriving ring algebra per coefficient sort. Chapter 17 itself uses no vector language,
// so nothing here is wrong; the direction is for when the std layer is rebuilt.
//
// FOR NOW: polynomials stay as they are. Existence waits on that rebuild, not on a local
// patch, so (a) and (b) are deliberately NOT taken.
//
// Judson's two §17.2 corollaries (the factor theorem, at-most-n-zeros) both cite existence,
// so both wait on this. §17.3 rests on them in turn.
//
// Unrelated and also open: multiplicative ASSOCIATIVITY of a polynomial ring, which needs a
// double-sum flattening. See `std/ring/polynomial.b4m`'s closing note.
