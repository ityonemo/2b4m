// std/field/polynomial.b4m — POLYNOMIALS OVER A FIELD, F[x], and the division algorithm.
//
// Judson's §17.2 is stated over a FIELD, not a ring, and the reason is visible in the first
// line of his construction: he divides by the leading coefficient, forming a_n / b_m. A ring
// has no reciprocal, so `std/ring/polynomial.b4m` cannot host this section.
//
// WHY THIS IS A SEPARATE FILE RATHER THAN A MODEL. `std/ring/polynomial.b4m`'s `Poly` is
// built over `ring.Ring` — its coefficient sort, operations and axioms are all bound to that
// theory. A field is a ring with two more axioms, but 2b4m has no sort subsumption, so F[x]
// is its own sort over `field.Field`, declared the same way: a coefficient family read by
// index, equality by coefficients, operations posited as coefficient equations. That is the
// same pattern `std/ring/factor.b4m` uses for R/I and `std/ring/polynomial.b4m` for R[x].
//
// WHAT IS PROVED HERE: the division algorithm's UNIQUENESS half, in full, which is the part
// that follows from degree arithmetic alone. The existence half is an induction on degree
// that constructs the quotient, and it needs a subtraction-of-polynomials step this file
// does not yet carry; see the closing note.

import field <<< "std/field.b4m"
import ring_poly <<< "std/ring/polynomial.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import subtraction <<< "std/peano/subtraction.b4m"

// -- the coefficient field F --------------------------------------------------------------

sort F = field.Field
const zeroF = field.ZERO
const oneF = field.ONE
func addF = field.add
func mulF = field.mul
func negF = field.neg
func recipF = field.recip

fact addIsAssociativeF = field.addIsAssociative
fact addIsCommutativeF = field.addIsCommutative
fact addZeroLeftF = field.addZeroLeft
fact addNegLeftF = field.addNegLeft
fact mulIsCommutativeF = field.mulIsCommutative
fact mulOneLeftF = field.mulOneLeft
fact mulAddDistribLeftF = field.mulAddDistribLeft
fact mulAddDistribRightF = field.mulAddDistribRight
fact fieldInverse = field.fieldInverse
fact oneNotZero = field.oneNotZero

// -- the index sort -----------------------------------------------------------------------

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func subN = subtraction.sub
pred less_than = peano.less_than

// -- the carrier: F[x] --------------------------------------------------------------------

sort Poly
func coeff(p: Poly, i: Nat) => F

// The zero polynomial, named because every degree statement is guarded on `p != ZEROP`.
// Its coefficient equation is not needed by anything proved here, so it is not asserted:
// this file's theorems treat ZEROP only as the excluded case, never compute with it.
// Judson's equality criterion. Needed here both for its own sake and because the `R[x]`
// transfer below re-checks the source proof, so every axiom that proof rests on must be
// discharged by one of ours.
axiom polyExtensionality: forall p, q: Poly;
  (forall i: Nat; coeff(p, i) = coeff(q, i)) -> p = q

const ZEROP: Poly
axiom zeroPolyCoeff: forall i: Nat; coeff(ZEROP, i) = zeroF

// -- degree, as in std/ring/polynomial.b4m ------------------------------------------------
//
// Same shape and same reason: a bound for the general statements, a total function with a
// guarded axiom for the arithmetic, junk at the zero polynomial.
// The degree bound, now exercised by the monomial's degree proof.
pred degreeAtMost(p: Poly, n: Nat)
axiom degreeAtMostMeaning: forall p: Poly; forall n: Nat;
  degreeAtMost(p, n) iff (forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroF)

func degree(p: Poly) => Nat
axiom degreeIsALeadingIndex: forall p: Poly;
  (not (p = ZEROP)) -> (not (coeff(p, degree(p)) = zeroF))
axiom degreeBoundsTheCoefficients: forall p: Poly;
  (not (p = ZEROP)) -> degreeAtMost(p, degree(p))

// -- the operations -----------------------------------------------------------------------

// Multiplication, by the convolution, exactly as `std/ring/polynomial.b4m` defines it over a
// ring. Carried here rather than left opaque because §17.2's existence half BUILDS
// polynomials and then reasons about their coefficients: an opaque `mulP` would force every
// such fact to be a fresh assumption about an undefined function.
func convolution(p: Poly, q: Poly, i: Nat, k: Nat) => F
axiom convolutionZero: forall p, q: Poly; forall i: Nat;
  convolution(p, q, i, ZERO) = mulF(coeff(p, ZERO), coeff(q, i))
axiom convolutionSucc: forall p, q: Poly; forall i, k: Nat;
  convolution(p, q, i, succ(k)) =
  addF(convolution(p, q, i, k),
  mulF(coeff(p, succ(k)), coeff(q, subN(i, succ(k)))))

func mulP(p: Poly, q: Poly) => Poly
axiom mulPolyCoeff: forall p, q: Poly; forall i: Nat;
  coeff(mulP(p, q), i) = convolution(p, q, i, i)

// Judson's Proposition 17.4 over a field: the degree of a product is the sum of the degrees.
// A field is an integral domain, so the leading product a_m b_n cannot vanish. Stated as an
// axiom here rather than re-derived: its proof is the §17.1 convolution argument over a
// different coefficient sort, and `std/ring/polynomial.b4m` already carries the leading-term
// step it turns on.
// A field is an integral domain, so a product of nonzeros is nonzero — the other half of
// Judson's Proposition 17.4, needed here to know the subtrahend has a degree at all.
axiom aProductOfNonzerosIsNonzero: forall p, q: Poly;
  (not (p = ZEROP)) -> (not (q = ZEROP)) -> (not (mulP(p, q) = ZEROP))

axiom degreeOfAProduct: forall p, q: Poly;
  (not (p = ZEROP)) -> (not (q = ZEROP)) ->
  degree(mulP(p, q)) = peano.add(degree(p), degree(q))

// `degree` is DETERMINED by its two halves: any index that is nonzero and bounds the rest
// IS the degree. Same statement and same trichotomy argument as `std/ring/polynomial.b4m`'s
// `degreeIsUnique`, re-proved here because that one is over `ring.Ring` and this sort's
// coefficients are `field.Field` — there is no sort subsumption to inherit it through.
theorem degreeIsUnique: forall p: Poly; forall n: Nat;
  (not (p = ZEROP)) -> (not (coeff(p, n) = zeroF)) -> degreeAtMost(p, n) -> n = degree(p)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-n |
        fix n: Nat {
          @given-p-nonzero |
            assume not (p = ZEROP) {
              @given-coefficient-nonzero |
                assume not (coeff(p, n) = zeroF) {
                  @given-n-bounds |
                    assume degreeAtMost(p, n) {
                      @p-nonzero |
                        not (p = ZEROP)
                        [by hypothesis given-p-nonzero]
                      @coefficient-at-n-nonzero |
                        not (coeff(p, n) = zeroF)
                        [by hypothesis given-coefficient-nonzero]
                      @n-bounds-the-coefficients |
                        degreeAtMost(p, n)
                        [by hypothesis given-n-bounds]

                      @degree-coefficient-nonzero |
                        not (coeff(p, degree(p)) = zeroF)
                        [using specialize degreeIsALeadingIndex(p) p-nonzero]
                      @what-n-bounding-means |
                        degreeAtMost(p, n) iff
                          (forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroF)
                        [using specialize degreeAtMostMeaning(p, n)]
                      @above-n-everything-vanishes |
                        forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroF
                        [using tautology n-bounds-the-coefficients what-n-bounding-means]
                      @degree-vanishes-if-above-n |
                        less_than(n, degree(p)) -> coeff(p, degree(p)) = zeroF
                        [using specialize above-n-everything-vanishes(degree(p))]
                      @degree-not-above-n |
                        not less_than(n, degree(p))
                        [using tautology degree-vanishes-if-above-n degree-coefficient-nonzero]

                      @degree-bounds-the-coefficients |
                        degreeAtMost(p, degree(p))
                        [using specialize degreeBoundsTheCoefficients(p) p-nonzero]
                      @what-degree-bounding-means |
                        degreeAtMost(p, degree(p)) iff
                          (forall i: Nat; less_than(degree(p), i) -> coeff(p, i) = zeroF)
                        [using specialize degreeAtMostMeaning(p, degree(p))]
                      @above-the-degree-everything-vanishes |
                        forall i: Nat; less_than(degree(p), i) -> coeff(p, i) = zeroF
                        [using tautology degree-bounds-the-coefficients what-degree-bounding-means]
                      @n-vanishes-if-above-the-degree |
                        less_than(degree(p), n) -> coeff(p, n) = zeroF
                        [using specialize above-the-degree-everything-vanishes(n)]
                      @n-not-above-the-degree |
                        not less_than(degree(p), n)
                        [using tautology n-vanishes-if-above-the-degree coefficient-at-n-nonzero]

                      @trichotomy-at-n-and-the-degree |
                        less_than(n, degree(p)) or n = degree(p) or less_than(degree(p), n)
                        [using specialize peano_order.trichotomy(n, degree(p))]
                      @conclusion-the-degree-is-n |
                        n = degree(p)
                        [using tautology trichotomy-at-n-and-the-degree degree-not-above-n n-not-above-the-degree]
                    }
                  @bounding-implies-the-degree |
                    degreeAtMost(p, n) -> n = degree(p)
                    [by discharge given-n-bounds]
                }
              @nonzero-coefficient-implies-the-degree |
                (not (coeff(p, n) = zeroF)) -> degreeAtMost(p, n) -> n = degree(p)
                [by discharge given-coefficient-nonzero]
            }
          @p-nonzero-implies-the-degree |
            (not (p = ZEROP)) -> (not (coeff(p, n) = zeroF)) -> degreeAtMost(p, n) ->
              n = degree(p)
            [by discharge given-p-nonzero]
        }
      @discharge-n |
        forall n: Nat;
          (not (p = ZEROP)) -> (not (coeff(p, n) = zeroF)) -> degreeAtMost(p, n) ->
          n = degree(p)
        [by generalize generalize-n]
    }
  @conclusion |
    forall p: Poly; forall n: Nat;
      (not (p = ZEROP)) -> (not (coeff(p, n) = zeroF)) -> degreeAtMost(p, n) ->
      n = degree(p)
    [by generalize generalize-p]
qed

// -- the two summation helpers the R[x] transfer needs ------------------------------------
//
// `std/ring/polynomial.b4m` proves multiplicative commutativity through a REINDEXING lemma
// built on two helpers: `tailConvolution`, the top k+1 terms of a coefficient, and
// `segment`, the n+1 terms from an arbitrary base. A model transfer RE-CHECKS the source
// proof, so every symbol that proof mentions needs a counterpart here — these are those
// counterparts, declared with the same recursion equations.
//
// They are pure reification: nothing below proves anything ABOUT them directly. Their whole
// job is to let `polyMulIsCommutative` land over `F`.
func tailConvolution(p: Poly, q: Poly, i: Nat, k: Nat) => F
axiom tailConvolutionZero: forall p, q: Poly; forall i: Nat;
  tailConvolution(p, q, i, ZERO) = mulF(coeff(p, i), coeff(q, ZERO))
axiom tailConvolutionSucc: forall p, q: Poly; forall i, k: Nat;
  tailConvolution(p, q, i, succ(k)) =
  addF(mulF(coeff(p, subN(i, succ(k))), coeff(q, succ(k))),
  tailConvolution(p, q, i, k))

func segment(p: Poly, q: Poly, i: Nat, m: Nat, n: Nat) => F
axiom segmentZero: forall p, q: Poly; forall i, m: Nat;
  segment(p, q, i, m, ZERO) = mulF(coeff(p, m), coeff(q, subN(i, m)))
axiom segmentSucc: forall p, q: Poly; forall i, m, n: Nat;
  segment(p, q, i, m, succ(n)) =
  addF(segment(p, q, i, m, n),
  mulF(coeff(p, peano.add(m, succ(n))), coeff(q, subN(i, peano.add(m, succ(n))))))

// -- addition, negation, and the difference the construction subtracts --------------------
//
// Judson's `f(x) - (a_n/b_m) x^{n-m} g(x)` needs a difference, so addition and negation come
// back here, now that there is a theorem that uses them.
func addP(p: Poly, q: Poly) => Poly
axiom addPolyCoeff: forall p, q: Poly; forall i: Nat;
  coeff(addP(p, q), i) = addF(coeff(p, i), coeff(q, i))

func negP(p: Poly) => Poly
axiom negPolyCoeff: forall p: Poly; forall i: Nat;
  coeff(negP(p), i) = negF(coeff(p, i))

// `subP(p, q)` is `p - q`. Over a FIELD subtraction is total and honest — it is addition of
// the negation, with no truncation anywhere — so this is a definition, not a guarded symbol.
define subP(p, q) = addP(p, negP(q))

// The coefficient of a difference is the difference of the coefficients.
theorem subPolyCoeff: forall p, q: Poly; forall i: Nat;
  coeff(subP(p, q), i) = addF(coeff(p, i), negF(coeff(q, i)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-index |
            fix i: Nat {
              @the-difference-is-a-sum |
                coeff(addP(p, negP(q)), i) = addF(coeff(p, i), coeff(negP(q), i))
                [using specialize addPolyCoeff(p, negP(q), i)]
              @the-negated-coefficient |
                coeff(negP(q), i) = negF(coeff(q, i))
                [using specialize negPolyCoeff(q, i)]
              @conclusion-the-difference |
                coeff(subP(p, q), i) = addF(coeff(p, i), negF(coeff(q, i)))
                [using simplify the-difference-is-a-sum the-negated-coefficient]
            }
          @discharge-index |
            forall i: Nat; coeff(subP(p, q), i) = addF(coeff(p, i), negF(coeff(q, i)))
            [by generalize generalize-index]
        }
      @discharge-q |
        forall q: Poly; forall i: Nat;
          coeff(subP(p, q), i) = addF(coeff(p, i), negF(coeff(q, i)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall i: Nat;
      coeff(subP(p, q), i) = addF(coeff(p, i), negF(coeff(q, i)))
    [by generalize generalize-p]
qed

// -- MONOMIALS: the constructor the existence half needs ----------------------------------
//
// `F[x]` above is observe-only — `coeff` reads a polynomial and only `ZEROP` is named, so
// nothing BUILDS one. Judson's construction needs `(a_n / b_m) x^{n-m}`, a single term, so
// that is the constructor to add: `monomial(a, k)` is the polynomial `a x^k`.
func monomial(a: F, k: Nat) => Poly
axiom monomialCoeffAtItsIndex: forall a: F; forall k: Nat; coeff(monomial(a, k), k) = a
axiom monomialCoeffElsewhere: forall a: F; forall k, i: Nat;
  (not (i = k)) -> coeff(monomial(a, k), i) = zeroF

// A nonzero coefficient makes the monomial's degree exactly its index. This is the first
// thing the construction needs: `(a_n/b_m) x^{n-m}` has degree n - m, which is what makes
// the assembled quotient have the right degree.
theorem aNonzeroMonomialHasItsIndexAsDegree: forall a: F; forall k: Nat;
  (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP)) -> degree(monomial(a, k)) = k
proof
  @generalize-a |
    fix a: F {
      @generalize-k |
        fix k: Nat {
          @given-the-coefficient-is-nonzero |
            assume not (a = zeroF) {
              @given-the-monomial-is-nonzero |
                assume not (monomial(a, k) = ZEROP) {
                  @the-coefficient-is-nonzero |
                    not (a = zeroF)
                    [by hypothesis given-the-coefficient-is-nonzero]
                  @the-monomial-is-nonzero |
                    not (monomial(a, k) = ZEROP)
                    [by hypothesis given-the-monomial-is-nonzero]

                  // its k-th coefficient is a, which is nonzero
                  @the-coefficient-at-k |
                    coeff(monomial(a, k), k) = a
                    [using specialize monomialCoeffAtItsIndex(a, k)]
                  @the-coefficient-at-k-is-nonzero |
                    not (coeff(monomial(a, k), k) = zeroF)
                    [by rewrite the-coefficient-at-k the-coefficient-is-nonzero]

                  // and everything above k vanishes, since those indices differ from k
                  @generalize-index |
                    fix i: Nat {
                      @given-the-index-is-above |
                        assume less_than(k, i) {
                          @the-index-is-above |
                            less_than(k, i)
                            [by hypothesis given-the-index-is-above]
                          @being-above-makes-it-different |
                            k != i
                            [using specialize peano_order.lessThanIsStrict(k, i) the-index-is-above]
                          @the-index-differs-from-k |
                            i != k
                            [using specialize peano_order.natDisequalityIsSymmetric(k, i) being-above-makes-it-different]
                          @the-coefficient-vanishes |
                            coeff(monomial(a, k), i) = zeroF
                            [using specialize monomialCoeffElsewhere(a, k, i) the-index-differs-from-k]
                        }
                      @above-implies-vanishing |
                        less_than(k, i) -> coeff(monomial(a, k), i) = zeroF
                        [by discharge given-the-index-is-above]
                    }
                  @everything-above-k-vanishes |
                    forall i: Nat; less_than(k, i) -> coeff(monomial(a, k), i) = zeroF
                    [by generalize generalize-index]
                  @what-bounding-means |
                    degreeAtMost(monomial(a, k), k) iff
                      (forall i: Nat; less_than(k, i) -> coeff(monomial(a, k), i) = zeroF)
                    [using specialize degreeAtMostMeaning(monomial(a, k), k)]
                  @k-bounds-the-monomial |
                    degreeAtMost(monomial(a, k), k)
                    [using tautology everything-above-k-vanishes what-bounding-means]

                  // nonzero at k and bounded by k: by uniqueness, k IS the degree
                  @k-is-the-degree |
                    k = degree(monomial(a, k))
                    [using specialize degreeIsUnique(monomial(a, k), k) the-monomial-is-nonzero the-coefficient-at-k-is-nonzero k-bounds-the-monomial]
                  @conclusion-the-degree-is-k |
                    degree(monomial(a, k)) = k
                    [by symmetry k-is-the-degree]
                }
              @the-monomial-being-nonzero-gives-the-degree |
                (not (monomial(a, k) = ZEROP)) -> degree(monomial(a, k)) = k
                [by discharge given-the-monomial-is-nonzero]
            }
          @a-nonzero-coefficient-gives-the-degree |
            (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP)) ->
              degree(monomial(a, k)) = k
            [by discharge given-the-coefficient-is-nonzero]
        }
      @discharge-k |
        forall k: Nat;
          (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP)) ->
          degree(monomial(a, k)) = k
        [by generalize generalize-k]
    }
  @conclusion |
    forall a: F; forall k: Nat;
      (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP)) ->
      degree(monomial(a, k)) = k
    [by generalize generalize-a]
qed

// -- THE MONOMIAL-SHIFT LAW ---------------------------------------------------------------
//
// Multiplying by `a x^k` shifts the coefficient family: the i-th coefficient of
// `monomial(c,k) * g` is `c * g_{i-k}`. This is the law Judson's construction needs, because
// his `f(x) - (a_n/b_m) x^{n-m} g(x)` only cancels the leading term if the product's n-th
// coefficient is exactly `(a_n/b_m) * b_m`.
//
// The convolution sum has exactly ONE surviving term — every `j != k` contributes
// `0 * g_{i-j}` — so the proof is two inductions on the fold's limit: below k the sum is
// still empty, and at k the single term appears and nothing after changes it.

// PHASE ONE: summing to any limit strictly below k contributes nothing, since every index
// reached so far misses k.
theorem theMonomialConvolutionIsEmptyBelowItsIndex: forall g: Poly; forall c: F;
  forall k, i, t: Nat;
  less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
proof
  @generalize-g |
    fix g: Poly {
      @generalize-c |
        fix c: F {
          @generalize-k |
            fix k: Nat {
              @generalize-i |
                fix i: Nat {
                  // base: the t = 0 term is m_0 * g_i, and 0 != k because 0 < k.
                  @given-zero-below-k |
                    assume less_than(ZERO, k) {
                      @zero-below-k |
                        less_than(ZERO, k)
                        [by hypothesis given-zero-below-k]
                      @the-base-term |
                        convolution(monomial(c, k), g, i, ZERO) =
                          mulF(coeff(monomial(c, k), ZERO), coeff(g, i))
                        [using specialize convolutionZero(monomial(c, k), g, i)]
                      @zero-differs-from-k |
                        ZERO != k
                        [using specialize peano_order.lessThanIsStrict(ZERO, k) zero-below-k]
                      @the-monomial-vanishes-at-zero |
                        coeff(monomial(c, k), ZERO) = zeroF
                        [using specialize monomialCoeffElsewhere(c, k, ZERO) zero-differs-from-k]
                      @zero-times-anything |
                        mulF(zeroF, coeff(g, i)) = zeroF
                        [using specialize field.mulZeroLeft(coeff(g, i))]
                      @base-case-value |
                        convolution(monomial(c, k), g, i, ZERO) = zeroF
                        [using simplify the-base-term the-monomial-vanishes-at-zero zero-times-anything]
                    }
                  @base-case |
                    less_than(ZERO, k) -> convolution(monomial(c, k), g, i, ZERO) = zeroF
                    [by discharge given-zero-below-k]

                  // step: one more term, whose index succ(t) is still below k, so it misses k.
                  @induction-step |
                    fix t: Nat {
                      @given-inductive-hypothesis |
                        assume less_than(t, k) ->
                          convolution(monomial(c, k), g, i, t) = zeroF {
                          @inductive-hypothesis |
                            less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
                            [by hypothesis given-inductive-hypothesis]
                          @given-successor-below-k |
                            assume less_than(succ(t), k) {
                              @successor-below-k |
                                less_than(succ(t), k)
                                [by hypothesis given-successor-below-k]
                              @t-below-k |
                                less_than(t, k)
                                [using specialize peano_order.lessThanTransitive(t, succ(t), k) t-below-its-successor successor-below-k]
                              @t-below-its-successor |
                                less_than(t, succ(t))
                                [using specialize peano_order.lessThanSelf(t)]
                              @the-sum-so-far-vanishes |
                                convolution(monomial(c, k), g, i, t) = zeroF
                                [using tautology inductive-hypothesis t-below-k]
                              @one-more-term |
                                convolution(monomial(c, k), g, i, succ(t)) =
                                  addF(convolution(monomial(c, k), g, i, t),
                                  mulF(coeff(monomial(c, k), succ(t)),
                                  coeff(g, subN(i, succ(t)))))
                                [using specialize convolutionSucc(monomial(c, k), g, i, t)]
                              @the-successor-differs-from-k |
                                succ(t) != k
                                [using specialize peano_order.lessThanIsStrict(succ(t), k) successor-below-k]
                              @the-monomial-vanishes-here |
                                coeff(monomial(c, k), succ(t)) = zeroF
                                [using specialize monomialCoeffElsewhere(c, k, succ(t)) the-successor-differs-from-k]
                              @the-new-term-is-zero |
                                mulF(zeroF, coeff(g, subN(i, succ(t)))) = zeroF
                                [using specialize field.mulZeroLeft(coeff(g, subN(i, succ(t))))]
                              @the-sum-is-zero-plus-zero |
                                convolution(monomial(c, k), g, i, succ(t)) = addF(zeroF, zeroF)
                                [using simplify one-more-term the-sum-so-far-vanishes the-monomial-vanishes-here the-new-term-is-zero]
                              @zero-plus-zero |
                                addF(zeroF, zeroF) = zeroF
                                [using specialize addZeroLeftF(zeroF)]
                              @conclusion-successor |
                                convolution(monomial(c, k), g, i, succ(t)) = zeroF
                                [using chain the-sum-is-zero-plus-zero zero-plus-zero]
                            }
                          @successor-below-k-implies-vanishing |
                            less_than(succ(t), k) ->
                              convolution(monomial(c, k), g, i, succ(t)) = zeroF
                            [by discharge given-successor-below-k]
                        }
                      @induction-step-at-t |
                        (less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF) ->
                          (less_than(succ(t), k) ->
                          convolution(monomial(c, k), g, i, succ(t)) = zeroF)
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-for-all-t |
                    forall t: Nat;
                      (less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF) ->
                      (less_than(succ(t), k) ->
                      convolution(monomial(c, k), g, i, succ(t)) = zeroF)
                    [by generalize induction-step]
                  @conclusion-for-all-t |
                    forall t: Nat;
                      less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
                    [using instantiation peano.induction((fun t: Nat => less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF)) base-case induction-step-for-all-t]
                }
              @discharge-i |
                forall i: Nat; forall t: Nat;
                  less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
                [by generalize generalize-i]
            }
          @discharge-k |
            forall k: Nat; forall i, t: Nat;
              less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
            [by generalize generalize-k]
        }
      @discharge-c |
        forall c: F; forall k, i, t: Nat;
          less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
        [by generalize generalize-c]
    }
  @conclusion |
    forall g: Poly; forall c: F; forall k, i, t: Nat;
      less_than(t, k) -> convolution(monomial(c, k), g, i, t) = zeroF
    [by generalize generalize-g]
qed

// PHASE TWO: at the limit k the single surviving term appears, and the sum from there is
// `c * g_{i-k}` for good. The pivot is the step from k-1 to k, where phase one's "still
// empty" meets the one index that does not miss.
theorem theMonomialConvolutionIsTheShiftedTerm: forall g: Poly; forall c: F;
  forall k, i: Nat;
  convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
proof
  @generalize-g |
    fix g: Poly {
      @generalize-c |
        fix c: F {
          @generalize-k |
            fix k: Nat {
              @generalize-i |
                fix i: Nat {
                  // Two cases on k, because the k = 0 sum has no predecessor to be empty.
                  @k-is-zero-or-a-successor |
                    k = ZERO or (exists t: Nat; k = succ(t))
                    [using specialize peano.zeroOrSucc(k)]

                  @when-k-is-zero |
                    assume k = ZERO {
                      @k-is-zero |
                        k = ZERO
                        [by hypothesis when-k-is-zero]
                      // the whole sum IS the base term, c * g_i, and i - 0 = i
                      @the-base-term |
                        convolution(monomial(c, ZERO), g, i, ZERO) =
                          mulF(coeff(monomial(c, ZERO), ZERO), coeff(g, i))
                        [using specialize convolutionZero(monomial(c, ZERO), g, i)]
                      @the-monomial-at-its-own-index |
                        coeff(monomial(c, ZERO), ZERO) = c
                        [using specialize monomialCoeffAtItsIndex(c, ZERO)]
                      @subtracting-zero |
                        subN(i, ZERO) = i
                        [using specialize subtraction.subZeroRight(i)]
                      @the-value-at-zero |
                        convolution(monomial(c, ZERO), g, i, ZERO) =
                          mulF(c, coeff(g, subN(i, ZERO)))
                        [using simplify the-base-term the-monomial-at-its-own-index subtracting-zero]
                      @conclusion-when-zero |
                        convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
                        [by rewrite k-is-zero-flipped the-value-at-zero]
                      @k-is-zero-flipped |
                        ZERO = k
                        [by symmetry k-is-zero]
                    }

                  @when-k-is-a-successor |
                    assume exists t: Nat; k = succ(t) {
                      @the-predecessor-exists |
                        exists t: Nat; k = succ(t)
                        [by hypothesis when-k-is-a-successor]
                      @with-predecessor-t |
                        unpack t: Nat from the-predecessor-exists {
                          @k-is-the-successor |
                            k = succ(t)
                            [by hypothesis with-predecessor-t]
                          // the sum to t is empty (t < k), and the k-th term is c * g_{i-k}
                          @t-is-below-k |
                            less_than(t, succ(t))
                            [using specialize peano_order.lessThanSelf(t)]
                          @t-is-below-k-itself |
                            less_than(t, k)
                            [by rewrite k-is-the-successor-flipped t-is-below-k]
                          @k-is-the-successor-flipped |
                            succ(t) = k
                            [by symmetry k-is-the-successor]
                          @the-sum-to-t-is-empty |
                            convolution(monomial(c, k), g, i, t) = zeroF
                            [using specialize theMonomialConvolutionIsEmptyBelowItsIndex(g, c, k, i, t) t-is-below-k-itself]
                          @one-more-term |
                            convolution(monomial(c, k), g, i, succ(t)) =
                              addF(convolution(monomial(c, k), g, i, t),
                              mulF(coeff(monomial(c, k), succ(t)),
                              coeff(g, subN(i, succ(t)))))
                            [using specialize convolutionSucc(monomial(c, k), g, i, t)]
                          @the-monomial-at-its-own-index |
                            coeff(monomial(c, k), k) = c
                            [using specialize monomialCoeffAtItsIndex(c, k)]
                          @the-surviving-term |
                            coeff(monomial(c, k), succ(t)) = c
                            [by rewrite k-is-the-successor-flipped the-monomial-at-its-own-index]
                          @the-sum-is-zero-plus-the-term |
                            convolution(monomial(c, k), g, i, succ(t)) =
                              addF(zeroF, mulF(c, coeff(g, subN(i, succ(t)))))
                            [using simplify one-more-term the-sum-to-t-is-empty the-surviving-term]
                          @zero-plus-the-term |
                            addF(zeroF, mulF(c, coeff(g, subN(i, succ(t))))) =
                              mulF(c, coeff(g, subN(i, succ(t))))
                            [using specialize addZeroLeftF(mulF(c, coeff(g, subN(i, succ(t)))))]
                          @the-value-at-the-successor |
                            convolution(monomial(c, k), g, i, succ(t)) =
                              mulF(c, coeff(g, subN(i, succ(t))))
                            [using chain the-sum-is-zero-plus-the-term zero-plus-the-term]
                          @conclusion-when-a-successor |
                            convolution(monomial(c, k), g, i, k) =
                              mulF(c, coeff(g, subN(i, k)))
                            [by rewrite k-is-the-successor the-value-at-the-successor]
                        }
                      @the-value-when-a-successor |
                        convolution(monomial(c, k), g, i, k) =
                          mulF(c, coeff(g, subN(i, k)))
                        [by unpacked with-predecessor-t]
                    }

                  @conclusion-either-way |
                    convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
                    [by common_conclusion k-is-zero-or-a-successor when-k-is-zero when-k-is-a-successor]
                }
              @discharge-i |
                forall i: Nat;
                  convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
                [by generalize generalize-i]
            }
          @discharge-k |
            forall k: Nat; forall i: Nat;
              convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
            [by generalize generalize-k]
        }
      @discharge-c |
        forall c: F; forall k, i: Nat;
          convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
        [by generalize generalize-c]
    }
  @conclusion |
    forall g: Poly; forall c: F; forall k, i: Nat;
      convolution(monomial(c, k), g, i, k) = mulF(c, coeff(g, subN(i, k)))
    [by generalize generalize-g]
qed

// PHASE THREE: above k the sum STABILIZES — every further term is `0 * g`, so extending the
// limit past k changes nothing. This is what carries the shift law from the special index k
// to a general index, which is what the cancellation needs: it reads the product's n-th
// coefficient, and that sum runs to n, not to k.
theorem theMonomialConvolutionStabilizesAboveItsIndex: forall g: Poly; forall c: F;
  forall k, i, t: Nat;
  convolution(monomial(c, k), g, i, peano.add(k, t)) =
  convolution(monomial(c, k), g, i, k)
proof
  @generalize-g |
    fix g: Poly {
      @generalize-c |
        fix c: F {
          @generalize-k |
            fix k: Nat {
              @generalize-i |
                fix i: Nat {
                  // base: adding nothing to the limit.
                  @adding-zero |
                    peano.add(k, ZERO) = k
                    [using specialize peano.addZeroRight(k)]
                  @base-case |
                    convolution(monomial(c, k), g, i, peano.add(k, ZERO)) =
                      convolution(monomial(c, k), g, i, k)
                    [by rewrite adding-zero the-sum-at-k-is-itself]
                  @the-sum-at-k-is-itself |
                    convolution(monomial(c, k), g, i, k) =
                      convolution(monomial(c, k), g, i, k)
                    [by reflexivity]

                  // step: the next index is k + succ(t), which is strictly above k, so the
                  // monomial vanishes there and the term adds nothing.
                  @induction-step |
                    fix t: Nat {
                      @given-inductive-hypothesis |
                        assume convolution(monomial(c, k), g, i, peano.add(k, t)) =
                          convolution(monomial(c, k), g, i, k) {
                          @inductive-hypothesis |
                            convolution(monomial(c, k), g, i, peano.add(k, t)) =
                              convolution(monomial(c, k), g, i, k)
                            [by hypothesis given-inductive-hypothesis]
                          @the-next-limit |
                            peano.add(k, succ(t)) = succ(peano.add(k, t))
                            [using specialize peano.addSuccRight(k, t)]
                          @one-more-term |
                            convolution(monomial(c, k), g, i, succ(peano.add(k, t))) =
                              addF(convolution(monomial(c, k), g, i, peano.add(k, t)),
                              mulF(coeff(monomial(c, k), succ(peano.add(k, t))),
                              coeff(g, subN(i, succ(peano.add(k, t))))))
                            [using specialize convolutionSucc(monomial(c, k), g, i, peano.add(k, t))]
                          // succ(k+t) is strictly above k, hence differs from it
                          // k <= k + t (t is the gap), so k < succ(k + t).
                          //
                          // NOT `[using arithmetic(peano)]`: that decision is SORT-AGNOSTIC
                          // and pure-ℤ unless a `nonneg` predicate is in scope, so it reads
                          // `t` as possibly negative and reports the statement FALSE. Strict
                          // certified it anyway, so this was a `--fast`/strict divergence
                          // until it was proved from ℕ's own order instead.
                          @the-gap-exists |
                            exists d: Nat; peano.add(k, d) = peano.add(k, t)
                            [by witness(t) the-sum-is-itself]
                          @the-sum-is-itself |
                            peano.add(k, t) = peano.add(k, t)
                            [by reflexivity]
                          @what-a-bound-means |
                            peano_order.less_or_equal(k, peano.add(k, t)) iff
                              (exists d: Nat; peano.add(k, d) = peano.add(k, t))
                            [using specialize peano_order.lessOrEqualIsGapExistential(k, peano.add(k, t))]
                          @k-is-bounded-by-the-sum |
                            peano_order.less_or_equal(k, peano.add(k, t))
                            [using tautology the-gap-exists what-a-bound-means]
                          @k-is-below-the-next-index |
                            less_than(k, succ(peano.add(k, t)))
                            [using specialize peano_order.lessOrEqualToLessThanSucc(k, peano.add(k, t)) k-is-bounded-by-the-sum]
                          @k-differs-from-the-next-index |
                            k != succ(peano.add(k, t))
                            [using specialize peano_order.lessThanIsStrict(k, succ(peano.add(k, t))) k-is-below-the-next-index]
                          @the-next-index-differs-from-k |
                            succ(peano.add(k, t)) != k
                            [using specialize peano_order.natDisequalityIsSymmetric(k, succ(peano.add(k, t))) k-differs-from-the-next-index]
                          @the-monomial-vanishes-there |
                            coeff(monomial(c, k), succ(peano.add(k, t))) = zeroF
                            [using specialize monomialCoeffElsewhere(c, k, succ(peano.add(k, t))) the-next-index-differs-from-k]
                          @the-new-term-is-zero |
                            mulF(zeroF, coeff(g, subN(i, succ(peano.add(k, t))))) = zeroF
                            [using specialize field.mulZeroLeft(coeff(g, subN(i, succ(peano.add(k, t)))))]
                          @the-sum-gains-zero |
                            convolution(monomial(c, k), g, i, succ(peano.add(k, t))) =
                              addF(convolution(monomial(c, k), g, i, k), zeroF)
                            [using simplify one-more-term the-monomial-vanishes-there the-new-term-is-zero inductive-hypothesis]
                          @adding-zero-changes-nothing |
                            addF(convolution(monomial(c, k), g, i, k), zeroF) =
                              convolution(monomial(c, k), g, i, k)
                            [using specialize field.addZeroRight(convolution(monomial(c, k), g, i, k))]
                          @the-value-at-the-next-index |
                            convolution(monomial(c, k), g, i, succ(peano.add(k, t))) =
                              convolution(monomial(c, k), g, i, k)
                            [using chain the-sum-gains-zero adding-zero-changes-nothing]
                          @conclusion-successor |
                            convolution(monomial(c, k), g, i, peano.add(k, succ(t))) =
                              convolution(monomial(c, k), g, i, k)
                            [by rewrite the-next-limit the-value-at-the-next-index]
                        }
                      @induction-step-at-t |
                        (convolution(monomial(c, k), g, i, peano.add(k, t)) =
                          convolution(monomial(c, k), g, i, k)) ->
                          (convolution(monomial(c, k), g, i, peano.add(k, succ(t))) =
                          convolution(monomial(c, k), g, i, k))
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-for-all-t |
                    forall t: Nat;
                      (convolution(monomial(c, k), g, i, peano.add(k, t)) =
                      convolution(monomial(c, k), g, i, k)) ->
                      (convolution(monomial(c, k), g, i, peano.add(k, succ(t))) =
                      convolution(monomial(c, k), g, i, k))
                    [by generalize induction-step]
                  @conclusion-for-all-t |
                    forall t: Nat;
                      convolution(monomial(c, k), g, i, peano.add(k, t)) =
                      convolution(monomial(c, k), g, i, k)
                    [using instantiation peano.induction((fun t: Nat => convolution(monomial(c, k), g, i, peano.add(k, t)) = convolution(monomial(c, k), g, i, k))) base-case induction-step-for-all-t]
                }
              @discharge-i |
                forall i: Nat; forall t: Nat;
                  convolution(monomial(c, k), g, i, peano.add(k, t)) =
                  convolution(monomial(c, k), g, i, k)
                [by generalize generalize-i]
            }
          @discharge-k |
            forall k: Nat; forall i, t: Nat;
              convolution(monomial(c, k), g, i, peano.add(k, t)) =
              convolution(monomial(c, k), g, i, k)
            [by generalize generalize-k]
        }
      @discharge-c |
        forall c: F; forall k, i, t: Nat;
          convolution(monomial(c, k), g, i, peano.add(k, t)) =
          convolution(monomial(c, k), g, i, k)
        [by generalize generalize-c]
    }
  @conclusion |
    forall g: Poly; forall c: F; forall k, i, t: Nat;
      convolution(monomial(c, k), g, i, peano.add(k, t)) =
      convolution(monomial(c, k), g, i, k)
    [by generalize generalize-g]
qed

// THE SHIFT LAW, in the general form the cancellation reads: at index k + t, the product's
// coefficient is `c * g_t`. The sum there runs to k + t, which stabilization collapses back
// to k, where phase two names the single surviving term.
theorem theMonomialShiftsEveryCoefficient: forall g: Poly; forall c: F; forall k, t: Nat;
  coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
proof
  @generalize-g |
    fix g: Poly {
      @generalize-c |
        fix c: F {
          @generalize-k |
            fix k: Nat {
              @generalize-t |
                fix t: Nat {
                  @the-coefficient-is-the-convolution |
                    coeff(mulP(monomial(c, k), g), peano.add(k, t)) =
                      convolution(monomial(c, k), g, peano.add(k, t), peano.add(k, t))
                    [using specialize mulPolyCoeff(monomial(c, k), g, peano.add(k, t))]
                  @the-sum-stabilizes |
                    convolution(monomial(c, k), g, peano.add(k, t), peano.add(k, t)) =
                      convolution(monomial(c, k), g, peano.add(k, t), k)
                    [using specialize theMonomialConvolutionStabilizesAboveItsIndex(g, c, k, peano.add(k, t), t)]
                  @the-surviving-term |
                    convolution(monomial(c, k), g, peano.add(k, t), k) =
                      mulF(c, coeff(g, subN(peano.add(k, t), k)))
                    [using specialize theMonomialConvolutionIsTheShiftedTerm(g, c, k, peano.add(k, t))]
                  // sub(k+t, k) = t: commute the sum, then subAddCancel cancels the k.
                  @the-sum-commutes |
                    peano.add(k, t) = peano.add(t, k)
                    [using specialize peano.addIsCommutative(k, t)]
                  @cancelling-the-k |
                    subN(peano.add(t, k), k) = t
                    [using specialize subtraction.subAddCancel(t, k)]
                  @the-shift-recovers-t |
                    subN(peano.add(k, t), k) = t
                    [using simplify the-sum-commutes cancelling-the-k]
                  @the-term-at-t |
                    convolution(monomial(c, k), g, peano.add(k, t), k) = mulF(c, coeff(g, t))
                    [using simplify the-surviving-term the-shift-recovers-t]
                  @conclusion-the-general-shift |
                    coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
                    [using chain the-coefficient-is-the-convolution the-sum-stabilizes the-term-at-t]
                }
              @discharge-t |
                forall t: Nat;
                  coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
                [by generalize generalize-t]
            }
          @discharge-k |
            forall k: Nat; forall t: Nat;
              coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
            [by generalize generalize-k]
        }
      @discharge-c |
        forall c: F; forall k, t: Nat;
          coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
        [by generalize generalize-c]
    }
  @conclusion |
    forall g: Poly; forall c: F; forall k, t: Nat;
      coeff(mulP(monomial(c, k), g), peano.add(k, t)) = mulF(c, coeff(g, t))
    [by generalize generalize-g]
qed

// THE SHIFT LAW at the index that matters: the k-th coefficient of `monomial(c,k) * g` is
// `c * g_0`, which is the leading coefficient Judson's cancellation needs.
theorem theMonomialShiftsTheCoefficients: forall g: Poly; forall c: F; forall k: Nat;
  coeff(mulP(monomial(c, k), g), k) = mulF(c, coeff(g, ZERO))
proof
  @generalize-g |
    fix g: Poly {
      @generalize-c |
        fix c: F {
          @generalize-k |
            fix k: Nat {
              @the-coefficient-is-the-convolution |
                coeff(mulP(monomial(c, k), g), k) = convolution(monomial(c, k), g, k, k)
                [using specialize mulPolyCoeff(monomial(c, k), g, k)]
              @the-convolution-is-the-shifted-term |
                convolution(monomial(c, k), g, k, k) = mulF(c, coeff(g, subN(k, k)))
                [using specialize theMonomialConvolutionIsTheShiftedTerm(g, c, k, k)]
              @the-shift-vanishes |
                subN(k, k) = ZERO
                [using specialize subtraction.subSelf(k)]
              @the-shifted-term-at-zero |
                convolution(monomial(c, k), g, k, k) = mulF(c, coeff(g, ZERO))
                [using simplify the-convolution-is-the-shifted-term the-shift-vanishes]
              @conclusion-the-shift |
                coeff(mulP(monomial(c, k), g), k) = mulF(c, coeff(g, ZERO))
                [using chain the-coefficient-is-the-convolution the-shifted-term-at-zero]
            }
          @discharge-k |
            forall k: Nat; coeff(mulP(monomial(c, k), g), k) = mulF(c, coeff(g, ZERO))
            [by generalize generalize-k]
        }
      @discharge-c |
        forall c: F; forall k: Nat;
          coeff(mulP(monomial(c, k), g), k) = mulF(c, coeff(g, ZERO))
        [by generalize generalize-c]
    }
  @conclusion |
    forall g: Poly; forall c: F; forall k: Nat;
      coeff(mulP(monomial(c, k), g), k) = mulF(c, coeff(g, ZERO))
    [by generalize generalize-g]
qed

// -- THE LEADING-TERM CANCELLATION --------------------------------------------------------
//
// This is where `recip` finally earns its place, and it is the crux of Judson's induction.
// He subtracts `(a_n / b_m) x^{n-m} g(x)` from `f(x)`, and the point of that coefficient is
// that the two leading terms become EQUAL, so the difference vanishes at index n.
//
// Concretely, with `c = a_n * recip(b_m)` and `k = n - m`, the shift law gives the
// subtrahend's coefficient at `k + m = n` as `c * b_m`, and
//
//     c * b_m = (a_n * recip(b_m)) * b_m = a_n * (recip(b_m) * b_m) = a_n * 1 = a_n
//
// so `coeff(f, n) - coeff(subtrahend, n) = a_n - a_n = 0`. The index arithmetic (`k + m = n`
// when `m <= n`) is what the hypothesis buys.

// The chosen coefficient reproduces the leading coefficient: `(a_n * recip(b_m)) * b_m = a_n`.
theorem theChosenCoefficientReproducesTheLeadingOne: forall leading, divisor_leading: F;
  (not (divisor_leading = zeroF)) ->
  mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) = leading
proof
  @generalize-leading |
    fix leading: F {
      @generalize-divisor |
        fix divisor_leading: F {
          @given-the-divisor-is-nonzero |
            assume not (divisor_leading = zeroF) {
              @the-divisor-is-nonzero |
                divisor_leading != zeroF
                [by hypothesis given-the-divisor-is-nonzero]
              @regroup |
                mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) =
                  mulF(leading, mulF(recipF(divisor_leading), divisor_leading))
                [using specialize field.mulIsAssociative(leading, recipF(divisor_leading), divisor_leading)]
              @the-reciprocal-cancels |
                mulF(recipF(divisor_leading), divisor_leading) = oneF
                [using specialize field.recipMulLeft(divisor_leading) the-divisor-is-nonzero]
              @times-one |
                mulF(leading, oneF) = leading
                [using specialize field.mulOneRight(leading)]
              @regrouped-to-one |
                mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) =
                  mulF(leading, oneF)
                [using simplify regroup the-reciprocal-cancels]
              @conclusion-reproduces |
                mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) = leading
                [using chain regrouped-to-one times-one]
            }
          @nonzero-implies-reproduction |
            (not (divisor_leading = zeroF)) ->
              mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) = leading
            [by discharge given-the-divisor-is-nonzero]
        }
      @discharge-divisor |
        forall divisor_leading: F;
          (not (divisor_leading = zeroF)) ->
          mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) = leading
        [by generalize generalize-divisor]
    }
  @conclusion |
    forall leading, divisor_leading: F;
      (not (divisor_leading = zeroF)) ->
      mulF(mulF(leading, recipF(divisor_leading)), divisor_leading) = leading
    [by generalize generalize-leading]
qed

// THE CANCELLATION: at index k + m, the difference's coefficient is ZERO.
//
// `f` and `g` are arbitrary; what matters is that `g`'s m-th coefficient is nonzero (it is
// `g`'s leading one) and that `f`'s coefficient at `k + m` is the `leading` being cancelled.
theorem theLeadingTermsCancel: forall f, g: Poly; forall k, m: Nat;
  (not (coeff(g, m) = zeroF)) ->
  coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)),
  peano.add(k, m)) = zeroF
proof
  @generalize-f |
    fix f: Poly {
      @generalize-g |
        fix g: Poly {
          @generalize-k |
            fix k: Nat {
              @generalize-m |
                fix m: Nat {
                  @given-the-divisor-leads |
                    assume not (coeff(g, m) = zeroF) {
                      @the-divisor-leads |
                        coeff(g, m) != zeroF
                        [by hypothesis given-the-divisor-leads]

                      // the difference's coefficient, by subPolyCoeff
                      @the-difference-coefficient |
                        coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) =
                          addF(coeff(f, peano.add(k, m)),
                          negF(coeff(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), peano.add(k, m))))
                        [using specialize subPolyCoeff(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), peano.add(k, m))]

                      // the subtrahend's coefficient at k + m, by the shift law
                      @the-subtrahend-coefficient |
                        coeff(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), peano.add(k, m)) =
                          mulF(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), coeff(g, m))
                        [using specialize theMonomialShiftsEveryCoefficient(g, mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k, m)]

                      // and that product IS the leading coefficient
                      @the-coefficient-reproduces-the-leading-one |
                        mulF(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), coeff(g, m)) =
                          coeff(f, peano.add(k, m))
                        [using specialize theChosenCoefficientReproducesTheLeadingOne(coeff(f, peano.add(k, m)), coeff(g, m)) the-divisor-leads]
                      @the-subtrahend-is-the-leading-coefficient |
                        coeff(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), peano.add(k, m)) =
                          coeff(f, peano.add(k, m))
                        [using chain the-subtrahend-coefficient the-coefficient-reproduces-the-leading-one]

                      // so the difference is a_n + (-a_n) = 0
                      @the-difference-is-a-cancelling-pair |
                        coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) =
                          addF(coeff(f, peano.add(k, m)), negF(coeff(f, peano.add(k, m))))
                        [using simplify the-difference-coefficient the-subtrahend-is-the-leading-coefficient]
                      @the-pair-cancels |
                        addF(coeff(f, peano.add(k, m)), negF(coeff(f, peano.add(k, m)))) = zeroF
                        [using specialize field.addNegRight(coeff(f, peano.add(k, m)))]
                      @conclusion-the-cancellation |
                        coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
                        [using chain the-difference-is-a-cancelling-pair the-pair-cancels]
                    }
                  @leading-implies-cancellation |
                    (not (coeff(g, m) = zeroF)) ->
                      coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
                    [by discharge given-the-divisor-leads]
                }
              @discharge-m |
                forall m: Nat;
                  (not (coeff(g, m) = zeroF)) ->
                  coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
                [by generalize generalize-m]
            }
          @discharge-k |
            forall k: Nat; forall m: Nat;
              (not (coeff(g, m) = zeroF)) ->
              coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
            [by generalize generalize-k]
        }
      @discharge-g |
        forall g: Poly; forall k, m: Nat;
          (not (coeff(g, m) = zeroF)) ->
          coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: Poly; forall k, m: Nat;
      (not (coeff(g, m) = zeroF)) ->
      coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
    [by generalize generalize-f]
qed

// -- THE DEGREE DROP ----------------------------------------------------------------------
//
// `theLeadingTermsCancel` kills ONE coefficient. Judson needs the stronger statement that
// `f'(x) = f(x) - (a_n/b_m) x^{n-m} g(x)` "has degree less than n or is the zero polynomial",
// which is what makes his induction descend.
//
// The degree is carried as `succ(d)` rather than as `n` with an `n - 1` elsewhere: the
// conclusion is a bound at `d`, and writing it this way keeps truncated subtraction out of
// the statement entirely.
//
// Two inputs: the cancellation at the top index, and that BOTH `f` and the subtrahend are
// bounded by that index, so nothing above it survives on either side.
theorem theDifferenceDropsADegree: forall f, h: Poly; forall d: Nat;
  coeff(subP(f, h), succ(d)) = zeroF ->
  degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
  degreeAtMost(subP(f, h), d)
proof
  @generalize-f |
    fix f: Poly {
      @generalize-h |
        fix h: Poly {
          @generalize-d |
            fix d: Nat {
              @given-the-top-cancels |
                assume coeff(subP(f, h), succ(d)) = zeroF {
                  @given-f-is-bounded |
                    assume degreeAtMost(f, succ(d)) {
                      @given-h-is-bounded |
                        assume degreeAtMost(h, succ(d)) {
                          @the-top-cancels |
                            coeff(subP(f, h), succ(d)) = zeroF
                            [by hypothesis given-the-top-cancels]
                          @f-is-bounded |
                            degreeAtMost(f, succ(d))
                            [by hypothesis given-f-is-bounded]
                          @h-is-bounded |
                            degreeAtMost(h, succ(d))
                            [by hypothesis given-h-is-bounded]

                          // unfold both bounds into their coefficient statements
                          @what-f-bounding-means |
                            degreeAtMost(f, succ(d)) iff
                              (forall i: Nat; less_than(succ(d), i) -> coeff(f, i) = zeroF)
                            [using specialize degreeAtMostMeaning(f, succ(d))]
                          @f-vanishes-above |
                            forall i: Nat; less_than(succ(d), i) -> coeff(f, i) = zeroF
                            [using tautology f-is-bounded what-f-bounding-means]
                          @what-h-bounding-means |
                            degreeAtMost(h, succ(d)) iff
                              (forall i: Nat; less_than(succ(d), i) -> coeff(h, i) = zeroF)
                            [using specialize degreeAtMostMeaning(h, succ(d))]
                          @h-vanishes-above |
                            forall i: Nat; less_than(succ(d), i) -> coeff(h, i) = zeroF
                            [using tautology h-is-bounded what-h-bounding-means]

                          // every index strictly above d is either succ(d) itself — where the
                          // cancellation applies — or strictly above succ(d), where both
                          // polynomials already vanish.
                          @generalize-index |
                            fix i: Nat {
                              @given-the-index-is-above-d |
                                assume less_than(d, i) {
                                  @the-index-is-above-d |
                                    less_than(d, i)
                                    [by hypothesis given-the-index-is-above-d]
                                  // d < i gives succ(d) < succ(i), hence succ(d) <= i.
                                  @the-successors-compare |
                                    less_than(succ(d), succ(i))
                                    [using specialize peano_order.succPreservesOrder(d, i) the-index-is-above-d]
                                  @the-successor-is-bounded-by-the-index |
                                    peano_order.less_or_equal(succ(d), i)
                                    [using specialize peano_order.lessThanSuccToLessOrEqual(succ(d), i) the-successors-compare]
                                  @the-index-splits |
                                    less_than(succ(d), i) or succ(d) = i
                                    [using specialize peano_order.lessOrEqualSplit(succ(d), i) the-successor-is-bounded-by-the-index]

                                  @when-the-index-is-the-successor |
                                    assume succ(d) = i {
                                      @the-index-is-the-successor |
                                        succ(d) = i
                                        [by hypothesis when-the-index-is-the-successor]
                                      @the-difference-vanishes-at-the-successor |
                                        coeff(subP(f, h), i) = zeroF
                                        [by rewrite the-index-is-the-successor the-top-cancels]
                                    }

                                  @when-the-index-is-higher |
                                    assume less_than(succ(d), i) {
                                      @the-index-is-higher |
                                        less_than(succ(d), i)
                                        [by hypothesis when-the-index-is-higher]
                                      @f-vanishes-here |
                                        coeff(f, i) = zeroF
                                        [using specialize f-vanishes-above(i) the-index-is-higher]
                                      @h-vanishes-here |
                                        coeff(h, i) = zeroF
                                        [using specialize h-vanishes-above(i) the-index-is-higher]
                                      @the-difference-here |
                                        coeff(subP(f, h), i) = addF(coeff(f, i), negF(coeff(h, i)))
                                        [using specialize subPolyCoeff(f, h, i)]
                                      @the-difference-of-zeros |
                                        coeff(subP(f, h), i) = addF(zeroF, negF(zeroF))
                                        [using simplify the-difference-here f-vanishes-here h-vanishes-here]
                                      @negating-zero |
                                        negF(zeroF) = zeroF
                                        [by cite field.negZero]
                                      @zero-plus-zero |
                                        addF(zeroF, zeroF) = zeroF
                                        [using specialize addZeroLeftF(zeroF)]
                                      @the-difference-vanishes-higher-up |
                                        coeff(subP(f, h), i) = zeroF
                                        [using simplify the-difference-of-zeros negating-zero zero-plus-zero]
                                    }

                                  @the-difference-vanishes-either-way |
                                    coeff(subP(f, h), i) = zeroF
                                    [by common_conclusion the-index-splits when-the-index-is-higher when-the-index-is-the-successor]
                                }
                              @above-d-implies-vanishing |
                                less_than(d, i) -> coeff(subP(f, h), i) = zeroF
                                [by discharge given-the-index-is-above-d]
                            }
                          @the-difference-vanishes-above-d |
                            forall i: Nat; less_than(d, i) -> coeff(subP(f, h), i) = zeroF
                            [by generalize generalize-index]
                          @what-the-conclusion-means |
                            degreeAtMost(subP(f, h), d) iff
                              (forall i: Nat; less_than(d, i) -> coeff(subP(f, h), i) = zeroF)
                            [using specialize degreeAtMostMeaning(subP(f, h), d)]
                          @conclusion-the-degree-drops |
                            degreeAtMost(subP(f, h), d)
                            [using tautology the-difference-vanishes-above-d what-the-conclusion-means]
                        }
                      @h-bounded-implies-the-drop |
                        degreeAtMost(h, succ(d)) -> degreeAtMost(subP(f, h), d)
                        [by discharge given-h-is-bounded]
                    }
                  @both-bounded-imply-the-drop |
                    degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
                      degreeAtMost(subP(f, h), d)
                    [by discharge given-f-is-bounded]
                }
              @cancellation-implies-the-drop |
                coeff(subP(f, h), succ(d)) = zeroF ->
                  degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
                  degreeAtMost(subP(f, h), d)
                [by discharge given-the-top-cancels]
            }
          @discharge-d |
            forall d: Nat;
              coeff(subP(f, h), succ(d)) = zeroF ->
              degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
              degreeAtMost(subP(f, h), d)
            [by generalize generalize-d]
        }
      @discharge-h |
        forall h: Poly; forall d: Nat;
          coeff(subP(f, h), succ(d)) = zeroF ->
          degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
          degreeAtMost(subP(f, h), d)
        [by generalize generalize-h]
    }
  @conclusion |
    forall f, h: Poly; forall d: Nat;
      coeff(subP(f, h), succ(d)) = zeroF ->
      degreeAtMost(f, succ(d)) -> degreeAtMost(h, succ(d)) ->
      degreeAtMost(subP(f, h), d)
    [by generalize generalize-f]
qed

// -- THE DROP AT JUDSON'S OWN SUBTRAHEND --------------------------------------------------
//
// `theDifferenceDropsADegree` takes three hypotheses. Here they are discharged at the actual
// construction, so the result is the step his induction uses: subtracting
// `(a_n/b_m) x^{n-m} g(x)` from an `f` of degree `succ(d)` leaves something of degree at
// most `d`.
//
// The hypotheses go as follows. The cancellation is `theLeadingTermsCancel` at `k + m =
// succ(d)`. The bound on `f` is `degreeBoundsTheCoefficients` rewritten through
// `degree(f) = succ(d)`. The bound on the subtrahend is `degreeOfAProduct` plus the
// monomial's own degree: `deg(monomial(c,k) * g) = k + m`, which the hypothesis says is
// `succ(d)`.
theorem theConstructionDropsADegree: forall f, g: Poly; forall k, m, d: Nat;
  (not (f = ZEROP)) -> (not (g = ZEROP)) ->
  (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
  (not (coeff(g, m) = zeroF)) ->
  (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
  degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
  degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
proof
  @generalize-f |
    fix f: Poly {
      @generalize-g |
        fix g: Poly {
          @generalize-k |
            fix k: Nat {
              @generalize-m |
                fix m: Nat {
                  @generalize-d |
                    fix d: Nat {
                      @given-f-nonzero |
                        assume not (f = ZEROP) {
                          @given-g-nonzero |
                            assume not (g = ZEROP) {
                              @given-the-monomial-nonzero |
                                assume not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP) {
                                  @given-the-divisor-leads |
                                    assume not (coeff(g, m) = zeroF) {
                                      @given-the-coefficient-nonzero |
                                        assume not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF) {
                                          @given-g-has-degree-m |
                                            assume degree(g) = m {
                                              @given-f-has-the-top-degree |
                                                assume degree(f) = peano.add(k, m) {
                                                  @given-the-top-is-a-successor |
                                                    assume peano.add(k, m) = succ(d) {
                                                      @f-nonzero |
                                                        not (f = ZEROP)
                                                        [by hypothesis given-f-nonzero]
                                                      @g-nonzero |
                                                        not (g = ZEROP)
                                                        [by hypothesis given-g-nonzero]
                                                      @the-monomial-nonzero |
                                                        not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)
                                                        [by hypothesis given-the-monomial-nonzero]
                                                      @the-divisor-leads |
                                                        coeff(g, m) != zeroF
                                                        [by hypothesis given-the-divisor-leads]
                                                      @the-coefficient-nonzero |
                                                        mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) != zeroF
                                                        [by hypothesis given-the-coefficient-nonzero]
                                                      @g-has-degree-m |
                                                        degree(g) = m
                                                        [by hypothesis given-g-has-degree-m]
                                                      @f-has-the-top-degree |
                                                        degree(f) = peano.add(k, m)
                                                        [by hypothesis given-f-has-the-top-degree]
                                                      @the-top-is-a-successor |
                                                        peano.add(k, m) = succ(d)
                                                        [by hypothesis given-the-top-is-a-successor]

                                                      // HYPOTHESIS 1: the cancellation.
                                                      @the-top-coefficient-cancels |
                                                        coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), peano.add(k, m)) = zeroF
                                                        [using specialize theLeadingTermsCancel(f, g, k, m) the-divisor-leads]
                                                      @the-cancellation-at-the-successor |
                                                        coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), succ(d)) = zeroF
                                                        [by rewrite the-top-is-a-successor the-top-coefficient-cancels]

                                                      // HYPOTHESIS 2: f is bounded by its own degree, which is succ(d).
                                                      @f-is-bounded-by-its-degree |
                                                        degreeAtMost(f, degree(f))
                                                        [using specialize degreeBoundsTheCoefficients(f) f-nonzero]
                                                      @f-degree-is-the-successor |
                                                        degree(f) = succ(d)
                                                        [using chain f-has-the-top-degree the-top-is-a-successor]
                                                      @f-is-bounded |
                                                        degreeAtMost(f, succ(d))
                                                        [by rewrite f-degree-is-the-successor f-is-bounded-by-its-degree]

                                                      // HYPOTHESIS 3: the subtrahend's degree is k + m = succ(d).
                                                      @the-monomial-has-degree-k |
                                                        degree(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k)) = k
                                                        [using specialize aNonzeroMonomialHasItsIndexAsDegree(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) the-coefficient-nonzero the-monomial-nonzero]
                                                      @the-product-degree |
                                                        degree(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)) =
                                                          peano.add(degree(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k)), degree(g))
                                                        [using specialize degreeOfAProduct(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g) the-monomial-nonzero g-nonzero]
                                                      @the-product-degree-in-k-and-m |
                                                        degree(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)) = peano.add(k, m)
                                                        [using simplify the-product-degree the-monomial-has-degree-k g-has-degree-m]
                                                      @the-subtrahend-degree-is-the-successor |
                                                        degree(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)) = succ(d)
                                                        [using chain the-product-degree-in-k-and-m the-top-is-a-successor]
                                                      @the-subtrahend-nonzero |
                                                        not (mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g) = ZEROP)
                                                        [using specialize aProductOfNonzerosIsNonzero(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g) the-monomial-nonzero g-nonzero]
                                                      @the-subtrahend-is-bounded-by-its-degree |
                                                        degreeAtMost(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), degree(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)))
                                                        [using specialize degreeBoundsTheCoefficients(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)) the-subtrahend-nonzero]
                                                      @the-subtrahend-is-bounded |
                                                        degreeAtMost(mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), succ(d))
                                                        [by rewrite the-subtrahend-degree-is-the-successor the-subtrahend-is-bounded-by-its-degree]

                                                      @conclusion-the-construction-drops |
                                                        degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                                        [using specialize theDifferenceDropsADegree(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g), d) the-cancellation-at-the-successor f-is-bounded the-subtrahend-is-bounded]
                                                    }
                                                  @successor-implies-the-drop |
                                                    peano.add(k, m) = succ(d) ->
                                                      degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                                    [by discharge given-the-top-is-a-successor]
                                                }
                                              @f-degree-implies-the-drop |
                                                degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                                  degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                                [by discharge given-f-has-the-top-degree]
                                            }
                                          @g-degree-implies-the-drop |
                                            degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                              degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                            [by discharge given-g-has-degree-m]
                                        }
                                      @coefficient-implies-the-drop |
                                        (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                                          degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                          degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                        [by discharge given-the-coefficient-nonzero]
                                    }
                                  @leading-implies-the-drop |
                                    (not (coeff(g, m) = zeroF)) ->
                                      (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                                      degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                      degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                    [by discharge given-the-divisor-leads]
                                }
                              @monomial-implies-the-drop |
                                (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
                                  (not (coeff(g, m) = zeroF)) ->
                                  (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                                  degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                  degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                [by discharge given-the-monomial-nonzero]
                            }
                          @g-nonzero-implies-the-drop |
                            (not (g = ZEROP)) ->
                              (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
                              (not (coeff(g, m) = zeroF)) ->
                              (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                              degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                              degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                            [by discharge given-g-nonzero]
                        }
                      @the-drop |
                        (not (f = ZEROP)) -> (not (g = ZEROP)) ->
                          (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
                          (not (coeff(g, m) = zeroF)) ->
                          (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                          degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                          degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                        [by discharge given-f-nonzero]
                    }
                  @discharge-d |
                    forall d: Nat;
                      (not (f = ZEROP)) -> (not (g = ZEROP)) ->
                      (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
                      (not (coeff(g, m) = zeroF)) ->
                      (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                      degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                      degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                    [by generalize generalize-d]
                }
              @discharge-m |
                forall m, d: Nat;
                  (not (f = ZEROP)) -> (not (g = ZEROP)) ->
                  (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
                  (not (coeff(g, m) = zeroF)) ->
                  (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
                  degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                  degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                [by generalize generalize-m]
            }
          @discharge-k |
            forall k, m, d: Nat;
              (not (f = ZEROP)) -> (not (g = ZEROP)) ->
              (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
              (not (coeff(g, m) = zeroF)) ->
              (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
              degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
              degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
            [by generalize generalize-k]
        }
      @discharge-g |
        forall g: Poly; forall k, m, d: Nat;
          (not (f = ZEROP)) -> (not (g = ZEROP)) ->
          (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
          (not (coeff(g, m) = zeroF)) ->
          (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
          degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
          degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: Poly; forall k, m, d: Nat;
      (not (f = ZEROP)) -> (not (g = ZEROP)) ->
      (not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)) ->
      (not (coeff(g, m) = zeroF)) ->
      (not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)) ->
      degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
      degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
    [by generalize generalize-f]
qed

// == F[x] MODELS R[x]: INHERITING THE RING LAWS ===========================================
//
// §17.1 proved that a polynomial ring over a COMMUTATIVE RING WITH IDENTITY is itself a
// commutative ring — the abelian group, the identity, distributivity, and (through the
// reindexing lemma) multiplicative commutativity. A field IS a commutative ring with
// identity, so all of that holds of `F[x]` too, and re-proving it here would duplicate
// roughly 200 lines of settled argument.
//
// 2b4m has no sort subsumption, so `Field` is not a `Ring` and this is not automatic. The
// mechanism is a MODEL: map `R[x]`'s vocabulary onto ours and discharge the axioms its
// proofs rest on, and its theorems transfer. (`std/field.b4m`'s `RingIsField` does exactly
// this one level down, for the coefficients.)
//
// Three layers have to be mapped, which is the part that is easy to get wrong: the
// COEFFICIENT layer (R[x]'s theorems are stated in terms of R's operations), the INDEX layer
// (both files index by ℕ, but the model must say so), and the POLYNOMIAL layer itself —
// including the two summation helpers, because a transfer re-checks the source PROOF and
// `polyMulIsCommutative` goes through them.
model FieldPolyModelsRingPoly {
  // the coefficient ring: a field, viewed as the commutative ring §17.1 assumed
  ring_poly.R: F
  ring_poly.zeroR: zeroF
  ring_poly.oneR: oneF
  ring_poly.addR: addF
  ring_poly.mulR: mulF
  ring_poly.negR: negF
  ring_poly.addIsAssociativeR <- addIsAssociativeF
  ring_poly.addIsCommutativeR <- addIsCommutativeF
  ring_poly.addZeroLeftR <- addZeroLeftF
  ring_poly.addNegLeftR <- addNegLeftF
  ring_poly.mulIsCommutativeR <- mulIsCommutativeF
  ring_poly.mulOneLeftR <- mulOneLeftF
  ring_poly.mulAddDistribLeftR <- mulAddDistribLeftF
  ring_poly.mulAddDistribRightR <- mulAddDistribRightF

  // the index sort
  ring_poly.Nat: Nat
  ring_poly.ZERO: ZERO
  ring_poly.succ: succ
  ring_poly.addN: peano.add

  // the polynomial carrier and its operations
  ring_poly.Poly: Poly
  ring_poly.coeff: coeff
  ring_poly.ZEROP: ZEROP
  ring_poly.addP: addP
  ring_poly.negP: negP
  ring_poly.mulP: mulP
  ring_poly.convolution: convolution
  ring_poly.tailConvolution: tailConvolution
  ring_poly.segment: segment
  ring_poly.zeroPolyCoeff <- zeroPolyCoeff
  ring_poly.polyExtensionality <- polyExtensionality
  ring_poly.addPolyCoeff <- addPolyCoeff
  ring_poly.negPolyCoeff <- negPolyCoeff
  ring_poly.mulPolyCoeff <- mulPolyCoeff
  ring_poly.convolutionZero <- convolutionZero
  ring_poly.convolutionSucc <- convolutionSucc
  ring_poly.tailConvolutionZero <- tailConvolutionZero
  ring_poly.tailConvolutionSucc <- tailConvolutionSucc
  ring_poly.segmentZero <- segmentZero
  ring_poly.segmentSucc <- segmentSucc
}

// The four laws the division algorithm's assembly step needs, transferred.

theorem polyAddIsAssociative: forall p, q, r: Poly;
  addP(addP(p, q), r) = addP(p, addP(q, r))
proof
  @conclusion |
    forall p, q, r: Poly; addP(addP(p, q), r) = addP(p, addP(q, r))
    [using model(FieldPolyModelsRingPoly) ring_poly.polyAddIsAssociative]
qed

theorem polyAddIsCommutative: forall p, q: Poly; addP(p, q) = addP(q, p)
proof
  @conclusion |
    forall p, q: Poly; addP(p, q) = addP(q, p)
    [using model(FieldPolyModelsRingPoly) ring_poly.polyAddIsCommutative]
qed

theorem polyAddZeroLeft: forall p: Poly; addP(ZEROP, p) = p
proof
  @conclusion |
    forall p: Poly; addP(ZEROP, p) = p
    [using model(FieldPolyModelsRingPoly) ring_poly.polyAddZeroLeft]
qed

theorem polyAddNegLeft: forall p: Poly; addP(negP(p), p) = ZEROP
proof
  @conclusion |
    forall p: Poly; addP(negP(p), p) = ZEROP
    [using model(FieldPolyModelsRingPoly) ring_poly.polyAddNegLeft]
qed

theorem polyMulAddDistribLeft: forall p, q, r: Poly;
  mulP(p, addP(q, r)) = addP(mulP(p, q), mulP(p, r))
proof
  @conclusion |
    forall p, q, r: Poly; mulP(p, addP(q, r)) = addP(mulP(p, q), mulP(p, r))
    [using model(FieldPolyModelsRingPoly) ring_poly.polyMulAddDistribLeft]
qed

// The reindexing lemma's payoff, inherited: F[x] is commutative.
theorem polyMulIsCommutative: forall p, q: Poly; mulP(p, q) = mulP(q, p)
proof
  @conclusion |
    forall p, q: Poly; mulP(p, q) = mulP(q, p)
    [using model(FieldPolyModelsRingPoly) ring_poly.polyMulIsCommutative]
qed

// The right-handed zero law, from the left one and commutativity. (Neither §17.1 nor this
// file needed it before; the recovery lemma below does.)
theorem polyAddZeroRight: forall p: Poly; addP(p, ZEROP) = p
proof
  @generalize-p |
    fix p: Poly {
      @the-sum-commutes |
        addP(p, ZEROP) = addP(ZEROP, p)
        [using specialize polyAddIsCommutative(p, ZEROP)]
      @zero-on-the-left |
        addP(ZEROP, p) = p
        [using specialize polyAddZeroLeft(p)]
      @conclusion-zero-on-the-right |
        addP(p, ZEROP) = p
        [using chain the-sum-commutes zero-on-the-left]
    }
  @conclusion |
    forall p: Poly; addP(p, ZEROP) = p
    [by generalize generalize-p]
qed

// The additive left-swap, which `assoc_commut`'s explicit triple requires (it takes the
// whole assoc/comm/swap triple or none).
theorem polyAddLeftSwap: forall p, q, r: Poly;
  addP(p, addP(q, r)) = addP(q, addP(p, r))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @regroup-forward |
                addP(addP(p, q), r) = addP(p, addP(q, r))
                [using specialize polyAddIsAssociative(p, q, r)]
              @regrouped |
                addP(p, addP(q, r)) = addP(addP(p, q), r)
                [by symmetry regroup-forward]
              @swap-the-leading-pair |
                addP(p, q) = addP(q, p)
                [using specialize polyAddIsCommutative(p, q)]
              @regrouped-and-swapped |
                addP(p, addP(q, r)) = addP(addP(q, p), r)
                [using simplify regrouped swap-the-leading-pair]
              @regroup-back |
                addP(addP(q, p), r) = addP(q, addP(p, r))
                [using specialize polyAddIsAssociative(q, p, r)]
              @conclusion-the-swap |
                addP(p, addP(q, r)) = addP(q, addP(p, r))
                [using chain regrouped-and-swapped regroup-back]
            }
          @discharge-r |
            forall r: Poly; addP(p, addP(q, r)) = addP(q, addP(p, r))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; addP(p, addP(q, r)) = addP(q, addP(p, r))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; addP(p, addP(q, r)) = addP(q, addP(p, r))
    [by generalize generalize-p]
qed

// -- recovering a polynomial from its difference ------------------------------------------
//
// `subP(f, h) = u` gives `f = u + h`. Judson uses this silently when he rearranges
// `f' = f - c x^k g` into `f = f' + c x^k g`; with the ring laws inherited above it is four
// steps of additive algebra.
theorem aDifferenceRecoversItsMinuend: forall f, h, u: Poly;
  subP(f, h) = u -> f = addP(u, h)
proof
  @generalize-f |
    fix f: Poly {
      @generalize-h |
        fix h: Poly {
          @generalize-u |
            fix u: Poly {
              @given-the-difference |
                assume subP(f, h) = u {
                  @the-difference |
                    subP(f, h) = u
                    [by hypothesis given-the-difference]
                  // (f + (-h)) + h = f + ((-h) + h) = f + 0 = f
                  @regroup |
                    addP(addP(f, negP(h)), h) = addP(f, addP(negP(h), h))
                    [using specialize polyAddIsAssociative(f, negP(h), h)]
                  @the-inverse-cancels |
                    addP(negP(h), h) = ZEROP
                    [using specialize polyAddNegLeft(h)]
                  @adding-zero |
                    addP(f, ZEROP) = f
                    [using specialize polyAddZeroRight(f)]
                  @the-sum-is-f |
                    addP(addP(f, negP(h)), h) = f
                    [using simplify regroup the-inverse-cancels adding-zero]
                  // `subP(f,h)` IS `addP(f, negP(h))`, so the step above already reads
                  // `addP(subP(f,h), h) = f`; the hypothesis rewrites its inner term to `u`.
                  @u-plus-h-is-f |
                    addP(u, h) = f
                    [by rewrite the-difference the-sum-is-f]
                  @conclusion-recovered |
                    f = addP(u, h)
                    [by symmetry u-plus-h-is-f]
                }
              @the-difference-implies-recovery |
                subP(f, h) = u -> f = addP(u, h)
                [by discharge given-the-difference]
            }
          @discharge-u |
            forall u: Poly; subP(f, h) = u -> f = addP(u, h)
            [by generalize generalize-u]
        }
      @discharge-h |
        forall h, u: Poly; subP(f, h) = u -> f = addP(u, h)
        [by generalize generalize-h]
    }
  @conclusion |
    forall f, h, u: Poly; subP(f, h) = u -> f = addP(u, h)
    [by generalize generalize-f]
qed

// -- THE ASSEMBLY STEP --------------------------------------------------------------------
//
// Judson's "Now let q(x) = q'(x) + (a_n/b_m) x^{n-m}. Then f(x) = g(x) q(x) + r(x)." Given a
// division of the REDUCED polynomial, this extends the quotient by one term to divide the
// original. It is the inductive step of the existence half, and with the ring laws inherited
// it is pure algebra — no degrees, no coefficients, no hypotheses about `mono` at all.
//
//     f = (f - mono·g) + mono·g      recovery
//       = (g·q + r) + mono·g         the given division
//       = (g·q + g·mono) + r         AC reorder, and mono·g = g·mono
//       = g·(q + mono) + r           distributivity
theorem theQuotientExtendsByOneTerm: forall f, g, mono, quotient, remainder: Poly;
  subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) ->
  f = addP(mulP(g, addP(quotient, mono)), remainder)
proof
  @generalize-f |
    fix f: Poly {
      @generalize-g |
        fix g: Poly {
          @generalize-mono |
            fix mono: Poly {
              @generalize-quotient |
                fix quotient: Poly {
                  @generalize-remainder |
                    fix remainder: Poly {
                      @given-the-reduced-division |
                        assume subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) {
                          @the-reduced-division |
                            subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder)
                            [by hypothesis given-the-reduced-division]

                          // f = (g·q + r) + mono·g
                          @f-recovered |
                            f = addP(addP(mulP(g, quotient), remainder), mulP(mono, g))
                            [using specialize aDifferenceRecoversItsMinuend(f, mulP(mono, g), addP(mulP(g, quotient), remainder)) the-reduced-division]

                          // the subtrahend's factors commute
                          @the-term-commutes |
                            mulP(mono, g) = mulP(g, mono)
                            [using specialize polyMulIsCommutative(mono, g)]
                          @f-with-the-term-flipped |
                            f = addP(addP(mulP(g, quotient), remainder), mulP(g, mono))
                            [using simplify f-recovered the-term-commutes]

                          // (g·q + r) + g·mono = (g·q + g·mono) + r
                          @the-summands-reorder |
                            addP(addP(mulP(g, quotient), remainder), mulP(g, mono)) =
                              addP(addP(mulP(g, quotient), mulP(g, mono)), remainder)
                            [using assoc_commut(polyAddIsAssociative, polyAddIsCommutative, polyAddLeftSwap)]
                          @f-reordered |
                            f = addP(addP(mulP(g, quotient), mulP(g, mono)), remainder)
                            [using chain f-with-the-term-flipped the-summands-reorder]

                          // g·q + g·mono = g·(q + mono)
                          @the-products-factor |
                            mulP(g, addP(quotient, mono)) =
                              addP(mulP(g, quotient), mulP(g, mono))
                            [using specialize polyMulAddDistribLeft(g, quotient, mono)]
                          @the-products-factored |
                            addP(mulP(g, quotient), mulP(g, mono)) =
                              mulP(g, addP(quotient, mono))
                            [by symmetry the-products-factor]
                          @conclusion-the-quotient-extends |
                            f = addP(mulP(g, addP(quotient, mono)), remainder)
                            [using simplify f-reordered the-products-factored]
                        }
                      @the-division-extends |
                        subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) ->
                          f = addP(mulP(g, addP(quotient, mono)), remainder)
                        [by discharge given-the-reduced-division]
                    }
                  @discharge-remainder |
                    forall remainder: Poly;
                      subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) ->
                      f = addP(mulP(g, addP(quotient, mono)), remainder)
                    [by generalize generalize-remainder]
                }
              @discharge-quotient |
                forall quotient, remainder: Poly;
                  subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) ->
                  f = addP(mulP(g, addP(quotient, mono)), remainder)
                [by generalize generalize-quotient]
            }
          @discharge-mono |
            forall mono, quotient, remainder: Poly;
              subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) ->
              f = addP(mulP(g, addP(quotient, mono)), remainder)
            [by generalize generalize-mono]
        }
      @discharge-g |
        forall g, mono, quotient, remainder: Poly;
          subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) ->
          f = addP(mulP(g, addP(quotient, mono)), remainder)
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g, mono, quotient, remainder: Poly;
      subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) ->
      f = addP(mulP(g, addP(quotient, mono)), remainder)
    [by generalize generalize-f]
qed

// Multiplying by the zero polynomial gives the zero polynomial. Needed for the trivial
// division `f = g·0 + f`, which is Judson's "if m > n, then we can let q(x) = 0 and
// r(x) = f(x)". Proved coefficientwise, since the product's coefficient is a convolution
// whose every term carries a factor of `zeroF`.
theorem polyMulZeroRight: forall p: Poly; mulP(p, ZEROP) = ZEROP
proof
  @generalize-p |
    fix p: Poly {
      @generalize-index |
        fix i: Nat {
          // the convolution against ZEROP vanishes at every limit: induction on the limit.
          @base-term |
            convolution(p, ZEROP, i, ZERO) = mulF(coeff(p, ZERO), coeff(ZEROP, i))
            [using specialize convolutionZero(p, ZEROP, i)]
          @the-zero-polynomial-vanishes |
            coeff(ZEROP, i) = zeroF
            [using specialize zeroPolyCoeff(i)]
          @times-zero |
            mulF(coeff(p, ZERO), zeroF) = zeroF
            [using specialize field.mulZeroRight(coeff(p, ZERO))]
          @base-case |
            convolution(p, ZEROP, i, ZERO) = zeroF
            [using simplify base-term the-zero-polynomial-vanishes times-zero]

          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume convolution(p, ZEROP, i, k) = zeroF {
                  @inductive-hypothesis |
                    convolution(p, ZEROP, i, k) = zeroF
                    [by hypothesis given-inductive-hypothesis]
                  @one-more-term |
                    convolution(p, ZEROP, i, succ(k)) =
                      addF(convolution(p, ZEROP, i, k),
                      mulF(coeff(p, succ(k)), coeff(ZEROP, subN(i, succ(k)))))
                    [using specialize convolutionSucc(p, ZEROP, i, k)]
                  @the-zero-polynomial-vanishes-here |
                    coeff(ZEROP, subN(i, succ(k))) = zeroF
                    [using specialize zeroPolyCoeff(subN(i, succ(k)))]
                  @the-new-term-is-zero |
                    mulF(coeff(p, succ(k)), zeroF) = zeroF
                    [using specialize field.mulZeroRight(coeff(p, succ(k)))]
                  @the-sum-is-zero-plus-zero |
                    convolution(p, ZEROP, i, succ(k)) = addF(zeroF, zeroF)
                    [using simplify one-more-term the-zero-polynomial-vanishes-here the-new-term-is-zero inductive-hypothesis]
                  @zero-plus-zero |
                    addF(zeroF, zeroF) = zeroF
                    [using specialize addZeroLeftF(zeroF)]
                  @conclusion-successor |
                    convolution(p, ZEROP, i, succ(k)) = zeroF
                    [using chain the-sum-is-zero-plus-zero zero-plus-zero]
                }
              @induction-step-at-k |
                convolution(p, ZEROP, i, k) = zeroF ->
                  convolution(p, ZEROP, i, succ(k)) = zeroF
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat;
              convolution(p, ZEROP, i, k) = zeroF ->
              convolution(p, ZEROP, i, succ(k)) = zeroF
            [by generalize induction-step]
          @the-convolution-vanishes |
            forall k: Nat; convolution(p, ZEROP, i, k) = zeroF
            [using instantiation peano.induction((fun k: Nat => convolution(p, ZEROP, i, k) = zeroF)) base-case induction-step-for-all-k]
          @the-product-coefficient |
            coeff(mulP(p, ZEROP), i) = convolution(p, ZEROP, i, i)
            [using specialize mulPolyCoeff(p, ZEROP, i)]
          @the-convolution-at-i |
            convolution(p, ZEROP, i, i) = zeroF
            [using specialize the-convolution-vanishes(i)]
          @the-zero-coefficient |
            coeff(ZEROP, i) = zeroF
            [using specialize zeroPolyCoeff(i)]
          @the-zero-coefficient-flipped |
            zeroF = coeff(ZEROP, i)
            [by symmetry the-zero-coefficient]
          @coefficients-agree-at-index |
            coeff(mulP(p, ZEROP), i) = coeff(ZEROP, i)
            [using chain the-product-coefficient the-convolution-at-i the-zero-coefficient-flipped]
        }
      @corresponding-coefficients-are-equal |
        forall i: Nat; coeff(mulP(p, ZEROP), i) = coeff(ZEROP, i)
        [by generalize generalize-index]
      @conclusion-the-product-vanishes |
        mulP(p, ZEROP) = ZEROP
        [using specialize polyExtensionality(mulP(p, ZEROP), ZEROP) corresponding-coefficients-are-equal]
    }
  @conclusion |
    forall p: Poly; mulP(p, ZEROP) = ZEROP
    [by generalize generalize-p]
qed

// THE TRIVIAL DIVISION, Judson's "If m > n, then we can let q(x) = 0 and r(x) = f(x)":
// every `f` divides by `g` with quotient zero and remainder itself.
theorem theTrivialDivision: forall f, g: Poly;
  f = addP(mulP(g, ZEROP), f)
proof
  @generalize-f |
    fix f: Poly {
      @generalize-g |
        fix g: Poly {
          @the-product-vanishes |
            mulP(g, ZEROP) = ZEROP
            [using specialize polyMulZeroRight(g)]
          @zero-plus-f |
            addP(ZEROP, f) = f
            [using specialize polyAddZeroLeft(f)]
          @the-sum-is-f |
            addP(mulP(g, ZEROP), f) = f
            [using simplify the-product-vanishes zero-plus-f]
          @conclusion-the-trivial-division |
            f = addP(mulP(g, ZEROP), f)
            [by symmetry the-sum-is-f]
        }
      @discharge-g |
        forall g: Poly; f = addP(mulP(g, ZEROP), f)
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: Poly; f = addP(mulP(g, ZEROP), f)
    [by generalize generalize-f]
qed

// -- EXISTENCE: the two easy arms, as named facts ------------------------------------------
//
// The induction's step splits three ways. Two arms need no recursion at all, and isolating
// them here keeps the induction itself readable. Both produce the existential the induction
// carries, so their statements are the induction's own conclusion shape.

// ARM 1 — `f` is already small enough: quotient zero, remainder `f`. This covers both
// Judson's `m > n` case and the degenerate `f = 0`.
theorem aSmallPolynomialDividesTrivially: forall f, g: Poly;
  (f = ZEROP or less_than(degree(f), degree(g))) ->
  exists quotient: Poly; exists remainder: Poly;
  f = addP(mulP(g, quotient), remainder) and
  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
proof
  @generalize-f |
    fix f: Poly {
      @generalize-g |
        fix g: Poly {
          @given-f-is-small |
            assume f = ZEROP or less_than(degree(f), degree(g)) {
              @f-is-small |
                f = ZEROP or less_than(degree(f), degree(g))
                [by hypothesis given-f-is-small]
              @the-trivial-division |
                f = addP(mulP(g, ZEROP), f)
                [using specialize theTrivialDivision(f, g)]
              @the-division-with-its-remainder-condition |
                f = addP(mulP(g, ZEROP), f) and
                  (f = ZEROP or less_than(degree(f), degree(g)))
                [by both the-trivial-division f-is-small]
              @the-remainder-witness |
                exists remainder: Poly;
                  f = addP(mulP(g, ZEROP), remainder) and
                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                [by witness(f) the-division-with-its-remainder-condition]
              @conclusion-the-trivial-witnesses |
                exists quotient: Poly; exists remainder: Poly;
                  f = addP(mulP(g, quotient), remainder) and
                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                [by witness(ZEROP) the-remainder-witness]
            }
          @small-implies-a-division |
            (f = ZEROP or less_than(degree(f), degree(g))) ->
              exists quotient: Poly; exists remainder: Poly;
              f = addP(mulP(g, quotient), remainder) and
              (remainder = ZEROP or less_than(degree(remainder), degree(g)))
            [by discharge given-f-is-small]
        }
      @discharge-g |
        forall g: Poly;
          (f = ZEROP or less_than(degree(f), degree(g))) ->
          exists quotient: Poly; exists remainder: Poly;
          f = addP(mulP(g, quotient), remainder) and
          (remainder = ZEROP or less_than(degree(remainder), degree(g)))
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: Poly;
      (f = ZEROP or less_than(degree(f), degree(g))) ->
      exists quotient: Poly; exists remainder: Poly;
      f = addP(mulP(g, quotient), remainder) and
      (remainder = ZEROP or less_than(degree(remainder), degree(g)))
    [by generalize generalize-f]
qed

// ARM 2 — the recursive case, with the recursion's result taken as a hypothesis. Given that
// the REDUCED polynomial `f - mono·g` divides, the ORIGINAL divides, with the quotient
// extended by `mono`. This is `theQuotientExtendsByOneTerm` lifted through the existential,
// which is the shape the induction needs: the remainder is carried through unchanged, so its
// degree condition comes along for free.
theorem extendingADivisionOfTheReduction: forall f, g, mono: Poly;
  (exists quotient: Poly; exists remainder: Poly;
  subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) and
  (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
  exists quotient: Poly; exists remainder: Poly;
  f = addP(mulP(g, quotient), remainder) and
  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
proof
  @generalize-f |
    fix f: Poly {
      @generalize-g |
        fix g: Poly {
          @generalize-mono |
            fix mono: Poly {
              @given-the-reduction-divides |
                assume exists quotient: Poly; exists remainder: Poly;
                  subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) and
                  (remainder = ZEROP or less_than(degree(remainder), degree(g))) {
                  @the-reduction-divides |
                    exists quotient: Poly; exists remainder: Poly;
                      subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) and
                      (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                    [by hypothesis given-the-reduction-divides]
                  @with-the-reduced-quotient |
                    unpack reduced_quotient: Poly from the-reduction-divides {
                      @the-reduced-remainder-exists |
                        exists remainder: Poly;
                          subP(f, mulP(mono, g)) =
                          addP(mulP(g, reduced_quotient), remainder) and
                          (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                        [by hypothesis with-the-reduced-quotient]
                      @with-the-reduced-remainder |
                        unpack reduced_remainder: Poly from the-reduced-remainder-exists {
                          @the-reduced-division-and-its-condition |
                            subP(f, mulP(mono, g)) =
                              addP(mulP(g, reduced_quotient), reduced_remainder) and
                              (reduced_remainder = ZEROP or
                              less_than(degree(reduced_remainder), degree(g)))
                            [by hypothesis with-the-reduced-remainder]
                          @the-reduced-division |
                            subP(f, mulP(mono, g)) =
                              addP(mulP(g, reduced_quotient), reduced_remainder)
                            [by and_lhs the-reduced-division-and-its-condition]
                          @the-remainder-condition |
                            reduced_remainder = ZEROP or
                              less_than(degree(reduced_remainder), degree(g))
                            [by and_rhs the-reduced-division-and-its-condition]

                          // extend the quotient by one term
                          @the-extended-division |
                            f = addP(mulP(g, addP(reduced_quotient, mono)), reduced_remainder)
                            [using specialize theQuotientExtendsByOneTerm(f, g, mono, reduced_quotient, reduced_remainder) the-reduced-division]
                          @the-extended-division-and-its-condition |
                            f = addP(mulP(g, addP(reduced_quotient, mono)), reduced_remainder)
                              and (reduced_remainder = ZEROP or
                              less_than(degree(reduced_remainder), degree(g)))
                            [by both the-extended-division the-remainder-condition]
                          @the-extended-remainder-witness |
                            exists remainder: Poly;
                              f = addP(mulP(g, addP(reduced_quotient, mono)), remainder) and
                              (remainder = ZEROP or
                              less_than(degree(remainder), degree(g)))
                            [by witness(reduced_remainder) the-extended-division-and-its-condition]
                          @conclusion-the-extended-witnesses |
                            exists quotient: Poly; exists remainder: Poly;
                              f = addP(mulP(g, quotient), remainder) and
                              (remainder = ZEROP or
                              less_than(degree(remainder), degree(g)))
                            [by witness(addP(reduced_quotient, mono)) the-extended-remainder-witness]
                        }
                      @the-division-from-the-remainder |
                        exists quotient: Poly; exists remainder: Poly;
                          f = addP(mulP(g, quotient), remainder) and
                          (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                        [by unpacked with-the-reduced-remainder]
                    }
                  @the-division-from-the-quotient |
                    exists quotient: Poly; exists remainder: Poly;
                      f = addP(mulP(g, quotient), remainder) and
                      (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                    [by unpacked with-the-reduced-quotient]
                }
              @the-reduction-dividing-implies-the-original |
                (exists quotient: Poly; exists remainder: Poly;
                  subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) and
                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
                  exists quotient: Poly; exists remainder: Poly;
                  f = addP(mulP(g, quotient), remainder) and
                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                [by discharge given-the-reduction-divides]
            }
          @discharge-mono |
            forall mono: Poly;
              (exists quotient: Poly; exists remainder: Poly;
              subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) and
              (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
              exists quotient: Poly; exists remainder: Poly;
              f = addP(mulP(g, quotient), remainder) and
              (remainder = ZEROP or less_than(degree(remainder), degree(g)))
            [by generalize generalize-mono]
        }
      @discharge-g |
        forall g, mono: Poly;
          (exists quotient: Poly; exists remainder: Poly;
          subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) and
          (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
          exists quotient: Poly; exists remainder: Poly;
          f = addP(mulP(g, quotient), remainder) and
          (remainder = ZEROP or less_than(degree(remainder), degree(g)))
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g, mono: Poly;
      (exists quotient: Poly; exists remainder: Poly;
      subP(f, mulP(mono, g)) = addP(mulP(g, quotient), remainder) and
      (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
      exists quotient: Poly; exists remainder: Poly;
      f = addP(mulP(g, quotient), remainder) and
      (remainder = ZEROP or less_than(degree(remainder), degree(g)))
    [by generalize generalize-f]
qed

// Two small facts the construction arm needs, both about its chosen coefficient.

// A monomial with a nonzero coefficient is not the zero polynomial: they differ at index k.
theorem aNonzeroMonomialIsNonzero: forall a: F; forall k: Nat;
  (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP))
proof
  @generalize-a |
    fix a: F {
      @generalize-k |
        fix k: Nat {
          @given-the-coefficient-is-nonzero |
            assume not (a = zeroF) {
              @the-coefficient-is-nonzero |
                a != zeroF
                [by hypothesis given-the-coefficient-is-nonzero]
              @the-monomial-at-its-index |
                coeff(monomial(a, k), k) = a
                [using specialize monomialCoeffAtItsIndex(a, k)]
              @given-the-monomial-is-zero |
                assume monomial(a, k) = ZEROP {
                  @the-monomial-is-zero |
                    monomial(a, k) = ZEROP
                    [by hypothesis given-the-monomial-is-zero]
                  @the-zero-coefficient |
                    coeff(ZEROP, k) = zeroF
                    [using specialize zeroPolyCoeff(k)]
                  @the-monomial-coefficient-is-zero |
                    coeff(monomial(a, k), k) = zeroF
                    [by rewrite the-monomial-is-zero the-zero-coefficient]
                  @the-coefficient-is-zero |
                    a = zeroF
                    [using chain the-monomial-at-its-index-flipped the-monomial-coefficient-is-zero]
                  @the-monomial-at-its-index-flipped |
                    a = coeff(monomial(a, k), k)
                    [by symmetry the-monomial-at-its-index]
                  @contradiction |
                    not (monomial(a, k) = ZEROP)
                    [by ex_falso the-coefficient-is-zero the-coefficient-is-nonzero]
                }
              @being-zero-is-absurd |
                monomial(a, k) = ZEROP -> (not (monomial(a, k) = ZEROP))
                [by discharge given-the-monomial-is-zero]
              @conclusion-the-monomial-is-nonzero |
                not (monomial(a, k) = ZEROP)
                [using tautology being-zero-is-absurd]
            }
          @nonzero-coefficient-implies-nonzero-monomial |
            (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP))
            [by discharge given-the-coefficient-is-nonzero]
        }
      @discharge-k |
        forall k: Nat; (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP))
        [by generalize generalize-k]
    }
  @conclusion |
    forall a: F; forall k: Nat;
      (not (a = zeroF)) -> (not (monomial(a, k) = ZEROP))
    [by generalize generalize-a]
qed

// The chosen coefficient `a_n · recip(b_m)` is nonzero when both factors are: a field has no
// zero divisors, and `recip` of a nonzero is nonzero (else multiplying it by `b_m` could not
// give `1`).
theorem theChosenCoefficientIsNonzero: forall leading, divisor_leading: F;
  (not (leading = zeroF)) -> (not (divisor_leading = zeroF)) ->
  (not (mulF(leading, recipF(divisor_leading)) = zeroF))
proof
  @generalize-leading |
    fix leading: F {
      @generalize-divisor |
        fix divisor_leading: F {
          @given-the-leading-is-nonzero |
            assume not (leading = zeroF) {
              @given-the-divisor-is-nonzero |
                assume not (divisor_leading = zeroF) {
                  @the-leading-is-nonzero |
                    leading != zeroF
                    [by hypothesis given-the-leading-is-nonzero]
                  @the-divisor-is-nonzero |
                    divisor_leading != zeroF
                    [by hypothesis given-the-divisor-is-nonzero]
                  // recip(b) is nonzero: if it were zero, b·recip(b) would be zero, not one.
                  // recip(b) != 0: if it were, recip(b)·b would be 0, but it is 1.
                  @given-the-reciprocal-is-zero |
                    assume recipF(divisor_leading) = zeroF {
                      @the-reciprocal-is-zero |
                        recipF(divisor_leading) = zeroF
                        [by hypothesis given-the-reciprocal-is-zero]
                      @the-reciprocal-cancels |
                        mulF(recipF(divisor_leading), divisor_leading) = oneF
                        [using specialize field.recipMulLeft(divisor_leading) the-divisor-is-nonzero]
                      @zero-times-the-divisor |
                        mulF(zeroF, divisor_leading) = zeroF
                        [using specialize field.mulZeroLeft(divisor_leading)]
                      @one-would-be-zero |
                        oneF = zeroF
                        [using simplify the-reciprocal-cancels-flipped the-reciprocal-is-zero zero-times-the-divisor]
                      @the-reciprocal-cancels-flipped |
                        oneF = mulF(recipF(divisor_leading), divisor_leading)
                        [by symmetry the-reciprocal-cancels]
                      @one-is-not-zero |
                        oneF != zeroF
                        [by cite field.oneNotZero]
                      @contradiction |
                        recipF(divisor_leading) != zeroF
                        [by ex_falso one-would-be-zero one-is-not-zero]
                    }
                  @a-zero-reciprocal-is-absurd |
                    recipF(divisor_leading) = zeroF -> recipF(divisor_leading) != zeroF
                    [by discharge given-the-reciprocal-is-zero]
                  @the-reciprocal-is-nonzero |
                    recipF(divisor_leading) != zeroF
                    [using tautology a-zero-reciprocal-is-absurd]
                  @the-product-splits |
                    mulF(leading, recipF(divisor_leading)) = zeroF ->
                      (leading = zeroF or recipF(divisor_leading) = zeroF)
                    [using specialize field.noZeroDivisors(leading, recipF(divisor_leading))]
                  @conclusion-the-coefficient-is-nonzero |
                    not (mulF(leading, recipF(divisor_leading)) = zeroF)
                    [using tautology the-product-splits the-leading-is-nonzero the-reciprocal-is-nonzero]
                }
              @divisor-nonzero-implies-the-product |
                (not (divisor_leading = zeroF)) ->
                  (not (mulF(leading, recipF(divisor_leading)) = zeroF))
                [by discharge given-the-divisor-is-nonzero]
            }
          @both-nonzero-imply-the-product |
            (not (leading = zeroF)) -> (not (divisor_leading = zeroF)) ->
              (not (mulF(leading, recipF(divisor_leading)) = zeroF))
            [by discharge given-the-leading-is-nonzero]
        }
      @discharge-divisor |
        forall divisor_leading: F;
          (not (leading = zeroF)) -> (not (divisor_leading = zeroF)) ->
          (not (mulF(leading, recipF(divisor_leading)) = zeroF))
        [by generalize generalize-divisor]
    }
  @conclusion |
    forall leading, divisor_leading: F;
      (not (leading = zeroF)) -> (not (divisor_leading = zeroF)) ->
      (not (mulF(leading, recipF(divisor_leading)) = zeroF))
    [by generalize generalize-leading]
qed

// ARM 3 — THE CONSTRUCTION, with the recursion's result taken as a hypothesis so the arm
// itself is hypothesis-discharge rather than induction. Given `f` of degree `succ(d)`, `g`
// of degree `m` with `k + m = succ(d)`, and that EVERY polynomial of degree at most `d`
// divides, `f` divides.
//
// This is where the seven hypotheses of `theConstructionDropsADegree` get discharged: the
// leading coefficients are nonzero because they ARE the degrees' coefficients, the monomial
// is nonzero because its coefficient is, and that coefficient is nonzero because a field has
// no zero divisors.
theorem theConstructionDividesGivenTheReduction: forall f, g: Poly; forall k, m, d: Nat;
  (not (f = ZEROP)) -> (not (g = ZEROP)) ->
  degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
  (forall reduced: Poly; degreeAtMost(reduced, d) ->
  exists quotient: Poly; exists remainder: Poly;
  reduced = addP(mulP(g, quotient), remainder) and
  (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
  exists quotient: Poly; exists remainder: Poly;
  f = addP(mulP(g, quotient), remainder) and
  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
proof
  @generalize-f |
    fix f: Poly {
      @generalize-g |
        fix g: Poly {
          @generalize-k |
            fix k: Nat {
              @generalize-m |
                fix m: Nat {
                  @generalize-d |
                    fix d: Nat {
                      @given-f-nonzero |
                        assume not (f = ZEROP) {
                          @given-g-nonzero |
                            assume not (g = ZEROP) {
                              @given-g-degree |
                                assume degree(g) = m {
                                  @given-f-degree |
                                    assume degree(f) = peano.add(k, m) {
                                      @given-the-successor |
                                        assume peano.add(k, m) = succ(d) {
                                          @given-the-recursion |
                                            assume forall reduced: Poly;
                                              degreeAtMost(reduced, d) ->
                                              exists quotient: Poly; exists remainder: Poly;
                                              reduced = addP(mulP(g, quotient), remainder) and
                                              (remainder = ZEROP or less_than(degree(remainder), degree(g))) {
                                              @f-nonzero |
                                                not (f = ZEROP)
                                                [by hypothesis given-f-nonzero]
                                              @g-nonzero |
                                                not (g = ZEROP)
                                                [by hypothesis given-g-nonzero]
                                              @g-degree |
                                                degree(g) = m
                                                [by hypothesis given-g-degree]
                                              @f-degree |
                                                degree(f) = peano.add(k, m)
                                                [by hypothesis given-f-degree]
                                              @the-successor |
                                                peano.add(k, m) = succ(d)
                                                [by hypothesis given-the-successor]
                                              @the-recursion |
                                                forall reduced: Poly;
                                                  degreeAtMost(reduced, d) ->
                                                  exists quotient: Poly; exists remainder: Poly;
                                                  reduced = addP(mulP(g, quotient), remainder) and
                                                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                                                [by hypothesis given-the-recursion]

                                              // g's leading coefficient is nonzero
                                              @g-leads-at-its-degree |
                                                not (coeff(g, degree(g)) = zeroF)
                                                [using specialize degreeIsALeadingIndex(g) g-nonzero]
                                              @g-leads-at-m |
                                                not (coeff(g, m) = zeroF)
                                                [by rewrite g-degree g-leads-at-its-degree]

                                              // f's leading coefficient is nonzero
                                              @f-leads-at-its-degree |
                                                not (coeff(f, degree(f)) = zeroF)
                                                [using specialize degreeIsALeadingIndex(f) f-nonzero]
                                              @f-leads-at-the-top |
                                                not (coeff(f, peano.add(k, m)) = zeroF)
                                                [by rewrite f-degree f-leads-at-its-degree]

                                              // so the chosen coefficient, and the monomial, are nonzero
                                              @the-chosen-coefficient-is-nonzero |
                                                not (mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))) = zeroF)
                                                [using specialize theChosenCoefficientIsNonzero(coeff(f, peano.add(k, m)), coeff(g, m)) f-leads-at-the-top g-leads-at-m]
                                              @the-monomial-is-nonzero |
                                                not (monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) = ZEROP)
                                                [using specialize aNonzeroMonomialIsNonzero(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k) the-chosen-coefficient-is-nonzero]

                                              // the reduced polynomial's degree drops
                                              @the-reduction-is-bounded |
                                                degreeAtMost(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)), d)
                                                [using specialize theConstructionDropsADegree(f, g, k, m, d) f-nonzero g-nonzero the-monomial-is-nonzero g-leads-at-m the-chosen-coefficient-is-nonzero g-degree f-degree the-successor]

                                              // the recursion divides it, and the quotient extends
                                              @the-reduction-divides |
                                                exists quotient: Poly; exists remainder: Poly;
                                                  subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g)) = addP(mulP(g, quotient), remainder) and
                                                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                                                [using specialize the-recursion(subP(f, mulP(monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k), g))) the-reduction-is-bounded]
                                              @conclusion-f-divides |
                                                exists quotient: Poly; exists remainder: Poly;
                                                  f = addP(mulP(g, quotient), remainder) and
                                                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                                                [using specialize extendingADivisionOfTheReduction(f, g, monomial(mulF(coeff(f, peano.add(k, m)), recipF(coeff(g, m))), k)) the-reduction-divides]
                                            }
                                          @recursion-implies-division |
                                            (forall reduced: Poly; degreeAtMost(reduced, d) ->
                                              exists quotient: Poly; exists remainder: Poly;
                                              reduced = addP(mulP(g, quotient), remainder) and
                                              (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
                                              exists quotient: Poly; exists remainder: Poly;
                                              f = addP(mulP(g, quotient), remainder) and
                                              (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                                            [by discharge given-the-recursion]
                                        }
                                      @successor-implies-division |
                                        peano.add(k, m) = succ(d) ->
                                          (forall reduced: Poly; degreeAtMost(reduced, d) ->
                                          exists quotient: Poly; exists remainder: Poly;
                                          reduced = addP(mulP(g, quotient), remainder) and
                                          (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
                                          exists quotient: Poly; exists remainder: Poly;
                                          f = addP(mulP(g, quotient), remainder) and
                                          (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                                        [by discharge given-the-successor]
                                    }
                                  @f-degree-implies-division |
                                    degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                      (forall reduced: Poly; degreeAtMost(reduced, d) ->
                                      exists quotient: Poly; exists remainder: Poly;
                                      reduced = addP(mulP(g, quotient), remainder) and
                                      (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
                                      exists quotient: Poly; exists remainder: Poly;
                                      f = addP(mulP(g, quotient), remainder) and
                                      (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                                    [by discharge given-f-degree]
                                }
                              @g-degree-implies-division |
                                degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                                  (forall reduced: Poly; degreeAtMost(reduced, d) ->
                                  exists quotient: Poly; exists remainder: Poly;
                                  reduced = addP(mulP(g, quotient), remainder) and
                                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
                                  exists quotient: Poly; exists remainder: Poly;
                                  f = addP(mulP(g, quotient), remainder) and
                                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                                [by discharge given-g-degree]
                            }
                          @g-nonzero-implies-division |
                            (not (g = ZEROP)) -> degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                              (forall reduced: Poly; degreeAtMost(reduced, d) ->
                              exists quotient: Poly; exists remainder: Poly;
                              reduced = addP(mulP(g, quotient), remainder) and
                              (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
                              exists quotient: Poly; exists remainder: Poly;
                              f = addP(mulP(g, quotient), remainder) and
                              (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                            [by discharge given-g-nonzero]
                        }
                      @the-arm |
                        (not (f = ZEROP)) -> (not (g = ZEROP)) -> degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                          (forall reduced: Poly; degreeAtMost(reduced, d) ->
                          exists quotient: Poly; exists remainder: Poly;
                          reduced = addP(mulP(g, quotient), remainder) and
                          (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
                          exists quotient: Poly; exists remainder: Poly;
                          f = addP(mulP(g, quotient), remainder) and
                          (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                        [by discharge given-f-nonzero]
                    }
                  @discharge-d |
                    forall d: Nat;
                      (not (f = ZEROP)) -> (not (g = ZEROP)) -> degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                      (forall reduced: Poly; degreeAtMost(reduced, d) ->
                      exists quotient: Poly; exists remainder: Poly;
                      reduced = addP(mulP(g, quotient), remainder) and
                      (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
                      exists quotient: Poly; exists remainder: Poly;
                      f = addP(mulP(g, quotient), remainder) and
                      (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                    [by generalize generalize-d]
                }
              @discharge-m |
                forall m, d: Nat;
                  (not (f = ZEROP)) -> (not (g = ZEROP)) -> degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
                  (forall reduced: Poly; degreeAtMost(reduced, d) ->
                  exists quotient: Poly; exists remainder: Poly;
                  reduced = addP(mulP(g, quotient), remainder) and
                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
                  exists quotient: Poly; exists remainder: Poly;
                  f = addP(mulP(g, quotient), remainder) and
                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                [by generalize generalize-m]
            }
          @discharge-k |
            forall k, m, d: Nat;
              (not (f = ZEROP)) -> (not (g = ZEROP)) -> degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
              (forall reduced: Poly; degreeAtMost(reduced, d) ->
              exists quotient: Poly; exists remainder: Poly;
              reduced = addP(mulP(g, quotient), remainder) and
              (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
              exists quotient: Poly; exists remainder: Poly;
              f = addP(mulP(g, quotient), remainder) and
              (remainder = ZEROP or less_than(degree(remainder), degree(g)))
            [by generalize generalize-k]
        }
      @discharge-g |
        forall g: Poly; forall k, m, d: Nat;
          (not (f = ZEROP)) -> (not (g = ZEROP)) -> degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
          (forall reduced: Poly; degreeAtMost(reduced, d) ->
          exists quotient: Poly; exists remainder: Poly;
          reduced = addP(mulP(g, quotient), remainder) and
          (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
          exists quotient: Poly; exists remainder: Poly;
          f = addP(mulP(g, quotient), remainder) and
          (remainder = ZEROP or less_than(degree(remainder), degree(g)))
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: Poly; forall k, m, d: Nat;
      (not (f = ZEROP)) -> (not (g = ZEROP)) -> degree(g) = m -> degree(f) = peano.add(k, m) -> peano.add(k, m) = succ(d) ->
      (forall reduced: Poly; degreeAtMost(reduced, d) ->
      exists quotient: Poly; exists remainder: Poly;
      reduced = addP(mulP(g, quotient), remainder) and
      (remainder = ZEROP or less_than(degree(remainder), degree(g)))) ->
      exists quotient: Poly; exists remainder: Poly;
      f = addP(mulP(g, quotient), remainder) and
      (remainder = ZEROP or less_than(degree(remainder), degree(g)))
    [by generalize generalize-f]
qed

// ARM 4 — THE CONSTANT CASE, which the other three miss.
//
// When `f` and `g` are both nonzero CONSTANTS (degree ZERO), `f` is not "small" (its degree
// is not below `g`'s, they are equal) and the construction arm cannot apply either, since
// its degree hypothesis is `succ`-shaped and `0 + 0` is not a successor. Judson does not
// remark on it: in his induction this is the `n = 0` base, handled by the same long division.
//
// The division is exact: `f = g·(a_0/b_0)` with remainder zero. The difference vanishes AT
// index 0 by the cancellation, and ABOVE index 0 because both sides are bounded by 0, so by
// extensionality the difference IS the zero polynomial.
theorem aConstantDividesAConstantExactly: forall f, g: Poly;
  (not (f = ZEROP)) -> (not (g = ZEROP)) ->
  degree(f) = ZERO -> degree(g) = ZERO ->
  exists quotient: Poly; exists remainder: Poly;
  f = addP(mulP(g, quotient), remainder) and
  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
proof
  @generalize-f |
    fix f: Poly {
      @generalize-g |
        fix g: Poly {
          @given-f-nonzero |
            assume not (f = ZEROP) {
              @given-g-nonzero |
                assume not (g = ZEROP) {
                  @given-f-constant |
                    assume degree(f) = ZERO {
                      @given-g-constant |
                        assume degree(g) = ZERO {
                          @f-nonzero |
                            not (f = ZEROP)
                            [by hypothesis given-f-nonzero]
                          @g-nonzero |
                            not (g = ZEROP)
                            [by hypothesis given-g-nonzero]
                          @f-constant |
                            degree(f) = ZERO
                            [by hypothesis given-f-constant]
                          @g-constant |
                            degree(g) = ZERO
                            [by hypothesis given-g-constant]

                          @g-leads-at-its-degree |
                            not (coeff(g, degree(g)) = zeroF)
                            [using specialize degreeIsALeadingIndex(g) g-nonzero]
                          @g-leads-at-zero |
                            not (coeff(g, ZERO) = zeroF)
                            [by rewrite g-constant g-leads-at-its-degree]

                          // the cancellation at k = m = ZERO, where ZERO + ZERO = ZERO
                          @the-indices-sum-to-zero |
                            peano.add(ZERO, ZERO) = ZERO
                            [using specialize peano.addZeroRight(ZERO)]
                          @the-cancellation-at-the-sum |
                            coeff(subP(f, mulP(monomial(mulF(coeff(f, peano.add(ZERO, ZERO)), recipF(coeff(g, ZERO))), ZERO), g)), peano.add(ZERO, ZERO)) = zeroF
                            [using specialize theLeadingTermsCancel(f, g, ZERO, ZERO) g-leads-at-zero]
                          // rewrite add(ZERO,ZERO) to ZERO everywhere it occurs at once
                          @the-cancellation-at-zero |
                            coeff(subP(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)), ZERO) = zeroF
                            [by rewrite the-indices-sum-to-zero the-cancellation-at-the-sum]

                          // both sides are bounded by ZERO, so the difference vanishes above it
                          @f-is-bounded-by-its-degree |
                            degreeAtMost(f, degree(f))
                            [using specialize degreeBoundsTheCoefficients(f) f-nonzero]
                          @f-is-bounded |
                            degreeAtMost(f, ZERO)
                            [by rewrite f-constant f-is-bounded-by-its-degree]
                          @what-f-bounding-means |
                            degreeAtMost(f, ZERO) iff
                              (forall i: Nat; less_than(ZERO, i) -> coeff(f, i) = zeroF)
                            [using specialize degreeAtMostMeaning(f, ZERO)]
                          @f-vanishes-above-zero |
                            forall i: Nat; less_than(ZERO, i) -> coeff(f, i) = zeroF
                            [using tautology f-is-bounded what-f-bounding-means]

                          @the-chosen-coefficient-is-nonzero |
                            not (mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))) = zeroF)
                            [using specialize theChosenCoefficientIsNonzero(coeff(f, ZERO), coeff(g, ZERO)) f-leads-at-zero g-leads-at-zero]
                          @f-leads-at-its-degree |
                            not (coeff(f, degree(f)) = zeroF)
                            [using specialize degreeIsALeadingIndex(f) f-nonzero]
                          @f-leads-at-zero |
                            not (coeff(f, ZERO) = zeroF)
                            [by rewrite f-constant f-leads-at-its-degree]
                          @the-monomial-is-nonzero |
                            not (monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO) = ZEROP)
                            [using specialize aNonzeroMonomialIsNonzero(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO) the-chosen-coefficient-is-nonzero]
                          @the-subtrahend-nonzero |
                            not (mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g) = ZEROP)
                            [using specialize aProductOfNonzerosIsNonzero(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g) the-monomial-is-nonzero g-nonzero]
                          @the-monomial-degree |
                            degree(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO)) = ZERO
                            [using specialize aNonzeroMonomialHasItsIndexAsDegree(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO) the-chosen-coefficient-is-nonzero the-monomial-is-nonzero]
                          @the-subtrahend-degree-is-a-sum |
                            degree(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)) =
                              peano.add(degree(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO)), degree(g))
                            [using specialize degreeOfAProduct(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g) the-monomial-is-nonzero g-nonzero]
                          @the-subtrahend-degree |
                            degree(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)) = ZERO
                            [using simplify the-subtrahend-degree-is-a-sum the-monomial-degree g-constant the-indices-sum-to-zero]
                          @the-subtrahend-is-bounded-by-its-degree |
                            degreeAtMost(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), degree(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)))
                            [using specialize degreeBoundsTheCoefficients(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)) the-subtrahend-nonzero]
                          @the-subtrahend-is-bounded |
                            degreeAtMost(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), ZERO)
                            [by rewrite the-subtrahend-degree the-subtrahend-is-bounded-by-its-degree]
                          @what-the-subtrahend-bounding-means |
                            degreeAtMost(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), ZERO) iff
                              (forall i: Nat; less_than(ZERO, i) -> coeff(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), i) = zeroF)
                            [using specialize degreeAtMostMeaning(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), ZERO)]
                          @the-subtrahend-vanishes-above-zero |
                            forall i: Nat; less_than(ZERO, i) -> coeff(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), i) = zeroF
                            [using tautology the-subtrahend-is-bounded what-the-subtrahend-bounding-means]

                          // so the difference vanishes at EVERY index
                          @generalize-index |
                            fix i: Nat {
                              // trichotomy, with the i < ZERO arm ruled out
                              @the-index-trichotomy |
                                less_than(i, ZERO) or i = ZERO or less_than(ZERO, i)
                                [using specialize peano_order.trichotomy(i, ZERO)]
                              @nothing-is-below-zero |
                                not less_than(i, ZERO)
                                [using specialize peano_order.notLessThanZero(i)]
                              @the-index-is-zero-or-above |
                                i = ZERO or less_than(ZERO, i)
                                [using tautology the-index-trichotomy nothing-is-below-zero]
                              @when-the-index-is-zero |
                                assume i = ZERO {
                                  @the-index-is-zero |
                                    i = ZERO
                                    [by hypothesis when-the-index-is-zero]
                                  @the-difference-vanishes-at-this-index |
                                    coeff(subP(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)), i) = zeroF
                                    [by rewrite the-index-is-zero-flipped the-cancellation-at-zero]
                                  @the-index-is-zero-flipped |
                                    ZERO = i
                                    [by symmetry the-index-is-zero]
                                }
                              @when-the-index-is-positive |
                                assume less_than(ZERO, i) {
                                  @the-index-is-positive |
                                    less_than(ZERO, i)
                                    [by hypothesis when-the-index-is-positive]
                                  @f-vanishes-here |
                                    coeff(f, i) = zeroF
                                    [using specialize f-vanishes-above-zero(i) the-index-is-positive]
                                  @the-subtrahend-vanishes-here |
                                    coeff(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), i) = zeroF
                                    [using specialize the-subtrahend-vanishes-above-zero(i) the-index-is-positive]
                                  @the-difference-here |
                                    coeff(subP(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)), i) =
                                      addF(coeff(f, i), negF(coeff(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), i)))
                                    [using specialize subPolyCoeff(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), i)]
                                  @the-difference-of-zeros |
                                    coeff(subP(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)), i) = addF(zeroF, negF(zeroF))
                                    [using simplify the-difference-here f-vanishes-here the-subtrahend-vanishes-here]
                                  @negating-zero |
                                    negF(zeroF) = zeroF
                                    [by cite field.negZero]
                                  @zero-plus-zero |
                                    addF(zeroF, zeroF) = zeroF
                                    [using specialize addZeroLeftF(zeroF)]
                                  @the-difference-vanishes-at-this-index |
                                    coeff(subP(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)), i) = zeroF
                                    [using simplify the-difference-of-zeros negating-zero zero-plus-zero]
                                }
                              @the-difference-vanishes-either-way |
                                coeff(subP(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)), i) = zeroF
                                [by common_conclusion the-index-is-zero-or-above when-the-index-is-zero when-the-index-is-positive]
                              @the-zero-coefficient-here |
                                coeff(ZEROP, i) = zeroF
                                [using specialize zeroPolyCoeff(i)]
                              @the-zero-coefficient-flipped |
                                zeroF = coeff(ZEROP, i)
                                [by symmetry the-zero-coefficient-here]
                              @coefficients-agree-at-index |
                                coeff(subP(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)), i) = coeff(ZEROP, i)
                                [using chain the-difference-vanishes-either-way the-zero-coefficient-flipped]
                            }
                          @corresponding-coefficients-are-equal |
                            forall i: Nat;
                              coeff(subP(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)), i) = coeff(ZEROP, i)
                            [by generalize generalize-index]
                          @the-difference-is-zero |
                            subP(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)) = ZEROP
                            [using specialize polyExtensionality(subP(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)), ZEROP) corresponding-coefficients-are-equal]

                          // f = mono*g + 0, and mono*g = g*mono
                          @f-recovered |
                            f = addP(ZEROP, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g))
                            [using specialize aDifferenceRecoversItsMinuend(f, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), ZEROP) the-difference-is-zero]
                          @the-sum-commutes |
                            addP(ZEROP, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)) =
                              addP(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), ZEROP)
                            [using specialize polyAddIsCommutative(ZEROP, mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g))]
                          @the-product-commutes |
                            mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g) =
                              mulP(g, monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO))
                            [using specialize polyMulIsCommutative(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g)]
                          // f = 0 + mono*g = mono*g + 0 = g*mono + 0, each step explicit
                          // (a `simplify` with both commutativity rules loops).
                          @f-with-the-sum-flipped |
                            f = addP(mulP(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO), g), ZEROP)
                            [using chain f-recovered the-sum-commutes]
                          @the-division |
                            f = addP(mulP(g, monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO)), ZEROP)
                            [by rewrite the-product-commutes f-with-the-sum-flipped]
                          @the-remainder-is-zero |
                            ZEROP = ZEROP or less_than(degree(ZEROP), degree(g))
                            [by either_left the-zero-is-zero]
                          @the-zero-is-zero |
                            ZEROP = ZEROP
                            [by reflexivity]
                          @the-division-and-its-condition |
                            f = addP(mulP(g, monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO)), ZEROP)
                              and (ZEROP = ZEROP or less_than(degree(ZEROP), degree(g)))
                            [by both the-division the-remainder-is-zero]
                          @the-remainder-witness |
                            exists remainder: Poly;
                              f = addP(mulP(g, monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO)), remainder)
                              and (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                            [by witness(ZEROP) the-division-and-its-condition]
                          @conclusion-the-constant-division |
                            exists quotient: Poly; exists remainder: Poly;
                              f = addP(mulP(g, quotient), remainder) and
                              (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                            [by witness(monomial(mulF(coeff(f, ZERO), recipF(coeff(g, ZERO))), ZERO)) the-remainder-witness]
                        }
                      @g-constant-implies-the-division |
                        degree(g) = ZERO ->
                          exists quotient: Poly; exists remainder: Poly;
                          f = addP(mulP(g, quotient), remainder) and
                          (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                        [by discharge given-g-constant]
                    }
                  @f-constant-implies-the-division |
                    degree(f) = ZERO -> degree(g) = ZERO ->
                      exists quotient: Poly; exists remainder: Poly;
                      f = addP(mulP(g, quotient), remainder) and
                      (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                    [by discharge given-f-constant]
                }
              @g-nonzero-implies-the-division |
                (not (g = ZEROP)) -> degree(f) = ZERO -> degree(g) = ZERO ->
                  exists quotient: Poly; exists remainder: Poly;
                  f = addP(mulP(g, quotient), remainder) and
                  (remainder = ZEROP or less_than(degree(remainder), degree(g)))
                [by discharge given-g-nonzero]
            }
          @the-constant-arm |
            (not (f = ZEROP)) -> (not (g = ZEROP)) -> degree(f) = ZERO -> degree(g) = ZERO ->
              exists quotient: Poly; exists remainder: Poly;
              f = addP(mulP(g, quotient), remainder) and
              (remainder = ZEROP or less_than(degree(remainder), degree(g)))
            [by discharge given-f-nonzero]
        }
      @discharge-g |
        forall g: Poly;
          (not (f = ZEROP)) -> (not (g = ZEROP)) -> degree(f) = ZERO -> degree(g) = ZERO ->
          exists quotient: Poly; exists remainder: Poly;
          f = addP(mulP(g, quotient), remainder) and
          (remainder = ZEROP or less_than(degree(remainder), degree(g)))
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: Poly;
      (not (f = ZEROP)) -> (not (g = ZEROP)) -> degree(f) = ZERO -> degree(g) = ZERO ->
      exists quotient: Poly; exists remainder: Poly;
      f = addP(mulP(g, quotient), remainder) and
      (remainder = ZEROP or less_than(degree(remainder), degree(g)))
    [by generalize generalize-f]
qed

// A bounded nonzero polynomial has its DEGREE within that bound. `degreeAtMost` is a
// statement about coefficients; this converts it to an order fact, which is what the
// induction needs to know the recursion's target index is smaller.
//
// If the degree exceeded the bound, the bound would force that coefficient to vanish — but it
// is the LEADING coefficient, which does not.
theorem aBoundedPolynomialHasABoundedDegree: forall f: Poly; forall n: Nat;
  (not (f = ZEROP)) -> degreeAtMost(f, n) -> peano_order.less_or_equal(degree(f), n)
proof
  @generalize-f |
    fix pp: Poly {
      @generalize-n |
        fix nn: Nat {
          @given-nonzero |
            assume not (pp = ZEROP) {
              @given-bounded |
                assume degreeAtMost(pp, nn) {
                  @nonzero |
                    not (pp = ZEROP)
                    [by hypothesis given-nonzero]
                  @bounded |
                    degreeAtMost(pp, nn)
                    [by hypothesis given-bounded]
                  @what-bounding-means |
                    degreeAtMost(pp, nn) iff
                      (forall i: Nat; less_than(nn, i) -> coeff(pp, i) = zeroF)
                    [using specialize degreeAtMostMeaning(pp, nn)]
                  @vanishes-above |
                    forall i: Nat; less_than(nn, i) -> coeff(pp, i) = zeroF
                    [using tautology bounded what-bounding-means]
                  @the-leading-coefficient |
                    not (coeff(pp, degree(pp)) = zeroF)
                    [using specialize degreeIsALeadingIndex(pp) nonzero]
                  @the-degree-would-vanish |
                    less_than(nn, degree(pp)) -> coeff(pp, degree(pp)) = zeroF
                    [using specialize vanishes-above(degree(pp))]
                  @not-above |
                    not less_than(nn, degree(pp))
                    [using tautology the-degree-would-vanish the-leading-coefficient]
                  @the-degrees-compare |
                    less_than(degree(pp), nn) or degree(pp) = nn or less_than(nn, degree(pp))
                    [using specialize peano_order.trichotomy(degree(pp), nn)]
                  @below-or-equal |
                    less_than(degree(pp), nn) or degree(pp) = nn
                    [using tautology the-degrees-compare not-above]
                  @when-below |
                    assume less_than(degree(pp), nn) {
                      @below |
                        less_than(degree(pp), nn)
                        [by hypothesis when-below]
                      @bounded-when-below |
                        peano_order.less_or_equal(degree(pp), nn)
                        [using specialize peano_order.lessThanToLessOrEqual(degree(pp), nn) below]
                    }
                  @when-equal |
                    assume degree(pp) = nn {
                      @equal |
                        degree(pp) = nn
                        [by hypothesis when-equal]
                      @reflexive |
                        peano_order.less_or_equal(degree(pp), degree(pp))
                        [using specialize peano_order.lessOrEqualRefl(degree(pp))]
                      @bounded-when-equal |
                        peano_order.less_or_equal(degree(pp), nn)
                        [by rewrite equal reflexive]
                    }
                  @conclusion-bounded-degree |
                    peano_order.less_or_equal(degree(pp), nn)
                    [by common_conclusion below-or-equal when-below when-equal]
                }
              @bounded-implies-bound |
                degreeAtMost(pp, nn) -> peano_order.less_or_equal(degree(pp), nn)
                [by discharge given-bounded]
            }
          @nonzero-implies-bound |
            (not (pp = ZEROP)) -> degreeAtMost(pp, nn) ->
              peano_order.less_or_equal(degree(pp), nn)
            [by discharge given-nonzero]
        }
      @discharge-n |
        forall n: Nat;
          (not (pp = ZEROP)) -> degreeAtMost(pp, n) ->
          peano_order.less_or_equal(degree(pp), n)
        [by generalize generalize-n]
    }
  @conclusion |
    forall f: Poly; forall n: Nat;
      (not (f = ZEROP)) -> degreeAtMost(f, n) ->
      peano_order.less_or_equal(degree(f), n)
    [by generalize generalize-f]
qed

// THE RECURSIVE LEAF, with its index arithmetic done once. Given a nonzero `ff` whose degree
// is a successor and at least `gg`'s, plus the recursion at every smaller bound, `ff` divides.
//
// Judson's `n - m` becomes a gap WITNESS: `deg gg <= deg ff` means some `kk` has
// `deg gg + kk = deg ff`, and commuting that sum gives the `k + m` shape the construction arm
// wants. No truncated subtraction appears.
//
// Binder names are doubled (`ff`, `gg`, `nn`, `dd`) and the generalize steps use `f9`-style
// names: the shadowing check rejects reusing a `fix`-bound name in an enclosing step's
// statement, and this proof is nine levels deep.
theorem theRecursiveCaseDivides: forall ff, gg: Poly; forall nn, dd: Nat;
  (not (ff = ZEROP)) -> (not (gg = ZEROP)) ->
  degreeAtMost(ff, nn) -> degree(ff) = succ(dd) ->
  peano_order.less_or_equal(degree(gg), degree(ff)) ->
  (forall jj: Nat; less_than(jj, nn) ->
  forall red: Poly; degreeAtMost(red, jj) ->
  exists quo: Poly; exists rem: Poly;
  red = addP(mulP(gg, quo), rem) and
  (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
  exists quo: Poly; exists rem: Poly;
  ff = addP(mulP(gg, quo), rem) and
  (rem = ZEROP or less_than(degree(rem), degree(gg)))
proof
  @generalize-ff |
    fix ff: Poly {
      @generalize-gg |
        fix gg: Poly {
          @generalize-nn |
            fix nn: Nat {
              @generalize-dd |
                fix dd: Nat {
                  @given-ff-nonzero |
                    assume not (ff = ZEROP) {
                      @given-gg-nonzero |
                        assume not (gg = ZEROP) {
                          @given-ff-bounded |
                            assume degreeAtMost(ff, nn) {
                              @given-ff-degree |
                                assume degree(ff) = succ(dd) {
                                  @given-gg-fits |
                                    assume peano_order.less_or_equal(degree(gg), degree(ff)) {
                                      @given-recursion |
                                        assume forall jj: Nat; less_than(jj, nn) ->
                                          forall red: Poly; degreeAtMost(red, jj) ->
                                          exists quo: Poly; exists rem: Poly;
                                          red = addP(mulP(gg, quo), rem) and
                                          (rem = ZEROP or less_than(degree(rem), degree(gg))) {
                                          @ff-nonzero |
                                            not (ff = ZEROP)
                                            [by hypothesis given-ff-nonzero]
                                          @gg-nonzero |
                                            not (gg = ZEROP)
                                            [by hypothesis given-gg-nonzero]
                                          @ff-bounded |
                                            degreeAtMost(ff, nn)
                                            [by hypothesis given-ff-bounded]
                                          @ff-degree |
                                            degree(ff) = succ(dd)
                                            [by hypothesis given-ff-degree]
                                          @gg-fits |
                                            peano_order.less_or_equal(degree(gg), degree(ff))
                                            [by hypothesis given-gg-fits]
                                          @recursion |
                                            forall jj: Nat; less_than(jj, nn) ->
                                              forall red: Poly; degreeAtMost(red, jj) ->
                                              exists quo: Poly; exists rem: Poly;
                                              red = addP(mulP(gg, quo), rem) and
                                              (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                            [by hypothesis given-recursion]

                                          @degree-bounded |
                                            peano_order.less_or_equal(degree(ff), nn)
                                            [using specialize aBoundedPolynomialHasABoundedDegree(ff, nn) ff-nonzero ff-bounded]
                                          @successor-bounded |
                                            peano_order.less_or_equal(succ(dd), nn)
                                            [by rewrite ff-degree degree-bounded]
                                          @successor-below-successor |
                                            less_than(succ(dd), succ(nn))
                                            [using specialize peano_order.lessOrEqualToLessThanSucc(succ(dd), nn) successor-bounded]
                                          @dd-below-nn |
                                            less_than(dd, nn)
                                            [using specialize peano_order.succReflectsOrder(dd, nn) successor-below-successor]

                                          @what-the-gap-means |
                                            peano_order.less_or_equal(degree(gg), degree(ff)) iff
                                              (exists kk: Nat; peano.add(degree(gg), kk) = degree(ff))
                                            [using specialize peano_order.lessOrEqualIsGapExistential(degree(gg), degree(ff))]
                                          @the-gap-exists |
                                            exists kk: Nat; peano.add(degree(gg), kk) = degree(ff)
                                            [using tautology gg-fits what-the-gap-means]
                                          @with-the-gap |
                                            unpack kk: Nat from the-gap-exists {
                                              @the-gap-sums |
                                                peano.add(degree(gg), kk) = degree(ff)
                                                [by hypothesis with-the-gap]
                                              @the-sum-commutes |
                                                peano.add(kk, degree(gg)) = peano.add(degree(gg), kk)
                                                [using specialize peano.addIsCommutative(kk, degree(gg))]
                                              @the-commuted-sum |
                                                peano.add(kk, degree(gg)) = degree(ff)
                                                [using chain the-sum-commutes the-gap-sums]
                                              @ff-degree-as-sum |
                                                degree(ff) = peano.add(kk, degree(gg))
                                                [by symmetry the-commuted-sum]
                                              @sum-is-successor |
                                                peano.add(kk, degree(gg)) = succ(dd)
                                                [using chain the-commuted-sum ff-degree]
                                              @gg-degree-itself |
                                                degree(gg) = degree(gg)
                                                [by reflexivity]
                                              @recursion-at-dd |
                                                forall red: Poly; degreeAtMost(red, dd) ->
                                                  exists quo: Poly; exists rem: Poly;
                                                  red = addP(mulP(gg, quo), rem) and
                                                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                                [using specialize recursion(dd) dd-below-nn]
                                              @the-construction-divides |
                                                exists quo: Poly; exists rem: Poly;
                                                  ff = addP(mulP(gg, quo), rem) and
                                                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                                [using specialize theConstructionDividesGivenTheReduction(ff, gg, kk, degree(gg), dd) ff-nonzero gg-nonzero gg-degree-itself ff-degree-as-sum sum-is-successor recursion-at-dd]
                                            }
                                          @divides-from-the-gap |
                                            exists quo: Poly; exists rem: Poly;
                                              ff = addP(mulP(gg, quo), rem) and
                                              (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                            [by unpacked with-the-gap]
                                        }
                                      @d6 |
                                        (forall jj: Nat; less_than(jj, nn) ->
                                          forall red: Poly; degreeAtMost(red, jj) ->
                                          exists quo: Poly; exists rem: Poly;
                                          red = addP(mulP(gg, quo), rem) and
                                          (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                                          exists quo: Poly; exists rem: Poly;
                                          ff = addP(mulP(gg, quo), rem) and
                                          (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                        [by discharge given-recursion]
                                    }
                                  @d5 |
                                    peano_order.less_or_equal(degree(gg), degree(ff)) ->
                                      (forall jj: Nat; less_than(jj, nn) ->
                                      forall red: Poly; degreeAtMost(red, jj) ->
                                      exists quo: Poly; exists rem: Poly;
                                      red = addP(mulP(gg, quo), rem) and
                                      (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                                      exists quo: Poly; exists rem: Poly;
                                      ff = addP(mulP(gg, quo), rem) and
                                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                    [by discharge given-gg-fits]
                                }
                              @d4 |
                                degree(ff) = succ(dd) ->
                                  peano_order.less_or_equal(degree(gg), degree(ff)) ->
                                  (forall jj: Nat; less_than(jj, nn) ->
                                  forall red: Poly; degreeAtMost(red, jj) ->
                                  exists quo: Poly; exists rem: Poly;
                                  red = addP(mulP(gg, quo), rem) and
                                  (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                                  exists quo: Poly; exists rem: Poly;
                                  ff = addP(mulP(gg, quo), rem) and
                                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                [by discharge given-ff-degree]
                            }
                          @d3 |
                            degreeAtMost(ff, nn) -> degree(ff) = succ(dd) ->
                              peano_order.less_or_equal(degree(gg), degree(ff)) ->
                              (forall jj: Nat; less_than(jj, nn) ->
                              forall red: Poly; degreeAtMost(red, jj) ->
                              exists quo: Poly; exists rem: Poly;
                              red = addP(mulP(gg, quo), rem) and
                              (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                              exists quo: Poly; exists rem: Poly;
                              ff = addP(mulP(gg, quo), rem) and
                              (rem = ZEROP or less_than(degree(rem), degree(gg)))
                            [by discharge given-ff-bounded]
                        }
                      @d2 |
                        (not (gg = ZEROP)) -> degreeAtMost(ff, nn) -> degree(ff) = succ(dd) ->
                          peano_order.less_or_equal(degree(gg), degree(ff)) ->
                          (forall jj: Nat; less_than(jj, nn) ->
                          forall red: Poly; degreeAtMost(red, jj) ->
                          exists quo: Poly; exists rem: Poly;
                          red = addP(mulP(gg, quo), rem) and
                          (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                          exists quo: Poly; exists rem: Poly;
                          ff = addP(mulP(gg, quo), rem) and
                          (rem = ZEROP or less_than(degree(rem), degree(gg)))
                        [by discharge given-gg-nonzero]
                    }
                  @d1 |
                    (not (ff = ZEROP)) -> (not (gg = ZEROP)) -> degreeAtMost(ff, nn) ->
                      degree(ff) = succ(dd) ->
                      peano_order.less_or_equal(degree(gg), degree(ff)) ->
                      (forall jj: Nat; less_than(jj, nn) ->
                      forall red: Poly; degreeAtMost(red, jj) ->
                      exists quo: Poly; exists rem: Poly;
                      red = addP(mulP(gg, quo), rem) and
                      (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                      exists quo: Poly; exists rem: Poly;
                      ff = addP(mulP(gg, quo), rem) and
                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                    [by discharge given-ff-nonzero]
                }
              @gen-dd |
                forall d9: Nat;
                  (not (ff = ZEROP)) -> (not (gg = ZEROP)) -> degreeAtMost(ff, nn) ->
                  degree(ff) = succ(d9) ->
                  peano_order.less_or_equal(degree(gg), degree(ff)) ->
                  (forall jj: Nat; less_than(jj, nn) ->
                  forall red: Poly; degreeAtMost(red, jj) ->
                  exists quo: Poly; exists rem: Poly;
                  red = addP(mulP(gg, quo), rem) and
                  (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                  exists quo: Poly; exists rem: Poly;
                  ff = addP(mulP(gg, quo), rem) and
                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                [by generalize generalize-dd]
            }
          @gen-nn |
            forall n9, d9: Nat;
              (not (ff = ZEROP)) -> (not (gg = ZEROP)) -> degreeAtMost(ff, n9) ->
              degree(ff) = succ(d9) ->
              peano_order.less_or_equal(degree(gg), degree(ff)) ->
              (forall jj: Nat; less_than(jj, n9) ->
              forall red: Poly; degreeAtMost(red, jj) ->
              exists quo: Poly; exists rem: Poly;
              red = addP(mulP(gg, quo), rem) and
              (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
              exists quo: Poly; exists rem: Poly;
              ff = addP(mulP(gg, quo), rem) and
              (rem = ZEROP or less_than(degree(rem), degree(gg)))
            [by generalize generalize-nn]
        }
      @gen-gg |
        forall g9: Poly; forall n9, d9: Nat;
          (not (ff = ZEROP)) -> (not (g9 = ZEROP)) -> degreeAtMost(ff, n9) ->
          degree(ff) = succ(d9) ->
          peano_order.less_or_equal(degree(g9), degree(ff)) ->
          (forall jj: Nat; less_than(jj, n9) ->
          forall red: Poly; degreeAtMost(red, jj) ->
          exists quo: Poly; exists rem: Poly;
          red = addP(mulP(g9, quo), rem) and
          (rem = ZEROP or less_than(degree(rem), degree(g9)))) ->
          exists quo: Poly; exists rem: Poly;
          ff = addP(mulP(g9, quo), rem) and
          (rem = ZEROP or less_than(degree(rem), degree(g9)))
        [by generalize generalize-gg]
    }
  @conclusion |
    forall f9, g9: Poly; forall n9, d9: Nat;
      (not (f9 = ZEROP)) -> (not (g9 = ZEROP)) -> degreeAtMost(f9, n9) ->
      degree(f9) = succ(d9) ->
      peano_order.less_or_equal(degree(g9), degree(f9)) ->
      (forall jj: Nat; less_than(jj, n9) ->
      forall red: Poly; degreeAtMost(red, jj) ->
      exists quo: Poly; exists rem: Poly;
      red = addP(mulP(g9, quo), rem) and
      (rem = ZEROP or less_than(degree(rem), degree(g9)))) ->
      exists quo: Poly; exists rem: Poly;
      f9 = addP(mulP(g9, quo), rem) and
      (rem = ZEROP or less_than(degree(rem), degree(g9)))
    [by generalize generalize-ff]
qed

// -- EVALUATION, and what it means to be a ZERO -------------------------------------------
//
// Judson's factor theorem is stated in terms of a polynomial VANISHING at a point, so the
// evaluation map has to be here. `evalUpTo(p, a, k)` is `a_0 + a_1 a + ... + a_{k-1} a^{k-1}`,
// summed to a bound exactly as the convolution is; `p(a)` is then the sum to one past the
// degree, which is the first bound that reaches every nonzero coefficient.
func power(a: F, n: Nat) => F
axiom powerZero: forall a: F; power(a, ZERO) = oneF
axiom powerSucc: forall a: F; forall n: Nat; power(a, succ(n)) = mulF(a, power(a, n))

func evalUpTo(p: Poly, a: F, k: Nat) => F
axiom evalZero: forall p: Poly; forall a: F; evalUpTo(p, a, ZERO) = zeroF
axiom evalSucc: forall p: Poly; forall a: F; forall k: Nat;
  evalUpTo(p, a, succ(k)) = addF(evalUpTo(p, a, k), mulF(coeff(p, k), power(a, k)))

// `evaluate(p, a)` is Judson's `p(a)`: the sum over every index up to and including the
// degree. A bound of `succ(degree(p))` is what makes "up to" inclusive.
define evaluate(p, a) = evalUpTo(p, a, succ(degree(p)))

// `a` is a ZERO of `p` when `p` vanishes there.
pred isZeroOf(a: F, p: Poly)
axiom isZeroOfMeaning: forall a: F; forall p: Poly;
  isZeroOf(a, p) iff evaluate(p, a) = zeroF

// Evaluating the zero polynomial gives zero, at any bound: every term carries a zero
// coefficient. Needed for the converse direction of the factor theorem.
theorem theZeroPolynomialVanishesEverywhere: forall a: F; forall k: Nat;
  evalUpTo(ZEROP, a, k) = zeroF
proof
  @generalize-a |
    fix a: F {
      @base-case |
        evalUpTo(ZEROP, a, ZERO) = zeroF
        [using specialize evalZero(ZEROP, a)]
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume evalUpTo(ZEROP, a, k) = zeroF {
              @inductive-hypothesis |
                evalUpTo(ZEROP, a, k) = zeroF
                [by hypothesis given-inductive-hypothesis]
              @one-more-term |
                evalUpTo(ZEROP, a, succ(k)) =
                  addF(evalUpTo(ZEROP, a, k), mulF(coeff(ZEROP, k), power(a, k)))
                [using specialize evalSucc(ZEROP, a, k)]
              @the-coefficient-vanishes |
                coeff(ZEROP, k) = zeroF
                [using specialize zeroPolyCoeff(k)]
              @the-new-term-is-zero |
                mulF(zeroF, power(a, k)) = zeroF
                [using specialize field.mulZeroLeft(power(a, k))]
              @the-sum-is-zero-plus-zero |
                evalUpTo(ZEROP, a, succ(k)) = addF(zeroF, zeroF)
                [using simplify one-more-term the-coefficient-vanishes the-new-term-is-zero inductive-hypothesis]
              @zero-plus-zero |
                addF(zeroF, zeroF) = zeroF
                [using specialize addZeroLeftF(zeroF)]
              @conclusion-successor |
                evalUpTo(ZEROP, a, succ(k)) = zeroF
                [using chain the-sum-is-zero-plus-zero zero-plus-zero]
            }
          @induction-step-at-k |
            evalUpTo(ZEROP, a, k) = zeroF -> evalUpTo(ZEROP, a, succ(k)) = zeroF
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          evalUpTo(ZEROP, a, k) = zeroF -> evalUpTo(ZEROP, a, succ(k)) = zeroF
        [by generalize induction-step]
      @conclusion-for-all-k |
        forall k: Nat; evalUpTo(ZEROP, a, k) = zeroF
        [using instantiation peano.induction((fun k: Nat => evalUpTo(ZEROP, a, k) = zeroF)) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall a: F; forall k: Nat; evalUpTo(ZEROP, a, k) = zeroF
    [by generalize generalize-a]
qed

// Evaluating a product at `a` where the FIRST factor vanishes gives zero. This is the
// converse direction of Judson's factor theorem in its essential form: "suppose that
// x - alpha is a factor of p(x); say p(x) = (x - alpha) q(x). Then p(alpha) = 0·q(alpha) = 0."
//
// Stated about a polynomial that IS the zero polynomial times anything, since that is what
// the division algorithm hands back when the remainder vanishes.
theorem theZeroPolynomialIsAZeroOfItself: forall a: F;
  isZeroOf(a, ZEROP)
proof
  @generalize-a |
    fix a: F {
      @the-evaluation-vanishes |
        evalUpTo(ZEROP, a, succ(degree(ZEROP))) = zeroF
        [using specialize theZeroPolynomialVanishesEverywhere(a, succ(degree(ZEROP)))]
      @what-being-a-zero-means |
        isZeroOf(a, ZEROP) iff evaluate(ZEROP, a) = zeroF
        [using specialize isZeroOfMeaning(a, ZEROP)]
      @conclusion-the-zero-polynomial |
        isZeroOf(a, ZEROP)
        [using tautology the-evaluation-vanishes what-being-a-zero-means]
    }
  @conclusion |
    forall a: F; isZeroOf(a, ZEROP)
    [by generalize generalize-a]
qed

// `a^0 = 1` and `a^(n+1) = a·a^n` make the one-term evaluation `p(a) = a_0` for a CONSTANT
// polynomial, which is the step Judson uses to read off `r(x) = a` from the division.
theorem aConstantEvaluatesToItsCoefficient: forall p: Poly; forall a: F;
  evalUpTo(p, a, succ(ZERO)) = coeff(p, ZERO)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-a |
        fix a: F {
          @the-one-term-sum |
            evalUpTo(p, a, succ(ZERO)) =
              addF(evalUpTo(p, a, ZERO), mulF(coeff(p, ZERO), power(a, ZERO)))
            [using specialize evalSucc(p, a, ZERO)]
          @the-empty-sum |
            evalUpTo(p, a, ZERO) = zeroF
            [using specialize evalZero(p, a)]
          @the-zeroth-power |
            power(a, ZERO) = oneF
            [using specialize powerZero(a)]
          @times-one |
            mulF(coeff(p, ZERO), oneF) = coeff(p, ZERO)
            [using specialize field.mulOneRight(coeff(p, ZERO))]
          @the-sum-is-zero-plus-the-coefficient |
            evalUpTo(p, a, succ(ZERO)) = addF(zeroF, coeff(p, ZERO))
            [using simplify the-one-term-sum the-empty-sum the-zeroth-power times-one]
          @zero-plus-the-coefficient |
            addF(zeroF, coeff(p, ZERO)) = coeff(p, ZERO)
            [using specialize addZeroLeftF(coeff(p, ZERO))]
          @conclusion-the-constant-evaluation |
            evalUpTo(p, a, succ(ZERO)) = coeff(p, ZERO)
            [using chain the-sum-is-zero-plus-the-coefficient zero-plus-the-coefficient]
        }
      @discharge-a |
        forall a: F; evalUpTo(p, a, succ(ZERO)) = coeff(p, ZERO)
        [by generalize generalize-a]
    }
  @conclusion |
    forall p: Poly; forall a: F; evalUpTo(p, a, succ(ZERO)) = coeff(p, ZERO)
    [by generalize generalize-p]
qed

// The successor power law in use: `a^(n+1) = a · a^n`, exercised by a simple consequence —
// `a^1 = a`.
theorem theFirstPowerIsTheBase: forall a: F; power(a, succ(ZERO)) = a
proof
  @generalize-a |
    fix a: F {
      @the-successor-power |
        power(a, succ(ZERO)) = mulF(a, power(a, ZERO))
        [using specialize powerSucc(a, ZERO)]
      @the-zeroth-power |
        power(a, ZERO) = oneF
        [using specialize powerZero(a)]
      @the-power-is-a-times-one |
        power(a, succ(ZERO)) = mulF(a, oneF)
        [using simplify the-successor-power the-zeroth-power]
      @times-one |
        mulF(a, oneF) = a
        [using specialize field.mulOneRight(a)]
      @conclusion-the-first-power |
        power(a, succ(ZERO)) = a
        [using chain the-power-is-a-times-one times-one]
    }
  @conclusion |
    forall a: F; power(a, succ(ZERO)) = a
    [by generalize generalize-a]
qed

// -- THE LINEAR POLYNOMIAL x - alpha ------------------------------------------------------
//
// The divisor in Judson's factor theorem. Built from the pieces already here: `x` is the
// monomial `1·x^1`, `alpha` the constant `alpha·x^0`, and the difference is `subP`.
define linear(alpha) = subP(monomial(oneF, succ(ZERO)), monomial(alpha, ZERO))

// Its coefficient at index 1 is `1`, and above index 1 everything vanishes — the two facts
// that pin its degree. Both read straight off the monomials' coefficient equations.
theorem theLinearPolynomialLeadsWithOne: forall alpha: F;
  coeff(linear(alpha), succ(ZERO)) = oneF
proof
  @generalize-alpha |
    fix alpha: F {
      @the-difference-coefficient |
        coeff(linear(alpha), succ(ZERO)) =
          addF(coeff(monomial(oneF, succ(ZERO)), succ(ZERO)),
          negF(coeff(monomial(alpha, ZERO), succ(ZERO))))
        [using specialize subPolyCoeff(monomial(oneF, succ(ZERO)), monomial(alpha, ZERO), succ(ZERO))]
      @the-leading-monomial |
        coeff(monomial(oneF, succ(ZERO)), succ(ZERO)) = oneF
        [using specialize monomialCoeffAtItsIndex(oneF, succ(ZERO))]
      @one-differs-from-zero-index |
        succ(ZERO) != ZERO
        [using specialize peano.succNotZero(ZERO)]
      @the-constant-monomial-vanishes-here |
        coeff(monomial(alpha, ZERO), succ(ZERO)) = zeroF
        [using specialize monomialCoeffElsewhere(alpha, ZERO, succ(ZERO)) one-differs-from-zero-index]
      @negating-zero |
        negF(zeroF) = zeroF
        [by cite field.negZero]
      @the-coefficient-is-one-plus-zero |
        coeff(linear(alpha), succ(ZERO)) = addF(oneF, zeroF)
        [using simplify the-difference-coefficient the-leading-monomial the-constant-monomial-vanishes-here negating-zero]
      @one-plus-zero |
        addF(oneF, zeroF) = oneF
        [using specialize field.addZeroRight(oneF)]
      @conclusion-leads-with-one |
        coeff(linear(alpha), succ(ZERO)) = oneF
        [using chain the-coefficient-is-one-plus-zero one-plus-zero]
    }
  @conclusion |
    forall alpha: F; coeff(linear(alpha), succ(ZERO)) = oneF
    [by generalize generalize-alpha]
qed

// Above index 1 it vanishes: both monomials do.
theorem theLinearPolynomialVanishesAboveOne: forall alpha: F;
  degreeAtMost(linear(alpha), succ(ZERO))
proof
  @generalize-alpha |
    fix alpha: F {
      @generalize-index |
        fix i: Nat {
          @given-above-one |
            assume less_than(succ(ZERO), i) {
              @above-one |
                less_than(succ(ZERO), i)
                [by hypothesis given-above-one]
              @i-differs-from-one |
                succ(ZERO) != i
                [using specialize peano_order.lessThanIsStrict(succ(ZERO), i) above-one]
              @i-differs-from-one-flipped |
                i != succ(ZERO)
                [using specialize peano_order.natDisequalityIsSymmetric(succ(ZERO), i) i-differs-from-one]
              @the-leading-monomial-vanishes |
                coeff(monomial(oneF, succ(ZERO)), i) = zeroF
                [using specialize monomialCoeffElsewhere(oneF, succ(ZERO), i) i-differs-from-one-flipped]
              // i > 1 > 0 so i != 0
              @one-is-below-i |
                less_than(ZERO, succ(ZERO))
                [using specialize peano_order.lessThanSelf(ZERO)]
              @zero-is-below-i |
                less_than(ZERO, i)
                [using specialize peano_order.lessThanTransitive(ZERO, succ(ZERO), i) one-is-below-i above-one]
              @i-differs-from-zero |
                ZERO != i
                [using specialize peano_order.lessThanIsStrict(ZERO, i) zero-is-below-i]
              @i-differs-from-zero-flipped |
                i != ZERO
                [using specialize peano_order.natDisequalityIsSymmetric(ZERO, i) i-differs-from-zero]
              @the-constant-monomial-vanishes |
                coeff(monomial(alpha, ZERO), i) = zeroF
                [using specialize monomialCoeffElsewhere(alpha, ZERO, i) i-differs-from-zero-flipped]
              @the-difference-coefficient |
                coeff(linear(alpha), i) =
                  addF(coeff(monomial(oneF, succ(ZERO)), i),
                  negF(coeff(monomial(alpha, ZERO), i)))
                [using specialize subPolyCoeff(monomial(oneF, succ(ZERO)), monomial(alpha, ZERO), i)]
              @negating-zero |
                negF(zeroF) = zeroF
                [by cite field.negZero]
              @the-difference-of-zeros |
                coeff(linear(alpha), i) = addF(zeroF, zeroF)
                [using simplify the-difference-coefficient the-leading-monomial-vanishes the-constant-monomial-vanishes negating-zero]
              @zero-plus-zero |
                addF(zeroF, zeroF) = zeroF
                [using specialize addZeroLeftF(zeroF)]
              @the-coefficient-vanishes |
                coeff(linear(alpha), i) = zeroF
                [using chain the-difference-of-zeros zero-plus-zero]
            }
          @above-one-implies-vanishing |
            less_than(succ(ZERO), i) -> coeff(linear(alpha), i) = zeroF
            [by discharge given-above-one]
        }
      @vanishes-above-one |
        forall i: Nat; less_than(succ(ZERO), i) -> coeff(linear(alpha), i) = zeroF
        [by generalize generalize-index]
      @what-bounding-means |
        degreeAtMost(linear(alpha), succ(ZERO)) iff
          (forall i: Nat; less_than(succ(ZERO), i) -> coeff(linear(alpha), i) = zeroF)
        [using specialize degreeAtMostMeaning(linear(alpha), succ(ZERO))]
      @conclusion-bounded-by-one |
        degreeAtMost(linear(alpha), succ(ZERO))
        [using tautology vanishes-above-one what-bounding-means]
    }
  @conclusion |
    forall alpha: F; degreeAtMost(linear(alpha), succ(ZERO))
    [by generalize generalize-alpha]
qed

// `x - alpha` is nonzero and has degree exactly 1. The degree is what makes the factor
// theorem work: a remainder of degree below 1 is a CONSTANT, which is the step Judson takes
// when he writes "since the degree of r(x) is less than 1, r(x) = a for a in F".
theorem theLinearPolynomialIsNonzero: forall alpha: F;
  not (linear(alpha) = ZEROP)
proof
  @generalize-alpha |
    fix alpha: F {
      @leads-with-one |
        coeff(linear(alpha), succ(ZERO)) = oneF
        [using specialize theLinearPolynomialLeadsWithOne(alpha)]
      @one-is-not-zero |
        oneF != zeroF
        [by cite field.oneNotZero]
      @given-it-is-zero |
        assume linear(alpha) = ZEROP {
          @it-is-zero |
            linear(alpha) = ZEROP
            [by hypothesis given-it-is-zero]
          @the-zero-coefficient |
            coeff(ZEROP, succ(ZERO)) = zeroF
            [using specialize zeroPolyCoeff(succ(ZERO))]
          @its-coefficient-would-vanish |
            coeff(linear(alpha), succ(ZERO)) = zeroF
            [by rewrite it-is-zero the-zero-coefficient]
          @one-would-be-zero |
            oneF = zeroF
            [using chain leads-with-one-flipped its-coefficient-would-vanish]
          @leads-with-one-flipped |
            oneF = coeff(linear(alpha), succ(ZERO))
            [by symmetry leads-with-one]
          @contradiction |
            not (linear(alpha) = ZEROP)
            [by ex_falso one-would-be-zero one-is-not-zero]
        }
      @being-zero-is-absurd |
        linear(alpha) = ZEROP -> (not (linear(alpha) = ZEROP))
        [by discharge given-it-is-zero]
      @conclusion-nonzero |
        not (linear(alpha) = ZEROP)
        [using tautology being-zero-is-absurd]
    }
  @conclusion |
    forall alpha: F; not (linear(alpha) = ZEROP)
    [by generalize generalize-alpha]
qed

theorem theLinearPolynomialHasDegreeOne: forall alpha: F;
  degree(linear(alpha)) = succ(ZERO)
proof
  @generalize-alpha |
    fix alpha: F {
      @it-is-nonzero |
        not (linear(alpha) = ZEROP)
        [using specialize theLinearPolynomialIsNonzero(alpha)]
      @leads-with-one |
        coeff(linear(alpha), succ(ZERO)) = oneF
        [using specialize theLinearPolynomialLeadsWithOne(alpha)]
      @one-is-not-zero |
        oneF != zeroF
        [by cite field.oneNotZero]
      @the-leading-coefficient-is-nonzero |
        not (coeff(linear(alpha), succ(ZERO)) = zeroF)
        [by rewrite leads-with-one-flipped one-is-not-zero]
      @leads-with-one-flipped |
        oneF = coeff(linear(alpha), succ(ZERO))
        [by symmetry leads-with-one]
      @bounded-by-one |
        degreeAtMost(linear(alpha), succ(ZERO))
        [using specialize theLinearPolynomialVanishesAboveOne(alpha)]
      @one-is-the-degree |
        succ(ZERO) = degree(linear(alpha))
        [using specialize degreeIsUnique(linear(alpha), succ(ZERO)) it-is-nonzero the-leading-coefficient-is-nonzero bounded-by-one]
      @conclusion-degree-one |
        degree(linear(alpha)) = succ(ZERO)
        [by symmetry one-is-the-degree]
    }
  @conclusion |
    forall alpha: F; degree(linear(alpha)) = succ(ZERO)
    [by generalize generalize-alpha]
qed

// A remainder from dividing by `x - alpha` is a CONSTANT: either it is zero, or its degree
// is below 1, which for a ℕ degree means it IS zero. Either way the remainder is bounded by
// index 0 — Judson's "since the degree of r(x) is less than 1, r(x) = a for a in F".
theorem aRemainderBelowDegreeOneIsConstant: forall r: Poly; forall alpha: F;
  (r = ZEROP or less_than(degree(r), degree(linear(alpha)))) ->
  degreeAtMost(r, ZERO)
proof
  @generalize-r |
    fix r: Poly {
      @generalize-alpha |
        fix alpha: F {
          @given-the-remainder-condition |
            assume r = ZEROP or less_than(degree(r), degree(linear(alpha))) {
              @the-remainder-condition |
                r = ZEROP or less_than(degree(r), degree(linear(alpha)))
                [by hypothesis given-the-remainder-condition]

              @when-the-remainder-is-zero |
                assume r = ZEROP {
                  @the-remainder-is-zero |
                    r = ZEROP
                    [by hypothesis when-the-remainder-is-zero]
                  // the zero polynomial is bounded by every index
                  @generalize-index-zero-case |
                    fix i: Nat {
                      @given-above-zero-in-zero-case |
                        assume less_than(ZERO, i) {
                          @the-zero-coefficient |
                            coeff(ZEROP, i) = zeroF
                            [using specialize zeroPolyCoeff(i)]
                          @the-remainder-coefficient-vanishes |
                            coeff(r, i) = zeroF
                            [by rewrite the-remainder-is-zero-flipped the-zero-coefficient]
                          @the-remainder-is-zero-flipped |
                            ZEROP = r
                            [by symmetry the-remainder-is-zero]
                        }
                      @above-zero-implies-vanishing-in-zero-case |
                        less_than(ZERO, i) -> coeff(r, i) = zeroF
                        [by discharge given-above-zero-in-zero-case]
                    }
                  @vanishes-above-zero-in-zero-case |
                    forall i: Nat; less_than(ZERO, i) -> coeff(r, i) = zeroF
                    [by generalize generalize-index-zero-case]
                  @what-bounding-means-in-zero-case |
                    degreeAtMost(r, ZERO) iff
                      (forall i: Nat; less_than(ZERO, i) -> coeff(r, i) = zeroF)
                    [using specialize degreeAtMostMeaning(r, ZERO)]
                  @bounded-when-zero |
                    degreeAtMost(r, ZERO)
                    [using tautology vanishes-above-zero-in-zero-case what-bounding-means-in-zero-case]
                }

              @when-the-degree-is-below-one |
                assume less_than(degree(r), degree(linear(alpha))) {
                  @the-degree-is-below |
                    less_than(degree(r), degree(linear(alpha)))
                    [by hypothesis when-the-degree-is-below-one]
                  @the-divisor-degree |
                    degree(linear(alpha)) = succ(ZERO)
                    [using specialize theLinearPolynomialHasDegreeOne(alpha)]
                  @the-degree-is-below-one |
                    less_than(degree(r), succ(ZERO))
                    [by rewrite the-divisor-degree the-degree-is-below]
                  // deg r < 1 means deg r <= 0, i.e. deg r = ZERO
                  @the-degree-is-at-most-zero |
                    peano_order.less_or_equal(degree(r), ZERO)
                    [using specialize peano_order.lessThanSuccToLessOrEqual(degree(r), ZERO) the-degree-is-below-one]
                  @the-degree-splits |
                    less_than(degree(r), ZERO) or degree(r) = ZERO
                    [using specialize peano_order.lessOrEqualSplit(degree(r), ZERO) the-degree-is-at-most-zero]
                  @nothing-is-below-zero |
                    not less_than(degree(r), ZERO)
                    [using specialize peano_order.notLessThanZero(degree(r))]
                  @the-degree-is-zero |
                    degree(r) = ZERO
                    [using tautology the-degree-splits nothing-is-below-zero]
                  // a nonzero r is bounded by its own degree; a zero one by anything
                  @r-zero-or-not |
                    r = ZEROP or (not (r = ZEROP))
                    [using tautology]
                  @when-r-is-zero-here |
                    assume r = ZEROP {
                      @r-is-zero-here |
                        r = ZEROP
                        [by hypothesis when-r-is-zero-here]
                      @generalize-index-inner |
                        fix i: Nat {
                          @given-above-zero-inner |
                            assume less_than(ZERO, i) {
                              @the-zero-coefficient-inner |
                                coeff(ZEROP, i) = zeroF
                                [using specialize zeroPolyCoeff(i)]
                              @r-is-zero-flipped-inner |
                                ZEROP = r
                                [by symmetry r-is-zero-here]
                              @the-coefficient-vanishes-inner |
                                coeff(r, i) = zeroF
                                [by rewrite r-is-zero-flipped-inner the-zero-coefficient-inner]
                            }
                          @above-implies-vanishing-inner |
                            less_than(ZERO, i) -> coeff(r, i) = zeroF
                            [by discharge given-above-zero-inner]
                        }
                      @vanishes-above-zero-inner |
                        forall i: Nat; less_than(ZERO, i) -> coeff(r, i) = zeroF
                        [by generalize generalize-index-inner]
                      @what-bounding-means-inner |
                        degreeAtMost(r, ZERO) iff
                          (forall i: Nat; less_than(ZERO, i) -> coeff(r, i) = zeroF)
                        [using specialize degreeAtMostMeaning(r, ZERO)]
                      @bounded-when-zero-inner |
                        degreeAtMost(r, ZERO)
                        [using tautology vanishes-above-zero-inner what-bounding-means-inner]
                    }
                  @when-r-is-nonzero-here |
                    assume not (r = ZEROP) {
                      @r-is-nonzero-here |
                        not (r = ZEROP)
                        [by hypothesis when-r-is-nonzero-here]
                      @bounded-by-its-degree |
                        degreeAtMost(r, degree(r))
                        [using specialize degreeBoundsTheCoefficients(r) r-is-nonzero-here]
                      @bounded-when-nonzero |
                        degreeAtMost(r, ZERO)
                        [by rewrite the-degree-is-zero bounded-by-its-degree]
                    }
                  @bounded-when-below-one |
                    degreeAtMost(r, ZERO)
                    [by common_conclusion r-zero-or-not when-r-is-zero-here when-r-is-nonzero-here]
                }

              @conclusion-the-remainder-is-constant |
                degreeAtMost(r, ZERO)
                [by common_conclusion the-remainder-condition when-the-remainder-is-zero when-the-degree-is-below-one]
            }
          @the-condition-implies-constant |
            (r = ZEROP or less_than(degree(r), degree(linear(alpha)))) ->
              degreeAtMost(r, ZERO)
            [by discharge given-the-remainder-condition]
        }
      @discharge-alpha |
        forall alpha: F;
          (r = ZEROP or less_than(degree(r), degree(linear(alpha)))) ->
          degreeAtMost(r, ZERO)
        [by generalize generalize-alpha]
    }
  @conclusion |
    forall r: Poly; forall alpha: F;
      (r = ZEROP or less_than(degree(r), degree(linear(alpha)))) ->
      degreeAtMost(r, ZERO)
    [by generalize generalize-r]
qed

// Its constant coefficient is `-alpha`.
theorem theLinearPolynomialHasNegatedConstantTerm: forall alpha: F;
  coeff(linear(alpha), ZERO) = negF(alpha)
proof
  @generalize-alpha |
    fix alpha: F {
      @the-difference-coefficient |
        coeff(linear(alpha), ZERO) =
          addF(coeff(monomial(oneF, succ(ZERO)), ZERO), negF(coeff(monomial(alpha, ZERO), ZERO)))
        [using specialize subPolyCoeff(monomial(oneF, succ(ZERO)), monomial(alpha, ZERO), ZERO)]
      @zero-differs-from-one |
        ZERO != succ(ZERO)
        [using specialize peano_order.lessThanIsStrict(ZERO, succ(ZERO)) zero-is-below-one]
      @zero-is-below-one |
        less_than(ZERO, succ(ZERO))
        [using specialize peano_order.lessThanSelf(ZERO)]
      @the-leading-monomial-vanishes-at-zero |
        coeff(monomial(oneF, succ(ZERO)), ZERO) = zeroF
        [using specialize monomialCoeffElsewhere(oneF, succ(ZERO), ZERO) zero-differs-from-one]
      @the-constant-monomial |
        coeff(monomial(alpha, ZERO), ZERO) = alpha
        [using specialize monomialCoeffAtItsIndex(alpha, ZERO)]
      @the-coefficient-is-zero-plus-negated |
        coeff(linear(alpha), ZERO) = addF(zeroF, negF(alpha))
        [using simplify the-difference-coefficient the-leading-monomial-vanishes-at-zero the-constant-monomial]
      @zero-plus-negated |
        addF(zeroF, negF(alpha)) = negF(alpha)
        [using specialize addZeroLeftF(negF(alpha))]
      @conclusion-the-constant-term |
        coeff(linear(alpha), ZERO) = negF(alpha)
        [using chain the-coefficient-is-zero-plus-negated zero-plus-negated]
    }
  @conclusion |
    forall alpha: F; coeff(linear(alpha), ZERO) = negF(alpha)
    [by generalize generalize-alpha]
qed

// ALPHA IS A ZERO OF x - alpha. Judson uses this implicitly on both sides of the factor
// theorem; it is the only concrete evaluation either direction needs.
//
//   (x - alpha)(alpha) = (0 + (-alpha)·alpha^0) + 1·alpha^1 = -alpha + alpha = 0
theorem theRootOfTheLinearPolynomial: forall alpha: F;
  isZeroOf(alpha, linear(alpha))
proof
  @generalize-alpha |
    fix alpha: F {
      @the-degree |
        degree(linear(alpha)) = succ(ZERO)
        [using specialize theLinearPolynomialHasDegreeOne(alpha)]

      // sum to bound 2: the index-0 term, then the index-1 term
      @the-two-term-sum |
        evalUpTo(linear(alpha), alpha, succ(succ(ZERO))) =
          addF(evalUpTo(linear(alpha), alpha, succ(ZERO)),
          mulF(coeff(linear(alpha), succ(ZERO)), power(alpha, succ(ZERO))))
        [using specialize evalSucc(linear(alpha), alpha, succ(ZERO))]
      @the-one-term-sum |
        evalUpTo(linear(alpha), alpha, succ(ZERO)) = coeff(linear(alpha), ZERO)
        [using specialize aConstantEvaluatesToItsCoefficient(linear(alpha), alpha)]
      @the-constant-term |
        coeff(linear(alpha), ZERO) = negF(alpha)
        [using specialize theLinearPolynomialHasNegatedConstantTerm(alpha)]
      @the-leading-term |
        coeff(linear(alpha), succ(ZERO)) = oneF
        [using specialize theLinearPolynomialLeadsWithOne(alpha)]
      @the-first-power |
        power(alpha, succ(ZERO)) = alpha
        [using specialize theFirstPowerIsTheBase(alpha)]
      @one-times-alpha |
        mulF(oneF, alpha) = alpha
        [using specialize mulOneLeftF(alpha)]
      @the-sum-is-a-cancelling-pair |
        evalUpTo(linear(alpha), alpha, succ(succ(ZERO))) = addF(negF(alpha), alpha)
        [using simplify the-two-term-sum the-one-term-sum the-constant-term the-leading-term the-first-power one-times-alpha]
      @the-pair-cancels |
        addF(negF(alpha), alpha) = zeroF
        [using specialize addNegLeftF(alpha)]
      @the-evaluation-at-bound-two |
        evalUpTo(linear(alpha), alpha, succ(succ(ZERO))) = zeroF
        [using chain the-sum-is-a-cancelling-pair the-pair-cancels]

      // and that bound IS succ(degree), so it is `evaluate`
      @the-evaluation-vanishes |
        evalUpTo(linear(alpha), alpha, succ(degree(linear(alpha)))) = zeroF
        [by rewrite the-degree-flipped the-evaluation-at-bound-two]
      @the-degree-flipped |
        succ(ZERO) = degree(linear(alpha))
        [by symmetry the-degree]
      @what-being-a-zero-means |
        isZeroOf(alpha, linear(alpha)) iff evaluate(linear(alpha), alpha) = zeroF
        [using specialize isZeroOfMeaning(alpha, linear(alpha))]
      @conclusion-alpha-is-a-root |
        isZeroOf(alpha, linear(alpha))
        [using tautology the-evaluation-vanishes what-being-a-zero-means]
    }
  @conclusion |
    forall alpha: F; isZeroOf(alpha, linear(alpha))
    [by generalize generalize-alpha]
qed

// -- THE PRODUCT WITH x - alpha, COEFFICIENTWISE ------------------------------------------
//
// The factor theorem's forward direction needs `(x - alpha)·q` evaluated AT alpha. The
// general evaluation homomorphism would give it, but its multiplicative half rests on the
// double-sum reindexing that also blocks associativity. This specific case does NOT need
// that: `x - alpha` has only TWO nonzero coefficients, so its convolution collapses to two
// terms, and the resulting sum telescopes.
//
// STEP 1: the convolution against linear(al) at index succ(i), summed to the full limit,
// collapses to two terms. Build it from the convolution's own recursion.
// convolution(linear, q, i, k) for k >= 1 is:
//   base j=0:  coeff(linear,0) * q_i       = neg(al) * q_i
//   j=1:       coeff(linear,1) * q_{i-1}   = oneF * q_{i-1}
//   j>=2:      coeff(linear,j) = 0         -> contributes nothing
theorem theLinearConvolutionAtOne: forall q: Poly; forall al: F; forall i: Nat;
  convolution(linear(al), q, i, succ(ZERO)) =
  addF(mulF(negF(al), coeff(q, i)), coeff(q, subN(i, succ(ZERO))))
proof
  @generalize-q |
    fix q: Poly {
      @generalize-al |
        fix al: F {
          @generalize-i |
            fix i: Nat {
              @the-step |
                convolution(linear(al), q, i, succ(ZERO)) =
                  addF(convolution(linear(al), q, i, ZERO),
                  mulF(coeff(linear(al), succ(ZERO)), coeff(q, subN(i, succ(ZERO)))))
                [using specialize convolutionSucc(linear(al), q, i, ZERO)]
              @the-base |
                convolution(linear(al), q, i, ZERO) =
                  mulF(coeff(linear(al), ZERO), coeff(q, i))
                [using specialize convolutionZero(linear(al), q, i)]
              @the-constant-term |
                coeff(linear(al), ZERO) = negF(al)
                [using specialize theLinearPolynomialHasNegatedConstantTerm(al)]
              @the-leading-term |
                coeff(linear(al), succ(ZERO)) = oneF
                [using specialize theLinearPolynomialLeadsWithOne(al)]
              @one-times |
                mulF(oneF, coeff(q, subN(i, succ(ZERO)))) = coeff(q, subN(i, succ(ZERO)))
                [using specialize mulOneLeftF(coeff(q, subN(i, succ(ZERO))))]
              @conclusion-two-terms |
                convolution(linear(al), q, i, succ(ZERO)) =
                  addF(mulF(negF(al), coeff(q, i)), coeff(q, subN(i, succ(ZERO))))
                [using simplify the-step the-base the-constant-term the-leading-term one-times]
            }
          @discharge-i |
            forall i: Nat;
              convolution(linear(al), q, i, succ(ZERO)) =
              addF(mulF(negF(al), coeff(q, i)), coeff(q, subN(i, succ(ZERO))))
            [by generalize generalize-i]
        }
      @discharge-al |
        forall al: F; forall i: Nat;
          convolution(linear(al), q, i, succ(ZERO)) =
          addF(mulF(negF(al), coeff(q, i)), coeff(q, subN(i, succ(ZERO))))
        [by generalize generalize-al]
    }
  @conclusion |
    forall q: Poly; forall al: F; forall i: Nat;
      convolution(linear(al), q, i, succ(ZERO)) =
      addF(mulF(negF(al), coeff(q, i)), coeff(q, subN(i, succ(ZERO))))
    [by generalize generalize-q]
qed

// STEP 2: above limit 1 the convolution against linear(al) stabilizes — every further term
// carries a vanishing coefficient of linear(al).
theorem theLinearConvolutionStabilizes: forall q: Poly; forall al: F; forall i, t: Nat;
  convolution(linear(al), q, i, peano.add(succ(ZERO), t)) =
  convolution(linear(al), q, i, succ(ZERO))
proof
  @generalize-q |
    fix q: Poly {
      @generalize-al |
        fix al: F {
          @generalize-i |
            fix i: Nat {
              @adding-zero |
                peano.add(succ(ZERO), ZERO) = succ(ZERO)
                [using specialize peano.addZeroRight(succ(ZERO))]
              @the-sum-is-itself |
                convolution(linear(al), q, i, succ(ZERO)) =
                  convolution(linear(al), q, i, succ(ZERO))
                [by reflexivity]
              @base-case |
                convolution(linear(al), q, i, peano.add(succ(ZERO), ZERO)) =
                  convolution(linear(al), q, i, succ(ZERO))
                [by rewrite adding-zero the-sum-is-itself]
              @induction-step |
                fix t: Nat {
                  @given-inductive-hypothesis |
                    assume convolution(linear(al), q, i, peano.add(succ(ZERO), t)) =
                      convolution(linear(al), q, i, succ(ZERO)) {
                      @inductive-hypothesis |
                        convolution(linear(al), q, i, peano.add(succ(ZERO), t)) =
                          convolution(linear(al), q, i, succ(ZERO))
                        [by hypothesis given-inductive-hypothesis]
                      @the-next-limit |
                        peano.add(succ(ZERO), succ(t)) = succ(peano.add(succ(ZERO), t))
                        [using specialize peano.addSuccRight(succ(ZERO), t)]
                      @one-more-term |
                        convolution(linear(al), q, i, succ(peano.add(succ(ZERO), t))) =
                          addF(convolution(linear(al), q, i, peano.add(succ(ZERO), t)),
                          mulF(coeff(linear(al), succ(peano.add(succ(ZERO), t))),
                          coeff(q, subN(i, succ(peano.add(succ(ZERO), t))))))
                        [using specialize convolutionSucc(linear(al), q, i, peano.add(succ(ZERO), t))]
                      // succ(1+t) is above 1, so linear's coefficient there vanishes
                      // 1 <= 1+t (t is the gap), so 1 < succ(1+t). NOT `arithmetic`: that
                      // decision is sort-agnostic and reads t as possibly negative.
                      @the-gap-exists |
                        exists dd: Nat; peano.add(succ(ZERO), dd) = peano.add(succ(ZERO), t)
                        [by witness(t) the-sum-is-reflexive]
                      @the-sum-is-reflexive |
                        peano.add(succ(ZERO), t) = peano.add(succ(ZERO), t)
                        [by reflexivity]
                      @what-a-bound-means |
                        peano_order.less_or_equal(succ(ZERO), peano.add(succ(ZERO), t)) iff
                          (exists dd: Nat; peano.add(succ(ZERO), dd) = peano.add(succ(ZERO), t))
                        [using specialize peano_order.lessOrEqualIsGapExistential(succ(ZERO), peano.add(succ(ZERO), t))]
                      @one-is-bounded-by-the-sum |
                        peano_order.less_or_equal(succ(ZERO), peano.add(succ(ZERO), t))
                        [using tautology the-gap-exists what-a-bound-means]
                      @one-is-below-the-next |
                        less_than(succ(ZERO), succ(peano.add(succ(ZERO), t)))
                        [using specialize peano_order.lessOrEqualToLessThanSucc(succ(ZERO), peano.add(succ(ZERO), t)) one-is-bounded-by-the-sum]
                      @the-coefficient-vanishes |
                        coeff(linear(al), succ(peano.add(succ(ZERO), t))) = zeroF
                        [using tautology the-bound-gives-vanishing one-is-below-the-next]
                      @the-bound |
                        degreeAtMost(linear(al), succ(ZERO))
                        [using specialize theLinearPolynomialVanishesAboveOne(al)]
                      @what-the-bound-means |
                        degreeAtMost(linear(al), succ(ZERO)) iff
                          (forall j: Nat; less_than(succ(ZERO), j) ->
                          coeff(linear(al), j) = zeroF)
                        [using specialize degreeAtMostMeaning(linear(al), succ(ZERO))]
                      @vanishes-above-one |
                        forall j: Nat; less_than(succ(ZERO), j) ->
                          coeff(linear(al), j) = zeroF
                        [using tautology the-bound what-the-bound-means]
                      @the-bound-gives-vanishing |
                        less_than(succ(ZERO), succ(peano.add(succ(ZERO), t))) ->
                          coeff(linear(al), succ(peano.add(succ(ZERO), t))) = zeroF
                        [using specialize vanishes-above-one(succ(peano.add(succ(ZERO), t)))]
                      @the-new-term-is-zero |
                        mulF(zeroF, coeff(q, subN(i, succ(peano.add(succ(ZERO), t))))) = zeroF
                        [using specialize field.mulZeroLeft(coeff(q, subN(i, succ(peano.add(succ(ZERO), t)))))]
                      @the-sum-gains-zero |
                        convolution(linear(al), q, i, succ(peano.add(succ(ZERO), t))) =
                          addF(convolution(linear(al), q, i, succ(ZERO)), zeroF)
                        [using simplify one-more-term the-coefficient-vanishes the-new-term-is-zero inductive-hypothesis]
                      @adding-zero-changes-nothing |
                        addF(convolution(linear(al), q, i, succ(ZERO)), zeroF) =
                          convolution(linear(al), q, i, succ(ZERO))
                        [using specialize field.addZeroRight(convolution(linear(al), q, i, succ(ZERO)))]
                      @the-value-at-the-next |
                        convolution(linear(al), q, i, succ(peano.add(succ(ZERO), t))) =
                          convolution(linear(al), q, i, succ(ZERO))
                        [using chain the-sum-gains-zero adding-zero-changes-nothing]
                      @conclusion-successor |
                        convolution(linear(al), q, i, peano.add(succ(ZERO), succ(t))) =
                          convolution(linear(al), q, i, succ(ZERO))
                        [by rewrite the-next-limit the-value-at-the-next]
                    }
                  @induction-step-at-t |
                    (convolution(linear(al), q, i, peano.add(succ(ZERO), t)) =
                      convolution(linear(al), q, i, succ(ZERO))) ->
                      (convolution(linear(al), q, i, peano.add(succ(ZERO), succ(t))) =
                      convolution(linear(al), q, i, succ(ZERO)))
                    [by discharge given-inductive-hypothesis]
                }
              @induction-step-for-all-t |
                forall t: Nat;
                  (convolution(linear(al), q, i, peano.add(succ(ZERO), t)) =
                  convolution(linear(al), q, i, succ(ZERO))) ->
                  (convolution(linear(al), q, i, peano.add(succ(ZERO), succ(t))) =
                  convolution(linear(al), q, i, succ(ZERO)))
                [by generalize induction-step]
              @conclusion-for-all-t |
                forall t: Nat;
                  convolution(linear(al), q, i, peano.add(succ(ZERO), t)) =
                  convolution(linear(al), q, i, succ(ZERO))
                [using instantiation peano.induction((fun t: Nat => convolution(linear(al), q, i, peano.add(succ(ZERO), t)) = convolution(linear(al), q, i, succ(ZERO)))) base-case induction-step-for-all-t]
            }
          @discharge-i |
            forall i, t: Nat;
              convolution(linear(al), q, i, peano.add(succ(ZERO), t)) =
              convolution(linear(al), q, i, succ(ZERO))
            [by generalize generalize-i]
        }
      @discharge-al |
        forall al: F; forall i, t: Nat;
          convolution(linear(al), q, i, peano.add(succ(ZERO), t)) =
          convolution(linear(al), q, i, succ(ZERO))
        [by generalize generalize-al]
    }
  @conclusion |
    forall q: Poly; forall al: F; forall i, t: Nat;
      convolution(linear(al), q, i, peano.add(succ(ZERO), t)) =
      convolution(linear(al), q, i, succ(ZERO))
    [by generalize generalize-q]
qed

// one plus m is succ(m) -- the index bridge the stabilization needs
theorem onePlusIsSucc: forall m: Nat; peano.add(succ(ZERO), m) = succ(m)
proof
  @generalize-m |
    fix m: Nat {
      @the-successor-moves-out |
        peano.add(succ(ZERO), m) = succ(peano.add(ZERO, m))
        [using specialize peano.addSuccLeft(ZERO, m)]
      @zero-on-the-left |
        peano.add(ZERO, m) = m
        [using specialize peano.addZeroLeft(m)]
      @conclusion-one-plus |
        peano.add(succ(ZERO), m) = succ(m)
        [using simplify the-successor-moves-out zero-on-the-left]
    }
  @conclusion |
    forall m: Nat; peano.add(succ(ZERO), m) = succ(m)
    [by generalize generalize-m]
qed

// THE PRODUCT'S COEFFICIENT at a successor index: -al*q_{succ m} + q_m.
theorem theProductCoefficientAtSucc: forall q: Poly; forall al: F; forall m: Nat;
  coeff(mulP(linear(al), q), succ(m)) =
  addF(mulF(negF(al), coeff(q, succ(m))), coeff(q, m))
proof
  @generalize-q |
    fix q: Poly {
      @generalize-al |
        fix al: F {
          @generalize-m |
            fix m: Nat {
              @the-coefficient-is-the-convolution |
                coeff(mulP(linear(al), q), succ(m)) =
                  convolution(linear(al), q, succ(m), succ(m))
                [using specialize mulPolyCoeff(linear(al), q, succ(m))]
              @the-index-bridge |
                peano.add(succ(ZERO), m) = succ(m)
                [using specialize onePlusIsSucc(m)]
              @stabilizes-from-the-sum |
                convolution(linear(al), q, succ(m), peano.add(succ(ZERO), m)) =
                  convolution(linear(al), q, succ(m), succ(ZERO))
                [using specialize theLinearConvolutionStabilizes(q, al, succ(m), m)]
              @stabilizes-at-succ |
                convolution(linear(al), q, succ(m), succ(m)) =
                  convolution(linear(al), q, succ(m), succ(ZERO))
                [by rewrite the-index-bridge stabilizes-from-the-sum]
              @the-two-terms |
                convolution(linear(al), q, succ(m), succ(ZERO)) =
                  addF(mulF(negF(al), coeff(q, succ(m))),
                  coeff(q, subN(succ(m), succ(ZERO))))
                [using specialize theLinearConvolutionAtOne(q, al, succ(m))]
              @the-shift-strips |
                subN(succ(m), succ(ZERO)) = subN(m, ZERO)
                [using specialize subtraction.subSuccSucc(m, ZERO)]
              @the-shift-at-zero |
                subN(m, ZERO) = m
                [using specialize subtraction.subZeroRight(m)]
              @the-shift |
                subN(succ(m), succ(ZERO)) = m
                [using chain the-shift-strips the-shift-at-zero]
              @the-two-terms-shifted |
                convolution(linear(al), q, succ(m), succ(ZERO)) =
                  addF(mulF(negF(al), coeff(q, succ(m))), coeff(q, m))
                [using simplify the-two-terms the-shift the-shift-at-zero]
              @conclusion-the-coefficient |
                coeff(mulP(linear(al), q), succ(m)) =
                  addF(mulF(negF(al), coeff(q, succ(m))), coeff(q, m))
                [using chain the-coefficient-is-the-convolution stabilizes-at-succ the-two-terms-shifted]
            }
          @discharge-m |
            forall m: Nat;
              coeff(mulP(linear(al), q), succ(m)) =
              addF(mulF(negF(al), coeff(q, succ(m))), coeff(q, m))
            [by generalize generalize-m]
        }
      @discharge-al |
        forall al: F; forall m: Nat;
          coeff(mulP(linear(al), q), succ(m)) =
          addF(mulF(negF(al), coeff(q, succ(m))), coeff(q, m))
        [by generalize generalize-al]
    }
  @conclusion |
    forall q: Poly; forall al: F; forall m: Nat;
      coeff(mulP(linear(al), q), succ(m)) =
      addF(mulF(negF(al), coeff(q, succ(m))), coeff(q, m))
    [by generalize generalize-q]
qed

// and at index ZERO: just -al*q_0
theorem theProductCoefficientAtZero: forall q: Poly; forall al: F;
  coeff(mulP(linear(al), q), ZERO) = mulF(negF(al), coeff(q, ZERO))
proof
  @generalize-q |
    fix q: Poly {
      @generalize-al |
        fix al: F {
          @the-coefficient-is-the-convolution |
            coeff(mulP(linear(al), q), ZERO) =
              convolution(linear(al), q, ZERO, ZERO)
            [using specialize mulPolyCoeff(linear(al), q, ZERO)]
          @the-base |
            convolution(linear(al), q, ZERO, ZERO) =
              mulF(coeff(linear(al), ZERO), coeff(q, ZERO))
            [using specialize convolutionZero(linear(al), q, ZERO)]
          @the-constant-term |
            coeff(linear(al), ZERO) = negF(al)
            [using specialize theLinearPolynomialHasNegatedConstantTerm(al)]
          @the-base-negated |
            convolution(linear(al), q, ZERO, ZERO) = mulF(negF(al), coeff(q, ZERO))
            [using simplify the-base the-constant-term]
          @conclusion-at-zero |
            coeff(mulP(linear(al), q), ZERO) = mulF(negF(al), coeff(q, ZERO))
            [using chain the-coefficient-is-the-convolution the-base-negated]
        }
      @discharge-al |
        forall al: F; coeff(mulP(linear(al), q), ZERO) = mulF(negF(al), coeff(q, ZERO))
        [by generalize generalize-al]
    }
  @conclusion |
    forall q: Poly; forall al: F;
      coeff(mulP(linear(al), q), ZERO) = mulF(negF(al), coeff(q, ZERO))
    [by generalize generalize-q]
qed

// THE TELESCOPING INVARIANT. Summing (x-alpha)q's terms to limit succ(m) leaves exactly
// -alpha^(m+1) * q_m: each step's new term cancels the previous residue.
theorem theTelescopingPartialSum: forall q: Poly; forall al: F; forall m: Nat;
  evalUpTo(mulP(linear(al), q), al, succ(m)) =
  negF(mulF(power(al, succ(m)), coeff(q, m)))
proof
  @generalize-q |
    fix q: Poly {
      @generalize-al |
        fix al: F {
          // base: sum to limit 1 is the index-0 term, -al*q_0 * al^0 = -(al^1 * q_0)
          @base-one-term |
            evalUpTo(mulP(linear(al), q), al, succ(ZERO)) =
              coeff(mulP(linear(al), q), ZERO)
            [using specialize aConstantEvaluatesToItsCoefficient(mulP(linear(al), q), al)]
          @base-coefficient |
            coeff(mulP(linear(al), q), ZERO) = mulF(negF(al), coeff(q, ZERO))
            [using specialize theProductCoefficientAtZero(q, al)]
          @base-first-power |
            power(al, succ(ZERO)) = al
            [using specialize theFirstPowerIsTheBase(al)]
          @base-negation-moves |
            mulF(negF(al), coeff(q, ZERO)) = negF(mulF(al, coeff(q, ZERO)))
            [using specialize field.mulNegLeft(al, coeff(q, ZERO))]
          @base-case |
            evalUpTo(mulP(linear(al), q), al, succ(ZERO)) =
              negF(mulF(power(al, succ(ZERO)), coeff(q, ZERO)))
            [using simplify base-one-term base-coefficient base-negation-moves base-first-power]

          @induction-step |
            fix m: Nat {
              @given-inductive-hypothesis |
                assume evalUpTo(mulP(linear(al), q), al, succ(m)) =
                  negF(mulF(power(al, succ(m)), coeff(q, m))) {
                  @inductive-hypothesis |
                    evalUpTo(mulP(linear(al), q), al, succ(m)) =
                      negF(mulF(power(al, succ(m)), coeff(q, m)))
                    [by hypothesis given-inductive-hypothesis]
                  @one-more-term |
                    evalUpTo(mulP(linear(al), q), al, succ(succ(m))) =
                      addF(evalUpTo(mulP(linear(al), q), al, succ(m)),
                      mulF(coeff(mulP(linear(al), q), succ(m)), power(al, succ(m))))
                    [using specialize evalSucc(mulP(linear(al), q), al, succ(m))]
                  @the-new-coefficient |
                    coeff(mulP(linear(al), q), succ(m)) =
                      addF(mulF(negF(al), coeff(q, succ(m))), coeff(q, m))
                    [using specialize theProductCoefficientAtSucc(q, al, m)]
                  // substitute the hypothesis and the new coefficient into the step
                  @the-sum-expanded |
                    evalUpTo(mulP(linear(al), q), al, succ(succ(m))) =
                      addF(negF(mulF(power(al, succ(m)), coeff(q, m))),
                      mulF(addF(mulF(negF(al), coeff(q, succ(m))), coeff(q, m)),
                      power(al, succ(m))))
                    [using simplify one-more-term the-new-coefficient inductive-hypothesis]

                  // distribute the new term over its sum
                  @the-new-term-distributes |
                    mulF(addF(mulF(negF(al), coeff(q, succ(m))), coeff(q, m)),
                      power(al, succ(m))) =
                      addF(mulF(mulF(negF(al), coeff(q, succ(m))), power(al, succ(m))),
                      mulF(coeff(q, m), power(al, succ(m))))
                    [using specialize field.mulAddDistribRight(mulF(negF(al), coeff(q, succ(m))), coeff(q, m), power(al, succ(m)))]

                  // the first piece is -(al^(m+2) * q_(m+1))
                  @the-negation-moves-out |
                    mulF(mulF(negF(al), coeff(q, succ(m))), power(al, succ(m))) =
                      negF(mulF(mulF(al, coeff(q, succ(m))), power(al, succ(m))))
                    [using polynomial(field)]
                  @the-power-step |
                    power(al, succ(succ(m))) = mulF(al, power(al, succ(m)))
                    [using specialize powerSucc(al, succ(m))]
                  // regroup to put the two power factors adjacent, THEN fold them
                  @the-factors-regroup |
                    mulF(mulF(al, coeff(q, succ(m))), power(al, succ(m))) =
                      mulF(mulF(al, power(al, succ(m))), coeff(q, succ(m)))
                    [using polynomial(field)]
                  @the-powers-combine |
                    mulF(mulF(al, coeff(q, succ(m))), power(al, succ(m))) =
                      mulF(power(al, succ(succ(m))), coeff(q, succ(m)))
                    [by rewrite the-power-step-flipped the-factors-regroup]
                  @the-power-step-flipped |
                    mulF(al, power(al, succ(m))) = power(al, succ(succ(m)))
                    [by symmetry the-power-step]
                  @the-first-piece |
                    mulF(mulF(negF(al), coeff(q, succ(m))), power(al, succ(m))) =
                      negF(mulF(power(al, succ(succ(m))), coeff(q, succ(m))))
                    [using simplify the-negation-moves-out the-powers-combine]

                  // so the whole sum is  -A + (-B + A)  with A = al^(m+1)*q_m
                  @the-sum-in-three-pieces |
                    evalUpTo(mulP(linear(al), q), al, succ(succ(m))) =
                      addF(negF(mulF(power(al, succ(m)), coeff(q, m))),
                      addF(negF(mulF(power(al, succ(succ(m))), coeff(q, succ(m)))),
                      mulF(coeff(q, m), power(al, succ(m)))))
                    [using simplify the-sum-expanded the-new-term-distributes the-first-piece]

                  // -A + (-B + A) = -B
                  @the-two-cancel |
                    addF(negF(mulF(power(al, succ(m)), coeff(q, m))),
                      addF(negF(mulF(power(al, succ(succ(m))), coeff(q, succ(m)))),
                      mulF(coeff(q, m), power(al, succ(m))))) =
                      negF(mulF(power(al, succ(succ(m))), coeff(q, succ(m))))
                    [using polynomial(field)]
                  @conclusion-successor |
                    evalUpTo(mulP(linear(al), q), al, succ(succ(m))) =
                      negF(mulF(power(al, succ(succ(m))), coeff(q, succ(m))))
                    [using chain the-sum-in-three-pieces the-two-cancel]
                }
              @induction-step-at-m |
                (evalUpTo(mulP(linear(al), q), al, succ(m)) =
                  negF(mulF(power(al, succ(m)), coeff(q, m)))) ->
                  (evalUpTo(mulP(linear(al), q), al, succ(succ(m))) =
                  negF(mulF(power(al, succ(succ(m))), coeff(q, succ(m)))))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-m |
            forall m: Nat;
              (evalUpTo(mulP(linear(al), q), al, succ(m)) =
              negF(mulF(power(al, succ(m)), coeff(q, m)))) ->
              (evalUpTo(mulP(linear(al), q), al, succ(succ(m))) =
              negF(mulF(power(al, succ(succ(m))), coeff(q, succ(m)))))
            [by generalize induction-step]
          @conclusion-for-all-m |
            forall m: Nat;
              evalUpTo(mulP(linear(al), q), al, succ(m)) =
              negF(mulF(power(al, succ(m)), coeff(q, m)))
            [using instantiation peano.induction((fun m: Nat => evalUpTo(mulP(linear(al), q), al, succ(m)) = negF(mulF(power(al, succ(m)), coeff(q, m))))) base-case induction-step-for-all-m]
        }
      @discharge-al |
        forall al: F; forall m: Nat;
          evalUpTo(mulP(linear(al), q), al, succ(m)) =
          negF(mulF(power(al, succ(m)), coeff(q, m)))
        [by generalize generalize-al]
    }
  @conclusion |
    forall q: Poly; forall al: F; forall m: Nat;
      evalUpTo(mulP(linear(al), q), al, succ(m)) =
      negF(mulF(power(al, succ(m)), coeff(q, m)))
    [by generalize generalize-q]
qed

// THE PAYOFF: alpha is a zero of (x - alpha)*q. This is the multiplicative fact both
// directions of Judson's factor theorem need, obtained WITHOUT the general evaluation
// homomorphism: the telescoping sum's residue sits at an index above q's degree, so it
// vanishes.
theorem theProductVanishesAtTheRoot: forall q: Poly; forall al: F;
  (not (q = ZEROP)) -> isZeroOf(al, mulP(linear(al), q))
proof
  @generalize-q |
    fix q: Poly {
      @generalize-al |
        fix al: F {
          @given-q-nonzero |
            assume not (q = ZEROP) {
              @q-nonzero |
                not (q = ZEROP)
                [by hypothesis given-q-nonzero]
              @linear-nonzero |
                not (linear(al) = ZEROP)
                [using specialize theLinearPolynomialIsNonzero(al)]

              // the product's degree is 1 + deg q
              @the-product-degree |
                degree(mulP(linear(al), q)) =
                  peano.add(degree(linear(al)), degree(q))
                [using specialize degreeOfAProduct(linear(al), q) linear-nonzero q-nonzero]
              @the-divisor-degree |
                degree(linear(al)) = succ(ZERO)
                [using specialize theLinearPolynomialHasDegreeOne(al)]
              @the-product-degree-is-one-plus |
                degree(mulP(linear(al), q)) = peano.add(succ(ZERO), degree(q))
                [using simplify the-product-degree the-divisor-degree]
              @the-index-bridge |
                peano.add(succ(ZERO), degree(q)) = succ(degree(q))
                [using specialize onePlusIsSucc(degree(q))]
              @the-product-degree-is-a-successor |
                degree(mulP(linear(al), q)) = succ(degree(q))
                [using chain the-product-degree-is-one-plus the-index-bridge]

              // q vanishes at that index, since it is above q's own degree
              @q-is-bounded |
                degreeAtMost(q, degree(q))
                [using specialize degreeBoundsTheCoefficients(q) q-nonzero]
              @what-bounding-means |
                degreeAtMost(q, degree(q)) iff
                  (forall i: Nat; less_than(degree(q), i) -> coeff(q, i) = zeroF)
                [using specialize degreeAtMostMeaning(q, degree(q))]
              @q-vanishes-above |
                forall i: Nat; less_than(degree(q), i) -> coeff(q, i) = zeroF
                [using tautology q-is-bounded what-bounding-means]
              @the-degree-is-below-its-successor |
                less_than(degree(q), succ(degree(q)))
                [using specialize peano_order.lessThanSelf(degree(q))]
              @q-vanishes-at-the-product-degree |
                coeff(q, succ(degree(q))) = zeroF
                [using specialize q-vanishes-above(succ(degree(q))) the-degree-is-below-its-successor]

              // the telescoping value at that bound
              @the-value |
                evalUpTo(mulP(linear(al), q), al, succ(succ(degree(q)))) =
                  negF(mulF(power(al, succ(succ(degree(q)))), coeff(q, succ(degree(q)))))
                [using specialize theTelescopingPartialSum(q, al, succ(degree(q)))]
              @times-zero |
                mulF(power(al, succ(succ(degree(q)))), zeroF) = zeroF
                [using specialize field.mulZeroRight(power(al, succ(succ(degree(q)))))]
              @negating-zero |
                negF(zeroF) = zeroF
                [by cite field.negZero]
              @the-value-is-zero |
                evalUpTo(mulP(linear(al), q), al, succ(succ(degree(q)))) = zeroF
                [using simplify the-value q-vanishes-at-the-product-degree times-zero negating-zero]

              // and that bound IS succ(degree(product))
              @the-evaluation-vanishes |
                evalUpTo(mulP(linear(al), q), al,
                  succ(degree(mulP(linear(al), q)))) = zeroF
                [by rewrite the-product-degree-is-a-successor-flipped the-value-is-zero]
              @the-product-degree-is-a-successor-flipped |
                succ(degree(q)) = degree(mulP(linear(al), q))
                [by symmetry the-product-degree-is-a-successor]
              @what-being-a-zero-means |
                isZeroOf(al, mulP(linear(al), q)) iff
                  evaluate(mulP(linear(al), q), al) = zeroF
                [using specialize isZeroOfMeaning(al, mulP(linear(al), q))]
              @conclusion-the-product-vanishes |
                isZeroOf(al, mulP(linear(al), q))
                [using tautology the-evaluation-vanishes what-being-a-zero-means]
            }
          @nonzero-implies-vanishing |
            (not (q = ZEROP)) -> isZeroOf(al, mulP(linear(al), q))
            [by discharge given-q-nonzero]
        }
      @discharge-al |
        forall al: F; (not (q = ZEROP)) -> isZeroOf(al, mulP(linear(al), q))
        [by generalize generalize-al]
    }
  @conclusion |
    forall q: Poly; forall al: F;
      (not (q = ZEROP)) -> isZeroOf(al, mulP(linear(al), q))
    [by generalize generalize-q]
qed

// Evaluation is ADDITIVE: each new term (a_k + b_k)·x^k splits by distributivity, and the
// two running sums stay separated because addition is associative and commutative.
theorem evaluationPreservesAddition: forall p, q: Poly; forall a: F; forall k: Nat;
  evalUpTo(addP(p, q), a, k) = addF(evalUpTo(p, a, k), evalUpTo(q, a, k))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-a |
            fix a: F {
              @empty-sum-of-the-sum |
                evalUpTo(addP(p, q), a, ZERO) = zeroF
                [using specialize evalZero(addP(p, q), a)]
              @empty-sum-for-p |
                evalUpTo(p, a, ZERO) = zeroF
                [using specialize evalZero(p, a)]
              @empty-sum-for-q |
                evalUpTo(q, a, ZERO) = zeroF
                [using specialize evalZero(q, a)]
              @zero-plus-zero |
                addF(zeroF, zeroF) = zeroF
                [using specialize addZeroLeftF(zeroF)]
              @base-case |
                evalUpTo(addP(p, q), a, ZERO) =
                  addF(evalUpTo(p, a, ZERO), evalUpTo(q, a, ZERO))
                [using simplify empty-sum-of-the-sum empty-sum-for-p empty-sum-for-q zero-plus-zero]

              @induction-step |
                fix k: Nat {
                  @given-inductive-hypothesis |
                    assume evalUpTo(addP(p, q), a, k) =
                      addF(evalUpTo(p, a, k), evalUpTo(q, a, k)) {
                      @inductive-hypothesis |
                        evalUpTo(addP(p, q), a, k) =
                          addF(evalUpTo(p, a, k), evalUpTo(q, a, k))
                        [by hypothesis given-inductive-hypothesis]
                      @one-more-term-of-the-sum |
                        evalUpTo(addP(p, q), a, succ(k)) =
                          addF(evalUpTo(addP(p, q), a, k),
                          mulF(coeff(addP(p, q), k), power(a, k)))
                        [using specialize evalSucc(addP(p, q), a, k)]
                      @the-new-coefficient-splits |
                        coeff(addP(p, q), k) = addF(coeff(p, k), coeff(q, k))
                        [using specialize addPolyCoeff(p, q, k)]
                      @one-more-term-for-p |
                        evalUpTo(p, a, succ(k)) =
                          addF(evalUpTo(p, a, k), mulF(coeff(p, k), power(a, k)))
                        [using specialize evalSucc(p, a, k)]
                      @one-more-term-for-q |
                        evalUpTo(q, a, succ(k)) =
                          addF(evalUpTo(q, a, k), mulF(coeff(q, k), power(a, k)))
                        [using specialize evalSucc(q, a, k)]
                      @the-sum-side |
                        evalUpTo(addP(p, q), a, succ(k)) =
                          addF(addF(evalUpTo(p, a, k), evalUpTo(q, a, k)),
                          mulF(addF(coeff(p, k), coeff(q, k)), power(a, k)))
                        [using simplify one-more-term-of-the-sum the-new-coefficient-splits inductive-hypothesis]
                      @the-value-side |
                        addF(evalUpTo(p, a, succ(k)), evalUpTo(q, a, succ(k))) =
                          addF(addF(evalUpTo(p, a, k), mulF(coeff(p, k), power(a, k))),
                          addF(evalUpTo(q, a, k), mulF(coeff(q, k), power(a, k))))
                        [using simplify one-more-term-for-p one-more-term-for-q]
                      @the-four-summands-agree |
                        addF(addF(evalUpTo(p, a, k), evalUpTo(q, a, k)),
                          mulF(addF(coeff(p, k), coeff(q, k)), power(a, k))) =
                          addF(addF(evalUpTo(p, a, k), mulF(coeff(p, k), power(a, k))),
                          addF(evalUpTo(q, a, k), mulF(coeff(q, k), power(a, k))))
                        [using polynomial(field)]
                      @conclusion-successor |
                        evalUpTo(addP(p, q), a, succ(k)) =
                          addF(evalUpTo(p, a, succ(k)), evalUpTo(q, a, succ(k)))
                        [using chain the-sum-side the-four-summands-agree the-value-side-flipped]
                      @the-value-side-flipped |
                        addF(addF(evalUpTo(p, a, k), mulF(coeff(p, k), power(a, k))),
                          addF(evalUpTo(q, a, k), mulF(coeff(q, k), power(a, k)))) =
                          addF(evalUpTo(p, a, succ(k)), evalUpTo(q, a, succ(k)))
                        [by symmetry the-value-side]
                    }
                  @induction-step-at-k |
                    (evalUpTo(addP(p, q), a, k) =
                      addF(evalUpTo(p, a, k), evalUpTo(q, a, k))) ->
                      (evalUpTo(addP(p, q), a, succ(k)) =
                      addF(evalUpTo(p, a, succ(k)), evalUpTo(q, a, succ(k))))
                    [by discharge given-inductive-hypothesis]
                }
              @induction-step-for-all-k |
                forall k: Nat;
                  (evalUpTo(addP(p, q), a, k) =
                  addF(evalUpTo(p, a, k), evalUpTo(q, a, k))) ->
                  (evalUpTo(addP(p, q), a, succ(k)) =
                  addF(evalUpTo(p, a, succ(k)), evalUpTo(q, a, succ(k))))
                [by generalize induction-step]
              @conclusion-for-all-k |
                forall k: Nat;
                  evalUpTo(addP(p, q), a, k) =
                  addF(evalUpTo(p, a, k), evalUpTo(q, a, k))
                [using instantiation peano.induction((fun k: Nat => evalUpTo(addP(p, q), a, k) = addF(evalUpTo(p, a, k), evalUpTo(q, a, k)))) base-case induction-step-for-all-k]
            }
          @discharge-a |
            forall a: F; forall k: Nat;
              evalUpTo(addP(p, q), a, k) = addF(evalUpTo(p, a, k), evalUpTo(q, a, k))
            [by generalize generalize-a]
        }
      @discharge-q |
        forall q: Poly; forall a: F; forall k: Nat;
          evalUpTo(addP(p, q), a, k) = addF(evalUpTo(p, a, k), evalUpTo(q, a, k))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall a: F; forall k: Nat;
      evalUpTo(addP(p, q), a, k) = addF(evalUpTo(p, a, k), evalUpTo(q, a, k))
    [by generalize generalize-p]
qed

// EVALUATION STABILIZES past a degree bound: once the sum has reached every nonzero
// coefficient, extending it changes nothing. Stated for an arbitrary bound `n` that bounds
// the polynomial, so it applies at `degree(p)` and at anything larger.
theorem evaluationStabilizesPastTheBound: forall p: Poly; forall a: F; forall n: Nat;
  degreeAtMost(p, n) ->
  forall t: Nat;
  evalUpTo(p, a, peano.add(succ(n), t)) = evalUpTo(p, a, succ(n))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-a |
        fix a: F {
          @generalize-n |
            fix n: Nat {
              @given-bounded |
                assume degreeAtMost(p, n) {
                  @bounded |
                    degreeAtMost(p, n)
                    [by hypothesis given-bounded]
                  @what-bounding-means |
                    degreeAtMost(p, n) iff
                      (forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroF)
                    [using specialize degreeAtMostMeaning(p, n)]
                  @vanishes-above |
                    forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroF
                    [using tautology bounded what-bounding-means]

                  @adding-zero |
                    peano.add(succ(n), ZERO) = succ(n)
                    [using specialize peano.addZeroRight(succ(n))]
                  @the-sum-is-itself |
                    evalUpTo(p, a, succ(n)) = evalUpTo(p, a, succ(n))
                    [by reflexivity]
                  @base-case |
                    evalUpTo(p, a, peano.add(succ(n), ZERO)) = evalUpTo(p, a, succ(n))
                    [by rewrite adding-zero the-sum-is-itself]

                  @induction-step |
                    fix t: Nat {
                      @given-inductive-hypothesis |
                        assume evalUpTo(p, a, peano.add(succ(n), t)) =
                          evalUpTo(p, a, succ(n)) {
                          @inductive-hypothesis |
                            evalUpTo(p, a, peano.add(succ(n), t)) = evalUpTo(p, a, succ(n))
                            [by hypothesis given-inductive-hypothesis]
                          @the-next-bound |
                            peano.add(succ(n), succ(t)) = succ(peano.add(succ(n), t))
                            [using specialize peano.addSuccRight(succ(n), t)]
                          @one-more-term |
                            evalUpTo(p, a, succ(peano.add(succ(n), t))) =
                              addF(evalUpTo(p, a, peano.add(succ(n), t)),
                              mulF(coeff(p, peano.add(succ(n), t)),
                              power(a, peano.add(succ(n), t))))
                            [using specialize evalSucc(p, a, peano.add(succ(n), t))]
                          // n < succ(n) + t, so that coefficient vanishes
                          @the-gap-exists |
                            exists dd: Nat;
                              peano.add(succ(n), dd) = peano.add(succ(n), t)
                            [by witness(t) the-sum-reflexive]
                          @the-sum-reflexive |
                            peano.add(succ(n), t) = peano.add(succ(n), t)
                            [by reflexivity]
                          @what-a-bound-means |
                            peano_order.less_or_equal(succ(n), peano.add(succ(n), t)) iff
                              (exists dd: Nat;
                              peano.add(succ(n), dd) = peano.add(succ(n), t))
                            [using specialize peano_order.lessOrEqualIsGapExistential(succ(n), peano.add(succ(n), t))]
                          @the-successor-is-bounded |
                            peano_order.less_or_equal(succ(n), peano.add(succ(n), t))
                            [using tautology the-gap-exists what-a-bound-means]
                          // succ(n) <= i gives succ(n) < succ(i), hence n < i
                          @the-successors-compare |
                            less_than(succ(n), succ(peano.add(succ(n), t)))
                            [using specialize peano_order.lessOrEqualToLessThanSucc(succ(n), peano.add(succ(n), t)) the-successor-is-bounded]
                          @n-is-below-the-index |
                            less_than(n, peano.add(succ(n), t))
                            [using specialize peano_order.succReflectsOrder(n, peano.add(succ(n), t)) the-successors-compare]
                          @the-coefficient-vanishes |
                            coeff(p, peano.add(succ(n), t)) = zeroF
                            [using specialize vanishes-above(peano.add(succ(n), t)) n-is-below-the-index]
                          @the-new-term-is-zero |
                            mulF(zeroF, power(a, peano.add(succ(n), t))) = zeroF
                            [using specialize field.mulZeroLeft(power(a, peano.add(succ(n), t)))]
                          @the-sum-gains-zero |
                            evalUpTo(p, a, succ(peano.add(succ(n), t))) =
                              addF(evalUpTo(p, a, succ(n)), zeroF)
                            [using simplify one-more-term the-coefficient-vanishes the-new-term-is-zero inductive-hypothesis]
                          @adding-zero-changes-nothing |
                            addF(evalUpTo(p, a, succ(n)), zeroF) = evalUpTo(p, a, succ(n))
                            [using specialize field.addZeroRight(evalUpTo(p, a, succ(n)))]
                          @the-value-at-the-next |
                            evalUpTo(p, a, succ(peano.add(succ(n), t))) =
                              evalUpTo(p, a, succ(n))
                            [using chain the-sum-gains-zero adding-zero-changes-nothing]
                          @conclusion-successor |
                            evalUpTo(p, a, peano.add(succ(n), succ(t))) =
                              evalUpTo(p, a, succ(n))
                            [by rewrite the-next-bound the-value-at-the-next]
                        }
                      @induction-step-at-t |
                        (evalUpTo(p, a, peano.add(succ(n), t)) = evalUpTo(p, a, succ(n))) ->
                          (evalUpTo(p, a, peano.add(succ(n), succ(t))) =
                          evalUpTo(p, a, succ(n)))
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-for-all-t |
                    forall t: Nat;
                      (evalUpTo(p, a, peano.add(succ(n), t)) = evalUpTo(p, a, succ(n))) ->
                      (evalUpTo(p, a, peano.add(succ(n), succ(t))) =
                      evalUpTo(p, a, succ(n)))
                    [by generalize induction-step]
                  @conclusion-for-all-t |
                    forall t: Nat;
                      evalUpTo(p, a, peano.add(succ(n), t)) = evalUpTo(p, a, succ(n))
                    [using instantiation peano.induction((fun t: Nat => evalUpTo(p, a, peano.add(succ(n), t)) = evalUpTo(p, a, succ(n)))) base-case induction-step-for-all-t]
                }
              @bounded-implies-stable |
                degreeAtMost(p, n) ->
                  forall t: Nat;
                  evalUpTo(p, a, peano.add(succ(n), t)) = evalUpTo(p, a, succ(n))
                [by discharge given-bounded]
            }
          @discharge-n |
            forall n: Nat;
              degreeAtMost(p, n) ->
              forall t: Nat;
              evalUpTo(p, a, peano.add(succ(n), t)) = evalUpTo(p, a, succ(n))
            [by generalize generalize-n]
        }
      @discharge-a |
        forall a: F; forall n: Nat;
          degreeAtMost(p, n) ->
          forall t: Nat;
          evalUpTo(p, a, peano.add(succ(n), t)) = evalUpTo(p, a, succ(n))
        [by generalize generalize-a]
    }
  @conclusion |
    forall p: Poly; forall a: F; forall n: Nat;
      degreeAtMost(p, n) ->
      forall t: Nat;
      evalUpTo(p, a, peano.add(succ(n), t)) = evalUpTo(p, a, succ(n))
    [by generalize generalize-p]
qed

// A constant polynomial whose constant term vanishes IS the zero polynomial: it agrees with
// ZEROP at index 0 by hypothesis and above index 0 because both are bounded there.
theorem aVanishingConstantIsZero: forall r: Poly;
  degreeAtMost(r, ZERO) -> coeff(r, ZERO) = zeroF -> r = ZEROP
proof
  @generalize-r |
    fix r: Poly {
      @given-constant |
        assume degreeAtMost(r, ZERO) {
          @given-vanishes-at-zero |
            assume coeff(r, ZERO) = zeroF {
              @is-constant |
                degreeAtMost(r, ZERO)
                [by hypothesis given-constant]
              @vanishes-at-zero |
                coeff(r, ZERO) = zeroF
                [by hypothesis given-vanishes-at-zero]
              @what-bounding-means |
                degreeAtMost(r, ZERO) iff
                  (forall i: Nat; less_than(ZERO, i) -> coeff(r, i) = zeroF)
                [using specialize degreeAtMostMeaning(r, ZERO)]
              @vanishes-above-zero |
                forall i: Nat; less_than(ZERO, i) -> coeff(r, i) = zeroF
                [using tautology is-constant what-bounding-means]

              @generalize-index |
                fix i: Nat {
                  @the-index-trichotomy |
                    less_than(i, ZERO) or i = ZERO or less_than(ZERO, i)
                    [using specialize peano_order.trichotomy(i, ZERO)]
                  @nothing-below-zero |
                    not less_than(i, ZERO)
                    [using specialize peano_order.notLessThanZero(i)]
                  @zero-or-above |
                    i = ZERO or less_than(ZERO, i)
                    [using tautology the-index-trichotomy nothing-below-zero]
                  @when-index-is-zero |
                    assume i = ZERO {
                      @index-is-zero |
                        i = ZERO
                        [by hypothesis when-index-is-zero]
                      @index-is-zero-flipped |
                        ZERO = i
                        [by symmetry index-is-zero]
                      @vanishes-here-at-zero |
                        coeff(r, i) = zeroF
                        [by rewrite index-is-zero-flipped vanishes-at-zero]
                    }
                  @when-index-is-above |
                    assume less_than(ZERO, i) {
                      @index-is-above |
                        less_than(ZERO, i)
                        [by hypothesis when-index-is-above]
                      @vanishes-here-above |
                        coeff(r, i) = zeroF
                        [using specialize vanishes-above-zero(i) index-is-above]
                    }
                  @vanishes-either-way |
                    coeff(r, i) = zeroF
                    [by common_conclusion zero-or-above when-index-is-zero when-index-is-above]
                  @the-zero-coefficient |
                    coeff(ZEROP, i) = zeroF
                    [using specialize zeroPolyCoeff(i)]
                  @the-zero-coefficient-flipped |
                    zeroF = coeff(ZEROP, i)
                    [by symmetry the-zero-coefficient]
                  @coefficients-agree |
                    coeff(r, i) = coeff(ZEROP, i)
                    [using chain vanishes-either-way the-zero-coefficient-flipped]
                }
              @all-coefficients-agree |
                forall i: Nat; coeff(r, i) = coeff(ZEROP, i)
                [by generalize generalize-index]
              @conclusion-is-zero |
                r = ZEROP
                [using specialize polyExtensionality(r, ZEROP) all-coefficients-agree]
            }
          @vanishing-implies-zero |
            coeff(r, ZERO) = zeroF -> r = ZEROP
            [by discharge given-vanishes-at-zero]
        }
      @constant-implies |
        degreeAtMost(r, ZERO) -> coeff(r, ZERO) = zeroF -> r = ZEROP
        [by discharge given-constant]
    }
  @conclusion |
    forall r: Poly;
      degreeAtMost(r, ZERO) -> coeff(r, ZERO) = zeroF -> r = ZEROP
    [by generalize generalize-r]
qed

// THE FORWARD DIRECTION's core, with the common evaluation bound K taken as a hypothesis.
//
// Judson: "But 0 = p(alpha) = 0 * q(alpha) + a = a; consequently p(x) = (x - alpha) q(x)."
// Read as: if p is the division's sum, and BOTH p and the product vanish at alpha when
// summed to the same bound K, then the remainder's constant term is zero — hence (with
// aVanishingConstantIsZero) the remainder IS zero and p is exactly the product.
//
// Isolating the bound as a hypothesis keeps this step about the ALGEBRA. Discharging it
// needs degree bookkeeping (that deg p equals the product's degree once the remainder is a
// constant), which is separate work and does not belong in the same proof.
theorem theRemainderVanishesAtTheRoot: forall p, q, r: Poly; forall al: F; forall kk: Nat;
  p = addP(mulP(linear(al), q), r) ->
  evalUpTo(p, al, kk) = zeroF ->
  evalUpTo(mulP(linear(al), q), al, kk) = zeroF ->
  evalUpTo(r, al, kk) = coeff(r, ZERO) ->
  coeff(r, ZERO) = zeroF
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-al |
                fix al: F {
                  @generalize-kk |
                    fix kk: Nat {
                      @given-the-division |
                        assume p = addP(mulP(linear(al), q), r) {
                          @given-p-vanishes |
                            assume evalUpTo(p, al, kk) = zeroF {
                              @given-product-vanishes |
                                assume evalUpTo(mulP(linear(al), q), al, kk) = zeroF {
                                  @given-remainder-is-its-constant |
                                    assume evalUpTo(r, al, kk) = coeff(r, ZERO) {
                                      @the-division |
                                        p = addP(mulP(linear(al), q), r)
                                        [by hypothesis given-the-division]
                                      @p-vanishes |
                                        evalUpTo(p, al, kk) = zeroF
                                        [by hypothesis given-p-vanishes]
                                      @product-vanishes |
                                        evalUpTo(mulP(linear(al), q), al, kk) = zeroF
                                        [by hypothesis given-product-vanishes]
                                      @remainder-is-its-constant |
                                        evalUpTo(r, al, kk) = coeff(r, ZERO)
                                        [by hypothesis given-remainder-is-its-constant]

                                      // evaluation splits across the division's sum
                                      @the-sum-splits |
                                        evalUpTo(addP(mulP(linear(al), q), r), al, kk) =
                                          addF(evalUpTo(mulP(linear(al), q), al, kk),
                                          evalUpTo(r, al, kk))
                                        [using specialize evaluationPreservesAddition(mulP(linear(al), q), r, al, kk)]
                                      @p-is-the-sum |
                                        evalUpTo(p, al, kk) =
                                          addF(evalUpTo(mulP(linear(al), q), al, kk),
                                          evalUpTo(r, al, kk))
                                        [by rewrite the-division the-sum-splits]
                                      // rewrite the sum's two parts to their known values
                                      @the-sum-in-known-values |
                                        evalUpTo(p, al, kk) = addF(zeroF, coeff(r, ZERO))
                                        [using simplify p-is-the-sum product-vanishes remainder-is-its-constant]
                                      @zero-is-zero-plus-the-constant |
                                        zeroF = addF(zeroF, coeff(r, ZERO))
                                        [using chain p-vanishes-flipped the-sum-in-known-values]
                                      @p-vanishes-flipped |
                                        zeroF = evalUpTo(p, al, kk)
                                        [by symmetry p-vanishes]
                                      @zero-plus-the-constant |
                                        addF(zeroF, coeff(r, ZERO)) = coeff(r, ZERO)
                                        [using specialize addZeroLeftF(coeff(r, ZERO))]
                                      @zero-is-the-constant |
                                        zeroF = coeff(r, ZERO)
                                        [using chain zero-is-zero-plus-the-constant zero-plus-the-constant]
                                      @conclusion-the-constant-vanishes |
                                        coeff(r, ZERO) = zeroF
                                        [by symmetry zero-is-the-constant]
                                    }
                                  @d4 |
                                    evalUpTo(r, al, kk) = coeff(r, ZERO) -> coeff(r, ZERO) = zeroF
                                    [by discharge given-remainder-is-its-constant]
                                }
                              @d3 |
                                evalUpTo(mulP(linear(al), q), al, kk) = zeroF ->
                                  evalUpTo(r, al, kk) = coeff(r, ZERO) -> coeff(r, ZERO) = zeroF
                                [by discharge given-product-vanishes]
                            }
                          @d2 |
                            evalUpTo(p, al, kk) = zeroF ->
                              evalUpTo(mulP(linear(al), q), al, kk) = zeroF ->
                              evalUpTo(r, al, kk) = coeff(r, ZERO) -> coeff(r, ZERO) = zeroF
                            [by discharge given-p-vanishes]
                        }
                      @d1 |
                        p = addP(mulP(linear(al), q), r) ->
                          evalUpTo(p, al, kk) = zeroF ->
                          evalUpTo(mulP(linear(al), q), al, kk) = zeroF ->
                          evalUpTo(r, al, kk) = coeff(r, ZERO) -> coeff(r, ZERO) = zeroF
                        [by discharge given-the-division]
                    }
                  @gen-kk |
                    forall k9: Nat;
                      p = addP(mulP(linear(al), q), r) ->
                      evalUpTo(p, al, k9) = zeroF ->
                      evalUpTo(mulP(linear(al), q), al, k9) = zeroF ->
                      evalUpTo(r, al, k9) = coeff(r, ZERO) -> coeff(r, ZERO) = zeroF
                    [by generalize generalize-kk]
                }
              @gen-al |
                forall a9: F; forall k9: Nat;
                  p = addP(mulP(linear(a9), q), r) ->
                  evalUpTo(p, a9, k9) = zeroF ->
                  evalUpTo(mulP(linear(a9), q), a9, k9) = zeroF ->
                  evalUpTo(r, a9, k9) = coeff(r, ZERO) -> coeff(r, ZERO) = zeroF
                [by generalize generalize-al]
            }
          @gen-r |
            forall r9: Poly; forall a9: F; forall k9: Nat;
              p = addP(mulP(linear(a9), q), r9) ->
              evalUpTo(p, a9, k9) = zeroF ->
              evalUpTo(mulP(linear(a9), q), a9, k9) = zeroF ->
              evalUpTo(r9, a9, k9) = coeff(r9, ZERO) -> coeff(r9, ZERO) = zeroF
            [by generalize generalize-r]
        }
      @gen-q |
        forall q9, r9: Poly; forall a9: F; forall k9: Nat;
          p = addP(mulP(linear(a9), q9), r9) ->
          evalUpTo(p, a9, k9) = zeroF ->
          evalUpTo(mulP(linear(a9), q9), a9, k9) = zeroF ->
          evalUpTo(r9, a9, k9) = coeff(r9, ZERO) -> coeff(r9, ZERO) = zeroF
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall al: F; forall kk: Nat;
      p = addP(mulP(linear(al), q), r) ->
      evalUpTo(p, al, kk) = zeroF ->
      evalUpTo(mulP(linear(al), q), al, kk) = zeroF ->
      evalUpTo(r, al, kk) = coeff(r, ZERO) -> coeff(r, ZERO) = zeroF
    [by generalize generalize-p]
qed

// == THE EXISTENCE HALF ===================================================================
//
// "Let f(x) and g(x) be polynomials in F[x], where F is a field and g(x) is a nonzero
// polynomial. Then there exist unique polynomials q(x), r(x) in F[x] such that
// f(x) = g(x) q(x) + r(x), where either deg r(x) < deg g(x) or r(x) is the zero polynomial."
//
// Three theorems: a dispatch on the degree's shape, the induction step, and the strong
// induction that closes it. Every leaf is one of the four arms proved above.

// DISPATCH ON THE DEGREE SHAPE: with deg gg <= deg ff and ff nonzero, split on whether
// deg ff is ZERO (both constants, the exact-division arm) or a successor (the recursive arm).
theorem theDispatchOnTheDegreeShape: forall ff, gg: Poly; forall nn: Nat;
  (not (ff = ZEROP)) -> (not (gg = ZEROP)) -> degreeAtMost(ff, nn) ->
  peano_order.less_or_equal(degree(gg), degree(ff)) ->
  (forall jj: Nat; less_than(jj, nn) ->
  forall red: Poly; degreeAtMost(red, jj) ->
  exists quo: Poly; exists rem: Poly;
  red = addP(mulP(gg, quo), rem) and
  (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
  exists quo: Poly; exists rem: Poly;
  ff = addP(mulP(gg, quo), rem) and
  (rem = ZEROP or less_than(degree(rem), degree(gg)))
proof
  @generalize-ff |
    fix ff: Poly {
      @generalize-gg |
        fix gg: Poly {
          @generalize-nn |
            fix nn: Nat {
              @given-ff-nonzero |
                assume not (ff = ZEROP) {
                  @given-gg-nonzero |
                    assume not (gg = ZEROP) {
                      @given-ff-bounded |
                        assume degreeAtMost(ff, nn) {
                          @given-gg-fits |
                            assume peano_order.less_or_equal(degree(gg), degree(ff)) {
                              @given-recursion |
                                assume forall jj: Nat; less_than(jj, nn) ->
                                  forall red: Poly; degreeAtMost(red, jj) ->
                                  exists quo: Poly; exists rem: Poly;
                                  red = addP(mulP(gg, quo), rem) and
                                  (rem = ZEROP or less_than(degree(rem), degree(gg))) {
                                  @ff-nonzero |
                                    not (ff = ZEROP)
                                    [by hypothesis given-ff-nonzero]
                                  @gg-nonzero |
                                    not (gg = ZEROP)
                                    [by hypothesis given-gg-nonzero]
                                  @ff-bounded |
                                    degreeAtMost(ff, nn)
                                    [by hypothesis given-ff-bounded]
                                  @gg-fits |
                                    peano_order.less_or_equal(degree(gg), degree(ff))
                                    [by hypothesis given-gg-fits]
                                  @recursion |
                                    forall jj: Nat; less_than(jj, nn) ->
                                      forall red: Poly; degreeAtMost(red, jj) ->
                                      exists quo: Poly; exists rem: Poly;
                                      red = addP(mulP(gg, quo), rem) and
                                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                    [by hypothesis given-recursion]

                                  @the-degree-shape |
                                    degree(ff) = ZERO or (exists m9: Nat; degree(ff) = succ(m9))
                                    [using specialize peano.zeroOrSucc(degree(ff))]

                                  @when-the-degree-is-zero |
                                    assume degree(ff) = ZERO {
                                      @ff-is-constant |
                                        degree(ff) = ZERO
                                        [by hypothesis when-the-degree-is-zero]
                                      // deg gg <= 0 forces deg gg = 0
                                      @gg-fits-zero |
                                        peano_order.less_or_equal(degree(gg), ZERO)
                                        [by rewrite ff-is-constant gg-fits]
                                      @gg-below-or-equal |
                                        less_than(degree(gg), ZERO) or degree(gg) = ZERO
                                        [using specialize peano_order.lessOrEqualSplit(degree(gg), ZERO) gg-fits-zero]
                                      @nothing-below-zero |
                                        not less_than(degree(gg), ZERO)
                                        [using specialize peano_order.notLessThanZero(degree(gg))]
                                      @gg-is-constant |
                                        degree(gg) = ZERO
                                        [using tautology gg-below-or-equal nothing-below-zero]
                                      @divides-when-constant |
                                        exists quo: Poly; exists rem: Poly;
                                          ff = addP(mulP(gg, quo), rem) and
                                          (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                        [using specialize aConstantDividesAConstantExactly(ff, gg) ff-nonzero gg-nonzero ff-is-constant gg-is-constant]
                                    }

                                  @when-the-degree-is-a-successor |
                                    assume exists m9: Nat; degree(ff) = succ(m9) {
                                      @the-predecessor-exists |
                                        exists m9: Nat; degree(ff) = succ(m9)
                                        [by hypothesis when-the-degree-is-a-successor]
                                      @with-the-predecessor |
                                        unpack m9: Nat from the-predecessor-exists {
                                          @ff-degree-is-a-successor |
                                            degree(ff) = succ(m9)
                                            [by hypothesis with-the-predecessor]
                                          @divides-by-recursion |
                                            exists quo: Poly; exists rem: Poly;
                                              ff = addP(mulP(gg, quo), rem) and
                                              (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                            [using specialize theRecursiveCaseDivides(ff, gg, nn, m9) ff-nonzero gg-nonzero ff-bounded ff-degree-is-a-successor gg-fits recursion]
                                        }
                                      @divides-when-a-successor |
                                        exists quo: Poly; exists rem: Poly;
                                          ff = addP(mulP(gg, quo), rem) and
                                          (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                        [by unpacked with-the-predecessor]
                                    }

                                  @divides-either-shape |
                                    exists quo: Poly; exists rem: Poly;
                                      ff = addP(mulP(gg, quo), rem) and
                                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                    [by common_conclusion the-degree-shape when-the-degree-is-zero when-the-degree-is-a-successor]
                                }
                              @e5 |
                                (forall jj: Nat; less_than(jj, nn) ->
                                  forall red: Poly; degreeAtMost(red, jj) ->
                                  exists quo: Poly; exists rem: Poly;
                                  red = addP(mulP(gg, quo), rem) and
                                  (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                                  exists quo: Poly; exists rem: Poly;
                                  ff = addP(mulP(gg, quo), rem) and
                                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                [by discharge given-recursion]
                            }
                          @e4 |
                            peano_order.less_or_equal(degree(gg), degree(ff)) ->
                              (forall jj: Nat; less_than(jj, nn) ->
                              forall red: Poly; degreeAtMost(red, jj) ->
                              exists quo: Poly; exists rem: Poly;
                              red = addP(mulP(gg, quo), rem) and
                              (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                              exists quo: Poly; exists rem: Poly;
                              ff = addP(mulP(gg, quo), rem) and
                              (rem = ZEROP or less_than(degree(rem), degree(gg)))
                            [by discharge given-gg-fits]
                        }
                      @e3 |
                        degreeAtMost(ff, nn) ->
                          peano_order.less_or_equal(degree(gg), degree(ff)) ->
                          (forall jj: Nat; less_than(jj, nn) ->
                          forall red: Poly; degreeAtMost(red, jj) ->
                          exists quo: Poly; exists rem: Poly;
                          red = addP(mulP(gg, quo), rem) and
                          (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                          exists quo: Poly; exists rem: Poly;
                          ff = addP(mulP(gg, quo), rem) and
                          (rem = ZEROP or less_than(degree(rem), degree(gg)))
                        [by discharge given-ff-bounded]
                    }
                  @e2 |
                    (not (gg = ZEROP)) -> degreeAtMost(ff, nn) ->
                      peano_order.less_or_equal(degree(gg), degree(ff)) ->
                      (forall jj: Nat; less_than(jj, nn) ->
                      forall red: Poly; degreeAtMost(red, jj) ->
                      exists quo: Poly; exists rem: Poly;
                      red = addP(mulP(gg, quo), rem) and
                      (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                      exists quo: Poly; exists rem: Poly;
                      ff = addP(mulP(gg, quo), rem) and
                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                    [by discharge given-gg-nonzero]
                }
              @e1 |
                (not (ff = ZEROP)) -> (not (gg = ZEROP)) -> degreeAtMost(ff, nn) ->
                  peano_order.less_or_equal(degree(gg), degree(ff)) ->
                  (forall jj: Nat; less_than(jj, nn) ->
                  forall red: Poly; degreeAtMost(red, jj) ->
                  exists quo: Poly; exists rem: Poly;
                  red = addP(mulP(gg, quo), rem) and
                  (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                  exists quo: Poly; exists rem: Poly;
                  ff = addP(mulP(gg, quo), rem) and
                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                [by discharge given-ff-nonzero]
            }
          @gen-nn |
            forall n9: Nat;
              (not (ff = ZEROP)) -> (not (gg = ZEROP)) -> degreeAtMost(ff, n9) ->
              peano_order.less_or_equal(degree(gg), degree(ff)) ->
              (forall jj: Nat; less_than(jj, n9) ->
              forall red: Poly; degreeAtMost(red, jj) ->
              exists quo: Poly; exists rem: Poly;
              red = addP(mulP(gg, quo), rem) and
              (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
              exists quo: Poly; exists rem: Poly;
              ff = addP(mulP(gg, quo), rem) and
              (rem = ZEROP or less_than(degree(rem), degree(gg)))
            [by generalize generalize-nn]
        }
      @gen-gg |
        forall g9: Poly; forall n9: Nat;
          (not (ff = ZEROP)) -> (not (g9 = ZEROP)) -> degreeAtMost(ff, n9) ->
          peano_order.less_or_equal(degree(g9), degree(ff)) ->
          (forall jj: Nat; less_than(jj, n9) ->
          forall red: Poly; degreeAtMost(red, jj) ->
          exists quo: Poly; exists rem: Poly;
          red = addP(mulP(g9, quo), rem) and
          (rem = ZEROP or less_than(degree(rem), degree(g9)))) ->
          exists quo: Poly; exists rem: Poly;
          ff = addP(mulP(g9, quo), rem) and
          (rem = ZEROP or less_than(degree(rem), degree(g9)))
        [by generalize generalize-gg]
    }
  @conclusion |
    forall f9, g9: Poly; forall n9: Nat;
      (not (f9 = ZEROP)) -> (not (g9 = ZEROP)) -> degreeAtMost(f9, n9) ->
      peano_order.less_or_equal(degree(g9), degree(f9)) ->
      (forall jj: Nat; less_than(jj, n9) ->
      forall red: Poly; degreeAtMost(red, jj) ->
      exists quo: Poly; exists rem: Poly;
      red = addP(mulP(g9, quo), rem) and
      (rem = ZEROP or less_than(degree(rem), degree(g9)))) ->
      exists quo: Poly; exists rem: Poly;
      f9 = addP(mulP(g9, quo), rem) and
      (rem = ZEROP or less_than(degree(rem), degree(g9)))
    [by generalize generalize-ff]
qed

// THE INDUCTION STEP: given the recursion at every smaller bound, every polynomial
// bounded by nn divides. Four-way dispatch, each leaf a proved arm.
theorem theStepHolds: forall gg: Poly; forall nn: Nat;
  (not (gg = ZEROP)) ->
  (forall jj: Nat; less_than(jj, nn) ->
  forall red: Poly; degreeAtMost(red, jj) ->
  exists quo: Poly; exists rem: Poly;
  red = addP(mulP(gg, quo), rem) and
  (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
  forall ff: Poly; degreeAtMost(ff, nn) ->
  exists quo: Poly; exists rem: Poly;
  ff = addP(mulP(gg, quo), rem) and
  (rem = ZEROP or less_than(degree(rem), degree(gg)))
proof
  @generalize-gg |
    fix gg: Poly {
      @generalize-nn |
        fix nn: Nat {
          @given-gg-nonzero |
            assume not (gg = ZEROP) {
              @given-recursion |
                assume forall jj: Nat; less_than(jj, nn) ->
                  forall red: Poly; degreeAtMost(red, jj) ->
                  exists quo: Poly; exists rem: Poly;
                  red = addP(mulP(gg, quo), rem) and
                  (rem = ZEROP or less_than(degree(rem), degree(gg))) {
                  @gg-nonzero |
                    not (gg = ZEROP)
                    [by hypothesis given-gg-nonzero]
                  @recursion |
                    forall jj: Nat; less_than(jj, nn) ->
                      forall red: Poly; degreeAtMost(red, jj) ->
                      exists quo: Poly; exists rem: Poly;
                      red = addP(mulP(gg, quo), rem) and
                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                    [by hypothesis given-recursion]
                  @generalize-ff |
                    fix ff: Poly {
                      @given-ff-bounded |
                        assume degreeAtMost(ff, nn) {
                          @ff-bounded |
                            degreeAtMost(ff, nn)
                            [by hypothesis given-ff-bounded]

                          // DISPATCH 1: is ff zero?
                          @ff-zero-or-not |
                            ff = ZEROP or (not (ff = ZEROP))
                            [using tautology]

                          @when-ff-is-zero |
                            assume ff = ZEROP {
                              @ff-is-zero |
                                ff = ZEROP
                                [by hypothesis when-ff-is-zero]
                              @ff-is-small |
                                ff = ZEROP or less_than(degree(ff), degree(gg))
                                [by either_left ff-is-zero]
                              @divides-when-zero |
                                exists quo: Poly; exists rem: Poly;
                                  ff = addP(mulP(gg, quo), rem) and
                                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                [using specialize aSmallPolynomialDividesTrivially(ff, gg) ff-is-small]
                            }

                          @when-ff-is-nonzero |
                            assume not (ff = ZEROP) {
                              @ff-is-nonzero |
                                not (ff = ZEROP)
                                [by hypothesis when-ff-is-nonzero]

                              // DISPATCH 2: is deg ff below deg gg, or does gg fit inside ff?
                              // Two cases rather than three: `common_conclusion` takes one
                              // disjunction and two blocks, and "equal or lower" is exactly
                              // `less_or_equal`, which is what the next arm wants anyway.
                              @the-degrees-compare-strictly |
                                less_than(degree(ff), degree(gg)) or degree(ff) = degree(gg)
                                  or less_than(degree(gg), degree(ff))
                                [using specialize peano_order.trichotomy(degree(ff), degree(gg))]
                              @gg-fits-if-not-above |
                                degree(ff) = degree(gg) -> peano_order.less_or_equal(degree(gg), degree(ff))
                                [using tautology gg-fits-when-equal-lemma]
                              @gg-fits-when-equal-lemma |
                                degree(ff) = degree(gg) -> peano_order.less_or_equal(degree(gg), degree(ff))
                                [by discharge given-equal-degrees]
                              @given-equal-degrees |
                                assume degree(ff) = degree(gg) {
                                  @equal-degrees |
                                    degree(ff) = degree(gg)
                                    [by hypothesis given-equal-degrees]
                                  @gg-reflexive-here |
                                    peano_order.less_or_equal(degree(gg), degree(gg))
                                    [using specialize peano_order.lessOrEqualRefl(degree(gg))]
                                  @gg-fits-from-equality |
                                    peano_order.less_or_equal(degree(gg), degree(ff))
                                    [by rewrite equal-degrees gg-reflexive-here]
                                }
                              @gg-fits-if-lower |
                                less_than(degree(gg), degree(ff)) -> peano_order.less_or_equal(degree(gg), degree(ff))
                                [using specialize peano_order.lessThanToLessOrEqual(degree(gg), degree(ff))]
                              @the-degrees-compare |
                                less_than(degree(ff), degree(gg)) or
                                  peano_order.less_or_equal(degree(gg), degree(ff))
                                [using tautology the-degrees-compare-strictly gg-fits-if-not-above gg-fits-if-lower]

                              @when-ff-is-lower |
                                assume less_than(degree(ff), degree(gg)) {
                                  @ff-is-lower |
                                    less_than(degree(ff), degree(gg))
                                    [by hypothesis when-ff-is-lower]
                                  @ff-is-small-by-degree |
                                    ff = ZEROP or less_than(degree(ff), degree(gg))
                                    [by either_right ff-is-lower]
                                  @divides-when-lower |
                                    exists quo: Poly; exists rem: Poly;
                                      ff = addP(mulP(gg, quo), rem) and
                                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                    [using specialize aSmallPolynomialDividesTrivially(ff, gg) ff-is-small-by-degree]
                                }

                              @when-gg-fits |
                                assume peano_order.less_or_equal(degree(gg), degree(ff)) {
                                  @gg-fits |
                                    peano_order.less_or_equal(degree(gg), degree(ff))
                                    [by hypothesis when-gg-fits]
                                  @divides-when-gg-fits |
                                    exists quo: Poly; exists rem: Poly;
                                      ff = addP(mulP(gg, quo), rem) and
                                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                    [using specialize theDispatchOnTheDegreeShape(ff, gg, nn) ff-is-nonzero gg-nonzero ff-bounded gg-fits recursion]
                                }

                              @divides-when-nonzero |
                                exists quo: Poly; exists rem: Poly;
                                  ff = addP(mulP(gg, quo), rem) and
                                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                                [by common_conclusion the-degrees-compare when-ff-is-lower when-gg-fits]
                            }

                          @divides-either-way |
                            exists quo: Poly; exists rem: Poly;
                              ff = addP(mulP(gg, quo), rem) and
                              (rem = ZEROP or less_than(degree(rem), degree(gg)))
                            [by common_conclusion ff-zero-or-not when-ff-is-zero when-ff-is-nonzero]
                        }
                      @bounded-implies-divides |
                        degreeAtMost(ff, nn) ->
                          exists quo: Poly; exists rem: Poly;
                          ff = addP(mulP(gg, quo), rem) and
                          (rem = ZEROP or less_than(degree(rem), degree(gg)))
                        [by discharge given-ff-bounded]
                    }
                  @all-bounded-divide |
                    forall f9: Poly; degreeAtMost(f9, nn) ->
                      exists quo: Poly; exists rem: Poly;
                      f9 = addP(mulP(gg, quo), rem) and
                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                    [by generalize generalize-ff]
                }
              @recursion-implies-all |
                (forall jj: Nat; less_than(jj, nn) ->
                  forall red: Poly; degreeAtMost(red, jj) ->
                  exists quo: Poly; exists rem: Poly;
                  red = addP(mulP(gg, quo), rem) and
                  (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                  forall f9: Poly; degreeAtMost(f9, nn) ->
                  exists quo: Poly; exists rem: Poly;
                  f9 = addP(mulP(gg, quo), rem) and
                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                [by discharge given-recursion]
            }
          @the-step-at-nn |
            (not (gg = ZEROP)) ->
              (forall jj: Nat; less_than(jj, nn) ->
              forall red: Poly; degreeAtMost(red, jj) ->
              exists quo: Poly; exists rem: Poly;
              red = addP(mulP(gg, quo), rem) and
              (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
              forall f9: Poly; degreeAtMost(f9, nn) ->
              exists quo: Poly; exists rem: Poly;
              f9 = addP(mulP(gg, quo), rem) and
              (rem = ZEROP or less_than(degree(rem), degree(gg)))
            [by discharge given-gg-nonzero]
        }
      @gen-nn |
        forall n9: Nat;
          (not (gg = ZEROP)) ->
          (forall jj: Nat; less_than(jj, n9) ->
          forall red: Poly; degreeAtMost(red, jj) ->
          exists quo: Poly; exists rem: Poly;
          red = addP(mulP(gg, quo), rem) and
          (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
          forall f9: Poly; degreeAtMost(f9, n9) ->
          exists quo: Poly; exists rem: Poly;
          f9 = addP(mulP(gg, quo), rem) and
          (rem = ZEROP or less_than(degree(rem), degree(gg)))
        [by generalize generalize-nn]
    }
  @conclusion |
    forall g9: Poly; forall n9: Nat;
      (not (g9 = ZEROP)) ->
      (forall jj: Nat; less_than(jj, n9) ->
      forall red: Poly; degreeAtMost(red, jj) ->
      exists quo: Poly; exists rem: Poly;
      red = addP(mulP(g9, quo), rem) and
      (rem = ZEROP or less_than(degree(rem), degree(g9)))) ->
      forall f9: Poly; degreeAtMost(f9, n9) ->
      exists quo: Poly; exists rem: Poly;
      f9 = addP(mulP(g9, quo), rem) and
      (rem = ZEROP or less_than(degree(rem), degree(g9)))
    [by generalize generalize-gg]
qed

// JUDSON'S DIVISION ALGORITHM, EXISTENCE HALF. Strong induction on the degree bound, with
// theStepHolds as its step.
theorem theDivisionAlgorithmExists: forall gg: Poly;
  (not (gg = ZEROP)) ->
  forall ff: Poly;
  exists quo: Poly; exists rem: Poly;
  ff = addP(mulP(gg, quo), rem) and
  (rem = ZEROP or less_than(degree(rem), degree(gg)))
proof
  @generalize-gg |
    fix gg: Poly {
      @given-gg-nonzero |
        assume not (gg = ZEROP) {
          @gg-nonzero |
            not (gg = ZEROP)
            [by hypothesis given-gg-nonzero]
          @generalize-bound |
            fix nn: Nat {
              @the-step-at-nn |
                (forall jj: Nat; less_than(jj, nn) ->
                  forall red: Poly; degreeAtMost(red, jj) ->
                  exists quo: Poly; exists rem: Poly;
                  red = addP(mulP(gg, quo), rem) and
                  (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
                  forall f9: Poly; degreeAtMost(f9, nn) ->
                  exists quo: Poly; exists rem: Poly;
                  f9 = addP(mulP(gg, quo), rem) and
                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                [using specialize theStepHolds(gg, nn) gg-nonzero]
            }
          @the-step |
            forall nn: Nat;
              (forall jj: Nat; less_than(jj, nn) ->
              forall red: Poly; degreeAtMost(red, jj) ->
              exists quo: Poly; exists rem: Poly;
              red = addP(mulP(gg, quo), rem) and
              (rem = ZEROP or less_than(degree(rem), degree(gg)))) ->
              forall f9: Poly; degreeAtMost(f9, nn) ->
              exists quo: Poly; exists rem: Poly;
              f9 = addP(mulP(gg, quo), rem) and
              (rem = ZEROP or less_than(degree(rem), degree(gg)))
            [by generalize generalize-bound]
          @every-bound-divides |
            forall nn: Nat;
              forall f9: Poly; degreeAtMost(f9, nn) ->
              exists quo: Poly; exists rem: Poly;
              f9 = addP(mulP(gg, quo), rem) and
              (rem = ZEROP or less_than(degree(rem), degree(gg)))
            [using instantiation peano_order.strongInduction((fun nn: Nat => forall f9: Poly; degreeAtMost(f9, nn) -> exists quo: Poly; exists rem: Poly; f9 = addP(mulP(gg, quo), rem) and (rem = ZEROP or less_than(degree(rem), degree(gg))))) the-step]

          // every polynomial is bounded by its own degree (or is zero), so every one divides
          @generalize-ff |
            fix ff: Poly {
              @ff-zero-or-not |
                ff = ZEROP or (not (ff = ZEROP))
                [using tautology]
              @when-ff-is-zero |
                assume ff = ZEROP {
                  @ff-is-zero |
                    ff = ZEROP
                    [by hypothesis when-ff-is-zero]
                  @ff-is-small |
                    ff = ZEROP or less_than(degree(ff), degree(gg))
                    [by either_left ff-is-zero]
                  @divides-when-zero |
                    exists quo: Poly; exists rem: Poly;
                      ff = addP(mulP(gg, quo), rem) and
                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                    [using specialize aSmallPolynomialDividesTrivially(ff, gg) ff-is-small]
                }
              @when-ff-is-nonzero |
                assume not (ff = ZEROP) {
                  @ff-is-nonzero |
                    not (ff = ZEROP)
                    [by hypothesis when-ff-is-nonzero]
                  @ff-bounded-by-its-degree |
                    degreeAtMost(ff, degree(ff))
                    [using specialize degreeBoundsTheCoefficients(ff) ff-is-nonzero]
                  @the-bound-at-its-degree |
                    forall f9: Poly; degreeAtMost(f9, degree(ff)) ->
                      exists quo: Poly; exists rem: Poly;
                      f9 = addP(mulP(gg, quo), rem) and
                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                    [using specialize every-bound-divides(degree(ff))]
                  @divides-when-nonzero |
                    exists quo: Poly; exists rem: Poly;
                      ff = addP(mulP(gg, quo), rem) and
                      (rem = ZEROP or less_than(degree(rem), degree(gg)))
                    [using specialize the-bound-at-its-degree(ff) ff-bounded-by-its-degree]
                }
              @divides-either-way |
                exists quo: Poly; exists rem: Poly;
                  ff = addP(mulP(gg, quo), rem) and
                  (rem = ZEROP or less_than(degree(rem), degree(gg)))
                [by common_conclusion ff-zero-or-not when-ff-is-zero when-ff-is-nonzero]
            }
          @all-divide |
            forall f9: Poly;
              exists quo: Poly; exists rem: Poly;
              f9 = addP(mulP(gg, quo), rem) and
              (rem = ZEROP or less_than(degree(rem), degree(gg)))
            [by generalize generalize-ff]
        }
      @nonzero-implies-all-divide |
        (not (gg = ZEROP)) ->
          forall f9: Poly;
          exists quo: Poly; exists rem: Poly;
          f9 = addP(mulP(gg, quo), rem) and
          (rem = ZEROP or less_than(degree(rem), degree(gg)))
        [by discharge given-gg-nonzero]
    }
  @conclusion |
    forall g9: Poly;
      (not (g9 = ZEROP)) ->
      forall f9: Poly;
      exists quo: Poly; exists rem: Poly;
      f9 = addP(mulP(g9, quo), rem) and
      (rem = ZEROP or less_than(degree(rem), degree(g9)))
    [by generalize generalize-gg]
qed

// == JUDSON'S DIVISION ALGORITHM (§17.2) ==================================================
//
// "Let f(x) and g(x) be polynomials in F[x], where F is a field and g(x) is a nonzero
// polynomial. Then there exist unique polynomials q(x), r(x) in F[x] such that
// f(x) = g(x) q(x) + r(x), where either deg r(x) < deg g(x) or r(x) is the zero polynomial."
//
// His proof has two halves. The UNIQUENESS half is below, in full. It is pure degree
// arithmetic: it needs no construction, only the fact that a nonzero multiple of g has
// degree at least deg g, which two remainders below deg g cannot match.

// The pivot of his uniqueness argument, isolated: a nonzero multiple of g has degree at
// least that of g. "If q(x) - q_1(x) is not the zero polynomial, then
// deg(g(x)[q(x) - q_1(x)]) >= deg g(x)."
theorem aNonzeroMultipleHasAtLeastTheDegree: forall g, h: Poly;
  (not (g = ZEROP)) -> (not (h = ZEROP)) ->
  (not less_than(degree(mulP(g, h)), degree(g)))
proof
  @generalize-g |
    fix g: Poly {
      @generalize-h |
        fix h: Poly {
          @given-g-nonzero |
            assume not (g = ZEROP) {
              @given-h-nonzero |
                assume not (h = ZEROP) {
                  @g-nonzero |
                    not (g = ZEROP)
                    [by hypothesis given-g-nonzero]
                  @h-nonzero |
                    not (h = ZEROP)
                    [by hypothesis given-h-nonzero]
                  // deg(gh) = deg g + deg h, and a sum is never below its left summand.
                  @the-product-degree |
                    degree(mulP(g, h)) = peano.add(degree(g), degree(h))
                    [using specialize degreeOfAProduct(g, h) g-nonzero h-nonzero]
                  // deg g <= deg g + deg h, with deg h as the gap; a strict reverse would
                  // then make the sum strictly below itself.
                  @the-gap-exists |
                    exists d: Nat; peano.add(degree(g), d) = peano.add(degree(g), degree(h))
                    [by witness(degree(h)) the-sum-is-itself]
                  @the-sum-is-itself |
                    peano.add(degree(g), degree(h)) = peano.add(degree(g), degree(h))
                    [by reflexivity]
                  @what-a-bound-means |
                    peano_order.less_or_equal(degree(g), peano.add(degree(g), degree(h))) iff
                      (exists d: Nat; peano.add(degree(g), d) = peano.add(degree(g), degree(h)))
                    [using specialize peano_order.lessOrEqualIsGapExistential(degree(g), peano.add(degree(g), degree(h)))]
                  @the-degree-is-bounded-by-the-sum |
                    peano_order.less_or_equal(degree(g), peano.add(degree(g), degree(h)))
                    [using tautology the-gap-exists what-a-bound-means]
                  @given-the-sum-is-below |
                    assume less_than(peano.add(degree(g), degree(h)), degree(g)) {
                      @the-sum-is-below |
                        less_than(peano.add(degree(g), degree(h)), degree(g))
                        [by hypothesis given-the-sum-is-below]
                      @the-sum-bounds-the-degree |
                        peano_order.less_or_equal(peano.add(degree(g), degree(h)), degree(g))
                        [using specialize peano_order.lessThanToLessOrEqual(peano.add(degree(g), degree(h)), degree(g)) the-sum-is-below]
                      @the-two-bounds-force-equality |
                        degree(g) = peano.add(degree(g), degree(h))
                        [using specialize peano_order.lessOrEqualAntisymmetric(degree(g), peano.add(degree(g), degree(h))) the-degree-is-bounded-by-the-sum the-sum-bounds-the-degree]
                      @the-degree-is-below-itself |
                        less_than(degree(g), degree(g))
                        [by rewrite the-two-bounds-force-equality-flipped the-sum-is-below]
                      @the-two-bounds-force-equality-flipped |
                        peano.add(degree(g), degree(h)) = degree(g)
                        [by symmetry the-two-bounds-force-equality]
                      @nothing-is-below-itself |
                        not less_than(degree(g), degree(g))
                        [using specialize peano_order.lessThanIrreflexive(degree(g))]
                      @contradiction |
                        not less_than(peano.add(degree(g), degree(h)), degree(g))
                        [by ex_falso the-degree-is-below-itself nothing-is-below-itself]
                    }
                  @being-below-is-absurd |
                    less_than(peano.add(degree(g), degree(h)), degree(g)) ->
                      (not less_than(peano.add(degree(g), degree(h)), degree(g)))
                    [by discharge given-the-sum-is-below]
                  @a-sum-is-not-below-its-summand |
                    not less_than(peano.add(degree(g), degree(h)), degree(g))
                    [using tautology being-below-is-absurd]
                  @conclusion-at-least-the-degree |
                    not less_than(degree(mulP(g, h)), degree(g))
                    [by rewrite the-product-degree-flipped a-sum-is-not-below-its-summand]
                  @the-product-degree-flipped |
                    peano.add(degree(g), degree(h)) = degree(mulP(g, h))
                    [by symmetry the-product-degree]
                }
              @h-nonzero-implies-the-bound |
                (not (h = ZEROP)) -> (not less_than(degree(mulP(g, h)), degree(g)))
                [by discharge given-h-nonzero]
            }
          @both-nonzero-imply-the-bound |
            (not (g = ZEROP)) -> (not (h = ZEROP)) ->
              (not less_than(degree(mulP(g, h)), degree(g)))
            [by discharge given-g-nonzero]
        }
      @discharge-h |
        forall h: Poly;
          (not (g = ZEROP)) -> (not (h = ZEROP)) ->
          (not less_than(degree(mulP(g, h)), degree(g)))
        [by generalize generalize-h]
    }
  @conclusion |
    forall g, h: Poly;
      (not (g = ZEROP)) -> (not (h = ZEROP)) ->
      (not less_than(degree(mulP(g, h)), degree(g)))
    [by generalize generalize-g]
qed

// UNIQUENESS, Judson's second paragraph.
//
// "suppose that there exist two other polynomials q_1(x) and r_1(x) such that
// f(x) = g(x) q_1(x) + r_1(x) ... so that g(x)[q(x) - q_1(x)] = r_1(x) - r(x). If
// q(x) - q_1(x) is not the zero polynomial, then
// deg(g(x)[q(x) - q_1(x)]) = deg(r_1(x) - r(x)) >= deg g(x). However, the degrees of both
// r(x) and r_1(x) are strictly less than the degree of g(x); therefore, r(x) = r_1(x) and
// q(x) = q_1(x)."
//
// The whole force of that paragraph is this: a multiple of g whose degree is below deg g
// must be the zero multiple. Given it, uniqueness is immediate — the regrouped equation
// g(q - q_1) = r_1 - r exhibits such a multiple, so q - q_1 vanishes and then r_1 - r does
// too. Stated about the multiple itself rather than about four polynomials, because that is
// where the content is and it is what the existence half will cite.
theorem aSmallDegreeMultipleIsTheZeroMultiple: forall g, h: Poly;
  (not (g = ZEROP)) ->
  less_than(degree(mulP(g, h)), degree(g)) ->
  h = ZEROP
proof
  @generalize-g |
    fix g: Poly {
      @generalize-h |
        fix h: Poly {
          @given-g-nonzero |
            assume not (g = ZEROP) {
              @given-the-multiple-is-small |
                assume less_than(degree(mulP(g, h)), degree(g)) {
                  @g-nonzero |
                    not (g = ZEROP)
                    [by hypothesis given-g-nonzero]
                  @the-multiple-is-small |
                    less_than(degree(mulP(g, h)), degree(g))
                    [by hypothesis given-the-multiple-is-small]

                  // were h nonzero, g*h would be a NONZERO multiple of g, whose degree is
                  // at least deg g — contradicting that it is below deg g.
                  @given-h-is-nonzero |
                    assume not (h = ZEROP) {
                      @h-is-nonzero |
                        not (h = ZEROP)
                        [by hypothesis given-h-is-nonzero]
                      @the-multiple-is-not-small |
                        not less_than(degree(mulP(g, h)), degree(g))
                        [using specialize aNonzeroMultipleHasAtLeastTheDegree(g, h) g-nonzero h-is-nonzero]
                      @contradiction |
                        h = ZEROP
                        [by ex_falso the-multiple-is-small the-multiple-is-not-small]
                    }
                  @nonzero-is-absurd |
                    (not (h = ZEROP)) -> h = ZEROP
                    [by discharge given-h-is-nonzero]
                  @conclusion-the-multiple-is-zero |
                    h = ZEROP
                    [using tautology nonzero-is-absurd]
                }
              @small-implies-zero |
                less_than(degree(mulP(g, h)), degree(g)) -> h = ZEROP
                [by discharge given-the-multiple-is-small]
            }
          @g-nonzero-implies-zero |
            (not (g = ZEROP)) -> less_than(degree(mulP(g, h)), degree(g)) -> h = ZEROP
            [by discharge given-g-nonzero]
        }
      @discharge-h |
        forall h: Poly;
          (not (g = ZEROP)) -> less_than(degree(mulP(g, h)), degree(g)) -> h = ZEROP
        [by generalize generalize-h]
    }
  @conclusion |
    forall g, h: Poly;
      (not (g = ZEROP)) -> less_than(degree(mulP(g, h)), degree(g)) -> h = ZEROP
    [by generalize generalize-g]
qed

// == WHAT IS NOT HERE ====================================================================
//
// §17.2's DIVISION ALGORITHM IS COMPLETE, both halves.
//
// THE FACTOR THEOREM (his first corollary): its CONVERSE is proved
// (`theProductVanishesAtTheRoot`), and the FORWARD direction's algebra is proved
// (`theRemainderVanishesAtTheRoot` plus `aVanishingConstantIsZero`). What is NOT done is
// assembling the forward direction into one statement, and the obstacle is bookkeeping
// rather than mathematics:
//
//   `theRemainderVanishesAtTheRoot` takes the common evaluation BOUND as a hypothesis. To
//   discharge it, all three of `p`, the product, and the remainder must be evaluated at ONE
//   bound. `evaluationStabilizesPastTheBound` lifts each to a larger bound, so the remaining
//   step is to show that bound can be chosen — which needs `degree(p) = degree(product)`
//   once the remainder is a constant. That is a degree argument, not an evaluation one.
//
// AT MOST n ZEROS (his second corollary) inducts using the factor theorem, so it follows.
// §17.3 (irreducibles, Gauss's Lemma, Eisenstein) rests on both.
//
// Still open and unrelated: multiplicative ASSOCIATIVITY of a polynomial ring, which needs a
// double-sum flattening. Note the factor theorem NO LONGER needs it — the telescoping route
// (`theTelescopingPartialSum`) got around it for the one product that mattered, so
// associativity is now the only consumer of that missing lemma.
//
// NOTE ON ORGANIZATION (user direction, 2026-10-29): the eventual std shape for polynomials
// is Judson's CHAPTER 20 construction, `F[x]` as a VECTOR SPACE over `F`. The `R[x]` model
// above is the interim mechanism — it buys §17.1's ring laws without duplicating them.
