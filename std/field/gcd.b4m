// std/field/gcd.b4m — GREATEST COMMON DIVISORS IN F[x].
//
// Judson's Proposition 17.10: a gcd is a linear combination of its arguments, and is
// unique. His first paragraph takes `d` to be the monic polynomial of SMALLEST DEGREE in
// the set of all combinations, which needs a least element of a set of polynomials -- the
// comprehension limit §16.4 also meets. So minimality is a HYPOTHESIS here rather than a
// construction, the idiom §17.3's principal-ideal theorem uses: given a combination that
// divides both arguments, it IS a gcd; and any two gcds divide each other.
//
// His second paragraph's algebra d = rp + sq = rud' + svd' = d'[ru + sv] needs F[x]
// multiplicative associativity, which is his §17.1 exercise and is proved in
// std/field/polynomial-associativity.b4m.
import fieldpoly <<< "std/field/polynomial.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import monic <<< "std/field/monic.b4m"

sort Poly = fieldpoly.Poly
func addP = fieldpoly.addP
func mulP = fieldpoly.mulP
func negP = fieldpoly.negP
const ZEROP = fieldpoly.ZEROP
func degree = fieldpoly.degree

// `d` divides `p`: some cofactor multiplies it to p.
pred dividesP(d: Poly, p: Poly)
axiom dividesMeansACofactorExists: forall d, p: Poly;
  dividesP(d, p) iff (exists u: Poly; p = mulP(u, d))

// the constant polynomial 1, which a monic gcd of coprime polynomials equals
func ONEP = fieldpoly.monomialOne

// Judson's definition: d is a greatest common divisor of p and q when it divides both,
// and every other common divisor divides it.
pred isAGcd(d: Poly, p: Poly, q: Poly)
axiom gcdMeansGreatestCommonDivisor: forall d, p, q: Poly;
  isAGcd(d, p, q) iff
  (dividesP(d, p) and dividesP(d, q) and
  (forall e: Poly; dividesP(e, p) -> dividesP(e, q) -> dividesP(e, d)))

// `f` is a linear combination of p and q
pred isACombination(f: Poly, p: Poly, q: Poly)
axiom combinationMeansRPPlusSQ: forall f, p, q: Poly;
  isACombination(f, p, q) iff
  (exists r: Poly; exists s: Poly; f = addP(mulP(r, p), mulP(s, q)))

// -- his second paragraph: a common divisor divides any combination ------------------------
//
// "Since $d'(x)$ is a common divisor of $p(x)$ and $q(x)$, there exist polynomials $u(x)$
// and $v(x)$ such that $p(x) = u(x) d'(x)$ and $q(x) = v(x) d'(x)$. Therefore,
//     d = r p + s q = r u d' + s v d' = d' [r u + s v].
// Since $d'(x) \mid d(x)$, $d(x)$ is a greatest common divisor."
//
// Note this needs NO minimality: it is pure ring algebra, so it transliterates directly.
theorem aCommonDivisorDividesEveryCombination: forall e, p, q, f: Poly;
  dividesP(e, p) -> dividesP(e, q) -> isACombination(f, p, q) -> dividesP(e, f)
proof
  @generalize-e |
    fix e: Poly {
      @generalize-p |
        fix p: Poly {
          @generalize-q |
            fix q: Poly {
              @generalize-f |
                fix f: Poly {
                  @given-e-divides-p |
                    assume dividesP(e, p) {
                      @e-divides-p |
                        dividesP(e, p)
                        [by hypothesis given-e-divides-p]
                      @given-e-divides-q |
                        assume dividesP(e, q) {
                          @e-divides-q |
                            dividesP(e, q)
                            [by hypothesis given-e-divides-q]
                          @given-f-is-a-combination |
                            assume isACombination(f, p, q) {
                              @f-is-a-combination |
                                isACombination(f, p, q)
                                [by hypothesis given-f-is-a-combination]
                              // unfold all three definitions
                              @divides-p-unfolds |
                                dividesP(e, p) iff (exists u: Poly; p = mulP(u, e))
                                [using specialize dividesMeansACofactorExists(e, p)]
                              @a-cofactor-for-p-exists |
                                exists u: Poly; p = mulP(u, e)
                                [using tautology divides-p-unfolds e-divides-p]
                              @divides-q-unfolds |
                                dividesP(e, q) iff (exists u: Poly; q = mulP(u, e))
                                [using specialize dividesMeansACofactorExists(e, q)]
                              @a-cofactor-for-q-exists |
                                exists u: Poly; q = mulP(u, e)
                                [using tautology divides-q-unfolds e-divides-q]
                              @combination-unfolds |
                                isACombination(f, p, q) iff
                                  (exists r: Poly; exists s: Poly;
                                  f = addP(mulP(r, p), mulP(s, q)))
                                [using specialize combinationMeansRPPlusSQ(f, p, q)]
                              @the-coefficients-exist |
                                exists r: Poly; exists s: Poly;
                                  f = addP(mulP(r, p), mulP(s, q))
                                [using tautology combination-unfolds f-is-a-combination]
                              @with-the-cofactor-u |
                                unpack u: Poly from a-cofactor-for-p-exists {
                                  @p-is-u-times-e |
                                    p = mulP(u, e)
                                    [by hypothesis with-the-cofactor-u]
                                  @with-the-cofactor-v |
                                    unpack v: Poly from a-cofactor-for-q-exists {
                                      @q-is-v-times-e |
                                        q = mulP(v, e)
                                        [by hypothesis with-the-cofactor-v]
                                      @with-the-coefficient-r |
                                        unpack r: Poly from the-coefficients-exist {
                                          @a-second-coefficient-exists |
                                            exists s: Poly;
                                              f = addP(mulP(r, p), mulP(s, q))
                                            [by hypothesis with-the-coefficient-r]
                                          @with-the-coefficient-s |
                                            unpack s: Poly from a-second-coefficient-exists {
                                              @f-is-the-combination |
                                                f = addP(mulP(r, p), mulP(s, q))
                                                [by hypothesis with-the-coefficient-s]
                                              // substitute p = u e and q = v e
                                              @f-in-terms-of-e |
                                                f = addP(mulP(r, mulP(u, e)),
                                                  mulP(s, mulP(v, e)))
                                                [using simplify f-is-the-combination p-is-u-times-e q-is-v-times-e]
                                              // and factor e out: r(ue) + s(ve) = (ru + sv)e
                                              @factoring-e-out |
                                                addP(mulP(r, mulP(u, e)),
                                                  mulP(s, mulP(v, e))) =
                                                  mulP(addP(mulP(r, u), mulP(s, v)), e)
                                                [using specialize theCombinationFactors(r, s, u, v, e)]
                                              @f-is-a-multiple-of-e |
                                                f = mulP(addP(mulP(r, u), mulP(s, v)), e)
                                                [using chain f-in-terms-of-e factoring-e-out]
                                              @a-cofactor-for-f-exists |
                                                exists w: Poly; f = mulP(w, e)
                                                [by witness(addP(mulP(r, u), mulP(s, v))) f-is-a-multiple-of-e]
                                              @divides-f-unfolds |
                                                dividesP(e, f) iff
                                                  (exists u2: Poly; f = mulP(u2, e))
                                                [using specialize dividesMeansACofactorExists(e, f)]
                                              @conclusion-e-divides-f |
                                                dividesP(e, f)
                                                [using tautology divides-f-unfolds a-cofactor-for-f-exists]
                                            }
                                          @conclusion-from-s |
                                            dividesP(e, f)
                                            [by unpacked with-the-coefficient-s]
                                        }
                                      @conclusion-from-r |
                                        dividesP(e, f)
                                        [by unpacked with-the-coefficient-r]
                                    }
                                  @conclusion-from-v |
                                    dividesP(e, f)
                                    [by unpacked with-the-cofactor-v]
                                }
                              @conclusion-from-u |
                                dividesP(e, f)
                                [by unpacked with-the-cofactor-u]
                            }
                          @combination-implies |
                            isACombination(f, p, q) -> dividesP(e, f)
                            [by discharge given-f-is-a-combination]
                        }
                      @divides-q-implies |
                        dividesP(e, q) -> isACombination(f, p, q) -> dividesP(e, f)
                        [by discharge given-e-divides-q]
                    }
                  @divides-p-implies |
                    dividesP(e, p) -> dividesP(e, q) -> isACombination(f, p, q) ->
                      dividesP(e, f)
                    [by discharge given-e-divides-p]
                }
              @discharge-f |
                forall f9: Poly;
                  dividesP(e, p) -> dividesP(e, q) -> isACombination(f9, p, q) ->
                  dividesP(e, f9)
                [by generalize generalize-f]
            }
          @discharge-q |
            forall q9, f9: Poly;
              dividesP(e, p) -> dividesP(e, q9) -> isACombination(f9, p, q9) ->
              dividesP(e, f9)
            [by generalize generalize-q]
        }
      @discharge-p |
        forall p9, q9, f9: Poly;
          dividesP(e, p9) -> dividesP(e, q9) -> isACombination(f9, p9, q9) ->
          dividesP(e, f9)
        [by generalize generalize-p]
    }
  @conclusion |
    forall e, p, q, f: Poly;
      dividesP(e, p) -> dividesP(e, q) -> isACombination(f, p, q) -> dividesP(e, f)
    [by generalize generalize-e]
qed

// F[x] distributes on the RIGHT too: the left form plus commutativity. std/field has only
// the left form, which the ring model supplies.
theorem distributingOnTheRight: forall a, b, c: Poly;
  mulP(addP(a, b), c) = addP(mulP(a, c), mulP(b, c))
proof
  @generalize-a |
    fix a: Poly {
      @generalize-b |
        fix b: Poly {
          @generalize-c |
            fix c: Poly {
              @commute-the-outer-product |
                mulP(addP(a, b), c) = mulP(c, addP(a, b))
                [using specialize fieldpoly.polyMulIsCommutative(addP(a, b), c)]
              @distribute-on-the-left |
                mulP(c, addP(a, b)) = addP(mulP(c, a), mulP(c, b))
                [using specialize fieldpoly.polyMulAddDistribLeft(c, a, b)]
              @commute-the-first-summand |
                mulP(c, a) = mulP(a, c)
                [using specialize fieldpoly.polyMulIsCommutative(c, a)]
              @commute-the-second-summand |
                mulP(c, b) = mulP(b, c)
                [using specialize fieldpoly.polyMulIsCommutative(c, b)]
              @the-distribution-commuted |
                mulP(c, addP(a, b)) = addP(mulP(a, c), mulP(b, c))
                [using simplify distribute-on-the-left commute-the-first-summand commute-the-second-summand]
              @conclusion-right-distribution |
                mulP(addP(a, b), c) = addP(mulP(a, c), mulP(b, c))
                [using chain commute-the-outer-product the-distribution-commuted]
            }
          @discharge-c |
            forall c9: Poly;
              mulP(addP(a, b), c9) = addP(mulP(a, c9), mulP(b, c9))
            [by generalize generalize-c]
        }
      @discharge-b |
        forall b9, c9: Poly;
          mulP(addP(a, b9), c9) = addP(mulP(a, c9), mulP(b9, c9))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, c: Poly;
      mulP(addP(a, b), c) = addP(mulP(a, c), mulP(b, c))
    [by generalize generalize-a]
qed

// r(ue) + s(ve) = (ru + sv)e needs mulP to be ASSOCIATIVE -- Judson's own §17.1 exercise,
// now proved in std/field/polynomial-associativity.b4m by re-proving the double-sum
// exchange at the concrete coefficient family.
fact polyMulIsAssociative = fieldpoly.polyMulIsAssociative

theorem theCombinationFactors: forall r, s, u, v, e: Poly;
  addP(mulP(r, mulP(u, e)), mulP(s, mulP(v, e))) = mulP(addP(mulP(r, u), mulP(s, v)), e)
proof
  @generalize-r |
    fix r: Poly {
      @generalize-s |
        fix s: Poly {
          @generalize-u |
            fix u: Poly {
              @generalize-v |
                fix v: Poly {
                  @generalize-e |
                    fix e: Poly {
                      // regroup each product, then collect by distributivity
                      @the-first-product-regroups |
                        mulP(mulP(r, u), e) = mulP(r, mulP(u, e))
                        [using specialize polyMulIsAssociative(r, u, e)]
                      @the-second-product-regroups |
                        mulP(mulP(s, v), e) = mulP(s, mulP(v, e))
                        [using specialize polyMulIsAssociative(s, v, e)]
                      @distributing-e |
                        mulP(addP(mulP(r, u), mulP(s, v)), e) =
                          addP(mulP(mulP(r, u), e), mulP(mulP(s, v), e))
                        [using specialize distributingOnTheRight(mulP(r, u), mulP(s, v), e)]
                      @the-target-expanded |
                        mulP(addP(mulP(r, u), mulP(s, v)), e) =
                          addP(mulP(r, mulP(u, e)), mulP(s, mulP(v, e)))
                        [using simplify distributing-e the-first-product-regroups the-second-product-regroups]
                      @conclusion-the-combination-factors |
                        addP(mulP(r, mulP(u, e)), mulP(s, mulP(v, e))) =
                          mulP(addP(mulP(r, u), mulP(s, v)), e)
                        [by symmetry the-target-expanded]
                    }
                  @discharge-e |
                    forall e9: Poly;
                      addP(mulP(r, mulP(u, e9)), mulP(s, mulP(v, e9))) =
                      mulP(addP(mulP(r, u), mulP(s, v)), e9)
                    [by generalize generalize-e]
                }
              @discharge-v |
                forall v9, e9: Poly;
                  addP(mulP(r, mulP(u, e9)), mulP(s, mulP(v9, e9))) =
                  mulP(addP(mulP(r, u), mulP(s, v9)), e9)
                [by generalize generalize-v]
            }
          @discharge-u |
            forall u9, v9, e9: Poly;
              addP(mulP(r, mulP(u9, e9)), mulP(s, mulP(v9, e9))) =
              mulP(addP(mulP(r, u9), mulP(s, v9)), e9)
            [by generalize generalize-u]
        }
      @discharge-s |
        forall s9, u9, v9, e9: Poly;
          addP(mulP(r, mulP(u9, e9)), mulP(s9, mulP(v9, e9))) =
          mulP(addP(mulP(r, u9), mulP(s9, v9)), e9)
        [by generalize generalize-s]
    }
  @conclusion |
    forall r, s, u, v, e: Poly;
      addP(mulP(r, mulP(u, e)), mulP(s, mulP(v, e))) =
      mulP(addP(mulP(r, u), mulP(s, v)), e)
    [by generalize generalize-r]
qed

// -- his second paragraph's conclusion -----------------------------------------------------
//
// "To show that $d(x)$ is a greatest common divisor of $p(x)$ and $q(x)$, suppose that
// $d'(x)$ is another common divisor. We will show that $d'(x) \mid d(x)$." With the lemma
// above that is immediate: a common divisor divides every combination, and d IS one.
theorem aCombinationThatDividesBothIsAGcd: forall d, p, q: Poly;
  dividesP(d, p) -> dividesP(d, q) -> isACombination(d, p, q) -> isAGcd(d, p, q)
proof
  @generalize-d |
    fix d: Poly {
      @generalize-p |
        fix p: Poly {
          @generalize-q |
            fix q: Poly {
              @given-d-divides-p |
                assume dividesP(d, p) {
                  @d-divides-p |
                    dividesP(d, p)
                    [by hypothesis given-d-divides-p]
                  @given-d-divides-q |
                    assume dividesP(d, q) {
                      @d-divides-q |
                        dividesP(d, q)
                        [by hypothesis given-d-divides-q]
                      @given-d-is-a-combination |
                        assume isACombination(d, p, q) {
                          @d-is-a-combination |
                            isACombination(d, p, q)
                            [by hypothesis given-d-is-a-combination]
                          // every common divisor divides d, since d is a combination
                          @generalize-e |
                            fix e: Poly {
                              @given-e-divides-p |
                                assume dividesP(e, p) {
                                  @e-divides-p |
                                    dividesP(e, p)
                                    [by hypothesis given-e-divides-p]
                                  @given-e-divides-q |
                                    assume dividesP(e, q) {
                                      @e-divides-q |
                                        dividesP(e, q)
                                        [by hypothesis given-e-divides-q]
                                      @conclusion-e-divides-d |
                                        dividesP(e, d)
                                        [using specialize aCommonDivisorDividesEveryCombination(e, p, q, d) e-divides-p e-divides-q d-is-a-combination]
                                    }
                                  @e-divides-q-implies |
                                    dividesP(e, q) -> dividesP(e, d)
                                    [by discharge given-e-divides-q]
                                }
                              @conclusion-e-is-a-divisor-of-d |
                                dividesP(e, p) -> dividesP(e, q) -> dividesP(e, d)
                                [by discharge given-e-divides-p]
                            }
                          @every-common-divisor-divides-d |
                            forall e: Poly;
                              dividesP(e, p) -> dividesP(e, q) -> dividesP(e, d)
                            [by generalize generalize-e]
                          @the-two-divisibilities |
                            dividesP(d, p) and dividesP(d, q)
                            [by both d-divides-p d-divides-q]
                          @the-three-conjuncts |
                            dividesP(d, p) and dividesP(d, q) and
                              (forall e: Poly;
                              dividesP(e, p) -> dividesP(e, q) -> dividesP(e, d))
                            [by both the-two-divisibilities every-common-divisor-divides-d]
                          @gcd-unfolds |
                            isAGcd(d, p, q) iff
                              (dividesP(d, p) and dividesP(d, q) and
                              (forall e: Poly;
                              dividesP(e, p) -> dividesP(e, q) -> dividesP(e, d)))
                            [using specialize gcdMeansGreatestCommonDivisor(d, p, q)]
                          @conclusion-d-is-a-gcd |
                            isAGcd(d, p, q)
                            [using tautology gcd-unfolds the-three-conjuncts]
                        }
                      @combination-implies |
                        isACombination(d, p, q) -> isAGcd(d, p, q)
                        [by discharge given-d-is-a-combination]
                    }
                  @divides-q-implies |
                    dividesP(d, q) -> isACombination(d, p, q) -> isAGcd(d, p, q)
                    [by discharge given-d-divides-q]
                }
              @divides-p-implies |
                dividesP(d, p) -> dividesP(d, q) -> isACombination(d, p, q) ->
                  isAGcd(d, p, q)
                [by discharge given-d-divides-p]
            }
          @discharge-q |
            forall q9: Poly;
              dividesP(d, p) -> dividesP(d, q9) -> isACombination(d, p, q9) ->
              isAGcd(d, p, q9)
            [by generalize generalize-q]
        }
      @discharge-p |
        forall p9, q9: Poly;
          dividesP(d, p9) -> dividesP(d, q9) -> isACombination(d, p9, q9) ->
          isAGcd(d, p9, q9)
        [by generalize generalize-p]
    }
  @conclusion |
    forall d, p, q: Poly;
      dividesP(d, p) -> dividesP(d, q) -> isACombination(d, p, q) -> isAGcd(d, p, q)
    [by generalize generalize-d]
qed

// -- his third paragraph: two gcds divide each other ---------------------------------------
//
// "Suppose that $d'(x)$ is another greatest common divisor of $p(x)$ and $q(x)$." Each
// being a gcd and the other a common divisor, each divides the other. His finish --
// $\deg d = \deg d'$, both monic, hence equal -- is the degree argument below.
theorem twoGcdsDivideEachOther: forall d, e, p, q: Poly;
  isAGcd(d, p, q) -> isAGcd(e, p, q) -> (dividesP(d, e) and dividesP(e, d))
proof
  @generalize-d |
    fix d: Poly {
      @generalize-e |
        fix e: Poly {
          @generalize-p |
            fix p: Poly {
              @generalize-q |
                fix q: Poly {
                  @given-d-is-a-gcd |
                    assume isAGcd(d, p, q) {
                      @d-is-a-gcd |
                        isAGcd(d, p, q)
                        [by hypothesis given-d-is-a-gcd]
                      @given-e-is-a-gcd |
                        assume isAGcd(e, p, q) {
                          @e-is-a-gcd |
                            isAGcd(e, p, q)
                            [by hypothesis given-e-is-a-gcd]
                          @d-gcd-unfolds |
                            isAGcd(d, p, q) iff
                              (dividesP(d, p) and dividesP(d, q) and
                              (forall e2: Poly;
                              dividesP(e2, p) -> dividesP(e2, q) -> dividesP(e2, d)))
                            [using specialize gcdMeansGreatestCommonDivisor(d, p, q)]
                          @e-gcd-unfolds |
                            isAGcd(e, p, q) iff
                              (dividesP(e, p) and dividesP(e, q) and
                              (forall e2: Poly;
                              dividesP(e2, p) -> dividesP(e2, q) -> dividesP(e2, e)))
                            [using specialize gcdMeansGreatestCommonDivisor(e, p, q)]
                          @d-facts |
                            dividesP(d, p) and dividesP(d, q) and
                              (forall e2: Poly;
                              dividesP(e2, p) -> dividesP(e2, q) -> dividesP(e2, d))
                            [using tautology d-gcd-unfolds d-is-a-gcd]
                          @e-facts |
                            dividesP(e, p) and dividesP(e, q) and
                              (forall e2: Poly;
                              dividesP(e2, p) -> dividesP(e2, q) -> dividesP(e2, e))
                            [using tautology e-gcd-unfolds e-is-a-gcd]
                          @d-is-a-common-divisor |
                            dividesP(d, p) and dividesP(d, q)
                            [by and_lhs d-facts]
                          @d-divides-p |
                            dividesP(d, p)
                            [by and_lhs d-is-a-common-divisor]
                          @d-divides-q |
                            dividesP(d, q)
                            [by and_rhs d-is-a-common-divisor]
                          @e-is-a-common-divisor |
                            dividesP(e, p) and dividesP(e, q)
                            [by and_lhs e-facts]
                          @e-divides-p |
                            dividesP(e, p)
                            [by and_lhs e-is-a-common-divisor]
                          @e-divides-q |
                            dividesP(e, q)
                            [by and_rhs e-is-a-common-divisor]
                          // each gcd absorbs the other common divisor
                          @e-absorbs-common-divisors |
                            forall e2: Poly;
                              dividesP(e2, p) -> dividesP(e2, q) -> dividesP(e2, e)
                            [by and_rhs e-facts]
                          @d-absorbs-common-divisors |
                            forall e2: Poly;
                              dividesP(e2, p) -> dividesP(e2, q) -> dividesP(e2, d)
                            [by and_rhs d-facts]
                          @d-divides-e |
                            dividesP(d, e)
                            [using specialize e-absorbs-common-divisors(d) d-divides-p d-divides-q]
                          @e-divides-d |
                            dividesP(e, d)
                            [using specialize d-absorbs-common-divisors(e) e-divides-p e-divides-q]
                          @conclusion-they-divide-each-other |
                            dividesP(d, e) and dividesP(e, d)
                            [by both d-divides-e e-divides-d]
                        }
                      @e-gcd-implies |
                        isAGcd(e, p, q) -> (dividesP(d, e) and dividesP(e, d))
                        [by discharge given-e-is-a-gcd]
                    }
                  @d-gcd-implies |
                    isAGcd(d, p, q) -> isAGcd(e, p, q) ->
                      (dividesP(d, e) and dividesP(e, d))
                    [by discharge given-d-is-a-gcd]
                }
              @discharge-q |
                forall q9: Poly;
                  isAGcd(d, p, q9) -> isAGcd(e, p, q9) ->
                  (dividesP(d, e) and dividesP(e, d))
                [by generalize generalize-q]
            }
          @discharge-p |
            forall p9, q9: Poly;
              isAGcd(d, p9, q9) -> isAGcd(e, p9, q9) ->
              (dividesP(d, e) and dividesP(e, d))
            [by generalize generalize-p]
        }
      @discharge-e |
        forall e9, p9, q9: Poly;
          isAGcd(d, p9, q9) -> isAGcd(e9, p9, q9) ->
          (dividesP(d, e9) and dividesP(e9, d))
        [by generalize generalize-e]
    }
  @conclusion |
    forall d, e, p, q: Poly;
      isAGcd(d, p, q) -> isAGcd(e, p, q) -> (dividesP(d, e) and dividesP(e, d))
    [by generalize generalize-d]
qed

// -- HIS FIRST PARAGRAPH: THE MINIMAL COMBINATION EXISTS -------------------------------------
// "Let $d(x)$ be the monic polynomial of smallest degree in the set
// $S = \{f(x)p(x) + g(x)q(x)\}$."
//
// The note on this theorem used to say minimality needed a least element of a SET of
// polynomials — the comprehension limit — and so had to be assumed. That is NOT so: what the
// argument well-orders is the DEGREES, which are naturals, and ℕ is well-ordered with no
// comprehension at all. `peano_order.wellOrdering` is a schema over a predicate on `Nat`, and
// its `prop` may close over `p` and `q` the way `permutation/period.b4m` closes over its own
// context.

// Step one: if a nonzero combination exists, some natural is the degree of one.
theorem someCombinationDegreeIsAttained: forall p, q: Poly;
  (exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))) ->
  (exists n: peano.Nat; exists f: Poly;
  isACombination(f, p, q) and (not (f = fieldpoly.ZEROP)) and
  fieldpoly.degree(f) = n)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @given-a-nonzero-combination |
            assume exists f: Poly;
              isACombination(f, p, q) and (not (f = fieldpoly.ZEROP)) {
              @a-nonzero-combination |
                exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))
                [by hypothesis given-a-nonzero-combination]
              @with-a-combination-f |
                unpack f: Poly from a-nonzero-combination {
                  @the-combination-properties |
                    isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))
                    [by hypothesis with-a-combination-f]
                  @its-degree-is-its-degree |
                    fieldpoly.degree(f) = fieldpoly.degree(f)
                    [by reflexivity]
                  @f-attains-its-degree |
                    isACombination(f, p, q) and (not (f = fieldpoly.ZEROP)) and
                      fieldpoly.degree(f) = fieldpoly.degree(f)
                    [by both the-combination-properties its-degree-is-its-degree]
                  @some-combination-attains-it |
                    exists g: Poly; isACombination(g, p, q) and
                      (not (g = fieldpoly.ZEROP)) and
                      fieldpoly.degree(g) = fieldpoly.degree(f)
                    [by witness(f) f-attains-its-degree]
                  @conclusion-some-degree-is-attained |
                    exists n: peano.Nat; exists g: Poly;
                      isACombination(g, p, q) and (not (g = fieldpoly.ZEROP)) and
                      fieldpoly.degree(g) = n
                    [by witness(fieldpoly.degree(f)) some-combination-attains-it]
                }
              @the-degree-is-attained |
                exists n: peano.Nat; exists f: Poly;
                  isACombination(f, p, q) and (not (f = fieldpoly.ZEROP)) and
                  fieldpoly.degree(f) = n
                [by unpacked with-a-combination-f]
            }
          @conclusion-a-nonzero-combination-gives-it |
            (exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))) ->
              (exists n: peano.Nat; exists f: Poly;
              isACombination(f, p, q) and (not (f = fieldpoly.ZEROP)) and
              fieldpoly.degree(f) = n)
            [by discharge given-a-nonzero-combination]
        }
      @conclusion-for-all-q |
        forall q: Poly;
          (exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))) ->
          (exists n: peano.Nat; exists f: Poly;
          isACombination(f, p, q) and (not (f = fieldpoly.ZEROP)) and
          fieldpoly.degree(f) = n)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly;
      (exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))) ->
      (exists n: peano.Nat; exists f: Poly;
      isACombination(f, p, q) and (not (f = fieldpoly.ZEROP)) and
      fieldpoly.degree(f) = n)
    [by generalize generalize-p]
qed

// The bridge from "least among the ATTAINED degrees" to "at most every other nonzero
// combination's degree": any such `g` attains its own degree, so leastness applies at it.
theorem everyOtherCombinationIsAtLeastAsBig: forall p, q, d: Poly; forall least: peano.Nat;
  fieldpoly.degree(d) = least ->
  (forall m: peano.Nat;
  (exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP)) and
  fieldpoly.degree(f) = m) ->
  peano_order.less_or_equal(least, m)) ->
  (forall g: Poly; isACombination(g, p, q) -> (not (g = fieldpoly.ZEROP)) ->
  peano_order.less_or_equal(fieldpoly.degree(d), fieldpoly.degree(g)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-d |
            fix d: Poly {
              @generalize-least |
                fix least: peano.Nat {
                  @given-the-degree |
                    assume fieldpoly.degree(d) = least {
                      @the-degree |
                        fieldpoly.degree(d) = least
                        [by hypothesis given-the-degree]
                      @given-leastness |
                        assume forall m: peano.Nat;
                          (exists f: Poly; isACombination(f, p, q) and
                          (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
                          peano_order.less_or_equal(least, m) {
                          @leastness |
                            forall m: peano.Nat;
                              (exists f: Poly; isACombination(f, p, q) and
                              (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
                              peano_order.less_or_equal(least, m)
                            [by hypothesis given-leastness]
                          @generalize-g |
                            fix g: Poly {
                              @given-g-is-a-nonzero-combination |
                                assume isACombination(g, p, q) {
                                  @g-is-a-combination |
                                    isACombination(g, p, q)
                                    [by hypothesis given-g-is-a-nonzero-combination]
                                  @given-g-nonzero |
                                    assume not (g = fieldpoly.ZEROP) {
                                      @g-is-nonzero |
                                        not (g = fieldpoly.ZEROP)
                                        [by hypothesis given-g-nonzero]
                                      @g-degree-is-itself |
                                        fieldpoly.degree(g) = fieldpoly.degree(g)
                                        [by reflexivity]
                                      @g-attains-its-degree |
                                        isACombination(g, p, q) and
                                          (not (g = fieldpoly.ZEROP)) and
                                          fieldpoly.degree(g) = fieldpoly.degree(g)
                                        [using tautology g-is-a-combination g-is-nonzero
                                          g-degree-is-itself]
                                      @g-degree-is-attained |
                                        exists f: Poly; isACombination(f, p, q) and
                                          (not (f = fieldpoly.ZEROP)) and
                                          fieldpoly.degree(f) = fieldpoly.degree(g)
                                        [by witness(g) g-attains-its-degree]
                                      @least-is-below-g |
                                        peano_order.less_or_equal(
                                          least, fieldpoly.degree(g))
                                        [using specialize leastness(fieldpoly.degree(g))
                                          g-degree-is-attained]
                                      @conclusion-d-is-below-g |
                                        peano_order.less_or_equal(
                                          fieldpoly.degree(d), fieldpoly.degree(g))
                                        [by rewrite the-degree least-is-below-g]
                                    }
                                  @conclusion-g-nonzero-gives-it |
                                    (not (g = fieldpoly.ZEROP)) ->
                                      peano_order.less_or_equal(
                                      fieldpoly.degree(d), fieldpoly.degree(g))
                                    [by discharge given-g-nonzero]
                                }
                              @conclusion-g-combination-gives-it |
                                isACombination(g, p, q) ->
                                  (not (g = fieldpoly.ZEROP)) ->
                                  peano_order.less_or_equal(
                                  fieldpoly.degree(d), fieldpoly.degree(g))
                                [by discharge given-g-is-a-nonzero-combination]
                            }
                          @conclusion-for-all-g |
                            forall g: Poly; isACombination(g, p, q) ->
                              (not (g = fieldpoly.ZEROP)) ->
                              peano_order.less_or_equal(
                              fieldpoly.degree(d), fieldpoly.degree(g))
                            [by generalize generalize-g]
                        }
                      @conclusion-leastness-gives-it |
                        (forall m: peano.Nat;
                          (exists f: Poly; isACombination(f, p, q) and
                          (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
                          peano_order.less_or_equal(least, m)) ->
                          (forall g: Poly; isACombination(g, p, q) ->
                          (not (g = fieldpoly.ZEROP)) ->
                          peano_order.less_or_equal(
                          fieldpoly.degree(d), fieldpoly.degree(g)))
                        [by discharge given-leastness]
                    }
                  @conclusion-the-degree-gives-it |
                    fieldpoly.degree(d) = least ->
                      (forall m: peano.Nat;
                      (exists f: Poly; isACombination(f, p, q) and
                      (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
                      peano_order.less_or_equal(least, m)) ->
                      (forall g: Poly; isACombination(g, p, q) ->
                      (not (g = fieldpoly.ZEROP)) ->
                      peano_order.less_or_equal(
                      fieldpoly.degree(d), fieldpoly.degree(g)))
                    [by discharge given-the-degree]
                }
              @conclusion-for-all-least |
                forall least: peano.Nat;
                  fieldpoly.degree(d) = least ->
                  (forall m: peano.Nat;
                  (exists f: Poly; isACombination(f, p, q) and
                  (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
                  peano_order.less_or_equal(least, m)) ->
                  (forall g: Poly; isACombination(g, p, q) ->
                  (not (g = fieldpoly.ZEROP)) ->
                  peano_order.less_or_equal(fieldpoly.degree(d), fieldpoly.degree(g)))
                [by generalize generalize-least]
            }
          @conclusion-for-all-d |
            forall d: Poly; forall least: peano.Nat;
              fieldpoly.degree(d) = least ->
              (forall m: peano.Nat;
              (exists f: Poly; isACombination(f, p, q) and
              (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
              peano_order.less_or_equal(least, m)) ->
              (forall g: Poly; isACombination(g, p, q) ->
              (not (g = fieldpoly.ZEROP)) ->
              peano_order.less_or_equal(fieldpoly.degree(d), fieldpoly.degree(g)))
            [by generalize generalize-d]
        }
      @conclusion-for-all-q |
        forall q, d: Poly; forall least: peano.Nat;
          fieldpoly.degree(d) = least ->
          (forall m: peano.Nat;
          (exists f: Poly; isACombination(f, p, q) and
          (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
          peano_order.less_or_equal(least, m)) ->
          (forall g: Poly; isACombination(g, p, q) ->
          (not (g = fieldpoly.ZEROP)) ->
          peano_order.less_or_equal(fieldpoly.degree(d), fieldpoly.degree(g)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, d: Poly; forall least: peano.Nat;
      fieldpoly.degree(d) = least ->
      (forall m: peano.Nat;
      (exists f: Poly; isACombination(f, p, q) and
      (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
      peano_order.less_or_equal(least, m)) ->
      (forall g: Poly; isACombination(g, p, q) ->
      (not (g = fieldpoly.ZEROP)) ->
      peano_order.less_or_equal(fieldpoly.degree(d), fieldpoly.degree(g)))
    [by generalize generalize-p]
qed

// Step two: well-order those degrees. `prop(n)` is "some nonzero combination of p and q has
// degree n", closing over `p` and `q`; the least such `n` is realized by a combination, and
// every other nonzero combination's degree is at least it.
theorem aMinimalDegreeCombinationExists: forall p, q: Poly;
  (exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))) ->
  (exists d: Poly; isACombination(d, p, q) and (not (d = fieldpoly.ZEROP)) and
  (forall g: Poly; isACombination(g, p, q) -> (not (g = fieldpoly.ZEROP)) ->
  peano_order.less_or_equal(fieldpoly.degree(d), fieldpoly.degree(g))))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @given-a-nonzero-combination |
            assume exists f: Poly;
              isACombination(f, p, q) and (not (f = fieldpoly.ZEROP)) {
              @a-nonzero-combination |
                exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))
                [by hypothesis given-a-nonzero-combination]
              @some-degree-is-attained |
                exists n: peano.Nat; exists f: Poly;
                  isACombination(f, p, q) and (not (f = fieldpoly.ZEROP)) and
                  fieldpoly.degree(f) = n
                [using specialize someCombinationDegreeIsAttained(p, q)
                  a-nonzero-combination]
              @the-least-attained-degree |
                exists least: peano.Nat;
                  (exists f: Poly; isACombination(f, p, q) and
                  (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = least) and
                  (forall m: peano.Nat;
                  (exists f: Poly; isACombination(f, p, q) and
                  (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
                  peano_order.less_or_equal(least, m))
                [using instantiation peano_order.wellOrdering((fun n: peano.Nat =>
                  (exists f: Poly; isACombination(f, p, q) and
                  (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = n)))
                  some-degree-is-attained]
              @with-the-least-degree |
                unpack least: peano.Nat from the-least-attained-degree {
                  @the-least-properties |
                    (exists f: Poly; isACombination(f, p, q) and
                      (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = least) and
                      (forall m: peano.Nat;
                      (exists f: Poly; isACombination(f, p, q) and
                      (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
                      peano_order.less_or_equal(least, m))
                    [by hypothesis with-the-least-degree]
                  @the-least-is-realized |
                    exists f: Poly; isACombination(f, p, q) and
                      (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = least
                    [by and_lhs the-least-properties]
                  @the-least-is-least |
                    forall m: peano.Nat;
                      (exists f: Poly; isACombination(f, p, q) and
                      (not (f = fieldpoly.ZEROP)) and fieldpoly.degree(f) = m) ->
                      peano_order.less_or_equal(least, m)
                    [by and_rhs the-least-properties]
                  @with-the-minimal-combination |
                    unpack d: Poly from the-least-is-realized {
                      @its-properties |
                        isACombination(d, p, q) and (not (d = fieldpoly.ZEROP)) and
                          fieldpoly.degree(d) = least
                        [by hypothesis with-the-minimal-combination]
                      @it-is-a-combination |
                        isACombination(d, p, q)
                        [using tautology its-properties]
                      @it-is-nonzero |
                        not (d = fieldpoly.ZEROP)
                        [using tautology its-properties]
                      @its-degree-is-least |
                        fieldpoly.degree(d) = least
                        [using tautology its-properties]
                      @it-is-minimal |
                        forall g: Poly; isACombination(g, p, q) ->
                          (not (g = fieldpoly.ZEROP)) ->
                          peano_order.less_or_equal(
                          fieldpoly.degree(d), fieldpoly.degree(g))
                        [using specialize everyOtherCombinationIsAtLeastAsBig(
                          p, q, d, least) its-degree-is-least the-least-is-least]
                      @the-conjunction |
                        isACombination(d, p, q) and (not (d = fieldpoly.ZEROP)) and
                          (forall g: Poly; isACombination(g, p, q) ->
                          (not (g = fieldpoly.ZEROP)) ->
                          peano_order.less_or_equal(
                          fieldpoly.degree(d), fieldpoly.degree(g)))
                        [using tautology it-is-a-combination it-is-nonzero it-is-minimal]
                      @conclusion-the-minimal-combination-exists |
                        exists e: Poly; isACombination(e, p, q) and
                          (not (e = fieldpoly.ZEROP)) and
                          (forall g: Poly; isACombination(g, p, q) ->
                          (not (g = fieldpoly.ZEROP)) ->
                          peano_order.less_or_equal(
                          fieldpoly.degree(e), fieldpoly.degree(g)))
                        [by witness(d) the-conjunction]
                    }
                  @conclusion-from-the-realization |
                    exists e: Poly; isACombination(e, p, q) and
                      (not (e = fieldpoly.ZEROP)) and
                      (forall g: Poly; isACombination(g, p, q) ->
                      (not (g = fieldpoly.ZEROP)) ->
                      peano_order.less_or_equal(
                      fieldpoly.degree(e), fieldpoly.degree(g)))
                    [by unpacked with-the-minimal-combination]
                }
              @the-minimal-combination-exists |
                exists d: Poly; isACombination(d, p, q) and (not (d = fieldpoly.ZEROP)) and
                  (forall g: Poly; isACombination(g, p, q) ->
                  (not (g = fieldpoly.ZEROP)) ->
                  peano_order.less_or_equal(fieldpoly.degree(d), fieldpoly.degree(g)))
                [by unpacked with-the-least-degree]
            }
          @conclusion-a-nonzero-combination-gives-it |
            (exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))) ->
              (exists d: Poly; isACombination(d, p, q) and
              (not (d = fieldpoly.ZEROP)) and
              (forall g: Poly; isACombination(g, p, q) ->
              (not (g = fieldpoly.ZEROP)) ->
              peano_order.less_or_equal(fieldpoly.degree(d), fieldpoly.degree(g))))
            [by discharge given-a-nonzero-combination]
        }
      @conclusion-for-all-q |
        forall q: Poly;
          (exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))) ->
          (exists d: Poly; isACombination(d, p, q) and (not (d = fieldpoly.ZEROP)) and
          (forall g: Poly; isACombination(g, p, q) -> (not (g = fieldpoly.ZEROP)) ->
          peano_order.less_or_equal(fieldpoly.degree(d), fieldpoly.degree(g))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly;
      (exists f: Poly; isACombination(f, p, q) and (not (f = fieldpoly.ZEROP))) ->
      (exists d: Poly; isACombination(d, p, q) and (not (d = fieldpoly.ZEROP)) and
      (forall g: Poly; isACombination(g, p, q) -> (not (g = fieldpoly.ZEROP)) ->
      peano_order.less_or_equal(fieldpoly.degree(d), fieldpoly.degree(g))))
    [by generalize generalize-p]
qed

// The algebra, with d's coefficients in hand. Given d = r p + s q and p = a d + b,
//   b = p + -(a d) = p + -(a (r p + s q)) = p (1 + -(a r)) + q (-(a s)),
// so b's own coefficients are (1 - ar) and (-as). `polynomial(fieldpoly)` does the
// rearrangement in one step — it is a ring identity in the polynomial operations, with the
// negation lemmas now available for it to cancel against.
theorem theRemainderCombinationFromTheCoefficients: forall p, q, d, a, b: Poly;
  (exists r: Poly; exists s: Poly; d = addP(mulP(r, p), mulP(s, q))) ->
  p = addP(mulP(a, d), b) ->
  isACombination(b, p, q)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-d |
            fix d: Poly {
              @generalize-a |
                fix a: Poly {
                  @generalize-b |
                    fix b: Poly {
                      @given-the-coefficients |
                        assume exists r: Poly; exists s: Poly;
                          d = addP(mulP(r, p), mulP(s, q)) {
                          @the-coefficients |
                            exists r: Poly; exists s: Poly;
                              d = addP(mulP(r, p), mulP(s, q))
                            [by hypothesis given-the-coefficients]
                          @given-the-division |
                            assume p = addP(mulP(a, d), b) {
                              @the-division |
                                p = addP(mulP(a, d), b)
                                [by hypothesis given-the-division]
                              @with-r |
                                unpack r: Poly from the-coefficients {
                                  @s-exists |
                                    exists s: Poly;
                                      d = addP(mulP(r, p), mulP(s, q))
                                    [by hypothesis with-r]
                                  @with-s |
                                    unpack s: Poly from s-exists {
                                      @d-expanded |
                                        d = addP(mulP(r, p), mulP(s, q))
                                        [by hypothesis with-s]
                                      // b = p + -(a d), from the division equation
                                      @b-is-the-difference |
                                        b = addP(p, negP(mulP(a, d)))
                                        [using specialize
                                          theRemainderIsTheDifference(p, mulP(a, d), b)
                                          the-division]
                                      // substitute d's combination form
                                      @b-with-d-expanded |
                                        b = addP(p, negP(mulP(a,
                                          addP(mulP(r, p), mulP(s, q)))))
                                        [by rewrite d-expanded b-is-the-difference]
                                      // `polynomial` is a SCALAR-layer tactic: it binds
                                      // `add`/`mul` by well-known name and does not see
                                      // `addP`/`mulP`, so the regrouping is written out.
                                      //
                                      //   -(a(rp + sq)) = -(a(rp)) + -(a(sq))
                                      //                 = (-(ar))p  + (-(as))q
                                      @distribute-a |
                                        mulP(a, addP(mulP(r, p), mulP(s, q))) =
                                          addP(mulP(a, mulP(r, p)), mulP(a, mulP(s, q)))
                                        [using specialize fieldpoly.polyMulAddDistribLeft(
                                          a, mulP(r, p), mulP(s, q))]
                                      @b-with-a-distributed |
                                        b = addP(p, negP(addP(
                                          mulP(a, mulP(r, p)),
                                          mulP(a, mulP(s, q)))))
                                        [by rewrite distribute-a b-with-d-expanded]
                                      @split-the-negation |
                                        addP(negP(mulP(a, mulP(r, p))),
                                          negP(mulP(a, mulP(s, q)))) =
                                          negP(addP(mulP(a, mulP(r, p)),
                                          mulP(a, mulP(s, q))))
                                        [using specialize fieldpoly.polyNegationOfASum(
                                          mulP(a, mulP(r, p)), mulP(a, mulP(s, q)))]
                                      @b-with-the-negation-split |
                                        b = addP(p, addP(
                                          negP(mulP(a, mulP(r, p))),
                                          negP(mulP(a, mulP(s, q)))))
                                        [by rewrite split-the-negation b-with-a-distributed]
                                      // each negated summand becomes a coefficient times p (or q)
                                      @reassociate-the-p-term |
                                        mulP(mulP(a, r), p) = mulP(a, mulP(r, p))
                                        [using specialize fieldpoly.polyMulIsAssociative(
                                          a, r, p)]
                                      @the-p-coefficient |
                                        mulP(negP(mulP(a, r)), p) =
                                          negP(mulP(mulP(a, r), p))
                                        [using specialize
                                          fieldpoly.polyNegationPullsOutOfTheProduct(
                                          mulP(a, r), p)]
                                      @the-p-term-is-a-coefficient |
                                        mulP(negP(mulP(a, r)), p) =
                                          negP(mulP(a, mulP(r, p)))
                                        [using simplify the-p-coefficient
                                          reassociate-the-p-term]
                                      @reassociate-the-q-term |
                                        mulP(mulP(a, s), q) = mulP(a, mulP(s, q))
                                        [using specialize fieldpoly.polyMulIsAssociative(
                                          a, s, q)]
                                      @the-q-coefficient |
                                        mulP(negP(mulP(a, s)), q) =
                                          negP(mulP(mulP(a, s), q))
                                        [using specialize
                                          fieldpoly.polyNegationPullsOutOfTheProduct(
                                          mulP(a, s), q)]
                                      @the-q-term-is-a-coefficient |
                                        mulP(negP(mulP(a, s)), q) =
                                          negP(mulP(a, mulP(s, q)))
                                        [using simplify the-q-coefficient
                                          reassociate-the-q-term]
                                      @b-with-the-p-term |
                                        b = addP(p, addP(
                                          mulP(negP(mulP(a, r)), p),
                                          negP(mulP(a, mulP(s, q)))))
                                        [by rewrite the-p-term-is-a-coefficient
                                          b-with-the-negation-split]
                                      @b-is-a-combination-shape |
                                        b = addP(p, addP(
                                          mulP(negP(mulP(a, r)), p),
                                          mulP(negP(mulP(a, s)), q)))
                                        [by rewrite the-q-term-is-a-coefficient
                                          b-with-the-p-term]
                                      @the-combination-meaning |
                                        isACombination(b, p, q) iff
                                          (exists u: Poly; exists v: Poly;
                                          b = addP(mulP(u, p), mulP(v, q)))
                                        [using specialize
                                          combinationMeansRPPlusSQ(b, p, q)]
                                      @the-combination-backward |
                                        (exists u: Poly; exists v: Poly;
                                          b = addP(mulP(u, p), mulP(v, q))) ->
                                          isACombination(b, p, q)
                                        [by equiv_converse the-combination-meaning]
                                      // fold the leading p into the p-coefficient:
                                      // p + ((-(ar))p + X) = (1 + -(ar))p + X
                                      @b-in-coefficient-form |
                                        addP(p, addP(
                                          mulP(negP(mulP(a, r)), p),
                                          mulP(negP(mulP(a, s)), q))) =
                                          addP(
                                          mulP(addP(ONEP, negP(mulP(a, r))), p),
                                          mulP(negP(mulP(a, s)), q))
                                        [using specialize theLeadingTermFolds(
                                          p, mulP(negP(mulP(a, r)), p),
                                          negP(mulP(a, r)),
                                          mulP(negP(mulP(a, s)), q))
                                          the-p-term-is-its-own-coefficient]
                                      @the-p-term-is-its-own-coefficient |
                                        mulP(negP(mulP(a, r)), p) =
                                          mulP(negP(mulP(a, r)), p)
                                        [by reflexivity]
                                      @b-in-the-combination-form |
                                        b = addP(
                                          mulP(addP(ONEP, negP(mulP(a, r))), p),
                                          mulP(negP(mulP(a, s)), q))
                                        [using simplify b-is-a-combination-shape
                                          b-in-coefficient-form]
                                      @the-inner-witness |
                                        exists v: Poly;
                                          b = addP(
                                          mulP(addP(ONEP, negP(mulP(a, r))), p),
                                          mulP(v, q))
                                        [by witness(negP(mulP(a, s)))
                                          b-in-the-combination-form]
                                      @the-witnesses-exist |
                                        exists u: Poly; exists v: Poly;
                                          b = addP(mulP(u, p), mulP(v, q))
                                        [by witness(addP(ONEP, negP(mulP(a, r))))
                                          the-inner-witness]
                                      @conclusion-b-is-a-combination |
                                        isACombination(b, p, q)
                                        [by modus_ponens the-combination-backward
                                          the-witnesses-exist]
                                    }
                                  @conclusion-from-s |
                                    isACombination(b, p, q)
                                    [by unpacked with-s]
                                }
                              @conclusion-from-r |
                                isACombination(b, p, q)
                                [by unpacked with-r]
                            }
                          @conclusion-the-division-gives-it |
                            p = addP(mulP(a, d), b) -> isACombination(b, p, q)
                            [by discharge given-the-division]
                        }
                      @conclusion-both-give-it |
                        (exists r: Poly; exists s: Poly;
                          d = addP(mulP(r, p), mulP(s, q))) ->
                          p = addP(mulP(a, d), b) ->
                          isACombination(b, p, q)
                        [by discharge given-the-coefficients]
                    }
                  @conclusion-for-all-b |
                    forall b: Poly;
                      (exists r: Poly; exists s: Poly;
                      d = addP(mulP(r, p), mulP(s, q))) ->
                      p = addP(mulP(a, d), b) ->
                      isACombination(b, p, q)
                    [by generalize generalize-b]
                }
              @conclusion-for-all-a |
                forall a, b: Poly;
                  (exists r: Poly; exists s: Poly;
                  d = addP(mulP(r, p), mulP(s, q))) ->
                  p = addP(mulP(a, d), b) ->
                  isACombination(b, p, q)
                [by generalize generalize-a]
            }
          @conclusion-for-all-d |
            forall d, a, b: Poly;
              (exists r: Poly; exists s: Poly;
              d = addP(mulP(r, p), mulP(s, q))) ->
              p = addP(mulP(a, d), b) ->
              isACombination(b, p, q)
            [by generalize generalize-d]
        }
      @conclusion-for-all-q |
        forall q, d, a, b: Poly;
          (exists r: Poly; exists s: Poly;
          d = addP(mulP(r, p), mulP(s, q))) ->
          p = addP(mulP(a, d), b) ->
          isACombination(b, p, q)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, d, a, b: Poly;
      (exists r: Poly; exists s: Poly;
      d = addP(mulP(r, p), mulP(s, q))) ->
      p = addP(mulP(a, d), b) ->
      isACombination(b, p, q)
    [by generalize generalize-p]
qed

// p + (c·p + X) = (1 + c)·p + X. Right-distributivity on the coefficient, after regrouping
// the sum so the two p-terms meet. `mulP(ONEP, p) = p` supplies the leading 1.
theorem theLeadingTermFolds: forall p, cp, c, x: Poly;
  cp = mulP(c, p) ->
  addP(p, addP(cp, x)) = addP(mulP(addP(ONEP, c), p), x)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-cp |
        fix cp: Poly {
          @generalize-c |
            fix c: Poly {
              @generalize-x |
                fix x: Poly {
                  @given-cp |
                    assume cp = mulP(c, p) {
                      @cp-is-c-times-p |
                        cp = mulP(c, p)
                        [by hypothesis given-cp]
                      // p + (c p + x) = (p + c p) + x
                      @regroup |
                        addP(p, addP(mulP(c, p), x)) =
                          addP(addP(p, mulP(c, p)), x)
                        [by symmetry associate]
                      @associate |
                        addP(addP(p, mulP(c, p)), x) =
                          addP(p, addP(mulP(c, p), x))
                        [using specialize fieldpoly.polyAddIsAssociative(
                          p, mulP(c, p), x)]
                      // p + c p = 1·p + c·p = (1 + c)·p
                      @one-times-p |
                        mulP(ONEP, p) = p
                        [using specialize fieldpoly.polyMulOneLeft(p)]
                      @distribute-on-the-right |
                        mulP(addP(ONEP, c), p) =
                          addP(mulP(ONEP, p), mulP(c, p))
                        [using specialize fieldpoly.polyMulAddDistribRight(
                          ONEP, c, p)]
                      @the-coefficient-sum |
                        mulP(addP(ONEP, c), p) = addP(p, mulP(c, p))
                        [using simplify distribute-on-the-right one-times-p]
                      @the-regrouped-sum |
                        addP(p, addP(mulP(c, p), x)) =
                          addP(mulP(addP(ONEP, c), p), x)
                        [by rewrite the-coefficient-sum regroup]
                      @conclusion-the-leading-term-folds |
                        addP(p, addP(cp, x)) = addP(mulP(addP(ONEP, c), p), x)
                        [by rewrite cp-is-c-times-p the-regrouped-sum]
                    }
                  @conclusion-given-cp |
                    cp = mulP(c, p) ->
                      addP(p, addP(cp, x)) = addP(mulP(addP(ONEP, c), p), x)
                    [by discharge given-cp]
                }
              @conclusion-for-all-x |
                forall x: Poly;
                  cp = mulP(c, p) ->
                  addP(p, addP(cp, x)) = addP(mulP(addP(ONEP, c), p), x)
                [by generalize generalize-x]
            }
          @conclusion-for-all-c |
            forall c, x: Poly;
              cp = mulP(c, p) ->
              addP(p, addP(cp, x)) = addP(mulP(addP(ONEP, c), p), x)
            [by generalize generalize-c]
        }
      @conclusion-for-all-cp |
        forall cp, c, x: Poly;
          cp = mulP(c, p) ->
          addP(p, addP(cp, x)) = addP(mulP(addP(ONEP, c), p), x)
        [by generalize generalize-cp]
    }
  @conclusion |
    forall p, cp, c, x: Poly;
      cp = mulP(c, p) ->
      addP(p, addP(cp, x)) = addP(mulP(addP(ONEP, c), p), x)
    [by generalize generalize-p]
qed
// b = p + -(a d), read off p = a d + b by additive cancellation.
theorem theRemainderIsTheDifference: forall p, m, b: Poly;
  p = addP(m, b) -> b = addP(p, negP(m))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-m |
        fix m: Poly {
          @generalize-b |
            fix b: Poly {
              @given-the-division |
                assume p = addP(m, b) {
                  @the-division |
                    p = addP(m, b)
                    [by hypothesis given-the-division]
                  // p + -m = (m + b) + -m = b, by commuting then cancelling
                  @the-sum-commutes |
                    addP(m, b) = addP(b, m)
                    [using specialize fieldpoly.polyAddIsCommutative(m, b)]
                  @p-is-b-plus-m |
                    p = addP(b, m)
                    [using simplify the-division the-sum-commutes]
                  @reflexive |
                    addP(p, negP(m)) = addP(p, negP(m))
                    [by reflexivity]
                  @substitute |
                    addP(p, negP(m)) = addP(addP(b, m), negP(m))
                    [by rewrite p-is-b-plus-m reflexive]
                  @the-cancellation |
                    addP(addP(b, m), negP(m)) = b
                    [using specialize fieldpoly.polyASumCancelsItsRightSummand(b, m)]
                  @the-difference-is-b |
                    addP(p, negP(m)) = b
                    [using simplify substitute the-cancellation]
                  @conclusion-b-is-the-difference |
                    b = addP(p, negP(m))
                    [by symmetry the-difference-is-b]
                }
              @conclusion-the-division-gives-it |
                p = addP(m, b) -> b = addP(p, negP(m))
                [by discharge given-the-division]
            }
          @conclusion-for-all-b |
            forall b: Poly; p = addP(m, b) -> b = addP(p, negP(m))
            [by generalize generalize-b]
        }
      @conclusion-for-all-m |
        forall m, b: Poly; p = addP(m, b) -> b = addP(p, negP(m))
        [by generalize generalize-m]
    }
  @conclusion |
    forall p, m, b: Poly; p = addP(m, b) -> b = addP(p, negP(m))
    [by generalize generalize-p]
qed
// -- HIS SECOND MOVE: THE DIVISION REMAINDER IS ITSELF A COMBINATION -------------------------
// "By the division algorithm, there are polynomials a(x) and b(x) such that
// p(x) = a(x)d(x) + b(x) ... Therefore
//   b = p - a d = p - a(r p + s q) = p(1 - a r) + q(-a s).
// This is a linear combination of p(x) and q(x), so it belongs to S."
//
// The combination form is what makes minimality bite. Writing it needs negation to move
// through a product and additive cancellation — the algebra now proved generically in
// `std/ring/polynomial.b4m` and transferred into F[x].
theorem theDivisionRemainderIsACombination: forall p, q, d, a, b: Poly;
  isACombination(d, p, q) ->
  p = addP(mulP(a, d), b) ->
  isACombination(b, p, q)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-d |
            fix d: Poly {
              @generalize-a |
                fix a: Poly {
                  @generalize-b |
                    fix b: Poly {
                      @given-d-is-a-combination |
                        assume isACombination(d, p, q) {
                          @d-is-a-combination |
                            isACombination(d, p, q)
                            [by hypothesis given-d-is-a-combination]
                          @the-combination-meaning |
                            isACombination(d, p, q) iff
                              (exists r: Poly; exists s: Poly;
                              d = addP(mulP(r, p), mulP(s, q)))
                            [using specialize combinationMeansRPPlusSQ(d, p, q)]
                          @the-combination-forward |
                            isACombination(d, p, q) ->
                              (exists r: Poly; exists s: Poly;
                              d = addP(mulP(r, p), mulP(s, q)))
                            [by equiv_forward the-combination-meaning]
                          @d-has-coefficients |
                            exists r: Poly; exists s: Poly;
                              d = addP(mulP(r, p), mulP(s, q))
                            [by modus_ponens the-combination-forward d-is-a-combination]
                          @given-the-division |
                            assume p = addP(mulP(a, d), b) {
                              @the-division |
                                p = addP(mulP(a, d), b)
                                [by hypothesis given-the-division]
                              @conclusion-b-is-a-combination |
                                isACombination(b, p, q)
                                [using specialize theRemainderCombinationFromTheCoefficients(
                                  p, q, d, a, b) d-has-coefficients the-division]
                            }
                          @conclusion-the-division-gives-it |
                            p = addP(mulP(a, d), b) -> isACombination(b, p, q)
                            [by discharge given-the-division]
                        }
                      @conclusion-both-give-it |
                        isACombination(d, p, q) ->
                          p = addP(mulP(a, d), b) ->
                          isACombination(b, p, q)
                        [by discharge given-d-is-a-combination]
                    }
                  @conclusion-for-all-b |
                    forall b: Poly;
                      isACombination(d, p, q) ->
                      p = addP(mulP(a, d), b) ->
                      isACombination(b, p, q)
                    [by generalize generalize-b]
                }
              @conclusion-for-all-a |
                forall a, b: Poly;
                  isACombination(d, p, q) ->
                  p = addP(mulP(a, d), b) ->
                  isACombination(b, p, q)
                [by generalize generalize-a]
            }
          @conclusion-for-all-d |
            forall d, a, b: Poly;
              isACombination(d, p, q) ->
              p = addP(mulP(a, d), b) ->
              isACombination(b, p, q)
            [by generalize generalize-d]
        }
      @conclusion-for-all-q |
        forall q, d, a, b: Poly;
          isACombination(d, p, q) ->
          p = addP(mulP(a, d), b) ->
          isACombination(b, p, q)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, d, a, b: Poly;
      isACombination(d, p, q) ->
      p = addP(mulP(a, d), b) ->
      isACombination(b, p, q)
    [by generalize generalize-p]
qed

// -- STEP ONE: MINIMALITY FORCES THE REMAINDER TO VANISH, SO d DIVIDES ------------------------
// "Since d(x) was chosen to have the smallest degree in S, b(x) must be the zero polynomial.
// Consequently, d(x) divides p(x)."
//
// The remainder of dividing p by d is a combination (`theDivisionRemainderIsACombination`) and
// its degree is BELOW deg d (the division algorithm). If it were nonzero, minimality would put
// deg d at or below it — contradicting that it is strictly below. So it vanishes, and
// p = a·d exhibits the cofactor divisibility asks for.
theorem minimalityForcesTheRemainderToVanish: forall p, q, d, a, b: Poly;
  isACombination(d, p, q) ->
  (forall g: Poly; isACombination(g, p, q) -> (not (g = ZEROP)) ->
  peano_order.less_or_equal(degree(d), degree(g))) ->
  p = addP(mulP(a, d), b) ->
  peano_order.less_than(degree(b), degree(d)) ->
  b = ZEROP
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-d |
            fix d: Poly {
              @generalize-a |
                fix a: Poly {
                  @generalize-b |
                    fix b: Poly {
                      @given-d-is-a-combination |
                        assume isACombination(d, p, q) {
                          @d-is-a-combination |
                            isACombination(d, p, q)
                            [by hypothesis given-d-is-a-combination]
                          @given-minimality |
                            assume forall g: Poly; isACombination(g, p, q) ->
                              (not (g = ZEROP)) ->
                              peano_order.less_or_equal(degree(d), degree(g)) {
                              @minimality |
                                forall g: Poly; isACombination(g, p, q) ->
                                  (not (g = ZEROP)) ->
                                  peano_order.less_or_equal(degree(d), degree(g))
                                [by hypothesis given-minimality]
                              @given-the-division |
                                assume p = addP(mulP(a, d), b) {
                                  @the-division |
                                    p = addP(mulP(a, d), b)
                                    [by hypothesis given-the-division]
                                  @b-is-a-combination |
                                    isACombination(b, p, q)
                                    [using specialize theDivisionRemainderIsACombination(
                                      p, q, d, a, b) d-is-a-combination the-division]
                                  @given-the-remainder-is-small |
                                    assume peano_order.less_than(degree(b), degree(d)) {
                                      @the-remainder-is-small |
                                        peano_order.less_than(degree(b), degree(d))
                                        [by hypothesis given-the-remainder-is-small]
                                      // suppose it were nonzero
                                      @suppose-nonzero |
                                        assume not (b = ZEROP) {
                                          @b-is-nonzero |
                                            not (b = ZEROP)
                                            [by hypothesis suppose-nonzero]
                                          @minimality-applies |
                                            peano_order.less_or_equal(degree(d), degree(b))
                                            [using specialize minimality(b)
                                              b-is-a-combination b-is-nonzero]
                                          @the-degrees-contradict |
                                            not peano_order.less_than(degree(b), degree(d))
                                            [using specialize
                                              peano_order.lessOrEqualBlocksTheConverse(
                                              degree(d), degree(b)) minimality-applies]
                                          @conclusion-absurd |
                                            b = ZEROP
                                            [by ex_falso the-remainder-is-small
                                              the-degrees-contradict]
                                        }
                                      @conclusion-the-remainder-vanishes |
                                        b = ZEROP
                                        [using tautology nonzero-is-absurd]
                                      @nonzero-is-absurd |
                                        (not (b = ZEROP)) -> b = ZEROP
                                        [by discharge suppose-nonzero]
                                    }
                                  @conclusion-the-small-remainder-vanishes |
                                    peano_order.less_than(degree(b), degree(d)) -> b = ZEROP
                                    [by discharge given-the-remainder-is-small]
                                }
                              @conclusion-the-division-gives-it |
                                p = addP(mulP(a, d), b) ->
                                  peano_order.less_than(degree(b), degree(d)) -> b = ZEROP
                                [by discharge given-the-division]
                            }
                          @conclusion-minimality-gives-it |
                            (forall g: Poly; isACombination(g, p, q) ->
                              (not (g = ZEROP)) ->
                              peano_order.less_or_equal(degree(d), degree(g))) ->
                              p = addP(mulP(a, d), b) ->
                              peano_order.less_than(degree(b), degree(d)) -> b = ZEROP
                            [by discharge given-minimality]
                        }
                      @conclusion-all-give-it |
                        isACombination(d, p, q) ->
                          (forall g: Poly; isACombination(g, p, q) ->
                          (not (g = ZEROP)) ->
                          peano_order.less_or_equal(degree(d), degree(g))) ->
                          p = addP(mulP(a, d), b) ->
                          peano_order.less_than(degree(b), degree(d)) -> b = ZEROP
                        [by discharge given-d-is-a-combination]
                    }
                  @conclusion-for-all-b |
                    forall b: Poly;
                      isACombination(d, p, q) ->
                      (forall g: Poly; isACombination(g, p, q) ->
                      (not (g = ZEROP)) ->
                      peano_order.less_or_equal(degree(d), degree(g))) ->
                      p = addP(mulP(a, d), b) ->
                      peano_order.less_than(degree(b), degree(d)) -> b = ZEROP
                    [by generalize generalize-b]
                }
              @conclusion-for-all-a |
                forall a, b: Poly;
                  isACombination(d, p, q) ->
                  (forall g: Poly; isACombination(g, p, q) ->
                  (not (g = ZEROP)) ->
                  peano_order.less_or_equal(degree(d), degree(g))) ->
                  p = addP(mulP(a, d), b) ->
                  peano_order.less_than(degree(b), degree(d)) -> b = ZEROP
                [by generalize generalize-a]
            }
          @conclusion-for-all-d |
            forall d, a, b: Poly;
              isACombination(d, p, q) ->
              (forall g: Poly; isACombination(g, p, q) ->
              (not (g = ZEROP)) ->
              peano_order.less_or_equal(degree(d), degree(g))) ->
              p = addP(mulP(a, d), b) ->
              peano_order.less_than(degree(b), degree(d)) -> b = ZEROP
            [by generalize generalize-d]
        }
      @conclusion-for-all-q |
        forall q, d, a, b: Poly;
          isACombination(d, p, q) ->
          (forall g: Poly; isACombination(g, p, q) ->
          (not (g = ZEROP)) ->
          peano_order.less_or_equal(degree(d), degree(g))) ->
          p = addP(mulP(a, d), b) ->
          peano_order.less_than(degree(b), degree(d)) -> b = ZEROP
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, d, a, b: Poly;
      isACombination(d, p, q) ->
      (forall g: Poly; isACombination(g, p, q) ->
      (not (g = ZEROP)) ->
      peano_order.less_or_equal(degree(d), degree(g))) ->
      p = addP(mulP(a, d), b) ->
      peano_order.less_than(degree(b), degree(d)) -> b = ZEROP
    [by generalize generalize-p]
qed

// Hence d divides p: the division equation collapses to p = a·d once the remainder vanishes,
// which is exactly the cofactor `dividesP` asks for.
theorem theMinimalCombinationDividesIt: forall p, q, d, a, b: Poly;
  isACombination(d, p, q) ->
  (forall g: Poly; isACombination(g, p, q) -> (not (g = ZEROP)) ->
  peano_order.less_or_equal(degree(d), degree(g))) ->
  p = addP(mulP(a, d), b) ->
  peano_order.less_than(degree(b), degree(d)) ->
  dividesP(d, p)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-d |
            fix d: Poly {
              @generalize-a |
                fix a: Poly {
                  @generalize-b |
                    fix b: Poly {
                      @given-everything |
                        assume isACombination(d, p, q) {
                          @d-is-a-combination |
                            isACombination(d, p, q)
                            [by hypothesis given-everything]
                          @given-minimality |
                            assume forall g: Poly; isACombination(g, p, q) ->
                              (not (g = ZEROP)) ->
                              peano_order.less_or_equal(degree(d), degree(g)) {
                              @minimality |
                                forall g: Poly; isACombination(g, p, q) ->
                                  (not (g = ZEROP)) ->
                                  peano_order.less_or_equal(degree(d), degree(g))
                                [by hypothesis given-minimality]
                              @given-the-division |
                                assume p = addP(mulP(a, d), b) {
                                  @the-division |
                                    p = addP(mulP(a, d), b)
                                    [by hypothesis given-the-division]
                                  @given-the-remainder-is-small |
                                    assume peano_order.less_than(degree(b), degree(d)) {
                                      @the-remainder-is-small |
                                        peano_order.less_than(degree(b), degree(d))
                                        [by hypothesis given-the-remainder-is-small]
                                      @the-remainder-vanishes |
                                        b = ZEROP
                                        [using specialize
                                          minimalityForcesTheRemainderToVanish(
                                          p, q, d, a, b) d-is-a-combination minimality
                                          the-division the-remainder-is-small]
                                      @the-division-collapses |
                                        p = addP(mulP(a, d), ZEROP)
                                        [by rewrite the-remainder-vanishes the-division]
                                      @adding-zero-changes-nothing |
                                        addP(mulP(a, d), ZEROP) = mulP(a, d)
                                        [using specialize fieldpoly.polyAddZeroRight(
                                          mulP(a, d))]
                                      @p-is-the-multiple |
                                        p = mulP(a, d)
                                        [using simplify the-division-collapses
                                          adding-zero-changes-nothing]
                                      @the-cofactor-exists |
                                        exists u: Poly; p = mulP(u, d)
                                        [by witness(a) p-is-the-multiple]
                                      @the-divides-meaning |
                                        dividesP(d, p) iff
                                          (exists u: Poly; p = mulP(u, d))
                                        [using specialize
                                          dividesMeansACofactorExists(d, p)]
                                      @the-divides-backward |
                                        (exists u: Poly; p = mulP(u, d)) -> dividesP(d, p)
                                        [by equiv_converse the-divides-meaning]
                                      @conclusion-d-divides-p |
                                        dividesP(d, p)
                                        [by modus_ponens the-divides-backward
                                          the-cofactor-exists]
                                    }
                                  @conclusion-the-small-remainder-gives-it |
                                    peano_order.less_than(degree(b), degree(d)) ->
                                      dividesP(d, p)
                                    [by discharge given-the-remainder-is-small]
                                }
                              @conclusion-the-division-gives-it |
                                p = addP(mulP(a, d), b) ->
                                  peano_order.less_than(degree(b), degree(d)) ->
                                  dividesP(d, p)
                                [by discharge given-the-division]
                            }
                          @conclusion-minimality-gives-it |
                            (forall g: Poly; isACombination(g, p, q) ->
                              (not (g = ZEROP)) ->
                              peano_order.less_or_equal(degree(d), degree(g))) ->
                              p = addP(mulP(a, d), b) ->
                              peano_order.less_than(degree(b), degree(d)) ->
                              dividesP(d, p)
                            [by discharge given-minimality]
                        }
                      @conclusion-all-give-it |
                        isACombination(d, p, q) ->
                          (forall g: Poly; isACombination(g, p, q) ->
                          (not (g = ZEROP)) ->
                          peano_order.less_or_equal(degree(d), degree(g))) ->
                          p = addP(mulP(a, d), b) ->
                          peano_order.less_than(degree(b), degree(d)) ->
                          dividesP(d, p)
                        [by discharge given-everything]
                    }
                  @conclusion-for-all-b |
                    forall b: Poly;
                      isACombination(d, p, q) ->
                      (forall g: Poly; isACombination(g, p, q) ->
                      (not (g = ZEROP)) ->
                      peano_order.less_or_equal(degree(d), degree(g))) ->
                      p = addP(mulP(a, d), b) ->
                      peano_order.less_than(degree(b), degree(d)) ->
                      dividesP(d, p)
                    [by generalize generalize-b]
                }
              @conclusion-for-all-a |
                forall a, b: Poly;
                  isACombination(d, p, q) ->
                  (forall g: Poly; isACombination(g, p, q) ->
                  (not (g = ZEROP)) ->
                  peano_order.less_or_equal(degree(d), degree(g))) ->
                  p = addP(mulP(a, d), b) ->
                  peano_order.less_than(degree(b), degree(d)) ->
                  dividesP(d, p)
                [by generalize generalize-a]
            }
          @conclusion-for-all-d |
            forall d, a, b: Poly;
              isACombination(d, p, q) ->
              (forall g: Poly; isACombination(g, p, q) ->
              (not (g = ZEROP)) ->
              peano_order.less_or_equal(degree(d), degree(g))) ->
              p = addP(mulP(a, d), b) ->
              peano_order.less_than(degree(b), degree(d)) ->
              dividesP(d, p)
            [by generalize generalize-d]
        }
      @conclusion-for-all-q |
        forall q, d, a, b: Poly;
          isACombination(d, p, q) ->
          (forall g: Poly; isACombination(g, p, q) ->
          (not (g = ZEROP)) ->
          peano_order.less_or_equal(degree(d), degree(g))) ->
          p = addP(mulP(a, d), b) ->
          peano_order.less_than(degree(b), degree(d)) ->
          dividesP(d, p)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, d, a, b: Poly;
      isACombination(d, p, q) ->
      (forall g: Poly; isACombination(g, p, q) -> (not (g = ZEROP)) ->
      peano_order.less_or_equal(degree(d), degree(g))) ->
      p = addP(mulP(a, d), b) ->
      peano_order.less_than(degree(b), degree(d)) ->
      dividesP(d, p)
    [by generalize generalize-p]
qed

// A nonzero divisor's degree is at most its multiple's: e = u·d with both nonzero puts
// deg e at or above deg d, by `aNonzeroMultipleHasAtLeastTheDegree` read through the cofactor.
theorem aDivisorsDegreeIsAtMost: forall d, e: Poly;
  (not (d = ZEROP)) -> (not (e = ZEROP)) ->
  dividesP(d, e) ->
  peano_order.less_or_equal(degree(d), degree(e))
proof
  @generalize-d |
    fix d: Poly {
      @generalize-e |
        fix e: Poly {
          @given-d-nonzero |
            assume not (d = ZEROP) {
              @d-is-nonzero |
                not (d = ZEROP)
                [by hypothesis given-d-nonzero]
              @given-e-nonzero |
                assume not (e = ZEROP) {
                  @e-is-nonzero |
                    not (e = ZEROP)
                    [by hypothesis given-e-nonzero]
                  @given-d-divides-e |
                    assume dividesP(d, e) {
                      @d-divides-e |
                        dividesP(d, e)
                        [by hypothesis given-d-divides-e]
                      @the-divides-meaning |
                        dividesP(d, e) iff (exists u: Poly; e = mulP(u, d))
                        [using specialize dividesMeansACofactorExists(d, e)]
                      @the-divides-forward |
                        dividesP(d, e) -> (exists u: Poly; e = mulP(u, d))
                        [by equiv_forward the-divides-meaning]
                      @the-cofactor-exists |
                        exists u: Poly; e = mulP(u, d)
                        [by modus_ponens the-divides-forward d-divides-e]
                      @with-the-cofactor |
                        unpack u: Poly from the-cofactor-exists {
                          @e-is-the-multiple |
                            e = mulP(u, d)
                            [by hypothesis with-the-cofactor]
                          // the cofactor cannot be zero, else e would be
                          @suppose-the-cofactor-vanishes |
                            assume u = ZEROP {
                              @the-cofactor-vanishes |
                                u = ZEROP
                                [by hypothesis suppose-the-cofactor-vanishes]
                              @e-is-zero-times-d |
                                e = mulP(ZEROP, d)
                                [by rewrite the-cofactor-vanishes e-is-the-multiple]
                              @the-zero-product-commutes |
                                mulP(ZEROP, d) = mulP(d, ZEROP)
                                [using specialize fieldpoly.polyMulIsCommutative(
                                  ZEROP, d)]
                              @anything-times-zero |
                                mulP(d, ZEROP) = ZEROP
                                [using specialize fieldpoly.polyMulZeroRight(d)]
                              @e-is-the-commuted-zero-product |
                                e = mulP(d, ZEROP)
                                [using simplify e-is-zero-times-d
                                  the-zero-product-commutes]
                              @e-would-be-zero |
                                e = ZEROP
                                [using simplify e-is-the-commuted-zero-product
                                  anything-times-zero]
                            }
                          @the-cofactor-is-nonzero |
                            not (u = ZEROP)
                            [by contradiction suppose-the-cofactor-vanishes
                              e-would-be-zero e-is-nonzero]
                          // deg(u·d) is not below deg d, and e IS u·d
                          @the-multiple-is-not-below |
                            not peano_order.less_than(
                              degree(mulP(d, u)), degree(d))
                            [using specialize
                              fieldpoly.aNonzeroMultipleHasAtLeastTheDegree(d, u)
                              d-is-nonzero the-cofactor-is-nonzero]
                          @the-product-commutes |
                            mulP(u, d) = mulP(d, u)
                            [using specialize fieldpoly.polyMulIsCommutative(u, d)]
                          @e-is-the-commuted-multiple |
                            e = mulP(d, u)
                            [using simplify e-is-the-multiple the-product-commutes]
                          @e-is-not-below |
                            not peano_order.less_than(degree(e), degree(d))
                            [by rewrite e-is-the-commuted-multiple
                              the-multiple-is-not-below]
                          @conclusion-d-is-at-most-e |
                            peano_order.less_or_equal(degree(d), degree(e))
                            [using specialize peano_order.notBelowGivesAtMost(
                              degree(d), degree(e)) e-is-not-below]
                        }
                      @conclusion-from-the-cofactor |
                        peano_order.less_or_equal(degree(d), degree(e))
                        [by unpacked with-the-cofactor]
                    }
                  @conclusion-d-divides-e-gives-it |
                    dividesP(d, e) ->
                      peano_order.less_or_equal(degree(d), degree(e))
                    [by discharge given-d-divides-e]
                }
              @conclusion-e-nonzero-gives-it |
                (not (e = ZEROP)) -> dividesP(d, e) ->
                  peano_order.less_or_equal(degree(d), degree(e))
                [by discharge given-e-nonzero]
            }
          @conclusion-all-give-it |
            (not (d = ZEROP)) -> (not (e = ZEROP)) -> dividesP(d, e) ->
              peano_order.less_or_equal(degree(d), degree(e))
            [by discharge given-d-nonzero]
        }
      @conclusion-for-all-e |
        forall e: Poly;
          (not (d = ZEROP)) -> (not (e = ZEROP)) -> dividesP(d, e) ->
          peano_order.less_or_equal(degree(d), degree(e))
        [by generalize generalize-e]
    }
  @conclusion |
    forall d, e: Poly;
      (not (d = ZEROP)) -> (not (e = ZEROP)) -> dividesP(d, e) ->
      peano_order.less_or_equal(degree(d), degree(e))
    [by generalize generalize-d]
qed
// -- STEP TWO: UNIQUENESS -- TWO MONIC GREATEST COMMON DIVISORS ARE EQUAL --------------------
// "Since d(x) and d'(x) are both greatest common divisors, they have the same degree. They are
// also both monic, so d(x) = d'(x)."
//
// Judson reads the equal degrees off `deg d = deg d' + deg[ru + sv]`. Here they come from
// MUTUAL divisibility, which `twoGcdsDivideEachOther` already supplies: each divides the other,
// so neither degree is strictly below the other (`aNonzeroMultipleHasAtLeastTheDegree` both
// ways), and antisymmetry on ℕ closes it. That avoids needing the degree-of-a-product law in a
// form that tracks the cofactor's own degree.
theorem mutualDivisibilityGivesEqualDegrees: forall d, e: Poly;
  (not (d = ZEROP)) -> (not (e = ZEROP)) ->
  dividesP(d, e) -> dividesP(e, d) ->
  degree(d) = degree(e)
proof
  @generalize-d |
    fix d: Poly {
      @generalize-e |
        fix e: Poly {
          @given-d-nonzero |
            assume not (d = ZEROP) {
              @d-is-nonzero |
                not (d = ZEROP)
                [by hypothesis given-d-nonzero]
              @given-e-nonzero |
                assume not (e = ZEROP) {
                  @e-is-nonzero |
                    not (e = ZEROP)
                    [by hypothesis given-e-nonzero]
                  @given-d-divides-e |
                    assume dividesP(d, e) {
                      @d-divides-e |
                        dividesP(d, e)
                        [by hypothesis given-d-divides-e]
                      @given-e-divides-d |
                        assume dividesP(e, d) {
                          @e-divides-d |
                            dividesP(e, d)
                            [by hypothesis given-e-divides-d]
                          @d-is-at-most-e |
                            peano_order.less_or_equal(degree(d), degree(e))
                            [using specialize aDivisorsDegreeIsAtMost(d, e)
                              d-is-nonzero e-is-nonzero d-divides-e]
                          @e-is-at-most-d |
                            peano_order.less_or_equal(degree(e), degree(d))
                            [using specialize aDivisorsDegreeIsAtMost(e, d)
                              e-is-nonzero d-is-nonzero e-divides-d]
                          @conclusion-the-degrees-agree |
                            degree(d) = degree(e)
                            [using specialize peano_order.lessOrEqualAntisymmetric(
                              degree(d), degree(e)) d-is-at-most-e e-is-at-most-d]
                        }
                      @conclusion-e-divides-d-gives-it |
                        dividesP(e, d) -> degree(d) = degree(e)
                        [by discharge given-e-divides-d]
                    }
                  @conclusion-d-divides-e-gives-it |
                    dividesP(d, e) -> dividesP(e, d) -> degree(d) = degree(e)
                    [by discharge given-d-divides-e]
                }
              @conclusion-e-nonzero-gives-it |
                (not (e = ZEROP)) ->
                  dividesP(d, e) -> dividesP(e, d) -> degree(d) = degree(e)
                [by discharge given-e-nonzero]
            }
          @conclusion-all-give-it |
            (not (d = ZEROP)) -> (not (e = ZEROP)) ->
              dividesP(d, e) -> dividesP(e, d) -> degree(d) = degree(e)
            [by discharge given-d-nonzero]
        }
      @conclusion-for-all-e |
        forall e: Poly;
          (not (d = ZEROP)) -> (not (e = ZEROP)) ->
          dividesP(d, e) -> dividesP(e, d) -> degree(d) = degree(e)
        [by generalize generalize-e]
    }
  @conclusion |
    forall d, e: Poly;
      (not (d = ZEROP)) -> (not (e = ZEROP)) ->
      dividesP(d, e) -> dividesP(e, d) -> degree(d) = degree(e)
    [by generalize generalize-d]
qed

// Uniqueness. Two monic greatest common divisors of the same pair are EQUAL — Judson's final
// paragraph. `twoGcdsDivideEachOther` gives mutual divisibility, which gives equal degrees,
// and `monic.twoMonicPolynomialsOfEqualDegreeThatDivideAreEqual` closes it on the cofactor.
theorem aMonicGreatestCommonDivisorIsUnique: forall d, e, p, q: Poly;
  (not (d = ZEROP)) -> (not (e = ZEROP)) ->
  monic.isMonic(d) -> monic.isMonic(e) ->
  isAGcd(d, p, q) -> isAGcd(e, p, q) ->
  d = e
proof
  @generalize-d |
    fix d: Poly {
      @generalize-e |
        fix e: Poly {
          @generalize-p |
            fix p: Poly {
              @generalize-q |
                fix q: Poly {
                  @given-d-nonzero |
                    assume not (d = ZEROP) {
                      @d-is-nonzero |
                        not (d = ZEROP)
                        [by hypothesis given-d-nonzero]
                      @given-e-nonzero |
                        assume not (e = ZEROP) {
                          @e-is-nonzero |
                            not (e = ZEROP)
                            [by hypothesis given-e-nonzero]
                          @given-d-monic |
                            assume monic.isMonic(d) {
                              @d-is-monic |
                                monic.isMonic(d)
                                [by hypothesis given-d-monic]
                              @given-e-monic |
                                assume monic.isMonic(e) {
                                  @e-is-monic |
                                    monic.isMonic(e)
                                    [by hypothesis given-e-monic]
                                  @given-d-is-a-gcd |
                                    assume isAGcd(d, p, q) {
                                      @d-is-a-gcd |
                                        isAGcd(d, p, q)
                                        [by hypothesis given-d-is-a-gcd]
                                      @given-e-is-a-gcd |
                                        assume isAGcd(e, p, q) {
                                          @e-is-a-gcd |
                                            isAGcd(e, p, q)
                                            [by hypothesis given-e-is-a-gcd]
                                          @they-divide-each-other |
                                            dividesP(d, e) and dividesP(e, d)
                                            [using specialize twoGcdsDivideEachOther(
                                              d, e, p, q) d-is-a-gcd e-is-a-gcd]
                                          @d-divides-e |
                                            dividesP(d, e)
                                            [by and_lhs they-divide-each-other]
                                          @e-divides-d |
                                            dividesP(e, d)
                                            [by and_rhs they-divide-each-other]
                                          @the-degrees-agree |
                                            degree(d) = degree(e)
                                            [using specialize
                                              mutualDivisibilityGivesEqualDegrees(d, e)
                                              d-is-nonzero e-is-nonzero
                                              d-divides-e e-divides-d]
                                          // d = u·e for some u, from e | d
                                          @the-divides-meaning |
                                            dividesP(e, d) iff
                                              (exists u: Poly; d = mulP(u, e))
                                            [using specialize
                                              dividesMeansACofactorExists(e, d)]
                                          @the-divides-forward |
                                            dividesP(e, d) ->
                                              (exists u: Poly; d = mulP(u, e))
                                            [by equiv_forward the-divides-meaning]
                                          @the-cofactor-exists |
                                            exists u: Poly; d = mulP(u, e)
                                            [by modus_ponens the-divides-forward
                                              e-divides-d]
                                          @with-the-cofactor |
                                            unpack u: Poly from the-cofactor-exists {
                                              @d-is-the-multiple |
                                                d = mulP(u, e)
                                                [by hypothesis with-the-cofactor]
                                              @suppose-the-cofactor-vanishes |
                                                assume u = ZEROP {
                                                  @the-cofactor-vanishes |
                                                    u = ZEROP
                                                    [by hypothesis
                                                      suppose-the-cofactor-vanishes]
                                                  @d-is-zero-times-e |
                                                    d = mulP(ZEROP, e)
                                                    [by rewrite the-cofactor-vanishes
                                                      d-is-the-multiple]
                                                  @the-zero-product-commutes |
                                                    mulP(ZEROP, e) = mulP(e, ZEROP)
                                                    [using specialize
                                                      fieldpoly.polyMulIsCommutative(
                                                      ZEROP, e)]
                                                  @anything-times-zero |
                                                    mulP(e, ZEROP) = ZEROP
                                                    [using specialize
                                                      fieldpoly.polyMulZeroRight(e)]
                                                  @d-is-the-commuted-zero-product |
                                                    d = mulP(e, ZEROP)
                                                    [using simplify d-is-zero-times-e
                                                      the-zero-product-commutes]
                                                  @d-would-be-zero |
                                                    d = ZEROP
                                                    [using simplify
                                                      d-is-the-commuted-zero-product
                                                      anything-times-zero]
                                                }
                                              @the-cofactor-is-nonzero |
                                                not (u = ZEROP)
                                                [by contradiction
                                                  suppose-the-cofactor-vanishes
                                                  d-would-be-zero d-is-nonzero]
                                              @conclusion-they-are-equal |
                                                d = e
                                                [using specialize
                                                  monic.twoMonicPolynomialsOfEqualDegreeThatDivideAreEqual(
                                                  d, e, u) e-is-nonzero
                                                  the-cofactor-is-nonzero
                                                  d-is-monic e-is-monic
                                                  d-is-the-multiple the-degrees-agree]
                                            }
                                          @conclusion-from-the-cofactor |
                                            d = e
                                            [by unpacked with-the-cofactor]
                                        }
                                      @conclusion-e-gcd-gives-it |
                                        isAGcd(e, p, q) -> d = e
                                        [by discharge given-e-is-a-gcd]
                                    }
                                  @conclusion-d-gcd-gives-it |
                                    isAGcd(d, p, q) -> isAGcd(e, p, q) -> d = e
                                    [by discharge given-d-is-a-gcd]
                                }
                              @conclusion-e-monic-gives-it |
                                monic.isMonic(e) ->
                                  isAGcd(d, p, q) -> isAGcd(e, p, q) -> d = e
                                [by discharge given-e-monic]
                            }
                          @conclusion-d-monic-gives-it |
                            monic.isMonic(d) -> monic.isMonic(e) ->
                              isAGcd(d, p, q) -> isAGcd(e, p, q) -> d = e
                            [by discharge given-d-monic]
                        }
                      @conclusion-e-nonzero-gives-it |
                        (not (e = ZEROP)) ->
                          monic.isMonic(d) -> monic.isMonic(e) ->
                          isAGcd(d, p, q) -> isAGcd(e, p, q) -> d = e
                        [by discharge given-e-nonzero]
                    }
                  @conclusion-all-give-it |
                    (not (d = ZEROP)) -> (not (e = ZEROP)) ->
                      monic.isMonic(d) -> monic.isMonic(e) ->
                      isAGcd(d, p, q) -> isAGcd(e, p, q) -> d = e
                    [by discharge given-d-nonzero]
                }
              @conclusion-for-all-q |
                forall q: Poly;
                  (not (d = ZEROP)) -> (not (e = ZEROP)) ->
                  monic.isMonic(d) -> monic.isMonic(e) ->
                  isAGcd(d, p, q) -> isAGcd(e, p, q) -> d = e
                [by generalize generalize-q]
            }
          @conclusion-for-all-p |
            forall p, q: Poly;
              (not (d = ZEROP)) -> (not (e = ZEROP)) ->
              monic.isMonic(d) -> monic.isMonic(e) ->
              isAGcd(d, p, q) -> isAGcd(e, p, q) -> d = e
            [by generalize generalize-p]
        }
      @conclusion-for-all-e |
        forall e, p, q: Poly;
          (not (d = ZEROP)) -> (not (e = ZEROP)) ->
          monic.isMonic(d) -> monic.isMonic(e) ->
          isAGcd(d, p, q) -> isAGcd(e, p, q) -> d = e
        [by generalize generalize-e]
    }
  @conclusion |
    forall d, e, p, q: Poly;
      (not (d = ZEROP)) -> (not (e = ZEROP)) ->
      monic.isMonic(d) -> monic.isMonic(e) ->
      isAGcd(d, p, q) -> isAGcd(e, p, q) -> d = e
    [by generalize generalize-d]
qed
