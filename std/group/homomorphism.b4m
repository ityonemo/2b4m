// std/group/homomorphism.b4m — a HOMOMORPHISM of groups (AATA §11.1).
//
// A homomorphism of groups (G, ·) and (H, ∘) is a map φ : G → H with
// φ(g₁ · g₂) = φ(g₁) ∘ φ(g₂). That is the whole definition — ONE axiom, and notably NOT
// bijectivity: `std/group/isomorphism.b4m` adds an inverse map `psi` plus two round-trip
// axioms, and every structural claim there is proved FROM those. Here there is nothing to lean
// on but operation-preservation, which is what makes this the weaker and more widely usable
// notion. Judson: "Two groups are related in the strongest possible way if they are
// isomorphic; however, a weaker relationship may exist between two groups."
//
// WHAT THIS FILE PROVES. Judson's Proposition 11.4 (the identity and inverses are preserved,
// and a subgroup's image is a subgroup), the KERNEL and IMAGE as predicates, and Theorem 11.6
// — the kernel is a NORMAL subgroup of G, which is what lets §11.2's isomorphism theorems
// treat every homomorphism as a factor group.
//
// TWO GROUPS MUST BE DECLARED, NOT ALIASED — the forced choice `std/group/isomorphism.b4m` and
// `std/group/product.b4m` both document. Namespaces are identity-by-origin, so `import group`
// twice names ONE theory and `sort G = groupA.Grp` / `sort H = groupB.Grp` yields the SAME
// sort. A homomorphism's whole content is a map between two INDEPENDENT groups, so both are
// declared here.
//
// φ IS A PRIMITIVE FUNCTION, not an `Fn` from std/function.b4m, for the same reason the
// isomorphism's is: `Fn` is a function on ONE sort (`apply(f, x) : Element → Element`), and a
// homomorphism's source and target are different sorts, so the function layer cannot type it.
//
// THE MODELS EARN THEIR KEEP. `GIsAGroup` / `HIsAGroup` are what give the right-sided laws and
// both cancellation laws on each side for free — every proof below uses cancellation in H, and
// none of it is re-proved. A model-transferred fact has no bare local name, so each is given
// one by a shim theorem; that is the ordinary price of the model system, not a defect.

import group <<< "std/group.b4m"

// -- the source group G -----------------------------------------------------------------------
sort G
const EG: G
func opG(a: G, b: G) => G
func invG(a: G) => G
axiom opGAssoc: forall a, b, c: G; opG(opG(a, b), c) = opG(a, opG(b, c))
axiom opGIdentityLeft: forall a: G; opG(EG, a) = a
axiom opGInverseLeft: forall a: G; opG(invG(a), a) = EG

// -- the target group H -----------------------------------------------------------------------
sort H
const EH: H
func opH(a: H, b: H) => H
func invH(a: H) => H
axiom opHAssoc: forall a, b, c: H; opH(opH(a, b), c) = opH(a, opH(b, c))
axiom opHIdentityLeft: forall a: H; opH(EH, a) = a
axiom opHInverseLeft: forall a: H; opH(invH(a), a) = EH

// G and H are groups, so their derived laws come from std/group.b4m rather than being
// re-proved here.
model GIsAGroup {
  group.Grp: G
  group.E: EG
  group.op: opG
  group.inverse: invG
  group.opAssoc <- opGAssoc
  group.opIdentityLeft <- opGIdentityLeft
  group.opInverseLeft <- opGInverseLeft
}

model HIsAGroup {
  group.Grp: H
  group.E: EH
  group.op: opH
  group.inverse: invH
  group.opAssoc <- opHAssoc
  group.opIdentityLeft <- opHIdentityLeft
  group.opInverseLeft <- opHInverseLeft
}

// -- H's derived laws under bare local names --------------------------------------------------
// A model-transferred fact has no bare name, and `specialize` resolves its head by name, so
// each law used below gets a one-line shim.

theorem cancelRightH: forall b: H; forall a: H; forall c: H; opH(b, a) = opH(c, a) -> b = c
proof
  @conclusion |
    forall b: H; forall a: H; forall c: H; opH(b, a) = opH(c, a) -> b = c
    [using model(HIsAGroup) group.cancelRight]
qed

// H's inverse-uniqueness law, needed for `identityInverseH` below.
theorem inverseUniqueH: forall a: H; forall b: H; opH(a, b) = EH -> b = invH(a)
proof
  @conclusion |
    forall a: H; forall b: H; opH(a, b) = EH -> b = invH(a)
    [using model(HIsAGroup) group.inverseUnique]
qed

// invH(EH) = EH — from opH(EH, EH) = EH and inverse-uniqueness. (`group.inverseIdentity`
// lives in std/group/sequence.b4m rather than std/group.b4m, so it is not on the model's
// transfer path; it is three lines here, exactly as there.)
theorem identityInverseH: invH(EH) = EH
proof
  @the-identity-times-itself |
    opH(EH, EH) = EH
    [using specialize opHIdentityLeft(EH)]
  @the-identity-is-its-own-inverse |
    EH = invH(EH)
    [using specialize inverseUniqueH(EH, EH) the-identity-times-itself]
  @conclusion |
    invH(EH) = EH
    [by symmetry the-identity-is-its-own-inverse]
qed

theorem identityRightH: forall a: H; opH(a, EH) = a
proof
  @conclusion |
    forall a: H; opH(a, EH) = a
    [using model(HIsAGroup) group.opIdentityRight]
qed

theorem inverseRightH: forall a: H; opH(a, invH(a)) = EH
proof
  @conclusion |
    forall a: H; opH(a, invH(a)) = EH
    [using model(HIsAGroup) group.opInverseRight]
qed

// THE HOMOMORPHISM -- one axiom, no bijectivity.
func phi(a: G) => H
axiom phiPreservesOp: forall a, b: G; phi(opG(a, b)) = opH(phi(a), phi(b))

// Judson Prop 11.4(1): phi(e) is the identity.
// "e' phi(e) = phi(e) = phi(ee) = phi(e)phi(e). By cancellation, phi(e) = e'."
theorem phiPreservesIdentity: phi(EG) = EH
proof
  @identity-is-idempotent |
    opG(EG, EG) = EG
    [using specialize opGIdentityLeft(EG)]
  @phi-of-the-product |
    phi(opG(EG, EG)) = opH(phi(EG), phi(EG))
    [using specialize phiPreservesOp(EG, EG)]
  @phi-of-the-identity |
    phi(EG) = opH(phi(EG), phi(EG))
    [by rewrite identity-is-idempotent phi-of-the-product]
  @the-identity-absorbs |
    opH(EH, phi(EG)) = phi(EG)
    [using specialize opHIdentityLeft(phi(EG))]
  @both-products-agree |
    opH(EH, phi(EG)) = opH(phi(EG), phi(EG))
    [using chain the-identity-absorbs phi-of-the-identity]
  @the-identity-is-the-image |
    EH = phi(EG)
    [using specialize cancelRightH(EH, phi(EG), phi(EG)) both-products-agree]
  @conclusion |
    phi(EG) = EH
    [by symmetry the-identity-is-the-image]
qed

// Judson Prop 11.4(2): phi(g^-1) = phi(g)^-1.
theorem phiPreservesInverses: forall g: G; phi(invG(g)) = invH(phi(g))
proof
  @generalize-g |
    fix g: G {
      @the-inverse-cancels |
        opG(invG(g), g) = EG
        [using specialize opGInverseLeft(g)]
      @phi-of-the-product |
        phi(opG(invG(g), g)) = opH(phi(invG(g)), phi(g))
        [using specialize phiPreservesOp(invG(g), g)]
      @phi-of-the-identity-product |
        phi(EG) = opH(phi(invG(g)), phi(g))
        [by rewrite the-inverse-cancels phi-of-the-product]
      @the-image-of-the-identity |
        phi(EG) = EH
        [by cite phiPreservesIdentity]
      @the-product-is-the-identity |
        EH = opH(phi(invG(g)), phi(g))
        [by rewrite the-image-of-the-identity phi-of-the-identity-product]
      @the-inverses-product |
        opH(invH(phi(g)), phi(g)) = EH
        [using specialize opHInverseLeft(phi(g))]
      @both-agree |
        opH(invH(phi(g)), phi(g)) = opH(phi(invG(g)), phi(g))
        [using chain the-inverses-product the-product-is-the-identity]
      @the-inverse-is-the-image |
        invH(phi(g)) = phi(invG(g))
        [using specialize cancelRightH(invH(phi(g)), phi(g), phi(invG(g))) both-agree]
      @conclusion-at-g |
        phi(invG(g)) = invH(phi(g))
        [by symmetry the-inverse-is-the-image]
    }
  @conclusion |
    forall g: G; phi(invG(g)) = invH(phi(g))
    [by generalize generalize-g]
qed

// THE KERNEL, as a membership predicate on G.
pred inKernel(g: G)
axiom inKernelDef: forall g: G; inKernel(g) iff phi(g) = EH

// Judson Thm 11.6: the kernel is a NORMAL subgroup of G.
// Subgroup first: the identity is in it, and it is closed under op and inverses.
theorem theKernelHasTheIdentity: inKernel(EG)
proof
  @the-image-of-the-identity |
    phi(EG) = EH
    [by cite phiPreservesIdentity]
  @what-the-kernel-means |
    inKernel(EG) iff phi(EG) = EH
    [using specialize inKernelDef(EG)]
  @conclusion |
    inKernel(EG)
    [using tautology what-the-kernel-means the-image-of-the-identity]
qed

// NORMALITY: phi(g n g^-1) = phi(g) e' phi(g)^-1 = e', so g n g^-1 is in the kernel.
theorem theKernelIsNormal: forall g: G; forall n: G;
  inKernel(n) -> inKernel(opG(opG(g, n), invG(g)))
proof
  @generalize-g |
    fix g: G {
      @generalize-n |
        fix n: G {
          @given-n-in-the-kernel |
            assume inKernel(n) {
              @n-is-in-the-kernel |
                inKernel(n)
                [by hypothesis given-n-in-the-kernel]
              @what-the-kernel-means-for-n |
                inKernel(n) iff phi(n) = EH
                [using specialize inKernelDef(n)]
              @phi-kills-n |
                phi(n) = EH
                [using tautology what-the-kernel-means-for-n n-is-in-the-kernel]

              // phi(gng^-1) = phi(gn) phi(g^-1) = phi(g)phi(n) phi(g)^-1
              @split-the-outer |
                phi(opG(opG(g, n), invG(g))) = opH(phi(opG(g, n)), phi(invG(g)))
                [using specialize phiPreservesOp(opG(g, n), invG(g))]
              @split-the-inner |
                phi(opG(g, n)) = opH(phi(g), phi(n))
                [using specialize phiPreservesOp(g, n)]
              @with-the-inner-split |
                phi(opG(opG(g, n), invG(g))) = opH(opH(phi(g), phi(n)), phi(invG(g)))
                [by rewrite split-the-inner split-the-outer]
              @the-image-of-the-inverse |
                phi(invG(g)) = invH(phi(g))
                [using specialize phiPreservesInverses(g)]
              @with-the-inverse |
                phi(opG(opG(g, n), invG(g))) = opH(opH(phi(g), phi(n)), invH(phi(g)))
                [by rewrite the-image-of-the-inverse with-the-inner-split]
              @with-n-killed |
                phi(opG(opG(g, n), invG(g))) = opH(opH(phi(g), EH), invH(phi(g)))
                [by rewrite phi-kills-n with-the-inverse]

              // phi(g) e' phi(g)^-1 = phi(g) phi(g)^-1 = e'
              @the-identity-absorbs-on-the-right |
                opH(phi(g), EH) = phi(g)
                [using specialize identityRightH(phi(g))]
              @collapsed |
                phi(opG(opG(g, n), invG(g))) = opH(phi(g), invH(phi(g)))
                [by rewrite the-identity-absorbs-on-the-right with-n-killed]
              @the-inverse-cancels-on-the-right |
                opH(phi(g), invH(phi(g))) = EH
                [using specialize inverseRightH(phi(g))]
              @the-conjugate-is-killed |
                phi(opG(opG(g, n), invG(g))) = EH
                [using chain collapsed the-inverse-cancels-on-the-right]
              @what-the-kernel-means-for-the-conjugate |
                inKernel(opG(opG(g, n), invG(g))) iff phi(opG(opG(g, n), invG(g))) = EH
                [using specialize inKernelDef(opG(opG(g, n), invG(g)))]
              @conclusion-the-conjugate-is-in |
                inKernel(opG(opG(g, n), invG(g)))
                [using tautology what-the-kernel-means-for-the-conjugate the-conjugate-is-killed]
            }
          @conclusion-at-n |
            inKernel(n) -> inKernel(opG(opG(g, n), invG(g)))
            [by discharge given-n-in-the-kernel]
        }
      @discharge-n |
        forall n: G; inKernel(n) -> inKernel(opG(opG(g, n), invG(g)))
        [by generalize generalize-n]
    }
  @conclusion |
    forall g: G; forall n: G; inKernel(n) -> inKernel(opG(opG(g, n), invG(g)))
    [by generalize generalize-g]
qed

// The kernel is closed under G's operation: φ(ab) = φ(a)φ(b) = e'e' = e'.
theorem theKernelIsClosedUnderTheOperation: forall a: G; forall b: G;
  inKernel(a) -> inKernel(b) -> inKernel(opG(a, b))
proof
  @generalize-a |
    fix a: G {
      @generalize-b |
        fix b: G {
          @given-a-in-the-kernel |
            assume inKernel(a) {
              @given-b-in-the-kernel |
                assume inKernel(b) {
                  @a-is-in-the-kernel |
                    inKernel(a)
                    [by hypothesis given-a-in-the-kernel]
                  @b-is-in-the-kernel |
                    inKernel(b)
                    [by hypothesis given-b-in-the-kernel]
                  @what-the-kernel-means-for-a |
                    inKernel(a) iff phi(a) = EH
                    [using specialize inKernelDef(a)]
                  @what-the-kernel-means-for-b |
                    inKernel(b) iff phi(b) = EH
                    [using specialize inKernelDef(b)]
                  @phi-kills-a |
                    phi(a) = EH
                    [using tautology what-the-kernel-means-for-a a-is-in-the-kernel]
                  @phi-kills-b |
                    phi(b) = EH
                    [using tautology what-the-kernel-means-for-b b-is-in-the-kernel]
                  @phi-splits-the-product |
                    phi(opG(a, b)) = opH(phi(a), phi(b))
                    [using specialize phiPreservesOp(a, b)]
                  @with-a-killed |
                    phi(opG(a, b)) = opH(EH, phi(b))
                    [by rewrite phi-kills-a phi-splits-the-product]
                  @with-both-killed |
                    phi(opG(a, b)) = opH(EH, EH)
                    [by rewrite phi-kills-b with-a-killed]
                  @the-identity-absorbs |
                    opH(EH, EH) = EH
                    [using specialize opHIdentityLeft(EH)]
                  @the-product-is-killed |
                    phi(opG(a, b)) = EH
                    [using chain with-both-killed the-identity-absorbs]
                  @what-the-kernel-means-for-the-product |
                    inKernel(opG(a, b)) iff phi(opG(a, b)) = EH
                    [using specialize inKernelDef(opG(a, b))]
                  @conclusion-the-product-is-in-the-kernel |
                    inKernel(opG(a, b))
                    [using tautology what-the-kernel-means-for-the-product the-product-is-killed]
                }
              @b-in-kernel-implies |
                inKernel(b) -> inKernel(opG(a, b))
                [by discharge given-b-in-the-kernel]
            }
          @conclusion-at-a-and-b |
            inKernel(a) -> inKernel(b) -> inKernel(opG(a, b))
            [by discharge given-a-in-the-kernel]
        }
      @discharge-b |
        forall b: G; inKernel(a) -> inKernel(b) -> inKernel(opG(a, b))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a: G; forall b: G; inKernel(a) -> inKernel(b) -> inKernel(opG(a, b))
    [by generalize generalize-a]
qed

// And under inverses: φ(a⁻¹) = φ(a)⁻¹ = e'⁻¹ = e'.
theorem theKernelIsClosedUnderInverses: forall a: G;
  inKernel(a) -> inKernel(invG(a))
proof
  @generalize-a |
    fix a: G {
      @given-a-in-the-kernel |
        assume inKernel(a) {
          @a-is-in-the-kernel |
            inKernel(a)
            [by hypothesis given-a-in-the-kernel]
          @what-the-kernel-means-for-a |
            inKernel(a) iff phi(a) = EH
            [using specialize inKernelDef(a)]
          @phi-kills-a |
            phi(a) = EH
            [using tautology what-the-kernel-means-for-a a-is-in-the-kernel]
          @phi-of-the-inverse |
            phi(invG(a)) = invH(phi(a))
            [using specialize phiPreservesInverses(a)]
          @with-a-killed |
            phi(invG(a)) = invH(EH)
            [by rewrite phi-kills-a phi-of-the-inverse]
          @the-identitys-inverse |
            invH(EH) = EH
            [by cite identityInverseH]
          @the-inverse-is-killed |
            phi(invG(a)) = EH
            [using chain with-a-killed the-identitys-inverse]
          @what-the-kernel-means-for-the-inverse |
            inKernel(invG(a)) iff phi(invG(a)) = EH
            [using specialize inKernelDef(invG(a))]
          @conclusion-the-inverse-is-in-the-kernel |
            inKernel(invG(a))
            [using tautology what-the-kernel-means-for-the-inverse the-inverse-is-killed]
        }
      @conclusion-at-a |
        inKernel(a) -> inKernel(invG(a))
        [by discharge given-a-in-the-kernel]
    }
  @conclusion |
    forall a: G; inKernel(a) -> inKernel(invG(a))
    [by generalize generalize-a]
qed

// -- THE IMAGE (Judson Prop 11.4(3)) ----------------------------------------------------------
//
// "If H₁ is a subgroup of G₁, then φ(H₁) is a subgroup of G₂." Judson proves it by the
// one-step test: φ(H₁) is nonempty, and xy⁻¹ = φ(a)[φ(b)]⁻¹ = φ(ab⁻¹) ∈ φ(H₁).
//
// `inSource` is the subgroup H₁ of G — a predicate, as every subgroup in std is. The IMAGE of
// the whole of G is this at `inSource` = everything, so the general statement is the one worth
// having.

pred inSource(g: G)
axiom sourceHasIdentity: inSource(EG)
axiom sourceClosedOp: forall a, b: G; inSource(a) -> inSource(b) -> inSource(opG(a, b))
axiom sourceClosedInverse: forall a: G; inSource(a) -> inSource(invG(a))

// x is in φ(H₁) when some source-subgroup element maps to it. A `define`, so the kernel only
// ever sees the body — the same choice `coset.inCoset` and `generated.inGenerated` make.
define inImage(x) = exists g: G; inSource(g) and x = phi(g)

// The image contains H's identity, since φ(e) = e' and e is in H₁.
theorem theImageHasTheIdentity: inImage(EH)
proof
  @the-identity-is-in-the-source |
    inSource(EG)
    [by cite sourceHasIdentity]
  @the-image-of-the-identity |
    phi(EG) = EH
    [by cite phiPreservesIdentity]
  @the-identity-is-its-own-image |
    EH = phi(EG)
    [by symmetry the-image-of-the-identity]
  @the-witness |
    inSource(EG) and EH = phi(EG)
    [by both the-identity-is-in-the-source the-identity-is-its-own-image]
  @conclusion |
    inImage(EH)
    [by witness(EG) the-witness]
qed

// The image is closed under H's operation: φ(a)∘φ(b) = φ(a·b), and a·b is in H₁.
theorem theImageIsClosedUnderTheOperation: forall x: H; forall y: H;
  inImage(x) -> inImage(y) -> inImage(opH(x, y))
proof
  @generalize-x |
    fix x: H {
      @generalize-y |
        fix y: H {
          @given-x-in-the-image |
            assume inImage(x) {
              @given-y-in-the-image |
                assume inImage(y) {
                  @x-is-an-image |
                    exists g: G; inSource(g) and x = phi(g)
                    [by hypothesis given-x-in-the-image]
                  @y-is-an-image |
                    exists g: G; inSource(g) and y = phi(g)
                    [by hypothesis given-y-in-the-image]
                  @with-x-preimage |
                    unpack a: G from x-is-an-image {
                      @the-x-witness |
                        inSource(a) and x = phi(a)
                        [by hypothesis with-x-preimage]
                      @a-is-in-the-source |
                        inSource(a)
                        [by and_lhs the-x-witness]
                      @x-is-phi-a |
                        x = phi(a)
                        [by and_rhs the-x-witness]
                      @with-y-preimage |
                        unpack b: G from y-is-an-image {
                          @the-y-witness |
                            inSource(b) and y = phi(b)
                            [by hypothesis with-y-preimage]
                          @b-is-in-the-source |
                            inSource(b)
                            [by and_lhs the-y-witness]
                          @y-is-phi-b |
                            y = phi(b)
                            [by and_rhs the-y-witness]
                          @the-product-is-in-the-source |
                            inSource(opG(a, b))
                            [using specialize sourceClosedOp(a, b) a-is-in-the-source b-is-in-the-source]
                          @phi-splits-the-product |
                            phi(opG(a, b)) = opH(phi(a), phi(b))
                            [using specialize phiPreservesOp(a, b)]
                          @the-product-of-images |
                            opH(x, y) = opH(phi(a), phi(b))
                            [using simplify x-is-phi-a y-is-phi-b]
                          @the-product-is-an-image |
                            opH(x, y) = phi(opG(a, b))
                            [using chain the-product-of-images phi-splits-the-product]
                          @the-witness |
                            inSource(opG(a, b)) and opH(x, y) = phi(opG(a, b))
                            [by both the-product-is-in-the-source the-product-is-an-image]
                          @conclusion-the-product-is-in-the-image |
                            inImage(opH(x, y))
                            [by witness(opG(a, b)) the-witness]
                        }
                      @conclusion-after-y |
                        inImage(opH(x, y))
                        [by unpacked with-y-preimage]
                    }
                  @conclusion-after-x |
                    inImage(opH(x, y))
                    [by unpacked with-x-preimage]
                }
              @y-in-image-implies |
                inImage(y) -> inImage(opH(x, y))
                [by discharge given-y-in-the-image]
            }
          @conclusion-at-x-and-y |
            inImage(x) -> inImage(y) -> inImage(opH(x, y))
            [by discharge given-x-in-the-image]
        }
      @discharge-y |
        forall y: H; inImage(x) -> inImage(y) -> inImage(opH(x, y))
        [by generalize generalize-y]
    }
  @conclusion |
    forall x: H; forall y: H; inImage(x) -> inImage(y) -> inImage(opH(x, y))
    [by generalize generalize-x]
qed

// And under inverses: φ(a)⁻¹ = φ(a⁻¹), and a⁻¹ is in H₁.
theorem theImageIsClosedUnderInverses: forall x: H;
  inImage(x) -> inImage(invH(x))
proof
  @generalize-x |
    fix x: H {
      @given-x-in-the-image |
        assume inImage(x) {
          @x-is-an-image |
            exists g: G; inSource(g) and x = phi(g)
            [by hypothesis given-x-in-the-image]
          @with-x-preimage |
            unpack a: G from x-is-an-image {
              @the-x-witness |
                inSource(a) and x = phi(a)
                [by hypothesis with-x-preimage]
              @a-is-in-the-source |
                inSource(a)
                [by and_lhs the-x-witness]
              @x-is-phi-a |
                x = phi(a)
                [by and_rhs the-x-witness]
              @the-inverse-is-in-the-source |
                inSource(invG(a))
                [using specialize sourceClosedInverse(a) a-is-in-the-source]
              @phi-of-the-inverse |
                phi(invG(a)) = invH(phi(a))
                [using specialize phiPreservesInverses(a)]
              @the-inverse-of-the-image |
                invH(x) = invH(phi(a))
                [using simplify x-is-phi-a]
              @the-inverse-is-an-image |
                invH(x) = phi(invG(a))
                [using chain the-inverse-of-the-image phi-of-the-inverse]
              @the-witness |
                inSource(invG(a)) and invH(x) = phi(invG(a))
                [by both the-inverse-is-in-the-source the-inverse-is-an-image]
              @conclusion-the-inverse-is-in-the-image |
                inImage(invH(x))
                [by witness(invG(a)) the-witness]
            }
          @conclusion-after-x |
            inImage(invH(x))
            [by unpacked with-x-preimage]
        }
      @conclusion-at-x |
        inImage(x) -> inImage(invH(x))
        [by discharge given-x-in-the-image]
    }
  @conclusion |
    forall x: H; inImage(x) -> inImage(invH(x))
    [by generalize generalize-x]
qed

// -- THE PREIMAGE (Judson Prop 11.4(4)) -------------------------------------------------------
//
// "If H₂ is a subgroup of G₂, then φ⁻¹(H₂) = {g ∈ G₁ : φ(g) ∈ H₂} is a subgroup of G₁.
// Furthermore, if H₂ is normal in G₂, then φ⁻¹(H₂) is normal in G₁."
//
// `inTarget` is the subgroup H₂ of H. Theorem 11.6 (the kernel is normal) is this at
// H₂ = {e'}: the kernel IS φ⁻¹({e'}), and the trivial subgroup is normal in any group, which
// is why Judson derives the kernel's normality from this proposition rather than separately.
// Both are proved here — the kernel directly above, the general preimage here — because the
// kernel's proof needs no subgroup predicate on H and is the one §11.2 actually cites.

pred inTarget(x: H)
axiom targetHasIdentity: inTarget(EH)
axiom targetClosedOp: forall x, y: H; inTarget(x) -> inTarget(y) -> inTarget(opH(x, y))
axiom targetClosedInverse: forall x: H; inTarget(x) -> inTarget(invH(x))

define inPreimage(g) = inTarget(phi(g))

theorem thePreimageHasTheIdentity: inPreimage(EG)
proof
  @the-image-of-the-identity |
    phi(EG) = EH
    [by cite phiPreservesIdentity]
  @the-identity-is-in-the-target |
    inTarget(EH)
    [by cite targetHasIdentity]
  @conclusion |
    inPreimage(EG)
    [by rewrite the-image-of-the-identity the-identity-is-in-the-target]
qed

theorem thePreimageIsClosedUnderTheOperation: forall a: G; forall b: G;
  inPreimage(a) -> inPreimage(b) -> inPreimage(opG(a, b))
proof
  @generalize-a |
    fix a: G {
      @generalize-b |
        fix b: G {
          @given-a-in-the-preimage |
            assume inPreimage(a) {
              @given-b-in-the-preimage |
                assume inPreimage(b) {
                  @phi-a-is-in-the-target |
                    inTarget(phi(a))
                    [by hypothesis given-a-in-the-preimage]
                  @phi-b-is-in-the-target |
                    inTarget(phi(b))
                    [by hypothesis given-b-in-the-preimage]
                  @the-product-of-images-is-in-the-target |
                    inTarget(opH(phi(a), phi(b)))
                    [using specialize targetClosedOp(phi(a), phi(b)) phi-a-is-in-the-target phi-b-is-in-the-target]
                  @phi-splits-the-product |
                    phi(opG(a, b)) = opH(phi(a), phi(b))
                    [using specialize phiPreservesOp(a, b)]
                  @conclusion-the-product-is-in-the-preimage |
                    inPreimage(opG(a, b))
                    [by rewrite phi-splits-the-product the-product-of-images-is-in-the-target]
                }
              @b-implies |
                inPreimage(b) -> inPreimage(opG(a, b))
                [by discharge given-b-in-the-preimage]
            }
          @conclusion-at-a-and-b |
            inPreimage(a) -> inPreimage(b) -> inPreimage(opG(a, b))
            [by discharge given-a-in-the-preimage]
        }
      @discharge-b |
        forall b: G; inPreimage(a) -> inPreimage(b) -> inPreimage(opG(a, b))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a: G; forall b: G; inPreimage(a) -> inPreimage(b) -> inPreimage(opG(a, b))
    [by generalize generalize-a]
qed

theorem thePreimageIsClosedUnderInverses: forall a: G;
  inPreimage(a) -> inPreimage(invG(a))
proof
  @generalize-a |
    fix a: G {
      @given-a-in-the-preimage |
        assume inPreimage(a) {
          @phi-a-is-in-the-target |
            inTarget(phi(a))
            [by hypothesis given-a-in-the-preimage]
          @the-inverse-of-the-image-is-in-the-target |
            inTarget(invH(phi(a)))
            [using specialize targetClosedInverse(phi(a)) phi-a-is-in-the-target]
          @phi-of-the-inverse |
            phi(invG(a)) = invH(phi(a))
            [using specialize phiPreservesInverses(a)]
          @conclusion-the-inverse-is-in-the-preimage |
            inPreimage(invG(a))
            [by rewrite phi-of-the-inverse the-inverse-of-the-image-is-in-the-target]
        }
      @conclusion-at-a |
        inPreimage(a) -> inPreimage(invG(a))
        [by discharge given-a-in-the-preimage]
    }
  @conclusion |
    forall a: G; inPreimage(a) -> inPreimage(invG(a))
    [by generalize generalize-a]
qed

// THE NORMALITY HALF. "If H₂ is normal in G₂, we must show that g⁻¹hg ∈ H₁ for h ∈ H₁ and
// g ∈ G₁." φ(g·h·g⁻¹) = φ(g)·φ(h)·φ(g)⁻¹ is in H₂ by H₂'s normality, so g·h·g⁻¹ is in the
// preimage. This is where G's ASSOCIATIVITY enters — φ splits a three-fold product only after
// the grouping is fixed, and `phiPreservesOp` applies to a binary product.
theorem thePreimageOfANormalSubgroupIsNormal:
  (forall x: H; forall y: H; inTarget(y) -> inTarget(opH(opH(x, y), invH(x)))) ->
  forall g: G; forall n: G; inPreimage(n) -> inPreimage(opG(opG(g, n), invG(g)))
proof
  @given-the-target-is-normal |
    assume forall x: H; forall y: H; inTarget(y) -> inTarget(opH(opH(x, y), invH(x))) {
      @the-target-is-normal |
        forall x: H; forall y: H; inTarget(y) -> inTarget(opH(opH(x, y), invH(x)))
        [by hypothesis given-the-target-is-normal]
      @generalize-g |
        fix g: G {
          @generalize-n |
            fix n: G {
              @given-n-in-the-preimage |
                assume inPreimage(n) {
                  @phi-n-is-in-the-target |
                    inTarget(phi(n))
                    [by hypothesis given-n-in-the-preimage]
                  @the-conjugate-of-the-image-is-in-the-target |
                    inTarget(opH(opH(phi(g), phi(n)), invH(phi(g))))
                    [using specialize the-target-is-normal(phi(g), phi(n)) phi-n-is-in-the-target]
                  @phi-splits-the-outer |
                    phi(opG(opG(g, n), invG(g))) = opH(phi(opG(g, n)), phi(invG(g)))
                    [using specialize phiPreservesOp(opG(g, n), invG(g))]
                  @phi-splits-the-inner |
                    phi(opG(g, n)) = opH(phi(g), phi(n))
                    [using specialize phiPreservesOp(g, n)]
                  @with-the-inner-split |
                    phi(opG(opG(g, n), invG(g))) = opH(opH(phi(g), phi(n)), phi(invG(g)))
                    [by rewrite phi-splits-the-inner phi-splits-the-outer]
                  @phi-of-the-inverse |
                    phi(invG(g)) = invH(phi(g))
                    [using specialize phiPreservesInverses(g)]
                  @the-conjugates-image |
                    phi(opG(opG(g, n), invG(g))) = opH(opH(phi(g), phi(n)), invH(phi(g)))
                    [by rewrite phi-of-the-inverse with-the-inner-split]
                  @conclusion-the-conjugate-is-in-the-preimage |
                    inPreimage(opG(opG(g, n), invG(g)))
                    [by rewrite the-conjugates-image the-conjugate-of-the-image-is-in-the-target]
                }
              @conclusion-at-n |
                inPreimage(n) -> inPreimage(opG(opG(g, n), invG(g)))
                [by discharge given-n-in-the-preimage]
            }
          @discharge-n |
            forall n: G; inPreimage(n) -> inPreimage(opG(opG(g, n), invG(g)))
            [by generalize generalize-n]
        }
      @all-g |
        forall g: G; forall n: G; inPreimage(n) -> inPreimage(opG(opG(g, n), invG(g)))
        [by generalize generalize-g]
    }
  @conclusion |
    (forall x: H; forall y: H; inTarget(y) -> inTarget(opH(opH(x, y), invH(x)))) ->
      forall g: G; forall n: G; inPreimage(n) -> inPreimage(opG(opG(g, n), invG(g)))
    [by discharge given-the-target-is-normal]
qed

// -- A HOMOMORPHISM IS INJECTIVE EXACTLY WHEN ITS KERNEL IS TRIVIAL ---------------------------
//
// Judson uses this throughout §11.2 without stating it as a numbered result — it is how he
// reads "ker ψ = {e}" as "ψ is one-to-one" in the First Isomorphism Theorem's last step, and
// how §11.1's ℤ₇ → ℤ₁₂ example concludes there is no injective homomorphism.
//
// This is the first result here that needs G to be a GROUP rather than just a set with a map:
// the forward direction cancels in G (φ(a) = φ(b) ⟹ φ(a⁻¹b) = e' ⟹ a⁻¹b ∈ ker ⟹ a⁻¹b = e
// ⟹ a = b), and that last step is `opG`'s cancellation, which `GIsAGroup` supplies.

theorem identityRightG: forall a: G; opG(a, EG) = a
proof
  @conclusion |
    forall a: G; opG(a, EG) = a
    [using model(GIsAGroup) group.opIdentityRight]
qed

theorem cancelLeftG: forall a: G; forall b: G; forall c: G; opG(a, b) = opG(a, c) -> b = c
proof
  @conclusion |
    forall a: G; forall b: G; forall c: G; opG(a, b) = opG(a, c) -> b = c
    [using model(GIsAGroup) group.cancelLeft]
qed

theorem inverseRightG: forall a: G; opG(a, invG(a)) = EG
proof
  @conclusion |
    forall a: G; opG(a, invG(a)) = EG
    [using model(GIsAGroup) group.opInverseRight]
qed

// FORWARD: a trivial kernel forces injectivity.
theorem aTrivialKernelMakesPhiInjective:
  (forall g: G; inKernel(g) -> g = EG) ->
  forall a: G; forall b: G; phi(a) = phi(b) -> a = b
proof
  @given-the-kernel-is-trivial |
    assume forall g: G; inKernel(g) -> g = EG {
      @the-kernel-is-trivial |
        forall g: G; inKernel(g) -> g = EG
        [by hypothesis given-the-kernel-is-trivial]
      @generalize-a |
        fix a: G {
          @generalize-b |
            fix b: G {
              @given-images-agree |
                assume phi(a) = phi(b) {
                  @images-agree |
                    phi(a) = phi(b)
                    [by hypothesis given-images-agree]
                  // φ(a⁻¹b) = φ(a)⁻¹φ(b) = φ(a)⁻¹φ(a) = e'
                  @phi-splits-the-quotient |
                    phi(opG(invG(a), b)) = opH(phi(invG(a)), phi(b))
                    [using specialize phiPreservesOp(invG(a), b)]
                  @phi-of-the-inverse |
                    phi(invG(a)) = invH(phi(a))
                    [using specialize phiPreservesInverses(a)]
                  @the-quotients-image |
                    phi(opG(invG(a), b)) = opH(invH(phi(a)), phi(b))
                    [by rewrite phi-of-the-inverse phi-splits-the-quotient]
                  @with-the-images-equal |
                    phi(opG(invG(a), b)) = opH(invH(phi(a)), phi(a))
                    [by rewrite images-agree the-quotients-image]
                  @the-inverse-cancels |
                    opH(invH(phi(a)), phi(a)) = EH
                    [using specialize opHInverseLeft(phi(a))]
                  @the-quotient-is-killed |
                    phi(opG(invG(a), b)) = EH
                    [using chain with-the-images-equal the-inverse-cancels]
                  @what-the-kernel-means |
                    inKernel(opG(invG(a), b)) iff phi(opG(invG(a), b)) = EH
                    [using specialize inKernelDef(opG(invG(a), b))]
                  @the-quotient-is-in-the-kernel |
                    inKernel(opG(invG(a), b))
                    [using tautology what-the-kernel-means the-quotient-is-killed]
                  // a trivial kernel makes a⁻¹b the identity, and cancellation gives a = b
                  @the-quotient-is-the-identity |
                    opG(invG(a), b) = EG
                    [using specialize the-kernel-is-trivial(opG(invG(a), b)) the-quotient-is-in-the-kernel]
                  @a-times-the-quotient |
                    opG(a, opG(invG(a), b)) = opG(a, EG)
                    [using simplify the-quotient-is-the-identity]
                  @the-regrouping |
                    opG(opG(a, invG(a)), b) = opG(a, opG(invG(a), b))
                    [using specialize opGAssoc(a, invG(a), b)]
                  @the-left-side-regroups |
                    opG(a, opG(invG(a), b)) = opG(opG(a, invG(a)), b)
                    [by symmetry the-regrouping]
                  @the-inverse-cancels-in-g |
                    opG(a, invG(a)) = EG
                    [using specialize inverseRightG(a)]
                  @the-left-side-is-b |
                    opG(opG(a, invG(a)), b) = opG(EG, b)
                    [using simplify the-inverse-cancels-in-g]
                  @the-identity-absorbs |
                    opG(EG, b) = b
                    [using specialize opGIdentityLeft(b)]
                  @the-regrouped-left-is-b |
                    opG(a, opG(invG(a), b)) = b
                    [using chain the-left-side-regroups the-left-side-is-b the-identity-absorbs]
                  @the-right-side-is-a |
                    opG(a, EG) = a
                    [using specialize identityRightG(a)]
                  @b-is-a |
                    b = a
                    [using chain the-regrouped-left-is-b a-times-the-quotient the-right-side-is-a]
                  @conclusion-at-a-and-b |
                    a = b
                    [by symmetry b-is-a]
                }
              @images-imply |
                phi(a) = phi(b) -> a = b
                [by discharge given-images-agree]
            }
          @discharge-b |
            forall b: G; phi(a) = phi(b) -> a = b
            [by generalize generalize-b]
        }
      @all-a |
        forall a: G; forall b: G; phi(a) = phi(b) -> a = b
        [by generalize generalize-a]
    }
  @conclusion |
    (forall g: G; inKernel(g) -> g = EG) ->
      forall a: G; forall b: G; phi(a) = phi(b) -> a = b
    [by discharge given-the-kernel-is-trivial]
qed

// BACKWARD: injectivity forces a trivial kernel. φ(g) = e' = φ(e), so g = e.
theorem anInjectivePhiHasATrivialKernel:
  (forall a: G; forall b: G; phi(a) = phi(b) -> a = b) ->
  forall g: G; inKernel(g) -> g = EG
proof
  @given-phi-injective |
    assume forall a: G; forall b: G; phi(a) = phi(b) -> a = b {
      @phi-is-injective |
        forall a: G; forall b: G; phi(a) = phi(b) -> a = b
        [by hypothesis given-phi-injective]
      @generalize-g |
        fix g: G {
          @given-g-in-the-kernel |
            assume inKernel(g) {
              @g-is-in-the-kernel |
                inKernel(g)
                [by hypothesis given-g-in-the-kernel]
              @what-the-kernel-means |
                inKernel(g) iff phi(g) = EH
                [using specialize inKernelDef(g)]
              @phi-kills-g |
                phi(g) = EH
                [using tautology what-the-kernel-means g-is-in-the-kernel]
              @the-image-of-the-identity |
                phi(EG) = EH
                [by cite phiPreservesIdentity]
              @the-identity-is-the-image |
                EH = phi(EG)
                [by symmetry the-image-of-the-identity]
              @the-images-agree |
                phi(g) = phi(EG)
                [using chain phi-kills-g the-identity-is-the-image]
              @conclusion-g-is-the-identity |
                g = EG
                [using specialize phi-is-injective(g, EG) the-images-agree]
            }
          @conclusion-at-g |
            inKernel(g) -> g = EG
            [by discharge given-g-in-the-kernel]
        }
      @all-g |
        forall g: G; inKernel(g) -> g = EG
        [by generalize generalize-g]
    }
  @conclusion |
    (forall a: G; forall b: G; phi(a) = phi(b) -> a = b) ->
      forall g: G; inKernel(g) -> g = EG
    [by discharge given-phi-injective]
qed
