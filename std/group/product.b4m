// std/group/product.b4m — the DIRECT PRODUCT G × H of two groups (AATA §3.2, Example 3.14).
//
// Pairs (g, h) multiply componentwise: (g, h)(g', h') = (gg', hh'); the identity is (e, e) and
// the inverse is (g⁻¹, h⁻¹).
//
// THE TWO FACTORS ARE DECLARED HERE, abstractly — the one place in std besides a root theory
// that declares a group sort rather than aliasing `group.Grp`, and the reason is forced.
// Namespaces are identity-by-origin, so `import group` twice names ONE theory: two imports
// collapse, and `sort G = groupA.Grp` / `sort H = groupB.Grp` yields the SAME sort (verified —
// both binders print `Grp` and a two-factor goal fails). A product needs two INDEPENDENT factor
// theories, so at least one must be declared. Declaring both rather than aliasing one keeps the
// factors SYMMETRIC, which is the whole content of the theory; the concrete consumer
// (`std/integer/mod-n-product.b4m`, ℤ_n × ℤ_n) models both factors onto one concrete group and
// would read as though the first were privileged otherwise.
//
// A pair is
// characterized by its projections (fstPair, sndPair) and extensionality (a pair is the pair of
// its projections). The product laws are proved, and `model ProductGroup` makes G × H a group
// so the whole corpus transfers. A CONCRETE product (ℤ_n × ℤ_n, ℝ* × ℤ) models THIS theory —
// its factors' laws discharge the factor axioms, a concrete pair sort discharges the three
// pair axioms — and inherits everything below.

import group <<< "std/group.b4m"
import integer <<< "std/integer.b4m"

// -- the first factor G ---------------------------------------------------------------------
sort G
const EG: G
func opG(a: G, b: G) => G
func invG(a: G) => G
axiom opGAssoc: forall a, b, c: G; opG(opG(a, b), c) = opG(a, opG(b, c))
axiom opGIdentityLeft: forall a: G; opG(EG, a) = a
axiom opGInverseLeft: forall a: G; opG(invG(a), a) = EG

// -- the second factor H --------------------------------------------------------------------
sort H
const EH: H
func opH(a: H, b: H) => H
func invH(a: H) => H
axiom opHAssoc: forall a, b, c: H; opH(opH(a, b), c) = opH(a, opH(b, c))
axiom opHIdentityLeft: forall a: H; opH(EH, a) = a
axiom opHInverseLeft: forall a: H; opH(invH(a), a) = EH

// -- pairs -----------------------------------------------------------------------------------
sort Pair
func pair(g: G, h: H) => Pair
func fst(p: Pair) => G
func snd(p: Pair) => H
axiom fstPair: forall g: G; forall h: H; fst(pair(g, h)) = g
axiom sndPair: forall g: G; forall h: H; snd(pair(g, h)) = h
axiom pairExtensionality: forall p: Pair; pair(fst(p), snd(p)) = p

// -- the componentwise structure -------------------------------------------------------------
// REAL symbols with NAMED defining axioms, not defines or definition blocks: a concrete product
// models this theory, and a model block discharges axioms BY NAME (`product.prodOpDef <- …`) —
// a define has no name to discharge and a definition clause's is mangled. (Mapping a source
// symbol onto a define also trips the accelerant steps of the transferred group proofs.)
func prodOp(p: Pair, q: Pair) => Pair
func prodInv(p: Pair) => Pair
const prodE: Pair
axiom prodOpDef: forall p, q: Pair; prodOp(p, q) = pair(opG(fst(p), fst(q)), opH(snd(p), snd(q)))
axiom prodInvDef: forall p: Pair; prodInv(p) = pair(invG(fst(p)), invH(snd(p)))
axiom prodEDef: prodE = pair(EG, EH)

// The projections of a product are the products of the projections.
theorem fstOfProduct: forall p, q: Pair; fst(prodOp(p, q)) = opG(fst(p), fst(q))
proof
  @conclusion |
    forall p, q: Pair; fst(prodOp(p, q)) = opG(fst(p), fst(q))
    [using simplify_quantified prodOpDef fstPair]
qed

theorem sndOfProduct: forall p, q: Pair; snd(prodOp(p, q)) = opH(snd(p), snd(q))
proof
  @conclusion |
    forall p, q: Pair; snd(prodOp(p, q)) = opH(snd(p), snd(q))
    [using simplify_quantified prodOpDef sndPair]
qed

// -- the group laws, componentwise -----------------------------------------------------------
// Each is: project (fstPair/sndPair), apply the factor's law in each component, repack.
theorem prodAssoc: forall p, q, r: Pair; prodOp(prodOp(p, q), r) = prodOp(p, prodOp(q, r))
proof
  @conclusion |
    forall p, q, r: Pair; prodOp(prodOp(p, q), r) = prodOp(p, prodOp(q, r))
    [using simplify_quantified prodOpDef fstPair sndPair opGAssoc opHAssoc]
qed

theorem prodIdentityLeft: forall p: Pair; prodOp(prodE, p) = p
proof
  @conclusion |
    forall p: Pair; prodOp(prodE, p) = p
    [using simplify_quantified prodOpDef prodEDef fstPair sndPair opGIdentityLeft opHIdentityLeft pairExtensionality]
qed

theorem prodInverseLeft: forall p: Pair; prodOp(prodInv(p), p) = prodE
proof
  @conclusion |
    forall p: Pair; prodOp(prodInv(p), p) = prodE
    [using simplify_quantified prodOpDef prodInvDef prodEDef fstPair sndPair opGInverseLeft opHInverseLeft]
qed

// G × H is a GROUP.
model ProductGroup {
  group.Grp: Pair
  group.E: prodE
  group.op: prodOp
  group.inverse: prodInv
  group.opAssoc <- prodAssoc
  group.opIdentityLeft <- prodIdentityLeft
  group.opInverseLeft <- prodInverseLeft
}

// PAYOFF: the group corpus on the product.
theorem prodIdentityRight: forall p: Pair; prodOp(p, prodE) = p
proof
  @conclusion |
    forall p: Pair; prodOp(p, prodE) = p
    [using model(ProductGroup) group.opIdentityRight]
qed

theorem prodInverseRight: forall p: Pair; prodOp(p, prodInv(p)) = prodE
proof
  @conclusion |
    forall p: Pair; prodOp(p, prodInv(p)) = prodE
    [using model(ProductGroup) group.opInverseRight]
qed

theorem prodCancelLeft: forall a, b, c: Pair; prodOp(a, b) = prodOp(a, c) -> b = c
proof
  @conclusion |
    forall a, b, c: Pair; prodOp(a, b) = prodOp(a, c) -> b = c
    [using model(ProductGroup) group.cancelLeft]
qed

// -- an exponent law that sees the components ------------------------------------------------
// A pair whose components are each killed by cubing is killed by cubing: (p·p)·p = (e, e).
// (For ℤ₃ × ℤ₃ this is the fact that separates it from ℤ₉ — AATA §3.2 Ex 34.)
theorem cubeIsIdentityComponentwise: forall p: Pair; opG(opG(fst(p), fst(p)), fst(p)) = EG -> opH(opH(snd(p), snd(p)), snd(p)) = EH -> prodOp(prodOp(p, p), p) = prodE
proof
  @generalize-p |
    fix p: Pair {
      @given-first-cubes-to-identity |
        assume opG(opG(fst(p), fst(p)), fst(p)) = EG {
          @given-second-cubes-to-identity |
            assume opH(opH(snd(p), snd(p)), snd(p)) = EH {
              @first-cubes-to-identity |
                opG(opG(fst(p), fst(p)), fst(p)) = EG
                [by hypothesis given-first-cubes-to-identity]
              @second-cubes-to-identity |
                opH(opH(snd(p), snd(p)), snd(p)) = EH
                [by hypothesis given-second-cubes-to-identity]
              @conclusion-cube-is-identity |
                prodOp(prodOp(p, p), p) = prodE
                [using simplify prodOpDef prodEDef fstPair sndPair first-cubes-to-identity second-cubes-to-identity]
            }
          @second-implies |
            opH(opH(snd(p), snd(p)), snd(p)) = EH -> prodOp(prodOp(p, p), p) = prodE
            [by discharge given-second-cubes-to-identity]
        }
      @first-implies |
        opG(opG(fst(p), fst(p)), fst(p)) = EG -> opH(opH(snd(p), snd(p)), snd(p)) = EH -> prodOp(prodOp(p, p), p) = prodE
        [by discharge given-first-cubes-to-identity]
    }
  @conclusion |
    forall p: Pair; opG(opG(fst(p), fst(p)), fst(p)) = EG -> opH(opH(snd(p), snd(p)), snd(p)) = EH -> prodOp(prodOp(p, p), p) = prodE
    [by generalize generalize-p]
qed

// -- §9.2: a PAIR is the identity exactly when BOTH components are -------------------------
//
// AATA Theorem 9.21 — "the order of (g₁, …, gₙ) is the lcm of the component orders" — rests
// on this: (g, h)^k = (e, e) iff g^k = e AND h^k = e, so the exponents that kill the pair are
// exactly the common multiples, and the least of them is the lcm. This states the `iff` for a
// pair's value; the exponent version needs `power` over the product sort, which the concrete
// consumer supplies (`cubeIsIdentityComponentwise` above is the k = 3 instance).
theorem pairIsIdentityIffComponentsAre: forall p: Pair;
  p = prodE iff (fst(p) = EG and snd(p) = EH)
proof
  @generalize-p |
    fix p: Pair {
      @identity-is-the-pair-of-identities |
        prodE = pair(EG, EH)
        [by cite prodEDef]
      @p-is-its-projections |
        pair(fst(p), snd(p)) = p
        [using specialize pairExtensionality(p)]
      // forward: p = prodE makes each projection the corresponding identity
      @given-p-is-the-identity |
        assume p = prodE {
          @p-is-the-identity |
            p = prodE
            [by hypothesis given-p-is-the-identity]
          @p-is-the-identity-pair |
            p = pair(EG, EH)
            [using chain p-is-the-identity identity-is-the-pair-of-identities]
          @first-projection-of-the-identity-pair |
            fst(pair(EG, EH)) = EG
            [using specialize fstPair(EG, EH)]
          @second-projection-of-the-identity-pair |
            snd(pair(EG, EH)) = EH
            [using specialize sndPair(EG, EH)]
          @first-projection-is-eg |
            fst(p) = EG
            [by rewrite p-is-the-identity-pair first-projection-of-the-identity-pair]
          @second-projection-is-eh |
            snd(p) = EH
            [by rewrite p-is-the-identity-pair second-projection-of-the-identity-pair]
          @conclusion-both-components |
            fst(p) = EG and snd(p) = EH
            [by both first-projection-is-eg second-projection-is-eh]
        }
      @forward |
        p = prodE -> (fst(p) = EG and snd(p) = EH)
        [by discharge given-p-is-the-identity]
      // backward: both projections at the identities rebuild prodE by extensionality
      @given-both-components |
        assume fst(p) = EG and snd(p) = EH {
          @both-components |
            fst(p) = EG and snd(p) = EH
            [by hypothesis given-both-components]
          @first-is-eg |
            fst(p) = EG
            [by and_lhs both-components]
          @second-is-eh |
            snd(p) = EH
            [by and_rhs both-components]
          @rebuilt-with-eg |
            pair(EG, snd(p)) = p
            [by rewrite first-is-eg p-is-its-projections]
          @rebuilt-with-both |
            pair(EG, EH) = p
            [by rewrite second-is-eh rebuilt-with-eg]
          @identity-rebuilt |
            prodE = p
            [using chain identity-is-the-pair-of-identities rebuilt-with-both]
          @conclusion-p-is-the-identity |
            p = prodE
            [by symmetry identity-rebuilt]
        }
      @backward |
        (fst(p) = EG and snd(p) = EH) -> p = prodE
        [by discharge given-both-components]
      @conclusion-iff |
        p = prodE iff (fst(p) = EG and snd(p) = EH)
        [by make_equivalence forward backward]
    }
  @conclusion |
    forall p: Pair; p = prodE iff (fst(p) = EG and snd(p) = EH)
    [by generalize generalize-p]
qed

// -- INTEGER POWERS ON A DIRECT PRODUCT -------------------------------------------
//
// Judson's Theorem 9.17 (the order of (g,h) is lcm(|g|,|h|)) needs (g,h)^k to be
// (g^k, h^k). `power` is a FUNC in std/group/power.b4m, so a model cannot transfer it
// onto Pair -- a function symbol has to be declared and axiomatized, which is what
// every concrete group in std does (permutation/power.b4m's permPower, mod-n.b4m's
// znPower). So: a power on the product and one on each factor, with the componentwise
// law proved by bidirectional induction on the exponent.

sort Int = integer.Int
const IZERO = integer.ZERO
func isucc = integer.succ
func iprev = integer.prev
fact iinduction = integer.induction

// the three powers: one on the product, one on each factor
func pairPower(p: Pair, k: Int) => Pair
axiom pairPowerZero: forall p: Pair; pairPower(p, IZERO) = prodE
axiom pairPowerSucc: forall p: Pair; forall k: Int;
  pairPower(p, isucc(k)) = prodOp(pairPower(p, k), p)
axiom pairPowerPrev: forall p: Pair; forall k: Int;
  pairPower(p, iprev(k)) = prodOp(pairPower(p, k), prodInv(p))

func powerH(h: H, k: Int) => H
axiom powerHZero: forall h: H; powerH(h, IZERO) = EH
axiom powerHSucc: forall h: H; forall k: Int; powerH(h, isucc(k)) = opH(powerH(h, k), h)
axiom powerHPrev: forall h: H; forall k: Int; powerH(h, iprev(k)) = opH(powerH(h, k), invH(h))

func powerG(g: G, k: Int) => G
axiom powerGZero: forall g: G; powerG(g, IZERO) = EG
axiom powerGSucc: forall g: G; forall k: Int; powerG(g, isucc(k)) = opG(powerG(g, k), g)
axiom powerGPrev: forall g: G; forall k: Int; powerG(g, iprev(k)) = opG(powerG(g, k), invG(g))

// fst((p)^k) = (fst p)^k, by bidirectional induction on k.
theorem fstOfPairPower: forall p: Pair; forall k: Int;
  fst(pairPower(p, k)) = powerG(fst(p), k)
proof
  @generalize-p |
    fix p: Pair {
      // base: fst(p^0) = fst(prodE) = EG = (fst p)^0
      @power-zero |
        pairPower(p, IZERO) = prodE
        [using specialize pairPowerZero(p)]
      @prod-identity |
        prodE = pair(EG, EH)
        [by cite prodEDef]
      @fst-of-the-identity |
        fst(pair(EG, EH)) = EG
        [using specialize fstPair(EG, EH)]
      @component-power-zero |
        powerG(fst(p), IZERO) = EG
        [using specialize powerGZero(fst(p))]
      @base-case |
        fst(pairPower(p, IZERO)) = powerG(fst(p), IZERO)
        [using chain power-zero prod-identity fst-of-the-identity component-power-zero]

      // successor
      @successor-step |
        fix k: Int {
          @given-ih |
            assume fst(pairPower(p, k)) = powerG(fst(p), k) {
              @ih |
                fst(pairPower(p, k)) = powerG(fst(p), k)
                [by hypothesis given-ih]
              @lhs-unfolds |
                pairPower(p, isucc(k)) = prodOp(pairPower(p, k), p)
                [using specialize pairPowerSucc(p, k)]
              @fst-splits |
                fst(prodOp(pairPower(p, k), p)) = opG(fst(pairPower(p, k)), fst(p))
                [using specialize fstOfProduct(pairPower(p, k), p)]
              @rhs-unfolds |
                powerG(fst(p), isucc(k)) = opG(powerG(fst(p), k), fst(p))
                [using specialize powerGSucc(fst(p), k)]
              @conclusion-at-succ |
                fst(pairPower(p, isucc(k))) = powerG(fst(p), isucc(k))
                [using chain lhs-unfolds fst-splits ih rhs-unfolds]
            }
          @ih-implies-succ |
            fst(pairPower(p, k)) = powerG(fst(p), k)
              -> fst(pairPower(p, isucc(k))) = powerG(fst(p), isucc(k))
            [by discharge given-ih]
        }
      @successor-step-all-k |
        forall k: Int; fst(pairPower(p, k)) = powerG(fst(p), k)
          -> fst(pairPower(p, isucc(k))) = powerG(fst(p), isucc(k))
        [by generalize successor-step]

      // predecessor
      @predecessor-step |
        fix k: Int {
          @given-ih-prev |
            assume fst(pairPower(p, k)) = powerG(fst(p), k) {
              @ih-prev |
                fst(pairPower(p, k)) = powerG(fst(p), k)
                [by hypothesis given-ih-prev]
              @lhs-unfolds-prev |
                pairPower(p, iprev(k)) = prodOp(pairPower(p, k), prodInv(p))
                [using specialize pairPowerPrev(p, k)]
              @fst-splits-prev |
                fst(prodOp(pairPower(p, k), prodInv(p)))
                  = opG(fst(pairPower(p, k)), fst(prodInv(p)))
                [using specialize fstOfProduct(pairPower(p, k), prodInv(p))]
              // fst(p⁻¹) = fst(pair(invG(fst p), invH(snd p))) = invG(fst p)
              @the-inverse-pair |
                prodInv(p) = pair(invG(fst(p)), invH(snd(p)))
                [using specialize prodInvDef(p)]
              @fst-of-that-pair |
                fst(pair(invG(fst(p)), invH(snd(p)))) = invG(fst(p))
                [using specialize fstPair(invG(fst(p)), invH(snd(p)))]
              @fst-of-inverse |
                fst(prodInv(p)) = invG(fst(p))
                [using chain the-inverse-pair fst-of-that-pair]
              @rhs-unfolds-prev |
                powerG(fst(p), iprev(k)) = opG(powerG(fst(p), k), invG(fst(p)))
                [using specialize powerGPrev(fst(p), k)]
              @conclusion-at-prev |
                fst(pairPower(p, iprev(k))) = powerG(fst(p), iprev(k))
                [using chain lhs-unfolds-prev fst-splits-prev fst-of-inverse ih-prev
                  rhs-unfolds-prev]
            }
          @ih-implies-prev |
            fst(pairPower(p, k)) = powerG(fst(p), k)
              -> fst(pairPower(p, iprev(k))) = powerG(fst(p), iprev(k))
            [by discharge given-ih-prev]
        }
      @predecessor-step-all-k |
        forall k: Int; fst(pairPower(p, k)) = powerG(fst(p), k)
          -> fst(pairPower(p, iprev(k))) = powerG(fst(p), iprev(k))
        [by generalize predecessor-step]

      @all-k |
        forall k: Int; fst(pairPower(p, k)) = powerG(fst(p), k)
        [using instantiation iinduction(
          (fun k: Int => fst(pairPower(p, k)) = powerG(fst(p), k)))
          base-case successor-step-all-k predecessor-step-all-k]
    }
  @conclusion |
    forall p: Pair; forall k: Int; fst(pairPower(p, k)) = powerG(fst(p), k)
    [by generalize generalize-p]
qed

// snd((p)^k) = (snd p)^k, by bidirectional induction on k.
theorem sndOfPairPower: forall p: Pair; forall k: Int;
  snd(pairPower(p, k)) = powerH(snd(p), k)
proof
  @generalize-p |
    fix p: Pair {
      // base: snd(p^0) = snd(prodE) = EH = (snd p)^0
      @power-zero |
        pairPower(p, IZERO) = prodE
        [using specialize pairPowerZero(p)]
      @prod-identity |
        prodE = pair(EG, EH)
        [by cite prodEDef]
      @snd-of-the-identity |
        snd(pair(EG, EH)) = EH
        [using specialize sndPair(EG, EH)]
      @component-power-zero |
        powerH(snd(p), IZERO) = EH
        [using specialize powerHZero(snd(p))]
      @base-case |
        snd(pairPower(p, IZERO)) = powerH(snd(p), IZERO)
        [using chain power-zero prod-identity snd-of-the-identity component-power-zero]

      // successor
      @successor-step |
        fix k: Int {
          @given-ih |
            assume snd(pairPower(p, k)) = powerH(snd(p), k) {
              @ih |
                snd(pairPower(p, k)) = powerH(snd(p), k)
                [by hypothesis given-ih]
              @lhs-unfolds |
                pairPower(p, isucc(k)) = prodOp(pairPower(p, k), p)
                [using specialize pairPowerSucc(p, k)]
              @snd-splits |
                snd(prodOp(pairPower(p, k), p)) = opH(snd(pairPower(p, k)), snd(p))
                [using specialize sndOfProduct(pairPower(p, k), p)]
              @rhs-unfolds |
                powerH(snd(p), isucc(k)) = opH(powerH(snd(p), k), snd(p))
                [using specialize powerHSucc(snd(p), k)]
              @conclusion-at-succ |
                snd(pairPower(p, isucc(k))) = powerH(snd(p), isucc(k))
                [using chain lhs-unfolds snd-splits ih rhs-unfolds]
            }
          @ih-implies-succ |
            snd(pairPower(p, k)) = powerH(snd(p), k)
              -> snd(pairPower(p, isucc(k))) = powerH(snd(p), isucc(k))
            [by discharge given-ih]
        }
      @successor-step-all-k |
        forall k: Int; snd(pairPower(p, k)) = powerH(snd(p), k)
          -> snd(pairPower(p, isucc(k))) = powerH(snd(p), isucc(k))
        [by generalize successor-step]

      // predecessor
      @predecessor-step |
        fix k: Int {
          @given-ih-prev |
            assume snd(pairPower(p, k)) = powerH(snd(p), k) {
              @ih-prev |
                snd(pairPower(p, k)) = powerH(snd(p), k)
                [by hypothesis given-ih-prev]
              @lhs-unfolds-prev |
                pairPower(p, iprev(k)) = prodOp(pairPower(p, k), prodInv(p))
                [using specialize pairPowerPrev(p, k)]
              @snd-splits-prev |
                snd(prodOp(pairPower(p, k), prodInv(p)))
                  = opH(snd(pairPower(p, k)), snd(prodInv(p)))
                [using specialize sndOfProduct(pairPower(p, k), prodInv(p))]
              // snd(p⁻¹) = snd(pair(invH(snd p), invH(snd p))) = invH(snd p)
              @the-inverse-pair |
                prodInv(p) = pair(invG(fst(p)), invH(snd(p)))
                [using specialize prodInvDef(p)]
              @snd-of-that-pair |
                snd(pair(invG(fst(p)), invH(snd(p)))) = invH(snd(p))
                [using specialize sndPair(invG(fst(p)), invH(snd(p)))]
              @snd-of-inverse |
                snd(prodInv(p)) = invH(snd(p))
                [using chain the-inverse-pair snd-of-that-pair]
              @rhs-unfolds-prev |
                powerH(snd(p), iprev(k)) = opH(powerH(snd(p), k), invH(snd(p)))
                [using specialize powerHPrev(snd(p), k)]
              @conclusion-at-prev |
                snd(pairPower(p, iprev(k))) = powerH(snd(p), iprev(k))
                [using chain lhs-unfolds-prev snd-splits-prev snd-of-inverse ih-prev
                  rhs-unfolds-prev]
            }
          @ih-implies-prev |
            snd(pairPower(p, k)) = powerH(snd(p), k)
              -> snd(pairPower(p, iprev(k))) = powerH(snd(p), iprev(k))
            [by discharge given-ih-prev]
        }
      @predecessor-step-all-k |
        forall k: Int; snd(pairPower(p, k)) = powerH(snd(p), k)
          -> snd(pairPower(p, iprev(k))) = powerH(snd(p), iprev(k))
        [by generalize predecessor-step]

      @all-k |
        forall k: Int; snd(pairPower(p, k)) = powerH(snd(p), k)
        [using instantiation iinduction(
          (fun k: Int => snd(pairPower(p, k)) = powerH(snd(p), k)))
          base-case successor-step-all-k predecessor-step-all-k]
    }
  @conclusion |
    forall p: Pair; forall k: Int; snd(pairPower(p, k)) = powerH(snd(p), k)
    [by generalize generalize-p]
qed

// JUDSON'S KEY STEP: (g,h)^k = (e,e) exactly when g^k = e and h^k = e. This is what
// turns his two equations into divisibility facts about the component orders.
theorem pairPowerIsIdentityIffComponentPowersAre: forall p: Pair; forall k: Int;
  pairPower(p, k) = prodE iff (powerG(fst(p), k) = EG and powerH(snd(p), k) = EH)
proof
  @generalize-p |
    fix p: Pair {
      @generalize-k |
        fix k: Int {
          @the-pair-criterion |
            pairPower(p, k) = prodE
              iff (fst(pairPower(p, k)) = EG and snd(pairPower(p, k)) = EH)
            [using specialize pairIsIdentityIffComponentsAre(pairPower(p, k))]
          @fst-is-the-component-power |
            fst(pairPower(p, k)) = powerG(fst(p), k)
            [using specialize fstOfPairPower(p, k)]
          @snd-is-the-component-power |
            snd(pairPower(p, k)) = powerH(snd(p), k)
            [using specialize sndOfPairPower(p, k)]
          @rewrite-the-first |
            pairPower(p, k) = prodE
              iff (powerG(fst(p), k) = EG and snd(pairPower(p, k)) = EH)
            [by rewrite fst-is-the-component-power the-pair-criterion]
          @conclusion-at-p-k |
            pairPower(p, k) = prodE
              iff (powerG(fst(p), k) = EG and powerH(snd(p), k) = EH)
            [by rewrite snd-is-the-component-power rewrite-the-first]
        }
      @discharge-k |
        forall k: Int; pairPower(p, k) = prodE
          iff (powerG(fst(p), k) = EG and powerH(snd(p), k) = EH)
        [by generalize generalize-k]
    }
  @conclusion |
    forall p: Pair; forall k: Int; pairPower(p, k) = prodE
      iff (powerG(fst(p), k) = EG and powerH(snd(p), k) = EH)
    [by generalize generalize-p]
qed
