// std/group/generated.b4m — the cyclic subgroup ⟨g⟩ generated by a VARIABLE element.
//
// std/cyclic.b4m fixes its generator as a constant A (Judson's ⟨a⟩ for one a). Several
// exercises quantify over the generator — "for every g, ⟨g⟩ is a subgroup", "⟨a⟩ ∩ ⟨b⟩ is
// trivial when the orders are coprime", "a group with no proper nontrivial subgroups is
// cyclic" — so here membership in ⟨g⟩ is the two-place relation inGenerated(g, x): x is an
// integer power of g. The closure facts of std/cyclic.b4m are re-proved for a variable g,
// then used for Judson's §4.1 exercises 27, 30 and 37.

import group <<< "std/group.b4m"
import group_power <<< "std/group/power.b4m"
import group_order <<< "std/group/order.b4m"
import integer <<< "std/integer.b4m"
import int_divides <<< "std/integer/divides.b4m"

sort Grp = group_power.Grp
const E = group_power.E
func op = group_power.op
func inverse = group_power.inverse
func power = group_power.power

sort Int = group_power.Int
const ZERO = group_power.ZERO
const ONE = integer.ONE
func succ = group_power.succ
func add = group_power.add
func mul = group_power.mul
func neg = group_power.neg
func gcd = int_divides.gcd
pred less_than = int_divides.less_than
define divides(d, n) = int_divides.divides(d, n)
define hasOrder(g, n) = group_order.hasOrder(g, n)

// x ∈ ⟨g⟩ iff x is an integer power of g.
define inGenerated(g, x) = exists k: Int; x = power(g, k)

// -- ⟨g⟩ is a subgroup containing g, for every g -----------------------------------------

// g ∈ ⟨g⟩, witnessed by g¹ = g.
theorem generatorIsGenerated: forall g: Grp; inGenerated(g, g)
proof
  @generalize-g |
    fix g: Grp {
      @first-power |
        power(g, succ(ZERO)) = g
        [using specialize group_power.powerOne(g)]
      @g-is-first-power |
        g = power(g, succ(ZERO))
        [by symmetry first-power]
      @conclusion-g-generated |
        inGenerated(g, g)
        [by exists_intro(succ(ZERO)) g-is-first-power]
    }
  @conclusion |
    forall g: Grp; inGenerated(g, g)
    [by forall_intro generalize-g]
qed

// e ∈ ⟨g⟩, witnessed by g⁰ = e.
theorem generatedHasIdentity: forall g: Grp; inGenerated(g, E)
proof
  @generalize-g |
    fix g: Grp {
      @zeroth-power |
        power(g, ZERO) = E
        [using specialize group_power.powerZero(g)]
      @identity-is-zeroth-power |
        E = power(g, ZERO)
        [by symmetry zeroth-power]
      @conclusion-identity-generated |
        inGenerated(g, E)
        [by exists_intro(ZERO) identity-is-zeroth-power]
    }
  @conclusion |
    forall g: Grp; inGenerated(g, E)
    [by forall_intro generalize-g]
qed

// ⟨g⟩ is closed under the operation: g^m · g^n = g^(m+n).
theorem generatedClosedOp: forall g: Grp; forall x, y: Grp; inGenerated(g, x) -> inGenerated(g, y) -> inGenerated(g, op(x, y))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-x |
        fix x: Grp {
          @generalize-y |
            fix y: Grp {
              @given-x-in |
                assume inGenerated(g, x) {
                  @given-y-in |
                    assume inGenerated(g, y) {
                      @x-is-power |
                        exists k: Int; x = power(g, k)
                        [by hypothesis given-x-in]
                      @y-is-power |
                        exists k: Int; y = power(g, k)
                        [by hypothesis given-y-in]
                      @with-x-exponent-m |
                        unpack m: Int from x-is-power {
                          @x-power-m |
                            x = power(g, m)
                            [by hypothesis with-x-exponent-m]
                          @with-y-exponent-n |
                            unpack n: Int from y-is-power {
                              @y-power-n |
                                y = power(g, n)
                                [by hypothesis with-y-exponent-n]
                              @powers-add |
                                op(power(g, m), power(g, n)) = power(g, add(m, n))
                                [using specialize group_power.powerAdd(g, m, n)]
                              @product-reflexive |
                                op(x, y) = op(x, y)
                                [by reflexivity]
                              @product-with-m |
                                op(x, y) = op(power(g, m), y)
                                [by rewrite x-power-m product-reflexive]
                              @product-as-powers |
                                op(x, y) = op(power(g, m), power(g, n))
                                [by rewrite y-power-n product-with-m]
                              @product-is-power |
                                op(x, y) = power(g, add(m, n))
                                [using chain product-as-powers powers-add]
                              @conclusion-product-generated |
                                inGenerated(g, op(x, y))
                                [by exists_intro(add(m, n)) product-is-power]
                            }
                          @conclusion-with-x-exponent |
                            inGenerated(g, op(x, y))
                            [by exists_elim with-y-exponent-n]
                        }
                      @conclusion-product-in |
                        inGenerated(g, op(x, y))
                        [by exists_elim with-x-exponent-m]
                    }
                  @y-in-implies |
                    inGenerated(g, y) -> inGenerated(g, op(x, y))
                    [by implies_intro given-y-in]
                }
              @x-in-implies |
                inGenerated(g, x) -> inGenerated(g, y) -> inGenerated(g, op(x, y))
                [by implies_intro given-x-in]
            }
          @discharge-y |
            forall y: Grp; inGenerated(g, x) -> inGenerated(g, y) -> inGenerated(g, op(x, y))
            [by forall_intro generalize-y]
        }
      @discharge-x |
        forall x, y: Grp; inGenerated(g, x) -> inGenerated(g, y) -> inGenerated(g, op(x, y))
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall g: Grp; forall x, y: Grp; inGenerated(g, x) -> inGenerated(g, y) -> inGenerated(g, op(x, y))
    [by forall_intro generalize-g]
qed

// ⟨g⟩ is closed under inverses: (g^k)⁻¹ = g^(−k).
theorem generatedClosedInverse: forall g: Grp; forall x: Grp; inGenerated(g, x) -> inGenerated(g, inverse(x))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-x |
        fix x: Grp {
          @given-x-in |
            assume inGenerated(g, x) {
              @x-is-power |
                exists k: Int; x = power(g, k)
                [by hypothesis given-x-in]
              @with-exponent-k |
                unpack k: Int from x-is-power {
                  @x-power-k |
                    x = power(g, k)
                    [by hypothesis with-exponent-k]
                  @negated-power-is-inverse |
                    power(g, neg(k)) = inverse(power(g, k))
                    [using specialize group_power.powerNegInverse(g, k)]
                  @inverse-reflexive |
                    inverse(x) = inverse(x)
                    [by reflexivity]
                  @inverse-of-power |
                    inverse(x) = inverse(power(g, k))
                    [by rewrite x-power-k inverse-reflexive]
                  @inverse-as-power |
                    inverse(x) = power(g, neg(k))
                    [by rewrite negated-power-is-inverse inverse-of-power]
                  @conclusion-inverse-generated |
                    inGenerated(g, inverse(x))
                    [by exists_intro(neg(k)) inverse-as-power]
                }
              @conclusion-with-exponent |
                inGenerated(g, inverse(x))
                [by exists_elim with-exponent-k]
            }
          @x-in-implies |
            inGenerated(g, x) -> inGenerated(g, inverse(x))
            [by implies_intro given-x-in]
        }
      @discharge-x |
        forall x: Grp; inGenerated(g, x) -> inGenerated(g, inverse(x))
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall g: Grp; forall x: Grp; inGenerated(g, x) -> inGenerated(g, inverse(x))
    [by forall_intro generalize-g]
qed

// -- an exponent killing the generator kills every member -------------------------------
// x = g^i ⟹ x^n = g^(in) = (g^n)^i = e.
theorem killerOfGeneratorKillsMember: forall g: Grp; forall n: Int; power(g, n) = E -> forall x: Grp; inGenerated(g, x) -> power(x, n) = E
proof
  @generalize-g |
    fix g: Grp {
      @generalize-n |
        fix n: Int {
          @given-g-killed |
            assume power(g, n) = E {
              @g-killed |
                power(g, n) = E
                [by hypothesis given-g-killed]
              @generalize-x |
                fix x: Grp {
                  @given-x-in |
                    assume inGenerated(g, x) {
                      @x-is-power |
                        exists k: Int; x = power(g, k)
                        [by hypothesis given-x-in]
                      @with-exponent-i |
                        unpack i: Int from x-is-power {
                          @x-power-i |
                            x = power(g, i)
                            [by hypothesis with-exponent-i]
                          @power-of-power |
                            power(power(g, i), n) = power(g, mul(i, n))
                            [using specialize group_power.powerMul(g, i, n)]
                          @x-power-n |
                            power(x, n) = power(g, mul(i, n))
                            [by rewrite x-power-i power-of-power]
                          @exponents-commute |
                            mul(i, n) = mul(n, i)
                            [using specialize int_divides.mulIsCommutative(i, n)]
                          @x-power-n-swapped |
                            power(x, n) = power(g, mul(n, i))
                            [by rewrite exponents-commute x-power-n]
                          @power-of-killed |
                            power(power(g, n), i) = power(g, mul(n, i))
                            [using specialize group_power.powerMul(g, n, i)]
                          @identity-power |
                            power(E, i) = power(g, mul(n, i))
                            [by rewrite g-killed power-of-killed]
                          @killed-power-is-identity-power |
                            power(g, mul(n, i)) = power(E, i)
                            [by symmetry identity-power]
                          @identity-power-is-identity |
                            power(E, i) = E
                            [using specialize group_power.powerOfIdentity(i)]
                          @conclusion-x-killed |
                            power(x, n) = E
                            [using chain x-power-n-swapped killed-power-is-identity-power identity-power-is-identity]
                        }
                      @conclusion-with-exponent |
                        power(x, n) = E
                        [by exists_elim with-exponent-i]
                    }
                  @x-in-implies |
                    inGenerated(g, x) -> power(x, n) = E
                    [by implies_intro given-x-in]
                }
              @discharge-x |
                forall x: Grp; inGenerated(g, x) -> power(x, n) = E
                [by forall_intro generalize-x]
            }
          @g-killed-implies |
            power(g, n) = E -> forall x: Grp; inGenerated(g, x) -> power(x, n) = E
            [by implies_intro given-g-killed]
        }
      @discharge-n |
        forall n: Int; power(g, n) = E -> forall x: Grp; inGenerated(g, x) -> power(x, n) = E
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall g: Grp; forall n: Int; power(g, n) = E -> forall x: Grp; inGenerated(g, x) -> power(x, n) = E
    [by forall_intro generalize-g]
qed

// -- EXERCISE 27 (the shape behind |g| = 15, |h| = 16): consecutive killing exponents ----
// If m kills g and m+1 kills h, then any x in both ⟨g⟩ and ⟨h⟩ has x = x^(m+1) = x^m · x =
// e · x — so x = e.
theorem consecutiveKillersGiveTrivialIntersection: forall g, h: Grp; forall m: Int; power(g, m) = E -> power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
proof
  @generalize-g |
    fix g: Grp {
      @generalize-h |
        fix h: Grp {
          @generalize-m |
            fix m: Int {
              @given-g-killed |
                assume power(g, m) = E {
                  @given-h-killed |
                    assume power(h, succ(m)) = E {
                      @g-killed |
                        power(g, m) = E
                        [by hypothesis given-g-killed]
                      @h-killed |
                        power(h, succ(m)) = E
                        [by hypothesis given-h-killed]
                      @generalize-x |
                        fix x: Grp {
                          @given-x-in-g |
                            assume inGenerated(g, x) {
                              @given-x-in-h |
                                assume inGenerated(h, x) {
                                  @x-in-g |
                                    inGenerated(g, x)
                                    [by hypothesis given-x-in-g]
                                  @x-in-h |
                                    inGenerated(h, x)
                                    [by hypothesis given-x-in-h]
                                  @m-kills-x |
                                    power(x, m) = E
                                    [using specialize killerOfGeneratorKillsMember(g, m, x) g-killed x-in-g]
                                  @next-kills-x |
                                    power(x, succ(m)) = E
                                    [using specialize killerOfGeneratorKillsMember(h, succ(m), x) h-killed x-in-h]
                                  @next-unfolds |
                                    power(x, succ(m)) = op(power(x, m), x)
                                    [using specialize group_power.powerSucc(x, m)]
                                  @next-is-identity-times-x |
                                    power(x, succ(m)) = op(E, x)
                                    [by rewrite m-kills-x next-unfolds]
                                  @identity-times-x |
                                    op(E, x) = x
                                    [using specialize group_power.opIdentityLeft(x)]
                                  @next-is-x |
                                    power(x, succ(m)) = x
                                    [using chain next-is-identity-times-x identity-times-x]
                                  @x-is-next |
                                    x = power(x, succ(m))
                                    [by symmetry next-is-x]
                                  @conclusion-x-is-identity |
                                    x = E
                                    [using chain x-is-next next-kills-x]
                                }
                              @x-in-h-implies |
                                inGenerated(h, x) -> x = E
                                [by implies_intro given-x-in-h]
                            }
                          @x-in-g-implies |
                            inGenerated(g, x) -> inGenerated(h, x) -> x = E
                            [by implies_intro given-x-in-g]
                        }
                      @discharge-x |
                        forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                        [by forall_intro generalize-x]
                    }
                  @h-killed-implies |
                    power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                    [by implies_intro given-h-killed]
                }
              @g-killed-implies |
                power(g, m) = E -> power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                [by implies_intro given-g-killed]
            }
          @discharge-m |
            forall m: Int; power(g, m) = E -> power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
            [by forall_intro generalize-m]
        }
      @discharge-h |
        forall h: Grp; forall m: Int; power(g, m) = E -> power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Grp; forall m: Int; power(g, m) = E -> power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
    [by forall_intro generalize-g]
qed

// -- EXERCISE 30: coprime orders give a trivial intersection ---------------------------------
// gcd(|g|, |h|) = 1 ⟹ ⟨g⟩ ∩ ⟨h⟩ = {e}. An x in both is killed by |g| and by |h|, hence by
// every combination r|g| + s|h| — in particular by 1 (Bézout, since the only common
// divisors of |g| and |h| are ±1): x = x¹ = e.
theorem coprimeOrdersGiveTrivialIntersection: forall g, h: Grp; forall m, n: Int; hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
proof
  @generalize-g |
    fix g: Grp {
      @generalize-h |
        fix h: Grp {
          @generalize-m |
            fix m: Int {
              @generalize-n |
                fix n: Int {
                  @given-g-order |
                    assume hasOrder(g, m) {
                      @given-h-order |
                        assume hasOrder(h, n) {
                          @given-coprime |
                            assume gcd(m, n) = ONE {
                              @g-order-facts |
                                less_than(ZERO, m) and power(g, m) = E and (forall j: Int; less_than(ZERO, j) -> less_than(j, m) -> power(g, j) != E)
                                [by hypothesis given-g-order]
                              @h-order-facts |
                                less_than(ZERO, n) and power(h, n) = E and (forall j: Int; less_than(ZERO, j) -> less_than(j, n) -> power(h, j) != E)
                                [by hypothesis given-h-order]
                              @gcd-is-one |
                                gcd(m, n) = ONE
                                [by hypothesis given-coprime]
                              @m-positive |
                                less_than(ZERO, m)
                                [using tautology g-order-facts]
                              @g-killed |
                                power(g, m) = E
                                [using tautology g-order-facts]
                              @n-positive |
                                less_than(ZERO, n)
                                [using tautology h-order-facts]
                              @h-killed |
                                power(h, n) = E
                                [using tautology h-order-facts]
                              // the orders are nonzero (they are positive).
                              @zero-not-below-itself |
                                not less_than(ZERO, ZERO)
                                [using specialize int_divides.lessThanIrreflexive(ZERO)]
                              @given-m-zero |
                                assume m = ZERO {
                                  @m-zero |
                                    m = ZERO
                                    [by hypothesis given-m-zero]
                                  @zero-below-itself-m |
                                    less_than(ZERO, ZERO)
                                    [by rewrite m-zero m-positive]
                                }
                              @m-zero-implies |
                                m = ZERO -> less_than(ZERO, ZERO)
                                [by implies_intro given-m-zero]
                              @m-nonzero |
                                m != ZERO
                                [using tautology m-zero-implies zero-not-below-itself]
                              @given-n-zero |
                                assume n = ZERO {
                                  @n-zero |
                                    n = ZERO
                                    [by hypothesis given-n-zero]
                                  @zero-below-itself-n |
                                    less_than(ZERO, ZERO)
                                    [by rewrite n-zero n-positive]
                                }
                              @n-zero-implies |
                                n = ZERO -> less_than(ZERO, ZERO)
                                [by implies_intro given-n-zero]
                              @n-nonzero |
                                n != ZERO
                                [using tautology n-zero-implies zero-not-below-itself]
                              // every common divisor divides gcd(m, n) = 1, so is ±1.
                              @generalize-divisor |
                                fix d: Int {
                                  @given-d-divides-m |
                                    assume divides(d, m) {
                                      @given-d-divides-n |
                                        assume divides(d, n) {
                                          @d-divides-m |
                                            divides(d, m)
                                            [by hypothesis given-d-divides-m]
                                          @d-divides-n |
                                            divides(d, n)
                                            [by hypothesis given-d-divides-n]
                                          @d-divides-gcd |
                                            divides(d, gcd(m, n))
                                            [using specialize int_divides.gcdGreatest(d, m, n) d-divides-m d-divides-n]
                                          @d-divides-one |
                                            divides(d, ONE)
                                            [by rewrite gcd-is-one d-divides-gcd]
                                          @d-is-a-unit |
                                            d = ONE or d = neg(ONE)
                                            [using specialize int_divides.dividesOneImpliesUnit(d) d-divides-one]
                                        }
                                      @d-divides-n-implies |
                                        divides(d, n) -> (d = ONE or d = neg(ONE))
                                        [by implies_intro given-d-divides-n]
                                    }
                                  @d-divides-m-implies |
                                    divides(d, m) -> divides(d, n) -> (d = ONE or d = neg(ONE))
                                    [by implies_intro given-d-divides-m]
                                }
                              @common-divisors-are-units |
                                forall d: Int; divides(d, m) -> divides(d, n) -> (d = ONE or d = neg(ONE))
                                [by forall_intro generalize-divisor]
                              @bezout-exists |
                                exists r: Int; exists s: Int; add(mul(m, r), mul(n, s)) = ONE
                                [using specialize int_divides.coprimeBezout(m, n) m-nonzero n-nonzero common-divisors-are-units]
                              @generalize-x |
                                fix x: Grp {
                                  @given-x-in-g |
                                    assume inGenerated(g, x) {
                                      @given-x-in-h |
                                        assume inGenerated(h, x) {
                                          @x-in-g |
                                            inGenerated(g, x)
                                            [by hypothesis given-x-in-g]
                                          @x-in-h |
                                            inGenerated(h, x)
                                            [by hypothesis given-x-in-h]
                                          @m-kills-x |
                                            power(x, m) = E
                                            [using specialize killerOfGeneratorKillsMember(g, m, x) g-killed x-in-g]
                                          @n-kills-x |
                                            power(x, n) = E
                                            [using specialize killerOfGeneratorKillsMember(h, n, x) h-killed x-in-h]
                                          @one-is-succ-zero |
                                            ONE = succ(ZERO)
                                            [using import(integer) oneIsSuccZero]
                                          @first-power |
                                            power(x, succ(ZERO)) = x
                                            [using specialize group_power.powerOne(x)]
                                          @first-power-at-one |
                                            power(x, ONE) = x
                                            [by rewrite one-is-succ-zero first-power]
                                          @x-is-first-power |
                                            x = power(x, ONE)
                                            [by symmetry first-power-at-one]
                                          @with-bezout-r |
                                            unpack r: Int from bezout-exists {
                                              @s-exists |
                                                exists s: Int; add(mul(m, r), mul(n, s)) = ONE
                                                [by hypothesis with-bezout-r]
                                              @with-bezout-s |
                                                unpack s: Int from s-exists {
                                                  @bezout-identity |
                                                    add(mul(m, r), mul(n, s)) = ONE
                                                    [by hypothesis with-bezout-s]
                                                  // x^(mr) = (x^m)^r = e, and x^(ns) = (x^n)^s = e.
                                                  @power-of-m-power |
                                                    power(power(x, m), r) = power(x, mul(m, r))
                                                    [using specialize group_power.powerMul(x, m, r)]
                                                  @mr-power-as-identity-power |
                                                    power(E, r) = power(x, mul(m, r))
                                                    [by rewrite m-kills-x power-of-m-power]
                                                  @identity-power-r |
                                                    power(E, r) = E
                                                    [using specialize group_power.powerOfIdentity(r)]
                                                  @mr-power-flipped |
                                                    power(x, mul(m, r)) = power(E, r)
                                                    [by symmetry mr-power-as-identity-power]
                                                  @mr-kills-x |
                                                    power(x, mul(m, r)) = E
                                                    [using chain mr-power-flipped identity-power-r]
                                                  @power-of-n-power |
                                                    power(power(x, n), s) = power(x, mul(n, s))
                                                    [using specialize group_power.powerMul(x, n, s)]
                                                  @ns-power-as-identity-power |
                                                    power(E, s) = power(x, mul(n, s))
                                                    [by rewrite n-kills-x power-of-n-power]
                                                  @identity-power-s |
                                                    power(E, s) = E
                                                    [using specialize group_power.powerOfIdentity(s)]
                                                  @ns-power-flipped |
                                                    power(x, mul(n, s)) = power(E, s)
                                                    [by symmetry ns-power-as-identity-power]
                                                  @ns-kills-x |
                                                    power(x, mul(n, s)) = E
                                                    [using chain ns-power-flipped identity-power-s]
                                                  // x = x¹ = x^(mr + ns) = x^(mr) · x^(ns) = e · e.
                                                  @powers-add |
                                                    op(power(x, mul(m, r)), power(x, mul(n, s))) = power(x, add(mul(m, r), mul(n, s)))
                                                    [using specialize group_power.powerAdd(x, mul(m, r), mul(n, s))]
                                                  @first-power-splits |
                                                    op(power(x, mul(m, r)), power(x, mul(n, s))) = power(x, ONE)
                                                    [by rewrite bezout-identity powers-add]
                                                  @identity-squared |
                                                    op(E, E) = E
                                                    [using specialize group_power.opIdentityLeft(E)]
                                                  @first-power-as-product |
                                                    power(x, ONE) = op(power(x, mul(m, r)), power(x, mul(n, s)))
                                                    [by symmetry first-power-splits]
                                                  @product-left-killed |
                                                    power(x, ONE) = op(E, power(x, mul(n, s)))
                                                    [by rewrite mr-kills-x first-power-as-product]
                                                  @product-both-killed |
                                                    power(x, ONE) = op(E, E)
                                                    [by rewrite ns-kills-x product-left-killed]
                                                  @conclusion-x-is-identity |
                                                    x = E
                                                    [using chain x-is-first-power product-both-killed identity-squared]
                                                }
                                              @conclusion-with-r |
                                                x = E
                                                [by exists_elim with-bezout-s]
                                            }
                                          @conclusion-x-trivial |
                                            x = E
                                            [by exists_elim with-bezout-r]
                                        }
                                      @x-in-h-implies |
                                        inGenerated(h, x) -> x = E
                                        [by implies_intro given-x-in-h]
                                    }
                                  @x-in-g-implies |
                                    inGenerated(g, x) -> inGenerated(h, x) -> x = E
                                    [by implies_intro given-x-in-g]
                                }
                              @discharge-x |
                                forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                                [by forall_intro generalize-x]
                            }
                          @coprime-implies |
                            gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                            [by implies_intro given-coprime]
                        }
                      @h-order-implies |
                        hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                        [by implies_intro given-h-order]
                    }
                  @g-order-implies |
                    hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                    [by implies_intro given-g-order]
                }
              @discharge-n |
                forall n: Int; hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                [by forall_intro generalize-n]
            }
          @discharge-m |
            forall m, n: Int; hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
            [by forall_intro generalize-m]
        }
      @discharge-h |
        forall h: Grp; forall m, n: Int; hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Grp; forall m, n: Int; hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
    [by forall_intro generalize-g]
qed

// -- EXERCISE 37: no proper nontrivial subgroups ⟹ cyclic ------------------------------------
// The hypothesis is stated for the CYCLIC subgroups (every ⟨g⟩ is {e} or the whole group),
// which is all Judson's argument uses: if every element is e, then e generates; otherwise
// pick g ≠ e — ⟨g⟩ contains g, so it is not {e}, so it is everything.
theorem noProperCyclicSubgroupsGivesCyclic: (forall g: Grp; (forall x: Grp; inGenerated(g, x) -> x = E) or (forall x: Grp; inGenerated(g, x))) -> exists g: Grp; forall x: Grp; inGenerated(g, x)
proof
  @given-no-proper-cyclic |
    assume forall g: Grp; (forall x: Grp; inGenerated(g, x) -> x = E) or (forall x: Grp; inGenerated(g, x)) {
      @no-proper-cyclic |
        forall g: Grp; (forall x: Grp; inGenerated(g, x) -> x = E) or (forall x: Grp; inGenerated(g, x))
        [by hypothesis given-no-proper-cyclic]
      @all-identity-or-not |
        (forall y: Grp; y = E) or (not (forall y: Grp; y = E))
        [using tautology]
      @conclusion-generator-exists |
        exists g: Grp; forall x: Grp; inGenerated(g, x)
        case all-identity-or-not {
          // every element is e: then e generates.
          @when-all-identity |
            assume forall y: Grp; y = E {
              @all-identity |
                forall y: Grp; y = E
                [by hypothesis when-all-identity]
              @generalize-x |
                fix x: Grp {
                  @x-is-identity |
                    x = E
                    [using specialize all-identity(x)]
                  @identity-generated |
                    inGenerated(E, E)
                    [using specialize generatedHasIdentity(E)]
                  @x-generated-by-identity |
                    inGenerated(E, x)
                    [by rewrite x-is-identity identity-generated]
                }
              @identity-generates |
                forall x: Grp; inGenerated(E, x)
                [by forall_intro generalize-x]
              @conclusion-identity-generator |
                exists g: Grp; forall x: Grp; inGenerated(g, x)
                [by exists_intro(E) identity-generates]
            }
          // some element is not e: it generates, since ⟨g⟩ ∋ g is not {e}.
          @when-not-all-identity |
            assume not (forall y: Grp; y = E) {
              @not-all-identity |
                not (forall y: Grp; y = E)
                [by hypothesis when-not-all-identity]
              @given-no-nonidentity |
                assume not (exists z: Grp; z != E) {
                  @no-nonidentity |
                    not (exists z: Grp; z != E)
                    [by hypothesis given-no-nonidentity]
                  @generalize-y |
                    fix y: Grp {
                      @given-y-nonidentity |
                        assume y != E {
                          @y-nonidentity |
                            y != E
                            [by hypothesis given-y-nonidentity]
                          @some-nonidentity |
                            exists z: Grp; z != E
                            [by exists_intro(y) y-nonidentity]
                        }
                      @y-nonidentity-implies |
                        y != E -> exists z: Grp; z != E
                        [by implies_intro given-y-nonidentity]
                      @y-is-identity |
                        y = E
                        [using tautology y-nonidentity-implies no-nonidentity]
                    }
                  @all-identity-after-all |
                    forall y: Grp; y = E
                    [by forall_intro generalize-y]
                }
              @no-nonidentity-implies-all-identity |
                (not (exists z: Grp; z != E)) -> (forall y: Grp; y = E)
                [by implies_intro given-no-nonidentity]
              @nonidentity-exists |
                exists z: Grp; z != E
                [using tautology no-nonidentity-implies-all-identity not-all-identity]
              @with-nonidentity-g |
                unpack g: Grp from nonidentity-exists {
                  @g-nonidentity |
                    g != E
                    [by hypothesis with-nonidentity-g]
                  @g-generated |
                    inGenerated(g, g)
                    [using specialize generatorIsGenerated(g)]
                  @g-trivial-or-everything |
                    (forall x: Grp; inGenerated(g, x) -> x = E) or (forall x: Grp; inGenerated(g, x))
                    [using specialize no-proper-cyclic(g)]
                  @conclusion-g-generates |
                    exists g2: Grp; forall x: Grp; inGenerated(g2, x)
                    case g-trivial-or-everything {
                      @when-trivial |
                        assume forall x: Grp; inGenerated(g, x) -> x = E {
                          @trivial |
                            forall x: Grp; inGenerated(g, x) -> x = E
                            [by hypothesis when-trivial]
                          @g-is-identity |
                            g = E
                            [using specialize trivial(g) g-generated]
                          @conclusion-absurd |
                            exists g2: Grp; forall x: Grp; inGenerated(g2, x)
                            [by absurd g-is-identity g-nonidentity]
                        }
                      @when-everything |
                        assume forall x: Grp; inGenerated(g, x) {
                          @everything |
                            forall x: Grp; inGenerated(g, x)
                            [by hypothesis when-everything]
                          @conclusion-g-is-a-generator |
                            exists g2: Grp; forall x: Grp; inGenerated(g2, x)
                            [by exists_intro(g) everything]
                        }
                    }
                }
              @conclusion-some-generator |
                exists g: Grp; forall x: Grp; inGenerated(g, x)
                [by exists_elim with-nonidentity-g]
            }
        }
    }
  @conclusion |
    (forall g: Grp; (forall x: Grp; inGenerated(g, x) -> x = E) or (forall x: Grp; inGenerated(g, x))) -> exists g: Grp; forall x: Grp; inGenerated(g, x)
    [by implies_intro given-no-proper-cyclic]
qed
