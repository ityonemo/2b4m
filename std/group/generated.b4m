// std/group/generated.b4m — the cyclic subgroup ⟨g⟩ generated by a VARIABLE element.
//
// std/cyclic.b4m fixes its generator as a constant A (Judson's ⟨a⟩ for one a). Several
// exercises quantify over the generator — "for every g, ⟨g⟩ is a subgroup", "⟨a⟩ ∩ ⟨b⟩ is
// trivial when the orders are coprime", "a group with no proper nontrivial subgroups is
// cyclic" — so here membership in ⟨g⟩ is the two-place relation inGenerated(g, x): x is an
// integer power of g. The closure facts of std/cyclic.b4m are re-proved for a variable g,
// then used for Judson's §4.1 exercises 27, 30 and 37.

import group <<< "std/group.b4m"
import group_power <<< "std/group/power.b4m"
import group_order <<< "std/group/order.b4m"
import integer <<< "std/integer.b4m"
import int_divides <<< "std/integer/divides.b4m"

sort Grp = group_power.Grp
const E = group_power.E
func op = group_power.op
func inverse = group_power.inverse
func power = group_power.power

sort Int = group_power.Int
const ZERO = group_power.ZERO
const ONE = integer.ONE
func succ = group_power.succ
func add = group_power.add
func mul = group_power.mul
func neg = group_power.neg
func gcd = int_divides.gcd
pred less_than = int_divides.less_than
define divides(d, n) = int_divides.divides(d, n)
define hasOrder(g, n) = group_order.hasOrder(g, n)
define at_most(a, b) = int_divides.at_most(a, b)
func lcm = int_divides.lcm

// x ∈ ⟨g⟩ iff x is an integer power of g.
define inGenerated(g, x) = exists k: Int; x = power(g, k)

// -- ⟨g⟩ is a subgroup containing g, for every g -----------------------------------------

// g ∈ ⟨g⟩, witnessed by g¹ = g.
theorem generatorIsGenerated: forall g: Grp; inGenerated(g, g)
proof
  @generalize-g |
    fix g: Grp {
      @first-power |
        power(g, succ(ZERO)) = g
        [using specialize group_power.powerOne(g)]
      @g-is-first-power |
        g = power(g, succ(ZERO))
        [by symmetry first-power]
      @conclusion-g-generated |
        inGenerated(g, g)
        [by exists_intro(succ(ZERO)) g-is-first-power]
    }
  @conclusion |
    forall g: Grp; inGenerated(g, g)
    [by forall_intro generalize-g]
qed

// e ∈ ⟨g⟩, witnessed by g⁰ = e.
theorem generatedHasIdentity: forall g: Grp; inGenerated(g, E)
proof
  @generalize-g |
    fix g: Grp {
      @zeroth-power |
        power(g, ZERO) = E
        [using specialize group_power.powerZero(g)]
      @identity-is-zeroth-power |
        E = power(g, ZERO)
        [by symmetry zeroth-power]
      @conclusion-identity-generated |
        inGenerated(g, E)
        [by exists_intro(ZERO) identity-is-zeroth-power]
    }
  @conclusion |
    forall g: Grp; inGenerated(g, E)
    [by forall_intro generalize-g]
qed

// ⟨g⟩ is closed under the operation: g^m · g^n = g^(m+n).
theorem generatedClosedOp: forall g: Grp; forall x, y: Grp; inGenerated(g, x) -> inGenerated(g, y) -> inGenerated(g, op(x, y))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-x |
        fix x: Grp {
          @generalize-y |
            fix y: Grp {
              @given-x-in |
                assume inGenerated(g, x) {
                  @given-y-in |
                    assume inGenerated(g, y) {
                      @x-is-power |
                        exists k: Int; x = power(g, k)
                        [by hypothesis given-x-in]
                      @y-is-power |
                        exists k: Int; y = power(g, k)
                        [by hypothesis given-y-in]
                      @with-x-exponent-m |
                        unpack m: Int from x-is-power {
                          @x-power-m |
                            x = power(g, m)
                            [by hypothesis with-x-exponent-m]
                          @with-y-exponent-n |
                            unpack n: Int from y-is-power {
                              @y-power-n |
                                y = power(g, n)
                                [by hypothesis with-y-exponent-n]
                              @powers-add |
                                op(power(g, m), power(g, n)) = power(g, add(m, n))
                                [using specialize group_power.powerAdd(g, m, n)]
                              @product-reflexive |
                                op(x, y) = op(x, y)
                                [by reflexivity]
                              @product-with-m |
                                op(x, y) = op(power(g, m), y)
                                [by rewrite x-power-m product-reflexive]
                              @product-as-powers |
                                op(x, y) = op(power(g, m), power(g, n))
                                [by rewrite y-power-n product-with-m]
                              @product-is-power |
                                op(x, y) = power(g, add(m, n))
                                [using chain product-as-powers powers-add]
                              @conclusion-product-generated |
                                inGenerated(g, op(x, y))
                                [by exists_intro(add(m, n)) product-is-power]
                            }
                          @conclusion-with-x-exponent |
                            inGenerated(g, op(x, y))
                            [by exists_elim with-y-exponent-n]
                        }
                      @conclusion-product-in |
                        inGenerated(g, op(x, y))
                        [by exists_elim with-x-exponent-m]
                    }
                  @y-in-implies |
                    inGenerated(g, y) -> inGenerated(g, op(x, y))
                    [by implies_intro given-y-in]
                }
              @x-in-implies |
                inGenerated(g, x) -> inGenerated(g, y) -> inGenerated(g, op(x, y))
                [by implies_intro given-x-in]
            }
          @discharge-y |
            forall y: Grp; inGenerated(g, x) -> inGenerated(g, y) -> inGenerated(g, op(x, y))
            [by forall_intro generalize-y]
        }
      @discharge-x |
        forall x, y: Grp; inGenerated(g, x) -> inGenerated(g, y) -> inGenerated(g, op(x, y))
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall g: Grp; forall x, y: Grp; inGenerated(g, x) -> inGenerated(g, y) -> inGenerated(g, op(x, y))
    [by forall_intro generalize-g]
qed

// ⟨g⟩ is closed under inverses: (g^k)⁻¹ = g^(−k).
theorem generatedClosedInverse: forall g: Grp; forall x: Grp; inGenerated(g, x) -> inGenerated(g, inverse(x))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-x |
        fix x: Grp {
          @given-x-in |
            assume inGenerated(g, x) {
              @x-is-power |
                exists k: Int; x = power(g, k)
                [by hypothesis given-x-in]
              @with-exponent-k |
                unpack k: Int from x-is-power {
                  @x-power-k |
                    x = power(g, k)
                    [by hypothesis with-exponent-k]
                  @negated-power-is-inverse |
                    power(g, neg(k)) = inverse(power(g, k))
                    [using specialize group_power.powerNegInverse(g, k)]
                  @inverse-reflexive |
                    inverse(x) = inverse(x)
                    [by reflexivity]
                  @inverse-of-power |
                    inverse(x) = inverse(power(g, k))
                    [by rewrite x-power-k inverse-reflexive]
                  @inverse-as-power |
                    inverse(x) = power(g, neg(k))
                    [by rewrite negated-power-is-inverse inverse-of-power]
                  @conclusion-inverse-generated |
                    inGenerated(g, inverse(x))
                    [by exists_intro(neg(k)) inverse-as-power]
                }
              @conclusion-with-exponent |
                inGenerated(g, inverse(x))
                [by exists_elim with-exponent-k]
            }
          @x-in-implies |
            inGenerated(g, x) -> inGenerated(g, inverse(x))
            [by implies_intro given-x-in]
        }
      @discharge-x |
        forall x: Grp; inGenerated(g, x) -> inGenerated(g, inverse(x))
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall g: Grp; forall x: Grp; inGenerated(g, x) -> inGenerated(g, inverse(x))
    [by forall_intro generalize-g]
qed

// -- an exponent killing the generator kills every member -------------------------------
// x = g^i ⟹ x^n = g^(in) = (g^n)^i = e.
theorem killerOfGeneratorKillsMember: forall g: Grp; forall n: Int; power(g, n) = E -> forall x: Grp; inGenerated(g, x) -> power(x, n) = E
proof
  @generalize-g |
    fix g: Grp {
      @generalize-n |
        fix n: Int {
          @given-g-killed |
            assume power(g, n) = E {
              @g-killed |
                power(g, n) = E
                [by hypothesis given-g-killed]
              @generalize-x |
                fix x: Grp {
                  @given-x-in |
                    assume inGenerated(g, x) {
                      @x-is-power |
                        exists k: Int; x = power(g, k)
                        [by hypothesis given-x-in]
                      @with-exponent-i |
                        unpack i: Int from x-is-power {
                          @x-power-i |
                            x = power(g, i)
                            [by hypothesis with-exponent-i]
                          @power-of-power |
                            power(power(g, i), n) = power(g, mul(i, n))
                            [using specialize group_power.powerMul(g, i, n)]
                          @x-power-n |
                            power(x, n) = power(g, mul(i, n))
                            [by rewrite x-power-i power-of-power]
                          @exponents-commute |
                            mul(i, n) = mul(n, i)
                            [using specialize int_divides.mulIsCommutative(i, n)]
                          @x-power-n-swapped |
                            power(x, n) = power(g, mul(n, i))
                            [by rewrite exponents-commute x-power-n]
                          @power-of-killed |
                            power(power(g, n), i) = power(g, mul(n, i))
                            [using specialize group_power.powerMul(g, n, i)]
                          @identity-power |
                            power(E, i) = power(g, mul(n, i))
                            [by rewrite g-killed power-of-killed]
                          @killed-power-is-identity-power |
                            power(g, mul(n, i)) = power(E, i)
                            [by symmetry identity-power]
                          @identity-power-is-identity |
                            power(E, i) = E
                            [using specialize group_power.powerOfIdentity(i)]
                          @conclusion-x-killed |
                            power(x, n) = E
                            [using chain x-power-n-swapped killed-power-is-identity-power identity-power-is-identity]
                        }
                      @conclusion-with-exponent |
                        power(x, n) = E
                        [by exists_elim with-exponent-i]
                    }
                  @x-in-implies |
                    inGenerated(g, x) -> power(x, n) = E
                    [by implies_intro given-x-in]
                }
              @discharge-x |
                forall x: Grp; inGenerated(g, x) -> power(x, n) = E
                [by forall_intro generalize-x]
            }
          @g-killed-implies |
            power(g, n) = E -> forall x: Grp; inGenerated(g, x) -> power(x, n) = E
            [by implies_intro given-g-killed]
        }
      @discharge-n |
        forall n: Int; power(g, n) = E -> forall x: Grp; inGenerated(g, x) -> power(x, n) = E
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall g: Grp; forall n: Int; power(g, n) = E -> forall x: Grp; inGenerated(g, x) -> power(x, n) = E
    [by forall_intro generalize-g]
qed

// -- EXERCISE 27 (the shape behind |g| = 15, |h| = 16): consecutive killing exponents ----
// If m kills g and m+1 kills h, then any x in both ⟨g⟩ and ⟨h⟩ has x = x^(m+1) = x^m · x =
// e · x — so x = e.
theorem consecutiveKillersGiveTrivialIntersection: forall g, h: Grp; forall m: Int; power(g, m) = E -> power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
proof
  @generalize-g |
    fix g: Grp {
      @generalize-h |
        fix h: Grp {
          @generalize-m |
            fix m: Int {
              @given-g-killed |
                assume power(g, m) = E {
                  @given-h-killed |
                    assume power(h, succ(m)) = E {
                      @g-killed |
                        power(g, m) = E
                        [by hypothesis given-g-killed]
                      @h-killed |
                        power(h, succ(m)) = E
                        [by hypothesis given-h-killed]
                      @generalize-x |
                        fix x: Grp {
                          @given-x-in-g |
                            assume inGenerated(g, x) {
                              @given-x-in-h |
                                assume inGenerated(h, x) {
                                  @x-in-g |
                                    inGenerated(g, x)
                                    [by hypothesis given-x-in-g]
                                  @x-in-h |
                                    inGenerated(h, x)
                                    [by hypothesis given-x-in-h]
                                  @m-kills-x |
                                    power(x, m) = E
                                    [using specialize killerOfGeneratorKillsMember(g, m, x) g-killed x-in-g]
                                  @next-kills-x |
                                    power(x, succ(m)) = E
                                    [using specialize killerOfGeneratorKillsMember(h, succ(m), x) h-killed x-in-h]
                                  @next-unfolds |
                                    power(x, succ(m)) = op(power(x, m), x)
                                    [using specialize group_power.powerSucc(x, m)]
                                  @next-is-identity-times-x |
                                    power(x, succ(m)) = op(E, x)
                                    [by rewrite m-kills-x next-unfolds]
                                  @identity-times-x |
                                    op(E, x) = x
                                    [using specialize group_power.opIdentityLeft(x)]
                                  @next-is-x |
                                    power(x, succ(m)) = x
                                    [using chain next-is-identity-times-x identity-times-x]
                                  @x-is-next |
                                    x = power(x, succ(m))
                                    [by symmetry next-is-x]
                                  @conclusion-x-is-identity |
                                    x = E
                                    [using chain x-is-next next-kills-x]
                                }
                              @x-in-h-implies |
                                inGenerated(h, x) -> x = E
                                [by implies_intro given-x-in-h]
                            }
                          @x-in-g-implies |
                            inGenerated(g, x) -> inGenerated(h, x) -> x = E
                            [by implies_intro given-x-in-g]
                        }
                      @discharge-x |
                        forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                        [by forall_intro generalize-x]
                    }
                  @h-killed-implies |
                    power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                    [by implies_intro given-h-killed]
                }
              @g-killed-implies |
                power(g, m) = E -> power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                [by implies_intro given-g-killed]
            }
          @discharge-m |
            forall m: Int; power(g, m) = E -> power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
            [by forall_intro generalize-m]
        }
      @discharge-h |
        forall h: Grp; forall m: Int; power(g, m) = E -> power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Grp; forall m: Int; power(g, m) = E -> power(h, succ(m)) = E -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
    [by forall_intro generalize-g]
qed

// -- EXERCISE 30: coprime orders give a trivial intersection ---------------------------------
// gcd(|g|, |h|) = 1 ⟹ ⟨g⟩ ∩ ⟨h⟩ = {e}. An x in both is killed by |g| and by |h|, hence by
// every combination r|g| + s|h| — in particular by 1 (Bézout, since the only common
// divisors of |g| and |h| are ±1): x = x¹ = e.
theorem coprimeOrdersGiveTrivialIntersection: forall g, h: Grp; forall m, n: Int; hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
proof
  @generalize-g |
    fix g: Grp {
      @generalize-h |
        fix h: Grp {
          @generalize-m |
            fix m: Int {
              @generalize-n |
                fix n: Int {
                  @given-g-order |
                    assume hasOrder(g, m) {
                      @given-h-order |
                        assume hasOrder(h, n) {
                          @given-coprime |
                            assume gcd(m, n) = ONE {
                              @g-order-facts |
                                less_than(ZERO, m) and power(g, m) = E and (forall j: Int; less_than(ZERO, j) -> less_than(j, m) -> power(g, j) != E)
                                [by hypothesis given-g-order]
                              @h-order-facts |
                                less_than(ZERO, n) and power(h, n) = E and (forall j: Int; less_than(ZERO, j) -> less_than(j, n) -> power(h, j) != E)
                                [by hypothesis given-h-order]
                              @gcd-is-one |
                                gcd(m, n) = ONE
                                [by hypothesis given-coprime]
                              @m-positive |
                                less_than(ZERO, m)
                                [using tautology g-order-facts]
                              @g-killed |
                                power(g, m) = E
                                [using tautology g-order-facts]
                              @n-positive |
                                less_than(ZERO, n)
                                [using tautology h-order-facts]
                              @h-killed |
                                power(h, n) = E
                                [using tautology h-order-facts]
                              // the orders are nonzero (they are positive).
                              @zero-not-below-itself |
                                not less_than(ZERO, ZERO)
                                [using specialize int_divides.lessThanIrreflexive(ZERO)]
                              @given-m-zero |
                                assume m = ZERO {
                                  @m-zero |
                                    m = ZERO
                                    [by hypothesis given-m-zero]
                                  @zero-below-itself-m |
                                    less_than(ZERO, ZERO)
                                    [by rewrite m-zero m-positive]
                                }
                              @m-zero-implies |
                                m = ZERO -> less_than(ZERO, ZERO)
                                [by implies_intro given-m-zero]
                              @m-nonzero |
                                m != ZERO
                                [using tautology m-zero-implies zero-not-below-itself]
                              @given-n-zero |
                                assume n = ZERO {
                                  @n-zero |
                                    n = ZERO
                                    [by hypothesis given-n-zero]
                                  @zero-below-itself-n |
                                    less_than(ZERO, ZERO)
                                    [by rewrite n-zero n-positive]
                                }
                              @n-zero-implies |
                                n = ZERO -> less_than(ZERO, ZERO)
                                [by implies_intro given-n-zero]
                              @n-nonzero |
                                n != ZERO
                                [using tautology n-zero-implies zero-not-below-itself]
                              // every common divisor divides gcd(m, n) = 1, so is ±1.
                              @generalize-divisor |
                                fix d: Int {
                                  @given-d-divides-m |
                                    assume divides(d, m) {
                                      @given-d-divides-n |
                                        assume divides(d, n) {
                                          @d-divides-m |
                                            divides(d, m)
                                            [by hypothesis given-d-divides-m]
                                          @d-divides-n |
                                            divides(d, n)
                                            [by hypothesis given-d-divides-n]
                                          @d-divides-gcd |
                                            divides(d, gcd(m, n))
                                            [using specialize int_divides.gcdGreatest(d, m, n) d-divides-m d-divides-n]
                                          @d-divides-one |
                                            divides(d, ONE)
                                            [by rewrite gcd-is-one d-divides-gcd]
                                          @d-is-a-unit |
                                            d = ONE or d = neg(ONE)
                                            [using specialize int_divides.dividesOneImpliesUnit(d) d-divides-one]
                                        }
                                      @d-divides-n-implies |
                                        divides(d, n) -> (d = ONE or d = neg(ONE))
                                        [by implies_intro given-d-divides-n]
                                    }
                                  @d-divides-m-implies |
                                    divides(d, m) -> divides(d, n) -> (d = ONE or d = neg(ONE))
                                    [by implies_intro given-d-divides-m]
                                }
                              @common-divisors-are-units |
                                forall d: Int; divides(d, m) -> divides(d, n) -> (d = ONE or d = neg(ONE))
                                [by forall_intro generalize-divisor]
                              @bezout-exists |
                                exists r: Int; exists s: Int; add(mul(m, r), mul(n, s)) = ONE
                                [using specialize int_divides.coprimeBezout(m, n) m-nonzero n-nonzero common-divisors-are-units]
                              @generalize-x |
                                fix x: Grp {
                                  @given-x-in-g |
                                    assume inGenerated(g, x) {
                                      @given-x-in-h |
                                        assume inGenerated(h, x) {
                                          @x-in-g |
                                            inGenerated(g, x)
                                            [by hypothesis given-x-in-g]
                                          @x-in-h |
                                            inGenerated(h, x)
                                            [by hypothesis given-x-in-h]
                                          @m-kills-x |
                                            power(x, m) = E
                                            [using specialize killerOfGeneratorKillsMember(g, m, x) g-killed x-in-g]
                                          @n-kills-x |
                                            power(x, n) = E
                                            [using specialize killerOfGeneratorKillsMember(h, n, x) h-killed x-in-h]
                                          @one-is-succ-zero |
                                            ONE = succ(ZERO)
                                            [using import(integer) oneIsSuccZero]
                                          @first-power |
                                            power(x, succ(ZERO)) = x
                                            [using specialize group_power.powerOne(x)]
                                          @first-power-at-one |
                                            power(x, ONE) = x
                                            [by rewrite one-is-succ-zero first-power]
                                          @x-is-first-power |
                                            x = power(x, ONE)
                                            [by symmetry first-power-at-one]
                                          @with-bezout-r |
                                            unpack r: Int from bezout-exists {
                                              @s-exists |
                                                exists s: Int; add(mul(m, r), mul(n, s)) = ONE
                                                [by hypothesis with-bezout-r]
                                              @with-bezout-s |
                                                unpack s: Int from s-exists {
                                                  @bezout-identity |
                                                    add(mul(m, r), mul(n, s)) = ONE
                                                    [by hypothesis with-bezout-s]
                                                  // x^(mr) = (x^m)^r = e, and x^(ns) = (x^n)^s = e.
                                                  @power-of-m-power |
                                                    power(power(x, m), r) = power(x, mul(m, r))
                                                    [using specialize group_power.powerMul(x, m, r)]
                                                  @mr-power-as-identity-power |
                                                    power(E, r) = power(x, mul(m, r))
                                                    [by rewrite m-kills-x power-of-m-power]
                                                  @identity-power-r |
                                                    power(E, r) = E
                                                    [using specialize group_power.powerOfIdentity(r)]
                                                  @mr-power-flipped |
                                                    power(x, mul(m, r)) = power(E, r)
                                                    [by symmetry mr-power-as-identity-power]
                                                  @mr-kills-x |
                                                    power(x, mul(m, r)) = E
                                                    [using chain mr-power-flipped identity-power-r]
                                                  @power-of-n-power |
                                                    power(power(x, n), s) = power(x, mul(n, s))
                                                    [using specialize group_power.powerMul(x, n, s)]
                                                  @ns-power-as-identity-power |
                                                    power(E, s) = power(x, mul(n, s))
                                                    [by rewrite n-kills-x power-of-n-power]
                                                  @identity-power-s |
                                                    power(E, s) = E
                                                    [using specialize group_power.powerOfIdentity(s)]
                                                  @ns-power-flipped |
                                                    power(x, mul(n, s)) = power(E, s)
                                                    [by symmetry ns-power-as-identity-power]
                                                  @ns-kills-x |
                                                    power(x, mul(n, s)) = E
                                                    [using chain ns-power-flipped identity-power-s]
                                                  // x = x¹ = x^(mr + ns) = x^(mr) · x^(ns) = e · e.
                                                  @powers-add |
                                                    op(power(x, mul(m, r)), power(x, mul(n, s))) = power(x, add(mul(m, r), mul(n, s)))
                                                    [using specialize group_power.powerAdd(x, mul(m, r), mul(n, s))]
                                                  @first-power-splits |
                                                    op(power(x, mul(m, r)), power(x, mul(n, s))) = power(x, ONE)
                                                    [by rewrite bezout-identity powers-add]
                                                  @identity-squared |
                                                    op(E, E) = E
                                                    [using specialize group_power.opIdentityLeft(E)]
                                                  @first-power-as-product |
                                                    power(x, ONE) = op(power(x, mul(m, r)), power(x, mul(n, s)))
                                                    [by symmetry first-power-splits]
                                                  @product-left-killed |
                                                    power(x, ONE) = op(E, power(x, mul(n, s)))
                                                    [by rewrite mr-kills-x first-power-as-product]
                                                  @product-both-killed |
                                                    power(x, ONE) = op(E, E)
                                                    [by rewrite ns-kills-x product-left-killed]
                                                  @conclusion-x-is-identity |
                                                    x = E
                                                    [using chain x-is-first-power product-both-killed identity-squared]
                                                }
                                              @conclusion-with-r |
                                                x = E
                                                [by exists_elim with-bezout-s]
                                            }
                                          @conclusion-x-trivial |
                                            x = E
                                            [by exists_elim with-bezout-r]
                                        }
                                      @x-in-h-implies |
                                        inGenerated(h, x) -> x = E
                                        [by implies_intro given-x-in-h]
                                    }
                                  @x-in-g-implies |
                                    inGenerated(g, x) -> inGenerated(h, x) -> x = E
                                    [by implies_intro given-x-in-g]
                                }
                              @discharge-x |
                                forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                                [by forall_intro generalize-x]
                            }
                          @coprime-implies |
                            gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                            [by implies_intro given-coprime]
                        }
                      @h-order-implies |
                        hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                        [by implies_intro given-h-order]
                    }
                  @g-order-implies |
                    hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                    [by implies_intro given-g-order]
                }
              @discharge-n |
                forall n: Int; hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
                [by forall_intro generalize-n]
            }
          @discharge-m |
            forall m, n: Int; hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
            [by forall_intro generalize-m]
        }
      @discharge-h |
        forall h: Grp; forall m, n: Int; hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Grp; forall m, n: Int; hasOrder(g, m) -> hasOrder(h, n) -> gcd(m, n) = ONE -> forall x: Grp; inGenerated(g, x) -> inGenerated(h, x) -> x = E
    [by forall_intro generalize-g]
qed

// -- EXERCISE 37: no proper nontrivial subgroups ⟹ cyclic ------------------------------------
// The hypothesis is stated for the CYCLIC subgroups (every ⟨g⟩ is {e} or the whole group),
// which is all Judson's argument uses: if every element is e, then e generates; otherwise
// pick g ≠ e — ⟨g⟩ contains g, so it is not {e}, so it is everything.
theorem noProperCyclicSubgroupsGivesCyclic: (forall g: Grp; (forall x: Grp; inGenerated(g, x) -> x = E) or (forall x: Grp; inGenerated(g, x))) -> exists g: Grp; forall x: Grp; inGenerated(g, x)
proof
  @given-no-proper-cyclic |
    assume forall g: Grp; (forall x: Grp; inGenerated(g, x) -> x = E) or (forall x: Grp; inGenerated(g, x)) {
      @no-proper-cyclic |
        forall g: Grp; (forall x: Grp; inGenerated(g, x) -> x = E) or (forall x: Grp; inGenerated(g, x))
        [by hypothesis given-no-proper-cyclic]
      @all-identity-or-not |
        (forall y: Grp; y = E) or (not (forall y: Grp; y = E))
        [using tautology]
      @conclusion-generator-exists |
        exists g: Grp; forall x: Grp; inGenerated(g, x)
        case all-identity-or-not {
          // every element is e: then e generates.
          @when-all-identity |
            assume forall y: Grp; y = E {
              @all-identity |
                forall y: Grp; y = E
                [by hypothesis when-all-identity]
              @generalize-x |
                fix x: Grp {
                  @x-is-identity |
                    x = E
                    [using specialize all-identity(x)]
                  @identity-generated |
                    inGenerated(E, E)
                    [using specialize generatedHasIdentity(E)]
                  @x-generated-by-identity |
                    inGenerated(E, x)
                    [by rewrite x-is-identity identity-generated]
                }
              @identity-generates |
                forall x: Grp; inGenerated(E, x)
                [by forall_intro generalize-x]
              @conclusion-identity-generator |
                exists g: Grp; forall x: Grp; inGenerated(g, x)
                [by exists_intro(E) identity-generates]
            }
          // some element is not e: it generates, since ⟨g⟩ ∋ g is not {e}.
          @when-not-all-identity |
            assume not (forall y: Grp; y = E) {
              @not-all-identity |
                not (forall y: Grp; y = E)
                [by hypothesis when-not-all-identity]
              @given-no-nonidentity |
                assume not (exists z: Grp; z != E) {
                  @no-nonidentity |
                    not (exists z: Grp; z != E)
                    [by hypothesis given-no-nonidentity]
                  @generalize-y |
                    fix y: Grp {
                      @given-y-nonidentity |
                        assume y != E {
                          @y-nonidentity |
                            y != E
                            [by hypothesis given-y-nonidentity]
                          @some-nonidentity |
                            exists z: Grp; z != E
                            [by exists_intro(y) y-nonidentity]
                        }
                      @y-nonidentity-implies |
                        y != E -> exists z: Grp; z != E
                        [by implies_intro given-y-nonidentity]
                      @y-is-identity |
                        y = E
                        [using tautology y-nonidentity-implies no-nonidentity]
                    }
                  @all-identity-after-all |
                    forall y: Grp; y = E
                    [by forall_intro generalize-y]
                }
              @no-nonidentity-implies-all-identity |
                (not (exists z: Grp; z != E)) -> (forall y: Grp; y = E)
                [by implies_intro given-no-nonidentity]
              @nonidentity-exists |
                exists z: Grp; z != E
                [using tautology no-nonidentity-implies-all-identity not-all-identity]
              @with-nonidentity-g |
                unpack g: Grp from nonidentity-exists {
                  @g-nonidentity |
                    g != E
                    [by hypothesis with-nonidentity-g]
                  @g-generated |
                    inGenerated(g, g)
                    [using specialize generatorIsGenerated(g)]
                  @g-trivial-or-everything |
                    (forall x: Grp; inGenerated(g, x) -> x = E) or (forall x: Grp; inGenerated(g, x))
                    [using specialize no-proper-cyclic(g)]
                  @conclusion-g-generates |
                    exists g2: Grp; forall x: Grp; inGenerated(g2, x)
                    case g-trivial-or-everything {
                      @when-trivial |
                        assume forall x: Grp; inGenerated(g, x) -> x = E {
                          @trivial |
                            forall x: Grp; inGenerated(g, x) -> x = E
                            [by hypothesis when-trivial]
                          @g-is-identity |
                            g = E
                            [using specialize trivial(g) g-generated]
                          @conclusion-absurd |
                            exists g2: Grp; forall x: Grp; inGenerated(g2, x)
                            [by absurd g-is-identity g-nonidentity]
                        }
                      @when-everything |
                        assume forall x: Grp; inGenerated(g, x) {
                          @everything |
                            forall x: Grp; inGenerated(g, x)
                            [by hypothesis when-everything]
                          @conclusion-g-is-a-generator |
                            exists g2: Grp; forall x: Grp; inGenerated(g2, x)
                            [by exists_intro(g) everything]
                        }
                    }
                }
              @conclusion-some-generator |
                exists g: Grp; forall x: Grp; inGenerated(g, x)
                [by exists_elim with-nonidentity-g]
            }
        }
    }
  @conclusion |
    (forall g: Grp; (forall x: Grp; inGenerated(g, x) -> x = E) or (forall x: Grp; inGenerated(g, x))) -> exists g: Grp; forall x: Grp; inGenerated(g, x)
    [by implies_intro given-no-proper-cyclic]
qed

// -- ABELIAN: coprime orders multiply ---------------------------------------------------------
// |a| = m, |b| = n, gcd(m, n) = 1 ⟹ |ab| = mn. (ab)^(mn) = a^(mn) b^(mn) = e. If (ab)^k = e then
// a^k = b^(−k) lies in ⟨a⟩ ∩ ⟨b⟩ = {e}, so m | k and n | k, hence mn | k (Euclid, from a Bézout
// identity for n and m); a positive such k is at least mn. Commutativity enters through the
// power-of-a-product law.
theorem coprimeOrdersMultiplyAbelian: forall a, b: Grp; forall m, n: Int; hasOrder(a, m) -> hasOrder(b, n) -> gcd(m, n) = ONE -> hasOrder(op(a, b), mul(m, n))
proof
  @generalize-a |
    fix a: Grp {
      @generalize-b |
        fix b: Grp {
          @generalize-m |
            fix m: Int {
              @generalize-n |
                fix n: Int {
                  @given-a-order |
                    assume hasOrder(a, m) {
                      @given-b-order |
                        assume hasOrder(b, n) {
                          @given-coprime |
                            assume gcd(m, n) = ONE {
                              @a-order |
                                hasOrder(a, m)
                                [by hypothesis given-a-order]
                              @b-order |
                                hasOrder(b, n)
                                [by hypothesis given-b-order]
                              @gcd-is-one |
                                gcd(m, n) = ONE
                                [by hypothesis given-coprime]
                              @a-order-facts |
                                less_than(ZERO, m) and power(a, m) = E and (forall j: Int; less_than(ZERO, j) -> less_than(j, m) -> power(a, j) != E)
                                [by hypothesis given-a-order]
                              @b-order-facts |
                                less_than(ZERO, n) and power(b, n) = E and (forall j: Int; less_than(ZERO, j) -> less_than(j, n) -> power(b, j) != E)
                                [by hypothesis given-b-order]
                              @m-positive |
                                less_than(ZERO, m)
                                [using tautology a-order-facts]
                              @a-killed |
                                power(a, m) = E
                                [using tautology a-order-facts]
                              @n-positive |
                                less_than(ZERO, n)
                                [using tautology b-order-facts]
                              @b-killed |
                                power(b, n) = E
                                [using tautology b-order-facts]
                              @product-positive |
                                less_than(ZERO, mul(m, n))
                                [using specialize int_divides.productWithPositiveIsPositive(m, n) m-positive n-positive]
                              // mn kills ab.
                              @a-power-mul |
                                power(power(a, m), n) = power(a, mul(m, n))
                                [using specialize group_power.powerMul(a, m, n)]
                              @a-mn-as-identity-power |
                                power(E, n) = power(a, mul(m, n))
                                [by rewrite a-killed a-power-mul]
                              @a-mn-flipped |
                                power(a, mul(m, n)) = power(E, n)
                                [by symmetry a-mn-as-identity-power]
                              @identity-power-n |
                                power(E, n) = E
                                [using specialize group_power.powerOfIdentity(n)]
                              @a-mn-killed |
                                power(a, mul(m, n)) = E
                                [using chain a-mn-flipped identity-power-n]
                              @b-power-mul |
                                power(power(b, n), m) = power(b, mul(n, m))
                                [using specialize group_power.powerMul(b, n, m)]
                              @b-nm-as-identity-power |
                                power(E, m) = power(b, mul(n, m))
                                [by rewrite b-killed b-power-mul]
                              @b-nm-flipped |
                                power(b, mul(n, m)) = power(E, m)
                                [by symmetry b-nm-as-identity-power]
                              @identity-power-m |
                                power(E, m) = E
                                [using specialize group_power.powerOfIdentity(m)]
                              @b-nm-killed |
                                power(b, mul(n, m)) = E
                                [using chain b-nm-flipped identity-power-m]
                              @exponents-commute |
                                mul(n, m) = mul(m, n)
                                [using specialize int_divides.mulIsCommutative(n, m)]
                              @b-mn-killed |
                                power(b, mul(m, n)) = E
                                [by rewrite exponents-commute b-nm-killed]
                              @product-mn-splits |
                                power(op(a, b), mul(m, n)) = op(power(a, mul(m, n)), power(b, mul(m, n)))
                                [using specialize group_power.powerProductAbelian(a, b, mul(m, n))]
                              @product-mn-left-killed |
                                power(op(a, b), mul(m, n)) = op(E, power(b, mul(m, n)))
                                [by rewrite a-mn-killed product-mn-splits]
                              @product-mn-both-killed |
                                power(op(a, b), mul(m, n)) = op(E, E)
                                [by rewrite b-mn-killed product-mn-left-killed]
                              @identity-squared |
                                op(E, E) = E
                                [using specialize group_power.opIdentityLeft(E)]
                              @product-killed |
                                power(op(a, b), mul(m, n)) = E
                                [using chain product-mn-both-killed identity-squared]
                              // ⟨a⟩ ∩ ⟨b⟩ = {e}, and a Bézout identity for n and m.
                              @intersection-trivial |
                                forall x: Grp; inGenerated(a, x) -> inGenerated(b, x) -> x = E
                                [using specialize coprimeOrdersGiveTrivialIntersection(a, b, m, n) a-order b-order gcd-is-one]
                              @zero-not-below-itself |
                                not less_than(ZERO, ZERO)
                                [using specialize int_divides.lessThanIrreflexive(ZERO)]
                              @given-m-zero |
                                assume m = ZERO {
                                  @m-zero |
                                    m = ZERO
                                    [by hypothesis given-m-zero]
                                  @zero-below-itself-m |
                                    less_than(ZERO, ZERO)
                                    [by rewrite m-zero m-positive]
                                }
                              @m-zero-implies |
                                m = ZERO -> less_than(ZERO, ZERO)
                                [by implies_intro given-m-zero]
                              @m-nonzero |
                                m != ZERO
                                [using tautology m-zero-implies zero-not-below-itself]
                              @given-n-zero |
                                assume n = ZERO {
                                  @n-zero |
                                    n = ZERO
                                    [by hypothesis given-n-zero]
                                  @zero-below-itself-n |
                                    less_than(ZERO, ZERO)
                                    [by rewrite n-zero n-positive]
                                }
                              @n-zero-implies |
                                n = ZERO -> less_than(ZERO, ZERO)
                                [by implies_intro given-n-zero]
                              @n-nonzero |
                                n != ZERO
                                [using tautology n-zero-implies zero-not-below-itself]
                              @generalize-divisor |
                                fix d: Int {
                                  @given-d-divides-n |
                                    assume divides(d, n) {
                                      @given-d-divides-m |
                                        assume divides(d, m) {
                                          @d-divides-n |
                                            divides(d, n)
                                            [by hypothesis given-d-divides-n]
                                          @d-divides-m |
                                            divides(d, m)
                                            [by hypothesis given-d-divides-m]
                                          @d-divides-gcd |
                                            divides(d, gcd(m, n))
                                            [using specialize int_divides.gcdGreatest(d, m, n) d-divides-m d-divides-n]
                                          @d-divides-one |
                                            divides(d, ONE)
                                            [by rewrite gcd-is-one d-divides-gcd]
                                          @d-is-a-unit |
                                            d = ONE or d = neg(ONE)
                                            [using specialize int_divides.dividesOneImpliesUnit(d) d-divides-one]
                                        }
                                      @d-divides-m-implies |
                                        divides(d, m) -> (d = ONE or d = neg(ONE))
                                        [by implies_intro given-d-divides-m]
                                    }
                                  @d-divides-n-implies |
                                    divides(d, n) -> divides(d, m) -> (d = ONE or d = neg(ONE))
                                    [by implies_intro given-d-divides-n]
                                }
                              @common-divisors-are-units |
                                forall d: Int; divides(d, n) -> divides(d, m) -> (d = ONE or d = neg(ONE))
                                [by forall_intro generalize-divisor]
                              @bezout-exists |
                                exists r: Int; exists s: Int; add(mul(n, r), mul(m, s)) = ONE
                                [using specialize int_divides.coprimeBezout(n, m) n-nonzero m-nonzero common-divisors-are-units]
                              // minimality: a positive k < mn cannot kill ab.
                              @generalize-k |
                                fix k: Int {
                                  @given-k-positive |
                                    assume less_than(ZERO, k) {
                                      @given-k-below |
                                        assume less_than(k, mul(m, n)) {
                                          @k-positive |
                                            less_than(ZERO, k)
                                            [by hypothesis given-k-positive]
                                          @k-below-mn |
                                            less_than(k, mul(m, n))
                                            [by hypothesis given-k-below]
                                          @mn-not-below-itself |
                                            not less_than(mul(m, n), mul(m, n))
                                            [using specialize int_divides.lessThanIrreflexive(mul(m, n))]
                                          @given-k-kills |
                                            assume power(op(a, b), k) = E {
                                              @k-kills |
                                                power(op(a, b), k) = E
                                                [by hypothesis given-k-kills]
                                              @product-k-splits |
                                                power(op(a, b), k) = op(power(a, k), power(b, k))
                                                [using specialize group_power.powerProductAbelian(a, b, k)]
                                              @factors-flipped |
                                                op(power(a, k), power(b, k)) = power(op(a, b), k)
                                                [by symmetry product-k-splits]
                                              @factors-give-identity |
                                                op(power(a, k), power(b, k)) = E
                                                [using chain factors-flipped k-kills]
                                              // b^k = (a^k)⁻¹ = a^(−k) ∈ ⟨a⟩ ∩ ⟨b⟩, so b^k = e, then a^k = e.
                                              @b-k-is-inverse-of-a-k |
                                                power(b, k) = inverse(power(a, k))
                                                [using specialize group_power.inverseUnique(power(a, k), power(b, k)) factors-give-identity]
                                              @negated-power |
                                                power(a, neg(k)) = inverse(power(a, k))
                                                [using specialize group_power.powerNegInverse(a, k)]
                                              @inverse-is-negated-power |
                                                inverse(power(a, k)) = power(a, neg(k))
                                                [by symmetry negated-power]
                                              @b-k-is-a-power |
                                                power(b, k) = power(a, neg(k))
                                                [using chain b-k-is-inverse-of-a-k inverse-is-negated-power]
                                              @b-k-in-a |
                                                inGenerated(a, power(b, k))
                                                [by exists_intro(neg(k)) b-k-is-a-power]
                                              @b-k-reflexive |
                                                power(b, k) = power(b, k)
                                                [by reflexivity]
                                              @b-k-in-b |
                                                inGenerated(b, power(b, k))
                                                [by exists_intro(k) b-k-reflexive]
                                              @b-k-is-identity |
                                                power(b, k) = E
                                                [using specialize intersection-trivial(power(b, k)) b-k-in-a b-k-in-b]
                                              @a-k-times-identity |
                                                op(power(a, k), E) = E
                                                [by rewrite b-k-is-identity factors-give-identity]
                                              @a-k-times-identity-unfolds |
                                                op(power(a, k), E) = power(a, k)
                                                [using specialize group_power.opIdentityRight(power(a, k))]
                                              @a-k-unfolded |
                                                power(a, k) = op(power(a, k), E)
                                                [by symmetry a-k-times-identity-unfolds]
                                              @a-k-is-identity |
                                                power(a, k) = E
                                                [using chain a-k-unfolded a-k-times-identity]
                                              // so m | k and n | k.
                                              @a-killed-iff |
                                                power(a, k) = E iff divides(m, k)
                                                [using specialize group_order.killedIffOrderDivides(a, m, k) a-order]
                                              @m-divides-k |
                                                divides(m, k)
                                                [using tautology a-killed-iff a-k-is-identity]
                                              @b-killed-iff |
                                                power(b, k) = E iff divides(n, k)
                                                [using specialize group_order.killedIffOrderDivides(b, n, k) b-order]
                                              @n-divides-k |
                                                divides(n, k)
                                                [using tautology b-killed-iff b-k-is-identity]
                                              // hence mn | k, so mn ≤ k < mn.
                                              @with-cofactor-u |
                                                unpack u: Int from m-divides-k {
                                                  @k-is-mu |
                                                    k = mul(m, u)
                                                    [by hypothesis with-cofactor-u]
                                                  @n-divides-mu |
                                                    divides(n, mul(m, u))
                                                    [by rewrite k-is-mu n-divides-k]
                                                  @with-bezout-r |
                                                    unpack r: Int from bezout-exists {
                                                      @s-exists |
                                                        exists s: Int; add(mul(n, r), mul(m, s)) = ONE
                                                        [by hypothesis with-bezout-r]
                                                      @with-bezout-s |
                                                        unpack s: Int from s-exists {
                                                          @bezout-identity |
                                                            add(mul(n, r), mul(m, s)) = ONE
                                                            [by hypothesis with-bezout-s]
                                                          @n-divides-u |
                                                            divides(n, u)
                                                            [using specialize int_divides.euclidFromBezout(n, m, u, r, s) bezout-identity n-divides-mu]
                                                          @with-cofactor-t |
                                                            unpack t: Int from n-divides-u {
                                                              @u-is-nt |
                                                                u = mul(n, t)
                                                                [by hypothesis with-cofactor-t]
                                                              @k-is-m-nt |
                                                                k = mul(m, mul(n, t))
                                                                [by rewrite u-is-nt k-is-mu]
                                                              @regrouped |
                                                                mul(mul(m, n), t) = mul(m, mul(n, t))
                                                                [using specialize int_divides.mulIsAssociative(m, n, t)]
                                                              @regrouped-flipped |
                                                                mul(m, mul(n, t)) = mul(mul(m, n), t)
                                                                [by symmetry regrouped]
                                                              @k-is-mn-t |
                                                                k = mul(mul(m, n), t)
                                                                [using chain k-is-m-nt regrouped-flipped]
                                                              @mn-divides-k |
                                                                divides(mul(m, n), k)
                                                                [by exists_intro(t) k-is-mn-t]
                                                              @mn-at-most-k |
                                                                at_most(mul(m, n), k)
                                                                [using specialize int_divides.divisorAtMost(mul(m, n), k) product-positive k-positive mn-divides-k]
                                                              @conclusion-mn-below-itself-inner |
                                                                less_than(mul(m, n), mul(m, n))
                                                                [using specialize int_divides.atMostThenLessThan(mul(m, n), k, mul(m, n)) mn-at-most-k k-below-mn]
                                                            }
                                                          @conclusion-with-t |
                                                            less_than(mul(m, n), mul(m, n))
                                                            [by exists_elim with-cofactor-t]
                                                        }
                                                      @conclusion-with-s |
                                                        less_than(mul(m, n), mul(m, n))
                                                        [by exists_elim with-bezout-s]
                                                    }
                                                  @conclusion-with-r |
                                                    less_than(mul(m, n), mul(m, n))
                                                    [by exists_elim with-bezout-r]
                                                }
                                              @mn-below-itself |
                                                less_than(mul(m, n), mul(m, n))
                                                [by exists_elim with-cofactor-u]
                                            }
                                          @k-kills-implies |
                                            power(op(a, b), k) = E -> less_than(mul(m, n), mul(m, n))
                                            [by implies_intro given-k-kills]
                                          @conclusion-k-does-not-kill |
                                            power(op(a, b), k) != E
                                            [using tautology k-kills-implies mn-not-below-itself]
                                        }
                                      @k-below-implies |
                                        less_than(k, mul(m, n)) -> power(op(a, b), k) != E
                                        [by implies_intro given-k-below]
                                    }
                                  @k-positive-implies |
                                    less_than(ZERO, k) -> less_than(k, mul(m, n)) -> power(op(a, b), k) != E
                                    [by implies_intro given-k-positive]
                                }
                              @product-minimal |
                                forall k: Int; less_than(ZERO, k) -> less_than(k, mul(m, n)) -> power(op(a, b), k) != E
                                [by forall_intro generalize-k]
                              @conclusion-product-order |
                                hasOrder(op(a, b), mul(m, n))
                                [using tautology product-positive product-killed product-minimal]
                            }
                          @coprime-implies |
                            gcd(m, n) = ONE -> hasOrder(op(a, b), mul(m, n))
                            [by implies_intro given-coprime]
                        }
                      @b-order-implies |
                        hasOrder(b, n) -> gcd(m, n) = ONE -> hasOrder(op(a, b), mul(m, n))
                        [by implies_intro given-b-order]
                    }
                  @a-order-implies |
                    hasOrder(a, m) -> hasOrder(b, n) -> gcd(m, n) = ONE -> hasOrder(op(a, b), mul(m, n))
                    [by implies_intro given-a-order]
                }
              @discharge-n |
                forall n: Int; hasOrder(a, m) -> hasOrder(b, n) -> gcd(m, n) = ONE -> hasOrder(op(a, b), mul(m, n))
                [by forall_intro generalize-n]
            }
          @discharge-m |
            forall m, n: Int; hasOrder(a, m) -> hasOrder(b, n) -> gcd(m, n) = ONE -> hasOrder(op(a, b), mul(m, n))
            [by forall_intro generalize-m]
        }
      @discharge-b |
        forall b: Grp; forall m, n: Int; hasOrder(a, m) -> hasOrder(b, n) -> gcd(m, n) = ONE -> hasOrder(op(a, b), mul(m, n))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Grp; forall m, n: Int; hasOrder(a, m) -> hasOrder(b, n) -> gcd(m, n) = ONE -> hasOrder(op(a, b), mul(m, n))
    [by forall_intro generalize-a]
qed

// -- EXERCISE 28: ⟨a^m⟩ ∩ ⟨a^n⟩ is generated by a^lcm(m, n) ---------------------------------
// a^lcm always lies in both subgroups (lcm is a common multiple), so ⟨a^lcm⟩ ⊆ ⟨a^m⟩ ∩ ⟨a^n⟩.
// The reverse inclusion is proved for a of INFINITE order — no positive power is e — where
// a^(mi) = a^(nj) forces mi = nj, a common multiple, hence a multiple of the lcm. (For a of
// finite order N the answer is still a^lcm, but that needs gcd(lcm(m, n), N) =
// lcm(gcd(m, N), gcd(n, N)), distributivity of the divisor lattice, which std does not have.)
define hasInfiniteOrder(a) = forall k: Int; power(a, k) = E -> k = ZERO

// the lcm power lies in both: a^lcm = (a^m)^u where lcm = m·u.
theorem lcmPowerIsInBothSubgroups: forall a: Grp; forall m, n: Int; forall x: Grp; inGenerated(power(a, lcm(m, n)), x) -> (inGenerated(power(a, m), x) and inGenerated(power(a, n), x))
proof
  @generalize-a |
    fix a: Grp {
      @generalize-m |
        fix m: Int {
          @generalize-n |
            fix n: Int {
              @generalize-x |
                fix x: Grp {
                  @given-x-in |
                    assume inGenerated(power(a, lcm(m, n)), x) {
                      @x-is-power |
                        exists k: Int; x = power(power(a, lcm(m, n)), k)
                        [by hypothesis given-x-in]
                      @m-divides-lcm |
                        divides(m, lcm(m, n))
                        [using specialize int_divides.lcmCommonMultipleLeft(m, n)]
                      @n-divides-lcm |
                        divides(n, lcm(m, n))
                        [using specialize int_divides.lcmCommonMultipleRight(m, n)]
                      @with-exponent-t |
                        unpack t: Int from x-is-power {
                          @x-power-t |
                            x = power(power(a, lcm(m, n)), t)
                            [by hypothesis with-exponent-t]
                          @lcm-power-of-power |
                            power(power(a, lcm(m, n)), t) = power(a, mul(lcm(m, n), t))
                            [using specialize group_power.powerMul(a, lcm(m, n), t)]
                          @x-is-a-power |
                            x = power(a, mul(lcm(m, n), t))
                            [using chain x-power-t lcm-power-of-power]
                          // through m.
                          @with-m-cofactor-u |
                            unpack u: Int from m-divides-lcm {
                              @lcm-is-mu |
                                lcm(m, n) = mul(m, u)
                                [by hypothesis with-m-cofactor-u]
                              @x-is-a-mut |
                                x = power(a, mul(mul(m, u), t))
                                [by rewrite lcm-is-mu x-is-a-power]
                              @mut-regrouped |
                                mul(mul(m, u), t) = mul(m, mul(u, t))
                                [using specialize int_divides.mulIsAssociative(m, u, t)]
                              @x-is-a-m-ut |
                                x = power(a, mul(m, mul(u, t)))
                                [by rewrite mut-regrouped x-is-a-mut]
                              @m-power-of-power |
                                power(power(a, m), mul(u, t)) = power(a, mul(m, mul(u, t)))
                                [using specialize group_power.powerMul(a, m, mul(u, t))]
                              @a-m-ut-is-m-power |
                                power(a, mul(m, mul(u, t))) = power(power(a, m), mul(u, t))
                                [by symmetry m-power-of-power]
                              @x-is-m-power |
                                x = power(power(a, m), mul(u, t))
                                [using chain x-is-a-m-ut a-m-ut-is-m-power]
                              @conclusion-x-in-m |
                                inGenerated(power(a, m), x)
                                [by exists_intro(mul(u, t)) x-is-m-power]
                            }
                          @x-in-m |
                            inGenerated(power(a, m), x)
                            [by exists_elim with-m-cofactor-u]
                          // through n.
                          @with-n-cofactor-v |
                            unpack v: Int from n-divides-lcm {
                              @lcm-is-nv |
                                lcm(m, n) = mul(n, v)
                                [by hypothesis with-n-cofactor-v]
                              @x-is-a-nvt |
                                x = power(a, mul(mul(n, v), t))
                                [by rewrite lcm-is-nv x-is-a-power]
                              @nvt-regrouped |
                                mul(mul(n, v), t) = mul(n, mul(v, t))
                                [using specialize int_divides.mulIsAssociative(n, v, t)]
                              @x-is-a-n-vt |
                                x = power(a, mul(n, mul(v, t)))
                                [by rewrite nvt-regrouped x-is-a-nvt]
                              @n-power-of-power |
                                power(power(a, n), mul(v, t)) = power(a, mul(n, mul(v, t)))
                                [using specialize group_power.powerMul(a, n, mul(v, t))]
                              @a-n-vt-is-n-power |
                                power(a, mul(n, mul(v, t))) = power(power(a, n), mul(v, t))
                                [by symmetry n-power-of-power]
                              @x-is-n-power |
                                x = power(power(a, n), mul(v, t))
                                [using chain x-is-a-n-vt a-n-vt-is-n-power]
                              @conclusion-x-in-n |
                                inGenerated(power(a, n), x)
                                [by exists_intro(mul(v, t)) x-is-n-power]
                            }
                          @x-in-n |
                            inGenerated(power(a, n), x)
                            [by exists_elim with-n-cofactor-v]
                          @conclusion-x-in-both |
                            inGenerated(power(a, m), x) and inGenerated(power(a, n), x)
                            [by and_intro x-in-m x-in-n]
                        }
                      @conclusion-with-t |
                        inGenerated(power(a, m), x) and inGenerated(power(a, n), x)
                        [by exists_elim with-exponent-t]
                    }
                  @x-in-implies |
                    inGenerated(power(a, lcm(m, n)), x) -> (inGenerated(power(a, m), x) and inGenerated(power(a, n), x))
                    [by implies_intro given-x-in]
                }
              @discharge-x |
                forall x: Grp; inGenerated(power(a, lcm(m, n)), x) -> (inGenerated(power(a, m), x) and inGenerated(power(a, n), x))
                [by forall_intro generalize-x]
            }
          @discharge-n |
            forall n: Int; forall x: Grp; inGenerated(power(a, lcm(m, n)), x) -> (inGenerated(power(a, m), x) and inGenerated(power(a, n), x))
            [by forall_intro generalize-n]
        }
      @discharge-m |
        forall m, n: Int; forall x: Grp; inGenerated(power(a, lcm(m, n)), x) -> (inGenerated(power(a, m), x) and inGenerated(power(a, n), x))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall a: Grp; forall m, n: Int; forall x: Grp; inGenerated(power(a, lcm(m, n)), x) -> (inGenerated(power(a, m), x) and inGenerated(power(a, n), x))
    [by forall_intro generalize-a]
qed

// for a of infinite order, a^(mi) = a^(nj) forces mi = nj: a^(mi − nj) = e, so mi − nj = 0.
theorem equalPowersHaveEqualExponents: forall a: Grp; hasInfiniteOrder(a) -> forall s, t: Int; power(a, s) = power(a, t) -> s = t
proof
  @generalize-a |
    fix a: Grp {
      @given-infinite |
        assume hasInfiniteOrder(a) {
          @infinite |
            forall k: Int; power(a, k) = E -> k = ZERO
            [by hypothesis given-infinite]
          @generalize-s |
            fix s: Int {
              @generalize-t |
                fix t: Int {
                  @given-powers-equal |
                    assume power(a, s) = power(a, t) {
                      @powers-equal |
                        power(a, s) = power(a, t)
                        [by hypothesis given-powers-equal]
                      @difference-power |
                        op(power(a, s), power(a, neg(t))) = power(a, add(s, neg(t)))
                        [using specialize group_power.powerAdd(a, s, neg(t))]
                      @negated-power |
                        power(a, neg(t)) = inverse(power(a, t))
                        [using specialize group_power.powerNegInverse(a, t)]
                      @difference-power-as-product |
                        op(power(a, s), inverse(power(a, t))) = power(a, add(s, neg(t)))
                        [by rewrite negated-power difference-power]
                      @difference-power-cancels |
                        op(power(a, t), inverse(power(a, t))) = power(a, add(s, neg(t)))
                        [by rewrite powers-equal difference-power-as-product]
                      @t-power-times-inverse |
                        op(power(a, t), inverse(power(a, t))) = E
                        [using specialize group_power.opInverseRight(power(a, t))]
                      @identity-is-product |
                        E = op(power(a, t), inverse(power(a, t)))
                        [by symmetry t-power-times-inverse]
                      @identity-is-difference-power |
                        E = power(a, add(s, neg(t)))
                        [using chain identity-is-product difference-power-cancels]
                      @difference-power-is-identity |
                        power(a, add(s, neg(t))) = E
                        [by symmetry identity-is-difference-power]
                      @difference-is-zero |
                        add(s, neg(t)) = ZERO
                        [using specialize infinite(add(s, neg(t))) difference-power-is-identity]
                      @s-recovered |
                        s = add(add(s, neg(t)), t)
                        [using polynomial(integer)]
                      @s-is-zero-plus-t |
                        s = add(ZERO, t)
                        [by rewrite difference-is-zero s-recovered]
                      @zero-plus-t |
                        add(ZERO, t) = t
                        [using specialize int_divides.addZeroLeft(t)]
                      @conclusion-exponents-equal |
                        s = t
                        [using chain s-is-zero-plus-t zero-plus-t]
                    }
                  @powers-equal-implies |
                    power(a, s) = power(a, t) -> s = t
                    [by implies_intro given-powers-equal]
                }
              @discharge-t |
                forall t: Int; power(a, s) = power(a, t) -> s = t
                [by forall_intro generalize-t]
            }
          @discharge-s |
            forall s, t: Int; power(a, s) = power(a, t) -> s = t
            [by forall_intro generalize-s]
        }
      @infinite-implies |
        hasInfiniteOrder(a) -> forall s, t: Int; power(a, s) = power(a, t) -> s = t
        [by implies_intro given-infinite]
    }
  @conclusion |
    forall a: Grp; hasInfiniteOrder(a) -> forall s, t: Int; power(a, s) = power(a, t) -> s = t
    [by forall_intro generalize-a]
qed

// for a of infinite order: ⟨a^m⟩ ∩ ⟨a^n⟩ = ⟨a^lcm(m, n)⟩.
theorem intersectionOfPowerSubgroupsIsLcmSubgroup: forall a: Grp; hasInfiniteOrder(a) -> forall m, n: Int; forall x: Grp; (inGenerated(power(a, m), x) and inGenerated(power(a, n), x)) iff inGenerated(power(a, lcm(m, n)), x)
proof
  @generalize-a |
    fix a: Grp {
      @given-infinite |
        assume hasInfiniteOrder(a) {
          @infinite |
            hasInfiniteOrder(a)
            [by hypothesis given-infinite]
          @generalize-m |
            fix m: Int {
              @generalize-n |
                fix n: Int {
                  @generalize-x |
                    fix x: Grp {
                      @given-x-in-both |
                        assume inGenerated(power(a, m), x) and inGenerated(power(a, n), x) {
                          @x-in-both |
                            inGenerated(power(a, m), x) and inGenerated(power(a, n), x)
                            [by hypothesis given-x-in-both]
                          @x-in-m |
                            exists k: Int; x = power(power(a, m), k)
                            [by and_elim_left x-in-both]
                          @x-in-n |
                            exists k: Int; x = power(power(a, n), k)
                            [by and_elim_right x-in-both]
                          @with-m-exponent-i |
                            unpack i: Int from x-in-m {
                              @x-is-m-power |
                                x = power(power(a, m), i)
                                [by hypothesis with-m-exponent-i]
                              @m-power-of-power |
                                power(power(a, m), i) = power(a, mul(m, i))
                                [using specialize group_power.powerMul(a, m, i)]
                              @x-is-a-mi |
                                x = power(a, mul(m, i))
                                [using chain x-is-m-power m-power-of-power]
                              @with-n-exponent-j |
                                unpack j: Int from x-in-n {
                                  @x-is-n-power |
                                    x = power(power(a, n), j)
                                    [by hypothesis with-n-exponent-j]
                                  @n-power-of-power |
                                    power(power(a, n), j) = power(a, mul(n, j))
                                    [using specialize group_power.powerMul(a, n, j)]
                                  @x-is-a-nj |
                                    x = power(a, mul(n, j))
                                    [using chain x-is-n-power n-power-of-power]
                                  @a-mi-is-x |
                                    power(a, mul(m, i)) = x
                                    [by symmetry x-is-a-mi]
                                  @powers-equal |
                                    power(a, mul(m, i)) = power(a, mul(n, j))
                                    [using chain a-mi-is-x x-is-a-nj]
                                  @exponents-equal |
                                    mul(m, i) = mul(n, j)
                                    [using specialize equalPowersHaveEqualExponents(a, mul(m, i), mul(n, j)) infinite powers-equal]
                                  // mi is a common multiple of m and n, so lcm | mi.
                                  @mi-reflexive |
                                    mul(m, i) = mul(m, i)
                                    [by reflexivity]
                                  @m-divides-mi |
                                    divides(m, mul(m, i))
                                    [using specialize int_divides.dividesIntro(mul(m, i), m, i) mi-reflexive]
                                  @nj-reflexive |
                                    mul(n, j) = mul(n, j)
                                    [by reflexivity]
                                  @n-divides-nj |
                                    divides(n, mul(n, j))
                                    [using specialize int_divides.dividesIntro(mul(n, j), n, j) nj-reflexive]
                                  @n-divides-mi |
                                    divides(n, mul(m, i))
                                    [by rewrite exponents-equal n-divides-nj]
                                  @lcm-divides-mi |
                                    divides(lcm(m, n), mul(m, i))
                                    [using specialize int_divides.lcmLeast(m, n, mul(m, i)) m-divides-mi n-divides-mi]
                                  @with-lcm-cofactor-t |
                                    unpack t: Int from lcm-divides-mi {
                                      @mi-is-lcm-t |
                                        mul(m, i) = mul(lcm(m, n), t)
                                        [by hypothesis with-lcm-cofactor-t]
                                      @x-is-a-lcm-t |
                                        x = power(a, mul(lcm(m, n), t))
                                        [by rewrite mi-is-lcm-t x-is-a-mi]
                                      @lcm-power-of-power |
                                        power(power(a, lcm(m, n)), t) = power(a, mul(lcm(m, n), t))
                                        [using specialize group_power.powerMul(a, lcm(m, n), t)]
                                      @a-lcm-t-is-lcm-power |
                                        power(a, mul(lcm(m, n), t)) = power(power(a, lcm(m, n)), t)
                                        [by symmetry lcm-power-of-power]
                                      @x-is-lcm-power |
                                        x = power(power(a, lcm(m, n)), t)
                                        [using chain x-is-a-lcm-t a-lcm-t-is-lcm-power]
                                      @conclusion-x-in-lcm |
                                        inGenerated(power(a, lcm(m, n)), x)
                                        [by exists_intro(t) x-is-lcm-power]
                                    }
                                  @conclusion-with-t |
                                    inGenerated(power(a, lcm(m, n)), x)
                                    [by exists_elim with-lcm-cofactor-t]
                                }
                              @conclusion-with-j |
                                inGenerated(power(a, lcm(m, n)), x)
                                [by exists_elim with-n-exponent-j]
                            }
                          @conclusion-with-i |
                            inGenerated(power(a, lcm(m, n)), x)
                            [by exists_elim with-m-exponent-i]
                        }
                      @forward |
                        (inGenerated(power(a, m), x) and inGenerated(power(a, n), x)) -> inGenerated(power(a, lcm(m, n)), x)
                        [by implies_intro given-x-in-both]
                      @backward |
                        inGenerated(power(a, lcm(m, n)), x) -> (inGenerated(power(a, m), x) and inGenerated(power(a, n), x))
                        [using specialize lcmPowerIsInBothSubgroups(a, m, n, x)]
                      @conclusion-iff |
                        (inGenerated(power(a, m), x) and inGenerated(power(a, n), x)) iff inGenerated(power(a, lcm(m, n)), x)
                        [by iff_intro forward backward]
                    }
                  @discharge-x |
                    forall x: Grp; (inGenerated(power(a, m), x) and inGenerated(power(a, n), x)) iff inGenerated(power(a, lcm(m, n)), x)
                    [by forall_intro generalize-x]
                }
              @discharge-n |
                forall n: Int; forall x: Grp; (inGenerated(power(a, m), x) and inGenerated(power(a, n), x)) iff inGenerated(power(a, lcm(m, n)), x)
                [by forall_intro generalize-n]
            }
          @discharge-m |
            forall m, n: Int; forall x: Grp; (inGenerated(power(a, m), x) and inGenerated(power(a, n), x)) iff inGenerated(power(a, lcm(m, n)), x)
            [by forall_intro generalize-m]
        }
      @infinite-implies |
        hasInfiniteOrder(a) -> forall m, n: Int; forall x: Grp; (inGenerated(power(a, m), x) and inGenerated(power(a, n), x)) iff inGenerated(power(a, lcm(m, n)), x)
        [by implies_intro given-infinite]
    }
  @conclusion |
    forall a: Grp; hasInfiniteOrder(a) -> forall m, n: Int; forall x: Grp; (inGenerated(power(a, m), x) and inGenerated(power(a, n), x)) iff inGenerated(power(a, lcm(m, n)), x)
    [by forall_intro generalize-a]
qed
