// Worked examples for `std/group/sequence.b4m`'s sequence-BUILDING postulates.
//
// Why this file exists: `seqSingleton`, `seqPrepend`, `seqConcat`, `seqReverse` and
// `seqRemove` assert that a sequence with given entries EXISTS. Nothing in
// `sequence.b4m` itself derives from them — the n-ary inverse law is an induction on
// `productUpTo` alone — so without this file they are five postulates no proof ever
// eliminates, and an existential whose witness is never unpacked is one whose shape has
// never been checked. Each theorem below unpacks one, at the smallest scale that needs it.
//
// They also carry the `GroupSeq` model's obligations for the same-named axioms of
// std/sequence.b4m (a model DISCHARGES a source theory's axioms rather than inheriting
// them), which is what lets a caller reach them through the model.
import group_sequence <<< "std/group/sequence.b4m"
import group <<< "std/group.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

sort Grp = group.Grp
const E = group.E
func op = group.op
func inverse = group.inverse
theorem opIdentityRight = group.opIdentityRight

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
func sub = peano.sub
pred less_than = peano.less_than

sort Seq = group_sequence.Seq
func at = group_sequence.at
func productUpTo = group_sequence.productUpTo
func revProductUpTo = group_sequence.revProductUpTo
axiom seqSingleton = group_sequence.seqSingleton
axiom seqPrepend = group_sequence.seqPrepend
axiom seqConcat = group_sequence.seqConcat
axiom seqReverse = group_sequence.seqReverse
axiom seqRemove = group_sequence.seqRemove

// SINGLETON: every element is the one-entry product of some sequence.
theorem everyElementIsASingletonProduct: forall x: Grp; exists s: Seq; productUpTo(s, succ(ZERO)) = x
proof
  @generalize-x |
    fix x: Grp {
      @the-singleton-exists |
        exists s: Seq; at(s, ZERO) = x and productUpTo(s, succ(ZERO)) = x
        [using specialize seqSingleton(x)]
      @with-singleton |
        unpack s: Seq from the-singleton-exists {
          @singleton-facts |
            at(s, ZERO) = x and productUpTo(s, succ(ZERO)) = x
            [by hypothesis with-singleton]
          @singleton-product |
            productUpTo(s, succ(ZERO)) = x
            [by and_elim_right singleton-facts]
          @conclusion-witness |
            exists s2: Seq; productUpTo(s2, succ(ZERO)) = x
            [by exists_intro(s) singleton-product]
        }
      @conclusion-for-x |
        exists s2: Seq; productUpTo(s2, succ(ZERO)) = x
        [by exists_elim with-singleton]
    }
  @conclusion |
    forall x: Grp; exists s: Seq; productUpTo(s, succ(ZERO)) = x
    [by forall_intro generalize-x]
qed

// PREPEND: x :: s puts x at the head and shifts s up by one.
theorem prependPutsTheHeadFirst: forall x: Grp; forall s: Seq;
  exists u: Seq; at(u, ZERO) = x and at(u, succ(ZERO)) = at(s, ZERO)
proof
  @generalize-x |
    fix x: Grp {
      @generalize-s |
        fix s: Seq {
          @the-prepend-exists |
            exists u: Seq; at(u, ZERO) = x and (forall i: Nat; at(u, succ(i)) = at(s, i))
            [using specialize seqPrepend(x, s)]
          @with-prepend |
            unpack u: Seq from the-prepend-exists {
              @prepend-facts |
                at(u, ZERO) = x and (forall i: Nat; at(u, succ(i)) = at(s, i))
                [by hypothesis with-prepend]
              @head-is-x |
                at(u, ZERO) = x
                [by and_elim_left prepend-facts]
              @tail-shifts |
                forall i: Nat; at(u, succ(i)) = at(s, i)
                [by and_elim_right prepend-facts]
              @second-is-the-old-first |
                at(u, succ(ZERO)) = at(s, ZERO)
                [using specialize tail-shifts(ZERO)]
              @both-halves |
                at(u, ZERO) = x and at(u, succ(ZERO)) = at(s, ZERO)
                [by and_intro head-is-x second-is-the-old-first]
              @conclusion-witness |
                exists u2: Seq; at(u2, ZERO) = x and at(u2, succ(ZERO)) = at(s, ZERO)
                [by exists_intro(u) both-halves]
            }
          @conclusion-for-s |
            exists u2: Seq; at(u2, ZERO) = x and at(u2, succ(ZERO)) = at(s, ZERO)
            [by exists_elim with-prepend]
        }
      @discharge-s |
        forall s: Seq; exists u2: Seq; at(u2, ZERO) = x and at(u2, succ(ZERO)) = at(s, ZERO)
        [by forall_intro generalize-s]
    }
  @conclusion |
    forall x: Grp; forall s: Seq; exists u: Seq; at(u, ZERO) = x and at(u, succ(ZERO)) = at(s, ZERO)
    [by forall_intro generalize-x]
qed

// CONCATENATION: joining nothing on the right leaves the product alone.
theorem concatenatingNothingKeepsTheProduct: forall s: Seq; forall t: Seq; forall j: Nat;
  exists u: Seq; productUpTo(u, add(j, ZERO)) = productUpTo(s, j)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-t |
        fix t: Seq {
          @generalize-j |
            fix j: Nat {
              @the-join-exists |
                exists u: Seq;
                  (forall i: Nat; less_than(i, j) -> at(u, i) = at(s, i))
                  and (forall i: Nat; less_than(i, ZERO) -> at(u, add(j, i)) = at(t, i))
                  and productUpTo(u, add(j, ZERO)) = op(productUpTo(s, j), productUpTo(t, ZERO))
                [using specialize seqConcat(s, t, j, ZERO)]
              @with-join |
                unpack u: Seq from the-join-exists {
                  @join-facts |
                    (forall i: Nat; less_than(i, j) -> at(u, i) = at(s, i))
                      and (forall i: Nat; less_than(i, ZERO) -> at(u, add(j, i)) = at(t, i))
                      and productUpTo(u, add(j, ZERO)) = op(productUpTo(s, j), productUpTo(t, ZERO))
                    [by hypothesis with-join]
                  @join-product |
                    productUpTo(u, add(j, ZERO)) = op(productUpTo(s, j), productUpTo(t, ZERO))
                    [by and_elim_right join-facts]
                  @empty-piece-is-the-identity |
                    productUpTo(t, ZERO) = E
                    [using specialize group_sequence.productUpToZero(t)]
                  @join-is-s-times-identity |
                    productUpTo(u, add(j, ZERO)) = op(productUpTo(s, j), E)
                    [by rewrite empty-piece-is-the-identity join-product]
                  @identity-on-the-right |
                    op(productUpTo(s, j), E) = productUpTo(s, j)
                    [using specialize opIdentityRight(productUpTo(s, j))]
                  @join-is-s |
                    productUpTo(u, add(j, ZERO)) = productUpTo(s, j)
                    [using chain join-is-s-times-identity identity-on-the-right]
                  @conclusion-witness |
                    exists u2: Seq; productUpTo(u2, add(j, ZERO)) = productUpTo(s, j)
                    [by exists_intro(u) join-is-s]
                }
              @conclusion-for-j |
                exists u2: Seq; productUpTo(u2, add(j, ZERO)) = productUpTo(s, j)
                [by exists_elim with-join]
            }
          @discharge-j |
            forall j: Nat; exists u2: Seq; productUpTo(u2, add(j, ZERO)) = productUpTo(s, j)
            [by forall_intro generalize-j]
        }
      @discharge-t |
        forall t: Seq; forall j: Nat; exists u2: Seq; productUpTo(u2, add(j, ZERO)) = productUpTo(s, j)
        [by forall_intro generalize-t]
    }
  @conclusion |
    forall s: Seq; forall t: Seq; forall j: Nat; exists u: Seq; productUpTo(u, add(j, ZERO)) = productUpTo(s, j)
    [by forall_intro generalize-s]
qed

// REVERSAL: the reversed sequence's product is the reversed product of inverses — which,
// by `invOfProduct`, is the original product's inverse.
theorem reversalProducesTheInverse: forall s: Seq; forall n: Nat;
  exists r: Seq; productUpTo(r, n) = inverse(productUpTo(s, n))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-n |
        fix n: Nat {
          @the-reversal-exists |
            exists r: Seq;
              (forall i: Nat; less_than(i, n) -> at(r, i) = at(s, sub(n, succ(i))))
              and productUpTo(r, n) = revProductUpTo(s, n)
            [using specialize seqReverse(s, n)]
          @with-reversal |
            unpack r: Seq from the-reversal-exists {
              @reversal-facts |
                (forall i: Nat; less_than(i, n) -> at(r, i) = at(s, sub(n, succ(i))))
                  and productUpTo(r, n) = revProductUpTo(s, n)
                [by hypothesis with-reversal]
              @reversal-product |
                productUpTo(r, n) = revProductUpTo(s, n)
                [by and_elim_right reversal-facts]
              @reversed-product-is-the-inverse |
                inverse(productUpTo(s, n)) = revProductUpTo(s, n)
                [using specialize group_sequence.invOfProduct(s, n)]
              @reversal-is-the-inverse |
                productUpTo(r, n) = inverse(productUpTo(s, n))
                [using chain reversal-product reversed-product-is-the-inverse]
              @conclusion-witness |
                exists r2: Seq; productUpTo(r2, n) = inverse(productUpTo(s, n))
                [by exists_intro(r) reversal-is-the-inverse]
            }
          @conclusion-for-n |
            exists r2: Seq; productUpTo(r2, n) = inverse(productUpTo(s, n))
            [by exists_elim with-reversal]
        }
      @discharge-n |
        forall n: Nat; exists r2: Seq; productUpTo(r2, n) = inverse(productUpTo(s, n))
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall s: Seq; forall n: Nat; exists r: Seq; productUpTo(r, n) = inverse(productUpTo(s, n))
    [by forall_intro generalize-s]
qed

// REMOVAL: deleting the last entry of a length-(k+1) product leaves a length-k product
// that recovers the whole when the removed entry is multiplied back on.
theorem removingAnEntryRecoversTheProduct: forall s: Seq; forall k: Nat;
  exists t: Seq; op(productUpTo(t, k), at(s, k)) = productUpTo(s, succ(k))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-k |
        fix k: Nat {
          @k-is-below-its-successor |
            less_than(k, succ(k))
            [using specialize peano_order.lessThanSelf(k)]
          @the-removal-exists |
            exists t: Seq;
              op(productUpTo(t, k), at(s, k)) = productUpTo(s, succ(k))
              and (forall i: Nat; less_than(i, k) -> at(t, i) = at(s, i))
              and (forall i: Nat; peano.less_or_equal(k, i) -> less_than(i, k) -> at(t, i) = at(s, succ(i)))
            [using specialize seqRemove(s, k, k) k-is-below-its-successor]
          @with-removal |
            unpack t: Seq from the-removal-exists {
              @removal-facts |
                op(productUpTo(t, k), at(s, k)) = productUpTo(s, succ(k))
                  and (forall i: Nat; less_than(i, k) -> at(t, i) = at(s, i))
                  and (forall i: Nat; peano.less_or_equal(k, i) -> less_than(i, k) -> at(t, i) = at(s, succ(i)))
                [by hypothesis with-removal]
              @removal-pair |
                op(productUpTo(t, k), at(s, k)) = productUpTo(s, succ(k))
                  and (forall i: Nat; less_than(i, k) -> at(t, i) = at(s, i))
                [by and_elim_left removal-facts]
              @removal-product |
                op(productUpTo(t, k), at(s, k)) = productUpTo(s, succ(k))
                [by and_elim_left removal-pair]
              @conclusion-witness |
                exists t2: Seq; op(productUpTo(t2, k), at(s, k)) = productUpTo(s, succ(k))
                [by exists_intro(t) removal-product]
            }
          @conclusion-for-k |
            exists t2: Seq; op(productUpTo(t2, k), at(s, k)) = productUpTo(s, succ(k))
            [by exists_elim with-removal]
        }
      @discharge-k |
        forall k: Nat; exists t2: Seq; op(productUpTo(t2, k), at(s, k)) = productUpTo(s, succ(k))
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall s: Seq; forall k: Nat; exists t: Seq; op(productUpTo(t, k), at(s, k)) = productUpTo(s, succ(k))
    [by forall_intro generalize-s]
qed
