// std/group/order.b4m — the ORDER of a group element.
//
// For a fixed element A of order N (the smallest POSITIVE integer with A^N = e), this
// file proves Judson's cyclic-order results (AATA §4.1):
//   • A^k = e  ⟺  N | k  (cyclic-proposition-subgrp-order).
// The order is axiomatized as a positive constant N that kills A and is minimal among
// positive exponents (the smallest-positive-n characterization; existence of such an N
// for a finite-order element is the well-ordering fact, kept as the defining axioms
// here). Powers are std/group/power.b4m over ℤ exponents; divisibility and the division
// algorithm are std/integer/divides.b4m.

import group_power <<< "std/group/power.b4m"
import int_divides <<< "std/integer/divides.b4m"
import integer <<< "std/integer.b4m"
import group <<< "std/group.b4m"

sort Grp = group_power.Grp
const E = group_power.E
func op = group_power.op
func inverse = group_power.inverse
func power = group_power.power

sort Int = group_power.Int
const ZERO = group_power.ZERO
const ONE = integer.ONE
func add = group_power.add
func mul = group_power.mul
func succ = integer.succ
func prev = integer.prev
theorem intInduction = group_power.induction
pred less_than = int_divides.less_than
pred is_nonneg = int_divides.is_nonneg
axiom lessThanIntro = integer.lessThanIntro
axiom nonnegZero = integer.nonnegZero
axiom nonnegSucc = integer.nonnegSucc
axiom addZeroLeft = integer.addZeroLeft
theorem noPositiveBelowOne = integer.noPositiveBelowOne
theorem positiveBelowTwoIsOne = integer.positiveBelowTwoIsOne
axiom powerZero = group_power.powerZero
axiom powerSucc = group_power.powerSucc
theorem powerOne = group_power.powerOne
theorem powerOfIdentity = group_power.powerOfIdentity
axiom opIdentityLeft = group.opIdentityLeft
define divides(d, n) = exists k: Int; n = mul(d, k)

// the element A and its order N: N is positive, kills A, and is the least positive such.
const A: Grp
const N: Int
axiom orderPositive: less_than(ZERO, N)
axiom orderKills: power(A, N) = E
axiom orderMinimal: forall m: Int; less_than(ZERO, m) -> less_than(m, N) -> power(A, m) != E

// A^(N·s) = e for any s: (A^N)^s = e^s = e.
theorem powerKillsMultiple: forall s: Int; power(A, mul(N, s)) = E
proof
  @generalize-s |
    fix s: Int {
      // A^(N·s) = (A^N)^s.
      @power-mul |
        power(power(A, N), s) = power(A, mul(N, s))
        [using specialize group_power.powerMul(A, N, s)]
      @power-mul-flipped |
        power(A, mul(N, s)) = power(power(A, N), s)
        [by symmetry power-mul]
      // A^N = e, so (A^N)^s = e^s.
      @an-is-e |
        power(A, N) = E
        [by cite orderKills]
      @base-is-e-power |
        power(power(A, N), s) = power(E, s)
        [by rewrite an-is-e power-mul-reflexive]
      @power-mul-reflexive |
        power(power(A, N), s) = power(power(A, N), s)
        [by reflexivity]
      // e^s = e (identity to any power).
      @identity-power |
        power(E, s) = E
        [using specialize group_power.powerOfIdentity(s)]
      @conclusion-kills |
        power(A, mul(N, s)) = E
        [using chain power-mul-flipped base-is-e-power identity-power]
    }
  @conclusion |
    forall s: Int; power(A, mul(N, s)) = E
    [by forall_intro generalize-s]
qed

// backward direction: N | k ⟹ A^k = e.
theorem multipleKillsA: forall k: Int; divides(N, k) -> power(A, k) = E
proof
  @generalize-k |
    fix k: Int {
      @given-divides |
        assume divides(N, k) {
          @n-divides-k |
            exists s: Int; k = mul(N, s)
            [by hypothesis given-divides]
          @with-quotient |
            unpack s: Int from n-divides-k {
              @k-is-multiple |
                k = mul(N, s)
                [by hypothesis with-quotient]
              @multiple-kills |
                power(A, mul(N, s)) = E
                [using specialize powerKillsMultiple(s)]
              @conclusion-kills |
                power(A, k) = E
                [by rewrite k-is-multiple multiple-kills]
            }
          @conclusion-with |
            power(A, k) = E
            [by exists_elim with-quotient]
        }
      @divides-implies-kills |
        divides(N, k) -> power(A, k) = E
        [by implies_intro given-divides]
    }
  @conclusion |
    forall k: Int; divides(N, k) -> power(A, k) = E
    [by forall_intro generalize-k]
qed

// forward direction: A^k = e ⟹ N | k. Division algorithm k = N·q + r with 0 ≤ r < N;
// then A^r = A^k·(A^(Nq))⁻¹-style collapse gives A^r = A^k = e, and minimality of N
// forces r = 0, so k = N·q.
theorem killedExponentIsMultiple: forall k: Int; power(A, k) = E -> divides(N, k)
proof
  @generalize-k |
    fix k: Int {
      @given-killed |
        assume power(A, k) = E {
          @a-k-is-e |
            power(A, k) = E
            [by hypothesis given-killed]
          @n-positive |
            less_than(ZERO, N)
            [by cite orderPositive]
          // division algorithm: k = N·q + r, 0 ≤ r < N.
          @div-alg |
            exists q: Int; exists r: Int; k = add(mul(N, q), r) and is_nonneg(r) and less_than(r, N)
            [using specialize int_divides.divisionAlgorithmExists(k, N) n-positive]
          @with-quotient |
            unpack q: Int from div-alg {
              @remainder-exists |
                exists r: Int; k = add(mul(N, q), r) and is_nonneg(r) and less_than(r, N)
                [by hypothesis with-quotient]
              @with-remainder |
                unpack r: Int from remainder-exists {
                  @div-facts |
                    k = add(mul(N, q), r) and is_nonneg(r) and less_than(r, N)
                    [by hypothesis with-remainder]
                  @k-decomposes |
                    k = add(mul(N, q), r)
                    [using tautology div-facts]
                  @r-nonneg |
                    is_nonneg(r)
                    [using tautology div-facts]
                  @r-less-n |
                    less_than(r, N)
                    [using tautology div-facts]
                  // A^k = A^(Nq + r) = A^(Nq)·A^r = e·A^r = A^r.
                  @power-add |
                    op(power(A, mul(N, q)), power(A, r)) = power(A, add(mul(N, q), r))
                    [using specialize group_power.powerAdd(A, mul(N, q), r)]
                  @nq-kills |
                    power(A, mul(N, q)) = E
                    [using specialize powerKillsMultiple(q)]
                  @product-with-e |
                    op(E, power(A, r)) = power(A, add(mul(N, q), r))
                    [by rewrite nq-kills power-add]
                  @e-times-ar |
                    op(E, power(A, r)) = power(A, r)
                    [using specialize group_power.opIdentityLeft(power(A, r))]
                  @ar-is-k-power |
                    power(A, r) = power(A, add(mul(N, q), r))
                    [using chain e-times-ar product-with-e]
                  // A^(Nq+r) = e (rewrite k = Nq+r into A^k = e), then A^r = A^(Nq+r) = e.
                  @decomposed-power-is-e |
                    power(A, add(mul(N, q), r)) = E
                    [by rewrite k-decomposes a-k-is-e]
                  // minimality: r < N and A^r = e force r not positive; with r ≥ 0, r = 0.
                  @given-r-positive |
                    assume less_than(ZERO, r) {
                      @r-positive |
                        less_than(ZERO, r)
                        [by hypothesis given-r-positive]
                      @a-r-nonzero |
                        power(A, r) != E
                        [using specialize orderMinimal(r) r-positive r-less-n]
                      @a-r-is-e-inside |
                        power(A, r) = E
                        [using chain ar-is-k-power decomposed-power-is-e]
                    }
                  @r-not-positive |
                    not less_than(ZERO, r)
                    [by not_intro given-r-positive a-r-is-e-inside a-r-nonzero]
                  @r-is-zero |
                    r = ZERO
                    [using specialize int_divides.nonnegNotPositiveIsZero(r) r-nonneg r-not-positive]
                  // so k = N·q + 0 = N·q, hence N | k.
                  @k-is-nq |
                    k = add(mul(N, q), ZERO)
                    [by rewrite r-is-zero k-decomposes]
                  @nq-plus-zero |
                    add(mul(N, q), ZERO) = mul(N, q)
                    [using specialize integer.addZeroRight(mul(N, q))]
                  @k-is-multiple |
                    k = mul(N, q)
                    [using chain k-is-nq nq-plus-zero]
                  @conclusion-divides |
                    divides(N, k)
                    [by exists_intro(q) k-is-multiple]
                }
              @conclusion-with-remainder |
                divides(N, k)
                [by exists_elim with-remainder]
            }
          @conclusion-with-quotient |
            divides(N, k)
            [by exists_elim with-quotient]
        }
      @killed-implies-divides |
        power(A, k) = E -> divides(N, k)
        [by implies_intro given-killed]
    }
  @conclusion |
    forall k: Int; power(A, k) = E -> divides(N, k)
    [by forall_intro generalize-k]
qed

// A^k = e ⟺ N | k (cyclic-proposition-subgrp-order).
theorem powerEqIdentityIffOrderDivides: forall k: Int; power(A, k) = E iff divides(N, k)
proof
  @generalize-k |
    fix k: Int {
      @forward |
        power(A, k) = E -> divides(N, k)
        [using specialize killedExponentIsMultiple(k)]
      @backward |
        divides(N, k) -> power(A, k) = E
        [using specialize multipleKillsA(k)]
      @conclusion-iff |
        power(A, k) = E iff divides(N, k)
        [by iff_intro forward backward]
    }
  @conclusion |
    forall k: Int; power(A, k) = E iff divides(N, k)
    [by forall_intro generalize-k]
qed

// -- REDUCING AN EXPONENT MODULO THE ORDER -----------------------------------------------------
// A^k = A^r where k = N·q + r and 0 ≤ r < N: the division algorithm on the exponent, then
// A^(Nq+r) = (A^N)^q · A^r = e^q · A^r = A^r. This is what makes the powers A⁰…A^(N−1) COVER
// the cyclic subgroup ⟨A⟩ — every power of A is one of them — and so what makes ⟨A⟩ a listing
// of length N (Judson's Corollary 6.7 route).
theorem everyPowerReducesBelowTheOrder: forall k: Int;
  exists r: Int; is_nonneg(r) and less_than(r, N) and power(A, k) = power(A, r)
proof
  @generalize-k |
    fix k: Int {
      @n-positive |
        less_than(ZERO, N)
        [by cite orderPositive]
      @k-decomposes |
        exists q: Int; exists r: Int; k = add(mul(N, q), r) and is_nonneg(r) and less_than(r, N)
        [using specialize int_divides.divisionAlgorithmExists(k, N) n-positive]
      @with-quotient |
        unpack q: Int from k-decomposes {
          @remainder-exists |
            exists r: Int; k = add(mul(N, q), r) and is_nonneg(r) and less_than(r, N)
            [by hypothesis with-quotient]
          @with-remainder |
            unpack r: Int from remainder-exists {
              @remainder-facts |
                k = add(mul(N, q), r) and is_nonneg(r) and less_than(r, N)
                [by hypothesis with-remainder]
              @k-is-decomposed |
                k = add(mul(N, q), r)
                [using tautology remainder-facts]
              @remainder-nonneg |
                is_nonneg(r)
                [using tautology remainder-facts]
              @remainder-below-order |
                less_than(r, N)
                [using tautology remainder-facts]
              // A^(Nq) = (A^N)^q = e^q = e
              @power-splits |
                op(power(A, mul(N, q)), power(A, r)) = power(A, add(mul(N, q), r))
                [using specialize group_power.powerAdd(A, mul(N, q), r)]
              @nq-power-is-iterated |
                power(power(A, N), q) = power(A, mul(N, q))
                [using specialize group_power.powerMul(A, N, q)]
              @order-kills-a |
                power(A, N) = E
                [by cite orderKills]
              @identity-power-is-identity |
                power(E, q) = E
                [using specialize group_power.powerOfIdentity(q)]
              @iterated-is-identity |
                power(power(A, N), q) = E
                [by rewrite order-kills-a identity-power-is-identity]
              @nq-power-is-identity |
                power(A, mul(N, q)) = E
                [using chain nq-power-is-iterated-flipped iterated-is-identity]
              @nq-power-is-iterated-flipped |
                power(A, mul(N, q)) = power(power(A, N), q)
                [by symmetry nq-power-is-iterated]
              // so A^k = A^(Nq+r) = A^(Nq)·A^r = e·A^r = A^r
              @identity-times-remainder |
                op(E, power(A, r)) = power(A, r)
                [using specialize opIdentityLeft(power(A, r))]
              @split-with-identity |
                op(E, power(A, r)) = power(A, add(mul(N, q), r))
                [by rewrite nq-power-is-identity power-splits]
              @decomposed-power-is-remainder |
                power(A, add(mul(N, q), r)) = power(A, r)
                [using chain split-with-identity-flipped identity-times-remainder]
              @split-with-identity-flipped |
                power(A, add(mul(N, q), r)) = op(E, power(A, r))
                [by symmetry split-with-identity]
              @k-power-is-remainder-power |
                power(A, k) = power(A, r)
                [by rewrite k-is-decomposed decomposed-power-is-remainder]
              @witnessed |
                is_nonneg(r) and less_than(r, N) and power(A, k) = power(A, r)
                [using tautology remainder-nonneg remainder-below-order k-power-is-remainder-power]
              @conclusion-reduced |
                exists r2: Int; is_nonneg(r2) and less_than(r2, N) and power(A, k) = power(A, r2)
                [by exists_intro(r) witnessed]
            }
          @conclusion-with-remainder |
            exists r: Int; is_nonneg(r) and less_than(r, N) and power(A, k) = power(A, r)
            [by exists_elim with-remainder]
        }
      @conclusion-with-quotient |
        exists r: Int; is_nonneg(r) and less_than(r, N) and power(A, k) = power(A, r)
        [by exists_elim with-quotient]
    }
  @conclusion |
    forall k: Int; exists r: Int; is_nonneg(r) and less_than(r, N) and power(A, k) = power(A, r)
    [by forall_intro generalize-k]
qed


// -- order of a power: ord(A^k) = N / gcd(k, N) (cyclic-theorem-cyclic-orders) ------
// std form (not tied to Judson's `n/d` notation): write d = gcd(k, N), and let the
// cofactors K = k/d, M = N/d be given by k = d·K, N = d·M. Then M is the order of A^k:
// it kills A^k and is minimal. Coprimality of K and M (= k/d, N/d) is supplied as a
// Bézout identity k·P + N·Q = d (the gcd's Bézout identity), from which K·P + M·Q = 1
// follows by cancelling d — this is where "d = gcd" enters. The aata §4.1 file maps
// M back to n/d in prose.

// (a) M kills A^k: (A^k)^M = A^(kM) = A^(K·(d·M)) = A^(K·N) = (A^N)^K = e.
theorem powerCofactorKills: forall d, cofactorK, cofactorM: Int; N = mul(d, cofactorM) -> power(power(A, mul(d, cofactorK)), cofactorM) = E
proof
  @generalize-d |
    fix d: Int {
      @generalize-cofactorK |
        fix cofactorK: Int {
          @generalize-cofactorM |
            fix cofactorM: Int {
              @given-n-split |
                assume N = mul(d, cofactorM) {
                  @n-split |
                    N = mul(d, cofactorM)
                    [by hypothesis given-n-split]
                  // (A^k)^M = A^(k·M) where k = d·K.
                  @power-mul |
                    power(power(A, mul(d, cofactorK)), cofactorM) = power(A, mul(mul(d, cofactorK), cofactorM))
                    [using specialize group_power.powerMul(A, mul(d, cofactorK), cofactorM)]
                  // k·M = (d·K)·M = K·(d·M) = K·N.
                  @exponent-regroups |
                    mul(mul(d, cofactorK), cofactorM) = mul(cofactorK, mul(d, cofactorM))
                    [using polynomial(integer)]
                  @exponent-with-n |
                    mul(mul(d, cofactorK), cofactorM) = mul(cofactorK, N)
                    [by rewrite n-split exponent-regroups]
                  @power-at-kn |
                    power(power(A, mul(d, cofactorK)), cofactorM) = power(A, mul(cofactorK, N))
                    [using chain power-mul exponent-with-n]
                  // A^(K·N) = A^(N·K) = e.
                  @kn-is-nk |
                    mul(cofactorK, N) = mul(N, cofactorK)
                    [using specialize integer.mulIsCommutative(cofactorK, N)]
                  @power-at-nk |
                    power(power(A, mul(d, cofactorK)), cofactorM) = power(A, mul(N, cofactorK))
                    [using chain power-at-kn kn-is-nk]
                  @nk-kills |
                    power(A, mul(N, cofactorK)) = E
                    [using specialize powerKillsMultiple(cofactorK)]
                  @conclusion-kills |
                    power(power(A, mul(d, cofactorK)), cofactorM) = E
                    [using chain power-at-nk nk-kills]
                }
              @n-split-implies |
                N = mul(d, cofactorM) -> power(power(A, mul(d, cofactorK)), cofactorM) = E
                [by implies_intro given-n-split]
            }
          @discharge-cofactorM |
            forall cofactorM: Int; N = mul(d, cofactorM) -> power(power(A, mul(d, cofactorK)), cofactorM) = E
            [by forall_intro generalize-cofactorM]
        }
      @discharge-cofactorK |
        forall cofactorK, cofactorM: Int; N = mul(d, cofactorM) -> power(power(A, mul(d, cofactorK)), cofactorM) = E
        [by forall_intro generalize-cofactorK]
    }
  @conclusion |
    forall d, cofactorK, cofactorM: Int; N = mul(d, cofactorM) -> power(power(A, mul(d, cofactorK)), cofactorM) = E
    [by forall_intro generalize-d]
qed

// (b) M is minimal: for 0 < m < M, (A^k)^m ≠ e. If (A^k)^m = e then N | km (theorem 4);
// substituting k = d·K, N = d·M and cancelling d gives M | K·m; coprimality of K and M
// (Bézout K·P + M·Q = 1) with Euclid's lemma gives M | m; but 0 < m < M makes a positive
// multiple of M below M impossible (divisorAtMost). Hence no such m kills A^k.
theorem powerCofactorMinimal: forall d, cofactorK, cofactorM, bezoutP, bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
proof
  @generalize-d |
    fix d: Int {
      @generalize-cofactorK |
        fix cofactorK: Int {
          @generalize-cofactorM |
            fix cofactorM: Int {
              @generalize-bezoutP |
                fix bezoutP: Int {
                  @generalize-bezoutQ |
                    fix bezoutQ: Int {
                      @given-d-positive |
                        assume less_than(ZERO, d) {
                          @given-m-positive-order |
                            assume less_than(ZERO, cofactorM) {
                              @given-n-split |
                                assume N = mul(d, cofactorM) {
                                  @given-bezout |
                                    assume add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE {
                                      @d-positive |
                                        less_than(ZERO, d)
                                        [by hypothesis given-d-positive]
                                      @order-positive |
                                        less_than(ZERO, cofactorM)
                                        [by hypothesis given-m-positive-order]
                                      @n-split |
                                        N = mul(d, cofactorM)
                                        [by hypothesis given-n-split]
                                      @bezout-km |
                                        add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE
                                        [by hypothesis given-bezout]
                                      // rearrange to M's Bézout form: M·Q + K·P = 1.
                                      @bezout-m-form |
                                        add(mul(cofactorM, bezoutQ), mul(cofactorK, bezoutP)) = ONE
                                        [by rewrite bezout-km bezout-swap-refl]
                                      @bezout-swap-refl |
                                        add(mul(cofactorM, bezoutQ), mul(cofactorK, bezoutP)) = add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ))
                                        [using polynomial(integer)]

                                      @generalize-m |
                                        fix m: Int {
                                          @given-m-positive |
                                            assume less_than(ZERO, m) {
                                              @given-m-less |
                                                assume less_than(m, cofactorM) {
                                                  @m-positive |
                                                    less_than(ZERO, m)
                                                    [by hypothesis given-m-positive]
                                                  @m-less-order |
                                                    less_than(m, cofactorM)
                                                    [by hypothesis given-m-less]
                                                  @given-killed |
                                                    assume power(power(A, mul(d, cofactorK)), m) = E {
                                                      @ak-m-killed |
                                                        power(power(A, mul(d, cofactorK)), m) = E
                                                        [by hypothesis given-killed]
                                                      // (A^k)^m = A^(k·m).
                                                      @power-mul |
                                                        power(power(A, mul(d, cofactorK)), m) = power(A, mul(mul(d, cofactorK), m))
                                                        [using specialize group_power.powerMul(A, mul(d, cofactorK), m)]
                                                      @a-km-killed |
                                                        power(A, mul(mul(d, cofactorK), m)) = E
                                                        [using chain power-mul-flipped ak-m-killed]
                                                      @power-mul-flipped |
                                                        power(A, mul(mul(d, cofactorK), m)) = power(power(A, mul(d, cofactorK)), m)
                                                        [by symmetry power-mul]
                                                      // theorem 4: N | (k·m).
                                                      @n-divides-km |
                                                        divides(N, mul(mul(d, cofactorK), m))
                                                        [using specialize killedExponentIsMultiple(mul(mul(d, cofactorK), m)) a-km-killed]
                                                      @with-t |
                                                        unpack t: Int from n-divides-km {
                                                          @km-is-nt |
                                                            mul(mul(d, cofactorK), m) = mul(N, t)
                                                            [by hypothesis with-t]
                                                          // d·(K·m) = k·m = N·t = (d·M)·t = d·(M·t).
                                                          @km-with-n |
                                                            mul(mul(d, cofactorK), m) = mul(mul(d, cofactorM), t)
                                                            [by rewrite n-split km-is-nt]
                                                          @left-regroups |
                                                            mul(mul(d, cofactorK), m) = mul(d, mul(cofactorK, m))
                                                            [using polynomial(integer)]
                                                          @right-regroups |
                                                            mul(mul(d, cofactorM), t) = mul(d, mul(cofactorM, t))
                                                            [using polynomial(integer)]
                                                          @d-km-eq-d-mt |
                                                            mul(d, mul(cofactorK, m)) = mul(d, mul(cofactorM, t))
                                                            [using chain left-regroups-flipped km-with-n right-regroups]
                                                          @left-regroups-flipped |
                                                            mul(d, mul(cofactorK, m)) = mul(mul(d, cofactorK), m)
                                                            [by symmetry left-regroups]
                                                          // cancel d (d > 0): K·m = M·t.
                                                          @km-eq-mt |
                                                            mul(cofactorK, m) = mul(cofactorM, t)
                                                            [using specialize int_divides.mulCancelLeft(d, mul(cofactorK, m), mul(cofactorM, t)) d-positive d-km-eq-d-mt]
                                                          // so M | K·m (witness t).
                                                          @m-divides-km |
                                                            divides(cofactorM, mul(cofactorK, m))
                                                            [by exists_intro(t) km-eq-mt]
                                                          // Euclid: M coprime to K and M | K·m ⟹ M | m.
                                                          @m-divides-m |
                                                            divides(cofactorM, m)
                                                            [using specialize int_divides.euclidFromBezout(cofactorM, cofactorK, m, bezoutQ, bezoutP) bezout-m-form m-divides-km]
                                                          // 0 < M, 0 < m, M | m ⟹ M ≤ m; contradicts m < M.
                                                          @m-at-most |
                                                            int_divides.at_most(cofactorM, m)
                                                            [using specialize int_divides.divisorAtMost(cofactorM, m) order-positive m-positive m-divides-m]
                                                          @m-le-m |
                                                            less_than(cofactorM, m) or cofactorM = m
                                                            [using tautology m-at-most]
                                                          @conclusion-not-m-less |
                                                            not less_than(m, cofactorM)
                                                            case m-le-m {
                                                              @when-strict |
                                                                assume less_than(cofactorM, m) {
                                                                  @m-strictly-less |
                                                                    less_than(cofactorM, m)
                                                                    [by hypothesis when-strict]
                                                                  @suppose-m-less |
                                                                    assume less_than(m, cofactorM) {
                                                                      @m-less-here |
                                                                        less_than(m, cofactorM)
                                                                        [by hypothesis suppose-m-less]
                                                                      @m-less-m |
                                                                        less_than(cofactorM, cofactorM)
                                                                        [using specialize int_divides.lessThanTransitive(cofactorM, m, cofactorM) m-strictly-less m-less-here]
                                                                      @not-m-less-m |
                                                                        not less_than(cofactorM, cofactorM)
                                                                        [using specialize int_divides.lessThanIrreflexive(cofactorM)]
                                                                    }
                                                                  @not-less-strict |
                                                                    not less_than(m, cofactorM)
                                                                    [by not_intro suppose-m-less m-less-m not-m-less-m]
                                                                }
                                                              @when-equal |
                                                                assume cofactorM = m {
                                                                  @m-equals |
                                                                    cofactorM = m
                                                                    [by hypothesis when-equal]
                                                                  @not-less-self |
                                                                    not less_than(m, m)
                                                                    [using specialize int_divides.lessThanIrreflexive(m)]
                                                                  @not-less-equal |
                                                                    not less_than(m, cofactorM)
                                                                    [by rewrite m-equals not-less-self]
                                                                }
                                                            }
                                                        }
                                                      @not-m-less-exported |
                                                        not less_than(m, cofactorM)
                                                        [by exists_elim with-t]
                                                    }
                                                  // the assumption (A^k)^m = e yields m < M (given) and not(m < M): contradiction.
                                                  @conclusion-neq |
                                                    power(power(A, mul(d, cofactorK)), m) != E
                                                    [by not_intro given-killed m-less-order not-m-less-exported]
                                                }
                                              @m-less-implies |
                                                less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                                                [by implies_intro given-m-less]
                                            }
                                          @m-positive-implies |
                                            less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                                            [by implies_intro given-m-positive]
                                        }
                                      @conclusion-all-m |
                                        forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                                        [by forall_intro generalize-m]
                                    }
                                  @bezout-implies |
                                    add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                                    [by implies_intro given-bezout]
                                }
                              @n-split-implies |
                                N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                                [by implies_intro given-n-split]
                            }
                          @order-positive-implies |
                            less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                            [by implies_intro given-m-positive-order]
                        }
                      @d-positive-implies |
                        less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                        [by implies_intro given-d-positive]
                    }
                  @discharge-bezoutQ |
                    forall bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                    [by forall_intro generalize-bezoutQ]
                }
              @discharge-bezoutP |
                forall bezoutP, bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                [by forall_intro generalize-bezoutP]
            }
          @discharge-cofactorM |
            forall cofactorM, bezoutP, bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
            [by forall_intro generalize-cofactorM]
        }
      @discharge-cofactorK |
        forall cofactorK, cofactorM, bezoutP, bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
        [by forall_intro generalize-cofactorK]
    }
  @conclusion |
    forall d, cofactorK, cofactorM, bezoutP, bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
    [by forall_intro generalize-d]
qed

// -- ORDER AS A RELATION over arbitrary elements ------------------------------
// The fixed-A/N form above is enough for the main-text theorems, but the exercises
// COMPARE the orders of different elements (|a| = |a⁻¹|, etc.). Turning "the least
// positive period" into a FUNCTION `ord : G → ℕ` needs a choice/definite-description
// operator 2b4m lacks; instead we use the order as a single-valued RELATION
// `hasOrder(g, n)` — "n is the order of g" — which needs no new primitive and lets
// orders be stated and compared. (Same move as `bezout`: existence-form, not a function.)
define hasOrder(g, n) = less_than(ZERO, n) and power(g, n) = E and (forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(g, m) != E)

// the order is unique: an element has at most one order. If m and n both qualify,
// neither can be strictly less than the other (each is minimal), so m = n by trichotomy.
theorem orderIsUnique: forall g: Grp; forall m, n: Int; hasOrder(g, m) -> hasOrder(g, n) -> m = n
proof
  @generalize-g |
    fix g: Grp {
      @generalize-m |
        fix m: Int {
          @generalize-n |
            fix n: Int {
              @given-m |
                assume hasOrder(g, m) {
                  @given-n |
                    assume hasOrder(g, n) {
                      @m-facts |
                        less_than(ZERO, m) and power(g, m) = E and (forall j: Int; less_than(ZERO, j) -> less_than(j, m) -> power(g, j) != E)
                        [by hypothesis given-m]
                      @n-facts |
                        less_than(ZERO, n) and power(g, n) = E and (forall j: Int; less_than(ZERO, j) -> less_than(j, n) -> power(g, j) != E)
                        [by hypothesis given-n]
                      @m-positive |
                        less_than(ZERO, m)
                        [using tautology m-facts]
                      @n-positive |
                        less_than(ZERO, n)
                        [using tautology n-facts]
                      @m-kills |
                        power(g, m) = E
                        [using tautology m-facts]
                      @n-kills |
                        power(g, n) = E
                        [using tautology n-facts]
                      @m-minimal |
                        forall j: Int; less_than(ZERO, j) -> less_than(j, m) -> power(g, j) != E
                        [using tautology m-facts]
                      @n-minimal |
                        forall j: Int; less_than(ZERO, j) -> less_than(j, n) -> power(g, j) != E
                        [using tautology n-facts]
                      // trichotomy on m, n: m<n contradicts n-minimality (m kills g, 0<m<n);
                      // n<m contradicts m-minimality; so m = n.
                      @trichotomy |
                        less_than(m, n) or m = n or less_than(n, m)
                        [using specialize int_divides.trichotomy(m, n)]
                      @conclusion-equal |
                        m = n
                        case trichotomy {
                          @when-m-less-n |
                            assume less_than(m, n) {
                              @m-less-n |
                                less_than(m, n)
                                [by hypothesis when-m-less-n]
                              @m-not-kill |
                                power(g, m) != E
                                [using specialize n-minimal(m) m-positive m-less-n]
                              @m-equals-n |
                                m = n
                                [by absurd m-kills m-not-kill]
                            }
                          @when-equal |
                            assume m = n {
                              @m-equals-n |
                                m = n
                                [by hypothesis when-equal]
                            }
                          @when-n-less-m |
                            assume less_than(n, m) {
                              @n-less-m |
                                less_than(n, m)
                                [by hypothesis when-n-less-m]
                              @n-not-kill |
                                power(g, n) != E
                                [using specialize m-minimal(n) n-positive n-less-m]
                              @m-equals-n |
                                m = n
                                [by absurd n-kills n-not-kill]
                            }
                        }
                    }
                  @n-implies |
                    hasOrder(g, n) -> m = n
                    [by implies_intro given-n]
                }
              @m-implies |
                hasOrder(g, m) -> hasOrder(g, n) -> m = n
                [by implies_intro given-m]
            }
          @discharge-n |
            forall n: Int; hasOrder(g, m) -> hasOrder(g, n) -> m = n
            [by forall_intro generalize-n]
        }
      @discharge-m |
        forall m, n: Int; hasOrder(g, m) -> hasOrder(g, n) -> m = n
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall g: Grp; forall m, n: Int; hasOrder(g, m) -> hasOrder(g, n) -> m = n
    [by forall_intro generalize-g]
qed

// a power of the inverse is the identity iff the corresponding power of g is:
// (g⁻¹)^k = (g^k)⁻¹, and x⁻¹ = e ⟺ x = e.
theorem inversePowerIdentityIff: forall g: Grp; forall k: Int; power(inverse(g), k) = E iff power(g, k) = E
proof
  @generalize-g |
    fix g: Grp {
      @generalize-k |
        fix k: Int {
          @inv-power |
            power(inverse(g), k) = inverse(power(g, k))
            [using specialize group_power.powerInverseBase(g, k)]
          @given-inv-kills |
            assume power(inverse(g), k) = E {
              @inv-kills |
                power(inverse(g), k) = E
                [by hypothesis given-inv-kills]
              @inv-of-power-is-e |
                inverse(power(g, k)) = E
                [using chain inv-power-flipped inv-kills]
              @inv-power-flipped |
                inverse(power(g, k)) = power(inverse(g), k)
                [by symmetry inv-power]
              // inverse(power g k) = E ⟹ power g k = inverse(inverse(power g k)) = inverse(E) = E.
              @invol |
                inverse(inverse(power(g, k))) = power(g, k)
                [using specialize group_power.invInvolution(power(g, k))]
              @inv-of-e |
                inverse(inverse(power(g, k))) = inverse(E)
                [by rewrite inv-of-power-is-e invol-refl]
              @invol-refl |
                inverse(inverse(power(g, k))) = inverse(inverse(power(g, k)))
                [by reflexivity]
              @inverse-of-identity |
                inverse(E) = E
                [using import(group_power) inverseOfIdentity]
              @power-is-inv-inv |
                power(g, k) = inverse(inverse(power(g, k)))
                [by symmetry invol]
              @conclusion-forward |
                power(g, k) = E
                [using chain power-is-inv-inv inv-of-e inverse-of-identity]
            }
          @given-g-kills |
            assume power(g, k) = E {
              @g-kills |
                power(g, k) = E
                [by hypothesis given-g-kills]
              @inv-of-e |
                inverse(power(g, k)) = inverse(E)
                [by rewrite g-kills inv-of-power-refl]
              @inv-of-power-refl |
                inverse(power(g, k)) = inverse(power(g, k))
                [by reflexivity]
              @inverse-of-identity |
                inverse(E) = E
                [using import(group_power) inverseOfIdentity]
              @inv-of-power-is-e |
                inverse(power(g, k)) = E
                [using chain inv-of-e inverse-of-identity]
              @conclusion-backward |
                power(inverse(g), k) = E
                [using chain inv-power inv-of-power-is-e]
            }
          @forward |
            power(inverse(g), k) = E -> power(g, k) = E
            [by implies_intro given-inv-kills]
          @backward |
            power(g, k) = E -> power(inverse(g), k) = E
            [by implies_intro given-g-kills]
          @conclusion-iff |
            power(inverse(g), k) = E iff power(g, k) = E
            [by iff_intro forward backward]
        }
      @discharge-k |
        forall k: Int; power(inverse(g), k) = E iff power(g, k) = E
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall g: Grp; forall k: Int; power(inverse(g), k) = E iff power(g, k) = E
    [by forall_intro generalize-g]
qed

// EXERCISE 23(a): the order of a is the order of a⁻¹ — hasOrder(g, n) → hasOrder(g⁻¹, n).
// g⁻¹ is killed by n (since g is) and minimal (a smaller killing power of g⁻¹ would kill
// g too), so g and g⁻¹ have the same order.
theorem inverseHasSameOrder: forall g: Grp; forall n: Int; hasOrder(g, n) -> hasOrder(inverse(g), n)
proof
  @generalize-g |
    fix g: Grp {
      @generalize-n |
        fix n: Int {
          @given-order |
            assume hasOrder(g, n) {
              @order-facts |
                less_than(ZERO, n) and power(g, n) = E and (forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(g, m) != E)
                [by hypothesis given-order]
              @n-positive |
                less_than(ZERO, n)
                [using tautology order-facts]
              @g-kills |
                power(g, n) = E
                [using tautology order-facts]
              @g-minimal |
                forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(g, m) != E
                [using tautology order-facts]
              // g⁻¹ is killed by n: power(g⁻¹, n) = E iff power(g, n) = E.
              @inv-kills-iff |
                power(inverse(g), n) = E iff power(g, n) = E
                [using specialize inversePowerIdentityIff(g, n)]
              @inv-kills |
                power(inverse(g), n) = E
                [using tautology inv-kills-iff g-kills]
              // minimality for g⁻¹: for 0 < m < n, power(g⁻¹, m) ≠ E (else power(g, m) = E).
              @generalize-m |
                fix m: Int {
                  @given-m-positive |
                    assume less_than(ZERO, m) {
                      @given-m-less |
                        assume less_than(m, n) {
                          @m-positive |
                            less_than(ZERO, m)
                            [by hypothesis given-m-positive]
                          @m-less-n |
                            less_than(m, n)
                            [by hypothesis given-m-less]
                          @g-m-nonzero |
                            power(g, m) != E
                            [using specialize g-minimal(m) m-positive m-less-n]
                          @inv-m-iff |
                            power(inverse(g), m) = E iff power(g, m) = E
                            [using specialize inversePowerIdentityIff(g, m)]
                          @inv-m-nonzero |
                            power(inverse(g), m) != E
                            [using tautology inv-m-iff g-m-nonzero]
                        }
                      @m-less-implies |
                        less_than(m, n) -> power(inverse(g), m) != E
                        [by implies_intro given-m-less]
                    }
                  @m-positive-implies |
                    less_than(ZERO, m) -> less_than(m, n) -> power(inverse(g), m) != E
                    [by implies_intro given-m-positive]
                }
              @inv-minimal |
                forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(inverse(g), m) != E
                [by forall_intro generalize-m]
              @conclusion-has-order |
                hasOrder(inverse(g), n)
                [using tautology n-positive inv-kills inv-minimal]
            }
          @order-implies |
            hasOrder(g, n) -> hasOrder(inverse(g), n)
            [by implies_intro given-order]
        }
      @discharge-n |
        forall n: Int; hasOrder(g, n) -> hasOrder(inverse(g), n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall g: Grp; forall n: Int; hasOrder(g, n) -> hasOrder(inverse(g), n)
    [by forall_intro generalize-g]
qed

// -- conjugation preserves the order (EXERCISES 23(b), 23(c)) --------------------------
// (g⁻¹ a g)^k = g⁻¹ a^k g, so the conjugate g⁻¹ a g is killed by exactly the exponents
// that kill a and has the same order; ab and ba = a⁻¹(ab)a are conjugate, so they too.

// g · (g⁻¹ · x) = x.
theorem inverseCancelsInside: forall g, x: Grp; op(g, op(inverse(g), x)) = x
proof
  @generalize-g |
    fix g: Grp {
      @generalize-x |
        fix x: Grp {
          @regrouped |
            op(g, op(inverse(g), x)) = op(op(g, inverse(g)), x)
            [using assoc(group_power.opAssoc)]
          @g-times-inverse |
            op(g, inverse(g)) = E
            [using specialize group_power.opInverseRight(g)]
          @identity-times-x |
            op(E, x) = x
            [using specialize group_power.opIdentityLeft(x)]
          @pair-cancels |
            op(op(g, inverse(g)), x) = x
            [by rewrite g-times-inverse identity-times-x]
          @conclusion-cancelled |
            op(g, op(inverse(g), x)) = x
            [using chain regrouped pair-cancels]
        }
      @discharge-x |
        forall x: Grp; op(g, op(inverse(g), x)) = x
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall g, x: Grp; op(g, op(inverse(g), x)) = x
    [by forall_intro generalize-g]
qed

// g⁻¹ · (g · x) = x.
theorem cancelsInverseInside: forall g, x: Grp; op(inverse(g), op(g, x)) = x
proof
  @generalize-g |
    fix g: Grp {
      @generalize-x |
        fix x: Grp {
          @regrouped |
            op(inverse(g), op(g, x)) = op(op(inverse(g), g), x)
            [using assoc(group_power.opAssoc)]
          @inverse-times-g |
            op(inverse(g), g) = E
            [using specialize group_power.opInverseLeft(g)]
          @identity-times-x |
            op(E, x) = x
            [using specialize group_power.opIdentityLeft(x)]
          @pair-cancels |
            op(op(inverse(g), g), x) = x
            [by rewrite inverse-times-g identity-times-x]
          @conclusion-cancelled |
            op(inverse(g), op(g, x)) = x
            [using chain regrouped pair-cancels]
        }
      @discharge-x |
        forall x: Grp; op(inverse(g), op(g, x)) = x
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall g, x: Grp; op(inverse(g), op(g, x)) = x
    [by forall_intro generalize-g]
qed

// (g⁻¹ a g)^k = g⁻¹ a^k g: induction on the integer exponent, both ways. Up: (g⁻¹ a^k g)(g⁻¹ a g)
// regroups to g⁻¹ a^k (g g⁻¹) a g. Down: the same with (g⁻¹ a g)⁻¹ = g⁻¹ a⁻¹ g.
theorem conjugatePower: forall g, a: Grp; forall k: Int; power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g)
proof
  @generalize-g |
    fix g: Grp {
      @generalize-a |
        fix a: Grp {
          // base case: both sides are e.
          @conjugate-zeroth |
            power(op(op(inverse(g), a), g), ZERO) = E
            [using specialize group_power.powerZero(op(op(inverse(g), a), g))]
          @a-zeroth |
            power(a, ZERO) = E
            [using specialize group_power.powerZero(a)]
          @inverse-times-identity |
            op(inverse(g), E) = inverse(g)
            [using specialize group_power.opIdentityRight(inverse(g))]
          @inverse-times-g |
            op(inverse(g), g) = E
            [using specialize group_power.opInverseLeft(g)]
          @base-case |
            power(op(op(inverse(g), a), g), ZERO) = op(op(inverse(g), power(a, ZERO)), g)
            [using simplify conjugate-zeroth a-zeroth inverse-times-identity inverse-times-g]

          // step up: multiply by one more conjugate and cancel g g⁻¹ in the middle.
          @step-up |
            fix k: Int {
              @given-conjugate-power |
                assume power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g) {
                  @conjugate-power |
                    power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g)
                    [by hypothesis given-conjugate-power]
                  @next-unfolds |
                    power(op(op(inverse(g), a), g), succ(k)) = op(power(op(op(inverse(g), a), g), k), op(op(inverse(g), a), g))
                    [using specialize group_power.powerSucc(op(op(inverse(g), a), g), k)]
                  @a-next-unfolds |
                    power(a, succ(k)) = op(power(a, k), a)
                    [using specialize group_power.powerSucc(a, k)]
                  @next-as-product |
                    power(op(op(inverse(g), a), g), succ(k)) = op(op(op(inverse(g), power(a, k)), g), op(op(inverse(g), a), g))
                    [by rewrite conjugate-power next-unfolds]
                  @regrouped |
                    op(op(op(inverse(g), power(a, k)), g), op(op(inverse(g), a), g)) = op(op(inverse(g), power(a, k)), op(g, op(inverse(g), op(a, g))))
                    [using assoc(group_power.opAssoc)]
                  @middle-cancels |
                    op(g, op(inverse(g), op(a, g))) = op(a, g)
                    [using specialize inverseCancelsInside(g, op(a, g))]
                  @next-regrouped |
                    power(op(op(inverse(g), a), g), succ(k)) = op(op(inverse(g), power(a, k)), op(g, op(inverse(g), op(a, g))))
                    [using chain next-as-product regrouped]
                  @next-cancelled |
                    power(op(op(inverse(g), a), g), succ(k)) = op(op(inverse(g), power(a, k)), op(a, g))
                    [by rewrite middle-cancels next-regrouped]
                  @regrouped-again |
                    op(op(inverse(g), power(a, k)), op(a, g)) = op(op(inverse(g), op(power(a, k), a)), g)
                    [using assoc(group_power.opAssoc)]
                  @next-as-conjugate |
                    power(op(op(inverse(g), a), g), succ(k)) = op(op(inverse(g), op(power(a, k), a)), g)
                    [using chain next-cancelled regrouped-again]
                  @conclusion-next |
                    power(op(op(inverse(g), a), g), succ(k)) = op(op(inverse(g), power(a, succ(k))), g)
                    [by rewrite a-next-unfolds next-as-conjugate]
                }
              @conclusion-step-up |
                power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g) -> power(op(op(inverse(g), a), g), succ(k)) = op(op(inverse(g), power(a, succ(k))), g)
                [by implies_intro given-conjugate-power]
            }
          @step-up-for-all-k |
            forall k: Int; power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g) -> power(op(op(inverse(g), a), g), succ(k)) = op(op(inverse(g), power(a, succ(k))), g)
            [by forall_intro step-up]

          // step down: multiply by the inverse conjugate g⁻¹ a⁻¹ g instead.
          @inverse-of-conjugate-outer |
            inverse(op(op(inverse(g), a), g)) = op(inverse(g), inverse(op(inverse(g), a)))
            [using specialize group_power.invProduct(op(inverse(g), a), g)]
          @inverse-of-conjugate-inner |
            inverse(op(inverse(g), a)) = op(inverse(a), inverse(inverse(g)))
            [using specialize group_power.invProduct(inverse(g), a)]
          @inverse-twice |
            inverse(inverse(g)) = g
            [using specialize group_power.invInvolution(g)]
          @inverse-of-conjugate-inner-simplified |
            inverse(op(inverse(g), a)) = op(inverse(a), g)
            [by rewrite inverse-twice inverse-of-conjugate-inner]
          @inverse-of-conjugate |
            inverse(op(op(inverse(g), a), g)) = op(inverse(g), op(inverse(a), g))
            [by rewrite inverse-of-conjugate-inner-simplified inverse-of-conjugate-outer]
          @step-down |
            fix k: Int {
              @given-conjugate-power |
                assume power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g) {
                  @conjugate-power |
                    power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g)
                    [by hypothesis given-conjugate-power]
                  @previous-unfolds |
                    power(op(op(inverse(g), a), g), prev(k)) = op(power(op(op(inverse(g), a), g), k), inverse(op(op(inverse(g), a), g)))
                    [using specialize group_power.powerPrev(op(op(inverse(g), a), g), k)]
                  @a-previous-unfolds |
                    power(a, prev(k)) = op(power(a, k), inverse(a))
                    [using specialize group_power.powerPrev(a, k)]
                  @previous-with-power |
                    power(op(op(inverse(g), a), g), prev(k)) = op(op(op(inverse(g), power(a, k)), g), inverse(op(op(inverse(g), a), g)))
                    [by rewrite conjugate-power previous-unfolds]
                  @previous-as-product |
                    power(op(op(inverse(g), a), g), prev(k)) = op(op(op(inverse(g), power(a, k)), g), op(inverse(g), op(inverse(a), g)))
                    [by rewrite inverse-of-conjugate previous-with-power]
                  @regrouped |
                    op(op(op(inverse(g), power(a, k)), g), op(inverse(g), op(inverse(a), g))) = op(op(inverse(g), power(a, k)), op(g, op(inverse(g), op(inverse(a), g))))
                    [using assoc(group_power.opAssoc)]
                  @middle-cancels |
                    op(g, op(inverse(g), op(inverse(a), g))) = op(inverse(a), g)
                    [using specialize inverseCancelsInside(g, op(inverse(a), g))]
                  @previous-regrouped |
                    power(op(op(inverse(g), a), g), prev(k)) = op(op(inverse(g), power(a, k)), op(g, op(inverse(g), op(inverse(a), g))))
                    [using chain previous-as-product regrouped]
                  @previous-cancelled |
                    power(op(op(inverse(g), a), g), prev(k)) = op(op(inverse(g), power(a, k)), op(inverse(a), g))
                    [by rewrite middle-cancels previous-regrouped]
                  @regrouped-again |
                    op(op(inverse(g), power(a, k)), op(inverse(a), g)) = op(op(inverse(g), op(power(a, k), inverse(a))), g)
                    [using assoc(group_power.opAssoc)]
                  @previous-as-conjugate |
                    power(op(op(inverse(g), a), g), prev(k)) = op(op(inverse(g), op(power(a, k), inverse(a))), g)
                    [using chain previous-cancelled regrouped-again]
                  @conclusion-previous |
                    power(op(op(inverse(g), a), g), prev(k)) = op(op(inverse(g), power(a, prev(k))), g)
                    [by rewrite a-previous-unfolds previous-as-conjugate]
                }
              @conclusion-step-down |
                power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g) -> power(op(op(inverse(g), a), g), prev(k)) = op(op(inverse(g), power(a, prev(k))), g)
                [by implies_intro given-conjugate-power]
            }
          @step-down-for-all-k |
            forall k: Int; power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g) -> power(op(op(inverse(g), a), g), prev(k)) = op(op(inverse(g), power(a, prev(k))), g)
            [by forall_intro step-down]
          @conclusion-for-all-k |
            forall k: Int; power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g)
            [using instantiation intInduction((fun k: Int => power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g))) base-case step-up-for-all-k step-down-for-all-k]
        }
      @discharge-a |
        forall a: Grp; forall k: Int; power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall g, a: Grp; forall k: Int; power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g)
    [by forall_intro generalize-g]
qed

// a power of the conjugate is the identity iff the same power of a is: g⁻¹ a^k g = e
// cancels (on the right by g, then on the left by g⁻¹) to a^k = e, and conversely.
theorem conjugatePowerIdentityIff: forall g, a: Grp; forall k: Int; power(op(op(inverse(g), a), g), k) = E iff power(a, k) = E
proof
  @generalize-g |
    fix g: Grp {
      @generalize-a |
        fix a: Grp {
          @generalize-k |
            fix k: Int {
              @conjugate-power |
                power(op(op(inverse(g), a), g), k) = op(op(inverse(g), power(a, k)), g)
                [using specialize conjugatePower(g, a, k)]
              @inverse-times-g |
                op(inverse(g), g) = E
                [using specialize group_power.opInverseLeft(g)]
              @inverse-times-identity |
                op(inverse(g), E) = inverse(g)
                [using specialize group_power.opIdentityRight(inverse(g))]
              @given-conjugate-kills |
                assume power(op(op(inverse(g), a), g), k) = E {
                  @conjugate-kills |
                    power(op(op(inverse(g), a), g), k) = E
                    [by hypothesis given-conjugate-kills]
                  @conjugate-power-flipped |
                    op(op(inverse(g), power(a, k)), g) = power(op(op(inverse(g), a), g), k)
                    [by symmetry conjugate-power]
                  @identity-as-product |
                    E = op(inverse(g), g)
                    [by symmetry inverse-times-g]
                  @products-agree |
                    op(op(inverse(g), power(a, k)), g) = op(inverse(g), g)
                    [using chain conjugate-power-flipped conjugate-kills identity-as-product]
                  @cancelled-right |
                    op(inverse(g), power(a, k)) = inverse(g)
                    [using specialize group.cancelRight(op(inverse(g), power(a, k)), g, inverse(g)) products-agree]
                  @inverse-as-product |
                    inverse(g) = op(inverse(g), E)
                    [by symmetry inverse-times-identity]
                  @left-factors-agree |
                    op(inverse(g), power(a, k)) = op(inverse(g), E)
                    [using chain cancelled-right inverse-as-product]
                  @conclusion-a-kills |
                    power(a, k) = E
                    [using specialize group.cancelLeft(inverse(g), power(a, k), E) left-factors-agree]
                }
              @given-a-kills |
                assume power(a, k) = E {
                  @a-kills |
                    power(a, k) = E
                    [by hypothesis given-a-kills]
                  @conjugate-of-identity |
                    power(op(op(inverse(g), a), g), k) = op(op(inverse(g), E), g)
                    [by rewrite a-kills conjugate-power]
                  @conjugate-collapses |
                    power(op(op(inverse(g), a), g), k) = op(inverse(g), g)
                    [by rewrite inverse-times-identity conjugate-of-identity]
                  @conclusion-conjugate-kills |
                    power(op(op(inverse(g), a), g), k) = E
                    [using chain conjugate-collapses inverse-times-g]
                }
              @forward |
                power(op(op(inverse(g), a), g), k) = E -> power(a, k) = E
                [by implies_intro given-conjugate-kills]
              @backward |
                power(a, k) = E -> power(op(op(inverse(g), a), g), k) = E
                [by implies_intro given-a-kills]
              @conclusion-iff |
                power(op(op(inverse(g), a), g), k) = E iff power(a, k) = E
                [by iff_intro forward backward]
            }
          @discharge-k |
            forall k: Int; power(op(op(inverse(g), a), g), k) = E iff power(a, k) = E
            [by forall_intro generalize-k]
        }
      @discharge-a |
        forall a: Grp; forall k: Int; power(op(op(inverse(g), a), g), k) = E iff power(a, k) = E
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall g, a: Grp; forall k: Int; power(op(op(inverse(g), a), g), k) = E iff power(a, k) = E
    [by forall_intro generalize-g]
qed

// EXERCISE 23(b): |a| = |g⁻¹ a g|. The conjugate is killed by n (since a is) and by no
// smaller positive exponent (that would kill a too).
theorem conjugateHasSameOrder: forall g, a: Grp; forall n: Int; hasOrder(a, n) -> hasOrder(op(op(inverse(g), a), g), n)
proof
  @generalize-g |
    fix g: Grp {
      @generalize-a |
        fix a: Grp {
          @generalize-n |
            fix n: Int {
              @given-order |
                assume hasOrder(a, n) {
                  @order-facts |
                    less_than(ZERO, n) and power(a, n) = E and (forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(a, m) != E)
                    [by hypothesis given-order]
                  @n-positive |
                    less_than(ZERO, n)
                    [using tautology order-facts]
                  @a-kills |
                    power(a, n) = E
                    [using tautology order-facts]
                  @a-minimal |
                    forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(a, m) != E
                    [using tautology order-facts]
                  @conjugate-kills-iff |
                    power(op(op(inverse(g), a), g), n) = E iff power(a, n) = E
                    [using specialize conjugatePowerIdentityIff(g, a, n)]
                  @conjugate-kills |
                    power(op(op(inverse(g), a), g), n) = E
                    [using tautology conjugate-kills-iff a-kills]
                  @generalize-m |
                    fix m: Int {
                      @given-m-positive |
                        assume less_than(ZERO, m) {
                          @given-m-less |
                            assume less_than(m, n) {
                              @m-positive |
                                less_than(ZERO, m)
                                [by hypothesis given-m-positive]
                              @m-less-n |
                                less_than(m, n)
                                [by hypothesis given-m-less]
                              @a-m-nonzero |
                                power(a, m) != E
                                [using specialize a-minimal(m) m-positive m-less-n]
                              @conjugate-m-iff |
                                power(op(op(inverse(g), a), g), m) = E iff power(a, m) = E
                                [using specialize conjugatePowerIdentityIff(g, a, m)]
                              @conjugate-m-nonzero |
                                power(op(op(inverse(g), a), g), m) != E
                                [using tautology conjugate-m-iff a-m-nonzero]
                            }
                          @m-less-implies |
                            less_than(m, n) -> power(op(op(inverse(g), a), g), m) != E
                            [by implies_intro given-m-less]
                        }
                      @m-positive-implies |
                        less_than(ZERO, m) -> less_than(m, n) -> power(op(op(inverse(g), a), g), m) != E
                        [by implies_intro given-m-positive]
                    }
                  @conjugate-minimal |
                    forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(op(op(inverse(g), a), g), m) != E
                    [by forall_intro generalize-m]
                  @conclusion-has-order |
                    hasOrder(op(op(inverse(g), a), g), n)
                    [using tautology n-positive conjugate-kills conjugate-minimal]
                }
              @order-implies |
                hasOrder(a, n) -> hasOrder(op(op(inverse(g), a), g), n)
                [by implies_intro given-order]
            }
          @discharge-n |
            forall n: Int; hasOrder(a, n) -> hasOrder(op(op(inverse(g), a), g), n)
            [by forall_intro generalize-n]
        }
      @discharge-a |
        forall a: Grp; forall n: Int; hasOrder(a, n) -> hasOrder(op(op(inverse(g), a), g), n)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall g, a: Grp; forall n: Int; hasOrder(a, n) -> hasOrder(op(op(inverse(g), a), g), n)
    [by forall_intro generalize-g]
qed

// EXERCISE 23(c): |ab| = |ba|, since ba = a⁻¹(ab)a is a conjugate of ab.
theorem productsHaveSameOrder: forall a, b: Grp; forall n: Int; hasOrder(op(a, b), n) -> hasOrder(op(b, a), n)
proof
  @generalize-a |
    fix a: Grp {
      @generalize-b |
        fix b: Grp {
          @generalize-n |
            fix n: Int {
              @given-order |
                assume hasOrder(op(a, b), n) {
                  @product-order |
                    hasOrder(op(a, b), n)
                    [by hypothesis given-order]
                  @conjugate-order |
                    hasOrder(op(op(inverse(a), op(a, b)), a), n)
                    [using specialize conjugateHasSameOrder(a, op(a, b), n) product-order]
                  @regrouped |
                    op(op(inverse(a), op(a, b)), a) = op(inverse(a), op(a, op(b, a)))
                    [using assoc(group_power.opAssoc)]
                  @a-cancels |
                    op(inverse(a), op(a, op(b, a))) = op(b, a)
                    [using specialize cancelsInverseInside(a, op(b, a))]
                  @conjugate-is-reversed-product |
                    op(op(inverse(a), op(a, b)), a) = op(b, a)
                    [using chain regrouped a-cancels]
                  @conclusion-reversed-order |
                    hasOrder(op(b, a), n)
                    [by rewrite conjugate-is-reversed-product conjugate-order]
                }
              @order-implies |
                hasOrder(op(a, b), n) -> hasOrder(op(b, a), n)
                [by implies_intro given-order]
            }
          @discharge-n |
            forall n: Int; hasOrder(op(a, b), n) -> hasOrder(op(b, a), n)
            [by forall_intro generalize-n]
        }
      @discharge-b |
        forall b: Grp; forall n: Int; hasOrder(op(a, b), n) -> hasOrder(op(b, a), n)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Grp; forall n: Int; hasOrder(op(a, b), n) -> hasOrder(op(b, a), n)
    [by forall_intro generalize-a]
qed

// -- elements of finite order (EXERCISE 31: the torsion subgroup) ------------------------
// g has FINITE order when some positive exponent kills it. The identity does; inverses
// and (in an abelian group) products of such elements do — so in an abelian group the
// elements of finite order form a subgroup.
define hasFiniteOrder(g) = exists n: Int; less_than(ZERO, n) and power(g, n) = E

// e has finite order: e¹ = e.
theorem identityHasFiniteOrder: hasFiniteOrder(E)
proof
  @one-positive |
    less_than(ZERO, ONE)
    [using import(int_divides) zeroLessThanOne]
  @identity-power |
    power(E, ONE) = E
    [using specialize group_power.powerOfIdentity(ONE)]
  @one-kills-identity |
    less_than(ZERO, ONE) and power(E, ONE) = E
    [by and_intro one-positive identity-power]
  @conclusion |
    hasFiniteOrder(E)
    [by exists_intro(ONE) one-kills-identity]
qed

// an exponent killing g kills g⁻¹.
theorem inverseHasFiniteOrder: forall g: Grp; hasFiniteOrder(g) -> hasFiniteOrder(inverse(g))
proof
  @generalize-g |
    fix g: Grp {
      @given-finite |
        assume hasFiniteOrder(g) {
          @killer-exists |
            exists n: Int; less_than(ZERO, n) and power(g, n) = E
            [by hypothesis given-finite]
          @with-killer-n |
            unpack n: Int from killer-exists {
              @killer-facts |
                less_than(ZERO, n) and power(g, n) = E
                [by hypothesis with-killer-n]
              @n-positive |
                less_than(ZERO, n)
                [by and_elim_left killer-facts]
              @g-kills |
                power(g, n) = E
                [by and_elim_right killer-facts]
              @inverse-kills-iff |
                power(inverse(g), n) = E iff power(g, n) = E
                [using specialize inversePowerIdentityIff(g, n)]
              @inverse-kills |
                power(inverse(g), n) = E
                [using tautology inverse-kills-iff g-kills]
              @n-kills-inverse |
                less_than(ZERO, n) and power(inverse(g), n) = E
                [by and_intro n-positive inverse-kills]
              @conclusion-inverse-finite |
                hasFiniteOrder(inverse(g))
                [by exists_intro(n) n-kills-inverse]
            }
          @conclusion-with-killer |
            hasFiniteOrder(inverse(g))
            [by exists_elim with-killer-n]
        }
      @finite-implies |
        hasFiniteOrder(g) -> hasFiniteOrder(inverse(g))
        [by implies_intro given-finite]
    }
  @conclusion |
    forall g: Grp; hasFiniteOrder(g) -> hasFiniteOrder(inverse(g))
    [by forall_intro generalize-g]
qed

// ABELIAN: if m kills g and n kills h then mn kills gh, since (gh)^(mn) = g^(mn) h^(mn) =
// (g^m)^n (h^n)^m = e. (The product law for powers is where commutativity enters.)
theorem productHasFiniteOrderAbelian: forall g, h: Grp; hasFiniteOrder(g) -> hasFiniteOrder(h) -> hasFiniteOrder(op(g, h))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-h |
        fix h: Grp {
          @given-g-finite |
            assume hasFiniteOrder(g) {
              @given-h-finite |
                assume hasFiniteOrder(h) {
                  @g-killer-exists |
                    exists n: Int; less_than(ZERO, n) and power(g, n) = E
                    [by hypothesis given-g-finite]
                  @h-killer-exists |
                    exists n: Int; less_than(ZERO, n) and power(h, n) = E
                    [by hypothesis given-h-finite]
                  @with-g-killer-m |
                    unpack m: Int from g-killer-exists {
                      @g-killer-facts |
                        less_than(ZERO, m) and power(g, m) = E
                        [by hypothesis with-g-killer-m]
                      @with-h-killer-n |
                        unpack n: Int from h-killer-exists {
                          @h-killer-facts |
                            less_than(ZERO, n) and power(h, n) = E
                            [by hypothesis with-h-killer-n]
                          @m-positive |
                            less_than(ZERO, m)
                            [by and_elim_left g-killer-facts]
                          @g-kills |
                            power(g, m) = E
                            [by and_elim_right g-killer-facts]
                          @n-positive |
                            less_than(ZERO, n)
                            [by and_elim_left h-killer-facts]
                          @h-kills |
                            power(h, n) = E
                            [by and_elim_right h-killer-facts]
                          @product-positive |
                            less_than(ZERO, mul(m, n))
                            [using specialize int_divides.productWithPositiveIsPositive(m, n) m-positive n-positive]
                          // g^(mn) = (g^m)^n = e^n = e.
                          @g-power-mul |
                            power(power(g, m), n) = power(g, mul(m, n))
                            [using specialize group_power.powerMul(g, m, n)]
                          @g-power-of-identity |
                            power(E, n) = E
                            [using specialize group_power.powerOfIdentity(n)]
                          @g-mn-as-identity-power |
                            power(E, n) = power(g, mul(m, n))
                            [by rewrite g-kills g-power-mul]
                          @g-mn-flipped |
                            power(g, mul(m, n)) = power(E, n)
                            [by symmetry g-mn-as-identity-power]
                          @g-mn-kills |
                            power(g, mul(m, n)) = E
                            [using chain g-mn-flipped g-power-of-identity]
                          // h^(mn) = h^(nm) = (h^n)^m = e^m = e.
                          @h-power-mul |
                            power(power(h, n), m) = power(h, mul(n, m))
                            [using specialize group_power.powerMul(h, n, m)]
                          @h-power-of-identity |
                            power(E, m) = E
                            [using specialize group_power.powerOfIdentity(m)]
                          @h-nm-as-identity-power |
                            power(E, m) = power(h, mul(n, m))
                            [by rewrite h-kills h-power-mul]
                          @h-nm-flipped |
                            power(h, mul(n, m)) = power(E, m)
                            [by symmetry h-nm-as-identity-power]
                          @h-nm-kills |
                            power(h, mul(n, m)) = E
                            [using chain h-nm-flipped h-power-of-identity]
                          @exponents-commute |
                            mul(n, m) = mul(m, n)
                            [using specialize int_divides.mulIsCommutative(n, m)]
                          @h-mn-kills |
                            power(h, mul(m, n)) = E
                            [by rewrite exponents-commute h-nm-kills]
                          // (gh)^(mn) = g^(mn) h^(mn) = e e = e.
                          @product-power-splits |
                            power(op(g, h), mul(m, n)) = op(power(g, mul(m, n)), power(h, mul(m, n)))
                            [using specialize group_power.powerProductAbelian(g, h, mul(m, n))]
                          @product-power-left-killed |
                            power(op(g, h), mul(m, n)) = op(E, power(h, mul(m, n)))
                            [by rewrite g-mn-kills product-power-splits]
                          @product-power-both-killed |
                            power(op(g, h), mul(m, n)) = op(E, E)
                            [by rewrite h-mn-kills product-power-left-killed]
                          @identity-squared |
                            op(E, E) = E
                            [using specialize group_power.opIdentityLeft(E)]
                          @product-mn-kills |
                            power(op(g, h), mul(m, n)) = E
                            [using chain product-power-both-killed identity-squared]
                          @mn-kills-product |
                            less_than(ZERO, mul(m, n)) and power(op(g, h), mul(m, n)) = E
                            [by and_intro product-positive product-mn-kills]
                          @conclusion-product-finite |
                            hasFiniteOrder(op(g, h))
                            [by exists_intro(mul(m, n)) mn-kills-product]
                        }
                      @conclusion-with-h-killer |
                        hasFiniteOrder(op(g, h))
                        [by exists_elim with-h-killer-n]
                    }
                  @conclusion-with-g-killer |
                    hasFiniteOrder(op(g, h))
                    [by exists_elim with-g-killer-m]
                }
              @h-finite-implies |
                hasFiniteOrder(h) -> hasFiniteOrder(op(g, h))
                [by implies_intro given-h-finite]
            }
          @g-finite-implies |
            hasFiniteOrder(g) -> hasFiniteOrder(h) -> hasFiniteOrder(op(g, h))
            [by implies_intro given-g-finite]
        }
      @discharge-h |
        forall h: Grp; hasFiniteOrder(g) -> hasFiniteOrder(h) -> hasFiniteOrder(op(g, h))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Grp; hasFiniteOrder(g) -> hasFiniteOrder(h) -> hasFiniteOrder(op(g, h))
    [by forall_intro generalize-g]
qed

// -- the order divides every killing exponent, for a VARIABLE element ----------------------
// The fixed-A/N law powerEqIdentityIffOrderDivides, restated for any g with hasOrder(g, n):
// g^k = e ⟺ n | k. Forward: divide k = nq + r with 0 ≤ r < n; then g^r = g^k = e, so
// minimality forces r = 0. Backward: g^(nq) = (g^n)^q = e.
theorem killedIffOrderDivides: forall g: Grp; forall n: Int; hasOrder(g, n) -> forall k: Int; (power(g, k) = E iff divides(n, k))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-n |
        fix n: Int {
          @given-order |
            assume hasOrder(g, n) {
              @order-facts |
                less_than(ZERO, n) and power(g, n) = E and (forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(g, m) != E)
                [by hypothesis given-order]
              @n-positive |
                less_than(ZERO, n)
                [using tautology order-facts]
              @g-kills |
                power(g, n) = E
                [using tautology order-facts]
              @g-minimal |
                forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(g, m) != E
                [using tautology order-facts]
              @generalize-k |
                fix k: Int {
                  // forward: g^k = e ⟹ n | k.
                  @given-killed |
                    assume power(g, k) = E {
                      @g-k-is-e |
                        power(g, k) = E
                        [by hypothesis given-killed]
                      @div-alg |
                        exists q: Int; exists r: Int; k = add(mul(n, q), r) and is_nonneg(r) and less_than(r, n)
                        [using specialize int_divides.divisionAlgorithmExists(k, n) n-positive]
                      @with-quotient |
                        unpack q: Int from div-alg {
                          @remainder-exists |
                            exists r: Int; k = add(mul(n, q), r) and is_nonneg(r) and less_than(r, n)
                            [by hypothesis with-quotient]
                          @with-remainder |
                            unpack r: Int from remainder-exists {
                              @div-facts |
                                k = add(mul(n, q), r) and is_nonneg(r) and less_than(r, n)
                                [by hypothesis with-remainder]
                              @k-decomposes |
                                k = add(mul(n, q), r)
                                [using tautology div-facts]
                              @r-nonneg |
                                is_nonneg(r)
                                [using tautology div-facts]
                              @r-less-n |
                                less_than(r, n)
                                [using tautology div-facts]
                              // g^(nq) = (g^n)^q = e.
                              @power-of-killed |
                                power(power(g, n), q) = power(g, mul(n, q))
                                [using specialize group_power.powerMul(g, n, q)]
                              @identity-power-is-nq-power |
                                power(E, q) = power(g, mul(n, q))
                                [by rewrite g-kills power-of-killed]
                              @nq-power-is-identity-power |
                                power(g, mul(n, q)) = power(E, q)
                                [by symmetry identity-power-is-nq-power]
                              @identity-power |
                                power(E, q) = E
                                [using specialize group_power.powerOfIdentity(q)]
                              @nq-kills |
                                power(g, mul(n, q)) = E
                                [using chain nq-power-is-identity-power identity-power]
                              // g^k = g^(nq)·g^r = g^r, so g^r = e.
                              @power-add |
                                op(power(g, mul(n, q)), power(g, r)) = power(g, add(mul(n, q), r))
                                [using specialize group_power.powerAdd(g, mul(n, q), r)]
                              @product-with-e |
                                op(E, power(g, r)) = power(g, add(mul(n, q), r))
                                [by rewrite nq-kills power-add]
                              @e-times-gr |
                                op(E, power(g, r)) = power(g, r)
                                [using specialize group_power.opIdentityLeft(power(g, r))]
                              @gr-is-k-power |
                                power(g, r) = power(g, add(mul(n, q), r))
                                [using chain e-times-gr product-with-e]
                              @decomposed-power-is-e |
                                power(g, add(mul(n, q), r)) = E
                                [by rewrite k-decomposes g-k-is-e]
                              @gr-is-e |
                                power(g, r) = E
                                [using chain gr-is-k-power decomposed-power-is-e]
                              // minimality: 0 < r < n would make g^r ≠ e; so r = 0.
                              @given-r-positive |
                                assume less_than(ZERO, r) {
                                  @r-positive |
                                    less_than(ZERO, r)
                                    [by hypothesis given-r-positive]
                                  @gr-nonzero |
                                    power(g, r) != E
                                    [using specialize g-minimal(r) r-positive r-less-n]
                                }
                              @r-positive-implies |
                                less_than(ZERO, r) -> power(g, r) != E
                                [by implies_intro given-r-positive]
                              @r-not-positive |
                                not less_than(ZERO, r)
                                [using tautology r-positive-implies gr-is-e]
                              @r-is-zero |
                                r = ZERO
                                [using specialize int_divides.nonnegNotPositiveIsZero(r) r-nonneg r-not-positive]
                              @k-is-nq-plus-zero |
                                k = add(mul(n, q), ZERO)
                                [by rewrite r-is-zero k-decomposes]
                              @nq-plus-zero |
                                add(mul(n, q), ZERO) = mul(n, q)
                                [using specialize integer.addZeroRight(mul(n, q))]
                              @k-is-multiple |
                                k = mul(n, q)
                                [using chain k-is-nq-plus-zero nq-plus-zero]
                              @conclusion-divides |
                                divides(n, k)
                                [by exists_intro(q) k-is-multiple]
                            }
                          @conclusion-with-remainder |
                            divides(n, k)
                            [by exists_elim with-remainder]
                        }
                      @conclusion-with-quotient |
                        divides(n, k)
                        [by exists_elim with-quotient]
                    }
                  // backward: n | k ⟹ g^k = g^(nq) = e.
                  @given-divides |
                    assume divides(n, k) {
                      @multiple-exists |
                        exists q: Int; k = mul(n, q)
                        [by hypothesis given-divides]
                      @with-cofactor |
                        unpack q: Int from multiple-exists {
                          @k-is-multiple |
                            k = mul(n, q)
                            [by hypothesis with-cofactor]
                          @power-of-killed |
                            power(power(g, n), q) = power(g, mul(n, q))
                            [using specialize group_power.powerMul(g, n, q)]
                          @identity-power-is-nq-power |
                            power(E, q) = power(g, mul(n, q))
                            [by rewrite g-kills power-of-killed]
                          @nq-power-is-identity-power |
                            power(g, mul(n, q)) = power(E, q)
                            [by symmetry identity-power-is-nq-power]
                          @identity-power |
                            power(E, q) = E
                            [using specialize group_power.powerOfIdentity(q)]
                          @nq-kills |
                            power(g, mul(n, q)) = E
                            [using chain nq-power-is-identity-power identity-power]
                          @conclusion-k-kills |
                            power(g, k) = E
                            [by rewrite k-is-multiple nq-kills]
                        }
                      @conclusion-with-cofactor |
                        power(g, k) = E
                        [by exists_elim with-cofactor]
                    }
                  @forward |
                    power(g, k) = E -> divides(n, k)
                    [by implies_intro given-killed]
                  @backward |
                    divides(n, k) -> power(g, k) = E
                    [by implies_intro given-divides]
                  @conclusion-iff |
                    power(g, k) = E iff divides(n, k)
                    [by iff_intro forward backward]
                }
              @discharge-k |
                forall k: Int; (power(g, k) = E iff divides(n, k))
                [by forall_intro generalize-k]
            }
          @order-implies |
            hasOrder(g, n) -> forall k: Int; (power(g, k) = E iff divides(n, k))
            [by implies_intro given-order]
        }
      @discharge-n |
        forall n: Int; hasOrder(g, n) -> forall k: Int; (power(g, k) = E iff divides(n, k))
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall g: Grp; forall n: Int; hasOrder(g, n) -> forall k: Int; (power(g, k) = E iff divides(n, k))
    [by forall_intro generalize-g]
qed

// -- the two smallest orders ---------------------------------------------------------------------
// e has order 1: e^1 = e, and no positive exponent lies below succ(ZERO).
theorem identityHasOrderOne: hasOrder(E, succ(ZERO))
proof
  @zero-nonneg |
    is_nonneg(ZERO)
    [by cite nonnegZero]
  @one-is-positive |
    less_than(ZERO, succ(ZERO))
    [using specialize lessThanIntro(ZERO, ZERO, succ(ZERO)) zero-nonneg zero-plus-one]
  @zero-plus-one |
    add(ZERO, succ(ZERO)) = succ(ZERO)
    [using specialize addZeroLeft(succ(ZERO))]
  @one-kills |
    power(E, succ(ZERO)) = E
    [using specialize powerOfIdentity(succ(ZERO))]
  @generalize-m |
    fix m: Int {
      @given-positive |
        assume less_than(ZERO, m) {
          @positive |
            less_than(ZERO, m)
            [by hypothesis given-positive]
          @not-below-one |
            not less_than(m, succ(ZERO))
            [using specialize noPositiveBelowOne(m) positive]
          @conclusion-nothing-below-one |
            less_than(m, succ(ZERO)) -> power(E, m) != E
            [using tautology not-below-one]
        }
      @positive-implies |
        less_than(ZERO, m) -> less_than(m, succ(ZERO)) -> power(E, m) != E
        [by implies_intro given-positive]
    }
  @minimal |
    forall m: Int; less_than(ZERO, m) -> less_than(m, succ(ZERO)) -> power(E, m) != E
    [by forall_intro generalize-m]
  @conclusion |
    hasOrder(E, succ(ZERO))
    [using tautology one-is-positive one-kills minimal]
qed

// An involution g ≠ e (g² = e) has order 2: g^2 = (g^1)g = gg = e, and the only positive
// exponent below succ(succ(ZERO)) is succ(ZERO), where g^1 = g ≠ e.
theorem involutionHasOrderTwo: forall g: Grp; op(g, g) = E -> g != E -> hasOrder(g, succ(succ(ZERO)))
proof
  @zero-nonneg |
    is_nonneg(ZERO)
    [by cite nonnegZero]
  @one-nonneg |
    is_nonneg(succ(ZERO))
    [using specialize nonnegSucc(ZERO) zero-nonneg]
  @zero-plus-two |
    add(ZERO, succ(succ(ZERO))) = succ(succ(ZERO))
    [using specialize addZeroLeft(succ(succ(ZERO)))]
  @two-is-positive |
    less_than(ZERO, succ(succ(ZERO)))
    [using specialize lessThanIntro(ZERO, succ(ZERO), succ(succ(ZERO))) one-nonneg zero-plus-two]
  @generalize-g |
    fix g: Grp {
      @given-involution |
        assume op(g, g) = E {
          @given-nontrivial |
            assume g != E {
              @involution |
                op(g, g) = E
                [by hypothesis given-involution]
              @nontrivial |
                g != E
                [by hypothesis given-nontrivial]
              @second-power-unfolds |
                power(g, succ(succ(ZERO))) = op(power(g, succ(ZERO)), g)
                [using specialize powerSucc(g, succ(ZERO))]
              @first-power |
                power(g, succ(ZERO)) = g
                [using specialize powerOne(g)]
              @second-power-is-square |
                power(g, succ(succ(ZERO))) = op(g, g)
                [by rewrite first-power second-power-unfolds]
              @two-kills |
                power(g, succ(succ(ZERO))) = E
                [using chain second-power-is-square involution]
              @generalize-m |
                fix m: Int {
                  @given-positive |
                    assume less_than(ZERO, m) {
                      @given-below-two |
                        assume less_than(m, succ(succ(ZERO))) {
                          @positive |
                            less_than(ZERO, m)
                            [by hypothesis given-positive]
                          @below-two |
                            less_than(m, succ(succ(ZERO)))
                            [by hypothesis given-below-two]
                          @m-is-one |
                            m = succ(ZERO)
                            [using specialize positiveBelowTwoIsOne(m) positive below-two]
                          @m-power-is-g |
                            power(g, m) = g
                            [by rewrite m-is-one first-power]
                          @given-m-kills |
                            assume power(g, m) = E {
                              @m-kills |
                                power(g, m) = E
                                [by hypothesis given-m-kills]
                              @g-is-m-power |
                                g = power(g, m)
                                [by symmetry m-power-is-g]
                              @conclusion-g-is-identity |
                                g = E
                                [using chain g-is-m-power m-kills]
                            }
                          @m-kills-implies |
                            power(g, m) = E -> g = E
                            [by implies_intro given-m-kills]
                          @conclusion-m-does-not-kill |
                            power(g, m) != E
                            [using tautology m-kills-implies nontrivial]
                        }
                      @below-two-implies |
                        less_than(m, succ(succ(ZERO))) -> power(g, m) != E
                        [by implies_intro given-below-two]
                    }
                  @positive-implies |
                    less_than(ZERO, m) -> less_than(m, succ(succ(ZERO))) -> power(g, m) != E
                    [by implies_intro given-positive]
                }
              @minimal |
                forall m: Int; less_than(ZERO, m) -> less_than(m, succ(succ(ZERO))) -> power(g, m) != E
                [by forall_intro generalize-m]
              @conclusion-order-two |
                hasOrder(g, succ(succ(ZERO)))
                [using tautology two-is-positive two-kills minimal]
            }
          @nontrivial-implies |
            g != E -> hasOrder(g, succ(succ(ZERO)))
            [by implies_intro given-nontrivial]
        }
      @involution-implies |
        op(g, g) = E -> g != E -> hasOrder(g, succ(succ(ZERO)))
        [by implies_intro given-involution]
    }
  @conclusion |
    forall g: Grp; op(g, g) = E -> g != E -> hasOrder(g, succ(succ(ZERO)))
    [by forall_intro generalize-g]
qed
