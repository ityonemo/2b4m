// std/group/order.b4m — the ORDER of a group element.
//
// For a fixed element A of order N (the smallest POSITIVE integer with A^N = e), this
// file proves Judson's cyclic-order results (AATA §4.1):
//   • A^k = e  ⟺  N | k  (cyclic-proposition-subgrp-order).
// The order is axiomatized as a positive constant N that kills A and is minimal among
// positive exponents (the smallest-positive-n characterization; existence of such an N
// for a finite-order element is the well-ordering fact, kept as the defining axioms
// here). Powers are std/group/power.b4m over ℤ exponents; divisibility and the division
// algorithm are std/integer/divides.b4m.

import group_power <<< "std/group/power.b4m"
import int_divides <<< "std/integer/divides.b4m"
import integer <<< "std/integer.b4m"

sort Grp = group_power.Grp
const E = group_power.E
func op = group_power.op
func inverse = group_power.inverse
func power = group_power.power

sort Int = group_power.Int
const ZERO = group_power.ZERO
const ONE = integer.ONE
func add = group_power.add
func mul = group_power.mul
pred less_than = int_divides.less_than
pred is_nonneg = int_divides.is_nonneg
define divides(d, n) = exists k: Int; n = mul(d, k)

// the element A and its order N: N is positive, kills A, and is the least positive such.
const A: Grp
const N: Int
axiom orderPositive: less_than(ZERO, N)
axiom orderKills: power(A, N) = E
axiom orderMinimal: forall m: Int; less_than(ZERO, m) -> less_than(m, N) -> power(A, m) != E

// A^(N·s) = e for any s: (A^N)^s = e^s = e.
theorem powerKillsMultiple: forall s: Int; power(A, mul(N, s)) = E
proof
  @generalize-s |
    fix s: Int {
      // A^(N·s) = (A^N)^s.
      @power-mul |
        power(power(A, N), s) = power(A, mul(N, s))
        [using specialize group_power.powerMul(A, N, s)]
      @power-mul-flipped |
        power(A, mul(N, s)) = power(power(A, N), s)
        [by symmetry power-mul]
      // A^N = e, so (A^N)^s = e^s.
      @an-is-e |
        power(A, N) = E
        [by cite orderKills]
      @base-is-e-power |
        power(power(A, N), s) = power(E, s)
        [by rewrite an-is-e power-mul-reflexive]
      @power-mul-reflexive |
        power(power(A, N), s) = power(power(A, N), s)
        [by reflexivity]
      // e^s = e (identity to any power).
      @identity-power |
        power(E, s) = E
        [using specialize group_power.powerOfIdentity(s)]
      @conclusion-kills |
        power(A, mul(N, s)) = E
        [using chain power-mul-flipped base-is-e-power identity-power]
    }
  @conclusion |
    forall s: Int; power(A, mul(N, s)) = E
    [by forall_intro generalize-s]
qed

// backward direction: N | k ⟹ A^k = e.
theorem multipleKillsA: forall k: Int; divides(N, k) -> power(A, k) = E
proof
  @generalize-k |
    fix k: Int {
      @given-divides |
        assume divides(N, k) {
          @n-divides-k |
            exists s: Int; k = mul(N, s)
            [by hypothesis given-divides]
          @with-quotient |
            unpack s: Int from n-divides-k {
              @k-is-multiple |
                k = mul(N, s)
                [by hypothesis with-quotient]
              @multiple-kills |
                power(A, mul(N, s)) = E
                [using specialize powerKillsMultiple(s)]
              @conclusion-kills |
                power(A, k) = E
                [by rewrite k-is-multiple multiple-kills]
            }
          @conclusion-with |
            power(A, k) = E
            [by exists_elim with-quotient]
        }
      @divides-implies-kills |
        divides(N, k) -> power(A, k) = E
        [by implies_intro given-divides]
    }
  @conclusion |
    forall k: Int; divides(N, k) -> power(A, k) = E
    [by forall_intro generalize-k]
qed

// forward direction: A^k = e ⟹ N | k. Division algorithm k = N·q + r with 0 ≤ r < N;
// then A^r = A^k·(A^(Nq))⁻¹-style collapse gives A^r = A^k = e, and minimality of N
// forces r = 0, so k = N·q.
theorem killedExponentIsMultiple: forall k: Int; power(A, k) = E -> divides(N, k)
proof
  @generalize-k |
    fix k: Int {
      @given-killed |
        assume power(A, k) = E {
          @a-k-is-e |
            power(A, k) = E
            [by hypothesis given-killed]
          @n-positive |
            less_than(ZERO, N)
            [by cite orderPositive]
          // division algorithm: k = N·q + r, 0 ≤ r < N.
          @div-alg |
            exists q: Int; exists r: Int; k = add(mul(N, q), r) and is_nonneg(r) and less_than(r, N)
            [using specialize int_divides.divisionAlgorithmExists(k, N) n-positive]
          @with-quotient |
            unpack q: Int from div-alg {
              @remainder-exists |
                exists r: Int; k = add(mul(N, q), r) and is_nonneg(r) and less_than(r, N)
                [by hypothesis with-quotient]
              @with-remainder |
                unpack r: Int from remainder-exists {
                  @div-facts |
                    k = add(mul(N, q), r) and is_nonneg(r) and less_than(r, N)
                    [by hypothesis with-remainder]
                  @k-decomposes |
                    k = add(mul(N, q), r)
                    [using tautology div-facts]
                  @r-nonneg |
                    is_nonneg(r)
                    [using tautology div-facts]
                  @r-less-n |
                    less_than(r, N)
                    [using tautology div-facts]
                  // A^k = A^(Nq + r) = A^(Nq)·A^r = e·A^r = A^r.
                  @power-add |
                    op(power(A, mul(N, q)), power(A, r)) = power(A, add(mul(N, q), r))
                    [using specialize group_power.powerAdd(A, mul(N, q), r)]
                  @nq-kills |
                    power(A, mul(N, q)) = E
                    [using specialize powerKillsMultiple(q)]
                  @product-with-e |
                    op(E, power(A, r)) = power(A, add(mul(N, q), r))
                    [by rewrite nq-kills power-add]
                  @e-times-ar |
                    op(E, power(A, r)) = power(A, r)
                    [using specialize group_power.opIdentityLeft(power(A, r))]
                  @ar-is-k-power |
                    power(A, r) = power(A, add(mul(N, q), r))
                    [using chain e-times-ar product-with-e]
                  // A^(Nq+r) = e (rewrite k = Nq+r into A^k = e), then A^r = A^(Nq+r) = e.
                  @decomposed-power-is-e |
                    power(A, add(mul(N, q), r)) = E
                    [by rewrite k-decomposes a-k-is-e]
                  // minimality: r < N and A^r = e force r not positive; with r ≥ 0, r = 0.
                  @given-r-positive |
                    assume less_than(ZERO, r) {
                      @r-positive |
                        less_than(ZERO, r)
                        [by hypothesis given-r-positive]
                      @a-r-nonzero |
                        power(A, r) != E
                        [using specialize orderMinimal(r) r-positive r-less-n]
                      @a-r-is-e-inside |
                        power(A, r) = E
                        [using chain ar-is-k-power decomposed-power-is-e]
                    }
                  @r-not-positive |
                    not less_than(ZERO, r)
                    [by not_intro given-r-positive a-r-is-e-inside a-r-nonzero]
                  @r-is-zero |
                    r = ZERO
                    [using specialize int_divides.nonnegNotPositiveIsZero(r) r-nonneg r-not-positive]
                  // so k = N·q + 0 = N·q, hence N | k.
                  @k-is-nq |
                    k = add(mul(N, q), ZERO)
                    [by rewrite r-is-zero k-decomposes]
                  @nq-plus-zero |
                    add(mul(N, q), ZERO) = mul(N, q)
                    [using specialize integer.addZeroRight(mul(N, q))]
                  @k-is-multiple |
                    k = mul(N, q)
                    [using chain k-is-nq nq-plus-zero]
                  @conclusion-divides |
                    divides(N, k)
                    [by exists_intro(q) k-is-multiple]
                }
              @conclusion-with-remainder |
                divides(N, k)
                [by exists_elim with-remainder]
            }
          @conclusion-with-quotient |
            divides(N, k)
            [by exists_elim with-quotient]
        }
      @killed-implies-divides |
        power(A, k) = E -> divides(N, k)
        [by implies_intro given-killed]
    }
  @conclusion |
    forall k: Int; power(A, k) = E -> divides(N, k)
    [by forall_intro generalize-k]
qed

// A^k = e ⟺ N | k (cyclic-proposition-subgrp-order).
theorem powerEqIdentityIffOrderDivides: forall k: Int; power(A, k) = E iff divides(N, k)
proof
  @generalize-k |
    fix k: Int {
      @forward |
        power(A, k) = E -> divides(N, k)
        [using specialize killedExponentIsMultiple(k)]
      @backward |
        divides(N, k) -> power(A, k) = E
        [using specialize multipleKillsA(k)]
      @conclusion-iff |
        power(A, k) = E iff divides(N, k)
        [by iff_intro forward backward]
    }
  @conclusion |
    forall k: Int; power(A, k) = E iff divides(N, k)
    [by forall_intro generalize-k]
qed

// -- order of a power: ord(A^k) = N / gcd(k, N) (cyclic-theorem-cyclic-orders) ------
// std form (not tied to Judson's `n/d` notation): write d = gcd(k, N), and let the
// cofactors K = k/d, M = N/d be given by k = d·K, N = d·M. Then M is the order of A^k:
// it kills A^k and is minimal. Coprimality of K and M (= k/d, N/d) is supplied as a
// Bézout identity k·P + N·Q = d (the gcd's Bézout identity), from which K·P + M·Q = 1
// follows by cancelling d — this is where "d = gcd" enters. The aata §4.1 file maps
// M back to n/d in prose.

// (a) M kills A^k: (A^k)^M = A^(kM) = A^(K·(d·M)) = A^(K·N) = (A^N)^K = e.
theorem powerCofactorKills: forall d, cofactorK, cofactorM: Int; N = mul(d, cofactorM) -> power(power(A, mul(d, cofactorK)), cofactorM) = E
proof
  @generalize-d |
    fix d: Int {
      @generalize-cofactorK |
        fix cofactorK: Int {
          @generalize-cofactorM |
            fix cofactorM: Int {
              @given-n-split |
                assume N = mul(d, cofactorM) {
                  @n-split |
                    N = mul(d, cofactorM)
                    [by hypothesis given-n-split]
                  // (A^k)^M = A^(k·M) where k = d·K.
                  @power-mul |
                    power(power(A, mul(d, cofactorK)), cofactorM) = power(A, mul(mul(d, cofactorK), cofactorM))
                    [using specialize group_power.powerMul(A, mul(d, cofactorK), cofactorM)]
                  // k·M = (d·K)·M = K·(d·M) = K·N.
                  @exponent-regroups |
                    mul(mul(d, cofactorK), cofactorM) = mul(cofactorK, mul(d, cofactorM))
                    [using polynomial(integer)]
                  @exponent-with-n |
                    mul(mul(d, cofactorK), cofactorM) = mul(cofactorK, N)
                    [by rewrite n-split exponent-regroups]
                  @power-at-kn |
                    power(power(A, mul(d, cofactorK)), cofactorM) = power(A, mul(cofactorK, N))
                    [using chain power-mul exponent-with-n]
                  // A^(K·N) = A^(N·K) = e.
                  @kn-is-nk |
                    mul(cofactorK, N) = mul(N, cofactorK)
                    [using specialize integer.mulIsCommutative(cofactorK, N)]
                  @power-at-nk |
                    power(power(A, mul(d, cofactorK)), cofactorM) = power(A, mul(N, cofactorK))
                    [using chain power-at-kn kn-is-nk]
                  @nk-kills |
                    power(A, mul(N, cofactorK)) = E
                    [using specialize powerKillsMultiple(cofactorK)]
                  @conclusion-kills |
                    power(power(A, mul(d, cofactorK)), cofactorM) = E
                    [using chain power-at-nk nk-kills]
                }
              @n-split-implies |
                N = mul(d, cofactorM) -> power(power(A, mul(d, cofactorK)), cofactorM) = E
                [by implies_intro given-n-split]
            }
          @discharge-cofactorM |
            forall cofactorM: Int; N = mul(d, cofactorM) -> power(power(A, mul(d, cofactorK)), cofactorM) = E
            [by forall_intro generalize-cofactorM]
        }
      @discharge-cofactorK |
        forall cofactorK, cofactorM: Int; N = mul(d, cofactorM) -> power(power(A, mul(d, cofactorK)), cofactorM) = E
        [by forall_intro generalize-cofactorK]
    }
  @conclusion |
    forall d, cofactorK, cofactorM: Int; N = mul(d, cofactorM) -> power(power(A, mul(d, cofactorK)), cofactorM) = E
    [by forall_intro generalize-d]
qed

// (b) M is minimal: for 0 < m < M, (A^k)^m ≠ e. If (A^k)^m = e then N | km (theorem 4);
// substituting k = d·K, N = d·M and cancelling d gives M | K·m; coprimality of K and M
// (Bézout K·P + M·Q = 1) with Euclid's lemma gives M | m; but 0 < m < M makes a positive
// multiple of M below M impossible (divisorAtMost). Hence no such m kills A^k.
theorem powerCofactorMinimal: forall d, cofactorK, cofactorM, bezoutP, bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
proof
  @generalize-d |
    fix d: Int {
      @generalize-cofactorK |
        fix cofactorK: Int {
          @generalize-cofactorM |
            fix cofactorM: Int {
              @generalize-bezoutP |
                fix bezoutP: Int {
                  @generalize-bezoutQ |
                    fix bezoutQ: Int {
                      @given-d-positive |
                        assume less_than(ZERO, d) {
                          @given-m-positive-order |
                            assume less_than(ZERO, cofactorM) {
                              @given-n-split |
                                assume N = mul(d, cofactorM) {
                                  @given-bezout |
                                    assume add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE {
                                      @d-positive |
                                        less_than(ZERO, d)
                                        [by hypothesis given-d-positive]
                                      @order-positive |
                                        less_than(ZERO, cofactorM)
                                        [by hypothesis given-m-positive-order]
                                      @n-split |
                                        N = mul(d, cofactorM)
                                        [by hypothesis given-n-split]
                                      @bezout-km |
                                        add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE
                                        [by hypothesis given-bezout]
                                      // rearrange to M's Bézout form: M·Q + K·P = 1.
                                      @bezout-m-form |
                                        add(mul(cofactorM, bezoutQ), mul(cofactorK, bezoutP)) = ONE
                                        [by rewrite bezout-km bezout-swap-refl]
                                      @bezout-swap-refl |
                                        add(mul(cofactorM, bezoutQ), mul(cofactorK, bezoutP)) = add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ))
                                        [using polynomial(integer)]

                                      @generalize-m |
                                        fix m: Int {
                                          @given-m-positive |
                                            assume less_than(ZERO, m) {
                                              @given-m-less |
                                                assume less_than(m, cofactorM) {
                                                  @m-positive |
                                                    less_than(ZERO, m)
                                                    [by hypothesis given-m-positive]
                                                  @m-less-order |
                                                    less_than(m, cofactorM)
                                                    [by hypothesis given-m-less]
                                                  @given-killed |
                                                    assume power(power(A, mul(d, cofactorK)), m) = E {
                                                      @ak-m-killed |
                                                        power(power(A, mul(d, cofactorK)), m) = E
                                                        [by hypothesis given-killed]
                                                      // (A^k)^m = A^(k·m).
                                                      @power-mul |
                                                        power(power(A, mul(d, cofactorK)), m) = power(A, mul(mul(d, cofactorK), m))
                                                        [using specialize group_power.powerMul(A, mul(d, cofactorK), m)]
                                                      @a-km-killed |
                                                        power(A, mul(mul(d, cofactorK), m)) = E
                                                        [using chain power-mul-flipped ak-m-killed]
                                                      @power-mul-flipped |
                                                        power(A, mul(mul(d, cofactorK), m)) = power(power(A, mul(d, cofactorK)), m)
                                                        [by symmetry power-mul]
                                                      // theorem 4: N | (k·m).
                                                      @n-divides-km |
                                                        divides(N, mul(mul(d, cofactorK), m))
                                                        [using specialize killedExponentIsMultiple(mul(mul(d, cofactorK), m)) a-km-killed]
                                                      @with-t |
                                                        unpack t: Int from n-divides-km {
                                                          @km-is-nt |
                                                            mul(mul(d, cofactorK), m) = mul(N, t)
                                                            [by hypothesis with-t]
                                                          // d·(K·m) = k·m = N·t = (d·M)·t = d·(M·t).
                                                          @km-with-n |
                                                            mul(mul(d, cofactorK), m) = mul(mul(d, cofactorM), t)
                                                            [by rewrite n-split km-is-nt]
                                                          @left-regroups |
                                                            mul(mul(d, cofactorK), m) = mul(d, mul(cofactorK, m))
                                                            [using polynomial(integer)]
                                                          @right-regroups |
                                                            mul(mul(d, cofactorM), t) = mul(d, mul(cofactorM, t))
                                                            [using polynomial(integer)]
                                                          @d-km-eq-d-mt |
                                                            mul(d, mul(cofactorK, m)) = mul(d, mul(cofactorM, t))
                                                            [using chain left-regroups-flipped km-with-n right-regroups]
                                                          @left-regroups-flipped |
                                                            mul(d, mul(cofactorK, m)) = mul(mul(d, cofactorK), m)
                                                            [by symmetry left-regroups]
                                                          // cancel d (d > 0): K·m = M·t.
                                                          @km-eq-mt |
                                                            mul(cofactorK, m) = mul(cofactorM, t)
                                                            [using specialize int_divides.mulCancelLeft(d, mul(cofactorK, m), mul(cofactorM, t)) d-positive d-km-eq-d-mt]
                                                          // so M | K·m (witness t).
                                                          @m-divides-km |
                                                            divides(cofactorM, mul(cofactorK, m))
                                                            [by exists_intro(t) km-eq-mt]
                                                          // Euclid: M coprime to K and M | K·m ⟹ M | m.
                                                          @m-divides-m |
                                                            divides(cofactorM, m)
                                                            [using specialize int_divides.euclidFromBezout(cofactorM, cofactorK, m, bezoutQ, bezoutP) bezout-m-form m-divides-km]
                                                          // 0 < M, 0 < m, M | m ⟹ M ≤ m; contradicts m < M.
                                                          @m-at-most |
                                                            int_divides.at_most(cofactorM, m)
                                                            [using specialize int_divides.divisorAtMost(cofactorM, m) order-positive m-positive m-divides-m]
                                                          @m-le-m |
                                                            less_than(cofactorM, m) or cofactorM = m
                                                            [using tautology m-at-most]
                                                          @conclusion-not-m-less |
                                                            not less_than(m, cofactorM)
                                                            case m-le-m {
                                                              @when-strict |
                                                                assume less_than(cofactorM, m) {
                                                                  @m-strictly-less |
                                                                    less_than(cofactorM, m)
                                                                    [by hypothesis when-strict]
                                                                  @suppose-m-less |
                                                                    assume less_than(m, cofactorM) {
                                                                      @m-less-here |
                                                                        less_than(m, cofactorM)
                                                                        [by hypothesis suppose-m-less]
                                                                      @m-less-m |
                                                                        less_than(cofactorM, cofactorM)
                                                                        [using specialize int_divides.lessThanTransitive(cofactorM, m, cofactorM) m-strictly-less m-less-here]
                                                                      @not-m-less-m |
                                                                        not less_than(cofactorM, cofactorM)
                                                                        [using specialize int_divides.lessThanIrreflexive(cofactorM)]
                                                                    }
                                                                  @not-less-strict |
                                                                    not less_than(m, cofactorM)
                                                                    [by not_intro suppose-m-less m-less-m not-m-less-m]
                                                                }
                                                              @when-equal |
                                                                assume cofactorM = m {
                                                                  @m-equals |
                                                                    cofactorM = m
                                                                    [by hypothesis when-equal]
                                                                  @not-less-self |
                                                                    not less_than(m, m)
                                                                    [using specialize int_divides.lessThanIrreflexive(m)]
                                                                  @not-less-equal |
                                                                    not less_than(m, cofactorM)
                                                                    [by rewrite m-equals not-less-self]
                                                                }
                                                            }
                                                        }
                                                      @not-m-less-exported |
                                                        not less_than(m, cofactorM)
                                                        [by exists_elim with-t]
                                                    }
                                                  // the assumption (A^k)^m = e yields m < M (given) and not(m < M): contradiction.
                                                  @conclusion-neq |
                                                    power(power(A, mul(d, cofactorK)), m) != E
                                                    [by not_intro given-killed m-less-order not-m-less-exported]
                                                }
                                              @m-less-implies |
                                                less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                                                [by implies_intro given-m-less]
                                            }
                                          @m-positive-implies |
                                            less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                                            [by implies_intro given-m-positive]
                                        }
                                      @conclusion-all-m |
                                        forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                                        [by forall_intro generalize-m]
                                    }
                                  @bezout-implies |
                                    add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                                    [by implies_intro given-bezout]
                                }
                              @n-split-implies |
                                N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                                [by implies_intro given-n-split]
                            }
                          @order-positive-implies |
                            less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                            [by implies_intro given-m-positive-order]
                        }
                      @d-positive-implies |
                        less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                        [by implies_intro given-d-positive]
                    }
                  @discharge-bezoutQ |
                    forall bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                    [by forall_intro generalize-bezoutQ]
                }
              @discharge-bezoutP |
                forall bezoutP, bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
                [by forall_intro generalize-bezoutP]
            }
          @discharge-cofactorM |
            forall cofactorM, bezoutP, bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
            [by forall_intro generalize-cofactorM]
        }
      @discharge-cofactorK |
        forall cofactorK, cofactorM, bezoutP, bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
        [by forall_intro generalize-cofactorK]
    }
  @conclusion |
    forall d, cofactorK, cofactorM, bezoutP, bezoutQ: Int; less_than(ZERO, d) -> less_than(ZERO, cofactorM) -> N = mul(d, cofactorM) -> add(mul(cofactorK, bezoutP), mul(cofactorM, bezoutQ)) = ONE -> forall m: Int; less_than(ZERO, m) -> less_than(m, cofactorM) -> power(power(A, mul(d, cofactorK)), m) != E
    [by forall_intro generalize-d]
qed

// -- ORDER AS A RELATION over arbitrary elements ------------------------------
// The fixed-A/N form above is enough for the main-text theorems, but the exercises
// COMPARE the orders of different elements (|a| = |a⁻¹|, etc.). Turning "the least
// positive period" into a FUNCTION `ord : G → ℕ` needs a choice/definite-description
// operator 2b4m lacks; instead we use the order as a single-valued RELATION
// `hasOrder(g, n)` — "n is the order of g" — which needs no new primitive and lets
// orders be stated and compared. (Same move as `bezout`: existence-form, not a function.)
define hasOrder(g, n) = less_than(ZERO, n) and power(g, n) = E and (forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(g, m) != E)

// the order is unique: an element has at most one order. If m and n both qualify,
// neither can be strictly less than the other (each is minimal), so m = n by trichotomy.
theorem orderIsUnique: forall g: Grp; forall m, n: Int; hasOrder(g, m) -> hasOrder(g, n) -> m = n
proof
  @generalize-g |
    fix g: Grp {
      @generalize-m |
        fix m: Int {
          @generalize-n |
            fix n: Int {
              @given-m |
                assume hasOrder(g, m) {
                  @given-n |
                    assume hasOrder(g, n) {
                      @m-facts |
                        less_than(ZERO, m) and power(g, m) = E and (forall j: Int; less_than(ZERO, j) -> less_than(j, m) -> power(g, j) != E)
                        [by hypothesis given-m]
                      @n-facts |
                        less_than(ZERO, n) and power(g, n) = E and (forall j: Int; less_than(ZERO, j) -> less_than(j, n) -> power(g, j) != E)
                        [by hypothesis given-n]
                      @m-positive |
                        less_than(ZERO, m)
                        [using tautology m-facts]
                      @n-positive |
                        less_than(ZERO, n)
                        [using tautology n-facts]
                      @m-kills |
                        power(g, m) = E
                        [using tautology m-facts]
                      @n-kills |
                        power(g, n) = E
                        [using tautology n-facts]
                      @m-minimal |
                        forall j: Int; less_than(ZERO, j) -> less_than(j, m) -> power(g, j) != E
                        [using tautology m-facts]
                      @n-minimal |
                        forall j: Int; less_than(ZERO, j) -> less_than(j, n) -> power(g, j) != E
                        [using tautology n-facts]
                      // trichotomy on m, n: m<n contradicts n-minimality (m kills g, 0<m<n);
                      // n<m contradicts m-minimality; so m = n.
                      @trichotomy |
                        less_than(m, n) or m = n or less_than(n, m)
                        [using specialize int_divides.trichotomy(m, n)]
                      @conclusion-equal |
                        m = n
                        case trichotomy {
                          @when-m-less-n |
                            assume less_than(m, n) {
                              @m-less-n |
                                less_than(m, n)
                                [by hypothesis when-m-less-n]
                              @m-not-kill |
                                power(g, m) != E
                                [using specialize n-minimal(m) m-positive m-less-n]
                              @m-equals-n |
                                m = n
                                [by absurd m-kills m-not-kill]
                            }
                          @when-equal |
                            assume m = n {
                              @m-equals-n |
                                m = n
                                [by hypothesis when-equal]
                            }
                          @when-n-less-m |
                            assume less_than(n, m) {
                              @n-less-m |
                                less_than(n, m)
                                [by hypothesis when-n-less-m]
                              @n-not-kill |
                                power(g, n) != E
                                [using specialize m-minimal(n) n-positive n-less-m]
                              @m-equals-n |
                                m = n
                                [by absurd n-kills n-not-kill]
                            }
                        }
                    }
                  @n-implies |
                    hasOrder(g, n) -> m = n
                    [by implies_intro given-n]
                }
              @m-implies |
                hasOrder(g, m) -> hasOrder(g, n) -> m = n
                [by implies_intro given-m]
            }
          @discharge-n |
            forall n: Int; hasOrder(g, m) -> hasOrder(g, n) -> m = n
            [by forall_intro generalize-n]
        }
      @discharge-m |
        forall m, n: Int; hasOrder(g, m) -> hasOrder(g, n) -> m = n
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall g: Grp; forall m, n: Int; hasOrder(g, m) -> hasOrder(g, n) -> m = n
    [by forall_intro generalize-g]
qed

// a power of the inverse is the identity iff the corresponding power of g is:
// (g⁻¹)^k = (g^k)⁻¹, and x⁻¹ = e ⟺ x = e.
theorem inversePowerIdentityIff: forall g: Grp; forall k: Int; power(inverse(g), k) = E iff power(g, k) = E
proof
  @generalize-g |
    fix g: Grp {
      @generalize-k |
        fix k: Int {
          @inv-power |
            power(inverse(g), k) = inverse(power(g, k))
            [using specialize group_power.powerInverseBase(g, k)]
          @given-inv-kills |
            assume power(inverse(g), k) = E {
              @inv-kills |
                power(inverse(g), k) = E
                [by hypothesis given-inv-kills]
              @inv-of-power-is-e |
                inverse(power(g, k)) = E
                [using chain inv-power-flipped inv-kills]
              @inv-power-flipped |
                inverse(power(g, k)) = power(inverse(g), k)
                [by symmetry inv-power]
              // inverse(power g k) = E ⟹ power g k = inverse(inverse(power g k)) = inverse(E) = E.
              @invol |
                inverse(inverse(power(g, k))) = power(g, k)
                [using specialize group_power.invInvolution(power(g, k))]
              @inv-of-e |
                inverse(inverse(power(g, k))) = inverse(E)
                [by rewrite inv-of-power-is-e invol-refl]
              @invol-refl |
                inverse(inverse(power(g, k))) = inverse(inverse(power(g, k)))
                [by reflexivity]
              @inverse-of-identity |
                inverse(E) = E
                [using import(group_power) inverseOfIdentity]
              @power-is-inv-inv |
                power(g, k) = inverse(inverse(power(g, k)))
                [by symmetry invol]
              @conclusion-forward |
                power(g, k) = E
                [using chain power-is-inv-inv inv-of-e inverse-of-identity]
            }
          @given-g-kills |
            assume power(g, k) = E {
              @g-kills |
                power(g, k) = E
                [by hypothesis given-g-kills]
              @inv-of-e |
                inverse(power(g, k)) = inverse(E)
                [by rewrite g-kills inv-of-power-refl]
              @inv-of-power-refl |
                inverse(power(g, k)) = inverse(power(g, k))
                [by reflexivity]
              @inverse-of-identity |
                inverse(E) = E
                [using import(group_power) inverseOfIdentity]
              @inv-of-power-is-e |
                inverse(power(g, k)) = E
                [using chain inv-of-e inverse-of-identity]
              @conclusion-backward |
                power(inverse(g), k) = E
                [using chain inv-power inv-of-power-is-e]
            }
          @forward |
            power(inverse(g), k) = E -> power(g, k) = E
            [by implies_intro given-inv-kills]
          @backward |
            power(g, k) = E -> power(inverse(g), k) = E
            [by implies_intro given-g-kills]
          @conclusion-iff |
            power(inverse(g), k) = E iff power(g, k) = E
            [by iff_intro forward backward]
        }
      @discharge-k |
        forall k: Int; power(inverse(g), k) = E iff power(g, k) = E
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall g: Grp; forall k: Int; power(inverse(g), k) = E iff power(g, k) = E
    [by forall_intro generalize-g]
qed

// EXERCISE 23(a): the order of a is the order of a⁻¹ — hasOrder(g, n) → hasOrder(g⁻¹, n).
// g⁻¹ is killed by n (since g is) and minimal (a smaller killing power of g⁻¹ would kill
// g too), so g and g⁻¹ have the same order.
theorem inverseHasSameOrder: forall g: Grp; forall n: Int; hasOrder(g, n) -> hasOrder(inverse(g), n)
proof
  @generalize-g |
    fix g: Grp {
      @generalize-n |
        fix n: Int {
          @given-order |
            assume hasOrder(g, n) {
              @order-facts |
                less_than(ZERO, n) and power(g, n) = E and (forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(g, m) != E)
                [by hypothesis given-order]
              @n-positive |
                less_than(ZERO, n)
                [using tautology order-facts]
              @g-kills |
                power(g, n) = E
                [using tautology order-facts]
              @g-minimal |
                forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(g, m) != E
                [using tautology order-facts]
              // g⁻¹ is killed by n: power(g⁻¹, n) = E iff power(g, n) = E.
              @inv-kills-iff |
                power(inverse(g), n) = E iff power(g, n) = E
                [using specialize inversePowerIdentityIff(g, n)]
              @inv-kills |
                power(inverse(g), n) = E
                [using tautology inv-kills-iff g-kills]
              // minimality for g⁻¹: for 0 < m < n, power(g⁻¹, m) ≠ E (else power(g, m) = E).
              @generalize-m |
                fix m: Int {
                  @given-m-positive |
                    assume less_than(ZERO, m) {
                      @given-m-less |
                        assume less_than(m, n) {
                          @m-positive |
                            less_than(ZERO, m)
                            [by hypothesis given-m-positive]
                          @m-less-n |
                            less_than(m, n)
                            [by hypothesis given-m-less]
                          @g-m-nonzero |
                            power(g, m) != E
                            [using specialize g-minimal(m) m-positive m-less-n]
                          @inv-m-iff |
                            power(inverse(g), m) = E iff power(g, m) = E
                            [using specialize inversePowerIdentityIff(g, m)]
                          @inv-m-nonzero |
                            power(inverse(g), m) != E
                            [using tautology inv-m-iff g-m-nonzero]
                        }
                      @m-less-implies |
                        less_than(m, n) -> power(inverse(g), m) != E
                        [by implies_intro given-m-less]
                    }
                  @m-positive-implies |
                    less_than(ZERO, m) -> less_than(m, n) -> power(inverse(g), m) != E
                    [by implies_intro given-m-positive]
                }
              @inv-minimal |
                forall m: Int; less_than(ZERO, m) -> less_than(m, n) -> power(inverse(g), m) != E
                [by forall_intro generalize-m]
              @conclusion-has-order |
                hasOrder(inverse(g), n)
                [using tautology n-positive inv-kills inv-minimal]
            }
          @order-implies |
            hasOrder(g, n) -> hasOrder(inverse(g), n)
            [by implies_intro given-order]
        }
      @discharge-n |
        forall n: Int; hasOrder(g, n) -> hasOrder(inverse(g), n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall g: Grp; forall n: Int; hasOrder(g, n) -> hasOrder(inverse(g), n)
    [by forall_intro generalize-g]
qed
