// std/group/sequence.b4m — the finite PRODUCT of a sequence of group elements,
// and the n-ary inverse-of-a-product law.
//
// This MODELS the abstract fold of std/sequence.b4m with Value:Grp, combine:op,
// IDENTITY:E, foldUpTo:productUpTo — the ℕ-indexed left-fold `productUpTo(s, n) =
// g₀·g₁·⋯·gₙ₋₁` of the first n entries of a group-valued sequence. It is the group
// twin of std/integer/product.b4m (which models the same fold with mul/ONE).
//
// On top of the fold it proves the n-ary inverse-of-a-product law (Judson §3.2
// Ex 27): (g₀·g₁·⋯·gₙ₋₁)⁻¹ = gₙ₋₁⁻¹·⋯·g₀⁻¹. The right-hand side is a SECOND fold,
// `revProductUpTo`, that PREPENDS each inverse (the opposite nesting to
// productUpTo); the law is an induction on n whose step is the binary invProduct.
// The proof never cites opCommutative, so it holds for every group, abelian or not.

import group <<< "std/group.b4m"
import sequence <<< "std/sequence.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

sort Grp = group.Grp
const E = group.E
func op = group.op
func inverse = group.inverse
axiom opIdentityLeft = group.opIdentityLeft
theorem invProduct = group.invProduct
theorem inverseUnique = group.inverseUnique

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
func sub = peano.sub
pred less_than = peano.less_than
define at_most(a, b) = peano.less_or_equal(a, b)
axiom induction = peano.induction

// -- the finite group product (models sequence.b4m's fold) ------------------

sort Seq
func at(s: Seq, i: Nat) => Grp
func productUpTo(s: Seq, k: Nat) => Grp
axiom productUpToZero: forall s: Seq; productUpTo(s, ZERO) = E
axiom productUpToSucc: forall s: Seq; forall k: Nat; productUpTo(s, succ(k)) = op(productUpTo(s, k), at(s, k))

// -- the sequence-BUILDING postulates ---------------------------------------
//
// `Seq` above is a fresh abstract sort, so the "a sequence with these entries EXISTS"
// clauses of std/sequence.b4m are not inherited — they are postulates about a sequence
// sort, and this file must state its own. They are stated in the SAME shape, so the model
// below can nominate each as the discharger of its std/sequence.b4m twin, which is what
// lets a caller reach them through `GroupSeq`.
//
// Why they cannot simply be transferred: a model transfers THEOREMS, and discharges the
// source's AXIOMS — an axiom is what the model must establish, not what it may inherit.
// These are the model's obligations, met here.

// The SINGLETON [x]: its first entry is x, and its length-one product is x.
axiom seqSingleton: forall x: Grp;
  exists s: Seq; at(s, ZERO) = x and productUpTo(s, succ(ZERO)) = x

// The PREPEND x :: s: head x, tail s shifted up by one.
axiom seqPrepend: forall x: Grp; forall s: Seq;
  exists u: Seq;
  at(u, ZERO) = x
  and (forall i: Nat; at(u, succ(i)) = at(s, i))

// CONCATENATION: the first j entries of s followed by the first k of t — the product over
// the join is the product of the two pieces. This is what "σ = σ₁⋯σ_m and σ = τ₁⋯τ_n, so
// 1 = τ₁⋯τ_n·σ_m⁻¹⋯σ₁⁻¹" needs.
axiom seqConcat: forall s: Seq; forall t: Seq; forall j: Nat; forall k: Nat;
  exists u: Seq;
  (forall i: Nat; less_than(i, j) -> at(u, i) = at(s, i))
  and (forall i: Nat; less_than(i, k) -> at(u, add(j, i)) = at(t, i))
  and productUpTo(u, add(j, k)) = op(productUpTo(s, j), productUpTo(t, k))

// REVERSAL: the first n entries of s in reverse order. Its product is the reversed
// product of inverses (`revProductUpTo`, below) — and its ENTRIES are s's, so a per-entry
// hypothesis (e.g. "every entry is a transposition") carries over. The entry clause is
// what makes this more than `revProductUpTo`: the value alone cannot be concatenated with
// another sequence, and Judson's even/odd argument does exactly that.
axiom seqReverse: forall s: Seq; forall n: Nat;
  exists r: Seq;
  (forall i: Nat; less_than(i, n) -> at(r, i) = at(s, sub(n, succ(i))))
  and productUpTo(r, n) = revProductUpTo(s, n)

// REMOVAL: s with the entry at index m deleted — its length-k product times the removed
// entry recovers s's length-(k+1) product.
axiom seqRemove: forall s: Seq; forall k: Nat; forall m: Nat;
  less_than(m, succ(k)) ->
  exists t: Seq;
  op(productUpTo(t, k), at(s, m)) = productUpTo(s, succ(k))
  and (forall i: Nat; less_than(i, m) -> at(t, i) = at(s, i))
  and (forall i: Nat; at_most(m, i) -> less_than(i, k) -> at(t, i) = at(s, succ(i)))

model GroupSeq {
  sequence.Nat: Nat
  sequence.ZERO: ZERO
  sequence.succ: succ
  sequence.Value: Grp
  sequence.Seq: Seq
  sequence.at: at
  sequence.IDENTITY: E
  sequence.combine: op
  sequence.foldUpTo: productUpTo
  sequence.foldZero <- productUpToZero
  sequence.foldSucc <- productUpToSucc
  sequence.seqSingletonExists <- seqSingleton
  sequence.seqPrependExists <- seqPrepend
  sequence.seqConcatExists <- seqConcat
  sequence.seqRemoveExists <- seqRemove
}

// -- the reversed product of inverses ---------------------------------------
//
// revProductUpTo(s, n) = at(s,n-1)⁻¹ · … · at(s,0)⁻¹ — a PREPEND fold: each step
// multiplies the new inverse on the LEFT (opposite nesting to productUpTo). This
// is exactly the shape the n-ary inverse takes; it is its own recursion rather
// than a model of sequence.b4m's append-fold.
func revProductUpTo(s: Seq, k: Nat) => Grp
axiom revProductZero: forall s: Seq; revProductUpTo(s, ZERO) = E
axiom revProductSucc: forall s: Seq; forall k: Nat; revProductUpTo(s, succ(k)) = op(inverse(at(s, k)), revProductUpTo(s, k))

// -- the identity is its own inverse ----------------------------------------

// inverse(E) = E — from op(E, E) = E (left identity at E) and inverseUnique.
theorem inverseIdentity: inverse(E) = E
proof
  @identity-times-itself |
    op(E, E) = E
    [using specialize opIdentityLeft(E)]
  @identity-is-its-own-inverse |
    E = inverse(E)
    [using specialize inverseUnique(E, E) identity-times-itself]
  @conclusion |
    inverse(E) = E
    [by symmetry identity-is-its-own-inverse]
qed

// -- the n-ary inverse-of-a-product law (Ex 27) -----------------------------

// (g₀·⋯·gₙ₋₁)⁻¹ = gₙ₋₁⁻¹·⋯·g₀⁻¹, by induction on n.
//   base: inv(productUpTo s 0) = inv(E) = E = revProductUpTo s 0.
//   step: inv(productUpTo s (k+1)) = inv(op(P, aₖ)) = op(aₖ⁻¹, inv P)   [invProduct]
//                                  = op(aₖ⁻¹, revProductUpTo s k)        [IH]
//                                  = revProductUpTo s (k+1).             [revProductSucc]
theorem invOfProduct: forall s: Seq; forall n: Nat;
  inverse(productUpTo(s, n)) = revProductUpTo(s, n)
proof
  @generalize-s |
    fix s: Seq {
      @base-case |
        inverse(productUpTo(s, ZERO)) = revProductUpTo(s, ZERO)
        [using simplify productUpToZero revProductZero inverseIdentity]
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume inverse(productUpTo(s, k)) = revProductUpTo(s, k) {
              @inductive-hypothesis |
                inverse(productUpTo(s, k)) = revProductUpTo(s, k)
                [by hypothesis given-inductive-hypothesis]
              @product-at-successor |
                productUpTo(s, succ(k)) = op(productUpTo(s, k), at(s, k))
                [using specialize productUpToSucc(s, k)]
              @inverse-of-the-binary-product |
                inverse(op(productUpTo(s, k), at(s, k))) = op(inverse(at(s, k)), inverse(productUpTo(s, k)))
                [using specialize invProduct(productUpTo(s, k), at(s, k))]
              @inverse-at-successor |
                inverse(productUpTo(s, succ(k))) = op(inverse(at(s, k)), inverse(productUpTo(s, k)))
                [by rewrite product-at-successor inverse-of-the-binary-product]
              @inverse-at-successor-folds-the-tail |
                inverse(productUpTo(s, succ(k))) = op(inverse(at(s, k)), revProductUpTo(s, k))
                [by rewrite inductive-hypothesis inverse-at-successor]
              @reversed-product-at-successor |
                revProductUpTo(s, succ(k)) = op(inverse(at(s, k)), revProductUpTo(s, k))
                [using specialize revProductSucc(s, k)]
              @conclusion-inductive-step |
                inverse(productUpTo(s, succ(k))) = revProductUpTo(s, succ(k))
                [using chain inverse-at-successor-folds-the-tail reversed-product-at-successor]
            }
          @discharge |
            inverse(productUpTo(s, k)) = revProductUpTo(s, k) ->
              inverse(productUpTo(s, succ(k))) = revProductUpTo(s, succ(k))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          inverse(productUpTo(s, k)) = revProductUpTo(s, k) ->
          inverse(productUpTo(s, succ(k))) = revProductUpTo(s, succ(k))
        [by forall_intro induction-step]
      @conclusion-for-s |
        forall n: Nat; inverse(productUpTo(s, n)) = revProductUpTo(s, n)
        [using instantiation induction((fun k: Nat => inverse(productUpTo(s, k)) = revProductUpTo(s, k))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Seq; forall n: Nat; inverse(productUpTo(s, n)) = revProductUpTo(s, n)
    [by forall_intro generalize-s]
qed

// -- the TRANSLATED sequence -------------------------------------------------------------------
// For a group element t and a sequence w, there is a sequence whose first m entries are
// t·w_0, …, t·w_{m-1}. Induction on m: extend by concatenating a singleton holding t·w_m.
// (The permutation layer's `mappedSequenceExists` is the same statement for composition; this
// is the group's, and it is what makes "every coset is the size of the subgroup" hold BY
// CONSTRUCTION rather than by a bijection argument.)
theorem translatedSequenceExists: forall t: Grp; forall w: Seq; forall m: Nat;
  exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = op(t, at(w, j))
proof
  @generalize-t |
    fix t: Grp {
      @generalize-w |
        fix w: Seq {
          // base: vacuous below ZERO — any sequence will do, and a singleton exists.
          @some-sequence-exists |
            exists s: Seq; at(s, ZERO) = t and productUpTo(s, succ(ZERO)) = t
            [using specialize seqSingleton(t)]
          @base-case |
            exists v: Seq; forall j: Nat; less_than(j, ZERO) -> at(v, j) = op(t, at(w, j))
            [by exists_elim with-some-sequence]
          @with-some-sequence |
            unpack s0: Seq from some-sequence-exists {
              @vacuous |
                forall j: Nat; less_than(j, ZERO) -> at(s0, j) = op(t, at(w, j))
                [by forall_intro nothing-below-zero]
              @nothing-below-zero |
                fix j: Nat {
                  @given-below-zero |
                    assume less_than(j, ZERO) {
                      @below-zero |
                        less_than(j, ZERO)
                        [by hypothesis given-below-zero]
                      @not-below-zero |
                        not less_than(j, ZERO)
                        [using specialize peano_order.notLessThanZero(j)]
                      @conclusion-vacuous |
                        at(s0, j) = op(t, at(w, j))
                        [using tautology below-zero not-below-zero]
                    }
                  @below-zero-implies |
                    less_than(j, ZERO) -> at(s0, j) = op(t, at(w, j))
                    [by implies_intro given-below-zero]
                }
              @conclusion-base-inner |
                exists v: Seq; forall j: Nat; less_than(j, ZERO) -> at(v, j) = op(t, at(w, j))
                [by exists_intro(s0) vacuous]
            }
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume exists v: Seq; forall j: Nat; less_than(j, k) -> at(v, j) = op(t, at(w, j)) {
                  @inductive-hypothesis |
                    exists v: Seq; forall j: Nat; less_than(j, k) -> at(v, j) = op(t, at(w, j))
                    [by hypothesis given-inductive-hypothesis]
                  @with-prefix |
                    unpack v: Seq from inductive-hypothesis {
                      @prefix-matches |
                        forall j: Nat; less_than(j, k) -> at(v, j) = op(t, at(w, j))
                        [by hypothesis with-prefix]
                      // the singleton holding t·w_k, concatenated after the first k entries.
                      @singleton-exists |
                        exists s: Seq; at(s, ZERO) = op(t, at(w, k)) and productUpTo(s, succ(ZERO)) = op(t, at(w, k))
                        [using specialize seqSingleton(op(t, at(w, k)))]
                      @with-singleton |
                        unpack s: Seq from singleton-exists {
                          @singleton-facts |
                            at(s, ZERO) = op(t, at(w, k)) and productUpTo(s, succ(ZERO)) = op(t, at(w, k))
                            [by hypothesis with-singleton]
                          @singleton-head |
                            at(s, ZERO) = op(t, at(w, k))
                            [by and_elim_left singleton-facts]
                          @joined-exists |
                            exists u: Seq; (forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i)) and productUpTo(u, add(k, succ(ZERO))) = op(productUpTo(v, k), productUpTo(s, succ(ZERO)))
                            [using specialize seqConcat(v, s, k, succ(ZERO))]
                          @with-joined |
                            unpack u: Seq from joined-exists {
                              @joined-facts |
                                (forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i)) and productUpTo(u, add(k, succ(ZERO))) = op(productUpTo(v, k), productUpTo(s, succ(ZERO)))
                                [by hypothesis with-joined]
                              @joined-below |
                                forall i: Nat; less_than(i, k) -> at(u, i) = at(v, i)
                                [using tautology joined-facts]
                              @joined-at-k |
                                forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(s, i)
                                [using tautology joined-facts]
                              @zero-below-one |
                                less_than(ZERO, succ(ZERO))
                                [using specialize peano_order.lessThanSelf(ZERO)]
                              @joined-head-at-k |
                                at(u, add(k, ZERO)) = at(s, ZERO)
                                [using specialize joined-at-k(ZERO) zero-below-one]
                              @k-plus-zero |
                                add(k, ZERO) = k
                                [using specialize peano.addZeroRight(k)]
                              @joined-at-index-k |
                                at(u, k) = at(s, ZERO)
                                [by rewrite k-plus-zero joined-head-at-k]
                              @joined-value-at-k |
                                at(u, k) = op(t, at(w, k))
                                [using chain joined-at-index-k singleton-head]
                              @matches-below-succ |
                                forall j: Nat; less_than(j, succ(k)) -> at(u, j) = op(t, at(w, j))
                                [by forall_intro entry-matches]
                              @entry-matches |
                                fix j: Nat {
                                  @given-below-succ |
                                    assume less_than(j, succ(k)) {
                                      @below-succ |
                                        less_than(j, succ(k))
                                        [by hypothesis given-below-succ]
                                      @split |
                                        less_than(j, k) or j = k
                                        [using specialize peano_order.lessThanSuccSplit(j, k) below-succ]
                                      @conclusion-matches |
                                        at(u, j) = op(t, at(w, j))
                                        case split {
                                          @when-below |
                                            assume less_than(j, k) {
                                              @below |
                                                less_than(j, k)
                                                [by hypothesis when-below]
                                              @copied |
                                                at(u, j) = at(v, j)
                                                [using specialize joined-below(j) below]
                                              @prefix-at-j |
                                                at(v, j) = op(t, at(w, j))
                                                [using specialize prefix-matches(j) below]
                                              @conclusion-below |
                                                at(u, j) = op(t, at(w, j))
                                                [using chain copied prefix-at-j]
                                            }
                                          @when-at-k |
                                            assume j = k {
                                              @at-k |
                                                j = k
                                                [by hypothesis when-at-k]
                                              @conclusion-at-k |
                                                at(u, j) = op(t, at(w, j))
                                                [by rewrite at-k joined-value-at-k]
                                            }
                                        }
                                    }
                                  @below-succ-implies |
                                    less_than(j, succ(k)) -> at(u, j) = op(t, at(w, j))
                                    [by implies_intro given-below-succ]
                                }
                              @conclusion-joined |
                                exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = op(t, at(w, j))
                                [by exists_intro(u) matches-below-succ]
                            }
                          @conclusion-with-singleton |
                            exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = op(t, at(w, j))
                            [by exists_elim with-joined]
                        }
                      @conclusion-with-prefix |
                        exists v2: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v2, j) = op(t, at(w, j))
                        [by exists_elim with-singleton]
                    }
                  @conclusion-step |
                    exists v: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v, j) = op(t, at(w, j))
                    [by exists_elim with-prefix]
                }
              @induction-step-at-k |
                (exists v: Seq; forall j: Nat; less_than(j, k) -> at(v, j) = op(t, at(w, j))) -> (exists v: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v, j) = op(t, at(w, j)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat; (exists v: Seq; forall j: Nat; less_than(j, k) -> at(v, j) = op(t, at(w, j))) -> (exists v: Seq; forall j: Nat; less_than(j, succ(k)) -> at(v, j) = op(t, at(w, j)))
            [by forall_intro induction-step]
          @conclusion-for-all-m |
            forall m: Nat; exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = op(t, at(w, j))
            [using instantiation induction((fun m: Nat => exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = op(t, at(w, j)))) base-case induction-step-for-all-k]
        }
      @discharge-w |
        forall w: Seq; forall m: Nat; exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = op(t, at(w, j))
        [by forall_intro generalize-w]
    }
  @conclusion |
    forall t: Grp; forall w: Seq; forall m: Nat; exists v: Seq; forall j: Nat; less_than(j, m) -> at(v, j) = op(t, at(w, j))
    [by forall_intro generalize-t]
qed
