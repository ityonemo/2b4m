// std/group/listing.b4m — LISTINGS of group elements: splitting a listing by a predicate.
//
// A sequence of group elements (std/group/sequence.b4m) LISTS a class when its first m
// entries are pairwise distinct and every member of the class is an entry; "G is a finite
// group of order m" is a listing of the whole group. This file's tool is SPLITTING: the
// entries of an injective listing that satisfy a predicate, and those that do not, are
// each listed without repetition, and the two lengths add up to m. (The same tool as
// std/permutation/listing.b4m, for group elements instead of maps.) The predicate is a
// theorem-schema parameter, so the listing conditions are spelled out at each use:
//
//   (forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i)))
//   and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
//   and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))

import group <<< "std/group.b4m"
import group_sequence <<< "std/group/sequence.b4m"
import group_power <<< "std/group/power.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import peano_parity <<< "std/peano/parity.b4m"
import peano_divides <<< "std/peano/divides.b4m"
import peano_subtraction <<< "std/peano/subtraction.b4m"

sort Grp = group.Grp
const E = group.E
func op = group.op
func inverse = group.inverse

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
pred less_than = peano.less_than
axiom induction = peano.induction
axiom addSuccLeft = peano.addSuccLeft
axiom addZeroLeft = peano.addZeroLeft
theorem addZeroRight = peano.addZeroRight
theorem addSuccRight = peano.addSuccRight
theorem notLessThanZero = peano_order.notLessThanZero
theorem lessThanSelf = peano_order.lessThanSelf
theorem lessThanSuccRight = peano_order.lessThanSuccRight
theorem lessThanSuccSplit = peano_order.lessThanSuccSplit
theorem lessThanIrreflexive = peano_order.lessThanIrreflexive
theorem lessThanTransitive = peano_order.lessThanTransitive
theorem succReflectsOrder = peano_order.succReflectsOrder
theorem succPreservesOrder = peano_order.succPreservesOrder
axiom succNotZero = peano.succNotZero
axiom succInjective = peano.succInjective
theorem trichotomy = peano_order.trichotomy
theorem strongInduction = peano_order.strongInduction
axiom lessThanIntro = peano_order.lessThanIntro
theorem zeroOrSucc = peano.zeroOrSucc
theorem mulZeroRight = peano.mulZeroRight
theorem mulSuccRight = peano.mulSuccRight
axiom oneIsSuccZero = peano.oneIsSuccZero
theorem subAddCancel = peano_subtraction.subAddCancel
func sub = peano.sub
func mul = peano.mul
const ONE = peano.ONE
define TWO = peano_parity.TWO
define divides(d, n) = peano.divides(d, n)
theorem dividesZero = peano_divides.dividesZero
theorem dividesAdd = peano_divides.dividesAdd
theorem dividesSub = peano_divides.dividesSub
theorem dividesRefl = peano_divides.dividesRefl
theorem invInvolution = group.invInvolution
theorem inverseUnique = group.inverseUnique
sort Int = group_power.Int
const IZERO = group_power.ZERO
func isucc = group_power.succ
func iprev = group_power.prev
func ineg = group_power.neg
func power = group_power.power
axiom powerZero = group_power.powerZero
axiom powerSucc = group_power.powerSucc
axiom powerPrev = group_power.powerPrev
theorem powerNegInverse = group_power.powerNegInverse
theorem powerInverseBase = group_power.powerInverseBase
theorem intInduction = group_power.induction
theorem opInverseRight = group.opInverseRight
axiom opIdentityLeft = group.opIdentityLeft

sort Seq = group_sequence.Seq
func at = group_sequence.at
func productUpTo = group_sequence.productUpTo
axiom seqSingleton = group_sequence.seqSingleton
axiom seqConcat = group_sequence.seqConcat

// Skipping an entry that fails prop: the sub-listing below k is the sub-listing below k+1.
theorem skippingAnEntry(prop: Grp -> Prop): forall w: Seq; forall k: Nat; (not prop(at(w, k))) ->
  forall v: Seq; forall p: Nat;
  ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i)))
  and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
  and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
  ->
  ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i)))
  and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
  and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
proof
  @generalize-w |
    fix w: Seq {
      @generalize-k |
        fix k: Nat {
          @given-entry-fails |
            assume not prop(at(w, k)) {
              @entry-fails |
                not prop(at(w, k))
                [by hypothesis given-entry-fails]
              @generalize-v |
                fix v: Seq {
                  @generalize-p |
                    fix p: Nat {
                      @given-sublisting |
                        assume (forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)) {
                          @sublisting |
                            (forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))
                            [by hypothesis given-sublisting]
                          @entries |
                            forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                            [using tautology sublisting]
                          @injective |
                            forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j
                            [using tautology sublisting]
                          @covers |
                            forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                            [using tautology sublisting]

                          // entries: the source index moves up a range
                          @generalize-j-for-entries |
                            fix j: Nat {
                              @given-j-in-range |
                                assume less_than(j, p) {
                                  @j-in-range |
                                    less_than(j, p)
                                    [by hypothesis given-j-in-range]
                                  @source-exists |
                                    exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                    [using specialize entries(j) j-in-range]
                                  @with-source-i |
                                    unpack i: Nat from source-exists {
                                      @source-facts |
                                        less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                        [by hypothesis with-source-i]
                                      @i-below-k |
                                        less_than(i, k)
                                        [using tautology source-facts]
                                      @i-below-succ-k |
                                        less_than(i, succ(k))
                                        [using specialize lessThanSuccRight(i, k) i-below-k]
                                      @source-facts-moved |
                                        less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))
                                        [using tautology source-facts i-below-succ-k]
                                      @conclusion-witness-i |
                                        exists i2: Nat; less_than(i2, succ(k)) and at(v, j) = at(w, i2) and prop(at(w, i2))
                                        [by exists_intro(i) source-facts-moved]
                                    }
                                  @conclusion-source-moved |
                                    exists i2: Nat; less_than(i2, succ(k)) and at(v, j) = at(w, i2) and prop(at(w, i2))
                                    [by exists_elim with-source-i]
                                }
                              @conclusion-entry-clause |
                                less_than(j, p) -> exists i2: Nat; less_than(i2, succ(k)) and at(v, j) = at(w, i2) and prop(at(w, i2))
                                [by implies_intro given-j-in-range]
                            }
                          @entries-moved |
                            forall j: Nat; less_than(j, p) -> exists i2: Nat; less_than(i2, succ(k)) and at(v, j) = at(w, i2) and prop(at(w, i2))
                            [by forall_intro generalize-j-for-entries]

                          // covering: the new index k fails prop, so nothing new to cover
                          @generalize-i-for-covers |
                            fix i: Nat {
                              @given-i-below-succ-k |
                                assume less_than(i, succ(k)) {
                                  @given-i-satisfies |
                                    assume prop(at(w, i)) {
                                      @i-below-succ-k |
                                        less_than(i, succ(k))
                                        [by hypothesis given-i-below-succ-k]
                                      @i-satisfies |
                                        prop(at(w, i))
                                        [by hypothesis given-i-satisfies]
                                      @i-splits |
                                        less_than(i, k) or i = k
                                        [using specialize lessThanSuccSplit(i, k) i-below-succ-k]
                                      @conclusion-covered |
                                        exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                        case i-splits {
                                          @when-i-below-k |
                                            assume less_than(i, k) {
                                              @i-below-k |
                                                less_than(i, k)
                                                [by hypothesis when-i-below-k]
                                              @conclusion-covered-below |
                                                exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                                [using specialize covers(i) i-below-k i-satisfies]
                                            }
                                          @when-i-is-k |
                                            assume i = k {
                                              @i-is-k |
                                                i = k
                                                [by hypothesis when-i-is-k]
                                              @k-satisfies |
                                                prop(at(w, k))
                                                [by rewrite i-is-k i-satisfies]
                                              @conclusion-covered-absurdly |
                                                exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                                [by absurd k-satisfies entry-fails]
                                            }
                                        }
                                    }
                                  @conclusion-given-satisfies |
                                    prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                    [by implies_intro given-i-satisfies]
                                }
                              @conclusion-covers-at-i |
                                less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                [by implies_intro given-i-below-succ-k]
                            }
                          @covers-moved |
                            forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                            [by forall_intro generalize-i-for-covers]
                          @conclusion-sublisting-moved |
                            (forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))
                            [using tautology entries-moved injective covers-moved]
                        }
                      @conclusion-at-p |
                        ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                        [by implies_intro given-sublisting]
                    }
                  @discharge-p |
                    forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                    [by forall_intro generalize-p]
                }
              @discharge-v |
                forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                [by forall_intro generalize-v]
            }
          @conclusion-at-k |
            (not prop(at(w, k))) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
            [by implies_intro given-entry-fails]
        }
      @discharge-k |
        forall k: Nat; (not prop(at(w, k))) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall w: Seq; forall k: Nat; (not prop(at(w, k))) ->
      forall v: Seq; forall p: Nat;
      ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i)))
      and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
      and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
      ->
      ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i)))
      and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
      and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
    [by forall_intro generalize-w]
qed

// Appending an entry that satisfies prop: concatenate the sub-listing with the singleton
// (at(w, k)); the new last entry is at(w, k), which differs from every earlier entry since w
// does not repeat below m.
theorem extendingASublisting(prop: Grp -> Prop): forall w: Seq; forall m: Nat;
  (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) ->
  forall k: Nat; less_than(k, m) -> prop(at(w, k)) ->
  forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) ->
  exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
proof
  @generalize-w |
    fix w: Seq {
      @generalize-m |
        fix m: Nat {
          @given-w-injective |
            assume (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) {
              @w-injective |
                (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j)
                [by hypothesis given-w-injective]
              @generalize-k |
                fix k: Nat {
                  @given-k-in-range |
                    assume less_than(k, m) {
                      @given-entry-satisfies |
                        assume prop(at(w, k)) {
                          @k-in-range |
                            less_than(k, m)
                            [by hypothesis given-k-in-range]
                          @entry-k-satisfies |
                            prop(at(w, k))
                            [by hypothesis given-entry-satisfies]
                          @generalize-v |
                            fix v: Seq {
                              @generalize-p |
                                fix p: Nat {
                                  @given-sublisting |
                                    assume ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) {
                                      @sublisting |
                                        ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                                        [by hypothesis given-sublisting]
                                      @entries |
                                        forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                        [using tautology sublisting]
                                      @injective |
                                        forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j
                                        [using tautology sublisting]
                                      @covers |
                                        forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                        [using tautology sublisting]
                                      @singleton-exists |
                                        exists s: Seq; at(s, ZERO) = at(w, k) and productUpTo(s, succ(ZERO)) = at(w, k)
                                        [using specialize seqSingleton(at(w, k))]
                                      @k-below-succ-k |
                                        less_than(k, succ(k))
                                        [using specialize lessThanSelf(k)]
                                      @p-below-succ-p |
                                        less_than(p, succ(p))
                                        [using specialize lessThanSelf(p)]
                                      @with-singleton-s |
                                        unpack s: Seq from singleton-exists {
                                          @singleton-facts |
                                            at(s, ZERO) = at(w, k) and productUpTo(s, succ(ZERO)) = at(w, k)
                                            [by hypothesis with-singleton-s]
                                          @singleton-head |
                                            at(s, ZERO) = at(w, k)
                                            [by and_elim_left singleton-facts]
                                          @concatenation-exists |
                                            exists u: Seq; (forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i)) and productUpTo(u, add(p, succ(ZERO))) = op(productUpTo(v, p), productUpTo(s, succ(ZERO)))
                                            [using specialize seqConcat(v, s, p, succ(ZERO))]
                                          @with-concatenation-u |
                                            unpack u: Seq from concatenation-exists {
                                              @concatenation-facts |
                                                (forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i)) and productUpTo(u, add(p, succ(ZERO))) = op(productUpTo(v, p), productUpTo(s, succ(ZERO)))
                                                [by hypothesis with-concatenation-u]
                                              @agreement-pair |
                                                (forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i))
                                                [by and_elim_left concatenation-facts]
                                              @prefix-agrees |
                                                forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)
                                                [by and_elim_left agreement-pair]
                                              @block-agrees |
                                                forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i)
                                                [by and_elim_right agreement-pair]
                                              @zero-below-one |
                                                less_than(ZERO, succ(ZERO))
                                                [using specialize lessThanSelf(ZERO)]
                                              @u-at-p-plus-zero |
                                                at(u, add(p, ZERO)) = at(s, ZERO)
                                                [using specialize block-agrees(ZERO) zero-below-one]
                                              @p-plus-zero-is-p |
                                                add(p, ZERO) = p
                                                [using specialize addZeroRight(p)]
                                              @u-at-p |
                                                at(u, p) = at(s, ZERO)
                                                [by rewrite p-plus-zero-is-p u-at-p-plus-zero]
                                              @last-entry-is-entry-k |
                                                at(u, p) = at(w, k)
                                                [using chain u-at-p singleton-head]

                                              // entries: the old ones, and the new last one
                                              @generalize-j-for-entries |
                                                fix j: Nat {
                                                  @given-j-in-range |
                                                    assume less_than(j, succ(p)) {
                                                      @j-in-range |
                                                        less_than(j, succ(p))
                                                        [by hypothesis given-j-in-range]
                                                      @j-splits |
                                                        less_than(j, p) or j = p
                                                        [using specialize lessThanSuccSplit(j, p) j-in-range]
                                                      @conclusion-entry-has-a-source |
                                                        exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                        case j-splits {
                                                          @when-j-old |
                                                            assume less_than(j, p) {
                                                              @j-old |
                                                                less_than(j, p)
                                                                [by hypothesis when-j-old]
                                                              @entry-is-old-entry |
                                                                at(u, j) = at(v, j)
                                                                [using specialize prefix-agrees(j) j-old]
                                                              @source-exists |
                                                                exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                                                [using specialize entries(j) j-old]
                                                              @with-source-i |
                                                                unpack i: Nat from source-exists {
                                                                  @source-facts |
                                                                    less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                                                    [by hypothesis with-source-i]
                                                                  @i-below-k |
                                                                    less_than(i, k)
                                                                    [using tautology source-facts]
                                                                  @old-entry-is-source |
                                                                    at(v, j) = at(w, i)
                                                                    [using tautology source-facts]
                                                                  @i-below-succ-k |
                                                                    less_than(i, succ(k))
                                                                    [using specialize lessThanSuccRight(i, k) i-below-k]
                                                                  @entry-is-source |
                                                                    at(u, j) = at(w, i)
                                                                    [using chain entry-is-old-entry old-entry-is-source]
                                                                  @source-facts-for-u |
                                                                    less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                                    [using tautology source-facts i-below-succ-k entry-is-source]
                                                                  @conclusion-witness-i |
                                                                    exists i2: Nat; less_than(i2, succ(k)) and at(u, j) = at(w, i2) and prop(at(w, i2))
                                                                    [by exists_intro(i) source-facts-for-u]
                                                                }
                                                              @conclusion-old-source |
                                                                exists i2: Nat; less_than(i2, succ(k)) and at(u, j) = at(w, i2) and prop(at(w, i2))
                                                                [by exists_elim with-source-i]
                                                            }
                                                          @when-j-new |
                                                            assume j = p {
                                                              @j-new |
                                                                j = p
                                                                [by hypothesis when-j-new]
                                                              @entry-is-entry-k |
                                                                at(u, j) = at(w, k)
                                                                [by rewrite j-new last-entry-is-entry-k]
                                                              @source-facts-for-k |
                                                                less_than(k, succ(k)) and at(u, j) = at(w, k) and prop(at(w, k))
                                                                [using tautology k-below-succ-k entry-is-entry-k entry-k-satisfies]
                                                              @conclusion-new-source |
                                                                exists i2: Nat; less_than(i2, succ(k)) and at(u, j) = at(w, i2) and prop(at(w, i2))
                                                                [by exists_intro(k) source-facts-for-k]
                                                            }
                                                        }
                                                    }
                                                  @conclusion-entry-clause |
                                                    less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                    [by implies_intro given-j-in-range]
                                                }
                                              @entries-extended |
                                                forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                [by forall_intro generalize-j-for-entries]

                                              // no repeats: an old entry is some at(w, i0) with i0 < k, never at(w, k)
                                              @generalize-i-for-injective |
                                                fix i: Nat {
                                                  @generalize-j-for-injective |
                                                    fix j: Nat {
                                                      @given-i-in-range |
                                                        assume less_than(i, succ(p)) {
                                                          @given-j-in-range-too |
                                                            assume less_than(j, succ(p)) {
                                                              @given-entries-equal |
                                                                assume at(u, i) = at(u, j) {
                                                                  @i-in-range |
                                                                    less_than(i, succ(p))
                                                                    [by hypothesis given-i-in-range]
                                                                  @j-in-range-too |
                                                                    less_than(j, succ(p))
                                                                    [by hypothesis given-j-in-range-too]
                                                                  @entries-equal |
                                                                    at(u, i) = at(u, j)
                                                                    [by hypothesis given-entries-equal]
                                                                  @i-splits |
                                                                    less_than(i, p) or i = p
                                                                    [using specialize lessThanSuccSplit(i, p) i-in-range]
                                                                  @j-splits |
                                                                    less_than(j, p) or j = p
                                                                    [using specialize lessThanSuccSplit(j, p) j-in-range-too]
                                                                  @conclusion-indices-equal |
                                                                    i = j
                                                                    case i-splits {
                                                                      @when-i-old |
                                                                        assume less_than(i, p) {
                                                                          @i-old |
                                                                            less_than(i, p)
                                                                            [by hypothesis when-i-old]
                                                                          @entry-i-is-old |
                                                                            at(u, i) = at(v, i)
                                                                            [using specialize prefix-agrees(i) i-old]
                                                                          @conclusion-from-old-i |
                                                                            i = j
                                                                            case j-splits {
                                                                              @when-j-old |
                                                                                assume less_than(j, p) {
                                                                                  @j-old |
                                                                                    less_than(j, p)
                                                                                    [by hypothesis when-j-old]
                                                                                  @entry-j-is-old |
                                                                                    at(u, j) = at(v, j)
                                                                                    [using specialize prefix-agrees(j) j-old]
                                                                                  @old-i-is-entry-j |
                                                                                    at(v, i) = at(u, j)
                                                                                    [by rewrite entry-i-is-old entries-equal]
                                                                                  @old-entries-equal |
                                                                                    at(v, i) = at(v, j)
                                                                                    [by rewrite entry-j-is-old old-i-is-entry-j]
                                                                                  @conclusion-both-old |
                                                                                    i = j
                                                                                    [using specialize injective(i, j) i-old j-old old-entries-equal]
                                                                                }
                                                                              @when-j-new |
                                                                                assume j = p {
                                                                                  @j-new |
                                                                                    j = p
                                                                                    [by hypothesis when-j-new]
                                                                                  @entry-j-is-entry-k |
                                                                                    at(u, j) = at(w, k)
                                                                                    [by rewrite j-new last-entry-is-entry-k]
                                                                                  @old-i-is-entry-j |
                                                                                    at(v, i) = at(u, j)
                                                                                    [by rewrite entry-i-is-old entries-equal]
                                                                                  @old-i-is-entry-k |
                                                                                    at(v, i) = at(w, k)
                                                                                    [by rewrite entry-j-is-entry-k old-i-is-entry-j]
                                                                                  @source-exists |
                                                                                    exists i0: Nat; less_than(i0, k) and at(v, i) = at(w, i0) and prop(at(w, i0))
                                                                                    [using specialize entries(i) i-old]
                                                                                  @with-source-i0 |
                                                                                    unpack i0: Nat from source-exists {
                                                                                      @source-facts |
                                                                                        less_than(i0, k) and at(v, i) = at(w, i0) and prop(at(w, i0))
                                                                                        [by hypothesis with-source-i0]
                                                                                      @i0-below-k |
                                                                                        less_than(i0, k)
                                                                                        [using tautology source-facts]
                                                                                      @old-i-is-source |
                                                                                        at(v, i) = at(w, i0)
                                                                                        [using tautology source-facts]
                                                                                      @i0-in-range |
                                                                                        less_than(i0, m)
                                                                                        [using specialize lessThanTransitive(i0, k, m) i0-below-k k-in-range]
                                                                                      @source-is-entry-k |
                                                                                        at(w, i0) = at(w, k)
                                                                                        [by rewrite old-i-is-source old-i-is-entry-k]
                                                                                      @i0-is-k |
                                                                                        i0 = k
                                                                                        [using specialize w-injective(i0, k) i0-in-range k-in-range source-is-entry-k]
                                                                                      @k-below-itself |
                                                                                        less_than(k, k)
                                                                                        [by rewrite i0-is-k i0-below-k]
                                                                                      @k-not-below-itself |
                                                                                        not less_than(k, k)
                                                                                        [using specialize lessThanIrreflexive(k)]
                                                                                      @conclusion-old-new-absurd |
                                                                                        i = j
                                                                                        [by absurd k-below-itself k-not-below-itself]
                                                                                    }
                                                                                  @conclusion-old-then-new |
                                                                                    i = j
                                                                                    [by exists_elim with-source-i0]
                                                                                }
                                                                            }
                                                                        }
                                                                      @when-i-new |
                                                                        assume i = p {
                                                                          @i-new |
                                                                            i = p
                                                                            [by hypothesis when-i-new]
                                                                          @entry-i-is-entry-k |
                                                                            at(u, i) = at(w, k)
                                                                            [by rewrite i-new last-entry-is-entry-k]
                                                                          @conclusion-from-new-i |
                                                                            i = j
                                                                            case j-splits {
                                                                              @when-j-old |
                                                                                assume less_than(j, p) {
                                                                                  @j-old |
                                                                                    less_than(j, p)
                                                                                    [by hypothesis when-j-old]
                                                                                  @entry-j-is-old |
                                                                                    at(u, j) = at(v, j)
                                                                                    [using specialize prefix-agrees(j) j-old]
                                                                                  @entry-i-is-old-j |
                                                                                    at(u, i) = at(v, j)
                                                                                    [by rewrite entry-j-is-old entries-equal]
                                                                                  @old-j-is-entry-k |
                                                                                    at(v, j) = at(w, k)
                                                                                    [by rewrite entry-i-is-old-j entry-i-is-entry-k]
                                                                                  @source-exists |
                                                                                    exists j0: Nat; less_than(j0, k) and at(v, j) = at(w, j0) and prop(at(w, j0))
                                                                                    [using specialize entries(j) j-old]
                                                                                  @with-source-j0 |
                                                                                    unpack j0: Nat from source-exists {
                                                                                      @source-facts |
                                                                                        less_than(j0, k) and at(v, j) = at(w, j0) and prop(at(w, j0))
                                                                                        [by hypothesis with-source-j0]
                                                                                      @j0-below-k |
                                                                                        less_than(j0, k)
                                                                                        [using tautology source-facts]
                                                                                      @old-j-is-source |
                                                                                        at(v, j) = at(w, j0)
                                                                                        [using tautology source-facts]
                                                                                      @j0-in-range |
                                                                                        less_than(j0, m)
                                                                                        [using specialize lessThanTransitive(j0, k, m) j0-below-k k-in-range]
                                                                                      @source-is-entry-k |
                                                                                        at(w, j0) = at(w, k)
                                                                                        [by rewrite old-j-is-source old-j-is-entry-k]
                                                                                      @j0-is-k |
                                                                                        j0 = k
                                                                                        [using specialize w-injective(j0, k) j0-in-range k-in-range source-is-entry-k]
                                                                                      @k-below-itself |
                                                                                        less_than(k, k)
                                                                                        [by rewrite j0-is-k j0-below-k]
                                                                                      @k-not-below-itself |
                                                                                        not less_than(k, k)
                                                                                        [using specialize lessThanIrreflexive(k)]
                                                                                      @conclusion-new-old-absurd |
                                                                                        i = j
                                                                                        [by absurd k-below-itself k-not-below-itself]
                                                                                    }
                                                                                  @conclusion-new-then-old |
                                                                                    i = j
                                                                                    [by exists_elim with-source-j0]
                                                                                }
                                                                              @when-j-new |
                                                                                assume j = p {
                                                                                  @j-new |
                                                                                    j = p
                                                                                    [by hypothesis when-j-new]
                                                                                  @conclusion-both-new |
                                                                                    i = j
                                                                                    [by rewrite j-new i-new]
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                              @conclusion-given-equal |
                                                                at(u, i) = at(u, j) -> i = j
                                                                [by implies_intro given-entries-equal]
                                                            }
                                                          @conclusion-given-j |
                                                            less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                            [by implies_intro given-j-in-range-too]
                                                        }
                                                      @conclusion-injective-at-i-j |
                                                        less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                        [by implies_intro given-i-in-range]
                                                    }
                                                  @discharge-j-for-injective |
                                                    forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                    [by forall_intro generalize-j-for-injective]
                                                }
                                              @injective-extended |
                                                forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                [by forall_intro generalize-i-for-injective]

                                              // covering: an old source is covered as before, the new one by the last entry
                                              @generalize-i-for-covers |
                                                fix i: Nat {
                                                  @given-i-below-succ-k |
                                                    assume less_than(i, succ(k)) {
                                                      @given-i-satisfies |
                                                        assume prop(at(w, i)) {
                                                          @i-below-succ-k |
                                                            less_than(i, succ(k))
                                                            [by hypothesis given-i-below-succ-k]
                                                          @i-satisfies |
                                                            prop(at(w, i))
                                                            [by hypothesis given-i-satisfies]
                                                          @i-splits |
                                                            less_than(i, k) or i = k
                                                            [using specialize lessThanSuccSplit(i, k) i-below-succ-k]
                                                          @conclusion-covered |
                                                            exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                            case i-splits {
                                                              @when-i-below-k |
                                                                assume less_than(i, k) {
                                                                  @i-below-k |
                                                                    less_than(i, k)
                                                                    [by hypothesis when-i-below-k]
                                                                  @old-index-exists |
                                                                    exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                                                    [using specialize covers(i) i-below-k i-satisfies]
                                                                  @with-old-index-j |
                                                                    unpack j: Nat from old-index-exists {
                                                                      @old-index-facts |
                                                                        less_than(j, p) and at(v, j) = at(w, i)
                                                                        [by hypothesis with-old-index-j]
                                                                      @j-old |
                                                                        less_than(j, p)
                                                                        [by and_elim_left old-index-facts]
                                                                      @old-entry-is-source |
                                                                        at(v, j) = at(w, i)
                                                                        [by and_elim_right old-index-facts]
                                                                      @j-in-range |
                                                                        less_than(j, succ(p))
                                                                        [using specialize lessThanSuccRight(j, p) j-old]
                                                                      @entry-is-old-entry |
                                                                        at(u, j) = at(v, j)
                                                                        [using specialize prefix-agrees(j) j-old]
                                                                      @entry-is-source |
                                                                        at(u, j) = at(w, i)
                                                                        [using chain entry-is-old-entry old-entry-is-source]
                                                                      @j-in-range-and-hits |
                                                                        less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                                        [by and_intro j-in-range entry-is-source]
                                                                      @conclusion-witness-j |
                                                                        exists j2: Nat; less_than(j2, succ(p)) and at(u, j2) = at(w, i)
                                                                        [by exists_intro(j) j-in-range-and-hits]
                                                                    }
                                                                  @conclusion-covered-below |
                                                                    exists j2: Nat; less_than(j2, succ(p)) and at(u, j2) = at(w, i)
                                                                    [by exists_elim with-old-index-j]
                                                                }
                                                              @when-i-is-k |
                                                                assume i = k {
                                                                  @i-is-k |
                                                                    i = k
                                                                    [by hypothesis when-i-is-k]
                                                                  @last-entry-is-source |
                                                                    at(u, p) = at(w, i)
                                                                    [by rewrite i-is-k last-entry-is-entry-k]
                                                                  @p-in-range-and-hits |
                                                                    less_than(p, succ(p)) and at(u, p) = at(w, i)
                                                                    [by and_intro p-below-succ-p last-entry-is-source]
                                                                  @conclusion-covered-by-last |
                                                                    exists j2: Nat; less_than(j2, succ(p)) and at(u, j2) = at(w, i)
                                                                    [by exists_intro(p) p-in-range-and-hits]
                                                                }
                                                            }
                                                        }
                                                      @conclusion-given-satisfies |
                                                        prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                        [by implies_intro given-i-satisfies]
                                                    }
                                                  @conclusion-covers-at-i |
                                                    less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                    [by implies_intro given-i-below-succ-k]
                                                }
                                              @covers-extended |
                                                forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                [by forall_intro generalize-i-for-covers]
                                              @extended-sublisting |
                                                ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)))
                                                [using tautology entries-extended injective-extended covers-extended]
                                              @conclusion-witness-u |
                                                exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                                [by exists_intro(u) extended-sublisting]
                                            }
                                          @conclusion-with-u |
                                            exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                            [by exists_elim with-concatenation-u]
                                        }
                                      @conclusion-with-s |
                                        exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                        [by exists_elim with-singleton-s]
                                    }
                                  @conclusion-at-p |
                                    ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                    [by implies_intro given-sublisting]
                                }
                              @discharge-p |
                                forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                [by forall_intro generalize-p]
                            }
                          @discharge-v |
                            forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                            [by forall_intro generalize-v]
                        }
                      @conclusion-given-satisfies |
                        prop(at(w, k)) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                        [by implies_intro given-entry-satisfies]
                    }
                  @conclusion-at-k |
                    less_than(k, m) -> prop(at(w, k)) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                    [by implies_intro given-k-in-range]
                }
              @discharge-k |
                forall k: Nat; less_than(k, m) -> prop(at(w, k)) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                [by forall_intro generalize-k]
            }
          @conclusion-at-m |
            (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, m) -> prop(at(w, k)) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
            [by implies_intro given-w-injective]
        }
      @discharge-m |
        forall m: Nat; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, m) -> prop(at(w, k)) -> forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall w: Seq; forall m: Nat;
      (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) ->
      forall k: Nat; less_than(k, m) -> prop(at(w, k)) ->
      forall v: Seq; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) ->
      exists v2: Seq; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
    [by forall_intro generalize-w]
qed

// The entries of w below k split into those satisfying prop and those not, each listed
// without repetition, with lengths adding to k: induction on k, extending one sub-listing
// and skipping in the other according to whether at(w, k) satisfies prop.
theorem splittingAPrefix(prop: Grp -> Prop): forall w: Seq; forall m: Nat; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, succ(m)) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
proof
  @generalize-w |
    fix w: Seq {
      @generalize-m |
        fix m: Nat {
          @given-w-injective |
            assume (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) {
              @w-injective |
                (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j)
                [by hypothesis given-w-injective]

              // base case: nothing below ZERO, so the empty sub-listings (any sequence, length ZERO)
              @base-case-proof |
                assume less_than(ZERO, succ(m)) {
                  @some-sequence-exists |
                    exists u: Seq; at(u, ZERO) = E and productUpTo(u, succ(ZERO)) = E
                    [using specialize seqSingleton(E)]
                  @zero-plus-zero |
                    add(ZERO, ZERO) = ZERO
                    [using specialize addZeroLeft(ZERO)]
                  @with-any-u |
                    unpack u: Seq from some-sequence-exists {
                      @vacuous-entries |
                        fix j: Nat {
                          @nothing-below-zero |
                            not less_than(j, ZERO)
                            [using specialize notLessThanZero(j)]
                          @conclusion-vacuous-entry |
                            less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))
                            [using tautology nothing-below-zero]
                        }
                      @no-entries |
                        forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))
                        [by forall_intro vacuous-entries]
                      @vacuous-entries-complement |
                        fix j: Nat {
                          @nothing-below-zero |
                            not less_than(j, ZERO)
                            [using specialize notLessThanZero(j)]
                          @conclusion-vacuous-entry-complement |
                            less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and (not prop(at(w, i)))
                            [using tautology nothing-below-zero]
                        }
                      @no-entries-complement |
                        forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and (not prop(at(w, i)))
                        [by forall_intro vacuous-entries-complement]
                      @vacuous-injective |
                        fix i: Nat {
                          @vacuous-injective-inner |
                            fix j: Nat {
                              @nothing-below-zero |
                                not less_than(i, ZERO)
                                [using specialize notLessThanZero(i)]
                              @conclusion-vacuous-injective-clause |
                                less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j
                                [using tautology nothing-below-zero]
                            }
                          @discharge-j-vacuous |
                            forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j
                            [by forall_intro vacuous-injective-inner]
                        }
                      @no-collisions |
                        forall i: Nat; forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j
                        [by forall_intro vacuous-injective]
                      @vacuous-covers |
                        fix i: Nat {
                          @nothing-below-zero |
                            not less_than(i, ZERO)
                            [using specialize notLessThanZero(i)]
                          @conclusion-vacuous-covers-clause |
                            less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i)
                            [using tautology nothing-below-zero]
                        }
                      @nothing-to-cover |
                        forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i)
                        [by forall_intro vacuous-covers]
                      @vacuous-covers-complement |
                        fix i: Nat {
                          @nothing-below-zero |
                            not less_than(i, ZERO)
                            [using specialize notLessThanZero(i)]
                          @conclusion-vacuous-covers-complement-clause |
                            less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i)
                            [using tautology nothing-below-zero]
                        }
                      @nothing-to-cover-complement |
                        forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i)
                        [by forall_intro vacuous-covers-complement]
                      @empty-sublistings |
                        add(ZERO, ZERO) = ZERO and ((forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i))) and ((forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i)))
                        [using tautology zero-plus-zero no-entries no-collisions nothing-to-cover no-entries-complement nothing-to-cover-complement]
                      @with-q |
                        exists q: Nat; add(ZERO, q) = ZERO and ((forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(u, j) = at(w, i)))
                        [by exists_intro(ZERO) empty-sublistings]
                      @with-v2 |
                        exists v2: Seq; exists q: Nat; add(ZERO, q) = ZERO and ((forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, ZERO) and at(u, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [by exists_intro(u) with-q]
                      @with-p |
                        exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = ZERO and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(u, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [by exists_intro(ZERO) with-v2]
                      @conclusion-witness-u |
                        exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = ZERO and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, ZERO) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [by exists_intro(u) with-p]
                    }
                  @conclusion-base |
                    exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = ZERO and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, ZERO) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, ZERO) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, ZERO) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                    [by exists_elim with-any-u]
                }
              @base-case |
