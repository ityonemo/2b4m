                forall k: Nat; less_than(k, succ(m)) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                [using instantiation induction((fun k: Nat => less_than(k, succ(m)) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i))))) base-case induction-step-for-all-k]
            }
          @conclusion-at-m |
            (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, succ(m)) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
            [by implies_intro given-w-injective]
        }
      @discharge-m |
        forall m: Nat; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, succ(m)) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall w: Seq; forall m: Nat; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, succ(m)) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
    [by forall_intro generalize-w]
qed

// SPLITTING A LISTING: the entries of an injective listing satisfying prop, and those not,
// each listed without repetition, with lengths adding to the whole — the prefix splitting
// at the whole length.
theorem splittingAListing(prop: Grp -> Prop): forall m: Nat; forall w: Seq; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-w |
        fix w: Seq {
          @given-w-injective |
            assume (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) {
              @w-injective |
                (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j)
                [by hypothesis given-w-injective]
              @m-below-succ-m |
                less_than(m, succ(m))
                [using specialize lessThanSelf(m)]
              @prefix-splitting |
                forall w0: Seq; forall m0: Nat; (forall i: Nat; forall j: Nat; less_than(i, m0) -> less_than(j, m0) -> at(w0, i) = at(w0, j) -> i = j) -> forall k0: Nat; less_than(k0, succ(m0)) -> exists v0: Seq; exists p0: Nat; exists v20: Seq; exists q0: Nat; add(p0, q0) = k0 and ((forall j: Nat; less_than(j, p0) -> exists i: Nat; less_than(i, k0) and at(v0, j) = at(w0, i) and prop(at(w0, i))) and (forall i: Nat; forall j: Nat; less_than(i, p0) -> less_than(j, p0) -> at(v0, i) = at(v0, j) -> i = j) and (forall i: Nat; less_than(i, k0) -> prop(at(w0, i)) -> exists j: Nat; less_than(j, p0) and at(v0, j) = at(w0, i))) and ((forall j: Nat; less_than(j, q0) -> exists i: Nat; less_than(i, k0) and at(v20, j) = at(w0, i) and (not prop(at(w0, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q0) -> less_than(j, q0) -> at(v20, i) = at(v20, j) -> i = j) and (forall i: Nat; less_than(i, k0) -> (not prop(at(w0, i))) -> exists j: Nat; less_than(j, q0) and at(v20, j) = at(w0, i)))
                [using instantiation splittingAPrefix((fun g: Grp => prop(g)))]
              @conclusion-split |
                exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                [using specialize prefix-splitting(w, m, m) w-injective m-below-succ-m]
            }
          @conclusion-at-w |
            (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
            [by implies_intro given-w-injective]
        }
      @discharge-w |
        forall w: Seq; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
        [by forall_intro generalize-w]
    }
  @conclusion |
    forall m: Nat; forall w: Seq; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
    [by forall_intro generalize-m]
qed

// A concrete instance, so the schemas above are exercised here: splitting a listing into
// its identity entries and the rest.
theorem splittingOffTheIdentity: forall m: Nat; forall w: Seq; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and at(w, i) = E) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> at(w, i) = E -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not (at(w, i) = E))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not (at(w, i) = E)) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
proof
  @conclusion |
    forall m: Nat; forall w: Seq; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and at(w, i) = E) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> at(w, i) = E -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not (at(w, i) = E))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not (at(w, i) = E)) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
    [using instantiation splittingAListing((fun g: Grp => g = E))]
qed

// -- pairing off: a listing closed under a fixed-point-free inverse has even length --------

theorem zeroBelowSucc: forall k: Nat; less_than(ZERO, succ(k))
proof
  @generalize-k |
    fix k: Nat {
      @zero-plus-successor |
        add(ZERO, succ(k)) = succ(k)
        [using specialize addZeroLeft(succ(k))]
      @conclusion-below |
        less_than(ZERO, succ(k))
        [using specialize lessThanIntro(ZERO, k, succ(k)) zero-plus-successor]
    }
  @conclusion |
    forall k: Nat; less_than(ZERO, succ(k))
    [by forall_intro generalize-k]
qed

theorem twoIsSuccSuccZero: TWO = succ(succ(ZERO))
proof
  @one-is-succ-zero |
    ONE = succ(ZERO)
    [by cite oneIsSuccZero]
  @two-unfolds |
    add(succ(ZERO), succ(ZERO)) = succ(add(ZERO, succ(ZERO)))
    [using specialize addSuccLeft(ZERO, succ(ZERO))]
  @zero-plus-one |
    add(ZERO, succ(ZERO)) = succ(ZERO)
    [using specialize addZeroLeft(succ(ZERO))]
  @two-in-successors |
    add(succ(ZERO), succ(ZERO)) = succ(succ(ZERO))
    [by rewrite zero-plus-one two-unfolds]
  @conclusion |
    TWO = succ(succ(ZERO))
    [by rewrite one-is-succ-zero two-in-successors]
qed

// Two distinct indices below q force 1 < q.
theorem twoDistinctIndicesBelow: forall q: Nat; forall a: Nat; forall b: Nat;
  less_than(a, q) -> less_than(b, q) -> a != b -> less_than(succ(ZERO), q)
proof
  @generalize-q |
    fix q: Nat {
      @generalize-a |
        fix a: Nat {
          @generalize-b |
            fix b: Nat {
              @given-a-below |
                assume less_than(a, q) {
                  @given-b-below |
                    assume less_than(b, q) {
                      @given-differ |
                        assume a != b {
                          @a-below |
                            less_than(a, q)
                            [by hypothesis given-a-below]
                          @b-below |
                            less_than(b, q)
                            [by hypothesis given-b-below]
                          @differ |
                            a != b
                            [by hypothesis given-differ]
                          @q-zero-or-succ |
                            q = ZERO or (exists q1: Nat; q = succ(q1))
                            [using specialize zeroOrSucc(q)]
                          @conclusion-one-below-q |
                            less_than(succ(ZERO), q)
                            case q-zero-or-succ {
                              @when-zero |
                                assume q = ZERO {
                                  @q-is-zero |
                                    q = ZERO
                                    [by hypothesis when-zero]
                                  @a-below-zero |
                                    less_than(a, ZERO)
                                    [by rewrite q-is-zero a-below]
                                  @nothing-below-zero |
                                    not less_than(a, ZERO)
                                    [using specialize notLessThanZero(a)]
                                  @conclusion-when-zero |
                                    less_than(succ(ZERO), q)
                                    [by absurd a-below-zero nothing-below-zero]
                                }
                              @when-succ |
                                assume exists q1: Nat; q = succ(q1) {
                                  @predecessor-exists |
                                    exists q1: Nat; q = succ(q1)
                                    [by hypothesis when-succ]
                                  @with-predecessor-q1 |
                                    unpack q1: Nat from predecessor-exists {
                                      @q-is-succ |
                                        q = succ(q1)
                                        [by hypothesis with-predecessor-q1]
                                      @q1-zero-or-succ |
                                        q1 = ZERO or (exists q2: Nat; q1 = succ(q2))
                                        [using specialize zeroOrSucc(q1)]
                                      @conclusion-one-below-at-q1 |
                                        less_than(succ(ZERO), q)
                                        case q1-zero-or-succ {
                                          @when-one |
                                            assume q1 = ZERO {
                                              @q1-is-zero |
                                                q1 = ZERO
                                                [by hypothesis when-one]
                                              @q-is-one |
                                                q = succ(ZERO)
                                                [by rewrite q1-is-zero q-is-succ]
                                              @a-below-one |
                                                less_than(a, succ(ZERO))
                                                [by rewrite q-is-one a-below]
                                              @b-below-one |
                                                less_than(b, succ(ZERO))
                                                [by rewrite q-is-one b-below]
                                              @a-splits |
                                                less_than(a, ZERO) or a = ZERO
                                                [using specialize lessThanSuccSplit(a, ZERO) a-below-one]
                                              @b-splits |
                                                less_than(b, ZERO) or b = ZERO
                                                [using specialize lessThanSuccSplit(b, ZERO) b-below-one]
                                              @a-not-below-zero |
                                                not less_than(a, ZERO)
                                                [using specialize notLessThanZero(a)]
                                              @b-not-below-zero |
                                                not less_than(b, ZERO)
                                                [using specialize notLessThanZero(b)]
                                              @a-is-zero |
                                                a = ZERO
                                                [using tautology a-splits a-not-below-zero]
                                              @b-is-zero |
                                                b = ZERO
                                                [using tautology b-splits b-not-below-zero]
                                              @a-is-b |
                                                a = b
                                                [by rewrite b-is-zero a-is-zero]
                                              @conclusion-when-one |
                                                less_than(succ(ZERO), q)
                                                [by absurd a-is-b differ]
                                            }
                                          @when-at-least-two |
                                            assume exists q2: Nat; q1 = succ(q2) {
                                              @second-predecessor-exists |
                                                exists q2: Nat; q1 = succ(q2)
                                                [by hypothesis when-at-least-two]
                                              @with-predecessor-q2 |
                                                unpack q2: Nat from second-predecessor-exists {
                                                  @q1-is-succ |
                                                    q1 = succ(q2)
                                                    [by hypothesis with-predecessor-q2]
                                                  @zero-below-succ-q2 |
                                                    less_than(ZERO, succ(q2))
                                                    [using specialize zeroBelowSucc(q2)]
                                                  @one-below-succ-succ-q2 |
                                                    less_than(succ(ZERO), succ(succ(q2)))
                                                    [using specialize succPreservesOrder(ZERO, succ(q2)) zero-below-succ-q2]
                                                  @one-below-succ-q1 |
                                                    less_than(succ(ZERO), succ(q1))
                                                    [by rewrite q1-is-succ one-below-succ-succ-q2]
                                                  @conclusion-when-at-least-two-at-q2 |
                                                    less_than(succ(ZERO), q)
                                                    [by rewrite q-is-succ one-below-succ-q1]
                                                }
                                              @conclusion-when-at-least-two |
                                                less_than(succ(ZERO), q)
                                                [by exists_elim with-predecessor-q2]
                                            }
                                        }
                                    }
                                  @conclusion-when-succ |
                                    less_than(succ(ZERO), q)
                                    [by exists_elim with-predecessor-q1]
                                }
                            }
                        }
                      @conclusion-given-differ |
                        a != b -> less_than(succ(ZERO), q)
                        [by implies_intro given-differ]
                    }
                  @conclusion-given-b |
                    less_than(b, q) -> a != b -> less_than(succ(ZERO), q)
                    [by implies_intro given-b-below]
                }
              @conclusion-at-b |
                less_than(a, q) -> less_than(b, q) -> a != b -> less_than(succ(ZERO), q)
                [by implies_intro given-a-below]
            }
          @discharge-b |
            forall b: Nat; less_than(a, q) -> less_than(b, q) -> a != b -> less_than(succ(ZERO), q)
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a: Nat; forall b: Nat; less_than(a, q) -> less_than(b, q) -> a != b -> less_than(succ(ZERO), q)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall q: Nat; forall a: Nat; forall b: Nat;
      less_than(a, q) -> less_than(b, q) -> a != b -> less_than(succ(ZERO), q)
    [by forall_intro generalize-q]
qed

theorem zeroIsNotSucc: forall k: Nat; not (ZERO = succ(k))
proof
  @generalize-k |
    fix k: Nat {
      @suppose-equal |
        assume ZERO = succ(k) {
          @equal |
            ZERO = succ(k)
            [by hypothesis suppose-equal]
          @flipped |
            succ(k) = ZERO
            [by symmetry equal]
        }
      @succ-not-zero |
        succ(k) != ZERO
        [using specialize succNotZero(k)]
      @conclusion-not-equal |
        not (ZERO = succ(k))
        [by not_intro suppose-equal flipped succ-not-zero]
    }
  @conclusion |
    forall k: Nat; not (ZERO = succ(k))
    [by forall_intro generalize-k]
qed

theorem succIsNotSuccSucc: forall k: Nat; not (succ(k) = succ(succ(k)))
proof
  @generalize-k |
    fix k: Nat {
      @suppose-equal |
        assume succ(k) = succ(succ(k)) {
          @equal |
            succ(k) = succ(succ(k))
            [by hypothesis suppose-equal]
          @predecessors-equal |
            k = succ(k)
            [using specialize succInjective(k, succ(k)) equal]
          @k-below-succ-k |
            less_than(k, succ(k))
            [using specialize lessThanSelf(k)]
          @k-below-itself |
            less_than(k, k)
            [by rewrite predecessors-equal k-below-succ-k]
        }
      @k-not-below-itself |
        not less_than(k, k)
        [using specialize lessThanIrreflexive(k)]
      @conclusion-not-equal |
        not (succ(k) = succ(succ(k)))
        [by not_intro suppose-equal k-below-itself k-not-below-itself]
    }
  @conclusion |
    forall k: Nat; not (succ(k) = succ(succ(k)))
    [by forall_intro generalize-k]
qed

// An injective listing whose entries all lie in a two-element set {g, h} has at most two
// entries: three would repeat a value.
theorem twoValuesAdmitAtMostTwoEntries: forall v: Seq; forall q: Nat; forall g: Grp; forall h: Grp;
  (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v, i) = at(v, j) -> i = j) ->
  (forall i: Nat; less_than(i, q) -> (at(v, i) = g or at(v, i) = h)) ->
  (not less_than(succ(succ(ZERO)), q))
proof
  @generalize-v |
    fix v: Seq {
      @generalize-q |
        fix q: Nat {
          @generalize-g |
            fix g: Grp {
              @generalize-h |
                fix h: Grp {
                  @given-injective |
                    assume forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v, i) = at(v, j) -> i = j {
                      @given-two-valued |
                        assume forall i: Nat; less_than(i, q) -> (at(v, i) = g or at(v, i) = h) {
                          @injective |
                            forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v, i) = at(v, j) -> i = j
                            [by hypothesis given-injective]
                          @two-valued |
                            forall i: Nat; less_than(i, q) -> (at(v, i) = g or at(v, i) = h)
                            [by hypothesis given-two-valued]
                          @suppose-three |
                            assume less_than(succ(succ(ZERO)), q) {
                              @two-below-q |
                                less_than(succ(succ(ZERO)), q)
                                [by hypothesis suppose-three]
                              @one-below-two |
                                less_than(succ(ZERO), succ(succ(ZERO)))
                                [using specialize lessThanSelf(succ(ZERO))]
                              @one-below-q |
                                less_than(succ(ZERO), q)
                                [using specialize lessThanTransitive(succ(ZERO), succ(succ(ZERO)), q) one-below-two two-below-q]
                              @zero-below-one |
                                less_than(ZERO, succ(ZERO))
                                [using specialize zeroBelowSucc(ZERO)]
                              @zero-below-q |
                                less_than(ZERO, q)
                                [using specialize lessThanTransitive(ZERO, succ(ZERO), q) zero-below-one one-below-q]
                              @entry-zero-two-valued |
                                at(v, ZERO) = g or at(v, ZERO) = h
                                [using specialize two-valued(ZERO) zero-below-q]
                              @entry-one-two-valued |
                                at(v, succ(ZERO)) = g or at(v, succ(ZERO)) = h
                                [using specialize two-valued(succ(ZERO)) one-below-q]
                              @entry-two-two-valued |
                                at(v, succ(succ(ZERO))) = g or at(v, succ(succ(ZERO))) = h
                                [using specialize two-valued(succ(succ(ZERO))) two-below-q]
                              @zero-one-injective |
                                at(v, ZERO) = at(v, succ(ZERO)) -> ZERO = succ(ZERO)
                                [using specialize injective(ZERO, succ(ZERO)) zero-below-q one-below-q]
                              @zero-two-injective |
                                at(v, ZERO) = at(v, succ(succ(ZERO))) -> ZERO = succ(succ(ZERO))
                                [using specialize injective(ZERO, succ(succ(ZERO))) zero-below-q two-below-q]
                              @one-two-injective |
                                at(v, succ(ZERO)) = at(v, succ(succ(ZERO))) -> succ(ZERO) = succ(succ(ZERO))
                                [using specialize injective(succ(ZERO), succ(succ(ZERO))) one-below-q two-below-q]
                              @zero-not-one-fact |
                                not (ZERO = succ(ZERO))
                                [using specialize zeroIsNotSucc(ZERO)]
                              @zero-not-two-fact |
                                not (ZERO = succ(succ(ZERO)))
                                [using specialize zeroIsNotSucc(succ(ZERO))]
                              @one-not-two-fact |
                                not (succ(ZERO) = succ(succ(ZERO)))
                                [using specialize succIsNotSuccSucc(ZERO)]
                              @entries-zero-one-differ |
                                not (at(v, ZERO) = at(v, succ(ZERO)))
                                [using tautology zero-one-injective zero-not-one-fact]
                              @entries-zero-two-differ |
                                not (at(v, ZERO) = at(v, succ(succ(ZERO))))
                                [using tautology zero-two-injective zero-not-two-fact]
                              @entries-one-two-differ |
                                not (at(v, succ(ZERO)) = at(v, succ(succ(ZERO))))
                                [using tautology one-two-injective one-not-two-fact]
                              @contradiction |
                                at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                case entry-zero-two-valued {
                                  @when-zero-is-g |
                                    assume at(v, ZERO) = g {
                                      @zero-is-g |
                                        at(v, ZERO) = g
                                        [by hypothesis when-zero-is-g]
                                      @conclusion-from-zero-g |
                                        at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                        case entry-one-two-valued {
                                          @when-one-is-g |
                                            assume at(v, succ(ZERO)) = g {
                                              @one-is-g |
                                                at(v, succ(ZERO)) = g
                                                [by hypothesis when-one-is-g]
                                              @zero-is-one |
                                                at(v, ZERO) = at(v, succ(ZERO))
                                                [by rewrite one-is-g zero-is-g]
                                              @conclusion-zero-one-collide |
                                                at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                                [using tautology zero-is-one]
                                            }
                                          @when-one-is-h |
                                            assume at(v, succ(ZERO)) = h {
                                              @one-is-h |
                                                at(v, succ(ZERO)) = h
                                                [by hypothesis when-one-is-h]
                                              @conclusion-from-zero-g-one-h |
                                                at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                                case entry-two-two-valued {
                                                  @when-two-is-g |
                                                    assume at(v, succ(succ(ZERO))) = g {
                                                      @two-is-g |
                                                        at(v, succ(succ(ZERO))) = g
                                                        [by hypothesis when-two-is-g]
                                                      @zero-is-two |
                                                        at(v, ZERO) = at(v, succ(succ(ZERO)))
                                                        [by rewrite two-is-g zero-is-g]
                                                      @conclusion-zero-two-collide |
                                                        at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                                        [using tautology zero-is-two]
                                                    }
                                                  @when-two-is-h |
                                                    assume at(v, succ(succ(ZERO))) = h {
                                                      @two-is-h |
                                                        at(v, succ(succ(ZERO))) = h
                                                        [by hypothesis when-two-is-h]
                                                      @one-is-two |
                                                        at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                                        [by rewrite two-is-h one-is-h]
                                                      @conclusion-one-two-collide |
                                                        at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                                        [using tautology one-is-two]
                                                    }
                                                }
                                            }
                                        }
                                    }
                                  @when-zero-is-h |
                                    assume at(v, ZERO) = h {
                                      @zero-is-h |
                                        at(v, ZERO) = h
                                        [by hypothesis when-zero-is-h]
                                      @conclusion-from-zero-h |
                                        at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                        case entry-one-two-valued {
                                          @when-one-is-g |
                                            assume at(v, succ(ZERO)) = g {
                                              @one-is-g |
                                                at(v, succ(ZERO)) = g
                                                [by hypothesis when-one-is-g]
                                              @conclusion-from-zero-h-one-g |
                                                at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                                case entry-two-two-valued {
                                                  @when-two-is-g |
                                                    assume at(v, succ(succ(ZERO))) = g {
                                                      @two-is-g |
                                                        at(v, succ(succ(ZERO))) = g
                                                        [by hypothesis when-two-is-g]
                                                      @one-is-two |
                                                        at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                                        [by rewrite two-is-g one-is-g]
                                                      @conclusion-one-two-collide |
                                                        at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                                        [using tautology one-is-two]
                                                    }
                                                  @when-two-is-h |
                                                    assume at(v, succ(succ(ZERO))) = h {
                                                      @two-is-h |
                                                        at(v, succ(succ(ZERO))) = h
                                                        [by hypothesis when-two-is-h]
                                                      @zero-is-two |
                                                        at(v, ZERO) = at(v, succ(succ(ZERO)))
                                                        [by rewrite two-is-h zero-is-h]
                                                      @conclusion-zero-two-collide |
                                                        at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                                        [using tautology zero-is-two]
                                                    }
                                                }
                                            }
                                          @when-one-is-h |
                                            assume at(v, succ(ZERO)) = h {
                                              @one-is-h |
                                                at(v, succ(ZERO)) = h
                                                [by hypothesis when-one-is-h]
                                              @zero-is-one |
                                                at(v, ZERO) = at(v, succ(ZERO))
                                                [by rewrite one-is-h zero-is-h]
                                              @conclusion-zero-one-collide |
                                                at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO)))
                                                [using tautology zero-is-one]
                                            }
                                        }
                                    }
                                }
                              @collision-excluded |
                                not (at(v, ZERO) = at(v, succ(ZERO)) or at(v, ZERO) = at(v, succ(succ(ZERO))) or at(v, succ(ZERO)) = at(v, succ(succ(ZERO))))
                                [using tautology entries-zero-one-differ entries-zero-two-differ entries-one-two-differ]
                            }
                          @conclusion-at-most-two |
                            not less_than(succ(succ(ZERO)), q)
                            [by not_intro suppose-three contradiction collision-excluded]
                        }
                      @conclusion-given-two-valued |
                        (forall i: Nat; less_than(i, q) -> (at(v, i) = g or at(v, i) = h)) -> (not less_than(succ(succ(ZERO)), q))
                        [by implies_intro given-two-valued]
                    }
                  @conclusion-at-h |
                    (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v, i) = at(v, j) -> i = j) -> (forall i: Nat; less_than(i, q) -> (at(v, i) = g or at(v, i) = h)) -> (not less_than(succ(succ(ZERO)), q))
                    [by implies_intro given-injective]
                }
              @discharge-h |
                forall h: Grp; (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v, i) = at(v, j) -> i = j) -> (forall i: Nat; less_than(i, q) -> (at(v, i) = g or at(v, i) = h)) -> (not less_than(succ(succ(ZERO)), q))
                [by forall_intro generalize-h]
            }
          @discharge-g |
            forall g: Grp; forall h: Grp; (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v, i) = at(v, j) -> i = j) -> (forall i: Nat; less_than(i, q) -> (at(v, i) = g or at(v, i) = h)) -> (not less_than(succ(succ(ZERO)), q))
            [by forall_intro generalize-g]
        }
      @discharge-q |
        forall q: Nat; forall g: Grp; forall h: Grp; (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v, i) = at(v, j) -> i = j) -> (forall i: Nat; less_than(i, q) -> (at(v, i) = g or at(v, i) = h)) -> (not less_than(succ(succ(ZERO)), q))
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall v: Seq; forall q: Nat; forall g: Grp; forall h: Grp;
      (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v, i) = at(v, j) -> i = j) ->
      (forall i: Nat; less_than(i, q) -> (at(v, i) = g or at(v, i) = h)) ->
      (not less_than(succ(succ(ZERO)), q))
    [by forall_intro generalize-v]
qed

define listsWithoutRepetition(v, q) = forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v, i) = at(v, j) -> i = j
define noEntryIsItsOwnInverse(v, q) = forall i: Nat; less_than(i, q) -> at(v, i) != inverse(at(v, i))
define closedUnderInverse(v, q) = forall i: Nat; less_than(i, q) -> exists j: Nat; less_than(j, q) and at(v, j) = inverse(at(v, i))

// PAIRING OFF: a listing without repetition, none of whose entries is its own inverse and
// which contains the inverse of each entry, has EVEN length. Strong induction on the length:
// split off the first entry g together with g⁻¹ (exactly two entries, since g ≠ g⁻¹ and the
// entries are distinct); the rest is a shorter listing with the same properties.
theorem pairedListingHasEvenLength: forall q: Nat; forall v: Seq; listsWithoutRepetition(v, q) -> noEntryIsItsOwnInverse(v, q) -> closedUnderInverse(v, q) -> divides(TWO, q)
proof
  @strong-step |
    fix q: Nat {
      @given-shorter |
        assume forall m: Nat; less_than(m, q) -> forall v: Seq; listsWithoutRepetition(v, m) -> noEntryIsItsOwnInverse(v, m) -> closedUnderInverse(v, m) -> divides(TWO, m) {
          @shorter |
            forall m: Nat; less_than(m, q) -> forall v: Seq; listsWithoutRepetition(v, m) -> noEntryIsItsOwnInverse(v, m) -> closedUnderInverse(v, m) -> divides(TWO, m)
            [by hypothesis given-shorter]
          @generalize-v |
            fix v: Seq {
              @given-injective |
                assume listsWithoutRepetition(v, q) {
                  @given-no-fixed-point |
                    assume noEntryIsItsOwnInverse(v, q) {
                      @given-closed |
                        assume closedUnderInverse(v, q) {
                          @injective |
                            listsWithoutRepetition(v, q)
                            [by hypothesis given-injective]
                          @no-fixed-point |
                            noEntryIsItsOwnInverse(v, q)
                            [by hypothesis given-no-fixed-point]
                          @closed |
                            closedUnderInverse(v, q)
                            [by hypothesis given-closed]
                          @q-zero-or-succ |
                            q = ZERO or (exists q0: Nat; q = succ(q0))
                            [using specialize zeroOrSucc(q)]
                          @conclusion-even |
                            divides(TWO, q)
                            case q-zero-or-succ {
                              @when-empty |
                                assume q = ZERO {
                                  @q-is-zero |
                                    q = ZERO
                                    [by hypothesis when-empty]
                                  @two-divides-zero |
                                    divides(TWO, ZERO)
                                    [using specialize dividesZero(TWO)]
                                  @conclusion-when-empty |
                                    divides(TWO, q)
                                    [by rewrite q-is-zero two-divides-zero]
                                }
                              @when-nonempty |
                                assume exists q0: Nat; q = succ(q0) {
                                  @predecessor-exists |
                                    exists q0: Nat; q = succ(q0)
                                    [by hypothesis when-nonempty]
                                  @with-predecessor-q0 |
                                    unpack q0: Nat from predecessor-exists {
                                      @q-is-succ |
                                        q = succ(q0)
                                        [by hypothesis with-predecessor-q0]
                                      @zero-below-succ-q0 |
                                        less_than(ZERO, succ(q0))
                                        [using specialize zeroBelowSucc(q0)]
                                      @zero-below-q |
                                        less_than(ZERO, q)
                                        [by rewrite q-is-succ zero-below-succ-q0]
                                      @g-is-not-its-inverse |
                                        at(v, ZERO) != inverse(at(v, ZERO))
                                        [using specialize no-fixed-point(ZERO) zero-below-q]
                                      @splitting |
                                        forall m0: Nat; forall w0: Seq; (forall i: Nat; forall j: Nat; less_than(i, m0) -> less_than(j, m0) -> at(w0, i) = at(w0, j) -> i = j) -> exists v3: Seq; exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = m0 and ((forall j: Nat; less_than(j, p3) -> exists i: Nat; less_than(i, m0) and at(v3, j) = at(w0, i) and (at(w0, i) != at(v, ZERO) and at(w0, i) != inverse(at(v, ZERO)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall i: Nat; less_than(i, m0) -> (at(w0, i) != at(v, ZERO) and at(w0, i) != inverse(at(v, ZERO))) -> exists j: Nat; less_than(j, p3) and at(v3, j) = at(w0, i))) and ((forall j: Nat; less_than(j, q3) -> exists i: Nat; less_than(i, m0) and at(v4, j) = at(w0, i) and (not (at(w0, i) != at(v, ZERO) and at(w0, i) != inverse(at(v, ZERO))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall i: Nat; less_than(i, m0) -> (not (at(w0, i) != at(v, ZERO) and at(w0, i) != inverse(at(v, ZERO)))) -> exists j: Nat; less_than(j, q3) and at(v4, j) = at(w0, i)))
                                        [using instantiation splittingAListing((fun x: Grp => x != at(v, ZERO) and x != inverse(at(v, ZERO))))]
                                      @split |
                                        exists v3: Seq; exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = q and ((forall j: Nat; less_than(j, p3) -> exists i: Nat; less_than(i, q) and at(v3, j) = at(v, i) and (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall i: Nat; less_than(i, q) -> (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))) -> exists j: Nat; less_than(j, p3) and at(v3, j) = at(v, i))) and ((forall j: Nat; less_than(j, q3) -> exists i: Nat; less_than(i, q) and at(v4, j) = at(v, i) and (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall i: Nat; less_than(i, q) -> (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) -> exists j: Nat; less_than(j, q3) and at(v4, j) = at(v, i)))
                                        [using specialize splitting(q, v) injective]
                                      @with-v3 |
                                        unpack v3: Seq from split {
                                          @after-v3 |
                                            exists p3: Nat; exists v4: Seq; exists q3: Nat; add(p3, q3) = q and ((forall j: Nat; less_than(j, p3) -> exists i: Nat; less_than(i, q) and at(v3, j) = at(v, i) and (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall i: Nat; less_than(i, q) -> (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))) -> exists j: Nat; less_than(j, p3) and at(v3, j) = at(v, i))) and ((forall j: Nat; less_than(j, q3) -> exists i: Nat; less_than(i, q) and at(v4, j) = at(v, i) and (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall i: Nat; less_than(i, q) -> (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) -> exists j: Nat; less_than(j, q3) and at(v4, j) = at(v, i)))
                                            [by hypothesis with-v3]
                                          @with-p3 |
                                            unpack p3: Nat from after-v3 {
                                              @after-p3 |
                                                exists v4: Seq; exists q3: Nat; add(p3, q3) = q and ((forall j: Nat; less_than(j, p3) -> exists i: Nat; less_than(i, q) and at(v3, j) = at(v, i) and (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall i: Nat; less_than(i, q) -> (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))) -> exists j: Nat; less_than(j, p3) and at(v3, j) = at(v, i))) and ((forall j: Nat; less_than(j, q3) -> exists i: Nat; less_than(i, q) and at(v4, j) = at(v, i) and (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall i: Nat; less_than(i, q) -> (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) -> exists j: Nat; less_than(j, q3) and at(v4, j) = at(v, i)))
                                                [by hypothesis with-p3]
                                              @with-v4 |
                                                unpack v4: Seq from after-p3 {
                                                  @after-v4 |
                                                    exists q3: Nat; add(p3, q3) = q and ((forall j: Nat; less_than(j, p3) -> exists i: Nat; less_than(i, q) and at(v3, j) = at(v, i) and (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall i: Nat; less_than(i, q) -> (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))) -> exists j: Nat; less_than(j, p3) and at(v3, j) = at(v, i))) and ((forall j: Nat; less_than(j, q3) -> exists i: Nat; less_than(i, q) and at(v4, j) = at(v, i) and (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall i: Nat; less_than(i, q) -> (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) -> exists j: Nat; less_than(j, q3) and at(v4, j) = at(v, i)))
                                                    [by hypothesis with-v4]
                                                  @with-q3 |
                                                    unpack q3: Nat from after-v4 {
                                                      @split-facts |
                                                        add(p3, q3) = q and ((forall j: Nat; less_than(j, p3) -> exists i: Nat; less_than(i, q) and at(v3, j) = at(v, i) and (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) and (forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j) and (forall i: Nat; less_than(i, q) -> (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))) -> exists j: Nat; less_than(j, p3) and at(v3, j) = at(v, i))) and ((forall j: Nat; less_than(j, q3) -> exists i: Nat; less_than(i, q) and at(v4, j) = at(v, i) and (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))))) and (forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j) and (forall i: Nat; less_than(i, q) -> (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) -> exists j: Nat; less_than(j, q3) and at(v4, j) = at(v, i)))
                                                        [by hypothesis with-q3]
                                                      @lengths-add |
                                                        add(p3, q3) = q
                                                        [using tautology split-facts]
                                                      @rest-entries |
                                                        forall j: Nat; less_than(j, p3) -> exists i: Nat; less_than(i, q) and at(v3, j) = at(v, i) and (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))
                                                        [using tautology split-facts]
                                                      @rest-injective |
                                                        forall i: Nat; forall j: Nat; less_than(i, p3) -> less_than(j, p3) -> at(v3, i) = at(v3, j) -> i = j
                                                        [using tautology split-facts]
                                                      @rest-covers |
                                                        forall i: Nat; less_than(i, q) -> (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))) -> exists j: Nat; less_than(j, p3) and at(v3, j) = at(v, i)
                                                        [using tautology split-facts]
                                                      @pair-entries |
                                                        forall j: Nat; less_than(j, q3) -> exists i: Nat; less_than(i, q) and at(v4, j) = at(v, i) and (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))))
                                                        [using tautology split-facts]
                                                      @pair-injective |
                                                        forall i: Nat; forall j: Nat; less_than(i, q3) -> less_than(j, q3) -> at(v4, i) = at(v4, j) -> i = j
                                                        [using tautology split-facts]
                                                      @pair-covers |
                                                        forall i: Nat; less_than(i, q) -> (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))) -> exists j: Nat; less_than(j, q3) and at(v4, j) = at(v, i)
                                                        [using tautology split-facts]

                                                      // the pair listing holds exactly g and g⁻¹
                                                      @g-is-itself |
                                                        at(v, ZERO) = at(v, ZERO)
                                                        [by reflexivity]
                                                      @g-fails |
                                                        (not (at(v, ZERO) != at(v, ZERO) and at(v, ZERO) != inverse(at(v, ZERO))))
                                                        [using tautology g-is-itself]
                                                      @g-in-pair |
                                                        exists j: Nat; less_than(j, q3) and at(v4, j) = at(v, ZERO)
                                                        [using specialize pair-covers(ZERO) zero-below-q g-fails]
                                                      @inverse-of-g-is-an-entry |
                                                        exists i: Nat; less_than(i, q) and at(v, i) = inverse(at(v, ZERO))
                                                        [using specialize closed(ZERO) zero-below-q]
                                                      @with-inverse-index-i1 |
                                                        unpack i1: Nat from inverse-of-g-is-an-entry {
                                                          @inverse-index-facts |
                                                            less_than(i1, q) and at(v, i1) = inverse(at(v, ZERO))
                                                            [by hypothesis with-inverse-index-i1]
                                                          @i1-below-q |
                                                            less_than(i1, q)
                                                            [by and_elim_left inverse-index-facts]
                                                          @entry-i1-is-inverse-of-g |
                                                            at(v, i1) = inverse(at(v, ZERO))
                                                            [by and_elim_right inverse-index-facts]
                                                          @entry-i1-fails |
                                                            (not (at(v, i1) != at(v, ZERO) and at(v, i1) != inverse(at(v, ZERO))))
                                                            [using tautology entry-i1-is-inverse-of-g]
                                                          @inverse-of-g-in-pair |
                                                            exists j: Nat; less_than(j, q3) and at(v4, j) = at(v, i1)
                                                            [using specialize pair-covers(i1) i1-below-q entry-i1-fails]
                                                          @with-index-j0 |
                                                            unpack j0: Nat from g-in-pair {
                                                              @j0-facts |
                                                                less_than(j0, q3) and at(v4, j0) = at(v, ZERO)
                                                                [by hypothesis with-index-j0]
                                                              @j0-below |
                                                                less_than(j0, q3)
                                                                [by and_elim_left j0-facts]
                                                              @pair-at-j0 |
                                                                at(v4, j0) = at(v, ZERO)
                                                                [by and_elim_right j0-facts]
                                                              @with-index-j1 |
                                                                unpack j1: Nat from inverse-of-g-in-pair {
                                                                  @j1-facts |
                                                                    less_than(j1, q3) and at(v4, j1) = at(v, i1)
                                                                    [by hypothesis with-index-j1]
                                                                  @j1-below |
                                                                    less_than(j1, q3)
                                                                    [by and_elim_left j1-facts]
                                                                  @pair-at-j1-a |
                                                                    at(v4, j1) = at(v, i1)
                                                                    [by and_elim_right j1-facts]
                                                                  @pair-at-j1 |
                                                                    at(v4, j1) = inverse(at(v, ZERO))
                                                                    [using chain pair-at-j1-a entry-i1-is-inverse-of-g]
                                                                  @suppose-same-index |
                                                                    assume j0 = j1 {
                                                                      @same-index |
                                                                        j0 = j1
                                                                        [by hypothesis suppose-same-index]
                                                                      @pair-at-j1-is-g |
                                                                        at(v4, j1) = at(v, ZERO)
                                                                        [by rewrite same-index pair-at-j0]
                                                                      @g-is-its-inverse |
                                                                        at(v, ZERO) = inverse(at(v, ZERO))
                                                                        [by rewrite pair-at-j1-is-g pair-at-j1]
                                                                    }
                                                                  @indices-differ |
                                                                    j0 != j1
                                                                    [by not_intro suppose-same-index g-is-its-inverse g-is-not-its-inverse]
                                                                  @conclusion-one-below-q3 |
                                                                    less_than(succ(ZERO), q3)
                                                                    [using specialize twoDistinctIndicesBelow(q3, j0, j1) j0-below j1-below indices-differ]
                                                                }
                                                              @conclusion-one-below-q3-at-j0 |
                                                                less_than(succ(ZERO), q3)
                                                                [by exists_elim with-index-j1]
                                                            }
                                                          @conclusion-one-below-q3-at-i1 |
                                                            less_than(succ(ZERO), q3)
                                                            [by exists_elim with-index-j0]
                                                        }
                                                      @one-below-q3 |
                                                        less_than(succ(ZERO), q3)
                                                        [by exists_elim with-inverse-index-i1]
                                                      @generalize-j-for-two-valued |
                                                        fix j: Nat {
                                                          @given-j-in-pair |
                                                            assume less_than(j, q3) {
                                                              @j-in-pair |
                                                                less_than(j, q3)
                                                                [by hypothesis given-j-in-pair]
                                                              @source-exists |
                                                                exists i: Nat; less_than(i, q) and at(v4, j) = at(v, i) and (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))))
                                                                [using specialize pair-entries(j) j-in-pair]
                                                              @with-source-i |
                                                                unpack i: Nat from source-exists {
                                                                  @source-facts |
                                                                    less_than(i, q) and at(v4, j) = at(v, i) and (not (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO))))
                                                                    [by hypothesis with-source-i]
                                                                  @entry-is-source |
                                                                    at(v4, j) = at(v, i)
                                                                    [using tautology source-facts]
                                                                  @source-is-g-or-inverse |
                                                                    at(v, i) = at(v, ZERO) or at(v, i) = inverse(at(v, ZERO))
                                                                    [using tautology source-facts]
                                                                  @conclusion-entry-is-g-or-inverse |
                                                                    at(v4, j) = at(v, ZERO) or at(v4, j) = inverse(at(v, ZERO))
                                                                    [by rewrite entry-is-source source-is-g-or-inverse]
                                                                }
                                                              @conclusion-two-valued-at-j |
                                                                at(v4, j) = at(v, ZERO) or at(v4, j) = inverse(at(v, ZERO))
                                                                [by exists_elim with-source-i]
                                                            }
                                                          @conclusion-two-valued-clause |
                                                            less_than(j, q3) -> (at(v4, j) = at(v, ZERO) or at(v4, j) = inverse(at(v, ZERO)))
                                                            [by implies_intro given-j-in-pair]
                                                        }
                                                      @pair-two-valued |
                                                        forall j: Nat; less_than(j, q3) -> (at(v4, j) = at(v, ZERO) or at(v4, j) = inverse(at(v, ZERO)))
                                                        [by forall_intro generalize-j-for-two-valued]
                                                      @not-three |
                                                        not less_than(succ(succ(ZERO)), q3)
                                                        [using specialize twoValuesAdmitAtMostTwoEntries(v4, q3, at(v, ZERO), inverse(at(v, ZERO))) pair-injective pair-two-valued]
                                                      @q3-three-ways |
                                                        less_than(succ(succ(ZERO)), q3) or succ(succ(ZERO)) = q3 or less_than(q3, succ(succ(ZERO)))
                                                        [using specialize trichotomy(succ(succ(ZERO)), q3)]
                                                      @q3-is-two |
                                                        q3 = succ(succ(ZERO))
                                                        case q3-three-ways {
                                                          @when-three |
                                                            assume less_than(succ(succ(ZERO)), q3) {
                                                              @three |
                                                                less_than(succ(succ(ZERO)), q3)
                                                                [by hypothesis when-three]
                                                              @conclusion-when-three |
                                                                q3 = succ(succ(ZERO))
                                                                [by absurd three not-three]
                                                            }
                                                          @when-two |
                                                            assume succ(succ(ZERO)) = q3 {
                                                              @two |
                                                                succ(succ(ZERO)) = q3
                                                                [by hypothesis when-two]
                                                              @conclusion-when-two |
                                                                q3 = succ(succ(ZERO))
                                                                [by symmetry two]
                                                            }
                                                          @when-below-two |
                                                            assume less_than(q3, succ(succ(ZERO))) {
                                                              @below-two |
                                                                less_than(q3, succ(succ(ZERO)))
                                                                [by hypothesis when-below-two]
                                                              @q3-splits |
                                                                less_than(q3, succ(ZERO)) or q3 = succ(ZERO)
                                                                [using specialize lessThanSuccSplit(q3, succ(ZERO)) below-two]
                                                              @one-not-below-itself |
                                                                not less_than(succ(ZERO), succ(ZERO))
                                                                [using specialize lessThanIrreflexive(succ(ZERO))]
                                                              @conclusion-when-below-two |
                                                                q3 = succ(succ(ZERO))
                                                                case q3-splits {
                                                                  @when-below-one |
                                                                    assume less_than(q3, succ(ZERO)) {
                                                                      @below-one |
                                                                        less_than(q3, succ(ZERO))
                                                                        [by hypothesis when-below-one]
                                                                      @one-below-itself |
                                                                        less_than(succ(ZERO), succ(ZERO))
                                                                        [using specialize lessThanTransitive(succ(ZERO), q3, succ(ZERO)) one-below-q3 below-one]
                                                                      @conclusion-when-below-one |
                                                                        q3 = succ(succ(ZERO))
                                                                        [by absurd one-below-itself one-not-below-itself]
                                                                    }
                                                                  @when-one |
                                                                    assume q3 = succ(ZERO) {
                                                                      @is-one |
                                                                        q3 = succ(ZERO)
                                                                        [by hypothesis when-one]
                                                                      @one-below-itself |
                                                                        less_than(succ(ZERO), succ(ZERO))
                                                                        [by rewrite is-one one-below-q3]
                                                                      @conclusion-when-one |
                                                                        q3 = succ(succ(ZERO))
                                                                        [by absurd one-below-itself one-not-below-itself]
                                                                    }
                                                                }
                                                            }
                                                        }

                                                      // the rest inherits the three properties
                                                      @generalize-j-for-no-fixed-point |
                                                        fix j: Nat {
                                                          @given-j-in-rest |
                                                            assume less_than(j, p3) {
                                                              @j-in-rest |
                                                                less_than(j, p3)
                                                                [by hypothesis given-j-in-rest]
                                                              @source-exists |
                                                                exists i: Nat; less_than(i, q) and at(v3, j) = at(v, i) and (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))
                                                                [using specialize rest-entries(j) j-in-rest]
                                                              @with-source-i |
                                                                unpack i: Nat from source-exists {
                                                                  @source-facts |
                                                                    less_than(i, q) and at(v3, j) = at(v, i) and (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))
                                                                    [by hypothesis with-source-i]
                                                                  @i-below-q |
                                                                    less_than(i, q)
                                                                    [using tautology source-facts]
                                                                  @entry-is-source |
                                                                    at(v3, j) = at(v, i)
                                                                    [using tautology source-facts]
                                                                  @source-not-fixed |
                                                                    at(v, i) != inverse(at(v, i))
                                                                    [using specialize no-fixed-point(i) i-below-q]
                                                                  @conclusion-entry-not-fixed |
                                                                    at(v3, j) != inverse(at(v3, j))
                                                                    [by rewrite entry-is-source source-not-fixed]
                                                                }
                                                              @conclusion-not-fixed-at-j |
                                                                at(v3, j) != inverse(at(v3, j))
                                                                [by exists_elim with-source-i]
                                                            }
                                                          @conclusion-not-fixed-clause |
                                                            less_than(j, p3) -> at(v3, j) != inverse(at(v3, j))
                                                            [by implies_intro given-j-in-rest]
                                                        }
                                                      @rest-no-fixed-point |
                                                        noEntryIsItsOwnInverse(v3, p3)
                                                        [by forall_intro generalize-j-for-no-fixed-point]
                                                      @generalize-j-for-closed |
                                                        fix j: Nat {
                                                          @given-j-in-rest |
                                                            assume less_than(j, p3) {
                                                              @j-in-rest |
                                                                less_than(j, p3)
                                                                [by hypothesis given-j-in-rest]
                                                              @source-exists |
                                                                exists i: Nat; less_than(i, q) and at(v3, j) = at(v, i) and (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))
                                                                [using specialize rest-entries(j) j-in-rest]
                                                              @with-source-i |
                                                                unpack i: Nat from source-exists {
                                                                  @source-facts |
                                                                    less_than(i, q) and at(v3, j) = at(v, i) and (at(v, i) != at(v, ZERO) and at(v, i) != inverse(at(v, ZERO)))
                                                                    [by hypothesis with-source-i]
                                                                  @i-below-q |
                                                                    less_than(i, q)
                                                                    [using tautology source-facts]
                                                                  @entry-is-source |
                                                                    at(v3, j) = at(v, i)
                                                                    [using tautology source-facts]
                                                                  @source-not-g |
                                                                    at(v, i) != at(v, ZERO)
                                                                    [using tautology source-facts]
                                                                  @source-not-inverse-of-g |
                                                                    at(v, i) != inverse(at(v, ZERO))
                                                                    [using tautology source-facts]
                                                                  @inverse-of-source-exists |
                                                                    exists i2: Nat; less_than(i2, q) and at(v, i2) = inverse(at(v, i))
                                                                    [using specialize closed(i) i-below-q]
                                                                  @with-inverse-index-i2 |
                                                                    unpack i2: Nat from inverse-of-source-exists {
                                                                      @inverse-index-facts |
                                                                        less_than(i2, q) and at(v, i2) = inverse(at(v, i))
                                                                        [by hypothesis with-inverse-index-i2]
                                                                      @i2-below-q |
                                                                        less_than(i2, q)
                                                                        [by and_elim_left inverse-index-facts]
                                                                      @entry-i2-is-the-inverse |
                                                                        at(v, i2) = inverse(at(v, i))
                                                                        [by and_elim_right inverse-index-facts]
                                                                      @source-undone |
                                                                        inverse(inverse(at(v, i))) = at(v, i)
                                                                        [using specialize invInvolution(at(v, i))]
                                                                      @suppose-inverse-is-g |
                                                                        assume inverse(at(v, i)) = at(v, ZERO) {
                                                                          @inverse-is-g |
                                                                            inverse(at(v, i)) = at(v, ZERO)
                                                                            [by hypothesis suppose-inverse-is-g]
                                                                          @inverse-of-g-is-source |
                                                                            inverse(at(v, ZERO)) = at(v, i)
                                                                            [by rewrite inverse-is-g source-undone]
                                                                          @source-is-inverse-of-g |
                                                                            at(v, i) = inverse(at(v, ZERO))
                                                                            [by symmetry inverse-of-g-is-source]
                                                                        }
                                                                      @inverse-not-g |
                                                                        inverse(at(v, i)) != at(v, ZERO)
                                                                        [by not_intro suppose-inverse-is-g source-is-inverse-of-g source-not-inverse-of-g]
                                                                      @g-undone |
                                                                        inverse(inverse(at(v, ZERO))) = at(v, ZERO)
                                                                        [using specialize invInvolution(at(v, ZERO))]
                                                                      @suppose-inverses-agree |
                                                                        assume inverse(at(v, i)) = inverse(at(v, ZERO)) {
                                                                          @inverses-agree |
                                                                            inverse(at(v, i)) = inverse(at(v, ZERO))
                                                                            [by hypothesis suppose-inverses-agree]
                                                                          @doubly-inverted-agree |
                                                                            inverse(inverse(at(v, ZERO))) = at(v, i)
                                                                            [by rewrite inverses-agree source-undone]
                                                                          @source-is-g-a |
                                                                            at(v, i) = inverse(inverse(at(v, ZERO)))
                                                                            [by symmetry doubly-inverted-agree]
                                                                          @source-is-g |
                                                                            at(v, i) = at(v, ZERO)
                                                                            [using chain source-is-g-a g-undone]
                                                                        }
                                                                      @inverse-not-inverse-of-g |
                                                                        inverse(at(v, i)) != inverse(at(v, ZERO))
                                                                        [by not_intro suppose-inverses-agree source-is-g source-not-g]
                                                                      @entry-i2-not-g |
                                                                        at(v, i2) != at(v, ZERO)
                                                                        [by rewrite entry-i2-is-the-inverse inverse-not-g]
                                                                      @entry-i2-not-inverse-of-g |
                                                                        at(v, i2) != inverse(at(v, ZERO))
                                                                        [by rewrite entry-i2-is-the-inverse inverse-not-inverse-of-g]
                                                                      @entry-i2-satisfies |
                                                                        (at(v, i2) != at(v, ZERO) and at(v, i2) != inverse(at(v, ZERO)))
                                                                        [by and_intro entry-i2-not-g entry-i2-not-inverse-of-g]
                                                                      @inverse-in-rest |
                                                                        exists j2: Nat; less_than(j2, p3) and at(v3, j2) = at(v, i2)
                                                                        [using specialize rest-covers(i2) i2-below-q entry-i2-satisfies]
                                                                      @with-rest-index-j2 |
                                                                        unpack j2: Nat from inverse-in-rest {
                                                                          @rest-index-facts |
                                                                            less_than(j2, p3) and at(v3, j2) = at(v, i2)
                                                                            [by hypothesis with-rest-index-j2]
                                                                          @j2-in-rest |
                                                                            less_than(j2, p3)
                                                                            [by and_elim_left rest-index-facts]
                                                                          @rest-at-j2-a |
                                                                            at(v3, j2) = at(v, i2)
                                                                            [by and_elim_right rest-index-facts]
                                                                          @rest-at-j2-b |
                                                                            at(v3, j2) = inverse(at(v, i))
                                                                            [using chain rest-at-j2-a entry-i2-is-the-inverse]
                                                                          @rest-at-j2 |
                                                                            at(v3, j2) = inverse(at(v3, j))
                                                                            [by rewrite entry-is-source rest-at-j2-b]
                                                                          @j2-in-rest-and-inverts |
                                                                            less_than(j2, p3) and at(v3, j2) = inverse(at(v3, j))
                                                                            [by and_intro j2-in-rest rest-at-j2]
                                                                          @conclusion-witness-j2 |
                                                                            exists j3: Nat; less_than(j3, p3) and at(v3, j3) = inverse(at(v3, j))
                                                                            [by exists_intro(j2) j2-in-rest-and-inverts]
                                                                        }
                                                                      @conclusion-with-j2 |
                                                                        exists j3: Nat; less_than(j3, p3) and at(v3, j3) = inverse(at(v3, j))
                                                                        [by exists_elim with-rest-index-j2]
                                                                    }
                                                                  @conclusion-with-i2 |
                                                                    exists j3: Nat; less_than(j3, p3) and at(v3, j3) = inverse(at(v3, j))
                                                                    [by exists_elim with-inverse-index-i2]
                                                                }
                                                              @conclusion-closed-at-j |
                                                                exists j3: Nat; less_than(j3, p3) and at(v3, j3) = inverse(at(v3, j))
                                                                [by exists_elim with-source-i]
                                                            }
                                                          @conclusion-closed-clause |
                                                            less_than(j, p3) -> exists j3: Nat; less_than(j3, p3) and at(v3, j3) = inverse(at(v3, j))
                                                            [by implies_intro given-j-in-rest]
                                                        }
                                                      @rest-closed |
                                                        closedUnderInverse(v3, p3)
                                                        [by forall_intro generalize-j-for-closed]

                                                      // the rest is shorter by two, so even by induction; hence q is even
                                                      @q-is-rest-plus-two |
                                                        add(p3, succ(succ(ZERO))) = q
                                                        [by rewrite q3-is-two lengths-add]
                                                      @rest-shorter |
                                                        less_than(p3, q)
                                                        [using specialize lessThanIntro(p3, succ(ZERO), q) q-is-rest-plus-two]
                                                      @rest-even |
                                                        divides(TWO, p3)
                                                        [using specialize shorter(p3, v3) rest-shorter rest-injective rest-no-fixed-point rest-closed]
                                                      @two-divides-two |
                                                        divides(TWO, TWO)
                                                        [using specialize dividesRefl(TWO)]
                                                      @sum-even |
                                                        divides(TWO, add(p3, TWO))
                                                        [using specialize dividesAdd(TWO, p3, TWO) rest-even two-divides-two]
                                                      @two-is-two |
                                                        TWO = succ(succ(ZERO))
                                                        [by cite twoIsSuccSuccZero]
                                                      @sum-even-in-successors |
                                                        divides(TWO, add(p3, succ(succ(ZERO))))
                                                        [by rewrite two-is-two sum-even]
                                                      @conclusion-q-even |
                                                        divides(TWO, q)
                                                        [by rewrite q-is-rest-plus-two sum-even-in-successors]
                                                    }
                                                  @conclusion-with-q3 |
                                                    divides(TWO, q)
                                                    [by exists_elim with-q3]
                                                }
                                              @conclusion-with-v4 |
                                                divides(TWO, q)
                                                [by exists_elim with-v4]
                                            }
                                          @conclusion-with-p3 |
                                            divides(TWO, q)
                                            [by exists_elim with-p3]
                                        }
                                      @conclusion-with-v3 |
                                        divides(TWO, q)
                                        [by exists_elim with-v3]
                                    }
                                  @conclusion-when-nonempty |
                                    divides(TWO, q)
                                    [by exists_elim with-predecessor-q0]
                                }
                            }
                        }
                      @conclusion-given-closed |
                        closedUnderInverse(v, q) -> divides(TWO, q)
                        [by implies_intro given-closed]
                    }
                  @conclusion-given-no-fixed-point |
                    noEntryIsItsOwnInverse(v, q) -> closedUnderInverse(v, q) -> divides(TWO, q)
                    [by implies_intro given-no-fixed-point]
                }
              @conclusion-at-v |
                listsWithoutRepetition(v, q) -> noEntryIsItsOwnInverse(v, q) -> closedUnderInverse(v, q) -> divides(TWO, q)
                [by implies_intro given-injective]
            }
          @discharge-v |
            forall v: Seq; listsWithoutRepetition(v, q) -> noEntryIsItsOwnInverse(v, q) -> closedUnderInverse(v, q) -> divides(TWO, q)
            [by forall_intro generalize-v]
        }
      @strong-step-at-q |
        (forall m: Nat; less_than(m, q) -> forall v: Seq; listsWithoutRepetition(v, m) -> noEntryIsItsOwnInverse(v, m) -> closedUnderInverse(v, m) -> divides(TWO, m)) -> forall v: Seq; listsWithoutRepetition(v, q) -> noEntryIsItsOwnInverse(v, q) -> closedUnderInverse(v, q) -> divides(TWO, q)
        [by implies_intro given-shorter]
    }
  @strong-step-for-all-q |
    forall q: Nat; (forall m: Nat; less_than(m, q) -> forall v: Seq; listsWithoutRepetition(v, m) -> noEntryIsItsOwnInverse(v, m) -> closedUnderInverse(v, m) -> divides(TWO, m)) -> forall v: Seq; listsWithoutRepetition(v, q) -> noEntryIsItsOwnInverse(v, q) -> closedUnderInverse(v, q) -> divides(TWO, q)
    [by forall_intro strong-step]
  @conclusion |
    forall q: Nat; forall v: Seq; listsWithoutRepetition(v, q) -> noEntryIsItsOwnInverse(v, q) -> closedUnderInverse(v, q) -> divides(TWO, q)
    [using instantiation strongInduction((fun q: Nat => forall v: Seq; listsWithoutRepetition(v, q) -> noEntryIsItsOwnInverse(v, q) -> closedUnderInverse(v, q) -> divides(TWO, q))) strong-step-for-all-q]
qed

// A FINITE GROUP OF EVEN ORDER HAS AN ELEMENT OF ORDER 2 (Judson §3.2, Exercise 32). "G has
// order n" is a listing: a sequence of n distinct elements containing every element. Split it
// into the self-inverse elements (a·a = e) and the rest; the rest pairs off (pairing lemma), so
// its count is even, so the self-inverse count is even too; it contains e, so it is at least 2,
// and a second self-inverse element is the a ≠ e with a² = e.
theorem evenOrderGivesAnInvolution: forall n: Nat; forall w: Seq;
  listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> divides(TWO, n) -> exists a: Grp; a != E and op(a, a) = E
proof
  @generalize-n |
    fix n: Nat {
      @generalize-w |
        fix w: Seq {
          @given-injective |
            assume listsWithoutRepetition(w, n) {
              @given-covers |
                assume (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) {
                  @given-even |
                    assume divides(TWO, n) {
                      @injective |
                        listsWithoutRepetition(w, n)
                        [by hypothesis given-injective]
                      @covers |
                        (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g)
                        [by hypothesis given-covers]
                      @n-even |
                        divides(TWO, n)
                        [by hypothesis given-even]
                      @splitting |
                        forall m0: Nat; forall w0: Seq; (forall i: Nat; forall j: Nat; less_than(i, m0) -> less_than(j, m0) -> at(w0, i) = at(w0, j) -> i = j) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m0 and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m0) and at(v, j) = at(w0, i) and op(at(w0, i), at(w0, i)) = E) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m0) -> op(at(w0, i), at(w0, i)) = E -> exists j: Nat; less_than(j, p) and at(v, j) = at(w0, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m0) and at(v2, j) = at(w0, i) and (not (op(at(w0, i), at(w0, i)) = E))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m0) -> (not (op(at(w0, i), at(w0, i)) = E)) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w0, i)))
                        [using instantiation splittingAListing((fun x: Grp => op(x, x) = E))]
                      @split |
                        exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and op(at(w, i), at(w, i)) = E) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> op(at(w, i), at(w, i)) = E -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not (op(at(w, i), at(w, i)) = E))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not (op(at(w, i), at(w, i)) = E)) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [using specialize splitting(n, w) injective]
                      @with-v |
                        unpack v: Seq from split {
                          @after-v |
                            exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and op(at(w, i), at(w, i)) = E) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> op(at(w, i), at(w, i)) = E -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not (op(at(w, i), at(w, i)) = E))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not (op(at(w, i), at(w, i)) = E)) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                            [by hypothesis with-v]
                          @with-p |
                            unpack p: Nat from after-v {
                              @after-p |
                                exists v2: Seq; exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and op(at(w, i), at(w, i)) = E) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> op(at(w, i), at(w, i)) = E -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not (op(at(w, i), at(w, i)) = E))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not (op(at(w, i), at(w, i)) = E)) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                [by hypothesis with-p]
                              @with-v2 |
                                unpack v2: Seq from after-p {
                                  @after-v2 |
                                    exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and op(at(w, i), at(w, i)) = E) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> op(at(w, i), at(w, i)) = E -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not (op(at(w, i), at(w, i)) = E))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not (op(at(w, i), at(w, i)) = E)) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                    [by hypothesis with-v2]
                                  @with-q |
                                    unpack q: Nat from after-v2 {
                                      @split-facts |
                                        add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and op(at(w, i), at(w, i)) = E) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> op(at(w, i), at(w, i)) = E -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not (op(at(w, i), at(w, i)) = E))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not (op(at(w, i), at(w, i)) = E)) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                        [by hypothesis with-q]
                                      @lengths-add |
                                        add(p, q) = n
                                        [using tautology split-facts]
                                      @self-entries |
                                        forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and op(at(w, i), at(w, i)) = E
                                        [using tautology split-facts]
                                      @self-injective |
                                        forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j
                                        [using tautology split-facts]
                                      @self-covers |
                                        forall i: Nat; less_than(i, n) -> op(at(w, i), at(w, i)) = E -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                        [using tautology split-facts]
                                      @other-entries |
                                        forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not (op(at(w, i), at(w, i)) = E))
                                        [using tautology split-facts]
                                      @other-injective |
                                        listsWithoutRepetition(v2, q)
                                        [using tautology split-facts]
                                      @other-covers |
                                        forall i: Nat; less_than(i, n) -> (not (op(at(w, i), at(w, i)) = E)) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)
                                        [using tautology split-facts]

                                      // the non-self-inverse listing pairs off
                                      @generalize-j-for-no-fixed-point |
                                        fix j: Nat {
                                          @given-j-other |
                                            assume less_than(j, q) {
                                              @j-other |
                                                less_than(j, q)
                                                [by hypothesis given-j-other]
                                              @source-exists |
                                                exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not (op(at(w, i), at(w, i)) = E))
                                                [using specialize other-entries(j) j-other]
                                              @with-source-i |
                                                unpack i: Nat from source-exists {
                                                  @source-facts |
                                                    less_than(i, n) and at(v2, j) = at(w, i) and (not (op(at(w, i), at(w, i)) = E))
                                                    [by hypothesis with-source-i]
                                                  @entry-is-source |
                                                    at(v2, j) = at(w, i)
                                                    [using tautology source-facts]
                                                  @source-not-self-inverse |
                                                    not (op(at(w, i), at(w, i)) = E)
                                                    [using tautology source-facts]
                                                  @suppose-fixed |
                                                    assume at(w, i) = inverse(at(w, i)) {
                                                      @fixed |
                                                        at(w, i) = inverse(at(w, i))
                                                        [by hypothesis suppose-fixed]
                                                      @source-times-inverse |
                                                        op(at(w, i), inverse(at(w, i))) = E
                                                        [using specialize opInverseRight(at(w, i))]
                                                      @source-squared |
                                                        op(at(w, i), at(w, i)) = E
                                                        [by rewrite fixed source-times-inverse]
                                                    }
                                                  @source-not-fixed |
                                                    at(w, i) != inverse(at(w, i))
                                                    [by not_intro suppose-fixed source-squared source-not-self-inverse]
                                                  @conclusion-entry-not-fixed |
                                                    at(v2, j) != inverse(at(v2, j))
                                                    [by rewrite entry-is-source source-not-fixed]
                                                }
                                              @conclusion-not-fixed-at-j |
                                                at(v2, j) != inverse(at(v2, j))
                                                [by exists_elim with-source-i]
                                            }
                                          @conclusion-not-fixed-clause |
                                            less_than(j, q) -> at(v2, j) != inverse(at(v2, j))
                                            [by implies_intro given-j-other]
                                        }
                                      @other-no-fixed-point |
                                        noEntryIsItsOwnInverse(v2, q)
                                        [by forall_intro generalize-j-for-no-fixed-point]
                                      @generalize-j-for-closed |
                                        fix j: Nat {
                                          @given-j-other |
                                            assume less_than(j, q) {
                                              @j-other |
                                                less_than(j, q)
                                                [by hypothesis given-j-other]
                                              @source-exists |
                                                exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not (op(at(w, i), at(w, i)) = E))
                                                [using specialize other-entries(j) j-other]
                                              @with-source-i |
                                                unpack i: Nat from source-exists {
                                                  @source-facts |
                                                    less_than(i, n) and at(v2, j) = at(w, i) and (not (op(at(w, i), at(w, i)) = E))
                                                    [by hypothesis with-source-i]
                                                  @entry-is-source |
                                                    at(v2, j) = at(w, i)
                                                    [using tautology source-facts]
                                                  @source-not-self-inverse |
                                                    not (op(at(w, i), at(w, i)) = E)
                                                    [using tautology source-facts]
                                                  @inverse-is-listed |
                                                    exists i2: Nat; less_than(i2, n) and at(w, i2) = inverse(at(w, i))
                                                    [using specialize covers(inverse(at(w, i)))]
                                                  @with-inverse-index-i2 |
                                                    unpack i2: Nat from inverse-is-listed {
                                                      @inverse-index-facts |
                                                        less_than(i2, n) and at(w, i2) = inverse(at(w, i))
                                                        [by hypothesis with-inverse-index-i2]
                                                      @i2-below-n |
                                                        less_than(i2, n)
                                                        [by and_elim_left inverse-index-facts]
                                                      @entry-i2-is-the-inverse |
                                                        at(w, i2) = inverse(at(w, i))
                                                        [by and_elim_right inverse-index-facts]
                                                      @suppose-inverse-self-inverse |
                                                        assume op(inverse(at(w, i)), inverse(at(w, i))) = E {
                                                          @inverse-squared |
                                                            op(inverse(at(w, i)), inverse(at(w, i))) = E
                                                            [by hypothesis suppose-inverse-self-inverse]
                                                          @inverse-is-its-own-inverse |
                                                            inverse(at(w, i)) = inverse(inverse(at(w, i)))
                                                            [using specialize inverseUnique(inverse(at(w, i)), inverse(at(w, i))) inverse-squared]
                                                          @source-undone |
                                                            inverse(inverse(at(w, i))) = at(w, i)
                                                            [using specialize invInvolution(at(w, i))]
                                                          @inverse-is-source |
                                                            inverse(at(w, i)) = at(w, i)
                                                            [using chain inverse-is-its-own-inverse source-undone]
                                                          @source-squared |
                                                            op(at(w, i), at(w, i)) = E
                                                            [by rewrite inverse-is-source inverse-squared]
                                                        }
                                                      @inverse-not-self-inverse |
                                                        not (op(inverse(at(w, i)), inverse(at(w, i))) = E)
                                                        [by not_intro suppose-inverse-self-inverse source-squared source-not-self-inverse]
                                                      @entry-i2-not-self-inverse |
                                                        not (op(at(w, i2), at(w, i2)) = E)
                                                        [by rewrite entry-i2-is-the-inverse inverse-not-self-inverse]
                                                      @inverse-in-other |
                                                        exists j2: Nat; less_than(j2, q) and at(v2, j2) = at(w, i2)
                                                        [using specialize other-covers(i2) i2-below-n entry-i2-not-self-inverse]
                                                      @with-other-index-j2 |
                                                        unpack j2: Nat from inverse-in-other {
                                                          @other-index-facts |
                                                            less_than(j2, q) and at(v2, j2) = at(w, i2)
                                                            [by hypothesis with-other-index-j2]
                                                          @j2-other |
                                                            less_than(j2, q)
                                                            [by and_elim_left other-index-facts]
                                                          @other-at-j2-a |
                                                            at(v2, j2) = at(w, i2)
                                                            [by and_elim_right other-index-facts]
                                                          @other-at-j2-b |
                                                            at(v2, j2) = inverse(at(w, i))
                                                            [using chain other-at-j2-a entry-i2-is-the-inverse]
                                                          @other-at-j2 |
                                                            at(v2, j2) = inverse(at(v2, j))
                                                            [by rewrite entry-is-source other-at-j2-b]
                                                          @j2-other-and-inverts |
                                                            less_than(j2, q) and at(v2, j2) = inverse(at(v2, j))
                                                            [by and_intro j2-other other-at-j2]
                                                          @conclusion-witness-j2 |
                                                            exists j3: Nat; less_than(j3, q) and at(v2, j3) = inverse(at(v2, j))
                                                            [by exists_intro(j2) j2-other-and-inverts]
                                                        }
                                                      @conclusion-with-j2 |
                                                        exists j3: Nat; less_than(j3, q) and at(v2, j3) = inverse(at(v2, j))
                                                        [by exists_elim with-other-index-j2]
                                                    }
                                                  @conclusion-with-i2 |
                                                    exists j3: Nat; less_than(j3, q) and at(v2, j3) = inverse(at(v2, j))
                                                    [by exists_elim with-inverse-index-i2]
                                                }
                                              @conclusion-closed-at-j |
                                                exists j3: Nat; less_than(j3, q) and at(v2, j3) = inverse(at(v2, j))
                                                [by exists_elim with-source-i]
                                            }
                                          @conclusion-closed-clause |
                                            less_than(j, q) -> exists j3: Nat; less_than(j3, q) and at(v2, j3) = inverse(at(v2, j))
                                            [by implies_intro given-j-other]
                                        }
                                      @other-closed |
                                        closedUnderInverse(v2, q)
                                        [by forall_intro generalize-j-for-closed]
                                      @q-even |
                                        divides(TWO, q)
                                        [using specialize pairedListingHasEvenLength(q, v2) other-injective other-no-fixed-point other-closed]

                                      // so the self-inverse count p = n - q is even, and it is at least 2
                                      @difference-even |
                                        divides(TWO, sub(n, q))
                                        [using specialize dividesSub(TWO, n, q) n-even q-even]
                                      @difference-is-p-a |
                                        sub(add(p, q), q) = p
                                        [using specialize subAddCancel(p, q)]
                                      @difference-is-p |
                                        sub(n, q) = p
                                        [by rewrite lengths-add difference-is-p-a]
                                      @p-even |
                                        divides(TWO, p)
                                        [by rewrite difference-is-p difference-even]
                                      @identity-squared |
                                        op(E, E) = E
                                        [using specialize opIdentityLeft(E)]
                                      @identity-is-listed |
                                        exists i: Nat; less_than(i, n) and at(w, i) = E
                                        [using specialize covers(E)]
                                      @with-identity-index-i0 |
                                        unpack i0: Nat from identity-is-listed {
                                          @identity-index-facts |
                                            less_than(i0, n) and at(w, i0) = E
                                            [by hypothesis with-identity-index-i0]
                                          @i0-below-n |
                                            less_than(i0, n)
                                            [by and_elim_left identity-index-facts]
                                          @entry-i0-is-identity |
                                            at(w, i0) = E
                                            [by and_elim_right identity-index-facts]
                                          @entry-i0-self-inverse |
                                            op(at(w, i0), at(w, i0)) = E
                                            [by rewrite entry-i0-is-identity identity-squared]
                                          @identity-in-self |
                                            exists j: Nat; less_than(j, p) and at(v, j) = at(w, i0)
                                            [using specialize self-covers(i0) i0-below-n entry-i0-self-inverse]
                                          @with-self-index-j0 |
                                            unpack j0: Nat from identity-in-self {
                                              @self-index-facts |
                                                less_than(j0, p) and at(v, j0) = at(w, i0)
                                                [by hypothesis with-self-index-j0]
                                              @j0-below-p |
                                                less_than(j0, p)
                                                [by and_elim_left self-index-facts]
                                              @p-is-double |
                                                exists k: Nat; p = mul(TWO, k)
                                                [using tautology p-even]
                                              @with-half-k |
                                                unpack k: Nat from p-is-double {
                                                  @p-is-twice-k |
                                                    p = mul(TWO, k)
                                                    [by hypothesis with-half-k]
                                                  @k-zero-or-succ |
                                                    k = ZERO or (exists k2: Nat; k = succ(k2))
                                                    [using specialize zeroOrSucc(k)]
                                                  @one-below-p |
                                                    less_than(succ(ZERO), p)
                                                    case k-zero-or-succ {
                                                      @when-k-zero |
                                                        assume k = ZERO {
                                                          @k-is-zero |
                                                            k = ZERO
                                                            [by hypothesis when-k-zero]
                                                          @p-is-twice-zero |
                                                            p = mul(TWO, ZERO)
                                                            [by rewrite k-is-zero p-is-twice-k]
                                                          @twice-zero |
                                                            mul(TWO, ZERO) = ZERO
                                                            [using specialize mulZeroRight(TWO)]
                                                          @p-is-zero |
                                                            p = ZERO
                                                            [using chain p-is-twice-zero twice-zero]
                                                          @j0-below-zero |
                                                            less_than(j0, ZERO)
                                                            [by rewrite p-is-zero j0-below-p]
                                                          @nothing-below-zero |
                                                            not less_than(j0, ZERO)
                                                            [using specialize notLessThanZero(j0)]
                                                          @conclusion-when-k-zero |
                                                            less_than(succ(ZERO), p)
                                                            [by absurd j0-below-zero nothing-below-zero]
                                                        }
                                                      @when-k-succ |
                                                        assume exists k2: Nat; k = succ(k2) {
                                                          @half-predecessor-exists |
                                                            exists k2: Nat; k = succ(k2)
                                                            [by hypothesis when-k-succ]
                                                          @with-half-predecessor-k2 |
                                                            unpack k2: Nat from half-predecessor-exists {
                                                              @k-is-succ |
                                                                k = succ(k2)
                                                                [by hypothesis with-half-predecessor-k2]
                                                              @p-is-twice-succ |
                                                                p = mul(TWO, succ(k2))
                                                                [by rewrite k-is-succ p-is-twice-k]
                                                              @twice-succ-unfolds |
                                                                mul(TWO, succ(k2)) = add(mul(TWO, k2), TWO)
                                                                [using specialize mulSuccRight(TWO, k2)]
                                                              @two-is-two |
                                                                TWO = succ(succ(ZERO))
                                                                [by cite twoIsSuccSuccZero]
                                                              @plus-two-unfolds-a |
                                                                add(mul(TWO, k2), succ(succ(ZERO))) = succ(add(mul(TWO, k2), succ(ZERO)))
                                                                [using specialize addSuccRight(mul(TWO, k2), succ(ZERO))]
                                                              @plus-two-unfolds-b |
                                                                add(mul(TWO, k2), succ(ZERO)) = succ(add(mul(TWO, k2), ZERO))
                                                                [using specialize addSuccRight(mul(TWO, k2), ZERO)]
                                                              @plus-zero |
                                                                add(mul(TWO, k2), ZERO) = mul(TWO, k2)
                                                                [using specialize addZeroRight(mul(TWO, k2))]
                                                              @plus-one |
                                                                add(mul(TWO, k2), succ(ZERO)) = succ(mul(TWO, k2))
                                                                [by rewrite plus-zero plus-two-unfolds-b]
                                                              @plus-two |
                                                                add(mul(TWO, k2), succ(succ(ZERO))) = succ(succ(mul(TWO, k2)))
                                                                [by rewrite plus-one plus-two-unfolds-a]
                                                              @twice-succ-in-successors |
                                                                mul(TWO, succ(k2)) = add(mul(TWO, k2), succ(succ(ZERO)))
                                                                [by rewrite two-is-two twice-succ-unfolds]
                                                              @p-in-successors |
                                                                p = succ(succ(mul(TWO, k2)))
                                                                [using chain p-is-twice-succ twice-succ-in-successors plus-two]
                                                              @zero-below-succ-double |
                                                                less_than(ZERO, succ(mul(TWO, k2)))
                                                                [using specialize zeroBelowSucc(mul(TWO, k2))]
                                                              @one-below-succ-succ-double |
                                                                less_than(succ(ZERO), succ(succ(mul(TWO, k2))))
                                                                [using specialize succPreservesOrder(ZERO, succ(mul(TWO, k2))) zero-below-succ-double]
                                                              @conclusion-when-k-succ-at-k2 |
                                                                less_than(succ(ZERO), p)
                                                                [by rewrite p-in-successors one-below-succ-succ-double]
                                                            }
                                                          @conclusion-when-k-succ |
                                                            less_than(succ(ZERO), p)
                                                            [by exists_elim with-half-predecessor-k2]
                                                        }
                                                    }
                                                  @zero-below-one |
                                                    less_than(ZERO, succ(ZERO))
                                                    [using specialize zeroBelowSucc(ZERO)]
                                                  @zero-below-p |
                                                    less_than(ZERO, p)
                                                    [using specialize lessThanTransitive(ZERO, succ(ZERO), p) zero-below-one one-below-p]
                                                  @first-two-differ-a |
                                                    at(v, ZERO) = at(v, succ(ZERO)) -> ZERO = succ(ZERO)
                                                    [using specialize self-injective(ZERO, succ(ZERO)) zero-below-p one-below-p]
                                                  @zero-not-one |
                                                    not (ZERO = succ(ZERO))
                                                    [using specialize zeroIsNotSucc(ZERO)]
                                                  @first-two-differ |
                                                    not (at(v, ZERO) = at(v, succ(ZERO)))
                                                    [using tautology first-two-differ-a zero-not-one]
                                                  // both are self-inverse
                                                  @first-source-exists |
                                                    exists i: Nat; less_than(i, n) and at(v, ZERO) = at(w, i) and op(at(w, i), at(w, i)) = E
                                                    [using specialize self-entries(ZERO) zero-below-p]
                                                  @second-source-exists |
                                                    exists i: Nat; less_than(i, n) and at(v, succ(ZERO)) = at(w, i) and op(at(w, i), at(w, i)) = E
                                                    [using specialize self-entries(succ(ZERO)) one-below-p]
                                                  @with-first-source-i1 |
                                                    unpack i1: Nat from first-source-exists {
                                                      @first-source-facts |
                                                        less_than(i1, n) and at(v, ZERO) = at(w, i1) and op(at(w, i1), at(w, i1)) = E
                                                        [by hypothesis with-first-source-i1]
                                                      @first-is-source |
                                                        at(v, ZERO) = at(w, i1)
                                                        [using tautology first-source-facts]
                                                      @first-source-squared |
                                                        op(at(w, i1), at(w, i1)) = E
                                                        [using tautology first-source-facts]
                                                      @first-squared |
                                                        op(at(v, ZERO), at(v, ZERO)) = E
                                                        [by rewrite first-is-source first-source-squared]
                                                      @with-second-source-i2 |
                                                        unpack i2: Nat from second-source-exists {
                                                          @second-source-facts |
                                                            less_than(i2, n) and at(v, succ(ZERO)) = at(w, i2) and op(at(w, i2), at(w, i2)) = E
                                                            [by hypothesis with-second-source-i2]
                                                          @second-is-source |
                                                            at(v, succ(ZERO)) = at(w, i2)
                                                            [using tautology second-source-facts]
                                                          @second-source-squared |
                                                            op(at(w, i2), at(w, i2)) = E
                                                            [using tautology second-source-facts]
                                                          @second-squared |
                                                            op(at(v, succ(ZERO)), at(v, succ(ZERO))) = E
                                                            [by rewrite second-is-source second-source-squared]
                                                          @first-is-identity-or-not |
                                                            at(v, ZERO) = E or (not (at(v, ZERO) = E))
                                                            [using tautology]
                                                          @conclusion-involution |
                                                            exists a: Grp; a != E and op(a, a) = E
                                                            case first-is-identity-or-not {
                                                              @when-first-is-identity |
                                                                assume at(v, ZERO) = E {
                                                                  @first-is-identity |
                                                                    at(v, ZERO) = E
                                                                    [by hypothesis when-first-is-identity]
                                                                  @suppose-second-is-identity |
                                                                    assume at(v, succ(ZERO)) = E {
                                                                      @second-is-identity |
                                                                        at(v, succ(ZERO)) = E
                                                                        [by hypothesis suppose-second-is-identity]
                                                                      @first-two-agree |
                                                                        at(v, ZERO) = at(v, succ(ZERO))
                                                                        [by rewrite second-is-identity first-is-identity]
                                                                    }
                                                                  @second-is-not-identity |
                                                                    at(v, succ(ZERO)) != E
                                                                    [by not_intro suppose-second-is-identity first-two-agree first-two-differ]
                                                                  @second-witness-facts |
                                                                    at(v, succ(ZERO)) != E and op(at(v, succ(ZERO)), at(v, succ(ZERO))) = E
                                                                    [by and_intro second-is-not-identity second-squared]
                                                                  @conclusion-second-witnesses |
                                                                    exists a: Grp; a != E and op(a, a) = E
                                                                    [by exists_intro(at(v, succ(ZERO))) second-witness-facts]
                                                                }
                                                              @when-first-is-not-identity |
                                                                assume not (at(v, ZERO) = E) {
                                                                  @first-is-not-identity |
                                                                    at(v, ZERO) != E
                                                                    [by hypothesis when-first-is-not-identity]
                                                                  @first-witness-facts |
                                                                    at(v, ZERO) != E and op(at(v, ZERO), at(v, ZERO)) = E
                                                                    [by and_intro first-is-not-identity first-squared]
                                                                  @conclusion-first-witnesses |
                                                                    exists a: Grp; a != E and op(a, a) = E
                                                                    [by exists_intro(at(v, ZERO)) first-witness-facts]
                                                                }
                                                            }
                                                        }
                                                      @conclusion-with-i2 |
                                                        exists a: Grp; a != E and op(a, a) = E
                                                        [by exists_elim with-second-source-i2]
                                                    }
                                                  @conclusion-with-i1 |
                                                    exists a: Grp; a != E and op(a, a) = E
                                                    [by exists_elim with-first-source-i1]
                                                }
                                              @conclusion-with-k |
                                                exists a: Grp; a != E and op(a, a) = E
                                                [by exists_elim with-half-k]
                                            }
                                          @conclusion-with-j0 |
                                            exists a: Grp; a != E and op(a, a) = E
                                            [by exists_elim with-self-index-j0]
                                        }
                                      @conclusion-with-i0 |
                                        exists a: Grp; a != E and op(a, a) = E
                                        [by exists_elim with-identity-index-i0]
                                    }
                                  @conclusion-with-q |
                                    exists a: Grp; a != E and op(a, a) = E
                                    [by exists_elim with-q]
                                }
                              @conclusion-with-v2 |
                                exists a: Grp; a != E and op(a, a) = E
                                [by exists_elim with-v2]
                            }
                          @conclusion-with-p |
                            exists a: Grp; a != E and op(a, a) = E
                            [by exists_elim with-p]
                        }
                      @conclusion-with-v |
                        exists a: Grp; a != E and op(a, a) = E
                        [by exists_elim with-v]
                    }
                  @conclusion-given-even |
                    divides(TWO, n) -> exists a: Grp; a != E and op(a, a) = E
                    [by implies_intro given-even]
                }
              @conclusion-given-covers |
                (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> divides(TWO, n) -> exists a: Grp; a != E and op(a, a) = E
                [by implies_intro given-covers]
            }
          @conclusion-at-w |
            listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> divides(TWO, n) -> exists a: Grp; a != E and op(a, a) = E
            [by implies_intro given-injective]
        }
      @discharge-w |
        forall w: Seq; listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> divides(TWO, n) -> exists a: Grp; a != E and op(a, a) = E
        [by forall_intro generalize-w]
    }
  @conclusion |
    forall n: Nat; forall w: Seq;
      listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> divides(TWO, n) -> exists a: Grp; a != E and op(a, a) = E
    [by forall_intro generalize-n]
qed

// -- generators of a finite group come in pairs ---------------------------------------------

// g GENERATES the group: every element is an integer power of g (std/group/power.b4m).
define generates(g) = forall y: Grp; exists k: Int; y = power(g, k)

// If g² = e, every power of g is e or g: induction over the integer exponent, both ways
// (g⁻¹ = g as well).
theorem squareIdentityPowersAreTwoValued: forall g: Grp; op(g, g) = E -> forall k: Int; (power(g, k) = E or power(g, k) = g)
proof
  @generalize-g |
    fix g: Grp {
      @given-square |
        assume op(g, g) = E {
          @square |
            op(g, g) = E
            [by hypothesis given-square]
          @g-is-its-inverse |
            g = inverse(g)
            [using specialize inverseUnique(g, g) square]
          @identity-times-g |
            op(E, g) = g
            [using specialize opIdentityLeft(g)]
          @zeroth-power |
            power(g, IZERO) = E
            [using specialize powerZero(g)]
          @base-case |
            power(g, IZERO) = E or power(g, IZERO) = g
            [using tautology zeroth-power]
          @step-up |
            fix k: Int {
              @given-two-valued |
                assume power(g, k) = E or power(g, k) = g {
                  @two-valued |
                    power(g, k) = E or power(g, k) = g
                    [by hypothesis given-two-valued]
                  @next-unfolds |
                    power(g, isucc(k)) = op(power(g, k), g)
                    [using specialize powerSucc(g, k)]
                  @conclusion-next-two-valued |
                    power(g, isucc(k)) = E or power(g, isucc(k)) = g
                    case two-valued {
                      @when-identity |
                        assume power(g, k) = E {
                          @is-identity |
                            power(g, k) = E
                            [by hypothesis when-identity]
                          @next-is-g |
                            power(g, isucc(k)) = g
                            [using simplify next-unfolds is-identity identity-times-g]
                          @conclusion-when-identity |
                            power(g, isucc(k)) = E or power(g, isucc(k)) = g
                            [using tautology next-is-g]
                        }
                      @when-g |
                        assume power(g, k) = g {
                          @is-g |
                            power(g, k) = g
                            [by hypothesis when-g]
                          @next-is-identity |
                            power(g, isucc(k)) = E
                            [using simplify next-unfolds is-g square]
                          @conclusion-when-g |
                            power(g, isucc(k)) = E or power(g, isucc(k)) = g
                            [using tautology next-is-identity]
                        }
                    }
                }
              @conclusion-step-up |
                (power(g, k) = E or power(g, k) = g) -> (power(g, isucc(k)) = E or power(g, isucc(k)) = g)
                [by implies_intro given-two-valued]
            }
          @step-up-for-all-k |
            forall k: Int; (power(g, k) = E or power(g, k) = g) -> (power(g, isucc(k)) = E or power(g, isucc(k)) = g)
            [by forall_intro step-up]
          @step-down |
            fix k: Int {
              @given-two-valued |
                assume power(g, k) = E or power(g, k) = g {
                  @two-valued |
                    power(g, k) = E or power(g, k) = g
                    [by hypothesis given-two-valued]
                  @previous-unfolds-a |
                    power(g, iprev(k)) = op(power(g, k), inverse(g))
                    [using specialize powerPrev(g, k)]
                  @previous-unfolds |
                    power(g, iprev(k)) = op(power(g, k), g)
                    [by rewrite g-is-its-inverse previous-unfolds-a]
                  @conclusion-previous-two-valued |
                    power(g, iprev(k)) = E or power(g, iprev(k)) = g
                    case two-valued {
                      @when-identity |
                        assume power(g, k) = E {
                          @is-identity |
                            power(g, k) = E
                            [by hypothesis when-identity]
                          @previous-is-g |
                            power(g, iprev(k)) = g
                            [using simplify previous-unfolds is-identity identity-times-g]
                          @conclusion-when-identity |
                            power(g, iprev(k)) = E or power(g, iprev(k)) = g
                            [using tautology previous-is-g]
                        }
                      @when-g |
                        assume power(g, k) = g {
                          @is-g |
                            power(g, k) = g
                            [by hypothesis when-g]
                          @previous-is-identity |
                            power(g, iprev(k)) = E
                            [using simplify previous-unfolds is-g square]
                          @conclusion-when-g |
                            power(g, iprev(k)) = E or power(g, iprev(k)) = g
                            [using tautology previous-is-identity]
                        }
                    }
                }
              @conclusion-step-down |
                (power(g, k) = E or power(g, k) = g) -> (power(g, iprev(k)) = E or power(g, iprev(k)) = g)
                [by implies_intro given-two-valued]
            }
          @step-down-for-all-k |
            forall k: Int; (power(g, k) = E or power(g, k) = g) -> (power(g, iprev(k)) = E or power(g, iprev(k)) = g)
            [by forall_intro step-down]
          @conclusion-for-all-k |
            forall k: Int; (power(g, k) = E or power(g, k) = g)
            [using instantiation intInduction((fun k: Int => power(g, k) = E or power(g, k) = g)) base-case step-up-for-all-k step-down-for-all-k]
        }
      @conclusion-at-g |
        op(g, g) = E -> forall k: Int; (power(g, k) = E or power(g, k) = g)
        [by implies_intro given-square]
    }
  @conclusion |
    forall g: Grp; op(g, g) = E -> forall k: Int; (power(g, k) = E or power(g, k) = g)
    [by forall_intro generalize-g]
qed

// The inverse of a generator generates: y = g^k = (g⁻¹)^(−k).
theorem inverseOfAGeneratorGenerates: forall g: Grp; generates(g) -> generates(inverse(g))
proof
  @generalize-g |
    fix g: Grp {
      @given-generates |
        assume generates(g) {
          @g-generates |
            generates(g)
            [by hypothesis given-generates]
          @generalize-y |
            fix y: Grp {
              @exponent-exists |
                exists k: Int; y = power(g, k)
                [using specialize g-generates(y)]
              @with-exponent-k |
                unpack k: Int from exponent-exists {
                  @y-is-a-power |
                    y = power(g, k)
                    [by hypothesis with-exponent-k]
                  @inverse-base |
                    power(inverse(g), ineg(k)) = inverse(power(g, ineg(k)))
                    [using specialize powerInverseBase(g, ineg(k))]
                  @negated-exponent |
                    power(g, ineg(k)) = inverse(power(g, k))
                    [using specialize powerNegInverse(g, k)]
                  @doubly-inverted |
                    power(inverse(g), ineg(k)) = inverse(inverse(power(g, k)))
                    [by rewrite negated-exponent inverse-base]
                  @undone |
                    inverse(inverse(power(g, k))) = power(g, k)
                    [using specialize invInvolution(power(g, k))]
                  @inverse-power-is-the-power |
                    power(inverse(g), ineg(k)) = power(g, k)
                    [using chain doubly-inverted undone]
                  @y-is-an-inverse-power |
                    y = power(inverse(g), ineg(k))
                    [by rewrite inverse-power-is-the-power y-is-a-power]
                  @conclusion-witness |
                    exists k2: Int; y = power(inverse(g), k2)
                    [by exists_intro(ineg(k)) y-is-an-inverse-power]
                }
              @conclusion-y-is-reached |
                exists k2: Int; y = power(inverse(g), k2)
                [by exists_elim with-exponent-k]
            }
          @conclusion-inverse-generates |
            generates(inverse(g))
            [by forall_intro generalize-y]
        }
      @conclusion-at-g |
        generates(g) -> generates(inverse(g))
        [by implies_intro given-generates]
    }
  @conclusion |
    forall g: Grp; generates(g) -> generates(inverse(g))
    [by forall_intro generalize-g]
qed

// In a group of order n > 2 no generator is its own inverse: g = g⁻¹ makes every power of g
// one of e, g, so a listing of the group takes at most two values, i.e. n ≤ 2.
theorem generatorIsNotSelfInverse: forall n: Nat; forall w: Seq;
  listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> less_than(succ(succ(ZERO)), n) ->
  forall g: Grp; generates(g) -> g != inverse(g)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-w |
        fix w: Seq {
          @given-injective |
            assume listsWithoutRepetition(w, n) {
              @given-covers |
                assume (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) {
                  @given-three |
                    assume less_than(succ(succ(ZERO)), n) {
                      @injective |
                        listsWithoutRepetition(w, n)
                        [by hypothesis given-injective]
                      @three |
                        less_than(succ(succ(ZERO)), n)
                        [by hypothesis given-three]
                      @generalize-g |
                        fix g: Grp {
                          @given-generates |
                            assume generates(g) {
                              @g-generates |
                                generates(g)
                                [by hypothesis given-generates]
                              @suppose-self-inverse |
                                assume g = inverse(g) {
                                  @self-inverse |
                                    g = inverse(g)
                                    [by hypothesis suppose-self-inverse]
                                  @g-times-inverse |
                                    op(g, inverse(g)) = E
                                    [using specialize opInverseRight(g)]
                                  @square |
                                    op(g, g) = E
                                    [by rewrite self-inverse g-times-inverse]
                                  @powers-two-valued |
                                    forall k: Int; (power(g, k) = E or power(g, k) = g)
                                    [using specialize squareIdentityPowersAreTwoValued(g) square]
                                  @generalize-i |
                                    fix i: Nat {
                                      @given-i-in-range |
                                        assume less_than(i, n) {
                                          @exponent-exists |
                                            exists k: Int; at(w, i) = power(g, k)
                                            [using specialize g-generates(at(w, i))]
                                          @with-exponent-k |
                                            unpack k: Int from exponent-exists {
                                              @entry-is-a-power |
                                                at(w, i) = power(g, k)
                                                [by hypothesis with-exponent-k]
                                              @power-two-valued |
                                                power(g, k) = E or power(g, k) = g
                                                [using specialize powers-two-valued(k)]
                                              @conclusion-entry-two-valued |
                                                at(w, i) = E or at(w, i) = g
                                                [by rewrite entry-is-a-power power-two-valued]
                                            }
                                          @conclusion-entry-two-valued-at-i |
                                            at(w, i) = E or at(w, i) = g
                                            [by exists_elim with-exponent-k]
                                        }
                                      @conclusion-two-valued-clause |
                                        less_than(i, n) -> (at(w, i) = E or at(w, i) = g)
                                        [by implies_intro given-i-in-range]
                                    }
                                  @listing-two-valued |
                                    forall i: Nat; less_than(i, n) -> (at(w, i) = E or at(w, i) = g)
                                    [by forall_intro generalize-i]
                                  @at-most-two |
                                    not less_than(succ(succ(ZERO)), n)
                                    [using specialize twoValuesAdmitAtMostTwoEntries(w, n, E, g) injective listing-two-valued]
                                }
                              @conclusion-not-self-inverse |
                                g != inverse(g)
                                [by not_intro suppose-self-inverse three at-most-two]
                            }
                          @conclusion-at-g |
                            generates(g) -> g != inverse(g)
                            [by implies_intro given-generates]
                        }
                      @discharge-g |
                        forall g: Grp; generates(g) -> g != inverse(g)
                        [by forall_intro generalize-g]
                    }
                  @conclusion-given-three |
                    less_than(succ(succ(ZERO)), n) -> forall g: Grp; generates(g) -> g != inverse(g)
                    [by implies_intro given-three]
                }
              @conclusion-given-covers |
                (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> less_than(succ(succ(ZERO)), n) -> forall g: Grp; generates(g) -> g != inverse(g)
                [by implies_intro given-covers]
            }
          @conclusion-at-w |
            listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> less_than(succ(succ(ZERO)), n) -> forall g: Grp; generates(g) -> g != inverse(g)
            [by implies_intro given-injective]
        }
      @discharge-w |
        forall w: Seq; listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> less_than(succ(succ(ZERO)), n) -> forall g: Grp; generates(g) -> g != inverse(g)
        [by forall_intro generalize-w]
    }
  @conclusion |
    forall n: Nat; forall w: Seq;
      listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> less_than(succ(succ(ZERO)), n) ->
      forall g: Grp; generates(g) -> g != inverse(g)
    [by forall_intro generalize-n]
qed

// THE GENERATORS OF A FINITE GROUP OF ORDER n > 2 ARE EVEN IN NUMBER (Judson §4.1, Exercise
// 29, for every finite group at once — ℤ_n gets it by model transfer). Split the listing of
// the group into the generators and the rest; the generators are closed under inverse and
// none is its own inverse, so they pair off.
theorem generatorsOfAFiniteGroupAreEvenInNumber: forall n: Nat; forall w: Seq;
  listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> less_than(succ(succ(ZERO)), n) -> exists v: Seq; exists p: Nat; (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and divides(TWO, p)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-w |
        fix w: Seq {
          @given-injective |
            assume listsWithoutRepetition(w, n) {
              @given-covers |
                assume (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) {
                  @given-three |
                    assume less_than(succ(succ(ZERO)), n) {
                      @injective |
                        listsWithoutRepetition(w, n)
                        [by hypothesis given-injective]
                      @covers |
                        (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g)
                        [by hypothesis given-covers]
                      @three |
                        less_than(succ(succ(ZERO)), n)
                        [by hypothesis given-three]
                      @no-generator-is-self-inverse |
                        forall g: Grp; generates(g) -> g != inverse(g)
                        [using specialize generatorIsNotSelfInverse(n, w) injective covers three]
                      @splitting |
                        forall m0: Nat; forall w0: Seq; (forall i: Nat; forall j: Nat; less_than(i, m0) -> less_than(j, m0) -> at(w0, i) = at(w0, j) -> i = j) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m0 and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m0) and at(v, j) = at(w0, i) and generates(at(w0, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m0) -> generates(at(w0, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w0, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m0) and at(v2, j) = at(w0, i) and (not generates(at(w0, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m0) -> (not generates(at(w0, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w0, i)))
                        [using instantiation splittingAListing((fun x: Grp => generates(x)))]
                      @split |
                        exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [using specialize splitting(n, w) injective]
                      @with-v |
                        unpack v: Seq from split {
                          @after-v |
                            exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                            [by hypothesis with-v]
                          @with-p |
                            unpack p: Nat from after-v {
                              @after-p |
                                exists v2: Seq; exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                [by hypothesis with-p]
                              @with-v2 |
                                unpack v2: Seq from after-p {
                                  @after-v2 |
                                    exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                    [by hypothesis with-v2]
                                  @with-q |
                                    unpack q: Nat from after-v2 {
                                      @split-facts |
                                        add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                        [by hypothesis with-q]
                                      @generator-entries |
                                        forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))
                                        [using tautology split-facts]
                                      @generators-injective |
                                        listsWithoutRepetition(v, p)
                                        [using tautology split-facts]
                                      @generators-covered |
                                        forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                        [using tautology split-facts]

                                      // the entries generate; every generator is an entry
                                      @generalize-j-for-entries |
                                        fix j: Nat {
                                          @given-j |
                                            assume less_than(j, p) {
                                              @j-in-range |
                                                less_than(j, p)
                                                [by hypothesis given-j]
                                              @source-exists |
                                                exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))
                                                [using specialize generator-entries(j) j-in-range]
                                              @with-source-i |
                                                unpack i: Nat from source-exists {
                                                  @source-facts |
                                                    less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))
                                                    [by hypothesis with-source-i]
                                                  @entry-is-source |
                                                    at(v, j) = at(w, i)
                                                    [using tautology source-facts]
                                                  @source-generates |
                                                    generates(at(w, i))
                                                    [using tautology source-facts]
                                                  @conclusion-entry-generates |
                                                    generates(at(v, j))
                                                    [by rewrite entry-is-source source-generates]
                                                }
                                              @conclusion-entry-generates-at-j |
                                                generates(at(v, j))
                                                [by exists_elim with-source-i]
                                            }
                                          @conclusion-entry-clause |
                                            less_than(j, p) -> generates(at(v, j))
                                            [by implies_intro given-j]
                                        }
                                      @entries-generate |
                                        forall j: Nat; less_than(j, p) -> generates(at(v, j))
                                        [by forall_intro generalize-j-for-entries]
                                      @generalize-g-for-covers |
                                        fix g: Grp {
                                          @given-g-generates |
                                            assume generates(g) {
                                              @g-generates |
                                                generates(g)
                                                [by hypothesis given-g-generates]
                                              @g-is-listed |
                                                exists i: Nat; less_than(i, n) and at(w, i) = g
                                                [using specialize covers(g)]
                                              @with-index-i |
                                                unpack i: Nat from g-is-listed {
                                                  @index-facts |
                                                    less_than(i, n) and at(w, i) = g
                                                    [by hypothesis with-index-i]
                                                  @i-in-range |
                                                    less_than(i, n)
                                                    [by and_elim_left index-facts]
                                                  @entry-is-g |
                                                    at(w, i) = g
                                                    [by and_elim_right index-facts]
                                                  @entry-generates |
                                                    generates(at(w, i))
                                                    [by rewrite entry-is-g g-generates]
                                                  @g-in-generators |
                                                    exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                                    [using specialize generators-covered(i) i-in-range entry-generates]
                                                  @conclusion-g-in-generators |
                                                    exists j: Nat; less_than(j, p) and at(v, j) = g
                                                    [by rewrite entry-is-g g-in-generators]
                                                }
                                              @conclusion-g-listed |
                                                exists j: Nat; less_than(j, p) and at(v, j) = g
                                                [by exists_elim with-index-i]
                                            }
                                          @conclusion-covers-clause |
                                            generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g
                                            [by implies_intro given-g-generates]
                                        }
                                      @generators-listed |
                                        forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g
                                        [by forall_intro generalize-g-for-covers]

                                      // the generators pair off
                                      @generalize-j-for-no-fixed-point |
                                        fix j: Nat {
                                          @given-j |
                                            assume less_than(j, p) {
                                              @j-in-range |
                                                less_than(j, p)
                                                [by hypothesis given-j]
                                              @entry-generates |
                                                generates(at(v, j))
                                                [using specialize entries-generate(j) j-in-range]
                                              @conclusion-entry-not-fixed |
                                                at(v, j) != inverse(at(v, j))
                                                [using specialize no-generator-is-self-inverse(at(v, j)) entry-generates]
                                            }
                                          @conclusion-not-fixed-clause |
                                            less_than(j, p) -> at(v, j) != inverse(at(v, j))
                                            [by implies_intro given-j]
                                        }
                                      @generators-no-fixed-point |
                                        noEntryIsItsOwnInverse(v, p)
                                        [by forall_intro generalize-j-for-no-fixed-point]
                                      @generalize-j-for-closed |
                                        fix j: Nat {
                                          @given-j |
                                            assume less_than(j, p) {
                                              @j-in-range |
                                                less_than(j, p)
                                                [by hypothesis given-j]
                                              @entry-generates |
                                                generates(at(v, j))
                                                [using specialize entries-generate(j) j-in-range]
                                              @inverse-generates |
                                                generates(inverse(at(v, j)))
                                                [using specialize inverseOfAGeneratorGenerates(at(v, j)) entry-generates]
                                              @conclusion-inverse-listed |
                                                exists j2: Nat; less_than(j2, p) and at(v, j2) = inverse(at(v, j))
                                                [using specialize generators-listed(inverse(at(v, j))) inverse-generates]
                                            }
                                          @conclusion-closed-clause |
                                            less_than(j, p) -> exists j2: Nat; less_than(j2, p) and at(v, j2) = inverse(at(v, j))
                                            [by implies_intro given-j]
                                        }
                                      @generators-closed |
                                        closedUnderInverse(v, p)
                                        [by forall_intro generalize-j-for-closed]
                                      @count-even |
                                        divides(TWO, p)
                                        [using specialize pairedListingHasEvenLength(p, v) generators-injective generators-no-fixed-point generators-closed]
                                      @generator-listing |
                                        (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and divides(TWO, p)
                                        [using tautology entries-generate generators-injective generators-listed count-even]
                                      @with-count |
                                        exists p2: Nat; (forall j: Nat; less_than(j, p2) -> generates(at(v, j))) and listsWithoutRepetition(v, p2) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p2) and at(v, j) = g) and divides(TWO, p2)
                                        [by exists_intro(p) generator-listing]
                                      @conclusion-witness-v |
                                        exists v3: Seq; exists p3: Nat; (forall j: Nat; less_than(j, p3) -> generates(at(v3, j))) and listsWithoutRepetition(v3, p3) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p3) and at(v3, j) = g) and divides(TWO, p3)
                                        [by exists_intro(v) with-count]
                                    }
                                  @conclusion-with-q |
                                    exists v3: Seq; exists p3: Nat; (forall j: Nat; less_than(j, p3) -> generates(at(v3, j))) and listsWithoutRepetition(v3, p3) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p3) and at(v3, j) = g) and divides(TWO, p3)
                                    [by exists_elim with-q]
                                }
                              @conclusion-with-v2 |
                                exists v3: Seq; exists p3: Nat; (forall j: Nat; less_than(j, p3) -> generates(at(v3, j))) and listsWithoutRepetition(v3, p3) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p3) and at(v3, j) = g) and divides(TWO, p3)
                                [by exists_elim with-v2]
                            }
                          @conclusion-with-p |
                            exists v3: Seq; exists p3: Nat; (forall j: Nat; less_than(j, p3) -> generates(at(v3, j))) and listsWithoutRepetition(v3, p3) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p3) and at(v3, j) = g) and divides(TWO, p3)
                            [by exists_elim with-p]
                        }
                      @conclusion-with-v |
                        exists v: Seq; exists p: Nat; (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and divides(TWO, p)
                        [by exists_elim with-v]
                    }
                  @conclusion-given-three |
                    less_than(succ(succ(ZERO)), n) -> exists v: Seq; exists p: Nat; (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and divides(TWO, p)
                    [by implies_intro given-three]
                }
              @conclusion-given-covers |
                (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> less_than(succ(succ(ZERO)), n) -> exists v: Seq; exists p: Nat; (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and divides(TWO, p)
                [by implies_intro given-covers]
            }
          @conclusion-at-w |
            listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> less_than(succ(succ(ZERO)), n) -> exists v: Seq; exists p: Nat; (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and divides(TWO, p)
            [by implies_intro given-injective]
        }
      @discharge-w |
        forall w: Seq; listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> less_than(succ(succ(ZERO)), n) -> exists v: Seq; exists p: Nat; (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and divides(TWO, p)
        [by forall_intro generalize-w]
    }
  @conclusion |
    forall n: Nat; forall w: Seq;
      listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> less_than(succ(succ(ZERO)), n) -> exists v: Seq; exists p: Nat; (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and divides(TWO, p)
    [by forall_intro generalize-n]
qed

// -- the generators and the non-generators, each listed ---------------------------------------
// The generator/non-generator split of a listing of the group, packaged: two injective listings,
// one of exactly the generators and one of exactly the rest, with lengths adding to the group's.
theorem generatorsAndNonGeneratorsAreListed: forall n: Nat; forall w: Seq;
  listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) ->
  exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = n
  and (forall j: Nat; less_than(j, p) -> generates(at(v, j)))
  and listsWithoutRepetition(v, p)
  and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g)
  and (forall j: Nat; less_than(j, q) -> (not generates(at(v2, j))))
  and listsWithoutRepetition(v2, q)
  and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q) and at(v2, j) = g)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-w |
        fix w: Seq {
          @given-injective |
            assume listsWithoutRepetition(w, n) {
              @given-covers |
                assume (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) {
                  @injective |
                    listsWithoutRepetition(w, n)
                    [by hypothesis given-injective]
                  @covers |
                    forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g
                    [by hypothesis given-covers]
                  @splitting |
                    forall m0: Nat; forall w0: Seq; (forall i: Nat; forall j: Nat; less_than(i, m0) -> less_than(j, m0) -> at(w0, i) = at(w0, j) -> i = j) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = m0 and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m0) and at(v, j) = at(w0, i) and generates(at(w0, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m0) -> generates(at(w0, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w0, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m0) and at(v2, j) = at(w0, i) and (not generates(at(w0, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m0) -> (not generates(at(w0, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w0, i)))
                    [using instantiation splittingAListing((fun x: Grp => generates(x)))]
                  @split |
                    exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                    [using specialize splitting(n, w) injective]
                  @with-v |
                    unpack v: Seq from split {
                      @after-v |
                        exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                        [by hypothesis with-v]
                      @with-p |
                        unpack p: Nat from after-v {
                          @after-p |
                            exists v2: Seq; exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                            [by hypothesis with-p]
                          @with-v2 |
                            unpack v2: Seq from after-p {
                              @after-v2 |
                                exists q: Nat; add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                [by hypothesis with-v2]
                              @with-q |
                                unpack q: Nat from after-v2 {
                                  @split-facts |
                                    add(p, q) = n and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                                    [by hypothesis with-q]
                                  @lengths-add |
                                    add(p, q) = n
                                    [using tautology split-facts]
                                  @v-entries-drawn |
                                    forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))
                                    [using tautology split-facts]
                                  @v-injective |
                                    listsWithoutRepetition(v, p)
                                    [using tautology split-facts]
                                  @v-collects |
                                    forall i: Nat; less_than(i, n) -> generates(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                    [using tautology split-facts]
                                  @v2-entries-drawn |
                                    forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))
                                    [using tautology split-facts]
                                  @v2-injective |
                                    listsWithoutRepetition(v2, q)
                                    [using tautology split-facts]
                                  @v2-collects |
                                    forall i: Nat; less_than(i, n) -> (not generates(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)
                                    [using tautology split-facts]
                                  // every entry of v generates.
                                  @generalize-j-v |
                                    fix j: Nat {
                                      @given-j-below-p |
                                        assume less_than(j, p) {
                                          @j-below-p |
                                            less_than(j, p)
                                            [by hypothesis given-j-below-p]
                                          @j-drawn |
                                            exists i: Nat; less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))
                                            [using specialize v-entries-drawn(j) j-below-p]
                                          @with-source-i |
                                            unpack i: Nat from j-drawn {
                                              @source-facts |
                                                less_than(i, n) and at(v, j) = at(w, i) and generates(at(w, i))
                                                [by hypothesis with-source-i]
                                              @v-j-is-w-i |
                                                at(v, j) = at(w, i)
                                                [using tautology source-facts]
                                              @w-i-generates |
                                                generates(at(w, i))
                                                [using tautology source-facts]
                                              @conclusion-v-j-generates-inner |
                                                generates(at(v, j))
                                                [by rewrite v-j-is-w-i w-i-generates]
                                            }
                                          @conclusion-v-j-generates |
                                            generates(at(v, j))
                                            [by exists_elim with-source-i]
                                        }
                                      @j-below-p-implies |
                                        less_than(j, p) -> generates(at(v, j))
                                        [by implies_intro given-j-below-p]
                                    }
                                  @v-entries-generate |
                                    forall j: Nat; less_than(j, p) -> generates(at(v, j))
                                    [by forall_intro generalize-j-v]
                                  // every generator is an entry of v.
                                  @generalize-g-v |
                                    fix g: Grp {
                                      @given-g-generates |
                                        assume generates(g) {
                                          @g-generates |
                                            generates(g)
                                            [by hypothesis given-g-generates]
                                          @g-covered |
                                            exists i: Nat; less_than(i, n) and at(w, i) = g
                                            [using specialize covers(g)]
                                          @with-cover-i |
                                            unpack i: Nat from g-covered {
                                              @cover-facts |
                                                less_than(i, n) and at(w, i) = g
                                                [by hypothesis with-cover-i]
                                              @i-below-n |
                                                less_than(i, n)
                                                [by and_elim_left cover-facts]
                                              @w-i-is-g |
                                                at(w, i) = g
                                                [by and_elim_right cover-facts]
                                              @w-i-generates |
                                                generates(at(w, i))
                                                [by rewrite w-i-is-g g-generates]
                                              @collected |
                                                exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                                [using specialize v-collects(i) i-below-n w-i-generates]
                                              @conclusion-g-in-v-inner |
                                                exists j: Nat; less_than(j, p) and at(v, j) = g
                                                [by rewrite w-i-is-g collected]
                                            }
                                          @conclusion-g-in-v |
                                            exists j: Nat; less_than(j, p) and at(v, j) = g
                                            [by exists_elim with-cover-i]
                                        }
                                      @g-generates-implies |
                                        generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g
                                        [by implies_intro given-g-generates]
                                    }
                                  @v-covers-generators |
                                    forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g
                                    [by forall_intro generalize-g-v]
                                  // no entry of v2 generates.
                                  @generalize-j-v2 |
                                    fix j: Nat {
                                      @given-j-below-q |
                                        assume less_than(j, q) {
                                          @j-below-q |
                                            less_than(j, q)
                                            [by hypothesis given-j-below-q]
                                          @j-drawn |
                                            exists i: Nat; less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))
                                            [using specialize v2-entries-drawn(j) j-below-q]
                                          @with-source-i |
                                            unpack i: Nat from j-drawn {
                                              @source-facts |
                                                less_than(i, n) and at(v2, j) = at(w, i) and (not generates(at(w, i)))
                                                [by hypothesis with-source-i]
                                              @v2-j-is-w-i |
                                                at(v2, j) = at(w, i)
                                                [using tautology source-facts]
                                              @w-i-does-not-generate |
                                                not generates(at(w, i))
                                                [using tautology source-facts]
                                              @conclusion-v2-j-inner |
                                                not generates(at(v2, j))
                                                [by rewrite v2-j-is-w-i w-i-does-not-generate]
                                            }
                                          @conclusion-v2-j |
                                            not generates(at(v2, j))
                                            [by exists_elim with-source-i]
                                        }
                                      @j-below-q-implies |
                                        less_than(j, q) -> (not generates(at(v2, j)))
                                        [by implies_intro given-j-below-q]
                                    }
                                  @v2-entries-do-not-generate |
                                    forall j: Nat; less_than(j, q) -> (not generates(at(v2, j)))
                                    [by forall_intro generalize-j-v2]
                                  // every non-generator is an entry of v2.
                                  @generalize-g-v2 |
                                    fix g: Grp {
                                      @given-g-does-not-generate |
                                        assume not generates(g) {
                                          @g-does-not-generate |
                                            not generates(g)
                                            [by hypothesis given-g-does-not-generate]
                                          @g-covered |
                                            exists i: Nat; less_than(i, n) and at(w, i) = g
                                            [using specialize covers(g)]
                                          @with-cover-i |
                                            unpack i: Nat from g-covered {
                                              @cover-facts |
                                                less_than(i, n) and at(w, i) = g
                                                [by hypothesis with-cover-i]
                                              @i-below-n |
                                                less_than(i, n)
                                                [by and_elim_left cover-facts]
                                              @w-i-is-g |
                                                at(w, i) = g
                                                [by and_elim_right cover-facts]
                                              @w-i-does-not-generate |
                                                not generates(at(w, i))
                                                [by rewrite w-i-is-g g-does-not-generate]
                                              @collected |
                                                exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)
                                                [using specialize v2-collects(i) i-below-n w-i-does-not-generate]
                                              @conclusion-g-in-v2-inner |
                                                exists j: Nat; less_than(j, q) and at(v2, j) = g
                                                [by rewrite w-i-is-g collected]
                                            }
                                          @conclusion-g-in-v2 |
                                            exists j: Nat; less_than(j, q) and at(v2, j) = g
                                            [by exists_elim with-cover-i]
                                        }
                                      @g-does-not-generate-implies |
                                        (not generates(g)) -> exists j: Nat; less_than(j, q) and at(v2, j) = g
                                        [by implies_intro given-g-does-not-generate]
                                    }
                                  @v2-covers-non-generators |
                                    forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q) and at(v2, j) = g
                                    [by forall_intro generalize-g-v2]
                                  @packaged |
                                    add(p, q) = n and (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and (forall j: Nat; less_than(j, q) -> (not generates(at(v2, j)))) and listsWithoutRepetition(v2, q) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q) and at(v2, j) = g)
                                    [using tautology lengths-add v-entries-generate v-injective v-covers-generators v2-entries-do-not-generate v2-injective v2-covers-non-generators]
                                  @conclusion-with-q-inner |
                                    exists q2: Nat; add(p, q2) = n and (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v2, j)))) and listsWithoutRepetition(v2, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v2, j) = g)
                                    [by exists_intro(q) packaged]
                                }
                              @conclusion-with-q |
                                exists q2: Nat; add(p, q2) = n and (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v2, j)))) and listsWithoutRepetition(v2, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v2, j) = g)
                                [by exists_elim with-q]
                              @conclusion-with-v2-inner |
                                exists v3: Seq; exists q2: Nat; add(p, q2) = n and (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v3, j)))) and listsWithoutRepetition(v3, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v3, j) = g)
                                [by exists_intro(v2) conclusion-with-q]
                            }
                          @conclusion-with-v2 |
                            exists v3: Seq; exists q2: Nat; add(p, q2) = n and (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v3, j)))) and listsWithoutRepetition(v3, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v3, j) = g)
                            [by exists_elim with-v2]
                          @conclusion-with-p-inner |
                            exists p2: Nat; exists v3: Seq; exists q2: Nat; add(p2, q2) = n and (forall j: Nat; less_than(j, p2) -> generates(at(v, j))) and listsWithoutRepetition(v, p2) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p2) and at(v, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v3, j)))) and listsWithoutRepetition(v3, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v3, j) = g)
                            [by exists_intro(p) conclusion-with-v2]
                        }
                      @conclusion-with-p |
                        exists p2: Nat; exists v3: Seq; exists q2: Nat; add(p2, q2) = n and (forall j: Nat; less_than(j, p2) -> generates(at(v, j))) and listsWithoutRepetition(v, p2) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p2) and at(v, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v3, j)))) and listsWithoutRepetition(v3, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v3, j) = g)
                        [by exists_elim with-p]
                      @conclusion-with-v-inner |
                        exists v4: Seq; exists p2: Nat; exists v3: Seq; exists q2: Nat; add(p2, q2) = n and (forall j: Nat; less_than(j, p2) -> generates(at(v4, j))) and listsWithoutRepetition(v4, p2) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p2) and at(v4, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v3, j)))) and listsWithoutRepetition(v3, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v3, j) = g)
                        [by exists_intro(v) conclusion-with-p]
                    }
                  @conclusion-listed |
                    exists v4: Seq; exists p2: Nat; exists v3: Seq; exists q2: Nat; add(p2, q2) = n and (forall j: Nat; less_than(j, p2) -> generates(at(v4, j))) and listsWithoutRepetition(v4, p2) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p2) and at(v4, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v3, j)))) and listsWithoutRepetition(v3, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v3, j) = g)
                    [by exists_elim with-v]
                }
              @covers-implies |
                (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> exists v4: Seq; exists p2: Nat; exists v3: Seq; exists q2: Nat; add(p2, q2) = n and (forall j: Nat; less_than(j, p2) -> generates(at(v4, j))) and listsWithoutRepetition(v4, p2) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p2) and at(v4, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v3, j)))) and listsWithoutRepetition(v3, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v3, j) = g)
                [by implies_intro given-covers]
            }
          @injective-implies |
            listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> exists v4: Seq; exists p2: Nat; exists v3: Seq; exists q2: Nat; add(p2, q2) = n and (forall j: Nat; less_than(j, p2) -> generates(at(v4, j))) and listsWithoutRepetition(v4, p2) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p2) and at(v4, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v3, j)))) and listsWithoutRepetition(v3, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v3, j) = g)
            [by implies_intro given-injective]
        }
      @discharge-w |
        forall w: Seq; listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> exists v4: Seq; exists p2: Nat; exists v3: Seq; exists q2: Nat; add(p2, q2) = n and (forall j: Nat; less_than(j, p2) -> generates(at(v4, j))) and listsWithoutRepetition(v4, p2) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p2) and at(v4, j) = g) and (forall j: Nat; less_than(j, q2) -> (not generates(at(v3, j)))) and listsWithoutRepetition(v3, q2) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q2) and at(v3, j) = g)
        [by forall_intro generalize-w]
    }
  @conclusion |
    forall n: Nat; forall w: Seq; listsWithoutRepetition(w, n) -> (forall g: Grp; exists i: Nat; less_than(i, n) and at(w, i) = g) -> exists v: Seq; exists p: Nat; exists v2: Seq; exists q: Nat; add(p, q) = n and (forall j: Nat; less_than(j, p) -> generates(at(v, j))) and listsWithoutRepetition(v, p) and (forall g: Grp; generates(g) -> exists j: Nat; less_than(j, p) and at(v, j) = g) and (forall j: Nat; less_than(j, q) -> (not generates(at(v2, j)))) and listsWithoutRepetition(v2, q) and (forall g: Grp; (not generates(g)) -> exists j: Nat; less_than(j, q) and at(v2, j) = g)
    [by forall_intro generalize-n]
qed
