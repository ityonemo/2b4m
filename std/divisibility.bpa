// std/divisibility.bpa — the abstract theory of DIVISIBILITY over a sort with
// a multiplication (and an addition, for the sum law). `divides(d, n)` means
// "d divides n", i.e. n is a multiple of d: ∃k; n = d·k.
//
// This is a reusable abstract theory: any concrete structure with a `mul`
// (associative, with a right identity ONE) and an `add` (left-distributing over
// mul) is a model of it, and inherits the basic divisibility facts — reflexivity,
// closure under multiplication, and closure under addition of common divisors —
// via `model`, instead of re-proving them. Both ℕ (std/peano/divides.bpa) and ℤ
// (std/integer/divides.bpa) model this.
//
// The multiplicative facts the proofs rely on (`mulOneRight`, `mulIsAssociative`,
// `mulAddDistribLeft`) are stated here as axioms — the OBLIGATIONS a model
// discharges by mapping them to its own sort's proven versions.

sort Dividable
const ONE: Dividable
func mul(a: Dividable, b: Dividable): Dividable
func add(a: Dividable, b: Dividable): Dividable

// Transparent: divides(d, n) IS the existential "n is a multiple of d", produced
// with exists_intro of the equation n = mul(d, k) and consumed with unpack.
define divides(d, n) = exists k: Dividable; n = mul(d, k)

// the multiplicative structure the divisibility proofs rely on (obligations).
axiom mulOneRight: forall n: Dividable; mul(n, ONE) = n
axiom mulIsAssociative: forall a, b, c: Dividable; mul(mul(a, b), c) = mul(a, mul(b, c))
axiom mulAddDistribLeft: forall a, b, c: Dividable; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))

// -- basic divisibility facts -----------------------------------------------

// d | d, witnessed by 1: d = d·1.
theorem dividesRefl: forall d: Dividable; divides(d, d)
proof
  @generalize-d |
    fix d: Dividable {
      @d-is-d-times-one |
        mul(d, ONE) = d
        [using specialize mulOneRight(d)]
      @d-eq |
        d = mul(d, ONE)
        [by symmetry d-is-d-times-one]
      @conclusion-divides |
        divides(d, d)
        [by exists_intro(ONE) d-eq]
    }
  @conclusion |
    forall d: Dividable; divides(d, d)
    [by forall_intro generalize-d]
qed

// d | a  =>  d | a·c: if a = d·k, then a·c = (d·k)·c = d·(k·c), so d divides a·c.
// Unpack the quotient k from d | a, reassociate the triple product with
// mulIsAssociative, then repackage via exists_intro with witness k·c.
theorem dividesMul: forall d, a, c: Dividable; divides(d, a) -> divides(d, mul(a, c))
proof
  @generalize-d |
    fix d: Dividable {
      @generalize-a |
        fix a: Dividable {
          @generalize-c |
            fix c: Dividable {
              @given-d-divides-a |
                assume divides(d, a) {
                  @a-is-d-multiple |
                    divides(d, a)
                    [by hypothesis given-d-divides-a]
                  @with-quotient-k |
                    unpack k: Dividable from a-is-d-multiple {
                      @a-equals-d-times-k |
                        a = mul(d, k)
                        [by hypothesis with-quotient-k]
                      @product-reassociates |
                        mul(mul(d, k), c) = mul(d, mul(k, c))
                        [using specialize mulIsAssociative(d, k, c)]
                      // a·c = (d·k)·c = d·(k·c)
                      @product-is-d-multiple |
                        mul(a, c) = mul(d, mul(k, c))
                        [using chain a-equals-d-times-k product-reassociates]
                      @d-divides-product-under-witness |
                        divides(d, mul(a, c))
                        [by exists_intro(mul(k, c)) product-is-d-multiple]
                    }
                  @d-divides-product |
                    divides(d, mul(a, c))
                    [by exists_elim with-quotient-k]
                }
              @d-divides-a-implies-d-divides-product |
                divides(d, a) -> divides(d, mul(a, c))
                [by implies_intro given-d-divides-a]
            }
          @discharge-c |
            forall c: Dividable; divides(d, a) -> divides(d, mul(a, c))
            [by forall_intro generalize-c]
        }
      @discharge-a |
        forall a, c: Dividable; divides(d, a) -> divides(d, mul(a, c))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall d, a, c: Dividable; divides(d, a) -> divides(d, mul(a, c))
    [by forall_intro generalize-d]
qed

// d | a  and  d | b  =>  d | a+b: if a = d·j and b = d·k, then a+b = d·(j+k) by
// left-distributivity, so d divides a+b. Unpack both quotients, collect the sum
// with mulAddDistribLeft, then repackage via exists_intro with witness j+k.
theorem dividesAdd: forall d, a, b: Dividable; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
proof
  @generalize-d |
    fix d: Dividable {
      @generalize-a |
        fix a: Dividable {
          @generalize-b |
            fix b: Dividable {
              @given-d-divides-a |
                assume divides(d, a) {
                  @given-d-divides-b |
                    assume divides(d, b) {
                      @a-is-d-multiple |
                        divides(d, a)
                        [by hypothesis given-d-divides-a]
                      @b-is-d-multiple |
                        divides(d, b)
                        [by hypothesis given-d-divides-b]
                      @with-quotient-j |
                        unpack j: Dividable from a-is-d-multiple {
                          @a-equals-d-times-j |
                            a = mul(d, j)
                            [by hypothesis with-quotient-j]
                          @with-quotient-k |
                            unpack k: Dividable from b-is-d-multiple {
                              @b-equals-d-times-k |
                                b = mul(d, k)
                                [by hypothesis with-quotient-k]
                              // add(a, b) = add(mul(d,j), mul(d,k)) = mul(d, add(j,k)),
                              // stitching the two witness facts (a = d·j, b = d·k) and
                              // left-distributivity, each used in whichever direction.
                              @sum-of-multiples-distributes |
                                mul(d, add(j, k)) = add(mul(d, j), mul(d, k))
                                [using specialize mulAddDistribLeft(d, j, k)]
                              @sum-is-d-multiple |
                                add(a, b) = mul(d, add(j, k))
                                [using chain a-equals-d-times-j b-equals-d-times-k sum-of-multiples-distributes]
                              @d-divides-sum-under-witness |
                                divides(d, add(a, b))
                                [by exists_intro(add(j, k)) sum-is-d-multiple]
                            }
                          @d-divides-sum-after-k |
                            divides(d, add(a, b))
                            [by exists_elim with-quotient-k]
                        }
                      @d-divides-sum |
                        divides(d, add(a, b))
                        [by exists_elim with-quotient-j]
                    }
                  @d-divides-b-implies-d-divides-sum |
                    divides(d, b) -> divides(d, add(a, b))
                    [by implies_intro given-d-divides-b]
                }
              @common-divisor-divides-sum |
                divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
                [by implies_intro given-d-divides-a]
            }
          @discharge-b |
            forall b: Dividable; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Dividable; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall d, a, b: Dividable; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
    [by forall_intro generalize-d]
qed

// a | b and b | c give a | c: unpack b = a·j and c = b·k, so c = (a·j)·k = a·(j·k)
// (mulIsAssociative), and exists_intro on the quotient j·k reads a | c off that.
theorem dividesTransitive: forall a, b, c: Dividable; divides(a, b) -> divides(b, c) -> divides(a, c)
proof
  @generalize-a |
    fix a: Dividable {
      @generalize-b |
        fix b: Dividable {
          @generalize-c |
            fix c: Dividable {
              @given-a-divides-b |
                assume divides(a, b) {
                  @given-b-divides-c |
                    assume divides(b, c) {
                      @a-divides-b |
                        divides(a, b)
                        [by hypothesis given-a-divides-b]
                      @b-divides-c |
                        divides(b, c)
                        [by hypothesis given-b-divides-c]
                      @with-a-quotient |
                        unpack j: Dividable from a-divides-b {
                          @b-is-a-times-j |
                            b = mul(a, j)
                            [by hypothesis with-a-quotient]
                          @with-b-quotient |
                            unpack k: Dividable from b-divides-c {
                              @c-is-b-times-k |
                                c = mul(b, k)
                                [by hypothesis with-b-quotient]
                              @a-j-times-k-regroups |
                                mul(mul(a, j), k) = mul(a, mul(j, k))
                                [using specialize mulIsAssociative(a, j, k)]
                              // c = b·k = (a·j)·k = a·(j·k)
                              @c-is-a-times-jk |
                                c = mul(a, mul(j, k))
                                [using chain c-is-b-times-k b-is-a-times-j a-j-times-k-regroups]
                              @a-divides-c |
                                divides(a, c)
                                [by exists_intro(mul(j, k)) c-is-a-times-jk]
                            }
                          @a-divides-c |
                            divides(a, c)
                            [by exists_elim with-b-quotient]
                        }
                      @a-divides-c |
                        divides(a, c)
                        [by exists_elim with-a-quotient]
                    }
                  @b-divides-c-implies-a-divides-c |
                    divides(b, c) -> divides(a, c)
                    [by implies_intro given-b-divides-c]
                }
              @a-divides-b-implies-transitive |
                divides(a, b) -> divides(b, c) -> divides(a, c)
                [by implies_intro given-a-divides-b]
            }
          @discharge-c |
            forall c: Dividable; divides(a, b) -> divides(b, c) -> divides(a, c)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Dividable; divides(a, b) -> divides(b, c) -> divides(a, c)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Dividable; divides(a, b) -> divides(b, c) -> divides(a, c)
    [by forall_intro generalize-a]
qed
