// std/primes.b4m — the reusable ℤ PRIME THEORY. An independent std development
// of primality and its headline consequences (Euclid's Lemma, the infinitude of
// primes), built for reuse by later chapters (modular arithmetic, ℤ/pℤ). The
// pedagogical inline development lives in aata/2.3-primes.md; this file re-proves
// the same facts in std style — accelerants free, shortest kernel-checked proof —
// and packages primality once as a transparent `define is_prime` so downstream
// consumers say `is_prime(p)` rather than re-spelling the defining conjunction.
//
// The engine is `coprimeBezout` (std/integer/divides.b4m); the finite-product /
// sequence machinery is std/integer/product.b4m. We reuse that file's
// `Seq`/`at`/`productUpTo`/`inSeqBefore` and its `does_divide`/`less_than`/
// `at_most` defines so everything composes.

import integer <<< "std/integer.b4m"
import order <<< "std/integer/order.b4m"
import int_divides <<< "std/integer/divides.b4m"
import sequence <<< "std/integer/product.b4m"
import wellordering <<< "std/integer/wellordering.b4m"

// -- base vocabulary (mirrors std/integer/product.b4m so Seq/at/productUpTo and
//    the divisibility/order defines line up) ----------------------------------
sort Int = integer.Int
const ZERO = integer.ZERO
const ONE = integer.ONE
func succ = integer.succ
func add = integer.add
func mul = integer.mul
func sub = integer.sub
func neg = integer.neg

pred is_nonneg = order.nonneg
sort NonNegZ = integer.NonNeg
pred less_than = order.less_than
define at_most(a, b) = order.less_or_equal(a, b)
define does_divide(d, n) = int_divides.divides(d, n)

// -- sequences and finite products (reused from std/integer/product.b4m) ------
sort Seq = sequence.Seq
func at = sequence.at
func productUpTo = sequence.productUpTo
pred inSeqBefore = sequence.inSeqBefore
axiom productUpToZero = sequence.productUpToZero
axiom productUpToSucc = sequence.productUpToSucc

// -- order / arithmetic vocabulary --------------------------------------------
theorem trichotomy = sequence.trichotomy
theorem lessThanIrreflexive = sequence.lessThanIrreflexive
theorem lessThanTransitive = sequence.lessThanTransitive
theorem lessOrEqualSplit = sequence.lessOrEqualSplit
theorem lessThanSuccRight = order.lessThanSuccRight
theorem lessThanSelf = wellordering.lessThanSelf
theorem atMostThenLessThan = int_divides.atMostThenLessThan
theorem nonnegNotLessThanZero = sequence.nonnegNotLessThanZero
theorem negLessThanZero = sequence.negLessThanZero
theorem zeroLessThanOne = sequence.zeroLessThanOne
theorem oneAtMostPositive = sequence.oneAtMostPositive
theorem divisorAtMost = sequence.divisorAtMost
axiom addZeroLeft = sequence.addZeroLeft
axiom nonnegZero = sequence.nonnegZero
axiom nonnegSucc = sequence.nonnegSucc
axiom nonnegInduction = sequence.nonnegInduction
axiom oneIsSuccZero = sequence.oneIsSuccZero
axiom definitionOfSubtraction = sequence.definitionOfSubtraction

// -- ring algebra the arguments name explicitly -------------------------------
theorem addIsCommutative = int_divides.addIsCommutative
theorem addIsAssociative = int_divides.addIsAssociative
theorem addZeroRight = int_divides.addZeroRight
theorem addSuccRight = order.addSuccRight
theorem addNegRight = sequence.addNegRight
theorem mulOneRight = sequence.mulOneRight
theorem mulZeroRight = sequence.mulZeroRight
theorem mulNegRight = sequence.mulNegRight
theorem mulNegLeft = order.mulNegLeft
theorem mulAddDistribLeft = sequence.mulAddDistribLeft
theorem mulAddDistribRight = int_divides.mulAddDistribRight
theorem mulIsAssociative = sequence.mulIsAssociative
theorem mulIsCommutative = sequence.mulIsCommutative
theorem negNeg = sequence.negNeg
axiom mulZeroLeft = integer.mulZeroLeft

// -- divisibility closure + the Division Algorithm ----------------------------
theorem dividesRefl = sequence.dividesRefl
theorem dividesMul = sequence.dividesMul
theorem dividesAdd = sequence.dividesAdd
theorem dividesIntro = int_divides.dividesIntro
theorem dividesSubtracts = sequence.dividesSubtracts
theorem dividesTransitive = sequence.dividesTransitive
theorem divisionAlgorithmExists = int_divides.divisionAlgorithmExists
theorem divisionAlgorithmUnique = int_divides.divisionAlgorithmUnique

// -- the coprime-Bézout engine and its supporting sign lemmas -----------------
theorem coprimeBezout = int_divides.coprimeBezout

// -- the FTA-facing sequence facts --------------------------------------------
theorem memberDividesProduct = sequence.memberDividesProduct
theorem sequencePrimeFactorExists = sequence.primeFactorExists

// One is a left identity for multiplication — ℤ names only `mulOneRight`, but
// the `polynomial` normalizer wants the left form in scope; derive it from
// commutativity.
// pure ring lemma — now in integer.b4m's ring layer; alias.
theorem mulOneLeft = integer.mulOneLeft

// Multiplicative left-swap `x·(y·r) = y·(x·r)` — another normal-form lemma the
// `polynomial` normalizer wants; derive it from associativity and commutativity.
// pure ring lemma — now in integer.b4m's ring layer; alias.
theorem mulLeftSwap = integer.mulLeftSwap

// Additive left-swap `x+(y+r) = y+(x+r)` — the additive analog, again for the
// `polynomial` normalizer.
// pure ring lemma — now in integer.b4m's ring layer; alias.
theorem addLeftSwap = integer.addLeftSwap

// ---------------------------------------------------------------------------
// PRIMALITY
// ---------------------------------------------------------------------------

// A prime is an integer exceeding one whose only positive divisors are one and
// itself. Transparent, so downstream proofs unfold it and see the conjunction.
define is_prime(p) = less_than(ONE, p) and (forall d: Int; less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p))

// `does_divide` IS the multiple existential, so its eliminator is the identity.
theorem dividesElim: forall d, m: Int; does_divide(d, m) -> exists k: Int; m = mul(d, k)
proof
  @generalize-d |
    fix d: Int {
      @generalize-m |
        fix m: Int {
          @given-d-divides-m |
            assume does_divide(d, m) {
              @the-multiple-existential |
                exists k: Int; m = mul(d, k)
                [by hypothesis given-d-divides-m]
            }
          @divides-gives-multiple |
            does_divide(d, m) -> exists k: Int; m = mul(d, k)
            [by implies_intro given-d-divides-m]
        }
      @discharge-m |
        forall m: Int; does_divide(d, m) -> exists k: Int; m = mul(d, k)
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall d, m: Int; does_divide(d, m) -> exists k: Int; m = mul(d, k)
    [by forall_intro generalize-d]
qed

// Divisibility ignores sign of the divisor: if e | n then (-e) | n, since
// n = e·k = (-e)·(-k).
theorem negDivides: forall e, n: Int; does_divide(e, n) -> does_divide(neg(e), n)
proof
  @generalize-e |
    fix e: Int {
      @generalize-n |
        fix n: Int {
          @given-e-divides-n |
            assume does_divide(e, n) {
              @e-divides-n |
                does_divide(e, n)
                [by hypothesis given-e-divides-n]
              @exact-quotient-exists |
                exists k: Int; n = mul(e, k)
                [using specialize dividesElim(e, n) e-divides-n]
              @with-quotient-k |
                unpack k: Int from exact-quotient-exists {
                  @n-is-e-times-k |
                    n = mul(e, k)
                    [by hypothesis with-quotient-k]
                  @e-times-k-is-neg-e-times-neg-k |
                    mul(e, k) = mul(neg(e), neg(k))
                    [using polynomial]
                  @n-is-neg-e-times-neg-k |
                    n = mul(neg(e), neg(k))
                    [by rewrite e-times-k-is-neg-e-times-neg-k n-is-e-times-k]
                  @conclusion-neg-e-divides-n |
                    does_divide(neg(e), n)
                    [using specialize dividesIntro(n, neg(e), neg(k)) n-is-neg-e-times-neg-k]
                }
              @neg-e-divides-n |
                does_divide(neg(e), n)
                [by exists_elim with-quotient-k]
            }
          @e-divides-implies-neg-e-divides |
            does_divide(e, n) -> does_divide(neg(e), n)
            [by implies_intro given-e-divides-n]
        }
      @discharge-n |
        forall n: Int; does_divide(e, n) -> does_divide(neg(e), n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall e, n: Int; does_divide(e, n) -> does_divide(neg(e), n)
    [by forall_intro generalize-e]
qed

// A negative integer negates to a positive one — reused from integer-divides under
// a name local to the coprimality argument.
theorem positiveOfNegative = int_divides.negativeNegIsPositive

// Divisibility by a positive integer is decidable. Run the Division Algorithm
// `a = pq + r`, `0 ≤ r < p`, and split `r` by trichotomy: `r < 0` is impossible,
// `r = 0` gives `p | a`, and `r > 0` forces `p ∤ a` (were `p | a`, uniqueness of
// the Division Algorithm would make `r = 0`).
theorem dividesDecidable: forall p, a: Int; less_than(ZERO, p) -> (does_divide(p, a) or (not does_divide(p, a)))
proof
  @generalize-p |
    fix p: Int {
      @generalize-a |
        fix a: Int {
          @given-p-positive |
            assume less_than(ZERO, p) {
              @p-positive |
                less_than(ZERO, p)
                [by hypothesis given-p-positive]
              @quotient-remainder-exist |
                exists q: Int; exists r: Int; a = add(mul(p, q), r) and is_nonneg(r) and less_than(r, p)
                [using specialize divisionAlgorithmExists(a, p) p-positive]
              @with-quotient-q |
                unpack q: Int from quotient-remainder-exist {
                  @remainder-exists |
                    exists r: Int; a = add(mul(p, q), r) and is_nonneg(r) and less_than(r, p)
                    [by hypothesis with-quotient-q]
                  @with-remainder-r |
                    unpack r: Int from remainder-exists {
                      @decomposition-and-bounds |
                        a = add(mul(p, q), r) and is_nonneg(r) and less_than(r, p)
                        [by hypothesis with-remainder-r]
                      @decomposition-and-remainder-nonneg |
                        a = add(mul(p, q), r) and is_nonneg(r)
                        [by and_elim_left decomposition-and-bounds]
                      @decomposition |
                        a = add(mul(p, q), r)
                        [by and_elim_left decomposition-and-remainder-nonneg]
                      @remainder-nonneg |
                        is_nonneg(r)
                        [by and_elim_right decomposition-and-remainder-nonneg]
                      @remainder-less_than-p |
                        less_than(r, p)
                        [by and_elim_right decomposition-and-bounds]
                      @remainder-against-zero |
                        less_than(r, ZERO) or r = ZERO or less_than(ZERO, r)
                        [using specialize trichotomy(r, ZERO)]
                      @divides-decidable |
                        does_divide(p, a) or (not does_divide(p, a))
                        case remainder-against-zero {
                          @when-remainder-negative |
                            assume less_than(r, ZERO) {
                              @remainder-negative |
                                less_than(r, ZERO)
                                [by hypothesis when-remainder-negative]
                              @remainder-not-negative |
                                not less_than(r, ZERO)
                                [using specialize nonnegNotLessThanZero(r) remainder-nonneg]
                              @conclusion-decidable-vacuous |
                                does_divide(p, a) or (not does_divide(p, a))
                                [by absurd remainder-negative remainder-not-negative]
                            }
                          @when-remainder-zero |
                            assume r = ZERO {
                              @remainder-zero |
                                r = ZERO
                                [by hypothesis when-remainder-zero]
                              @product-plus-zero |
                                add(mul(p, q), ZERO) = mul(p, q)
                                [using specialize addZeroRight(mul(p, q))]
                              @a-is-p-times-q |
                                a = mul(p, q)
                                [using chain decomposition remainder-zero product-plus-zero]
                              @p-divides-a |
                                does_divide(p, a)
                                [using specialize dividesIntro(a, p, q) a-is-p-times-q]
                              @conclusion-p-divides |
                                does_divide(p, a) or (not does_divide(p, a))
                                [by or_intro_left p-divides-a]
                            }
                          @when-remainder-positive |
                            assume less_than(ZERO, r) {
                              @remainder-positive |
                                less_than(ZERO, r)
                                [by hypothesis when-remainder-positive]
                              @given-p-divides-a |
                                assume does_divide(p, a) {
                                  @p-divides-a |
                                    does_divide(p, a)
                                    [by hypothesis given-p-divides-a]
                                  @exact-quotient-exists |
                                    exists k: Int; a = mul(p, k)
                                    [using specialize dividesElim(p, a) p-divides-a]
                                  @with-exact-quotient-m |
                                    unpack m: Int from exact-quotient-exists {
                                      @a-is-p-times-m |
                                        a = mul(p, m)
                                        [by hypothesis with-exact-quotient-m]
                                      @product-m-plus-zero |
                                        add(mul(p, m), ZERO) = mul(p, m)
                                        [using specialize addZeroRight(mul(p, m))]
                                      @a-is-p-times-m-plus-zero |
                                        a = add(mul(p, m), ZERO)
                                        [using chain a-is-p-times-m product-m-plus-zero]
                                      @zero-is-nonneg |
                                        is_nonneg(ZERO)
                                        [by cite nonnegZero]
                                      @quotient-and-remainder-agree |
                                        q = m and r = ZERO
                                        [using specialize divisionAlgorithmUnique(a, p, q, r, m, ZERO) p-positive decomposition remainder-nonneg remainder-less_than-p a-is-p-times-m-plus-zero zero-is-nonneg p-positive]
                                      @remainder-is-zero |
                                        r = ZERO
                                        [by and_elim_right quotient-and-remainder-agree]
                                      @zero-less_than-zero |
                                        less_than(ZERO, ZERO)
                                        [by rewrite remainder-is-zero remainder-positive]
                                      @zero-not-less_than-zero |
                                        not less_than(ZERO, ZERO)
                                        [using specialize lessThanIrreflexive(ZERO)]
                                      @conclusion-not-divides |
                                        not does_divide(p, a)
                                        [by absurd zero-less_than-zero zero-not-less_than-zero]
                                    }
                                  @p-does-not-divide-a-inner |
                                    not does_divide(p, a)
                                    [by exists_elim with-exact-quotient-m]
                                }
                              @p-does-not-divide-a |
                                not does_divide(p, a)
                                [by not_intro given-p-divides-a p-divides-a p-does-not-divide-a-inner]
                              @conclusion-not-divides |
                                does_divide(p, a) or (not does_divide(p, a))
                                [by or_intro_right p-does-not-divide-a]
                            }
                        }
                    }
                  @divides-decidable |
                    does_divide(p, a) or (not does_divide(p, a))
                    [by exists_elim with-remainder-r]
                }
              @divides-decidable |
                does_divide(p, a) or (not does_divide(p, a))
                [by exists_elim with-quotient-q]
            }
          @positive-p-gives-decidable |
            less_than(ZERO, p) -> (does_divide(p, a) or (not does_divide(p, a)))
            [by implies_intro given-p-positive]
        }
      @discharge-a |
        forall a: Int; less_than(ZERO, p) -> (does_divide(p, a) or (not does_divide(p, a)))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall p, a: Int; less_than(ZERO, p) -> (does_divide(p, a) or (not does_divide(p, a)))
    [by forall_intro generalize-p]
qed

// The bridge from primality to Bézout's coprimality hypothesis: if a prime `p`
// does not divide `a`, then every common divisor `e` of `a` and `p` is `±1`.
// Trichotomy splits `e`: for `e > 0` primality gives `e = 1` or `e = p` (and
// `e = p` would make `p | a`); for `e < 0` the same on `-e > 0`; `e = 0` forces
// `p = 0`, against `p > 0`.
theorem coprimalityFromPrime: forall p, a: Int;
  is_prime(p)
  -> (not does_divide(p, a))
  -> (forall e: Int; does_divide(e, a) -> does_divide(e, p) -> (e = ONE or e = neg(ONE)))
proof
  @generalize-p |
    fix p: Int {
      @generalize-a |
        fix a: Int {
          @given-p-prime |
            assume is_prime(p) {
              @given-p-not-divide-a |
                assume not does_divide(p, a) {
                  @p-prime |
                    is_prime(p)
                    [by hypothesis given-p-prime]
                  @one-less_than-p |
                    less_than(ONE, p)
                    [by and_elim_left p-prime]
                  @only-positive-divisors-are-one-and-p |
                    forall d: Int; less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p)
                    [by and_elim_right p-prime]
                  @zero-less_than-p-if-chained |
                    less_than(ZERO, ONE) -> less_than(ONE, p) -> less_than(ZERO, p)
                    [using specialize lessThanTransitive(ZERO, ONE, p)]
                  @zero-less_than-one |
                    less_than(ZERO, ONE)
                    [by cite zeroLessThanOne]
                  @p-positive |
                    less_than(ZERO, p)
                    [using tautology zero-less_than-p-if-chained zero-less_than-one one-less_than-p]
                  @p-does-not-divide-a |
                    not does_divide(p, a)
                    [by hypothesis given-p-not-divide-a]
                  @common-divisors-are-units |
                    fix e: Int {
                      @given-e-divides-a |
                        assume does_divide(e, a) {
                          @given-e-divides-p |
                            assume does_divide(e, p) {
                              @e-divides-a |
                                does_divide(e, a)
                                [by hypothesis given-e-divides-a]
                              @e-divides-p |
                                does_divide(e, p)
                                [by hypothesis given-e-divides-p]
                              @e-against-zero |
                                less_than(e, ZERO) or e = ZERO or less_than(ZERO, e)
                                [using specialize trichotomy(e, ZERO)]
                              @e-is-unit |
                                e = ONE or e = neg(ONE)
                                case e-against-zero {
                                  @when-e-negative |
                                    assume less_than(e, ZERO) {
                                      @e-negative |
                                        less_than(e, ZERO)
                                        [by hypothesis when-e-negative]
                                      @neg-e-is-positive |
                                        less_than(ZERO, neg(e))
                                        [using specialize positiveOfNegative(e) e-negative]
                                      @neg-e-divides-p |
                                        does_divide(neg(e), p)
                                        [using specialize negDivides(e, p) e-divides-p]
                                      @neg-e-divides-a |
                                        does_divide(neg(e), a)
                                        [using specialize negDivides(e, a) e-divides-a]
                                      @primality-at-neg-e |
                                        less_than(ZERO, neg(e)) -> does_divide(neg(e), p) -> (neg(e) = ONE or neg(e) = p)
                                        [by forall_elim(neg(e)) only-positive-divisors-are-one-and-p]
                                      @neg-e-is-one-or-p |
                                        neg(e) = ONE or neg(e) = p
                                        [using tautology primality-at-neg-e neg-e-is-positive neg-e-divides-p]
                                      @e-is-unit |
                                        e = ONE or e = neg(ONE)
                                        case neg-e-is-one-or-p {
                                          @when-neg-e-is-one |
                                            assume neg(e) = ONE {
                                              @neg-e-is-one |
                                                neg(e) = ONE
                                                [by hypothesis when-neg-e-is-one]
                                              @e-is-neg-neg-e |
                                                neg(neg(e)) = e
                                                [using specialize negNeg(e)]
                                              @e-is-neg-one |
                                                e = neg(ONE)
                                                [using chain e-is-neg-neg-e neg-e-is-one]
                                              @conclusion-e-is-neg-one |
                                                e = ONE or e = neg(ONE)
                                                [by or_intro_right e-is-neg-one]
                                            }
                                          @when-neg-e-is-p |
                                            assume neg(e) = p {
                                              @neg-e-is-p |
                                                neg(e) = p
                                                [by hypothesis when-neg-e-is-p]
                                              @p-divides-a |
                                                does_divide(p, a)
                                                [by rewrite neg-e-is-p neg-e-divides-a]
                                              @conclusion-p-divides-absurd |
                                                e = ONE or e = neg(ONE)
                                                [by absurd p-divides-a p-does-not-divide-a]
                                            }
                                        }
                                    }
                                  @when-e-zero |
                                    assume e = ZERO {
                                      @e-is-zero |
                                        e = ZERO
                                        [by hypothesis when-e-zero]
                                      @zero-divides-p |
                                        does_divide(ZERO, p)
                                        [by rewrite e-is-zero e-divides-p]
                                      @zero-quotient-exists |
                                        exists k: Int; p = mul(ZERO, k)
                                        [using specialize dividesElim(ZERO, p) zero-divides-p]
                                      @with-zero-quotient-k |
                                        unpack k: Int from zero-quotient-exists {
                                          @p-is-zero-times-k |
                                            p = mul(ZERO, k)
                                            [by hypothesis with-zero-quotient-k]
                                          @zero-times-k-is-zero |
                                            mul(ZERO, k) = ZERO
                                            [using specialize mulZeroLeft(k)]
                                          @p-is-zero |
                                            p = ZERO
                                            [by rewrite zero-times-k-is-zero p-is-zero-times-k]
                                          @zero-is-positive |
                                            less_than(ZERO, ZERO)
                                            [by rewrite p-is-zero p-positive]
                                          @zero-not-less_than-zero |
                                            not less_than(ZERO, ZERO)
                                            [using specialize lessThanIrreflexive(ZERO)]
                                          @conclusion-zero-divisor-absurd |
                                            e = ONE or e = neg(ONE)
                                            [by absurd zero-is-positive zero-not-less_than-zero]
                                        }
                                      @conclusion-zero-divisor |
                                        e = ONE or e = neg(ONE)
                                        [by exists_elim with-zero-quotient-k]
                                    }
                                  @when-e-positive |
                                    assume less_than(ZERO, e) {
                                      @e-positive |
                                        less_than(ZERO, e)
                                        [by hypothesis when-e-positive]
                                      @primality-at-e |
                                        less_than(ZERO, e) -> does_divide(e, p) -> (e = ONE or e = p)
                                        [by forall_elim(e) only-positive-divisors-are-one-and-p]
                                      @e-is-one-or-p |
                                        e = ONE or e = p
                                        [using tautology primality-at-e e-positive e-divides-p]
                                      @e-is-unit |
                                        e = ONE or e = neg(ONE)
                                        case e-is-one-or-p {
                                          @when-e-is-one |
                                            assume e = ONE {
                                              @e-is-one |
                                                e = ONE
                                                [by hypothesis when-e-is-one]
                                              @conclusion-e-is-one |
                                                e = ONE or e = neg(ONE)
                                                [by or_intro_left e-is-one]
                                            }
                                          @when-e-is-p |
                                            assume e = p {
                                              @e-is-p |
                                                e = p
                                                [by hypothesis when-e-is-p]
                                              @p-divides-a |
                                                does_divide(p, a)
                                                [by rewrite e-is-p e-divides-a]
                                              @conclusion-e-is-p-absurd |
                                                e = ONE or e = neg(ONE)
                                                [by absurd p-divides-a p-does-not-divide-a]
                                            }
                                        }
                                    }
                                }
                            }
                          @e-divides-p-gives-unit |
                            does_divide(e, p) -> (e = ONE or e = neg(ONE))
                            [by implies_intro given-e-divides-p]
                        }
                      @e-divides-a-gives-unit |
                        does_divide(e, a) -> does_divide(e, p) -> (e = ONE or e = neg(ONE))
                        [by implies_intro given-e-divides-a]
                    }
                  @common-divisors-are-units-for-all |
                    forall e: Int; does_divide(e, a) -> does_divide(e, p) -> (e = ONE or e = neg(ONE))
                    [by forall_intro common-divisors-are-units]
                }
              @not-divide-gives-coprime |
                (not does_divide(p, a))
                  -> (forall e: Int; does_divide(e, a) -> does_divide(e, p) -> (e = ONE or e = neg(ONE)))
                [by implies_intro given-p-not-divide-a]
            }
          @prime-gives-coprime |
            is_prime(p)
              -> (not does_divide(p, a))
              -> (forall e: Int; does_divide(e, a) -> does_divide(e, p) -> (e = ONE or e = neg(ONE)))
            [by implies_intro given-p-prime]
        }
      @discharge-a |
        forall a: Int; is_prime(p)
          -> (not does_divide(p, a))
          -> (forall e: Int; does_divide(e, a) -> does_divide(e, p) -> (e = ONE or e = neg(ONE)))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall p, a: Int; is_prime(p)
      -> (not does_divide(p, a))
      -> (forall e: Int; does_divide(e, a) -> does_divide(e, p) -> (e = ONE or e = neg(ONE)))
    [by forall_intro generalize-p]
qed

// Euclid's Lemma: a prime dividing a product divides one of the factors. If
// `p | a` we are done; else `p ∤ a`, so `a` and `p` are coprime and `coprimeBezout`
// gives `r, s` with `a·r + p·s = 1`. Then `b = (a·b)·r + p·(b·s)` (the one elided
// ring identity, by `polynomial`), and `p` divides both summands, hence `b`.
theorem euclidsLemma: forall a, b, p: Int;
  is_prime(p)
  -> does_divide(p, mul(a, b))
  -> (does_divide(p, a) or does_divide(p, b))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @generalize-p |
            fix p: Int {
              @given-p-prime |
                assume is_prime(p) {
                  @given-p-divides-product |
                    assume does_divide(p, mul(a, b)) {
                      @p-prime |
                        is_prime(p)
                        [by hypothesis given-p-prime]
                      @one-less_than-p |
                        less_than(ONE, p)
                        [by and_elim_left p-prime]
                      @p-divides-product |
                        does_divide(p, mul(a, b))
                        [by hypothesis given-p-divides-product]
                      // p > 0, from 0 < 1 < p.
                      @zero-less_than-p-if-chained |
                        less_than(ZERO, ONE) -> less_than(ONE, p) -> less_than(ZERO, p)
                        [using specialize lessThanTransitive(ZERO, ONE, p)]
                      @zero-less_than-one |
                        less_than(ZERO, ONE)
                        [by cite zeroLessThanOne]
                      @p-positive |
                        less_than(ZERO, p)
                        [using tautology zero-less_than-p-if-chained zero-less_than-one one-less_than-p]
                      // decide whether p | a.
                      @p-divides-a-or-not |
                        does_divide(p, a) or (not does_divide(p, a))
                        [using specialize dividesDecidable(p, a) p-positive]
                      @p-divides-a-or-b |
                        does_divide(p, a) or does_divide(p, b)
                        case p-divides-a-or-not {
                          @when-p-divides-a |
                            assume does_divide(p, a) {
                              @p-divides-a |
                                does_divide(p, a)
                                [by hypothesis when-p-divides-a]
                              @conclusion-p-divides-a |
                                does_divide(p, a) or does_divide(p, b)
                                [by or_intro_left p-divides-a]
                            }
                          @when-p-does-not-divide-a |
                            assume not does_divide(p, a) {
                              @p-does-not-divide-a |
                                not does_divide(p, a)
                                [by hypothesis when-p-does-not-divide-a]
                              // a != 0: else p | 0 = a, against the branch.
                              @given-a-zero |
                                assume a = ZERO {
                                  @a-is-zero |
                                    a = ZERO
                                    [by hypothesis given-a-zero]
                                  @zero-is-p-times-zero |
                                    ZERO = mul(p, ZERO)
                                    [using simplify mulZeroRight]
                                  @a-is-p-times-zero |
                                    a = mul(p, ZERO)
                                    [by rewrite zero-is-p-times-zero a-is-zero]
                                  @p-divides-a |
                                    does_divide(p, a)
                                    [using specialize dividesIntro(a, p, ZERO) a-is-p-times-zero]
                                  @a-not-zero-inner |
                                    a != ZERO
                                    [by absurd p-divides-a p-does-not-divide-a]
                                }
                              @a-not-zero |
                                a != ZERO
                                [by not_intro given-a-zero a-is-zero a-not-zero-inner]
                              // p != 0, from p > 0.
                              @given-p-zero |
                                assume p = ZERO {
                                  @p-is-zero |
                                    p = ZERO
                                    [by hypothesis given-p-zero]
                                  @zero-less_than-zero |
                                    less_than(ZERO, ZERO)
                                    [by rewrite p-is-zero p-positive]
                                  @zero-not-less_than-zero |
                                    not less_than(ZERO, ZERO)
                                    [using specialize lessThanIrreflexive(ZERO)]
                                  @p-not-zero-inner |
                                    p != ZERO
                                    [by absurd zero-less_than-zero zero-not-less_than-zero]
                                }
                              @p-not-zero |
                                p != ZERO
                                [by not_intro given-p-zero p-is-zero p-not-zero-inner]
                              // a and p are coprime.
                              @a-and-p-coprime |
                                forall e: Int; does_divide(e, a) -> does_divide(e, p) -> (e = ONE or e = neg(ONE))
                                [using specialize coprimalityFromPrime(p, a) p-prime p-does-not-divide-a]
                              // Bezout: a*r + p*s = 1.
                              @bezout-coefficients-exist |
                                exists r: Int; exists s: Int; add(mul(a, r), mul(p, s)) = ONE
                                [using specialize coprimeBezout(a, p) a-not-zero p-not-zero a-and-p-coprime]
                              @with-bezout-r |
                                unpack r: Int from bezout-coefficients-exist {
                                  @bezout-s-exists |
                                    exists s: Int; add(mul(a, r), mul(p, s)) = ONE
                                    [by hypothesis with-bezout-r]
                                  @with-bezout-s |
                                    unpack s: Int from bezout-s-exists {
                                      @bezout-holds |
                                        add(mul(a, r), mul(p, s)) = ONE
                                        [by hypothesis with-bezout-s]
                                      // b = b*1 = b*(a*r + p*s) = (a*b)*r + p*(b*s).
                                      @b-times-one-is-b |
                                        mul(b, ONE) = b
                                        [using specialize mulOneRight(b)]
                                      @product-distributes |
                                        mul(b, add(mul(a, r), mul(p, s))) = add(mul(mul(a, b), r), mul(p, mul(b, s)))
                                        [using polynomial]
                                      @b-splits-into-product-and-p-multiple |
                                        b = add(mul(mul(a, b), r), mul(p, mul(b, s)))
                                        [using chain b-times-one-is-b bezout-holds product-distributes]
                                      // p | (a*b)*r, since p | a*b.
                                      @p-divides-product-times-r-if |
                                        does_divide(p, mul(a, b)) -> does_divide(p, mul(mul(a, b), r))
                                        [using specialize dividesMul(p, mul(a, b), r)]
                                      @p-divides-product-times-r |
                                        does_divide(p, mul(mul(a, b), r))
                                        [by modus_ponens p-divides-product-times-r-if p-divides-product]
                                      // p | p*(b*s), since p | p.
                                      @p-divides-p |
                                        does_divide(p, p)
                                        [using specialize dividesRefl(p)]
                                      @p-divides-p-times-bs |
                                        does_divide(p, mul(p, mul(b, s)))
                                        [using specialize dividesMul(p, p, mul(b, s)) p-divides-p]
                                      // p | their sum, which is b.
                                      @p-divides-sum |
                                        does_divide(p, add(mul(mul(a, b), r), mul(p, mul(b, s))))
                                        [using specialize dividesAdd(p, mul(mul(a, b), r), mul(p, mul(b, s))) p-divides-product-times-r p-divides-p-times-bs]
                                      @p-divides-b |
                                        does_divide(p, b)
                                        [by rewrite b-splits-into-product-and-p-multiple p-divides-sum]
                                      @conclusion-p-divides-b |
                                        does_divide(p, a) or does_divide(p, b)
                                        [by or_intro_right p-divides-b]
                                    }
                                  @p-divides-a-or-b |
                                    does_divide(p, a) or does_divide(p, b)
                                    [by exists_elim with-bezout-s]
                                }
                              @p-divides-a-or-b |
                                does_divide(p, a) or does_divide(p, b)
                                [by exists_elim with-bezout-r]
                            }
                        }
                    }
                  @product-implies-divides-factor |
                    does_divide(p, mul(a, b)) -> (does_divide(p, a) or does_divide(p, b))
                    [by implies_intro given-p-divides-product]
                }
              @prime-implies-divides-factor |
                is_prime(p)
                  -> does_divide(p, mul(a, b)) -> (does_divide(p, a) or does_divide(p, b))
                [by implies_intro given-p-prime]
            }
          @discharge-p |
            forall p: Int; is_prime(p) -> does_divide(p, mul(a, b)) -> (does_divide(p, a) or does_divide(p, b))
            [by forall_intro generalize-p]
        }
      @discharge-b |
        forall b, p: Int; is_prime(p) -> does_divide(p, mul(a, b)) -> (does_divide(p, a) or does_divide(p, b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, p: Int; is_prime(p) -> does_divide(p, mul(a, b)) -> (does_divide(p, a) or does_divide(p, b))
    [by forall_intro generalize-a]
qed

// A prime dividing a length-k product divides one of the first k entries — the
// FTA-uniqueness crux, by induction on k (nonnegInduction). Base (k=0): the empty
// product is ONE, and no prime divides ONE (divisorAtMost would force p ≤ 1),
// so the goal holds vacuously. Step: `productUpTo(s, succ(k)) = productUpTo(s, k)·at(s, k)`,
// Euclid's lemma splits the divisibility, and either the IH gives an earlier
// witness i < k < succ(k) or p divides the new last entry (witness i = k).
theorem primeDividesProductImpliesMember: forall k: Int; is_nonneg(k) ->
  forall s: Seq; forall p: Int;
  is_prime(p)
  -> does_divide(p, productUpTo(s, k))
  -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))
proof
  // base case: k = 0 — the empty product is ONE, which no prime divides.
  @base-case-proof |
    assume is_nonneg(ZERO) {
      @generalize-s-base |
        fix s: Seq {
          @generalize-p-base |
            fix p: Int {
              @given-prime-base |
                assume is_prime(p) {
                  @given-p-divides-empty-product |
                    assume does_divide(p, productUpTo(s, ZERO)) {
                      @prime-p-base |
                        is_prime(p)
                        [by hypothesis given-prime-base]
                      @one-is-less_than-p |
                        less_than(ONE, p)
                        [by and_elim_left prime-p-base]
                      @empty-product-is-one |
                        productUpTo(s, ZERO) = ONE
                        [using specialize productUpToZero(s)]
                      @p-divides-empty-product |
                        does_divide(p, productUpTo(s, ZERO))
                        [by hypothesis given-p-divides-empty-product]
                      @p-divides-one |
                        does_divide(p, ONE)
                        [by rewrite empty-product-is-one p-divides-empty-product]
                      @zero-less_than-one-less_than-p |
                        less_than(ZERO, ONE) -> less_than(ONE, p) -> less_than(ZERO, p)
                        [using specialize lessThanTransitive(ZERO, ONE, p)]
                      @zero-less_than-one |
                        less_than(ZERO, ONE)
                        [by cite zeroLessThanOne]
                      @zero-less_than-p |
                        less_than(ZERO, p)
                        [using tautology zero-less_than-one-less_than-p zero-less_than-one one-is-less_than-p]
                      @p-at-most-one |
                        at_most(p, ONE)
                        [using specialize divisorAtMost(p, ONE) zero-less_than-p zero-less_than-one p-divides-one]
                      @p-less_than-one-or-equals-one |
                        less_than(p, ONE) or p = ONE
                        [using specialize lessOrEqualSplit(p, ONE) p-at-most-one]
                      @one-not-less_than-one |
                        not less_than(ONE, ONE)
                        [using specialize lessThanIrreflexive(ONE)]
                      // both branches contradict less_than(ONE, p).
                      @when-p-less_than-one |
                        assume less_than(p, ONE) {
                          @p-less_than-one |
                            less_than(p, ONE)
                            [by hypothesis when-p-less_than-one]
                          @one-less_than-p-less_than-one |
                            less_than(ONE, p) -> less_than(p, ONE) -> less_than(ONE, ONE)
                            [using specialize lessThanTransitive(ONE, p, ONE)]
                          @one-less_than-one |
                            less_than(ONE, ONE)
                            [using tautology one-less_than-p-less_than-one one-is-less_than-p p-less_than-one]
                          @conclusion-empty-witness-below |
                            exists i: Int; is_nonneg(i) and (less_than(i, ZERO) and does_divide(p, at(s, i)))
                            [by absurd one-less_than-one one-not-less_than-one]
                        }
                      @when-p-equals-one |
                        assume p = ONE {
                          @p-equals-one |
                            p = ONE
                            [by hypothesis when-p-equals-one]
                          @one-less_than-one-from-p |
                            less_than(ONE, ONE)
                            [by rewrite p-equals-one one-is-less_than-p]
                          @conclusion-empty-witness-equal |
                            exists i: Int; is_nonneg(i) and (less_than(i, ZERO) and does_divide(p, at(s, i)))
                            [by absurd one-less_than-one-from-p one-not-less_than-one]
                        }
                      @some-entry-below-zero-divides |
                        exists i: Int; is_nonneg(i) and (less_than(i, ZERO) and does_divide(p, at(s, i)))
                        [by or_elim p-less_than-one-or-equals-one when-p-less_than-one when-p-equals-one]
                    }
                  @p-divides-empty-gives-witness |
                    does_divide(p, productUpTo(s, ZERO))
                      -> (exists i: Int; is_nonneg(i) and (less_than(i, ZERO) and does_divide(p, at(s, i))))
                    [by implies_intro given-p-divides-empty-product]
                }
              @prime-gives-empty-witness |
                is_prime(p)
                  -> does_divide(p, productUpTo(s, ZERO))
                  -> (exists i: Int; is_nonneg(i) and (less_than(i, ZERO) and does_divide(p, at(s, i))))
                [by implies_intro given-prime-base]
            }
          @empty-product-claim-for-all-p |
            forall p: Int;
              is_prime(p)
              -> does_divide(p, productUpTo(s, ZERO))
              -> (exists i: Int; is_nonneg(i) and (less_than(i, ZERO) and does_divide(p, at(s, i))))
            [by forall_intro generalize-p-base]
        }
      @empty-product-claim-for-all-s |
        forall s: Seq; forall p: Int;
          is_prime(p)
          -> does_divide(p, productUpTo(s, ZERO))
          -> (exists i: Int; is_nonneg(i) and (less_than(i, ZERO) and does_divide(p, at(s, i))))
        [by forall_intro generalize-s-base]
    }
  @base-case |
    is_nonneg(ZERO) -> (forall s: Seq; forall p: Int;
      is_prime(p)
      -> does_divide(p, productUpTo(s, ZERO))
      -> (exists i: Int; is_nonneg(i) and (less_than(i, ZERO) and does_divide(p, at(s, i)))))
    [by implies_intro base-case-proof]

  // inductive step: from the claim at k, derive it at succ(k).
  @induction-step |
    fix k: Int {
      @given-k-nonneg |
        assume is_nonneg(k) {
          @k-nonneg |
            is_nonneg(k)
            [by hypothesis given-k-nonneg]
          @given-inductive-hypothesis |
            assume is_nonneg(k) -> (forall s: Seq; forall p: Int;
              is_prime(p)
              -> does_divide(p, productUpTo(s, k))
              -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))) {
              @guarded-inductive-hypothesis |
                is_nonneg(k) -> (forall s: Seq; forall p: Int;
                  is_prime(p)
                  -> does_divide(p, productUpTo(s, k))
                  -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i)))))
                [by hypothesis given-inductive-hypothesis]
              @inductive-hypothesis |
                forall s: Seq; forall p: Int;
                  is_prime(p)
                  -> does_divide(p, productUpTo(s, k))
                  -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))
                [by modus_ponens guarded-inductive-hypothesis k-nonneg]
              @k-less_than-succ-k |
                less_than(k, succ(k))
                [using specialize lessThanSelf(k)]
              @given-succ-k-nonneg |
                assume is_nonneg(succ(k)) {
                  @claim-at-succ-k |
                    fix s: Seq {
                      @generalize-p-step |
                        fix p: Int {
                          @given-prime-step |
                            assume is_prime(p) {
                              @prime-p |
                                is_prime(p)
                                [by hypothesis given-prime-step]
                              @given-p-divides-succ-product |
                                assume does_divide(p, productUpTo(s, succ(k))) {
                                  @p-divides-succ-product |
                                    does_divide(p, productUpTo(s, succ(k)))
                                    [by hypothesis given-p-divides-succ-product]
                                  @successor-product-splits |
                                    productUpTo(s, succ(k)) = mul(productUpTo(s, k), at(s, k))
                                    [using specialize productUpToSucc(s, k) k-nonneg]
                                  @p-divides-product-times-last |
                                    does_divide(p, mul(productUpTo(s, k), at(s, k)))
                                    [by rewrite successor-product-splits p-divides-succ-product]
                                  @p-divides-product-or-last |
                                    does_divide(p, productUpTo(s, k)) or does_divide(p, at(s, k))
                                    [using specialize euclidsLemma(productUpTo(s, k), at(s, k), p) prime-p p-divides-product-times-last]
                                  // case 1: p divides the length-k product — the IH gives i < k < succ(k).
                                  @when-p-divides-product |
                                    assume does_divide(p, productUpTo(s, k)) {
                                      @p-divides-product |
                                        does_divide(p, productUpTo(s, k))
                                        [by hypothesis when-p-divides-product]
                                      @inductive-hypothesis-at-s-p |
                                        is_prime(p)
                                          -> does_divide(p, productUpTo(s, k))
                                          -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))
                                        [by forall_elim(s, p) inductive-hypothesis]
                                      @earlier-entry-exists |
                                        exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i)))
                                        [using tautology inductive-hypothesis-at-s-p prime-p p-divides-product]
                                      @with-earlier-entry-index |
                                        unpack earlier: Int from earlier-entry-exists {
                                          @entry-earlier-nonneg-less_than-k-divides |
                                            is_nonneg(earlier) and (less_than(earlier, k) and does_divide(p, at(s, earlier)))
                                            [by hypothesis with-earlier-entry-index]
                                          @earlier-less_than-k |
                                            less_than(earlier, k)
                                            [using tautology entry-earlier-nonneg-less_than-k-divides]
                                          @earlier-less_than-succ-k |
                                            less_than(earlier, succ(k))
                                            [using specialize lessThanSuccRight(earlier, k) earlier-less_than-k]
                                          @entry-earlier-nonneg-less_than-succ-k-divides |
                                            is_nonneg(earlier) and (less_than(earlier, succ(k)) and does_divide(p, at(s, earlier)))
                                            [using tautology entry-earlier-nonneg-less_than-k-divides earlier-less_than-succ-k]
                                          @conclusion-earlier-witness |
                                            exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i)))
                                            [by exists_intro(earlier) entry-earlier-nonneg-less_than-succ-k-divides]
                                        }
                                      @earlier-entry-less_than-succ-k |
                                        exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i)))
                                        [by exists_elim with-earlier-entry-index]
                                    }
                                  // case 2: p divides the new last entry — witness i = k.
                                  @when-p-divides-last |
                                    assume does_divide(p, at(s, k)) {
                                      @p-divides-last |
                                        does_divide(p, at(s, k))
                                        [by hypothesis when-p-divides-last]
                                      @k-nonneg-less_than-succ-k-divides |
                                        is_nonneg(k) and (less_than(k, succ(k)) and does_divide(p, at(s, k)))
                                        [using tautology k-nonneg k-less_than-succ-k p-divides-last]
                                      @conclusion-last-entry-witness |
                                        exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i)))
                                        [by exists_intro(k) k-nonneg-less_than-succ-k-divides]
                                    }
                                  @entry-less_than-succ-k-divides |
                                    exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i)))
                                    [by or_elim p-divides-product-or-last when-p-divides-product when-p-divides-last]
                                }
                              @p-divides-succ-product-gives-witness |
                                does_divide(p, productUpTo(s, succ(k)))
                                  -> (exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i))))
                                [by implies_intro given-p-divides-succ-product]
                            }
                          @prime-gives-succ-witness |
                            is_prime(p)
                              -> does_divide(p, productUpTo(s, succ(k)))
                              -> (exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i))))
                            [by implies_intro given-prime-step]
                        }
                      @succ-product-claim-for-all-p |
                        forall p: Int;
                          is_prime(p)
                          -> does_divide(p, productUpTo(s, succ(k)))
                          -> (exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i))))
                        [by forall_intro generalize-p-step]
                    }
                  @claim-at-succ-k-for-all-s |
                    forall s: Seq; forall p: Int;
                      is_prime(p)
                      -> does_divide(p, productUpTo(s, succ(k)))
                      -> (exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i))))
                    [by forall_intro claim-at-succ-k]
                }
              @guarded-claim-at-succ-k |
                is_nonneg(succ(k)) -> (forall s: Seq; forall p: Int;
                  is_prime(p)
                  -> does_divide(p, productUpTo(s, succ(k)))
                  -> (exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i)))))
                [by implies_intro given-succ-k-nonneg]
            }
          @hypothesis-at-k-gives-claim-at-succ-k |
            (is_nonneg(k) -> (forall s: Seq; forall p: Int;
              is_prime(p)
              -> does_divide(p, productUpTo(s, k))
              -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))))
              -> (is_nonneg(succ(k)) -> (forall s: Seq; forall p: Int;
              is_prime(p)
              -> does_divide(p, productUpTo(s, succ(k)))
              -> (exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i))))))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-at-k |
        is_nonneg(k)
          -> (is_nonneg(k) -> (forall s: Seq; forall p: Int;
          is_prime(p)
          -> does_divide(p, productUpTo(s, k))
          -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))))
          -> (is_nonneg(succ(k)) -> (forall s: Seq; forall p: Int;
          is_prime(p)
          -> does_divide(p, productUpTo(s, succ(k)))
          -> (exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i))))))
        [by implies_intro given-k-nonneg]
    }
  @induction-step-for-all-k |
    forall k: Int; is_nonneg(k)
      -> (is_nonneg(k) -> (forall s: Seq; forall p: Int;
      is_prime(p)
      -> does_divide(p, productUpTo(s, k))
      -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))))
      -> (is_nonneg(succ(k)) -> (forall s: Seq; forall p: Int;
      is_prime(p)
      -> does_divide(p, productUpTo(s, succ(k)))
      -> (exists i: Int; is_nonneg(i) and (less_than(i, succ(k)) and does_divide(p, at(s, i))))))
    [by forall_intro induction-step]

  // nonnegInduction on the guard-inclusive predicate yields, for nonneg k, the
  // guarded predicate is_nonneg(k) -> BODY[k]; a nonneg k discharges the guard.
  @guarded-claim-on-nonnegs |
    forall k: Int; is_nonneg(k) -> (is_nonneg(k) -> (forall s: Seq; forall p: Int;
      is_prime(p)
      -> does_divide(p, productUpTo(s, k))
      -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))))
    [using instantiation nonnegInduction((fun k: Int => is_nonneg(k) -> (forall s: Seq; forall p: Int; is_prime(p) -> does_divide(p, productUpTo(s, k)) -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))))) base-case induction-step-for-all-k]

  @collapse-double-guard |
    fix k: Int {
      @given-k-nonneg-final |
        assume is_nonneg(k) {
          @k-nonneg-final |
            is_nonneg(k)
            [by hypothesis given-k-nonneg-final]
          @claim-at-k |
            forall s: Seq; forall p: Int;
              is_prime(p)
              -> does_divide(p, productUpTo(s, k))
              -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))
            [using specialize guarded-claim-on-nonnegs(k) k-nonneg-final k-nonneg-final]
        }
      @k-nonneg-gives-claim |
        is_nonneg(k) -> (forall s: Seq; forall p: Int;
          is_prime(p)
          -> does_divide(p, productUpTo(s, k))
          -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i)))))
        [by implies_intro given-k-nonneg-final]
    }

  @conclusion |
    forall k: Int; is_nonneg(k) ->
      forall s: Seq; forall p: Int;
      is_prime(p)
      -> does_divide(p, productUpTo(s, k))
      -> (exists i: Int; is_nonneg(i) and (less_than(i, k) and does_divide(p, at(s, i))))
    [by forall_intro collapse-double-guard]
qed

// Every integer greater than one has a prime factor — re-exported from the
// sequence library (proved there by strong induction), restated with `is_prime`.
theorem primeFactorExists: forall n: Int; less_than(ONE, n) -> exists p: Int; is_prime(p) and does_divide(p, n)
proof
  @generalize-n |
    fix n: Int {
      @given-one-less_than-n |
        assume less_than(ONE, n) {
          @one-less_than-n |
            less_than(ONE, n)
            [by hypothesis given-one-less_than-n]
          @sequence-prime-factor |
            forall m: Int; less_than(ONE, m) -> exists p: Int; (less_than(ONE, p) and (forall d: Int; less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p))) and does_divide(p, m)
            [by cite sequencePrimeFactorExists]
          @prime-factor-of-n-if |
            less_than(ONE, n) -> exists p: Int; (less_than(ONE, p) and (forall d: Int; less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p))) and does_divide(p, n)
            [by forall_elim(n) sequence-prime-factor]
          @prime-factor-of-n |
            exists p: Int; is_prime(p) and does_divide(p, n)
            [by modus_ponens prime-factor-of-n-if one-less_than-n]
        }
      @one-less_than-n-gives-factor |
        less_than(ONE, n) -> exists p: Int; is_prime(p) and does_divide(p, n)
        [by implies_intro given-one-less_than-n]
    }
  @conclusion |
    forall n: Int; less_than(ONE, n) -> exists p: Int; is_prime(p) and does_divide(p, n)
    [by forall_intro generalize-n]
qed

// A prime cannot divide one: if p | 1 with p > 1 then p ≤ 1 (divisorAtMost),
// which either puts p below one or equal to one — both contradict p > 1.
theorem primeDoesNotDivideOne: forall p: Int; is_prime(p) -> (not does_divide(p, ONE))
proof
  @generalize-p |
    fix p: Int {
      @given-p-prime |
        assume is_prime(p) {
          @p-prime |
            is_prime(p)
            [by hypothesis given-p-prime]
          @one-less_than-p |
            less_than(ONE, p)
            [by and_elim_left p-prime]
          @assume-p-divides-one |
            assume does_divide(p, ONE) {
              @p-divides-one |
                does_divide(p, ONE)
                [by hypothesis assume-p-divides-one]
              @zero-less_than-one-less_than-p |
                less_than(ZERO, ONE) -> less_than(ONE, p) -> less_than(ZERO, p)
                [using specialize lessThanTransitive(ZERO, ONE, p)]
              @zero-less_than-one |
                less_than(ZERO, ONE)
                [by cite zeroLessThanOne]
              @zero-less_than-p |
                less_than(ZERO, p)
                [using tautology zero-less_than-one-less_than-p zero-less_than-one one-less_than-p]
              @p-at-most-one |
                at_most(p, ONE)
                [using specialize divisorAtMost(p, ONE) zero-less_than-p zero-less_than-one p-divides-one]
              @p-less_than-one-or-equals-one |
                less_than(p, ONE) or p = ONE
                [using specialize lessOrEqualSplit(p, ONE) p-at-most-one]
              @one-not-less_than-one |
                not less_than(ONE, ONE)
                [using specialize lessThanIrreflexive(ONE)]
              // both branches contradict less_than(ONE, p).
              @when-p-less_than-one |
                assume less_than(p, ONE) {
                  @p-less_than-one |
                    less_than(p, ONE)
                    [by hypothesis when-p-less_than-one]
                  @one-less_than-p-less_than-one |
                    less_than(ONE, p) -> less_than(p, ONE) -> less_than(ONE, ONE)
                    [using specialize lessThanTransitive(ONE, p, ONE)]
                  @conclusion-below-one |
                    less_than(ONE, ONE)
                    [using tautology one-less_than-p-less_than-one one-less_than-p p-less_than-one]
                }
              @when-p-equals-one |
                assume p = ONE {
                  @p-equals-one |
                    p = ONE
                    [by hypothesis when-p-equals-one]
                  @conclusion-equal-one |
                    less_than(ONE, ONE)
                    [by rewrite p-equals-one one-less_than-p]
                }
              @one-less_than-one-either-way |
                less_than(ONE, ONE)
                [by or_elim p-less_than-one-or-equals-one when-p-less_than-one when-p-equals-one]
              @contradiction |
                not does_divide(p, ONE)
                [by absurd one-less_than-one-either-way one-not-less_than-one]
            }
          @p-does-not-divide-one |
            does_divide(p, ONE) -> (not does_divide(p, ONE))
            [by implies_intro assume-p-divides-one]
          @not-p-divides-one |
            not does_divide(p, ONE)
            [using tautology p-does-not-divide-one]
        }
      @prime-implies-not-divides-one |
        is_prime(p) -> (not does_divide(p, ONE))
        [by implies_intro given-p-prime]
    }
  @conclusion |
    forall p: Int; is_prime(p) -> (not does_divide(p, ONE))
    [by forall_intro generalize-p]
qed

// The infinitude of primes (Euclid). No finite list of primes is complete: were
// `primes` (up to `count`) to enumerate every prime, its product P has a prime
// factor p (primeFactorExists), which by completeness is listed, so p | product
// (memberDividesProduct) and p | P, hence p | (P − product) = 1 — forcing p ≤ 1,
// against p > 1. We state the honest side condition (product > 0) as a hypothesis.
theorem infinitudeOfPrimes: forall primes: Seq; forall count: Int;
  is_nonneg(count) -> less_than(ZERO, productUpTo(primes, count))
  -> (not (forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count)))
proof
  @generalize-primes |
    fix primes: Seq {
      @generalize-count |
        fix count: Int {
          @given-count-nonneg |
            assume is_nonneg(count) {
              @given-product-positive |
                assume less_than(ZERO, productUpTo(primes, count)) {
                  @product-positive |
                    less_than(ZERO, productUpTo(primes, count))
                    [by hypothesis given-product-positive]
                  @count-nonneg |
                    is_nonneg(count)
                    [by hypothesis given-count-nonneg]
                  // Suppose `primes` (up to `count`) enumerates every prime.
                  @given-list-is-complete |
                    assume forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count) {
                      @list-is-complete |
                        forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count)
                        [by hypothesis given-list-is-complete]
                      // P = product + 1 exceeds 1: product ≥ 1 and product < product + 1.
                      @one-at-most-product-if |
                        less_than(ZERO, productUpTo(primes, count)) -> at_most(ONE, productUpTo(primes, count))
                        [using specialize oneAtMostPositive(productUpTo(primes, count))]
                      @one-at-most-product |
                        at_most(ONE, productUpTo(primes, count))
                        [by modus_ponens one-at-most-product-if product-positive]
                      @product-less_than-succ-product |
                        less_than(productUpTo(primes, count), succ(productUpTo(primes, count)))
                        [using specialize lessThanSelf(productUpTo(primes, count))]
                      @succ-product-is-product-plus-one |
                        succ(productUpTo(primes, count)) = add(productUpTo(primes, count), ONE)
                        [using simplify oneIsSuccZero addSuccRight addZeroRight]
                      @product-less_than-big-number |
                        less_than(productUpTo(primes, count), add(productUpTo(primes, count), ONE))
                        [by rewrite succ-product-is-product-plus-one product-less_than-succ-product]
                      @one-less_than-big-number |
                        less_than(ONE, add(productUpTo(primes, count), ONE))
                        [using specialize atMostThenLessThan(ONE, productUpTo(primes, count), add(productUpTo(primes, count), ONE)) one-at-most-product product-less_than-big-number]
                      // P has a prime factor p.
                      @big-number-has-prime-factor-if |
                        less_than(ONE, add(productUpTo(primes, count), ONE)) -> exists p: Int; is_prime(p) and does_divide(p, add(productUpTo(primes, count), ONE))
                        [using specialize primeFactorExists(add(productUpTo(primes, count), ONE))]
                      @big-number-has-prime-factor |
                        exists p: Int; is_prime(p) and does_divide(p, add(productUpTo(primes, count), ONE))
                        [by modus_ponens big-number-has-prime-factor-if one-less_than-big-number]
                      @with-prime-factor-p |
                        unpack p: Int from big-number-has-prime-factor {
                          @p-prime-and-divides-big-number |
                            is_prime(p) and does_divide(p, add(productUpTo(primes, count), ONE))
                            [by hypothesis with-prime-factor-p]
                          @p-is-prime |
                            is_prime(p)
                            [by and_elim_left p-prime-and-divides-big-number]
                          @p-divides-big-number |
                            does_divide(p, add(productUpTo(primes, count), ONE))
                            [by and_elim_right p-prime-and-divides-big-number]
                          @p-above-one |
                            less_than(ONE, p)
                            [by and_elim_left p-is-prime]
                          // p is one of the listed primes, so p | product.
                          @p-in-list |
                            inSeqBefore(p, primes, count)
                            [using specialize list-is-complete(p) p-is-prime]
                          @p-divides-product |
                            does_divide(p, productUpTo(primes, count))
                            [using specialize memberDividesProduct(primes, count, p) count-nonneg p-in-list]
                          // p | P and p | product give p | (P − product) = p | 1.
                          @p-divides-difference |
                            does_divide(p, sub(add(productUpTo(primes, count), ONE), productUpTo(primes, count)))
                            [using specialize dividesSubtracts(p, add(productUpTo(primes, count), ONE), productUpTo(primes, count)) p-divides-big-number p-divides-product]
                          // (product + 1) − product = 1: the one elided linear identity.
                          // `simplify` closes it from oriented (terminating) ring
                          // rules — unfold `sub`, the one needed commutation as a
                          // ground fact, reassociate, cancel `product + (−product)`.
                          @product-plus-one-commuted |
                            add(productUpTo(primes, count), ONE) = add(ONE, productUpTo(primes, count))
                            [using specialize addIsCommutative(productUpTo(primes, count), ONE)]
                          @difference-is-one |
                            sub(add(productUpTo(primes, count), ONE), productUpTo(primes, count)) = ONE
                            [using simplify definitionOfSubtraction product-plus-one-commuted addIsAssociative addNegRight addZeroRight]
                          @p-divides-one |
                            does_divide(p, ONE)
                            [by rewrite difference-is-one p-divides-difference]
                          // p | 1 with p > 1 is impossible: p ≤ 1 < p is less_than itself.
                          @zero-less_than-p-if-chained |
                            less_than(ZERO, ONE) -> less_than(ONE, p) -> less_than(ZERO, p)
                            [using specialize lessThanTransitive(ZERO, ONE, p)]
                          @zero-less_than-one |
                            less_than(ZERO, ONE)
                            [by cite zeroLessThanOne]
                          @p-positive |
                            less_than(ZERO, p)
                            [using tautology zero-less_than-p-if-chained zero-less_than-one p-above-one]
                          @p-at-most-one |
                            at_most(p, ONE)
                            [using specialize divisorAtMost(p, ONE) p-positive zero-less_than-one p-divides-one]
                          @p-less_than-itself |
                            less_than(p, p)
                            [using specialize atMostThenLessThan(p, ONE, p) p-at-most-one p-above-one]
                          @p-not-less_than-itself |
                            not less_than(p, p)
                            [using specialize lessThanIrreflexive(p)]
                          @contradiction |
                            not (forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count))
                            [by absurd p-less_than-itself p-not-less_than-itself]
                        }
                      @contradiction |
                        not (forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count))
                        [by exists_elim with-prime-factor-p]
                    }
                  @list-complete-is-absurd |
                    (forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count)) -> (not (forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count)))
                    [by implies_intro given-list-is-complete]
                  @no-complete-finite-list |
                    not (forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count))
                    [using tautology list-complete-is-absurd]
                }
              @product-positive-implies-no-complete-list |
                less_than(ZERO, productUpTo(primes, count)) -> (not (forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count)))
                [by implies_intro given-product-positive]
            }
          @count-nonneg-implies-no-complete-list |
            is_nonneg(count) -> less_than(ZERO, productUpTo(primes, count)) -> (not (forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count)))
            [by implies_intro given-count-nonneg]
        }
      @discharge-count |
        forall count: Int; is_nonneg(count) -> less_than(ZERO, productUpTo(primes, count)) -> (not (forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count)))
        [by forall_intro generalize-count]
    }
  @conclusion |
    forall primes: Seq; forall count: Int; is_nonneg(count) -> less_than(ZERO, productUpTo(primes, count)) -> (not (forall q: Int; is_prime(q) -> inSeqBefore(q, primes, count)))
    [by forall_intro generalize-primes]
qed
