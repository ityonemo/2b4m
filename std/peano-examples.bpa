// Worked example for `std/peano.bpa`'s nonnegativity predicate.
//
// Why this file exists: `nonneg` is supplied for the `arithmetic` certifier — that
// accelerant runs a pure-ℤ engine and needs a ℕ theory to hand it nonnegativity as a
// well-known predicate. Ordinary proofs never need it, so nothing in `peano.bpa` cites
// `nonnegAll`, and an axiom nothing instantiates is one whose binder has never been used.
import peano <<< "std/peano.bpa"

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
pred nonneg = peano.nonneg

axiom nonnegAll = peano.nonnegAll

// Every natural is nonneg — including the ones the certifier meets as compound terms.
// Instantiating at a sum of successors is what shows the axiom really is uniform.
theorem everySumIsNonneg: forall a, b: Nat; nonneg(add(succ(a), b))
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @every-natural-is-nonneg |
            forall n: Nat; nonneg(n)
            [by cite nonnegAll]
          @conclusion-sum-is-nonneg |
            nonneg(add(succ(a), b))
            [by forall_elim(add(succ(a), b)) every-natural-is-nonneg]
        }
      @discharge-b |
        forall b: Nat; nonneg(add(succ(a), b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; nonneg(add(succ(a), b))
    [by forall_intro generalize-a]
qed
