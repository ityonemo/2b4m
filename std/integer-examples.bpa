// Worked examples for the `std/integer-*` theories' otherwise-unexercised axioms:
// powers and lcm nonnegativity (integer-divides), the modulus / quotient identification /
// unit characterization (integer-mod-n), and the five sequence CONSTRUCTORS
// (integer-sequence).
//
// Why this file exists: each of these axioms is stated for callers — `pow`'s recursion is
// unfolded in aata's exponent arguments, the sequence constructors are what the FTA
// factorization builds with, the ℤ_n axioms are consumed by model transfers — so no
// derivation inside std/ ever rests on them. An axiom no proof touches is one whose
// binders, guards and direction have never been checked. Each theorem below is the
// smallest derivation that genuinely needs the axiom it names.
//
// (aata/2.3-primes.md exercises the sequence constructors far harder: its
// `factorizationPermutationExists` rests on four of the five at once. These are the
// library's own smoke tests, not a replacement for that.)
import int_divides <<< "std/integer-divides.bpa"
import mod_n <<< "std/integer-mod-n.bpa"
import sequence <<< "std/integer-sequence.bpa"
import integer <<< "std/integer.bpa"
import order <<< "std/integer-order.bpa"

sort Int = integer.Int
sort NonNegZ = integer.NonNeg
sort Zn = mod_n.Zn
sort Seq = sequence.Seq
const ZERO = integer.ZERO
const ONE = integer.ONE
const N = mod_n.N
const IZERO = integer.ZERO
const ZnONE = mod_n.ONE
func succ = integer.succ
func add = integer.add
func mul = integer.mul
func isub = integer.sub
func pow = int_divides.pow
func lcm = int_divides.lcm
func cls = mod_n.cls
func znmul = mod_n.mul
func at = sequence.at
func productUpTo = sequence.productUpTo
pred is_nonneg = order.nonneg
pred less_than = order.less_than
pred isUnit = mod_n.isUnit

define at_most(a, b) = order.less_or_equal(a, b)
define divides(d, k) = exists j: Int; k = integer.mul(d, j)

axiom nonnegZero = order.nonnegZero
axiom nonnegSucc = order.nonnegSucc
theorem nonnegOne = sequence.nonnegOne
theorem nonnegAdd = order.nonnegAdd
axiom powZero = int_divides.powZero
axiom powSucc = int_divides.powSucc
axiom lcmNonneg = int_divides.lcmNonneg
axiom nPositive = mod_n.nPositive
axiom clsCongruent = mod_n.clsCongruent
axiom isUnitCharacterization = mod_n.isUnitCharacterization
axiom oneIsUnit = mod_n.oneIsUnit
axiom productUpToZero = sequence.productUpToZero
axiom productUpToSucc = sequence.productUpToSucc
axiom addZeroLeft = integer.addZeroLeft
axiom oneIsSuccZero = integer.oneIsSuccZero
theorem lessOrEqualRefl = order.lessOrEqualRefl
theorem zeroLessThanOne = order.zeroLessThanOne
axiom seqSingletonExists = sequence.seqSingletonExists
axiom seqPrependExists = sequence.seqPrependExists
axiom seqConcatExists = sequence.seqConcatExists
axiom seqShiftPastExists = sequence.seqShiftPastExists
axiom seqRemoveExists = sequence.seqRemoveExists

// ===========================================================================
// integer-divides: powers and lcm
// ===========================================================================

// b¹ = b: unfold the successor case once, then the base case. Both recursion axioms in
// sequence — the smallest computation that needs each of them exactly once.
theorem powerOfOneIsTheBase: forall b: Int; pow(b, succ(ZERO)) = mul(ONE, b)
proof
  @generalize-b |
    fix b: Int {
      @successor-unfolds |
        pow(b, succ(ZERO)) = mul(pow(b, ZERO), b)
        [using specialize powSucc(b, ZERO)]
      @base-case-is-one |
        pow(b, ZERO) = ONE
        [using specialize powZero(b)]
      @conclusion-power-of-one |
        pow(b, succ(ZERO)) = mul(ONE, b)
        [by rewrite base-case-is-one successor-unfolds]
    }
  @conclusion |
    forall b: Int; pow(b, succ(ZERO)) = mul(ONE, b)
    [by forall_intro generalize-b]
qed

// the lcm is never negative — including of a pair that is itself an lcm. The axiom is
// what lets an lcm be used as a nonneg-guarded index or bound.
theorem nestedLeastCommonMultipleIsNonneg: forall a, b, c: Int; is_nonneg(lcm(lcm(a, b), c))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @generalize-c |
            fix c: Int {
              @conclusion-nested-lcm-is-nonneg |
                is_nonneg(lcm(lcm(a, b), c))
                [using specialize lcmNonneg(lcm(a, b), c)]
            }
          @discharge-c |
            forall c: Int; is_nonneg(lcm(lcm(a, b), c))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Int; is_nonneg(lcm(lcm(a, b), c))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Int; is_nonneg(lcm(lcm(a, b), c))
    [by forall_intro generalize-a]
qed

// ===========================================================================
// integer-mod-n: the modulus, the quotient, the units
// ===========================================================================

// -- the modulus is positive -------------------------------------------------

// n > 0, so the modulus is a legitimate strictly-positive bound — the fact every
// well-ordering or division argument over ℤ_n starts from.
theorem theModulusIsPositive: exists m: Int; less_than(IZERO, m)
proof
  @modulus-is-positive |
    less_than(IZERO, N)
    [by cite nPositive]
  @conclusion |
    exists m: Int; less_than(IZERO, m)
    [by exists_intro(N) modulus-is-positive]
qed

// -- the quotient identification ---------------------------------------------

// classes agreeing means the modulus divides the difference: the forward direction of
// the identification, which is what turns an equation in ℤ_n into one in ℤ.
theorem equalClassesDivideTheirDifference: forall a, b: Int; cls(a) = cls(b) -> divides(N, isub(a, b))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @class-identification |
            cls(a) = cls(b) iff divides(N, isub(a, b))
            [using specialize clsCongruent(a, b)]
          @conclusion-equal-classes-divide |
            cls(a) = cls(b) -> divides(N, isub(a, b))
            [by iff_elim_forward class-identification]
        }
      @discharge-b |
        forall b: Int; cls(a) = cls(b) -> divides(N, isub(a, b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; cls(a) = cls(b) -> divides(N, isub(a, b))
    [by forall_intro generalize-a]
qed

// -- the unit characterization -----------------------------------------------

// 1 is a unit, so unfolding the characterization at 1 produces its two-sided inverse —
// the backward direction of the opaque predicate's defining biconditional.
theorem theIdentityHasATwoSidedInverse: exists y: Zn; znmul(ZnONE, y) = ZnONE and znmul(y, ZnONE) = ZnONE
proof
  @one-is-a-unit |
    isUnit(ZnONE)
    [by cite oneIsUnit]
  @unit-characterization |
    isUnit(ZnONE) iff (exists y: Zn; znmul(ZnONE, y) = ZnONE and znmul(y, ZnONE) = ZnONE)
    [using specialize isUnitCharacterization(ZnONE)]
  @unit-implies-inverse |
    isUnit(ZnONE) -> (exists y: Zn; znmul(ZnONE, y) = ZnONE and znmul(y, ZnONE) = ZnONE)
    [by iff_elim_forward unit-characterization]
  @conclusion |
    exists y: Zn; znmul(ZnONE, y) = ZnONE and znmul(y, ZnONE) = ZnONE
    [by modus_ponens unit-implies-inverse one-is-a-unit]
qed

// ===========================================================================
// integer-sequence: the reification-existence constructors
// ===========================================================================

// -- the singleton constructor ----------------------------------------------

// [x] exists with head x and length-one product x, so some sequence's first entry
// equals its own length-one product. The shape an FTA factorization starts from.
theorem someSequenceHasHeadAsProduct: forall x: Int; exists s: Seq; at(s, ZERO) = x and productUpTo(s, ONE) = at(s, ZERO)
proof
  @zero-is-nonneg |
    is_nonneg(ZERO)
    [by cite nonnegZero]
  @one-is-nonneg |
    is_nonneg(ONE)
    [by cite nonnegOne]
  @generalize-x |
    fix x: Int {
      @singleton-exists |
        exists s: Seq; at(s, ZERO) = x and productUpTo(s, ONE) = x
        [using specialize seqSingletonExists(x)]
      @with-singleton-s |
        unpack s: Seq from singleton-exists {
          @singleton-clauses |
            at(s, ZERO) = x and productUpTo(s, ONE) = x
            [by hypothesis with-singleton-s]
          @head-is-x |
            at(s, ZERO) = x
            [by and_elim_left singleton-clauses]
          @product-is-x |
            productUpTo(s, ONE) = x
            [by and_elim_right singleton-clauses]
          @product-is-head |
            productUpTo(s, ONE) = at(s, ZERO)
            [by rewrite head-is-x product-is-x]
          @both-clauses |
            at(s, ZERO) = x and productUpTo(s, ONE) = at(s, ZERO)
            [by and_intro head-is-x product-is-head]
          @conclusion-some-singleton |
            exists u: Seq; at(u, ZERO) = x and productUpTo(u, ONE) = at(u, ZERO)
            [by exists_intro(s) both-clauses]
        }
      @conclusion-for-x |
        exists u: Seq; at(u, ZERO) = x and productUpTo(u, ONE) = at(u, ZERO)
        [by exists_elim with-singleton-s]
    }
  @conclusion |
    forall x: Int; exists s: Seq; at(s, ZERO) = x and productUpTo(s, ONE) = at(s, ZERO)
    [by forall_intro generalize-x]
qed

// -- the prepend constructor -------------------------------------------------

// x :: s puts x at the head and shifts s up by one, so the result reads s's index 0
// at its own index 1.
theorem prependShiftsTheTail: forall x: Int; forall s: Seq; exists u: Seq; at(u, ZERO) = x and at(u, succ(ZERO)) = at(s, ZERO)
proof
  @zero-is-nonneg |
    is_nonneg(ZERO)
    [by cite nonnegZero]
  @successor-of-zero-is-nonneg |
    is_nonneg(succ(ZERO))
    [using specialize nonnegSucc(ZERO) zero-is-nonneg]
  @generalize-x |
    fix x: Int {
      @generalize-s |
        fix s: Seq {
          @prepend-exists |
            exists u: Seq; at(u, ZERO) = x and (forall i: NonNegZ; at(u, succ(i)) = at(s, i))
            [using specialize seqPrependExists(x, s)]
          @with-prepended-u |
            unpack u: Seq from prepend-exists {
              @prepend-clauses |
                at(u, ZERO) = x and (forall i: NonNegZ; at(u, succ(i)) = at(s, i))
                [by hypothesis with-prepended-u]
              @head-is-x |
                at(u, ZERO) = x
                [by and_elim_left prepend-clauses]
              @tail-agrees-everywhere |
                forall i: NonNegZ; at(u, succ(i)) = at(s, i)
                [by and_elim_right prepend-clauses]
              @tail-agrees-at-zero |
                at(u, succ(ZERO)) = at(s, ZERO)
                [by forall_elim(ZERO) tail-agrees-everywhere]
              @both-clauses |
                at(u, ZERO) = x and at(u, succ(ZERO)) = at(s, ZERO)
                [by and_intro head-is-x tail-agrees-at-zero]
              @conclusion-some-prepend |
                exists v: Seq; at(v, ZERO) = x and at(v, succ(ZERO)) = at(s, ZERO)
                [by exists_intro(u) both-clauses]
            }
          @conclusion-for-s |
            exists v: Seq; at(v, ZERO) = x and at(v, succ(ZERO)) = at(s, ZERO)
            [by exists_elim with-prepended-u]
        }
      @discharge-s |
        forall s: Seq; exists v: Seq; at(v, ZERO) = x and at(v, succ(ZERO)) = at(s, ZERO)
        [by forall_intro generalize-s]
    }
  @conclusion |
    forall x: Int; forall s: Seq; exists u: Seq; at(u, ZERO) = x and at(u, succ(ZERO)) = at(s, ZERO)
    [by forall_intro generalize-x]
qed

// -- the concatenation constructor -------------------------------------------

// Concatenating a length-one prefix onto a length-one tail: at j = k = 1 the product
// clause reads productUpTo(u, 1+1) = productUpTo(s, 1) · productUpTo(t, 1), and BOTH entry
// clauses have a live index — u agrees with s at 0 (below j) and with t at the SHIFTED
// index 1+0 (the slot the tail lands in). This is the case that actually checks the
// index arithmetic: the degenerate j = k = 0 version leaves the shift untested.
theorem concatOfTwoSingletonsAgreesAndMultiplies: forall s: Seq; forall t: Seq; is_nonneg(add(ONE, ONE)) -> exists u: Seq; at(u, ZERO) = at(s, ZERO) and at(u, add(ONE, ZERO)) = at(t, ZERO) and productUpTo(u, add(ONE, ONE)) = mul(productUpTo(s, ONE), productUpTo(t, ONE))
proof
  @zero-is-nonneg |
    is_nonneg(ZERO)
    [by cite nonnegZero]
  @one-is-nonneg |
    is_nonneg(ONE)
    [by cite nonnegOne]
  // the shifted slot 1+0 is a nonneg index — needed wherever the statement mentions it.
  @shifted-index-is-nonneg |
    is_nonneg(add(ONE, ZERO))
    [using specialize nonnegAdd(ONE, ZERO) one-is-nonneg zero-is-nonneg]
  @generalize-s |
    fix s: Seq {
      @generalize-t |
        fix t: Seq {
          @given-length-nonneg |
            assume is_nonneg(add(ONE, ONE)) {
              @length-is-nonneg |
                is_nonneg(add(ONE, ONE))
                [by hypothesis given-length-nonneg]
              @concat-exists |
                exists u: Seq;
                  (forall i: NonNegZ; less_than(i, ONE) -> at(u, i) = at(s, i))
                  and (forall i: NonNegZ; is_nonneg(add(ONE, i)) -> less_than(i, ONE) -> at(u, add(ONE, i)) = at(t, i))
                  and productUpTo(u, add(ONE, ONE)) = mul(productUpTo(s, ONE), productUpTo(t, ONE))
                [using specialize seqConcatExists(s, t, ONE, ONE) length-is-nonneg]
              @with-concatenated-u |
                unpack u: Seq from concat-exists {
                  @concat-clauses |
                    (forall i: NonNegZ; less_than(i, ONE) -> at(u, i) = at(s, i))
                      and (forall i: NonNegZ; is_nonneg(add(ONE, i)) -> less_than(i, ONE) -> at(u, add(ONE, i)) = at(t, i))
                      and productUpTo(u, add(ONE, ONE)) = mul(productUpTo(s, ONE), productUpTo(t, ONE))
                    [by hypothesis with-concatenated-u]
                  @entry-clauses |
                    (forall i: NonNegZ; less_than(i, ONE) -> at(u, i) = at(s, i))
                      and (forall i: NonNegZ; is_nonneg(add(ONE, i)) -> less_than(i, ONE) -> at(u, add(ONE, i)) = at(t, i))
                    [by and_elim_left concat-clauses]
                  @prefix-clause |
                    forall i: NonNegZ; less_than(i, ONE) -> at(u, i) = at(s, i)
                    [by and_elim_left entry-clauses]
                  @shift-clause |
                    forall i: NonNegZ; is_nonneg(add(ONE, i)) -> less_than(i, ONE) -> at(u, add(ONE, i)) = at(t, i)
                    [by and_elim_right entry-clauses]
                  @product-clause |
                    productUpTo(u, add(ONE, ONE)) = mul(productUpTo(s, ONE), productUpTo(t, ONE))
                    [by and_elim_right concat-clauses]
                  // index 0 is below the prefix length 1, so u reads s there.
                  @zero-is-below-one |
                    less_than(ZERO, ONE)
                    [by cite zeroLessThanOne]
                  @prefix-at-zero |
                    less_than(ZERO, ONE) -> at(u, ZERO) = at(s, ZERO)
                    [by forall_elim(ZERO) prefix-clause]
                  @head-agrees-with-s |
                    at(u, ZERO) = at(s, ZERO)
                    [by modus_ponens prefix-at-zero zero-is-below-one]
                  // the shifted slot is below the tail length, so u reads t there.
                  @shift-at-zero |
                    is_nonneg(add(ONE, ZERO)) -> less_than(ZERO, ONE) -> at(u, add(ONE, ZERO)) = at(t, ZERO)
                    [by forall_elim(ZERO) shift-clause]
                  @shift-at-zero-guarded |
                    less_than(ZERO, ONE) -> at(u, add(ONE, ZERO)) = at(t, ZERO)
                    [by modus_ponens shift-at-zero shifted-index-is-nonneg]
                  @tail-agrees-with-t |
                    at(u, add(ONE, ZERO)) = at(t, ZERO)
                    [by modus_ponens shift-at-zero-guarded zero-is-below-one]
                  @entry-facts |
                    at(u, ZERO) = at(s, ZERO) and at(u, add(ONE, ZERO)) = at(t, ZERO)
                    [by and_intro head-agrees-with-s tail-agrees-with-t]
                  @all-three-facts |
                    at(u, ZERO) = at(s, ZERO) and at(u, add(ONE, ZERO)) = at(t, ZERO) and productUpTo(u, add(ONE, ONE)) = mul(productUpTo(s, ONE), productUpTo(t, ONE))
                    [by and_intro entry-facts product-clause]
                  @conclusion-some-concat |
                    exists v: Seq; at(v, ZERO) = at(s, ZERO) and at(v, add(ONE, ZERO)) = at(t, ZERO) and productUpTo(v, add(ONE, ONE)) = mul(productUpTo(s, ONE), productUpTo(t, ONE))
                    [by exists_intro(u) all-three-facts]
                }
              @conclusion-unpacked |
                exists v: Seq; at(v, ZERO) = at(s, ZERO) and at(v, add(ONE, ZERO)) = at(t, ZERO) and productUpTo(v, add(ONE, ONE)) = mul(productUpTo(s, ONE), productUpTo(t, ONE))
                [by exists_elim with-concatenated-u]
            }
          @conclusion-guarded |
            is_nonneg(add(ONE, ONE)) -> exists v: Seq; at(v, ZERO) = at(s, ZERO) and at(v, add(ONE, ZERO)) = at(t, ZERO) and productUpTo(v, add(ONE, ONE)) = mul(productUpTo(s, ONE), productUpTo(t, ONE))
            [by implies_intro given-length-nonneg]
        }
      @discharge-t |
        forall t: Seq; is_nonneg(add(ONE, ONE)) -> exists u: Seq; at(u, ZERO) = at(s, ZERO) and at(u, add(ONE, ZERO)) = at(t, ZERO) and productUpTo(u, add(ONE, ONE)) = mul(productUpTo(s, ONE), productUpTo(t, ONE))
        [by forall_intro generalize-t]
    }
  @conclusion |
    forall s: Seq; forall t: Seq; is_nonneg(add(ONE, ONE)) -> exists u: Seq; at(u, ZERO) = at(s, ZERO) and at(u, add(ONE, ZERO)) = at(t, ZERO) and productUpTo(u, add(ONE, ONE)) = mul(productUpTo(s, ONE), productUpTo(t, ONE))
    [by forall_intro generalize-s]
qed

// -- the reindex-past-a-threshold constructor --------------------------------

// Shifting past a threshold with an empty window (k = 0): the reindexed sequence exists
// and both clauses hold vacuously below the bound. What this checks is the guard —
// `is_nonneg(m)` — and the existence of the witness itself.
theorem shiftPastThresholdExists: forall g: Seq; is_nonneg(ZERO) -> exists r: Seq; forall i: NonNegZ; less_than(i, ZERO) -> less_than(at(g, i), ZERO) -> at(r, i) = at(g, i)
proof
  @generalize-g |
    fix g: Seq {
      @given-threshold-nonneg |
        assume is_nonneg(ZERO) {
          @threshold-is-nonneg |
            is_nonneg(ZERO)
            [by hypothesis given-threshold-nonneg]
          @shift-exists |
            exists r: Seq;
              (forall i: NonNegZ; less_than(i, ZERO) -> less_than(at(g, i), ZERO) -> at(r, i) = at(g, i))
              and (forall i: NonNegZ; less_than(i, ZERO) -> at_most(ZERO, at(g, i)) -> at(r, i) = succ(at(g, i)))
            [using specialize seqShiftPastExists(g, ZERO, ZERO) threshold-is-nonneg]
          @with-shifted-r |
            unpack r: Seq from shift-exists {
              @shift-clauses |
                (forall i: NonNegZ; less_than(i, ZERO) -> less_than(at(g, i), ZERO) -> at(r, i) = at(g, i))
                  and (forall i: NonNegZ; less_than(i, ZERO) -> at_most(ZERO, at(g, i)) -> at(r, i) = succ(at(g, i)))
                [by hypothesis with-shifted-r]
              @below-threshold-copied |
                forall i: NonNegZ; less_than(i, ZERO) -> less_than(at(g, i), ZERO) -> at(r, i) = at(g, i)
                [by and_elim_left shift-clauses]
              @conclusion-some-shift |
                exists q: Seq; forall i: NonNegZ; less_than(i, ZERO) -> less_than(at(g, i), ZERO) -> at(q, i) = at(g, i)
                [by exists_intro(r) below-threshold-copied]
            }
          @conclusion-unpacked |
            exists q: Seq; forall i: NonNegZ; less_than(i, ZERO) -> less_than(at(g, i), ZERO) -> at(q, i) = at(g, i)
            [by exists_elim with-shifted-r]
        }
      @conclusion-guarded |
        is_nonneg(ZERO) -> exists q: Seq; forall i: NonNegZ; less_than(i, ZERO) -> less_than(at(g, i), ZERO) -> at(q, i) = at(g, i)
        [by implies_intro given-threshold-nonneg]
    }
  @conclusion |
    forall g: Seq; is_nonneg(ZERO) -> exists r: Seq; forall i: NonNegZ; less_than(i, ZERO) -> less_than(at(g, i), ZERO) -> at(r, i) = at(g, i)
    [by forall_intro generalize-g]
qed

// -- the removal constructor -------------------------------------------------

// Deleting the FIRST of two entries (k = 1, m = 0): now every clause has content. The
// product clause says productUpTo(t, 1) · at(s, 0) = productUpTo(s, 2); the shift clause
// says t reads s one slot higher at index 0, since 0 is at-or-above the removed index and
// below the shortened length. Unfolding productUpTo(t, 1) turns the product clause into a
// statement about t's only entry — which the shift clause identifies as at(s, 1). The
// degenerate k = m = 0 version leaves both of those clauses vacuous.
theorem removingTheFirstOfTwoShiftsTheRest: forall s: Seq; is_nonneg(succ(ONE)) -> less_than(ZERO, succ(ONE)) -> exists t: Seq; mul(mul(ONE, at(t, ZERO)), at(s, ZERO)) = productUpTo(s, succ(ONE)) and at(t, ZERO) = at(s, succ(ZERO))
proof
  @zero-is-nonneg |
    is_nonneg(ZERO)
    [by cite nonnegZero]
  @one-is-nonneg |
    is_nonneg(ONE)
    [by cite nonnegOne]
  @successor-of-zero-is-nonneg |
    is_nonneg(succ(ZERO))
    [using specialize nonnegSucc(ZERO) zero-is-nonneg]
  @generalize-s |
    fix s: Seq {
      @given-length-nonneg |
        assume is_nonneg(succ(ONE)) {
          @given-zero-below-length |
            assume less_than(ZERO, succ(ONE)) {
              @length-is-nonneg |
                is_nonneg(succ(ONE))
                [by hypothesis given-length-nonneg]
              @zero-is-below-length |
                less_than(ZERO, succ(ONE))
                [by hypothesis given-zero-below-length]
              @remove-exists |
                exists t: Seq;
                  mul(productUpTo(t, ONE), at(s, ZERO)) = productUpTo(s, succ(ONE))
                  and (forall i: NonNegZ; less_than(i, ZERO) -> at(t, i) = at(s, i))
                  and (forall i: NonNegZ; is_nonneg(succ(i)) -> at_most(ZERO, i) -> less_than(i, ONE) -> at(t, i) = at(s, succ(i)))
                [using specialize seqRemoveExists(s, ONE, ZERO) length-is-nonneg zero-is-below-length]
              @with-shortened-t |
                unpack t: Seq from remove-exists {
                  @remove-clauses |
                    mul(productUpTo(t, ONE), at(s, ZERO)) = productUpTo(s, succ(ONE))
                      and (forall i: NonNegZ; less_than(i, ZERO) -> at(t, i) = at(s, i))
                      and (forall i: NonNegZ; is_nonneg(succ(i)) -> at_most(ZERO, i) -> less_than(i, ONE) -> at(t, i) = at(s, succ(i)))
                    [by hypothesis with-shortened-t]
                  @product-and-prefix-clauses |
                    mul(productUpTo(t, ONE), at(s, ZERO)) = productUpTo(s, succ(ONE))
                      and (forall i: NonNegZ; less_than(i, ZERO) -> at(t, i) = at(s, i))
                    [by and_elim_left remove-clauses]
                  @product-clause |
                    mul(productUpTo(t, ONE), at(s, ZERO)) = productUpTo(s, succ(ONE))
                    [by and_elim_left product-and-prefix-clauses]
                  @shift-clause |
                    forall i: NonNegZ; is_nonneg(succ(i)) -> at_most(ZERO, i) -> less_than(i, ONE) -> at(t, i) = at(s, succ(i))
                    [by and_elim_right remove-clauses]
                  // the shortened sequence's length-one product is its only entry.
                  @one-is-successor-of-zero |
                    ONE = succ(ZERO)
                    [by cite oneIsSuccZero]
                  @product-at-successor-of-zero |
                    productUpTo(t, succ(ZERO)) = mul(productUpTo(t, ZERO), at(t, ZERO))
                    [using specialize productUpToSucc(t, ZERO)]
                  @shortened-product-unfolds |
                    productUpTo(t, ONE) = mul(productUpTo(t, ZERO), at(t, ZERO))
                    [by rewrite one-is-successor-of-zero product-at-successor-of-zero]
                  @shortened-empty-product |
                    productUpTo(t, ZERO) = ONE
                    [using specialize productUpToZero(t)]
                  @shortened-product-is-its-entry |
                    productUpTo(t, ONE) = mul(ONE, at(t, ZERO))
                    [by rewrite shortened-empty-product shortened-product-unfolds]
                  @product-in-terms-of-the-entry |
                    mul(mul(ONE, at(t, ZERO)), at(s, ZERO)) = productUpTo(s, succ(ONE))
                    [by rewrite shortened-product-is-its-entry product-clause]
                  // index 0 is at-or-above the removed index 0 and below the shortened
                  // length 1, so t reads s one slot higher there.
                  @zero-at-most-zero |
                    at_most(ZERO, ZERO)
                    [using specialize lessOrEqualRefl(ZERO)]
                  @zero-is-below-one |
                    less_than(ZERO, ONE)
                    [by cite zeroLessThanOne]
                  @shift-at-zero |
                    is_nonneg(succ(ZERO)) -> at_most(ZERO, ZERO) -> less_than(ZERO, ONE) -> at(t, ZERO) = at(s, succ(ZERO))
                    [by forall_elim(ZERO) shift-clause]
                  @shift-past-nonneg-guard |
                    at_most(ZERO, ZERO) -> less_than(ZERO, ONE) -> at(t, ZERO) = at(s, succ(ZERO))
                    [by modus_ponens shift-at-zero successor-of-zero-is-nonneg]
                  @shift-past-at-most-guard |
                    less_than(ZERO, ONE) -> at(t, ZERO) = at(s, succ(ZERO))
                    [by modus_ponens shift-past-nonneg-guard zero-at-most-zero]
                  @entry-is-shifted |
                    at(t, ZERO) = at(s, succ(ZERO))
                    [by modus_ponens shift-past-at-most-guard zero-is-below-one]
                  @both-facts |
                    mul(mul(ONE, at(t, ZERO)), at(s, ZERO)) = productUpTo(s, succ(ONE)) and at(t, ZERO) = at(s, succ(ZERO))
                    [by and_intro product-in-terms-of-the-entry entry-is-shifted]
                  @conclusion-some-removal |
                    exists u: Seq; mul(mul(ONE, at(u, ZERO)), at(s, ZERO)) = productUpTo(s, succ(ONE)) and at(u, ZERO) = at(s, succ(ZERO))
                    [by exists_intro(t) both-facts]
                }
              @conclusion-unpacked |
                exists u: Seq; mul(mul(ONE, at(u, ZERO)), at(s, ZERO)) = productUpTo(s, succ(ONE)) and at(u, ZERO) = at(s, succ(ZERO))
                [by exists_elim with-shortened-t]
            }
          @conclusion-inner-guard |
            less_than(ZERO, succ(ONE)) -> exists u: Seq; mul(mul(ONE, at(u, ZERO)), at(s, ZERO)) = productUpTo(s, succ(ONE)) and at(u, ZERO) = at(s, succ(ZERO))
            [by implies_intro given-zero-below-length]
        }
      @conclusion-both-guards |
        is_nonneg(succ(ONE)) -> less_than(ZERO, succ(ONE)) -> exists u: Seq; mul(mul(ONE, at(u, ZERO)), at(s, ZERO)) = productUpTo(s, succ(ONE)) and at(u, ZERO) = at(s, succ(ZERO))
        [by implies_intro given-length-nonneg]
    }
  @conclusion |
    forall s: Seq; is_nonneg(succ(ONE)) -> less_than(ZERO, succ(ONE)) -> exists t: Seq; mul(mul(ONE, at(t, ZERO)), at(s, ZERO)) = productUpTo(s, succ(ONE)) and at(t, ZERO) = at(s, succ(ZERO))
    [by forall_intro generalize-s]
qed
