// std/field.b4m — the theory of a FIELD: a commutative ring with unit in which
// every NONZERO element has a multiplicative inverse. It is the ring theory
// (std/ring.b4m) plus multiplicative commutativity, a two-sided unit, and a
// (partial) reciprocal `recip` satisfying `x ≠ 0 → x·recip(x) = 1`, together with
// nontriviality `1 ≠ 0`.
//
// The ring structure `(Field, add, mul, ZERO, ONE, neg)` IS a commutative ring, so
// this theory MODELS std/ring.b4m: the ring corpus (mulZero, mulNeg*, negMulNeg,
// additiveInverseUnique, …) transfers in, and the field's own properties
// (reciprocal cancellation, no zero divisors) are proved using those transferred
// facts plus the field axioms.
//
// `recip` is TOTAL as a function (recip(ZERO) is an unconstrained junk value); the
// ONLY axiom about it is guarded on `x ≠ ZERO`, so recip(ZERO) is never usable —
// the same discipline by which division guards nonzero in std/integer/divides.b4m.

import ring <<< "std/ring.b4m"

sort Field
const ZERO: Field
const ONE: Field
func add(a: Field, b: Field) => Field
func mul(a: Field, b: Field) => Field
func neg(a: Field) => Field
func recip(a: Field) => Field

// -- ring axioms (discharge the ring model below) ---------------------------
// Left-axiomatic, as in ring.b4m: only LEFT identity/inverse are primitive.
axiom addIsAssociative: forall a, b, c: Field; add(add(a, b), c) = add(a, add(b, c))
axiom addZeroLeft: forall a: Field; add(ZERO, a) = a
axiom addNegLeft: forall a: Field; add(neg(a), a) = ZERO
axiom addIsCommutative: forall a, b: Field; add(a, b) = add(b, a)
axiom mulIsAssociative: forall a, b, c: Field; mul(mul(a, b), c) = mul(a, mul(b, c))
axiom mulAddDistribLeft: forall a, b, c: Field; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
axiom mulAddDistribRight: forall a, b, c: Field; mul(add(a, b), c) = add(mul(a, c), mul(b, c))

// -- field-specific axioms --------------------------------------------------
axiom mulIsCommutative: forall a, b: Field; mul(a, b) = mul(b, a)
axiom mulOneLeft: forall a: Field; mul(ONE, a) = a
axiom fieldInverse: forall a: Field; a != ZERO -> mul(a, recip(a)) = ONE
axiom oneNotZero: ONE != ZERO

// the ring structure is a commutative ring.
model RingIsField {
  ring.Ring: Field
  ring.ZERO: ZERO
  ring.ONE: ONE
  ring.add: add
  ring.mul: mul
  ring.neg: neg
  ring.addIsAssociative <- addIsAssociative
  ring.addZeroLeft <- addZeroLeft
  ring.addNegLeft <- addNegLeft
  ring.addIsCommutative <- addIsCommutative
  ring.mulIsAssociative <- mulIsAssociative
  ring.mulAddDistribLeft <- mulAddDistribLeft
  ring.mulAddDistribRight <- mulAddDistribRight
}

// -- unit + reciprocal laws (derived) ---------------------------------------

// a·1 = a. Commute, then the left unit.
theorem mulOneRight: forall a: Field; mul(a, ONE) = a
proof
  @generalize-a |
    fix a: Field {
      @commute |
        mul(a, ONE) = mul(ONE, a)
        [using specialize mulIsCommutative(a, ONE)]
      @one-left |
        mul(ONE, a) = a
        [using specialize mulOneLeft(a)]
      @conclusion-at-a |
        mul(a, ONE) = a
        [using chain commute one-left]
    }
  @conclusion |
    forall a: Field; mul(a, ONE) = a
    [by forall_intro generalize-a]
qed

// mul(a, ZERO) = ZERO — transferred through the ring model (also the model
// smoke test). Used by noZeroDivisors below.
theorem mulZeroRight: forall a: Field; mul(a, ZERO) = ZERO
proof
  @conclusion |
    forall a: Field; mul(a, ZERO) = ZERO
    [using model(RingIsField) ring.mulZeroRight]
qed

// -- ring-lemma shims for the `polynomial(field)` accelerant -----------------
// `polynomial(field)` resolves its ring vocabulary by BARE name in field's scope.
// These lemmas exist in the ring theory but only as `ring.<name>` (qualified) —
// importing ring never puts a bare name in scope. So surface them here: the
// zero/inverse folds transfer through RingIsField, the two sort-swaps are derived
// from associativity + commutativity (mul commutes only in a field, so the swaps
// live here, not in the non-commutative ring theory).

theorem mulZeroLeft: forall a: Field; mul(ZERO, a) = ZERO
proof
  @conclusion |
    forall a: Field; mul(ZERO, a) = ZERO
    [using model(RingIsField) ring.mulZeroLeft]
qed

theorem addZeroRight: forall a: Field; add(a, ZERO) = a
proof
  @conclusion |
    forall a: Field; add(a, ZERO) = a
    [using model(RingIsField) ring.addZeroRight]
qed

theorem addNegRight: forall a: Field; add(a, neg(a)) = ZERO
proof
  @conclusion |
    forall a: Field; add(a, neg(a)) = ZERO
    [using model(RingIsField) ring.addNegRight]
qed

// mul left-swap: a·(b·c) = b·(a·c). The mul-AC sorting primitive the accelerant
// needs. Regroup left (associativity), commute the outer pair, regroup right.
theorem mulLeftSwap: forall x, y, r: Field; mul(x, mul(y, r)) = mul(y, mul(x, r))
proof
  @generalize-x |
    fix x: Field {
      @generalize-y |
        fix y: Field {
          @generalize-r |
            fix r: Field {
              @associate-x-y |
                mul(mul(x, y), r) = mul(x, mul(y, r))
                [using specialize mulIsAssociative(x, y, r)]
              @regroup-to-left |
                mul(x, mul(y, r)) = mul(mul(x, y), r)
                [by symmetry associate-x-y]
              @commute-x-y |
                mul(x, y) = mul(y, x)
                [using specialize mulIsCommutative(x, y)]
              @swap-factors |
                mul(x, mul(y, r)) = mul(mul(y, x), r)
                [by rewrite commute-x-y regroup-to-left]
              @associate-y-x |
                mul(mul(y, x), r) = mul(y, mul(x, r))
                [using specialize mulIsAssociative(y, x, r)]
              @conclusion-swap |
                mul(x, mul(y, r)) = mul(y, mul(x, r))
                [using chain swap-factors associate-y-x]
            }
          @discharge-r |
            forall r: Field; mul(x, mul(y, r)) = mul(y, mul(x, r))
            [by forall_intro generalize-r]
        }
      @discharge-y |
        forall y, r: Field; mul(x, mul(y, r)) = mul(y, mul(x, r))
        [by forall_intro generalize-y]
    }
  @conclusion |
    forall x, y, r: Field; mul(x, mul(y, r)) = mul(y, mul(x, r))
    [by forall_intro generalize-x]
qed

// add left-swap: the additive mirror of mulLeftSwap.
theorem addLeftSwap: forall x, y, r: Field; add(x, add(y, r)) = add(y, add(x, r))
proof
  @generalize-x |
    fix x: Field {
      @generalize-y |
        fix y: Field {
          @generalize-r |
            fix r: Field {
              @associate-x-y |
                add(add(x, y), r) = add(x, add(y, r))
                [using specialize addIsAssociative(x, y, r)]
              @regroup-to-left |
                add(x, add(y, r)) = add(add(x, y), r)
                [by symmetry associate-x-y]
              @commute-x-y |
                add(x, y) = add(y, x)
                [using specialize addIsCommutative(x, y)]
              @swap-factors |
                add(x, add(y, r)) = add(add(y, x), r)
                [by rewrite commute-x-y regroup-to-left]
              @associate-y-x |
                add(add(y, x), r) = add(y, add(x, r))
                [using specialize addIsAssociative(y, x, r)]
              @conclusion-swap |
                add(x, add(y, r)) = add(y, add(x, r))
                [using chain swap-factors associate-y-x]
            }
          @discharge-r |
            forall r: Field; add(x, add(y, r)) = add(y, add(x, r))
            [by forall_intro generalize-r]
        }
      @discharge-y |
        forall y, r: Field; add(x, add(y, r)) = add(y, add(x, r))
        [by forall_intro generalize-y]
    }
  @conclusion |
    forall x, y, r: Field; add(x, add(y, r)) = add(y, add(x, r))
    [by forall_intro generalize-x]
qed

// -- neg-distribution folds for `polynomial(field)` on SIGNED expressions -----
// So the accelerant can push `neg` toward the leaves (neg over sum/product/neg/
// zero). mulNeg*/negZero transfer through RingIsField; negNeg is the additive
// involution; negAdd is the abelian inverse-of-a-sum, derived here.

// neg(ZERO) = ZERO: ZERO+ZERO = ZERO, so ZERO is its own additive inverse.
theorem negZero: neg(ZERO) = ZERO
proof
  @zero-plus-zero |
    add(ZERO, ZERO) = ZERO
    [using specialize addZeroLeft(ZERO)]
  @inverse-unique |
    forall x, y: Field; add(x, y) = ZERO -> y = neg(x)
    [using model(RingIsField) ring.additiveInverseUnique]
  @zero-is-neg-zero |
    ZERO = neg(ZERO)
    [using specialize inverse-unique(ZERO, ZERO) zero-plus-zero]
  @conclusion |
    neg(ZERO) = ZERO
    [by symmetry zero-is-neg-zero]
qed

// neg(neg a) = a: a is a right additive inverse of neg(a) (neg(a)+a = 0), so
// a = neg(neg a) by inverse-uniqueness.
theorem negNeg: forall a: Field; neg(neg(a)) = a
proof
  @generalize-a |
    fix a: Field {
      @neg-plus-a |
        add(neg(a), a) = ZERO
        [using specialize addNegLeft(a)]
      @inverse-unique |
        forall x, y: Field; add(x, y) = ZERO -> y = neg(x)
        [using model(RingIsField) ring.additiveInverseUnique]
      @a-is-neg-neg |
        a = neg(neg(a))
        [using specialize inverse-unique(neg(a), a) neg-plus-a]
      @conclusion-neg-neg |
        neg(neg(a)) = a
        [by symmetry a-is-neg-neg]
    }
  @conclusion |
    forall a: Field; neg(neg(a)) = a
    [by forall_intro generalize-a]
qed

theorem mulNegLeft: forall a, b: Field; mul(neg(a), b) = neg(mul(a, b))
proof
  @conclusion |
    forall a, b: Field; mul(neg(a), b) = neg(mul(a, b))
    [using model(RingIsField) ring.mulNegLeft]
qed

theorem mulNegRight: forall a, b: Field; mul(a, neg(b)) = neg(mul(a, b))
proof
  @conclusion |
    forall a, b: Field; mul(a, neg(b)) = neg(mul(a, b))
    [using model(RingIsField) ring.mulNegRight]
qed

theorem negMulNeg: forall a, b: Field; mul(neg(a), neg(b)) = mul(a, b)
proof
  @conclusion |
    forall a, b: Field; mul(neg(a), neg(b)) = mul(a, b)
    [using model(RingIsField) ring.negMulNeg]
qed

// neg(a+b) = neg(a)+neg(b): neg(a)+neg(b) is a right additive inverse of a+b
// ((a+b)+(neg a+neg b) = 0 by AC), so it equals neg(a+b) by inverse-uniqueness.
theorem negAdd: forall a, b: Field; neg(add(a, b)) = add(neg(a), neg(b))
proof
  @generalize-a |
    fix a: Field {
      @generalize-b |
        fix b: Field {
          @sum-cancels |
            add(add(a, b), add(neg(a), neg(b))) = ZERO
            [using polynomial]
          @inverse-unique |
            forall x, y: Field; add(x, y) = ZERO -> y = neg(x)
            [using model(RingIsField) ring.additiveInverseUnique]
          @neg-sum-is-sum-of-negs |
            add(neg(a), neg(b)) = neg(add(a, b))
            [using specialize inverse-unique(add(a, b), add(neg(a), neg(b))) sum-cancels]
          @conclusion-neg-add |
            neg(add(a, b)) = add(neg(a), neg(b))
            [by symmetry neg-sum-is-sum-of-negs]
        }
      @discharge-b |
        forall b: Field; neg(add(a, b)) = add(neg(a), neg(b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Field; neg(add(a, b)) = add(neg(a), neg(b))
    [by forall_intro generalize-a]
qed

// recip(a)·a = 1 for a ≠ 0 (the right-inverse axiom commuted).
theorem recipMulLeft: forall a: Field; a != ZERO -> mul(recip(a), a) = ONE
proof
  @generalize-a |
    fix a: Field {
      @given-a-nonzero |
        assume a != ZERO {
          @a-nonzero |
            a != ZERO
            [by hypothesis given-a-nonzero]
          @right-inverse |
            mul(a, recip(a)) = ONE
            [using specialize fieldInverse(a) a-nonzero]
          @commute |
            mul(recip(a), a) = mul(a, recip(a))
            [using specialize mulIsCommutative(recip(a), a)]
          @left-inverse |
            mul(recip(a), a) = ONE
            [using chain commute right-inverse]
        }
      @discharge |
        a != ZERO -> mul(recip(a), a) = ONE
        [by implies_intro given-a-nonzero]
    }
  @conclusion |
    forall a: Field; a != ZERO -> mul(recip(a), a) = ONE
    [by forall_intro generalize-a]
qed

// -- no zero divisors -------------------------------------------------------

// a·b = 0 → a = 0 or b = 0. If a ≠ 0, multiply by recip(a): b = 1·b =
// (recip(a)·a)·b = recip(a)·(a·b) = recip(a)·0 = 0.
theorem noZeroDivisors: forall a, b: Field; mul(a, b) = ZERO -> (a = ZERO or b = ZERO)
proof
  @generalize-a |
    fix a: Field {
      @generalize-b |
        fix b: Field {
          @given-product-zero |
            assume mul(a, b) = ZERO {
              @product-zero |
                mul(a, b) = ZERO
                [by hypothesis given-product-zero]
              @a-zero-or-not |
                a = ZERO or a != ZERO
                [using tautology]
              @conclusion-cases |
                a = ZERO or b = ZERO
                case a-zero-or-not {
                  @when-a-zero |
                    assume a = ZERO {
                      @a-is-zero |
                        a = ZERO
                        [by hypothesis when-a-zero]
                      @conclusion-a-zero |
                        a = ZERO or b = ZERO
                        [by or_intro_left a-is-zero]
                    }
                  @when-a-nonzero |
                    assume a != ZERO {
                      @a-nonzero |
                        a != ZERO
                        [by hypothesis when-a-nonzero]
                      @recip-a-left |
                        mul(recip(a), a) = ONE
                        [using specialize recipMulLeft(a) a-nonzero]
                      // b = 1·b = (recip(a)·a)·b = recip(a)·(a·b) = recip(a)·0 = 0
                      @one-times-b |
                        mul(ONE, b) = b
                        [using specialize mulOneLeft(b)]
                      @regroup |
                        mul(mul(recip(a), a), b) = mul(recip(a), mul(a, b))
                        [using specialize mulIsAssociative(recip(a), a, b)]
                      @recip-times-zero |
                        mul(recip(a), ZERO) = ZERO
                        [using specialize mulZeroRight(recip(a))]
                      // chain: b = 1·b, 1 = recip(a)·a so 1·b = (recip a·a)·b,
                      // regroup to recip(a)·(a·b), a·b = 0, recip(a)·0 = 0.
                      @b-is-zero |
                        b = ZERO
                        [using chain one-times-b recip-a-left regroup product-zero recip-times-zero]
                      @conclusion-b-zero |
                        a = ZERO or b = ZERO
                        [by or_intro_right b-is-zero]
                    }
                }
            }
          @discharge |
            mul(a, b) = ZERO -> (a = ZERO or b = ZERO)
            [by implies_intro given-product-zero]
        }
      @discharge-b |
        forall b: Field; mul(a, b) = ZERO -> (a = ZERO or b = ZERO)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Field; mul(a, b) = ZERO -> (a = ZERO or b = ZERO)
    [by forall_intro generalize-a]
qed

// ============================================================================
// THEORY OF FIELDS — what the sub-theories under std/field/ prove.
//
// std/field/order.b4m is the ORDERED field: this same theory plus a total strict
// order compatible with the operations. Its `less_than` is POSTULATED (there is
// no successor structure to build it from), so it is a genuinely larger theory
// with its own sort — the forwards below name it rather than re-export facts
// about `Field`, which has no order of its own. ℚ and ℝ are ordered fields; ℂ
// is not.
// ============================================================================

import ordered <<< "std/field/order.b4m"

sort OrderedField = ordered.OrderedField
pred orderedLessThan = ordered.less_than
theorem orderedNoZeroDivisors = ordered.noZeroDivisors
theorem orderedZeroLessThanOne = ordered.zeroLessThanOne
