// std/rational.bpa — the RATIONAL NUMBERS ℚ as an axiomatic ordered field, with a
// ring embedding ℤ ↪ ℚ (`fromInt`). ℚ is the prime ordered field: it models
// std/field-order.bpa (inheriting the whole field + ordered-field corpus) and adds
// the embedding of the integers as a ring homomorphism, so integer facts reach ℚ.
//
// This is the FIRST concrete number sort in the ℚ/ℝ/ℂ tower. Following the
// architecture, ℚ is INDEPENDENT (not constructed as fractions of ℤ — bpa has no
// quotient/pair sorts) and hosts an algebra model (RationalOrderedField, cited for
// its field/order theorems) plus a homomorphism (fromInt) linking it to ℤ.

import field <<< "std/field.bpa"
import field_order <<< "std/field-order.bpa"
import integer <<< "std/integer.bpa"

sort Q
const ZERO: Q
const ONE: Q
func add(a: Q, b: Q): Q
func mul(a: Q, b: Q): Q
func neg(a: Q): Q
func recip(a: Q): Q
pred less_than(a: Q, b: Q)

// -- ordered-field axioms (discharge the ordered-field model below) ----------
axiom addAssoc: forall a, b, c: Q; add(add(a, b), c) = add(a, add(b, c))
axiom addZeroLeft: forall a: Q; add(ZERO, a) = a
axiom addNegLeft: forall a: Q; add(neg(a), a) = ZERO
axiom addCommutative: forall a, b: Q; add(a, b) = add(b, a)
axiom mulAssoc: forall a, b, c: Q; mul(mul(a, b), c) = mul(a, mul(b, c))
axiom mulDistributesLeftOverAdd: forall a, b, c: Q; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
axiom mulDistributesRightOverAdd: forall a, b, c: Q; mul(add(a, b), c) = add(mul(a, c), mul(b, c))
axiom mulCommutative: forall a, b: Q; mul(a, b) = mul(b, a)
axiom mulOneLeft: forall a: Q; mul(ONE, a) = a
axiom fieldInverse: forall a: Q; a != ZERO -> mul(a, recip(a)) = ONE
axiom oneNotZero: ONE != ZERO
axiom lessThanIrreflexive: forall a: Q; not less_than(a, a)
axiom lessThanTransitive: forall a, b, c: Q; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
axiom lessThanTrichotomy: forall a, b: Q; less_than(a, b) or a = b or less_than(b, a)
axiom lessThanAddRight: forall a, b, c: Q; less_than(a, b) -> less_than(add(a, c), add(b, c))
axiom lessThanAddCancel: forall a, b, c: Q; less_than(add(a, c), add(b, c)) -> less_than(a, b)
axiom positiveProduct: forall a, b: Q; less_than(ZERO, a) -> less_than(ZERO, b) -> less_than(ZERO, mul(a, b))

// ℚ is an ordered field: its ALGEBRA model (cited for field/order theorems).
model RationalOrderedField {
  field_order.OrderedField: Q
  field_order.ZERO: ZERO
  field_order.ONE: ONE
  field_order.add: add
  field_order.mul: mul
  field_order.neg: neg
  field_order.recip: recip
  field_order.less_than: less_than
  field_order.addAssoc <- addAssoc
  field_order.addZeroLeft <- addZeroLeft
  field_order.addNegLeft <- addNegLeft
  field_order.addCommutative <- addCommutative
  field_order.mulAssoc <- mulAssoc
  field_order.mulDistributesLeftOverAdd <- mulDistributesLeftOverAdd
  field_order.mulDistributesRightOverAdd <- mulDistributesRightOverAdd
  field_order.mulCommutative <- mulCommutative
  field_order.mulOneLeft <- mulOneLeft
  field_order.fieldInverse <- fieldInverse
  field_order.oneNotZero <- oneNotZero
  field_order.lessThanIrreflexive <- lessThanIrreflexive
  field_order.lessThanTransitive <- lessThanTransitive
  field_order.lessThanTrichotomy <- lessThanTrichotomy
  field_order.lessThanAddRight <- lessThanAddRight
  field_order.lessThanAddCancel <- lessThanAddCancel
  field_order.positiveProduct <- positiveProduct
}

// -- the integer embedding ℤ ↪ ℚ -------------------------------------------
// fromInt is a ring homomorphism carrying ℤ's 0/1/+/×/neg to ℚ's, and is
// injective (distinct integers map to distinct rationals). This is how integer
// arithmetic facts reach ℚ.
func fromInt(n: integer.Int): Q
axiom fromIntZero: fromInt(integer.ZERO) = ZERO
axiom fromIntOne: fromInt(integer.ONE) = ONE
axiom fromIntAdd: forall m, n: integer.Int; fromInt(integer.add(m, n)) = add(fromInt(m), fromInt(n))
axiom fromIntMul: forall m, n: integer.Int; fromInt(integer.mul(m, n)) = mul(fromInt(m), fromInt(n))
axiom fromIntNeg: forall n: integer.Int; fromInt(integer.neg(n)) = neg(fromInt(n))
axiom fromIntInjective: forall m, n: integer.Int; fromInt(m) = fromInt(n) -> m = n

// -- derived --------------------------------------------------------------

// smoke test (algebra model): no zero divisors, transferred from the field theory
// through the ordered-field model.
theorem noZeroDivisors: forall a, b: Q; mul(a, b) = ZERO -> (a = ZERO or b = ZERO)
proof
  @conclusion |
    forall a, b: Q; mul(a, b) = ZERO -> (a = ZERO or b = ZERO)
    [by model(RationalOrderedField) field_order.noZeroDivisors]
qed

// a nonzero integer embeds to a nonzero (hence invertible) rational. fromInt is
// injective and sends ZERO to ZERO, so n != 0 in ℤ gives fromInt(n) != 0 in ℚ.
theorem fromIntNonzero: forall n: integer.Int; n != integer.ZERO -> fromInt(n) != ZERO
proof
  @generalize-n |
    fix n: integer.Int {
      @given-n-nonzero |
        assume n != integer.ZERO {
          @n-nonzero |
            n != integer.ZERO
            [by hypothesis given-n-nonzero]
          @given-image-zero |
            assume fromInt(n) = ZERO {
              @image-zero |
                fromInt(n) = ZERO
                [by hypothesis given-image-zero]
              @zero-image |
                fromInt(integer.ZERO) = ZERO
                [by axiom fromIntZero]
              // fromInt(n) = ZERO = fromInt(ZERO), so by injectivity n = ZERO.
              @images-equal |
                fromInt(n) = fromInt(integer.ZERO)
                [by chain image-zero zero-image]
              @n-is-zero |
                n = integer.ZERO
                [by specialize fromIntInjective(n, integer.ZERO) images-equal]
            }
          @not-image-zero |
            fromInt(n) != ZERO
            [by not_intro given-image-zero n-is-zero n-nonzero]
        }
      @discharge |
        n != integer.ZERO -> fromInt(n) != ZERO
        [by implies_intro given-n-nonzero]
    }
  @conclusion |
    forall n: integer.Int; n != integer.ZERO -> fromInt(n) != ZERO
    [by forall_intro generalize-n]
qed
