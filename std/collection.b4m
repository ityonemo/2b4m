// std/collection.b4m — COLLECTIONS: sets of sets, one level up from std/set.b4m.
//
// A `Collection` is a set whose elements are `Set`s. Structurally it is the SAME
// theory as std/set.b4m with the element sort shifted up by one: `contains(s, c)` is
// `member` one level up. So the entire set algebra (extensionality + the 19
// identities) TRANSFERS onto collections for free by MODELING std/set.b4m with
// `set.Element -> Set`, `set.Set -> Collection`. (The remap is a single pass, so the
// two-sort shift lifts each level by one without cascade; nesting further —
// collections of collections — composes the same way.)
//
// On top of that transferred algebra we add the CROSS-LEVEL operations the set
// theory does not have (they relate the two levels): `bigUnion(c)` — the union of
// all sets in a collection, a `Set` — and `bigIntersection(c)`; plus a `universe`
// set and the pairwise-disjoint / covering predicates a PARTITION needs.

import set <<< "std/set.b4m"

sort Element = set.Element
sort Set = set.Set
pred member = set.member

// ── the collection level: a `Collection` mirrors `Set`, one level up ─────────
sort Collection
const emptyCollection: Collection
pred contains(s: Set, c: Collection)
func unionCollection(a: Collection, b: Collection) => Collection
func intersectionCollection(a: Collection, b: Collection) => Collection
func differenceCollection(a: Collection, b: Collection) => Collection
func complementCollection(a: Collection) => Collection

// the membership axioms for the collection level — mirror set.b4m's, over `Set`s.
// These are exactly what set's operator axioms remap to under the model below, so
// the model discharges them and the set corpus transfers.
axiom unionCollectionContains: forall a, b: Collection; forall s: Set;
  contains(s, unionCollection(a, b)) iff (contains(s, a) or contains(s, b))
axiom intersectionCollectionContains: forall a, b: Collection; forall s: Set;
  contains(s, intersectionCollection(a, b)) iff (contains(s, a) and contains(s, b))
axiom differenceCollectionContains: forall a, b: Collection; forall s: Set;
  contains(s, differenceCollection(a, b)) iff (contains(s, a) and (not contains(s, b)))
axiom complementCollectionContains: forall a: Collection; forall s: Set;
  contains(s, complementCollection(a)) iff (not contains(s, a))
axiom emptyCollectionContains: forall s: Set; not contains(s, emptyCollection)
axiom collectionExtensionality: forall a, b: Collection;
  (forall s: Set; contains(s, a) -> contains(s, b)) ->
  (forall s: Set; contains(s, b) -> contains(s, a)) ->
  a = b

// ── the collection IS a set (of sets): model std/set.b4m one level up ────────
model CollectionIsSet {
  set.Element: Set
  set.Set: Collection
  set.member: contains
  set.emptyset: emptyCollection
  set.union: unionCollection
  set.intersection: intersectionCollection
  set.difference: differenceCollection
  set.complement: complementCollection
  set.unionMember <- unionCollectionContains
  set.intersectionMember <- intersectionCollectionContains
  set.differenceMember <- differenceCollectionContains
  set.complementMember <- complementCollectionContains
  set.emptysetMember <- emptyCollectionContains
  set.extensionality <- collectionExtensionality
}

// the set algebra, transferred onto collections (a representative sample — the full
// std/set.b4m corpus is available the same way, each one line).
theorem collectionUnionCommutative: forall a, b: Collection; unionCollection(a, b) = unionCollection(b, a)
proof
  @conclusion |
    forall a, b: Collection; unionCollection(a, b) = unionCollection(b, a)
    [using model(CollectionIsSet) set.unionCommutative]
qed

theorem collectionUnionAssociative: forall a, b, c: Collection;
  unionCollection(a, unionCollection(b, c)) = unionCollection(unionCollection(a, b), c)
proof
  @conclusion |
    forall a, b, c: Collection;
      unionCollection(a, unionCollection(b, c)) = unionCollection(unionCollection(a, b), c)
    [using model(CollectionIsSet) set.unionAssociative]
qed

theorem collectionDeMorgan: forall a, b: Collection;
  complementCollection(unionCollection(a, b)) = intersectionCollection(complementCollection(a), complementCollection(b))
proof
  @conclusion |
    forall a, b: Collection;
      complementCollection(unionCollection(a, b)) = intersectionCollection(complementCollection(a), complementCollection(b))
    [using model(CollectionIsSet) set.deMorganUnion]
qed

// ── CROSS-LEVEL operations: collapse a collection to a set ───────────────────
// bigUnion(c) — the union of every set in the collection: x ∈ ⋃c iff x is in some
// member set of c. bigIntersection(c) — x ∈ ⋂c iff x is in EVERY member of c.
func bigUnion(c: Collection) => Set
axiom bigUnionMember: forall c: Collection; forall x: Element;
  member(x, bigUnion(c)) iff (exists s: Set; contains(s, c) and member(x, s))

func bigIntersection(c: Collection) => Set
axiom bigIntersectionMember: forall c: Collection; forall x: Element;
  member(x, bigIntersection(c)) iff (forall s: Set; contains(s, c) -> member(x, s))

// the universe: the set every element belongs to (the whole space of elements).
const universe: Set
axiom universeMember: forall x: Element; member(x, universe)

// ── partition apparatus (the payoff Gap 1 unlocks) ───────────────────────────
// `covers(c)` — the collection's sets cover the universe: ⋃c = universe.
define covers(c) = bigUnion(c) = universe

// `pairwiseDisjoint(c)` — distinct member sets share no element (their pairwise
// intersection is empty).
define pairwiseDisjoint(c) = (forall s, t: Set; contains(s, c) -> contains(t, c) -> s != t -> set.intersection(s, t) = set.emptyset)

// `isPartition(c)` — a partition: covers the universe, pairwise-disjoint, and no
// member is empty.
define isPartition(c) = (covers(c) and pairwiseDisjoint(c) and (forall s: Set; contains(s, c) -> s != set.emptyset))
