// std/cyclic.bpa — the CYCLIC SUBGROUP ⟨a⟩ generated by an element.
//
// For a fixed generator A of a group, ⟨A⟩ = { A^k : k ∈ ℤ } is the set of all integer
// powers of A (std/group-power.bpa supplies `power` over ℤ exponents and its laws).
// This file proves Judson's two foundational cyclic facts (AATA §4.1):
//   • ⟨A⟩ is a subgroup of the group (contains E, closed under product and inverse),
//     and is the SMALLEST subgroup containing A;
//   • every cyclic group is abelian.
// bpa cannot quantify over group elements as a predicate index, so the generator is a
// file-level const `A` (the same device subgroup.bpa uses for its fixed subgroup H); a
// concrete cyclic subgroup instantiates A.

import group_power <<< "std/group-power.bpa"
import integer <<< "std/integer.bpa"

sort Grp = group_power.Grp
const E = group_power.E
func op = group_power.op
func inverse = group_power.inverse
func power = group_power.power

sort Int = group_power.Int
const ZERO = group_power.ZERO
func succ = group_power.succ
func prev = group_power.prev
func add = group_power.add
func neg = group_power.neg

// the fixed generator and its cyclic subgroup: g ∈ ⟨A⟩ iff g is an integer power of A.
const A: Grp
define inGenerated(g: Grp) = exists k: Int; g = power(A, k)

// an ARBITRARY subgroup H of the same group, characterized by the subgroup criterion
// (identity + closure under product and inverse), used to state ⟨A⟩'s minimality. It
// is a local predicate over the SAME `Grp` (rather than importing std/subgroup.bpa,
// whose abstract parent group is a distinct sort) so `containingSubgroup(A^k)` typechecks.
pred containingSubgroup(g: Grp)
axiom containingHasIdentity: containingSubgroup(E)
axiom containingClosedOp: forall a, b: Grp; containingSubgroup(a) -> containingSubgroup(b) -> containingSubgroup(op(a, b))
axiom containingClosedInverse: forall a: Grp; containingSubgroup(a) -> containingSubgroup(inverse(a))

// -- ⟨A⟩ is a subgroup: identity, closure under product, closure under inverse ------

// e ∈ ⟨A⟩, witnessed by A^0 = e.
theorem generatedHasIdentity: inGenerated(E)
proof
  @power-zero |
    power(A, ZERO) = E
    [by specialize group_power.powerZero(A)]
  @e-is-power |
    E = power(A, ZERO)
    [by symmetry power-zero]
  @conclusion |
    inGenerated(E)
    [by exists_intro(ZERO) e-is-power]
qed

// ⟨A⟩ is closed under the operation: A^m · A^n = A^(m+n) ∈ ⟨A⟩.
theorem generatedClosedOp: forall g, h: Grp; inGenerated(g) -> inGenerated(h) -> inGenerated(op(g, h))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-h |
        fix h: Grp {
          @given-g-in |
            assume inGenerated(g) {
              @given-h-in |
                assume inGenerated(h) {
                  @g-is-power |
                    exists k: Int; g = power(A, k)
                    [by hypothesis given-g-in]
                  @h-is-power |
                    exists k: Int; h = power(A, k)
                    [by hypothesis given-h-in]
                  @with-g-exponent |
                    unpack m: Int from g-is-power {
                      @g-power-m |
                        g = power(A, m)
                        [by hypothesis with-g-exponent]
                      @with-h-exponent |
                        unpack n: Int from h-is-power {
                          @h-power-n |
                            h = power(A, n)
                            [by hypothesis with-h-exponent]
                          // A^m · A^n = A^(m+n).
                          @power-add |
                            op(power(A, m), power(A, n)) = power(A, add(m, n))
                            [by specialize group_power.powerAdd(A, m, n)]
                          @product-reflexive |
                            op(g, h) = op(g, h)
                            [by reflexivity]
                          @product-with-m |
                            op(g, h) = op(power(A, m), h)
                            [by rewrite g-power-m product-reflexive]
                          @product-as-powers |
                            op(g, h) = op(power(A, m), power(A, n))
                            [by rewrite h-power-n product-with-m]
                          @product-is-power |
                            op(g, h) = power(A, add(m, n))
                            [by chain product-as-powers power-add]
                          @conclusion-in |
                            inGenerated(op(g, h))
                            [by exists_intro(add(m, n)) product-is-power]
                        }
                      @conclusion-with-g |
                        inGenerated(op(g, h))
                        [by exists_elim with-h-exponent]
                    }
                  @conclusion-op-in |
                    inGenerated(op(g, h))
                    [by exists_elim with-g-exponent]
                }
              @h-implies |
                inGenerated(h) -> inGenerated(op(g, h))
                [by implies_intro given-h-in]
            }
          @g-implies |
            inGenerated(g) -> inGenerated(h) -> inGenerated(op(g, h))
            [by implies_intro given-g-in]
        }
      @discharge-h |
        forall h: Grp; inGenerated(g) -> inGenerated(h) -> inGenerated(op(g, h))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Grp; inGenerated(g) -> inGenerated(h) -> inGenerated(op(g, h))
    [by forall_intro generalize-g]
qed

// ⟨A⟩ is closed under inverses: (A^k)⁻¹ = A^(−k) ∈ ⟨A⟩.
theorem generatedClosedInverse: forall g: Grp; inGenerated(g) -> inGenerated(inverse(g))
proof
  @generalize-g |
    fix g: Grp {
      @given-g-in |
        assume inGenerated(g) {
          @g-is-power |
            exists k: Int; g = power(A, k)
            [by hypothesis given-g-in]
          @with-exponent |
            unpack k: Int from g-is-power {
              @g-power-k |
                g = power(A, k)
                [by hypothesis with-exponent]
              // (A^k)⁻¹ = A^(−k).
              @inverse-is-neg-power |
                power(A, neg(k)) = inverse(power(A, k))
                [by specialize group_power.powerNegInverse(A, k)]
              @inverse-reflexive |
                inverse(g) = inverse(g)
                [by reflexivity]
              @inverse-of-g |
                inverse(g) = inverse(power(A, k))
                [by rewrite g-power-k inverse-reflexive]
              @inverse-as-power |
                inverse(g) = power(A, neg(k))
                [by rewrite inverse-is-neg-power inverse-of-g]
              @conclusion-in |
                inGenerated(inverse(g))
                [by exists_intro(neg(k)) inverse-as-power]
            }
          @conclusion-with |
            inGenerated(inverse(g))
            [by exists_elim with-exponent]
        }
      @g-implies |
        inGenerated(g) -> inGenerated(inverse(g))
        [by implies_intro given-g-in]
    }
  @conclusion |
    forall g: Grp; inGenerated(g) -> inGenerated(inverse(g))
    [by forall_intro generalize-g]
qed

// -- ⟨A⟩ is the SMALLEST subgroup containing A -------------------------------
// Any subgroup H that contains A contains every power of A — so ⟨A⟩ ⊆ H. We take H
// as containingSubgroup and, assuming A ∈ H, prove containingSubgroup(A^k) for all k ∈ ℤ by
// bidirectional integer induction: A^0 = e ∈ H; A^(k+1) = A^k·A ∈ H (closure with A);
// A^(k−1) = A^k·A⁻¹ ∈ H (closure with A⁻¹).
theorem generatedIsSmallest: containingSubgroup(A) -> forall k: Int; containingSubgroup(power(A, k))
proof
  @given-a-in-subgroup |
    assume containingSubgroup(A) {
      @a-in-subgroup |
        containingSubgroup(A)
        [by hypothesis given-a-in-subgroup]
      @a-inverse-in-subgroup |
        containingSubgroup(inverse(A))
        [by specialize containingClosedInverse(A) a-in-subgroup]

      // base case: A^0 = e ∈ H.
      @power-zero |
        power(A, ZERO) = E
        [by specialize group_power.powerZero(A)]
      @identity-in-subgroup |
        containingSubgroup(E)
        [by axiom containingHasIdentity]
      @base-case |
        containingSubgroup(power(A, ZERO))
        [by rewrite power-zero identity-in-subgroup]

      // reusable recursion facts.
      @power-at-successor |
        forall a: Grp; forall n: Int; power(a, succ(n)) = op(power(a, n), a)
        [by axiom group_power.powerSucc]
      @power-at-predecessor |
        forall a: Grp; forall n: Int; power(a, prev(n)) = op(power(a, n), inverse(a))
        [by axiom group_power.powerPrev]

      // successor step: A^k ∈ H ⟹ A^(succ k) = A^k·A ∈ H.
      @successor-step |
        fix k: Int {
          @given-ih-succ |
            assume containingSubgroup(power(A, k)) {
              @ih-succ |
                containingSubgroup(power(A, k))
                [by hypothesis given-ih-succ]
              @succ-unfolds |
                power(A, succ(k)) = op(power(A, k), A)
                [by forall_elim(A, k) power-at-successor]
              @product-in-subgroup |
                containingSubgroup(op(power(A, k), A))
                [by specialize containingClosedOp(power(A, k), A) ih-succ a-in-subgroup]
              @conclusion-succ |
                containingSubgroup(power(A, succ(k)))
                [by rewrite succ-unfolds product-in-subgroup]
            }
          @ih-implies-succ |
            containingSubgroup(power(A, k)) -> containingSubgroup(power(A, succ(k)))
            [by implies_intro given-ih-succ]
        }
      @successor-step-all-k |
        forall k: Int; containingSubgroup(power(A, k)) -> containingSubgroup(power(A, succ(k)))
        [by forall_intro successor-step]

      // predecessor step: A^k ∈ H ⟹ A^(prev k) = A^k·A⁻¹ ∈ H.
      @predecessor-step |
        fix k: Int {
          @given-ih-prev |
            assume containingSubgroup(power(A, k)) {
              @ih-prev |
                containingSubgroup(power(A, k))
                [by hypothesis given-ih-prev]
              @prev-unfolds |
                power(A, prev(k)) = op(power(A, k), inverse(A))
                [by forall_elim(A, k) power-at-predecessor]
              @product-in-subgroup |
                containingSubgroup(op(power(A, k), inverse(A)))
                [by specialize containingClosedOp(power(A, k), inverse(A)) ih-prev a-inverse-in-subgroup]
              @conclusion-prev |
                containingSubgroup(power(A, prev(k)))
                [by rewrite prev-unfolds product-in-subgroup]
            }
          @ih-implies-prev |
            containingSubgroup(power(A, k)) -> containingSubgroup(power(A, prev(k)))
            [by implies_intro given-ih-prev]
        }
      @predecessor-step-all-k |
        forall k: Int; containingSubgroup(power(A, k)) -> containingSubgroup(power(A, prev(k)))
        [by forall_intro predecessor-step]

      @all-powers-in-subgroup |
        forall k: Int; containingSubgroup(power(A, k))
        [by instantiate integer.induction((fun k: Int => containingSubgroup(power(A, k)))) base-case successor-step-all-k predecessor-step-all-k]
    }
  @conclusion |
    containingSubgroup(A) -> forall k: Int; containingSubgroup(power(A, k))
    [by implies_intro given-a-in-subgroup]
qed

// -- every cyclic group is abelian -------------------------------------------
// For g = A^m and h = A^n in ⟨A⟩: g·h = A^m·A^n = A^(m+n) = A^(n+m) = A^n·A^m = h·g,
// using powerAdd (both orientations) and commutativity of integer addition.
theorem generatedIsAbelian: forall g, h: Grp; inGenerated(g) -> inGenerated(h) -> op(g, h) = op(h, g)
proof
  @generalize-g |
    fix g: Grp {
      @generalize-h |
        fix h: Grp {
          @given-g-in |
            assume inGenerated(g) {
              @given-h-in |
                assume inGenerated(h) {
                  @g-is-power |
                    exists k: Int; g = power(A, k)
                    [by hypothesis given-g-in]
                  @h-is-power |
                    exists k: Int; h = power(A, k)
                    [by hypothesis given-h-in]
                  @with-g-exponent |
                    unpack m: Int from g-is-power {
                      @g-power-m |
                        g = power(A, m)
                        [by hypothesis with-g-exponent]
                      @with-h-exponent |
                        unpack n: Int from h-is-power {
                          @h-power-n |
                            h = power(A, n)
                            [by hypothesis with-h-exponent]
                          // g·h = A^m·A^n = A^(m+n).
                          @gh-powers |
                            op(power(A, m), power(A, n)) = power(A, add(m, n))
                            [by specialize group_power.powerAdd(A, m, n)]
                          // h·g = A^n·A^m = A^(n+m).
                          @hg-powers |
                            op(power(A, n), power(A, m)) = power(A, add(n, m))
                            [by specialize group_power.powerAdd(A, n, m)]
                          // exponents commute: m+n = n+m.
                          @exponents-commute |
                            add(m, n) = add(n, m)
                            [by specialize integer.addIsCommutative(m, n)]
                          @reflexivity-power |
                            power(A, add(m, n)) = power(A, add(m, n))
                            [by reflexivity]
                          @same-power |
                            power(A, add(m, n)) = power(A, add(n, m))
                            [by rewrite exponents-commute reflexivity-power]
                          // chain: A^m·A^n = A^(m+n) = A^(n+m) = A^n·A^m.
                          @hg-flipped |
                            power(A, add(n, m)) = op(power(A, n), power(A, m))
                            [by symmetry hg-powers]
                          @powers-equal |
                            op(power(A, m), power(A, n)) = op(power(A, n), power(A, m))
                            [by chain gh-powers same-power hg-flipped]
                          // fold g, h back in.
                          @with-g |
                            op(g, power(A, n)) = op(power(A, n), power(A, m))
                            [by rewrite g-power-m powers-equal]
                          @with-both-left |
                            op(g, h) = op(power(A, n), power(A, m))
                            [by rewrite h-power-n with-g]
                          @with-h-right |
                            op(g, h) = op(h, power(A, m))
                            [by rewrite h-power-n with-both-left]
                          @conclusion-commute |
                            op(g, h) = op(h, g)
                            [by rewrite g-power-m with-h-right]
                        }
                      @conclusion-with-g |
                        op(g, h) = op(h, g)
                        [by exists_elim with-h-exponent]
                    }
                  @conclusion-commute-outer |
                    op(g, h) = op(h, g)
                    [by exists_elim with-g-exponent]
                }
              @h-implies |
                inGenerated(h) -> op(g, h) = op(h, g)
                [by implies_intro given-h-in]
            }
          @g-implies |
            inGenerated(g) -> inGenerated(h) -> op(g, h) = op(h, g)
            [by implies_intro given-g-in]
        }
      @discharge-h |
        forall h: Grp; inGenerated(g) -> inGenerated(h) -> op(g, h) = op(h, g)
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Grp; inGenerated(g) -> inGenerated(h) -> op(g, h) = op(h, g)
    [by forall_intro generalize-g]
qed
