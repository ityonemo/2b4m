// Worked examples for `std/sequence.bpa`'s reification-existence axioms.
//
// Why this file exists: `Seq` is otherwise observe-only — `at` and `foldUpTo` READ a
// sequence but nothing constructs one. The four existence axioms are the constructors,
// stated for callers (a factorization builds a singleton, an index map builds a
// concatenation). Nothing in `sequence.bpa` itself builds on them, so nothing exercises
// them, and an axiom no derivation ever touches is one whose binders and guards have
// never been checked. Each theorem below UNPACKS a constructed witness and derives the
// smallest consequence that needs the clause it names.
import sequence <<< "std/sequence.bpa"
import peano <<< "std/peano.bpa"
import ordering <<< "std/peano.bpa"

sort Nat = peano.Nat
sort Seq = sequence.Seq
sort Value = sequence.Value
const ZERO = peano.ZERO
const IDENTITY = sequence.IDENTITY
func succ = peano.succ
func add = peano.add
func at = sequence.at
func combine = sequence.combine
func foldUpTo = sequence.foldUpTo
pred less_than = ordering.less_than

axiom seqSingletonExists = sequence.seqSingletonExists
axiom seqPrependExists = sequence.seqPrependExists
axiom seqConcatExists = sequence.seqConcatExists
axiom seqRemoveExists = sequence.seqRemoveExists
axiom foldZero = sequence.foldZero
theorem foldOneCombinesIdentity = sequence.foldOneCombinesIdentity

// -- the singleton constructor ----------------------------------------------

// [x] exists with first entry x, so SOME sequence has a length-one fold that combines
// the identity with its own head: the singleton clause meeting the fold-structure
// theorem. This is the shape a factorization proof uses to start an induction.
theorem someSequenceFoldsToItsHead: forall x: Value; exists s: Seq; foldUpTo(s, succ(ZERO)) = combine(IDENTITY, at(s, ZERO)) and at(s, ZERO) = x
proof
  @generalize-x |
    fix x: Value {
      @singleton-exists |
        exists s: Seq; at(s, ZERO) = x and foldUpTo(s, succ(ZERO)) = x
        [using specialize seqSingletonExists(x)]
      @with-singleton-s |
        unpack s: Seq from singleton-exists {
          @singleton-clauses |
            at(s, ZERO) = x and foldUpTo(s, succ(ZERO)) = x
            [by hypothesis with-singleton-s]
          @head-is-x |
            at(s, ZERO) = x
            [by and_elim_left singleton-clauses]
          @fold-combines-identity |
            foldUpTo(s, succ(ZERO)) = combine(IDENTITY, at(s, ZERO))
            [using specialize foldOneCombinesIdentity(s)]
          @both-clauses |
            foldUpTo(s, succ(ZERO)) = combine(IDENTITY, at(s, ZERO)) and at(s, ZERO) = x
            [by and_intro fold-combines-identity head-is-x]
          @conclusion-some-sequence |
            exists u: Seq; foldUpTo(u, succ(ZERO)) = combine(IDENTITY, at(u, ZERO)) and at(u, ZERO) = x
            [by exists_intro(s) both-clauses]
        }
      @conclusion-for-x |
        exists u: Seq; foldUpTo(u, succ(ZERO)) = combine(IDENTITY, at(u, ZERO)) and at(u, ZERO) = x
        [by exists_elim with-singleton-s]
    }
  @conclusion |
    forall x: Value; exists s: Seq; foldUpTo(s, succ(ZERO)) = combine(IDENTITY, at(s, ZERO)) and at(s, ZERO) = x
    [by forall_intro generalize-x]
qed

// -- the prepend constructor -------------------------------------------------

// x :: s puts x at the head and shifts s up by one, so the prepended sequence agrees
// with s at every shifted index — in particular at index 1, which reads s's index 0.
theorem prependShiftsTheTail: forall x: Value; forall s: Seq; exists u: Seq; at(u, ZERO) = x and at(u, succ(ZERO)) = at(s, ZERO)
proof
  @generalize-x |
    fix x: Value {
      @generalize-s |
        fix s: Seq {
          @prepend-exists |
            exists u: Seq; at(u, ZERO) = x and (forall i: Nat; at(u, succ(i)) = at(s, i))
            [using specialize seqPrependExists(x, s)]
          @with-prepended-u |
            unpack u: Seq from prepend-exists {
              @prepend-clauses |
                at(u, ZERO) = x and (forall i: Nat; at(u, succ(i)) = at(s, i))
                [by hypothesis with-prepended-u]
              @head-is-x |
                at(u, ZERO) = x
                [by and_elim_left prepend-clauses]
              @tail-agrees-everywhere |
                forall i: Nat; at(u, succ(i)) = at(s, i)
                [by and_elim_right prepend-clauses]
              @tail-agrees-at-zero |
                at(u, succ(ZERO)) = at(s, ZERO)
                [by forall_elim(ZERO) tail-agrees-everywhere]
              @both-clauses |
                at(u, ZERO) = x and at(u, succ(ZERO)) = at(s, ZERO)
                [by and_intro head-is-x tail-agrees-at-zero]
              @conclusion-some-prepend |
                exists v: Seq; at(v, ZERO) = x and at(v, succ(ZERO)) = at(s, ZERO)
                [by exists_intro(u) both-clauses]
            }
          @conclusion-for-s |
            exists v: Seq; at(v, ZERO) = x and at(v, succ(ZERO)) = at(s, ZERO)
            [by exists_elim with-prepended-u]
        }
      @discharge-s |
        forall s: Seq; exists v: Seq; at(v, ZERO) = x and at(v, succ(ZERO)) = at(s, ZERO)
        [by forall_intro generalize-s]
    }
  @conclusion |
    forall x: Value; forall s: Seq; exists u: Seq; at(u, ZERO) = x and at(u, succ(ZERO)) = at(s, ZERO)
    [by forall_intro generalize-x]
qed

// -- the concatenation constructor -------------------------------------------

// Concatenating nothing onto nothing: at j = k = 0 the fold clause says the result's
// length-zero fold is the combine of two length-zero folds — both IDENTITY. The
// degenerate case is the one that checks the fold clause's arithmetic.
theorem emptyConcatFoldsToIdentityCombine: forall s: Seq; forall t: Seq; exists u: Seq; foldUpTo(u, add(ZERO, ZERO)) = combine(IDENTITY, IDENTITY)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-t |
        fix t: Seq {
          @concat-exists |
            exists u: Seq;
              (forall i: Nat; less_than(i, ZERO) -> at(u, i) = at(s, i))
              and (forall i: Nat; less_than(i, ZERO) -> at(u, add(ZERO, i)) = at(t, i))
              and foldUpTo(u, add(ZERO, ZERO)) = combine(foldUpTo(s, ZERO), foldUpTo(t, ZERO))
            [using specialize seqConcatExists(s, t, ZERO, ZERO)]
          @with-concatenated-u |
            unpack u: Seq from concat-exists {
              @concat-clauses |
                (forall i: Nat; less_than(i, ZERO) -> at(u, i) = at(s, i))
                  and (forall i: Nat; less_than(i, ZERO) -> at(u, add(ZERO, i)) = at(t, i))
                  and foldUpTo(u, add(ZERO, ZERO)) = combine(foldUpTo(s, ZERO), foldUpTo(t, ZERO))
                [by hypothesis with-concatenated-u]
              @fold-clause |
                foldUpTo(u, add(ZERO, ZERO)) = combine(foldUpTo(s, ZERO), foldUpTo(t, ZERO))
                [by and_elim_right concat-clauses]
              @s-folds-to-identity |
                foldUpTo(s, ZERO) = IDENTITY
                [using specialize foldZero(s)]
              @t-folds-to-identity |
                foldUpTo(t, ZERO) = IDENTITY
                [using specialize foldZero(t)]
              @fold-with-s-unfolded |
                foldUpTo(u, add(ZERO, ZERO)) = combine(IDENTITY, foldUpTo(t, ZERO))
                [by rewrite s-folds-to-identity fold-clause]
              @fold-is-identity-combine |
                foldUpTo(u, add(ZERO, ZERO)) = combine(IDENTITY, IDENTITY)
                [by rewrite t-folds-to-identity fold-with-s-unfolded]
              @conclusion-some-concat |
                exists v: Seq; foldUpTo(v, add(ZERO, ZERO)) = combine(IDENTITY, IDENTITY)
                [by exists_intro(u) fold-is-identity-combine]
            }
          @conclusion-for-t |
            exists v: Seq; foldUpTo(v, add(ZERO, ZERO)) = combine(IDENTITY, IDENTITY)
            [by exists_elim with-concatenated-u]
        }
      @discharge-t |
        forall t: Seq; exists u: Seq; foldUpTo(u, add(ZERO, ZERO)) = combine(IDENTITY, IDENTITY)
        [by forall_intro generalize-t]
    }
  @conclusion |
    forall s: Seq; forall t: Seq; exists u: Seq; foldUpTo(u, add(ZERO, ZERO)) = combine(IDENTITY, IDENTITY)
    [by forall_intro generalize-s]
qed

// -- the removal constructor -------------------------------------------------

// Deleting the sole entry of a length-one prefix: with k = 0 and m = 0 the guard
// `m < succ k` holds, and the fold clause says combining the empty fold with the removed
// entry recovers the length-one fold. Unfolding the empty fold gives the entry back.
theorem removingTheOnlyEntryLeavesIdentity: forall s: Seq; less_than(ZERO, succ(ZERO)) -> exists t: Seq; combine(IDENTITY, at(s, ZERO)) = foldUpTo(s, succ(ZERO))
proof
  @generalize-s |
    fix s: Seq {
      @given-zero-below-one |
        assume less_than(ZERO, succ(ZERO)) {
          @zero-below-one |
            less_than(ZERO, succ(ZERO))
            [by hypothesis given-zero-below-one]
          @remove-exists |
            exists t: Seq;
              combine(foldUpTo(t, ZERO), at(s, ZERO)) = foldUpTo(s, succ(ZERO))
              and (forall i: Nat; less_than(i, ZERO) -> at(t, i) = at(s, i))
              and (forall i: Nat; sequence.at_most(ZERO, i) -> less_than(i, ZERO) -> at(t, i) = at(s, succ(i)))
            [using specialize seqRemoveExists(s, ZERO, ZERO) zero-below-one]
          @with-shortened-t |
            unpack t: Seq from remove-exists {
              @remove-clauses |
                combine(foldUpTo(t, ZERO), at(s, ZERO)) = foldUpTo(s, succ(ZERO))
                  and (forall i: Nat; less_than(i, ZERO) -> at(t, i) = at(s, i))
                  and (forall i: Nat; sequence.at_most(ZERO, i) -> less_than(i, ZERO) -> at(t, i) = at(s, succ(i)))
                [by hypothesis with-shortened-t]
              @first-two-clauses |
                combine(foldUpTo(t, ZERO), at(s, ZERO)) = foldUpTo(s, succ(ZERO))
                  and (forall i: Nat; less_than(i, ZERO) -> at(t, i) = at(s, i))
                [by and_elim_left remove-clauses]
              @fold-recovers-original |
                combine(foldUpTo(t, ZERO), at(s, ZERO)) = foldUpTo(s, succ(ZERO))
                [by and_elim_left first-two-clauses]
              @shortened-folds-to-identity |
                foldUpTo(t, ZERO) = IDENTITY
                [using specialize foldZero(t)]
              @identity-combine-recovers-original |
                combine(IDENTITY, at(s, ZERO)) = foldUpTo(s, succ(ZERO))
                [by rewrite shortened-folds-to-identity fold-recovers-original]
              @conclusion-some-removal |
                exists u: Seq; combine(IDENTITY, at(s, ZERO)) = foldUpTo(s, succ(ZERO))
                [by exists_intro(t) identity-combine-recovers-original]
            }
          @conclusion-guarded |
            exists u: Seq; combine(IDENTITY, at(s, ZERO)) = foldUpTo(s, succ(ZERO))
            [by exists_elim with-shortened-t]
        }
      @conclusion-implies |
        less_than(ZERO, succ(ZERO)) -> exists t: Seq; combine(IDENTITY, at(s, ZERO)) = foldUpTo(s, succ(ZERO))
        [by implies_intro given-zero-below-one]
    }
  @conclusion |
    forall s: Seq; less_than(ZERO, succ(ZERO)) -> exists t: Seq; combine(IDENTITY, at(s, ZERO)) = foldUpTo(s, succ(ZERO))
    [by forall_intro generalize-s]
qed
