// std/real/polynomial.b4m — ℝ[x], as a model of F[x].
//
// ℝ is a field (`std/real.b4m`'s `RealField`), so every theorem `std/field/polynomial.b4m`
// proves about F[x] is a theorem about ℝ[x]. This file declares ℝ[x]'s own symbols and the
// model that connects them; the corpus then transfers rather than being restated.
//
// WHAT A POLYNOMIAL LAYER OWES. A model must map every symbol a transferred proof mentions,
// and discharge every axiom it reaches — including the axioms of theories BELOW F[x], since
// F[x]'s own theorems are often one-line transfers from `std/ring/polynomial.b4m` and a
// re-transfer re-elaborates those proofs. That is why the block below names the field-level
// algebra facts (`addZeroLeftF`, `mulAddDistribLeftF`, …) and not only the polynomial ones.
// Omitting one does not report an undischarged axiom; it surfaces as a sort mismatch inside
// whichever source file the re-elaboration lands in. See
// `PAINPOINTS.md`.
theory real <<< "std/real.b4m"
theory fieldpoly <<< "std/field/polynomial.b4m"
theory ring <<< "std/ring.b4m"
theory ring_poly <<< "std/ring/polynomial.b4m"
theory peano <<< "std/peano.b4m"

sort Real = real.Real
sort Nat = peano.Nat
const ZERO = real.ZERO
const NAT_ZERO = peano.ZERO

// -- ℝ[x] ----------------------------------------------------------------------------------
sort RPoly
oper rcoeff(p: RPoly, i: Nat) => Real
const RZEROP: RPoly
oper raddP(p: RPoly, q: RPoly) => RPoly:
  rcoeff(raddP(p, q), i) = real.add(rcoeff(p, i), rcoeff(q, i)).
  existence: aRaddPExists,
  uniqueness: rPolyExtensionality
oper rnegP(p: RPoly) => RPoly:
  rcoeff(rnegP(p), i) = real.neg(rcoeff(p, i)).
  existence: aRnegPExists,
  uniqueness: rPolyExtensionality
oper rmulP(p: RPoly, q: RPoly) => RPoly:
  rcoeff(rmulP(p, q), i) = rconvolution(p, q, NAT_ZERO, i).
  existence: aRmulPExists,
  uniqueness: rPolyExtensionality
oper rmonomial(a: Real, k: Nat) => RPoly:
  rcoeff(rmonomial(a, k), k) = a;
  (not (i = k)) -> rcoeff(rmonomial(a, k), i) = ZERO.
  existence: aRmonomialExists,
  uniqueness: rPolyExtensionality
pred rdegreeAtMost(p: RPoly, n: Nat)
oper rdegree(p: RPoly) => Nat
// Descends by `peano.prev` on the SECOND index rather than matching `succ` on the left:
// the l-value rule requires a recursive definition's l-value arguments to be parameters
// or closed terms, so the descent must be readable on the RIGHT. The arm's own
// `m != NAT_ZERO` discharges `prev`'s guard. `m` descends while `j` ascends; termination
// asks only about the descent.
oper rconvolution(p: RPoly, q: RPoly, j: Nat, m: Nat) => Real:
  rconvolution(p, q, j, NAT_ZERO) = real.mul(rcoeff(p, j), rcoeff(q, NAT_ZERO));
  rconvolution(p, q, j, m) = real.add(real.mul(rcoeff(p, j), rcoeff(q, m)), rconvolution(p, q, peano.succ(j), peano.prev(m))) when m != NAT_ZERO.
  termination(peano): _, {rConvolutionIsGrounded, rconvolutionGrounded}

// the coefficient equations: ℝ[x]'s own primitives
axiom rPolyExtensionality: forall p, q: RPoly;
  (forall i: Nat; rcoeff(p, i) = rcoeff(q, i)) -> p = q

axiom aRaddPExists: forall p: RPoly; forall q: RPoly;
  exists r: RPoly; forall i: Nat; (rcoeff(r, i) = real.add(rcoeff(p, i), rcoeff(q, i)))
axiom aRnegPExists: forall p: RPoly;
  exists r: RPoly; forall i: Nat; (rcoeff(r, i) = real.neg(rcoeff(p, i)))
axiom aRmulPExists: forall p: RPoly; forall q: RPoly;
  exists r: RPoly; forall i: Nat; (rcoeff(r, i) = rconvolution(p, q, NAT_ZERO, i))
axiom aRmonomialExists: forall a: Real; forall k: Nat;
  exists r: RPoly; ((rcoeff(r, k) = a)) and (forall i: Nat; ((not (i = k)) -> rcoeff(r, i) = ZERO))
axiom rZeroPolyCoeff: forall i: Nat; rcoeff(RZEROP, i) = ZERO
axiom rDegreeAtMostMeaning: forall p: RPoly; forall n: Nat;
  rdegreeAtMost(p, n) iff
  (forall i: Nat; peano.less_than(n, i) -> rcoeff(p, i) = ZERO)
axiom rDegreeIsALeadingIndex: forall p: RPoly;
  (not (p = RZEROP)) -> (not (rcoeff(p, rdegree(p)) = ZERO))
axiom rDegreeBoundsTheCoefficients: forall p: RPoly;
  (not (p = RZEROP)) -> rdegreeAtMost(p, rdegree(p))

// the convolution, reindexed as F[x] states it: a BASE and a LENGTH whose sum is invariant,
// so no index is ever subtracted.

// -- evaluation ----------------------------------------------------------------------------
// The recursion descends by `peano.prev` rather than matching `peano.succ` on the left: the
// l-value rule requires a recursive definition to keep patterns off its left side, so the
// descent is readable on the RIGHT where the termination check can see it. `prev` is
// guarded (`requires n != ZERO`), and the arm's own condition discharges it.
oper rpower(a: Real, n: Nat) => Real:
  rpower(a, NAT_ZERO) = real.ONE;
  rpower(a, n) = real.mul(a, rpower(a, peano.prev(n))) when n != NAT_ZERO.
  termination(peano): _, {rpowerIsGrounded, rpowerGrounded}

oper revalUpTo(p: RPoly, a: Real, k: Nat) => Real:
  revalUpTo(p, a, NAT_ZERO) = ZERO;
  revalUpTo(p, a, peano.succ(k)) = real.add(revalUpTo(p, a, k), real.mul(rcoeff(p, k), rpower(a, k))).

// `p(a)`: the sum over every index up to AND INCLUDING the degree.
define revaluate(p, a) = revalUpTo(p, a, peano.succ(rdegree(p)))

pred rIsZeroOf(a: Real, p: RPoly)
axiom rIsZeroOfMeaning: forall a: Real; forall p: RPoly;
  rIsZeroOf(a, p) iff revaluate(p, a) = ZERO

// -- the run families a transferred proof mentions -----------------------------------------
// F[x] declares these because `std/ring/polynomial.b4m`'s proofs induct on them (the sum
// reversal behind commutativity, the triple sums behind associativity). A model must map
// every symbol a transferred proof names, so ℝ[x] declares them too. None involves a
// subtraction: each decrementing index is a `succ` pattern, and the index arithmetic the
// triple sums need is NAMED (`rmonus`, `rtheCofactorIndex`).
// The recursion descends by `prev` on the FIRST index rather than matching `succ` on the
// left, which the l-value rule requires of a recursive definition — every l-value argument
// must be a parameter or a closed term, so the descent has to be readable on the RIGHT.
// `peano.prev` is guarded (`requires n != ZERO`) and the arm's own `j != NAT_ZERO` discharges it.
//
// Mirror of `rconvolution`: there the second index descends and the first ascends, here the
// first descends and the second ascends. Termination asks only about the DESCENDING index.
oper rtailConvolution(p: RPoly, q: RPoly, j: Nat, m: Nat) => Real:
  rtailConvolution(p, q, NAT_ZERO, m) = real.mul(rcoeff(p, NAT_ZERO), rcoeff(q, m));
  rtailConvolution(p, q, j, m) = real.add(real.mul(rcoeff(p, j), rcoeff(q, m)), rtailConvolution(p, q, peano.prev(j), peano.succ(m))) when j != NAT_ZERO.
  termination(peano): _, {rTailConvolutionIsGrounded, rtailConvolutionGrounded}

oper rsegmentOf(p: RPoly, q: RPoly, j: Nat, c: Nat, n: Nat) => Real:
  rsegmentOf(p, q, j, c, NAT_ZERO) = real.mul(rcoeff(p, j), rcoeff(q, c));
  rsegmentOf(p, q, peano.succ(j), c, peano.succ(n)) = real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, c)), rsegmentOf(p, q, j, peano.succ(c), n)).

oper rrsegmentOf(p: RPoly, q: RPoly, j: Nat, c: Nat, n: Nat) => Real:
  rrsegmentOf(p, q, j, c, NAT_ZERO) = real.mul(rcoeff(p, j), rcoeff(q, c));
  rrsegmentOf(p, q, j, peano.succ(c), peano.succ(n)) = real.add(real.mul(rcoeff(p, j), rcoeff(q, peano.succ(c))), rrsegmentOf(p, q, peano.succ(j), c, n)).

oper rmonus(i: Nat, j: Nat) => Nat:
  rmonus(i, NAT_ZERO) = i;
  rmonus(i, j) = rmonus(peano.prev(i), peano.prev(j)) when i != NAT_ZERO and j != NAT_ZERO;
  rmonus(NAT_ZERO, j) = NAT_ZERO when j != NAT_ZERO.
  termination(peano): _, {rmonusIsGrounded, rmonusGrounded}, _

oper rtheCofactorIndex(i: Nat, j: Nat, k: Nat) => Nat:
  rtheCofactorIndex(i, j, NAT_ZERO) = rmonus(i, j);
  rtheCofactorIndex(i, j, peano.succ(k)) = rmonus(rmonus(i, j), peano.succ(k)).

oper rcappedRun(q: RPoly, r: RPoly, g: Nat, n: Nat) => Real:
  rcappedRun(q, r, g, NAT_ZERO) = ZERO;
  rcappedRun(q, r, g, peano.succ(n)) = real.add(rcappedRun(q, r, g, n), real.mul(rcoeff(q, n), rcoeff(r, rmonus(g, n)))).

oper rtripleTerm(p: RPoly, q: RPoly, r: RPoly, i: Nat, j: Nat, k: Nat) => Real:
  rtripleTerm(p, q, r, i, j, k) = real.mul(real.mul(rcoeff(p, j), rcoeff(q, k)), rcoeff(r, rtheCofactorIndex(i, j, k))).

oper rtripleRow(p: RPoly, q: RPoly, r: RPoly, i: Nat, j: Nat, n: Nat) => Real:
  rtripleRow(p, q, r, i, j, NAT_ZERO) = ZERO;
  rtripleRow(p, q, r, i, j, peano.succ(n)) = real.add(rtripleRow(p, q, r, i, j, n), rtripleTerm(p, q, r, i, j, n)).

oper rtripleDiag(p: RPoly, q: RPoly, r: RPoly, i: Nat, m: Nat, c: Nat) => Real:
  rtripleDiag(p, q, r, i, m, NAT_ZERO) = ZERO;
  rtripleDiag(p, q, r, i, m, peano.succ(c)) = real.add(rtripleDiag(p, q, r, i, m, c), rtripleTerm(p, q, r, i, c, rmonus(m, c))).

oper rtripleTri(p: RPoly, q: RPoly, r: RPoly, i: Nat, n: Nat) => Real:
  rtripleTri(p, q, r, i, NAT_ZERO) = ZERO;
  rtripleTri(p, q, r, i, peano.succ(n)) = real.add(rtripleTri(p, q, r, i, n), rtripleDiag(p, q, r, i, n, peano.succ(n))).

oper rtripleRows(p: RPoly, q: RPoly, r: RPoly, i: Nat, m: Nat, n: Nat) => Real:
  rtripleRows(p, q, r, i, NAT_ZERO, n) = ZERO;
  rtripleRows(p, q, r, i, peano.succ(m), n) = real.add(rtripleRows(p, q, r, i, m, n), rtripleRow(p, q, r, i, m, rmonus(n, m))).

// The unit polynomial, as its OWN constant with its own coefficient axioms — the shape
// `ring_poly.ONEP` maps onto. F[x] instead derives it from `monomial(oneF, ZERO)`, which
// makes its unit a defined expression; a model target must be a SYMBOL, so ℝ[x] declares the
// constant directly, exactly as ℚ[x] does.
const RONEP: RPoly
axiom rOnePolyCoeffZero: rcoeff(RONEP, NAT_ZERO) = real.ONE
axiom rOnePolyCoeffHigher: forall i: Nat;
  rcoeff(RONEP, peano.succ(i)) = ZERO

// What this file proves (verified manifest):
intheory rOneIsTheUnitMonomial
intheory rMulIsCommutative
intheory rMulIsAssociative
intheory rAddIsCommutative
intheory rAddIsAssociative
intheory rMulOneLeft
intheory rAddPolyCoeff
intheory rNegPolyCoeff
intheory rMulPolyCoeff
intheory rMonomialCoeffAtItsIndex
intheory rMonomialCoeffElsewhere
intheory rConvolutionZero
intheory rConvolutionSucc
intheory rConvolutionReachesZeroFromAPredecessor
intheory rConvolutionIsGrounded
intheory rpowerReachesABaseFromAPredecessor
intheory rpowerIsGrounded
intheory rPowerZero
intheory rPowerSucc
intheory rEvalZero
intheory rEvalSucc
intheory rTailConvolutionZero
intheory rTailConvolutionSucc
intheory rTailConvolutionReachesZeroFromAPredecessor
intheory rTailConvolutionIsGrounded
intheory rSegmentZero
intheory rSegmentSucc
intheory rRsegmentZero
intheory rRsegmentSucc
intheory rmonusAtZero
intheory rmonusSteps
intheory rmonusReachesABaseFromAPredecessor
intheory rmonusIsGrounded
intheory rTheCofactorIndexAtZero
intheory rTheCofactorIndexSteps
intheory rCappedRunZero
intheory rCappedRunSucc
intheory rTripleTermMeaning
intheory rTripleRowZero
intheory rTripleRowSucc
intheory rTripleDiagZero
intheory rTripleDiagSucc
intheory rTripleTriZero
intheory rTripleTriSucc
intheory rTripleRowsZero
intheory rTripleRowsSucc

// RONEP IS the unit monomial: both have ONE at index 0 and vanish elsewhere, so
// extensionality identifies them. This is what the model owes for mapping F[x]'s
// `monomialOne` onto ℝ[x]'s own constant.
theorem rOneIsTheUnitMonomial: RONEP = rmonomial(real.ONE, NAT_ZERO)
proof
  @the-coefficients-agree |
    fix i: Nat {
      @the-case-split |
        i = NAT_ZERO or (exists w: Nat; i = peano.succ(w))
        [using specialize peano.zeroOrSucc(i)]
      @when-zero |
        assume i = NAT_ZERO {
          @i-is-zero |
            i = NAT_ZERO
            [by hypothesis when-zero]
          @the-unit-at-zero |
            rcoeff(RONEP, NAT_ZERO) = real.ONE
            [by cite rOnePolyCoeffZero]
          @the-monomial-at-zero |
            rcoeff(rmonomial(real.ONE, NAT_ZERO), NAT_ZERO) = real.ONE
            [using specialize rMonomialCoeffAtItsIndex(real.ONE, NAT_ZERO)]
          @agree-at-zero |
            rcoeff(RONEP, NAT_ZERO) =
              rcoeff(rmonomial(real.ONE, NAT_ZERO), NAT_ZERO)
            [using simplify the-unit-at-zero the-monomial-at-zero]
          @conclusion-zero |
            rcoeff(RONEP, i) = rcoeff(rmonomial(real.ONE, NAT_ZERO), i)
            [by rewrite i-is-zero agree-at-zero]
        }
      @when-positive |
        assume exists w: Nat; i = peano.succ(w) {
          @the-predecessor-exists |
            exists w: Nat; i = peano.succ(w)
            [by hypothesis when-positive]
          @with-the-predecessor |
            unpack w: Nat from the-predecessor-exists {
              @i-steps |
                i = peano.succ(w)
                [by hypothesis with-the-predecessor]
              @the-unit-above |
                rcoeff(RONEP, peano.succ(w)) = ZERO
                [using specialize rOnePolyCoeffHigher(w)]
              @the-index-differs |
                not (peano.succ(w) = NAT_ZERO)
                [using specialize peano.succNotZero(w)]
              @the-monomial-above |
                rcoeff(rmonomial(real.ONE, NAT_ZERO), peano.succ(w)) = ZERO
                [using specialize rMonomialCoeffElsewhere(real.ONE,
                  NAT_ZERO, peano.succ(w)) the-index-differs]
              @agree-above |
                rcoeff(RONEP, peano.succ(w)) =
                  rcoeff(rmonomial(real.ONE, NAT_ZERO), peano.succ(w))
                [using simplify the-unit-above the-monomial-above]
              @conclusion-positive |
                rcoeff(RONEP, i) =
                  rcoeff(rmonomial(real.ONE, NAT_ZERO), i)
                [by rewrite i-steps agree-above]
            }
          @conclusion-the-positive-case |
            rcoeff(RONEP, i) = rcoeff(rmonomial(real.ONE, NAT_ZERO), i)
            [by unpacked with-the-predecessor]
        }
      @conclusion-at-i |
        rcoeff(RONEP, i) = rcoeff(rmonomial(real.ONE, NAT_ZERO), i)
        [by common_conclusion the-case-split when-zero when-positive]
    }
  @all-coefficients-agree |
    forall i: Nat;
      rcoeff(RONEP, i) = rcoeff(rmonomial(real.ONE, NAT_ZERO), i)
    [by generalize the-coefficients-agree]
  @conclusion |
    RONEP = rmonomial(real.ONE, NAT_ZERO)
    [using specialize rPolyExtensionality(RONEP,
      rmonomial(real.ONE, NAT_ZERO)) all-coefficients-agree]
qed

// -- F[x]'s corpus, transferred ------------------------------------------------------------
// The coefficient field AND the polynomial layer both travel.
model RealPolynomials {
  fieldpoly.F: Real
  fieldpoly.zeroF: ZERO
  fieldpoly.oneF: real.ONE
  fieldpoly.addF: real.add
  fieldpoly.mulF: real.mul
  fieldpoly.negF: real.neg
  fieldpoly.recipF: real.recip
  fieldpoly.Poly: RPoly
  fieldpoly.coeff: rcoeff
  fieldpoly.ZEROP: RZEROP
  fieldpoly.addP: raddP
  fieldpoly.negP: rnegP
  fieldpoly.mulP: rmulP
  fieldpoly.monomial: rmonomial
  fieldpoly.degreeAtMost: rdegreeAtMost
  fieldpoly.degree: rdegree
  fieldpoly.convolution: rconvolution
  fieldpoly.power: rpower
  fieldpoly.evalUpTo: revalUpTo
  fieldpoly.isZeroOf: rIsZeroOf
  fieldpoly.tailConvolution: rtailConvolution
  fieldpoly.segment: rsegmentOf
  fieldpoly.rsegment: rrsegmentOf
  fieldpoly.monus: rmonus
  fieldpoly.theCofactorIndex: rtheCofactorIndex
  fieldpoly.cappedRun: rcappedRun
  fieldpoly.tripleTerm: rtripleTerm
  fieldpoly.tripleRow: rtripleRow
  fieldpoly.tripleDiag: rtripleDiag
  fieldpoly.tripleTri: rtripleTri
  fieldpoly.tripleRows: rtripleRows
  fieldpoly.monomialOne: RONEP
  fieldpoly.monomialOneIsTheUnitMonomial <- rOneIsTheUnitMonomial
  // the field-level algebra, which F[x]'s own transferred proofs reach
  fieldpoly.addIsAssociativeF <- real.addIsAssociative
  fieldpoly.addIsCommutativeF <- real.addIsCommutative
  fieldpoly.addZeroLeftF <- real.addZeroLeft
  fieldpoly.addNegLeftF <- real.addNegLeft
  fieldpoly.mulIsAssociativeF <- real.mulIsAssociative
  fieldpoly.mulIsCommutativeF <- real.mulIsCommutative
  fieldpoly.mulOneLeftF <- real.mulOneLeft
  fieldpoly.mulAddDistribLeftF <- real.mulAddDistribLeft
  fieldpoly.mulAddDistribRightF <- real.mulAddDistribRight
  // the polynomial layer
  fieldpoly.polyExtensionality <- rPolyExtensionality
  fieldpoly.zeroPolyCoeff <- rZeroPolyCoeff
  fieldpoly.addP <- raddP
  fieldpoly.negP <- rnegP
  fieldpoly.monomial <- rmonomial
  fieldpoly.degreeAtMostMeaning <- rDegreeAtMostMeaning
  fieldpoly.degreeIsALeadingIndex <- rDegreeIsALeadingIndex
  fieldpoly.degreeBoundsTheCoefficients <- rDegreeBoundsTheCoefficients
  fieldpoly.convolution <- rconvolution
  fieldpoly.mulP <- rmulP
  fieldpoly.power <- rpower
  fieldpoly.evalUpTo <- revalUpTo
  fieldpoly.isZeroOfMeaning <- rIsZeroOfMeaning
  fieldpoly.tailConvolution <- rtailConvolution
  fieldpoly.segment <- rsegmentOf
  fieldpoly.rsegment <- rrsegmentOf
  fieldpoly.monus <- rmonus
  fieldpoly.theCofactorIndex <- rtheCofactorIndex
  fieldpoly.cappedRun <- rcappedRun
  fieldpoly.tripleTerm <- rtripleTerm
  fieldpoly.tripleRow <- rtripleRow
  fieldpoly.tripleDiag <- rtripleDiag
  fieldpoly.tripleTri <- rtripleTri
  fieldpoly.tripleRows <- rtripleRows
}

// -- the transferred ring structure, named locally -----------------------------------------
// Callers should not have to re-open the model; these give ℝ[x]'s ring laws bare names.
theorem rMulIsCommutative: forall p, q: RPoly; rmulP(p, q) = rmulP(q, p)
proof
  @conclusion |
    forall p, q: RPoly; rmulP(p, q) = rmulP(q, p)
    [using model(RealPolynomials) fieldpoly.polyMulIsCommutative]
qed

theorem rMulIsAssociative: forall p, q, r: RPoly;
  rmulP(rmulP(p, q), r) = rmulP(p, rmulP(q, r))
proof
  @conclusion |
    forall p, q, r: RPoly; rmulP(rmulP(p, q), r) = rmulP(p, rmulP(q, r))
    [using model(RealPolynomials) fieldpoly.polyMulIsAssociative]
qed

theorem rAddIsCommutative: forall p, q: RPoly; raddP(p, q) = raddP(q, p)
proof
  @conclusion |
    forall p, q: RPoly; raddP(p, q) = raddP(q, p)
    [using model(RealPolynomials) fieldpoly.polyAddIsCommutative]
qed

theorem rAddIsAssociative: forall p, q, r: RPoly;
  raddP(raddP(p, q), r) = raddP(p, raddP(q, r))
proof
  @conclusion |
    forall p, q, r: RPoly; raddP(raddP(p, q), r) = raddP(p, raddP(q, r))
    [using model(RealPolynomials) fieldpoly.polyAddIsAssociative]
qed

// -- the ring layer, for the facts stated over `ring_poly.ONEP` ----------------------------
// `polyMulOneLeft` is stated in `std/ring/polynomial.b4m` over its own `ONEP`, which F[x]
// maps onto a DERIVED unit (`monomial(oneF, ZERO)`). Re-transferring through F[x] therefore
// re-elaborates a proof in F[x]'s names, which ℝ[x]'s model cannot re-point. ℚ[x] solved
// this the same way: map the ring layer DIRECTLY, where the unit is a plain constant.
model RealPolynomialsOverARing {
  ring.Ring: Real
  ring.ZERO: ZERO
  ring.ONE: real.ONE
  ring.add: real.add
  ring.mul: real.mul
  ring.neg: real.neg
  ring.addIsAssociative <- real.addIsAssociative
  ring.addZeroLeft <- real.addZeroLeft
  ring.addNegLeft <- real.addNegLeft
  ring.addIsCommutative <- real.addIsCommutative
  ring.mulIsAssociative <- real.mulIsAssociative
  ring.mulAddDistribLeft <- real.mulAddDistribLeft
  ring.mulAddDistribRight <- real.mulAddDistribRight
  ring_poly.mulOneLeftR <- real.mulOneLeft
  ring_poly.mulIsCommutativeR <- real.mulIsCommutative
  ring_poly.Nat: Nat
  ring_poly.ZERO: NAT_ZERO
  ring_poly.succ: peano.succ
  ring_poly.addN: peano.add
  ring_poly.less_than: peano.less_than
  ring_poly.Poly: RPoly
  ring_poly.coeff: rcoeff
  ring_poly.ZEROP: RZEROP
  ring_poly.ONEP: RONEP
  ring_poly.addP: raddP
  ring_poly.negP: rnegP
  ring_poly.mulP: rmulP
  ring_poly.convolution: rconvolution
  ring_poly.tailConvolution: rtailConvolution
  ring_poly.segment: rsegmentOf
  ring_poly.rsegment: rrsegmentOf
  ring_poly.degreeAtMost: rdegreeAtMost
  ring_poly.degree: rdegree
  ring_poly.polyExtensionality <- rPolyExtensionality
  ring_poly.zeroPolyCoeff <- rZeroPolyCoeff
  ring_poly.onePolyCoeffZero <- rOnePolyCoeffZero
  ring_poly.onePolyCoeffHigher <- rOnePolyCoeffHigher
  ring_poly.addP <- raddP
  ring_poly.negP <- rnegP
  ring_poly.degreeAtMostMeaning <- rDegreeAtMostMeaning
  ring_poly.degreeIsALeadingIndex <- rDegreeIsALeadingIndex
  ring_poly.degreeBoundsTheCoefficients <- rDegreeBoundsTheCoefficients
  ring_poly.convolution <- rconvolution
  ring_poly.tailConvolution <- rtailConvolution
  ring_poly.segment <- rsegmentOf
  ring_poly.rsegment <- rrsegmentOf
  ring_poly.mulP <- rmulP
}

theorem rMulOneLeft: forall p: RPoly; rmulP(RONEP, p) = p
proof
  @conclusion |
    forall p: RPoly; rmulP(RONEP, p) = p
    [using model(RealPolynomialsOverARing) ring_poly.polyMulOneLeft]
qed

// -- definition-clause shims ---------------------------------------------------------------
//
// The symbols above are DEFINITION BLOCKS, so `--axioms` reports their clauses as
// definitions rather than as assumptions to weigh. A clause has no user-facing name,
// though, and a model's `<-` and `specialize` both resolve BY NAME — so each clause keeps a
// one-line theorem under the name it had as an axiom. These add no assumption: every one is
// proved `[by definition(N) <symbol>]`.

theorem rAddPolyCoeff:
  forall p, q: RPoly; forall i: Nat;
  rcoeff(raddP(p, q), i) = real.add(rcoeff(p, i), rcoeff(q, i))
proof
  @conclusion |
    forall p, q: RPoly; forall i: Nat;
      rcoeff(raddP(p, q), i) = real.add(rcoeff(p, i), rcoeff(q, i))
    [by definition raddP]
qed

theorem rNegPolyCoeff:
  forall p: RPoly; forall i: Nat;
  rcoeff(rnegP(p), i) = real.neg(rcoeff(p, i))
proof
  @conclusion |
    forall p: RPoly; forall i: Nat;
      rcoeff(rnegP(p), i) = real.neg(rcoeff(p, i))
    [by definition rnegP]
qed

theorem rMulPolyCoeff:
  forall p, q: RPoly; forall i: Nat;
  rcoeff(rmulP(p, q), i) = rconvolution(p, q, NAT_ZERO, i)
proof
  @conclusion |
    forall p, q: RPoly; forall i: Nat;
      rcoeff(rmulP(p, q), i) = rconvolution(p, q, NAT_ZERO, i)
    [by definition rmulP]
qed

theorem rMonomialCoeffAtItsIndex:
  forall a: Real; forall k: Nat;
  rcoeff(rmonomial(a, k), k) = a
proof
  @conclusion |
    forall a: Real; forall k: Nat;
      rcoeff(rmonomial(a, k), k) = a
    [by definition(0) rmonomial]
qed

theorem rMonomialCoeffElsewhere:
  forall a: Real; forall k, i: Nat;
  (not (i = k)) -> rcoeff(rmonomial(a, k), i) = ZERO
proof
  @conclusion |
    forall a: Real; forall k, i: Nat;
      (not (i = k)) -> rcoeff(rmonomial(a, k), i) = ZERO
    [by definition(1) rmonomial]
qed

theorem rConvolutionZero:
  forall p, q: RPoly; forall j: Nat;
  rconvolution(p, q, j, NAT_ZERO) =
  real.mul(rcoeff(p, j), rcoeff(q, NAT_ZERO))
proof
  @conclusion |
    forall p, q: RPoly; forall j: Nat;
      rconvolution(p, q, j, NAT_ZERO) =
      real.mul(rcoeff(p, j), rcoeff(q, NAT_ZERO))
    [by definition(0) rconvolution]
qed

// DERIVED, not transcribed: the clause descends by `peano.prev`, so this restates it at a
// successor where `prevOfSucc` collapses the `prev`. The STATEMENT is unchanged, which keeps
// the clause's `m != NAT_ZERO` guard from reaching any call site.
theorem rConvolutionSucc:
  forall p, q: RPoly; forall j, m: Nat;
  rconvolution(p, q, j, peano.succ(m)) =
  real.add(real.mul(rcoeff(p, j), rcoeff(q, peano.succ(m))),
  rconvolution(p, q, peano.succ(j), m))
proof
  @the-recursive-clause |
    forall p2: RPoly; forall q2: RPoly; forall j2: Nat; forall m2: Nat;
      m2 != NAT_ZERO ->
      rconvolution(p2, q2, j2, m2) =
      real.add(real.mul(rcoeff(p2, j2), rcoeff(q2, m2)),
      rconvolution(p2, q2, peano.succ(j2), peano.prev(m2)))
    [by definition(1) rconvolution]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: RPoly {
      @generalize-q |
        fix q: RPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @succ-m-is-nonzero |
                    peano.succ(m) != NAT_ZERO
                    [using specialize a-successor-is-never-zero(m)]
                  @clause-at-the-successor |
                    rconvolution(p, q, j, peano.succ(m)) =
                      real.add(real.mul(rcoeff(p, j), rcoeff(q, peano.succ(m))),
                      rconvolution(p, q, peano.succ(j), peano.prev(peano.succ(m))))
                    [using specialize the-recursive-clause(p, q, j, peano.succ(m)) succ-m-is-nonzero]
                  @prev-of-succ-m |
                    peano.prev(peano.succ(m)) = m
                    [using specialize prev-undoes-succ(m)]
                  @conclusion-step-at-m |
                    rconvolution(p, q, j, peano.succ(m)) =
                      real.add(real.mul(rcoeff(p, j), rcoeff(q, peano.succ(m))),
                      rconvolution(p, q, peano.succ(j), m))
                    [by rewrite prev-of-succ-m clause-at-the-successor]
                }
              @discharge-m |
                forall m: Nat;
                  rconvolution(p, q, j, peano.succ(m)) =
                  real.add(real.mul(rcoeff(p, j), rcoeff(q, peano.succ(m))),
                  rconvolution(p, q, peano.succ(j), m))
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j, m: Nat;
              rconvolution(p, q, j, peano.succ(m)) =
              real.add(real.mul(rcoeff(p, j), rcoeff(q, peano.succ(m))),
              rconvolution(p, q, peano.succ(j), m))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: RPoly; forall j, m: Nat;
          rconvolution(p, q, j, peano.succ(m)) =
          real.add(real.mul(rcoeff(p, j), rcoeff(q, peano.succ(m))),
          rconvolution(p, q, peano.succ(j), m))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: RPoly; forall j, m: Nat;
      rconvolution(p, q, j, peano.succ(m)) =
      real.add(real.mul(rcoeff(p, j), rcoeff(q, peano.succ(m))),
      rconvolution(p, q, peano.succ(j), m))
    [by generalize generalize-p]
qed

theorem rPowerZero:
  forall a: Real; rpower(a, NAT_ZERO) = real.ONE
proof
  @conclusion |
    forall a: Real; rpower(a, NAT_ZERO) = real.ONE
    [by definition(0) rpower]
qed

// The successor step, now DERIVED rather than transcribed: the definition descends by `prev`,
// so this restates it at a successor, where `prevOfSucc` collapses the `prev`. The STATEMENT is
// unchanged, which keeps the migration confined — every call site cites this theorem rather
// than the clause, so the clause's guard never reaches them.
theorem rPowerSucc:
  forall a: Real; forall n: Nat;
  rpower(a, peano.succ(n)) = real.mul(a, rpower(a, n))
proof
  @the-recursive-clause |
    forall a2: Real; forall n2: Nat;
      n2 != NAT_ZERO -> rpower(a2, n2) = real.mul(a2, rpower(a2, peano.prev(n2)))
    [by definition(1) rpower]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-a |
    fix a: Real {
      @generalize-n |
        fix n: Nat {
          @succ-n-is-nonzero |
            peano.succ(n) != NAT_ZERO
            [using specialize a-successor-is-never-zero(n)]
          @clause-at-the-successor |
            rpower(a, peano.succ(n)) = real.mul(a, rpower(a, peano.prev(peano.succ(n))))
            [using specialize the-recursive-clause(a, peano.succ(n)) succ-n-is-nonzero]
          @prev-of-succ-n |
            peano.prev(peano.succ(n)) = n
            [using specialize prev-undoes-succ(n)]
          @conclusion-step-at-a-n |
            rpower(a, peano.succ(n)) = real.mul(a, rpower(a, n))
            [by rewrite prev-of-succ-n clause-at-the-successor]
        }
      @discharge-n |
        forall n: Nat; rpower(a, peano.succ(n)) = real.mul(a, rpower(a, n))
        [by generalize generalize-n]
    }
  @conclusion |
    forall a: Real; forall n: Nat;
      rpower(a, peano.succ(n)) = real.mul(a, rpower(a, n))
    [by generalize generalize-a]
qed

// -- the TERMINATION obligation for `rpower` ---------------------------------------------
//
// `termination(peano):` names `rpowerIsGrounded`, and the checker SYNTHESIZES the statement it must
// have — the recursive arm's own guard implying the generated predicate:
//
//     forall a: Real; forall n: Nat; n != NAT_ZERO -> rpowerGrounded(a, n)
//
// `rpowerGrounded` is GENERATED from the arm's one call site, a disjunction of that call grounded
// with its argument hitting the terminating arm's pattern:
//
//     rpowerGrounded(a, n) iff (rpowerGrounded(a, peano.prev(n)) or peano.prev(n) = NAT_ZERO)
//
// The base disjunct is what lets the recursion bottom out: at n = 1 the predecessor IS zero.

// Strategy: the step of an induction on the exponent. At `peano.succ(k)` the predecessor is `k`,
// so either `k` is zero and the base disjunct fires outright, or the inductive hypothesis
// applies at `k`. `tautology` picks whichever holds.
theorem rpowerReachesABaseFromAPredecessor: forall k: Nat;
  (forall a2: Real; k != NAT_ZERO -> rpowerGrounded(a2, k))
  -> (forall a: Real; peano.succ(k) != NAT_ZERO -> rpowerGrounded(a, peano.succ(k)))
proof
  @the-generated-clause |
    forall a3: Real; forall n3: Nat;
      rpowerGrounded(a3, n3) iff (rpowerGrounded(a3, peano.prev(n3)) or peano.prev(n3) = NAT_ZERO)
    [by definition rpowerGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall a2: Real; k != NAT_ZERO -> rpowerGrounded(a2, k) {
          @inductive-hypothesis |
            forall a2: Real; k != NAT_ZERO -> rpowerGrounded(a2, k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so this must precede every term writing `prev(peano.succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-a |
            fix a: Real {
              @given-succ-k-nonzero |
                assume peano.succ(k) != NAT_ZERO {
                  @clause-at-a-and-succ-k |
                    rpowerGrounded(a, peano.succ(k)) iff
                      (rpowerGrounded(a, peano.prev(peano.succ(k))) or peano.prev(peano.succ(k)) = NAT_ZERO)
                    [using specialize the-generated-clause(a, peano.succ(k))]
                  @clause-with-the-predecessor-collapsed |
                    rpowerGrounded(a, peano.succ(k)) iff (rpowerGrounded(a, k) or k = NAT_ZERO)
                    [by rewrite prev-of-succ-k-is-k clause-at-a-and-succ-k]
                  @the-inductive-hypothesis-at-a |
                    k != NAT_ZERO -> rpowerGrounded(a, k)
                    [using specialize inductive-hypothesis(a)]
                  @conclusion-grounded-at-succ-k |
                    rpowerGrounded(a, peano.succ(k))
                    [using tautology clause-with-the-predecessor-collapsed
                      the-inductive-hypothesis-at-a]
                }
              @nonzero-implies-grounded-at-succ-k |
                peano.succ(k) != NAT_ZERO -> rpowerGrounded(a, peano.succ(k))
                [by discharge given-succ-k-nonzero]
            }
          @conclusion-for-all-a |
            forall a: Real; peano.succ(k) != NAT_ZERO -> rpowerGrounded(a, peano.succ(k))
            [by generalize generalize-a]
        }
      @the-hypothesis-implies-the-step |
        (forall a2: Real; k != NAT_ZERO -> rpowerGrounded(a2, k))
          -> (forall a: Real; peano.succ(k) != NAT_ZERO -> rpowerGrounded(a, peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall a2: Real; k != NAT_ZERO -> rpowerGrounded(a2, k))
      -> (forall a: Real; peano.succ(k) != NAT_ZERO -> rpowerGrounded(a, peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the exponent. The base is VACUOUS — at n = zero the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so every bit of content is in the step above.
theorem rpowerIsGrounded: forall a: Real; forall n: Nat;
  n != NAT_ZERO -> rpowerGrounded(a, n)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binder is opened before the
  // vacuous antecedent can be refuted inside it.
  @base-case-proof |
    fix a: Real {
      @conclusion-vacuously-grounded-at-zero |
        NAT_ZERO != NAT_ZERO -> rpowerGrounded(a, NAT_ZERO)
        [using tautology zero-is-itself]
    }
  @base-case |
    forall a: Real; NAT_ZERO != NAT_ZERO -> rpowerGrounded(a, NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall a2: Real; k != NAT_ZERO -> rpowerGrounded(a2, k))
      -> (forall a: Real; peano.succ(k) != NAT_ZERO -> rpowerGrounded(a, peano.succ(k)))
    [by cite rpowerReachesABaseFromAPredecessor]
  @grounded-for-every-exponent |
    forall n: Nat; forall a: Real; n != NAT_ZERO -> rpowerGrounded(a, n)
    [using instantiation peano.induction((fun n: Nat => (forall a: Real; n != NAT_ZERO -> rpowerGrounded(a, n)))) base-case induction-step-for-all-k]
  @generalize-a |
    fix a: Real {
      @generalize-n |
        fix n: Nat {
          @grounded-at-n-and-a |
            n != NAT_ZERO -> rpowerGrounded(a, n)
            [using specialize grounded-for-every-exponent(n, a)]
        }
      @discharge-n |
        forall n: Nat; n != NAT_ZERO -> rpowerGrounded(a, n)
        [by generalize generalize-n]
    }
  @conclusion |
    forall a: Real; forall n: Nat; n != NAT_ZERO -> rpowerGrounded(a, n)
    [by generalize generalize-a]
qed

theorem rEvalZero:
  forall p: RPoly; forall a: Real;
  revalUpTo(p, a, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p: RPoly; forall a: Real;
      revalUpTo(p, a, NAT_ZERO) = ZERO
    [by definition(0) revalUpTo]
qed

theorem rEvalSucc:
  forall p: RPoly; forall a: Real; forall k: Nat;
  revalUpTo(p, a, peano.succ(k)) =
  real.add(revalUpTo(p, a, k), real.mul(rcoeff(p, k), rpower(a, k)))
proof
  @conclusion |
    forall p: RPoly; forall a: Real; forall k: Nat;
      revalUpTo(p, a, peano.succ(k)) =
      real.add(revalUpTo(p, a, k), real.mul(rcoeff(p, k), rpower(a, k)))
    [by definition(1) revalUpTo]
qed

theorem rTailConvolutionZero:
  forall p, q: RPoly; forall m: Nat;
  rtailConvolution(p, q, NAT_ZERO, m) =
  real.mul(rcoeff(p, NAT_ZERO), rcoeff(q, m))
proof
  @conclusion |
    forall p, q: RPoly; forall m: Nat;
      rtailConvolution(p, q, NAT_ZERO, m) =
      real.mul(rcoeff(p, NAT_ZERO), rcoeff(q, m))
    [by definition(0) rtailConvolution]
qed

// The `succ` step, now DERIVED rather than transcribed: the definition descends by `prev`
// (the l-value rule keeps patterns off the left), so this restates it at a successor, where
// `prevOfSucc` collapses the `prev`. The STATEMENT is unchanged, which is what confines the
// migration — every call site cites this theorem, not the clause, so the clause's `j != NAT_ZERO`
// guard never reaches them.
theorem rTailConvolutionSucc:
  forall p, q: RPoly; forall j, m: Nat;
  rtailConvolution(p, q, peano.succ(j), m) =
  real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, m)),
  rtailConvolution(p, q, j, peano.succ(m)))
proof
  @the-recursive-clause |
    forall p2: RPoly; forall q2: RPoly; forall j2: Nat; forall m2: Nat;
      j2 != NAT_ZERO ->
      rtailConvolution(p2, q2, j2, m2) =
      real.add(real.mul(rcoeff(p2, j2), rcoeff(q2, m2)), rtailConvolution(p2, q2, peano.prev(j2), peano.succ(m2)))
    [by definition(1) rtailConvolution]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: RPoly {
      @generalize-q |
        fix q: RPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @succ-j-is-nonzero |
                    peano.succ(j) != NAT_ZERO
                    [using specialize a-successor-is-never-zero(j)]
                  @clause-at-the-successor |
                    rtailConvolution(p, q, peano.succ(j), m) =
                      real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, m)),
                      rtailConvolution(p, q, peano.prev(peano.succ(j)), peano.succ(m)))
                    [using specialize the-recursive-clause(p, q, peano.succ(j), m) succ-j-is-nonzero]
                  @prev-of-succ-j |
                    peano.prev(peano.succ(j)) = j
                    [using specialize prev-undoes-succ(j)]
                  @conclusion-step-at-j |
                    rtailConvolution(p, q, peano.succ(j), m) =
                      real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, m)),
                      rtailConvolution(p, q, j, peano.succ(m)))
                    [by rewrite prev-of-succ-j clause-at-the-successor]
                }
              @discharge-m |
                forall m: Nat;
                  rtailConvolution(p, q, peano.succ(j), m) =
                  real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, m)),
                  rtailConvolution(p, q, j, peano.succ(m)))
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j, m: Nat;
              rtailConvolution(p, q, peano.succ(j), m) =
              real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, m)),
              rtailConvolution(p, q, j, peano.succ(m)))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: RPoly; forall j, m: Nat;
          rtailConvolution(p, q, peano.succ(j), m) =
          real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, m)),
          rtailConvolution(p, q, j, peano.succ(m)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: RPoly; forall j, m: Nat;
      rtailConvolution(p, q, peano.succ(j), m) =
      real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, m)),
      rtailConvolution(p, q, j, peano.succ(m)))
    [by generalize generalize-p]
qed

theorem rSegmentZero:
  forall p, q: RPoly; forall j, c: Nat;
  rsegmentOf(p, q, j, c, NAT_ZERO) = real.mul(rcoeff(p, j), rcoeff(q, c))
proof
  @conclusion |
    forall p, q: RPoly; forall j, c: Nat;
      rsegmentOf(p, q, j, c, NAT_ZERO) = real.mul(rcoeff(p, j), rcoeff(q, c))
    [by definition(0) rsegmentOf]
qed

theorem rSegmentSucc:
  forall p, q: RPoly; forall j, c, n: Nat;
  rsegmentOf(p, q, peano.succ(j), c, peano.succ(n)) =
  real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, c)),
  rsegmentOf(p, q, j, peano.succ(c), n))
proof
  @conclusion |
    forall p, q: RPoly; forall j, c, n: Nat;
      rsegmentOf(p, q, peano.succ(j), c, peano.succ(n)) =
      real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, c)),
      rsegmentOf(p, q, j, peano.succ(c), n))
    [by definition(1) rsegmentOf]
qed

theorem rRsegmentZero:
  forall p, q: RPoly; forall j, c: Nat;
  rrsegmentOf(p, q, j, c, NAT_ZERO) = real.mul(rcoeff(p, j), rcoeff(q, c))
proof
  @conclusion |
    forall p, q: RPoly; forall j, c: Nat;
      rrsegmentOf(p, q, j, c, NAT_ZERO) = real.mul(rcoeff(p, j), rcoeff(q, c))
    [by definition(0) rrsegmentOf]
qed

theorem rRsegmentSucc:
  forall p, q: RPoly; forall j, c, n: Nat;
  rrsegmentOf(p, q, j, peano.succ(c), peano.succ(n)) =
  real.add(real.mul(rcoeff(p, j), rcoeff(q, peano.succ(c))),
  rrsegmentOf(p, q, peano.succ(j), c, n))
proof
  @conclusion |
    forall p, q: RPoly; forall j, c, n: Nat;
      rrsegmentOf(p, q, j, peano.succ(c), peano.succ(n)) =
      real.add(real.mul(rcoeff(p, j), rcoeff(q, peano.succ(c))),
      rrsegmentOf(p, q, peano.succ(j), c, n))
    [by definition(1) rrsegmentOf]
qed

theorem rmonusAtZero:
  forall i: Nat; rmonus(i, NAT_ZERO) = i
proof
  @conclusion |
    forall i: Nat; rmonus(i, NAT_ZERO) = i
    [by definition(0) rmonus]
qed

// The `succ`/`succ` step, now DERIVED rather than transcribed: the definition descends by
// `prev` (the l-value rule keeps patterns off the left), so this restates it at a successor
// pair, where `prevOfSucc` collapses both `prev`s. The STATEMENT is unchanged, so every call
// site below still cites this theorem and the clause's guard never reaches them.
theorem rmonusSteps:
  forall i, j: Nat;
  rmonus(peano.succ(i), peano.succ(j)) = rmonus(i, j)
proof
  @the-recursive-clause |
    forall i2: Nat; forall j2: Nat;
      (i2 != NAT_ZERO and j2 != NAT_ZERO) ->
      rmonus(i2, j2) = rmonus(peano.prev(i2), peano.prev(j2))
    [by definition(1) rmonus]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @succ-i-is-nonzero |
            peano.succ(i) != NAT_ZERO
            [using specialize a-successor-is-never-zero(i)]
          @succ-j-is-nonzero |
            peano.succ(j) != NAT_ZERO
            [using specialize a-successor-is-never-zero(j)]
          @both-are-nonzero |
            peano.succ(i) != NAT_ZERO and peano.succ(j) != NAT_ZERO
            [by both succ-i-is-nonzero succ-j-is-nonzero]
          @clause-at-the-successor-pair |
            rmonus(peano.succ(i), peano.succ(j)) =
              rmonus(peano.prev(peano.succ(i)), peano.prev(peano.succ(j)))
            [using specialize the-recursive-clause(peano.succ(i), peano.succ(j)) both-are-nonzero]
          @prev-of-succ-i |
            peano.prev(peano.succ(i)) = i
            [using specialize prev-undoes-succ(i)]
          @prev-of-succ-j |
            peano.prev(peano.succ(j)) = j
            [using specialize prev-undoes-succ(j)]
          @first-prev-collapsed |
            rmonus(peano.succ(i), peano.succ(j)) = rmonus(i, peano.prev(peano.succ(j)))
            [by rewrite prev-of-succ-i clause-at-the-successor-pair]
          @conclusion-step-at-i-j |
            rmonus(peano.succ(i), peano.succ(j)) = rmonus(i, j)
            [by rewrite prev-of-succ-j first-prev-collapsed]
        }
      @discharge-j |
        forall j: Nat; rmonus(peano.succ(i), peano.succ(j)) = rmonus(i, j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j: Nat;
      rmonus(peano.succ(i), peano.succ(j)) = rmonus(i, j)
    [by generalize generalize-i]
qed

theorem rTheCofactorIndexAtZero:
  forall i, j: Nat;
  rtheCofactorIndex(i, j, NAT_ZERO) = rmonus(i, j)
proof
  @conclusion |
    forall i, j: Nat;
      rtheCofactorIndex(i, j, NAT_ZERO) = rmonus(i, j)
    [by definition(0) rtheCofactorIndex]
qed

theorem rTheCofactorIndexSteps:
  forall i, j, k: Nat;
  rtheCofactorIndex(i, j, peano.succ(k)) =
  rmonus(rmonus(i, j), peano.succ(k))
proof
  @conclusion |
    forall i, j, k: Nat;
      rtheCofactorIndex(i, j, peano.succ(k)) =
      rmonus(rmonus(i, j), peano.succ(k))
    [by definition(1) rtheCofactorIndex]
qed

theorem rCappedRunZero:
  forall q, r: RPoly; forall g: Nat;
  rcappedRun(q, r, g, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall q, r: RPoly; forall g: Nat;
      rcappedRun(q, r, g, NAT_ZERO) = ZERO
    [by definition(0) rcappedRun]
qed

theorem rCappedRunSucc:
  forall q, r: RPoly; forall g, n: Nat;
  rcappedRun(q, r, g, peano.succ(n)) =
  real.add(rcappedRun(q, r, g, n),
  real.mul(rcoeff(q, n), rcoeff(r, rmonus(g, n))))
proof
  @conclusion |
    forall q, r: RPoly; forall g, n: Nat;
      rcappedRun(q, r, g, peano.succ(n)) =
      real.add(rcappedRun(q, r, g, n),
      real.mul(rcoeff(q, n), rcoeff(r, rmonus(g, n))))
    [by definition(1) rcappedRun]
qed

theorem rTripleTermMeaning:
  forall p, q, r: RPoly; forall i, j, k: Nat;
  rtripleTerm(p, q, r, i, j, k) =
  real.mul(real.mul(rcoeff(p, j), rcoeff(q, k)),
  rcoeff(r, rtheCofactorIndex(i, j, k)))
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, j, k: Nat;
      rtripleTerm(p, q, r, i, j, k) =
      real.mul(real.mul(rcoeff(p, j), rcoeff(q, k)),
      rcoeff(r, rtheCofactorIndex(i, j, k)))
    [by definition rtripleTerm]
qed

theorem rTripleRowZero:
  forall p, q, r: RPoly; forall i, j: Nat;
  rtripleRow(p, q, r, i, j, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, j: Nat;
      rtripleRow(p, q, r, i, j, NAT_ZERO) = ZERO
    [by definition(0) rtripleRow]
qed

theorem rTripleRowSucc:
  forall p, q, r: RPoly; forall i, j, n: Nat;
  rtripleRow(p, q, r, i, j, peano.succ(n)) =
  real.add(rtripleRow(p, q, r, i, j, n), rtripleTerm(p, q, r, i, j, n))
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, j, n: Nat;
      rtripleRow(p, q, r, i, j, peano.succ(n)) =
      real.add(rtripleRow(p, q, r, i, j, n), rtripleTerm(p, q, r, i, j, n))
    [by definition(1) rtripleRow]
qed

theorem rTripleDiagZero:
  forall p, q, r: RPoly; forall i, m: Nat;
  rtripleDiag(p, q, r, i, m, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, m: Nat;
      rtripleDiag(p, q, r, i, m, NAT_ZERO) = ZERO
    [by definition(0) rtripleDiag]
qed

theorem rTripleDiagSucc:
  forall p, q, r: RPoly; forall i, m, c: Nat;
  rtripleDiag(p, q, r, i, m, peano.succ(c)) =
  real.add(rtripleDiag(p, q, r, i, m, c),
  rtripleTerm(p, q, r, i, c, rmonus(m, c)))
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, m, c: Nat;
      rtripleDiag(p, q, r, i, m, peano.succ(c)) =
      real.add(rtripleDiag(p, q, r, i, m, c),
      rtripleTerm(p, q, r, i, c, rmonus(m, c)))
    [by definition(1) rtripleDiag]
qed

theorem rTripleTriZero:
  forall p, q, r: RPoly; forall i: Nat;
  rtripleTri(p, q, r, i, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: RPoly; forall i: Nat;
      rtripleTri(p, q, r, i, NAT_ZERO) = ZERO
    [by definition(0) rtripleTri]
qed

theorem rTripleTriSucc:
  forall p, q, r: RPoly; forall i, n: Nat;
  rtripleTri(p, q, r, i, peano.succ(n)) =
  real.add(rtripleTri(p, q, r, i, n),
  rtripleDiag(p, q, r, i, n, peano.succ(n)))
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, n: Nat;
      rtripleTri(p, q, r, i, peano.succ(n)) =
      real.add(rtripleTri(p, q, r, i, n),
      rtripleDiag(p, q, r, i, n, peano.succ(n)))
    [by definition(1) rtripleTri]
qed

theorem rTripleRowsZero:
  forall p, q, r: RPoly; forall i, n: Nat;
  rtripleRows(p, q, r, i, NAT_ZERO, n) = ZERO
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, n: Nat;
      rtripleRows(p, q, r, i, NAT_ZERO, n) = ZERO
    [by definition(0) rtripleRows]
qed

theorem rTripleRowsSucc:
  forall p, q, r: RPoly; forall i, m, n: Nat;
  rtripleRows(p, q, r, i, peano.succ(m), n) =
  real.add(rtripleRows(p, q, r, i, m, n),
  rtripleRow(p, q, r, i, m, rmonus(n, m)))
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, m, n: Nat;
      rtripleRows(p, q, r, i, peano.succ(m), n) =
      real.add(rtripleRows(p, q, r, i, m, n),
      rtripleRow(p, q, r, i, m, rmonus(n, m)))
    [by definition(1) rtripleRows]
qed

// -- the TERMINATION obligation for `rmonus` ------------------------------------------------
//
// `termination(peano):` names `rmonusIsGrounded`, and the checker SYNTHESIZES the statement it
// must have — the recursive arm's own guard implying the generated predicate. The predicate
// itself is generated from the arm's call sites, one conjunct per site, each a disjunction of
// that call grounded with its arguments hitting a terminating arm's pattern. Those base
// disjuncts let the recursion bottom out, and all three are needed: `j` running out fires the
// third, `i` running out first fires the second.

// Strategy: induction on the SECOND argument. The one subtlety is that `peano.prev(i) != NAT_ZERO`
// does NOT follow from `i != NAT_ZERO` (take i = 1), so the inductive hypothesis is not
// applicable at `peano.prev(i)` — and need not be, since that is exactly the case the second
// disjunct covers. `tautology` picks whichever disjunct holds.
theorem rmonusReachesABaseFromAPredecessor: forall k: Nat;
  (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> rmonusGrounded(i2, k))
  -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> rmonusGrounded(i, peano.succ(k)))
proof
  @the-generated-clause |
    forall i3: Nat; forall j3: Nat;
      rmonusGrounded(i3, j3) iff
      (rmonusGrounded(peano.prev(i3), peano.prev(j3)) or peano.prev(i3) = NAT_ZERO
      or peano.prev(j3) = NAT_ZERO)
    [by definition rmonusGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> rmonusGrounded(i2, k) {
          @inductive-hypothesis |
            forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> rmonusGrounded(i2, k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so this must precede every term writing `peano.prev(peano.succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-i |
            fix i: Nat {
              @given-i-nonzero-and-succ-k-nonzero |
                assume i != NAT_ZERO and peano.succ(k) != NAT_ZERO {
                  @i-is-nonzero-and-so-is-succ-k |
                    i != NAT_ZERO and peano.succ(k) != NAT_ZERO
                    [by hypothesis given-i-nonzero-and-succ-k-nonzero]
                  @i-is-nonzero |
                    i != NAT_ZERO
                    [by and_lhs i-is-nonzero-and-so-is-succ-k]
                  @clause-at-i-and-succ-k |
                    rmonusGrounded(i, peano.succ(k)) iff
                      (rmonusGrounded(peano.prev(i), peano.prev(peano.succ(k))) or peano.prev(i) = NAT_ZERO
                      or peano.prev(peano.succ(k)) = NAT_ZERO)
                    [using specialize the-generated-clause(i, peano.succ(k))]
                  @clause-with-the-predecessor-collapsed |
                    rmonusGrounded(i, peano.succ(k)) iff
                      (rmonusGrounded(peano.prev(i), k) or peano.prev(i) = NAT_ZERO or k = NAT_ZERO)
                    [by rewrite prev-of-succ-k-is-k clause-at-i-and-succ-k]
                  @the-inductive-hypothesis-at-the-predecessor |
                    (peano.prev(i) != NAT_ZERO and k != NAT_ZERO) -> rmonusGrounded(peano.prev(i), k)
                    [using specialize inductive-hypothesis(peano.prev(i))]
                  @conclusion-grounded-at-succ-k |
                    rmonusGrounded(i, peano.succ(k))
                    [using tautology clause-with-the-predecessor-collapsed
                      the-inductive-hypothesis-at-the-predecessor]
                }
              @nonzero-implies-grounded-at-succ-k |
                (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> rmonusGrounded(i, peano.succ(k))
                [by discharge given-i-nonzero-and-succ-k-nonzero]
            }
          @conclusion-for-all-i |
            forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> rmonusGrounded(i, peano.succ(k))
            [by generalize generalize-i]
        }
      @the-hypothesis-implies-the-step |
        (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> rmonusGrounded(i2, k))
          -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> rmonusGrounded(i, peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> rmonusGrounded(i2, k))
      -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> rmonusGrounded(i, peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the second argument. The base is VACUOUS — at j = NAT_ZERO the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so all the content is in the step above.
theorem rmonusIsGrounded: forall i: Nat; forall j: Nat;
  (i != NAT_ZERO and j != NAT_ZERO) -> rmonusGrounded(i, j)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binder is opened before the
  // vacuous antecedent can be refuted inside it.
  @base-case-proof |
    fix i: Nat {
      @conclusion-vacuously-grounded-at-zero |
        (i != NAT_ZERO and NAT_ZERO != NAT_ZERO) -> rmonusGrounded(i, NAT_ZERO)
        [using tautology zero-is-itself]
    }
  @base-case |
    forall i: Nat; (i != NAT_ZERO and NAT_ZERO != NAT_ZERO) -> rmonusGrounded(i, NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> rmonusGrounded(i2, k))
      -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> rmonusGrounded(i, peano.succ(k)))
    [by cite rmonusReachesABaseFromAPredecessor]
  @grounded-for-every-second-argument |
    forall j: Nat; forall i: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> rmonusGrounded(i, j)
    [using instantiation peano.induction((fun j: Nat => (forall i: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> rmonusGrounded(i, j)))) base-case induction-step-for-all-k]
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @grounded-at-j-and-i |
            (i != NAT_ZERO and j != NAT_ZERO) -> rmonusGrounded(i, j)
            [using specialize grounded-for-every-second-argument(j, i)]
        }
      @discharge-j |
        forall j: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> rmonusGrounded(i, j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> rmonusGrounded(i, j)
    [by generalize generalize-i]
qed

// -- rconvolution's TERMINATION obligation ------------------------------------------
//
// The checker GENERATES the predicate from the recursive arm's one call site:
//
//     rconvolutionGrounded(p, q, j, m) iff
//       (rconvolutionGrounded(p, q, peano.succ(j), peano.prev(m))
//        or peano.prev(m) = NAT_ZERO)
//
// The `prev(m) = NAT_ZERO` disjunct is the base — the NAT_ZERO arm is the only terminating
// one — and it is what lets the recursion bottom out. The ASCENDING `j` costs nothing: it
// rides along untouched, because termination asks only whether the DESCENT reaches a base.

// Strategy: the inductive step on the descending index. At `succ(k)` the clause's `prev`
// collapses to `k`, leaving either `k = NAT_ZERO` (base disjunct) or the hypothesis at `k`;
// `tautology` picks whichever holds. The ascending index is read at `succ(j)`.
theorem rConvolutionReachesZeroFromAPredecessor: forall k: Nat;
  (forall p2: RPoly; forall q2: RPoly; forall j2: Nat;
  k != NAT_ZERO -> rconvolutionGrounded(p2, q2, j2, k))
  -> (forall p: RPoly; forall q: RPoly; forall j: Nat;
  peano.succ(k) != NAT_ZERO -> rconvolutionGrounded(p, q, j, peano.succ(k)))
proof
  @the-generated-clause |
    forall p3: RPoly; forall q3: RPoly; forall j3: Nat; forall m3: Nat;
      rconvolutionGrounded(p3, q3, j3, m3) iff
      (rconvolutionGrounded(p3, q3, peano.succ(j3), peano.prev(m3))
      or peano.prev(m3) = NAT_ZERO)
    [by definition rconvolutionGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall p2: RPoly; forall q2: RPoly; forall j2: Nat;
          k != NAT_ZERO -> rconvolutionGrounded(p2, q2, j2, k) {
          @inductive-hypothesis |
            forall p2: RPoly; forall q2: RPoly; forall j2: Nat;
              k != NAT_ZERO -> rconvolutionGrounded(p2, q2, j2, k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so the guard fact precedes every term writing `prev(succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-p |
            fix p: RPoly {
              @generalize-q |
                fix q: RPoly {
                  @generalize-j |
                    fix j: Nat {
                      @clause-at-succ-k |
                        rconvolutionGrounded(p, q, j, peano.succ(k)) iff
                          (rconvolutionGrounded(p, q, peano.succ(j),
                          peano.prev(peano.succ(k)))
                          or peano.prev(peano.succ(k)) = NAT_ZERO)
                        [using specialize the-generated-clause(p, q, j, peano.succ(k))]
                      @clause-with-the-predecessor-collapsed |
                        rconvolutionGrounded(p, q, j, peano.succ(k)) iff
                          (rconvolutionGrounded(p, q, peano.succ(j), k) or k = NAT_ZERO)
                        [by rewrite prev-of-succ-k-is-k clause-at-succ-k]
                      @the-inductive-hypothesis-at-the-raised-index |
                        k != NAT_ZERO -> rconvolutionGrounded(p, q, peano.succ(j), k)
                        [using specialize inductive-hypothesis(p, q, peano.succ(j))]
                      @grounded-at-succ-k |
                        rconvolutionGrounded(p, q, j, peano.succ(k))
                        [using tautology clause-with-the-predecessor-collapsed
                          the-inductive-hypothesis-at-the-raised-index]
                      @conclusion-nonzero-implies-grounded |
                        peano.succ(k) != NAT_ZERO
                          -> rconvolutionGrounded(p, q, j, peano.succ(k))
                        [using tautology grounded-at-succ-k]
                    }
                  @discharge-j |
                    forall j: Nat;
                      peano.succ(k) != NAT_ZERO
                      -> rconvolutionGrounded(p, q, j, peano.succ(k))
                    [by generalize generalize-j]
                }
              @discharge-q |
                forall q: RPoly; forall j: Nat;
                  peano.succ(k) != NAT_ZERO
                  -> rconvolutionGrounded(p, q, j, peano.succ(k))
                [by generalize generalize-q]
            }
          @conclusion-for-all-polynomials |
            forall p: RPoly; forall q: RPoly; forall j: Nat;
              peano.succ(k) != NAT_ZERO -> rconvolutionGrounded(p, q, j, peano.succ(k))
            [by generalize generalize-p]
        }
      @the-hypothesis-implies-the-step |
        (forall p2: RPoly; forall q2: RPoly; forall j2: Nat;
          k != NAT_ZERO -> rconvolutionGrounded(p2, q2, j2, k))
          -> (forall p: RPoly; forall q: RPoly; forall j: Nat;
          peano.succ(k) != NAT_ZERO -> rconvolutionGrounded(p, q, j, peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall p2: RPoly; forall q2: RPoly; forall j2: Nat;
      k != NAT_ZERO -> rconvolutionGrounded(p2, q2, j2, k))
      -> (forall p: RPoly; forall q: RPoly; forall j: Nat;
      peano.succ(k) != NAT_ZERO -> rconvolutionGrounded(p, q, j, peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the descending index. The base is VACUOUS — at NAT_ZERO the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so all the content is in the step above.
theorem rConvolutionIsGrounded:
  forall p: RPoly; forall q: RPoly; forall j: Nat; forall m: Nat;
  m != NAT_ZERO -> rconvolutionGrounded(p, q, j, m)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix p: RPoly {
      @generalize-q-at-zero |
        fix q: RPoly {
          @generalize-j-at-zero |
            fix j: Nat {
              @conclusion-vacuously-grounded-at-zero |
                NAT_ZERO != NAT_ZERO -> rconvolutionGrounded(p, q, j, NAT_ZERO)
                [using tautology zero-is-itself]
            }
          @discharge-j-at-zero |
            forall j: Nat;
              NAT_ZERO != NAT_ZERO -> rconvolutionGrounded(p, q, j, NAT_ZERO)
            [by generalize generalize-j-at-zero]
        }
      @discharge-q-at-zero |
        forall q: RPoly; forall j: Nat;
          NAT_ZERO != NAT_ZERO -> rconvolutionGrounded(p, q, j, NAT_ZERO)
        [by generalize generalize-q-at-zero]
    }
  @base-case |
    forall p: RPoly; forall q: RPoly; forall j: Nat;
      NAT_ZERO != NAT_ZERO -> rconvolutionGrounded(p, q, j, NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall p2: RPoly; forall q2: RPoly; forall j2: Nat;
      k != NAT_ZERO -> rconvolutionGrounded(p2, q2, j2, k))
      -> (forall p: RPoly; forall q: RPoly; forall j: Nat;
      peano.succ(k) != NAT_ZERO -> rconvolutionGrounded(p, q, j, peano.succ(k)))
    [by cite rConvolutionReachesZeroFromAPredecessor]
  @grounded-for-every-descending-index |
    forall m: Nat; forall p: RPoly; forall q: RPoly; forall j: Nat;
      m != NAT_ZERO -> rconvolutionGrounded(p, q, j, m)
    [using instantiation peano.induction((fun m: Nat => (forall p: RPoly; forall q: RPoly; forall j: Nat; m != NAT_ZERO -> rconvolutionGrounded(p, q, j, m)))) base-case induction-step-for-all-k]
  @generalize-p |
    fix p: RPoly {
      @generalize-q |
        fix q: RPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @grounded-at-these-indices |
                    m != NAT_ZERO -> rconvolutionGrounded(p, q, j, m)
                    [using specialize grounded-for-every-descending-index(m, p, q, j)]
                }
              @discharge-m |
                forall m: Nat; m != NAT_ZERO -> rconvolutionGrounded(p, q, j, m)
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j: Nat; forall m: Nat;
              m != NAT_ZERO -> rconvolutionGrounded(p, q, j, m)
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: RPoly; forall j: Nat; forall m: Nat;
          m != NAT_ZERO -> rconvolutionGrounded(p, q, j, m)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p: RPoly; forall q: RPoly; forall j: Nat; forall m: Nat;
      m != NAT_ZERO -> rconvolutionGrounded(p, q, j, m)
    [by generalize generalize-p]
qed

// -- rtailConvolution's TERMINATION obligation ---------------------------------------------
//
// The generated predicate transcribes the recursive arm's one call site, with the NAT_ZERO arm's
// pattern as its base alternative:
//
//   rtailConvolutionGrounded(p, q, j, m) iff
//     (rtailConvolutionGrounded(p, q, peano.prev(j), peano.succ(m)) or peano.prev(j) = NAT_ZERO)
//
// The `peano.prev(j) = NAT_ZERO` disjunct is the base — the NAT_ZERO arm is the only terminating one, and it
// narrows the THIRD slot — and it is what lets the recursion bottom out.
//
// Note what the ASCENDING `m` costs: nothing, exactly as `convolution`'s ascending `j` cost
// nothing. It rides along in both the predicate and the obligation, because termination asks
// only whether the DESCENT reaches a base.

// Strategy: the inductive step on the descending index. At `peano.succ(k)` the generated clause's
// `prev` collapses to `k`, leaving either `k = NAT_ZERO` (the base disjunct fires) or the
// inductive hypothesis at `k`. `tautology` picks whichever holds. The ascending `m` is
// specialized at `peano.succ(m)`, which is where the hypothesis has to be read.
theorem rTailConvolutionReachesZeroFromAPredecessor: forall k: Nat;
  (forall p2: RPoly; forall q2: RPoly; forall m2: Nat;
  k != NAT_ZERO -> rtailConvolutionGrounded(p2, q2, k, m2))
  -> (forall p: RPoly; forall q: RPoly; forall m: Nat;
  peano.succ(k) != NAT_ZERO -> rtailConvolutionGrounded(p, q, peano.succ(k), m))
proof
  @the-generated-clause |
    forall p3: RPoly; forall q3: RPoly; forall j3: Nat; forall m3: Nat;
      rtailConvolutionGrounded(p3, q3, j3, m3) iff
      (rtailConvolutionGrounded(p3, q3, peano.prev(j3), peano.succ(m3)) or peano.prev(j3) = NAT_ZERO)
    [by definition rtailConvolutionGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall p2: RPoly; forall q2: RPoly; forall m2: Nat;
          k != NAT_ZERO -> rtailConvolutionGrounded(p2, q2, k, m2) {
          @inductive-hypothesis |
            forall p2: RPoly; forall q2: RPoly; forall m2: Nat;
              k != NAT_ZERO -> rtailConvolutionGrounded(p2, q2, k, m2)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so BOTH of these precede every term writing `peano.prev(peano.succ(k))`:
          // the guard fact first, then the collapse.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-p |
            fix p: RPoly {
              @generalize-q |
                fix q: RPoly {
                  @generalize-m |
                    fix m: Nat {
                      @clause-at-succ-k |
                        rtailConvolutionGrounded(p, q, peano.succ(k), m) iff
                          (rtailConvolutionGrounded(p, q, peano.prev(peano.succ(k)), peano.succ(m))
                          or peano.prev(peano.succ(k)) = NAT_ZERO)
                        [using specialize the-generated-clause(p, q, peano.succ(k), m)]
                      @clause-with-the-predecessor-collapsed |
                        rtailConvolutionGrounded(p, q, peano.succ(k), m) iff
                          (rtailConvolutionGrounded(p, q, k, peano.succ(m)) or k = NAT_ZERO)
                        [by rewrite prev-of-succ-k-is-k clause-at-succ-k]
                      @the-inductive-hypothesis-at-the-raised-index |
                        k != NAT_ZERO -> rtailConvolutionGrounded(p, q, k, peano.succ(m))
                        [using specialize inductive-hypothesis(p, q, peano.succ(m))]
                      @grounded-at-succ-k |
                        rtailConvolutionGrounded(p, q, peano.succ(k), m)
                        [using tautology clause-with-the-predecessor-collapsed
                          the-inductive-hypothesis-at-the-raised-index]
                      @conclusion-nonzero-implies-grounded |
                        peano.succ(k) != NAT_ZERO -> rtailConvolutionGrounded(p, q, peano.succ(k), m)
                        [using tautology grounded-at-succ-k]
                    }
                  @discharge-m |
                    forall m: Nat;
                      peano.succ(k) != NAT_ZERO -> rtailConvolutionGrounded(p, q, peano.succ(k), m)
                    [by generalize generalize-m]
                }
              @discharge-q |
                forall q: RPoly; forall m: Nat;
                  peano.succ(k) != NAT_ZERO -> rtailConvolutionGrounded(p, q, peano.succ(k), m)
                [by generalize generalize-q]
            }
          @conclusion-for-all-polynomials |
            forall p: RPoly; forall q: RPoly; forall m: Nat;
              peano.succ(k) != NAT_ZERO -> rtailConvolutionGrounded(p, q, peano.succ(k), m)
            [by generalize generalize-p]
        }
      @the-hypothesis-implies-the-step |
        (forall p2: RPoly; forall q2: RPoly; forall m2: Nat;
          k != NAT_ZERO -> rtailConvolutionGrounded(p2, q2, k, m2))
          -> (forall p: RPoly; forall q: RPoly; forall m: Nat;
          peano.succ(k) != NAT_ZERO -> rtailConvolutionGrounded(p, q, peano.succ(k), m))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall p2: RPoly; forall q2: RPoly; forall m2: Nat;
      k != NAT_ZERO -> rtailConvolutionGrounded(p2, q2, k, m2))
      -> (forall p: RPoly; forall q: RPoly; forall m: Nat;
      peano.succ(k) != NAT_ZERO -> rtailConvolutionGrounded(p, q, peano.succ(k), m))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the descending index. The base is VACUOUS — at j = NAT_ZERO the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so all the content is in the step above.
theorem rTailConvolutionIsGrounded: forall p: RPoly; forall q: RPoly; forall j: Nat; forall m: Nat;
  j != NAT_ZERO -> rtailConvolutionGrounded(p, q, j, m)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix p: RPoly {
      @generalize-q-at-zero |
        fix q: RPoly {
          @generalize-m-at-zero |
            fix m: Nat {
              @conclusion-vacuously-grounded-at-zero |
                NAT_ZERO != NAT_ZERO -> rtailConvolutionGrounded(p, q, NAT_ZERO, m)
                [using tautology zero-is-itself]
            }
          @discharge-m-at-zero |
            forall m: Nat; NAT_ZERO != NAT_ZERO -> rtailConvolutionGrounded(p, q, NAT_ZERO, m)
            [by generalize generalize-m-at-zero]
        }
      @discharge-q-at-zero |
        forall q: RPoly; forall m: Nat;
          NAT_ZERO != NAT_ZERO -> rtailConvolutionGrounded(p, q, NAT_ZERO, m)
        [by generalize generalize-q-at-zero]
    }
  @base-case |
    forall p: RPoly; forall q: RPoly; forall m: Nat;
      NAT_ZERO != NAT_ZERO -> rtailConvolutionGrounded(p, q, NAT_ZERO, m)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall p2: RPoly; forall q2: RPoly; forall m2: Nat;
      k != NAT_ZERO -> rtailConvolutionGrounded(p2, q2, k, m2))
      -> (forall p: RPoly; forall q: RPoly; forall m: Nat;
      peano.succ(k) != NAT_ZERO -> rtailConvolutionGrounded(p, q, peano.succ(k), m))
    [by cite rTailConvolutionReachesZeroFromAPredecessor]
  @grounded-for-every-descending-index |
    forall j: Nat; forall p: RPoly; forall q: RPoly; forall m: Nat;
      j != NAT_ZERO -> rtailConvolutionGrounded(p, q, j, m)
    [using instantiation peano.induction((fun j: Nat => (forall p: RPoly; forall q: RPoly; forall m: Nat; j != NAT_ZERO -> rtailConvolutionGrounded(p, q, j, m)))) base-case induction-step-for-all-k]
  @generalize-p |
    fix p: RPoly {
      @generalize-q |
        fix q: RPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @grounded-at-these-indices |
                    j != NAT_ZERO -> rtailConvolutionGrounded(p, q, j, m)
                    [using specialize grounded-for-every-descending-index(j, p, q, m)]
                }
              @discharge-m |
                forall m: Nat; j != NAT_ZERO -> rtailConvolutionGrounded(p, q, j, m)
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j: Nat; forall m: Nat; j != NAT_ZERO -> rtailConvolutionGrounded(p, q, j, m)
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: RPoly; forall j: Nat; forall m: Nat;
          j != NAT_ZERO -> rtailConvolutionGrounded(p, q, j, m)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p: RPoly; forall q: RPoly; forall j: Nat; forall m: Nat;
      j != NAT_ZERO -> rtailConvolutionGrounded(p, q, j, m)
    [by generalize generalize-p]
qed
