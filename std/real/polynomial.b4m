theorem rSegmentSucc:
  forall p, q: RPoly; forall j, c, n: Nat;
  rsegmentOf(p, q, peano.succ(j), c, peano.succ(n)) =
  real.add(real.mul(rcoeff(p, peano.succ(j)), rcoeff(q, c)),
  rsegmentOf(p, q, j, peano.succ(c), n))
proof
  @conclusion |
    forall p, q: RPoly; forall j, c, n: Nat;
      rsegmentOf(p, q, peano.succ(j), c, peano.succ(n)) =
