theorem rTheGapToAtZero:
  forall i: Nat; rtheGapTo(i, NAT_ZERO) = i
proof
  @conclusion |
    forall i: Nat; rtheGapTo(i, NAT_ZERO) = i
    [by definition(0) rtheGapTo]
qed

theorem rTheGapToSteps:
  forall i, j: Nat;
  rtheGapTo(peano.succ(i), peano.succ(j)) = rtheGapTo(i, j)
proof
  @conclusion |
    forall i, j: Nat;
      rtheGapTo(peano.succ(i), peano.succ(j)) = rtheGapTo(i, j)
    [by definition(1) rtheGapTo]
qed

theorem rTheCofactorIndexAtZero:
  forall i, j: Nat;
  rtheCofactorIndex(i, j, NAT_ZERO) = rtheGapTo(i, j)
proof
  @conclusion |
    forall i, j: Nat;
      rtheCofactorIndex(i, j, NAT_ZERO) = rtheGapTo(i, j)
    [by definition(0) rtheCofactorIndex]
qed

theorem rTheCofactorIndexSteps:
  forall i, j, k: Nat;
  rtheCofactorIndex(i, j, peano.succ(k)) =
  rtheGapTo(rtheGapTo(i, j), peano.succ(k))
proof
  @conclusion |
    forall i, j, k: Nat;
      rtheCofactorIndex(i, j, peano.succ(k)) =
      rtheGapTo(rtheGapTo(i, j), peano.succ(k))
    [by definition(1) rtheCofactorIndex]
qed

theorem rCappedRunZero:
  forall q, r: RPoly; forall g: Nat;
  rcappedRun(q, r, g, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall q, r: RPoly; forall g: Nat;
      rcappedRun(q, r, g, NAT_ZERO) = ZERO
    [by definition(0) rcappedRun]
qed

theorem rCappedRunSucc:
  forall q, r: RPoly; forall g, n: Nat;
  rcappedRun(q, r, g, peano.succ(n)) =
  real.add(rcappedRun(q, r, g, n),
  real.mul(rcoeff(q, n), rcoeff(r, rtheGapTo(g, n))))
proof
  @conclusion |
    forall q, r: RPoly; forall g, n: Nat;
      rcappedRun(q, r, g, peano.succ(n)) =
      real.add(rcappedRun(q, r, g, n),
      real.mul(rcoeff(q, n), rcoeff(r, rtheGapTo(g, n))))
    [by definition(1) rcappedRun]
qed

theorem rTripleTermMeaning:
  forall p, q, r: RPoly; forall i, j, k: Nat;
  rtripleTerm(p, q, r, i, j, k) =
  real.mul(real.mul(rcoeff(p, j), rcoeff(q, k)),
  rcoeff(r, rtheCofactorIndex(i, j, k)))
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, j, k: Nat;
      rtripleTerm(p, q, r, i, j, k) =
      real.mul(real.mul(rcoeff(p, j), rcoeff(q, k)),
      rcoeff(r, rtheCofactorIndex(i, j, k)))
    [by definition rtripleTerm]
qed

theorem rTripleRowZero:
  forall p, q, r: RPoly; forall i, j: Nat;
  rtripleRow(p, q, r, i, j, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, j: Nat;
