theorem rSegmentZero:
  forall p, q: RPoly; forall j, c: Nat;
  rsegmentOf(p, q, j, c, NAT_ZERO) = real.mul(rcoeff(p, j), rcoeff(q, c))
proof
  @conclusion |
    forall p, q: RPoly; forall j, c: Nat;
      rsegmentOf(p, q, j, c, NAT_ZERO) = real.mul(rcoeff(p, j), rcoeff(q, c))
    [by definition(0) rsegmentOf]
