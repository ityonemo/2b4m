theorem rTripleDiagSucc:
  forall p, q, r: RPoly; forall i, m, c: Nat;
  rtripleDiag(p, q, r, i, m, peano.succ(c)) =
  real.add(rtripleDiag(p, q, r, i, m, c),
  rtripleTerm(p, q, r, i, c, rtheGapTo(m, c)))
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, m, c: Nat;
      rtripleDiag(p, q, r, i, m, peano.succ(c)) =
      real.add(rtripleDiag(p, q, r, i, m, c),
      rtripleTerm(p, q, r, i, c, rtheGapTo(m, c)))
    [by definition(1) rtripleDiag]
qed

