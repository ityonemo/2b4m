theorem rTripleRowSucc:
  forall p, q, r: RPoly; forall i, j, n: Nat;
  rtripleRow(p, q, r, i, j, peano.succ(n)) =
  real.add(rtripleRow(p, q, r, i, j, n), rtripleTerm(p, q, r, i, j, n))
proof
  @conclusion |
    forall p, q, r: RPoly; forall i, j, n: Nat;
      rtripleRow(p, q, r, i, j, peano.succ(n)) =
      real.add(rtripleRow(p, q, r, i, j, n), rtripleTerm(p, q, r, i, j, n))
