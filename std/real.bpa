// std/real.bpa — the REAL NUMBERS ℝ as an axiomatic COMPLETE ordered field, with
// the rationals ℚ living inside via the predicate `isRational`. ℝ models
// std/field-order.bpa (inheriting the field + ordered-field corpus) and adds the
// least-upper-bound (completeness) axiom.
//
// The rationals-inside-ℝ are marked by `isRational`, an OPAQUE predicate with
// closure axioms (contains 0/1, closed under +, ×, neg, AND recip — the rationals
// are a subFIELD, unlike the integers-in-ℚ which stop short of recip). There is no
// `fromRational` embedding FUNCTION: cross-sort structure, when a proof needs it, is
// carried by carving `sort SomeRat = Real where isRational` + a guarded model, not
// by a homomorphism. The predicate exists to STATE facts about the rationals
// (√2 ∉ ℚ, density, …) and to seed that carve.
//
// ℝ is POSTULATED, not constructed: constructing it (Cauchy sequences / Dedekind
// cuts of ℚ) needs sets and quotient types bpa lacks. Completeness is just an
// axiom — a predicate-argument axiom shaped like the existing nonnegInduction
// schema. The rationals-are-dense / ℝ-is-the-completion facts rest on categoricity,
// not a construction.

import field <<< "std/field.bpa"
import field_order <<< "std/field-order.bpa"
import integer <<< "std/integer.bpa"
import peano <<< "std/peano.bpa"
import rational <<< "std/rational.bpa"

sort Real
const ZERO: Real
const ONE: Real
func add(a: Real, b: Real): Real
func mul(a: Real, b: Real): Real
func neg(a: Real): Real
func recip(a: Real): Real
pred less_than(a: Real, b: Real)

// -- ordered-field axioms (discharge the ordered-field model below) ----------
axiom addIsAssociative: forall a, b, c: Real; add(add(a, b), c) = add(a, add(b, c))
axiom addZeroLeft: forall a: Real; add(ZERO, a) = a
axiom addNegLeft: forall a: Real; add(neg(a), a) = ZERO
axiom addIsCommutative: forall a, b: Real; add(a, b) = add(b, a)
axiom mulIsAssociative: forall a, b, c: Real; mul(mul(a, b), c) = mul(a, mul(b, c))
axiom mulAddDistribLeft: forall a, b, c: Real; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
axiom mulAddDistribRight: forall a, b, c: Real; mul(add(a, b), c) = add(mul(a, c), mul(b, c))
axiom mulIsCommutative: forall a, b: Real; mul(a, b) = mul(b, a)
axiom mulOneLeft: forall a: Real; mul(ONE, a) = a
axiom fieldInverse: forall a: Real; a != ZERO -> mul(a, recip(a)) = ONE
axiom oneNotZero: ONE != ZERO
axiom lessThanIrreflexive: forall a: Real; not less_than(a, a)
axiom lessThanTransitive: forall a, b, c: Real; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
axiom lessThanTrichotomy: forall a, b: Real; less_than(a, b) or a = b or less_than(b, a)
axiom lessThanAddRight: forall a, b, c: Real; less_than(a, b) -> less_than(add(a, c), add(b, c))
axiom lessThanAddCancel: forall a, b, c: Real; less_than(add(a, c), add(b, c)) -> less_than(a, b)
axiom positiveProduct: forall a, b: Real; less_than(ZERO, a) -> less_than(ZERO, b) -> less_than(ZERO, mul(a, b))

define less_or_equal(a: Real, b: Real) = less_than(a, b) or a = b

// ℝ is an ordered field: its ALGEBRA model (cited for field/order theorems).
model RealOrderedField {
  field_order.OrderedField: Real
  field_order.ZERO: ZERO
  field_order.ONE: ONE
  field_order.add: add
  field_order.mul: mul
  field_order.neg: neg
  field_order.recip: recip
  field_order.less_than: less_than
  field_order.addIsAssociative <- addIsAssociative
  field_order.addZeroLeft <- addZeroLeft
  field_order.addNegLeft <- addNegLeft
  field_order.addIsCommutative <- addIsCommutative
  field_order.mulIsAssociative <- mulIsAssociative
  field_order.mulAddDistribLeft <- mulAddDistribLeft
  field_order.mulAddDistribRight <- mulAddDistribRight
  field_order.mulIsCommutative <- mulIsCommutative
  field_order.mulOneLeft <- mulOneLeft
  field_order.fieldInverse <- fieldInverse
  field_order.oneNotZero <- oneNotZero
  field_order.lessThanIrreflexive <- lessThanIrreflexive
  field_order.lessThanTransitive <- lessThanTransitive
  field_order.lessThanTrichotomy <- lessThanTrichotomy
  field_order.lessThanAddRight <- lessThanAddRight
  field_order.lessThanAddCancel <- lessThanAddCancel
  field_order.positiveProduct <- positiveProduct
}

// 0 < 1, transferred from the ordered-field corpus (a basic order fact several
// downstream files — e.g. std/real-sqrt.bpa — need under a bare name).
theorem zeroLessThanOne: less_than(ZERO, ONE)
proof
  @conclusion |
    less_than(ZERO, ONE)
    [using model(RealOrderedField) field_order.zeroLessThanOne]
qed

// -- completeness (the least-upper-bound axiom) -----------------------------
// The distinguishing property of ℝ, POSTULATED as a predicate-argument axiom
// (like std/integer.bpa's nonnegInduction schema). A set of reals is given by a
// predicate `s: Real -> Prop`. Completeness: any nonempty, bounded-above set has a
// LEAST upper bound. The upper-bound / least-upper-bound conditions are spelled
// inline (higher-order args are only allowed in axiom/schema headers, not `define`).
//   nonempty:        exists x; s(x)
//   bounded above:   exists m; forall x; s(x) -> x <= m
//   least upper bnd: exists m; (forall x; s(x) -> x <= m)               [m bounds s]
//                      and (forall b; (forall x; s(x) -> x <= b) -> m <= b)  [least]
axiom completeness(s: Real -> Prop):
  (exists x: Real; s(x))
  -> (exists m: Real; forall x: Real; s(x) -> less_or_equal(x, m))
  -> exists m: Real;
  (forall x: Real; s(x) -> less_or_equal(x, m))
  and (forall b: Real; (forall x: Real; s(x) -> less_or_equal(x, b)) -> less_or_equal(m, b))

// -- the rationals inside ℝ (a predicate, NOT an embedding function) ----------
// `isRational` marks the rational subfield of ℝ — an OPAQUE predicate pinned down by
// closure axioms: it contains 0 and 1 and is closed under +, ×, neg, AND recip (of a
// nonzero rational). Closure under recip is what makes this a subFIELD — in contrast
// to isInteger on ℚ, which stops at the subring. The predicate exists to STATE facts
// about the rationals (√2 ∉ ℚ, density) and to seed a `Real where isRational` carve.
pred isRational(x: Real)
axiom isRationalZero: isRational(ZERO)
axiom isRationalOne: isRational(ONE)
axiom isRationalAdd: forall a, b: Real; isRational(a) -> isRational(b) -> isRational(add(a, b))
axiom isRationalMul: forall a, b: Real; isRational(a) -> isRational(b) -> isRational(mul(a, b))
axiom isRationalNeg: forall a: Real; isRational(a) -> isRational(neg(a))
axiom isRationalRecip: forall a: Real; isRational(a) -> a != ZERO -> isRational(recip(a))

model RealField {
  field.Field: Real
  field.ZERO: ZERO
  field.ONE: ONE
  field.add: add
  field.mul: mul
  field.neg: neg
  field.recip: recip
  field.addIsAssociative <- addIsAssociative
  field.addZeroLeft <- addZeroLeft
  field.addNegLeft <- addNegLeft
  field.addIsCommutative <- addIsCommutative
  field.mulIsAssociative <- mulIsAssociative
  field.mulAddDistribLeft <- mulAddDistribLeft
  field.mulAddDistribRight <- mulAddDistribRight
  field.mulIsCommutative <- mulIsCommutative
  field.mulOneLeft <- mulOneLeft
  field.fieldInverse <- fieldInverse
  field.oneNotZero <- oneNotZero
}

// -- the integers inside ℝ (a predicate, NOT an embedding function) ----------
// `isInteger` marks the integer subring of ℝ — an OPAQUE predicate pinned down by
// closure axioms: it contains 0 and 1 and is closed under +, ×, and neg. It is
// deliberately NOT closed under recip — that is exactly what separates the integers
// (a subRING) from a subfield. This is the carve a future `sort SomeInt = Real where
// isInteger` + guarded ℤ-theorem-transfer model would build on.
pred isInteger(q: Real)
axiom isIntegerZero: isInteger(ZERO)
axiom isIntegerOne: isInteger(ONE)
axiom isIntegerAdd: forall a, b: Real; isInteger(a) -> isInteger(b) -> isInteger(add(a, b))
axiom isIntegerMul: forall a, b: Real; isInteger(a) -> isInteger(b) -> isInteger(mul(a, b))
axiom isIntegerNeg: forall a: Real; isInteger(a) -> isInteger(neg(a))

// -- successor / predecessor on ℝ (the discrete step, for the integer model) --
// ℤ's theory is built on succ/prev; to model it on ℝ's integers we realize the
// step as +1 / −1. These are total on ℝ (they step ANY rational by one) but only
// the integer-model cites them, guarded to the isInteger cut.
func succ(q: Real): Real
func prev(q: Real): Real
func sub(a: Real, b: Real): Real
axiom succDefinition: forall q: Real; succ(q) = add(q, ONE)
axiom prevDefinition: forall q: Real; prev(q) = add(q, neg(ONE))
axiom subDefinition: forall a, b: Real; sub(a, b) = add(a, neg(b))

// -- the naturals inside ℝ (nonneg integers) --------------------------------
// `isNatural` marks the non-negative integers of ℝ — the ℕ cut. It is the ℤ cut
// intersected with ≥0: contains 0, closed under succ, and every natural is an
// integer. This is the source cut for the guarded ℕ (peano) model.
pred isNatural(q: Real)
axiom isNaturalZero: isNatural(ZERO)
axiom isNaturalSucc: forall q: Real; isNatural(q) -> isNatural(succ(q))
axiom isNaturalIsInteger: forall q: Real; isNatural(q) -> isInteger(q)
axiom isNaturalSuccNotZero: forall q: Real; isNatural(q) -> succ(q) != ZERO
// every integer is a natural or the negation of one (ℤ = ℕ ∪ −ℕ) — the intCases
// obligation of the integer model, on the cut.
axiom integerCases: forall q: Real; isInteger(q) -> (isNatural(q) or isNatural(neg(q)))

// -- integer succ/prev closure ----------------------------------------------
axiom isIntegerSucc: forall q: Real; isInteger(q) -> isInteger(succ(q))
axiom isIntegerPrev: forall q: Real; isInteger(q) -> isInteger(prev(q))

// -- induction on the cuts (the minimality axioms) --------------------------
// Neither induction principle is derivable from ℝ's ordered-field axioms — the
// ordered-field theory has models with non-standard "integers" that satisfy every
// closure axiom yet are not reached from 0 by finitely many ±1 steps. Induction is
// exactly the minimality (smallest subring/submonoid containing 1) that pins the
// cut to the STANDARD integers/naturals. So it is POSTULATED, mirroring peano's
// `induction`, integer's `nonnegInduction`, and real's `completeness`. These
// discharge the induction obligations of the ℤ / ℕ models.
axiom naturalInduction(prop: Real -> Prop):
  prop(ZERO)
  -> (forall k: Real; isNatural(k) -> prop(k) -> prop(succ(k)))
  -> forall n: Real; isNatural(n) -> prop(n)

// The SAME natural induction with a redundant `isInteger` guard on each bound
// variable — the exact shape the IntegersInReal model's remap of ℤ's
// `nonnegInduction` demands (ℤ's `Int` binder becomes isInteger, its `nonneg`
// becomes isNatural, so both guards appear). Every natural is an integer, so the
// isInteger guards carry no content; this discharges the model's induction
// obligation. Derived from naturalInduction by dropping the extra antecedents.
theorem naturalInductionOnInteger(prop: Real -> Prop):
  prop(ZERO)
  -> (forall k: Real; isInteger(k) -> isNatural(k) -> prop(k) -> prop(succ(k)))
  -> forall n: Real; isInteger(n) -> isNatural(n) -> prop(n)
proof
  @given-base |
    assume prop(ZERO) {
      @given-step |
        assume forall k: Real; isInteger(k) -> isNatural(k) -> prop(k) -> prop(succ(k)) {
          @base |
            prop(ZERO)
            [by hypothesis given-base]
          @doubled-step |
            forall k: Real; isInteger(k) -> isNatural(k) -> prop(k) -> prop(succ(k))
            [by hypothesis given-step]
          // drop the isInteger guard: a natural IS an integer, so re-supply it.
          @generalize-k |
            fix k: Real {
              @given-k-natural |
                assume isNatural(k) {
                  @k-natural |
                    isNatural(k)
                    [by hypothesis given-k-natural]
                  @k-integer |
                    isInteger(k)
                    [using specialize isNaturalIsInteger(k) k-natural]
                  @step-at-k |
                    prop(k) -> prop(succ(k))
                    [using specialize doubled-step(k) k-integer k-natural]
                }
              @k-natural-implies-step |
                isNatural(k) -> prop(k) -> prop(succ(k))
                [by implies_intro given-k-natural]
            }
          @plain-step |
            forall k: Real; isNatural(k) -> prop(k) -> prop(succ(k))
            [by forall_intro generalize-k]
          @natural-conclusion |
            forall n: Real; isNatural(n) -> prop(n)
            [using instantiation naturalInduction((fun m: Real => prop(m))) base plain-step]
          @generalize-n |
            fix n: Real {
              @given-n-integer |
                assume isInteger(n) {
                  @given-n-natural |
                    assume isNatural(n) {
                      @n-natural |
                        isNatural(n)
                        [by hypothesis given-n-natural]
                      @prop-n |
                        prop(n)
                        [using specialize natural-conclusion(n) n-natural]
                    }
                  @n-natural-implies-prop |
                    isNatural(n) -> prop(n)
                    [by implies_intro given-n-natural]
                }
              @n-integer-implies-rest |
                isInteger(n) -> isNatural(n) -> prop(n)
                [by implies_intro given-n-integer]
            }
          @conclusion-with-guards |
            forall n: Real; isInteger(n) -> isNatural(n) -> prop(n)
            [by forall_intro generalize-n]
        }
      @step-implies-conclusion |
        (forall k: Real; isInteger(k) -> isNatural(k) -> prop(k) -> prop(succ(k)))
          -> forall n: Real; isInteger(n) -> isNatural(n) -> prop(n)
        [by implies_intro given-step]
    }
  @conclusion |
    prop(ZERO)
      -> (forall k: Real; isInteger(k) -> isNatural(k) -> prop(k) -> prop(succ(k)))
      -> forall n: Real; isInteger(n) -> isNatural(n) -> prop(n)
    [by implies_intro given-base]
qed
// integerInduction is DERIVED (a theorem, below) from naturalInduction +
// integerCases + the sign lemmas — see the "-- integer induction (derived)"
// section after the discharge theorems. It is no longer a primitive axiom: the ℤ
// minimality is already carried by naturalInduction, and bidirectional integer
// induction is the reflection of it across the sign split (ℤ = ℕ ∪ −ℕ), exactly
// as std/integer.bpa derives its own `induction` from nonnegInduction + intCases.

// -- ring-lemma shims for the bare `polynomial` accelerant -------------------
// `polynomial` (self-scope, no theory arg) resolves its ring vocabulary by BARE
// name in THIS file's scope. ℝ's own AXIOMS already supply the assoc/comm/distrib
// /identity/inverse lemmas under the names polynomial expects; these SHIMS add the
// remaining DERIVED folds + the two AC sort-swaps it needs — each proved directly
// from ℝ's axioms (the same short derivations field.bpa/ring.bpa use). This is the
// per-model cost of using a bare-name accelerant on a `model`-based sort (ℝ's
// symbols are its own, not field's — a model transfers theorems, not names).

// Each is a one-line transfer of field's like-named theorem through RealField
// (field.bpa proves them all; the model carries them onto ℝ's symbols).
theorem mulOneRight: forall a: Real; mul(a, ONE) = a
proof
  @conclusion |
    forall a: Real; mul(a, ONE) = a
    [using model(RealField) field.mulOneRight]
qed

theorem addZeroRight: forall a: Real; add(a, ZERO) = a
proof
  @conclusion |
    forall a: Real; add(a, ZERO) = a
    [using model(RealField) field.addZeroRight]
qed

theorem addNegRight: forall a: Real; add(a, neg(a)) = ZERO
proof
  @conclusion |
    forall a: Real; add(a, neg(a)) = ZERO
    [using model(RealField) field.addNegRight]
qed

theorem mulZeroRight: forall a: Real; mul(a, ZERO) = ZERO
proof
  @conclusion |
    forall a: Real; mul(a, ZERO) = ZERO
    [using model(RealField) field.mulZeroRight]
qed

theorem mulZeroLeft: forall a: Real; mul(ZERO, a) = ZERO
proof
  @conclusion |
    forall a: Real; mul(ZERO, a) = ZERO
    [using model(RealField) field.mulZeroLeft]
qed

theorem mulLeftSwap: forall x, y, r: Real; mul(x, mul(y, r)) = mul(y, mul(x, r))
proof
  @conclusion |
    forall x, y, r: Real; mul(x, mul(y, r)) = mul(y, mul(x, r))
    [using model(RealField) field.mulLeftSwap]
qed

theorem addLeftSwap: forall x, y, r: Real; add(x, add(y, r)) = add(y, add(x, r))
proof
  @conclusion |
    forall x, y, r: Real; add(x, add(y, r)) = add(y, add(x, r))
    [using model(RealField) field.addLeftSwap]
qed

// neg-distribution folds, so `polynomial` pushes neg to the leaves over signed ℝ
// expressions (needed by the negSucc/negPrev/mulPrevLeft discharge theorems).
theorem negNeg: forall a: Real; neg(neg(a)) = a
proof
  @conclusion |
    forall a: Real; neg(neg(a)) = a
    [using model(RealField) field.negNeg]
qed

theorem negAdd: forall a, b: Real; neg(add(a, b)) = add(neg(a), neg(b))
proof
  @conclusion |
    forall a, b: Real; neg(add(a, b)) = add(neg(a), neg(b))
    [using model(RealField) field.negAdd]
qed

theorem mulNegLeft: forall a, b: Real; mul(neg(a), b) = neg(mul(a, b))
proof
  @conclusion |
    forall a, b: Real; mul(neg(a), b) = neg(mul(a, b))
    [using model(RealField) field.mulNegLeft]
qed

theorem mulNegRight: forall a, b: Real; mul(a, neg(b)) = neg(mul(a, b))
proof
  @conclusion |
    forall a, b: Real; mul(a, neg(b)) = neg(mul(a, b))
    [using model(RealField) field.mulNegRight]
qed

// -- order: nonnegativity helpers -------------------------------------------

// 0 ≤ 1, weakened from the strict fact 0 < 1 (zeroLessThanOne).
theorem zeroLessOrEqualOne: less_or_equal(ZERO, ONE)
proof
  @zero-less-than-one |
    less_than(ZERO, ONE)
    [by theorem zeroLessThanOne]
  @conclusion |
    less_or_equal(ZERO, ONE)
    [by or_intro_left zero-less-than-one]
qed

// the product of two nonnegatives is nonnegative. Case on each factor being 0 or
// strictly positive: if either is 0 the product is 0 (≤ itself); if both are
// strictly positive, positiveProduct gives 0 < xy, hence 0 ≤ xy.
theorem mulNonneg: forall x, y: Real; less_or_equal(ZERO, x) -> less_or_equal(ZERO, y) -> less_or_equal(ZERO, mul(x, y))
proof
  @generalize-x |
    fix x: Real {
      @generalize-y |
        fix y: Real {
          @given-x-nonneg |
            assume less_or_equal(ZERO, x) {
              @given-y-nonneg |
                assume less_or_equal(ZERO, y) {
                  @x-nonneg |
                    less_than(ZERO, x) or ZERO = x
                    [by hypothesis given-x-nonneg]
                  @conclusion-product-nonneg |
                    less_or_equal(ZERO, mul(x, y))
                    case x-nonneg {
                      @when-x-positive |
                        assume less_than(ZERO, x) {
                          @x-positive |
                            less_than(ZERO, x)
                            [by hypothesis when-x-positive]
                          @y-nonneg |
                            less_than(ZERO, y) or ZERO = y
                            [by hypothesis given-y-nonneg]
                          @conclusion-x-positive |
                            less_or_equal(ZERO, mul(x, y))
                            case y-nonneg {
                              @when-y-positive |
                                assume less_than(ZERO, y) {
                                  @y-positive |
                                    less_than(ZERO, y)
                                    [by hypothesis when-y-positive]
                                  @product-positive |
                                    less_than(ZERO, mul(x, y))
                                    [using specialize positiveProduct(x, y) x-positive y-positive]
                                  @conclusion-both-positive |
                                    less_or_equal(ZERO, mul(x, y))
                                    [by or_intro_left product-positive]
                                }
                              @when-y-zero |
                                assume ZERO = y {
                                  @y-is-zero |
                                    ZERO = y
                                    [by hypothesis when-y-zero]
                                  @product-with-zero |
                                    mul(x, ZERO) = ZERO
                                    [using specialize mulZeroRight(x)]
                                  @product-is-zero |
                                    mul(x, y) = ZERO
                                    [by rewrite y-is-zero product-with-zero]
                                  @zero-equals-product |
                                    ZERO = mul(x, y)
                                    [by symmetry product-is-zero]
                                  @conclusion-y-zero |
                                    less_or_equal(ZERO, mul(x, y))
                                    [by or_intro_right zero-equals-product]
                                }
                            }
                        }
                      @when-x-zero |
                        assume ZERO = x {
                          @x-is-zero |
                            ZERO = x
                            [by hypothesis when-x-zero]
                          @zero-times-y |
                            mul(ZERO, y) = ZERO
                            [using specialize mulZeroLeft(y)]
                          @product-is-zero |
                            mul(x, y) = ZERO
                            [by rewrite x-is-zero zero-times-y]
                          @zero-equals-product |
                            ZERO = mul(x, y)
                            [by symmetry product-is-zero]
                          @conclusion-x-zero |
                            less_or_equal(ZERO, mul(x, y))
                            [by or_intro_right zero-equals-product]
                        }
                    }
                }
              @y-nonneg-implies |
                less_or_equal(ZERO, y) -> less_or_equal(ZERO, mul(x, y))
                [by implies_intro given-y-nonneg]
            }
          @x-nonneg-implies |
            less_or_equal(ZERO, x) -> less_or_equal(ZERO, y) -> less_or_equal(ZERO, mul(x, y))
            [by implies_intro given-x-nonneg]
        }
      @discharge-y |
        forall y: Real; less_or_equal(ZERO, x) -> less_or_equal(ZERO, y) -> less_or_equal(ZERO, mul(x, y))
        [by forall_intro generalize-y]
    }
  @conclusion |
    forall x, y: Real; less_or_equal(ZERO, x) -> less_or_equal(ZERO, y) -> less_or_equal(ZERO, mul(x, y))
    [by forall_intro generalize-x]
qed

// a negative real has a positive negation: x < 0 ⟹ 0 < −x. Add −x to both sides
// of x < 0 and simplify the endpoints (x + (−x) = 0, 0 + (−x) = −x).
theorem negOfNegativeIsPositive: forall x: Real; less_than(x, ZERO) -> less_than(ZERO, neg(x))
proof
  @generalize-x |
    fix x: Real {
      @given-x-negative |
        assume less_than(x, ZERO) {
          @x-negative |
            less_than(x, ZERO)
            [by hypothesis given-x-negative]
          @shift-by-neg |
            less_than(add(x, neg(x)), add(ZERO, neg(x)))
            [using specialize lessThanAddRight(x, ZERO, neg(x)) x-negative]
          @x-plus-neg |
            add(x, neg(x)) = ZERO
            [using specialize addNegRight(x)]
          @zero-plus-neg |
            add(ZERO, neg(x)) = neg(x)
            [using specialize addZeroLeft(neg(x))]
          @shift-left |
            less_than(ZERO, add(ZERO, neg(x)))
            [by rewrite x-plus-neg shift-by-neg]
          @conclusion-neg-positive |
            less_than(ZERO, neg(x))
            [by rewrite zero-plus-neg shift-left]
        }
      @negative-implies-positive-neg |
        less_than(x, ZERO) -> less_than(ZERO, neg(x))
        [by implies_intro given-x-negative]
    }
  @conclusion |
    forall x: Real; less_than(x, ZERO) -> less_than(ZERO, neg(x))
    [by forall_intro generalize-x]
qed

// (−x)·(−x) = x·x — the square is sign-independent.
theorem negTimesNegIsSquare: forall x: Real; mul(neg(x), neg(x)) = mul(x, x)
proof
  @generalize-x |
    fix x: Real {
      @neg-left |
        mul(neg(x), neg(x)) = neg(mul(x, neg(x)))
        [using specialize mulNegLeft(x, neg(x))]
      @neg-right |
        mul(x, neg(x)) = neg(mul(x, x))
        [using specialize mulNegRight(x, x)]
      @neg-of-neg |
        neg(neg(mul(x, x))) = mul(x, x)
        [using specialize negNeg(mul(x, x))]
      @square-neg-neg |
        mul(neg(x), neg(x)) = neg(neg(mul(x, x)))
        [by rewrite neg-right neg-left]
      @conclusion-neg-square |
        mul(neg(x), neg(x)) = mul(x, x)
        [using chain square-neg-neg neg-of-neg]
    }
  @conclusion |
    forall x: Real; mul(neg(x), neg(x)) = mul(x, x)
    [by forall_intro generalize-x]
qed

// every square is nonnegative: 0 ≤ x·x. Trichotomy — x>0 or x=0 gives it via
// mulNonneg; x<0 gives 0<(−x)(−x)=x·x via positiveProduct.
theorem squareNonneg: forall x: Real; less_or_equal(ZERO, mul(x, x))
proof
  @generalize-x |
    fix x: Real {
      @trichotomy |
        less_than(ZERO, x) or ZERO = x or less_than(x, ZERO)
        [using specialize lessThanTrichotomy(ZERO, x)]
      @conclusion-square-nonneg |
        less_or_equal(ZERO, mul(x, x))
        case trichotomy {
          @when-positive |
            assume less_than(ZERO, x) {
              @x-positive |
                less_than(ZERO, x)
                [by hypothesis when-positive]
              @square-positive |
                less_than(ZERO, mul(x, x))
                [using specialize positiveProduct(x, x) x-positive x-positive]
              @conclusion-when-positive |
                less_or_equal(ZERO, mul(x, x))
                [by or_intro_left square-positive]
            }
          @when-zero |
            assume ZERO = x {
              @x-is-zero |
                ZERO = x
                [by hypothesis when-zero]
              @zero-times-zero |
                mul(ZERO, ZERO) = ZERO
                [using specialize mulZeroLeft(ZERO)]
              @square-with-zero |
                mul(x, x) = ZERO
                [by rewrite x-is-zero zero-times-zero]
              @zero-equals-square |
                ZERO = mul(x, x)
                [by symmetry square-with-zero]
              @conclusion-when-zero |
                less_or_equal(ZERO, mul(x, x))
                [by or_intro_right zero-equals-square]
            }
          @when-negative |
            assume less_than(x, ZERO) {
              @x-negative |
                less_than(x, ZERO)
                [by hypothesis when-negative]
              @neg-positive |
                less_than(ZERO, neg(x))
                [using specialize negOfNegativeIsPositive(x) x-negative]
              @neg-square-positive |
                less_than(ZERO, mul(neg(x), neg(x)))
                [using specialize positiveProduct(neg(x), neg(x)) neg-positive neg-positive]
              @neg-square-is-square |
                mul(neg(x), neg(x)) = mul(x, x)
                [using specialize negTimesNegIsSquare(x)]
              @square-positive |
                less_than(ZERO, mul(x, x))
                [by rewrite neg-square-is-square neg-square-positive]
              @conclusion-when-negative |
                less_or_equal(ZERO, mul(x, x))
                [by or_intro_left square-positive]
            }
        }
    }
  @conclusion |
    forall x: Real; less_or_equal(ZERO, mul(x, x))
    [by forall_intro generalize-x]
qed

// the sum of two nonnegatives is nonnegative: 0 ≤ a and 0 ≤ b ⟹ 0 ≤ a+b. Case on
// a (positive or zero); in each, case on b, closing with lessThanAddRight/transitivity
// (positive+anything, or the zero folds).
theorem addNonneg: forall a, b: Real; less_or_equal(ZERO, a) -> less_or_equal(ZERO, b) -> less_or_equal(ZERO, add(a, b))
proof
  @generalize-a |
    fix a: Real {
      @generalize-b |
        fix b: Real {
          @given-a-nonneg |
            assume less_or_equal(ZERO, a) {
              @given-b-nonneg |
                assume less_or_equal(ZERO, b) {
                  @a-nonneg |
                    less_than(ZERO, a) or ZERO = a
                    [by hypothesis given-a-nonneg]
                  @b-nonneg |
                    less_than(ZERO, b) or ZERO = b
                    [by hypothesis given-b-nonneg]
                  // 0 ≤ b gives b ≤ a+b when 0 ≤ a? We instead prove 0 ≤ a+b directly:
                  // shift 0 ≤ b by +a is awkward; use: from 0 ≤ a, a ≤ a+b (add b to 0 ≤... )
                  // Simplest: 0 ≤ a means 0+b ≤ a+b, i.e. b ≤ a+b; with 0 ≤ b, transitivity.
                  @conclusion-sum-nonneg |
                    less_or_equal(ZERO, add(a, b))
                    case a-nonneg {
                      @when-a-positive |
                        assume less_than(ZERO, a) {
                          @a-positive |
                            less_than(ZERO, a)
                            [by hypothesis when-a-positive]
                          // 0 < a ⟹ 0+b < a+b ⟹ b < a+b.
                          @shift-a |
                            less_than(add(ZERO, b), add(a, b))
                            [using specialize lessThanAddRight(ZERO, a, b) a-positive]
                          @zero-plus-b |
                            add(ZERO, b) = b
                            [using specialize addZeroLeft(b)]
                          @b-less-sum |
                            less_than(b, add(a, b))
                            [by rewrite zero-plus-b shift-a]
                          @conclusion-a-positive |
                            less_or_equal(ZERO, add(a, b))
                            case b-nonneg {
                              @when-b-positive |
                                assume less_than(ZERO, b) {
                                  @b-positive |
                                    less_than(ZERO, b)
                                    [by hypothesis when-b-positive]
                                  @zero-less-sum |
                                    less_than(ZERO, add(a, b))
                                    [using specialize lessThanTransitive(ZERO, b, add(a, b)) b-positive b-less-sum]
                                  @conclusion-bp |
                                    less_or_equal(ZERO, add(a, b))
                                    [by or_intro_left zero-less-sum]
                                }
                              @when-b-zero |
                                assume ZERO = b {
                                  @b-is-zero |
                                    ZERO = b
                                    [by hypothesis when-b-zero]
                                  @zero-less-sum |
                                    less_than(ZERO, add(a, b))
                                    [by rewrite b-is-zero b-less-sum]
                                  @conclusion-bz |
                                    less_or_equal(ZERO, add(a, b))
                                    [by or_intro_left zero-less-sum]
                                }
                            }
                        }
                      @when-a-zero |
                        assume ZERO = a {
                          @a-is-zero |
                            ZERO = a
                            [by hypothesis when-a-zero]
                          @zero-plus-b |
                            add(ZERO, b) = b
                            [using specialize addZeroLeft(b)]
                          @sum-is-b |
                            add(a, b) = b
                            [by rewrite a-is-zero zero-plus-b]
                          @zero-le-b |
                            less_or_equal(ZERO, b)
                            [by hypothesis given-b-nonneg]
                          @conclusion-a-zero |
                            less_or_equal(ZERO, add(a, b))
                            [by rewrite sum-is-b zero-le-b]
                        }
                    }
                }
              @b-nonneg-implies |
                less_or_equal(ZERO, b) -> less_or_equal(ZERO, add(a, b))
                [by implies_intro given-b-nonneg]
            }
          @a-nonneg-implies |
            less_or_equal(ZERO, a) -> less_or_equal(ZERO, b) -> less_or_equal(ZERO, add(a, b))
            [by implies_intro given-a-nonneg]
        }
      @discharge-b |
        forall b: Real; less_or_equal(ZERO, a) -> less_or_equal(ZERO, b) -> less_or_equal(ZERO, add(a, b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Real; less_or_equal(ZERO, a) -> less_or_equal(ZERO, b) -> less_or_equal(ZERO, add(a, b))
    [by forall_intro generalize-a]
qed

// -- smoke test (algebra model) ---------------------------------------------
theorem noZeroDivisors: forall a, b: Real; mul(a, b) = ZERO -> (a = ZERO or b = ZERO)
proof
  @conclusion |
    forall a, b: Real; mul(a, b) = ZERO -> (a = ZERO or b = ZERO)
    [using model(RealOrderedField) field_order.noZeroDivisors]
qed

// smoke test (containment predicate): a nonzero rational's reciprocal is a nonzero
// rational — closure under recip together with no-zero-divisors keeps it nonzero
// (if recip(a) were 0 then a·recip(a) = a·0 = 0, contradicting a·recip(a) = 1 ≠ 0).
theorem isRationalRecipNonzero: forall a: Real; isRational(a) -> a != ZERO -> isRational(recip(a))
proof
  @generalize-a |
    fix a: Real {
      @given-a-rational |
        assume isRational(a) {
          @given-a-nonzero |
            assume a != ZERO {
              @a-is-rational |
                isRational(a)
                [by hypothesis given-a-rational]
              @a-nonzero |
                a != ZERO
                [by hypothesis given-a-nonzero]
              @recip-is-rational |
                isRational(recip(a))
                [using specialize isRationalRecip(a) a-is-rational a-nonzero]
            }
          @a-nonzero-implies-recip-rational |
            a != ZERO -> isRational(recip(a))
            [by implies_intro given-a-nonzero]
        }
      @a-rational-implies-rest |
        isRational(a) -> a != ZERO -> isRational(recip(a))
        [by implies_intro given-a-rational]
    }
  @conclusion |
    forall a: Real; isRational(a) -> a != ZERO -> isRational(recip(a))
    [by forall_intro generalize-a]
qed

// -- discharge theorems for the guarded integer / natural models -------------
// Each proves an ℤ-theory (or ℕ-theory) axiom in its interpreted-on-ℝ form, so the
// model below can cite it with `<-`. The recursive-definition axioms become pure
// ℝ-ring identities once succ/prev/sub are unfolded — bare `polynomial` closes
// them after the defining rewrites; the nonneg-structure ones are the isNatural /
// isInteger axioms verbatim.

// succ/prev are mutually inverse: prev(succ q) = q and succ(prev q) = q.
theorem prevOfSucc: forall q: Real; prev(succ(q)) = q
proof
  @generalize-q |
    fix q: Real {
      @unfold-succ |
        succ(q) = add(q, ONE)
        [using specialize succDefinition(q)]
      @unfold-prev |
        prev(add(q, ONE)) = add(add(q, ONE), neg(ONE))
        [using specialize prevDefinition(add(q, ONE))]
      @prev-succ-expanded |
        prev(succ(q)) = add(add(q, ONE), neg(ONE))
        [using chain unfold-succ unfold-prev]
      @cancel |
        add(add(q, ONE), neg(ONE)) = q
        [using polynomial]
      @conclusion-prev-of-succ |
        prev(succ(q)) = q
        [using chain prev-succ-expanded cancel]
    }
  @conclusion |
    forall q: Real; prev(succ(q)) = q
    [by forall_intro generalize-q]
qed

theorem succOfPrev: forall q: Real; succ(prev(q)) = q
proof
  @generalize-q |
    fix q: Real {
      @unfold-prev |
        prev(q) = add(q, neg(ONE))
        [using specialize prevDefinition(q)]
      @unfold-succ |
        succ(add(q, neg(ONE))) = add(add(q, neg(ONE)), ONE)
        [using specialize succDefinition(add(q, neg(ONE)))]
      @succ-prev-expanded |
        succ(prev(q)) = add(add(q, neg(ONE)), ONE)
        [using chain unfold-prev unfold-succ]
      @cancel |
        add(add(q, neg(ONE)), ONE) = q
        [using polynomial]
      @conclusion-succ-of-prev |
        succ(prev(q)) = q
        [using chain succ-prev-expanded cancel]
    }
  @conclusion |
    forall q: Real; succ(prev(q)) = q
    [by forall_intro generalize-q]
qed

// ONE = succ(ZERO): succ(ZERO) = add(ZERO, ONE) = ONE.
theorem oneIsSuccZero: ONE = succ(ZERO)
proof
  @unfold-succ |
    succ(ZERO) = add(ZERO, ONE)
    [using specialize succDefinition(ZERO)]
  @add-zero |
    add(ZERO, ONE) = ONE
    [using specialize addZeroLeft(ONE)]
  @succ-zero-is-one |
    succ(ZERO) = ONE
    [using chain unfold-succ add-zero]
  @conclusion |
    ONE = succ(ZERO)
    [by symmetry succ-zero-is-one]
qed

// add(succ a, b) = succ(add a b): (a+1)+b = (a+b)+1.
theorem addSuccLeft: forall a, b: Real; add(succ(a), b) = succ(add(a, b))
proof
  @generalize-a |
    fix a: Real {
      @generalize-b |
        fix b: Real {
          @unfold-succ-a |
            succ(a) = add(a, ONE)
            [using specialize succDefinition(a)]
          @unfold-succ-sum |
            succ(add(a, b)) = add(add(a, b), ONE)
            [using specialize succDefinition(add(a, b))]
          // (a+1)+b: congruence-rewrite succ(a)→a+1 into a reflexive left side.
          @left-reflexive |
            add(succ(a), b) = add(succ(a), b)
            [by reflexivity]
          @left-expanded |
            add(succ(a), b) = add(add(a, ONE), b)
            [by rewrite unfold-succ-a left-reflexive]
          @left-normal |
            add(add(a, ONE), b) = add(add(a, b), ONE)
            [using polynomial]
          @conclusion-add-succ-left |
            add(succ(a), b) = succ(add(a, b))
            [using chain left-expanded left-normal unfold-succ-sum]
        }
      @discharge-b |
        forall b: Real; add(succ(a), b) = succ(add(a, b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Real; add(succ(a), b) = succ(add(a, b))
    [by forall_intro generalize-a]
qed

// add(prev a, b) = prev(add a b): (a−1)+b = (a+b)−1.
theorem addPrevLeft: forall a, b: Real; add(prev(a), b) = prev(add(a, b))
proof
  @generalize-a |
    fix a: Real {
      @generalize-b |
        fix b: Real {
          @unfold-prev-a |
            prev(a) = add(a, neg(ONE))
            [using specialize prevDefinition(a)]
          @unfold-prev-sum |
            prev(add(a, b)) = add(add(a, b), neg(ONE))
            [using specialize prevDefinition(add(a, b))]
          @left-reflexive |
            add(prev(a), b) = add(prev(a), b)
            [by reflexivity]
          @left-expanded |
            add(prev(a), b) = add(add(a, neg(ONE)), b)
            [by rewrite unfold-prev-a left-reflexive]
          @left-normal |
            add(add(a, neg(ONE)), b) = add(add(a, b), neg(ONE))
            [using polynomial]
          @conclusion-add-prev-left |
            add(prev(a), b) = prev(add(a, b))
            [using chain left-expanded left-normal unfold-prev-sum]
        }
      @discharge-b |
        forall b: Real; add(prev(a), b) = prev(add(a, b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Real; add(prev(a), b) = prev(add(a, b))
    [by forall_intro generalize-a]
qed

// neg(ZERO) = ZERO.
theorem negZero: neg(ZERO) = ZERO
proof
  @conclusion |
    neg(ZERO) = ZERO
    [using model(RealField) field.negZero]
qed

// neg(succ n) = prev(neg n): −(n+1) = −n−1.
theorem negSucc: forall n: Real; neg(succ(n)) = prev(neg(n))
proof
  @generalize-n |
    fix n: Real {
      @unfold-succ |
        succ(n) = add(n, ONE)
        [using specialize succDefinition(n)]
      @unfold-prev |
        prev(neg(n)) = add(neg(n), neg(ONE))
        [using specialize prevDefinition(neg(n))]
      @neg-reflexive |
        neg(succ(n)) = neg(succ(n))
        [by reflexivity]
      @neg-expanded |
        neg(succ(n)) = neg(add(n, ONE))
        [by rewrite unfold-succ neg-reflexive]
      @neg-normal |
        neg(add(n, ONE)) = add(neg(n), neg(ONE))
        [using polynomial]
      @conclusion-neg-succ |
        neg(succ(n)) = prev(neg(n))
        [using chain neg-expanded neg-normal unfold-prev]
    }
  @conclusion |
    forall n: Real; neg(succ(n)) = prev(neg(n))
    [by forall_intro generalize-n]
qed

// neg(prev n) = succ(neg n): −(n−1) = −n+1.
theorem negPrev: forall n: Real; neg(prev(n)) = succ(neg(n))
proof
  @generalize-n |
    fix n: Real {
      @unfold-prev |
        prev(n) = add(n, neg(ONE))
        [using specialize prevDefinition(n)]
      @unfold-succ |
        succ(neg(n)) = add(neg(n), ONE)
        [using specialize succDefinition(neg(n))]
      @neg-reflexive |
        neg(prev(n)) = neg(prev(n))
        [by reflexivity]
      @neg-expanded |
        neg(prev(n)) = neg(add(n, neg(ONE)))
        [by rewrite unfold-prev neg-reflexive]
      @neg-normal |
        neg(add(n, neg(ONE))) = add(neg(n), ONE)
        [using polynomial]
      @conclusion-neg-prev |
        neg(prev(n)) = succ(neg(n))
        [using chain neg-expanded neg-normal unfold-succ]
    }
  @conclusion |
    forall n: Real; neg(prev(n)) = succ(neg(n))
    [by forall_intro generalize-n]
qed

// mul(succ a, b) = add(mul a b, b): (a+1)·b = a·b + b.
theorem mulSuccLeft: forall a, b: Real; mul(succ(a), b) = add(mul(a, b), b)
proof
  @generalize-a |
    fix a: Real {
      @generalize-b |
        fix b: Real {
          @unfold-succ |
            succ(a) = add(a, ONE)
            [using specialize succDefinition(a)]
          @left-reflexive |
            mul(succ(a), b) = mul(succ(a), b)
            [by reflexivity]
          @left-expanded |
            mul(succ(a), b) = mul(add(a, ONE), b)
            [by rewrite unfold-succ left-reflexive]
          @left-normal |
            mul(add(a, ONE), b) = add(mul(a, b), b)
            [using polynomial]
          @conclusion-mul-succ-left |
            mul(succ(a), b) = add(mul(a, b), b)
            [using chain left-expanded left-normal]
        }
      @discharge-b |
        forall b: Real; mul(succ(a), b) = add(mul(a, b), b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Real; mul(succ(a), b) = add(mul(a, b), b)
    [by forall_intro generalize-a]
qed

// mul(prev a, b) = add(mul a b, neg b): (a−1)·b = a·b − b.
theorem mulPrevLeft: forall a, b: Real; mul(prev(a), b) = add(mul(a, b), neg(b))
proof
  @generalize-a |
    fix a: Real {
      @generalize-b |
        fix b: Real {
          @unfold-prev |
            prev(a) = add(a, neg(ONE))
            [using specialize prevDefinition(a)]
          @left-reflexive |
            mul(prev(a), b) = mul(prev(a), b)
            [by reflexivity]
          @left-expanded |
            mul(prev(a), b) = mul(add(a, neg(ONE)), b)
            [by rewrite unfold-prev left-reflexive]
          @left-normal |
            mul(add(a, neg(ONE)), b) = add(mul(a, b), neg(b))
            [using polynomial]
          @conclusion-mul-prev-left |
            mul(prev(a), b) = add(mul(a, b), neg(b))
            [using chain left-expanded left-normal]
        }
      @discharge-b |
        forall b: Real; mul(prev(a), b) = add(mul(a, b), neg(b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Real; mul(prev(a), b) = add(mul(a, b), neg(b))
    [by forall_intro generalize-a]
qed

// succ is injective: succ(a) = succ(b) → a = b. On ℝ, succ(a) = a+1, so cancel the
// +1 — a = (a+1)−1 = (b+1)−1 = b, the two ±1 cancellations bridged by the premise.
theorem succInjective: forall a, b: Real; succ(a) = succ(b) -> a = b
proof
  @generalize-a |
    fix a: Real {
      @generalize-b |
        fix b: Real {
          @given-succ-eq |
            assume succ(a) = succ(b) {
              @unfold-succ-a |
                succ(a) = add(a, ONE)
                [using specialize succDefinition(a)]
              @unfold-succ-b |
                succ(b) = add(b, ONE)
                [using specialize succDefinition(b)]
              @succ-eq |
                succ(a) = succ(b)
                [by hypothesis given-succ-eq]
              // add(a,ONE) = add(b,ONE), bridging the two unfoldings.
              @sums-equal |
                add(a, ONE) = add(b, ONE)
                [using chain unfold-succ-a succ-eq unfold-succ-b]
              // a = (a+1)+(−1) = (b+1)+(−1) = b.
              @a-recovers |
                a = add(add(a, ONE), neg(ONE))
                [using polynomial]
              @b-recovers |
                add(add(b, ONE), neg(ONE)) = b
                [using polynomial]
              @a-as-shifted-b |
                a = add(add(b, ONE), neg(ONE))
                [by rewrite sums-equal a-recovers]
              @conclusion-a-equals-b |
                a = b
                [using chain a-as-shifted-b b-recovers]
            }
          @succ-eq-implies-equal |
            succ(a) = succ(b) -> a = b
            [by implies_intro given-succ-eq]
        }
      @discharge-b |
        forall b: Real; succ(a) = succ(b) -> a = b
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Real; succ(a) = succ(b) -> a = b
    [by forall_intro generalize-a]
qed

// -- integer induction (derived) ---------------------------------------------
// Bidirectional induction over the isInteger cut, DERIVED from naturalInduction +
// integerCases + the sign lemmas (negZero/negSucc/negNeg). ℤ = ℕ ∪ −ℕ: the nonneg
// arm is naturalInduction directly; the nonpositive arm reflects it through the
// predicate prop(neg(·)), using negSucc to turn the successor step into the
// predecessor step. Mirrors std/integer.bpa's derivation of `induction` from
// nonnegInduction. This is why integerInduction need not be a separate axiom.
theorem integerInduction(prop: Real -> Prop):
  prop(ZERO)
  -> (forall k: Real; isInteger(k) -> prop(k) -> prop(succ(k)))
  -> (forall k: Real; isInteger(k) -> prop(k) -> prop(prev(k)))
  -> forall n: Real; isInteger(n) -> prop(n)
proof
  @given-base |
    assume prop(ZERO) {
      @base-case |
        prop(ZERO)
        [by hypothesis given-base]
      @given-successor-step |
        assume forall k: Real; isInteger(k) -> prop(k) -> prop(succ(k)) {
          @successor-step |
            forall k: Real; isInteger(k) -> prop(k) -> prop(succ(k))
            [by hypothesis given-successor-step]
          @given-predecessor-step |
            assume forall k: Real; isInteger(k) -> prop(k) -> prop(prev(k)) {
              @predecessor-step |
                forall k: Real; isInteger(k) -> prop(k) -> prop(prev(k))
                [by hypothesis given-predecessor-step]
              // sign facts cited once for reuse.
              @negZero-fact |
                neg(ZERO) = ZERO
                [by theorem negZero]
              @negSucc-fact |
                forall n: Real; neg(succ(n)) = prev(neg(n))
                [by theorem negSucc]
              @negNeg-fact |
                forall n: Real; neg(neg(n)) = n
                [by theorem negNeg]

              // -- NONNEG (natural) arm: naturalInduction on prop directly.
              // Its step needs only isNatural(k) (a natural is an integer).
              @natural-successor-step |
                fix k: Real {
                  @given-k-natural |
                    assume isNatural(k) {
                      @k-natural |
                        isNatural(k)
                        [by hypothesis given-k-natural]
                      @k-integer |
                        isInteger(k)
                        [using specialize isNaturalIsInteger(k) k-natural]
                      @step-at-k |
                        prop(k) -> prop(succ(k))
                        [using specialize successor-step(k) k-integer]
                    }
                  @natural-k-implies-step |
                    isNatural(k) -> prop(k) -> prop(succ(k))
                    [by implies_intro given-k-natural]
                }
              @natural-successor-step-for-all-k |
                forall k: Real; isNatural(k) -> prop(k) -> prop(succ(k))
                [by forall_intro natural-successor-step]
              @natural-induction-on-prop |
                forall n: Real; isNatural(n) -> prop(n)
                [using instantiation naturalInduction((fun m: Real => prop(m))) base-case natural-successor-step-for-all-k]

              // -- NONPOSITIVE arm: naturalInduction on Real(m) = prop(neg m).
              @reflected-base-case |
                prop(neg(ZERO))
                [by rewrite negZero-fact base-case]
              @reflected-successor-step |
                fix k: Real {
                  @given-k-natural-reflected |
                    assume isNatural(k) {
                      @k-natural-reflected |
                        isNatural(k)
                        [by hypothesis given-k-natural-reflected]
                      @k-integer-reflected |
                        isInteger(k)
                        [using specialize isNaturalIsInteger(k) k-natural-reflected]
                      @neg-k-integer |
                        isInteger(neg(k))
                        [using specialize isIntegerNeg(k) k-integer-reflected]
                      @predecessor-step-at-neg-k |
                        prop(neg(k)) -> prop(prev(neg(k)))
                        [using specialize predecessor-step(neg(k)) neg-k-integer]
                      @negSucc-at-k |
                        neg(succ(k)) = prev(neg(k))
                        [by forall_elim(k) negSucc-fact]
                      @reflected-step-at-k |
                        prop(neg(k)) -> prop(neg(succ(k)))
                        [by rewrite negSucc-at-k predecessor-step-at-neg-k]
                    }
                  @natural-k-implies-reflected-step |
                    isNatural(k) -> prop(neg(k)) -> prop(neg(succ(k)))
                    [by implies_intro given-k-natural-reflected]
                }
              @reflected-successor-step-for-all-k |
                forall k: Real; isNatural(k) -> prop(neg(k)) -> prop(neg(succ(k)))
                [by forall_intro reflected-successor-step]
              @reflected-natural-induction |
                forall n: Real; isNatural(n) -> prop(neg(n))
                [using instantiation naturalInduction((fun m: Real => prop(neg(m)))) reflected-base-case reflected-successor-step-for-all-k]

              // -- split any integer n by sign and discharge each arm.
              @generalize-n |
                fix n: Real {
                  @given-n-integer |
                    assume isInteger(n) {
                      @n-integer |
                        isInteger(n)
                        [by hypothesis given-n-integer]
                      @sign-split |
                        isNatural(n) or isNatural(neg(n))
                        [using specialize integerCases(n) n-integer]
                      @double-negation-of-n |
                        neg(neg(n)) = n
                        [by forall_elim(n) negNeg-fact]
                      @prop-at-n |
                        prop(n)
                        case sign-split {
                          @when-n-natural |
                            assume isNatural(n) {
                              @n-natural |
                                isNatural(n)
                                [by hypothesis when-n-natural]
                              @prop-at-n-natural |
                                prop(n)
                                [using specialize natural-induction-on-prop(n) n-natural]
                            }
                          @when-neg-n-natural |
                            assume isNatural(neg(n)) {
                              @neg-n-natural |
                                isNatural(neg(n))
                                [by hypothesis when-neg-n-natural]
                              @prop-at-double-neg |
                                prop(neg(neg(n)))
                                [using specialize reflected-natural-induction(neg(n)) neg-n-natural]
                              @prop-at-n-reflected |
                                prop(n)
                                [by rewrite double-negation-of-n prop-at-double-neg]
                            }
                        }
                    }
                  @n-integer-implies-prop |
                    isInteger(n) -> prop(n)
                    [by implies_intro given-n-integer]
                }
              @conclusion-integer-induction |
                forall n: Real; isInteger(n) -> prop(n)
                [by forall_intro generalize-n]
            }
          @conclusion-with-predecessor-step |
            (forall k: Real; isInteger(k) -> prop(k) -> prop(prev(k))) -> forall n: Real; isInteger(n) -> prop(n)
            [by implies_intro given-predecessor-step]
        }
      @conclusion-with-successor-step |
        (forall k: Real; isInteger(k) -> prop(k) -> prop(succ(k)))
          -> (forall k: Real; isInteger(k) -> prop(k) -> prop(prev(k)))
          -> forall n: Real; isInteger(n) -> prop(n)
        [by implies_intro given-successor-step]
    }
  @conclusion |
    prop(ZERO)
      -> (forall k: Real; isInteger(k) -> prop(k) -> prop(succ(k)))
      -> (forall k: Real; isInteger(k) -> prop(k) -> prop(prev(k)))
      -> forall n: Real; isInteger(n) -> prop(n)
    [by implies_intro given-base]
qed

// -- the integers as a CUT of ℝ + the guarded ℤ transfer model ---------------
// `sort Integer = Real where isInteger` carves the integer subring as a refinement of
// ℝ (its elements are rationals satisfying isInteger; its ops are ℝ's ops). The
// guarded model `IntegersInReal` interprets std/integer.bpa's ℤ theory on this
// cut — relativizing every ℤ binder to isInteger and every nonneg binder to
// isNatural — so ℤ's whole theorem corpus transfers onto ℝ's integers. Cite it
// with `[using model(IntegersInReal) integer.<thm>]`. (There is NO new arithmetic
// here: the cut inherits ℝ's add/mul/neg, so every ring identity on integers is
// already an ℝ identity; the model transfers the ℤ-SPECIFIC facts — the ones that
// rest on discreteness / induction — that ℝ does not have for all rationals.)
sort Integer = Real where isInteger

model IntegersInReal {
  integer.Int: Integer
  integer.nonneg: isNatural
  integer.ZERO: ZERO
  integer.ONE: ONE
  integer.succ: succ
  integer.prev: prev
  integer.add: add
  integer.mul: mul
  integer.neg: neg
  integer.sub: sub
  integer.prevSucc <- prevOfSucc
  integer.succPrev <- succOfPrev
  integer.oneIsSuccZero <- oneIsSuccZero
  integer.addZeroLeft <- addZeroLeft
  integer.addSuccLeft <- addSuccLeft
  integer.addPrevLeft <- addPrevLeft
  integer.negZero <- negZero
  integer.negSucc <- negSucc
  integer.negPrev <- negPrev
  integer.mulZeroLeft <- mulZeroLeft
  integer.mulSuccLeft <- mulSuccLeft
  integer.mulPrevLeft <- mulPrevLeft
  integer.nonnegZero <- isNaturalZero
  integer.nonnegSucc <- isNaturalSucc
  integer.nonnegSuccNotZero <- isNaturalSuccNotZero
  integer.intCases <- integerCases
  integer.nonnegInduction <- naturalInductionOnInteger
  integer.definitionOfSubtraction <- subDefinition
}

// -- the naturals as a CUT of ℝ + the guarded ℕ transfer model ---------------
// `sort Natural = Real where isNatural` carves the non-negative integers; the guarded
// model `NaturalsInReal` interprets std/peano.bpa's ℕ on the cut, transferring
// ℕ's theorem corpus onto ℝ's naturals. peano's `induction` (unidirectional, over
// all of ℕ) is discharged by ℝ's `naturalInduction` directly.
sort Natural = Real where isNatural

model NaturalsInReal {
  peano.Nat: Natural
  peano.ZERO: ZERO
  peano.ONE: ONE
  peano.succ: succ
  peano.add: add
  peano.mul: mul
  peano.succInjective <- succInjective
  peano.succNotZero <- isNaturalSuccNotZero
  peano.addZeroLeft <- addZeroLeft
  peano.addSuccLeft <- addSuccLeft
  peano.mulZeroLeft <- mulZeroLeft
  peano.mulSuccLeft <- mulSuccLeft
  peano.oneIsSuccZero <- oneIsSuccZero
  peano.induction <- naturalInduction
}

// -- the rationals as a CUT of ℝ + the guarded ℚ transfer model --------------
// `sort Rational = Real where isRational` carves the rational subfield; the guarded
// model `RationalsInReal` interprets std/rational.bpa's ORDERED-FIELD core on the
// cut, transferring ℚ's ordered-field corpus onto ℝ's rationals. Only the
// ordered-field axioms are discharged (ℚ's internal ℤ/ℕ/succ/prev scaffolding is
// left unmapped — those theorems don't transfer, and aren't wanted on the cut).
// Each ℚ axiom, relativized to isRational, follows from ℝ's like-named UNGUARDED
// axiom by dropping the guards.
sort Rational = Real where isRational

model RationalsInReal {
  rational.Q: Rational
  rational.ZERO: ZERO
  rational.ONE: ONE
  rational.add: add
  rational.mul: mul
  rational.neg: neg
  rational.recip: recip
  rational.less_than: less_than
  rational.addIsAssociative <- addIsAssociative
  rational.addZeroLeft <- addZeroLeft
  rational.addNegLeft <- addNegLeft
  rational.addIsCommutative <- addIsCommutative
  rational.mulIsAssociative <- mulIsAssociative
  rational.mulAddDistribLeft <- mulAddDistribLeft
  rational.mulAddDistribRight <- mulAddDistribRight
  rational.mulIsCommutative <- mulIsCommutative
  rational.mulOneLeft <- mulOneLeft
  rational.fieldInverse <- fieldInverse
  rational.oneNotZero <- oneNotZero
  rational.lessThanIrreflexive <- lessThanIrreflexive
  rational.lessThanTransitive <- lessThanTransitive
  rational.lessThanTrichotomy <- lessThanTrichotomy
  rational.lessThanAddRight <- lessThanAddRight
  rational.lessThanAddCancel <- lessThanAddCancel
  rational.positiveProduct <- positiveProduct
}
