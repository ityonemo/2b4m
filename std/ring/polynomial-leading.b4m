// std/ring/polynomial-leading.b4m — THE LEADING-PRODUCT STEP.
//
// Working toward coeff(p·q, m+n) = p_m · q_n for deg p = m, deg q = n.
//
// `std/field/polynomial.b4m` ASSUMES this (as `aProductOfNonzerosIsNonzero` and
// `degreeOfAProduct`), justifying it by saying `std/ring/polynomial.b4m` "already carries
// the leading-term step it turns on". It does not — that file has 19 theorems and the only
// degree-related one is `degreeIsUnique`. So the step is built here.
//
// The convolution at index m+n sums p_j · q_{(m+n)-j} over j = 0 … m+n, and every term but
// one vanishes:
//
//   * j > m   →  p_j = 0        (p's degree bound)
//   * j < m   →  (m+n)-j > n  →  q_{(m+n)-j} = 0   (q's degree bound)
//   * j = m   →  p_m · q_n, the survivor
//
// So the proof walks the convolution in two halves: everything strictly above m contributes
// nothing, and everything strictly below m contributes nothing.
import ring_poly <<< "std/ring/polynomial.b4m"
import ring <<< "std/ring.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import subtraction <<< "std/peano/subtraction.b4m"
import irreducible <<< "std/field/irreducible.b4m"

sort Poly = ring_poly.Poly
sort Nat = peano.Nat
const ZERO = peano.ZERO
const zeroR = ring_poly.zeroR
func succ = peano.succ
func add = peano.add
func sub = subtraction.sub
func addR = ring_poly.addR
func mulR = ring_poly.mulR
func coeff = ring_poly.coeff
func convolution = ring_poly.convolution
pred less_than = peano.less_than
pred degreeAtMost = ring_poly.degreeAtMost

// ℕ's AC triple, by bare name, for `assoc_commut` on the index arithmetic
fact addIsAssociative = peano.addIsAssociative
fact addIsCommutative = peano.addIsCommutative
fact addLeftSwap = peano.addLeftSwap

// THE UPPER HALF: the convolution does not change as its bound rises above m, because each
// new term carries a coefficient of p past p's degree. Induction on the excess t.
theorem theConvolutionStopsGrowingPastTheDegree: forall p, q: Poly; forall i, m: Nat;
  degreeAtMost(p, m) ->
  forall t: Nat;
  convolution(p, q, i, add(m, t)) = convolution(p, q, i, m)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-i |
            fix i: Nat {
              @generalize-m |
                fix m: Nat {
                  @given-p-bounded |
                    assume degreeAtMost(p, m) {
                      @p-bounded |
                        degreeAtMost(p, m)
                        [by hypothesis given-p-bounded]
                      @the-bound-unfolds |
                        degreeAtMost(p, m) iff
                          (forall j: Nat; less_than(m, j) -> coeff(p, j) = zeroR)
                        [using specialize ring_poly.degreeAtMostMeaning(p, m)]
                      @coefficients-above-m-vanish |
                        forall j: Nat; less_than(m, j) -> coeff(p, j) = zeroR
                        [using tautology the-bound-unfolds p-bounded]
                      // base: no excess
                      @adding-no-excess |
                        add(m, ZERO) = m
                        [using specialize peano.addZeroRight(m)]
                      @base-case |
                        convolution(p, q, i, add(m, ZERO)) = convolution(p, q, i, m)
                        [by rewrite adding-no-excess reflexivity-at-m]
                      @reflexivity-at-m |
                        convolution(p, q, i, m) = convolution(p, q, i, m)
                        [by reflexivity]
                      // step: one more term, whose p-coefficient is past the degree
                      @induction-step |
                        fix k: Nat {
                          @given-the-hypothesis |
                            assume convolution(p, q, i, add(m, k)) =
                              convolution(p, q, i, m) {
                              @the-hypothesis |
                                convolution(p, q, i, add(m, k)) =
                                  convolution(p, q, i, m)
                                [by hypothesis given-the-hypothesis]
                              @the-next-bound |
                                add(m, succ(k)) = succ(add(m, k))
                                [using specialize peano.addSuccRight(m, k)]
                              @the-convolution-grows |
                                convolution(p, q, i, succ(add(m, k))) =
                                  addR(convolution(p, q, i, add(m, k)),
                                  mulR(coeff(p, succ(add(m, k))),
                                  coeff(q, sub(i, succ(add(m, k))))))
                                [using specialize ring_poly.convolutionSucc(p, q, i, add(m, k))]
                              // the new p-coefficient is past m
                              @m-is-below-the-new-index |
                                less_than(m, succ(add(m, k)))
                                [using specialize aSumIsBelowItsSuccessor(m, k)]
                              @the-new-coefficient-vanishes |
                                coeff(p, succ(add(m, k))) = zeroR
                                [using specialize coefficients-above-m-vanish(succ(add(m, k))) m-is-below-the-new-index]
                              @the-new-term-vanishes |
                                mulR(coeff(p, succ(add(m, k))),
                                  coeff(q, sub(i, succ(add(m, k))))) = zeroR
                                [using simplify the-new-coefficient-vanishes theZeroProduct-at-the-q-coefficient]
                              @theZeroProduct-at-the-q-coefficient |
                                mulR(zeroR, coeff(q, sub(i, succ(add(m, k))))) = zeroR
                                [using specialize ring.mulZeroLeft(coeff(q, sub(i, succ(add(m, k)))))]
                              @adding-nothing |
                                addR(convolution(p, q, i, m), zeroR) =
                                  convolution(p, q, i, m)
                                [using specialize ring.addZeroRight(convolution(p, q, i, m))]
                              @conclusion-at-succ-k |
                                convolution(p, q, i, add(m, succ(k))) =
                                  convolution(p, q, i, m)
                                [using simplify the-next-bound the-convolution-grows the-hypothesis the-new-term-vanishes adding-nothing]
                            }
                          @induction-step-at-k |
                            (convolution(p, q, i, add(m, k)) =
                              convolution(p, q, i, m)) ->
                              (convolution(p, q, i, add(m, succ(k))) =
                              convolution(p, q, i, m))
                            [by discharge given-the-hypothesis]
                        }
                      @induction-step-for-all-k |
                        forall k: Nat;
                          (convolution(p, q, i, add(m, k)) =
                          convolution(p, q, i, m)) ->
                          (convolution(p, q, i, add(m, succ(k))) =
                          convolution(p, q, i, m))
                        [by generalize induction-step]
                      @conclusion-for-all-t |
                        forall t: Nat;
                          convolution(p, q, i, add(m, t)) = convolution(p, q, i, m)
                        [using instantiation peano.induction((fun t: Nat => convolution(p, q, i, add(m, t)) = convolution(p, q, i, m))) base-case induction-step-for-all-k]
                    }
                  @bounded-implies |
                    degreeAtMost(p, m) ->
                      forall t: Nat;
                      convolution(p, q, i, add(m, t)) = convolution(p, q, i, m)
                    [by discharge given-p-bounded]
                }
              @discharge-m |
                forall m9: Nat;
                  degreeAtMost(p, m9) ->
                  forall t: Nat;
                  convolution(p, q, i, add(m9, t)) = convolution(p, q, i, m9)
                [by generalize generalize-m]
            }
          @discharge-i |
            forall i9, m9: Nat;
              degreeAtMost(p, m9) ->
              forall t: Nat;
              convolution(p, q, i9, add(m9, t)) = convolution(p, q, i9, m9)
            [by generalize generalize-i]
        }
      @discharge-q |
        forall q9: Poly; forall i9, m9: Nat;
          degreeAtMost(p, m9) ->
          forall t: Nat;
          convolution(p, q9, i9, add(m9, t)) = convolution(p, q9, i9, m9)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall i, m: Nat;
      degreeAtMost(p, m) ->
      forall t: Nat;
      convolution(p, q, i, add(m, t)) = convolution(p, q, i, m)
    [by generalize generalize-p]
qed

// m < succ(m + k): the index fact the step above needs.
theorem aSumIsBelowItsSuccessor: forall m, k: Nat;
  less_than(m, succ(add(m, k)))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-k |
        fix k: Nat {
          @the-gap-witnesses-the-order |
            add(m, succ(k)) = succ(add(m, k)) -> less_than(m, succ(add(m, k)))
            [using specialize peano_order.lessThanIntro(m, k, succ(add(m, k)))]
          @the-gap |
            add(m, succ(k)) = succ(add(m, k))
            [using specialize peano.addSuccRight(m, k)]
          @conclusion-m-is-below |
            less_than(m, succ(add(m, k)))
            [using tautology the-gap-witnesses-the-order the-gap]
        }
      @discharge-k |
        forall k9: Nat; less_than(m, succ(add(m, k9)))
        [by generalize generalize-k]
    }
  @conclusion |
    forall m, k: Nat; less_than(m, succ(add(m, k)))
    [by generalize generalize-m]
qed

// The index fact the lower half needs: subtracting less than m from m+n leaves more than n.
// Writing m as sub(m,j) + j (j < m) makes m+n = sub(m,j) + (j+n), so sub(m+n, j) is
// sub(m,j) + n, and sub(m,j) is positive.
theorem subtractingBelowTheFirstSummandLeavesMoreThanTheSecond: forall m, n, j: Nat;
  less_than(j, m) -> less_than(n, sub(add(m, n), j))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-n |
        fix n: Nat {
          @generalize-j |
            fix j: Nat {
              @given-j-below-m |
                assume less_than(j, m) {
                  @j-below-m |
                    less_than(j, m)
                    [by hypothesis given-j-below-m]
                  // m recovers as sub(m,j) + j, since j <= m
                  @j-at-most-m |
                    less_than(j, succ(m))
                    [using specialize peano_order.lessThanSuccRight(j, m) j-below-m]
                  @m-recovers |
                    add(sub(m, j), j) = m
                    [using specialize subtraction.addSubCancel(j, m) j-at-most-m]
                  // so m + n = (sub(m,j) + n) + j, and subtracting j leaves sub(m,j) + n
                  @the-sum-regroups |
                    add(add(sub(m, j), n), j) = add(add(sub(m, j), j), n)
                    [using assoc_commut]
                  @the-sum-is-m-plus-n |
                    add(add(sub(m, j), j), n) = add(m, n)
                    [by rewrite m-recovers reflexivity-of-the-sum]
                  @reflexivity-of-the-sum |
                    add(m, n) = add(m, n)
                    [by reflexivity]
                  @the-regrouped-sum |
                    add(add(sub(m, j), n), j) = add(m, n)
                    [using chain the-sum-regroups the-sum-is-m-plus-n]
                  // cancelling j off both sides of the difference
                  @the-cancellation |
                    sub(add(add(sub(m, j), n), j), add(ZERO, j)) =
                      sub(add(sub(m, j), n), ZERO)
                    [using specialize subtraction.subAddSameRight(add(sub(m, j), n), j, ZERO)]
                  @zero-plus-j |
                    add(ZERO, j) = j
                    [using specialize peano.addZeroLeft(j)]
                  @dropping-the-zero |
                    sub(add(sub(m, j), n), ZERO) = add(sub(m, j), n)
                    [using specialize subtraction.subZeroRight(add(sub(m, j), n))]
                  // the cancellation, with both sides put in terms of m+n and j
                  @the-cancellation-at-j |
                    sub(add(add(sub(m, j), n), j), j) =
                      sub(add(sub(m, j), n), ZERO)
                    [by rewrite zero-plus-j the-cancellation]
                  @the-cancellation-at-the-sum |
                    sub(add(m, n), j) = sub(add(sub(m, j), n), ZERO)
                    [by rewrite the-regrouped-sum the-cancellation-at-j]
                  @the-difference-is-the-regrouped-sum |
                    sub(add(m, n), j) = add(sub(m, j), n)
                    [using chain the-cancellation-at-the-sum dropping-the-zero]
                  // and sub(m,j) is positive, so the sum exceeds n
                  @the-remainder-is-positive |
                    less_than(ZERO, sub(m, j))
                    [using specialize aDifferenceBelowIsPositive(j, m) j-below-m]
                  @n-is-below-the-sum |
                    less_than(n, add(sub(m, j), n))
                    [using specialize aPositiveSummandExceedsTheOther(sub(m, j), n) the-remainder-is-positive]
                  @conclusion-the-difference-exceeds-n |
                    less_than(n, sub(add(m, n), j))
                    [by rewrite the-difference-is-the-regrouped-sum n-is-below-the-sum]
                }
              @below-implies |
                less_than(j, m) -> less_than(n, sub(add(m, n), j))
                [by discharge given-j-below-m]
            }
          @discharge-j |
            forall j9: Nat;
              less_than(j9, m) -> less_than(n, sub(add(m, n), j9))
            [by generalize generalize-j]
        }
      @discharge-n |
        forall n9, j9: Nat;
          less_than(j9, m) -> less_than(n9, sub(add(m, n9), j9))
        [by generalize generalize-n]
    }
  @conclusion |
    forall m, n, j: Nat;
      less_than(j, m) -> less_than(n, sub(add(m, n), j))
    [by generalize generalize-m]
qed

// j < m leaves a positive difference: were sub(m,j) zero, m would recover as 0 + j = j,
// contradicting j < m.
theorem aDifferenceBelowIsPositive: forall j, m: Nat;
  less_than(j, m) -> less_than(ZERO, sub(m, j))
proof
  @generalize-j |
    fix j: Nat {
      @generalize-m |
        fix m: Nat {
          @given-j-below-m |
            assume less_than(j, m) {
              @j-below-m |
                less_than(j, m)
                [by hypothesis given-j-below-m]
              @j-at-most-m |
                less_than(j, succ(m))
                [using specialize peano_order.lessThanSuccRight(j, m) j-below-m]
              @m-recovers |
                add(sub(m, j), j) = m
                [using specialize subtraction.addSubCancel(j, m) j-at-most-m]
              @the-difference-splits |
                sub(m, j) = ZERO or less_than(ZERO, sub(m, j))
                [using specialize aNatIsZeroOrPositive(sub(m, j))]
              @when-the-difference-vanishes |
                assume sub(m, j) = ZERO {
                  @the-difference-is-zero |
                    sub(m, j) = ZERO
                    [by hypothesis when-the-difference-vanishes]
                  @m-recovers-as-j |
                    add(ZERO, j) = m
                    [by rewrite the-difference-is-zero m-recovers]
                  @zero-plus-j-is-j |
                    add(ZERO, j) = j
                    [using specialize peano.addZeroLeft(j)]
                  @j-is-m |
                    j = m
                    [using chain zero-plus-j-is-j-flipped m-recovers-as-j]
                  @zero-plus-j-is-j-flipped |
                    j = add(ZERO, j)
                    [by symmetry zero-plus-j-is-j]
                  @j-is-below-itself |
                    less_than(j, j)
                    [by rewrite j-is-m j-below-m]
                  @nothing-is-below-itself |
                    not less_than(j, j)
                    [using specialize peano_order.lessThanIrreflexive(j)]
                  @conclusion-absurd |
                    less_than(ZERO, sub(m, j))
                    [by ex_falso j-is-below-itself nothing-is-below-itself]
                }
              @when-the-difference-is-positive |
                assume less_than(ZERO, sub(m, j)) {
                  @conclusion-already-positive |
                    less_than(ZERO, sub(m, j))
                    [by hypothesis when-the-difference-is-positive]
                }
              @conclusion-the-difference-is-positive |
                less_than(ZERO, sub(m, j))
                [by common_conclusion the-difference-splits when-the-difference-vanishes when-the-difference-is-positive]
            }
          @below-implies-positive |
            less_than(j, m) -> less_than(ZERO, sub(m, j))
            [by discharge given-j-below-m]
        }
      @discharge-m |
        forall m9: Nat; less_than(j, m9) -> less_than(ZERO, sub(m9, j))
        [by generalize generalize-m]
    }
  @conclusion |
    forall j, m: Nat; less_than(j, m) -> less_than(ZERO, sub(m, j))
    [by generalize generalize-j]
qed

// A positive summand makes the sum exceed the other summand: a is succ(d), so
// n + succ(d) = succ(n + d) witnesses n < a + n after commuting.
theorem aPositiveSummandExceedsTheOther: forall a, n: Nat;
  less_than(ZERO, a) -> less_than(n, add(a, n))
proof
  @generalize-a |
    fix a: Nat {
      @generalize-n |
        fix n: Nat {
          @given-a-positive |
            assume less_than(ZERO, a) {
              @a-positive |
                less_than(ZERO, a)
                [by hypothesis given-a-positive]
              @a-splits |
                a = ZERO or (exists d: Nat; a = succ(d))
                [using specialize peano.zeroOrSucc(a)]
              @a-is-not-zero |
                not (a = ZERO)
                [using specialize aPositiveNatIsNonzero(a) a-positive]
              @a-is-a-successor |
                exists d: Nat; a = succ(d)
                [using tautology a-splits a-is-not-zero]
              @with-the-predecessor-d |
                unpack d: Nat from a-is-a-successor {
                  @a-is-succ-d |
                    a = succ(d)
                    [by hypothesis with-the-predecessor-d]
                  @the-gap-witnesses |
                    add(n, succ(d)) = add(succ(d), n) ->
                      less_than(n, add(succ(d), n))
                    [using specialize peano_order.lessThanIntro(n, d, add(succ(d), n))]
                  @commuting |
                    add(n, succ(d)) = add(succ(d), n)
                    [using specialize peano.addIsCommutative(n, succ(d))]
                  @n-is-below-the-successor-sum |
                    less_than(n, add(succ(d), n))
                    [using tautology the-gap-witnesses commuting]
                  @conclusion-n-is-below-the-sum |
                    less_than(n, add(a, n))
                    [by rewrite a-is-succ-d n-is-below-the-successor-sum]
                }
              @conclusion-from-the-successor |
                less_than(n, add(a, n))
                [by unpacked with-the-predecessor-d]
            }
          @positive-implies |
            less_than(ZERO, a) -> less_than(n, add(a, n))
            [by discharge given-a-positive]
        }
      @discharge-n |
        forall n9: Nat; less_than(ZERO, a) -> less_than(n9, add(a, n9))
        [by generalize generalize-n]
    }
  @conclusion |
    forall a, n: Nat; less_than(ZERO, a) -> less_than(n, add(a, n))
    [by generalize generalize-a]
qed

fact aNatIsZeroOrPositive = irreducible.aNatIsZeroOrPositive
fact aPositiveNatIsNonzero = irreducible.aPositiveNatIsNotZero

// THE LOWER HALF: below m the convolution has accumulated nothing, because every term it
// has taken carries a coefficient of q past q's degree — index j < m makes (m+n)-j exceed
// n. Induction on the bound k, with the guard k < m travelling inside the property.
theorem theConvolutionIsEmptyBelowTheDegree: forall p, q: Poly; forall m, n: Nat;
  degreeAtMost(q, n) ->
  forall k: Nat;
  less_than(k, m) -> convolution(p, q, add(m, n), k) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @generalize-n |
                fix n: Nat {
                  @given-q-bounded |
                    assume degreeAtMost(q, n) {
                      @q-bounded |
                        degreeAtMost(q, n)
                        [by hypothesis given-q-bounded]
                      @the-bound-unfolds |
                        degreeAtMost(q, n) iff
                          (forall i: Nat; less_than(n, i) -> coeff(q, i) = zeroR)
                        [using specialize ring_poly.degreeAtMostMeaning(q, n)]
                      @coefficients-above-n-vanish |
                        forall i: Nat; less_than(n, i) -> coeff(q, i) = zeroR
                        [using tautology the-bound-unfolds q-bounded]
                      // base: the single term at index ZERO
                      @given-zero-below-m |
                        assume less_than(ZERO, m) {
                          @zero-below-m |
                            less_than(ZERO, m)
                            [by hypothesis given-zero-below-m]
                          @the-base-term |
                            convolution(p, q, add(m, n), ZERO) =
                              mulR(coeff(p, ZERO), coeff(q, add(m, n)))
                            [using specialize ring_poly.convolutionZero(p, q, add(m, n))]
                          @n-is-below-the-sum |
                            less_than(n, sub(add(m, n), ZERO))
                            [using specialize subtractingBelowTheFirstSummandLeavesMoreThanTheSecond(m, n, ZERO) zero-below-m]
                          @subtracting-zero |
                            sub(add(m, n), ZERO) = add(m, n)
                            [using specialize subtraction.subZeroRight(add(m, n))]
                          @n-is-below-the-index |
                            less_than(n, add(m, n))
                            [by rewrite subtracting-zero n-is-below-the-sum]
                          @the-base-coefficient-vanishes |
                            coeff(q, add(m, n)) = zeroR
                            [using specialize coefficients-above-n-vanish(add(m, n)) n-is-below-the-index]
                          @scaling-zero |
                            mulR(coeff(p, ZERO), zeroR) = zeroR
                            [using specialize ring.mulZeroRight(coeff(p, ZERO))]
                          @conclusion-the-base-vanishes |
                            convolution(p, q, add(m, n), ZERO) = zeroR
                            [using simplify the-base-term the-base-coefficient-vanishes scaling-zero]
                        }
                      @base-case |
                        less_than(ZERO, m) ->
                          convolution(p, q, add(m, n), ZERO) = zeroR
                        [by discharge given-zero-below-m]
                      // step
                      @induction-step |
                        fix k: Nat {
                          @given-the-hypothesis |
                            assume less_than(k, m) ->
                              convolution(p, q, add(m, n), k) = zeroR {
                              @the-hypothesis |
                                less_than(k, m) ->
                                  convolution(p, q, add(m, n), k) = zeroR
                                [by hypothesis given-the-hypothesis]
                              @given-succ-k-below-m |
                                assume less_than(succ(k), m) {
                                  @succ-k-below-m |
                                    less_than(succ(k), m)
                                    [by hypothesis given-succ-k-below-m]
                                  // k < succ k < m, so the hypothesis applies
                                  @k-below-succ-k |
                                    less_than(k, succ(k))
                                    [using specialize peano_order.lessThanSelf(k)]
                                  @k-below-m |
                                    less_than(k, m)
                                    [using specialize peano_order.lessThanTransitive(k, succ(k), m) k-below-succ-k succ-k-below-m]
                                  @the-running-sum-vanishes |
                                    convolution(p, q, add(m, n), k) = zeroR
                                    [using tautology the-hypothesis k-below-m]
                                  // the new term's q-coefficient is past n
                                  @the-convolution-grows |
                                    convolution(p, q, add(m, n), succ(k)) =
                                      addR(convolution(p, q, add(m, n), k),
                                      mulR(coeff(p, succ(k)),
                                      coeff(q, sub(add(m, n), succ(k)))))
                                    [using specialize ring_poly.convolutionSucc(p, q, add(m, n), k)]
                                  @n-is-below-the-new-index |
                                    less_than(n, sub(add(m, n), succ(k)))
                                    [using specialize subtractingBelowTheFirstSummandLeavesMoreThanTheSecond(m, n, succ(k)) succ-k-below-m]
                                  @the-new-coefficient-vanishes |
                                    coeff(q, sub(add(m, n), succ(k))) = zeroR
                                    [using specialize coefficients-above-n-vanish(sub(add(m, n), succ(k))) n-is-below-the-new-index]
                                  @the-new-term-vanishes |
                                    mulR(coeff(p, succ(k)), zeroR) = zeroR
                                    [using specialize ring.mulZeroRight(coeff(p, succ(k)))]
                                  @adding-two-zeros |
                                    addR(zeroR, zeroR) = zeroR
                                    [using specialize ring.addZeroRight(zeroR)]
                                  @conclusion-at-succ-k |
                                    convolution(p, q, add(m, n), succ(k)) = zeroR
                                    [using simplify the-convolution-grows the-running-sum-vanishes the-new-coefficient-vanishes the-new-term-vanishes adding-two-zeros]
                                }
                              @conclusion-guarded |
                                less_than(succ(k), m) ->
                                  convolution(p, q, add(m, n), succ(k)) = zeroR
                                [by discharge given-succ-k-below-m]
                            }
                          @induction-step-at-k |
                            (less_than(k, m) ->
                              convolution(p, q, add(m, n), k) = zeroR) ->
                              (less_than(succ(k), m) ->
                              convolution(p, q, add(m, n), succ(k)) = zeroR)
                            [by discharge given-the-hypothesis]
                        }
                      @induction-step-for-all-k |
                        forall k: Nat;
                          (less_than(k, m) ->
                          convolution(p, q, add(m, n), k) = zeroR) ->
                          (less_than(succ(k), m) ->
                          convolution(p, q, add(m, n), succ(k)) = zeroR)
                        [by generalize induction-step]
                      @conclusion-for-all-k |
                        forall k: Nat;
                          less_than(k, m) ->
                          convolution(p, q, add(m, n), k) = zeroR
                        [using instantiation peano.induction((fun k: Nat => less_than(k, m) -> convolution(p, q, add(m, n), k) = zeroR)) base-case induction-step-for-all-k]
                    }
                  @bounded-implies |
                    degreeAtMost(q, n) ->
                      forall k: Nat;
                      less_than(k, m) ->
                      convolution(p, q, add(m, n), k) = zeroR
                    [by discharge given-q-bounded]
                }
              @discharge-n |
                forall n9: Nat;
                  degreeAtMost(q, n9) ->
                  forall k: Nat;
                  less_than(k, m) ->
                  convolution(p, q, add(m, n9), k) = zeroR
                [by generalize generalize-n]
            }
          @discharge-m |
            forall m9, n9: Nat;
              degreeAtMost(q, n9) ->
              forall k: Nat;
              less_than(k, m9) ->
              convolution(p, q, add(m9, n9), k) = zeroR
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q9: Poly; forall m9, n9: Nat;
          degreeAtMost(q9, n9) ->
          forall k: Nat;
          less_than(k, m9) ->
          convolution(p, q9, add(m9, n9), k) = zeroR
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, n: Nat;
      degreeAtMost(q, n) ->
      forall k: Nat;
      less_than(k, m) -> convolution(p, q, add(m, n), k) = zeroR
    [by generalize generalize-p]
qed

// sub(add(m,n), m) = n: subAddCancel after commuting the sum.
theorem subtractingTheFirstSummandLeavesTheSecond: forall m, n: Nat;
  sub(add(m, n), m) = n
proof
  @generalize-m |
    fix m: Nat {
      @generalize-n |
        fix n: Nat {
          @commuting-the-sum |
            add(m, n) = add(n, m)
            [using specialize peano.addIsCommutative(m, n)]
          @the-cancellation |
            sub(add(n, m), m) = n
            [using specialize subtraction.subAddCancel(n, m)]
          @conclusion-the-difference |
            sub(add(m, n), m) = n
            [by rewrite commuting-the-sum the-cancellation]
        }
      @discharge-n |
        forall n9: Nat; sub(add(m, n9), m) = n9
        [by generalize generalize-n]
    }
  @conclusion |
    forall m, n: Nat; sub(add(m, n), m) = n
    [by generalize generalize-m]
qed

// THE LEADING-PRODUCT STEP. For p of degree m and q of degree n, the product's coefficient
// at m+n is exactly the product of the leading coefficients: the convolution stops growing
// past m (upper half) and has accumulated nothing below it (lower half), so the single term
// at j = m survives.
//
// This is what std/field/polynomial.b4m's `aProductOfNonzerosIsNonzero` and
// `degreeOfAProduct` rest on, and it is stated there as resting on a lemma of
// std/ring/polynomial.b4m that did not exist. Now it does.
theorem theProductsLeadingCoefficient: forall p, q: Poly; forall m, n: Nat;
  degreeAtMost(p, m) -> degreeAtMost(q, n) ->
  coeff(ring_poly.mulP(p, q), add(m, n)) =
  mulR(coeff(p, m), coeff(q, n))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @generalize-n |
                fix n: Nat {
                  @given-p-bounded |
                    assume degreeAtMost(p, m) {
                      @p-bounded |
                        degreeAtMost(p, m)
                        [by hypothesis given-p-bounded]
                      @given-q-bounded |
                        assume degreeAtMost(q, n) {
                          @q-bounded |
                            degreeAtMost(q, n)
                            [by hypothesis given-q-bounded]
                          // the coefficient IS the convolution at its own index
                          @the-coefficient-is-the-convolution |
                            coeff(ring_poly.mulP(p, q), add(m, n)) =
                              convolution(p, q, add(m, n), add(m, n))
                            [using specialize ring_poly.mulPolyCoeff(p, q, add(m, n))]
                          // UPPER half at t = n: the bound drops from m+n to m
                          @the-bound-drops-to-m |
                            forall t: Nat;
                              convolution(p, q, add(m, n), add(m, t)) =
                              convolution(p, q, add(m, n), m)
                            [using specialize theConvolutionStopsGrowingPastTheDegree(p, q, add(m, n), m) p-bounded]
                          @the-convolution-at-m |
                            convolution(p, q, add(m, n), add(m, n)) =
                              convolution(p, q, add(m, n), m)
                            [using specialize the-bound-drops-to-m(n)]
                          // the index the surviving term reads q at
                          @the-surviving-index |
                            sub(add(m, n), m) = n
                            [using specialize subtractingTheFirstSummandLeavesTheSecond(m, n)]
                          // split on m: ZERO has no lower half to discard
                          @m-splits |
                            m = ZERO or (exists j: Nat; m = succ(j))
                            [using specialize peano.zeroOrSucc(m)]
                          @when-m-is-zero |
                            assume m = ZERO {
                              @m-is-zero |
                                m = ZERO
                                [by hypothesis when-m-is-zero]
                              @the-single-term |
                                convolution(p, q, add(m, n), ZERO) =
                                  mulR(coeff(p, ZERO), coeff(q, add(m, n)))
                                [using specialize ring_poly.convolutionZero(p, q, add(m, n))]
                              // at m = ZERO the index m+n IS n
                              @the-index-at-zero |
                                sub(add(m, n), m) = add(m, n)
                                [by rewrite m-is-zero the-difference-at-zero]
                              @the-difference-at-zero |
                                sub(add(ZERO, n), ZERO) = add(ZERO, n)
                                [using specialize subtraction.subZeroRight(add(ZERO, n))]
                              @the-index-is-n |
                                add(m, n) = n
                                [using chain the-index-at-zero-flipped the-surviving-index]
                              @the-index-at-zero-flipped |
                                add(m, n) = sub(add(m, n), m)
                                [by symmetry the-index-at-zero]
                              // at m = ZERO the convolution bound is ZERO, so the single
                              // term is the whole thing
                              @the-convolution-at-zero |
                                convolution(p, q, add(m, n), add(m, n)) =
                                  convolution(p, q, add(m, n), ZERO)
                                [by rewrite m-is-zero the-convolution-at-m]
                              @the-term-at-the-index |
                                convolution(p, q, add(m, n), ZERO) =
                                  mulR(coeff(p, ZERO), coeff(q, n))
                                [by rewrite the-index-is-n the-single-term]
                              @the-coefficient-at-zero |
                                coeff(ring_poly.mulP(p, q), add(m, n)) =
                                  mulR(coeff(p, ZERO), coeff(q, n))
                                [using chain the-coefficient-is-the-convolution the-convolution-at-zero the-term-at-the-index]
                              @conclusion-at-zero |
                                coeff(ring_poly.mulP(p, q), add(m, n)) =
                                  mulR(coeff(p, m), coeff(q, n))
                                [by rewrite m-is-zero the-coefficient-at-zero]
                            }
                          @when-m-is-a-successor |
                            assume exists j: Nat; m = succ(j) {
                              @m-is-a-successor |
                                exists j: Nat; m = succ(j)
                                [by hypothesis when-m-is-a-successor]
                              @with-the-predecessor-j |
                                unpack j: Nat from m-is-a-successor {
                                  @m-is-succ-j |
                                    m = succ(j)
                                    [by hypothesis with-the-predecessor-j]
                                  // the convolution at m peels its last term
                                  @the-peel |
                                    convolution(p, q, add(m, n), succ(j)) =
                                      addR(convolution(p, q, add(m, n), j),
                                      mulR(coeff(p, succ(j)),
                                      coeff(q, sub(add(m, n), succ(j)))))
                                    [using specialize ring_poly.convolutionSucc(p, q, add(m, n), j)]
                                  // LOWER half: everything below m is zeroR
                                  @the-lower-half |
                                    forall k: Nat;
                                      less_than(k, m) ->
                                      convolution(p, q, add(m, n), k) = zeroR
                                    [using specialize theConvolutionIsEmptyBelowTheDegree(p, q, m, n) q-bounded]
                                  @j-is-below-m |
                                    less_than(j, m)
                                    [by rewrite m-is-succ-j j-is-below-its-successor]
                                  @j-is-below-its-successor |
                                    less_than(j, succ(j))
                                    [using specialize peano_order.lessThanSelf(j)]
                                  @the-running-sum-vanishes |
                                    convolution(p, q, add(m, n), j) = zeroR
                                    [using specialize the-lower-half(j) j-is-below-m]
                                  @dropping-the-zero |
                                    addR(zeroR,
                                      mulR(coeff(p, succ(j)),
                                      coeff(q, sub(add(m, n), succ(j))))) =
                                      mulR(coeff(p, succ(j)),
                                      coeff(q, sub(add(m, n), succ(j))))
                                    [using specialize ring.addZeroLeft(mulR(coeff(p, succ(j)), coeff(q, sub(add(m, n), succ(j)))))]
                                  @the-peeled-term |
                                    convolution(p, q, add(m, n), succ(j)) =
                                      mulR(coeff(p, succ(j)),
                                      coeff(q, sub(add(m, n), succ(j))))
                                    [using simplify the-peel the-running-sum-vanishes dropping-the-zero]
                                  // the peeled term reads q at sub(m+n, m) = n
                                  @the-peeled-term-at-n |
                                    convolution(p, q, add(m, n), succ(j)) =
                                      mulR(coeff(p, succ(j)), coeff(q, n))
                                    [by rewrite the-index-at-succ-j the-peeled-term]
                                  @the-index-at-succ-j |
                                    sub(add(m, n), succ(j)) = n
                                    [by rewrite m-is-succ-j the-surviving-index]
                                  @the-convolution-at-succ-j |
                                    convolution(p, q, add(m, n), add(m, n)) =
                                      convolution(p, q, add(m, n), succ(j))
                                    [by rewrite m-is-succ-j the-convolution-at-m]
                                  @the-coefficient-at-succ-j |
                                    coeff(ring_poly.mulP(p, q), add(m, n)) =
                                      mulR(coeff(p, succ(j)), coeff(q, n))
                                    [using chain the-coefficient-is-the-convolution the-convolution-at-succ-j the-peeled-term-at-n]
                                  @conclusion-at-a-successor |
                                    coeff(ring_poly.mulP(p, q), add(m, n)) =
                                      mulR(coeff(p, m), coeff(q, n))
                                    [by rewrite m-is-succ-j the-coefficient-at-succ-j]
                                }
                              @conclusion-from-the-successor |
                                coeff(ring_poly.mulP(p, q), add(m, n)) =
                                  mulR(coeff(p, m), coeff(q, n))
                                [by unpacked with-the-predecessor-j]
                            }
                          @conclusion-either-way |
                            coeff(ring_poly.mulP(p, q), add(m, n)) =
                              mulR(coeff(p, m), coeff(q, n))
                            [by common_conclusion m-splits when-m-is-zero when-m-is-a-successor]
                        }
                      @q-bounded-implies |
                        degreeAtMost(q, n) ->
                          coeff(ring_poly.mulP(p, q), add(m, n)) =
                          mulR(coeff(p, m), coeff(q, n))
                        [by discharge given-q-bounded]
                    }
                  @p-bounded-implies |
                    degreeAtMost(p, m) -> degreeAtMost(q, n) ->
                      coeff(ring_poly.mulP(p, q), add(m, n)) =
                      mulR(coeff(p, m), coeff(q, n))
                    [by discharge given-p-bounded]
                }
              @discharge-n |
                forall n9: Nat;
                  degreeAtMost(p, m) -> degreeAtMost(q, n9) ->
                  coeff(ring_poly.mulP(p, q), add(m, n9)) =
                  mulR(coeff(p, m), coeff(q, n9))
                [by generalize generalize-n]
            }
          @discharge-m |
            forall m9, n9: Nat;
              degreeAtMost(p, m9) -> degreeAtMost(q, n9) ->
              coeff(ring_poly.mulP(p, q), add(m9, n9)) =
              mulR(coeff(p, m9), coeff(q, n9))
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q9: Poly; forall m9, n9: Nat;
          degreeAtMost(p, m9) -> degreeAtMost(q9, n9) ->
          coeff(ring_poly.mulP(p, q9), add(m9, n9)) =
          mulR(coeff(p, m9), coeff(q9, n9))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, n: Nat;
      degreeAtMost(p, m) -> degreeAtMost(q, n) ->
      coeff(ring_poly.mulP(p, q), add(m, n)) =
      mulR(coeff(p, m), coeff(q, n))
    [by generalize generalize-p]
qed

// THE PRODUCT'S DEGREE BOUND: above m+n every coefficient of the product vanishes, because
// every term of the convolution does — index j past m kills the p factor, and j at or below
// m leaves i-j above n, killing the q factor. Unlike the leading case there is no surviving
// middle term, so a single induction on the bound suffices.
theorem theProductVanishesAboveTheDegreeSum: forall p, q: Poly; forall m, n, i: Nat;
  degreeAtMost(p, m) -> degreeAtMost(q, n) -> less_than(add(m, n), i) ->
  forall k: Nat; convolution(p, q, i, k) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @generalize-n |
                fix n: Nat {
                  @generalize-i |
                    fix i: Nat {
                      @given-p-bounded |
                        assume degreeAtMost(p, m) {
                          @p-bounded |
                            degreeAtMost(p, m)
                            [by hypothesis given-p-bounded]
                          @given-q-bounded |
                            assume degreeAtMost(q, n) {
                              @q-bounded |
                                degreeAtMost(q, n)
                                [by hypothesis given-q-bounded]
                              @given-i-is-high |
                                assume less_than(add(m, n), i) {
                                  @i-is-high |
                                    less_than(add(m, n), i)
                                    [by hypothesis given-i-is-high]
                                  // every term vanishes: this is the per-index fact
                                  @every-term-vanishes-everywhere |
                                    forall p9, q9: Poly; forall m9, n9, i9: Nat;
                                      degreeAtMost(p9, m9) -> degreeAtMost(q9, n9) ->
                                      less_than(add(m9, n9), i9) ->
                                      forall j: Nat;
                                      mulR(coeff(p9, j), coeff(q9, sub(i9, j))) = zeroR
                                    [by cite aTermAboveTheDegreeSumVanishes]
                                  @every-term-vanishes |
                                    forall j: Nat;
                                      mulR(coeff(p, j), coeff(q, sub(i, j))) = zeroR
                                    [using specialize every-term-vanishes-everywhere(p, q, m, n, i) p-bounded q-bounded i-is-high]
                                  // base
                                  @the-base-term |
                                    convolution(p, q, i, ZERO) =
                                      mulR(coeff(p, ZERO), coeff(q, i))
                                    [using specialize ring_poly.convolutionZero(p, q, i)]
                                  @the-base-index |
                                    sub(i, ZERO) = i
                                    [using specialize subtraction.subZeroRight(i)]
                                  @the-base-term-vanishes |
                                    mulR(coeff(p, ZERO), coeff(q, sub(i, ZERO))) = zeroR
                                    [using specialize every-term-vanishes(ZERO)]
                                  @the-base-term-at-the-index |
                                    mulR(coeff(p, ZERO), coeff(q, i)) = zeroR
                                    [by rewrite the-base-index the-base-term-vanishes]
                                  @base-case |
                                    convolution(p, q, i, ZERO) = zeroR
                                    [using chain the-base-term the-base-term-at-the-index]
                                  // step
                                  @induction-step |
                                    fix k: Nat {
                                      @given-the-hypothesis |
                                        assume convolution(p, q, i, k) = zeroR {
                                          @the-hypothesis |
                                            convolution(p, q, i, k) = zeroR
                                            [by hypothesis given-the-hypothesis]
                                          @the-convolution-grows |
                                            convolution(p, q, i, succ(k)) =
                                              addR(convolution(p, q, i, k),
                                              mulR(coeff(p, succ(k)),
                                              coeff(q, sub(i, succ(k)))))
                                            [using specialize ring_poly.convolutionSucc(p, q, i, k)]
                                          @the-new-term-vanishes |
                                            mulR(coeff(p, succ(k)),
                                              coeff(q, sub(i, succ(k)))) = zeroR
                                            [using specialize every-term-vanishes(succ(k))]
                                          @adding-two-zeros |
                                            addR(zeroR, zeroR) = zeroR
                                            [using specialize ring.addZeroRight(zeroR)]
                                          @conclusion-at-succ-k |
                                            convolution(p, q, i, succ(k)) = zeroR
                                            [using simplify the-convolution-grows the-hypothesis the-new-term-vanishes adding-two-zeros]
                                        }
                                      @induction-step-at-k |
                                        (convolution(p, q, i, k) = zeroR) ->
                                          (convolution(p, q, i, succ(k)) = zeroR)
                                        [by discharge given-the-hypothesis]
                                    }
                                  @induction-step-for-all-k |
                                    forall k: Nat;
                                      (convolution(p, q, i, k) = zeroR) ->
                                      (convolution(p, q, i, succ(k)) = zeroR)
                                    [by generalize induction-step]
                                  @conclusion-for-all-k |
                                    forall k: Nat; convolution(p, q, i, k) = zeroR
                                    [using instantiation peano.induction((fun k: Nat => convolution(p, q, i, k) = zeroR)) base-case induction-step-for-all-k]
                                }
                              @high-implies |
                                less_than(add(m, n), i) ->
                                  forall k: Nat; convolution(p, q, i, k) = zeroR
                                [by discharge given-i-is-high]
                            }
                          @q-bounded-implies |
                            degreeAtMost(q, n) -> less_than(add(m, n), i) ->
                              forall k: Nat; convolution(p, q, i, k) = zeroR
                            [by discharge given-q-bounded]
                        }
                      @p-bounded-implies |
                        degreeAtMost(p, m) -> degreeAtMost(q, n) ->
                          less_than(add(m, n), i) ->
                          forall k: Nat; convolution(p, q, i, k) = zeroR
                        [by discharge given-p-bounded]
                    }
                  @discharge-i |
                    forall i9: Nat;
                      degreeAtMost(p, m) -> degreeAtMost(q, n) ->
                      less_than(add(m, n), i9) ->
                      forall k: Nat; convolution(p, q, i9, k) = zeroR
                    [by generalize generalize-i]
                }
              @discharge-n |
                forall n9, i9: Nat;
                  degreeAtMost(p, m) -> degreeAtMost(q, n9) ->
                  less_than(add(m, n9), i9) ->
                  forall k: Nat; convolution(p, q, i9, k) = zeroR
                [by generalize generalize-n]
            }
          @discharge-m |
            forall m9, n9, i9: Nat;
              degreeAtMost(p, m9) -> degreeAtMost(q, n9) ->
              less_than(add(m9, n9), i9) ->
              forall k: Nat; convolution(p, q, i9, k) = zeroR
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q9: Poly; forall m9, n9, i9: Nat;
          degreeAtMost(p, m9) -> degreeAtMost(q9, n9) ->
          less_than(add(m9, n9), i9) ->
          forall k: Nat; convolution(p, q9, i9, k) = zeroR
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, n, i: Nat;
      degreeAtMost(p, m) -> degreeAtMost(q, n) -> less_than(add(m, n), i) ->
      forall k: Nat; convolution(p, q, i, k) = zeroR
    [by generalize generalize-p]
qed

// EVERY TERM of the convolution vanishes above m+n: index j past m kills the p factor;
// otherwise j is at or below m, so i-j exceeds n and the q factor dies. The two cases are
// exhaustive because i itself exceeds m+n.
theorem aTermAboveTheDegreeSumVanishes: forall p, q: Poly; forall m, n, i: Nat;
  degreeAtMost(p, m) -> degreeAtMost(q, n) -> less_than(add(m, n), i) ->
  forall j: Nat; mulR(coeff(p, j), coeff(q, sub(i, j))) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @generalize-n |
                fix n: Nat {
                  @generalize-i |
                    fix i: Nat {
                      @given-p-bounded |
                        assume degreeAtMost(p, m) {
                          @p-bounded |
                            degreeAtMost(p, m)
                            [by hypothesis given-p-bounded]
                          @the-p-bound |
                            degreeAtMost(p, m) iff
                              (forall x: Nat; less_than(m, x) -> coeff(p, x) = zeroR)
                            [using specialize ring_poly.degreeAtMostMeaning(p, m)]
                          @p-dies-above-m |
                            forall x: Nat; less_than(m, x) -> coeff(p, x) = zeroR
                            [using tautology the-p-bound p-bounded]
                          @given-q-bounded |
                            assume degreeAtMost(q, n) {
                              @q-bounded |
                                degreeAtMost(q, n)
                                [by hypothesis given-q-bounded]
                              @the-q-bound |
                                degreeAtMost(q, n) iff
                                  (forall x: Nat; less_than(n, x) -> coeff(q, x) = zeroR)
                                [using specialize ring_poly.degreeAtMostMeaning(q, n)]
                              @q-dies-above-n |
                                forall x: Nat; less_than(n, x) -> coeff(q, x) = zeroR
                                [using tautology the-q-bound q-bounded]
                              @given-i-is-high |
                                assume less_than(add(m, n), i) {
                                  @i-is-high |
                                    less_than(add(m, n), i)
                                    [by hypothesis given-i-is-high]
                                  @generalize-j |
                                    fix j: Nat {
                                      @j-splits |
                                        less_than(m, j) or less_than(j, succ(m))
                                        [using specialize anIndexIsAboveOrWithin(m, j)]
                                      @when-j-is-high |
                                        assume less_than(m, j) {
                                          @j-is-high |
                                            less_than(m, j)
                                            [by hypothesis when-j-is-high]
                                          @the-p-factor-dies |
                                            coeff(p, j) = zeroR
                                            [using specialize p-dies-above-m(j) j-is-high]
                                          @zero-times-anything |
                                            mulR(zeroR, coeff(q, sub(i, j))) = zeroR
                                            [using specialize ring.mulZeroLeft(coeff(q, sub(i, j)))]
                                          @conclusion-the-p-side |
                                            mulR(coeff(p, j), coeff(q, sub(i, j))) = zeroR
                                            [by rewrite the-p-factor-dies zero-times-anything]
                                        }
                                      @when-j-is-low |
                                        assume less_than(j, succ(m)) {
                                          @j-is-low |
                                            less_than(j, succ(m))
                                            [by hypothesis when-j-is-low]
                                          // j <= m and m+n < i give n < i-j
                                          @n-is-below-the-index |
                                            less_than(n, sub(i, j))
                                            [using specialize theRemainingIndexExceedsTheSecondDegree(m, n, i, j) i-is-high j-is-low]
                                          @the-q-factor-dies |
                                            coeff(q, sub(i, j)) = zeroR
                                            [using specialize q-dies-above-n(sub(i, j)) n-is-below-the-index]
                                          @anything-times-zero |
                                            mulR(coeff(p, j), zeroR) = zeroR
                                            [using specialize ring.mulZeroRight(coeff(p, j))]
                                          @conclusion-the-q-side |
                                            mulR(coeff(p, j), coeff(q, sub(i, j))) = zeroR
                                            [by rewrite the-q-factor-dies anything-times-zero]
                                        }
                                      @conclusion-the-term-dies |
                                        mulR(coeff(p, j), coeff(q, sub(i, j))) = zeroR
                                        [by common_conclusion j-splits when-j-is-high when-j-is-low]
                                    }
                                  @conclusion-every-term-dies |
                                    forall j: Nat;
                                      mulR(coeff(p, j), coeff(q, sub(i, j))) = zeroR
                                    [by generalize generalize-j]
                                }
                              @high-implies |
                                less_than(add(m, n), i) ->
                                  forall j: Nat;
                                  mulR(coeff(p, j), coeff(q, sub(i, j))) = zeroR
                                [by discharge given-i-is-high]
                            }
                          @q-implies |
                            degreeAtMost(q, n) -> less_than(add(m, n), i) ->
                              forall j: Nat;
                              mulR(coeff(p, j), coeff(q, sub(i, j))) = zeroR
                            [by discharge given-q-bounded]
                        }
                      @p-implies |
                        degreeAtMost(p, m) -> degreeAtMost(q, n) ->
                          less_than(add(m, n), i) ->
                          forall j: Nat;
                          mulR(coeff(p, j), coeff(q, sub(i, j))) = zeroR
                        [by discharge given-p-bounded]
                    }
                  @discharge-i |
                    forall i9: Nat;
                      degreeAtMost(p, m) -> degreeAtMost(q, n) ->
                      less_than(add(m, n), i9) ->
                      forall j: Nat;
                      mulR(coeff(p, j), coeff(q, sub(i9, j))) = zeroR
                    [by generalize generalize-i]
                }
              @discharge-n |
                forall n9, i9: Nat;
                  degreeAtMost(p, m) -> degreeAtMost(q, n9) ->
                  less_than(add(m, n9), i9) ->
                  forall j: Nat;
                  mulR(coeff(p, j), coeff(q, sub(i9, j))) = zeroR
                [by generalize generalize-n]
            }
          @discharge-m |
            forall m9, n9, i9: Nat;
              degreeAtMost(p, m9) -> degreeAtMost(q, n9) ->
              less_than(add(m9, n9), i9) ->
              forall j: Nat;
              mulR(coeff(p, j), coeff(q, sub(i9, j))) = zeroR
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q9: Poly; forall m9, n9, i9: Nat;
          degreeAtMost(p, m9) -> degreeAtMost(q9, n9) ->
          less_than(add(m9, n9), i9) ->
          forall j: Nat;
          mulR(coeff(p, j), coeff(q9, sub(i9, j))) = zeroR
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, n, i: Nat;
      degreeAtMost(p, m) -> degreeAtMost(q, n) -> less_than(add(m, n), i) ->
      forall j: Nat; mulR(coeff(p, j), coeff(q, sub(i, j))) = zeroR
    [by generalize generalize-p]
qed

// An index is either past m or at most m: trichotomy, with the "at most" half folded into
// less_than(j, succ(m)).
theorem anIndexIsAboveOrWithin: forall m, j: Nat;
  less_than(m, j) or less_than(j, succ(m))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-j |
        fix j: Nat {
          @the-trichotomy |
            less_than(j, m) or j = m or less_than(m, j)
            [using specialize peano_order.trichotomy(j, m)]
          @below-gives-within |
            less_than(j, m) -> less_than(j, succ(m))
            [using specialize peano_order.lessThanSuccRight(j, m)]
          @the-equal-case-everywhere |
            forall j9, m9: Nat; j9 = m9 -> less_than(j9, succ(m9))
            [by cite theEqualCaseIsWithin]
          @equal-gives-within |
            j = m -> less_than(j, succ(m))
            [using specialize the-equal-case-everywhere(j, m)]
          @conclusion-above-or-within |
            less_than(m, j) or less_than(j, succ(m))
            [using tautology the-trichotomy below-gives-within equal-gives-within]
        }
      @discharge-j |
        forall j9: Nat; less_than(m, j9) or less_than(j9, succ(m))
        [by generalize generalize-j]
    }
  @conclusion |
    forall m, j: Nat; less_than(m, j) or less_than(j, succ(m))
    [by generalize generalize-m]
qed

// j = m puts j below succ(m), since nothing is below itself but everything is below its
// own successor.
theorem theEqualCaseIsWithin: forall j, m: Nat; j = m -> less_than(j, succ(m))
proof
  @generalize-j |
    fix j: Nat {
      @generalize-m |
        fix m: Nat {
          @given-equal |
            assume j = m {
              @they-are-equal |
                j = m
                [by hypothesis given-equal]
              @j-is-below-its-successor |
                less_than(j, succ(j))
                [using specialize peano_order.lessThanSelf(j)]
              @conclusion-within |
                less_than(j, succ(m))
                [by rewrite they-are-equal j-is-below-its-successor]
            }
          @equal-implies-within |
            j = m -> less_than(j, succ(m))
            [by discharge given-equal]
        }
      @discharge-m |
        forall m9: Nat; j = m9 -> less_than(j, succ(m9))
        [by generalize generalize-m]
    }
  @conclusion |
    forall j, m: Nat; j = m -> less_than(j, succ(m))
    [by generalize generalize-j]
qed
// m+n < i and j <= m give n < i-j: from j <= m, i-j is at least i-m, and i-m exceeds n
// because i exceeds m+n. Routed through the gap existential rather than by cases.
theorem theRemainingIndexExceedsTheSecondDegree: forall m, n, i, j: Nat;
  less_than(add(m, n), i) -> less_than(j, succ(m)) -> less_than(n, sub(i, j))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-n |
        fix n: Nat {
          @generalize-i |
            fix i: Nat {
              @generalize-j |
                fix j: Nat {
                  @given-i-is-high |
                    assume less_than(add(m, n), i) {
                      @i-is-high |
                        less_than(add(m, n), i)
                        [by hypothesis given-i-is-high]
                      @given-j-is-low |
                        assume less_than(j, succ(m)) {
                          @j-is-low |
                            less_than(j, succ(m))
                            [by hypothesis given-j-is-low]
                          // j <= m, so add(sub(m,j), j) = m
                          @m-recovers |
                            add(sub(m, j), j) = m
                            [using specialize subtraction.addSubCancel(j, m) j-is-low]
                          // i exceeds m+n = (sub(m,j)+j)+n, so sub(i,j) exceeds
                          // sub(m,j)+n, which is at least n
                          @the-regrouped-bound |
                            add(add(sub(m, j), n), j) = add(m, n)
                            [using simplify m-recovers the-regrouping]
                          @the-regrouping |
                            add(add(sub(m, j), n), j) = add(add(sub(m, j), j), n)
                            [using assoc_commut]
                          @the-sum-is-below-i |
                            less_than(add(add(sub(m, j), n), j), i)
                            [by rewrite the-regrouped-bound i-is-high]
                          // cancelling j from both sides of the strict inequality
                          @the-difference-exceeds |
                            less_than(add(sub(m, j), n), sub(i, j))
                            [using specialize aSumBelowGivesADifferenceAbove(add(sub(m, j), n), j, i) the-sum-is-below-i]
                          // n is at most sub(m,j)+n, so the strict bound carries
                          @n-is-at-most-the-sum |
                            peano_order.less_or_equal(n, add(sub(m, j), n))
                            [using specialize aSummandIsAtMostTheSum(sub(m, j), n)]
                          @conclusion-n-is-below |
                            less_than(n, sub(i, j))
                            [using specialize atMostThenBelow(n, add(sub(m, j), n), sub(i, j)) n-is-at-most-the-sum the-difference-exceeds]
                        }
                      @low-implies |
                        less_than(j, succ(m)) -> less_than(n, sub(i, j))
                        [by discharge given-j-is-low]
                    }
                  @high-implies |
                    less_than(add(m, n), i) -> less_than(j, succ(m)) ->
                      less_than(n, sub(i, j))
                    [by discharge given-i-is-high]
                }
              @discharge-j |
                forall j9: Nat;
                  less_than(add(m, n), i) -> less_than(j9, succ(m)) ->
                  less_than(n, sub(i, j9))
                [by generalize generalize-j]
            }
          @discharge-i |
            forall i9, j9: Nat;
              less_than(add(m, n), i9) -> less_than(j9, succ(m)) ->
              less_than(n, sub(i9, j9))
            [by generalize generalize-i]
        }
      @discharge-n |
        forall n9, i9, j9: Nat;
          less_than(add(m, n9), i9) -> less_than(j9, succ(m)) ->
          less_than(n9, sub(i9, j9))
        [by generalize generalize-n]
    }
  @conclusion |
    forall m, n, i, j: Nat;
      less_than(add(m, n), i) -> less_than(j, succ(m)) -> less_than(n, sub(i, j))
    [by generalize generalize-m]
qed

// the three index facts now in std, where they belong
fact aSumBelowGivesADifferenceAbove = subtraction.aSumBelowGivesADifferenceAbove
fact atMostThenBelow = peano_order.atMostThenBelowIsBelow
fact aSummandIsAtMostTheSum = peano_order.aSummandIsAtMostTheSum
