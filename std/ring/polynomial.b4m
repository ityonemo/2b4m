qed

theorem tripleDiagSucc:
  forall p, q, r: Poly; forall i, m, c: Nat;
  tripleDiag(p, q, r, i, m, succ(c)) =
  addR(tripleDiag(p, q, r, i, m, c),
  tripleTerm(p, q, r, i, c, theGapTo(m, c)))
proof
  @conclusion |
    forall p, q, r: Poly; forall i, m, c: Nat;
      tripleDiag(p, q, r, i, m, succ(c)) =
      addR(tripleDiag(p, q, r, i, m, c),
      tripleTerm(p, q, r, i, c, theGapTo(m, c)))
    [by definition(1) tripleDiag]
qed

