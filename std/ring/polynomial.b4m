// std/ring/polynomial.b4m — THE POLYNOMIAL RING R[x].
//
// Judson's Theorem 17.1: for a commutative ring R with identity, R[x] is a commutative ring
// with identity. This file builds R[x] as a SORT, following the pattern std/ring/factor.b4m
// uses for R/I — a second ring sort in its own file, with the operations posited as
// coefficient equations and the facts that justify them proved here.
//
// HOW A POLYNOMIAL IS CARRIED. Judson's polynomial is a coefficient list a_0 … a_n with
// a_n nonzero, and "two polynomials are equal exactly when their corresponding coefficients
// are equal". So the sort is observe-only through one accessor, `coeff(p, i)`, exactly as
// std/indexed.b4m carries a finite list through `at` — a `func` cannot take a `Nat => Ring`
// parameter, so the coefficient family is REIFIED as the sort itself rather than passed.
// Equality by coefficients is then an axiom (`polyExtensionality`), which is the surface
// 2b4m gives for "corresponding coefficients are equal": it is the extensionality principle
// for this carrier, not an assumption about any particular polynomial.
//
// WHY THE OPERATIONS ARE POSITED. `addP` and `mulP` cannot be DEFINED by a function
// definition, because each defining clause would have to range over an index: his
// c_i = a_i + b_i and c_i = sum_{k<=i} a_k b_{i-k} are statements about EVERY i, and a
// definition block cannot nest a quantifier in a clause. So each operation is a func whose
// coefficient equation is an axiom, and the theorems that the equations DETERMINE the result
// (there is at most one such polynomial, by extensionality) are proved here. Same division of
// labour as factor.b4m's `mulQHom` / `theProductIsWellDefinedModI`.
//
// DEGREE IS A BOUND, NOT -infinity. Judson gives the zero polynomial degree -infinity, which
// is not a Nat; rather than add a bottom element, `degreeAtMost(p, n)` says every coefficient
// above n vanishes. The zero polynomial satisfies it for EVERY n, which is exactly what
// degree -infinity is for, and the statements that need a real degree (17.4's
// deg(pq) = deg p + deg q) take the leading coefficient as a separate hypothesis. This keeps
// the index sort ℕ and avoids a second number tower.

import ring <<< "std/ring.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

// -- the coefficient ring R ---------------------------------------------------------------

sort R = ring.Ring
const zeroR = ring.ZERO
const oneR = ring.ONE
func addR = ring.add
func mulR = ring.mul
func negR = ring.neg

fact addIsAssociativeR = ring.addIsAssociative
fact addIsCommutativeR = ring.addIsCommutative
fact addZeroLeftR = ring.addZeroLeft
fact addZeroRightR = ring.addZeroRight
fact addNegLeftR = ring.addNegLeft
fact addNegRightR = ring.addNegRight
fact mulIsAssociativeR = ring.mulIsAssociative
fact mulAddDistribLeftR = ring.mulAddDistribLeft
fact mulAddDistribRightR = ring.mulAddDistribRight
fact mulZeroLeftR = ring.mulZeroLeft
fact mulZeroRightR = ring.mulZeroRight

// JUDSON'S STANDING ASSUMPTION FOR CHAPTER 17: "Throughout this chapter we shall assume that
// R is a commutative ring with identity." `std/ring.b4m` is the BARE ring — it declares ONE
// but axiomatizes neither an identity law nor commutativity of multiplication (its `ONE` is
// an unused constant), and `std/field.b4m` is too strong, since a field's nonzero elements
// are all invertible and R[x] is never a field. So the two extra hypotheses are stated here,
// over R's own multiplication, and they are the only assumptions this file adds to the ring
// theory. A caller that models this file supplies them for its own coefficient ring.
axiom mulOneLeftR: forall a: R; mulR(oneR, a) = a
axiom mulIsCommutativeR: forall a, b: R; mulR(a, b) = mulR(b, a)

// -- the index sort -----------------------------------------------------------------------

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func addN = peano.add
pred less_than = peano.less_than
define at_most(a, b) = peano_order.less_or_equal(a, b)

// -- the carrier: a polynomial IS its coefficient family ----------------------------------
//
// `Poly` is observe-only: `coeff` reads the i-th coefficient and nothing else inspects a
// polynomial. Judson's equality criterion is the extensionality axiom, and it is what makes
// the posited operations below DETERMINED rather than merely constrained.
sort Poly
func coeff(p: Poly, i: Nat) => R

axiom polyExtensionality: forall p, q: Poly;
  (forall i: Nat; coeff(p, i) = coeff(q, i)) -> p = q

// -- degree as a coefficient bound --------------------------------------------------------
// "every coefficient strictly above n is zero". The zero polynomial satisfies this for every
// n, which is Judson's degree -infinity without a bottom element in the index sort.
// (A definition block cannot nest a quantifier in a clause, so this is a declared pred with
// its meaning as an axiom rather than a `pred … :` definition.)
pred degreeAtMost(p: Poly, n: Nat)
axiom degreeAtMostMeaning: forall p: Poly; forall n: Nat;
  degreeAtMost(p, n) iff (forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroR)

// -- the zero and one of R[x] -------------------------------------------------------------

const ZEROP: Poly
axiom zeroPolyCoeff: forall i: Nat; coeff(ZEROP, i) = zeroR

const ONEP: Poly
axiom onePolyCoeffZero: coeff(ONEP, ZERO) = oneR
axiom onePolyCoeffHigher: forall i: Nat; coeff(ONEP, succ(i)) = zeroR

// -- addition: c_i = a_i + b_i -----------------------------------------------------------

func addP(p: Poly, q: Poly) => Poly:
  coeff(addP(p, q), i) = addR(coeff(p, i), coeff(q, i))

// -- negation: the inverse of p is the polynomial of negated coefficients -----------------

func negP(p: Poly) => Poly:
  coeff(negP(p), i) = negR(coeff(p, i))

// -- multiplication: the convolution c_i = sum_{k=0}^{i} a_k b_{i-k} ----------------------
//
// The convolution sum itself is a FOLD over the index range, which is what
// `convolution(p, q, i)` names: the sum of a_k b_{i-k} for k running 0..i. Its two defining
// equations are the fold's base and step, stated the way std/sequence.b4m states foldZero
// and foldSucc — the k = 0 term, then one more term for each successor.
// REINDEXED (2026-11-02, the no-totalizing-`sub` sweep). The second argument is now the
// COMPLEMENTARY exponent and counts DOWN, while the first counts UP:
//
//   convolution(p, q, j, m) = a_j b_m + a_{j+1} b_{m-1} + ... + a_{j+m} b_0
//
// so every term's two exponents sum to j + m and NO SUBTRACTION appears. The old form took
// the total `i` and computed `sub(i, succ(k))` at each step.
//
// Why reindex rather than guard: `coeff(q, sub(i, succ(k)))` owes `succ(k) <= i`, but
// `convolutionDistributes` and `convolutionAgainstOneCollapses` are genuinely unconditional
// in `k` — when the index runs out of range the term is annihilated by a zero coefficient, so
// its VALUE never mattered. That is the library's junk-value idiom, not the asserted-value
// violation `subZeroLeft` was. Guarding would have forced a false hypothesis onto true
// theorems; reindexing removes the obligation at its source.
func convolution(p: Poly, q: Poly, j: Nat, m: Nat) => R:
  convolution(p, q, j, ZERO) = mulR(coeff(p, j), coeff(q, ZERO));
  convolution(p, q, j, succ(m)) =
  addR(mulR(coeff(p, j), coeff(q, succ(m))), convolution(p, q, succ(j), m))

func mulP(p: Poly, q: Poly) => Poly:
  coeff(mulP(p, q), i) = convolution(p, q, ZERO, i)

// -- R's additive left-swap, which `assoc_commut`'s explicit AC triple requires -----------
//
// a + (b + c) = b + (a + c). `std/ring.b4m` proves associativity and commutativity but has
// no left-swap, and `assoc_commut` takes the whole triple or none.
theorem addLeftSwapR: forall a, b, c: R; addR(a, addR(b, c)) = addR(b, addR(a, c))
proof
  @generalize-a |
    fix a: R {
      @generalize-b |
        fix b: R {
          @generalize-c |
            fix c: R {
              @regroup-left-forward |
                addR(addR(a, b), c) = addR(a, addR(b, c))
                [using specialize addIsAssociativeR(a, b, c)]
              @regroup-left |
                addR(a, addR(b, c)) = addR(addR(a, b), c)
                [by symmetry regroup-left-forward]
              @swap-the-pair |
                addR(a, b) = addR(b, a)
                [using specialize addIsCommutativeR(a, b)]
              @regrouped-swapped |
                addR(a, addR(b, c)) = addR(addR(b, a), c)
                [using simplify regroup-left swap-the-pair]
              @regroup-right |
                addR(addR(b, a), c) = addR(b, addR(a, c))
                [using specialize addIsAssociativeR(b, a, c)]
              @conclusion-swapped |
                addR(a, addR(b, c)) = addR(b, addR(a, c))
                [using chain regrouped-swapped regroup-right]
            }
          @discharge-c |
            forall c: R; addR(a, addR(b, c)) = addR(b, addR(a, c))
            [by generalize generalize-c]
        }
      @discharge-b |
        forall b, c: R; addR(a, addR(b, c)) = addR(b, addR(a, c))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, c: R; addR(a, addR(b, c)) = addR(b, addR(a, c))
    [by generalize generalize-a]
qed

// == JUDSON'S THEOREM 17.1 ================================================================
//
// R[x] is a commutative ring with identity. Each ring axiom for R[x] reduces, by
// extensionality, to the corresponding axiom for R applied coefficientwise: "commutativity
// and associativity follow immediately from the definition of polynomial addition and from
// the fact that addition in R is both commutative and associative."

// His "commutativity … follows immediately from the definition of polynomial addition and
// from the fact that addition in R is commutative."
theorem polyAddIsCommutative: forall p, q: Poly; addP(p, q) = addP(q, p)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          // coeff(p+q, i) = a_i + b_i = b_i + a_i = coeff(q+p, i): the coefficient
          // equation on both sides, with R's commutativity in the middle.
          @generalize-index |
            fix i: Nat {
              @left-coefficient |
                coeff(addP(p, q), i) = addR(coeff(p, i), coeff(q, i))
                [using specialize addPolyCoeff(p, q, i)]
              @right-coefficient |
                coeff(addP(q, p), i) = addR(coeff(q, i), coeff(p, i))
                [using specialize addPolyCoeff(q, p, i)]
              @ring-addition-commutes |
                addR(coeff(p, i), coeff(q, i)) = addR(coeff(q, i), coeff(p, i))
                [using specialize addIsCommutativeR(coeff(p, i), coeff(q, i))]
              @coefficients-agree-at-index |
                coeff(addP(p, q), i) = coeff(addP(q, p), i)
                [using chain left-coefficient ring-addition-commutes right-coefficient]
            }
          @coefficients-agree |
            forall i: Nat; coeff(addP(p, q), i) = coeff(addP(q, p), i)
            [by generalize generalize-index]
          @conclusion-commutative |
            addP(p, q) = addP(q, p)
            [using specialize polyExtensionality(addP(p, q), addP(q, p)) coefficients-agree]
        }
      @discharge-q |
        forall q: Poly; addP(p, q) = addP(q, p)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; addP(p, q) = addP(q, p)
    [by generalize generalize-p]
qed

// His "associativity follow[s] immediately from the definition of polynomial addition and
// from the fact that addition in R is … associative."
theorem polyAddIsAssociative: forall p, q, r: Poly; addP(addP(p, q), r) = addP(p, addP(q, r))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-index |
                fix i: Nat {
                  @left-outer |
                    coeff(addP(addP(p, q), r), i) = addR(coeff(addP(p, q), i), coeff(r, i))
                    [using specialize addPolyCoeff(addP(p, q), r, i)]
                  @left-inner |
                    coeff(addP(p, q), i) = addR(coeff(p, i), coeff(q, i))
                    [using specialize addPolyCoeff(p, q, i)]
                  @left-expanded |
                    coeff(addP(addP(p, q), r), i) =
                      addR(addR(coeff(p, i), coeff(q, i)), coeff(r, i))
                    [using simplify left-outer left-inner]
                  @right-outer |
                    coeff(addP(p, addP(q, r)), i) = addR(coeff(p, i), coeff(addP(q, r), i))
                    [using specialize addPolyCoeff(p, addP(q, r), i)]
                  @right-inner |
                    coeff(addP(q, r), i) = addR(coeff(q, i), coeff(r, i))
                    [using specialize addPolyCoeff(q, r, i)]
                  @right-expanded |
                    coeff(addP(p, addP(q, r)), i) =
                      addR(coeff(p, i), addR(coeff(q, i), coeff(r, i)))
                    [using simplify right-outer right-inner]
                  @ring-addition-associates |
                    addR(addR(coeff(p, i), coeff(q, i)), coeff(r, i)) =
                      addR(coeff(p, i), addR(coeff(q, i), coeff(r, i)))
                    [using specialize addIsAssociativeR(coeff(p, i), coeff(q, i), coeff(r, i))]
                  @coefficients-agree-at-index |
                    coeff(addP(addP(p, q), r), i) = coeff(addP(p, addP(q, r)), i)
                    [using chain left-expanded ring-addition-associates right-expanded]
                }
              @coefficients-agree |
                forall i: Nat; coeff(addP(addP(p, q), r), i) = coeff(addP(p, addP(q, r)), i)
                [by generalize generalize-index]
              @conclusion-associative |
                addP(addP(p, q), r) = addP(p, addP(q, r))
                [using specialize polyExtensionality(addP(addP(p, q), r), addP(p, addP(q, r))) coefficients-agree]
            }
          @discharge-r |
            forall r: Poly; addP(addP(p, q), r) = addP(p, addP(q, r))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; addP(addP(p, q), r) = addP(p, addP(q, r))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; addP(addP(p, q), r) = addP(p, addP(q, r))
    [by generalize generalize-p]
qed

// His "the zero polynomial, f(x) = 0, is the additive identity."
theorem polyAddZeroLeft: forall p: Poly; addP(ZEROP, p) = p
proof
  @generalize-p |
    fix p: Poly {
      @generalize-index |
        fix i: Nat {
          @sum-coefficient |
            coeff(addP(ZEROP, p), i) = addR(coeff(ZEROP, i), coeff(p, i))
            [using specialize addPolyCoeff(ZEROP, p, i)]
          @zero-coefficient |
            coeff(ZEROP, i) = zeroR
            [using specialize zeroPolyCoeff(i)]
          @sum-is-zero-plus |
            coeff(addP(ZEROP, p), i) = addR(zeroR, coeff(p, i))
            [using simplify sum-coefficient zero-coefficient]
          @ring-zero-absorbs |
            addR(zeroR, coeff(p, i)) = coeff(p, i)
            [using specialize addZeroLeftR(coeff(p, i))]
          @coefficients-agree-at-index |
            coeff(addP(ZEROP, p), i) = coeff(p, i)
            [using chain sum-is-zero-plus ring-zero-absorbs]
        }
      @coefficients-agree |
        forall i: Nat; coeff(addP(ZEROP, p), i) = coeff(p, i)
        [by generalize generalize-index]
      @conclusion-identity |
        addP(ZEROP, p) = p
        [using specialize polyExtensionality(addP(ZEROP, p), p) coefficients-agree]
    }
  @conclusion |
    forall p: Poly; addP(ZEROP, p) = p
    [by generalize generalize-p]
qed

// His "the inverse of p(x) is easily verified to be -p(x) = sum (-a_i) x^i."
theorem polyAddNegLeft: forall p: Poly; addP(negP(p), p) = ZEROP
proof
  @generalize-p |
    fix p: Poly {
      @generalize-index |
        fix i: Nat {
          @sum-coefficient |
            coeff(addP(negP(p), p), i) = addR(coeff(negP(p), i), coeff(p, i))
            [using specialize addPolyCoeff(negP(p), p, i)]
          @negated-coefficient |
            coeff(negP(p), i) = negR(coeff(p, i))
            [using specialize negPolyCoeff(p, i)]
          @sum-is-neg-plus |
            coeff(addP(negP(p), p), i) = addR(negR(coeff(p, i)), coeff(p, i))
            [using simplify sum-coefficient negated-coefficient]
          @ring-inverse-cancels |
            addR(negR(coeff(p, i)), coeff(p, i)) = zeroR
            [using specialize addNegLeftR(coeff(p, i))]
          @zero-coefficient |
            coeff(ZEROP, i) = zeroR
            [using specialize zeroPolyCoeff(i)]
          @coefficients-agree-at-index |
            coeff(addP(negP(p), p), i) = coeff(ZEROP, i)
            [using chain sum-is-neg-plus ring-inverse-cancels zero-coefficient]
        }
      @coefficients-agree |
        forall i: Nat; coeff(addP(negP(p), p), i) = coeff(ZEROP, i)
        [by generalize generalize-index]
      @conclusion-inverse |
        addP(negP(p), p) = ZEROP
        [using specialize polyExtensionality(addP(negP(p), p), ZEROP) coefficients-agree]
    }
  @conclusion |
    forall p: Poly; addP(negP(p), p) = ZEROP
    [by generalize generalize-p]
qed

// -- the multiplicative identity ----------------------------------------------------------
//
// 1 in R[x] is the constant polynomial 1, and coeff(1*p, i) = convolution(1, p, i, i). The
// convolution against ONEP collapses because every higher coefficient of ONEP is zero, so
// only the k = 0 term survives. That collapse is an induction on the fold's upper limit.

// Above ONEP's only nonzero index every convolution term vanishes: each is
// coeff(ONEP, succ(j) + something) * _, and ONEP is zero at every positive index.
// Induction on the complement m, with the base index advancing.
// The base case of `convolutionAboveOneVanishes`: a single term, ONEP at a positive index.
theorem theVanishingBase: forall p: Poly; forall j: Nat;
  convolution(ONEP, p, succ(j), ZERO) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @generalize-j |
        fix j: Nat {
          @the-single-term |
            convolution(ONEP, p, succ(j), ZERO) =
              mulR(coeff(ONEP, succ(j)), coeff(p, ZERO))
            [using specialize convolutionZero(ONEP, p, succ(j))]
          @one-vanishes-above-zero |
            coeff(ONEP, succ(j)) = zeroR
            [using specialize onePolyCoeffHigher(j)]
          @the-term-is-zero-times |
            convolution(ONEP, p, succ(j), ZERO) = mulR(zeroR, coeff(p, ZERO))
            [using simplify the-single-term one-vanishes-above-zero]
          @zero-annihilates |
            mulR(zeroR, coeff(p, ZERO)) = zeroR
            [using specialize mulZeroLeftR(coeff(p, ZERO))]
          @conclusion-the-base-vanishes |
            convolution(ONEP, p, succ(j), ZERO) = zeroR
            [using chain the-term-is-zero-times zero-annihilates]
        }
      @discharge-j |
        forall j: Nat; convolution(ONEP, p, succ(j), ZERO) = zeroR
        [by generalize generalize-j]
    }
  @conclusion |
    forall p: Poly; forall j: Nat;
      convolution(ONEP, p, succ(j), ZERO) = zeroR
    [by generalize generalize-p]
qed

// The step: one more term, again ONEP at a positive index, plus the tail which the
// hypothesis kills. The hypothesis is quantified over the BASE index, because the step
// fires it at `succ(j)` rather than at `j`.
theorem theVanishingStep: forall p: Poly; forall m: Nat;
  (forall j: Nat; convolution(ONEP, p, succ(j), m) = zeroR) ->
  (forall j: Nat; convolution(ONEP, p, succ(j), succ(m)) = zeroR)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-m |
        fix m: Nat {
          @given-the-hypothesis |
            assume forall j: Nat; convolution(ONEP, p, succ(j), m) = zeroR {
              @the-hypothesis |
                forall j: Nat; convolution(ONEP, p, succ(j), m) = zeroR
                [by hypothesis given-the-hypothesis]
              @generalize-j |
                fix j: Nat {
                  @the-step |
                    convolution(ONEP, p, succ(j), succ(m)) =
                      addR(mulR(coeff(ONEP, succ(j)), coeff(p, succ(m))),
                      convolution(ONEP, p, succ(succ(j)), m))
                    [using specialize convolutionSucc(ONEP, p, succ(j), m)]
                  @one-vanishes-above-zero |
                    coeff(ONEP, succ(j)) = zeroR
                    [using specialize onePolyCoeffHigher(j)]
                  @the-new-term-is-zero |
                    mulR(zeroR, coeff(p, succ(m))) = zeroR
                    [using specialize mulZeroLeftR(coeff(p, succ(m)))]
                  @the-tail-vanishes |
                    convolution(ONEP, p, succ(succ(j)), m) = zeroR
                    [by apply_at(succ(j)) the-hypothesis]
                  @the-step-reduced |
                    convolution(ONEP, p, succ(j), succ(m)) = addR(zeroR, zeroR)
                    [using simplify the-step one-vanishes-above-zero
                      the-new-term-is-zero the-tail-vanishes]
                  @zero-plus-zero |
                    addR(zeroR, zeroR) = zeroR
                    [using specialize addZeroRightR(zeroR)]
                  @conclusion-the-step-vanishes |
                    convolution(ONEP, p, succ(j), succ(m)) = zeroR
                    [using chain the-step-reduced zero-plus-zero]
                }
              @all-base-indices |
                forall j: Nat; convolution(ONEP, p, succ(j), succ(m)) = zeroR
                [by generalize generalize-j]
            }
          @the-hypothesis-gives-it |
            (forall j: Nat; convolution(ONEP, p, succ(j), m) = zeroR) ->
              (forall j: Nat; convolution(ONEP, p, succ(j), succ(m)) = zeroR)
            [by discharge given-the-hypothesis]
        }
      @discharge-m |
        forall m: Nat;
          (forall j: Nat; convolution(ONEP, p, succ(j), m) = zeroR) ->
          (forall j: Nat; convolution(ONEP, p, succ(j), succ(m)) = zeroR)
        [by generalize generalize-m]
    }
  @conclusion |
    forall p: Poly; forall m: Nat;
      (forall j: Nat; convolution(ONEP, p, succ(j), m) = zeroR) ->
      (forall j: Nat; convolution(ONEP, p, succ(j), succ(m)) = zeroR)
    [by generalize generalize-p]
qed

// Above ONEP's only nonzero index every convolution term vanishes. Induction on the
// COMPLEMENT, with the base index quantified inside so the step can advance it.
theorem convolutionAboveOneVanishes: forall p: Poly; forall m, j: Nat;
  convolution(ONEP, p, succ(j), m) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @base-case |
        forall j: Nat; convolution(ONEP, p, succ(j), ZERO) = zeroR
        [using specialize theVanishingBase(p)]
      @induction-step-for-all-m |
        forall m: Nat;
          (forall j: Nat; convolution(ONEP, p, succ(j), m) = zeroR) ->
          (forall j: Nat; convolution(ONEP, p, succ(j), succ(m)) = zeroR)
        [using specialize theVanishingStep(p)]
      @all-complements |
        forall m: Nat; forall j: Nat; convolution(ONEP, p, succ(j), m) = zeroR
        [using instantiation peano.induction((fun z: Nat => forall j: Nat; convolution(ONEP, p, succ(j), z) = zeroR)) base-case induction-step-for-all-m]
    }
  @conclusion |
    forall p: Poly; forall m, j: Nat;
      convolution(ONEP, p, succ(j), m) = zeroR
    [by generalize generalize-p]
qed

// ONEP's convolution collapses to the other factor's coefficient at the complement: the
// j = 0 term is 1 * b_m and everything above it vanishes.
theorem convolutionAgainstOneCollapses: forall p: Poly; forall m: Nat;
  convolution(ONEP, p, ZERO, m) = mulR(oneR, coeff(p, m))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-m |
        fix m: Nat {
          @m-is-zero-or-successor |
            m = ZERO or (exists n: Nat; m = succ(n))
            [using specialize peano.zeroOrSucc(m)]
          @the-collapse |
            convolution(ONEP, p, ZERO, m) = mulR(oneR, coeff(p, m))
            [by common_conclusion m-is-zero-or-successor
              when-m-is-zero when-m-is-a-successor]
          @when-m-is-zero |
            assume m = ZERO {
              @m-is-zero |
                m = ZERO
                [by hypothesis when-m-is-zero]
              @the-base-term |
                convolution(ONEP, p, ZERO, ZERO) =
                  mulR(coeff(ONEP, ZERO), coeff(p, ZERO))
                [using specialize convolutionZero(ONEP, p, ZERO)]
              @one-at-zero |
                coeff(ONEP, ZERO) = oneR
                [by cite onePolyCoeffZero]
              @the-base-collapsed |
                convolution(ONEP, p, ZERO, ZERO) = mulR(oneR, coeff(p, ZERO))
                [using simplify the-base-term one-at-zero]
              @conclusion-at-zero |
                convolution(ONEP, p, ZERO, m) = mulR(oneR, coeff(p, m))
                [by rewrite m-is-zero the-base-collapsed]
            }
          @when-m-is-a-successor |
            assume exists n: Nat; m = succ(n) {
              @the-predecessor-exists |
                exists n: Nat; m = succ(n)
                [by hypothesis when-m-is-a-successor]
              @with-the-predecessor |
                unpack mn: Nat from the-predecessor-exists {
                  @m-is-succ-mn |
                    m = succ(mn)
                    [by hypothesis with-the-predecessor]
                  @the-step |
                    convolution(ONEP, p, ZERO, succ(mn)) =
                      addR(mulR(coeff(ONEP, ZERO), coeff(p, succ(mn))),
                      convolution(ONEP, p, succ(ZERO), mn))
                    [using specialize convolutionSucc(ONEP, p, ZERO, mn)]
                  @one-at-zero-here |
                    coeff(ONEP, ZERO) = oneR
                    [by cite onePolyCoeffZero]
                  @the-tail-vanishes |
                    convolution(ONEP, p, succ(ZERO), mn) = zeroR
                    [using specialize convolutionAboveOneVanishes(p, mn, ZERO)]
                  @the-step-reduced |
                    convolution(ONEP, p, ZERO, succ(mn)) =
                      addR(mulR(oneR, coeff(p, succ(mn))), zeroR)
                    [using simplify the-step one-at-zero-here the-tail-vanishes]
                  @zero-on-the-right |
                    addR(mulR(oneR, coeff(p, succ(mn))), zeroR) =
                      mulR(oneR, coeff(p, succ(mn)))
                    [using specialize addZeroRightR(mulR(oneR, coeff(p, succ(mn))))]
                  @the-collapse-at-the-successor |
                    convolution(ONEP, p, ZERO, succ(mn)) =
                      mulR(oneR, coeff(p, succ(mn)))
                    [using chain the-step-reduced zero-on-the-right]
                  @conclusion-at-the-successor |
                    convolution(ONEP, p, ZERO, m) = mulR(oneR, coeff(p, m))
                    [by rewrite m-is-succ-mn the-collapse-at-the-successor]
                }
              @conclusion-from-the-predecessor |
                convolution(ONEP, p, ZERO, m) = mulR(oneR, coeff(p, m))
                [by unpacked with-the-predecessor]
            }
        }
      @discharge-m |
        forall m: Nat; convolution(ONEP, p, ZERO, m) = mulR(oneR, coeff(p, m))
        [by generalize generalize-m]
    }
  @conclusion |
    forall p: Poly; forall m: Nat;
      convolution(ONEP, p, ZERO, m) = mulR(oneR, coeff(p, m))
    [by generalize generalize-p]
qed

// 1 is the identity of R[x]: the convolution collapses to 1 * b_i = b_i.
theorem polyMulOneLeft: forall p: Poly; mulP(ONEP, p) = p
proof
  @generalize-p |
    fix p: Poly {
      @generalize-index |
        fix i: Nat {
          @product-coefficient |
            coeff(mulP(ONEP, p), i) = convolution(ONEP, p, ZERO, i)
            [using specialize mulPolyCoeff(ONEP, p, i)]
          @convolution-collapses |
            convolution(ONEP, p, ZERO, i) = mulR(oneR, coeff(p, i))
            [using specialize convolutionAgainstOneCollapses(p, i)]
          @ring-one-is-identity |
            mulR(oneR, coeff(p, i)) = coeff(p, i)
            [using specialize mulOneLeftR(coeff(p, i))]
          @coefficients-agree-at-index |
            coeff(mulP(ONEP, p), i) = coeff(p, i)
            [using chain product-coefficient convolution-collapses ring-one-is-identity]
        }
      @coefficients-agree |
        forall i: Nat; coeff(mulP(ONEP, p), i) = coeff(p, i)
        [by generalize generalize-index]
      @conclusion-identity |
        mulP(ONEP, p) = p
        [using specialize polyExtensionality(mulP(ONEP, p), p) coefficients-agree]
    }
  @conclusion |
    forall p: Poly; mulP(ONEP, p) = p
    [by generalize generalize-p]
qed

// -- DISTRIBUTIVITY: p(q + r) = pq + pr ---------------------------------------------------
//
// Judson leaves this as an exercise ("The commutativity and distribution properties of
// polynomial multiplication are proved in a similar manner. We shall leave the proofs of
// these properties as an exercise."). It is an induction on the convolution's upper limit:
// each term a_k (b + c)_{i-k} splits as a_k b_{i-k} + a_k c_{i-k} by R's distributivity, and
// the two running sums stay separated because R's addition is commutative and associative.

// The convolution against a SUM splits into the sum of the two convolutions, at every k.
// The base case of `convolutionDistributes`: one term, and R distributes.
theorem theDistributionBase: forall p, q, r: Poly; forall j: Nat;
  convolution(p, addP(q, r), j, ZERO) =
  addR(convolution(p, q, j, ZERO), convolution(p, r, j, ZERO))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-j |
                fix j: Nat {
                  @the-sum-side |
                    convolution(p, addP(q, r), j, ZERO) =
                      mulR(coeff(p, j), coeff(addP(q, r), ZERO))
                    [using specialize convolutionZero(p, addP(q, r), j)]
                  @the-coefficient-splits |
                    coeff(addP(q, r), ZERO) =
                      addR(coeff(q, ZERO), coeff(r, ZERO))
                    [using specialize addPolyCoeff(q, r, ZERO)]
                  @the-product-distributes |
                    mulR(coeff(p, j), addR(coeff(q, ZERO), coeff(r, ZERO))) =
                      addR(mulR(coeff(p, j), coeff(q, ZERO)),
                      mulR(coeff(p, j), coeff(r, ZERO)))
                    [using specialize mulAddDistribLeftR(
                      coeff(p, j), coeff(q, ZERO), coeff(r, ZERO))]
                  @the-q-side |
                    convolution(p, q, j, ZERO) =
                      mulR(coeff(p, j), coeff(q, ZERO))
                    [using specialize convolutionZero(p, q, j)]
                  @the-r-side |
                    convolution(p, r, j, ZERO) =
                      mulR(coeff(p, j), coeff(r, ZERO))
                    [using specialize convolutionZero(p, r, j)]
                  @conclusion-the-base-distributes |
                    convolution(p, addP(q, r), j, ZERO) =
                      addR(convolution(p, q, j, ZERO), convolution(p, r, j, ZERO))
                    [using simplify the-sum-side the-coefficient-splits
                      the-product-distributes the-q-side the-r-side]
                }
              @discharge-j |
                forall j: Nat;
                  convolution(p, addP(q, r), j, ZERO) =
                  addR(convolution(p, q, j, ZERO), convolution(p, r, j, ZERO))
                [by generalize generalize-j]
            }
          @discharge-r |
            forall r: Poly; forall j: Nat;
              convolution(p, addP(q, r), j, ZERO) =
              addR(convolution(p, q, j, ZERO), convolution(p, r, j, ZERO))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall j: Nat;
          convolution(p, addP(q, r), j, ZERO) =
          addR(convolution(p, q, j, ZERO), convolution(p, r, j, ZERO))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall j: Nat;
      convolution(p, addP(q, r), j, ZERO) =
      addR(convolution(p, q, j, ZERO), convolution(p, r, j, ZERO))
    [by generalize generalize-p]
qed

// The step: one new term plus the tail, with the hypothesis quantified over the BASE index
// because the step fires it at `succ(j)`. A/C reordering joins the four summands into two.
theorem theDistributionStep: forall p, q, r: Poly; forall m: Nat;
  (forall j: Nat;
  convolution(p, addP(q, r), j, m) =
  addR(convolution(p, q, j, m), convolution(p, r, j, m))) ->
  (forall j: Nat;
  convolution(p, addP(q, r), j, succ(m)) =
  addR(convolution(p, q, j, succ(m)), convolution(p, r, j, succ(m))))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-m |
                fix m: Nat {
                  @given-the-hypothesis |
                    assume forall j: Nat;
                      convolution(p, addP(q, r), j, m) =
                      addR(convolution(p, q, j, m), convolution(p, r, j, m)) {
                      @the-hypothesis |
                        forall j: Nat;
                          convolution(p, addP(q, r), j, m) =
                          addR(convolution(p, q, j, m), convolution(p, r, j, m))
                        [by hypothesis given-the-hypothesis]
                      @generalize-j |
                        fix j: Nat {
                          @the-sum-step |
                            convolution(p, addP(q, r), j, succ(m)) =
                              addR(mulR(coeff(p, j), coeff(addP(q, r), succ(m))),
                              convolution(p, addP(q, r), succ(j), m))
                            [using specialize convolutionSucc(p, addP(q, r), j, m)]
                          @the-coefficient-splits |
                            coeff(addP(q, r), succ(m)) =
                              addR(coeff(q, succ(m)), coeff(r, succ(m)))
                            [using specialize addPolyCoeff(q, r, succ(m))]
                          @the-product-distributes |
                            mulR(coeff(p, j),
                              addR(coeff(q, succ(m)), coeff(r, succ(m)))) =
                              addR(mulR(coeff(p, j), coeff(q, succ(m))),
                              mulR(coeff(p, j), coeff(r, succ(m))))
                            [using specialize mulAddDistribLeftR(
                              coeff(p, j), coeff(q, succ(m)), coeff(r, succ(m)))]
                          @the-tail-splits |
                            convolution(p, addP(q, r), succ(j), m) =
                              addR(convolution(p, q, succ(j), m),
                              convolution(p, r, succ(j), m))
                            [by apply_at(succ(j)) the-hypothesis]
                          @the-four-summands |
                            convolution(p, addP(q, r), j, succ(m)) =
                              addR(addR(mulR(coeff(p, j), coeff(q, succ(m))),
                              mulR(coeff(p, j), coeff(r, succ(m)))),
                              addR(convolution(p, q, succ(j), m),
                              convolution(p, r, succ(j), m)))
                            [using simplify the-sum-step the-coefficient-splits
                              the-product-distributes the-tail-splits]
                          @the-q-step |
                            convolution(p, q, j, succ(m)) =
                              addR(mulR(coeff(p, j), coeff(q, succ(m))),
                              convolution(p, q, succ(j), m))
                            [using specialize convolutionSucc(p, q, j, m)]
                          @the-r-step |
                            convolution(p, r, j, succ(m)) =
                              addR(mulR(coeff(p, j), coeff(r, succ(m))),
                              convolution(p, r, succ(j), m))
                            [using specialize convolutionSucc(p, r, j, m)]
                          @the-summands-reorder |
                            addR(addR(mulR(coeff(p, j), coeff(q, succ(m))),
                              mulR(coeff(p, j), coeff(r, succ(m)))),
                              addR(convolution(p, q, succ(j), m),
                              convolution(p, r, succ(j), m))) =
                              addR(addR(mulR(coeff(p, j), coeff(q, succ(m))),
                              convolution(p, q, succ(j), m)),
                              addR(mulR(coeff(p, j), coeff(r, succ(m))),
                              convolution(p, r, succ(j), m)))
                            [using assoc_commut(addIsAssociativeR, addIsCommutativeR,
                              addLeftSwapR)]
                          @the-regrouped-sum |
                            convolution(p, addP(q, r), j, succ(m)) =
                              addR(addR(mulR(coeff(p, j), coeff(q, succ(m))),
                              convolution(p, q, succ(j), m)),
                              addR(mulR(coeff(p, j), coeff(r, succ(m))),
                              convolution(p, r, succ(j), m)))
                            [using chain the-four-summands the-summands-reorder]
                          @conclusion-the-step-distributes |
                            convolution(p, addP(q, r), j, succ(m)) =
                              addR(convolution(p, q, j, succ(m)),
                              convolution(p, r, j, succ(m)))
                            [using simplify the-regrouped-sum the-q-step the-r-step]
                        }
                      @all-base-indices |
                        forall j: Nat;
                          convolution(p, addP(q, r), j, succ(m)) =
                          addR(convolution(p, q, j, succ(m)),
                          convolution(p, r, j, succ(m)))
                        [by generalize generalize-j]
                    }
                  @the-hypothesis-gives-it |
                    (forall j: Nat;
                      convolution(p, addP(q, r), j, m) =
                      addR(convolution(p, q, j, m), convolution(p, r, j, m))) ->
                      (forall j: Nat;
                      convolution(p, addP(q, r), j, succ(m)) =
                      addR(convolution(p, q, j, succ(m)),
                      convolution(p, r, j, succ(m))))
                    [by discharge given-the-hypothesis]
                }
              @discharge-m |
                forall m: Nat;
                  (forall j: Nat;
                  convolution(p, addP(q, r), j, m) =
                  addR(convolution(p, q, j, m), convolution(p, r, j, m))) ->
                  (forall j: Nat;
                  convolution(p, addP(q, r), j, succ(m)) =
                  addR(convolution(p, q, j, succ(m)),
                  convolution(p, r, j, succ(m))))
                [by generalize generalize-m]
            }
          @discharge-r |
            forall r: Poly; forall m: Nat;
              (forall j: Nat;
              convolution(p, addP(q, r), j, m) =
              addR(convolution(p, q, j, m), convolution(p, r, j, m))) ->
              (forall j: Nat;
              convolution(p, addP(q, r), j, succ(m)) =
              addR(convolution(p, q, j, succ(m)),
              convolution(p, r, j, succ(m))))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall m: Nat;
          (forall j: Nat;
          convolution(p, addP(q, r), j, m) =
          addR(convolution(p, q, j, m), convolution(p, r, j, m))) ->
          (forall j: Nat;
          convolution(p, addP(q, r), j, succ(m)) =
          addR(convolution(p, q, j, succ(m)),
          convolution(p, r, j, succ(m))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall m: Nat;
      (forall j: Nat;
      convolution(p, addP(q, r), j, m) =
      addR(convolution(p, q, j, m), convolution(p, r, j, m))) ->
      (forall j: Nat;
      convolution(p, addP(q, r), j, succ(m)) =
      addR(convolution(p, q, j, succ(m)),
      convolution(p, r, j, succ(m))))
    [by generalize generalize-p]
qed

// The convolution distributes over a sum in its second factor. Unconditional in both indices,
// as it was before the reindex — the induction simply runs on the complement now.
theorem convolutionDistributes: forall p, q, r: Poly; forall m, j: Nat;
  convolution(p, addP(q, r), j, m) =
  addR(convolution(p, q, j, m), convolution(p, r, j, m))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @base-case |
                forall j: Nat;
                  convolution(p, addP(q, r), j, ZERO) =
                  addR(convolution(p, q, j, ZERO), convolution(p, r, j, ZERO))
                [using specialize theDistributionBase(p, q, r)]
              @induction-step-for-all-m |
                forall m: Nat;
                  (forall j: Nat;
                  convolution(p, addP(q, r), j, m) =
                  addR(convolution(p, q, j, m), convolution(p, r, j, m))) ->
                  (forall j: Nat;
                  convolution(p, addP(q, r), j, succ(m)) =
                  addR(convolution(p, q, j, succ(m)),
                  convolution(p, r, j, succ(m))))
                [using specialize theDistributionStep(p, q, r)]
              @all-complements |
                forall m: Nat; forall j: Nat;
                  convolution(p, addP(q, r), j, m) =
                  addR(convolution(p, q, j, m), convolution(p, r, j, m))
                [using instantiation peano.induction((fun z: Nat => forall j: Nat; convolution(p, addP(q, r), j, z) = addR(convolution(p, q, j, z), convolution(p, r, j, z)))) base-case induction-step-for-all-m]
            }
          @discharge-r |
            forall r: Poly; forall m, j: Nat;
              convolution(p, addP(q, r), j, m) =
              addR(convolution(p, q, j, m), convolution(p, r, j, m))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall m, j: Nat;
          convolution(p, addP(q, r), j, m) =
          addR(convolution(p, q, j, m), convolution(p, r, j, m))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall m, j: Nat;
      convolution(p, addP(q, r), j, m) =
      addR(convolution(p, q, j, m), convolution(p, r, j, m))
    [by generalize generalize-p]
qed

// The distributive law for R[x], from the convolution's own distributivity at i = i.
theorem polyMulAddDistribLeft: forall p, q, r: Poly;
  mulP(p, addP(q, r)) = addP(mulP(p, q), mulP(p, r))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-index |
                fix i: Nat {
                  @product-with-sum |
                    coeff(mulP(p, addP(q, r)), i) = convolution(p, addP(q, r), ZERO, i)
                    [using specialize mulPolyCoeff(p, addP(q, r), i)]
                  @convolution-splits |
                    convolution(p, addP(q, r), ZERO, i) =
                      addR(convolution(p, q, ZERO, i), convolution(p, r, ZERO, i))
                    [using specialize convolutionDistributes(p, q, r, i, ZERO)]
                  @left-product |
                    coeff(mulP(p, q), i) = convolution(p, q, ZERO, i)
                    [using specialize mulPolyCoeff(p, q, i)]
                  @right-product |
                    coeff(mulP(p, r), i) = convolution(p, r, ZERO, i)
                    [using specialize mulPolyCoeff(p, r, i)]
                  @sum-of-products |
                    coeff(addP(mulP(p, q), mulP(p, r)), i) =
                      addR(coeff(mulP(p, q), i), coeff(mulP(p, r), i))
                    [using specialize addPolyCoeff(mulP(p, q), mulP(p, r), i)]
                  @sum-side-in-convolutions |
                    coeff(addP(mulP(p, q), mulP(p, r)), i) =
                      addR(convolution(p, q, ZERO, i), convolution(p, r, ZERO, i))
                    [using simplify sum-of-products left-product right-product]
                  @product-side-in-convolutions |
                    coeff(mulP(p, addP(q, r)), i) =
                      addR(convolution(p, q, ZERO, i), convolution(p, r, ZERO, i))
                    [using simplify product-with-sum convolution-splits]
                  @coefficients-agree-at-index |
                    coeff(mulP(p, addP(q, r)), i) = coeff(addP(mulP(p, q), mulP(p, r)), i)
                    [using chain product-side-in-convolutions sum-side-in-convolutions]
                }
              @coefficients-agree |
                forall i: Nat;
                  coeff(mulP(p, addP(q, r)), i) = coeff(addP(mulP(p, q), mulP(p, r)), i)
                [by generalize generalize-index]
              @conclusion-distributes |
                mulP(p, addP(q, r)) = addP(mulP(p, q), mulP(p, r))
                [using specialize polyExtensionality(mulP(p, addP(q, r)), addP(mulP(p, q), mulP(p, r))) coefficients-agree]
            }
          @discharge-r |
            forall r: Poly; mulP(p, addP(q, r)) = addP(mulP(p, q), mulP(p, r))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; mulP(p, addP(q, r)) = addP(mulP(p, q), mulP(p, r))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; mulP(p, addP(q, r)) = addP(mulP(p, q), mulP(p, r))
    [by generalize generalize-p]
qed

// -- DEGREE: the bound behaves under addition ---------------------------------------------
//
// If neither p nor q has a coefficient above n, neither does p + q. This is the half of
// Judson's degree arithmetic that needs no integral domain — it is the statement that
// deg(p + q) <= max(deg p, deg q), written with a common bound.
theorem polyAddDegreeBound: forall p, q: Poly; forall n: Nat;
  degreeAtMost(p, n) -> degreeAtMost(q, n) -> degreeAtMost(addP(p, q), n)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-n |
            fix n: Nat {
              @given-p-bounded |
                assume degreeAtMost(p, n) {
                  @given-q-bounded |
                    assume degreeAtMost(q, n) {
                      @p-bounded |
                        degreeAtMost(p, n)
                        [by hypothesis given-p-bounded]
                      @q-bounded |
                        degreeAtMost(q, n)
                        [by hypothesis given-q-bounded]
                      @bound-meaning-p |
                        degreeAtMost(p, n) iff
                          (forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroR)
                        [using specialize degreeAtMostMeaning(p, n)]
                      @bound-meaning-q |
                        degreeAtMost(q, n) iff
                          (forall i: Nat; less_than(n, i) -> coeff(q, i) = zeroR)
                        [using specialize degreeAtMostMeaning(q, n)]
                      @p-vanishes-above |
                        forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroR
                        [using tautology p-bounded bound-meaning-p]
                      @q-vanishes-above |
                        forall i: Nat; less_than(n, i) -> coeff(q, i) = zeroR
                        [using tautology q-bounded bound-meaning-q]
                      @generalize-index |
                        fix i: Nat {
                          @given-index-above |
                            assume less_than(n, i) {
                              @index-above |
                                less_than(n, i)
                                [by hypothesis given-index-above]
                              @p-zero-here |
                                coeff(p, i) = zeroR
                                [using specialize p-vanishes-above(i) index-above]
                              @q-zero-here |
                                coeff(q, i) = zeroR
                                [using specialize q-vanishes-above(i) index-above]
                              @sum-here |
                                coeff(addP(p, q), i) = addR(coeff(p, i), coeff(q, i))
                                [using specialize addPolyCoeff(p, q, i)]
                              @sum-of-zeros |
                                coeff(addP(p, q), i) = addR(zeroR, zeroR)
                                [using simplify sum-here p-zero-here q-zero-here]
                              @zero-plus-zero |
                                addR(zeroR, zeroR) = zeroR
                                [using specialize addZeroLeftR(zeroR)]
                              @conclusion-vanishes-here |
                                coeff(addP(p, q), i) = zeroR
                                [using chain sum-of-zeros zero-plus-zero]
                            }
                          @index-above-implies-zero |
                            less_than(n, i) -> coeff(addP(p, q), i) = zeroR
                            [by discharge given-index-above]
                        }
                      @sum-vanishes-above |
                        forall i: Nat; less_than(n, i) -> coeff(addP(p, q), i) = zeroR
                        [by generalize generalize-index]
                      @bound-meaning-sum |
                        degreeAtMost(addP(p, q), n) iff
                          (forall i: Nat; less_than(n, i) -> coeff(addP(p, q), i) = zeroR)
                        [using specialize degreeAtMostMeaning(addP(p, q), n)]
                      @conclusion-bounded |
                        degreeAtMost(addP(p, q), n)
                        [using tautology sum-vanishes-above bound-meaning-sum]
                    }
                  @q-bounded-implies-sum-bounded |
                    degreeAtMost(q, n) -> degreeAtMost(addP(p, q), n)
                    [by discharge given-q-bounded]
                }
              @both-bounded-implies-sum-bounded |
                degreeAtMost(p, n) -> degreeAtMost(q, n) -> degreeAtMost(addP(p, q), n)
                [by discharge given-p-bounded]
            }
          @discharge-n |
            forall n: Nat;
              degreeAtMost(p, n) -> degreeAtMost(q, n) -> degreeAtMost(addP(p, q), n)
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q: Poly; forall n: Nat;
          degreeAtMost(p, n) -> degreeAtMost(q, n) -> degreeAtMost(addP(p, q), n)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall n: Nat;
      degreeAtMost(p, n) -> degreeAtMost(q, n) -> degreeAtMost(addP(p, q), n)
    [by generalize generalize-p]
qed

// -- the k = 0 coefficient of a product ---------------------------------------------------
//
// coeff(pq, 0) = a_0 b_0: the convolution at i = 0 is its own base term. With R commutative
// this is symmetric in p and q, which is the constant term of Judson's exercise that R[x] is
// commutative. The full commutativity needs the convolution sum REVERSED (reindexing
// k -> i-k), which needs a summation-reversal lemma std does not have; see the file's
// closing note.
theorem polyProductConstantTerm: forall p, q: Poly;
  coeff(mulP(p, q), ZERO) = mulR(coeff(p, ZERO), coeff(q, ZERO))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @product-coefficient |
            coeff(mulP(p, q), ZERO) = convolution(p, q, ZERO, ZERO)
            [using specialize mulPolyCoeff(p, q, ZERO)]
          @convolution-base |
            convolution(p, q, ZERO, ZERO) = mulR(coeff(p, ZERO), coeff(q, ZERO))
            [using specialize convolutionZero(p, q, ZERO)]
          @conclusion-constant-term |
            coeff(mulP(p, q), ZERO) = mulR(coeff(p, ZERO), coeff(q, ZERO))
            [using chain product-coefficient convolution-base]
        }
      @discharge-q |
        forall q: Poly; coeff(mulP(p, q), ZERO) = mulR(coeff(p, ZERO), coeff(q, ZERO))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; coeff(mulP(p, q), ZERO) = mulR(coeff(p, ZERO), coeff(q, ZERO))
    [by generalize generalize-p]
qed

// The constant terms of pq and qp agree, which is R's commutativity at index 0.
theorem polyProductConstantTermCommutes: forall p, q: Poly;
  coeff(mulP(p, q), ZERO) = coeff(mulP(q, p), ZERO)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @forward-constant-term |
            coeff(mulP(p, q), ZERO) = mulR(coeff(p, ZERO), coeff(q, ZERO))
            [using specialize polyProductConstantTerm(p, q)]
          @reversed-constant-term |
            coeff(mulP(q, p), ZERO) = mulR(coeff(q, ZERO), coeff(p, ZERO))
            [using specialize polyProductConstantTerm(q, p)]
          @ring-multiplication-commutes |
            mulR(coeff(p, ZERO), coeff(q, ZERO)) = mulR(coeff(q, ZERO), coeff(p, ZERO))
            [using specialize mulIsCommutativeR(coeff(p, ZERO), coeff(q, ZERO))]
          @conclusion-constant-terms-agree |
            coeff(mulP(p, q), ZERO) = coeff(mulP(q, p), ZERO)
            [using chain forward-constant-term ring-multiplication-commutes reversed-constant-term]
        }
      @discharge-q |
        forall q: Poly; coeff(mulP(p, q), ZERO) = coeff(mulP(q, p), ZERO)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; coeff(mulP(p, q), ZERO) = coeff(mulP(q, p), ZERO)
    [by generalize generalize-p]
qed

// -- DEGREE AS A NUMBER -------------------------------------------------------------------
//
// `degreeAtMost` is a bound, which is all §17.1 needed. Judson's §17.2 writes `deg p(x) = n`
// as a VALUE and does arithmetic on it (`deg r < deg g`, `deg pq = deg p + deg q`), so the
// degree has to be a function.
//
// WHY IT IS TOTAL WITH A GUARDED AXIOM. The zero polynomial has no largest nonzero
// coefficient — Judson gives it degree -infinity, which is not a Nat. Rather than add a
// bottom element to the index sort, `degree` is a TOTAL function whose only axiom is guarded
// on `p != ZEROP`, exactly as `std/field.b4m` treats `recip`: `recip(ZERO)` is an
// unconstrained junk value that no axiom can reach, so it is never usable. `degree(ZEROP)`
// is junk in the same way, and every statement below that mentions a degree carries the
// nonzero hypothesis that makes it meaningful.
func degree(p: Poly) => Nat

// The defining property, in two halves: the degree's own coefficient does not vanish, and
// nothing above it survives. Together these say "the largest index with a nonzero
// coefficient", which is Judson's definition.
axiom degreeIsALeadingIndex: forall p: Poly;
  (not (p = ZEROP)) -> (not (coeff(p, degree(p)) = zeroR))
axiom degreeBoundsTheCoefficients: forall p: Poly;
  (not (p = ZEROP)) -> degreeAtMost(p, degree(p))

// `degree` is DETERMINED by those two halves: any index with both properties IS the degree.
// This is what lets a proof conclude `degree(p) = n` from facts about coefficients, and it
// is the uniqueness that makes the function well-defined rather than merely constrained.
theorem degreeIsUnique: forall p: Poly; forall n: Nat;
  (not (p = ZEROP)) -> (not (coeff(p, n) = zeroR)) -> degreeAtMost(p, n) ->
  n = degree(p)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-n |
        fix n: Nat {
          @given-p-nonzero |
            assume not (p = ZEROP) {
              @given-coefficient-nonzero |
                assume not (coeff(p, n) = zeroR) {
                  @given-n-bounds |
                    assume degreeAtMost(p, n) {
                      @p-nonzero |
                        not (p = ZEROP)
                        [by hypothesis given-p-nonzero]
                      @coefficient-at-n-nonzero |
                        not (coeff(p, n) = zeroR)
                        [by hypothesis given-coefficient-nonzero]
                      @n-bounds-the-coefficients |
                        degreeAtMost(p, n)
                        [by hypothesis given-n-bounds]

                      // the degree's own coefficient is nonzero, and n bounds everything,
                      // so the degree cannot exceed n.
                      @degree-coefficient-nonzero |
                        not (coeff(p, degree(p)) = zeroR)
                        [using specialize degreeIsALeadingIndex(p) p-nonzero]
                      @what-n-bounding-means |
                        degreeAtMost(p, n) iff
                          (forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroR)
                        [using specialize degreeAtMostMeaning(p, n)]
                      @above-n-everything-vanishes |
                        forall i: Nat; less_than(n, i) -> coeff(p, i) = zeroR
                        [using tautology n-bounds-the-coefficients what-n-bounding-means]
                      @degree-vanishes-if-above-n |
                        less_than(n, degree(p)) -> coeff(p, degree(p)) = zeroR
                        [using specialize above-n-everything-vanishes(degree(p))]
                      @degree-not-above-n |
                        not less_than(n, degree(p))
                        [using tautology degree-vanishes-if-above-n degree-coefficient-nonzero]

                      // symmetrically, the degree bounds everything, so n cannot exceed it.
                      @degree-bounds-the-coefficients |
                        degreeAtMost(p, degree(p))
                        [using specialize degreeBoundsTheCoefficients(p) p-nonzero]
                      @what-degree-bounding-means |
                        degreeAtMost(p, degree(p)) iff
                          (forall i: Nat; less_than(degree(p), i) -> coeff(p, i) = zeroR)
                        [using specialize degreeAtMostMeaning(p, degree(p))]
                      @above-the-degree-everything-vanishes |
                        forall i: Nat; less_than(degree(p), i) -> coeff(p, i) = zeroR
                        [using tautology degree-bounds-the-coefficients what-degree-bounding-means]
                      @n-vanishes-if-above-the-degree |
                        less_than(degree(p), n) -> coeff(p, n) = zeroR
                        [using specialize above-the-degree-everything-vanishes(n)]
                      @n-not-above-the-degree |
                        not less_than(degree(p), n)
                        [using tautology n-vanishes-if-above-the-degree coefficient-at-n-nonzero]

                      // neither exceeds the other, so by trichotomy they are equal.
                      @trichotomy-at-n-and-the-degree |
                        less_than(n, degree(p)) or n = degree(p) or less_than(degree(p), n)
                        [using specialize peano_order.trichotomy(n, degree(p))]
                      @conclusion-the-degree-is-n |
                        n = degree(p)
                        [using tautology trichotomy-at-n-and-the-degree degree-not-above-n n-not-above-the-degree]
                    }
                  @bounding-implies-the-degree |
                    degreeAtMost(p, n) -> n = degree(p)
                    [by discharge given-n-bounds]
                }
              @nonzero-coefficient-implies-the-degree |
                (not (coeff(p, n) = zeroR)) -> degreeAtMost(p, n) -> n = degree(p)
                [by discharge given-coefficient-nonzero]
            }
          @p-nonzero-implies-the-degree |
            (not (p = ZEROP)) -> (not (coeff(p, n) = zeroR)) -> degreeAtMost(p, n) ->
              n = degree(p)
            [by discharge given-p-nonzero]
        }
      @discharge-n |
        forall n: Nat;
          (not (p = ZEROP)) -> (not (coeff(p, n) = zeroR)) -> degreeAtMost(p, n) ->
          n = degree(p)
        [by generalize generalize-n]
    }
  @conclusion |
    forall p: Poly; forall n: Nat;
      (not (p = ZEROP)) -> (not (coeff(p, n) = zeroR)) -> degreeAtMost(p, n) ->
      n = degree(p)
    [by generalize generalize-p]
qed

// == THE REINDEXING LEMMA, and multiplicative commutativity ================================
//
// Judson leaves "R[x] is commutative" as an exercise. It is the one ring axiom for R[x] that
// is not a coefficientwise lift: the two products' coefficients are the SAME multiset of
// ring products, but summed from opposite ends —
//
//     coeff(pq, i) = a_0 b_i + a_1 b_{i-1} + ... + a_i b_0
//     coeff(qp, i) = b_0 a_i + b_1 a_{i-1} + ... + b_i a_0
//
// so relating them is a REINDEXING of the sum by j |-> i - j, not a rewrite of its terms.
//
// Two routes were measured and rejected before this one. Induction on i fails: every term's
// b-index is i - j, so the whole index set SHIFTS and the hypothesis at i says nothing about
// i + 1. Induction on k of "conv(p,q,i,k) = conv(q,p,i,k)" fails because that equation is
// FALSE for k < i — the two partial sums genuinely differ until the range closes.
//
// What works, with i FIXED and the induction on k: conv(q,p,i,k) equals the TOP k+1 terms
// of conv(p,q,i,i). `tailConvolution(p, q, i, k)` names that top segment, recursing by
// PREPENDING at its base, which is the growth direction conv itself cannot do. At k = i the
// segment is the whole sum, and that is commutativity.

// tailConvolution(p, q, i, k) = a_{i-k} b_k + ... + a_{i-1} b_1 + a_i b_0: the last k+1
// terms of coeff(pq, i), grown at the BASE rather than the top.
// REINDEXED alongside `convolution`: the FIRST exponent counts down, the second up, so
//   tailConvolution(p, q, j, m) = a_j b_m + a_{j-1} b_{m+1} + ... (grown at the base)
// Mirror image of `convolution`, and likewise free of `sub`.
// Base at j = ZERO (the first exponent has run down); step peels the top term off a
// positive first exponent. Mirror of `convolution`, which bases at m = ZERO.
func tailConvolution(p: Poly, q: Poly, j: Nat, m: Nat) => R:
  tailConvolution(p, q, ZERO, m) = mulR(coeff(p, ZERO), coeff(q, m));
  tailConvolution(p, q, succ(j), m) =
  addR(mulR(coeff(p, succ(j)), coeff(q, m)),
  tailConvolution(p, q, j, succ(m)))

// HALF ONE: the reversed product's partial sum IS that top segment. Each step pairs one
// term of conv(q,p) with one term of the segment, so the whole proof is R's own
// commutativity applied twice — once to the product, once to the sum.
// The base case: a single term, and R's multiplication commutes.
theorem theFactorSwapBase: forall p, q: Poly; forall j: Nat;
  convolution(q, p, j, ZERO) = tailConvolution(p, q, ZERO, j)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-j |
            fix j: Nat {
              @the-reversed-term |
                convolution(q, p, j, ZERO) = mulR(coeff(q, j), coeff(p, ZERO))
                [using specialize convolutionZero(q, p, j)]
              @the-tail-term |
                tailConvolution(p, q, ZERO, j) =
                  mulR(coeff(p, ZERO), coeff(q, j))
                [using specialize tailConvolutionZero(p, q, j)]
              @the-products-commute |
                mulR(coeff(q, j), coeff(p, ZERO)) =
                  mulR(coeff(p, ZERO), coeff(q, j))
                [using specialize mulIsCommutativeR(coeff(q, j), coeff(p, ZERO))]
              @conclusion-the-base-reverses |
                convolution(q, p, j, ZERO) = tailConvolution(p, q, ZERO, j)
                [using simplify the-reversed-term the-tail-term the-products-commute]
            }
          @discharge-j |
            forall j: Nat;
              convolution(q, p, j, ZERO) = tailConvolution(p, q, ZERO, j)
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: Poly; forall j: Nat;
          convolution(q, p, j, ZERO) = tailConvolution(p, q, ZERO, j)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall j: Nat;
      convolution(q, p, j, ZERO) = tailConvolution(p, q, ZERO, j)
    [by generalize generalize-p]
qed

// The step. conv(q,p,j,succ(m)) peels its FIRST term (at exponents j, succ(m)) and recurses
// at succ(j); tail(p,q,succ(m),j) peels its own first term (at succ(m), j) and recurses at m
// with the complement raised. The two peeled terms are the same product commuted, and the
// hypothesis matches the two tails — fired at succ(j), which is why it is quantified over the
// base index.
theorem theFactorSwapStep: forall p, q: Poly; forall m: Nat;
  (forall j: Nat; convolution(q, p, j, m) = tailConvolution(p, q, m, j)) ->
  (forall j: Nat;
  convolution(q, p, j, succ(m)) = tailConvolution(p, q, succ(m), j))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @given-the-hypothesis |
                assume forall j: Nat;
                  convolution(q, p, j, m) = tailConvolution(p, q, m, j) {
                  @the-hypothesis |
                    forall j: Nat;
                      convolution(q, p, j, m) = tailConvolution(p, q, m, j)
                    [by hypothesis given-the-hypothesis]
                  @generalize-j |
                    fix j: Nat {
                      @the-reversed-step |
                        convolution(q, p, j, succ(m)) =
                          addR(mulR(coeff(q, j), coeff(p, succ(m))),
                          convolution(q, p, succ(j), m))
                        [using specialize convolutionSucc(q, p, j, m)]
                      @the-tail-step |
                        tailConvolution(p, q, succ(m), j) =
                          addR(mulR(coeff(p, succ(m)), coeff(q, j)),
                          tailConvolution(p, q, m, succ(j)))
                        [using specialize tailConvolutionSucc(p, q, m, j)]
                      @the-peeled-terms-commute |
                        mulR(coeff(q, j), coeff(p, succ(m))) =
                          mulR(coeff(p, succ(m)), coeff(q, j))
                        [using specialize mulIsCommutativeR(
                          coeff(q, j), coeff(p, succ(m)))]
                      @the-tails-agree |
                        convolution(q, p, succ(j), m) =
                          tailConvolution(p, q, m, succ(j))
                        [by apply_at(succ(j)) the-hypothesis]
                      @conclusion-the-step-reverses |
                        convolution(q, p, j, succ(m)) =
                          tailConvolution(p, q, succ(m), j)
                        [using simplify the-reversed-step the-tail-step
                          the-peeled-terms-commute the-tails-agree]
                    }
                  @all-base-indices |
                    forall j: Nat;
                      convolution(q, p, j, succ(m)) =
                      tailConvolution(p, q, succ(m), j)
                    [by generalize generalize-j]
                }
              @the-hypothesis-gives-it |
                (forall j: Nat;
                  convolution(q, p, j, m) = tailConvolution(p, q, m, j)) ->
                  (forall j: Nat;
                  convolution(q, p, j, succ(m)) =
                  tailConvolution(p, q, succ(m), j))
                [by discharge given-the-hypothesis]
            }
          @discharge-m |
            forall m: Nat;
              (forall j: Nat;
              convolution(q, p, j, m) = tailConvolution(p, q, m, j)) ->
              (forall j: Nat;
              convolution(q, p, j, succ(m)) =
              tailConvolution(p, q, succ(m), j))
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m: Nat;
          (forall j: Nat;
          convolution(q, p, j, m) = tailConvolution(p, q, m, j)) ->
          (forall j: Nat;
          convolution(q, p, j, succ(m)) = tailConvolution(p, q, succ(m), j))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m: Nat;
      (forall j: Nat;
      convolution(q, p, j, m) = tailConvolution(p, q, m, j)) ->
      (forall j: Nat;
      convolution(q, p, j, succ(m)) = tailConvolution(p, q, succ(m), j))
    [by generalize generalize-p]
qed

// Reading the convolution with its factors swapped is the tail convolution with its indices
// swapped: both enumerate the same pairs of exponents, one walking up and the other down.
// Under the reindex this is an index permutation rather than a subtraction identity.
theorem reversedConvolutionIsTheTailSegment: forall p, q: Poly; forall m, j: Nat;
  convolution(q, p, j, m) = tailConvolution(p, q, m, j)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @base-case |
            forall j: Nat;
              convolution(q, p, j, ZERO) = tailConvolution(p, q, ZERO, j)
            [using specialize theFactorSwapBase(p, q)]
          @induction-step-for-all-m |
            forall m: Nat;
              (forall j: Nat;
              convolution(q, p, j, m) = tailConvolution(p, q, m, j)) ->
              (forall j: Nat;
              convolution(q, p, j, succ(m)) = tailConvolution(p, q, succ(m), j))
            [using specialize theFactorSwapStep(p, q)]
          @all-complements |
            forall m: Nat; forall j: Nat;
              convolution(q, p, j, m) = tailConvolution(p, q, m, j)
            [using instantiation peano.induction((fun z: Nat => forall j: Nat; convolution(q, p, j, z) = tailConvolution(p, q, z, j))) base-case induction-step-for-all-m]
        }
      @discharge-q |
        forall q: Poly; forall m, j: Nat;
          convolution(q, p, j, m) = tailConvolution(p, q, m, j)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, j: Nat;
      convolution(q, p, j, m) = tailConvolution(p, q, m, j)
    [by generalize generalize-p]
qed

// -- HALF TWO: the full tail segment IS the full convolution -------------------------------
//
// `tailConvolution(p,q,i,i)` and `convolution(p,q,i,i)` are the same terms in the same
// ORDER, differing only in how the sum is bracketed — one grown at its base, one at its top.
// They coincide only at k = i (measured: for every k < i the two partial sums differ), so
// this is not an induction on k either. The generalization that IS inductive carries a
// SECOND bound: `segment(p, q, i, m, n)` sums the n+1 terms starting at index m.

// segment(p, q, i, m, n) = a_m b_{i-m} + ... + a_{m+n} b_{i-m-n}, grown at the TOP.
// REINDEXED: `segment(p, q, j, c, n)` is the n+1 terms starting at exponents (j, c) and
// walking j up / c down:
//   a_j b_c + a_{j+1} b_{c-1} + ... + a_{j+n} b_{c-n}
// Based at (ZERO, i) it is the convolution; `sub` appears nowhere.
// Grows at the TOP, with the first exponent DECREMENTED STRUCTURALLY (as a `succ` pattern)
// and the second incremented — the same walk `tailConvolution` makes, but capped at n+1
// terms. That shape is what the sum-reversal proof needs, and it keeps `sub` out: a
// decrementing index must appear as a `succ` pattern, never as a subtraction.
func segment(p: Poly, q: Poly, j: Nat, c: Nat, n: Nat) => R:
  segment(p, q, j, c, ZERO) = mulR(coeff(p, j), coeff(q, c));
  segment(p, q, succ(j), c, succ(n)) =
  addR(mulR(coeff(p, succ(j)), coeff(q, c)),
  segment(p, q, j, succ(c), n))
// -- THE BOTTOM-UP CAPPED RUN ---------------------------------------------------------------
// `rsegment(p, q, j, c, n)` is the mirror of `segment`: n+1 terms starting at exponents
// (j, c) and walking the FIRST exponent up while the second comes down:
//
//   rsegment(p, q, j, c, n) = a_j b_c + a_{j+1} b_{c-1} + ... + a_{j+n} b_{c-n}
//
// It is the convolution's own recursion with a LENGTH CAP, and `convolution(p, q, j, m)` is
// the uncapped case `rsegment(p, q, j, m, m)`. The cap is what makes it a genuinely new
// function: a run of n+1 terms whose exponent sums exceed n cannot be written as a
// convolution, and the sum-reversal argument needs exactly that.
//
// The second exponent is decremented as a `succ` PATTERN, so no `sub` appears.
func rsegment(p: Poly, q: Poly, j: Nat, c: Nat, n: Nat) => R:
  rsegment(p, q, j, c, ZERO) = mulR(coeff(p, j), coeff(q, c));
  rsegment(p, q, j, succ(c), succ(n)) =
  addR(mulR(coeff(p, j), coeff(q, succ(c))),
  rsegment(p, q, succ(j), c, n))

// A tail convolution IS a segment of its own full length: both peel the top term with the
// first exponent decremented structurally and the second incremented. Same recursion, so the
// induction is a term-by-term match on `j`.
theorem aTailIsAFullSegment: forall p, q: Poly; forall j, m: Nat;
  tailConvolution(p, q, j, m) = segment(p, q, j, m, j)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @base-case |
            forall m: Nat;
              tailConvolution(p, q, ZERO, m) = segment(p, q, ZERO, m, ZERO)
            [using specialize theTailSegmentBase(p, q)]
          @induction-step-for-all-j |
            forall j: Nat;
              (forall m: Nat;
              tailConvolution(p, q, j, m) = segment(p, q, j, m, j)) ->
              (forall m: Nat;
              tailConvolution(p, q, succ(j), m) = segment(p, q, succ(j), m, succ(j)))
            [using specialize theTailSegmentStep(p, q)]
          @all-first-exponents |
            forall j: Nat; forall m: Nat;
              tailConvolution(p, q, j, m) = segment(p, q, j, m, j)
            [using instantiation peano.induction((fun z: Nat => forall m: Nat; tailConvolution(p, q, z, m) = segment(p, q, z, m, z))) base-case induction-step-for-all-j]
        }
      @discharge-q |
        forall q: Poly; forall j, m: Nat;
          tailConvolution(p, q, j, m) = segment(p, q, j, m, j)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall j, m: Nat;
      tailConvolution(p, q, j, m) = segment(p, q, j, m, j)
    [by generalize generalize-p]
qed

// The base: a single term on each side.
theorem theTailSegmentBase: forall p, q: Poly; forall m: Nat;
  tailConvolution(p, q, ZERO, m) = segment(p, q, ZERO, m, ZERO)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @the-tail-term |
                tailConvolution(p, q, ZERO, m) =
                  mulR(coeff(p, ZERO), coeff(q, m))
                [using specialize tailConvolutionZero(p, q, m)]
              @the-segment-term |
                segment(p, q, ZERO, m, ZERO) = mulR(coeff(p, ZERO), coeff(q, m))
                [using specialize segmentZero(p, q, ZERO, m)]
              @conclusion-they-agree |
                tailConvolution(p, q, ZERO, m) = segment(p, q, ZERO, m, ZERO)
                [using simplify the-tail-term the-segment-term]
            }
          @discharge-m |
            forall m: Nat;
              tailConvolution(p, q, ZERO, m) = segment(p, q, ZERO, m, ZERO)
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m: Nat;
          tailConvolution(p, q, ZERO, m) = segment(p, q, ZERO, m, ZERO)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m: Nat;
      tailConvolution(p, q, ZERO, m) = segment(p, q, ZERO, m, ZERO)
    [by generalize generalize-p]
qed

// The step: both peel a_{succ j} b_m and recurse at (j, succ m). Term-by-term.
theorem theTailSegmentStep: forall p, q: Poly; forall j: Nat;
  (forall m: Nat; tailConvolution(p, q, j, m) = segment(p, q, j, m, j)) ->
  (forall m: Nat;
  tailConvolution(p, q, succ(j), m) = segment(p, q, succ(j), m, succ(j)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-j |
            fix j: Nat {
              @given-the-hypothesis |
                assume forall m: Nat;
                  tailConvolution(p, q, j, m) = segment(p, q, j, m, j) {
                  @the-hypothesis |
                    forall m: Nat;
                      tailConvolution(p, q, j, m) = segment(p, q, j, m, j)
                    [by hypothesis given-the-hypothesis]
                  @generalize-m |
                    fix m: Nat {
                      @the-tail-step |
                        tailConvolution(p, q, succ(j), m) =
                          addR(mulR(coeff(p, succ(j)), coeff(q, m)),
                          tailConvolution(p, q, j, succ(m)))
                        [using specialize tailConvolutionSucc(p, q, j, m)]
                      @the-segment-step |
                        segment(p, q, succ(j), m, succ(j)) =
                          addR(mulR(coeff(p, succ(j)), coeff(q, m)),
                          segment(p, q, j, succ(m), j))
                        [using specialize segmentSucc(p, q, j, m, j)]
                      @the-tails-agree |
                        tailConvolution(p, q, j, succ(m)) =
                          segment(p, q, j, succ(m), j)
                        [by apply_at(succ(m)) the-hypothesis]
                      @conclusion-the-step-agrees |
                        tailConvolution(p, q, succ(j), m) =
                          segment(p, q, succ(j), m, succ(j))
                        [using simplify the-tail-step the-tails-agree
                          the-segment-step]
                    }
                  @all-complements |
                    forall m: Nat;
                      tailConvolution(p, q, succ(j), m) =
                      segment(p, q, succ(j), m, succ(j))
                    [by generalize generalize-m]
                }
              @the-hypothesis-gives-it |
                (forall m: Nat;
                  tailConvolution(p, q, j, m) = segment(p, q, j, m, j)) ->
                  (forall m: Nat;
                  tailConvolution(p, q, succ(j), m) =
                  segment(p, q, succ(j), m, succ(j)))
                [by discharge given-the-hypothesis]
            }
          @discharge-j |
            forall j: Nat;
              (forall m: Nat;
              tailConvolution(p, q, j, m) = segment(p, q, j, m, j)) ->
              (forall m: Nat;
              tailConvolution(p, q, succ(j), m) =
              segment(p, q, succ(j), m, succ(j)))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: Poly; forall j: Nat;
          (forall m: Nat;
          tailConvolution(p, q, j, m) = segment(p, q, j, m, j)) ->
          (forall m: Nat;
          tailConvolution(p, q, succ(j), m) =
          segment(p, q, succ(j), m, succ(j)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall j: Nat;
      (forall m: Nat; tailConvolution(p, q, j, m) = segment(p, q, j, m, j)) ->
      (forall m: Nat;
      tailConvolution(p, q, succ(j), m) = segment(p, q, succ(j), m, succ(j)))
    [by generalize generalize-p]
qed
// The base of `rsegmentPeelsAtTheTop`: a two-term run, read from either end.
theorem theTopPeelBase: forall p, q: Poly; forall j, c: Nat;
  rsegment(p, q, j, addN(c, succ(ZERO)), succ(ZERO)) =
  addR(rsegment(p, q, j, addN(c, succ(ZERO)), ZERO),
  mulR(coeff(p, addN(j, succ(ZERO))), coeff(q, c)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-j |
            fix j: Nat {
              @generalize-c |
                fix c: Nat {
                  @the-complement-raises |
                    addN(c, succ(ZERO)) = succ(addN(c, ZERO))
                    [using specialize peano.addSuccRight(c, ZERO)]
                  @the-complement-collapses |
                    addN(c, ZERO) = c
                    [using specialize peano.addZeroRight(c)]
                  @the-complement-is-a-successor |
                    addN(c, succ(ZERO)) = succ(c)
                    [using simplify the-complement-raises the-complement-collapses]
                  @the-run-peels-at-the-bottom |
                    rsegment(p, q, j, succ(c), succ(ZERO)) =
                      addR(mulR(coeff(p, j), coeff(q, succ(c))),
                      rsegment(p, q, succ(j), c, ZERO))
                    [using specialize rsegmentSucc(p, q, j, c, ZERO)]
                  @the-inner-term |
                    rsegment(p, q, succ(j), c, ZERO) =
                      mulR(coeff(p, succ(j)), coeff(q, c))
                    [using specialize rsegmentZero(p, q, succ(j), c)]
                  @the-single-term |
                    rsegment(p, q, j, succ(c), ZERO) =
                      mulR(coeff(p, j), coeff(q, succ(c)))
                    [using specialize rsegmentZero(p, q, j, succ(c))]
                  @the-top-index-raises |
                    addN(j, succ(ZERO)) = succ(addN(j, ZERO))
                    [using specialize peano.addSuccRight(j, ZERO)]
                  @the-top-index-collapses |
                    addN(j, ZERO) = j
                    [using specialize peano.addZeroRight(j)]
                  @the-top-index |
                    addN(j, succ(ZERO)) = succ(j)
                    [using simplify the-top-index-raises the-top-index-collapses]
                  @the-peeled-pair |
                    rsegment(p, q, j, succ(c), succ(ZERO)) =
                      addR(rsegment(p, q, j, succ(c), ZERO),
                      mulR(coeff(p, succ(j)), coeff(q, c)))
                    [using simplify the-run-peels-at-the-bottom the-inner-term
                      the-single-term]
                  @conclusion-the-base-peels |
                    rsegment(p, q, j, addN(c, succ(ZERO)), succ(ZERO)) =
                      addR(rsegment(p, q, j, addN(c, succ(ZERO)), ZERO),
                      mulR(coeff(p, addN(j, succ(ZERO))), coeff(q, c)))
                    [using simplify the-complement-is-a-successor the-top-index
                      the-peeled-pair]
                }
              @discharge-c |
                forall c: Nat;
                  rsegment(p, q, j, addN(c, succ(ZERO)), succ(ZERO)) =
                  addR(rsegment(p, q, j, addN(c, succ(ZERO)), ZERO),
                  mulR(coeff(p, addN(j, succ(ZERO))), coeff(q, c)))
                [by generalize generalize-c]
            }
          @discharge-j |
            forall j, c: Nat;
              rsegment(p, q, j, addN(c, succ(ZERO)), succ(ZERO)) =
              addR(rsegment(p, q, j, addN(c, succ(ZERO)), ZERO),
              mulR(coeff(p, addN(j, succ(ZERO))), coeff(q, c)))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: Poly; forall j, c: Nat;
          rsegment(p, q, j, addN(c, succ(ZERO)), succ(ZERO)) =
          addR(rsegment(p, q, j, addN(c, succ(ZERO)), ZERO),
          mulR(coeff(p, addN(j, succ(ZERO))), coeff(q, c)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall j, c: Nat;
      rsegment(p, q, j, addN(c, succ(ZERO)), succ(ZERO)) =
      addR(rsegment(p, q, j, addN(c, succ(ZERO)), ZERO),
      mulR(coeff(p, addN(j, succ(ZERO))), coeff(q, c)))
    [by generalize generalize-p]
qed

// The step of `rsegmentPeelsAtTheTop`: peel the bottom term off both sides, then the
// hypothesis matches the two shortened runs — fired at `succ(j)`, so it is quantified over
// the base index.
theorem theTopPeelStep: forall p, q: Poly; forall n: Nat;
  (forall j, c: Nat;
  rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
  addR(rsegment(p, q, j, addN(c, succ(n)), n),
  mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))) ->
  (forall j, c: Nat;
  rsegment(p, q, j, addN(c, succ(succ(n))), succ(succ(n))) =
  addR(rsegment(p, q, j, addN(c, succ(succ(n))), succ(n)),
  mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c))))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-n |
            fix n: Nat {
              @given-the-hypothesis |
                assume forall j, c: Nat;
                  rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
                  addR(rsegment(p, q, j, addN(c, succ(n)), n),
                  mulR(coeff(p, addN(j, succ(n))), coeff(q, c))) {
                  @the-hypothesis |
                    forall j, c: Nat;
                      rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
                      addR(rsegment(p, q, j, addN(c, succ(n)), n),
                      mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))
                    [by hypothesis given-the-hypothesis]
                  @generalize-j |
                    fix j: Nat {
                      @generalize-c |
                        fix c: Nat {
                          // the complement is a successor: c + succ(succ n) = succ(c + succ n)
                          @the-complement-raises |
                            addN(c, succ(succ(n))) = succ(addN(c, succ(n)))
                            [using specialize peano.addSuccRight(c, succ(n))]
                          // both sides peel their bottom term a_j b_{complement}
                          @the-long-run-peels |
                            rsegment(p, q, j, succ(addN(c, succ(n))), succ(succ(n))) =
                              addR(mulR(coeff(p, j), coeff(q, succ(addN(c, succ(n))))),
                              rsegment(p, q, succ(j), addN(c, succ(n)), succ(n)))
                            [using specialize rsegmentSucc(
                              p, q, j, addN(c, succ(n)), succ(n))]
                          @the-short-run-peels |
                            rsegment(p, q, j, succ(addN(c, succ(n))), succ(n)) =
                              addR(mulR(coeff(p, j), coeff(q, succ(addN(c, succ(n))))),
                              rsegment(p, q, succ(j), addN(c, succ(n)), n))
                            [using specialize rsegmentSucc(
                              p, q, j, addN(c, succ(n)), n)]
                          // the hypothesis at succ(j) relates the two shortened runs
                          @the-tails-relate |
                            rsegment(p, q, succ(j), addN(c, succ(n)), succ(n)) =
                              addR(rsegment(p, q, succ(j), addN(c, succ(n)), n),
                              mulR(coeff(p, addN(succ(j), succ(n))), coeff(q, c)))
                            [by apply_at(succ(j), c) the-hypothesis]
                          // the top index agrees: succ(j) + succ(n) = j + succ(succ n)
                          @the-top-index-on-the-left |
                            addN(succ(j), succ(n)) = succ(addN(j, succ(n)))
                            [using specialize peano.addSuccLeft(j, succ(n))]
                          @the-top-index-on-the-right |
                            addN(j, succ(succ(n))) = succ(addN(j, succ(n)))
                            [using specialize peano.addSuccRight(j, succ(n))]
                          @the-top-indices-agree |
                            addN(succ(j), succ(n)) = addN(j, succ(succ(n)))
                            [using chain the-top-index-on-the-left
                              the-top-index-on-the-right-flipped]
                          @the-top-index-on-the-right-flipped |
                            succ(addN(j, succ(n))) = addN(j, succ(succ(n)))
                            [by symmetry the-top-index-on-the-right]
                          // assemble: peel, substitute the tail, regroup
                          @the-long-run-expanded |
                            rsegment(p, q, j, succ(addN(c, succ(n))), succ(succ(n))) =
                              addR(mulR(coeff(p, j), coeff(q, succ(addN(c, succ(n))))),
                              addR(rsegment(p, q, succ(j), addN(c, succ(n)), n),
                              mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c))))
                            [using simplify the-long-run-peels the-tails-relate
                              the-top-indices-agree]
                          @the-regrouping |
                            addR(mulR(coeff(p, j), coeff(q, succ(addN(c, succ(n))))),
                              addR(rsegment(p, q, succ(j), addN(c, succ(n)), n),
                              mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c)))) =
                              addR(addR(
                              mulR(coeff(p, j), coeff(q, succ(addN(c, succ(n))))),
                              rsegment(p, q, succ(j), addN(c, succ(n)), n)),
                              mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c)))
                            [by symmetry the-association]
                          @the-association |
                            addR(addR(
                              mulR(coeff(p, j), coeff(q, succ(addN(c, succ(n))))),
                              rsegment(p, q, succ(j), addN(c, succ(n)), n)),
                              mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c))) =
                              addR(mulR(coeff(p, j),
                              coeff(q, succ(addN(c, succ(n))))),
                              addR(rsegment(p, q, succ(j), addN(c, succ(n)), n),
                              mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c))))
                            [using specialize addIsAssociativeR(
                              mulR(coeff(p, j), coeff(q, succ(addN(c, succ(n))))),
                              rsegment(p, q, succ(j), addN(c, succ(n)), n),
                              mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c)))]
                          @the-long-run-regrouped |
                            rsegment(p, q, j, succ(addN(c, succ(n))), succ(succ(n))) =
                              addR(rsegment(p, q, j, succ(addN(c, succ(n))), succ(n)),
                              mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c)))
                            [using simplify the-long-run-expanded the-regrouping
                              the-short-run-peels]
                          @conclusion-the-step-peels |
                            rsegment(p, q, j, addN(c, succ(succ(n))), succ(succ(n))) =
                              addR(rsegment(p, q, j, addN(c, succ(succ(n))), succ(n)),
                              mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c)))
                            [using simplify the-complement-raises
                              the-long-run-regrouped]
                        }
                      @discharge-c |
                        forall c: Nat;
                          rsegment(p, q, j, addN(c, succ(succ(n))), succ(succ(n))) =
                          addR(rsegment(p, q, j, addN(c, succ(succ(n))), succ(n)),
                          mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c)))
                        [by generalize generalize-c]
                    }
                  @all-indices |
                    forall j, c: Nat;
                      rsegment(p, q, j, addN(c, succ(succ(n))), succ(succ(n))) =
                      addR(rsegment(p, q, j, addN(c, succ(succ(n))), succ(n)),
                      mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c)))
                    [by generalize generalize-j]
                }
              @the-hypothesis-gives-it |
                (forall j, c: Nat;
                  rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
                  addR(rsegment(p, q, j, addN(c, succ(n)), n),
                  mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))) ->
                  (forall j, c: Nat;
                  rsegment(p, q, j, addN(c, succ(succ(n))), succ(succ(n))) =
                  addR(rsegment(p, q, j, addN(c, succ(succ(n))), succ(n)),
                  mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c))))
                [by discharge given-the-hypothesis]
            }
          @discharge-n |
            forall n: Nat;
              (forall j, c: Nat;
              rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
              addR(rsegment(p, q, j, addN(c, succ(n)), n),
              mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))) ->
              (forall j, c: Nat;
              rsegment(p, q, j, addN(c, succ(succ(n))), succ(succ(n))) =
              addR(rsegment(p, q, j, addN(c, succ(succ(n))), succ(n)),
              mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c))))
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q: Poly; forall n: Nat;
          (forall j, c: Nat;
          rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
          addR(rsegment(p, q, j, addN(c, succ(n)), n),
          mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))) ->
          (forall j, c: Nat;
          rsegment(p, q, j, addN(c, succ(succ(n))), succ(succ(n))) =
          addR(rsegment(p, q, j, addN(c, succ(succ(n))), succ(n)),
          mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall n: Nat;
      (forall j, c: Nat;
      rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
      addR(rsegment(p, q, j, addN(c, succ(n)), n),
      mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))) ->
      (forall j, c: Nat;
      rsegment(p, q, j, addN(c, succ(succ(n))), succ(succ(n))) =
      addR(rsegment(p, q, j, addN(c, succ(succ(n))), succ(n)),
      mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c))))
    [by generalize generalize-p]
qed

// `rsegment` can also be peeled at its TOP — the far end of the run. The axiom peels the
// bottom, so this is the snoc direction, and it is what makes the sum reversal a term-by-term
// induction instead of an n-way reassociation.
//
// Stated with the complement SPLIT as `addN(c, succ(n))` so the top term's second exponent is
// `c` rather than a computed difference.
theorem rsegmentPeelsAtTheTop: forall p, q: Poly; forall n, j, c: Nat;
  rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
  addR(rsegment(p, q, j, addN(c, succ(n)), n),
  mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @base-case |
            forall j, c: Nat;
              rsegment(p, q, j, addN(c, succ(ZERO)), succ(ZERO)) =
              addR(rsegment(p, q, j, addN(c, succ(ZERO)), ZERO),
              mulR(coeff(p, addN(j, succ(ZERO))), coeff(q, c)))
            [using specialize theTopPeelBase(p, q)]
          @induction-step-for-all-n |
            forall n: Nat;
              (forall j, c: Nat;
              rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
              addR(rsegment(p, q, j, addN(c, succ(n)), n),
              mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))) ->
              (forall j, c: Nat;
              rsegment(p, q, j, addN(c, succ(succ(n))), succ(succ(n))) =
              addR(rsegment(p, q, j, addN(c, succ(succ(n))), succ(n)),
              mulR(coeff(p, addN(j, succ(succ(n)))), coeff(q, c))))
            [using specialize theTopPeelStep(p, q)]
          @all-lengths |
            forall n: Nat; forall j, c: Nat;
              rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
              addR(rsegment(p, q, j, addN(c, succ(n)), n),
              mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))
            [using instantiation peano.induction((fun z: Nat => forall j, c: Nat; rsegment(p, q, j, addN(c, succ(z)), succ(z)) = addR(rsegment(p, q, j, addN(c, succ(z)), z), mulR(coeff(p, addN(j, succ(z))), coeff(q, c))))) base-case induction-step-for-all-n]
        }
      @discharge-q |
        forall q: Poly; forall n, j, c: Nat;
          rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
          addR(rsegment(p, q, j, addN(c, succ(n)), n),
          mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall n, j, c: Nat;
      rsegment(p, q, j, addN(c, succ(n)), succ(n)) =
      addR(rsegment(p, q, j, addN(c, succ(n)), n),
      mulR(coeff(p, addN(j, succ(n))), coeff(q, c)))
    [by generalize generalize-p]
qed
// An uncapped bottom-up run IS the convolution: identical recursions, term by term.
theorem anUncappedRunIsTheConvolution: forall p, q: Poly; forall m, j: Nat;
  rsegment(p, q, j, m, m) = convolution(p, q, j, m)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @base-case |
            forall j: Nat; rsegment(p, q, j, ZERO, ZERO) = convolution(p, q, j, ZERO)
            [using specialize theUncappedBase(p, q)]
          @induction-step-for-all-m |
            forall m: Nat;
              (forall j: Nat; rsegment(p, q, j, m, m) = convolution(p, q, j, m)) ->
              (forall j: Nat;
              rsegment(p, q, j, succ(m), succ(m)) = convolution(p, q, j, succ(m)))
            [using specialize theUncappedStep(p, q)]
          @all-complements |
            forall m: Nat; forall j: Nat;
              rsegment(p, q, j, m, m) = convolution(p, q, j, m)
            [using instantiation peano.induction((fun z: Nat => forall j: Nat; rsegment(p, q, j, z, z) = convolution(p, q, j, z))) base-case induction-step-for-all-m]
        }
      @discharge-q |
        forall q: Poly; forall m, j: Nat;
          rsegment(p, q, j, m, m) = convolution(p, q, j, m)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, j: Nat;
      rsegment(p, q, j, m, m) = convolution(p, q, j, m)
    [by generalize generalize-p]
qed

theorem theUncappedBase: forall p, q: Poly; forall j: Nat;
  rsegment(p, q, j, ZERO, ZERO) = convolution(p, q, j, ZERO)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-j |
            fix j: Nat {
              @the-run-term |
                rsegment(p, q, j, ZERO, ZERO) = mulR(coeff(p, j), coeff(q, ZERO))
                [using specialize rsegmentZero(p, q, j, ZERO)]
              @the-convolution-term |
                convolution(p, q, j, ZERO) = mulR(coeff(p, j), coeff(q, ZERO))
                [using specialize convolutionZero(p, q, j)]
              @conclusion-they-agree |
                rsegment(p, q, j, ZERO, ZERO) = convolution(p, q, j, ZERO)
                [using simplify the-run-term the-convolution-term]
            }
          @discharge-j |
            forall j: Nat;
              rsegment(p, q, j, ZERO, ZERO) = convolution(p, q, j, ZERO)
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: Poly; forall j: Nat;
          rsegment(p, q, j, ZERO, ZERO) = convolution(p, q, j, ZERO)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall j: Nat;
      rsegment(p, q, j, ZERO, ZERO) = convolution(p, q, j, ZERO)
    [by generalize generalize-p]
qed

theorem theUncappedStep: forall p, q: Poly; forall m: Nat;
  (forall j: Nat; rsegment(p, q, j, m, m) = convolution(p, q, j, m)) ->
  (forall j: Nat;
  rsegment(p, q, j, succ(m), succ(m)) = convolution(p, q, j, succ(m)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @given-the-hypothesis |
                assume forall j: Nat;
                  rsegment(p, q, j, m, m) = convolution(p, q, j, m) {
                  @the-hypothesis |
                    forall j: Nat; rsegment(p, q, j, m, m) = convolution(p, q, j, m)
                    [by hypothesis given-the-hypothesis]
                  @generalize-j |
                    fix j: Nat {
                      @the-run-step |
                        rsegment(p, q, j, succ(m), succ(m)) =
                          addR(mulR(coeff(p, j), coeff(q, succ(m))),
                          rsegment(p, q, succ(j), m, m))
                        [using specialize rsegmentSucc(p, q, j, m, m)]
                      @the-convolution-step |
                        convolution(p, q, j, succ(m)) =
                          addR(mulR(coeff(p, j), coeff(q, succ(m))),
                          convolution(p, q, succ(j), m))
                        [using specialize convolutionSucc(p, q, j, m)]
                      @the-tails-agree |
                        rsegment(p, q, succ(j), m, m) = convolution(p, q, succ(j), m)
                        [by apply_at(succ(j)) the-hypothesis]
                      @conclusion-the-step-agrees |
                        rsegment(p, q, j, succ(m), succ(m)) =
                          convolution(p, q, j, succ(m))
                        [using simplify the-run-step the-tails-agree
                          the-convolution-step]
                    }
                  @all-base-indices |
                    forall j: Nat;
                      rsegment(p, q, j, succ(m), succ(m)) =
                      convolution(p, q, j, succ(m))
                    [by generalize generalize-j]
                }
              @the-hypothesis-gives-it |
                (forall j: Nat; rsegment(p, q, j, m, m) = convolution(p, q, j, m)) ->
                  (forall j: Nat;
                  rsegment(p, q, j, succ(m), succ(m)) =
                  convolution(p, q, j, succ(m)))
                [by discharge given-the-hypothesis]
            }
          @discharge-m |
            forall m: Nat;
              (forall j: Nat; rsegment(p, q, j, m, m) = convolution(p, q, j, m)) ->
              (forall j: Nat;
              rsegment(p, q, j, succ(m), succ(m)) = convolution(p, q, j, succ(m)))
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m: Nat;
          (forall j: Nat; rsegment(p, q, j, m, m) = convolution(p, q, j, m)) ->
          (forall j: Nat;
          rsegment(p, q, j, succ(m), succ(m)) = convolution(p, q, j, succ(m)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m: Nat;
      (forall j: Nat; rsegment(p, q, j, m, m) = convolution(p, q, j, m)) ->
      (forall j: Nat;
      rsegment(p, q, j, succ(m), succ(m)) = convolution(p, q, j, succ(m)))
    [by generalize generalize-p]
qed

// The reversal's base: a single term on each side.
theorem theReversalBase: forall p, q: Poly; forall a, c: Nat;
  segment(p, q, addN(a, ZERO), c, ZERO) = rsegment(p, q, a, addN(ZERO, c), ZERO)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-a |
            fix a: Nat {
              @generalize-c |
                fix c: Nat {
                  @the-left-index |
                    addN(a, ZERO) = a
                    [using specialize peano.addZeroRight(a)]
                  @the-right-index |
                    addN(ZERO, c) = c
                    [using specialize peano.addZeroLeft(c)]
                  @the-segment-term |
                    segment(p, q, a, c, ZERO) = mulR(coeff(p, a), coeff(q, c))
                    [using specialize segmentZero(p, q, a, c)]
                  @the-run-term |
                    rsegment(p, q, a, c, ZERO) = mulR(coeff(p, a), coeff(q, c))
                    [using specialize rsegmentZero(p, q, a, c)]
                  @conclusion-the-base-reverses |
                    segment(p, q, addN(a, ZERO), c, ZERO) =
                      rsegment(p, q, a, addN(ZERO, c), ZERO)
                    [using simplify the-left-index the-right-index
                      the-segment-term the-run-term]
                }
              @discharge-c |
                forall c: Nat;
                  segment(p, q, addN(a, ZERO), c, ZERO) =
                  rsegment(p, q, a, addN(ZERO, c), ZERO)
                [by generalize generalize-c]
            }
          @discharge-a |
            forall a, c: Nat;
              segment(p, q, addN(a, ZERO), c, ZERO) =
              rsegment(p, q, a, addN(ZERO, c), ZERO)
            [by generalize generalize-a]
        }
      @discharge-q |
        forall q: Poly; forall a, c: Nat;
          segment(p, q, addN(a, ZERO), c, ZERO) =
          rsegment(p, q, a, addN(ZERO, c), ZERO)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall a, c: Nat;
      segment(p, q, addN(a, ZERO), c, ZERO) =
      rsegment(p, q, a, addN(ZERO, c), ZERO)
    [by generalize generalize-p]
qed

// The reversal's step. The segment peels its TOP term (exponents a+succ(n), c) off the
// bottom of its sum; `rsegmentPeelsAtTheTop` peels the SAME term off the top of the run's
// sum. One commutation joins them, and the hypothesis at (a, succ c) matches the tails.
theorem theReversalStep: forall p, q: Poly; forall n: Nat;
  (forall a, c: Nat;
  segment(p, q, addN(a, n), c, n) = rsegment(p, q, a, addN(n, c), n)) ->
  (forall a, c: Nat;
  segment(p, q, addN(a, succ(n)), c, succ(n)) =
  rsegment(p, q, a, addN(succ(n), c), succ(n)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-n |
            fix n: Nat {
              @given-the-hypothesis |
                assume forall a, c: Nat;
                  segment(p, q, addN(a, n), c, n) =
                  rsegment(p, q, a, addN(n, c), n) {
                  @the-hypothesis |
                    forall a, c: Nat;
                      segment(p, q, addN(a, n), c, n) =
                      rsegment(p, q, a, addN(n, c), n)
                    [by hypothesis given-the-hypothesis]
                  @generalize-a |
                    fix a: Nat {
                      @generalize-c |
                        fix c: Nat {
                          // the segment's first index is a successor
                          @the-first-index-raises |
                            addN(a, succ(n)) = succ(addN(a, n))
                            [using specialize peano.addSuccRight(a, n)]
                          @the-segment-peels |
                            segment(p, q, succ(addN(a, n)), c, succ(n)) =
                              addR(mulR(coeff(p, succ(addN(a, n))), coeff(q, c)),
                              segment(p, q, addN(a, n), succ(c), n))
                            [using specialize segmentSucc(p, q, addN(a, n), c, n)]
                          // the hypothesis at (a, succ c) handles the tail
                          @the-tail-reverses |
                            segment(p, q, addN(a, n), succ(c), n) =
                              rsegment(p, q, a, addN(n, succ(c)), n)
                            [by apply_at(a, succ(c)) the-hypothesis]
                          // the two complements agree: n + succ c = succ n + c
                          @the-complement-on-the-left |
                            addN(n, succ(c)) = succ(addN(n, c))
                            [using specialize peano.addSuccRight(n, c)]
                          @the-complement-on-the-right |
                            addN(succ(n), c) = succ(addN(n, c))
                            [using specialize peano.addSuccLeft(n, c)]
                          @the-complements-agree |
                            addN(n, succ(c)) = addN(succ(n), c)
                            [using chain the-complement-on-the-left
                              the-complement-on-the-right-flipped]
                          @the-complement-on-the-right-flipped |
                            succ(addN(n, c)) = addN(succ(n), c)
                            [by symmetry the-complement-on-the-right]
                          // the run peels its TOP, which is the same term
                          @the-run-peels-at-the-top |
                            rsegment(p, q, a, addN(c, succ(n)), succ(n)) =
                              addR(rsegment(p, q, a, addN(c, succ(n)), n),
                              mulR(coeff(p, addN(a, succ(n))), coeff(q, c)))
                            [using specialize rsegmentPeelsAtTheTop(p, q, n, a, c)]
                          // and its complement is the same one, commuted
                          @the-run-complement-commutes |
                            addN(c, succ(n)) = addN(succ(n), c)
                            [using specialize peano.addIsCommutative(c, succ(n))]
                          @the-segment-in-run-terms |
                            segment(p, q, addN(a, succ(n)), c, succ(n)) =
                              addR(mulR(coeff(p, addN(a, succ(n))), coeff(q, c)),
                              rsegment(p, q, a, addN(succ(n), c), n))
                            [using simplify the-first-index-raises the-segment-peels
                              the-tail-reverses the-complements-agree]
                          @the-run-in-segment-terms |
                            rsegment(p, q, a, addN(succ(n), c), succ(n)) =
                              addR(rsegment(p, q, a, addN(succ(n), c), n),
                              mulR(coeff(p, addN(a, succ(n))), coeff(q, c)))
                            [by rewrite the-run-complement-commutes
                              the-run-peels-at-the-top]
                          @the-summands-commute |
                            addR(mulR(coeff(p, addN(a, succ(n))), coeff(q, c)),
                              rsegment(p, q, a, addN(succ(n), c), n)) =
                              addR(rsegment(p, q, a, addN(succ(n), c), n),
                              mulR(coeff(p, addN(a, succ(n))), coeff(q, c)))
                            [using specialize addIsCommutativeR(
                              mulR(coeff(p, addN(a, succ(n))), coeff(q, c)),
                              rsegment(p, q, a, addN(succ(n), c), n))]
                          @conclusion-the-step-reverses |
                            segment(p, q, addN(a, succ(n)), c, succ(n)) =
                              rsegment(p, q, a, addN(succ(n), c), succ(n))
                            [using chain the-segment-in-run-terms
                              the-summands-commute the-run-in-segment-terms-flipped]
                          @the-run-in-segment-terms-flipped |
                            addR(rsegment(p, q, a, addN(succ(n), c), n),
                              mulR(coeff(p, addN(a, succ(n))), coeff(q, c))) =
                              rsegment(p, q, a, addN(succ(n), c), succ(n))
                            [by symmetry the-run-in-segment-terms]
                        }
                      @discharge-c |
                        forall c: Nat;
                          segment(p, q, addN(a, succ(n)), c, succ(n)) =
                          rsegment(p, q, a, addN(succ(n), c), succ(n))
                        [by generalize generalize-c]
                    }
                  @all-indices |
                    forall a, c: Nat;
                      segment(p, q, addN(a, succ(n)), c, succ(n)) =
                      rsegment(p, q, a, addN(succ(n), c), succ(n))
                    [by generalize generalize-a]
                }
              @the-hypothesis-gives-it |
                (forall a, c: Nat;
                  segment(p, q, addN(a, n), c, n) =
                  rsegment(p, q, a, addN(n, c), n)) ->
                  (forall a, c: Nat;
                  segment(p, q, addN(a, succ(n)), c, succ(n)) =
                  rsegment(p, q, a, addN(succ(n), c), succ(n)))
                [by discharge given-the-hypothesis]
            }
          @discharge-n |
            forall n: Nat;
              (forall a, c: Nat;
              segment(p, q, addN(a, n), c, n) =
              rsegment(p, q, a, addN(n, c), n)) ->
              (forall a, c: Nat;
              segment(p, q, addN(a, succ(n)), c, succ(n)) =
              rsegment(p, q, a, addN(succ(n), c), succ(n)))
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q: Poly; forall n: Nat;
          (forall a, c: Nat;
          segment(p, q, addN(a, n), c, n) = rsegment(p, q, a, addN(n, c), n)) ->
          (forall a, c: Nat;
          segment(p, q, addN(a, succ(n)), c, succ(n)) =
          rsegment(p, q, a, addN(succ(n), c), succ(n)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall n: Nat;
      (forall a, c: Nat;
      segment(p, q, addN(a, n), c, n) = rsegment(p, q, a, addN(n, c), n)) ->
      (forall a, c: Nat;
      segment(p, q, addN(a, succ(n)), c, succ(n)) =
      rsegment(p, q, a, addN(succ(n), c), succ(n)))
    [by generalize generalize-p]
qed

// THE SUM REVERSAL. A top-down run and a bottom-up run over the same index range are equal:
//
//   segment(p, q, add(a,n), c, n)  = a_{a+n} b_c + ... + a_a b_{c+n}      (top down)
//   rsegment(p, q, a, add(n,c), n) = a_a b_{n+c} + ... + a_{a+n} b_c      (bottom up)
//
// Same terms, opposite order. This is the irreducible content behind commutativity — no
// reindexing removes it — and `rsegmentPeelsAtTheTop` is what makes it term-by-term rather
// than an n-way reassociation: both sides can then peel their TOP term.
theorem aRunReadsTheSameBothWays: forall p, q: Poly; forall n, a, c: Nat;
  segment(p, q, addN(a, n), c, n) = rsegment(p, q, a, addN(n, c), n)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @base-case |
            forall a, c: Nat;
              segment(p, q, addN(a, ZERO), c, ZERO) =
              rsegment(p, q, a, addN(ZERO, c), ZERO)
            [using specialize theReversalBase(p, q)]
          @induction-step-for-all-n |
            forall n: Nat;
              (forall a, c: Nat;
              segment(p, q, addN(a, n), c, n) =
              rsegment(p, q, a, addN(n, c), n)) ->
              (forall a, c: Nat;
              segment(p, q, addN(a, succ(n)), c, succ(n)) =
              rsegment(p, q, a, addN(succ(n), c), succ(n)))
            [using specialize theReversalStep(p, q)]
          @all-lengths |
            forall n: Nat; forall a, c: Nat;
              segment(p, q, addN(a, n), c, n) = rsegment(p, q, a, addN(n, c), n)
            [using instantiation peano.induction((fun z: Nat => forall a, c: Nat; segment(p, q, addN(a, z), c, z) = rsegment(p, q, a, addN(z, c), z))) base-case induction-step-for-all-n]
        }
      @discharge-q |
        forall q: Poly; forall n, a, c: Nat;
          segment(p, q, addN(a, n), c, n) = rsegment(p, q, a, addN(n, c), n)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall n, a, c: Nat;
      segment(p, q, addN(a, n), c, n) = rsegment(p, q, a, addN(n, c), n)
    [by generalize generalize-p]
qed

// Hence a full segment read forwards is the convolution: at a = ZERO, c = ZERO the reversal
// says segment(p,q,i,ZERO,i) = rsegment(p,q,ZERO,i,i), and an uncapped rsegment IS the
// convolution.
theorem aFullSegmentReadsForwards: forall p, q: Poly; forall i: Nat;
  segment(p, q, i, ZERO, i) = convolution(p, q, ZERO, i)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-i |
            fix i: Nat {
              @the-reversal-at-zero |
                segment(p, q, addN(ZERO, i), ZERO, i) =
                  rsegment(p, q, ZERO, addN(i, ZERO), i)
                [using specialize aRunReadsTheSameBothWays(p, q, i, ZERO, ZERO)]
              @the-left-index |
                addN(ZERO, i) = i
                [using specialize peano.addZeroLeft(i)]
              @the-right-index |
                addN(i, ZERO) = i
                [using specialize peano.addZeroRight(i)]
              @the-reversal-with-the-left-index |
                segment(p, q, i, ZERO, i) = rsegment(p, q, ZERO, addN(i, ZERO), i)
                [by rewrite the-left-index the-reversal-at-zero]
              @the-reversal-simplified |
                segment(p, q, i, ZERO, i) = rsegment(p, q, ZERO, i, i)
                [by rewrite the-right-index the-reversal-with-the-left-index]
              @the-uncapped-run-is-the-convolution |
                rsegment(p, q, ZERO, i, i) = convolution(p, q, ZERO, i)
                [using specialize anUncappedRunIsTheConvolution(p, q, i, ZERO)]
              @conclusion-the-segment-reads-forwards |
                segment(p, q, i, ZERO, i) = convolution(p, q, ZERO, i)
                [using chain the-reversal-simplified
                  the-uncapped-run-is-the-convolution]
            }
          @discharge-i |
            forall i: Nat;
              segment(p, q, i, ZERO, i) = convolution(p, q, ZERO, i)
            [by generalize generalize-i]
        }
      @discharge-q |
        forall q: Poly; forall i: Nat;
          segment(p, q, i, ZERO, i) = convolution(p, q, ZERO, i)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall i: Nat;
      segment(p, q, i, ZERO, i) = convolution(p, q, ZERO, i)
    [by generalize generalize-p]
qed

// == THE REINDEXING LEMMA ==================================================================
//
// Assembling the four pieces at k = i, where the segment spans the whole range:
//
//   conv(q,p,i,i) = tail(p,q,i,i)                 [reversedConvolutionIsTheTailSegment]
//                 = segment(p,q,i, i-i, i)        [theTailIsASegmentBasedBelow, i < succ i]
//                 = segment(p,q,i, 0,   i)        [i - i = 0]
//                 = conv(p,q,i,i)                 [segmentAtZeroIsTheConvolution]
//
// This is the reindexing: the i-th coefficient of a product is unchanged when the sum is
// read from the other end.
theorem convolutionIsReversible: forall p, q: Poly; forall i: Nat;
  convolution(q, p, ZERO, i) = convolution(p, q, ZERO, i)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-i |
            fix i: Nat {
              @the-reversed-sum-is-the-tail |
                convolution(q, p, ZERO, i) = tailConvolution(p, q, i, ZERO)
                [using specialize reversedConvolutionIsTheTailSegment(p, q, i, ZERO)]
              @the-tail-is-a-segment |
                tailConvolution(p, q, i, ZERO) = segment(p, q, i, ZERO, i)
                [using specialize aTailIsAFullSegment(p, q, i, ZERO)]
              @the-segment-is-the-convolution |
                segment(p, q, i, ZERO, i) = convolution(p, q, ZERO, i)
                [using specialize aFullSegmentReadsForwards(p, q, i)]
              @conclusion-the-sum-reverses |
                convolution(q, p, ZERO, i) = convolution(p, q, ZERO, i)
                [using chain the-reversed-sum-is-the-tail the-tail-is-a-segment
                  the-segment-is-the-convolution]
            }
          @discharge-i |
            forall i: Nat; convolution(q, p, ZERO, i) = convolution(p, q, ZERO, i)
            [by generalize generalize-i]
        }
      @discharge-q |
        forall q: Poly; forall i: Nat;
          convolution(q, p, ZERO, i) = convolution(p, q, ZERO, i)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall i: Nat;
      convolution(q, p, ZERO, i) = convolution(p, q, ZERO, i)
    [by generalize generalize-p]
qed

// JUDSON'S EXERCISE, DISCHARGED: R[x] is commutative.
theorem polyMulIsCommutative: forall p, q: Poly; mulP(p, q) = mulP(q, p)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-index |
            fix i: Nat {
              @the-forward-coefficient |
                coeff(mulP(p, q), i) = convolution(p, q, ZERO, i)
                [using specialize mulPolyCoeff(p, q, i)]
              @the-reversed-coefficient |
                coeff(mulP(q, p), i) = convolution(q, p, ZERO, i)
                [using specialize mulPolyCoeff(q, p, i)]
              @the-sums-agree |
                convolution(q, p, ZERO, i) = convolution(p, q, ZERO, i)
                [using specialize convolutionIsReversible(p, q, i)]
              @coefficients-agree-at-index |
                coeff(mulP(p, q), i) = coeff(mulP(q, p), i)
                [using chain the-forward-coefficient the-sums-agree-flipped the-reversed-coefficient-flipped]
              @the-sums-agree-flipped |
                convolution(p, q, ZERO, i) = convolution(q, p, ZERO, i)
                [by symmetry the-sums-agree]
              @the-reversed-coefficient-flipped |
                convolution(q, p, ZERO, i) = coeff(mulP(q, p), i)
                [by symmetry the-reversed-coefficient]
            }
          @corresponding-coefficients-are-equal |
            forall i: Nat; coeff(mulP(p, q), i) = coeff(mulP(q, p), i)
            [by generalize generalize-index]
          @conclusion-multiplication-commutes |
            mulP(p, q) = mulP(q, p)
            [using specialize polyExtensionality(mulP(p, q), mulP(q, p)) corresponding-coefficients-are-equal]
        }
      @discharge-q |
        forall q: Poly; mulP(p, q) = mulP(q, p)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; mulP(p, q) = mulP(q, p)
    [by generalize generalize-p]
qed
// The base: one term, and R's negation pulls out of a product.
theorem theNegatedConvolutionBase: forall p, q: Poly; forall j: Nat;
  convolution(negP(p), q, j, ZERO) = negR(convolution(p, q, j, ZERO))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-j |
            fix j: Nat {
              @the-negated-term |
                convolution(negP(p), q, j, ZERO) =
                  mulR(coeff(negP(p), j), coeff(q, ZERO))
                [using specialize convolutionZero(negP(p), q, j)]
              @the-plain-term |
                convolution(p, q, j, ZERO) = mulR(coeff(p, j), coeff(q, ZERO))
                [using specialize convolutionZero(p, q, j)]
              @the-negated-coefficient |
                coeff(negP(p), j) = negR(coeff(p, j))
                [using specialize negPolyCoeff(p, j)]
              @the-negation-pulls-out |
                mulR(negR(coeff(p, j)), coeff(q, ZERO)) =
                  negR(mulR(coeff(p, j), coeff(q, ZERO)))
                [using specialize ring.mulNegLeft(coeff(p, j), coeff(q, ZERO))]
              @conclusion-the-base-negates |
                convolution(negP(p), q, j, ZERO) =
                  negR(convolution(p, q, j, ZERO))
                [using simplify the-negated-term the-negated-coefficient
                  the-negation-pulls-out the-plain-term]
            }
          @discharge-j |
            forall j: Nat;
              convolution(negP(p), q, j, ZERO) = negR(convolution(p, q, j, ZERO))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: Poly; forall j: Nat;
          convolution(negP(p), q, j, ZERO) = negR(convolution(p, q, j, ZERO))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall j: Nat;
      convolution(negP(p), q, j, ZERO) = negR(convolution(p, q, j, ZERO))
    [by generalize generalize-p]
qed

// The step: the peeled term's negation pulls out, the tail's does by hypothesis, and
// -(A) + -(B) = -(A + B) gathers them.
theorem theNegatedConvolutionStep: forall p, q: Poly; forall m: Nat;
  (forall j: Nat;
  convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m))) ->
  (forall j: Nat;
  convolution(negP(p), q, j, succ(m)) = negR(convolution(p, q, j, succ(m))))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @given-the-hypothesis |
                assume forall j: Nat;
                  convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m)) {
                  @the-hypothesis |
                    forall j: Nat;
                      convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m))
                    [by hypothesis given-the-hypothesis]
                  @generalize-j |
                    fix j: Nat {
                      @the-negated-step |
                        convolution(negP(p), q, j, succ(m)) =
                          addR(mulR(coeff(negP(p), j), coeff(q, succ(m))),
                          convolution(negP(p), q, succ(j), m))
                        [using specialize convolutionSucc(negP(p), q, j, m)]
                      @the-plain-step |
                        convolution(p, q, j, succ(m)) =
                          addR(mulR(coeff(p, j), coeff(q, succ(m))),
                          convolution(p, q, succ(j), m))
                        [using specialize convolutionSucc(p, q, j, m)]
                      @the-negated-coefficient |
                        coeff(negP(p), j) = negR(coeff(p, j))
                        [using specialize negPolyCoeff(p, j)]
                      @the-peeled-negation-pulls-out |
                        mulR(negR(coeff(p, j)), coeff(q, succ(m))) =
                          negR(mulR(coeff(p, j), coeff(q, succ(m))))
                        [using specialize ring.mulNegLeft(
                          coeff(p, j), coeff(q, succ(m)))]
                      @the-tail-negates |
                        convolution(negP(p), q, succ(j), m) =
                          negR(convolution(p, q, succ(j), m))
                        [by apply_at(succ(j)) the-hypothesis]
                      @the-step-with-both-negations |
                        convolution(negP(p), q, j, succ(m)) =
                          addR(negR(mulR(coeff(p, j), coeff(q, succ(m)))),
                          negR(convolution(p, q, succ(j), m)))
                        [using simplify the-negated-step the-negated-coefficient
                          the-peeled-negation-pulls-out the-tail-negates]
                      @the-negations-gather |
                        addR(negR(mulR(coeff(p, j), coeff(q, succ(m)))),
                          negR(convolution(p, q, succ(j), m))) =
                          negR(addR(mulR(coeff(p, j), coeff(q, succ(m))),
                          convolution(p, q, succ(j), m)))
                        [using specialize ring.negationOfASum(
                          mulR(coeff(p, j), coeff(q, succ(m))),
                          convolution(p, q, succ(j), m))]
                      @the-step-gathered |
                        convolution(negP(p), q, j, succ(m)) =
                          negR(addR(mulR(coeff(p, j), coeff(q, succ(m))),
                          convolution(p, q, succ(j), m)))
                        [using chain the-step-with-both-negations the-negations-gather]
                      @conclusion-the-step-negates |
                        convolution(negP(p), q, j, succ(m)) =
                          negR(convolution(p, q, j, succ(m)))
                        [using simplify the-step-gathered the-plain-step]
                    }
                  @all-base-indices |
                    forall j: Nat;
                      convolution(negP(p), q, j, succ(m)) =
                      negR(convolution(p, q, j, succ(m)))
                    [by generalize generalize-j]
                }
              @the-hypothesis-gives-it |
                (forall j: Nat;
                  convolution(negP(p), q, j, m) =
                  negR(convolution(p, q, j, m))) ->
                  (forall j: Nat;
                  convolution(negP(p), q, j, succ(m)) =
                  negR(convolution(p, q, j, succ(m))))
                [by discharge given-the-hypothesis]
            }
          @discharge-m |
            forall m: Nat;
              (forall j: Nat;
              convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m))) ->
              (forall j: Nat;
              convolution(negP(p), q, j, succ(m)) =
              negR(convolution(p, q, j, succ(m))))
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m: Nat;
          (forall j: Nat;
          convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m))) ->
          (forall j: Nat;
          convolution(negP(p), q, j, succ(m)) =
          negR(convolution(p, q, j, succ(m))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m: Nat;
      (forall j: Nat;
      convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m))) ->
      (forall j: Nat;
      convolution(negP(p), q, j, succ(m)) =
      negR(convolution(p, q, j, succ(m))))
    [by generalize generalize-p]
qed

// Negating the left factor negates each convolution term, hence the whole sum.
theorem negationPullsOutOfTheConvolution: forall p, q: Poly; forall m, j: Nat;
  convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @base-case |
            forall j: Nat;
              convolution(negP(p), q, j, ZERO) = negR(convolution(p, q, j, ZERO))
            [using specialize theNegatedConvolutionBase(p, q)]
          @induction-step-for-all-m |
            forall m: Nat;
              (forall j: Nat;
              convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m))) ->
              (forall j: Nat;
              convolution(negP(p), q, j, succ(m)) =
              negR(convolution(p, q, j, succ(m))))
            [using specialize theNegatedConvolutionStep(p, q)]
          @all-complements |
            forall m: Nat; forall j: Nat;
              convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m))
            [using instantiation peano.induction((fun z: Nat => forall j: Nat; convolution(negP(p), q, j, z) = negR(convolution(p, q, j, z)))) base-case induction-step-for-all-m]
        }
      @discharge-q |
        forall q: Poly; forall m, j: Nat;
          convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, j: Nat;
      convolution(negP(p), q, j, m) = negR(convolution(p, q, j, m))
    [by generalize generalize-p]
qed

// Negation is an involution on polynomials, coefficientwise from R's.
theorem negationIsAnInvolution: forall p: Poly; negP(negP(p)) = p
proof
  @generalize-p |
    fix p: Poly {
      @each-index |
        fix i: Nat {
          @the-outer-coefficient |
            coeff(negP(negP(p)), i) = negR(coeff(negP(p), i))
            [using specialize negPolyCoeff(negP(p), i)]
          @the-inner-coefficient |
            coeff(negP(p), i) = negR(coeff(p, i))
            [using specialize negPolyCoeff(p, i)]
          @the-double-negated-coefficient |
            coeff(negP(negP(p)), i) = negR(negR(coeff(p, i)))
            [by rewrite the-inner-coefficient the-outer-coefficient]
          @the-scalar-negations-cancel |
            negR(negR(coeff(p, i))) = coeff(p, i)
            [using specialize ring.negationIsAnInvolution(coeff(p, i))]
          @conclusion-the-coefficients-agree |
            coeff(negP(negP(p)), i) = coeff(p, i)
            [using simplify the-double-negated-coefficient the-scalar-negations-cancel]
        }
      @all-coefficients-agree |
        forall i: Nat; coeff(negP(negP(p)), i) = coeff(p, i)
        [by generalize each-index]
      @conclusion-the-involution |
        negP(negP(p)) = p
        [using specialize polyExtensionality(negP(negP(p)), p) all-coefficients-agree]
    }
  @conclusion |
    forall p: Poly; negP(negP(p)) = p
    [by generalize generalize-p]
qed
// Hence negation pulls out of a product: coefficientwise, each is a convolution.
theorem negationPullsOutOfTheProduct: forall p, q: Poly;
  mulP(negP(p), q) = negP(mulP(p, q))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @each-index |
            fix i: Nat {
              @the-negated-product-coefficient |
                coeff(mulP(negP(p), q), i) = convolution(negP(p), q, ZERO, i)
                [using specialize mulPolyCoeff(negP(p), q, i)]
              @the-product-coefficient |
                coeff(mulP(p, q), i) = convolution(p, q, ZERO, i)
                [using specialize mulPolyCoeff(p, q, i)]
              @the-convolution-negates |
                convolution(negP(p), q, ZERO, i) = negR(convolution(p, q, ZERO, i))
                [using specialize negationPullsOutOfTheConvolution(p, q, i, ZERO)]
              @the-negated-polys-coefficient |
                coeff(negP(mulP(p, q)), i) = negR(coeff(mulP(p, q), i))
                [using specialize negPolyCoeff(mulP(p, q), i)]
              @the-right-side-is-the-negated-convolution |
                coeff(negP(mulP(p, q)), i) = negR(convolution(p, q, ZERO, i))
                [using simplify the-negated-polys-coefficient the-product-coefficient]
              @the-left-side-is-the-negated-convolution |
                coeff(mulP(negP(p), q), i) = negR(convolution(p, q, ZERO, i))
                [using simplify the-negated-product-coefficient the-convolution-negates]
              @conclusion-the-coefficients-agree |
                coeff(mulP(negP(p), q), i) = coeff(negP(mulP(p, q)), i)
                [using simplify the-left-side-is-the-negated-convolution
                  the-right-side-is-the-negated-convolution]
            }
          @all-coefficients-agree |
            forall i: Nat; coeff(mulP(negP(p), q), i) = coeff(negP(mulP(p, q)), i)
            [by generalize each-index]
          @conclusion-the-products-are-equal |
            mulP(negP(p), q) = negP(mulP(p, q))
            [using specialize polyExtensionality(
              mulP(negP(p), q), negP(mulP(p, q))) all-coefficients-agree]
        }
      @conclusion-for-all-q |
        forall q: Poly; mulP(negP(p), q) = negP(mulP(p, q))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; mulP(negP(p), q) = negP(mulP(p, q))
    [by generalize generalize-p]
qed

// The right-hand form, by commutativity rather than a second induction.
theorem negationPullsOutOfTheProductOnTheRight: forall p, q: Poly;
  mulP(p, negP(q)) = negP(mulP(p, q))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @commute-the-negated-product |
            mulP(p, negP(q)) = mulP(negP(q), p)
            [using specialize polyMulIsCommutative(p, negP(q))]
          @pull-the-negation-out |
            mulP(negP(q), p) = negP(mulP(q, p))
            [using specialize negationPullsOutOfTheProduct(q, p)]
          @commute-back |
            mulP(q, p) = mulP(p, q)
            [using specialize polyMulIsCommutative(q, p)]
          @the-negated-product-commuted |
            mulP(p, negP(q)) = negP(mulP(q, p))
            [using simplify commute-the-negated-product pull-the-negation-out]
          @conclusion-the-right-hand-form |
            mulP(p, negP(q)) = negP(mulP(p, q))
            [by rewrite commute-back the-negated-product-commuted]
        }
      @conclusion-for-all-q |
        forall q: Poly; mulP(p, negP(q)) = negP(mulP(p, q))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; mulP(p, negP(q)) = negP(mulP(p, q))
    [by generalize generalize-p]
qed

// Two negations cancel in a product — the step Judson's `(-a)(-b) = ab` rewriting needs.
theorem twoNegationsCancelInAProduct: forall p, q: Poly;
  mulP(negP(p), negP(q)) = mulP(p, q)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @pull-the-left-negation-out |
            mulP(negP(p), negP(q)) = negP(mulP(p, negP(q)))
            [using specialize negationPullsOutOfTheProduct(p, negP(q))]
          @pull-the-right-negation-out |
            mulP(p, negP(q)) = negP(mulP(p, q))
            [using specialize negationPullsOutOfTheProductOnTheRight(p, q)]
          @the-double-negation |
            mulP(negP(p), negP(q)) = negP(negP(mulP(p, q)))
            [by rewrite pull-the-right-negation-out pull-the-left-negation-out]
          @the-negations-cancel |
            negP(negP(mulP(p, q))) = mulP(p, q)
            [using specialize negationIsAnInvolution(mulP(p, q))]
          @conclusion-two-negations-cancel |
            mulP(negP(p), negP(q)) = mulP(p, q)
            [using simplify the-double-negation the-negations-cancel]
        }
      @conclusion-for-all-q |
        forall q: Poly; mulP(negP(p), negP(q)) = mulP(p, q)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; mulP(negP(p), negP(q)) = mulP(p, q)
    [by generalize generalize-p]
qed

// -(p + q) = -p + -q, coefficientwise from R's `negationOfASum`.
theorem negationOfASum: forall p, q: Poly;
  addP(negP(p), negP(q)) = negP(addP(p, q))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @each-index |
            fix i: Nat {
              @the-left-coefficient |
                coeff(addP(negP(p), negP(q)), i) =
                  addR(coeff(negP(p), i), coeff(negP(q), i))
                [using specialize addPolyCoeff(negP(p), negP(q), i)]
              @the-left-negation |
                coeff(negP(p), i) = negR(coeff(p, i))
                [using specialize negPolyCoeff(p, i)]
              @the-right-negation |
                coeff(negP(q), i) = negR(coeff(q, i))
                [using specialize negPolyCoeff(q, i)]
              @the-left-coefficient-expanded |
                coeff(addP(negP(p), negP(q)), i) =
                  addR(negR(coeff(p, i)), negR(coeff(q, i)))
                [using simplify the-left-coefficient
                  the-left-negation the-right-negation]
              @the-scalar-negations-gather |
                addR(negR(coeff(p, i)), negR(coeff(q, i))) =
                  negR(addR(coeff(p, i), coeff(q, i)))
                [using specialize ring.negationOfASum(coeff(p, i), coeff(q, i))]
              @the-left-is-the-negated-sum |
                coeff(addP(negP(p), negP(q)), i) =
                  negR(addR(coeff(p, i), coeff(q, i)))
                [using simplify the-left-coefficient-expanded the-scalar-negations-gather]
              @the-right-coefficient |
                coeff(negP(addP(p, q)), i) = negR(coeff(addP(p, q), i))
                [using specialize negPolyCoeff(addP(p, q), i)]
              @the-inner-sum-coefficient |
                coeff(addP(p, q), i) = addR(coeff(p, i), coeff(q, i))
                [using specialize addPolyCoeff(p, q, i)]
              @the-right-is-the-negated-sum |
                coeff(negP(addP(p, q)), i) = negR(addR(coeff(p, i), coeff(q, i)))
                [using simplify the-right-coefficient the-inner-sum-coefficient]
              @conclusion-the-coefficients-agree |
                coeff(addP(negP(p), negP(q)), i) = coeff(negP(addP(p, q)), i)
                [using simplify the-left-is-the-negated-sum the-right-is-the-negated-sum]
            }
          @all-coefficients-agree |
            forall i: Nat;
              coeff(addP(negP(p), negP(q)), i) = coeff(negP(addP(p, q)), i)
            [by generalize each-index]
          @conclusion-the-negations-gather |
            addP(negP(p), negP(q)) = negP(addP(p, q))
            [using specialize polyExtensionality(
              addP(negP(p), negP(q)), negP(addP(p, q))) all-coefficients-agree]
        }
      @conclusion-for-all-q |
        forall q: Poly; addP(negP(p), negP(q)) = negP(addP(p, q))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; addP(negP(p), negP(q)) = negP(addP(p, q))
    [by generalize generalize-p]
qed

// p + 0 = p, the right-hand companion to `polyAddZeroLeft`.
theorem polyAddZeroRight: forall p: Poly; addP(p, ZEROP) = p
proof
  @generalize-p |
    fix p: Poly {
      @commute |
        addP(p, ZEROP) = addP(ZEROP, p)
        [using specialize polyAddIsCommutative(p, ZEROP)]
      @the-left-form-collapses |
        addP(ZEROP, p) = p
        [using specialize polyAddZeroLeft(p)]
      @conclusion-the-right-form-collapses |
        addP(p, ZEROP) = p
        [using simplify commute the-left-form-collapses]
    }
  @conclusion |
    forall p: Poly; addP(p, ZEROP) = p
    [by generalize generalize-p]
qed
// p + -p = 0, the right-hand companion to `polyAddNegLeft`.
theorem polyAddNegRight: forall p: Poly; addP(p, negP(p)) = ZEROP
proof
  @generalize-p |
    fix p: Poly {
      @commute |
        addP(p, negP(p)) = addP(negP(p), p)
        [using specialize polyAddIsCommutative(p, negP(p))]
      @the-left-form-vanishes |
        addP(negP(p), p) = ZEROP
        [using specialize polyAddNegLeft(p)]
      @conclusion-the-right-form-vanishes |
        addP(p, negP(p)) = ZEROP
        [using simplify commute the-left-form-vanishes]
    }
  @conclusion |
    forall p: Poly; addP(p, negP(p)) = ZEROP
    [by generalize generalize-p]
qed
// (p + r) + -r = p, the polynomial form of `aSumCancelsItsRightSummand`.
theorem aSumCancelsItsRightSummand: forall p, r: Poly;
  addP(addP(p, r), negP(r)) = p
proof
  @generalize-p |
    fix p: Poly {
      @generalize-r |
        fix r: Poly {
          @associate |
            addP(addP(p, r), negP(r)) = addP(p, addP(r, negP(r)))
            [using specialize polyAddIsAssociative(p, r, negP(r))]
          @r-cancels |
            addP(r, negP(r)) = ZEROP
            [using specialize polyAddNegRight(r)]
          @the-inner-sum-vanishes |
            addP(addP(p, r), negP(r)) = addP(p, ZEROP)
            [using simplify associate r-cancels]
          @adding-zero-changes-nothing |
            addP(p, ZEROP) = p
            [using specialize polyAddZeroRight(p)]
          @conclusion-the-summand-cancels |
            addP(addP(p, r), negP(r)) = p
            [using simplify the-inner-sum-vanishes adding-zero-changes-nothing]
        }
      @conclusion-for-all-r |
        forall r: Poly; addP(addP(p, r), negP(r)) = p
        [by generalize generalize-r]
    }
  @conclusion |
    forall p, r: Poly; addP(addP(p, r), negP(r)) = p
    [by generalize generalize-p]
qed

// Additive cancellation on polynomials: p + r = q + r implies p = q. This is the step a
// division-remainder argument needs to read `rem = f - mulP(g, quo)` off
// `f = addP(mulP(g, quo), rem)`.
theorem polyAddCancelRight: forall p, q, r: Poly;
  addP(p, r) = addP(q, r) -> p = q
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @given-the-sums-agree |
                assume addP(p, r) = addP(q, r) {
                  @the-sums-agree |
                    addP(p, r) = addP(q, r)
                    [by hypothesis given-the-sums-agree]
                  @add-the-inverse-on-the-right |
                    addP(addP(p, r), negP(r)) = addP(addP(q, r), negP(r))
                    [by rewrite the-sums-agree]
                  @the-left-collapses |
                    addP(addP(p, r), negP(r)) = p
                    [using specialize aSumCancelsItsRightSummand(p, r)]
                  @the-right-collapses |
                    addP(addP(q, r), negP(r)) = q
                    [using specialize aSumCancelsItsRightSummand(q, r)]
                  @the-left-is-the-right-side |
                    p = addP(addP(q, r), negP(r))
                    [by rewrite the-left-collapses add-the-inverse-on-the-right]
                  @conclusion-the-summands-agree |
                    p = q
                    [by rewrite the-right-collapses the-left-is-the-right-side]
                }
              @conclusion-cancellation |
                addP(p, r) = addP(q, r) -> p = q
                [by discharge given-the-sums-agree]
            }
          @conclusion-for-all-r |
            forall r: Poly; addP(p, r) = addP(q, r) -> p = q
            [by generalize generalize-r]
        }
      @conclusion-for-all-q |
        forall q, r: Poly; addP(p, r) = addP(q, r) -> p = q
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; addP(p, r) = addP(q, r) -> p = q
    [by generalize generalize-p]
qed

// Right distributivity, from the left form and commutativity.
theorem polyMulAddDistribRight: forall p, q, r: Poly;
  mulP(addP(p, q), r) = addP(mulP(p, r), mulP(q, r))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @commute-the-product |
                mulP(addP(p, q), r) = mulP(r, addP(p, q))
                [using specialize polyMulIsCommutative(addP(p, q), r)]
              @distribute-on-the-left |
                mulP(r, addP(p, q)) = addP(mulP(r, p), mulP(r, q))
                [using specialize polyMulAddDistribLeft(r, p, q)]
              @the-distributed-form |
                mulP(addP(p, q), r) = addP(mulP(r, p), mulP(r, q))
                [using simplify commute-the-product distribute-on-the-left]
              @commute-the-first-summand |
                mulP(r, p) = mulP(p, r)
                [using specialize polyMulIsCommutative(r, p)]
              @commute-the-second-summand |
                mulP(r, q) = mulP(q, r)
                [using specialize polyMulIsCommutative(r, q)]
              @with-the-first-commuted |
                mulP(addP(p, q), r) = addP(mulP(p, r), mulP(r, q))
                [by rewrite commute-the-first-summand the-distributed-form]
              @conclusion-right-distributivity |
                mulP(addP(p, q), r) = addP(mulP(p, r), mulP(q, r))
                [by rewrite commute-the-second-summand with-the-first-commuted]
            }
          @conclusion-for-all-r |
            forall r: Poly; mulP(addP(p, q), r) = addP(mulP(p, r), mulP(q, r))
            [by generalize generalize-r]
        }
      @conclusion-for-all-q |
        forall q, r: Poly; mulP(addP(p, q), r) = addP(mulP(p, r), mulP(q, r))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; mulP(addP(p, q), r) = addP(mulP(p, r), mulP(q, r))
    [by generalize generalize-p]
qed

// p · 0 = 0. Every convolution term carries a zero coefficient from the right factor, so the
// whole sum vanishes. Generic — nothing about the coefficient ring beyond `mulZeroRight`.
theorem theZeroRunVanishes: forall p: Poly; forall m, j: Nat;
  convolution(p, ZEROP, j, m) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @base-case |
        forall j: Nat; convolution(p, ZEROP, j, ZERO) = zeroR
        [using specialize theZeroRunBase(p)]
      @induction-step-for-all-m |
        forall m: Nat;
          (forall j: Nat; convolution(p, ZEROP, j, m) = zeroR) ->
          (forall j: Nat; convolution(p, ZEROP, j, succ(m)) = zeroR)
        [using specialize theZeroRunStep(p)]
      @all-complements |
        forall m: Nat; forall j: Nat; convolution(p, ZEROP, j, m) = zeroR
        [using instantiation peano.induction((fun z: Nat => forall j: Nat; convolution(p, ZEROP, j, z) = zeroR)) base-case induction-step-for-all-m]
    }
  @conclusion |
    forall p: Poly; forall m, j: Nat;
      convolution(p, ZEROP, j, m) = zeroR
    [by generalize generalize-p]
qed

theorem theZeroRunBase: forall p: Poly; forall j: Nat;
  convolution(p, ZEROP, j, ZERO) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @generalize-j |
        fix j: Nat {
          @the-term |
            convolution(p, ZEROP, j, ZERO) =
              mulR(coeff(p, j), coeff(ZEROP, ZERO))
            [using specialize convolutionZero(p, ZEROP, j)]
          @the-zero-coefficient |
            coeff(ZEROP, ZERO) = zeroR
            [using specialize zeroPolyCoeff(ZERO)]
          @the-product-vanishes |
            mulR(coeff(p, j), zeroR) = zeroR
            [using specialize mulZeroRightR(coeff(p, j))]
          @conclusion-the-base-vanishes |
            convolution(p, ZEROP, j, ZERO) = zeroR
            [using simplify the-term the-zero-coefficient the-product-vanishes]
        }
      @discharge-j |
        forall j: Nat; convolution(p, ZEROP, j, ZERO) = zeroR
        [by generalize generalize-j]
    }
  @conclusion |
    forall p: Poly; forall j: Nat; convolution(p, ZEROP, j, ZERO) = zeroR
    [by generalize generalize-p]
qed

theorem theZeroRunStep: forall p: Poly; forall m: Nat;
  (forall j: Nat; convolution(p, ZEROP, j, m) = zeroR) ->
  (forall j: Nat; convolution(p, ZEROP, j, succ(m)) = zeroR)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-m |
        fix m: Nat {
          @given-the-hypothesis |
            assume forall j: Nat; convolution(p, ZEROP, j, m) = zeroR {
              @the-hypothesis |
                forall j: Nat; convolution(p, ZEROP, j, m) = zeroR
                [by hypothesis given-the-hypothesis]
              @generalize-j |
                fix j: Nat {
                  @the-step |
                    convolution(p, ZEROP, j, succ(m)) =
                      addR(mulR(coeff(p, j), coeff(ZEROP, succ(m))),
                      convolution(p, ZEROP, succ(j), m))
                    [using specialize convolutionSucc(p, ZEROP, j, m)]
                  @the-zero-coefficient |
                    coeff(ZEROP, succ(m)) = zeroR
                    [using specialize zeroPolyCoeff(succ(m))]
                  @the-new-term-vanishes |
                    mulR(coeff(p, j), zeroR) = zeroR
                    [using specialize mulZeroRightR(coeff(p, j))]
                  @the-tail-vanishes |
                    convolution(p, ZEROP, succ(j), m) = zeroR
                    [by apply_at(succ(j)) the-hypothesis]
                  @the-step-reduced |
                    convolution(p, ZEROP, j, succ(m)) = addR(zeroR, zeroR)
                    [using simplify the-step the-zero-coefficient
                      the-new-term-vanishes the-tail-vanishes]
                  @zero-plus-zero |
                    addR(zeroR, zeroR) = zeroR
                    [using specialize addZeroRightR(zeroR)]
                  @conclusion-the-step-vanishes |
                    convolution(p, ZEROP, j, succ(m)) = zeroR
                    [using chain the-step-reduced zero-plus-zero]
                }
              @all-base-indices |
                forall j: Nat; convolution(p, ZEROP, j, succ(m)) = zeroR
                [by generalize generalize-j]
            }
          @the-hypothesis-gives-it |
            (forall j: Nat; convolution(p, ZEROP, j, m) = zeroR) ->
              (forall j: Nat; convolution(p, ZEROP, j, succ(m)) = zeroR)
            [by discharge given-the-hypothesis]
        }
      @discharge-m |
        forall m: Nat;
          (forall j: Nat; convolution(p, ZEROP, j, m) = zeroR) ->
          (forall j: Nat; convolution(p, ZEROP, j, succ(m)) = zeroR)
        [by generalize generalize-m]
    }
  @conclusion |
    forall p: Poly; forall m: Nat;
      (forall j: Nat; convolution(p, ZEROP, j, m) = zeroR) ->
      (forall j: Nat; convolution(p, ZEROP, j, succ(m)) = zeroR)
    [by generalize generalize-p]
qed

// Hence p · 0 = 0, coefficientwise.
theorem polyMulZeroRight: forall p: Poly; mulP(p, ZEROP) = ZEROP
proof
  @generalize-p |
    fix p: Poly {
      @each-index |
        fix i: Nat {
          @the-product-coefficient |
            coeff(mulP(p, ZEROP), i) = convolution(p, ZEROP, ZERO, i)
            [using specialize mulPolyCoeff(p, ZEROP, i)]
          @the-run-vanishes |
            convolution(p, ZEROP, ZERO, i) = zeroR
            [using specialize theZeroRunVanishes(p, i, ZERO)]
          @the-zero-coefficient |
            coeff(ZEROP, i) = zeroR
            [using specialize zeroPolyCoeff(i)]
          @conclusion-the-coefficients-agree |
            coeff(mulP(p, ZEROP), i) = coeff(ZEROP, i)
            [using simplify the-product-coefficient the-run-vanishes
              the-zero-coefficient]
        }
      @all-coefficients-agree |
        forall i: Nat; coeff(mulP(p, ZEROP), i) = coeff(ZEROP, i)
        [by generalize each-index]
      @conclusion-the-product-is-zero |
        mulP(p, ZEROP) = ZEROP
        [using specialize polyExtensionality(mulP(p, ZEROP), ZEROP)
          all-coefficients-agree]
    }
  @conclusion |
    forall p: Poly; mulP(p, ZEROP) = ZEROP
    [by generalize generalize-p]
qed

// Agreement above b implies agreement above succ(b): succ(b) + d = b + succ(d).
theorem theAgreementRaises: forall p, p2: Poly; forall b: Nat;
  (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
  (forall d: Nat;
  coeff(p, succ(addN(succ(b), d))) = coeff(p2, succ(addN(succ(b), d))))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-p2 |
        fix p2: Poly {
          @generalize-b |
            fix b: Nat {
              @given-the-agreement |
                assume forall d: Nat;
                  coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d))) {
                  @the-agreement |
                    forall d: Nat;
                      coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))
                    [by hypothesis given-the-agreement]
                  @generalize-d |
                    fix d: Nat {
                      @the-shifted-sum |
                        addN(succ(b), d) = addN(b, succ(d))
                        [using specialize theSumsShift(b, d)]
                      @they-agree-at-the-shift |
                        coeff(p, succ(addN(b, succ(d)))) =
                          coeff(p2, succ(addN(b, succ(d))))
                        [by apply_at(succ(d)) the-agreement]
                      @conclusion-they-agree |
                        coeff(p, succ(addN(succ(b), d))) =
                          coeff(p2, succ(addN(succ(b), d)))
                        [by rewrite the-shifted-sum they-agree-at-the-shift]
                    }
                  @all-gaps |
                    forall d: Nat;
                      coeff(p, succ(addN(succ(b), d))) =
                      coeff(p2, succ(addN(succ(b), d)))
                    [by generalize generalize-d]
                }
              @the-agreement-gives-it |
                (forall d: Nat;
                  coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                  (forall d: Nat;
                  coeff(p, succ(addN(succ(b), d))) =
                  coeff(p2, succ(addN(succ(b), d))))
                [by discharge given-the-agreement]
            }
          @discharge-b |
            forall b: Nat;
              (forall d: Nat;
              coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
              (forall d: Nat;
              coeff(p, succ(addN(succ(b), d))) =
              coeff(p2, succ(addN(succ(b), d))))
            [by generalize generalize-b]
        }
      @discharge-p2 |
        forall p2: Poly; forall b: Nat;
          (forall d: Nat;
          coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
          (forall d: Nat;
          coeff(p, succ(addN(succ(b), d))) = coeff(p2, succ(addN(succ(b), d))))
        [by generalize generalize-p2]
    }
  @conclusion |
    forall p, p2: Poly; forall b: Nat;
      (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
      (forall d: Nat;
      coeff(p, succ(addN(succ(b), d))) = coeff(p2, succ(addN(succ(b), d))))
    [by generalize generalize-p]
qed

// succ(b) + d = b + succ(d) — both are succ(b + d).
theorem theSumsShift: forall b, d: Nat;
  addN(succ(b), d) = addN(b, succ(d))
proof
  @generalize-b |
    fix b: Nat {
      @generalize-d |
        fix d: Nat {
          @the-left |
            addN(succ(b), d) = succ(addN(b, d))
            [using specialize peano.addSuccLeft(b, d)]
          @the-right |
            addN(b, succ(d)) = succ(addN(b, d))
            [using specialize peano.addSuccRight(b, d)]
          @conclusion-they-agree |
            addN(succ(b), d) = addN(b, succ(d))
            [using simplify the-left the-right]
        }
      @discharge-d |
        forall d: Nat; addN(succ(b), d) = addN(b, succ(d))
        [by generalize generalize-d]
    }
  @conclusion |
    forall b, d: Nat; addN(succ(b), d) = addN(b, succ(d))
    [by generalize generalize-b]
qed

// The base: a single term on each side, reading the coefficient at succ(b) — which is
// `succ(b + ZERO)`, the agreement at d = ZERO.
theorem theRunCongruenceBase: forall p, p2, q: Poly; forall b: Nat;
  (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
  convolution(p, q, succ(b), ZERO) = convolution(p2, q, succ(b), ZERO)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-p2 |
        fix p2: Poly {
          @generalize-q |
            fix q: Poly {
              @generalize-b |
                fix b: Nat {
                  @given-the-agreement |
                    assume forall d: Nat;
                      coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d))) {
                      @the-agreement |
                        forall d: Nat;
                          coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))
                        [by hypothesis given-the-agreement]
                      @the-gap-is-zero |
                        addN(b, ZERO) = b
                        [using specialize peano.addZeroRight(b)]
                      @they-agree-at-the-gap |
                        coeff(p, succ(addN(b, ZERO))) = coeff(p2, succ(addN(b, ZERO)))
                        [by apply_at(ZERO) the-agreement]
                      @they-agree-at-the-base |
                        coeff(p, succ(b)) = coeff(p2, succ(b))
                        [by rewrite the-gap-is-zero they-agree-at-the-gap]
                      @the-left-term |
                        convolution(p, q, succ(b), ZERO) =
                          mulR(coeff(p, succ(b)), coeff(q, ZERO))
                        [using specialize convolutionZero(p, q, succ(b))]
                      @the-right-term |
                        convolution(p2, q, succ(b), ZERO) =
                          mulR(coeff(p2, succ(b)), coeff(q, ZERO))
                        [using specialize convolutionZero(p2, q, succ(b))]
                      @conclusion-the-base-agrees |
                        convolution(p, q, succ(b), ZERO) =
                          convolution(p2, q, succ(b), ZERO)
                        [using simplify the-left-term they-agree-at-the-base
                          the-right-term]
                    }
                  @the-agreement-gives-it |
                    (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                      convolution(p, q, succ(b), ZERO) =
                      convolution(p2, q, succ(b), ZERO)
                    [by discharge given-the-agreement]
                }
              @discharge-b |
                forall b: Nat;
                  (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                  convolution(p, q, succ(b), ZERO) =
                  convolution(p2, q, succ(b), ZERO)
                [by generalize generalize-b]
            }
          @discharge-q |
            forall q: Poly; forall b: Nat;
              (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
              convolution(p, q, succ(b), ZERO) =
              convolution(p2, q, succ(b), ZERO)
            [by generalize generalize-q]
        }
      @discharge-p2 |
        forall p2, q: Poly; forall b: Nat;
          (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
          convolution(p, q, succ(b), ZERO) = convolution(p2, q, succ(b), ZERO)
        [by generalize generalize-p2]
    }
  @conclusion |
    forall p, p2, q: Poly; forall b: Nat;
      (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
      convolution(p, q, succ(b), ZERO) = convolution(p2, q, succ(b), ZERO)
    [by generalize generalize-p]
qed

// The step. Both runs peel the term at succ(b) — which the agreement equates — and both
// recurse at succ(succ(b)). The tail is the INDUCTIVE HYPOTHESIS at the raised base, and the
// agreement above succ(b) follows from the agreement above b by `theAgreementRaises`. That is
// why the base is quantified inside the induction: the step needs the statement at succ(b),
// not at b.
theorem theRunCongruenceStep: forall p, p2, q: Poly; forall m: Nat;
  (forall b: Nat;
  (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
  convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)) ->
  (forall b: Nat;
  (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
  convolution(p, q, succ(b), succ(m)) =
  convolution(p2, q, succ(b), succ(m)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-p2 |
        fix p2: Poly {
          @generalize-q |
            fix q: Poly {
              @generalize-m |
                fix m: Nat {
                  @given-the-hypothesis |
                    assume (forall b: Nat;
                      (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                      convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)) {
                      @the-hypothesis |
                        (forall b: Nat;
                          (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                          convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m))
                        [by hypothesis given-the-hypothesis]
                      @generalize-b |
                        fix b: Nat {
                          @given-the-agreement |
                            assume forall d: Nat;
                              coeff(p, succ(addN(b, d))) =
                              coeff(p2, succ(addN(b, d))) {
                              @the-agreement |
                                forall d: Nat;
                                  coeff(p, succ(addN(b, d))) =
                                  coeff(p2, succ(addN(b, d)))
                                [by hypothesis given-the-agreement]
                              @the-gap-is-zero |
                                addN(b, ZERO) = b
                                [using specialize peano.addZeroRight(b)]
                              @they-agree-at-the-gap |
                                coeff(p, succ(addN(b, ZERO))) =
                                  coeff(p2, succ(addN(b, ZERO)))
                                [by apply_at(ZERO) the-agreement]
                              @they-agree-at-the-base |
                                coeff(p, succ(b)) = coeff(p2, succ(b))
                                [by rewrite the-gap-is-zero they-agree-at-the-gap]
                              // the agreement also holds one base higher
                              @they-agree-above-the-successor |
                                forall d: Nat;
                                  coeff(p, succ(addN(succ(b), d))) =
                                  coeff(p2, succ(addN(succ(b), d)))
                                [using specialize theAgreementRaises(p, p2, b)
                                  the-agreement]
                              // so the hypothesis applies at the raised base
                              @the-tails-agree |
                                convolution(p, q, succ(succ(b)), m) =
                                  convolution(p2, q, succ(succ(b)), m)
                                [using specialize the-hypothesis(succ(b))
                                  they-agree-above-the-successor]
                              @the-left-step |
                                convolution(p, q, succ(b), succ(m)) =
                                  addR(mulR(coeff(p, succ(b)), coeff(q, succ(m))),
                                  convolution(p, q, succ(succ(b)), m))
                                [using specialize convolutionSucc(p, q, succ(b), m)]
                              @the-right-step |
                                convolution(p2, q, succ(b), succ(m)) =
                                  addR(mulR(coeff(p2, succ(b)), coeff(q, succ(m))),
                                  convolution(p2, q, succ(succ(b)), m))
                                [using specialize convolutionSucc(p2, q, succ(b), m)]
                              @conclusion-the-step-agrees |
                                convolution(p, q, succ(b), succ(m)) =
                                  convolution(p2, q, succ(b), succ(m))
                                [using simplify the-left-step they-agree-at-the-base
                                  the-tails-agree the-right-step]
                            }
                          @the-agreement-gives-it |
                            (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                              convolution(p, q, succ(b), succ(m)) =
                              convolution(p2, q, succ(b), succ(m))
                            [by discharge given-the-agreement]
                        }
                      @all-bases |
                        (forall b: Nat;
                          (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                          convolution(p, q, succ(b), succ(m)) =
                          convolution(p2, q, succ(b), succ(m)))
                        [by generalize generalize-b]
                    }
                  @the-hypothesis-gives-it |
                    (forall b: Nat;
                      (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                      convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)) ->
                      (forall b: Nat;
                      (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                      convolution(p, q, succ(b), succ(m)) =
                      convolution(p2, q, succ(b), succ(m)))
                    [by discharge given-the-hypothesis]
                }
              @discharge-m |
                forall m: Nat;
                  (forall b: Nat;
                  (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                  convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)) ->
                  (forall b: Nat;
                  (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                  convolution(p, q, succ(b), succ(m)) =
                  convolution(p2, q, succ(b), succ(m)))
                [by generalize generalize-m]
            }
          @discharge-q |
            forall q: Poly; forall m: Nat;
              (forall b: Nat;
              (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
              convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)) ->
              (forall b: Nat;
              (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
              convolution(p, q, succ(b), succ(m)) =
              convolution(p2, q, succ(b), succ(m)))
            [by generalize generalize-q]
        }
      @discharge-p2 |
        forall p2, q: Poly; forall m: Nat;
          (forall b: Nat;
          (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
          convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)) ->
          (forall b: Nat;
          (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
          convolution(p, q, succ(b), succ(m)) =
          convolution(p2, q, succ(b), succ(m)))
        [by generalize generalize-p2]
    }
  @conclusion |
    forall p, p2, q: Poly; forall m: Nat;
      (forall b: Nat;
      (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
      convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)) ->
      (forall b: Nat;
      (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
      convolution(p, q, succ(b), succ(m)) =
      convolution(p2, q, succ(b), succ(m)))
    [by generalize generalize-p]
qed

// -- RUN CONGRUENCE -------------------------------------------------------------------------
// Two left factors that agree on every coefficient a run READS give that run the same value.
// The run from `succ(b)` reads indices succ(b), succ(b)+1, …, so the hypothesis is stated over
// `succ(addN(b, d))` — every index strictly above b — and no subtraction appears.
//
// This is what lets a two-term polynomial be treated as a monomial above its constant term.
//
// INDUCTION ON THE LENGTH, with the base quantified INSIDE. That ordering is forced: the step
// peels at succ(b) and recurses at succ(succ(b)), so it needs the statement at a RAISED base,
// which is only available if the base is under the induction's universal. An induction on the
// base instead would have the step cite the whole theorem — a citation cycle, which the
// checker refuses.
theorem runsAgreeWhenTheCoefficientsDo: forall p, p2, q: Poly; forall m, b: Nat;
  (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
  convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-p2 |
        fix p2: Poly {
          @generalize-q |
            fix q: Poly {
              @base-case |
                forall b: Nat;
                  (forall d: Nat;
                  coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                  convolution(p, q, succ(b), ZERO) =
                  convolution(p2, q, succ(b), ZERO)
                [using specialize theRunCongruenceBase(p, p2, q)]
              @induction-step-for-all-m |
                forall m: Nat;
                  (forall b: Nat;
                  (forall d: Nat;
                  coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                  convolution(p, q, succ(b), m) =
                  convolution(p2, q, succ(b), m)) ->
                  (forall b: Nat;
                  (forall d: Nat;
                  coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                  convolution(p, q, succ(b), succ(m)) =
                  convolution(p2, q, succ(b), succ(m)))
                [using specialize theRunCongruenceStep(p, p2, q)]
              @all-lengths |
                forall m: Nat; forall b: Nat;
                  (forall d: Nat;
                  coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
                  convolution(p, q, succ(b), m) =
                  convolution(p2, q, succ(b), m)
                [using instantiation peano.induction((fun z: Nat => forall b: Nat; (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) -> convolution(p, q, succ(b), z) = convolution(p2, q, succ(b), z))) base-case induction-step-for-all-m]
            }
          @discharge-q |
            forall q: Poly; forall m, b: Nat;
              (forall d: Nat;
              coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
              convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)
            [by generalize generalize-q]
        }
      @discharge-p2 |
        forall p2, q: Poly; forall m, b: Nat;
          (forall d: Nat;
          coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
          convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)
        [by generalize generalize-p2]
    }
  @conclusion |
    forall p, p2, q: Poly; forall m, b: Nat;
      (forall d: Nat; coeff(p, succ(addN(b, d))) = coeff(p2, succ(addN(b, d)))) ->
      convolution(p, q, succ(b), m) = convolution(p2, q, succ(b), m)
    [by generalize generalize-p]
qed

// The base: a zero gap, so the run already starts where it should.
theorem thePrefixSkipBase: forall p, q: Poly; forall t, b: Nat;
  (forall e, c: Nat;
  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
  convolution(p, q, b, addN(ZERO, t)) = convolution(p, q, addN(b, ZERO), t)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-t |
            fix t: Nat {
              @generalize-b |
                fix b: Nat {
                  @given-the-vanishing |
                    assume forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) =
                      zeroR {
                      @the-gap-collapses |
                        addN(b, ZERO) = b
                        [using specialize peano.addZeroRight(b)]
                      @the-length-collapses |
                        addN(ZERO, t) = t
                        [using specialize peano.addZeroLeft(t)]
                      @with-the-length |
                        convolution(p, q, b, addN(ZERO, t)) =
                          convolution(p, q, b, t)
                        [by rewrite the-length-collapses]
                      @conclusion-the-base-skips |
                        convolution(p, q, b, addN(ZERO, t)) =
                          convolution(p, q, addN(b, ZERO), t)
                        [by rewrite the-gap-collapses with-the-length]
                    }
                  @the-vanishing-gives-it |
                    (forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                      convolution(p, q, b, addN(ZERO, t)) =
                      convolution(p, q, addN(b, ZERO), t)
                    [by discharge given-the-vanishing]
                }
              @discharge-b |
                forall b: Nat;
                  (forall e, c: Nat;
                  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                  convolution(p, q, b, addN(ZERO, t)) =
                  convolution(p, q, addN(b, ZERO), t)
                [by generalize generalize-b]
            }
          @discharge-t |
            forall t, b: Nat;
              (forall e, c: Nat;
              mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
              convolution(p, q, b, addN(ZERO, t)) =
              convolution(p, q, addN(b, ZERO), t)
            [by generalize generalize-t]
        }
      @discharge-q |
        forall q: Poly; forall t, b: Nat;
          (forall e, c: Nat;
          mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
          convolution(p, q, b, addN(ZERO, t)) =
          convolution(p, q, addN(b, ZERO), t)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall t, b: Nat;
      (forall e, c: Nat;
      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
      convolution(p, q, b, addN(ZERO, t)) =
      convolution(p, q, addN(b, ZERO), t)
    [by generalize generalize-p]
qed

// The step, at a FIXED gap k. The run peels its first term — p at `b` times q at
// `succ(k + t)`, which the vanishing hypothesis kills — and the tail is the inductive
// hypothesis at base `succ(b)`. The hypothesis quantifies the BASE so the step can fire it one
// higher; the raised vanishing condition follows because every index above `succ(b)` is also
// above `b`.
theorem thePrefixSkipStepPerGap: forall p, q: Poly; forall t, k: Nat;
  (forall b: Nat;
  (forall e, c: Nat;
  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
  convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)) ->
  (forall b: Nat;
  (forall e, c: Nat;
  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
  convolution(p, q, b, addN(succ(k), t)) =
  convolution(p, q, addN(b, succ(k)), t))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-t |
            fix t: Nat {
              @generalize-k |
                fix k: Nat {
                  @given-the-hypothesis |
                    assume (forall b: Nat;
                      (forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                      convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)) {
                      @the-hypothesis |
                        (forall b: Nat;
                          (forall e, c: Nat;
                          mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                          convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t))
                        [by hypothesis given-the-hypothesis]
                      @generalize-b |
                        fix b: Nat {
                          @given-the-vanishing |
                            assume forall e, c: Nat;
                              mulR(coeff(p, addN(b, e)),
                              coeff(q, succ(addN(t, c)))) = zeroR {
                              @the-vanishing |
                                forall e, c: Nat;
                                  mulR(coeff(p, addN(b, e)),
                                  coeff(q, succ(addN(t, c)))) = zeroR
                                [by hypothesis given-the-vanishing]
                              @the-length-raises |
                                addN(succ(k), t) = succ(addN(k, t))
                                [using specialize peano.addSuccLeft(k, t)]
                              @the-run-peels |
                                convolution(p, q, b, succ(addN(k, t))) =
                                  addR(mulR(coeff(p, b), coeff(q, succ(addN(k, t)))),
                                  convolution(p, q, succ(b), addN(k, t)))
                                [using specialize convolutionSucc(p, q, b, addN(k, t))]
                              @the-gap-is-zero |
                                addN(b, ZERO) = b
                                [using specialize peano.addZeroRight(b)]
                              @the-second-index-splits |
                                addN(k, t) = addN(t, k)
                                [using specialize peano.addIsCommutative(k, t)]
                              @the-term-vanishes-at-the-gap |
                                mulR(coeff(p, addN(b, ZERO)),
                                  coeff(q, succ(addN(t, k)))) = zeroR
                                [by apply_at(ZERO, k) the-vanishing]
                              @the-term-vanishes-at-b |
                                mulR(coeff(p, b), coeff(q, succ(addN(t, k)))) = zeroR
                                [by rewrite the-gap-is-zero the-term-vanishes-at-the-gap]
                              @the-peeled-term-vanishes |
                                mulR(coeff(p, b), coeff(q, succ(addN(k, t)))) = zeroR
                                [by rewrite the-second-index-splits the-term-vanishes-at-b]
                              @the-vanishing-raises |
                                forall e, c: Nat;
                                  mulR(coeff(p, addN(succ(b), e)),
                                  coeff(q, succ(addN(t, c)))) = zeroR
                                [using specialize theVanishingRaisesTheBase(p, q, t, b)
                                  the-vanishing]
                              @the-tail-skips |
                                convolution(p, q, succ(b), addN(k, t)) =
                                  convolution(p, q, addN(succ(b), k), t)
                                [using specialize the-hypothesis(succ(b))
                                  the-vanishing-raises]
                              @the-shifted-base |
                                addN(succ(b), k) = succ(addN(b, k))
                                [using specialize peano.addSuccLeft(b, k)]
                              @the-raised-index |
                                addN(b, succ(k)) = succ(addN(b, k))
                                [using specialize peano.addSuccRight(b, k)]
                              @the-run-reduced |
                                convolution(p, q, b, succ(addN(k, t))) =
                                  addR(zeroR,
                                  convolution(p, q, succ(addN(b, k)), t))
                                [using simplify the-run-peels the-peeled-term-vanishes
                                  the-tail-skips the-shifted-base]
                              @zero-on-the-left |
                                addR(zeroR, convolution(p, q, succ(addN(b, k)), t)) =
                                  convolution(p, q, succ(addN(b, k)), t)
                                [using specialize addZeroLeftR(
                                  convolution(p, q, succ(addN(b, k)), t))]
                              @the-run-collapsed |
                                convolution(p, q, b, succ(addN(k, t))) =
                                  convolution(p, q, succ(addN(b, k)), t)
                                [using chain the-run-reduced zero-on-the-left]
                              @with-the-length |
                                convolution(p, q, b, addN(succ(k), t)) =
                                  convolution(p, q, succ(addN(b, k)), t)
                                [by rewrite the-length-raises the-run-collapsed]
                              @conclusion-the-step-skips |
                                convolution(p, q, b, addN(succ(k), t)) =
                                  convolution(p, q, addN(b, succ(k)), t)
                                [by rewrite the-raised-index with-the-length]
                            }
                          @the-vanishing-gives-it |
                            (forall e, c: Nat;
                              mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                              convolution(p, q, b, addN(succ(k), t)) =
                              convolution(p, q, addN(b, succ(k)), t)
                            [by discharge given-the-vanishing]
                        }
                      @all-bases |
                        (forall b: Nat;
                          (forall e, c: Nat;
                          mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                          convolution(p, q, b, addN(succ(k), t)) =
                          convolution(p, q, addN(b, succ(k)), t))
                        [by generalize generalize-b]
                    }
                  @the-hypothesis-gives-it |
                    (forall b: Nat;
                      (forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                      convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)) ->
                      (forall b: Nat;
                      (forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                      convolution(p, q, b, addN(succ(k), t)) =
                      convolution(p, q, addN(b, succ(k)), t))
                    [by discharge given-the-hypothesis]
                }
              @discharge-k |
                forall k: Nat;
                  (forall b: Nat;
                  (forall e, c: Nat;
                  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                  convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)) ->
                  (forall b: Nat;
                  (forall e, c: Nat;
                  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                  convolution(p, q, b, addN(succ(k), t)) =
                  convolution(p, q, addN(b, succ(k)), t))
                [by generalize generalize-k]
            }
          @discharge-t |
            forall t, k: Nat;
              (forall b: Nat;
              (forall e, c: Nat;
              mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
              convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)) ->
              (forall b: Nat;
              (forall e, c: Nat;
              mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
              convolution(p, q, b, addN(succ(k), t)) =
              convolution(p, q, addN(b, succ(k)), t))
            [by generalize generalize-t]
        }
      @discharge-q |
        forall q: Poly; forall t, k: Nat;
          (forall b: Nat;
          (forall e, c: Nat;
          mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
          convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)) ->
          (forall b: Nat;
          (forall e, c: Nat;
          mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
          convolution(p, q, b, addN(succ(k), t)) =
          convolution(p, q, addN(b, succ(k)), t))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall t, k: Nat;
      (forall b: Nat;
      (forall e, c: Nat;
      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
      convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)) ->
      (forall b: Nat;
      (forall e, c: Nat;
      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
      convolution(p, q, b, addN(succ(k), t)) =
      convolution(p, q, addN(b, succ(k)), t))
    [by generalize generalize-p]
qed

// Vanishing above base b implies vanishing above succ(b): succ(b) + e = b + succ(e).
theorem theVanishingRaisesTheBase: forall p, q: Poly; forall t, b: Nat;
  (forall e, c: Nat;
  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
  (forall e, c: Nat;
  mulR(coeff(p, addN(succ(b), e)), coeff(q, succ(addN(t, c)))) = zeroR)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-t |
            fix t: Nat {
              @generalize-b |
                fix b: Nat {
                  @given-the-vanishing |
                    assume forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)),
                      coeff(q, succ(addN(t, c)))) = zeroR {
                      @the-vanishing |
                        forall e, c: Nat;
                          mulR(coeff(p, addN(b, e)),
                          coeff(q, succ(addN(t, c)))) = zeroR
                        [by hypothesis given-the-vanishing]
                      @generalize-e |
                        fix e: Nat {
                          @generalize-c |
                            fix c: Nat {
                              @the-shifted-base |
                                addN(succ(b), e) = addN(b, succ(e))
                                [using specialize theSumsShift(b, e)]
                              @it-vanishes-at-the-shift |
                                mulR(coeff(p, addN(b, succ(e))),
                                  coeff(q, succ(addN(t, c)))) = zeroR
                                [by apply_at(succ(e), c) the-vanishing]
                              @conclusion-it-vanishes |
                                mulR(coeff(p, addN(succ(b), e)),
                                  coeff(q, succ(addN(t, c)))) = zeroR
                                [by rewrite the-shifted-base it-vanishes-at-the-shift]
                            }
                          @discharge-c |
                            forall c: Nat;
                              mulR(coeff(p, addN(succ(b), e)),
                              coeff(q, succ(addN(t, c)))) = zeroR
                            [by generalize generalize-c]
                        }
                      @all-gaps |
                        forall e, c: Nat;
                          mulR(coeff(p, addN(succ(b), e)),
                          coeff(q, succ(addN(t, c)))) = zeroR
                        [by generalize generalize-e]
                    }
                  @the-vanishing-gives-it |
                    (forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)),
                      coeff(q, succ(addN(t, c)))) = zeroR) ->
                      (forall e, c: Nat;
                      mulR(coeff(p, addN(succ(b), e)),
                      coeff(q, succ(addN(t, c)))) = zeroR)
                    [by discharge given-the-vanishing]
                }
              @discharge-b |
                forall b: Nat;
                  (forall e, c: Nat;
                  mulR(coeff(p, addN(b, e)),
                  coeff(q, succ(addN(t, c)))) = zeroR) ->
                  (forall e, c: Nat;
                  mulR(coeff(p, addN(succ(b), e)),
                  coeff(q, succ(addN(t, c)))) = zeroR)
                [by generalize generalize-b]
            }
          @discharge-t |
            forall t, b: Nat;
              (forall e, c: Nat;
              mulR(coeff(p, addN(b, e)),
              coeff(q, succ(addN(t, c)))) = zeroR) ->
              (forall e, c: Nat;
              mulR(coeff(p, addN(succ(b), e)),
              coeff(q, succ(addN(t, c)))) = zeroR)
            [by generalize generalize-t]
        }
      @discharge-q |
        forall q: Poly; forall t, b: Nat;
          (forall e, c: Nat;
          mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
          (forall e, c: Nat;
          mulR(coeff(p, addN(succ(b), e)), coeff(q, succ(addN(t, c)))) = zeroR)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall t, b: Nat;
      (forall e, c: Nat;
      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
      (forall e, c: Nat;
      mulR(coeff(p, addN(succ(b), e)), coeff(q, succ(addN(t, c)))) = zeroR)
    [by generalize generalize-p]
qed

// -- SKIPPING A PREFIX THE SECOND FACTOR KILLS ----------------------------------------------
// If every product of `p` at or above `b` with `q` STRICTLY above `t` vanishes, then a run of
// length `k + t` starting at `b` equals the run of length `t` starting at `b + k`:
//
//   convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)
//
// Why this hypothesis shape. The j-th prefix term pairs p at `b + j` with q at `(k+t) - j`,
// and for j < k that second index exceeds t — so it is q ABOVE t. Writing the condition with
// BOTH indices bounded BELOW (`addN(b, e)` and `succ(addN(t, c))`) names exactly that, with no
// subtraction. An earlier attempt quantified q universally, which is far too strong: the
// leading-coefficient caller has q vanish only above its degree, not everywhere.
theorem aRunSkipsAPrefixTheSecondFactorKills: forall p, q: Poly; forall t, k, b: Nat;
  (forall e, c: Nat;
  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
  convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-t |
            fix t: Nat {
              @base-case |
                forall b: Nat;
                  (forall e, c: Nat;
                  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                  convolution(p, q, b, addN(ZERO, t)) =
                  convolution(p, q, addN(b, ZERO), t)
                [using specialize thePrefixSkipBase(p, q, t)]
              @the-step |
                forall k, b: Nat;
                  (forall e, c: Nat;
                  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
                  convolution(p, q, b, addN(k, t)) =
                  convolution(p, q, addN(b, k), t)
                [using specialize theSkipByInduction(p, q, t) base-case]
            }
          @discharge-t |
            forall t: Nat; forall k, b: Nat;
              (forall e, c: Nat;
              mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
              convolution(p, q, b, addN(k, t)) =
              convolution(p, q, addN(b, k), t)
            [by generalize generalize-t]
        }
      @discharge-q |
        forall q: Poly; forall t, k, b: Nat;
          (forall e, c: Nat;
          mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
          convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall t, k, b: Nat;
      (forall e, c: Nat;
      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
      convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t)
    [by generalize generalize-p]
qed

// The induction itself, with the base supplied: the target quantifies the BASE inside so the
// step can fire it at succ(b).
theorem theSkipByInduction: forall p, q: Poly; forall t: Nat;
  (forall b: Nat;
  (forall e, c: Nat;
  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
  convolution(p, q, b, addN(ZERO, t)) = convolution(p, q, addN(b, ZERO), t)) ->
  (forall k, b: Nat;
  (forall e, c: Nat;
  mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
  convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-t |
            fix t: Nat {
              @given-the-base |
                assume forall b: Nat;
                  (forall e, c: Nat;
                  mulR(coeff(p, addN(b, e)),
                  coeff(q, succ(addN(t, c)))) = zeroR) ->
                  convolution(p, q, b, addN(ZERO, t)) =
                  convolution(p, q, addN(b, ZERO), t) {
                  @base-case |
                    forall b: Nat;
                      (forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)),
                      coeff(q, succ(addN(t, c)))) = zeroR) ->
                      convolution(p, q, b, addN(ZERO, t)) =
                      convolution(p, q, addN(b, ZERO), t)
                    [by hypothesis given-the-base]
                  @induction-step-for-all-k |
                    forall k: Nat;
                      (forall b: Nat;
                      (forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)),
                      coeff(q, succ(addN(t, c)))) = zeroR) ->
                      convolution(p, q, b, addN(k, t)) =
                      convolution(p, q, addN(b, k), t)) ->
                      (forall b: Nat;
                      (forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)),
                      coeff(q, succ(addN(t, c)))) = zeroR) ->
                      convolution(p, q, b, addN(succ(k), t)) =
                      convolution(p, q, addN(b, succ(k)), t))
                    [using specialize thePrefixSkipStepPerGap(p, q, t)]
                  @all-gaps |
                    forall k: Nat; forall b: Nat;
                      (forall e, c: Nat;
                      mulR(coeff(p, addN(b, e)),
                      coeff(q, succ(addN(t, c)))) = zeroR) ->
                      convolution(p, q, b, addN(k, t)) =
                      convolution(p, q, addN(b, k), t)
                    [using instantiation peano.induction((fun z: Nat => forall b: Nat; (forall e, c: Nat; mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) -> convolution(p, q, b, addN(z, t)) = convolution(p, q, addN(b, z), t))) base-case induction-step-for-all-k]
                }
              @the-base-gives-it |
                (forall b: Nat;
                  (forall e, c: Nat;
                  mulR(coeff(p, addN(b, e)),
                  coeff(q, succ(addN(t, c)))) = zeroR) ->
                  convolution(p, q, b, addN(ZERO, t)) =
                  convolution(p, q, addN(b, ZERO), t)) ->
                  (forall k, b: Nat;
                  (forall e, c: Nat;
                  mulR(coeff(p, addN(b, e)),
                  coeff(q, succ(addN(t, c)))) = zeroR) ->
                  convolution(p, q, b, addN(k, t)) =
                  convolution(p, q, addN(b, k), t))
                [by discharge given-the-base]
            }
          @discharge-t |
            forall t: Nat;
              (forall b: Nat;
              (forall e, c: Nat;
              mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
              convolution(p, q, b, addN(ZERO, t)) =
              convolution(p, q, addN(b, ZERO), t)) ->
              (forall k, b: Nat;
              (forall e, c: Nat;
              mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
              convolution(p, q, b, addN(k, t)) =
              convolution(p, q, addN(b, k), t))
            [by generalize generalize-t]
        }
      @discharge-q |
        forall q: Poly; forall t: Nat;
          (forall b: Nat;
          (forall e, c: Nat;
          mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
          convolution(p, q, b, addN(ZERO, t)) =
          convolution(p, q, addN(b, ZERO), t)) ->
          (forall k, b: Nat;
          (forall e, c: Nat;
          mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
          convolution(p, q, b, addN(k, t)) =
          convolution(p, q, addN(b, k), t))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall t: Nat;
      (forall b: Nat;
      (forall e, c: Nat;
      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
      convolution(p, q, b, addN(ZERO, t)) =
      convolution(p, q, addN(b, ZERO), t)) ->
      (forall k, b: Nat;
      (forall e, c: Nat;
      mulR(coeff(p, addN(b, e)), coeff(q, succ(addN(t, c)))) = zeroR) ->
      convolution(p, q, b, addN(k, t)) = convolution(p, q, addN(b, k), t))
    [by generalize generalize-p]
qed

// -- A RUN WHOSE FIRST FACTOR VANISHES ------------------------------------------------------
// The dual of `theZeroRunVanishes`: it is enough that p vanish at every index the RUN reads,
// not that p be the zero polynomial. The run from base `b` reads p at `b`, `succ(b)`, … so
// the hypothesis bounds the index BELOW, as `addN(b, e)` — no subtraction, and the induction
// can raise the base because every index above `succ(b)` is also above `b`.
theorem aRunWhoseFirstFactorVanishesIsZero: forall p, q: Poly; forall m, b: Nat;
  (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
  convolution(p, q, b, m) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @base-case |
            forall b: Nat;
              (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
              convolution(p, q, b, ZERO) = zeroR
            [using specialize theVanishingRunBase(p, q)]
          @induction-step-for-all-m |
            forall m: Nat;
              (forall b: Nat;
              (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
              convolution(p, q, b, m) = zeroR) ->
              (forall b: Nat;
              (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
              convolution(p, q, b, succ(m)) = zeroR)
            [using specialize theVanishingRunStep(p, q)]
          @all-lengths |
            forall m: Nat; forall b: Nat;
              (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
              convolution(p, q, b, m) = zeroR
            [using instantiation peano.induction((fun z: Nat => forall b: Nat; (forall e: Nat; coeff(p, addN(b, e)) = zeroR) -> convolution(p, q, b, z) = zeroR)) base-case induction-step-for-all-m]
        }
      @discharge-q |
        forall q: Poly; forall m, b: Nat;
          (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
          convolution(p, q, b, m) = zeroR
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, b: Nat;
      (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
      convolution(p, q, b, m) = zeroR
    [by generalize generalize-p]
qed

// The base: a single term, whose p-coefficient is the hypothesis at gap ZERO.
theorem theVanishingRunBase: forall p, q: Poly; forall b: Nat;
  (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
  convolution(p, q, b, ZERO) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-b |
            fix b: Nat {
              @given-the-vanishing |
                assume forall e: Nat; coeff(p, addN(b, e)) = zeroR {
                  @the-vanishing |
                    forall e: Nat; coeff(p, addN(b, e)) = zeroR
                    [by hypothesis given-the-vanishing]
                  @the-term |
                    convolution(p, q, b, ZERO) =
                      mulR(coeff(p, b), coeff(q, ZERO))
                    [using specialize convolutionZero(p, q, b)]
                  @the-gap-is-zero |
                    addN(b, ZERO) = b
                    [using specialize peano.addZeroRight(b)]
                  @the-coefficient-at-the-gap |
                    coeff(p, addN(b, ZERO)) = zeroR
                    [using specialize the-vanishing(ZERO)]
                  @the-coefficient-vanishes |
                    coeff(p, b) = zeroR
                    [by rewrite the-gap-is-zero the-coefficient-at-the-gap]
                  @the-product-vanishes |
                    mulR(zeroR, coeff(q, ZERO)) = zeroR
                    [using specialize mulZeroLeftR(coeff(q, ZERO))]
                  @conclusion-the-base-vanishes |
                    convolution(p, q, b, ZERO) = zeroR
                    [using simplify the-term the-coefficient-vanishes the-product-vanishes]
                }
              @the-vanishing-gives-it |
                (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
                  convolution(p, q, b, ZERO) = zeroR
                [by discharge given-the-vanishing]
            }
          @discharge-b |
            forall b: Nat;
              (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
              convolution(p, q, b, ZERO) = zeroR
            [by generalize generalize-b]
        }
      @discharge-q |
        forall q: Poly; forall b: Nat;
          (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
          convolution(p, q, b, ZERO) = zeroR
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall b: Nat;
      (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
      convolution(p, q, b, ZERO) = zeroR
    [by generalize generalize-p]
qed

// The step: the run peels its first term, whose p-coefficient is the hypothesis at gap ZERO,
// and the tail is the inductive hypothesis at base succ(b) — whose own vanishing condition
// follows because succ(b) + e is b + succ(e).
theorem theVanishingRunStep: forall p, q: Poly; forall m: Nat;
  (forall b: Nat;
  (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
  convolution(p, q, b, m) = zeroR) ->
  (forall b: Nat;
  (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
  convolution(p, q, b, succ(m)) = zeroR)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @given-the-hypothesis |
                assume forall b: Nat;
                  (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
                  convolution(p, q, b, m) = zeroR {
                  @the-hypothesis |
                    forall b: Nat;
                      (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
                      convolution(p, q, b, m) = zeroR
                    [by hypothesis given-the-hypothesis]
                  @generalize-b |
                    fix b: Nat {
                      @given-the-vanishing |
                        assume forall e: Nat; coeff(p, addN(b, e)) = zeroR {
                          @the-vanishing |
                            forall e: Nat; coeff(p, addN(b, e)) = zeroR
                            [by hypothesis given-the-vanishing]
                          @the-run-peels |
                            convolution(p, q, b, succ(m)) =
                              addR(mulR(coeff(p, b), coeff(q, succ(m))),
                              convolution(p, q, succ(b), m))
                            [using specialize convolutionSucc(p, q, b, m)]
                          @the-gap-is-zero |
                            addN(b, ZERO) = b
                            [using specialize peano.addZeroRight(b)]
                          @the-coefficient-at-the-gap |
                            coeff(p, addN(b, ZERO)) = zeroR
                            [using specialize the-vanishing(ZERO)]
                          @the-coefficient-vanishes |
                            coeff(p, b) = zeroR
                            [by rewrite the-gap-is-zero the-coefficient-at-the-gap]
                          @the-peeled-term-vanishes |
                            mulR(zeroR, coeff(q, succ(m))) = zeroR
                            [using specialize mulZeroLeftR(coeff(q, succ(m)))]
                          @the-vanishing-raises |
                            forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR
                            [using specialize theRaisedVanishing(p, b) the-vanishing]
                          @the-tail-vanishes |
                            convolution(p, q, succ(b), m) = zeroR
                            [using specialize the-hypothesis(succ(b)) the-vanishing-raises]
                          @the-run-reduced |
                            convolution(p, q, b, succ(m)) = addR(zeroR, zeroR)
                            [using simplify the-run-peels the-coefficient-vanishes
                              the-peeled-term-vanishes the-tail-vanishes]
                          @zero-plus-zero |
                            addR(zeroR, zeroR) = zeroR
                            [using specialize addZeroLeftR(zeroR)]
                          @conclusion-the-step-vanishes |
                            convolution(p, q, b, succ(m)) = zeroR
                            [using chain the-run-reduced zero-plus-zero]
                        }
                      @the-vanishing-gives-it |
                        (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
                          convolution(p, q, b, succ(m)) = zeroR
                        [by discharge given-the-vanishing]
                    }
                  @all-bases |
                    forall b: Nat;
                      (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
                      convolution(p, q, b, succ(m)) = zeroR
                    [by generalize generalize-b]
                }
              @the-hypothesis-gives-it |
                (forall b: Nat;
                  (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
                  convolution(p, q, b, m) = zeroR) ->
                  (forall b: Nat;
                  (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
                  convolution(p, q, b, succ(m)) = zeroR)
                [by discharge given-the-hypothesis]
            }
          @discharge-m |
            forall m: Nat;
              (forall b: Nat;
              (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
              convolution(p, q, b, m) = zeroR) ->
              (forall b: Nat;
              (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
              convolution(p, q, b, succ(m)) = zeroR)
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m: Nat;
          (forall b: Nat;
          (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
          convolution(p, q, b, m) = zeroR) ->
          (forall b: Nat;
          (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
          convolution(p, q, b, succ(m)) = zeroR)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m: Nat;
      (forall b: Nat;
      (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
      convolution(p, q, b, m) = zeroR) ->
      (forall b: Nat;
      (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
      convolution(p, q, b, succ(m)) = zeroR)
    [by generalize generalize-p]
qed

// Vanishing from base b up gives vanishing from succ(b) up: succ(b) + e = b + succ(e).
theorem theRaisedVanishing: forall p: Poly; forall b: Nat;
  (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
  (forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-b |
        fix b: Nat {
          @given-the-vanishing |
            assume forall e: Nat; coeff(p, addN(b, e)) = zeroR {
              @the-vanishing |
                forall e: Nat; coeff(p, addN(b, e)) = zeroR
                [by hypothesis given-the-vanishing]
              @generalize-e |
                fix e: Nat {
                  @the-indices-agree |
                    addN(succ(b), e) = addN(b, succ(e))
                    [using arithmetic(peano)]
                  @the-coefficient-at-the-raised-gap |
                    coeff(p, addN(b, succ(e))) = zeroR
                    [using specialize the-vanishing(succ(e))]
                  @conclusion-the-raised-coefficient-vanishes |
                    coeff(p, addN(succ(b), e)) = zeroR
                    [by rewrite the-indices-agree the-coefficient-at-the-raised-gap]
                }
              @all-gaps |
                forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR
                [by generalize generalize-e]
            }
          @the-vanishing-gives-it |
            (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
              (forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR)
            [by discharge given-the-vanishing]
        }
      @discharge-b |
        forall b: Nat;
          (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
          (forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR)
        [by generalize generalize-b]
    }
  @conclusion |
    forall p: Poly; forall b: Nat;
      (forall e: Nat; coeff(p, addN(b, e)) = zeroR) ->
      (forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR)
    [by generalize generalize-p]
qed

// -- A RUN ALL OF WHOSE TERMS VANISH --------------------------------------------------------
// The most general vanishing criterion, and the one a degree argument wants: it is enough
// that every PRODUCT the run reads be zero. The run from base `b` of length `m` reads the
// pairs (b, m), (b+1, m-1), … — an index pair whose SUM is `b + m` throughout. So the
// hypothesis is stated over pairs summing to `addN(b, m)`, which names every term the run
// touches with no subtraction. The induction raises the base and lowers the length together,
// and that sum is exactly what stays fixed.
theorem aRunWhoseTermsAllVanishIsZero: forall p, q: Poly; forall m, b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, m) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
  convolution(p, q, b, m) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @base-case |
            forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, ZERO) ->
              mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
              convolution(p, q, b, ZERO) = zeroR
            [using specialize theTermwiseBase(p, q)]
          @induction-step-for-all-m |
            forall m: Nat;
              (forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, m) ->
              mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
              convolution(p, q, b, m) = zeroR) ->
              (forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, succ(m)) ->
              mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
              convolution(p, q, b, succ(m)) = zeroR)
            [using specialize theTermwiseStep(p, q)]
          @all-lengths |
            forall m: Nat; forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, m) ->
              mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
              convolution(p, q, b, m) = zeroR
            [using instantiation peano.induction((fun z: Nat => forall b: Nat; (forall u, v: Nat; addN(u, v) = addN(b, z) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) -> convolution(p, q, b, z) = zeroR)) base-case induction-step-for-all-m]
        }
      @discharge-q |
        forall q: Poly; forall m, b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, m) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
          convolution(p, q, b, m) = zeroR
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, m) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
      convolution(p, q, b, m) = zeroR
    [by generalize generalize-p]
qed

// The base: one term, the pair (b, ZERO), whose sum is b + ZERO.
theorem theTermwiseBase: forall p, q: Poly; forall b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, ZERO) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
  convolution(p, q, b, ZERO) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-b |
            fix b: Nat {
              @given-the-terms-vanish |
                assume forall u, v: Nat;
                  addN(u, v) = addN(b, ZERO) ->
                  mulR(coeff(p, u), coeff(q, v)) = zeroR {
                  @the-terms-vanish |
                    forall u, v: Nat;
                      addN(u, v) = addN(b, ZERO) ->
                      mulR(coeff(p, u), coeff(q, v)) = zeroR
                    [by hypothesis given-the-terms-vanish]
                  @the-term |
                    convolution(p, q, b, ZERO) =
                      mulR(coeff(p, b), coeff(q, ZERO))
                    [using specialize convolutionZero(p, q, b)]
                  @the-pair-sums-right |
                    addN(b, ZERO) = addN(b, ZERO)
                    [by reflexivity]
                  @the-term-vanishes |
                    mulR(coeff(p, b), coeff(q, ZERO)) = zeroR
                    [using specialize the-terms-vanish(b, ZERO) the-pair-sums-right]
                  @conclusion-the-base-vanishes |
                    convolution(p, q, b, ZERO) = zeroR
                    [using chain the-term the-term-vanishes]
                }
              @the-terms-give-it |
                (forall u, v: Nat;
                  addN(u, v) = addN(b, ZERO) ->
                  mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                  convolution(p, q, b, ZERO) = zeroR
                [by discharge given-the-terms-vanish]
            }
          @discharge-b |
            forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, ZERO) ->
              mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
              convolution(p, q, b, ZERO) = zeroR
            [by generalize generalize-b]
        }
      @discharge-q |
        forall q: Poly; forall b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, ZERO) ->
          mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
          convolution(p, q, b, ZERO) = zeroR
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, ZERO) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
      convolution(p, q, b, ZERO) = zeroR
    [by generalize generalize-p]
qed

// The step: the run peels its first term, the pair (b, succ(m)), whose sum is b + succ(m);
// the tail is the hypothesis at base succ(b), whose pair sum succ(b) + m is the same number.
theorem theTermwiseStep: forall p, q: Poly; forall m: Nat;
  (forall b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, m) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
  convolution(p, q, b, m) = zeroR) ->
  (forall b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, succ(m)) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
  convolution(p, q, b, succ(m)) = zeroR)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @given-the-hypothesis |
                assume forall b: Nat;
                  (forall u, v: Nat;
                  addN(u, v) = addN(b, m) ->
                  mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                  convolution(p, q, b, m) = zeroR {
                  @the-hypothesis |
                    forall b: Nat;
                      (forall u, v: Nat;
                      addN(u, v) = addN(b, m) ->
                      mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                      convolution(p, q, b, m) = zeroR
                    [by hypothesis given-the-hypothesis]
                  @generalize-b |
                    fix b: Nat {
                      @given-the-terms-vanish |
                        assume forall u, v: Nat;
                          addN(u, v) = addN(b, succ(m)) ->
                          mulR(coeff(p, u), coeff(q, v)) = zeroR {
                          @the-terms-vanish |
                            forall u, v: Nat;
                              addN(u, v) = addN(b, succ(m)) ->
                              mulR(coeff(p, u), coeff(q, v)) = zeroR
                            [by hypothesis given-the-terms-vanish]
                          @the-run-peels |
                            convolution(p, q, b, succ(m)) =
                              addR(mulR(coeff(p, b), coeff(q, succ(m))),
                              convolution(p, q, succ(b), m))
                            [using specialize convolutionSucc(p, q, b, m)]
                          @the-peeled-pair-sums-right |
                            addN(b, succ(m)) = addN(b, succ(m))
                            [by reflexivity]
                          @the-peeled-term-vanishes |
                            mulR(coeff(p, b), coeff(q, succ(m))) = zeroR
                            [using specialize the-terms-vanish(b, succ(m))
                              the-peeled-pair-sums-right]
                          @the-tail-terms-vanish |
                            forall u, v: Nat;
                              addN(u, v) = addN(succ(b), m) ->
                              mulR(coeff(p, u), coeff(q, v)) = zeroR
                            [using specialize theTermSumShifts(p, q, m, b)
                              the-terms-vanish]
                          @the-tail-vanishes |
                            convolution(p, q, succ(b), m) = zeroR
                            [using specialize the-hypothesis(succ(b))
                              the-tail-terms-vanish]
                          @the-run-reduced |
                            convolution(p, q, b, succ(m)) = addR(zeroR, zeroR)
                            [using simplify the-run-peels the-peeled-term-vanishes
                              the-tail-vanishes]
                          @zero-plus-zero |
                            addR(zeroR, zeroR) = zeroR
                            [using specialize addZeroLeftR(zeroR)]
                          @conclusion-the-step-vanishes |
                            convolution(p, q, b, succ(m)) = zeroR
                            [using chain the-run-reduced zero-plus-zero]
                        }
                      @the-terms-give-it |
                        (forall u, v: Nat;
                          addN(u, v) = addN(b, succ(m)) ->
                          mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                          convolution(p, q, b, succ(m)) = zeroR
                        [by discharge given-the-terms-vanish]
                    }
                  @all-bases |
                    forall b: Nat;
                      (forall u, v: Nat;
                      addN(u, v) = addN(b, succ(m)) ->
                      mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                      convolution(p, q, b, succ(m)) = zeroR
                    [by generalize generalize-b]
                }
              @the-hypothesis-gives-it |
                (forall b: Nat;
                  (forall u, v: Nat;
                  addN(u, v) = addN(b, m) ->
                  mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                  convolution(p, q, b, m) = zeroR) ->
                  (forall b: Nat;
                  (forall u, v: Nat;
                  addN(u, v) = addN(b, succ(m)) ->
                  mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                  convolution(p, q, b, succ(m)) = zeroR)
                [by discharge given-the-hypothesis]
            }
          @discharge-m |
            forall m: Nat;
              (forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, m) ->
              mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
              convolution(p, q, b, m) = zeroR) ->
              (forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, succ(m)) ->
              mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
              convolution(p, q, b, succ(m)) = zeroR)
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m: Nat;
          (forall b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, m) ->
          mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
          convolution(p, q, b, m) = zeroR) ->
          (forall b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, succ(m)) ->
          mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
          convolution(p, q, b, succ(m)) = zeroR)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m: Nat;
      (forall b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, m) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
      convolution(p, q, b, m) = zeroR) ->
      (forall b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, succ(m)) ->
      mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
      convolution(p, q, b, succ(m)) = zeroR)
    [by generalize generalize-p]
qed

// succ(b) + m and b + succ(m) are the same number, so a condition on pairs summing to one is
// a condition on pairs summing to the other.
theorem theTermSumShifts: forall p, q: Poly; forall m, b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, succ(m)) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
  (forall u, v: Nat;
  addN(u, v) = addN(succ(b), m) -> mulR(coeff(p, u), coeff(q, v)) = zeroR)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @generalize-b |
                fix b: Nat {
                  @given-the-terms-vanish |
                    assume forall u, v: Nat;
                      addN(u, v) = addN(b, succ(m)) ->
                      mulR(coeff(p, u), coeff(q, v)) = zeroR {
                      @the-terms-vanish |
                        forall u, v: Nat;
                          addN(u, v) = addN(b, succ(m)) ->
                          mulR(coeff(p, u), coeff(q, v)) = zeroR
                        [by hypothesis given-the-terms-vanish]
                      @the-sums-agree |
                        addN(succ(b), m) = addN(b, succ(m))
                        [using arithmetic(peano)]
                      @generalize-u |
                        fix u: Nat {
                          @generalize-v |
                            fix v: Nat {
                              @given-the-pair-sums |
                                assume addN(u, v) = addN(succ(b), m) {
                                  @the-pair-sums |
                                    addN(u, v) = addN(succ(b), m)
                                    [by hypothesis given-the-pair-sums]
                                  @the-pair-sums-the-other-way |
                                    addN(u, v) = addN(b, succ(m))
                                    [using chain the-pair-sums the-sums-agree]
                                  @conclusion-this-term-vanishes |
                                    mulR(coeff(p, u), coeff(q, v)) = zeroR
                                    [using specialize the-terms-vanish(u, v)
                                      the-pair-sums-the-other-way]
                                }
                              @the-pair-gives-it |
                                addN(u, v) = addN(succ(b), m) ->
                                  mulR(coeff(p, u), coeff(q, v)) = zeroR
                                [by discharge given-the-pair-sums]
                            }
                          @discharge-v |
                            forall v: Nat;
                              addN(u, v) = addN(succ(b), m) ->
                              mulR(coeff(p, u), coeff(q, v)) = zeroR
                            [by generalize generalize-v]
                        }
                      @all-pairs |
                        forall u, v: Nat;
                          addN(u, v) = addN(succ(b), m) ->
                          mulR(coeff(p, u), coeff(q, v)) = zeroR
                        [by generalize generalize-u]
                    }
                  @the-terms-give-it |
                    (forall u, v: Nat;
                      addN(u, v) = addN(b, succ(m)) ->
                      mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                      (forall u, v: Nat;
                      addN(u, v) = addN(succ(b), m) ->
                      mulR(coeff(p, u), coeff(q, v)) = zeroR)
                    [by discharge given-the-terms-vanish]
                }
              @discharge-b |
                forall b: Nat;
                  (forall u, v: Nat;
                  addN(u, v) = addN(b, succ(m)) ->
                  mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                  (forall u, v: Nat;
                  addN(u, v) = addN(succ(b), m) ->
                  mulR(coeff(p, u), coeff(q, v)) = zeroR)
                [by generalize generalize-b]
            }
          @discharge-m |
            forall m, b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, succ(m)) ->
              mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
              (forall u, v: Nat;
              addN(u, v) = addN(succ(b), m) ->
              mulR(coeff(p, u), coeff(q, v)) = zeroR)
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m, b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, succ(m)) ->
          mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
          (forall u, v: Nat;
          addN(u, v) = addN(succ(b), m) ->
          mulR(coeff(p, u), coeff(q, v)) = zeroR)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, succ(m)) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
      (forall u, v: Nat;
      addN(u, v) = addN(succ(b), m) -> mulR(coeff(p, u), coeff(q, v)) = zeroR)
    [by generalize generalize-p]
qed

// -- A RUN WHOSE FIRST FACTOR DIES JUST ABOVE THE BASE --------------------------------------
// If p vanishes at every index STRICTLY above `b`, a run from `b` collapses to its own first
// term: that term reads p at `b` itself, and the tail starts at succ(b), where p is already
// gone. This is the leading-coefficient step's upper half, with the bound written as
// `succ(addN(b, e))` so no subtraction appears.
theorem aRunIsOneTermWhenTheFirstFactorDiesAbove: forall p, q: Poly; forall m, b: Nat;
  (forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR) ->
  convolution(p, q, b, m) = mulR(coeff(p, b), coeff(q, m))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @generalize-b |
                fix b: Nat {
                  @given-the-vanishing |
                    assume forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR {
                      @the-vanishing |
                        forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR
                        [by hypothesis given-the-vanishing]
                      @the-tail-is-dead |
                        forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR
                        [using specialize theStrictBoundIsARaisedBound(p, b)
                          the-vanishing]
                      @the-case-split |
                        m = ZERO or (exists w: Nat; m = succ(w))
                        [using specialize peano.zeroOrSucc(m)]
                      @when-the-length-is-zero |
                        assume m = ZERO {
                          @the-length-is-zero |
                            m = ZERO
                            [by hypothesis when-the-length-is-zero]
                          @the-single-term |
                            convolution(p, q, b, ZERO) =
                              mulR(coeff(p, b), coeff(q, ZERO))
                            [using specialize convolutionZero(p, q, b)]
                          @conclusion-zero-length-is-one-term |
                            convolution(p, q, b, m) =
                              mulR(coeff(p, b), coeff(q, m))
                            [by rewrite the-length-is-zero the-single-term]
                        }
                      @when-the-length-is-positive |
                        assume exists w: Nat; m = succ(w) {
                          @the-length-is-positive |
                            exists w: Nat; m = succ(w)
                            [by hypothesis when-the-length-is-positive]
                          @with-predecessor-w |
                            unpack w: Nat from the-length-is-positive {
                              @the-length-steps |
                                m = succ(w)
                                [by hypothesis with-predecessor-w]
                              @the-run-peels |
                                convolution(p, q, b, succ(w)) =
                                  addR(mulR(coeff(p, b), coeff(q, succ(w))),
                                  convolution(p, q, succ(b), w))
                                [using specialize convolutionSucc(p, q, b, w)]
                              @the-tail-vanishes |
                                convolution(p, q, succ(b), w) = zeroR
                                [using specialize
                                  aRunWhoseFirstFactorVanishesIsZero(p, q, w, succ(b))
                                  the-tail-is-dead]
                              @the-run-reduced |
                                convolution(p, q, b, succ(w)) =
                                  addR(mulR(coeff(p, b), coeff(q, succ(w))), zeroR)
                                [using simplify the-run-peels the-tail-vanishes]
                              @adding-nothing |
                                addR(mulR(coeff(p, b), coeff(q, succ(w))), zeroR) =
                                  mulR(coeff(p, b), coeff(q, succ(w)))
                                [using specialize addZeroRightR(
                                  mulR(coeff(p, b), coeff(q, succ(w))))]
                              @the-run-at-succ-w |
                                convolution(p, q, b, succ(w)) =
                                  mulR(coeff(p, b), coeff(q, succ(w)))
                                [using chain the-run-reduced adding-nothing]
                              @conclusion-positive-length-is-one-term |
                                convolution(p, q, b, m) =
                                  mulR(coeff(p, b), coeff(q, m))
                                [by rewrite the-length-steps the-run-at-succ-w]
                            }
                          @conclusion-the-positive-case |
                            convolution(p, q, b, m) =
                              mulR(coeff(p, b), coeff(q, m))
                            [by unpacked with-predecessor-w]
                        }
                      @the-run-is-one-term |
                        convolution(p, q, b, m) =
                          mulR(coeff(p, b), coeff(q, m))
                        [by common_conclusion the-case-split
                          when-the-length-is-zero when-the-length-is-positive]
                    }
                  @the-vanishing-gives-it |
                    (forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR) ->
                      convolution(p, q, b, m) = mulR(coeff(p, b), coeff(q, m))
                    [by discharge given-the-vanishing]
                }
              @discharge-b |
                forall b: Nat;
                  (forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR) ->
                  convolution(p, q, b, m) = mulR(coeff(p, b), coeff(q, m))
                [by generalize generalize-b]
            }
          @discharge-m |
            forall m, b: Nat;
              (forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR) ->
              convolution(p, q, b, m) = mulR(coeff(p, b), coeff(q, m))
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m, b: Nat;
          (forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR) ->
          convolution(p, q, b, m) = mulR(coeff(p, b), coeff(q, m))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, b: Nat;
      (forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR) ->
      convolution(p, q, b, m) = mulR(coeff(p, b), coeff(q, m))
    [by generalize generalize-p]
qed

// Vanishing strictly above b is vanishing from succ(b) up: succ(b) + e = succ(b + e).
theorem theStrictBoundIsARaisedBound: forall p: Poly; forall b: Nat;
  (forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR) ->
  (forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-b |
        fix b: Nat {
          @given-the-vanishing |
            assume forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR {
              @the-vanishing |
                forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR
                [by hypothesis given-the-vanishing]
              @generalize-e |
                fix e: Nat {
                  @the-indices-agree |
                    addN(succ(b), e) = succ(addN(b, e))
                    [using specialize peano.addSuccLeft(b, e)]
                  @the-coefficient-above |
                    coeff(p, succ(addN(b, e))) = zeroR
                    [using specialize the-vanishing(e)]
                  @conclusion-the-raised-coefficient-vanishes |
                    coeff(p, addN(succ(b), e)) = zeroR
                    [by rewrite the-indices-agree the-coefficient-above]
                }
              @all-gaps |
                forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR
                [by generalize generalize-e]
            }
          @the-vanishing-gives-it |
            (forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR) ->
              (forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR)
            [by discharge given-the-vanishing]
        }
      @discharge-b |
        forall b: Nat;
          (forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR) ->
          (forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR)
        [by generalize generalize-b]
    }
  @conclusion |
    forall p: Poly; forall b: Nat;
      (forall e: Nat; coeff(p, succ(addN(b, e))) = zeroR) ->
      (forall e: Nat; coeff(p, addN(succ(b), e)) = zeroR)
    [by generalize generalize-p]
qed

// -- A RUN LIES IN ANY CLOSED SET CONTAINING ITS TERMS --------------------------------------
// THE GENERIC CONVOLUTION-RIDING LEMMA. Everything above about runs — vanishing, one-term
// collapse — is this lemma at a particular predicate. It is stated as a SCHEMA because the
// predicate is the parameter: `prop` is any property of R that holds of every product the run
// reads and survives addR, and the conclusion is that it holds of the run.
//
// WHY IT EARNS ITS KEEP. Three separate ~300-line inductions in the ℤ[x]-inside-ℚ[x] cut
// proved exactly this for three different properties — "is an integer", "has this class
// mod N", "reduces to zero" — because no generic form existed. Each of those is now one
// instantiation. The run's index pairs always SUM to `b + m`, so the term hypothesis is
// written over pairs summing to that, with no subtraction.
theorem aRunLiesInAClosedSet(prop(R)): forall p, q: Poly; forall m, b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, m) -> prop(mulR(coeff(p, u), coeff(q, v)))) ->
  (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
  prop(convolution(p, q, b, m))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @the-base-schema |
            forall p2, q2: Poly; forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, ZERO) ->
              prop(mulR(coeff(p2, u), coeff(q2, v)))) ->
              (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
              prop(convolution(p2, q2, b, ZERO))
            [using instantiation theClosedRunBase((fun w: R => prop(w)))]
          @base-case |
            forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, ZERO) ->
              prop(mulR(coeff(p, u), coeff(q, v)))) ->
              (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
              prop(convolution(p, q, b, ZERO))
            [by apply_at(p, q) the-base-schema]
          @the-step-schema |
            forall p2, q2: Poly; forall m: Nat;
              (forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, m) ->
              prop(mulR(coeff(p2, u), coeff(q2, v)))) ->
              (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
              prop(convolution(p2, q2, b, m))) ->
              (forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, succ(m)) ->
              prop(mulR(coeff(p2, u), coeff(q2, v)))) ->
              (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
              prop(convolution(p2, q2, b, succ(m))))
            [using instantiation theClosedRunStep((fun w: R => prop(w)))]
          @induction-step-for-all-m |
            forall m: Nat;
              (forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, m) ->
              prop(mulR(coeff(p, u), coeff(q, v)))) ->
              (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
              prop(convolution(p, q, b, m))) ->
              (forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, succ(m)) ->
              prop(mulR(coeff(p, u), coeff(q, v)))) ->
              (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
              prop(convolution(p, q, b, succ(m))))
            [by apply_at(p, q) the-step-schema]
          @all-lengths |
            forall m: Nat; forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, m) ->
              prop(mulR(coeff(p, u), coeff(q, v)))) ->
              (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
              prop(convolution(p, q, b, m))
            [using instantiation peano.induction((fun z: Nat => forall b: Nat; (forall u, v: Nat; addN(u, v) = addN(b, z) -> prop(mulR(coeff(p, u), coeff(q, v)))) -> (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) -> prop(convolution(p, q, b, z)))) base-case induction-step-for-all-m]
        }
      @discharge-q |
        forall q: Poly; forall m, b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, m) -> prop(mulR(coeff(p, u), coeff(q, v)))) ->
          (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
          prop(convolution(p, q, b, m))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, m) -> prop(mulR(coeff(p, u), coeff(q, v)))) ->
      (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
      prop(convolution(p, q, b, m))
    [by generalize generalize-p]
qed

// The base: the run IS one term, the pair (b, ZERO), so the closure is not even used.
theorem theClosedRunBase(prop(R)): forall p, q: Poly; forall b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, ZERO) -> prop(mulR(coeff(p, u), coeff(q, v)))) ->
  (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
  prop(convolution(p, q, b, ZERO))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-b |
            fix b: Nat {
              @given-the-terms |
                assume forall u, v: Nat;
                  addN(u, v) = addN(b, ZERO) ->
                  prop(mulR(coeff(p, u), coeff(q, v))) {
                  @the-terms |
                    forall u, v: Nat;
                      addN(u, v) = addN(b, ZERO) ->
                      prop(mulR(coeff(p, u), coeff(q, v)))
                    [by hypothesis given-the-terms]
                  @given-the-closure |
                    assume forall s, t: R;
                      prop(s) -> prop(t) -> prop(addR(s, t)) {
                      @the-run-is-one-term |
                        convolution(p, q, b, ZERO) =
                          mulR(coeff(p, b), coeff(q, ZERO))
                        [using specialize convolutionZero(p, q, b)]
                      @the-pair-sums-right |
                        addN(b, ZERO) = addN(b, ZERO)
                        [by reflexivity]
                      @the-term-has-it |
                        prop(mulR(coeff(p, b), coeff(q, ZERO)))
                        [using specialize the-terms(b, ZERO) the-pair-sums-right]
                      @conclusion-the-base-has-it |
                        prop(convolution(p, q, b, ZERO))
                        [by rewrite the-run-is-one-term the-term-has-it]
                    }
                  @the-closure-gives-it |
                    (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
                      prop(convolution(p, q, b, ZERO))
                    [by discharge given-the-closure]
                }
              @the-terms-give-it |
                (forall u, v: Nat;
                  addN(u, v) = addN(b, ZERO) ->
                  prop(mulR(coeff(p, u), coeff(q, v)))) ->
                  (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
                  prop(convolution(p, q, b, ZERO))
                [by discharge given-the-terms]
            }
          @discharge-b |
            forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, ZERO) ->
              prop(mulR(coeff(p, u), coeff(q, v)))) ->
              (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
              prop(convolution(p, q, b, ZERO))
            [by generalize generalize-b]
        }
      @discharge-q |
        forall q: Poly; forall b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, ZERO) ->
          prop(mulR(coeff(p, u), coeff(q, v)))) ->
          (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
          prop(convolution(p, q, b, ZERO))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, ZERO) ->
      prop(mulR(coeff(p, u), coeff(q, v)))) ->
      (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
      prop(convolution(p, q, b, ZERO))
    [by generalize generalize-p]
qed

// The step: the run peels its top term — the pair (b, succ m) — and the tail is the
// hypothesis at base succ(b), whose pair sum succ(b) + m is the same number. The closure
// then joins the two.
theorem theClosedRunStep(prop(R)): forall p, q: Poly; forall m: Nat;
  (forall b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, m) -> prop(mulR(coeff(p, u), coeff(q, v)))) ->
  (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
  prop(convolution(p, q, b, m))) ->
  (forall b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, succ(m)) -> prop(mulR(coeff(p, u), coeff(q, v)))) ->
  (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
  prop(convolution(p, q, b, succ(m))))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @given-the-hypothesis |
                assume forall b: Nat;
                  (forall u, v: Nat;
                  addN(u, v) = addN(b, m) ->
                  prop(mulR(coeff(p, u), coeff(q, v)))) ->
                  (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
                  prop(convolution(p, q, b, m)) {
                  @the-hypothesis |
                    forall b: Nat;
                      (forall u, v: Nat;
                      addN(u, v) = addN(b, m) ->
                      prop(mulR(coeff(p, u), coeff(q, v)))) ->
                      (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
                      prop(convolution(p, q, b, m))
                    [by hypothesis given-the-hypothesis]
                  @the-shift-schema |
                    forall p2, q2: Poly; forall m2, b2: Nat;
                      (forall u, v: Nat;
                      addN(u, v) = addN(b2, succ(m2)) ->
                      prop(mulR(coeff(p2, u), coeff(q2, v)))) ->
                      (forall u, v: Nat;
                      addN(u, v) = addN(succ(b2), m2) ->
                      prop(mulR(coeff(p2, u), coeff(q2, v))))
                    [using instantiation
                      theClosedTermSumShifts((fun w: R => prop(w)))]
                  @generalize-b |
                    fix b: Nat {
                      @given-the-terms |
                        assume forall u, v: Nat;
                          addN(u, v) = addN(b, succ(m)) ->
                          prop(mulR(coeff(p, u), coeff(q, v))) {
                          @the-terms |
                            forall u, v: Nat;
                              addN(u, v) = addN(b, succ(m)) ->
                              prop(mulR(coeff(p, u), coeff(q, v)))
                            [by hypothesis given-the-terms]
                          @given-the-closure |
                            assume forall s, t: R;
                              prop(s) -> prop(t) -> prop(addR(s, t)) {
                              @the-closure |
                                forall s, t: R;
                                  prop(s) -> prop(t) -> prop(addR(s, t))
                                [by hypothesis given-the-closure]
                              @the-run-peels |
                                convolution(p, q, b, succ(m)) =
                                  addR(mulR(coeff(p, b), coeff(q, succ(m))),
                                  convolution(p, q, succ(b), m))
                                [using specialize convolutionSucc(p, q, b, m)]
                              @the-peeled-pair-sums-right |
                                addN(b, succ(m)) = addN(b, succ(m))
                                [by reflexivity]
                              @the-peeled-term-has-it |
                                prop(mulR(coeff(p, b), coeff(q, succ(m))))
                                [using specialize the-terms(b, succ(m))
                                  the-peeled-pair-sums-right]
                              @the-tail-terms-have-it |
                                forall u, v: Nat;
                                  addN(u, v) = addN(succ(b), m) ->
                                  prop(mulR(coeff(p, u), coeff(q, v)))
                                [using specialize
                                  the-shift-schema(p, q, m, b) the-terms]
                              @the-tail-has-it |
                                prop(convolution(p, q, succ(b), m))
                                [using specialize the-hypothesis(succ(b))
                                  the-tail-terms-have-it the-closure]
                              @the-sum-has-it |
                                prop(addR(mulR(coeff(p, b), coeff(q, succ(m))),
                                  convolution(p, q, succ(b), m)))
                                [using specialize the-closure(
                                  mulR(coeff(p, b), coeff(q, succ(m))),
                                  convolution(p, q, succ(b), m))
                                  the-peeled-term-has-it the-tail-has-it]
                              @conclusion-the-step-has-it |
                                prop(convolution(p, q, b, succ(m)))
                                [by rewrite the-run-peels the-sum-has-it]
                            }
                          @the-closure-gives-it |
                            (forall s, t: R;
                              prop(s) -> prop(t) -> prop(addR(s, t))) ->
                              prop(convolution(p, q, b, succ(m)))
                            [by discharge given-the-closure]
                        }
                      @the-terms-give-it |
                        (forall u, v: Nat;
                          addN(u, v) = addN(b, succ(m)) ->
                          prop(mulR(coeff(p, u), coeff(q, v)))) ->
                          (forall s, t: R;
                          prop(s) -> prop(t) -> prop(addR(s, t))) ->
                          prop(convolution(p, q, b, succ(m)))
                        [by discharge given-the-terms]
                    }
                  @all-bases |
                    forall b: Nat;
                      (forall u, v: Nat;
                      addN(u, v) = addN(b, succ(m)) ->
                      prop(mulR(coeff(p, u), coeff(q, v)))) ->
                      (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
                      prop(convolution(p, q, b, succ(m)))
                    [by generalize generalize-b]
                }
              @the-hypothesis-gives-it |
                (forall b: Nat;
                  (forall u, v: Nat;
                  addN(u, v) = addN(b, m) ->
                  prop(mulR(coeff(p, u), coeff(q, v)))) ->
                  (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
                  prop(convolution(p, q, b, m))) ->
                  (forall b: Nat;
                  (forall u, v: Nat;
                  addN(u, v) = addN(b, succ(m)) ->
                  prop(mulR(coeff(p, u), coeff(q, v)))) ->
                  (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
                  prop(convolution(p, q, b, succ(m))))
                [by discharge given-the-hypothesis]
            }
          @discharge-m |
            forall m: Nat;
              (forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, m) ->
              prop(mulR(coeff(p, u), coeff(q, v)))) ->
              (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
              prop(convolution(p, q, b, m))) ->
              (forall b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, succ(m)) ->
              prop(mulR(coeff(p, u), coeff(q, v)))) ->
              (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
              prop(convolution(p, q, b, succ(m))))
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m: Nat;
          (forall b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, m) -> prop(mulR(coeff(p, u), coeff(q, v)))) ->
          (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
          prop(convolution(p, q, b, m))) ->
          (forall b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, succ(m)) ->
          prop(mulR(coeff(p, u), coeff(q, v)))) ->
          (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
          prop(convolution(p, q, b, succ(m))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m: Nat;
      (forall b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, m) -> prop(mulR(coeff(p, u), coeff(q, v)))) ->
      (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
      prop(convolution(p, q, b, m))) ->
      (forall b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, succ(m)) ->
      prop(mulR(coeff(p, u), coeff(q, v)))) ->
      (forall s, t: R; prop(s) -> prop(t) -> prop(addR(s, t))) ->
      prop(convolution(p, q, b, succ(m))))
    [by generalize generalize-p]
qed

// succ(b) + m and b + succ(m) are the same number, so a condition on pairs summing to one is
// a condition on pairs summing to the other. The predicate-parametric twin of
// `theTermSumShifts`.
theorem theClosedTermSumShifts(prop(R)): forall p, q: Poly; forall m, b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, succ(m)) -> prop(mulR(coeff(p, u), coeff(q, v)))) ->
  (forall u, v: Nat;
  addN(u, v) = addN(succ(b), m) -> prop(mulR(coeff(p, u), coeff(q, v))))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @generalize-b |
                fix b: Nat {
                  @given-the-terms |
                    assume forall u, v: Nat;
                      addN(u, v) = addN(b, succ(m)) ->
                      prop(mulR(coeff(p, u), coeff(q, v))) {
                      @the-terms |
                        forall u, v: Nat;
                          addN(u, v) = addN(b, succ(m)) ->
                          prop(mulR(coeff(p, u), coeff(q, v)))
                        [by hypothesis given-the-terms]
                      @the-sums-agree |
                        addN(succ(b), m) = addN(b, succ(m))
                        [using arithmetic(peano)]
                      @generalize-u |
                        fix u: Nat {
                          @generalize-v |
                            fix v: Nat {
                              @given-the-pair-sums |
                                assume addN(u, v) = addN(succ(b), m) {
                                  @the-pair-sums |
                                    addN(u, v) = addN(succ(b), m)
                                    [by hypothesis given-the-pair-sums]
                                  @the-pair-sums-the-other-way |
                                    addN(u, v) = addN(b, succ(m))
                                    [using chain the-pair-sums the-sums-agree]
                                  @conclusion-this-term-has-it |
                                    prop(mulR(coeff(p, u), coeff(q, v)))
                                    [using specialize the-terms(u, v)
                                      the-pair-sums-the-other-way]
                                }
                              @the-pair-gives-it |
                                addN(u, v) = addN(succ(b), m) ->
                                  prop(mulR(coeff(p, u), coeff(q, v)))
                                [by discharge given-the-pair-sums]
                            }
                          @discharge-v |
                            forall v: Nat;
                              addN(u, v) = addN(succ(b), m) ->
                              prop(mulR(coeff(p, u), coeff(q, v)))
                            [by generalize generalize-v]
                        }
                      @all-pairs |
                        forall u, v: Nat;
                          addN(u, v) = addN(succ(b), m) ->
                          prop(mulR(coeff(p, u), coeff(q, v)))
                        [by generalize generalize-u]
                    }
                  @the-terms-give-it |
                    (forall u, v: Nat;
                      addN(u, v) = addN(b, succ(m)) ->
                      prop(mulR(coeff(p, u), coeff(q, v)))) ->
                      (forall u, v: Nat;
                      addN(u, v) = addN(succ(b), m) ->
                      prop(mulR(coeff(p, u), coeff(q, v))))
                    [by discharge given-the-terms]
                }
              @discharge-b |
                forall b: Nat;
                  (forall u, v: Nat;
                  addN(u, v) = addN(b, succ(m)) ->
                  prop(mulR(coeff(p, u), coeff(q, v)))) ->
                  (forall u, v: Nat;
                  addN(u, v) = addN(succ(b), m) ->
                  prop(mulR(coeff(p, u), coeff(q, v))))
                [by generalize generalize-b]
            }
          @discharge-m |
            forall m, b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, succ(m)) ->
              prop(mulR(coeff(p, u), coeff(q, v)))) ->
              (forall u, v: Nat;
              addN(u, v) = addN(succ(b), m) ->
              prop(mulR(coeff(p, u), coeff(q, v))))
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m, b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, succ(m)) ->
          prop(mulR(coeff(p, u), coeff(q, v)))) ->
          (forall u, v: Nat;
          addN(u, v) = addN(succ(b), m) ->
          prop(mulR(coeff(p, u), coeff(q, v))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, succ(m)) -> prop(mulR(coeff(p, u), coeff(q, v)))) ->
      (forall u, v: Nat;
      addN(u, v) = addN(succ(b), m) -> prop(mulR(coeff(p, u), coeff(q, v))))
    [by generalize generalize-p]
qed

// -- the closed-run schema, realized ---------------------------------------------------------
// `aRunLiesInAClosedSet` is a schema, so it is verified at each instantiation. This one
// realizes it at the vanishing predicate, reproving `aRunWhoseTermsAllVanishIsZero`'s
// statement through the generic machinery — which is both the schema's own gate (a schema
// nothing instantiates is never checked) and the demonstration `--library` needs.
theorem aVanishingRunIsZeroByTheSchema: forall p, q: Poly; forall m, b: Nat;
  (forall u, v: Nat;
  addN(u, v) = addN(b, m) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
  convolution(p, q, b, m) = zeroR
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-m |
            fix m: Nat {
              @generalize-b |
                fix b: Nat {
                  @given-the-terms |
                    assume forall u, v: Nat;
                      addN(u, v) = addN(b, m) ->
                      mulR(coeff(p, u), coeff(q, v)) = zeroR {
                      @the-terms |
                        forall u, v: Nat;
                          addN(u, v) = addN(b, m) ->
                          mulR(coeff(p, u), coeff(q, v)) = zeroR
                        [by hypothesis given-the-terms]
                      @the-schema-at-vanishing |
                        forall p2, q2: Poly; forall m2, b2: Nat;
                          (forall u, v: Nat;
                          addN(u, v) = addN(b2, m2) ->
                          mulR(coeff(p2, u), coeff(q2, v)) = zeroR) ->
                          (forall s, t: R;
                          s = zeroR -> t = zeroR -> addR(s, t) = zeroR) ->
                          convolution(p2, q2, b2, m2) = zeroR
                        [using instantiation
                          aRunLiesInAClosedSet((fun w: R => w = zeroR))]
                      @zero-is-closed-under-addition |
                        forall s, t: R;
                          s = zeroR -> t = zeroR -> addR(s, t) = zeroR
                        [by cite theZeroSumIsZero]
                      @conclusion-the-run-vanishes |
                        convolution(p, q, b, m) = zeroR
                        [using specialize the-schema-at-vanishing(p, q, m, b)
                          the-terms zero-is-closed-under-addition]
                    }
                  @the-terms-give-it |
                    (forall u, v: Nat;
                      addN(u, v) = addN(b, m) ->
                      mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                      convolution(p, q, b, m) = zeroR
                    [by discharge given-the-terms]
                }
              @discharge-b |
                forall b: Nat;
                  (forall u, v: Nat;
                  addN(u, v) = addN(b, m) ->
                  mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
                  convolution(p, q, b, m) = zeroR
                [by generalize generalize-b]
            }
          @discharge-m |
            forall m, b: Nat;
              (forall u, v: Nat;
              addN(u, v) = addN(b, m) ->
              mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
              convolution(p, q, b, m) = zeroR
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: Poly; forall m, b: Nat;
          (forall u, v: Nat;
          addN(u, v) = addN(b, m) ->
          mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
          convolution(p, q, b, m) = zeroR
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall m, b: Nat;
      (forall u, v: Nat;
      addN(u, v) = addN(b, m) -> mulR(coeff(p, u), coeff(q, v)) = zeroR) ->
      convolution(p, q, b, m) = zeroR
    [by generalize generalize-p]
qed

// Zero is closed under addition — the closure premise the schema wants, at the vanishing
// predicate.
theorem theZeroSumIsZero: forall s, t: R;
  s = zeroR -> t = zeroR -> addR(s, t) = zeroR
proof
  @generalize-s |
    fix s: R {
      @generalize-t |
        fix t: R {
          @given-s-vanishes |
            assume s = zeroR {
              @s-vanishes |
                s = zeroR
                [by hypothesis given-s-vanishes]
              @given-t-vanishes |
                assume t = zeroR {
                  @t-vanishes |
                    t = zeroR
                    [by hypothesis given-t-vanishes]
                  @zero-plus-zero |
                    addR(zeroR, zeroR) = zeroR
                    [using specialize addZeroLeftR(zeroR)]
                  @conclusion-the-sum-vanishes |
                    addR(s, t) = zeroR
                    [using simplify s-vanishes t-vanishes zero-plus-zero]
                }
              @t-gives-it |
                t = zeroR -> addR(s, t) = zeroR
                [by discharge given-t-vanishes]
            }
          @s-gives-it |
            s = zeroR -> t = zeroR -> addR(s, t) = zeroR
            [by discharge given-s-vanishes]
        }
      @discharge-t |
        forall t: R; s = zeroR -> t = zeroR -> addR(s, t) = zeroR
        [by generalize generalize-t]
    }
  @conclusion |
    forall s, t: R; s = zeroR -> t = zeroR -> addR(s, t) = zeroR
    [by generalize generalize-s]
qed

// -- MULTIPLICATION IS ASSOCIATIVE ----------------------------------------------------------
// Judson's §17.1 exercise, and the last structural law of R[x]. His display reindexes a
// double sum into a sum over triples j + k + l = i.
//
// THE FAMILY SHAPE, WHICH IS THE WHOLE DIFFICULTY. The output index `i` is held FIXED and a
// row is indexed by its COUNT, so lengthening a row ADDS a term and changes nothing else.
// That prefix property is what makes the increment lemma provable — raising the bound gains
// each present row exactly its last entry, and those gained entries form one anti-diagonal —
// and it is the pivot the whole proof turns on (`raisingTheBoundAddsTheDiagonal`); the outer
// induction on the bound is then three lines.
//
// A FAMILY THAT INDEXES BY THE PAIR TOTAL INSTEAD DOES NOT WORK, and the failure is quiet:
// if r's exponent is the row's LENGTH, lengthening a row shifts EVERY term's r-index rather
// than appending one, so the row is not a prefix family and no back-peel lemma is true of it.
// Checked the base case before writing the proof — `term(a,b,1)` against `term(a,b,0)` — which
// is the cheapest place to catch it.
//
// NO SUBTRACTION. The entry's r-index is `(i - j) - k`, which the pre-de-totalization version
// wrote as `sub(sub(i, j), k)` — making the axiom itself ill-formed under a guarded `sub`, and
// pushing two obligations through every statement. Here it is NAMED: `theCofactorIndex` with
// `succ`-pattern clauses, so the arithmetic lives at the one declaration that computes it and
// no theorem below mentions a difference. `theGapTo` and `theCofactorIndex` are total AND
// correct — they floor at ZERO by an explicit clause rather than by `sub`'s silent
// truncation — so they satisfy the no-totalizing rule rather than evading it.
func theGapTo(i: Nat, j: Nat) => Nat:
  theGapTo(i, ZERO) = i;
  theGapTo(succ(i), succ(j)) = theGapTo(i, j)

func theCofactorIndex(i: Nat, j: Nat, k: Nat) => Nat:
  theCofactorIndex(i, j, ZERO) = theGapTo(i, j);
  theCofactorIndex(i, j, succ(k)) = theGapTo(theGapTo(i, j), succ(k))

// term(j,k) at output index i = p_j q_k r_{(i-j)-k}.
func tripleTerm(p: Poly, q: Poly, r: Poly, i: Nat, j: Nat, k: Nat) => R:
  tripleTerm(p, q, r, i, j, k) =
  mulR(mulR(coeff(p, j), coeff(q, k)), coeff(r, theCofactorIndex(i, j, k)))

// one ROW: the first `n` entries at fixed j. A PREFIX family in `n`.
func tripleRow(p: Poly, q: Poly, r: Poly, i: Nat, j: Nat, n: Nat) => R:
  tripleRow(p, q, r, i, j, ZERO) = zeroR;
  tripleRow(p, q, r, i, j, succ(n)) =
  addR(tripleRow(p, q, r, i, j, n), tripleTerm(p, q, r, i, j, n))

// the first `c` entries of the m-th ANTI-DIAGONAL.
func tripleDiag(p: Poly, q: Poly, r: Poly, i: Nat, m: Nat, c: Nat) => R:
  tripleDiag(p, q, r, i, m, ZERO) = zeroR;
  tripleDiag(p, q, r, i, m, succ(c)) =
  addR(tripleDiag(p, q, r, i, m, c),
  tripleTerm(p, q, r, i, c, theGapTo(m, c)))

// the TRIANGLE: anti-diagonals 0..n-1, each complete.
func tripleTri(p: Poly, q: Poly, r: Poly, i: Nat, n: Nat) => R:
  tripleTri(p, q, r, i, ZERO) = zeroR;
  tripleTri(p, q, r, i, succ(n)) =
  addR(tripleTri(p, q, r, i, n), tripleDiag(p, q, r, i, n, succ(n)))

// the SHORTENED ROWS: rows 0..m-1, row j truncated at the gap to n.
func tripleRows(p: Poly, q: Poly, r: Poly, i: Nat, m: Nat, n: Nat) => R:
  tripleRows(p, q, r, i, ZERO, n) = zeroR;
  tripleRows(p, q, r, i, succ(m), n) =
  addR(tripleRows(p, q, r, i, m, n),
  tripleRow(p, q, r, i, m, theGapTo(n, m)))

// Raising the total raises the gap, for an index within it. The bound is genuine: at `j`
// beyond `n` both sides floor at ZERO and the identity fails, which is the same mathematical
// fact the `sub` spelling needed `succOfSubLeft` for — but here it is the ONLY hypothesis,
// with no well-formedness obligation riding along.
theorem theRaisedGapSteps: forall j, n: Nat;
  peano_order.less_or_equal(j, n) ->
  theGapTo(succ(n), j) = succ(theGapTo(n, j))
proof
  @base-case |
    forall n: Nat;
      peano_order.less_or_equal(ZERO, n) ->
      theGapTo(succ(n), ZERO) = succ(theGapTo(n, ZERO))
    [using specialize theRaisedGapBase]
  @induction-step-for-all-j |
    forall j: Nat;
      (forall n: Nat;
      peano_order.less_or_equal(j, n) ->
      theGapTo(succ(n), j) = succ(theGapTo(n, j))) ->
      (forall n: Nat;
      peano_order.less_or_equal(succ(j), n) ->
      theGapTo(succ(n), succ(j)) = succ(theGapTo(n, succ(j))))
    [using specialize theRaisedGapStep]
  @conclusion |
    forall j: Nat; forall n: Nat;
      peano_order.less_or_equal(j, n) ->
      theGapTo(succ(n), j) = succ(theGapTo(n, j))
    [using instantiation peano.induction((fun z: Nat => forall n: Nat; peano_order.less_or_equal(z, n) -> theGapTo(succ(n), z) = succ(theGapTo(n, z)))) base-case induction-step-for-all-j]
qed

// The base: both sides are succ(n), by the ZERO clause on each.
theorem theRaisedGapBase: forall n: Nat;
  peano_order.less_or_equal(ZERO, n) ->
  theGapTo(succ(n), ZERO) = succ(theGapTo(n, ZERO))
proof
  @generalize-n |
    fix n: Nat {
      @the-raised-gap |
        theGapTo(succ(n), ZERO) = succ(n)
        [using specialize theGapToAtZero(succ(n))]
      @the-gap |
        theGapTo(n, ZERO) = n
        [using specialize theGapToAtZero(n)]
      @the-equality |
        theGapTo(succ(n), ZERO) = succ(theGapTo(n, ZERO))
        [using simplify the-raised-gap the-gap]
      @conclusion-inner |
        peano_order.less_or_equal(ZERO, n) ->
          theGapTo(succ(n), ZERO) = succ(theGapTo(n, ZERO))
        [using tautology the-equality]
    }
  @conclusion |
    forall n: Nat;
      peano_order.less_or_equal(ZERO, n) ->
      theGapTo(succ(n), ZERO) = succ(theGapTo(n, ZERO))
    [by generalize generalize-n]
qed

// The step: at succ(j) the bound forces n to be a successor too, and both `theGapTo`
// applications then step down by their succ/succ clause onto the hypothesis.
theorem theRaisedGapStep: forall j: Nat;
  (forall n: Nat;
  peano_order.less_or_equal(j, n) ->
  theGapTo(succ(n), j) = succ(theGapTo(n, j))) ->
  (forall n: Nat;
  peano_order.less_or_equal(succ(j), n) ->
  theGapTo(succ(n), succ(j)) = succ(theGapTo(n, succ(j))))
proof
  @generalize-j |
    fix j: Nat {
      @given-the-hypothesis |
        assume forall n: Nat;
          peano_order.less_or_equal(j, n) ->
          theGapTo(succ(n), j) = succ(theGapTo(n, j)) {
          @the-hypothesis |
            forall n: Nat;
              peano_order.less_or_equal(j, n) ->
              theGapTo(succ(n), j) = succ(theGapTo(n, j))
            [by hypothesis given-the-hypothesis]
          @generalize-n |
            fix n: Nat {
              @given-the-bound |
                assume peano_order.less_or_equal(succ(j), n) {
                  @the-bound |
                    peano_order.less_or_equal(succ(j), n)
                    [by hypothesis given-the-bound]
                  @n-is-positive |
                    n = ZERO or (exists w: Nat; n = succ(w))
                    [using specialize peano.zeroOrSucc(n)]
                  @when-n-is-zero |
                    assume n = ZERO {
                      @n-is-zero |
                        n = ZERO
                        [by hypothesis when-n-is-zero]
                      @the-bound-at-zero |
                        peano_order.less_or_equal(succ(j), ZERO)
                        [by rewrite n-is-zero the-bound]
                      @nothing-is-below-zero |
                        not peano_order.less_or_equal(succ(j), ZERO)
                        [using specialize
                          peano_order.noSuccessorIsAtMostZero(j)]
                      @conclusion-vacuous |
                        theGapTo(succ(n), succ(j)) =
                          succ(theGapTo(n, succ(j)))
                        [by ex_falso the-bound-at-zero
                          nothing-is-below-zero]
                    }
                  @when-n-is-positive |
                    assume exists w: Nat; n = succ(w) {
                      @the-predecessor-exists |
                        exists w: Nat; n = succ(w)
                        [by hypothesis when-n-is-positive]
                      @with-the-predecessor |
                        unpack w: Nat from the-predecessor-exists {
                          @n-steps |
                            n = succ(w)
                            [by hypothesis with-the-predecessor]
                          @the-bound-steps |
                            peano_order.less_or_equal(succ(j), succ(w))
                            [by rewrite n-steps the-bound]
                          @j-is-within-w |
                            peano_order.less_or_equal(j, w)
                            [using specialize
                              peano_order.succReflectsAtMost(j, w)
                              the-bound-steps]
                          @the-hypothesis-at-w |
                            theGapTo(succ(w), j) = succ(theGapTo(w, j))
                            [using specialize the-hypothesis(w)
                              j-is-within-w]
                          @the-raised-gap-steps-down |
                            theGapTo(succ(succ(w)), succ(j)) =
                              theGapTo(succ(w), j)
                            [using specialize
                              theGapToSteps(succ(w), j)]
                          @the-gap-steps-down |
                            theGapTo(succ(w), succ(j)) = theGapTo(w, j)
                            [using specialize theGapToSteps(w, j)]
                          @the-equality-at-w |
                            theGapTo(succ(succ(w)), succ(j)) =
                              succ(theGapTo(succ(w), succ(j)))
                            [using simplify the-raised-gap-steps-down
                              the-hypothesis-at-w the-gap-steps-down]
                          @conclusion-positive |
                            theGapTo(succ(n), succ(j)) =
                              succ(theGapTo(n, succ(j)))
                            [by rewrite n-steps the-equality-at-w]
                        }
                      @conclusion-the-positive-case |
                        theGapTo(succ(n), succ(j)) =
                          succ(theGapTo(n, succ(j)))
                        [by unpacked with-the-predecessor]
                    }
                  @conclusion-either-way |
                    theGapTo(succ(n), succ(j)) =
                      succ(theGapTo(n, succ(j)))
                    [by common_conclusion n-is-positive
                      when-n-is-zero when-n-is-positive]
                }
              @the-bound-gives-it |
                peano_order.less_or_equal(succ(j), n) ->
                  theGapTo(succ(n), succ(j)) =
                  succ(theGapTo(n, succ(j)))
                [by discharge given-the-bound]
            }
          @all-totals |
            forall n: Nat;
              peano_order.less_or_equal(succ(j), n) ->
              theGapTo(succ(n), succ(j)) = succ(theGapTo(n, succ(j)))
            [by generalize generalize-n]
        }
      @the-hypothesis-gives-it |
        (forall n: Nat;
          peano_order.less_or_equal(j, n) ->
          theGapTo(succ(n), j) = succ(theGapTo(n, j))) ->
          (forall n: Nat;
          peano_order.less_or_equal(succ(j), n) ->
          theGapTo(succ(n), succ(j)) = succ(theGapTo(n, succ(j))))
        [by discharge given-the-hypothesis]
    }
  @conclusion |
    forall j: Nat;
      (forall n: Nat;
      peano_order.less_or_equal(j, n) ->
      theGapTo(succ(n), j) = succ(theGapTo(n, j))) ->
      (forall n: Nat;
      peano_order.less_or_equal(succ(j), n) ->
      theGapTo(succ(n), succ(j)) = succ(theGapTo(n, succ(j))))
    [by generalize generalize-j]
qed

// -- THE PIVOT: raising the bound adds one anti-diagonal ------------------------------------
// THE CONTENT OF THE WHOLE PROOF. Going from bound `n` to bound `succ(n)`, every row `j < m`
// gains exactly its last entry — `theRaisedGapSteps` makes its length one longer, and
// `tripleRowSucc` says a longer row is the row plus that entry — and the gained entries ARE
// the n-th anti-diagonal truncated at `m`. Induction on the ROW COUNT with the bound fixed,
// the guard travelling inside the property because the step needs it at `k` to raise the
// row's length.
theorem raisingTheBoundAddsTheDiagonal: forall p, q, r: Poly; forall i, n, m: Nat;
  peano_order.less_or_equal(m, succ(n)) ->
  tripleRows(p, q, r, i, m, succ(n)) =
  addR(tripleRows(p, q, r, i, m, n), tripleDiag(p, q, r, i, n, m))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @generalize-n |
                    fix n: Nat {
                      @base-case |
                        peano_order.less_or_equal(ZERO, succ(n)) ->
                          tripleRows(p, q, r, i, ZERO, succ(n)) =
                          addR(tripleRows(p, q, r, i, ZERO, n),
                          tripleDiag(p, q, r, i, n, ZERO))
                        [using specialize theIncrementBase(p, q, r, i, n)]
                      @induction-step-for-all-k |
                        forall k: Nat;
                          (peano_order.less_or_equal(k, succ(n)) ->
                          tripleRows(p, q, r, i, k, succ(n)) =
                          addR(tripleRows(p, q, r, i, k, n),
                          tripleDiag(p, q, r, i, n, k))) ->
                          (peano_order.less_or_equal(succ(k), succ(n)) ->
                          tripleRows(p, q, r, i, succ(k), succ(n)) =
                          addR(tripleRows(p, q, r, i, succ(k), n),
                          tripleDiag(p, q, r, i, n, succ(k))))
                        [using specialize theIncrementStep(p, q, r, i, n)]
                      @all-counts |
                        forall m: Nat;
                          peano_order.less_or_equal(m, succ(n)) ->
                          tripleRows(p, q, r, i, m, succ(n)) =
                          addR(tripleRows(p, q, r, i, m, n),
                          tripleDiag(p, q, r, i, n, m))
                        [using instantiation peano.induction((fun z: Nat => peano_order.less_or_equal(z, succ(n)) -> tripleRows(p, q, r, i, z, succ(n)) = addR(tripleRows(p, q, r, i, z, n), tripleDiag(p, q, r, i, n, z)))) base-case induction-step-for-all-k]
                    }
                  @discharge-n |
                    forall n, m: Nat;
                      peano_order.less_or_equal(m, succ(n)) ->
                      tripleRows(p, q, r, i, m, succ(n)) =
                      addR(tripleRows(p, q, r, i, m, n),
                      tripleDiag(p, q, r, i, n, m))
                    [by generalize generalize-n]
                }
              @discharge-i |
                forall i, n, m: Nat;
                  peano_order.less_or_equal(m, succ(n)) ->
                  tripleRows(p, q, r, i, m, succ(n)) =
                  addR(tripleRows(p, q, r, i, m, n),
                  tripleDiag(p, q, r, i, n, m))
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i, n, m: Nat;
              peano_order.less_or_equal(m, succ(n)) ->
              tripleRows(p, q, r, i, m, succ(n)) =
              addR(tripleRows(p, q, r, i, m, n),
              tripleDiag(p, q, r, i, n, m))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i, n, m: Nat;
          peano_order.less_or_equal(m, succ(n)) ->
          tripleRows(p, q, r, i, m, succ(n)) =
          addR(tripleRows(p, q, r, i, m, n),
          tripleDiag(p, q, r, i, n, m))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i, n, m: Nat;
      peano_order.less_or_equal(m, succ(n)) ->
      tripleRows(p, q, r, i, m, succ(n)) =
      addR(tripleRows(p, q, r, i, m, n), tripleDiag(p, q, r, i, n, m))
    [by generalize generalize-p]
qed

// The base: no rows on either side, and the empty diagonal, so all three are zeroR.
theorem theIncrementBase: forall p, q, r: Poly; forall i, n: Nat;
  peano_order.less_or_equal(ZERO, succ(n)) ->
  tripleRows(p, q, r, i, ZERO, succ(n)) =
  addR(tripleRows(p, q, r, i, ZERO, n), tripleDiag(p, q, r, i, n, ZERO))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @generalize-n |
                    fix n: Nat {
                      @the-empty-rows-raised |
                        tripleRows(p, q, r, i, ZERO, succ(n)) = zeroR
                        [using specialize
                          tripleRowsZero(p, q, r, i, succ(n))]
                      @the-empty-rows |
                        tripleRows(p, q, r, i, ZERO, n) = zeroR
                        [using specialize tripleRowsZero(p, q, r, i, n)]
                      @the-empty-diagonal |
                        tripleDiag(p, q, r, i, n, ZERO) = zeroR
                        [using specialize tripleDiagZero(p, q, r, i, n)]
                      @zero-plus-zero |
                        addR(zeroR, zeroR) = zeroR
                        [using specialize addZeroLeftR(zeroR)]
                      @the-equality |
                        tripleRows(p, q, r, i, ZERO, succ(n)) =
                          addR(tripleRows(p, q, r, i, ZERO, n),
                          tripleDiag(p, q, r, i, n, ZERO))
                        [using simplify the-empty-rows-raised
                          the-empty-rows the-empty-diagonal zero-plus-zero]
                      @conclusion-the-base |
                        peano_order.less_or_equal(ZERO, succ(n)) ->
                          tripleRows(p, q, r, i, ZERO, succ(n)) =
                          addR(tripleRows(p, q, r, i, ZERO, n),
                          tripleDiag(p, q, r, i, n, ZERO))
                        [using tautology the-equality]
                    }
                  @discharge-n |
                    forall n: Nat;
                      peano_order.less_or_equal(ZERO, succ(n)) ->
                      tripleRows(p, q, r, i, ZERO, succ(n)) =
                      addR(tripleRows(p, q, r, i, ZERO, n),
                      tripleDiag(p, q, r, i, n, ZERO))
                    [by generalize generalize-n]
                }
              @discharge-i |
                forall i, n: Nat;
                  peano_order.less_or_equal(ZERO, succ(n)) ->
                  tripleRows(p, q, r, i, ZERO, succ(n)) =
                  addR(tripleRows(p, q, r, i, ZERO, n),
                  tripleDiag(p, q, r, i, n, ZERO))
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i, n: Nat;
              peano_order.less_or_equal(ZERO, succ(n)) ->
              tripleRows(p, q, r, i, ZERO, succ(n)) =
              addR(tripleRows(p, q, r, i, ZERO, n),
              tripleDiag(p, q, r, i, n, ZERO))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i, n: Nat;
          peano_order.less_or_equal(ZERO, succ(n)) ->
          tripleRows(p, q, r, i, ZERO, succ(n)) =
          addR(tripleRows(p, q, r, i, ZERO, n),
          tripleDiag(p, q, r, i, n, ZERO))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i, n: Nat;
      peano_order.less_or_equal(ZERO, succ(n)) ->
      tripleRows(p, q, r, i, ZERO, succ(n)) =
      addR(tripleRows(p, q, r, i, ZERO, n), tripleDiag(p, q, r, i, n, ZERO))
    [by generalize generalize-p]
qed

// The step. Peel the (k+1)-st row off each side and the (k+1)-st entry off the diagonal:
//
//   rows(m+1, n+1) = rows(m, n+1) + row(m, gapTo(n+1, m))
//   rows(m+1, n)   = rows(m, n)   + row(m, gapTo(n, m))
//   diag(n, m+1)   = diag(n, m)   + term(m, gapTo(n, m))
//
// The raised row is one longer than the base row — `theRaisedGapSteps` at `k <= n`, then
// `tripleRowSucc` — so it is the base row plus exactly the entry the diagonal gained. The
// hypothesis handles the rest, and the four summands reassociate.
theorem theIncrementStep: forall p, q, r: Poly; forall i, n: Nat;
  forall k: Nat;
  (peano_order.less_or_equal(k, succ(n)) ->
  tripleRows(p, q, r, i, k, succ(n)) =
  addR(tripleRows(p, q, r, i, k, n), tripleDiag(p, q, r, i, n, k))) ->
  (peano_order.less_or_equal(succ(k), succ(n)) ->
  tripleRows(p, q, r, i, succ(k), succ(n)) =
  addR(tripleRows(p, q, r, i, succ(k), n),
  tripleDiag(p, q, r, i, n, succ(k))))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @generalize-n |
                    fix n: Nat {
                      @generalize-k |
                        fix k: Nat {
                          @given-the-hypothesis |
                            assume peano_order.less_or_equal(k, succ(n)) ->
                              tripleRows(p, q, r, i, k, succ(n)) =
                              addR(tripleRows(p, q, r, i, k, n),
                              tripleDiag(p, q, r, i, n, k)) {
                              @the-hypothesis |
                                peano_order.less_or_equal(k, succ(n)) ->
                                  tripleRows(p, q, r, i, k, succ(n)) =
                                  addR(tripleRows(p, q, r, i, k, n),
                                  tripleDiag(p, q, r, i, n, k))
                                [by hypothesis given-the-hypothesis]
                              @given-the-raised-bound |
                                assume peano_order.less_or_equal(succ(k),
                                  succ(n)) {
                                  @the-raised-bound |
                                    peano_order.less_or_equal(succ(k),
                                      succ(n))
                                    [by hypothesis given-the-raised-bound]
                                  @k-is-within-n |
                                    peano_order.less_or_equal(k, n)
                                    [using specialize
                                      peano_order.succReflectsAtMost(k, n)
                                      the-raised-bound]
                                  @k-is-below-its-successor |
                                    peano_order.less_or_equal(k, succ(k))
                                    [using specialize
                                      peano_order.aNatIsAtMostItsSuccessor(k)]
                                  @k-is-within-succ-n |
                                    peano_order.less_or_equal(k, succ(n))
                                    [using specialize
                                      peano_order.lessOrEqualTransitive(k,
                                      succ(k), succ(n))
                                      k-is-below-its-successor
                                      the-raised-bound]
                                  @the-hypothesis-applies |
                                    tripleRows(p, q, r, i, k, succ(n)) =
                                      addR(tripleRows(p, q, r, i, k, n),
                                      tripleDiag(p, q, r, i, n, k))
                                    [using tautology the-hypothesis
                                      k-is-within-succ-n]
                                  // the three peels
                                  @the-raised-side-peels |
                                    tripleRows(p, q, r, i, succ(k),
                                      succ(n)) =
                                      addR(tripleRows(p, q, r, i, k,
                                      succ(n)),
                                      tripleRow(p, q, r, i, k,
                                      theGapTo(succ(n), k)))
                                    [using specialize
                                      tripleRowsSucc(p, q, r, i, k, succ(n))]
                                  @the-base-side-peels |
                                    tripleRows(p, q, r, i, succ(k), n) =
                                      addR(tripleRows(p, q, r, i, k, n),
                                      tripleRow(p, q, r, i, k,
                                      theGapTo(n, k)))
                                    [using specialize
                                      tripleRowsSucc(p, q, r, i, k, n)]
                                  @the-diagonal-peels |
                                    tripleDiag(p, q, r, i, n, succ(k)) =
                                      addR(tripleDiag(p, q, r, i, n, k),
                                      tripleTerm(p, q, r, i, k,
                                      theGapTo(n, k)))
                                    [using specialize
                                      tripleDiagSucc(p, q, r, i, n, k)]
                                  // the raised row is one longer
                                  @the-raised-length |
                                    theGapTo(succ(n), k) =
                                      succ(theGapTo(n, k))
                                    [using specialize
                                      theRaisedGapSteps(k, n) k-is-within-n]
                                  @the-longer-row-peels |
                                    tripleRow(p, q, r, i, k,
                                      succ(theGapTo(n, k))) =
                                      addR(tripleRow(p, q, r, i, k,
                                      theGapTo(n, k)),
                                      tripleTerm(p, q, r, i, k,
                                      theGapTo(n, k)))
                                    [using specialize
                                      tripleRowSucc(p, q, r, i, k,
                                      theGapTo(n, k))]
                                  @the-raised-row-gains-its-last-entry |
                                    tripleRow(p, q, r, i, k,
                                      theGapTo(succ(n), k)) =
                                      addR(tripleRow(p, q, r, i, k,
                                      theGapTo(n, k)),
                                      tripleTerm(p, q, r, i, k,
                                      theGapTo(n, k)))
                                    [by rewrite the-raised-length
                                      the-longer-row-peels]
                                  // substitute into each side
                                  @the-raised-side-expanded |
                                    tripleRows(p, q, r, i, succ(k),
                                      succ(n)) =
                                      addR(addR(tripleRows(p, q, r, i, k, n),
                                      tripleDiag(p, q, r, i, n, k)),
                                      addR(tripleRow(p, q, r, i, k,
                                      theGapTo(n, k)),
                                      tripleTerm(p, q, r, i, k,
                                      theGapTo(n, k))))
                                    [using simplify the-raised-side-peels
                                      the-hypothesis-applies
                                      the-raised-row-gains-its-last-entry]
                                  @the-target-side-expanded |
                                    addR(tripleRows(p, q, r, i, succ(k), n),
                                      tripleDiag(p, q, r, i, n, succ(k))) =
                                      addR(addR(tripleRows(p, q, r, i, k, n),
                                      tripleRow(p, q, r, i, k,
                                      theGapTo(n, k))),
                                      addR(tripleDiag(p, q, r, i, n, k),
                                      tripleTerm(p, q, r, i, k,
                                      theGapTo(n, k))))
                                    [using simplify the-base-side-peels
                                      the-diagonal-peels]
                                  // the SAME four summands, reassociated
                                  @the-two-expansions-agree |
                                    addR(addR(tripleRows(p, q, r, i, k, n),
                                      tripleDiag(p, q, r, i, n, k)),
                                      addR(tripleRow(p, q, r, i, k,
                                      theGapTo(n, k)),
                                      tripleTerm(p, q, r, i, k,
                                      theGapTo(n, k)))) =
                                      addR(addR(tripleRows(p, q, r, i, k, n),
                                      tripleRow(p, q, r, i, k,
                                      theGapTo(n, k))),
                                      addR(tripleDiag(p, q, r, i, n, k),
                                      tripleTerm(p, q, r, i, k,
                                      theGapTo(n, k))))
                                    [using assoc_commut(addIsAssociativeR,
                                      addIsCommutativeR, addLeftSwapR)]
                                  @the-target-side-flipped |
                                    addR(addR(tripleRows(p, q, r, i, k, n),
                                      tripleRow(p, q, r, i, k,
                                      theGapTo(n, k))),
                                      addR(tripleDiag(p, q, r, i, n, k),
                                      tripleTerm(p, q, r, i, k,
                                      theGapTo(n, k)))) =
                                      addR(tripleRows(p, q, r, i, succ(k),
                                      n),
                                      tripleDiag(p, q, r, i, n, succ(k)))
                                    [by symmetry the-target-side-expanded]
                                  @conclusion-the-step |
                                    tripleRows(p, q, r, i, succ(k),
                                      succ(n)) =
                                      addR(tripleRows(p, q, r, i, succ(k),
                                      n),
                                      tripleDiag(p, q, r, i, n, succ(k)))
                                    [using chain the-raised-side-expanded
                                      the-two-expansions-agree
                                      the-target-side-flipped]
                                }
                              @the-bound-gives-it |
                                peano_order.less_or_equal(succ(k),
                                  succ(n)) ->
                                  tripleRows(p, q, r, i, succ(k), succ(n)) =
                                  addR(tripleRows(p, q, r, i, succ(k), n),
                                  tripleDiag(p, q, r, i, n, succ(k)))
                                [by discharge given-the-raised-bound]
                            }
                          @the-hypothesis-gives-it |
                            (peano_order.less_or_equal(k, succ(n)) ->
                              tripleRows(p, q, r, i, k, succ(n)) =
                              addR(tripleRows(p, q, r, i, k, n),
                              tripleDiag(p, q, r, i, n, k))) ->
                              (peano_order.less_or_equal(succ(k),
                              succ(n)) ->
                              tripleRows(p, q, r, i, succ(k), succ(n)) =
                              addR(tripleRows(p, q, r, i, succ(k), n),
                              tripleDiag(p, q, r, i, n, succ(k))))
                            [by discharge given-the-hypothesis]
                        }
                      @all-counts |
                        forall k: Nat;
                          (peano_order.less_or_equal(k, succ(n)) ->
                          tripleRows(p, q, r, i, k, succ(n)) =
                          addR(tripleRows(p, q, r, i, k, n),
                          tripleDiag(p, q, r, i, n, k))) ->
                          (peano_order.less_or_equal(succ(k), succ(n)) ->
                          tripleRows(p, q, r, i, succ(k), succ(n)) =
                          addR(tripleRows(p, q, r, i, succ(k), n),
                          tripleDiag(p, q, r, i, n, succ(k))))
                        [by generalize generalize-k]
                    }
                  @discharge-n |
                    forall n: Nat; forall k: Nat;
                      (peano_order.less_or_equal(k, succ(n)) ->
                      tripleRows(p, q, r, i, k, succ(n)) =
                      addR(tripleRows(p, q, r, i, k, n),
                      tripleDiag(p, q, r, i, n, k))) ->
                      (peano_order.less_or_equal(succ(k), succ(n)) ->
                      tripleRows(p, q, r, i, succ(k), succ(n)) =
                      addR(tripleRows(p, q, r, i, succ(k), n),
                      tripleDiag(p, q, r, i, n, succ(k))))
                    [by generalize generalize-n]
                }
              @discharge-i |
                forall i, n: Nat; forall k: Nat;
                  (peano_order.less_or_equal(k, succ(n)) ->
                  tripleRows(p, q, r, i, k, succ(n)) =
                  addR(tripleRows(p, q, r, i, k, n),
                  tripleDiag(p, q, r, i, n, k))) ->
                  (peano_order.less_or_equal(succ(k), succ(n)) ->
                  tripleRows(p, q, r, i, succ(k), succ(n)) =
                  addR(tripleRows(p, q, r, i, succ(k), n),
                  tripleDiag(p, q, r, i, n, succ(k))))
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i, n: Nat; forall k: Nat;
              (peano_order.less_or_equal(k, succ(n)) ->
              tripleRows(p, q, r, i, k, succ(n)) =
              addR(tripleRows(p, q, r, i, k, n),
              tripleDiag(p, q, r, i, n, k))) ->
              (peano_order.less_or_equal(succ(k), succ(n)) ->
              tripleRows(p, q, r, i, succ(k), succ(n)) =
              addR(tripleRows(p, q, r, i, succ(k), n),
              tripleDiag(p, q, r, i, n, succ(k))))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i, n: Nat; forall k: Nat;
          (peano_order.less_or_equal(k, succ(n)) ->
          tripleRows(p, q, r, i, k, succ(n)) =
          addR(tripleRows(p, q, r, i, k, n),
          tripleDiag(p, q, r, i, n, k))) ->
          (peano_order.less_or_equal(succ(k), succ(n)) ->
          tripleRows(p, q, r, i, succ(k), succ(n)) =
          addR(tripleRows(p, q, r, i, succ(k), n),
          tripleDiag(p, q, r, i, n, succ(k))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i, n: Nat; forall k: Nat;
      (peano_order.less_or_equal(k, succ(n)) ->
      tripleRows(p, q, r, i, k, succ(n)) =
      addR(tripleRows(p, q, r, i, k, n),
      tripleDiag(p, q, r, i, n, k))) ->
      (peano_order.less_or_equal(succ(k), succ(n)) ->
      tripleRows(p, q, r, i, succ(k), succ(n)) =
      addR(tripleRows(p, q, r, i, succ(k), n),
      tripleDiag(p, q, r, i, n, succ(k))))
    [by generalize generalize-p]
qed

// theGapTo(n, n) = ZERO: no slack remains when the index reaches the total. This is what
// makes the (n+1)-st row empty at bound n, so the shortened rows stop growing exactly where
// the triangle does.
theorem theGapToSelfVanishes: forall n: Nat; theGapTo(n, n) = ZERO
proof
  @base-case |
    theGapTo(ZERO, ZERO) = ZERO
    [using specialize theGapToAtZero(ZERO)]
  @induction-step |
    fix k: Nat {
      @given-the-hypothesis |
        assume theGapTo(k, k) = ZERO {
          @the-hypothesis |
            theGapTo(k, k) = ZERO
            [by hypothesis given-the-hypothesis]
          @the-gap-steps-down |
            theGapTo(succ(k), succ(k)) = theGapTo(k, k)
            [using specialize theGapToSteps(k, k)]
          @conclusion-at-succ-k |
            theGapTo(succ(k), succ(k)) = ZERO
            [using chain the-gap-steps-down the-hypothesis]
        }
      @induction-step-at-k |
        (theGapTo(k, k) = ZERO) -> (theGapTo(succ(k), succ(k)) = ZERO)
        [by discharge given-the-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat;
      (theGapTo(k, k) = ZERO) -> (theGapTo(succ(k), succ(k)) = ZERO)
    [by generalize induction-step]
  @conclusion |
    forall n: Nat; theGapTo(n, n) = ZERO
    [using instantiation peano.induction((fun z: Nat => theGapTo(z, z) = ZERO)) base-case induction-step-for-all-k]
qed

// -- THE TRIANGLE IS THE SHORTENED ROWS ----------------------------------------------------
// The outer induction, three lines on top of the pivot: the triangle gains its n-th
// anti-diagonal (`tripleTriSucc`), the rows gain exactly that anti-diagonal
// (`raisingTheBoundAddsTheDiagonal` at m = succ n), and the shorter row collection at bound n
// IS the triangle at n — because the (n+1)-st row is empty there, `theGapTo(n, n)` being ZERO.
theorem theTriangleIsTheShortenedRows: forall p, q, r: Poly; forall i, n: Nat;
  tripleTri(p, q, r, i, n) = tripleRows(p, q, r, i, n, n)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @base-case |
                    tripleTri(p, q, r, i, ZERO) =
                      tripleRows(p, q, r, i, ZERO, ZERO)
                    [using specialize theTriangleRowsBase(p, q, r, i)]
                  @induction-step-for-all-k |
                    forall k: Nat;
                      (tripleTri(p, q, r, i, k) =
                      tripleRows(p, q, r, i, k, k)) ->
                      (tripleTri(p, q, r, i, succ(k)) =
                      tripleRows(p, q, r, i, succ(k), succ(k)))
                    [using specialize theTriangleRowsStep(p, q, r, i)]
                  @all-bounds |
                    forall n: Nat;
                      tripleTri(p, q, r, i, n) =
                      tripleRows(p, q, r, i, n, n)
                    [using instantiation peano.induction((fun z: Nat => tripleTri(p, q, r, i, z) = tripleRows(p, q, r, i, z, z))) base-case induction-step-for-all-k]
                }
              @discharge-i |
                forall i, n: Nat;
                  tripleTri(p, q, r, i, n) = tripleRows(p, q, r, i, n, n)
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i, n: Nat;
              tripleTri(p, q, r, i, n) = tripleRows(p, q, r, i, n, n)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i, n: Nat;
          tripleTri(p, q, r, i, n) = tripleRows(p, q, r, i, n, n)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i, n: Nat;
      tripleTri(p, q, r, i, n) = tripleRows(p, q, r, i, n, n)
    [by generalize generalize-p]
qed

// The base: both are empty at bound ZERO.
theorem theTriangleRowsBase: forall p, q, r: Poly; forall i: Nat;
  tripleTri(p, q, r, i, ZERO) = tripleRows(p, q, r, i, ZERO, ZERO)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @the-empty-triangle |
                    tripleTri(p, q, r, i, ZERO) = zeroR
                    [using specialize tripleTriZero(p, q, r, i)]
                  @the-empty-rows |
                    tripleRows(p, q, r, i, ZERO, ZERO) = zeroR
                    [using specialize tripleRowsZero(p, q, r, i, ZERO)]
                  @conclusion-the-base |
                    tripleTri(p, q, r, i, ZERO) =
                      tripleRows(p, q, r, i, ZERO, ZERO)
                    [using simplify the-empty-triangle the-empty-rows]
                }
              @discharge-i |
                forall i: Nat;
                  tripleTri(p, q, r, i, ZERO) =
                  tripleRows(p, q, r, i, ZERO, ZERO)
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i: Nat;
              tripleTri(p, q, r, i, ZERO) =
              tripleRows(p, q, r, i, ZERO, ZERO)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i: Nat;
          tripleTri(p, q, r, i, ZERO) =
          tripleRows(p, q, r, i, ZERO, ZERO)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i: Nat;
      tripleTri(p, q, r, i, ZERO) = tripleRows(p, q, r, i, ZERO, ZERO)
    [by generalize generalize-p]
qed

// The step: the triangle gains its k-th anti-diagonal; the rows gain exactly that
// anti-diagonal by the pivot at m = succ(k); and the shorter row collection at bound k is the
// triangle at k, because its extra row has length `theGapTo(k, k)` = ZERO and so contributes
// nothing.
theorem theTriangleRowsStep: forall p, q, r: Poly; forall i: Nat;
  forall k: Nat;
  (tripleTri(p, q, r, i, k) = tripleRows(p, q, r, i, k, k)) ->
  (tripleTri(p, q, r, i, succ(k)) =
  tripleRows(p, q, r, i, succ(k), succ(k)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @generalize-k |
                    fix k: Nat {
                      @given-the-hypothesis |
                        assume tripleTri(p, q, r, i, k) =
                          tripleRows(p, q, r, i, k, k) {
                          @the-hypothesis |
                            tripleTri(p, q, r, i, k) =
                              tripleRows(p, q, r, i, k, k)
                            [by hypothesis given-the-hypothesis]
                          @the-triangle-grows |
                            tripleTri(p, q, r, i, succ(k)) =
                              addR(tripleTri(p, q, r, i, k),
                              tripleDiag(p, q, r, i, k, succ(k)))
                            [using specialize tripleTriSucc(p, q, r, i, k)]
                          @succ-k-is-at-most-itself |
                            peano_order.less_or_equal(succ(k), succ(k))
                            [using specialize
                              peano_order.lessOrEqualRefl(succ(k))]
                          @the-rows-grow |
                            tripleRows(p, q, r, i, succ(k), succ(k)) =
                              addR(tripleRows(p, q, r, i, succ(k), k),
                              tripleDiag(p, q, r, i, k, succ(k)))
                            [using specialize
                              raisingTheBoundAddsTheDiagonal(p, q, r, i, k,
                              succ(k)) succ-k-is-at-most-itself]
                          // the extra row at bound k is empty
                          @the-extra-row-peels |
                            tripleRows(p, q, r, i, succ(k), k) =
                              addR(tripleRows(p, q, r, i, k, k),
                              tripleRow(p, q, r, i, k, theGapTo(k, k)))
                            [using specialize
                              tripleRowsSucc(p, q, r, i, k, k)]
                          @the-last-row-has-no-length |
                            theGapTo(k, k) = ZERO
                            [using specialize theGapToSelfVanishes(k)]
                          @the-empty-row |
                            tripleRow(p, q, r, i, k, ZERO) = zeroR
                            [using specialize tripleRowZero(p, q, r, i, k)]
                          @adding-nothing |
                            addR(tripleRows(p, q, r, i, k, k), zeroR) =
                              tripleRows(p, q, r, i, k, k)
                            [using specialize addZeroRightR(
                              tripleRows(p, q, r, i, k, k))]
                          @the-extra-row-contributes-nothing |
                            tripleRows(p, q, r, i, succ(k), k) =
                              tripleRows(p, q, r, i, k, k)
                            [using simplify the-extra-row-peels
                              the-last-row-has-no-length the-empty-row
                              adding-nothing]
                          @the-rows-grow-from-the-triangle |
                            tripleRows(p, q, r, i, succ(k), succ(k)) =
                              addR(tripleTri(p, q, r, i, k),
                              tripleDiag(p, q, r, i, k, succ(k)))
                            [using simplify the-rows-grow
                              the-extra-row-contributes-nothing
                              the-hypothesis]
                          @the-rows-grow-flipped |
                            addR(tripleTri(p, q, r, i, k),
                              tripleDiag(p, q, r, i, k, succ(k))) =
                              tripleRows(p, q, r, i, succ(k), succ(k))
                            [by symmetry the-rows-grow-from-the-triangle]
                          @conclusion-at-succ-k |
                            tripleTri(p, q, r, i, succ(k)) =
                              tripleRows(p, q, r, i, succ(k), succ(k))
                            [using chain the-triangle-grows
                              the-rows-grow-flipped]
                        }
                      @the-hypothesis-gives-it |
                        (tripleTri(p, q, r, i, k) =
                          tripleRows(p, q, r, i, k, k)) ->
                          (tripleTri(p, q, r, i, succ(k)) =
                          tripleRows(p, q, r, i, succ(k), succ(k)))
                        [by discharge given-the-hypothesis]
                    }
                  @all-bounds |
                    forall k: Nat;
                      (tripleTri(p, q, r, i, k) =
                      tripleRows(p, q, r, i, k, k)) ->
                      (tripleTri(p, q, r, i, succ(k)) =
                      tripleRows(p, q, r, i, succ(k), succ(k)))
                    [by generalize generalize-k]
                }
              @discharge-i |
                forall i: Nat; forall k: Nat;
                  (tripleTri(p, q, r, i, k) =
                  tripleRows(p, q, r, i, k, k)) ->
                  (tripleTri(p, q, r, i, succ(k)) =
                  tripleRows(p, q, r, i, succ(k), succ(k)))
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i: Nat; forall k: Nat;
              (tripleTri(p, q, r, i, k) =
              tripleRows(p, q, r, i, k, k)) ->
              (tripleTri(p, q, r, i, succ(k)) =
              tripleRows(p, q, r, i, succ(k), succ(k)))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i: Nat; forall k: Nat;
          (tripleTri(p, q, r, i, k) =
          tripleRows(p, q, r, i, k, k)) ->
          (tripleTri(p, q, r, i, succ(k)) =
          tripleRows(p, q, r, i, succ(k), succ(k)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i: Nat; forall k: Nat;
      (tripleTri(p, q, r, i, k) = tripleRows(p, q, r, i, k, k)) ->
      (tripleTri(p, q, r, i, succ(k)) =
      tripleRows(p, q, r, i, succ(k), succ(k)))
    [by generalize generalize-p]
qed

// -- THE BACK-GROWING CAPPED RUN ------------------------------------------------------------
// `cappedRun(q, r, g, n)` is the first `n` terms of the run over pairs summing to `g`, read
// with q ASCENDING from ZERO and r taking the slack — and it grows at the BACK, on its count.
//
// WHY A THIRD RUN FAMILY. `segment` and `rsegment` both peel at the FRONT, moving their base;
// a triple ROW peels at the back, on its count, because that is what makes it a prefix family
// and the whole increment argument work. Matching a row against a front-peeling run fails
// term-by-term (checked: the two orders agree only at the FULL row, not at a partial one), so
// the row needs the run that walks the way it does. Two axioms, and `theGapTo` keeps the
// slack subtraction-free.
func cappedRun(q: Poly, r: Poly, g: Nat, n: Nat) => R:
  cappedRun(q, r, g, ZERO) = zeroR;
  cappedRun(q, r, g, succ(n)) =
  addR(cappedRun(q, r, g, n),
  mulR(coeff(q, n), coeff(r, theGapTo(g, n))))

// -- LEMMA D: a row IS the capped run, scaled by p_j -----------------------------------------
// Every entry carries `coeff(p, j)`, which the summation index does not touch, so it pulls
// out and what remains is the run over the pairs summing to the gap. Both sides peel at the
// back on the same count, so the induction is a term-by-term match.
theorem aRowIsTheScaledRun: forall p, q, r: Poly; forall n, i, j: Nat;
  tripleRow(p, q, r, i, j, n) =
  mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), n))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @base-case |
                forall i, j: Nat;
                  tripleRow(p, q, r, i, j, ZERO) =
                  mulR(coeff(p, j),
                  cappedRun(q, r, theGapTo(i, j), ZERO))
                [using specialize theRowRunBase(p, q, r)]
              @induction-step-for-all-n |
                forall n: Nat;
                  (forall i, j: Nat;
                  tripleRow(p, q, r, i, j, n) =
                  mulR(coeff(p, j),
                  cappedRun(q, r, theGapTo(i, j), n))) ->
                  (forall i, j: Nat;
                  tripleRow(p, q, r, i, j, succ(n)) =
                  mulR(coeff(p, j),
                  cappedRun(q, r, theGapTo(i, j), succ(n))))
                [using specialize theRowRunStep(p, q, r)]
              @all-counts |
                forall n: Nat; forall i, j: Nat;
                  tripleRow(p, q, r, i, j, n) =
                  mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), n))
                [using instantiation peano.induction((fun z: Nat => forall i, j: Nat; tripleRow(p, q, r, i, j, z) = mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), z)))) base-case induction-step-for-all-n]
            }
          @discharge-r |
            forall r: Poly; forall n, i, j: Nat;
              tripleRow(p, q, r, i, j, n) =
              mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), n))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall n, i, j: Nat;
          tripleRow(p, q, r, i, j, n) =
          mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), n))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall n, i, j: Nat;
      tripleRow(p, q, r, i, j, n) =
      mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), n))
    [by generalize generalize-p]
qed

// The base: both are empty, and p_j times zeroR is zeroR.
theorem theRowRunBase: forall p, q, r: Poly;
  forall i, j: Nat;
  tripleRow(p, q, r, i, j, ZERO) =
  mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), ZERO))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @generalize-j |
                    fix j: Nat {
                      @the-empty-row |
                        tripleRow(p, q, r, i, j, ZERO) = zeroR
                        [using specialize tripleRowZero(p, q, r, i, j)]
                      @the-empty-run |
                        cappedRun(q, r, theGapTo(i, j), ZERO) = zeroR
                        [using specialize
                          cappedRunZero(q, r, theGapTo(i, j))]
                      @scaling-zero |
                        mulR(coeff(p, j), zeroR) = zeroR
                        [using specialize mulZeroRightR(coeff(p, j))]
                      @conclusion-the-base |
                        tripleRow(p, q, r, i, j, ZERO) =
                          mulR(coeff(p, j),
                          cappedRun(q, r, theGapTo(i, j), ZERO))
                        [using simplify the-empty-row the-empty-run
                          scaling-zero]
                    }
                  @discharge-j |
                    forall j: Nat;
                      tripleRow(p, q, r, i, j, ZERO) =
                      mulR(coeff(p, j),
                      cappedRun(q, r, theGapTo(i, j), ZERO))
                    [by generalize generalize-j]
                }
              @discharge-i |
                forall i, j: Nat;
                  tripleRow(p, q, r, i, j, ZERO) =
                  mulR(coeff(p, j),
                  cappedRun(q, r, theGapTo(i, j), ZERO))
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i, j: Nat;
              tripleRow(p, q, r, i, j, ZERO) =
              mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), ZERO))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i, j: Nat;
          tripleRow(p, q, r, i, j, ZERO) =
          mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), ZERO))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i, j: Nat;
      tripleRow(p, q, r, i, j, ZERO) =
      mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), ZERO))
    [by generalize generalize-p]
qed

// The step: both peel their last term. The row's is `p_j q_n r_{cofactor(i,j,n)}` and the
// run's is `q_n r_{theGapTo(g, n)}` scaled — the same term, since the cofactor index IS the
// gap's gap. R distributes to recombine the scalar.
theorem theRowRunStep: forall p, q, r: Poly; forall n: Nat;
  (forall i, j: Nat;
  tripleRow(p, q, r, i, j, n) =
  mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), n))) ->
  (forall i, j: Nat;
  tripleRow(p, q, r, i, j, succ(n)) =
  mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), succ(n))))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-n |
                fix n: Nat {
                  @given-the-hypothesis |
                    assume forall i, j: Nat;
                      tripleRow(p, q, r, i, j, n) =
                      mulR(coeff(p, j),
                      cappedRun(q, r, theGapTo(i, j), n)) {
                      @the-hypothesis |
                        forall i, j: Nat;
                          tripleRow(p, q, r, i, j, n) =
                          mulR(coeff(p, j),
                          cappedRun(q, r, theGapTo(i, j), n))
                        [by hypothesis given-the-hypothesis]
                      @generalize-i |
                        fix i: Nat {
                          @generalize-j |
                            fix j: Nat {
                              @the-row-grows |
                                tripleRow(p, q, r, i, j, succ(n)) =
                                  addR(tripleRow(p, q, r, i, j, n),
                                  tripleTerm(p, q, r, i, j, n))
                                [using specialize
                                  tripleRowSucc(p, q, r, i, j, n)]
                              @the-new-entry |
                                tripleTerm(p, q, r, i, j, n) =
                                  mulR(mulR(coeff(p, j), coeff(q, n)),
                                  coeff(r, theCofactorIndex(i, j, n)))
                                [using specialize
                                  tripleTermMeaning(p, q, r, i, j, n)]
                              @the-cofactor-is-the-gaps-gap |
                                theCofactorIndex(i, j, n) =
                                  theGapTo(theGapTo(i, j), n)
                                [using specialize
                                  theCofactorIsTheGapsGap(i, j, n)]
                              @the-row-applies |
                                tripleRow(p, q, r, i, j, n) =
                                  mulR(coeff(p, j),
                                  cappedRun(q, r, theGapTo(i, j), n))
                                [using specialize the-hypothesis(i, j)]
                              @the-run-grows |
                                cappedRun(q, r, theGapTo(i, j), succ(n)) =
                                  addR(cappedRun(q, r, theGapTo(i, j), n),
                                  mulR(coeff(q, n),
                                  coeff(r, theGapTo(theGapTo(i, j), n))))
                                [using specialize
                                  cappedRunSucc(q, r, theGapTo(i, j), n)]
                              @the-scaling-distributes |
                                mulR(coeff(p, j),
                                  addR(cappedRun(q, r, theGapTo(i, j), n),
                                  mulR(coeff(q, n),
                                  coeff(r,
                                  theGapTo(theGapTo(i, j), n))))) =
                                  addR(mulR(coeff(p, j),
                                  cappedRun(q, r, theGapTo(i, j), n)),
                                  mulR(coeff(p, j),
                                  mulR(coeff(q, n),
                                  coeff(r,
                                  theGapTo(theGapTo(i, j), n)))))
                                [using specialize mulAddDistribLeftR(
                                  coeff(p, j),
                                  cappedRun(q, r, theGapTo(i, j), n),
                                  mulR(coeff(q, n),
                                  coeff(r, theGapTo(theGapTo(i, j), n))))]
                              @the-entry-regroups |
                                mulR(mulR(coeff(p, j), coeff(q, n)),
                                  coeff(r,
                                  theGapTo(theGapTo(i, j), n))) =
                                  mulR(coeff(p, j),
                                  mulR(coeff(q, n),
                                  coeff(r,
                                  theGapTo(theGapTo(i, j), n))))
                                [using specialize mulIsAssociativeR(
                                  coeff(p, j), coeff(q, n),
                                  coeff(r, theGapTo(theGapTo(i, j), n)))]
                              @conclusion-the-step |
                                tripleRow(p, q, r, i, j, succ(n)) =
                                  mulR(coeff(p, j),
                                  cappedRun(q, r, theGapTo(i, j), succ(n)))
                                [using simplify the-row-grows
                                  the-new-entry
                                  the-cofactor-is-the-gaps-gap
                                  the-row-applies the-entry-regroups
                                  the-run-grows the-scaling-distributes]
                            }
                          @discharge-j |
                            forall j: Nat;
                              tripleRow(p, q, r, i, j, succ(n)) =
                              mulR(coeff(p, j),
                              cappedRun(q, r, theGapTo(i, j), succ(n)))
                            [by generalize generalize-j]
                        }
                      @all-indices |
                        forall i, j: Nat;
                          tripleRow(p, q, r, i, j, succ(n)) =
                          mulR(coeff(p, j),
                          cappedRun(q, r, theGapTo(i, j), succ(n)))
                        [by generalize generalize-i]
                    }
                  @the-hypothesis-gives-it |
                    (forall i, j: Nat;
                      tripleRow(p, q, r, i, j, n) =
                      mulR(coeff(p, j),
                      cappedRun(q, r, theGapTo(i, j), n))) ->
                      (forall i, j: Nat;
                      tripleRow(p, q, r, i, j, succ(n)) =
                      mulR(coeff(p, j),
                      cappedRun(q, r, theGapTo(i, j), succ(n))))
                    [by discharge given-the-hypothesis]
                }
              @discharge-n |
                forall n: Nat;
                  (forall i, j: Nat;
                  tripleRow(p, q, r, i, j, n) =
                  mulR(coeff(p, j),
                  cappedRun(q, r, theGapTo(i, j), n))) ->
                  (forall i, j: Nat;
                  tripleRow(p, q, r, i, j, succ(n)) =
                  mulR(coeff(p, j),
                  cappedRun(q, r, theGapTo(i, j), succ(n))))
                [by generalize generalize-n]
            }
          @discharge-r |
            forall r: Poly; forall n: Nat;
              (forall i, j: Nat;
              tripleRow(p, q, r, i, j, n) =
              mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), n))) ->
              (forall i, j: Nat;
              tripleRow(p, q, r, i, j, succ(n)) =
              mulR(coeff(p, j),
              cappedRun(q, r, theGapTo(i, j), succ(n))))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall n: Nat;
          (forall i, j: Nat;
          tripleRow(p, q, r, i, j, n) =
          mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), n))) ->
          (forall i, j: Nat;
          tripleRow(p, q, r, i, j, succ(n)) =
          mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), succ(n))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall n: Nat;
      (forall i, j: Nat;
      tripleRow(p, q, r, i, j, n) =
      mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), n))) ->
      (forall i, j: Nat;
      tripleRow(p, q, r, i, j, succ(n)) =
      mulR(coeff(p, j), cappedRun(q, r, theGapTo(i, j), succ(n))))
    [by generalize generalize-p]
qed

// The cofactor index IS the gap's gap: `(i - j) - k` either way. At k = ZERO both sides are
// the gap; above it the two clauses agree by construction.
theorem theCofactorIsTheGapsGap: forall i, j, k: Nat;
  theCofactorIndex(i, j, k) = theGapTo(theGapTo(i, j), k)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @generalize-k |
            fix k: Nat {
              @the-case-split |
                k = ZERO or (exists w: Nat; k = succ(w))
                [using specialize peano.zeroOrSucc(k)]
              @when-k-is-zero |
                assume k = ZERO {
                  @k-is-zero |
                    k = ZERO
                    [by hypothesis when-k-is-zero]
                  @the-cofactor-at-zero |
                    theCofactorIndex(i, j, ZERO) = theGapTo(i, j)
                    [using specialize theCofactorIndexAtZero(i, j)]
                  @the-gap-at-zero |
                    theGapTo(theGapTo(i, j), ZERO) = theGapTo(i, j)
                    [using specialize theGapToAtZero(theGapTo(i, j))]
                  @the-equality-at-zero |
                    theCofactorIndex(i, j, ZERO) =
                      theGapTo(theGapTo(i, j), ZERO)
                    [using simplify the-cofactor-at-zero the-gap-at-zero]
                  @conclusion-zero |
                    theCofactorIndex(i, j, k) =
                      theGapTo(theGapTo(i, j), k)
                    [by rewrite k-is-zero the-equality-at-zero]
                }
              @when-k-is-positive |
                assume exists w: Nat; k = succ(w) {
                  @the-predecessor-exists |
                    exists w: Nat; k = succ(w)
                    [by hypothesis when-k-is-positive]
                  @with-the-predecessor |
                    unpack w: Nat from the-predecessor-exists {
                      @k-steps |
                        k = succ(w)
                        [by hypothesis with-the-predecessor]
                      @the-cofactor-steps |
                        theCofactorIndex(i, j, succ(w)) =
                          theGapTo(theGapTo(i, j), succ(w))
                        [using specialize
                          theCofactorIndexSteps(i, j, w)]
                      @conclusion-positive |
                        theCofactorIndex(i, j, k) =
                          theGapTo(theGapTo(i, j), k)
                        [by rewrite k-steps the-cofactor-steps]
                    }
                  @conclusion-the-positive-case |
                    theCofactorIndex(i, j, k) =
                      theGapTo(theGapTo(i, j), k)
                    [by unpacked with-the-predecessor]
                }
              @conclusion-either-way |
                theCofactorIndex(i, j, k) = theGapTo(theGapTo(i, j), k)
                [by common_conclusion the-case-split
                  when-k-is-zero when-k-is-positive]
            }
          @discharge-k |
            forall k: Nat;
              theCofactorIndex(i, j, k) = theGapTo(theGapTo(i, j), k)
            [by generalize generalize-k]
        }
      @discharge-j |
        forall j, k: Nat;
          theCofactorIndex(i, j, k) = theGapTo(theGapTo(i, j), k)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j, k: Nat;
      theCofactorIndex(i, j, k) = theGapTo(theGapTo(i, j), k)
    [by generalize generalize-i]
qed

// A COMMON AMOUNT CANCELS: `(i - c) - (m - c) = i - m` for c <= m <= i. The entry at count
// `c` of the m-th anti-diagonal reads r at this index, and the cancellation is what makes it
// CONSTANT along the diagonal — which is why `coeff(r, ·)` factors out of Lemma C.
//
// Both bounds are load-bearing: past them the inner gaps floor at ZERO independently and the
// identity fails. `std/peano/subtraction.b4m` has the `sub` version
// (`aCommonAmountCancelsUnderNestedSubtraction`); this is the same fact for the named gaps,
// proved by induction on the amount cancelled.
theorem aCommonAmountCancels: forall c, i, m: Nat;
  peano_order.less_or_equal(c, m) ->
  peano_order.less_or_equal(m, i) ->
  theGapTo(theGapTo(i, c), theGapTo(m, c)) = theGapTo(i, m)
proof
  @base-case |
    forall i, m: Nat;
      peano_order.less_or_equal(ZERO, m) ->
      peano_order.less_or_equal(m, i) ->
      theGapTo(theGapTo(i, ZERO), theGapTo(m, ZERO)) = theGapTo(i, m)
    [using specialize theCancelBase]
  @induction-step-for-all-c |
    forall c: Nat;
      (forall i, m: Nat;
      peano_order.less_or_equal(c, m) ->
      peano_order.less_or_equal(m, i) ->
      theGapTo(theGapTo(i, c), theGapTo(m, c)) = theGapTo(i, m)) ->
      (forall i, m: Nat;
      peano_order.less_or_equal(succ(c), m) ->
      peano_order.less_or_equal(m, i) ->
      theGapTo(theGapTo(i, succ(c)), theGapTo(m, succ(c))) =
      theGapTo(i, m))
    [using specialize theCancelStep]
  @conclusion |
    forall c: Nat; forall i, m: Nat;
      peano_order.less_or_equal(c, m) ->
      peano_order.less_or_equal(m, i) ->
      theGapTo(theGapTo(i, c), theGapTo(m, c)) = theGapTo(i, m)
    [using instantiation peano.induction((fun z: Nat => forall i, m: Nat; peano_order.less_or_equal(z, m) -> peano_order.less_or_equal(m, i) -> theGapTo(theGapTo(i, z), theGapTo(m, z)) = theGapTo(i, m))) base-case induction-step-for-all-c]
qed

// The base: cancelling nothing, so both gaps are themselves.
theorem theCancelBase: forall i, m: Nat;
  peano_order.less_or_equal(ZERO, m) ->
  peano_order.less_or_equal(m, i) ->
  theGapTo(theGapTo(i, ZERO), theGapTo(m, ZERO)) = theGapTo(i, m)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-m |
        fix m: Nat {
          @the-outer-gap |
            theGapTo(i, ZERO) = i
            [using specialize theGapToAtZero(i)]
          @the-inner-gap |
            theGapTo(m, ZERO) = m
            [using specialize theGapToAtZero(m)]
          @the-equality |
            theGapTo(theGapTo(i, ZERO), theGapTo(m, ZERO)) =
              theGapTo(i, m)
            [using simplify the-outer-gap the-inner-gap]
          @conclusion-inner |
            peano_order.less_or_equal(ZERO, m) ->
              peano_order.less_or_equal(m, i) ->
              theGapTo(theGapTo(i, ZERO), theGapTo(m, ZERO)) =
              theGapTo(i, m)
            [using tautology the-equality]
        }
      @discharge-m |
        forall m: Nat;
          peano_order.less_or_equal(ZERO, m) ->
          peano_order.less_or_equal(m, i) ->
          theGapTo(theGapTo(i, ZERO), theGapTo(m, ZERO)) = theGapTo(i, m)
        [by generalize generalize-m]
    }
  @conclusion |
    forall i, m: Nat;
      peano_order.less_or_equal(ZERO, m) ->
      peano_order.less_or_equal(m, i) ->
      theGapTo(theGapTo(i, ZERO), theGapTo(m, ZERO)) = theGapTo(i, m)
    [by generalize generalize-i]
qed

// The step: at succ(c) both bounds force m and i to be successors, and all three `theGapTo`
// applications step down by their succ/succ clause onto the hypothesis.
theorem theCancelStep: forall c: Nat;
  (forall i, m: Nat;
  peano_order.less_or_equal(c, m) ->
  peano_order.less_or_equal(m, i) ->
  theGapTo(theGapTo(i, c), theGapTo(m, c)) = theGapTo(i, m)) ->
  (forall i, m: Nat;
  peano_order.less_or_equal(succ(c), m) ->
  peano_order.less_or_equal(m, i) ->
  theGapTo(theGapTo(i, succ(c)), theGapTo(m, succ(c))) = theGapTo(i, m))
proof
  @generalize-c |
    fix c: Nat {
      @given-the-hypothesis |
        assume forall i, m: Nat;
          peano_order.less_or_equal(c, m) ->
          peano_order.less_or_equal(m, i) ->
          theGapTo(theGapTo(i, c), theGapTo(m, c)) = theGapTo(i, m) {
          @the-hypothesis |
            forall i, m: Nat;
              peano_order.less_or_equal(c, m) ->
              peano_order.less_or_equal(m, i) ->
              theGapTo(theGapTo(i, c), theGapTo(m, c)) = theGapTo(i, m)
            [by hypothesis given-the-hypothesis]
          @generalize-i |
            fix i: Nat {
              @generalize-m |
                fix m: Nat {
                  @given-c-within-m |
                    assume peano_order.less_or_equal(succ(c), m) {
                      @c-within-m |
                        peano_order.less_or_equal(succ(c), m)
                        [by hypothesis given-c-within-m]
                      @given-m-within-i |
                        assume peano_order.less_or_equal(m, i) {
                          @m-within-i |
                            peano_order.less_or_equal(m, i)
                            [by hypothesis given-m-within-i]
                          @m-is-positive |
                            m = ZERO or (exists u: Nat; m = succ(u))
                            [using specialize peano.zeroOrSucc(m)]
                          @when-m-is-zero |
                            assume m = ZERO {
                              @m-is-zero |
                                m = ZERO
                                [by hypothesis when-m-is-zero]
                              @the-bound-at-zero |
                                peano_order.less_or_equal(succ(c), ZERO)
                                [by rewrite m-is-zero c-within-m]
                              @nothing-is-at-most-zero |
                                not peano_order.less_or_equal(succ(c), ZERO)
                                [using specialize
                                  peano_order.noSuccessorIsAtMostZero(c)]
                              @conclusion-vacuous |
                                theGapTo(theGapTo(i, succ(c)),
                                  theGapTo(m, succ(c))) = theGapTo(i, m)
                                [by ex_falso the-bound-at-zero
                                  nothing-is-at-most-zero]
                            }
                          @when-m-is-positive |
                            assume exists u: Nat; m = succ(u) {
                              @the-m-predecessor-exists |
                                exists u: Nat; m = succ(u)
                                [by hypothesis when-m-is-positive]
                              @with-the-m-predecessor |
                                unpack u: Nat from the-m-predecessor-exists {
                                  @m-steps |
                                    m = succ(u)
                                    [by hypothesis with-the-m-predecessor]
                                  @i-is-positive |
                                    i = ZERO or (exists v: Nat; i = succ(v))
                                    [using specialize peano.zeroOrSucc(i)]
                                  @when-i-is-zero |
                                    assume i = ZERO {
                                      @i-is-zero |
                                        i = ZERO
                                        [by hypothesis when-i-is-zero]
                                      @m-within-i-at-zero |
                                        peano_order.less_or_equal(m, ZERO)
                                        [by rewrite i-is-zero m-within-i]
                                      @m-within-zero |
                                        peano_order.less_or_equal(succ(u),
                                          ZERO)
                                        [by rewrite m-steps
                                          m-within-i-at-zero]
                                      @nothing-at-most-zero |
                                        not peano_order.less_or_equal(
                                          succ(u), ZERO)
                                        [using specialize
                                          peano_order.noSuccessorIsAtMostZero(
                                          u)]
                                      @conclusion-i-vacuous |
                                        theGapTo(theGapTo(i, succ(c)),
                                          theGapTo(m, succ(c))) =
                                          theGapTo(i, m)
                                        [by ex_falso m-within-zero
                                          nothing-at-most-zero]
                                    }
                                  @when-i-is-positive |
                                    assume exists v: Nat; i = succ(v) {
                                      @the-i-predecessor-exists |
                                        exists v: Nat; i = succ(v)
                                        [by hypothesis when-i-is-positive]
                                      @with-the-i-predecessor |
                                        unpack v: Nat from
                                          the-i-predecessor-exists {
                                          @i-steps |
                                            i = succ(v)
                                            [by hypothesis
                                              with-the-i-predecessor]
                                          @c-within-u |
                                            peano_order.less_or_equal(c, u)
                                            [using specialize
                                              peano_order.succReflectsAtMost(
                                              c, u) the-raised-c-bound]
                                          @the-raised-c-bound |
                                            peano_order.less_or_equal(
                                              succ(c), succ(u))
                                            [by rewrite m-steps c-within-m]
                                          @the-m-bound-at-succ-v |
                                            peano_order.less_or_equal(m,
                                              succ(v))
                                            [by rewrite i-steps m-within-i]
                                          @the-raised-m-bound |
                                            peano_order.less_or_equal(
                                              succ(u), succ(v))
                                            [by rewrite m-steps
                                              the-m-bound-at-succ-v]
                                          @u-within-v |
                                            peano_order.less_or_equal(u, v)
                                            [using specialize
                                              peano_order.succReflectsAtMost(
                                              u, v) the-raised-m-bound]
                                          @the-hypothesis-applies |
                                            theGapTo(theGapTo(v, c),
                                              theGapTo(u, c)) =
                                              theGapTo(v, u)
                                            [using specialize
                                              the-hypothesis(v, u)
                                              c-within-u u-within-v]
                                          @the-outer-steps |
                                            theGapTo(succ(v), succ(c)) =
                                              theGapTo(v, c)
                                            [using specialize
                                              theGapToSteps(v, c)]
                                          @the-inner-steps |
                                            theGapTo(succ(u), succ(c)) =
                                              theGapTo(u, c)
                                            [using specialize
                                              theGapToSteps(u, c)]
                                          @the-target-steps |
                                            theGapTo(succ(v), succ(u)) =
                                              theGapTo(v, u)
                                            [using specialize
                                              theGapToSteps(v, u)]
                                          @the-equality-at-predecessors |
                                            theGapTo(theGapTo(succ(v),
                                              succ(c)),
                                              theGapTo(succ(u), succ(c))) =
                                              theGapTo(succ(v), succ(u))
                                            [using simplify the-outer-steps
                                              the-inner-steps
                                              the-hypothesis-applies
                                              the-target-steps]
                                          @conclusion-positive |
                                            theGapTo(theGapTo(i, succ(c)),
                                              theGapTo(m, succ(c))) =
                                              theGapTo(i, m)
                                            [using simplify i-steps m-steps
                                              the-equality-at-predecessors]
                                        }
                                      @conclusion-i-positive |
                                        theGapTo(theGapTo(i, succ(c)),
                                          theGapTo(m, succ(c))) =
                                          theGapTo(i, m)
                                        [by unpacked with-the-i-predecessor]
                                    }
                                  @conclusion-either-i |
                                    theGapTo(theGapTo(i, succ(c)),
                                      theGapTo(m, succ(c))) =
                                      theGapTo(i, m)
                                    [by common_conclusion i-is-positive
                                      when-i-is-zero when-i-is-positive]
                                }
                              @conclusion-m-positive |
                                theGapTo(theGapTo(i, succ(c)),
                                  theGapTo(m, succ(c))) = theGapTo(i, m)
                                [by unpacked with-the-m-predecessor]
                            }
                          @conclusion-either-m |
                            theGapTo(theGapTo(i, succ(c)),
                              theGapTo(m, succ(c))) = theGapTo(i, m)
                            [by common_conclusion m-is-positive
                              when-m-is-zero when-m-is-positive]
                        }
                      @m-bound-gives-it |
                        peano_order.less_or_equal(m, i) ->
                          theGapTo(theGapTo(i, succ(c)),
                          theGapTo(m, succ(c))) = theGapTo(i, m)
                        [by discharge given-m-within-i]
                    }
                  @c-bound-gives-it |
                    peano_order.less_or_equal(succ(c), m) ->
                      peano_order.less_or_equal(m, i) ->
                      theGapTo(theGapTo(i, succ(c)),
                      theGapTo(m, succ(c))) = theGapTo(i, m)
                    [by discharge given-c-within-m]
                }
              @discharge-m |
                forall m: Nat;
                  peano_order.less_or_equal(succ(c), m) ->
                  peano_order.less_or_equal(m, i) ->
                  theGapTo(theGapTo(i, succ(c)),
                  theGapTo(m, succ(c))) = theGapTo(i, m)
                [by generalize generalize-m]
            }
          @all-indices |
            forall i, m: Nat;
              peano_order.less_or_equal(succ(c), m) ->
              peano_order.less_or_equal(m, i) ->
              theGapTo(theGapTo(i, succ(c)),
              theGapTo(m, succ(c))) = theGapTo(i, m)
            [by generalize generalize-i]
        }
      @the-hypothesis-gives-it |
        (forall i, m: Nat;
          peano_order.less_or_equal(c, m) ->
          peano_order.less_or_equal(m, i) ->
          theGapTo(theGapTo(i, c), theGapTo(m, c)) = theGapTo(i, m)) ->
          (forall i, m: Nat;
          peano_order.less_or_equal(succ(c), m) ->
          peano_order.less_or_equal(m, i) ->
          theGapTo(theGapTo(i, succ(c)),
          theGapTo(m, succ(c))) = theGapTo(i, m))
        [by discharge given-the-hypothesis]
    }
  @conclusion |
    forall c: Nat;
      (forall i, m: Nat;
      peano_order.less_or_equal(c, m) ->
      peano_order.less_or_equal(m, i) ->
      theGapTo(theGapTo(i, c), theGapTo(m, c)) = theGapTo(i, m)) ->
      (forall i, m: Nat;
      peano_order.less_or_equal(succ(c), m) ->
      peano_order.less_or_equal(m, i) ->
      theGapTo(theGapTo(i, succ(c)),
      theGapTo(m, succ(c))) = theGapTo(i, m))
    [by generalize generalize-c]
qed

// -- LEMMA C: an anti-diagonal IS the capped run, scaled by r -------------------------------
// Along the m-th anti-diagonal the r-index is CONSTANT — `aCommonAmountCancels` says the
// entry at count `c` reads r at `(i-c)-(m-c) = i-m` whatever `c` is — so `coeff(r, ·)`
// factors out and what remains is p against q over the pairs summing to `m`. That is
// `cappedRun(p, q, m, c)`: the SAME family Lemma D used, since both walk their count at the
// back.
//
// The bounds travel inside the property: the step needs `c <= m` at `c` to apply the
// cancellation, and `m <= i` throughout.
theorem aDiagonalIsTheScaledRun: forall p, q, r: Poly; forall c, i, m: Nat;
  peano_order.less_or_equal(c, succ(m)) ->
  peano_order.less_or_equal(m, i) ->
  tripleDiag(p, q, r, i, m, c) =
  mulR(cappedRun(p, q, m, c), coeff(r, theGapTo(i, m)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @base-case |
                forall i, m: Nat;
                  peano_order.less_or_equal(ZERO, succ(m)) ->
                  peano_order.less_or_equal(m, i) ->
                  tripleDiag(p, q, r, i, m, ZERO) =
                  mulR(cappedRun(p, q, m, ZERO),
                  coeff(r, theGapTo(i, m)))
                [using specialize theDiagRunBase(p, q, r)]
              @induction-step-for-all-c |
                forall c: Nat;
                  (forall i, m: Nat;
                  peano_order.less_or_equal(c, succ(m)) ->
                  peano_order.less_or_equal(m, i) ->
                  tripleDiag(p, q, r, i, m, c) =
                  mulR(cappedRun(p, q, m, c),
                  coeff(r, theGapTo(i, m)))) ->
                  (forall i, m: Nat;
                  peano_order.less_or_equal(succ(c), succ(m)) ->
                  peano_order.less_or_equal(m, i) ->
                  tripleDiag(p, q, r, i, m, succ(c)) =
                  mulR(cappedRun(p, q, m, succ(c)),
                  coeff(r, theGapTo(i, m))))
                [using specialize theDiagRunStep(p, q, r)]
              @all-counts |
                forall c: Nat; forall i, m: Nat;
                  peano_order.less_or_equal(c, succ(m)) ->
                  peano_order.less_or_equal(m, i) ->
                  tripleDiag(p, q, r, i, m, c) =
                  mulR(cappedRun(p, q, m, c), coeff(r, theGapTo(i, m)))
                [using instantiation peano.induction((fun z: Nat => forall i, m: Nat; peano_order.less_or_equal(z, succ(m)) -> peano_order.less_or_equal(m, i) -> tripleDiag(p, q, r, i, m, z) = mulR(cappedRun(p, q, m, z), coeff(r, theGapTo(i, m))))) base-case induction-step-for-all-c]
            }
          @discharge-r |
            forall r: Poly; forall c, i, m: Nat;
              peano_order.less_or_equal(c, succ(m)) ->
              peano_order.less_or_equal(m, i) ->
              tripleDiag(p, q, r, i, m, c) =
              mulR(cappedRun(p, q, m, c), coeff(r, theGapTo(i, m)))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall c, i, m: Nat;
          peano_order.less_or_equal(c, succ(m)) ->
          peano_order.less_or_equal(m, i) ->
          tripleDiag(p, q, r, i, m, c) =
          mulR(cappedRun(p, q, m, c), coeff(r, theGapTo(i, m)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall c, i, m: Nat;
      peano_order.less_or_equal(c, succ(m)) ->
      peano_order.less_or_equal(m, i) ->
      tripleDiag(p, q, r, i, m, c) =
      mulR(cappedRun(p, q, m, c), coeff(r, theGapTo(i, m)))
    [by generalize generalize-p]
qed

// The base: both are empty, and zeroR times anything is zeroR.
theorem theDiagRunBase: forall p, q, r: Poly;
  forall i, m: Nat;
  peano_order.less_or_equal(ZERO, succ(m)) ->
  peano_order.less_or_equal(m, i) ->
  tripleDiag(p, q, r, i, m, ZERO) =
  mulR(cappedRun(p, q, m, ZERO), coeff(r, theGapTo(i, m)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @generalize-m |
                    fix m: Nat {
                      @the-empty-diagonal |
                        tripleDiag(p, q, r, i, m, ZERO) = zeroR
                        [using specialize tripleDiagZero(p, q, r, i, m)]
                      @the-empty-run |
                        cappedRun(p, q, m, ZERO) = zeroR
                        [using specialize cappedRunZero(p, q, m)]
                      @zero-scales-away |
                        mulR(zeroR, coeff(r, theGapTo(i, m))) = zeroR
                        [using specialize
                          mulZeroLeftR(coeff(r, theGapTo(i, m)))]
                      @the-equality |
                        tripleDiag(p, q, r, i, m, ZERO) =
                          mulR(cappedRun(p, q, m, ZERO),
                          coeff(r, theGapTo(i, m)))
                        [using simplify the-empty-diagonal the-empty-run
                          zero-scales-away]
                      @conclusion-the-base |
                        peano_order.less_or_equal(ZERO, succ(m)) ->
                          peano_order.less_or_equal(m, i) ->
                          tripleDiag(p, q, r, i, m, ZERO) =
                          mulR(cappedRun(p, q, m, ZERO),
                          coeff(r, theGapTo(i, m)))
                        [using tautology the-equality]
                    }
                  @discharge-m |
                    forall m: Nat;
                      peano_order.less_or_equal(ZERO, succ(m)) ->
                      peano_order.less_or_equal(m, i) ->
                      tripleDiag(p, q, r, i, m, ZERO) =
                      mulR(cappedRun(p, q, m, ZERO),
                      coeff(r, theGapTo(i, m)))
                    [by generalize generalize-m]
                }
              @discharge-i |
                forall i, m: Nat;
                  peano_order.less_or_equal(ZERO, succ(m)) ->
                  peano_order.less_or_equal(m, i) ->
                  tripleDiag(p, q, r, i, m, ZERO) =
                  mulR(cappedRun(p, q, m, ZERO),
                  coeff(r, theGapTo(i, m)))
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i, m: Nat;
              peano_order.less_or_equal(ZERO, succ(m)) ->
              peano_order.less_or_equal(m, i) ->
              tripleDiag(p, q, r, i, m, ZERO) =
              mulR(cappedRun(p, q, m, ZERO), coeff(r, theGapTo(i, m)))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i, m: Nat;
          peano_order.less_or_equal(ZERO, succ(m)) ->
          peano_order.less_or_equal(m, i) ->
          tripleDiag(p, q, r, i, m, ZERO) =
          mulR(cappedRun(p, q, m, ZERO), coeff(r, theGapTo(i, m)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i, m: Nat;
      peano_order.less_or_equal(ZERO, succ(m)) ->
      peano_order.less_or_equal(m, i) ->
      tripleDiag(p, q, r, i, m, ZERO) =
      mulR(cappedRun(p, q, m, ZERO), coeff(r, theGapTo(i, m)))
    [by generalize generalize-p]
qed

// The step: both peel their last term. The diagonal's is
// `p_c q_{gapTo(m,c)} r_{cofactor(i, c, gapTo(m,c))}`, and the cancellation turns that
// r-index into `gapTo(i, m)` — the same constant the rest of the diagonal carries — so the
// peeled terms match and R distributes to recombine the scalar.
theorem theDiagRunStep: forall p, q, r: Poly; forall c: Nat;
  (forall i, m: Nat;
  peano_order.less_or_equal(c, succ(m)) ->
  peano_order.less_or_equal(m, i) ->
  tripleDiag(p, q, r, i, m, c) =
  mulR(cappedRun(p, q, m, c), coeff(r, theGapTo(i, m)))) ->
  (forall i, m: Nat;
  peano_order.less_or_equal(succ(c), succ(m)) ->
  peano_order.less_or_equal(m, i) ->
  tripleDiag(p, q, r, i, m, succ(c)) =
  mulR(cappedRun(p, q, m, succ(c)), coeff(r, theGapTo(i, m))))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-c |
                fix c: Nat {
                  @given-the-hypothesis |
                    assume forall i, m: Nat;
                      peano_order.less_or_equal(c, succ(m)) ->
                      peano_order.less_or_equal(m, i) ->
                      tripleDiag(p, q, r, i, m, c) =
                      mulR(cappedRun(p, q, m, c),
                      coeff(r, theGapTo(i, m))) {
                      @the-hypothesis |
                        forall i, m: Nat;
                          peano_order.less_or_equal(c, succ(m)) ->
                          peano_order.less_or_equal(m, i) ->
                          tripleDiag(p, q, r, i, m, c) =
                          mulR(cappedRun(p, q, m, c),
                          coeff(r, theGapTo(i, m)))
                        [by hypothesis given-the-hypothesis]
                      @generalize-i |
                        fix i: Nat {
                          @generalize-m |
                            fix m: Nat {
                              @given-c-within-m |
                                assume peano_order.less_or_equal(succ(c),
                                  succ(m)) {
                                  @c-within-m |
                                    peano_order.less_or_equal(succ(c),
                                      succ(m))
                                    [by hypothesis given-c-within-m]
                                  @given-m-within-i |
                                    assume peano_order.less_or_equal(m, i) {
                                      @m-within-i |
                                        peano_order.less_or_equal(m, i)
                                        [by hypothesis given-m-within-i]
                                      @c-within-m-weaker |
                                        peano_order.less_or_equal(c, m)
                                        [using specialize
                                          peano_order.succReflectsAtMost(c,
                                          m) c-within-m]
                                      @c-is-below-its-successor |
                                        peano_order.less_or_equal(c,
                                          succ(c))
                                        [using specialize
                                          peano_order.aNatIsAtMostItsSuccessor(
                                          c)]
                                      @c-within-succ-m |
                                        peano_order.less_or_equal(c,
                                          succ(m))
                                        [using specialize
                                          peano_order.lessOrEqualTransitive(
                                          c, succ(c), succ(m))
                                          c-is-below-its-successor
                                          c-within-m]
                                      @the-hypothesis-applies |
                                        tripleDiag(p, q, r, i, m, c) =
                                          mulR(cappedRun(p, q, m, c),
                                          coeff(r, theGapTo(i, m)))
                                        [using specialize
                                          the-hypothesis(i, m)
                                          c-within-succ-m m-within-i]
                                      @the-diagonal-grows |
                                        tripleDiag(p, q, r, i, m, succ(c)) =
                                          addR(tripleDiag(p, q, r, i, m, c),
                                          tripleTerm(p, q, r, i, c,
                                          theGapTo(m, c)))
                                        [using specialize
                                          tripleDiagSucc(p, q, r, i, m, c)]
                                      @the-new-entry |
                                        tripleTerm(p, q, r, i, c,
                                          theGapTo(m, c)) =
                                          mulR(mulR(coeff(p, c),
                                          coeff(q, theGapTo(m, c))),
                                          coeff(r, theCofactorIndex(i, c,
                                          theGapTo(m, c))))
                                        [using specialize
                                          tripleTermMeaning(p, q, r, i, c,
                                          theGapTo(m, c))]
                                      @the-cofactor-is-the-gaps-gap |
                                        theCofactorIndex(i, c,
                                          theGapTo(m, c)) =
                                          theGapTo(theGapTo(i, c),
                                          theGapTo(m, c))
                                        [using specialize
                                          theCofactorIsTheGapsGap(i, c,
                                          theGapTo(m, c))]
                                      @the-common-amount-cancels |
                                        theGapTo(theGapTo(i, c),
                                          theGapTo(m, c)) = theGapTo(i, m)
                                        [using specialize
                                          aCommonAmountCancels(c, i, m)
                                          c-within-m-weaker m-within-i]
                                      @the-entry-reads-the-constant |
                                        tripleTerm(p, q, r, i, c,
                                          theGapTo(m, c)) =
                                          mulR(mulR(coeff(p, c),
                                          coeff(q, theGapTo(m, c))),
                                          coeff(r, theGapTo(i, m)))
                                        [using simplify the-new-entry
                                          the-cofactor-is-the-gaps-gap
                                          the-common-amount-cancels]
                                      @the-run-grows |
                                        cappedRun(p, q, m, succ(c)) =
                                          addR(cappedRun(p, q, m, c),
                                          mulR(coeff(p, c),
                                          coeff(q, theGapTo(m, c))))
                                        [using specialize
                                          cappedRunSucc(p, q, m, c)]
                                      @the-scalar-distributes |
                                        mulR(addR(cappedRun(p, q, m, c),
                                          mulR(coeff(p, c),
                                          coeff(q, theGapTo(m, c)))),
                                          coeff(r, theGapTo(i, m))) =
                                          addR(mulR(cappedRun(p, q, m, c),
                                          coeff(r, theGapTo(i, m))),
                                          mulR(mulR(coeff(p, c),
                                          coeff(q, theGapTo(m, c))),
                                          coeff(r, theGapTo(i, m))))
                                        [using specialize
                                          mulAddDistribRightR(
                                          cappedRun(p, q, m, c),
                                          mulR(coeff(p, c),
                                          coeff(q, theGapTo(m, c))),
                                          coeff(r, theGapTo(i, m)))]
                                      @conclusion-the-step |
                                        tripleDiag(p, q, r, i, m, succ(c)) =
                                          mulR(cappedRun(p, q, m, succ(c)),
                                          coeff(r, theGapTo(i, m)))
                                        [using simplify the-diagonal-grows
                                          the-hypothesis-applies
                                          the-entry-reads-the-constant
                                          the-run-grows
                                          the-scalar-distributes]
                                    }
                                  @m-bound-gives-it |
                                    peano_order.less_or_equal(m, i) ->
                                      tripleDiag(p, q, r, i, m, succ(c)) =
                                      mulR(cappedRun(p, q, m, succ(c)),
                                      coeff(r, theGapTo(i, m)))
                                    [by discharge given-m-within-i]
                                }
                              @c-bound-gives-it |
                                peano_order.less_or_equal(succ(c), succ(m)) ->
                                  peano_order.less_or_equal(m, i) ->
                                  tripleDiag(p, q, r, i, m, succ(c)) =
                                  mulR(cappedRun(p, q, m, succ(c)),
                                  coeff(r, theGapTo(i, m)))
                                [by discharge given-c-within-m]
                            }
                          @discharge-m |
                            forall m: Nat;
                              peano_order.less_or_equal(succ(c), succ(m)) ->
                              peano_order.less_or_equal(m, i) ->
                              tripleDiag(p, q, r, i, m, succ(c)) =
                              mulR(cappedRun(p, q, m, succ(c)),
                              coeff(r, theGapTo(i, m)))
                            [by generalize generalize-m]
                        }
                      @all-indices |
                        forall i, m: Nat;
                          peano_order.less_or_equal(succ(c), succ(m)) ->
                          peano_order.less_or_equal(m, i) ->
                          tripleDiag(p, q, r, i, m, succ(c)) =
                          mulR(cappedRun(p, q, m, succ(c)),
                          coeff(r, theGapTo(i, m)))
                        [by generalize generalize-i]
                    }
                  @the-hypothesis-gives-it |
                    (forall i, m: Nat;
                      peano_order.less_or_equal(c, succ(m)) ->
                      peano_order.less_or_equal(m, i) ->
                      tripleDiag(p, q, r, i, m, c) =
                      mulR(cappedRun(p, q, m, c),
                      coeff(r, theGapTo(i, m)))) ->
                      (forall i, m: Nat;
                      peano_order.less_or_equal(succ(c), succ(m)) ->
                      peano_order.less_or_equal(m, i) ->
                      tripleDiag(p, q, r, i, m, succ(c)) =
                      mulR(cappedRun(p, q, m, succ(c)),
                      coeff(r, theGapTo(i, m))))
                    [by discharge given-the-hypothesis]
                }
              @discharge-c |
                forall c: Nat;
                  (forall i, m: Nat;
                  peano_order.less_or_equal(c, succ(m)) ->
                  peano_order.less_or_equal(m, i) ->
                  tripleDiag(p, q, r, i, m, c) =
                  mulR(cappedRun(p, q, m, c),
                  coeff(r, theGapTo(i, m)))) ->
                  (forall i, m: Nat;
                  peano_order.less_or_equal(succ(c), succ(m)) ->
                  peano_order.less_or_equal(m, i) ->
                  tripleDiag(p, q, r, i, m, succ(c)) =
                  mulR(cappedRun(p, q, m, succ(c)),
                  coeff(r, theGapTo(i, m))))
                [by generalize generalize-c]
            }
          @discharge-r |
            forall r: Poly; forall c: Nat;
              (forall i, m: Nat;
              peano_order.less_or_equal(c, succ(m)) ->
              peano_order.less_or_equal(m, i) ->
              tripleDiag(p, q, r, i, m, c) =
              mulR(cappedRun(p, q, m, c), coeff(r, theGapTo(i, m)))) ->
              (forall i, m: Nat;
              peano_order.less_or_equal(succ(c), succ(m)) ->
              peano_order.less_or_equal(m, i) ->
              tripleDiag(p, q, r, i, m, succ(c)) =
              mulR(cappedRun(p, q, m, succ(c)),
              coeff(r, theGapTo(i, m))))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall c: Nat;
          (forall i, m: Nat;
          peano_order.less_or_equal(c, succ(m)) ->
          peano_order.less_or_equal(m, i) ->
          tripleDiag(p, q, r, i, m, c) =
          mulR(cappedRun(p, q, m, c), coeff(r, theGapTo(i, m)))) ->
          (forall i, m: Nat;
          peano_order.less_or_equal(succ(c), succ(m)) ->
          peano_order.less_or_equal(m, i) ->
          tripleDiag(p, q, r, i, m, succ(c)) =
          mulR(cappedRun(p, q, m, succ(c)), coeff(r, theGapTo(i, m))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall c: Nat;
      (forall i, m: Nat;
      peano_order.less_or_equal(c, succ(m)) ->
      peano_order.less_or_equal(m, i) ->
      tripleDiag(p, q, r, i, m, c) =
      mulR(cappedRun(p, q, m, c), coeff(r, theGapTo(i, m)))) ->
      (forall i, m: Nat;
      peano_order.less_or_equal(succ(c), succ(m)) ->
      peano_order.less_or_equal(m, i) ->
      tripleDiag(p, q, r, i, m, succ(c)) =
      mulR(cappedRun(p, q, m, succ(c)), coeff(r, theGapTo(i, m))))
    [by generalize generalize-p]
qed

// Lowering the amount taken raises the gap by one: `succ(gapTo(g, succ n)) = gapTo(g, n)`
// whenever `succ(n) <= g`. The bound is genuine — past it both gaps floor at ZERO and the
// successor on the left makes the two differ.
theorem theGapRisesWhenLessIsTaken: forall n, g: Nat;
  peano_order.less_or_equal(succ(n), g) ->
  succ(theGapTo(g, succ(n))) = theGapTo(g, n)
proof
  @base-case |
    forall g: Nat;
      peano_order.less_or_equal(succ(ZERO), g) ->
      succ(theGapTo(g, succ(ZERO))) = theGapTo(g, ZERO)
    [using specialize theGapRiseBase]
  @induction-step-for-all-n |
    forall n: Nat;
      (forall g: Nat;
      peano_order.less_or_equal(succ(n), g) ->
      succ(theGapTo(g, succ(n))) = theGapTo(g, n)) ->
      (forall g: Nat;
      peano_order.less_or_equal(succ(succ(n)), g) ->
      succ(theGapTo(g, succ(succ(n)))) = theGapTo(g, succ(n)))
    [using specialize theGapRiseStep]
  @conclusion |
    forall n: Nat; forall g: Nat;
      peano_order.less_or_equal(succ(n), g) ->
      succ(theGapTo(g, succ(n))) = theGapTo(g, n)
    [using instantiation peano.induction((fun z: Nat => forall g: Nat; peano_order.less_or_equal(succ(z), g) -> succ(theGapTo(g, succ(z))) = theGapTo(g, z))) base-case induction-step-for-all-n]
qed

// The base: g is a successor by the bound, and both sides read it directly.
theorem theGapRiseBase: forall g: Nat;
  peano_order.less_or_equal(succ(ZERO), g) ->
  succ(theGapTo(g, succ(ZERO))) = theGapTo(g, ZERO)
proof
  @generalize-g |
    fix g: Nat {
      @given-the-bound |
        assume peano_order.less_or_equal(succ(ZERO), g) {
          @the-bound |
            peano_order.less_or_equal(succ(ZERO), g)
            [by hypothesis given-the-bound]
          @g-is-positive |
            g = ZERO or (exists w: Nat; g = succ(w))
            [using specialize peano.zeroOrSucc(g)]
          @when-g-is-zero |
            assume g = ZERO {
              @g-is-zero |
                g = ZERO
                [by hypothesis when-g-is-zero]
              @the-bound-at-zero |
                peano_order.less_or_equal(succ(ZERO), ZERO)
                [by rewrite g-is-zero the-bound]
              @nothing-is-at-most-zero |
                not peano_order.less_or_equal(succ(ZERO), ZERO)
                [using specialize
                  peano_order.noSuccessorIsAtMostZero(ZERO)]
              @conclusion-vacuous |
                succ(theGapTo(g, succ(ZERO))) = theGapTo(g, ZERO)
                [by ex_falso the-bound-at-zero nothing-is-at-most-zero]
            }
          @when-g-is-positive |
            assume exists w: Nat; g = succ(w) {
              @the-predecessor-exists |
                exists w: Nat; g = succ(w)
                [by hypothesis when-g-is-positive]
              @with-the-predecessor |
                unpack w: Nat from the-predecessor-exists {
                  @g-steps |
                    g = succ(w)
                    [by hypothesis with-the-predecessor]
                  @the-taken-gap |
                    theGapTo(succ(w), succ(ZERO)) = theGapTo(w, ZERO)
                    [using specialize theGapToSteps(w, ZERO)]
                  @the-gap-at-w |
                    theGapTo(w, ZERO) = w
                    [using specialize theGapToAtZero(w)]
                  @the-full-gap |
                    theGapTo(succ(w), ZERO) = succ(w)
                    [using specialize theGapToAtZero(succ(w))]
                  @the-equality-at-w |
                    succ(theGapTo(succ(w), succ(ZERO))) =
                      theGapTo(succ(w), ZERO)
                    [using simplify the-taken-gap the-gap-at-w
                      the-full-gap]
                  @conclusion-positive |
                    succ(theGapTo(g, succ(ZERO))) = theGapTo(g, ZERO)
                    [by rewrite g-steps the-equality-at-w]
                }
              @conclusion-the-positive-case |
                succ(theGapTo(g, succ(ZERO))) = theGapTo(g, ZERO)
                [by unpacked with-the-predecessor]
            }
          @conclusion-either-way |
            succ(theGapTo(g, succ(ZERO))) = theGapTo(g, ZERO)
            [by common_conclusion g-is-positive
              when-g-is-zero when-g-is-positive]
        }
      @the-bound-gives-it |
        peano_order.less_or_equal(succ(ZERO), g) ->
          succ(theGapTo(g, succ(ZERO))) = theGapTo(g, ZERO)
        [by discharge given-the-bound]
    }
  @conclusion |
    forall g: Nat;
      peano_order.less_or_equal(succ(ZERO), g) ->
      succ(theGapTo(g, succ(ZERO))) = theGapTo(g, ZERO)
    [by generalize generalize-g]
qed

// The step: the bound forces g to be a successor, and all three gaps step down onto the
// hypothesis by their succ/succ clause.
theorem theGapRiseStep: forall n: Nat;
  (forall g: Nat;
  peano_order.less_or_equal(succ(n), g) ->
  succ(theGapTo(g, succ(n))) = theGapTo(g, n)) ->
  (forall g: Nat;
  peano_order.less_or_equal(succ(succ(n)), g) ->
  succ(theGapTo(g, succ(succ(n)))) = theGapTo(g, succ(n)))
proof
  @generalize-n |
    fix n: Nat {
      @given-the-hypothesis |
        assume forall g: Nat;
          peano_order.less_or_equal(succ(n), g) ->
          succ(theGapTo(g, succ(n))) = theGapTo(g, n) {
          @the-hypothesis |
            forall g: Nat;
              peano_order.less_or_equal(succ(n), g) ->
              succ(theGapTo(g, succ(n))) = theGapTo(g, n)
            [by hypothesis given-the-hypothesis]
          @generalize-g |
            fix g: Nat {
              @given-the-bound |
                assume peano_order.less_or_equal(succ(succ(n)), g) {
                  @the-bound |
                    peano_order.less_or_equal(succ(succ(n)), g)
                    [by hypothesis given-the-bound]
                  @g-is-positive |
                    g = ZERO or (exists w: Nat; g = succ(w))
                    [using specialize peano.zeroOrSucc(g)]
                  @when-g-is-zero |
                    assume g = ZERO {
                      @g-is-zero |
                        g = ZERO
                        [by hypothesis when-g-is-zero]
                      @the-bound-at-zero |
                        peano_order.less_or_equal(succ(succ(n)), ZERO)
                        [by rewrite g-is-zero the-bound]
                      @nothing-is-at-most-zero |
                        not peano_order.less_or_equal(succ(succ(n)), ZERO)
                        [using specialize
                          peano_order.noSuccessorIsAtMostZero(succ(n))]
                      @conclusion-vacuous |
                        succ(theGapTo(g, succ(succ(n)))) =
                          theGapTo(g, succ(n))
                        [by ex_falso the-bound-at-zero
                          nothing-is-at-most-zero]
                    }
                  @when-g-is-positive |
                    assume exists w: Nat; g = succ(w) {
                      @the-predecessor-exists |
                        exists w: Nat; g = succ(w)
                        [by hypothesis when-g-is-positive]
                      @with-the-predecessor |
                        unpack w: Nat from the-predecessor-exists {
                          @g-steps |
                            g = succ(w)
                            [by hypothesis with-the-predecessor]
                          @the-bound-steps |
                            peano_order.less_or_equal(succ(succ(n)),
                              succ(w))
                            [by rewrite g-steps the-bound]
                          @the-lower-bound |
                            peano_order.less_or_equal(succ(n), w)
                            [using specialize
                              peano_order.succReflectsAtMost(succ(n), w)
                              the-bound-steps]
                          @the-hypothesis-applies |
                            succ(theGapTo(w, succ(n))) = theGapTo(w, n)
                            [using specialize the-hypothesis(w)
                              the-lower-bound]
                          @the-taken-gap-steps |
                            theGapTo(succ(w), succ(succ(n))) =
                              theGapTo(w, succ(n))
                            [using specialize
                              theGapToSteps(w, succ(n))]
                          @the-target-gap-steps |
                            theGapTo(succ(w), succ(n)) = theGapTo(w, n)
                            [using specialize theGapToSteps(w, n)]
                          @the-equality-at-w |
                            succ(theGapTo(succ(w), succ(succ(n)))) =
                              theGapTo(succ(w), succ(n))
                            [using simplify the-taken-gap-steps
                              the-hypothesis-applies
                              the-target-gap-steps]
                          @conclusion-positive |
                            succ(theGapTo(g, succ(succ(n)))) =
                              theGapTo(g, succ(n))
                            [by rewrite g-steps the-equality-at-w]
                        }
                      @conclusion-the-positive-case |
                        succ(theGapTo(g, succ(succ(n)))) =
                          theGapTo(g, succ(n))
                        [by unpacked with-the-predecessor]
                    }
                  @conclusion-either-way |
                    succ(theGapTo(g, succ(succ(n)))) =
                      theGapTo(g, succ(n))
                    [by common_conclusion g-is-positive
                      when-g-is-zero when-g-is-positive]
                }
              @the-bound-gives-it |
                peano_order.less_or_equal(succ(succ(n)), g) ->
                  succ(theGapTo(g, succ(succ(n)))) = theGapTo(g, succ(n))
                [by discharge given-the-bound]
            }
          @all-gaps |
            forall g: Nat;
              peano_order.less_or_equal(succ(succ(n)), g) ->
              succ(theGapTo(g, succ(succ(n)))) = theGapTo(g, succ(n))
            [by generalize generalize-g]
        }
      @the-hypothesis-gives-it |
        (forall g: Nat;
          peano_order.less_or_equal(succ(n), g) ->
          succ(theGapTo(g, succ(n))) = theGapTo(g, n)) ->
          (forall g: Nat;
          peano_order.less_or_equal(succ(succ(n)), g) ->
          succ(theGapTo(g, succ(succ(n)))) = theGapTo(g, succ(n)))
        [by discharge given-the-hypothesis]
    }
  @conclusion |
    forall n: Nat;
      (forall g: Nat;
      peano_order.less_or_equal(succ(n), g) ->
      succ(theGapTo(g, succ(n))) = theGapTo(g, n)) ->
      (forall g: Nat;
      peano_order.less_or_equal(succ(succ(n)), g) ->
      succ(theGapTo(g, succ(succ(n)))) = theGapTo(g, succ(n)))
    [by generalize generalize-n]
qed

// -- THE CAPPED RUN READS AS A SEGMENT ------------------------------------------------------
// `cappedRun` walks its count at the back with p ASCENDING; `segment` peels at the front with
// p DESCENDING. They read the same terms in opposite order, so relating them is a sum
// reversal — and once related, `aFullSegmentReadsForwards` carries a full capped run to the
// convolution, which is what both associativity bridges need.
//
// Stated with the count free of the gap (`segment(p, q, n, theGapTo(g, n), n)`), so the
// induction can run on the count while the gap stays put; `theGapRisesWhenLessIsTaken` is what
// lets the segment's second exponent step.
theorem aCappedRunReadsAsASegment: forall p, q: Poly; forall n, g: Nat;
  peano_order.less_or_equal(n, g) ->
  cappedRun(p, q, g, succ(n)) = segment(p, q, n, theGapTo(g, n), n)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @base-case |
            forall g: Nat;
              peano_order.less_or_equal(ZERO, g) ->
              cappedRun(p, q, g, succ(ZERO)) =
              segment(p, q, ZERO, theGapTo(g, ZERO), ZERO)
            [using specialize theReadsAsBase(p, q)]
          @induction-step-for-all-n |
            forall n: Nat;
              (forall g: Nat;
              peano_order.less_or_equal(n, g) ->
              cappedRun(p, q, g, succ(n)) =
              segment(p, q, n, theGapTo(g, n), n)) ->
              (forall g: Nat;
              peano_order.less_or_equal(succ(n), g) ->
              cappedRun(p, q, g, succ(succ(n))) =
              segment(p, q, succ(n), theGapTo(g, succ(n)), succ(n)))
            [using specialize theReadsAsStep(p, q)]
          @all-counts |
            forall n: Nat; forall g: Nat;
              peano_order.less_or_equal(n, g) ->
              cappedRun(p, q, g, succ(n)) =
              segment(p, q, n, theGapTo(g, n), n)
            [using instantiation peano.induction((fun z: Nat => forall g: Nat; peano_order.less_or_equal(z, g) -> cappedRun(p, q, g, succ(z)) = segment(p, q, z, theGapTo(g, z), z))) base-case induction-step-for-all-n]
        }
      @discharge-q |
        forall q: Poly; forall n, g: Nat;
          peano_order.less_or_equal(n, g) ->
          cappedRun(p, q, g, succ(n)) = segment(p, q, n, theGapTo(g, n), n)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall n, g: Nat;
      peano_order.less_or_equal(n, g) ->
      cappedRun(p, q, g, succ(n)) = segment(p, q, n, theGapTo(g, n), n)
    [by generalize generalize-p]
qed

// The base: one term on each side, p_0 times q at the full gap.
theorem theReadsAsBase: forall p, q: Poly;
  forall g: Nat;
  peano_order.less_or_equal(ZERO, g) ->
  cappedRun(p, q, g, succ(ZERO)) =
  segment(p, q, ZERO, theGapTo(g, ZERO), ZERO)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-g |
            fix g: Nat {
              @the-run-at-one |
                cappedRun(p, q, g, succ(ZERO)) =
                  addR(cappedRun(p, q, g, ZERO),
                  mulR(coeff(p, ZERO), coeff(q, theGapTo(g, ZERO))))
                [using specialize cappedRunSucc(p, q, g, ZERO)]
              @the-empty-run |
                cappedRun(p, q, g, ZERO) = zeroR
                [using specialize cappedRunZero(p, q, g)]
              @adding-nothing |
                addR(zeroR,
                  mulR(coeff(p, ZERO), coeff(q, theGapTo(g, ZERO)))) =
                  mulR(coeff(p, ZERO), coeff(q, theGapTo(g, ZERO)))
                [using specialize addZeroLeftR(mulR(coeff(p, ZERO),
                  coeff(q, theGapTo(g, ZERO))))]
              @the-segment-at-zero |
                segment(p, q, ZERO, theGapTo(g, ZERO), ZERO) =
                  mulR(coeff(p, ZERO), coeff(q, theGapTo(g, ZERO)))
                [using specialize
                  segmentZero(p, q, ZERO, theGapTo(g, ZERO))]
              @the-equality |
                cappedRun(p, q, g, succ(ZERO)) =
                  segment(p, q, ZERO, theGapTo(g, ZERO), ZERO)
                [using simplify the-run-at-one the-empty-run
                  adding-nothing the-segment-at-zero]
              @conclusion-the-base |
                peano_order.less_or_equal(ZERO, g) ->
                  cappedRun(p, q, g, succ(ZERO)) =
                  segment(p, q, ZERO, theGapTo(g, ZERO), ZERO)
                [using tautology the-equality]
            }
          @discharge-g |
            forall g: Nat;
              peano_order.less_or_equal(ZERO, g) ->
              cappedRun(p, q, g, succ(ZERO)) =
              segment(p, q, ZERO, theGapTo(g, ZERO), ZERO)
            [by generalize generalize-g]
        }
      @discharge-q |
        forall q: Poly; forall g: Nat;
          peano_order.less_or_equal(ZERO, g) ->
          cappedRun(p, q, g, succ(ZERO)) =
          segment(p, q, ZERO, theGapTo(g, ZERO), ZERO)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall g: Nat;
      peano_order.less_or_equal(ZERO, g) ->
      cappedRun(p, q, g, succ(ZERO)) =
      segment(p, q, ZERO, theGapTo(g, ZERO), ZERO)
    [by generalize generalize-p]
qed

// The step: the run gains its term at count succ(n); the segment peels the SAME term at its
// front and leaves the segment one shorter with its second exponent raised — which
// `theGapRisesWhenLessIsTaken` identifies with the hypothesis's gap. The two summands then
// swap by commutativity.
theorem theReadsAsStep: forall p, q: Poly; forall n: Nat;
  (forall g: Nat;
  peano_order.less_or_equal(n, g) ->
  cappedRun(p, q, g, succ(n)) = segment(p, q, n, theGapTo(g, n), n)) ->
  (forall g: Nat;
  peano_order.less_or_equal(succ(n), g) ->
  cappedRun(p, q, g, succ(succ(n))) =
  segment(p, q, succ(n), theGapTo(g, succ(n)), succ(n)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-n |
            fix n: Nat {
              @given-the-hypothesis |
                assume forall g: Nat;
                  peano_order.less_or_equal(n, g) ->
                  cappedRun(p, q, g, succ(n)) =
                  segment(p, q, n, theGapTo(g, n), n) {
                  @the-hypothesis |
                    forall g: Nat;
                      peano_order.less_or_equal(n, g) ->
                      cappedRun(p, q, g, succ(n)) =
                      segment(p, q, n, theGapTo(g, n), n)
                    [by hypothesis given-the-hypothesis]
                  @generalize-g |
                    fix g: Nat {
                      @given-the-bound |
                        assume peano_order.less_or_equal(succ(n), g) {
                          @the-bound |
                            peano_order.less_or_equal(succ(n), g)
                            [by hypothesis given-the-bound]
                          @n-is-below-its-successor |
                            peano_order.less_or_equal(n, succ(n))
                            [using specialize
                              peano_order.aNatIsAtMostItsSuccessor(n)]
                          @the-lower-bound |
                            peano_order.less_or_equal(n, g)
                            [using specialize
                              peano_order.lessOrEqualTransitive(n,
                              succ(n), g) n-is-below-its-successor
                              the-bound]
                          @the-hypothesis-applies |
                            cappedRun(p, q, g, succ(n)) =
                              segment(p, q, n, theGapTo(g, n), n)
                            [using specialize the-hypothesis(g)
                              the-lower-bound]
                          @the-run-grows |
                            cappedRun(p, q, g, succ(succ(n))) =
                              addR(cappedRun(p, q, g, succ(n)),
                              mulR(coeff(p, succ(n)),
                              coeff(q, theGapTo(g, succ(n)))))
                            [using specialize
                              cappedRunSucc(p, q, g, succ(n))]
                          @the-segment-peels |
                            segment(p, q, succ(n),
                              theGapTo(g, succ(n)), succ(n)) =
                              addR(mulR(coeff(p, succ(n)),
                              coeff(q, theGapTo(g, succ(n)))),
                              segment(p, q, n,
                              succ(theGapTo(g, succ(n))), n))
                            [using specialize segmentSucc(p, q, n,
                              theGapTo(g, succ(n)), n)]
                          @the-gap-rises |
                            succ(theGapTo(g, succ(n))) = theGapTo(g, n)
                            [using specialize
                              theGapRisesWhenLessIsTaken(n, g) the-bound]
                          @the-segment-tail-matches |
                            segment(p, q, n,
                              succ(theGapTo(g, succ(n))), n) =
                              segment(p, q, n, theGapTo(g, n), n)
                            [by rewrite the-gap-rises
                              the-tail-reflexivity]
                          @the-tail-reflexivity |
                            segment(p, q, n, theGapTo(g, n), n) =
                              segment(p, q, n, theGapTo(g, n), n)
                            [by reflexivity]
                          @the-segment-expanded |
                            segment(p, q, succ(n),
                              theGapTo(g, succ(n)), succ(n)) =
                              addR(mulR(coeff(p, succ(n)),
                              coeff(q, theGapTo(g, succ(n)))),
                              segment(p, q, n, theGapTo(g, n), n))
                            [using simplify the-segment-peels
                              the-segment-tail-matches]
                          @the-run-expanded |
                            cappedRun(p, q, g, succ(succ(n))) =
                              addR(segment(p, q, n, theGapTo(g, n), n),
                              mulR(coeff(p, succ(n)),
                              coeff(q, theGapTo(g, succ(n)))))
                            [using simplify the-run-grows
                              the-hypothesis-applies]
                          @the-summands-swap |
                            addR(segment(p, q, n, theGapTo(g, n), n),
                              mulR(coeff(p, succ(n)),
                              coeff(q, theGapTo(g, succ(n))))) =
                              addR(mulR(coeff(p, succ(n)),
                              coeff(q, theGapTo(g, succ(n)))),
                              segment(p, q, n, theGapTo(g, n), n))
                            [using specialize addIsCommutativeR(
                              segment(p, q, n, theGapTo(g, n), n),
                              mulR(coeff(p, succ(n)),
                              coeff(q, theGapTo(g, succ(n)))))]
                          @the-segment-flipped |
                            addR(mulR(coeff(p, succ(n)),
                              coeff(q, theGapTo(g, succ(n)))),
                              segment(p, q, n, theGapTo(g, n), n)) =
                              segment(p, q, succ(n),
                              theGapTo(g, succ(n)), succ(n))
                            [by symmetry the-segment-expanded]
                          @conclusion-the-step |
                            cappedRun(p, q, g, succ(succ(n))) =
                              segment(p, q, succ(n),
                              theGapTo(g, succ(n)), succ(n))
                            [using chain the-run-expanded
                              the-summands-swap the-segment-flipped]
                        }
                      @the-bound-gives-it |
                        peano_order.less_or_equal(succ(n), g) ->
                          cappedRun(p, q, g, succ(succ(n))) =
                          segment(p, q, succ(n),
                          theGapTo(g, succ(n)), succ(n))
                        [by discharge given-the-bound]
                    }
                  @all-gaps |
                    forall g: Nat;
                      peano_order.less_or_equal(succ(n), g) ->
                      cappedRun(p, q, g, succ(succ(n))) =
                      segment(p, q, succ(n),
                      theGapTo(g, succ(n)), succ(n))
                    [by generalize generalize-g]
                }
              @the-hypothesis-gives-it |
                (forall g: Nat;
                  peano_order.less_or_equal(n, g) ->
                  cappedRun(p, q, g, succ(n)) =
                  segment(p, q, n, theGapTo(g, n), n)) ->
                  (forall g: Nat;
                  peano_order.less_or_equal(succ(n), g) ->
                  cappedRun(p, q, g, succ(succ(n))) =
                  segment(p, q, succ(n),
                  theGapTo(g, succ(n)), succ(n)))
                [by discharge given-the-hypothesis]
            }
          @discharge-n |
            forall n: Nat;
              (forall g: Nat;
              peano_order.less_or_equal(n, g) ->
              cappedRun(p, q, g, succ(n)) =
              segment(p, q, n, theGapTo(g, n), n)) ->
              (forall g: Nat;
              peano_order.less_or_equal(succ(n), g) ->
              cappedRun(p, q, g, succ(succ(n))) =
              segment(p, q, succ(n), theGapTo(g, succ(n)), succ(n)))
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q: Poly; forall n: Nat;
          (forall g: Nat;
          peano_order.less_or_equal(n, g) ->
          cappedRun(p, q, g, succ(n)) =
          segment(p, q, n, theGapTo(g, n), n)) ->
          (forall g: Nat;
          peano_order.less_or_equal(succ(n), g) ->
          cappedRun(p, q, g, succ(succ(n))) =
          segment(p, q, succ(n), theGapTo(g, succ(n)), succ(n)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall n: Nat;
      (forall g: Nat;
      peano_order.less_or_equal(n, g) ->
      cappedRun(p, q, g, succ(n)) =
      segment(p, q, n, theGapTo(g, n), n)) ->
      (forall g: Nat;
      peano_order.less_or_equal(succ(n), g) ->
      cappedRun(p, q, g, succ(succ(n))) =
      segment(p, q, succ(n), theGapTo(g, succ(n)), succ(n)))
    [by generalize generalize-p]
qed

// -- A FULL CAPPED RUN IS THE CONVOLUTION ---------------------------------------------------
// At its full length the capped run reads every pair summing to `g`, which is what
// `convolution(p, q, ZERO, g)` reads. Composed: the run reads as a segment
// (`aCappedRunReadsAsASegment` at n = g, where the gap closes to ZERO), and a full segment
// reads forwards as the convolution (`aFullSegmentReadsForwards`, already proved for
// commutativity). With `mulPolyCoeff` this makes a full run a product COEFFICIENT, which is
// what both associativity bridges turn on.
theorem aFullCappedRunIsTheConvolution: forall p, q: Poly; forall g: Nat;
  cappedRun(p, q, g, succ(g)) = convolution(p, q, ZERO, g)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-g |
            fix g: Nat {
              @g-is-at-most-itself |
                peano_order.less_or_equal(g, g)
                [using specialize peano_order.lessOrEqualRefl(g)]
              @the-run-reads-as-a-segment |
                cappedRun(p, q, g, succ(g)) =
                  segment(p, q, g, theGapTo(g, g), g)
                [using specialize aCappedRunReadsAsASegment(p, q, g, g)
                  g-is-at-most-itself]
              @the-gap-closes |
                theGapTo(g, g) = ZERO
                [using specialize theGapToSelfVanishes(g)]
              @the-segment-at-zero |
                segment(p, q, g, theGapTo(g, g), g) =
                  segment(p, q, g, ZERO, g)
                [by rewrite the-gap-closes]
              @the-segment-reads-forwards |
                segment(p, q, g, ZERO, g) = convolution(p, q, ZERO, g)
                [using specialize aFullSegmentReadsForwards(p, q, g)]
              @conclusion-the-full-run |
                cappedRun(p, q, g, succ(g)) = convolution(p, q, ZERO, g)
                [using chain the-run-reads-as-a-segment
                  the-segment-at-zero the-segment-reads-forwards]
            }
          @discharge-g |
            forall g: Nat;
              cappedRun(p, q, g, succ(g)) = convolution(p, q, ZERO, g)
            [by generalize generalize-g]
        }
      @discharge-q |
        forall q: Poly; forall g: Nat;
          cappedRun(p, q, g, succ(g)) = convolution(p, q, ZERO, g)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall g: Nat;
      cappedRun(p, q, g, succ(g)) = convolution(p, q, ZERO, g)
    [by generalize generalize-p]
qed

// A full capped run IS a product coefficient — the form the bridges consume.
theorem aFullCappedRunIsTheProductCoefficient: forall p, q: Poly;
  forall g: Nat;
  cappedRun(p, q, g, succ(g)) = coeff(mulP(p, q), g)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-g |
            fix g: Nat {
              @the-full-run |
                cappedRun(p, q, g, succ(g)) = convolution(p, q, ZERO, g)
                [using specialize aFullCappedRunIsTheConvolution(p, q, g)]
              @the-coefficient-is-the-run |
                coeff(mulP(p, q), g) = convolution(p, q, ZERO, g)
                [using specialize mulPolyCoeff(p, q, g)]
              @the-run-is-the-coefficient |
                convolution(p, q, ZERO, g) = coeff(mulP(p, q), g)
                [by symmetry the-coefficient-is-the-run]
              @conclusion-the-run-is-a-coefficient |
                cappedRun(p, q, g, succ(g)) = coeff(mulP(p, q), g)
                [using chain the-full-run the-run-is-the-coefficient]
            }
          @discharge-g |
            forall g: Nat;
              cappedRun(p, q, g, succ(g)) = coeff(mulP(p, q), g)
            [by generalize generalize-g]
        }
      @discharge-q |
        forall q: Poly; forall g: Nat;
          cappedRun(p, q, g, succ(g)) = coeff(mulP(p, q), g)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Poly; forall g: Nat;
      cappedRun(p, q, g, succ(g)) = coeff(mulP(p, q), g)
    [by generalize generalize-p]
qed

// -- BRIDGE 1: the triangle IS the left run -------------------------------------------------
// Each complete anti-diagonal is `coeff(pq, n)` scaled by r at the complementary index —
// Lemma C at count succ(n), then the full-run bridge — which is exactly the term
// `cappedRun(pq, r, i, ·)` gains at count n. Both accumulate the same terms in the same
// order, so the induction is a term-by-term match on the count, with `n <= i` travelling
// inside for Lemma C.
theorem theTriangleIsTheLeftRun: forall p, q, r: Poly; forall n, i: Nat;
  peano_order.less_or_equal(n, succ(i)) ->
  tripleTri(p, q, r, i, n) = cappedRun(mulP(p, q), r, i, n)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @base-case |
                forall i: Nat;
                  peano_order.less_or_equal(ZERO, succ(i)) ->
                  tripleTri(p, q, r, i, ZERO) =
                  cappedRun(mulP(p, q), r, i, ZERO)
                [using specialize theLeftRunBase(p, q, r)]
              @induction-step-for-all-n |
                forall n: Nat;
                  (forall i: Nat;
                  peano_order.less_or_equal(n, succ(i)) ->
                  tripleTri(p, q, r, i, n) =
                  cappedRun(mulP(p, q), r, i, n)) ->
                  (forall i: Nat;
                  peano_order.less_or_equal(succ(n), succ(i)) ->
                  tripleTri(p, q, r, i, succ(n)) =
                  cappedRun(mulP(p, q), r, i, succ(n)))
                [using specialize theLeftRunStep(p, q, r)]
              @all-counts |
                forall n: Nat; forall i: Nat;
                  peano_order.less_or_equal(n, succ(i)) ->
                  tripleTri(p, q, r, i, n) =
                  cappedRun(mulP(p, q), r, i, n)
                [using instantiation peano.induction((fun z: Nat => forall i: Nat; peano_order.less_or_equal(z, succ(i)) -> tripleTri(p, q, r, i, z) = cappedRun(mulP(p, q), r, i, z))) base-case induction-step-for-all-n]
            }
          @discharge-r |
            forall r: Poly; forall n, i: Nat;
              peano_order.less_or_equal(n, succ(i)) ->
              tripleTri(p, q, r, i, n) = cappedRun(mulP(p, q), r, i, n)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall n, i: Nat;
          peano_order.less_or_equal(n, succ(i)) ->
          tripleTri(p, q, r, i, n) = cappedRun(mulP(p, q), r, i, n)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall n, i: Nat;
      peano_order.less_or_equal(n, succ(i)) ->
      tripleTri(p, q, r, i, n) = cappedRun(mulP(p, q), r, i, n)
    [by generalize generalize-p]
qed

// The base: both are empty.
theorem theLeftRunBase: forall p, q, r: Poly;
  forall i: Nat;
  peano_order.less_or_equal(ZERO, succ(i)) ->
  tripleTri(p, q, r, i, ZERO) = cappedRun(mulP(p, q), r, i, ZERO)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @the-empty-triangle |
                    tripleTri(p, q, r, i, ZERO) = zeroR
                    [using specialize tripleTriZero(p, q, r, i)]
                  @the-empty-run |
                    cappedRun(mulP(p, q), r, i, ZERO) = zeroR
                    [using specialize cappedRunZero(mulP(p, q), r, i)]
                  @the-equality |
                    tripleTri(p, q, r, i, ZERO) =
                      cappedRun(mulP(p, q), r, i, ZERO)
                    [using simplify the-empty-triangle the-empty-run]
                  @conclusion-the-base |
                    peano_order.less_or_equal(ZERO, succ(i)) ->
                      tripleTri(p, q, r, i, ZERO) =
                      cappedRun(mulP(p, q), r, i, ZERO)
                    [using tautology the-equality]
                }
              @discharge-i |
                forall i: Nat;
                  peano_order.less_or_equal(ZERO, succ(i)) ->
                  tripleTri(p, q, r, i, ZERO) =
                  cappedRun(mulP(p, q), r, i, ZERO)
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i: Nat;
              peano_order.less_or_equal(ZERO, succ(i)) ->
              tripleTri(p, q, r, i, ZERO) =
              cappedRun(mulP(p, q), r, i, ZERO)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i: Nat;
          peano_order.less_or_equal(ZERO, succ(i)) ->
          tripleTri(p, q, r, i, ZERO) =
          cappedRun(mulP(p, q), r, i, ZERO)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i: Nat;
      peano_order.less_or_equal(ZERO, succ(i)) ->
      tripleTri(p, q, r, i, ZERO) = cappedRun(mulP(p, q), r, i, ZERO)
    [by generalize generalize-p]
qed

// The step: the triangle gains its n-th complete anti-diagonal; Lemma C at count succ(n) and
// the full-run bridge make it `coeff(pq, n)` times r at the complement, which is the term the
// run gains at count n.
theorem theLeftRunStep: forall p, q, r: Poly; forall n: Nat;
  (forall i: Nat;
  peano_order.less_or_equal(n, succ(i)) ->
  tripleTri(p, q, r, i, n) = cappedRun(mulP(p, q), r, i, n)) ->
  (forall i: Nat;
  peano_order.less_or_equal(succ(n), succ(i)) ->
  tripleTri(p, q, r, i, succ(n)) = cappedRun(mulP(p, q), r, i, succ(n)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-n |
                fix n: Nat {
                  @given-the-hypothesis |
                    assume forall i: Nat;
                      peano_order.less_or_equal(n, succ(i)) ->
                      tripleTri(p, q, r, i, n) =
                      cappedRun(mulP(p, q), r, i, n) {
                      @the-hypothesis |
                        forall i: Nat;
                          peano_order.less_or_equal(n, succ(i)) ->
                          tripleTri(p, q, r, i, n) =
                          cappedRun(mulP(p, q), r, i, n)
                        [by hypothesis given-the-hypothesis]
                      @generalize-i |
                        fix i: Nat {
                          @given-the-bound |
                            assume peano_order.less_or_equal(succ(n),
                              succ(i)) {
                              @the-bound |
                                peano_order.less_or_equal(succ(n), succ(i))
                                [by hypothesis given-the-bound]
                              @n-is-within-i |
                                peano_order.less_or_equal(n, i)
                                [using specialize
                                  peano_order.succReflectsAtMost(n, i)
                                  the-bound]
                              @n-is-below-its-successor |
                                peano_order.less_or_equal(n, succ(n))
                                [using specialize
                                  peano_order.aNatIsAtMostItsSuccessor(n)]
                              @n-is-within-succ-i |
                                peano_order.less_or_equal(n, succ(i))
                                [using specialize
                                  peano_order.lessOrEqualTransitive(n,
                                  succ(n), succ(i))
                                  n-is-below-its-successor the-bound]
                              @the-hypothesis-applies |
                                tripleTri(p, q, r, i, n) =
                                  cappedRun(mulP(p, q), r, i, n)
                                [using specialize the-hypothesis(i)
                                  n-is-within-succ-i]
                              @the-count-is-within |
                                peano_order.less_or_equal(succ(n), succ(n))
                                [using specialize
                                  peano_order.lessOrEqualRefl(succ(n))]
                              @the-triangle-grows |
                                tripleTri(p, q, r, i, succ(n)) =
                                  addR(tripleTri(p, q, r, i, n),
                                  tripleDiag(p, q, r, i, n, succ(n)))
                                [using specialize
                                  tripleTriSucc(p, q, r, i, n)]
                              @the-diagonal-scales |
                                tripleDiag(p, q, r, i, n, succ(n)) =
                                  mulR(cappedRun(p, q, n, succ(n)),
                                  coeff(r, theGapTo(i, n)))
                                [using specialize
                                  aDiagonalIsTheScaledRun(p, q, r,
                                  succ(n), i, n) the-count-is-within
                                  n-is-within-i]
                              @the-full-run-is-a-coefficient |
                                cappedRun(p, q, n, succ(n)) =
                                  coeff(mulP(p, q), n)
                                [using specialize
                                  aFullCappedRunIsTheProductCoefficient(p,
                                  q, n)]
                              @the-run-grows |
                                cappedRun(mulP(p, q), r, i, succ(n)) =
                                  addR(cappedRun(mulP(p, q), r, i, n),
                                  mulR(coeff(mulP(p, q), n),
                                  coeff(r, theGapTo(i, n))))
                                [using specialize
                                  cappedRunSucc(mulP(p, q), r, i, n)]
                              @conclusion-the-step |
                                tripleTri(p, q, r, i, succ(n)) =
                                  cappedRun(mulP(p, q), r, i, succ(n))
                                [using simplify the-triangle-grows
                                  the-hypothesis-applies
                                  the-diagonal-scales
                                  the-full-run-is-a-coefficient
                                  the-run-grows]
                            }
                          @the-bound-gives-it |
                            peano_order.less_or_equal(succ(n), succ(i)) ->
                              tripleTri(p, q, r, i, succ(n)) =
                              cappedRun(mulP(p, q), r, i, succ(n))
                            [by discharge given-the-bound]
                        }
                      @all-indices |
                        forall i: Nat;
                          peano_order.less_or_equal(succ(n), succ(i)) ->
                          tripleTri(p, q, r, i, succ(n)) =
                          cappedRun(mulP(p, q), r, i, succ(n))
                        [by generalize generalize-i]
                    }
                  @the-hypothesis-gives-it |
                    (forall i: Nat;
                      peano_order.less_or_equal(n, succ(i)) ->
                      tripleTri(p, q, r, i, n) =
                      cappedRun(mulP(p, q), r, i, n)) ->
                      (forall i: Nat;
                      peano_order.less_or_equal(succ(n), succ(i)) ->
                      tripleTri(p, q, r, i, succ(n)) =
                      cappedRun(mulP(p, q), r, i, succ(n)))
                    [by discharge given-the-hypothesis]
                }
              @discharge-n |
                forall n: Nat;
                  (forall i: Nat;
                  peano_order.less_or_equal(n, succ(i)) ->
                  tripleTri(p, q, r, i, n) =
                  cappedRun(mulP(p, q), r, i, n)) ->
                  (forall i: Nat;
                  peano_order.less_or_equal(succ(n), succ(i)) ->
                  tripleTri(p, q, r, i, succ(n)) =
                  cappedRun(mulP(p, q), r, i, succ(n)))
                [by generalize generalize-n]
            }
          @discharge-r |
            forall r: Poly; forall n: Nat;
              (forall i: Nat;
              peano_order.less_or_equal(n, succ(i)) ->
              tripleTri(p, q, r, i, n) =
              cappedRun(mulP(p, q), r, i, n)) ->
              (forall i: Nat;
              peano_order.less_or_equal(succ(n), succ(i)) ->
              tripleTri(p, q, r, i, succ(n)) =
              cappedRun(mulP(p, q), r, i, succ(n)))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall n: Nat;
          (forall i: Nat;
          peano_order.less_or_equal(n, succ(i)) ->
          tripleTri(p, q, r, i, n) =
          cappedRun(mulP(p, q), r, i, n)) ->
          (forall i: Nat;
          peano_order.less_or_equal(succ(n), succ(i)) ->
          tripleTri(p, q, r, i, succ(n)) =
          cappedRun(mulP(p, q), r, i, succ(n)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall n: Nat;
      (forall i: Nat;
      peano_order.less_or_equal(n, succ(i)) ->
      tripleTri(p, q, r, i, n) = cappedRun(mulP(p, q), r, i, n)) ->
      (forall i: Nat;
      peano_order.less_or_equal(succ(n), succ(i)) ->
      tripleTri(p, q, r, i, succ(n)) = cappedRun(mulP(p, q), r, i, succ(n)))
    [by generalize generalize-p]
qed

// -- BRIDGE 2: the shortened rows ARE the right run -----------------------------------------
// Row `m` at bound `succ(i)` runs `theGapTo(succ i, m)` = `succ(theGapTo(i, m))` entries —
// the full inner run — so Lemma D plus the full-run bridge make it `p_m` times
// `coeff(qr, theGapTo(i, m))`, which is the term `cappedRun(p, qr, i, ·)` gains at count m.
// The bound `m <= i` travels inside, for `theRaisedGapSteps` to raise the row's length.
theorem theShortenedRowsAreTheRightRun: forall p, q, r: Poly; forall m, i: Nat;
  peano_order.less_or_equal(m, succ(i)) ->
  tripleRows(p, q, r, i, m, succ(i)) =
  cappedRun(p, mulP(q, r), i, m)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @base-case |
                forall i: Nat;
                  peano_order.less_or_equal(ZERO, succ(i)) ->
                  tripleRows(p, q, r, i, ZERO, succ(i)) =
                  cappedRun(p, mulP(q, r), i, ZERO)
                [using specialize theRightRunBase(p, q, r)]
              @induction-step-for-all-m |
                forall m: Nat;
                  (forall i: Nat;
                  peano_order.less_or_equal(m, succ(i)) ->
                  tripleRows(p, q, r, i, m, succ(i)) =
                  cappedRun(p, mulP(q, r), i, m)) ->
                  (forall i: Nat;
                  peano_order.less_or_equal(succ(m), succ(i)) ->
                  tripleRows(p, q, r, i, succ(m), succ(i)) =
                  cappedRun(p, mulP(q, r), i, succ(m)))
                [using specialize theRightRunStep(p, q, r)]
              @all-counts |
                forall m: Nat; forall i: Nat;
                  peano_order.less_or_equal(m, succ(i)) ->
                  tripleRows(p, q, r, i, m, succ(i)) =
                  cappedRun(p, mulP(q, r), i, m)
                [using instantiation peano.induction((fun z: Nat => forall i: Nat; peano_order.less_or_equal(z, succ(i)) -> tripleRows(p, q, r, i, z, succ(i)) = cappedRun(p, mulP(q, r), i, z))) base-case induction-step-for-all-m]
            }
          @discharge-r |
            forall r: Poly; forall m, i: Nat;
              peano_order.less_or_equal(m, succ(i)) ->
              tripleRows(p, q, r, i, m, succ(i)) =
              cappedRun(p, mulP(q, r), i, m)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall m, i: Nat;
          peano_order.less_or_equal(m, succ(i)) ->
          tripleRows(p, q, r, i, m, succ(i)) =
          cappedRun(p, mulP(q, r), i, m)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall m, i: Nat;
      peano_order.less_or_equal(m, succ(i)) ->
      tripleRows(p, q, r, i, m, succ(i)) = cappedRun(p, mulP(q, r), i, m)
    [by generalize generalize-p]
qed

// The base: both are empty.
theorem theRightRunBase: forall p, q, r: Poly;
  forall i: Nat;
  peano_order.less_or_equal(ZERO, succ(i)) ->
  tripleRows(p, q, r, i, ZERO, succ(i)) =
  cappedRun(p, mulP(q, r), i, ZERO)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @the-empty-rows |
                    tripleRows(p, q, r, i, ZERO, succ(i)) = zeroR
                    [using specialize
                      tripleRowsZero(p, q, r, i, succ(i))]
                  @the-empty-run |
                    cappedRun(p, mulP(q, r), i, ZERO) = zeroR
                    [using specialize cappedRunZero(p, mulP(q, r), i)]
                  @the-equality |
                    tripleRows(p, q, r, i, ZERO, succ(i)) =
                      cappedRun(p, mulP(q, r), i, ZERO)
                    [using simplify the-empty-rows the-empty-run]
                  @conclusion-the-base |
                    peano_order.less_or_equal(ZERO, succ(i)) ->
                      tripleRows(p, q, r, i, ZERO, succ(i)) =
                      cappedRun(p, mulP(q, r), i, ZERO)
                    [using tautology the-equality]
                }
              @discharge-i |
                forall i: Nat;
                  peano_order.less_or_equal(ZERO, succ(i)) ->
                  tripleRows(p, q, r, i, ZERO, succ(i)) =
                  cappedRun(p, mulP(q, r), i, ZERO)
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i: Nat;
              peano_order.less_or_equal(ZERO, succ(i)) ->
              tripleRows(p, q, r, i, ZERO, succ(i)) =
              cappedRun(p, mulP(q, r), i, ZERO)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i: Nat;
          peano_order.less_or_equal(ZERO, succ(i)) ->
          tripleRows(p, q, r, i, ZERO, succ(i)) =
          cappedRun(p, mulP(q, r), i, ZERO)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i: Nat;
      peano_order.less_or_equal(ZERO, succ(i)) ->
      tripleRows(p, q, r, i, ZERO, succ(i)) =
      cappedRun(p, mulP(q, r), i, ZERO)
    [by generalize generalize-p]
qed

// The step: the rows gain row `m` at length `theGapTo(succ i, m)`, which `theRaisedGapSteps`
// identifies with `succ(theGapTo(i, m))` — the FULL inner run — so Lemma D and the full-run
// bridge make it `p_m` times `coeff(qr, theGapTo(i, m))`, the term the run gains at count m.
theorem theRightRunStep: forall p, q, r: Poly; forall m: Nat;
  (forall i: Nat;
  peano_order.less_or_equal(m, succ(i)) ->
  tripleRows(p, q, r, i, m, succ(i)) =
  cappedRun(p, mulP(q, r), i, m)) ->
  (forall i: Nat;
  peano_order.less_or_equal(succ(m), succ(i)) ->
  tripleRows(p, q, r, i, succ(m), succ(i)) =
  cappedRun(p, mulP(q, r), i, succ(m)))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-m |
                fix m: Nat {
                  @given-the-hypothesis |
                    assume forall i: Nat;
                      peano_order.less_or_equal(m, succ(i)) ->
                      tripleRows(p, q, r, i, m, succ(i)) =
                      cappedRun(p, mulP(q, r), i, m) {
                      @the-hypothesis |
                        forall i: Nat;
                          peano_order.less_or_equal(m, succ(i)) ->
                          tripleRows(p, q, r, i, m, succ(i)) =
                          cappedRun(p, mulP(q, r), i, m)
                        [by hypothesis given-the-hypothesis]
                      @generalize-i |
                        fix i: Nat {
                          @given-the-bound |
                            assume peano_order.less_or_equal(succ(m),
                              succ(i)) {
                              @the-bound |
                                peano_order.less_or_equal(succ(m), succ(i))
                                [by hypothesis given-the-bound]
                              @m-is-within-i |
                                peano_order.less_or_equal(m, i)
                                [using specialize
                                  peano_order.succReflectsAtMost(m, i)
                                  the-bound]
                              @m-is-below-its-successor |
                                peano_order.less_or_equal(m, succ(m))
                                [using specialize
                                  peano_order.aNatIsAtMostItsSuccessor(m)]
                              @m-is-within-succ-i |
                                peano_order.less_or_equal(m, succ(i))
                                [using specialize
                                  peano_order.lessOrEqualTransitive(m,
                                  succ(m), succ(i))
                                  m-is-below-its-successor the-bound]
                              @the-hypothesis-applies |
                                tripleRows(p, q, r, i, m, succ(i)) =
                                  cappedRun(p, mulP(q, r), i, m)
                                [using specialize the-hypothesis(i)
                                  m-is-within-succ-i]
                              @the-rows-grow |
                                tripleRows(p, q, r, i, succ(m), succ(i)) =
                                  addR(tripleRows(p, q, r, i, m, succ(i)),
                                  tripleRow(p, q, r, i, m,
                                  theGapTo(succ(i), m)))
                                [using specialize
                                  tripleRowsSucc(p, q, r, i, m, succ(i))]
                              @the-row-length-is-full |
                                theGapTo(succ(i), m) =
                                  succ(theGapTo(i, m))
                                [using specialize
                                  theRaisedGapSteps(m, i) m-is-within-i]
                              @the-row-reflexivity |
                                tripleRow(p, q, r, i, m,
                                  succ(theGapTo(i, m))) =
                                  tripleRow(p, q, r, i, m,
                                  succ(theGapTo(i, m)))
                                [by reflexivity]
                              @the-row-at-the-full-length |
                                tripleRow(p, q, r, i, m,
                                  theGapTo(succ(i), m)) =
                                  tripleRow(p, q, r, i, m,
                                  succ(theGapTo(i, m)))
                                [by rewrite the-row-length-is-full
                                  the-row-reflexivity]
                              @the-row-scales |
                                tripleRow(p, q, r, i, m,
                                  succ(theGapTo(i, m))) =
                                  mulR(coeff(p, m),
                                  cappedRun(q, r, theGapTo(i, m),
                                  succ(theGapTo(i, m))))
                                [using specialize
                                  aRowIsTheScaledRun(p, q, r,
                                  succ(theGapTo(i, m)), i, m)]
                              @the-inner-full-run |
                                cappedRun(q, r, theGapTo(i, m),
                                  succ(theGapTo(i, m))) =
                                  coeff(mulP(q, r), theGapTo(i, m))
                                [using specialize
                                  aFullCappedRunIsTheProductCoefficient(q,
                                  r, theGapTo(i, m))]
                              @the-run-grows |
                                cappedRun(p, mulP(q, r), i, succ(m)) =
                                  addR(cappedRun(p, mulP(q, r), i, m),
                                  mulR(coeff(p, m),
                                  coeff(mulP(q, r), theGapTo(i, m))))
                                [using specialize
                                  cappedRunSucc(p, mulP(q, r), i, m)]
                              @conclusion-the-step |
                                tripleRows(p, q, r, i, succ(m), succ(i)) =
                                  cappedRun(p, mulP(q, r), i, succ(m))
                                [using simplify the-rows-grow
                                  the-hypothesis-applies
                                  the-row-at-the-full-length
                                  the-row-scales the-inner-full-run
                                  the-run-grows]
                            }
                          @the-bound-gives-it |
                            peano_order.less_or_equal(succ(m), succ(i)) ->
                              tripleRows(p, q, r, i, succ(m), succ(i)) =
                              cappedRun(p, mulP(q, r), i, succ(m))
                            [by discharge given-the-bound]
                        }
                      @all-indices |
                        forall i: Nat;
                          peano_order.less_or_equal(succ(m), succ(i)) ->
                          tripleRows(p, q, r, i, succ(m), succ(i)) =
                          cappedRun(p, mulP(q, r), i, succ(m))
                        [by generalize generalize-i]
                    }
                  @the-hypothesis-gives-it |
                    (forall i: Nat;
                      peano_order.less_or_equal(m, succ(i)) ->
                      tripleRows(p, q, r, i, m, succ(i)) =
                      cappedRun(p, mulP(q, r), i, m)) ->
                      (forall i: Nat;
                      peano_order.less_or_equal(succ(m), succ(i)) ->
                      tripleRows(p, q, r, i, succ(m), succ(i)) =
                      cappedRun(p, mulP(q, r), i, succ(m)))
                    [by discharge given-the-hypothesis]
                }
              @discharge-m |
                forall m: Nat;
                  (forall i: Nat;
                  peano_order.less_or_equal(m, succ(i)) ->
                  tripleRows(p, q, r, i, m, succ(i)) =
                  cappedRun(p, mulP(q, r), i, m)) ->
                  (forall i: Nat;
                  peano_order.less_or_equal(succ(m), succ(i)) ->
                  tripleRows(p, q, r, i, succ(m), succ(i)) =
                  cappedRun(p, mulP(q, r), i, succ(m)))
                [by generalize generalize-m]
            }
          @discharge-r |
            forall r: Poly; forall m: Nat;
              (forall i: Nat;
              peano_order.less_or_equal(m, succ(i)) ->
              tripleRows(p, q, r, i, m, succ(i)) =
              cappedRun(p, mulP(q, r), i, m)) ->
              (forall i: Nat;
              peano_order.less_or_equal(succ(m), succ(i)) ->
              tripleRows(p, q, r, i, succ(m), succ(i)) =
              cappedRun(p, mulP(q, r), i, succ(m)))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall m: Nat;
          (forall i: Nat;
          peano_order.less_or_equal(m, succ(i)) ->
          tripleRows(p, q, r, i, m, succ(i)) =
          cappedRun(p, mulP(q, r), i, m)) ->
          (forall i: Nat;
          peano_order.less_or_equal(succ(m), succ(i)) ->
          tripleRows(p, q, r, i, succ(m), succ(i)) =
          cappedRun(p, mulP(q, r), i, succ(m)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall m: Nat;
      (forall i: Nat;
      peano_order.less_or_equal(m, succ(i)) ->
      tripleRows(p, q, r, i, m, succ(i)) =
      cappedRun(p, mulP(q, r), i, m)) ->
      (forall i: Nat;
      peano_order.less_or_equal(succ(m), succ(i)) ->
      tripleRows(p, q, r, i, succ(m), succ(i)) =
      cappedRun(p, mulP(q, r), i, succ(m)))
    [by generalize generalize-p]
qed

// -- MULTIPLICATION IS ASSOCIATIVE ----------------------------------------------------------
// Everything meets here. At output index i:
//
//   coeff((pq)r, i) = cappedRun(pq, r, i, succ i)   = tripleTri(p,q,r,i,succ i)   [bridge 1]
//   coeff(p(qr), i) = cappedRun(p, qr, i, succ i)   = tripleRows(p,q,r,i,succ i, succ i)
//                                                                                 [bridge 2]
//
// and the two collections are equal by `theTriangleIsTheShortenedRows` — the exchange. So the
// coefficients agree at every index, and `polyExtensionality` gives the polynomials.
theorem theProductCoefficientsAgree: forall p, q, r: Poly; forall i: Nat;
  coeff(mulP(mulP(p, q), r), i) = coeff(mulP(p, mulP(q, r)), i)
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @generalize-i |
                fix i: Nat {
                  @succ-i-is-at-most-itself |
                    peano_order.less_or_equal(succ(i), succ(i))
                    [using specialize
                      peano_order.lessOrEqualRefl(succ(i))]
                  // the left side
                  @the-triangle-is-the-left-run |
                    tripleTri(p, q, r, i, succ(i)) =
                      cappedRun(mulP(p, q), r, i, succ(i))
                    [using specialize
                      theTriangleIsTheLeftRun(p, q, r, succ(i), i)
                      succ-i-is-at-most-itself]
                  @the-left-run-is-the-coefficient |
                    cappedRun(mulP(p, q), r, i, succ(i)) =
                      coeff(mulP(mulP(p, q), r), i)
                    [using specialize
                      aFullCappedRunIsTheProductCoefficient(mulP(p, q),
                      r, i)]
                  @the-triangle-is-the-left-coefficient |
                    tripleTri(p, q, r, i, succ(i)) =
                      coeff(mulP(mulP(p, q), r), i)
                    [using chain the-triangle-is-the-left-run
                      the-left-run-is-the-coefficient]
                  // the right side
                  @the-rows-are-the-right-run |
                    tripleRows(p, q, r, i, succ(i), succ(i)) =
                      cappedRun(p, mulP(q, r), i, succ(i))
                    [using specialize
                      theShortenedRowsAreTheRightRun(p, q, r, succ(i), i)
                      succ-i-is-at-most-itself]
                  @the-right-run-is-the-coefficient |
                    cappedRun(p, mulP(q, r), i, succ(i)) =
                      coeff(mulP(p, mulP(q, r)), i)
                    [using specialize
                      aFullCappedRunIsTheProductCoefficient(p,
                      mulP(q, r), i)]
                  @the-rows-are-the-right-coefficient |
                    tripleRows(p, q, r, i, succ(i), succ(i)) =
                      coeff(mulP(p, mulP(q, r)), i)
                    [using chain the-rows-are-the-right-run
                      the-right-run-is-the-coefficient]
                  // the exchange joins them
                  @the-exchange |
                    tripleTri(p, q, r, i, succ(i)) =
                      tripleRows(p, q, r, i, succ(i), succ(i))
                    [using specialize
                      theTriangleIsTheShortenedRows(p, q, r, i, succ(i))]
                  @the-left-coefficient-flipped |
                    coeff(mulP(mulP(p, q), r), i) =
                      tripleTri(p, q, r, i, succ(i))
                    [by symmetry the-triangle-is-the-left-coefficient]
                  @conclusion-the-coefficients-agree |
                    coeff(mulP(mulP(p, q), r), i) =
                      coeff(mulP(p, mulP(q, r)), i)
                    [using chain the-left-coefficient-flipped
                      the-exchange the-rows-are-the-right-coefficient]
                }
              @discharge-i |
                forall i: Nat;
                  coeff(mulP(mulP(p, q), r), i) =
                  coeff(mulP(p, mulP(q, r)), i)
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: Poly; forall i: Nat;
              coeff(mulP(mulP(p, q), r), i) =
              coeff(mulP(p, mulP(q, r)), i)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; forall i: Nat;
          coeff(mulP(mulP(p, q), r), i) =
          coeff(mulP(p, mulP(q, r)), i)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; forall i: Nat;
      coeff(mulP(mulP(p, q), r), i) = coeff(mulP(p, mulP(q, r)), i)
    [by generalize generalize-p]
qed

// R[x] IS ASSOCIATIVE UNDER MULTIPLICATION. The last structural law, and Judson's §17.1
// exercise: coefficientwise agreement plus extensionality.
theorem polyMulIsAssociative: forall p, q, r: Poly;
  mulP(mulP(p, q), r) = mulP(p, mulP(q, r))
proof
  @generalize-p |
    fix p: Poly {
      @generalize-q |
        fix q: Poly {
          @generalize-r |
            fix r: Poly {
              @the-coefficients-agree |
                forall i: Nat;
                  coeff(mulP(mulP(p, q), r), i) =
                  coeff(mulP(p, mulP(q, r)), i)
                [using specialize theProductCoefficientsAgree(p, q, r)]
              @conclusion-associativity |
                mulP(mulP(p, q), r) = mulP(p, mulP(q, r))
                [using specialize polyExtensionality(mulP(mulP(p, q), r),
                  mulP(p, mulP(q, r))) the-coefficients-agree]
            }
          @discharge-r |
            forall r: Poly; mulP(mulP(p, q), r) = mulP(p, mulP(q, r))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Poly; mulP(mulP(p, q), r) = mulP(p, mulP(q, r))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Poly; mulP(mulP(p, q), r) = mulP(p, mulP(q, r))
    [by generalize generalize-p]
qed

// -- definition-clause shims ---------------------------------------------------------------
//
// The symbols above are DEFINITION BLOCKS, so `--axioms` reports their clauses as
// definitions rather than as assumptions to weigh. A clause has no user-facing name,
// though, and both `specialize` and a model's `<-` once resolved these BY NAME — so each
// clause keeps a one-line theorem under the name it had as an axiom. These add no
// assumption: every one is proved `[by definition(N) <symbol>]`.

theorem addPolyCoeff:
  forall p, q: Poly; forall i: Nat;
  coeff(addP(p, q), i) = addR(coeff(p, i), coeff(q, i))
proof
  @conclusion |
    forall p, q: Poly; forall i: Nat;
      coeff(addP(p, q), i) = addR(coeff(p, i), coeff(q, i))
    [by definition addP]
qed

theorem negPolyCoeff:
  forall p: Poly; forall i: Nat;
  coeff(negP(p), i) = negR(coeff(p, i))
proof
  @conclusion |
    forall p: Poly; forall i: Nat;
      coeff(negP(p), i) = negR(coeff(p, i))
    [by definition negP]
qed

theorem convolutionZero:
  forall p, q: Poly; forall j: Nat;
  convolution(p, q, j, ZERO) = mulR(coeff(p, j), coeff(q, ZERO))
proof
  @conclusion |
    forall p, q: Poly; forall j: Nat;
      convolution(p, q, j, ZERO) = mulR(coeff(p, j), coeff(q, ZERO))
    [by definition(0) convolution]
qed

theorem convolutionSucc:
  forall p, q: Poly; forall j, m: Nat;
  convolution(p, q, j, succ(m)) =
  addR(mulR(coeff(p, j), coeff(q, succ(m))), convolution(p, q, succ(j), m))
proof
  @conclusion |
    forall p, q: Poly; forall j, m: Nat;
      convolution(p, q, j, succ(m)) =
      addR(mulR(coeff(p, j), coeff(q, succ(m))), convolution(p, q, succ(j), m))
    [by definition(1) convolution]
qed

theorem mulPolyCoeff:
  forall p, q: Poly; forall i: Nat;
  coeff(mulP(p, q), i) = convolution(p, q, ZERO, i)
proof
  @conclusion |
    forall p, q: Poly; forall i: Nat;
      coeff(mulP(p, q), i) = convolution(p, q, ZERO, i)
    [by definition mulP]
qed

theorem tailConvolutionZero:
  forall p, q: Poly; forall m: Nat;
  tailConvolution(p, q, ZERO, m) = mulR(coeff(p, ZERO), coeff(q, m))
proof
  @conclusion |
    forall p, q: Poly; forall m: Nat;
      tailConvolution(p, q, ZERO, m) = mulR(coeff(p, ZERO), coeff(q, m))
    [by definition(0) tailConvolution]
qed

theorem tailConvolutionSucc:
  forall p, q: Poly; forall j, m: Nat;
  tailConvolution(p, q, succ(j), m) =
  addR(mulR(coeff(p, succ(j)), coeff(q, m)),
  tailConvolution(p, q, j, succ(m)))
proof
  @conclusion |
    forall p, q: Poly; forall j, m: Nat;
      tailConvolution(p, q, succ(j), m) =
      addR(mulR(coeff(p, succ(j)), coeff(q, m)),
      tailConvolution(p, q, j, succ(m)))
    [by definition(1) tailConvolution]
qed

theorem segmentZero:
  forall p, q: Poly; forall j, c: Nat;
  segment(p, q, j, c, ZERO) = mulR(coeff(p, j), coeff(q, c))
proof
  @conclusion |
    forall p, q: Poly; forall j, c: Nat;
      segment(p, q, j, c, ZERO) = mulR(coeff(p, j), coeff(q, c))
    [by definition(0) segment]
qed

theorem segmentSucc:
  forall p, q: Poly; forall j, c, n: Nat;
  segment(p, q, succ(j), c, succ(n)) =
  addR(mulR(coeff(p, succ(j)), coeff(q, c)),
  segment(p, q, j, succ(c), n))
proof
  @conclusion |
    forall p, q: Poly; forall j, c, n: Nat;
      segment(p, q, succ(j), c, succ(n)) =
      addR(mulR(coeff(p, succ(j)), coeff(q, c)),
      segment(p, q, j, succ(c), n))
    [by definition(1) segment]
qed

theorem rsegmentZero:
  forall p, q: Poly; forall j, c: Nat;
  rsegment(p, q, j, c, ZERO) = mulR(coeff(p, j), coeff(q, c))
proof
  @conclusion |
    forall p, q: Poly; forall j, c: Nat;
      rsegment(p, q, j, c, ZERO) = mulR(coeff(p, j), coeff(q, c))
    [by definition(0) rsegment]
qed

theorem rsegmentSucc:
  forall p, q: Poly; forall j, c, n: Nat;
  rsegment(p, q, j, succ(c), succ(n)) =
  addR(mulR(coeff(p, j), coeff(q, succ(c))),
  rsegment(p, q, succ(j), c, n))
proof
  @conclusion |
    forall p, q: Poly; forall j, c, n: Nat;
      rsegment(p, q, j, succ(c), succ(n)) =
