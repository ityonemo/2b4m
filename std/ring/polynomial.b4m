theorem tripleTriSucc:
  forall p, q, r: Poly; forall i, n: Nat;
  tripleTri(p, q, r, i, succ(n)) =
  addR(tripleTri(p, q, r, i, n), tripleDiag(p, q, r, i, n, succ(n)))
proof
  @conclusion |
    forall p, q, r: Poly; forall i, n: Nat;
      tripleTri(p, q, r, i, succ(n)) =
