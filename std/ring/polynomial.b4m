  forall p, q, r: Poly; forall i, m: Nat;
  tripleDiag(p, q, r, i, m, ZERO) = zeroR
proof
  @conclusion |
    forall p, q, r: Poly; forall i, m: Nat;
      tripleDiag(p, q, r, i, m, ZERO) = zeroR
