theorem theGapToAtZero:
  forall i: Nat; theGapTo(i, ZERO) = i
proof
  @conclusion |
    forall i: Nat; theGapTo(i, ZERO) = i
    [by definition(0) theGapTo]
qed

theorem theGapToSteps:
  forall i, j: Nat;
  theGapTo(succ(i), succ(j)) = theGapTo(i, j)
proof
  @conclusion |
    forall i, j: Nat;
      theGapTo(succ(i), succ(j)) = theGapTo(i, j)
    [by definition(1) theGapTo]
qed

theorem theCofactorIndexAtZero:
  forall i, j: Nat;
  theCofactorIndex(i, j, ZERO) = theGapTo(i, j)
proof
  @conclusion |
    forall i, j: Nat;
      theCofactorIndex(i, j, ZERO) = theGapTo(i, j)
    [by definition(0) theCofactorIndex]
qed

theorem theCofactorIndexSteps:
  forall i, j, k: Nat;
  theCofactorIndex(i, j, succ(k)) = theGapTo(theGapTo(i, j), succ(k))
proof
  @conclusion |
    forall i, j, k: Nat;
      theCofactorIndex(i, j, succ(k)) = theGapTo(theGapTo(i, j), succ(k))
    [by definition(1) theCofactorIndex]
qed

theorem tripleTermMeaning:
  forall p, q, r: Poly; forall i, j, k: Nat;
  tripleTerm(p, q, r, i, j, k) =
  mulR(mulR(coeff(p, j), coeff(q, k)), coeff(r, theCofactorIndex(i, j, k)))
proof
  @conclusion |
    forall p, q, r: Poly; forall i, j, k: Nat;
      tripleTerm(p, q, r, i, j, k) =
      mulR(mulR(coeff(p, j), coeff(q, k)), coeff(r, theCofactorIndex(i, j, k)))
    [by definition tripleTerm]
qed

theorem tripleRowZero:
  forall p, q, r: Poly; forall i, j: Nat;
  tripleRow(p, q, r, i, j, ZERO) = zeroR
proof
  @conclusion |
    forall p, q, r: Poly; forall i, j: Nat;
      tripleRow(p, q, r, i, j, ZERO) = zeroR
    [by definition(0) tripleRow]
qed

theorem tripleRowSucc:
  forall p, q, r: Poly; forall i, j, n: Nat;
  tripleRow(p, q, r, i, j, succ(n)) =
  addR(tripleRow(p, q, r, i, j, n), tripleTerm(p, q, r, i, j, n))
proof
  @conclusion |
    forall p, q, r: Poly; forall i, j, n: Nat;
      tripleRow(p, q, r, i, j, succ(n)) =
      addR(tripleRow(p, q, r, i, j, n), tripleTerm(p, q, r, i, j, n))
    [by definition(1) tripleRow]
qed

