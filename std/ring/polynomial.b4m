theorem cappedRunSucc:
  forall q, r: Poly; forall g, n: Nat;
  cappedRun(q, r, g, succ(n)) =
  addR(cappedRun(q, r, g, n),
  mulR(coeff(q, n), coeff(r, theGapTo(g, n))))
proof
  @conclusion |
    forall q, r: Poly; forall g, n: Nat;
      cappedRun(q, r, g, succ(n)) =
      addR(cappedRun(q, r, g, n),
