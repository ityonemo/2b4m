theorem cappedRunZero:
  forall q, r: Poly; forall g: Nat;
  cappedRun(q, r, g, ZERO) = zeroR
proof
  @conclusion |
    forall q, r: Poly; forall g: Nat;
      cappedRun(q, r, g, ZERO) = zeroR
    [by definition(0) cappedRun]
