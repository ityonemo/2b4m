// std/integer-divides.bpa — ℤ divisibility, powers, the division algorithm, and
// the gcd/Bézout theory (the whole ℤ number-theory unit).
//
// Over std/integer.bpa + its ring algebra, this file develops:
//
//   - DIVISIBILITY: `divides(d, n)` = "d divides n" = ∃k; n = d·k, with the same
//     intro/elim shape as Peano's; ℤ is a model of the abstract divisibility
//     theory so refl/mul/add/transitive transfer. `pow(base, e)` = base^e,
//     recursive on the exponent (pow(b,0)=1, pow(b,succ e)=pow(b,e)·b).
//   - THE DIVISION ALGORITHM: for a, b with b > 0 there exist UNIQUE q, r with
//     a = bq + r and 0 ≤ r < b. Existence (divisionAlgorithmExists) via the
//     Principle of Well-Ordering on S = { a − bk : k ∈ ℤ, a − bk ≥ 0 }; its least
//     member is the remainder. Uniqueness (divisionAlgorithmUnique) from
//     b | (r' − r) with |r' − r| < b forcing r' = r.
//   - GCD, two coexisting developments. (1) The existence-form / BÉZOUT gcd,
//     CHARACTERIZED by its defining properties (a positive common divisor
//     divisible by every common divisor, and an integer combination ar + bs):
//     `bezout` and its coprime specialization `coprimeBezout` (the engine of
//     Euclid's Lemma). (2) The CONCRETE Euclidean `gcd` function (`gcdZero` /
//     `gcdStep` / `gcdAbs`, with `abs` for sign-normalization), proved correct
//     for ALL integers — `gcdDividesBoth` (it is a common divisor) and
//     `gcdGreatest` (every common divisor divides it) — by strong induction on
//     the decreasing modulus over the nonneg core, then lifted past negative b
//     via `abs`. The two developments are independent.
//
// The AATA transliteration (aata/2.3-primes.md) proves the gcd theory INLINE for
// Judson pedagogy; per the import-horizon rule the two homes stay independent.
import integer <<< "std/integer.bpa"
import ring <<< "std/integer.bpa"
import divisibility <<< "std/divisibility.bpa"
import order <<< "std/integer-order.bpa"
import nonneg <<< "std/integer.bpa"
import wellordering <<< "std/integer-wellordering.bpa"

sort Int = integer.Int
const ZERO = integer.ZERO
const ONE = integer.ONE
func succ = integer.succ
func prev = integer.prev
func add = integer.add
func mul = integer.mul
func neg = integer.neg
axiom addZeroLeft = integer.addZeroLeft
theorem addZeroRight = ring.addZeroRight
axiom mulZeroLeft = integer.mulZeroLeft
theorem mulZeroRight = ring.mulZeroRight
theorem mulSuccRight = ring.mulSuccRight
axiom mulSuccLeft = integer.mulSuccLeft
theorem addIsCommutative = ring.addIsCommutative
theorem addIsAssociative = ring.addIsAssociative
theorem mulOneRight = ring.mulOneRight
theorem mulOneLeft = integer.mulOneLeft
theorem mulLeftSwap = integer.mulLeftSwap
theorem mulAddDistribLeft = ring.mulAddDistribLeft
theorem mulIsAssociative = ring.mulIsAssociative
theorem induction = integer.induction

// -- divisibility -----------------------------------------------------------

// Transparent: divides(d, n) IS the multiple existential (matching the abstract
// theory's own define). Since it is a define, it is NOT a model source/target —
// it rides along on `mul` (already mapped) when divisibility's theorems transfer.
define divides(d: Int, n: Int) = exists k: Int; n = mul(d, k)

// ℤ is a model of the abstract divisibility theory: its mul is associative with
// right identity ONE and left-distributes over add, so the basic divisibility
// facts (refl, mul, add) transfer instead of being re-proved.
model IntegerDivisibility {
  divisibility.Dividable: Int
  divisibility.ONE: ONE
  divisibility.mul: mul
  divisibility.add: add
  divisibility.mulOneRight <- mulOneRight
  divisibility.mulIsAssociative <- mulIsAssociative
  divisibility.mulAddDistribLeft <- mulAddDistribLeft
}

// -- powers (recursive on the exponent) -------------------------------------

func pow(base: Int, e: Int): Int
axiom powZero: forall b: Int; pow(b, ZERO) = ONE
axiom powSucc: forall b, e: Int; pow(b, succ(e)) = mul(pow(b, e), b)

// -- basic divisibility facts -----------------------------------------------

// d | d, witnessed by 1: d = d·1.
theorem dividesRefl: forall d: Int; divides(d, d)
proof
  @conclusion |
    forall d: Int; divides(d, d)
    [by model(IntegerDivisibility) divisibility.dividesRefl]
qed

// d | a  =>  d | a·c: if a = d·k, then a·c = (d·k)·c = d·(k·c), so d divides a·c.
// Unpack the quotient k from d | a, reassociate the triple product with
// mulIsAssociative, then repackage via exists_intro with witness k·c.
theorem dividesMul: forall d, a, c: Int; divides(d, a) -> divides(d, mul(a, c))
proof
  @conclusion |
    forall d, a, c: Int; divides(d, a) -> divides(d, mul(a, c))
    [by model(IntegerDivisibility) divisibility.dividesMul]
qed

// d | a  and  d | b  =>  d | a+b: if a = d·j and b = d·k, then a+b = d·(j+k) by
// left-distributivity, so d divides a+b. Unpack both quotients, collect the sum
// with mulAddDistribLeft, then repackage via exists_intro with witness j+k.
theorem dividesAdd: forall d, a, b: Int; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
proof
  @conclusion |
    forall d, a, b: Int; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
    [by model(IntegerDivisibility) divisibility.dividesAdd]
qed

theorem dividesTransitive: forall a, b, c: Int; divides(a, b) -> divides(b, c) -> divides(a, c)
proof
  @conclusion |
    forall a, b, c: Int; divides(a, b) -> divides(b, c) -> divides(a, c)
    [by model(IntegerDivisibility) divisibility.dividesTransitive]
qed

// -- division-algorithm vocabulary ------------------------------------------

func sub = integer.sub

theorem addSuccRight = ring.addSuccRight
theorem addPrevRight = ring.addPrevRight
axiom negSucc = integer.negSucc
axiom negZero = integer.negZero
axiom oneIsSuccZero = integer.oneIsSuccZero
axiom succPrev = integer.succPrev
axiom prevSucc = integer.prevSucc
axiom definitionOfSubtraction = order.definitionOfSubtraction
axiom addSuccLeft = integer.addSuccLeft
axiom addPrevLeft = integer.addPrevLeft

define TWO = succ(ONE)
define THREE = succ(TWO)
define FOUR = succ(THREE)

// -- nonneg, order predicates (proofs use these names) ----------------------

pred is_nonneg = nonneg.nonneg
define less_than(a: Int, b: Int) = order.less_than(a, b)
define at_most(a: Int, b: Int) = order.less_or_equal(a, b)
axiom nonnegInduction = nonneg.nonnegInduction
axiom lessThanIntro = order.lessThanIntro
axiom lessThanElim = order.lessThanElim
theorem lessOrEqualIsGapExistential = order.lessOrEqualIsGapExistential

// -- order / sign / ring lemmas the division proofs cite --------------------

theorem nonnegNotLessThanZero = wellordering.nonnegNotLessThanZero
theorem nonnegStrongInduction = wellordering.nonnegStrongInduction
theorem nonnegWellOrdering = wellordering.nonnegWellOrdering
theorem trichotomy = order.trichotomy
theorem nonnegAdd = order.nonnegAdd
theorem lessThanAddCancelLeft = order.lessThanAddCancelLeft
theorem additiveInverseUnique = integer.additiveInverseUnique
theorem lessOrEqualAntisymmetric = order.lessOrEqualAntisymmetric
axiom nonnegZero = nonneg.nonnegZero
axiom nonnegSucc = nonneg.nonnegSucc
theorem addNegRight = ring.addNegRight
// addNegLeft + addLeftSwap (and addNegRight above) feed the `arithmetic` equation
// certifier: it needs them in scope to cancel a neg/positive pair and reorder a
// sum. A rule the certifier can't resolve is silently dropped from its rule set,
// so a linear goal fails to certify without it.
theorem addNegLeft = ring.addNegLeft
theorem addLeftSwap = ring.addLeftSwap
theorem addCancelLeft = order.addCancelLeft
theorem additionPreservesOrder = order.additionPreservesOrder
theorem lessThanIrreflexive = order.lessThanIrreflexive
theorem lessThanTransitive = order.lessThanTransitive
theorem lessOrEqualSplit = order.lessOrEqualSplit
theorem mulNegRight = ring.mulNegRight
theorem lessThanToLessOrEqual = order.lessThanToLessOrEqual
theorem lessOrEqualRefl = order.lessOrEqualRefl
theorem mulIsCommutative = order.mulIsCommutative
theorem negLessThanZero = order.negLessThanZero
theorem zeroLessThanOne = order.zeroLessThanOne
theorem mulNegLeft = order.mulNegLeft
theorem negativeNegIsPositive = order.negativeNegIsPositive
theorem productOfNonpositiveFactorsIsNonneg = order.productOfNonpositiveFactorsIsNonneg
theorem negAdd = ring.negAdd
theorem negNeg = ring.negNeg
theorem signTrichotomy = order.signTrichotomy
theorem nonnegMul = order.nonnegMul
theorem positiveIsNonneg = order.positiveIsNonneg

theorem productOfNonnegativesIsNonneg: forall b, k: Int;
  is_nonneg(b) -> is_nonneg(k) -> is_nonneg(mul(b, k))
proof
  @generalize-b |
    fix b: Int {
      @given-b-nonneg |
        assume is_nonneg(b) {
          @b-nonneg |
            is_nonneg(b)
            [by hypothesis given-b-nonneg]
          // base: mul(b, ZERO) = ZERO is nonneg.
          @b-times-zero-is-zero |
            mul(b, ZERO) = ZERO
            [by specialize mulZeroRight(b)]
          @zero-is-nonneg |
            is_nonneg(ZERO)
            [by axiom nonnegZero]
          @base-case |
            is_nonneg(mul(b, ZERO))
            [by rewrite b-times-zero-is-zero zero-is-nonneg]
          // step: nonneg(mul(b, k)) -> nonneg(mul(b, succ k)), since
          // mul(b, succ k) = add(mul(b, k), b), a sum of nonnegatives.
          @induction-step |
            fix k: Int {
              @given-k-nonneg |
                assume is_nonneg(k) {
                  @given-product-nonneg |
                    assume is_nonneg(mul(b, k)) {
                      @product-nonneg |
                        is_nonneg(mul(b, k))
                        [by hypothesis given-product-nonneg]
                      @b-times-successor-k |
                        mul(b, succ(k)) = add(mul(b, k), b)
                        [by specialize mulSuccRight(b, k)]
                      @product-plus-b-nonneg |
                        is_nonneg(add(mul(b, k), b))
                        [by specialize nonnegAdd(mul(b, k), b) product-nonneg b-nonneg]
                      @grown-product-nonneg |
                        is_nonneg(mul(b, succ(k)))
                        [by rewrite b-times-successor-k product-plus-b-nonneg]
                    }
                  @product-nonneg-implies-grown-product-nonneg |
                    is_nonneg(mul(b, k)) -> is_nonneg(mul(b, succ(k)))
                    [by implies_intro given-product-nonneg]
                }
              @induction-step-at-k |
                is_nonneg(k) -> is_nonneg(mul(b, k)) -> is_nonneg(mul(b, succ(k)))
                [by implies_intro given-k-nonneg]
            }
          @induction-step-for-all-k |
            forall k: Int; is_nonneg(k) -> is_nonneg(mul(b, k)) -> is_nonneg(mul(b, succ(k)))
            [by forall_intro induction-step]
          @product-nonneg-for-nonneg-k |
            forall k: Int; is_nonneg(k) -> is_nonneg(mul(b, k))
            [by instantiate nonnegInduction((fun k: Int => is_nonneg(mul(b, k)))) base-case induction-step-for-all-k]
        }
      @b-nonneg-implies-product-nonneg |
        is_nonneg(b) -> forall k: Int; is_nonneg(k) -> is_nonneg(mul(b, k))
        [by implies_intro given-b-nonneg]
    }
  @b-nonneg-gives-product-nonneg |
    forall b: Int; is_nonneg(b) -> forall k: Int; is_nonneg(k) -> is_nonneg(mul(b, k))
    [by forall_intro generalize-b]
  @flatten |
    fix b: Int {
      @flatten-k |
        fix n: Int {
          @given-b-nonneg |
            assume is_nonneg(b) {
              @given-n-nonneg |
                assume is_nonneg(n) {
                  @b-nonneg |
                    is_nonneg(b)
                    [by hypothesis given-b-nonneg]
                  @n-nonneg |
                    is_nonneg(n)
                    [by hypothesis given-n-nonneg]
                  @conclusion-product-nonneg |
                    is_nonneg(mul(b, n))
                    [by specialize b-nonneg-gives-product-nonneg(b, n) b-nonneg n-nonneg]
                }
              @n-nonneg-gives-product-nonneg |
                is_nonneg(n) -> is_nonneg(mul(b, n))
                [by implies_intro given-n-nonneg]
            }
          @b-nonneg-gives-conditional |
            is_nonneg(b) -> is_nonneg(n) -> is_nonneg(mul(b, n))
            [by implies_intro given-b-nonneg]
        }
      @discharge-k |
        forall n: Int; is_nonneg(b) -> is_nonneg(n) -> is_nonneg(mul(b, n))
        [by forall_intro flatten-k]
    }
  @conclusion |
    forall b, k: Int; is_nonneg(b) -> is_nonneg(k) -> is_nonneg(mul(b, k))
    [by forall_intro flatten]
qed

theorem boundedNonnegMultipleIsZero: forall b, m: Int;
  less_than(ZERO, b) -> divides(b, m) -> is_nonneg(m) -> less_than(m, b) -> m = ZERO
proof
  @generalize-b |
    fix b: Int {
      @generalize-m |
        fix m: Int {
          @given-b-positive |
            assume less_than(ZERO, b) {
              @given-b-divides-m |
                assume divides(b, m) {
                  @given-m-nonneg |
                    assume is_nonneg(m) {
                      @given-m-less_than-b |
                        assume less_than(m, b) {
                          @b-positive |
                            less_than(ZERO, b)
                            [by hypothesis given-b-positive]
                          @m-nonneg |
                            is_nonneg(m)
                            [by hypothesis given-m-nonneg]
                          // b > 0 exhibits a nonneg gap succ(d) with 0 + succ(d) = b,
                          // so b = succ(d) is nonneg.
                          @b-gap-exists-if-positive |
                            less_than(ZERO, b) -> exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = b
                            [by specialize lessThanElim(ZERO, b)]
                          @b-gap-exists |
                            exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = b
                            [by modus_ponens b-gap-exists-if-positive b-positive]
                          @with-b-gap |
                            unpack e: Int from b-gap-exists {
                              @gap-nonneg-and-reaches-b |
                                is_nonneg(e) and add(ZERO, succ(e)) = b
                                [by hypothesis with-b-gap]
                              @gap-nonneg |
                                is_nonneg(e)
                                [by and_elim_left gap-nonneg-and-reaches-b]
                              @gap-succ-reaches-b |
                                add(ZERO, succ(e)) = b
                                [by and_elim_right gap-nonneg-and-reaches-b]
                              @zero-prefix-is-identity |
                                forall n: Int; add(ZERO, n) = n
                                [by axiom addZeroLeft]
                              @zero-plus-succ-gap |
                                add(ZERO, succ(e)) = succ(e)
                                [by forall_elim(succ(e)) zero-prefix-is-identity]
                              @b-is-successor-gap |
                                succ(e) = b
                                [by rewrite zero-plus-succ-gap gap-succ-reaches-b]
                              @successor-gap-nonneg |
                                is_nonneg(e) -> is_nonneg(succ(e))
                                [by specialize nonnegSucc(e)]
                              @succ-gap-is-nonneg |
                                is_nonneg(succ(e))
                                [by modus_ponens successor-gap-nonneg gap-nonneg]
                              @conclusion-b-nonneg |
                                is_nonneg(b)
                                [by rewrite b-is-successor-gap succ-gap-is-nonneg]
                            }
                          @b-is-nonneg |
                            is_nonneg(b)
                            [by exists_elim with-b-gap]
                          // m = b*k for some k.
                          @quotient-exists |
                            divides(b, m)
                            [by hypothesis given-b-divides-m]
                          @with-quotient-k |
                            unpack k: Int from quotient-exists {
                              @m-is-b-times-k |
                                m = mul(b, k)
                                [by hypothesis with-quotient-k]
                              @k-sign-trichotomy |
                                less_than(k, ZERO) or k = ZERO or less_than(ZERO, k)
                                [by specialize trichotomy(k, ZERO)]
                              @multiple-is-zero-by-sign-of-quotient |
                                m = ZERO
                                case k-sign-trichotomy {
                                  @when-k-negative |
                                    assume less_than(k, ZERO) {
                                      // -k is a positive gap, hence nonneg; b*(-k) = -m is
                                      // a product of nonnegatives, so m <= 0. With m >= 0,
                                      // antisymmetry gives m = 0.
                                      @k-negative |
                                        less_than(k, ZERO)
                                        [by hypothesis when-k-negative]
                                      @k-gap-exists |
                                        exists d: Int; is_nonneg(d) and add(k, succ(d)) = ZERO
                                        [by specialize lessThanElim(k, ZERO) k-negative]
                                      @with-k-gap |
                                        unpack e: Int from k-gap-exists {
                                          @gap-nonneg-and-reaches-zero |
                                            is_nonneg(e) and add(k, succ(e)) = ZERO
                                            [by hypothesis with-k-gap]
                                          @gap-nonneg |
                                            is_nonneg(e)
                                            [by and_elim_left gap-nonneg-and-reaches-zero]
                                          @gap-reaches-zero |
                                            add(k, succ(e)) = ZERO
                                            [by and_elim_right gap-nonneg-and-reaches-zero]
                                          // succ(e) = neg(k): cancel the common k in
                                          // add(k, succ e) = 0. arithmetic decides this but the
                                          // equation certifier declines isolating the bare neg
                                          // leaf, so fall back to additiveInverseUnique (marks
                                          // the certifier gap).
                                          @negation-of-k-is-successor-gap |
                                            succ(e) = neg(k)
                                            [by arithmetic fallback(additiveInverseUnique) gap-reaches-zero]
                                          @successor-gap-nonneg |
                                            is_nonneg(e) -> is_nonneg(succ(e))
                                            [by specialize nonnegSucc(e)]
                                          @succ-gap-is-nonneg |
                                            is_nonneg(succ(e))
                                            [by modus_ponens successor-gap-nonneg gap-nonneg]
                                          @negation-of-k-is-nonneg |
                                            is_nonneg(neg(k))
                                            [by rewrite negation-of-k-is-successor-gap succ-gap-is-nonneg]
                                          // b*(-k) is a product of nonnegatives, hence nonneg.
                                          @product-of-nonnegatives |
                                            forall x, y: Int; is_nonneg(x) -> is_nonneg(y) -> is_nonneg(mul(x, y))
                                            [by theorem productOfNonnegativesIsNonneg]
                                          @b-times-negk-nonneg-if-parts |
                                            is_nonneg(b) -> is_nonneg(neg(k)) -> is_nonneg(mul(b, neg(k)))
                                            [by forall_elim(b, neg(k)) product-of-nonnegatives]
                                          @b-times-negk-nonneg |
                                            is_nonneg(mul(b, neg(k)))
                                            [by tautology b-times-negk-nonneg-if-parts b-is-nonneg negation-of-k-is-nonneg]
                                          // b*(-k) = -(b*k) = -m.
                                          @b-times-negk-is-neg-product |
                                            mul(b, neg(k)) = neg(mul(b, k))
                                            [by specialize mulNegRight(b, k)]
                                          @neg-product-reflexive |
                                            neg(mul(b, k)) = neg(mul(b, k))
                                            [by reflexivity]
                                          @neg-product-is-neg-m |
                                            neg(mul(b, k)) = neg(m)
                                            [by rewrite m-is-b-times-k neg-product-reflexive]
                                          @b-times-negk-is-neg-m |
                                            mul(b, neg(k)) = neg(m)
                                            [by rewrite neg-product-is-neg-m b-times-negk-is-neg-product]
                                          @neg-m-nonneg |
                                            is_nonneg(neg(m))
                                            [by rewrite b-times-negk-is-neg-m b-times-negk-nonneg]
                                          // m <= 0: witness neg(m) nonneg with add(m, neg m) = 0.
                                          @m-plus-neg-m-zero |
                                            add(m, neg(m)) = ZERO
                                            [by specialize addNegRight(m)]
                                          @neg-m-witnesses-gap |
                                            is_nonneg(neg(m)) and add(m, neg(m)) = ZERO
                                            [by and_intro neg-m-nonneg m-plus-neg-m-zero]
                                          @m-less_than-or-equal-zero-gap |
                                            exists d: Int; is_nonneg(d) and add(m, d) = ZERO
                                            [by exists_intro(neg(m)) neg-m-witnesses-gap]
                                          @m-at-most-zero-iff-gap |
                                            at_most(m, ZERO) iff (exists d: Int; is_nonneg(d) and add(m, d) = ZERO)
                                            [by specialize lessOrEqualIsGapExistential(m, ZERO)]
                                          @m-at-most-zero-if-gap |
                                            (exists d: Int; is_nonneg(d) and add(m, d) = ZERO) -> at_most(m, ZERO)
                                            [by iff_elim_backward m-at-most-zero-iff-gap]
                                          @m-at-most-zero |
                                            at_most(m, ZERO)
                                            [by modus_ponens m-at-most-zero-if-gap m-less_than-or-equal-zero-gap]
                                          // 0 <= m: witness m nonneg with add(0, m) = m.
                                          @zero-plus-m-is-m |
                                            add(ZERO, m) = m
                                            [by specialize addZeroLeft(m)]
                                          @m-witnesses-zero-at-most-m |
                                            is_nonneg(m) and add(ZERO, m) = m
                                            [by and_intro m-nonneg zero-plus-m-is-m]
                                          @zero-less_than-or-equal-m-gap |
                                            exists d: Int; is_nonneg(d) and add(ZERO, d) = m
                                            [by exists_intro(m) m-witnesses-zero-at-most-m]
                                          @zero-at-most-m-iff-gap |
                                            at_most(ZERO, m) iff (exists d: Int; is_nonneg(d) and add(ZERO, d) = m)
                                            [by specialize lessOrEqualIsGapExistential(ZERO, m)]
                                          @zero-at-most-m-if-gap |
                                            (exists d: Int; is_nonneg(d) and add(ZERO, d) = m) -> at_most(ZERO, m)
                                            [by iff_elim_backward zero-at-most-m-iff-gap]
                                          @zero-at-most-m |
                                            at_most(ZERO, m)
                                            [by modus_ponens zero-at-most-m-if-gap zero-less_than-or-equal-m-gap]
                                          @m-and-zero-antisymmetric |
                                            at_most(m, ZERO) -> at_most(ZERO, m) -> m = ZERO
                                            [by specialize lessOrEqualAntisymmetric(m, ZERO)]
                                          @conclusion-m-is-zero |
                                            m = ZERO
                                            [by tautology m-and-zero-antisymmetric m-at-most-zero zero-at-most-m]
                                        }
                                      @conclusion-m-is-zero |
                                        m = ZERO
                                        [by exists_elim with-k-gap]
                                    }
                                  @when-k-zero |
                                    assume k = ZERO {
                                      // m = b*0 = 0.
                                      @k-is-zero |
                                        k = ZERO
                                        [by hypothesis when-k-zero]
                                      @m-is-b-times-zero |
                                        m = mul(b, ZERO)
                                        [by rewrite k-is-zero m-is-b-times-k]
                                      @b-times-zero-is-zero |
                                        mul(b, ZERO) = ZERO
                                        [by specialize mulZeroRight(b)]
                                      @conclusion-m-is-zero |
                                        m = ZERO
                                        [by rewrite b-times-zero-is-zero m-is-b-times-zero]
                                    }
                                  @when-k-positive |
                                    assume less_than(ZERO, k) {
                                      // k = d+1 (nonneg d), so m = b*k = b*d + b. Then
                                      // m < b forces b*d < 0, impossible for a product of
                                      // nonnegatives.
                                      @k-positive |
                                        less_than(ZERO, k)
                                        [by hypothesis when-k-positive]
                                      @k-gap-exists-if-positive |
                                        less_than(ZERO, k) -> exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = k
                                        [by specialize lessThanElim(ZERO, k)]
                                      @k-gap-exists |
                                        exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = k
                                        [by modus_ponens k-gap-exists-if-positive k-positive]
                                      @with-k-gap |
                                        unpack e: Int from k-gap-exists {
                                          @gap-nonneg-and-reaches-k |
                                            is_nonneg(e) and add(ZERO, succ(e)) = k
                                            [by hypothesis with-k-gap]
                                          @gap-nonneg |
                                            is_nonneg(e)
                                            [by and_elim_left gap-nonneg-and-reaches-k]
                                          @gap-reaches-k |
                                            add(ZERO, succ(e)) = k
                                            [by and_elim_right gap-nonneg-and-reaches-k]
                                          @zero-prefix-is-identity |
                                            forall n: Int; add(ZERO, n) = n
                                            [by axiom addZeroLeft]
                                          @zero-plus-succ-gap |
                                            add(ZERO, succ(e)) = succ(e)
                                            [by forall_elim(succ(e)) zero-prefix-is-identity]
                                          @k-is-successor-gap |
                                            succ(e) = k
                                            [by rewrite zero-plus-succ-gap gap-reaches-k]
                                          // m = b*succ(e) = b*e + b.
                                          @b-times-succ-gap |
                                            mul(b, succ(e)) = add(mul(b, e), b)
                                            [by specialize mulSuccRight(b, e)]
                                          @m-is-b-times-succ-gap |
                                            m = mul(b, succ(e))
                                            [by rewrite k-is-successor-gap m-is-b-times-k]
                                          @m-is-product-plus-b |
                                            m = add(mul(b, e), b)
                                            [by rewrite b-times-succ-gap m-is-b-times-succ-gap]
                                          // m < b becomes add(b, b*e) < add(b, 0), cancel b.
                                          @m-less_than-b-restated |
                                            less_than(m, b)
                                            [by hypothesis given-m-less_than-b]
                                          @product-plus-b-less_than-b |
                                            less_than(add(mul(b, e), b), b)
                                            [by rewrite m-is-product-plus-b m-less_than-b-restated]
                                          @addition-is-commutative |
                                            forall x, y: Int; add(x, y) = add(y, x)
                                            [by theorem addIsCommutative]
                                          @product-and-b-commute |
                                            add(mul(b, e), b) = add(b, mul(b, e))
                                            [by forall_elim(mul(b, e), b) addition-is-commutative]
                                          @b-plus-product-less_than-b |
                                            less_than(add(b, mul(b, e)), b)
                                            [by rewrite product-and-b-commute product-plus-b-less_than-b]
                                          @b-plus-zero-is-b |
                                            add(b, ZERO) = b
                                            [by specialize addZeroRight(b)]
                                          @b-plus-product-less_than-b-plus-zero |
                                            less_than(add(b, mul(b, e)), add(b, ZERO))
                                            [by rewrite b-plus-zero-is-b b-plus-product-less_than-b]
                                          @common-prefix-cancels-order |
                                            forall c, x, y: Int; less_than(add(c, x), add(c, y)) -> less_than(x, y)
                                            [by theorem lessThanAddCancelLeft]
                                          @product-less_than-zero-if-prefixed |
                                            less_than(add(b, mul(b, e)), add(b, ZERO)) -> less_than(mul(b, e), ZERO)
                                            [by forall_elim(b, mul(b, e), ZERO) common-prefix-cancels-order]
                                          @product-less_than-zero |
                                            less_than(mul(b, e), ZERO)
                                            [by modus_ponens product-less_than-zero-if-prefixed b-plus-product-less_than-b-plus-zero]
                                          // but b*e is a product of nonnegatives, hence >= 0.
                                          @b-times-gap-nonneg-if-parts |
                                            is_nonneg(b) -> is_nonneg(e) -> is_nonneg(mul(b, e))
                                            [by specialize productOfNonnegativesIsNonneg(b, e)]
                                          @b-times-gap-nonneg |
                                            is_nonneg(mul(b, e))
                                            [by tautology b-times-gap-nonneg-if-parts b-is-nonneg gap-nonneg]
                                          @nonneg-not-less_than-zero |
                                            forall n: Int; is_nonneg(n) -> (not less_than(n, ZERO))
                                            [by theorem nonnegNotLessThanZero]
                                          @product-not-less_than-zero |
                                            is_nonneg(mul(b, e)) -> (not less_than(mul(b, e), ZERO))
                                            [by forall_elim(mul(b, e)) nonneg-not-less_than-zero]
                                          @product-is-not-less_than-zero |
                                            not less_than(mul(b, e), ZERO)
                                            [by modus_ponens product-not-less_than-zero b-times-gap-nonneg]
                                          @conclusion-m-is-zero |
                                            m = ZERO
                                            [by absurd product-less_than-zero product-is-not-less_than-zero]
                                        }
                                      @conclusion-m-is-zero |
                                        m = ZERO
                                        [by exists_elim with-k-gap]
                                    }
                                }
                            }
                          @conclusion-m-is-zero |
                            m = ZERO
                            [by exists_elim with-quotient-k]
                        }
                      @m-less_than-b-implies-zero |
                        less_than(m, b) -> m = ZERO
                        [by implies_intro given-m-less_than-b]
                    }
                  @m-nonneg-implies-zero |
                    is_nonneg(m) -> less_than(m, b) -> m = ZERO
                    [by implies_intro given-m-nonneg]
                }
              @b-divides-m-implies-zero |
                divides(b, m) -> is_nonneg(m) -> less_than(m, b) -> m = ZERO
                [by implies_intro given-b-divides-m]
            }
          @b-positive-implies-zero |
            less_than(ZERO, b) -> divides(b, m) -> is_nonneg(m) -> less_than(m, b) -> m = ZERO
            [by implies_intro given-b-positive]
        }
      @discharge-m |
        forall m: Int; less_than(ZERO, b) -> divides(b, m) -> is_nonneg(m) -> less_than(m, b) -> m = ZERO
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall b, m: Int; less_than(ZERO, b) -> divides(b, m) -> is_nonneg(m) -> less_than(m, b) -> m = ZERO
    [by forall_intro generalize-b]
qed

theorem productWithPositiveIsPositive: forall b, k: Int;
  less_than(ZERO, b) -> less_than(ZERO, k) -> less_than(ZERO, mul(b, k))
proof
  @generalize-b |
    fix b: Int {
      @generalize-k |
        fix k: Int {
          @given-b-positive |
            assume less_than(ZERO, b) {
              @given-k-positive |
                assume less_than(ZERO, k) {
                  @b-positive |
                    less_than(ZERO, b)
                    [by hypothesis given-b-positive]
                  @k-positive |
                    less_than(ZERO, k)
                    [by hypothesis given-k-positive]
                  // b > 0 exhibits b = succ(gap), hence b is nonneg.
                  @b-gap-exists-if-positive |
                    less_than(ZERO, b) -> exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = b
                    [by specialize lessThanElim(ZERO, b)]
                  @b-gap-exists |
                    exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = b
                    [by modus_ponens b-gap-exists-if-positive b-positive]
                  @with-b-gap |
                    unpack e: Int from b-gap-exists {
                      @gap-nonneg-and-reaches-b |
                        is_nonneg(e) and add(ZERO, succ(e)) = b
                        [by hypothesis with-b-gap]
                      @gap-nonneg |
                        is_nonneg(e)
                        [by and_elim_left gap-nonneg-and-reaches-b]
                      @gap-reaches-b |
                        add(ZERO, succ(e)) = b
                        [by and_elim_right gap-nonneg-and-reaches-b]
                      @zero-prefix-is-identity |
                        forall n: Int; add(ZERO, n) = n
                        [by axiom addZeroLeft]
                      @zero-plus-succ-gap |
                        add(ZERO, succ(e)) = succ(e)
                        [by forall_elim(succ(e)) zero-prefix-is-identity]
                      @b-is-successor-gap |
                        succ(e) = b
                        [by rewrite zero-plus-succ-gap gap-reaches-b]
                      @successor-gap-nonneg |
                        is_nonneg(e) -> is_nonneg(succ(e))
                        [by specialize nonnegSucc(e)]
                      @succ-gap-nonneg |
                        is_nonneg(succ(e))
                        [by modus_ponens successor-gap-nonneg gap-nonneg]
                      @conclusion-b-nonneg |
                        is_nonneg(b)
                        [by rewrite b-is-successor-gap succ-gap-nonneg]
                    }
                  @b-is-nonneg |
                    is_nonneg(b)
                    [by exists_elim with-b-gap]
                  // k > 0 exhibits k = succ(d), so mul(b, k) = mul(b, d) + b.
                  @k-gap-exists-if-positive |
                    less_than(ZERO, k) -> exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = k
                    [by specialize lessThanElim(ZERO, k)]
                  @k-gap-exists |
                    exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = k
                    [by modus_ponens k-gap-exists-if-positive k-positive]
                  @with-k-gap |
                    unpack d: Int from k-gap-exists {
                      @gap-nonneg-and-reaches-k |
                        is_nonneg(d) and add(ZERO, succ(d)) = k
                        [by hypothesis with-k-gap]
                      @gap-nonneg |
                        is_nonneg(d)
                        [by and_elim_left gap-nonneg-and-reaches-k]
                      @gap-reaches-k |
                        add(ZERO, succ(d)) = k
                        [by and_elim_right gap-nonneg-and-reaches-k]
                      @zero-prefix-is-identity |
                        forall n: Int; add(ZERO, n) = n
                        [by axiom addZeroLeft]
                      @zero-plus-succ-gap |
                        add(ZERO, succ(d)) = succ(d)
                        [by forall_elim(succ(d)) zero-prefix-is-identity]
                      @k-is-successor-gap |
                        succ(d) = k
                        [by rewrite zero-plus-succ-gap gap-reaches-k]
                      @b-times-succ-gap |
                        mul(b, succ(d)) = add(mul(b, d), b)
                        [by specialize mulSuccRight(b, d)]
                      @product-is-partial-plus-b |
                        mul(b, k) = add(mul(b, d), b)
                        [by rewrite k-is-successor-gap b-times-succ-gap]
                      // mul(b, d) is nonneg, and mul(b, d) < mul(b, d) + b = mul(b, k),
                      // so 0 <= mul(b, d) < mul(b, k) gives 0 < mul(b, k).
                      @partial-product-nonneg-if-parts |
                        is_nonneg(b) -> is_nonneg(d) -> is_nonneg(mul(b, d))
                        [by specialize productOfNonnegativesIsNonneg(b, d)]
                      @partial-product-nonneg |
                        is_nonneg(mul(b, d))
                        [by tautology partial-product-nonneg-if-parts b-is-nonneg gap-nonneg]
                      @addition-preserves-order |
                        forall x, y, c: Int; less_than(x, y) -> less_than(add(c, x), add(c, y))
                        [by theorem additionPreservesOrder]
                      @adding-partial-product-preserves |
                        less_than(ZERO, b) -> less_than(add(mul(b, d), ZERO), add(mul(b, d), b))
                        [by forall_elim(ZERO, b, mul(b, d)) addition-preserves-order]
                      @partial-plus-zero-less_than-partial-plus-b |
                        less_than(add(mul(b, d), ZERO), add(mul(b, d), b))
                        [by modus_ponens adding-partial-product-preserves b-positive]
                      @adding-zero-is-identity |
                        forall n: Int; add(n, ZERO) = n
                        [by theorem addZeroRight]
                      @partial-plus-zero-is-partial |
                        add(mul(b, d), ZERO) = mul(b, d)
                        [by forall_elim(mul(b, d)) adding-zero-is-identity]
                      @partial-less_than-partial-plus-b |
                        less_than(mul(b, d), add(mul(b, d), b))
                        [by rewrite partial-plus-zero-is-partial partial-plus-zero-less_than-partial-plus-b]
                      @partial-less_than-product |
                        less_than(mul(b, d), mul(b, k))
                        [by rewrite product-is-partial-plus-b partial-less_than-partial-plus-b]
                      // split 0 <= mul(b, d): either 0 < mul(b, d) (transit) or 0 = mul(b, d).
                      @zero-plus-partial-is-partial |
                        add(ZERO, mul(b, d)) = mul(b, d)
                        [by forall_elim(mul(b, d)) zero-prefix-is-identity]
                      @partial-witnesses-gap |
                        is_nonneg(mul(b, d)) and add(ZERO, mul(b, d)) = mul(b, d)
                        [by and_intro partial-product-nonneg zero-plus-partial-is-partial]
                      @zero-less_than-or-equal-partial-gap |
                        exists dd: Int; is_nonneg(dd) and add(ZERO, dd) = mul(b, d)
                        [by exists_intro(mul(b, d)) partial-witnesses-gap]
                      @at-most-is-gap-existential |
                        forall x, y: Int; at_most(x, y) iff (exists dd: Int; is_nonneg(dd) and add(x, dd) = y)
                        [by theorem lessOrEqualIsGapExistential]
                      @zero-at-most-partial-iff-gap |
                        at_most(ZERO, mul(b, d)) iff (exists dd: Int; is_nonneg(dd) and add(ZERO, dd) = mul(b, d))
                        [by forall_elim(ZERO, mul(b, d)) at-most-is-gap-existential]
                      @zero-at-most-partial-if-gap |
                        (exists dd: Int; is_nonneg(dd) and add(ZERO, dd) = mul(b, d)) -> at_most(ZERO, mul(b, d))
                        [by iff_elim_backward zero-at-most-partial-iff-gap]
                      @zero-at-most-partial |
                        at_most(ZERO, mul(b, d))
                        [by modus_ponens zero-at-most-partial-if-gap zero-less_than-or-equal-partial-gap]
                      @at-most-splits |
                        forall x, y: Int; at_most(x, y) -> (less_than(x, y) or x = y)
                        [by theorem lessOrEqualSplit]
                      @zero-less_than-or-equals-partial-if |
                        at_most(ZERO, mul(b, d)) -> (less_than(ZERO, mul(b, d)) or ZERO = mul(b, d))
                        [by forall_elim(ZERO, mul(b, d)) at-most-splits]
                      @zero-less_than-or-equals-partial |
                        less_than(ZERO, mul(b, d)) or ZERO = mul(b, d)
                        [by modus_ponens zero-less_than-or-equals-partial-if zero-at-most-partial]
                      @conclusion-product-positive |
                        less_than(ZERO, mul(b, k))
                        case zero-less_than-or-equals-partial {
                          @when-partial-positive |
                            assume less_than(ZERO, mul(b, d)) {
                              @partial-positive |
                                less_than(ZERO, mul(b, d))
                                [by hypothesis when-partial-positive]
                              @order-is-transitive |
                                forall x, y, z: Int; less_than(x, y) -> less_than(y, z) -> less_than(x, z)
                                [by theorem lessThanTransitive]
                              @zero-less_than-product-if-chain |
                                less_than(ZERO, mul(b, d)) -> less_than(mul(b, d), mul(b, k)) -> less_than(ZERO, mul(b, k))
                                [by forall_elim(ZERO, mul(b, d), mul(b, k)) order-is-transitive]
                              @conclusion-product-positive |
                                less_than(ZERO, mul(b, k))
                                [by tautology zero-less_than-product-if-chain partial-positive partial-less_than-product]
                            }
                          @when-partial-zero |
                            assume ZERO = mul(b, d) {
                              @partial-is-zero |
                                ZERO = mul(b, d)
                                [by hypothesis when-partial-zero]
                              @conclusion-product-positive |
                                less_than(ZERO, mul(b, k))
                                [by rewrite partial-is-zero partial-less_than-product]
                            }
                        }
                    }
                  @product-positive |
                    less_than(ZERO, mul(b, k))
                    [by exists_elim with-k-gap]
                }
              @k-positive-implies-product-positive |
                less_than(ZERO, k) -> less_than(ZERO, mul(b, k))
                [by implies_intro given-k-positive]
            }
          @b-positive-implies-conditional |
            less_than(ZERO, b) -> less_than(ZERO, k) -> less_than(ZERO, mul(b, k))
            [by implies_intro given-b-positive]
        }
      @discharge-k |
        forall k: Int; less_than(ZERO, b) -> less_than(ZERO, k) -> less_than(ZERO, mul(b, k))
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall b, k: Int; less_than(ZERO, b) -> less_than(ZERO, k) -> less_than(ZERO, mul(b, k))
    [by forall_intro generalize-b]
qed

theorem positiveFactorZeroForcesZero: forall b, z: Int;
  less_than(ZERO, b) -> mul(b, z) = ZERO -> z = ZERO
proof
  @generalize-b |
    fix b: Int {
      @generalize-z |
        fix z: Int {
          @given-b-positive |
            assume less_than(ZERO, b) {
              @given-product-zero |
                assume mul(b, z) = ZERO {
                  @b-positive |
                    less_than(ZERO, b)
                    [by hypothesis given-b-positive]
                  @product-zero |
                    mul(b, z) = ZERO
                    [by hypothesis given-product-zero]
                  @z-sign-trichotomy |
                    less_than(z, ZERO) or z = ZERO or less_than(ZERO, z)
                    [by specialize trichotomy(z, ZERO)]
                  @multiply-by-positive |
                    forall x, y: Int; less_than(ZERO, x) -> less_than(ZERO, y) -> less_than(ZERO, mul(x, y))
                    [by theorem productWithPositiveIsPositive]
                  @zero-not-less_than-zero |
                    not less_than(ZERO, ZERO)
                    [by specialize lessThanIrreflexive(ZERO)]
                  @conclusion-z-is-zero |
                    z = ZERO
                    case z-sign-trichotomy {
                      @when-z-negative |
                        assume less_than(z, ZERO) {
                          // -z > 0, so b*(-z) > 0; but b*(-z) = -(b*z) = -0 = 0. Absurd.
                          @z-negative |
                            less_than(z, ZERO)
                            [by hypothesis when-z-negative]
                          @z-gap-exists |
                            exists d: Int; is_nonneg(d) and add(z, succ(d)) = ZERO
                            [by specialize lessThanElim(z, ZERO) z-negative]
                          @with-z-gap |
                            unpack e: Int from z-gap-exists {
                              @gap-nonneg-and-reaches-zero |
                                is_nonneg(e) and add(z, succ(e)) = ZERO
                                [by hypothesis with-z-gap]
                              @gap-nonneg |
                                is_nonneg(e)
                                [by and_elim_left gap-nonneg-and-reaches-zero]
                              @gap-reaches-zero |
                                add(z, succ(e)) = ZERO
                                [by and_elim_right gap-nonneg-and-reaches-zero]
                              // succ(e) = neg(z): cancel z in add(z, succ e) = 0.
                              // Certifier gap marked via additiveInverseUnique.
                              @successor-gap-is-neg-z |
                                succ(e) = neg(z)
                                [by arithmetic fallback(additiveInverseUnique) gap-reaches-zero]
                              // succ(e) > 0 since 0 + succ(e) = succ(e) with e nonneg.
                              @strict-gap-witnesses-order |
                                forall x, dd, y: Int; is_nonneg(dd) -> add(x, succ(dd)) = y -> less_than(x, y)
                                [by axiom lessThanIntro]
                              @zero-less_than-succ-gap-if |
                                is_nonneg(e) -> add(ZERO, succ(e)) = succ(e) -> less_than(ZERO, succ(e))
                                [by forall_elim(ZERO, e, succ(e)) strict-gap-witnesses-order]
                              @zero-prefix-is-identity |
                                forall n: Int; add(ZERO, n) = n
                                [by axiom addZeroLeft]
                              @zero-plus-succ-gap |
                                add(ZERO, succ(e)) = succ(e)
                                [by forall_elim(succ(e)) zero-prefix-is-identity]
                              @zero-less_than-succ-gap |
                                less_than(ZERO, succ(e))
                                [by tautology zero-less_than-succ-gap-if gap-nonneg zero-plus-succ-gap]
                              @zero-less_than-neg-z |
                                less_than(ZERO, neg(z))
                                [by rewrite successor-gap-is-neg-z zero-less_than-succ-gap]
                              // b*(-z) > 0.
                              @b-times-negz-positive-if |
                                less_than(ZERO, b) -> less_than(ZERO, neg(z)) -> less_than(ZERO, mul(b, neg(z)))
                                [by forall_elim(b, neg(z)) multiply-by-positive]
                              @b-times-negz-positive |
                                less_than(ZERO, mul(b, neg(z)))
                                [by tautology b-times-negz-positive-if b-positive zero-less_than-neg-z]
                              // b*(-z) = -(b*z) = -0 = 0.
                              @b-times-negz-is-neg-product |
                                mul(b, neg(z)) = neg(mul(b, z))
                                [by specialize mulNegRight(b, z)]
                              @neg-product-reflexive |
                                neg(mul(b, z)) = neg(mul(b, z))
                                [by reflexivity]
                              @neg-product-is-neg-zero |
                                neg(mul(b, z)) = neg(ZERO)
                                [by rewrite product-zero neg-product-reflexive]
                              @negation-of-zero |
                                neg(ZERO) = ZERO
                                [by axiom negZero]
                              @neg-product-is-zero |
                                neg(mul(b, z)) = ZERO
                                [by rewrite negation-of-zero neg-product-is-neg-zero]
                              @b-times-negz-is-zero |
                                mul(b, neg(z)) = ZERO
                                [by rewrite neg-product-is-zero b-times-negz-is-neg-product]
                              @zero-less_than-zero |
                                less_than(ZERO, ZERO)
                                [by rewrite b-times-negz-is-zero b-times-negz-positive]
                              @conclusion-z-is-zero |
                                z = ZERO
                                [by absurd zero-less_than-zero zero-not-less_than-zero]
                            }
                          @conclusion-z-is-zero |
                            z = ZERO
                            [by exists_elim with-z-gap]
                        }
                      @when-z-zero |
                        assume z = ZERO {
                          @conclusion-z-is-zero |
                            z = ZERO
                            [by hypothesis when-z-zero]
                        }
                      @when-z-positive |
                        assume less_than(ZERO, z) {
                          // b*z > 0 contradicts b*z = 0.
                          @z-positive |
                            less_than(ZERO, z)
                            [by hypothesis when-z-positive]
                          @b-times-z-positive-if |
                            less_than(ZERO, b) -> less_than(ZERO, z) -> less_than(ZERO, mul(b, z))
                            [by specialize productWithPositiveIsPositive(b, z)]
                          @b-times-z-positive |
                            less_than(ZERO, mul(b, z))
                            [by tautology b-times-z-positive-if b-positive z-positive]
                          @zero-less_than-zero |
                            less_than(ZERO, ZERO)
                            [by rewrite product-zero b-times-z-positive]
                          @conclusion-z-is-zero |
                            z = ZERO
                            [by absurd zero-less_than-zero zero-not-less_than-zero]
                        }
                    }
                }
              @product-zero-implies-z-zero |
                mul(b, z) = ZERO -> z = ZERO
                [by implies_intro given-product-zero]
            }
          @b-positive-implies-conditional |
            less_than(ZERO, b) -> mul(b, z) = ZERO -> z = ZERO
            [by implies_intro given-b-positive]
        }
      @discharge-z |
        forall z: Int; less_than(ZERO, b) -> mul(b, z) = ZERO -> z = ZERO
        [by forall_intro generalize-z]
    }
  @conclusion |
    forall b, z: Int; less_than(ZERO, b) -> mul(b, z) = ZERO -> z = ZERO
    [by forall_intro generalize-b]
qed

theorem atMostThenLessThan: forall x, y, z: Int;
  at_most(x, y) -> less_than(y, z) -> less_than(x, z)
proof
  @generalize-x |
    fix x: Int {
      @generalize-y |
        fix y: Int {
          @generalize-z |
            fix z: Int {
              @given-x-at-most-y |
                assume at_most(x, y) {
                  @given-y-less_than-z |
                    assume less_than(y, z) {
                      @x-at-most-y |
                        at_most(x, y)
                        [by hypothesis given-x-at-most-y]
                      @y-less_than-z |
                        less_than(y, z)
                        [by hypothesis given-y-less_than-z]
                      @x-less_than-or-equals-y |
                        less_than(x, y) or x = y
                        [by specialize lessOrEqualSplit(x, y) x-at-most-y]
                      @conclusion-x-less_than-z |
                        less_than(x, z)
                        case x-less_than-or-equals-y {
                          @when-x-less_than-y |
                            assume less_than(x, y) {
                              @x-less_than-y |
                                less_than(x, y)
                                [by hypothesis when-x-less_than-y]
                              @conclusion-x-less_than-z |
                                less_than(x, z)
                                [by specialize lessThanTransitive(x, y, z) x-less_than-y y-less_than-z]
                            }
                          @when-x-equals-y |
                            assume x = y {
                              @x-equals-y |
                                x = y
                                [by hypothesis when-x-equals-y]
                              @conclusion-x-less_than-z |
                                less_than(x, z)
                                [by rewrite x-equals-y y-less_than-z]
                            }
                        }
                    }
                  @y-less_than-z-implies-x-less_than-z |
                    less_than(y, z) -> less_than(x, z)
                    [by implies_intro given-y-less_than-z]
                }
              @x-at-most-y-implies |
                at_most(x, y) -> less_than(y, z) -> less_than(x, z)
                [by implies_intro given-x-at-most-y]
            }
          @discharge-z |
            forall z: Int; at_most(x, y) -> less_than(y, z) -> less_than(x, z)
            [by forall_intro generalize-z]
        }
      @discharge-y |
        forall y, z: Int; at_most(x, y) -> less_than(y, z) -> less_than(x, z)
        [by forall_intro generalize-y]
    }
  @conclusion |
    forall x, y, z: Int; at_most(x, y) -> less_than(y, z) -> less_than(x, z)
    [by forall_intro generalize-x]
qed

theorem lessThanGivesNonnegDifference: forall x, y: Int;
  less_than(x, y) -> is_nonneg(sub(y, x))
proof
  @generalize-x |
    fix x: Int {
      @generalize-y |
        fix y: Int {
          @given-x-less_than-y |
            assume less_than(x, y) {
              @x-less_than-y |
                less_than(x, y)
                [by hypothesis given-x-less_than-y]
              @gap-exists |
                exists d: Int; is_nonneg(d) and add(x, succ(d)) = y
                [by specialize lessThanElim(x, y) x-less_than-y]
              @with-gap |
                unpack d: Int from gap-exists {
                  @gap-nonneg-and-reaches |
                    is_nonneg(d) and add(x, succ(d)) = y
                    [by hypothesis with-gap]
                  @gap-nonneg |
                    is_nonneg(d)
                    [by and_elim_left gap-nonneg-and-reaches]
                  @gap-reaches-y |
                    add(x, succ(d)) = y
                    [by and_elim_right gap-nonneg-and-reaches]
                  // sub(y, x) = succ(d): rearrange add(x, succ(d)) = y linearly.
                  @difference-is-successor-gap |
                    sub(y, x) = succ(d)
                    [by arithmetic gap-reaches-y]
                  @successor-gap-nonneg-if |
                    is_nonneg(d) -> is_nonneg(succ(d))
                    [by specialize nonnegSucc(d)]
                  @successor-gap-nonneg |
                    is_nonneg(succ(d))
                    [by modus_ponens successor-gap-nonneg-if gap-nonneg]
                  @conclusion-difference-nonneg |
                    is_nonneg(sub(y, x))
                    [by rewrite difference-is-successor-gap successor-gap-nonneg]
                }
              @difference-nonneg |
                is_nonneg(sub(y, x))
                [by exists_elim with-gap]
            }
          @x-less_than-y-implies-nonneg-difference |
            less_than(x, y) -> is_nonneg(sub(y, x))
            [by implies_intro given-x-less_than-y]
        }
      @discharge-y |
        forall y: Int; less_than(x, y) -> is_nonneg(sub(y, x))
        [by forall_intro generalize-y]
    }
  @conclusion |
    forall x, y: Int; less_than(x, y) -> is_nonneg(sub(y, x))
    [by forall_intro generalize-x]
qed

theorem distributesOverDifference: forall b, q1, q2: Int;
  mul(b, sub(q1, q2)) = sub(mul(b, q1), mul(b, q2))
proof
  @generalize-b |
    fix b: Int {
      @generalize-q1 |
        fix q1: Int {
          @generalize-q2 |
            fix q2: Int {
              @conclusion-distribute |
                mul(b, sub(q1, q2)) = sub(mul(b, q1), mul(b, q2))
                [by simplify definitionOfSubtraction mulAddDistribLeft mulNegRight]
            }
          @discharge-q2 |
            forall q2: Int; mul(b, sub(q1, q2)) = sub(mul(b, q1), mul(b, q2))
            [by forall_intro generalize-q2]
        }
      @discharge-q1 |
        forall q1, q2: Int; mul(b, sub(q1, q2)) = sub(mul(b, q1), mul(b, q2))
        [by forall_intro generalize-q1]
    }
  @conclusion |
    forall b, q1, q2: Int; mul(b, sub(q1, q2)) = sub(mul(b, q1), mul(b, q2))
    [by forall_intro generalize-b]
qed

// Left cancellation for a positive factor: a·x = a·y with a > 0 forces x = y.
// a·(x−y) = a·x − a·y = 0 (distribute over the difference, use the hypothesis),
// so by positiveFactorZeroForcesZero x − y = 0, whence x = y.
theorem mulCancelLeft: forall a, x, y: Int;
  less_than(ZERO, a) -> mul(a, x) = mul(a, y) -> x = y
proof
  @generalize-a |
    fix a: Int {
      @generalize-x |
        fix x: Int {
          @generalize-y |
            fix y: Int {
              @given-a-positive |
                assume less_than(ZERO, a) {
                  @given-products-equal |
                    assume mul(a, x) = mul(a, y) {
                      @a-positive |
                        less_than(ZERO, a)
                        [by hypothesis given-a-positive]
                      @products-equal |
                        mul(a, x) = mul(a, y)
                        [by hypothesis given-products-equal]
                      // a·(x−y) = a·x − a·y
                      @product-of-difference |
                        mul(a, sub(x, y)) = sub(mul(a, x), mul(a, y))
                        [by specialize distributesOverDifference(a, x, y)]
                      // a·x − a·y = a·y − a·y, using a·x = a·y
                      @reflexivity-of-collapse |
                        sub(mul(a, x), mul(a, y)) = sub(mul(a, x), mul(a, y))
                        [by reflexivity]
                      @difference-collapses |
                        sub(mul(a, x), mul(a, y)) = sub(mul(a, y), mul(a, y))
                        [by rewrite products-equal reflexivity-of-collapse]
                      // a·y − a·y = 0
                      @collapsed-difference-is-zero |
                        sub(mul(a, y), mul(a, y)) = ZERO
                        [by arithmetic]
                      @product-difference-collapses |
                        mul(a, sub(x, y)) = sub(mul(a, y), mul(a, y))
                        [by rewrite difference-collapses product-of-difference]
                      @product-of-difference-is-zero |
                        mul(a, sub(x, y)) = ZERO
                        [by rewrite collapsed-difference-is-zero product-difference-collapses]
                      // a > 0 and a·(x−y) = 0 force x−y = 0
                      @positive-factor-zero |
                        forall b, z: Int; less_than(ZERO, b) -> mul(b, z) = ZERO -> z = ZERO
                        [by theorem positiveFactorZeroForcesZero]
                      @difference-forced-zero-if |
                        less_than(ZERO, a) -> mul(a, sub(x, y)) = ZERO -> sub(x, y) = ZERO
                        [by forall_elim(a, sub(x, y)) positive-factor-zero]
                      @difference-is-zero |
                        sub(x, y) = ZERO
                        [by tautology difference-forced-zero-if a-positive product-of-difference-is-zero]
                      // x − y = 0 gives x = y: (x−y)+y = x and (x−y)+y = 0+y = y
                      @difference-plus-y-is-x |
                        add(sub(x, y), y) = x
                        [by arithmetic]
                      @zero-plus-y-is-x |
                        add(ZERO, y) = x
                        [by rewrite difference-is-zero difference-plus-y-is-x]
                      @zero-plus-y-is-y |
                        add(ZERO, y) = y
                        [by specialize addZeroLeft(y)]
                      // y = add(ZERO, y) = x
                      @y-is-zero-plus-y |
                        y = add(ZERO, y)
                        [by symmetry zero-plus-y-is-y]
                      @y-equals-x |
                        y = x
                        [by rewrite zero-plus-y-is-x y-is-zero-plus-y]
                      @conclusion-x-equals-y |
                        x = y
                        [by symmetry y-equals-x]
                    }
                  @products-equal-gives-equal |
                    mul(a, x) = mul(a, y) -> x = y
                    [by implies_intro given-products-equal]
                }
              @positive-gives-cancel |
                less_than(ZERO, a) -> mul(a, x) = mul(a, y) -> x = y
                [by implies_intro given-a-positive]
            }
          @discharge-y |
            forall y: Int; less_than(ZERO, a) -> mul(a, x) = mul(a, y) -> x = y
            [by forall_intro generalize-y]
        }
      @discharge-x |
        forall x, y: Int; less_than(ZERO, a) -> mul(a, x) = mul(a, y) -> x = y
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall a, x, y: Int; less_than(ZERO, a) -> mul(a, x) = mul(a, y) -> x = y
    [by forall_intro generalize-a]
qed

// Right cancellation: x·a = y·a with a > 0 forces x = y. Commute both products
// to a·x = a·y and apply mulCancelLeft.
theorem mulCancelRight: forall a, x, y: Int;
  less_than(ZERO, a) -> mul(x, a) = mul(y, a) -> x = y
proof
  @generalize-a |
    fix a: Int {
      @generalize-x |
        fix x: Int {
          @generalize-y |
            fix y: Int {
              @given-a-positive |
                assume less_than(ZERO, a) {
                  @given-products-equal |
                    assume mul(x, a) = mul(y, a) {
                      @a-positive |
                        less_than(ZERO, a)
                        [by hypothesis given-a-positive]
                      @products-equal |
                        mul(x, a) = mul(y, a)
                        [by hypothesis given-products-equal]
                      @x-times-a-commutes |
                        mul(x, a) = mul(a, x)
                        [by specialize mulIsCommutative(x, a)]
                      @y-times-a-commutes |
                        mul(y, a) = mul(a, y)
                        [by specialize mulIsCommutative(y, a)]
                      @left-products-equal-step |
                        mul(a, x) = mul(y, a)
                        [by rewrite x-times-a-commutes products-equal]
                      @left-products-equal |
                        mul(a, x) = mul(a, y)
                        [by rewrite y-times-a-commutes left-products-equal-step]
                      @cancel-at-a-x-y |
                        less_than(ZERO, a) -> mul(a, x) = mul(a, y) -> x = y
                        [by specialize mulCancelLeft(a, x, y)]
                      @conclusion-x-equals-y |
                        x = y
                        [by tautology cancel-at-a-x-y a-positive left-products-equal]
                    }
                  @products-equal-gives-equal |
                    mul(x, a) = mul(y, a) -> x = y
                    [by implies_intro given-products-equal]
                }
              @positive-gives-cancel |
                less_than(ZERO, a) -> mul(x, a) = mul(y, a) -> x = y
                [by implies_intro given-a-positive]
            }
          @discharge-y |
            forall y: Int; less_than(ZERO, a) -> mul(x, a) = mul(y, a) -> x = y
            [by forall_intro generalize-y]
        }
      @discharge-x |
        forall x, y: Int; less_than(ZERO, a) -> mul(x, a) = mul(y, a) -> x = y
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall a, x, y: Int; less_than(ZERO, a) -> mul(x, a) = mul(y, a) -> x = y
    [by forall_intro generalize-a]
qed

theorem remainderDifferenceIsMultiple: forall b, q1, r1, q2, r2: Int;
  add(mul(b, q1), r1) = add(mul(b, q2), r2) -> sub(r2, r1) = mul(b, sub(q1, q2))
proof
  @generalize-b |
    fix b: Int {
      @generalize-q1 |
        fix q1: Int {
          @generalize-r1 |
            fix r1: Int {
              @generalize-q2 |
                fix q2: Int {
                  @generalize-r2 |
                    fix r2: Int {
                      @given-decompositions-equal |
                        assume add(mul(b, q1), r1) = add(mul(b, q2), r2) {
                          @decompositions-equal |
                            add(mul(b, q1), r1) = add(mul(b, q2), r2)
                            [by hypothesis given-decompositions-equal]
                          @sub-def |
                            forall u, v: Int; sub(u, v) = add(u, neg(v))
                            [by axiom definitionOfSubtraction]
                          @difference-of-remainders-unfolds |
                            sub(r2, r1) = add(r2, neg(r1))
                            [by specialize definitionOfSubtraction(r2, r1)]
                          @difference-of-products-unfolds |
                            sub(mul(b, q1), mul(b, q2)) = add(mul(b, q1), neg(mul(b, q2)))
                            [by forall_elim(mul(b, q1), mul(b, q2)) sub-def]
                          // cancel bq2 in the decomposition equality: r2-r1 = bq1-bq2.
                          @remainder-difference-equals-product-difference |
                            add(r2, neg(r1)) = add(mul(b, q1), neg(mul(b, q2)))
                            [by arithmetic decompositions-equal]
                          // fold both sides back to sub form, and sub(bq1,bq2) = b*(q1-q2).
                          @product-difference-is-multiple |
                            mul(b, sub(q1, q2)) = sub(mul(b, q1), mul(b, q2))
                            [by specialize distributesOverDifference(b, q1, q2)]
                          // r2-r1 = r2+(-r1) = bq1+(-bq2) = bq1-bq2 = b*(q1-q2)
                          @conclusion-difference-is-multiple |
                            sub(r2, r1) = mul(b, sub(q1, q2))
                            [by chain difference-of-remainders-unfolds remainder-difference-equals-product-difference difference-of-products-unfolds product-difference-is-multiple]
                        }
                      @decompositions-equal-implies |
                        add(mul(b, q1), r1) = add(mul(b, q2), r2) -> sub(r2, r1) = mul(b, sub(q1, q2))
                        [by implies_intro given-decompositions-equal]
                    }
                  @discharge-r2 |
                    forall r2: Int; add(mul(b, q1), r1) = add(mul(b, q2), r2) -> sub(r2, r1) = mul(b, sub(q1, q2))
                    [by forall_intro generalize-r2]
                }
              @discharge-q2 |
                forall q2, r2: Int; add(mul(b, q1), r1) = add(mul(b, q2), r2) -> sub(r2, r1) = mul(b, sub(q1, q2))
                [by forall_intro generalize-q2]
            }
          @discharge-r1 |
            forall r1, q2, r2: Int; add(mul(b, q1), r1) = add(mul(b, q2), r2) -> sub(r2, r1) = mul(b, sub(q1, q2))
            [by forall_intro generalize-r1]
        }
      @discharge-q1 |
        forall q1, r1, q2, r2: Int; add(mul(b, q1), r1) = add(mul(b, q2), r2) -> sub(r2, r1) = mul(b, sub(q1, q2))
        [by forall_intro generalize-q1]
    }
  @conclusion |
    forall b, q1, r1, q2, r2: Int; add(mul(b, q1), r1) = add(mul(b, q2), r2) -> sub(r2, r1) = mul(b, sub(q1, q2))
    [by forall_intro generalize-b]
qed

theorem boundedRemainderDifferenceIsZero: forall b, small, big: Int;
  less_than(ZERO, b) -> is_nonneg(small) -> less_than(big, b) -> less_than(small, big) ->
  divides(b, sub(big, small)) -> sub(big, small) = ZERO
proof
  @generalize-b |
    fix b: Int {
      @generalize-small |
        fix small: Int {
          @generalize-big |
            fix big: Int {
              @given-b-positive |
                assume less_than(ZERO, b) {
                  @given-small-nonneg |
                    assume is_nonneg(small) {
                      @given-big-less_than-b |
                        assume less_than(big, b) {
                          @given-small-less_than-big |
                            assume less_than(small, big) {
                              @given-b-divides-difference |
                                assume divides(b, sub(big, small)) {
                                  @b-positive |
                                    less_than(ZERO, b)
                                    [by hypothesis given-b-positive]
                                  @small-nonneg |
                                    is_nonneg(small)
                                    [by hypothesis given-small-nonneg]
                                  @big-less_than-b |
                                    less_than(big, b)
                                    [by hypothesis given-big-less_than-b]
                                  @small-less_than-big |
                                    less_than(small, big)
                                    [by hypothesis given-small-less_than-big]
                                  @b-divides-difference |
                                    divides(b, sub(big, small))
                                    [by hypothesis given-b-divides-difference]
                                  // difference is nonneg (small < big).
                                  @difference-nonneg |
                                    is_nonneg(sub(big, small))
                                    [by specialize lessThanGivesNonnegDifference(small, big) small-less_than-big]
                                  // difference <= big (subtracting a nonneg), and big < b.
                                  @difference-plus-small-is-big |
                                    add(sub(big, small), small) = big
                                    [by arithmetic]
                                  @small-witnesses-difference-at-most-big |
                                    is_nonneg(small) and add(sub(big, small), small) = big
                                    [by and_intro small-nonneg difference-plus-small-is-big]
                                  @difference-less_than-or-equal-big-gap |
                                    exists d: Int; is_nonneg(d) and add(sub(big, small), d) = big
                                    [by exists_intro(small) small-witnesses-difference-at-most-big]
                                  @at-most-is-gap-existential |
                                    forall x, y: Int; at_most(x, y) iff (exists d: Int; is_nonneg(d) and add(x, d) = y)
                                    [by theorem lessOrEqualIsGapExistential]
                                  @difference-at-most-big-iff-gap |
                                    at_most(sub(big, small), big) iff (exists d: Int; is_nonneg(d) and add(sub(big, small), d) = big)
                                    [by forall_elim(sub(big, small), big) at-most-is-gap-existential]
                                  @difference-at-most-big-if-gap |
                                    (exists d: Int; is_nonneg(d) and add(sub(big, small), d) = big) -> at_most(sub(big, small), big)
                                    [by iff_elim_backward difference-at-most-big-iff-gap]
                                  @difference-at-most-big |
                                    at_most(sub(big, small), big)
                                    [by modus_ponens difference-at-most-big-if-gap difference-less_than-or-equal-big-gap]
                                  @at-most-then-less_than |
                                    forall x, y, z: Int; at_most(x, y) -> less_than(y, z) -> less_than(x, z)
                                    [by theorem atMostThenLessThan]
                                  @difference-less_than-b-if |
                                    at_most(sub(big, small), big) -> less_than(big, b) -> less_than(sub(big, small), b)
                                    [by forall_elim(sub(big, small), big, b) at-most-then-less_than]
                                  @difference-less_than-b |
                                    less_than(sub(big, small), b)
                                    [by tautology difference-less_than-b-if difference-at-most-big big-less_than-b]
                                  // a nonneg multiple of b less_than b is zero.
                                  @bounded-multiple-is-zero |
                                    forall bb, m: Int; less_than(ZERO, bb) -> divides(bb, m) -> is_nonneg(m) -> less_than(m, bb) -> m = ZERO
                                    [by theorem boundedNonnegMultipleIsZero]
                                  @difference-is-zero-if |
                                    less_than(ZERO, b) -> divides(b, sub(big, small)) -> is_nonneg(sub(big, small)) -> less_than(sub(big, small), b) -> sub(big, small) = ZERO
                                    [by forall_elim(b, sub(big, small)) bounded-multiple-is-zero]
                                  @conclusion-difference-is-zero |
                                    sub(big, small) = ZERO
                                    [by tautology difference-is-zero-if b-positive b-divides-difference difference-nonneg difference-less_than-b]
                                }
                              @divides-implies-zero |
                                divides(b, sub(big, small)) -> sub(big, small) = ZERO
                                [by implies_intro given-b-divides-difference]
                            }
                          @small-less_than-big-implies |
                            less_than(small, big) -> divides(b, sub(big, small)) -> sub(big, small) = ZERO
                            [by implies_intro given-small-less_than-big]
                        }
                      @big-less_than-b-implies |
                        less_than(big, b) -> less_than(small, big) -> divides(b, sub(big, small)) -> sub(big, small) = ZERO
                        [by implies_intro given-big-less_than-b]
                    }
                  @small-nonneg-implies |
                    is_nonneg(small) -> less_than(big, b) -> less_than(small, big) -> divides(b, sub(big, small)) -> sub(big, small) = ZERO
                    [by implies_intro given-small-nonneg]
                }
              @b-positive-implies |
                less_than(ZERO, b) -> is_nonneg(small) -> less_than(big, b) -> less_than(small, big) -> divides(b, sub(big, small)) -> sub(big, small) = ZERO
                [by implies_intro given-b-positive]
            }
          @discharge-big |
            forall big: Int; less_than(ZERO, b) -> is_nonneg(small) -> less_than(big, b) -> less_than(small, big) -> divides(b, sub(big, small)) -> sub(big, small) = ZERO
            [by forall_intro generalize-big]
        }
      @discharge-small |
        forall small, big: Int; less_than(ZERO, b) -> is_nonneg(small) -> less_than(big, b) -> less_than(small, big) -> divides(b, sub(big, small)) -> sub(big, small) = ZERO
        [by forall_intro generalize-small]
    }
  @conclusion |
    forall b, small, big: Int; less_than(ZERO, b) -> is_nonneg(small) -> less_than(big, b) -> less_than(small, big) -> divides(b, sub(big, small)) -> sub(big, small) = ZERO
    [by forall_intro generalize-b]
qed

theorem remaindersEqual: forall b, q1, r1, q2, r2: Int;
  less_than(ZERO, b) -> is_nonneg(r1) -> less_than(r1, b) -> is_nonneg(r2) -> less_than(r2, b) ->
  add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
proof
  @generalize-b |
    fix b: Int {
      @generalize-q1 |
        fix q1: Int {
          @generalize-r1 |
            fix r1: Int {
              @generalize-q2 |
                fix q2: Int {
                  @generalize-r2 |
                    fix r2: Int {
                      @given-b-positive |
                        assume less_than(ZERO, b) {
                          @given-r1-nonneg |
                            assume is_nonneg(r1) {
                              @given-r1-less_than-b |
                                assume less_than(r1, b) {
                                  @given-r2-nonneg |
                                    assume is_nonneg(r2) {
                                      @given-r2-less_than-b |
                                        assume less_than(r2, b) {
                                          @given-decompositions-equal |
                                            assume add(mul(b, q1), r1) = add(mul(b, q2), r2) {
                                              @b-positive |
                                                less_than(ZERO, b)
                                                [by hypothesis given-b-positive]
                                              @r1-nonneg |
                                                is_nonneg(r1)
                                                [by hypothesis given-r1-nonneg]
                                              @r1-less_than-b |
                                                less_than(r1, b)
                                                [by hypothesis given-r1-less_than-b]
                                              @r2-nonneg |
                                                is_nonneg(r2)
                                                [by hypothesis given-r2-nonneg]
                                              @r2-less_than-b |
                                                less_than(r2, b)
                                                [by hypothesis given-r2-less_than-b]
                                              @decompositions-equal |
                                                add(mul(b, q1), r1) = add(mul(b, q2), r2)
                                                [by hypothesis given-decompositions-equal]
                                              @r1-r2-trichotomy |
                                                less_than(r1, r2) or r1 = r2 or less_than(r2, r1)
                                                [by specialize trichotomy(r1, r2)]
                                              @conclusion-remainders-equal |
                                                r1 = r2
                                                case r1-r2-trichotomy {
                                                  @when-r1-less_than-r2 |
                                                    assume less_than(r1, r2) {
                                                      @r1-less_than-r2 |
                                                        less_than(r1, r2)
                                                        [by hypothesis when-r1-less_than-r2]
                                                      // sub(r2,r1) = b*(q1-q2), so b | sub(r2,r1).
                                                      @r2-minus-r1-multiple |
                                                        sub(r2, r1) = mul(b, sub(q1, q2))
                                                        [by specialize remainderDifferenceIsMultiple(b, q1, r1, q2, r2) decompositions-equal]
                                                      @b-divides-r2-minus-r1 |
                                                        divides(b, sub(r2, r1))
                                                        [by exists_intro(sub(q1, q2)) r2-minus-r1-multiple]
                                                      @r2-minus-r1-zero-if |
                                                        less_than(ZERO, b) -> is_nonneg(r1) -> less_than(r2, b) -> less_than(r1, r2) -> divides(b, sub(r2, r1)) -> sub(r2, r1) = ZERO
                                                        [by specialize boundedRemainderDifferenceIsZero(b, r1, r2)]
                                                      @r2-minus-r1-zero |
                                                        sub(r2, r1) = ZERO
                                                        [by tautology r2-minus-r1-zero-if b-positive r1-nonneg r2-less_than-b r1-less_than-r2 b-divides-r2-minus-r1]
                                                      // sub(r2,r1)=0 gives r2 = r1.
                                                      @difference-plus-r1-is-r2 |
                                                        add(sub(r2, r1), r1) = r2
                                                        [by arithmetic]
                                                      @zero-plus-r1-is-r2 |
                                                        add(ZERO, r1) = r2
                                                        [by rewrite r2-minus-r1-zero difference-plus-r1-is-r2]
                                                      @zero-plus-r1-is-r1 |
                                                        add(ZERO, r1) = r1
                                                        [by specialize addZeroLeft(r1)]
                                                      @conclusion-remainders-equal |
                                                        r1 = r2
                                                        [by rewrite zero-plus-r1-is-r1 zero-plus-r1-is-r2]
                                                    }
                                                  @when-remainders-equal |
                                                    assume r1 = r2 {
                                                      @conclusion-remainders-equal |
                                                        r1 = r2
                                                        [by hypothesis when-remainders-equal]
                                                    }
                                                  @when-r2-less_than-r1 |
                                                    assume less_than(r2, r1) {
                                                      @r2-less_than-r1 |
                                                        less_than(r2, r1)
                                                        [by hypothesis when-r2-less_than-r1]
                                                      // flip the equation; sub(r1,r2) = b*(q2-q1).
                                                      @decompositions-equal-flipped |
                                                        add(mul(b, q2), r2) = add(mul(b, q1), r1)
                                                        [by symmetry decompositions-equal]
                                                      @r1-minus-r2-multiple |
                                                        sub(r1, r2) = mul(b, sub(q2, q1))
                                                        [by specialize remainderDifferenceIsMultiple(b, q2, r2, q1, r1) decompositions-equal-flipped]
                                                      @b-divides-r1-minus-r2 |
                                                        divides(b, sub(r1, r2))
                                                        [by exists_intro(sub(q2, q1)) r1-minus-r2-multiple]
                                                      @r1-minus-r2-zero-if |
                                                        less_than(ZERO, b) -> is_nonneg(r2) -> less_than(r1, b) -> less_than(r2, r1) -> divides(b, sub(r1, r2)) -> sub(r1, r2) = ZERO
                                                        [by specialize boundedRemainderDifferenceIsZero(b, r2, r1)]
                                                      @r1-minus-r2-zero |
                                                        sub(r1, r2) = ZERO
                                                        [by tautology r1-minus-r2-zero-if b-positive r2-nonneg r1-less_than-b r2-less_than-r1 b-divides-r1-minus-r2]
                                                      @difference-plus-r2-is-r1 |
                                                        add(sub(r1, r2), r2) = r1
                                                        [by arithmetic]
                                                      @zero-plus-r2-is-r1 |
                                                        add(ZERO, r2) = r1
                                                        [by rewrite r1-minus-r2-zero difference-plus-r2-is-r1]
                                                      @zero-plus-r2-is-r2 |
                                                        add(ZERO, r2) = r2
                                                        [by specialize addZeroLeft(r2)]
                                                      @r2-is-r1 |
                                                        r2 = r1
                                                        [by rewrite zero-plus-r2-is-r2 zero-plus-r2-is-r1]
                                                      @conclusion-remainders-equal |
                                                        r1 = r2
                                                        [by symmetry r2-is-r1]
                                                    }
                                                }
                                            }
                                          @decompositions-equal-implies |
                                            add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
                                            [by implies_intro given-decompositions-equal]
                                        }
                                      @r2-less_than-b-implies |
                                        less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
                                        [by implies_intro given-r2-less_than-b]
                                    }
                                  @r2-nonneg-implies |
                                    is_nonneg(r2) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
                                    [by implies_intro given-r2-nonneg]
                                }
                              @r1-less_than-b-implies |
                                less_than(r1, b) -> is_nonneg(r2) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
                                [by implies_intro given-r1-less_than-b]
                            }
                          @r1-nonneg-implies |
                            is_nonneg(r1) -> less_than(r1, b) -> is_nonneg(r2) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
                            [by implies_intro given-r1-nonneg]
                        }
                      @b-positive-implies |
                        less_than(ZERO, b) -> is_nonneg(r1) -> less_than(r1, b) -> is_nonneg(r2) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
                        [by implies_intro given-b-positive]
                    }
                  @discharge-r2 |
                    forall r2: Int; less_than(ZERO, b) -> is_nonneg(r1) -> less_than(r1, b) -> is_nonneg(r2) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
                    [by forall_intro generalize-r2]
                }
              @discharge-q2 |
                forall q2, r2: Int; less_than(ZERO, b) -> is_nonneg(r1) -> less_than(r1, b) -> is_nonneg(r2) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
                [by forall_intro generalize-q2]
            }
          @discharge-r1 |
            forall r1, q2, r2: Int; less_than(ZERO, b) -> is_nonneg(r1) -> less_than(r1, b) -> is_nonneg(r2) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
            [by forall_intro generalize-r1]
        }
      @discharge-q1 |
        forall q1, r1, q2, r2: Int; less_than(ZERO, b) -> is_nonneg(r1) -> less_than(r1, b) -> is_nonneg(r2) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
        [by forall_intro generalize-q1]
    }
  @conclusion |
    forall b, q1, r1, q2, r2: Int; less_than(ZERO, b) -> is_nonneg(r1) -> less_than(r1, b) -> is_nonneg(r2) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
    [by forall_intro generalize-b]
qed

theorem divisionAlgorithmUnique: forall a, b, q1, r1, q2, r2: Int;
  less_than(ZERO, b) ->
  a = add(mul(b, q1), r1) -> is_nonneg(r1) -> less_than(r1, b) ->
  a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) ->
  (q1 = q2 and r1 = r2)
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @generalize-q1 |
            fix q1: Int {
              @generalize-r1 |
                fix r1: Int {
                  @generalize-q2 |
                    fix q2: Int {
                      @generalize-r2 |
                        fix r2: Int {
                          @given-b-positive |
                            assume less_than(ZERO, b) {
                              @given-first-decomposition |
                                assume a = add(mul(b, q1), r1) {
                                  @given-r1-nonneg |
                                    assume is_nonneg(r1) {
                                      @given-r1-less_than-b |
                                        assume less_than(r1, b) {
                                          @given-second-decomposition |
                                            assume a = add(mul(b, q2), r2) {
                                              @given-r2-nonneg |
                                                assume is_nonneg(r2) {
                                                  @given-r2-less_than-b |
                                                    assume less_than(r2, b) {
                                                      @b-positive |
                                                        less_than(ZERO, b)
                                                        [by hypothesis given-b-positive]
                                                      @first-decomposition |
                                                        a = add(mul(b, q1), r1)
                                                        [by hypothesis given-first-decomposition]
                                                      @r1-nonneg |
                                                        is_nonneg(r1)
                                                        [by hypothesis given-r1-nonneg]
                                                      @r1-less_than-b |
                                                        less_than(r1, b)
                                                        [by hypothesis given-r1-less_than-b]
                                                      @second-decomposition |
                                                        a = add(mul(b, q2), r2)
                                                        [by hypothesis given-second-decomposition]
                                                      @r2-nonneg |
                                                        is_nonneg(r2)
                                                        [by hypothesis given-r2-nonneg]
                                                      @r2-less_than-b |
                                                        less_than(r2, b)
                                                        [by hypothesis given-r2-less_than-b]
                                                      // the two decompositions of a coincide.
                                                      @first-decomposition-flipped |
                                                        add(mul(b, q1), r1) = a
                                                        [by symmetry first-decomposition]
                                                      @decompositions-equal |
                                                        add(mul(b, q1), r1) = add(mul(b, q2), r2)
                                                        [by rewrite second-decomposition first-decomposition-flipped]
                                                      // remainders agree.
                                                      @remainders-equal-if |
                                                        less_than(ZERO, b) -> is_nonneg(r1) -> less_than(r1, b) -> is_nonneg(r2) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> r1 = r2
                                                        [by specialize remaindersEqual(b, q1, r1, q2, r2)]
                                                      @remainders-equal |
                                                        r1 = r2
                                                        [by tautology remainders-equal-if b-positive r1-nonneg r1-less_than-b r2-nonneg r2-less_than-b decompositions-equal]
                                                      // substitute r2 = r1 and cancel the common remainder.
                                                      @decompositions-equal-same-remainder |
                                                        add(mul(b, q1), r1) = add(mul(b, q2), r1)
                                                        [by rewrite remainders-equal decompositions-equal]
                                                      @addition-commutes |
                                                        forall u, v: Int; add(u, v) = add(v, u)
                                                        [by theorem addIsCommutative]
                                                      @left-commuted |
                                                        add(mul(b, q1), r1) = add(r1, mul(b, q1))
                                                        [by forall_elim(mul(b, q1), r1) addition-commutes]
                                                      @right-commuted |
                                                        add(mul(b, q2), r1) = add(r1, mul(b, q2))
                                                        [by forall_elim(mul(b, q2), r1) addition-commutes]
                                                      @remainder-prefixed-equal-partial |
                                                        add(r1, mul(b, q1)) = add(mul(b, q2), r1)
                                                        [by rewrite left-commuted decompositions-equal-same-remainder]
                                                      @remainder-prefixed-equal |
                                                        add(r1, mul(b, q1)) = add(r1, mul(b, q2))
                                                        [by rewrite right-commuted remainder-prefixed-equal-partial]
                                                      @cancel-remainder-on-left |
                                                        forall c, u, v: Int; add(c, u) = add(c, v) -> u = v
                                                        [by theorem addCancelLeft]
                                                      @products-equal-if-cancel |
                                                        add(r1, mul(b, q1)) = add(r1, mul(b, q2)) -> mul(b, q1) = mul(b, q2)
                                                        [by forall_elim(r1, mul(b, q1), mul(b, q2)) cancel-remainder-on-left]
                                                      @products-equal |
                                                        mul(b, q1) = mul(b, q2)
                                                        [by modus_ponens products-equal-if-cancel remainder-prefixed-equal]
                                                      // b*(q1-q2) = bq1 - bq2 = 0.
                                                      @product-of-quotient-difference |
                                                        mul(b, sub(q1, q2)) = sub(mul(b, q1), mul(b, q2))
                                                        [by specialize distributesOverDifference(b, q1, q2)]
                                                      @products-difference-reflexive |
                                                        sub(mul(b, q1), mul(b, q2)) = sub(mul(b, q1), mul(b, q2))
                                                        [by reflexivity]
                                                      @difference-of-equal-products |
                                                        sub(mul(b, q1), mul(b, q2)) = sub(mul(b, q1), mul(b, q1))
                                                        [by rewrite products-equal products-difference-reflexive]
                                                      @product-self-difference-zero |
                                                        sub(mul(b, q1), mul(b, q1)) = ZERO
                                                        [by arithmetic]
                                                      @products-difference-zero |
                                                        sub(mul(b, q1), mul(b, q2)) = ZERO
                                                        [by rewrite product-self-difference-zero difference-of-equal-products]
                                                      @quotient-difference-times-b-zero |
                                                        mul(b, sub(q1, q2)) = ZERO
                                                        [by rewrite products-difference-zero product-of-quotient-difference]
                                                      // b > 0 forces the factor sub(q1,q2) to be 0.
                                                      @positive-factor-zero |
                                                        forall bb, zz: Int; less_than(ZERO, bb) -> mul(bb, zz) = ZERO -> zz = ZERO
                                                        [by theorem positiveFactorZeroForcesZero]
                                                      @quotient-difference-zero-if |
                                                        less_than(ZERO, b) -> mul(b, sub(q1, q2)) = ZERO -> sub(q1, q2) = ZERO
                                                        [by forall_elim(b, sub(q1, q2)) positive-factor-zero]
                                                      @quotient-difference-zero |
                                                        sub(q1, q2) = ZERO
                                                        [by tautology quotient-difference-zero-if b-positive quotient-difference-times-b-zero]
                                                      // sub(q1,q2)=0 gives q1 = q2.
                                                      @difference-plus-q2-is-q1 |
                                                        add(sub(q1, q2), q2) = q1
                                                        [by arithmetic]
                                                      @zero-plus-q2-is-q1 |
                                                        add(ZERO, q2) = q1
                                                        [by rewrite quotient-difference-zero difference-plus-q2-is-q1]
                                                      @zero-plus-q2-is-q2 |
                                                        add(ZERO, q2) = q2
                                                        [by specialize addZeroLeft(q2)]
                                                      @q2-is-q1 |
                                                        q2 = q1
                                                        [by rewrite zero-plus-q2-is-q2 zero-plus-q2-is-q1]
                                                      @quotients-equal |
                                                        q1 = q2
                                                        [by symmetry q2-is-q1]
                                                      @conclusion-unique |
                                                        q1 = q2 and r1 = r2
                                                        [by and_intro quotients-equal remainders-equal]
                                                    }
                                                  @r2-less_than-b-implies |
                                                    less_than(r2, b) -> (q1 = q2 and r1 = r2)
                                                    [by implies_intro given-r2-less_than-b]
                                                }
                                              @r2-nonneg-implies |
                                                is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
                                                [by implies_intro given-r2-nonneg]
                                            }
                                          @second-decomposition-implies |
                                            a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
                                            [by implies_intro given-second-decomposition]
                                        }
                                      @r1-less_than-b-implies |
                                        less_than(r1, b) -> a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
                                        [by implies_intro given-r1-less_than-b]
                                    }
                                  @r1-nonneg-implies |
                                    is_nonneg(r1) -> less_than(r1, b) -> a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
                                    [by implies_intro given-r1-nonneg]
                                }
                              @first-decomposition-implies |
                                a = add(mul(b, q1), r1) -> is_nonneg(r1) -> less_than(r1, b) -> a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
                                [by implies_intro given-first-decomposition]
                            }
                          @b-positive-implies |
                            less_than(ZERO, b) -> a = add(mul(b, q1), r1) -> is_nonneg(r1) -> less_than(r1, b) -> a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
                            [by implies_intro given-b-positive]
                        }
                      @discharge-r2 |
                        forall r2: Int; less_than(ZERO, b) -> a = add(mul(b, q1), r1) -> is_nonneg(r1) -> less_than(r1, b) -> a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
                        [by forall_intro generalize-r2]
                    }
                  @discharge-q2 |
                    forall q2, r2: Int; less_than(ZERO, b) -> a = add(mul(b, q1), r1) -> is_nonneg(r1) -> less_than(r1, b) -> a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
                    [by forall_intro generalize-q2]
                }
              @discharge-r1 |
                forall r1, q2, r2: Int; less_than(ZERO, b) -> a = add(mul(b, q1), r1) -> is_nonneg(r1) -> less_than(r1, b) -> a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
                [by forall_intro generalize-r1]
            }
          @discharge-q1 |
            forall q1, r1, q2, r2: Int; less_than(ZERO, b) -> a = add(mul(b, q1), r1) -> is_nonneg(r1) -> less_than(r1, b) -> a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
            [by forall_intro generalize-q1]
        }
      @discharge-b |
        forall b, q1, r1, q2, r2: Int; less_than(ZERO, b) -> a = add(mul(b, q1), r1) -> is_nonneg(r1) -> less_than(r1, b) -> a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, q1, r1, q2, r2: Int; less_than(ZERO, b) -> a = add(mul(b, q1), r1) -> is_nonneg(r1) -> less_than(r1, b) -> a = add(mul(b, q2), r2) -> is_nonneg(r2) -> less_than(r2, b) -> (q1 = q2 and r1 = r2)
    [by forall_intro generalize-a]
qed

theorem subCommonPrefix: forall p, x, y: Int;
  sub(add(p, x), add(p, y)) = sub(x, y)
proof
  @generalize-p |
    fix p: Int {
      @generalize-x |
        fix x: Int {
          @generalize-y |
            fix y: Int {
              @addition-associates |
                forall u, v, w: Int; add(add(u, v), w) = add(u, add(v, w))
                [by theorem addIsAssociative]
              @cancel-prefix |
                forall c, u, v: Int; add(c, u) = add(c, v) -> u = v
                [by theorem addCancelLeft]
              @prefixed-larger-reaches |
                add(add(p, y), sub(add(p, x), add(p, y))) = add(p, x)
                [by arithmetic]
              @prefixed-difference-associates |
                add(add(p, y), sub(x, y)) = add(p, add(y, sub(x, y)))
                [by forall_elim(p, y, sub(x, y)) addition-associates]
              @inner-difference-reaches |
                add(y, sub(x, y)) = x
                [by arithmetic]
              @prefixed-difference-is-larger |
                add(add(p, y), sub(x, y)) = add(p, x)
                [by rewrite inner-difference-reaches prefixed-difference-associates]
              @two-differences-prefixed-equal |
                add(add(p, y), sub(add(p, x), add(p, y))) = add(add(p, y), sub(x, y))
                [by rewrite prefixed-difference-is-larger prefixed-larger-reaches]
              @cancel-prefixed-difference |
                add(add(p, y), sub(add(p, x), add(p, y))) = add(add(p, y), sub(x, y)) -> sub(add(p, x), add(p, y)) = sub(x, y)
                [by forall_elim(add(p, y), sub(add(p, x), add(p, y)), sub(x, y)) cancel-prefix]
              @conclusion-common-prefix-cancels |
                sub(add(p, x), add(p, y)) = sub(x, y)
                [by modus_ponens cancel-prefixed-difference two-differences-prefixed-equal]
            }
          @discharge-y |
            forall y: Int; sub(add(p, x), add(p, y)) = sub(x, y)
            [by forall_intro generalize-y]
        }
      @discharge-x |
        forall x, y: Int; sub(add(p, x), add(p, y)) = sub(x, y)
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall p, x, y: Int; sub(add(p, x), add(p, y)) = sub(x, y)
    [by forall_intro generalize-p]
qed

theorem atMostGivesNonnegDifference: forall x, y: Int;
  at_most(x, y) -> is_nonneg(sub(y, x))
proof
  @generalize-x |
    fix x: Int {
      @generalize-y |
        fix y: Int {
          @given-x-at-most-y |
            assume at_most(x, y) {
              @x-at-most-y |
                at_most(x, y)
                [by hypothesis given-x-at-most-y]
              @at-most-iff-gap |
                at_most(x, y) iff (exists d: Int; is_nonneg(d) and add(x, d) = y)
                [by specialize lessOrEqualIsGapExistential(x, y)]
              @gap-exists-if-at-most |
                at_most(x, y) -> exists d: Int; is_nonneg(d) and add(x, d) = y
                [by iff_elim_forward at-most-iff-gap]
              @gap-exists |
                exists d: Int; is_nonneg(d) and add(x, d) = y
                [by modus_ponens gap-exists-if-at-most x-at-most-y]
              @with-gap |
                unpack d: Int from gap-exists {
                  @gap-nonneg-and-reaches |
                    is_nonneg(d) and add(x, d) = y
                    [by hypothesis with-gap]
                  @gap-nonneg |
                    is_nonneg(d)
                    [by and_elim_left gap-nonneg-and-reaches]
                  @gap-reaches-y |
                    add(x, d) = y
                    [by and_elim_right gap-nonneg-and-reaches]
                  // sub(y,x) = d: rearrange add(x, d) = y linearly.
                  @difference-is-gap |
                    sub(y, x) = d
                    [by arithmetic gap-reaches-y]
                  @conclusion-difference-nonneg |
                    is_nonneg(sub(y, x))
                    [by rewrite difference-is-gap gap-nonneg]
                }
              @difference-nonneg |
                is_nonneg(sub(y, x))
                [by exists_elim with-gap]
            }
          @at-most-implies-nonneg-difference |
            at_most(x, y) -> is_nonneg(sub(y, x))
            [by implies_intro given-x-at-most-y]
        }
      @discharge-y |
        forall y: Int; at_most(x, y) -> is_nonneg(sub(y, x))
        [by forall_intro generalize-y]
    }
  @conclusion |
    forall x, y: Int; at_most(x, y) -> is_nonneg(sub(y, x))
    [by forall_intro generalize-x]
qed

theorem lessThanSelfPlusPositive: forall x, b: Int;
  less_than(ZERO, b) -> less_than(x, add(x, b))
proof
  @generalize-x |
    fix x: Int {
      @generalize-b |
        fix b: Int {
          @given-b-positive |
            assume less_than(ZERO, b) {
              @b-positive |
                less_than(ZERO, b)
                [by hypothesis given-b-positive]
              @prefixing-x-preserves |
                less_than(ZERO, b) -> less_than(add(x, ZERO), add(x, b))
                [by specialize additionPreservesOrder(ZERO, b, x)]
              @x-plus-zero-less_than-x-plus-b |
                less_than(add(x, ZERO), add(x, b))
                [by modus_ponens prefixing-x-preserves b-positive]
              @x-plus-zero-is-x |
                add(x, ZERO) = x
                [by specialize addZeroRight(x)]
              @conclusion-x-less_than-x-plus-b |
                less_than(x, add(x, b))
                [by rewrite x-plus-zero-is-x x-plus-zero-less_than-x-plus-b]
            }
          @b-positive-implies |
            less_than(ZERO, b) -> less_than(x, add(x, b))
            [by implies_intro given-b-positive]
        }
      @discharge-b |
        forall b: Int; less_than(ZERO, b) -> less_than(x, add(x, b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall x, b: Int; less_than(ZERO, b) -> less_than(x, add(x, b))
    [by forall_intro generalize-x]
qed

theorem remainderSetHasLeast: forall a, b: Int;
  (exists n: Int; is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k))))
  -> exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @given-inhabited |
            assume exists n: Int; is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k))) {
              @some-nonneg-element-is-a-member |
                exists n: Int; is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k)))
                [by hypothesis given-inhabited]
              @given-no-least |
                assume not (exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m))) {
                  @no-least |
                    not (exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m)))
                    [by hypothesis given-no-least]
                  @strong-step |
                    fix n: Int {
                      @given-n-nonneg |
                        assume is_nonneg(n) {
                          @n-nonneg |
                            is_nonneg(n)
                            [by hypothesis given-n-nonneg]
                          @given-all-less_than-fail |
                            assume forall m: Int; is_nonneg(m) -> less_than(m, n) -> (not (exists k: Int; m = sub(a, mul(b, k)))) {
                              @all-less_than-fail |
                                forall m: Int; is_nonneg(m) -> less_than(m, n) -> (not (exists k: Int; m = sub(a, mul(b, k))))
                                [by hypothesis given-all-less_than-fail]
                              @given-n-is-member |
                                assume exists k: Int; n = sub(a, mul(b, k)) {
                                  @n-is-member |
                                    exists k: Int; n = sub(a, mul(b, k))
                                    [by hypothesis given-n-is-member]
                                  @n-is-lower-bound |
                                    fix m: Int {
                                      @given-m-nonneg |
                                        assume is_nonneg(m) {
                                          @m-nonneg |
                                            is_nonneg(m)
                                            [by hypothesis given-m-nonneg]
                                          @given-m-is-member |
                                            assume exists k: Int; m = sub(a, mul(b, k)) {
                                              @m-is-member |
                                                exists k: Int; m = sub(a, mul(b, k))
                                                [by hypothesis given-m-is-member]
                                              @order-n-m |
                                                less_than(n, m) or n = m or less_than(m, n)
                                                [by specialize trichotomy(n, m)]
                                              @n-at-most-m |
                                                at_most(n, m)
                                                case order-n-m {
                                                  @when-n-less_than-m |
                                                    assume less_than(n, m) {
                                                      @n-less_than-m |
                                                        less_than(n, m)
                                                        [by hypothesis when-n-less_than-m]
                                                      @conclusion-n-at-most-m |
                                                        at_most(n, m)
                                                        [by specialize lessThanToLessOrEqual(n, m) n-less_than-m]
                                                    }
                                                  @when-n-equals-m |
                                                    assume n = m {
                                                      @n-equals-m |
                                                        n = m
                                                        [by hypothesis when-n-equals-m]
                                                      @n-at-most-n |
                                                        at_most(n, n)
                                                        [by specialize lessOrEqualRefl(n)]
                                                      @conclusion-n-at-most-m |
                                                        at_most(n, m)
                                                        [by rewrite n-equals-m n-at-most-n]
                                                    }
                                                  @when-m-less_than-n |
                                                    assume less_than(m, n) {
                                                      @m-less_than-n |
                                                        less_than(m, n)
                                                        [by hypothesis when-m-less_than-n]
                                                      @m-fails-if-nonneg-less_than-n |
                                                        is_nonneg(m) -> less_than(m, n) -> (not (exists k: Int; m = sub(a, mul(b, k))))
                                                        [by forall_elim(m) all-less_than-fail]
                                                      @m-is-not-member |
                                                        not (exists k: Int; m = sub(a, mul(b, k)))
                                                        [by tautology m-fails-if-nonneg-less_than-n m-nonneg m-less_than-n]
                                                      @conclusion-n-at-most-m |
                                                        at_most(n, m)
                                                        [by absurd m-is-member m-is-not-member]
                                                    }
                                                }
                                            }
                                          @m-member-implies-bound |
                                            (exists k: Int; m = sub(a, mul(b, k))) -> at_most(n, m)
                                            [by implies_intro given-m-is-member]
                                        }
                                      @m-nonneg-implies-bound |
                                        is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(n, m)
                                        [by implies_intro given-m-nonneg]
                                    }
                                  @n-is-lower-bound-forall |
                                    forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(n, m)
                                    [by forall_intro n-is-lower-bound]
                                  @n-nonneg-and-member |
                                    is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k)))
                                    [by and_intro n-nonneg n-is-member]
                                  @n-is-least |
                                    is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(n, m))
                                    [by and_intro n-nonneg-and-member n-is-lower-bound-forall]
                                  @least-exists |
                                    exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m))
                                    [by exists_intro(n) n-is-least]
                                  @contradiction-from-n |
                                    not (exists k: Int; n = sub(a, mul(b, k)))
                                    [by absurd least-exists no-least]
                                }
                              @n-member-implies-not-member |
                                (exists k: Int; n = sub(a, mul(b, k))) -> (not (exists k: Int; n = sub(a, mul(b, k))))
                                [by implies_intro given-n-is-member]
                              @n-is-not-member |
                                not (exists k: Int; n = sub(a, mul(b, k)))
                                [by tautology n-member-implies-not-member]
                            }
                          @all-less_than-fail-implies-n-fails |
                            (forall m: Int; is_nonneg(m) -> less_than(m, n) -> (not (exists k: Int; m = sub(a, mul(b, k))))) -> (not (exists k: Int; n = sub(a, mul(b, k))))
                            [by implies_intro given-all-less_than-fail]
                        }
                      @strong-step-at-n |
                        is_nonneg(n) -> (forall m: Int; is_nonneg(m) -> less_than(m, n) -> (not (exists k: Int; m = sub(a, mul(b, k))))) -> (not (exists k: Int; n = sub(a, mul(b, k))))
                        [by implies_intro given-n-nonneg]
                    }
                  @strong-step-forall |
                    forall n: Int; is_nonneg(n) -> (forall m: Int; is_nonneg(m) -> less_than(m, n) -> (not (exists k: Int; m = sub(a, mul(b, k))))) -> (not (exists k: Int; n = sub(a, mul(b, k))))
                    [by forall_intro strong-step]
                  @nothing-nonneg-is-member |
                    forall n: Int; is_nonneg(n) -> (not (exists k: Int; n = sub(a, mul(b, k))))
                    [by instantiate nonnegStrongInduction((fun j: Int => not (exists k: Int; j = sub(a, mul(b, k))))) strong-step-forall]
                  @with-witness |
                    unpack w: Int from some-nonneg-element-is-a-member {
                      @witness-nonneg-and-member |
                        is_nonneg(w) and (exists k: Int; w = sub(a, mul(b, k)))
                        [by hypothesis with-witness]
                      @witness-nonneg |
                        is_nonneg(w)
                        [by and_elim_left witness-nonneg-and-member]
                      @witness-is-member |
                        exists k: Int; w = sub(a, mul(b, k))
                        [by and_elim_right witness-nonneg-and-member]
                      @witness-not-member |
                        not (exists k: Int; w = sub(a, mul(b, k)))
                        [by specialize nothing-nonneg-is-member(w) witness-nonneg]
                      @contradiction |
                        exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m))
                        [by absurd witness-is-member witness-not-member]
                    }
                  @least-exists-from-witness |
                    exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m))
                    [by exists_elim with-witness]
                }
              @least-exists-not-absent |
                not not (exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m)))
                [by not_intro given-no-least least-exists-from-witness no-least]
              @least-exists-by-contradiction |
                exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m))
                [by double_negation least-exists-not-absent]
            }
          @inhabited-implies-least |
            (exists n: Int; is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k)))) -> exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m))
            [by implies_intro given-inhabited]
        }
      @discharge-b |
        forall b: Int; (exists n: Int; is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k)))) -> exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; (exists n: Int; is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k)))) -> exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m))
    [by forall_intro generalize-a]
qed

// b·(2a) = a·(2b): reassociate the monomial (mul is commutative/associative).
theorem mulProductSwapThroughTwo: forall a, b: Int; mul(a, mul(TWO, b)) = mul(b, mul(TWO, a))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          // a·(2·b) = a·(b·2) = (a·b)·2
          @two-b-is-b-two |
            mul(TWO, b) = mul(b, TWO)
            [by specialize mulIsCommutative(TWO, b)]
          @left-reflexive |
            mul(a, mul(TWO, b)) = mul(a, mul(TWO, b))
            [by reflexivity]
          @left-inner-swapped |
            mul(a, mul(TWO, b)) = mul(a, mul(b, TWO))
            [by rewrite two-b-is-b-two left-reflexive]
          @a-b-two-reassociated |
            mul(mul(a, b), TWO) = mul(a, mul(b, TWO))
            [by specialize mulIsAssociative(a, b, TWO)]
          @left-is-ab-times-two |
            mul(a, mul(TWO, b)) = mul(mul(a, b), TWO)
            [by rewrite a-b-two-reassociated left-inner-swapped]
          // b·(2·a) = b·(a·2) = (b·a)·2 = (a·b)·2
          @two-a-is-a-two |
            mul(TWO, a) = mul(a, TWO)
            [by specialize mulIsCommutative(TWO, a)]
          @right-reflexive |
            mul(b, mul(TWO, a)) = mul(b, mul(TWO, a))
            [by reflexivity]
          @right-inner-swapped |
            mul(b, mul(TWO, a)) = mul(b, mul(a, TWO))
            [by rewrite two-a-is-a-two right-reflexive]
          @b-a-two-reassociated |
            mul(mul(b, a), TWO) = mul(b, mul(a, TWO))
            [by specialize mulIsAssociative(b, a, TWO)]
          @right-is-ba-times-two |
            mul(b, mul(TWO, a)) = mul(mul(b, a), TWO)
            [by rewrite b-a-two-reassociated right-inner-swapped]
          @b-a-is-a-b |
            mul(b, a) = mul(a, b)
            [by specialize mulIsCommutative(b, a)]
          @right-is-ab-times-two |
            mul(b, mul(TWO, a)) = mul(mul(a, b), TWO)
            [by rewrite b-a-is-a-b right-is-ba-times-two]
          @conclusion-swap |
            mul(a, mul(TWO, b)) = mul(b, mul(TWO, a))
            [by rewrite right-is-ab-times-two left-is-ab-times-two]
        }
      @discharge-b |
        forall b: Int; mul(a, mul(TWO, b)) = mul(b, mul(TWO, a))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; mul(a, mul(TWO, b)) = mul(b, mul(TWO, a))
    [by forall_intro generalize-a]
qed

// 2n = n + n, unfolding TWO = succ(ONE) on the right via commutativity.
theorem twoTimesIsSelfPlusSelf: forall n: Int; mul(TWO, n) = add(n, n)
proof
  @generalize-n |
    fix n: Int {
      @two-n-is-n-two |
        mul(TWO, n) = mul(n, TWO)
        [by specialize mulIsCommutative(TWO, n)]
      // n·2 = n·succ(ONE) = add(n·ONE, n) = add(n, n)
      @n-times-two-unfolds |
        mul(n, TWO) = add(mul(n, ONE), n)
        [by specialize mulSuccRight(n, ONE)]
      @n-times-one-is-n |
        mul(n, ONE) = n
        [by specialize mulOneRight(n)]
      @n-times-two-is-n-plus-n |
        mul(n, TWO) = add(n, n)
        [by rewrite n-times-one-is-n n-times-two-unfolds]
      @conclusion-two-times |
        mul(TWO, n) = add(n, n)
        [by rewrite n-times-two-is-n-plus-n two-n-is-n-two]
    }
  @conclusion |
    forall n: Int; mul(TWO, n) = add(n, n)
    [by forall_intro generalize-n]
qed

// 0 < n implies 1 <= n: the strict gap succ(d) with add(ZERO, succ d) = n
// rewrites to add(ONE, d) = n, a nonneg gap witnessing 1 <= n.
theorem oneAtMostPositive: forall n: Int; less_than(ZERO, n) -> at_most(ONE, n)
proof
  @generalize-n |
    fix n: Int {
      @zero-prefix-identity |
        forall m: Int; add(ZERO, m) = m
        [by axiom addZeroLeft]
      @given-zero-less_than-n |
        assume less_than(ZERO, n) {
          @zero-less_than-n |
            less_than(ZERO, n)
            [by hypothesis given-zero-less_than-n]
          @gap-exists |
            exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = n
            [by specialize lessThanElim(ZERO, n) zero-less_than-n]
          @with-gap-d |
            unpack gap: Int from gap-exists {
              @gap-nonneg-and-witnesses-n |
                is_nonneg(gap) and add(ZERO, succ(gap)) = n
                [by hypothesis with-gap-d]
              @gap-nonneg |
                is_nonneg(gap)
                [by and_elim_left gap-nonneg-and-witnesses-n]
              @gap-witnesses-n |
                add(ZERO, succ(gap)) = n
                [by and_elim_right gap-nonneg-and-witnesses-n]
              // add(ONE, gap) = add(succ ZERO, gap) = succ(add(ZERO,gap)) = succ(gap) = add(ZERO, succ gap) = n.
              @one-plus-gap-is-succ-gap |
                add(ONE, gap) = succ(gap)
                [by simplify oneIsSuccZero addSuccLeft addZeroLeft]
              @zero-prefix-succ-gap |
                add(ZERO, succ(gap)) = succ(gap)
                [by forall_elim(succ(gap)) zero-prefix-identity]
              @succ-gap-is-n |
                succ(gap) = n
                [by rewrite zero-prefix-succ-gap gap-witnesses-n]
              @one-plus-gap-is-n |
                add(ONE, gap) = n
                [by rewrite succ-gap-is-n one-plus-gap-is-succ-gap]
              @gap-witnesses-one-at-most-n |
                is_nonneg(gap) and add(ONE, gap) = n
                [by and_intro gap-nonneg one-plus-gap-is-n]
              @one-less_than-or-equal-n-gap |
                exists d: Int; is_nonneg(d) and add(ONE, d) = n
                [by exists_intro(gap) gap-witnesses-one-at-most-n]
              @one-at-most-n-iff-gap |
                at_most(ONE, n) iff (exists d: Int; is_nonneg(d) and add(ONE, d) = n)
                [by specialize lessOrEqualIsGapExistential(ONE, n)]
              @one-at-most-n-if-gap |
                (exists d: Int; is_nonneg(d) and add(ONE, d) = n) -> at_most(ONE, n)
                [by iff_elim_backward one-at-most-n-iff-gap]
              @conclusion-one-at-most-n |
                at_most(ONE, n)
                [by modus_ponens one-at-most-n-if-gap one-less_than-or-equal-n-gap]
            }
          @one-at-most-n |
            at_most(ONE, n)
            [by exists_elim with-gap-d]
        }
      @zero-less_than-n-implies-one-at-most-n |
        less_than(ZERO, n) -> at_most(ONE, n)
        [by implies_intro given-zero-less_than-n]
    }
  @conclusion |
    forall n: Int; less_than(ZERO, n) -> at_most(ONE, n)
    [by forall_intro generalize-n]
qed

// -(x - y) = y - x.  -(x + (-y)) = (-x) + (-(-y)) = (-x) + y, and y + (-x)
// is the same sum commuted; definitionOfSubtraction turns both differences into these sums.
theorem negOfDifferenceSwaps: forall x, y: Int; neg(sub(x, y)) = sub(y, x)
proof
  @generalize-x |
    fix x: Int {
      @generalize-y |
        fix y: Int {
          // left side: neg(sub(x,y)) = add(neg(x), y)
          @left-unfolds |
            neg(sub(x, y)) = add(neg(x), y)
            [by simplify definitionOfSubtraction negAdd negNeg]
          // right side: sub(y, x) = add(y, neg(x))
          @right-unfolds |
            sub(y, x) = add(y, neg(x))
            [by specialize definitionOfSubtraction(y, x)]
          // the two sums are equal by commutativity.
          @add-commutative |
            forall p, q: Int; add(p, q) = add(q, p)
            [by theorem addIsCommutative]
          @sums-commute |
            add(neg(x), y) = add(y, neg(x))
            [by forall_elim(neg(x), y) add-commutative]
          @neg-difference-is-commuted-sum |
            neg(sub(x, y)) = add(y, neg(x))
            [by rewrite sums-commute left-unfolds]
          @conclusion-swap |
            neg(sub(x, y)) = sub(y, x)
            [by rewrite right-unfolds neg-difference-is-commuted-sum]
        }
      @discharge-y |
        forall y: Int; neg(sub(x, y)) = sub(y, x)
        [by forall_intro generalize-y]
    }
  @conclusion |
    forall x, y: Int; neg(sub(x, y)) = sub(y, x)
    [by forall_intro generalize-x]
qed

theorem divisionAlgorithmExists: forall a, b: Int; less_than(ZERO, b) ->
  exists q: Int; exists r: Int; a = add(mul(b, q), r) and is_nonneg(r) and less_than(r, b)
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @given-b-positive |
            assume less_than(ZERO, b) {
              @b-positive |
                less_than(ZERO, b)
                [by hypothesis given-b-positive]
              @negation-of-zero |
                neg(ZERO) = ZERO
                [by axiom negZero]
              @zero-prefix-is-identity |
                forall n: Int; add(ZERO, n) = n
                [by axiom addZeroLeft]
              // S is nonempty.  Judson splits on the sign of a.  Trichotomy
              // gives a >= 0 (0 < a or a = 0) or a < 0; we produce a member
              // of S in each branch.
              @a-sign |
                less_than(ZERO, a) or ZERO = a or less_than(a, ZERO)
                [by specialize trichotomy(ZERO, a)]
              @set-is-nonempty |
                exists n: Int; is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k)))
                case a-sign {
                  @when-a-nonnegative |
                    assume less_than(ZERO, a) or ZERO = a {
                      @a-nonnegative |
                        less_than(ZERO, a) or ZERO = a
                        [by hypothesis when-a-nonnegative]
                      // a >= 0, so a itself is a nonneg member: a = a - b*0.
                      @a-nonneg |
                        is_nonneg(a)
                        case a-nonnegative {
                          @when-zero-less_than-a |
                            assume less_than(ZERO, a) {
                              @zero-less_than-a |
                                less_than(ZERO, a)
                                [by hypothesis when-zero-less_than-a]
                              // 0 < a means a = succ(d) for nonneg d, hence nonneg.
                              @gap-exists |
                                exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = a
                                [by specialize lessThanElim(ZERO, a) zero-less_than-a]
                              @with-gap-d |
                                unpack gap: Int from gap-exists {
                                  @gap-nonneg-and-witnesses-a |
                                    is_nonneg(gap) and add(ZERO, succ(gap)) = a
                                    [by hypothesis with-gap-d]
                                  @gap-nonneg |
                                    is_nonneg(gap)
                                    [by and_elim_left gap-nonneg-and-witnesses-a]
                                  @gap-witnesses-a |
                                    add(ZERO, succ(gap)) = a
                                    [by and_elim_right gap-nonneg-and-witnesses-a]
                                  @zero-prefix-succ-gap |
                                    add(ZERO, succ(gap)) = succ(gap)
                                    [by forall_elim(succ(gap)) zero-prefix-is-identity]
                                  @successor-gap-is-a |
                                    succ(gap) = a
                                    [by rewrite zero-prefix-succ-gap gap-witnesses-a]
                                  @successor-gap-nonneg-if |
                                    is_nonneg(gap) -> is_nonneg(succ(gap))
                                    [by specialize nonnegSucc(gap)]
                                  @successor-gap-nonneg |
                                    is_nonneg(succ(gap))
                                    [by modus_ponens successor-gap-nonneg-if gap-nonneg]
                                  @conclusion-a-nonneg |
                                    is_nonneg(a)
                                    [by rewrite successor-gap-is-a successor-gap-nonneg]
                                }
                              @conclusion-a-nonneg |
                                is_nonneg(a)
                                [by exists_elim with-gap-d]
                            }
                          @when-a-is-zero |
                            assume ZERO = a {
                              @zero-is-a |
                                ZERO = a
                                [by hypothesis when-a-is-zero]
                              @zero-is-nonneg |
                                is_nonneg(ZERO)
                                [by axiom nonnegZero]
                              @conclusion-a-nonneg |
                                is_nonneg(a)
                                [by rewrite zero-is-a zero-is-nonneg]
                            }
                        }
                      // a = a - b*0, so a is a member; witness k = ZERO.
                      @b-times-zero-is-zero |
                        mul(b, ZERO) = ZERO
                        [by specialize mulZeroRight(b)]
                      @a-minus-product-reflexive |
                        sub(a, mul(b, ZERO)) = sub(a, mul(b, ZERO))
                        [by reflexivity]
                      @a-minus-product-is-a-minus-zero |
                        sub(a, mul(b, ZERO)) = sub(a, ZERO)
                        [by rewrite b-times-zero-is-zero a-minus-product-reflexive]
                      @a-minus-zero-unfolds |
                        sub(a, ZERO) = add(a, neg(ZERO))
                        [by specialize definitionOfSubtraction(a, ZERO)]
                      @a-minus-zero-is-a-plus-zero |
                        sub(a, ZERO) = add(a, ZERO)
                        [by rewrite negation-of-zero a-minus-zero-unfolds]
                      @a-plus-zero-is-a |
                        add(a, ZERO) = a
                        [by specialize addZeroRight(a)]
                      @a-minus-zero-is-a |
                        sub(a, ZERO) = a
                        [by rewrite a-plus-zero-is-a a-minus-zero-is-a-plus-zero]
                      @a-minus-product-is-a |
                        sub(a, mul(b, ZERO)) = a
                        [by rewrite a-minus-zero-is-a a-minus-product-is-a-minus-zero]
                      @a-is-a-minus-product |
                        a = sub(a, mul(b, ZERO))
                        [by symmetry a-minus-product-is-a]
                      @a-is-a-member |
                        exists k: Int; a = sub(a, mul(b, k))
                        [by exists_intro(ZERO) a-is-a-minus-product]
                      @a-nonneg-and-member |
                        is_nonneg(a) and (exists k: Int; a = sub(a, mul(b, k)))
                        [by and_intro a-nonneg a-is-a-member]
                      @conclusion-set-is-nonempty |
                        exists n: Int; is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k)))
                        [by exists_intro(a) a-nonneg-and-member]
                    }
                  @when-a-negative |
                    assume less_than(a, ZERO) {
                      @a-negative |
                        less_than(a, ZERO)
                        [by hypothesis when-a-negative]
                      // Judson's witness k = 2a; the member is a - b(2a).
                      // Ring identity: a - b(2a) = a(1 - 2b) (the only elided algebra).
                      @b-two-a-is-a-two-b |
                        mul(b, mul(TWO, a)) = mul(a, mul(TWO, b))
                        [by specialize mulProductSwapThroughTwo(b, a)]
                      @member-reflexive |
                        sub(a, mul(b, mul(TWO, a))) = sub(a, mul(b, mul(TWO, a)))
                        [by reflexivity]
                      @member-with-a-factored |
                        sub(a, mul(b, mul(TWO, a))) = sub(a, mul(a, mul(TWO, b)))
                        [by rewrite b-two-a-is-a-two-b member-reflexive]
                      @factored-member-expands |
                        sub(a, mul(a, mul(TWO, b))) = mul(a, sub(ONE, mul(TWO, b)))
                        [by simplify definitionOfSubtraction mulAddDistribLeft mulNegRight mulOneRight]
                      @member-is-product |
                        sub(a, mul(b, mul(TWO, a))) = mul(a, sub(ONE, mul(TWO, b)))
                        [by rewrite factored-member-expands member-with-a-factored]
                      // First factor a is nonpositive: -a >= 0 since a < 0.
                      @neg-a-nonneg |
                        is_nonneg(neg(a))
                        [by specialize negLessThanZero(a) a-negative]
                      // Second factor 1 - 2b is nonpositive: 1 < 2b because b > 0.
                      // 1 <= b (b positive) and b < 2b (b positive) give 1 < 2b.
                      @one-at-most-b |
                        at_most(ONE, b)
                        [by specialize oneAtMostPositive(b) b-positive]
                      @two-b-is-b-plus-b |
                        mul(TWO, b) = add(b, b)
                        [by specialize twoTimesIsSelfPlusSelf(b)]
                      @b-less_than-b-plus-b |
                        less_than(b, add(b, b))
                        [by specialize lessThanSelfPlusPositive(b, b) b-positive]
                      @b-less_than-two-b |
                        less_than(b, mul(TWO, b))
                        [by rewrite two-b-is-b-plus-b b-less_than-b-plus-b]
                      @one-less_than-two-b |
                        less_than(ONE, mul(TWO, b))
                        [by specialize atMostThenLessThan(ONE, b, mul(TWO, b)) one-at-most-b b-less_than-two-b]
                      // 1 < 2b makes 2b - 1 = -(1 - 2b) nonneg.
                      @two-b-minus-one-nonneg |
                        is_nonneg(sub(mul(TWO, b), ONE))
                        [by specialize lessThanGivesNonnegDifference(ONE, mul(TWO, b)) one-less_than-two-b]
                      @neg-of-one-minus-two-b-is-two-b-minus-one |
                        neg(sub(ONE, mul(TWO, b))) = sub(mul(TWO, b), ONE)
                        [by specialize negOfDifferenceSwaps(ONE, mul(TWO, b))]
                      @neg-one-minus-two-b-nonneg |
                        is_nonneg(neg(sub(ONE, mul(TWO, b))))
                        [by rewrite neg-of-one-minus-two-b-is-two-b-minus-one two-b-minus-one-nonneg]
                      // product of the two nonpositive factors is nonneg.
                      @nonpositive-factors-give-nonneg-product |
                        forall x, y: Int; is_nonneg(neg(x)) -> is_nonneg(neg(y)) -> is_nonneg(mul(x, y))
                        [by theorem productOfNonpositiveFactorsIsNonneg]
                      @product-nonneg-if |
                        is_nonneg(neg(a)) -> is_nonneg(neg(sub(ONE, mul(TWO, b)))) -> is_nonneg(mul(a, sub(ONE, mul(TWO, b))))
                        [by forall_elim(a, sub(ONE, mul(TWO, b))) nonpositive-factors-give-nonneg-product]
                      @product-nonneg |
                        is_nonneg(mul(a, sub(ONE, mul(TWO, b))))
                        [by tautology product-nonneg-if neg-a-nonneg neg-one-minus-two-b-nonneg]
                      @member-nonneg |
                        is_nonneg(sub(a, mul(b, mul(TWO, a))))
                        [by rewrite member-is-product product-nonneg]
                      // exhibit k = 2a so the member is in S.
                      @member-reflexive-again |
                        sub(a, mul(b, mul(TWO, a))) = sub(a, mul(b, mul(TWO, a)))
                        [by reflexivity]
                      @member-is-a-minus-b-k |
                        exists k: Int; sub(a, mul(b, mul(TWO, a))) = sub(a, mul(b, k))
                        [by exists_intro(mul(TWO, a)) member-reflexive-again]
                      @member-nonneg-and-in-set |
                        is_nonneg(sub(a, mul(b, mul(TWO, a)))) and (exists k: Int; sub(a, mul(b, mul(TWO, a))) = sub(a, mul(b, k)))
                        [by and_intro member-nonneg member-is-a-minus-b-k]
                      @conclusion-set-is-nonempty |
                        exists n: Int; is_nonneg(n) and (exists k: Int; n = sub(a, mul(b, k)))
                        [by exists_intro(sub(a, mul(b, mul(TWO, a)))) member-nonneg-and-in-set]
                    }
                }
              // Well-Ordering (the instance reproved above) delivers a least
              // member r = a - bq.
              @least-member |
                exists least: Int; is_nonneg(least) and (exists k: Int; least = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(least, m))
                [by specialize remainderSetHasLeast(a, b) set-is-nonempty]
              @conclusion-decomposition-exists |
                unpack rem: Int from least-member {
                  @least-properties |
                    is_nonneg(rem) and (exists k: Int; rem = sub(a, mul(b, k))) and (forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(rem, m))
                    [by hypothesis conclusion-decomposition-exists]
                  @remainder-nonneg-and-member |
                    is_nonneg(rem) and (exists k: Int; rem = sub(a, mul(b, k)))
                    [by and_elim_left least-properties]
                  @remainder-is-least |
                    forall m: Int; is_nonneg(m) -> (exists k: Int; m = sub(a, mul(b, k))) -> at_most(rem, m)
                    [by and_elim_right least-properties]
                  @remainder-nonneg |
                    is_nonneg(rem)
                    [by and_elim_left remainder-nonneg-and-member]
                  @remainder-is-member |
                    exists k: Int; rem = sub(a, mul(b, k))
                    [by and_elim_right remainder-nonneg-and-member]
                  @with-quotient-q |
                    unpack quot: Int from remainder-is-member {
                      @remainder-is-a-minus-bq |
                        rem = sub(a, mul(b, quot))
                        [by hypothesis with-quotient-q]
                      // a = bq + rem, since bq + (a - bq) = a.
                      @bq-plus-difference-is-a |
                        add(mul(b, quot), sub(a, mul(b, quot))) = a
                        [by arithmetic]
                      @bq-plus-remainder-is-a |
                        add(mul(b, quot), rem) = a
                        [by rewrite remainder-is-a-minus-bq bq-plus-difference-is-a]
                      @decomposition-holds |
                        a = add(mul(b, quot), rem)
                        [by symmetry bq-plus-remainder-is-a]
                      // rem < b.  Suppose not; derive a smaller member of S.
                      @suppose-not-less_than |
                        assume not less_than(rem, b) {
                          @not-less_than |
                            not less_than(rem, b)
                            [by hypothesis suppose-not-less_than]
                          @rem-b-trichotomy |
                            less_than(rem, b) or rem = b or less_than(b, rem)
                            [by specialize trichotomy(rem, b)]
                          // not less_than(rem,b) leaves rem = b or less_than(b, rem); both give b <= rem.
                          @b-at-most-rem |
                            at_most(b, rem)
                            case rem-b-trichotomy {
                              @when-rem-less_than-b |
                                assume less_than(rem, b) {
                                  @rem-less_than-b |
                                    less_than(rem, b)
                                    [by hypothesis when-rem-less_than-b]
                                  @conclusion-b-at-most-rem |
                                    at_most(b, rem)
                                    [by absurd rem-less_than-b not-less_than]
                                }
                              @when-rem-equals-b |
                                assume rem = b {
                                  @rem-equals-b |
                                    rem = b
                                    [by hypothesis when-rem-equals-b]
                                  @b-at-most-b |
                                    at_most(b, b)
                                    [by specialize lessOrEqualRefl(b)]
                                  @conclusion-b-at-most-rem |
                                    at_most(b, rem)
                                    [by rewrite rem-equals-b b-at-most-b]
                                }
                              @when-b-less_than-rem |
                                assume less_than(b, rem) {
                                  @b-less_than-rem |
                                    less_than(b, rem)
                                    [by hypothesis when-b-less_than-rem]
                                  @conclusion-b-at-most-rem |
                                    at_most(b, rem)
                                    [by specialize lessThanToLessOrEqual(b, rem) b-less_than-rem]
                                }
                            }
                          // candidate = sub(rem, b) = sub(a, mul(b, succ quot)); it is in S.
                          @b-times-successor-quot |
                            mul(b, succ(quot)) = add(mul(b, quot), b)
                            [by specialize mulSuccRight(b, quot)]
                          @a-minus-b-succ-quot-reflexive |
                            sub(a, mul(b, succ(quot))) = sub(a, mul(b, succ(quot)))
                            [by reflexivity]
                          @a-minus-b-succ-quot-expands |
                            sub(a, mul(b, succ(quot))) = sub(a, add(mul(b, quot), b))
                            [by rewrite b-times-successor-quot a-minus-b-succ-quot-reflexive]
                          @a-minus-b-succ-quot-substituted |
                            sub(a, mul(b, succ(quot))) = sub(add(mul(b, quot), rem), add(mul(b, quot), b))
                            [by rewrite decomposition-holds a-minus-b-succ-quot-expands]
                          @common-prefix-cancels |
                            forall p, x, y: Int; sub(add(p, x), add(p, y)) = sub(x, y)
                            [by theorem subCommonPrefix]
                          @cancelled-difference |
                            sub(add(mul(b, quot), rem), add(mul(b, quot), b)) = sub(rem, b)
                            [by forall_elim(mul(b, quot), rem, b) common-prefix-cancels]
                          @candidate-is-rem-minus-b |
                            sub(a, mul(b, succ(quot))) = sub(rem, b)
                            [by rewrite cancelled-difference a-minus-b-succ-quot-substituted]
                          @candidate-witnesses-membership |
                            sub(rem, b) = sub(a, mul(b, succ(quot)))
                            [by symmetry candidate-is-rem-minus-b]
                          @candidate-is-member |
                            exists k: Int; sub(rem, b) = sub(a, mul(b, k))
                            [by exists_intro(succ(quot)) candidate-witnesses-membership]
                          // candidate is nonneg (b <= rem).
                          @candidate-nonneg |
                            is_nonneg(sub(rem, b))
                            [by specialize atMostGivesNonnegDifference(b, rem) b-at-most-rem]
                          // candidate < rem, since b > 0.
                          @candidate-plus-b-is-rem |
                            add(sub(rem, b), b) = rem
                            [by arithmetic]
                          @self-less_than-self-plus-positive |
                            forall x, c: Int; less_than(ZERO, c) -> less_than(x, add(x, c))
                            [by theorem lessThanSelfPlusPositive]
                          @candidate-less_than-candidate-plus-b-if |
                            less_than(ZERO, b) -> less_than(sub(rem, b), add(sub(rem, b), b))
                            [by forall_elim(sub(rem, b), b) self-less_than-self-plus-positive]
                          @candidate-less_than-candidate-plus-b |
                            less_than(sub(rem, b), add(sub(rem, b), b))
                            [by modus_ponens candidate-less_than-candidate-plus-b-if b-positive]
                          @candidate-less_than-rem |
                            less_than(sub(rem, b), rem)
                            [by rewrite candidate-plus-b-is-rem candidate-less_than-candidate-plus-b]
                          // leastness: rem <= candidate.  Contradiction with candidate < rem.
                          @remainder-at-most-candidate-if |
                            is_nonneg(sub(rem, b)) -> (exists k: Int; sub(rem, b) = sub(a, mul(b, k))) -> at_most(rem, sub(rem, b))
                            [by forall_elim(sub(rem, b)) remainder-is-least]
                          @remainder-at-most-candidate |
                            at_most(rem, sub(rem, b))
                            [by tautology remainder-at-most-candidate-if candidate-nonneg candidate-is-member]
                          @at-most-then-less_than |
                            forall x, y, z: Int; at_most(x, y) -> less_than(y, z) -> less_than(x, z)
                            [by theorem atMostThenLessThan]
                          @remainder-less_than-itself-if |
                            at_most(rem, sub(rem, b)) -> less_than(sub(rem, b), rem) -> less_than(rem, rem)
                            [by forall_elim(rem, sub(rem, b), rem) at-most-then-less_than]
                          @remainder-less_than-itself |
                            less_than(rem, rem)
                            [by tautology remainder-less_than-itself-if remainder-at-most-candidate candidate-less_than-rem]
                          @remainder-not-less_than-itself |
                            not less_than(rem, rem)
                            [by specialize lessThanIrreflexive(rem)]
                        }
                      @remainder-less_than-b-not-absent |
                        not not less_than(rem, b)
                        [by not_intro suppose-not-less_than remainder-less_than-itself remainder-not-less_than-itself]
                      @remainder-less_than-b |
                        less_than(rem, b)
                        [by double_negation remainder-less_than-b-not-absent]
                      // package quot, rem into the existential.
                      @decomposition-and-remainder-nonneg |
                        a = add(mul(b, quot), rem) and is_nonneg(rem)
                        [by and_intro decomposition-holds remainder-nonneg]
                      @decomposition-and-bounds |
                        a = add(mul(b, quot), rem) and is_nonneg(rem) and less_than(rem, b)
                        [by and_intro decomposition-and-remainder-nonneg remainder-less_than-b]
                      @remainder-exists |
                        exists r: Int; a = add(mul(b, quot), r) and is_nonneg(r) and less_than(r, b)
                        [by exists_intro(rem) decomposition-and-bounds]
                      @quotient-and-remainder-exist |
                        exists q: Int; exists r: Int; a = add(mul(b, q), r) and is_nonneg(r) and less_than(r, b)
                        [by exists_intro(quot) remainder-exists]
                    }
                  @decomposition-exists-for-remainder |
                    exists q: Int; exists r: Int; a = add(mul(b, q), r) and is_nonneg(r) and less_than(r, b)
                    [by exists_elim with-quotient-q]
                }
              @decomposition-exists |
                exists q: Int; exists r: Int; a = add(mul(b, q), r) and is_nonneg(r) and less_than(r, b)
                [by exists_elim conclusion-decomposition-exists]
            }
          @b-positive-implies-decomposition |
            less_than(ZERO, b) -> exists q: Int; exists r: Int; a = add(mul(b, q), r) and is_nonneg(r) and less_than(r, b)
            [by implies_intro given-b-positive]
        }
      @discharge-b |
        forall b: Int; less_than(ZERO, b) -> exists q: Int; exists r: Int; a = add(mul(b, q), r) and is_nonneg(r) and less_than(r, b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; less_than(ZERO, b) -> exists q: Int; exists r: Int; a = add(mul(b, q), r) and is_nonneg(r) and less_than(r, b)
    [by forall_intro generalize-a]
qed

// -- guarded Euclidean division (native port of the ℕ development) ----------
//
// div(a, b) / mod(a, b) are the quotient and remainder for a POSITIVE divisor
// b > 0: the uninterpreted funcs are pinned by divModProperty (b·q + r = a),
// modBound (r < b) and modNonneg (0 ≤ r) — exactly the data divisionAlgorithm-
// Exists supplies, so the axioms are consistent. (ℕ posits the analogous
// divModProperty/modBound as axioms too; the extra modNonneg is what ℕ gets for
// free from every Nat being ≥ 0.)

func div(a: Int, b: Int): Int requires less_than(ZERO, b)
func mod(a: Int, b: Int): Int requires less_than(ZERO, b)
axiom divModProperty: forall b, a: Int; less_than(ZERO, b) -> add(mul(b, div(a, b)), mod(a, b)) = a
axiom modBound: forall b, a: Int; less_than(ZERO, b) -> less_than(mod(a, b), b)
axiom modNonneg: forall b, a: Int; less_than(ZERO, b) -> is_nonneg(mod(a, b))

// -- moved from the sequence/prime chapter: subtraction + divisor bounds ---

// d | a and d | b give d | (a − b): d | (−b) because −b = mul(b, −1) is a
// multiple of b's divisor d (dividesMul with −1), then dividesAdd on a and −b,
// with sub(a, b) = add(a, neg(b)) (definitionOfSubtraction).
theorem dividesSubtracts: forall d, a, b: Int; divides(d, a) -> divides(d, b) -> divides(d, sub(a, b))
proof
  @generalize-d |
    fix d: Int {
      @generalize-a |
        fix a: Int {
          @generalize-b |
            fix b: Int {
              @given-d-divides-a |
                assume divides(d, a) {
                  @given-d-divides-b |
                    assume divides(d, b) {
                      @d-divides-a |
                        divides(d, a)
                        [by hypothesis given-d-divides-a]
                      @d-divides-b |
                        divides(d, b)
                        [by hypothesis given-d-divides-b]
                      // d | neg(b): neg(b) = mul(b, neg(ONE)) is a multiple of b.
                      @d-divides-b-times-neg-one-fact |
                        divides(d, mul(b, neg(ONE)))
                        [by specialize dividesMul(d, b, neg(ONE)) d-divides-b]
                      @b-times-neg-one-is-neg-b |
                        mul(b, neg(ONE)) = neg(b)
                        [by simplify mulNegRight mulOneRight]
                      @d-divides-neg-b |
                        divides(d, neg(b))
                        [by rewrite b-times-neg-one-is-neg-b d-divides-b-times-neg-one-fact]
                      // d | add(a, neg(b)) = a − b.
                      @d-divides-a-plus-neg-b |
                        divides(d, add(a, neg(b)))
                        [by specialize dividesAdd(d, a, neg(b)) d-divides-a d-divides-neg-b]
                      @a-minus-b-is-a-plus-neg-b |
                        sub(a, b) = add(a, neg(b))
                        [by specialize definitionOfSubtraction(a, b)]
                      @d-divides-a-minus-b |
                        divides(d, sub(a, b))
                        [by rewrite a-minus-b-is-a-plus-neg-b d-divides-a-plus-neg-b]
                    }
                  @d-divides-b-implies-divides-difference |
                    divides(d, b) -> divides(d, sub(a, b))
                    [by implies_intro given-d-divides-b]
                }
              @d-divides-a-implies-rest |
                divides(d, a) -> divides(d, b) -> divides(d, sub(a, b))
                [by implies_intro given-d-divides-a]
            }
          @discharge-b |
            forall b: Int; divides(d, a) -> divides(d, b) -> divides(d, sub(a, b))
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Int; divides(d, a) -> divides(d, b) -> divides(d, sub(a, b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall d, a, b: Int; divides(d, a) -> divides(d, b) -> divides(d, sub(a, b))
    [by forall_intro generalize-d]
qed

// If d | n with d, n positive, then d ≤ n. Write n = d·k. The quotient k is
// positive: k = 0 makes n = 0, and k < 0 makes n = −(d·|k|) negative, both
// against n > 0. With k ≥ 1, the difference k − 1 is nonneg, so the gap
// g = d·(k−1) is nonneg (nonnegMul), and add(d, g) = d·(1 + (k−1)) = d·k = n,
// so exists_intro on the gap g reads d ≤ n.
theorem divisorAtMost: forall d, n: Int; less_than(ZERO, d) -> less_than(ZERO, n) -> divides(d, n) -> at_most(d, n)
proof
  @generalize-d |
    fix d: Int {
      @generalize-n |
        fix n: Int {
          @given-d-positive |
            assume less_than(ZERO, d) {
              @given-n-positive |
                assume less_than(ZERO, n) {
                  @given-d-divides-n |
                    assume divides(d, n) {
                      @d-positive |
                        less_than(ZERO, d)
                        [by hypothesis given-d-positive]
                      @n-positive |
                        less_than(ZERO, n)
                        [by hypothesis given-n-positive]
                      @d-divides-n |
                        divides(d, n)
                        [by hypothesis given-d-divides-n]
                      @with-quotient-k |
                        unpack k: Int from d-divides-n {
                          @n-is-d-times-k |
                            n = mul(d, k)
                            [by hypothesis with-quotient-k]
                          @d-nonneg |
                            is_nonneg(d)
                            [by specialize positiveIsNonneg(d) d-positive]
                          // the quotient k is positive.
                          @k-sign |
                            less_than(ZERO, k) or k = ZERO or less_than(k, ZERO)
                            [by specialize signTrichotomy(k)]
                          @k-positive |
                            less_than(ZERO, k)
                            case k-sign {
                              @when-k-positive |
                                assume less_than(ZERO, k) {
                                  @conclusion-k-positive |
                                    less_than(ZERO, k)
                                    [by hypothesis when-k-positive]
                                }
                              @when-k-zero |
                                assume k = ZERO {
                                  @k-is-zero |
                                    k = ZERO
                                    [by hypothesis when-k-zero]
                                  @d-times-zero-is-zero |
                                    mul(d, ZERO) = ZERO
                                    [by specialize mulZeroRight(d)]
                                  // n = d·k = d·0 = 0
                                  @n-is-zero |
                                    n = ZERO
                                    [by chain n-is-d-times-k k-is-zero d-times-zero-is-zero]
                                  @zero-less_than-zero |
                                    less_than(ZERO, ZERO)
                                    [by rewrite n-is-zero n-positive]
                                  @zero-not-less_than-zero |
                                    not less_than(ZERO, ZERO)
                                    [by specialize lessThanIrreflexive(ZERO)]
                                  @conclusion-k-positive |
                                    less_than(ZERO, k)
                                    [by absurd zero-less_than-zero zero-not-less_than-zero]
                                }
                              @when-k-negative |
                                assume less_than(k, ZERO) {
                                  @k-negative |
                                    less_than(k, ZERO)
                                    [by hypothesis when-k-negative]
                                  // n = d·k = −(d·(−k)), and d·(−k) is nonneg, so n ≤ 0.
                                  @neg-k-nonneg |
                                    is_nonneg(neg(k))
                                    [by specialize negLessThanZero(k) k-negative]
                                  @d-times-neg-k-nonneg |
                                    is_nonneg(mul(d, neg(k)))
                                    [by specialize nonnegMul(d, neg(k)) d-nonneg neg-k-nonneg]
                                  @d-times-neg-k-is-neg-product |
                                    mul(d, neg(k)) = neg(mul(d, k))
                                    [by specialize mulNegRight(d, k)]
                                  // d·(−k) = −(d·k) = −n
                                  @d-times-neg-k-is-neg-n |
                                    mul(d, neg(k)) = neg(n)
                                    [by chain d-times-neg-k-is-neg-product n-is-d-times-k]
                                  @neg-n-nonneg |
                                    is_nonneg(neg(n))
                                    [by rewrite d-times-neg-k-is-neg-n d-times-neg-k-nonneg]
                                  @add-n-neg-n-is-zero |
                                    add(n, neg(n)) = ZERO
                                    [by specialize addNegRight(n)]
                                  @n-plus-neg-n-witnesses |
                                    is_nonneg(neg(n)) and add(n, neg(n)) = ZERO
                                    [by and_intro neg-n-nonneg add-n-neg-n-is-zero]
                                  @n-at-most-zero-iff-gap |
                                    at_most(n, ZERO) iff (exists g: Int; is_nonneg(g) and add(n, g) = ZERO)
                                    [by specialize lessOrEqualIsGapExistential(n, ZERO)]
                                  @gap-gives-n-at-most-zero |
                                    (exists g: Int; is_nonneg(g) and add(n, g) = ZERO) -> at_most(n, ZERO)
                                    [by iff_elim_backward n-at-most-zero-iff-gap]
                                  @n-reaches-zero-gap-exists |
                                    exists g: Int; is_nonneg(g) and add(n, g) = ZERO
                                    [by exists_intro(neg(n)) n-plus-neg-n-witnesses]
                                  @n-at-most-zero |
                                    at_most(n, ZERO)
                                    [by modus_ponens gap-gives-n-at-most-zero n-reaches-zero-gap-exists]
                                  @zero-at-most-n |
                                    at_most(ZERO, n)
                                    [by specialize lessThanToLessOrEqual(ZERO, n) n-positive]
                                  @n-is-zero |
                                    n = ZERO
                                    [by specialize lessOrEqualAntisymmetric(n, ZERO) n-at-most-zero zero-at-most-n]
                                  @zero-less_than-zero |
                                    less_than(ZERO, ZERO)
                                    [by rewrite n-is-zero n-positive]
                                  @zero-not-less_than-zero |
                                    not less_than(ZERO, ZERO)
                                    [by specialize lessThanIrreflexive(ZERO)]
                                  @conclusion-k-positive |
                                    less_than(ZERO, k)
                                    [by absurd zero-less_than-zero zero-not-less_than-zero]
                                }
                            }
                          // k ≥ 1, so k − 1 is nonneg and g = d·(k−1) is the gap.
                          @one-at-most-k |
                            at_most(ONE, k)
                            [by specialize oneAtMostPositive(k) k-positive]
                          @k-minus-one-nonneg |
                            is_nonneg(sub(k, ONE))
                            [by specialize atMostGivesNonnegDifference(ONE, k) one-at-most-k]
                          @gap-nonneg |
                            is_nonneg(mul(d, sub(k, ONE)))
                            [by specialize nonnegMul(d, sub(k, ONE)) d-nonneg k-minus-one-nonneg]
                          // add(d, d·(k−1)) = d·(1 + (k−1)) = d·k = n.
                          @one-plus-k-minus-one-is-k |
                            add(ONE, sub(k, ONE)) = k
                            [by arithmetic]
                          @d-times-one-plus-diff |
                            mul(d, add(ONE, sub(k, ONE))) = add(mul(d, ONE), mul(d, sub(k, ONE)))
                            [by specialize mulAddDistribLeft(d, ONE, sub(k, ONE))]
                          @d-times-one-is-d |
                            mul(d, ONE) = d
                            [by specialize mulOneRight(d)]
                          @d-times-one-plus-diff-collects |
                            mul(d, add(ONE, sub(k, ONE))) = add(d, mul(d, sub(k, ONE)))
                            [by rewrite d-times-one-is-d d-times-one-plus-diff]
                          @d-times-k-splits |
                            mul(d, k) = add(d, mul(d, sub(k, ONE)))
                            [by rewrite one-plus-k-minus-one-is-k d-times-one-plus-diff-collects]
                          @n-splits-into-d-plus-gap |
                            n = add(d, mul(d, sub(k, ONE)))
                            [by rewrite d-times-k-splits n-is-d-times-k]
                          @d-plus-gap-is-n |
                            add(d, mul(d, sub(k, ONE))) = n
                            [by symmetry n-splits-into-d-plus-gap]
                          @gap-witnesses-at-most |
                            is_nonneg(mul(d, sub(k, ONE))) and add(d, mul(d, sub(k, ONE))) = n
                            [by and_intro gap-nonneg d-plus-gap-is-n]
                          @d-at-most-n-iff-gap |
                            at_most(d, n) iff (exists g: Int; is_nonneg(g) and add(d, g) = n)
                            [by specialize lessOrEqualIsGapExistential(d, n)]
                          @gap-gives-d-at-most-n |
                            (exists g: Int; is_nonneg(g) and add(d, g) = n) -> at_most(d, n)
                            [by iff_elim_backward d-at-most-n-iff-gap]
                          @d-reaches-n-gap-exists |
                            exists g: Int; is_nonneg(g) and add(d, g) = n
                            [by exists_intro(mul(d, sub(k, ONE))) gap-witnesses-at-most]
                          @d-at-most-n |
                            at_most(d, n)
                            [by modus_ponens gap-gives-d-at-most-n d-reaches-n-gap-exists]
                        }
                      @d-at-most-n |
                        at_most(d, n)
                        [by exists_elim with-quotient-k]
                    }
                  @d-divides-n-implies-at-most |
                    divides(d, n) -> at_most(d, n)
                    [by implies_intro given-d-divides-n]
                }
              @n-positive-implies-at-most |
                less_than(ZERO, n) -> divides(d, n) -> at_most(d, n)
                [by implies_intro given-n-positive]
            }
          @d-positive-implies-at-most |
            less_than(ZERO, d) -> less_than(ZERO, n) -> divides(d, n) -> at_most(d, n)
            [by implies_intro given-d-positive]
        }
      @discharge-n |
        forall n: Int; less_than(ZERO, d) -> less_than(ZERO, n) -> divides(d, n) -> at_most(d, n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall d, n: Int; less_than(ZERO, d) -> less_than(ZERO, n) -> divides(d, n) -> at_most(d, n)
    [by forall_intro generalize-d]
qed

// -- gcd/Bézout additional vocabulary ---------------------------------------

theorem nonnegCases = order.nonnegCases
theorem mulAddDistribRight = ring.mulAddDistribRight

theorem dividesIntro: forall n, d, k: Int; n = mul(d, k) -> divides(d, n)
proof
  @generalize-n |
    fix n: Int {
      @generalize-d |
        fix d: Int {
          @generalize-k |
            fix k: Int {
              @given-n-is-multiple |
                assume n = mul(d, k) {
                  @n-is-multiple |
                    n = mul(d, k)
                    [by hypothesis given-n-is-multiple]
                  @some-quotient-works |
                    divides(d, n)
                    [by exists_intro(k) n-is-multiple]
                }
              @multiple-implies-divides |
                n = mul(d, k) -> divides(d, n)
                [by implies_intro given-n-is-multiple]
            }
          @discharge-k |
            forall k: Int; n = mul(d, k) -> divides(d, n)
            [by forall_intro generalize-k]
        }
      @discharge-d |
        forall d, k: Int; n = mul(d, k) -> divides(d, n)
        [by forall_intro generalize-d]
    }
  @conclusion |
    forall n, d, k: Int; n = mul(d, k) -> divides(d, n)
    [by forall_intro generalize-n]
qed

// -- absolute value + Euclidean-gcd supporting lemmas -----------------------

// abs(n) = n on the nonneg cone, neg(n) on the negatives. Uninterpreted func
// pinned by the two sign-guarded axioms; always nonneg (absNonneg). Sign-
// normalizes the divisor so the concrete gcd extends past the positive core.
func abs(n: Int): Int
axiom absOfNonneg: forall n: Int; is_nonneg(n) -> abs(n) = n
axiom absOfNegative: forall n: Int; less_than(n, ZERO) -> abs(n) = neg(n)

// abs(n) is nonneg for every n: signTrichotomy splits n; on the positive and
// zero arms abs(n) = n is nonneg, on the negative arm abs(n) = neg(n) is nonneg
// by negLessThanZero.
theorem absNonneg: forall n: Int; is_nonneg(abs(n))
proof
  @generalize-n |
    fix n: Int {
      @sign-cases |
        less_than(ZERO, n) or n = ZERO or less_than(n, ZERO)
        [by specialize signTrichotomy(n)]
      @abs-is-nonneg |
        is_nonneg(abs(n))
        case sign-cases {
          @when-positive |
            assume less_than(ZERO, n) {
              @n-positive |
                less_than(ZERO, n)
                [by hypothesis when-positive]
              @n-nonneg |
                is_nonneg(n)
                [by specialize positiveIsNonneg(n) n-positive]
              @abs-is-n |
                abs(n) = n
                [by specialize absOfNonneg(n) n-nonneg]
              @abs-nonneg-positive |
                is_nonneg(abs(n))
                [by rewrite abs-is-n n-nonneg]
            }
          @when-zero |
            assume n = ZERO {
              @n-is-zero |
                n = ZERO
                [by hypothesis when-zero]
              @zero-nonneg |
                is_nonneg(ZERO)
                [by axiom nonnegZero]
              @n-nonneg |
                is_nonneg(n)
                [by rewrite n-is-zero zero-nonneg]
              @abs-is-n |
                abs(n) = n
                [by specialize absOfNonneg(n) n-nonneg]
              @abs-nonneg-zero |
                is_nonneg(abs(n))
                [by rewrite abs-is-n n-nonneg]
            }
          @when-negative |
            assume less_than(n, ZERO) {
              @n-negative |
                less_than(n, ZERO)
                [by hypothesis when-negative]
              @neg-n-nonneg |
                is_nonneg(neg(n))
                [by specialize negLessThanZero(n) n-negative]
              @abs-is-neg-n |
                abs(n) = neg(n)
                [by specialize absOfNegative(n) n-negative]
              @abs-nonneg-negative |
                is_nonneg(abs(n))
                [by rewrite abs-is-neg-n neg-n-nonneg]
            }
        }
    }
  @conclusion |
    forall n: Int; is_nonneg(abs(n))
    [by forall_intro generalize-n]
qed

// The successor of a nonneg integer is positive: 0 + succ(m) = succ(m) with m
// nonneg witnesses the strict order 0 < succ(m) via lessThanIntro.
theorem succOfNonnegIsPositive: forall m: Int; is_nonneg(m) -> less_than(ZERO, succ(m))
proof
  @generalize-m |
    fix m: Int {
      @given-m-nonneg |
        assume is_nonneg(m) {
          @m-nonneg |
            is_nonneg(m)
            [by hypothesis given-m-nonneg]
          @zero-prefix-is-succ |
            add(ZERO, succ(m)) = succ(m)
            [by specialize integer.addZeroLeft(succ(m))]
          @strict-gap-witnesses-order |
            forall a, d, b: Int; is_nonneg(d) -> add(a, succ(d)) = b -> less_than(a, b)
            [by axiom lessThanIntro]
          @gap-gives-order |
            is_nonneg(m) -> add(ZERO, succ(m)) = succ(m) -> less_than(ZERO, succ(m))
            [by forall_elim(ZERO, m, succ(m)) strict-gap-witnesses-order]
          @zero-less-than-succ |
            less_than(ZERO, succ(m))
            [by tautology gap-gives-order m-nonneg zero-prefix-is-succ]
        }
      @nonneg-implies-succ-positive |
        is_nonneg(m) -> less_than(ZERO, succ(m))
        [by implies_intro given-m-nonneg]
    }
  @conclusion |
    forall m: Int; is_nonneg(m) -> less_than(ZERO, succ(m))
    [by forall_intro generalize-m]
qed

// d | 0 for every d, witnessed by 0: 0 = d·0.
theorem dividesZero: forall d: Int; divides(d, ZERO)
proof
  @generalize-d |
    fix d: Int {
      @d-times-zero-is-zero |
        mul(d, ZERO) = ZERO
        [by specialize mulZeroRight(d)]
      @zero-is-d-times-zero |
        ZERO = mul(d, ZERO)
        [by symmetry d-times-zero-is-zero]
      @d-divides-zero |
        divides(d, ZERO)
        [by specialize dividesIntro(ZERO, d, ZERO) zero-is-d-times-zero]
    }
  @conclusion |
    forall d: Int; divides(d, ZERO)
    [by forall_intro generalize-d]
qed

// d | n iff d | neg(n): neg preserves the multiple structure both ways. Forward,
// a witness n = d·k gives neg(n) = neg(d·k) = d·neg(k) (mulNegRight). Backward,
// from neg(n) = d·j: neg(neg(n)) = d·neg(j), and neg(neg(n)) = n (negNeg).
theorem dividesNeg: forall d, n: Int; divides(d, n) iff divides(d, neg(n))
proof
  @generalize-d |
    fix d: Int {
      @generalize-n |
        fix n: Int {
          @when-divides-n |
            assume divides(d, n) {
              @multiple-exists |
                exists k: Int; n = mul(d, k)
                [by hypothesis when-divides-n]
              @with-quotient-k |
                unpack k: Int from multiple-exists {
                  @n-is-multiple |
                    n = mul(d, k)
                    [by hypothesis with-quotient-k]
                  // neg(n) = neg(d·k) = d·(neg k): mulNegRight commuted, then
                  // rewrite the multiple in for n.
                  @d-times-neg-k |
                    mul(d, neg(k)) = neg(mul(d, k))
                    [by specialize mulNegRight(d, k)]
                  @neg-multiple-is-d-times-neg-k |
                    neg(mul(d, k)) = mul(d, neg(k))
                    [by symmetry d-times-neg-k]
                  @neg-n-is-d-times-neg-k |
                    neg(n) = mul(d, neg(k))
                    [by simplify n-is-multiple neg-multiple-is-d-times-neg-k]
                  @d-divides-neg-n |
                    divides(d, neg(n))
                    [by specialize dividesIntro(neg(n), d, neg(k)) neg-n-is-d-times-neg-k]
                }
              @d-divides-neg-n-discharged |
                divides(d, neg(n))
                [by exists_elim with-quotient-k]
            }
          @divides-n-implies-divides-neg-n |
            divides(d, n) -> divides(d, neg(n))
            [by implies_intro when-divides-n]
          @when-divides-neg-n |
            assume divides(d, neg(n)) {
              @neg-multiple-exists |
                exists j: Int; neg(n) = mul(d, j)
                [by hypothesis when-divides-neg-n]
              @with-quotient-j |
                unpack j: Int from neg-multiple-exists {
                  @neg-n-is-multiple |
                    neg(n) = mul(d, j)
                    [by hypothesis with-quotient-j]
                  @neg-neg-n-is-n |
                    neg(neg(n)) = n
                    [by specialize negNeg(n)]
                  @n-is-neg-neg-n |
                    n = neg(neg(n))
                    [by symmetry neg-neg-n-is-n]
                  // neg(neg n) = neg(d·j) since neg(n) = d·j (congruence under neg).
                  @neg-neg-n-is-neg-multiple |
                    neg(neg(n)) = neg(mul(d, j))
                    [by chain neg-n-is-multiple]
                  @d-times-neg-j |
                    mul(d, neg(j)) = neg(mul(d, j))
                    [by specialize mulNegRight(d, j)]
                  @neg-multiple-is-d-times-neg-j |
                    neg(mul(d, j)) = mul(d, neg(j))
                    [by symmetry d-times-neg-j]
                  // n = neg(neg n) = neg(d·j) = d·(neg j).
                  @n-is-d-times-neg-j |
                    n = mul(d, neg(j))
                    [by chain n-is-neg-neg-n neg-neg-n-is-neg-multiple neg-multiple-is-d-times-neg-j]
                  @d-divides-n |
                    divides(d, n)
                    [by specialize dividesIntro(n, d, neg(j)) n-is-d-times-neg-j]
                }
              @d-divides-n-discharged |
                divides(d, n)
                [by exists_elim with-quotient-j]
            }
          @divides-neg-n-implies-divides-n |
            divides(d, neg(n)) -> divides(d, n)
            [by implies_intro when-divides-neg-n]
          @divides-neg-both-ways |
            divides(d, n) iff divides(d, neg(n))
            [by iff_intro divides-n-implies-divides-neg-n divides-neg-n-implies-divides-n]
        }
      @discharge-n |
        forall n: Int; divides(d, n) iff divides(d, neg(n))
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall d, n: Int; divides(d, n) iff divides(d, neg(n))
    [by forall_intro generalize-d]
qed

// d | n iff d | abs(n): on the nonneg arms abs(n) = n so the biconditional is
// reflexive; on the negative arm abs(n) = neg(n), closed by dividesNeg.
theorem dividesAbs: forall d, n: Int; divides(d, n) iff divides(d, abs(n))
proof
  @generalize-d |
    fix d: Int {
      @generalize-n |
        fix n: Int {
          @sign-cases |
            less_than(ZERO, n) or n = ZERO or less_than(n, ZERO)
            [by specialize signTrichotomy(n)]
          @divides-abs-both-ways |
            divides(d, n) iff divides(d, abs(n))
            case sign-cases {
              @when-positive |
                assume less_than(ZERO, n) {
                  @n-positive |
                    less_than(ZERO, n)
                    [by hypothesis when-positive]
                  @n-nonneg |
                    is_nonneg(n)
                    [by specialize positiveIsNonneg(n) n-positive]
                  @abs-is-n |
                    abs(n) = n
                    [by specialize absOfNonneg(n) n-nonneg]
                  @divides-n-iff-n |
                    divides(d, n) iff divides(d, n)
                    [by tautology]
                  @divides-abs-positive |
                    divides(d, n) iff divides(d, abs(n))
                    [by rewrite abs-is-n divides-n-iff-n]
                }
              @when-zero |
                assume n = ZERO {
                  @n-is-zero |
                    n = ZERO
                    [by hypothesis when-zero]
                  @zero-nonneg |
                    is_nonneg(ZERO)
                    [by axiom nonnegZero]
                  @n-nonneg |
                    is_nonneg(n)
                    [by rewrite n-is-zero zero-nonneg]
                  @abs-is-n |
                    abs(n) = n
                    [by specialize absOfNonneg(n) n-nonneg]
                  @divides-n-iff-n |
                    divides(d, n) iff divides(d, n)
                    [by tautology]
                  @divides-abs-zero |
                    divides(d, n) iff divides(d, abs(n))
                    [by rewrite abs-is-n divides-n-iff-n]
                }
              @when-negative |
                assume less_than(n, ZERO) {
                  @n-negative |
                    less_than(n, ZERO)
                    [by hypothesis when-negative]
                  @abs-is-neg-n |
                    abs(n) = neg(n)
                    [by specialize absOfNegative(n) n-negative]
                  @divides-n-iff-neg-n |
                    divides(d, n) iff divides(d, neg(n))
                    [by specialize dividesNeg(d, n)]
                  @divides-abs-negative |
                    divides(d, n) iff divides(d, abs(n))
                    [by rewrite abs-is-neg-n divides-n-iff-neg-n]
                }
            }
        }
      @discharge-n |
        forall n: Int; divides(d, n) iff divides(d, abs(n))
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall d, n: Int; divides(d, n) iff divides(d, abs(n))
    [by forall_intro generalize-d]
qed

// The only divisors of 1 in ℤ are ±1. Split e by sign (signTrichotomy). e = 0 is
// impossible: divides(0, 1) forces 1 = 0·k = 0, contradicting 0 < 1. On e > 0,
// divisorAtMost gives e ≤ 1 and oneAtMostPositive gives 1 ≤ e, so e = 1 by
// antisymmetry. On e < 0, neg(e) > 0 and divides(neg(e), 1) (rewrite the quotient
// through mul(neg e, neg k) = e·k), so the same antisymmetry gives neg(e) = 1,
// whence e = neg(1) via negNeg.
theorem dividesOneImpliesUnit: forall e: Int; divides(e, ONE) -> (e = ONE or e = neg(ONE))
proof
  @generalize-e |
    fix e: Int {
      @given-e-divides-one |
        assume divides(e, ONE) {
          @e-divides-one |
            divides(e, ONE)
            [by hypothesis given-e-divides-one]
          @one-positive |
            less_than(ZERO, ONE)
            [by theorem zeroLessThanOne]
          @sign-cases |
            less_than(ZERO, e) or e = ZERO or less_than(e, ZERO)
            [by specialize signTrichotomy(e)]
          @e-is-unit |
            e = ONE or e = neg(ONE)
            case sign-cases {
              // e > 0: e ≤ 1 and 1 ≤ e pin e = 1.
              @when-positive |
                assume less_than(ZERO, e) {
                  @e-positive |
                    less_than(ZERO, e)
                    [by hypothesis when-positive]
                  @e-at-most-one |
                    at_most(e, ONE)
                    [by specialize divisorAtMost(e, ONE) e-positive one-positive e-divides-one]
                  @one-at-most-e |
                    at_most(ONE, e)
                    [by specialize oneAtMostPositive(e) e-positive]
                  @e-is-one |
                    e = ONE
                    [by specialize lessOrEqualAntisymmetric(e, ONE) e-at-most-one one-at-most-e]
                  @conclusion-e-is-unit |
                    e = ONE or e = neg(ONE)
                    [by or_intro_left e-is-one]
                }
              // e = 0: divides(0, 1) forces 1 = 0, contradicting 0 < 1.
              @when-zero |
                assume e = ZERO {
                  @e-is-zero |
                    e = ZERO
                    [by hypothesis when-zero]
                  @zero-divides-one |
                    divides(ZERO, ONE)
                    [by rewrite e-is-zero e-divides-one]
                  @with-quotient-k |
                    unpack k: Int from zero-divides-one {
                      @one-is-zero-times-k |
                        ONE = mul(ZERO, k)
                        [by hypothesis with-quotient-k]
                      @zero-times-k-is-zero |
                        mul(ZERO, k) = ZERO
                        [by specialize mulZeroLeft(k)]
                      @conclusion-one-is-zero |
                        ONE = ZERO
                        [by chain one-is-zero-times-k zero-times-k-is-zero]
                    }
                  @one-is-zero |
                    ONE = ZERO
                    [by exists_elim with-quotient-k]
                  @zero-less_than-zero |
                    less_than(ZERO, ZERO)
                    [by rewrite one-is-zero one-positive]
                  @zero-not-less_than-zero |
                    not less_than(ZERO, ZERO)
                    [by specialize lessThanIrreflexive(ZERO)]
                  @conclusion-e-is-unit |
                    e = ONE or e = neg(ONE)
                    [by absurd zero-less_than-zero zero-not-less_than-zero]
                }
              // e < 0: neg(e) > 0 and neg(e) | 1, so neg(e) = 1, whence e = neg(1).
              @when-negative |
                assume less_than(e, ZERO) {
                  @e-negative |
                    less_than(e, ZERO)
                    [by hypothesis when-negative]
                  @neg-e-positive |
                    less_than(ZERO, neg(e))
                    [by specialize negativeNegIsPositive(e) e-negative]
                  // neg(e) | 1: from 1 = e·k, 1 = mul(neg e, neg k) since the two
                  // sign flips cancel.
                  @with-quotient-k |
                    unpack k: Int from e-divides-one {
                      @one-is-e-times-k |
                        ONE = mul(e, k)
                        [by hypothesis with-quotient-k]
                      @neg-e-times-neg-k-is-e-times-k |
                        mul(neg(e), neg(k)) = mul(e, k)
                        [by simplify mulNegLeft mulNegRight negNeg]
                      @e-times-k-is-neg-e-times-neg-k |
                        mul(e, k) = mul(neg(e), neg(k))
                        [by symmetry neg-e-times-neg-k-is-e-times-k]
                      @one-is-neg-e-times-neg-k |
                        ONE = mul(neg(e), neg(k))
                        [by chain one-is-e-times-k e-times-k-is-neg-e-times-neg-k]
                      @conclusion-neg-e-divides-one |
                        divides(neg(e), ONE)
                        [by specialize dividesIntro(ONE, neg(e), neg(k)) one-is-neg-e-times-neg-k]
                    }
                  @neg-e-divides-one |
                    divides(neg(e), ONE)
                    [by exists_elim with-quotient-k]
                  @neg-e-at-most-one |
                    at_most(neg(e), ONE)
                    [by specialize divisorAtMost(neg(e), ONE) neg-e-positive one-positive neg-e-divides-one]
                  @one-at-most-neg-e |
                    at_most(ONE, neg(e))
                    [by specialize oneAtMostPositive(neg(e)) neg-e-positive]
                  @neg-e-is-one |
                    neg(e) = ONE
                    [by specialize lessOrEqualAntisymmetric(neg(e), ONE) neg-e-at-most-one one-at-most-neg-e]
                  @neg-neg-e-is-e |
                    neg(neg(e)) = e
                    [by specialize negNeg(e)]
                  // rewrite neg(e) = 1 into neg(neg(e)) = e to get neg(1) = e.
                  @neg-one-is-e |
                    neg(ONE) = e
                    [by rewrite neg-e-is-one neg-neg-e-is-e]
                  @e-is-neg-one |
                    e = neg(ONE)
                    [by symmetry neg-one-is-e]
                  @conclusion-e-is-unit |
                    e = ONE or e = neg(ONE)
                    [by or_intro_right e-is-neg-one]
                }
            }
        }
      @e-divides-one-implies-unit |
        divides(e, ONE) -> (e = ONE or e = neg(ONE))
        [by implies_intro given-e-divides-one]
    }
  @conclusion |
    forall e: Int; divides(e, ONE) -> (e = ONE or e = neg(ONE))
    [by forall_intro generalize-e]
qed

// -- the gcd bridge: d | b -> (d | a iff d | mod(a, b)) ---------------------
//
// For b > 0 with d | b: writing q = div(a,b), r = mod(a,b), divModProperty gives
// b·q + r = a, so r = a − b·q (linear cancellation) and a = b·q + r. d | b -> d | b·q
// [dividesMul]. Forward: d|a, d|b·q -> d|r [dividesSubtracts on r = a − b·q].
// Backward: d|b·q, d|r -> d|a [dividesAdd on a = b·q + r].
theorem dividesModStep: forall b, d, a: Int; less_than(ZERO, b) -> divides(d, b) ->
  (divides(d, a) iff divides(d, mod(a, b)))
proof
  @generalize-b |
    fix b: Int {
      @generalize-d |
        fix d: Int {
          @generalize-a |
            fix a: Int {
              @given-b-positive |
                assume less_than(ZERO, b) {
                  @given-d-divides-b |
                    assume divides(d, b) {
                      @b-positive |
                        less_than(ZERO, b)
                        [by hypothesis given-b-positive]
                      @d-divides-b |
                        divides(d, b)
                        [by hypothesis given-d-divides-b]
                      @a-decomposes |
                        add(mul(b, div(a, b)), mod(a, b)) = a
                        [by specialize divModProperty(b, a) b-positive]
                      @d-divides-b-times-quotient |
                        divides(d, mul(b, div(a, b)))
                        [by specialize dividesMul(d, b, div(a, b)) d-divides-b]
                      @decomposition-commutes |
                        add(mul(b, div(a, b)), mod(a, b)) = add(mod(a, b), mul(b, div(a, b)))
                        [by specialize addIsCommutative(mul(b, div(a, b)), mod(a, b))]
                      @a-is-decomposition |
                        a = add(mul(b, div(a, b)), mod(a, b))
                        [by symmetry a-decomposes]
                      @a-is-remainder-plus-multiple |
                        a = add(mod(a, b), mul(b, div(a, b)))
                        [by rewrite decomposition-commutes a-is-decomposition]
                      // r = a − b·q: with a = r + b·q, this is add-then-sub
                      // cancellation, sub(add(r, b·q), b·q) = r (r and b·q are
                      // opaque atoms to the linear certifier).
                      @cancel-multiple |
                        sub(add(mod(a, b), mul(b, div(a, b))), mul(b, div(a, b))) = mod(a, b)
                        [by arithmetic]
                      @remainder-is-a-minus-multiple |
                        sub(a, mul(b, div(a, b))) = mod(a, b)
                        [by rewrite a-is-remainder-plus-multiple cancel-multiple]

                      // FORWARD: d|a -> d|r.  d|a, d|b·q -> d|(a − b·q) = d|r.
                      @when-d-divides-a |
                        assume divides(d, a) {
                          @d-divides-a |
                            divides(d, a)
                            [by hypothesis when-d-divides-a]
                          @d-divides-a-minus-multiple |
                            divides(d, sub(a, mul(b, div(a, b))))
                            [by specialize dividesSubtracts(d, a, mul(b, div(a, b))) d-divides-a d-divides-b-times-quotient]
                          @d-divides-remainder |
                            divides(d, mod(a, b))
                            [by rewrite remainder-is-a-minus-multiple d-divides-a-minus-multiple]
                        }
                      @dividing-a-implies-dividing-remainder |
                        divides(d, a) -> divides(d, mod(a, b))
                        [by implies_intro when-d-divides-a]

                      // BACKWARD: d|r -> d|a.  d|b·q, d|r -> d|(b·q + r) = d|a.
                      @when-d-divides-remainder |
                        assume divides(d, mod(a, b)) {
                          @d-divides-remainder |
                            divides(d, mod(a, b))
                            [by hypothesis when-d-divides-remainder]
                          @d-divides-multiple-plus-remainder |
                            divides(d, add(mul(b, div(a, b)), mod(a, b)))
                            [by specialize dividesAdd(d, mul(b, div(a, b)), mod(a, b)) d-divides-b-times-quotient d-divides-remainder]
                          @d-divides-a |
                            divides(d, a)
                            [by rewrite a-decomposes d-divides-multiple-plus-remainder]
                        }
                      @dividing-remainder-implies-dividing-a |
                        divides(d, mod(a, b)) -> divides(d, a)
                        [by implies_intro when-d-divides-remainder]

                      @divisibility-transfers-both-ways |
                        divides(d, a) iff divides(d, mod(a, b))
                        [by iff_intro dividing-a-implies-dividing-remainder dividing-remainder-implies-dividing-a]
                    }
                  @dividing-b-implies-transfer |
                    divides(d, b) -> (divides(d, a) iff divides(d, mod(a, b)))
                    [by implies_intro given-d-divides-b]
                }
              @positive-implies-transfer |
                less_than(ZERO, b) -> divides(d, b) -> (divides(d, a) iff divides(d, mod(a, b)))
                [by implies_intro given-b-positive]
            }
          @discharge-a |
            forall a: Int; less_than(ZERO, b) -> divides(d, b) -> (divides(d, a) iff divides(d, mod(a, b)))
            [by forall_intro generalize-a]
        }
      @discharge-d |
        forall d, a: Int; less_than(ZERO, b) -> divides(d, b) -> (divides(d, a) iff divides(d, mod(a, b)))
        [by forall_intro generalize-d]
    }
  @conclusion |
    forall b, d, a: Int; less_than(ZERO, b) -> divides(d, b) -> (divides(d, a) iff divides(d, mod(a, b)))
    [by forall_intro generalize-b]
qed

// -- remainder uniqueness (modIntro) ----------------------------------------
//
// quotientCannotBeLess: a strictly larger quotient overshoots the remainder
// bound. If q1 < q2, the gap contributes a full extra b to the r1 side, forcing
// r1 ≥ b — contradicting r1 < b. (ℤ port: r2 must be given nonneg, since the
// final contradiction — add(b·k, r2) can't be < 0 — needs add(b·k, r2) ≥ 0,
// which ℕ gets for free but ℤ derives from nonneg(b·k) [b>0, k≥0] and nonneg r2.)
theorem quotientCannotBeLess: forall b, r1, q1, q2, r2: Int;
  less_than(ZERO, b) -> less_than(r1, b) -> is_nonneg(r2) ->
  add(mul(b, q1), r1) = add(mul(b, q2), r2) ->
  (not less_than(q1, q2))
proof
  @generalize-b |
    fix b: Int {
      @generalize-r1 |
        fix r1: Int {
          @generalize-q1 |
            fix q1: Int {
              @generalize-q2 |
                fix q2: Int {
                  @generalize-r2 |
                    fix r2: Int {
                      @given-b-positive |
                        assume less_than(ZERO, b) {
                          @given-r1-below-b |
                            assume less_than(r1, b) {
                              @given-r2-nonneg |
                                assume is_nonneg(r2) {
                                  @given-decompositions-equal |
                                    assume add(mul(b, q1), r1) = add(mul(b, q2), r2) {
                                      @given-q1-below-q2 |
                                        assume less_than(q1, q2) {
                                          @decompositions-equal |
                                            add(mul(b, q1), r1) = add(mul(b, q2), r2)
                                            [by hypothesis given-decompositions-equal]
                                          @q1-below-q2 |
                                            less_than(q1, q2)
                                            [by hypothesis given-q1-below-q2]
                                          @b-positive |
                                            less_than(ZERO, b)
                                            [by hypothesis given-b-positive]
                                          @b-nonneg |
                                            is_nonneg(b)
                                            [by specialize positiveIsNonneg(b) b-positive]
                                          @r1-below-b-restated |
                                            less_than(r1, b)
                                            [by hypothesis given-r1-below-b]
                                          @r2-nonneg |
                                            is_nonneg(r2)
                                            [by hypothesis given-r2-nonneg]
                                          // q1 < q2 -> exists k: nonneg(k) and add(q1, succ(k)) = q2
                                          @gap-exists |
                                            exists w: Int; is_nonneg(w) and add(q1, succ(w)) = q2
                                            [by specialize lessThanElim(q1, q2) q1-below-q2]
                                          @with-gap-k |
                                            unpack k: Int from gap-exists {
                                              @gap-facts |
                                                is_nonneg(k) and add(q1, succ(k)) = q2
                                                [by hypothesis with-gap-k]
                                              @k-nonneg |
                                                is_nonneg(k)
                                                [by and_elim_left gap-facts]
                                              @q2-is-q1-plus-successor-gap |
                                                add(q1, succ(k)) = q2
                                                [by and_elim_right gap-facts]
                                              @q2-as-gap-sum |
                                                q2 = add(q1, succ(k))
                                                [by symmetry q2-is-q1-plus-successor-gap]
                                              // expand mul(b, q2) over the gap: distribute, then mulSuccRight.
                                              @b-times-q2-includes-a-full-b |
                                                mul(b, q2) = add(mul(b, q1), add(mul(b, k), b))
                                                [by simplify q2-as-gap-sum mulAddDistribLeft mulSuccRight]
                                              // b·q1 + r1 = b·q2 + r2 = (b·q1 + (b·k + b)) + r2.
                                              // Reassociate to pull out the common b·q1 prefix, then
                                              // cancel it: r1 = (b·k + b) + r2.
                                              @rhs-with-full-b |
                                                add(mul(b, q2), r2) = add(add(mul(b, q1), add(mul(b, k), b)), r2)
                                                [by rewrite b-times-q2-includes-a-full-b decompositions-equal-refl]
                                              @decompositions-equal-refl |
                                                add(mul(b, q2), r2) = add(mul(b, q2), r2)
                                                [by reflexivity]
                                              @rhs-reassociates |
                                                add(add(mul(b, q1), add(mul(b, k), b)), r2) = add(mul(b, q1), add(add(mul(b, k), b), r2))
                                                [by specialize addIsAssociative(mul(b, q1), add(mul(b, k), b), r2)]
                                              @common-prefix |
                                                add(mul(b, q1), r1) = add(mul(b, q1), add(add(mul(b, k), b), r2))
                                                [by chain decompositions-equal rhs-with-full-b rhs-reassociates]
                                              @cancel-prefix |
                                                add(mul(b, q1), r1) = add(mul(b, q1), add(add(mul(b, k), b), r2)) -> r1 = add(add(mul(b, k), b), r2)
                                                [by specialize addCancelLeft(mul(b, q1), r1, add(add(mul(b, k), b), r2))]
                                              @r1-equals-gap-plus-r2 |
                                                r1 = add(add(mul(b, k), b), r2)
                                                [by modus_ponens cancel-prefix common-prefix]
                                              // rearrange (b·k + b) + r2 to b + (b·k + r2):
                                              // (b·k + b) = (b + b·k) [comm], reassociate with r2.
                                              @gap-base-commutes |
                                                add(mul(b, k), b) = add(b, mul(b, k))
                                                [by specialize addIsCommutative(mul(b, k), b)]
                                              @gap-base-reassociates |
                                                add(add(b, mul(b, k)), r2) = add(b, add(mul(b, k), r2))
                                                [by specialize addIsAssociative(b, mul(b, k), r2)]
                                              @r1-is-b-plus-remainder |
                                                r1 = add(b, add(mul(b, k), r2))
                                                [by chain r1-equals-gap-plus-r2 gap-base-commutes gap-base-reassociates]
                                              // less_than(r1, b) with r1 = b + Y: rewrite b as b + 0
                                              // on the right, then cancel the b, giving Y < 0.
                                              @b-plus-remainder-below-b |
                                                less_than(add(b, add(mul(b, k), r2)), b)
                                                [by rewrite r1-is-b-plus-remainder r1-below-b-restated]
                                              @b-equals-b-plus-zero |
                                                add(b, ZERO) = b
                                                [by specialize addZeroRight(b)]
                                              @b-plus-remainder-below-b-plus-zero |
                                                less_than(add(b, add(mul(b, k), r2)), add(b, ZERO))
                                                [by rewrite b-equals-b-plus-zero b-plus-remainder-below-b]
                                              @remainder-below-zero |
                                                less_than(add(mul(b, k), r2), ZERO)
                                                [by specialize lessThanAddCancelLeft(b, add(mul(b, k), r2), ZERO) b-plus-remainder-below-b-plus-zero]
                                              // but b·k + r2 ≥ 0: b>0 and k≥0 give b·k≥0, plus r2≥0.
                                              @b-times-k-nonneg |
                                                is_nonneg(mul(b, k))
                                                [by specialize productOfNonnegativesIsNonneg(b, k) b-nonneg k-nonneg]
                                              @remainder-nonneg |
                                                is_nonneg(add(mul(b, k), r2))
                                                [by specialize nonnegAdd(mul(b, k), r2) b-times-k-nonneg r2-nonneg]
                                              @remainder-not-below-zero |
                                                not less_than(add(mul(b, k), r2), ZERO)
                                                [by specialize nonnegNotLessThanZero(add(mul(b, k), r2)) remainder-nonneg]
                                              @contradiction |
                                                not less_than(q1, q2)
                                                [by absurd remainder-below-zero remainder-not-below-zero]
                                            }
                                          @not-below-discharged |
                                            not less_than(q1, q2)
                                            [by exists_elim with-gap-k]
                                          @q1-below-q2-restated |
                                            less_than(q1, q2)
                                            [by hypothesis given-q1-below-q2]
                                        }
                                      @q1-not-below-q2 |
                                        not less_than(q1, q2)
                                        [by not_intro given-q1-below-q2 q1-below-q2-restated not-below-discharged]
                                    }
                                  @equal-forces-not-below |
                                    add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                                    [by implies_intro given-decompositions-equal]
                                }
                              @r2-nonneg-forces-not-below |
                                is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                                [by implies_intro given-r2-nonneg]
                            }
                          @r1-below-forces-not-below |
                            less_than(r1, b) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                            [by implies_intro given-r1-below-b]
                        }
                      @positive-forces-not-below |
                        less_than(ZERO, b) -> less_than(r1, b) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                        [by implies_intro given-b-positive]
                    }
                  @discharge-r2 |
                    forall r2: Int; less_than(ZERO, b) -> less_than(r1, b) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                    [by forall_intro generalize-r2]
                }
              @discharge-q2 |
                forall q2, r2: Int; less_than(ZERO, b) -> less_than(r1, b) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                [by forall_intro generalize-q2]
            }
          @discharge-q1 |
            forall q1, q2, r2: Int; less_than(ZERO, b) -> less_than(r1, b) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
            [by forall_intro generalize-q1]
        }
      @discharge-r1 |
        forall r1, q1, q2, r2: Int; less_than(ZERO, b) -> less_than(r1, b) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
        [by forall_intro generalize-r1]
    }
  @conclusion |
    forall b, r1, q1, q2, r2: Int; less_than(ZERO, b) -> less_than(r1, b) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
    [by forall_intro generalize-b]
qed

// With both r1, r2 in [0, b) neither quotient can be strictly less than the
// other, so the quotients are equal. (ℤ: both remainders must be given nonneg,
// since quotientCannotBeLess is applied with roles swapped.)
theorem quotientUnique: forall b, r1, r2, q1, q2: Int;
  less_than(ZERO, b) -> less_than(r1, b) -> less_than(r2, b) ->
  is_nonneg(r1) -> is_nonneg(r2) ->
  add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
proof
  @generalize-b |
    fix b: Int {
      @generalize-r1 |
        fix r1: Int {
          @generalize-r2 |
            fix r2: Int {
              @generalize-q1 |
                fix q1: Int {
                  @generalize-q2 |
                    fix q2: Int {
                      @given-b-positive |
                        assume less_than(ZERO, b) {
                          @given-r1-below-b |
                            assume less_than(r1, b) {
                              @given-r2-below-b |
                                assume less_than(r2, b) {
                                  @given-r1-nonneg |
                                    assume is_nonneg(r1) {
                                      @given-r2-nonneg |
                                        assume is_nonneg(r2) {
                                          @given-decompositions-equal |
                                            assume add(mul(b, q1), r1) = add(mul(b, q2), r2) {
                                              @b-positive |
                                                less_than(ZERO, b)
                                                [by hypothesis given-b-positive]
                                              @r1-below-b |
                                                less_than(r1, b)
                                                [by hypothesis given-r1-below-b]
                                              @r2-below-b |
                                                less_than(r2, b)
                                                [by hypothesis given-r2-below-b]
                                              @r1-nonneg |
                                                is_nonneg(r1)
                                                [by hypothesis given-r1-nonneg]
                                              @r2-nonneg |
                                                is_nonneg(r2)
                                                [by hypothesis given-r2-nonneg]
                                              @decompositions-equal |
                                                add(mul(b, q1), r1) = add(mul(b, q2), r2)
                                                [by hypothesis given-decompositions-equal]
                                              // neither quotient can be strictly below the other.
                                              @q1-not-below-q2 |
                                                not less_than(q1, q2)
                                                [by specialize quotientCannotBeLess(b, r1, q1, q2, r2) b-positive r1-below-b r2-nonneg decompositions-equal]
                                              @decompositions-equal-flipped |
                                                add(mul(b, q2), r2) = add(mul(b, q1), r1)
                                                [by symmetry decompositions-equal]
                                              @q2-not-below-q1 |
                                                not less_than(q2, q1)
                                                [by specialize quotientCannotBeLess(b, r2, q2, q1, r1) b-positive r2-below-b r1-nonneg decompositions-equal-flipped]
                                              @q1-q2-trichotomy |
                                                less_than(q1, q2) or q1 = q2 or less_than(q2, q1)
                                                [by specialize trichotomy(q1, q2)]
                                              @quotients-are-equal |
                                                q1 = q2
                                                case q1-q2-trichotomy {
                                                  @when-q1-below-q2 |
                                                    assume less_than(q1, q2) {
                                                      @q1-below-q2 |
                                                        less_than(q1, q2)
                                                        [by hypothesis when-q1-below-q2]
                                                      @equal-by-contradiction |
                                                        q1 = q2
                                                        [by absurd q1-below-q2 q1-not-below-q2]
                                                    }
                                                  @when-quotients-equal |
                                                    assume q1 = q2 {
                                                      @equal-directly |
                                                        q1 = q2
                                                        [by hypothesis when-quotients-equal]
                                                    }
                                                  @when-q2-below-q1 |
                                                    assume less_than(q2, q1) {
                                                      @q2-below-q1 |
                                                        less_than(q2, q1)
                                                        [by hypothesis when-q2-below-q1]
                                                      @equal-by-reverse-contradiction |
                                                        q1 = q2
                                                        [by absurd q2-below-q1 q2-not-below-q1]
                                                    }
                                                }
                                            }
                                          @equal-forces-equal-quotients |
                                            add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                                            [by implies_intro given-decompositions-equal]
                                        }
                                      @r2-nonneg-forces |
                                        is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                                        [by implies_intro given-r2-nonneg]
                                    }
                                  @r1-nonneg-forces |
                                    is_nonneg(r1) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                                    [by implies_intro given-r1-nonneg]
                                }
                              @r2-below-forces |
                                less_than(r2, b) -> is_nonneg(r1) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                                [by implies_intro given-r2-below-b]
                            }
                          @r1-below-forces |
                            less_than(r1, b) -> less_than(r2, b) -> is_nonneg(r1) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                            [by implies_intro given-r1-below-b]
                        }
                      @positive-forces |
                        less_than(ZERO, b) -> less_than(r1, b) -> less_than(r2, b) -> is_nonneg(r1) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                        [by implies_intro given-b-positive]
                    }
                  @discharge-q2 |
                    forall q2: Int; less_than(ZERO, b) -> less_than(r1, b) -> less_than(r2, b) -> is_nonneg(r1) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                    [by forall_intro generalize-q2]
                }
              @discharge-q1 |
                forall q1, q2: Int; less_than(ZERO, b) -> less_than(r1, b) -> less_than(r2, b) -> is_nonneg(r1) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                [by forall_intro generalize-q1]
            }
          @discharge-r2 |
            forall r2, q1, q2: Int; less_than(ZERO, b) -> less_than(r1, b) -> less_than(r2, b) -> is_nonneg(r1) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
            [by forall_intro generalize-r2]
        }
      @discharge-r1 |
        forall r1, r2, q1, q2: Int; less_than(ZERO, b) -> less_than(r1, b) -> less_than(r2, b) -> is_nonneg(r1) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
        [by forall_intro generalize-r1]
    }
  @conclusion |
    forall b, r1, r2, q1, q2: Int; less_than(ZERO, b) -> less_than(r1, b) -> less_than(r2, b) -> is_nonneg(r1) -> is_nonneg(r2) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
    [by forall_intro generalize-b]
qed

// modIntro / remainder uniqueness: if you exhibit q, r with 0 ≤ r < b and
// b·q + r = a, then mod(a, b) = r (and div = q en route).
theorem modIntro: forall b, r, q, a: Int;
  less_than(ZERO, b) -> less_than(r, b) -> is_nonneg(r) ->
  add(mul(b, q), r) = a -> mod(a, b) = r
proof
  @generalize-b |
    fix b: Int {
      @generalize-r |
        fix r: Int {
          @generalize-q |
            fix q: Int {
              @generalize-a |
                fix a: Int {
                  @given-b-positive |
                    assume less_than(ZERO, b) {
                      @given-r-below-b |
                        assume less_than(r, b) {
                          @given-r-nonneg |
                            assume is_nonneg(r) {
                              @given-decomposition-equals-a |
                                assume add(mul(b, q), r) = a {
                                  @b-positive |
                                    less_than(ZERO, b)
                                    [by hypothesis given-b-positive]
                                  @r-below-b |
                                    less_than(r, b)
                                    [by hypothesis given-r-below-b]
                                  @r-nonneg |
                                    is_nonneg(r)
                                    [by hypothesis given-r-nonneg]
                                  @decomposition-equals-a |
                                    add(mul(b, q), r) = a
                                    [by hypothesis given-decomposition-equals-a]
                                  // the canonical decomposition: b·div(a,b) + mod(a,b) = a
                                  @a-canonically-decomposes |
                                    add(mul(b, div(a, b)), mod(a, b)) = a
                                    [by specialize divModProperty(b, a) b-positive]
                                  @canonical-remainder-below-b |
                                    less_than(mod(a, b), b)
                                    [by specialize modBound(b, a) b-positive]
                                  @canonical-remainder-nonneg |
                                    is_nonneg(mod(a, b))
                                    [by specialize modNonneg(b, a) b-positive]
                                  // equate the two decompositions.
                                  @decompositions-agree |
                                    add(mul(b, q), r) = add(mul(b, div(a, b)), mod(a, b))
                                    [by chain decomposition-equals-a a-canonically-decomposes]
                                  // quotientUnique gives q = div(a, b).
                                  @quotient-equals-canonical |
                                    q = div(a, b)
                                    [by specialize quotientUnique(b, r, mod(a, b), q, div(a, b)) b-positive r-below-b canonical-remainder-below-b r-nonneg canonical-remainder-nonneg decompositions-agree]
                                  // b·q + r = b·q + mod, cancel to r = mod.
                                  @decompositions-share-multiple |
                                    add(mul(b, q), r) = add(mul(b, q), mod(a, b))
                                    [by chain decompositions-agree quotient-equals-canonical]
                                  @cancel-multiple |
                                    add(mul(b, q), r) = add(mul(b, q), mod(a, b)) -> r = mod(a, b)
                                    [by specialize addCancelLeft(mul(b, q), r, mod(a, b))]
                                  @r-equals-remainder |
                                    r = mod(a, b)
                                    [by modus_ponens cancel-multiple decompositions-share-multiple]
                                  @remainder-equals-r |
                                    mod(a, b) = r
                                    [by symmetry r-equals-remainder]
                                }
                              @decomposition-determines-remainder |
                                add(mul(b, q), r) = a -> mod(a, b) = r
                                [by implies_intro given-decomposition-equals-a]
                            }
                          @nonneg-remainder-determines |
                            is_nonneg(r) -> add(mul(b, q), r) = a -> mod(a, b) = r
                            [by implies_intro given-r-nonneg]
                        }
                      @bounded-remainder-determines |
                        less_than(r, b) -> is_nonneg(r) -> add(mul(b, q), r) = a -> mod(a, b) = r
                        [by implies_intro given-r-below-b]
                    }
                  @positive-determines |
                    less_than(ZERO, b) -> less_than(r, b) -> is_nonneg(r) -> add(mul(b, q), r) = a -> mod(a, b) = r
                    [by implies_intro given-b-positive]
                }
              @discharge-a |
                forall a: Int; less_than(ZERO, b) -> less_than(r, b) -> is_nonneg(r) -> add(mul(b, q), r) = a -> mod(a, b) = r
                [by forall_intro generalize-a]
            }
          @discharge-q |
            forall q, a: Int; less_than(ZERO, b) -> less_than(r, b) -> is_nonneg(r) -> add(mul(b, q), r) = a -> mod(a, b) = r
            [by forall_intro generalize-q]
        }
      @discharge-r |
        forall r, q, a: Int; less_than(ZERO, b) -> less_than(r, b) -> is_nonneg(r) -> add(mul(b, q), r) = a -> mod(a, b) = r
        [by forall_intro generalize-r]
    }
  @conclusion |
    forall b, r, q, a: Int; less_than(ZERO, b) -> less_than(r, b) -> is_nonneg(r) -> add(mul(b, q), r) = a -> mod(a, b) = r
    [by forall_intro generalize-b]
qed

// -- the Euclidean algorithm (concrete gcd) ---------------------------------
//
// gcd(a, b) by the Euclidean recursion: gcd(a, 0) = a; gcd(a, b) = gcd(b, a mod b)
// for b > 0. gcdAbs sign-normalizes the second argument so the recursion (which
// only fires for b > 0) extends to all integers. Correctness is the pair
// gcdDividesBoth (gcd is a common divisor) + gcdGreatest (every common divisor
// divides it); both proved for nonneg b by strong induction on the DECREASING
// modulus, then lifted to all b via abs.
func gcd(a: Int, b: Int): Int
axiom gcdZero: forall a: Int; gcd(a, ZERO) = a
axiom gcdStep: forall b, a: Int; less_than(ZERO, b) -> gcd(a, b) = gcd(b, mod(a, b))
axiom gcdAbs: forall b, a: Int; gcd(a, b) = gcd(a, abs(b))

// gcd(a, b) divides both a and b, for nonneg b. Strong induction on b via
// nonnegStrongInduction: base b = 0 uses gcdZero + dividesRefl/dividesZero; the
// b = succ(m) arm recurses gcd(a, b) = gcd(b, mod(a,b)) [gcdStep], the modulus
// is nonneg and below b [modBound/modNonneg] so the IH applies, and dividesModStep
// carries divisibility of the modulus back to a.
theorem gcdDividesBothNonneg: forall a, b: Int; is_nonneg(b) ->
  (divides(gcd(a, b), a) and divides(gcd(a, b), b))
proof
  @induction-step |
    fix b: Int {
      @given-b-nonneg |
        assume is_nonneg(b) {
          @given-strong-inductive-hypothesis |
            assume forall m: Int; is_nonneg(m) -> less_than(m, b) -> (forall a: Int; divides(gcd(a, m), a) and divides(gcd(a, m), m)) {
              @strong-inductive-hypothesis |
                forall m: Int; is_nonneg(m) -> less_than(m, b) -> (forall a: Int; divides(gcd(a, m), a) and divides(gcd(a, m), m))
                [by hypothesis given-strong-inductive-hypothesis]
              @b-nonneg |
                is_nonneg(b)
                [by hypothesis given-b-nonneg]
              @generalize-a |
                fix a: Int {
                  @b-is-zero-or-successor |
                    b = ZERO or (exists mm: Int; is_nonneg(mm) and b = succ(mm))
                    [by specialize nonnegCases(b) b-nonneg]
                  @when-b-is-zero |
                    assume b = ZERO {
                      @b-is-zero |
                        b = ZERO
                        [by hypothesis when-b-is-zero]
                      @gcd-with-zero-is-itself |
                        gcd(a, ZERO) = a
                        [by specialize gcdZero(a)]
                      @a-divides-a |
                        divides(a, a)
                        [by specialize dividesRefl(a)]
                      @gcd-divides-a |
                        divides(gcd(a, ZERO), a)
                        [by rewrite gcd-with-zero-is-itself a-divides-a]
                      @gcd-divides-zero |
                        divides(gcd(a, ZERO), ZERO)
                        [by specialize dividesZero(gcd(a, ZERO))]
                      @gcd-divides-a-at-b |
                        divides(gcd(a, b), a)
                        [by rewrite b-is-zero gcd-divides-a]
                      @gcd-divides-b |
                        divides(gcd(a, b), b)
                        [by rewrite b-is-zero gcd-divides-zero]
                      @gcd-divides-both-when-zero |
                        divides(gcd(a, b), a) and divides(gcd(a, b), b)
                        [by and_intro gcd-divides-a-at-b gcd-divides-b]
                    }
                  @when-b-is-successor |
                    assume exists mm: Int; is_nonneg(mm) and b = succ(mm) {
                      @predecessor-exists |
                        exists mm: Int; is_nonneg(mm) and b = succ(mm)
                        [by hypothesis when-b-is-successor]
                      @with-predecessor-bp |
                        unpack bp: Int from predecessor-exists {
                          @predecessor-facts |
                            is_nonneg(bp) and b = succ(bp)
                            [by hypothesis with-predecessor-bp]
                          @bp-nonneg |
                            is_nonneg(bp)
                            [by and_elim_left predecessor-facts]
                          @b-is-successor-of-bp |
                            b = succ(bp)
                            [by and_elim_right predecessor-facts]
                          @successor-bp-positive |
                            less_than(ZERO, succ(bp))
                            [by specialize succOfNonnegIsPositive(bp) bp-nonneg]
                          @b-is-positive |
                            less_than(ZERO, b)
                            [by rewrite b-is-successor-of-bp successor-bp-positive]
                          @gcd-recurses |
                            gcd(a, b) = gcd(b, mod(a, b))
                            [by specialize gcdStep(b, a) b-is-positive]
                          @mod-is-below-b |
                            less_than(mod(a, b), b)
                            [by specialize modBound(b, a) b-is-positive]
                          @mod-is-nonneg |
                            is_nonneg(mod(a, b))
                            [by specialize modNonneg(b, a) b-is-positive]
                          @inductive-hypothesis-at-mod |
                            is_nonneg(mod(a, b)) -> less_than(mod(a, b), b) -> (forall aa: Int; divides(gcd(aa, mod(a, b)), aa) and divides(gcd(aa, mod(a, b)), mod(a, b)))
                            [by forall_elim(mod(a, b)) strong-inductive-hypothesis]
                          @gcd-divides-both-at-mod |
                            forall aa: Int; divides(gcd(aa, mod(a, b)), aa) and divides(gcd(aa, mod(a, b)), mod(a, b))
                            [by tautology inductive-hypothesis-at-mod mod-is-nonneg mod-is-below-b]
                          @gcd-b-mod-divides-both |
                            divides(gcd(b, mod(a, b)), b) and divides(gcd(b, mod(a, b)), mod(a, b))
                            [by forall_elim(b) gcd-divides-both-at-mod]
                          @gcd-b-mod-divides-b |
                            divides(gcd(b, mod(a, b)), b)
                            [by and_elim_left gcd-b-mod-divides-both]
                          @gcd-b-mod-divides-mod |
                            divides(gcd(b, mod(a, b)), mod(a, b))
                            [by and_elim_right gcd-b-mod-divides-both]
                          @gcd-divides-b |
                            divides(gcd(a, b), b)
                            [by rewrite gcd-recurses gcd-b-mod-divides-b]
                          @gcd-divides-mod |
                            divides(gcd(a, b), mod(a, b))
                            [by rewrite gcd-recurses gcd-b-mod-divides-mod]
                          @mod-crossing-holds-if-divides-b |
                            divides(gcd(a, b), b) -> (divides(gcd(a, b), a) iff divides(gcd(a, b), mod(a, b)))
                            [by specialize dividesModStep(b, gcd(a, b), a) b-is-positive]
                          @mod-crossing-holds |
                            divides(gcd(a, b), a) iff divides(gcd(a, b), mod(a, b))
                            [by modus_ponens mod-crossing-holds-if-divides-b gcd-divides-b]
                          @divides-mod-implies-divides-a |
                            divides(gcd(a, b), mod(a, b)) -> divides(gcd(a, b), a)
                            [by iff_elim_backward mod-crossing-holds]
                          @gcd-divides-a |
                            divides(gcd(a, b), a)
                            [by modus_ponens divides-mod-implies-divides-a gcd-divides-mod]
                          @gcd-divides-both-when-successor |
                            divides(gcd(a, b), a) and divides(gcd(a, b), b)
                            [by and_intro gcd-divides-a gcd-divides-b]
                        }
                      @gcd-divides-both-in-successor-case |
                        divides(gcd(a, b), a) and divides(gcd(a, b), b)
                        [by exists_elim with-predecessor-bp]
                    }
                  @gcd-divides-both-at-a-and-b |
                    divides(gcd(a, b), a) and divides(gcd(a, b), b)
                    [by or_elim b-is-zero-or-successor when-b-is-zero when-b-is-successor]
                }
              @discharge-a |
                forall a: Int; divides(gcd(a, b), a) and divides(gcd(a, b), b)
                [by forall_intro generalize-a]
            }
          @induction-step-at-b |
            (forall m: Int; is_nonneg(m) -> less_than(m, b) -> (forall a: Int; divides(gcd(a, m), a) and divides(gcd(a, m), m))) -> forall a: Int; divides(gcd(a, b), a) and divides(gcd(a, b), b)
            [by implies_intro given-strong-inductive-hypothesis]
        }
      @induction-step-guarded |
        is_nonneg(b) -> (forall m: Int; is_nonneg(m) -> less_than(m, b) -> (forall a: Int; divides(gcd(a, m), a) and divides(gcd(a, m), m))) -> forall a: Int; divides(gcd(a, b), a) and divides(gcd(a, b), b)
        [by implies_intro given-b-nonneg]
    }
  @induction-step-for-all-k |
    forall b: Int; is_nonneg(b) -> (forall m: Int; is_nonneg(m) -> less_than(m, b) -> (forall a: Int; divides(gcd(a, m), a) and divides(gcd(a, m), m))) -> forall a: Int; divides(gcd(a, b), a) and divides(gcd(a, b), b)
    [by forall_intro induction-step]
  @gcd-divides-both-swapped |
    forall b: Int; is_nonneg(b) -> forall a: Int; divides(gcd(a, b), a) and divides(gcd(a, b), b)
    [by instantiate nonnegStrongInduction((fun n: Int => forall a: Int; divides(gcd(a, n), a) and divides(gcd(a, n), n))) induction-step-for-all-k]
  // re-quantify in first-appearance order (a before b). The swapped form is
  // forall b; nonneg(b) -> forall a; …, so peel b (+ discharge nonneg) then a.
  @reorder-a |
    fix a: Int {
      @reorder-b |
        fix b: Int {
          @given-b-nonneg-reorder |
            assume is_nonneg(b) {
              @b-nonneg-reorder |
                is_nonneg(b)
                [by hypothesis given-b-nonneg-reorder]
              @gcd-divides-both-reordered |
                divides(gcd(a, b), a) and divides(gcd(a, b), b)
                [by specialize gcd-divides-both-swapped(b, a) b-nonneg-reorder]
            }
          @gcd-divides-both-if-nonneg |
            is_nonneg(b) -> (divides(gcd(a, b), a) and divides(gcd(a, b), b))
            [by implies_intro given-b-nonneg-reorder]
        }
      @reorder-discharge-b |
        forall b: Int; is_nonneg(b) -> (divides(gcd(a, b), a) and divides(gcd(a, b), b))
        [by forall_intro reorder-b]
    }
  @conclusion |
    forall a, b: Int; is_nonneg(b) -> (divides(gcd(a, b), a) and divides(gcd(a, b), b))
    [by forall_intro reorder-a]
qed

// Every common divisor of a and b divides gcd(a, b), for nonneg b. Same strong
// induction on the modulus: at b = succ(m), dividesModStep sends d | a to
// d | mod(a,b), the IH gives d | gcd(b, mod(a,b)) = gcd(a,b).
theorem gcdGreatestNonneg: forall d, a, b: Int;
  is_nonneg(b) -> divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
proof
  @induction-step |
    fix b: Int {
      @given-b-nonneg |
        assume is_nonneg(b) {
          @given-strong-inductive-hypothesis |
            assume forall m: Int; is_nonneg(m) -> less_than(m, b) -> (forall a, d: Int; divides(d, a) -> divides(d, m) -> divides(d, gcd(a, m))) {
              @strong-inductive-hypothesis |
                forall m: Int; is_nonneg(m) -> less_than(m, b) -> (forall a, d: Int; divides(d, a) -> divides(d, m) -> divides(d, gcd(a, m)))
                [by hypothesis given-strong-inductive-hypothesis]
              @b-nonneg |
                is_nonneg(b)
                [by hypothesis given-b-nonneg]
              @generalize-a |
                fix a: Int {
                  @generalize-d |
                    fix d: Int {
                      @given-d-divides-a |
                        assume divides(d, a) {
                          @given-d-divides-b |
                            assume divides(d, b) {
                              @d-divides-a |
                                divides(d, a)
                                [by hypothesis given-d-divides-a]
                              @d-divides-b |
                                divides(d, b)
                                [by hypothesis given-d-divides-b]
                              @b-is-zero-or-successor |
                                b = ZERO or (exists mm: Int; is_nonneg(mm) and b = succ(mm))
                                [by specialize nonnegCases(b) b-nonneg]
                              @when-b-is-zero |
                                assume b = ZERO {
                                  @b-is-zero |
                                    b = ZERO
                                    [by hypothesis when-b-is-zero]
                                  @gcd-with-zero-is-itself |
                                    gcd(a, ZERO) = a
                                    [by specialize gcdZero(a)]
                                  @d-divides-gcd-with-zero |
                                    divides(d, gcd(a, ZERO))
                                    [by rewrite gcd-with-zero-is-itself d-divides-a]
                                  @d-divides-gcd-when-zero |
                                    divides(d, gcd(a, b))
                                    [by rewrite b-is-zero d-divides-gcd-with-zero]
                                }
                              @when-b-is-successor |
                                assume exists mm: Int; is_nonneg(mm) and b = succ(mm) {
                                  @predecessor-exists |
                                    exists mm: Int; is_nonneg(mm) and b = succ(mm)
                                    [by hypothesis when-b-is-successor]
                                  @with-predecessor-bp |
                                    unpack bp: Int from predecessor-exists {
                                      @predecessor-facts |
                                        is_nonneg(bp) and b = succ(bp)
                                        [by hypothesis with-predecessor-bp]
                                      @bp-nonneg |
                                        is_nonneg(bp)
                                        [by and_elim_left predecessor-facts]
                                      @b-is-successor-of-bp |
                                        b = succ(bp)
                                        [by and_elim_right predecessor-facts]
                                      @successor-bp-positive |
                                        less_than(ZERO, succ(bp))
                                        [by specialize succOfNonnegIsPositive(bp) bp-nonneg]
                                      @b-is-positive |
                                        less_than(ZERO, b)
                                        [by rewrite b-is-successor-of-bp successor-bp-positive]
                                      @gcd-recurses |
                                        gcd(a, b) = gcd(b, mod(a, b))
                                        [by specialize gcdStep(b, a) b-is-positive]
                                      @mod-crossing-holds-if-divides-b |
                                        divides(d, b) -> (divides(d, a) iff divides(d, mod(a, b)))
                                        [by specialize dividesModStep(b, d, a) b-is-positive]
                                      @mod-crossing-holds |
                                        divides(d, a) iff divides(d, mod(a, b))
                                        [by modus_ponens mod-crossing-holds-if-divides-b d-divides-b]
                                      @divides-a-implies-divides-mod |
                                        divides(d, a) -> divides(d, mod(a, b))
                                        [by iff_elim_forward mod-crossing-holds]
                                      @d-divides-mod |
                                        divides(d, mod(a, b))
                                        [by modus_ponens divides-a-implies-divides-mod d-divides-a]
                                      @mod-is-below-b |
                                        less_than(mod(a, b), b)
                                        [by specialize modBound(b, a) b-is-positive]
                                      @mod-is-nonneg |
                                        is_nonneg(mod(a, b))
                                        [by specialize modNonneg(b, a) b-is-positive]
                                      @inductive-hypothesis-at-mod |
                                        is_nonneg(mod(a, b)) -> less_than(mod(a, b), b) -> (forall aa, dd: Int; divides(dd, aa) -> divides(dd, mod(a, b)) -> divides(dd, gcd(aa, mod(a, b))))
                                        [by forall_elim(mod(a, b)) strong-inductive-hypothesis]
                                      @greatest-at-mod |
                                        forall aa, dd: Int; divides(dd, aa) -> divides(dd, mod(a, b)) -> divides(dd, gcd(aa, mod(a, b)))
                                        [by tautology inductive-hypothesis-at-mod mod-is-nonneg mod-is-below-b]
                                      @d-divides-gcd-b-mod |
                                        divides(d, gcd(b, mod(a, b)))
                                        [by specialize greatest-at-mod(b, d) d-divides-b d-divides-mod]
                                      @d-divides-gcd-when-successor |
                                        divides(d, gcd(a, b))
                                        [by rewrite gcd-recurses d-divides-gcd-b-mod]
                                    }
                                  @d-divides-gcd-in-successor-case |
                                    divides(d, gcd(a, b))
                                    [by exists_elim with-predecessor-bp]
                                }
                              @d-divides-gcd |
                                divides(d, gcd(a, b))
                                [by or_elim b-is-zero-or-successor when-b-is-zero when-b-is-successor]
                            }
                          @d-divides-b-implies-d-divides-gcd |
                            divides(d, b) -> divides(d, gcd(a, b))
                            [by implies_intro given-d-divides-b]
                        }
                      @d-common-divisor-implies-d-divides-gcd |
                        divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
                        [by implies_intro given-d-divides-a]
                    }
                  @discharge-d |
                    forall d: Int; divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
                    [by forall_intro generalize-d]
                }
              @discharge-a |
                forall a, d: Int; divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
                [by forall_intro generalize-a]
            }
          @induction-step-at-b |
            (forall m: Int; is_nonneg(m) -> less_than(m, b) -> (forall a, d: Int; divides(d, a) -> divides(d, m) -> divides(d, gcd(a, m)))) -> forall a, d: Int; divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
            [by implies_intro given-strong-inductive-hypothesis]
        }
      @induction-step-guarded |
        is_nonneg(b) -> (forall m: Int; is_nonneg(m) -> less_than(m, b) -> (forall a, d: Int; divides(d, a) -> divides(d, m) -> divides(d, gcd(a, m)))) -> forall a, d: Int; divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
        [by implies_intro given-b-nonneg]
    }
  @induction-step-for-all-k |
    forall b: Int; is_nonneg(b) -> (forall m: Int; is_nonneg(m) -> less_than(m, b) -> (forall a, d: Int; divides(d, a) -> divides(d, m) -> divides(d, gcd(a, m)))) -> forall a, d: Int; divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
    [by forall_intro induction-step]
  @gcd-greatest-swapped |
    forall b: Int; is_nonneg(b) -> forall a, d: Int; divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
    [by instantiate nonnegStrongInduction((fun n: Int => forall a, d: Int; divides(d, a) -> divides(d, n) -> divides(d, gcd(a, n)))) induction-step-for-all-k]
  // re-quantify in first-appearance order (d before a before b).
  @reorder-d |
    fix d: Int {
      @reorder-a |
        fix a: Int {
          @reorder-b |
            fix b: Int {
              @given-b-nonneg-reorder |
                assume is_nonneg(b) {
                  @b-nonneg-reorder |
                    is_nonneg(b)
                    [by hypothesis given-b-nonneg-reorder]
                  @greatest-at-a-d |
                    divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
                    [by specialize gcd-greatest-swapped(b, a, d) b-nonneg-reorder]
                }
              @greatest-if-nonneg |
                is_nonneg(b) -> (divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b)))
                [by implies_intro given-b-nonneg-reorder]
            }
          @reorder-discharge-b |
            forall b: Int; is_nonneg(b) -> (divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b)))
            [by forall_intro reorder-b]
        }
      @reorder-discharge-a |
        forall a, b: Int; is_nonneg(b) -> (divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b)))
        [by forall_intro reorder-a]
    }
  @conclusion |
    forall d, a, b: Int; is_nonneg(b) -> divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
    [by forall_intro reorder-d]
qed

// gcd(a, b) divides both a and b, for ALL integers b. gcdAbs sends gcd(a, b) to
// gcd(a, abs b) with abs(b) nonneg, so the nonneg core applies; dividesAbs
// carries divisibility of abs(b) back to b.
theorem gcdDividesBoth: forall a, b: Int; divides(gcd(a, b), a) and divides(gcd(a, b), b)
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @abs-b-nonneg |
            is_nonneg(abs(b))
            [by specialize absNonneg(b)]
          @gcd-abs-divides-both |
            divides(gcd(a, abs(b)), a) and divides(gcd(a, abs(b)), abs(b))
            [by specialize gcdDividesBothNonneg(a, abs(b)) abs-b-nonneg]
          @gcd-is-gcd-abs |
            gcd(a, b) = gcd(a, abs(b))
            [by specialize gcdAbs(b, a)]
          // rewrite gcd(a, abs b) back to gcd(a, b) in both conjuncts.
          @gcd-divides-both-abs |
            divides(gcd(a, b), a) and divides(gcd(a, b), abs(b))
            [by rewrite gcd-is-gcd-abs gcd-abs-divides-both]
          @gcd-divides-a |
            divides(gcd(a, b), a)
            [by and_elim_left gcd-divides-both-abs]
          @gcd-divides-abs-b |
            divides(gcd(a, b), abs(b))
            [by and_elim_right gcd-divides-both-abs]
          // divides(·, abs b) -> divides(·, b) via dividesAbs backward.
          @divides-abs-iff |
            divides(gcd(a, b), b) iff divides(gcd(a, b), abs(b))
            [by specialize dividesAbs(gcd(a, b), b)]
          @divides-abs-implies-divides-b |
            divides(gcd(a, b), abs(b)) -> divides(gcd(a, b), b)
            [by iff_elim_backward divides-abs-iff]
          @gcd-divides-b |
            divides(gcd(a, b), b)
            [by modus_ponens divides-abs-implies-divides-b gcd-divides-abs-b]
          @gcd-divides-both |
            divides(gcd(a, b), a) and divides(gcd(a, b), b)
            [by and_intro gcd-divides-a gcd-divides-b]
        }
      @discharge-b |
        forall b: Int; divides(gcd(a, b), a) and divides(gcd(a, b), b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; divides(gcd(a, b), a) and divides(gcd(a, b), b)
    [by forall_intro generalize-a]
qed

// Every common divisor of a and b divides gcd(a, b), for ALL integers b. Convert
// d | b to d | abs(b) [dividesAbs forward], apply the nonneg core at abs(b),
// then rewrite gcd(a, abs b) back to gcd(a, b).
theorem gcdGreatest: forall d, a, b: Int; divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
proof
  @generalize-d |
    fix d: Int {
      @generalize-a |
        fix a: Int {
          @generalize-b |
            fix b: Int {
              @given-d-divides-a |
                assume divides(d, a) {
                  @given-d-divides-b |
                    assume divides(d, b) {
                      @d-divides-a |
                        divides(d, a)
                        [by hypothesis given-d-divides-a]
                      @d-divides-b |
                        divides(d, b)
                        [by hypothesis given-d-divides-b]
                      @abs-b-nonneg |
                        is_nonneg(abs(b))
                        [by specialize absNonneg(b)]
                      @divides-abs-iff |
                        divides(d, b) iff divides(d, abs(b))
                        [by specialize dividesAbs(d, b)]
                      @divides-b-implies-divides-abs |
                        divides(d, b) -> divides(d, abs(b))
                        [by iff_elim_forward divides-abs-iff]
                      @d-divides-abs-b |
                        divides(d, abs(b))
                        [by modus_ponens divides-b-implies-divides-abs d-divides-b]
                      @d-divides-gcd-abs |
                        divides(d, gcd(a, abs(b)))
                        [by specialize gcdGreatestNonneg(d, a, abs(b)) abs-b-nonneg d-divides-a d-divides-abs-b]
                      @gcd-is-gcd-abs |
                        gcd(a, b) = gcd(a, abs(b))
                        [by specialize gcdAbs(b, a)]
                      @d-divides-gcd |
                        divides(d, gcd(a, b))
                        [by rewrite gcd-is-gcd-abs d-divides-gcd-abs]
                    }
                  @d-divides-b-implies-gcd |
                    divides(d, b) -> divides(d, gcd(a, b))
                    [by implies_intro given-d-divides-b]
                }
              @d-common-implies-gcd |
                divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
                [by implies_intro given-d-divides-a]
            }
          @discharge-b |
            forall b: Int; divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Int; divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall d, a, b: Int; divides(d, a) -> divides(d, b) -> divides(d, gcd(a, b))
    [by forall_intro generalize-d]
qed

// A nonnegative integer that is not positive must be ZERO. nonnegCases splits it
// into ZERO or a nonneg successor; a successor is positive, so the non-positive
// hypothesis kills that arm.
theorem nonnegNotPositiveIsZero = order.nonnegNotPositiveIsZero

// -1 < 0: add(neg(ONE), succ(ZERO)) = ZERO with nonneg gap ZERO, so lessThanIntro
// gives less_than(neg(ONE), ZERO). Used by coprimeBezout to reject d = -1.
theorem negOneLessThanZero = order.negOneLessThanZero

// The Bézout crux: after dividing a by d = ar + bs (a = dq + rem), the remainder
// is itself a combination rem = a(1 - rq) + b(-sq). Recover rem = a - dq by
// cancelling dq, substitute d, and collect coefficients (simplify over the ring).
theorem remainderIsMember:
  forall a, b, d, r, s, q, remainder: Int;
  a = add(mul(d, q), remainder) -> d = add(mul(a, r), mul(b, s))
  -> remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @generalize-d |
            fix d: Int {
              @generalize-r |
                fix r: Int {
                  @generalize-s |
                    fix s: Int {
                      @generalize-q |
                        fix q: Int {
                          @generalize-remainder |
                            fix remainder: Int {
                              @given-a-decomposes |
                                assume a = add(mul(d, q), remainder) {
                                  @given-d-value |
                                    assume d = add(mul(a, r), mul(b, s)) {
                                      @a-decomposes |
                                        a = add(mul(d, q), remainder)
                                        [by hypothesis given-a-decomposes]
                                      @d-value |
                                        d = add(mul(a, r), mul(b, s))
                                        [by hypothesis given-d-value]
                                      @dq-plus-difference-is-a |
                                        add(mul(d, q), sub(a, mul(d, q))) = a
                                        [by arithmetic]
                                      @dq-plus-difference-is-decomposition |
                                        add(mul(d, q), sub(a, mul(d, q))) = add(mul(d, q), remainder)
                                        [by rewrite a-decomposes dq-plus-difference-is-a]
                                      @cancel-left |
                                        forall c, x, y: Int; add(c, x) = add(c, y) -> x = y
                                        [by theorem addCancelLeft]
                                      @cancel-the-quotient-term |
                                        add(mul(d, q), sub(a, mul(d, q))) = add(mul(d, q), remainder) -> sub(a, mul(d, q)) = remainder
                                        [by forall_elim(mul(d, q), sub(a, mul(d, q)), remainder) cancel-left]
                                      @difference-is-remainder |
                                        sub(a, mul(d, q)) = remainder
                                        [by modus_ponens cancel-the-quotient-term dq-plus-difference-is-decomposition]
                                      @difference-collects-coefficients |
                                        sub(a, mul(add(mul(a, r), mul(b, s)), q)) = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
                                        [by simplify definitionOfSubtraction mulAddDistribLeft mulAddDistribRight mulNegRight mulOneRight mulIsAssociative addIsAssociative negAdd]
                                      @conclusion-remainder-is-member |
                                        remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
                                        [by chain difference-is-remainder d-value difference-collects-coefficients]
                                    }
                                  @d-value-implies-member |
                                    d = add(mul(a, r), mul(b, s)) -> remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
                                    [by implies_intro given-d-value]
                                }
                              @conclusion-implication |
                                a = add(mul(d, q), remainder) -> d = add(mul(a, r), mul(b, s)) -> remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
                                [by implies_intro given-a-decomposes]
                            }
                          @discharge-remainder |
                            forall remainder: Int; a = add(mul(d, q), remainder) -> d = add(mul(a, r), mul(b, s)) -> remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
                            [by forall_intro generalize-remainder]
                        }
                      @discharge-q |
                        forall q, remainder: Int; a = add(mul(d, q), remainder) -> d = add(mul(a, r), mul(b, s)) -> remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
                        [by forall_intro generalize-q]
                    }
                  @discharge-s |
                    forall s, q, remainder: Int; a = add(mul(d, q), remainder) -> d = add(mul(a, r), mul(b, s)) -> remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
                    [by forall_intro generalize-s]
                }
              @discharge-r |
                forall r, s, q, remainder: Int; a = add(mul(d, q), remainder) -> d = add(mul(a, r), mul(b, s)) -> remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
                [by forall_intro generalize-r]
            }
          @discharge-d |
            forall d, r, s, q, remainder: Int; a = add(mul(d, q), remainder) -> d = add(mul(a, r), mul(b, s)) -> remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
            [by forall_intro generalize-d]
        }
      @discharge-b |
        forall b, d, r, s, q, remainder: Int; a = add(mul(d, q), remainder) -> d = add(mul(a, r), mul(b, s)) -> remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, d, r, s, q, remainder: Int;
      a = add(mul(d, q), remainder) -> d = add(mul(a, r), mul(b, s))
      -> remainder = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
    [by forall_intro generalize-a]
qed

// The set S = {am + bn : am + bn > 0} is nonempty when a != ZERO: trichotomy
// splits a; a > 0 gives the member a·1 + b·0 = a, a < 0 gives -a·... with -a > 0
// (negativeNegIsPositive). Packaged as a schema in a, b so its conclusion matches
// the Well-Ordering instance's shape.
theorem combinationSetNonempty(a: Int, b: Int):
  a != ZERO
  -> exists n: Int; is_nonneg(n) and (less_than(ZERO, n) and (exists mm: Int; exists nn: Int; n = add(mul(a, mm), mul(b, nn))))
proof
  @given-a-nonzero |
    assume a != ZERO {
      @a-nonzero |
        a != ZERO
        [by hypothesis given-a-nonzero]
      @a-sign-split |
        less_than(a, ZERO) or a = ZERO or less_than(ZERO, a)
        [by specialize trichotomy(a, ZERO)]
      @conclusion-set-nonempty |
        exists n: Int; is_nonneg(n) and (less_than(ZERO, n) and (exists mm: Int; exists nn: Int; n = add(mul(a, mm), mul(b, nn))))
        case a-sign-split {
          @when-a-negative |
            assume less_than(a, ZERO) {
              @a-negative |
                less_than(a, ZERO)
                [by hypothesis when-a-negative]
              @neg-a-positive |
                less_than(ZERO, neg(a))
                [by specialize negativeNegIsPositive(a) a-negative]
              @neg-a-nonneg |
                is_nonneg(neg(a))
                [by specialize positiveIsNonneg(neg(a)) neg-a-positive]
              @neg-a-is-combination |
                neg(a) = add(mul(a, neg(ONE)), mul(b, ZERO))
                [by simplify mulNegRight mulOneRight mulZeroRight addZeroRight]
              @neg-a-is-some-combination-in-nn |
                exists nn: Int; neg(a) = add(mul(a, neg(ONE)), mul(b, nn))
                [by exists_intro(ZERO) neg-a-is-combination]
              @neg-a-is-a-combination |
                exists mm: Int; exists nn: Int; neg(a) = add(mul(a, mm), mul(b, nn))
                [by exists_intro(neg(ONE)) neg-a-is-some-combination-in-nn]
              @neg-a-positive-and-combination |
                less_than(ZERO, neg(a)) and (exists mm: Int; exists nn: Int; neg(a) = add(mul(a, mm), mul(b, nn)))
                [by and_intro neg-a-positive neg-a-is-a-combination]
              @neg-a-is-nonneg-member |
                is_nonneg(neg(a)) and (less_than(ZERO, neg(a)) and (exists mm: Int; exists nn: Int; neg(a) = add(mul(a, mm), mul(b, nn))))
                [by and_intro neg-a-nonneg neg-a-positive-and-combination]
              @conclusion-set-nonempty |
                exists n: Int; is_nonneg(n) and (less_than(ZERO, n) and (exists mm: Int; exists nn: Int; n = add(mul(a, mm), mul(b, nn))))
                [by exists_intro(neg(a)) neg-a-is-nonneg-member]
            }
          @when-a-zero |
            assume a = ZERO {
              @a-is-zero |
                a = ZERO
                [by hypothesis when-a-zero]
              @conclusion-set-nonempty |
                exists n: Int; is_nonneg(n) and (less_than(ZERO, n) and (exists mm: Int; exists nn: Int; n = add(mul(a, mm), mul(b, nn))))
                [by absurd a-is-zero a-nonzero]
            }
          @when-a-positive |
            assume less_than(ZERO, a) {
              @a-positive |
                less_than(ZERO, a)
                [by hypothesis when-a-positive]
              @a-nonneg |
                is_nonneg(a)
                [by specialize positiveIsNonneg(a) a-positive]
              @a-is-combination |
                a = add(mul(a, ONE), mul(b, ZERO))
                [by simplify mulOneRight mulZeroRight addZeroRight]
              @a-is-some-combination-in-nn |
                exists nn: Int; a = add(mul(a, ONE), mul(b, nn))
                [by exists_intro(ZERO) a-is-combination]
              @a-is-a-combination |
                exists mm: Int; exists nn: Int; a = add(mul(a, mm), mul(b, nn))
                [by exists_intro(ONE) a-is-some-combination-in-nn]
              @a-positive-and-combination |
                less_than(ZERO, a) and (exists mm: Int; exists nn: Int; a = add(mul(a, mm), mul(b, nn)))
                [by and_intro a-positive a-is-a-combination]
              @a-is-nonneg-member |
                is_nonneg(a) and (less_than(ZERO, a) and (exists mm: Int; exists nn: Int; a = add(mul(a, mm), mul(b, nn))))
                [by and_intro a-nonneg a-positive-and-combination]
              @conclusion-set-nonempty |
                exists n: Int; is_nonneg(n) and (less_than(ZERO, n) and (exists mm: Int; exists nn: Int; n = add(mul(a, mm), mul(b, nn))))
                [by exists_intro(a) a-is-nonneg-member]
            }
        }
    }
  @conclusion |
    a != ZERO
      -> exists n: Int; is_nonneg(n) and (less_than(ZERO, n) and (exists mm: Int; exists nn: Int; n = add(mul(a, mm), mul(b, nn))))
    [by implies_intro given-a-nonzero]
qed

// The GCD / Bézout theorem (existence form). For nonzero a, b there is a positive
// d that divides both, is divisible by every common divisor, and is d = ar + bs.
// Well-Ordering on S = {am + bn > 0} (nonempty by combinationSetNonempty) gives a
// least member d = ar + bs; dividing a by d, the remainder is a member of S
// smaller than d unless it is ZERO (remainderIsMember + minimality), so d | a;
// symmetrically d | b; and any common divisor of a, b divides ar + bs = d.
theorem bezout: forall a, b: Int; a != ZERO -> b != ZERO ->
  exists d: Int;
  less_than(ZERO, d)
  and divides(d, a) and divides(d, b)
  and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d))
  and (exists r: Int; exists s: Int; d = add(mul(a, r), mul(b, s)))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @given-a-nonzero |
            assume a != ZERO {
              @given-b-nonzero |
                assume b != ZERO {
                  @a-nonzero |
                    a != ZERO
                    [by hypothesis given-a-nonzero]
                  // S = {am + bn > 0} is nonempty (combinationSetNonempty).
                  @set-nonempty-if-a-nonzero |
                    a != ZERO
                      -> exists n: Int; is_nonneg(n) and (less_than(ZERO, n) and (exists mm: Int; exists nn: Int; n = add(mul(a, mm), mul(b, nn))))
                    [by instantiate combinationSetNonempty(a, b)]
                  @set-is-nonempty |
                    exists n: Int; is_nonneg(n) and (less_than(ZERO, n) and (exists mm: Int; exists nn: Int; n = add(mul(a, mm), mul(b, nn))))
                    [by modus_ponens set-nonempty-if-a-nonzero a-nonzero]
                  // Well-Ordering hands us a least member d.
                  @well-ordering-on-set |
                    (exists n: Int; is_nonneg(n) and (less_than(ZERO, n) and (exists mm: Int; exists nn: Int; n = add(mul(a, mm), mul(b, nn)))))
                      -> exists least: Int; is_nonneg(least) and (less_than(ZERO, least) and (exists mm: Int; exists nn: Int; least = add(mul(a, mm), mul(b, nn)))) and (forall m: Int; is_nonneg(m) -> (less_than(ZERO, m) and (exists mm: Int; exists nn: Int; m = add(mul(a, mm), mul(b, nn)))) -> at_most(least, m))
                    [by instantiate nonnegWellOrdering((fun x: Int => less_than(ZERO, x) and (exists mm: Int; exists nn: Int; x = add(mul(a, mm), mul(b, nn)))))]
                  @least-member-exists |
                    exists least: Int; is_nonneg(least) and (less_than(ZERO, least) and (exists mm: Int; exists nn: Int; least = add(mul(a, mm), mul(b, nn)))) and (forall m: Int; is_nonneg(m) -> (less_than(ZERO, m) and (exists mm: Int; exists nn: Int; m = add(mul(a, mm), mul(b, nn)))) -> at_most(least, m))
                    [by modus_ponens well-ordering-on-set set-is-nonempty]
                  @with-least-member-d |
                    unpack d: Int from least-member-exists {
                      @d-is-least-member |
                        is_nonneg(d) and (less_than(ZERO, d) and (exists mm: Int; exists nn: Int; d = add(mul(a, mm), mul(b, nn)))) and (forall m: Int; is_nonneg(m) -> (less_than(ZERO, m) and (exists mm: Int; exists nn: Int; m = add(mul(a, mm), mul(b, nn)))) -> at_most(d, m))
                        [by hypothesis with-least-member-d]
                      @d-is-positive |
                        less_than(ZERO, d)
                        [by tautology d-is-least-member]
                      @d-is-a-combination |
                        exists mm: Int; exists nn: Int; d = add(mul(a, mm), mul(b, nn))
                        [by tautology d-is-least-member]
                      @d-is-least |
                        forall m: Int; is_nonneg(m) -> (less_than(ZERO, m) and (exists mm: Int; exists nn: Int; m = add(mul(a, mm), mul(b, nn)))) -> at_most(d, m)
                        [by tautology d-is-least-member]
                      @with-coefficient-r |
                        unpack r: Int from d-is-a-combination {
                          @d-is-combination-in-r |
                            exists nn: Int; d = add(mul(a, r), mul(b, nn))
                            [by hypothesis with-coefficient-r]
                          @with-coefficient-s |
                            unpack s: Int from d-is-combination-in-r {
                              @d-equals-combination |
                                d = add(mul(a, r), mul(b, s))
                                [by hypothesis with-coefficient-s]
                              // d | a: run the Division Algorithm a = dq + rem.
                              @a-divided-by-d |
                                exists q: Int; exists rem: Int; a = add(mul(d, q), rem) and is_nonneg(rem) and less_than(rem, d)
                                [by specialize divisionAlgorithmExists(a, d) d-is-positive]
                              @with-quotient-q |
                                unpack q: Int from a-divided-by-d {
                                  @a-remainder-exists |
                                    exists rem: Int; a = add(mul(d, q), rem) and is_nonneg(rem) and less_than(rem, d)
                                    [by hypothesis with-quotient-q]
                                  @with-remainder |
                                    unpack rem: Int from a-remainder-exists {
                                      @a-decomposes-and-remainder-bounded |
                                        a = add(mul(d, q), rem) and is_nonneg(rem) and less_than(rem, d)
                                        [by hypothesis with-remainder]
                                      @a-decomposes |
                                        a = add(mul(d, q), rem)
                                        [by tautology a-decomposes-and-remainder-bounded]
                                      @remainder-nonneg |
                                        is_nonneg(rem)
                                        [by tautology a-decomposes-and-remainder-bounded]
                                      @remainder-less_than-d |
                                        less_than(rem, d)
                                        [by tautology a-decomposes-and-remainder-bounded]
                                      @d-not-less_than-itself |
                                        not less_than(d, d)
                                        [by specialize lessThanIrreflexive(d)]
                                      @suppose-remainder-positive |
                                        assume less_than(ZERO, rem) {
                                          @remainder-positive |
                                            less_than(ZERO, rem)
                                            [by hypothesis suppose-remainder-positive]
                                          @remainder-is-member-identity |
                                            a = add(mul(d, q), rem) -> d = add(mul(a, r), mul(b, s)) -> rem = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
                                            [by specialize remainderIsMember(a, b, d, r, s, q, rem)]
                                          @remainder-is-member-form |
                                            rem = add(mul(a, sub(ONE, mul(r, q))), mul(b, neg(mul(s, q))))
                                            [by tautology remainder-is-member-identity a-decomposes d-equals-combination]
                                          @remainder-is-some-combination-in-nn |
                                            exists nn: Int; rem = add(mul(a, sub(ONE, mul(r, q))), mul(b, nn))
                                            [by exists_intro(neg(mul(s, q))) remainder-is-member-form]
                                          @remainder-is-a-combination |
                                            exists mm: Int; exists nn: Int; rem = add(mul(a, mm), mul(b, nn))
                                            [by exists_intro(sub(ONE, mul(r, q))) remainder-is-some-combination-in-nn]
                                          @remainder-is-positive-combination |
                                            less_than(ZERO, rem) and (exists mm: Int; exists nn: Int; rem = add(mul(a, mm), mul(b, nn)))
                                            [by and_intro remainder-positive remainder-is-a-combination]
                                          @remainder-least-comparison |
                                            is_nonneg(rem) -> (less_than(ZERO, rem) and (exists mm: Int; exists nn: Int; rem = add(mul(a, mm), mul(b, nn)))) -> at_most(d, rem)
                                            [by forall_elim(rem) d-is-least]
                                          @d-at-most-remainder |
                                            at_most(d, rem)
                                            [by tautology remainder-least-comparison remainder-nonneg remainder-is-positive-combination]
                                          @d-less_than-or-equal-remainder |
                                            less_than(d, rem) or d = rem
                                            [by specialize lessOrEqualSplit(d, rem) d-at-most-remainder]
                                          @remainder-would-be-a-smaller-member |
                                            less_than(d, d)
                                            case d-less_than-or-equal-remainder {
                                              @when-d-less_than-remainder |
                                                assume less_than(d, rem) {
                                                  @d-less_than-remainder |
                                                    less_than(d, rem)
                                                    [by hypothesis when-d-less_than-remainder]
                                                  @transitive-at-d-remainder-d |
                                                    less_than(d, rem) -> less_than(rem, d) -> less_than(d, d)
                                                    [by specialize lessThanTransitive(d, rem, d)]
                                                  @conclusion-d-less_than-itself |
                                                    less_than(d, d)
                                                    [by tautology transitive-at-d-remainder-d d-less_than-remainder remainder-less_than-d]
                                                }
                                              @when-d-equals-remainder |
                                                assume d = rem {
                                                  @d-equals-remainder |
                                                    d = rem
                                                    [by hypothesis when-d-equals-remainder]
                                                  @conclusion-d-less_than-itself |
                                                    less_than(d, d)
                                                    [by rewrite d-equals-remainder remainder-less_than-d]
                                                }
                                            }
                                        }
                                      @remainder-not-positive |
                                        not less_than(ZERO, rem)
                                        [by not_intro suppose-remainder-positive remainder-would-be-a-smaller-member d-not-less_than-itself]
                                      @nonneg-not-positive-is-zero |
                                        is_nonneg(rem) -> (not less_than(ZERO, rem)) -> rem = ZERO
                                        [by specialize nonnegNotPositiveIsZero(rem)]
                                      @remainder-is-zero |
                                        rem = ZERO
                                        [by tautology nonneg-not-positive-is-zero remainder-nonneg remainder-not-positive]
                                      @add-zero-right |
                                        forall n: Int; add(n, ZERO) = n
                                        [by theorem addZeroRight]
                                      @dq-plus-zero-is-dq |
                                        add(mul(d, q), ZERO) = mul(d, q)
                                        [by forall_elim(mul(d, q)) add-zero-right]
                                      @a-is-dq |
                                        a = mul(d, q)
                                        [by chain a-decomposes remainder-is-zero dq-plus-zero-is-dq]
                                      @conclusion-d-divides-a |
                                        divides(d, a)
                                        [by specialize dividesIntro(a, d, q) a-is-dq]
                                    }
                                  @conclusion-d-divides-a |
                                    divides(d, a)
                                    [by exists_elim with-remainder]
                                }
                              @d-divides-a |
                                divides(d, a)
                                [by exists_elim with-quotient-q]
                              // d | b: symmetric, dividing b by d.
                              @combination-commutes |
                                add(mul(a, r), mul(b, s)) = add(mul(b, s), mul(a, r))
                                [by specialize addIsCommutative(mul(a, r), mul(b, s))]
                              @d-equals-combination-swapped |
                                d = add(mul(b, s), mul(a, r))
                                [by rewrite combination-commutes d-equals-combination]
                              @b-divided-by-d |
                                exists q: Int; exists rem: Int; b = add(mul(d, q), rem) and is_nonneg(rem) and less_than(rem, d)
                                [by specialize divisionAlgorithmExists(b, d) d-is-positive]
                              @with-quotient-q2 |
                                unpack q2: Int from b-divided-by-d {
                                  @b-remainder-exists |
                                    exists rem: Int; b = add(mul(d, q2), rem) and is_nonneg(rem) and less_than(rem, d)
                                    [by hypothesis with-quotient-q2]
                                  @with-remainder-of-b |
                                    unpack rem2: Int from b-remainder-exists {
                                      @b-decomposes-and-remainder-bounded |
                                        b = add(mul(d, q2), rem2) and is_nonneg(rem2) and less_than(rem2, d)
                                        [by hypothesis with-remainder-of-b]
                                      @b-decomposes |
                                        b = add(mul(d, q2), rem2)
                                        [by tautology b-decomposes-and-remainder-bounded]
                                      @remainder-nonneg |
                                        is_nonneg(rem2)
                                        [by tautology b-decomposes-and-remainder-bounded]
                                      @remainder-less_than-d |
                                        less_than(rem2, d)
                                        [by tautology b-decomposes-and-remainder-bounded]
                                      @d-not-less_than-itself |
                                        not less_than(d, d)
                                        [by specialize lessThanIrreflexive(d)]
                                      @suppose-remainder-positive |
                                        assume less_than(ZERO, rem2) {
                                          @remainder-positive |
                                            less_than(ZERO, rem2)
                                            [by hypothesis suppose-remainder-positive]
                                          @remainder-is-member-identity |
                                            b = add(mul(d, q2), rem2) -> d = add(mul(b, s), mul(a, r)) -> rem2 = add(mul(b, sub(ONE, mul(s, q2))), mul(a, neg(mul(r, q2))))
                                            [by specialize remainderIsMember(b, a, d, s, r, q2, rem2)]
                                          @remainder-is-member-form-swapped |
                                            rem2 = add(mul(b, sub(ONE, mul(s, q2))), mul(a, neg(mul(r, q2))))
                                            [by tautology remainder-is-member-identity b-decomposes d-equals-combination-swapped]
                                          @member-form-commutes |
                                            add(mul(b, sub(ONE, mul(s, q2))), mul(a, neg(mul(r, q2)))) = add(mul(a, neg(mul(r, q2))), mul(b, sub(ONE, mul(s, q2))))
                                            [by specialize addIsCommutative(mul(b, sub(ONE, mul(s, q2))), mul(a, neg(mul(r, q2))))]
                                          @remainder-is-member-form |
                                            rem2 = add(mul(a, neg(mul(r, q2))), mul(b, sub(ONE, mul(s, q2))))
                                            [by rewrite member-form-commutes remainder-is-member-form-swapped]
                                          @remainder-is-some-combination-in-nn |
                                            exists nn: Int; rem2 = add(mul(a, neg(mul(r, q2))), mul(b, nn))
                                            [by exists_intro(sub(ONE, mul(s, q2))) remainder-is-member-form]
                                          @remainder-is-a-combination |
                                            exists mm: Int; exists nn: Int; rem2 = add(mul(a, mm), mul(b, nn))
                                            [by exists_intro(neg(mul(r, q2))) remainder-is-some-combination-in-nn]
                                          @remainder-is-positive-combination |
                                            less_than(ZERO, rem2) and (exists mm: Int; exists nn: Int; rem2 = add(mul(a, mm), mul(b, nn)))
                                            [by and_intro remainder-positive remainder-is-a-combination]
                                          @remainder-least-comparison |
                                            is_nonneg(rem2) -> (less_than(ZERO, rem2) and (exists mm: Int; exists nn: Int; rem2 = add(mul(a, mm), mul(b, nn)))) -> at_most(d, rem2)
                                            [by forall_elim(rem2) d-is-least]
                                          @d-at-most-remainder |
                                            at_most(d, rem2)
                                            [by tautology remainder-least-comparison remainder-nonneg remainder-is-positive-combination]
                                          @d-less_than-or-equal-remainder |
                                            less_than(d, rem2) or d = rem2
                                            [by specialize lessOrEqualSplit(d, rem2) d-at-most-remainder]
                                          @remainder-would-be-a-smaller-member |
                                            less_than(d, d)
                                            case d-less_than-or-equal-remainder {
                                              @when-d-less_than-remainder |
                                                assume less_than(d, rem2) {
                                                  @d-less_than-remainder |
                                                    less_than(d, rem2)
                                                    [by hypothesis when-d-less_than-remainder]
                                                  @transitive-at-d-remainder-d |
                                                    less_than(d, rem2) -> less_than(rem2, d) -> less_than(d, d)
                                                    [by specialize lessThanTransitive(d, rem2, d)]
                                                  @conclusion-d-less_than-itself |
                                                    less_than(d, d)
                                                    [by tautology transitive-at-d-remainder-d d-less_than-remainder remainder-less_than-d]
                                                }
                                              @when-d-equals-remainder |
                                                assume d = rem2 {
                                                  @d-equals-remainder |
                                                    d = rem2
                                                    [by hypothesis when-d-equals-remainder]
                                                  @conclusion-d-less_than-itself |
                                                    less_than(d, d)
                                                    [by rewrite d-equals-remainder remainder-less_than-d]
                                                }
                                            }
                                        }
                                      @remainder-not-positive |
                                        not less_than(ZERO, rem2)
                                        [by not_intro suppose-remainder-positive remainder-would-be-a-smaller-member d-not-less_than-itself]
                                      @nonneg-not-positive-is-zero |
                                        is_nonneg(rem2) -> (not less_than(ZERO, rem2)) -> rem2 = ZERO
                                        [by specialize nonnegNotPositiveIsZero(rem2)]
                                      @remainder-is-zero |
                                        rem2 = ZERO
                                        [by tautology nonneg-not-positive-is-zero remainder-nonneg remainder-not-positive]
                                      @add-zero-right |
                                        forall n: Int; add(n, ZERO) = n
                                        [by theorem addZeroRight]
                                      @dq-plus-zero-is-dq |
                                        add(mul(d, q2), ZERO) = mul(d, q2)
                                        [by forall_elim(mul(d, q2)) add-zero-right]
                                      @b-is-dq |
                                        b = mul(d, q2)
                                        [by chain b-decomposes remainder-is-zero dq-plus-zero-is-dq]
                                      @conclusion-d-divides-b |
                                        divides(d, b)
                                        [by specialize dividesIntro(b, d, q2) b-is-dq]
                                    }
                                  @conclusion-d-divides-b |
                                    divides(d, b)
                                    [by exists_elim with-remainder-of-b]
                                }
                              @d-divides-b |
                                divides(d, b)
                                [by exists_elim with-quotient-q2]
                              // any common divisor e divides d = ar + bs.
                              @generalize-e |
                                fix e: Int {
                                  @given-e-divides-a |
                                    assume divides(e, a) {
                                      @given-e-divides-b |
                                        assume divides(e, b) {
                                          @e-divides-a |
                                            divides(e, a)
                                            [by hypothesis given-e-divides-a]
                                          @e-divides-b |
                                            divides(e, b)
                                            [by hypothesis given-e-divides-b]
                                          @e-divides-ar |
                                            divides(e, mul(a, r))
                                            [by specialize dividesMul(e, a, r) e-divides-a]
                                          @e-divides-bs |
                                            divides(e, mul(b, s))
                                            [by specialize dividesMul(e, b, s) e-divides-b]
                                          @e-divides-combination |
                                            divides(e, add(mul(a, r), mul(b, s)))
                                            [by specialize dividesAdd(e, mul(a, r), mul(b, s)) e-divides-ar e-divides-bs]
                                          @conclusion-e-divides-d |
                                            divides(e, d)
                                            [by rewrite d-equals-combination e-divides-combination]
                                        }
                                      @e-divides-b-implies-e-divides-d |
                                        divides(e, b) -> divides(e, d)
                                        [by implies_intro given-e-divides-b]
                                    }
                                  @e-divides-a-implies-rest |
                                    divides(e, a) -> divides(e, b) -> divides(e, d)
                                    [by implies_intro given-e-divides-a]
                                }
                              @common-divisor-divides-d |
                                forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d)
                                [by forall_intro generalize-e]
                              // assemble the five defining gcd properties.
                              @d-is-some-combination-in-s |
                                exists s2: Int; d = add(mul(a, r), mul(b, s2))
                                [by exists_intro(s) d-equals-combination]
                              @d-is-a-combination-again |
                                exists r2: Int; exists s2: Int; d = add(mul(a, r2), mul(b, s2))
                                [by exists_intro(r) d-is-some-combination-in-s]
                              @d-positive-and-divides-a |
                                less_than(ZERO, d) and divides(d, a)
                                [by and_intro d-is-positive d-divides-a]
                              @d-divides-a-and-b |
                                less_than(ZERO, d) and divides(d, a) and divides(d, b)
                                [by and_intro d-positive-and-divides-a d-divides-b]
                              @d-divides-and-greatest |
                                less_than(ZERO, d) and divides(d, a) and divides(d, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d))
                                [by and_intro d-divides-a-and-b common-divisor-divides-d]
                              @d-has-all-gcd-properties |
                                less_than(ZERO, d) and divides(d, a) and divides(d, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d)) and (exists r2: Int; exists s2: Int; d = add(mul(a, r2), mul(b, s2)))
                                [by and_intro d-divides-and-greatest d-is-a-combination-again]
                              @conclusion-bezout |
                                exists d2: Int; less_than(ZERO, d2) and divides(d2, a) and divides(d2, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d2)) and (exists r2: Int; exists s2: Int; d2 = add(mul(a, r2), mul(b, s2)))
                                [by exists_intro(d) d-has-all-gcd-properties]
                            }
                          @conclusion-bezout |
                            exists d2: Int; less_than(ZERO, d2) and divides(d2, a) and divides(d2, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d2)) and (exists r2: Int; exists s2: Int; d2 = add(mul(a, r2), mul(b, s2)))
                            [by exists_elim with-coefficient-s]
                        }
                      @conclusion-bezout |
                        exists d2: Int; less_than(ZERO, d2) and divides(d2, a) and divides(d2, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d2)) and (exists r2: Int; exists s2: Int; d2 = add(mul(a, r2), mul(b, s2)))
                        [by exists_elim with-coefficient-r]
                    }
                  @conclusion-bezout |
                    exists d2: Int; less_than(ZERO, d2) and divides(d2, a) and divides(d2, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d2)) and (exists r2: Int; exists s2: Int; d2 = add(mul(a, r2), mul(b, s2)))
                    [by exists_elim with-least-member-d]
                }
              @b-nonzero-gives-bezout |
                (b != ZERO)
                  -> exists d: Int; less_than(ZERO, d) and divides(d, a) and divides(d, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d)) and (exists r: Int; exists s: Int; d = add(mul(a, r), mul(b, s)))
                [by implies_intro given-b-nonzero]
            }
          @a-nonzero-gives-bezout |
            (a != ZERO)
              -> (b != ZERO) -> exists d: Int; less_than(ZERO, d) and divides(d, a) and divides(d, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d)) and (exists r: Int; exists s: Int; d = add(mul(a, r), mul(b, s)))
            [by implies_intro given-a-nonzero]
        }
      @discharge-b |
        forall b: Int; (a != ZERO) -> (b != ZERO) -> exists d: Int; less_than(ZERO, d) and divides(d, a) and divides(d, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d)) and (exists r: Int; exists s: Int; d = add(mul(a, r), mul(b, s)))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; (a != ZERO) -> (b != ZERO) -> exists d: Int; less_than(ZERO, d) and divides(d, a) and divides(d, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d)) and (exists r: Int; exists s: Int; d = add(mul(a, r), mul(b, s)))
    [by forall_intro generalize-a]
qed

// The coprime corollary: if every common divisor of a, b is ±1, then ar + bs = 1
// for some r, s. Bézout's positive gcd d must be 1 or -1 (coprimality); -1 is not
// positive (negOneLessThanZero + transitivity contradicts d > 0), so d = 1, and
// Bézout's identity d = ar + bs becomes ar + bs = 1.
theorem coprimeBezout: forall a, b: Int; a != ZERO -> b != ZERO ->
  (forall e: Int; divides(e, a) -> divides(e, b) -> (e = ONE or e = neg(ONE)))
  -> exists r: Int; exists s: Int; add(mul(a, r), mul(b, s)) = ONE
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @given-a-nonzero |
            assume a != ZERO {
              @given-b-nonzero |
                assume b != ZERO {
                  @given-coprime |
                    assume forall e: Int; divides(e, a) -> divides(e, b) -> (e = ONE or e = neg(ONE)) {
                      @a-nonzero |
                        a != ZERO
                        [by hypothesis given-a-nonzero]
                      @b-nonzero |
                        b != ZERO
                        [by hypothesis given-b-nonzero]
                      @coprime |
                        forall e: Int; divides(e, a) -> divides(e, b) -> (e = ONE or e = neg(ONE))
                        [by hypothesis given-coprime]
                      // Bézout supplies a positive gcd d = ar + bs dividing a, b.
                      @gcd-exists |
                        exists d: Int; less_than(ZERO, d) and divides(d, a) and divides(d, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d)) and (exists r: Int; exists s: Int; d = add(mul(a, r), mul(b, s)))
                        [by specialize bezout(a, b) a-nonzero b-nonzero]
                      @with-gcd-d |
                        unpack d: Int from gcd-exists {
                          @d-has-all-gcd-properties |
                            less_than(ZERO, d) and divides(d, a) and divides(d, b) and (forall e: Int; divides(e, a) -> divides(e, b) -> divides(e, d)) and (exists r: Int; exists s: Int; d = add(mul(a, r), mul(b, s)))
                            [by hypothesis with-gcd-d]
                          @d-is-positive |
                            less_than(ZERO, d)
                            [by tautology d-has-all-gcd-properties]
                          @d-divides-a |
                            divides(d, a)
                            [by tautology d-has-all-gcd-properties]
                          @d-divides-b |
                            divides(d, b)
                            [by tautology d-has-all-gcd-properties]
                          @d-is-a-combination |
                            exists r: Int; exists s: Int; d = add(mul(a, r), mul(b, s))
                            [by tautology d-has-all-gcd-properties]
                          // coprimality forces the gcd to be 1 or -1.
                          @coprime-at-d |
                            divides(d, a) -> divides(d, b) -> (d = ONE or d = neg(ONE))
                            [by forall_elim(d) coprime]
                          @d-is-one-or-neg-one |
                            d = ONE or d = neg(ONE)
                            [by tautology coprime-at-d d-divides-a d-divides-b]
                          @conclusion-bezout-identity |
                            exists r: Int; exists s: Int; add(mul(a, r), mul(b, s)) = ONE
                            case d-is-one-or-neg-one {
                              @when-d-is-one |
                                assume d = ONE {
                                  @d-is-one |
                                    d = ONE
                                    [by hypothesis when-d-is-one]
                                  @with-coefficient-r |
                                    unpack r: Int from d-is-a-combination {
                                      @d-is-combination-in-r |
                                        exists s: Int; d = add(mul(a, r), mul(b, s))
                                        [by hypothesis with-coefficient-r]
                                      @with-coefficient-s |
                                        unpack s: Int from d-is-combination-in-r {
                                          @d-equals-combination |
                                            d = add(mul(a, r), mul(b, s))
                                            [by hypothesis with-coefficient-s]
                                          @combination-equals-one |
                                            add(mul(a, r), mul(b, s)) = ONE
                                            [by chain d-equals-combination d-is-one]
                                          @combination-in-s-is-one |
                                            exists s2: Int; add(mul(a, r), mul(b, s2)) = ONE
                                            [by exists_intro(s) combination-equals-one]
                                          @conclusion-bezout-identity |
                                            exists r2: Int; exists s2: Int; add(mul(a, r2), mul(b, s2)) = ONE
                                            [by exists_intro(r) combination-in-s-is-one]
                                        }
                                      @conclusion-bezout-identity |
                                        exists r2: Int; exists s2: Int; add(mul(a, r2), mul(b, s2)) = ONE
                                        [by exists_elim with-coefficient-s]
                                    }
                                  @conclusion-bezout-identity |
                                    exists r2: Int; exists s2: Int; add(mul(a, r2), mul(b, s2)) = ONE
                                    [by exists_elim with-coefficient-r]
                                }
                              @when-d-is-neg-one |
                                assume d = neg(ONE) {
                                  @d-is-neg-one |
                                    d = neg(ONE)
                                    [by hypothesis when-d-is-neg-one]
                                  // d positive but d = -1 < 0 is impossible.
                                  @neg-one-is-positive |
                                    less_than(ZERO, neg(ONE))
                                    [by rewrite d-is-neg-one d-is-positive]
                                  @neg-one-is-negative |
                                    less_than(neg(ONE), ZERO)
                                    [by theorem negOneLessThanZero]
                                  @transitive-through-neg-one |
                                    less_than(ZERO, neg(ONE)) -> less_than(neg(ONE), ZERO) -> less_than(ZERO, ZERO)
                                    [by specialize lessThanTransitive(ZERO, neg(ONE), ZERO)]
                                  @zero-less_than-itself |
                                    less_than(ZERO, ZERO)
                                    [by tautology transitive-through-neg-one neg-one-is-positive neg-one-is-negative]
                                  @zero-not-less_than-itself |
                                    not less_than(ZERO, ZERO)
                                    [by specialize lessThanIrreflexive(ZERO)]
                                  @conclusion-bezout-identity |
                                    exists r2: Int; exists s2: Int; add(mul(a, r2), mul(b, s2)) = ONE
                                    [by absurd zero-less_than-itself zero-not-less_than-itself]
                                }
                            }
                        }
                      @conclusion-bezout-identity |
                        exists r2: Int; exists s2: Int; add(mul(a, r2), mul(b, s2)) = ONE
                        [by exists_elim with-gcd-d]
                    }
                  @coprime-implies-bezout-identity |
                    (forall e: Int; divides(e, a) -> divides(e, b) -> (e = ONE or e = neg(ONE)))
                      -> exists r: Int; exists s: Int; add(mul(a, r), mul(b, s)) = ONE
                    [by implies_intro given-coprime]
                }
              @b-nonzero-implies-coprime-bezout |
                (b != ZERO)
                  -> (forall e: Int; divides(e, a) -> divides(e, b) -> (e = ONE or e = neg(ONE)))
                  -> exists r: Int; exists s: Int; add(mul(a, r), mul(b, s)) = ONE
                [by implies_intro given-b-nonzero]
            }
          @a-nonzero-implies-coprime-bezout |
            (a != ZERO)
              -> (b != ZERO)
              -> (forall e: Int; divides(e, a) -> divides(e, b) -> (e = ONE or e = neg(ONE)))
              -> exists r: Int; exists s: Int; add(mul(a, r), mul(b, s)) = ONE
            [by implies_intro given-a-nonzero]
        }
      @discharge-b |
        forall b: Int; (a != ZERO) -> (b != ZERO) -> (forall e: Int; divides(e, a) -> divides(e, b) -> (e = ONE or e = neg(ONE))) -> exists r: Int; exists s: Int; add(mul(a, r), mul(b, s)) = ONE
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; (a != ZERO) -> (b != ZERO) -> (forall e: Int; divides(e, a) -> divides(e, b) -> (e = ONE or e = neg(ONE))) -> exists r: Int; exists s: Int; add(mul(a, r), mul(b, s)) = ONE
    [by forall_intro generalize-a]
qed

// ── LEAST COMMON MULTIPLE ────────────────────────────────────────────────────
// Judson's §2.2 exercise defines lcm(a, b) as the NONNEGATIVE integer m that is a
// common multiple of a and b (a | m and b | m) and divides every common multiple
// (a | n and b | n ⟹ m | n). As with `gcd`, we introduce `lcm` as a function
// characterized by exactly those defining properties; existence is the assertion
// that the characterization is realizable (it is — by well-ordering on the set of
// positive common multiples, the least of which is the lcm), and the axioms name
// the least-common-multiple property directly.
func lcm(a: Int, b: Int): Int
axiom lcmNonneg: forall a, b: Int; is_nonneg(lcm(a, b))
axiom lcmCommonMultipleLeft: forall a, b: Int; divides(a, lcm(a, b))
axiom lcmCommonMultipleRight: forall a, b: Int; divides(b, lcm(a, b))
axiom lcmLeast: forall a, b, n: Int; divides(a, n) -> divides(b, n) -> divides(lcm(a, b), n)

// UNIQUENESS of the least common multiple (Judson's Exercise 23). Any positive m
// that is itself a common multiple of a and b AND divides every common multiple
// must equal lcm(a, b): lcm | m (lcm is least, m is a common multiple) and m | lcm
// (m is least, lcm is a common multiple by its axioms); two positive integers that
// divide each other are equal by antisymmetry of ≤ on the positives.
theorem lcmUnique: forall a, b, m: Int;
  less_than(ZERO, m) ->
  less_than(ZERO, lcm(a, b)) ->
  divides(a, m) -> divides(b, m) ->
  (forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n)) ->
  m = lcm(a, b)
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @generalize-m |
            fix m: Int {
              @given-m-positive |
                assume less_than(ZERO, m) {
                  @given-lcm-positive |
                    assume less_than(ZERO, lcm(a, b)) {
                      @given-m-divides-a |
                        assume divides(a, m) {
                          @given-m-divides-b |
                            assume divides(b, m) {
                              @given-m-least |
                                assume forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n) {
                                  @m-positive |
                                    less_than(ZERO, m)
                                    [by hypothesis given-m-positive]
                                  @lcm-positive |
                                    less_than(ZERO, lcm(a, b))
                                    [by hypothesis given-lcm-positive]
                                  @m-multiple-of-a |
                                    divides(a, m)
                                    [by hypothesis given-m-divides-a]
                                  @m-multiple-of-b |
                                    divides(b, m)
                                    [by hypothesis given-m-divides-b]
                                  @m-divides-common-multiples |
                                    forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n)
                                    [by hypothesis given-m-least]
                                  // lcm divides m (lcm is least; m is a common multiple).
                                  @lcm-divides-m |
                                    divides(lcm(a, b), m)
                                    [by specialize lcmLeast(a, b, m) m-multiple-of-a m-multiple-of-b]
                                  // m divides lcm (m is least; lcm is a common multiple).
                                  @a-divides-lcm |
                                    divides(a, lcm(a, b))
                                    [by specialize lcmCommonMultipleLeft(a, b)]
                                  @b-divides-lcm |
                                    divides(b, lcm(a, b))
                                    [by specialize lcmCommonMultipleRight(a, b)]
                                  @m-least-at-lcm |
                                    divides(a, lcm(a, b)) -> divides(b, lcm(a, b)) -> divides(m, lcm(a, b))
                                    [by forall_elim(lcm(a, b)) m-divides-common-multiples]
                                  @m-divides-lcm |
                                    divides(m, lcm(a, b))
                                    [by tautology m-least-at-lcm a-divides-lcm b-divides-lcm]
                                  // two positive mutual divisors are equal.
                                  @lcm-at-most-m |
                                    at_most(lcm(a, b), m)
                                    [by specialize divisorAtMost(lcm(a, b), m) lcm-positive m-positive lcm-divides-m]
                                  @m-at-most-lcm |
                                    at_most(m, lcm(a, b))
                                    [by specialize divisorAtMost(m, lcm(a, b)) m-positive lcm-positive m-divides-lcm]
                                  @conclusion-m-equals-lcm |
                                    m = lcm(a, b)
                                    [by specialize lessOrEqualAntisymmetric(m, lcm(a, b)) m-at-most-lcm lcm-at-most-m]
                                }
                              @m-least-implies-equal |
                                (forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n)) -> m = lcm(a, b)
                                [by implies_intro given-m-least]
                            }
                          @m-divides-b-implies |
                            divides(b, m) -> (forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n)) -> m = lcm(a, b)
                            [by implies_intro given-m-divides-b]
                        }
                      @m-divides-a-implies |
                        divides(a, m) -> divides(b, m) -> (forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n)) -> m = lcm(a, b)
                        [by implies_intro given-m-divides-a]
                    }
                  @lcm-positive-implies |
                    less_than(ZERO, lcm(a, b)) -> divides(a, m) -> divides(b, m) -> (forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n)) -> m = lcm(a, b)
                    [by implies_intro given-lcm-positive]
                }
              @m-positive-implies |
                less_than(ZERO, m) -> less_than(ZERO, lcm(a, b)) -> divides(a, m) -> divides(b, m) -> (forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n)) -> m = lcm(a, b)
                [by implies_intro given-m-positive]
            }
          @discharge-m |
            forall m: Int; less_than(ZERO, m) -> less_than(ZERO, lcm(a, b)) -> divides(a, m) -> divides(b, m) -> (forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n)) -> m = lcm(a, b)
            [by forall_intro generalize-m]
        }
      @discharge-b |
        forall b, m: Int; less_than(ZERO, m) -> less_than(ZERO, lcm(a, b)) -> divides(a, m) -> divides(b, m) -> (forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n)) -> m = lcm(a, b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, m: Int; less_than(ZERO, m) -> less_than(ZERO, lcm(a, b)) -> divides(a, m) -> divides(b, m) -> (forall n: Int; divides(a, n) -> divides(b, n) -> divides(m, n)) -> m = lcm(a, b)
    [by forall_intro generalize-a]
qed

// Euclid's coprimality lemma (Bézout form): if u and v are coprime witnessed by a
// Bézout identity u·r + v·s = 1, and u divides v·w, then u divides w. Multiply the
// identity by w: w = w·u·r + w·v·s; u divides the first summand (multiple of u) and the
// second (u | v·w, so u | v·w·s), hence u | w. (The `gcd(u,v)=1` phrasing follows by
// feeding coprimeBezout; this Bézout form is the reusable core.)
theorem euclidFromBezout: forall u, v, w, r, s: Int; add(mul(u, r), mul(v, s)) = ONE -> divides(u, mul(v, w)) -> divides(u, w)
proof
  @generalize-u |
    fix u: Int {
      @generalize-v |
        fix v: Int {
          @generalize-w |
            fix w: Int {
              @generalize-r |
                fix r: Int {
                  @generalize-s |
                    fix s: Int {
                      @given-bezout |
                        assume add(mul(u, r), mul(v, s)) = ONE {
                          @given-u-divides-vw |
                            assume divides(u, mul(v, w)) {
                              @bezout |
                                add(mul(u, r), mul(v, s)) = ONE
                                [by hypothesis given-bezout]
                              @u-divides-vw |
                                divides(u, mul(v, w))
                                [by hypothesis given-u-divides-vw]
                              // w = w·1 = w·(ur + vs) = wur + wvs.
                              @mulOneRight-at-w |
                                mul(w, ONE) = w
                                [by specialize mulOneRight(w)]
                              @w-is-mul-one |
                                w = mul(w, ONE)
                                [by symmetry mulOneRight-at-w]
                              @one-is-bezout |
                                ONE = add(mul(u, r), mul(v, s))
                                [by symmetry bezout]
                              @w-times-bezout |
                                w = mul(w, add(mul(u, r), mul(v, s)))
                                [by rewrite one-is-bezout w-is-mul-one]
                              @w-distributes |
                                mul(w, add(mul(u, r), mul(v, s))) = add(mul(w, mul(u, r)), mul(w, mul(v, s)))
                                [by polynomial]
                              @w-expands |
                                w = add(mul(w, mul(u, r)), mul(w, mul(v, s)))
                                [by chain w-times-bezout w-distributes]
                              // u | w·u·r: it is u · (w·r).
                              @first-summand-is-u-multiple |
                                mul(w, mul(u, r)) = mul(u, mul(w, r))
                                [by polynomial]
                              @u-divides-u |
                                divides(u, u)
                                [by specialize dividesRefl(u)]
                              @u-divides-u-wr |
                                divides(u, mul(u, mul(w, r)))
                                [by specialize dividesMul(u, u, mul(w, r)) u-divides-u]
                              @u-divides-first |
                                divides(u, mul(w, mul(u, r)))
                                [by rewrite first-summand-is-u-multiple u-divides-u-wr]
                              // u | w·v·s: it is (v·w)·s and u | v·w.
                              @second-summand-is-vw-multiple |
                                mul(w, mul(v, s)) = mul(mul(v, w), s)
                                [by polynomial]
                              @u-divides-vw-s |
                                divides(u, mul(mul(v, w), s))
                                [by specialize dividesMul(u, mul(v, w), s) u-divides-vw]
                              @u-divides-second |
                                divides(u, mul(w, mul(v, s)))
                                [by rewrite second-summand-is-vw-multiple u-divides-vw-s]
                              // u | (first + second) = w.
                              @u-divides-sum |
                                divides(u, add(mul(w, mul(u, r)), mul(w, mul(v, s))))
                                [by specialize dividesAdd(u, mul(w, mul(u, r)), mul(w, mul(v, s))) u-divides-first u-divides-second]
                              @conclusion-u-divides-w |
                                divides(u, w)
                                [by rewrite w-expands u-divides-sum]
                            }
                          @vw-implies |
                            divides(u, mul(v, w)) -> divides(u, w)
                            [by implies_intro given-u-divides-vw]
                        }
                      @bezout-implies |
                        add(mul(u, r), mul(v, s)) = ONE -> divides(u, mul(v, w)) -> divides(u, w)
                        [by implies_intro given-bezout]
                    }
                  @discharge-s |
                    forall s: Int; add(mul(u, r), mul(v, s)) = ONE -> divides(u, mul(v, w)) -> divides(u, w)
                    [by forall_intro generalize-s]
                }
              @discharge-r |
                forall r, s: Int; add(mul(u, r), mul(v, s)) = ONE -> divides(u, mul(v, w)) -> divides(u, w)
                [by forall_intro generalize-r]
            }
          @discharge-w |
            forall w, r, s: Int; add(mul(u, r), mul(v, s)) = ONE -> divides(u, mul(v, w)) -> divides(u, w)
            [by forall_intro generalize-w]
        }
      @discharge-v |
        forall v, w, r, s: Int; add(mul(u, r), mul(v, s)) = ONE -> divides(u, mul(v, w)) -> divides(u, w)
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall u, v, w, r, s: Int; add(mul(u, r), mul(v, s)) = ONE -> divides(u, mul(v, w)) -> divides(u, w)
    [by forall_intro generalize-u]
qed
