// std/ring.b4m — the theory of a RING: an additive abelian group with an
// associative multiplication that distributes over addition. Multiplication is
// NOT required to have inverses (that is a field) nor, in general, to be
// commutative or have a unit — those are extra properties added where needed.
//
// The additive structure `(Ring, add, ZERO, neg)` IS an abelian group, so this
// theory MODELS std/group.b4m additively: the additive-group corpus (cancellation,
// inverse uniqueness/involution, …) transfers in, and the ring's own elementary
// properties are proved using those transferred facts plus the multiplicative
// and distributive axioms.

import group <<< "std/group.b4m"

sort Ring
const ZERO: Ring
const ONE: Ring
func add(a: Ring, b: Ring) => Ring
func mul(a: Ring, b: Ring) => Ring
func neg(a: Ring) => Ring

// "not the additive identity" — ring's copy of group's notion, bound to it through
// `AdditiveGroup` below (`group.nonzero <- nonzero`), so there is ONE definition and ring's
// version is not a fresh assumption. Threaded on to field, where it guards `recip`.
pred nonzero(a: Ring):
  nonzero(a) iff (not (a = ZERO))

// additive abelian group axioms (discharge the group model below). By the
// left-axiomatic convention, only the LEFT identity/inverse laws are primitive;
// the RIGHT laws (addZeroRight, addNegRight) are theorems below, proved from the
// left laws and commutativity — exactly as group.b4m derives opIdentityRight /
// opInverseRight, so the AdditiveGroup model need not map them.
axiom addIsAssociative: forall a, b, c: Ring; add(add(a, b), c) = add(a, add(b, c))
axiom addZeroLeft: forall a: Ring; add(ZERO, a) = a
axiom addNegLeft: forall a: Ring; add(neg(a), a) = ZERO
axiom addIsCommutative: forall a, b: Ring; add(a, b) = add(b, a)

// multiplicative + distributive axioms.
axiom mulIsAssociative: forall a, b, c: Ring; mul(mul(a, b), c) = mul(a, mul(b, c))
axiom mulAddDistribLeft: forall a, b, c: Ring; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
axiom mulAddDistribRight: forall a, b, c: Ring; mul(add(a, b), c) = add(mul(a, c), mul(b, c))

// the additive structure is an abelian group.
model AdditiveGroup {
  group.Grp: Ring
  group.E: ZERO
  group.op: add
  group.inverse: neg
  group.opAssoc <- addIsAssociative
  group.opIdentityLeft <- addZeroLeft
  group.opInverseLeft <- addNegLeft
  group.opCommutative <- addIsCommutative
  group.nonzero: nonzero
  group.nonzero <- nonzero
}

// -- right identity / inverse (derived from the left laws + commutativity) ---

// a + 0 = a. Commute to 0 + a, then apply the left identity.
theorem addZeroRight: forall a: Ring; add(a, ZERO) = a
proof
  @generalize-a |
    fix a: Ring {
      @swap-to-left |
        add(a, ZERO) = add(ZERO, a)
        [using specialize addIsCommutative(a, ZERO)]
      @left-is-a |
        add(ZERO, a) = a
        [using specialize addZeroLeft(a)]
      @conclusion-a-plus-zero |
        add(a, ZERO) = a
        [by rewrite left-is-a swap-to-left]
    }
  @conclusion |
    forall a: Ring; add(a, ZERO) = a
    [by generalize generalize-a]
qed

// a + (-a) = 0. Commute to (-a) + a, then apply the left inverse law.
theorem addNegRight: forall a: Ring; add(a, neg(a)) = ZERO
proof
  @generalize-a |
    fix a: Ring {
      @swap-to-left |
        add(a, neg(a)) = add(neg(a), a)
        [using specialize addIsCommutative(a, neg(a))]
      @left-is-zero |
        add(neg(a), a) = ZERO
        [using specialize addNegLeft(a)]
      @conclusion-a-plus-neg |
        add(a, neg(a)) = ZERO
        [by rewrite left-is-zero swap-to-left]
    }
  @conclusion |
    forall a: Ring; add(a, neg(a)) = ZERO
    [by generalize generalize-a]
qed

// -- elementary properties ---------------------------------------------------

// a·0 = 0, by a·0 = a·(0+0) = a·0 + a·0, then additive-cancel a·0.
// The cancellation is the transferred additive-group `cancelLeft`.
theorem mulZeroRight: forall a: Ring; mul(a, ZERO) = ZERO
proof
  @generalize-a |
    fix a: Ring {
      @zero-is-zero-plus-zero |
        add(ZERO, ZERO) = ZERO
        [using specialize addZeroLeft(ZERO)]
      @product-distributes |
        mul(a, add(ZERO, ZERO)) = add(mul(a, ZERO), mul(a, ZERO))
        [using specialize mulAddDistribLeft(a, ZERO, ZERO)]
      // mul(a, ZERO) = mul(a, add(ZERO, ZERO)) = add(mul(a, ZERO), mul(a, ZERO))
      @product-is-sum-of-itself |
        mul(a, ZERO) = add(mul(a, ZERO), mul(a, ZERO))
        [using chain zero-is-zero-plus-zero product-distributes]
      // now: mul(a, ZERO) = mul(a, ZERO) + mul(a, ZERO). Write the LHS as
      // ZERO + mul(a, ZERO) and cancel mul(a, ZERO) on the... right.
      @lhs-as-zero-plus |
        add(ZERO, mul(a, ZERO)) = mul(a, ZERO)
        [using specialize addZeroLeft(mul(a, ZERO))]
      // transitivity: rewrite `mul(a,ZERO)` (the RHS of lhs-as-zero-plus) into
      // its doubled form via product-is-sum-of-itself.
      @sum-equals-doubled |
        add(ZERO, mul(a, ZERO)) = add(mul(a, ZERO), mul(a, ZERO))
        [by rewrite product-is-sum-of-itself lhs-as-zero-plus]
      // cancelRight: forall b, a, c; add(b, a) = add(c, a) -> b = c, transferred
      // additively (the cancelled element `x` is the middle binder).
      @cancel-right |
        forall b, x, c: Ring; add(b, x) = add(c, x) -> b = c
        [using model(AdditiveGroup) group.cancelRight]
      @zero-is-product |
        ZERO = mul(a, ZERO)
        [using specialize cancel-right(ZERO, mul(a, ZERO), mul(a, ZERO)) sum-equals-doubled]
      @conclusion-product-zero |
        mul(a, ZERO) = ZERO
        [by symmetry zero-is-product]
    }
  @conclusion |
    forall a: Ring; mul(a, ZERO) = ZERO
    [by generalize generalize-a]
qed

// 0·a = 0. Mirror of mulZeroRight using RIGHT-distributivity and additive
// cancelRight on the left factor.
theorem mulZeroLeft: forall a: Ring; mul(ZERO, a) = ZERO
proof
  @generalize-a |
    fix a: Ring {
      @zero-is-zero-plus-zero |
        add(ZERO, ZERO) = ZERO
        [using specialize addZeroLeft(ZERO)]
      @product-distributes |
        mul(add(ZERO, ZERO), a) = add(mul(ZERO, a), mul(ZERO, a))
        [using specialize mulAddDistribRight(ZERO, ZERO, a)]
      // mul(ZERO, a) = mul(add(ZERO, ZERO), a) = add(mul(ZERO, a), mul(ZERO, a))
      @product-is-sum-of-itself |
        mul(ZERO, a) = add(mul(ZERO, a), mul(ZERO, a))
        [using chain zero-is-zero-plus-zero product-distributes]
      @lhs-as-zero-plus |
        add(ZERO, mul(ZERO, a)) = mul(ZERO, a)
        [using specialize addZeroLeft(mul(ZERO, a))]
      @sum-equals-doubled |
        add(ZERO, mul(ZERO, a)) = add(mul(ZERO, a), mul(ZERO, a))
        [by rewrite product-is-sum-of-itself lhs-as-zero-plus]
      @cancel-right |
        forall b, x, c: Ring; add(b, x) = add(c, x) -> b = c
        [using model(AdditiveGroup) group.cancelRight]
      @zero-is-product |
        ZERO = mul(ZERO, a)
        [using specialize cancel-right(ZERO, mul(ZERO, a), mul(ZERO, a)) sum-equals-doubled]
      @conclusion-product-zero |
        mul(ZERO, a) = ZERO
        [by symmetry zero-is-product]
    }
  @conclusion |
    forall a: Ring; mul(ZERO, a) = ZERO
    [by generalize generalize-a]
qed

// Uniqueness of the additive inverse: a right additive inverse is exactly neg.
// This is `group.inverseUnique` transferred through the AdditiveGroup model
// (op = add, E = ZERO, inverse = neg). Named here so downstream layers can cite
// the "x + y = 0 ⟹ y = −x" cancellation directly instead of re-deriving it.
theorem additiveInverseUnique: forall x, y: Ring; add(x, y) = ZERO -> y = neg(x)
proof
  @conclusion |
    forall x, y: Ring; add(x, y) = ZERO -> y = neg(x)
    [using model(AdditiveGroup) group.inverseUnique]
qed

// a·(-b) = -(a·b), by a·b + a·(-b) = a·(b + -b) = a·0 = 0, so a·(-b) is
// THE additive inverse of a·b, hence = -(a·b) by the transferred
// `additiveInverseUnique` (a right inverse in the additive group is exactly neg).
theorem mulNegRight: forall a, b: Ring; mul(a, neg(b)) = neg(mul(a, b))
proof
  @generalize-a |
    fix a: Ring {
      @generalize-b |
        fix b: Ring {
          @product-over-sum |
            mul(a, add(b, neg(b))) = add(mul(a, b), mul(a, neg(b)))
            [using specialize mulAddDistribLeft(a, b, neg(b))]
          @b-plus-negb-is-zero |
            add(b, neg(b)) = ZERO
            [using specialize addNegRight(b)]
          @a-times-zero-is-zero |
            mul(a, ZERO) = ZERO
            [using specialize mulZeroRight(a)]
          // mul(a, add(b, neg(b))) = mul(a, ZERO) = ZERO
          @product-over-sum-is-zero |
            mul(a, add(b, neg(b))) = ZERO
            [using chain b-plus-negb-is-zero a-times-zero-is-zero]
          @sum-of-products-is-zero |
            add(mul(a, b), mul(a, neg(b))) = ZERO
            [by rewrite product-over-sum product-over-sum-is-zero]
          // additiveInverseUnique: add(x, y) = ZERO -> y = neg(x). Apply at
          // (mul(a,b), mul(a,neg(b))).
          @inverse-unique |
            forall x, y: Ring; add(x, y) = ZERO -> y = neg(x)
            [by cite additiveInverseUnique]
          @inverse-unique-at |
            add(mul(a, b), mul(a, neg(b))) = ZERO -> mul(a, neg(b)) = neg(mul(a, b))
            [by apply_at(mul(a, b), mul(a, neg(b))) inverse-unique]
          @conclusion-neg |
            mul(a, neg(b)) = neg(mul(a, b))
            [by modus_ponens inverse-unique-at sum-of-products-is-zero]
        }
      @discharge-b |
        forall b: Ring; mul(a, neg(b)) = neg(mul(a, b))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Ring; mul(a, neg(b)) = neg(mul(a, b))
    [by generalize generalize-a]
qed

// (-a)·b = -(a·b). Mirror of mulNegRight using RIGHT-distributivity:
// a·b + (-a)·b = (a + -a)·b = 0·b = 0, so (-a)·b is the additive inverse of a·b.
theorem mulNegLeft: forall a, b: Ring; mul(neg(a), b) = neg(mul(a, b))
proof
  @generalize-a |
    fix a: Ring {
      @generalize-b |
        fix b: Ring {
          @sum-over-b |
            mul(add(a, neg(a)), b) = add(mul(a, b), mul(neg(a), b))
            [using specialize mulAddDistribRight(a, neg(a), b)]
          @a-plus-nega-is-zero |
            add(a, neg(a)) = ZERO
            [using specialize addNegRight(a)]
          @zero-times-b-is-zero |
            mul(ZERO, b) = ZERO
            [using specialize mulZeroLeft(b)]
          // mul(add(a, neg(a)), b) = mul(ZERO, b) = ZERO
          @sum-over-b-is-zero |
            mul(add(a, neg(a)), b) = ZERO
            [using chain a-plus-nega-is-zero zero-times-b-is-zero]
          @sum-of-products-is-zero |
            add(mul(a, b), mul(neg(a), b)) = ZERO
            [by rewrite sum-over-b sum-over-b-is-zero]
          @inverse-unique |
            forall x, y: Ring; add(x, y) = ZERO -> y = neg(x)
            [using model(AdditiveGroup) group.inverseUnique]
          @conclusion-neg-left |
            mul(neg(a), b) = neg(mul(a, b))
            [using specialize inverse-unique(mul(a, b), mul(neg(a), b)) sum-of-products-is-zero]
        }
      @discharge-b |
        forall b: Ring; mul(neg(a), b) = neg(mul(a, b))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Ring; mul(neg(a), b) = neg(mul(a, b))
    [by generalize generalize-a]
qed

// (-a)·(-b) = a·b, via (-a)(-b) = -((-a)·b): use mulNegRight on (-a)·(-b)
// to get -((-a)·b), then mulNegLeft gives (-a)·b = -(a·b), and the transferred
// additive invInvolution collapses the double negation.
theorem negMulNeg: forall a, b: Ring; mul(neg(a), neg(b)) = mul(a, b)
proof
  @generalize-a |
    fix a: Ring {
      @generalize-b |
        fix b: Ring {
          @outer-neg |
            mul(neg(a), neg(b)) = neg(mul(neg(a), b))
            [using specialize mulNegRight(neg(a), b)]
          @neg-a-times-b |
            mul(neg(a), b) = neg(mul(a, b))
            [using specialize mulNegLeft(a, b)]
          @inv-involution |
            forall x: Ring; neg(neg(x)) = x
            [using model(AdditiveGroup) group.invInvolution]
          @double-neg-ab |
            neg(neg(mul(a, b))) = mul(a, b)
            [by apply_at(mul(a, b)) inv-involution]
          // mul(neg(a), neg(b)) = neg(mul(neg(a), b)) = neg(neg(mul(a, b))) = mul(a, b)
          @conclusion-neg-mul-neg |
            mul(neg(a), neg(b)) = mul(a, b)
            [using chain outer-neg neg-a-times-b double-neg-ab]
        }
      @discharge-b |
        forall b: Ring; mul(neg(a), neg(b)) = mul(a, b)
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Ring; mul(neg(a), neg(b)) = mul(a, b)
    [by generalize generalize-a]
qed

// -(a + b) = -a + -b. By `additiveInverseUnique`: show (a+b) + (-a + -b) = 0, which is pure
// A/C rearrangement plus the two cancellations, and then -a + -b IS the additive inverse of
// a + b. Needed wherever a negation has to be gathered out of a sum — polynomial convolutions
// in particular, where each summand's negation pulls out separately.
theorem negationOfASum: forall a, b: Ring;
  add(neg(a), neg(b)) = neg(add(a, b))
proof
  @generalize-a |
    fix a: Ring {
      @generalize-b |
        fix b: Ring {
          // (a+b) + (-a + -b) = (a + -a) + (b + -b) = 0 + 0 = 0
          @the-summands-regroup |
            add(add(a, b), add(neg(a), neg(b))) =
              add(add(a, neg(a)), add(b, neg(b)))
            [using assoc_commut(addIsAssociative, addIsCommutative, addLeftSwapLocal)]
          @a-cancels |
            add(a, neg(a)) = ZERO
            [using specialize addNegRight(a)]
          @b-cancels |
            add(b, neg(b)) = ZERO
            [using specialize addNegRight(b)]
          @the-regrouped-sum-is-zero-plus-zero |
            add(add(a, b), add(neg(a), neg(b))) = add(ZERO, ZERO)
            [using simplify the-summands-regroup a-cancels b-cancels]
          @zero-plus-zero |
            add(ZERO, ZERO) = ZERO
            [using specialize addZeroLeft(ZERO)]
          @the-sum-cancels |
            add(add(a, b), add(neg(a), neg(b))) = ZERO
            [by rewrite zero-plus-zero the-regrouped-sum-is-zero-plus-zero]
          @conclusion-the-negation-of-the-sum |
            add(neg(a), neg(b)) = neg(add(a, b))
            [using specialize additiveInverseUnique(
              add(a, b), add(neg(a), neg(b))) the-sum-cancels]
        }
      @conclusion-for-all-b |
        forall b: Ring; add(neg(a), neg(b)) = neg(add(a, b))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Ring; add(neg(a), neg(b)) = neg(add(a, b))
    [by generalize generalize-a]
qed

// The additive left-swap, the third member of the AC triple `assoc_commut` wants when it is
// given the operator explicitly. Follows from associativity and commutativity.
theorem addLeftSwapLocal: forall a, b, c: Ring;
  add(a, add(b, c)) = add(b, add(a, c))
proof
  @generalize-a |
    fix a: Ring {
      @generalize-b |
        fix b: Ring {
          @generalize-c |
            fix c: Ring {
              @regroup-left |
                add(a, add(b, c)) = add(add(a, b), c)
                [by symmetry associate-left]
              @associate-left |
                add(add(a, b), c) = add(a, add(b, c))
                [using specialize addIsAssociative(a, b, c)]
              @swap-the-pair |
                add(a, b) = add(b, a)
                [using specialize addIsCommutative(a, b)]
              @regrouped-swapped |
                add(a, add(b, c)) = add(add(b, a), c)
                [by rewrite swap-the-pair regroup-left]
              @associate-right |
                add(add(b, a), c) = add(b, add(a, c))
                [using specialize addIsAssociative(b, a, c)]
              @conclusion-the-swap |
                add(a, add(b, c)) = add(b, add(a, c))
                [using simplify regrouped-swapped associate-right]
            }
          @conclusion-for-all-c |
            forall c: Ring; add(a, add(b, c)) = add(b, add(a, c))
            [by generalize generalize-c]
        }
      @conclusion-for-all-b |
        forall b, c: Ring; add(a, add(b, c)) = add(b, add(a, c))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, c: Ring; add(a, add(b, c)) = add(b, add(a, c))
    [by generalize generalize-a]
qed

// (a + c) + -c = a — associativity then the right cancellation.
theorem aSumCancelsItsRightSummand: forall a, c: Ring;
  add(add(a, c), neg(c)) = a
proof
  @generalize-a |
    fix a: Ring {
      @generalize-c |
        fix c: Ring {
          @associate |
            add(add(a, c), neg(c)) = add(a, add(c, neg(c)))
            [using specialize addIsAssociative(a, c, neg(c))]
          @c-cancels |
            add(c, neg(c)) = ZERO
            [using specialize addNegRight(c)]
          @the-inner-sum-vanishes |
            add(add(a, c), neg(c)) = add(a, ZERO)
            [using simplify associate c-cancels]
          @adding-zero-changes-nothing |
            add(a, ZERO) = a
            [using specialize addZeroRight(a)]
          @conclusion-the-summand-cancels |
            add(add(a, c), neg(c)) = a
            [using simplify the-inner-sum-vanishes adding-zero-changes-nothing]
        }
      @conclusion-for-all-c |
        forall c: Ring; add(add(a, c), neg(c)) = a
        [by generalize generalize-c]
    }
  @conclusion |
    forall a, c: Ring; add(add(a, c), neg(c)) = a
    [by generalize generalize-a]
qed
// Negation is an involution, named so consumers need not re-derive it from the group model.
theorem negationIsAnInvolution: forall a: Ring; neg(neg(a)) = a
proof
  @conclusion |
    forall a: Ring; neg(neg(a)) = a
    [using model(AdditiveGroup) group.invInvolution]
qed

// Additive cancellation: a + c = b + c implies a = b. The step a division-remainder argument
// needs when it reads off `b = p - a·d` from `p = a·d + b`.
theorem addCancelRight: forall a, b, c: Ring;
  add(a, c) = add(b, c) -> a = b
proof
  @generalize-a |
    fix a: Ring {
      @generalize-b |
        fix b: Ring {
          @generalize-c |
            fix c: Ring {
              @given-the-sums-agree |
                assume add(a, c) = add(b, c) {
                  @the-sums-agree |
                    add(a, c) = add(b, c)
                    [by hypothesis given-the-sums-agree]
                  @add-the-inverse-on-the-right |
                    add(add(a, c), neg(c)) = add(add(b, c), neg(c))
                    [by rewrite the-sums-agree reflexive-on-the-left]
                  @reflexive-on-the-left |
                    add(add(a, c), neg(c)) = add(add(a, c), neg(c))
                    [by reflexivity]
                  @the-left-collapses |
                    add(add(a, c), neg(c)) = a
                    [using specialize aSumCancelsItsRightSummand(a, c)]
                  @the-right-collapses |
                    add(add(b, c), neg(c)) = b
                    [using specialize aSumCancelsItsRightSummand(b, c)]
                  @the-left-is-the-right-side |
                    a = add(add(b, c), neg(c))
                    [by rewrite the-left-collapses add-the-inverse-on-the-right]
                  @conclusion-the-summands-agree |
                    a = b
                    [by rewrite the-right-collapses the-left-is-the-right-side]
                }
              @conclusion-cancellation |
                add(a, c) = add(b, c) -> a = b
                [by discharge given-the-sums-agree]
            }
          @conclusion-for-all-c |
            forall c: Ring; add(a, c) = add(b, c) -> a = b
            [by generalize generalize-c]
        }
      @conclusion-for-all-b |
        forall b, c: Ring; add(a, c) = add(b, c) -> a = b
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, c: Ring; add(a, c) = add(b, c) -> a = b
    [by generalize generalize-a]
qed
