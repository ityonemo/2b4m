// std/complex.b4m — the COMPLEX NUMBERS ℂ as an axiomatic FIELD (NOT ordered — ℂ
// admits no order compatible with its field structure). ℂ models std/field.b4m
// (inheriting the field corpus), adjoins the imaginary unit `i` with `i² = −1`, and
// embeds ℝ via `fromReal` / `isReal`, with real and imaginary parts `re`/`im` and
// conjugation `conj`.
//
// Following the tower's architecture, ℂ is INDEPENDENT (not constructed as ℝ×ℝ —
// 2b4m has no pair sorts) and carries the ℝ embedding as a predicate + homomorphism,
// NOT (for now) a guarded theorem-transfer model. Unlike ℚ↪ℝ (where ℚ has strictly
// fewer theorems), the reals-inside-ℂ DO carry extra structure ℂ lacks globally —
// the ORDER — so a guarded `RealsInComplex` model COULD be load-bearing; it is left
// unbuilt until a target theorem actually needs an order fact on real parts.

import field <<< "std/field.b4m"
import real <<< "std/real.b4m"

sort Complex
const ZERO: Complex
const ONE: Complex
const i: Complex
func add(a: Complex, b: Complex) => Complex
func mul(a: Complex, b: Complex) => Complex
func neg(a: Complex) => Complex
func recip(a: Complex) => Complex

// -- field axioms (discharge the field model below) --------------------------
axiom addIsAssociative: forall a, b, c: Complex; add(add(a, b), c) = add(a, add(b, c))
axiom addZeroLeft: forall a: Complex; add(ZERO, a) = a
axiom addNegLeft: forall a: Complex; add(neg(a), a) = ZERO
axiom addIsCommutative: forall a, b: Complex; add(a, b) = add(b, a)
axiom mulIsAssociative: forall a, b, c: Complex; mul(mul(a, b), c) = mul(a, mul(b, c))
axiom mulAddDistribLeft: forall a, b, c: Complex; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
axiom mulAddDistribRight: forall a, b, c: Complex; mul(add(a, b), c) = add(mul(a, c), mul(b, c))
axiom mulIsCommutative: forall a, b: Complex; mul(a, b) = mul(b, a)
axiom mulOneLeft: forall a: Complex; mul(ONE, a) = a
axiom fieldInverse: forall a: Complex; a != ZERO -> mul(a, recip(a)) = ONE
axiom oneNotZero: ONE != ZERO

model ComplexField {
  field.Field: Complex
  field.ZERO: ZERO
  field.ONE: ONE
  field.add: add
  field.mul: mul
  field.neg: neg
  field.recip: recip
  field.addIsAssociative <- addIsAssociative
  field.addZeroLeft <- addZeroLeft
  field.addNegLeft <- addNegLeft
  field.addIsCommutative <- addIsCommutative
  field.mulIsAssociative <- mulIsAssociative
  field.mulAddDistribLeft <- mulAddDistribLeft
  field.mulAddDistribRight <- mulAddDistribRight
  field.mulIsCommutative <- mulIsCommutative
  field.mulOneLeft <- mulOneLeft
  field.fieldInverse <- fieldInverse
  field.oneNotZero <- oneNotZero
}

// -- the imaginary unit -----------------------------------------------------
axiom iSquared: mul(i, i) = neg(ONE)

// -- the real embedding ℝ ↪ ℂ + real/imaginary parts -----------------------
// fromReal embeds ℝ as a subfield; re/im project to the real and imaginary parts
// (as reals); conj is complex conjugation. A complex reconstructs from its parts:
// z = fromReal(re z) + fromReal(im z)·i.
func fromReal(r: real.Real) => Complex
func re(z: Complex) => real.Real
func im(z: Complex) => real.Real
func conj(z: Complex) => Complex

axiom fromRealZero: fromReal(real.ZERO) = ZERO
axiom fromRealOne: fromReal(real.ONE) = ONE
axiom fromRealAdd: forall r, s: real.Real; fromReal(real.add(r, s)) = add(fromReal(r), fromReal(s))
axiom fromRealMul: forall r, s: real.Real; fromReal(real.mul(r, s)) = mul(fromReal(r), fromReal(s))
axiom fromRealNeg: forall r: real.Real; fromReal(real.neg(r)) = neg(fromReal(r))
axiom fromRealInjective: forall r, s: real.Real; fromReal(r) = fromReal(s) -> r = s

// re/im of an embedded real: re(fromReal r) = r, im(fromReal r) = 0.
axiom reOfReal: forall r: real.Real; re(fromReal(r)) = r
axiom imOfReal: forall r: real.Real; im(fromReal(r)) = real.ZERO
// reconstruction: every z is its real part plus its imaginary part times i.
axiom complexParts: forall z: Complex; z = add(fromReal(re(z)), mul(fromReal(im(z)), i))
// conjugation flips the imaginary part: conj(z) = re(z) − im(z)·i.
axiom conjDef: forall z: Complex; conj(z) = add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))

// -- projection algebra (re/im linearity + generator values) ----------------
// The canonical foundation for ℂ's coordinate structure: re/im are ℝ-linear and
// take known values on the generators (re(i)=0, im(i)=1). Together with
// `complexParts` these pin every complex number to its coordinate pair, and the
// conjugation/modulus facts below derive from them. (Adjoined as axioms — they
// hold in the standard model; the product-projection formulas re(zw)/im(zw) are
// derivable but not needed here, so are left for when a caller wants them.)
axiom reOfI: re(i) = real.ZERO
axiom imOfI: im(i) = real.ONE
axiom reAdd: forall z, w: Complex; re(add(z, w)) = real.add(re(z), re(w))
axiom imAdd: forall z, w: Complex; im(add(z, w)) = real.add(im(z), im(w))
axiom reNeg: forall z: Complex; re(neg(z)) = real.neg(re(z))
axiom imNeg: forall z: Complex; im(neg(z)) = real.neg(im(z))
// product-projection formulas: re(zw) = re z·re w − im z·im w, im(zw) = re z·im w +
// im z·re w. These are the irreducible primitive for ℂ's multiplication (ℂ is a
// standalone sort, not ℝ×ℝ, so they cannot be derived); every conjugation/modulus
// fact below is a THEOREM computed from re/im via these + the linearity axioms.
axiom reMul: forall z, w: Complex; re(mul(z, w)) = real.add(real.mul(re(z), re(w)), real.neg(real.mul(im(z), im(w))))
axiom imMul: forall z, w: Complex; im(mul(z, w)) = real.add(real.mul(re(z), im(w)), real.mul(im(z), re(w)))

// complex extensionality: two complex numbers with equal real and imaginary parts
// are equal (from complexParts — both reconstruct from the same coordinate pair).
// This reduces every ℂ-equality goal to a pair of ℝ-equalities, where `polynomial`
// and `simplify` operate cleanly (no imaginary-unit cross terms).
theorem complexEq: forall a, b: Complex; re(a) = re(b) -> im(a) = im(b) -> a = b
proof
  @generalize-a |
    fix a: Complex {
      @generalize-b |
        fix b: Complex {
          @given-re-equal |
            assume re(a) = re(b) {
              @given-im-equal |
                assume im(a) = im(b) {
                  @re-equal |
                    re(a) = re(b)
                    [by hypothesis given-re-equal]
                  @im-equal |
                    im(a) = im(b)
                    [by hypothesis given-im-equal]
                  @a-parts |
                    a = add(fromReal(re(a)), mul(fromReal(im(a)), i))
                    [using specialize complexParts(a)]
                  @b-parts |
                    b = add(fromReal(re(b)), mul(fromReal(im(b)), i))
                    [using specialize complexParts(b)]
                  // rewrite a's coordinates to b's, then fold back to b.
                  @a-with-b-re |
                    a = add(fromReal(re(b)), mul(fromReal(im(a)), i))
                    [by rewrite re-equal a-parts]
                  @a-with-b-coords |
                    a = add(fromReal(re(b)), mul(fromReal(im(b)), i))
                    [by rewrite im-equal a-with-b-re]
                  @conclusion-a-equals-b |
                    a = b
                    [by rewrite b-parts a-with-b-coords]
                }
              @im-equal-implies |
                im(a) = im(b) -> a = b
                [by implies_intro given-im-equal]
            }
          @re-equal-implies |
            re(a) = re(b) -> im(a) = im(b) -> a = b
            [by implies_intro given-re-equal]
        }
      @discharge-b |
        forall b: Complex; re(a) = re(b) -> im(a) = im(b) -> a = b
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Complex; re(a) = re(b) -> im(a) = im(b) -> a = b
    [by forall_intro generalize-a]
qed

// -- ring-lemma shims for the bare `polynomial` accelerant -------------------
// `polynomial` (local scope) resolves its ring vocabulary by BARE name here. The
// zero/one/inverse folds and AC sort-swaps exist in the field theory only as
// `field.<name>` (qualified); surface them locally by transferring through the
// ComplexField model, exactly as std/field.b4m surfaces ring's lemmas.

theorem mulOneRight: forall a: Complex; mul(a, ONE) = a
proof
  @conclusion |
    forall a: Complex; mul(a, ONE) = a
    [using model(ComplexField) field.mulOneRight]
qed

theorem mulZeroLeft: forall a: Complex; mul(ZERO, a) = ZERO
proof
  @conclusion |
    forall a: Complex; mul(ZERO, a) = ZERO
    [using model(ComplexField) field.mulZeroLeft]
qed

theorem mulZeroRight: forall a: Complex; mul(a, ZERO) = ZERO
proof
  @conclusion |
    forall a: Complex; mul(a, ZERO) = ZERO
    [using model(ComplexField) field.mulZeroRight]
qed

theorem addZeroRight: forall a: Complex; add(a, ZERO) = a
proof
  @conclusion |
    forall a: Complex; add(a, ZERO) = a
    [using model(ComplexField) field.addZeroRight]
qed

theorem addNegRight: forall a: Complex; add(a, neg(a)) = ZERO
proof
  @conclusion |
    forall a: Complex; add(a, neg(a)) = ZERO
    [using model(ComplexField) field.addNegRight]
qed

theorem negNeg: forall a: Complex; neg(neg(a)) = a
proof
  @conclusion |
    forall a: Complex; neg(neg(a)) = a
    [using model(ComplexField) field.negNeg]
qed

theorem mulNegLeft: forall a, b: Complex; mul(neg(a), b) = neg(mul(a, b))
proof
  @conclusion |
    forall a, b: Complex; mul(neg(a), b) = neg(mul(a, b))
    [using model(ComplexField) field.mulNegLeft]
qed

theorem mulNegRight: forall a, b: Complex; mul(a, neg(b)) = neg(mul(a, b))
proof
  @conclusion |
    forall a, b: Complex; mul(a, neg(b)) = neg(mul(a, b))
    [using model(ComplexField) field.mulNegRight]
qed

theorem mulLeftSwap: forall x, y, r: Complex; mul(x, mul(y, r)) = mul(y, mul(x, r))
proof
  @conclusion |
    forall x, y, r: Complex; mul(x, mul(y, r)) = mul(y, mul(x, r))
    [using model(ComplexField) field.mulLeftSwap]
qed

theorem addLeftSwap: forall x, y, r: Complex; add(x, add(y, r)) = add(y, add(x, r))
proof
  @conclusion |
    forall x, y, r: Complex; add(x, add(y, r)) = add(y, add(x, r))
    [using model(ComplexField) field.addLeftSwap]
qed

// -- projections of the conjugate (reusable) --------------------------------
// re(z̄) = re z and im(z̄) = −im z. Computed by pushing re/im through conjDef's
// coordinate form with the linearity axioms; the imaginary-unit term im z·i
// contributes 0 to the real part and im z to the imaginary part (reMul/imMul at
// fromReal(im z) and i, using re(i)=0, im(i)=1). All algebra is in ℝ.

// re(fromReal(im z)·i) = 0 — the "b·i" term has no real part.
theorem reOfImagTerm: forall z: Complex; re(mul(fromReal(im(z)), i)) = real.ZERO
proof
  @generalize-z |
    fix z: Complex {
      @re-of-product |
        re(mul(fromReal(im(z)), i)) = real.add(real.mul(re(fromReal(im(z))), re(i)), real.neg(real.mul(im(fromReal(im(z))), im(i))))
        [using specialize reMul(fromReal(im(z)), i)]
      @re-of-fromreal |
        re(fromReal(im(z))) = im(z)
        [using specialize reOfReal(im(z))]
      @im-of-fromreal |
        im(fromReal(im(z))) = real.ZERO
        [using specialize imOfReal(im(z))]
      @re-of-i |
        re(i) = real.ZERO
        [by cite reOfI]
      @im-of-i |
        im(i) = real.ONE
        [by cite imOfI]
      // substitute the four projection values, then ℝ-simplify im z·0 − 0·1 = 0.
      @with-fromreal-re |
        re(mul(fromReal(im(z)), i)) = real.add(real.mul(im(z), re(i)), real.neg(real.mul(im(fromReal(im(z))), im(i))))
        [by rewrite re-of-fromreal re-of-product]
      @with-fromreal-im |
        re(mul(fromReal(im(z)), i)) = real.add(real.mul(im(z), re(i)), real.neg(real.mul(real.ZERO, im(i))))
        [by rewrite im-of-fromreal with-fromreal-re]
      @with-re-i |
        re(mul(fromReal(im(z)), i)) = real.add(real.mul(im(z), real.ZERO), real.neg(real.mul(real.ZERO, im(i))))
        [by rewrite re-of-i with-fromreal-im]
      @with-im-i |
        re(mul(fromReal(im(z)), i)) = real.add(real.mul(im(z), real.ZERO), real.neg(real.mul(real.ZERO, real.ONE)))
        [by rewrite im-of-i with-re-i]
      @simplifies-to-zero |
        real.add(real.mul(im(z), real.ZERO), real.neg(real.mul(real.ZERO, real.ONE))) = real.ZERO
        [using polynomial(real)]
      @conclusion-re-imag-term |
        re(mul(fromReal(im(z)), i)) = real.ZERO
        [using chain with-im-i simplifies-to-zero]
    }
  @conclusion |
    forall z: Complex; re(mul(fromReal(im(z)), i)) = real.ZERO
    [by forall_intro generalize-z]
qed

// im(fromReal(im z)·i) = im z — the "b·i" term's imaginary part is b.
theorem imOfImagTerm: forall z: Complex; im(mul(fromReal(im(z)), i)) = im(z)
proof
  @generalize-z |
    fix z: Complex {
      @im-of-product |
        im(mul(fromReal(im(z)), i)) = real.add(real.mul(re(fromReal(im(z))), im(i)), real.mul(im(fromReal(im(z))), re(i)))
        [using specialize imMul(fromReal(im(z)), i)]
      @re-of-fromreal |
        re(fromReal(im(z))) = im(z)
        [using specialize reOfReal(im(z))]
      @im-of-fromreal |
        im(fromReal(im(z))) = real.ZERO
        [using specialize imOfReal(im(z))]
      @re-of-i |
        re(i) = real.ZERO
        [by cite reOfI]
      @im-of-i |
        im(i) = real.ONE
        [by cite imOfI]
      @with-fromreal-re |
        im(mul(fromReal(im(z)), i)) = real.add(real.mul(im(z), im(i)), real.mul(im(fromReal(im(z))), re(i)))
        [by rewrite re-of-fromreal im-of-product]
      @with-fromreal-im |
        im(mul(fromReal(im(z)), i)) = real.add(real.mul(im(z), im(i)), real.mul(real.ZERO, re(i)))
        [by rewrite im-of-fromreal with-fromreal-re]
      @with-im-i |
        im(mul(fromReal(im(z)), i)) = real.add(real.mul(im(z), real.ONE), real.mul(real.ZERO, re(i)))
        [by rewrite im-of-i with-fromreal-im]
      @with-re-i |
        im(mul(fromReal(im(z)), i)) = real.add(real.mul(im(z), real.ONE), real.mul(real.ZERO, real.ZERO))
        [by rewrite re-of-i with-im-i]
      @simplifies-to-im |
        real.add(real.mul(im(z), real.ONE), real.mul(real.ZERO, real.ZERO)) = im(z)
        [using polynomial(real)]
      @conclusion-im-imag-term |
        im(mul(fromReal(im(z)), i)) = im(z)
        [using chain with-re-i simplifies-to-im]
    }
  @conclusion |
    forall z: Complex; im(mul(fromReal(im(z)), i)) = im(z)
    [by forall_intro generalize-z]
qed

// re(z̄) = re z: conj z = fromReal(re z) + neg(im z·i); real parts add, the neg of
// the imag term's real part (which is 0) vanishes.
theorem reOfConj: forall z: Complex; re(conj(z)) = re(z)
proof
  @generalize-z |
    fix z: Complex {
      @conj-parts |
        conj(z) = add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))
        [using specialize conjDef(z)]
      @re-of-conj-reflexive |
        re(conj(z)) = re(conj(z))
        [by reflexivity]
      @re-of-conj-expanded |
        re(conj(z)) = re(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i))))
        [by rewrite conj-parts re-of-conj-reflexive]
      @re-splits |
        re(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))) = real.add(re(fromReal(re(z))), re(neg(mul(fromReal(im(z)), i))))
        [using specialize reAdd(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))]
      @re-of-fromreal |
        re(fromReal(re(z))) = re(z)
        [using specialize reOfReal(re(z))]
      @re-of-neg |
        re(neg(mul(fromReal(im(z)), i))) = real.neg(re(mul(fromReal(im(z)), i)))
        [using specialize reNeg(mul(fromReal(im(z)), i))]
      @re-imag-term-zero |
        re(mul(fromReal(im(z)), i)) = real.ZERO
        [using specialize reOfImagTerm(z)]
      // re(conj z) = re z + neg(re of imag term) = re z + neg(0) = re z.
      @re-splits-with-fromreal |
        re(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))) = real.add(re(z), re(neg(mul(fromReal(im(z)), i))))
        [by rewrite re-of-fromreal re-splits]
      @re-splits-with-neg |
        re(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))) = real.add(re(z), real.neg(re(mul(fromReal(im(z)), i))))
        [by rewrite re-of-neg re-splits-with-fromreal]
      @re-splits-with-zero |
        re(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))) = real.add(re(z), real.neg(real.ZERO))
        [by rewrite re-imag-term-zero re-splits-with-neg]
      @tail-simplifies |
        real.add(re(z), real.neg(real.ZERO)) = re(z)
        [using polynomial(real)]
      @re-of-split-is-re |
        re(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))) = re(z)
        [using chain re-splits-with-zero tail-simplifies]
      @conclusion-re-of-conj |
        re(conj(z)) = re(z)
        [using chain re-of-conj-expanded re-of-split-is-re]
    }
  @conclusion |
    forall z: Complex; re(conj(z)) = re(z)
    [by forall_intro generalize-z]
qed

// im(z̄) = −im z: conj z's imaginary part is the neg of the imag term's imag part.
theorem imOfConj: forall z: Complex; im(conj(z)) = real.neg(im(z))
proof
  @generalize-z |
    fix z: Complex {
      @conj-parts |
        conj(z) = add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))
        [using specialize conjDef(z)]
      @im-of-conj-reflexive |
        im(conj(z)) = im(conj(z))
        [by reflexivity]
      @im-of-conj-expanded |
        im(conj(z)) = im(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i))))
        [by rewrite conj-parts im-of-conj-reflexive]
      @im-splits |
        im(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))) = real.add(im(fromReal(re(z))), im(neg(mul(fromReal(im(z)), i))))
        [using specialize imAdd(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))]
      @im-of-fromreal |
        im(fromReal(re(z))) = real.ZERO
        [using specialize imOfReal(re(z))]
      @im-of-neg |
        im(neg(mul(fromReal(im(z)), i))) = real.neg(im(mul(fromReal(im(z)), i)))
        [using specialize imNeg(mul(fromReal(im(z)), i))]
      @im-imag-term |
        im(mul(fromReal(im(z)), i)) = im(z)
        [using specialize imOfImagTerm(z)]
      @im-splits-with-fromreal |
        im(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))) = real.add(real.ZERO, im(neg(mul(fromReal(im(z)), i))))
        [by rewrite im-of-fromreal im-splits]
      @im-splits-with-neg |
        im(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))) = real.add(real.ZERO, real.neg(im(mul(fromReal(im(z)), i))))
        [by rewrite im-of-neg im-splits-with-fromreal]
      @im-splits-with-im |
        im(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))) = real.add(real.ZERO, real.neg(im(z)))
        [by rewrite im-imag-term im-splits-with-neg]
      @tail-simplifies |
        real.add(real.ZERO, real.neg(im(z))) = real.neg(im(z))
        [using polynomial(real)]
      @im-of-split-is-neg |
        im(add(fromReal(re(z)), neg(mul(fromReal(im(z)), i)))) = real.neg(im(z))
        [using chain im-splits-with-im tail-simplifies]
      @conclusion-im-of-conj |
        im(conj(z)) = real.neg(im(z))
        [using chain im-of-conj-expanded im-of-split-is-neg]
    }
  @conclusion |
    forall z: Complex; im(conj(z)) = real.neg(im(z))
    [by forall_intro generalize-z]
qed

// -- conjugation and the norm-square (derived) ------------------------------

// z·z̄ = re(z)² + im(z)², embedded as a real — this is |z|² and the crux of the
// modulus theory. Proved by complex extensionality (complexEq): the real part of
// z·z̄ is re z·re z + im z·im z and the imaginary part is 0, each an ℝ-identity
// after unfolding reMul/imMul with reOfConj/imOfConj. No imaginary-unit cross
// terms ever appear (all algebra lands in ℝ).
theorem zTimesConj: forall z: Complex; mul(z, conj(z)) = fromReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z))))
proof
  @generalize-z |
    fix z: Complex {
      @re-of-conj |
        re(conj(z)) = re(z)
        [using specialize reOfConj(z)]
      @im-of-conj |
        im(conj(z)) = real.neg(im(z))
        [using specialize imOfConj(z)]
      // real part: re(z·z̄) = re z·re(z̄) − im z·im(z̄) = re z·re z + im z·im z.
      @re-of-product |
        re(mul(z, conj(z))) = real.add(real.mul(re(z), re(conj(z))), real.neg(real.mul(im(z), im(conj(z)))))
        [using specialize reMul(z, conj(z))]
      @re-with-re-conj |
        re(mul(z, conj(z))) = real.add(real.mul(re(z), re(z)), real.neg(real.mul(im(z), im(conj(z)))))
        [by rewrite re-of-conj re-of-product]
      @re-with-im-conj |
        re(mul(z, conj(z))) = real.add(real.mul(re(z), re(z)), real.neg(real.mul(im(z), real.neg(im(z)))))
        [by rewrite im-of-conj re-with-re-conj]
      @re-simplifies |
        real.add(real.mul(re(z), re(z)), real.neg(real.mul(im(z), real.neg(im(z))))) = real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z)))
        [using polynomial(real)]
      @re-of-product-final |
        re(mul(z, conj(z))) = real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z)))
        [using chain re-with-im-conj re-simplifies]
      @re-of-fromreal |
        re(fromReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z))))) = real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z)))
        [using specialize reOfReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z))))]
      @re-of-fromreal-flipped |
        real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z))) = re(fromReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z)))))
        [by symmetry re-of-fromreal]
      @real-parts-equal |
        re(mul(z, conj(z))) = re(fromReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z)))))
        [using chain re-of-product-final re-of-fromreal-flipped]
      // imaginary part: im(z·z̄) = re z·im(z̄) + im z·re(z̄) = re z·(−im z) + im z·re z = 0.
      @im-of-product |
        im(mul(z, conj(z))) = real.add(real.mul(re(z), im(conj(z))), real.mul(im(z), re(conj(z))))
        [using specialize imMul(z, conj(z))]
      @im-with-im-conj |
        im(mul(z, conj(z))) = real.add(real.mul(re(z), real.neg(im(z))), real.mul(im(z), re(conj(z))))
        [by rewrite im-of-conj im-of-product]
      @im-with-re-conj |
        im(mul(z, conj(z))) = real.add(real.mul(re(z), real.neg(im(z))), real.mul(im(z), re(z)))
        [by rewrite re-of-conj im-with-im-conj]
      @im-simplifies |
        real.add(real.mul(re(z), real.neg(im(z))), real.mul(im(z), re(z))) = real.ZERO
        [using polynomial(real)]
      @im-of-product-final |
        im(mul(z, conj(z))) = real.ZERO
        [using chain im-with-re-conj im-simplifies]
      @im-of-fromreal |
        im(fromReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z))))) = real.ZERO
        [using specialize imOfReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z))))]
      @im-of-fromreal-flipped |
        real.ZERO = im(fromReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z)))))
        [by symmetry im-of-fromreal]
      @imag-parts-equal |
        im(mul(z, conj(z))) = im(fromReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z)))))
        [using chain im-of-product-final im-of-fromreal-flipped]
      // both parts agree ⇒ the two complex numbers are equal.
      @conclusion-z-times-conj |
        mul(z, conj(z)) = fromReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z))))
        [using specialize complexEq(mul(z, conj(z)), fromReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z))))) real-parts-equal imag-parts-equal]
    }
  @conclusion |
    forall z: Complex; mul(z, conj(z)) = fromReal(real.add(real.mul(re(z), re(z)), real.mul(im(z), im(z))))
    [by forall_intro generalize-z]
qed

// conj is an involutive ring homomorphism — conj(conj z) = z and conj(zw) =
// conj z · conj w — now THEOREMS (derived from the projection algebra via
// complexEq), not axioms: the coordinate layer determines conj completely.

// conj(conj z) = z: re(conj conj z) = re(conj z) = re z, and im(conj conj z) =
// −im(conj z) = −(−im z) = im z.
theorem conjInvolution: forall z: Complex; conj(conj(z)) = z
proof
  @generalize-z |
    fix z: Complex {
      @re-of-double |
        re(conj(conj(z))) = re(conj(z))
        [using specialize reOfConj(conj(z))]
      @re-of-single |
        re(conj(z)) = re(z)
        [using specialize reOfConj(z)]
      @real-parts-equal |
        re(conj(conj(z))) = re(z)
        [using chain re-of-double re-of-single]
      @im-of-double |
        im(conj(conj(z))) = real.neg(im(conj(z)))
        [using specialize imOfConj(conj(z))]
      @im-of-single |
        im(conj(z)) = real.neg(im(z))
        [using specialize imOfConj(z)]
      @im-double-with-single |
        im(conj(conj(z))) = real.neg(real.neg(im(z)))
        [by rewrite im-of-single im-of-double]
      @double-neg |
        real.neg(real.neg(im(z))) = im(z)
        [using specialize real.negNeg(im(z))]
      @imag-parts-equal |
        im(conj(conj(z))) = im(z)
        [using chain im-double-with-single double-neg]
      @conclusion-conj-involution |
        conj(conj(z)) = z
        [using specialize complexEq(conj(conj(z)), z) real-parts-equal imag-parts-equal]
    }
  @conclusion |
    forall z: Complex; conj(conj(z)) = z
    [by forall_intro generalize-z]
qed

// conj(zw) = conj z · conj w. Compare parts: both sides have real part
// re z·re w − im z·im w and imaginary part −(re z·im w + im z·re w). Each is an
// ℝ-identity after unfolding reMul/imMul and reOfConj/imOfConj on both sides.
theorem conjMul: forall z, w: Complex; conj(mul(z, w)) = mul(conj(z), conj(w))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @re-conj-z |
            re(conj(z)) = re(z)
            [using specialize reOfConj(z)]
          @im-conj-z |
            im(conj(z)) = real.neg(im(z))
            [using specialize imOfConj(z)]
          @re-conj-w |
            re(conj(w)) = re(w)
            [using specialize reOfConj(w)]
          @im-conj-w |
            im(conj(w)) = real.neg(im(w))
            [using specialize imOfConj(w)]
          // LHS real part: re(conj(zw)) = re(zw) = re z·re w − im z·im w.
          @re-lhs-conj |
            re(conj(mul(z, w))) = re(mul(z, w))
            [using specialize reOfConj(mul(z, w))]
          @re-lhs-mul |
            re(mul(z, w)) = real.add(real.mul(re(z), re(w)), real.neg(real.mul(im(z), im(w))))
            [using specialize reMul(z, w)]
          @re-lhs |
            re(conj(mul(z, w))) = real.add(real.mul(re(z), re(w)), real.neg(real.mul(im(z), im(w))))
            [using chain re-lhs-conj re-lhs-mul]
          // RHS real part: re(conj z·conj w) = re(conj z)·re(conj w) − im(conj z)·im(conj w).
          @re-rhs-mul |
            re(mul(conj(z), conj(w))) = real.add(real.mul(re(conj(z)), re(conj(w))), real.neg(real.mul(im(conj(z)), im(conj(w)))))
            [using specialize reMul(conj(z), conj(w))]
          @re-rhs-a |
            re(mul(conj(z), conj(w))) = real.add(real.mul(re(z), re(conj(w))), real.neg(real.mul(im(conj(z)), im(conj(w)))))
            [by rewrite re-conj-z re-rhs-mul]
          @re-rhs-b |
            re(mul(conj(z), conj(w))) = real.add(real.mul(re(z), re(w)), real.neg(real.mul(im(conj(z)), im(conj(w)))))
            [by rewrite re-conj-w re-rhs-a]
          @re-rhs-c |
            re(mul(conj(z), conj(w))) = real.add(real.mul(re(z), re(w)), real.neg(real.mul(real.neg(im(z)), im(conj(w)))))
            [by rewrite im-conj-z re-rhs-b]
          @re-rhs-d |
            re(mul(conj(z), conj(w))) = real.add(real.mul(re(z), re(w)), real.neg(real.mul(real.neg(im(z)), real.neg(im(w)))))
            [by rewrite im-conj-w re-rhs-c]
          @re-rhs-simplifies |
            real.add(real.mul(re(z), re(w)), real.neg(real.mul(real.neg(im(z)), real.neg(im(w))))) = real.add(real.mul(re(z), re(w)), real.neg(real.mul(im(z), im(w))))
            [using polynomial(real)]
          @re-rhs |
            re(mul(conj(z), conj(w))) = real.add(real.mul(re(z), re(w)), real.neg(real.mul(im(z), im(w))))
            [using chain re-rhs-d re-rhs-simplifies]
          @re-rhs-flipped |
            real.add(real.mul(re(z), re(w)), real.neg(real.mul(im(z), im(w)))) = re(mul(conj(z), conj(w)))
            [by symmetry re-rhs]
          @real-parts-equal |
            re(conj(mul(z, w))) = re(mul(conj(z), conj(w)))
            [using chain re-lhs re-rhs-flipped]
          // LHS imag part: im(conj(zw)) = −im(zw) = −(re z·im w + im z·re w).
          @im-lhs-conj |
            im(conj(mul(z, w))) = real.neg(im(mul(z, w)))
            [using specialize imOfConj(mul(z, w))]
          @im-lhs-mul |
            im(mul(z, w)) = real.add(real.mul(re(z), im(w)), real.mul(im(z), re(w)))
            [using specialize imMul(z, w)]
          @im-lhs-with-mul |
            im(conj(mul(z, w))) = real.neg(real.add(real.mul(re(z), im(w)), real.mul(im(z), re(w))))
            [by rewrite im-lhs-mul im-lhs-conj]
          // RHS imag part: im(conj z·conj w) = re(conj z)·im(conj w) + im(conj z)·re(conj w).
          @im-rhs-mul |
            im(mul(conj(z), conj(w))) = real.add(real.mul(re(conj(z)), im(conj(w))), real.mul(im(conj(z)), re(conj(w))))
            [using specialize imMul(conj(z), conj(w))]
          @im-rhs-a |
            im(mul(conj(z), conj(w))) = real.add(real.mul(re(z), im(conj(w))), real.mul(im(conj(z)), re(conj(w))))
            [by rewrite re-conj-z im-rhs-mul]
          @im-rhs-b |
            im(mul(conj(z), conj(w))) = real.add(real.mul(re(z), real.neg(im(w))), real.mul(im(conj(z)), re(conj(w))))
            [by rewrite im-conj-w im-rhs-a]
          @im-rhs-c |
            im(mul(conj(z), conj(w))) = real.add(real.mul(re(z), real.neg(im(w))), real.mul(real.neg(im(z)), re(conj(w))))
            [by rewrite im-conj-z im-rhs-b]
          @im-rhs-d |
            im(mul(conj(z), conj(w))) = real.add(real.mul(re(z), real.neg(im(w))), real.mul(real.neg(im(z)), re(w)))
            [by rewrite re-conj-w im-rhs-c]
          @im-both-simplify |
            real.neg(real.add(real.mul(re(z), im(w)), real.mul(im(z), re(w)))) = real.add(real.mul(re(z), real.neg(im(w))), real.mul(real.neg(im(z)), re(w)))
            [using polynomial(real)]
          @im-lhs-matches-rhs |
            im(conj(mul(z, w))) = real.add(real.mul(re(z), real.neg(im(w))), real.mul(real.neg(im(z)), re(w)))
            [using chain im-lhs-with-mul im-both-simplify]
          @im-rhs-flipped |
            real.add(real.mul(re(z), real.neg(im(w))), real.mul(real.neg(im(z)), re(w))) = im(mul(conj(z), conj(w)))
            [by symmetry im-rhs-d]
          @imag-parts-equal |
            im(conj(mul(z, w))) = im(mul(conj(z), conj(w)))
            [using chain im-lhs-matches-rhs im-rhs-flipped]
          @conclusion-conj-mul |
            conj(mul(z, w)) = mul(conj(z), conj(w))
            [using specialize complexEq(conj(mul(z, w)), mul(conj(z), conj(w))) real-parts-equal imag-parts-equal]
        }
      @discharge-w |
        forall w: Complex; conj(mul(z, w)) = mul(conj(z), conj(w))
        [by forall_intro generalize-w]
    }
  @conclusion |
    forall z, w: Complex; conj(mul(z, w)) = mul(conj(z), conj(w))
    [by forall_intro generalize-z]
qed

define isReal(z) = exists r: real.Real; z = fromReal(r)

// -- derived ----------------------------------------------------------------

// an embedded real IS real (immediate from the def) — witness lemma for isReal.
theorem fromRealIsReal: forall r: real.Real; isReal(fromReal(r))
proof
  @generalize-r |
    fix r: real.Real {
      @image-of-r |
        fromReal(r) = fromReal(r)
        [by reflexivity]
      @is-real |
        isReal(fromReal(r))
        [by exists_intro(r) image-of-r]
    }
  @conclusion |
    forall r: real.Real; isReal(fromReal(r))
    [by forall_intro generalize-r]
qed

// ONE is real: ONE = fromReal(real.ONE) by fromRealOne, so isReal(ONE).
theorem oneIsReal: isReal(ONE)
proof
  @from-real-one |
    fromReal(real.ONE) = ONE
    [by cite fromRealOne]
  @one-is-image |
    ONE = fromReal(real.ONE)
    [by symmetry from-real-one]
  @conclusion |
    isReal(ONE)
    [by exists_intro(real.ONE) one-is-image]
qed

// smoke test (field model): no zero divisors transfers from the field theory.
theorem noZeroDivisors: forall a, b: Complex; mul(a, b) = ZERO -> (a = ZERO or b = ZERO)
proof
  @conclusion |
    forall a, b: Complex; mul(a, b) = ZERO -> (a = ZERO or b = ZERO)
    [using model(ComplexField) field.noZeroDivisors]
qed

// ============================================================================
// THEORY OF ℂ — what the sub-theory under std/complex/ proves.
//
// std/complex/modulus.b4m builds the modulus |z| = √(re² + im²) on top of this
// file and std/real/sqrt.b4m, and proves the coordinate-free identities of AATA
// §4.2. The forwards below are those results; the norm-square algebra that gets
// there stays in the sub-theory.
// ============================================================================

import modulus <<< "std/complex/modulus.b4m"

define normSq(z) = modulus.normSq(z)
define abs(z) = modulus.abs(z)

theorem normSqNonneg = modulus.normSqNonneg
theorem zTimesConjIsNormSq = modulus.zTimesConjIsNormSq
theorem absConj = modulus.absConj
theorem absMul = modulus.absMul
