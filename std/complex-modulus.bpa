// std/complex-modulus.bpa — the MODULUS |z| on ℂ and its multiplicative structure.
//
// Built on std/complex.bpa (ℂ as a field with re/im projections + conjugation as a
// derived ring involution) and std/real-sqrt.bpa (√ on the nonnegative reals). The
// norm-square normSq(z) = re(z)² + im(z)² is a nonnegative real; the modulus is its
// square root, abs(z) = √(normSq z). We prove the coordinate-free identities the
// AATA §4.2 exercises ask for: |z̄| = |z|, z·z̄ = |z|², and |zw| = |z|·|w|.
//
// The multiplicative identities go through CONJUGATION (conjMul + zTimesConj), never
// through re/im of a product, so no imaginary-unit cross terms arise; the remaining
// real-algebra obligations are discharged by `polynomial(real)`. `define` is
// definitional, so normSq/abs unfold on contact — no explicit fold steps needed.

import complex <<< "std/complex.bpa"
import real <<< "std/real.bpa"
import real_sqrt <<< "std/real-sqrt.bpa"

sort Complex = complex.Complex
const ZERO = complex.ZERO
func mul = complex.mul
func conj = complex.conj
func fromReal = complex.fromReal
func re = complex.re
func im = complex.im

sort Real = real.Real
func radd = real.add
func rmul = real.mul
func sqrt = real_sqrt.sqrt
pred less_or_equal = real.less_or_equal

// the norm-square (a real) and the modulus (its nonnegative square root).
define normSq(z: Complex) = radd(rmul(re(z), re(z)), rmul(im(z), im(z)))
define abs(z: Complex) = sqrt(normSq(z))

// normSq is nonnegative: a sum of two squares, each ≥ 0.
theorem normSqNonneg: forall z: Complex; less_or_equal(real.ZERO, normSq(z))
proof
  @generalize-z |
    fix z: Complex {
      @re-square-nonneg |
        less_or_equal(real.ZERO, rmul(re(z), re(z)))
        [using specialize real.squareNonneg(re(z))]
      @im-square-nonneg |
        less_or_equal(real.ZERO, rmul(im(z), im(z)))
        [using specialize real.squareNonneg(im(z))]
      @conclusion-normsq-nonneg |
        less_or_equal(real.ZERO, normSq(z))
        [using specialize real.addNonneg(rmul(re(z), re(z)), rmul(im(z), im(z))) re-square-nonneg im-square-nonneg]
    }
  @conclusion |
    forall z: Complex; less_or_equal(real.ZERO, normSq(z))
    [by forall_intro generalize-z]
qed

// z·z̄ = |z|² (as an embedded real). This is complex.zTimesConj, whose RHS is
// definitionally normSq(z).
theorem zTimesConjIsNormSq: forall z: Complex; mul(z, conj(z)) = fromReal(normSq(z))
proof
  @generalize-z |
    fix z: Complex {
      @conclusion-zzconj |
        mul(z, conj(z)) = fromReal(normSq(z))
        [using specialize complex.zTimesConj(z)]
    }
  @conclusion |
    forall z: Complex; mul(z, conj(z)) = fromReal(normSq(z))
    [by forall_intro generalize-z]
qed

// normSq(z̄) = normSq(z): re(z̄)² + im(z̄)² = re(z)² + (−im z)² = re(z)² + im(z)².
theorem normSqConj: forall z: Complex; normSq(conj(z)) = normSq(z)
proof
  @generalize-z |
    fix z: Complex {
      @re-conj |
        re(conj(z)) = re(z)
        [using specialize complex.reOfConj(z)]
      @im-conj |
        im(conj(z)) = real.neg(im(z))
        [using specialize complex.imOfConj(z)]
      // normSq(conj z) unfolds definitionally to re(conj z)² + im(conj z)².
      @normsq-conj-refl |
        normSq(conj(z)) = radd(rmul(re(conj(z)), re(conj(z))), rmul(im(conj(z)), im(conj(z))))
        [by reflexivity]
      @with-re |
        normSq(conj(z)) = radd(rmul(re(z), re(z)), rmul(im(conj(z)), im(conj(z))))
        [by rewrite re-conj normsq-conj-refl]
      @with-im |
        normSq(conj(z)) = radd(rmul(re(z), re(z)), rmul(real.neg(im(z)), real.neg(im(z))))
        [by rewrite im-conj with-re]
      @neg-square-is-square |
        radd(rmul(re(z), re(z)), rmul(real.neg(im(z)), real.neg(im(z)))) = normSq(z)
        [using polynomial(real)]
      @conclusion-normsq-conj |
        normSq(conj(z)) = normSq(z)
        [using chain with-im neg-square-is-square]
    }
  @conclusion |
    forall z: Complex; normSq(conj(z)) = normSq(z)
    [by forall_intro generalize-z]
qed

// |z̄| = |z|: immediate from normSqConj under √ (abs unfolds definitionally to √∘normSq).
theorem absConj: forall z: Complex; abs(conj(z)) = abs(z)
proof
  @generalize-z |
    fix z: Complex {
      @normsq-conj |
        normSq(conj(z)) = normSq(z)
        [using specialize normSqConj(z)]
      @abs-conj-refl |
        abs(conj(z)) = sqrt(normSq(conj(z)))
        [by reflexivity]
      @conclusion-abs-conj |
        abs(conj(z)) = abs(z)
        [by rewrite normsq-conj abs-conj-refl]
    }
  @conclusion |
    forall z: Complex; abs(conj(z)) = abs(z)
    [by forall_intro generalize-z]
qed

// normSq is multiplicative: normSq(zw) = normSq(z)·normSq(w). Via conjugation:
// fromReal(normSq(zw)) = zw·conj(zw) = (z z̄)(w w̄) = fromReal(normSq z)·fromReal(normSq w)
// = fromReal(normSq z · normSq w); then fromRealInjective.
theorem normSqMul: forall z, w: Complex; normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @zz |
            mul(z, conj(z)) = fromReal(normSq(z))
            [using specialize zTimesConjIsNormSq(z)]
          @ww |
            mul(w, conj(w)) = fromReal(normSq(w))
            [using specialize zTimesConjIsNormSq(w)]
          @zwzw |
            mul(mul(z, w), conj(mul(z, w))) = fromReal(normSq(mul(z, w)))
            [using specialize zTimesConjIsNormSq(mul(z, w))]
          @conj-zw |
            conj(mul(z, w)) = mul(conj(z), conj(w))
            [using specialize complex.conjMul(z, w)]
          // (zw)·conj(zw) = (zw)·(z̄ w̄) = (z z̄)·(w w̄) by commutative reassociation.
          @zwconj-refl |
            mul(mul(z, w), conj(mul(z, w))) = mul(mul(z, w), conj(mul(z, w)))
            [by reflexivity]
          @expand-with-conj |
            mul(mul(z, w), conj(mul(z, w))) = mul(mul(z, w), mul(conj(z), conj(w)))
            [by rewrite conj-zw zwconj-refl]
          @regroup |
            mul(mul(z, w), mul(conj(z), conj(w))) = mul(mul(z, conj(z)), mul(w, conj(w)))
            [using polynomial(complex)]
          @regroup-to-norms |
            mul(mul(z, w), conj(mul(z, w))) = mul(mul(z, conj(z)), mul(w, conj(w)))
            [using chain expand-with-conj regroup]
          @with-zz |
            mul(mul(z, w), conj(mul(z, w))) = mul(fromReal(normSq(z)), mul(w, conj(w)))
            [by rewrite zz regroup-to-norms]
          @with-ww |
            mul(mul(z, w), conj(mul(z, w))) = mul(fromReal(normSq(z)), fromReal(normSq(w)))
            [by rewrite ww with-zz]
          // fromReal is multiplicative: fromReal(a)·fromReal(b) = fromReal(a·b).
          @fromreal-mul |
            fromReal(rmul(normSq(z), normSq(w))) = mul(fromReal(normSq(z)), fromReal(normSq(w)))
            [using specialize complex.fromRealMul(normSq(z), normSq(w))]
          @zwconj-is-fromreal-prod |
            mul(mul(z, w), conj(mul(z, w))) = fromReal(rmul(normSq(z), normSq(w)))
            [by rewrite fromreal-mul with-ww]
          // fromReal(normSq zw) = fromReal(normSq z · normSq w), then injectivity.
          @zwzw-flipped |
            fromReal(normSq(mul(z, w))) = mul(mul(z, w), conj(mul(z, w)))
            [by symmetry zwzw]
          @fromreal-eq |
            fromReal(normSq(mul(z, w))) = fromReal(rmul(normSq(z), normSq(w)))
            [using chain zwzw-flipped zwconj-is-fromreal-prod]
          @conclusion-normsq-mul |
            normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
            [using specialize complex.fromRealInjective(normSq(mul(z, w)), rmul(normSq(z), normSq(w))) fromreal-eq]
        }
      @discharge-w |
        forall w: Complex; normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
        [by forall_intro generalize-w]
    }
  @conclusion |
    forall z, w: Complex; normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
    [by forall_intro generalize-z]
qed

// |zw| = |z|·|w|: √(normSq(zw)) = √(normSq z · normSq w) = √(normSq z)·√(normSq w)
// (sqrtMulNonneg, both norm-squares ≥ 0).
theorem absMul: forall z, w: Complex; abs(mul(z, w)) = rmul(abs(z), abs(w))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @normsq-mul |
            normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
            [using specialize normSqMul(z, w)]
          @z-norm-nonneg |
            less_or_equal(real.ZERO, normSq(z))
            [using specialize normSqNonneg(z)]
          @w-norm-nonneg |
            less_or_equal(real.ZERO, normSq(w))
            [using specialize normSqNonneg(w)]
          // abs(zw) unfolds to √(normSq zw); rewrite normSq(zw) = normSq z · normSq w.
          @abs-mul-refl |
            abs(mul(z, w)) = sqrt(normSq(mul(z, w)))
            [by reflexivity]
          @abs-mul-rewritten |
            abs(mul(z, w)) = sqrt(rmul(normSq(z), normSq(w)))
            [by rewrite normsq-mul abs-mul-refl]
          @sqrt-splits |
            sqrt(rmul(normSq(z), normSq(w))) = rmul(abs(z), abs(w))
            [using specialize real_sqrt.sqrtMulNonneg(normSq(z), normSq(w)) z-norm-nonneg w-norm-nonneg]
          @conclusion-abs-mul |
            abs(mul(z, w)) = rmul(abs(z), abs(w))
            [using chain abs-mul-rewritten sqrt-splits]
        }
      @discharge-w |
        forall w: Complex; abs(mul(z, w)) = rmul(abs(z), abs(w))
        [by forall_intro generalize-w]
    }
  @conclusion |
    forall z, w: Complex; abs(mul(z, w)) = rmul(abs(z), abs(w))
    [by forall_intro generalize-z]
qed
