// std/rational/integer-order.b4m — THE INTEGERS INSIDE ℚ ARE DISCRETE.
//
// `std/rational.b4m` carves ℤ out of ℚ as a CUT (`isInteger`) and runs
// `IntegersInRational` to transfer ℤ's algebra onto it. That model maps ℤ's ring layer only:
// `std/integer/order.b4m`'s two axioms are NOT discharged, so none of ℤ's order corpus
// travels, and any ℚ-side proof needing an integer sign argument stalls.
//
// The reason the order half was left out is real mathematics, not an oversight. ℤ's order is
// axiomatized by the NONNEG-GAP form
//
//     lessThanIntro:  nonneg(d) -> a + succ(d) = b -> a < b
//     lessThanElim:   a < b -> exists d; nonneg(d) and a + succ(d) = b
//
// and `lessThanElim` is FALSE on all of ℚ — between any two rationals lie infinitely many
// others, so no `a + (d+1) = b` gap exists. It holds only ON THE CUT. That is exactly the
// statement that ℚ's integers are DISCRETE, and this file proves it, which lets a consumer
// discharge ℤ's order axioms relativized to `isInteger` and so pull the whole ℤ-order corpus
// onto the cut.
//
// The engine of the proof is `naturalInduction`: a natural is ZERO or at least ONE. Density
// is never contradicted — the gap is produced only when both endpoints are integers.
import rational <<< "std/rational.b4m"
import field_order <<< "std/field/order.b4m"
import integer <<< "std/integer.b4m"
import int_order <<< "std/integer/order.b4m"
import divisibility <<< "std/divisibility.b4m"

sort Q = rational.Q
const ZERO = rational.ZERO
const ONE = rational.ONE
func add = rational.add
func neg = rational.neg
func succ = rational.succ
pred less_than = rational.less_than
pred isInteger = rational.isInteger
pred isNatural = rational.isNatural

// -- a natural is ZERO or at least ONE ----------------------------------------------------
// The discreteness seed. ℚ's order alone cannot say this — it is `isNatural`'s induction that
// rules out anything strictly between.

// Strategy: naturalInduction on n. Base: ZERO = ZERO. Step: succ(k) = k + ONE, and in either
// case for k the sum is at least ONE — if k = ZERO then succ(k) = ONE, and if ONE ≤ k then
// adding ONE keeps it above ONE, hence above ZERO.
theorem aNaturalIsZeroOrPositive: forall n: Q;
  isNatural(n) -> (n = ZERO or less_than(ZERO, n))
proof
  @base-case |
    ZERO = ZERO or less_than(ZERO, ZERO)
    [by either_left base-case-reflexivity]

  @base-case-reflexivity |
    ZERO = ZERO
    [by reflexivity]

  @induction-step |
    fix k: Q {
      @given-k-is-natural |
        assume isNatural(k) {
          @given-inductive-hypothesis |
            assume k = ZERO or less_than(ZERO, k) {
              @inductive-hypothesis |
                k = ZERO or less_than(ZERO, k)
                [by hypothesis given-inductive-hypothesis]
              @succ-is-plus-one |
                succ(k) = add(k, ONE)
                [using specialize rational.succDefinition(k)]
              @the-successor-of-k |
                succ(k) = succ(k)
                [by reflexivity]
              @one-positive |
                less_than(ZERO, ONE)
                [using model(rational.RationalOrderedField) field_order.zeroLessThanOne]
              @the-successor-is-positive |
                less_than(ZERO, succ(k))
                case inductive-hypothesis {
                  @when-k-is-zero |
                    assume k = ZERO {
                      @k-is-zero |
                        k = ZERO
                        [by hypothesis when-k-is-zero]
                      @one-is-succ-zero |
                        ONE = succ(ZERO)
                        [by cite rational.oneIsSuccZero]
                      @the-successor-is-succ-zero |
                        succ(k) = succ(ZERO)
                        [by rewrite k-is-zero the-successor-of-k]
                      @the-successor-is-one |
                        succ(k) = ONE
                        [by rewrite one-is-succ-zero the-successor-is-succ-zero]
                      @conclusion-the-successor-is-positive-at-zero |
                        less_than(ZERO, succ(k))
                        [by rewrite the-successor-is-one one-positive]
                    }
                  @when-k-is-positive |
                    assume less_than(ZERO, k) {
                      @k-is-positive |
                        less_than(ZERO, k)
                        [by hypothesis when-k-is-positive]
                      // 0 < k and 0 < 1 give 0 < k + 1 by adding ONE to both sides of 0 < k
                      @shifting-k-up |
                        less_than(add(ZERO, ONE), add(k, ONE))
                        [using specialize rational.lessThanAddRight(ZERO, k, ONE) k-is-positive]
                      @zero-plus-one |
                        add(ZERO, ONE) = ONE
                        [using specialize rational.addZeroLeft(ONE)]
                      @one-below-the-successor |
                        less_than(ONE, add(k, ONE))
                        [by rewrite zero-plus-one shifting-k-up]
                      @zero-below-the-sum |
                        less_than(ZERO, add(k, ONE))
                        [using specialize rational.lessThanTransitive(ZERO, ONE, add(k, ONE)) one-positive one-below-the-successor]
                      @conclusion-the-successor-is-positive-at-k |
                        less_than(ZERO, succ(k))
                        [by rewrite succ-is-plus-one zero-below-the-sum]
                    }
                }
              @conclusion-the-successor-is-zero-or-positive |
                succ(k) = ZERO or less_than(ZERO, succ(k))
                [by either_right the-successor-is-positive]
            }
          @inductive-hypothesis-implies-successor |
            (k = ZERO or less_than(ZERO, k)) ->
              (succ(k) = ZERO or less_than(ZERO, succ(k)))
            [by discharge given-inductive-hypothesis]
        }
      @natural-implies-the-step |
        isNatural(k) ->
          (k = ZERO or less_than(ZERO, k)) ->
          (succ(k) = ZERO or less_than(ZERO, succ(k)))
        [by discharge given-k-is-natural]
    }
  @induction-step-for-all-k |
    forall k: Q;
      isNatural(k) ->
      (k = ZERO or less_than(ZERO, k)) ->
      (succ(k) = ZERO or less_than(ZERO, succ(k)))
    [by generalize induction-step]

  @conclusion |
    forall n: Q; isNatural(n) -> (n = ZERO or less_than(ZERO, n))
    [using instantiation rational.naturalInduction((fun t: Q => (t = ZERO or less_than(ZERO, t)))) base-case induction-step-for-all-k]
qed

// -- a nonzero natural is a successor of a natural ----------------------------------------
// The other half of discreteness: there is nothing between a natural and its successor,
// because every natural but ZERO IS a successor. Again `naturalInduction` — ℚ's order has no
// such fact.

// Strategy: naturalInduction on n. Base: ZERO is zero, so the disjunction's left arm holds
// vacuously under the implication. Step: succ(k) is a successor of k, and k is natural by the
// step's own guard, so the witness is k itself — the inductive hypothesis is not needed.
theorem aNonzeroNaturalIsASuccessor: forall n: Q;
  isNatural(n) -> (not (n = ZERO)) -> (exists d: Q; isNatural(d) and n = succ(d))
proof
  @base-case-proof |
    assume not (ZERO = ZERO) {
      @zero-is-not-zero |
        not (ZERO = ZERO)
        [by hypothesis base-case-proof]
      @zero-is-zero |
        ZERO = ZERO
        [by reflexivity]
      @conclusion-anything |
        exists d: Q; isNatural(d) and ZERO = succ(d)
        [by ex_falso zero-is-zero zero-is-not-zero]
    }
  @base-case |
    (not (ZERO = ZERO)) -> (exists d: Q; isNatural(d) and ZERO = succ(d))
    [by discharge base-case-proof]

  @induction-step |
    fix k: Q {
      @given-k-is-natural |
        assume isNatural(k) {
          @k-is-natural |
            isNatural(k)
            [by hypothesis given-k-is-natural]
          @given-inductive-hypothesis |
            assume (not (k = ZERO)) -> (exists d: Q; isNatural(d) and k = succ(d)) {
              @given-the-successor-is-not-zero |
                assume not (succ(k) = ZERO) {
                  // the witness is k itself, natural by the step's guard
                  @the-successor-is-the-successor |
                    succ(k) = succ(k)
                    [by reflexivity]
                  @the-witness-works |
                    isNatural(k) and succ(k) = succ(k)
                    [by both k-is-natural the-successor-is-the-successor]
                  @conclusion-the-successor-has-a-predecessor |
                    exists d: Q; isNatural(d) and succ(k) = succ(d)
                    [by witness(k) the-witness-works]
                }
              @conclusion-the-step-at-k |
                (not (succ(k) = ZERO)) ->
                  (exists d: Q; isNatural(d) and succ(k) = succ(d))
                [by discharge given-the-successor-is-not-zero]
            }
          @inductive-hypothesis-implies-successor |
            ((not (k = ZERO)) -> (exists d: Q; isNatural(d) and k = succ(d))) ->
              ((not (succ(k) = ZERO)) ->
              (exists d: Q; isNatural(d) and succ(k) = succ(d)))
            [by discharge given-inductive-hypothesis]
        }
      @natural-implies-the-step |
        isNatural(k) ->
          ((not (k = ZERO)) -> (exists d: Q; isNatural(d) and k = succ(d))) ->
          ((not (succ(k) = ZERO)) ->
          (exists d: Q; isNatural(d) and succ(k) = succ(d)))
        [by discharge given-k-is-natural]
    }
  @induction-step-for-all-k |
    forall k: Q;
      isNatural(k) ->
      ((not (k = ZERO)) -> (exists d: Q; isNatural(d) and k = succ(d))) ->
      ((not (succ(k) = ZERO)) ->
      (exists d: Q; isNatural(d) and succ(k) = succ(d)))
    [by generalize induction-step]

  @conclusion |
    forall n: Q;
      isNatural(n) -> (not (n = ZERO)) -> (exists d: Q; isNatural(d) and n = succ(d))
    [using instantiation rational.naturalInduction((fun t: Q => ((not (t = ZERO)) -> (exists d: Q; isNatural(d) and t = succ(d))))) base-case induction-step-for-all-k]
qed

// -- three small bridges ------------------------------------------------------------------

// A positive element is nonzero: irreflexivity rules out 0 < 0.
theorem aPositiveIsNonzero: forall x: Q;
  less_than(ZERO, x) -> (not (x = ZERO))
proof
  @generalize-x |
    fix x: Q {
      @given-x-is-positive |
        assume less_than(ZERO, x) {
          @x-is-positive |
            less_than(ZERO, x)
            [by hypothesis given-x-is-positive]
          @given-x-is-zero |
            assume x = ZERO {
              @x-is-zero |
                x = ZERO
                [by hypothesis given-x-is-zero]
              @zero-is-positive |
                less_than(ZERO, ZERO)
                [by rewrite x-is-zero x-is-positive]
              @zero-is-not-below-itself |
                not less_than(ZERO, ZERO)
                [using specialize rational.lessThanIrreflexive(ZERO)]
            }
          @conclusion-x-is-nonzero-step |
            not (x = ZERO)
            [by contradiction given-x-is-zero zero-is-positive zero-is-not-below-itself]
        }
      @positive-implies-nonzero |
        less_than(ZERO, x) -> (not (x = ZERO))
        [by discharge given-x-is-positive]
    }
  @conclusion |
    forall x: Q; less_than(ZERO, x) -> (not (x = ZERO))
    [by generalize generalize-x]
qed

// a + (b − a) = b: the field identity, through associativity and cancellation.
theorem theDifferenceAddsBack: forall a, b: Q;
  add(a, add(b, neg(a))) = b
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @conclusion-the-difference-adds-back |
            add(a, add(b, neg(a))) = b
            [using polynomial(rational)]
        }
      @discharge-b |
        forall b9: Q; add(a, add(b9, neg(a))) = b9
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q; add(a, add(b, neg(a))) = b
    [by generalize generalize-a]
qed

// A positive integer is natural: integerCases offers natural-or-negation-natural, and the
// negation of a positive cannot be natural, since naturals are non-negative.
theorem aPositiveIntegerIsNatural: forall x: Q;
  isInteger(x) -> less_than(ZERO, x) -> isNatural(x)
proof
  @generalize-x |
    fix x: Q {
      @given-x-is-an-integer |
        assume isInteger(x) {
          @x-is-an-integer |
            isInteger(x)
            [by hypothesis given-x-is-an-integer]
          @given-x-is-positive |
            assume less_than(ZERO, x) {
              @x-is-positive |
                less_than(ZERO, x)
                [by hypothesis given-x-is-positive]
              @the-cases |
                isNatural(x) or isNatural(neg(x))
                [using specialize rational.integerCases(x) x-is-an-integer]
              @conclusion-x-is-natural |
                isNatural(x)
                case the-cases {
                  @when-x-is-natural |
                    assume isNatural(x) {
                      @x-is-natural |
                        isNatural(x)
                        [by hypothesis when-x-is-natural]
                    }
                  @when-the-negation-is-natural |
                    assume isNatural(neg(x)) {
                      @the-negation-is-natural |
                        isNatural(neg(x))
                        [by hypothesis when-the-negation-is-natural]
                      // neg(x) is negative because x is positive, so it is neither zero nor
                      // positive — but a natural is one of those two
                      @negatives-of-positives |
                        forall y: Q; less_than(ZERO, y) -> less_than(neg(y), ZERO)
                        [using model(rational.RationalOrderedField) field_order.negOfPositiveIsNegative]
                      @the-negation-is-negative |
                        less_than(neg(x), ZERO)
                        [using specialize negatives-of-positives(x) x-is-positive]
                      @the-negation-is-zero-or-positive |
                        neg(x) = ZERO or less_than(ZERO, neg(x))
                        [using specialize aNaturalIsZeroOrPositive(neg(x)) the-negation-is-natural]
                      @conclusion-x-is-natural-vacuously |
                        isNatural(x)
                        case the-negation-is-zero-or-positive {
                          @when-the-negation-is-zero |
                            assume neg(x) = ZERO {
                              @the-negation-is-zero |
                                neg(x) = ZERO
                                [by hypothesis when-the-negation-is-zero]
                              @zero-is-negative |
                                less_than(ZERO, ZERO)
                                [by rewrite the-negation-is-zero the-negation-is-negative]
                              @zero-is-not-below-itself |
                                not less_than(ZERO, ZERO)
                                [using specialize rational.lessThanIrreflexive(ZERO)]
                              @conclusion-vacuous-at-zero |
                                isNatural(x)
                                [by ex_falso zero-is-negative zero-is-not-below-itself]
                            }
                          @when-the-negation-is-positive |
                            assume less_than(ZERO, neg(x)) {
                              @the-negation-is-positive |
                                less_than(ZERO, neg(x))
                                [by hypothesis when-the-negation-is-positive]
                              @order-is-asymmetric |
                                forall y, z: Q; less_than(y, z) -> (not less_than(z, y))
                                [using model(rational.RationalOrderedField) field_order.lessThanAsymmetric]
                              @the-negation-is-not-positive |
                                not less_than(neg(x), ZERO)
                                [using specialize order-is-asymmetric(ZERO, neg(x)) the-negation-is-positive]
                              @conclusion-vacuous-at-positive |
                                isNatural(x)
                                [by ex_falso the-negation-is-negative the-negation-is-not-positive]
                            }
                        }
                    }
                }
            }
          @positive-implies-natural |
            less_than(ZERO, x) -> isNatural(x)
            [by discharge given-x-is-positive]
        }
      @integer-implies-positive-natural |
        isInteger(x) -> less_than(ZERO, x) -> isNatural(x)
        [by discharge given-x-is-an-integer]
    }
  @conclusion |
    forall x: Q; isInteger(x) -> less_than(ZERO, x) -> isNatural(x)
    [by generalize generalize-x]
qed

// -- THE INTEGERS INSIDE ℚ ARE DISCRETE ---------------------------------------------------
// For integers a < b there is a NONNEG GAP: a natural d with a + succ(d) = b. This is ℤ's
// `lessThanElim` relativized to the cut, and the fact that is false off it.

// Strategy: b − a is an integer (isIntegerSub) and positive, so by integerCases it is
// natural — its negation cannot be, being negative. A positive natural is nonzero, hence a
// successor (aNonzeroNaturalIsASuccessor), giving the gap; then a + succ(d) = a + (b − a) = b.
// The ∃ binder carries BOTH guards: `isInteger(d)` because `std/integer/order.b4m`'s `d: Int`
// relativizes to the cut, and `isNatural(d)` because `lessThanElim` states `nonneg(d)`. A
// transferred `∃x: Int` becomes `∃x; isInteger(x) and <body>`, so the conjunct is not optional.
theorem theIntegersInRationalAreDiscrete: forall a, b: Q;
  isInteger(a) -> isInteger(b) -> less_than(a, b) ->
  (exists d: Q; isInteger(d) and (isNatural(d) and add(a, succ(d)) = b))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @given-a-is-an-integer |
            assume isInteger(a) {
              @a-is-an-integer |
                isInteger(a)
                [by hypothesis given-a-is-an-integer]
              @given-b-is-an-integer |
                assume isInteger(b) {
                  @b-is-an-integer |
                    isInteger(b)
                    [by hypothesis given-b-is-an-integer]
                  @given-a-below-b |
                    assume less_than(a, b) {
                      @a-below-b |
                        less_than(a, b)
                        [by hypothesis given-a-below-b]
                      // the difference is an integer
                      @the-difference-is-an-integer |
                        isInteger(add(b, neg(a)))
                        [using specialize rational.isIntegerSub(b, a) b-is-an-integer a-is-an-integer]
                      // and it is positive: a < b shifts to 0 < b − a
                      @shifting-by-minus-a |
                        less_than(add(a, neg(a)), add(b, neg(a)))
                        [using specialize rational.lessThanAddRight(a, b, neg(a)) a-below-b]
                      @a-cancels |
                        add(a, neg(a)) = ZERO
                        [using specialize rational.addNegRight(a)]
                      @the-difference-is-positive |
                        less_than(ZERO, add(b, neg(a)))
                        [by rewrite a-cancels shifting-by-minus-a]
                      // a positive integer is natural: its negation is negative, so
                      // integerCases must take the left arm
                      @the-difference-is-natural |
                        isNatural(add(b, neg(a)))
                        [using specialize aPositiveIntegerIsNatural(add(b, neg(a))) the-difference-is-an-integer the-difference-is-positive]
                      // nonzero, being positive
                      @the-difference-is-nonzero |
                        not (add(b, neg(a)) = ZERO)
                        [using specialize aPositiveIsNonzero(add(b, neg(a))) the-difference-is-positive]
                      // so it is a successor
                      @the-difference-is-a-successor |
                        exists d: Q; isNatural(d) and add(b, neg(a)) = succ(d)
                        [using specialize aNonzeroNaturalIsASuccessor(add(b, neg(a))) the-difference-is-natural the-difference-is-nonzero]
                      @the-gap |
                        unpack d: Q from the-difference-is-a-successor {
                          @with-gap-d |
                            isNatural(d) and add(b, neg(a)) = succ(d)
                            [by hypothesis the-gap]
                          @d-is-natural |
                            isNatural(d)
                            [by and_lhs with-gap-d]
                          @the-difference-is-succ-d |
                            add(b, neg(a)) = succ(d)
                            [by and_rhs with-gap-d]
                          // a + (b − a) = b, so a + succ(d) = b
                          @adding-a-back |
                            add(a, add(b, neg(a))) = b
                            [using specialize theDifferenceAddsBack(a, b)]
                          @the-witness-equation |
                            add(a, succ(d)) = b
                            [by rewrite the-difference-is-succ-d adding-a-back]
                          @d-is-an-integer |
                            isInteger(d)
                            [using specialize rational.isNaturalIsInteger(d) d-is-natural]
                          @the-natural-gap |
                            isNatural(d) and add(a, succ(d)) = b
                            [by both d-is-natural the-witness-equation]
                          @the-witness-works |
                            isInteger(d) and (isNatural(d) and add(a, succ(d)) = b)
                            [by both d-is-an-integer the-natural-gap]
                          @conclusion-the-gap-exists |
                            exists d2: Q; isInteger(d2) and (isNatural(d2) and add(a, succ(d2)) = b)
                            [by witness(d) the-witness-works]
                        }
                      @conclusion-the-gap |
                        exists d: Q; isInteger(d) and (isNatural(d) and add(a, succ(d)) = b)
                        [by unpacked the-gap]
                    }
                  @a-below-b-implies-the-gap |
                    less_than(a, b) ->
                      (exists d: Q; isInteger(d) and (isNatural(d) and add(a, succ(d)) = b))
                    [by discharge given-a-below-b]
                }
              @b-integer-implies-the-gap |
                isInteger(b) -> less_than(a, b) ->
                  (exists d: Q; isInteger(d) and (isNatural(d) and add(a, succ(d)) = b))
                [by discharge given-b-is-an-integer]
            }
          @a-integer-implies-the-gap |
            isInteger(a) -> isInteger(b) -> less_than(a, b) ->
              (exists d: Q; isInteger(d) and (isNatural(d) and add(a, succ(d)) = b))
            [by discharge given-a-is-an-integer]
        }
      @discharge-b |
        forall b9: Q;
          isInteger(a) -> isInteger(b9) -> less_than(a, b9) ->
          (exists d: Q; isInteger(d) and (isNatural(d) and add(a, succ(d)) = b9))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q;
      isInteger(a) -> isInteger(b) -> less_than(a, b) ->
      (exists d: Q; isInteger(d) and (isNatural(d) and add(a, succ(d)) = b))
    [by generalize generalize-a]
qed

// -- closure of the NATURAL cut ------------------------------------------------------------
// `isNatural` is axiomatized by ZERO + succ only, so closure under add and mul needs proving.
// Both are the textbook inductions, and the guarded ℕ model's `-|` nominations need them.

// `nonneg` is ℕ's own universally-true predicate (`peano.nonnegAll`), so on the cut it is
// discharged by `isNatural` itself — the model relativizes ℕ's binders to the cut, and every
// element of the cut is a natural by definition of the cut.
theorem everyNaturalIsNonneg: forall n: Q; isNatural(n) -> isNatural(n)
proof
  @generalize-n |
    fix n: Q {
      @given-n-is-natural |
        assume isNatural(n) {
          @n-is-natural |
            isNatural(n)
            [by hypothesis given-n-is-natural]
        }
      @natural-implies-natural |
        isNatural(n) -> isNatural(n)
        [by discharge given-n-is-natural]
    }
  @conclusion |
    forall n: Q; isNatural(n) -> isNatural(n)
    [by generalize generalize-n]
qed

// Strategy: naturalInduction on a. Base: ZERO + b = b. Step: succ(a) + b = succ(a + b), a
// successor of a natural by the IH.
theorem isNaturalAdd: forall a, b: Q;
  isNatural(a) -> isNatural(b) -> isNatural(add(a, b))
proof
  @generalize-b |
    fix b: Q {
      @given-b-is-natural |
        assume isNatural(b) {
          @b-is-natural |
            isNatural(b)
            [by hypothesis given-b-is-natural]

          @zero-plus-b |
            add(ZERO, b) = b
            [using specialize rational.addZeroLeft(b)]
          @base-case |
            isNatural(add(ZERO, b))
            [by rewrite zero-plus-b b-is-natural]

          @induction-step |
            fix k: Q {
              @given-k-is-natural |
                assume isNatural(k) {
                  @given-inductive-hypothesis |
                    assume isNatural(add(k, b)) {
                      @inductive-hypothesis |
                        isNatural(add(k, b))
                        [by hypothesis given-inductive-hypothesis]
                      @the-sum-is-natural |
                        isNatural(succ(add(k, b)))
                        [using specialize rational.isNaturalSucc(add(k, b)) inductive-hypothesis]
                      @successor-sum |
                        add(succ(k), b) = succ(add(k, b))
                        [using specialize rational.addSuccLeft(k, b)]
                      @conclusion-step |
                        isNatural(add(succ(k), b))
                        [by rewrite successor-sum the-sum-is-natural]
                    }
                  @ih-implies |
                    isNatural(add(k, b)) -> isNatural(add(succ(k), b))
                    [by discharge given-inductive-hypothesis]
                }
              @natural-implies-step |
                isNatural(k) ->
                  isNatural(add(k, b)) -> isNatural(add(succ(k), b))
                [by discharge given-k-is-natural]
            }
          @induction-step-for-all-k |
            forall k: Q;
              isNatural(k) ->
              isNatural(add(k, b)) -> isNatural(add(succ(k), b))
            [by generalize induction-step]
          @all-naturals |
            forall a: Q; isNatural(a) -> isNatural(add(a, b))
            [using instantiation rational.naturalInduction((fun t: Q => isNatural(add(t, b)))) base-case induction-step-for-all-k]
        }
      @b-natural-implies |
        isNatural(b) -> forall a: Q; isNatural(a) -> isNatural(add(a, b))
        [by discharge given-b-is-natural]
    }
  @discharge-b |
    forall b: Q;
      isNatural(b) -> forall a: Q; isNatural(a) -> isNatural(add(a, b))
    [by generalize generalize-b]

  // reorder the binders to the statement's `a, b`: fix both, specialize the b-outer form.
  @reorder |
    fix a: Q {
      @reorder-b |
        fix b: Q {
          @given-a |
            assume isNatural(a) {
              @a-natural |
                isNatural(a)
                [by hypothesis given-a]
              @given-b |
                assume isNatural(b) {
                  @b-natural |
                    isNatural(b)
                    [by hypothesis given-b]
                  @at-b |
                    forall a2: Q; isNatural(a2) -> isNatural(add(a2, b))
                    [using specialize discharge-b(b) b-natural]
                  @conclusion-sum |
                    isNatural(add(a, b))
                    [using specialize at-b(a) a-natural]
                }
              @b-implies |
                isNatural(b) -> isNatural(add(a, b))
                [by discharge given-b]
            }
          @a-implies |
            isNatural(a) -> isNatural(b) -> isNatural(add(a, b))
            [by discharge given-a]
        }
      @discharge-reorder-b |
        forall b9: Q; isNatural(a) -> isNatural(b9) -> isNatural(add(a, b9))
        [by generalize reorder-b]
    }
  @conclusion |
    forall a, b: Q; isNatural(a) -> isNatural(b) -> isNatural(add(a, b))
    [by generalize reorder]
qed

// Strategy: naturalInduction on a. Base: 0·b = 0, natural. Step: succ(a)·b = a·b + b, a sum
// of naturals by the IH and isNaturalAdd.
theorem isNaturalMul: forall a, b: Q;
  isNatural(a) -> isNatural(b) -> isNatural(rational.mul(a, b))
proof
  @generalize-b |
    fix b: Q {
      @given-b-is-natural |
        assume isNatural(b) {
          @b-is-natural |
            isNatural(b)
            [by hypothesis given-b-is-natural]
          @zero-times-b |
            rational.mul(ZERO, b) = ZERO
            [using specialize rational.mulZeroLeft(b)]
          @zero-is-natural |
            isNatural(ZERO)
            [by cite rational.isNaturalZero]
          @base-case |
            isNatural(rational.mul(ZERO, b))
            [by rewrite zero-times-b zero-is-natural]

          @induction-step |
            fix k: Q {
              @given-k-is-natural |
                assume isNatural(k) {
                  @given-inductive-hypothesis |
                    assume isNatural(rational.mul(k, b)) {
                      @inductive-hypothesis |
                        isNatural(rational.mul(k, b))
                        [by hypothesis given-inductive-hypothesis]
                      @the-sum-is-natural |
                        isNatural(add(rational.mul(k, b), b))
                        [using specialize isNaturalAdd(rational.mul(k, b), b) inductive-hypothesis b-is-natural]
                      @successor-product |
                        rational.mul(succ(k), b) = add(rational.mul(k, b), b)
                        [using specialize rational.mulSuccLeft(k, b)]
                      @conclusion-step |
                        isNatural(rational.mul(succ(k), b))
                        [by rewrite successor-product the-sum-is-natural]
                    }
                  @ih-implies |
                    isNatural(rational.mul(k, b)) -> isNatural(rational.mul(succ(k), b))
                    [by discharge given-inductive-hypothesis]
                }
              @natural-implies-step |
                isNatural(k) ->
                  isNatural(rational.mul(k, b)) -> isNatural(rational.mul(succ(k), b))
                [by discharge given-k-is-natural]
            }
          @induction-step-for-all-k |
            forall k: Q;
              isNatural(k) ->
              isNatural(rational.mul(k, b)) -> isNatural(rational.mul(succ(k), b))
            [by generalize induction-step]
          @all-naturals |
            forall a: Q; isNatural(a) -> isNatural(rational.mul(a, b))
            [using instantiation rational.naturalInduction((fun t: Q => isNatural(rational.mul(t, b)))) base-case induction-step-for-all-k]
        }
      @b-natural-implies |
        isNatural(b) -> forall a: Q; isNatural(a) -> isNatural(rational.mul(a, b))
        [by discharge given-b-is-natural]
    }
  @discharge-b |
    forall b: Q;
      isNatural(b) -> forall a: Q; isNatural(a) -> isNatural(rational.mul(a, b))
    [by generalize generalize-b]

  @reorder |
    fix a: Q {
      @reorder-b |
        fix b: Q {
          @given-a |
            assume isNatural(a) {
              @a-natural |
                isNatural(a)
                [by hypothesis given-a]
              @given-b |
                assume isNatural(b) {
                  @b-natural |
                    isNatural(b)
                    [by hypothesis given-b]
                  @at-b |
                    forall a2: Q; isNatural(a2) -> isNatural(rational.mul(a2, b))
                    [using specialize discharge-b(b) b-natural]
                  @conclusion-product |
                    isNatural(rational.mul(a, b))
                    [using specialize at-b(a) a-natural]
                }
              @b-implies |
                isNatural(b) -> isNatural(rational.mul(a, b))
                [by discharge given-b]
            }
          @a-implies |
            isNatural(a) -> isNatural(b) -> isNatural(rational.mul(a, b))
            [by discharge given-a]
        }
      @discharge-reorder-b |
        forall b9: Q; isNatural(a) -> isNatural(b9) -> isNatural(rational.mul(a, b9))
        [by generalize reorder-b]
    }
  @conclusion |
    forall a, b: Q; isNatural(a) -> isNatural(b) -> isNatural(rational.mul(a, b))
    [by generalize reorder]
qed

// -- ℤ's ORDER, TRANSFERRED ONTO THE CUT --------------------------------------------------
// With discreteness proved, ℤ's two order axioms are dischargeable on the `isInteger` cut, so
// `std/integer/order.b4m`'s whole corpus travels. `lessThanElim` IS the discreteness theorem;
// `lessThanIntro` is its converse, and follows from ℚ's order alone — a nonneg gap makes the
// endpoints ordered whether or not they are integers.

// Strategy: a + succ(d) = b with d natural. succ(d) = d + ONE is positive (d ≥ 0, 1 > 0), and
// adding a positive to a moves it up, so a < a + succ(d) = b.
// NOTE the binder order is `a, d, b` — MATCHING `std/integer/order.b4m`'s `lessThanIntro`,
// which the guarded model discharges with this theorem. A model maps a name to a name; it does
// NOT reorder binders, so a mismatch here silently rebinds the transferred axiom's arguments
// (writing `a, b, d` made `lessThanIntro(ZERO, ZERO, ONE)` bind d := ONE, b := ZERO, and every
// ℤ-order theorem transferred a false instance).
theorem aNonnegGapMakesItLess: forall a, d, b: Q;
  isNatural(d) -> add(a, succ(d)) = b -> less_than(a, b)
proof
  @generalize-a |
    fix a: Q {
      @generalize-d |
        fix d: Q {
          @generalize-b |
            fix b: Q {
              @given-d-is-natural |
                assume isNatural(d) {
                  @d-is-natural |
                    isNatural(d)
                    [by hypothesis given-d-is-natural]
                  @given-the-gap |
                    assume add(a, succ(d)) = b {
                      @the-gap |
                        add(a, succ(d)) = b
                        [by hypothesis given-the-gap]
                      // succ(d) is positive: d is zero or positive, and either way d + 1 > 0
                      @d-is-zero-or-positive |
                        d = ZERO or less_than(ZERO, d)
                        [using specialize aNaturalIsZeroOrPositive(d) d-is-natural]
                      @one-positive |
                        less_than(ZERO, ONE)
                        [using model(rational.RationalOrderedField) field_order.zeroLessThanOne]
                      @succ-is-plus-one |
                        succ(d) = add(d, ONE)
                        [using specialize rational.succDefinition(d)]
                      @the-successor-is-positive |
                        less_than(ZERO, succ(d))
                        case d-is-zero-or-positive {
                          @when-d-is-zero |
                            assume d = ZERO {
                              @d-is-zero |
                                d = ZERO
                                [by hypothesis when-d-is-zero]
                              @one-is-succ-zero |
                                ONE = succ(ZERO)
                                [by cite rational.oneIsSuccZero]
                              @the-successor-of-d |
                                succ(d) = succ(d)
                                [by reflexivity]
                              @the-successor-is-succ-zero |
                                succ(d) = succ(ZERO)
                                [by rewrite d-is-zero the-successor-of-d]
                              @the-successor-is-one |
                                succ(d) = ONE
                                [by rewrite one-is-succ-zero the-successor-is-succ-zero]
                              @conclusion-positive-at-zero |
                                less_than(ZERO, succ(d))
                                [by rewrite the-successor-is-one one-positive]
                            }
                          @when-d-is-positive |
                            assume less_than(ZERO, d) {
                              @d-is-positive |
                                less_than(ZERO, d)
                                [by hypothesis when-d-is-positive]
                              @shifting-d-up |
                                less_than(add(ZERO, ONE), add(d, ONE))
                                [using specialize rational.lessThanAddRight(ZERO, d, ONE) d-is-positive]
                              @zero-plus-one |
                                add(ZERO, ONE) = ONE
                                [using specialize rational.addZeroLeft(ONE)]
                              @one-below-the-sum |
                                less_than(ONE, add(d, ONE))
                                [by rewrite zero-plus-one shifting-d-up]
                              @zero-below-the-sum |
                                less_than(ZERO, add(d, ONE))
                                [using specialize rational.lessThanTransitive(ZERO, ONE, add(d, ONE)) one-positive one-below-the-sum]
                              @conclusion-positive-at-d |
                                less_than(ZERO, succ(d))
                                [by rewrite succ-is-plus-one zero-below-the-sum]
                            }
                        }
                      // adding a positive to a moves it up
                      @shifting-by-a |
                        less_than(add(ZERO, a), add(succ(d), a))
                        [using specialize rational.lessThanAddRight(ZERO, succ(d), a) the-successor-is-positive]
                      @zero-plus-a |
                        add(ZERO, a) = a
                        [using specialize rational.addZeroLeft(a)]
                      @a-below-the-shift |
                        less_than(a, add(succ(d), a))
                        [by rewrite zero-plus-a shifting-by-a]
                      @the-sum-commutes |
                        add(succ(d), a) = add(a, succ(d))
                        [using specialize rational.addIsCommutative(succ(d), a)]
                      @a-below-the-gap-sum |
                        less_than(a, add(a, succ(d)))
                        [by rewrite the-sum-commutes a-below-the-shift]
                      @conclusion-a-below-b |
                        less_than(a, b)
                        [by rewrite the-gap a-below-the-gap-sum]
                    }
                  @the-gap-implies-less |
                    add(a, succ(d)) = b -> less_than(a, b)
                    [by discharge given-the-gap]
                }
              @natural-implies-the-gap-orders |
                isNatural(d) -> add(a, succ(d)) = b -> less_than(a, b)
                [by discharge given-d-is-natural]
            }
          @discharge-b |
            forall b9: Q;
              isNatural(d) -> add(a, succ(d)) = b9 -> less_than(a, b9)
            [by generalize generalize-b]
        }
      @discharge-d |
        forall d9: Q; forall b: Q;
          isNatural(d9) -> add(a, succ(d9)) = b -> less_than(a, b)
        [by generalize generalize-d]
    }
  @conclusion |
    forall a, d, b: Q;
      isNatural(d) -> add(a, succ(d)) = b -> less_than(a, b)
    [by generalize generalize-a]
qed

// ONE is natural. Proved inline inside `rational.oneIsAnInteger` but never exported there,
// and the guarded model's guard search needs it by name: every ℤ-order theorem mentioning ONE
// owes `isNatural(ONE)` once `nonneg` is interpreted as `isNatural`.
theorem oneIsNatural: isNatural(ONE)
proof
  @zero-is-natural |
    isNatural(ZERO)
    [by cite rational.isNaturalZero]
  @succ-zero-is-natural |
    isNatural(succ(ZERO))
    [using specialize rational.isNaturalSucc(ZERO) zero-is-natural]
  @one-is-succ-zero |
    ONE = succ(ZERO)
    [by cite rational.oneIsSuccZero]
  @conclusion |
    isNatural(ONE)
    [by rewrite one-is-succ-zero succ-zero-is-natural]
qed

// -- ℤ's ORDER, TRANSFERRED ONTO THE CUT --------------------------------------------------
// The two theorems above are `std/integer/order.b4m`'s two axioms relativized to the cut, so a
// guarded model discharges them and ℤ's order corpus becomes available about ℚ's integers.
//
// NOTE `std/integer/order.b4m` ALIASES ℤ's base layer (`pred nonneg = nonnegatives.nonneg`,
// `func add = integer.add`, …) rather than redeclaring it, and alias-collapse means those are
// the SAME symbols. So they are mapped ONCE, under `integer.*`; naming them again under
// `int_order.*` maps one symbol through two names. Only `less_than` and the two order axioms
// are genuinely `int_order`'s own.
sort Integer = rational.Integer

model IntegerOrderOnTheCut {
  integer.Int: Integer
  integer.nonneg: isNatural
  integer.ZERO: ZERO(rational.zeroIsAnInteger)
  integer.ONE: ONE(rational.oneIsAnInteger)
  integer.succ: succ -| rational.succOfAnIntegerIsAnInteger
  integer.prev: rational.prev -| rational.prevOfAnIntegerIsAnInteger
  integer.add: add -| rational.isIntegerAdd
  integer.mul: rational.mul -| rational.isIntegerMul
  integer.neg: neg -| rational.isIntegerNeg
  integer.sub: rational.sub -| rational.isIntegerSubClosed
  integer.prevSucc <- rational.prevOfSucc
  integer.succPrev <- rational.succOfPrev
  integer.oneIsSuccZero <- rational.oneIsSuccZero
  integer.addZeroLeft <- rational.addZeroLeft
  integer.addSuccLeft <- rational.addSuccLeft
  integer.addPrevLeft <- rational.addPrevLeft
  integer.negZero <- rational.negZero
  integer.negSucc <- rational.negSucc
  integer.negPrev <- rational.negPrev
  integer.mulZeroLeft <- rational.mulZeroLeft
  integer.mulSuccLeft <- rational.mulSuccLeft
  integer.mulPrevLeft <- rational.mulPrevLeft
  integer.nonnegZero <- rational.isNaturalZero
  integer.nonnegSucc <- rational.isNaturalSucc
  integer.nonnegSuccNotZero <- rational.isNaturalSuccNotZero
  integer.intCases <- rational.integerCases
  integer.nonnegInduction <- rational.naturalInductionOnInteger
  integer.definitionOfSubtraction <- rational.subDefinition
  int_order.less_than: less_than
  int_order.lessThanIntro <- aNonnegGapMakesItLess
  int_order.lessThanElim <- theIntegersInRationalAreDiscrete

  // std/divisibility.b4m's abstract `Dividable` — std/integer/divides.b4m rests on it, and a
  // proof reaching `divides` pulls it in. Three axioms, all of which ℚ has.
  divisibility.Dividable: Integer
  divisibility.ONE: ONE(rational.oneIsAnInteger)
  divisibility.mul: rational.mul -| rational.isIntegerMul
  divisibility.add: add -| rational.isIntegerAdd
  divisibility.mulOneRight <- rational.mulOneRight
  divisibility.mulIsAssociative <- rational.mulIsAssociative
  divisibility.mulAddDistribLeft <- rational.mulAddDistribLeft

}

// NOT REACHABLE FROM HERE: `dividesOneImpliesUnit` on the cut, which Gauss's d = 1 branch
// needs. Not for want of mappings — the four layers above are all mapped — but because
// TRANSFERS CHAIN THROUGH A NESTED MODEL. `std/integer/divides.b4m` reaches
// `std/integer.b4m`'s `nonnegCases`, which is itself proved by transferring
// `peano.zeroOrSucc` through `NonNegInt` (ℕ → ℤ's `NonNeg` cut). Re-transferring anything
// citing it re-checks that INNER transfer, which maps `peano.Nat` onto a subsort of `Int` —
// so the composed chain ℕ → ℤ's NonNeg → ℚ's isInteger wants `Nat` to be both `Int` and `Q`
// at once, and the error surfaces as `std/peano.b4m:857: expected sort 'Int', got 'Q'` at
// `zeroOrSucc`'s existential binder.
//
// 2b4m re-checks an inner transfer rather than COMPOSING the two models, so a doubly guarded
// composition is not expressible today. That is a real structural limit, not a missing
// mapping.
//
// UPDATE 2026-11-01: this no longer blocks anything in chapter 17. It did block 17.13's d = 1
// branch, 17.14 and 17.15 when the note was written; all three are now proved, by going
// AROUND the limit rather than through it — 17.13 by mapping ℚ[x] onto `ring_poly` directly
// (one transfer instead of two), and 17.14/17.15 by proving the division algorithm and Bézout
// NATIVELY on the cut in `std/rational/integer-division.b4m`. The limit itself stands; see
// `drafts/chapter17-painpoints/README.md` entries 2 and 11.

// -- A POSITIVE INTEGER IS AT LEAST ONE ---------------------------------------------------
// The sharpest consequence of discreteness, and the one Gauss's d = 1 branch turns on. Proved
// DIRECTLY on the cut from ℚ's own order plus `aNonzeroNaturalIsASuccessor`, deliberately NOT
// by transferring ℤ's corresponding fact: that route runs through `integer.nonnegCases`, which
// is itself a model transfer, and 2b4m re-checks an inner transfer rather than composing the
// two models (see the note at `IntegerOrderOnTheCut`).

// Strategy: a positive integer is natural and nonzero, so it is succ(d) for a natural d; and
// succ(d) = d + 1 with d ≥ 0 gives 1 ≤ succ(d), i.e. ONE = e or ONE < e.
theorem aPositiveIntegerIsAtLeastOne: forall e: Q;
  isInteger(e) -> less_than(ZERO, e) -> (e = ONE or less_than(ONE, e))
proof
  @generalize-e |
    fix e: Q {
      @given-e-is-an-integer |
        assume isInteger(e) {
          @e-is-an-integer |
            isInteger(e)
            [by hypothesis given-e-is-an-integer]
          @given-e-is-positive |
            assume less_than(ZERO, e) {
              @e-is-positive |
                less_than(ZERO, e)
                [by hypothesis given-e-is-positive]
              @e-is-natural |
                isNatural(e)
                [using specialize aPositiveIntegerIsNatural(e) e-is-an-integer e-is-positive]
              @e-is-nonzero |
                not (e = ZERO)
                [using specialize aPositiveIsNonzero(e) e-is-positive]
              @e-is-a-successor |
                exists d: Q; isNatural(d) and e = succ(d)
                [using specialize aNonzeroNaturalIsASuccessor(e) e-is-natural e-is-nonzero]
              @the-predecessor |
                unpack d: Q from e-is-a-successor {
                  @with-predecessor-d |
                    isNatural(d) and e = succ(d)
                    [by hypothesis the-predecessor]
                  @d-is-natural |
                    isNatural(d)
                    [by and_lhs with-predecessor-d]
                  @e-is-succ-d |
                    e = succ(d)
                    [by and_rhs with-predecessor-d]
                  @succ-is-plus-one |
                    succ(d) = add(d, ONE)
                    [using specialize rational.succDefinition(d)]
                  @d-is-zero-or-positive |
                    d = ZERO or less_than(ZERO, d)
                    [using specialize aNaturalIsZeroOrPositive(d) d-is-natural]
                  @conclusion-at-least-one |
                    e = ONE or less_than(ONE, e)
                    case d-is-zero-or-positive {
                      // d = 0: e = succ(0) = 1
                      @when-d-is-zero |
                        assume d = ZERO {
                          @d-is-zero |
                            d = ZERO
                            [by hypothesis when-d-is-zero]
                          @one-is-succ-zero |
                            ONE = succ(ZERO)
                            [by cite rational.oneIsSuccZero]
                          @succ-d-is-succ-d |
                            succ(d) = succ(d)
                            [by reflexivity]
                          @succ-d-is-succ-zero |
                            succ(d) = succ(ZERO)
                            [by rewrite d-is-zero succ-d-is-succ-d]
                          @succ-d-is-one |
                            succ(d) = ONE
                            [by rewrite one-is-succ-zero succ-d-is-succ-zero]
                          @e-is-one |
                            e = ONE
                            [using simplify e-is-succ-d succ-d-is-one]
                          @conclusion-equals-one |
                            e = ONE or less_than(ONE, e)
                            [by either_left e-is-one]
                        }
                      // d > 0: 1 = 0 + 1 < d + 1 = succ(d) = e
                      @when-d-is-positive |
                        assume less_than(ZERO, d) {
                          @d-is-positive |
                            less_than(ZERO, d)
                            [by hypothesis when-d-is-positive]
                          @shifting-d-up |
                            less_than(add(ZERO, ONE), add(d, ONE))
                            [using specialize rational.lessThanAddRight(ZERO, d, ONE) d-is-positive]
                          @zero-plus-one |
                            add(ZERO, ONE) = ONE
                            [using specialize rational.addZeroLeft(ONE)]
                          @one-below-the-sum |
                            less_than(ONE, add(d, ONE))
                            [by rewrite zero-plus-one shifting-d-up]
                          @one-below-succ-d |
                            less_than(ONE, succ(d))
                            [by rewrite succ-is-plus-one one-below-the-sum]
                          @one-below-e |
                            less_than(ONE, e)
                            [by rewrite e-is-succ-d one-below-succ-d]
                          @conclusion-above-one |
                            e = ONE or less_than(ONE, e)
                            [by either_right one-below-e]
                        }
                    }
                }
              @conclusion-the-bound |
                e = ONE or less_than(ONE, e)
                [by unpacked the-predecessor]
            }
          @positive-implies-at-least-one |
            less_than(ZERO, e) -> (e = ONE or less_than(ONE, e))
            [by discharge given-e-is-positive]
        }
      @integer-implies-the-bound |
        isInteger(e) -> less_than(ZERO, e) -> (e = ONE or less_than(ONE, e))
        [by discharge given-e-is-an-integer]
    }
  @conclusion |
    forall e: Q;
      isInteger(e) -> less_than(ZERO, e) -> (e = ONE or less_than(ONE, e))
    [by generalize generalize-e]
qed

// -- A POSITIVE INTEGER DIVIDING ONE IS ONE -----------------------------------------------
// Judson's `c a_m b_n = 1` step, in the positive case. Both factors are at least ONE; if
// either exceeded ONE the product would too (`productAboveOne`, which transfers through ℚ's
// UNGUARDED ordered-field model — no cut composition involved), contradicting e·k = 1.

// Strategy: e and k are both ≥ ONE. If e = ONE we are done. Otherwise ONE < e, and then
// k = ONE forces e = e·ONE = e·k = ONE (contradiction), while ONE < k makes ONE < e·k = ONE.
theorem aPositiveIntegerDividingOneIsOne: forall e, k: Q;
  isInteger(e) -> isInteger(k) ->
  less_than(ZERO, e) -> less_than(ZERO, k) ->
  ONE = rational.mul(e, k) -> e = ONE
proof
  @generalize-e |
    fix e: Q {
      @generalize-k |
        fix k: Q {
          @given-e-is-an-integer |
            assume isInteger(e) {
              @e-is-an-integer |
                isInteger(e)
                [by hypothesis given-e-is-an-integer]
              @given-k-is-an-integer |
                assume isInteger(k) {
                  @k-is-an-integer |
                    isInteger(k)
                    [by hypothesis given-k-is-an-integer]
                  @given-e-positive |
                    assume less_than(ZERO, e) {
                      @e-positive |
                        less_than(ZERO, e)
                        [by hypothesis given-e-positive]
                      @given-k-positive |
                        assume less_than(ZERO, k) {
                          @k-positive |
                            less_than(ZERO, k)
                            [by hypothesis given-k-positive]
                          @given-the-product-is-one |
                            assume ONE = rational.mul(e, k) {
                              @the-product-is-one |
                                ONE = rational.mul(e, k)
                                [by hypothesis given-the-product-is-one]
                              @e-at-least-one |
                                e = ONE or less_than(ONE, e)
                                [using specialize aPositiveIntegerIsAtLeastOne(e) e-is-an-integer e-positive]
                              @k-at-least-one |
                                k = ONE or less_than(ONE, k)
                                [using specialize aPositiveIntegerIsAtLeastOne(k) k-is-an-integer k-positive]
                              @conclusion-e-is-one |
                                e = ONE
                                case e-at-least-one {
                                  @when-e-is-one |
                                    assume e = ONE {
                                      @e-is-one |
                                        e = ONE
                                        [by hypothesis when-e-is-one]
                                    }
                                  @when-e-above-one |
                                    assume less_than(ONE, e) {
                                      @e-above-one |
                                        less_than(ONE, e)
                                        [by hypothesis when-e-above-one]
                                      @conclusion-contradiction |
                                        e = ONE
                                        case k-at-least-one {
                                          // k = 1: then e·k = e·1 = e, so 1 = e, contradicting 1 < e
                                          @when-k-is-one |
                                            assume k = ONE {
                                              @k-is-one |
                                                k = ONE
                                                [by hypothesis when-k-is-one]
                                              @e-times-one |
                                                rational.mul(e, ONE) = e
                                                [using specialize rational.mulOneRight(e)]
                                              @the-product-at-k-one |
                                                ONE = rational.mul(e, ONE)
                                                [by rewrite k-is-one the-product-is-one]
                                              @one-is-e |
                                                ONE = e
                                                [by rewrite e-times-one the-product-at-k-one]
                                              @conclusion-e-is-one-here |
                                                e = ONE
                                                [by symmetry one-is-e]
                                            }
                                          // 1 < k: then 1 < e·k = 1, impossible
                                          @when-k-above-one |
                                            assume less_than(ONE, k) {
                                              @k-above-one |
                                                less_than(ONE, k)
                                                [by hypothesis when-k-above-one]
                                              @products-above-one |
                                                forall a, b: Q;
                                                  less_than(ONE, a) -> less_than(ONE, b) ->
                                                  less_than(ONE, rational.mul(a, b))
                                                [using model(rational.RationalOrderedField) field_order.productAboveOne]
                                              @the-product-above-one |
                                                less_than(ONE, rational.mul(e, k))
                                                [using specialize products-above-one(e, k) e-above-one k-above-one]
                                              @one-below-one |
                                                less_than(ONE, ONE)
                                                [by rewrite the-product-is-one the-product-above-one]
                                              @one-not-below-itself |
                                                not less_than(ONE, ONE)
                                                [using specialize rational.lessThanIrreflexive(ONE)]
                                              @conclusion-vacuous |
                                                e = ONE
                                                [by ex_falso one-below-one one-not-below-itself]
                                            }
                                        }
                                    }
                                }
                            }
                          @product-one-implies-e-one |
                            ONE = rational.mul(e, k) -> e = ONE
                            [by discharge given-the-product-is-one]
                        }
                      @k-positive-implies |
                        less_than(ZERO, k) -> ONE = rational.mul(e, k) -> e = ONE
                        [by discharge given-k-positive]
                    }
                  @e-positive-implies |
                    less_than(ZERO, e) -> less_than(ZERO, k) ->
                      ONE = rational.mul(e, k) -> e = ONE
                    [by discharge given-e-positive]
                }
              @k-integer-implies |
                isInteger(k) -> less_than(ZERO, e) -> less_than(ZERO, k) ->
                  ONE = rational.mul(e, k) -> e = ONE
                [by discharge given-k-is-an-integer]
            }
          @e-integer-implies |
            isInteger(e) -> isInteger(k) ->
              less_than(ZERO, e) -> less_than(ZERO, k) ->
              ONE = rational.mul(e, k) -> e = ONE
            [by discharge given-e-is-an-integer]
        }
      @discharge-k |
        forall k9: Q;
          isInteger(e) -> isInteger(k9) ->
          less_than(ZERO, e) -> less_than(ZERO, k9) ->
          ONE = rational.mul(e, k9) -> e = ONE
        [by generalize generalize-k]
    }
  @conclusion |
    forall e, k: Q;
      isInteger(e) -> isInteger(k) ->
      less_than(ZERO, e) -> less_than(ZERO, k) ->
      ONE = rational.mul(e, k) -> e = ONE
    [by generalize generalize-e]
qed

// If e > 0 and e·k = 1 then k > 0: a positive times a non-positive cannot be ONE.
// Strategy: trichotomy on k. k = 0 gives e·0 = 0 ≠ 1. k < 0 makes e·k < 0, and 0 < 1, so
// e·k = 1 would put ONE below ZERO.
theorem theCofactorIsPositive: forall e, k: Q;
  less_than(ZERO, e) -> ONE = rational.mul(e, k) -> less_than(ZERO, k)
proof
  @generalize-e |
    fix e: Q {
      @generalize-k |
        fix k: Q {
          @given-e-positive |
            assume less_than(ZERO, e) {
              @e-positive |
                less_than(ZERO, e)
                [by hypothesis given-e-positive]
              @given-the-product-is-one |
                assume ONE = rational.mul(e, k) {
                  @the-product-is-one |
                    ONE = rational.mul(e, k)
                    [by hypothesis given-the-product-is-one]
                  @one-positive |
                    less_than(ZERO, ONE)
                    [using model(rational.RationalOrderedField) field_order.zeroLessThanOne]
                  @the-product-positive |
                    less_than(ZERO, rational.mul(e, k))
                    [by rewrite the-product-is-one one-positive]
                  @the-sign-cases |
                    less_than(k, ZERO) or k = ZERO or less_than(ZERO, k)
                    [using specialize rational.lessThanTrichotomy(k, ZERO)]
                  @conclusion-k-positive |
                    less_than(ZERO, k)
                    case the-sign-cases {
                      @when-k-negative-or-zero |
                        assume less_than(k, ZERO) or k = ZERO {
                          @k-negative-or-zero |
                            less_than(k, ZERO) or k = ZERO
                            [by hypothesis when-k-negative-or-zero]
                          @conclusion-nonpositive |
                            less_than(ZERO, k)
                            case k-negative-or-zero {
                              @when-k-negative |
                                assume less_than(k, ZERO) {
                                  @k-negative |
                                    less_than(k, ZERO)
                                    [by hypothesis when-k-negative]
                                  // 0 < e and k < 0 give e·k < 0, contradicting 0 < e·k
                                  @scaling-k |
                                    forall a, b, c: Q;
                                      less_than(a, b) -> less_than(ZERO, c) ->
                                      less_than(rational.mul(a, c), rational.mul(b, c))
                                    [using model(rational.RationalOrderedField) field_order.lessThanMulPositiveRight]
                                  @k-times-e-below-zero-times-e |
                                    less_than(rational.mul(k, e), rational.mul(ZERO, e))
                                    [using specialize scaling-k(k, ZERO, e) k-negative e-positive]
                                  @zero-times-e |
                                    rational.mul(ZERO, e) = ZERO
                                    [using specialize rational.mulZeroLeft(e)]
                                  @k-times-e-negative |
                                    less_than(rational.mul(k, e), ZERO)
                                    [by rewrite zero-times-e k-times-e-below-zero-times-e]
                                  @the-product-commutes |
                                    rational.mul(k, e) = rational.mul(e, k)
                                    [using specialize rational.mulIsCommutative(k, e)]
                                  @the-product-negative |
                                    less_than(rational.mul(e, k), ZERO)
                                    [by rewrite the-product-commutes k-times-e-negative]
                                  @order-is-asymmetric |
                                    forall a, b: Q; less_than(a, b) -> (not less_than(b, a))
                                    [using model(rational.RationalOrderedField) field_order.lessThanAsymmetric]
                                  @not-both |
                                    not less_than(ZERO, rational.mul(e, k))
                                    [using specialize order-is-asymmetric(rational.mul(e, k), ZERO) the-product-negative]
                                  @conclusion-vacuous-negative |
                                    less_than(ZERO, k)
                                    [by ex_falso the-product-positive not-both]
                                }
                              @when-k-zero |
                                assume k = ZERO {
                                  @k-zero |
                                    k = ZERO
                                    [by hypothesis when-k-zero]
                                  @e-times-zero |
                                    rational.mul(e, ZERO) = ZERO
                                    [using specialize rational.mulZeroRight(e)]
                                  @the-product-at-zero |
                                    less_than(ZERO, rational.mul(e, ZERO))
                                    [by rewrite k-zero the-product-positive]
                                  @zero-below-zero |
                                    less_than(ZERO, ZERO)
                                    [by rewrite e-times-zero the-product-at-zero]
                                  @zero-not-below-itself |
                                    not less_than(ZERO, ZERO)
                                    [using specialize rational.lessThanIrreflexive(ZERO)]
                                  @conclusion-vacuous-zero |
                                    less_than(ZERO, k)
                                    [by ex_falso zero-below-zero zero-not-below-itself]
                                }
                            }
                        }
                      @when-k-positive |
                        assume less_than(ZERO, k) {
                          @k-positive |
                            less_than(ZERO, k)
                            [by hypothesis when-k-positive]
                        }
                    }
                }
              @product-implies-k-positive |
                ONE = rational.mul(e, k) -> less_than(ZERO, k)
                [by discharge given-the-product-is-one]
            }
          @e-positive-implies |
            less_than(ZERO, e) -> ONE = rational.mul(e, k) -> less_than(ZERO, k)
            [by discharge given-e-positive]
        }
      @discharge-k |
        forall k9: Q;
          less_than(ZERO, e) -> ONE = rational.mul(e, k9) -> less_than(ZERO, k9)
        [by generalize generalize-k]
    }
  @conclusion |
    forall e, k: Q;
      less_than(ZERO, e) -> ONE = rational.mul(e, k) -> less_than(ZERO, k)
    [by generalize generalize-e]
qed

// e < 0 with e·k = 1: then -e > 0 and (-e)·(-k) = e·k = 1, so -e = 1 by the positive case,
// hence e = -1.
// Strategy: negate both factors, apply the positive case to (-e, -k), then undo the negation.
theorem theNegativeCase: forall e, k: Q;
  isInteger(e) -> isInteger(k) -> less_than(e, ZERO) ->
  ONE = rational.mul(e, k) -> (e = ONE or e = neg(ONE))
proof
  @generalize-e |
    fix e: Q {
      @generalize-k |
        fix k: Q {
          @given-e-is-an-integer |
            assume isInteger(e) {
              @e-is-an-integer |
                isInteger(e)
                [by hypothesis given-e-is-an-integer]
              @given-k-is-an-integer |
                assume isInteger(k) {
                  @k-is-an-integer |
                    isInteger(k)
                    [by hypothesis given-k-is-an-integer]
                  @given-e-negative |
                    assume less_than(e, ZERO) {
                      @e-negative |
                        less_than(e, ZERO)
                        [by hypothesis given-e-negative]
                      @given-the-product-is-one |
                        assume ONE = rational.mul(e, k) {
                          @the-product-is-one |
                            ONE = rational.mul(e, k)
                            [by hypothesis given-the-product-is-one]
                          // -e is a positive integer
                          @negatives-of-negatives |
                            forall x: Q; less_than(x, ZERO) -> less_than(ZERO, neg(x))
                            [using model(rational.RationalOrderedField) field_order.negOfNegativeIsPositive]
                          @minus-e-positive |
                            less_than(ZERO, neg(e))
                            [using specialize negatives-of-negatives(e) e-negative]
                          @minus-e-is-an-integer |
                            isInteger(neg(e))
                            [using specialize rational.isIntegerNeg(e) e-is-an-integer]
                          @minus-k-is-an-integer |
                            isInteger(neg(k))
                            [using specialize rational.isIntegerNeg(k) k-is-an-integer]
                          // (-e)·(-k) = e·k = 1
                          @the-negated-product |
                            forall a, b: Q;
                              rational.mul(neg(a), neg(b)) = rational.mul(a, b)
                            [using model(rational.RationalOrderedField) field_order.negMulNeg]
                          @negated-product-at-e-k |
                            rational.mul(neg(e), neg(k)) = rational.mul(e, k)
                            [using specialize the-negated-product(e, k)]
                          @the-negated-product-is-one |
                            ONE = rational.mul(neg(e), neg(k))
                            [by rewrite negated-product-at-e-k the-product-is-one]
                          // so -k is positive too, and the positive case gives -e = 1
                          @minus-k-positive |
                            less_than(ZERO, neg(k))
                            [using specialize theCofactorIsPositive(neg(e), neg(k)) minus-e-positive the-negated-product-is-one]
                          @minus-e-is-one |
                            neg(e) = ONE
                            [using specialize aPositiveIntegerDividingOneIsOne(neg(e), neg(k)) minus-e-is-an-integer minus-k-is-an-integer minus-e-positive minus-k-positive the-negated-product-is-one]
                          // hence e = -1
                          @double-negation |
                            forall x: Q; neg(neg(x)) = x
                            [using model(rational.RationalOrderedField) field_order.negNeg]
                          @neg-neg-e |
                            neg(neg(e)) = e
                            [using specialize double-negation(e)]
                          @neg-one-is-e |
                            neg(ONE) = e
                            [by rewrite minus-e-is-one neg-neg-e]
                          @e-is-neg-one |
                            e = neg(ONE)
                            [by symmetry neg-one-is-e]
                          @conclusion-e-is-minus-one |
                            e = ONE or e = neg(ONE)
                            [by either_right e-is-neg-one]
                        }
                      @product-implies-unit |
                        ONE = rational.mul(e, k) -> (e = ONE or e = neg(ONE))
                        [by discharge given-the-product-is-one]
                    }
                  @e-negative-implies |
                    less_than(e, ZERO) -> ONE = rational.mul(e, k) ->
                      (e = ONE or e = neg(ONE))
                    [by discharge given-e-negative]
                }
              @k-integer-implies |
                isInteger(k) -> less_than(e, ZERO) -> ONE = rational.mul(e, k) ->
                  (e = ONE or e = neg(ONE))
                [by discharge given-k-is-an-integer]
            }
          @e-integer-implies |
            isInteger(e) -> isInteger(k) -> less_than(e, ZERO) ->
              ONE = rational.mul(e, k) -> (e = ONE or e = neg(ONE))
            [by discharge given-e-is-an-integer]
        }
      @discharge-k |
        forall k9: Q;
          isInteger(e) -> isInteger(k9) -> less_than(e, ZERO) ->
          ONE = rational.mul(e, k9) -> (e = ONE or e = neg(ONE))
        [by generalize generalize-k]
    }
  @conclusion |
    forall e, k: Q;
      isInteger(e) -> isInteger(k) -> less_than(e, ZERO) ->
      ONE = rational.mul(e, k) -> (e = ONE or e = neg(ONE))
    [by generalize generalize-e]
qed

// -- AN INTEGER DIVIDING ONE IS A UNIT ----------------------------------------------------
// `std/integer/divides.b4m`'s `dividesOneImpliesUnit`, on ℚ's cut: AATA 17.13's "either c = 1
// or c = -1". Reproved here rather than transferred, because the ℤ proof routes through
// `integer.nonnegCases` — itself a model transfer — and a nested transfer cannot compose (see
// the note at `IntegerOrderOnTheCut`).
//
// Judson needs this for `c a_m b_n = 1`: with p(x) monic the leading coefficients multiply to
// 1 in ℤ, so c is a unit and the monic integer factors follow.

// Strategy: trichotomy on e. e = 0 contradicts 0·k = 0 ≠ 1. e > 0 is the positive case. For
// e < 0 both e and k are negative, so (-e)·(-k) = e·k = 1 with both positive, giving -e = 1.
theorem anIntegerDividingOneIsAUnit: forall e, k: Q;
  isInteger(e) -> isInteger(k) -> ONE = rational.mul(e, k) ->
  (e = ONE or e = neg(ONE))
proof
  @generalize-e |
    fix e: Q {
      @generalize-k |
        fix k: Q {
          @given-e-is-an-integer |
            assume isInteger(e) {
              @e-is-an-integer |
                isInteger(e)
                [by hypothesis given-e-is-an-integer]
              @given-k-is-an-integer |
                assume isInteger(k) {
                  @k-is-an-integer |
                    isInteger(k)
                    [by hypothesis given-k-is-an-integer]
                  @given-the-product-is-one |
                    assume ONE = rational.mul(e, k) {
                      @the-product-is-one |
                        ONE = rational.mul(e, k)
                        [by hypothesis given-the-product-is-one]
                      @one-not-zero |
                        not (ONE = ZERO)
                        [by cite rational.oneNotZero]
                      @the-sign-cases |
                        less_than(e, ZERO) or e = ZERO or less_than(ZERO, e)
                        [using specialize rational.lessThanTrichotomy(e, ZERO)]
                      @conclusion-e-is-a-unit |
                        e = ONE or e = neg(ONE)
                        case the-sign-cases {
                          // trichotomy parses as `(e < 0 or e = 0) or 0 < e` — `or` is
                          // LEFT-associative, so the first arm carries two cases.
                          @when-e-not-positive |
                            assume less_than(e, ZERO) or e = ZERO {
                              @e-not-positive |
                                less_than(e, ZERO) or e = ZERO
                                [by hypothesis when-e-not-positive]
                              @conclusion-nonpositive-case |
                                e = ONE or e = neg(ONE)
                                case e-not-positive {
                                  // e < 0: the negatives multiply to the same product
                                  @when-e-negative |
                                    assume less_than(e, ZERO) {
                                      @e-negative |
                                        less_than(e, ZERO)
                                        [by hypothesis when-e-negative]
                                      @conclusion-negative-case |
                                        e = ONE or e = neg(ONE)
                                        [using specialize theNegativeCase(e, k) e-is-an-integer k-is-an-integer e-negative the-product-is-one]
                                    }
                                  // e = 0: 1 = 0·k = 0, impossible
                                  @when-e-zero |
                                    assume e = ZERO {
                                      @e-zero |
                                        e = ZERO
                                        [by hypothesis when-e-zero]
                                      @zero-times-k |
                                        rational.mul(ZERO, k) = ZERO
                                        [using specialize rational.mulZeroLeft(k)]
                                      @the-product-at-zero |
                                        ONE = rational.mul(ZERO, k)
                                        [by rewrite e-zero the-product-is-one]
                                      @one-is-zero |
                                        ONE = ZERO
                                        [by rewrite zero-times-k the-product-at-zero]
                                      @conclusion-vacuous-at-zero |
                                        e = ONE or e = neg(ONE)
                                        [by ex_falso one-is-zero one-not-zero]
                                    }
                                }
                            }
                          // e > 0: k > 0 too, and the positive case applies
                          @when-e-positive |
                            assume less_than(ZERO, e) {
                              @e-positive |
                                less_than(ZERO, e)
                                [by hypothesis when-e-positive]
                              @k-positive |
                                less_than(ZERO, k)
                                [using specialize theCofactorIsPositive(e, k) e-positive the-product-is-one]
                              @e-is-one |
                                e = ONE
                                [using specialize aPositiveIntegerDividingOneIsOne(e, k) e-is-an-integer k-is-an-integer e-positive k-positive the-product-is-one]
                              @conclusion-positive-case |
                                e = ONE or e = neg(ONE)
                                [by either_left e-is-one]
                            }
                        }
                    }
                  @product-one-implies-unit |
                    ONE = rational.mul(e, k) -> (e = ONE or e = neg(ONE))
                    [by discharge given-the-product-is-one]
                }
              @k-integer-implies |
                isInteger(k) -> ONE = rational.mul(e, k) ->
                  (e = ONE or e = neg(ONE))
                [by discharge given-k-is-an-integer]
            }
          @e-integer-implies |
            isInteger(e) -> isInteger(k) -> ONE = rational.mul(e, k) ->
              (e = ONE or e = neg(ONE))
            [by discharge given-e-is-an-integer]
        }
      @discharge-k |
        forall k9: Q;
          isInteger(e) -> isInteger(k9) -> ONE = rational.mul(e, k9) ->
          (e = ONE or e = neg(ONE))
        [by generalize generalize-k]
    }
  @conclusion |
    forall e, k: Q;
      isInteger(e) -> isInteger(k) -> ONE = rational.mul(e, k) ->
      (e = ONE or e = neg(ONE))
    [by generalize generalize-e]
qed

// -- two order facts the well-ordering file needs -----------------------------------------

// n < succ(n): the gap is ZERO, and `aNonnegGapMakesItLess` wants `a + succ(d) = b`, i.e.
// n + succ(ZERO) = succ(n) — which is `succ(n) = n + ONE` with ONE = succ(ZERO).
theorem aNaturalIsBelowItsSuccessor: forall n: Q;
  less_than(n, succ(n))
proof
  @generalize-n |
    fix n: Q {
      @zero-is-natural |
        isNatural(ZERO)
        [by cite rational.isNaturalZero]
      @succ-is-plus-one |
        succ(n) = add(n, ONE)
        [using specialize rational.succDefinition(n)]
      @one-is-succ-zero |
        ONE = succ(ZERO)
        [by cite rational.oneIsSuccZero]
      @succ-is-plus-succ-zero |
        succ(n) = add(n, succ(ZERO))
        [by rewrite one-is-succ-zero succ-is-plus-one]
      @the-gap-equation |
        add(n, succ(ZERO)) = succ(n)
        [by symmetry succ-is-plus-succ-zero]
      @conclusion-below-its-successor |
        less_than(n, succ(n))
        [using specialize aNonnegGapMakesItLess(n, ZERO, succ(n)) zero-is-natural the-gap-equation]
    }
  @conclusion |
    forall n: Q; less_than(n, succ(n))
    [by generalize generalize-n]
qed

// Nothing sits strictly between a natural and its successor: m < succ(k) splits as m < k or
// m = k. The discreteness gap, read at a successor — ℚ's order alone cannot say it.
//
// Strategy: m < succ(k) gives a natural gap d with m + succ(d) = succ(k). If d = ZERO then
// m + ONE = k + ONE, so m = k; otherwise d = succ(e) and m + succ(e) = k, putting m below k.
theorem theNaturalSuccSplit: forall m, k: Q;
  isNatural(m) -> isNatural(k) -> less_than(m, succ(k)) ->
  (less_than(m, k) or m = k)
proof
  @generalize-m |
    fix m: Q {
      @generalize-k |
        fix k: Q {
          @given-m-is-natural |
            assume isNatural(m) {
              @m-is-natural |
                isNatural(m)
                [by hypothesis given-m-is-natural]
              @m-is-an-integer |
                isInteger(m)
                [using specialize rational.isNaturalIsInteger(m) m-is-natural]
              @given-k-is-natural |
                assume isNatural(k) {
                  @k-is-natural |
                    isNatural(k)
                    [by hypothesis given-k-is-natural]
                  @succ-k-is-natural |
                    isNatural(succ(k))
                    [using specialize rational.isNaturalSucc(k) k-is-natural]
                  @succ-k-is-an-integer |
                    isInteger(succ(k))
                    [using specialize rational.isNaturalIsInteger(succ(k)) succ-k-is-natural]
                  @given-m-below-succ-k |
                    assume less_than(m, succ(k)) {
                      @m-below-succ-k |
                        less_than(m, succ(k))
                        [by hypothesis given-m-below-succ-k]
                      @the-gap |
                        exists d: Q; isInteger(d) and
                          (isNatural(d) and add(m, succ(d)) = succ(k))
                        [using specialize theIntegersInRationalAreDiscrete(m, succ(k)) m-is-an-integer succ-k-is-an-integer m-below-succ-k]
                      @with-the-gap |
                        unpack d: Q from the-gap {
                          @with-gap-d |
                            isInteger(d) and
                              (isNatural(d) and add(m, succ(d)) = succ(k))
                            [by hypothesis with-the-gap]
                          @the-natural-gap |
                            isNatural(d) and add(m, succ(d)) = succ(k)
                            [by and_rhs with-gap-d]
                          @d-is-natural |
                            isNatural(d)
                            [by and_lhs the-natural-gap]
                          @the-gap-equation |
                            add(m, succ(d)) = succ(k)
                            [by and_rhs the-natural-gap]
                          @d-is-zero-or-positive |
                            d = ZERO or less_than(ZERO, d)
                            [using specialize aNaturalIsZeroOrPositive(d) d-is-natural]
                          @conclusion-the-split |
                            less_than(m, k) or m = k
                            case d-is-zero-or-positive {
                              // d = 0: m + 1 = k + 1, so m = k
                              @when-d-is-zero |
                                assume d = ZERO {
                                  @d-is-zero |
                                    d = ZERO
                                    [by hypothesis when-d-is-zero]
                                  @the-equation-at-zero |
                                    add(m, succ(ZERO)) = succ(k)
                                    [by rewrite d-is-zero the-gap-equation]
                                  @one-is-succ-zero |
                                    ONE = succ(ZERO)
                                    [by cite rational.oneIsSuccZero]
                                  @m-plus-one |
                                    add(m, ONE) = succ(k)
                                    [by rewrite one-is-succ-zero the-equation-at-zero]
                                  @succ-m-is-plus-one |
                                    succ(m) = add(m, ONE)
                                    [using specialize rational.succDefinition(m)]
                                  @succ-m-is-succ-k |
                                    succ(m) = succ(k)
                                    [using simplify succ-m-is-plus-one m-plus-one]
                                  @m-is-k |
                                    m = k
                                    [using specialize rational.succInjective(m, k) succ-m-is-succ-k]
                                  @conclusion-equal |
                                    less_than(m, k) or m = k
                                    [by either_right m-is-k]
                                }
                              // d > 0: d is a nonzero natural, so d = succ(e), and
                              // m + succ(e) = k puts m below k
                              @when-d-is-positive |
                                assume less_than(ZERO, d) {
                                  @d-is-positive |
                                    less_than(ZERO, d)
                                    [by hypothesis when-d-is-positive]
                                  @d-is-nonzero |
                                    not (d = ZERO)
                                    [using specialize aPositiveIsNonzero(d) d-is-positive]
                                  @d-is-a-successor |
                                    exists e: Q; isNatural(e) and d = succ(e)
                                    [using specialize aNonzeroNaturalIsASuccessor(d) d-is-natural d-is-nonzero]
                                  @with-the-predecessor |
                                    unpack e: Q from d-is-a-successor {
                                      @with-predecessor-e |
                                        isNatural(e) and d = succ(e)
                                        [by hypothesis with-the-predecessor]
                                      @e-is-natural |
                                        isNatural(e)
                                        [by and_lhs with-predecessor-e]
                                      @d-is-succ-e |
                                        d = succ(e)
                                        [by and_rhs with-predecessor-e]
                                      // m + succ(succ e) = succ k, so m + succ e = k
                                      @the-equation-at-succ-e |
                                        add(m, succ(succ(e))) = succ(k)
                                        [by rewrite d-is-succ-e the-gap-equation]
                                      // ℚ has addSuccLeft only, so commute both sides
                                      @commute-outer |
                                        add(m, succ(succ(e))) =
                                          add(succ(succ(e)), m)
                                        [using specialize rational.addIsCommutative(m, succ(succ(e)))]
                                      @push-left |
                                        add(succ(succ(e)), m) =
                                          succ(add(succ(e), m))
                                        [using specialize rational.addSuccLeft(succ(e), m)]
                                      @commute-inner |
                                        add(succ(e), m) = add(m, succ(e))
                                        [using specialize rational.addIsCommutative(succ(e), m)]
                                      @push-left-commuted |
                                        add(succ(succ(e)), m) =
                                          succ(add(m, succ(e)))
                                        [by rewrite commute-inner push-left]
                                      @pushing-succ-out |
                                        add(m, succ(succ(e))) = succ(add(m, succ(e)))
                                        [by rewrite commute-outer push-left-commuted]
                                      @pushing-succ-out-flipped |
                                        succ(add(m, succ(e))) =
                                          add(m, succ(succ(e)))
                                        [by symmetry pushing-succ-out]
                                      @succ-of-the-sum |
                                        succ(add(m, succ(e))) = succ(k)
                                        [by rewrite pushing-succ-out-flipped the-equation-at-succ-e]
                                      @the-sum-is-k |
                                        add(m, succ(e)) = k
                                        [using specialize rational.succInjective(add(m, succ(e)), k) succ-of-the-sum]
                                      @m-below-k |
                                        less_than(m, k)
                                        [using specialize aNonnegGapMakesItLess(m, e, k) e-is-natural the-sum-is-k]
                                      @conclusion-below |
                                        less_than(m, k) or m = k
                                        [by either_left m-below-k]
                                    }
                                  @conclusion-positive-exported |
                                    less_than(m, k) or m = k
                                    [by unpacked with-the-predecessor]
                                }
                            }
                        }
                      @conclusion-split-exported |
                        less_than(m, k) or m = k
                        [by unpacked with-the-gap]
                    }
                  @below-succ-k-implies |
                    less_than(m, succ(k)) -> (less_than(m, k) or m = k)
                    [by discharge given-m-below-succ-k]
                }
              @k-natural-implies |
                isNatural(k) -> less_than(m, succ(k)) ->
                  (less_than(m, k) or m = k)
                [by discharge given-k-is-natural]
            }
          @m-natural-implies |
            isNatural(m) -> isNatural(k) -> less_than(m, succ(k)) ->
              (less_than(m, k) or m = k)
            [by discharge given-m-is-natural]
        }
      @discharge-k |
        forall k9: Q;
          isNatural(m) -> isNatural(k9) -> less_than(m, succ(k9)) ->
          (less_than(m, k9) or m = k9)
        [by generalize generalize-k]
    }
  @conclusion |
    forall m, k: Q;
      isNatural(m) -> isNatural(k) -> less_than(m, succ(k)) ->
      (less_than(m, k) or m = k)
    [by generalize generalize-m]
qed

// -- A PROPER FACTOR SHRINKS THE QUOTIENT --------------------------------------------------
// If a = e·q with a positive and e not a unit (so e > 1, taking e positive), then q < a. This
// is the descent any "greatest common divisor exists" argument runs on: dividing by a
// non-unit strictly decreases the quotient, so well-ordering terminates.

// Strategy: a = e·q with e > 1 and q > 0. Then a = e·q > 1·q = q, by scaling q > 0 up by
// e > 1 — `lessThanMulPositiveRight` at (ONE, e, q).
theorem aProperFactorShrinksTheQuotient: forall a, e, q: Q;
  less_than(ONE, e) -> less_than(ZERO, q) -> a = rational.mul(e, q) ->
  less_than(q, a)
proof
  @generalize-a |
    fix a: Q {
      @generalize-e |
        fix e: Q {
          @generalize-q |
            fix q: Q {
              @given-e-above-one |
                assume less_than(ONE, e) {
                  @e-above-one |
                    less_than(ONE, e)
                    [by hypothesis given-e-above-one]
                  @given-q-positive |
                    assume less_than(ZERO, q) {
                      @q-positive |
                        less_than(ZERO, q)
                        [by hypothesis given-q-positive]
                      @given-the-factorization |
                        assume a = rational.mul(e, q) {
                          @the-factorization |
                            a = rational.mul(e, q)
                            [by hypothesis given-the-factorization]
                          @scaling-up |
                            forall x, y, z: Q;
                              less_than(x, y) -> less_than(ZERO, z) ->
                              less_than(rational.mul(x, z), rational.mul(y, z))
                            [using model(rational.RationalOrderedField) field_order.lessThanMulPositiveRight]
                          @one-times-q-below-e-times-q |
                            less_than(rational.mul(ONE, q), rational.mul(e, q))
                            [using specialize scaling-up(ONE, e, q) e-above-one q-positive]
                          @one-times-q |
                            rational.mul(ONE, q) = q
                            [using specialize rational.mulOneLeft(q)]
                          @q-below-e-times-q |
                            less_than(q, rational.mul(e, q))
                            [by rewrite one-times-q one-times-q-below-e-times-q]
                          @conclusion-q-below-a |
                            less_than(q, a)
                            [by rewrite the-factorization q-below-e-times-q]
                        }
                      @factorization-implies |
                        a = rational.mul(e, q) -> less_than(q, a)
                        [by discharge given-the-factorization]
                    }
                  @q-positive-implies |
                    less_than(ZERO, q) -> a = rational.mul(e, q) ->
                      less_than(q, a)
                    [by discharge given-q-positive]
                }
              @e-above-one-implies |
                less_than(ONE, e) -> less_than(ZERO, q) ->
                  a = rational.mul(e, q) -> less_than(q, a)
                [by discharge given-e-above-one]
            }
          @discharge-q |
            forall q9: Q;
              less_than(ONE, e) -> less_than(ZERO, q9) ->
              a = rational.mul(e, q9) -> less_than(q9, a)
            [by generalize generalize-q]
        }
      @discharge-e |
        forall e9: Q; forall q9: Q;
          less_than(ONE, e9) -> less_than(ZERO, q9) ->
          a = rational.mul(e9, q9) -> less_than(q9, a)
        [by generalize generalize-e]
    }
  @conclusion |
    forall a, e, q: Q;
      less_than(ONE, e) -> less_than(ZERO, q) -> a = rational.mul(e, q) ->
      less_than(q, a)
    [by generalize generalize-a]
qed

// A positive integer that is not a unit exceeds ONE: it is at least ONE
// (`aPositiveIntegerIsAtLeastOne`), and not equal to ONE by hypothesis.
theorem aPositiveNonUnitExceedsOne: forall e: Q;
  isInteger(e) -> less_than(ZERO, e) -> (not (e = ONE)) -> less_than(ONE, e)
proof
  @generalize-e |
    fix e: Q {
      @given-e-is-an-integer |
        assume isInteger(e) {
          @e-is-an-integer |
            isInteger(e)
            [by hypothesis given-e-is-an-integer]
          @given-e-positive |
            assume less_than(ZERO, e) {
              @e-positive |
                less_than(ZERO, e)
                [by hypothesis given-e-positive]
              @given-e-not-one |
                assume not (e = ONE) {
                  @e-not-one |
                    not (e = ONE)
                    [by hypothesis given-e-not-one]
                  @e-at-least-one |
                    e = ONE or less_than(ONE, e)
                    [using specialize aPositiveIntegerIsAtLeastOne(e) e-is-an-integer e-positive]
                  @conclusion-above-one |
                    less_than(ONE, e)
                    [using tautology e-at-least-one e-not-one]
                }
              @not-one-implies |
                (not (e = ONE)) -> less_than(ONE, e)
                [by discharge given-e-not-one]
            }
          @positive-implies |
            less_than(ZERO, e) -> (not (e = ONE)) -> less_than(ONE, e)
            [by discharge given-e-positive]
        }
      @integer-implies |
        isInteger(e) -> less_than(ZERO, e) -> (not (e = ONE)) ->
          less_than(ONE, e)
        [by discharge given-e-is-an-integer]
    }
  @conclusion |
    forall e: Q;
      isInteger(e) -> less_than(ZERO, e) -> (not (e = ONE)) ->
      less_than(ONE, e)
    [by generalize generalize-e]
qed
