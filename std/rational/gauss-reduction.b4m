// std/rational/gauss-reduction.b4m — APPLYING LEMMA 17.12 TO BOTH FACTORS OF A PRODUCT.
//
// Gauss's Lemma takes a monic p(x) in ℚ[x] that factors as α(x)β(x) and produces a monic
// factorization in ℤ[x]. The reduction has three moves:
//
//   1. Apply Lemma 17.12 to EACH factor, getting α = (r1/s1)·a and β = (r2/s2)·b with a, b
//      integral and primitive.
//   2. Combine the scalars: α·β = (r1 r2)/(s1 s2) · (a·b), which is where ℚ[x]'s
//      associativity and commutativity earn their keep.
//   3. Split on whether that combined scalar is a unit. d = 1 lands in
//      `gauss.gaussLemmaAtDOne`; d != 1 lands in the mod-p argument.
//
// THE MODEL POINT. Lemma 17.12 is stated about `theSubject`, an uninterpreted nullary func
// with NO defining axiom — i.e. a model PARAMETER. So "apply it to both factors" is two
// models over the one theorem, each pinning `theSubject` to its own factor. Of 17.12's 54
// axioms exactly ONE mentions `theSubject` (`denominatorMeaning`), so each model owes exactly
// one local discharge; the other 53 are `theSubject`-free and the universe-clone keeps them
// meaning what they already mean.

import rational <<< "std/rational.b4m"
import peano <<< "std/peano.b4m"
import qpoly <<< "std/rational/polynomial.b4m"
import integer_product <<< "std/rational/integer-product.b4m"
import gauss <<< "std/rational/gauss.b4m"
import integer_polynomial <<< "std/rational/integer-polynomial.b4m"
import mod_n <<< "std/integer/mod-n.b4m"
import mod_n_poly <<< "std/integer/mod-n-polynomial.b4m"

sort Q = rational.Q
sort Nat = peano.Nat
sort QPoly = qpoly.QPoly
const ZERO = rational.ZERO
const NAT_ZERO = peano.ZERO
func recip = rational.recip
pred less_than = rational.less_than
pred isInteger = rational.isInteger
func qmulP = qpoly.qmulP
func qmonomial = qpoly.qmonomial

// -- THE TWO FACTORS, FIXED ------------------------------------------------------------------
// Gauss's Lemma is proved for an arbitrary but fixed factorization, so the two factors are
// consts here exactly as 17.12's subject is. A theorem proved about these holds of every
// factorization, by the same fixed-but-arbitrary reading that `mod_n.N` carries.
const THE_LEFT_FACTOR: QPoly
const THE_RIGHT_FACTOR: QPoly

// Each factor needs its own denominator-spec predicate, because the spec's DEFINING axiom
// reads a coefficient through the subject — that is the one per-model cost.
pred isADenominatorForTheLeftFactor(i: Nat, v: Q)
axiom leftDenominatorMeaning: forall i: Nat; forall v: Q;
  isADenominatorForTheLeftFactor(i, v) iff
  (isInteger(v) and less_than(ZERO, v) and (not (v = rational.ZERO)) and
  (exists b: Q; isInteger(b) and
  qpoly.qcoeff(THE_LEFT_FACTOR, i) = rational.mul(b, recip(v))))

pred isADenominatorForTheRightFactor(i: Nat, v: Q)
axiom rightDenominatorMeaning: forall i: Nat; forall v: Q;
  isADenominatorForTheRightFactor(i, v) iff
  (isInteger(v) and less_than(ZERO, v) and (not (v = rational.ZERO)) and
  (exists b: Q; isInteger(b) and
  qpoly.qcoeff(THE_RIGHT_FACTOR, i) = rational.mul(b, recip(v))))

// -- THE TWO MODELS --------------------------------------------------------------------------
model LemmaAtTheLeftFactor {
  integer_product.theSubject: THE_LEFT_FACTOR
  integer_product.isADenominatorFor: isADenominatorForTheLeftFactor
  integer_product.denominatorMeaning <- leftDenominatorMeaning
}

model LemmaAtTheRightFactor {
  integer_product.theSubject: THE_RIGHT_FACTOR
  integer_product.isADenominatorFor: isADenominatorForTheRightFactor
  integer_product.denominatorMeaning <- rightDenominatorMeaning
}

// -- 17.12 AT EACH FACTOR --------------------------------------------------------------------
theorem theLeftFactorDecomposes: forall n: Nat;
  qpoly.qdegreeAtMost(THE_LEFT_FACTOR, n) ->
  less_than(ZERO, qpoly.qcoeff(THE_LEFT_FACTOR, NAT_ZERO)) ->
  (exists q: QPoly; exists r, s: Q;
  qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, q, r, s, peano.succ(n)))
proof
  @conclusion |
    forall n: Nat;
      qpoly.qdegreeAtMost(THE_LEFT_FACTOR, n) ->
      less_than(ZERO, qpoly.qcoeff(THE_LEFT_FACTOR, NAT_ZERO)) ->
      (exists q: QPoly; exists r, s: Q;
      qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, q, r, s, peano.succ(n)))
    [using model(LemmaAtTheLeftFactor) integer_product.theIntegerDecompositionExists]
qed

theorem theRightFactorDecomposes: forall n: Nat;
  qpoly.qdegreeAtMost(THE_RIGHT_FACTOR, n) ->
  less_than(ZERO, qpoly.qcoeff(THE_RIGHT_FACTOR, NAT_ZERO)) ->
  (exists q: QPoly; exists r, s: Q;
  qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, q, r, s, peano.succ(n)))
proof
  @conclusion |
    forall n: Nat;
      qpoly.qdegreeAtMost(THE_RIGHT_FACTOR, n) ->
      less_than(ZERO, qpoly.qcoeff(THE_RIGHT_FACTOR, NAT_ZERO)) ->
      (exists q: QPoly; exists r, s: Q;
      qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, q, r, s, peano.succ(n)))
    [using model(LemmaAtTheRightFactor) integer_product.theIntegerDecompositionExists]
qed

// -- COMBINING THE TWO SCALARS ---------------------------------------------------------------
// The regrouping (c1·A)(c2·B) = (c1 c2)(A·B). ℚ[x] has associativity and commutativity but no
// multiplicative LEFT-SWAP lemma, which is what `assoc_commut`'s custom-operator form wants as
// its third argument — so this is written as the explicit chain instead:
//
//   (c1 A)(c2 B) = c1(A(c2 B)) = c1((c2 B)A) = c1(c2(B A)) = (c1 c2)(B A) = (c1 c2)(A B)
//
// Each line is one `rewrite` with a named intermediate, per the standing rule that a
// multi-equation rearrangement is not a `simplify` goal.
theorem theScalingsCombine: forall c1, c2: Q; forall a, b: QPoly;
  qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
  qmulP(qmonomial(rational.mul(c1, c2), NAT_ZERO), qmulP(a, b))
proof
  @generalize-c1 |
    fix c1: Q {
      @generalize-c2 |
        fix c2: Q {
          @generalize-a |
            fix a: QPoly {
              @generalize-b |
                fix b: QPoly {
                  // (c1 A)(c2 B) = c1(A(c2 B))
                  @the-left-scalar-floats-out |
                    qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
                      qmulP(qmonomial(c1, NAT_ZERO), qmulP(a, qmulP(qmonomial(c2, NAT_ZERO), b)))
                    [using specialize qpoly.qMulIsAssociative(
                      qmonomial(c1, NAT_ZERO), a, qmulP(qmonomial(c2, NAT_ZERO), b))]
                  // A(c2 B) = (c2 B)A
                  @the-inner-product-commutes |
                    qmulP(a, qmulP(qmonomial(c2, NAT_ZERO), b)) =
                      qmulP(qmulP(qmonomial(c2, NAT_ZERO), b), a)
                    [using specialize qpoly.qMulIsCommutative(
                      a, qmulP(qmonomial(c2, NAT_ZERO), b))]
                  // (c2 B)A = c2(B A)
                  @the-right-scalar-floats-out |
                    qmulP(qmulP(qmonomial(c2, NAT_ZERO), b), a) =
                      qmulP(qmonomial(c2, NAT_ZERO), qmulP(b, a))
                    [using specialize qpoly.qMulIsAssociative(
                      qmonomial(c2, NAT_ZERO), b, a)]
                  // B A = A B
                  @the-factors-commute |
                    qmulP(b, a) = qmulP(a, b)
                    [using specialize qpoly.qMulIsCommutative(b, a)]
                  // c1(c2 X) = (c1 c2)X
                  @the-scalars-associate |
                    qmulP(qmonomial(c1, NAT_ZERO), qmulP(qmonomial(c2, NAT_ZERO), qmulP(a, b))) =
                      qmulP(qmulP(qmonomial(c1, NAT_ZERO), qmonomial(c2, NAT_ZERO)), qmulP(a, b))
                    [by symmetry the-scalars-associate-forward]
                  @the-scalars-associate-forward |
                    qmulP(qmulP(qmonomial(c1, NAT_ZERO), qmonomial(c2, NAT_ZERO)), qmulP(a, b)) =
                      qmulP(qmonomial(c1, NAT_ZERO), qmulP(qmonomial(c2, NAT_ZERO), qmulP(a, b)))
                    [using specialize qpoly.qMulIsAssociative(
                      qmonomial(c1, NAT_ZERO), qmonomial(c2, NAT_ZERO), qmulP(a, b))]
                  @the-monomials-collapse |
                    qmulP(qmonomial(c1, NAT_ZERO), qmonomial(c2, NAT_ZERO)) =
                      qmonomial(rational.mul(c1, c2), NAT_ZERO)
                    [using specialize qpoly.theProductOfConstantMonomials(c1, c2)]

                  // now chain them
                  @through-the-commuted-inner |
                    qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
                      qmulP(qmonomial(c1, NAT_ZERO),
                      qmulP(qmulP(qmonomial(c2, NAT_ZERO), b), a))
                    [by rewrite the-inner-product-commutes the-left-scalar-floats-out]
                  @through-the-floated-right-scalar |
                    qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
                      qmulP(qmonomial(c1, NAT_ZERO),
                      qmulP(qmonomial(c2, NAT_ZERO), qmulP(b, a)))
                    [by rewrite the-right-scalar-floats-out through-the-commuted-inner]
                  @through-the-commuted-factors |
                    qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
                      qmulP(qmonomial(c1, NAT_ZERO),
                      qmulP(qmonomial(c2, NAT_ZERO), qmulP(a, b)))
                    [by rewrite the-factors-commute through-the-floated-right-scalar]
                  @through-the-associated-scalars |
                    qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
                      qmulP(qmulP(qmonomial(c1, NAT_ZERO), qmonomial(c2, NAT_ZERO)),
                      qmulP(a, b))
                    [by rewrite the-scalars-associate through-the-commuted-factors]
                  @conclusion-the-scalings-combine |
                    qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
                      qmulP(qmonomial(rational.mul(c1, c2), NAT_ZERO), qmulP(a, b))
                    [by rewrite the-monomials-collapse through-the-associated-scalars]
                }
              @conclusion-for-all-b |
                forall b: QPoly;
                  qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
                  qmulP(qmonomial(rational.mul(c1, c2), NAT_ZERO), qmulP(a, b))
                [by generalize generalize-b]
            }
          @conclusion-for-all-a |
            forall a, b: QPoly;
              qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
              qmulP(qmonomial(rational.mul(c1, c2), NAT_ZERO), qmulP(a, b))
            [by generalize generalize-a]
        }
      @conclusion-for-all-c2 |
        forall c2: Q; forall a, b: QPoly;
          qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
          qmulP(qmonomial(rational.mul(c1, c2), NAT_ZERO), qmulP(a, b))
        [by generalize generalize-c2]
    }
  @conclusion |
    forall c1, c2: Q; forall a, b: QPoly;
      qmulP(qmulP(qmonomial(c1, NAT_ZERO), a), qmulP(qmonomial(c2, NAT_ZERO), b)) =
      qmulP(qmonomial(rational.mul(c1, c2), NAT_ZERO), qmulP(a, b))
    [by generalize generalize-c1]
qed

// -- THE PRODUCT OF THE TWO FACTORS IS A SINGLE SCALING --------------------------------------
// Given each factor's decomposition, the product is ONE constant scaling of an integral
// product. This is the whole content of Gauss's reduction setup: the two scalars r1/s1 and
// r2/s2 fuse into a single ℚ, and the two integral primitive parts fuse into a single ℚ[x].
//
// What the split on d then asks about is that fused scalar.
theorem theProductIsASingleScaling: forall a1, a2: QPoly; forall r1, s1, r2, s2: Q;
  forall n1, n2: Nat;
  qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
  qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
  qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
  qmulP(
  qmonomial(
  rational.mul(
  rational.mul(r1, recip(s1)),
  rational.mul(r2, recip(s2))), NAT_ZERO),
  qmulP(a1, a2))
proof
  @generalize-a1 |
    fix a1: QPoly {
      @generalize-a2 |
        fix a2: QPoly {
          @generalize-r1 |
            fix r1: Q {
              @generalize-s1 |
                fix s1: Q {
                  @generalize-r2 |
                    fix r2: Q {
                      @generalize-s2 |
                        fix s2: Q {
                          @generalize-n1 |
                            fix n1: Nat {
                              @generalize-n2 |
                                fix n2: Nat {
                                  @given-both-decompositions |
                                    assume qpoly.isTheIntegerDecomposition(
                                      THE_LEFT_FACTOR, a1, r1, s1, n1) {
                                      @the-left-decomposition |
                                        qpoly.isTheIntegerDecomposition(
                                          THE_LEFT_FACTOR, a1, r1, s1, n1)
                                        [by hypothesis given-both-decompositions]
                                      @the-left-is-a-scaling |
                                        THE_LEFT_FACTOR =
                                          qmulP(qmonomial(
                                          rational.mul(r1, recip(s1)), NAT_ZERO), a1)
                                        [using specialize
                                          qpoly.aScaledIntegerPolynomialIsRational(
                                          THE_LEFT_FACTOR, a1, r1, s1, n1)
                                          the-left-decomposition]
                                      @the-right-case |
                                        assume qpoly.isTheIntegerDecomposition(
                                          THE_RIGHT_FACTOR, a2, r2, s2, n2) {
                                          @the-right-decomposition |
                                            qpoly.isTheIntegerDecomposition(
                                              THE_RIGHT_FACTOR, a2, r2, s2, n2)
                                            [by hypothesis the-right-case]
                                          @the-right-is-a-scaling |
                                            THE_RIGHT_FACTOR =
                                              qmulP(qmonomial(
                                              rational.mul(r2, recip(s2)), NAT_ZERO), a2)
                                            [using specialize
                                              qpoly.aScaledIntegerPolynomialIsRational(
                                              THE_RIGHT_FACTOR, a2, r2, s2, n2)
                                              the-right-decomposition]
                                          @the-scalings-fuse |
                                            qmulP(
                                              qmulP(qmonomial(
                                              rational.mul(r1, recip(s1)), NAT_ZERO), a1),
                                              qmulP(qmonomial(
                                              rational.mul(r2, recip(s2)), NAT_ZERO), a2)) =
                                              qmulP(qmonomial(
                                              rational.mul(
                                              rational.mul(r1, recip(s1)),
                                              rational.mul(r2, recip(s2))), NAT_ZERO),
                                              qmulP(a1, a2))
                                            [using specialize theScalingsCombine(
                                              rational.mul(r1, recip(s1)),
                                              rational.mul(r2, recip(s2)), a1, a2)]
                                          @the-product-in-scaled-form |
                                            qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                                              qmulP(
                                              qmulP(qmonomial(
                                              rational.mul(r1, recip(s1)), NAT_ZERO), a1),
                                              qmulP(qmonomial(
                                              rational.mul(r2, recip(s2)), NAT_ZERO), a2))
                                            [using simplify the-left-is-a-scaling
                                              the-right-is-a-scaling]
                                          @conclusion-the-product-is-a-single-scaling |
                                            qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                                              qmulP(qmonomial(
                                              rational.mul(
                                              rational.mul(r1, recip(s1)),
                                              rational.mul(r2, recip(s2))), NAT_ZERO),
                                              qmulP(a1, a2))
                                            [by rewrite the-scalings-fuse
                                              the-product-in-scaled-form]
                                        }
                                      @conclusion-given-the-right |
                                        qpoly.isTheIntegerDecomposition(
                                          THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                                          qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                                          qmulP(qmonomial(
                                          rational.mul(
                                          rational.mul(r1, recip(s1)),
                                          rational.mul(r2, recip(s2))), NAT_ZERO),
                                          qmulP(a1, a2))
                                        [by discharge the-right-case]
                                    }
                                  @conclusion-both-decompositions-give-it |
                                    qpoly.isTheIntegerDecomposition(
                                      THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                                      qpoly.isTheIntegerDecomposition(
                                      THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                                      qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                                      qmulP(qmonomial(
                                      rational.mul(
                                      rational.mul(r1, recip(s1)),
                                      rational.mul(r2, recip(s2))), NAT_ZERO),
                                      qmulP(a1, a2))
                                    [by discharge given-both-decompositions]
                                }
                              @conclusion-for-all-n2 |
                                forall n2: Nat;
                                  qpoly.isTheIntegerDecomposition(
                                  THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                                  qpoly.isTheIntegerDecomposition(
                                  THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                                  qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                                  qmulP(qmonomial(
                                  rational.mul(
                                  rational.mul(r1, recip(s1)),
                                  rational.mul(r2, recip(s2))), NAT_ZERO),
                                  qmulP(a1, a2))
                                [by generalize generalize-n2]
                            }
                          @conclusion-for-all-n1 |
                            forall n1, n2: Nat;
                              qpoly.isTheIntegerDecomposition(
                              THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                              qpoly.isTheIntegerDecomposition(
                              THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                              qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                              qmulP(qmonomial(
                              rational.mul(
                              rational.mul(r1, recip(s1)),
                              rational.mul(r2, recip(s2))), NAT_ZERO),
                              qmulP(a1, a2))
                            [by generalize generalize-n1]
                        }
                      @conclusion-for-all-s2 |
                        forall s2: Q; forall n1, n2: Nat;
                          qpoly.isTheIntegerDecomposition(
                          THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                          qpoly.isTheIntegerDecomposition(
                          THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                          qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                          qmulP(qmonomial(
                          rational.mul(
                          rational.mul(r1, recip(s1)),
                          rational.mul(r2, recip(s2))), NAT_ZERO),
                          qmulP(a1, a2))
                        [by generalize generalize-s2]
                    }
                  @conclusion-for-all-r2 |
                    forall r2, s2: Q; forall n1, n2: Nat;
                      qpoly.isTheIntegerDecomposition(
                      THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                      qpoly.isTheIntegerDecomposition(
                      THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                      qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                      qmulP(qmonomial(
                      rational.mul(
                      rational.mul(r1, recip(s1)),
                      rational.mul(r2, recip(s2))), NAT_ZERO),
                      qmulP(a1, a2))
                    [by generalize generalize-r2]
                }
              @conclusion-for-all-s1 |
                forall s1, r2, s2: Q; forall n1, n2: Nat;
                  qpoly.isTheIntegerDecomposition(
                  THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                  qpoly.isTheIntegerDecomposition(
                  THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                  qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                  qmulP(qmonomial(
                  rational.mul(
                  rational.mul(r1, recip(s1)),
                  rational.mul(r2, recip(s2))), NAT_ZERO),
                  qmulP(a1, a2))
                [by generalize generalize-s1]
            }
          @conclusion-for-all-r1 |
            forall r1, s1, r2, s2: Q; forall n1, n2: Nat;
              qpoly.isTheIntegerDecomposition(
              THE_LEFT_FACTOR, a1, r1, s1, n1) ->
              qpoly.isTheIntegerDecomposition(
              THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
              qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
              qmulP(qmonomial(
              rational.mul(
              rational.mul(r1, recip(s1)),
              rational.mul(r2, recip(s2))), NAT_ZERO),
              qmulP(a1, a2))
            [by generalize generalize-r1]
        }
      @conclusion-for-all-a2 |
        forall a2: QPoly; forall r1, s1, r2, s2: Q; forall n1, n2: Nat;
          qpoly.isTheIntegerDecomposition(
          THE_LEFT_FACTOR, a1, r1, s1, n1) ->
          qpoly.isTheIntegerDecomposition(
          THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
          qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
          qmulP(qmonomial(
          rational.mul(
          rational.mul(r1, recip(s1)),
          rational.mul(r2, recip(s2))), NAT_ZERO),
          qmulP(a1, a2))
        [by generalize generalize-a2]
    }
  @conclusion |
    forall a1, a2: QPoly; forall r1, s1, r2, s2: Q; forall n1, n2: Nat;
      qpoly.isTheIntegerDecomposition(
      THE_LEFT_FACTOR, a1, r1, s1, n1) ->
      qpoly.isTheIntegerDecomposition(
      THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
      qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
      qmulP(qmonomial(
      rational.mul(
      rational.mul(r1, recip(s1)),
      rational.mul(r2, recip(s2))), NAT_ZERO),
      qmulP(a1, a2))
    [by generalize generalize-a1]
qed

// -- THE d = 1 BRANCH ------------------------------------------------------------------------
// When the fused scalar is an integer, the reduction lands directly in `gaussLemmaAtDOne`.
//
// The hypotheses are ordered to MATCH `gaussLemmaAtDOne`'s own antecedent order, because
// `specialize` discharges antecedents positionally: the scaling equation is that lemma's sixth
// antecedent, so handing it over as the first ref matches it against `isInteger(c)` instead.
// Stating the theorem in the lemma's order lets one `specialize` take all seven.
//
// `d != 1` is the other branch and goes to the mod-p argument
// (`integer-polynomial.eisensteinForcesTheFullDegreeOnTheCut`); both branches are proved, so
// what remains is the case analysis that chooses between them.
theorem theMonicFactorizationWhenTheFusedScalarIsAnInteger:
  forall a1, a2: QPoly; forall r1, s1, r2, s2: Q; forall n1, n2: Nat;
  isInteger(rational.mul(
  rational.mul(r1, recip(s1)),
  rational.mul(r2, recip(s2)))) ->
  isInteger(qpoly.qcoeff(a1, n1)) -> isInteger(qpoly.qcoeff(a2, n2)) ->
  qpoly.qdegreeAtMost(a1, n1) -> qpoly.qdegreeAtMost(a2, n2) ->
  qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
  qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
  qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR), peano.add(n1, n2)) = rational.ONE ->
  (exists a, b: QPoly;
  qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
  qpoly.qcoeff(a, n1) = rational.ONE and qpoly.qcoeff(b, n2) = rational.ONE and
  qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
proof
  @generalize-a1 |
    fix a1: QPoly {
      @generalize-a2 |
        fix a2: QPoly {
          @generalize-r1 |
            fix r1: Q {
              @generalize-s1 |
                fix s1: Q {
                  @generalize-r2 |
                    fix r2: Q {
                      @generalize-s2 |
                        fix s2: Q {
                          @generalize-n1 |
                            fix n1: Nat {
                              @generalize-n2 |
                                fix n2: Nat {
                                  @given-the-left-decomposition |
                                    assume qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) {
                                      @the-left-decomposition |
                                        qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1)
                                        [by hypothesis given-the-left-decomposition]
                                      @given-the-right-decomposition |
                                        assume qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) {
                                          @the-right-decomposition |
                                            qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2)
                                            [by hypothesis given-the-right-decomposition]
                                          @the-product-is-a-single-scaling |
                                            qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                                              qmulP(qmonomial(
                                              rational.mul(
                                              rational.mul(r1, recip(s1)),
                                              rational.mul(r2, recip(s2))), NAT_ZERO),
                                              qmulP(a1, a2))
                                            [using specialize theProductIsASingleScaling(
                                              a1, a2, r1, s1, r2, s2, n1, n2)
                                              the-left-decomposition the-right-decomposition]
                                          @the-lemma-with-the-scaling-antecedent |
                                            isInteger(rational.mul(
                                              rational.mul(r1, recip(s1)),
                                              rational.mul(r2, recip(s2)))) ->
                                              isInteger(qpoly.qcoeff(a1, n1)) ->
                                              isInteger(qpoly.qcoeff(a2, n2)) ->
                                              qpoly.qdegreeAtMost(a1, n1) ->
                                              qpoly.qdegreeAtMost(a2, n2) ->
                                              qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) =
                                              qmulP(qmonomial(
                                              rational.mul(
                                              rational.mul(r1, recip(s1)),
                                              rational.mul(r2, recip(s2))), NAT_ZERO),
                                              qmulP(a1, a2)) ->
                                              qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
                                              peano.add(n1, n2)) = rational.ONE ->
                                              (exists a, b: QPoly;
                                              qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
                                              qpoly.qcoeff(a, n1) = rational.ONE and
                                              qpoly.qcoeff(b, n2) = rational.ONE and
                                              qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
                                            [using specialize gauss.gaussLemmaAtDOne(
                                              qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR), a1, a2,
                                              rational.mul(
                                              rational.mul(r1, recip(s1)),
                                              rational.mul(r2, recip(s2))), n1, n2)]
                                          @conclusion-the-monic-factorization |
                                            isInteger(rational.mul(
                                              rational.mul(r1, recip(s1)),
                                              rational.mul(r2, recip(s2)))) ->
                                              isInteger(qpoly.qcoeff(a1, n1)) ->
                                              isInteger(qpoly.qcoeff(a2, n2)) ->
                                              qpoly.qdegreeAtMost(a1, n1) ->
                                              qpoly.qdegreeAtMost(a2, n2) ->
                                              qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
                                              peano.add(n1, n2)) = rational.ONE ->
                                              (exists a, b: QPoly;
                                              qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
                                              qpoly.qcoeff(a, n1) = rational.ONE and
                                              qpoly.qcoeff(b, n2) = rational.ONE and
                                              qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
                                            [using tautology the-lemma-with-the-scaling-antecedent
                                              the-product-is-a-single-scaling]
                                        }
                                      @conclusion-the-right-gives-the-rest |
                                        qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                                          (isInteger(rational.mul(
                                          rational.mul(r1, recip(s1)),
                                          rational.mul(r2, recip(s2)))) ->
                                          isInteger(qpoly.qcoeff(a1, n1)) ->
                                          isInteger(qpoly.qcoeff(a2, n2)) ->
                                          qpoly.qdegreeAtMost(a1, n1) ->
                                          qpoly.qdegreeAtMost(a2, n2) ->
                                          qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
                                          peano.add(n1, n2)) = rational.ONE ->
                                          (exists a, b: QPoly;
                                          qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
                                          qpoly.qcoeff(a, n1) = rational.ONE and
                                          qpoly.qcoeff(b, n2) = rational.ONE and
                                          qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b)))
                                        [by discharge given-the-right-decomposition]
                                    }
                                  @the-reordered-implication |
                                    qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                                      (qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                                      (isInteger(rational.mul(
                                      rational.mul(r1, recip(s1)),
                                      rational.mul(r2, recip(s2)))) ->
                                      isInteger(qpoly.qcoeff(a1, n1)) ->
                                      isInteger(qpoly.qcoeff(a2, n2)) ->
                                      qpoly.qdegreeAtMost(a1, n1) ->
                                      qpoly.qdegreeAtMost(a2, n2) ->
                                      qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
                                      peano.add(n1, n2)) = rational.ONE ->
                                      (exists a, b: QPoly;
                                      qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
                                      qpoly.qcoeff(a, n1) = rational.ONE and
                                      qpoly.qcoeff(b, n2) = rational.ONE and
                                      qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))))
                                    [by discharge given-the-left-decomposition]
                                  @conclusion-at-the-binders |
                                    isInteger(rational.mul(
                                      rational.mul(r1, recip(s1)),
                                      rational.mul(r2, recip(s2)))) ->
                                      isInteger(qpoly.qcoeff(a1, n1)) -> isInteger(qpoly.qcoeff(a2, n2)) ->
                                      qpoly.qdegreeAtMost(a1, n1) -> qpoly.qdegreeAtMost(a2, n2) ->
                                      qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                                      qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                                      qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
                                      peano.add(n1, n2)) = rational.ONE ->
                                      (exists a, b: QPoly;
                                      qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
                                      qpoly.qcoeff(a, n1) = rational.ONE and qpoly.qcoeff(b, n2) = rational.ONE and
                                      qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
                                    [using tautology the-reordered-implication]
                                }
                              @conclusion-for-all-n2 |
                                forall n2: Nat;
                                  isInteger(rational.mul(
                                  rational.mul(r1, recip(s1)),
                                  rational.mul(r2, recip(s2)))) ->
                                  isInteger(qpoly.qcoeff(a1, n1)) -> isInteger(qpoly.qcoeff(a2, n2)) ->
                                  qpoly.qdegreeAtMost(a1, n1) -> qpoly.qdegreeAtMost(a2, n2) ->
                                  qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                                  qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                                  qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
                                  peano.add(n1, n2)) = rational.ONE ->
                                  (exists a, b: QPoly;
                                  qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
                                  qpoly.qcoeff(a, n1) = rational.ONE and qpoly.qcoeff(b, n2) = rational.ONE and
                                  qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
                                [by generalize generalize-n2]
                            }
                          @conclusion-for-all-n1 |
                            forall n1, n2: Nat;
                              isInteger(rational.mul(
                              rational.mul(r1, recip(s1)),
                              rational.mul(r2, recip(s2)))) ->
                              isInteger(qpoly.qcoeff(a1, n1)) -> isInteger(qpoly.qcoeff(a2, n2)) ->
                              qpoly.qdegreeAtMost(a1, n1) -> qpoly.qdegreeAtMost(a2, n2) ->
                              qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                              qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                              qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
                              peano.add(n1, n2)) = rational.ONE ->
                              (exists a, b: QPoly;
                              qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
                              qpoly.qcoeff(a, n1) = rational.ONE and qpoly.qcoeff(b, n2) = rational.ONE and
                              qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
                            [by generalize generalize-n1]
                        }
                      @conclusion-for-all-s2 |
                        forall s2: Q; forall n1, n2: Nat;
                          isInteger(rational.mul(
                          rational.mul(r1, recip(s1)),
                          rational.mul(r2, recip(s2)))) ->
                          isInteger(qpoly.qcoeff(a1, n1)) -> isInteger(qpoly.qcoeff(a2, n2)) ->
                          qpoly.qdegreeAtMost(a1, n1) -> qpoly.qdegreeAtMost(a2, n2) ->
                          qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                          qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                          qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
                          peano.add(n1, n2)) = rational.ONE ->
                          (exists a, b: QPoly;
                          qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
                          qpoly.qcoeff(a, n1) = rational.ONE and qpoly.qcoeff(b, n2) = rational.ONE and
                          qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
                        [by generalize generalize-s2]
                    }
                  @conclusion-for-all-r2 |
                    forall r2, s2: Q; forall n1, n2: Nat;
                      isInteger(rational.mul(
                      rational.mul(r1, recip(s1)),
                      rational.mul(r2, recip(s2)))) ->
                      isInteger(qpoly.qcoeff(a1, n1)) -> isInteger(qpoly.qcoeff(a2, n2)) ->
                      qpoly.qdegreeAtMost(a1, n1) -> qpoly.qdegreeAtMost(a2, n2) ->
                      qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                      qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                      qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
                      peano.add(n1, n2)) = rational.ONE ->
                      (exists a, b: QPoly;
                      qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
                      qpoly.qcoeff(a, n1) = rational.ONE and qpoly.qcoeff(b, n2) = rational.ONE and
                      qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
                    [by generalize generalize-r2]
                }
              @conclusion-for-all-s1 |
                forall s1, r2, s2: Q; forall n1, n2: Nat;
                  isInteger(rational.mul(
                  rational.mul(r1, recip(s1)),
                  rational.mul(r2, recip(s2)))) ->
                  isInteger(qpoly.qcoeff(a1, n1)) -> isInteger(qpoly.qcoeff(a2, n2)) ->
                  qpoly.qdegreeAtMost(a1, n1) -> qpoly.qdegreeAtMost(a2, n2) ->
                  qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
                  qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
                  qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
                  peano.add(n1, n2)) = rational.ONE ->
                  (exists a, b: QPoly;
                  qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
                  qpoly.qcoeff(a, n1) = rational.ONE and qpoly.qcoeff(b, n2) = rational.ONE and
                  qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
                [by generalize generalize-s1]
            }
          @conclusion-for-all-r1 |
            forall r1, s1, r2, s2: Q; forall n1, n2: Nat;
              isInteger(rational.mul(
              rational.mul(r1, recip(s1)),
              rational.mul(r2, recip(s2)))) ->
              isInteger(qpoly.qcoeff(a1, n1)) -> isInteger(qpoly.qcoeff(a2, n2)) ->
              qpoly.qdegreeAtMost(a1, n1) -> qpoly.qdegreeAtMost(a2, n2) ->
              qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
              qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
              qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
              peano.add(n1, n2)) = rational.ONE ->
              (exists a, b: QPoly;
              qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
              qpoly.qcoeff(a, n1) = rational.ONE and qpoly.qcoeff(b, n2) = rational.ONE and
              qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
            [by generalize generalize-r1]
        }
      @conclusion-for-all-a2 |
        forall a2: QPoly; forall r1, s1, r2, s2: Q; forall n1, n2: Nat;
          isInteger(rational.mul(
          rational.mul(r1, recip(s1)),
          rational.mul(r2, recip(s2)))) ->
          isInteger(qpoly.qcoeff(a1, n1)) -> isInteger(qpoly.qcoeff(a2, n2)) ->
          qpoly.qdegreeAtMost(a1, n1) -> qpoly.qdegreeAtMost(a2, n2) ->
          qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
          qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
          qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
          peano.add(n1, n2)) = rational.ONE ->
          (exists a, b: QPoly;
          qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
          qpoly.qcoeff(a, n1) = rational.ONE and qpoly.qcoeff(b, n2) = rational.ONE and
          qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
        [by generalize generalize-a2]
    }
  @conclusion |
    forall a1, a2: QPoly; forall r1, s1, r2, s2: Q; forall n1, n2: Nat;
      isInteger(rational.mul(
      rational.mul(r1, recip(s1)),
      rational.mul(r2, recip(s2)))) ->
      isInteger(qpoly.qcoeff(a1, n1)) -> isInteger(qpoly.qcoeff(a2, n2)) ->
      qpoly.qdegreeAtMost(a1, n1) -> qpoly.qdegreeAtMost(a2, n2) ->
      qpoly.isTheIntegerDecomposition(THE_LEFT_FACTOR, a1, r1, s1, n1) ->
      qpoly.isTheIntegerDecomposition(THE_RIGHT_FACTOR, a2, r2, s2, n2) ->
      qpoly.qcoeff(qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR),
      peano.add(n1, n2)) = rational.ONE ->
      (exists a, b: QPoly;
      qpoly.qdegreeAtMost(a, n1) and qpoly.qdegreeAtMost(b, n2) and
      qpoly.qcoeff(a, n1) = rational.ONE and qpoly.qcoeff(b, n2) = rational.ONE and
      qmulP(THE_LEFT_FACTOR, THE_RIGHT_FACTOR) = qmulP(a, b))
    [by generalize generalize-a1]
qed

// -- THE d != 1 BRANCH IS IMPOSSIBLE ---------------------------------------------------------
// Judson: "Now suppose that d != 1. Since gcd(c, d) = 1, there exists a prime p such that
// p | d and p ∤ c. ... Since p | d, α1'(x)β1'(x) = 0 in ℤ_p[x]. However, this is impossible
// since neither α1'(x) nor β1'(x) is the zero polynomial and ℤ_p[x] is an integral domain."
//
// Stated as the impossibility it is: if the modulus misses a coefficient of each primitive
// part, it cannot divide every coefficient of their product. `p | d` is what makes the product
// reduce to zero everywhere, so that conjunction is contradictory and d != 1 cannot happen.
//
// The two primitive parts' integrality is UNBOUNDED here, which is why
// `aBoundedIntegralityWithADegreeBoundIsUnbounded` had to be built: Lemma 17.12 reports a
// BOUNDED integrality and `theModulusCannotDivideEveryProductCoefficient` consumes the
// unbounded one.
theorem theFusedScalarCannotHaveASurvivingDenominator:
  forall a1, a2: QPoly; forall n1, n2: Nat; forall i, j: Nat;
  mod_n_poly.is_prime(mod_n.N) ->
  qpoly.qdegreeAtMost(a1, n1) ->
  qpoly.hasIntegerCoefficientsUpTo(a1, peano.succ(n1)) ->
  qpoly.qdegreeAtMost(a2, n2) ->
  qpoly.hasIntegerCoefficientsUpTo(a2, peano.succ(n2)) ->
  (not integer_polynomial.reducesToZero(qpoly.qcoeff(a1, i))) ->
  (not integer_polynomial.reducesToZero(qpoly.qcoeff(a2, j))) ->
  (not (forall t: Nat;
  integer_polynomial.reducesToZero(qpoly.qcoeff(qmulP(a1, a2), t))))
proof
  @generalize-a1 |
    fix a1: QPoly {
      @generalize-a2 |
        fix a2: QPoly {
          @generalize-n1 |
            fix n1: Nat {
              @generalize-n2 |
                fix n2: Nat {
                  @generalize-i |
                    fix i: Nat {
                      @generalize-j |
                        fix j: Nat {
                          @the-left-integrality-is-unbounded |
                            qpoly.qdegreeAtMost(a1, n1) ->
                              qpoly.hasIntegerCoefficientsUpTo(a1, peano.succ(n1)) ->
                              integer_polynomial.hasIntegerCoefficients(a1)
                            [using specialize
                              integer_polynomial.aBoundedIntegralityWithADegreeBoundIsUnbounded(
                              a1, n1)]
                          @the-right-integrality-is-unbounded |
                            qpoly.qdegreeAtMost(a2, n2) ->
                              qpoly.hasIntegerCoefficientsUpTo(a2, peano.succ(n2)) ->
                              integer_polynomial.hasIntegerCoefficients(a2)
                            [using specialize
                              integer_polynomial.aBoundedIntegralityWithADegreeBoundIsUnbounded(
                              a2, n2)]
                          @the-modulus-cannot-divide-everything |
                            mod_n_poly.is_prime(mod_n.N) ->
                              integer_polynomial.hasIntegerCoefficients(a1) ->
                              integer_polynomial.hasIntegerCoefficients(a2) ->
                              (not integer_polynomial.reducesToZero(qpoly.qcoeff(a1, i))) ->
                              (not integer_polynomial.reducesToZero(qpoly.qcoeff(a2, j))) ->
                              (not (forall t: Nat;
                              integer_polynomial.reducesToZero(
                              qpoly.qcoeff(qmulP(a1, a2), t))))
                            [using specialize
                              integer_polynomial.theModulusCannotDivideEveryProductCoefficient(
                              a1, a2, i, j)]
                          @conclusion-at-the-binders |
                            mod_n_poly.is_prime(mod_n.N) ->
                              qpoly.qdegreeAtMost(a1, n1) ->
                              qpoly.hasIntegerCoefficientsUpTo(a1, peano.succ(n1)) ->
                              qpoly.qdegreeAtMost(a2, n2) ->
                              qpoly.hasIntegerCoefficientsUpTo(a2, peano.succ(n2)) ->
                              (not integer_polynomial.reducesToZero(qpoly.qcoeff(a1, i))) ->
                              (not integer_polynomial.reducesToZero(qpoly.qcoeff(a2, j))) ->
                              (not (forall t: Nat;
                              integer_polynomial.reducesToZero(
                              qpoly.qcoeff(qmulP(a1, a2), t))))
                            [using tautology the-modulus-cannot-divide-everything
                              the-left-integrality-is-unbounded
                              the-right-integrality-is-unbounded]
                        }
                      @conclusion-for-all-j |
                        forall j: Nat;
                          mod_n_poly.is_prime(mod_n.N) ->
                          qpoly.qdegreeAtMost(a1, n1) ->
                          qpoly.hasIntegerCoefficientsUpTo(a1, peano.succ(n1)) ->
                          qpoly.qdegreeAtMost(a2, n2) ->
                          qpoly.hasIntegerCoefficientsUpTo(a2, peano.succ(n2)) ->
                          (not integer_polynomial.reducesToZero(qpoly.qcoeff(a1, i))) ->
                          (not integer_polynomial.reducesToZero(qpoly.qcoeff(a2, j))) ->
                          (not (forall t: Nat;
                          integer_polynomial.reducesToZero(qpoly.qcoeff(qmulP(a1, a2), t))))
                        [by generalize generalize-j]
                    }
                  @conclusion-for-all-i |
                    forall i, j: Nat;
                      mod_n_poly.is_prime(mod_n.N) ->
                      qpoly.qdegreeAtMost(a1, n1) ->
                      qpoly.hasIntegerCoefficientsUpTo(a1, peano.succ(n1)) ->
                      qpoly.qdegreeAtMost(a2, n2) ->
                      qpoly.hasIntegerCoefficientsUpTo(a2, peano.succ(n2)) ->
                      (not integer_polynomial.reducesToZero(qpoly.qcoeff(a1, i))) ->
                      (not integer_polynomial.reducesToZero(qpoly.qcoeff(a2, j))) ->
                      (not (forall t: Nat;
                      integer_polynomial.reducesToZero(qpoly.qcoeff(qmulP(a1, a2), t))))
                    [by generalize generalize-i]
                }
              @conclusion-for-all-n2 |
                forall n2: Nat; forall i, j: Nat;
                  mod_n_poly.is_prime(mod_n.N) ->
                  qpoly.qdegreeAtMost(a1, n1) ->
                  qpoly.hasIntegerCoefficientsUpTo(a1, peano.succ(n1)) ->
                  qpoly.qdegreeAtMost(a2, n2) ->
                  qpoly.hasIntegerCoefficientsUpTo(a2, peano.succ(n2)) ->
                  (not integer_polynomial.reducesToZero(qpoly.qcoeff(a1, i))) ->
                  (not integer_polynomial.reducesToZero(qpoly.qcoeff(a2, j))) ->
                  (not (forall t: Nat;
                  integer_polynomial.reducesToZero(qpoly.qcoeff(qmulP(a1, a2), t))))
                [by generalize generalize-n2]
            }
          @conclusion-for-all-n1 |
            forall n1, n2: Nat; forall i, j: Nat;
              mod_n_poly.is_prime(mod_n.N) ->
              qpoly.qdegreeAtMost(a1, n1) ->
              qpoly.hasIntegerCoefficientsUpTo(a1, peano.succ(n1)) ->
              qpoly.qdegreeAtMost(a2, n2) ->
              qpoly.hasIntegerCoefficientsUpTo(a2, peano.succ(n2)) ->
              (not integer_polynomial.reducesToZero(qpoly.qcoeff(a1, i))) ->
              (not integer_polynomial.reducesToZero(qpoly.qcoeff(a2, j))) ->
              (not (forall t: Nat;
              integer_polynomial.reducesToZero(qpoly.qcoeff(qmulP(a1, a2), t))))
            [by generalize generalize-n1]
        }
      @conclusion-for-all-a2 |
        forall a2: QPoly; forall n1, n2: Nat; forall i, j: Nat;
          mod_n_poly.is_prime(mod_n.N) ->
          qpoly.qdegreeAtMost(a1, n1) ->
          qpoly.hasIntegerCoefficientsUpTo(a1, peano.succ(n1)) ->
          qpoly.qdegreeAtMost(a2, n2) ->
          qpoly.hasIntegerCoefficientsUpTo(a2, peano.succ(n2)) ->
          (not integer_polynomial.reducesToZero(qpoly.qcoeff(a1, i))) ->
          (not integer_polynomial.reducesToZero(qpoly.qcoeff(a2, j))) ->
          (not (forall t: Nat;
          integer_polynomial.reducesToZero(qpoly.qcoeff(qmulP(a1, a2), t))))
        [by generalize generalize-a2]
    }
  @conclusion |
    forall a1, a2: QPoly; forall n1, n2: Nat; forall i, j: Nat;
      mod_n_poly.is_prime(mod_n.N) ->
      qpoly.qdegreeAtMost(a1, n1) ->
      qpoly.hasIntegerCoefficientsUpTo(a1, peano.succ(n1)) ->
      qpoly.qdegreeAtMost(a2, n2) ->
      qpoly.hasIntegerCoefficientsUpTo(a2, peano.succ(n2)) ->
      (not integer_polynomial.reducesToZero(qpoly.qcoeff(a1, i))) ->
      (not integer_polynomial.reducesToZero(qpoly.qcoeff(a2, j))) ->
      (not (forall t: Nat;
      integer_polynomial.reducesToZero(qpoly.qcoeff(qmulP(a1, a2), t))))
    [by generalize generalize-a1]
qed
