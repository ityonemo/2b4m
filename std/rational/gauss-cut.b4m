// std/rational/gauss-cut.b4m — ℤ[x] as a SUB-RING of ℚ[x], and Eisenstein's reduction on it.
//
// ############################################################################################
// TEMPORARY. This file duplicates mathematics that `std/integer/polynomial.b4m` already has.
// The construction that would REPLACE it is a cut plus a model —
//
//     sort IntPolyCut = QPoly where hasIntegerCoefficients
//     model IntegerPolynomialsOnTheCut { intpoly.IntPoly: IntPolyCut; intpoly.Int: Integer }
//
// and that is UNFINISHED WORK, not a language wall. An earlier note here claimed the engine
// could not compose nested models; that was wrong — `std` composes models in 40 places, and
// the sort mapping above is accepted when probed. What the probe then hits is an
// INCOMPLETE DISCHARGE: each symbol the transferred proof reaches has to be mapped, revealed
// one at a time by a sort error in whichever source file it lands in. Finishing it is
// bookkeeping, and `NESTED-MODEL-COMPOSITION-ISSUE.md` records why that bookkeeping is so
// hard to do blind (the diagnostic names neither the model nor the missing name).
//
// Until someone finishes it the duplication is deliberate and disclosed. Do not grow it: a new
// fact about integer-coefficient polynomials belongs in `std/integer/polynomial.b4m` unless it
// is specifically about the cut's interaction with ℚ.
// ############################################################################################
//
// `std/integer/polynomial.b4m` builds ℤ[x] as its own sort `IntPoly`. That makes "f is
// irreducible over ℚ" inexpressible about an `IntPoly`: the two polynomial sorts have no
// embedding between them, and AATA Theorem 17.15's conclusion is exactly such a statement.
//
// Here ℤ[x] is instead CUT OUT of ℚ[x] by `hasIntegerCoefficients`. Then a ℤ[x] polynomial IS
// a ℚ[x] polynomial, "no factorization in ℤ[x]" and "irreducible over ℚ" are statements about
// the same objects, and no embedding is needed anywhere.
//
// WHAT IS REUSED RATHER THAN REBUILT. `modNPolynomialsHaveNoZeroDivisors` is a fact about
// ℤ_N[x] alone — no ℚ in it — so it is cited directly, not transferred. And Eisenstein's prime
// stays a ℚ-cut element here, so the reduction's target ℤ_N[x] is untouched: what crosses
// between them is only `qcls`'s homomorphism laws.
//
// WHAT IS NEW, AND THE TRADE. The cut needs its own class map `qcls`, axiomatised directly on
// ℚ's integers. The alternative — composing with a `Q -> Int` conversion — is unavailable by
// design: the number-tower refactor dropped the `from*` functions deliberately, keeping `is*`
// as primitive-closure predicates. And `cls: Int -> Zn` cannot be re-pointed at the cut,
// because `mod_n` keys it to `std/integer.b4m`'s `Int` and transferring `mod_n` hits the
// nested-transfer wall (`std/peano.b4m` sits in its axiom base).
//
// So `qcls` costs four new axioms. They are the same homomorphism and congruence laws `cls`
// already has, so this is not a new mathematical assumption — but they ARE axioms, and
// `--axioms` lists them. Recording the trade rather than making it silently.

import qpoly <<< "std/rational/polynomial.b4m"
import rational <<< "std/rational.b4m"
import integer <<< "std/integer.b4m"
import ring_poly <<< "std/ring/polynomial.b4m"
import ring_leading <<< "std/ring/polynomial/leading.b4m"
import mod_n <<< "std/integer/mod-n.b4m"
import mod_n_poly <<< "std/integer/mod-n-polynomial.b4m"
import mod_n_domain <<< "std/integer/mod-n-domain.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

sort Q = rational.Q
sort QPoly = qpoly.QPoly
sort Nat = peano.Nat
sort Zn = mod_n.Zn
sort ZnPoly = mod_n_poly.ZnPoly
const ZERO = rational.ZERO
const ONE = rational.ONE
const NAT_ZERO = peano.ZERO
pred isInteger = rational.isInteger

// -- THE CUT -------------------------------------------------------------------------------
// ℤ[x] inside ℚ[x]: every coefficient is an integer. Unbounded, unlike
// `qpoly.hasIntegerCoefficientsUpTo`, because a factorization argument quantifies over all
// indices rather than up to a stated degree.
pred hasIntegerCoefficients(p: QPoly)
axiom integerCoefficientsEverywhere: forall p: QPoly;
  hasIntegerCoefficients(p) iff
  (forall i: Nat; isInteger(qpoly.qcoeff(p, i)))

// -- THE CUT IS A SUB-RING -----------------------------------------------------------------
// The closure facts. Only the product is nontrivial: a product's coefficient is a
// CONVOLUTION, so integrality has to ride the convolution's own recursion.

theorem theZeroPolynomialIsIntegral: hasIntegerCoefficients(qpoly.QZEROP)
proof
  @each-index |
    fix i: Nat {
      @the-zero-coefficient |
        qpoly.qcoeff(qpoly.QZEROP, i) = ZERO
        [using specialize qpoly.qZeroPolyCoeff(i)]
      @zero-is-an-integer |
        isInteger(ZERO)
        [using import(rational) zeroIsAnInteger]
      @conclusion-integral-at-i |
        isInteger(qpoly.qcoeff(qpoly.QZEROP, i))
        [by rewrite the-zero-coefficient zero-is-an-integer]
    }
  @all-coefficients |
    forall i: Nat; isInteger(qpoly.qcoeff(qpoly.QZEROP, i))
    [by generalize each-index]
  @the-meaning |
    hasIntegerCoefficients(qpoly.QZEROP) iff
      (forall i: Nat; isInteger(qpoly.qcoeff(qpoly.QZEROP, i)))
    [using specialize integerCoefficientsEverywhere(qpoly.QZEROP)]
  @conclusion |
    hasIntegerCoefficients(qpoly.QZEROP)
    [using tautology the-meaning all-coefficients]
qed

theorem theUnitPolynomialIsIntegral: hasIntegerCoefficients(qpoly.QONEP)
proof
  @the-split |
    forall i: Nat; i = NAT_ZERO or (exists k: Nat; i = peano.succ(k))
    [using import(peano) zeroOrSucc]
  @each-index |
    fix i: Nat {
      @the-split-at-i |
        i = NAT_ZERO or (exists k: Nat; i = peano.succ(k))
        [using specialize the-split(i)]
      @conclusion-integral-at-i |
        isInteger(qpoly.qcoeff(qpoly.QONEP, i))
        case the-split-at-i {
          @when-zero |
            assume i = NAT_ZERO {
              @i-is-zero |
                i = NAT_ZERO
                [by hypothesis when-zero]
              @the-constant-coefficient |
                qpoly.qcoeff(qpoly.QONEP, NAT_ZERO) = ONE
                [using import(qpoly) qOnePolyCoeffZero]
              @one-is-an-integer |
                isInteger(ONE)
                [using import(rational) oneIsAnInteger]
              @integral-at-zero |
                isInteger(qpoly.qcoeff(qpoly.QONEP, NAT_ZERO))
                [by rewrite the-constant-coefficient one-is-an-integer]
              @conclusion-zero-case |
                isInteger(qpoly.qcoeff(qpoly.QONEP, i))
                [by rewrite i-is-zero integral-at-zero]
            }
          @when-successor |
            assume exists k: Nat; i = peano.succ(k) {
              @a-predecessor-exists |
                exists k: Nat; i = peano.succ(k)
                [by hypothesis when-successor]
              @with-the-predecessor |
                unpack k: Nat from a-predecessor-exists {
                  @i-is-a-successor |
                    i = peano.succ(k)
                    [by hypothesis with-the-predecessor]
                  @the-higher-coefficient |
                    qpoly.qcoeff(qpoly.QONEP, peano.succ(k)) = ZERO
                    [using specialize qpoly.qOnePolyCoeffHigher(k)]
                  @zero-is-an-integer-here |
                    isInteger(ZERO)
                    [using import(rational) zeroIsAnInteger]
                  @integral-above |
                    isInteger(qpoly.qcoeff(qpoly.QONEP,
                      peano.succ(k)))
                    [by rewrite the-higher-coefficient zero-is-an-integer-here]
                  @conclusion-at-the-successor |
                    isInteger(qpoly.qcoeff(qpoly.QONEP, i))
                    [by rewrite i-is-a-successor integral-above]
                }
              @conclusion-successor-case |
                isInteger(qpoly.qcoeff(qpoly.QONEP, i))
                [by unpacked with-the-predecessor]
            }
        }
    }
  @all-coefficients |
    forall i: Nat; isInteger(qpoly.qcoeff(qpoly.QONEP, i))
    [by generalize each-index]
  @the-meaning |
    hasIntegerCoefficients(qpoly.QONEP) iff
      (forall i: Nat; isInteger(qpoly.qcoeff(qpoly.QONEP, i)))
    [using specialize integerCoefficientsEverywhere(qpoly.QONEP)]
  @conclusion |
    hasIntegerCoefficients(qpoly.QONEP)
    [using tautology the-meaning all-coefficients]
qed

// -- the additive closures -----------------------------------------------------------------

theorem theSumIsIntegral: forall p, q: QPoly;
  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
  hasIntegerCoefficients(qpoly.qaddP(p, q))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @given-both |
            assume hasIntegerCoefficients(p) and
              hasIntegerCoefficients(q) {
              @both |
                hasIntegerCoefficients(p) and
                  hasIntegerCoefficients(q)
                [by hypothesis given-both]
              @p-is-integral |
                hasIntegerCoefficients(p)
                [by and_lhs both]
              @q-is-integral |
                hasIntegerCoefficients(q)
                [by and_rhs both]
              @the-p-meaning |
                hasIntegerCoefficients(p) iff
                  (forall i: Nat; isInteger(qpoly.qcoeff(p, i)))
                [using specialize integerCoefficientsEverywhere(p)]
              @p-coefficients |
                forall i: Nat; isInteger(qpoly.qcoeff(p, i))
                [using tautology the-p-meaning p-is-integral]
              @the-q-meaning |
                hasIntegerCoefficients(q) iff
                  (forall i: Nat; isInteger(qpoly.qcoeff(q, i)))
                [using specialize integerCoefficientsEverywhere(q)]
              @q-coefficients |
                forall i: Nat; isInteger(qpoly.qcoeff(q, i))
                [using tautology the-q-meaning q-is-integral]
              @each-index |
                fix i: Nat {
                  @the-sum-coefficient |
                    qpoly.qcoeff(qpoly.qaddP(p, q), i) =
                      rational.add(qpoly.qcoeff(p, i),
                      qpoly.qcoeff(q, i))
                    [using specialize qpoly.qAddPolyCoeff(p, q, i)]
                  @p-at-i |
                    isInteger(qpoly.qcoeff(p, i))
                    [using specialize p-coefficients(i)]
                  @q-at-i |
                    isInteger(qpoly.qcoeff(q, i))
                    [using specialize q-coefficients(i)]
                  @the-sum-is-an-integer |
                    isInteger(rational.add(qpoly.qcoeff(p, i),
                      qpoly.qcoeff(q, i)))
                    [using specialize rational.isIntegerAdd(qpoly.qcoeff(p, i), qpoly.qcoeff(q, i)) p-at-i q-at-i]
                  @conclusion-integral-at-i |
                    isInteger(qpoly.qcoeff(qpoly.qaddP(p, q), i))
                    [by rewrite the-sum-coefficient the-sum-is-an-integer]
                }
              @all-coefficients |
                forall i: Nat;
                  isInteger(qpoly.qcoeff(qpoly.qaddP(p, q), i))
                [by generalize each-index]
              @the-sum-meaning |
                hasIntegerCoefficients(qpoly.qaddP(p, q)) iff
                  (forall i: Nat;
                  isInteger(qpoly.qcoeff(qpoly.qaddP(p, q), i)))
                [using specialize integerCoefficientsEverywhere(qpoly.qaddP(p, q))]
              @conclusion-the-sum |
                hasIntegerCoefficients(qpoly.qaddP(p, q))
                [using tautology the-sum-meaning all-coefficients]
            }
          @the-implication |
            (hasIntegerCoefficients(p) and
              hasIntegerCoefficients(q)) ->
              hasIntegerCoefficients(qpoly.qaddP(p, q))
            [by discharge given-both]
          @curried |
            hasIntegerCoefficients(p) ->
              hasIntegerCoefficients(q) ->
              hasIntegerCoefficients(qpoly.qaddP(p, q))
            [using tautology the-implication]
        }
      @discharge-q |
        forall q9: QPoly;
          hasIntegerCoefficients(p) -> hasIntegerCoefficients(q9) ->
          hasIntegerCoefficients(qpoly.qaddP(p, q9))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly;
      hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
      hasIntegerCoefficients(qpoly.qaddP(p, q))
    [by generalize generalize-p]
qed

theorem theNegationIsIntegral: forall p: QPoly;
  hasIntegerCoefficients(p) ->
  hasIntegerCoefficients(qpoly.qnegP(p))
proof
  @generalize-p |
    fix p: QPoly {
      @given-integral |
        assume hasIntegerCoefficients(p) {
          @p-is-integral |
            hasIntegerCoefficients(p)
            [by hypothesis given-integral]
          @the-p-meaning |
            hasIntegerCoefficients(p) iff
              (forall i: Nat; isInteger(qpoly.qcoeff(p, i)))
            [using specialize integerCoefficientsEverywhere(p)]
          @p-coefficients |
            forall i: Nat; isInteger(qpoly.qcoeff(p, i))
            [using tautology the-p-meaning p-is-integral]
          @each-index |
            fix i: Nat {
              @the-negated-coefficient |
                qpoly.qcoeff(qpoly.qnegP(p), i) =
                  rational.neg(qpoly.qcoeff(p, i))
                [using specialize qpoly.qNegPolyCoeff(p, i)]
              @p-at-i |
                isInteger(qpoly.qcoeff(p, i))
                [using specialize p-coefficients(i)]
              @the-negation-is-an-integer |
                isInteger(rational.neg(qpoly.qcoeff(p, i)))
                [using specialize rational.isIntegerNeg(qpoly.qcoeff(p, i)) p-at-i]
              @conclusion-integral-at-i |
                isInteger(qpoly.qcoeff(qpoly.qnegP(p), i))
                [by rewrite the-negated-coefficient the-negation-is-an-integer]
            }
          @all-coefficients |
            forall i: Nat;
              isInteger(qpoly.qcoeff(qpoly.qnegP(p), i))
            [by generalize each-index]
          @the-negation-meaning |
            hasIntegerCoefficients(qpoly.qnegP(p)) iff
              (forall i: Nat;
              isInteger(qpoly.qcoeff(qpoly.qnegP(p), i)))
            [using specialize integerCoefficientsEverywhere(qpoly.qnegP(p))]
          @conclusion-the-negation |
            hasIntegerCoefficients(qpoly.qnegP(p))
            [using tautology the-negation-meaning all-coefficients]
        }
      @the-implication |
        hasIntegerCoefficients(p) ->
          hasIntegerCoefficients(qpoly.qnegP(p))
        [by discharge given-integral]
    }
  @conclusion |
    forall p: QPoly;
      hasIntegerCoefficients(p) ->
      hasIntegerCoefficients(qpoly.qnegP(p))
    [by generalize generalize-p]
qed

// -- the multiplicative closure ------------------------------------------------------------
// The only nontrivial one: a product's coefficient is a CONVOLUTION, so integrality has to be
// carried through the convolution's own recursion. Induction on the convolution index with
// the output index fixed — the shape §17.1's reindexing lemma uses.
theorem theConvolutionIsIntegral: forall p, q: QPoly; forall i, k: Nat;
  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
  isInteger(qpoly.qconvolution(p, q, i, k))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-i |
            fix i: Nat {
              @generalize-k |
                fix k: Nat {
                  @given-p-integral |
                    assume hasIntegerCoefficients(p) {
                      @p-is-integral |
                        hasIntegerCoefficients(p)
                        [by hypothesis given-p-integral]
                      @given-q-integral |
                        assume hasIntegerCoefficients(q) {
                          @q-is-integral |
                            hasIntegerCoefficients(q)
                            [by hypothesis given-q-integral]
                          @the-terms-are-integral |
                            forall u, v: Nat;
                              peano.add(u, v) = peano.add(i, k) ->
                              isInteger(rational.mul(qpoly.qcoeff(p, u),
                              qpoly.qcoeff(q, v)))
                            [using specialize
                              everyProductOfCoefficientsIsIntegral(p, q, i, k)
                              p-is-integral q-is-integral]
                          @the-integers-are-closed-under-addition |
                            forall s, t: Q;
                              isInteger(s) -> isInteger(t) ->
                              isInteger(rational.add(s, t))
                            [by cite rational.isIntegerAdd]
                          @the-run-rides-the-closure |
                            forall p2, q2: QPoly; forall m2, b2: Nat;
                              (forall u, v: Nat;
                              peano.add(u, v) = peano.add(b2, m2) ->
                              isInteger(rational.mul(qpoly.qcoeff(p2, u),
                              qpoly.qcoeff(q2, v)))) ->
                              (forall s, t: Q;
                              isInteger(s) -> isInteger(t) ->
                              isInteger(rational.add(s, t))) ->
                              isInteger(qpoly.qconvolution(p2, q2, b2, m2))
                            [using model(qpoly.RationalPolynomialsOverARing)
                              ring_poly.aRunLiesInAClosedSet(
                              (fun w: Q => isInteger(w)))]
                          @conclusion-the-run-is-integral |
                            isInteger(qpoly.qconvolution(p, q, i, k))
                            [using specialize the-run-rides-the-closure(p, q, k, i)
                              the-terms-are-integral
                              the-integers-are-closed-under-addition]
                        }
                      @q-integral-gives-it |
                        hasIntegerCoefficients(q) ->
                          isInteger(qpoly.qconvolution(p, q, i, k))
                        [by discharge given-q-integral]
                    }
                  @p-integral-gives-it |
                    hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
                      isInteger(qpoly.qconvolution(p, q, i, k))
                    [by discharge given-p-integral]
                }
              @discharge-k |
                forall k: Nat;
                  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
                  isInteger(qpoly.qconvolution(p, q, i, k))
                [by generalize generalize-k]
            }
          @discharge-i |
            forall i, k: Nat;
              hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
              isInteger(qpoly.qconvolution(p, q, i, k))
            [by generalize generalize-i]
        }
      @discharge-q |
        forall q: QPoly; forall i, k: Nat;
          hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
          isInteger(qpoly.qconvolution(p, q, i, k))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; forall i, k: Nat;
      hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
      isInteger(qpoly.qconvolution(p, q, i, k))
    [by generalize generalize-p]
qed

// Every product of an integer coefficient with an integer coefficient is an integer — the
// term premise the generic run lemma wants. The index condition plays no part: integrality
// holds at EVERY pair, so the hypothesis is discharged by ignoring it.
theorem everyProductOfCoefficientsIsIntegral: forall p, q: QPoly; forall b, m: Nat;
  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
  (forall u, v: Nat;
  peano.add(u, v) = peano.add(b, m) ->
  isInteger(rational.mul(qpoly.qcoeff(p, u), qpoly.qcoeff(q, v))))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-b |
            fix b: Nat {
              @generalize-m |
                fix m: Nat {
                  @given-p-integral |
                    assume hasIntegerCoefficients(p) {
                      @p-is-integral |
                        hasIntegerCoefficients(p)
                        [by hypothesis given-p-integral]
                      @the-p-meaning |
                        hasIntegerCoefficients(p) iff
                          (forall j: Nat; isInteger(qpoly.qcoeff(p, j)))
                        [using specialize integerCoefficientsEverywhere(p)]
                      @p-coefficients |
                        forall j: Nat; isInteger(qpoly.qcoeff(p, j))
                        [using tautology the-p-meaning p-is-integral]
                      @given-q-integral |
                        assume hasIntegerCoefficients(q) {
                          @q-is-integral |
                            hasIntegerCoefficients(q)
                            [by hypothesis given-q-integral]
                          @the-q-meaning |
                            hasIntegerCoefficients(q) iff
                              (forall j: Nat; isInteger(qpoly.qcoeff(q, j)))
                            [using specialize integerCoefficientsEverywhere(q)]
                          @q-coefficients |
                            forall j: Nat; isInteger(qpoly.qcoeff(q, j))
                            [using tautology the-q-meaning q-is-integral]
                          @generalize-u |
                            fix u: Nat {
                              @generalize-v |
                                fix v: Nat {
                                  @p-at-u |
                                    isInteger(qpoly.qcoeff(p, u))
                                    [using specialize p-coefficients(u)]
                                  @q-at-v |
                                    isInteger(qpoly.qcoeff(q, v))
                                    [using specialize q-coefficients(v)]
                                  @the-product-is-integral |
                                    isInteger(rational.mul(qpoly.qcoeff(p, u),
                                      qpoly.qcoeff(q, v)))
                                    [using specialize rational.isIntegerMul(
                                      qpoly.qcoeff(p, u), qpoly.qcoeff(q, v))
                                      p-at-u q-at-v]
                                  @given-the-pair-sums |
                                    assume peano.add(u, v) = peano.add(b, m) {
                                      @conclusion-this-term-is-integral |
                                        isInteger(rational.mul(
                                          qpoly.qcoeff(p, u),
                                          qpoly.qcoeff(q, v)))
                                        [using tautology the-product-is-integral]
                                    }
                                  @the-pair-gives-it |
                                    peano.add(u, v) = peano.add(b, m) ->
                                      isInteger(rational.mul(
                                      qpoly.qcoeff(p, u), qpoly.qcoeff(q, v)))
                                    [by discharge given-the-pair-sums]
                                }
                              @discharge-v |
                                forall v: Nat;
                                  peano.add(u, v) = peano.add(b, m) ->
                                  isInteger(rational.mul(qpoly.qcoeff(p, u),
                                  qpoly.qcoeff(q, v)))
                                [by generalize generalize-v]
                            }
                          @all-pairs |
                            forall u, v: Nat;
                              peano.add(u, v) = peano.add(b, m) ->
                              isInteger(rational.mul(qpoly.qcoeff(p, u),
                              qpoly.qcoeff(q, v)))
                            [by generalize generalize-u]
                        }
                      @q-integral-gives-it |
                        hasIntegerCoefficients(q) ->
                          (forall u, v: Nat;
                          peano.add(u, v) = peano.add(b, m) ->
                          isInteger(rational.mul(qpoly.qcoeff(p, u),
                          qpoly.qcoeff(q, v))))
                        [by discharge given-q-integral]
                    }
                  @p-integral-gives-it |
                    hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
                      (forall u, v: Nat;
                      peano.add(u, v) = peano.add(b, m) ->
                      isInteger(rational.mul(qpoly.qcoeff(p, u),
                      qpoly.qcoeff(q, v))))
                    [by discharge given-p-integral]
                }
              @discharge-m |
                forall m: Nat;
                  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
                  (forall u, v: Nat;
                  peano.add(u, v) = peano.add(b, m) ->
                  isInteger(rational.mul(qpoly.qcoeff(p, u),
                  qpoly.qcoeff(q, v))))
                [by generalize generalize-m]
            }
          @discharge-b |
            forall b, m: Nat;
              hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
              (forall u, v: Nat;
              peano.add(u, v) = peano.add(b, m) ->
              isInteger(rational.mul(qpoly.qcoeff(p, u), qpoly.qcoeff(q, v))))
            [by generalize generalize-b]
        }
      @discharge-q |
        forall q: QPoly; forall b, m: Nat;
          hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
          (forall u, v: Nat;
          peano.add(u, v) = peano.add(b, m) ->
          isInteger(rational.mul(qpoly.qcoeff(p, u), qpoly.qcoeff(q, v))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; forall b, m: Nat;
      hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
      (forall u, v: Nat;
      peano.add(u, v) = peano.add(b, m) ->
      isInteger(rational.mul(qpoly.qcoeff(p, u), qpoly.qcoeff(q, v))))
    [by generalize generalize-p]
qed

theorem theProductIsIntegral: forall p, q: QPoly;
  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
  hasIntegerCoefficients(qpoly.qmulP(p, q))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @given-both |
            assume hasIntegerCoefficients(p) and
              hasIntegerCoefficients(q) {
              @both |
                hasIntegerCoefficients(p) and
                  hasIntegerCoefficients(q)
                [by hypothesis given-both]
              @p-is-integral |
                hasIntegerCoefficients(p)
                [by and_lhs both]
              @q-is-integral |
                hasIntegerCoefficients(q)
                [by and_rhs both]
              @each-index |
                fix i: Nat {
                  @the-product-coefficient |
                    qpoly.qcoeff(qpoly.qmulP(p, q), i) =
                      qpoly.qconvolution(p, q, NAT_ZERO, i)
                    [using specialize qpoly.qMulPolyCoeff(p, q, i)]
                  @the-convolution-is-an-integer |
                    isInteger(qpoly.qconvolution(p, q, NAT_ZERO, i))
                    [using specialize theConvolutionIsIntegral(p, q, NAT_ZERO, i) p-is-integral q-is-integral]
                  @conclusion-integral-at-i |
                    isInteger(qpoly.qcoeff(qpoly.qmulP(p, q), i))
                    [by rewrite the-product-coefficient the-convolution-is-an-integer]
                }
              @all-coefficients |
                forall i: Nat;
                  isInteger(qpoly.qcoeff(qpoly.qmulP(p, q), i))
                [by generalize each-index]
              @the-product-meaning |
                hasIntegerCoefficients(qpoly.qmulP(p, q)) iff
                  (forall i: Nat;
                  isInteger(qpoly.qcoeff(qpoly.qmulP(p, q), i)))
                [using specialize integerCoefficientsEverywhere(qpoly.qmulP(p, q))]
              @conclusion-the-product |
                hasIntegerCoefficients(qpoly.qmulP(p, q))
                [using tautology the-product-meaning all-coefficients]
            }
          @the-implication |
            (hasIntegerCoefficients(p) and
              hasIntegerCoefficients(q)) ->
              hasIntegerCoefficients(qpoly.qmulP(p, q))
            [by discharge given-both]
          @curried |
            hasIntegerCoefficients(p) ->
              hasIntegerCoefficients(q) ->
              hasIntegerCoefficients(qpoly.qmulP(p, q))
            [using tautology the-implication]
        }
      @discharge-q |
        forall q9: QPoly;
          hasIntegerCoefficients(p) -> hasIntegerCoefficients(q9) ->
          hasIntegerCoefficients(qpoly.qmulP(p, q9))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly;
      hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
      hasIntegerCoefficients(qpoly.qmulP(p, q))
    [by generalize generalize-p]
qed

// -- THE CLASS MAP ON THE CUT --------------------------------------------------------------
// Eisenstein's modulus, as a ℚ-cut element. Keeping it on the cut rather than reusing
// `mod_n.N` is what avoids mixing an `Int` modulus with ℚ-cut operands in one divisibility
// statement — the link to ℤ_N[x] then runs through `qcls`'s laws alone.
// THERE IS ONLY ONE MODULUS. An earlier version of this file carried a separate cut-side
// modulus `QN` with its own congruence axiom, and stated the reduction argument's hypotheses
// as `dividesIntegrally(QN, …)`. That was a real defect: `QN` and `mod_n.N` were independent
// constants, so the reduction theorem's `is_prime(mod_n.N)` hypothesis constrained one number
// while its conclusion spoke of another. Every step type-checked, which is why it survived a
// strict check and a `--axioms` run — both congruence axioms sat in the base, and that was
// the tell I failed to read.
//
// The fix is to have no second modulus at all. "The modulus divides a" is expressed as
// "a reduces to zero", which is what it means, and `mod_n.N` is then the only modulus in
// play — so `is_prime(mod_n.N)` constrains exactly the thing the conclusions are about.
// One fewer axiom and one fewer constant than the broken version.

// `qcls` is the cut's reduction modulo `mod_n.N`, landing in the EXISTING ℤ_N[x]'s
// coefficient ring. TWO axioms, the homomorphism laws. No congruence axiom — congruence is
// what `reducesToZero` below expresses, and stating it separately is what let a second
// modulus in. No `qcls(ZERO) = ZERO` axiom either: the definitional route never needs it, and
// the `--library` gate caught it the moment it became redundant.
// NO `requires` guard. A guarded func cannot appear under a quantifier whose binder is what
// the guard is about: `forall k; … qcls(conv(p, q, i, k)) …` owes `isInteger` at a `k` that is
// not yet fixed, and no step can discharge it there. The integrality hypotheses live on the
// AXIOMS instead, which is how the rest of `std/` handles a partial operation — `qcls` is
// total on ℚ and simply uninteresting off the cut.
func qcls(a: Q) => Zn
axiom qclsAdd: forall a, b: Q; isInteger(a) -> isInteger(b) ->
  mod_n.add(qcls(a), qcls(b)) = qcls(rational.add(a, b))
axiom qclsMul: forall a, b: Q; isInteger(a) -> isInteger(b) ->
  mod_n.mul(qcls(a), qcls(b)) = qcls(rational.mul(a, b))

// "The modulus divides a" — a reduces to zero. This is the cut-side divisibility notion the
// reduction argument uses throughout, and it is a DEFINITION rather than an axiom, so it
// cannot drift from what `qcls` actually does.
define reducesToZero(a) = (qcls(a) = mod_n.ZERO)

// ZERO reduces to zero. `qcls` has no zero axiom (the definitional route made it redundant),
// so this comes from the congruence-free direction: ZERO's class is whatever it is, and
// `qclsAdd` at (ZERO, ZERO) pins it.
theorem qclsZeroReduces: reducesToZero(ZERO)
proof
  @zero-is-an-integer |
    isInteger(ZERO)
    [using import(rational) zeroIsAnInteger]
  @the-sum-of-classes |
    mod_n.add(qcls(ZERO), qcls(ZERO)) =
      qcls(rational.add(ZERO, ZERO))
    [using specialize qclsAdd(ZERO, ZERO) zero-is-an-integer zero-is-an-integer]
  @zero-plus-zero |
    rational.add(ZERO, ZERO) = ZERO
    [using polynomial(rational)]
  @the-class-is-idempotent |
    mod_n.add(qcls(ZERO), qcls(ZERO)) = qcls(ZERO)
    [by rewrite zero-plus-zero the-sum-of-classes]
  // x + x = x in a group forces x = identity
  @the-cancellation |
    forall x, y, z: Zn;
      mod_n.add(x, y) = mod_n.add(x, z) -> y = z
    [using import(mod_n) addCancelLeft]
  @the-identity-on-the-right |
    mod_n.add(qcls(ZERO), mod_n.ZERO) = qcls(ZERO)
    [using specialize mod_n.addIdentityRight(qcls(ZERO))]
  @the-two-sums-agree |
    mod_n.add(qcls(ZERO), qcls(ZERO)) =
      mod_n.add(qcls(ZERO), mod_n.ZERO)
    [by rewrite the-identity-on-the-right the-class-is-idempotent]
  @conclusion |
    reducesToZero(ZERO)
    [using specialize the-cancellation(qcls(ZERO), qcls(ZERO), mod_n.ZERO) the-two-sums-agree]
qed

// -- REDUCTION OF A CUT POLYNOMIAL ---------------------------------------------------------
// Judson's "let α₁'(x) be the polynomial in ℤ_p[x] obtained by reducing the coefficients of
// α₁(x) modulo p" — from the cut this time, into the same ℤ_N[x].
func qreduce(p: QPoly) => ZnPoly
axiom qreduceCoefficientwise: forall p: QPoly; forall i: Nat;
  hasIntegerCoefficients(p) ->
  mod_n_poly.zcoeff(qreduce(p), i) = qcls(qpoly.qcoeff(p, i))

// A polynomial with a coefficient the modulus misses reduces to something nonzero — Judson's
// "there exists a coefficient a_i such that p ∤ a_i" giving α₁'(x) ≠ 0.
theorem aSurvivingCoefficientSurvivesReduction: forall p: QPoly; forall i: Nat;
  hasIntegerCoefficients(p) ->
  (not reducesToZero(qpoly.qcoeff(p, i))) ->
  (not (qreduce(p) = mod_n_poly.ZZEROP))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-i |
        fix i: Nat {
          @given-the-setup |
            assume hasIntegerCoefficients(p) and
              (not reducesToZero(qpoly.qcoeff(p, i))) {
              @the-setup |
                hasIntegerCoefficients(p) and
                  (not reducesToZero(qpoly.qcoeff(p, i)))
                [by hypothesis given-the-setup]
              @p-is-integral |
                hasIntegerCoefficients(p)
                [by and_lhs the-setup]
              @the-modulus-misses |
                not reducesToZero(qpoly.qcoeff(p, i))
                [by and_rhs the-setup]
              // `reducesToZero` is a define, so the hypothesis IS the negated class
              @the-class-survives |
                not (qcls(qpoly.qcoeff(p, i)) = mod_n.ZERO)
                [using tautology the-modulus-misses]
              // so the reduction has a nonzero coefficient, hence is not ZZEROP
              @the-reduced-coefficient |
                mod_n_poly.zcoeff(qreduce(p), i) =
                  qcls(qpoly.qcoeff(p, i))
                [using specialize qreduceCoefficientwise(p, i) p-is-integral]
              @the-reduced-coefficient-survives |
                not (mod_n_poly.zcoeff(qreduce(p), i) = mod_n.ZERO)
                [by rewrite the-reduced-coefficient the-class-survives]
              @given-the-reduction-vanishes |
                assume qreduce(p) = mod_n_poly.ZZEROP {
                  @the-reduction-vanishes |
                    qreduce(p) = mod_n_poly.ZZEROP
                    [by hypothesis given-the-reduction-vanishes]
                  @the-zero-coefficient |
                    mod_n_poly.zcoeff(mod_n_poly.ZZEROP, i) =
                      mod_n.ZERO
                    [using specialize mod_n_poly.zZeroPolyCoeff(i)]
                  @the-reduced-coefficient-vanishes |
                    mod_n_poly.zcoeff(qreduce(p), i) = mod_n.ZERO
                    [by rewrite the-reduction-vanishes the-zero-coefficient]
                }
              @conclusion-the-reduction-survives |
                not (qreduce(p) = mod_n_poly.ZZEROP)
                [by contradiction given-the-reduction-vanishes the-reduced-coefficient-vanishes the-reduced-coefficient-survives]
            }
          @the-implication |
            (hasIntegerCoefficients(p) and
              (not reducesToZero(qpoly.qcoeff(p, i)))) ->
              (not (qreduce(p) = mod_n_poly.ZZEROP))
            [by discharge given-the-setup]
          @curried |
            hasIntegerCoefficients(p) ->
              (not reducesToZero(qpoly.qcoeff(p, i))) ->
              (not (qreduce(p) = mod_n_poly.ZZEROP))
            [using tautology the-implication]
        }
      @discharge-i |
        forall i9: Nat;
          hasIntegerCoefficients(p) ->
          (not reducesToZero(qpoly.qcoeff(p, i9))) ->
          (not (qreduce(p) = mod_n_poly.ZZEROP))
        [by generalize generalize-i]
    }
  @conclusion |
    forall p: QPoly; forall i: Nat;
      hasIntegerCoefficients(p) ->
      (not reducesToZero(qpoly.qcoeff(p, i))) ->
      (not (qreduce(p) = mod_n_poly.ZZEROP))
    [by generalize generalize-p]
qed

// -- REDUCTION COMMUTES WITH MULTIPLICATION ------------------------------------------------
// Judson writes $\alpha_1'(x)\beta_1'(x)$ where he means $(\alpha_1\beta_1)'(x)$, which is
// only legitimate because reduction commutes with multiplication. He leaves that to the
// reader; it is proved here by induction on the convolution index, since the two convolution
// recursions are the same recursion and `qcls` is an additive and multiplicative homomorphism
// termwise.
theorem qreduceCommutesWithTheConvolution: forall p, q: QPoly;
  forall i, k: Nat;
  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
  mod_n_poly.zconvolution(qreduce(p), qreduce(q), i, k) =
  qcls(qpoly.qconvolution(p, q, i, k))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-i |
            fix i: Nat {
              @generalize-k |
                fix k: Nat {
                  @given-p-integral |
                    assume hasIntegerCoefficients(p) {
                      @p-is-integral |
                        hasIntegerCoefficients(p)
                        [by hypothesis given-p-integral]
                      @given-q-integral |
                        assume hasIntegerCoefficients(q) {
                          @q-is-integral |
                            hasIntegerCoefficients(q)
                            [by hypothesis given-q-integral]
                          @the-runs-agree-everywhere |
                            forall m: Nat; forall j: Nat;
                              mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                              j, m) =
                              qcls(qpoly.qconvolution(p, q, j, m))
                            [using specialize theReductionAtEveryBase(p, q)
                              p-is-integral q-is-integral]
                          @conclusion-the-reduction-commutes |
                            mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                              i, k) =
                              qcls(qpoly.qconvolution(p, q, i, k))
                            [using specialize the-runs-agree-everywhere(k, i)]
                        }
                      @q-integral-gives-it |
                        hasIntegerCoefficients(q) ->
                          mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                          i, k) =
                          qcls(qpoly.qconvolution(p, q, i, k))
                        [by discharge given-q-integral]
                    }
                  @p-integral-gives-it |
                    hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
                      mod_n_poly.zconvolution(qreduce(p), qreduce(q), i, k) =
                      qcls(qpoly.qconvolution(p, q, i, k))
                    [by discharge given-p-integral]
                }
              @discharge-k |
                forall k: Nat;
                  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
                  mod_n_poly.zconvolution(qreduce(p), qreduce(q), i, k) =
                  qcls(qpoly.qconvolution(p, q, i, k))
                [by generalize generalize-k]
            }
          @discharge-i |
            forall i, k: Nat;
              hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
              mod_n_poly.zconvolution(qreduce(p), qreduce(q), i, k) =
              qcls(qpoly.qconvolution(p, q, i, k))
            [by generalize generalize-i]
        }
      @discharge-q |
        forall q: QPoly; forall i, k: Nat;
          hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
          mod_n_poly.zconvolution(qreduce(p), qreduce(q), i, k) =
          qcls(qpoly.qconvolution(p, q, i, k))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; forall i, k: Nat;
      hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
      mod_n_poly.zconvolution(qreduce(p), qreduce(q), i, k) =
      qcls(qpoly.qconvolution(p, q, i, k))
    [by generalize generalize-p]
qed

// The base: each run is a single coefficient product, and `qcls` is multiplicative.
theorem theReductionBase: forall p, q: QPoly;
  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
  (forall j: Nat;
  mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, NAT_ZERO) =
  qcls(qpoly.qconvolution(p, q, j, NAT_ZERO)))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @given-p-integral |
            assume hasIntegerCoefficients(p) {
              @p-is-integral |
                hasIntegerCoefficients(p)
                [by hypothesis given-p-integral]
              @the-p-meaning |
                hasIntegerCoefficients(p) iff
                  (forall t: Nat; isInteger(qpoly.qcoeff(p, t)))
                [using specialize integerCoefficientsEverywhere(p)]
              @p-coefficients |
                forall t: Nat; isInteger(qpoly.qcoeff(p, t))
                [using tautology the-p-meaning p-is-integral]
              @given-q-integral |
                assume hasIntegerCoefficients(q) {
                  @q-is-integral |
                    hasIntegerCoefficients(q)
                    [by hypothesis given-q-integral]
                  @the-q-meaning |
                    hasIntegerCoefficients(q) iff
                      (forall t: Nat; isInteger(qpoly.qcoeff(q, t)))
                    [using specialize integerCoefficientsEverywhere(q)]
                  @q-coefficients |
                    forall t: Nat; isInteger(qpoly.qcoeff(q, t))
                    [using tautology the-q-meaning q-is-integral]
                  @generalize-j |
                    fix j: Nat {
                      @the-reduced-base |
                        mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                          j, NAT_ZERO) =
                          mod_n.mul(mod_n_poly.zcoeff(qreduce(p), j),
                          mod_n_poly.zcoeff(qreduce(q), NAT_ZERO))
                        [using specialize
                          mod_n_poly.zConvolutionZero(qreduce(p), qreduce(q), j)]
                      @the-base |
                        qpoly.qconvolution(p, q, j, NAT_ZERO) =
                          rational.mul(qpoly.qcoeff(p, j),
                          qpoly.qcoeff(q, NAT_ZERO))
                        [using specialize qpoly.qConvolutionZero(p, q, j)]
                      @p-at-j |
                        isInteger(qpoly.qcoeff(p, j))
                        [using specialize p-coefficients(j)]
                      @q-at-zero |
                        isInteger(qpoly.qcoeff(q, NAT_ZERO))
                        [using specialize q-coefficients(NAT_ZERO)]
                      @the-p-class-at-j |
                        mod_n_poly.zcoeff(qreduce(p), j) =
                          qcls(qpoly.qcoeff(p, j))
                        [using specialize qreduceCoefficientwise(p, j)
                          p-is-integral]
                      @the-q-class-at-zero |
                        mod_n_poly.zcoeff(qreduce(q), NAT_ZERO) =
                          qcls(qpoly.qcoeff(q, NAT_ZERO))
                        [using specialize qreduceCoefficientwise(q, NAT_ZERO)
                          q-is-integral]
                      @the-reduced-base-in-classes |
                        mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                          j, NAT_ZERO) =
                          mod_n.mul(qcls(qpoly.qcoeff(p, j)),
                          qcls(qpoly.qcoeff(q, NAT_ZERO)))
                        [using simplify the-reduced-base the-p-class-at-j
                          the-q-class-at-zero]
                      @the-classes-multiply |
                        mod_n.mul(qcls(qpoly.qcoeff(p, j)),
                          qcls(qpoly.qcoeff(q, NAT_ZERO))) =
                          qcls(rational.mul(qpoly.qcoeff(p, j),
                          qpoly.qcoeff(q, NAT_ZERO)))
                        [using specialize qclsMul(qpoly.qcoeff(p, j),
                          qpoly.qcoeff(q, NAT_ZERO)) p-at-j q-at-zero]
                      @the-reduced-base-folded |
                        mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                          j, NAT_ZERO) =
                          qcls(rational.mul(qpoly.qcoeff(p, j),
                          qpoly.qcoeff(q, NAT_ZERO)))
                        [using simplify the-reduced-base-in-classes
                          the-classes-multiply]
                      @conclusion-the-base-agrees |
                        mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                          j, NAT_ZERO) =
                          qcls(qpoly.qconvolution(p, q, j, NAT_ZERO))
                        [by rewrite the-base the-reduced-base-folded]
                    }
                  @all-bases |
                    forall j: Nat;
                      mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                      j, NAT_ZERO) =
                      qcls(qpoly.qconvolution(p, q, j, NAT_ZERO))
                    [by generalize generalize-j]
                }
              @q-integral-gives-it |
                hasIntegerCoefficients(q) ->
                  (forall j: Nat;
                  mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                  j, NAT_ZERO) =
                  qcls(qpoly.qconvolution(p, q, j, NAT_ZERO)))
                [by discharge given-q-integral]
            }
          @p-integral-gives-it |
            hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
              (forall j: Nat;
              mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, NAT_ZERO) =
              qcls(qpoly.qconvolution(p, q, j, NAT_ZERO)))
            [by discharge given-p-integral]
        }
      @discharge-q |
        forall q: QPoly;
          hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
          (forall j: Nat;
          mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, NAT_ZERO) =
          qcls(qpoly.qconvolution(p, q, j, NAT_ZERO)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly;
      hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
      (forall j: Nat;
      mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, NAT_ZERO) =
      qcls(qpoly.qconvolution(p, q, j, NAT_ZERO)))
    [by generalize generalize-p]
qed

// The step: each run peels its TOP term — p at the base, q at succ(m) — the two peeled terms
// correspond by `qclsMul`, the two tails by the hypothesis at base succ(j), and the two sums
// by `qclsAdd`. The additivity needs both summands integral, which is why the running
// convolution's integrality is established before the hypothesis is opened.
theorem theReductionStep: forall p, q: QPoly;
  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
  (forall m: Nat;
  (forall j: Nat;
  mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
  qcls(qpoly.qconvolution(p, q, j, m))) ->
  (forall j: Nat;
  mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, peano.succ(m)) =
  qcls(qpoly.qconvolution(p, q, j, peano.succ(m)))))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @given-p-integral |
            assume hasIntegerCoefficients(p) {
              @p-is-integral |
                hasIntegerCoefficients(p)
                [by hypothesis given-p-integral]
              @the-p-meaning |
                hasIntegerCoefficients(p) iff
                  (forall t: Nat; isInteger(qpoly.qcoeff(p, t)))
                [using specialize integerCoefficientsEverywhere(p)]
              @p-coefficients |
                forall t: Nat; isInteger(qpoly.qcoeff(p, t))
                [using tautology the-p-meaning p-is-integral]
              @given-q-integral |
                assume hasIntegerCoefficients(q) {
                  @q-is-integral |
                    hasIntegerCoefficients(q)
                    [by hypothesis given-q-integral]
                  @the-q-meaning |
                    hasIntegerCoefficients(q) iff
                      (forall t: Nat; isInteger(qpoly.qcoeff(q, t)))
                    [using specialize integerCoefficientsEverywhere(q)]
                  @q-coefficients |
                    forall t: Nat; isInteger(qpoly.qcoeff(q, t))
                    [using tautology the-q-meaning q-is-integral]
                  @generalize-m |
                    fix m: Nat {
                      @given-inductive-hypothesis |
                        assume forall j: Nat;
                          mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                          j, m) =
                          qcls(qpoly.qconvolution(p, q, j, m)) {
                          @inductive-hypothesis |
                            forall j: Nat;
                              mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                              j, m) =
                              qcls(qpoly.qconvolution(p, q, j, m))
                            [by hypothesis given-inductive-hypothesis]
                          @generalize-j |
                            fix j: Nat {
                              @the-reduced-run-peels |
                                mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                                  j, peano.succ(m)) =
                                  mod_n.add(
                                  mod_n.mul(
                                  mod_n_poly.zcoeff(qreduce(p), j),
                                  mod_n_poly.zcoeff(qreduce(q),
                                  peano.succ(m))),
                                  mod_n_poly.zconvolution(qreduce(p),
                                  qreduce(q), peano.succ(j), m))
                                [using specialize
                                  mod_n_poly.zConvolutionSucc(qreduce(p),
                                  qreduce(q), j, m)]
                              @the-run-peels |
                                qpoly.qconvolution(p, q, j, peano.succ(m)) =
                                  rational.add(
                                  rational.mul(qpoly.qcoeff(p, j),
                                  qpoly.qcoeff(q, peano.succ(m))),
                                  qpoly.qconvolution(p, q, peano.succ(j), m))
                                [using specialize
                                  qpoly.qConvolutionSucc(p, q, j, m)]
                              @p-at-j |
                                isInteger(qpoly.qcoeff(p, j))
                                [using specialize p-coefficients(j)]
                              @q-at-the-top |
                                isInteger(qpoly.qcoeff(q, peano.succ(m)))
                                [using specialize
                                  q-coefficients(peano.succ(m))]
                              @the-peeled-term-is-an-integer |
                                isInteger(rational.mul(qpoly.qcoeff(p, j),
                                  qpoly.qcoeff(q, peano.succ(m))))
                                [using specialize rational.isIntegerMul(
                                  qpoly.qcoeff(p, j),
                                  qpoly.qcoeff(q, peano.succ(m)))
                                  p-at-j q-at-the-top]
                              @the-tail-is-an-integer |
                                isInteger(qpoly.qconvolution(p, q,
                                  peano.succ(j), m))
                                [using specialize theConvolutionIsIntegral(
                                  p, q, peano.succ(j), m)
                                  p-is-integral q-is-integral]
                              @the-p-class-at-j |
                                mod_n_poly.zcoeff(qreduce(p), j) =
                                  qcls(qpoly.qcoeff(p, j))
                                [using specialize
                                  qreduceCoefficientwise(p, j) p-is-integral]
                              @the-q-class-at-the-top |
                                mod_n_poly.zcoeff(qreduce(q),
                                  peano.succ(m)) =
                                  qcls(qpoly.qcoeff(q, peano.succ(m)))
                                [using specialize qreduceCoefficientwise(q,
                                  peano.succ(m)) q-is-integral]
                              @the-peeled-classes-multiply |
                                mod_n.mul(qcls(qpoly.qcoeff(p, j)),
                                  qcls(qpoly.qcoeff(q, peano.succ(m)))) =
                                  qcls(rational.mul(qpoly.qcoeff(p, j),
                                  qpoly.qcoeff(q, peano.succ(m))))
                                [using specialize qclsMul(
                                  qpoly.qcoeff(p, j),
                                  qpoly.qcoeff(q, peano.succ(m)))
                                  p-at-j q-at-the-top]
                              @the-tails-agree |
                                mod_n_poly.zconvolution(qreduce(p),
                                  qreduce(q), peano.succ(j), m) =
                                  qcls(qpoly.qconvolution(p, q,
                                  peano.succ(j), m))
                                [using specialize
                                  inductive-hypothesis(peano.succ(j))]
                              @the-classes-add |
                                mod_n.add(
                                  qcls(rational.mul(qpoly.qcoeff(p, j),
                                  qpoly.qcoeff(q, peano.succ(m)))),
                                  qcls(qpoly.qconvolution(p, q,
                                  peano.succ(j), m))) =
                                  qcls(rational.add(
                                  rational.mul(qpoly.qcoeff(p, j),
                                  qpoly.qcoeff(q, peano.succ(m))),
                                  qpoly.qconvolution(p, q,
                                  peano.succ(j), m)))
                                [using specialize qclsAdd(
                                  rational.mul(qpoly.qcoeff(p, j),
                                  qpoly.qcoeff(q, peano.succ(m))),
                                  qpoly.qconvolution(p, q, peano.succ(j), m))
                                  the-peeled-term-is-an-integer
                                  the-tail-is-an-integer]
                              @conclusion-the-step-agrees |
                                mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                                  j, peano.succ(m)) =
                                  qcls(qpoly.qconvolution(p, q, j,
                                  peano.succ(m)))
                                [using simplify the-reduced-run-peels
                                  the-p-class-at-j the-q-class-at-the-top
                                  the-peeled-classes-multiply the-tails-agree
                                  the-classes-add the-run-peels]
                            }
                          @all-bases |
                            forall j: Nat;
                              mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                              j, peano.succ(m)) =
                              qcls(qpoly.qconvolution(p, q, j,
                              peano.succ(m)))
                            [by generalize generalize-j]
                        }
                      @the-hypothesis-gives-it |
                        (forall j: Nat;
                          mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                          j, m) =
                          qcls(qpoly.qconvolution(p, q, j, m))) ->
                          (forall j: Nat;
                          mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                          j, peano.succ(m)) =
                          qcls(qpoly.qconvolution(p, q, j, peano.succ(m))))
                        [by discharge given-inductive-hypothesis]
                    }
                  @all-lengths |
                    forall m: Nat;
                      (forall j: Nat;
                      mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
                      qcls(qpoly.qconvolution(p, q, j, m))) ->
                      (forall j: Nat;
                      mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                      j, peano.succ(m)) =
                      qcls(qpoly.qconvolution(p, q, j, peano.succ(m))))
                    [by generalize generalize-m]
                }
              @q-integral-gives-it |
                hasIntegerCoefficients(q) ->
                  (forall m: Nat;
                  (forall j: Nat;
                  mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
                  qcls(qpoly.qconvolution(p, q, j, m))) ->
                  (forall j: Nat;
                  mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                  j, peano.succ(m)) =
                  qcls(qpoly.qconvolution(p, q, j, peano.succ(m)))))
                [by discharge given-q-integral]
            }
          @p-integral-gives-it |
            hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
              (forall m: Nat;
              (forall j: Nat;
              mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
              qcls(qpoly.qconvolution(p, q, j, m))) ->
              (forall j: Nat;
              mod_n_poly.zconvolution(qreduce(p), qreduce(q),
              j, peano.succ(m)) =
              qcls(qpoly.qconvolution(p, q, j, peano.succ(m)))))
            [by discharge given-p-integral]
        }
      @discharge-q |
        forall q: QPoly;
          hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
          (forall m: Nat;
          (forall j: Nat;
          mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
          qcls(qpoly.qconvolution(p, q, j, m))) ->
          (forall j: Nat;
          mod_n_poly.zconvolution(qreduce(p), qreduce(q),
          j, peano.succ(m)) =
          qcls(qpoly.qconvolution(p, q, j, peano.succ(m)))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly;
      hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
      (forall m: Nat;
      (forall j: Nat;
      mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
      qcls(qpoly.qconvolution(p, q, j, m))) ->
      (forall j: Nat;
      mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, peano.succ(m)) =
      qcls(qpoly.qconvolution(p, q, j, peano.succ(m)))))
    [by generalize generalize-p]
qed

// The induction itself, at a fixed LENGTH, quantifying the BASE so the step can fire it one
// higher. Reindexing moved the recursion's moving part from a subtraction in the second
// factor's index to the base itself, so the hypothesis has to range over bases.
theorem theReductionAtEveryBase: forall p, q: QPoly;
  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
  (forall m: Nat; forall j: Nat;
  mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
  qcls(qpoly.qconvolution(p, q, j, m)))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @given-p-integral |
            assume hasIntegerCoefficients(p) {
              @p-is-integral |
                hasIntegerCoefficients(p)
                [by hypothesis given-p-integral]
              @given-q-integral |
                assume hasIntegerCoefficients(q) {
                  @q-is-integral |
                    hasIntegerCoefficients(q)
                    [by hypothesis given-q-integral]
                  @base-case |
                    forall j: Nat;
                      mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                      j, NAT_ZERO) =
                      qcls(qpoly.qconvolution(p, q, j, NAT_ZERO))
                    [using specialize theReductionBase(p, q)
                      p-is-integral q-is-integral]
                  @induction-step-for-all-m |
                    forall m: Nat;
                      (forall j: Nat;
                      mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
                      qcls(qpoly.qconvolution(p, q, j, m))) ->
                      (forall j: Nat;
                      mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                      j, peano.succ(m)) =
                      qcls(qpoly.qconvolution(p, q, j, peano.succ(m))))
                    [using specialize theReductionStep(p, q)
                      p-is-integral q-is-integral]
                  @all-lengths |
                    forall m: Nat; forall j: Nat;
                      mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
                      qcls(qpoly.qconvolution(p, q, j, m))
                    [using instantiation peano.induction((fun z: Nat => forall j: Nat; mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, z) = qcls(qpoly.qconvolution(p, q, j, z)))) base-case induction-step-for-all-m]
                }
              @q-integral-gives-it |
                hasIntegerCoefficients(q) ->
                  (forall m: Nat; forall j: Nat;
                  mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
                  qcls(qpoly.qconvolution(p, q, j, m)))
                [by discharge given-q-integral]
            }
          @p-integral-gives-it |
            hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
              (forall m: Nat; forall j: Nat;
              mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
              qcls(qpoly.qconvolution(p, q, j, m)))
            [by discharge given-p-integral]
        }
      @discharge-q |
        forall q: QPoly;
          hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
          (forall m: Nat; forall j: Nat;
          mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
          qcls(qpoly.qconvolution(p, q, j, m)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly;
      hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
      (forall m: Nat; forall j: Nat;
      mod_n_poly.zconvolution(qreduce(p), qreduce(q), j, m) =
      qcls(qpoly.qconvolution(p, q, j, m)))
    [by generalize generalize-p]
qed

// Reduction is multiplicative: Judson's α₁'β₁' = (α₁β₁)'.
theorem qreduceIsMultiplicative: forall p, q: QPoly;
  hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
  mod_n_poly.zmulP(qreduce(p), qreduce(q)) =
  qreduce(qpoly.qmulP(p, q))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @given-both |
            assume hasIntegerCoefficients(p) and
              hasIntegerCoefficients(q) {
              @both |
                hasIntegerCoefficients(p) and
                  hasIntegerCoefficients(q)
                [by hypothesis given-both]
              @p-is-integral |
                hasIntegerCoefficients(p)
                [by and_lhs both]
              @q-is-integral |
                hasIntegerCoefficients(q)
                [by and_rhs both]
              @the-product-is-integral |
                hasIntegerCoefficients(qpoly.qmulP(p, q))
                [using specialize theProductIsIntegral(p, q) p-is-integral q-is-integral]
              @each-index |
                fix i: Nat {
                  // the reduced product's coefficient
                  @the-reduced-product-coefficient |
                    mod_n_poly.zcoeff(
                      mod_n_poly.zmulP(qreduce(p), qreduce(q)), i) =
                      mod_n_poly.zconvolution(qreduce(p),
                      qreduce(q), NAT_ZERO, i)
                    [using specialize mod_n_poly.zMulPolyCoeff(qreduce(p), qreduce(q), i)]
                  @the-convolutions-agree |
                    mod_n_poly.zconvolution(qreduce(p), qreduce(q),
                      NAT_ZERO, i) =
                      qcls(qpoly.qconvolution(p, q, NAT_ZERO, i))
                    [using specialize qreduceCommutesWithTheConvolution(p, q, NAT_ZERO, i) p-is-integral q-is-integral]
                  @the-reduced-product-in-classes |
                    mod_n_poly.zcoeff(
                      mod_n_poly.zmulP(qreduce(p), qreduce(q)), i) =
                      qcls(qpoly.qconvolution(p, q, NAT_ZERO, i))
                    [using simplify the-reduced-product-coefficient the-convolutions-agree]
                  // the product's own reduced coefficient
                  @the-product-coefficient |
                    qpoly.qcoeff(qpoly.qmulP(p, q), i) =
                      qpoly.qconvolution(p, q, NAT_ZERO, i)
                    [using specialize qpoly.qMulPolyCoeff(p, q, i)]
                  @the-reduction-of-the-product |
                    mod_n_poly.zcoeff(qreduce(qpoly.qmulP(p, q)),
                      i) =
                      qcls(qpoly.qcoeff(qpoly.qmulP(p, q), i))
                    [using specialize qreduceCoefficientwise(qpoly.qmulP(p, q), i) the-product-is-integral]
                  @the-reduction-in-the-convolution |
                    mod_n_poly.zcoeff(qreduce(qpoly.qmulP(p, q)),
                      i) =
                      qcls(qpoly.qconvolution(p, q, NAT_ZERO, i))
                    [by rewrite the-product-coefficient the-reduction-of-the-product]
                  @conclusion-agree-at-i |
                    mod_n_poly.zcoeff(
                      mod_n_poly.zmulP(qreduce(p), qreduce(q)), i) =
                      mod_n_poly.zcoeff(
                      qreduce(qpoly.qmulP(p, q)), i)
                    [using simplify the-reduced-product-in-classes the-reduction-in-the-convolution]
                }
              @all-coefficients-agree |
                forall i: Nat;
                  mod_n_poly.zcoeff(
                  mod_n_poly.zmulP(qreduce(p), qreduce(q)), i) =
                  mod_n_poly.zcoeff(qreduce(qpoly.qmulP(p, q)), i)
                [by generalize each-index]
              @the-extensionality |
                forall a, b: ZnPoly;
                  (forall i: Nat;
                  mod_n_poly.zcoeff(a, i) =
                  mod_n_poly.zcoeff(b, i)) -> a = b
                [using import(mod_n_poly) zPolyExtensionality]
              @conclusion-multiplicative |
                mod_n_poly.zmulP(qreduce(p), qreduce(q)) =
                  qreduce(qpoly.qmulP(p, q))
                [using specialize the-extensionality(mod_n_poly.zmulP(qreduce(p), qreduce(q)), qreduce(qpoly.qmulP(p, q))) all-coefficients-agree]
            }
          @the-implication |
            (hasIntegerCoefficients(p) and
              hasIntegerCoefficients(q)) ->
              mod_n_poly.zmulP(qreduce(p), qreduce(q)) =
              qreduce(qpoly.qmulP(p, q))
            [by discharge given-both]
          @curried |
            hasIntegerCoefficients(p) ->
              hasIntegerCoefficients(q) ->
              mod_n_poly.zmulP(qreduce(p), qreduce(q)) =
              qreduce(qpoly.qmulP(p, q))
            [using tautology the-implication]
        }
      @discharge-q |
        forall q9: QPoly;
          hasIntegerCoefficients(p) -> hasIntegerCoefficients(q9) ->
          mod_n_poly.zmulP(qreduce(p), qreduce(q9)) =
          qreduce(qpoly.qmulP(p, q9))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly;
      hasIntegerCoefficients(p) -> hasIntegerCoefficients(q) ->
      mod_n_poly.zmulP(qreduce(p), qreduce(q)) =
      qreduce(qpoly.qmulP(p, q))
    [by generalize generalize-p]
qed

// A polynomial every coefficient of which the modulus divides reduces to ZERO.
theorem aPolynomialTheModulusDividesReducesToZero: forall f: QPoly;
  hasIntegerCoefficients(f) ->
  (forall i: Nat; reducesToZero(qpoly.qcoeff(f, i))) ->
  qreduce(f) = mod_n_poly.ZZEROP
proof
  @generalize-f |
    fix f: QPoly {
      @given-the-setup |
        assume hasIntegerCoefficients(f) and
          (forall i: Nat;
          reducesToZero(qpoly.qcoeff(f, i))) {
          @the-setup |
            hasIntegerCoefficients(f) and
              (forall i: Nat;
              reducesToZero(qpoly.qcoeff(f, i)))
            [by hypothesis given-the-setup]
          @f-is-integral |
            hasIntegerCoefficients(f)
            [by and_lhs the-setup]
          @the-modulus-divides-everything |
            forall i: Nat;
              reducesToZero(qpoly.qcoeff(f, i))
            [by and_rhs the-setup]
          @each-index |
            fix i: Nat {
              @the-modulus-divides-it |
                reducesToZero(qpoly.qcoeff(f, i))
                [using specialize the-modulus-divides-everything(i)]
              @the-class-vanishes |
                qcls(qpoly.qcoeff(f, i)) = mod_n.ZERO
                [using tautology the-modulus-divides-it]
              @the-reduced-coefficient |
                mod_n_poly.zcoeff(qreduce(f), i) =
                  qcls(qpoly.qcoeff(f, i))
                [using specialize qreduceCoefficientwise(f, i) f-is-integral]
              @the-reduced-coefficient-vanishes |
                mod_n_poly.zcoeff(qreduce(f), i) = mod_n.ZERO
                [using simplify the-reduced-coefficient the-class-vanishes]
              @the-zero-polynomials-coefficient |
                mod_n_poly.zcoeff(mod_n_poly.ZZEROP, i) =
                  mod_n.ZERO
                [using specialize mod_n_poly.zZeroPolyCoeff(i)]
              @conclusion-agree-at-i |
                mod_n_poly.zcoeff(qreduce(f), i) =
                  mod_n_poly.zcoeff(mod_n_poly.ZZEROP, i)
                [using simplify the-reduced-coefficient-vanishes the-zero-polynomials-coefficient]
            }
          @all-coefficients-agree |
            forall i: Nat;
              mod_n_poly.zcoeff(qreduce(f), i) =
              mod_n_poly.zcoeff(mod_n_poly.ZZEROP, i)
            [by generalize each-index]
          @the-extensionality |
            forall a, b: ZnPoly;
              (forall i: Nat;
              mod_n_poly.zcoeff(a, i) =
              mod_n_poly.zcoeff(b, i)) -> a = b
            [using import(mod_n_poly) zPolyExtensionality]
          @conclusion-reduces-to-zero |
            qreduce(f) = mod_n_poly.ZZEROP
            [using specialize the-extensionality(qreduce(f), mod_n_poly.ZZEROP) all-coefficients-agree]
        }
      @the-implication |
        (hasIntegerCoefficients(f) and
          (forall i: Nat;
          reducesToZero(qpoly.qcoeff(f, i)))) ->
          qreduce(f) = mod_n_poly.ZZEROP
        [by discharge given-the-setup]
      @curried |
        hasIntegerCoefficients(f) ->
          (forall i: Nat;
          reducesToZero(qpoly.qcoeff(f, i))) ->
          qreduce(f) = mod_n_poly.ZZEROP
        [using tautology the-implication]
    }
  @conclusion |
    forall f: QPoly;
      hasIntegerCoefficients(f) ->
      (forall i: Nat; reducesToZero(qpoly.qcoeff(f, i))) ->
      qreduce(f) = mod_n_poly.ZZEROP
    [by generalize generalize-f]
qed

// -- THE REDUCTION ARGUMENT, ON THE CUT ----------------------------------------------------
// The engine of both Gauss's d ≠ 1 case and Eisenstein's Criterion, now stated about
// polynomials in ℚ[x] rather than in a separate ℤ[x] sort.
//
// Judson: reduce both factors modulo the prime. The product reduces to zero, because the
// modulus divides every coefficient of the product. But ℤ_N[x] is an integral domain and
// neither factor reduced to zero. Contradiction.
//
// `modNPolynomialsHaveNoZeroDivisors` is cited DIRECTLY — it is a fact about ℤ_N[x] with no ℚ
// in it, so no transfer is involved. That is what made this reproof affordable.
// THIS IS THE GENERAL STATEMENT, not a statement about one particular prime. `mod_n.N` is a
// FIXED BUT ARBITRARY positive constant — `std/integer/mod-n.b4m` assumes nothing about it
// beyond `nPositive`, and `--axioms` on this theorem shows `nPositive` is not even reached:
// the only `mod_n` axioms in its base are the quotient and homomorphism laws. Primality
// arrives as a HYPOTHESIS. So the theorem holds of every prime, by the arbitrariness of the
// constant.
//
// That is the sanctioned pattern here rather than a shortcut: the ℤ_n-via-models spike
// settled that ℤ_n needs no indexed sorts, and quantifying over the modulus would require
// ℤ_p over the ℚ-cut — the one ℤ_n composition that is architecturally parked
// (`scratch-needswork/q-z6.b4m` still reaches the wall). Judson's own "for all n" is always
// "fix n and reason", which is exactly this.
theorem theModulusCannotDivideEveryProductCoefficient: forall f, g: QPoly;
  forall i, j: Nat;
  mod_n_poly.is_prime(mod_n.N) ->
  hasIntegerCoefficients(f) -> hasIntegerCoefficients(g) ->
  (not reducesToZero(qpoly.qcoeff(f, i))) ->
  (not reducesToZero(qpoly.qcoeff(g, j))) ->
  (not (forall t: Nat;
  reducesToZero(qpoly.qcoeff(qpoly.qmulP(f, g), t))))
proof
  @generalize-f |
    fix f: QPoly {
      @generalize-g |
        fix g: QPoly {
          @generalize-i |
            fix i: Nat {
              @generalize-j |
                fix j: Nat {
                  @given-the-setup |
                    assume mod_n_poly.is_prime(mod_n.N) and
                      hasIntegerCoefficients(f) and
                      hasIntegerCoefficients(g) and
                      (not reducesToZero(qpoly.qcoeff(f, i))) and
                      (not reducesToZero(qpoly.qcoeff(g, j))) {
                      @the-setup |
                        mod_n_poly.is_prime(mod_n.N) and
                          hasIntegerCoefficients(f) and
                          hasIntegerCoefficients(g) and
                          (not reducesToZero(qpoly.qcoeff(f, i))) and
                          (not reducesToZero(qpoly.qcoeff(g, j)))
                        [by hypothesis given-the-setup]
                      @the-modulus-is-prime |
                        mod_n_poly.is_prime(mod_n.N)
                        [using tautology the-setup]
                      @f-is-integral |
                        hasIntegerCoefficients(f)
                        [using tautology the-setup]
                      @g-is-integral |
                        hasIntegerCoefficients(g)
                        [using tautology the-setup]
                      @the-modulus-misses-f |
                        not reducesToZero(qpoly.qcoeff(f, i))
                        [using tautology the-setup]
                      @the-modulus-misses-g |
                        not reducesToZero(qpoly.qcoeff(g, j))
                        [using tautology the-setup]
                      // neither factor reduces to zero
                      @f-survives |
                        not (qreduce(f) = mod_n_poly.ZZEROP)
                        [using specialize aSurvivingCoefficientSurvivesReduction(f, i) f-is-integral the-modulus-misses-f]
                      @g-survives |
                        not (qreduce(g) = mod_n_poly.ZZEROP)
                        [using specialize aSurvivingCoefficientSurvivesReduction(g, j) g-is-integral the-modulus-misses-g]
                      // so neither does their product, ℤ_N[x] being a domain
                      @the-domain-property |
                        forall a, b: ZnPoly;
                          mod_n_poly.is_prime(mod_n.N) ->
                          (not (a = mod_n_poly.ZZEROP)) ->
                          (not (b = mod_n_poly.ZZEROP)) ->
                          (not (mod_n_poly.zmulP(a, b) =
                          mod_n_poly.ZZEROP))
                        [using import(mod_n_poly) modNPolynomialsHaveNoZeroDivisors]
                      @the-reduced-product-survives |
                        not (mod_n_poly.zmulP(qreduce(f),
                          qreduce(g)) = mod_n_poly.ZZEROP)
                        [using specialize the-domain-property(qreduce(f), qreduce(g)) the-modulus-is-prime f-survives g-survives]
                      @the-reductions-multiply |
                        mod_n_poly.zmulP(qreduce(f), qreduce(g)) =
                          qreduce(qpoly.qmulP(f, g))
                        [using specialize qreduceIsMultiplicative(f, g) f-is-integral g-is-integral]
                      @the-products-reduction-survives |
                        not (qreduce(qpoly.qmulP(f, g)) =
                          mod_n_poly.ZZEROP)
                        [by rewrite the-reductions-multiply the-reduced-product-survives]
                      // but if the modulus divided every product coefficient, it would vanish
                      @the-product-is-integral |
                        hasIntegerCoefficients(qpoly.qmulP(f, g))
                        [using specialize theProductIsIntegral(f, g) f-is-integral g-is-integral]
                      @given-the-modulus-divides-everything |
                        assume forall t: Nat;
                          reducesToZero(qpoly.qcoeff(qpoly.qmulP(f, g), t)) {
                          @the-modulus-divides-everything |
                            forall t: Nat;
                              reducesToZero(qpoly.qcoeff(qpoly.qmulP(f, g), t))
                            [by hypothesis given-the-modulus-divides-everything]
                          @the-products-reduction-vanishes |
                            qreduce(qpoly.qmulP(f, g)) =
                              mod_n_poly.ZZEROP
                            [using specialize aPolynomialTheModulusDividesReducesToZero(qpoly.qmulP(f, g)) the-product-is-integral the-modulus-divides-everything]
                        }
                      @conclusion-the-absurdity |
                        not (forall t: Nat;
                          reducesToZero(qpoly.qcoeff(qpoly.qmulP(f, g), t)))
                        [by contradiction given-the-modulus-divides-everything the-products-reduction-vanishes the-products-reduction-survives]
                    }
                  @the-implication |
                    (mod_n_poly.is_prime(mod_n.N) and
                      hasIntegerCoefficients(f) and
                      hasIntegerCoefficients(g) and
                      (not reducesToZero(qpoly.qcoeff(f, i))) and
                      (not reducesToZero(qpoly.qcoeff(g, j)))) ->
                      (not (forall t: Nat;
                      reducesToZero(qpoly.qcoeff(qpoly.qmulP(f, g), t))))
                    [by discharge given-the-setup]
                  @curried |
                    mod_n_poly.is_prime(mod_n.N) ->
                      hasIntegerCoefficients(f) ->
                      hasIntegerCoefficients(g) ->
                      (not reducesToZero(qpoly.qcoeff(f, i))) ->
                      (not reducesToZero(qpoly.qcoeff(g, j))) ->
                      (not (forall t: Nat;
                      reducesToZero(qpoly.qcoeff(qpoly.qmulP(f, g), t))))
                    [using tautology the-implication]
                }
              @discharge-j |
                forall j9: Nat;
                  mod_n_poly.is_prime(mod_n.N) ->
                  hasIntegerCoefficients(f) ->
                  hasIntegerCoefficients(g) ->
                  (not reducesToZero(qpoly.qcoeff(f, i))) ->
                  (not reducesToZero(qpoly.qcoeff(g, j9))) ->
                  (not (forall t: Nat;
                  reducesToZero(qpoly.qcoeff(qpoly.qmulP(f, g), t))))
                [by generalize generalize-j]
            }
          @discharge-i |
            forall i9, j9: Nat;
              mod_n_poly.is_prime(mod_n.N) ->
              hasIntegerCoefficients(f) ->
              hasIntegerCoefficients(g) ->
              (not reducesToZero(qpoly.qcoeff(f, i9))) ->
              (not reducesToZero(qpoly.qcoeff(g, j9))) ->
              (not (forall t: Nat;
              reducesToZero(qpoly.qcoeff(qpoly.qmulP(f, g), t))))
            [by generalize generalize-i]
        }
      @discharge-g |
        forall g9: QPoly; forall i9, j9: Nat;
          mod_n_poly.is_prime(mod_n.N) ->
          hasIntegerCoefficients(f) ->
          hasIntegerCoefficients(g9) ->
          (not reducesToZero(qpoly.qcoeff(f, i9))) ->
          (not reducesToZero(qpoly.qcoeff(g9, j9))) ->
          (not (forall t: Nat;
          reducesToZero(qpoly.qcoeff(qpoly.qmulP(f, g9), t))))
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: QPoly; forall i, j: Nat;
      mod_n_poly.is_prime(mod_n.N) ->
      hasIntegerCoefficients(f) -> hasIntegerCoefficients(g) ->
      (not reducesToZero(qpoly.qcoeff(f, i))) ->
      (not reducesToZero(qpoly.qcoeff(g, j))) ->
      (not (forall t: Nat;
      reducesToZero(qpoly.qcoeff(qpoly.qmulP(f, g), t))))
    [by generalize generalize-f]
qed

// -- EISENSTEIN'S SIGN ARGUMENT, AT THE MODULUS --------------------------------------------
// Judson's `p | a_0` with `p² ∤ a_0` is what produces "p misses a coefficient of one factor".
// `std/rational/integer-product.b4m` proves that for a parameterised prime via Bézout; here it
// is restated for the MODULUS, which is the form the reduction argument above consumes.
//
// Restating rather than citing is what lets the two halves compose: the parameterised version
// speaks in `dividesIntegrally(p, ·)`, the reduction argument in `reducesToZero`, and there is
// no sound bridge between them (an earlier attempt at one is what introduced the two-modulus
// defect). Nothing is lost by restating at the modulus, because the modulus is an arbitrary
// positive constant — see the note on the reduction theorem.
//
// At the modulus the argument is also SHORTER: `reducesToZero` is `qcls(·) = ZERO`, so
// "N divides a product" is a vanishing class product, and ℤ_N having no zero divisors
// (`aPrimeModulusHasNoZeroDivisors`, a fact about ℤ_N with no ℚ in it) is immediate. The
// parameterised version needs Bézout for the same step.
theorem theModulusMissesOneFactor: forall b, c: Q;
  isInteger(b) -> isInteger(c) ->
  mod_n_domain.is_prime(mod_n.N) ->
  reducesToZero(rational.mul(b, c)) ->
  (reducesToZero(b) or reducesToZero(c))
proof
  @generalize-b |
    fix b: Q {
      @generalize-c |
        fix c: Q {
          @given-the-setup |
            assume isInteger(b) and isInteger(c) and
              mod_n_domain.is_prime(mod_n.N) and
              reducesToZero(rational.mul(b, c)) {
              @the-setup |
                isInteger(b) and isInteger(c) and
                  mod_n_domain.is_prime(mod_n.N) and
                  reducesToZero(rational.mul(b, c))
                [by hypothesis given-the-setup]
              @b-is-an-integer |
                isInteger(b)
                [using tautology the-setup]
              @c-is-an-integer |
                isInteger(c)
                [using tautology the-setup]
              @the-modulus-is-prime |
                mod_n_domain.is_prime(mod_n.N)
                [using tautology the-setup]
              @the-product-vanishes |
                reducesToZero(rational.mul(b, c))
                [using tautology the-setup]
              // the class of the product is the product of the classes
              @the-classes-multiply |
                mod_n.mul(qcls(b), qcls(c)) =
                  qcls(rational.mul(b, c))
                [using specialize qclsMul(b, c) b-is-an-integer c-is-an-integer]
              @the-class-product-vanishes |
                mod_n.mul(qcls(b), qcls(c)) = mod_n.ZERO
                [using simplify the-classes-multiply the-product-vanishes]
              // ℤ_N is a domain, so one of the classes vanishes
              @the-domain-property |
                forall x, y: Zn;
                  mod_n_domain.is_prime(mod_n.N) ->
                  mod_n.mul(x, y) = mod_n.ZERO ->
                  (x = mod_n.ZERO or y = mod_n.ZERO)
                [using import(mod_n_domain) aPrimeModulusHasNoZeroDivisors]
              @conclusion-one-vanishes |
                reducesToZero(b) or reducesToZero(c)
                [using specialize the-domain-property(qcls(b), qcls(c)) the-modulus-is-prime the-class-product-vanishes]
            }
          @the-implication |
            (isInteger(b) and isInteger(c) and
              mod_n_domain.is_prime(mod_n.N) and
              reducesToZero(rational.mul(b, c))) ->
              (reducesToZero(b) or reducesToZero(c))
            [by discharge given-the-setup]
          @curried |
            isInteger(b) -> isInteger(c) ->
              mod_n_domain.is_prime(mod_n.N) ->
              reducesToZero(rational.mul(b, c)) ->
              (reducesToZero(b) or reducesToZero(c))
            [using tautology the-implication]
        }
      @discharge-c |
        forall c9: Q;
          isInteger(b) -> isInteger(c9) ->
          mod_n_domain.is_prime(mod_n.N) ->
          reducesToZero(rational.mul(b, c9)) ->
          (reducesToZero(b) or reducesToZero(c9))
        [by generalize generalize-c]
    }
  @conclusion |
    forall b, c: Q;
      isInteger(b) -> isInteger(c) ->
      mod_n_domain.is_prime(mod_n.N) ->
      reducesToZero(rational.mul(b, c)) ->
      (reducesToZero(b) or reducesToZero(c))
    [by generalize generalize-b]
qed

// The sharp form of Eisenstein's third hypothesis, as the argument actually uses it: if the
// modulus does not divide BOTH constant factors, at least one survives.
//
// This is pure propositional restructuring — no integrality and no `N²` term is needed, which
// is why there is still only one modulus. Judson phrases the hypothesis as `p² ∤ a_0`; what
// the proof consumes is "not both", and deriving one from the other would need `N²` as a cut
// element, reintroducing exactly the second-modulus problem. So the hypothesis is stated in
// the form that is used, and the `p²` phrasing stays in the prose where it belongs.
theorem theModulusMissesAFactorWhenItMissesTheSquare: forall b, c: Q;
  (not (reducesToZero(b) and reducesToZero(c))) ->
  ((not reducesToZero(b)) or (not reducesToZero(c)))
proof
  @generalize-b |
    fix b: Q {
      @generalize-c |
        fix c: Q {
          @given-not-both |
            assume not (reducesToZero(b) and reducesToZero(c)) {
              @not-both |
                not (reducesToZero(b) and reducesToZero(c))
                [by hypothesis given-not-both]
              @conclusion-one-survives |
                (not reducesToZero(b)) or (not reducesToZero(c))
                [using tautology not-both]
            }
          @the-implication |
            (not (reducesToZero(b) and reducesToZero(c))) ->
              ((not reducesToZero(b)) or (not reducesToZero(c)))
            [by discharge given-not-both]
        }
      @discharge-c |
        forall c9: Q;
          (not (reducesToZero(b) and reducesToZero(c9))) ->
          ((not reducesToZero(b)) or (not reducesToZero(c9)))
        [by generalize generalize-c]
    }
  @conclusion |
    forall b, c: Q;
      (not (reducesToZero(b) and reducesToZero(c))) ->
      ((not reducesToZero(b)) or (not reducesToZero(c)))
    [by generalize generalize-b]
qed

// The constant term of a product is the product of the constant terms — the convolution at
// index ZERO has a single summand.
theorem theConstantTermOfAProduct: forall f, g: QPoly;
  qpoly.qcoeff(qpoly.qmulP(f, g), NAT_ZERO) =
  rational.mul(qpoly.qcoeff(f, NAT_ZERO), qpoly.qcoeff(g, NAT_ZERO))
proof
  @generalize-f |
    fix f: QPoly {
      @generalize-g |
        fix g: QPoly {
          @the-coefficient-is-the-convolution |
            qpoly.qcoeff(qpoly.qmulP(f, g), NAT_ZERO) =
              qpoly.qconvolution(f, g, NAT_ZERO, NAT_ZERO)
            [using specialize qpoly.qMulPolyCoeff(f, g, NAT_ZERO)]
          @the-convolution-at-zero |
            qpoly.qconvolution(f, g, NAT_ZERO, NAT_ZERO) =
              rational.mul(qpoly.qcoeff(f, NAT_ZERO),
              qpoly.qcoeff(g, NAT_ZERO))
            [using specialize qpoly.qConvolutionZero(f, g, NAT_ZERO)]
          @conclusion-the-constant-term |
            qpoly.qcoeff(qpoly.qmulP(f, g), NAT_ZERO) =
              rational.mul(qpoly.qcoeff(f, NAT_ZERO),
              qpoly.qcoeff(g, NAT_ZERO))
            [using simplify the-coefficient-is-the-convolution the-convolution-at-zero]
        }
      @discharge-g |
        forall g9: QPoly;
          qpoly.qcoeff(qpoly.qmulP(f, g9), NAT_ZERO) =
          rational.mul(qpoly.qcoeff(f, NAT_ZERO),
          qpoly.qcoeff(g9, NAT_ZERO))
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: QPoly;
      qpoly.qcoeff(qpoly.qmulP(f, g), NAT_ZERO) =
      rational.mul(qpoly.qcoeff(f, NAT_ZERO),
      qpoly.qcoeff(g, NAT_ZERO))
    [by generalize generalize-f]
qed

// -- THE CONVOLUTION-DIVISIBILITY CLOSURE --------------------------------------------------
// The step Eisenstein needs and the one I twice mis-scoped: if the modulus divides EVERY
// coefficient of g, it divides every coefficient of g·h.
//
// Under `reducesToZero` this is clean. Every summand of `qconvolution(g, h, i, k)` is
// `qcoeff(g, j) · qcoeff(h, …)`, whose class is `qcls(g_j) · qcls(h_…)` by `qclsMul` — and the
// left factor vanishes by hypothesis, so the summand's class is `0 · x = 0`. Induction on the
// convolution index then adds zeros.
//
// Contrapositive at `i = n`: if the modulus misses `a_n` it must miss some coefficient of g,
// which is the surviving-coefficient fact the reduction argument wants of each factor.

// ℤ_N's zero-product law, from `mulHom` and ℤ's own `mulZeroLeft`. Not in `mod-n.b4m`.
theorem theZeroClassAnnihilates: forall x: Zn;
  mod_n.mul(mod_n.ZERO, x) = mod_n.ZERO
proof
  @generalize-x |
    fix x: Zn {
      @representatives-exist |
        forall z: Zn; exists k: integer.Int; z = mod_n.cls(k)
        [using import(mod_n) clsSurjective]
      @a-representative-exists |
        exists k: integer.Int; x = mod_n.cls(k)
        [using specialize representatives-exist(x)]
      @with-the-representative |
        unpack k: integer.Int from a-representative-exists {
          @x-is-a-class |
            x = mod_n.cls(k)
            [by hypothesis with-the-representative]
          @the-zero-class |
            mod_n.ZERO = mod_n.cls(integer.ZERO)
            [using import(mod_n) zeroIsClsZero]
          @the-product-of-classes |
            mod_n.mul(mod_n.cls(integer.ZERO), mod_n.cls(k)) =
              mod_n.cls(integer.mul(integer.ZERO, k))
            [using specialize mod_n.mulHom(integer.ZERO, k)]
          @the-zero-product-law |
            forall b: integer.Int;
              integer.mul(integer.ZERO, b) = integer.ZERO
            [using import(integer) mulZeroLeft]
          @zero-times-k |
            integer.mul(integer.ZERO, k) = integer.ZERO
            [using specialize the-zero-product-law(k)]
          @the-product-is-the-zero-class |
            mod_n.mul(mod_n.cls(integer.ZERO), mod_n.cls(k)) =
              mod_n.cls(integer.ZERO)
            [using simplify the-product-of-classes zero-times-k]
          @the-product-at-the-representative |
            mod_n.mul(mod_n.ZERO, mod_n.cls(k)) =
              mod_n.cls(integer.ZERO)
            [by rewrite the-zero-class the-product-is-the-zero-class]
          @the-product-folded |
            mod_n.mul(mod_n.ZERO, mod_n.cls(k)) = mod_n.ZERO
            [by rewrite the-zero-class the-product-at-the-representative]
          @conclusion-annihilates-at-k |
            mod_n.mul(mod_n.ZERO, x) = mod_n.ZERO
            [by rewrite x-is-a-class the-product-folded]
        }
      @conclusion-annihilates |
        mod_n.mul(mod_n.ZERO, x) = mod_n.ZERO
        [by unpacked with-the-representative]
    }
  @conclusion |
    forall x: Zn; mod_n.mul(mod_n.ZERO, x) = mod_n.ZERO
    [by generalize generalize-x]
qed

// Every partial convolution vanishes when the modulus kills the left factor's coefficients.
// The induction behind it, quantifying the BASE inside so the step can fire it one higher.
// Reindexing moved the recursion's moving part to the base, so the hypothesis ranges over
// bases rather than over a subtraction in h's index.
theorem theVanishingAtEveryBase: forall g, h: QPoly;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
  (forall m: Nat; forall j: Nat;
  reducesToZero(qpoly.qconvolution(g, h, j, m)))
proof
  @generalize-g |
    fix g: QPoly {
      @generalize-h |
        fix h: QPoly {
          @given-g-integral |
            assume hasIntegerCoefficients(g) {
              @g-is-integral |
                hasIntegerCoefficients(g)
                [by hypothesis given-g-integral]
              @given-h-integral |
                assume hasIntegerCoefficients(h) {
                  @h-is-integral |
                    hasIntegerCoefficients(h)
                    [by hypothesis given-h-integral]
                  @given-g-vanishes |
                    assume forall j: Nat;
                      reducesToZero(qpoly.qcoeff(g, j)) {
                      @every-g-coefficient-vanishes |
                        forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))
                        [by hypothesis given-g-vanishes]
                      @base-case |
                        forall j: Nat;
                          reducesToZero(
                          qpoly.qconvolution(g, h, j, NAT_ZERO))
                        [using specialize theVanishingBase(g, h)
                          g-is-integral h-is-integral
                          every-g-coefficient-vanishes]
                      @induction-step-for-all-m |
                        forall m: Nat;
                          (forall j: Nat;
                          reducesToZero(qpoly.qconvolution(g, h, j, m))) ->
                          (forall j: Nat;
                          reducesToZero(qpoly.qconvolution(g, h, j,
                          peano.succ(m))))
                        [using specialize theVanishingStep(g, h)
                          g-is-integral h-is-integral
                          every-g-coefficient-vanishes]
                      @all-lengths |
                        forall m: Nat; forall j: Nat;
                          reducesToZero(qpoly.qconvolution(g, h, j, m))
                        [using instantiation peano.induction((fun z: Nat => forall j: Nat; reducesToZero(qpoly.qconvolution(g, h, j, z)))) base-case induction-step-for-all-m]
                    }
                  @g-vanishing-gives-it |
                    (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
                      (forall m: Nat; forall j: Nat;
                      reducesToZero(qpoly.qconvolution(g, h, j, m)))
                    [by discharge given-g-vanishes]
                }
              @h-integral-gives-it |
                hasIntegerCoefficients(h) ->
                  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
                  (forall m: Nat; forall j: Nat;
                  reducesToZero(qpoly.qconvolution(g, h, j, m)))
                [by discharge given-h-integral]
            }
          @g-integral-gives-it |
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
              (forall m: Nat; forall j: Nat;
              reducesToZero(qpoly.qconvolution(g, h, j, m)))
            [by discharge given-g-integral]
        }
      @discharge-h |
        forall h: QPoly;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
          (forall m: Nat; forall j: Nat;
          reducesToZero(qpoly.qconvolution(g, h, j, m)))
        [by generalize generalize-h]
    }
  @conclusion |
    forall g, h: QPoly;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
      (forall m: Nat; forall j: Nat;
      reducesToZero(qpoly.qconvolution(g, h, j, m)))
    [by generalize generalize-g]
qed

// The base: one term, g at the base times h at ZERO. g's class vanishes, so the product's
// class is ZERO times something, which is ZERO.
theorem theVanishingBase: forall g, h: QPoly;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
  (forall j: Nat; reducesToZero(qpoly.qconvolution(g, h, j, NAT_ZERO)))
proof
  @generalize-g |
    fix g: QPoly {
      @generalize-h |
        fix h: QPoly {
          @given-g-integral |
            assume hasIntegerCoefficients(g) {
              @g-is-integral |
                hasIntegerCoefficients(g)
                [by hypothesis given-g-integral]
              @the-g-meaning |
                hasIntegerCoefficients(g) iff
                  (forall t: Nat; isInteger(qpoly.qcoeff(g, t)))
                [using specialize integerCoefficientsEverywhere(g)]
              @g-coefficients |
                forall t: Nat; isInteger(qpoly.qcoeff(g, t))
                [using tautology the-g-meaning g-is-integral]
              @given-h-integral |
                assume hasIntegerCoefficients(h) {
                  @h-is-integral |
                    hasIntegerCoefficients(h)
                    [by hypothesis given-h-integral]
                  @the-h-meaning |
                    hasIntegerCoefficients(h) iff
                      (forall t: Nat; isInteger(qpoly.qcoeff(h, t)))
                    [using specialize integerCoefficientsEverywhere(h)]
                  @h-coefficients |
                    forall t: Nat; isInteger(qpoly.qcoeff(h, t))
                    [using tautology the-h-meaning h-is-integral]
                  @given-g-vanishes |
                    assume forall j: Nat;
                      reducesToZero(qpoly.qcoeff(g, j)) {
                      @every-g-coefficient-vanishes |
                        forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))
                        [by hypothesis given-g-vanishes]
                      @generalize-j |
                        fix j: Nat {
                          @the-base-convolution |
                            qpoly.qconvolution(g, h, j, NAT_ZERO) =
                              rational.mul(qpoly.qcoeff(g, j),
                              qpoly.qcoeff(h, NAT_ZERO))
                            [using specialize qpoly.qConvolutionZero(g, h, j)]
                          @g-at-j |
                            isInteger(qpoly.qcoeff(g, j))
                            [using specialize g-coefficients(j)]
                          @h-at-zero |
                            isInteger(qpoly.qcoeff(h, NAT_ZERO))
                            [using specialize h-coefficients(NAT_ZERO)]
                          @the-classes-multiply |
                            mod_n.mul(qcls(qpoly.qcoeff(g, j)),
                              qcls(qpoly.qcoeff(h, NAT_ZERO))) =
                              qcls(rational.mul(qpoly.qcoeff(g, j),
                              qpoly.qcoeff(h, NAT_ZERO)))
                            [using specialize qclsMul(qpoly.qcoeff(g, j),
                              qpoly.qcoeff(h, NAT_ZERO)) g-at-j h-at-zero]
                          @the-g-class-vanishes |
                            qcls(qpoly.qcoeff(g, j)) = mod_n.ZERO
                            [using specialize
                              every-g-coefficient-vanishes(j)]
                          @the-product-is-zero-times |
                            mod_n.mul(mod_n.ZERO,
                              qcls(qpoly.qcoeff(h, NAT_ZERO))) =
                              qcls(rational.mul(qpoly.qcoeff(g, j),
                              qpoly.qcoeff(h, NAT_ZERO)))
                            [by rewrite the-g-class-vanishes
                              the-classes-multiply]
                          @zero-annihilates |
                            mod_n.mul(mod_n.ZERO,
                              qcls(qpoly.qcoeff(h, NAT_ZERO))) = mod_n.ZERO
                            [using specialize theZeroClassAnnihilates(
                              qcls(qpoly.qcoeff(h, NAT_ZERO)))]
                          @the-product-class-vanishes |
                            qcls(rational.mul(qpoly.qcoeff(g, j),
                              qpoly.qcoeff(h, NAT_ZERO))) = mod_n.ZERO
                            [by rewrite the-product-is-zero-times
                              zero-annihilates]
                          @conclusion-the-base-vanishes |
                            reducesToZero(
                              qpoly.qconvolution(g, h, j, NAT_ZERO))
                            [by rewrite the-base-convolution
                              the-product-class-vanishes]
                        }
                      @all-bases |
                        forall j: Nat;
                          reducesToZero(
                          qpoly.qconvolution(g, h, j, NAT_ZERO))
                        [by generalize generalize-j]
                    }
                  @g-vanishing-gives-it |
                    (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
                      (forall j: Nat;
                      reducesToZero(
                      qpoly.qconvolution(g, h, j, NAT_ZERO)))
                    [by discharge given-g-vanishes]
                }
              @h-integral-gives-it |
                hasIntegerCoefficients(h) ->
                  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
                  (forall j: Nat;
                  reducesToZero(qpoly.qconvolution(g, h, j, NAT_ZERO)))
                [by discharge given-h-integral]
            }
          @g-integral-gives-it |
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
              (forall j: Nat;
              reducesToZero(qpoly.qconvolution(g, h, j, NAT_ZERO)))
            [by discharge given-g-integral]
        }
      @discharge-h |
        forall h: QPoly;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
          (forall j: Nat;
          reducesToZero(qpoly.qconvolution(g, h, j, NAT_ZERO)))
        [by generalize generalize-h]
    }
  @conclusion |
    forall g, h: QPoly;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
      (forall j: Nat; reducesToZero(qpoly.qconvolution(g, h, j, NAT_ZERO)))
    [by generalize generalize-g]
qed

// The step: the run peels its top term, whose g-factor's class vanishes, and the tail is the
// hypothesis at base succ(j). `qclsAdd` joins the two — which needs both summands integral,
// hence `theConvolutionIsIntegral` for the tail.
theorem theVanishingStep: forall g, h: QPoly;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
  (forall m: Nat;
  (forall j: Nat; reducesToZero(qpoly.qconvolution(g, h, j, m))) ->
  (forall j: Nat;
  reducesToZero(qpoly.qconvolution(g, h, j, peano.succ(m)))))
proof
  @generalize-g |
    fix g: QPoly {
      @generalize-h |
        fix h: QPoly {
          @given-g-integral |
            assume hasIntegerCoefficients(g) {
              @g-is-integral |
                hasIntegerCoefficients(g)
                [by hypothesis given-g-integral]
              @the-g-meaning |
                hasIntegerCoefficients(g) iff
                  (forall t: Nat; isInteger(qpoly.qcoeff(g, t)))
                [using specialize integerCoefficientsEverywhere(g)]
              @g-coefficients |
                forall t: Nat; isInteger(qpoly.qcoeff(g, t))
                [using tautology the-g-meaning g-is-integral]
              @given-h-integral |
                assume hasIntegerCoefficients(h) {
                  @h-is-integral |
                    hasIntegerCoefficients(h)
                    [by hypothesis given-h-integral]
                  @the-h-meaning |
                    hasIntegerCoefficients(h) iff
                      (forall t: Nat; isInteger(qpoly.qcoeff(h, t)))
                    [using specialize integerCoefficientsEverywhere(h)]
                  @h-coefficients |
                    forall t: Nat; isInteger(qpoly.qcoeff(h, t))
                    [using tautology the-h-meaning h-is-integral]
                  @given-g-vanishes |
                    assume forall j: Nat;
                      reducesToZero(qpoly.qcoeff(g, j)) {
                      @every-g-coefficient-vanishes |
                        forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))
                        [by hypothesis given-g-vanishes]
                      @generalize-m |
                        fix m: Nat {
                          @given-inductive-hypothesis |
                            assume forall j: Nat;
                              reducesToZero(
                              qpoly.qconvolution(g, h, j, m)) {
                              @inductive-hypothesis |
                                forall j: Nat;
                                  reducesToZero(
                                  qpoly.qconvolution(g, h, j, m))
                                [by hypothesis given-inductive-hypothesis]
                              @generalize-j |
                                fix j: Nat {
                                  @the-run-peels |
                                    qpoly.qconvolution(g, h, j,
                                      peano.succ(m)) =
                                      rational.add(
                                      rational.mul(qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m))),
                                      qpoly.qconvolution(g, h,
                                      peano.succ(j), m))
                                    [using specialize
                                      qpoly.qConvolutionSucc(g, h, j, m)]
                                  @g-at-j |
                                    isInteger(qpoly.qcoeff(g, j))
                                    [using specialize g-coefficients(j)]
                                  @h-at-the-top |
                                    isInteger(qpoly.qcoeff(h,
                                      peano.succ(m)))
                                    [using specialize
                                      h-coefficients(peano.succ(m))]
                                  @the-peeled-term-is-an-integer |
                                    isInteger(rational.mul(
                                      qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m))))
                                    [using specialize rational.isIntegerMul(
                                      qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m)))
                                      g-at-j h-at-the-top]
                                  @the-tail-is-an-integer |
                                    isInteger(qpoly.qconvolution(g, h,
                                      peano.succ(j), m))
                                    [using specialize
                                      theConvolutionIsIntegral(g, h,
                                      peano.succ(j), m)
                                      g-is-integral h-is-integral]
                                  @the-peeled-classes-multiply |
                                    mod_n.mul(qcls(qpoly.qcoeff(g, j)),
                                      qcls(qpoly.qcoeff(h,
                                      peano.succ(m)))) =
                                      qcls(rational.mul(
                                      qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m))))
                                    [using specialize qclsMul(
                                      qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m)))
                                      g-at-j h-at-the-top]
                                  @the-g-class-vanishes |
                                    qcls(qpoly.qcoeff(g, j)) = mod_n.ZERO
                                    [using specialize
                                      every-g-coefficient-vanishes(j)]
                                  @the-peeled-is-zero-times |
                                    mod_n.mul(mod_n.ZERO,
                                      qcls(qpoly.qcoeff(h,
                                      peano.succ(m)))) =
                                      qcls(rational.mul(
                                      qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m))))
                                    [by rewrite the-g-class-vanishes
                                      the-peeled-classes-multiply]
                                  @zero-annihilates |
                                    mod_n.mul(mod_n.ZERO,
                                      qcls(qpoly.qcoeff(h,
                                      peano.succ(m)))) = mod_n.ZERO
                                    [using specialize theZeroClassAnnihilates(
                                      qcls(qpoly.qcoeff(h,
                                      peano.succ(m))))]
                                  @the-peeled-class-vanishes |
                                    qcls(rational.mul(qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m)))) =
                                      mod_n.ZERO
                                    [by rewrite the-peeled-is-zero-times
                                      zero-annihilates]
                                  @the-tail-class-vanishes |
                                    qcls(qpoly.qconvolution(g, h,
                                      peano.succ(j), m)) = mod_n.ZERO
                                    [using specialize
                                      inductive-hypothesis(peano.succ(j))]
                                  @the-classes-add |
                                    mod_n.add(
                                      qcls(rational.mul(
                                      qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m)))),
                                      qcls(qpoly.qconvolution(g, h,
                                      peano.succ(j), m))) =
                                      qcls(rational.add(
                                      rational.mul(qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m))),
                                      qpoly.qconvolution(g, h,
                                      peano.succ(j), m)))
                                    [using specialize qclsAdd(
                                      rational.mul(qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m))),
                                      qpoly.qconvolution(g, h,
                                      peano.succ(j), m))
                                      the-peeled-term-is-an-integer
                                      the-tail-is-an-integer]
                                  @the-peeled-summand-folded |
                                    mod_n.add(mod_n.ZERO,
                                      qcls(qpoly.qconvolution(g, h,
                                      peano.succ(j), m))) =
                                      qcls(rational.add(
                                      rational.mul(qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m))),
                                      qpoly.qconvolution(g, h,
                                      peano.succ(j), m)))
                                    [by rewrite the-peeled-class-vanishes
                                      the-classes-add]
                                  @both-summands-vanish |
                                    mod_n.add(mod_n.ZERO, mod_n.ZERO) =
                                      qcls(rational.add(
                                      rational.mul(qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m))),
                                      qpoly.qconvolution(g, h,
                                      peano.succ(j), m)))
                                    [by rewrite the-tail-class-vanishes
                                      the-peeled-summand-folded]
                                  @zero-plus-zero |
                                    mod_n.add(mod_n.ZERO, mod_n.ZERO) =
                                      mod_n.ZERO
                                    [using specialize
                                      mod_n.addIdentityLeft(mod_n.ZERO)]
                                  @the-sum-class-vanishes |
                                    qcls(rational.add(
                                      rational.mul(qpoly.qcoeff(g, j),
                                      qpoly.qcoeff(h, peano.succ(m))),
                                      qpoly.qconvolution(g, h,
                                      peano.succ(j), m))) = mod_n.ZERO
                                    [by rewrite both-summands-vanish
                                      zero-plus-zero]
                                  @conclusion-the-step-vanishes |
                                    reducesToZero(qpoly.qconvolution(g, h, j,
                                      peano.succ(m)))
                                    [by rewrite the-run-peels
                                      the-sum-class-vanishes]
                                }
                              @all-bases |
                                forall j: Nat;
                                  reducesToZero(qpoly.qconvolution(g, h, j,
                                  peano.succ(m)))
                                [by generalize generalize-j]
                            }
                          @the-hypothesis-gives-it |
                            (forall j: Nat;
                              reducesToZero(
                              qpoly.qconvolution(g, h, j, m))) ->
                              (forall j: Nat;
                              reducesToZero(qpoly.qconvolution(g, h, j,
                              peano.succ(m))))
                            [by discharge given-inductive-hypothesis]
                        }
                      @all-lengths |
                        forall m: Nat;
                          (forall j: Nat;
                          reducesToZero(
                          qpoly.qconvolution(g, h, j, m))) ->
                          (forall j: Nat;
                          reducesToZero(qpoly.qconvolution(g, h, j,
                          peano.succ(m))))
                        [by generalize generalize-m]
                    }
                  @g-vanishing-gives-it |
                    (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
                      (forall m: Nat;
                      (forall j: Nat;
                      reducesToZero(qpoly.qconvolution(g, h, j, m))) ->
                      (forall j: Nat;
                      reducesToZero(qpoly.qconvolution(g, h, j,
                      peano.succ(m)))))
                    [by discharge given-g-vanishes]
                }
              @h-integral-gives-it |
                hasIntegerCoefficients(h) ->
                  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
                  (forall m: Nat;
                  (forall j: Nat;
                  reducesToZero(qpoly.qconvolution(g, h, j, m))) ->
                  (forall j: Nat;
                  reducesToZero(qpoly.qconvolution(g, h, j,
                  peano.succ(m)))))
                [by discharge given-h-integral]
            }
          @g-integral-gives-it |
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
              (forall m: Nat;
              (forall j: Nat;
              reducesToZero(qpoly.qconvolution(g, h, j, m))) ->
              (forall j: Nat;
              reducesToZero(qpoly.qconvolution(g, h, j, peano.succ(m)))))
            [by discharge given-g-integral]
        }
      @discharge-h |
        forall h: QPoly;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
          (forall m: Nat;
          (forall j: Nat;
          reducesToZero(qpoly.qconvolution(g, h, j, m))) ->
          (forall j: Nat;
          reducesToZero(qpoly.qconvolution(g, h, j, peano.succ(m)))))
        [by generalize generalize-h]
    }
  @conclusion |
    forall g, h: QPoly;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
      (forall m: Nat;
      (forall j: Nat;
      reducesToZero(qpoly.qconvolution(g, h, j, m))) ->
      (forall j: Nat;
      reducesToZero(qpoly.qconvolution(g, h, j, peano.succ(m)))))
    [by generalize generalize-g]
qed

theorem theConvolutionVanishesWhenTheLeftFactorDoes: forall g, h: QPoly;
  forall i, k: Nat;
  isInteger(qpoly.qcoeff(g, NAT_ZERO)) ->
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
  reducesToZero(qpoly.qconvolution(g, h, i, k))
proof
  @generalize-g |
    fix g: QPoly {
      @generalize-h |
        fix h: QPoly {
          @generalize-i |
            fix i: Nat {
              @generalize-k |
                fix k: Nat {
                  @given-g-at-zero |
                    assume isInteger(qpoly.qcoeff(g, NAT_ZERO)) {
                      @given-g-integral |
                        assume hasIntegerCoefficients(g) {
                          @g-is-integral |
                            hasIntegerCoefficients(g)
                            [by hypothesis given-g-integral]
                          @given-h-integral |
                            assume hasIntegerCoefficients(h) {
                              @h-is-integral |
                                hasIntegerCoefficients(h)
                                [by hypothesis given-h-integral]
                              @given-g-vanishes |
                                assume forall j: Nat;
                                  reducesToZero(qpoly.qcoeff(g, j)) {
                                  @every-g-coefficient-vanishes |
                                    forall j: Nat;
                                      reducesToZero(qpoly.qcoeff(g, j))
                                    [by hypothesis given-g-vanishes]
                                  @the-vanishing-at-every-base |
                                    forall m: Nat; forall j: Nat;
                                      reducesToZero(
                                      qpoly.qconvolution(g, h, j, m))
                                    [using specialize
                                      theVanishingAtEveryBase(g, h)
                                      g-is-integral h-is-integral
                                      every-g-coefficient-vanishes]
                                  @conclusion-the-run-vanishes |
                                    reducesToZero(
                                      qpoly.qconvolution(g, h, i, k))
                                    [using specialize
                                      the-vanishing-at-every-base(k, i)]
                                }
                              @g-vanishing-gives-it |
                                (forall j: Nat;
                                  reducesToZero(qpoly.qcoeff(g, j))) ->
                                  reducesToZero(
                                  qpoly.qconvolution(g, h, i, k))
                                [by discharge given-g-vanishes]
                            }
                          @h-integral-gives-it |
                            hasIntegerCoefficients(h) ->
                              (forall j: Nat;
                              reducesToZero(qpoly.qcoeff(g, j))) ->
                              reducesToZero(qpoly.qconvolution(g, h, i, k))
                            [by discharge given-h-integral]
                        }
                      @g-integral-gives-it |
                        hasIntegerCoefficients(g) ->
                          hasIntegerCoefficients(h) ->
                          (forall j: Nat;
                          reducesToZero(qpoly.qcoeff(g, j))) ->
                          reducesToZero(qpoly.qconvolution(g, h, i, k))
                        [by discharge given-g-integral]
                    }
                  @g-at-zero-gives-it |
                    isInteger(qpoly.qcoeff(g, NAT_ZERO)) ->
                      hasIntegerCoefficients(g) ->
                      hasIntegerCoefficients(h) ->
                      (forall j: Nat;
                      reducesToZero(qpoly.qcoeff(g, j))) ->
                      reducesToZero(qpoly.qconvolution(g, h, i, k))
                    [by discharge given-g-at-zero]
                }
              @discharge-k |
                forall k: Nat;
                  isInteger(qpoly.qcoeff(g, NAT_ZERO)) ->
                  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
                  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
                  reducesToZero(qpoly.qconvolution(g, h, i, k))
                [by generalize generalize-k]
            }
          @discharge-i |
            forall i, k: Nat;
              isInteger(qpoly.qcoeff(g, NAT_ZERO)) ->
              hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
              (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
              reducesToZero(qpoly.qconvolution(g, h, i, k))
            [by generalize generalize-i]
        }
      @discharge-h |
        forall h: QPoly; forall i, k: Nat;
          isInteger(qpoly.qcoeff(g, NAT_ZERO)) ->
          hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
          (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
          reducesToZero(qpoly.qconvolution(g, h, i, k))
        [by generalize generalize-h]
    }
  @conclusion |
    forall g, h: QPoly; forall i, k: Nat;
      isInteger(qpoly.qcoeff(g, NAT_ZERO)) ->
      hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
      (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
      reducesToZero(qpoly.qconvolution(g, h, i, k))
    [by generalize generalize-g]
qed

// THE CLOSURE, at the coefficient level: if the modulus divides every coefficient of g, it
// divides every coefficient of g·h.
theorem theModulusDividesTheProductWhenItDividesAFactor: forall g, h: QPoly;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
  (forall t: Nat; reducesToZero(qpoly.qcoeff(qpoly.qmulP(g, h), t)))
proof
  @generalize-g |
    fix g: QPoly {
      @generalize-h |
        fix h: QPoly {
          @given-the-setup |
            assume hasIntegerCoefficients(g) and
              hasIntegerCoefficients(h) and
              (forall j: Nat;
              reducesToZero(qpoly.qcoeff(g, j))) {
              @the-setup |
                hasIntegerCoefficients(g) and
                  hasIntegerCoefficients(h) and
                  (forall j: Nat;
                  reducesToZero(qpoly.qcoeff(g, j)))
                [by hypothesis given-the-setup]
              @g-is-integral |
                hasIntegerCoefficients(g)
                [using tautology the-setup]
              @h-is-integral |
                hasIntegerCoefficients(h)
                [using tautology the-setup]
              @every-g-coefficient-vanishes |
                forall j: Nat;
                  reducesToZero(qpoly.qcoeff(g, j))
                [using tautology the-setup]
              @the-g-meaning |
                hasIntegerCoefficients(g) iff
                  (forall j: Nat; isInteger(qpoly.qcoeff(g, j)))
                [using specialize integerCoefficientsEverywhere(g)]
              @g-coefficients |
                forall j: Nat; isInteger(qpoly.qcoeff(g, j))
                [using tautology the-g-meaning g-is-integral]
              @g-at-zero |
                isInteger(qpoly.qcoeff(g, NAT_ZERO))
                [using specialize g-coefficients(NAT_ZERO)]
              @each-index |
                fix t: Nat {
                  @the-coefficient-is-the-convolution |
                    qpoly.qcoeff(qpoly.qmulP(g, h), t) =
                      qpoly.qconvolution(g, h, NAT_ZERO, t)
                    [using specialize qpoly.qMulPolyCoeff(g, h, t)]
                  @the-convolution-vanishes |
                    reducesToZero(
                      qpoly.qconvolution(g, h, NAT_ZERO, t))
                    [using specialize theConvolutionVanishesWhenTheLeftFactorDoes(g, h, NAT_ZERO, t) g-at-zero g-is-integral h-is-integral every-g-coefficient-vanishes]
                  @conclusion-vanishes-at-t |
                    reducesToZero(
                      qpoly.qcoeff(qpoly.qmulP(g, h), t))
                    [by rewrite the-coefficient-is-the-convolution the-convolution-vanishes]
                }
              @conclusion-all-vanish |
                forall t: Nat;
                  reducesToZero(
                  qpoly.qcoeff(qpoly.qmulP(g, h), t))
                [by generalize each-index]
            }
          @the-implication |
            (hasIntegerCoefficients(g) and
              hasIntegerCoefficients(h) and
              (forall j: Nat;
              reducesToZero(qpoly.qcoeff(g, j)))) ->
              (forall t: Nat;
              reducesToZero(
              qpoly.qcoeff(qpoly.qmulP(g, h), t)))
            [by discharge given-the-setup]
          @curried |
            hasIntegerCoefficients(g) ->
              hasIntegerCoefficients(h) ->
              (forall j: Nat;
              reducesToZero(qpoly.qcoeff(g, j))) ->
              (forall t: Nat;
              reducesToZero(
              qpoly.qcoeff(qpoly.qmulP(g, h), t)))
            [using tautology the-implication]
        }
      @discharge-h |
        forall h9: QPoly;
          hasIntegerCoefficients(g) ->
          hasIntegerCoefficients(h9) ->
          (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
          (forall t: Nat;
          reducesToZero(qpoly.qcoeff(qpoly.qmulP(g, h9), t)))
        [by generalize generalize-h]
    }
  @conclusion |
    forall g, h: QPoly;
      hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
      (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))) ->
      (forall t: Nat;
      reducesToZero(qpoly.qcoeff(qpoly.qmulP(g, h), t)))
    [by generalize generalize-g]
qed

// THE CONTRAPOSITIVE, which is the surviving-coefficient fact Eisenstein wants of the factor
// whose constant term the modulus divides: if the modulus misses SOME coefficient of the
// product, it misses some coefficient of g.
theorem aSurvivingProductCoefficientGivesASurvivingFactorCoefficient: forall g, h: QPoly;
  forall n: Nat;
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  (not reducesToZero(qpoly.qcoeff(qpoly.qmulP(g, h), n))) ->
  (not (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))))
proof
  @generalize-g |
    fix g: QPoly {
      @generalize-h |
        fix h: QPoly {
          @generalize-n |
            fix n: Nat {
              @given-the-setup |
                assume hasIntegerCoefficients(g) and
                  hasIntegerCoefficients(h) and
                  (not reducesToZero(
                  qpoly.qcoeff(qpoly.qmulP(g, h), n))) {
                  @the-setup |
                    hasIntegerCoefficients(g) and
                      hasIntegerCoefficients(h) and
                      (not reducesToZero(
                      qpoly.qcoeff(qpoly.qmulP(g, h), n)))
                    [by hypothesis given-the-setup]
                  @g-is-integral |
                    hasIntegerCoefficients(g)
                    [using tautology the-setup]
                  @h-is-integral |
                    hasIntegerCoefficients(h)
                    [using tautology the-setup]
                  @the-product-coefficient-survives |
                    not reducesToZero(
                      qpoly.qcoeff(qpoly.qmulP(g, h), n))
                    [using tautology the-setup]
                  @given-every-g-coefficient-vanishes |
                    assume forall j: Nat;
                      reducesToZero(qpoly.qcoeff(g, j)) {
                      @every-g-coefficient-vanishes |
                        forall j: Nat;
                          reducesToZero(qpoly.qcoeff(g, j))
                        [by hypothesis given-every-g-coefficient-vanishes]
                      @every-product-coefficient-vanishes |
                        forall t: Nat;
                          reducesToZero(
                          qpoly.qcoeff(qpoly.qmulP(g, h), t))
                        [using specialize theModulusDividesTheProductWhenItDividesAFactor(g, h) g-is-integral h-is-integral every-g-coefficient-vanishes]
                      @the-product-coefficient-vanishes |
                        reducesToZero(
                          qpoly.qcoeff(qpoly.qmulP(g, h), n))
                        [using specialize every-product-coefficient-vanishes(n)]
                    }
                  @conclusion-some-g-coefficient-survives |
                    not (forall j: Nat;
                      reducesToZero(qpoly.qcoeff(g, j)))
                    [by contradiction given-every-g-coefficient-vanishes the-product-coefficient-vanishes the-product-coefficient-survives]
                }
              @the-implication |
                (hasIntegerCoefficients(g) and
                  hasIntegerCoefficients(h) and
                  (not reducesToZero(
                  qpoly.qcoeff(qpoly.qmulP(g, h), n)))) ->
                  (not (forall j: Nat;
                  reducesToZero(qpoly.qcoeff(g, j))))
                [by discharge given-the-setup]
              @curried |
                hasIntegerCoefficients(g) ->
                  hasIntegerCoefficients(h) ->
                  (not reducesToZero(
                  qpoly.qcoeff(qpoly.qmulP(g, h), n))) ->
                  (not (forall j: Nat;
                  reducesToZero(qpoly.qcoeff(g, j))))
                [using tautology the-implication]
            }
          @discharge-n |
            forall n9: Nat;
              hasIntegerCoefficients(g) ->
              hasIntegerCoefficients(h) ->
              (not reducesToZero(
              qpoly.qcoeff(qpoly.qmulP(g, h), n9))) ->
              (not (forall j: Nat;
              reducesToZero(qpoly.qcoeff(g, j))))
            [by generalize generalize-n]
        }
      @discharge-h |
        forall h9: QPoly; forall n9: Nat;
          hasIntegerCoefficients(g) ->
          hasIntegerCoefficients(h9) ->
          (not reducesToZero(
          qpoly.qcoeff(qpoly.qmulP(g, h9), n9))) ->
          (not (forall j: Nat;
          reducesToZero(qpoly.qcoeff(g, j))))
        [by generalize generalize-h]
    }
  @conclusion |
    forall g, h: QPoly; forall n: Nat;
      hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
      (not reducesToZero(qpoly.qcoeff(qpoly.qmulP(g, h), n))) ->
      (not (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j))))
    [by generalize generalize-g]
qed

// The classical quantifier de Morgan, at the shape this file needs it: the closure's
// contrapositive yields "not every coefficient vanishes", while the reduction argument wants
// a SPECIFIC surviving index. Converting needs double negation over a quantified statement —
// `tautology` cannot do it, since a `forall` is one opaque atom to it, but the kernel can.
theorem someCoefficientSurvives: forall g: QPoly;
  (not (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j)))) ->
  (exists j: Nat; not reducesToZero(qpoly.qcoeff(g, j)))
proof
  @generalize-g |
    fix g: QPoly {
      @given-not-all |
        assume not (forall j: Nat;
          reducesToZero(qpoly.qcoeff(g, j))) {
          @not-all |
            not (forall j: Nat;
              reducesToZero(qpoly.qcoeff(g, j)))
            [by hypothesis given-not-all]
          @given-no-survivor |
            assume not (exists j: Nat;
              not reducesToZero(qpoly.qcoeff(g, j))) {
              @no-survivor |
                not (exists j: Nat;
                  not reducesToZero(qpoly.qcoeff(g, j)))
                [by hypothesis given-no-survivor]
              @each-index |
                fix j: Nat {
                  @given-it-survives |
                    assume not reducesToZero(
                      qpoly.qcoeff(g, j)) {
                      @it-survives |
                        not reducesToZero(qpoly.qcoeff(g, j))
                        [by hypothesis given-it-survives]
                      @a-survivor-exists |
                        exists j2: Nat;
                          not reducesToZero(
                          qpoly.qcoeff(g, j2))
                        [by witness(j) it-survives]
                    }
                  @it-does-not-survive |
                    not not reducesToZero(qpoly.qcoeff(g, j))
                    [by contradiction given-it-survives a-survivor-exists no-survivor]
                  @conclusion-vanishes-at-j |
                    reducesToZero(qpoly.qcoeff(g, j))
                    [by double_negation it-does-not-survive]
                }
              @all-vanish |
                forall j: Nat;
                  reducesToZero(qpoly.qcoeff(g, j))
                [by generalize each-index]
            }
          @a-survivor-is-not-impossible |
            not not (exists j: Nat;
              not reducesToZero(qpoly.qcoeff(g, j)))
            [by contradiction given-no-survivor all-vanish not-all]
          @conclusion-a-survivor |
            exists j: Nat;
              not reducesToZero(qpoly.qcoeff(g, j))
            [by double_negation a-survivor-is-not-impossible]
        }
      @the-implication |
        (not (forall j: Nat;
          reducesToZero(qpoly.qcoeff(g, j)))) ->
          (exists j: Nat;
          not reducesToZero(qpoly.qcoeff(g, j)))
        [by discharge given-not-all]
    }
  @conclusion |
    forall g: QPoly;
      (not (forall j: Nat; reducesToZero(qpoly.qcoeff(g, j)))) ->
      (exists j: Nat; not reducesToZero(qpoly.qcoeff(g, j)))
    [by generalize generalize-g]
qed

// The product vanishes above the degree sum — transferred from `ring_poly`, which the cut's
// model already maps. Needed because Eisenstein's contradiction is a DEGREE argument.
theorem qProductVanishesAboveTheDegreeSum: forall p, q: QPoly;
  forall m, n, i: Nat;
  qpoly.qdegreeAtMost(p, m) -> qpoly.qdegreeAtMost(q, n) ->
  peano.less_than(peano.add(m, n), i) ->
  qpoly.qcoeff(qpoly.qmulP(p, q), i) = ZERO
proof
  @conclusion |
    forall p, q: QPoly; forall m, n, i: Nat;
      qpoly.qdegreeAtMost(p, m) -> qpoly.qdegreeAtMost(q, n) ->
      peano.less_than(peano.add(m, n), i) ->
      qpoly.qcoeff(qpoly.qmulP(p, q), i) = ZERO
    [using model(qpoly.RationalPolynomialsOverARing) ring_leading.theProductVanishesAboveTheDegreeSum]
qed

// Above the degree sum the product's COEFFICIENTS vanish, hence reduce to zero.
theorem theProductReducesToZeroAboveTheDegreeSum: forall p, q: QPoly;
  forall m, n, t: Nat;
  qpoly.qdegreeAtMost(p, m) -> qpoly.qdegreeAtMost(q, n) ->
  peano.less_than(peano.add(m, n), t) ->
  reducesToZero(qpoly.qcoeff(qpoly.qmulP(p, q), t))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-m |
            fix m: Nat {
              @generalize-n |
                fix n: Nat {
                  @generalize-t |
                    fix t: Nat {
                      @given-the-setup |
                        assume qpoly.qdegreeAtMost(p, m) and
                          qpoly.qdegreeAtMost(q, n) and
                          peano.less_than(peano.add(m, n), t) {
                          @the-setup |
                            qpoly.qdegreeAtMost(p, m) and
                              qpoly.qdegreeAtMost(q, n) and
                              peano.less_than(peano.add(m, n), t)
                            [by hypothesis given-the-setup]
                          @p-is-bounded |
                            qpoly.qdegreeAtMost(p, m)
                            [using tautology the-setup]
                          @q-is-bounded |
                            qpoly.qdegreeAtMost(q, n)
                            [using tautology the-setup]
                          @t-is-above |
                            peano.less_than(peano.add(m, n), t)
                            [using tautology the-setup]
                          @the-coefficient-vanishes |
                            qpoly.qcoeff(qpoly.qmulP(p, q), t) =
                              ZERO
                            [using specialize qProductVanishesAboveTheDegreeSum(p, q, m, n, t) p-is-bounded q-is-bounded t-is-above]
                          @zero-reduces-to-zero |
                            reducesToZero(ZERO)
                            [by cite qclsZeroReduces]
                          @conclusion-reduces |
                            reducesToZero(
                              qpoly.qcoeff(qpoly.qmulP(p, q), t))
                            [by rewrite the-coefficient-vanishes zero-reduces-to-zero]
                        }
                      @the-implication |
                        (qpoly.qdegreeAtMost(p, m) and
                          qpoly.qdegreeAtMost(q, n) and
                          peano.less_than(peano.add(m, n), t)) ->
                          reducesToZero(
                          qpoly.qcoeff(qpoly.qmulP(p, q), t))
                        [by discharge given-the-setup]
                      @curried |
                        qpoly.qdegreeAtMost(p, m) ->
                          qpoly.qdegreeAtMost(q, n) ->
                          peano.less_than(peano.add(m, n), t) ->
                          reducesToZero(
                          qpoly.qcoeff(qpoly.qmulP(p, q), t))
                        [using tautology the-implication]
                    }
                  @discharge-t |
                    forall t9: Nat;
                      qpoly.qdegreeAtMost(p, m) ->
                      qpoly.qdegreeAtMost(q, n) ->
                      peano.less_than(peano.add(m, n), t9) ->
                      reducesToZero(
                      qpoly.qcoeff(qpoly.qmulP(p, q), t9))
                    [by generalize generalize-t]
                }
              @discharge-n |
                forall n9, t9: Nat;
                  qpoly.qdegreeAtMost(p, m) ->
                  qpoly.qdegreeAtMost(q, n9) ->
                  peano.less_than(peano.add(m, n9), t9) ->
                  reducesToZero(
                  qpoly.qcoeff(qpoly.qmulP(p, q), t9))
                [by generalize generalize-n]
            }
          @discharge-m |
            forall m9, n9, t9: Nat;
              qpoly.qdegreeAtMost(p, m9) ->
              qpoly.qdegreeAtMost(q, n9) ->
              peano.less_than(peano.add(m9, n9), t9) ->
              reducesToZero(qpoly.qcoeff(qpoly.qmulP(p, q), t9))
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q9: QPoly; forall m9, n9, t9: Nat;
          qpoly.qdegreeAtMost(p, m9) ->
          qpoly.qdegreeAtMost(q9, n9) ->
          peano.less_than(peano.add(m9, n9), t9) ->
          reducesToZero(qpoly.qcoeff(qpoly.qmulP(p, q9), t9))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; forall m, n, t: Nat;
      qpoly.qdegreeAtMost(p, m) -> qpoly.qdegreeAtMost(q, n) ->
      peano.less_than(peano.add(m, n), t) ->
      reducesToZero(qpoly.qcoeff(qpoly.qmulP(p, q), t))
    [by generalize generalize-p]
qed

// -- EISENSTEIN'S CRITERION, ON THE CUT ----------------------------------------------------
// AATA Theorem 17.15, as the DEGREE argument it is. A previous version of this theorem
// concluded "not every coefficient of f is divisible by N" — which under Eisenstein's own
// hypotheses follows from `N ∤ a_n` alone and refutes nothing. The contradiction needs the
// degree bookkeeping, and that is what this states.
//
// Given `f = g·h` with the two degree bounds summing BELOW n:
//   - below n, `N | a_i` by hypothesis;
//   - above the degree sum, the product's coefficients VANISH, so `N` divides them;
//   - and the degree sum is below n, so those two ranges COVER every index.
// Hence `N` divides every coefficient of `f` — which the reduction argument forbids, given a
// surviving coefficient in each factor (supplied by the closure from `N ∤ a_n`).
//
// So no such factorization exists: the degree bounds cannot both stay below n.
theorem eisensteinForcesTheFullDegreeOnTheCut: forall f, g, h: QPoly;
  forall n, m, k: Nat;
  mod_n_poly.is_prime(mod_n.N) ->
  hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
  f = qpoly.qmulP(g, h) ->
  qpoly.qdegreeAtMost(g, m) -> qpoly.qdegreeAtMost(h, k) ->
  (forall i: Nat; peano.less_than(i, n) ->
  reducesToZero(qpoly.qcoeff(f, i))) ->
  (not reducesToZero(qpoly.qcoeff(f, n))) ->
  (not peano.less_than(peano.add(m, k), n))
proof
  @generalize-f |
    fix f: QPoly {
      @generalize-g |
        fix g: QPoly {
          @generalize-h |
            fix h: QPoly {
              @generalize-n |
                fix n: Nat {
                  @generalize-m |
                    fix m: Nat {
                      @generalize-k |
                        fix k: Nat {
                          @given-the-setup |
                            assume mod_n_poly.is_prime(mod_n.N) and
                              hasIntegerCoefficients(g) and
                              hasIntegerCoefficients(h) and
                              f = qpoly.qmulP(g, h) and
                              qpoly.qdegreeAtMost(g, m) and
                              qpoly.qdegreeAtMost(h, k) and
                              (forall i: Nat;
                              peano.less_than(i, n) ->
                              reducesToZero(
                              qpoly.qcoeff(f, i))) and
                              (not reducesToZero(
                              qpoly.qcoeff(f, n))) {
                              @the-setup |
                                mod_n_poly.is_prime(mod_n.N) and
                                  hasIntegerCoefficients(g) and
                                  hasIntegerCoefficients(h) and
                                  f = qpoly.qmulP(g, h) and
                                  qpoly.qdegreeAtMost(g, m) and
                                  qpoly.qdegreeAtMost(h, k) and
                                  (forall i: Nat;
                                  peano.less_than(i, n) ->
                                  reducesToZero(
                                  qpoly.qcoeff(f, i))) and
                                  (not reducesToZero(
                                  qpoly.qcoeff(f, n)))
                                [by hypothesis given-the-setup]
                              @the-modulus-is-prime |
                                mod_n_poly.is_prime(mod_n.N)
                                [using tautology the-setup]
                              @g-is-integral |
                                hasIntegerCoefficients(g)
                                [using tautology the-setup]
                              @h-is-integral |
                                hasIntegerCoefficients(h)
                                [using tautology the-setup]
                              @f-factors |
                                f = qpoly.qmulP(g, h)
                                [using tautology the-setup]
                              @g-is-bounded |
                                qpoly.qdegreeAtMost(g, m)
                                [using tautology the-setup]
                              @h-is-bounded |
                                qpoly.qdegreeAtMost(h, k)
                                [using tautology the-setup]
                              @the-low-coefficients-vanish |
                                forall i: Nat;
                                  peano.less_than(i, n) ->
                                  reducesToZero(
                                  qpoly.qcoeff(f, i))
                                [using tautology the-setup]
                              @the-top-survives |
                                not reducesToZero(
                                  qpoly.qcoeff(f, n))
                                [using tautology the-setup]
                              // a surviving coefficient in each factor
                              @the-product-top-survives |
                                not reducesToZero(
                                  qpoly.qcoeff(
                                  qpoly.qmulP(g, h), n))
                                [by rewrite f-factors the-top-survives]
                              @some-g-coefficient-survives |
                                not (forall j: Nat;
                                  reducesToZero(
                                  qpoly.qcoeff(g, j)))
                                [using specialize aSurvivingProductCoefficientGivesASurvivingFactorCoefficient(g, h, n) g-is-integral h-is-integral the-product-top-survives]
                              @the-commuted-product |
                                qpoly.qmulP(g, h) =
                                  qpoly.qmulP(h, g)
                                [using specialize qpoly.qMulIsCommutative(g, h)]
                              @the-commuted-top-survives |
                                not reducesToZero(
                                  qpoly.qcoeff(
                                  qpoly.qmulP(h, g), n))
                                [by rewrite the-commuted-product the-product-top-survives]
                              @some-h-coefficient-survives |
                                not (forall j: Nat;
                                  reducesToZero(
                                  qpoly.qcoeff(h, j)))
                                [using specialize aSurvivingProductCoefficientGivesASurvivingFactorCoefficient(h, g, n) h-is-integral g-is-integral the-commuted-top-survives]
                              @a-g-survivor-exists |
                                exists j: Nat;
                                  not reducesToZero(
                                  qpoly.qcoeff(g, j))
                                [using specialize someCoefficientSurvives(g) some-g-coefficient-survives]
                              @a-h-survivor-exists |
                                exists j: Nat;
                                  not reducesToZero(
                                  qpoly.qcoeff(h, j))
                                [using specialize someCoefficientSurvives(h) some-h-coefficient-survives]
                              // suppose the degree sum stayed below n
                              @given-the-sum-is-below |
                                assume peano.less_than(
                                  peano.add(m, k), n) {
                                  @the-sum-is-below |
                                    peano.less_than(
                                      peano.add(m, k), n)
                                    [by hypothesis given-the-sum-is-below]
                                  // then EVERY coefficient of f vanishes
                                  @each-index |
                                    fix t: Nat {
                                      @the-position-split |
                                        peano.less_than(t, n) or
                                          (not peano.less_than(t, n))
                                        [using tautology]
                                      @conclusion-vanishes-at-t |
                                        reducesToZero(
                                          qpoly.qcoeff(f, t))
                                        case the-position-split {
                                          @when-below |
                                            assume peano.less_than(t, n) {
                                              @t-below-n |
                                                peano.less_than(t, n)
                                                [by hypothesis when-below]
                                              @conclusion-below |
                                                reducesToZero(
                                                  qpoly.qcoeff(f, t))
                                                [using specialize the-low-coefficients-vanish(t) t-below-n]
                                            }
                                          @when-not-below |
                                            assume not peano.less_than(t, n) {
                                              @t-not-below-n |
                                                not peano.less_than(t, n)
                                                [by hypothesis when-not-below]
                                              @the-sum-is-below-t |
                                                peano.less_than(
                                                  peano.add(m, k), t)
                                                [using specialize peano_order.theBoundIsBelowAnythingNotBelowIt(peano.add(m, k), n, t) the-sum-is-below t-not-below-n]
                                              @the-product-vanishes-at-t |
                                                reducesToZero(
                                                  qpoly.qcoeff(
                                                  qpoly.qmulP(g, h), t))
                                                [using specialize theProductReducesToZeroAboveTheDegreeSum(g, h, m, k, t) g-is-bounded h-is-bounded the-sum-is-below-t]
                                              @conclusion-not-below |
                                                reducesToZero(
                                                  qpoly.qcoeff(f, t))
                                                [by rewrite f-factors the-product-vanishes-at-t]
                                            }
                                        }
                                    }
                                  @everything-vanishes |
                                    forall t: Nat;
                                      reducesToZero(
                                      qpoly.qcoeff(f, t))
                                    [by generalize each-index]
                                  @the-product-everything-vanishes |
                                    forall t: Nat;
                                      reducesToZero(
                                      qpoly.qcoeff(
                                      qpoly.qmulP(g, h), t))
                                    [by rewrite f-factors everything-vanishes]
                                  // which the reduction argument forbids
                                  @with-the-g-survivor |
                                    unpack jg: Nat from a-g-survivor-exists {
                                      @the-g-survivor |
                                        not reducesToZero(
                                          qpoly.qcoeff(g, jg))
                                        [by hypothesis with-the-g-survivor]
                                      @with-the-h-survivor |
                                        unpack jh: Nat from a-h-survivor-exists {
                                          @the-h-survivor |
                                            not reducesToZero(
                                              qpoly.qcoeff(h, jh))
                                            [by hypothesis with-the-h-survivor]
                                          @conclusion-the-contradiction |
                                            not (forall t: Nat;
                                              reducesToZero(
                                              qpoly.qcoeff(
                                              qpoly.qmulP(g, h), t)))
                                            [using specialize theModulusCannotDivideEveryProductCoefficient(g, h, jg, jh) the-modulus-is-prime g-is-integral h-is-integral the-g-survivor the-h-survivor]
                                        }
                                      @the-h-exported |
                                        not (forall t: Nat;
                                          reducesToZero(
                                          qpoly.qcoeff(
                                          qpoly.qmulP(g, h), t)))
                                        [by unpacked with-the-h-survivor]
                                    }
                                  @the-reduction-forbids-it |
                                    not (forall t: Nat;
                                      reducesToZero(
                                      qpoly.qcoeff(
                                      qpoly.qmulP(g, h), t)))
                                    [by unpacked with-the-g-survivor]
                                }
                              @conclusion-the-degree-is-forced |
                                not peano.less_than(
                                  peano.add(m, k), n)
                                [by contradiction given-the-sum-is-below the-product-everything-vanishes the-reduction-forbids-it]
                            }
                          @the-implication |
                            (mod_n_poly.is_prime(mod_n.N) and
                              hasIntegerCoefficients(g) and
                              hasIntegerCoefficients(h) and
                              f = qpoly.qmulP(g, h) and
                              qpoly.qdegreeAtMost(g, m) and
                              qpoly.qdegreeAtMost(h, k) and
                              (forall i: Nat;
                              peano.less_than(i, n) ->
                              reducesToZero(
                              qpoly.qcoeff(f, i))) and
                              (not reducesToZero(
                              qpoly.qcoeff(f, n)))) ->
                              (not peano.less_than(
                              peano.add(m, k), n))
                            [by discharge given-the-setup]
                          @curried |
                            mod_n_poly.is_prime(mod_n.N) ->
                              hasIntegerCoefficients(g) ->
                              hasIntegerCoefficients(h) ->
                              f = qpoly.qmulP(g, h) ->
                              qpoly.qdegreeAtMost(g, m) ->
                              qpoly.qdegreeAtMost(h, k) ->
                              (forall i: Nat;
                              peano.less_than(i, n) ->
                              reducesToZero(
                              qpoly.qcoeff(f, i))) ->
                              (not reducesToZero(
                              qpoly.qcoeff(f, n))) ->
                              (not peano.less_than(
                              peano.add(m, k), n))
                            [using tautology the-implication]
                        }
                      @discharge-k |
                        forall k9: Nat;
                          mod_n_poly.is_prime(mod_n.N) ->
                          hasIntegerCoefficients(g) ->
                          hasIntegerCoefficients(h) ->
                          f = qpoly.qmulP(g, h) ->
                          qpoly.qdegreeAtMost(g, m) ->
                          qpoly.qdegreeAtMost(h, k9) ->
                          (forall i: Nat; peano.less_than(i, n) ->
                          reducesToZero(qpoly.qcoeff(f, i))) ->
                          (not reducesToZero(
                          qpoly.qcoeff(f, n))) ->
                          (not peano.less_than(
                          peano.add(m, k9), n))
                        [by generalize generalize-k]
                    }
                  @discharge-m |
                    forall m9, k9: Nat;
                      mod_n_poly.is_prime(mod_n.N) ->
                      hasIntegerCoefficients(g) ->
                      hasIntegerCoefficients(h) ->
                      f = qpoly.qmulP(g, h) ->
                      qpoly.qdegreeAtMost(g, m9) ->
                      qpoly.qdegreeAtMost(h, k9) ->
                      (forall i: Nat; peano.less_than(i, n) ->
                      reducesToZero(qpoly.qcoeff(f, i))) ->
                      (not reducesToZero(qpoly.qcoeff(f, n))) ->
                      (not peano.less_than(peano.add(m9, k9), n))
                    [by generalize generalize-m]
                }
              @discharge-n |
                forall n9: Nat; forall m9, k9: Nat;
                  mod_n_poly.is_prime(mod_n.N) ->
                  hasIntegerCoefficients(g) ->
                  hasIntegerCoefficients(h) ->
                  f = qpoly.qmulP(g, h) ->
                  qpoly.qdegreeAtMost(g, m9) ->
                  qpoly.qdegreeAtMost(h, k9) ->
                  (forall i: Nat; peano.less_than(i, n9) ->
                  reducesToZero(qpoly.qcoeff(f, i))) ->
                  (not reducesToZero(qpoly.qcoeff(f, n9))) ->
                  (not peano.less_than(peano.add(m9, k9), n9))
                [by generalize generalize-n]
            }
          @discharge-h |
            forall h9: QPoly; forall n9, m9, k9: Nat;
              mod_n_poly.is_prime(mod_n.N) ->
              hasIntegerCoefficients(g) ->
              hasIntegerCoefficients(h9) ->
              f = qpoly.qmulP(g, h9) ->
              qpoly.qdegreeAtMost(g, m9) ->
              qpoly.qdegreeAtMost(h9, k9) ->
              (forall i: Nat; peano.less_than(i, n9) ->
              reducesToZero(qpoly.qcoeff(f, i))) ->
              (not reducesToZero(qpoly.qcoeff(f, n9))) ->
              (not peano.less_than(peano.add(m9, k9), n9))
            [by generalize generalize-h]
        }
      @discharge-g |
        forall g9, h9: QPoly; forall n9, m9, k9: Nat;
          mod_n_poly.is_prime(mod_n.N) ->
          hasIntegerCoefficients(g9) ->
          hasIntegerCoefficients(h9) ->
          f = qpoly.qmulP(g9, h9) ->
          qpoly.qdegreeAtMost(g9, m9) ->
          qpoly.qdegreeAtMost(h9, k9) ->
          (forall i: Nat; peano.less_than(i, n9) ->
          reducesToZero(qpoly.qcoeff(f, i))) ->
          (not reducesToZero(qpoly.qcoeff(f, n9))) ->
          (not peano.less_than(peano.add(m9, k9), n9))
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g, h: QPoly; forall n, m, k: Nat;
      mod_n_poly.is_prime(mod_n.N) ->
      hasIntegerCoefficients(g) -> hasIntegerCoefficients(h) ->
      f = qpoly.qmulP(g, h) ->
      qpoly.qdegreeAtMost(g, m) -> qpoly.qdegreeAtMost(h, k) ->
      (forall i: Nat; peano.less_than(i, n) ->
      reducesToZero(qpoly.qcoeff(f, i))) ->
      (not reducesToZero(qpoly.qcoeff(f, n))) ->
      (not peano.less_than(peano.add(m, k), n))
    [by generalize generalize-f]
qed

// -- FROM A BOUNDED INTEGRALITY TO AN UNBOUNDED ONE ------------------------------------------
// The index split: every index is either within the bound (integrality is given) or above it
// (the coefficient is ZERO, which is an integer). `theBoundIsBelowAnythingNotBelowIt` turns
// "not below succ(n)" into "above n", using `n < succ(n)`.
theorem everyCoefficientIsAnIntegerGivenBothHalves: forall q: QPoly; forall n: Nat;
  (forall i: Nat; peano_order.less_than(n, i) -> qpoly.qcoeff(q, i) = ZERO) ->
  (forall i: Nat; peano_order.less_than(i, peano.succ(n)) ->
  isInteger(qpoly.qcoeff(q, i))) ->
  (forall i: Nat; isInteger(qpoly.qcoeff(q, i)))
proof
  @generalize-q |
    fix q: QPoly {
      @generalize-n |
        fix n: Nat {
          @given-the-high-half |
            assume forall i: Nat; peano_order.less_than(n, i) -> qpoly.qcoeff(q, i) = ZERO {
              @the-high-half |
                forall i: Nat; peano_order.less_than(n, i) -> qpoly.qcoeff(q, i) = ZERO
                [by hypothesis given-the-high-half]
              @given-the-low-half |
                assume forall i: Nat; peano_order.less_than(i, peano.succ(n)) ->
                  isInteger(qpoly.qcoeff(q, i)) {
                  @the-low-half |
                    forall i: Nat; peano_order.less_than(i, peano.succ(n)) ->
                      isInteger(qpoly.qcoeff(q, i))
                    [by hypothesis given-the-low-half]
                  @generalize-i |
                    fix i: Nat {
                      @the-index-is-low-or-not |
                        peano_order.less_than(i, peano.succ(n)) or
                          (not peano_order.less_than(i, peano.succ(n)))
                        [using tautology]
                      @the-coefficient-is-an-integer |
                        isInteger(qpoly.qcoeff(q, i))
                        [by common_conclusion the-index-is-low-or-not
                          when-the-index-is-low when-the-index-is-high]
                      @when-the-index-is-low |
                        assume peano_order.less_than(i, peano.succ(n)) {
                          @the-index-is-low |
                            peano_order.less_than(i, peano.succ(n))
                            [by hypothesis when-the-index-is-low]
                          @conclusion-integral-from-the-low-half |
                            isInteger(qpoly.qcoeff(q, i))
                            [using specialize the-low-half(i) the-index-is-low]
                        }
                      @when-the-index-is-high |
                        assume not peano_order.less_than(i, peano.succ(n)) {
                          @the-index-is-not-low |
                            not peano_order.less_than(i, peano.succ(n))
                            [by hypothesis when-the-index-is-high]
                          @the-bound-is-below-its-successor |
                            peano_order.less_than(n, peano.succ(n))
                            [using specialize peano_order.lessThanSelf(n)]
                          @the-index-is-above-the-bound |
                            peano_order.less_than(n, i)
                            [using specialize peano_order.theBoundIsBelowAnythingNotBelowIt(
                              n, peano.succ(n), i)
                              the-bound-is-below-its-successor the-index-is-not-low]
                          @the-coefficient-vanishes |
                            qpoly.qcoeff(q, i) = ZERO
                            [using specialize the-high-half(i) the-index-is-above-the-bound]
                          @zero-is-an-integer |
                            isInteger(ZERO)
                            [using import(rational) zeroIsAnInteger]
                          @conclusion-integral-because-it-vanishes |
                            isInteger(qpoly.qcoeff(q, i))
                            [by rewrite the-coefficient-vanishes zero-is-an-integer]
                        }
                    }
                  @conclusion-every-coefficient |
                    forall i: Nat; isInteger(qpoly.qcoeff(q, i))
                    [by generalize generalize-i]
                }
              @conclusion-the-low-half-gives-it |
                (forall i: Nat; peano_order.less_than(i, peano.succ(n)) ->
                  isInteger(qpoly.qcoeff(q, i))) ->
                  (forall i: Nat; isInteger(qpoly.qcoeff(q, i)))
                [by discharge given-the-low-half]
            }
          @conclusion-both-halves-give-it |
            (forall i: Nat; peano_order.less_than(n, i) -> qpoly.qcoeff(q, i) = ZERO) ->
              (forall i: Nat; peano_order.less_than(i, peano.succ(n)) ->
              isInteger(qpoly.qcoeff(q, i))) ->
              (forall i: Nat; isInteger(qpoly.qcoeff(q, i)))
            [by discharge given-the-high-half]
        }
      @conclusion-for-all-n |
        forall n: Nat;
          (forall i: Nat; peano_order.less_than(n, i) -> qpoly.qcoeff(q, i) = ZERO) ->
          (forall i: Nat; peano_order.less_than(i, peano.succ(n)) ->
          isInteger(qpoly.qcoeff(q, i))) ->
          (forall i: Nat; isInteger(qpoly.qcoeff(q, i)))
        [by generalize generalize-n]
    }
  @conclusion |
    forall q: QPoly; forall n: Nat;
      (forall i: Nat; peano_order.less_than(n, i) -> qpoly.qcoeff(q, i) = ZERO) ->
      (forall i: Nat; peano_order.less_than(i, peano.succ(n)) ->
      isInteger(qpoly.qcoeff(q, i))) ->
      (forall i: Nat; isInteger(qpoly.qcoeff(q, i)))
    [by generalize generalize-q]
qed

// Hence the bridge itself.
// A degree-bounded polynomial whose coefficients are integers UP TO the bound has integer
// coefficients EVERYWHERE: above the bound every coefficient is ZERO, which is an integer.
//
// This is the bridge Lemma 17.12's output needs. 17.12 reports
// `qpoly.hasIntegerCoefficientsUpTo(q, succ(n))` — bounded, because the descent runs over a
// finite index range — while this file's `hasIntegerCoefficients` is unbounded, as a
// factorization argument quantifies over all indices. The two are NOT interchangeable without
// a degree bound, and `aNonzeroScalingReflectsTheDegreeBound` is what supplies one.
theorem aBoundedIntegralityWithADegreeBoundIsUnbounded: forall q: QPoly; forall n: Nat;
  qpoly.qdegreeAtMost(q, n) ->
  qpoly.hasIntegerCoefficientsUpTo(q, peano.succ(n)) ->
  hasIntegerCoefficients(q)
proof
  @generalize-q |
    fix q: QPoly {
      @generalize-n |
        fix n: Nat {
          @given-the-degree-bound |
            assume qpoly.qdegreeAtMost(q, n) {
              @the-degree-bound |
                qpoly.qdegreeAtMost(q, n)
                [by hypothesis given-the-degree-bound]
              @the-degree-bound-unfolds |
                qpoly.qdegreeAtMost(q, n) iff
                  (forall i: Nat; peano_order.less_than(n, i) ->
                  qpoly.qcoeff(q, i) = ZERO)
                [using specialize qpoly.qDegreeAtMostMeaning(q, n)]
              @the-degree-bound-forward |
                qpoly.qdegreeAtMost(q, n) ->
                  (forall i: Nat; peano_order.less_than(n, i) ->
                  qpoly.qcoeff(q, i) = ZERO)
                [by equiv_forward the-degree-bound-unfolds]
              @the-high-coefficients-vanish |
                forall i: Nat; peano_order.less_than(n, i) -> qpoly.qcoeff(q, i) = ZERO
                [by modus_ponens the-degree-bound-forward the-degree-bound]
              @given-the-bounded-integrality |
                assume qpoly.hasIntegerCoefficientsUpTo(q, peano.succ(n)) {
                  @the-bounded-integrality |
                    qpoly.hasIntegerCoefficientsUpTo(q, peano.succ(n))
                    [by hypothesis given-the-bounded-integrality]
                  @the-bounded-integrality-unfolds |
                    qpoly.hasIntegerCoefficientsUpTo(q, peano.succ(n)) iff
                      (forall i: Nat; peano_order.less_than(i, peano.succ(n)) ->
                      isInteger(qpoly.qcoeff(q, i)))
                    [using specialize qpoly.integerCoefficientsMeaning(q, peano.succ(n))]
                  @the-bounded-integrality-forward |
                    qpoly.hasIntegerCoefficientsUpTo(q, peano.succ(n)) ->
                      (forall i: Nat; peano_order.less_than(i, peano.succ(n)) ->
                      isInteger(qpoly.qcoeff(q, i)))
                    [by equiv_forward the-bounded-integrality-unfolds]
                  @the-low-coefficients-are-integers |
                    forall i: Nat; peano_order.less_than(i, peano.succ(n)) ->
                      isInteger(qpoly.qcoeff(q, i))
                    [by modus_ponens the-bounded-integrality-forward the-bounded-integrality]
                  @every-coefficient-is-an-integer |
                    forall i: Nat; isInteger(qpoly.qcoeff(q, i))
                    [using specialize everyCoefficientIsAnIntegerGivenBothHalves(q, n)
                      the-high-coefficients-vanish the-low-coefficients-are-integers]
                  @the-unbounded-meaning |
                    hasIntegerCoefficients(q) iff
                      (forall i: Nat; isInteger(qpoly.qcoeff(q, i)))
                    [using specialize integerCoefficientsEverywhere(q)]
                  @the-unbounded-backward |
                    (forall i: Nat; isInteger(qpoly.qcoeff(q, i))) ->
                      hasIntegerCoefficients(q)
                    [by equiv_converse the-unbounded-meaning]
                  @conclusion-the-integrality-is-unbounded |
                    hasIntegerCoefficients(q)
                    [by modus_ponens the-unbounded-backward every-coefficient-is-an-integer]
                }
              @conclusion-the-bounded-integrality-gives-it |
                qpoly.hasIntegerCoefficientsUpTo(q, peano.succ(n)) ->
                  hasIntegerCoefficients(q)
                [by discharge given-the-bounded-integrality]
            }
          @conclusion-the-degree-bound-gives-it |
            qpoly.qdegreeAtMost(q, n) ->
              qpoly.hasIntegerCoefficientsUpTo(q, peano.succ(n)) ->
              hasIntegerCoefficients(q)
            [by discharge given-the-degree-bound]
        }
      @conclusion-for-all-n |
        forall n: Nat;
          qpoly.qdegreeAtMost(q, n) ->
          qpoly.hasIntegerCoefficientsUpTo(q, peano.succ(n)) ->
          hasIntegerCoefficients(q)
        [by generalize generalize-n]
    }
  @conclusion |
    forall q: QPoly; forall n: Nat;
      qpoly.qdegreeAtMost(q, n) ->
      qpoly.hasIntegerCoefficientsUpTo(q, peano.succ(n)) ->
      hasIntegerCoefficients(q)
    [by generalize generalize-q]
qed
