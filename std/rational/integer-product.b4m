// std/rational/integer-product.b4m — PRODUCTS OF INTEGER COEFFICIENTS, ON ℚ's CUT.
//
// Lemma 17.12 (AATA §17.3) clears a ℚ[x] polynomial's denominators by multiplying through by
// the product of them all. That product is a FOLD over the coefficient index range, and the
// fact the proof turns on is that every factor divides the whole product — which is what lets
// each coefficient's denominator cancel.
//
// `std/integer/product.b4m` has exactly this over ℤ (`productUpTo`, `everyEntryDividesProduct`),
// but its statements are over ℤ's own sorts. Reaching them at ℚ's `isInteger` cut would mean a
// guarded transfer whose source proofs are nonneg-ℤ inductions; since the fact is a short
// induction, it is proved DIRECTLY here instead — the same choice, for the same reason, as
// `std/rational/integer-order.b4m`'s `anIntegerDividingOneIsAUnit`.
//
// The fold itself needs no cut: `std/sequence.b4m` instantiates with `Value: Q` UNGUARDED, so
// a ℚ-valued product is an ordinary unguarded model.
import sequence <<< "std/sequence.b4m"
import rational <<< "std/rational.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import qpoly <<< "std/rational/polynomial.b4m"
import field_order <<< "std/field/order.b4m"
import rational_integer_order <<< "std/rational/integer-order.b4m"
import natural_wellordering <<< "std/rational/natural-wellordering.b4m"
import rational_integer_division <<< "std/rational/integer-division.b4m"

sort Q = rational.Q
sort Nat = peano.Nat
const ZERO = rational.ZERO
const ONE = rational.ONE
const NAT_ZERO = peano.ZERO
oper nat_succ = peano.succ
oper nat_add = peano.add
oper recip = rational.recip
pred less_than = rational.less_than
// ℕ's order and zero, for the coefficient INDEX range. This file lives under std/rational/,
// so ℚ owns the bare names and the ℕ visitor takes the `nat_`/`NAT_` prefix (user ruling
// 2026-10-31; a full-word prefix, never a bare letter).
pred nat_less_than = peano_order.less_than
pred isInteger = rational.isInteger
pred isNatural = rational.isNatural

// -- a ℚ-valued product fold --------------------------------------------------------------
sort QSeq
oper qat(s: QSeq, i: Nat) => Q
oper qProductUpTo(s: QSeq, k: Nat) => Q
axiom qProductUpToZero: forall s: QSeq; qProductUpTo(s, NAT_ZERO) = ONE
axiom qProductUpToSucc: forall s: QSeq; forall k: Nat;
  qProductUpTo(s, nat_succ(k)) = rational.mul(qProductUpTo(s, k), qat(s, k))
// PREPEND, restated at ℚSeq. This is what makes a per-index choice realizable: a sequence
// satisfying a spec on the first n indices is BUILT by induction on n, prepending one witness
// at a time. `std/sequence.b4m` states it as an axiom, and an axiom does not transfer through
// a model, so it is restated here and discharged into `RationalSeq`.
axiom qSeqPrependExists: forall x: Q; forall s: QSeq;
  exists u: QSeq;
  qat(u, NAT_ZERO) = x and (forall i: Nat; qat(u, nat_succ(i)) = qat(s, i))
axiom qSeqSingletonExists: forall x: Q;
  exists s: QSeq; qat(s, NAT_ZERO) = x and qProductUpTo(s, nat_succ(NAT_ZERO)) = x
// CONCATENATION, restated at ℚSeq. This is the one that extends at the TOP: the result keeps
// s's entries below j and puts t's entries at j+i. An INDEX-PINNED spec (c_i must be THAT
// coefficient's denominator) needs exactly this — prepend would shift every earlier witness.
axiom qSeqConcatExists: forall s, t: QSeq; forall j, k: Nat;
  exists u: QSeq;
  (forall i: Nat; nat_less_than(i, j) -> qat(u, i) = qat(s, i))
  and (forall i: Nat; nat_less_than(i, k) -> qat(u, nat_add(j, i)) = qat(t, i))
  and qProductUpTo(u, nat_add(j, k)) =
  rational.mul(qProductUpTo(s, j), qProductUpTo(t, k))

// UNGUARDED: the value sort is all of ℚ, so this composes freely — no cut, no relativization.
model RationalSeq {
  sequence.Nat: Nat
  sequence.ZERO: NAT_ZERO
  sequence.succ: nat_succ
  sequence.Value: Q
  sequence.Seq: QSeq
  sequence.at: qat
  sequence.IDENTITY: ONE
  sequence.combine: rational.mul
  sequence.foldUpTo: qProductUpTo
  sequence.foldZero <- qProductUpToZero
  sequence.foldSucc <- qProductUpToSucc
  sequence.seqPrependExists <- qSeqPrependExists
  sequence.seqSingletonExists <- qSeqSingletonExists
  sequence.seqConcatExists <- qSeqConcatExists
}

// `indexed`'s singleton and concat are WEAKER than `sequence`'s — no fold clause — so they
// follow by dropping a conjunct.
theorem qSeqSingletonOnly: forall x: Q;
  exists s: QSeq; qat(s, NAT_ZERO) = x
proof
  @generalize-x |
    fix x: Q {
      @the-singleton-exists |
        exists s: QSeq;
          qat(s, NAT_ZERO) = x and qProductUpTo(s, nat_succ(NAT_ZERO)) = x
        [using specialize qSeqSingletonExists(x)]
      @the-weaker-form |
        unpack s: QSeq from the-singleton-exists {
          @with-singleton |
            qat(s, NAT_ZERO) = x and qProductUpTo(s, nat_succ(NAT_ZERO)) = x
            [by hypothesis the-weaker-form]
          @the-head |
            qat(s, NAT_ZERO) = x
            [by and_lhs with-singleton]
          @conclusion-exists |
            exists s2: QSeq; qat(s2, NAT_ZERO) = x
            [by witness(s) the-head]
        }
      @the-singleton-without-the-fold |
        exists s: QSeq; qat(s, NAT_ZERO) = x
        [by unpacked the-weaker-form]
    }
  @conclusion |
    forall x: Q; exists s: QSeq; qat(s, NAT_ZERO) = x
    [by generalize generalize-x]
qed

theorem qSeqConcatOnly: forall s, t: QSeq; forall j, k: Nat;
  exists u: QSeq;
  (forall i: Nat; nat_less_than(i, j) -> qat(u, i) = qat(s, i))
  and (forall i: Nat; nat_less_than(i, k) -> qat(u, nat_add(j, i)) = qat(t, i))
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-t |
        fix t: QSeq {
          @generalize-j |
            fix j: Nat {
              @generalize-k |
                fix k: Nat {
                  @the-concat-exists |
                    exists u: QSeq;
                      (forall i: Nat; nat_less_than(i, j) -> qat(u, i) = qat(s, i))
                      and (forall i: Nat; nat_less_than(i, k) ->
                      qat(u, nat_add(j, i)) = qat(t, i))
                      and qProductUpTo(u, nat_add(j, k)) =
                      rational.mul(qProductUpTo(s, j), qProductUpTo(t, k))
                    [using specialize qSeqConcatExists(s, t, j, k)]
                  @the-weaker-form |
                    unpack u: QSeq from the-concat-exists {
                      @with-concat |
                        (forall i: Nat; nat_less_than(i, j) -> qat(u, i) = qat(s, i))
                          and (forall i: Nat; nat_less_than(i, k) ->
                          qat(u, nat_add(j, i)) = qat(t, i))
                          and qProductUpTo(u, nat_add(j, k)) =
                          rational.mul(qProductUpTo(s, j), qProductUpTo(t, k))
                        [by hypothesis the-weaker-form]
                      @the-entry-clauses |
                        (forall i: Nat; nat_less_than(i, j) -> qat(u, i) = qat(s, i))
                          and (forall i: Nat; nat_less_than(i, k) ->
                          qat(u, nat_add(j, i)) = qat(t, i))
                        [by and_lhs with-concat]
                      @conclusion-exists |
                        exists u2: QSeq;
                          (forall i: Nat; nat_less_than(i, j) ->
                          qat(u2, i) = qat(s, i))
                          and (forall i: Nat; nat_less_than(i, k) ->
                          qat(u2, nat_add(j, i)) = qat(t, i))
                        [by witness(u) the-entry-clauses]
                    }
                  @the-concat-without-the-fold |
                    exists u: QSeq;
                      (forall i: Nat; nat_less_than(i, j) -> qat(u, i) = qat(s, i))
                      and (forall i: Nat; nat_less_than(i, k) ->
                      qat(u, nat_add(j, i)) = qat(t, i))
                    [by unpacked the-weaker-form]
                }
              @discharge-k |
                forall k9: Nat;
                  exists u: QSeq;
                  (forall i: Nat; nat_less_than(i, j) -> qat(u, i) = qat(s, i))
                  and (forall i: Nat; nat_less_than(i, k9) ->
                  qat(u, nat_add(j, i)) = qat(t, i))
                [by generalize generalize-k]
            }
          @discharge-j |
            forall j9: Nat; forall k: Nat;
              exists u: QSeq;
              (forall i: Nat; nat_less_than(i, j9) -> qat(u, i) = qat(s, i))
              and (forall i: Nat; nat_less_than(i, k) ->
              qat(u, nat_add(j9, i)) = qat(t, i))
            [by generalize generalize-j]
        }
      @discharge-t |
        forall t9: QSeq; forall j, k: Nat;
          exists u: QSeq;
          (forall i: Nat; nat_less_than(i, j) -> qat(u, i) = qat(s, i))
          and (forall i: Nat; nat_less_than(i, k) ->
          qat(u, nat_add(j, i)) = qat(t9, i))
        [by generalize generalize-t]
    }
  @conclusion |
    forall s, t: QSeq; forall j, k: Nat;
      exists u: QSeq;
      (forall i: Nat; nat_less_than(i, j) -> qat(u, i) = qat(s, i))
      and (forall i: Nat; nat_less_than(i, k) -> qat(u, nat_add(j, i)) = qat(t, i))
    [by generalize generalize-s]
qed

// `std/indexed.b4m`'s mapped-list construction at ℚ: for any map f and sequence s there is a
// sequence whose first m entries are f(s_0), …, f(s_{m-1}). Its proof there is the index-pinned
// induction (grow by concatenating a singleton at the TOP) — exactly what Lemma 17.12 needs and
// what prepend cannot do.
// The instance Lemma 17.12 wants: the sequence of RECIPROCALS of a given sequence's entries.
// Proved by the index-pinned induction DIRECTLY rather than by transferring
// `indexed.mappedListExists`. A theorem-schema will not come across a model: mapping it is
// rejected ("model maps only axioms … it materializes through the mapped axioms"), while
// citing it through the model is rejected as an undischarged schema obligation, and the `<-`
// form the diagnostic suggests needs a POSITED local schema — an axiom, which the
// axiomatization rule forbids for something provable. So the induction is redone here, on the
// ℚ construction axioms the model already discharges.
//
// Strategy: induction on m. Base: nothing below NAT_ZERO, the singleton serves. Step: take the
// sequence good below k, append a one-entry sequence carrying recip(qat(s,k)) at position k
// via concat — clause 1 keeps the entries below k, clause 2 puts the new one at k + 0 = k.
// The sequence must be nonzero WHERE IT IS INVERTED, as a hypothesis rather than a
// per-conclusion guard: the construction inverts every entry below m eagerly, so it must know
// they are nonzero BEFORE building. With a total `recip` this would build silently with junk
// at a zero entry — the unverifiable-division case the no-totalizing rule exists to prevent.
theorem theReciprocalSequenceExists: forall s: QSeq;
  (forall i: Nat; rational.nonzero(qat(s, i))) ->
  (forall m: Nat; exists t: QSeq; forall i: Nat;
  nat_less_than(i, m) -> qat(t, i) = recip(qat(s, i)))
proof
  @generalize-s |
    fix s: QSeq {
      @given-every-entry-is-nonzero |
        assume forall i: Nat; rational.nonzero(qat(s, i)) {
          @every-entry-is-nonzero |
            forall i: Nat; rational.nonzero(qat(s, i))
            [by hypothesis given-every-entry-is-nonzero]
          // base: any sequence serves below NAT_ZERO — and it is witnessed at ZERO rather than at
          // a reciprocal, because `recip` is GUARDED and nothing here knows `qat(s, ZERO)` is
          // nonzero. The value is never read: no index is below ZERO.
          @some-sequence-exists |
            exists t: QSeq; qat(t, NAT_ZERO) = ZERO
            [using specialize qSeqSingletonOnly(ZERO)]
          @base-case |
            unpack t0: QSeq from some-sequence-exists {
              @nothing-below-zero |
                fix i: Nat {
                  // the guard BEFORE the assume: the discharged conclusion writes
                  // `recip(qat(s, i))` outside it, so the obligation must be met from here.
                  @this-entry-is-nonzero |
                    rational.nonzero(qat(s, i))
                    [using specialize every-entry-is-nonzero(i)]
                  @given-i-below-zero |
                    assume nat_less_than(i, NAT_ZERO) {
                      @i-below-zero |
                        nat_less_than(i, NAT_ZERO)
                        [by hypothesis given-i-below-zero]
                      @nothing-is-below-zero |
                        not nat_less_than(i, NAT_ZERO)
                        [using specialize peano_order.notLessThanZero(i)]
                      @conclusion-vacuous |
                        qat(t0, i) = recip(qat(s, i))
                        [by ex_falso i-below-zero nothing-is-below-zero]
                    }
                  @below-zero-implies |
                    nat_less_than(i, NAT_ZERO) -> qat(t0, i) = recip(qat(s, i))
                    [by discharge given-i-below-zero]
                }
              @all-below-zero |
                forall i: Nat; nat_less_than(i, NAT_ZERO) -> qat(t0, i) = recip(qat(s, i))
                [by generalize nothing-below-zero]
              @conclusion-base-inner |
                exists t: QSeq; forall i: Nat;
                  nat_less_than(i, NAT_ZERO) -> qat(t, i) = recip(qat(s, i))
                [by witness(t0) all-below-zero]
            }
          @base-case-exported |
            exists t: QSeq; forall i: Nat;
              nat_less_than(i, NAT_ZERO) -> qat(t, i) = recip(qat(s, i))
            [by unpacked base-case]

          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume exists t: QSeq; forall i: Nat;
                  nat_less_than(i, k) -> qat(t, i) = recip(qat(s, i)) {
                  @inductive-hypothesis |
                    exists t: QSeq; forall i: Nat;
                      nat_less_than(i, k) -> qat(t, i) = recip(qat(s, i))
                    [by hypothesis given-inductive-hypothesis]
                  @conclusion-the-step |
                    unpack tk: QSeq from inductive-hypothesis {
                      @with-previous-tk |
                        forall i: Nat; nat_less_than(i, k) -> qat(tk, i) = recip(qat(s, i))
                        [by hypothesis conclusion-the-step]
                      // the k-th entry is nonzero, so its reciprocal is a writable term — this is
                      // the step a TOTAL `recip` would let through with junk.
                      @the-k-th-entry-is-nonzero |
                        rational.nonzero(qat(s, k))
                        [using specialize every-entry-is-nonzero(k)]
                      // a one-entry sequence carrying the k-th image
                      @the-new-entry-exists |
                        exists w: QSeq; qat(w, NAT_ZERO) = recip(qat(s, k))
                        [using specialize qSeqSingletonOnly(recip(qat(s, k)))]
                      @with-the-new-entry |
                        unpack w: QSeq from the-new-entry-exists {
                          @the-new-entry |
                            qat(w, NAT_ZERO) = recip(qat(s, k))
                            [by hypothesis with-the-new-entry]
                          @the-concat-exists |
                            exists u: QSeq;
                              (forall i: Nat; nat_less_than(i, k) -> qat(u, i) = qat(tk, i))
                              and (forall i: Nat; nat_less_than(i, nat_succ(NAT_ZERO)) ->
                              qat(u, nat_add(k, i)) = qat(w, i))
                            [using specialize qSeqConcatOnly(tk, w, k, nat_succ(NAT_ZERO))]
                          @with-the-concat |
                            unpack u: QSeq from the-concat-exists {
                              @with-concat-u |
                                (forall i: Nat; nat_less_than(i, k) -> qat(u, i) = qat(tk, i))
                                  and (forall i: Nat; nat_less_than(i, nat_succ(NAT_ZERO)) ->
                                  qat(u, nat_add(k, i)) = qat(w, i))
                                [by hypothesis with-the-concat]
                              @below-k-unchanged |
                                forall i: Nat; nat_less_than(i, k) -> qat(u, i) = qat(tk, i)
                                [by and_lhs with-concat-u]
                              @at-k-is-the-new-entry |
                                forall i: Nat; nat_less_than(i, nat_succ(NAT_ZERO)) ->
                                  qat(u, nat_add(k, i)) = qat(w, i)
                                [by and_rhs with-concat-u]
                              // index k + 0 = k carries the new entry
                              @zero-below-one |
                                nat_less_than(NAT_ZERO, nat_succ(NAT_ZERO))
                                [using specialize peano_order.lessThanSelf(NAT_ZERO)]
                              @at-k-plus-zero |
                                qat(u, nat_add(k, NAT_ZERO)) = qat(w, NAT_ZERO)
                                [using specialize at-k-is-the-new-entry(NAT_ZERO) zero-below-one]
                              @k-plus-zero |
                                nat_add(k, NAT_ZERO) = k
                                [using specialize peano.addZeroRight(k)]
                              @at-k |
                                qat(u, k) = qat(w, NAT_ZERO)
                                [by rewrite k-plus-zero at-k-plus-zero]
                              @at-k-is-the-image |
                                qat(u, k) = recip(qat(s, k))
                                [by rewrite the-new-entry at-k]
                              @good-below-succ-k |
                                fix i: Nat {
                                  @entry-i-is-nonzero |
                                    rational.nonzero(qat(s, i))
                                    [using specialize every-entry-is-nonzero(i)]
                                  @given-i-below-succ-k |
                                    assume nat_less_than(i, nat_succ(k)) {
                                      @i-below-succ-k |
                                        nat_less_than(i, nat_succ(k))
                                        [by hypothesis given-i-below-succ-k]
                                      @the-split |
                                        nat_less_than(i, k) or i = k
                                        [using specialize peano_order.lessThanSuccSplit(i, k) i-below-succ-k]
                                      @conclusion-this-entry |
                                        qat(u, i) = recip(qat(s, i))
                                        case the-split {
                                          @when-i-below-k |
                                            assume nat_less_than(i, k) {
                                              @i-below-k |
                                                nat_less_than(i, k)
                                                [by hypothesis when-i-below-k]
                                              @unchanged-at-i |
                                                qat(u, i) = qat(tk, i)
                                                [using specialize below-k-unchanged(i) i-below-k]
                                              @the-old-image |
                                                qat(tk, i) = recip(qat(s, i))
                                                [using specialize with-previous-tk(i) i-below-k]
                                              @conclusion-below-k |
                                                qat(u, i) = recip(qat(s, i))
                                                [using simplify unchanged-at-i the-old-image]
                                            }
                                          @when-i-is-k |
                                            assume i = k {
                                              @i-is-k |
                                                i = k
                                                [by hypothesis when-i-is-k]
                                              @conclusion-at-k |
                                                qat(u, i) = recip(qat(s, i))
                                                [by rewrite i-is-k at-k-is-the-image]
                                            }
                                        }
                                    }
                                  @below-succ-k-implies |
                                    nat_less_than(i, nat_succ(k)) -> qat(u, i) = recip(qat(s, i))
                                    [by discharge given-i-below-succ-k]
                                }
                              @all-good-below-succ-k |
                                forall i: Nat;
                                  nat_less_than(i, nat_succ(k)) -> qat(u, i) = recip(qat(s, i))
                                [by generalize good-below-succ-k]
                              @conclusion-the-extended |
                                exists t: QSeq; forall i: Nat;
                                  nat_less_than(i, nat_succ(k)) -> qat(t, i) = recip(qat(s, i))
                                [by witness(u) all-good-below-succ-k]
                            }
                          @conclusion-concat-exported |
                            exists t: QSeq; forall i: Nat;
                              nat_less_than(i, nat_succ(k)) -> qat(t, i) = recip(qat(s, i))
                            [by unpacked with-the-concat]
                        }
                      @conclusion-entry-exported |
                        exists t: QSeq; forall i: Nat;
                          nat_less_than(i, nat_succ(k)) -> qat(t, i) = recip(qat(s, i))
                        [by unpacked with-the-new-entry]
                    }
                  @the-step-exported |
                    exists t: QSeq; forall i: Nat;
                      nat_less_than(i, nat_succ(k)) -> qat(t, i) = recip(qat(s, i))
                    [by unpacked conclusion-the-step]
                }
              @induction-step-at-k |
                (exists t: QSeq; forall i: Nat;
                  nat_less_than(i, k) -> qat(t, i) = recip(qat(s, i))) ->
                  (exists t: QSeq; forall i: Nat;
                  nat_less_than(i, nat_succ(k)) -> qat(t, i) = recip(qat(s, i)))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat;
              (exists t: QSeq; forall i: Nat;
              nat_less_than(i, k) -> qat(t, i) = recip(qat(s, i))) ->
              (exists t: QSeq; forall i: Nat;
              nat_less_than(i, nat_succ(k)) -> qat(t, i) = recip(qat(s, i)))
            [by generalize induction-step]
          @all-bounds |
            forall m: Nat;
              exists t: QSeq; forall i: Nat;
              nat_less_than(i, m) -> qat(t, i) = recip(qat(s, i))
            [using instantiation peano.induction((fun z: Nat => (exists t: QSeq; forall i: Nat; nat_less_than(i, z) -> qat(t, i) = recip(qat(s, i))))) base-case-exported induction-step-for-all-k]
        }
      @nonzero-implies-the-sequence |
        (forall i: Nat; rational.nonzero(qat(s, i))) ->
          (forall m: Nat; exists t: QSeq; forall i: Nat;
          nat_less_than(i, m) -> qat(t, i) = recip(qat(s, i)))
        [by discharge given-every-entry-is-nonzero]
    }
  @conclusion |
    forall s: QSeq;
      (forall i: Nat; rational.nonzero(qat(s, i))) ->
      (forall m: Nat; exists t: QSeq; forall i: Nat;
      nat_less_than(i, m) -> qat(t, i) = recip(qat(s, i)))
    [by generalize generalize-s]
qed

// The one-entry product, from the shared fold theory.
theorem theOneEntryProduct: forall s: QSeq;
  qProductUpTo(s, nat_succ(NAT_ZERO)) = rational.mul(ONE, qat(s, NAT_ZERO))
proof
  @conclusion |
    forall s: QSeq;
      qProductUpTo(s, nat_succ(NAT_ZERO)) = rational.mul(ONE, qat(s, NAT_ZERO))
    [using model(RationalSeq) sequence.foldOneCombinesIdentity]
qed

// -- divisibility on the cut --------------------------------------------------------------
// `dividesOnTheCut(d, n)`: an integer quotient exists. Same reading as
// `std/rational/polynomial.b4m`'s, written out here because a `define` is a macro and cannot
// be imported.
pred dividesIntegrally(d: Q, n: Q)
axiom dividesIntegrallyMeaning: forall d, n: Q;
  dividesIntegrally(d, n) iff
  (exists k: Q; isInteger(k) and n = rational.mul(d, k))

// A product of integers is an integer: induction on the bound, using ℚ's `isIntegerMul`.
theorem theProductOfIntegersIsAnInteger: forall s: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
  isInteger(qProductUpTo(s, n))
proof
  @generalize-s |
    fix s: QSeq {
      // base: the empty product is ONE, hence an integer
      @base-case-proof |
        assume forall i: Nat; nat_less_than(i, NAT_ZERO) -> isInteger(qat(s, i)) {
          @the-empty-product-inner |
            qProductUpTo(s, NAT_ZERO) = ONE
            [using specialize qProductUpToZero(s)]
          @one-is-an-integer-inner |
            isInteger(ONE)
            [by cite rational.oneIsAnInteger]
          @the-empty-product-again |
            isInteger(qProductUpTo(s, NAT_ZERO))
            [by rewrite the-empty-product-inner one-is-an-integer-inner]
        }
      @base-case |
        (forall i: Nat; nat_less_than(i, NAT_ZERO) -> isInteger(qat(s, i))) ->
          isInteger(qProductUpTo(s, NAT_ZERO))
        [by discharge base-case-proof]
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume (forall i: Nat; nat_less_than(i, k) -> isInteger(qat(s, i))) ->
              isInteger(qProductUpTo(s, k)) {
              @inductive-hypothesis |
                (forall i: Nat; nat_less_than(i, k) -> isInteger(qat(s, i))) ->
                  isInteger(qProductUpTo(s, k))
                [by hypothesis given-inductive-hypothesis]
              @given-all-below-succ-k |
                assume forall i: Nat; nat_less_than(i, nat_succ(k)) -> isInteger(qat(s, i)) {
                  @all-below-succ-k |
                    forall i: Nat; nat_less_than(i, nat_succ(k)) -> isInteger(qat(s, i))
                    [by hypothesis given-all-below-succ-k]
                  // everything below k is below nat_succ(k)
                  @all-below-k |
                    fix i: Nat {
                      @given-i-below-k |
                        assume nat_less_than(i, k) {
                          @i-below-k |
                            nat_less_than(i, k)
                            [by hypothesis given-i-below-k]
                          @k-below-its-successor |
                            nat_less_than(k, nat_succ(k))
                            [using specialize peano_order.lessThanSelf(k)]
                          @i-below-succ-k |
                            nat_less_than(i, nat_succ(k))
                            [using specialize peano_order.lessThanTransitive(i, k, nat_succ(k)) i-below-k k-below-its-successor]
                          @conclusion-this-entry-is-an-integer |
                            isInteger(qat(s, i))
                            [using specialize all-below-succ-k(i) i-below-succ-k]
                        }
                      @below-k-implies-integer |
                        nat_less_than(i, k) -> isInteger(qat(s, i))
                        [by discharge given-i-below-k]
                    }
                  @all-below-k-generalized |
                    forall i: Nat; nat_less_than(i, k) -> isInteger(qat(s, i))
                    [by generalize all-below-k]
                  @the-partial-product-is-an-integer |
                    isInteger(qProductUpTo(s, k))
                    [by modus_ponens inductive-hypothesis all-below-k-generalized]
                  // and the k-th entry itself is an integer
                  @k-below-succ-k |
                    nat_less_than(k, nat_succ(k))
                    [using specialize peano_order.lessThanSelf(k)]
                  @the-k-th-entry-is-an-integer |
                    isInteger(qat(s, k))
                    [using specialize all-below-succ-k(k) k-below-succ-k]
                  @the-next-product |
                    qProductUpTo(s, nat_succ(k)) =
                      rational.mul(qProductUpTo(s, k), qat(s, k))
                    [using specialize qProductUpToSucc(s, k)]
                  @the-product-is-an-integer |
                    isInteger(rational.mul(qProductUpTo(s, k), qat(s, k)))
                    [using specialize rational.isIntegerMul(qProductUpTo(s, k), qat(s, k)) the-partial-product-is-an-integer the-k-th-entry-is-an-integer]
                  @conclusion-the-next-product-is-an-integer |
                    isInteger(qProductUpTo(s, nat_succ(k)))
                    [by rewrite the-next-product the-product-is-an-integer]
                }
              @conclusion-the-step |
                (forall i: Nat; nat_less_than(i, nat_succ(k)) -> isInteger(qat(s, i))) ->
                  isInteger(qProductUpTo(s, nat_succ(k)))
                [by discharge given-all-below-succ-k]
            }
          @induction-step-at-k |
            ((forall i: Nat; nat_less_than(i, k) -> isInteger(qat(s, i))) ->
              isInteger(qProductUpTo(s, k))) ->
              ((forall i: Nat; nat_less_than(i, nat_succ(k)) -> isInteger(qat(s, i))) ->
              isInteger(qProductUpTo(s, nat_succ(k))))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          ((forall i: Nat; nat_less_than(i, k) -> isInteger(qat(s, i))) ->
          isInteger(qProductUpTo(s, k))) ->
          ((forall i: Nat; nat_less_than(i, nat_succ(k)) -> isInteger(qat(s, i))) ->
          isInteger(qProductUpTo(s, nat_succ(k))))
        [by generalize induction-step]
      @all-bounds |
        forall n: Nat;
          (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
          isInteger(qProductUpTo(s, n))
        [using instantiation peano.induction((fun t: Nat => ((forall i: Nat; nat_less_than(i, t) -> isInteger(qat(s, i))) -> isInteger(qProductUpTo(s, t))))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
      isInteger(qProductUpTo(s, n))
    [by generalize generalize-s]
qed

// A factor divides a product whose other factor is an integer: the quotient IS that factor.
// Stated with the product given as an equation so the caller can supply its own shape.
theorem aFactorDividesTheProduct: forall d, q, whole: Q;
  isInteger(q) -> whole = rational.mul(q, d) -> dividesIntegrally(d, whole)
proof
  @generalize-d |
    fix d: Q {
      @generalize-q |
        fix q: Q {
          @generalize-whole |
            fix whole: Q {
              @given-q-is-an-integer |
                assume isInteger(q) {
                  @q-is-an-integer |
                    isInteger(q)
                    [by hypothesis given-q-is-an-integer]
                  @given-the-product |
                    assume whole = rational.mul(q, d) {
                      @the-product |
                        whole = rational.mul(q, d)
                        [by hypothesis given-the-product]
                      // d · q = q · d, so the witness quotient is q
                      @the-product-commutes |
                        rational.mul(q, d) = rational.mul(d, q)
                        [using specialize rational.mulIsCommutative(q, d)]
                      @the-product-as-d-times-q |
                        whole = rational.mul(d, q)
                        [by rewrite the-product-commutes the-product]
                      @the-witness-works |
                        isInteger(q) and whole = rational.mul(d, q)
                        [by both q-is-an-integer the-product-as-d-times-q]
                      @the-quotient-exists |
                        exists k: Q; isInteger(k) and whole = rational.mul(d, k)
                        [by witness(q) the-witness-works]
                      @divides-meaning |
                        dividesIntegrally(d, whole) iff
                          (exists k: Q; isInteger(k) and whole = rational.mul(d, k))
                        [using specialize dividesIntegrallyMeaning(d, whole)]
                      @conclusion-d-divides |
                        dividesIntegrally(d, whole)
                        [using tautology divides-meaning the-quotient-exists]
                    }
                  @product-implies-divides |
                    whole = rational.mul(q, d) -> dividesIntegrally(d, whole)
                    [by discharge given-the-product]
                }
              @integer-implies |
                isInteger(q) -> whole = rational.mul(q, d) ->
                  dividesIntegrally(d, whole)
                [by discharge given-q-is-an-integer]
            }
          @discharge-whole |
            forall w9: Q;
              isInteger(q) -> w9 = rational.mul(q, d) -> dividesIntegrally(d, w9)
            [by generalize generalize-whole]
        }
      @discharge-q |
        forall q9: Q; forall w9: Q;
          isInteger(q9) -> w9 = rational.mul(q9, d) -> dividesIntegrally(d, w9)
        [by generalize generalize-q]
    }
  @conclusion |
    forall d, q, whole: Q;
      isInteger(q) -> whole = rational.mul(q, d) -> dividesIntegrally(d, whole)
    [by generalize generalize-d]
qed

// If d divides a factor, it divides the product: multiply d's quotient by the other factor,
// which must itself be an integer for the quotient to stay one.
theorem aDivisorOfTheFactorDividesTheProduct: forall d, factor, other: Q;
  dividesIntegrally(d, factor) -> isInteger(other) ->
  forall whole: Q; whole = rational.mul(factor, other) ->
  dividesIntegrally(d, whole)
proof
  @generalize-d |
    fix d: Q {
      @generalize-factor |
        fix factor: Q {
          @generalize-other |
            fix other: Q {
              @given-d-divides-the-factor |
                assume dividesIntegrally(d, factor) {
                  @d-divides-the-factor |
                    dividesIntegrally(d, factor)
                    [by hypothesis given-d-divides-the-factor]
                  @given-other-is-an-integer |
                    assume isInteger(other) {
                      @other-is-an-integer |
                        isInteger(other)
                        [by hypothesis given-other-is-an-integer]
                      @generalize-whole |
                        fix whole: Q {
                          @given-the-product |
                            assume whole = rational.mul(factor, other) {
                              @the-product |
                                whole = rational.mul(factor, other)
                                [by hypothesis given-the-product]
                              @divides-meaning-factor |
                                dividesIntegrally(d, factor) iff
                                  (exists k: Q; isInteger(k) and
                                  factor = rational.mul(d, k))
                                [using specialize dividesIntegrallyMeaning(d, factor)]
                              @the-quotient-exists |
                                exists k: Q; isInteger(k) and
                                  factor = rational.mul(d, k)
                                [using tautology divides-meaning-factor d-divides-the-factor]
                              @with-quotient |
                                unpack k: Q from the-quotient-exists {
                                  @with-quotient-k |
                                    isInteger(k) and factor = rational.mul(d, k)
                                    [by hypothesis with-quotient]
                                  @k-is-an-integer |
                                    isInteger(k)
                                    [by and_lhs with-quotient-k]
                                  @the-factor-is-d-times-k |
                                    factor = rational.mul(d, k)
                                    [by and_rhs with-quotient-k]
                                  // whole = (d·k)·other = d·(k·other)
                                  @the-product-at-the-quotient |
                                    whole = rational.mul(rational.mul(d, k), other)
                                    [by rewrite the-factor-is-d-times-k the-product]
                                  @reassociate |
                                    rational.mul(rational.mul(d, k), other) =
                                      rational.mul(d, rational.mul(k, other))
                                    [using specialize rational.mulIsAssociative(d, k, other)]
                                  @the-product-reassociated |
                                    whole = rational.mul(d, rational.mul(k, other))
                                    [by rewrite reassociate the-product-at-the-quotient]
                                  @the-new-quotient-is-an-integer |
                                    isInteger(rational.mul(k, other))
                                    [using specialize rational.isIntegerMul(k, other) k-is-an-integer other-is-an-integer]
                                  @the-witness-works |
                                    isInteger(rational.mul(k, other)) and
                                      whole = rational.mul(d, rational.mul(k, other))
                                    [by both the-new-quotient-is-an-integer the-product-reassociated]
                                  @the-new-quotient-exists |
                                    exists k2: Q; isInteger(k2) and
                                      whole = rational.mul(d, k2)
                                    [by witness(rational.mul(k, other)) the-witness-works]
                                  @divides-meaning-whole |
                                    dividesIntegrally(d, whole) iff
                                      (exists k2: Q; isInteger(k2) and
                                      whole = rational.mul(d, k2))
                                    [using specialize dividesIntegrallyMeaning(d, whole)]
                                  @conclusion-d-divides-whole |
                                    dividesIntegrally(d, whole)
                                    [using tautology divides-meaning-whole the-new-quotient-exists]
                                }
                              @conclusion-divides |
                                dividesIntegrally(d, whole)
                                [by unpacked with-quotient]
                            }
                          @product-implies-divides |
                            whole = rational.mul(factor, other) ->
                              dividesIntegrally(d, whole)
                            [by discharge given-the-product]
                        }
                      @conclusion-all-wholes |
                        forall whole: Q;
                          whole = rational.mul(factor, other) ->
                          dividesIntegrally(d, whole)
                        [by generalize generalize-whole]
                    }
                  @other-integer-implies |
                    isInteger(other) ->
                      forall whole: Q; whole = rational.mul(factor, other) ->
                      dividesIntegrally(d, whole)
                    [by discharge given-other-is-an-integer]
                }
              @divides-implies |
                dividesIntegrally(d, factor) -> isInteger(other) ->
                  forall whole: Q; whole = rational.mul(factor, other) ->
                  dividesIntegrally(d, whole)
                [by discharge given-d-divides-the-factor]
            }
          @discharge-other |
            forall o9: Q;
              dividesIntegrally(d, factor) -> isInteger(o9) ->
              forall whole: Q; whole = rational.mul(factor, o9) ->
              dividesIntegrally(d, whole)
            [by generalize generalize-other]
        }
      @discharge-factor |
        forall f9: Q; forall o9: Q;
          dividesIntegrally(d, f9) -> isInteger(o9) ->
          forall whole: Q; whole = rational.mul(f9, o9) ->
          dividesIntegrally(d, whole)
        [by generalize generalize-factor]
    }
  @conclusion |
    forall d, factor, other: Q;
      dividesIntegrally(d, factor) -> isInteger(other) ->
      forall whole: Q; whole = rational.mul(factor, other) ->
      dividesIntegrally(d, whole)
    [by generalize generalize-d]
qed

// -- EVERY ENTRY DIVIDES THE PRODUCT ------------------------------------------------------
// The fact Lemma 17.12's denominator-clearing turns on: multiplying through by c_0 ⋯ c_n
// clears EVERY denominator because each c_i divides the whole product. Induction on the bound:
// at nat_succ(k) the product is (previous)·c_k, so c_k divides it directly, and anything dividing
// the previous product still divides this one.
theorem everyEntryDividesTheProduct: forall s: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
  (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(qat(s, i), qProductUpTo(s, n)))
proof
  @generalize-s |
    fix s: QSeq {
      // base: nothing is below NAT_ZERO, so the claim is vacuous
      @base-case-proof |
        assume forall i: Nat; nat_less_than(i, NAT_ZERO) -> isInteger(qat(s, i)) {
          @nothing-below-zero |
            fix i: Nat {
              @given-i-below-zero |
                assume nat_less_than(i, NAT_ZERO) {
                  @i-below-zero |
                    nat_less_than(i, NAT_ZERO)
                    [by hypothesis given-i-below-zero]
                  @nothing-is-below-zero |
                    not nat_less_than(i, NAT_ZERO)
                    [using specialize peano_order.notLessThanZero(i)]
                  @conclusion-vacuous |
                    dividesIntegrally(qat(s, i), qProductUpTo(s, NAT_ZERO))
                    [by ex_falso i-below-zero nothing-is-below-zero]
                }
              @below-zero-implies |
                nat_less_than(i, NAT_ZERO) ->
                  dividesIntegrally(qat(s, i), qProductUpTo(s, NAT_ZERO))
                [by discharge given-i-below-zero]
            }
          @conclusion-base |
            forall i: Nat; nat_less_than(i, NAT_ZERO) ->
              dividesIntegrally(qat(s, i), qProductUpTo(s, NAT_ZERO))
            [by generalize nothing-below-zero]
        }
      @base-case |
        (forall i: Nat; nat_less_than(i, NAT_ZERO) -> isInteger(qat(s, i))) ->
          (forall i: Nat; nat_less_than(i, NAT_ZERO) ->
          dividesIntegrally(qat(s, i), qProductUpTo(s, NAT_ZERO)))
        [by discharge base-case-proof]

      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume (forall i: Nat; nat_less_than(i, k) -> isInteger(qat(s, i))) ->
              (forall i: Nat; nat_less_than(i, k) ->
              dividesIntegrally(qat(s, i), qProductUpTo(s, k))) {
              @inductive-hypothesis |
                (forall i: Nat; nat_less_than(i, k) -> isInteger(qat(s, i))) ->
                  (forall i: Nat; nat_less_than(i, k) ->
                  dividesIntegrally(qat(s, i), qProductUpTo(s, k)))
                [by hypothesis given-inductive-hypothesis]
              @given-all-integers-below-succ-k |
                assume forall i: Nat; nat_less_than(i, nat_succ(k)) -> isInteger(qat(s, i)) {
                  @all-integers-below-succ-k |
                    forall i: Nat; nat_less_than(i, nat_succ(k)) -> isInteger(qat(s, i))
                    [by hypothesis given-all-integers-below-succ-k]
                  @k-below-its-successor |
                    nat_less_than(k, nat_succ(k))
                    [using specialize peano_order.lessThanSelf(k)]
                  // weaken the integer hypothesis to below k
                  @all-integers-below-k |
                    fix i: Nat {
                      @given-i-below-k |
                        assume nat_less_than(i, k) {
                          @i-below-k |
                            nat_less_than(i, k)
                            [by hypothesis given-i-below-k]
                          @i-below-succ-k |
                            nat_less_than(i, nat_succ(k))
                            [using specialize peano_order.lessThanTransitive(i, k, nat_succ(k)) i-below-k k-below-its-successor]
                          @conclusion-this-is-an-integer |
                            isInteger(qat(s, i))
                            [using specialize all-integers-below-succ-k(i) i-below-succ-k]
                        }
                      @below-k-implies-integer |
                        nat_less_than(i, k) -> isInteger(qat(s, i))
                        [by discharge given-i-below-k]
                    }
                  @all-integers-below-k-generalized |
                    forall i: Nat; nat_less_than(i, k) -> isInteger(qat(s, i))
                    [by generalize all-integers-below-k]
                  @the-divisors-below-k |
                    forall i: Nat; nat_less_than(i, k) ->
                      dividesIntegrally(qat(s, i), qProductUpTo(s, k))
                    [by modus_ponens inductive-hypothesis all-integers-below-k-generalized]
                  // the product at nat_succ(k) is (product at k) · entry k
                  @the-next-product |
                    qProductUpTo(s, nat_succ(k)) =
                      rational.mul(qProductUpTo(s, k), qat(s, k))
                    [using specialize qProductUpToSucc(s, k)]
                  @the-k-th-entry-is-an-integer |
                    isInteger(qat(s, k))
                    [using specialize all-integers-below-succ-k(k) k-below-its-successor]
                  @the-partial-product-is-an-integer |
                    isInteger(qProductUpTo(s, k))
                    [using specialize theProductOfIntegersIsAnInteger(s, k) all-integers-below-k-generalized]
                  @each-entry-divides |
                    fix i: Nat {
                      @given-i-below-succ-k |
                        assume nat_less_than(i, nat_succ(k)) {
                          @i-below-succ-k |
                            nat_less_than(i, nat_succ(k))
                            [by hypothesis given-i-below-succ-k]
                          @the-split |
                            nat_less_than(i, k) or i = k
                            [using specialize peano_order.lessThanSuccSplit(i, k) i-below-succ-k]
                          @conclusion-this-entry-divides |
                            dividesIntegrally(qat(s, i), qProductUpTo(s, nat_succ(k)))
                            case the-split {
                              // i < k: entry i divides the PARTIAL product, which divides the
                              // next one (multiply the quotient by entry k)
                              @when-i-below-k |
                                assume nat_less_than(i, k) {
                                  @i-below-k |
                                    nat_less_than(i, k)
                                    [by hypothesis when-i-below-k]
                                  @divides-the-partial-product |
                                    dividesIntegrally(qat(s, i), qProductUpTo(s, k))
                                    [using specialize the-divisors-below-k(i) i-below-k]
                                  @for-every-whole |
                                    forall whole: Q;
                                      whole = rational.mul(qProductUpTo(s, k), qat(s, k)) ->
                                      dividesIntegrally(qat(s, i), whole)
                                    [using specialize aDivisorOfTheFactorDividesTheProduct(qat(s, i), qProductUpTo(s, k), qat(s, k)) divides-the-partial-product the-k-th-entry-is-an-integer]
                                  @conclusion-divides-via-the-partial |
                                    dividesIntegrally(qat(s, i), qProductUpTo(s, nat_succ(k)))
                                    [using specialize for-every-whole(qProductUpTo(s, nat_succ(k))) the-next-product]
                                }
                              // i = k: entry k divides (partial)·(entry k) with quotient the
                              // partial product, which is an integer
                              @when-i-is-k |
                                assume i = k {
                                  @i-is-k |
                                    i = k
                                    [by hypothesis when-i-is-k]
                                  @the-k-th-entry-divides |
                                    dividesIntegrally(qat(s, k), qProductUpTo(s, nat_succ(k)))
                                    [using specialize aFactorDividesTheProduct(qat(s, k), qProductUpTo(s, k), qProductUpTo(s, nat_succ(k))) the-partial-product-is-an-integer the-next-product]
                                  @conclusion-divides-at-k |
                                    dividesIntegrally(qat(s, i), qProductUpTo(s, nat_succ(k)))
                                    [by rewrite i-is-k the-k-th-entry-divides]
                                }
                            }
                        }
                      @below-succ-k-implies-divides |
                        nat_less_than(i, nat_succ(k)) ->
                          dividesIntegrally(qat(s, i), qProductUpTo(s, nat_succ(k)))
                        [by discharge given-i-below-succ-k]
                    }
                  @conclusion-all-divide |
                    forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                      dividesIntegrally(qat(s, i), qProductUpTo(s, nat_succ(k)))
                    [by generalize each-entry-divides]
                }
              @conclusion-the-step |
                (forall i: Nat; nat_less_than(i, nat_succ(k)) -> isInteger(qat(s, i))) ->
                  (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                  dividesIntegrally(qat(s, i), qProductUpTo(s, nat_succ(k))))
                [by discharge given-all-integers-below-succ-k]
            }
          @induction-step-at-k |
            ((forall i: Nat; nat_less_than(i, k) -> isInteger(qat(s, i))) ->
              (forall i: Nat; nat_less_than(i, k) ->
              dividesIntegrally(qat(s, i), qProductUpTo(s, k)))) ->
              ((forall i: Nat; nat_less_than(i, nat_succ(k)) -> isInteger(qat(s, i))) ->
              (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
              dividesIntegrally(qat(s, i), qProductUpTo(s, nat_succ(k)))))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          ((forall i: Nat; nat_less_than(i, k) -> isInteger(qat(s, i))) ->
          (forall i: Nat; nat_less_than(i, k) ->
          dividesIntegrally(qat(s, i), qProductUpTo(s, k)))) ->
          ((forall i: Nat; nat_less_than(i, nat_succ(k)) -> isInteger(qat(s, i))) ->
          (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
          dividesIntegrally(qat(s, i), qProductUpTo(s, nat_succ(k)))))
        [by generalize induction-step]
      @all-bounds |
        forall n: Nat;
          (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
          (forall i: Nat; nat_less_than(i, n) ->
          dividesIntegrally(qat(s, i), qProductUpTo(s, n)))
        [using instantiation peano.induction((fun t: Nat => ((forall i: Nat; nat_less_than(i, t) -> isInteger(qat(s, i))) -> (forall i: Nat; nat_less_than(i, t) -> dividesIntegrally(qat(s, i), qProductUpTo(s, t)))))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
      (forall i: Nat; nat_less_than(i, n) ->
      dividesIntegrally(qat(s, i), qProductUpTo(s, n)))
    [by generalize generalize-s]
qed

// -- BOUNDED CHOICE: a per-index existential yields a SEQUENCE ----------------------------
// Judson's Lemma 17.12 opens "suppose p(x) = b_0/c_0 + … + b_n/c_n x^n", which presumes a
// SEQUENCE of denominators. ℚ gives one existential per coefficient
// (`everyRationalIsAQuotientOfIntegers`), and those witnesses are NOT unique — 2/4 = 1/2 — so
// `std/function.b4m`'s `functionFromGraph` cannot pick them: it is definite description, and
// fires only on a proven-unique spec.
//
// What rescues the construction is that the choice is BOUNDED. Only indices below n matter, so
// the sequence is built by induction on n, prepending one witness per step — `qSeqPrependExists`
// is exactly that step. No choice principle is added: each witness comes from the hypothesis's
// own existential, and the induction does finitely many extractions.
//
// Stated for the shape 17.12 needs: every integer-nonzero spec below the bound is realized.

// Strategy: induction on n. Base: any sequence works below NAT_ZERO (nothing is below it). Step:
// unpack the witness at index n, take the sequence realizing the spec below n, and prepend —
// the prepended sequence's entry at nat_succ(i) is the old entry at i, so indices SHIFT. The
// shift is why the spec is carried as a predicate on the VALUE at each index rather than a
// fixed per-index list.
theorem aBoundedChoiceIsRealizedByASequence: forall n: Nat;
  (forall i: Nat; exists v: Q; isInteger(v) and rational.nonzero(v)) ->
  (exists s: QSeq; forall i: Nat; nat_less_than(i, n) ->
  (isInteger(qat(s, i)) and rational.nonzero(qat(s, i))))
proof
  @given-the-per-index-witnesses |
    assume forall i: Nat; exists v: Q;
      isInteger(v) and rational.nonzero(v) {
      @the-per-index-witnesses |
        forall i: Nat; exists v: Q;
          isInteger(v) and rational.nonzero(v)
        [by hypothesis given-the-per-index-witnesses]

      // base: below NAT_ZERO there is nothing to realize, so ANY sequence serves — and one
      // exists because the witnesses do.
      @the-witness-at-zero |
        exists v: Q; isInteger(v) and rational.nonzero(v)
        [using specialize the-per-index-witnesses(NAT_ZERO)]
      @base-case |
        unpack v0: Q from the-witness-at-zero {
          // any sequence at all serves below NAT_ZERO; the singleton on v0 exists
          @the-singleton-exists |
            exists s: QSeq;
              qat(s, NAT_ZERO) = v0 and qProductUpTo(s, nat_succ(NAT_ZERO)) = v0
            [using specialize qSeqSingletonExists(v0)]
          @with-the-singleton |
            unpack s0: QSeq from the-singleton-exists {
              @nothing-below-zero |
                fix i: Nat {
                  @given-i-below-zero |
                    assume nat_less_than(i, NAT_ZERO) {
                      @i-below-zero |
                        nat_less_than(i, NAT_ZERO)
                        [by hypothesis given-i-below-zero]
                      @nothing-is-below-zero |
                        not nat_less_than(i, NAT_ZERO)
                        [using specialize peano_order.notLessThanZero(i)]
                      @conclusion-vacuous |
                        isInteger(qat(s0, i)) and
                          rational.nonzero(qat(s0, i))
                        [by ex_falso i-below-zero nothing-is-below-zero]
                    }
                  @below-zero-implies |
                    nat_less_than(i, NAT_ZERO) ->
                      (isInteger(qat(s0, i)) and
                      rational.nonzero(qat(s0, i)))
                    [by discharge given-i-below-zero]
                }
              @all-below-zero |
                forall i: Nat; nat_less_than(i, NAT_ZERO) ->
                  (isInteger(qat(s0, i)) and
                  rational.nonzero(qat(s0, i)))
                [by generalize nothing-below-zero]
              @conclusion-the-base-sequence |
                exists s: QSeq; forall i: Nat; nat_less_than(i, NAT_ZERO) ->
                  (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))
                [by witness(s0) all-below-zero]
            }
          @conclusion-base-inner |
            exists s: QSeq; forall i: Nat; nat_less_than(i, NAT_ZERO) ->
              (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))
            [by unpacked with-the-singleton]
        }
      @base-case-exported |
        exists s: QSeq; forall i: Nat; nat_less_than(i, NAT_ZERO) ->
          (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))
        [by unpacked base-case]

      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume exists s: QSeq; forall i: Nat; nat_less_than(i, k) ->
              (isInteger(qat(s, i)) and rational.nonzero(qat(s, i))) {
              @inductive-hypothesis |
                exists s: QSeq; forall i: Nat; nat_less_than(i, k) ->
                  (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))
                [by hypothesis given-inductive-hypothesis]
              // PREPEND IS THE WRONG END for this spec. Prepending shifts every old index
              // up by one, so a sequence good below k becomes good at indices 1..k — it
              // says nothing at index k itself. What the step needs is the SAME sequence
              // extended at the top, which `qSeqPrependExists` does not provide.
              //
              // The spec here is index-INDEPENDENT (every entry must be a nonzero integer),
              // so the shift costs nothing: prepend any witness onto a good-below-k sequence
              // and the result is good below nat_succ(k) — index 0 holds the new witness, and
              // index nat_succ(i) for i < k holds the old entry at i.
              @the-witness-at-k |
                exists v: Q; isInteger(v) and rational.nonzero(v)
                [using specialize the-per-index-witnesses(k)]
              @conclusion-the-step |
                unpack vk: Q from the-witness-at-k {
                  @with-witness-vk |
                    isInteger(vk) and rational.nonzero(vk)
                    [by hypothesis conclusion-the-step]
                  @vk-is-an-integer |
                    isInteger(vk)
                    [by and_lhs with-witness-vk]
                  @vk-is-nonzero |
                    rational.nonzero(vk)
                    [by and_rhs with-witness-vk]
                  @with-the-previous |
                    unpack sk: QSeq from inductive-hypothesis {
                      @with-previous-sk |
                        forall i: Nat; nat_less_than(i, k) ->
                          (isInteger(qat(sk, i)) and
                          rational.nonzero(qat(sk, i)))
                        [by hypothesis with-the-previous]
                      @the-prepend-exists |
                        exists u: QSeq;
                          qat(u, NAT_ZERO) = vk and
                          (forall i: Nat; qat(u, nat_succ(i)) = qat(sk, i))
                        [using specialize qSeqPrependExists(vk, sk)]
                      @with-the-prepend |
                        unpack u: QSeq from the-prepend-exists {
                          @with-prepend-u |
                            qat(u, NAT_ZERO) = vk and
                              (forall i: Nat; qat(u, nat_succ(i)) = qat(sk, i))
                            [by hypothesis with-the-prepend]
                          @the-head-is-vk |
                            qat(u, NAT_ZERO) = vk
                            [by and_lhs with-prepend-u]
                          @the-tail-shifts |
                            forall i: Nat; qat(u, nat_succ(i)) = qat(sk, i)
                            [by and_rhs with-prepend-u]
                          @good-below-succ-k |
                            fix i: Nat {
                              @given-i-below-succ-k |
                                assume nat_less_than(i, nat_succ(k)) {
                                  @i-below-succ-k |
                                    nat_less_than(i, nat_succ(k))
                                    [by hypothesis given-i-below-succ-k]
                                  @the-index-cases |
                                    i = NAT_ZERO or (exists m: Nat; i = nat_succ(m))
                                    [using specialize peano.zeroOrSucc(i)]
                                  @conclusion-this-entry |
                                    isInteger(qat(u, i)) and
                                      rational.nonzero(qat(u, i))
                                    case the-index-cases {
                                      // index 0 holds the fresh witness
                                      @when-i-is-zero |
                                        assume i = NAT_ZERO {
                                          @i-is-zero |
                                            i = NAT_ZERO
                                            [by hypothesis when-i-is-zero]
                                          @the-entry-is-vk |
                                            qat(u, i) = vk
                                            [by rewrite i-is-zero the-head-is-vk]
                                          @vk-is-good |
                                            isInteger(vk) and
                                              rational.nonzero(vk)
                                            [by both vk-is-an-integer vk-is-nonzero]
                                          @conclusion-at-zero |
                                            isInteger(qat(u, i)) and
                                              rational.nonzero(qat(u, i))
                                            [by rewrite the-entry-is-vk vk-is-good]
                                        }
                                      // index nat_succ(m) holds the old entry at m, and m < k
                                      @when-i-is-a-successor |
                                        assume exists m: Nat; i = nat_succ(m) {
                                          @i-is-a-successor |
                                            exists m: Nat; i = nat_succ(m)
                                            [by hypothesis when-i-is-a-successor]
                                          @with-the-predecessor |
                                            unpack m: Nat from i-is-a-successor {
                                              @i-is-succ-m |
                                                i = nat_succ(m)
                                                [by hypothesis with-the-predecessor]
                                              @succ-m-below-succ-k |
                                                nat_less_than(nat_succ(m), nat_succ(k))
                                                [by rewrite i-is-succ-m i-below-succ-k]
                                              @m-below-k |
                                                nat_less_than(m, k)
                                                [using specialize peano_order.succReflectsOrder(m, k) succ-m-below-succ-k]
                                              @the-old-entry-is-good |
                                                isInteger(qat(sk, m)) and
                                                  rational.nonzero(qat(sk, m))
                                                [using specialize with-previous-sk(m) m-below-k]
                                              @the-entry-shifts |
                                                qat(u, nat_succ(m)) = qat(sk, m)
                                                [using specialize the-tail-shifts(m)]
                                              @the-new-entry-is-good |
                                                isInteger(qat(u, nat_succ(m))) and
                                                  rational.nonzero(qat(u, nat_succ(m)))
                                                [by rewrite the-entry-shifts the-old-entry-is-good]
                                              @conclusion-at-successor |
                                                isInteger(qat(u, i)) and
                                                  rational.nonzero(qat(u, i))
                                                [by rewrite i-is-succ-m the-new-entry-is-good]
                                            }
                                          @conclusion-successor-exported |
                                            isInteger(qat(u, i)) and
                                              rational.nonzero(qat(u, i))
                                            [by unpacked with-the-predecessor]
                                        }
                                    }
                                }
                              @below-succ-k-implies-good |
                                nat_less_than(i, nat_succ(k)) ->
                                  (isInteger(qat(u, i)) and
                                  rational.nonzero(qat(u, i)))
                                [by discharge given-i-below-succ-k]
                            }
                          @all-good-below-succ-k |
                            forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                              (isInteger(qat(u, i)) and
                              rational.nonzero(qat(u, i)))
                            [by generalize good-below-succ-k]
                          @conclusion-the-extended-sequence |
                            exists s: QSeq; forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                              (isInteger(qat(s, i)) and
                              rational.nonzero(qat(s, i)))
                            [by witness(u) all-good-below-succ-k]
                        }
                      @conclusion-prepend-exported |
                        exists s: QSeq; forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                          (isInteger(qat(s, i)) and
                          rational.nonzero(qat(s, i)))
                        [by unpacked with-the-prepend]
                    }
                  @conclusion-previous-exported |
                    exists s: QSeq; forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                      (isInteger(qat(s, i)) and
                      rational.nonzero(qat(s, i)))
                    [by unpacked with-the-previous]
                }
              @the-step-exported |
                exists s: QSeq; forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                  (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))
                [by unpacked conclusion-the-step]
            }
          @induction-step-at-k |
            (exists s: QSeq; forall i: Nat; nat_less_than(i, k) ->
              (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))) ->
              (exists s: QSeq; forall i: Nat; nat_less_than(i, nat_succ(k)) ->
              (isInteger(qat(s, i)) and rational.nonzero(qat(s, i))))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          (exists s: QSeq; forall i: Nat; nat_less_than(i, k) ->
          (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))) ->
          (exists s: QSeq; forall i: Nat; nat_less_than(i, nat_succ(k)) ->
          (isInteger(qat(s, i)) and rational.nonzero(qat(s, i))))
        [by generalize induction-step]
      @all-bounds |
        forall n: Nat;
          exists s: QSeq; forall i: Nat; nat_less_than(i, n) ->
          (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))
        [using instantiation peano.induction((fun t: Nat => (exists s: QSeq; forall i: Nat; nat_less_than(i, t) -> (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))))) base-case-exported induction-step-for-all-k]
      // the hypothesis is discharged OUTSIDE the `forall n`, so re-fix n and push it in
      @reorder |
        fix n: Nat {
          @at-this-bound |
            exists s: QSeq; forall i: Nat; nat_less_than(i, n) ->
              (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))
            [using specialize all-bounds(n)]
        }
      @all-bounds-refixed |
        forall n: Nat;
          exists s: QSeq; forall i: Nat; nat_less_than(i, n) ->
          (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))
        [by generalize reorder]
    }
  @witnesses-imply-the-sequences |
    (forall i: Nat; exists v: Q; isInteger(v) and rational.nonzero(v)) ->
      (forall n: Nat;
      exists s: QSeq; forall i: Nat; nat_less_than(i, n) ->
      (isInteger(qat(s, i)) and rational.nonzero(qat(s, i))))
    [by discharge given-the-per-index-witnesses]

  @final-reorder |
    fix n: Nat {
      @given-the-witnesses-again |
        assume forall i: Nat; exists v: Q;
          isInteger(v) and rational.nonzero(v) {
          @the-witnesses-again |
            forall i: Nat; exists v: Q;
              isInteger(v) and rational.nonzero(v)
            [by hypothesis given-the-witnesses-again]
          @all-bounds-here |
            forall n9: Nat;
              exists s: QSeq; forall i: Nat; nat_less_than(i, n9) ->
              (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))
            [by modus_ponens witnesses-imply-the-sequences the-witnesses-again]
          @conclusion-at-n |
            exists s: QSeq; forall i: Nat; nat_less_than(i, n) ->
              (isInteger(qat(s, i)) and rational.nonzero(qat(s, i)))
            [using specialize all-bounds-here(n)]
        }
      @witnesses-imply-at-n |
        (forall i: Nat; exists v: Q;
          isInteger(v) and rational.nonzero(v)) ->
          (exists s: QSeq; forall i: Nat; nat_less_than(i, n) ->
          (isInteger(qat(s, i)) and rational.nonzero(qat(s, i))))
        [by discharge given-the-witnesses-again]
    }
  @conclusion |
    forall n: Nat;
      (forall i: Nat; exists v: Q; isInteger(v) and rational.nonzero(v)) ->
      (exists s: QSeq; forall i: Nat; nat_less_than(i, n) ->
      (isInteger(qat(s, i)) and rational.nonzero(qat(s, i))))
    [by generalize final-reorder]
qed

// -- INDEX-PINNED CHOICE: the general form ------------------------------------------------
// `theReciprocalSequenceExists` MAPS a given sequence; Lemma 17.12 must CHOOSE one — a
// denominator per coefficient, pinned at that coefficient's index, from a non-unique
// existential. That is this theorem, and it is the last construction the lemma needs.
//
// Same induction as the mapped case (append a one-entry sequence at position k via concat),
// but the k-th entry comes from the hypothesis's existential rather than from f. The spec is
// a schema parameter because it relates an index to a value.
//
// No choice principle is added: the bound makes the extraction finite, and each witness is
// unpacked from a hypothesis the caller already proved.
theorem anIndexPinnedChoiceIsRealized(spec(Nat, Q)):
  (forall i: Nat; exists v: Q; spec(i, v)) ->
  forall n: Nat; exists t: QSeq; forall i: Nat; nat_less_than(i, n) -> spec(i, qat(t, i))

proof
  @given-the-witnesses |
    assume forall i: Nat; exists v: Q; spec(i, v) {
      @the-witnesses |
        forall i: Nat; exists v: Q; spec(i, v)
        [by hypothesis given-the-witnesses]

      // base: nothing below NAT_ZERO, so any sequence serves
      @the-witness-at-zero |
        exists v: Q; spec(NAT_ZERO, v)
        [using specialize the-witnesses(NAT_ZERO)]
      @base-case |
        unpack v0: Q from the-witness-at-zero {
          @some-sequence-exists |
            exists t: QSeq; qat(t, NAT_ZERO) = v0
            [using specialize qSeqSingletonOnly(v0)]
          @with-some-sequence |
            unpack t0: QSeq from some-sequence-exists {
              @nothing-below-zero |
                fix i: Nat {
                  @given-i-below-zero |
                    assume nat_less_than(i, NAT_ZERO) {
                      @i-below-zero |
                        nat_less_than(i, NAT_ZERO)
                        [by hypothesis given-i-below-zero]
                      @nothing-is-below-zero |
                        not nat_less_than(i, NAT_ZERO)
                        [using specialize peano_order.notLessThanZero(i)]
                      @conclusion-vacuous |
                        spec(i, qat(t0, i))
                        [by ex_falso i-below-zero nothing-is-below-zero]
                    }
                  @below-zero-implies |
                    nat_less_than(i, NAT_ZERO) -> spec(i, qat(t0, i))
                    [by discharge given-i-below-zero]
                }
              @all-below-zero |
                forall i: Nat; nat_less_than(i, NAT_ZERO) -> spec(i, qat(t0, i))
                [by generalize nothing-below-zero]
              @conclusion-base-inner |
                exists t: QSeq; forall i: Nat;
                  nat_less_than(i, NAT_ZERO) -> spec(i, qat(t, i))
                [by witness(t0) all-below-zero]
            }
          @conclusion-base-middle |
            exists t: QSeq; forall i: Nat;
              nat_less_than(i, NAT_ZERO) -> spec(i, qat(t, i))
            [by unpacked with-some-sequence]
        }
      @base-case-exported |
        exists t: QSeq; forall i: Nat;
          nat_less_than(i, NAT_ZERO) -> spec(i, qat(t, i))
        [by unpacked base-case]

      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume exists t: QSeq; forall i: Nat;
              nat_less_than(i, k) -> spec(i, qat(t, i)) {
              @inductive-hypothesis |
                exists t: QSeq; forall i: Nat;
                  nat_less_than(i, k) -> spec(i, qat(t, i))
                [by hypothesis given-inductive-hypothesis]
              @the-witness-at-k |
                exists v: Q; spec(k, v)
                [using specialize the-witnesses(k)]
              @conclusion-the-step |
                unpack vk: Q from the-witness-at-k {
                  @the-k-th-spec |
                    spec(k, vk)
                    [by hypothesis conclusion-the-step]
                  @with-previous |
                    unpack tk: QSeq from inductive-hypothesis {
                      @with-previous-tk |
                        forall i: Nat; nat_less_than(i, k) -> spec(i, qat(tk, i))
                        [by hypothesis with-previous]
                      @the-new-entry-exists |
                        exists w: QSeq; qat(w, NAT_ZERO) = vk
                        [using specialize qSeqSingletonOnly(vk)]
                      @with-the-new-entry |
                        unpack w: QSeq from the-new-entry-exists {
                          @the-new-entry |
                            qat(w, NAT_ZERO) = vk
                            [by hypothesis with-the-new-entry]
                          @the-concat-exists |
                            exists u: QSeq;
                              (forall i: Nat; nat_less_than(i, k) ->
                              qat(u, i) = qat(tk, i))
                              and (forall i: Nat; nat_less_than(i, nat_succ(NAT_ZERO)) ->
                              qat(u, nat_add(k, i)) = qat(w, i))
                            [using specialize qSeqConcatOnly(tk, w, k, nat_succ(NAT_ZERO))]
                          @with-the-concat |
                            unpack u: QSeq from the-concat-exists {
                              @with-concat-u |
                                (forall i: Nat; nat_less_than(i, k) ->
                                  qat(u, i) = qat(tk, i))
                                  and (forall i: Nat; nat_less_than(i, nat_succ(NAT_ZERO)) ->
                                  qat(u, nat_add(k, i)) = qat(w, i))
                                [by hypothesis with-the-concat]
                              @below-k-unchanged |
                                forall i: Nat; nat_less_than(i, k) ->
                                  qat(u, i) = qat(tk, i)
                                [by and_lhs with-concat-u]
                              @at-k-is-the-new-entry |
                                forall i: Nat; nat_less_than(i, nat_succ(NAT_ZERO)) ->
                                  qat(u, nat_add(k, i)) = qat(w, i)
                                [by and_rhs with-concat-u]
                              @zero-below-one |
                                nat_less_than(NAT_ZERO, nat_succ(NAT_ZERO))
                                [using specialize peano_order.lessThanSelf(NAT_ZERO)]
                              @at-k-plus-zero |
                                qat(u, nat_add(k, NAT_ZERO)) = qat(w, NAT_ZERO)
                                [using specialize at-k-is-the-new-entry(NAT_ZERO) zero-below-one]
                              @k-plus-zero |
                                nat_add(k, NAT_ZERO) = k
                                [using specialize peano.addZeroRight(k)]
                              @at-k |
                                qat(u, k) = qat(w, NAT_ZERO)
                                [by rewrite k-plus-zero at-k-plus-zero]
                              @at-k-is-vk |
                                qat(u, k) = vk
                                [by rewrite the-new-entry at-k]
                              @good-below-succ-k |
                                fix i: Nat {
                                  @given-i-below-succ-k |
                                    assume nat_less_than(i, nat_succ(k)) {
                                      @i-below-succ-k |
                                        nat_less_than(i, nat_succ(k))
                                        [by hypothesis given-i-below-succ-k]
                                      @the-split |
                                        nat_less_than(i, k) or i = k
                                        [using specialize peano_order.lessThanSuccSplit(i, k) i-below-succ-k]
                                      @conclusion-this-entry |
                                        spec(i, qat(u, i))
                                        case the-split {
                                          @when-i-below-k |
                                            assume nat_less_than(i, k) {
                                              @i-below-k |
                                                nat_less_than(i, k)
                                                [by hypothesis when-i-below-k]
                                              @unchanged-at-i |
                                                qat(u, i) = qat(tk, i)
                                                [using specialize below-k-unchanged(i) i-below-k]
                                              @the-old-spec |
                                                spec(i, qat(tk, i))
                                                [using specialize with-previous-tk(i) i-below-k]
                                              @conclusion-below-k |
                                                spec(i, qat(u, i))
                                                [by rewrite unchanged-at-i the-old-spec]
                                            }
                                          @when-i-is-k |
                                            assume i = k {
                                              @i-is-k |
                                                i = k
                                                [by hypothesis when-i-is-k]
                                              @the-spec-at-k |
                                                spec(k, qat(u, k))
                                                [by rewrite at-k-is-vk the-k-th-spec]
                                              @conclusion-at-k |
                                                spec(i, qat(u, i))
                                                [by rewrite i-is-k the-spec-at-k]
                                            }
                                        }
                                    }
                                  @below-succ-k-implies |
                                    nat_less_than(i, nat_succ(k)) -> spec(i, qat(u, i))
                                    [by discharge given-i-below-succ-k]
                                }
                              @all-good-below-succ-k |
                                forall i: Nat;
                                  nat_less_than(i, nat_succ(k)) -> spec(i, qat(u, i))
                                [by generalize good-below-succ-k]
                              @conclusion-the-extended |
                                exists t: QSeq; forall i: Nat;
                                  nat_less_than(i, nat_succ(k)) -> spec(i, qat(t, i))
                                [by witness(u) all-good-below-succ-k]
                            }
                          @conclusion-concat-exported |
                            exists t: QSeq; forall i: Nat;
                              nat_less_than(i, nat_succ(k)) -> spec(i, qat(t, i))
                            [by unpacked with-the-concat]
                        }
                      @conclusion-entry-exported |
                        exists t: QSeq; forall i: Nat;
                          nat_less_than(i, nat_succ(k)) -> spec(i, qat(t, i))
                        [by unpacked with-the-new-entry]
                    }
                  @conclusion-previous-exported |
                    exists t: QSeq; forall i: Nat;
                      nat_less_than(i, nat_succ(k)) -> spec(i, qat(t, i))
                    [by unpacked with-previous]
                }
              @the-step-exported |
                exists t: QSeq; forall i: Nat;
                  nat_less_than(i, nat_succ(k)) -> spec(i, qat(t, i))
                [by unpacked conclusion-the-step]
            }
          @induction-step-at-k |
            (exists t: QSeq; forall i: Nat;
              nat_less_than(i, k) -> spec(i, qat(t, i))) ->
              (exists t: QSeq; forall i: Nat;
              nat_less_than(i, nat_succ(k)) -> spec(i, qat(t, i)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          (exists t: QSeq; forall i: Nat;
          nat_less_than(i, k) -> spec(i, qat(t, i))) ->
          (exists t: QSeq; forall i: Nat;
          nat_less_than(i, nat_succ(k)) -> spec(i, qat(t, i)))
        [by generalize induction-step]
      @all-bounds |
        forall n: Nat;
          exists t: QSeq; forall i: Nat; nat_less_than(i, n) -> spec(i, qat(t, i))
        [using instantiation peano.induction((fun z: Nat => (exists t: QSeq; forall i: Nat; nat_less_than(i, z) -> spec(i, qat(t, i))))) base-case-exported induction-step-for-all-k]
    }
  @conclusion |
    (forall i: Nat; exists v: Q; spec(i, v)) ->
      forall n: Nat; exists t: QSeq; forall i: Nat;
      nat_less_than(i, n) -> spec(i, qat(t, i))
    [by discharge given-the-witnesses]
qed

// -- LEMMA 17.12, STEP 1: THE DENOMINATOR SEQUENCE ----------------------------------------
// Instantiating the choice at Judson's own spec — and this is what verifies the schema, since
// a schema is checked at its instantiations.
//
// "Suppose p(x) = b_0/c_0 + b_1/c_1 x + … + b_n/c_n x^n, where the b_i's and the c_i's are
// integers." Each coefficient of a ℚ[x] polynomial IS such a ratio
// (`everyCoefficientIsARatioOfIntegers`), so the spec "v is a nonzero integer denominator for
// index i" has a witness at every index, and the choice pins one per coefficient.
// The spec is about a FIXED polynomial, so the polynomial is a parameter of the predicate.
// `isADenominatorFor(i, v)` reads: v is a nonzero integer, and the i-th coefficient of p is
// an integer over v.
// 2-ARY, over (Nat, Q) — the shape the choice schema's `spec` parameter takes. The subject
// polynomial cannot be a third argument: a schema-arg lambda carries ONE shared sort
// annotation for all its binders (`fun y, z: Element => …`, as `functionFromGraph`'s callers
// write it), so `fun i: Nat, v: Q => …` is a parse error and there is no way to close over a
// polynomial. Instead the spec reads the coefficient through `theSubject`, a func the caller
// pins — which is enough, because 17.12 is proved for an ARBITRARY but fixed p.
oper theSubject() => qpoly.QPoly
pred isADenominatorFor(i: Nat, v: Q)
axiom denominatorMeaning: forall i: Nat; forall v: Q;
  isADenominatorFor(i, v) iff
  (isInteger(v) and less_than(ZERO, v) and rational.nonzero(v) and
  (exists b: Q; isInteger(b) and
  qpoly.qcoeff(theSubject, i) = rational.mul(b, recip(v))))

// The spec HOLDS at every index — ℚ's fraction axiom read at the i-th coefficient. A theorem,
// not an axiom: `everyCoefficientIsARatioOfIntegers` already provides the witness.
theorem aDenominatorExistsForEveryIndex: forall i: Nat;
  exists v: Q; isADenominatorFor(i, v)
proof
  @generalize-i |
    fix i: Nat {
      @every-coefficient-is-a-ratio |
        forall p2: qpoly.QPoly; forall i2: Nat;
          exists b, c: Q;
          isInteger(b) and isInteger(c) and rational.nonzero(c) and
          qpoly.qcoeff(p2, i2) = rational.mul(b, recip(c))
        [using import(qpoly) everyCoefficientIsARatioOfIntegers]
      @the-ratio |
        exists b, c: Q;
          isInteger(b) and isInteger(c) and rational.nonzero(c) and
          qpoly.qcoeff(theSubject, i) = rational.mul(b, recip(c))
        [using specialize every-coefficient-is-a-ratio(theSubject, i)]
      @with-the-ratio |
        unpack b: Q from the-ratio {
          @with-numerator-b |
            exists c: Q;
              isInteger(b) and isInteger(c) and rational.nonzero(c) and
              qpoly.qcoeff(theSubject, i) = rational.mul(b, recip(c))
            [by hypothesis with-the-ratio]
          @with-the-denominator |
            unpack c: Q from with-numerator-b {
              @the-parts |
                isInteger(b) and isInteger(c) and rational.nonzero(c) and
                  qpoly.qcoeff(theSubject, i) = rational.mul(b, recip(c))
                [by hypothesis with-the-denominator]
              @b-is-an-integer |
                isInteger(b)
                [using tautology the-parts]
              @c-is-an-integer |
                isInteger(c)
                [using tautology the-parts]
              @c-is-nonzero |
                rational.nonzero(c)
                [using tautology the-parts]
              @the-coefficient |
                qpoly.qcoeff(theSubject, i) = rational.mul(b, recip(c))
                [using tautology the-parts]
              // ℚ's fraction axiom hands over SOME nonzero c; the spec
              // wants a POSITIVE one. If c is negative, (neg(b), neg(c))
              // names the same number — `theFractionSurvivesASignFlip`.
              @the-sign-split |
                less_than(ZERO, c) or ZERO = c or
                  less_than(c, ZERO)
                [using specialize rational.lessThanTrichotomy(ZERO, c)]
              @conclusion-a-denominator-exists |
                exists v: Q; isADenominatorFor(i, v)
                case the-sign-split {
                  @when-not-negative |
                    assume less_than(ZERO, c) or ZERO = c {
                      @the-nonnegative-cases |
                        less_than(ZERO, c) or ZERO = c
                        [by hypothesis when-not-negative]
                      @conclusion-nonnegative |
                        exists v: Q; isADenominatorFor(i, v)
                        case the-nonnegative-cases {
                          // c > 0: it already serves
                          @when-positive |
                            assume less_than(ZERO, c) {
                              @c-is-positive |
                                less_than(ZERO, c)
                                [by hypothesis when-positive]
                              @the-numerator-works |
                                isInteger(b) and
                                  qpoly.qcoeff(theSubject, i) =
                                  rational.mul(b, recip(c))
                                [by both b-is-an-integer the-coefficient]
                              @a-numerator-exists |
                                exists b2: Q; isInteger(b2) and
                                  qpoly.qcoeff(theSubject, i) =
                                  rational.mul(b2, recip(c))
                                [by witness(b) the-numerator-works]
                              @the-spec-parts |
                                isInteger(c) and less_than(ZERO, c) and
                                  rational.nonzero(c) and
                                  (exists b2: Q; isInteger(b2) and
                                  qpoly.qcoeff(theSubject, i) =
                                  rational.mul(b2, recip(c)))
                                [using tautology c-is-an-integer c-is-positive c-is-nonzero a-numerator-exists]
                              @the-spec-meaning |
                                isADenominatorFor(i, c) iff
                                  (isInteger(c) and
                                  less_than(ZERO, c) and
                                  rational.nonzero(c) and
                                  (exists b2: Q; isInteger(b2) and
                                  qpoly.qcoeff(theSubject, i) =
                                  rational.mul(b2, recip(c))))
                                [using specialize denominatorMeaning(i, c)]
                              @c-is-a-denominator |
                                isADenominatorFor(i, c)
                                [using tautology the-spec-meaning the-spec-parts]
                              @conclusion-positive |
                                exists v: Q; isADenominatorFor(i, v)
                                [by witness(c) c-is-a-denominator]
                            }
                          // c = 0 contradicts the fraction axiom's own c != 0
                          @when-zero |
                            assume ZERO = c {
                              @zero-is-c |
                                ZERO = c
                                [by hypothesis when-zero]
                              @c-is-zero |
                                c = rational.ZERO
                                [by symmetry zero-is-c]
                              // `ex_falso` needs the literal negation, which the predicate
                              // does not supply syntactically.
                              @c-characterized-here |
                                rational.nonzero(c) iff (not (c = rational.ZERO))
                                [using specialize rational.nonzeroMeaning(c)]
                              @c-is-not-zero-here |
                                not (c = rational.ZERO)
                                [using tautology c-characterized-here c-is-nonzero]
                              @conclusion-zero |
                                exists v: Q; isADenominatorFor(i, v)
                                [by ex_falso c-is-zero c-is-not-zero-here]
                            }
                        }
                    }
                  // c < 0: flip both halves
                  @when-negative |
                    assume less_than(c, ZERO) {
                      @c-is-negative |
                        less_than(c, ZERO)
                        [by hypothesis when-negative]
                      @negatives-of-negatives |
                        forall x: Q; less_than(x, ZERO) ->
                          less_than(ZERO, rational.neg(x))
                        [using model(rational.RationalOrderedField) field_order.negOfNegativeIsPositive]
                      @minus-c-is-positive |
                        less_than(ZERO, rational.neg(c))
                        [using specialize negatives-of-negatives(c) c-is-negative]
                      @minus-c-is-nonzero |
                        rational.nonzero(rational.neg(c))
                        [using specialize rational_integer_order.aPositiveIsNonzeroPredicate(rational.neg(c)) minus-c-is-positive]
                      @the-integer-negations |
                        forall x: Q; isInteger(x) ->
                          isInteger(rational.neg(x))
                        [using import(rational) isIntegerNeg]
                      @minus-c-is-an-integer |
                        isInteger(rational.neg(c))
                        [using specialize the-integer-negations(c) c-is-an-integer]
                      @minus-b-is-an-integer |
                        isInteger(rational.neg(b))
                        [using specialize the-integer-negations(b) b-is-an-integer]
                      @the-negated-denominator-is-nonzero |
                        rational.nonzero(rational.neg(c))
                        [using specialize aNegationOfANonzeroIsNonzero(c) c-is-nonzero]
                      @the-flip |
                        rational.mul(rational.neg(b),
                          recip(rational.neg(c))) =
                          rational.mul(b, recip(c))
                        [using specialize theFractionSurvivesASignFlip(b, c) c-is-nonzero the-negated-denominator-is-nonzero]
                      @the-flipped-coefficient |
                        qpoly.qcoeff(theSubject, i) =
                          rational.mul(rational.neg(b),
                          recip(rational.neg(c)))
                        [by rewrite the-flip the-coefficient]
                      @the-flipped-numerator-works |
                        isInteger(rational.neg(b)) and
                          qpoly.qcoeff(theSubject, i) =
                          rational.mul(rational.neg(b),
                          recip(rational.neg(c)))
                        [by both minus-b-is-an-integer the-flipped-coefficient]
                      @a-flipped-numerator-exists |
                        exists b2: Q; isInteger(b2) and
                          qpoly.qcoeff(theSubject, i) =
                          rational.mul(b2, recip(rational.neg(c)))
                        [by witness(rational.neg(b)) the-flipped-numerator-works]
                      @the-flipped-spec-parts |
                        isInteger(rational.neg(c)) and
                          less_than(ZERO, rational.neg(c)) and
                          rational.nonzero(rational.neg(c)) and
                          (exists b2: Q; isInteger(b2) and
                          qpoly.qcoeff(theSubject, i) =
                          rational.mul(b2, recip(rational.neg(c))))
                        [using tautology minus-c-is-an-integer minus-c-is-positive minus-c-is-nonzero a-flipped-numerator-exists]
                      @the-flipped-spec-meaning |
                        isADenominatorFor(i, rational.neg(c)) iff
                          (isInteger(rational.neg(c)) and
                          less_than(ZERO, rational.neg(c)) and
                          rational.nonzero(rational.neg(c)) and
                          (exists b2: Q; isInteger(b2) and
                          qpoly.qcoeff(theSubject, i) =
                          rational.mul(b2, recip(rational.neg(c)))))
                        [using specialize denominatorMeaning(i, rational.neg(c))]
                      @minus-c-is-a-denominator |
                        isADenominatorFor(i, rational.neg(c))
                        [using tautology the-flipped-spec-meaning the-flipped-spec-parts]
                      @conclusion-negative |
                        exists v: Q; isADenominatorFor(i, v)
                        [by witness(rational.neg(c)) minus-c-is-a-denominator]
                    }
                }
            }
          @conclusion-inner |
            exists v: Q; isADenominatorFor(i, v)
            [by unpacked with-the-denominator]
        }
      @conclusion-at-i |
        exists v: Q; isADenominatorFor(i, v)
        [by unpacked with-the-ratio]
    }
  @conclusion |
    forall i: Nat; exists v: Q; isADenominatorFor(i, v)
    [by generalize generalize-i]
qed

theorem aDenominatorSequenceExists: forall n: Nat;
  exists t: QSeq; forall i: Nat;
  nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))
proof
  @the-witnesses |
    forall i: Nat; exists v: Q; isADenominatorFor(i, v)
    [by cite aDenominatorExistsForEveryIndex]
  @the-choice |
    (forall i: Nat; exists v: Q; isADenominatorFor(i, v)) ->
      forall n: Nat; exists t: QSeq; forall i: Nat;
      nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))
    [using instantiation anIndexPinnedChoiceIsRealized(isADenominatorFor)]
  @conclusion |
    forall n: Nat;
      exists t: QSeq; forall i: Nat;
      nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))
    [by modus_ponens the-choice the-witnesses]
qed

// (v·k)·(b·v⁻¹) = k·b for nonzero v: the denominator cancels against its own reciprocal.
// Pure field algebra; `polynomial(rational)` cannot do it because recip is not a ring op, so
// it goes through fieldInverse explicitly.
theorem theDenominatorCancels: forall v, k, b: Q;
  rational.nonzero(v) ->
  rational.mul(rational.mul(v, k), rational.mul(b, recip(v))) =
  rational.mul(k, b)
proof
  @generalize-v |
    fix v: Q {
      @generalize-k |
        fix k: Q {
          @generalize-b |
            fix b: Q {
              @given-v-nonzero |
                assume rational.nonzero(v) {
                  @v-nonzero |
                    rational.nonzero(v)
                    [by hypothesis given-v-nonzero]
                  @v-times-its-reciprocal |
                    rational.mul(v, recip(v)) = rational.ONE
                    [using specialize rational.fieldInverse(v) v-nonzero]
                  // regroup to (v · v⁻¹) · (k · b) and collapse
                  @the-regrouping |
                    rational.mul(rational.mul(v, k), rational.mul(b, recip(v))) =
                      rational.mul(rational.mul(v, recip(v)), rational.mul(k, b))
                    [using assoc_commut(rational.mulIsAssociative, rational.mulIsCommutative, rational.mulLeftSwap)]
                  @with-one-in-front |
                    rational.mul(rational.mul(v, k), rational.mul(b, recip(v))) =
                      rational.mul(rational.ONE, rational.mul(k, b))
                    [by rewrite v-times-its-reciprocal the-regrouping]
                  @one-times |
                    rational.mul(rational.ONE, rational.mul(k, b)) =
                      rational.mul(k, b)
                    [using specialize rational.mulOneLeft(rational.mul(k, b))]
                  @conclusion-cancels |
                    rational.mul(rational.mul(v, k), rational.mul(b, recip(v))) =
                      rational.mul(k, b)
                    [using simplify with-one-in-front one-times]
                }
              @nonzero-implies |
                rational.nonzero(v) ->
                  rational.mul(rational.mul(v, k), rational.mul(b, recip(v))) =
                  rational.mul(k, b)
                [by discharge given-v-nonzero]
            }
          @discharge-b |
            forall b9: Q;
              rational.nonzero(v) ->
              rational.mul(rational.mul(v, k), rational.mul(b9, recip(v))) =
              rational.mul(k, b9)
            [by generalize generalize-b]
        }
      @discharge-k |
        forall k9: Q; forall b9: Q;
          rational.nonzero(v) ->
          rational.mul(rational.mul(v, k9), rational.mul(b9, recip(v))) =
          rational.mul(k9, b9)
        [by generalize generalize-k]
    }
  @conclusion |
    forall v, k, b: Q;
      rational.nonzero(v) ->
      rational.mul(rational.mul(v, k), rational.mul(b, recip(v))) =
      rational.mul(k, b)
    [by generalize generalize-v]
qed

// -- LEMMA 17.12, STEP 2: THE COMMON DENOMINATOR CLEARS EVERY COEFFICIENT -----------------
// "We can rewrite p(x) as p(x) = 1/(c_0 ⋯ c_n) (d_0 + d_1 x + … + d_n x^n), where d_0, …, d_n
// are integers."
//
// The point is per-coefficient: C·(b_i/c_i) is an integer, because c_i divides C
// (`everyEntryDividesTheProduct`) and b_i is an integer. That is what makes every d_i an
// integer, and it is the whole content of the step — the polynomial-level restatement is
// bookkeeping on top.

// Scaling a coefficient by a multiple of its own denominator lands on the cut.
theorem theCommonDenominatorClearsACoefficient: forall i: Nat; forall v, whole: Q;
  isADenominatorFor(i, v) -> dividesIntegrally(v, whole) ->
  isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))
proof
  @generalize-i |
    fix i: Nat {
      @generalize-v |
        fix v: Q {
          @generalize-whole |
            fix whole: Q {
              @given-v-is-a-denominator |
                assume isADenominatorFor(i, v) {
                  @v-is-a-denominator |
                    isADenominatorFor(i, v)
                    [by hypothesis given-v-is-a-denominator]
                  @the-spec |
                    isADenominatorFor(i, v) iff
                      (isInteger(v) and less_than(ZERO, v) and
                      rational.nonzero(v) and
                      (exists b: Q; isInteger(b) and
                      qpoly.qcoeff(theSubject, i) = rational.mul(b, recip(v))))
                    [using specialize denominatorMeaning(i, v)]
                  @the-parts |
                    isInteger(v) and less_than(ZERO, v) and
                      rational.nonzero(v) and
                      (exists b: Q; isInteger(b) and
                      qpoly.qcoeff(theSubject, i) = rational.mul(b, recip(v)))
                    [using tautology the-spec v-is-a-denominator]
                  @v-is-nonzero |
                    rational.nonzero(v)
                    [using tautology the-parts]
                  @a-numerator-exists |
                    exists b: Q; isInteger(b) and
                      qpoly.qcoeff(theSubject, i) = rational.mul(b, recip(v))
                    [using tautology the-parts]
                  @given-v-divides-whole |
                    assume dividesIntegrally(v, whole) {
                      @v-divides-whole |
                        dividesIntegrally(v, whole)
                        [by hypothesis given-v-divides-whole]
                      @the-divides-meaning |
                        dividesIntegrally(v, whole) iff
                          (exists k: Q; isInteger(k) and
                          whole = rational.mul(v, k))
                        [using specialize dividesIntegrallyMeaning(v, whole)]
                      @a-quotient-exists |
                        exists k: Q; isInteger(k) and whole = rational.mul(v, k)
                        [using tautology the-divides-meaning v-divides-whole]
                      @with-the-numerator |
                        unpack b: Q from a-numerator-exists {
                          @with-numerator-b |
                            isInteger(b) and
                              qpoly.qcoeff(theSubject, i) = rational.mul(b, recip(v))
                            [by hypothesis with-the-numerator]
                          @b-is-an-integer |
                            isInteger(b)
                            [by and_lhs with-numerator-b]
                          @the-coefficient |
                            qpoly.qcoeff(theSubject, i) = rational.mul(b, recip(v))
                            [by and_rhs with-numerator-b]
                          @with-the-quotient |
                            unpack k: Q from a-quotient-exists {
                              @with-quotient-k |
                                isInteger(k) and whole = rational.mul(v, k)
                                [by hypothesis with-the-quotient]
                              @k-is-an-integer |
                                isInteger(k)
                                [by and_lhs with-quotient-k]
                              @whole-is-v-times-k |
                                whole = rational.mul(v, k)
                                [by and_rhs with-quotient-k]
                              // whole · coeff = (v·k) · (b·v⁻¹) = k·b, an integer
                              @the-product |
                                rational.mul(whole, qpoly.qcoeff(theSubject, i)) =
                                  rational.mul(rational.mul(v, k),
                                  rational.mul(b, recip(v)))
                                [using simplify whole-is-v-times-k the-coefficient]
                              @the-cancellation |
                                rational.mul(rational.mul(v, k),
                                  rational.mul(b, recip(v))) =
                                  rational.mul(k, b)
                                [using specialize theDenominatorCancels(v, k, b) v-is-nonzero]
                              @the-product-is-k-times-b |
                                rational.mul(whole, qpoly.qcoeff(theSubject, i)) =
                                  rational.mul(k, b)
                                [using simplify the-product the-cancellation]
                              @k-times-b-is-an-integer |
                                isInteger(rational.mul(k, b))
                                [using specialize rational.isIntegerMul(k, b) k-is-an-integer b-is-an-integer]
                              @conclusion-the-scaled-coefficient |
                                isInteger(rational.mul(whole,
                                  qpoly.qcoeff(theSubject, i)))
                                [by rewrite the-product-is-k-times-b k-times-b-is-an-integer]
                            }
                          @conclusion-quotient-exported |
                            isInteger(rational.mul(whole,
                              qpoly.qcoeff(theSubject, i)))
                            [by unpacked with-the-quotient]
                        }
                      @conclusion-numerator-exported |
                        isInteger(rational.mul(whole,
                          qpoly.qcoeff(theSubject, i)))
                        [by unpacked with-the-numerator]
                    }
                  @divides-implies-integral |
                    dividesIntegrally(v, whole) ->
                      isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))
                    [by discharge given-v-divides-whole]
                }
              @denominator-implies |
                isADenominatorFor(i, v) -> dividesIntegrally(v, whole) ->
                  isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))
                [by discharge given-v-is-a-denominator]
            }
          @discharge-whole |
            forall w9: Q;
              isADenominatorFor(i, v) -> dividesIntegrally(v, w9) ->
              isInteger(rational.mul(w9, qpoly.qcoeff(theSubject, i)))
            [by generalize generalize-whole]
        }
      @discharge-v |
        forall v9: Q; forall w9: Q;
          isADenominatorFor(i, v9) -> dividesIntegrally(v9, w9) ->
          isInteger(rational.mul(w9, qpoly.qcoeff(theSubject, i)))
        [by generalize generalize-v]
    }
  @conclusion |
    forall i: Nat; forall v, whole: Q;
      isADenominatorFor(i, v) -> dividesIntegrally(v, whole) ->
      isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))
    [by generalize generalize-i]
qed

// -- LEMMA 17.12, STEP 3: DIVIDING OUT A COMMON FACTOR ------------------------------------
// "Let d be the greatest common divisor of d_0, …, d_n. Then p(x) = d/(c_0 ⋯ c_n)(a_0 + … +
// a_n x^n), where d_i = d a_i and the a_i's are relatively prime."
//
// The gcd VALUE is not what 17.12's statement needs. `coefficientsAreRelativelyPrimeUpTo` is
// a quantification over common divisors — "every integer dividing all of them divides ONE" —
// so what must be produced is a divisor `d` of every entry such that the quotients have no
// common factor beyond a unit. That is a weaker, purely relational obligation, and it is
// stated and proved here on the cut, exactly as `std/rational/polynomial.b4m` states
// divisibility and coprimality on the cut rather than transferring ℤ's.
//
// (Transferring ℤ's `lattice.gcdExists` was tried and does NOT work: its proof routes through
// wellordering into `peano.zeroOrSucc`, whose own proof is a model transfer, so the chain
// ℕ → ℤ's NonNeg → ℚ's isInteger hits the nested-composition limit —
// `std/peano.b4m:857: expected sort 'Int', got 'Q'`. Same wall as `dividesOneImpliesUnit`,
// same answer: prove it on the cut.)

// `isACommonDivisorUpTo(d, s, n)` — d divides every entry below n.
pred isACommonDivisorUpTo(d: Q, s: QSeq, n: Nat)
axiom commonDivisorMeaning: forall d: Q; forall s: QSeq; forall n: Nat;
  isACommonDivisorUpTo(d, s, n) iff
  (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(d, qat(s, i)))

// ONE is a common divisor of anything: every integer is ONE times itself.
theorem oneIsACommonDivisor: forall s: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
  isACommonDivisorUpTo(ONE, s, n)
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-n |
        fix n: Nat {
          @given-the-entries-are-integers |
            assume forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i)) {
              @the-entries-are-integers |
                forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))
                [by hypothesis given-the-entries-are-integers]
              @one-divides-each |
                fix i: Nat {
                  @given-i-below-n |
                    assume nat_less_than(i, n) {
                      @i-below-n |
                        nat_less_than(i, n)
                        [by hypothesis given-i-below-n]
                      @the-entry-is-an-integer |
                        isInteger(qat(s, i))
                        [using specialize the-entries-are-integers(i) i-below-n]
                      // the witness quotient is the entry itself: entry = 1 · entry
                      @one-times-the-entry |
                        rational.mul(ONE, qat(s, i)) = qat(s, i)
                        [using specialize rational.mulOneLeft(qat(s, i))]
                      @the-entry-is-one-times-itself |
                        qat(s, i) = rational.mul(ONE, qat(s, i))
                        [by symmetry one-times-the-entry]
                      @the-witness-works |
                        isInteger(qat(s, i)) and
                          qat(s, i) = rational.mul(ONE, qat(s, i))
                        [by both the-entry-is-an-integer the-entry-is-one-times-itself]
                      @a-quotient-exists |
                        exists k: Q; isInteger(k) and
                          qat(s, i) = rational.mul(ONE, k)
                        [by witness(qat(s, i)) the-witness-works]
                      @the-divides-meaning |
                        dividesIntegrally(ONE, qat(s, i)) iff
                          (exists k: Q; isInteger(k) and
                          qat(s, i) = rational.mul(ONE, k))
                        [using specialize dividesIntegrallyMeaning(ONE, qat(s, i))]
                      @conclusion-one-divides |
                        dividesIntegrally(ONE, qat(s, i))
                        [using tautology the-divides-meaning a-quotient-exists]
                    }
                  @below-n-implies |
                    nat_less_than(i, n) -> dividesIntegrally(ONE, qat(s, i))
                    [by discharge given-i-below-n]
                }
              @all-divided |
                forall i: Nat;
                  nat_less_than(i, n) -> dividesIntegrally(ONE, qat(s, i))
                [by generalize one-divides-each]
              @the-common-divisor-meaning |
                isACommonDivisorUpTo(ONE, s, n) iff
                  (forall i: Nat;
                  nat_less_than(i, n) -> dividesIntegrally(ONE, qat(s, i)))
                [using specialize commonDivisorMeaning(ONE, s, n)]
              @conclusion-one-is-common |
                isACommonDivisorUpTo(ONE, s, n)
                [using tautology the-common-divisor-meaning all-divided]
            }
          @integers-imply-one-is-common |
            (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
              isACommonDivisorUpTo(ONE, s, n)
            [by discharge given-the-entries-are-integers]
        }
      @discharge-n |
        forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) -> isInteger(qat(s, i))) ->
          isACommonDivisorUpTo(ONE, s, n9)
        [by generalize generalize-n]
    }
  @conclusion |
    forall s: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
      isACommonDivisorUpTo(ONE, s, n)
    [by generalize generalize-s]
qed

// -- WHAT STEP 3 MUST PRODUCE -------------------------------------------------------------
// A common divisor `d` of the entries whose quotient sequence is RELATIVELY PRIME: every
// integer dividing all the quotients divides ONE. For `d` the greatest common divisor this is
// Judson's "the a_i's are relatively prime"; stated relationally it is the obligation itself,
// with no gcd value and no fold.
pred isAMaximalCommonDivisorUpTo(d: Q, s: QSeq, n: Nat)
axiom maximalCommonDivisorMeaning: forall d: Q; forall s: QSeq; forall n: Nat;
  isAMaximalCommonDivisorUpTo(d, s, n) iff
  (isInteger(d) and less_than(ZERO, d) and
  rational.nonzero(d) and
  isACommonDivisorUpTo(d, s, n) and
  (forall e: Q; isInteger(e) -> isACommonDivisorUpTo(e, s, n) ->
  dividesIntegrally(e, d)))

// Cancellation at ℚ: a nonzero factor cancels. From `fieldInverse` directly — ℚ has no
// cancellation lemma of its own, and `std/field/units.b4m`'s is over the Nonzero subsort.
theorem aNonzeroFactorCancels: forall a, b, c: Q;
  rational.nonzero(a) -> rational.mul(a, b) = rational.mul(a, c) -> b = c
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @generalize-c |
            fix c: Q {
              @given-a-nonzero |
                assume rational.nonzero(a) {
                  @a-nonzero |
                    rational.nonzero(a)
                    [by hypothesis given-a-nonzero]
                  @given-the-products-agree |
                    assume rational.mul(a, b) = rational.mul(a, c) {
                      @the-products-agree |
                        rational.mul(a, b) = rational.mul(a, c)
                        [by hypothesis given-the-products-agree]
                      @the-inverse |
                        rational.mul(a, recip(a)) = ONE
                        [using specialize rational.fieldInverse(a) a-nonzero]
                      @the-inverse-commutes |
                        rational.mul(recip(a), a) = rational.mul(a, recip(a))
                        [using specialize rational.mulIsCommutative(recip(a), a)]
                      @the-reciprocal |
                        rational.mul(recip(a), a) = ONE
                        [using simplify the-inverse-commutes the-inverse]
                      // b = 1·b = (a⁻¹a)b = a⁻¹(ab) = a⁻¹(ac) = (a⁻¹a)c = 1·c = c
                      @scaling-b-flipped |
                        rational.mul(rational.mul(recip(a), a), b) =
                          rational.mul(recip(a), rational.mul(a, b))
                        [using specialize rational.mulIsAssociative(recip(a), a, b)]
                      @scaling-c |
                        rational.mul(rational.mul(recip(a), a), c) =
                          rational.mul(recip(a), rational.mul(a, c))
                        [using specialize rational.mulIsAssociative(recip(a), a, c)]
                      @scaled-products-agree |
                        rational.mul(recip(a), rational.mul(a, b)) =
                          rational.mul(recip(a), rational.mul(a, c))
                        [using simplify the-products-agree]
                      // (a⁻¹a)b = a⁻¹(ab) = a⁻¹(ac) = (a⁻¹a)c
                      @through-the-middle |
                        rational.mul(rational.mul(recip(a), a), b) =
                          rational.mul(recip(a), rational.mul(a, c))
                        [by rewrite scaled-products-agree scaling-b-flipped]
                      @scaling-c-flipped |
                        rational.mul(recip(a), rational.mul(a, c)) =
                          rational.mul(rational.mul(recip(a), a), c)
                        [by symmetry scaling-c]
                      @regrouped-agree |
                        rational.mul(rational.mul(recip(a), a), b) =
                          rational.mul(rational.mul(recip(a), a), c)
                        [by rewrite scaling-c-flipped through-the-middle]
                      @one-times-agree |
                        rational.mul(ONE, b) = rational.mul(ONE, c)
                        [by rewrite the-reciprocal regrouped-agree]
                      @one-times-b |
                        rational.mul(ONE, b) = b
                        [using specialize rational.mulOneLeft(b)]
                      @one-times-c |
                        rational.mul(ONE, c) = c
                        [using specialize rational.mulOneLeft(c)]
                      @b-is-one-times-c |
                        b = rational.mul(ONE, c)
                        [by rewrite one-times-b one-times-agree]
                      @conclusion-they-agree |
                        b = c
                        [by rewrite one-times-c b-is-one-times-c]
                    }
                  @products-agree-implies |
                    rational.mul(a, b) = rational.mul(a, c) -> b = c
                    [by discharge given-the-products-agree]
                }
              @nonzero-implies |
                rational.nonzero(a) ->
                  rational.mul(a, b) = rational.mul(a, c) -> b = c
                [by discharge given-a-nonzero]
            }
          @discharge-c |
            forall c9: Q;
              rational.nonzero(a) ->
              rational.mul(a, b) = rational.mul(a, c9) -> b = c9
            [by generalize generalize-c]
        }
      @discharge-b |
        forall b9: Q; forall c9: Q;
          rational.nonzero(a) ->
          rational.mul(a, b9) = rational.mul(a, c9) -> b9 = c9
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, c: Q;
      rational.nonzero(a) ->
      rational.mul(a, b) = rational.mul(a, c) -> b = c
    [by generalize generalize-a]
qed

// Negating numerator and denominator together leaves a fraction alone. This is what lets the
// denominator spec insist on a POSITIVE denominator: ℚ's fraction axiom hands over some
// nonzero c, and if c is negative, (neg(b), neg(c)) names the same number.
//
// Both belong in `std/rational.b4m` beside the other `recip` algebra; they are here because
// the proof needs `aNonzeroFactorCancels`, which `std/rational.b4m` does not have.
// A nonzero's negation is nonzero: c = neg(neg(c)) = neg(ZERO) = ZERO otherwise. Needed as a
// separate theorem because `recip(neg(c))` owes `nonzero(neg(c))` as a GUARD, and a caller
// holding only `nonzero(c)` cannot supply it syntactically.
theorem aNegationOfANonzeroIsNonzero: forall c: Q;
  rational.nonzero(c) -> rational.nonzero(rational.neg(c))
proof
  @generalize-c |
    fix c: Q {
      @given-c-nonzero |
        assume rational.nonzero(c) {
          @c-nonzero |
            rational.nonzero(c)
            [by hypothesis given-c-nonzero]
          @c-characterized |
            rational.nonzero(c) iff (not (c = ZERO))
            [using specialize rational.nonzeroMeaning(c)]
          @c-is-not-zero |
            not (c = ZERO)
            [using tautology c-characterized c-nonzero]
          @given-neg-c-is-zero |
            assume rational.neg(c) = ZERO {
              @neg-c-is-zero |
                rational.neg(c) = ZERO
                [by hypothesis given-neg-c-is-zero]
              @the-double-negation |
                rational.neg(rational.neg(c)) = c
                [using specialize rational.negNeg(c)]
              @c-is-neg-neg-c |
                c = rational.neg(rational.neg(c))
                [by symmetry the-double-negation]
              @c-is-neg-zero |
                c = rational.neg(ZERO)
                [by rewrite neg-c-is-zero c-is-neg-neg-c]
              @neg-zero-is-zero |
                rational.neg(ZERO) = ZERO
                [using import(rational) negZero]
              @c-is-zero |
                c = ZERO
                [using simplify c-is-neg-zero neg-zero-is-zero]
            }
          @neg-c-is-not-zero |
            not (rational.neg(c) = ZERO)
            [by contradiction given-neg-c-is-zero c-is-zero c-is-not-zero]
          @neg-c-characterized |
            rational.nonzero(rational.neg(c)) iff (not (rational.neg(c) = ZERO))
            [using specialize rational.nonzeroMeaning(rational.neg(c))]
          @conclusion-neg-c-is-nonzero |
            rational.nonzero(rational.neg(c))
            [using tautology neg-c-characterized neg-c-is-not-zero]
        }
      @nonzero-implies-neg-nonzero |
        rational.nonzero(c) -> rational.nonzero(rational.neg(c))
        [by discharge given-c-nonzero]
    }
  @conclusion |
    forall c: Q; rational.nonzero(c) -> rational.nonzero(rational.neg(c))
    [by generalize generalize-c]
qed

// BOTH nonzero facts are antecedents: the conclusion writes `recip(neg(c))` and `recip(c)`,
// so it owes a guard on each term, and `nonzero(c)` does not syntactically supply
// `nonzero(neg(c))` even though it implies it (the proof derives that implication inside).
theorem theReciprocalOfANegation: forall c: Q;
  rational.nonzero(c) -> rational.nonzero(rational.neg(c)) ->
  rational.recip(rational.neg(c)) = rational.neg(rational.recip(c))
proof
  @generalize-c |
    fix c: Q {
      @given-c-nonzero |
        assume rational.nonzero(c) {
          @given-neg-c-nonzero |
            assume rational.nonzero(rational.neg(c)) {
              @c-nonzero |
                rational.nonzero(c)
                [by hypothesis given-c-nonzero]
              @c-inverts |
                rational.mul(c, rational.recip(c)) = rational.ONE
                [using specialize rational.fieldInverse(c) c-nonzero]
              // neg(c) is nonzero too: otherwise c = neg(neg(c)) = neg(ZERO) = ZERO
              @given-neg-c-is-zero |
                assume rational.neg(c) = ZERO {
                  @neg-c-is-zero |
                    rational.neg(c) = ZERO
                    [by hypothesis given-neg-c-is-zero]
                  @the-double-negation |
                    rational.neg(rational.neg(c)) = c
                    [using specialize rational.negNeg(c)]
                  @c-is-the-double-negation |
                    c = rational.neg(rational.neg(c))
                    [by symmetry the-double-negation]
                  @c-is-neg-zero |
                    c = rational.neg(ZERO)
                    [by rewrite neg-c-is-zero c-is-the-double-negation]
                  @neg-zero-is-zero |
                    rational.neg(ZERO) = ZERO
                    [using import(rational) negZero]
                  @c-is-zero |
                    c = ZERO
                    [using simplify c-is-neg-zero neg-zero-is-zero]
                }
              // `contradiction` needs the DISEQUATION form of the hypothesis, which is now the
              // predicate — the characterization moves between them.
              @c-characterized |
                rational.nonzero(c) iff (not (c = ZERO))
                [using specialize rational.nonzeroMeaning(c)]
              @c-is-not-zero |
                not (c = ZERO)
                [using tautology c-characterized c-nonzero]
              @neg-c-nonzero |
                not (rational.neg(c) = ZERO)
                [by contradiction given-neg-c-is-zero c-is-zero c-is-not-zero]
              // as the PREDICATE `recip` is guarded by — a `contradiction` yields the
              // disequation, and the guard is matched syntactically.
              @neg-c-characterized |
                rational.nonzero(rational.neg(c)) iff (not (rational.neg(c) = ZERO))
                [using specialize rational.nonzeroMeaning(rational.neg(c))]
              @neg-c-is-nonzero |
                rational.nonzero(rational.neg(c))
                [using tautology neg-c-characterized neg-c-nonzero]
              @neg-c-inverts |
                rational.mul(rational.neg(c),
                  rational.recip(rational.neg(c))) = rational.ONE
                [using specialize rational.fieldInverse(rational.neg(c)) neg-c-is-nonzero]
              // the two negations cancel, so neg(recip(c)) is also an inverse
              @the-two-negations-cancel |
                rational.mul(rational.neg(c),
                  rational.neg(rational.recip(c))) =
                  rational.mul(c, rational.recip(c))
                [using polynomial(rational)]
              @the-negation-inverts |
                rational.mul(rational.neg(c),
                  rational.neg(rational.recip(c))) = rational.ONE
                [using simplify the-two-negations-cancel c-inverts]
              @the-two-agree |
                rational.mul(rational.neg(c),
                  rational.recip(rational.neg(c))) =
                  rational.mul(rational.neg(c),
                  rational.neg(rational.recip(c)))
                [using simplify neg-c-inverts the-negation-inverts]
              @conclusion-the-reciprocal |
                rational.recip(rational.neg(c)) =
                  rational.neg(rational.recip(c))
                [using specialize aNonzeroFactorCancels(rational.neg(c), rational.recip(rational.neg(c)), rational.neg(rational.recip(c))) neg-c-is-nonzero the-two-agree]
            }
          @neg-nonzero-implies |
            rational.nonzero(rational.neg(c)) ->
              rational.recip(rational.neg(c)) =
              rational.neg(rational.recip(c))
            [by discharge given-neg-c-nonzero]
        }
      @nonzero-implies |
        rational.nonzero(c) -> rational.nonzero(rational.neg(c)) ->
          rational.recip(rational.neg(c)) =
          rational.neg(rational.recip(c))
        [by discharge given-c-nonzero]
    }
  @conclusion |
    forall c: Q;
      rational.nonzero(c) -> rational.nonzero(rational.neg(c)) ->
      rational.recip(rational.neg(c)) = rational.neg(rational.recip(c))
    [by generalize generalize-c]
qed

// The fraction itself is unchanged when both halves flip sign.
// Both guards lead: the conclusion writes `recip(neg(c))` and `recip(c)`, so it owes one on
// each — `aNegationOfANonzeroIsNonzero` is how a caller supplies the second.
theorem theFractionSurvivesASignFlip: forall b, c: Q;
  rational.nonzero(c) -> rational.nonzero(rational.neg(c)) ->
  rational.mul(rational.neg(b), rational.recip(rational.neg(c))) =
  rational.mul(b, rational.recip(c))
proof
  @generalize-b |
    fix b: Q {
      @generalize-c |
        fix c: Q {
          @given-c-nonzero |
            assume rational.nonzero(c) {
              @given-neg-c-nonzero |
                assume rational.nonzero(rational.neg(c)) {
                  @c-nonzero |
                    rational.nonzero(c)
                    [by hypothesis given-c-nonzero]
                  @neg-c-is-nonzero |
                    rational.nonzero(rational.neg(c))
                    [by hypothesis given-neg-c-nonzero]
                  @the-reciprocal-flips |
                    rational.recip(rational.neg(c)) =
                      rational.neg(rational.recip(c))
                    [using specialize theReciprocalOfANegation(c) c-nonzero neg-c-is-nonzero]
                  @the-negations-cancel |
                    rational.mul(rational.neg(b),
                      rational.neg(rational.recip(c))) =
                      rational.mul(b, rational.recip(c))
                    [using polynomial(rational)]
                  @conclusion-unchanged |
                    rational.mul(rational.neg(b),
                      rational.recip(rational.neg(c))) =
                      rational.mul(b, rational.recip(c))
                    [by rewrite the-reciprocal-flips the-negations-cancel]
                }
              @neg-nonzero-implies |
                rational.nonzero(rational.neg(c)) ->
                  rational.mul(rational.neg(b),
                  rational.recip(rational.neg(c))) =
                  rational.mul(b, rational.recip(c))
                [by discharge given-neg-c-nonzero]
            }
          @nonzero-implies |
            rational.nonzero(c) -> rational.nonzero(rational.neg(c)) ->
              rational.mul(rational.neg(b),
              rational.recip(rational.neg(c))) =
              rational.mul(b, rational.recip(c))
            [by discharge given-c-nonzero]
        }
      @discharge-c |
        forall c9: Q;
          rational.nonzero(c9) -> rational.nonzero(rational.neg(c9)) ->
          rational.mul(rational.neg(b),
          rational.recip(rational.neg(c9))) =
          rational.mul(b, rational.recip(c9))
        [by generalize generalize-c]
    }
  @conclusion |
    forall b, c: Q;
      rational.nonzero(c) -> rational.nonzero(rational.neg(c)) ->
      rational.mul(rational.neg(b), rational.recip(rational.neg(c))) =
      rational.mul(b, rational.recip(c))
    [by generalize generalize-b]
qed

// If e divides every quotient and each entry is d·quotient, then d·e divides every entry:
// quotient = e·m gives entry = d·(e·m) = (d·e)·m.
theorem theScaledDivisorDividesTheScaledEntries:
  forall d, e: Q; forall s, q: QSeq; forall n: Nat;
  isACommonDivisorUpTo(e, q, n) ->
  (forall i: Nat; nat_less_than(i, n) -> qat(s, i) = rational.mul(d, qat(q, i))) ->
  isACommonDivisorUpTo(rational.mul(d, e), s, n)
proof
  @generalize-d |
    fix d: Q {
      @generalize-e |
        fix e: Q {
          @generalize-s |
            fix s: QSeq {
              @generalize-q |
                fix q: QSeq {
                  @generalize-n |
                    fix n: Nat {
                      @given-e-divides-the-quotients |
                        assume isACommonDivisorUpTo(e, q, n) {
                          @e-divides-the-quotients |
                            isACommonDivisorUpTo(e, q, n)
                            [by hypothesis given-e-divides-the-quotients]
                          @the-quotient-divisor-meaning |
                            isACommonDivisorUpTo(e, q, n) iff
                              (forall i: Nat; nat_less_than(i, n) ->
                              dividesIntegrally(e, qat(q, i)))
                            [using specialize commonDivisorMeaning(e, q, n)]
                          @e-divides-each-quotient |
                            forall i: Nat; nat_less_than(i, n) ->
                              dividesIntegrally(e, qat(q, i))
                            [using tautology the-quotient-divisor-meaning e-divides-the-quotients]
                          @given-the-factorization |
                            assume forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i)) {
                              @the-factorization |
                                forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(d, qat(q, i))
                                [by hypothesis given-the-factorization]
                              @each-entry-divided |
                                fix i: Nat {
                                  @given-i-below-n |
                                    assume nat_less_than(i, n) {
                                      @i-below-n |
                                        nat_less_than(i, n)
                                        [by hypothesis given-i-below-n]
                                      @e-divides-this-quotient |
                                        dividesIntegrally(e, qat(q, i))
                                        [using specialize e-divides-each-quotient(i) i-below-n]
                                      @this-entry |
                                        qat(s, i) = rational.mul(d, qat(q, i))
                                        [using specialize the-factorization(i) i-below-n]
                                      @the-quotient-meaning |
                                        dividesIntegrally(e, qat(q, i)) iff
                                          (exists k: Q; isInteger(k) and
                                          qat(q, i) = rational.mul(e, k))
                                        [using specialize dividesIntegrallyMeaning(e, qat(q, i))]
                                      @a-quotient-exists |
                                        exists k: Q; isInteger(k) and
                                          qat(q, i) = rational.mul(e, k)
                                        [using tautology the-quotient-meaning e-divides-this-quotient]
                                      @with-the-quotient |
                                        unpack m: Q from a-quotient-exists {
                                          @with-quotient-m |
                                            isInteger(m) and
                                              qat(q, i) = rational.mul(e, m)
                                            [by hypothesis with-the-quotient]
                                          @m-is-an-integer |
                                            isInteger(m)
                                            [by and_lhs with-quotient-m]
                                          @the-quotient-is-e-times-m |
                                            qat(q, i) = rational.mul(e, m)
                                            [by and_rhs with-quotient-m]
                                          // entry = d·(e·m) = (d·e)·m
                                          @the-entry-expanded |
                                            qat(s, i) =
                                              rational.mul(d, rational.mul(e, m))
                                            [by rewrite the-quotient-is-e-times-m this-entry]
                                          @reassociate |
                                            rational.mul(rational.mul(d, e), m) =
                                              rational.mul(d, rational.mul(e, m))
                                            [using specialize rational.mulIsAssociative(d, e, m)]
                                          @the-entry-regrouped |
                                            qat(s, i) =
                                              rational.mul(rational.mul(d, e), m)
                                            [by rewrite reassociate the-entry-expanded]
                                          @the-witness-works |
                                            isInteger(m) and
                                              qat(s, i) =
                                              rational.mul(rational.mul(d, e), m)
                                            [by both m-is-an-integer the-entry-regrouped]
                                          @the-scaled-quotient-exists |
                                            exists k: Q; isInteger(k) and
                                              qat(s, i) =
                                              rational.mul(rational.mul(d, e), k)
                                            [by witness(m) the-witness-works]
                                          @the-scaled-meaning |
                                            dividesIntegrally(rational.mul(d, e),
                                              qat(s, i)) iff
                                              (exists k: Q; isInteger(k) and
                                              qat(s, i) =
                                              rational.mul(rational.mul(d, e), k))
                                            [using specialize dividesIntegrallyMeaning(rational.mul(d, e), qat(s, i))]
                                          @conclusion-divides-this-entry |
                                            dividesIntegrally(rational.mul(d, e),
                                              qat(s, i))
                                            [using tautology the-scaled-meaning the-scaled-quotient-exists]
                                        }
                                      @conclusion-this-entry-divided |
                                        dividesIntegrally(rational.mul(d, e),
                                          qat(s, i))
                                        [by unpacked with-the-quotient]
                                    }
                                  @below-n-implies |
                                    nat_less_than(i, n) ->
                                      dividesIntegrally(rational.mul(d, e), qat(s, i))
                                    [by discharge given-i-below-n]
                                }
                              @all-entries-divided |
                                forall i: Nat; nat_less_than(i, n) ->
                                  dividesIntegrally(rational.mul(d, e), qat(s, i))
                                [by generalize each-entry-divided]
                              @the-entry-divisor-meaning |
                                isACommonDivisorUpTo(rational.mul(d, e), s, n) iff
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  dividesIntegrally(rational.mul(d, e),
                                  qat(s, i)))
                                [using specialize commonDivisorMeaning(rational.mul(d, e), s, n)]
                              @conclusion-scaled-divides |
                                isACommonDivisorUpTo(rational.mul(d, e), s, n)
                                [using tautology the-entry-divisor-meaning all-entries-divided]
                            }
                          @factorization-implies |
                            (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) ->
                              isACommonDivisorUpTo(rational.mul(d, e), s, n)
                            [by discharge given-the-factorization]
                        }
                      @quotient-divisor-implies |
                        isACommonDivisorUpTo(e, q, n) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) ->
                          isACommonDivisorUpTo(rational.mul(d, e), s, n)
                        [by discharge given-e-divides-the-quotients]
                    }
                  @discharge-n |
                    forall n9: Nat;
                      isACommonDivisorUpTo(e, q, n9) ->
                      (forall i: Nat; nat_less_than(i, n9) ->
                      qat(s, i) = rational.mul(d, qat(q, i))) ->
                      isACommonDivisorUpTo(rational.mul(d, e), s, n9)
                    [by generalize generalize-n]
                }
              @discharge-q |
                forall q9: QSeq; forall n9: Nat;
                  isACommonDivisorUpTo(e, q9, n9) ->
                  (forall i: Nat; nat_less_than(i, n9) ->
                  qat(s, i) = rational.mul(d, qat(q9, i))) ->
                  isACommonDivisorUpTo(rational.mul(d, e), s, n9)
                [by generalize generalize-q]
            }
          @discharge-s |
            forall s9: QSeq; forall q9: QSeq; forall n9: Nat;
              isACommonDivisorUpTo(e, q9, n9) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(s9, i) = rational.mul(d, qat(q9, i))) ->
              isACommonDivisorUpTo(rational.mul(d, e), s9, n9)
            [by generalize generalize-s]
        }
      @discharge-e |
        forall e9: Q; forall s9: QSeq; forall q9: QSeq; forall n9: Nat;
          isACommonDivisorUpTo(e9, q9, n9) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(s9, i) = rational.mul(d, qat(q9, i))) ->
          isACommonDivisorUpTo(rational.mul(d, e9), s9, n9)
        [by generalize generalize-e]
    }
  @conclusion |
    forall d, e: Q; forall s, q: QSeq; forall n: Nat;
      isACommonDivisorUpTo(e, q, n) ->
      (forall i: Nat; nat_less_than(i, n) ->
      qat(s, i) = rational.mul(d, qat(q, i))) ->
      isACommonDivisorUpTo(rational.mul(d, e), s, n)
    [by generalize generalize-d]
qed

// d·e | d with d nonzero forces e | ONE: write d = (d·e)·m, regroup to d·(e·m), cancel d.
theorem cancellingTheDivisorLeavesAUnit: forall d, e: Q;
  rational.nonzero(d) ->
  dividesIntegrally(rational.mul(d, e), d) ->
  dividesIntegrally(e, ONE)
proof
  @generalize-d |
    fix d: Q {
      @generalize-e |
        fix e: Q {
          @given-d-nonzero |
            assume rational.nonzero(d) {
              @d-nonzero |
                rational.nonzero(d)
                [by hypothesis given-d-nonzero]
              @given-the-division |
                assume dividesIntegrally(rational.mul(d, e), d) {
                  @the-division |
                    dividesIntegrally(rational.mul(d, e), d)
                    [by hypothesis given-the-division]
                  @the-division-meaning |
                    dividesIntegrally(rational.mul(d, e), d) iff
                      (exists k: Q; isInteger(k) and
                      d = rational.mul(rational.mul(d, e), k))
                    [using specialize dividesIntegrallyMeaning(rational.mul(d, e), d)]
                  @a-quotient-exists |
                    exists k: Q; isInteger(k) and
                      d = rational.mul(rational.mul(d, e), k)
                    [using tautology the-division-meaning the-division]
                  @with-the-quotient |
                    unpack m: Q from a-quotient-exists {
                      @with-quotient-m |
                        isInteger(m) and
                          d = rational.mul(rational.mul(d, e), m)
                        [by hypothesis with-the-quotient]
                      @m-is-an-integer |
                        isInteger(m)
                        [by and_lhs with-quotient-m]
                      @d-is-the-product |
                        d = rational.mul(rational.mul(d, e), m)
                        [by and_rhs with-quotient-m]
                      // d·1 = d = (d·e)·m = d·(e·m); cancel d
                      @reassociate |
                        rational.mul(rational.mul(d, e), m) =
                          rational.mul(d, rational.mul(e, m))
                        [using specialize rational.mulIsAssociative(d, e, m)]
                      @d-is-d-times-em |
                        d = rational.mul(d, rational.mul(e, m))
                        [by rewrite reassociate d-is-the-product]
                      @d-times-one |
                        rational.mul(d, ONE) = d
                        [using specialize rational.mulOneRight(d)]
                      @the-products-agree |
                        rational.mul(d, ONE) =
                          rational.mul(d, rational.mul(e, m))
                        [by rewrite d-times-one d-is-d-times-em]
                      @one-is-e-times-m |
                        ONE = rational.mul(e, m)
                        [using specialize aNonzeroFactorCancels(d, ONE, rational.mul(e, m)) d-nonzero the-products-agree]
                      @the-witness-works |
                        isInteger(m) and ONE = rational.mul(e, m)
                        [by both m-is-an-integer one-is-e-times-m]
                      @a-unit-quotient-exists |
                        exists k: Q; isInteger(k) and ONE = rational.mul(e, k)
                        [by witness(m) the-witness-works]
                      @the-unit-meaning |
                        dividesIntegrally(e, ONE) iff
                          (exists k: Q; isInteger(k) and
                          ONE = rational.mul(e, k))
                        [using specialize dividesIntegrallyMeaning(e, ONE)]
                      @conclusion-e-divides-one |
                        dividesIntegrally(e, ONE)
                        [using tautology the-unit-meaning a-unit-quotient-exists]
                    }
                  @conclusion-the-unit |
                    dividesIntegrally(e, ONE)
                    [by unpacked with-the-quotient]
                }
              @division-implies |
                dividesIntegrally(rational.mul(d, e), d) ->
                  dividesIntegrally(e, ONE)
                [by discharge given-the-division]
            }
          @nonzero-implies |
            rational.nonzero(d) ->
              dividesIntegrally(rational.mul(d, e), d) ->
              dividesIntegrally(e, ONE)
            [by discharge given-d-nonzero]
        }
      @discharge-e |
        forall e9: Q;
          rational.nonzero(d) ->
          dividesIntegrally(rational.mul(d, e9), d) ->
          dividesIntegrally(e9, ONE)
        [by generalize generalize-e]
    }
  @conclusion |
    forall d, e: Q;
      rational.nonzero(d) ->
      dividesIntegrally(rational.mul(d, e), d) ->
      dividesIntegrally(e, ONE)
    [by generalize generalize-d]
qed

// The quotients by a maximal common divisor are RELATIVELY PRIME — the relative-primality
// 17.12's statement asks for, from maximality alone.
//
// Strategy: let e be an integer dividing every quotient. Then d·e divides every ENTRY (entry
// = d·quotient and e | quotient give d·e | d·quotient), so d·e | d by maximality. Writing
// d = (d·e)·m and cancelling the nonzero d leaves ONE = e·m, so e | ONE.
theorem theQuotientsByAMaximalDivisorAreRelativelyPrime:
  forall d: Q; forall s, q: QSeq; forall n: Nat; forall e: Q;
  isAMaximalCommonDivisorUpTo(d, s, n) ->
  (forall i: Nat; nat_less_than(i, n) -> qat(s, i) = rational.mul(d, qat(q, i))) ->
  isInteger(e) -> isACommonDivisorUpTo(e, q, n) ->
  dividesIntegrally(e, ONE)
proof
  @generalize-d |
    fix d: Q {
      @generalize-s |
        fix s: QSeq {
          @generalize-q |
            fix q: QSeq {
              @generalize-n |
                fix n: Nat {
                  @generalize-e |
                    fix e: Q {
                      @given-d-is-maximal |
                        assume isAMaximalCommonDivisorUpTo(d, s, n) {
                          @d-is-maximal |
                            isAMaximalCommonDivisorUpTo(d, s, n)
                            [by hypothesis given-d-is-maximal]
                          @the-maximal-meaning |
                            isAMaximalCommonDivisorUpTo(d, s, n) iff
                              (isInteger(d) and less_than(ZERO, d) and
                              rational.nonzero(d) and
                              isACommonDivisorUpTo(d, s, n) and
                              (forall e2: Q; isInteger(e2) ->
                              isACommonDivisorUpTo(e2, s, n) ->
                              dividesIntegrally(e2, d)))
                            [using specialize maximalCommonDivisorMeaning(d, s, n)]
                          @the-maximal-parts |
                            isInteger(d) and less_than(ZERO, d) and
                              rational.nonzero(d) and
                              isACommonDivisorUpTo(d, s, n) and
                              (forall e2: Q; isInteger(e2) ->
                              isACommonDivisorUpTo(e2, s, n) ->
                              dividesIntegrally(e2, d))
                            [using tautology the-maximal-meaning d-is-maximal]
                          @the-integer-d |
                            isInteger(d)
                            [using tautology the-maximal-parts]
                          @d-is-nonzero |
                            rational.nonzero(d)
                            [using tautology the-maximal-parts]
                          @maximality |
                            forall e2: Q; isInteger(e2) ->
                              isACommonDivisorUpTo(e2, s, n) ->
                              dividesIntegrally(e2, d)
                            [using tautology the-maximal-parts]
                          @given-the-factorization |
                            assume forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i)) {
                              @the-factorization |
                                forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(d, qat(q, i))
                                [by hypothesis given-the-factorization]
                              @given-e-is-an-integer |
                                assume isInteger(e) {
                                  @e-is-an-integer |
                                    isInteger(e)
                                    [by hypothesis given-e-is-an-integer]
                                  @given-e-divides-the-quotients |
                                    assume isACommonDivisorUpTo(e, q, n) {
                                      @e-divides-the-quotients |
                                        isACommonDivisorUpTo(e, q, n)
                                        [by hypothesis given-e-divides-the-quotients]
                                      // d·e is a common divisor of the ENTRIES
                                      @d-times-e-is-an-integer |
                                        isInteger(rational.mul(d, e))
                                        [using specialize rational.isIntegerMul(d, e) the-integer-d e-is-an-integer]
                                      @d-times-e-divides-the-entries |
                                        isACommonDivisorUpTo(rational.mul(d, e), s, n)
                                        [using specialize theScaledDivisorDividesTheScaledEntries(d, e, s, q, n) e-divides-the-quotients the-factorization]
                                      // so it divides d
                                      @d-times-e-divides-d |
                                        dividesIntegrally(rational.mul(d, e), d)
                                        [using specialize maximality(rational.mul(d, e)) d-times-e-is-an-integer d-times-e-divides-the-entries]
                                      // cancel d: ONE = e·m
                                      @conclusion-e-is-a-unit |
                                        dividesIntegrally(e, ONE)
                                        [using specialize cancellingTheDivisorLeavesAUnit(d, e) d-is-nonzero d-times-e-divides-d]
                                    }
                                  @quotient-divisor-implies |
                                    isACommonDivisorUpTo(e, q, n) ->
                                      dividesIntegrally(e, ONE)
                                    [by discharge given-e-divides-the-quotients]
                                }
                              @integer-implies |
                                isInteger(e) ->
                                  isACommonDivisorUpTo(e, q, n) ->
                                  dividesIntegrally(e, ONE)
                                [by discharge given-e-is-an-integer]
                            }
                          @factorization-implies |
                            (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) ->
                              isInteger(e) ->
                              isACommonDivisorUpTo(e, q, n) ->
                              dividesIntegrally(e, ONE)
                            [by discharge given-the-factorization]
                        }
                      @maximal-implies |
                        isAMaximalCommonDivisorUpTo(d, s, n) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) ->
                          isInteger(e) ->
                          isACommonDivisorUpTo(e, q, n) ->
                          dividesIntegrally(e, ONE)
                        [by discharge given-d-is-maximal]
                    }
                  @discharge-e |
                    forall e9: Q;
                      isAMaximalCommonDivisorUpTo(d, s, n) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      qat(s, i) = rational.mul(d, qat(q, i))) ->
                      isInteger(e9) ->
                      isACommonDivisorUpTo(e9, q, n) ->
                      dividesIntegrally(e9, ONE)
                    [by generalize generalize-e]
                }
              @discharge-n |
                forall n9: Nat; forall e9: Q;
                  isAMaximalCommonDivisorUpTo(d, s, n9) ->
                  (forall i: Nat; nat_less_than(i, n9) ->
                  qat(s, i) = rational.mul(d, qat(q, i))) ->
                  isInteger(e9) ->
                  isACommonDivisorUpTo(e9, q, n9) ->
                  dividesIntegrally(e9, ONE)
                [by generalize generalize-n]
            }
          @discharge-q |
            forall q9: QSeq; forall n9: Nat; forall e9: Q;
              isAMaximalCommonDivisorUpTo(d, s, n9) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(s, i) = rational.mul(d, qat(q9, i))) ->
              isInteger(e9) ->
              isACommonDivisorUpTo(e9, q9, n9) ->
              dividesIntegrally(e9, ONE)
            [by generalize generalize-q]
        }
      @discharge-s |
        forall s9: QSeq; forall q9: QSeq; forall n9: Nat; forall e9: Q;
          isAMaximalCommonDivisorUpTo(d, s9, n9) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(s9, i) = rational.mul(d, qat(q9, i))) ->
          isInteger(e9) ->
          isACommonDivisorUpTo(e9, q9, n9) ->
          dividesIntegrally(e9, ONE)
        [by generalize generalize-s]
    }
  @conclusion |
    forall d: Q; forall s, q: QSeq; forall n: Nat; forall e: Q;
      isAMaximalCommonDivisorUpTo(d, s, n) ->
      (forall i: Nat; nat_less_than(i, n) ->
      qat(s, i) = rational.mul(d, qat(q, i))) ->
      isInteger(e) -> isACommonDivisorUpTo(e, q, n) ->
      dividesIntegrally(e, ONE)
    [by generalize generalize-d]
qed

// The single-value core of `theScaledDivisorDividesTheScaledEntries`: if e | v and w = g·v,
// then g·e | w. Used by both the sequence version (step 3) and the pair version (step 4).
theorem theScaledDivisorDividesAScaledValue: forall g, e, v, w: Q;
  dividesIntegrally(e, v) -> w = rational.mul(g, v) ->
  dividesIntegrally(rational.mul(g, e), w)
proof
  @generalize-g |
    fix g: Q {
      @generalize-e |
        fix e: Q {
          @generalize-v |
            fix v: Q {
              @generalize-w |
                fix w: Q {
                  @given-e-divides-v |
                    assume dividesIntegrally(e, v) {
                      @e-divides-v |
                        dividesIntegrally(e, v)
                        [by hypothesis given-e-divides-v]
                      @the-divides-meaning |
                        dividesIntegrally(e, v) iff
                          (exists k: Q; isInteger(k) and
                          v = rational.mul(e, k))
                        [using specialize dividesIntegrallyMeaning(e, v)]
                      @a-quotient-exists |
                        exists k: Q; isInteger(k) and v = rational.mul(e, k)
                        [using tautology the-divides-meaning e-divides-v]
                      @given-w-is-scaled |
                        assume w = rational.mul(g, v) {
                          @w-is-scaled |
                            w = rational.mul(g, v)
                            [by hypothesis given-w-is-scaled]
                          @with-the-quotient |
                            unpack m: Q from a-quotient-exists {
                              @with-quotient-m |
                                isInteger(m) and v = rational.mul(e, m)
                                [by hypothesis with-the-quotient]
                              @m-is-an-integer |
                                isInteger(m)
                                [by and_lhs with-quotient-m]
                              @v-is-e-times-m |
                                v = rational.mul(e, m)
                                [by and_rhs with-quotient-m]
                              // w = g·(e·m) = (g·e)·m
                              @w-expanded |
                                w = rational.mul(g, rational.mul(e, m))
                                [by rewrite v-is-e-times-m w-is-scaled]
                              @reassociate |
                                rational.mul(rational.mul(g, e), m) =
                                  rational.mul(g, rational.mul(e, m))
                                [using specialize rational.mulIsAssociative(g, e, m)]
                              @w-regrouped |
                                w = rational.mul(rational.mul(g, e), m)
                                [by rewrite reassociate w-expanded]
                              @the-witness-works |
                                isInteger(m) and
                                  w = rational.mul(rational.mul(g, e), m)
                                [by both m-is-an-integer w-regrouped]
                              @the-scaled-quotient-exists |
                                exists k: Q; isInteger(k) and
                                  w = rational.mul(rational.mul(g, e), k)
                                [by witness(m) the-witness-works]
                              @the-scaled-meaning |
                                dividesIntegrally(rational.mul(g, e), w) iff
                                  (exists k: Q; isInteger(k) and
                                  w = rational.mul(rational.mul(g, e), k))
                                [using specialize dividesIntegrallyMeaning(rational.mul(g, e), w)]
                              @conclusion-scaled-divides |
                                dividesIntegrally(rational.mul(g, e), w)
                                [using tautology the-scaled-meaning the-scaled-quotient-exists]
                            }
                          @conclusion-divides |
                            dividesIntegrally(rational.mul(g, e), w)
                            [by unpacked with-the-quotient]
                        }
                      @scaled-implies |
                        w = rational.mul(g, v) ->
                          dividesIntegrally(rational.mul(g, e), w)
                        [by discharge given-w-is-scaled]
                    }
                  @divides-implies |
                    dividesIntegrally(e, v) -> w = rational.mul(g, v) ->
                      dividesIntegrally(rational.mul(g, e), w)
                    [by discharge given-e-divides-v]
                }
              @discharge-w |
                forall w9: Q;
                  dividesIntegrally(e, v) -> w9 = rational.mul(g, v) ->
                  dividesIntegrally(rational.mul(g, e), w9)
                [by generalize generalize-w]
            }
          @discharge-v |
            forall v9: Q; forall w9: Q;
              dividesIntegrally(e, v9) -> w9 = rational.mul(g, v9) ->
              dividesIntegrally(rational.mul(g, e), w9)
            [by generalize generalize-v]
        }
      @discharge-e |
        forall e9: Q; forall v9: Q; forall w9: Q;
          dividesIntegrally(e9, v9) -> w9 = rational.mul(g, v9) ->
          dividesIntegrally(rational.mul(g, e9), w9)
        [by generalize generalize-e]
    }
  @conclusion |
    forall g, e, v, w: Q;
      dividesIntegrally(e, v) -> w = rational.mul(g, v) ->
      dividesIntegrally(rational.mul(g, e), w)
    [by generalize generalize-g]
qed

// -- LEMMA 17.12, STEP 4: REDUCING A FRACTION TO LOWEST TERMS -----------------------------
// "Reducing d/(c_0 ⋯ c_n) to its lowest terms, we can write p(x) = r/s(a_0 + … + a_n x^n),
// where gcd(r, s) = 1."
//
// Same shape as step 3, on a PAIR rather than a sequence: divide numerator and denominator by
// a maximal common divisor and the quotients share no factor beyond a unit. The argument is
// identical — a common divisor of the quotients, scaled by the divisor, divides the original
// pair, hence divides the maximal one, hence is a unit.

// `isAMaximalCommonDivisorOfThePair(g, a, b)` — g is a nonzero integer dividing both, and
// every integer common divisor divides g.
pred isAMaximalCommonDivisorOfThePair(g: Q, a: Q, b: Q)
axiom pairDivisorMeaning: forall g, a, b: Q;
  isAMaximalCommonDivisorOfThePair(g, a, b) iff
  (isInteger(g) and less_than(ZERO, g) and
  rational.nonzero(g) and
  dividesIntegrally(g, a) and dividesIntegrally(g, b) and
  (forall e: Q; isInteger(e) -> dividesIntegrally(e, a) ->
  dividesIntegrally(e, b) -> dividesIntegrally(e, g)))

// The quotients of a pair by their maximal common divisor are COPRIME.
// Strategy: e divides both quotients, so g·e divides both originals (original = g·quotient),
// so g·e | g by maximality, so e | ONE by `cancellingTheDivisorLeavesAUnit`.
theorem theReducedFractionIsInLowestTerms: forall g, a, b, r, s, e: Q;
  isAMaximalCommonDivisorOfThePair(g, a, b) ->
  a = rational.mul(g, r) -> b = rational.mul(g, s) ->
  isInteger(e) -> dividesIntegrally(e, r) -> dividesIntegrally(e, s) ->
  dividesIntegrally(e, ONE)
proof
  @generalize-g |
    fix g: Q {
      @generalize-a |
        fix a: Q {
          @generalize-b |
            fix b: Q {
              @generalize-r |
                fix r: Q {
                  @generalize-s |
                    fix s: Q {
                      @generalize-e |
                        fix e: Q {
                          @given-g-is-maximal |
                            assume isAMaximalCommonDivisorOfThePair(g, a, b) {
                              @g-is-maximal |
                                isAMaximalCommonDivisorOfThePair(g, a, b)
                                [by hypothesis given-g-is-maximal]
                              @the-pair-meaning |
                                isAMaximalCommonDivisorOfThePair(g, a, b) iff
                                  (isInteger(g) and less_than(ZERO, g) and
                                  rational.nonzero(g) and
                                  dividesIntegrally(g, a) and
                                  dividesIntegrally(g, b) and
                                  (forall e2: Q; isInteger(e2) ->
                                  dividesIntegrally(e2, a) ->
                                  dividesIntegrally(e2, b) ->
                                  dividesIntegrally(e2, g)))
                                [using specialize pairDivisorMeaning(g, a, b)]
                              @the-pair-parts |
                                isInteger(g) and less_than(ZERO, g) and
                                  rational.nonzero(g) and
                                  dividesIntegrally(g, a) and
                                  dividesIntegrally(g, b) and
                                  (forall e2: Q; isInteger(e2) ->
                                  dividesIntegrally(e2, a) ->
                                  dividesIntegrally(e2, b) ->
                                  dividesIntegrally(e2, g))
                                [using tautology the-pair-meaning g-is-maximal]
                              @g-is-an-integer |
                                isInteger(g)
                                [using tautology the-pair-parts]
                              @g-is-nonzero |
                                rational.nonzero(g)
                                [using tautology the-pair-parts]
                              @pair-maximality |
                                forall e2: Q; isInteger(e2) ->
                                  dividesIntegrally(e2, a) ->
                                  dividesIntegrally(e2, b) ->
                                  dividesIntegrally(e2, g)
                                [using tautology the-pair-parts]
                              @given-a-factors |
                                assume a = rational.mul(g, r) {
                                  @a-factors |
                                    a = rational.mul(g, r)
                                    [by hypothesis given-a-factors]
                                  @given-b-factors |
                                    assume b = rational.mul(g, s) {
                                      @b-factors |
                                        b = rational.mul(g, s)
                                        [by hypothesis given-b-factors]
                                      @given-e-is-an-integer |
                                        assume isInteger(e) {
                                          @e-is-an-integer |
                                            isInteger(e)
                                            [by hypothesis given-e-is-an-integer]
                                          @given-e-divides-r |
                                            assume dividesIntegrally(e, r) {
                                              @e-divides-r |
                                                dividesIntegrally(e, r)
                                                [by hypothesis given-e-divides-r]
                                              @given-e-divides-s |
                                                assume dividesIntegrally(e, s) {
                                                  @e-divides-s |
                                                    dividesIntegrally(e, s)
                                                    [by hypothesis given-e-divides-s]
                                                  @g-times-e-is-an-integer |
                                                    isInteger(rational.mul(g, e))
                                                    [using specialize rational.isIntegerMul(g, e) g-is-an-integer e-is-an-integer]
                                                  // g·e divides a and b
                                                  @g-times-e-divides-a |
                                                    dividesIntegrally(rational.mul(g, e), a)
                                                    [using specialize theScaledDivisorDividesAScaledValue(g, e, r, a) e-divides-r a-factors]
                                                  @g-times-e-divides-b |
                                                    dividesIntegrally(rational.mul(g, e), b)
                                                    [using specialize theScaledDivisorDividesAScaledValue(g, e, s, b) e-divides-s b-factors]
                                                  @g-times-e-divides-g |
                                                    dividesIntegrally(rational.mul(g, e), g)
                                                    [using specialize pair-maximality(rational.mul(g, e)) g-times-e-is-an-integer g-times-e-divides-a g-times-e-divides-b]
                                                  @conclusion-e-is-a-unit |
                                                    dividesIntegrally(e, ONE)
                                                    [using specialize cancellingTheDivisorLeavesAUnit(g, e) g-is-nonzero g-times-e-divides-g]
                                                }
                                              @divides-s-implies |
                                                dividesIntegrally(e, s) ->
                                                  dividesIntegrally(e, ONE)
                                                [by discharge given-e-divides-s]
                                            }
                                          @divides-r-implies |
                                            dividesIntegrally(e, r) ->
                                              dividesIntegrally(e, s) ->
                                              dividesIntegrally(e, ONE)
                                            [by discharge given-e-divides-r]
                                        }
                                      @integer-implies |
                                        isInteger(e) ->
                                          dividesIntegrally(e, r) ->
                                          dividesIntegrally(e, s) ->
                                          dividesIntegrally(e, ONE)
                                        [by discharge given-e-is-an-integer]
                                    }
                                  @b-factors-implies |
                                    b = rational.mul(g, s) ->
                                      isInteger(e) ->
                                      dividesIntegrally(e, r) ->
                                      dividesIntegrally(e, s) ->
                                      dividesIntegrally(e, ONE)
                                    [by discharge given-b-factors]
                                }
                              @a-factors-implies |
                                a = rational.mul(g, r) ->
                                  b = rational.mul(g, s) ->
                                  isInteger(e) ->
                                  dividesIntegrally(e, r) ->
                                  dividesIntegrally(e, s) ->
                                  dividesIntegrally(e, ONE)
                                [by discharge given-a-factors]
                            }
                          @maximal-implies |
                            isAMaximalCommonDivisorOfThePair(g, a, b) ->
                              a = rational.mul(g, r) ->
                              b = rational.mul(g, s) ->
                              isInteger(e) ->
                              dividesIntegrally(e, r) ->
                              dividesIntegrally(e, s) ->
                              dividesIntegrally(e, ONE)
                            [by discharge given-g-is-maximal]
                        }
                      @discharge-e |
                        forall e9: Q;
                          isAMaximalCommonDivisorOfThePair(g, a, b) ->
                          a = rational.mul(g, r) ->
                          b = rational.mul(g, s) ->
                          isInteger(e9) ->
                          dividesIntegrally(e9, r) ->
                          dividesIntegrally(e9, s) ->
                          dividesIntegrally(e9, ONE)
                        [by generalize generalize-e]
                    }
                  @discharge-s |
                    forall s9: Q; forall e9: Q;
                      isAMaximalCommonDivisorOfThePair(g, a, b) ->
                      a = rational.mul(g, r) ->
                      b = rational.mul(g, s9) ->
                      isInteger(e9) ->
                      dividesIntegrally(e9, r) ->
                      dividesIntegrally(e9, s9) ->
                      dividesIntegrally(e9, ONE)
                    [by generalize generalize-s]
                }
              @discharge-r |
                forall r9: Q; forall s9: Q; forall e9: Q;
                  isAMaximalCommonDivisorOfThePair(g, a, b) ->
                  a = rational.mul(g, r9) ->
                  b = rational.mul(g, s9) ->
                  isInteger(e9) ->
                  dividesIntegrally(e9, r9) ->
                  dividesIntegrally(e9, s9) ->
                  dividesIntegrally(e9, ONE)
                [by generalize generalize-r]
            }
          @discharge-b |
            forall b9: Q; forall r9: Q; forall s9: Q; forall e9: Q;
              isAMaximalCommonDivisorOfThePair(g, a, b9) ->
              a = rational.mul(g, r9) ->
              b9 = rational.mul(g, s9) ->
              isInteger(e9) ->
              dividesIntegrally(e9, r9) ->
              dividesIntegrally(e9, s9) ->
              dividesIntegrally(e9, ONE)
            [by generalize generalize-b]
        }
      @discharge-a |
        forall a9: Q; forall b9: Q; forall r9: Q; forall s9: Q; forall e9: Q;
          isAMaximalCommonDivisorOfThePair(g, a9, b9) ->
          a9 = rational.mul(g, r9) ->
          b9 = rational.mul(g, s9) ->
          isInteger(e9) ->
          dividesIntegrally(e9, r9) ->
          dividesIntegrally(e9, s9) ->
          dividesIntegrally(e9, ONE)
        [by generalize generalize-a]
    }
  @conclusion |
    forall g, a, b, r, s, e: Q;
      isAMaximalCommonDivisorOfThePair(g, a, b) ->
      a = rational.mul(g, r) -> b = rational.mul(g, s) ->
      isInteger(e) -> dividesIntegrally(e, r) -> dividesIntegrally(e, s) ->
      dividesIntegrally(e, ONE)
    [by generalize generalize-g]
qed

// -- THE EXISTENCE OBLIGATION: A DIVISOR WHOSE QUOTIENTS ARE COPRIME ----------------------
// Steps 3 and 4 take their divisor as a HYPOTHESIS. This is its existence, and it is what
// closes Lemma 17.12's construction.
//
// Judson says "let d be the GREATEST common divisor". Maximality is sufficient but not
// necessary: what the statement needs is only that the QUOTIENTS be relatively prime, so the
// target here is the weaker
//
//     exists d, q;  d | every entry,  entry_i = d · q_i,  the q_i coprime
//
// obtained by DESCENT rather than by constructing a gcd. Well-order on the first quotient:
// among all common divisors, pick one making q_0 least. If some non-unit e divided every
// quotient, dividing through by e would make q_0 strictly smaller
// (`aProperFactorShrinksTheQuotient`), contradicting leastness. So the quotients are coprime.
//
// The first entry is required POSITIVE — that is where the descent gets its floor, and it
// matches Judson's setting (a nonzero polynomial has a nonzero coefficient to anchor on).

// `aQuotientSequenceFor(d, s, q, n)` — q is the entrywise quotient of s by d, below n.
pred aQuotientSequenceFor(d: Q, s: QSeq, q: QSeq, n: Nat)
axiom quotientSequenceMeaning: forall d: Q; forall s, q: QSeq; forall n: Nat;
  aQuotientSequenceFor(d, s, q, n) iff
  (forall i: Nat; nat_less_than(i, n) ->
  qat(s, i) = rational.mul(d, qat(q, i)))

// The coprimality 17.12 asks of the quotients, named so the existence statement can carry it.
pred theQuotientsAreCoprime(q: QSeq, n: Nat)
axiom quotientsCoprimeMeaning: forall q: QSeq; forall n: Nat;
  theQuotientsAreCoprime(q, n) iff
  (forall e: Q; isInteger(e) -> isACommonDivisorUpTo(e, q, n) ->
  dividesIntegrally(e, ONE))

// ONE is always such a divisor, with the sequence itself as quotient — the inhabitation the
// descent starts from.
theorem theTrivialDivisorWorks: forall s: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
  (isACommonDivisorUpTo(ONE, s, n) and aQuotientSequenceFor(ONE, s, s, n))
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-n |
        fix n: Nat {
          @given-the-entries |
            assume forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i)) {
              @the-entries |
                forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))
                [by hypothesis given-the-entries]
              @one-divides |
                isACommonDivisorUpTo(ONE, s, n)
                [using specialize oneIsACommonDivisor(s, n) the-entries]
              @each-entry-is-one-times-itself |
                fix i: Nat {
                  @given-i-below-n |
                    assume nat_less_than(i, n) {
                      @one-times-the-entry |
                        rational.mul(ONE, qat(s, i)) = qat(s, i)
                        [using specialize rational.mulOneLeft(qat(s, i))]
                      @conclusion-the-identity |
                        qat(s, i) = rational.mul(ONE, qat(s, i))
                        [by symmetry one-times-the-entry]
                    }
                  @below-n-implies |
                    nat_less_than(i, n) ->
                      qat(s, i) = rational.mul(ONE, qat(s, i))
                    [by discharge given-i-below-n]
                }
              @all-identities |
                forall i: Nat; nat_less_than(i, n) ->
                  qat(s, i) = rational.mul(ONE, qat(s, i))
                [by generalize each-entry-is-one-times-itself]
              @the-quotient-meaning |
                aQuotientSequenceFor(ONE, s, s, n) iff
                  (forall i: Nat; nat_less_than(i, n) ->
                  qat(s, i) = rational.mul(ONE, qat(s, i)))
                [using specialize quotientSequenceMeaning(ONE, s, s, n)]
              @s-is-its-own-quotient |
                aQuotientSequenceFor(ONE, s, s, n)
                [using tautology the-quotient-meaning all-identities]
              @conclusion-the-trivial-divisor |
                isACommonDivisorUpTo(ONE, s, n) and
                  aQuotientSequenceFor(ONE, s, s, n)
                [by both one-divides s-is-its-own-quotient]
            }
          @entries-imply |
            (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
              (isACommonDivisorUpTo(ONE, s, n) and
              aQuotientSequenceFor(ONE, s, s, n))
            [by discharge given-the-entries]
        }
      @discharge-n |
        forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) -> isInteger(qat(s, i))) ->
          (isACommonDivisorUpTo(ONE, s, n9) and
          aQuotientSequenceFor(ONE, s, s, n9))
        [by generalize generalize-n]
    }
  @conclusion |
    forall s: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
      (isACommonDivisorUpTo(ONE, s, n) and
      aQuotientSequenceFor(ONE, s, s, n))
    [by generalize generalize-s]
qed

// ONE divides ONE: the witness quotient is ONE.
theorem oneDividesItself: dividesIntegrally(ONE, ONE)
proof
  @one-is-an-integer |
    isInteger(ONE)
    [by cite rational.oneIsAnInteger]
  @one-times-one |
    rational.mul(ONE, ONE) = ONE
    [using specialize rational.mulOneLeft(ONE)]
  @one-is-the-product |
    ONE = rational.mul(ONE, ONE)
    [by symmetry one-times-one]
  @the-witness-works |
    isInteger(ONE) and ONE = rational.mul(ONE, ONE)
    [by both one-is-an-integer one-is-the-product]
  @a-quotient-exists |
    exists k: Q; isInteger(k) and ONE = rational.mul(ONE, k)
    [by witness(ONE) the-witness-works]
  @the-divides-meaning |
    dividesIntegrally(ONE, ONE) iff
      (exists k: Q; isInteger(k) and ONE = rational.mul(ONE, k))
    [using specialize dividesIntegrallyMeaning(ONE, ONE)]
  @conclusion |
    dividesIntegrally(ONE, ONE)
    [using tautology the-divides-meaning a-quotient-exists]
qed

// If e > 0 and e·k > 0 then k > 0: the general form of `theCofactorIsPositive`, which is
// stated only for the product ONE.
theorem theCofactorOfAPositiveIsPositive: forall e, k, whole: Q;
  less_than(ZERO, e) -> less_than(ZERO, whole) ->
  whole = rational.mul(e, k) -> less_than(ZERO, k)
proof
  @generalize-e |
    fix e: Q {
      @generalize-k |
        fix k: Q {
          @generalize-whole |
            fix whole: Q {
              @given-e-positive |
                assume less_than(ZERO, e) {
                  @e-positive |
                    less_than(ZERO, e)
                    [by hypothesis given-e-positive]
                  @given-whole-positive |
                    assume less_than(ZERO, whole) {
                      @whole-positive |
                        less_than(ZERO, whole)
                        [by hypothesis given-whole-positive]
                      @given-the-factorization |
                        assume whole = rational.mul(e, k) {
                          @the-factorization |
                            whole = rational.mul(e, k)
                            [by hypothesis given-the-factorization]
                          @the-product-positive |
                            less_than(ZERO, rational.mul(e, k))
                            [by rewrite the-factorization whole-positive]
                          @the-sign-cases |
                            less_than(k, ZERO) or k = ZERO or
                              less_than(ZERO, k)
                            [using specialize rational.lessThanTrichotomy(k, ZERO)]
                          @zero-not-below-itself |
                            not less_than(ZERO, ZERO)
                            [using specialize rational.lessThanIrreflexive(ZERO)]
                          @order-is-asymmetric |
                            forall y, z: Q;
                              less_than(y, z) -> (not less_than(z, y))
                            [using model(rational.RationalOrderedField) field_order.lessThanAsymmetric]
                          @scaling |
                            forall x, y, z: Q;
                              less_than(x, y) -> less_than(ZERO, z) ->
                              less_than(rational.mul(x, z), rational.mul(y, z))
                            [using model(rational.RationalOrderedField) field_order.lessThanMulPositiveRight]
                          @conclusion-k-positive |
                            less_than(ZERO, k)
                            case the-sign-cases {
                              // `or` is LEFT-associative: this arm is (k<0 or k=0)
                              @when-k-not-positive |
                                assume less_than(k, ZERO) or k = ZERO {
                                  @k-not-positive |
                                    less_than(k, ZERO) or k = ZERO
                                    [by hypothesis when-k-not-positive]
                                  @conclusion-nonpositive |
                                    less_than(ZERO, k)
                                    case k-not-positive {
                                      @when-k-negative |
                                        assume less_than(k, ZERO) {
                                          @k-negative |
                                            less_than(k, ZERO)
                                            [by hypothesis when-k-negative]
                                          // k·e < 0·e = 0, and e·k = k·e
                                          @k-times-e-below |
                                            less_than(rational.mul(k, e),
                                              rational.mul(ZERO, e))
                                            [using specialize scaling(k, ZERO, e) k-negative e-positive]
                                          @zero-times-e |
                                            rational.mul(ZERO, e) = ZERO
                                            [using specialize rational.mulZeroLeft(e)]
                                          @k-times-e-negative |
                                            less_than(rational.mul(k, e), ZERO)
                                            [by rewrite zero-times-e k-times-e-below]
                                          @the-product-commutes |
                                            rational.mul(k, e) =
                                              rational.mul(e, k)
                                            [using specialize rational.mulIsCommutative(k, e)]
                                          @the-product-negative |
                                            less_than(rational.mul(e, k), ZERO)
                                            [by rewrite the-product-commutes k-times-e-negative]
                                          @not-both |
                                            not less_than(ZERO,
                                              rational.mul(e, k))
                                            [using specialize order-is-asymmetric(rational.mul(e, k), ZERO) the-product-negative]
                                          @conclusion-vacuous-negative |
                                            less_than(ZERO, k)
                                            [by ex_falso the-product-positive not-both]
                                        }
                                      @when-k-zero |
                                        assume k = ZERO {
                                          @k-zero |
                                            k = ZERO
                                            [by hypothesis when-k-zero]
                                          @e-times-zero |
                                            rational.mul(e, ZERO) = ZERO
                                            [using specialize rational.mulZeroRight(e)]
                                          @the-product-at-zero |
                                            less_than(ZERO,
                                              rational.mul(e, ZERO))
                                            [by rewrite k-zero the-product-positive]
                                          @zero-below-zero |
                                            less_than(ZERO, ZERO)
                                            [by rewrite e-times-zero the-product-at-zero]
                                          @conclusion-vacuous-zero |
                                            less_than(ZERO, k)
                                            [by ex_falso zero-below-zero zero-not-below-itself]
                                        }
                                    }
                                }
                              @when-k-positive |
                                assume less_than(ZERO, k) {
                                  @k-positive |
                                    less_than(ZERO, k)
                                    [by hypothesis when-k-positive]
                                }
                            }
                        }
                      @factorization-implies |
                        whole = rational.mul(e, k) -> less_than(ZERO, k)
                        [by discharge given-the-factorization]
                    }
                  @whole-positive-implies |
                    less_than(ZERO, whole) ->
                      whole = rational.mul(e, k) -> less_than(ZERO, k)
                    [by discharge given-whole-positive]
                }
              @e-positive-implies |
                less_than(ZERO, e) -> less_than(ZERO, whole) ->
                  whole = rational.mul(e, k) -> less_than(ZERO, k)
                [by discharge given-e-positive]
            }
          @discharge-whole |
            forall w9: Q;
              less_than(ZERO, e) -> less_than(ZERO, w9) ->
              w9 = rational.mul(e, k) -> less_than(ZERO, k)
            [by generalize generalize-whole]
        }
      @discharge-k |
        forall k9: Q; forall w9: Q;
          less_than(ZERO, e) -> less_than(ZERO, w9) ->
          w9 = rational.mul(e, k9) -> less_than(ZERO, k9)
        [by generalize generalize-k]
    }
  @conclusion |
    forall e, k, whole: Q;
      less_than(ZERO, e) -> less_than(ZERO, whole) ->
      whole = rational.mul(e, k) -> less_than(ZERO, k)
    [by generalize generalize-e]
qed

// The descent step. If `e` is a non-unit integer dividing every quotient, then `d·e` is also a
// common divisor of the entries, and ITS quotients have a strictly smaller first entry — so a
// divisor minimizing the first quotient leaves no such `e`, i.e. the quotients are coprime.
//
// Strategy: e | q_0 gives q_0 = e·q0', and e exceeds ONE (positive non-unit), so
// `aProperFactorShrinksTheQuotient` puts q0' < q_0 provided q_0 is positive.
theorem aNonUnitDivisorShrinksTheFirstQuotient:
  forall e, firstQuotient, smaller: Q;
  isInteger(e) -> less_than(ZERO, e) -> (not dividesIntegrally(e, ONE)) ->
  less_than(ZERO, firstQuotient) ->
  firstQuotient = rational.mul(e, smaller) ->
  less_than(smaller, firstQuotient)
proof
  @generalize-e |
    fix e: Q {
      @generalize-first |
        fix firstQuotient: Q {
          @generalize-smaller |
            fix smaller: Q {
              @given-e-is-an-integer |
                assume isInteger(e) {
                  @e-is-an-integer |
                    isInteger(e)
                    [by hypothesis given-e-is-an-integer]
                  @given-e-positive |
                    assume less_than(ZERO, e) {
                      @e-positive |
                        less_than(ZERO, e)
                        [by hypothesis given-e-positive]
                      @given-e-not-a-unit |
                        assume not dividesIntegrally(e, ONE) {
                          @e-not-a-unit |
                            not dividesIntegrally(e, ONE)
                            [by hypothesis given-e-not-a-unit]
                          // e != ONE, since ONE divides ONE
                          @one-divides-one |
                            dividesIntegrally(ONE, ONE)
                            [by cite oneDividesItself]
                          // e = ONE would make e divide ONE; rewrite rather than
                          // `tautology`, which sees an equation and a predicate as
                          // unrelated atoms.
                          @given-e-is-one |
                            assume e = ONE {
                              @e-is-one |
                                e = ONE
                                [by hypothesis given-e-is-one]
                              @e-divides-one |
                                dividesIntegrally(e, ONE)
                                [by rewrite e-is-one one-divides-one]
                            }
                          @e-is-not-one |
                            not (e = ONE)
                            [by contradiction given-e-is-one e-divides-one e-not-a-unit]
                          @e-above-one |
                            less_than(ONE, e)
                            [using specialize rational_integer_order.aPositiveNonUnitExceedsOne(e) e-is-an-integer e-positive e-is-not-one]
                          @given-first-positive |
                            assume less_than(ZERO, firstQuotient) {
                              @first-positive |
                                less_than(ZERO, firstQuotient)
                                [by hypothesis given-first-positive]
                              @given-the-factorization |
                                assume firstQuotient = rational.mul(e, smaller) {
                                  @the-factorization |
                                    firstQuotient = rational.mul(e, smaller)
                                    [by hypothesis given-the-factorization]
                                  @smaller-is-positive |
                                    less_than(ZERO, smaller)
                                    [using specialize theCofactorOfAPositiveIsPositive(e, smaller, firstQuotient) e-positive first-positive the-factorization]
                                  @conclusion-strictly-smaller |
                                    less_than(smaller, firstQuotient)
                                    [using specialize rational_integer_order.aProperFactorShrinksTheQuotient(firstQuotient, e, smaller) e-above-one smaller-is-positive the-factorization]
                                }
                              @factorization-implies |
                                firstQuotient = rational.mul(e, smaller) ->
                                  less_than(smaller, firstQuotient)
                                [by discharge given-the-factorization]
                            }
                          @first-positive-implies |
                            less_than(ZERO, firstQuotient) ->
                              firstQuotient = rational.mul(e, smaller) ->
                              less_than(smaller, firstQuotient)
                            [by discharge given-first-positive]
                        }
                      @not-a-unit-implies |
                        (not dividesIntegrally(e, ONE)) ->
                          less_than(ZERO, firstQuotient) ->
                          firstQuotient = rational.mul(e, smaller) ->
                          less_than(smaller, firstQuotient)
                        [by discharge given-e-not-a-unit]
                    }
                  @positive-implies |
                    less_than(ZERO, e) ->
                      (not dividesIntegrally(e, ONE)) ->
                      less_than(ZERO, firstQuotient) ->
                      firstQuotient = rational.mul(e, smaller) ->
                      less_than(smaller, firstQuotient)
                    [by discharge given-e-positive]
                }
              @integer-implies |
                isInteger(e) -> less_than(ZERO, e) ->
                  (not dividesIntegrally(e, ONE)) ->
                  less_than(ZERO, firstQuotient) ->
                  firstQuotient = rational.mul(e, smaller) ->
                  less_than(smaller, firstQuotient)
                [by discharge given-e-is-an-integer]
            }
          @discharge-smaller |
            forall sm9: Q;
              isInteger(e) -> less_than(ZERO, e) ->
              (not dividesIntegrally(e, ONE)) ->
              less_than(ZERO, firstQuotient) ->
              firstQuotient = rational.mul(e, sm9) ->
              less_than(sm9, firstQuotient)
            [by generalize generalize-smaller]
        }
      @discharge-first |
        forall f9: Q; forall sm9: Q;
          isInteger(e) -> less_than(ZERO, e) ->
          (not dividesIntegrally(e, ONE)) ->
          less_than(ZERO, f9) ->
          f9 = rational.mul(e, sm9) ->
          less_than(sm9, f9)
        [by generalize generalize-first]
    }
  @conclusion |
    forall e, firstQuotient, smaller: Q;
      isInteger(e) -> less_than(ZERO, e) ->
      (not dividesIntegrally(e, ONE)) ->
      less_than(ZERO, firstQuotient) ->
      firstQuotient = rational.mul(e, smaller) ->
      less_than(smaller, firstQuotient)
    [by generalize generalize-e]
qed

// Coprimality from the DESCENT: if no non-unit integer divides every quotient, the quotients
// are coprime. This is the bridge between the descent step above and the predicate steps 3
// and 4 consume — and it is what a minimality argument discharges, since a non-unit common
// divisor would shrink the first quotient.
theorem noNonUnitDivisorMeansCoprime: forall q: QSeq; forall n: Nat;
  (forall e: Q; isInteger(e) -> isACommonDivisorUpTo(e, q, n) ->
  dividesIntegrally(e, ONE)) ->
  theQuotientsAreCoprime(q, n)
proof
  @generalize-q |
    fix q: QSeq {
      @generalize-n |
        fix n: Nat {
          @given-no-non-unit |
            assume forall e: Q; isInteger(e) ->
              isACommonDivisorUpTo(e, q, n) ->
              dividesIntegrally(e, ONE) {
              @no-non-unit |
                forall e: Q; isInteger(e) ->
                  isACommonDivisorUpTo(e, q, n) ->
                  dividesIntegrally(e, ONE)
                [by hypothesis given-no-non-unit]
              @the-coprime-meaning |
                theQuotientsAreCoprime(q, n) iff
                  (forall e: Q; isInteger(e) ->
                  isACommonDivisorUpTo(e, q, n) ->
                  dividesIntegrally(e, ONE))
                [using specialize quotientsCoprimeMeaning(q, n)]
              @conclusion-coprime |
                theQuotientsAreCoprime(q, n)
                [using tautology the-coprime-meaning no-non-unit]
            }
          @no-non-unit-implies-coprime |
            (forall e: Q; isInteger(e) ->
              isACommonDivisorUpTo(e, q, n) ->
              dividesIntegrally(e, ONE)) ->
              theQuotientsAreCoprime(q, n)
            [by discharge given-no-non-unit]
        }
      @discharge-n |
        forall n9: Nat;
          (forall e: Q; isInteger(e) ->
          isACommonDivisorUpTo(e, q, n9) ->
          dividesIntegrally(e, ONE)) ->
          theQuotientsAreCoprime(q, n9)
        [by generalize generalize-n]
    }
  @conclusion |
    forall q: QSeq; forall n: Nat;
      (forall e: Q; isInteger(e) ->
      isACommonDivisorUpTo(e, q, n) ->
      dividesIntegrally(e, ONE)) ->
      theQuotientsAreCoprime(q, n)
    [by generalize generalize-q]
qed

// And the composition steps 3 and 4 actually want: a MAXIMAL common divisor's quotients are
// coprime in the named sense.
theorem aMaximalDivisorGivesCoprimeQuotients:
  forall d: Q; forall s, q: QSeq; forall n: Nat;
  isAMaximalCommonDivisorUpTo(d, s, n) ->
  aQuotientSequenceFor(d, s, q, n) ->
  theQuotientsAreCoprime(q, n)
proof
  @generalize-d |
    fix d: Q {
      @generalize-s |
        fix s: QSeq {
          @generalize-q |
            fix q: QSeq {
              @generalize-n |
                fix n: Nat {
                  @given-d-is-maximal |
                    assume isAMaximalCommonDivisorUpTo(d, s, n) {
                      @d-is-maximal |
                        isAMaximalCommonDivisorUpTo(d, s, n)
                        [by hypothesis given-d-is-maximal]
                      @given-the-quotients |
                        assume aQuotientSequenceFor(d, s, q, n) {
                          @the-quotients |
                            aQuotientSequenceFor(d, s, q, n)
                            [by hypothesis given-the-quotients]
                          @the-quotient-meaning |
                            aQuotientSequenceFor(d, s, q, n) iff
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i)))
                            [using specialize quotientSequenceMeaning(d, s, q, n)]
                          @the-factorization |
                            forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))
                            [using tautology the-quotient-meaning the-quotients]
                          @each-divisor-is-a-unit |
                            fix e: Q {
                              @given-e-is-an-integer |
                                assume isInteger(e) {
                                  @e-is-an-integer |
                                    isInteger(e)
                                    [by hypothesis given-e-is-an-integer]
                                  @given-e-divides |
                                    assume isACommonDivisorUpTo(e, q, n) {
                                      @e-divides |
                                        isACommonDivisorUpTo(e, q, n)
                                        [by hypothesis given-e-divides]
                                      @conclusion-e-is-a-unit |
                                        dividesIntegrally(e, ONE)
                                        [using specialize theQuotientsByAMaximalDivisorAreRelativelyPrime(d, s, q, n, e) d-is-maximal the-factorization e-is-an-integer e-divides]
                                    }
                                  @divides-implies-unit |
                                    isACommonDivisorUpTo(e, q, n) ->
                                      dividesIntegrally(e, ONE)
                                    [by discharge given-e-divides]
                                }
                              @integer-implies-unit |
                                isInteger(e) ->
                                  isACommonDivisorUpTo(e, q, n) ->
                                  dividesIntegrally(e, ONE)
                                [by discharge given-e-is-an-integer]
                            }
                          @all-divisors-are-units |
                            forall e: Q; isInteger(e) ->
                              isACommonDivisorUpTo(e, q, n) ->
                              dividesIntegrally(e, ONE)
                            [by generalize each-divisor-is-a-unit]
                          @conclusion-coprime |
                            theQuotientsAreCoprime(q, n)
                            [using specialize noNonUnitDivisorMeansCoprime(q, n) all-divisors-are-units]
                        }
                      @quotients-imply-coprime |
                        aQuotientSequenceFor(d, s, q, n) ->
                          theQuotientsAreCoprime(q, n)
                        [by discharge given-the-quotients]
                    }
                  @maximal-implies |
                    isAMaximalCommonDivisorUpTo(d, s, n) ->
                      aQuotientSequenceFor(d, s, q, n) ->
                      theQuotientsAreCoprime(q, n)
                    [by discharge given-d-is-maximal]
                }
              @discharge-n |
                forall n9: Nat;
                  isAMaximalCommonDivisorUpTo(d, s, n9) ->
                  aQuotientSequenceFor(d, s, q, n9) ->
                  theQuotientsAreCoprime(q, n9)
                [by generalize generalize-n]
            }
          @discharge-q |
            forall q9: QSeq; forall n9: Nat;
              isAMaximalCommonDivisorUpTo(d, s, n9) ->
              aQuotientSequenceFor(d, s, q9, n9) ->
              theQuotientsAreCoprime(q9, n9)
            [by generalize generalize-q]
        }
      @discharge-s |
        forall s9: QSeq; forall q9: QSeq; forall n9: Nat;
          isAMaximalCommonDivisorUpTo(d, s9, n9) ->
          aQuotientSequenceFor(d, s9, q9, n9) ->
          theQuotientsAreCoprime(q9, n9)
        [by generalize generalize-s]
    }
  @conclusion |
    forall d: Q; forall s, q: QSeq; forall n: Nat;
      isAMaximalCommonDivisorUpTo(d, s, n) ->
      aQuotientSequenceFor(d, s, q, n) ->
      theQuotientsAreCoprime(q, n)
    [by generalize generalize-d]
qed

// -- THE QUOTIENT SEQUENCE AT A LOCALLY BOUND DIVISOR -------------------------------------
// The piece the mixed-sort lambda (`2f9c535`) unblocked. `anIndexPinnedChoiceIsRealized`'s
// spec relates an INDEX to a VALUE (`Nat` and `Q`), so instantiating it needs a two-sort
// lambda; without one the only route was a bare predicate name, which forces the subject
// pinned as a file-scope nullary func and so works at exactly ONE divisor — while the descent
// needs it at a divisor bound inside the proof.
//
// BOUNDED PREMISE. The caller has divisibility only BELOW n (that is what coprimality gives),
// so the spec's equation clause is CONDITIONAL on being in range: that makes the spec
// satisfiable at every index — above n, ONE serves — which is what the choice schema's
// unbounded witness hypothesis requires. Same technique as
// `theClearedNumeratorSequenceExists`; an earlier version demanded unbounded divisibility and
// no caller could supply it.
theorem theQuotientSequenceByADivisorExists: forall q: QSeq; forall e: Q; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e, qat(q, i))) ->
  (exists t: QSeq; forall i: Nat; nat_less_than(i, n) ->
  (isInteger(qat(t, i)) and qat(q, i) = rational.mul(e, qat(t, i))))
proof
  @generalize-q |
    fix q: QSeq {
      @generalize-e |
        fix e: Q {
          @generalize-n |
            fix n: Nat {
              @given-divides-below |
                assume forall i: Nat; nat_less_than(i, n) ->
                  dividesIntegrally(e, qat(q, i)) {
                  @divides-below |
                    forall i: Nat; nat_less_than(i, n) ->
                      dividesIntegrally(e, qat(q, i))
                    [by hypothesis given-divides-below]
                  @one-is-an-integer |
                    isInteger(ONE)
                    [by cite rational.oneIsAnInteger]
                  @each-index |
                    fix i: Nat {
                      @given-i-below |
                        assume nat_less_than(i, n) {
                          @i-below |
                            nat_less_than(i, n)
                            [by hypothesis given-i-below]
                          @divides-here |
                            dividesIntegrally(e, qat(q, i))
                            [using specialize divides-below(i) i-below]
                          @the-meaning |
                            dividesIntegrally(e, qat(q, i)) iff
                              (exists k: Q; isInteger(k) and
                              qat(q, i) = rational.mul(e, k))
                            [using specialize dividesIntegrallyMeaning(e, qat(q, i))]
                          @a-quotient |
                            exists k: Q; isInteger(k) and
                              qat(q, i) = rational.mul(e, k)
                            [using tautology the-meaning divides-here]
                          @with-the-quotient |
                            unpack k: Q from a-quotient {
                              @with-quotient-k |
                                isInteger(k) and
                                  qat(q, i) = rational.mul(e, k)
                                [by hypothesis with-the-quotient]
                              @k-is-an-integer |
                                isInteger(k)
                                [by and_lhs with-quotient-k]
                              @the-equation |
                                qat(q, i) = rational.mul(e, k)
                                [by and_rhs with-quotient-k]
                              @the-guarded-equation |
                                nat_less_than(i, n) ->
                                  qat(q, i) = rational.mul(e, k)
                                [using tautology the-equation]
                              @the-witness-works |
                                isInteger(k) and
                                  (nat_less_than(i, n) ->
                                  qat(q, i) = rational.mul(e, k))
                                [by both k-is-an-integer the-guarded-equation]
                              @conclusion-in-range |
                                exists v: Q;
                                  (isInteger(v) and
                                  (nat_less_than(i, n) ->
                                  qat(q, i) = rational.mul(e, v)))
                                [by witness(k) the-witness-works]
                            }
                          @conclusion-in-range-exported |
                            exists v: Q;
                              (isInteger(v) and
                              (nat_less_than(i, n) ->
                              qat(q, i) = rational.mul(e, v)))
                            [by unpacked with-the-quotient]
                        }
                      @in-range-implies |
                        nat_less_than(i, n) ->
                          (exists v: Q;
                          (isInteger(v) and
                          (nat_less_than(i, n) ->
                          qat(q, i) = rational.mul(e, v))))
                        [by discharge given-i-below]
                      @given-i-out-of-range |
                        assume not nat_less_than(i, n) {
                          @i-out-of-range |
                            not nat_less_than(i, n)
                            [by hypothesis given-i-out-of-range]
                          @the-clause-is-vacuous |
                            nat_less_than(i, n) ->
                              qat(q, i) = rational.mul(e, ONE)
                            [using tautology i-out-of-range]
                          @one-works |
                            isInteger(ONE) and
                              (nat_less_than(i, n) ->
                              qat(q, i) = rational.mul(e, ONE))
                            [by both one-is-an-integer the-clause-is-vacuous]
                          @conclusion-out-of-range |
                            exists v: Q;
                              (isInteger(v) and
                              (nat_less_than(i, n) ->
                              qat(q, i) = rational.mul(e, v)))
                            [by witness(ONE) one-works]
                        }
                      @out-of-range-implies |
                        (not nat_less_than(i, n)) ->
                          (exists v: Q;
                          (isInteger(v) and
                          (nat_less_than(i, n) ->
                          qat(q, i) = rational.mul(e, v))))
                        [by discharge given-i-out-of-range]
                      @conclusion-at-i |
                        exists v: Q;
                          (isInteger(v) and
                          (nat_less_than(i, n) ->
                          qat(q, i) = rational.mul(e, v)))
                        [using tautology in-range-implies out-of-range-implies]
                    }
                  @the-witnesses |
                    forall i: Nat; exists v: Q;
                      (isInteger(v) and
                      (nat_less_than(i, n) ->
                      qat(q, i) = rational.mul(e, v)))
                    [by generalize each-index]
                  @the-sequences |
                    forall m: Nat; exists t: QSeq; forall i: Nat;
                      nat_less_than(i, m) ->
                      (isInteger(qat(t, i)) and
                      (nat_less_than(i, n) ->
                      qat(q, i) = rational.mul(e, qat(t, i))))
                    [using instantiation anIndexPinnedChoiceIsRealized(fun i: Nat, v: Q => (isInteger(v) and (nat_less_than(i, n) -> qat(q, i) = rational.mul(e, v)))) the-witnesses]
                  @at-this-bound |
                    exists t: QSeq; forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(t, i)) and
                      (nat_less_than(i, n) ->
                      qat(q, i) = rational.mul(e, qat(t, i))))
                    [using specialize the-sequences(n)]
                  @conclusion-unguarded |
                    unpack t: QSeq from at-this-bound {
                      @the-guarded-match |
                        forall i: Nat; nat_less_than(i, n) ->
                          (isInteger(qat(t, i)) and
                          (nat_less_than(i, n) ->
                          qat(q, i) = rational.mul(e, qat(t, i))))
                        [by hypothesis conclusion-unguarded]
                      @each-in-range |
                        fix i: Nat {
                          @given-i-below |
                            assume nat_less_than(i, n) {
                              @i-below |
                                nat_less_than(i, n)
                                [by hypothesis given-i-below]
                              @the-guarded-at-i |
                                isInteger(qat(t, i)) and
                                  (nat_less_than(i, n) ->
                                  qat(q, i) = rational.mul(e, qat(t, i)))
                                [using specialize the-guarded-match(i) i-below]
                              @conclusion-unguarded-at-i |
                                isInteger(qat(t, i)) and
                                  qat(q, i) = rational.mul(e, qat(t, i))
                                [using tautology the-guarded-at-i i-below]
                            }
                          @below-implies |
                            nat_less_than(i, n) ->
                              (isInteger(qat(t, i)) and
                              qat(q, i) = rational.mul(e, qat(t, i)))
                            [by discharge given-i-below]
                        }
                      @all-unguarded |
                        forall i: Nat; nat_less_than(i, n) ->
                          (isInteger(qat(t, i)) and
                          qat(q, i) = rational.mul(e, qat(t, i)))
                        [by generalize each-in-range]
                      @conclusion-witnessed |
                        exists t2: QSeq; forall i: Nat;
                          nat_less_than(i, n) ->
                          (isInteger(qat(t2, i)) and
                          qat(q, i) = rational.mul(e, qat(t2, i)))
                        [by witness(t) all-unguarded]
                    }
                  @the-sequence-exported |
                    exists t: QSeq; forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(t, i)) and
                      qat(q, i) = rational.mul(e, qat(t, i)))
                    [by unpacked conclusion-unguarded]
                }
              @the-implication |
                (forall i: Nat; nat_less_than(i, n) ->
                  dividesIntegrally(e, qat(q, i))) ->
                  (exists t: QSeq; forall i: Nat; nat_less_than(i, n) ->
                  (isInteger(qat(t, i)) and
                  qat(q, i) = rational.mul(e, qat(t, i))))
                [by discharge given-divides-below]
            }
          @discharge-n |
            forall n9: Nat;
              (forall i: Nat; nat_less_than(i, n9) ->
              dividesIntegrally(e, qat(q, i))) ->
              (exists t: QSeq; forall i: Nat; nat_less_than(i, n9) ->
              (isInteger(qat(t, i)) and
              qat(q, i) = rational.mul(e, qat(t, i))))
            [by generalize generalize-n]
        }
      @discharge-e |
        forall e9: Q; forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          dividesIntegrally(e9, qat(q, i))) ->
          (exists t: QSeq; forall i: Nat; nat_less_than(i, n9) ->
          (isInteger(qat(t, i)) and
          qat(q, i) = rational.mul(e9, qat(t, i))))
        [by generalize generalize-e]
    }
  @conclusion |
    forall q: QSeq; forall e: Q; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) ->
      dividesIntegrally(e, qat(q, i))) ->
      (exists t: QSeq; forall i: Nat; nat_less_than(i, n) ->
      (isInteger(qat(t, i)) and qat(q, i) = rational.mul(e, qat(t, i))))
    [by generalize generalize-q]
qed

// -- THE MINIMALITY ASSEMBLY --------------------------------------------------------------
// Divisor existence, closing Lemma 17.12's construction.
//
// Well-order on the FIRST QUOTIENT: `aFirstQuotientOf(s, n, m)` says some positive integer
// common divisor of s's entries below n leaves m as the quotient at index ZERO. It is
// inhabited (ONE leaves s_0 itself), so well-ordering gives a LEAST such m with its divisor —
// and the quotients by THAT divisor are coprime, since a non-unit common divisor of them would
// give a strictly smaller first quotient.

// "m is the first quotient of some positive-integer common divisor of s below n."
pred aFirstQuotientOf(s: QSeq, n: Nat, m: Q)
axiom firstQuotientMeaning: forall s: QSeq; forall n: Nat; forall m: Q;
  aFirstQuotientOf(s, n, m) iff
  (exists d: Q; exists q: QSeq;
  isInteger(d) and less_than(ZERO, d) and
  isACommonDivisorUpTo(d, s, n) and
  aQuotientSequenceFor(d, s, q, n) and
  qat(q, NAT_ZERO) = m)

// A positive integer divisor with its quotient sequence witnesses its own first quotient —
// the packaging the descent and the inhabitation both read.
theorem aDivisorWitnessesItsFirstQuotient: forall s, q: QSeq; forall n: Nat; forall d: Q;
  isInteger(d) -> less_than(ZERO, d) ->
  isACommonDivisorUpTo(d, s, n) -> aQuotientSequenceFor(d, s, q, n) ->
  aFirstQuotientOf(s, n, qat(q, NAT_ZERO))
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-q |
        fix q: QSeq {
          @generalize-n |
            fix n: Nat {
              @generalize-d |
                fix d: Q {
                  @given-the-parts |
                    assume isInteger(d) and less_than(ZERO, d) and
                      isACommonDivisorUpTo(d, s, n) and
                      aQuotientSequenceFor(d, s, q, n) {
                      @the-parts |
                        isInteger(d) and less_than(ZERO, d) and
                          isACommonDivisorUpTo(d, s, n) and
                          aQuotientSequenceFor(d, s, q, n)
                        [by hypothesis given-the-parts]
                      @the-first |
                        qat(q, NAT_ZERO) = qat(q, NAT_ZERO)
                        [by reflexivity]
                      @the-full-witness |
                        isInteger(d) and less_than(ZERO, d) and
                          isACommonDivisorUpTo(d, s, n) and
                          aQuotientSequenceFor(d, s, q, n) and
                          qat(q, NAT_ZERO) = qat(q, NAT_ZERO)
                        [using tautology the-parts the-first]
                      @the-sequence-witness |
                        exists q2: QSeq;
                          isInteger(d) and less_than(ZERO, d) and
                          isACommonDivisorUpTo(d, s, n) and
                          aQuotientSequenceFor(d, s, q2, n) and
                          qat(q2, NAT_ZERO) = qat(q, NAT_ZERO)
                        [by witness(q) the-full-witness]
                      @the-divisor-witness |
                        exists d2: Q; exists q2: QSeq;
                          isInteger(d2) and less_than(ZERO, d2) and
                          isACommonDivisorUpTo(d2, s, n) and
                          aQuotientSequenceFor(d2, s, q2, n) and
                          qat(q2, NAT_ZERO) = qat(q, NAT_ZERO)
                        [by witness(d) the-sequence-witness]
                      @the-meaning |
                        aFirstQuotientOf(s, n, qat(q, NAT_ZERO)) iff
                          (exists d2: Q; exists q2: QSeq;
                          isInteger(d2) and less_than(ZERO, d2) and
                          isACommonDivisorUpTo(d2, s, n) and
                          aQuotientSequenceFor(d2, s, q2, n) and
                          qat(q2, NAT_ZERO) = qat(q, NAT_ZERO))
                        [using specialize firstQuotientMeaning(s, n, qat(q, NAT_ZERO))]
                      @conclusion-witnessed |
                        aFirstQuotientOf(s, n, qat(q, NAT_ZERO))
                        [using tautology the-meaning the-divisor-witness]
                    }
                  @the-implication |
                    (isInteger(d) and less_than(ZERO, d) and
                      isACommonDivisorUpTo(d, s, n) and
                      aQuotientSequenceFor(d, s, q, n)) ->
                      aFirstQuotientOf(s, n, qat(q, NAT_ZERO))
                    [by discharge given-the-parts]
                  @curried |
                    isInteger(d) -> less_than(ZERO, d) ->
                      isACommonDivisorUpTo(d, s, n) ->
                      aQuotientSequenceFor(d, s, q, n) ->
                      aFirstQuotientOf(s, n, qat(q, NAT_ZERO))
                    [using tautology the-implication]
                }
              @discharge-d |
                forall d9: Q;
                  isInteger(d9) -> less_than(ZERO, d9) ->
                  isACommonDivisorUpTo(d9, s, n) ->
                  aQuotientSequenceFor(d9, s, q, n) ->
                  aFirstQuotientOf(s, n, qat(q, NAT_ZERO))
                [by generalize generalize-d]
            }
          @discharge-n |
            forall n9: Nat; forall d9: Q;
              isInteger(d9) -> less_than(ZERO, d9) ->
              isACommonDivisorUpTo(d9, s, n9) ->
              aQuotientSequenceFor(d9, s, q, n9) ->
              aFirstQuotientOf(s, n9, qat(q, NAT_ZERO))
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q9: QSeq; forall n9: Nat; forall d9: Q;
          isInteger(d9) -> less_than(ZERO, d9) ->
          isACommonDivisorUpTo(d9, s, n9) ->
          aQuotientSequenceFor(d9, s, q9, n9) ->
          aFirstQuotientOf(s, n9, qat(q9, NAT_ZERO))
        [by generalize generalize-q]
    }
  @conclusion |
    forall s, q: QSeq; forall n: Nat; forall d: Q;
      isInteger(d) -> less_than(ZERO, d) ->
      isACommonDivisorUpTo(d, s, n) -> aQuotientSequenceFor(d, s, q, n) ->
      aFirstQuotientOf(s, n, qat(q, NAT_ZERO))
    [by generalize generalize-s]
qed

// Two scalings compose: entry = d·q_i and q_i = e·t_i give entry = (d·e)·t_i.
theorem theDoubleScalingComposes: forall s, q, t: QSeq; forall n: Nat; forall d, e: Q;
  (forall i: Nat; nat_less_than(i, n) ->
  qat(s, i) = rational.mul(d, qat(q, i))) ->
  (forall i: Nat; nat_less_than(i, n) ->
  (isInteger(qat(t, i)) and qat(q, i) = rational.mul(e, qat(t, i)))) ->
  forall i: Nat; nat_less_than(i, n) ->
  qat(s, i) = rational.mul(rational.mul(d, e), qat(t, i))
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-q |
        fix q: QSeq {
          @generalize-t |
            fix t: QSeq {
              @generalize-n |
                fix n: Nat {
                  @generalize-d |
                    fix d: Q {
                      @generalize-e |
                        fix e: Q {
                          @given-both |
                            assume (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) and
                              (forall i: Nat; nat_less_than(i, n) ->
                              (isInteger(qat(t, i)) and
                              qat(q, i) = rational.mul(e, qat(t, i)))) {
                              @both |
                                (forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(d, qat(q, i))) and
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  (isInteger(qat(t, i)) and
                                  qat(q, i) = rational.mul(e, qat(t, i))))
                                [by hypothesis given-both]
                              @outer |
                                forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(d, qat(q, i))
                                [by and_lhs both]
                              @inner |
                                forall i: Nat; nat_less_than(i, n) ->
                                  (isInteger(qat(t, i)) and
                                  qat(q, i) = rational.mul(e, qat(t, i)))
                                [by and_rhs both]
                              @each-index |
                                fix i: Nat {
                                  @given-i-below |
                                    assume nat_less_than(i, n) {
                                      @i-below |
                                        nat_less_than(i, n)
                                        [by hypothesis given-i-below]
                                      @the-outer-at-i |
                                        qat(s, i) = rational.mul(d, qat(q, i))
                                        [using specialize outer(i) i-below]
                                      @the-inner-at-i |
                                        isInteger(qat(t, i)) and
                                          qat(q, i) = rational.mul(e, qat(t, i))
                                        [using specialize inner(i) i-below]
                                      @the-inner-equation |
                                        qat(q, i) = rational.mul(e, qat(t, i))
                                        [by and_rhs the-inner-at-i]
                                      @substituted |
                                        qat(s, i) =
                                          rational.mul(d, rational.mul(e, qat(t, i)))
                                        [by rewrite the-inner-equation the-outer-at-i]
                                      @reassociate |
                                        rational.mul(rational.mul(d, e), qat(t, i)) =
                                          rational.mul(d, rational.mul(e, qat(t, i)))
                                        [using specialize rational.mulIsAssociative(d, e, qat(t, i))]
                                      @conclusion-at-i |
                                        qat(s, i) =
                                          rational.mul(rational.mul(d, e), qat(t, i))
                                        [by rewrite reassociate substituted]
                                    }
                                  @below-implies |
                                    nat_less_than(i, n) ->
                                      qat(s, i) =
                                      rational.mul(rational.mul(d, e), qat(t, i))
                                    [by discharge given-i-below]
                                }
                              @conclusion-all |
                                forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) =
                                  rational.mul(rational.mul(d, e), qat(t, i))
                                [by generalize each-index]
                            }
                          @the-implication |
                            ((forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) and
                              (forall i: Nat; nat_less_than(i, n) ->
                              (isInteger(qat(t, i)) and
                              qat(q, i) = rational.mul(e, qat(t, i))))) ->
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) =
                              rational.mul(rational.mul(d, e), qat(t, i)))
                            [by discharge given-both]
                          @curried |
                            (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) ->
                              (forall i: Nat; nat_less_than(i, n) ->
                              (isInteger(qat(t, i)) and
                              qat(q, i) = rational.mul(e, qat(t, i)))) ->
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) =
                              rational.mul(rational.mul(d, e), qat(t, i)))
                            [using tautology the-implication]
                        }
                      @discharge-e |
                        forall e9: Q;
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          (isInteger(qat(t, i)) and
                          qat(q, i) = rational.mul(e9, qat(t, i)))) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) =
                          rational.mul(rational.mul(d, e9), qat(t, i)))
                        [by generalize generalize-e]
                    }
                  @discharge-d |
                    forall d9: Q; forall e9: Q;
                      (forall i: Nat; nat_less_than(i, n) ->
                      qat(s, i) = rational.mul(d9, qat(q, i))) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(t, i)) and
                      qat(q, i) = rational.mul(e9, qat(t, i)))) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      qat(s, i) =
                      rational.mul(rational.mul(d9, e9), qat(t, i)))
                    [by generalize generalize-d]
                }
              @discharge-n |
                forall n9: Nat; forall d9: Q; forall e9: Q;
                  (forall i: Nat; nat_less_than(i, n9) ->
                  qat(s, i) = rational.mul(d9, qat(q, i))) ->
                  (forall i: Nat; nat_less_than(i, n9) ->
                  (isInteger(qat(t, i)) and
                  qat(q, i) = rational.mul(e9, qat(t, i)))) ->
                  (forall i: Nat; nat_less_than(i, n9) ->
                  qat(s, i) =
                  rational.mul(rational.mul(d9, e9), qat(t, i)))
                [by generalize generalize-n]
            }
          @discharge-t |
            forall t9: QSeq; forall n9: Nat; forall d9: Q; forall e9: Q;
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(s, i) = rational.mul(d9, qat(q, i))) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              (isInteger(qat(t9, i)) and
              qat(q, i) = rational.mul(e9, qat(t9, i)))) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(s, i) =
              rational.mul(rational.mul(d9, e9), qat(t9, i)))
            [by generalize generalize-t]
        }
      @discharge-q |
        forall q9: QSeq; forall t9: QSeq; forall n9: Nat; forall d9: Q; forall e9: Q;
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(s, i) = rational.mul(d9, qat(q9, i))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          (isInteger(qat(t9, i)) and
          qat(q9, i) = rational.mul(e9, qat(t9, i)))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(s, i) =
          rational.mul(rational.mul(d9, e9), qat(t9, i)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall s, q, t: QSeq; forall n: Nat; forall d, e: Q;
      (forall i: Nat; nat_less_than(i, n) ->
      qat(s, i) = rational.mul(d, qat(q, i))) ->
      (forall i: Nat; nat_less_than(i, n) ->
      (isInteger(qat(t, i)) and qat(q, i) = rational.mul(e, qat(t, i)))) ->
      forall i: Nat; nat_less_than(i, n) ->
      qat(s, i) = rational.mul(rational.mul(d, e), qat(t, i))
    [by generalize generalize-s]
qed

// A per-index factorization IS a quotient sequence — unfolding the predicate.
theorem theFactorizationIsAQuotientSequence: forall d: Q; forall s, t: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) ->
  qat(s, i) = rational.mul(d, qat(t, i))) ->
  aQuotientSequenceFor(d, s, t, n)
proof
  @generalize-d |
    fix d: Q {
      @generalize-s |
        fix s: QSeq {
          @generalize-t |
            fix t: QSeq {
              @generalize-n |
                fix n: Nat {
                  @given-the-factorization |
                    assume forall i: Nat; nat_less_than(i, n) ->
                      qat(s, i) = rational.mul(d, qat(t, i)) {
                      @the-factorization |
                        forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(t, i))
                        [by hypothesis given-the-factorization]
                      @the-meaning |
                        aQuotientSequenceFor(d, s, t, n) iff
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(t, i)))
                        [using specialize quotientSequenceMeaning(d, s, t, n)]
                      @conclusion-it-is |
                        aQuotientSequenceFor(d, s, t, n)
                        [using tautology the-meaning the-factorization]
                    }
                  @the-implication |
                    (forall i: Nat; nat_less_than(i, n) ->
                      qat(s, i) = rational.mul(d, qat(t, i))) ->
                      aQuotientSequenceFor(d, s, t, n)
                    [by discharge given-the-factorization]
                }
              @discharge-n |
                forall n9: Nat;
                  (forall i: Nat; nat_less_than(i, n9) ->
                  qat(s, i) = rational.mul(d, qat(t, i))) ->
                  aQuotientSequenceFor(d, s, t, n9)
                [by generalize generalize-n]
            }
          @discharge-t |
            forall t9: QSeq; forall n9: Nat;
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(s, i) = rational.mul(d, qat(t9, i))) ->
              aQuotientSequenceFor(d, s, t9, n9)
            [by generalize generalize-t]
        }
      @discharge-s |
        forall s9: QSeq; forall t9: QSeq; forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(s9, i) = rational.mul(d, qat(t9, i))) ->
          aQuotientSequenceFor(d, s9, t9, n9)
        [by generalize generalize-s]
    }
  @conclusion |
    forall d: Q; forall s, t: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) ->
      qat(s, i) = rational.mul(d, qat(t, i))) ->
      aQuotientSequenceFor(d, s, t, n)
    [by generalize generalize-d]
qed

// A quotient sequence makes its divisor a common divisor: entry = d·t_i exhibits the quotient.
// The quotient entries must be INTEGERS for the divisor to divide INTEGRALLY — a quotient
// sequence alone says `entry = d * t_i`, which over ℚ holds for any d at all.
theorem aQuotientSequenceMakesACommonDivisor:
  forall d: Q; forall s, t: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i))) ->
  aQuotientSequenceFor(d, s, t, n) -> isACommonDivisorUpTo(d, s, n)
proof
  @generalize-d |
    fix d: Q {
      @generalize-s |
        fix s: QSeq {
          @generalize-t |
            fix t: QSeq {
              @generalize-n |
                fix n: Nat {
                  @given-the-integrality |
                    assume forall i: Nat; nat_less_than(i, n) ->
                      isInteger(qat(t, i)) {
                      @the-integrality |
                        forall i: Nat; nat_less_than(i, n) ->
                          isInteger(qat(t, i))
                        [by hypothesis given-the-integrality]
                      @given-the-quotients |
                        assume aQuotientSequenceFor(d, s, t, n) {
                          @the-quotients |
                            aQuotientSequenceFor(d, s, t, n)
                            [by hypothesis given-the-quotients]
                          @the-quotient-meaning |
                            aQuotientSequenceFor(d, s, t, n) iff
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(t, i)))
                            [using specialize quotientSequenceMeaning(d, s, t, n)]
                          @the-factorization |
                            forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(t, i))
                            [using tautology the-quotient-meaning the-quotients]
                          @each-divided |
                            fix i: Nat {
                              @given-i-below |
                                assume nat_less_than(i, n) {
                                  @i-below |
                                    nat_less_than(i, n)
                                    [by hypothesis given-i-below]
                                  @the-entry |
                                    qat(s, i) = rational.mul(d, qat(t, i))
                                    [using specialize the-factorization(i) i-below]
                                  @the-quotient-is-an-integer |
                                    isInteger(qat(t, i))
                                    [using specialize the-integrality(i) i-below]
                                  @the-product-commutes |
                                    rational.mul(d, qat(t, i)) =
                                      rational.mul(qat(t, i), d)
                                    [using specialize rational.mulIsCommutative(d, qat(t, i))]
                                  @the-entry-commuted |
                                    qat(s, i) = rational.mul(qat(t, i), d)
                                    [by rewrite the-product-commutes the-entry]
                                  @conclusion-divides-here |
                                    dividesIntegrally(d, qat(s, i))
                                    [using specialize aFactorDividesTheProduct(d, qat(t, i), qat(s, i)) the-quotient-is-an-integer the-entry-commuted]
                                }
                              @below-implies |
                                nat_less_than(i, n) -> dividesIntegrally(d, qat(s, i))
                                [by discharge given-i-below]
                            }
                          @all-divided |
                            forall i: Nat; nat_less_than(i, n) ->
                              dividesIntegrally(d, qat(s, i))
                            [by generalize each-divided]
                          @the-divisor-meaning |
                            isACommonDivisorUpTo(d, s, n) iff
                              (forall i: Nat; nat_less_than(i, n) ->
                              dividesIntegrally(d, qat(s, i)))
                            [using specialize commonDivisorMeaning(d, s, n)]
                          @conclusion-common |
                            isACommonDivisorUpTo(d, s, n)
                            [using tautology the-divisor-meaning all-divided]
                        }
                      @the-implication |
                        aQuotientSequenceFor(d, s, t, n) ->
                          isACommonDivisorUpTo(d, s, n)
                        [by discharge given-the-quotients]
                    }
                  @the-full-implication |
                    (forall i: Nat; nat_less_than(i, n) ->
                      isInteger(qat(t, i))) ->
                      aQuotientSequenceFor(d, s, t, n) ->
                      isACommonDivisorUpTo(d, s, n)
                    [by discharge given-the-integrality]
                }
              @discharge-n |
                forall n9: Nat;
                  (forall i: Nat; nat_less_than(i, n9) ->
                  isInteger(qat(t, i))) ->
                  aQuotientSequenceFor(d, s, t, n9) ->
                  isACommonDivisorUpTo(d, s, n9)
                [by generalize generalize-n]
            }
          @discharge-t |
            forall t9: QSeq; forall n9: Nat;
              (forall i: Nat; nat_less_than(i, n9) ->
              isInteger(qat(t9, i))) ->
              aQuotientSequenceFor(d, s, t9, n9) ->
              isACommonDivisorUpTo(d, s, n9)
            [by generalize generalize-t]
        }
      @discharge-s |
        forall s9: QSeq; forall t9: QSeq; forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          isInteger(qat(t9, i))) ->
          aQuotientSequenceFor(d, s9, t9, n9) ->
          isACommonDivisorUpTo(d, s9, n9)
        [by generalize generalize-s]
    }
  @conclusion |
    forall d: Q; forall s, t: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i))) ->
      aQuotientSequenceFor(d, s, t, n) -> isACommonDivisorUpTo(d, s, n)
    [by generalize generalize-d]
qed

// Project the integrality half out of the quotient-sequence conjunction.
theorem theIntegralityHalf: forall q, t: QSeq; forall n: Nat; forall e: Q;
  (forall i: Nat; nat_less_than(i, n) ->
  (isInteger(qat(t, i)) and qat(q, i) = rational.mul(e, qat(t, i)))) ->
  forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i))
proof
  @generalize-q |
    fix q: QSeq {
      @generalize-t |
        fix t: QSeq {
          @generalize-n |
            fix n: Nat {
              @generalize-e |
                fix e: Q {
                  @given-the-pairs |
                    assume forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(t, i)) and
                      qat(q, i) = rational.mul(e, qat(t, i))) {
                      @the-pairs |
                        forall i: Nat; nat_less_than(i, n) ->
                          (isInteger(qat(t, i)) and
                          qat(q, i) = rational.mul(e, qat(t, i)))
                        [by hypothesis given-the-pairs]
                      @each-index |
                        fix i: Nat {
                          @given-i-below |
                            assume nat_less_than(i, n) {
                              @i-below |
                                nat_less_than(i, n)
                                [by hypothesis given-i-below]
                              @the-pair-at-i |
                                isInteger(qat(t, i)) and
                                  qat(q, i) = rational.mul(e, qat(t, i))
                                [using specialize the-pairs(i) i-below]
                              @conclusion-integer-at-i |
                                isInteger(qat(t, i))
                                [by and_lhs the-pair-at-i]
                            }
                          @below-implies |
                            nat_less_than(i, n) -> isInteger(qat(t, i))
                            [by discharge given-i-below]
                        }
                      @conclusion-all |
                        forall i: Nat; nat_less_than(i, n) ->
                          isInteger(qat(t, i))
                        [by generalize each-index]
                    }
                  @the-implication |
                    (forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(t, i)) and
                      qat(q, i) = rational.mul(e, qat(t, i)))) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      isInteger(qat(t, i)))
                    [by discharge given-the-pairs]
                }
              @discharge-e |
                forall e9: Q;
                  (forall i: Nat; nat_less_than(i, n) ->
                  (isInteger(qat(t, i)) and
                  qat(q, i) = rational.mul(e9, qat(t, i)))) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  isInteger(qat(t, i)))
                [by generalize generalize-e]
            }
          @discharge-n |
            forall n9: Nat; forall e9: Q;
              (forall i: Nat; nat_less_than(i, n9) ->
              (isInteger(qat(t, i)) and
              qat(q, i) = rational.mul(e9, qat(t, i)))) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              isInteger(qat(t, i)))
            [by generalize generalize-n]
        }
      @discharge-t |
        forall t9: QSeq; forall n9: Nat; forall e9: Q;
          (forall i: Nat; nat_less_than(i, n9) ->
          (isInteger(qat(t9, i)) and
          qat(q, i) = rational.mul(e9, qat(t9, i)))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          isInteger(qat(t9, i)))
        [by generalize generalize-t]
    }
  @conclusion |
    forall q, t: QSeq; forall n: Nat; forall e: Q;
      (forall i: Nat; nat_less_than(i, n) ->
      (isInteger(qat(t, i)) and qat(q, i) = rational.mul(e, qat(t, i)))) ->
      forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i))
    [by generalize generalize-q]
qed
// -- THE DESCENT STEP ---------------------------------------------------------------------
// A non-unit common divisor of the quotients yields a STRICTLY SMALLER first quotient. This is
// what contradicts leastness, and so what makes the minimal first quotient's divisor leave
// coprime quotients.
//
// Given d (positive integer, dividing every entry) with quotients q, and a positive non-unit
// integer e dividing every q_i: take t with q_i = e·t_i. Then d·e divides every entry
// (entry_i = d·q_i = d·(e·t_i) = (d·e)·t_i), so d·e is a divisor whose first quotient is t_0 —
// and t_0 < q_0 because q_0 = e·t_0 with e > 1.
//
// `nat_less_than(NAT_ZERO, n)` is load-bearing, not bookkeeping: index ZERO must be in range
// or "the first quotient" names nothing and the descent has no floor. Judson has it implicitly,
// anchoring on an actual coefficient.
theorem aNonUnitDivisorGivesASmallerFirstQuotient:
  forall s, q: QSeq; forall n: Nat; forall d, e: Q;
  nat_less_than(NAT_ZERO, n) ->
  isInteger(d) -> less_than(ZERO, d) ->
  (forall i: Nat; nat_less_than(i, n) ->
  qat(s, i) = rational.mul(d, qat(q, i))) ->
  less_than(ZERO, qat(q, NAT_ZERO)) ->
  isInteger(e) -> less_than(ZERO, e) ->
  (not dividesIntegrally(e, ONE)) ->
  (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e, qat(q, i))) ->
  (exists smaller: Q;
  aFirstQuotientOf(s, n, smaller) and less_than(smaller, qat(q, NAT_ZERO)))
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-q |
        fix q: QSeq {
          @generalize-n |
            fix n: Nat {
              @generalize-d |
                fix d: Q {
                  @generalize-e |
                    fix e: Q {
                      @given-the-setup |
                        assume nat_less_than(NAT_ZERO, n) and isInteger(d) and
                          less_than(ZERO, d) and
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) and
                          less_than(ZERO, qat(q, NAT_ZERO)) and
                          isInteger(e) and less_than(ZERO, e) and
                          (not dividesIntegrally(e, ONE)) and
                          (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e, qat(q, i))) {
                          @the-setup |
                            nat_less_than(NAT_ZERO, n) and isInteger(d) and
                              less_than(ZERO, d) and
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) and
                              less_than(ZERO, qat(q, NAT_ZERO)) and
                              isInteger(e) and less_than(ZERO, e) and
                              (not dividesIntegrally(e, ONE)) and
                              (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e, qat(q, i)))
                            [by hypothesis given-the-setup]
                          @zero-in-range |
                            nat_less_than(NAT_ZERO, n)
                            [using tautology the-setup]
                          @d-is-an-integer |
                            isInteger(d)
                            [using tautology the-setup]
                          @d-positive |
                            less_than(ZERO, d)
                            [using tautology the-setup]
                          @the-factorization |
                            forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))
                            [using tautology the-setup]
                          @first-positive |
                            less_than(ZERO, qat(q, NAT_ZERO))
                            [using tautology the-setup]
                          @e-is-an-integer |
                            isInteger(e)
                            [using tautology the-setup]
                          @e-positive |
                            less_than(ZERO, e)
                            [using tautology the-setup]
                          @e-not-a-unit |
                            not dividesIntegrally(e, ONE)
                            [using tautology the-setup]
                          @e-divides-all |
                            forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e, qat(q, i))
                            [using tautology the-setup]

                          // the e-quotients of q, at a divisor bound right here
                          @at-this-bound |
                            exists t: QSeq; forall i: Nat;
                              nat_less_than(i, n) ->
                              (isInteger(qat(t, i)) and
                              qat(q, i) = rational.mul(e, qat(t, i)))
                            [using specialize theQuotientSequenceByADivisorExists(q, e, n) e-divides-all]
                          @with-the-quotients |
                            unpack t: QSeq from at-this-bound {
                              @the-quotients |
                                forall i: Nat; nat_less_than(i, n) ->
                                  (isInteger(qat(t, i)) and
                                  qat(q, i) = rational.mul(e, qat(t, i)))
                                [by hypothesis with-the-quotients]
                              // d·e is a positive integer
                              @the-product-is-an-integer |
                                isInteger(rational.mul(d, e))
                                [using specialize rational.isIntegerMul(d, e) d-is-an-integer e-is-an-integer]
                              @positive-products |
                                forall x, y: Q;
                                  less_than(ZERO, x) -> less_than(ZERO, y) ->
                                  less_than(ZERO, rational.mul(x, y))
                                [by cite rational.positiveProduct]
                              @the-product-positive |
                                less_than(ZERO, rational.mul(d, e))
                                [using specialize positive-products(d, e) d-positive e-positive]
                              // entry_i = (d·e)·t_i, below n
                              @the-scaled-factorization |
                                forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(rational.mul(d, e), qat(t, i))
                                [using specialize theDoubleScalingComposes(s, q, t, n, d, e) the-factorization the-quotients]
                              @the-scaled-quotients |
                                aQuotientSequenceFor(rational.mul(d, e), s, t, n)
                                [using specialize theFactorizationIsAQuotientSequence(rational.mul(d, e), s, t, n) the-scaled-factorization]
                              @the-quotient-entries-are-integers |
                                forall i: Nat; nat_less_than(i, n) ->
                                  isInteger(qat(t, i))
                                [using specialize theIntegralityHalf(q, t, n, e) the-quotients]
                              @the-scaled-divides |
                                isACommonDivisorUpTo(rational.mul(d, e), s, n)
                                [using specialize aQuotientSequenceMakesACommonDivisor(rational.mul(d, e), s, t, n) the-quotient-entries-are-integers the-scaled-quotients]
                              // t_0 is a first quotient of s
                              @t-zero-is-a-first-quotient |
                                aFirstQuotientOf(s, n, qat(t, NAT_ZERO))
                                [using specialize aDivisorWitnessesItsFirstQuotient(s, t, n, rational.mul(d, e)) the-product-is-an-integer the-product-positive the-scaled-divides the-scaled-quotients]
                              // and t_0 < q_0, since q_0 = e·t_0 with e a positive non-unit
                              @the-first-quotient |
                                isInteger(qat(t, NAT_ZERO)) and
                                  qat(q, NAT_ZERO) = rational.mul(e, qat(t, NAT_ZERO))
                                [using specialize the-quotients(NAT_ZERO) zero-in-range]
                              @the-first-equation |
                                qat(q, NAT_ZERO) = rational.mul(e, qat(t, NAT_ZERO))
                                [by and_rhs the-first-quotient]
                              @t-zero-is-smaller |
                                less_than(qat(t, NAT_ZERO), qat(q, NAT_ZERO))
                                [using specialize aNonUnitDivisorShrinksTheFirstQuotient(e, qat(q, NAT_ZERO), qat(t, NAT_ZERO)) e-is-an-integer e-positive e-not-a-unit first-positive the-first-equation]
                              @the-witness-works |
                                aFirstQuotientOf(s, n, qat(t, NAT_ZERO)) and
                                  less_than(qat(t, NAT_ZERO), qat(q, NAT_ZERO))
                                [by both t-zero-is-a-first-quotient t-zero-is-smaller]
                              @conclusion-a-smaller |
                                exists smaller: Q;
                                  aFirstQuotientOf(s, n, smaller) and
                                  less_than(smaller, qat(q, NAT_ZERO))
                                [by witness(qat(t, NAT_ZERO)) the-witness-works]
                            }
                          @conclusion-exported |
                            exists smaller: Q;
                              aFirstQuotientOf(s, n, smaller) and
                              less_than(smaller, qat(q, NAT_ZERO))
                            [by unpacked with-the-quotients]
                        }
                      @the-implication |
                        (nat_less_than(NAT_ZERO, n) and isInteger(d) and
                          less_than(ZERO, d) and
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) and
                          less_than(ZERO, qat(q, NAT_ZERO)) and
                          isInteger(e) and less_than(ZERO, e) and
                          (not dividesIntegrally(e, ONE)) and
                          (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e, qat(q, i)))) ->
                          (exists smaller: Q;
                          aFirstQuotientOf(s, n, smaller) and
                          less_than(smaller, qat(q, NAT_ZERO)))
                        [by discharge given-the-setup]
                      @curried |
                        nat_less_than(NAT_ZERO, n) ->
                          isInteger(d) -> less_than(ZERO, d) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) ->
                          less_than(ZERO, qat(q, NAT_ZERO)) ->
                          isInteger(e) -> less_than(ZERO, e) ->
                          (not dividesIntegrally(e, ONE)) ->
                          (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e, qat(q, i))) ->
                          (exists smaller: Q;
                          aFirstQuotientOf(s, n, smaller) and
                          less_than(smaller, qat(q, NAT_ZERO)))
                        [using tautology the-implication]
                    }
                  @discharge-e |
                    forall e9: Q;
                      nat_less_than(NAT_ZERO, n) ->
                      isInteger(d) -> less_than(ZERO, d) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      qat(s, i) = rational.mul(d, qat(q, i))) ->
                      less_than(ZERO, qat(q, NAT_ZERO)) ->
                      isInteger(e9) -> less_than(ZERO, e9) ->
                      (not dividesIntegrally(e9, ONE)) ->
                      (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e9, qat(q, i))) ->
                      (exists smaller: Q;
                      aFirstQuotientOf(s, n, smaller) and
                      less_than(smaller, qat(q, NAT_ZERO)))
                    [by generalize generalize-e]
                }
              @discharge-d |
                forall d9: Q; forall e9: Q;
                  nat_less_than(NAT_ZERO, n) ->
                  isInteger(d9) -> less_than(ZERO, d9) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  qat(s, i) = rational.mul(d9, qat(q, i))) ->
                  less_than(ZERO, qat(q, NAT_ZERO)) ->
                  isInteger(e9) -> less_than(ZERO, e9) ->
                  (not dividesIntegrally(e9, ONE)) ->
                  (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e9, qat(q, i))) ->
                  (exists smaller: Q;
                  aFirstQuotientOf(s, n, smaller) and
                  less_than(smaller, qat(q, NAT_ZERO)))
                [by generalize generalize-d]
            }
          @discharge-n |
            forall n9: Nat; forall d9: Q; forall e9: Q;
              nat_less_than(NAT_ZERO, n9) ->
              isInteger(d9) -> less_than(ZERO, d9) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(s, i) = rational.mul(d9, qat(q, i))) ->
              less_than(ZERO, qat(q, NAT_ZERO)) ->
              isInteger(e9) -> less_than(ZERO, e9) ->
              (not dividesIntegrally(e9, ONE)) ->
              (forall i: Nat; nat_less_than(i, n9) -> dividesIntegrally(e9, qat(q, i))) ->
              (exists smaller: Q;
              aFirstQuotientOf(s, n9, smaller) and
              less_than(smaller, qat(q, NAT_ZERO)))
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q9: QSeq; forall n9: Nat; forall d9: Q; forall e9: Q;
          nat_less_than(NAT_ZERO, n9) ->
          isInteger(d9) -> less_than(ZERO, d9) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(s, i) = rational.mul(d9, qat(q9, i))) ->
          less_than(ZERO, qat(q9, NAT_ZERO)) ->
          isInteger(e9) -> less_than(ZERO, e9) ->
          (not dividesIntegrally(e9, ONE)) ->
          (forall i: Nat; nat_less_than(i, n9) -> dividesIntegrally(e9, qat(q9, i))) ->
          (exists smaller: Q;
          aFirstQuotientOf(s, n9, smaller) and
          less_than(smaller, qat(q9, NAT_ZERO)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall s, q: QSeq; forall n: Nat; forall d, e: Q;
      nat_less_than(NAT_ZERO, n) ->
      isInteger(d) -> less_than(ZERO, d) ->
      (forall i: Nat; nat_less_than(i, n) ->
      qat(s, i) = rational.mul(d, qat(q, i))) ->
      less_than(ZERO, qat(q, NAT_ZERO)) ->
      isInteger(e) -> less_than(ZERO, e) ->
      (not dividesIntegrally(e, ONE)) ->
      (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e, qat(q, i))) ->
      (exists smaller: Q;
      aFirstQuotientOf(s, n, smaller) and less_than(smaller, qat(q, NAT_ZERO)))
    [by generalize generalize-s]
qed

// Inhabitation: ONE is a positive integer common divisor leaving s as its own quotient, so
// the first entry IS a first quotient — what well-ordering needs to start from.
theorem theFirstEntryIsAFirstQuotient: forall s: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
  aFirstQuotientOf(s, n, qat(s, NAT_ZERO))
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-n |
        fix n: Nat {
          @given-the-entries |
            assume forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i)) {
              @the-entries |
                forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))
                [by hypothesis given-the-entries]
              @one-works |
                isACommonDivisorUpTo(ONE, s, n) and
                  aQuotientSequenceFor(ONE, s, s, n)
                [using specialize theTrivialDivisorWorks(s, n) the-entries]
              @one-divides |
                isACommonDivisorUpTo(ONE, s, n)
                [by and_lhs one-works]
              @s-is-its-own-quotient |
                aQuotientSequenceFor(ONE, s, s, n)
                [by and_rhs one-works]
              @one-is-an-integer |
                isInteger(ONE)
                [by cite rational.oneIsAnInteger]
              @one-is-positive |
                less_than(ZERO, ONE)
                [using model(rational.RationalOrderedField) field_order.zeroLessThanOne]
              @conclusion-the-first-entry |
                aFirstQuotientOf(s, n, qat(s, NAT_ZERO))
                [using specialize aDivisorWitnessesItsFirstQuotient(s, s, n, ONE) one-is-an-integer one-is-positive one-divides s-is-its-own-quotient]
            }
          @the-implication |
            (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
              aFirstQuotientOf(s, n, qat(s, NAT_ZERO))
            [by discharge given-the-entries]
        }
      @discharge-n |
        forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) -> isInteger(qat(s, i))) ->
          aFirstQuotientOf(s, n9, qat(s, NAT_ZERO))
        [by generalize generalize-n]
    }
  @conclusion |
    forall s: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
      aFirstQuotientOf(s, n, qat(s, NAT_ZERO))
    [by generalize generalize-s]
qed

// -- LEMMA 17.12's DIVISOR EXISTS ---------------------------------------------------------
// THE ASSEMBLY. Well-order on the first quotient: the property is inhabited (ONE leaves s_0),
// so there is a LEAST first quotient, and the divisor achieving it leaves COPRIME quotients —
// a non-unit common divisor of them would give a strictly smaller first quotient
// (`aNonUnitDivisorGivesASmallerFirstQuotient`), contradicting leastness.
//
// Well-ordering is stated over `isNatural`, and a first quotient here is a positive integer,
// which `aPositiveIntegerIsNatural` makes natural — so the property is well-ordered as stated.
//
// This closes Lemma 17.12's construction: steps 3 and 4 take their divisor as a hypothesis,
// and this is its existence.
theorem aLeastFirstQuotientExists: forall s: QSeq; forall n: Nat;
  nat_less_than(NAT_ZERO, n) ->
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
  less_than(ZERO, qat(s, NAT_ZERO)) ->
  (exists least: Q; isNatural(least) and aFirstQuotientOf(s, n, least) and
  (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
  (not less_than(m, least))))
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-n |
        fix n: Nat {
          @given-the-setup |
            assume nat_less_than(NAT_ZERO, n) and
              (forall i: Nat; nat_less_than(i, n) ->
              isInteger(qat(s, i))) and
              less_than(ZERO, qat(s, NAT_ZERO)) {
              @the-setup |
                nat_less_than(NAT_ZERO, n) and
                  (forall i: Nat; nat_less_than(i, n) ->
                  isInteger(qat(s, i))) and
                  less_than(ZERO, qat(s, NAT_ZERO))
                [by hypothesis given-the-setup]
              @zero-in-range |
                nat_less_than(NAT_ZERO, n)
                [using tautology the-setup]
              @the-entries |
                forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))
                [using tautology the-setup]
              @first-positive |
                less_than(ZERO, qat(s, NAT_ZERO))
                [using tautology the-setup]
              // s_0 is a first quotient (ONE's), and it is natural
              @the-first-entry-is-a-first-quotient |
                aFirstQuotientOf(s, n, qat(s, NAT_ZERO))
                [using specialize theFirstEntryIsAFirstQuotient(s, n) the-entries]
              @the-first-entry-is-an-integer |
                isInteger(qat(s, NAT_ZERO))
                [using specialize the-entries(NAT_ZERO) zero-in-range]
              @the-first-entry-is-natural |
                isNatural(qat(s, NAT_ZERO))
                [using specialize rational_integer_order.aPositiveIntegerIsNatural(qat(s, NAT_ZERO)) the-first-entry-is-an-integer first-positive]
              @the-inhabitant |
                isNatural(qat(s, NAT_ZERO)) and
                  aFirstQuotientOf(s, n, qat(s, NAT_ZERO))
                [by both the-first-entry-is-natural the-first-entry-is-a-first-quotient]
              @inhabited |
                exists m: Q; isNatural(m) and aFirstQuotientOf(s, n, m)
                [by witness(qat(s, NAT_ZERO)) the-inhabitant]
              // well-order it
              @the-well-ordering |
                (exists m: Q; isNatural(m) and aFirstQuotientOf(s, n, m)) ->
                  (exists least: Q; isNatural(least) and
                  aFirstQuotientOf(s, n, least) and
                  (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
                  (not less_than(m, least))))
                [using instantiation natural_wellordering.naturalWellOrdering(fun m: Q => aFirstQuotientOf(s, n, m))]
              @conclusion-a-least |
                exists least: Q; isNatural(least) and
                  aFirstQuotientOf(s, n, least) and
                  (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
                  (not less_than(m, least)))
                [by modus_ponens the-well-ordering inhabited]
            }
          @the-implication |
            (nat_less_than(NAT_ZERO, n) and
              (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) and
              less_than(ZERO, qat(s, NAT_ZERO))) ->
              (exists least: Q; isNatural(least) and
              aFirstQuotientOf(s, n, least) and
              (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
              (not less_than(m, least))))
            [by discharge given-the-setup]
          @curried |
            nat_less_than(NAT_ZERO, n) ->
              (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
              less_than(ZERO, qat(s, NAT_ZERO)) ->
              (exists least: Q; isNatural(least) and
              aFirstQuotientOf(s, n, least) and
              (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
              (not less_than(m, least))))
            [using tautology the-implication]
        }
      @discharge-n |
        forall n9: Nat;
          nat_less_than(NAT_ZERO, n9) ->
          (forall i: Nat; nat_less_than(i, n9) -> isInteger(qat(s, i))) ->
          less_than(ZERO, qat(s, NAT_ZERO)) ->
          (exists least: Q; isNatural(least) and
          aFirstQuotientOf(s, n9, least) and
          (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n9, m) ->
          (not less_than(m, least))))
        [by generalize generalize-n]
    }
  @conclusion |
    forall s: QSeq; forall n: Nat;
      nat_less_than(NAT_ZERO, n) ->
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
      less_than(ZERO, qat(s, NAT_ZERO)) ->
      (exists least: Q; isNatural(least) and aFirstQuotientOf(s, n, least) and
      (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
      (not less_than(m, least))))
    [by generalize generalize-s]
qed

// -- THE SEQUENCE-TO-POLYNOMIAL BRIDGE ----------------------------------------------------
// Everything above is about a SEQUENCE's entries; `isTheIntegerDecomposition` is about a
// POLYNOMIAL's coefficients. The two coprimality readings are the same statement —
// `qpoly.dividesOnTheCut` is a `define` with exactly `dividesIntegrally`'s meaning axiom —
// so given a polynomial whose coefficients are the entries, the result transfers.
//
// This is the last join: it is what lets the minimality assembly's coprime quotient sequence
// discharge `coefficientsAreRelativelyPrimeUpTo`.
theorem coprimeEntriesMakeCoprimeCoefficients:
  forall p: qpoly.QPoly; forall t: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> qpoly.qcoeff(p, i) = qat(t, i)) ->
  theQuotientsAreCoprime(t, n) ->
  qpoly.coefficientsAreRelativelyPrimeUpTo(p, n)
proof
  @generalize-p |
    fix p: qpoly.QPoly {
      @generalize-t |
        fix t: QSeq {
          @generalize-n |
            fix n: Nat {
              @given-the-match |
                assume forall i: Nat; nat_less_than(i, n) ->
                  qpoly.qcoeff(p, i) = qat(t, i) {
                  @the-match |
                    forall i: Nat; nat_less_than(i, n) ->
                      qpoly.qcoeff(p, i) = qat(t, i)
                    [by hypothesis given-the-match]
                  @given-coprime |
                    assume theQuotientsAreCoprime(t, n) {
                      @coprime |
                        theQuotientsAreCoprime(t, n)
                        [by hypothesis given-coprime]
                      @the-coprime-meaning |
                        theQuotientsAreCoprime(t, n) iff
                          (forall e: Q; isInteger(e) ->
                          isACommonDivisorUpTo(e, t, n) ->
                          dividesIntegrally(e, ONE))
                        [using specialize quotientsCoprimeMeaning(t, n)]
                      @every-divisor-is-a-unit |
                        forall e: Q; isInteger(e) ->
                          isACommonDivisorUpTo(e, t, n) ->
                          dividesIntegrally(e, ONE)
                        [using tautology the-coprime-meaning coprime]
                      @each-candidate |
                        fix e: Q {
                          @given-e-is-an-integer |
                            assume isInteger(e) {
                              @e-is-an-integer |
                                isInteger(e)
                                [by hypothesis given-e-is-an-integer]
                              @given-e-divides-the-coefficients |
                                assume forall i: Nat; nat_less_than(i, n) ->
                                  (exists k: Q; isInteger(k) and
                                  qpoly.qcoeff(p, i) = rational.mul(e, k)) {
                                  @e-divides-the-coefficients |
                                    forall i: Nat; nat_less_than(i, n) ->
                                      (exists k: Q; isInteger(k) and
                                      qpoly.qcoeff(p, i) = rational.mul(e, k))
                                    [by hypothesis given-e-divides-the-coefficients]
                                  // carry it across to the sequence's entries
                                  @e-divides-the-entries |
                                    fix i: Nat {
                                      @given-i-below |
                                        assume nat_less_than(i, n) {
                                          @i-below |
                                            nat_less_than(i, n)
                                            [by hypothesis given-i-below]
                                          @the-coefficient-is-the-entry |
                                            qpoly.qcoeff(p, i) = qat(t, i)
                                            [using specialize the-match(i) i-below]
                                          @the-coefficient-quotient |
                                            exists k: Q; isInteger(k) and
                                              qpoly.qcoeff(p, i) = rational.mul(e, k)
                                            [using specialize e-divides-the-coefficients(i) i-below]
                                          @the-entry-quotient |
                                            exists k: Q; isInteger(k) and
                                              qat(t, i) = rational.mul(e, k)
                                            [by rewrite the-coefficient-is-the-entry the-coefficient-quotient]
                                          @the-divides-meaning |
                                            dividesIntegrally(e, qat(t, i)) iff
                                              (exists k: Q; isInteger(k) and
                                              qat(t, i) = rational.mul(e, k))
                                            [using specialize dividesIntegrallyMeaning(e, qat(t, i))]
                                          @conclusion-divides-this-entry |
                                            dividesIntegrally(e, qat(t, i))
                                            [using tautology the-divides-meaning the-entry-quotient]
                                        }
                                      @below-implies |
                                        nat_less_than(i, n) ->
                                          dividesIntegrally(e, qat(t, i))
                                        [by discharge given-i-below]
                                    }
                                  @all-entries-divided |
                                    forall i: Nat; nat_less_than(i, n) ->
                                      dividesIntegrally(e, qat(t, i))
                                    [by generalize e-divides-the-entries]
                                  @the-divisor-meaning |
                                    isACommonDivisorUpTo(e, t, n) iff
                                      (forall i: Nat; nat_less_than(i, n) ->
                                      dividesIntegrally(e, qat(t, i)))
                                    [using specialize commonDivisorMeaning(e, t, n)]
                                  @e-is-a-common-divisor |
                                    isACommonDivisorUpTo(e, t, n)
                                    [using tautology the-divisor-meaning all-entries-divided]
                                  @e-divides-one |
                                    dividesIntegrally(e, ONE)
                                    [using specialize every-divisor-is-a-unit(e) e-is-an-integer e-is-a-common-divisor]
                                  @the-unit-meaning |
                                    dividesIntegrally(e, ONE) iff
                                      (exists k: Q; isInteger(k) and
                                      ONE = rational.mul(e, k))
                                    [using specialize dividesIntegrallyMeaning(e, ONE)]
                                  @conclusion-e-is-a-unit |
                                    exists k: Q; isInteger(k) and
                                      ONE = rational.mul(e, k)
                                    [using tautology the-unit-meaning e-divides-one]
                                }
                              @divides-implies-unit |
                                (forall i: Nat; nat_less_than(i, n) ->
                                  (exists k: Q; isInteger(k) and
                                  qpoly.qcoeff(p, i) = rational.mul(e, k))) ->
                                  (exists k: Q; isInteger(k) and
                                  ONE = rational.mul(e, k))
                                [by discharge given-e-divides-the-coefficients]
                            }
                          @integer-implies |
                            isInteger(e) ->
                              (forall i: Nat; nat_less_than(i, n) ->
                              (exists k: Q; isInteger(k) and
                              qpoly.qcoeff(p, i) = rational.mul(e, k))) ->
                              (exists k: Q; isInteger(k) and
                              ONE = rational.mul(e, k))
                            [by discharge given-e-is-an-integer]
                        }
                      @conclusion-coprime-coefficients |
                        qpoly.coefficientsAreRelativelyPrimeUpTo(p, n)
                        [by generalize each-candidate]
                    }
                  @coprime-implies |
                    theQuotientsAreCoprime(t, n) ->
                      qpoly.coefficientsAreRelativelyPrimeUpTo(p, n)
                    [by discharge given-coprime]
                }
              @the-implication |
                (forall i: Nat; nat_less_than(i, n) ->
                  qpoly.qcoeff(p, i) = qat(t, i)) ->
                  theQuotientsAreCoprime(t, n) ->
                  qpoly.coefficientsAreRelativelyPrimeUpTo(p, n)
                [by discharge given-the-match]
            }
          @discharge-n |
            forall n9: Nat;
              (forall i: Nat; nat_less_than(i, n9) ->
              qpoly.qcoeff(p, i) = qat(t, i)) ->
              theQuotientsAreCoprime(t, n9) ->
              qpoly.coefficientsAreRelativelyPrimeUpTo(p, n9)
            [by generalize generalize-n]
        }
      @discharge-t |
        forall t9: QSeq; forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          qpoly.qcoeff(p, i) = qat(t9, i)) ->
          theQuotientsAreCoprime(t9, n9) ->
          qpoly.coefficientsAreRelativelyPrimeUpTo(p, n9)
        [by generalize generalize-t]
    }
  @conclusion |
    forall p: qpoly.QPoly; forall t: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> qpoly.qcoeff(p, i) = qat(t, i)) ->
      theQuotientsAreCoprime(t, n) ->
      qpoly.coefficientsAreRelativelyPrimeUpTo(p, n)
    [by generalize generalize-p]
qed

// -- TWO MORE CONJUNCTS OF THE DECOMPOSITION ----------------------------------------------

// A product of NONZERO entries is nonzero — `s != ZERO` in the decomposition, since s is the
// product of the coefficients' denominators and each denominator is nonzero. Induction on the
// bound, using ℚ's `noZeroDivisors`.
theorem theProductOfNonzerosIsNonzero: forall s: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> rational.nonzero(qat(s, i))) ->
  (not (qProductUpTo(s, n) = ZERO))
proof
  @generalize-s |
    fix s: QSeq {
      // base: the empty product is ONE, and ONE is not ZERO
      @base-case-proof |
        assume forall i: Nat; nat_less_than(i, NAT_ZERO) ->
          rational.nonzero(qat(s, i)) {
          @the-empty-product |
            qProductUpTo(s, NAT_ZERO) = ONE
            [using specialize qProductUpToZero(s)]
          @one-is-not-zero |
            not (ONE = ZERO)
            [by cite rational.oneNotZero]
          @conclusion-base |
            not (qProductUpTo(s, NAT_ZERO) = ZERO)
            [by rewrite the-empty-product one-is-not-zero]
        }
      @base-case |
        (forall i: Nat; nat_less_than(i, NAT_ZERO) ->
          rational.nonzero(qat(s, i))) ->
          (not (qProductUpTo(s, NAT_ZERO) = ZERO))
        [by discharge base-case-proof]

      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume (forall i: Nat; nat_less_than(i, k) ->
              rational.nonzero(qat(s, i))) ->
              (not (qProductUpTo(s, k) = ZERO)) {
              @inductive-hypothesis |
                (forall i: Nat; nat_less_than(i, k) ->
                  rational.nonzero(qat(s, i))) ->
                  (not (qProductUpTo(s, k) = ZERO))
                [by hypothesis given-inductive-hypothesis]
              @given-all-nonzero |
                assume forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                  rational.nonzero(qat(s, i)) {
                  @all-nonzero |
                    forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                      rational.nonzero(qat(s, i))
                    [by hypothesis given-all-nonzero]
                  @k-below-its-successor |
                    nat_less_than(k, nat_succ(k))
                    [using specialize peano_order.lessThanSelf(k)]
                  // weaken to below k
                  @below-k-nonzero |
                    fix i: Nat {
                      @given-i-below-k |
                        assume nat_less_than(i, k) {
                          @i-below-k |
                            nat_less_than(i, k)
                            [by hypothesis given-i-below-k]
                          @i-below-succ-k |
                            nat_less_than(i, nat_succ(k))
                            [using specialize peano_order.lessThanTransitive(i, k, nat_succ(k)) i-below-k k-below-its-successor]
                          @conclusion-this-nonzero |
                            rational.nonzero(qat(s, i))
                            [using specialize all-nonzero(i) i-below-succ-k]
                        }
                      @below-k-implies |
                        nat_less_than(i, k) -> rational.nonzero(qat(s, i))
                        [by discharge given-i-below-k]
                    }
                  @all-below-k-nonzero |
                    forall i: Nat; nat_less_than(i, k) ->
                      rational.nonzero(qat(s, i))
                    [by generalize below-k-nonzero]
                  @the-partial-is-nonzero |
                    not (qProductUpTo(s, k) = ZERO)
                    [by modus_ponens inductive-hypothesis all-below-k-nonzero]
                  @the-k-th-is-nonzero |
                    rational.nonzero(qat(s, k))
                    [using specialize all-nonzero(k) k-below-its-successor]
                  // the DISEQUATION form too: `ex_falso` below needs the literal negation,
                  // which the predicate does not supply syntactically.
                  @the-k-th-characterized |
                    rational.nonzero(qat(s, k)) iff (not (qat(s, k) = ZERO))
                    [using specialize rational.nonzeroMeaning(qat(s, k))]
                  @the-k-th-is-not-zero |
                    not (qat(s, k) = ZERO)
                    [using tautology the-k-th-characterized the-k-th-is-nonzero]
                  @the-next-product |
                    qProductUpTo(s, nat_succ(k)) =
                      rational.mul(qProductUpTo(s, k), qat(s, k))
                    [using specialize qProductUpToSucc(s, k)]
                  // a product of nonzeros is nonzero, by noZeroDivisors
                  @given-the-product-is-zero |
                    assume qProductUpTo(s, nat_succ(k)) = ZERO {
                      @the-product-is-zero |
                        qProductUpTo(s, nat_succ(k)) = ZERO
                        [by hypothesis given-the-product-is-zero]
                      @the-factors-product-is-zero |
                        rational.mul(qProductUpTo(s, k), qat(s, k)) = ZERO
                        [by rewrite the-next-product the-product-is-zero]
                      @a-factor-vanishes |
                        qProductUpTo(s, k) = ZERO or qat(s, k) = ZERO
                        [using specialize rational.noZeroDivisors(qProductUpTo(s, k), qat(s, k)) the-factors-product-is-zero]
                      // both arms contradict a fact already in scope, so either way ONE = ZERO
                      @one-is-zero-either-way |
                        ONE = ZERO
                        case a-factor-vanishes {
                          @when-the-partial-vanishes |
                            assume qProductUpTo(s, k) = ZERO {
                              @the-partial-vanishes |
                                qProductUpTo(s, k) = ZERO
                                [by hypothesis when-the-partial-vanishes]
                              @conclusion-impossible-partial |
                                ONE = ZERO
                                [by ex_falso the-partial-vanishes the-partial-is-nonzero]
                            }
                          @when-the-entry-vanishes |
                            assume qat(s, k) = ZERO {
                              @the-entry-vanishes |
                                qat(s, k) = ZERO
                                [by hypothesis when-the-entry-vanishes]
                              @conclusion-impossible-entry |
                                ONE = ZERO
                                [by ex_falso the-entry-vanishes the-k-th-is-not-zero]
                            }
                        }
                    }
                  @one-is-not-zero-here |
                    not (ONE = ZERO)
                    [by cite rational.oneNotZero]
                  @conclusion-the-step |
                    not (qProductUpTo(s, nat_succ(k)) = ZERO)
                    [by contradiction given-the-product-is-zero one-is-zero-either-way one-is-not-zero-here]
                }
              @conclusion-step-implication |
                (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                  rational.nonzero(qat(s, i))) ->
                  (not (qProductUpTo(s, nat_succ(k)) = ZERO))
                [by discharge given-all-nonzero]
            }
          @induction-step-at-k |
            ((forall i: Nat; nat_less_than(i, k) ->
              rational.nonzero(qat(s, i))) ->
              (not (qProductUpTo(s, k) = ZERO))) ->
              ((forall i: Nat; nat_less_than(i, nat_succ(k)) ->
              rational.nonzero(qat(s, i))) ->
              (not (qProductUpTo(s, nat_succ(k)) = ZERO)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          ((forall i: Nat; nat_less_than(i, k) ->
          rational.nonzero(qat(s, i))) ->
          (not (qProductUpTo(s, k) = ZERO))) ->
          ((forall i: Nat; nat_less_than(i, nat_succ(k)) ->
          rational.nonzero(qat(s, i))) ->
          (not (qProductUpTo(s, nat_succ(k)) = ZERO)))
        [by generalize induction-step]
      @all-bounds |
        forall n: Nat;
          (forall i: Nat; nat_less_than(i, n) ->
          rational.nonzero(qat(s, i))) ->
          (not (qProductUpTo(s, n) = ZERO))
        [using instantiation peano.induction((fun z: Nat => ((forall i: Nat; nat_less_than(i, z) -> rational.nonzero(qat(s, i))) -> (not (qProductUpTo(s, z) = ZERO))))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> rational.nonzero(qat(s, i))) ->
      (not (qProductUpTo(s, n) = ZERO))
    [by generalize generalize-s]
qed

// A product of POSITIVES is positive — the sharpening of the lemma above that makes the
// common denominator usable by the descent. `positiveProduct` is ℚ's own axiom; the induction
// is the same shape, and simpler, since there is no contradiction to route through.
theorem theProductOfPositivesIsPositive: forall s: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> less_than(ZERO, qat(s, i))) ->
  less_than(ZERO, qProductUpTo(s, n))
proof
  @generalize-s |
    fix s: QSeq {
      // base: the empty product is ONE, and ZERO < ONE
      @base-case-proof |
        assume forall i: Nat; nat_less_than(i, NAT_ZERO) ->
          less_than(ZERO, qat(s, i)) {
          @the-empty-product |
            qProductUpTo(s, NAT_ZERO) = ONE
            [using specialize qProductUpToZero(s)]
          @zero-is-below-one |
            less_than(ZERO, ONE)
            [using model(rational.RationalOrderedField) field_order.zeroLessThanOne]
          @conclusion-base |
            less_than(ZERO, qProductUpTo(s, NAT_ZERO))
            [by rewrite the-empty-product zero-is-below-one]
        }
      @base-case |
        (forall i: Nat; nat_less_than(i, NAT_ZERO) ->
          less_than(ZERO, qat(s, i))) ->
          less_than(ZERO, qProductUpTo(s, NAT_ZERO))
        [by discharge base-case-proof]

      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume (forall i: Nat; nat_less_than(i, k) ->
              less_than(ZERO, qat(s, i))) ->
              less_than(ZERO, qProductUpTo(s, k)) {
              @inductive-hypothesis |
                (forall i: Nat; nat_less_than(i, k) ->
                  less_than(ZERO, qat(s, i))) ->
                  less_than(ZERO, qProductUpTo(s, k))
                [by hypothesis given-inductive-hypothesis]
              @given-all-positive |
                assume forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                  less_than(ZERO, qat(s, i)) {
                  @all-positive |
                    forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                      less_than(ZERO, qat(s, i))
                    [by hypothesis given-all-positive]
                  @k-below-its-successor |
                    nat_less_than(k, nat_succ(k))
                    [using specialize peano_order.lessThanSelf(k)]
                  @below-k-positive |
                    fix i: Nat {
                      @given-i-below-k |
                        assume nat_less_than(i, k) {
                          @i-below-k |
                            nat_less_than(i, k)
                            [by hypothesis given-i-below-k]
                          @i-below-succ-k |
                            nat_less_than(i, nat_succ(k))
                            [using specialize peano_order.lessThanTransitive(i, k, nat_succ(k)) i-below-k k-below-its-successor]
                          @conclusion-this-positive |
                            less_than(ZERO, qat(s, i))
                            [using specialize all-positive(i) i-below-succ-k]
                        }
                      @below-k-implies |
                        nat_less_than(i, k) ->
                          less_than(ZERO, qat(s, i))
                        [by discharge given-i-below-k]
                    }
                  @all-below-k-positive |
                    forall i: Nat; nat_less_than(i, k) ->
                      less_than(ZERO, qat(s, i))
                    [by generalize below-k-positive]
                  @the-partial-is-positive |
                    less_than(ZERO, qProductUpTo(s, k))
                    [by modus_ponens inductive-hypothesis all-below-k-positive]
                  @the-k-th-is-positive |
                    less_than(ZERO, qat(s, k))
                    [using specialize all-positive(k) k-below-its-successor]
                  @the-next-product |
                    qProductUpTo(s, nat_succ(k)) =
                      rational.mul(qProductUpTo(s, k), qat(s, k))
                    [using specialize qProductUpToSucc(s, k)]
                  @the-factors-product-is-positive |
                    less_than(ZERO,
                      rational.mul(qProductUpTo(s, k), qat(s, k)))
                    [using specialize rational.positiveProduct(qProductUpTo(s, k), qat(s, k)) the-partial-is-positive the-k-th-is-positive]
                  @conclusion-the-step |
                    less_than(ZERO, qProductUpTo(s, nat_succ(k)))
                    [by rewrite the-next-product the-factors-product-is-positive]
                }
              @conclusion-step-implication |
                (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                  less_than(ZERO, qat(s, i))) ->
                  less_than(ZERO, qProductUpTo(s, nat_succ(k)))
                [by discharge given-all-positive]
            }
          @induction-step-at-k |
            ((forall i: Nat; nat_less_than(i, k) ->
              less_than(ZERO, qat(s, i))) ->
              less_than(ZERO, qProductUpTo(s, k))) ->
              ((forall i: Nat; nat_less_than(i, nat_succ(k)) ->
              less_than(ZERO, qat(s, i))) ->
              less_than(ZERO, qProductUpTo(s, nat_succ(k))))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          ((forall i: Nat; nat_less_than(i, k) ->
          less_than(ZERO, qat(s, i))) ->
          less_than(ZERO, qProductUpTo(s, k))) ->
          ((forall i: Nat; nat_less_than(i, nat_succ(k)) ->
          less_than(ZERO, qat(s, i))) ->
          less_than(ZERO, qProductUpTo(s, nat_succ(k))))
        [by generalize induction-step]
      @all-bounds |
        forall n: Nat;
          (forall i: Nat; nat_less_than(i, n) ->
          less_than(ZERO, qat(s, i))) ->
          less_than(ZERO, qProductUpTo(s, n))
        [using instantiation peano.induction((fun z: Nat => ((forall i: Nat; nat_less_than(i, z) -> less_than(ZERO, qat(s, i))) -> less_than(ZERO, qProductUpTo(s, z))))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> less_than(ZERO, qat(s, i))) ->
      less_than(ZERO, qProductUpTo(s, n))
    [by generalize generalize-s]
qed

// Integrality transfers across the same match — the companion to
// `coprimeEntriesMakeCoprimeCoefficients`, for the decomposition's
// `hasIntegerCoefficientsUpTo` conjunct.
theorem integerEntriesMakeIntegerCoefficients:
  forall p: qpoly.QPoly; forall t: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> qpoly.qcoeff(p, i) = qat(t, i)) ->
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i))) ->
  qpoly.hasIntegerCoefficientsUpTo(p, n)
proof
  @generalize-p |
    fix p: qpoly.QPoly {
      @generalize-t |
        fix t: QSeq {
          @generalize-n |
            fix n: Nat {
              @given-the-match |
                assume forall i: Nat; nat_less_than(i, n) ->
                  qpoly.qcoeff(p, i) = qat(t, i) {
                  @the-match |
                    forall i: Nat; nat_less_than(i, n) ->
                      qpoly.qcoeff(p, i) = qat(t, i)
                    [by hypothesis given-the-match]
                  @given-the-integrality |
                    assume forall i: Nat; nat_less_than(i, n) ->
                      isInteger(qat(t, i)) {
                      @the-integrality |
                        forall i: Nat; nat_less_than(i, n) ->
                          isInteger(qat(t, i))
                        [by hypothesis given-the-integrality]
                      @each-coefficient |
                        fix i: Nat {
                          @given-i-below |
                            assume nat_less_than(i, n) {
                              @i-below |
                                nat_less_than(i, n)
                                [by hypothesis given-i-below]
                              @the-coefficient-is-the-entry |
                                qpoly.qcoeff(p, i) = qat(t, i)
                                [using specialize the-match(i) i-below]
                              @the-entry-is-an-integer |
                                isInteger(qat(t, i))
                                [using specialize the-integrality(i) i-below]
                              @conclusion-coefficient-integer |
                                isInteger(qpoly.qcoeff(p, i))
                                [by rewrite the-coefficient-is-the-entry the-entry-is-an-integer]
                            }
                          @below-implies |
                            nat_less_than(i, n) ->
                              isInteger(qpoly.qcoeff(p, i))
                            [by discharge given-i-below]
                        }
                      @all-coefficients-integer |
                        forall i: Nat; nat_less_than(i, n) ->
                          isInteger(qpoly.qcoeff(p, i))
                        [by generalize each-coefficient]
                      @the-general-meaning |
                        forall p2: qpoly.QPoly; forall n2: Nat;
                          qpoly.hasIntegerCoefficientsUpTo(p2, n2) iff
                          (forall i: Nat; nat_less_than(i, n2) ->
                          isInteger(qpoly.qcoeff(p2, i)))
                        [using import(qpoly) integerCoefficientsMeaning]
                      @the-meaning |
                        qpoly.hasIntegerCoefficientsUpTo(p, n) iff
                          (forall i: Nat; nat_less_than(i, n) ->
                          isInteger(qpoly.qcoeff(p, i)))
                        [using specialize the-general-meaning(p, n)]
                      @conclusion-integer-coefficients |
                        qpoly.hasIntegerCoefficientsUpTo(p, n)
                        [using tautology the-meaning all-coefficients-integer]
                    }
                  @integrality-implies |
                    (forall i: Nat; nat_less_than(i, n) ->
                      isInteger(qat(t, i))) ->
                      qpoly.hasIntegerCoefficientsUpTo(p, n)
                    [by discharge given-the-integrality]
                }
              @the-implication |
                (forall i: Nat; nat_less_than(i, n) ->
                  qpoly.qcoeff(p, i) = qat(t, i)) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  isInteger(qat(t, i))) ->
                  qpoly.hasIntegerCoefficientsUpTo(p, n)
                [by discharge given-the-match]
            }
          @discharge-n |
            forall n9: Nat;
              (forall i: Nat; nat_less_than(i, n9) ->
              qpoly.qcoeff(p, i) = qat(t, i)) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              isInteger(qat(t, i))) ->
              qpoly.hasIntegerCoefficientsUpTo(p, n9)
            [by generalize generalize-n]
        }
      @discharge-t |
        forall t9: QSeq; forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          qpoly.qcoeff(p, i) = qat(t9, i)) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          isInteger(qat(t9, i))) ->
          qpoly.hasIntegerCoefficientsUpTo(p, n9)
        [by generalize generalize-t]
    }
  @conclusion |
    forall p: qpoly.QPoly; forall t: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> qpoly.qcoeff(p, i) = qat(t, i)) ->
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i))) ->
      qpoly.hasIntegerCoefficientsUpTo(p, n)
    [by generalize generalize-p]
qed

// -- STEP 4 IN THE DECOMPOSITION'S OWN TERMS ----------------------------------------------
// `theReducedFractionIsInLowestTerms` is stated per-candidate-divisor `e`; the decomposition
// asks for the generalized form. Generalizing over `e` IS `arePairwiseRelativelyPrime(r, s)`,
// since `qpoly.dividesOnTheCut` is a `define` with exactly `dividesIntegrally`'s body.
//
// (Before the 2026-10-31 correction this conjunct was a polynomial condition and would have
// needed a bridge; it is a pair condition now, so it does not.)
theorem theReducedFractionIsCoprime: forall g, a, b, r, s: Q;
  isAMaximalCommonDivisorOfThePair(g, a, b) ->
  a = rational.mul(g, r) -> b = rational.mul(g, s) ->
  qpoly.arePairwiseRelativelyPrime(r, s)
proof
  @generalize-g |
    fix g: Q {
      @generalize-a |
        fix a: Q {
          @generalize-b |
            fix b: Q {
              @generalize-r |
                fix r: Q {
                  @generalize-s |
                    fix s: Q {
                      @given-the-setup |
                        assume isAMaximalCommonDivisorOfThePair(g, a, b) and
                          a = rational.mul(g, r) and
                          b = rational.mul(g, s) {
                          @the-setup |
                            isAMaximalCommonDivisorOfThePair(g, a, b) and
                              a = rational.mul(g, r) and
                              b = rational.mul(g, s)
                            [by hypothesis given-the-setup]
                          @g-is-maximal |
                            isAMaximalCommonDivisorOfThePair(g, a, b)
                            [using tautology the-setup]
                          @a-factors |
                            a = rational.mul(g, r)
                            [using tautology the-setup]
                          @b-factors |
                            b = rational.mul(g, s)
                            [using tautology the-setup]
                          @each-candidate |
                            fix e: Q {
                              @given-e-is-an-integer |
                                assume isInteger(e) {
                                  @e-is-an-integer |
                                    isInteger(e)
                                    [by hypothesis given-e-is-an-integer]
                                  @given-e-divides-r |
                                    assume exists k: Q; isInteger(k) and
                                      r = rational.mul(e, k) {
                                      @the-r-quotient |
                                        exists k: Q; isInteger(k) and
                                          r = rational.mul(e, k)
                                        [by hypothesis given-e-divides-r]
                                      @the-r-meaning |
                                        dividesIntegrally(e, r) iff
                                          (exists k: Q; isInteger(k) and
                                          r = rational.mul(e, k))
                                        [using specialize dividesIntegrallyMeaning(e, r)]
                                      @e-divides-r |
                                        dividesIntegrally(e, r)
                                        [using tautology the-r-meaning the-r-quotient]
                                      @given-e-divides-s |
                                        assume exists k: Q; isInteger(k) and
                                          s = rational.mul(e, k) {
                                          @the-s-quotient |
                                            exists k: Q; isInteger(k) and
                                              s = rational.mul(e, k)
                                            [by hypothesis given-e-divides-s]
                                          @the-s-meaning |
                                            dividesIntegrally(e, s) iff
                                              (exists k: Q; isInteger(k) and
                                              s = rational.mul(e, k))
                                            [using specialize dividesIntegrallyMeaning(e, s)]
                                          @e-divides-s |
                                            dividesIntegrally(e, s)
                                            [using tautology the-s-meaning the-s-quotient]
                                          @e-divides-one |
                                            dividesIntegrally(e, ONE)
                                            [using specialize theReducedFractionIsInLowestTerms(g, a, b, r, s, e) g-is-maximal a-factors b-factors e-is-an-integer e-divides-r e-divides-s]
                                          @the-unit-meaning |
                                            dividesIntegrally(e, ONE) iff
                                              (exists k: Q; isInteger(k) and
                                              ONE = rational.mul(e, k))
                                            [using specialize dividesIntegrallyMeaning(e, ONE)]
                                          @conclusion-e-is-a-unit |
                                            exists k: Q; isInteger(k) and
                                              ONE = rational.mul(e, k)
                                            [using tautology the-unit-meaning e-divides-one]
                                        }
                                      @s-implies |
                                        (exists k: Q; isInteger(k) and
                                          s = rational.mul(e, k)) ->
                                          (exists k: Q; isInteger(k) and
                                          ONE = rational.mul(e, k))
                                        [by discharge given-e-divides-s]
                                    }
                                  @r-implies |
                                    (exists k: Q; isInteger(k) and
                                      r = rational.mul(e, k)) ->
                                      (exists k: Q; isInteger(k) and
                                      s = rational.mul(e, k)) ->
                                      (exists k: Q; isInteger(k) and
                                      ONE = rational.mul(e, k))
                                    [by discharge given-e-divides-r]
                                }
                              @integer-implies |
                                isInteger(e) ->
                                  (exists k: Q; isInteger(k) and
                                  r = rational.mul(e, k)) ->
                                  (exists k: Q; isInteger(k) and
                                  s = rational.mul(e, k)) ->
                                  (exists k: Q; isInteger(k) and
                                  ONE = rational.mul(e, k))
                                [by discharge given-e-is-an-integer]
                            }
                          @conclusion-coprime |
                            qpoly.arePairwiseRelativelyPrime(r, s)
                            [by generalize each-candidate]
                        }
                      @the-implication |
                        (isAMaximalCommonDivisorOfThePair(g, a, b) and
                          a = rational.mul(g, r) and
                          b = rational.mul(g, s)) ->
                          qpoly.arePairwiseRelativelyPrime(r, s)
                        [by discharge given-the-setup]
                      @curried |
                        isAMaximalCommonDivisorOfThePair(g, a, b) ->
                          a = rational.mul(g, r) -> b = rational.mul(g, s) ->
                          qpoly.arePairwiseRelativelyPrime(r, s)
                        [using tautology the-implication]
                    }
                  @discharge-s |
                    forall s9: Q;
                      isAMaximalCommonDivisorOfThePair(g, a, b) ->
                      a = rational.mul(g, r) -> b = rational.mul(g, s9) ->
                      qpoly.arePairwiseRelativelyPrime(r, s9)
                    [by generalize generalize-s]
                }
              @discharge-r |
                forall r9: Q; forall s9: Q;
                  isAMaximalCommonDivisorOfThePair(g, a, b) ->
                  a = rational.mul(g, r9) -> b = rational.mul(g, s9) ->
                  qpoly.arePairwiseRelativelyPrime(r9, s9)
                [by generalize generalize-r]
            }
          @discharge-b |
            forall b9: Q; forall r9: Q; forall s9: Q;
              isAMaximalCommonDivisorOfThePair(g, a, b9) ->
              a = rational.mul(g, r9) -> b9 = rational.mul(g, s9) ->
              qpoly.arePairwiseRelativelyPrime(r9, s9)
            [by generalize generalize-b]
        }
      @discharge-a |
        forall a9: Q; forall b9: Q; forall r9: Q; forall s9: Q;
          isAMaximalCommonDivisorOfThePair(g, a9, b9) ->
          a9 = rational.mul(g, r9) -> b9 = rational.mul(g, s9) ->
          qpoly.arePairwiseRelativelyPrime(r9, s9)
        [by generalize generalize-a]
    }
  @conclusion |
    forall g, a, b, r, s: Q;
      isAMaximalCommonDivisorOfThePair(g, a, b) ->
      a = rational.mul(g, r) -> b = rational.mul(g, s) ->
      qpoly.arePairwiseRelativelyPrime(r, s)
    [by generalize generalize-g]
qed

// The extension step: a polynomial matching `t` below `k` can be corrected to match below
// `succ(k)` by adding the monomial `(t_k - p_k) · x^k`.
//
// The CORRECTION TERM is what makes this work for ANY p: at index k the added coefficient is
// exactly the shortfall, and below k the monomial contributes ZERO because it lives at index k.
// Tracking "p vanishes at and above k" as an induction invariant would also work but is
// strictly more bookkeeping.
theorem theMonomialMatchesOneMoreIndex: forall t: QSeq; forall p: qpoly.QPoly; forall k: Nat;
  (forall i: Nat; nat_less_than(i, k) -> qpoly.qcoeff(p, i) = qat(t, i)) ->
  (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
  qpoly.qcoeff(qpoly.qaddP(p,
  qpoly.qmonomial(rational.add(qat(t, k),
  rational.neg(qpoly.qcoeff(p, k))), k)), i) = qat(t, i))
proof
  @generalize-t |
    fix t: QSeq {
      @generalize-p |
        fix p: qpoly.QPoly {
          @generalize-k |
            fix k: Nat {
              @given-the-match |
                assume forall i: Nat; nat_less_than(i, k) ->
                  qpoly.qcoeff(p, i) = qat(t, i) {
                  @the-match |
                    forall i: Nat; nat_less_than(i, k) ->
                      qpoly.qcoeff(p, i) = qat(t, i)
                    [by hypothesis given-the-match]
                  // the corrected polynomial
                  @the-add-law |
                    forall a, b: qpoly.QPoly; forall i: Nat;
                      qpoly.qcoeff(qpoly.qaddP(a, b), i) =
                      rational.add(qpoly.qcoeff(a, i), qpoly.qcoeff(b, i))
                    [using import(qpoly) qAddPolyCoeff]
                  @the-correction |
                    forall i: Nat;
                      qpoly.qcoeff(qpoly.qaddP(p,
                      qpoly.qmonomial(rational.add(qat(t, k),
                      rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                      rational.add(qpoly.qcoeff(p, i),
                      qpoly.qcoeff(qpoly.qmonomial(rational.add(qat(t, k),
                      rational.neg(qpoly.qcoeff(p, k))), k), i))
                    [using specialize the-add-law(p, qpoly.qmonomial(rational.add(qat(t, k), rational.neg(qpoly.qcoeff(p, k))), k))]
                  @matches-below-succ-k |
                    fix i: Nat {
                      @given-i-below-succ-k |
                        assume nat_less_than(i, nat_succ(k)) {
                          @i-below-succ-k |
                            nat_less_than(i, nat_succ(k))
                            [by hypothesis given-i-below-succ-k]
                          @the-sum-at-i |
                            qpoly.qcoeff(qpoly.qaddP(p,
                              qpoly.qmonomial(rational.add(qat(t, k),
                              rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                              rational.add(qpoly.qcoeff(p, i),
                              qpoly.qcoeff(qpoly.qmonomial(rational.add(qat(t, k),
                              rational.neg(qpoly.qcoeff(p, k))), k), i))
                            [using specialize the-correction(i)]
                          @the-split |
                            nat_less_than(i, k) or i = k
                            [using specialize peano_order.lessThanSuccSplit(i, k) i-below-succ-k]
                          @conclusion-matches-at-i |
                            qpoly.qcoeff(qpoly.qaddP(p,
                              qpoly.qmonomial(rational.add(qat(t, k),
                              rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                              qat(t, i)
                            case the-split {
                              // below k: the monomial contributes ZERO, so the old match stands
                              @when-below-k |
                                assume nat_less_than(i, k) {
                                  @i-below-k |
                                    nat_less_than(i, k)
                                    [by hypothesis when-below-k]
                                  // i < k makes i != k: otherwise k < k
                                  @given-i-is-k |
                                    assume i = k {
                                      @i-equals-k |
                                        i = k
                                        [by hypothesis given-i-is-k]
                                      @k-below-k |
                                        nat_less_than(k, k)
                                        [by rewrite i-equals-k i-below-k]
                                      @k-not-below-k |
                                        not nat_less_than(k, k)
                                        [using specialize peano_order.lessThanIrreflexive(k)]
                                    }
                                  @i-is-not-k |
                                    not (i = k)
                                    [by contradiction given-i-is-k k-below-k k-not-below-k]
                                  @the-monomial-elsewhere-law |
                                    forall a: Q; forall m, j: Nat;
                                      (not (j = m)) ->
                                      qpoly.qcoeff(qpoly.qmonomial(a, m), j) = ZERO
                                    [using import(qpoly) qMonomialCoeffElsewhere]
                                  @the-monomial-vanishes |
                                    qpoly.qcoeff(qpoly.qmonomial(
                                      rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))), k), i) =
                                      ZERO
                                    [using specialize the-monomial-elsewhere-law(rational.add(qat(t, k), rational.neg(qpoly.qcoeff(p, k))), k, i) i-is-not-k]
                                  @the-sum-with-zero |
                                    qpoly.qcoeff(qpoly.qaddP(p,
                                      qpoly.qmonomial(rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                                      rational.add(qpoly.qcoeff(p, i), ZERO)
                                    [by rewrite the-monomial-vanishes the-sum-at-i]
                                  @adding-zero |
                                    rational.add(qpoly.qcoeff(p, i), ZERO) =
                                      qpoly.qcoeff(p, i)
                                    [using specialize rational.addZeroRight(qpoly.qcoeff(p, i))]
                                  @the-sum-is-the-old |
                                    qpoly.qcoeff(qpoly.qaddP(p,
                                      qpoly.qmonomial(rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                                      qpoly.qcoeff(p, i)
                                    [by rewrite adding-zero the-sum-with-zero]
                                  @the-old-match-at-i |
                                    qpoly.qcoeff(p, i) = qat(t, i)
                                    [using specialize the-match(i) i-below-k]
                                  @conclusion-below |
                                    qpoly.qcoeff(qpoly.qaddP(p,
                                      qpoly.qmonomial(rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                                      qat(t, i)
                                    [using simplify the-sum-is-the-old the-old-match-at-i]
                                }
                              // at k: the correction term lands exactly
                              @when-at-k |
                                assume i = k {
                                  @i-is-k |
                                    i = k
                                    [by hypothesis when-at-k]
                                  @the-monomial-at-index-law |
                                    forall a: Q; forall m: Nat;
                                      qpoly.qcoeff(qpoly.qmonomial(a, m), m) = a
                                    [using import(qpoly) qMonomialCoeffAtItsIndex]
                                  @the-monomial-at-its-index |
                                    qpoly.qcoeff(qpoly.qmonomial(
                                      rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))), k), k) =
                                      rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k)))
                                    [using specialize the-monomial-at-index-law(rational.add(qat(t, k), rational.neg(qpoly.qcoeff(p, k))), k)]
                                  @the-sum-at-k |
                                    qpoly.qcoeff(qpoly.qaddP(p,
                                      qpoly.qmonomial(rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))), k)), k) =
                                      rational.add(qpoly.qcoeff(p, k),
                                      qpoly.qcoeff(qpoly.qmonomial(
                                      rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))), k), k))
                                    [using specialize the-correction(k)]
                                  @the-sum-expanded |
                                    qpoly.qcoeff(qpoly.qaddP(p,
                                      qpoly.qmonomial(rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))), k)), k) =
                                      rational.add(qpoly.qcoeff(p, k),
                                      rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))))
                                    [by rewrite the-monomial-at-its-index the-sum-at-k]
                                  // p_k + (t_k - p_k) = t_k
                                  @the-correction-cancels |
                                    rational.add(qpoly.qcoeff(p, k),
                                      rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k)))) =
                                      qat(t, k)
                                    [using polynomial(rational)]
                                  @the-sum-is-the-target |
                                    qpoly.qcoeff(qpoly.qaddP(p,
                                      qpoly.qmonomial(rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))), k)), k) =
                                      qat(t, k)
                                    [using simplify the-sum-expanded the-correction-cancels]
                                  @conclusion-at-k |
                                    qpoly.qcoeff(qpoly.qaddP(p,
                                      qpoly.qmonomial(rational.add(qat(t, k),
                                      rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                                      qat(t, i)
                                    [by rewrite i-is-k the-sum-is-the-target]
                                }
                            }
                        }
                      @below-succ-k-implies |
                        nat_less_than(i, nat_succ(k)) ->
                          qpoly.qcoeff(qpoly.qaddP(p,
                          qpoly.qmonomial(rational.add(qat(t, k),
                          rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                          qat(t, i)
                        [by discharge given-i-below-succ-k]
                    }
                  @all-match |
                    forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                      qpoly.qcoeff(qpoly.qaddP(p,
                      qpoly.qmonomial(rational.add(qat(t, k),
                      rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                      qat(t, i)
                    [by generalize matches-below-succ-k]
                }
              @the-implication |
                (forall i: Nat; nat_less_than(i, k) ->
                  qpoly.qcoeff(p, i) = qat(t, i)) ->
                  (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                  qpoly.qcoeff(qpoly.qaddP(p,
                  qpoly.qmonomial(rational.add(qat(t, k),
                  rational.neg(qpoly.qcoeff(p, k))), k)), i) = qat(t, i))
                [by discharge given-the-match]
            }
          @discharge-k |
            forall k9: Nat;
              (forall i: Nat; nat_less_than(i, k9) ->
              qpoly.qcoeff(p, i) = qat(t, i)) ->
              (forall i: Nat; nat_less_than(i, nat_succ(k9)) ->
              qpoly.qcoeff(qpoly.qaddP(p,
              qpoly.qmonomial(rational.add(qat(t, k9),
              rational.neg(qpoly.qcoeff(p, k9))), k9)), i) = qat(t, i))
            [by generalize generalize-k]
        }
      @discharge-p |
        forall p9: qpoly.QPoly; forall k9: Nat;
          (forall i: Nat; nat_less_than(i, k9) ->
          qpoly.qcoeff(p9, i) = qat(t, i)) ->
          (forall i: Nat; nat_less_than(i, nat_succ(k9)) ->
          qpoly.qcoeff(qpoly.qaddP(p9,
          qpoly.qmonomial(rational.add(qat(t, k9),
          rational.neg(qpoly.qcoeff(p9, k9))), k9)), i) = qat(t, i))
        [by generalize generalize-p]
    }
  @conclusion |
    forall t: QSeq; forall p: qpoly.QPoly; forall k: Nat;
      (forall i: Nat; nat_less_than(i, k) -> qpoly.qcoeff(p, i) = qat(t, i)) ->
      (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
      qpoly.qcoeff(qpoly.qaddP(p,
      qpoly.qmonomial(rational.add(qat(t, k),
      rational.neg(qpoly.qcoeff(p, k))), k)), i) = qat(t, i))
    [by generalize generalize-t]
qed

// -- A POLYNOMIAL FROM A SEQUENCE ---------------------------------------------------------
// The bridges take `qcoeff(p, i) = qat(t, i)` as a HYPOTHESIS; something must supply it, and
// nothing in std did — there was no construction of a polynomial from a sequence at all.
//
// `qmonomial` and `qaddP` suffice: build it by induction on the bound, adding the monomial
// `t_k · x^k` at each step. Below k the new monomial contributes ZERO (it lives at index k),
// so earlier coefficients are untouched; at k the previous polynomial contributes ZERO if its
// own coefficients vanish there — which they need not, so the induction carries the match as
// its invariant rather than claiming the polynomials are equal.
theorem aPolynomialMatchesASequence: forall t: QSeq; forall n: Nat;
  exists p: qpoly.QPoly; forall i: Nat;
  nat_less_than(i, n) -> qpoly.qcoeff(p, i) = qat(t, i)
proof
  @generalize-t |
    fix t: QSeq {
      // base: nothing below ZERO, so the zero polynomial serves
      @nothing-below-zero |
        fix i: Nat {
          @given-i-below-zero |
            assume nat_less_than(i, NAT_ZERO) {
              @i-below-zero |
                nat_less_than(i, NAT_ZERO)
                [by hypothesis given-i-below-zero]
              @nothing-is-below-zero |
                not nat_less_than(i, NAT_ZERO)
                [using specialize peano_order.notLessThanZero(i)]
              @conclusion-vacuous |
                qpoly.qcoeff(qpoly.QZEROP, i) = qat(t, i)
                [by ex_falso i-below-zero nothing-is-below-zero]
            }
          @below-zero-implies |
            nat_less_than(i, NAT_ZERO) ->
              qpoly.qcoeff(qpoly.QZEROP, i) = qat(t, i)
            [by discharge given-i-below-zero]
        }
      @all-below-zero |
        forall i: Nat; nat_less_than(i, NAT_ZERO) ->
          qpoly.qcoeff(qpoly.QZEROP, i) = qat(t, i)
        [by generalize nothing-below-zero]
      @base-case |
        exists p: qpoly.QPoly; forall i: Nat;
          nat_less_than(i, NAT_ZERO) -> qpoly.qcoeff(p, i) = qat(t, i)
        [by witness(qpoly.QZEROP) all-below-zero]

      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume exists p: qpoly.QPoly; forall i: Nat;
              nat_less_than(i, k) -> qpoly.qcoeff(p, i) = qat(t, i) {
              @inductive-hypothesis |
                exists p: qpoly.QPoly; forall i: Nat;
                  nat_less_than(i, k) -> qpoly.qcoeff(p, i) = qat(t, i)
                [by hypothesis given-inductive-hypothesis]
              @conclusion-the-step |
                unpack p: qpoly.QPoly from inductive-hypothesis {
                  @the-match-below-k |
                    forall i: Nat; nat_less_than(i, k) ->
                      qpoly.qcoeff(p, i) = qat(t, i)
                    [by hypothesis conclusion-the-step]
                  @the-extended-match |
                    forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                      qpoly.qcoeff(qpoly.qaddP(p,
                      qpoly.qmonomial(rational.add(qat(t, k),
                      rational.neg(qpoly.qcoeff(p, k))), k)), i) = qat(t, i)
                    [using specialize theMonomialMatchesOneMoreIndex(t, p, k) the-match-below-k]
                  @conclusion-extended |
                    exists p2: qpoly.QPoly; forall i: Nat;
                      nat_less_than(i, nat_succ(k)) ->
                      qpoly.qcoeff(p2, i) = qat(t, i)
                    [by witness(qpoly.qaddP(p, qpoly.qmonomial(rational.add(qat(t, k), rational.neg(qpoly.qcoeff(p, k))), k))) the-extended-match]
                }
              @the-step-exported |
                exists p2: qpoly.QPoly; forall i: Nat;
                  nat_less_than(i, nat_succ(k)) ->
                  qpoly.qcoeff(p2, i) = qat(t, i)
                [by unpacked conclusion-the-step]
            }
          @induction-step-at-k |
            (exists p: qpoly.QPoly; forall i: Nat;
              nat_less_than(i, k) -> qpoly.qcoeff(p, i) = qat(t, i)) ->
              (exists p2: qpoly.QPoly; forall i: Nat;
              nat_less_than(i, nat_succ(k)) ->
              qpoly.qcoeff(p2, i) = qat(t, i))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          (exists p: qpoly.QPoly; forall i: Nat;
          nat_less_than(i, k) -> qpoly.qcoeff(p, i) = qat(t, i)) ->
          (exists p2: qpoly.QPoly; forall i: Nat;
          nat_less_than(i, nat_succ(k)) ->
          qpoly.qcoeff(p2, i) = qat(t, i))
        [by generalize induction-step]
      @all-bounds |
        forall n: Nat;
          exists p: qpoly.QPoly; forall i: Nat;
          nat_less_than(i, n) -> qpoly.qcoeff(p, i) = qat(t, i)
        [using instantiation peano.induction((fun z: Nat => (exists p: qpoly.QPoly; forall i: Nat; nat_less_than(i, z) -> qpoly.qcoeff(p, i) = qat(t, i)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall t: QSeq; forall n: Nat;
      exists p: qpoly.QPoly; forall i: Nat;
      nat_less_than(i, n) -> qpoly.qcoeff(p, i) = qat(t, i)
    [by generalize generalize-t]
qed

// -- THE CLEARED NUMERATORS AS A SEQUENCE -------------------------------------------------
// Judson's step 2 produces `d_i = C · (b_i/c_i)`, the cleared numerators. Stage C gives their
// integrality ONE INDEX AT A TIME and only BELOW n; the descent needs them as a SEQUENCE.
//
// The spec is "v is an integer AND, when i is in range, v is the cleared numerator". That
// second clause is conditional precisely so the spec is satisfiable at EVERY index — above n
// any integer serves — which is what `anIndexPinnedChoiceIsRealized`'s unbounded witness
// hypothesis requires. An earlier draft demanded unbounded integrality from the caller
// instead, which stage C cannot supply and which nothing actually needs.
theorem theClearedNumeratorSequenceExists: forall whole: Q; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) ->
  isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
  (exists u: QSeq; forall i: Nat; nat_less_than(i, n) ->
  (isInteger(qat(u, i)) and
  qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i))))
proof
  @generalize-whole |
    fix whole: Q {
      @generalize-n |
        fix n: Nat {
          @given-cleared-below |
            assume forall i: Nat; nat_less_than(i, n) ->
              isInteger(rational.mul(whole,
              qpoly.qcoeff(theSubject, i))) {
              @cleared-below |
                forall i: Nat; nat_less_than(i, n) ->
                  isInteger(rational.mul(whole,
                  qpoly.qcoeff(theSubject, i)))
                [by hypothesis given-cleared-below]
              @one-is-an-integer |
                isInteger(ONE)
                [by cite rational.oneIsAnInteger]
              // the spec has a witness at EVERY index: in range, the cleared numerator
              // itself; out of range, ONE (the second clause is vacuous there).
              @each-index |
                fix i: Nat {
                  @given-i-below |
                    assume nat_less_than(i, n) {
                      @i-below |
                        nat_less_than(i, n)
                        [by hypothesis given-i-below]
                      @integral-here |
                        isInteger(rational.mul(whole,
                          qpoly.qcoeff(theSubject, i)))
                        [using specialize cleared-below(i) i-below]
                      @the-value-is-itself-plainly |
                        rational.mul(whole, qpoly.qcoeff(theSubject, i)) =
                          rational.mul(whole, qpoly.qcoeff(theSubject, i))
                        [by reflexivity]
                      @the-value-is-itself |
                        nat_less_than(i, n) ->
                          rational.mul(whole, qpoly.qcoeff(theSubject, i)) =
                          rational.mul(whole, qpoly.qcoeff(theSubject, i))
                        [using tautology the-value-is-itself-plainly]
                      @the-witness-works |
                        isInteger(rational.mul(whole,
                          qpoly.qcoeff(theSubject, i))) and
                          (nat_less_than(i, n) ->
                          rational.mul(whole, qpoly.qcoeff(theSubject, i)) =
                          rational.mul(whole, qpoly.qcoeff(theSubject, i)))
                        [by both integral-here the-value-is-itself]
                      @conclusion-in-range |
                        exists v: Q;
                          (isInteger(v) and
                          (nat_less_than(i, n) ->
                          v = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i))))
                        [by witness(rational.mul(whole, qpoly.qcoeff(theSubject, i))) the-witness-works]
                    }
                  @in-range-implies |
                    nat_less_than(i, n) ->
                      (exists v: Q;
                      (isInteger(v) and
                      (nat_less_than(i, n) ->
                      v = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i)))))
                    [by discharge given-i-below]
                  @given-i-out-of-range |
                    assume not nat_less_than(i, n) {
                      @i-out-of-range |
                        not nat_less_than(i, n)
                        [by hypothesis given-i-out-of-range]
                      @the-clause-is-vacuous |
                        nat_less_than(i, n) ->
                          ONE = rational.mul(whole, qpoly.qcoeff(theSubject, i))
                        [using tautology i-out-of-range]
                      @one-works |
                        isInteger(ONE) and
                          (nat_less_than(i, n) ->
                          ONE = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i)))
                        [by both one-is-an-integer the-clause-is-vacuous]
                      @conclusion-out-of-range |
                        exists v: Q;
                          (isInteger(v) and
                          (nat_less_than(i, n) ->
                          v = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i))))
                        [by witness(ONE) one-works]
                    }
                  @out-of-range-implies |
                    (not nat_less_than(i, n)) ->
                      (exists v: Q;
                      (isInteger(v) and
                      (nat_less_than(i, n) ->
                      v = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i)))))
                    [by discharge given-i-out-of-range]
                  @conclusion-at-i |
                    exists v: Q;
                      (isInteger(v) and
                      (nat_less_than(i, n) ->
                      v = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i))))
                    [using tautology in-range-implies out-of-range-implies]
                }
              @the-witnesses |
                forall i: Nat; exists v: Q;
                  (isInteger(v) and
                  (nat_less_than(i, n) ->
                  v = rational.mul(whole, qpoly.qcoeff(theSubject, i))))
                [by generalize each-index]
              @the-sequences |
                forall m: Nat; exists u: QSeq; forall i: Nat;
                  nat_less_than(i, m) ->
                  (isInteger(qat(u, i)) and
                  (nat_less_than(i, n) ->
                  qat(u, i) = rational.mul(whole,
                  qpoly.qcoeff(theSubject, i))))
                [using instantiation anIndexPinnedChoiceIsRealized(fun i: Nat, v: Q => (isInteger(v) and (nat_less_than(i, n) -> v = rational.mul(whole, qpoly.qcoeff(theSubject, i))))) the-witnesses]
              @at-this-bound |
                exists u: QSeq; forall i: Nat; nat_less_than(i, n) ->
                  (isInteger(qat(u, i)) and
                  (nat_less_than(i, n) ->
                  qat(u, i) = rational.mul(whole,
                  qpoly.qcoeff(theSubject, i))))
                [using specialize the-sequences(n)]
              // drop the now-redundant inner guard: inside `i < n` the clause fires
              @conclusion-the-sequence |
                unpack u: QSeq from at-this-bound {
                  @the-guarded-match |
                    forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(u, i)) and
                      (nat_less_than(i, n) ->
                      qat(u, i) = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i))))
                    [by hypothesis conclusion-the-sequence]
                  @each-in-range |
                    fix i: Nat {
                      @given-i-below |
                        assume nat_less_than(i, n) {
                          @i-below |
                            nat_less_than(i, n)
                            [by hypothesis given-i-below]
                          @the-guarded-at-i |
                            isInteger(qat(u, i)) and
                              (nat_less_than(i, n) ->
                              qat(u, i) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, i)))
                            [using specialize the-guarded-match(i) i-below]
                          @conclusion-unguarded-at-i |
                            isInteger(qat(u, i)) and
                              qat(u, i) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, i))
                            [using tautology the-guarded-at-i i-below]
                        }
                      @below-implies |
                        nat_less_than(i, n) ->
                          (isInteger(qat(u, i)) and
                          qat(u, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i)))
                        [by discharge given-i-below]
                    }
                  @all-unguarded |
                    forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(u, i)) and
                      qat(u, i) = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i)))
                    [by generalize each-in-range]
                  @conclusion-witnessed |
                    exists u2: QSeq; forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(u2, i)) and
                      qat(u2, i) = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i)))
                    [by witness(u) all-unguarded]
                }
              @the-sequence-exported |
                exists u: QSeq; forall i: Nat; nat_less_than(i, n) ->
                  (isInteger(qat(u, i)) and
                  qat(u, i) = rational.mul(whole,
                  qpoly.qcoeff(theSubject, i)))
                [by unpacked conclusion-the-sequence]
            }
          @the-implication |
            (forall i: Nat; nat_less_than(i, n) ->
              isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
              (exists u: QSeq; forall i: Nat; nat_less_than(i, n) ->
              (isInteger(qat(u, i)) and
              qat(u, i) = rational.mul(whole,
              qpoly.qcoeff(theSubject, i))))
            [by discharge given-cleared-below]
        }
      @discharge-n |
        forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
          (exists u: QSeq; forall i: Nat; nat_less_than(i, n9) ->
          (isInteger(qat(u, i)) and
          qat(u, i) = rational.mul(whole,
          qpoly.qcoeff(theSubject, i))))
        [by generalize generalize-n]
    }
  @conclusion |
    forall whole: Q; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) ->
      isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
      (exists u: QSeq; forall i: Nat; nat_less_than(i, n) ->
      (isInteger(qat(u, i)) and
      qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i))))
    [by generalize generalize-whole]
qed

// Three projections out of `isADenominatorFor`'s meaning, read over a whole sequence.
theorem aDenominatorIsAPositiveInteger: forall t: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))) ->
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i)))
proof
  @generalize-t |
    fix t: QSeq {
      @generalize-n |
        fix n: Nat {
          @given-the-denominators |
            assume forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(t, i)) {
              @the-denominators |
                forall i: Nat; nat_less_than(i, n) ->
                  isADenominatorFor(i, qat(t, i))
                [by hypothesis given-the-denominators]
              @each-index |
                fix i: Nat {
                  @given-i-below |
                    assume nat_less_than(i, n) {
                      @i-below |
                        nat_less_than(i, n)
                        [by hypothesis given-i-below]
                      @the-spec-here |
                        isADenominatorFor(i, qat(t, i))
                        [using specialize the-denominators(i) i-below]
                      @the-meaning |
                        isADenominatorFor(i, qat(t, i)) iff
                          (isInteger(qat(t, i)) and
                          less_than(ZERO, qat(t, i)) and
                          rational.nonzero(qat(t, i)) and
                          (exists b: Q; isInteger(b) and
                          qpoly.qcoeff(theSubject, i) =
                          rational.mul(b, recip(qat(t, i)))))
                        [using specialize denominatorMeaning(i, qat(t, i))]
                      @conclusion-integer |
                        isInteger(qat(t, i))
                        [using tautology the-meaning the-spec-here]
                    }
                  @below-implies |
                    nat_less_than(i, n) -> isInteger(qat(t, i))
                    [by discharge given-i-below]
                }
              @conclusion-all |
                forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i))
                [by generalize each-index]
            }
          @the-implication |
            (forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(t, i))) ->
              (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i)))
            [by discharge given-the-denominators]
        }
      @discharge-n |
        forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          isADenominatorFor(i, qat(t, i))) ->
          (forall i: Nat; nat_less_than(i, n9) -> isInteger(qat(t, i)))
        [by generalize generalize-n]
    }
  @conclusion |
    forall t: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))) ->
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i)))
    [by generalize generalize-t]
qed

theorem aDenominatorIsNonzero: forall t: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))) ->
  (forall i: Nat; nat_less_than(i, n) -> rational.nonzero(qat(t, i)))
proof
  @generalize-t |
    fix t: QSeq {
      @generalize-n |
        fix n: Nat {
          @given-the-denominators |
            assume forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(t, i)) {
              @the-denominators |
                forall i: Nat; nat_less_than(i, n) ->
                  isADenominatorFor(i, qat(t, i))
                [by hypothesis given-the-denominators]
              @each-index |
                fix i: Nat {
                  @given-i-below |
                    assume nat_less_than(i, n) {
                      @i-below |
                        nat_less_than(i, n)
                        [by hypothesis given-i-below]
                      @the-spec-here |
                        isADenominatorFor(i, qat(t, i))
                        [using specialize the-denominators(i) i-below]
                      @the-meaning |
                        isADenominatorFor(i, qat(t, i)) iff
                          (isInteger(qat(t, i)) and
                          less_than(ZERO, qat(t, i)) and
                          rational.nonzero(qat(t, i)) and
                          (exists b: Q; isInteger(b) and
                          qpoly.qcoeff(theSubject, i) =
                          rational.mul(b, recip(qat(t, i)))))
                        [using specialize denominatorMeaning(i, qat(t, i))]
                      @conclusion-nonzero |
                        rational.nonzero(qat(t, i))
                        [using tautology the-meaning the-spec-here]
                    }
                  @below-implies |
                    nat_less_than(i, n) -> rational.nonzero(qat(t, i))
                    [by discharge given-i-below]
                }
              @conclusion-all |
                forall i: Nat; nat_less_than(i, n) ->
                  rational.nonzero(qat(t, i))
                [by generalize each-index]
            }
          @the-implication |
            (forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(t, i))) ->
              (forall i: Nat; nat_less_than(i, n) ->
              rational.nonzero(qat(t, i)))
            [by discharge given-the-denominators]
        }
      @discharge-n |
        forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          isADenominatorFor(i, qat(t, i))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          rational.nonzero(qat(t, i)))
        [by generalize generalize-n]
    }
  @conclusion |
    forall t: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))) ->
      (forall i: Nat; nat_less_than(i, n) -> rational.nonzero(qat(t, i)))
    [by generalize generalize-t]
qed

// The positivity half, added so the common denominator is POSITIVE — which is what the
// descent in stage C needs, since it well-orders the first quotient and a natural number has
// to be what it descends on.
theorem aDenominatorIsPositive: forall t: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))) ->
  (forall i: Nat; nat_less_than(i, n) -> less_than(ZERO, qat(t, i)))
proof
  @generalize-t |
    fix t: QSeq {
      @generalize-n |
        fix n: Nat {
          @given-the-denominators |
            assume forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(t, i)) {
              @the-denominators |
                forall i: Nat; nat_less_than(i, n) ->
                  isADenominatorFor(i, qat(t, i))
                [by hypothesis given-the-denominators]
              @each-index |
                fix i: Nat {
                  @given-i-below |
                    assume nat_less_than(i, n) {
                      @i-below |
                        nat_less_than(i, n)
                        [by hypothesis given-i-below]
                      @the-spec-here |
                        isADenominatorFor(i, qat(t, i))
                        [using specialize the-denominators(i) i-below]
                      @the-meaning |
                        isADenominatorFor(i, qat(t, i)) iff
                          (isInteger(qat(t, i)) and
                          less_than(ZERO, qat(t, i)) and
                          rational.nonzero(qat(t, i)) and
                          (exists b: Q; isInteger(b) and
                          qpoly.qcoeff(theSubject, i) =
                          rational.mul(b, recip(qat(t, i)))))
                        [using specialize denominatorMeaning(i, qat(t, i))]
                      @conclusion-positive |
                        less_than(ZERO, qat(t, i))
                        [using tautology the-meaning the-spec-here]
                    }
                  @below-implies |
                    nat_less_than(i, n) -> less_than(ZERO, qat(t, i))
                    [by discharge given-i-below]
                }
              @conclusion-all |
                forall i: Nat; nat_less_than(i, n) ->
                  less_than(ZERO, qat(t, i))
                [by generalize each-index]
            }
          @the-implication |
            (forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(t, i))) ->
              (forall i: Nat; nat_less_than(i, n) ->
              less_than(ZERO, qat(t, i)))
            [by discharge given-the-denominators]
        }
      @discharge-n |
        forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          isADenominatorFor(i, qat(t, i))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          less_than(ZERO, qat(t, i)))
        [by generalize generalize-n]
    }
  @conclusion |
    forall t: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))) ->
      (forall i: Nat; nat_less_than(i, n) -> less_than(ZERO, qat(t, i)))
    [by generalize generalize-t]
qed

// Step 2 over the whole index range: the product clears EVERY coefficient.
theorem theProductClearsEveryCoefficient: forall t: QSeq; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))) ->
  (forall i: Nat; nat_less_than(i, n) ->
  dividesIntegrally(qat(t, i), qProductUpTo(t, n))) ->
  (forall i: Nat; nat_less_than(i, n) ->
  isInteger(rational.mul(qProductUpTo(t, n),
  qpoly.qcoeff(theSubject, i))))
proof
  @generalize-t |
    fix t: QSeq {
      @generalize-n |
        fix n: Nat {
          @given-the-denominators |
            assume forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(t, i)) {
              @the-denominators |
                forall i: Nat; nat_less_than(i, n) ->
                  isADenominatorFor(i, qat(t, i))
                [by hypothesis given-the-denominators]
              @given-each-divides |
                assume forall i: Nat; nat_less_than(i, n) ->
                  dividesIntegrally(qat(t, i), qProductUpTo(t, n)) {
                  @each-divides |
                    forall i: Nat; nat_less_than(i, n) ->
                      dividesIntegrally(qat(t, i), qProductUpTo(t, n))
                    [by hypothesis given-each-divides]
                  @each-index |
                    fix i: Nat {
                      @given-i-below |
                        assume nat_less_than(i, n) {
                          @i-below |
                            nat_less_than(i, n)
                            [by hypothesis given-i-below]
                          @the-spec-here |
                            isADenominatorFor(i, qat(t, i))
                            [using specialize the-denominators(i) i-below]
                          @divides-here |
                            dividesIntegrally(qat(t, i), qProductUpTo(t, n))
                            [using specialize each-divides(i) i-below]
                          @conclusion-cleared |
                            isInteger(rational.mul(qProductUpTo(t, n),
                              qpoly.qcoeff(theSubject, i)))
                            [using specialize theCommonDenominatorClearsACoefficient(i, qat(t, i), qProductUpTo(t, n)) the-spec-here divides-here]
                        }
                      @below-implies |
                        nat_less_than(i, n) ->
                          isInteger(rational.mul(qProductUpTo(t, n),
                          qpoly.qcoeff(theSubject, i)))
                        [by discharge given-i-below]
                    }
                  @conclusion-all |
                    forall i: Nat; nat_less_than(i, n) ->
                      isInteger(rational.mul(qProductUpTo(t, n),
                      qpoly.qcoeff(theSubject, i)))
                    [by generalize each-index]
                }
              @divides-implies |
                (forall i: Nat; nat_less_than(i, n) ->
                  dividesIntegrally(qat(t, i), qProductUpTo(t, n))) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  isInteger(rational.mul(qProductUpTo(t, n),
                  qpoly.qcoeff(theSubject, i))))
                [by discharge given-each-divides]
            }
          @the-implication |
            (forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(t, i))) ->
              (forall i: Nat; nat_less_than(i, n) ->
              dividesIntegrally(qat(t, i), qProductUpTo(t, n))) ->
              (forall i: Nat; nat_less_than(i, n) ->
              isInteger(rational.mul(qProductUpTo(t, n),
              qpoly.qcoeff(theSubject, i))))
            [by discharge given-the-denominators]
        }
      @discharge-n |
        forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          isADenominatorFor(i, qat(t, i))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          dividesIntegrally(qat(t, i), qProductUpTo(t, n9))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          isInteger(rational.mul(qProductUpTo(t, n9),
          qpoly.qcoeff(theSubject, i))))
        [by generalize generalize-n]
    }
  @conclusion |
    forall t: QSeq; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))) ->
      (forall i: Nat; nat_less_than(i, n) ->
      dividesIntegrally(qat(t, i), qProductUpTo(t, n))) ->
      (forall i: Nat; nat_less_than(i, n) ->
      isInteger(rational.mul(qProductUpTo(t, n),
      qpoly.qcoeff(theSubject, i))))
    [by generalize generalize-t]
qed

// -- LEMMA 17.12: THE PARTS OF THE DECOMPOSITION EXIST ------------------------------------
// Judson's stages A–C, assembled: for `theSubject`'s coefficients below n there is a sequence
// of denominators whose product C is a nonzero integer, is divided by each denominator, and
// clears every coefficient.
//
// NOTE there is NO `nat_less_than(NAT_ZERO, n)` premise. A first draft carried one, and the
// dead-step lint caught that nothing used it — these stages hold for any bound, vacuously at
// ZERO. The positivity the DESCENT needs enters later, at `aLeastFirstQuotientExists`, and
// pretending it belongs here would have been a hypothesis the proof does not earn.
theorem theCommonDenominatorAndItsNumeratorsExist: forall n: Nat;
  exists denominators: QSeq;
  (forall i: Nat; nat_less_than(i, n) ->
  isADenominatorFor(i, qat(denominators, i))) and
  isInteger(qProductUpTo(denominators, n)) and
  (not (qProductUpTo(denominators, n) = ZERO)) and
  less_than(ZERO, qProductUpTo(denominators, n)) and
  (forall i: Nat; nat_less_than(i, n) ->
  dividesIntegrally(qat(denominators, i),
  qProductUpTo(denominators, n))) and
  (forall i: Nat; nat_less_than(i, n) ->
  isInteger(rational.mul(qProductUpTo(denominators, n),
  qpoly.qcoeff(theSubject, i))))
proof
  @generalize-n |
    fix n: Nat {
      // A: the denominators
      @the-denominators-exist |
        exists t: QSeq; forall i: Nat;
          nat_less_than(i, n) -> isADenominatorFor(i, qat(t, i))
        [using specialize aDenominatorSequenceExists(n)]
      @with-the-denominators |
        unpack t: QSeq from the-denominators-exist {
          @the-denominators |
            forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(t, i))
            [by hypothesis with-the-denominators]
          @the-entries-are-integers |
            forall i: Nat; nat_less_than(i, n) -> isInteger(qat(t, i))
            [using specialize aDenominatorIsAPositiveInteger(t, n) the-denominators]
          @the-entries-are-nonzero |
            forall i: Nat; nat_less_than(i, n) -> rational.nonzero(qat(t, i))
            [using specialize aDenominatorIsNonzero(t, n) the-denominators]
          // B: the product
          @the-product-is-an-integer |
            isInteger(qProductUpTo(t, n))
            [using specialize theProductOfIntegersIsAnInteger(t, n) the-entries-are-integers]
          @the-product-is-nonzero |
            not (qProductUpTo(t, n) = ZERO)
            [using specialize theProductOfNonzerosIsNonzero(t, n) the-entries-are-nonzero]
          @the-entries-are-positive |
            forall i: Nat; nat_less_than(i, n) ->
              less_than(ZERO, qat(t, i))
            [using specialize aDenominatorIsPositive(t, n) the-denominators]
          @the-product-is-positive |
            less_than(ZERO, qProductUpTo(t, n))
            [using specialize theProductOfPositivesIsPositive(t, n) the-entries-are-positive]
          @each-divides-the-product |
            forall i: Nat; nat_less_than(i, n) ->
              dividesIntegrally(qat(t, i), qProductUpTo(t, n))
            [using specialize everyEntryDividesTheProduct(t, n) the-entries-are-integers]
          // C: the product clears every coefficient
          @every-coefficient-cleared |
            forall i: Nat; nat_less_than(i, n) ->
              isInteger(rational.mul(qProductUpTo(t, n),
              qpoly.qcoeff(theSubject, i)))
            [using specialize theProductClearsEveryCoefficient(t, n) the-denominators each-divides-the-product]
          @the-full-witness |
            (forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(t, i))) and
              isInteger(qProductUpTo(t, n)) and
              (not (qProductUpTo(t, n) = ZERO)) and
              less_than(ZERO, qProductUpTo(t, n)) and
              (forall i: Nat; nat_less_than(i, n) ->
              dividesIntegrally(qat(t, i), qProductUpTo(t, n))) and
              (forall i: Nat; nat_less_than(i, n) ->
              isInteger(rational.mul(qProductUpTo(t, n),
              qpoly.qcoeff(theSubject, i))))
            [using tautology the-denominators the-product-is-an-integer the-product-is-nonzero the-product-is-positive each-divides-the-product every-coefficient-cleared]
          @conclusion-the-parts |
            exists denominators: QSeq;
              (forall i: Nat; nat_less_than(i, n) ->
              isADenominatorFor(i, qat(denominators, i))) and
              isInteger(qProductUpTo(denominators, n)) and
              (not (qProductUpTo(denominators, n) = ZERO)) and
              less_than(ZERO, qProductUpTo(denominators, n)) and
              (forall i: Nat; nat_less_than(i, n) ->
              dividesIntegrally(qat(denominators, i),
              qProductUpTo(denominators, n))) and
              (forall i: Nat; nat_less_than(i, n) ->
              isInteger(rational.mul(qProductUpTo(denominators, n),
              qpoly.qcoeff(theSubject, i))))
            [by witness(t) the-full-witness]
        }
      @the-parts-at-n |
        exists denominators: QSeq;
          (forall i: Nat; nat_less_than(i, n) ->
          isADenominatorFor(i, qat(denominators, i))) and
          isInteger(qProductUpTo(denominators, n)) and
          (not (qProductUpTo(denominators, n) = ZERO)) and
          less_than(ZERO, qProductUpTo(denominators, n)) and
          (forall i: Nat; nat_less_than(i, n) ->
          dividesIntegrally(qat(denominators, i),
          qProductUpTo(denominators, n))) and
          (forall i: Nat; nat_less_than(i, n) ->
          isInteger(rational.mul(qProductUpTo(denominators, n),
          qpoly.qcoeff(theSubject, i))))
        [by unpacked with-the-denominators]
    }
  @conclusion |
    forall n: Nat;
      exists denominators: QSeq;
      (forall i: Nat; nat_less_than(i, n) ->
      isADenominatorFor(i, qat(denominators, i))) and
      isInteger(qProductUpTo(denominators, n)) and
      (not (qProductUpTo(denominators, n) = ZERO)) and
      less_than(ZERO, qProductUpTo(denominators, n)) and
      (forall i: Nat; nat_less_than(i, n) ->
      dividesIntegrally(qat(denominators, i),
      qProductUpTo(denominators, n))) and
      (forall i: Nat; nat_less_than(i, n) ->
      isInteger(rational.mul(qProductUpTo(denominators, n),
      qpoly.qcoeff(theSubject, i))))
    [by generalize generalize-n]
qed

// Project the integrality half out of the cleared-numerator conjunction.
theorem theIntegralityOfTheNumerators: forall u: QSeq; forall whole: Q; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) ->
  (isInteger(qat(u, i)) and
  qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(u, i)))
proof
  @generalize-u |
    fix u: QSeq {
      @generalize-whole |
        fix whole: Q {
          @generalize-n |
            fix n: Nat {
              @given-the-pairs |
                assume forall i: Nat; nat_less_than(i, n) ->
                  (isInteger(qat(u, i)) and
                  qat(u, i) = rational.mul(whole,
                  qpoly.qcoeff(theSubject, i))) {
                  @the-pairs |
                    forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(u, i)) and
                      qat(u, i) = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i)))
                    [by hypothesis given-the-pairs]
                  @each-index |
                    fix i: Nat {
                      @given-i-below |
                        assume nat_less_than(i, n) {
                          @i-below |
                            nat_less_than(i, n)
                            [by hypothesis given-i-below]
                          @the-pair-at-i |
                            isInteger(qat(u, i)) and
                              qat(u, i) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, i))
                            [using specialize the-pairs(i) i-below]
                          @conclusion-integer-at-i |
                            isInteger(qat(u, i))
                            [by and_lhs the-pair-at-i]
                        }
                      @below-implies |
                        nat_less_than(i, n) -> isInteger(qat(u, i))
                        [by discharge given-i-below]
                    }
                  @conclusion-all |
                    forall i: Nat; nat_less_than(i, n) -> isInteger(qat(u, i))
                    [by generalize each-index]
                }
              @the-implication |
                (forall i: Nat; nat_less_than(i, n) ->
                  (isInteger(qat(u, i)) and
                  qat(u, i) = rational.mul(whole,
                  qpoly.qcoeff(theSubject, i)))) ->
                  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(u, i)))
                [by discharge given-the-pairs]
            }
          @discharge-n |
            forall n9: Nat;
              (forall i: Nat; nat_less_than(i, n9) ->
              (isInteger(qat(u, i)) and
              qat(u, i) = rational.mul(whole,
              qpoly.qcoeff(theSubject, i)))) ->
              (forall i: Nat; nat_less_than(i, n9) -> isInteger(qat(u, i)))
            [by generalize generalize-n]
        }
      @discharge-whole |
        forall w9: Q; forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          (isInteger(qat(u, i)) and
          qat(u, i) = rational.mul(w9,
          qpoly.qcoeff(theSubject, i)))) ->
          (forall i: Nat; nat_less_than(i, n9) -> isInteger(qat(u, i)))
        [by generalize generalize-whole]
    }
  @conclusion |
    forall u: QSeq; forall whole: Q; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) ->
      (isInteger(qat(u, i)) and
      qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(u, i)))
    [by generalize generalize-u]
qed

// The other half of the same conjunction: the numerators' VALUES.
theorem theClearedNumeratorValues: forall u: QSeq; forall whole: Q; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) ->
  (isInteger(qat(u, i)) and
  qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
  (forall i: Nat; nat_less_than(i, n) ->
  qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i)))
proof
  @generalize-u |
    fix u: QSeq {
      @generalize-whole |
        fix whole: Q {
          @generalize-n |
            fix n: Nat {
              @given-the-pairs |
                assume forall i: Nat; nat_less_than(i, n) ->
                  (isInteger(qat(u, i)) and
                  qat(u, i) = rational.mul(whole,
                  qpoly.qcoeff(theSubject, i))) {
                  @the-pairs |
                    forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(u, i)) and
                      qat(u, i) = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i)))
                    [by hypothesis given-the-pairs]
                  @each-index |
                    fix i: Nat {
                      @given-i-below |
                        assume nat_less_than(i, n) {
                          @i-below |
                            nat_less_than(i, n)
                            [by hypothesis given-i-below]
                          @the-pair-at-i |
                            isInteger(qat(u, i)) and
                              qat(u, i) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, i))
                            [using specialize the-pairs(i) i-below]
                          @conclusion-value-at-i |
                            qat(u, i) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, i))
                            [by and_rhs the-pair-at-i]
                        }
                      @below-implies |
                        nat_less_than(i, n) ->
                          qat(u, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i))
                        [by discharge given-i-below]
                    }
                  @conclusion-all |
                    forall i: Nat; nat_less_than(i, n) ->
                      qat(u, i) = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i))
                    [by generalize each-index]
                }
              @the-implication |
                (forall i: Nat; nat_less_than(i, n) ->
                  (isInteger(qat(u, i)) and
                  qat(u, i) = rational.mul(whole,
                  qpoly.qcoeff(theSubject, i)))) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  qat(u, i) = rational.mul(whole,
                  qpoly.qcoeff(theSubject, i)))
                [by discharge given-the-pairs]
            }
          @discharge-n |
            forall n9: Nat;
              (forall i: Nat; nat_less_than(i, n9) ->
              (isInteger(qat(u, i)) and
              qat(u, i) = rational.mul(whole,
              qpoly.qcoeff(theSubject, i)))) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(u, i) = rational.mul(whole,
              qpoly.qcoeff(theSubject, i)))
            [by generalize generalize-n]
        }
      @discharge-whole |
        forall w9: Q; forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          (isInteger(qat(u, i)) and
          qat(u, i) = rational.mul(w9,
          qpoly.qcoeff(theSubject, i)))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(u, i) = rational.mul(w9,
          qpoly.qcoeff(theSubject, i)))
        [by generalize generalize-whole]
    }
  @conclusion |
    forall u: QSeq; forall whole: Q; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) ->
      (isInteger(qat(u, i)) and
      qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
      (forall i: Nat; nat_less_than(i, n) ->
      qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i)))
    [by generalize generalize-u]
qed

// -- LEMMA 17.12: STAGES D-F ---------------------------------------------------------------
// From a common denominator C that clears every coefficient, produce the divisor and the
// quotient polynomial:
//
//   D  the cleared numerators u        `theClearedNumeratorSequenceExists`
//   E  the least first quotient        `aLeastFirstQuotientExists`, giving the divisor d
//   F  q with q's coefficients the quotients  `aPolynomialMatchesASequence`
//
// AN HONEST HYPOTHESIS: `less_than(ZERO, rational.mul(C, qcoeff(theSubject, NAT_ZERO)))` —
// the descent needs a POSITIVE first cleared numerator to have a floor, and `theSubject`'s
// constant coefficient may be zero or negative. Judson anchors on an actual nonzero
// coefficient without remarking on it, so this is the faithful rendering, not a gap: a caller
// supplies it by choosing which coefficient to anchor at.
theorem theDivisorAndQuotientPolynomialExist: forall whole: Q; forall n: Nat;
  nat_less_than(NAT_ZERO, n) ->
  (forall i: Nat; nat_less_than(i, n) ->
  isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
  less_than(ZERO, rational.mul(whole, qpoly.qcoeff(theSubject, NAT_ZERO))) ->
  (exists numerators: QSeq; exists least: Q;
  (forall i: Nat; nat_less_than(i, n) ->
  (isInteger(qat(numerators, i)) and
  qat(numerators, i) = rational.mul(whole,
  qpoly.qcoeff(theSubject, i)))) and
  aFirstQuotientOf(numerators, n, least) and
  (forall m: Q; isNatural(m) -> aFirstQuotientOf(numerators, n, m) ->
  (not less_than(m, least))))
proof
  @generalize-whole |
    fix whole: Q {
      @generalize-n |
        fix n: Nat {
          @given-zero-in-range |
            assume nat_less_than(NAT_ZERO, n) {
              @zero-in-range |
                nat_less_than(NAT_ZERO, n)
                [by hypothesis given-zero-in-range]
              @given-cleared |
                assume forall i: Nat; nat_less_than(i, n) ->
                  isInteger(rational.mul(whole,
                  qpoly.qcoeff(theSubject, i))) {
                  @cleared |
                    forall i: Nat; nat_less_than(i, n) ->
                      isInteger(rational.mul(whole,
                      qpoly.qcoeff(theSubject, i)))
                    [by hypothesis given-cleared]
                  @given-first-positive |
                    assume less_than(ZERO, rational.mul(whole,
                      qpoly.qcoeff(theSubject, NAT_ZERO))) {
                      @first-positive |
                        less_than(ZERO, rational.mul(whole,
                          qpoly.qcoeff(theSubject, NAT_ZERO)))
                        [by hypothesis given-first-positive]
                      // D: the cleared numerators as a sequence
                      @the-numerators-exist |
                        exists u: QSeq; forall i: Nat;
                          nat_less_than(i, n) ->
                          (isInteger(qat(u, i)) and
                          qat(u, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i)))
                        [using specialize theClearedNumeratorSequenceExists(whole, n) cleared]
                      @with-the-numerators |
                        unpack u: QSeq from the-numerators-exist {
                          @the-numerators |
                            forall i: Nat; nat_less_than(i, n) ->
                              (isInteger(qat(u, i)) and
                              qat(u, i) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, i)))
                            [by hypothesis with-the-numerators]
                          @the-entries-are-integers |
                            forall i: Nat; nat_less_than(i, n) ->
                              isInteger(qat(u, i))
                            [using specialize theIntegralityOfTheNumerators(u, whole, n) the-numerators]
                          // the first entry IS the first cleared numerator, hence positive
                          @the-first-entry |
                            isInteger(qat(u, NAT_ZERO)) and
                              qat(u, NAT_ZERO) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, NAT_ZERO))
                            [using specialize the-numerators(NAT_ZERO) zero-in-range]
                          @the-first-equation |
                            qat(u, NAT_ZERO) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, NAT_ZERO))
                            [by and_rhs the-first-entry]
                          @the-first-is-positive |
                            less_than(ZERO, qat(u, NAT_ZERO))
                            [by rewrite the-first-equation first-positive]
                          // E: the least first quotient
                          @the-least-exists |
                            exists least: Q; isNatural(least) and
                              aFirstQuotientOf(u, n, least) and
                              (forall m: Q; isNatural(m) ->
                              aFirstQuotientOf(u, n, m) ->
                              (not less_than(m, least)))
                            [using specialize aLeastFirstQuotientExists(u, n) zero-in-range the-entries-are-integers the-first-is-positive]
                          @with-the-least |
                            unpack least: Q from the-least-exists {
                              @the-least-parts |
                                isNatural(least) and
                                  aFirstQuotientOf(u, n, least) and
                                  (forall m: Q; isNatural(m) ->
                                  aFirstQuotientOf(u, n, m) ->
                                  (not less_than(m, least)))
                                [by hypothesis with-the-least]
                              @the-least-is-a-first-quotient |
                                aFirstQuotientOf(u, n, least)
                                [using tautology the-least-parts]
                              @the-minimality |
                                forall m: Q; isNatural(m) ->
                                  aFirstQuotientOf(u, n, m) ->
                                  (not less_than(m, least))
                                [using tautology the-least-parts]
                              @the-full-witness |
                                (forall i: Nat; nat_less_than(i, n) ->
                                  (isInteger(qat(u, i)) and
                                  qat(u, i) = rational.mul(whole,
                                  qpoly.qcoeff(theSubject, i)))) and
                                  aFirstQuotientOf(u, n, least) and
                                  (forall m: Q; isNatural(m) ->
                                  aFirstQuotientOf(u, n, m) ->
                                  (not less_than(m, least)))
                                [using tautology the-numerators the-least-is-a-first-quotient the-minimality]
                              @the-least-witness |
                                exists l2: Q;
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  (isInteger(qat(u, i)) and
                                  qat(u, i) = rational.mul(whole,
                                  qpoly.qcoeff(theSubject, i)))) and
                                  aFirstQuotientOf(u, n, l2) and
                                  (forall m: Q; isNatural(m) ->
                                  aFirstQuotientOf(u, n, m) ->
                                  (not less_than(m, l2)))
                                [by witness(least) the-full-witness]
                              @conclusion-both-witnesses |
                                exists numerators: QSeq; exists l2: Q;
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  (isInteger(qat(numerators, i)) and
                                  qat(numerators, i) = rational.mul(whole,
                                  qpoly.qcoeff(theSubject, i)))) and
                                  aFirstQuotientOf(numerators, n, l2) and
                                  (forall m: Q; isNatural(m) ->
                                  aFirstQuotientOf(numerators, n, m) ->
                                  (not less_than(m, l2)))
                                [by witness(u) the-least-witness]
                            }
                          @the-least-exported |
                            exists numerators: QSeq; exists l2: Q;
                              (forall i: Nat; nat_less_than(i, n) ->
                              (isInteger(qat(numerators, i)) and
                              qat(numerators, i) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, i)))) and
                              aFirstQuotientOf(numerators, n, l2) and
                              (forall m: Q; isNatural(m) ->
                              aFirstQuotientOf(numerators, n, m) ->
                              (not less_than(m, l2)))
                            [by unpacked with-the-least]
                        }
                      @the-numerators-exported |
                        exists numerators: QSeq; exists l2: Q;
                          (forall i: Nat; nat_less_than(i, n) ->
                          (isInteger(qat(numerators, i)) and
                          qat(numerators, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i)))) and
                          aFirstQuotientOf(numerators, n, l2) and
                          (forall m: Q; isNatural(m) ->
                          aFirstQuotientOf(numerators, n, m) ->
                          (not less_than(m, l2)))
                        [by unpacked with-the-numerators]
                    }
                  @first-positive-implies |
                    less_than(ZERO, rational.mul(whole,
                      qpoly.qcoeff(theSubject, NAT_ZERO))) ->
                      (exists numerators: QSeq; exists l2: Q;
                      (forall i: Nat; nat_less_than(i, n) ->
                      (isInteger(qat(numerators, i)) and
                      qat(numerators, i) = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i)))) and
                      aFirstQuotientOf(numerators, n, l2) and
                      (forall m: Q; isNatural(m) ->
                      aFirstQuotientOf(numerators, n, m) ->
                      (not less_than(m, l2))))
                    [by discharge given-first-positive]
                }
              @cleared-implies |
                (forall i: Nat; nat_less_than(i, n) ->
                  isInteger(rational.mul(whole,
                  qpoly.qcoeff(theSubject, i)))) ->
                  less_than(ZERO, rational.mul(whole,
                  qpoly.qcoeff(theSubject, NAT_ZERO))) ->
                  (exists numerators: QSeq; exists l2: Q;
                  (forall i: Nat; nat_less_than(i, n) ->
                  (isInteger(qat(numerators, i)) and
                  qat(numerators, i) = rational.mul(whole,
                  qpoly.qcoeff(theSubject, i)))) and
                  aFirstQuotientOf(numerators, n, l2) and
                  (forall m: Q; isNatural(m) ->
                  aFirstQuotientOf(numerators, n, m) ->
                  (not less_than(m, l2))))
                [by discharge given-cleared]
            }
          @the-implication |
            nat_less_than(NAT_ZERO, n) ->
              (forall i: Nat; nat_less_than(i, n) ->
              isInteger(rational.mul(whole,
              qpoly.qcoeff(theSubject, i)))) ->
              less_than(ZERO, rational.mul(whole,
              qpoly.qcoeff(theSubject, NAT_ZERO))) ->
              (exists numerators: QSeq; exists l2: Q;
              (forall i: Nat; nat_less_than(i, n) ->
              (isInteger(qat(numerators, i)) and
              qat(numerators, i) = rational.mul(whole,
              qpoly.qcoeff(theSubject, i)))) and
              aFirstQuotientOf(numerators, n, l2) and
              (forall m: Q; isNatural(m) ->
              aFirstQuotientOf(numerators, n, m) ->
              (not less_than(m, l2))))
            [by discharge given-zero-in-range]
        }
      @discharge-n |
        forall n9: Nat;
          nat_less_than(NAT_ZERO, n9) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          isInteger(rational.mul(whole,
          qpoly.qcoeff(theSubject, i)))) ->
          less_than(ZERO, rational.mul(whole,
          qpoly.qcoeff(theSubject, NAT_ZERO))) ->
          (exists numerators: QSeq; exists l2: Q;
          (forall i: Nat; nat_less_than(i, n9) ->
          (isInteger(qat(numerators, i)) and
          qat(numerators, i) = rational.mul(whole,
          qpoly.qcoeff(theSubject, i)))) and
          aFirstQuotientOf(numerators, n9, l2) and
          (forall m: Q; isNatural(m) ->
          aFirstQuotientOf(numerators, n9, m) ->
          (not less_than(m, l2))))
        [by generalize generalize-n]
    }
  @conclusion |
    forall whole: Q; forall n: Nat;
      nat_less_than(NAT_ZERO, n) ->
      (forall i: Nat; nat_less_than(i, n) ->
      isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
      less_than(ZERO, rational.mul(whole,
      qpoly.qcoeff(theSubject, NAT_ZERO))) ->
      (exists numerators: QSeq; exists least: Q;
      (forall i: Nat; nat_less_than(i, n) ->
      (isInteger(qat(numerators, i)) and
      qat(numerators, i) = rational.mul(whole,
      qpoly.qcoeff(theSubject, i)))) and
      aFirstQuotientOf(numerators, n, least) and
      (forall m: Q; isNatural(m) -> aFirstQuotientOf(numerators, n, m) ->
      (not less_than(m, least))))
    [by generalize generalize-whole]
qed

// -- A MAXIMAL COMMON DIVISOR OF A PAIR EXISTS --------------------------------------------
// Step 4 (`theReducedFractionIsInLowestTerms`) takes its `g` as a HYPOTHESIS; every occurrence
// of `isAMaximalCommonDivisorOfThePair` in this file is a premise, never a conclusion. This is
// its existence, and it is the last thing the packaging needs.
//
// A PAIR IS A TWO-ELEMENT SEQUENCE, so the sequence descent applies verbatim rather than
// being redone: build `[a, b]` with `qSeqConcatOnly` on two singletons, take the least first
// quotient (`aLeastFirstQuotientExists`), and the divisor achieving it has coprime quotients.
//
// What this yields is the WEAKER relational form the statement actually needs — a divisor
// whose quotients are coprime — not a constructed gcd. `isAMaximalCommonDivisorOfThePair`
// asks for maximality, which is strictly stronger; the pair version below is phrased in the
// coprime-quotients form to match what step 4 consumes through
// `theReducedFractionIsCoprime`.
theorem aTwoElementSequenceExists: forall a, b: Q;
  exists s: QSeq;
  qat(s, NAT_ZERO) = a and qat(s, nat_succ(NAT_ZERO)) = b
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @the-first-exists |
            exists s: QSeq; qat(s, NAT_ZERO) = a
            [using specialize qSeqSingletonOnly(a)]
          @with-the-first |
            unpack sa: QSeq from the-first-exists {
              @the-first |
                qat(sa, NAT_ZERO) = a
                [by hypothesis with-the-first]
              @the-second-exists |
                exists s: QSeq; qat(s, NAT_ZERO) = b
                [using specialize qSeqSingletonOnly(b)]
              @with-the-second |
                unpack sb: QSeq from the-second-exists {
                  @the-second |
                    qat(sb, NAT_ZERO) = b
                    [by hypothesis with-the-second]
                  // concatenate one entry of sa with one of sb
                  @the-concat-exists |
                    exists u: QSeq;
                      (forall i: Nat; nat_less_than(i, nat_succ(NAT_ZERO)) ->
                      qat(u, i) = qat(sa, i))
                      and (forall i: Nat;
                      nat_less_than(i, nat_succ(NAT_ZERO)) ->
                      qat(u, nat_add(nat_succ(NAT_ZERO), i)) =
                      qat(sb, i))
                    [using specialize qSeqConcatOnly(sa, sb, nat_succ(NAT_ZERO), nat_succ(NAT_ZERO))]
                  @with-the-concat |
                    unpack u: QSeq from the-concat-exists {
                      @the-concat |
                        (forall i: Nat; nat_less_than(i, nat_succ(NAT_ZERO)) ->
                          qat(u, i) = qat(sa, i))
                          and (forall i: Nat;
                          nat_less_than(i, nat_succ(NAT_ZERO)) ->
                          qat(u, nat_add(nat_succ(NAT_ZERO), i)) =
                          qat(sb, i))
                        [by hypothesis with-the-concat]
                      @below-one-matches-sa |
                        forall i: Nat; nat_less_than(i, nat_succ(NAT_ZERO)) ->
                          qat(u, i) = qat(sa, i)
                        [by and_lhs the-concat]
                      @shifted-matches-sb |
                        forall i: Nat; nat_less_than(i, nat_succ(NAT_ZERO)) ->
                          qat(u, nat_add(nat_succ(NAT_ZERO), i)) = qat(sb, i)
                        [by and_rhs the-concat]
                      @zero-below-one |
                        nat_less_than(NAT_ZERO, nat_succ(NAT_ZERO))
                        [using specialize peano_order.lessThanSelf(NAT_ZERO)]
                      @u-at-zero-is-sa-at-zero |
                        qat(u, NAT_ZERO) = qat(sa, NAT_ZERO)
                        [using specialize below-one-matches-sa(NAT_ZERO) zero-below-one]
                      @u-at-zero |
                        qat(u, NAT_ZERO) = a
                        [using simplify u-at-zero-is-sa-at-zero the-first]
                      @u-at-shifted-zero |
                        qat(u, nat_add(nat_succ(NAT_ZERO), NAT_ZERO)) =
                          qat(sb, NAT_ZERO)
                        [using specialize shifted-matches-sb(NAT_ZERO) zero-below-one]
                      @one-plus-zero |
                        nat_add(nat_succ(NAT_ZERO), NAT_ZERO) =
                          nat_succ(NAT_ZERO)
                        [using specialize peano.addZeroRight(nat_succ(NAT_ZERO))]
                      @u-at-one-is-sb-at-zero |
                        qat(u, nat_succ(NAT_ZERO)) = qat(sb, NAT_ZERO)
                        [by rewrite one-plus-zero u-at-shifted-zero]
                      @u-at-one |
                        qat(u, nat_succ(NAT_ZERO)) = b
                        [using simplify u-at-one-is-sb-at-zero the-second]
                      @both-entries |
                        qat(u, NAT_ZERO) = a and
                          qat(u, nat_succ(NAT_ZERO)) = b
                        [by both u-at-zero u-at-one]
                      @conclusion-the-pair |
                        exists s: QSeq;
                          qat(s, NAT_ZERO) = a and
                          qat(s, nat_succ(NAT_ZERO)) = b
                        [by witness(u) both-entries]
                    }
                  @concat-exported |
                    exists s: QSeq;
                      qat(s, NAT_ZERO) = a and
                      qat(s, nat_succ(NAT_ZERO)) = b
                    [by unpacked with-the-concat]
                }
              @second-exported |
                exists s: QSeq;
                  qat(s, NAT_ZERO) = a and
                  qat(s, nat_succ(NAT_ZERO)) = b
                [by unpacked with-the-second]
            }
          @first-exported |
            exists s: QSeq;
              qat(s, NAT_ZERO) = a and
              qat(s, nat_succ(NAT_ZERO)) = b
            [by unpacked with-the-first]
        }
      @discharge-b |
        forall b9: Q;
          exists s: QSeq;
          qat(s, NAT_ZERO) = a and
          qat(s, nat_succ(NAT_ZERO)) = b9
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q;
      exists s: QSeq;
      qat(s, NAT_ZERO) = a and qat(s, nat_succ(NAT_ZERO)) = b
    [by generalize generalize-a]
qed

// -- DIVISIBILITY AND SIGN ----------------------------------------------------------------
// Coprimality quantifies over EVERY integer divisor, while the descent step only speaks about
// POSITIVE ones. These two facts close that gap: a negative divisor divides exactly what its
// negation does, so the positive case covers all of them.

// `neg(e)` divides whatever `e` does: negate the quotient.
theorem theNegationDividesTheSame: forall e, m: Q;
  dividesIntegrally(e, m) -> dividesIntegrally(rational.neg(e), m)
proof
  @generalize-e |
    fix e: Q {
      @generalize-m |
        fix m: Q {
          @given-e-divides |
            assume dividesIntegrally(e, m) {
              @e-divides |
                dividesIntegrally(e, m)
                [by hypothesis given-e-divides]
              @the-meaning |
                dividesIntegrally(e, m) iff
                  (exists k: Q; isInteger(k) and m = rational.mul(e, k))
                [using specialize dividesIntegrallyMeaning(e, m)]
              @a-quotient-exists |
                exists k: Q; isInteger(k) and m = rational.mul(e, k)
                [using tautology the-meaning e-divides]
              @with-the-quotient |
                unpack k: Q from a-quotient-exists {
                  @with-quotient-k |
                    isInteger(k) and m = rational.mul(e, k)
                    [by hypothesis with-the-quotient]
                  @k-is-an-integer |
                    isInteger(k)
                    [by and_lhs with-quotient-k]
                  @m-is-e-times-k |
                    m = rational.mul(e, k)
                    [by and_rhs with-quotient-k]
                  @neg-k-is-an-integer |
                    isInteger(rational.neg(k))
                    [using specialize rational.isIntegerNeg(k) k-is-an-integer]
                  // e·k = (-e)·(-k)
                  @the-negations-multiply |
                    forall x, y: Q;
                      rational.mul(rational.neg(x), rational.neg(y)) =
                      rational.mul(x, y)
                    [using model(rational.RationalOrderedField) field_order.negMulNeg]
                  @at-e-and-k |
                    rational.mul(rational.neg(e), rational.neg(k)) =
                      rational.mul(e, k)
                    [using specialize the-negations-multiply(e, k)]
                  @m-is-the-negated-product |
                    m = rational.mul(rational.neg(e), rational.neg(k))
                    [by rewrite at-e-and-k m-is-e-times-k]
                  @the-witness-works |
                    isInteger(rational.neg(k)) and
                      m = rational.mul(rational.neg(e), rational.neg(k))
                    [by both neg-k-is-an-integer m-is-the-negated-product]
                  @a-negated-quotient-exists |
                    exists k2: Q; isInteger(k2) and
                      m = rational.mul(rational.neg(e), k2)
                    [by witness(rational.neg(k)) the-witness-works]
                  @the-negated-meaning |
                    dividesIntegrally(rational.neg(e), m) iff
                      (exists k2: Q; isInteger(k2) and
                      m = rational.mul(rational.neg(e), k2))
                    [using specialize dividesIntegrallyMeaning(rational.neg(e), m)]
                  @conclusion-negation-divides |
                    dividesIntegrally(rational.neg(e), m)
                    [using tautology the-negated-meaning a-negated-quotient-exists]
                }
              @conclusion-exported |
                dividesIntegrally(rational.neg(e), m)
                [by unpacked with-the-quotient]
            }
          @divides-implies |
            dividesIntegrally(e, m) ->
              dividesIntegrally(rational.neg(e), m)
            [by discharge given-e-divides]
        }
      @discharge-m |
        forall m9: Q;
          dividesIntegrally(e, m9) ->
          dividesIntegrally(rational.neg(e), m9)
        [by generalize generalize-m]
    }
  @conclusion |
    forall e, m: Q;
      dividesIntegrally(e, m) -> dividesIntegrally(rational.neg(e), m)
    [by generalize generalize-e]
qed

// And back: if `neg(e)` divides m then so does `e`, since `e = neg(neg(e))`. The two together
// make divisibility sign-blind, which is what lets the positive-only descent cover every
// integer divisor.
theorem divisibilityIsSignBlind: forall e, m: Q;
  dividesIntegrally(rational.neg(e), m) -> dividesIntegrally(e, m)
proof
  @generalize-e |
    fix e: Q {
      @generalize-m |
        fix m: Q {
          @given-the-negation-divides |
            assume dividesIntegrally(rational.neg(e), m) {
              @the-negation-divides |
                dividesIntegrally(rational.neg(e), m)
                [by hypothesis given-the-negation-divides]
              // neg(neg(e)) divides m, and that IS e
              @the-double-negation-divides |
                dividesIntegrally(rational.neg(rational.neg(e)), m)
                [using specialize theNegationDividesTheSame(rational.neg(e), m) the-negation-divides]
              @double-negation |
                forall x: Q; rational.neg(rational.neg(x)) = x
                [using model(rational.RationalOrderedField) field_order.negNeg]
              @at-e |
                rational.neg(rational.neg(e)) = e
                [using specialize double-negation(e)]
              @conclusion-e-divides |
                dividesIntegrally(e, m)
                [by rewrite at-e the-double-negation-divides]
            }
          @negation-implies |
            dividesIntegrally(rational.neg(e), m) ->
              dividesIntegrally(e, m)
            [by discharge given-the-negation-divides]
        }
      @discharge-m |
        forall m9: Q;
          dividesIntegrally(rational.neg(e), m9) ->
          dividesIntegrally(e, m9)
        [by generalize generalize-m]
    }
  @conclusion |
    forall e, m: Q;
      dividesIntegrally(rational.neg(e), m) -> dividesIntegrally(e, m)
    [by generalize generalize-e]
qed

// ZERO cannot divide a nonzero value: `m = 0·k = 0`. This rules out the `e = 0` arm of the
// sign split, given a positive first quotient.
theorem zeroDividesOnlyZero: forall m: Q;
  dividesIntegrally(ZERO, m) -> m = ZERO
proof
  @generalize-m |
    fix m: Q {
      @given-zero-divides |
        assume dividesIntegrally(ZERO, m) {
          @zero-divides |
            dividesIntegrally(ZERO, m)
            [by hypothesis given-zero-divides]
          @the-meaning |
            dividesIntegrally(ZERO, m) iff
              (exists k: Q; isInteger(k) and m = rational.mul(ZERO, k))
            [using specialize dividesIntegrallyMeaning(ZERO, m)]
          @a-quotient-exists |
            exists k: Q; isInteger(k) and m = rational.mul(ZERO, k)
            [using tautology the-meaning zero-divides]
          @with-the-quotient |
            unpack k: Q from a-quotient-exists {
              @with-quotient-k |
                isInteger(k) and m = rational.mul(ZERO, k)
                [by hypothesis with-the-quotient]
              @m-is-zero-times-k |
                m = rational.mul(ZERO, k)
                [by and_rhs with-quotient-k]
              @zero-times-k |
                rational.mul(ZERO, k) = ZERO
                [using specialize rational.mulZeroLeft(k)]
              @conclusion-m-is-zero |
                m = ZERO
                [by rewrite zero-times-k m-is-zero-times-k]
            }
          @conclusion-exported |
            m = ZERO
            [by unpacked with-the-quotient]
        }
      @divides-implies |
        dividesIntegrally(ZERO, m) -> m = ZERO
        [by discharge given-zero-divides]
    }
  @conclusion |
    forall m: Q; dividesIntegrally(ZERO, m) -> m = ZERO
    [by generalize generalize-m]
qed

// A quotient entry IS an integer. The divisor divides each entry INTEGRALLY, so `s_i = d·k`
// for some integer k; and `s_i = d·q_i` by the quotient relation, so cancelling the nonzero d
// identifies `q_i` with k. Without the cancellation step the two quotients need not agree.
theorem aQuotientEntryIsAnInteger:
  forall s, q: QSeq; forall n: Nat; forall d, m: Q;
  nat_less_than(NAT_ZERO, n) ->
  (isInteger(d) and less_than(ZERO, d) and
  isACommonDivisorUpTo(d, s, n) and
  aQuotientSequenceFor(d, s, q, n) and
  qat(q, NAT_ZERO) = m) ->
  isInteger(m)
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-q |
        fix q: QSeq {
          @generalize-n |
            fix n: Nat {
              @generalize-d |
                fix d: Q {
                  @generalize-m |
                    fix m: Q {
                      @given-zero-in-range |
                        assume nat_less_than(NAT_ZERO, n) {
                          @zero-in-range |
                            nat_less_than(NAT_ZERO, n)
                            [by hypothesis given-zero-in-range]
                          @given-the-parts |
                            assume isInteger(d) and less_than(ZERO, d) and
                              isACommonDivisorUpTo(d, s, n) and
                              aQuotientSequenceFor(d, s, q, n) and
                              qat(q, NAT_ZERO) = m {
                              @the-parts |
                                isInteger(d) and less_than(ZERO, d) and
                                  isACommonDivisorUpTo(d, s, n) and
                                  aQuotientSequenceFor(d, s, q, n) and
                                  qat(q, NAT_ZERO) = m
                                [by hypothesis given-the-parts]
                              @d-positive |
                                less_than(ZERO, d)
                                [using tautology the-parts]
                              @d-divides |
                                isACommonDivisorUpTo(d, s, n)
                                [using tautology the-parts]
                              @the-quotients |
                                aQuotientSequenceFor(d, s, q, n)
                                [using tautology the-parts]
                              @the-first-is-m |
                                qat(q, NAT_ZERO) = m
                                [using tautology the-parts]
                              @d-is-nonzero |
                                rational.nonzero(d)
                                [using specialize rational_integer_order.aPositiveIsNonzeroPredicate(d) d-positive]
                              // d divides s_0 integrally: s_0 = d * k, k an integer
                              @the-divisor-meaning |
                                isACommonDivisorUpTo(d, s, n) iff
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  dividesIntegrally(d, qat(s, i)))
                                [using specialize commonDivisorMeaning(d, s, n)]
                              @d-divides-each |
                                forall i: Nat; nat_less_than(i, n) ->
                                  dividesIntegrally(d, qat(s, i))
                                [using tautology the-divisor-meaning d-divides]
                              @d-divides-the-first |
                                dividesIntegrally(d, qat(s, NAT_ZERO))
                                [using specialize d-divides-each(NAT_ZERO) zero-in-range]
                              @the-divides-meaning |
                                dividesIntegrally(d, qat(s, NAT_ZERO)) iff
                                  (exists k: Q; isInteger(k) and
                                  qat(s, NAT_ZERO) = rational.mul(d, k))
                                [using specialize dividesIntegrallyMeaning(d, qat(s, NAT_ZERO))]
                              @an-integer-quotient |
                                exists k: Q; isInteger(k) and
                                  qat(s, NAT_ZERO) = rational.mul(d, k)
                                [using tautology the-divides-meaning d-divides-the-first]
                              // and s_0 = d * q_0 by the quotient relation
                              @the-quotient-meaning |
                                aQuotientSequenceFor(d, s, q, n) iff
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(d, qat(q, i)))
                                [using specialize quotientSequenceMeaning(d, s, q, n)]
                              @the-factorization |
                                forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(d, qat(q, i))
                                [using tautology the-quotient-meaning the-quotients]
                              @the-first-factorization |
                                qat(s, NAT_ZERO) =
                                  rational.mul(d, qat(q, NAT_ZERO))
                                [using specialize the-factorization(NAT_ZERO) zero-in-range]
                              @with-the-integer-quotient |
                                unpack k: Q from an-integer-quotient {
                                  @with-quotient-k |
                                    isInteger(k) and
                                      qat(s, NAT_ZERO) = rational.mul(d, k)
                                    [by hypothesis with-the-integer-quotient]
                                  @k-is-an-integer |
                                    isInteger(k)
                                    [by and_lhs with-quotient-k]
                                  @s-first-is-d-times-k |
                                    qat(s, NAT_ZERO) = rational.mul(d, k)
                                    [by and_rhs with-quotient-k]
                                  // d*q_0 = d*k, cancel d
                                  @the-products-agree |
                                    rational.mul(d, qat(q, NAT_ZERO)) =
                                      rational.mul(d, k)
                                    [by rewrite the-first-factorization s-first-is-d-times-k]
                                  @the-quotients-agree |
                                    qat(q, NAT_ZERO) = k
                                    [using specialize aNonzeroFactorCancels(d, qat(q, NAT_ZERO), k) d-is-nonzero the-products-agree]
                                  @the-first-is-an-integer |
                                    isInteger(qat(q, NAT_ZERO))
                                    [by rewrite the-quotients-agree k-is-an-integer]
                                  @conclusion-m-is-an-integer |
                                    isInteger(m)
                                    [by rewrite the-first-is-m the-first-is-an-integer]
                                }
                              @conclusion-exported |
                                isInteger(m)
                                [by unpacked with-the-integer-quotient]
                            }
                          @parts-implies |
                            (isInteger(d) and less_than(ZERO, d) and
                              isACommonDivisorUpTo(d, s, n) and
                              aQuotientSequenceFor(d, s, q, n) and
                              qat(q, NAT_ZERO) = m) ->
                              isInteger(m)
                            [by discharge given-the-parts]
                        }
                      @the-implication |
                        nat_less_than(NAT_ZERO, n) ->
                          (isInteger(d) and less_than(ZERO, d) and
                          isACommonDivisorUpTo(d, s, n) and
                          aQuotientSequenceFor(d, s, q, n) and
                          qat(q, NAT_ZERO) = m) ->
                          isInteger(m)
                        [by discharge given-zero-in-range]
                    }
                  @discharge-m |
                    forall m9: Q;
                      nat_less_than(NAT_ZERO, n) ->
                      (isInteger(d) and less_than(ZERO, d) and
                      isACommonDivisorUpTo(d, s, n) and
                      aQuotientSequenceFor(d, s, q, n) and
                      qat(q, NAT_ZERO) = m9) ->
                      isInteger(m9)
                    [by generalize generalize-m]
                }
              @discharge-d |
                forall d9: Q; forall m9: Q;
                  nat_less_than(NAT_ZERO, n) ->
                  (isInteger(d9) and less_than(ZERO, d9) and
                  isACommonDivisorUpTo(d9, s, n) and
                  aQuotientSequenceFor(d9, s, q, n) and
                  qat(q, NAT_ZERO) = m9) ->
                  isInteger(m9)
                [by generalize generalize-d]
            }
          @discharge-n |
            forall n9: Nat; forall d9: Q; forall m9: Q;
              nat_less_than(NAT_ZERO, n9) ->
              (isInteger(d9) and less_than(ZERO, d9) and
              isACommonDivisorUpTo(d9, s, n9) and
              aQuotientSequenceFor(d9, s, q, n9) and
              qat(q, NAT_ZERO) = m9) ->
              isInteger(m9)
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q9: QSeq; forall n9: Nat; forall d9: Q; forall m9: Q;
          nat_less_than(NAT_ZERO, n9) ->
          (isInteger(d9) and less_than(ZERO, d9) and
          isACommonDivisorUpTo(d9, s, n9) and
          aQuotientSequenceFor(d9, s, q9, n9) and
          qat(q9, NAT_ZERO) = m9) ->
          isInteger(m9)
        [by generalize generalize-q]
    }
  @conclusion |
    forall s, q: QSeq; forall n: Nat; forall d, m: Q;
      nat_less_than(NAT_ZERO, n) ->
      (isInteger(d) and less_than(ZERO, d) and
      isACommonDivisorUpTo(d, s, n) and
      aQuotientSequenceFor(d, s, q, n) and
      qat(q, NAT_ZERO) = m) ->
      isInteger(m)
    [by generalize generalize-s]
qed

// A first quotient is NATURAL — but only when the sequence's own first entry is positive.
//
// CHECKED BEFORE WRITING, and the naive form is FALSE: `aFirstQuotientOf` says only that the
// divisor `d` is positive, so `q_0 = s_0 / d` is positive exactly when `s_0` is. The `s_0 > 0`
// premise is therefore load-bearing, not decoration — and it is available at every call site,
// since the whole descent is premised on it.
theorem aFirstQuotientIsNatural: forall s: QSeq; forall n: Nat; forall m: Q;
  nat_less_than(NAT_ZERO, n) ->
  less_than(ZERO, qat(s, NAT_ZERO)) ->
  aFirstQuotientOf(s, n, m) -> isNatural(m)
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-n |
        fix n: Nat {
          @generalize-m |
            fix m: Q {
              @given-zero-in-range |
                assume nat_less_than(NAT_ZERO, n) {
                  @zero-in-range |
                    nat_less_than(NAT_ZERO, n)
                    [by hypothesis given-zero-in-range]
                  @given-first-positive |
                    assume less_than(ZERO, qat(s, NAT_ZERO)) {
                      @first-positive |
                        less_than(ZERO, qat(s, NAT_ZERO))
                        [by hypothesis given-first-positive]
                      @given-m-is-a-first-quotient |
                        assume aFirstQuotientOf(s, n, m) {
                          @m-is-a-first-quotient |
                            aFirstQuotientOf(s, n, m)
                            [by hypothesis given-m-is-a-first-quotient]
                          @the-meaning |
                            aFirstQuotientOf(s, n, m) iff
                              (exists d: Q; exists q: QSeq;
                              isInteger(d) and less_than(ZERO, d) and
                              isACommonDivisorUpTo(d, s, n) and
                              aQuotientSequenceFor(d, s, q, n) and
                              qat(q, NAT_ZERO) = m)
                            [using specialize firstQuotientMeaning(s, n, m)]
                          @the-divisor-exists |
                            exists d: Q; exists q: QSeq;
                              isInteger(d) and less_than(ZERO, d) and
                              isACommonDivisorUpTo(d, s, n) and
                              aQuotientSequenceFor(d, s, q, n) and
                              qat(q, NAT_ZERO) = m
                            [using tautology the-meaning m-is-a-first-quotient]
                          @with-the-divisor |
                            unpack d: Q from the-divisor-exists {
                              @the-sequence-exists |
                                exists q: QSeq;
                                  isInteger(d) and less_than(ZERO, d) and
                                  isACommonDivisorUpTo(d, s, n) and
                                  aQuotientSequenceFor(d, s, q, n) and
                                  qat(q, NAT_ZERO) = m
                                [by hypothesis with-the-divisor]
                              @with-the-sequence |
                                unpack q: QSeq from the-sequence-exists {
                                  @the-parts |
                                    isInteger(d) and less_than(ZERO, d) and
                                      isACommonDivisorUpTo(d, s, n) and
                                      aQuotientSequenceFor(d, s, q, n) and
                                      qat(q, NAT_ZERO) = m
                                    [by hypothesis with-the-sequence]
                                  @d-positive |
                                    less_than(ZERO, d)
                                    [using tautology the-parts]
                                  @the-quotients |
                                    aQuotientSequenceFor(d, s, q, n)
                                    [using tautology the-parts]
                                  @the-first-is-m |
                                    qat(q, NAT_ZERO) = m
                                    [using tautology the-parts]
                                  @the-quotient-meaning |
                                    aQuotientSequenceFor(d, s, q, n) iff
                                      (forall i: Nat; nat_less_than(i, n) ->
                                      qat(s, i) = rational.mul(d, qat(q, i)))
                                    [using specialize quotientSequenceMeaning(d, s, q, n)]
                                  @the-factorization |
                                    forall i: Nat; nat_less_than(i, n) ->
                                      qat(s, i) = rational.mul(d, qat(q, i))
                                    [using tautology the-quotient-meaning the-quotients]
                                  @the-first-factorization |
                                    qat(s, NAT_ZERO) =
                                      rational.mul(d, qat(q, NAT_ZERO))
                                    [using specialize the-factorization(NAT_ZERO) zero-in-range]
                                  @the-product-positive |
                                    less_than(ZERO,
                                      rational.mul(d, qat(q, NAT_ZERO)))
                                    [by rewrite the-first-factorization first-positive]
                                  @the-product-is-itself |
                                    rational.mul(d, qat(q, NAT_ZERO)) =
                                      rational.mul(d, qat(q, NAT_ZERO))
                                    [by reflexivity]
                                  @the-first-quotient-positive |
                                    less_than(ZERO, qat(q, NAT_ZERO))
                                    [using specialize theCofactorOfAPositiveIsPositive(d, qat(q, NAT_ZERO), rational.mul(d, qat(q, NAT_ZERO))) d-positive the-product-positive the-product-is-itself]
                                  @m-positive |
                                    less_than(ZERO, m)
                                    [by rewrite the-first-is-m the-first-quotient-positive]
                                  // and m is an integer: it is a quotient entry
                                  @m-is-an-integer |
                                    isInteger(m)
                                    [using specialize aQuotientEntryIsAnInteger(s, q, n, d, m) zero-in-range the-parts]
                                  @conclusion-natural |
                                    isNatural(m)
                                    [using specialize rational_integer_order.aPositiveIntegerIsNatural(m) m-is-an-integer m-positive]
                                }
                              @sequence-exported |
                                isNatural(m)
                                [by unpacked with-the-sequence]
                            }
                          @divisor-exported |
                            isNatural(m)
                            [by unpacked with-the-divisor]
                        }
                      @first-quotient-implies |
                        aFirstQuotientOf(s, n, m) -> isNatural(m)
                        [by discharge given-m-is-a-first-quotient]
                    }
                  @first-positive-implies |
                    less_than(ZERO, qat(s, NAT_ZERO)) ->
                      aFirstQuotientOf(s, n, m) -> isNatural(m)
                    [by discharge given-first-positive]
                }
              @the-implication |
                nat_less_than(NAT_ZERO, n) ->
                  less_than(ZERO, qat(s, NAT_ZERO)) ->
                  aFirstQuotientOf(s, n, m) -> isNatural(m)
                [by discharge given-zero-in-range]
            }
          @discharge-m |
            forall m9: Q;
              nat_less_than(NAT_ZERO, n) ->
              less_than(ZERO, qat(s, NAT_ZERO)) ->
              aFirstQuotientOf(s, n, m9) -> isNatural(m9)
            [by generalize generalize-m]
        }
      @discharge-n |
        forall n9: Nat; forall m9: Q;
          nat_less_than(NAT_ZERO, n9) ->
          less_than(ZERO, qat(s, NAT_ZERO)) ->
          aFirstQuotientOf(s, n9, m9) -> isNatural(m9)
        [by generalize generalize-n]
    }
  @conclusion |
    forall s: QSeq; forall n: Nat; forall m: Q;
      nat_less_than(NAT_ZERO, n) ->
      less_than(ZERO, qat(s, NAT_ZERO)) ->
      aFirstQuotientOf(s, n, m) -> isNatural(m)
    [by generalize generalize-s]
qed
// Negation lifts over the whole range: `neg(e)` divides each entry `e` does.
theorem theNegationDividesEachEntry: forall q: QSeq; forall e: Q; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e, qat(q, i))) ->
  (forall i: Nat; nat_less_than(i, n) ->
  dividesIntegrally(rational.neg(e), qat(q, i)))
proof
  @generalize-q |
    fix q: QSeq {
      @generalize-e |
        fix e: Q {
          @generalize-n |
            fix n: Nat {
              @given-divides |
                assume forall i: Nat; nat_less_than(i, n) ->
                  dividesIntegrally(e, qat(q, i)) {
                  @divides |
                    forall i: Nat; nat_less_than(i, n) ->
                      dividesIntegrally(e, qat(q, i))
                    [by hypothesis given-divides]
                  @each-index |
                    fix i: Nat {
                      @given-i-below |
                        assume nat_less_than(i, n) {
                          @i-below |
                            nat_less_than(i, n)
                            [by hypothesis given-i-below]
                          @divides-here |
                            dividesIntegrally(e, qat(q, i))
                            [using specialize divides(i) i-below]
                          @conclusion-negation-divides |
                            dividesIntegrally(rational.neg(e), qat(q, i))
                            [using specialize theNegationDividesTheSame(e, qat(q, i)) divides-here]
                        }
                      @below-implies |
                        nat_less_than(i, n) ->
                          dividesIntegrally(rational.neg(e), qat(q, i))
                        [by discharge given-i-below]
                    }
                  @conclusion-all |
                    forall i: Nat; nat_less_than(i, n) ->
                      dividesIntegrally(rational.neg(e), qat(q, i))
                    [by generalize each-index]
                }
              @the-implication |
                (forall i: Nat; nat_less_than(i, n) ->
                  dividesIntegrally(e, qat(q, i))) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  dividesIntegrally(rational.neg(e), qat(q, i)))
                [by discharge given-divides]
            }
          @discharge-n |
            forall n9: Nat;
              (forall i: Nat; nat_less_than(i, n9) ->
              dividesIntegrally(e, qat(q, i))) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              dividesIntegrally(rational.neg(e), qat(q, i)))
            [by generalize generalize-n]
        }
      @discharge-e |
        forall e9: Q; forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          dividesIntegrally(e9, qat(q, i))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          dividesIntegrally(rational.neg(e9), qat(q, i)))
        [by generalize generalize-e]
    }
  @conclusion |
    forall q: QSeq; forall e: Q; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) -> dividesIntegrally(e, qat(q, i))) ->
      (forall i: Nat; nat_less_than(i, n) ->
      dividesIntegrally(rational.neg(e), qat(q, i)))
    [by generalize generalize-q]
qed

// THE POSITIVE CASE. A positive integer dividing every quotient must be a unit: otherwise the
// descent step gives a strictly smaller first quotient, contradicting leastness.
theorem thePositiveCaseIsAUnit:
  forall s, q: QSeq; forall n: Nat; forall d, least, e: Q;
  (nat_less_than(NAT_ZERO, n) and isInteger(d) and less_than(ZERO, d) and
  (forall i: Nat; nat_less_than(i, n) ->
  qat(s, i) = rational.mul(d, qat(q, i))) and
  less_than(ZERO, qat(q, NAT_ZERO)) and
  qat(q, NAT_ZERO) = least and
  (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
  (not less_than(m, least)))) ->
  isInteger(e) -> less_than(ZERO, e) ->
  (forall i: Nat; nat_less_than(i, n) ->
  dividesIntegrally(e, qat(q, i))) ->
  dividesIntegrally(e, ONE)
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-q |
        fix q: QSeq {
          @generalize-n |
            fix n: Nat {
              @generalize-d |
                fix d: Q {
                  @generalize-least |
                    fix least: Q {
                      @generalize-e |
                        fix e: Q {
                          @given-the-context |
                            assume nat_less_than(NAT_ZERO, n) and
                              isInteger(d) and less_than(ZERO, d) and
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) and
                              less_than(ZERO, qat(q, NAT_ZERO)) and
                              qat(q, NAT_ZERO) = least and
                              (forall m: Q; isNatural(m) ->
                              aFirstQuotientOf(s, n, m) ->
                              (not less_than(m, least))) {
                              @the-context |
                                nat_less_than(NAT_ZERO, n) and
                                  isInteger(d) and less_than(ZERO, d) and
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(d, qat(q, i))) and
                                  less_than(ZERO, qat(q, NAT_ZERO)) and
                                  qat(q, NAT_ZERO) = least and
                                  (forall m: Q; isNatural(m) ->
                                  aFirstQuotientOf(s, n, m) ->
                                  (not less_than(m, least)))
                                [by hypothesis given-the-context]
                              @zero-in-range |
                                nat_less_than(NAT_ZERO, n)
                                [using tautology the-context]
                              @d-is-an-integer |
                                isInteger(d)
                                [using tautology the-context]
                              @d-positive |
                                less_than(ZERO, d)
                                [using tautology the-context]
                              @the-factorization |
                                forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(d, qat(q, i))
                                [using tautology the-context]
                              @first-positive |
                                less_than(ZERO, qat(q, NAT_ZERO))
                                [using tautology the-context]
                              @the-first-is-least |
                                qat(q, NAT_ZERO) = least
                                [using tautology the-context]
                              @the-minimality |
                                forall m: Q; isNatural(m) ->
                                  aFirstQuotientOf(s, n, m) ->
                                  (not less_than(m, least))
                                [using tautology the-context]
                              @given-e-is-an-integer |
                                assume isInteger(e) {
                                  @e-is-an-integer |
                                    isInteger(e)
                                    [by hypothesis given-e-is-an-integer]
                                  @given-e-positive |
                                    assume less_than(ZERO, e) {
                                      @e-positive |
                                        less_than(ZERO, e)
                                        [by hypothesis given-e-positive]
                                      @given-e-divides |
                                        assume forall i: Nat;
                                          nat_less_than(i, n) ->
                                          dividesIntegrally(e, qat(q, i)) {
                                          @e-divides |
                                            forall i: Nat;
                                              nat_less_than(i, n) ->
                                              dividesIntegrally(e, qat(q, i))
                                            [by hypothesis given-e-divides]
                                          // suppose e were NOT a unit
                                          @given-e-not-a-unit |
                                            assume not dividesIntegrally(e, ONE) {
                                              @e-not-a-unit |
                                                not dividesIntegrally(e, ONE)
                                                [by hypothesis given-e-not-a-unit]
                                              @a-smaller-exists |
                                                exists smaller: Q;
                                                  aFirstQuotientOf(s, n, smaller) and
                                                  less_than(smaller, qat(q, NAT_ZERO))
                                                [using specialize aNonUnitDivisorGivesASmallerFirstQuotient(s, q, n, d, e) zero-in-range d-is-an-integer d-positive the-factorization first-positive e-is-an-integer e-positive e-not-a-unit e-divides]
                                              @with-the-smaller |
                                                unpack smaller: Q from a-smaller-exists {
                                                  @the-smaller-parts |
                                                    aFirstQuotientOf(s, n, smaller) and
                                                      less_than(smaller, qat(q, NAT_ZERO))
                                                    [by hypothesis with-the-smaller]
                                                  @smaller-is-a-first-quotient |
                                                    aFirstQuotientOf(s, n, smaller)
                                                    [by and_lhs the-smaller-parts]
                                                  @smaller-is-below |
                                                    less_than(smaller, qat(q, NAT_ZERO))
                                                    [by and_rhs the-smaller-parts]
                                                  @smaller-below-least |
                                                    less_than(smaller, least)
                                                    [by rewrite the-first-is-least smaller-is-below]
                                                  // a first quotient is a positive integer, hence natural
                                                  // s_0 = d * q_0 with both positive
                                                  @the-first-factorization-here |
                                                    qat(s, NAT_ZERO) =
                                                      rational.mul(d, qat(q, NAT_ZERO))
                                                    [using specialize the-factorization(NAT_ZERO) zero-in-range]
                                                  @positive-products-here |
                                                    forall x, y: Q;
                                                      less_than(ZERO, x) ->
                                                      less_than(ZERO, y) ->
                                                      less_than(ZERO, rational.mul(x, y))
                                                    [by cite rational.positiveProduct]
                                                  @the-product-positive-here |
                                                    less_than(ZERO,
                                                      rational.mul(d, qat(q, NAT_ZERO)))
                                                    [using specialize positive-products-here(d, qat(q, NAT_ZERO)) d-positive first-positive]
                                                  @s-first-positive |
                                                    less_than(ZERO, qat(s, NAT_ZERO))
                                                    [by rewrite the-first-factorization-here the-product-positive-here]
                                                  @smaller-is-natural |
                                                    isNatural(smaller)
                                                    [using specialize aFirstQuotientIsNatural(s, n, smaller) zero-in-range s-first-positive smaller-is-a-first-quotient]
                                                  @not-below-least |
                                                    not less_than(smaller, least)
                                                    [using specialize the-minimality(smaller) smaller-is-natural smaller-is-a-first-quotient]
                                                  @conclusion-contradiction |
                                                    dividesIntegrally(e, ONE)
                                                    [by ex_falso smaller-below-least not-below-least]
                                                }
                                              @the-contradiction |
                                                dividesIntegrally(e, ONE)
                                                [by unpacked with-the-smaller]
                                            }
                                          @not-not-a-unit |
                                            not not dividesIntegrally(e, ONE)
                                            [by contradiction given-e-not-a-unit the-contradiction e-not-a-unit]
                                          @conclusion-e-is-a-unit |
                                            dividesIntegrally(e, ONE)
                                            [by double_negation not-not-a-unit]
                                        }
                                      @divides-implies |
                                        (forall i: Nat; nat_less_than(i, n) ->
                                          dividesIntegrally(e, qat(q, i))) ->
                                          dividesIntegrally(e, ONE)
                                        [by discharge given-e-divides]
                                    }
                                  @positive-implies |
                                    less_than(ZERO, e) ->
                                      (forall i: Nat; nat_less_than(i, n) ->
                                      dividesIntegrally(e, qat(q, i))) ->
                                      dividesIntegrally(e, ONE)
                                    [by discharge given-e-positive]
                                }
                              @integer-implies |
                                isInteger(e) -> less_than(ZERO, e) ->
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  dividesIntegrally(e, qat(q, i))) ->
                                  dividesIntegrally(e, ONE)
                                [by discharge given-e-is-an-integer]
                            }
                          @the-implication |
                            (nat_less_than(NAT_ZERO, n) and
                              isInteger(d) and less_than(ZERO, d) and
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) and
                              less_than(ZERO, qat(q, NAT_ZERO)) and
                              qat(q, NAT_ZERO) = least and
                              (forall m: Q; isNatural(m) ->
                              aFirstQuotientOf(s, n, m) ->
                              (not less_than(m, least)))) ->
                              isInteger(e) -> less_than(ZERO, e) ->
                              (forall i: Nat; nat_less_than(i, n) ->
                              dividesIntegrally(e, qat(q, i))) ->
                              dividesIntegrally(e, ONE)
                            [by discharge given-the-context]
                        }
                      @discharge-e |
                        forall e9: Q;
                          (nat_less_than(NAT_ZERO, n) and
                          isInteger(d) and less_than(ZERO, d) and
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) and
                          less_than(ZERO, qat(q, NAT_ZERO)) and
                          qat(q, NAT_ZERO) = least and
                          (forall m: Q; isNatural(m) ->
                          aFirstQuotientOf(s, n, m) ->
                          (not less_than(m, least)))) ->
                          isInteger(e9) -> less_than(ZERO, e9) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          dividesIntegrally(e9, qat(q, i))) ->
                          dividesIntegrally(e9, ONE)
                        [by generalize generalize-e]
                    }
                  @discharge-least |
                    forall l9: Q; forall e9: Q;
                      (nat_less_than(NAT_ZERO, n) and
                      isInteger(d) and less_than(ZERO, d) and
                      (forall i: Nat; nat_less_than(i, n) ->
                      qat(s, i) = rational.mul(d, qat(q, i))) and
                      less_than(ZERO, qat(q, NAT_ZERO)) and
                      qat(q, NAT_ZERO) = l9 and
                      (forall m: Q; isNatural(m) ->
                      aFirstQuotientOf(s, n, m) ->
                      (not less_than(m, l9)))) ->
                      isInteger(e9) -> less_than(ZERO, e9) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      dividesIntegrally(e9, qat(q, i))) ->
                      dividesIntegrally(e9, ONE)
                    [by generalize generalize-least]
                }
              @discharge-d |
                forall d9: Q; forall l9: Q; forall e9: Q;
                  (nat_less_than(NAT_ZERO, n) and
                  isInteger(d9) and less_than(ZERO, d9) and
                  (forall i: Nat; nat_less_than(i, n) ->
                  qat(s, i) = rational.mul(d9, qat(q, i))) and
                  less_than(ZERO, qat(q, NAT_ZERO)) and
                  qat(q, NAT_ZERO) = l9 and
                  (forall m: Q; isNatural(m) ->
                  aFirstQuotientOf(s, n, m) ->
                  (not less_than(m, l9)))) ->
                  isInteger(e9) -> less_than(ZERO, e9) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  dividesIntegrally(e9, qat(q, i))) ->
                  dividesIntegrally(e9, ONE)
                [by generalize generalize-d]
            }
          @discharge-n |
            forall n9: Nat; forall d9: Q; forall l9: Q; forall e9: Q;
              (nat_less_than(NAT_ZERO, n9) and
              isInteger(d9) and less_than(ZERO, d9) and
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(s, i) = rational.mul(d9, qat(q, i))) and
              less_than(ZERO, qat(q, NAT_ZERO)) and
              qat(q, NAT_ZERO) = l9 and
              (forall m: Q; isNatural(m) ->
              aFirstQuotientOf(s, n9, m) ->
              (not less_than(m, l9)))) ->
              isInteger(e9) -> less_than(ZERO, e9) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              dividesIntegrally(e9, qat(q, i))) ->
              dividesIntegrally(e9, ONE)
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q9: QSeq; forall n9: Nat; forall d9: Q; forall l9: Q;
          forall e9: Q;
          (nat_less_than(NAT_ZERO, n9) and
          isInteger(d9) and less_than(ZERO, d9) and
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(s, i) = rational.mul(d9, qat(q9, i))) and
          less_than(ZERO, qat(q9, NAT_ZERO)) and
          qat(q9, NAT_ZERO) = l9 and
          (forall m: Q; isNatural(m) ->
          aFirstQuotientOf(s, n9, m) ->
          (not less_than(m, l9)))) ->
          isInteger(e9) -> less_than(ZERO, e9) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          dividesIntegrally(e9, qat(q9, i))) ->
          dividesIntegrally(e9, ONE)
        [by generalize generalize-q]
    }
  @conclusion |
    forall s, q: QSeq; forall n: Nat; forall d, least, e: Q;
      (nat_less_than(NAT_ZERO, n) and isInteger(d) and less_than(ZERO, d) and
      (forall i: Nat; nat_less_than(i, n) ->
      qat(s, i) = rational.mul(d, qat(q, i))) and
      less_than(ZERO, qat(q, NAT_ZERO)) and
      qat(q, NAT_ZERO) = least and
      (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
      (not less_than(m, least)))) ->
      isInteger(e) -> less_than(ZERO, e) ->
      (forall i: Nat; nat_less_than(i, n) ->
      dividesIntegrally(e, qat(q, i))) ->
      dividesIntegrally(e, ONE)
    [by generalize generalize-s]
qed

// ONE candidate divisor, by sign. This is the case analysis itself; the theorem above just
// generalizes it over e.
theorem aDivisorOfTheQuotientsIsAUnit:
  forall s, q: QSeq; forall n: Nat; forall d, least, e: Q;
  nat_less_than(NAT_ZERO, n) ->
  isInteger(d) -> less_than(ZERO, d) ->
  (forall i: Nat; nat_less_than(i, n) ->
  qat(s, i) = rational.mul(d, qat(q, i))) ->
  less_than(ZERO, qat(q, NAT_ZERO)) ->
  qat(q, NAT_ZERO) = least ->
  (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
  (not less_than(m, least))) ->
  isInteger(e) ->
  (forall i: Nat; nat_less_than(i, n) ->
  dividesIntegrally(e, qat(q, i))) ->
  dividesIntegrally(e, ONE)
proof
  @generalize-all |
    fix s: QSeq {
      @generalize-q |
        fix q: QSeq {
          @generalize-n |
            fix n: Nat {
              @generalize-d |
                fix d: Q {
                  @generalize-least |
                    fix least: Q {
                      @generalize-e |
                        fix e: Q {
                          @given-the-setup |
                            assume nat_less_than(NAT_ZERO, n) and
                              isInteger(d) and less_than(ZERO, d) and
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) and
                              less_than(ZERO, qat(q, NAT_ZERO)) and
                              qat(q, NAT_ZERO) = least and
                              (forall m: Q; isNatural(m) ->
                              aFirstQuotientOf(s, n, m) ->
                              (not less_than(m, least))) and
                              isInteger(e) and
                              (forall i: Nat; nat_less_than(i, n) ->
                              dividesIntegrally(e, qat(q, i))) {
                              @the-setup |
                                nat_less_than(NAT_ZERO, n) and
                                  isInteger(d) and less_than(ZERO, d) and
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(d, qat(q, i))) and
                                  less_than(ZERO, qat(q, NAT_ZERO)) and
                                  qat(q, NAT_ZERO) = least and
                                  (forall m: Q; isNatural(m) ->
                                  aFirstQuotientOf(s, n, m) ->
                                  (not less_than(m, least))) and
                                  isInteger(e) and
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  dividesIntegrally(e, qat(q, i)))
                                [by hypothesis given-the-setup]
                              @zero-in-range |
                                nat_less_than(NAT_ZERO, n)
                                [using tautology the-setup]
                              @first-positive |
                                less_than(ZERO, qat(q, NAT_ZERO))
                                [using tautology the-setup]
                              @e-is-an-integer |
                                isInteger(e)
                                [using tautology the-setup]
                              @e-divides-each |
                                forall i: Nat; nat_less_than(i, n) ->
                                  dividesIntegrally(e, qat(q, i))
                                [using tautology the-setup]
                              @the-context-prefix |
                                nat_less_than(NAT_ZERO, n) and
                                  isInteger(d) and less_than(ZERO, d) and
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  qat(s, i) = rational.mul(d, qat(q, i))) and
                                  less_than(ZERO, qat(q, NAT_ZERO)) and
                                  qat(q, NAT_ZERO) = least and
                                  (forall m: Q; isNatural(m) ->
                                  aFirstQuotientOf(s, n, m) ->
                                  (not less_than(m, least)))
                                [using tautology the-setup]
                              @e-divides-the-first |
                                dividesIntegrally(e, qat(q, NAT_ZERO))
                                [using specialize e-divides-each(NAT_ZERO) zero-in-range]
                              @the-sign-cases |
                                less_than(e, ZERO) or e = ZERO or
                                  less_than(ZERO, e)
                                [using specialize rational.lessThanTrichotomy(e, ZERO)]
                              @conclusion-e-is-a-unit |
                                dividesIntegrally(e, ONE)
                                case the-sign-cases {
                                  // `or` is LEFT-associative: this arm is (e<0 or e=0)
                                  @when-e-not-positive |
                                    assume less_than(e, ZERO) or e = ZERO {
                                      @e-not-positive |
                                        less_than(e, ZERO) or e = ZERO
                                        [by hypothesis when-e-not-positive]
                                      @conclusion-nonpositive |
                                        dividesIntegrally(e, ONE)
                                        case e-not-positive {
                                          @when-e-negative |
                                            assume less_than(e, ZERO) {
                                              @e-negative |
                                                less_than(e, ZERO)
                                                [by hypothesis when-e-negative]
                                              // neg(e) is a positive integer dividing the same
                                              @negatives-of-negatives |
                                                forall x: Q;
                                                  less_than(x, ZERO) ->
                                                  less_than(ZERO, rational.neg(x))
                                                [using model(rational.RationalOrderedField) field_order.negOfNegativeIsPositive]
                                              @neg-e-positive |
                                                less_than(ZERO, rational.neg(e))
                                                [using specialize negatives-of-negatives(e) e-negative]
                                              @neg-e-is-an-integer |
                                                isInteger(rational.neg(e))
                                                [using specialize rational.isIntegerNeg(e) e-is-an-integer]
                                              @neg-e-divides-each |
                                                forall i: Nat;
                                                  nat_less_than(i, n) ->
                                                  dividesIntegrally(rational.neg(e), qat(q, i))
                                                [using specialize theNegationDividesEachEntry(q, e, n) e-divides-each]
                                              @neg-e-divides-one |
                                                dividesIntegrally(rational.neg(e), ONE)
                                                [using specialize thePositiveCaseIsAUnit(s, q, n, d, least, rational.neg(e)) the-context-prefix neg-e-is-an-integer neg-e-positive neg-e-divides-each]
                                              @conclusion-negative |
                                                dividesIntegrally(e, ONE)
                                                [using specialize divisibilityIsSignBlind(e, ONE) neg-e-divides-one]
                                            }
                                          @when-e-zero |
                                            assume e = ZERO {
                                              @e-zero |
                                                e = ZERO
                                                [by hypothesis when-e-zero]
                                              @zero-divides-the-first |
                                                dividesIntegrally(ZERO, qat(q, NAT_ZERO))
                                                [by rewrite e-zero e-divides-the-first]
                                              @the-first-is-zero |
                                                qat(q, NAT_ZERO) = ZERO
                                                [using specialize zeroDividesOnlyZero(qat(q, NAT_ZERO)) zero-divides-the-first]
                                              @zero-is-positive |
                                                less_than(ZERO, ZERO)
                                                [by rewrite the-first-is-zero first-positive]
                                              @zero-not-below-itself |
                                                not less_than(ZERO, ZERO)
                                                [using specialize rational.lessThanIrreflexive(ZERO)]
                                              @conclusion-zero |
                                                dividesIntegrally(e, ONE)
                                                [by ex_falso zero-is-positive zero-not-below-itself]
                                            }
                                        }
                                    }
                                  @when-e-positive |
                                    assume less_than(ZERO, e) {
                                      @e-positive |
                                        less_than(ZERO, e)
                                        [by hypothesis when-e-positive]
                                      @conclusion-positive |
                                        dividesIntegrally(e, ONE)
                                        [using specialize thePositiveCaseIsAUnit(s, q, n, d, least, e) the-context-prefix e-is-an-integer e-positive e-divides-each]
                                    }
                                }
                            }
                          @the-implication |
                            (nat_less_than(NAT_ZERO, n) and
                              isInteger(d) and less_than(ZERO, d) and
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) and
                              less_than(ZERO, qat(q, NAT_ZERO)) and
                              qat(q, NAT_ZERO) = least and
                              (forall m: Q; isNatural(m) ->
                              aFirstQuotientOf(s, n, m) ->
                              (not less_than(m, least))) and
                              isInteger(e) and
                              (forall i: Nat; nat_less_than(i, n) ->
                              dividesIntegrally(e, qat(q, i)))) ->
                              dividesIntegrally(e, ONE)
                            [by discharge given-the-setup]
                          @curried |
                            nat_less_than(NAT_ZERO, n) ->
                              isInteger(d) -> less_than(ZERO, d) ->
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) ->
                              less_than(ZERO, qat(q, NAT_ZERO)) ->
                              qat(q, NAT_ZERO) = least ->
                              (forall m: Q; isNatural(m) ->
                              aFirstQuotientOf(s, n, m) ->
                              (not less_than(m, least))) ->
                              isInteger(e) ->
                              (forall i: Nat; nat_less_than(i, n) ->
                              dividesIntegrally(e, qat(q, i))) ->
                              dividesIntegrally(e, ONE)
                            [using tautology the-implication]
                        }
                      @discharge-e |
                        forall e9: Q;
                          nat_less_than(NAT_ZERO, n) ->
                          isInteger(d) -> less_than(ZERO, d) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) ->
                          less_than(ZERO, qat(q, NAT_ZERO)) ->
                          qat(q, NAT_ZERO) = least ->
                          (forall m: Q; isNatural(m) ->
                          aFirstQuotientOf(s, n, m) ->
                          (not less_than(m, least))) ->
                          isInteger(e9) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          dividesIntegrally(e9, qat(q, i))) ->
                          dividesIntegrally(e9, ONE)
                        [by generalize generalize-e]
                    }
                  @discharge-least |
                    forall l9: Q; forall e9: Q;
                      nat_less_than(NAT_ZERO, n) ->
                      isInteger(d) -> less_than(ZERO, d) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      qat(s, i) = rational.mul(d, qat(q, i))) ->
                      less_than(ZERO, qat(q, NAT_ZERO)) ->
                      qat(q, NAT_ZERO) = l9 ->
                      (forall m: Q; isNatural(m) ->
                      aFirstQuotientOf(s, n, m) ->
                      (not less_than(m, l9))) ->
                      isInteger(e9) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      dividesIntegrally(e9, qat(q, i))) ->
                      dividesIntegrally(e9, ONE)
                    [by generalize generalize-least]
                }
              @discharge-d |
                forall d9: Q; forall l9: Q; forall e9: Q;
                  nat_less_than(NAT_ZERO, n) ->
                  isInteger(d9) -> less_than(ZERO, d9) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  qat(s, i) = rational.mul(d9, qat(q, i))) ->
                  less_than(ZERO, qat(q, NAT_ZERO)) ->
                  qat(q, NAT_ZERO) = l9 ->
                  (forall m: Q; isNatural(m) ->
                  aFirstQuotientOf(s, n, m) ->
                  (not less_than(m, l9))) ->
                  isInteger(e9) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  dividesIntegrally(e9, qat(q, i))) ->
                  dividesIntegrally(e9, ONE)
                [by generalize generalize-d]
            }
          @discharge-n |
            forall n9: Nat; forall d9: Q; forall l9: Q; forall e9: Q;
              nat_less_than(NAT_ZERO, n9) ->
              isInteger(d9) -> less_than(ZERO, d9) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(s, i) = rational.mul(d9, qat(q, i))) ->
              less_than(ZERO, qat(q, NAT_ZERO)) ->
              qat(q, NAT_ZERO) = l9 ->
              (forall m: Q; isNatural(m) ->
              aFirstQuotientOf(s, n9, m) ->
              (not less_than(m, l9))) ->
              isInteger(e9) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              dividesIntegrally(e9, qat(q, i))) ->
              dividesIntegrally(e9, ONE)
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q9: QSeq; forall n9: Nat; forall d9: Q; forall l9: Q;
          forall e9: Q;
          nat_less_than(NAT_ZERO, n9) ->
          isInteger(d9) -> less_than(ZERO, d9) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(s, i) = rational.mul(d9, qat(q9, i))) ->
          less_than(ZERO, qat(q9, NAT_ZERO)) ->
          qat(q9, NAT_ZERO) = l9 ->
          (forall m: Q; isNatural(m) ->
          aFirstQuotientOf(s, n9, m) ->
          (not less_than(m, l9))) ->
          isInteger(e9) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          dividesIntegrally(e9, qat(q9, i))) ->
          dividesIntegrally(e9, ONE)
        [by generalize generalize-q]
    }
  @conclusion |
    forall s, q: QSeq; forall n: Nat; forall d, least, e: Q;
      nat_less_than(NAT_ZERO, n) ->
      isInteger(d) -> less_than(ZERO, d) ->
      (forall i: Nat; nat_less_than(i, n) ->
      qat(s, i) = rational.mul(d, qat(q, i))) ->
      less_than(ZERO, qat(q, NAT_ZERO)) ->
      qat(q, NAT_ZERO) = least ->
      (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
      (not less_than(m, least))) ->
      isInteger(e) ->
      (forall i: Nat; nat_less_than(i, n) ->
      dividesIntegrally(e, qat(q, i))) ->
      dividesIntegrally(e, ONE)
    [by generalize generalize-all]
qed

// THE SIGN SPLIT. Every integer common divisor of the quotients divides ONE — which is what
// coprimality asserts — by cases on its sign:
//
//   e > 0  a non-unit would give a strictly smaller first quotient, contradicting leastness
//   e = 0  `zeroDividesOnlyZero` forces q_0 = 0, contradicting q_0 > 0
//   e < 0  neg(e) > 0, so the positive case gives neg(e) | ONE, and
//          `divisibilityIsSignBlind` brings it back to e
theorem theSignSplitGivesCoprimality:
  forall s, q: QSeq; forall n: Nat; forall d, least: Q;
  nat_less_than(NAT_ZERO, n) ->
  isInteger(d) -> less_than(ZERO, d) ->
  (forall i: Nat; nat_less_than(i, n) ->
  qat(s, i) = rational.mul(d, qat(q, i))) ->
  less_than(ZERO, qat(q, NAT_ZERO)) ->
  qat(q, NAT_ZERO) = least ->
  (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
  (not less_than(m, least))) ->
  theQuotientsAreCoprime(q, n)
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-q |
        fix q: QSeq {
          @generalize-n |
            fix n: Nat {
              @generalize-d |
                fix d: Q {
                  @generalize-least |
                    fix least: Q {
                      @given-the-setup |
                        assume nat_less_than(NAT_ZERO, n) and isInteger(d) and
                          less_than(ZERO, d) and
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) and
                          less_than(ZERO, qat(q, NAT_ZERO)) and
                          qat(q, NAT_ZERO) = least and
                          (forall m: Q; isNatural(m) ->
                          aFirstQuotientOf(s, n, m) ->
                          (not less_than(m, least))) {
                          @the-setup |
                            nat_less_than(NAT_ZERO, n) and isInteger(d) and
                              less_than(ZERO, d) and
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))) and
                              less_than(ZERO, qat(q, NAT_ZERO)) and
                              qat(q, NAT_ZERO) = least and
                              (forall m: Q; isNatural(m) ->
                              aFirstQuotientOf(s, n, m) ->
                              (not less_than(m, least)))
                            [by hypothesis given-the-setup]
                          @zero-in-range |
                            nat_less_than(NAT_ZERO, n)
                            [using tautology the-setup]
                          @d-is-an-integer |
                            isInteger(d)
                            [using tautology the-setup]
                          @d-positive |
                            less_than(ZERO, d)
                            [using tautology the-setup]
                          @the-factorization |
                            forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))
                            [using tautology the-setup]
                          @first-positive |
                            less_than(ZERO, qat(q, NAT_ZERO))
                            [using tautology the-setup]
                          @the-first-is-least |
                            qat(q, NAT_ZERO) = least
                            [using tautology the-setup]
                          @the-minimality |
                            forall m: Q; isNatural(m) ->
                              aFirstQuotientOf(s, n, m) ->
                              (not less_than(m, least))
                            [using tautology the-setup]
                          @each-candidate |
                            fix e: Q {
                              @given-e-is-an-integer |
                                assume isInteger(e) {
                                  @e-is-an-integer |
                                    isInteger(e)
                                    [by hypothesis given-e-is-an-integer]
                                  @given-e-divides |
                                    assume isACommonDivisorUpTo(e, q, n) {
                                      @e-divides |
                                        isACommonDivisorUpTo(e, q, n)
                                        [by hypothesis given-e-divides]
                                      @the-divisor-meaning |
                                        isACommonDivisorUpTo(e, q, n) iff
                                          (forall i: Nat;
                                          nat_less_than(i, n) ->
                                          dividesIntegrally(e, qat(q, i)))
                                        [using specialize commonDivisorMeaning(e, q, n)]
                                      @e-divides-each |
                                        forall i: Nat; nat_less_than(i, n) ->
                                          dividesIntegrally(e, qat(q, i))
                                        [using tautology the-divisor-meaning e-divides]
                                      @conclusion-e-is-a-unit |
                                        dividesIntegrally(e, ONE)
                                        [using specialize aDivisorOfTheQuotientsIsAUnit(s, q, n, d, least, e) zero-in-range d-is-an-integer d-positive the-factorization first-positive the-first-is-least the-minimality e-is-an-integer e-divides-each]
                                    }
                                  @divides-implies-unit |
                                    isACommonDivisorUpTo(e, q, n) ->
                                      dividesIntegrally(e, ONE)
                                    [by discharge given-e-divides]
                                }
                              @integer-implies |
                                isInteger(e) ->
                                  isACommonDivisorUpTo(e, q, n) ->
                                  dividesIntegrally(e, ONE)
                                [by discharge given-e-is-an-integer]
                            }
                          @all-divisors-are-units |
                            forall e: Q; isInteger(e) ->
                              isACommonDivisorUpTo(e, q, n) ->
                              dividesIntegrally(e, ONE)
                            [by generalize each-candidate]
                          @conclusion-coprime |
                            theQuotientsAreCoprime(q, n)
                            [using specialize noNonUnitDivisorMeansCoprime(q, n) all-divisors-are-units]
                        }
                      @the-implication |
                        (nat_less_than(NAT_ZERO, n) and isInteger(d) and
                          less_than(ZERO, d) and
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) and
                          less_than(ZERO, qat(q, NAT_ZERO)) and
                          qat(q, NAT_ZERO) = least and
                          (forall m: Q; isNatural(m) ->
                          aFirstQuotientOf(s, n, m) ->
                          (not less_than(m, least)))) ->
                          theQuotientsAreCoprime(q, n)
                        [by discharge given-the-setup]
                      @curried |
                        nat_less_than(NAT_ZERO, n) ->
                          isInteger(d) -> less_than(ZERO, d) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))) ->
                          less_than(ZERO, qat(q, NAT_ZERO)) ->
                          qat(q, NAT_ZERO) = least ->
                          (forall m: Q; isNatural(m) ->
                          aFirstQuotientOf(s, n, m) ->
                          (not less_than(m, least))) ->
                          theQuotientsAreCoprime(q, n)
                        [using tautology the-implication]
                    }
                  @discharge-least |
                    forall l9: Q;
                      nat_less_than(NAT_ZERO, n) ->
                      isInteger(d) -> less_than(ZERO, d) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      qat(s, i) = rational.mul(d, qat(q, i))) ->
                      less_than(ZERO, qat(q, NAT_ZERO)) ->
                      qat(q, NAT_ZERO) = l9 ->
                      (forall m: Q; isNatural(m) ->
                      aFirstQuotientOf(s, n, m) ->
                      (not less_than(m, l9))) ->
                      theQuotientsAreCoprime(q, n)
                    [by generalize generalize-least]
                }
              @discharge-d |
                forall d9: Q; forall l9: Q;
                  nat_less_than(NAT_ZERO, n) ->
                  isInteger(d9) -> less_than(ZERO, d9) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  qat(s, i) = rational.mul(d9, qat(q, i))) ->
                  less_than(ZERO, qat(q, NAT_ZERO)) ->
                  qat(q, NAT_ZERO) = l9 ->
                  (forall m: Q; isNatural(m) ->
                  aFirstQuotientOf(s, n, m) ->
                  (not less_than(m, l9))) ->
                  theQuotientsAreCoprime(q, n)
                [by generalize generalize-d]
            }
          @discharge-n |
            forall n9: Nat; forall d9: Q; forall l9: Q;
              nat_less_than(NAT_ZERO, n9) ->
              isInteger(d9) -> less_than(ZERO, d9) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(s, i) = rational.mul(d9, qat(q, i))) ->
              less_than(ZERO, qat(q, NAT_ZERO)) ->
              qat(q, NAT_ZERO) = l9 ->
              (forall m: Q; isNatural(m) ->
              aFirstQuotientOf(s, n9, m) ->
              (not less_than(m, l9))) ->
              theQuotientsAreCoprime(q, n9)
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q9: QSeq; forall n9: Nat; forall d9: Q; forall l9: Q;
          nat_less_than(NAT_ZERO, n9) ->
          isInteger(d9) -> less_than(ZERO, d9) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(s, i) = rational.mul(d9, qat(q9, i))) ->
          less_than(ZERO, qat(q9, NAT_ZERO)) ->
          qat(q9, NAT_ZERO) = l9 ->
          (forall m: Q; isNatural(m) ->
          aFirstQuotientOf(s, n9, m) ->
          (not less_than(m, l9))) ->
          theQuotientsAreCoprime(q9, n9)
        [by generalize generalize-q]
    }
  @conclusion |
    forall s, q: QSeq; forall n: Nat; forall d, least: Q;
      nat_less_than(NAT_ZERO, n) ->
      isInteger(d) -> less_than(ZERO, d) ->
      (forall i: Nat; nat_less_than(i, n) ->
      qat(s, i) = rational.mul(d, qat(q, i))) ->
      less_than(ZERO, qat(q, NAT_ZERO)) ->
      qat(q, NAT_ZERO) = least ->
      (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
      (not less_than(m, least))) ->
      theQuotientsAreCoprime(q, n)
    [by generalize generalize-s]
qed

// -- A DIVISOR WITH COPRIME QUOTIENTS EXISTS ----------------------------------------------
// The payoff of the descent. The least first quotient's divisor leaves COPRIME quotients: a
// common divisor e of the quotients that were not a unit would give a strictly smaller first
// quotient, contradicting leastness.
//
// The SIGN SPLIT is what makes this cover every integer e, not just positive ones:
//   e > 0  the descent step applies
//   e = 0  `zeroDividesOnlyZero` makes q_0 = 0, contradicting q_0 > 0
//   e < 0  apply the positive case to neg(e) and come back by `divisibilityIsSignBlind`
theorem aCoprimeDivisorOfASequenceExists: forall s: QSeq; forall n: Nat;
  nat_less_than(NAT_ZERO, n) ->
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
  less_than(ZERO, qat(s, NAT_ZERO)) ->
  (exists d: Q; exists q: QSeq;
  isInteger(d) and less_than(ZERO, d) and
  isACommonDivisorUpTo(d, s, n) and
  aQuotientSequenceFor(d, s, q, n) and
  theQuotientsAreCoprime(q, n))
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-n |
        fix n: Nat {
          @given-the-setup |
            assume nat_less_than(NAT_ZERO, n) and
              (forall i: Nat; nat_less_than(i, n) ->
              isInteger(qat(s, i))) and
              less_than(ZERO, qat(s, NAT_ZERO)) {
              @the-setup |
                nat_less_than(NAT_ZERO, n) and
                  (forall i: Nat; nat_less_than(i, n) ->
                  isInteger(qat(s, i))) and
                  less_than(ZERO, qat(s, NAT_ZERO))
                [by hypothesis given-the-setup]
              @zero-in-range |
                nat_less_than(NAT_ZERO, n)
                [using tautology the-setup]
              @the-entries |
                forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))
                [using tautology the-setup]
              @first-positive |
                less_than(ZERO, qat(s, NAT_ZERO))
                [using tautology the-setup]
              @the-least-exists |
                exists least: Q; isNatural(least) and
                  aFirstQuotientOf(s, n, least) and
                  (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
                  (not less_than(m, least)))
                [using specialize aLeastFirstQuotientExists(s, n) zero-in-range the-entries first-positive]
              @with-the-least |
                unpack least: Q from the-least-exists {
                  @the-least-parts |
                    isNatural(least) and aFirstQuotientOf(s, n, least) and
                      (forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
                      (not less_than(m, least)))
                    [by hypothesis with-the-least]
                  @the-least-is-a-first-quotient |
                    aFirstQuotientOf(s, n, least)
                    [using tautology the-least-parts]
                  @the-minimality |
                    forall m: Q; isNatural(m) -> aFirstQuotientOf(s, n, m) ->
                      (not less_than(m, least))
                    [using tautology the-least-parts]
                  // unpack the divisor achieving it
                  @the-first-quotient-meaning |
                    aFirstQuotientOf(s, n, least) iff
                      (exists d: Q; exists q: QSeq;
                      isInteger(d) and less_than(ZERO, d) and
                      isACommonDivisorUpTo(d, s, n) and
                      aQuotientSequenceFor(d, s, q, n) and
                      qat(q, NAT_ZERO) = least)
                    [using specialize firstQuotientMeaning(s, n, least)]
                  @the-divisor-exists |
                    exists d: Q; exists q: QSeq;
                      isInteger(d) and less_than(ZERO, d) and
                      isACommonDivisorUpTo(d, s, n) and
                      aQuotientSequenceFor(d, s, q, n) and
                      qat(q, NAT_ZERO) = least
                    [using tautology the-first-quotient-meaning the-least-is-a-first-quotient]
                  @with-the-divisor |
                    unpack d: Q from the-divisor-exists {
                      @the-sequence-exists |
                        exists q: QSeq;
                          isInteger(d) and less_than(ZERO, d) and
                          isACommonDivisorUpTo(d, s, n) and
                          aQuotientSequenceFor(d, s, q, n) and
                          qat(q, NAT_ZERO) = least
                        [by hypothesis with-the-divisor]
                      @with-the-sequence |
                        unpack q: QSeq from the-sequence-exists {
                          @the-parts |
                            isInteger(d) and less_than(ZERO, d) and
                              isACommonDivisorUpTo(d, s, n) and
                              aQuotientSequenceFor(d, s, q, n) and
                              qat(q, NAT_ZERO) = least
                            [by hypothesis with-the-sequence]
                          @d-is-an-integer |
                            isInteger(d)
                            [using tautology the-parts]
                          @d-positive |
                            less_than(ZERO, d)
                            [using tautology the-parts]
                          @d-divides |
                            isACommonDivisorUpTo(d, s, n)
                            [using tautology the-parts]
                          @the-quotients |
                            aQuotientSequenceFor(d, s, q, n)
                            [using tautology the-parts]
                          @the-first-is-least |
                            qat(q, NAT_ZERO) = least
                            [using tautology the-parts]
                          // the quotients' first entry is positive, since s_0 = d * q_0
                          @the-quotient-meaning |
                            aQuotientSequenceFor(d, s, q, n) iff
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i)))
                            [using specialize quotientSequenceMeaning(d, s, q, n)]
                          @the-factorization |
                            forall i: Nat; nat_less_than(i, n) ->
                              qat(s, i) = rational.mul(d, qat(q, i))
                            [using tautology the-quotient-meaning the-quotients]
                          @the-first-factorization |
                            qat(s, NAT_ZERO) =
                              rational.mul(d, qat(q, NAT_ZERO))
                            [using specialize the-factorization(NAT_ZERO) zero-in-range]
                          @the-product-positive |
                            less_than(ZERO, rational.mul(d, qat(q, NAT_ZERO)))
                            [by rewrite the-first-factorization first-positive]
                          @the-product-is-itself |
                            rational.mul(d, qat(q, NAT_ZERO)) =
                              rational.mul(d, qat(q, NAT_ZERO))
                            [by reflexivity]
                          @the-first-quotient-positive |
                            less_than(ZERO, qat(q, NAT_ZERO))
                            [using specialize theCofactorOfAPositiveIsPositive(d, qat(q, NAT_ZERO), rational.mul(d, qat(q, NAT_ZERO))) d-positive the-product-positive the-product-is-itself]
                          // COPRIMALITY by the sign split
                          @the-quotients-are-coprime |
                            theQuotientsAreCoprime(q, n)
                            [using specialize theSignSplitGivesCoprimality(s, q, n, d, least) zero-in-range d-is-an-integer d-positive the-factorization the-first-quotient-positive the-first-is-least the-minimality]
                          @the-full-witness |
                            isInteger(d) and less_than(ZERO, d) and
                              isACommonDivisorUpTo(d, s, n) and
                              aQuotientSequenceFor(d, s, q, n) and
                              theQuotientsAreCoprime(q, n)
                            [using tautology d-is-an-integer d-positive d-divides the-quotients the-quotients-are-coprime]
                          @the-sequence-witness |
                            exists q2: QSeq;
                              isInteger(d) and less_than(ZERO, d) and
                              isACommonDivisorUpTo(d, s, n) and
                              aQuotientSequenceFor(d, s, q2, n) and
                              theQuotientsAreCoprime(q2, n)
                            [by witness(q) the-full-witness]
                          @conclusion-both |
                            exists d2: Q; exists q2: QSeq;
                              isInteger(d2) and less_than(ZERO, d2) and
                              isACommonDivisorUpTo(d2, s, n) and
                              aQuotientSequenceFor(d2, s, q2, n) and
                              theQuotientsAreCoprime(q2, n)
                            [by witness(d) the-sequence-witness]
                        }
                      @sequence-exported |
                        exists d2: Q; exists q2: QSeq;
                          isInteger(d2) and less_than(ZERO, d2) and
                          isACommonDivisorUpTo(d2, s, n) and
                          aQuotientSequenceFor(d2, s, q2, n) and
                          theQuotientsAreCoprime(q2, n)
                        [by unpacked with-the-sequence]
                    }
                  @divisor-exported |
                    exists d2: Q; exists q2: QSeq;
                      isInteger(d2) and less_than(ZERO, d2) and
                      isACommonDivisorUpTo(d2, s, n) and
                      aQuotientSequenceFor(d2, s, q2, n) and
                      theQuotientsAreCoprime(q2, n)
                    [by unpacked with-the-divisor]
                }
              @least-exported |
                exists d2: Q; exists q2: QSeq;
                  isInteger(d2) and less_than(ZERO, d2) and
                  isACommonDivisorUpTo(d2, s, n) and
                  aQuotientSequenceFor(d2, s, q2, n) and
                  theQuotientsAreCoprime(q2, n)
                [by unpacked with-the-least]
            }
          @the-implication |
            (nat_less_than(NAT_ZERO, n) and
              (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) and
              less_than(ZERO, qat(s, NAT_ZERO))) ->
              (exists d: Q; exists q: QSeq;
              isInteger(d) and less_than(ZERO, d) and
              isACommonDivisorUpTo(d, s, n) and
              aQuotientSequenceFor(d, s, q, n) and
              theQuotientsAreCoprime(q, n))
            [by discharge given-the-setup]
          @curried |
            nat_less_than(NAT_ZERO, n) ->
              (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
              less_than(ZERO, qat(s, NAT_ZERO)) ->
              (exists d: Q; exists q: QSeq;
              isInteger(d) and less_than(ZERO, d) and
              isACommonDivisorUpTo(d, s, n) and
              aQuotientSequenceFor(d, s, q, n) and
              theQuotientsAreCoprime(q, n))
            [using tautology the-implication]
        }
      @discharge-n |
        forall n9: Nat;
          nat_less_than(NAT_ZERO, n9) ->
          (forall i: Nat; nat_less_than(i, n9) -> isInteger(qat(s, i))) ->
          less_than(ZERO, qat(s, NAT_ZERO)) ->
          (exists d: Q; exists q: QSeq;
          isInteger(d) and less_than(ZERO, d) and
          isACommonDivisorUpTo(d, s, n9) and
          aQuotientSequenceFor(d, s, q, n9) and
          theQuotientsAreCoprime(q, n9))
        [by generalize generalize-n]
    }
  @conclusion |
    forall s: QSeq; forall n: Nat;
      nat_less_than(NAT_ZERO, n) ->
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(s, i))) ->
      less_than(ZERO, qat(s, NAT_ZERO)) ->
      (exists d: Q; exists q: QSeq;
      isInteger(d) and less_than(ZERO, d) and
      isACommonDivisorUpTo(d, s, n) and
      aQuotientSequenceFor(d, s, q, n) and
      theQuotientsAreCoprime(q, n))
    [by generalize generalize-s]
qed

// -- THE PAIR CASE ------------------------------------------------------------------------
// `isTheIntegerDecomposition` needs `arePairwiseRelativelyPrime(r, s)` for the reduced
// fraction. A pair is a TWO-ELEMENT SEQUENCE, so `aCoprimeDivisorOfASequenceExists` covers it
// — no separate descent, and no need for `isAMaximalCommonDivisorOfThePair`, whose existence
// is unproved and whose maximality is strictly stronger than anything used.
//
// The index range is enumerated by `peano_order.belowTwoMeansZeroOrOne`.

// A two-element sequence has integer entries throughout its range, given both values are.
theorem aTwoElementSequenceHasIntegerEntries: forall t: QSeq; forall a, b: Q;
  qat(t, NAT_ZERO) = a -> qat(t, nat_succ(NAT_ZERO)) = b ->
  isInteger(a) -> isInteger(b) ->
  (forall i: Nat; nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
  isInteger(qat(t, i)))
proof
  @generalize-t |
    fix t: QSeq {
      @generalize-a |
        fix a: Q {
          @generalize-b |
            fix b: Q {
              @given-the-setup |
                assume qat(t, NAT_ZERO) = a and
                  qat(t, nat_succ(NAT_ZERO)) = b and
                  isInteger(a) and isInteger(b) {
                  @the-setup |
                    qat(t, NAT_ZERO) = a and
                      qat(t, nat_succ(NAT_ZERO)) = b and
                      isInteger(a) and isInteger(b)
                    [by hypothesis given-the-setup]
                  @t-at-zero |
                    qat(t, NAT_ZERO) = a
                    [using tautology the-setup]
                  @t-at-one |
                    qat(t, nat_succ(NAT_ZERO)) = b
                    [using tautology the-setup]
                  @a-is-an-integer |
                    isInteger(a)
                    [using tautology the-setup]
                  @b-is-an-integer |
                    isInteger(b)
                    [using tautology the-setup]
                  @the-zeroth-is-an-integer |
                    isInteger(qat(t, NAT_ZERO))
                    [by rewrite t-at-zero a-is-an-integer]
                  @the-first-is-an-integer |
                    isInteger(qat(t, nat_succ(NAT_ZERO)))
                    [by rewrite t-at-one b-is-an-integer]
                  @each-index |
                    fix i: Nat {
                      @given-i-below-two |
                        assume nat_less_than(i,
                          nat_succ(nat_succ(NAT_ZERO))) {
                          @i-below-two |
                            nat_less_than(i, nat_succ(nat_succ(NAT_ZERO)))
                            [by hypothesis given-i-below-two]
                          @the-cases |
                            i = NAT_ZERO or i = nat_succ(NAT_ZERO)
                            [using specialize peano_order.belowTwoMeansZeroOrOne(i) i-below-two]
                          @conclusion-integer-at-i |
                            isInteger(qat(t, i))
                            case the-cases {
                              @when-zero |
                                assume i = NAT_ZERO {
                                  @i-is-zero |
                                    i = NAT_ZERO
                                    [by hypothesis when-zero]
                                  @conclusion-at-zero |
                                    isInteger(qat(t, i))
                                    [by rewrite i-is-zero the-zeroth-is-an-integer]
                                }
                              @when-one |
                                assume i = nat_succ(NAT_ZERO) {
                                  @i-is-one |
                                    i = nat_succ(NAT_ZERO)
                                    [by hypothesis when-one]
                                  @conclusion-at-one |
                                    isInteger(qat(t, i))
                                    [by rewrite i-is-one the-first-is-an-integer]
                                }
                            }
                        }
                      @below-two-implies |
                        nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
                          isInteger(qat(t, i))
                        [by discharge given-i-below-two]
                    }
                  @conclusion-all |
                    forall i: Nat;
                      nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
                      isInteger(qat(t, i))
                    [by generalize each-index]
                }
              @the-implication |
                (qat(t, NAT_ZERO) = a and
                  qat(t, nat_succ(NAT_ZERO)) = b and
                  isInteger(a) and isInteger(b)) ->
                  (forall i: Nat;
                  nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
                  isInteger(qat(t, i)))
                [by discharge given-the-setup]
              @curried |
                qat(t, NAT_ZERO) = a -> qat(t, nat_succ(NAT_ZERO)) = b ->
                  isInteger(a) -> isInteger(b) ->
                  (forall i: Nat;
                  nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
                  isInteger(qat(t, i)))
                [using tautology the-implication]
            }
          @discharge-b |
            forall b9: Q;
              qat(t, NAT_ZERO) = a -> qat(t, nat_succ(NAT_ZERO)) = b9 ->
              isInteger(a) -> isInteger(b9) ->
              (forall i: Nat;
              nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
              isInteger(qat(t, i)))
            [by generalize generalize-b]
        }
      @discharge-a |
        forall a9: Q; forall b9: Q;
          qat(t, NAT_ZERO) = a9 -> qat(t, nat_succ(NAT_ZERO)) = b9 ->
          isInteger(a9) -> isInteger(b9) ->
          (forall i: Nat;
          nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
          isInteger(qat(t, i)))
        [by generalize generalize-a]
    }
  @conclusion |
    forall t: QSeq; forall a, b: Q;
      qat(t, NAT_ZERO) = a -> qat(t, nat_succ(NAT_ZERO)) = b ->
      isInteger(a) -> isInteger(b) ->
      (forall i: Nat; nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
      isInteger(qat(t, i)))
    [by generalize generalize-t]
qed

// Two entries cover a two-element range: dividing q_0 and q_1 is dividing every entry below
// TWO, by `belowTwoMeansZeroOrOne`.
theorem theTwoEntriesCoverTheRange: forall q: QSeq; forall e: Q;
  dividesIntegrally(e, qat(q, NAT_ZERO)) ->
  dividesIntegrally(e, qat(q, nat_succ(NAT_ZERO))) ->
  (forall i: Nat; nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
  dividesIntegrally(e, qat(q, i)))
proof
  @generalize-q |
    fix q: QSeq {
      @generalize-e |
        fix e: Q {
          @given-divides-zeroth |
            assume dividesIntegrally(e, qat(q, NAT_ZERO)) {
              @divides-zeroth |
                dividesIntegrally(e, qat(q, NAT_ZERO))
                [by hypothesis given-divides-zeroth]
              @given-divides-first |
                assume dividesIntegrally(e, qat(q, nat_succ(NAT_ZERO))) {
                  @divides-first |
                    dividesIntegrally(e, qat(q, nat_succ(NAT_ZERO)))
                    [by hypothesis given-divides-first]
                  @each-index |
                    fix i: Nat {
                      @given-i-below-two |
                        assume nat_less_than(i,
                          nat_succ(nat_succ(NAT_ZERO))) {
                          @i-below-two |
                            nat_less_than(i, nat_succ(nat_succ(NAT_ZERO)))
                            [by hypothesis given-i-below-two]
                          @the-cases |
                            i = NAT_ZERO or i = nat_succ(NAT_ZERO)
                            [using specialize peano_order.belowTwoMeansZeroOrOne(i) i-below-two]
                          @conclusion-divides-at-i |
                            dividesIntegrally(e, qat(q, i))
                            case the-cases {
                              @when-zero |
                                assume i = NAT_ZERO {
                                  @i-is-zero |
                                    i = NAT_ZERO
                                    [by hypothesis when-zero]
                                  @conclusion-at-zero |
                                    dividesIntegrally(e, qat(q, i))
                                    [by rewrite i-is-zero divides-zeroth]
                                }
                              @when-one |
                                assume i = nat_succ(NAT_ZERO) {
                                  @i-is-one |
                                    i = nat_succ(NAT_ZERO)
                                    [by hypothesis when-one]
                                  @conclusion-at-one |
                                    dividesIntegrally(e, qat(q, i))
                                    [by rewrite i-is-one divides-first]
                                }
                            }
                        }
                      @below-two-implies |
                        nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
                          dividesIntegrally(e, qat(q, i))
                        [by discharge given-i-below-two]
                    }
                  @conclusion-all |
                    forall i: Nat;
                      nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
                      dividesIntegrally(e, qat(q, i))
                    [by generalize each-index]
                }
              @first-implies |
                dividesIntegrally(e, qat(q, nat_succ(NAT_ZERO))) ->
                  (forall i: Nat;
                  nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
                  dividesIntegrally(e, qat(q, i)))
                [by discharge given-divides-first]
            }
          @zeroth-implies |
            dividesIntegrally(e, qat(q, NAT_ZERO)) ->
              dividesIntegrally(e, qat(q, nat_succ(NAT_ZERO))) ->
              (forall i: Nat;
              nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
              dividesIntegrally(e, qat(q, i)))
            [by discharge given-divides-zeroth]
        }
      @discharge-e |
        forall e9: Q;
          dividesIntegrally(e9, qat(q, NAT_ZERO)) ->
          dividesIntegrally(e9, qat(q, nat_succ(NAT_ZERO))) ->
          (forall i: Nat;
          nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
          dividesIntegrally(e9, qat(q, i)))
        [by generalize generalize-e]
    }
  @conclusion |
    forall q: QSeq; forall e: Q;
      dividesIntegrally(e, qat(q, NAT_ZERO)) ->
      dividesIntegrally(e, qat(q, nat_succ(NAT_ZERO))) ->
      (forall i: Nat; nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
      dividesIntegrally(e, qat(q, i)))
    [by generalize generalize-q]
qed

// Coprimality of the two quotient entries, from coprimality over the two-element range. The
// two statements differ only in how the index range is written: `isACommonDivisorUpTo(e, q, 2)`
// unfolds, by `belowTwoMeansZeroOrOne`, to "e divides q_0 and e divides q_1".
theorem theTwoQuotientsAreCoprime: forall q: QSeq;
  theQuotientsAreCoprime(q, nat_succ(nat_succ(NAT_ZERO))) ->
  qpoly.arePairwiseRelativelyPrime(qat(q, NAT_ZERO),
  qat(q, nat_succ(NAT_ZERO)))
proof
  @generalize-q |
    fix q: QSeq {
      @given-coprime |
        assume theQuotientsAreCoprime(q, nat_succ(nat_succ(NAT_ZERO))) {
          @coprime |
            theQuotientsAreCoprime(q, nat_succ(nat_succ(NAT_ZERO)))
            [by hypothesis given-coprime]
          @the-coprime-meaning |
            theQuotientsAreCoprime(q, nat_succ(nat_succ(NAT_ZERO))) iff
              (forall e: Q; isInteger(e) ->
              isACommonDivisorUpTo(e, q,
              nat_succ(nat_succ(NAT_ZERO))) ->
              dividesIntegrally(e, ONE))
            [using specialize quotientsCoprimeMeaning(q, nat_succ(nat_succ(NAT_ZERO)))]
          @every-divisor-is-a-unit |
            forall e: Q; isInteger(e) ->
              isACommonDivisorUpTo(e, q,
              nat_succ(nat_succ(NAT_ZERO))) ->
              dividesIntegrally(e, ONE)
            [using tautology the-coprime-meaning coprime]
          @each-candidate |
            fix e: Q {
              @given-e-is-an-integer |
                assume isInteger(e) {
                  @e-is-an-integer |
                    isInteger(e)
                    [by hypothesis given-e-is-an-integer]
                  @given-e-divides-zeroth |
                    assume exists k: Q; isInteger(k) and
                      qat(q, NAT_ZERO) = rational.mul(e, k) {
                      @the-zeroth-quotient |
                        exists k: Q; isInteger(k) and
                          qat(q, NAT_ZERO) = rational.mul(e, k)
                        [by hypothesis given-e-divides-zeroth]
                      @the-zeroth-meaning |
                        dividesIntegrally(e, qat(q, NAT_ZERO)) iff
                          (exists k: Q; isInteger(k) and
                          qat(q, NAT_ZERO) = rational.mul(e, k))
                        [using specialize dividesIntegrallyMeaning(e, qat(q, NAT_ZERO))]
                      @e-divides-zeroth |
                        dividesIntegrally(e, qat(q, NAT_ZERO))
                        [using tautology the-zeroth-meaning the-zeroth-quotient]
                      @given-e-divides-first |
                        assume exists k: Q; isInteger(k) and
                          qat(q, nat_succ(NAT_ZERO)) =
                          rational.mul(e, k) {
                          @the-first-quotient |
                            exists k: Q; isInteger(k) and
                              qat(q, nat_succ(NAT_ZERO)) =
                              rational.mul(e, k)
                            [by hypothesis given-e-divides-first]
                          @the-first-meaning |
                            dividesIntegrally(e,
                              qat(q, nat_succ(NAT_ZERO))) iff
                              (exists k: Q; isInteger(k) and
                              qat(q, nat_succ(NAT_ZERO)) =
                              rational.mul(e, k))
                            [using specialize dividesIntegrallyMeaning(e, qat(q, nat_succ(NAT_ZERO)))]
                          @e-divides-first |
                            dividesIntegrally(e,
                              qat(q, nat_succ(NAT_ZERO)))
                            [using tautology the-first-meaning the-first-quotient]
                          // e divides every entry below TWO, by enumeration
                          @e-divides-below-two |
                            forall i: Nat;
                              nat_less_than(i,
                              nat_succ(nat_succ(NAT_ZERO))) ->
                              dividesIntegrally(e, qat(q, i))
                            [using specialize theTwoEntriesCoverTheRange(q, e) e-divides-zeroth e-divides-first]
                          @the-divisor-meaning |
                            isACommonDivisorUpTo(e, q,
                              nat_succ(nat_succ(NAT_ZERO))) iff
                              (forall i: Nat;
                              nat_less_than(i,
                              nat_succ(nat_succ(NAT_ZERO))) ->
                              dividesIntegrally(e, qat(q, i)))
                            [using specialize commonDivisorMeaning(e, q, nat_succ(nat_succ(NAT_ZERO)))]
                          @e-is-a-common-divisor |
                            isACommonDivisorUpTo(e, q,
                              nat_succ(nat_succ(NAT_ZERO)))
                            [using tautology the-divisor-meaning e-divides-below-two]
                          @e-divides-one |
                            dividesIntegrally(e, ONE)
                            [using specialize every-divisor-is-a-unit(e) e-is-an-integer e-is-a-common-divisor]
                          @the-unit-meaning |
                            dividesIntegrally(e, ONE) iff
                              (exists k: Q; isInteger(k) and
                              ONE = rational.mul(e, k))
                            [using specialize dividesIntegrallyMeaning(e, ONE)]
                          @conclusion-e-is-a-unit |
                            exists k: Q; isInteger(k) and
                              ONE = rational.mul(e, k)
                            [using tautology the-unit-meaning e-divides-one]
                        }
                      @first-implies |
                        (exists k: Q; isInteger(k) and
                          qat(q, nat_succ(NAT_ZERO)) = rational.mul(e, k)) ->
                          (exists k: Q; isInteger(k) and
                          ONE = rational.mul(e, k))
                        [by discharge given-e-divides-first]
                    }
                  @zeroth-implies |
                    (exists k: Q; isInteger(k) and
                      qat(q, NAT_ZERO) = rational.mul(e, k)) ->
                      (exists k: Q; isInteger(k) and
                      qat(q, nat_succ(NAT_ZERO)) = rational.mul(e, k)) ->
                      (exists k: Q; isInteger(k) and
                      ONE = rational.mul(e, k))
                    [by discharge given-e-divides-zeroth]
                }
              @integer-implies |
                isInteger(e) ->
                  (exists k: Q; isInteger(k) and
                  qat(q, NAT_ZERO) = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  qat(q, nat_succ(NAT_ZERO)) = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  ONE = rational.mul(e, k))
                [by discharge given-e-is-an-integer]
            }
          @conclusion-pairwise |
            qpoly.arePairwiseRelativelyPrime(qat(q, NAT_ZERO),
              qat(q, nat_succ(NAT_ZERO)))
            [by generalize each-candidate]
        }
      @coprime-implies |
        theQuotientsAreCoprime(q, nat_succ(nat_succ(NAT_ZERO))) ->
          qpoly.arePairwiseRelativelyPrime(qat(q, NAT_ZERO),
          qat(q, nat_succ(NAT_ZERO)))
        [by discharge given-coprime]
    }
  @conclusion |
    forall q: QSeq;
      theQuotientsAreCoprime(q, nat_succ(nat_succ(NAT_ZERO))) ->
      qpoly.arePairwiseRelativelyPrime(qat(q, NAT_ZERO),
      qat(q, nat_succ(NAT_ZERO)))
    [by generalize generalize-q]
qed

// -- THE REDUCED FRACTION EXISTS ----------------------------------------------------------
// `isTheIntegerDecomposition`'s reduced fraction: given a positive integer `a` and an integer
// `b`, there are `g`, `r`, `s` with `a = g·r`, `b = g·s` and `r`, `s` coprime. This is
// Judson's "reducing d/(c_0 ⋯ c_n) to its lowest terms".
//
// The pair is read as a two-element sequence and `aCoprimeDivisorOfASequenceExists` does the
// work — no separate descent, and `isAMaximalCommonDivisorOfThePair` is never needed.
theorem aReducedFractionExists: forall a, b: Q;
  isInteger(a) -> isInteger(b) -> less_than(ZERO, a) ->
  (exists g, r, s: Q;
  isInteger(g) and less_than(ZERO, g) and isInteger(r) and isInteger(s) and
  a = rational.mul(g, r) and b = rational.mul(g, s) and
  qpoly.arePairwiseRelativelyPrime(r, s))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @given-the-setup |
            assume isInteger(a) and isInteger(b) and less_than(ZERO, a) {
              @the-setup |
                isInteger(a) and isInteger(b) and less_than(ZERO, a)
                [by hypothesis given-the-setup]
              @a-is-an-integer |
                isInteger(a)
                [using tautology the-setup]
              @b-is-an-integer |
                isInteger(b)
                [using tautology the-setup]
              @a-is-positive |
                less_than(ZERO, a)
                [using tautology the-setup]
              @the-pair-exists |
                exists t: QSeq;
                  qat(t, NAT_ZERO) = a and qat(t, nat_succ(NAT_ZERO)) = b
                [using specialize aTwoElementSequenceExists(a, b)]
              @with-the-pair |
                unpack t: QSeq from the-pair-exists {
                  @the-pair |
                    qat(t, NAT_ZERO) = a and qat(t, nat_succ(NAT_ZERO)) = b
                    [by hypothesis with-the-pair]
                  @t-at-zero |
                    qat(t, NAT_ZERO) = a
                    [by and_lhs the-pair]
                  @t-at-one |
                    qat(t, nat_succ(NAT_ZERO)) = b
                    [by and_rhs the-pair]
                  @the-entries-are-integers |
                    forall i: Nat;
                      nat_less_than(i, nat_succ(nat_succ(NAT_ZERO))) ->
                      isInteger(qat(t, i))
                    [using specialize aTwoElementSequenceHasIntegerEntries(t, a, b) t-at-zero t-at-one a-is-an-integer b-is-an-integer]
                  @the-first-is-positive |
                    less_than(ZERO, qat(t, NAT_ZERO))
                    [by rewrite t-at-zero a-is-positive]
                  @zero-below-two |
                    nat_less_than(NAT_ZERO, nat_succ(nat_succ(NAT_ZERO)))
                    [using specialize peano_order.zeroIsBelowAnySuccessor(nat_succ(NAT_ZERO))]
                  @the-divisor-exists |
                    exists d: Q; exists q: QSeq;
                      isInteger(d) and less_than(ZERO, d) and
                      isACommonDivisorUpTo(d, t,
                      nat_succ(nat_succ(NAT_ZERO))) and
                      aQuotientSequenceFor(d, t, q,
                      nat_succ(nat_succ(NAT_ZERO))) and
                      theQuotientsAreCoprime(q,
                      nat_succ(nat_succ(NAT_ZERO)))
                    [using specialize aCoprimeDivisorOfASequenceExists(t, nat_succ(nat_succ(NAT_ZERO))) zero-below-two the-entries-are-integers the-first-is-positive]
                  @with-the-divisor |
                    unpack d: Q from the-divisor-exists {
                      @the-sequence-exists |
                        exists q: QSeq;
                          isInteger(d) and less_than(ZERO, d) and
                          isACommonDivisorUpTo(d, t,
                          nat_succ(nat_succ(NAT_ZERO))) and
                          aQuotientSequenceFor(d, t, q,
                          nat_succ(nat_succ(NAT_ZERO))) and
                          theQuotientsAreCoprime(q,
                          nat_succ(nat_succ(NAT_ZERO)))
                        [by hypothesis with-the-divisor]
                      @with-the-sequence |
                        unpack q: QSeq from the-sequence-exists {
                          @the-parts |
                            isInteger(d) and less_than(ZERO, d) and
                              isACommonDivisorUpTo(d, t,
                              nat_succ(nat_succ(NAT_ZERO))) and
                              aQuotientSequenceFor(d, t, q,
                              nat_succ(nat_succ(NAT_ZERO))) and
                              theQuotientsAreCoprime(q,
                              nat_succ(nat_succ(NAT_ZERO)))
                            [by hypothesis with-the-sequence]
                          @d-is-an-integer |
                            isInteger(d)
                            [using tautology the-parts]
                          @d-positive |
                            less_than(ZERO, d)
                            [using tautology the-parts]
                          @the-quotients |
                            aQuotientSequenceFor(d, t, q,
                              nat_succ(nat_succ(NAT_ZERO)))
                            [using tautology the-parts]
                          @the-divides |
                            isACommonDivisorUpTo(d, t,
                              nat_succ(nat_succ(NAT_ZERO)))
                            [using tautology the-parts]
                          @the-coprimality |
                            theQuotientsAreCoprime(q,
                              nat_succ(nat_succ(NAT_ZERO)))
                            [using tautology the-parts]
                          // read off a = d * q_0 and b = d * q_1
                          @the-quotient-meaning |
                            aQuotientSequenceFor(d, t, q,
                              nat_succ(nat_succ(NAT_ZERO))) iff
                              (forall i: Nat;
                              nat_less_than(i,
                              nat_succ(nat_succ(NAT_ZERO))) ->
                              qat(t, i) = rational.mul(d, qat(q, i)))
                            [using specialize quotientSequenceMeaning(d, t, q, nat_succ(nat_succ(NAT_ZERO)))]
                          @the-factorization |
                            forall i: Nat;
                              nat_less_than(i,
                              nat_succ(nat_succ(NAT_ZERO))) ->
                              qat(t, i) = rational.mul(d, qat(q, i))
                            [using tautology the-quotient-meaning the-quotients]
                          @one-below-two |
                            nat_less_than(nat_succ(NAT_ZERO),
                              nat_succ(nat_succ(NAT_ZERO)))
                            [using specialize peano_order.lessThanSelf(nat_succ(NAT_ZERO))]
                          @t-zero-factors |
                            qat(t, NAT_ZERO) =
                              rational.mul(d, qat(q, NAT_ZERO))
                            [using specialize the-factorization(NAT_ZERO) zero-below-two]
                          @t-one-factors |
                            qat(t, nat_succ(NAT_ZERO)) =
                              rational.mul(d, qat(q, nat_succ(NAT_ZERO)))
                            [using specialize the-factorization(nat_succ(NAT_ZERO)) one-below-two]
                          @a-factors |
                            a = rational.mul(d, qat(q, NAT_ZERO))
                            [by rewrite t-at-zero t-zero-factors]
                          @b-factors |
                            b = rational.mul(d, qat(q, nat_succ(NAT_ZERO)))
                            [by rewrite t-at-one t-one-factors]
                          @the-pairwise-coprimality |
                            qpoly.arePairwiseRelativelyPrime(
                              qat(q, NAT_ZERO), qat(q, nat_succ(NAT_ZERO)))
                            [using specialize theTwoQuotientsAreCoprime(q) the-coprimality]
                          // both quotient entries are integers, since d divides
                          // every entry of the two-element sequence
                          @the-quotient-entries-are-integers |
                            forall i: Nat;
                              nat_less_than(i,
                              nat_succ(nat_succ(NAT_ZERO))) ->
                              isInteger(qat(q, i))
                            [using specialize everyQuotientEntryIsAnInteger(t, q, nat_succ(nat_succ(NAT_ZERO)), d) d-positive the-divides the-quotients]
                          @r-is-an-integer |
                            isInteger(qat(q, NAT_ZERO))
                            [using specialize the-quotient-entries-are-integers(NAT_ZERO) zero-below-two]
                          @s-is-an-integer |
                            isInteger(qat(q, nat_succ(NAT_ZERO)))
                            [using specialize the-quotient-entries-are-integers(nat_succ(NAT_ZERO)) one-below-two]
                          @the-full-witness |
                            isInteger(d) and less_than(ZERO, d) and
                              isInteger(qat(q, NAT_ZERO)) and
                              isInteger(qat(q, nat_succ(NAT_ZERO))) and
                              a = rational.mul(d, qat(q, NAT_ZERO)) and
                              b = rational.mul(d, qat(q, nat_succ(NAT_ZERO))) and
                              qpoly.arePairwiseRelativelyPrime(
                              qat(q, NAT_ZERO), qat(q, nat_succ(NAT_ZERO)))
                            [using tautology d-is-an-integer d-positive r-is-an-integer s-is-an-integer a-factors b-factors the-pairwise-coprimality]
                          @the-s-witness |
                            exists s2: Q;
                              isInteger(d) and less_than(ZERO, d) and
                              isInteger(qat(q, NAT_ZERO)) and isInteger(s2) and
                              a = rational.mul(d, qat(q, NAT_ZERO)) and
                              b = rational.mul(d, s2) and
                              qpoly.arePairwiseRelativelyPrime(
                              qat(q, NAT_ZERO), s2)
                            [by witness(qat(q, nat_succ(NAT_ZERO))) the-full-witness]
                          @the-r-witness |
                            exists r2: Q; exists s2: Q;
                              isInteger(d) and less_than(ZERO, d) and
                              isInteger(r2) and isInteger(s2) and
                              a = rational.mul(d, r2) and
                              b = rational.mul(d, s2) and
                              qpoly.arePairwiseRelativelyPrime(r2, s2)
                            [by witness(qat(q, NAT_ZERO)) the-s-witness]
                          @conclusion-all-three |
                            exists g, r, s: Q;
                              isInteger(g) and less_than(ZERO, g) and isInteger(r) and isInteger(s) and
                              a = rational.mul(g, r) and
                              b = rational.mul(g, s) and
                              qpoly.arePairwiseRelativelyPrime(r, s)
                            [by witness(d) the-r-witness]
                        }
                      @sequence-exported |
                        exists g, r, s: Q;
                          isInteger(g) and less_than(ZERO, g) and isInteger(r) and isInteger(s) and
                          a = rational.mul(g, r) and
                          b = rational.mul(g, s) and
                          qpoly.arePairwiseRelativelyPrime(r, s)
                        [by unpacked with-the-sequence]
                    }
                  @divisor-exported |
                    exists g, r, s: Q;
                      isInteger(g) and less_than(ZERO, g) and isInteger(r) and isInteger(s) and
                      a = rational.mul(g, r) and
                      b = rational.mul(g, s) and
                      qpoly.arePairwiseRelativelyPrime(r, s)
                    [by unpacked with-the-divisor]
                }
              @pair-exported |
                exists g, r, s: Q;
                  isInteger(g) and less_than(ZERO, g) and isInteger(r) and isInteger(s) and
                  a = rational.mul(g, r) and
                  b = rational.mul(g, s) and
                  qpoly.arePairwiseRelativelyPrime(r, s)
                [by unpacked with-the-pair]
            }
          @the-implication |
            (isInteger(a) and isInteger(b) and less_than(ZERO, a)) ->
              (exists g, r, s: Q;
              isInteger(g) and less_than(ZERO, g) and isInteger(r) and isInteger(s) and
              a = rational.mul(g, r) and b = rational.mul(g, s) and
              qpoly.arePairwiseRelativelyPrime(r, s))
            [by discharge given-the-setup]
          @curried |
            isInteger(a) -> isInteger(b) -> less_than(ZERO, a) ->
              (exists g, r, s: Q;
              isInteger(g) and less_than(ZERO, g) and isInteger(r) and isInteger(s) and
              a = rational.mul(g, r) and b = rational.mul(g, s) and
              qpoly.arePairwiseRelativelyPrime(r, s))
            [using tautology the-implication]
        }
      @discharge-b |
        forall b9: Q;
          isInteger(a) -> isInteger(b9) -> less_than(ZERO, a) ->
          (exists g, r, s: Q;
          isInteger(g) and less_than(ZERO, g) and isInteger(r) and isInteger(s) and
          a = rational.mul(g, r) and b9 = rational.mul(g, s) and
          qpoly.arePairwiseRelativelyPrime(r, s))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q;
      isInteger(a) -> isInteger(b) -> less_than(ZERO, a) ->
      (exists g, r, s: Q;
      isInteger(g) and less_than(ZERO, g) and isInteger(r) and isInteger(s) and
      a = rational.mul(g, r) and b = rational.mul(g, s) and
      qpoly.arePairwiseRelativelyPrime(r, s))
    [by generalize generalize-a]
qed

// -- THE SCALING IDENTITY -----------------------------------------------------------------
// `isTheIntegerDecomposition`'s last conjunct, `p = (r/s)·q`, is an UNBOUNDED polynomial
// equation while every other conjunct is bounded by n. Deriving it needs `p` to vanish above
// n — and that is faithful to Judson, whose `p(x)` IS of degree n ("p(x) = (r/s)(a_0 + a_1 x +
// … + a_n x^n)"): his polynomial has no coefficients above n to disagree about. An arbitrary
// `QPoly` does, so `qdegreeAtMost(p, n)` is a real hypothesis of the construction, not
// bookkeeping.
//
// The per-coefficient identity, from which extensionality gives the polynomial equation.
theorem theScaledCoefficientsAgree: forall p, q: qpoly.QPoly; forall c: Q;
  (forall i: Nat; qpoly.qcoeff(p, i) = rational.mul(c, qpoly.qcoeff(q, i))) ->
  p = qpoly.qmulP(qpoly.qmonomial(c, NAT_ZERO), q)
proof
  @generalize-p |
    fix p: qpoly.QPoly {
      @generalize-q |
        fix q: qpoly.QPoly {
          @generalize-c |
            fix c: Q {
              @given-the-coefficients |
                assume forall i: Nat;
                  qpoly.qcoeff(p, i) =
                  rational.mul(c, qpoly.qcoeff(q, i)) {
                  @the-coefficients |
                    forall i: Nat;
                      qpoly.qcoeff(p, i) =
                      rational.mul(c, qpoly.qcoeff(q, i))
                    [by hypothesis given-the-coefficients]
                  @each-index |
                    fix i: Nat {
                      @the-coefficient-at-i |
                        qpoly.qcoeff(p, i) =
                          rational.mul(c, qpoly.qcoeff(q, i))
                        [using specialize the-coefficients(i)]
                      @the-scaling-law |
                        forall q2: qpoly.QPoly; forall c2: Q; forall j: Nat;
                          qpoly.qcoeff(
                          qpoly.qmulP(qpoly.qmonomial(c2, NAT_ZERO), q2), j) =
                          rational.mul(c2, qpoly.qcoeff(q2, j))
                        [using import(qpoly) scalingByAConstantScalesTheCoefficients]
                      @the-scaling-at-i |
                        qpoly.qcoeff(
                          qpoly.qmulP(qpoly.qmonomial(c, NAT_ZERO), q), i) =
                          rational.mul(c, qpoly.qcoeff(q, i))
                        [using specialize the-scaling-law(q, c, i)]
                      @conclusion-agree-at-i |
                        qpoly.qcoeff(p, i) =
                          qpoly.qcoeff(
                          qpoly.qmulP(qpoly.qmonomial(c, NAT_ZERO), q), i)
                        [using simplify the-coefficient-at-i the-scaling-at-i]
                    }
                  @all-agree |
                    forall i: Nat;
                      qpoly.qcoeff(p, i) =
                      qpoly.qcoeff(
                      qpoly.qmulP(qpoly.qmonomial(c, NAT_ZERO), q), i)
                    [by generalize each-index]
                  @the-extensionality |
                    forall a, b: qpoly.QPoly;
                      (forall i: Nat;
                      qpoly.qcoeff(a, i) = qpoly.qcoeff(b, i)) -> a = b
                    [using import(qpoly) qPolyExtensionality]
                  @conclusion-equal |
                    p = qpoly.qmulP(qpoly.qmonomial(c, NAT_ZERO), q)
                    [using specialize the-extensionality(p, qpoly.qmulP(qpoly.qmonomial(c, NAT_ZERO), q)) all-agree]
                }
              @the-implication |
                (forall i: Nat;
                  qpoly.qcoeff(p, i) =
                  rational.mul(c, qpoly.qcoeff(q, i))) ->
                  p = qpoly.qmulP(qpoly.qmonomial(c, NAT_ZERO), q)
                [by discharge given-the-coefficients]
            }
          @discharge-c |
            forall c9: Q;
              (forall i: Nat;
              qpoly.qcoeff(p, i) =
              rational.mul(c9, qpoly.qcoeff(q, i))) ->
              p = qpoly.qmulP(qpoly.qmonomial(c9, NAT_ZERO), q)
            [by generalize generalize-c]
        }
      @discharge-q |
        forall q9: qpoly.QPoly; forall c9: Q;
          (forall i: Nat;
          qpoly.qcoeff(p, i) =
          rational.mul(c9, qpoly.qcoeff(q9, i))) ->
          p = qpoly.qmulP(qpoly.qmonomial(c9, NAT_ZERO), q9)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: qpoly.QPoly; forall c: Q;
      (forall i: Nat; qpoly.qcoeff(p, i) = rational.mul(c, qpoly.qcoeff(q, i))) ->
      p = qpoly.qmulP(qpoly.qmonomial(c, NAT_ZERO), q)
    [by generalize generalize-p]
qed

// -- QUOTIENT ENTRIES ARE INTEGERS, AT ANY INDEX ------------------------------------------
// `aQuotientEntryIsAnInteger` covers index ZERO only. The reduced fraction's `r` and `s` are
// the quotient entries at indices ZERO and ONE, so both are needed — and the argument is the
// same at every index in range: the divisor divides the entry integrally, giving an integer
// quotient, and cancelling the nonzero divisor identifies it with the sequence's entry.
theorem everyQuotientEntryIsAnInteger: forall s, q: QSeq; forall n: Nat; forall d: Q;
  less_than(ZERO, d) ->
  isACommonDivisorUpTo(d, s, n) ->
  aQuotientSequenceFor(d, s, q, n) ->
  (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(q, i)))
proof
  @generalize-s |
    fix s: QSeq {
      @generalize-q |
        fix q: QSeq {
          @generalize-n |
            fix n: Nat {
              @generalize-d |
                fix d: Q {
                  @given-the-setup |
                    assume less_than(ZERO, d) and
                      isACommonDivisorUpTo(d, s, n) and
                      aQuotientSequenceFor(d, s, q, n) {
                      @the-setup |
                        less_than(ZERO, d) and
                          isACommonDivisorUpTo(d, s, n) and
                          aQuotientSequenceFor(d, s, q, n)
                        [by hypothesis given-the-setup]
                      @d-positive |
                        less_than(ZERO, d)
                        [using tautology the-setup]
                      @d-divides |
                        isACommonDivisorUpTo(d, s, n)
                        [using tautology the-setup]
                      @the-quotients |
                        aQuotientSequenceFor(d, s, q, n)
                        [using tautology the-setup]
                      @d-is-nonzero |
                        rational.nonzero(d)
                        [using specialize rational_integer_order.aPositiveIsNonzeroPredicate(d) d-positive]
                      @the-divisor-meaning |
                        isACommonDivisorUpTo(d, s, n) iff
                          (forall i: Nat; nat_less_than(i, n) ->
                          dividesIntegrally(d, qat(s, i)))
                        [using specialize commonDivisorMeaning(d, s, n)]
                      @d-divides-each |
                        forall i: Nat; nat_less_than(i, n) ->
                          dividesIntegrally(d, qat(s, i))
                        [using tautology the-divisor-meaning d-divides]
                      @the-quotient-meaning |
                        aQuotientSequenceFor(d, s, q, n) iff
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i)))
                        [using specialize quotientSequenceMeaning(d, s, q, n)]
                      @the-factorization |
                        forall i: Nat; nat_less_than(i, n) ->
                          qat(s, i) = rational.mul(d, qat(q, i))
                        [using tautology the-quotient-meaning the-quotients]
                      @each-index |
                        fix i: Nat {
                          @given-i-below |
                            assume nat_less_than(i, n) {
                              @i-below |
                                nat_less_than(i, n)
                                [by hypothesis given-i-below]
                              @d-divides-here |
                                dividesIntegrally(d, qat(s, i))
                                [using specialize d-divides-each(i) i-below]
                              @the-divides-meaning |
                                dividesIntegrally(d, qat(s, i)) iff
                                  (exists k: Q; isInteger(k) and
                                  qat(s, i) = rational.mul(d, k))
                                [using specialize dividesIntegrallyMeaning(d, qat(s, i))]
                              @an-integer-quotient |
                                exists k: Q; isInteger(k) and
                                  qat(s, i) = rational.mul(d, k)
                                [using tautology the-divides-meaning d-divides-here]
                              @the-entry-factors |
                                qat(s, i) = rational.mul(d, qat(q, i))
                                [using specialize the-factorization(i) i-below]
                              @with-the-integer-quotient |
                                unpack k: Q from an-integer-quotient {
                                  @with-quotient-k |
                                    isInteger(k) and
                                      qat(s, i) = rational.mul(d, k)
                                    [by hypothesis with-the-integer-quotient]
                                  @k-is-an-integer |
                                    isInteger(k)
                                    [by and_lhs with-quotient-k]
                                  @the-entry-is-d-times-k |
                                    qat(s, i) = rational.mul(d, k)
                                    [by and_rhs with-quotient-k]
                                  @the-products-agree |
                                    rational.mul(d, qat(q, i)) =
                                      rational.mul(d, k)
                                    [by rewrite the-entry-factors the-entry-is-d-times-k]
                                  @the-quotients-agree |
                                    qat(q, i) = k
                                    [using specialize aNonzeroFactorCancels(d, qat(q, i), k) d-is-nonzero the-products-agree]
                                  @conclusion-integer-at-i |
                                    isInteger(qat(q, i))
                                    [by rewrite the-quotients-agree k-is-an-integer]
                                }
                              @conclusion-exported-at-i |
                                isInteger(qat(q, i))
                                [by unpacked with-the-integer-quotient]
                            }
                          @below-implies |
                            nat_less_than(i, n) -> isInteger(qat(q, i))
                            [by discharge given-i-below]
                        }
                      @conclusion-all |
                        forall i: Nat; nat_less_than(i, n) ->
                          isInteger(qat(q, i))
                        [by generalize each-index]
                    }
                  @the-implication |
                    (less_than(ZERO, d) and
                      isACommonDivisorUpTo(d, s, n) and
                      aQuotientSequenceFor(d, s, q, n)) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      isInteger(qat(q, i)))
                    [by discharge given-the-setup]
                  @curried |
                    less_than(ZERO, d) ->
                      isACommonDivisorUpTo(d, s, n) ->
                      aQuotientSequenceFor(d, s, q, n) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      isInteger(qat(q, i)))
                    [using tautology the-implication]
                }
              @discharge-d |
                forall d9: Q;
                  less_than(ZERO, d9) ->
                  isACommonDivisorUpTo(d9, s, n) ->
                  aQuotientSequenceFor(d9, s, q, n) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  isInteger(qat(q, i)))
                [by generalize generalize-d]
            }
          @discharge-n |
            forall n9: Nat; forall d9: Q;
              less_than(ZERO, d9) ->
              isACommonDivisorUpTo(d9, s, n9) ->
              aQuotientSequenceFor(d9, s, q, n9) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              isInteger(qat(q, i)))
            [by generalize generalize-n]
        }
      @discharge-q |
        forall q9: QSeq; forall n9: Nat; forall d9: Q;
          less_than(ZERO, d9) ->
          isACommonDivisorUpTo(d9, s, n9) ->
          aQuotientSequenceFor(d9, s, q9, n9) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          isInteger(qat(q9, i)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall s, q: QSeq; forall n: Nat; forall d: Q;
      less_than(ZERO, d) ->
      isACommonDivisorUpTo(d, s, n) ->
      aQuotientSequenceFor(d, s, q, n) ->
      (forall i: Nat; nat_less_than(i, n) -> isInteger(qat(q, i)))
    [by generalize generalize-s]
qed

// -- THE CONSTRUCTED POLYNOMIAL IS DEGREE-BOUNDED -----------------------------------------
// `aPolynomialMatchesASequence` pins the coefficients BELOW n and says nothing above, but
// `isTheIntegerDecomposition`'s last conjunct is an UNBOUNDED polynomial equation: to read
// `p = (r/s)·q` off a per-index identity that only holds below n, both sides must vanish
// above n. For `theSubject` that is the hypothesis `qdegreeAtMost`; for the CONSTRUCTED
// polynomial it is a fact, since the construction starts at QZEROP and adds one monomial per
// index — but the induction above does not carry it, so it is carried here.
//
// The invariant is written "vanishes outside the matched range" rather than with
// `qdegreeAtMost`, because the bound moves with the match: at bound k the polynomial vanishes
// at every index NOT below k, which is one index tighter than `qdegreeAtMost(p, k)`.
// `qDegreeAtMostMeaning` converts at the end.
theorem theMonomialKeepsTheRange: forall t: QSeq; forall p: qpoly.QPoly; forall k: Nat;
  (forall i: Nat; (not nat_less_than(i, k)) -> qpoly.qcoeff(p, i) = ZERO) ->
  (forall i: Nat; (not nat_less_than(i, nat_succ(k))) ->
  qpoly.qcoeff(qpoly.qaddP(p,
  qpoly.qmonomial(rational.add(qat(t, k),
  rational.neg(qpoly.qcoeff(p, k))), k)), i) = ZERO)
proof
  @generalize-t |
    fix t: QSeq {
      @generalize-p |
        fix p: qpoly.QPoly {
          @generalize-k |
            fix k: Nat {
              @given-the-vanishing |
                assume forall i: Nat; (not nat_less_than(i, k)) ->
                  qpoly.qcoeff(p, i) = ZERO {
                  @the-vanishing |
                    forall i: Nat; (not nat_less_than(i, k)) ->
                      qpoly.qcoeff(p, i) = ZERO
                    [by hypothesis given-the-vanishing]
                  @the-add-law |
                    forall a, b: qpoly.QPoly; forall j: Nat;
                      qpoly.qcoeff(qpoly.qaddP(a, b), j) =
                      rational.add(qpoly.qcoeff(a, j), qpoly.qcoeff(b, j))
                    [using import(qpoly) qAddPolyCoeff]
                  @the-monomial-elsewhere-law |
                    forall a: Q; forall m, j: Nat;
                      (not (j = m)) ->
                      qpoly.qcoeff(qpoly.qmonomial(a, m), j) = ZERO
                    [using import(qpoly) qMonomialCoeffElsewhere]
                  @vanishes-above-succ-k |
                    fix i: Nat {
                      @given-i-not-below-succ-k |
                        assume not nat_less_than(i, nat_succ(k)) {
                          @i-not-below-succ-k |
                            not nat_less_than(i, nat_succ(k))
                            [by hypothesis given-i-not-below-succ-k]
                          // not below succ(k) means not below k either, since k < succ(k)
                          @k-below-succ-k |
                            nat_less_than(k, nat_succ(k))
                            [using specialize peano_order.lessThanSelf(k)]
                          @given-i-below-k |
                            assume nat_less_than(i, k) {
                              @i-below-k |
                                nat_less_than(i, k)
                                [by hypothesis given-i-below-k]
                              @i-below-succ-k |
                                nat_less_than(i, nat_succ(k))
                                [using specialize peano_order.lessThanTransitive(i, k, nat_succ(k)) i-below-k k-below-succ-k]
                            }
                          @i-not-below-k |
                            not nat_less_than(i, k)
                            [by contradiction given-i-below-k i-below-succ-k i-not-below-succ-k]
                          @the-old-vanishes |
                            qpoly.qcoeff(p, i) = ZERO
                            [using specialize the-vanishing(i) i-not-below-k]
                          // i is not k either: k IS below succ(k) and i is not
                          @given-i-is-k |
                            assume i = k {
                              @i-equals-k |
                                i = k
                                [by hypothesis given-i-is-k]
                              @i-below-succ-k-again |
                                nat_less_than(i, nat_succ(k))
                                [by rewrite i-equals-k k-below-succ-k]
                            }
                          @i-is-not-k |
                            not (i = k)
                            [by contradiction given-i-is-k i-below-succ-k-again i-not-below-succ-k]
                          @the-monomial-vanishes |
                            qpoly.qcoeff(qpoly.qmonomial(
                              rational.add(qat(t, k),
                              rational.neg(qpoly.qcoeff(p, k))), k), i) = ZERO
                            [using specialize the-monomial-elsewhere-law(rational.add(qat(t, k), rational.neg(qpoly.qcoeff(p, k))), k, i) i-is-not-k]
                          @the-sum-at-i |
                            qpoly.qcoeff(qpoly.qaddP(p,
                              qpoly.qmonomial(rational.add(qat(t, k),
                              rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                              rational.add(qpoly.qcoeff(p, i),
                              qpoly.qcoeff(qpoly.qmonomial(
                              rational.add(qat(t, k),
                              rational.neg(qpoly.qcoeff(p, k))), k), i))
                            [using specialize the-add-law(p, qpoly.qmonomial(rational.add(qat(t, k), rational.neg(qpoly.qcoeff(p, k))), k), i)]
                          @the-sum-of-zeros |
                            qpoly.qcoeff(qpoly.qaddP(p,
                              qpoly.qmonomial(rational.add(qat(t, k),
                              rational.neg(qpoly.qcoeff(p, k))), k)), i) =
                              rational.add(ZERO, ZERO)
                            [using simplify the-sum-at-i the-old-vanishes the-monomial-vanishes]
                          @zero-plus-zero |
                            rational.add(ZERO, ZERO) = ZERO
                            [using specialize rational.addZeroRight(ZERO)]
                          @conclusion-vanishes-at-i |
                            qpoly.qcoeff(qpoly.qaddP(p,
                              qpoly.qmonomial(rational.add(qat(t, k),
                              rational.neg(qpoly.qcoeff(p, k))), k)), i) = ZERO
                            [using simplify the-sum-of-zeros zero-plus-zero]
                        }
                      @not-below-implies-vanishes |
                        (not nat_less_than(i, nat_succ(k))) ->
                          qpoly.qcoeff(qpoly.qaddP(p,
                          qpoly.qmonomial(rational.add(qat(t, k),
                          rational.neg(qpoly.qcoeff(p, k))), k)), i) = ZERO
                        [by discharge given-i-not-below-succ-k]
                    }
                  @conclusion-all-vanish |
                    forall i: Nat; (not nat_less_than(i, nat_succ(k))) ->
                      qpoly.qcoeff(qpoly.qaddP(p,
                      qpoly.qmonomial(rational.add(qat(t, k),
                      rational.neg(qpoly.qcoeff(p, k))), k)), i) = ZERO
                    [by generalize vanishes-above-succ-k]
                }
              @the-implication |
                (forall i: Nat; (not nat_less_than(i, k)) ->
                  qpoly.qcoeff(p, i) = ZERO) ->
                  (forall i: Nat; (not nat_less_than(i, nat_succ(k))) ->
                  qpoly.qcoeff(qpoly.qaddP(p,
                  qpoly.qmonomial(rational.add(qat(t, k),
                  rational.neg(qpoly.qcoeff(p, k))), k)), i) = ZERO)
                [by discharge given-the-vanishing]
            }
          @discharge-k |
            forall k9: Nat;
              (forall i: Nat; (not nat_less_than(i, k9)) ->
              qpoly.qcoeff(p, i) = ZERO) ->
              (forall i: Nat; (not nat_less_than(i, nat_succ(k9))) ->
              qpoly.qcoeff(qpoly.qaddP(p,
              qpoly.qmonomial(rational.add(qat(t, k9),
              rational.neg(qpoly.qcoeff(p, k9))), k9)), i) = ZERO)
            [by generalize generalize-k]
        }
      @discharge-p |
        forall p9: qpoly.QPoly; forall k9: Nat;
          (forall i: Nat; (not nat_less_than(i, k9)) ->
          qpoly.qcoeff(p9, i) = ZERO) ->
          (forall i: Nat; (not nat_less_than(i, nat_succ(k9))) ->
          qpoly.qcoeff(qpoly.qaddP(p9,
          qpoly.qmonomial(rational.add(qat(t, k9),
          rational.neg(qpoly.qcoeff(p9, k9))), k9)), i) = ZERO)
        [by generalize generalize-p]
    }
  @conclusion |
    forall t: QSeq; forall p: qpoly.QPoly; forall k: Nat;
      (forall i: Nat; (not nat_less_than(i, k)) -> qpoly.qcoeff(p, i) = ZERO) ->
      (forall i: Nat; (not nat_less_than(i, nat_succ(k))) ->
      qpoly.qcoeff(qpoly.qaddP(p,
      qpoly.qmonomial(rational.add(qat(t, k),
      rational.neg(qpoly.qcoeff(p, k))), k)), i) = ZERO)
    [by generalize generalize-t]
qed

// -- A BOUNDED POLYNOMIAL FROM A SEQUENCE -------------------------------------------------
// The two halves run on the SAME witness term, so they compose into one induction whose
// invariant is a conjunction: the polynomial matches the sequence below the bound AND
// vanishes everywhere else. QZEROP serves the base on both counts — it matches nothing
// (vacuously, nothing is below ZERO) and every coefficient is ZERO.
theorem aBoundedPolynomialMatchesASequence: forall t: QSeq; forall n: Nat;
  exists p: qpoly.QPoly;
  (forall i: Nat; nat_less_than(i, n) -> qpoly.qcoeff(p, i) = qat(t, i)) and
  (forall i: Nat; (not nat_less_than(i, n)) -> qpoly.qcoeff(p, i) = ZERO)
proof
  @generalize-t |
    fix t: QSeq {
      // base: QZEROP matches vacuously below ZERO and is ZERO everywhere
      @the-zero-coefficients |
        forall i: Nat; qpoly.qcoeff(qpoly.QZEROP, i) = ZERO
        [using import(qpoly) qZeroPolyCoeff]
      @nothing-below-zero |
        fix i: Nat {
          @given-i-below-zero |
            assume nat_less_than(i, NAT_ZERO) {
              @i-below-zero |
                nat_less_than(i, NAT_ZERO)
                [by hypothesis given-i-below-zero]
              @nothing-is-below-zero |
                not nat_less_than(i, NAT_ZERO)
                [using specialize peano_order.notLessThanZero(i)]
              @conclusion-vacuous |
                qpoly.qcoeff(qpoly.QZEROP, i) = qat(t, i)
                [by ex_falso i-below-zero nothing-is-below-zero]
            }
          @below-zero-implies |
            nat_less_than(i, NAT_ZERO) ->
              qpoly.qcoeff(qpoly.QZEROP, i) = qat(t, i)
            [by discharge given-i-below-zero]
        }
      @all-below-zero |
        forall i: Nat; nat_less_than(i, NAT_ZERO) ->
          qpoly.qcoeff(qpoly.QZEROP, i) = qat(t, i)
        [by generalize nothing-below-zero]
      @zero-vanishes-outside |
        fix i: Nat {
          @given-i-not-below-zero |
            assume not nat_less_than(i, NAT_ZERO) {
              @the-zero-at-i |
                qpoly.qcoeff(qpoly.QZEROP, i) = ZERO
                [using specialize the-zero-coefficients(i)]
            }
          @not-below-zero-implies |
            (not nat_less_than(i, NAT_ZERO)) ->
              qpoly.qcoeff(qpoly.QZEROP, i) = ZERO
            [by discharge given-i-not-below-zero]
        }
      @all-outside-zero |
        forall i: Nat; (not nat_less_than(i, NAT_ZERO)) ->
          qpoly.qcoeff(qpoly.QZEROP, i) = ZERO
        [by generalize zero-vanishes-outside]
      @the-zero-serves |
        (forall i: Nat; nat_less_than(i, NAT_ZERO) ->
          qpoly.qcoeff(qpoly.QZEROP, i) = qat(t, i)) and
          (forall i: Nat; (not nat_less_than(i, NAT_ZERO)) ->
          qpoly.qcoeff(qpoly.QZEROP, i) = ZERO)
        [by both all-below-zero all-outside-zero]
      @base-case |
        exists p: qpoly.QPoly;
          (forall i: Nat; nat_less_than(i, NAT_ZERO) ->
          qpoly.qcoeff(p, i) = qat(t, i)) and
          (forall i: Nat; (not nat_less_than(i, NAT_ZERO)) ->
          qpoly.qcoeff(p, i) = ZERO)
        [by witness(qpoly.QZEROP) the-zero-serves]

      // step: the correction monomial extends the match and keeps the range
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume exists p: qpoly.QPoly;
              (forall i: Nat; nat_less_than(i, k) ->
              qpoly.qcoeff(p, i) = qat(t, i)) and
              (forall i: Nat; (not nat_less_than(i, k)) ->
              qpoly.qcoeff(p, i) = ZERO) {
              @inductive-hypothesis |
                exists p: qpoly.QPoly;
                  (forall i: Nat; nat_less_than(i, k) ->
                  qpoly.qcoeff(p, i) = qat(t, i)) and
                  (forall i: Nat; (not nat_less_than(i, k)) ->
                  qpoly.qcoeff(p, i) = ZERO)
                [by hypothesis given-inductive-hypothesis]
              @conclusion-the-step |
                unpack p: qpoly.QPoly from inductive-hypothesis {
                  @the-invariant-at-k |
                    (forall i: Nat; nat_less_than(i, k) ->
                      qpoly.qcoeff(p, i) = qat(t, i)) and
                      (forall i: Nat; (not nat_less_than(i, k)) ->
                      qpoly.qcoeff(p, i) = ZERO)
                    [by hypothesis conclusion-the-step]
                  @the-match-below-k |
                    forall i: Nat; nat_less_than(i, k) ->
                      qpoly.qcoeff(p, i) = qat(t, i)
                    [by and_lhs the-invariant-at-k]
                  @the-vanishing-outside-k |
                    forall i: Nat; (not nat_less_than(i, k)) ->
                      qpoly.qcoeff(p, i) = ZERO
                    [by and_rhs the-invariant-at-k]
                  @the-extended-match |
                    forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                      qpoly.qcoeff(qpoly.qaddP(p,
                      qpoly.qmonomial(rational.add(qat(t, k),
                      rational.neg(qpoly.qcoeff(p, k))), k)), i) = qat(t, i)
                    [using specialize theMonomialMatchesOneMoreIndex(t, p, k) the-match-below-k]
                  @the-kept-range |
                    forall i: Nat; (not nat_less_than(i, nat_succ(k))) ->
                      qpoly.qcoeff(qpoly.qaddP(p,
                      qpoly.qmonomial(rational.add(qat(t, k),
                      rational.neg(qpoly.qcoeff(p, k))), k)), i) = ZERO
                    [using specialize theMonomialKeepsTheRange(t, p, k) the-vanishing-outside-k]
                  @the-invariant-at-succ-k |
                    (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                      qpoly.qcoeff(qpoly.qaddP(p,
                      qpoly.qmonomial(rational.add(qat(t, k),
                      rational.neg(qpoly.qcoeff(p, k))), k)), i) = qat(t, i)) and
                      (forall i: Nat; (not nat_less_than(i, nat_succ(k))) ->
                      qpoly.qcoeff(qpoly.qaddP(p,
                      qpoly.qmonomial(rational.add(qat(t, k),
                      rational.neg(qpoly.qcoeff(p, k))), k)), i) = ZERO)
                    [by both the-extended-match the-kept-range]
                  @conclusion-extended |
                    exists p2: qpoly.QPoly;
                      (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                      qpoly.qcoeff(p2, i) = qat(t, i)) and
                      (forall i: Nat; (not nat_less_than(i, nat_succ(k))) ->
                      qpoly.qcoeff(p2, i) = ZERO)
                    [by witness(qpoly.qaddP(p, qpoly.qmonomial(rational.add(qat(t, k), rational.neg(qpoly.qcoeff(p, k))), k))) the-invariant-at-succ-k]
                }
              @the-step-exported |
                exists p2: qpoly.QPoly;
                  (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
                  qpoly.qcoeff(p2, i) = qat(t, i)) and
                  (forall i: Nat; (not nat_less_than(i, nat_succ(k))) ->
                  qpoly.qcoeff(p2, i) = ZERO)
                [by unpacked conclusion-the-step]
            }
          @induction-step-at-k |
            (exists p: qpoly.QPoly;
              (forall i: Nat; nat_less_than(i, k) ->
              qpoly.qcoeff(p, i) = qat(t, i)) and
              (forall i: Nat; (not nat_less_than(i, k)) ->
              qpoly.qcoeff(p, i) = ZERO)) ->
              (exists p2: qpoly.QPoly;
              (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
              qpoly.qcoeff(p2, i) = qat(t, i)) and
              (forall i: Nat; (not nat_less_than(i, nat_succ(k))) ->
              qpoly.qcoeff(p2, i) = ZERO))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          (exists p: qpoly.QPoly;
          (forall i: Nat; nat_less_than(i, k) ->
          qpoly.qcoeff(p, i) = qat(t, i)) and
          (forall i: Nat; (not nat_less_than(i, k)) ->
          qpoly.qcoeff(p, i) = ZERO)) ->
          (exists p2: qpoly.QPoly;
          (forall i: Nat; nat_less_than(i, nat_succ(k)) ->
          qpoly.qcoeff(p2, i) = qat(t, i)) and
          (forall i: Nat; (not nat_less_than(i, nat_succ(k))) ->
          qpoly.qcoeff(p2, i) = ZERO))
        [by generalize induction-step]
      @all-bounds |
        forall n: Nat;
          exists p: qpoly.QPoly;
          (forall i: Nat; nat_less_than(i, n) ->
          qpoly.qcoeff(p, i) = qat(t, i)) and
          (forall i: Nat; (not nat_less_than(i, n)) ->
          qpoly.qcoeff(p, i) = ZERO)
        [using instantiation peano.induction((fun z: Nat => (exists p: qpoly.QPoly; (forall i: Nat; nat_less_than(i, z) -> qpoly.qcoeff(p, i) = qat(t, i)) and (forall i: Nat; (not nat_less_than(i, z)) -> qpoly.qcoeff(p, i) = ZERO)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall t: QSeq; forall n: Nat;
      exists p: qpoly.QPoly;
      (forall i: Nat; nat_less_than(i, n) -> qpoly.qcoeff(p, i) = qat(t, i)) and
      (forall i: Nat; (not nat_less_than(i, n)) -> qpoly.qcoeff(p, i) = ZERO)
    [by generalize generalize-t]
qed

// -- THE SCALING EXTENDS ABOVE THE BOUND --------------------------------------------------
// `theScaledCoefficientsAgree` wants the identity at EVERY index; the construction supplies
// it only below the bound. Above the bound both sides vanish — the subject by its degree
// hypothesis, the constructed polynomial by `aBoundedPolynomialMatchesASequence`'s second
// conjunct — and `c · ZERO = ZERO` closes the gap. This is the one place `qdegreeAtMost`
// earns its keep, and it is exactly Judson's "p(x) = (r/s)(a_0 + … + a_n x^n)": his p has no
// coefficients above n to disagree about.
theorem theBoundedScalingIsTotal: forall p, q: qpoly.QPoly; forall c: Q; forall n: Nat;
  (forall i: Nat; nat_less_than(i, n) ->
  qpoly.qcoeff(p, i) = rational.mul(c, qpoly.qcoeff(q, i))) ->
  (forall i: Nat; (not nat_less_than(i, n)) -> qpoly.qcoeff(p, i) = ZERO) ->
  (forall i: Nat; (not nat_less_than(i, n)) -> qpoly.qcoeff(q, i) = ZERO) ->
  (forall i: Nat; qpoly.qcoeff(p, i) = rational.mul(c, qpoly.qcoeff(q, i)))
proof
  @generalize-p |
    fix p: qpoly.QPoly {
      @generalize-q |
        fix q: qpoly.QPoly {
          @generalize-c |
            fix c: Q {
              @generalize-n |
                fix n: Nat {
                  @given-the-match |
                    assume forall i: Nat; nat_less_than(i, n) ->
                      qpoly.qcoeff(p, i) = rational.mul(c, qpoly.qcoeff(q, i)) {
                      @given-p-vanishes |
                        assume forall i: Nat; (not nat_less_than(i, n)) ->
                          qpoly.qcoeff(p, i) = ZERO {
                          @given-q-vanishes |
                            assume forall i: Nat; (not nat_less_than(i, n)) ->
                              qpoly.qcoeff(q, i) = ZERO {
                              @the-match |
                                forall i: Nat; nat_less_than(i, n) ->
                                  qpoly.qcoeff(p, i) =
                                  rational.mul(c, qpoly.qcoeff(q, i))
                                [by hypothesis given-the-match]
                              @p-vanishes |
                                forall i: Nat; (not nat_less_than(i, n)) ->
                                  qpoly.qcoeff(p, i) = ZERO
                                [by hypothesis given-p-vanishes]
                              @q-vanishes |
                                forall i: Nat; (not nat_less_than(i, n)) ->
                                  qpoly.qcoeff(q, i) = ZERO
                                [by hypothesis given-q-vanishes]
                              @each-index |
                                fix i: Nat {
                                  @the-range-split |
                                    nat_less_than(i, n) or
                                      (not nat_less_than(i, n))
                                    [using tautology]
                                  @conclusion-at-i |
                                    qpoly.qcoeff(p, i) =
                                      rational.mul(c, qpoly.qcoeff(q, i))
                                    case the-range-split {
                                      // in range: the construction's own identity
                                      @when-in-range |
                                        assume nat_less_than(i, n) {
                                          @i-in-range |
                                            nat_less_than(i, n)
                                            [by hypothesis when-in-range]
                                          @conclusion-in-range |
                                            qpoly.qcoeff(p, i) =
                                              rational.mul(c,
                                              qpoly.qcoeff(q, i))
                                            [using specialize the-match(i) i-in-range]
                                        }
                                      // out of range: both sides are ZERO
                                      @when-out-of-range |
                                        assume not nat_less_than(i, n) {
                                          @i-out-of-range |
                                            not nat_less_than(i, n)
                                            [by hypothesis when-out-of-range]
                                          @p-is-zero |
                                            qpoly.qcoeff(p, i) = ZERO
                                            [using specialize p-vanishes(i) i-out-of-range]
                                          @q-is-zero |
                                            qpoly.qcoeff(q, i) = ZERO
                                            [using specialize q-vanishes(i) i-out-of-range]
                                          @scaling-zero |
                                            rational.mul(c, ZERO) = ZERO
                                            [using specialize rational.mulZeroRight(c)]
                                          @the-scaled-is-zero |
                                            rational.mul(c,
                                              qpoly.qcoeff(q, i)) = ZERO
                                            [using simplify q-is-zero scaling-zero]
                                          @conclusion-out-of-range |
                                            qpoly.qcoeff(p, i) =
                                              rational.mul(c,
                                              qpoly.qcoeff(q, i))
                                            [using simplify p-is-zero the-scaled-is-zero]
                                        }
                                    }
                                }
                              @conclusion-everywhere |
                                forall i: Nat;
                                  qpoly.qcoeff(p, i) =
                                  rational.mul(c, qpoly.qcoeff(q, i))
                                [by generalize each-index]
                            }
                          @q-vanishing-implies |
                            (forall i: Nat; (not nat_less_than(i, n)) ->
                              qpoly.qcoeff(q, i) = ZERO) ->
                              (forall i: Nat; qpoly.qcoeff(p, i) =
                              rational.mul(c, qpoly.qcoeff(q, i)))
                            [by discharge given-q-vanishes]
                        }
                      @p-vanishing-implies |
                        (forall i: Nat; (not nat_less_than(i, n)) ->
                          qpoly.qcoeff(p, i) = ZERO) ->
                          ((forall i: Nat; (not nat_less_than(i, n)) ->
                          qpoly.qcoeff(q, i) = ZERO) ->
                          (forall i: Nat; qpoly.qcoeff(p, i) =
                          rational.mul(c, qpoly.qcoeff(q, i))))
                        [by discharge given-p-vanishes]
                    }
                  @the-implication |
                    (forall i: Nat; nat_less_than(i, n) ->
                      qpoly.qcoeff(p, i) =
                      rational.mul(c, qpoly.qcoeff(q, i))) ->
                      ((forall i: Nat; (not nat_less_than(i, n)) ->
                      qpoly.qcoeff(p, i) = ZERO) ->
                      ((forall i: Nat; (not nat_less_than(i, n)) ->
                      qpoly.qcoeff(q, i) = ZERO) ->
                      (forall i: Nat; qpoly.qcoeff(p, i) =
                      rational.mul(c, qpoly.qcoeff(q, i)))))
                    [by discharge given-the-match]
                }
              @discharge-n |
                forall n9: Nat;
                  (forall i: Nat; nat_less_than(i, n9) ->
                  qpoly.qcoeff(p, i) =
                  rational.mul(c, qpoly.qcoeff(q, i))) ->
                  ((forall i: Nat; (not nat_less_than(i, n9)) ->
                  qpoly.qcoeff(p, i) = ZERO) ->
                  ((forall i: Nat; (not nat_less_than(i, n9)) ->
                  qpoly.qcoeff(q, i) = ZERO) ->
                  (forall i: Nat; qpoly.qcoeff(p, i) =
                  rational.mul(c, qpoly.qcoeff(q, i)))))
                [by generalize generalize-n]
            }
          @discharge-c |
            forall c9: Q; forall n9: Nat;
              (forall i: Nat; nat_less_than(i, n9) ->
              qpoly.qcoeff(p, i) =
              rational.mul(c9, qpoly.qcoeff(q, i))) ->
              ((forall i: Nat; (not nat_less_than(i, n9)) ->
              qpoly.qcoeff(p, i) = ZERO) ->
              ((forall i: Nat; (not nat_less_than(i, n9)) ->
              qpoly.qcoeff(q, i) = ZERO) ->
              (forall i: Nat; qpoly.qcoeff(p, i) =
              rational.mul(c9, qpoly.qcoeff(q, i)))))
            [by generalize generalize-c]
        }
      @discharge-q |
        forall q9: qpoly.QPoly; forall c9: Q; forall n9: Nat;
          (forall i: Nat; nat_less_than(i, n9) ->
          qpoly.qcoeff(p, i) =
          rational.mul(c9, qpoly.qcoeff(q9, i))) ->
          ((forall i: Nat; (not nat_less_than(i, n9)) ->
          qpoly.qcoeff(p, i) = ZERO) ->
          ((forall i: Nat; (not nat_less_than(i, n9)) ->
          qpoly.qcoeff(q9, i) = ZERO) ->
          (forall i: Nat; qpoly.qcoeff(p, i) =
          rational.mul(c9, qpoly.qcoeff(q9, i)))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: qpoly.QPoly; forall c: Q; forall n: Nat;
      (forall i: Nat; nat_less_than(i, n) ->
      qpoly.qcoeff(p, i) = rational.mul(c, qpoly.qcoeff(q, i))) ->
      (forall i: Nat; (not nat_less_than(i, n)) -> qpoly.qcoeff(p, i) = ZERO) ->
      (forall i: Nat; (not nat_less_than(i, n)) -> qpoly.qcoeff(q, i) = ZERO) ->
      (forall i: Nat; qpoly.qcoeff(p, i) = rational.mul(c, qpoly.qcoeff(q, i)))
    [by generalize generalize-p]
qed

// -- FROM THE CLEARED EQUATION TO THE REDUCED FRACTION ------------------------------------
// The construction leaves `whole · coeff = d · q` at each index, with `d = g·r` and
// `whole = g·s` from the reduction to lowest terms. Judson writes the conclusion as
// `coeff = (r/s)·q`, so the common factor g must cancel and s must move to the other side.
//
// Both moves need a nonzero divisor: g because it is the cancelled factor, s because
// `recip(s)` is only inverse to it when s != ZERO. s != ZERO comes from whole != ZERO —
// `whole = g·s`, and a product with a zero factor is zero.
theorem theReducedFractionScalesTheCoefficient: forall coefficient, entry: Q;
  forall whole, d, g, r, s: Q;
  rational.nonzero(g) -> rational.nonzero(s) ->
  d = rational.mul(g, r) -> whole = rational.mul(g, s) ->
  rational.mul(whole, coefficient) = rational.mul(d, entry) ->
  coefficient = rational.mul(rational.mul(r, rational.recip(s)), entry)
proof
  @generalize-coefficient |
    fix coefficient: Q {
      @generalize-entry |
        fix entry: Q {
          @generalize-whole |
            fix whole: Q {
              @generalize-d |
                fix d: Q {
                  @generalize-g |
                    fix g: Q {
                      @generalize-r |
                        fix r: Q {
                          @generalize-s |
                            fix s: Q {
                              @given-g-nonzero |
                                assume rational.nonzero(g) {
                                  @given-s-nonzero |
                                    assume rational.nonzero(s) {
                                      @given-d-factors |
                                        assume d = rational.mul(g, r) {
                                          @given-whole-factors |
                                            assume whole =
                                              rational.mul(g, s) {
                                              @given-the-cleared |
                                                assume rational.mul(whole,
                                                  coefficient) =
                                                  rational.mul(d, entry) {
                                                  @g-nonzero |
                                                    rational.nonzero(g)
                                                    [by hypothesis given-g-nonzero]
                                                  @s-nonzero |
                                                    rational.nonzero(s)
                                                    [by hypothesis given-s-nonzero]
                                                  @d-factors |
                                                    d = rational.mul(g, r)
                                                    [by hypothesis given-d-factors]
                                                  @whole-factors |
                                                    whole =
                                                      rational.mul(g, s)
                                                    [by hypothesis given-whole-factors]
                                                  @the-cleared |
                                                    rational.mul(whole,
                                                      coefficient) =
                                                      rational.mul(d, entry)
                                                    [by hypothesis given-the-cleared]
                                                  // substitute the factorizations
                                                  @the-cleared-left |
                                                    rational.mul(
                                                      rational.mul(g, s),
                                                      coefficient) =
                                                      rational.mul(d, entry)
                                                    [by rewrite whole-factors the-cleared]
                                                  @the-cleared-factored |
                                                    rational.mul(
                                                      rational.mul(g, s),
                                                      coefficient) =
                                                      rational.mul(
                                                      rational.mul(g, r),
                                                      entry)
                                                    [by rewrite d-factors the-cleared-left]
                                                  // regroup so g is the outer factor on both sides
                                                  @the-left-regrouped |
                                                    rational.mul(
                                                      rational.mul(g, s),
                                                      coefficient) =
                                                      rational.mul(g,
                                                      rational.mul(s,
                                                      coefficient))
                                                    [using polynomial(rational)]
                                                  @the-right-regrouped |
                                                    rational.mul(
                                                      rational.mul(g, r),
                                                      entry) =
                                                      rational.mul(g,
                                                      rational.mul(r, entry))
                                                    [using polynomial(rational)]
                                                  @the-left-rewritten |
                                                    rational.mul(g,
                                                      rational.mul(s,
                                                      coefficient)) =
                                                      rational.mul(
                                                      rational.mul(g, r),
                                                      entry)
                                                    [by rewrite the-left-regrouped the-cleared-factored]
                                                  @the-common-factor |
                                                    rational.mul(g,
                                                      rational.mul(s,
                                                      coefficient)) =
                                                      rational.mul(g,
                                                      rational.mul(r, entry))
                                                    [by rewrite the-right-regrouped the-left-rewritten]
                                                  @the-cancellation |
                                                    forall a, b, c: Q;
                                                      rational.nonzero(a) ->
                                                      rational.mul(a, b) =
                                                      rational.mul(a, c) ->
                                                      b = c
                                                    [by cite aNonzeroFactorCancels]
                                                  @g-cancels |
                                                    rational.mul(s,
                                                      coefficient) =
                                                      rational.mul(r, entry)
                                                    [using specialize the-cancellation(g, rational.mul(s, coefficient), rational.mul(r, entry)) g-nonzero the-common-factor]
                                                  // multiply through by recip(s)
                                                  @s-inverts |
                                                    rational.mul(s,
                                                      rational.recip(s)) =
                                                      rational.ONE
                                                    [using specialize rational.fieldInverse(s) s-nonzero]
                                                  @scaled-by-the-inverse |
                                                    rational.mul(
                                                      rational.recip(s),
                                                      rational.mul(s,
                                                      coefficient)) =
                                                      rational.mul(
                                                      rational.recip(s),
                                                      rational.mul(r, entry))
                                                    [using simplify g-cancels]
                                                  @the-left-collapses |
                                                    rational.mul(
                                                      rational.recip(s),
                                                      rational.mul(s,
                                                      coefficient)) =
                                                      rational.mul(
                                                      rational.mul(s,
                                                      rational.recip(s)),
                                                      coefficient)
                                                    [using polynomial(rational)]
                                                  @the-left-is-one-times |
                                                    rational.mul(
                                                      rational.recip(s),
                                                      rational.mul(s,
                                                      coefficient)) =
                                                      rational.mul(
                                                      rational.ONE,
                                                      coefficient)
                                                    [by rewrite s-inverts the-left-collapses]
                                                  @one-times-is-itself |
                                                    rational.mul(
                                                      rational.ONE,
                                                      coefficient) =
                                                      coefficient
                                                    [using specialize rational.mulOneLeft(coefficient)]
                                                  @the-left-is-the-coefficient |
                                                    rational.mul(
                                                      rational.recip(s),
                                                      rational.mul(s,
                                                      coefficient)) =
                                                      coefficient
                                                    [using simplify the-left-is-one-times one-times-is-itself]
                                                  @the-right-regathered |
                                                    rational.mul(
                                                      rational.recip(s),
                                                      rational.mul(r,
                                                      entry)) =
                                                      rational.mul(
                                                      rational.mul(r,
                                                      rational.recip(s)),
                                                      entry)
                                                    [using polynomial(rational)]
                                                  @the-coefficient-equals-the-right |
                                                    coefficient =
                                                      rational.mul(
                                                      rational.recip(s),
                                                      rational.mul(r, entry))
                                                    [by rewrite the-left-is-the-coefficient scaled-by-the-inverse]
                                                  @conclusion-scaled |
                                                    coefficient =
                                                      rational.mul(
                                                      rational.mul(r,
                                                      rational.recip(s)),
                                                      entry)
                                                    [by rewrite the-right-regathered the-coefficient-equals-the-right]
                                                }
                                              @cleared-implies |
                                                (rational.mul(whole,
                                                  coefficient) =
                                                  rational.mul(d, entry)) ->
                                                  coefficient =
                                                  rational.mul(
                                                  rational.mul(r,
                                                  rational.recip(s)), entry)
                                                [by discharge given-the-cleared]
                                            }
                                          @whole-implies |
                                            (whole = rational.mul(g, s)) ->
                                              ((rational.mul(whole,
                                              coefficient) =
                                              rational.mul(d, entry)) ->
                                              coefficient =
                                              rational.mul(
                                              rational.mul(r,
                                              rational.recip(s)), entry))
                                            [by discharge given-whole-factors]
                                        }
                                      @d-implies |
                                        (d = rational.mul(g, r)) ->
                                          ((whole = rational.mul(g, s)) ->
                                          ((rational.mul(whole,
                                          coefficient) =
                                          rational.mul(d, entry)) ->
                                          coefficient =
                                          rational.mul(
                                          rational.mul(r,
                                          rational.recip(s)), entry)))
                                        [by discharge given-d-factors]
                                    }
                                  @s-implies |
                                    rational.nonzero(s) ->
                                      ((d = rational.mul(g, r)) ->
                                      ((whole = rational.mul(g, s)) ->
                                      ((rational.mul(whole, coefficient) =
                                      rational.mul(d, entry)) ->
                                      coefficient =
                                      rational.mul(rational.mul(r,
                                      rational.recip(s)), entry))))
                                    [by discharge given-s-nonzero]
                                }
                              @the-implication |
                                rational.nonzero(g) ->
                                  (rational.nonzero(s) ->
                                  ((d = rational.mul(g, r)) ->
                                  ((whole = rational.mul(g, s)) ->
                                  ((rational.mul(whole, coefficient) =
                                  rational.mul(d, entry)) ->
                                  coefficient =
                                  rational.mul(rational.mul(r,
                                  rational.recip(s)), entry)))))
                                [by discharge given-g-nonzero]
                            }
                          @discharge-s |
                            forall s9: Q;
                              rational.nonzero(g) ->
                              (rational.nonzero(s9) ->
                              ((d = rational.mul(g, r)) ->
                              ((whole = rational.mul(g, s9)) ->
                              ((rational.mul(whole, coefficient) =
                              rational.mul(d, entry)) ->
                              coefficient =
                              rational.mul(rational.mul(r,
                              rational.recip(s9)), entry)))))
                            [by generalize generalize-s]
                        }
                      @discharge-r |
                        forall r9, s9: Q;
                          rational.nonzero(g) ->
                          (rational.nonzero(s9) ->
                          ((d = rational.mul(g, r9)) ->
                          ((whole = rational.mul(g, s9)) ->
                          ((rational.mul(whole, coefficient) =
                          rational.mul(d, entry)) ->
                          coefficient =
                          rational.mul(rational.mul(r9,
                          rational.recip(s9)), entry)))))
                        [by generalize generalize-r]
                    }
                  @discharge-g |
                    forall g9, r9, s9: Q;
                      rational.nonzero(g9) ->
                      (rational.nonzero(s9) ->
                      ((d = rational.mul(g9, r9)) ->
                      ((whole = rational.mul(g9, s9)) ->
                      ((rational.mul(whole, coefficient) =
                      rational.mul(d, entry)) ->
                      coefficient =
                      rational.mul(rational.mul(r9,
                      rational.recip(s9)), entry)))))
                    [by generalize generalize-g]
                }
              @discharge-d |
                forall d9, g9, r9, s9: Q;
                  rational.nonzero(g9) ->
                  (rational.nonzero(s9) ->
                  ((d9 = rational.mul(g9, r9)) ->
                  ((whole = rational.mul(g9, s9)) ->
                  ((rational.mul(whole, coefficient) =
                  rational.mul(d9, entry)) ->
                  coefficient =
                  rational.mul(rational.mul(r9,
                  rational.recip(s9)), entry)))))
                [by generalize generalize-d]
            }
          @discharge-whole |
            forall whole9, d9, g9, r9, s9: Q;
              rational.nonzero(g9) ->
              (rational.nonzero(s9) ->
              ((d9 = rational.mul(g9, r9)) ->
              ((whole9 = rational.mul(g9, s9)) ->
              ((rational.mul(whole9, coefficient) =
              rational.mul(d9, entry)) ->
              coefficient =
              rational.mul(rational.mul(r9,
              rational.recip(s9)), entry)))))
            [by generalize generalize-whole]
        }
      @discharge-entry |
        forall entry9: Q; forall whole9, d9, g9, r9, s9: Q;
          rational.nonzero(g9) ->
          (rational.nonzero(s9) ->
          ((d9 = rational.mul(g9, r9)) ->
          ((whole9 = rational.mul(g9, s9)) ->
          ((rational.mul(whole9, coefficient) =
          rational.mul(d9, entry9)) ->
          coefficient =
          rational.mul(rational.mul(r9,
          rational.recip(s9)), entry9)))))
        [by generalize generalize-entry]
    }
  @conclusion |
    forall coefficient, entry: Q; forall whole, d, g, r, s: Q;
      rational.nonzero(g) -> rational.nonzero(s) ->
      d = rational.mul(g, r) -> whole = rational.mul(g, s) ->
      rational.mul(whole, coefficient) = rational.mul(d, entry) ->
      coefficient = rational.mul(rational.mul(r, rational.recip(s)), entry)
    [by generalize generalize-coefficient]
qed

// -- THE PER-INDEX SCALING, BELOW THE BOUND -----------------------------------------------
// Assembling the two sequences: the numerators satisfy `u_i = whole · coeff_i` and the
// quotients `u_i = d · q_i`, so `whole · coeff_i = d · q_i` at every index in range — which
// is exactly `theReducedFractionScalesTheCoefficient`'s last hypothesis. Lifting that lemma
// across the index range is all this does.
theorem theScalingHoldsBelowTheBound: forall u, qseq: QSeq; forall n: Nat;
  forall whole, d, g, r, s: Q;
  rational.nonzero(g) -> rational.nonzero(s) ->
  d = rational.mul(g, r) -> whole = rational.mul(g, s) ->
  (forall i: Nat; nat_less_than(i, n) ->
  qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i))) ->
  (forall i: Nat; nat_less_than(i, n) ->
  qat(u, i) = rational.mul(d, qat(qseq, i))) ->
  (forall i: Nat; nat_less_than(i, n) ->
  qpoly.qcoeff(theSubject, i) =
  rational.mul(rational.mul(r, rational.recip(s)), qat(qseq, i)))
proof
  @generalize-u |
    fix u: QSeq {
      @generalize-qseq |
        fix qseq: QSeq {
          @generalize-n |
            fix n: Nat {
              @generalize-whole |
                fix whole: Q {
                  @generalize-d |
                    fix d: Q {
                      @generalize-g |
                        fix g: Q {
                          @generalize-r |
                            fix r: Q {
                              @generalize-s |
                                fix s: Q {
                                  @given-the-setup |
                                    assume rational.nonzero(g) and
                                      rational.nonzero(s) and
                                      d = rational.mul(g, r) and
                                      whole = rational.mul(g, s) and
                                      (forall i: Nat;
                                      nat_less_than(i, n) ->
                                      qat(u, i) = rational.mul(whole,
                                      qpoly.qcoeff(theSubject, i))) and
                                      (forall i: Nat;
                                      nat_less_than(i, n) ->
                                      qat(u, i) = rational.mul(d,
                                      qat(qseq, i))) {
                                      @the-setup |
                                        rational.nonzero(g) and
                                          rational.nonzero(s) and
                                          d = rational.mul(g, r) and
                                          whole = rational.mul(g, s) and
                                          (forall i: Nat;
                                          nat_less_than(i, n) ->
                                          qat(u, i) = rational.mul(whole,
                                          qpoly.qcoeff(theSubject, i))) and
                                          (forall i: Nat;
                                          nat_less_than(i, n) ->
                                          qat(u, i) = rational.mul(d,
                                          qat(qseq, i)))
                                        [by hypothesis given-the-setup]
                                      @g-nonzero |
                                        rational.nonzero(g)
                                        [using tautology the-setup]
                                      @s-nonzero |
                                        rational.nonzero(s)
                                        [using tautology the-setup]
                                      @d-factors |
                                        d = rational.mul(g, r)
                                        [using tautology the-setup]
                                      @whole-factors |
                                        whole = rational.mul(g, s)
                                        [using tautology the-setup]
                                      @the-numerators |
                                        forall i: Nat;
                                          nat_less_than(i, n) ->
                                          qat(u, i) = rational.mul(whole,
                                          qpoly.qcoeff(theSubject, i))
                                        [using tautology the-setup]
                                      @the-quotients |
                                        forall i: Nat;
                                          nat_less_than(i, n) ->
                                          qat(u, i) = rational.mul(d,
                                          qat(qseq, i))
                                        [using tautology the-setup]
                                      @the-scaling-lemma |
                                        forall coefficient, entry: Q;
                                          forall whole2, d2, g2, r2, s2: Q;
                                          rational.nonzero(g2) ->
                                          rational.nonzero(s2) ->
                                          d2 = rational.mul(g2, r2) ->
                                          whole2 = rational.mul(g2, s2) ->
                                          rational.mul(whole2,
                                          coefficient) =
                                          rational.mul(d2, entry) ->
                                          coefficient =
                                          rational.mul(rational.mul(r2,
                                          rational.recip(s2)), entry)
                                        [by cite theReducedFractionScalesTheCoefficient]
                                      @each-index |
                                        fix i: Nat {
                                          @given-i-in-range |
                                            assume nat_less_than(i, n) {
                                              @i-in-range |
                                                nat_less_than(i, n)
                                                [by hypothesis given-i-in-range]
                                              @the-numerator-at-i |
                                                qat(u, i) =
                                                  rational.mul(whole,
                                                  qpoly.qcoeff(
                                                  theSubject, i))
                                                [using specialize the-numerators(i) i-in-range]
                                              @the-quotient-at-i |
                                                qat(u, i) =
                                                  rational.mul(d,
                                                  qat(qseq, i))
                                                [using specialize the-quotients(i) i-in-range]
                                              @the-cleared-at-i |
                                                rational.mul(whole,
                                                  qpoly.qcoeff(
                                                  theSubject, i)) =
                                                  rational.mul(d,
                                                  qat(qseq, i))
                                                [by rewrite the-numerator-at-i the-quotient-at-i]
                                              @conclusion-scaled-at-i |
                                                qpoly.qcoeff(
                                                  theSubject, i) =
                                                  rational.mul(
                                                  rational.mul(r,
                                                  rational.recip(s)),
                                                  qat(qseq, i))
                                                [using specialize the-scaling-lemma(qpoly.qcoeff(theSubject, i), qat(qseq, i), whole, d, g, r, s) g-nonzero s-nonzero d-factors whole-factors the-cleared-at-i]
                                            }
                                          @in-range-implies |
                                            nat_less_than(i, n) ->
                                              qpoly.qcoeff(theSubject, i) =
                                              rational.mul(
                                              rational.mul(r,
                                              rational.recip(s)),
                                              qat(qseq, i))
                                            [by discharge given-i-in-range]
                                        }
                                      @conclusion-all-indices |
                                        forall i: Nat;
                                          nat_less_than(i, n) ->
                                          qpoly.qcoeff(theSubject, i) =
                                          rational.mul(
                                          rational.mul(r,
                                          rational.recip(s)),
                                          qat(qseq, i))
                                        [by generalize each-index]
                                    }
                                  @the-implication |
                                    (rational.nonzero(g) and
                                      rational.nonzero(s) and
                                      d = rational.mul(g, r) and
                                      whole = rational.mul(g, s) and
                                      (forall i: Nat;
                                      nat_less_than(i, n) ->
                                      qat(u, i) = rational.mul(whole,
                                      qpoly.qcoeff(theSubject, i))) and
                                      (forall i: Nat;
                                      nat_less_than(i, n) ->
                                      qat(u, i) = rational.mul(d,
                                      qat(qseq, i)))) ->
                                      (forall i: Nat;
                                      nat_less_than(i, n) ->
                                      qpoly.qcoeff(theSubject, i) =
                                      rational.mul(rational.mul(r,
                                      rational.recip(s)), qat(qseq, i)))
                                    [by discharge given-the-setup]
                                  @curried |
                                    rational.nonzero(g) ->
                                      rational.nonzero(s) ->
                                      d = rational.mul(g, r) ->
                                      whole = rational.mul(g, s) ->
                                      (forall i: Nat;
                                      nat_less_than(i, n) ->
                                      qat(u, i) = rational.mul(whole,
                                      qpoly.qcoeff(theSubject, i))) ->
                                      (forall i: Nat;
                                      nat_less_than(i, n) ->
                                      qat(u, i) = rational.mul(d,
                                      qat(qseq, i))) ->
                                      (forall i: Nat;
                                      nat_less_than(i, n) ->
                                      qpoly.qcoeff(theSubject, i) =
                                      rational.mul(rational.mul(r,
                                      rational.recip(s)), qat(qseq, i)))
                                    [using tautology the-implication]
                                }
                              @discharge-s |
                                forall s9: Q;
                                  rational.nonzero(g) ->
                                  rational.nonzero(s9) ->
                                  d = rational.mul(g, r) ->
                                  whole = rational.mul(g, s9) ->
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  qat(u, i) = rational.mul(whole,
                                  qpoly.qcoeff(theSubject, i))) ->
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  qat(u, i) = rational.mul(d,
                                  qat(qseq, i))) ->
                                  (forall i: Nat; nat_less_than(i, n) ->
                                  qpoly.qcoeff(theSubject, i) =
                                  rational.mul(rational.mul(r,
                                  rational.recip(s9)), qat(qseq, i)))
                                [by generalize generalize-s]
                            }
                          @discharge-r |
                            forall r9, s9: Q;
                              rational.nonzero(g) ->
                              rational.nonzero(s9) ->
                              d = rational.mul(g, r9) ->
                              whole = rational.mul(g, s9) ->
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(u, i) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, i))) ->
                              (forall i: Nat; nat_less_than(i, n) ->
                              qat(u, i) = rational.mul(d, qat(qseq, i))) ->
                              (forall i: Nat; nat_less_than(i, n) ->
                              qpoly.qcoeff(theSubject, i) =
                              rational.mul(rational.mul(r9,
                              rational.recip(s9)), qat(qseq, i)))
                            [by generalize generalize-r]
                        }
                      @discharge-g |
                        forall g9, r9, s9: Q;
                          rational.nonzero(g9) ->
                          rational.nonzero(s9) ->
                          d = rational.mul(g9, r9) ->
                          whole = rational.mul(g9, s9) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(u, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i))) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          qat(u, i) = rational.mul(d, qat(qseq, i))) ->
                          (forall i: Nat; nat_less_than(i, n) ->
                          qpoly.qcoeff(theSubject, i) =
                          rational.mul(rational.mul(r9,
                          rational.recip(s9)), qat(qseq, i)))
                        [by generalize generalize-g]
                    }
                  @discharge-d |
                    forall d9, g9, r9, s9: Q;
                      rational.nonzero(g9) ->
                      rational.nonzero(s9) ->
                      d9 = rational.mul(g9, r9) ->
                      whole = rational.mul(g9, s9) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      qat(u, i) = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i))) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      qat(u, i) = rational.mul(d9, qat(qseq, i))) ->
                      (forall i: Nat; nat_less_than(i, n) ->
                      qpoly.qcoeff(theSubject, i) =
                      rational.mul(rational.mul(r9,
                      rational.recip(s9)), qat(qseq, i)))
                    [by generalize generalize-d]
                }
              @discharge-whole |
                forall whole9, d9, g9, r9, s9: Q;
                  rational.nonzero(g9) ->
                  rational.nonzero(s9) ->
                  d9 = rational.mul(g9, r9) ->
                  whole9 = rational.mul(g9, s9) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  qat(u, i) = rational.mul(whole9,
                  qpoly.qcoeff(theSubject, i))) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  qat(u, i) = rational.mul(d9, qat(qseq, i))) ->
                  (forall i: Nat; nat_less_than(i, n) ->
                  qpoly.qcoeff(theSubject, i) =
                  rational.mul(rational.mul(r9,
                  rational.recip(s9)), qat(qseq, i)))
                [by generalize generalize-whole]
            }
          @discharge-n |
            forall n9: Nat; forall whole9, d9, g9, r9, s9: Q;
              rational.nonzero(g9) ->
              rational.nonzero(s9) ->
              d9 = rational.mul(g9, r9) ->
              whole9 = rational.mul(g9, s9) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(u, i) = rational.mul(whole9,
              qpoly.qcoeff(theSubject, i))) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              qat(u, i) = rational.mul(d9, qat(qseq, i))) ->
              (forall i: Nat; nat_less_than(i, n9) ->
              qpoly.qcoeff(theSubject, i) =
              rational.mul(rational.mul(r9,
              rational.recip(s9)), qat(qseq, i)))
            [by generalize generalize-n]
        }
      @discharge-qseq |
        forall qseq9: QSeq; forall n9: Nat; forall whole9, d9, g9, r9, s9: Q;
          rational.nonzero(g9) ->
          rational.nonzero(s9) ->
          d9 = rational.mul(g9, r9) ->
          whole9 = rational.mul(g9, s9) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(u, i) = rational.mul(whole9,
          qpoly.qcoeff(theSubject, i))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          qat(u, i) = rational.mul(d9, qat(qseq9, i))) ->
          (forall i: Nat; nat_less_than(i, n9) ->
          qpoly.qcoeff(theSubject, i) =
          rational.mul(rational.mul(r9,
          rational.recip(s9)), qat(qseq9, i)))
        [by generalize generalize-qseq]
    }
  @conclusion |
    forall u, qseq: QSeq; forall n: Nat; forall whole, d, g, r, s: Q;
      rational.nonzero(g) -> rational.nonzero(s) ->
      d = rational.mul(g, r) -> whole = rational.mul(g, s) ->
      (forall i: Nat; nat_less_than(i, n) ->
      qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i))) ->
      (forall i: Nat; nat_less_than(i, n) ->
      qat(u, i) = rational.mul(d, qat(qseq, i))) ->
      (forall i: Nat; nat_less_than(i, n) ->
      qpoly.qcoeff(theSubject, i) =
      rational.mul(rational.mul(r, rational.recip(s)), qat(qseq, i)))
    [by generalize generalize-u]
qed

// The two ways of saying "outside the range 0 … n" line up: an index NOT below succ(n) is
// strictly above n. `qdegreeAtMost` is phrased the second way and the construction the first,
// so the vanishing facts have to be converted before they can meet.
theorem theOutsideIsAbove: forall p: qpoly.QPoly; forall n: Nat;
  (forall i: Nat; nat_less_than(n, i) -> qpoly.qcoeff(p, i) = ZERO) ->
  (forall i: Nat; (not nat_less_than(i, nat_succ(n))) ->
  qpoly.qcoeff(p, i) = ZERO)
proof
  @generalize-p |
    fix p: qpoly.QPoly {
      @generalize-n |
        fix n: Nat {
          @given-the-vanishing |
            assume forall i: Nat; nat_less_than(n, i) ->
              qpoly.qcoeff(p, i) = ZERO {
              @the-vanishing |
                forall i: Nat; nat_less_than(n, i) ->
                  qpoly.qcoeff(p, i) = ZERO
                [by hypothesis given-the-vanishing]
              @each-index |
                fix i: Nat {
                  @given-i-outside |
                    assume not nat_less_than(i, nat_succ(n)) {
                      @i-outside |
                        not nat_less_than(i, nat_succ(n))
                        [by hypothesis given-i-outside]
                      @the-trichotomy |
                        nat_less_than(n, i) or n = i or
                          nat_less_than(i, n)
                        [using specialize peano_order.trichotomy(n, i)]
                      @n-is-below-i |
                        nat_less_than(n, i)
                        case the-trichotomy {
                          // n < i or n = i: the first arm is the goal
                          @when-not-above |
                            assume nat_less_than(n, i) or n = i {
                              @the-left-cases |
                                nat_less_than(n, i) or n = i
                                [by hypothesis when-not-above]
                              @conclusion-left |
                                nat_less_than(n, i)
                                case the-left-cases {
                                  @when-above |
                                    assume nat_less_than(n, i) {
                                      @conclusion-already |
                                        nat_less_than(n, i)
                                        [by hypothesis when-above]
                                    }
                                  // n = i makes i <= n, so i < succ(n)
                                  @when-equal |
                                    assume n = i {
                                      @n-is-i |
                                        n = i
                                        [by hypothesis when-equal]
                                      @n-below-succ-n |
                                        nat_less_than(n, nat_succ(n))
                                        [using specialize peano_order.lessThanSelf(n)]
                                      @i-below-succ-n |
                                        nat_less_than(i, nat_succ(n))
                                        [by rewrite n-is-i n-below-succ-n]
                                      @conclusion-equal |
                                        nat_less_than(n, i)
                                        [by ex_falso i-below-succ-n i-outside]
                                    }
                                }
                            }
                          // i < n makes i <= n, so i < succ(n)
                          @when-below |
                            assume nat_less_than(i, n) {
                              @i-below-n |
                                nat_less_than(i, n)
                                [by hypothesis when-below]
                              @i-at-most-n-strict |
                                peano_order.less_or_equal(i, n)
                                [using specialize peano_order.lessThanToLessOrEqual(i, n) i-below-n]
                              @i-below-succ-n-strict |
                                nat_less_than(i, nat_succ(n))
                                [using specialize peano_order.lessOrEqualToLessThanSucc(i, n) i-at-most-n-strict]
                              @conclusion-below |
                                nat_less_than(n, i)
                                [by ex_falso i-below-succ-n-strict i-outside]
                            }
                        }
                      @conclusion-vanishes-at-i |
                        qpoly.qcoeff(p, i) = ZERO
                        [using specialize the-vanishing(i) n-is-below-i]
                    }
                  @outside-implies |
                    (not nat_less_than(i, nat_succ(n))) ->
                      qpoly.qcoeff(p, i) = ZERO
                    [by discharge given-i-outside]
                }
              @conclusion-all |
                forall i: Nat; (not nat_less_than(i, nat_succ(n))) ->
                  qpoly.qcoeff(p, i) = ZERO
                [by generalize each-index]
            }
          @the-implication |
            (forall i: Nat; nat_less_than(n, i) ->
              qpoly.qcoeff(p, i) = ZERO) ->
              (forall i: Nat; (not nat_less_than(i, nat_succ(n))) ->
              qpoly.qcoeff(p, i) = ZERO)
            [by discharge given-the-vanishing]
        }
      @discharge-n |
        forall n9: Nat;
          (forall i: Nat; nat_less_than(n9, i) ->
          qpoly.qcoeff(p, i) = ZERO) ->
          (forall i: Nat; (not nat_less_than(i, nat_succ(n9))) ->
          qpoly.qcoeff(p, i) = ZERO)
        [by generalize generalize-n]
    }
  @conclusion |
    forall p: qpoly.QPoly; forall n: Nat;
      (forall i: Nat; nat_less_than(n, i) -> qpoly.qcoeff(p, i) = ZERO) ->
      (forall i: Nat; (not nat_less_than(i, nat_succ(n))) ->
      qpoly.qcoeff(p, i) = ZERO)
    [by generalize generalize-p]
qed

// -- STAGES D AND E: FROM THE DIVISOR TO THE DECOMPOSITION --------------------------------
// Everything above produces two sequences over the same index range: the cleared numerators
// `u` (with `u_i = whole · coeff_i`) and their quotients `qseq` (with `u_i = d · q_i`), the
// latter having integral and pairwise-coprime entries. This turns that into the decomposition
// predicate's seven conjuncts.
//
//   the quotient sequence becomes a polynomial    `aBoundedPolynomialMatchesASequence`
//   conjunct 4, integer coefficients              `integerEntriesMakeIntegerCoefficients`
//   conjunct 5, coprime coefficients              `coprimeEntriesMakeCoprimeCoefficients`
//   conjuncts 1, 2, 3 and 6, the reduced pair     `aReducedFractionExists` at (d, whole)
//   conjunct 7, the polynomial equation           `theScalingHoldsBelowTheBound`
//                                                 + `theBoundedScalingIsTotal`
//                                                 + `theScaledCoefficientsAgree`
//
// `aReducedFractionExists` is applied at (d, whole) — d FIRST, because it is the argument
// required to be positive, and `whole` need not be.
theorem theDecompositionFromTheDivisor: forall u, qseq: QSeq; forall n: Nat;
  forall whole, d: Q;
  qpoly.qdegreeAtMost(theSubject, n) ->
  isInteger(whole) -> rational.nonzero(whole) ->
  isInteger(d) -> less_than(ZERO, d) ->
  (forall i: Nat; nat_less_than(i, nat_succ(n)) -> isInteger(qat(qseq, i))) ->
  theQuotientsAreCoprime(qseq, nat_succ(n)) ->
  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
  qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i))) ->
  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
  qat(u, i) = rational.mul(d, qat(qseq, i))) ->
  (exists q: qpoly.QPoly; exists r, s: Q;
  qpoly.isTheIntegerDecomposition(theSubject, q, r, s, nat_succ(n)))
proof
  @generalize-u |
    fix u: QSeq {
      @generalize-qseq |
        fix qseq: QSeq {
          @generalize-n |
            fix n: Nat {
              @generalize-whole |
                fix whole: Q {
                  @generalize-d |
                    fix d: Q {
                      @given-the-setup |
                        assume qpoly.qdegreeAtMost(theSubject, n) and
                          isInteger(whole) and
                          rational.nonzero(whole) and isInteger(d) and
                          less_than(ZERO, d) and
                          (forall i: Nat;
                          nat_less_than(i, nat_succ(n)) ->
                          isInteger(qat(qseq, i))) and
                          theQuotientsAreCoprime(qseq, nat_succ(n)) and
                          (forall i: Nat;
                          nat_less_than(i, nat_succ(n)) ->
                          qat(u, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i))) and
                          (forall i: Nat;
                          nat_less_than(i, nat_succ(n)) ->
                          qat(u, i) = rational.mul(d, qat(qseq, i))) {
                          @the-setup |
                            qpoly.qdegreeAtMost(theSubject, n) and
                              isInteger(whole) and
                              rational.nonzero(whole) and isInteger(d) and
                              less_than(ZERO, d) and
                              (forall i: Nat;
                              nat_less_than(i, nat_succ(n)) ->
                              isInteger(qat(qseq, i))) and
                              theQuotientsAreCoprime(qseq,
                              nat_succ(n)) and
                              (forall i: Nat;
                              nat_less_than(i, nat_succ(n)) ->
                              qat(u, i) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, i))) and
                              (forall i: Nat;
                              nat_less_than(i, nat_succ(n)) ->
                              qat(u, i) = rational.mul(d, qat(qseq, i)))
                            [by hypothesis given-the-setup]
                          @the-degree-bound |
                            qpoly.qdegreeAtMost(theSubject, n)
                            [using tautology the-setup]
                          @whole-is-an-integer |
                            isInteger(whole)
                            [using tautology the-setup]
                          @whole-is-nonzero |
                            rational.nonzero(whole)
                            [using tautology the-setup]
                          @d-is-an-integer |
                            isInteger(d)
                            [using tautology the-setup]
                          @d-is-positive |
                            less_than(ZERO, d)
                            [using tautology the-setup]
                          @the-entries-are-integers |
                            forall i: Nat;
                              nat_less_than(i, nat_succ(n)) ->
                              isInteger(qat(qseq, i))
                            [using tautology the-setup]
                          @the-entries-are-coprime |
                            theQuotientsAreCoprime(qseq, nat_succ(n))
                            [using tautology the-setup]
                          @the-numerator-values |
                            forall i: Nat;
                              nat_less_than(i, nat_succ(n)) ->
                              qat(u, i) = rational.mul(whole,
                              qpoly.qcoeff(theSubject, i))
                            [using tautology the-setup]
                          @the-quotient-values |
                            forall i: Nat;
                              nat_less_than(i, nat_succ(n)) ->
                              qat(u, i) = rational.mul(d, qat(qseq, i))
                            [using tautology the-setup]

                          // whole is nonzero: the first numerator is d · q_0,
                          // and a positive d forces whole != ZERO only once we
                          // know the reduced pair, so take it from the
                          // reduction itself below.
                          // STAGE E: reduce d/whole to lowest terms
                          @the-reduction-exists |
                            exists g, r, s: Q;
                              isInteger(g) and less_than(ZERO, g) and
                              isInteger(r) and isInteger(s) and
                              d = rational.mul(g, r) and
                              whole = rational.mul(g, s) and
                              qpoly.arePairwiseRelativelyPrime(r, s)
                            [using specialize aReducedFractionExists(d, whole) d-is-an-integer whole-is-an-integer d-is-positive]
                          @with-the-common-factor |
                            unpack g: Q from the-reduction-exists {
                              @the-numerator-exists |
                                exists r, s: Q;
                                  isInteger(g) and less_than(ZERO, g) and
                                  isInteger(r) and isInteger(s) and
                                  d = rational.mul(g, r) and
                                  whole = rational.mul(g, s) and
                                  qpoly.arePairwiseRelativelyPrime(r, s)
                                [by hypothesis with-the-common-factor]
                              @with-the-numerator |
                                unpack r: Q from the-numerator-exists {
                                  @the-denominator-exists |
                                    exists s: Q;
                                      isInteger(g) and
                                      less_than(ZERO, g) and
                                      isInteger(r) and isInteger(s) and
                                      d = rational.mul(g, r) and
                                      whole = rational.mul(g, s) and
                                      qpoly.arePairwiseRelativelyPrime(r, s)
                                    [by hypothesis with-the-numerator]
                                  @with-the-denominator |
                                    unpack s: Q from the-denominator-exists {
                                      @the-reduction |
                                        isInteger(g) and
                                          less_than(ZERO, g) and
                                          isInteger(r) and isInteger(s) and
                                          d = rational.mul(g, r) and
                                          whole = rational.mul(g, s) and
                                          qpoly.arePairwiseRelativelyPrime(
                                          r, s)
                                        [by hypothesis with-the-denominator]
                                      @g-is-positive |
                                        less_than(ZERO, g)
                                        [using tautology the-reduction]
                                      @r-is-an-integer |
                                        isInteger(r)
                                        [using tautology the-reduction]
                                      @s-is-an-integer |
                                        isInteger(s)
                                        [using tautology the-reduction]
                                      @d-factors |
                                        d = rational.mul(g, r)
                                        [using tautology the-reduction]
                                      @whole-factors |
                                        whole = rational.mul(g, s)
                                        [using tautology the-reduction]
                                      @the-pair-is-coprime |
                                        qpoly.arePairwiseRelativelyPrime(
                                          r, s)
                                        [using tautology the-reduction]
                                      @g-is-nonzero |
                                        rational.nonzero(g)
                                        [using specialize rational_integer_order.aPositiveIsNonzeroPredicate(g) g-is-positive]
                                      // s != ZERO: whole = g·s, so s = ZERO would
                                      // make whole = ZERO
                                      @given-s-is-zero |
                                        assume s = ZERO {
                                          @s-is-zero |
                                            s = ZERO
                                            [by hypothesis given-s-is-zero]
                                          @whole-is-g-times-zero |
                                            whole = rational.mul(g, ZERO)
                                            [by rewrite s-is-zero whole-factors]
                                          @g-times-zero |
                                            rational.mul(g, ZERO) = ZERO
                                            [using specialize rational.mulZeroRight(g)]
                                          @whole-is-zero |
                                            whole = ZERO
                                            [using simplify whole-is-g-times-zero g-times-zero]
                                        }
                                      // `contradiction` needs the literal negation
                                      @whole-characterized |
                                        rational.nonzero(whole) iff (not (whole = ZERO))
                                        [using specialize rational.nonzeroMeaning(whole)]
                                      @whole-is-not-zero |
                                        not (whole = ZERO)
                                        [using tautology whole-characterized whole-is-nonzero]
                                      @s-is-not-zero |
                                        not (s = ZERO)
                                        [by contradiction given-s-is-zero whole-is-zero whole-is-not-zero]
                                      @s-characterized |
                                        rational.nonzero(s) iff (not (s = ZERO))
                                        [using specialize rational.nonzeroMeaning(s)]
                                      @s-is-nonzero |
                                        rational.nonzero(s)
                                        [using tautology s-characterized s-is-not-zero]

                                      // STAGE D: the quotient sequence as a
                                      // degree-bounded polynomial
                                      @the-polynomial-exists |
                                        exists qp: qpoly.QPoly;
                                          (forall i: Nat;
                                          nat_less_than(i, nat_succ(n)) ->
                                          qpoly.qcoeff(qp, i) =
                                          qat(qseq, i)) and
                                          (forall i: Nat;
                                          (not nat_less_than(i,
                                          nat_succ(n))) ->
                                          qpoly.qcoeff(qp, i) = ZERO)
                                        [using specialize aBoundedPolynomialMatchesASequence(qseq, nat_succ(n))]
                                      @with-the-polynomial |
                                        unpack qp: qpoly.QPoly from the-polynomial-exists {
                                          @the-polynomial-invariant |
                                            (forall i: Nat;
                                              nat_less_than(i,
                                              nat_succ(n)) ->
                                              qpoly.qcoeff(qp, i) =
                                              qat(qseq, i)) and
                                              (forall i: Nat;
                                              (not nat_less_than(i,
                                              nat_succ(n))) ->
                                              qpoly.qcoeff(qp, i) = ZERO)
                                            [by hypothesis with-the-polynomial]
                                          @the-match |
                                            forall i: Nat;
                                              nat_less_than(i,
                                              nat_succ(n)) ->
                                              qpoly.qcoeff(qp, i) =
                                              qat(qseq, i)
                                            [by and_lhs the-polynomial-invariant]
                                          @the-polynomial-vanishes |
                                            forall i: Nat;
                                              (not nat_less_than(i,
                                              nat_succ(n))) ->
                                              qpoly.qcoeff(qp, i) = ZERO
                                            [by and_rhs the-polynomial-invariant]
                                          // conjunct 4
                                          @the-coefficients-are-integers |
                                            qpoly.hasIntegerCoefficientsUpTo(
                                              qp, nat_succ(n))
                                            [using specialize integerEntriesMakeIntegerCoefficients(qp, qseq, nat_succ(n)) the-match the-entries-are-integers]
                                          // conjunct 5
                                          @the-coefficients-are-coprime |
                                            qpoly.coefficientsAreRelativelyPrimeUpTo(
                                              qp, nat_succ(n))
                                            [using specialize coprimeEntriesMakeCoprimeCoefficients(qp, qseq, nat_succ(n)) the-match the-entries-are-coprime]

                                          // conjunct 7: the polynomial equation
                                          @the-scaling-below |
                                            forall i: Nat;
                                              nat_less_than(i,
                                              nat_succ(n)) ->
                                              qpoly.qcoeff(theSubject, i) =
                                              rational.mul(
                                              rational.mul(r,
                                              rational.recip(s)),
                                              qat(qseq, i))
                                            [using specialize theScalingHoldsBelowTheBound(u, qseq, nat_succ(n), whole, d, g, r, s) g-is-nonzero s-is-nonzero d-factors whole-factors the-numerator-values the-quotient-values]
                                          @the-scaling-through-the-polynomial |
                                            fix i: Nat {
                                              @given-i-below |
                                                assume nat_less_than(i,
                                                  nat_succ(n)) {
                                                  @i-below |
                                                    nat_less_than(i,
                                                      nat_succ(n))
                                                    [by hypothesis given-i-below]
                                                  @the-entry-at-i |
                                                    qpoly.qcoeff(qp, i) =
                                                      qat(qseq, i)
                                                    [using specialize the-match(i) i-below]
                                                  @the-scaling-at-i |
                                                    qpoly.qcoeff(
                                                      theSubject, i) =
                                                      rational.mul(
                                                      rational.mul(r,
                                                      rational.recip(s)),
                                                      qat(qseq, i))
                                                    [using specialize the-scaling-below(i) i-below]
                                                  @conclusion-through-qp |
                                                    qpoly.qcoeff(
                                                      theSubject, i) =
                                                      rational.mul(
                                                      rational.mul(r,
                                                      rational.recip(s)),
                                                      qpoly.qcoeff(qp, i))
                                                    [by rewrite the-entry-at-i the-scaling-at-i]
                                                }
                                              @below-implies |
                                                nat_less_than(i,
                                                  nat_succ(n)) ->
                                                  qpoly.qcoeff(
                                                  theSubject, i) =
                                                  rational.mul(
                                                  rational.mul(r,
                                                  rational.recip(s)),
                                                  qpoly.qcoeff(qp, i))
                                                [by discharge given-i-below]
                                            }
                                          @the-scaling-on-coefficients |
                                            forall i: Nat;
                                              nat_less_than(i,
                                              nat_succ(n)) ->
                                              qpoly.qcoeff(theSubject, i) =
                                              rational.mul(
                                              rational.mul(r,
                                              rational.recip(s)),
                                              qpoly.qcoeff(qp, i))
                                            [by generalize the-scaling-through-the-polynomial]
                                          // the subject vanishes above n, hence
                                          // above the bound succ(n) too
                                          @the-degree-meaning |
                                            qpoly.qdegreeAtMost(
                                              theSubject, n) iff
                                              (forall i: Nat;
                                              nat_less_than(n, i) ->
                                              qpoly.qcoeff(
                                              theSubject, i) = ZERO)
                                            [using specialize qpoly.qDegreeAtMostMeaning(theSubject, n)]
                                          @the-subject-vanishes-above-n |
                                            forall i: Nat;
                                              nat_less_than(n, i) ->
                                              qpoly.qcoeff(
                                              theSubject, i) = ZERO
                                            [using tautology the-degree-meaning the-degree-bound]
                                          @the-subject-vanishes |
                                            forall i: Nat;
                                              (not nat_less_than(i,
                                              nat_succ(n))) ->
                                              qpoly.qcoeff(
                                              theSubject, i) = ZERO
                                            [using specialize theOutsideIsAbove(theSubject, n) the-subject-vanishes-above-n]
                                          @the-scaling-everywhere |
                                            forall i: Nat;
                                              qpoly.qcoeff(theSubject, i) =
                                              rational.mul(
                                              rational.mul(r,
                                              rational.recip(s)),
                                              qpoly.qcoeff(qp, i))
                                            [using specialize theBoundedScalingIsTotal(theSubject, qp, rational.mul(r, rational.recip(s)), nat_succ(n)) the-scaling-on-coefficients the-subject-vanishes the-polynomial-vanishes]
                                          @the-polynomial-equation |
                                            theSubject =
                                              qpoly.qmulP(
                                              qpoly.qmonomial(
                                              rational.mul(r,
                                              rational.recip(s)),
                                              NAT_ZERO), qp)
                                            [using specialize theScaledCoefficientsAgree(theSubject, qp, rational.mul(r, rational.recip(s))) the-scaling-everywhere]

                                          // all seven conjuncts
                                          @the-decomposition-meaning |
                                            qpoly.isTheIntegerDecomposition(
                                              theSubject, qp, r, s,
                                              nat_succ(n)) iff
                                              (isInteger(r) and
                                              isInteger(s) and
                                              rational.nonzero(s) and
                                              qpoly.hasIntegerCoefficientsUpTo(
                                              qp, nat_succ(n)) and
                                              qpoly.coefficientsAreRelativelyPrimeUpTo(
                                              qp, nat_succ(n)) and
                                              qpoly.arePairwiseRelativelyPrime(
                                              r, s) and
                                              theSubject =
                                              qpoly.qmulP(
                                              qpoly.qmonomial(
                                              rational.mul(r,
                                              rational.recip(s)),
                                              NAT_ZERO), qp))
                                            [using specialize qpoly.integerDecompositionMeaning(theSubject, qp, r, s, nat_succ(n))]
                                          @the-decomposition |
                                            qpoly.isTheIntegerDecomposition(
                                              theSubject, qp, r, s,
                                              nat_succ(n))
                                            [using tautology the-decomposition-meaning r-is-an-integer s-is-an-integer s-is-nonzero the-coefficients-are-integers the-coefficients-are-coprime the-pair-is-coprime the-polynomial-equation]
                                          @the-denominator-witness |
                                            exists s2: Q;
                                              qpoly.isTheIntegerDecomposition(
                                              theSubject, qp, r, s2,
                                              nat_succ(n))
                                            [by witness(s) the-decomposition]
                                          @the-numerator-witness |
                                            exists r2, s2: Q;
                                              qpoly.isTheIntegerDecomposition(
                                              theSubject, qp, r2, s2,
                                              nat_succ(n))
                                            [by witness(r) the-denominator-witness]
                                          @conclusion-all-three |
                                            exists q: qpoly.QPoly;
                                              exists r2, s2: Q;
                                              qpoly.isTheIntegerDecomposition(
                                              theSubject, q, r2, s2,
                                              nat_succ(n))
                                            [by witness(qp) the-numerator-witness]
                                        }
                                      @polynomial-exported |
                                        exists q: qpoly.QPoly;
                                          exists r2, s2: Q;
                                          qpoly.isTheIntegerDecomposition(
                                          theSubject, q, r2, s2,
                                          nat_succ(n))
                                        [by unpacked with-the-polynomial]
                                    }
                                  @denominator-exported |
                                    exists q: qpoly.QPoly; exists r2, s2: Q;
                                      qpoly.isTheIntegerDecomposition(
                                      theSubject, q, r2, s2, nat_succ(n))
                                    [by unpacked with-the-denominator]
                                }
                              @numerator-exported |
                                exists q: qpoly.QPoly; exists r2, s2: Q;
                                  qpoly.isTheIntegerDecomposition(
                                  theSubject, q, r2, s2, nat_succ(n))
                                [by unpacked with-the-numerator]
                            }
                          @conclusion-in-the-block |
                            exists q: qpoly.QPoly; exists r2, s2: Q;
                              qpoly.isTheIntegerDecomposition(theSubject,
                              q, r2, s2, nat_succ(n))
                            [by unpacked with-the-common-factor]
                        }
                      @the-implication |
                        (qpoly.qdegreeAtMost(theSubject, n) and
                          isInteger(whole) and
                          rational.nonzero(whole) and isInteger(d) and
                          less_than(ZERO, d) and
                          (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                          isInteger(qat(qseq, i))) and
                          theQuotientsAreCoprime(qseq, nat_succ(n)) and
                          (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                          qat(u, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i))) and
                          (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                          qat(u, i) = rational.mul(d, qat(qseq, i)))) ->
                          (exists q: qpoly.QPoly; exists r2, s2: Q;
                          qpoly.isTheIntegerDecomposition(theSubject, q,
                          r2, s2, nat_succ(n)))
                        [by discharge given-the-setup]
                      @curried |
                        qpoly.qdegreeAtMost(theSubject, n) ->
                          isInteger(whole) -> rational.nonzero(whole) ->
                          isInteger(d) -> less_than(ZERO, d) ->
                          (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                          isInteger(qat(qseq, i))) ->
                          theQuotientsAreCoprime(qseq, nat_succ(n)) ->
                          (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                          qat(u, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i))) ->
                          (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                          qat(u, i) = rational.mul(d, qat(qseq, i))) ->
                          (exists q: qpoly.QPoly; exists r2, s2: Q;
                          qpoly.isTheIntegerDecomposition(theSubject, q,
                          r2, s2, nat_succ(n)))
                        [using tautology the-implication]
                    }
                  @discharge-d |
                    forall d9: Q;
                      qpoly.qdegreeAtMost(theSubject, n) ->
                      isInteger(whole) -> rational.nonzero(whole) ->
                      isInteger(d9) -> less_than(ZERO, d9) ->
                      (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                      isInteger(qat(qseq, i))) ->
                      theQuotientsAreCoprime(qseq, nat_succ(n)) ->
                      (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                      qat(u, i) = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i))) ->
                      (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                      qat(u, i) = rational.mul(d9, qat(qseq, i))) ->
                      (exists q: qpoly.QPoly; exists r2, s2: Q;
                      qpoly.isTheIntegerDecomposition(theSubject, q, r2,
                      s2, nat_succ(n)))
                    [by generalize generalize-d]
                }
              @discharge-whole |
                forall whole9, d9: Q;
                  qpoly.qdegreeAtMost(theSubject, n) ->
                  isInteger(whole9) -> rational.nonzero(whole9) ->
                  isInteger(d9) -> less_than(ZERO, d9) ->
                  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                  isInteger(qat(qseq, i))) ->
                  theQuotientsAreCoprime(qseq, nat_succ(n)) ->
                  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                  qat(u, i) = rational.mul(whole9,
                  qpoly.qcoeff(theSubject, i))) ->
                  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                  qat(u, i) = rational.mul(d9, qat(qseq, i))) ->
                  (exists q: qpoly.QPoly; exists r2, s2: Q;
                  qpoly.isTheIntegerDecomposition(theSubject, q, r2, s2,
                  nat_succ(n)))
                [by generalize generalize-whole]
            }
          @discharge-n |
            forall n9: Nat; forall whole9, d9: Q;
              qpoly.qdegreeAtMost(theSubject, n9) ->
              isInteger(whole9) -> rational.nonzero(whole9) ->
              isInteger(d9) -> less_than(ZERO, d9) ->
              (forall i: Nat; nat_less_than(i, nat_succ(n9)) ->
              isInteger(qat(qseq, i))) ->
              theQuotientsAreCoprime(qseq, nat_succ(n9)) ->
              (forall i: Nat; nat_less_than(i, nat_succ(n9)) ->
              qat(u, i) = rational.mul(whole9,
              qpoly.qcoeff(theSubject, i))) ->
              (forall i: Nat; nat_less_than(i, nat_succ(n9)) ->
              qat(u, i) = rational.mul(d9, qat(qseq, i))) ->
              (exists q: qpoly.QPoly; exists r2, s2: Q;
              qpoly.isTheIntegerDecomposition(theSubject, q, r2, s2,
              nat_succ(n9)))
            [by generalize generalize-n]
        }
      @discharge-qseq |
        forall qseq9: QSeq; forall n9: Nat; forall whole9, d9: Q;
          qpoly.qdegreeAtMost(theSubject, n9) ->
          isInteger(whole9) -> rational.nonzero(whole9) ->
          isInteger(d9) -> less_than(ZERO, d9) ->
          (forall i: Nat; nat_less_than(i, nat_succ(n9)) ->
          isInteger(qat(qseq9, i))) ->
          theQuotientsAreCoprime(qseq9, nat_succ(n9)) ->
          (forall i: Nat; nat_less_than(i, nat_succ(n9)) ->
          qat(u, i) = rational.mul(whole9,
          qpoly.qcoeff(theSubject, i))) ->
          (forall i: Nat; nat_less_than(i, nat_succ(n9)) ->
          qat(u, i) = rational.mul(d9, qat(qseq9, i))) ->
          (exists q: qpoly.QPoly; exists r2, s2: Q;
          qpoly.isTheIntegerDecomposition(theSubject, q, r2, s2,
          nat_succ(n9)))
        [by generalize generalize-qseq]
    }
  @conclusion |
    forall u, qseq: QSeq; forall n: Nat; forall whole, d: Q;
      qpoly.qdegreeAtMost(theSubject, n) ->
      isInteger(whole) -> rational.nonzero(whole) ->
      isInteger(d) -> less_than(ZERO, d) ->
      (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
      isInteger(qat(qseq, i))) ->
      theQuotientsAreCoprime(qseq, nat_succ(n)) ->
      (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
      qat(u, i) = rational.mul(whole, qpoly.qcoeff(theSubject, i))) ->
      (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
      qat(u, i) = rational.mul(d, qat(qseq, i))) ->
      (exists q: qpoly.QPoly; exists r, s: Q;
      qpoly.isTheIntegerDecomposition(theSubject, q, r, s, nat_succ(n)))
    [by generalize generalize-u]
qed

// -- LEMMA 17.12, THE ASSEMBLY -----------------------------------------------------------
// "Let p(x) ∈ ℚ[x]. Then p(x) = (r/s)(a_0 + a_1 x + … + a_n x^n), where r, s, a_0, …, a_n are
// integers, the a_i's are relatively prime, and r and s are relatively prime."
//
// The subject is `theSubject`, the func this file's specs read coefficients through — a fixed
// but arbitrary p, which is what 17.12 is about. The bound is `nat_succ(n)`: Judson's p has
// DEGREE n and so n+1 coefficients a_0 … a_n, while every `…UpTo(_, m)` predicate here means
// "below m".
//
// THREE HYPOTHESES BEYOND JUDSON'S STATEMENT, each a real demand of the construction:
//
//   `qdegreeAtMost(theSubject, n)` — his p(x) IS of degree n, so it has no coefficients above
//   n to disagree about. The conclusion `p = (r/s)·q` is an UNBOUNDED polynomial equation
//   while the construction only pins coefficients below the bound, and without the degree
//   bound it is not derivable at all (`theBoundedScalingIsTotal` is where it is spent).
//
//   `whole` and its two properties — the common denominator is PASSED IN rather than
//   constructed here. `theCommonDenominatorAndItsNumeratorsExist` (stage A) produces one, so
//   this is not a gap in the mathematics; what it does not produce is a POSITIVE one, and the
//   descent that yields the common divisor well-orders the first quotient, which needs a
//   natural number to descend on. Judson takes the gcd of the cleared numerators instead, and
//   a gcd needs no sign. Having no gcd, the construction pays for it with a sign condition,
//   and the condition is about the CONSTRUCTED `whole` — not about p — so it cannot be
//   discharged from a hypothesis on `theSubject` alone. Closing it means strengthening the
//   denominator spec to pick positive denominators (ℚ's fraction axiom allows it: flip the
//   signs of numerator and denominator together), which re-opens stages A through C.
theorem theIntegerDecompositionExistsForAClearingDenominator: forall n: Nat; forall whole: Q;
  qpoly.qdegreeAtMost(theSubject, n) ->
  isInteger(whole) ->
  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
  isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
  less_than(ZERO, rational.mul(whole, qpoly.qcoeff(theSubject, NAT_ZERO))) ->
  (exists q: qpoly.QPoly; exists r, s: Q;
  qpoly.isTheIntegerDecomposition(theSubject, q, r, s, nat_succ(n)))
proof
  @generalize-n |
    fix n: Nat {
      @generalize-whole |
        fix whole: Q {
          @given-the-setup |
            assume qpoly.qdegreeAtMost(theSubject, n) and
              isInteger(whole) and
              (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
              isInteger(rational.mul(whole,
              qpoly.qcoeff(theSubject, i)))) and
              less_than(ZERO, rational.mul(whole,
              qpoly.qcoeff(theSubject, NAT_ZERO))) {
              @the-setup |
                qpoly.qdegreeAtMost(theSubject, n) and
                  isInteger(whole) and
                  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                  isInteger(rational.mul(whole,
                  qpoly.qcoeff(theSubject, i)))) and
                  less_than(ZERO, rational.mul(whole,
                  qpoly.qcoeff(theSubject, NAT_ZERO)))
                [by hypothesis given-the-setup]
              @the-degree-bound |
                qpoly.qdegreeAtMost(theSubject, n)
                [using tautology the-setup]
              @whole-is-an-integer |
                isInteger(whole)
                [using tautology the-setup]
              @whole-clears-everything |
                forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                  isInteger(rational.mul(whole,
                  qpoly.qcoeff(theSubject, i)))
                [using tautology the-setup]
              @the-cleared-constant-is-positive |
                less_than(ZERO, rational.mul(whole,
                  qpoly.qcoeff(theSubject, NAT_ZERO)))
                [using tautology the-setup]
              // whole != ZERO: otherwise the cleared constant coefficient is
              // ZERO, and ZERO < ZERO is false
              @given-whole-is-zero |
                assume whole = ZERO {
                  @whole-is-zero |
                    whole = ZERO
                    [by hypothesis given-whole-is-zero]
                  @the-cleared-constant-is-zero-times |
                    less_than(ZERO, rational.mul(ZERO,
                      qpoly.qcoeff(theSubject, NAT_ZERO)))
                    [by rewrite whole-is-zero the-cleared-constant-is-positive]
                  @zero-times |
                    rational.mul(ZERO,
                      qpoly.qcoeff(theSubject, NAT_ZERO)) = ZERO
                    [using specialize rational.mulZeroLeft(qpoly.qcoeff(theSubject, NAT_ZERO))]
                  @zero-below-zero |
                    less_than(ZERO, ZERO)
                    [by rewrite zero-times the-cleared-constant-is-zero-times]
                  @zero-is-not-below-zero |
                    not less_than(ZERO, ZERO)
                    [using specialize rational.lessThanIrreflexive(ZERO)]
                }
              @whole-is-not-zero |
                not (whole = ZERO)
                [by contradiction given-whole-is-zero zero-below-zero zero-is-not-below-zero]
              @whole-characterized-here |
                rational.nonzero(whole) iff (not (whole = ZERO))
                [using specialize rational.nonzeroMeaning(whole)]
              @whole-is-nonzero |
                rational.nonzero(whole)
                [using tautology whole-characterized-here whole-is-not-zero]

              // the bound is a successor, so it is positive — stage B needs that
              @zero-below-the-bound |
                nat_less_than(NAT_ZERO, nat_succ(n))
                [using specialize peano_order.zeroIsBelowAnySuccessor(n)]

              // STAGE B: the cleared numerators, with a minimal first quotient
              @the-numerators-exist |
                exists numerators: QSeq; exists least: Q;
                  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                  (isInteger(qat(numerators, i)) and
                  qat(numerators, i) = rational.mul(whole,
                  qpoly.qcoeff(theSubject, i)))) and
                  aFirstQuotientOf(numerators, nat_succ(n), least) and
                  (forall m: Q; isNatural(m) ->
                  aFirstQuotientOf(numerators, nat_succ(n), m) ->
                  (not less_than(m, least)))
                [using specialize theDivisorAndQuotientPolynomialExist(whole, nat_succ(n)) zero-below-the-bound whole-clears-everything the-cleared-constant-is-positive]
              @with-the-numerators |
                unpack u: QSeq from the-numerators-exist {
                  @the-least-exists |
                    exists least: Q;
                      (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                      (isInteger(qat(u, i)) and
                      qat(u, i) = rational.mul(whole,
                      qpoly.qcoeff(theSubject, i)))) and
                      aFirstQuotientOf(u, nat_succ(n), least) and
                      (forall m: Q; isNatural(m) ->
                      aFirstQuotientOf(u, nat_succ(n), m) ->
                      (not less_than(m, least)))
                    [by hypothesis with-the-numerators]
                  @with-the-least |
                    unpack least: Q from the-least-exists {
                      @the-numerator-parts |
                        (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                          (isInteger(qat(u, i)) and
                          qat(u, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i)))) and
                          aFirstQuotientOf(u, nat_succ(n), least) and
                          (forall m: Q; isNatural(m) ->
                          aFirstQuotientOf(u, nat_succ(n), m) ->
                          (not less_than(m, least)))
                        [by hypothesis with-the-least]
                      @the-numerator-meaning |
                        forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                          (isInteger(qat(u, i)) and
                          qat(u, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i)))
                        [using tautology the-numerator-parts]
                      @the-numerators-are-integers |
                        forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                          isInteger(qat(u, i))
                        [using specialize theIntegralityOfTheNumerators(u, whole, nat_succ(n)) the-numerator-meaning]
                      @the-numerator-values |
                        forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                          qat(u, i) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, i))
                        [using specialize theClearedNumeratorValues(u, whole, nat_succ(n)) the-numerator-meaning]
                      @the-first-numerator |
                        qat(u, NAT_ZERO) = rational.mul(whole,
                          qpoly.qcoeff(theSubject, NAT_ZERO))
                        [using specialize the-numerator-values(NAT_ZERO) zero-below-the-bound]
                      @the-first-numerator-is-positive |
                        less_than(ZERO, qat(u, NAT_ZERO))
                        [by rewrite the-first-numerator the-cleared-constant-is-positive]

                      // STAGE C: a common divisor leaving coprime quotients
                      @the-divisor-exists |
                        exists d: Q; exists qseq: QSeq;
                          isInteger(d) and less_than(ZERO, d) and
                          isACommonDivisorUpTo(d, u, nat_succ(n)) and
                          aQuotientSequenceFor(d, u, qseq, nat_succ(n)) and
                          theQuotientsAreCoprime(qseq, nat_succ(n))
                        [using specialize aCoprimeDivisorOfASequenceExists(u, nat_succ(n)) zero-below-the-bound the-numerators-are-integers the-first-numerator-is-positive]
                      @with-the-divisor |
                        unpack d: Q from the-divisor-exists {
                          @the-quotient-sequence-exists |
                            exists qseq: QSeq;
                              isInteger(d) and less_than(ZERO, d) and
                              isACommonDivisorUpTo(d, u, nat_succ(n)) and
                              aQuotientSequenceFor(d, u, qseq,
                              nat_succ(n)) and
                              theQuotientsAreCoprime(qseq, nat_succ(n))
                            [by hypothesis with-the-divisor]
                          @with-the-quotients |
                            unpack qseq: QSeq from the-quotient-sequence-exists {
                              @the-divisor-parts |
                                isInteger(d) and less_than(ZERO, d) and
                                  isACommonDivisorUpTo(d, u,
                                  nat_succ(n)) and
                                  aQuotientSequenceFor(d, u, qseq,
                                  nat_succ(n)) and
                                  theQuotientsAreCoprime(qseq, nat_succ(n))
                                [by hypothesis with-the-quotients]
                              @d-is-an-integer |
                                isInteger(d)
                                [using tautology the-divisor-parts]
                              @d-is-positive |
                                less_than(ZERO, d)
                                [using tautology the-divisor-parts]
                              @d-divides-the-numerators |
                                isACommonDivisorUpTo(d, u, nat_succ(n))
                                [using tautology the-divisor-parts]
                              @the-quotient-relation |
                                aQuotientSequenceFor(d, u, qseq,
                                  nat_succ(n))
                                [using tautology the-divisor-parts]
                              @the-quotients-are-coprime |
                                theQuotientsAreCoprime(qseq, nat_succ(n))
                                [using tautology the-divisor-parts]
                              @the-quotient-entries-are-integers |
                                forall i: Nat;
                                  nat_less_than(i, nat_succ(n)) ->
                                  isInteger(qat(qseq, i))
                                [using specialize everyQuotientEntryIsAnInteger(u, qseq, nat_succ(n), d) d-is-positive d-divides-the-numerators the-quotient-relation]
                              @the-quotient-meaning |
                                aQuotientSequenceFor(d, u, qseq,
                                  nat_succ(n)) iff
                                  (forall i: Nat;
                                  nat_less_than(i, nat_succ(n)) ->
                                  qat(u, i) = rational.mul(d,
                                  qat(qseq, i)))
                                [using specialize quotientSequenceMeaning(d, u, qseq, nat_succ(n))]
                              @the-quotient-values |
                                forall i: Nat;
                                  nat_less_than(i, nat_succ(n)) ->
                                  qat(u, i) = rational.mul(d, qat(qseq, i))
                                [using tautology the-quotient-meaning the-quotient-relation]
                              @conclusion-with-the-divisor |
                                exists q: qpoly.QPoly; exists r, s: Q;
                                  qpoly.isTheIntegerDecomposition(
                                  theSubject, q, r, s, nat_succ(n))
                                [using specialize theDecompositionFromTheDivisor(u, qseq, n, whole, d) the-degree-bound whole-is-an-integer whole-is-nonzero d-is-an-integer d-is-positive the-quotient-entries-are-integers the-quotients-are-coprime the-numerator-values the-quotient-values]
                            }
                          @divisor-exported |
                            exists q: qpoly.QPoly; exists r, s: Q;
                              qpoly.isTheIntegerDecomposition(theSubject,
                              q, r, s, nat_succ(n))
                            [by unpacked with-the-quotients]
                        }
                      @least-exported |
                        exists q: qpoly.QPoly; exists r, s: Q;
                          qpoly.isTheIntegerDecomposition(theSubject, q, r,
                          s, nat_succ(n))
                        [by unpacked with-the-divisor]
                    }
                  @numerators-exported |
                    exists q: qpoly.QPoly; exists r, s: Q;
                      qpoly.isTheIntegerDecomposition(theSubject, q, r, s,
                      nat_succ(n))
                    [by unpacked with-the-least]
                }
              @conclusion-in-the-block |
                exists q: qpoly.QPoly; exists r, s: Q;
                  qpoly.isTheIntegerDecomposition(theSubject, q, r, s,
                  nat_succ(n))
                [by unpacked with-the-numerators]
            }
          @the-implication |
            (qpoly.qdegreeAtMost(theSubject, n) and
              isInteger(whole) and
              (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
              isInteger(rational.mul(whole,
              qpoly.qcoeff(theSubject, i)))) and
              less_than(ZERO, rational.mul(whole,
              qpoly.qcoeff(theSubject, NAT_ZERO)))) ->
              (exists q: qpoly.QPoly; exists r, s: Q;
              qpoly.isTheIntegerDecomposition(theSubject, q, r, s,
              nat_succ(n)))
            [by discharge given-the-setup]
          @curried |
            qpoly.qdegreeAtMost(theSubject, n) ->
              isInteger(whole) ->
              (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
              isInteger(rational.mul(whole,
              qpoly.qcoeff(theSubject, i)))) ->
              less_than(ZERO, rational.mul(whole,
              qpoly.qcoeff(theSubject, NAT_ZERO))) ->
              (exists q: qpoly.QPoly; exists r, s: Q;
              qpoly.isTheIntegerDecomposition(theSubject, q, r, s,
              nat_succ(n)))
            [using tautology the-implication]
        }
      @discharge-whole |
        forall whole9: Q;
          qpoly.qdegreeAtMost(theSubject, n) ->
          isInteger(whole9) ->
          (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
          isInteger(rational.mul(whole9, qpoly.qcoeff(theSubject, i)))) ->
          less_than(ZERO, rational.mul(whole9,
          qpoly.qcoeff(theSubject, NAT_ZERO))) ->
          (exists q: qpoly.QPoly; exists r, s: Q;
          qpoly.isTheIntegerDecomposition(theSubject, q, r, s, nat_succ(n)))
        [by generalize generalize-whole]
    }
  @conclusion |
    forall n: Nat; forall whole: Q;
      qpoly.qdegreeAtMost(theSubject, n) ->
      isInteger(whole) ->
      (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
      isInteger(rational.mul(whole, qpoly.qcoeff(theSubject, i)))) ->
      less_than(ZERO, rational.mul(whole,
      qpoly.qcoeff(theSubject, NAT_ZERO))) ->
      (exists q: qpoly.QPoly; exists r, s: Q;
      qpoly.isTheIntegerDecomposition(theSubject, q, r, s, nat_succ(n)))
    [by generalize generalize-n]
qed

// -- LEMMA 17.12, UNCONDITIONAL ON THE DENOMINATOR -----------------------------------------
// Stage A now delivers a POSITIVE common denominator (the spec picks positive denominators,
// and a product of positives is positive), so the sign condition the descent needs no longer
// has to be assumed about a constructed quantity: it follows from `coeff_0 > 0`.
//
// What remains as a hypothesis is the degree bound — faithful to Judson, whose p(x) IS of
// degree n — and the positivity of p's own constant coefficient, which the descent needs
// because it well-orders the first quotient and a natural number is what it descends on.
// Judson takes the gcd of the cleared numerators instead, and a gcd needs no sign.
theorem theIntegerDecompositionExists: forall n: Nat;
  qpoly.qdegreeAtMost(theSubject, n) ->
  less_than(ZERO, qpoly.qcoeff(theSubject, NAT_ZERO)) ->
  (exists q: qpoly.QPoly; exists r, s: Q;
  qpoly.isTheIntegerDecomposition(theSubject, q, r, s, nat_succ(n)))
proof
  @generalize-n |
    fix n: Nat {
      @given-the-degree-bound |
        assume qpoly.qdegreeAtMost(theSubject, n) {
          @the-degree-bound |
            qpoly.qdegreeAtMost(theSubject, n)
            [by hypothesis given-the-degree-bound]
          @given-the-constant-is-positive |
            assume less_than(ZERO,
              qpoly.qcoeff(theSubject, NAT_ZERO)) {
              @the-constant-is-positive |
                less_than(ZERO, qpoly.qcoeff(theSubject, NAT_ZERO))
                [by hypothesis given-the-constant-is-positive]
              // STAGE A: the common denominator, now positive
              @the-denominator-exists |
                exists denominators: QSeq;
                  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                  isADenominatorFor(i, qat(denominators, i))) and
                  isInteger(qProductUpTo(denominators, nat_succ(n))) and
                  (not (qProductUpTo(denominators,
                  nat_succ(n)) = ZERO)) and
                  less_than(ZERO, qProductUpTo(denominators,
                  nat_succ(n))) and
                  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                  dividesIntegrally(qat(denominators, i),
                  qProductUpTo(denominators, nat_succ(n)))) and
                  (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                  isInteger(rational.mul(qProductUpTo(denominators,
                  nat_succ(n)), qpoly.qcoeff(theSubject, i))))
                [using specialize theCommonDenominatorAndItsNumeratorsExist(nat_succ(n))]
              @with-the-denominators |
                unpack denominators: QSeq from the-denominator-exists {
                  @the-denominator-parts |
                    (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                      isADenominatorFor(i, qat(denominators, i))) and
                      isInteger(qProductUpTo(denominators,
                      nat_succ(n))) and
                      (not (qProductUpTo(denominators,
                      nat_succ(n)) = ZERO)) and
                      less_than(ZERO, qProductUpTo(denominators,
                      nat_succ(n))) and
                      (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                      dividesIntegrally(qat(denominators, i),
                      qProductUpTo(denominators, nat_succ(n)))) and
                      (forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                      isInteger(rational.mul(qProductUpTo(denominators,
                      nat_succ(n)), qpoly.qcoeff(theSubject, i))))
                    [by hypothesis with-the-denominators]
                  @the-whole-is-an-integer |
                    isInteger(qProductUpTo(denominators, nat_succ(n)))
                    [using tautology the-denominator-parts]
                  @the-whole-is-positive |
                    less_than(ZERO, qProductUpTo(denominators,
                      nat_succ(n)))
                    [using tautology the-denominator-parts]
                  @the-whole-clears-everything |
                    forall i: Nat; nat_less_than(i, nat_succ(n)) ->
                      isInteger(rational.mul(qProductUpTo(denominators,
                      nat_succ(n)), qpoly.qcoeff(theSubject, i)))
                    [using tautology the-denominator-parts]
                  // the cleared constant coefficient is a product of positives
                  @the-cleared-constant-is-positive |
                    less_than(ZERO,
                      rational.mul(qProductUpTo(denominators,
                      nat_succ(n)),
                      qpoly.qcoeff(theSubject, NAT_ZERO)))
                    [using specialize rational.positiveProduct(qProductUpTo(denominators, nat_succ(n)), qpoly.qcoeff(theSubject, NAT_ZERO)) the-whole-is-positive the-constant-is-positive]
                  @conclusion-with-the-denominators |
                    exists q: qpoly.QPoly; exists r, s: Q;
                      qpoly.isTheIntegerDecomposition(theSubject, q, r, s,
                      nat_succ(n))
                    [using specialize theIntegerDecompositionExistsForAClearingDenominator(n, qProductUpTo(denominators, nat_succ(n))) the-degree-bound the-whole-is-an-integer the-whole-clears-everything the-cleared-constant-is-positive]
                }
              @the-decomposition-exists |
                exists q: qpoly.QPoly; exists r, s: Q;
                  qpoly.isTheIntegerDecomposition(theSubject, q, r, s,
                  nat_succ(n))
                [by unpacked with-the-denominators]
            }
          @constant-positive-implies |
            less_than(ZERO, qpoly.qcoeff(theSubject, NAT_ZERO)) ->
              (exists q: qpoly.QPoly; exists r, s: Q;
              qpoly.isTheIntegerDecomposition(theSubject, q, r, s,
              nat_succ(n)))
            [by discharge given-the-constant-is-positive]
        }
      @the-implication |
        qpoly.qdegreeAtMost(theSubject, n) ->
          (less_than(ZERO, qpoly.qcoeff(theSubject, NAT_ZERO)) ->
          (exists q: qpoly.QPoly; exists r, s: Q;
          qpoly.isTheIntegerDecomposition(theSubject, q, r, s,
          nat_succ(n))))
        [by discharge given-the-degree-bound]
    }
  @conclusion |
    forall n: Nat;
      qpoly.qdegreeAtMost(theSubject, n) ->
      less_than(ZERO, qpoly.qcoeff(theSubject, NAT_ZERO)) ->
      (exists q: qpoly.QPoly; exists r, s: Q;
      qpoly.isTheIntegerDecomposition(theSubject, q, r, s, nat_succ(n)))
    [by generalize generalize-n]
qed

// -- A SUM OF MULTIPLES IS A MULTIPLE ------------------------------------------------------
// `dividesAdd` on the cut: d | a and d | b give d | a + b, by distributing over the two
// quotients. Needed by Euclid's Lemma below, which splits w into two u-multiples.
theorem theSumOfMultiplesIsAMultiple: forall d, a, b: Q;
  dividesIntegrally(d, a) -> dividesIntegrally(d, b) ->
  dividesIntegrally(d, rational.add(a, b))
proof
  @generalize-d |
    fix d: Q {
      @generalize-a |
        fix a: Q {
          @generalize-b |
            fix b: Q {
              @given-both |
                assume dividesIntegrally(d, a) and
                  dividesIntegrally(d, b) {
                  @both |
                    dividesIntegrally(d, a) and
                      dividesIntegrally(d, b)
                    [by hypothesis given-both]
                  @d-divides-a |
                    dividesIntegrally(d, a)
                    [by and_lhs both]
                  @d-divides-b |
                    dividesIntegrally(d, b)
                    [by and_rhs both]
                  @the-a-meaning |
                    dividesIntegrally(d, a) iff
                      (exists k: Q; isInteger(k) and
                      a = rational.mul(d, k))
                    [using specialize dividesIntegrallyMeaning(d, a)]
                  @an-a-quotient-exists |
                    exists k: Q; isInteger(k) and
                      a = rational.mul(d, k)
                    [using tautology the-a-meaning d-divides-a]
                  @the-b-meaning |
                    dividesIntegrally(d, b) iff
                      (exists k: Q; isInteger(k) and
                      b = rational.mul(d, k))
                    [using specialize dividesIntegrallyMeaning(d, b)]
                  @a-b-quotient-exists |
                    exists k: Q; isInteger(k) and
                      b = rational.mul(d, k)
                    [using tautology the-b-meaning d-divides-b]
                  @the-sum-divides |
                    unpack ka: Q from an-a-quotient-exists {
                      @the-a-quotient |
                        isInteger(ka) and a = rational.mul(d, ka)
                        [by hypothesis the-sum-divides]
                      @ka-is-an-integer |
                        isInteger(ka)
                        [by and_lhs the-a-quotient]
                      @a-factors |
                        a = rational.mul(d, ka)
                        [by and_rhs the-a-quotient]
                      @the-sum-divides-inner |
                        unpack kb: Q from a-b-quotient-exists {
                          @the-b-quotient |
                            isInteger(kb) and b = rational.mul(d, kb)
                            [by hypothesis the-sum-divides-inner]
                          @kb-is-an-integer |
                            isInteger(kb)
                            [by and_lhs the-b-quotient]
                          @b-factors |
                            b = rational.mul(d, kb)
                            [by and_rhs the-b-quotient]
                          @the-quotient-sum-is-an-integer |
                            isInteger(rational.add(ka, kb))
                            [using specialize rational.isIntegerAdd(ka, kb) ka-is-an-integer kb-is-an-integer]
                          @the-sum-at-a |
                            rational.add(a, b) =
                              rational.add(rational.mul(d, ka), b)
                            [by rewrite a-factors]
                          @the-sum-factored |
                            rational.add(a, b) =
                              rational.add(rational.mul(d, ka),
                              rational.mul(d, kb))
                            [by rewrite b-factors the-sum-at-a]
                          @the-distribution |
                            rational.add(rational.mul(d, ka),
                              rational.mul(d, kb)) =
                              rational.mul(d,
                              rational.add(ka, kb))
                            [using polynomial(rational)]
                          @the-sum-is-a-multiple |
                            rational.add(a, b) =
                              rational.mul(d, rational.add(ka, kb))
                            [by rewrite the-distribution the-sum-factored]
                          @the-sum-quotient-works |
                            isInteger(rational.add(ka, kb)) and
                              rational.add(a, b) =
                              rational.mul(d, rational.add(ka, kb))
                            [by both the-quotient-sum-is-an-integer the-sum-is-a-multiple]
                          @a-sum-quotient-exists |
                            exists k: Q; isInteger(k) and
                              rational.add(a, b) = rational.mul(d, k)
                            [by witness(rational.add(ka, kb)) the-sum-quotient-works]
                          @the-sum-meaning |
                            dividesIntegrally(d, rational.add(a, b)) iff
                              (exists k: Q; isInteger(k) and
                              rational.add(a, b) = rational.mul(d, k))
                            [using specialize dividesIntegrallyMeaning(d, rational.add(a, b))]
                          @conclusion-the-sum-divides |
                            dividesIntegrally(d, rational.add(a, b))
                            [using tautology the-sum-meaning a-sum-quotient-exists]
                        }
                      @the-inner-exported |
                        dividesIntegrally(d, rational.add(a, b))
                        [by unpacked the-sum-divides-inner]
                    }
                  @conclusion-sum |
                    dividesIntegrally(d, rational.add(a, b))
                    [by unpacked the-sum-divides]
                }
              @the-implication |
                (dividesIntegrally(d, a) and
                  dividesIntegrally(d, b)) ->
                  dividesIntegrally(d, rational.add(a, b))
                [by discharge given-both]
              @curried |
                dividesIntegrally(d, a) ->
                  dividesIntegrally(d, b) ->
                  dividesIntegrally(d, rational.add(a, b))
                [using tautology the-implication]
            }
          @discharge-b |
            forall b9: Q;
              dividesIntegrally(d, a) -> dividesIntegrally(d, b9) ->
              dividesIntegrally(d, rational.add(a, b9))
            [by generalize generalize-b]
        }
      @discharge-a |
        forall a9, b9: Q;
          dividesIntegrally(d, a9) -> dividesIntegrally(d, b9) ->
          dividesIntegrally(d, rational.add(a9, b9))
        [by generalize generalize-a]
    }
  @conclusion |
    forall d, a, b: Q;
      dividesIntegrally(d, a) -> dividesIntegrally(d, b) ->
      dividesIntegrally(d, rational.add(a, b))
    [by generalize generalize-d]
qed

// -- EUCLID'S LEMMA ON THE CUT -------------------------------------------------------------
// Corollary 17.14 and Theorem 17.15 each need exactly this: from `u | v·w` and a Bézout
// certificate for (u, v), conclude `u | w`.
//
// PROVED NATIVELY rather than transferred. ℤ has `euclidFromBezout` on 15 axioms that
// `IntegersInRational` all maps — but its proof uses bare `[using polynomial]`, whose
// hardcoded rule set cites ring lemmas by well-known name with SOURCE-SPACE formulas, so
// under a transfer the cite's claim is guard-free while the resolved theorem is relativized:
//   step claims 'forall b1,b2,b3; mul(b1, add(b2, b3)) = …'
//   but the theorem derives 'forall a; isInteger(a) -> … '
// ℚ has all this ring algebra natively, so `polynomial(rational)` resolves locally and the
// three rearrangements cost nothing. The proof is Judson's standard one either way.
//
// The Bézout CERTIFICATE is a hypothesis, not a construction — which is the whole point: it
// keeps this off `gcd`/`div`/`mod`, none of which the cut has.
theorem euclidFromBezoutOnTheCut: forall u, v, w, r, s: Q;
  isInteger(u) -> isInteger(v) -> isInteger(w) ->
  isInteger(r) -> isInteger(s) ->
  rational.add(rational.mul(u, r), rational.mul(v, s)) = ONE ->
  dividesIntegrally(u, rational.mul(v, w)) ->
  dividesIntegrally(u, w)
proof
  @generalize-u |
    fix u: Q {
      @generalize-v |
        fix v: Q {
          @generalize-w |
            fix w: Q {
              @generalize-r |
                fix r: Q {
                  @generalize-s |
                    fix s: Q {
                      @given-the-setup |
                        assume isInteger(u) and isInteger(v) and
                          isInteger(w) and isInteger(r) and
                          isInteger(s) and
                          rational.add(rational.mul(u, r),
                          rational.mul(v, s)) = ONE and
                          dividesIntegrally(u, rational.mul(v, w)) {
                          @the-setup |
                            isInteger(u) and isInteger(v) and
                              isInteger(w) and isInteger(r) and
                              isInteger(s) and
                              rational.add(rational.mul(u, r),
                              rational.mul(v, s)) = ONE and
                              dividesIntegrally(u, rational.mul(v, w))
                            [by hypothesis given-the-setup]
                          @w-is-an-integer |
                            isInteger(w)
                            [using tautology the-setup]
                          @r-is-an-integer |
                            isInteger(r)
                            [using tautology the-setup]
                          @s-is-an-integer |
                            isInteger(s)
                            [using tautology the-setup]
                          @bezout |
                            rational.add(rational.mul(u, r),
                              rational.mul(v, s)) = ONE
                            [using tautology the-setup]
                          @u-divides-vw |
                            dividesIntegrally(u, rational.mul(v, w))
                            [using tautology the-setup]
                          // w = w·1 = w·(ur + vs) = w·u·r + w·v·s
                          @one-is-bezout |
                            ONE = rational.add(rational.mul(u, r),
                              rational.mul(v, s))
                            [by symmetry bezout]
                          @w-is-mul-one |
                            w = rational.mul(w, ONE)
                            [using polynomial(rational)]
                          @w-times-bezout |
                            w = rational.mul(w,
                              rational.add(rational.mul(u, r),
                              rational.mul(v, s)))
                            [by rewrite one-is-bezout w-is-mul-one]
                          @w-distributes |
                            rational.mul(w,
                              rational.add(rational.mul(u, r),
                              rational.mul(v, s))) =
                              rational.add(rational.mul(u,
                              rational.mul(w, r)),
                              rational.mul(rational.mul(v, w), s))
                            [using polynomial(rational)]
                          @w-expands |
                            w = rational.add(rational.mul(u,
                              rational.mul(w, r)),
                              rational.mul(rational.mul(v, w), s))
                            [by rewrite w-distributes w-times-bezout]
                          // u divides the first summand: it IS u · (w·r)
                          @wr-is-an-integer |
                            isInteger(rational.mul(w, r))
                            [using specialize rational.isIntegerMul(w, r) w-is-an-integer r-is-an-integer]
                          @the-first-divides-meaning |
                            dividesIntegrally(u, rational.mul(u,
                              rational.mul(w, r))) iff
                              (exists k: Q; isInteger(k) and
                              rational.mul(u, rational.mul(w, r)) =
                              rational.mul(u, k))
                            [using specialize dividesIntegrallyMeaning(u, rational.mul(u, rational.mul(w, r)))]
                          @the-first-is-itself |
                            rational.mul(u, rational.mul(w, r)) =
                              rational.mul(u, rational.mul(w, r))
                            [by reflexivity]
                          @the-first-quotient-works |
                            isInteger(rational.mul(w, r)) and
                              rational.mul(u, rational.mul(w, r)) =
                              rational.mul(u, rational.mul(w, r))
                            [by both wr-is-an-integer the-first-is-itself]
                          @a-first-quotient-exists |
                            exists k: Q; isInteger(k) and
                              rational.mul(u, rational.mul(w, r)) =
                              rational.mul(u, k)
                            [by witness(rational.mul(w, r)) the-first-quotient-works]
                          @u-divides-first |
                            dividesIntegrally(u, rational.mul(u,
                              rational.mul(w, r)))
                            [using tautology the-first-divides-meaning a-first-quotient-exists]
                          // u divides the second summand: u | v·w, so u | (v·w)·s
                          @the-vw-divides-meaning |
                            dividesIntegrally(u, rational.mul(v, w)) iff
                              (exists k: Q; isInteger(k) and
                              rational.mul(v, w) = rational.mul(u, k))
                            [using specialize dividesIntegrallyMeaning(u, rational.mul(v, w))]
                          @a-vw-quotient-exists |
                            exists k: Q; isInteger(k) and
                              rational.mul(v, w) = rational.mul(u, k)
                            [using tautology the-vw-divides-meaning u-divides-vw]
                          @u-divides-second-unpacked |
                            unpack k: Q from a-vw-quotient-exists {
                              @the-vw-quotient |
                                isInteger(k) and
                                  rational.mul(v, w) =
                                  rational.mul(u, k)
                                [by hypothesis u-divides-second-unpacked]
                              @k-is-an-integer |
                                isInteger(k)
                                [by and_lhs the-vw-quotient]
                              @vw-factors |
                                rational.mul(v, w) = rational.mul(u, k)
                                [by and_rhs the-vw-quotient]
                              @ks-is-an-integer |
                                isInteger(rational.mul(k, s))
                                [using specialize rational.isIntegerMul(k, s) k-is-an-integer s-is-an-integer]
                              @the-second-regrouped |
                                rational.mul(rational.mul(u, k), s) =
                                  rational.mul(u, rational.mul(k, s))
                                [using polynomial(rational)]
                              @the-second-factors |
                                rational.mul(rational.mul(v, w), s) =
                                  rational.mul(u, rational.mul(k, s))
                                [by rewrite vw-factors the-second-regrouped]
                              @the-second-quotient-works |
                                isInteger(rational.mul(k, s)) and
                                  rational.mul(rational.mul(v, w), s) =
                                  rational.mul(u, rational.mul(k, s))
                                [by both ks-is-an-integer the-second-factors]
                              @a-second-quotient-exists |
                                exists k2: Q; isInteger(k2) and
                                  rational.mul(rational.mul(v, w), s) =
                                  rational.mul(u, k2)
                                [by witness(rational.mul(k, s)) the-second-quotient-works]
                              @the-second-divides-meaning |
                                dividesIntegrally(u,
                                  rational.mul(rational.mul(v, w), s)) iff
                                  (exists k2: Q; isInteger(k2) and
                                  rational.mul(rational.mul(v, w), s) =
                                  rational.mul(u, k2))
                                [using specialize dividesIntegrallyMeaning(u, rational.mul(rational.mul(v, w), s))]
                              @conclusion-u-divides-second |
                                dividesIntegrally(u,
                                  rational.mul(rational.mul(v, w), s))
                                [using tautology the-second-divides-meaning a-second-quotient-exists]
                            }
                          @u-divides-second |
                            dividesIntegrally(u,
                              rational.mul(rational.mul(v, w), s))
                            [by unpacked u-divides-second-unpacked]
                          // u divides the sum, which IS w
                          @u-divides-sum |
                            dividesIntegrally(u,
                              rational.add(rational.mul(u,
                              rational.mul(w, r)),
                              rational.mul(rational.mul(v, w), s)))
                            [using specialize theSumOfMultiplesIsAMultiple(u, rational.mul(u, rational.mul(w, r)), rational.mul(rational.mul(v, w), s)) u-divides-first u-divides-second]
                          @conclusion-u-divides-w |
                            dividesIntegrally(u, w)
                            [by rewrite w-expands u-divides-sum]
                        }
                      @the-implication |
                        (isInteger(u) and isInteger(v) and
                          isInteger(w) and isInteger(r) and
                          isInteger(s) and
                          rational.add(rational.mul(u, r),
                          rational.mul(v, s)) = ONE and
                          dividesIntegrally(u, rational.mul(v, w))) ->
                          dividesIntegrally(u, w)
                        [by discharge given-the-setup]
                      @curried |
                        isInteger(u) -> isInteger(v) -> isInteger(w) ->
                          isInteger(r) -> isInteger(s) ->
                          rational.add(rational.mul(u, r),
                          rational.mul(v, s)) = ONE ->
                          dividesIntegrally(u, rational.mul(v, w)) ->
                          dividesIntegrally(u, w)
                        [using tautology the-implication]
                    }
                  @discharge-s |
                    forall s9: Q;
                      isInteger(u) -> isInteger(v) -> isInteger(w) ->
                      isInteger(r) -> isInteger(s9) ->
                      rational.add(rational.mul(u, r),
                      rational.mul(v, s9)) = ONE ->
                      dividesIntegrally(u, rational.mul(v, w)) ->
                      dividesIntegrally(u, w)
                    [by generalize generalize-s]
                }
              @discharge-r |
                forall r9, s9: Q;
                  isInteger(u) -> isInteger(v) -> isInteger(w) ->
                  isInteger(r9) -> isInteger(s9) ->
                  rational.add(rational.mul(u, r9),
                  rational.mul(v, s9)) = ONE ->
                  dividesIntegrally(u, rational.mul(v, w)) ->
                  dividesIntegrally(u, w)
                [by generalize generalize-r]
            }
          @discharge-w |
            forall w9: Q; forall r9, s9: Q;
              isInteger(u) -> isInteger(v) -> isInteger(w9) ->
              isInteger(r9) -> isInteger(s9) ->
              rational.add(rational.mul(u, r9),
              rational.mul(v, s9)) = ONE ->
              dividesIntegrally(u, rational.mul(v, w9)) ->
              dividesIntegrally(u, w9)
            [by generalize generalize-w]
        }
      @discharge-v |
        forall v9, w9: Q; forall r9, s9: Q;
          isInteger(u) -> isInteger(v9) -> isInteger(w9) ->
          isInteger(r9) -> isInteger(s9) ->
          rational.add(rational.mul(u, r9),
          rational.mul(v9, s9)) = ONE ->
          dividesIntegrally(u, rational.mul(v9, w9)) ->
          dividesIntegrally(u, w9)
        [by generalize generalize-v]
    }
  @conclusion |
    forall u, v, w, r, s: Q;
      isInteger(u) -> isInteger(v) -> isInteger(w) ->
      isInteger(r) -> isInteger(s) ->
      rational.add(rational.mul(u, r), rational.mul(v, s)) = ONE ->
      dividesIntegrally(u, rational.mul(v, w)) ->
      dividesIntegrally(u, w)
    [by generalize generalize-u]
qed

// -- COPRIME TO A POWER --------------------------------------------------------------------
// Corollary 17.14 reads `r | a_0·s^(n+1)` and needs `r | a_0`. Euclid strips ONE factor of s,
// so stripping s^(n+1) is an induction on the exponent, re-using the SAME Bézout certificate
// at every step — which is why the certificate travels as a parameter rather than being
// reconstructed per step.
//
// The induction target quantifies over the cofactor INSIDE, so the step can apply the
// hypothesis at a different cofactor (`v·w` rather than `w`). That shape is the whole trick:
// at `v^(k+1)·w = v^k·(v·w)` the hypothesis fires at `v·w`, and Euclid then strips the last v.

// base: v^0 = ONE, so `u | 1·w` is `u | w`.
theorem theZeroPowerStrips: forall u, v: Q;
  (forall w: Q; isInteger(w) ->
  dividesIntegrally(u, rational.mul(qpoly.qpower(v, NAT_ZERO), w)) ->
  dividesIntegrally(u, w))
proof
  @generalize-u |
    fix u: Q {
      @generalize-v |
        fix v: Q {
          @each-cofactor |
            fix w: Q {
              @given-the-divisibility |
                assume isInteger(w) and
                  dividesIntegrally(u,
                  rational.mul(qpoly.qpower(v, NAT_ZERO), w)) {
                  @the-setup |
                    isInteger(w) and
                      dividesIntegrally(u,
                      rational.mul(qpoly.qpower(v, NAT_ZERO), w))
                    [by hypothesis given-the-divisibility]
                  @u-divides-the-scaled |
                    dividesIntegrally(u,
                      rational.mul(qpoly.qpower(v, NAT_ZERO), w))
                    [by and_rhs the-setup]
                  @the-zero-power |
                    qpoly.qpower(v, NAT_ZERO) = ONE
                    [using specialize qpoly.qPowerZero(v)]
                  @the-scaled-is-w |
                    rational.mul(ONE, w) = w
                    [using specialize rational.mulOneLeft(w)]
                  @u-divides-one-times-w |
                    dividesIntegrally(u, rational.mul(ONE, w))
                    [by rewrite the-zero-power u-divides-the-scaled]
                  @conclusion-u-divides-w |
                    dividesIntegrally(u, w)
                    [by rewrite the-scaled-is-w u-divides-one-times-w]
                }
              @the-implication |
                (isInteger(w) and
                  dividesIntegrally(u,
                  rational.mul(qpoly.qpower(v, NAT_ZERO), w))) ->
                  dividesIntegrally(u, w)
                [by discharge given-the-divisibility]
              @curried |
                isInteger(w) ->
                  dividesIntegrally(u,
                  rational.mul(qpoly.qpower(v, NAT_ZERO), w)) ->
                  dividesIntegrally(u, w)
                [using tautology the-implication]
            }
          @conclusion-all-cofactors |
            forall w: Q; isInteger(w) ->
              dividesIntegrally(u,
              rational.mul(qpoly.qpower(v, NAT_ZERO), w)) ->
              dividesIntegrally(u, w)
            [by generalize each-cofactor]
        }
      @discharge-v |
        forall v9: Q;
          (forall w: Q; isInteger(w) ->
          dividesIntegrally(u,
          rational.mul(qpoly.qpower(v9, NAT_ZERO), w)) ->
          dividesIntegrally(u, w))
        [by generalize generalize-v]
    }
  @conclusion |
    forall u, v: Q;
      (forall w: Q; isInteger(w) ->
      dividesIntegrally(u,
      rational.mul(qpoly.qpower(v, NAT_ZERO), w)) ->
      dividesIntegrally(u, w))
    [by generalize generalize-u]
qed

// step: v^(k+1)·w = v^k·(v·w), so the hypothesis (at the cofactor v·w) gives `u | v·w`, and
// Euclid strips the last v.
theorem theSuccessorPowerStrips: forall u, v, r, s: Q; forall k: Nat;
  isInteger(u) -> isInteger(v) -> isInteger(r) -> isInteger(s) ->
  rational.add(rational.mul(u, r), rational.mul(v, s)) = ONE ->
  (forall w: Q; isInteger(w) ->
  dividesIntegrally(u, rational.mul(qpoly.qpower(v, k), w)) ->
  dividesIntegrally(u, w)) ->
  (forall w: Q; isInteger(w) ->
  dividesIntegrally(u, rational.mul(qpoly.qpower(v, nat_succ(k)), w)) ->
  dividesIntegrally(u, w))
proof
  @generalize-u |
    fix u: Q {
      @generalize-v |
        fix v: Q {
          @generalize-r |
            fix r: Q {
              @generalize-s |
                fix s: Q {
                  @generalize-k |
                    fix k: Nat {
                      @given-the-setup |
                        assume isInteger(u) and isInteger(v) and
                          isInteger(r) and isInteger(s) and
                          rational.add(rational.mul(u, r),
                          rational.mul(v, s)) = ONE and
                          (forall w: Q; isInteger(w) ->
                          dividesIntegrally(u,
                          rational.mul(qpoly.qpower(v, k), w)) ->
                          dividesIntegrally(u, w)) {
                          @the-setup |
                            isInteger(u) and isInteger(v) and
                              isInteger(r) and isInteger(s) and
                              rational.add(rational.mul(u, r),
                              rational.mul(v, s)) = ONE and
                              (forall w: Q; isInteger(w) ->
                              dividesIntegrally(u,
                              rational.mul(qpoly.qpower(v, k),
                              w)) ->
                              dividesIntegrally(u, w))
                            [by hypothesis given-the-setup]
                          @u-is-an-integer |
                            isInteger(u)
                            [using tautology the-setup]
                          @v-is-an-integer |
                            isInteger(v)
                            [using tautology the-setup]
                          @r-is-an-integer |
                            isInteger(r)
                            [using tautology the-setup]
                          @s-is-an-integer |
                            isInteger(s)
                            [using tautology the-setup]
                          @the-certificate |
                            rational.add(rational.mul(u, r),
                              rational.mul(v, s)) = ONE
                            [using tautology the-setup]
                          @the-hypothesis |
                            forall w: Q; isInteger(w) ->
                              dividesIntegrally(u,
                              rational.mul(qpoly.qpower(v, k), w)) ->
                              dividesIntegrally(u, w)
                            [using tautology the-setup]
                          @each-cofactor |
                            fix w: Q {
                              @given-the-divisibility |
                                assume isInteger(w) and
                                  dividesIntegrally(u,
                                  rational.mul(qpoly.qpower(v,
                                  nat_succ(k)), w)) {
                                  @the-inner-setup |
                                    isInteger(w) and
                                      dividesIntegrally(u,
                                      rational.mul(
                                      qpoly.qpower(v,
                                      nat_succ(k)), w))
                                    [by hypothesis given-the-divisibility]
                                  @w-is-an-integer |
                                    isInteger(w)
                                    [by and_lhs the-inner-setup]
                                  @u-divides-the-scaled |
                                    dividesIntegrally(u,
                                      rational.mul(
                                      qpoly.qpower(v,
                                      nat_succ(k)), w))
                                    [by and_rhs the-inner-setup]
                                  // v^(k+1)·w = v^k·(v·w)
                                  @the-next-power |
                                    qpoly.qpower(v, nat_succ(k)) =
                                      rational.mul(v,
                                      qpoly.qpower(v, k))
                                    [using specialize qpoly.qPowerSucc(v, k)]
                                  @the-regrouping |
                                    rational.mul(rational.mul(v,
                                      qpoly.qpower(v, k)), w) =
                                      rational.mul(
                                      qpoly.qpower(v, k),
                                      rational.mul(v, w))
                                    [using polynomial(rational)]
                                  @u-divides-the-expanded |
                                    dividesIntegrally(u,
                                      rational.mul(
                                      rational.mul(v,
                                      qpoly.qpower(v, k)), w))
                                    [by rewrite the-next-power u-divides-the-scaled]
                                  @u-divides-the-regrouped |
                                    dividesIntegrally(u,
                                      rational.mul(
                                      qpoly.qpower(v, k),
                                      rational.mul(v, w)))
                                    [by rewrite the-regrouping u-divides-the-expanded]
                                  // the hypothesis at the cofactor v·w
                                  @vw-is-an-integer |
                                    isInteger(rational.mul(v, w))
                                    [using specialize rational.isIntegerMul(v, w) v-is-an-integer w-is-an-integer]
                                  @u-divides-vw |
                                    dividesIntegrally(u,
                                      rational.mul(v, w))
                                    [using specialize the-hypothesis(rational.mul(v, w)) vw-is-an-integer u-divides-the-regrouped]
                                  // Euclid strips the last v
                                  @conclusion-u-divides-w |
                                    dividesIntegrally(u, w)
                                    [using specialize euclidFromBezoutOnTheCut(u, v, w, r, s) u-is-an-integer v-is-an-integer w-is-an-integer r-is-an-integer s-is-an-integer the-certificate u-divides-vw]
                                }
                              @the-inner-implication |
                                (isInteger(w) and
                                  dividesIntegrally(u,
                                  rational.mul(qpoly.qpower(v,
                                  nat_succ(k)), w))) ->
                                  dividesIntegrally(u, w)
                                [by discharge given-the-divisibility]
                              @curried-at-w |
                                isInteger(w) ->
                                  dividesIntegrally(u,
                                  rational.mul(qpoly.qpower(v,
                                  nat_succ(k)), w)) ->
                                  dividesIntegrally(u, w)
                                [using tautology the-inner-implication]
                            }
                          @conclusion-all-cofactors |
                            forall w: Q; isInteger(w) ->
                              dividesIntegrally(u,
                              rational.mul(qpoly.qpower(v,
                              nat_succ(k)), w)) ->
                              dividesIntegrally(u, w)
                            [by generalize each-cofactor]
                        }
                      @the-implication |
                        (isInteger(u) and isInteger(v) and
                          isInteger(r) and isInteger(s) and
                          rational.add(rational.mul(u, r),
                          rational.mul(v, s)) = ONE and
                          (forall w: Q; isInteger(w) ->
                          dividesIntegrally(u,
                          rational.mul(qpoly.qpower(v, k), w)) ->
                          dividesIntegrally(u, w))) ->
                          (forall w: Q; isInteger(w) ->
                          dividesIntegrally(u,
                          rational.mul(qpoly.qpower(v,
                          nat_succ(k)), w)) ->
                          dividesIntegrally(u, w))
                        [by discharge given-the-setup]
                      @curried |
                        isInteger(u) -> isInteger(v) ->
                          isInteger(r) -> isInteger(s) ->
                          rational.add(rational.mul(u, r),
                          rational.mul(v, s)) = ONE ->
                          (forall w: Q; isInteger(w) ->
                          dividesIntegrally(u,
                          rational.mul(qpoly.qpower(v, k), w)) ->
                          dividesIntegrally(u, w)) ->
                          (forall w: Q; isInteger(w) ->
                          dividesIntegrally(u,
                          rational.mul(qpoly.qpower(v,
                          nat_succ(k)), w)) ->
                          dividesIntegrally(u, w))
                        [using tautology the-implication]
                    }
                  @discharge-k |
                    forall k9: Nat;
                      isInteger(u) -> isInteger(v) ->
                      isInteger(r) -> isInteger(s) ->
                      rational.add(rational.mul(u, r),
                      rational.mul(v, s)) = ONE ->
                      (forall w: Q; isInteger(w) ->
                      dividesIntegrally(u,
                      rational.mul(qpoly.qpower(v, k9), w)) ->
                      dividesIntegrally(u, w)) ->
                      (forall w: Q; isInteger(w) ->
                      dividesIntegrally(u,
                      rational.mul(qpoly.qpower(v,
                      nat_succ(k9)), w)) ->
                      dividesIntegrally(u, w))
                    [by generalize generalize-k]
                }
              @discharge-s |
                forall s9: Q; forall k9: Nat;
                  isInteger(u) -> isInteger(v) ->
                  isInteger(r) -> isInteger(s9) ->
                  rational.add(rational.mul(u, r),
                  rational.mul(v, s9)) = ONE ->
                  (forall w: Q; isInteger(w) ->
                  dividesIntegrally(u,
                  rational.mul(qpoly.qpower(v, k9), w)) ->
                  dividesIntegrally(u, w)) ->
                  (forall w: Q; isInteger(w) ->
                  dividesIntegrally(u,
                  rational.mul(qpoly.qpower(v,
                  nat_succ(k9)), w)) ->
                  dividesIntegrally(u, w))
                [by generalize generalize-s]
            }
          @discharge-r |
            forall r9, s9: Q; forall k9: Nat;
              isInteger(u) -> isInteger(v) ->
              isInteger(r9) -> isInteger(s9) ->
              rational.add(rational.mul(u, r9),
              rational.mul(v, s9)) = ONE ->
              (forall w: Q; isInteger(w) ->
              dividesIntegrally(u,
              rational.mul(qpoly.qpower(v, k9), w)) ->
              dividesIntegrally(u, w)) ->
              (forall w: Q; isInteger(w) ->
              dividesIntegrally(u,
              rational.mul(qpoly.qpower(v,
              nat_succ(k9)), w)) ->
              dividesIntegrally(u, w))
            [by generalize generalize-r]
        }
      @discharge-v |
        forall v9: Q; forall r9, s9: Q; forall k9: Nat;
          isInteger(u) -> isInteger(v9) ->
          isInteger(r9) -> isInteger(s9) ->
          rational.add(rational.mul(u, r9),
          rational.mul(v9, s9)) = ONE ->
          (forall w: Q; isInteger(w) ->
          dividesIntegrally(u,
          rational.mul(qpoly.qpower(v9, k9), w)) ->
          dividesIntegrally(u, w)) ->
          (forall w: Q; isInteger(w) ->
          dividesIntegrally(u,
          rational.mul(qpoly.qpower(v9,
          nat_succ(k9)), w)) ->
          dividesIntegrally(u, w))
        [by generalize generalize-v]
    }
  @conclusion |
    forall u, v, r, s: Q; forall k: Nat;
      isInteger(u) -> isInteger(v) -> isInteger(r) -> isInteger(s) ->
      rational.add(rational.mul(u, r), rational.mul(v, s)) = ONE ->
      (forall w: Q; isInteger(w) ->
      dividesIntegrally(u, rational.mul(qpoly.qpower(v, k), w)) ->
      dividesIntegrally(u, w)) ->
      (forall w: Q; isInteger(w) ->
      dividesIntegrally(u,
      rational.mul(qpoly.qpower(v, nat_succ(k)), w)) ->
      dividesIntegrally(u, w))
    [by generalize generalize-u]
qed

// The induction. Note the certificate hypotheses sit OUTSIDE the induction (they do not vary
// with the exponent), so the induction is over the cofactor-quantified statement only.
theorem coprimeToAPowerDividesTheCofactor: forall u, v, r, s: Q;
  isInteger(u) -> isInteger(v) -> isInteger(r) -> isInteger(s) ->
  rational.add(rational.mul(u, r), rational.mul(v, s)) = ONE ->
  (forall k: Nat; forall w: Q; isInteger(w) ->
  dividesIntegrally(u, rational.mul(qpoly.qpower(v, k), w)) ->
  dividesIntegrally(u, w))
proof
  @generalize-u |
    fix u: Q {
      @generalize-v |
        fix v: Q {
          @generalize-r |
            fix r: Q {
              @generalize-s |
                fix s: Q {
                  @given-the-certificate |
                    assume isInteger(u) and isInteger(v) and
                      isInteger(r) and isInteger(s) and
                      rational.add(rational.mul(u, r),
                      rational.mul(v, s)) = ONE {
                      @the-setup |
                        isInteger(u) and isInteger(v) and
                          isInteger(r) and isInteger(s) and
                          rational.add(rational.mul(u, r),
                          rational.mul(v, s)) = ONE
                        [by hypothesis given-the-certificate]
                      @u-is-an-integer |
                        isInteger(u)
                        [using tautology the-setup]
                      @v-is-an-integer |
                        isInteger(v)
                        [using tautology the-setup]
                      @r-is-an-integer |
                        isInteger(r)
                        [using tautology the-setup]
                      @s-is-an-integer |
                        isInteger(s)
                        [using tautology the-setup]
                      @the-certificate |
                        rational.add(rational.mul(u, r),
                          rational.mul(v, s)) = ONE
                        [using tautology the-setup]
                      @base-case |
                        forall w: Q; isInteger(w) ->
                          dividesIntegrally(u,
                          rational.mul(qpoly.qpower(v, NAT_ZERO),
                          w)) ->
                          dividesIntegrally(u, w)
                        [using specialize theZeroPowerStrips(u, v)]
                      @induction-step |
                        fix k: Nat {
                          @the-step-at-k |
                            (forall w: Q; isInteger(w) ->
                              dividesIntegrally(u,
                              rational.mul(qpoly.qpower(v, k),
                              w)) ->
                              dividesIntegrally(u, w)) ->
                              (forall w: Q; isInteger(w) ->
                              dividesIntegrally(u,
                              rational.mul(qpoly.qpower(v,
                              nat_succ(k)), w)) ->
                              dividesIntegrally(u, w))
                            [using specialize theSuccessorPowerStrips(u, v, r, s, k) u-is-an-integer v-is-an-integer r-is-an-integer s-is-an-integer the-certificate]
                        }
                      @induction-step-for-all-k |
                        forall k: Nat;
                          (forall w: Q; isInteger(w) ->
                          dividesIntegrally(u,
                          rational.mul(qpoly.qpower(v, k), w)) ->
                          dividesIntegrally(u, w)) ->
                          (forall w: Q; isInteger(w) ->
                          dividesIntegrally(u,
                          rational.mul(qpoly.qpower(v,
                          nat_succ(k)), w)) ->
                          dividesIntegrally(u, w))
                        [by generalize induction-step]
                      @all-exponents |
                        forall k: Nat; forall w: Q; isInteger(w) ->
                          dividesIntegrally(u,
                          rational.mul(qpoly.qpower(v, k), w)) ->
                          dividesIntegrally(u, w)
                        [using instantiation peano.induction((fun z: Nat => (forall w: Q; isInteger(w) -> dividesIntegrally(u, rational.mul(qpoly.qpower(v, z), w)) -> dividesIntegrally(u, w)))) base-case induction-step-for-all-k]
                    }
                  @the-implication |
                    (isInteger(u) and isInteger(v) and
                      isInteger(r) and isInteger(s) and
                      rational.add(rational.mul(u, r),
                      rational.mul(v, s)) = ONE) ->
                      (forall k: Nat; forall w: Q; isInteger(w) ->
                      dividesIntegrally(u,
                      rational.mul(qpoly.qpower(v, k), w)) ->
                      dividesIntegrally(u, w))
                    [by discharge given-the-certificate]
                  @curried |
                    isInteger(u) -> isInteger(v) ->
                      isInteger(r) -> isInteger(s) ->
                      rational.add(rational.mul(u, r),
                      rational.mul(v, s)) = ONE ->
                      (forall k: Nat; forall w: Q; isInteger(w) ->
                      dividesIntegrally(u,
                      rational.mul(qpoly.qpower(v, k), w)) ->
                      dividesIntegrally(u, w))
                    [using tautology the-implication]
                }
              @discharge-s |
                forall s9: Q;
                  isInteger(u) -> isInteger(v) ->
                  isInteger(r) -> isInteger(s9) ->
                  rational.add(rational.mul(u, r),
                  rational.mul(v, s9)) = ONE ->
                  (forall k: Nat; forall w: Q; isInteger(w) ->
                  dividesIntegrally(u,
                  rational.mul(qpoly.qpower(v, k), w)) ->
                  dividesIntegrally(u, w))
                [by generalize generalize-s]
            }
          @discharge-r |
            forall r9, s9: Q;
              isInteger(u) -> isInteger(v) ->
              isInteger(r9) -> isInteger(s9) ->
              rational.add(rational.mul(u, r9),
              rational.mul(v, s9)) = ONE ->
              (forall k: Nat; forall w: Q; isInteger(w) ->
              dividesIntegrally(u,
              rational.mul(qpoly.qpower(v, k), w)) ->
              dividesIntegrally(u, w))
            [by generalize generalize-r]
        }
      @discharge-v |
        forall v9: Q; forall r9, s9: Q;
          isInteger(u) -> isInteger(v9) ->
          isInteger(r9) -> isInteger(s9) ->
          rational.add(rational.mul(u, r9),
          rational.mul(v9, s9)) = ONE ->
          (forall k: Nat; forall w: Q; isInteger(w) ->
          dividesIntegrally(u,
          rational.mul(qpoly.qpower(v9, k), w)) ->
          dividesIntegrally(u, w))
        [by generalize generalize-v]
    }
  @conclusion |
    forall u, v, r, s: Q;
      isInteger(u) -> isInteger(v) -> isInteger(r) -> isInteger(s) ->
      rational.add(rational.mul(u, r), rational.mul(v, s)) = ONE ->
      (forall k: Nat; forall w: Q; isInteger(w) ->
      dividesIntegrally(u, rational.mul(qpoly.qpower(v, k), w)) ->
      dividesIntegrally(u, w))
    [by generalize generalize-u]
qed

// -- COROLLARY 17.14, THE NUMERATOR HALF ---------------------------------------------------
// "If r/s is a zero of p(x) with gcd(r, s) = 1, then r | a_0."
//
// Clearing denominators gives `0 = s^(n+1)·a_0 + r·t` (the constant-term split), so
// `r | s^(n+1)·a_0`; Bézout plus the coprime-power induction strips every s.
theorem theNumeratorDividesTheConstantTerm: forall p: qpoly.QPoly;
  forall r, s: Q; forall n: Nat;
  isInteger(r) -> isInteger(s) -> less_than(ZERO, r) ->
  rational.nonzero(s) ->
  (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
  qpoly.arePairwiseRelativelyPrime(r, s) ->
  qpoly.qclearedSum(p, r, s, nat_succ(n)) = ZERO ->
  dividesIntegrally(r, qpoly.qcoeff(p, NAT_ZERO))
proof
  @generalize-p |
    fix p: qpoly.QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @generalize-n |
                fix n: Nat {
                  @given-the-setup |
                    assume isInteger(r) and isInteger(s) and
                      less_than(ZERO, r) and rational.nonzero(s) and
                      (forall i: Nat;
                      isInteger(qpoly.qcoeff(p, i))) and
                      qpoly.arePairwiseRelativelyPrime(r, s) and
                      qpoly.qclearedSum(p, r, s,
                      nat_succ(n)) = ZERO {
                      @the-setup |
                        isInteger(r) and isInteger(s) and
                          less_than(ZERO, r) and
                          rational.nonzero(s) and
                          (forall i: Nat;
                          isInteger(qpoly.qcoeff(p, i))) and
                          qpoly.arePairwiseRelativelyPrime(r, s) and
                          qpoly.qclearedSum(p, r, s,
                          nat_succ(n)) = ZERO
                        [by hypothesis given-the-setup]
                      @r-is-an-integer |
                        isInteger(r)
                        [using tautology the-setup]
                      @s-is-an-integer |
                        isInteger(s)
                        [using tautology the-setup]
                      @r-is-positive |
                        less_than(ZERO, r)
                        [using tautology the-setup]
                      @the-coefficients-are-integers |
                        forall i: Nat;
                          isInteger(qpoly.qcoeff(p, i))
                        [using tautology the-setup]
                      @the-coprimality |
                        qpoly.arePairwiseRelativelyPrime(r, s)
                        [using tautology the-setup]
                      @the-cleared-sum-vanishes |
                        qpoly.qclearedSum(p, r, s,
                          nat_succ(n)) = ZERO
                        [using tautology the-setup]
                      // Bézout for (r, s), from the quantified coprimality
                      @the-certificate-exists |
                        exists r2, s2: Q; isInteger(r2) and
                          isInteger(s2) and
                          rational.add(rational.mul(r, r2),
                          rational.mul(s, s2)) = ONE
                        [using specialize rational_integer_division.bezoutOnTheCut(r, s) r-is-an-integer s-is-an-integer r-is-positive the-coprimality]
                      // the constant-term split
                      @the-split-exists |
                        exists t: Q; isInteger(t) and
                          qpoly.qclearedSum(p, r, s,
                          nat_succ(n)) =
                          rational.add(rational.mul(
                          qpoly.qpower(s, nat_succ(n)),
                          qpoly.qcoeff(p, NAT_ZERO)),
                          rational.mul(r, t))
                        [using specialize qpoly.theClearedSumSplitsOffTheConstantTerm(p, r, s, n) r-is-an-integer s-is-an-integer the-coefficients-are-integers]
                      @conclusion-with-the-split |
                        unpack t: Q from the-split-exists {
                          @the-split |
                            isInteger(t) and
                              qpoly.qclearedSum(p, r, s,
                              nat_succ(n)) =
                              rational.add(rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO)),
                              rational.mul(r, t))
                            [by hypothesis conclusion-with-the-split]
                          @t-is-an-integer |
                            isInteger(t)
                            [by and_lhs the-split]
                          @the-sum-splits |
                            qpoly.qclearedSum(p, r, s,
                              nat_succ(n)) =
                              rational.add(rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO)),
                              rational.mul(r, t))
                            [by and_rhs the-split]
                          // 0 = s^(n+1)·a_0 + r·t, so s^(n+1)·a_0 = r·(-t)
                          @zero-is-the-split |
                            ZERO = rational.add(rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO)),
                              rational.mul(r, t))
                            [by rewrite the-cleared-sum-vanishes the-sum-splits]
                          @minus-t-is-an-integer |
                            isInteger(rational.neg(t))
                            [using specialize rational.isIntegerNeg(t) t-is-an-integer]
                          // from 0 = X + r·t, subtract r·t: X = -(r·t) = r·(-t)
                          @the-split-flipped |
                            rational.add(rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO)),
                              rational.mul(r, t)) = ZERO
                            [by symmetry zero-is-the-split]
                          // stated over an ABSTRACT x so `polynomial` never looks
                          // inside the power (whose exponent is a Nat, which it
                          // cannot handle under the ℚ theory), then specialized
                          @the-isolation-law |
                            forall x, y: Q;
                              rational.add(rational.add(x, y),
                              rational.neg(y)) = x
                            [using import(rational_integer_division) addingAndSubtractingCancels]
                          @the-isolation |
                            rational.add(rational.add(
                              rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO)),
                              rational.mul(r, t)),
                              rational.neg(rational.mul(r, t))) =
                              rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO))
                            [using specialize the-isolation-law(rational.mul(qpoly.qpower(s, nat_succ(n)), qpoly.qcoeff(p, NAT_ZERO)), rational.mul(r, t))]
                          @the-shifted-zero-law |
                            forall x, y: Q;
                              rational.add(ZERO,
                              rational.neg(rational.mul(x, y))) =
                              rational.mul(x, rational.neg(y))
                            [using import(rational_integer_division) theNegatedProductFromZero]
                          @the-shifted-zero |
                            rational.add(ZERO,
                              rational.neg(rational.mul(r, t))) =
                              rational.mul(r, rational.neg(t))
                            [using specialize the-shifted-zero-law(r, t)]
                          @the-isolation-at-zero |
                            rational.add(ZERO,
                              rational.neg(rational.mul(r, t))) =
                              rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO))
                            [by rewrite the-split-flipped the-isolation]
                          @the-rearrangement-flipped |
                            rational.mul(r, rational.neg(t)) =
                              rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO))
                            [by rewrite the-shifted-zero the-isolation-at-zero]
                          @the-rearrangement |
                            rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO)) =
                              rational.mul(r, rational.neg(t))
                            [by symmetry the-rearrangement-flipped]
                          @the-product-quotient-works |
                            isInteger(rational.neg(t)) and
                              rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO)) =
                              rational.mul(r, rational.neg(t))
                            [by both minus-t-is-an-integer the-rearrangement]
                          @a-product-quotient-exists |
                            exists k: Q; isInteger(k) and
                              rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO)) =
                              rational.mul(r, k)
                            [by witness(rational.neg(t)) the-product-quotient-works]
                          @the-product-divides-meaning |
                            dividesIntegrally(r, rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO))) iff
                              (exists k: Q; isInteger(k) and
                              rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO)) =
                              rational.mul(r, k))
                            [using specialize dividesIntegrallyMeaning(r, rational.mul(qpoly.qpower(s, nat_succ(n)), qpoly.qcoeff(p, NAT_ZERO)))]
                          @r-divides-the-product |
                            dividesIntegrally(r, rational.mul(
                              qpoly.qpower(s, nat_succ(n)),
                              qpoly.qcoeff(p, NAT_ZERO)))
                            [using tautology the-product-divides-meaning a-product-quotient-exists]
                          // strip every s with the coprime-power induction
                          @conclusion-with-the-certificate |
                            unpack cr: Q from the-certificate-exists {
                              @the-s-coefficient-exists |
                                exists s2: Q; isInteger(cr) and
                                  isInteger(s2) and
                                  rational.add(
                                  rational.mul(r, cr),
                                  rational.mul(s, s2)) = ONE
                                [by hypothesis conclusion-with-the-certificate]
                              @conclusion-with-both |
                                unpack cs: Q from the-s-coefficient-exists {
                                  @the-certificate-parts |
                                    isInteger(cr) and
                                      isInteger(cs) and
                                      rational.add(
                                      rational.mul(r, cr),
                                      rational.mul(s, cs)) = ONE
                                    [by hypothesis conclusion-with-both]
                                  @cr-is-an-integer |
                                    isInteger(cr)
                                    [using tautology the-certificate-parts]
                                  @cs-is-an-integer |
                                    isInteger(cs)
                                    [using tautology the-certificate-parts]
                                  @the-certificate |
                                    rational.add(
                                      rational.mul(r, cr),
                                      rational.mul(s, cs)) = ONE
                                    [using tautology the-certificate-parts]
                                  @the-stripping |
                                    forall k: Nat; forall w: Q;
                                      isInteger(w) ->
                                      dividesIntegrally(r,
                                      rational.mul(
                                      qpoly.qpower(s, k), w)) ->
                                      dividesIntegrally(r, w)
                                    [using specialize coprimeToAPowerDividesTheCofactor(r, s, cr, cs) r-is-an-integer s-is-an-integer cr-is-an-integer cs-is-an-integer the-certificate]
                                  @the-constant-is-an-integer |
                                    isInteger(qpoly.qcoeff(p,
                                      NAT_ZERO))
                                    [using specialize the-coefficients-are-integers(NAT_ZERO)]
                                  @conclusion-r-divides-the-constant |
                                    dividesIntegrally(r,
                                      qpoly.qcoeff(p, NAT_ZERO))
                                    [using specialize the-stripping(nat_succ(n), qpoly.qcoeff(p, NAT_ZERO)) the-constant-is-an-integer r-divides-the-product]
                                }
                              @the-both-exported |
                                dividesIntegrally(r,
                                  qpoly.qcoeff(p, NAT_ZERO))
                                [by unpacked conclusion-with-both]
                            }
                          @the-certificate-exported |
                            dividesIntegrally(r,
                              qpoly.qcoeff(p, NAT_ZERO))
                            [by unpacked conclusion-with-the-certificate]
                        }
                      @the-split-exported |
                        dividesIntegrally(r,
                          qpoly.qcoeff(p, NAT_ZERO))
                        [by unpacked conclusion-with-the-split]
                    }
                  @the-implication |
                    (isInteger(r) and isInteger(s) and
                      less_than(ZERO, r) and rational.nonzero(s) and
                      (forall i: Nat;
                      isInteger(qpoly.qcoeff(p, i))) and
                      qpoly.arePairwiseRelativelyPrime(r, s) and
                      qpoly.qclearedSum(p, r, s,
                      nat_succ(n)) = ZERO) ->
                      dividesIntegrally(r,
                      qpoly.qcoeff(p, NAT_ZERO))
                    [by discharge given-the-setup]
                  @curried |
                    isInteger(r) -> isInteger(s) ->
                      less_than(ZERO, r) -> rational.nonzero(s) ->
                      (forall i: Nat;
                      isInteger(qpoly.qcoeff(p, i))) ->
                      qpoly.arePairwiseRelativelyPrime(r, s) ->
                      qpoly.qclearedSum(p, r, s,
                      nat_succ(n)) = ZERO ->
                      dividesIntegrally(r,
                      qpoly.qcoeff(p, NAT_ZERO))
                    [using tautology the-implication]
                }
              @discharge-n |
                forall n9: Nat;
                  isInteger(r) -> isInteger(s) ->
                  less_than(ZERO, r) -> rational.nonzero(s) ->
                  (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
                  qpoly.arePairwiseRelativelyPrime(r, s) ->
                  qpoly.qclearedSum(p, r, s, nat_succ(n9)) = ZERO ->
                  dividesIntegrally(r, qpoly.qcoeff(p, NAT_ZERO))
                [by generalize generalize-n]
            }
          @discharge-s |
            forall s9: Q; forall n9: Nat;
              isInteger(r) -> isInteger(s9) ->
              less_than(ZERO, r) -> rational.nonzero(s9) ->
              (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
              qpoly.arePairwiseRelativelyPrime(r, s9) ->
              qpoly.qclearedSum(p, r, s9, nat_succ(n9)) = ZERO ->
              dividesIntegrally(r, qpoly.qcoeff(p, NAT_ZERO))
            [by generalize generalize-s]
        }
      @discharge-r |
        forall r9, s9: Q; forall n9: Nat;
          isInteger(r9) -> isInteger(s9) ->
          less_than(ZERO, r9) -> rational.nonzero(s9) ->
          (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
          qpoly.arePairwiseRelativelyPrime(r9, s9) ->
          qpoly.qclearedSum(p, r9, s9, nat_succ(n9)) = ZERO ->
          dividesIntegrally(r9, qpoly.qcoeff(p, NAT_ZERO))
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: qpoly.QPoly; forall r, s: Q; forall n: Nat;
      isInteger(r) -> isInteger(s) -> less_than(ZERO, r) ->
      rational.nonzero(s) ->
      (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
      qpoly.arePairwiseRelativelyPrime(r, s) ->
      qpoly.qclearedSum(p, r, s, nat_succ(n)) = ZERO ->
      dividesIntegrally(r, qpoly.qcoeff(p, NAT_ZERO))
    [by generalize generalize-p]
qed

// -- COROLLARY 17.14, THE DENOMINATOR HALF -------------------------------------------------
// "…and s | a_n."
//
// No second recursion is needed. The defining clause `S(k+1) = s·(S(k) + a_k·r^k)` says two
// things at once: s divides EVERY cleared sum, and `S(n+1) = 0` with `s != 0` forces
// `S(n) + a_n·r^n = 0`. Since s also divides S(n), it divides `a_n·r^n` — and the
// coprime-power induction strips every r.

// s divides every cleared sum: at ZERO it is ZERO, and at a successor the defining clause
// exhibits s as a factor whose cofactor is an integer (the running sum by induction, plus a
// product of integer coefficients and powers).
theorem theDenominatorDividesEveryClearedSum: forall p: qpoly.QPoly;
  forall r, s: Q;
  isInteger(r) -> isInteger(s) ->
  (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
  (forall k: Nat;
  isInteger(qpoly.qclearedSum(p, r, s, k)) and
  dividesIntegrally(s, qpoly.qclearedSum(p, r, s, k)))
proof
  @generalize-p |
    fix p: qpoly.QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @given-the-integrality |
                assume isInteger(r) and isInteger(s) and
                  (forall i: Nat;
                  isInteger(qpoly.qcoeff(p, i))) {
                  @the-integrality |
                    isInteger(r) and isInteger(s) and
                      (forall i: Nat;
                      isInteger(qpoly.qcoeff(p, i)))
                    [by hypothesis given-the-integrality]
                  @r-is-an-integer |
                    isInteger(r)
                    [using tautology the-integrality]
                  @s-is-an-integer |
                    isInteger(s)
                    [using tautology the-integrality]
                  @the-coefficients-are-integers |
                    forall i: Nat; isInteger(qpoly.qcoeff(p, i))
                    [using tautology the-integrality]
                  @the-powers-of-r-are-integers |
                    forall j: Nat;
                      isInteger(qpoly.qpower(r, j))
                    [using specialize qpoly.everyPowerOfAnIntegerIsAnInteger(r) r-is-an-integer]
                  // base
                  @the-empty-sum |
                    qpoly.qclearedSum(p, r, s, NAT_ZERO) = ZERO
                    [using specialize qpoly.qClearedSumZero(p, r, s)]
                  @zero-is-an-integer |
                    isInteger(ZERO)
                    [using import(rational) zeroIsAnInteger]
                  @zero-is-s-times-zero |
                    ZERO = rational.mul(s, ZERO)
                    [using polynomial(rational)]
                  @the-zero-quotient-works |
                    isInteger(ZERO) and
                      ZERO = rational.mul(s, ZERO)
                    [by both zero-is-an-integer zero-is-s-times-zero]
                  @a-zero-quotient-exists |
                    exists k2: Q; isInteger(k2) and
                      ZERO = rational.mul(s, k2)
                    [by witness(ZERO) the-zero-quotient-works]
                  @the-zero-divides-meaning |
                    dividesIntegrally(s, ZERO) iff
                      (exists k2: Q; isInteger(k2) and
                      ZERO = rational.mul(s, k2))
                    [using specialize dividesIntegrallyMeaning(s, ZERO)]
                  @s-divides-zero |
                    dividesIntegrally(s, ZERO)
                    [using tautology the-zero-divides-meaning a-zero-quotient-exists]
                  @the-base-conjunction |
                    isInteger(ZERO) and dividesIntegrally(s, ZERO)
                    [by both zero-is-an-integer s-divides-zero]
                  @base-case |
                    isInteger(qpoly.qclearedSum(p, r, s,
                      NAT_ZERO)) and
                      dividesIntegrally(s,
                      qpoly.qclearedSum(p, r, s, NAT_ZERO))
                    [by rewrite the-empty-sum the-base-conjunction]

                  // step
                  @induction-step |
                    fix k: Nat {
                      @given-inductive-hypothesis |
                        assume isInteger(qpoly.qclearedSum(p, r, s,
                          k)) and
                          dividesIntegrally(s,
                          qpoly.qclearedSum(p, r, s, k)) {
                          @inductive-hypothesis |
                            isInteger(qpoly.qclearedSum(p, r, s,
                              k)) and
                              dividesIntegrally(s,
                              qpoly.qclearedSum(p, r, s, k))
                            [by hypothesis given-inductive-hypothesis]
                          @the-sum-is-an-integer |
                            isInteger(qpoly.qclearedSum(p, r, s, k))
                            [by and_lhs inductive-hypothesis]
                          @the-defining-clause |
                            qpoly.qclearedSum(p, r, s,
                              nat_succ(k)) =
                              rational.mul(s, rational.add(
                              qpoly.qclearedSum(p, r, s, k),
                              rational.mul(qpoly.qcoeff(p, k),
                              qpoly.qpower(r, k))))
                            [using specialize qpoly.qClearedSumSucc(p, r, s, k)]
                          // the cofactor is an integer
                          @the-k-th-coefficient-is-an-integer |
                            isInteger(qpoly.qcoeff(p, k))
                            [using specialize the-coefficients-are-integers(k)]
                          @the-k-th-power-is-an-integer |
                            isInteger(qpoly.qpower(r, k))
                            [using specialize the-powers-of-r-are-integers(k)]
                          @the-new-term-is-an-integer |
                            isInteger(rational.mul(
                              qpoly.qcoeff(p, k),
                              qpoly.qpower(r, k)))
                            [using specialize rational.isIntegerMul(qpoly.qcoeff(p, k), qpoly.qpower(r, k)) the-k-th-coefficient-is-an-integer the-k-th-power-is-an-integer]
                          @the-cofactor-is-an-integer |
                            isInteger(rational.add(
                              qpoly.qclearedSum(p, r, s, k),
                              rational.mul(qpoly.qcoeff(p, k),
                              qpoly.qpower(r, k))))
                            [using specialize rational.isIntegerAdd(qpoly.qclearedSum(p, r, s, k), rational.mul(qpoly.qcoeff(p, k), qpoly.qpower(r, k))) the-sum-is-an-integer the-new-term-is-an-integer]
                          // so the product is an integer AND divisible by s
                          @the-next-sum-is-an-integer |
                            isInteger(qpoly.qclearedSum(p, r, s,
                              nat_succ(k)))
                            [using specialize rational_integer_division.theScaledIntegerIsAnInteger(s, rational.add(qpoly.qclearedSum(p, r, s, k), rational.mul(qpoly.qcoeff(p, k), qpoly.qpower(r, k))), qpoly.qclearedSum(p, r, s, nat_succ(k))) s-is-an-integer the-cofactor-is-an-integer the-defining-clause]
                          @the-cofactor-witnesses |
                            isInteger(rational.add(
                              qpoly.qclearedSum(p, r, s, k),
                              rational.mul(qpoly.qcoeff(p, k),
                              qpoly.qpower(r, k)))) and
                              qpoly.qclearedSum(p, r, s,
                              nat_succ(k)) =
                              rational.mul(s, rational.add(
                              qpoly.qclearedSum(p, r, s, k),
                              rational.mul(qpoly.qcoeff(p, k),
                              qpoly.qpower(r, k))))
                            [by both the-cofactor-is-an-integer the-defining-clause]
                          @a-next-quotient-exists |
                            exists k2: Q; isInteger(k2) and
                              qpoly.qclearedSum(p, r, s,
                              nat_succ(k)) =
                              rational.mul(s, k2)
                            [by witness(rational.add(qpoly.qclearedSum(p, r, s, k), rational.mul(qpoly.qcoeff(p, k), qpoly.qpower(r, k)))) the-cofactor-witnesses]
                          @the-next-divides-meaning |
                            dividesIntegrally(s,
                              qpoly.qclearedSum(p, r, s,
                              nat_succ(k))) iff
                              (exists k2: Q; isInteger(k2) and
                              qpoly.qclearedSum(p, r, s,
                              nat_succ(k)) =
                              rational.mul(s, k2))
                            [using specialize dividesIntegrallyMeaning(s, qpoly.qclearedSum(p, r, s, nat_succ(k)))]
                          @s-divides-the-next |
                            dividesIntegrally(s,
                              qpoly.qclearedSum(p, r, s,
                              nat_succ(k)))
                            [using tautology the-next-divides-meaning a-next-quotient-exists]
                          @conclusion-the-step |
                            isInteger(qpoly.qclearedSum(p, r, s,
                              nat_succ(k))) and
                              dividesIntegrally(s,
                              qpoly.qclearedSum(p, r, s,
                              nat_succ(k)))
                            [by both the-next-sum-is-an-integer s-divides-the-next]
                        }
                      @induction-step-at-k |
                        (isInteger(qpoly.qclearedSum(p, r, s, k)) and
                          dividesIntegrally(s,
                          qpoly.qclearedSum(p, r, s, k))) ->
                          (isInteger(qpoly.qclearedSum(p, r, s,
                          nat_succ(k))) and
                          dividesIntegrally(s,
                          qpoly.qclearedSum(p, r, s,
                          nat_succ(k))))
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-for-all-k |
                    forall k: Nat;
                      (isInteger(qpoly.qclearedSum(p, r, s, k)) and
                      dividesIntegrally(s,
                      qpoly.qclearedSum(p, r, s, k))) ->
                      (isInteger(qpoly.qclearedSum(p, r, s,
                      nat_succ(k))) and
                      dividesIntegrally(s,
                      qpoly.qclearedSum(p, r, s, nat_succ(k))))
                    [by generalize induction-step]
                  @all-bounds |
                    forall k: Nat;
                      isInteger(qpoly.qclearedSum(p, r, s, k)) and
                      dividesIntegrally(s,
                      qpoly.qclearedSum(p, r, s, k))
                    [using instantiation peano.induction((fun z: Nat => (isInteger(qpoly.qclearedSum(p, r, s, z)) and dividesIntegrally(s, qpoly.qclearedSum(p, r, s, z))))) base-case induction-step-for-all-k]
                }
              @the-implication |
                (isInteger(r) and isInteger(s) and
                  (forall i: Nat;
                  isInteger(qpoly.qcoeff(p, i)))) ->
                  (forall k: Nat;
                  isInteger(qpoly.qclearedSum(p, r, s, k)) and
                  dividesIntegrally(s,
                  qpoly.qclearedSum(p, r, s, k)))
                [by discharge given-the-integrality]
              @curried |
                isInteger(r) -> isInteger(s) ->
                  (forall i: Nat;
                  isInteger(qpoly.qcoeff(p, i))) ->
                  (forall k: Nat;
                  isInteger(qpoly.qclearedSum(p, r, s, k)) and
                  dividesIntegrally(s,
                  qpoly.qclearedSum(p, r, s, k)))
                [using tautology the-implication]
            }
          @discharge-s |
            forall s9: Q;
              isInteger(r) -> isInteger(s9) ->
              (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
              (forall k: Nat;
              isInteger(qpoly.qclearedSum(p, r, s9, k)) and
              dividesIntegrally(s9,
              qpoly.qclearedSum(p, r, s9, k)))
            [by generalize generalize-s]
        }
      @discharge-r |
        forall r9, s9: Q;
          isInteger(r9) -> isInteger(s9) ->
          (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
          (forall k: Nat;
          isInteger(qpoly.qclearedSum(p, r9, s9, k)) and
          dividesIntegrally(s9,
          qpoly.qclearedSum(p, r9, s9, k)))
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: qpoly.QPoly; forall r, s: Q;
      isInteger(r) -> isInteger(s) ->
      (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
      (forall k: Nat;
      isInteger(qpoly.qclearedSum(p, r, s, k)) and
      dividesIntegrally(s, qpoly.qclearedSum(p, r, s, k)))
    [by generalize generalize-p]
qed

// The denominator half. `S(n+1) = 0` is `s·(S(n) + a_n·r^n) = 0`, so with `s != 0` the
// cofactor vanishes: `a_n·r^n = -S(n)`. Since s divides S(n), it divides `a_n·r^n`, and the
// coprime-power induction strips every r.
theorem theDenominatorDividesTheLeadingCoefficient: forall p: qpoly.QPoly;
  forall r, s: Q; forall n: Nat;
  isInteger(r) -> isInteger(s) -> less_than(ZERO, r) ->
  rational.nonzero(s) ->
  (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
  qpoly.arePairwiseRelativelyPrime(r, s) ->
  qpoly.qclearedSum(p, r, s, nat_succ(n)) = ZERO ->
  dividesIntegrally(s, qpoly.qcoeff(p, n))
proof
  @generalize-p |
    fix p: qpoly.QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @generalize-n |
                fix n: Nat {
                  @given-the-setup |
                    assume isInteger(r) and isInteger(s) and
                      less_than(ZERO, r) and rational.nonzero(s) and
                      (forall i: Nat;
                      isInteger(qpoly.qcoeff(p, i))) and
                      qpoly.arePairwiseRelativelyPrime(r, s) and
                      qpoly.qclearedSum(p, r, s,
                      nat_succ(n)) = ZERO {
                      @the-setup |
                        isInteger(r) and isInteger(s) and
                          less_than(ZERO, r) and
                          rational.nonzero(s) and
                          (forall i: Nat;
                          isInteger(qpoly.qcoeff(p, i))) and
                          qpoly.arePairwiseRelativelyPrime(r, s) and
                          qpoly.qclearedSum(p, r, s,
                          nat_succ(n)) = ZERO
                        [by hypothesis given-the-setup]
                      @r-is-an-integer |
                        isInteger(r)
                        [using tautology the-setup]
                      @s-is-an-integer |
                        isInteger(s)
                        [using tautology the-setup]
                      @r-is-positive |
                        less_than(ZERO, r)
                        [using tautology the-setup]
                      @s-is-nonzero |
                        rational.nonzero(s)
                        [using tautology the-setup]
                      @the-coefficients-are-integers |
                        forall i: Nat;
                          isInteger(qpoly.qcoeff(p, i))
                        [using tautology the-setup]
                      @the-coprimality |
                        qpoly.arePairwiseRelativelyPrime(r, s)
                        [using tautology the-setup]
                      @the-cleared-sum-vanishes |
                        qpoly.qclearedSum(p, r, s,
                          nat_succ(n)) = ZERO
                        [using tautology the-setup]
                      // s·(S(n) + a_n·r^n) = 0 with s != 0 forces the cofactor to vanish
                      @the-defining-clause |
                        qpoly.qclearedSum(p, r, s,
                          nat_succ(n)) =
                          rational.mul(s, rational.add(
                          qpoly.qclearedSum(p, r, s, n),
                          rational.mul(qpoly.qcoeff(p, n),
                          qpoly.qpower(r, n))))
                        [using specialize qpoly.qClearedSumSucc(p, r, s, n)]
                      @the-product-vanishes |
                        rational.mul(s, rational.add(
                          qpoly.qclearedSum(p, r, s, n),
                          rational.mul(qpoly.qcoeff(p, n),
                          qpoly.qpower(r, n)))) = ZERO
                        [by rewrite the-defining-clause the-cleared-sum-vanishes]
                      @a-factor-vanishes |
                        s = ZERO or
                          rational.add(
                          qpoly.qclearedSum(p, r, s, n),
                          rational.mul(qpoly.qcoeff(p, n),
                          qpoly.qpower(r, n))) = ZERO
                        [using specialize rational.noZeroDivisors(s, rational.add(qpoly.qclearedSum(p, r, s, n), rational.mul(qpoly.qcoeff(p, n), qpoly.qpower(r, n)))) the-product-vanishes]
                      // `tautology` sees `nonzero(s)` and `s = ZERO` as unrelated ATOMS
                      @s-characterized-here |
                        rational.nonzero(s) iff (not (s = ZERO))
                        [using specialize rational.nonzeroMeaning(s)]
                      @the-cofactor-vanishes |
                        rational.add(
                          qpoly.qclearedSum(p, r, s, n),
                          rational.mul(qpoly.qcoeff(p, n),
                          qpoly.qpower(r, n))) = ZERO
                        [using tautology a-factor-vanishes s-is-nonzero s-characterized-here]
                      // so a_n·r^n = -S(n), which s divides
                      @the-sum-facts |
                        forall k: Nat;
                          isInteger(qpoly.qclearedSum(p, r, s, k)) and
                          dividesIntegrally(s,
                          qpoly.qclearedSum(p, r, s, k))
                        [using specialize theDenominatorDividesEveryClearedSum(p, r, s) r-is-an-integer s-is-an-integer the-coefficients-are-integers]
                      @the-sum-at-n |
                        isInteger(qpoly.qclearedSum(p, r, s, n)) and
                          dividesIntegrally(s,
                          qpoly.qclearedSum(p, r, s, n))
                        [using specialize the-sum-facts(n)]
                      @s-divides-the-sum |
                        dividesIntegrally(s,
                          qpoly.qclearedSum(p, r, s, n))
                        [by and_rhs the-sum-at-n]
                      // unfold the predicate into the raw existential the
                      // negation lemma consumes, then fold the result back
                      @the-sum-divides-meaning |
                        dividesIntegrally(s,
                          qpoly.qclearedSum(p, r, s, n)) iff
                          (exists k2: Q; isInteger(k2) and
                          qpoly.qclearedSum(p, r, s, n) =
                          rational.mul(s, k2))
                        [using specialize dividesIntegrallyMeaning(s, qpoly.qclearedSum(p, r, s, n))]
                      @a-sum-quotient-exists |
                        exists k2: Q; isInteger(k2) and
                          qpoly.qclearedSum(p, r, s, n) =
                          rational.mul(s, k2)
                        [using tautology the-sum-divides-meaning s-divides-the-sum]
                      @a-negated-quotient-exists |
                        exists k2: Q; isInteger(k2) and
                          rational.neg(
                          qpoly.qclearedSum(p, r, s, n)) =
                          rational.mul(s, k2)
                        [using specialize rational_integer_division.theNegationOfAMultipleIsAMultiple(s, qpoly.qclearedSum(p, r, s, n)) a-sum-quotient-exists]
                      @the-negation-divides-meaning |
                        dividesIntegrally(s,
                          rational.neg(
                          qpoly.qclearedSum(p, r, s, n))) iff
                          (exists k2: Q; isInteger(k2) and
                          rational.neg(
                          qpoly.qclearedSum(p, r, s, n)) =
                          rational.mul(s, k2))
                        [using specialize dividesIntegrallyMeaning(s, rational.neg(qpoly.qclearedSum(p, r, s, n)))]
                      @the-negation-divides-too |
                        dividesIntegrally(s,
                          rational.neg(qpoly.qclearedSum(p, r, s, n)))
                        [using tautology the-negation-divides-meaning a-negated-quotient-exists]
                      @the-leading-term-is-the-negation |
                        rational.mul(qpoly.qcoeff(p, n),
                          qpoly.qpower(r, n)) =
                          rational.neg(
                          qpoly.qclearedSum(p, r, s, n))
                        [using specialize rational_integer_division.theOtherSummandIsTheNegation(qpoly.qclearedSum(p, r, s, n), rational.mul(qpoly.qcoeff(p, n), qpoly.qpower(r, n))) the-cofactor-vanishes]
                      @s-divides-the-leading-term |
                        dividesIntegrally(s,
                          rational.mul(qpoly.qcoeff(p, n),
                          qpoly.qpower(r, n)))
                        [by rewrite the-leading-term-is-the-negation the-negation-divides-too]
                      // r^n · a_n, so the coprime-power induction applies with v = r
                      @the-commuted-product |
                        rational.mul(qpoly.qcoeff(p, n),
                          qpoly.qpower(r, n)) =
                          rational.mul(qpoly.qpower(r, n),
                          qpoly.qcoeff(p, n))
                        [using specialize rational.mulIsCommutative(qpoly.qcoeff(p, n), qpoly.qpower(r, n))]
                      @s-divides-the-commuted |
                        dividesIntegrally(s,
                          rational.mul(qpoly.qpower(r, n),
                          qpoly.qcoeff(p, n)))
                        [by rewrite the-commuted-product s-divides-the-leading-term]
                      // Bézout for (s, r): the coprimality is symmetric in the
                      // quantified reading, so it feeds with the roles swapped
                      @the-certificate-exists |
                        exists s2, r2: Q; isInteger(s2) and
                          isInteger(r2) and
                          rational.add(rational.mul(s, s2),
                          rational.mul(r, r2)) = ONE
                        [using specialize rational_integer_division.bezoutOnTheCutSwapped(s, r) s-is-an-integer r-is-an-integer r-is-positive the-coprimality]
                      @conclusion-with-the-certificate |
                        unpack cs: Q from the-certificate-exists {
                          @the-r-coefficient-exists |
                            exists r2: Q; isInteger(cs) and
                              isInteger(r2) and
                              rational.add(rational.mul(s, cs),
                              rational.mul(r, r2)) = ONE
                            [by hypothesis conclusion-with-the-certificate]
                          @conclusion-with-both |
                            unpack cr: Q from the-r-coefficient-exists {
                              @the-certificate-parts |
                                isInteger(cs) and isInteger(cr) and
                                  rational.add(
                                  rational.mul(s, cs),
                                  rational.mul(r, cr)) = ONE
                                [by hypothesis conclusion-with-both]
                              @cs-is-an-integer |
                                isInteger(cs)
                                [using tautology the-certificate-parts]
                              @cr-is-an-integer |
                                isInteger(cr)
                                [using tautology the-certificate-parts]
                              @the-certificate |
                                rational.add(rational.mul(s, cs),
                                  rational.mul(r, cr)) = ONE
                                [using tautology the-certificate-parts]
                              @the-stripping |
                                forall k: Nat; forall w: Q;
                                  isInteger(w) ->
                                  dividesIntegrally(s,
                                  rational.mul(
                                  qpoly.qpower(r, k), w)) ->
                                  dividesIntegrally(s, w)
                                [using specialize coprimeToAPowerDividesTheCofactor(s, r, cs, cr) s-is-an-integer r-is-an-integer cs-is-an-integer cr-is-an-integer the-certificate]
                              @the-leading-coefficient-is-an-integer |
                                isInteger(qpoly.qcoeff(p, n))
                                [using specialize the-coefficients-are-integers(n)]
                              @conclusion-s-divides-the-leading |
                                dividesIntegrally(s,
                                  qpoly.qcoeff(p, n))
                                [using specialize the-stripping(n, qpoly.qcoeff(p, n)) the-leading-coefficient-is-an-integer s-divides-the-commuted]
                            }
                          @the-both-exported |
                            dividesIntegrally(s,
                              qpoly.qcoeff(p, n))
                            [by unpacked conclusion-with-both]
                        }
                      @the-certificate-exported |
                        dividesIntegrally(s, qpoly.qcoeff(p, n))
                        [by unpacked conclusion-with-the-certificate]
                    }
                  @the-implication |
                    (isInteger(r) and isInteger(s) and
                      less_than(ZERO, r) and rational.nonzero(s) and
                      (forall i: Nat;
                      isInteger(qpoly.qcoeff(p, i))) and
                      qpoly.arePairwiseRelativelyPrime(r, s) and
                      qpoly.qclearedSum(p, r, s,
                      nat_succ(n)) = ZERO) ->
                      dividesIntegrally(s, qpoly.qcoeff(p, n))
                    [by discharge given-the-setup]
                  @curried |
                    isInteger(r) -> isInteger(s) ->
                      less_than(ZERO, r) -> rational.nonzero(s) ->
                      (forall i: Nat;
                      isInteger(qpoly.qcoeff(p, i))) ->
                      qpoly.arePairwiseRelativelyPrime(r, s) ->
                      qpoly.qclearedSum(p, r, s,
                      nat_succ(n)) = ZERO ->
                      dividesIntegrally(s, qpoly.qcoeff(p, n))
                    [using tautology the-implication]
                }
              @discharge-n |
                forall n9: Nat;
                  isInteger(r) -> isInteger(s) ->
                  less_than(ZERO, r) -> rational.nonzero(s) ->
                  (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
                  qpoly.arePairwiseRelativelyPrime(r, s) ->
                  qpoly.qclearedSum(p, r, s, nat_succ(n9)) = ZERO ->
                  dividesIntegrally(s, qpoly.qcoeff(p, n9))
                [by generalize generalize-n]
            }
          @discharge-s |
            forall s9: Q; forall n9: Nat;
              isInteger(r) -> isInteger(s9) ->
              less_than(ZERO, r) -> rational.nonzero(s9) ->
              (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
              qpoly.arePairwiseRelativelyPrime(r, s9) ->
              qpoly.qclearedSum(p, r, s9, nat_succ(n9)) = ZERO ->
              dividesIntegrally(s9, qpoly.qcoeff(p, n9))
            [by generalize generalize-s]
        }
      @discharge-r |
        forall r9, s9: Q; forall n9: Nat;
          isInteger(r9) -> isInteger(s9) ->
          less_than(ZERO, r9) -> rational.nonzero(s9) ->
          (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
          qpoly.arePairwiseRelativelyPrime(r9, s9) ->
          qpoly.qclearedSum(p, r9, s9, nat_succ(n9)) = ZERO ->
          dividesIntegrally(s9, qpoly.qcoeff(p, n9))
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: qpoly.QPoly; forall r, s: Q; forall n: Nat;
      isInteger(r) -> isInteger(s) -> less_than(ZERO, r) ->
      rational.nonzero(s) ->
      (forall i: Nat; isInteger(qpoly.qcoeff(p, i))) ->
      qpoly.arePairwiseRelativelyPrime(r, s) ->
      qpoly.qclearedSum(p, r, s, nat_succ(n)) = ZERO ->
      dividesIntegrally(s, qpoly.qcoeff(p, n))
    [by generalize generalize-p]
qed

// -- EUCLID'S LEMMA FOR A PRIME ------------------------------------------------------------
// "p prime and p | a·b implies p | a or p | b." The standard route: if p misses a, then p and
// a are coprime (`coprimalityFromPrimalityOnTheCut`), Bézout gives a certificate, and
// `euclidFromBezoutOnTheCut` strips a to leave p | b.
//
// This is what Eisenstein's sign argument turns on, and it is why primality on the cut was
// worth defining the irreducibility way: the product property is a THEOREM here, not an axiom.
theorem aPrimeDividingAProductDividesAFactor: forall p, a, b: Q;
  isInteger(p) -> isInteger(a) -> isInteger(b) ->
  less_than(ZERO, p) ->
  rational_integer_division.isPrimeOnTheCut(p) ->
  dividesIntegrally(p, rational.mul(a, b)) ->
  (dividesIntegrally(p, a) or dividesIntegrally(p, b))
proof
  @generalize-p |
    fix p: Q {
      @generalize-a |
        fix a: Q {
          @generalize-b |
            fix b: Q {
              @given-the-setup |
                assume isInteger(p) and isInteger(a) and
                  isInteger(b) and less_than(ZERO, p) and
                  rational_integer_division.isPrimeOnTheCut(p) and
                  dividesIntegrally(p, rational.mul(a, b)) {
                  @the-setup |
                    isInteger(p) and isInteger(a) and
                      isInteger(b) and less_than(ZERO, p) and
                      rational_integer_division.isPrimeOnTheCut(p) and
                      dividesIntegrally(p, rational.mul(a, b))
                    [by hypothesis given-the-setup]
                  @p-is-an-integer |
                    isInteger(p)
                    [using tautology the-setup]
                  @a-is-an-integer |
                    isInteger(a)
                    [using tautology the-setup]
                  @b-is-an-integer |
                    isInteger(b)
                    [using tautology the-setup]
                  @p-is-positive |
                    less_than(ZERO, p)
                    [using tautology the-setup]
                  @p-is-prime |
                    rational_integer_division.isPrimeOnTheCut(p)
                    [using tautology the-setup]
                  @p-divides-the-product |
                    dividesIntegrally(p, rational.mul(a, b))
                    [using tautology the-setup]
                  // either p divides a, or it misses a and then divides b
                  @the-division-split |
                    dividesIntegrally(p, a) or
                      (not dividesIntegrally(p, a))
                    [using tautology]
                  @conclusion-one-or-the-other |
                    dividesIntegrally(p, a) or dividesIntegrally(p, b)
                    case the-division-split {
                      @when-p-divides-a |
                        assume dividesIntegrally(p, a) {
                          @p-divides-a |
                            dividesIntegrally(p, a)
                            [by hypothesis when-p-divides-a]
                          @conclusion-left |
                            dividesIntegrally(p, a) or
                              dividesIntegrally(p, b)
                            [using tautology p-divides-a]
                        }
                      // p misses a: coprime, so Bézout, so Euclid strips a
                      @when-p-misses-a |
                        assume not dividesIntegrally(p, a) {
                          @p-misses-a |
                            not dividesIntegrally(p, a)
                            [by hypothesis when-p-misses-a]
                          // unfold to the raw existential the primality
                          // layer speaks in
                          @the-a-divides-meaning |
                            dividesIntegrally(p, a) iff
                              (exists k: Q; isInteger(k) and
                              a = rational.mul(p, k))
                            [using specialize dividesIntegrallyMeaning(p, a)]
                          @p-misses-a-raw |
                            not (exists k: Q; isInteger(k) and
                              a = rational.mul(p, k))
                            [using tautology the-a-divides-meaning p-misses-a]
                          @the-coprimality |
                            forall e: Q; isInteger(e) ->
                              (exists k: Q; isInteger(k) and
                              p = rational.mul(e, k)) ->
                              (exists k: Q; isInteger(k) and
                              a = rational.mul(e, k)) ->
                              (exists k: Q; isInteger(k) and
                              ONE = rational.mul(e, k))
                            [using specialize rational_integer_division.coprimalityFromPrimalityOnTheCut(p, a) p-is-an-integer a-is-an-integer p-is-prime p-misses-a-raw]
                          @the-certificate-exists |
                            exists r, s: Q; isInteger(r) and
                              isInteger(s) and
                              rational.add(rational.mul(p, r),
                              rational.mul(a, s)) = ONE
                            [using specialize rational_integer_division.bezoutOnTheCut(p, a) p-is-an-integer a-is-an-integer p-is-positive the-coprimality]
                          @with-the-certificate |
                            unpack r: Q from the-certificate-exists {
                              @the-s-exists |
                                exists s: Q; isInteger(r) and
                                  isInteger(s) and
                                  rational.add(rational.mul(p, r),
                                  rational.mul(a, s)) = ONE
                                [by hypothesis with-the-certificate]
                              @with-both |
                                unpack s: Q from the-s-exists {
                                  @the-certificate-parts |
                                    isInteger(r) and isInteger(s) and
                                      rational.add(
                                      rational.mul(p, r),
                                      rational.mul(a, s)) = ONE
                                    [by hypothesis with-both]
                                  @r-is-an-integer |
                                    isInteger(r)
                                    [using tautology the-certificate-parts]
                                  @s-is-an-integer |
                                    isInteger(s)
                                    [using tautology the-certificate-parts]
                                  @the-certificate |
                                    rational.add(rational.mul(p, r),
                                      rational.mul(a, s)) = ONE
                                    [using tautology the-certificate-parts]
                                  @conclusion-p-divides-b |
                                    dividesIntegrally(p, b)
                                    [using specialize euclidFromBezoutOnTheCut(p, a, b, r, s) p-is-an-integer a-is-an-integer b-is-an-integer r-is-an-integer s-is-an-integer the-certificate p-divides-the-product]
                                }
                              @the-inner-exported |
                                dividesIntegrally(p, b)
                                [by unpacked with-both]
                            }
                          @p-divides-b |
                            dividesIntegrally(p, b)
                            [by unpacked with-the-certificate]
                          @conclusion-right |
                            dividesIntegrally(p, a) or
                              dividesIntegrally(p, b)
                            [using tautology p-divides-b]
                        }
                    }
                }
              @the-implication |
                (isInteger(p) and isInteger(a) and
                  isInteger(b) and less_than(ZERO, p) and
                  rational_integer_division.isPrimeOnTheCut(p) and
                  dividesIntegrally(p, rational.mul(a, b))) ->
                  (dividesIntegrally(p, a) or
                  dividesIntegrally(p, b))
                [by discharge given-the-setup]
              @curried |
                isInteger(p) -> isInteger(a) -> isInteger(b) ->
                  less_than(ZERO, p) ->
                  rational_integer_division.isPrimeOnTheCut(p) ->
                  dividesIntegrally(p, rational.mul(a, b)) ->
                  (dividesIntegrally(p, a) or
                  dividesIntegrally(p, b))
                [using tautology the-implication]
            }
          @discharge-b |
            forall b9: Q;
              isInteger(p) -> isInteger(a) -> isInteger(b9) ->
              less_than(ZERO, p) ->
              rational_integer_division.isPrimeOnTheCut(p) ->
              dividesIntegrally(p, rational.mul(a, b9)) ->
              (dividesIntegrally(p, a) or dividesIntegrally(p, b9))
            [by generalize generalize-b]
        }
      @discharge-a |
        forall a9, b9: Q;
          isInteger(p) -> isInteger(a9) -> isInteger(b9) ->
          less_than(ZERO, p) ->
          rational_integer_division.isPrimeOnTheCut(p) ->
          dividesIntegrally(p, rational.mul(a9, b9)) ->
          (dividesIntegrally(p, a9) or dividesIntegrally(p, b9))
        [by generalize generalize-a]
    }
  @conclusion |
    forall p, a, b: Q;
      isInteger(p) -> isInteger(a) -> isInteger(b) ->
      less_than(ZERO, p) ->
      rational_integer_division.isPrimeOnTheCut(p) ->
      dividesIntegrally(p, rational.mul(a, b)) ->
      (dividesIntegrally(p, a) or dividesIntegrally(p, b))
    [by generalize generalize-p]
qed

// A product of divisors divides the product: d | m and e | n give d·e | m·n, by multiplying
// the two quotients.
theorem theProductOfDivisorsDividesTheProduct: forall d, e, m, n: Q;
  dividesIntegrally(d, m) -> dividesIntegrally(e, n) ->
  dividesIntegrally(rational.mul(d, e), rational.mul(m, n))
proof
  @generalize-d |
    fix d: Q {
      @generalize-e |
        fix e: Q {
          @generalize-m |
            fix m: Q {
              @generalize-n |
                fix n: Q {
                  @given-both |
                    assume dividesIntegrally(d, m) and
                      dividesIntegrally(e, n) {
                      @both |
                        dividesIntegrally(d, m) and
                          dividesIntegrally(e, n)
                        [by hypothesis given-both]
                      @d-divides-m |
                        dividesIntegrally(d, m)
                        [by and_lhs both]
                      @e-divides-n |
                        dividesIntegrally(e, n)
                        [by and_rhs both]
                      @the-m-meaning |
                        dividesIntegrally(d, m) iff
                          (exists k: Q; isInteger(k) and
                          m = rational.mul(d, k))
                        [using specialize dividesIntegrallyMeaning(d, m)]
                      @an-m-quotient-exists |
                        exists k: Q; isInteger(k) and
                          m = rational.mul(d, k)
                        [using tautology the-m-meaning d-divides-m]
                      @the-n-meaning |
                        dividesIntegrally(e, n) iff
                          (exists k: Q; isInteger(k) and
                          n = rational.mul(e, k))
                        [using specialize dividesIntegrallyMeaning(e, n)]
                      @an-n-quotient-exists |
                        exists k: Q; isInteger(k) and
                          n = rational.mul(e, k)
                        [using tautology the-n-meaning e-divides-n]
                      @with-the-m-quotient |
                        unpack km: Q from an-m-quotient-exists {
                          @the-m-quotient |
                            isInteger(km) and
                              m = rational.mul(d, km)
                            [by hypothesis with-the-m-quotient]
                          @km-is-an-integer |
                            isInteger(km)
                            [by and_lhs the-m-quotient]
                          @m-factors |
                            m = rational.mul(d, km)
                            [by and_rhs the-m-quotient]
                          @with-the-n-quotient |
                            unpack kn: Q from an-n-quotient-exists {
                              @the-n-quotient |
                                isInteger(kn) and
                                  n = rational.mul(e, kn)
                                [by hypothesis with-the-n-quotient]
                              @kn-is-an-integer |
                                isInteger(kn)
                                [by and_lhs the-n-quotient]
                              @n-factors |
                                n = rational.mul(e, kn)
                                [by and_rhs the-n-quotient]
                              @the-quotient-product-is-an-integer |
                                isInteger(rational.mul(km, kn))
                                [using specialize rational.isIntegerMul(km, kn) km-is-an-integer kn-is-an-integer]
                              @the-regrouping |
                                rational.mul(rational.mul(d, km),
                                  rational.mul(e, kn)) =
                                  rational.mul(
                                  rational.mul(d, e),
                                  rational.mul(km, kn))
                                [using polynomial(rational)]
                              @the-product-at-m |
                                rational.mul(m, n) =
                                  rational.mul(rational.mul(d, km),
                                  n)
                                [by rewrite m-factors]
                              @the-product-at-both |
                                rational.mul(m, n) =
                                  rational.mul(rational.mul(d, km),
                                  rational.mul(e, kn))
                                [by rewrite n-factors the-product-at-m]
                              @the-product-regrouped |
                                rational.mul(m, n) =
                                  rational.mul(
                                  rational.mul(d, e),
                                  rational.mul(km, kn))
                                [by rewrite the-regrouping the-product-at-both]
                              @the-quotient-works |
                                isInteger(rational.mul(km, kn)) and
                                  rational.mul(m, n) =
                                  rational.mul(
                                  rational.mul(d, e),
                                  rational.mul(km, kn))
                                [by both the-quotient-product-is-an-integer the-product-regrouped]
                              @a-quotient-exists |
                                exists k: Q; isInteger(k) and
                                  rational.mul(m, n) =
                                  rational.mul(
                                  rational.mul(d, e), k)
                                [by witness(rational.mul(km, kn)) the-quotient-works]
                              @the-product-meaning |
                                dividesIntegrally(
                                  rational.mul(d, e),
                                  rational.mul(m, n)) iff
                                  (exists k: Q; isInteger(k) and
                                  rational.mul(m, n) =
                                  rational.mul(
                                  rational.mul(d, e), k))
                                [using specialize dividesIntegrallyMeaning(rational.mul(d, e), rational.mul(m, n))]
                              @conclusion-the-product-divides |
                                dividesIntegrally(
                                  rational.mul(d, e),
                                  rational.mul(m, n))
                                [using tautology the-product-meaning a-quotient-exists]
                            }
                          @the-n-exported |
                            dividesIntegrally(rational.mul(d, e),
                              rational.mul(m, n))
                            [by unpacked with-the-n-quotient]
                        }
                      @the-m-exported |
                        dividesIntegrally(rational.mul(d, e),
                          rational.mul(m, n))
                        [by unpacked with-the-m-quotient]
                    }
                  @the-implication |
                    (dividesIntegrally(d, m) and
                      dividesIntegrally(e, n)) ->
                      dividesIntegrally(rational.mul(d, e),
                      rational.mul(m, n))
                    [by discharge given-both]
                  @curried |
                    dividesIntegrally(d, m) ->
                      dividesIntegrally(e, n) ->
                      dividesIntegrally(rational.mul(d, e),
                      rational.mul(m, n))
                    [using tautology the-implication]
                }
              @discharge-n |
                forall n9: Q;
                  dividesIntegrally(d, m) ->
                  dividesIntegrally(e, n9) ->
                  dividesIntegrally(rational.mul(d, e),
                  rational.mul(m, n9))
                [by generalize generalize-n]
            }
          @discharge-m |
            forall m9, n9: Q;
              dividesIntegrally(d, m9) ->
              dividesIntegrally(e, n9) ->
              dividesIntegrally(rational.mul(d, e),
              rational.mul(m9, n9))
            [by generalize generalize-m]
        }
      @discharge-e |
        forall e9: Q; forall m9, n9: Q;
          dividesIntegrally(d, m9) ->
          dividesIntegrally(e9, n9) ->
          dividesIntegrally(rational.mul(d, e9),
          rational.mul(m9, n9))
        [by generalize generalize-e]
    }
  @conclusion |
    forall d, e, m, n: Q;
      dividesIntegrally(d, m) -> dividesIntegrally(e, n) ->
      dividesIntegrally(rational.mul(d, e), rational.mul(m, n))
    [by generalize generalize-d]
qed

// -- EISENSTEIN'S SIGN ARGUMENT ------------------------------------------------------------
// Judson's `p | a_0` with `p² ∤ a_0` is what produces "p misses a coefficient of one factor".
// Writing `a_0 = b_0 c_0`, primality gives `p | b_0` or `p | c_0`; and p² missing the product
// rules out BOTH, since p dividing each would make p² divide their product.
//
// So exactly one of them survives — and that survivor is the coefficient Eisenstein's
// reduction argument needs the prime to miss.
theorem thePrimeMissesOneConstantFactor: forall p, b, c: Q;
  isInteger(p) -> isInteger(b) -> isInteger(c) ->
  less_than(ZERO, p) ->
  rational_integer_division.isPrimeOnTheCut(p) ->
  dividesIntegrally(p, rational.mul(b, c)) ->
  (not dividesIntegrally(rational.mul(p, p), rational.mul(b, c))) ->
  ((not dividesIntegrally(p, b)) or (not dividesIntegrally(p, c)))
proof
  @generalize-p |
    fix p: Q {
      @generalize-b |
        fix b: Q {
          @generalize-c |
            fix c: Q {
              @given-the-setup |
                assume isInteger(p) and isInteger(b) and
                  isInteger(c) and less_than(ZERO, p) and
                  rational_integer_division.isPrimeOnTheCut(p) and
                  dividesIntegrally(p, rational.mul(b, c)) and
                  (not dividesIntegrally(rational.mul(p, p),
                  rational.mul(b, c))) {
                  @the-setup |
                    isInteger(p) and isInteger(b) and
                      isInteger(c) and less_than(ZERO, p) and
                      rational_integer_division.isPrimeOnTheCut(p) and
                      dividesIntegrally(p, rational.mul(b, c)) and
                      (not dividesIntegrally(rational.mul(p, p),
                      rational.mul(b, c)))
                    [by hypothesis given-the-setup]
                  @p-squared-misses |
                    not dividesIntegrally(rational.mul(p, p),
                      rational.mul(b, c))
                    [using tautology the-setup]
                  // if p divided BOTH, p² would divide the product
                  @given-both-divisible |
                    assume dividesIntegrally(p, b) and
                      dividesIntegrally(p, c) {
                      @both-divisible |
                        dividesIntegrally(p, b) and
                          dividesIntegrally(p, c)
                        [by hypothesis given-both-divisible]
                      @p-divides-b |
                        dividesIntegrally(p, b)
                        [by and_lhs both-divisible]
                      @p-divides-c |
                        dividesIntegrally(p, c)
                        [by and_rhs both-divisible]
                      @p-squared-divides |
                        dividesIntegrally(rational.mul(p, p),
                          rational.mul(b, c))
                        [using specialize theProductOfDivisorsDividesTheProduct(p, p, b, c) p-divides-b p-divides-c]
                    }
                  @not-both-divisible |
                    not (dividesIntegrally(p, b) and
                      dividesIntegrally(p, c))
                    [by contradiction given-both-divisible p-squared-divides p-squared-misses]
                  @conclusion-one-survives |
                    (not dividesIntegrally(p, b)) or
                      (not dividesIntegrally(p, c))
                    [using tautology not-both-divisible]
                }
              @the-implication |
                (isInteger(p) and isInteger(b) and
                  isInteger(c) and less_than(ZERO, p) and
                  rational_integer_division.isPrimeOnTheCut(p) and
                  dividesIntegrally(p, rational.mul(b, c)) and
                  (not dividesIntegrally(rational.mul(p, p),
                  rational.mul(b, c)))) ->
                  ((not dividesIntegrally(p, b)) or
                  (not dividesIntegrally(p, c)))
                [by discharge given-the-setup]
              @curried |
                isInteger(p) -> isInteger(b) -> isInteger(c) ->
                  less_than(ZERO, p) ->
                  rational_integer_division.isPrimeOnTheCut(p) ->
                  dividesIntegrally(p, rational.mul(b, c)) ->
                  (not dividesIntegrally(rational.mul(p, p),
                  rational.mul(b, c))) ->
                  ((not dividesIntegrally(p, b)) or
                  (not dividesIntegrally(p, c)))
                [using tautology the-implication]
            }
          @discharge-c |
            forall c9: Q;
              isInteger(p) -> isInteger(b) -> isInteger(c9) ->
              less_than(ZERO, p) ->
              rational_integer_division.isPrimeOnTheCut(p) ->
              dividesIntegrally(p, rational.mul(b, c9)) ->
              (not dividesIntegrally(rational.mul(p, p),
              rational.mul(b, c9))) ->
              ((not dividesIntegrally(p, b)) or
              (not dividesIntegrally(p, c9)))
            [by generalize generalize-c]
        }
      @discharge-b |
        forall b9, c9: Q;
          isInteger(p) -> isInteger(b9) -> isInteger(c9) ->
          less_than(ZERO, p) ->
          rational_integer_division.isPrimeOnTheCut(p) ->
          dividesIntegrally(p, rational.mul(b9, c9)) ->
          (not dividesIntegrally(rational.mul(p, p),
          rational.mul(b9, c9))) ->
          ((not dividesIntegrally(p, b9)) or
          (not dividesIntegrally(p, c9)))
        [by generalize generalize-b]
    }
  @conclusion |
    forall p, b, c: Q;
      isInteger(p) -> isInteger(b) -> isInteger(c) ->
      less_than(ZERO, p) ->
      rational_integer_division.isPrimeOnTheCut(p) ->
      dividesIntegrally(p, rational.mul(b, c)) ->
      (not dividesIntegrally(rational.mul(p, p), rational.mul(b, c))) ->
      ((not dividesIntegrally(p, b)) or (not dividesIntegrally(p, c)))
    [by generalize generalize-p]
qed
