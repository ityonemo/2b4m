// std/rational/polynomial.b4m — ℚ[x], WITH INTEGER COEFFICIENTS NAMEABLE.
//
// Judson's §17.3 Lemma 17.12 needs one polynomial seen over ℚ *and* over ℤ: it rewrites a
// rational-coefficient p(x) as (r/s) times an integer-coefficient polynomial. That needs a
// polynomial sort whose coefficients are ℚ, where `isInteger` can pick out the integer ones.
//
// HOW THIS RELATES TO std/field/polynomial.b4m. That file's F[x] is over an opaque field, so
// it cannot say "this coefficient is an integer" — ℚ's `isInteger` has no counterpart in an
// abstract F. ℚ[x] is therefore its OWN sort here, and F[x]'s corpus is transferred onto it
// by `RationalPolynomials` below. What makes that work is mapping the whole POLYNOMIAL layer
// (`Poly`, `coeff`, `ZEROP`, the operations), not just the coefficient field: a transfer
// re-checks the source PROOF, and those proofs mention `coeff`, whose result sort is F.
// Mapping only the field leaves `coeff` at the abstract sort and the transfer fails with
// `expected sort 'Q', got 'Field'`.
//
// Each axiom of F[x] that a transferred proof reaches must be restated here and discharged.
// They are restated as axioms rather than derived because they are ℚ[x]'s own primitives —
// the same posture std/field/polynomial.b4m takes toward its own coefficient equations.
//
// NOTE the transfers CHAIN: a theorem of F[x] that is itself proved by
// `model(FieldPolyModelsRingPoly)` re-checks that inner transfer when carried here, and so
// demands std/ring/polynomial.b4m's layer too. Theorems proved DIRECTLY in F[x] travel with
// only what is mapped below.
theory fieldpoly <<< "std/field/polynomial.b4m"
theory rational <<< "std/rational.b4m"
theory peano <<< "std/peano.b4m"
theory ring <<< "std/ring.b4m"
theory ring_poly <<< "std/ring/polynomial.b4m"
theory ring_mono <<< "std/ring/polynomial/monomial.b4m"
theory ring_leading <<< "std/ring/polynomial/leading.b4m"

sort Q = rational.Q
sort Nat = peano.Nat
const NAT_ZERO = peano.ZERO
const ZERO = rational.ZERO
pred isInteger = rational.isInteger

// -- ℚ[x] ---------------------------------------------------------------------------------
sort QPoly
oper qcoeff(p: QPoly, i: Nat) => Q
const QZEROP: QPoly
oper qaddP(p: QPoly, q: QPoly) => QPoly:
  qcoeff(qaddP(p, q), i) = rational.add(qcoeff(p, i), qcoeff(q, i)).
  existence: aQaddPExists,
  uniqueness: qPolyExtensionality
oper qnegP(p: QPoly) => QPoly:
  qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i)).
  existence: aQnegPExists,
  uniqueness: qPolyExtensionality
oper qmulP(p: QPoly, q: QPoly) => QPoly:
  qcoeff(qmulP(p, q), i) = qconvolution(p, q, NAT_ZERO, i).
  existence: aQmulPExists,
  uniqueness: qPolyExtensionality
oper qmonomial(a: Q, k: Nat) => QPoly:
  qcoeff(qmonomial(a, k), k) = a;
  (not (i = k)) -> qcoeff(qmonomial(a, k), i) = ZERO.
  existence: aQmonomialExists,
  uniqueness: qPolyExtensionality
// the degree layer, restated over ℚ exactly as F[x] states it — needed for Gauss's monic
// bookkeeping, which reads off leading coefficients.
pred qdegreeAtMost(p: QPoly, n: Nat)
oper qdegree(p: QPoly) => Nat
// the convolution, so multiplication has a COEFFICIENT LAW here. `qmulP` was declared and
// mapped into F[x] but its coefficient behaviour never was, so `qcoeff(qmulP(p, q), i)` was
// opaque — nothing could be proved about a product's coefficients. This is the FIFTH
// restatement of the same convolution recursion in std (R[x], F[x], ℤ_p[x], ℤ[x], here),
// which is the duplication a generic polynomial theory removes; see
// `drafts/algebra-layering/README.md`.
// Descends by `peano.prev` on the SECOND index rather than matching `succ` on the left:
// the l-value rule requires a recursive definition's l-value arguments to be parameters
// or closed terms, so the descent must be readable on the RIGHT. The arm's own
// `m != NAT_ZERO` discharges `prev`'s guard. `m` descends while `j` ascends; termination
// asks only about the descent.
oper qconvolution(p: QPoly, q: QPoly, j: Nat, m: Nat) => Q:
  qconvolution(p, q, j, NAT_ZERO) = rational.mul(qcoeff(p, j), qcoeff(q, NAT_ZERO));
  qconvolution(p, q, j, m) = rational.add(rational.mul(qcoeff(p, j), qcoeff(q, m)), qconvolution(p, q, peano.succ(j), peano.prev(m))) when m != NAT_ZERO.
  termination(peano): _, {qConvolutionIsGrounded, qconvolutionGrounded}

// the coefficient equations: ℚ[x]'s own primitives
axiom qPolyExtensionality: forall p, q: QPoly;
  (forall i: Nat; qcoeff(p, i) = qcoeff(q, i)) -> p = q

axiom aQaddPExists: forall p: QPoly; forall q: QPoly;
  exists r: QPoly; forall i: Nat; (qcoeff(r, i) = rational.add(qcoeff(p, i), qcoeff(q, i)))
axiom aQnegPExists: forall p: QPoly;
  exists r: QPoly; forall i: Nat; (qcoeff(r, i) = rational.neg(qcoeff(p, i)))
axiom aQmulPExists: forall p: QPoly; forall q: QPoly;
  exists r: QPoly; forall i: Nat; (qcoeff(r, i) = qconvolution(p, q, NAT_ZERO, i))
axiom aQmonomialExists: forall a: Q; forall k: Nat;
  exists r: QPoly; ((qcoeff(r, k) = a)) and (forall i: Nat; ((not (i = k)) -> qcoeff(r, i) = ZERO))
axiom qZeroPolyCoeff: forall i: Nat; qcoeff(QZEROP, i) = ZERO
axiom qDegreeAtMostMeaning: forall p: QPoly; forall n: Nat;
  qdegreeAtMost(p, n) iff
  (forall i: Nat; peano.less_than(n, i) -> qcoeff(p, i) = ZERO)
axiom qDegreeIsALeadingIndex: forall p: QPoly;
  (not (p = QZEROP)) -> (not (qcoeff(p, qdegree(p)) = ZERO))
axiom qDegreeBoundsTheCoefficients: forall p: QPoly;
  (not (p = QZEROP)) -> qdegreeAtMost(p, qdegree(p))

// The same partial sum grown at the BASE rather than the top. `ring_poly` needs it to prove
// `polyMulIsCommutative` — the reversed product's partial sum IS this segment — and a model
// must map every symbol the transferred proof mentions, so ℚ[x] declares it too.
// Binders DECLARED `(j, m)` to match the clauses. They used to read `(i, k)` while the clauses
// wrote `(j, m)` — legal shadowing, but a trap for the `tailConvolution` migration: the
// termination check reads base patterns by SLOT and cannot tell a renamed variable from a
// constant, so a mismatch makes the generated predicate's base branch reflexive and lets the
// obligation be discharged vacuously. The parser now rejects the mismatch outright.
// The recursion descends by `prev` on the FIRST index rather than matching `succ` on the
// left, which the l-value rule requires of a recursive definition — every l-value argument
// must be a parameter or a closed term, so the descent has to be readable on the RIGHT.
// `peano.prev` is guarded (`requires n != ZERO`) and the arm's own `j != NAT_ZERO` discharges it.
//
// Mirror of `qconvolution`: there the second index descends and the first ascends, here the
// first descends and the second ascends. Termination asks only about the DESCENDING index.
oper qtailConvolution(p: QPoly, q: QPoly, j: Nat, m: Nat) => Q:
  qtailConvolution(p, q, NAT_ZERO, m) = rational.mul(qcoeff(p, NAT_ZERO), qcoeff(q, m));
  qtailConvolution(p, q, j, m) = rational.add(rational.mul(qcoeff(p, j), qcoeff(q, m)), qtailConvolution(p, q, peano.prev(j), peano.succ(m))) when j != NAT_ZERO.
  termination(peano): _, {qTailConvolutionIsGrounded, qtailConvolutionGrounded}

// And the two-bound generalization `ring_poly` inducts on: the n+1 terms starting at index m,
// grown at the top. Same reason it is here — a transferred proof mentions it.
// `n` IS THE LENGTH and the only descent; `j` and `c` are exponents that RIDE in the
// payload. See the ring layer for the full reasoning.
oper qsegment(p: QPoly, q: QPoly, j: Nat, c: Nat, n: Nat) => Q:
  qsegment(p, q, j, c, NAT_ZERO) = rational.mul(qcoeff(p, j), qcoeff(q, c));
  qsegment(p, q, j, c, n) = rational.add(rational.mul(qcoeff(p, j), qcoeff(q, c)), qsegment(p, q, peano.prev(j), peano.succ(c), peano.prev(n))) when n != NAT_ZERO.
  termination(peano): _, {qsegmentIsGrounded, qsegmentGrounded}

// the bottom-up capped run, mirror of `qsegment`
// the mirror: the FIRST exponent rides up and the SECOND rides down, while `n` is the
// LENGTH and the only descent. See the ring layer for the full reasoning.
oper qrsegment(p: QPoly, q: QPoly, j: Nat, c: Nat, n: Nat) => Q:
  qrsegment(p, q, j, c, NAT_ZERO) = rational.mul(qcoeff(p, j), qcoeff(q, c));
  qrsegment(p, q, j, c, n) = rational.add(rational.mul(qcoeff(p, j), qcoeff(q, c)), qrsegment(p, q, peano.succ(j), peano.prev(c), peano.prev(n))) when n != NAT_ZERO.
  termination(peano): _, {qrsegmentIsGrounded, qrsegmentGrounded}

axiom integerCoefficientsMeaning: forall p: QPoly; forall n: Nat;
  hasIntegerCoefficientsUpTo(p, n) iff
  (forall i: Nat; peano.less_than(i, n) -> isInteger(qcoeff(p, i)))

// What this file proves (verified manifest):
intheory theZeroPolynomialHasIntegerCoefficients
intheory qSubPolyCoeff
intheory everyCoefficientIsARatioOfIntegers
intheory anIntegerDividesItself
intheory oneDividesEveryInteger
intheory aScaledIntegerPolynomialIsRational
intheory aMonicPolynomialIsNonzero
intheory theNegationOfANonzeroPolynomialIsNonzero
intheory theNegationsCoefficientFlips
intheory aNonzeroHasNonzeroNegation
intheory theNegationIsBoundedWhereverTheOriginalIs
intheory negationPreservesTheDegree
intheory negatingALeadingMinusOneMakesItMonic
intheory theMonomialShift
intheory scalingByAConstantScalesTheCoefficients
intheory qTheProductsLeadingCoefficient
intheory theNegationIsTheMinusOneScaling
intheory qMulIsCommutative
intheory theNegationPullsOutOfTheProduct
intheory theTwoNegationsCancelInAProduct
intheory aProductsPowerSplits
intheory aPowerCancelsTheReciprocalsPower
intheory clearingTheDenominatorGivesTheClearedSum
intheory everyPowerOfAnIntegerIsAnInteger
intheory theClearedSumSplitsOffTheConstantTerm
intheory theClearedSumSplitsOffTheLeadingTerm
intheory qMulIsAssociative
intheory theConstantMonomialProductAgreesCoefficientwise
intheory theProductOfConstantMonomials
intheory aNonzeroScalingReflectsTheVanishing
intheory aNonzeroScalingReflectsTheDegreeBound
intheory qAddPolyCoeff
intheory qNegPolyCoeff
intheory qMulPolyCoeff
intheory qMonomialCoeffAtItsIndex
intheory qMonomialCoeffElsewhere
intheory qConvolutionZero
intheory qConvolutionSucc
intheory qConvolutionReachesZeroFromAPredecessor
intheory qtripleRowReachesABaseFromAPredecessor
intheory qtripleDiagReachesABaseFromAPredecessor
intheory qtripleTriReachesABaseFromAPredecessor
intheory qtripleRowsReachesABaseFromAPredecessor
intheory qtripleRowsIsGrounded
intheory qtripleTriIsGrounded
intheory qtripleDiagIsGrounded
intheory qtripleRowIsGrounded
intheory qConvolutionIsGrounded
intheory qTailConvolutionZero
intheory qTailConvolutionSucc
intheory qTailConvolutionReachesZeroFromAPredecessor
intheory qTailConvolutionIsGrounded
intheory qSegmentZero
intheory qSegmentSucc
intheory qsegmentReachesABaseFromAPredecessor
intheory qsegmentIsGrounded
intheory qRsegmentZero
intheory qRsegmentSucc
intheory qrsegmentReachesABaseFromAPredecessor
intheory qrsegmentIsGrounded
intheory qpowerReachesABaseFromAPredecessor
intheory qpowerIsGrounded
intheory qevalUpToIsGrounded
intheory qevalUpToReachesABaseFromAPredecessor
intheory qPowerZero
intheory qPowerSucc
intheory qEvalZero
intheory qEvalSucc
intheory qClearedSumZero
intheory qClearedSumSucc
intheory qClearedSumReachesABaseFromAPredecessor
intheory qClearedSumIsGrounded
intheory qmonusAtZero
intheory qmonusSteps
intheory qmonusReachesABaseFromAPredecessor
intheory qmonusIsGrounded
intheory qTheCofactorIndexAtZero
intheory qTheCofactorIndexSteps
intheory qCappedRunZero
intheory qCappedRunSucc
intheory qcappedRunReachesABaseFromAPredecessor
intheory qcappedRunIsGrounded
intheory qTripleTermMeaning
intheory qTripleRowZero
intheory qTripleRowSucc
intheory qTripleDiagZero
intheory qTripleDiagSucc
intheory qTripleTriZero
intheory qTripleTriSucc
intheory qTripleRowsZero
intheory qTripleRowsSucc

axiom integerDecompositionMeaning: forall p, q: QPoly; forall r, s: Q; forall n: Nat;
  isTheIntegerDecomposition(p, q, r, s, n) iff
  (isInteger(r) and isInteger(s) and rational.nonzero(s) and
  hasIntegerCoefficientsUpTo(q, n) and
  coefficientsAreRelativelyPrimeUpTo(q, n) and
  arePairwiseRelativelyPrime(r, s) and
  p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q))

axiom qMonicMeansTheLeadingCoefficientIsOne: forall p: QPoly;
  qIsMonic(p) iff qcoeff(p, qdegree(p)) = rational.ONE

axiom qOnePolyCoeffZero: qcoeff(QONEP, peano.ZERO) = rational.ONE
axiom qOnePolyCoeffHigher: forall i: peano.Nat;
  qcoeff(QONEP, peano.succ(i)) = ZERO

axiom qIsZeroOfMeaning: forall a: Q; forall p: QPoly;
  qIsZeroOf(a, p) iff qevaluate(p, a) = ZERO

// F[x]'s corpus, transferred. The coefficient field AND the polynomial layer both travel.
model RationalPolynomials {
  fieldpoly.F: Q
  fieldpoly.zeroF: ZERO
  fieldpoly.oneF: rational.ONE
  fieldpoly.addF: rational.add
  fieldpoly.mulF: rational.mul
  fieldpoly.negF: rational.neg
  fieldpoly.recipF: rational.recip
  fieldpoly.Poly: QPoly
  fieldpoly.coeff: qcoeff
  fieldpoly.ZEROP: QZEROP
  fieldpoly.addP: qaddP
  fieldpoly.negP: qnegP
  fieldpoly.mulP: qmulP
  fieldpoly.monomial: qmonomial
  fieldpoly.degreeAtMost: qdegreeAtMost
  fieldpoly.degree: qdegree
  fieldpoly.convolution: qconvolution
  fieldpoly.power: qpower
  fieldpoly.evalUpTo: qevalUpTo
  fieldpoly.isZeroOf: qIsZeroOf
  fieldpoly.polyExtensionality <- qPolyExtensionality
  fieldpoly.zeroPolyCoeff <- qZeroPolyCoeff
  fieldpoly.addP <- qaddP
  fieldpoly.negP <- qnegP
  fieldpoly.monomial <- qmonomial
  fieldpoly.degreeAtMostMeaning <- qDegreeAtMostMeaning
  fieldpoly.degreeIsALeadingIndex <- qDegreeIsALeadingIndex
  fieldpoly.degreeBoundsTheCoefficients <- qDegreeBoundsTheCoefficients
  fieldpoly.convolution <- qconvolution
  fieldpoly.mulP <- qmulP
  fieldpoly.power <- qpower
  fieldpoly.evalUpTo <- qevalUpTo
  fieldpoly.isZeroOfMeaning <- qIsZeroOfMeaning
  fieldpoly.mulIsAssociativeF <- rational.mulIsAssociative
  // the ring layer, because F[x] reaches `ring.mulZeroLeft` — a THEOREM, so a transfer
  // re-checks its proof and needs `ring`'s own symbols mapped.
  ring.Ring: Q
  ring.ZERO: ZERO
  ring.ONE: rational.ONE
  ring.add: rational.add
  ring.mul: rational.mul
  ring.neg: rational.neg
  ring.addIsAssociative <- rational.addIsAssociative
  ring.addZeroLeft <- rational.addZeroLeft
  ring.addNegLeft <- rational.addNegLeft
  ring.addIsCommutative <- rational.addIsCommutative
  ring.mulIsAssociative <- rational.mulIsAssociative
  ring.mulAddDistribLeft <- rational.mulAddDistribLeft
  ring.mulAddDistribRight <- rational.mulAddDistribRight
  // The F-LEVEL ALGEBRA FACTS. Re-transferring a theorem whose own proof is a transfer means
  // the outer model must discharge every axiom the INNER proof reaches, not only those its
  // statement mentions — F[x] discharges these onto `ring_poly`, so ℚ[x] must discharge them
  // onto ℚ in turn. Omitting them does not report an undischarged axiom; it surfaces much
  // later as a sort mismatch inside the source theory's own proof.
  fieldpoly.addIsAssociativeF <- rational.addIsAssociative
  fieldpoly.addIsCommutativeF <- rational.addIsCommutative
  fieldpoly.addZeroLeftF <- rational.addZeroLeft
  fieldpoly.addNegLeftF <- rational.addNegLeft
  fieldpoly.mulIsCommutativeF <- rational.mulIsCommutative
  fieldpoly.mulOneLeftF <- rational.mulOneLeft
  fieldpoly.mulAddDistribLeftF <- rational.mulAddDistribLeft
  fieldpoly.mulAddDistribRightF <- rational.mulAddDistribRight
}

// -- integer coefficients -----------------------------------------------------------------

// `hasIntegerCoefficientsUpTo(p, n)` — every coefficient below n is an integer. Bounded
// because Lemma 17.12 works with a polynomial of some stated degree; `isInteger` is ℚ's own
// subring predicate, so no embedding function is involved.
pred hasIntegerCoefficientsUpTo(p: QPoly, n: Nat)
// The zero polynomial has integer coefficients: every one of them is ℚ's NAT_ZERO, which is an
// integer. The first fact a consumer needs, and a check that the layer is wired up.
theorem theZeroPolynomialHasIntegerCoefficients: forall n: Nat;
  hasIntegerCoefficientsUpTo(QZEROP, n)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-i |
        fix i: Nat {
          @the-coefficient-is-zero |
            qcoeff(QZEROP, i) = ZERO
            [using specialize qZeroPolyCoeff(i)]
          @zero-is-an-integer |
            isInteger(ZERO)
            [by cite rational.zeroIsAnInteger]
          @the-coefficient-is-an-integer |
            isInteger(qcoeff(QZEROP, i))
            [by rewrite the-coefficient-is-zero zero-is-an-integer]
          @conclusion-below-n-is-an-integer |
            peano.less_than(i, n) -> isInteger(qcoeff(QZEROP, i))
            [using tautology the-coefficient-is-an-integer]
        }
      @every-coefficient-is-an-integer |
        forall i: Nat;
          peano.less_than(i, n) -> isInteger(qcoeff(QZEROP, i))
        [by generalize generalize-i]
      @the-definition |
        hasIntegerCoefficientsUpTo(QZEROP, n) iff
          (forall i: Nat; peano.less_than(i, n) -> isInteger(qcoeff(QZEROP, i)))
        [using specialize integerCoefficientsMeaning(QZEROP, n)]
      @conclusion-the-zero-polynomial-qualifies |
        hasIntegerCoefficientsUpTo(QZEROP, n)
        [using tautology the-definition every-coefficient-is-an-integer]
    }
  @conclusion |
    forall n: Nat; hasIntegerCoefficientsUpTo(QZEROP, n)
    [by generalize generalize-n]
qed

// -- the transfer in action ----------------------------------------------------------------

// A difference's coefficients, carried over from F[x]'s `subPolyCoeff`. This is the file's
// reason to exist in miniature: a theorem proved once over an abstract coefficient field,
// reused at ℚ without restating its proof. It also exercises the three mapped coefficient
// axioms, which otherwise only the model block touches.
theorem qSubPolyCoeff: forall p, q: QPoly; forall i: Nat;
  qcoeff(qaddP(p, qnegP(q)), i) =
  rational.add(qcoeff(p, i), rational.neg(qcoeff(q, i)))
proof
  @conclusion |
    forall p, q: QPoly; forall i: Nat;
      qcoeff(qaddP(p, qnegP(q)), i) =
      rational.add(qcoeff(p, i), rational.neg(qcoeff(q, i)))
    [using model(RationalPolynomials) fieldpoly.subPolyCoeff]
qed

// NOT transferable without more mapping: `polyAddIsCommutative`. F[x] proves it by its own
// `model(FieldPolyModelsRingPoly)`, so carrying it here re-checks that INNER transfer and
// demands std/ring/polynomial.b4m's layer as well — `expected sort 'Field', got 'Q'`.
// Chained transfers need every link mapped, and this file maps one link. A consumer needing
// the ring laws at ℚ[x] should map `ring_poly`'s layer too, or restate the law directly.

// -- integer representations of coefficients ------------------------------------------------

// Every coefficient of a ℚ[x] polynomial is a ratio of integers — the first line of Judson's
// Lemma 17.12, "suppose p(x) = b_0/c_0 + … + b_n/c_n x^n, where the b_i's and c_i's are
// integers". It is ℚ's fraction axiom read at a coefficient.
theorem everyCoefficientIsARatioOfIntegers: forall p: QPoly; forall i: Nat;
  exists b, c: Q;
  isInteger(b) and isInteger(c) and rational.nonzero(c) and
  qcoeff(p, i) = rational.mul(b, rational.recip(c))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-i |
        fix i: Nat {
          @conclusion-the-coefficient-is-a-ratio |
            exists b, c: Q;
              isInteger(b) and isInteger(c) and rational.nonzero(c) and
              qcoeff(p, i) = rational.mul(b, rational.recip(c))
            [using specialize rational.everyRationalIsAQuotientOfIntegers(qcoeff(p, i))]
        }
      @discharge-i |
        forall i9: Nat;
          exists b, c: Q;
          isInteger(b) and isInteger(c) and rational.nonzero(c) and
          qcoeff(p, i9) = rational.mul(b, rational.recip(c))
        [by generalize generalize-i]
    }
  @conclusion |
    forall p: QPoly; forall i: Nat;
      exists b, c: Q;
      isInteger(b) and isInteger(c) and rational.nonzero(c) and
      qcoeff(p, i) = rational.mul(b, rational.recip(c))
    [by generalize generalize-p]
qed

// -- divisibility and coprimality ON THE CUT ------------------------------------------------
//
// Judson's §17.3 Lemma 17.12 speaks of integers dividing each other and of a family of
// coefficients being relatively prime. Both are expressible DIRECTLY over ℚ's integer cut:
// the cut inherits ℚ's own multiplication, so "d divides n" is an existential over the cut
// and needs none of std/integer/divides.b4m transferred across. (rational.b4m's header makes
// the same point — "there is NO new arithmetic here".)

// `d` divides `n` within the integers of ℚ: some integer quotient.
define dividesOnTheCut(d, n) =
  exists k: Q; isInteger(k) and n = rational.mul(d, k)

// A family of coefficients is RELATIVELY PRIME when every integer dividing all of them
// divides ONE — i.e. is a unit. Stated as a QUANTIFICATION over common divisors rather than
// as a constructed gcd, which is both faithful to "the a_i's are relatively prime" and free
// of any fold: no sequence sort, no gcd function, nothing totalized.
define coefficientsAreRelativelyPrimeUpTo(p, n) =
  forall e: Q;
  isInteger(e) ->
  (forall i: Nat; peano.less_than(i, n) -> dividesOnTheCut(e, qcoeff(p, i))) ->
  dividesOnTheCut(e, rational.ONE)

// Every integer divides itself: the witness is ONE.
theorem anIntegerDividesItself: forall n: Q;
  isInteger(n) -> dividesOnTheCut(n, n)
proof
  @generalize-n |
    fix n: Q {
      @given-n-is-an-integer |
        assume isInteger(n) {
          @one-is-an-integer |
            isInteger(rational.ONE)
            [by cite rational.oneIsAnInteger]
          @n-times-one-is-n |
            rational.mul(n, rational.ONE) = n
            [using specialize rational.mulOneRight(n)]
          @n-is-the-product |
            n = rational.mul(n, rational.ONE)
            [by symmetry n-times-one-is-n]
          @the-witness-works |
            isInteger(rational.ONE) and n = rational.mul(n, rational.ONE)
            [by both one-is-an-integer n-is-the-product]
          @conclusion-n-divides-itself |
            exists k: Q; isInteger(k) and n = rational.mul(n, k)
            [by witness(rational.ONE) the-witness-works]
        }
      @integer-implies-self-divides |
        isInteger(n) -> dividesOnTheCut(n, n)
        [by discharge given-n-is-an-integer]
    }
  @conclusion |
    forall n: Q; isInteger(n) -> dividesOnTheCut(n, n)
    [by generalize generalize-n]
qed

// A unit divides everything, which is the reading `coefficientsAreRelativelyPrimeUpTo` needs
// on its right-hand side: ONE divides any integer.
theorem oneDividesEveryInteger: forall n: Q;
  isInteger(n) -> dividesOnTheCut(rational.ONE, n)
proof
  @generalize-n |
    fix n: Q {
      @given-n-is-an-integer |
        assume isInteger(n) {
          @n-is-an-integer |
            isInteger(n)
            [by hypothesis given-n-is-an-integer]
          @one-times-n-is-n |
            rational.mul(rational.ONE, n) = n
            [using specialize rational.mulOneLeft(n)]
          @n-is-the-product |
            n = rational.mul(rational.ONE, n)
            [by symmetry one-times-n-is-n]
          @the-witness-works |
            isInteger(n) and n = rational.mul(rational.ONE, n)
            [by both n-is-an-integer n-is-the-product]
          @conclusion-one-divides-n |
            exists k: Q; isInteger(k) and n = rational.mul(rational.ONE, k)
            [by witness(n) the-witness-works]
        }
      @integer-implies-one-divides |
        isInteger(n) -> dividesOnTheCut(rational.ONE, n)
        [by discharge given-n-is-an-integer]
    }
  @conclusion |
    forall n: Q; isInteger(n) -> dividesOnTheCut(rational.ONE, n)
    [by generalize generalize-n]
qed

// -- Lemma 17.12 -----------------------------------------------------------------------------
//
// "Let p(x) ∈ ℚ[x]. Then p(x) = (r/s)(a_0 + a_1 x + ⋯ + a_n x^n), where r, s, a_0, …, a_n are
// integers, the a_i's are relatively prime, and r and s are relatively prime."
//
// The scaling by r/s is multiplication by the constant monomial carrying r·s⁻¹, the same way
// std/field/poly-units.b4m treats constants. `s` must be nonzero for the reciprocal to mean
// anything, which his `r/s` presupposes.
//
// EXISTENCE IS NOT PROVED HERE. His construction clears denominators by the product
// c_0 ⋯ c_n over the coefficient index range, divides through by the gcd of the resulting
// numerators, and reduces the leading fraction to lowest terms.
//
// An earlier version of this note said the PRODUCT over the index range "has no relational
// substitute" and that std's folds could not express it. That was WRONG, and measured so:
// `std/integer/product.b4m` has `productUpTo` with a real corpus (`everyEntryDividesProduct`,
// `memberDividesProduct`, `primeFactorExists`), and `std/sequence.b4m` instantiates at ℚ
// cleanly — `sequence.Value: Q` is UNGUARDED, so a ℚ-valued fold and `foldOneCombinesIdentity`
// transfer with no cut composition (probed 2026-10-30).
//
// What is actually missing is narrower: `product.b4m`'s ℤ-SPECIFIC theorems — the divisibility
// ones Judson's denominator-clearing needs — are stated over ℤ's own sorts, so reaching them
// at ℚ needs them re-proved or model-mapped onto the `isInteger` cut, and their proofs are
// nonneg-ℤ inductions. That is a real job but a bounded one, and it is the ONLY thing standing
// between here and Lemma 17.12's existence half. The gcd half already has its relational
// form in `std/integer/family-gcd.b4m`.
//
// So the lemma is STATED here, honestly, with its existence left open. What is proved is
// everything the statement rests on: the decomposition's parts are all expressible, and
// `aScaledIntegerPolynomialIsRational` below confirms the shape composes.
// `r` and `s` are relatively prime — Judson's "and $r$ and $s$ are relatively prime", read
// the same way `coefficientsAreRelativelyPrimeUpTo` reads a family: every integer dividing
// BOTH divides ONE.
//
// CORRECTION (2026-10-31): this conjunct previously read
// `coefficientsAreRelativelyPrimeUpTo(qaddP(qmonomial(r, 0), qmonomial(s, 0)), n)`, which is
// WRONG. Both monomials sit at index ZERO, so that polynomial's only nonzero coefficient is
// `r + s` — the condition was about the single number `r + s`, not about `r` and `s` being
// coprime. It type-checked, and would have gone on doing so indefinitely.
define arePairwiseRelativelyPrime(a, b) =
  forall e: Q;
  isInteger(e) ->
  dividesOnTheCut(e, a) -> dividesOnTheCut(e, b) ->
  dividesOnTheCut(e, rational.ONE)

pred isTheIntegerDecomposition(p: QPoly, q: QPoly, r: Q, s: Q, n: Nat)
// The decomposition's shape composes: given one, p really is the scaled polynomial, and that
// scaling is a ℚ[x] element like any other. A sanity theorem — it is what makes the
// predicate above a statement about p rather than a bag of unrelated conjuncts.
// `nonzero(s)` leads: the conclusion writes the guarded `recip(s)` OUTSIDE the assume, so its
// obligation must be met from the antecedent — the checker reads guards syntactically, and
// `isTheIntegerDecomposition(...)` does not supply one. Callers hold the nonzero as a
// hypothesis of their own and pass it here.
theorem aScaledIntegerPolynomialIsRational: forall p, q: QPoly; forall r, s: Q; forall n: Nat;
  rational.nonzero(s) ->
  isTheIntegerDecomposition(p, q, r, s, n) ->
  p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-r |
            fix r: Q {
              @generalize-s |
                fix s: Q {
                  @generalize-n |
                    fix n: Nat {
                      @given-s-is-nonzero |
                        assume rational.nonzero(s) {
                          @given-the-decomposition |
                            assume isTheIntegerDecomposition(p, q, r, s, n) {
                              @the-decomposition |
                                isTheIntegerDecomposition(p, q, r, s, n)
                                [by hypothesis given-the-decomposition]
                              @the-definition |
                                isTheIntegerDecomposition(p, q, r, s, n) iff
                                  (isInteger(r) and isInteger(s) and rational.nonzero(s) and
                                  hasIntegerCoefficientsUpTo(q, n) and
                                  coefficientsAreRelativelyPrimeUpTo(q, n) and
                                  arePairwiseRelativelyPrime(r, s) and
                                  p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q))
                                [using specialize integerDecompositionMeaning(p, q, r, s, n)]
                              // explicit elimination rather than `tautology`: the tactic's
                              // GENERATED intermediate terms did not discharge a guard a step
                              // in scope has proved.
                              @the-definition-forward |
                                isTheIntegerDecomposition(p, q, r, s, n) ->
                                  (isInteger(r) and isInteger(s) and rational.nonzero(s) and
                                  hasIntegerCoefficientsUpTo(q, n) and
                                  coefficientsAreRelativelyPrimeUpTo(q, n) and
                                  arePairwiseRelativelyPrime(r, s) and
                                  p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q))
                                [by equiv_forward the-definition]
                              @the-conjunction |
                                isInteger(r) and isInteger(s) and rational.nonzero(s) and
                                  hasIntegerCoefficientsUpTo(q, n) and
                                  coefficientsAreRelativelyPrimeUpTo(q, n) and
                                  arePairwiseRelativelyPrime(r, s) and
                                  p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
                                [by modus_ponens the-definition-forward the-decomposition]
                              @conclusion-p-is-the-scaling |
                                p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
                                [by and_rhs the-conjunction]
                            }
                          @the-decomposition-implies |
                            isTheIntegerDecomposition(p, q, r, s, n) ->
                              p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
                            [by discharge given-the-decomposition]
                        }
                      @s-nonzero-implies |
                        rational.nonzero(s) ->
                          isTheIntegerDecomposition(p, q, r, s, n) ->
                          p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
                        [by discharge given-s-is-nonzero]
                    }
                  @discharge-n |
                    forall n9: Nat;
                      rational.nonzero(s) ->
                      isTheIntegerDecomposition(p, q, r, s, n9) ->
                      p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
                    [by generalize generalize-n]
                }
              @discharge-s |
                forall s9: Q; forall n9: Nat;
                  rational.nonzero(s9) ->
                  isTheIntegerDecomposition(p, q, r, s9, n9) ->
                  p = qmulP(qmonomial(rational.mul(r, rational.recip(s9)), NAT_ZERO), q)
                [by generalize generalize-s]
            }
          @discharge-r |
            forall r9, s9: Q; forall n9: Nat;
              rational.nonzero(s9) ->
              isTheIntegerDecomposition(p, q, r9, s9, n9) ->
              p = qmulP(qmonomial(rational.mul(r9, rational.recip(s9)), NAT_ZERO), q)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q9: QPoly; forall r9, s9: Q; forall n9: Nat;
          rational.nonzero(s9) ->
          isTheIntegerDecomposition(p, q9, r9, s9, n9) ->
          p = qmulP(qmonomial(rational.mul(r9, rational.recip(s9)), NAT_ZERO), q9)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; forall r, s: Q; forall n: Nat;
      rational.nonzero(s) ->
      isTheIntegerDecomposition(p, q, r, s, n) ->
      p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
    [by generalize generalize-p]
qed

// -- MONIC POLYNOMIALS OVER ℚ -------------------------------------------------------------
// Gauss's Lemma concludes with monic integer factors, so the monic predicate has to exist at
// ℚ[x]. Same definition as `std/field/monic.b4m` gives it over an abstract field: the leading
// coefficient is one.
pred qIsMonic(p: QPoly)
// A monic polynomial is nonzero: the zero polynomial's coefficients are all NAT_ZERO, and ONE is
// not NAT_ZERO. The first thing any consumer needs, and it exercises the degree layer.
theorem aMonicPolynomialIsNonzero: forall p: QPoly;
  qIsMonic(p) -> (not (p = QZEROP))
proof
  @generalize-p |
    fix p: QPoly {
      @given-p-is-monic |
        assume qIsMonic(p) {
          @p-is-monic |
            qIsMonic(p)
            [by hypothesis given-p-is-monic]
          @monic-meaning |
            qIsMonic(p) iff qcoeff(p, qdegree(p)) = rational.ONE
            [using specialize qMonicMeansTheLeadingCoefficientIsOne(p)]
          @the-leading-coefficient-is-one |
            qcoeff(p, qdegree(p)) = rational.ONE
            [using tautology monic-meaning p-is-monic]
          @given-p-is-zero |
            assume p = QZEROP {
              @p-is-zero |
                p = QZEROP
                [by hypothesis given-p-is-zero]
              @the-zero-coefficient |
                qcoeff(QZEROP, qdegree(p)) = ZERO
                [using specialize qZeroPolyCoeff(qdegree(p))]
              @the-leading-coefficient-at-zero |
                qcoeff(QZEROP, qdegree(p)) = rational.ONE
                [by rewrite p-is-zero the-leading-coefficient-is-one]
              @one-is-zero |
                rational.ONE = ZERO
                [by rewrite the-leading-coefficient-at-zero the-zero-coefficient]
              @one-is-not-zero |
                not (rational.ONE = ZERO)
                [by cite rational.oneNotZero]
            }
          @conclusion-monic-is-nonzero |
            not (p = QZEROP)
            [by contradiction given-p-is-zero one-is-zero one-is-not-zero]
        }
      @monic-implies-nonzero |
        qIsMonic(p) -> (not (p = QZEROP))
        [by discharge given-p-is-monic]
    }
  @conclusion |
    forall p: QPoly; qIsMonic(p) -> (not (p = QZEROP))
    [by generalize generalize-p]
qed

// -- NEGATION PRESERVES THE DEGREE --------------------------------------------------------
// Judson's monic normalization takes a(x) = -α₁(x) when the leading coefficient is -1. For
// that to be the right degree-preserving move, negation must not change the degree — true
// because negation is coefficientwise and only NAT_ZERO negates to NAT_ZERO.

// A nonzero polynomial has a nonzero negation: at the leading index the coefficient is
// nonzero, and negating a nonzero rational keeps it nonzero.
theorem theNegationOfANonzeroPolynomialIsNonzero: forall p: QPoly;
  (not (p = QZEROP)) -> (not (qnegP(p) = QZEROP))
proof
  @generalize-p |
    fix p: QPoly {
      @given-p-nonzero |
        assume not (p = QZEROP) {
          @p-nonzero |
            not (p = QZEROP)
            [by hypothesis given-p-nonzero]
          @the-leading-coefficient-survives |
            not (qcoeff(p, qdegree(p)) = ZERO)
            [using specialize qDegreeIsALeadingIndex(p) p-nonzero]
          @the-negated-coefficient |
            qcoeff(qnegP(p), qdegree(p)) = rational.neg(qcoeff(p, qdegree(p)))
            [using specialize qNegPolyCoeff(p, qdegree(p))]
          // neg is injective on NAT_ZERO: neg(x) = 0 forces x = 0
          @given-the-negation-is-zero |
            assume qnegP(p) = QZEROP {
              @the-negation-is-zero |
                qnegP(p) = QZEROP
                [by hypothesis given-the-negation-is-zero]
              @the-zero-coefficient |
                qcoeff(QZEROP, qdegree(p)) = ZERO
                [using specialize qZeroPolyCoeff(qdegree(p))]
              @the-negated-coefficient-at-zero |
                qcoeff(QZEROP, qdegree(p)) =
                  rational.neg(qcoeff(p, qdegree(p)))
                [by rewrite the-negation-is-zero the-negated-coefficient]
              @the-negation-of-the-leading-coefficient-is-zero |
                ZERO = rational.neg(qcoeff(p, qdegree(p)))
                [by rewrite the-zero-coefficient the-negated-coefficient-at-zero]
              // negate both sides: neg(0) = 0 and neg(neg(x)) = x
              @double-negation |
                rational.neg(rational.neg(qcoeff(p, qdegree(p)))) =
                  qcoeff(p, qdegree(p))
                [using specialize rational.negNeg(qcoeff(p, qdegree(p)))]
              // rewrite NAT_ZERO = neg(c) into the double-negation identity's inner term
              @the-leading-coefficient-is-neg-zero |
                rational.neg(ZERO) = qcoeff(p, qdegree(p))
                [by rewrite the-negation-of-the-leading-coefficient-is-zero double-negation]
              @neg-zero |
                rational.neg(ZERO) = ZERO
                [by cite rational.negZero]
              @the-leading-coefficient-is-zero-flipped |
                qcoeff(p, qdegree(p)) = ZERO
                [by rewrite the-leading-coefficient-is-neg-zero neg-zero]
            }
          @conclusion-the-negation-is-nonzero |
            not (qnegP(p) = QZEROP)
            [by contradiction given-the-negation-is-zero the-leading-coefficient-is-zero-flipped the-leading-coefficient-survives]
        }
      @nonzero-implies-negation-nonzero |
        (not (p = QZEROP)) -> (not (qnegP(p) = QZEROP))
        [by discharge given-p-nonzero]
    }
  @conclusion |
    forall p: QPoly;
      (not (p = QZEROP)) -> (not (qnegP(p) = QZEROP))
    [by generalize generalize-p]
qed

// -- THE NEGATION'S LEADING COEFFICIENT ---------------------------------------------------
// Judson's second case: a_m = -1, so a(x) = -α₁(x) is the monic factor. The degrees agree
// (negation is coefficientwise, so `qdegreeAtMost` transfers and the leading index is the
// same), and the leading coefficient flips sign — turning -1 into 1.

// At a shared degree bound, the negation's coefficient at that index is the negation of the
// original's. Stated at an arbitrary index, which is all the monic step needs.
theorem theNegationsCoefficientFlips: forall p: QPoly; forall i: peano.Nat;
  qcoeff(p, i) = rational.neg(rational.ONE) ->
  qcoeff(qnegP(p), i) = rational.ONE
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-i |
        fix i: peano.Nat {
          @given-the-coefficient-is-minus-one |
            assume qcoeff(p, i) = rational.neg(rational.ONE) {
              @the-coefficient-is-minus-one |
                qcoeff(p, i) = rational.neg(rational.ONE)
                [by hypothesis given-the-coefficient-is-minus-one]
              @the-negated-coefficient |
                qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
                [using specialize qNegPolyCoeff(p, i)]
              @the-negated-coefficient-at-minus-one |
                qcoeff(qnegP(p), i) =
                  rational.neg(rational.neg(rational.ONE))
                [by rewrite the-coefficient-is-minus-one the-negated-coefficient]
              @double-negation |
                rational.neg(rational.neg(rational.ONE)) = rational.ONE
                [using specialize rational.negNeg(rational.ONE)]
              @conclusion-the-coefficient-is-one |
                qcoeff(qnegP(p), i) = rational.ONE
                [by rewrite double-negation the-negated-coefficient-at-minus-one]
            }
          @minus-one-implies-one |
            qcoeff(p, i) = rational.neg(rational.ONE) ->
              qcoeff(qnegP(p), i) = rational.ONE
            [by discharge given-the-coefficient-is-minus-one]
        }
      @discharge-i |
        forall i9: peano.Nat;
          qcoeff(p, i9) = rational.neg(rational.ONE) ->
          qcoeff(qnegP(p), i9) = rational.ONE
        [by generalize generalize-i]
    }
  @conclusion |
    forall p: QPoly; forall i: peano.Nat;
      qcoeff(p, i) = rational.neg(rational.ONE) ->
      qcoeff(qnegP(p), i) = rational.ONE
    [by generalize generalize-p]
qed

// A nonzero rational has a nonzero negation: neg(x) = 0 would give x = neg(neg(x)) = neg(0) = 0.
theorem aNonzeroHasNonzeroNegation: forall x: Q;
  (not (x = ZERO)) -> (not (rational.neg(x) = ZERO))
proof
  @generalize-x |
    fix x: Q {
      @given-x-nonzero |
        assume not (x = ZERO) {
          @x-nonzero |
            not (x = ZERO)
            [by hypothesis given-x-nonzero]
          @given-the-negation-is-zero |
            assume rational.neg(x) = ZERO {
              @the-negation-is-zero |
                rational.neg(x) = ZERO
                [by hypothesis given-the-negation-is-zero]
              @double-negation |
                rational.neg(rational.neg(x)) = x
                [using specialize rational.negNeg(x)]
              @neg-of-zero |
                rational.neg(ZERO) = ZERO
                [by cite rational.negZero]
              @x-is-neg-zero |
                rational.neg(ZERO) = x
                [by rewrite the-negation-is-zero double-negation]
              @x-is-zero |
                x = ZERO
                [by rewrite x-is-neg-zero neg-of-zero]
            }
          @conclusion-the-negation-is-nonzero |
            not (rational.neg(x) = ZERO)
            [by contradiction given-the-negation-is-zero x-is-zero x-nonzero]
        }
      @nonzero-implies |
        (not (x = ZERO)) -> (not (rational.neg(x) = ZERO))
        [by discharge given-x-nonzero]
    }
  @conclusion |
    forall x: Q;
      (not (x = ZERO)) -> (not (rational.neg(x) = ZERO))
    [by generalize generalize-x]
qed

// Whatever bounds a polynomial bounds its negation: above the bound both vanish, the negation
// because neg(NAT_ZERO) = NAT_ZERO.
theorem theNegationIsBoundedWhereverTheOriginalIs: forall p: QPoly; forall n: peano.Nat;
  qdegreeAtMost(p, n) -> qdegreeAtMost(qnegP(p), n)
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-n |
        fix n: peano.Nat {
          @given-the-bound |
            assume qdegreeAtMost(p, n) {
              @the-bound |
                qdegreeAtMost(p, n)
                [by hypothesis given-the-bound]
              @the-bounds-meaning |
                qdegreeAtMost(p, n) iff
                  (forall i: peano.Nat;
                  peano.less_than(n, i) -> qcoeff(p, i) = ZERO)
                [using specialize qDegreeAtMostMeaning(p, n)]
              @the-original-vanishes-above |
                forall i: peano.Nat;
                  peano.less_than(n, i) -> qcoeff(p, i) = ZERO
                [using tautology the-bounds-meaning the-bound]
              @the-negation-vanishes-above |
                fix i: peano.Nat {
                  @given-i-above |
                    assume peano.less_than(n, i) {
                      @i-above |
                        peano.less_than(n, i)
                        [by hypothesis given-i-above]
                      @the-original-at-i |
                        qcoeff(p, i) = ZERO
                        [using specialize the-original-vanishes-above(i) i-above]
                      @the-negated-coefficient |
                        qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
                        [using specialize qNegPolyCoeff(p, i)]
                      @the-negated-coefficient-at-zero |
                        qcoeff(qnegP(p), i) = rational.neg(ZERO)
                        [by rewrite the-original-at-i the-negated-coefficient]
                      @neg-of-zero |
                        rational.neg(ZERO) = ZERO
                        [by cite rational.negZero]
                      @conclusion-the-negation-at-i |
                        qcoeff(qnegP(p), i) = ZERO
                        [by rewrite neg-of-zero the-negated-coefficient-at-zero]
                    }
                  @above-implies-vanishes |
                    peano.less_than(n, i) -> qcoeff(qnegP(p), i) = ZERO
                    [by discharge given-i-above]
                }
              @all-above-vanish |
                forall i: peano.Nat;
                  peano.less_than(n, i) -> qcoeff(qnegP(p), i) = ZERO
                [by generalize the-negation-vanishes-above]
              @the-negations-bound-meaning |
                qdegreeAtMost(qnegP(p), n) iff
                  (forall i: peano.Nat;
                  peano.less_than(n, i) -> qcoeff(qnegP(p), i) = ZERO)
                [using specialize qDegreeAtMostMeaning(qnegP(p), n)]
              @conclusion-the-negation-is-bounded |
                qdegreeAtMost(qnegP(p), n)
                [using tautology the-negations-bound-meaning all-above-vanish]
            }
          @bound-implies-bound |
            qdegreeAtMost(p, n) -> qdegreeAtMost(qnegP(p), n)
            [by discharge given-the-bound]
        }
      @discharge-n |
        forall n9: peano.Nat;
          qdegreeAtMost(p, n9) -> qdegreeAtMost(qnegP(p), n9)
        [by generalize generalize-n]
    }
  @conclusion |
    forall p: QPoly; forall n: peano.Nat;
      qdegreeAtMost(p, n) -> qdegreeAtMost(qnegP(p), n)
    [by generalize generalize-p]
qed

// Negation preserves the degree. The negation is nonzero, its coefficient at the original's
// degree is nonzero (the flip of a nonzero rational), and it is bounded there — so
// `degreeIsUnique` pins the two degrees equal.
theorem negationPreservesTheDegree: forall p: QPoly;
  (not (p = QZEROP)) -> qdegree(qnegP(p)) = qdegree(p)
proof
  @generalize-p |
    fix p: QPoly {
      @given-p-nonzero |
        assume not (p = QZEROP) {
          @p-nonzero |
            not (p = QZEROP)
            [by hypothesis given-p-nonzero]
          @the-negation-is-nonzero |
            not (qnegP(p) = QZEROP)
            [using specialize theNegationOfANonzeroPolynomialIsNonzero(p) p-nonzero]
          // the negation's coefficient at p's degree is nonzero
          @the-leading-coefficient-survives |
            not (qcoeff(p, qdegree(p)) = ZERO)
            [using specialize qDegreeIsALeadingIndex(p) p-nonzero]
          @the-negated-coefficient |
            qcoeff(qnegP(p), qdegree(p)) = rational.neg(qcoeff(p, qdegree(p)))
            [using specialize qNegPolyCoeff(p, qdegree(p))]
          @the-negated-leading-coefficient-survives |
            not (rational.neg(qcoeff(p, qdegree(p))) = ZERO)
            [using specialize aNonzeroHasNonzeroNegation(qcoeff(p, qdegree(p))) the-leading-coefficient-survives]
          @the-negations-coefficient-survives |
            not (qcoeff(qnegP(p), qdegree(p)) = ZERO)
            [by rewrite the-negated-coefficient the-negated-leading-coefficient-survives]
          // and it is bounded there: p's bound carries over coefficientwise
          @the-original-is-bounded |
            qdegreeAtMost(p, qdegree(p))
            [using specialize qDegreeBoundsTheCoefficients(p) p-nonzero]
          @the-negation-is-bounded |
            qdegreeAtMost(qnegP(p), qdegree(p))
            [using specialize theNegationIsBoundedWhereverTheOriginalIs(p, qdegree(p)) the-original-is-bounded]
          @degree-is-unique |
            forall q: QPoly; forall n: peano.Nat;
              (not (q = QZEROP)) -> (not (qcoeff(q, n) = ZERO)) ->
              qdegreeAtMost(q, n) -> n = qdegree(q)
            [using model(RationalPolynomials) fieldpoly.degreeIsUnique]
          @the-degrees-agree-flipped |
            qdegree(p) = qdegree(qnegP(p))
            [using specialize degree-is-unique(qnegP(p), qdegree(p)) the-negation-is-nonzero the-negations-coefficient-survives the-negation-is-bounded]
          @conclusion-the-degrees-agree |
            qdegree(qnegP(p)) = qdegree(p)
            [by symmetry the-degrees-agree-flipped]
        }
      @nonzero-implies-the-degrees-agree |
        (not (p = QZEROP)) -> qdegree(qnegP(p)) = qdegree(p)
        [by discharge given-p-nonzero]
    }
  @conclusion |
    forall p: QPoly;
      (not (p = QZEROP)) -> qdegree(qnegP(p)) = qdegree(p)
    [by generalize generalize-p]
qed

// -- JUDSON'S MONIC NORMALIZATION ---------------------------------------------------------
// "In the second case a(x) = -α₁(x) and b(x) = -β₁(x) are the correct monic polynomials."
// With the degree preserved and the leading coefficient flipped, a polynomial whose leading
// coefficient is -1 negates to a MONIC one of the same degree. That, with the c = 1 /
// a_m = b_n = 1 case being immediate, is the whole of Gauss's monic bookkeeping.
theorem negatingALeadingMinusOneMakesItMonic: forall p: QPoly;
  (not (p = QZEROP)) ->
  qcoeff(p, qdegree(p)) = rational.neg(rational.ONE) ->
  qIsMonic(qnegP(p))
proof
  @generalize-p |
    fix p: QPoly {
      @given-p-nonzero |
        assume not (p = QZEROP) {
          @p-nonzero |
            not (p = QZEROP)
            [by hypothesis given-p-nonzero]
          @given-the-leading-coefficient-is-minus-one |
            assume qcoeff(p, qdegree(p)) = rational.neg(rational.ONE) {
              @the-leading-coefficient-is-minus-one |
                qcoeff(p, qdegree(p)) = rational.neg(rational.ONE)
                [by hypothesis given-the-leading-coefficient-is-minus-one]
              // the negation's coefficient at p's degree is ONE
              @the-flip |
                qcoeff(qnegP(p), qdegree(p)) = rational.ONE
                [using specialize theNegationsCoefficientFlips(p, qdegree(p)) the-leading-coefficient-is-minus-one]
              // and p's degree IS the negation's degree
              @the-degrees-agree |
                qdegree(qnegP(p)) = qdegree(p)
                [using specialize negationPreservesTheDegree(p) p-nonzero]
              @the-negations-leading-coefficient |
                qcoeff(qnegP(p), qdegree(qnegP(p))) = rational.ONE
                [by rewrite the-degrees-agree the-flip]
              @monic-meaning |
                qIsMonic(qnegP(p)) iff
                  qcoeff(qnegP(p), qdegree(qnegP(p))) = rational.ONE
                [using specialize qMonicMeansTheLeadingCoefficientIsOne(qnegP(p))]
              @conclusion-the-negation-is-monic |
                qIsMonic(qnegP(p))
                [using tautology monic-meaning the-negations-leading-coefficient]
            }
          @minus-one-implies-monic |
            qcoeff(p, qdegree(p)) = rational.neg(rational.ONE) ->
              qIsMonic(qnegP(p))
            [by discharge given-the-leading-coefficient-is-minus-one]
        }
      @nonzero-implies |
        (not (p = QZEROP)) ->
          qcoeff(p, qdegree(p)) = rational.neg(rational.ONE) ->
          qIsMonic(qnegP(p))
        [by discharge given-p-nonzero]
    }
  @conclusion |
    forall p: QPoly;
      (not (p = QZEROP)) ->
      qcoeff(p, qdegree(p)) = rational.neg(rational.ONE) ->
      qIsMonic(qnegP(p))
    [by generalize generalize-p]
qed

// -- SCALING BY A CONSTANT ------------------------------------------------------------------
// Multiplying by the constant monomial `c` scales every coefficient by `c`. Lemma 17.12's
// conclusion is exactly such a scaling (`p = (r/s)·q`), so this is the law that makes the
// statement checkable against coefficients.
//
// The convolution at a constant left factor collapses: `monomial(c, 0)` has coefficient `c`
// at index ZERO and ZERO above, so every term of the convolution past the first vanishes.

// Multiplying by a monomial shifts every coefficient. TRANSFERRED from F[x], which has it
// from the generic monomial theory — subtraction-free, since the statement names `k + t`
// rather than reading `qcoeff(q, sub(i, k))`.
theorem theMonomialShift: forall g: QPoly; forall c: Q; forall k, t: Nat;
  qcoeff(qmulP(qmonomial(c, k), g), peano.add(k, t)) = rational.mul(c, qcoeff(g, t))
proof
  @conclusion |
    forall g: QPoly; forall c: Q; forall k, t: Nat;
      qcoeff(qmulP(qmonomial(c, k), g), peano.add(k, t)) =
      rational.mul(c, qcoeff(g, t))
    [using model(RationalPolynomials) fieldpoly.theMonomialShiftsEveryCoefficient]
qed

// Hence the scaling law: every coefficient of c·q is c times q's.
theorem scalingByAConstantScalesTheCoefficients:
  forall q: QPoly; forall c: Q; forall i: Nat;
  qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) =
  rational.mul(c, qcoeff(q, i))
proof
  @generalize-q |
    fix q: QPoly {
      @generalize-c |
        fix c: Q {
          @generalize-i |
            fix i: Nat {
              @the-monomial-shifts |
                qcoeff(qmulP(qmonomial(c, NAT_ZERO), q),
                  peano.add(NAT_ZERO, i)) = rational.mul(c, qcoeff(q, i))
                [using specialize theMonomialShift(q, c, NAT_ZERO, i)]
              @the-index-collapses |
                peano.add(NAT_ZERO, i) = i
                [using specialize peano.addZeroLeft(i)]
              @conclusion-scaled |
                qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) =
                  rational.mul(c, qcoeff(q, i))
                [by rewrite the-index-collapses the-monomial-shifts]
            }
          @discharge-i |
            forall i9: Nat;
              qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i9) =
              rational.mul(c, qcoeff(q, i9))
            [by generalize generalize-i]
        }
      @discharge-c |
        forall c9: Q; forall i9: Nat;
          qcoeff(qmulP(qmonomial(c9, NAT_ZERO), q), i9) =
          rational.mul(c9, qcoeff(q, i9))
        [by generalize generalize-c]
    }
  @conclusion |
    forall q: QPoly; forall c: Q; forall i: Nat;
      qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) =
      rational.mul(c, qcoeff(q, i))
    [by generalize generalize-q]
qed

// -- THE PRODUCT'S DEGREE AND LEADING COEFFICIENT ----------------------------------------
// Gauss's d = 1 branch reads `c·a_m·b_n = 1` off the monic hypothesis, which needs the
// product's leading coefficient to be the product of the leading coefficients.
//
// It is proved in `std/ring/polynomial/leading.b4m` over a commutative ring, and restated in
// `std/field/polynomial.b4m` for F[x] — but F[x]'s version is NOT transferable here, because
// it is itself a model-transfer through `FieldPolyModelsRingPoly`, and 2b4m RE-CHECKS an
// inner transfer rather than composing models. Going through F[x] would therefore demand ℚ
// be mapped onto `ring.Ring` as a nested step, which fails with
// `std/ring.b4m:143: expected sort 'Field', got 'Q'`.
//
// So map ℚ[x] onto `ring_poly` DIRECTLY — one transfer, not two. The extra cost is that
// `ring_poly` carries a ONE polynomial that ℚ[x] does not declare. A model maps a CONST to a
// CONST, never to a term, so `qmonomial(ONE, ZERO)` cannot serve and ℚ[x] gets its own, with
// the two coefficient clauses `ring_poly` demands — which say exactly what the monomial laws
// read at index ZERO would say.
const QONEP: QPoly
// ℚ[x] as a polynomial ring over the commutative ring ℚ. Both namespaces are mapped in one
// block, since `ring_poly.R` ALIASES `ring.Ring` and an alias cannot be mapped apart from
// its origin.
model RationalPolynomialsOverARing {
  ring.Ring: Q
  ring.ZERO: ZERO
  ring.ONE: rational.ONE
  ring.add: rational.add
  ring.mul: rational.mul
  ring.neg: rational.neg
  ring.addIsAssociative <- rational.addIsAssociative
  ring.addZeroLeft <- rational.addZeroLeft
  ring.addNegLeft <- rational.addNegLeft
  ring.addIsCommutative <- rational.addIsCommutative
  ring.mulIsAssociative <- rational.mulIsAssociative
  ring.mulAddDistribLeft <- rational.mulAddDistribLeft
  ring.mulAddDistribRight <- rational.mulAddDistribRight
  ring_poly.mulOneLeftR <- rational.mulOneLeft
  ring_poly.mulIsCommutativeR <- rational.mulIsCommutative
  ring_poly.Nat: peano.Nat
  ring_poly.ZERO: peano.ZERO
  ring_poly.succ: peano.succ
  ring_poly.addN: peano.add
  ring_poly.less_than: peano.less_than
  ring_poly.Poly: QPoly
  ring_poly.coeff: qcoeff
  ring_poly.ZEROP: QZEROP
  ring_poly.ONEP: QONEP
  ring_poly.addP: qaddP
  ring_poly.negP: qnegP
  ring_poly.mulP: qmulP
  ring_poly.convolution: qconvolution
  ring_poly.tailConvolution: qtailConvolution
  ring_poly.segment: qsegment
  ring_poly.rsegment: qrsegment
  ring_mono.monomial: qmonomial
  ring_mono.monomial <- qmonomial
  ring_poly.monus: qmonus
  ring_poly.theCofactorIndex: qtheCofactorIndex
  ring_poly.cappedRun: qcappedRun
  ring_poly.tripleTerm: qtripleTerm
  ring_poly.tripleRow: qtripleRow
  ring_poly.tripleDiag: qtripleDiag
  ring_poly.tripleTri: qtripleTri
  ring_poly.tripleRows: qtripleRows
  ring_poly.monus <- qmonus
  ring_poly.theCofactorIndex <- qtheCofactorIndex
  ring_poly.cappedRun <- qcappedRun
  ring_poly.tripleTerm <- qtripleTerm
  ring_poly.tripleRow <- qtripleRow
  ring_poly.tripleDiag <- qtripleDiag
  ring_poly.tripleTri <- qtripleTri
  ring_poly.tripleRows <- qtripleRows
  ring_poly.degreeAtMost: qdegreeAtMost
  ring_poly.degree: qdegree
  ring_poly.polyExtensionality <- qPolyExtensionality
  ring_poly.zeroPolyCoeff <- qZeroPolyCoeff
  ring_poly.onePolyCoeffZero <- qOnePolyCoeffZero
  ring_poly.onePolyCoeffHigher <- qOnePolyCoeffHigher
  ring_poly.addP <- qaddP
  ring_poly.negP <- qnegP
  ring_poly.degreeAtMostMeaning <- qDegreeAtMostMeaning
  ring_poly.degreeIsALeadingIndex <- qDegreeIsALeadingIndex
  ring_poly.degreeBoundsTheCoefficients <- qDegreeBoundsTheCoefficients
  ring_poly.convolution <- qconvolution
  ring_poly.tailConvolution <- qtailConvolution
  ring_poly.segment <- qsegment
  ring_poly.rsegment <- qrsegment
  ring_poly.mulP <- qmulP
}

theorem qTheProductsLeadingCoefficient: forall p, q: QPoly; forall m, n: peano.Nat;
  qdegreeAtMost(p, m) -> qdegreeAtMost(q, n) ->
  qcoeff(qmulP(p, q), peano.add(m, n)) =
  rational.mul(qcoeff(p, m), qcoeff(q, n))
proof
  @conclusion |
    forall p, q: QPoly; forall m, n: peano.Nat;
      qdegreeAtMost(p, m) -> qdegreeAtMost(q, n) ->
      qcoeff(qmulP(p, q), peano.add(m, n)) =
      rational.mul(qcoeff(p, m), qcoeff(q, n))
    [using model(RationalPolynomialsOverARing) ring_leading.theProductsLeadingCoefficient]
qed

// -- NEGATION AS A SCALING ------------------------------------------------------------------
// Negating a polynomial is scaling it by -1. Gauss's d = 1 branch needs
// (-α)(-β) = αβ, and routing it through the scaling form turns a polynomial identity into
// coefficient algebra: both sides' coefficients are neg(ONE)·neg(ONE)·(…) = (…).
theorem theNegationIsTheMinusOneScaling: forall p: QPoly;
  qnegP(p) = qmulP(qmonomial(rational.neg(rational.ONE), peano.ZERO), p)
proof
  @generalize-p |
    fix p: QPoly {
      @each-index |
        fix i: peano.Nat {
          @the-negations-coefficient |
            qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
            [using specialize qNegPolyCoeff(p, i)]
          @the-scalings-coefficient |
            qcoeff(qmulP(qmonomial(rational.neg(rational.ONE),
              peano.ZERO), p), i) =
              rational.mul(rational.neg(rational.ONE), qcoeff(p, i))
            [using specialize scalingByAConstantScalesTheCoefficients(p, rational.neg(rational.ONE), i)]
          @minus-one-times-is-the-negation |
            rational.mul(rational.neg(rational.ONE), qcoeff(p, i)) =
              rational.neg(qcoeff(p, i))
            [using polynomial(rational)]
          @the-scaling-is-the-negation |
            qcoeff(qmulP(qmonomial(rational.neg(rational.ONE),
              peano.ZERO), p), i) = rational.neg(qcoeff(p, i))
            [using simplify the-scalings-coefficient minus-one-times-is-the-negation]
          @conclusion-agree-at-i |
            qcoeff(qnegP(p), i) =
              qcoeff(qmulP(qmonomial(rational.neg(rational.ONE),
              peano.ZERO), p), i)
            [using simplify the-negations-coefficient the-scaling-is-the-negation]
        }
      @all-coefficients-agree |
        forall i: peano.Nat;
          qcoeff(qnegP(p), i) =
          qcoeff(qmulP(qmonomial(rational.neg(rational.ONE),
          peano.ZERO), p), i)
        [by generalize each-index]
      @the-extensionality |
        forall a, b: QPoly;
          (forall i: peano.Nat; qcoeff(a, i) = qcoeff(b, i)) -> a = b
        [by cite qPolyExtensionality]
      @conclusion-equal |
        qnegP(p) = qmulP(qmonomial(rational.neg(rational.ONE),
          peano.ZERO), p)
        [using specialize the-extensionality(qnegP(p), qmulP(qmonomial(rational.neg(rational.ONE), peano.ZERO), p)) all-coefficients-agree]
    }
  @conclusion |
    forall p: QPoly;
      qnegP(p) = qmulP(qmonomial(rational.neg(rational.ONE), peano.ZERO), p)
    [by generalize generalize-p]
qed

// -- EVALUATION ----------------------------------------------------------------------------
// Corollary 17.14 (the Rational Root Theorem) is about a ZERO of a polynomial, so ℚ[x] needs
// evaluation. F[x] has the whole layer; these are its symbols at ℚ, declared here so the
// `RationalPolynomials` model can map them and F[x]'s evaluation corpus can travel.
// The recursion descends by `peano.prev` rather than matching `peano.succ` on the left: the
// l-value rule requires a recursive definition to keep patterns off its left side, so the
// descent is readable on the RIGHT where the termination check can see it. `prev` is
// guarded (`requires n != ZERO`), and the arm's own condition discharges it.
oper qpower(a: Q, n: peano.Nat) => Q:
  qpower(a, peano.ZERO) = rational.ONE;
  qpower(a, n) = rational.mul(a, qpower(a, peano.prev(n))) when n != peano.ZERO.
  termination(peano): _, {qpowerIsGrounded, qpowerGrounded}

// Horner-free evaluation: the first `k` terms, each `qcoeff(p, i) * a^i`. The recursion
// descends by `peano.prev` rather than matching `peano.succ` on the left, which the l-value rule
// requires of a recursive definition — the descent must be readable on the RIGHT. Every former
// bare `k` in the payload became `peano.prev(k)`, because the parameter now denotes what the
// old arm matched as `peano.succ(k)`.
oper qevalUpTo(p: QPoly, a: Q, k: peano.Nat) => Q:
  qevalUpTo(p, a, peano.ZERO) = ZERO;
  qevalUpTo(p, a, k) =
  rational.add(qevalUpTo(p, a, peano.prev(k)),
  rational.mul(qcoeff(p, peano.prev(k)), qpower(a, peano.prev(k)))) when k != peano.ZERO.
  termination(peano): _, {qevalUpToIsGrounded, qevalUpToGrounded}

// Judson's `p(a)`: the sum over every index up to AND INCLUDING the degree, which is what
// the `succ` bound buys.
define qevaluate(p, a) = qevalUpTo(p, a, peano.succ(qdegree(p)))

pred qIsZeroOf(a: Q, p: QPoly)
// ℚ[x]'s multiplication is commutative, named locally so callers need not re-open the model.
theorem qMulIsCommutative: forall p, q: QPoly;
  qmulP(p, q) = qmulP(q, p)
proof
  @conclusion |
    forall p, q: QPoly; qmulP(p, q) = qmulP(q, p)
    [using model(RationalPolynomialsOverARing) ring_poly.polyMulIsCommutative]
qed

// At the polynomial level: negating the first factor negates the product.
// -- NEGATION PULLS OUT OF A PRODUCT --------------------------------------------------------
// Judson's d = 1 branch writes p(x) = (-a1(x))(-b1(x)), so the two negations must cancel. The
// step that makes it work is that negation pulls out of ONE factor. TRANSFERRED: the generic
// R[x] proof inducts on the convolution's length, which ℚ[x] once restated locally — 190
// lines that the reindexed convolution made redundant.
theorem theNegationPullsOutOfTheProduct: forall p, q: QPoly;
  qmulP(qnegP(p), q) = qnegP(qmulP(p, q))
proof
  @conclusion |
    forall p, q: QPoly; qmulP(qnegP(p), q) = qnegP(qmulP(p, q))
    [using model(RationalPolynomialsOverARing) ring_poly.negationPullsOutOfTheProduct]
qed

// Judson's `p(x) = (-α₁(x))(-β₁(x))`: both negations cancel. Pull the first out, commute to
// pull the second out, then `negP(negP(_))` is the identity — which follows coefficientwise
// from ℚ's own `negNeg`.
theorem theTwoNegationsCancelInAProduct: forall p, q: QPoly;
  qmulP(qnegP(p), qnegP(q)) = qmulP(p, q)
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @pull-the-first-out |
            qmulP(qnegP(p), qnegP(q)) = qnegP(qmulP(p, qnegP(q)))
            [using specialize theNegationPullsOutOfTheProduct(p, qnegP(q))]
          @the-commutation |
            forall a, b: QPoly; qmulP(a, b) = qmulP(b, a)
            [by cite qMulIsCommutative]
          @commute-the-inner |
            qmulP(p, qnegP(q)) = qmulP(qnegP(q), p)
            [using specialize the-commutation(p, qnegP(q))]
          @pull-the-second-out |
            qmulP(qnegP(q), p) = qnegP(qmulP(q, p))
            [using specialize theNegationPullsOutOfTheProduct(q, p)]
          @the-inner-is-doubly-negated |
            qmulP(p, qnegP(q)) = qnegP(qmulP(q, p))
            [using simplify commute-the-inner pull-the-second-out]
          @the-whole-is-doubly-negated |
            qmulP(qnegP(p), qnegP(q)) = qnegP(qnegP(qmulP(q, p)))
            [by rewrite the-inner-is-doubly-negated pull-the-first-out]
          // negP(negP(_)) is the identity, coefficientwise
          @each-index |
            fix i: peano.Nat {
              @the-outer-negation |
                qcoeff(qnegP(qnegP(qmulP(q, p))), i) =
                  rational.neg(qcoeff(qnegP(qmulP(q, p)), i))
                [using specialize qNegPolyCoeff(qnegP(qmulP(q, p)), i)]
              @the-inner-negation |
                qcoeff(qnegP(qmulP(q, p)), i) =
                  rational.neg(qcoeff(qmulP(q, p), i))
                [using specialize qNegPolyCoeff(qmulP(q, p), i)]
              @the-double-negation |
                qcoeff(qnegP(qnegP(qmulP(q, p))), i) =
                  rational.neg(rational.neg(qcoeff(qmulP(q, p), i)))
                [by rewrite the-inner-negation the-outer-negation]
              @the-negations-undo |
                rational.neg(rational.neg(qcoeff(qmulP(q, p), i))) =
                  qcoeff(qmulP(q, p), i)
                [using specialize rational.negNeg(qcoeff(qmulP(q, p), i))]
              @conclusion-agree-at-i |
                qcoeff(qnegP(qnegP(qmulP(q, p))), i) =
                  qcoeff(qmulP(q, p), i)
                [using simplify the-double-negation the-negations-undo]
            }
          @all-coefficients-agree |
            forall i: peano.Nat;
              qcoeff(qnegP(qnegP(qmulP(q, p))), i) =
              qcoeff(qmulP(q, p), i)
            [by generalize each-index]
          @the-extensionality |
            forall a, b: QPoly;
              (forall i: peano.Nat; qcoeff(a, i) = qcoeff(b, i)) -> a = b
            [by cite qPolyExtensionality]
          @the-double-negation-is-the-identity |
            qnegP(qnegP(qmulP(q, p))) = qmulP(q, p)
            [using specialize the-extensionality(qnegP(qnegP(qmulP(q, p))), qmulP(q, p)) all-coefficients-agree]
          @the-product-commuted-back |
            qmulP(q, p) = qmulP(p, q)
            [using specialize the-commutation(q, p)]
          @the-whole-is-the-commuted-product |
            qmulP(qnegP(p), qnegP(q)) = qmulP(q, p)
            [by rewrite the-double-negation-is-the-identity the-whole-is-doubly-negated]
          @conclusion-cancelled |
            qmulP(qnegP(p), qnegP(q)) = qmulP(p, q)
            [by rewrite the-product-commuted-back the-whole-is-the-commuted-product]
        }
      @discharge-q |
        forall q2: QPoly; qmulP(qnegP(p), qnegP(q2)) = qmulP(p, q2)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; qmulP(qnegP(p), qnegP(q)) = qmulP(p, q)
    [by generalize generalize-p]
qed

// -- CLEARING DENOMINATORS FROM AN EVALUATION -----------------------------------------------
// Corollary 17.14's whole move is "multiply p(r/s) = 0 through by s^n". Done with the bound
// as the induction variable, the cleared sum has its own recursion and no subtraction
// anywhere — `sum_{i<k} a_i r^i s^(k-i)` grows at the top as
// `S(k+1) = s·(S(k) + a_k·r^k)`, since the new term's s-exponent is exactly 1.
//
// `k` is the bound and the only descent, moved to the RIGHT as `peano.prev(k)`: the l-value
// rule keeps patterns off the left of a recursive block, so the termination check can read the
// descent. All THREE former bare uses of the clause variable become `prev(k)` — the recursive
// call and both payload factors — since the parameter now denotes what the old arm matched as
// `succ(k)`.
oper qclearedSum(p: QPoly, r: Q, s: Q, k: peano.Nat) => Q:
  qclearedSum(p, r, s, peano.ZERO) = ZERO;
  qclearedSum(p, r, s, k) = rational.mul(s, rational.add(qclearedSum(p, r, s, peano.prev(k)), rational.mul(qcoeff(p, peano.prev(k)), qpower(r, peano.prev(k))))) when k != peano.ZERO.
  termination(peano): _, {qClearedSumIsGrounded, qclearedSumGrounded}

// A product's power splits, by induction on the exponent.
theorem aProductsPowerSplits: forall a, b: Q; forall k: peano.Nat;
  qpower(rational.mul(a, b), k) =
  rational.mul(qpower(a, k), qpower(b, k))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          // base: all three powers are ONE
          @the-zero-power-of-the-product |
            qpower(rational.mul(a, b), peano.ZERO) = rational.ONE
            [using specialize qPowerZero(rational.mul(a, b))]
          @the-zero-power-of-a |
            qpower(a, peano.ZERO) = rational.ONE
            [using specialize qPowerZero(a)]
          @the-zero-power-of-b |
            qpower(b, peano.ZERO) = rational.ONE
            [using specialize qPowerZero(b)]
          @one-times-one |
            rational.mul(rational.ONE, rational.ONE) = rational.ONE
            [using specialize rational.mulOneLeft(rational.ONE)]
          @the-base-right-side |
            rational.mul(qpower(a, peano.ZERO),
              qpower(b, peano.ZERO)) = rational.ONE
            [using simplify the-zero-power-of-a the-zero-power-of-b one-times-one]
          @base-case |
            qpower(rational.mul(a, b), peano.ZERO) =
              rational.mul(qpower(a, peano.ZERO),
              qpower(b, peano.ZERO))
            [using simplify the-zero-power-of-the-product the-base-right-side]

          @induction-step |
            fix k: peano.Nat {
              @given-inductive-hypothesis |
                assume qpower(rational.mul(a, b), k) =
                  rational.mul(qpower(a, k), qpower(b, k)) {
                  @inductive-hypothesis |
                    qpower(rational.mul(a, b), k) =
                      rational.mul(qpower(a, k), qpower(b, k))
                    [by hypothesis given-inductive-hypothesis]
                  @the-next-power-of-the-product |
                    qpower(rational.mul(a, b), peano.succ(k)) =
                      rational.mul(rational.mul(a, b),
                      qpower(rational.mul(a, b), k))
                    [using specialize qPowerSucc(rational.mul(a, b), k)]
                  @the-next-power-with-the-hypothesis |
                    qpower(rational.mul(a, b), peano.succ(k)) =
                      rational.mul(rational.mul(a, b),
                      rational.mul(qpower(a, k), qpower(b, k)))
                    [by rewrite inductive-hypothesis the-next-power-of-the-product]
                  @the-next-power-of-a |
                    qpower(a, peano.succ(k)) =
                      rational.mul(a, qpower(a, k))
                    [using specialize qPowerSucc(a, k)]
                  @the-next-power-of-b |
                    qpower(b, peano.succ(k)) =
                      rational.mul(b, qpower(b, k))
                    [using specialize qPowerSucc(b, k)]
                  @the-right-side-expanded |
                    rational.mul(qpower(a, peano.succ(k)),
                      qpower(b, peano.succ(k))) =
                      rational.mul(rational.mul(a, qpower(a, k)),
                      rational.mul(b, qpower(b, k)))
                    [using simplify the-next-power-of-a the-next-power-of-b]
                  @the-two-groupings-agree |
                    rational.mul(rational.mul(a, b),
                      rational.mul(qpower(a, k), qpower(b, k))) =
                      rational.mul(rational.mul(a, qpower(a, k)),
                      rational.mul(b, qpower(b, k)))
                    [using polynomial(rational)]
                  @the-next-power-regrouped |
                    qpower(rational.mul(a, b), peano.succ(k)) =
                      rational.mul(rational.mul(a, qpower(a, k)),
                      rational.mul(b, qpower(b, k)))
                    [by rewrite the-two-groupings-agree the-next-power-with-the-hypothesis]
                  @conclusion-the-step |
                    qpower(rational.mul(a, b), peano.succ(k)) =
                      rational.mul(qpower(a, peano.succ(k)),
                      qpower(b, peano.succ(k)))
                    [by rewrite the-right-side-expanded the-next-power-regrouped]
                }
              @induction-step-at-k |
                (qpower(rational.mul(a, b), k) =
                  rational.mul(qpower(a, k), qpower(b, k))) ->
                  (qpower(rational.mul(a, b), peano.succ(k)) =
                  rational.mul(qpower(a, peano.succ(k)),
                  qpower(b, peano.succ(k))))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: peano.Nat;
              (qpower(rational.mul(a, b), k) =
              rational.mul(qpower(a, k), qpower(b, k))) ->
              (qpower(rational.mul(a, b), peano.succ(k)) =
              rational.mul(qpower(a, peano.succ(k)),
              qpower(b, peano.succ(k))))
            [by generalize induction-step]
          @all-exponents |
            forall k: peano.Nat;
              qpower(rational.mul(a, b), k) =
              rational.mul(qpower(a, k), qpower(b, k))
            [using instantiation peano.induction((fun z: peano.Nat => (qpower(rational.mul(a, b), z) = rational.mul(qpower(a, z), qpower(b, z))))) base-case induction-step-for-all-k]
        }
      @discharge-b |
        forall b9: Q; forall k: peano.Nat;
          qpower(rational.mul(a, b9), k) =
          rational.mul(qpower(a, k), qpower(b9, k))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q; forall k: peano.Nat;
      qpower(rational.mul(a, b), k) =
      rational.mul(qpower(a, k), qpower(b, k))
    [by generalize generalize-a]
qed

// A power and its reciprocal's power cancel. The one auxiliary the clearing identity needs.
theorem aPowerCancelsTheReciprocalsPower: forall s: Q; forall k: peano.Nat;
  rational.nonzero(s) ->
  rational.mul(qpower(s, k), qpower(rational.recip(s), k)) = rational.ONE
proof
  @generalize-s |
    fix s: Q {
      @given-s-nonzero |
        assume rational.nonzero(s) {
          @s-nonzero |
            rational.nonzero(s)
            [by hypothesis given-s-nonzero]
          @s-inverts |
            rational.mul(s, rational.recip(s)) = rational.ONE
            [using specialize rational.fieldInverse(s) s-nonzero]
          // base: both powers are ONE
          @the-zero-power |
            qpower(s, peano.ZERO) = rational.ONE
            [using specialize qPowerZero(s)]
          @the-zero-reciprocal-power |
            qpower(rational.recip(s), peano.ZERO) = rational.ONE
            [using specialize qPowerZero(rational.recip(s))]
          @one-times-one |
            rational.mul(rational.ONE, rational.ONE) = rational.ONE
            [using specialize rational.mulOneLeft(rational.ONE)]
          @the-base-product |
            rational.mul(qpower(s, peano.ZERO),
              qpower(rational.recip(s), peano.ZERO)) =
              rational.mul(rational.ONE, rational.ONE)
            [using simplify the-zero-power the-zero-reciprocal-power]
          @base-case |
            rational.mul(qpower(s, peano.ZERO),
              qpower(rational.recip(s), peano.ZERO)) = rational.ONE
            [using simplify the-base-product one-times-one]

          @induction-step |
            fix k: peano.Nat {
              @given-inductive-hypothesis |
                assume rational.mul(qpower(s, k),
                  qpower(rational.recip(s), k)) = rational.ONE {
                  @inductive-hypothesis |
                    rational.mul(qpower(s, k),
                      qpower(rational.recip(s), k)) = rational.ONE
                    [by hypothesis given-inductive-hypothesis]
                  @the-next-power |
                    qpower(s, peano.succ(k)) =
                      rational.mul(s, qpower(s, k))
                    [using specialize qPowerSucc(s, k)]
                  @the-next-reciprocal-power |
                    qpower(rational.recip(s), peano.succ(k)) =
                      rational.mul(rational.recip(s),
                      qpower(rational.recip(s), k))
                    [using specialize qPowerSucc(rational.recip(s), k)]
                  @the-product-expanded |
                    rational.mul(qpower(s, peano.succ(k)),
                      qpower(rational.recip(s), peano.succ(k))) =
                      rational.mul(rational.mul(s, qpower(s, k)),
                      rational.mul(rational.recip(s),
                      qpower(rational.recip(s), k)))
                    [using simplify the-next-power the-next-reciprocal-power]
                  // regroup as (s·recip s)·(s^k·recip(s)^k)
                  @the-regrouping |
                    rational.mul(rational.mul(s, qpower(s, k)),
                      rational.mul(rational.recip(s),
                      qpower(rational.recip(s), k))) =
                      rational.mul(rational.mul(s,
                      rational.recip(s)),
                      rational.mul(qpower(s, k),
                      qpower(rational.recip(s), k)))
                    [using polynomial(rational)]
                  @the-product-regrouped |
                    rational.mul(qpower(s, peano.succ(k)),
                      qpower(rational.recip(s), peano.succ(k))) =
                      rational.mul(rational.mul(s,
                      rational.recip(s)),
                      rational.mul(qpower(s, k),
                      qpower(rational.recip(s), k)))
                    [by rewrite the-regrouping the-product-expanded]
                  @both-halves-are-one |
                    rational.mul(qpower(s, peano.succ(k)),
                      qpower(rational.recip(s), peano.succ(k))) =
                      rational.mul(rational.ONE, rational.ONE)
                    [using simplify the-product-regrouped s-inverts inductive-hypothesis]
                  @conclusion-the-step |
                    rational.mul(qpower(s, peano.succ(k)),
                      qpower(rational.recip(s), peano.succ(k))) =
                      rational.ONE
                    [using simplify both-halves-are-one one-times-one]
                }
              @induction-step-at-k |
                (rational.mul(qpower(s, k),
                  qpower(rational.recip(s), k)) = rational.ONE) ->
                  (rational.mul(qpower(s, peano.succ(k)),
                  qpower(rational.recip(s), peano.succ(k))) =
                  rational.ONE)
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: peano.Nat;
              (rational.mul(qpower(s, k),
              qpower(rational.recip(s), k)) = rational.ONE) ->
              (rational.mul(qpower(s, peano.succ(k)),
              qpower(rational.recip(s), peano.succ(k))) = rational.ONE)
            [by generalize induction-step]
          @all-exponents |
            forall k: peano.Nat;
              rational.mul(qpower(s, k),
              qpower(rational.recip(s), k)) = rational.ONE
            [using instantiation peano.induction((fun z: peano.Nat => (rational.mul(qpower(s, z), qpower(rational.recip(s), z)) = rational.ONE))) base-case induction-step-for-all-k]
        }
      @nonzero-implies |
        rational.nonzero(s) ->
          (forall k: peano.Nat;
          rational.mul(qpower(s, k),
          qpower(rational.recip(s), k)) = rational.ONE)
        [by discharge given-s-nonzero]
      // move the bound binder outside the implication: fix k, re-assume, and
      // specialize the universal the implication delivers
      @each-exponent |
        fix k: peano.Nat {
          @given-s-nonzero-again |
            assume rational.nonzero(s) {
              @s-nonzero-again |
                rational.nonzero(s)
                [by hypothesis given-s-nonzero-again]
              @all-exponents-here |
                forall k2: peano.Nat;
                  rational.mul(qpower(s, k2),
                  qpower(rational.recip(s), k2)) = rational.ONE
                [by modus_ponens nonzero-implies s-nonzero-again]
              @conclusion-at-k |
                rational.mul(qpower(s, k),
                  qpower(rational.recip(s), k)) = rational.ONE
                [using specialize all-exponents-here(k)]
            }
          @nonzero-implies-at-k |
            rational.nonzero(s) ->
              rational.mul(qpower(s, k),
              qpower(rational.recip(s), k)) = rational.ONE
            [by discharge given-s-nonzero-again]
        }
      @discharge-s |
        forall k: peano.Nat;
          rational.nonzero(s) ->
          rational.mul(qpower(s, k),
          qpower(rational.recip(s), k)) = rational.ONE
        [by generalize each-exponent]
    }
  @conclusion |
    forall s: Q; forall k: peano.Nat;
      rational.nonzero(s) ->
      rational.mul(qpower(s, k), qpower(rational.recip(s), k)) =
      rational.ONE
    [by generalize generalize-s]
qed

// The clearing identity: multiplying an evaluation at r/s by s^k gives the cleared sum,
// whose terms are all integers when p's coefficients, r and s are.
theorem clearingTheDenominatorGivesTheClearedSum: forall p: QPoly;
  forall r, s: Q; forall k: peano.Nat;
  rational.nonzero(s) ->
  rational.mul(qpower(s, k),
  qevalUpTo(p, rational.mul(r, rational.recip(s)), k)) =
  qclearedSum(p, r, s, k)
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @given-s-nonzero |
                assume rational.nonzero(s) {
                  @s-nonzero |
                    rational.nonzero(s)
                    [by hypothesis given-s-nonzero]
                  // base: s^0 · 0 = 0
                  @the-zero-power |
                    qpower(s, peano.ZERO) = rational.ONE
                    [using specialize qPowerZero(s)]
                  @the-empty-evaluation |
                    qevalUpTo(p, rational.mul(r, rational.recip(s)),
                      peano.ZERO) = ZERO
                    [using specialize qEvalZero(p, rational.mul(r, rational.recip(s)))]
                  @the-empty-cleared-sum |
                    qclearedSum(p, r, s, peano.ZERO) = ZERO
                    [using specialize qClearedSumZero(p, r, s)]
                  @one-times-zero |
                    rational.mul(rational.ONE, ZERO) = ZERO
                    [using specialize rational.mulOneLeft(ZERO)]
                  @the-base-product |
                    rational.mul(qpower(s, peano.ZERO),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), peano.ZERO)) =
                      rational.mul(rational.ONE, ZERO)
                    [using simplify the-zero-power the-empty-evaluation]
                  @the-base-is-zero |
                    rational.mul(qpower(s, peano.ZERO),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), peano.ZERO)) = ZERO
                    [using simplify the-base-product one-times-zero]
                  @base-case |
                    rational.mul(qpower(s, peano.ZERO),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), peano.ZERO)) =
                      qclearedSum(p, r, s, peano.ZERO)
                    [by rewrite the-empty-cleared-sum the-base-is-zero]

                  @induction-step |
                    fix k: peano.Nat {
                      @given-inductive-hypothesis |
                        assume rational.mul(qpower(s, k),
                          qevalUpTo(p, rational.mul(r,
                          rational.recip(s)), k)) =
                          qclearedSum(p, r, s, k) {
                          @inductive-hypothesis |
                            rational.mul(qpower(s, k),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k)) =
                              qclearedSum(p, r, s, k)
                            [by hypothesis given-inductive-hypothesis]
                          @the-next-evaluation |
                            qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k)) =
                              rational.add(
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k),
                              rational.mul(qcoeff(p, k),
                              qpower(rational.mul(r,
                              rational.recip(s)), k)))
                            [using specialize qEvalSucc(p, rational.mul(r, rational.recip(s)), k)]
                          @the-next-power |
                            qpower(s, peano.succ(k)) =
                              rational.mul(s, qpower(s, k))
                            [using specialize qPowerSucc(s, k)]
                          // the quotient's power splits
                          @the-quotients-power-splits |
                            qpower(rational.mul(r,
                              rational.recip(s)), k) =
                              rational.mul(qpower(r, k),
                              qpower(rational.recip(s), k))
                            [using specialize aProductsPowerSplits(r, rational.recip(s), k)]
                          @the-powers-cancel |
                            rational.mul(qpower(s, k),
                              qpower(rational.recip(s), k)) =
                              rational.ONE
                            [using specialize aPowerCancelsTheReciprocalsPower(s, k) s-nonzero]
                          // s^(k+1) · eval(k+1)
                          //   = s·(s^k·eval k) + s·(s^k·recip(s)^k)·a_k·r^k
                          @the-product-expanded |
                            rational.mul(qpower(s, peano.succ(k)),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k))) =
                              rational.mul(
                              rational.mul(s, qpower(s, k)),
                              rational.add(
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k),
                              rational.mul(qcoeff(p, k),
                              rational.mul(qpower(r, k),
                              qpower(rational.recip(s), k)))))
                            [using simplify the-next-power the-next-evaluation the-quotients-power-splits]
                          @the-regrouping |
                            rational.mul(
                              rational.mul(s, qpower(s, k)),
                              rational.add(
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k),
                              rational.mul(qcoeff(p, k),
                              rational.mul(qpower(r, k),
                              qpower(rational.recip(s), k))))) =
                              rational.mul(s, rational.add(
                              rational.mul(qpower(s, k),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k)),
                              rational.mul(
                              rational.mul(qpower(s, k),
                              qpower(rational.recip(s), k)),
                              rational.mul(qcoeff(p, k),
                              qpower(r, k)))))
                            [using polynomial(rational)]
                          @the-product-regrouped |
                            rational.mul(qpower(s, peano.succ(k)),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k))) =
                              rational.mul(s, rational.add(
                              rational.mul(qpower(s, k),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k)),
                              rational.mul(
                              rational.mul(qpower(s, k),
                              qpower(rational.recip(s), k)),
                              rational.mul(qcoeff(p, k),
                              qpower(r, k)))))
                            [by rewrite the-regrouping the-product-expanded]
                          // substitute the hypothesis and the cancellation
                          @the-product-with-the-hypothesis |
                            rational.mul(qpower(s, peano.succ(k)),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k))) =
                              rational.mul(s, rational.add(
                              qclearedSum(p, r, s, k),
                              rational.mul(rational.ONE,
                              rational.mul(qcoeff(p, k),
                              qpower(r, k)))))
                            [using simplify the-product-regrouped inductive-hypothesis the-powers-cancel]
                          @the-unit-drops |
                            rational.mul(s, rational.add(
                              qclearedSum(p, r, s, k),
                              rational.mul(rational.ONE,
                              rational.mul(qcoeff(p, k),
                              qpower(r, k))))) =
                              rational.mul(s, rational.add(
                              qclearedSum(p, r, s, k),
                              rational.mul(qcoeff(p, k),
                              qpower(r, k))))
                            [using polynomial(rational)]
                          @the-product-cleaned |
                            rational.mul(qpower(s, peano.succ(k)),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k))) =
                              rational.mul(s, rational.add(
                              qclearedSum(p, r, s, k),
                              rational.mul(qcoeff(p, k),
                              qpower(r, k))))
                            [by rewrite the-unit-drops the-product-with-the-hypothesis]
                          @the-next-cleared-sum |
                            qclearedSum(p, r, s, peano.succ(k)) =
                              rational.mul(s, rational.add(
                              qclearedSum(p, r, s, k),
                              rational.mul(qcoeff(p, k),
                              qpower(r, k))))
                            [using specialize qClearedSumSucc(p, r, s, k)]
                          @conclusion-the-step |
                            rational.mul(qpower(s, peano.succ(k)),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k))) =
                              qclearedSum(p, r, s, peano.succ(k))
                            [by rewrite the-next-cleared-sum the-product-cleaned]
                        }
                      @induction-step-at-k |
                        (rational.mul(qpower(s, k),
                          qevalUpTo(p, rational.mul(r,
                          rational.recip(s)), k)) =
                          qclearedSum(p, r, s, k)) ->
                          (rational.mul(qpower(s, peano.succ(k)),
                          qevalUpTo(p, rational.mul(r,
                          rational.recip(s)), peano.succ(k))) =
                          qclearedSum(p, r, s, peano.succ(k)))
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-for-all-k |
                    forall k: peano.Nat;
                      (rational.mul(qpower(s, k),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), k)) =
                      qclearedSum(p, r, s, k)) ->
                      (rational.mul(qpower(s, peano.succ(k)),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), peano.succ(k))) =
                      qclearedSum(p, r, s, peano.succ(k)))
                    [by generalize induction-step]
                  @all-bounds |
                    forall k: peano.Nat;
                      rational.mul(qpower(s, k),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), k)) =
                      qclearedSum(p, r, s, k)
                    [using instantiation peano.induction((fun z: peano.Nat => (rational.mul(qpower(s, z), qevalUpTo(p, rational.mul(r, rational.recip(s)), z)) = qclearedSum(p, r, s, z)))) base-case induction-step-for-all-k]
                }
              @nonzero-implies |
                rational.nonzero(s) ->
                  (forall k: peano.Nat;
                  rational.mul(qpower(s, k),
                  qevalUpTo(p, rational.mul(r,
                  rational.recip(s)), k)) =
                  qclearedSum(p, r, s, k))
                [by discharge given-s-nonzero]
              @each-bound |
                fix k: peano.Nat {
                  @given-s-nonzero-again |
                    assume rational.nonzero(s) {
                      @s-nonzero-again |
                        rational.nonzero(s)
                        [by hypothesis given-s-nonzero-again]
                      @all-bounds-here |
                        forall k2: peano.Nat;
                          rational.mul(qpower(s, k2),
                          qevalUpTo(p, rational.mul(r,
                          rational.recip(s)), k2)) =
                          qclearedSum(p, r, s, k2)
                        [by modus_ponens nonzero-implies s-nonzero-again]
                      @conclusion-at-k |
                        rational.mul(qpower(s, k),
                          qevalUpTo(p, rational.mul(r,
                          rational.recip(s)), k)) =
                          qclearedSum(p, r, s, k)
                        [using specialize all-bounds-here(k)]
                    }
                  @nonzero-implies-at-k |
                    rational.nonzero(s) ->
                      rational.mul(qpower(s, k),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), k)) =
                      qclearedSum(p, r, s, k)
                    [by discharge given-s-nonzero-again]
                }
              @discharge-s |
                forall k: peano.Nat;
                  rational.nonzero(s) ->
                  rational.mul(qpower(s, k),
                  qevalUpTo(p, rational.mul(r,
                  rational.recip(s)), k)) =
                  qclearedSum(p, r, s, k)
                [by generalize each-bound]
            }
          @discharge-r |
            forall s9: Q; forall k: peano.Nat;
              rational.nonzero(s9) ->
              rational.mul(qpower(s9, k),
              qevalUpTo(p, rational.mul(r, rational.recip(s9)), k)) =
              qclearedSum(p, r, s9, k)
            [by generalize generalize-s]
        }
      @discharge-p |
        forall r9, s9: Q; forall k: peano.Nat;
          rational.nonzero(s9) ->
          rational.mul(qpower(s9, k),
          qevalUpTo(p, rational.mul(r9, rational.recip(s9)), k)) =
          qclearedSum(p, r9, s9, k)
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
      rational.nonzero(s) ->
      rational.mul(qpower(s, k),
      qevalUpTo(p, rational.mul(r, rational.recip(s)), k)) =
      qclearedSum(p, r, s, k)
    [by generalize generalize-p]
qed

// Every power of an integer is an integer — induction on the exponent, `isIntegerMul` at
// each step and `oneIsAnInteger` at the base.
theorem everyPowerOfAnIntegerIsAnInteger: forall a: Q;
  rational.isInteger(a) ->
  (forall k: peano.Nat; rational.isInteger(qpower(a, k)))
proof
  @generalize-a |
    fix a: Q {
      @given-a-is-an-integer |
        assume rational.isInteger(a) {
          @a-is-an-integer |
            rational.isInteger(a)
            [by hypothesis given-a-is-an-integer]
          @the-integer-products |
            forall x, y: Q; rational.isInteger(x) ->
              rational.isInteger(y) ->
              rational.isInteger(rational.mul(x, y))
            [using import(rational) isIntegerMul]
          @the-zero-power |
            qpower(a, peano.ZERO) = rational.ONE
            [using specialize qPowerZero(a)]
          @one-is-an-integer |
            rational.isInteger(rational.ONE)
            [using import(rational) oneIsAnInteger]
          @base-case |
            rational.isInteger(qpower(a, peano.ZERO))
            [by rewrite the-zero-power one-is-an-integer]

          @induction-step |
            fix k: peano.Nat {
              @given-inductive-hypothesis |
                assume rational.isInteger(qpower(a, k)) {
                  @inductive-hypothesis |
                    rational.isInteger(qpower(a, k))
                    [by hypothesis given-inductive-hypothesis]
                  @the-next-power |
                    qpower(a, peano.succ(k)) =
                      rational.mul(a, qpower(a, k))
                    [using specialize qPowerSucc(a, k)]
                  @the-product-is-an-integer |
                    rational.isInteger(rational.mul(a, qpower(a, k)))
                    [using specialize the-integer-products(a, qpower(a, k)) a-is-an-integer inductive-hypothesis]
                  @conclusion-the-step |
                    rational.isInteger(qpower(a, peano.succ(k)))
                    [by rewrite the-next-power the-product-is-an-integer]
                }
              @induction-step-at-k |
                rational.isInteger(qpower(a, k)) ->
                  rational.isInteger(qpower(a, peano.succ(k)))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: peano.Nat;
              rational.isInteger(qpower(a, k)) ->
              rational.isInteger(qpower(a, peano.succ(k)))
            [by generalize induction-step]
          @all-exponents |
            forall k: peano.Nat; rational.isInteger(qpower(a, k))
            [using instantiation peano.induction((fun z: peano.Nat => (rational.isInteger(qpower(a, z))))) base-case induction-step-for-all-k]
        }
      @integer-implies |
        rational.isInteger(a) ->
          (forall k: peano.Nat; rational.isInteger(qpower(a, k)))
        [by discharge given-a-is-an-integer]
    }
  @conclusion |
    forall a: Q;
      rational.isInteger(a) ->
      (forall k: peano.Nat; rational.isInteger(qpower(a, k)))
    [by generalize generalize-a]
qed

// -- SPLITTING THE CLEARED SUM AT EITHER END ------------------------------------------------
// 17.14 reads the cleared sum twice, from opposite ends. Every term but the first carries a
// factor r, and every term but the last carries a factor s, so:
//
//   S(k) = s^k·a_0 + r·t     for some integer t   (k >= 1)
//   S(k+1) = s·u + a_k·r^k   for some integer u
//
// The first is an induction on k; the second is just the defining clause regrouped.
theorem theClearedSumSplitsOffTheConstantTerm: forall p: QPoly;
  forall r, s: Q; forall k: peano.Nat;
  rational.isInteger(r) -> rational.isInteger(s) ->
  (forall i: peano.Nat; rational.isInteger(qcoeff(p, i))) ->
  (exists t: Q; rational.isInteger(t) and
  qclearedSum(p, r, s, peano.succ(k)) =
  rational.add(rational.mul(qpower(s, peano.succ(k)), qcoeff(p, peano.ZERO)),
  rational.mul(r, t)))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @given-the-integrality |
                assume rational.isInteger(r) and rational.isInteger(s) and
                  (forall i: peano.Nat;
                  rational.isInteger(qcoeff(p, i))) {
                  @the-integrality |
                    rational.isInteger(r) and rational.isInteger(s) and
                      (forall i: peano.Nat;
                      rational.isInteger(qcoeff(p, i)))
                    [by hypothesis given-the-integrality]
                  @r-is-an-integer |
                    rational.isInteger(r)
                    [using tautology the-integrality]
                  @s-is-an-integer |
                    rational.isInteger(s)
                    [using tautology the-integrality]
                  @the-coefficients-are-integers |
                    forall i: peano.Nat;
                      rational.isInteger(qcoeff(p, i))
                    [using tautology the-integrality]
                  @the-integer-products |
                    forall x, y: Q; rational.isInteger(x) ->
                      rational.isInteger(y) ->
                      rational.isInteger(rational.mul(x, y))
                    [using import(rational) isIntegerMul]
                  @the-integer-sums |
                    forall x, y: Q; rational.isInteger(x) ->
                      rational.isInteger(y) ->
                      rational.isInteger(rational.add(x, y))
                    [using import(rational) isIntegerAdd]

                  // base: S(1) = s·(0 + a_0·1) = s^1·a_0 + r·0
                  @the-empty-cleared-sum |
                    qclearedSum(p, r, s, peano.ZERO) = ZERO
                    [using specialize qClearedSumZero(p, r, s)]
                  @the-first-cleared-sum |
                    qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.mul(s, rational.add(
                      qclearedSum(p, r, s, peano.ZERO),
                      rational.mul(qcoeff(p, peano.ZERO),
                      qpower(r, peano.ZERO))))
                    [using specialize qClearedSumSucc(p, r, s, peano.ZERO)]
                  @the-zero-power-of-r |
                    qpower(r, peano.ZERO) = rational.ONE
                    [using specialize qPowerZero(r)]
                  @the-first-cleared-sum-expanded |
                    qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.mul(s, rational.add(ZERO,
                      rational.mul(qcoeff(p, peano.ZERO),
                      rational.ONE)))
                    [using simplify the-first-cleared-sum the-empty-cleared-sum the-zero-power-of-r]
                  @the-first-power-of-s |
                    qpower(s, peano.succ(peano.ZERO)) =
                      rational.mul(s, qpower(s, peano.ZERO))
                    [using specialize qPowerSucc(s, peano.ZERO)]
                  @the-zero-power-of-s |
                    qpower(s, peano.ZERO) = rational.ONE
                    [using specialize qPowerZero(s)]
                  @the-first-power-of-s-expanded |
                    qpower(s, peano.succ(peano.ZERO)) =
                      rational.mul(s, rational.ONE)
                    [using simplify the-first-power-of-s the-zero-power-of-s]
                  // r·0 = 0, so the remainder slot takes the witness 0
                  @r-times-zero |
                    rational.mul(r, ZERO) = ZERO
                    [using specialize rational.mulZeroRight(r)]
                  // collapse the right side's own zero first: s·(0 + a_0·1) = s·a_0
                  @s-times-zero |
                    rational.mul(s, ZERO) = ZERO
                    [using specialize rational.mulZeroRight(s)]
                  @the-right-side-collapses |
                    rational.mul(s, rational.add(ZERO,
                      rational.mul(qcoeff(p, peano.ZERO),
                      rational.ONE))) =
                      rational.add(rational.mul(s, ZERO),
                      rational.mul(s, qcoeff(p, peano.ZERO)))
                    [using polynomial(rational)]
                  @the-right-side-without-zero |
                    rational.mul(s, rational.add(ZERO,
                      rational.mul(qcoeff(p, peano.ZERO),
                      rational.ONE))) =
                      rational.add(ZERO,
                      rational.mul(s, qcoeff(p, peano.ZERO)))
                    [by rewrite s-times-zero the-right-side-collapses]
                  @the-base-target-without-r |
                    rational.add(rational.mul(
                      rational.mul(s, rational.ONE),
                      qcoeff(p, peano.ZERO)), ZERO) =
                      rational.add(ZERO,
                      rational.mul(s, qcoeff(p, peano.ZERO)))
                    [using polynomial(rational)]
                  @the-base-target-through-the-right |
                    rational.add(rational.mul(
                      rational.mul(s, rational.ONE),
                      qcoeff(p, peano.ZERO)), ZERO) =
                      rational.mul(s, rational.add(ZERO,
                      rational.mul(qcoeff(p, peano.ZERO),
                      rational.ONE)))
                    [by rewrite the-right-side-without-zero the-base-target-without-r]
                  @the-base-target |
                    rational.add(rational.mul(
                      rational.mul(s, rational.ONE),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, ZERO)) =
                      rational.mul(s, rational.add(ZERO,
                      rational.mul(qcoeff(p, peano.ZERO),
                      rational.ONE)))
                    [by rewrite r-times-zero the-base-target-through-the-right]
                  @the-base-equation |
                    qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.add(rational.mul(
                      rational.mul(s, rational.ONE),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, ZERO))
                    [by rewrite the-base-target the-first-cleared-sum-expanded]
                  @the-base-equation-in-the-power |
                    qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(peano.ZERO)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, ZERO))
                    [by rewrite the-first-power-of-s-expanded the-base-equation]
                  @zero-is-an-integer |
                    rational.isInteger(ZERO)
                    [using import(rational) zeroIsAnInteger]
                  @the-base-witness-works |
                    rational.isInteger(ZERO) and
                      qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(peano.ZERO)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, ZERO))
                    [by both zero-is-an-integer the-base-equation-in-the-power]
                  @base-case |
                    exists t: Q; rational.isInteger(t) and
                      qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(peano.ZERO)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t))
                    [by witness(ZERO) the-base-witness-works]

                  // step: S(k+2) = s·(S(k+1) + a_{k+1}·r^{k+1})
                  //              = s^{k+2}·a_0 + r·(s·(t + a_{k+1}·r^k))
                  @induction-step |
                    fix k: peano.Nat {
                      @given-inductive-hypothesis |
                        assume exists t: Q; rational.isInteger(t) and
                          qclearedSum(p, r, s, peano.succ(k)) =
                          rational.add(rational.mul(
                          qpower(s, peano.succ(k)),
                          qcoeff(p, peano.ZERO)),
                          rational.mul(r, t)) {
                          @inductive-hypothesis |
                            exists t: Q; rational.isInteger(t) and
                              qclearedSum(p, r, s, peano.succ(k)) =
                              rational.add(rational.mul(
                              qpower(s, peano.succ(k)),
                              qcoeff(p, peano.ZERO)),
                              rational.mul(r, t))
                            [by hypothesis given-inductive-hypothesis]
                          @conclusion-the-step |
                            unpack t: Q from inductive-hypothesis {
                              @the-split-at-k |
                                rational.isInteger(t) and
                                  qclearedSum(p, r, s, peano.succ(k)) =
                                  rational.add(rational.mul(
                                  qpower(s, peano.succ(k)),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t))
                                [by hypothesis conclusion-the-step]
                              @t-is-an-integer |
                                rational.isInteger(t)
                                [by and_lhs the-split-at-k]
                              @the-sum-at-k |
                                qclearedSum(p, r, s, peano.succ(k)) =
                                  rational.add(rational.mul(
                                  qpower(s, peano.succ(k)),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t))
                                [by and_rhs the-split-at-k]
                              @the-next-sum |
                                qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.mul(s, rational.add(
                                  qclearedSum(p, r, s, peano.succ(k)),
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, peano.succ(k)))))
                                [using specialize qClearedSumSucc(p, r, s, peano.succ(k))]
                              @the-next-sum-expanded |
                                qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.mul(s, rational.add(
                                  rational.add(rational.mul(
                                  qpower(s, peano.succ(k)),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t)),
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, peano.succ(k)))))
                                [by rewrite the-sum-at-k the-next-sum]
                              // r^{k+1} = r·r^k, so the last term carries r
                              @the-next-power-of-r |
                                qpower(r, peano.succ(k)) =
                                  rational.mul(r, qpower(r, k))
                                [using specialize qPowerSucc(r, k)]
                              @the-next-sum-with-r-pulled |
                                qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.mul(s, rational.add(
                                  rational.add(rational.mul(
                                  qpower(s, peano.succ(k)),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t)),
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  rational.mul(r, qpower(r, k)))))
                                [by rewrite the-next-power-of-r the-next-sum-expanded]
                              // regroup: s^{k+2}·a_0 + r·(s·(t + a_{k+1}·r^k))
                              @the-next-power-of-s |
                                qpower(s, peano.succ(peano.succ(k))) =
                                  rational.mul(s,
                                  qpower(s, peano.succ(k)))
                                [using specialize qPowerSucc(s, peano.succ(k))]
                              @the-regrouping |
                                rational.mul(s, rational.add(
                                  rational.add(rational.mul(
                                  qpower(s, peano.succ(k)),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t)),
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  rational.mul(r, qpower(r, k))))) =
                                  rational.add(rational.mul(
                                  rational.mul(s,
                                  qpower(s, peano.succ(k))),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r,
                                  rational.mul(s, rational.add(t,
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))))
                                [using polynomial(rational)]
                              @the-next-sum-regrouped |
                                qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.add(rational.mul(
                                  rational.mul(s,
                                  qpower(s, peano.succ(k))),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r,
                                  rational.mul(s, rational.add(t,
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))))
                                [by rewrite the-regrouping the-next-sum-with-r-pulled]
                              @the-next-sum-in-the-power |
                                qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.add(rational.mul(
                                  qpower(s,
                                  peano.succ(peano.succ(k))),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r,
                                  rational.mul(s, rational.add(t,
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))))
                                [by rewrite the-next-power-of-s the-next-sum-regrouped]
                              // the new witness is an integer
                              @the-powers-of-r-are-integers |
                                forall j: peano.Nat;
                                  rational.isInteger(qpower(r, j))
                                [using specialize everyPowerOfAnIntegerIsAnInteger(r) r-is-an-integer]
                              @the-k-th-power-is-an-integer |
                                rational.isInteger(qpower(r, k))
                                [using specialize the-powers-of-r-are-integers(k)]
                              @the-next-coefficient-is-an-integer |
                                rational.isInteger(
                                  qcoeff(p, peano.succ(k)))
                                [using specialize the-coefficients-are-integers(peano.succ(k))]
                              @the-new-term-is-an-integer |
                                rational.isInteger(rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k)))
                                [using specialize the-integer-products(qcoeff(p, peano.succ(k)), qpower(r, k)) the-next-coefficient-is-an-integer the-k-th-power-is-an-integer]
                              @the-new-sum-is-an-integer |
                                rational.isInteger(rational.add(t,
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))
                                [using specialize the-integer-sums(t, rational.mul(qcoeff(p, peano.succ(k)), qpower(r, k))) t-is-an-integer the-new-term-is-an-integer]
                              @the-new-witness-is-an-integer |
                                rational.isInteger(rational.mul(s,
                                  rational.add(t, rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k)))))
                                [using specialize the-integer-products(s, rational.add(t, rational.mul(qcoeff(p, peano.succ(k)), qpower(r, k)))) s-is-an-integer the-new-sum-is-an-integer]
                              @the-new-witness-works |
                                rational.isInteger(rational.mul(s,
                                  rational.add(t, rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))) and
                                  qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.add(rational.mul(
                                  qpower(s,
                                  peano.succ(peano.succ(k))),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r,
                                  rational.mul(s, rational.add(t,
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))))
                                [by both the-new-witness-is-an-integer the-next-sum-in-the-power]
                              @conclusion-extended |
                                exists t2: Q; rational.isInteger(t2) and
                                  qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.add(rational.mul(
                                  qpower(s,
                                  peano.succ(peano.succ(k))),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t2))
                                [by witness(rational.mul(s, rational.add(t, rational.mul(qcoeff(p, peano.succ(k)), qpower(r, k))))) the-new-witness-works]
                            }
                          @the-step-exported |
                            exists t2: Q; rational.isInteger(t2) and
                              qclearedSum(p, r, s,
                              peano.succ(peano.succ(k))) =
                              rational.add(rational.mul(
                              qpower(s, peano.succ(peano.succ(k))),
                              qcoeff(p, peano.ZERO)),
                              rational.mul(r, t2))
                            [by unpacked conclusion-the-step]
                        }
                      @induction-step-at-k |
                        (exists t: Q; rational.isInteger(t) and
                          qclearedSum(p, r, s, peano.succ(k)) =
                          rational.add(rational.mul(
                          qpower(s, peano.succ(k)),
                          qcoeff(p, peano.ZERO)),
                          rational.mul(r, t))) ->
                          (exists t2: Q; rational.isInteger(t2) and
                          qclearedSum(p, r, s,
                          peano.succ(peano.succ(k))) =
                          rational.add(rational.mul(
                          qpower(s, peano.succ(peano.succ(k))),
                          qcoeff(p, peano.ZERO)),
                          rational.mul(r, t2)))
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-for-all-k |
                    forall k: peano.Nat;
                      (exists t: Q; rational.isInteger(t) and
                      qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(k)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t))) ->
                      (exists t2: Q; rational.isInteger(t2) and
                      qclearedSum(p, r, s,
                      peano.succ(peano.succ(k))) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(peano.succ(k))),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t2)))
                    [by generalize induction-step]
                  @all-bounds |
                    forall k: peano.Nat;
                      exists t: Q; rational.isInteger(t) and
                      qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(k)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t))
                    [using instantiation peano.induction((fun z: peano.Nat => (exists t: Q; rational.isInteger(t) and qclearedSum(p, r, s, peano.succ(z)) = rational.add(rational.mul(qpower(s, peano.succ(z)), qcoeff(p, peano.ZERO)), rational.mul(r, t))))) base-case induction-step-for-all-k]
                }
              @the-integrality-implies |
                (rational.isInteger(r) and rational.isInteger(s) and
                  (forall i: peano.Nat;
                  rational.isInteger(qcoeff(p, i)))) ->
                  (forall k: peano.Nat;
                  exists t: Q; rational.isInteger(t) and
                  qclearedSum(p, r, s, peano.succ(k)) =
                  rational.add(rational.mul(
                  qpower(s, peano.succ(k)),
                  qcoeff(p, peano.ZERO)),
                  rational.mul(r, t)))
                [by discharge given-the-integrality]
              // move the bound binder outside the implication
              @each-bound |
                fix k: peano.Nat {
                  @given-the-integrality-again |
                    assume rational.isInteger(r) and
                      rational.isInteger(s) and
                      (forall i: peano.Nat;
                      rational.isInteger(qcoeff(p, i))) {
                      @the-integrality-again |
                        rational.isInteger(r) and
                          rational.isInteger(s) and
                          (forall i: peano.Nat;
                          rational.isInteger(qcoeff(p, i)))
                        [by hypothesis given-the-integrality-again]
                      @all-bounds-here |
                        forall k2: peano.Nat;
                          exists t: Q; rational.isInteger(t) and
                          qclearedSum(p, r, s, peano.succ(k2)) =
                          rational.add(rational.mul(
                          qpower(s, peano.succ(k2)),
                          qcoeff(p, peano.ZERO)),
                          rational.mul(r, t))
                        [by modus_ponens the-integrality-implies the-integrality-again]
                      @conclusion-at-k |
                        exists t: Q; rational.isInteger(t) and
                          qclearedSum(p, r, s, peano.succ(k)) =
                          rational.add(rational.mul(
                          qpower(s, peano.succ(k)),
                          qcoeff(p, peano.ZERO)),
                          rational.mul(r, t))
                        [using specialize all-bounds-here(k)]
                    }
                  @the-implication-at-k |
                    (rational.isInteger(r) and rational.isInteger(s) and
                      (forall i: peano.Nat;
                      rational.isInteger(qcoeff(p, i)))) ->
                      (exists t: Q; rational.isInteger(t) and
                      qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(k)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t)))
                    [by discharge given-the-integrality-again]
                  @curried-at-k |
                    rational.isInteger(r) -> rational.isInteger(s) ->
                      (forall i: peano.Nat;
                      rational.isInteger(qcoeff(p, i))) ->
                      (exists t: Q; rational.isInteger(t) and
                      qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(k)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t)))
                    [using tautology the-implication-at-k]
                }
              @discharge-s |
                forall k: peano.Nat;
                  rational.isInteger(r) -> rational.isInteger(s) ->
                  (forall i: peano.Nat;
                  rational.isInteger(qcoeff(p, i))) ->
                  (exists t: Q; rational.isInteger(t) and
                  qclearedSum(p, r, s, peano.succ(k)) =
                  rational.add(rational.mul(
                  qpower(s, peano.succ(k)),
                  qcoeff(p, peano.ZERO)),
                  rational.mul(r, t)))
                [by generalize each-bound]
            }
          @discharge-r |
            forall s9: Q; forall k: peano.Nat;
              rational.isInteger(r) -> rational.isInteger(s9) ->
              (forall i: peano.Nat;
              rational.isInteger(qcoeff(p, i))) ->
              (exists t: Q; rational.isInteger(t) and
              qclearedSum(p, r, s9, peano.succ(k)) =
              rational.add(rational.mul(
              qpower(s9, peano.succ(k)),
              qcoeff(p, peano.ZERO)),
              rational.mul(r, t)))
            [by generalize generalize-s]
        }
      @discharge-p |
        forall r9, s9: Q; forall k: peano.Nat;
          rational.isInteger(r9) -> rational.isInteger(s9) ->
          (forall i: peano.Nat; rational.isInteger(qcoeff(p, i))) ->
          (exists t: Q; rational.isInteger(t) and
          qclearedSum(p, r9, s9, peano.succ(k)) =
          rational.add(rational.mul(
          qpower(s9, peano.succ(k)),
          qcoeff(p, peano.ZERO)),
          rational.mul(r9, t)))
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
      rational.isInteger(r) -> rational.isInteger(s) ->
      (forall i: peano.Nat; rational.isInteger(qcoeff(p, i))) ->
      (exists t: Q; rational.isInteger(t) and
      qclearedSum(p, r, s, peano.succ(k)) =
      rational.add(rational.mul(qpower(s, peano.succ(k)),
      qcoeff(p, peano.ZERO)),
      rational.mul(r, t)))
    [by generalize generalize-p]
qed

// The other end: the defining clause already puts every term but the last under a factor s.
theorem theClearedSumSplitsOffTheLeadingTerm: forall p: QPoly;
  forall r, s: Q; forall k: peano.Nat;
  (exists u: Q;
  qclearedSum(p, r, s, peano.succ(k)) =
  rational.add(rational.mul(s, u),
  rational.mul(s, rational.mul(qcoeff(p, k), qpower(r, k)))))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @generalize-k |
                fix k: peano.Nat {
                  @the-defining-clause |
                    qclearedSum(p, r, s, peano.succ(k)) =
                      rational.mul(s, rational.add(
                      qclearedSum(p, r, s, k),
                      rational.mul(qcoeff(p, k), qpower(r, k))))
                    [using specialize qClearedSumSucc(p, r, s, k)]
                  @the-distribution |
                    rational.mul(s, rational.add(
                      qclearedSum(p, r, s, k),
                      rational.mul(qcoeff(p, k), qpower(r, k)))) =
                      rational.add(rational.mul(s,
                      qclearedSum(p, r, s, k)),
                      rational.mul(s, rational.mul(qcoeff(p, k),
                      qpower(r, k))))
                    [using polynomial(rational)]
                  @the-split |
                    qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(s,
                      qclearedSum(p, r, s, k)),
                      rational.mul(s, rational.mul(qcoeff(p, k),
                      qpower(r, k))))
                    [by rewrite the-distribution the-defining-clause]
                  @conclusion-at-k |
                    exists u: Q;
                      qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(s, u),
                      rational.mul(s, rational.mul(qcoeff(p, k),
                      qpower(r, k))))
                    [by witness(qclearedSum(p, r, s, k)) the-split]
                }
              @discharge-k |
                forall k: peano.Nat;
                  (exists u: Q;
                  qclearedSum(p, r, s, peano.succ(k)) =
                  rational.add(rational.mul(s, u),
                  rational.mul(s, rational.mul(qcoeff(p, k),
                  qpower(r, k)))))
                [by generalize generalize-k]
            }
          @discharge-s |
            forall s9: Q; forall k: peano.Nat;
              (exists u: Q;
              qclearedSum(p, r, s9, peano.succ(k)) =
              rational.add(rational.mul(s9, u),
              rational.mul(s9, rational.mul(qcoeff(p, k),
              qpower(r, k)))))
            [by generalize generalize-s]
        }
      @discharge-r |
        forall r9, s9: Q; forall k: peano.Nat;
          (exists u: Q;
          qclearedSum(p, r9, s9, peano.succ(k)) =
          rational.add(rational.mul(s9, u),
          rational.mul(s9, rational.mul(qcoeff(p, k),
          qpower(r9, k)))))
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
      (exists u: Q;
      qclearedSum(p, r, s, peano.succ(k)) =
      rational.add(rational.mul(s, u),
      rational.mul(s, rational.mul(qcoeff(p, k), qpower(r, k)))))
    [by generalize generalize-p]
qed

// -- THE TRIPLE-PRODUCT HELPERS, FOR THE ASSOCIATIVITY TRANSFER ----------------------------
// `std/field/polynomial-associativity.b4m` proves `polyMulIsAssociative` by re-proving
// Judson's double-sum exchange at the concrete triple family, and it inducts on five helper
// funcs of its own. A transfer RE-CHECKS the source proof, so ℚ[x] must declare each of them
// with its defining clauses, exactly as it already does for `qtailConvolution` and `qsegment`.
//
// That file uses nothing field-specific — `--axioms` on `polyMulIsAssociative` shows six
// `std/field.b4m` axioms and every one is a RING axiom — so the development would sit more
// honestly in `std/ring/polynomial*.b4m`. Moving it is queue item 5's territory; declaring the
// helpers here is the cheap route to the same result, and it is the route the corpus already
// takes for the convolution helpers.
// The index arithmetic, NAMED rather than subtracted — the ring proof carries a term's three
// exponents and computes the cofactor index with these, so nothing here writes
// `sub(sub(i,j),k)` and nothing owes a subtraction guard.
oper qmonus(i: Nat, j: Nat) => Nat:
  qmonus(i, NAT_ZERO) = i;
  qmonus(i, j) = qmonus(peano.prev(i), peano.prev(j)) when i != NAT_ZERO and j != NAT_ZERO;
  qmonus(NAT_ZERO, j) = NAT_ZERO when j != NAT_ZERO.
  termination(peano): _, {qmonusIsGrounded, qmonusGrounded}, _

oper qtheCofactorIndex(i: Nat, j: Nat, k: Nat) => Nat:
  qtheCofactorIndex(i, j, NAT_ZERO) = qmonus(i, j);
  qtheCofactorIndex(i, j, peano.succ(k)) = qmonus(qmonus(i, j), peano.succ(k)).

// The recursion descends by `peano.prev` rather than matching `peano.succ` on the left, which the
// l-value rule requires of a recursive definition — the descent must be readable on the RIGHT.
// Every index that used to be written bare (the clause variable denoted the PREDECESSOR when
// the arm matched `peano.succ(n)`) is now `peano.prev(n)`, since the PARAMETER is what `peano.succ(n)`
// used to be: the recursive call, `qcoeff(q, ·)` and `qmonus(g, ·)` all take it.
// `qmonus` is total, so it owes nothing beyond `peano.prev`'s own guard, which the arm's
// condition discharges.
oper qcappedRun(q: QPoly, r: QPoly, g: Nat, n: Nat) => Q:
  qcappedRun(q, r, g, NAT_ZERO) = ZERO;
  qcappedRun(q, r, g, n) = rational.add(qcappedRun(q, r, g, peano.prev(n)), rational.mul(qcoeff(q, peano.prev(n)), qcoeff(r, qmonus(g, peano.prev(n))))) when n != NAT_ZERO.
  termination(peano): _, {qcappedRunIsGrounded, qcappedRunGrounded}

oper qtripleTerm(p: QPoly, q: QPoly, r: QPoly, i: Nat, j: Nat, k: Nat) => Q:
  qtripleTerm(p, q, r, i, j, k) = rational.mul(rational.mul(qcoeff(p, j), qcoeff(q, k)), qcoeff(r, qtheCofactorIndex(i, j, k))).

// The recursion descends by `peano.prev` rather than matching `peano.succ` on the left, which
// the l-value rule requires of a recursive definition — the descent must be readable on the
// RIGHT. Both former bare `n`s became `peano.prev(n)`: the parameter now denotes what the old
// arm matched as `peano.succ(n)`, so the accumulated sum and the added term both step back.
oper qtripleRow(p: QPoly, q: QPoly, r: QPoly, i: Nat, j: Nat, n: Nat) => Q:
  qtripleRow(p, q, r, i, j, NAT_ZERO) = ZERO;
  qtripleRow(p, q, r, i, j, n) =
  rational.add(qtripleRow(p, q, r, i, j, peano.prev(n)), qtripleTerm(p, q, r, i, j, peano.prev(n))) when n != NAT_ZERO.
  termination(peano): _, {qtripleRowIsGrounded, qtripleRowGrounded}

// The recursion descends by `peano.prev`, which the l-value rule requires — the descent must
// be readable on the RIGHT. THREE former bare `c`s became `peano.prev(c)`: the accumulated
// sum, the term's own index, and the index inside `qmonus`. The parameter now denotes what the
// old arm matched as `peano.succ(c)`, so every one of them steps back.
//
// `qmonus` is TOTAL (it floors at zero), so `qmonus(m, peano.prev(c))` owes nothing beyond
// `peano.prev(c)`'s own `c != NAT_ZERO`, which the arm's guard supplies.
oper qtripleDiag(p: QPoly, q: QPoly, r: QPoly, i: Nat, m: Nat, c: Nat) => Q:
  qtripleDiag(p, q, r, i, m, NAT_ZERO) = ZERO;
  qtripleDiag(p, q, r, i, m, c) =
  rational.add(qtripleDiag(p, q, r, i, m, peano.prev(c)),
  qtripleTerm(p, q, r, i, peano.prev(c), qmonus(m, peano.prev(c)))) when c != NAT_ZERO.
  termination(peano): _, {qtripleDiagIsGrounded, qtripleDiagGrounded}

// The recursion descends by `peano.prev`, which the l-value rule requires. The payload's two
// indices move DIFFERENTLY, the subtlety here: the accumulated triangle steps back to
// `peano.prev(n)`, but the anti-diagonal's LENGTH was `peano.succ(n)` against the old matched
// argument, and the parameter now IS that `peano.succ(n)` — so it becomes plain `n`, not
// `peano.succ(peano.prev(n))`.
oper qtripleTri(p: QPoly, q: QPoly, r: QPoly, i: Nat, n: Nat) => Q:
  qtripleTri(p, q, r, i, NAT_ZERO) = ZERO;
  qtripleTri(p, q, r, i, n) =
  rational.add(qtripleTri(p, q, r, i, peano.prev(n)), qtripleDiag(p, q, r, i, peano.prev(n), n)) when n != NAT_ZERO.
  termination(peano): _, {qtripleTriIsGrounded, qtripleTriGrounded}

// The recursion descends by `peano.prev`, which the l-value rule requires. NOTE the descent is
// on `m`, the FIFTH of six arguments — `n` rides through AFTER it, so the base arm's pattern
// sits mid-list and the generated predicate narrows that slot. Three former bare `m`s became
// `peano.prev(m)`: the accumulated rows, the row index, and the index `qmonus` subtracts from.
oper qtripleRows(p: QPoly, q: QPoly, r: QPoly, i: Nat, m: Nat, n: Nat) => Q:
  qtripleRows(p, q, r, i, NAT_ZERO, n) = ZERO;
  qtripleRows(p, q, r, i, m, n) =
  rational.add(qtripleRows(p, q, r, i, peano.prev(m), n),
  qtripleRow(p, q, r, i, peano.prev(m), qmonus(n, peano.prev(m)))) when m != NAT_ZERO.
  termination(peano): _, {qtripleRowsIsGrounded, qtripleRowsGrounded}

// ℚ[x]'s associativity. TRANSFERRED straight from the ring layer: `ring_poly` proves
// `polyMulIsAssociative` over the triple-sum families, and `RationalPolynomialsOverARing`
// already maps ℚ[x] onto them — so the bespoke model this once needed (and the separate F[x]
// associativity file it transferred from) are both retired.
theorem qMulIsAssociative: forall p, q, r: QPoly;
  qmulP(qmulP(p, q), r) = qmulP(p, qmulP(q, r))
proof
  @conclusion |
    forall p, q, r: QPoly;
      qmulP(qmulP(p, q), r) = qmulP(p, qmulP(q, r))
    [using model(RationalPolynomialsOverARing) ring_poly.polyMulIsAssociative]
qed

// -- COMBINING TWO CONSTANT SCALINGS -------------------------------------------------------
// Two constant monomials multiply to the constant monomial of the product. Coefficientwise
// via the scaling law: the left scaling pulls `c` out, and what remains is `d`'s own
// monomial coefficient, so both sides read `mul(c, qcoeff(qmonomial(d, 0), i))`.
theorem theConstantMonomialProductAgreesCoefficientwise: forall c, d: Q; forall i: Nat;
  qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
  qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
proof
  @generalize-c |
    fix c: Q {
      @generalize-d |
        fix d: Q {
          @generalize-i |
            fix i: Nat {
              @the-left-scaling |
                qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
                  rational.mul(c, qcoeff(qmonomial(d, NAT_ZERO), i))
                [using specialize
                  scalingByAConstantScalesTheCoefficients(qmonomial(d, NAT_ZERO), c, i)]
              @the-index-is-zero-or-not |
                i = NAT_ZERO or (not (i = NAT_ZERO))
                [using tautology]
              @the-coefficients-agree |
                qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
                  qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
                [by common_conclusion the-index-is-zero-or-not
                  when-the-index-is-zero when-the-index-is-elsewhere]
              @when-the-index-is-zero |
                assume i = NAT_ZERO {
                  @the-index |
                    i = NAT_ZERO
                    [by hypothesis when-the-index-is-zero]
                  @the-inner-coefficient-is-d |
                    qcoeff(qmonomial(d, NAT_ZERO), NAT_ZERO) = d
                    [using specialize qMonomialCoeffAtItsIndex(d, NAT_ZERO)]
                  @the-outer-coefficient-is-the-product |
                    qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), NAT_ZERO) =
                      rational.mul(c, d)
                    [using specialize qMonomialCoeffAtItsIndex(rational.mul(c, d), NAT_ZERO)]
                  @the-scaling-at-zero |
                    qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), NAT_ZERO) =
                      rational.mul(c, qcoeff(qmonomial(d, NAT_ZERO), NAT_ZERO))
                    [by rewrite the-index the-left-scaling]
                  @conclusion-the-coefficients-agree-at-zero |
                    qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
                      qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
                    [using simplify the-index the-scaling-at-zero
                      the-inner-coefficient-is-d the-outer-coefficient-is-the-product]
                }
              @when-the-index-is-elsewhere |
                assume not (i = NAT_ZERO) {
                  @the-index-misses |
                    not (i = NAT_ZERO)
                    [by hypothesis when-the-index-is-elsewhere]
                  @the-inner-coefficient-vanishes |
                    qcoeff(qmonomial(d, NAT_ZERO), i) = ZERO
                    [using specialize qMonomialCoeffElsewhere(d, NAT_ZERO, i) the-index-misses]
                  @the-outer-coefficient-vanishes |
                    qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i) = ZERO
                    [using specialize
                      qMonomialCoeffElsewhere(rational.mul(c, d), NAT_ZERO, i) the-index-misses]
                  @the-scaled-zero-is-zero |
                    rational.mul(c, ZERO) = ZERO
                    [using specialize rational.mulZeroRight(c)]
                  @conclusion-the-coefficients-agree-elsewhere |
                    qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
                      qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
                    [using simplify the-left-scaling the-inner-coefficient-vanishes
                      the-scaled-zero-is-zero the-outer-coefficient-vanishes]
                }
            }
          @conclusion-for-all-i |
            forall i: Nat;
              qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
              qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
            [by generalize generalize-i]
        }
      @conclusion-for-all-d |
        forall d: Q; forall i: Nat;
          qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
          qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
        [by generalize generalize-d]
    }
  @conclusion |
    forall c, d: Q; forall i: Nat;
      qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
      qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
    [by generalize generalize-c]
qed

// Hence the monomials themselves are equal, by extensionality.
theorem theProductOfConstantMonomials: forall c, d: Q;
  qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)) =
  qmonomial(rational.mul(c, d), NAT_ZERO)
proof
  @generalize-c |
    fix c: Q {
      @generalize-d |
        fix d: Q {
          @the-coefficients-agree |
            forall i: Nat;
              qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
              qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
            [using specialize theConstantMonomialProductAgreesCoefficientwise(c, d)]
          @conclusion-the-monomials-are-equal |
            qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)) =
              qmonomial(rational.mul(c, d), NAT_ZERO)
            [using specialize qPolyExtensionality(
              qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)),
              qmonomial(rational.mul(c, d), NAT_ZERO)) the-coefficients-agree]
        }
      @conclusion-for-all-d |
        forall d: Q;
          qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)) =
          qmonomial(rational.mul(c, d), NAT_ZERO)
        [by generalize generalize-d]
    }
  @conclusion |
    forall c, d: Q;
      qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)) =
      qmonomial(rational.mul(c, d), NAT_ZERO)
    [by generalize generalize-c]
qed

// -- A NONZERO SCALING REFLECTS A DEGREE BOUND ----------------------------------------------
// Coefficientwise first: above the bound the scaled coefficient is ZERO, and
// `mul(c, qcoeff(q, i)) = ZERO` with `c != ZERO` forces `qcoeff(q, i) = ZERO` by
// `noZeroDivisors`.
theorem aNonzeroScalingReflectsTheVanishing: forall q: QPoly; forall c: Q; forall n: Nat;
  (not (c = ZERO)) ->
  (forall i: Nat; peano.less_than(n, i) ->
  qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
  (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
proof
  @generalize-q |
    fix q: QPoly {
      @generalize-c |
        fix c: Q {
          @generalize-n |
            fix n: Nat {
              @given-the-scalar-is-nonzero |
                assume not (c = ZERO) {
                  @the-scalar-is-nonzero |
                    not (c = ZERO)
                    [by hypothesis given-the-scalar-is-nonzero]
                  @given-the-scaled-vanishing |
                    assume forall i: Nat; peano.less_than(n, i) ->
                      qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO {
                      @the-scaled-coefficients-vanish |
                        forall i: Nat; peano.less_than(n, i) ->
                          qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO
                        [by hypothesis given-the-scaled-vanishing]
                      @generalize-i |
                        fix i: Nat {
                          @given-above-the-bound |
                            assume peano.less_than(n, i) {
                              @above-the-bound |
                                peano.less_than(n, i)
                                [by hypothesis given-above-the-bound]
                              @the-scaled-coefficient-vanishes |
                                qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO
                                [using specialize
                                  the-scaled-coefficients-vanish(i) above-the-bound]
                              @the-scaling-law |
                                qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) =
                                  rational.mul(c, qcoeff(q, i))
                                [using specialize
                                  scalingByAConstantScalesTheCoefficients(q, c, i)]
                              @the-product-vanishes |
                                rational.mul(c, qcoeff(q, i)) = ZERO
                                [by rewrite the-scaling-law the-scaled-coefficient-vanishes]
                              @one-factor-vanishes |
                                c = ZERO or qcoeff(q, i) = ZERO
                                [using specialize rational.noZeroDivisors(
                                  c, qcoeff(q, i)) the-product-vanishes]
                              @conclusion-the-coefficient-vanishes |
                                qcoeff(q, i) = ZERO
                                [using tautology one-factor-vanishes the-scalar-is-nonzero]
                            }
                          @conclusion-above-the-bound-it-vanishes |
                            peano.less_than(n, i) -> qcoeff(q, i) = ZERO
                            [by discharge given-above-the-bound]
                        }
                      @conclusion-the-coefficients-vanish |
                        forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO
                        [by generalize generalize-i]
                    }
                  @conclusion-the-scaled-vanishing-gives-it |
                    (forall i: Nat; peano.less_than(n, i) ->
                      qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
                      (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
                    [by discharge given-the-scaled-vanishing]
                }
              @conclusion-nonzero-gives-it |
                (not (c = ZERO)) ->
                  (forall i: Nat; peano.less_than(n, i) ->
                  qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
                  (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
                [by discharge given-the-scalar-is-nonzero]
            }
          @conclusion-for-all-n |
            forall n: Nat;
              (not (c = ZERO)) ->
              (forall i: Nat; peano.less_than(n, i) ->
              qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
              (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
            [by generalize generalize-n]
        }
      @conclusion-for-all-c |
        forall c: Q; forall n: Nat;
          (not (c = ZERO)) ->
          (forall i: Nat; peano.less_than(n, i) ->
          qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
          (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
        [by generalize generalize-c]
    }
  @conclusion |
    forall q: QPoly; forall c: Q; forall n: Nat;
      (not (c = ZERO)) ->
      (forall i: Nat; peano.less_than(n, i) ->
      qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
      (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
    [by generalize generalize-q]
qed

// Hence the degree bound itself transfers, unfolding `qdegreeAtMost` on both sides.
//
// This is the converse direction a factorization argument needs: Lemma 17.12 hands back a
// primitive part with INTEGER COEFFICIENTS UP TO A BOUND but no degree bound of its own, and
// the bound has to be recovered from the scaling equation.
theorem aNonzeroScalingReflectsTheDegreeBound: forall q: QPoly; forall c: Q; forall n: Nat;
  (not (c = ZERO)) ->
  qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
  qdegreeAtMost(q, n)
proof
  @generalize-q |
    fix q: QPoly {
      @generalize-c |
        fix c: Q {
          @generalize-n |
            fix n: Nat {
              @given-the-scalar-is-nonzero |
                assume not (c = ZERO) {
                  @the-scalar-is-nonzero |
                    not (c = ZERO)
                    [by hypothesis given-the-scalar-is-nonzero]
                  @given-the-scaled-bound |
                    assume qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) {
                      @the-scaled-bound |
                        qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n)
                        [by hypothesis given-the-scaled-bound]
                      @the-scaled-bound-unfolds |
                        qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) iff
                          (forall i: Nat; peano.less_than(n, i) ->
                          qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO)
                        [using specialize qDegreeAtMostMeaning(
                          qmulP(qmonomial(c, NAT_ZERO), q), n)]
                      @the-scaled-bound-forward |
                        qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
                          (forall i: Nat; peano.less_than(n, i) ->
                          qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO)
                        [by equiv_forward the-scaled-bound-unfolds]
                      @the-scaled-coefficients-vanish |
                        forall i: Nat; peano.less_than(n, i) ->
                          qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO
                        [by modus_ponens the-scaled-bound-forward the-scaled-bound]
                      @the-coefficients-vanish |
                        forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO
                        [using specialize aNonzeroScalingReflectsTheVanishing(q, c, n)
                          the-scalar-is-nonzero the-scaled-coefficients-vanish]
                      @the-bound-unfolds |
                        qdegreeAtMost(q, n) iff
                          (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
                        [using specialize qDegreeAtMostMeaning(q, n)]
                      @the-bound-backward |
                        (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO) ->
                          qdegreeAtMost(q, n)
                        [by equiv_converse the-bound-unfolds]
                      @conclusion-the-bound-holds |
                        qdegreeAtMost(q, n)
                        [by modus_ponens the-bound-backward the-coefficients-vanish]
                    }
                  @conclusion-the-scaled-bound-gives-it |
                    qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
                      qdegreeAtMost(q, n)
                    [by discharge given-the-scaled-bound]
                }
              @conclusion-nonzero-gives-it |
                (not (c = ZERO)) ->
                  qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
                  qdegreeAtMost(q, n)
                [by discharge given-the-scalar-is-nonzero]
            }
          @conclusion-for-all-n |
            forall n: Nat;
              (not (c = ZERO)) ->
              qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
              qdegreeAtMost(q, n)
            [by generalize generalize-n]
        }
      @conclusion-for-all-c |
        forall c: Q; forall n: Nat;
          (not (c = ZERO)) ->
          qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
          qdegreeAtMost(q, n)
        [by generalize generalize-c]
    }
  @conclusion |
    forall q: QPoly; forall c: Q; forall n: Nat;
      (not (c = ZERO)) ->
      qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
      qdegreeAtMost(q, n)
    [by generalize generalize-q]
qed

// -- definition-clause shims ---------------------------------------------------------------
//
// The symbols above are DEFINITION BLOCKS, so `--axioms` reports their clauses as
// definitions rather than as assumptions to weigh. A clause has no user-facing name,
// though, and a model's `<-` and `specialize` both resolve BY NAME — so each clause keeps a
// one-line theorem under the name it had as an axiom. These add no assumption: every one is
// proved `[by definition(N) <symbol>]`.

theorem qAddPolyCoeff:
  forall p, q: QPoly; forall i: Nat;
  qcoeff(qaddP(p, q), i) = rational.add(qcoeff(p, i), qcoeff(q, i))
proof
  @conclusion |
    forall p, q: QPoly; forall i: Nat;
      qcoeff(qaddP(p, q), i) = rational.add(qcoeff(p, i), qcoeff(q, i))
    [by definition qaddP]
qed

theorem qNegPolyCoeff:
  forall p: QPoly; forall i: Nat;
  qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
proof
  @conclusion |
    forall p: QPoly; forall i: Nat;
      qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
    [by definition qnegP]
qed

theorem qMulPolyCoeff:
  forall p, q: QPoly; forall i: Nat;
  qcoeff(qmulP(p, q), i) = qconvolution(p, q, NAT_ZERO, i)
proof
  @conclusion |
    forall p, q: QPoly; forall i: Nat;
      qcoeff(qmulP(p, q), i) = qconvolution(p, q, NAT_ZERO, i)
    [by definition qmulP]
qed

theorem qMonomialCoeffAtItsIndex:
  forall a: Q; forall k: Nat;
  qcoeff(qmonomial(a, k), k) = a
proof
  @conclusion |
    forall a: Q; forall k: Nat;
      qcoeff(qmonomial(a, k), k) = a
    [by definition(0) qmonomial]
qed

theorem qMonomialCoeffElsewhere:
  forall a: Q; forall k, i: Nat;
  (not (i = k)) -> qcoeff(qmonomial(a, k), i) = ZERO
proof
  @conclusion |
    forall a: Q; forall k, i: Nat;
      (not (i = k)) -> qcoeff(qmonomial(a, k), i) = ZERO
    [by definition(1) qmonomial]
qed

theorem qConvolutionZero:
  forall p, q: QPoly; forall j: Nat;
  qconvolution(p, q, j, NAT_ZERO) =
  rational.mul(qcoeff(p, j), qcoeff(q, NAT_ZERO))
proof
  @conclusion |
    forall p, q: QPoly; forall j: Nat;
      qconvolution(p, q, j, NAT_ZERO) =
      rational.mul(qcoeff(p, j), qcoeff(q, NAT_ZERO))
    [by definition(0) qconvolution]
qed

// DERIVED, not transcribed: the clause descends by `peano.prev`, so this restates it at a
// successor where `prevOfSucc` collapses the `prev`. The STATEMENT is unchanged, which keeps
// the clause's `m != NAT_ZERO` guard from reaching any call site.
theorem qConvolutionSucc:
  forall p, q: QPoly; forall j, m: Nat;
  qconvolution(p, q, j, peano.succ(m)) =
  rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(m))),
  qconvolution(p, q, peano.succ(j), m))
proof
  @the-recursive-clause |
    forall p2: QPoly; forall q2: QPoly; forall j2: Nat; forall m2: Nat;
      m2 != NAT_ZERO ->
      qconvolution(p2, q2, j2, m2) =
      rational.add(rational.mul(qcoeff(p2, j2), qcoeff(q2, m2)),
      qconvolution(p2, q2, peano.succ(j2), peano.prev(m2)))
    [by definition(1) qconvolution]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @succ-m-is-nonzero |
                    peano.succ(m) != NAT_ZERO
                    [using specialize a-successor-is-never-zero(m)]
                  @clause-at-the-successor |
                    qconvolution(p, q, j, peano.succ(m)) =
                      rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(m))),
                      qconvolution(p, q, peano.succ(j), peano.prev(peano.succ(m))))
                    [using specialize the-recursive-clause(p, q, j, peano.succ(m)) succ-m-is-nonzero]
                  @prev-of-succ-m |
                    peano.prev(peano.succ(m)) = m
                    [using specialize prev-undoes-succ(m)]
                  @conclusion-step-at-m |
                    qconvolution(p, q, j, peano.succ(m)) =
                      rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(m))),
                      qconvolution(p, q, peano.succ(j), m))
                    [by rewrite prev-of-succ-m clause-at-the-successor]
                }
              @discharge-m |
                forall m: Nat;
                  qconvolution(p, q, j, peano.succ(m)) =
                  rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(m))),
                  qconvolution(p, q, peano.succ(j), m))
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j, m: Nat;
              qconvolution(p, q, j, peano.succ(m)) =
              rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(m))),
              qconvolution(p, q, peano.succ(j), m))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: QPoly; forall j, m: Nat;
          qconvolution(p, q, j, peano.succ(m)) =
          rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(m))),
          qconvolution(p, q, peano.succ(j), m))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; forall j, m: Nat;
      qconvolution(p, q, j, peano.succ(m)) =
      rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(m))),
      qconvolution(p, q, peano.succ(j), m))
    [by generalize generalize-p]
qed

theorem qTailConvolutionZero:
  forall p, q: QPoly; forall m: Nat;
  qtailConvolution(p, q, NAT_ZERO, m) =
  rational.mul(qcoeff(p, NAT_ZERO), qcoeff(q, m))
proof
  @conclusion |
    forall p, q: QPoly; forall m: Nat;
      qtailConvolution(p, q, NAT_ZERO, m) =
      rational.mul(qcoeff(p, NAT_ZERO), qcoeff(q, m))
    [by definition(0) qtailConvolution]
qed

// The `succ` step, now DERIVED rather than transcribed: the definition descends by `prev`
// (the l-value rule keeps patterns off the left), so this restates it at a successor, where
// `prevOfSucc` collapses the `prev`. The STATEMENT is unchanged, which is what confines the
// migration — every call site cites this theorem, not the clause, so the clause's `j != NAT_ZERO`
// guard never reaches them.
theorem qTailConvolutionSucc:
  forall p, q: QPoly; forall j, m: Nat;
  qtailConvolution(p, q, peano.succ(j), m) =
  rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, m)),
  qtailConvolution(p, q, j, peano.succ(m)))
proof
  @the-recursive-clause |
    forall p2: QPoly; forall q2: QPoly; forall j2: Nat; forall m2: Nat;
      j2 != NAT_ZERO ->
      qtailConvolution(p2, q2, j2, m2) =
      rational.add(rational.mul(qcoeff(p2, j2), qcoeff(q2, m2)), qtailConvolution(p2, q2, peano.prev(j2), peano.succ(m2)))
    [by definition(1) qtailConvolution]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @succ-j-is-nonzero |
                    peano.succ(j) != NAT_ZERO
                    [using specialize a-successor-is-never-zero(j)]
                  @clause-at-the-successor |
                    qtailConvolution(p, q, peano.succ(j), m) =
                      rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, m)),
                      qtailConvolution(p, q, peano.prev(peano.succ(j)), peano.succ(m)))
                    [using specialize the-recursive-clause(p, q, peano.succ(j), m) succ-j-is-nonzero]
                  @prev-of-succ-j |
                    peano.prev(peano.succ(j)) = j
                    [using specialize prev-undoes-succ(j)]
                  @conclusion-step-at-j |
                    qtailConvolution(p, q, peano.succ(j), m) =
                      rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, m)),
                      qtailConvolution(p, q, j, peano.succ(m)))
                    [by rewrite prev-of-succ-j clause-at-the-successor]
                }
              @discharge-m |
                forall m: Nat;
                  qtailConvolution(p, q, peano.succ(j), m) =
                  rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, m)),
                  qtailConvolution(p, q, j, peano.succ(m)))
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j, m: Nat;
              qtailConvolution(p, q, peano.succ(j), m) =
              rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, m)),
              qtailConvolution(p, q, j, peano.succ(m)))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: QPoly; forall j, m: Nat;
          qtailConvolution(p, q, peano.succ(j), m) =
          rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, m)),
          qtailConvolution(p, q, j, peano.succ(m)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; forall j, m: Nat;
      qtailConvolution(p, q, peano.succ(j), m) =
      rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, m)),
      qtailConvolution(p, q, j, peano.succ(m)))
    [by generalize generalize-p]
qed

theorem qSegmentZero:
  forall p, q: QPoly; forall j, c: Nat;
  qsegment(p, q, j, c, NAT_ZERO) = rational.mul(qcoeff(p, j), qcoeff(q, c))
proof
  @conclusion |
    forall p, q: QPoly; forall j, c: Nat;
      qsegment(p, q, j, c, NAT_ZERO) = rational.mul(qcoeff(p, j), qcoeff(q, c))
    [by definition(0) qsegment]
qed

// The step: groundedness below `peano.succ(n)` gives it at `peano.succ(n)`. Either the predecessor `n`
// is itself the base (the right disjunct fires) or the inductive hypothesis supplies it. The
// riding exponents `j` and `c` take no part — the generated predicate does not mention them.
theorem qsegmentReachesABaseFromAPredecessor: forall n: Nat;
  (forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qsegmentGrounded(n))
  -> (forall q, r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qsegmentGrounded(peano.succ(n)))
proof
  @the-generated-clause |
    forall n3: Nat; qsegmentGrounded(n3) iff
      (qsegmentGrounded(peano.prev(n3)) or peano.prev(n3) = NAT_ZERO)
    [by definition qsegmentGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-n |
    fix n: Nat {
      @given-the-inductive-hypothesis |
        assume forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qsegmentGrounded(n) {
          @inductive-hypothesis |
            forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qsegmentGrounded(n)
            [by hypothesis given-the-inductive-hypothesis]
          // `peano.prev` is guarded, so these precede every term that writes `peano.prev(peano.succ(n))`.
          @succ-n-is-nonzero |
            peano.succ(n) != NAT_ZERO
            [using specialize a-successor-is-never-zero(n)]
          @prev-of-succ-n-is-n |
            peano.prev(peano.succ(n)) = n
            [using specialize prev-undoes-succ(n)]
          @generalize-q |
            fix q: QPoly {
              @generalize-r |
                fix r: QPoly {
                  @generalize-j |
                    fix j: Nat {
                      @generalize-c |
                        fix c: Nat {
                          @given-succ-n-nonzero |
                            assume peano.succ(n) != NAT_ZERO {
                              @clause-at-the-successor |
                                qsegmentGrounded(peano.succ(n)) iff
                                  (qsegmentGrounded(peano.prev(peano.succ(n))) or peano.prev(peano.succ(n)) = NAT_ZERO)
                                [using specialize the-generated-clause(peano.succ(n))]
                              @clause-with-the-predecessor-collapsed |
                                qsegmentGrounded(peano.succ(n)) iff
                                  (qsegmentGrounded(n) or n = NAT_ZERO)
                                [by rewrite prev-of-succ-n-is-n clause-at-the-successor]
                              @the-inductive-hypothesis-here |
                                n != NAT_ZERO -> qsegmentGrounded(n)
                                [using specialize inductive-hypothesis(q, r, j, c)]
                              @conclusion-grounded-at-succ-n |
                                qsegmentGrounded(peano.succ(n))
                                [using tautology clause-with-the-predecessor-collapsed
                                  the-inductive-hypothesis-here]
                            }
                          @conclusion-nonzero-gives-grounded |
                            peano.succ(n) != NAT_ZERO -> qsegmentGrounded(peano.succ(n))
                            [by discharge given-succ-n-nonzero]
                        }
                      @discharge-c |
                        forall c: Nat; peano.succ(n) != NAT_ZERO -> qsegmentGrounded(peano.succ(n))
                        [by generalize generalize-c]
                    }
                  @discharge-j |
                    forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qsegmentGrounded(peano.succ(n))
                    [by generalize generalize-j]
                }
              @discharge-r |
                forall r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qsegmentGrounded(peano.succ(n))
                [by generalize generalize-r]
            }
          @conclusion-grounded-for-every-argument |
            forall q, r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qsegmentGrounded(peano.succ(n))
            [by generalize generalize-q]
        }
      @conclusion-the-step-at-n |
        (forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qsegmentGrounded(n))
          -> (forall q, r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qsegmentGrounded(peano.succ(n)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall n: Nat;
      (forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qsegmentGrounded(n))
      -> (forall q, r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qsegmentGrounded(peano.succ(n)))
    [by generalize generalize-n]
qed

// THE OBLIGATION. Induction on `n` — the length, and the only descent. The base is VACUOUS,
// its antecedent `NAT_ZERO != NAT_ZERO` being false, and the step is the theorem above.
theorem qsegmentIsGrounded: forall q, r: QPoly; forall j, c: Nat; forall n: Nat;
  n != NAT_ZERO -> qsegmentGrounded(n)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix q: QPoly {
      @generalize-r-at-zero |
        fix r: QPoly {
          @generalize-j-at-zero |
            fix j: Nat {
              @generalize-c-at-zero |
                fix c: Nat {
                  @conclusion-vacuously-grounded |
                    NAT_ZERO != NAT_ZERO -> qsegmentGrounded(NAT_ZERO)
                    [using tautology zero-is-itself]
                }
              @discharge-c-at-zero |
                forall c: Nat; NAT_ZERO != NAT_ZERO -> qsegmentGrounded(NAT_ZERO)
                [by generalize generalize-c-at-zero]
            }
          @discharge-j-at-zero |
            forall j, c: Nat; NAT_ZERO != NAT_ZERO -> qsegmentGrounded(NAT_ZERO)
            [by generalize generalize-j-at-zero]
        }
      @discharge-r-at-zero |
        forall r: QPoly; forall j, c: Nat; NAT_ZERO != NAT_ZERO -> qsegmentGrounded(NAT_ZERO)
        [by generalize generalize-r-at-zero]
    }
  @base-case |
    forall q, r: QPoly; forall j, c: Nat; NAT_ZERO != NAT_ZERO -> qsegmentGrounded(NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-n |
    forall n: Nat;
      (forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qsegmentGrounded(n))
      -> (forall q, r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qsegmentGrounded(peano.succ(n)))
    [by cite qsegmentReachesABaseFromAPredecessor]
  @grounded-for-every-run-length |
    forall n: Nat; forall q, r: QPoly; forall j, c: Nat; n != NAT_ZERO -> qsegmentGrounded(n)
    [using instantiation peano.induction((fun n: Nat => (forall q, r: QPoly; forall j, c: Nat; n != NAT_ZERO -> qsegmentGrounded(n)))) base-case induction-step-for-all-n]
  @generalize-q |
    fix q: QPoly {
      @generalize-r |
        fix r: QPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-c |
                fix c: Nat {
                  @generalize-n |
                    fix n: Nat {
                      @grounded-at-n |
                        forall q4, r4: QPoly; forall j4, c4: Nat; n != NAT_ZERO -> qsegmentGrounded(n)
                        [using specialize grounded-for-every-run-length(n)]
                      @conclusion-grounded-here |
                        n != NAT_ZERO -> qsegmentGrounded(n)
                        [using specialize grounded-at-n(q, r, j, c)]
                    }
                  @discharge-n |
                    forall n: Nat; n != NAT_ZERO -> qsegmentGrounded(n)
                    [by generalize generalize-n]
                }
              @discharge-c |
                forall c: Nat; forall n: Nat; n != NAT_ZERO -> qsegmentGrounded(n)
                [by generalize generalize-c]
            }
          @discharge-j |
            forall j, c: Nat; forall n: Nat; n != NAT_ZERO -> qsegmentGrounded(n)
            [by generalize generalize-j]
        }
      @discharge-r |
        forall r: QPoly; forall j, c: Nat; forall n: Nat; n != NAT_ZERO -> qsegmentGrounded(n)
        [by generalize generalize-r]
    }
  @conclusion |
    forall q, r: QPoly; forall j, c: Nat; forall n: Nat; n != NAT_ZERO -> qsegmentGrounded(n)
    [by generalize generalize-q]
qed

theorem qSegmentSucc:
  forall p, q: QPoly; forall j, c, n: Nat;
  qsegment(p, q, peano.succ(j), c, peano.succ(n)) =
  rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, c)),
  qsegment(p, q, j, peano.succ(c), n))
proof
  @the-recursive-clause |
    forall p2, q2: QPoly; forall j2, c2, n2: Nat;
      n2 != NAT_ZERO ->
      qsegment(p2, q2, j2, c2, n2) =
      rational.add(rational.mul(qcoeff(p2, j2), qcoeff(q2, c2)),
      qsegment(p2, q2, peano.prev(j2), peano.succ(c2), peano.prev(n2)))
    [by definition(1) qsegment]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-c |
                fix c: Nat {
                  @generalize-n |
                    fix n: Nat {
                      @succ-n-is-nonzero |
                        peano.succ(n) != NAT_ZERO
                        [using specialize a-successor-is-never-zero(n)]
                      // the riding exponent's own `peano.prev(peano.succ(j))` owes this, and the arm's
                      // guard supplies only the LENGTH's — so it is proved here, before any
                      // step writes the term.
                      @succ-j-is-nonzero |
                        peano.succ(j) != NAT_ZERO
                        [using specialize a-successor-is-never-zero(j)]
                      @clause-at-the-successor |
                        qsegment(p, q, peano.succ(j), c, peano.succ(n)) =
                          rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, c)),
                          qsegment(p, q, peano.prev(peano.succ(j)), peano.succ(c), peano.prev(peano.succ(n))))
                        [using specialize the-recursive-clause(p, q, peano.succ(j), c, peano.succ(n)) succ-n-is-nonzero]
                      @prev-of-succ-j |
                        peano.prev(peano.succ(j)) = j
                        [using specialize prev-undoes-succ(j)]
                      @prev-of-succ-n |
                        peano.prev(peano.succ(n)) = n
                        [using specialize prev-undoes-succ(n)]
                      @riding-exponent-collapsed |
                        qsegment(p, q, peano.succ(j), c, peano.succ(n)) =
                          rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, c)),
                          qsegment(p, q, j, peano.succ(c), peano.prev(peano.succ(n))))
                        [by rewrite prev-of-succ-j clause-at-the-successor]
                      @conclusion-step-at-j-c-n |
                        qsegment(p, q, peano.succ(j), c, peano.succ(n)) =
                          rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, c)),
                          qsegment(p, q, j, peano.succ(c), n))
                        [by rewrite prev-of-succ-n riding-exponent-collapsed]
                    }
                  @discharge-n |
                    forall n: Nat;
                      qsegment(p, q, peano.succ(j), c, peano.succ(n)) =
                      rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, c)),
                      qsegment(p, q, j, peano.succ(c), n))
                    [by generalize generalize-n]
                }
              @discharge-c |
                forall c, n: Nat;
                  qsegment(p, q, peano.succ(j), c, peano.succ(n)) =
                  rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, c)),
                  qsegment(p, q, j, peano.succ(c), n))
                [by generalize generalize-c]
            }
          @discharge-j |
            forall j, c, n: Nat;
              qsegment(p, q, peano.succ(j), c, peano.succ(n)) =
              rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, c)),
              qsegment(p, q, j, peano.succ(c), n))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: QPoly; forall j, c, n: Nat;
          qsegment(p, q, peano.succ(j), c, peano.succ(n)) =
          rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, c)),
          qsegment(p, q, j, peano.succ(c), n))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; forall j, c, n: Nat;
      qsegment(p, q, peano.succ(j), c, peano.succ(n)) =
      rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, c)),
      qsegment(p, q, j, peano.succ(c), n))
    [by generalize generalize-p]
qed

theorem qRsegmentZero:
  forall p, q: QPoly; forall j, c: Nat;
  qrsegment(p, q, j, c, NAT_ZERO) = rational.mul(qcoeff(p, j), qcoeff(q, c))
proof
  @conclusion |
    forall p, q: QPoly; forall j, c: Nat;
      qrsegment(p, q, j, c, NAT_ZERO) = rational.mul(qcoeff(p, j), qcoeff(q, c))
    [by definition(0) qrsegment]
qed

// The step: groundedness below `peano.succ(n)` gives it at `peano.succ(n)`. Either the predecessor `n`
// is itself the base (the right disjunct fires) or the inductive hypothesis supplies it. The
// riding exponents `j` and `c` take no part — the generated predicate does not mention them.
theorem qrsegmentReachesABaseFromAPredecessor: forall n: Nat;
  (forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qrsegmentGrounded(n))
  -> (forall q, r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qrsegmentGrounded(peano.succ(n)))
proof
  @the-generated-clause |
    forall n3: Nat; qrsegmentGrounded(n3) iff
      (qrsegmentGrounded(peano.prev(n3)) or peano.prev(n3) = NAT_ZERO)
    [by definition qrsegmentGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-n |
    fix n: Nat {
      @given-the-inductive-hypothesis |
        assume forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qrsegmentGrounded(n) {
          @inductive-hypothesis |
            forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qrsegmentGrounded(n)
            [by hypothesis given-the-inductive-hypothesis]
          // `peano.prev` is guarded, so these precede every term that writes `peano.prev(peano.succ(n))`.
          @succ-n-is-nonzero |
            peano.succ(n) != NAT_ZERO
            [using specialize a-successor-is-never-zero(n)]
          @prev-of-succ-n-is-n |
            peano.prev(peano.succ(n)) = n
            [using specialize prev-undoes-succ(n)]
          @generalize-q |
            fix q: QPoly {
              @generalize-r |
                fix r: QPoly {
                  @generalize-j |
                    fix j: Nat {
                      @generalize-c |
                        fix c: Nat {
                          @given-succ-n-nonzero |
                            assume peano.succ(n) != NAT_ZERO {
                              @clause-at-the-successor |
                                qrsegmentGrounded(peano.succ(n)) iff
                                  (qrsegmentGrounded(peano.prev(peano.succ(n))) or peano.prev(peano.succ(n)) = NAT_ZERO)
                                [using specialize the-generated-clause(peano.succ(n))]
                              @clause-with-the-predecessor-collapsed |
                                qrsegmentGrounded(peano.succ(n)) iff
                                  (qrsegmentGrounded(n) or n = NAT_ZERO)
                                [by rewrite prev-of-succ-n-is-n clause-at-the-successor]
                              @the-inductive-hypothesis-here |
                                n != NAT_ZERO -> qrsegmentGrounded(n)
                                [using specialize inductive-hypothesis(q, r, j, c)]
                              @conclusion-grounded-at-succ-n |
                                qrsegmentGrounded(peano.succ(n))
                                [using tautology clause-with-the-predecessor-collapsed
                                  the-inductive-hypothesis-here]
                            }
                          @conclusion-nonzero-gives-grounded |
                            peano.succ(n) != NAT_ZERO -> qrsegmentGrounded(peano.succ(n))
                            [by discharge given-succ-n-nonzero]
                        }
                      @discharge-c |
                        forall c: Nat; peano.succ(n) != NAT_ZERO -> qrsegmentGrounded(peano.succ(n))
                        [by generalize generalize-c]
                    }
                  @discharge-j |
                    forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qrsegmentGrounded(peano.succ(n))
                    [by generalize generalize-j]
                }
              @discharge-r |
                forall r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qrsegmentGrounded(peano.succ(n))
                [by generalize generalize-r]
            }
          @conclusion-grounded-for-every-argument |
            forall q, r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qrsegmentGrounded(peano.succ(n))
            [by generalize generalize-q]
        }
      @conclusion-the-step-at-n |
        (forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qrsegmentGrounded(n))
          -> (forall q, r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qrsegmentGrounded(peano.succ(n)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall n: Nat;
      (forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qrsegmentGrounded(n))
      -> (forall q, r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qrsegmentGrounded(peano.succ(n)))
    [by generalize generalize-n]
qed

// THE OBLIGATION. Induction on `n` — the length, and the only descent. The base is VACUOUS,
// its antecedent `NAT_ZERO != NAT_ZERO` being false, and the step is the theorem above.
theorem qrsegmentIsGrounded: forall q, r: QPoly; forall j, c: Nat; forall n: Nat;
  n != NAT_ZERO -> qrsegmentGrounded(n)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix q: QPoly {
      @generalize-r-at-zero |
        fix r: QPoly {
          @generalize-j-at-zero |
            fix j: Nat {
              @generalize-c-at-zero |
                fix c: Nat {
                  @conclusion-vacuously-grounded |
                    NAT_ZERO != NAT_ZERO -> qrsegmentGrounded(NAT_ZERO)
                    [using tautology zero-is-itself]
                }
              @discharge-c-at-zero |
                forall c: Nat; NAT_ZERO != NAT_ZERO -> qrsegmentGrounded(NAT_ZERO)
                [by generalize generalize-c-at-zero]
            }
          @discharge-j-at-zero |
            forall j, c: Nat; NAT_ZERO != NAT_ZERO -> qrsegmentGrounded(NAT_ZERO)
            [by generalize generalize-j-at-zero]
        }
      @discharge-r-at-zero |
        forall r: QPoly; forall j, c: Nat; NAT_ZERO != NAT_ZERO -> qrsegmentGrounded(NAT_ZERO)
        [by generalize generalize-r-at-zero]
    }
  @base-case |
    forall q, r: QPoly; forall j, c: Nat; NAT_ZERO != NAT_ZERO -> qrsegmentGrounded(NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-n |
    forall n: Nat;
      (forall q2, r2: QPoly; forall j2, c2: Nat; n != NAT_ZERO -> qrsegmentGrounded(n))
      -> (forall q, r: QPoly; forall j, c: Nat; peano.succ(n) != NAT_ZERO -> qrsegmentGrounded(peano.succ(n)))
    [by cite qrsegmentReachesABaseFromAPredecessor]
  @grounded-for-every-run-length |
    forall n: Nat; forall q, r: QPoly; forall j, c: Nat; n != NAT_ZERO -> qrsegmentGrounded(n)
    [using instantiation peano.induction((fun n: Nat => (forall q, r: QPoly; forall j, c: Nat; n != NAT_ZERO -> qrsegmentGrounded(n)))) base-case induction-step-for-all-n]
  @generalize-q |
    fix q: QPoly {
      @generalize-r |
        fix r: QPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-c |
                fix c: Nat {
                  @generalize-n |
                    fix n: Nat {
                      @grounded-at-n |
                        forall q4, r4: QPoly; forall j4, c4: Nat; n != NAT_ZERO -> qrsegmentGrounded(n)
                        [using specialize grounded-for-every-run-length(n)]
                      @conclusion-grounded-here |
                        n != NAT_ZERO -> qrsegmentGrounded(n)
                        [using specialize grounded-at-n(q, r, j, c)]
                    }
                  @discharge-n |
                    forall n: Nat; n != NAT_ZERO -> qrsegmentGrounded(n)
                    [by generalize generalize-n]
                }
              @discharge-c |
                forall c: Nat; forall n: Nat; n != NAT_ZERO -> qrsegmentGrounded(n)
                [by generalize generalize-c]
            }
          @discharge-j |
            forall j, c: Nat; forall n: Nat; n != NAT_ZERO -> qrsegmentGrounded(n)
            [by generalize generalize-j]
        }
      @discharge-r |
        forall r: QPoly; forall j, c: Nat; forall n: Nat; n != NAT_ZERO -> qrsegmentGrounded(n)
        [by generalize generalize-r]
    }
  @conclusion |
    forall q, r: QPoly; forall j, c: Nat; forall n: Nat; n != NAT_ZERO -> qrsegmentGrounded(n)
    [by generalize generalize-q]
qed

theorem qRsegmentSucc:
  forall p, q: QPoly; forall j, c, n: Nat;
  qrsegment(p, q, j, peano.succ(c), peano.succ(n)) =
  rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(c))),
  qrsegment(p, q, peano.succ(j), c, n))
proof
  @the-recursive-clause |
    forall p2, q2: QPoly; forall j2, c2, n2: Nat;
      n2 != NAT_ZERO ->
      qrsegment(p2, q2, j2, c2, n2) =
      rational.add(rational.mul(qcoeff(p2, j2), qcoeff(q2, c2)),
      qrsegment(p2, q2, peano.succ(j2), peano.prev(c2), peano.prev(n2)))
    [by definition(1) qrsegment]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-c |
                fix c: Nat {
                  @generalize-n |
                    fix n: Nat {
                      @succ-n-is-nonzero |
                        peano.succ(n) != NAT_ZERO
                        [using specialize a-successor-is-never-zero(n)]
                      // the riding exponent's `peano.prev(peano.succ(c))` owes this; the arm's guard
                      // supplies only the length's.
                      @succ-c-is-nonzero |
                        peano.succ(c) != NAT_ZERO
                        [using specialize a-successor-is-never-zero(c)]
                      @clause-at-the-successor |
                        qrsegment(p, q, j, peano.succ(c), peano.succ(n)) =
                          rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(c))),
                          qrsegment(p, q, peano.succ(j), peano.prev(peano.succ(c)), peano.prev(peano.succ(n))))
                        [using specialize the-recursive-clause(p, q, j, peano.succ(c), peano.succ(n)) succ-n-is-nonzero]
                      @prev-of-succ-c |
                        peano.prev(peano.succ(c)) = c
                        [using specialize prev-undoes-succ(c)]
                      @prev-of-succ-n |
                        peano.prev(peano.succ(n)) = n
                        [using specialize prev-undoes-succ(n)]
                      @riding-exponent-collapsed |
                        qrsegment(p, q, j, peano.succ(c), peano.succ(n)) =
                          rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(c))),
                          qrsegment(p, q, peano.succ(j), c, peano.prev(peano.succ(n))))
                        [by rewrite prev-of-succ-c clause-at-the-successor]
                      @conclusion-step-at-j-c-n |
                        qrsegment(p, q, j, peano.succ(c), peano.succ(n)) =
                          rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(c))),
                          qrsegment(p, q, peano.succ(j), c, n))
                        [by rewrite prev-of-succ-n riding-exponent-collapsed]
                    }
                  @discharge-n |
                    forall n: Nat;
                      qrsegment(p, q, j, peano.succ(c), peano.succ(n)) =
                      rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(c))),
                      qrsegment(p, q, peano.succ(j), c, n))
                    [by generalize generalize-n]
                }
              @discharge-c |
                forall c, n: Nat;
                  qrsegment(p, q, j, peano.succ(c), peano.succ(n)) =
                  rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(c))),
                  qrsegment(p, q, peano.succ(j), c, n))
                [by generalize generalize-c]
            }
          @discharge-j |
            forall j, c, n: Nat;
              qrsegment(p, q, j, peano.succ(c), peano.succ(n)) =
              rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(c))),
              qrsegment(p, q, peano.succ(j), c, n))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: QPoly; forall j, c, n: Nat;
          qrsegment(p, q, j, peano.succ(c), peano.succ(n)) =
          rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(c))),
          qrsegment(p, q, peano.succ(j), c, n))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; forall j, c, n: Nat;
      qrsegment(p, q, j, peano.succ(c), peano.succ(n)) =
      rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(c))),
      qrsegment(p, q, peano.succ(j), c, n))
    [by generalize generalize-p]
qed

theorem qPowerZero:
  forall a: Q; qpower(a, peano.ZERO) = rational.ONE
proof
  @conclusion |
    forall a: Q; qpower(a, peano.ZERO) = rational.ONE
    [by definition(0) qpower]
qed

// The successor step, now DERIVED rather than transcribed: the definition descends by `prev`,
// so this restates it at a successor, where `prevOfSucc` collapses the `prev`. The STATEMENT is
// unchanged, which keeps the migration confined — every call site cites this theorem rather
// than the clause, so the clause's guard never reaches them.
theorem qPowerSucc:
  forall a: Q; forall n: peano.Nat;
  qpower(a, peano.succ(n)) = rational.mul(a, qpower(a, n))
proof
  @the-recursive-clause |
    forall a2: Q; forall n2: peano.Nat;
      n2 != peano.ZERO -> qpower(a2, n2) = rational.mul(a2, qpower(a2, peano.prev(n2)))
    [by definition(1) qpower]
  @prev-undoes-succ |
    forall n: peano.Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: peano.Nat; peano.succ(a) != peano.ZERO
    [using import(peano) succNotZero]
  @generalize-a |
    fix a: Q {
      @generalize-n |
        fix n: peano.Nat {
          @succ-n-is-nonzero |
            peano.succ(n) != peano.ZERO
            [using specialize a-successor-is-never-zero(n)]
          @clause-at-the-successor |
            qpower(a, peano.succ(n)) = rational.mul(a, qpower(a, peano.prev(peano.succ(n))))
            [using specialize the-recursive-clause(a, peano.succ(n)) succ-n-is-nonzero]
          @prev-of-succ-n |
            peano.prev(peano.succ(n)) = n
            [using specialize prev-undoes-succ(n)]
          @conclusion-step-at-a-n |
            qpower(a, peano.succ(n)) = rational.mul(a, qpower(a, n))
            [by rewrite prev-of-succ-n clause-at-the-successor]
        }
      @discharge-n |
        forall n: peano.Nat; qpower(a, peano.succ(n)) = rational.mul(a, qpower(a, n))
        [by generalize generalize-n]
    }
  @conclusion |
    forall a: Q; forall n: peano.Nat;
      qpower(a, peano.succ(n)) = rational.mul(a, qpower(a, n))
    [by generalize generalize-a]
qed

// -- the TERMINATION obligation for `qpower` ---------------------------------------------
//
// `termination(peano):` names `qpowerIsGrounded`, and the checker SYNTHESIZES the statement it must
// have — the recursive arm's own guard implying the generated predicate:
//
//     forall a: Q; forall n: peano.Nat; n != peano.ZERO -> qpowerGrounded(n)
//
// `qpowerGrounded` is GENERATED from the arm's one call site, a disjunction of that call grounded
// with its argument hitting the terminating arm's pattern:
//
//     qpowerGrounded(n) iff (qpowerGrounded(peano.prev(n)) or peano.prev(n) = peano.ZERO)
//
// The base disjunct is what lets the recursion bottom out: at n = 1 the predecessor IS zero.

// Strategy: the step of an induction on the exponent. At `peano.succ(k)` the predecessor is `k`,
// so either `k` is zero and the base disjunct fires outright, or the inductive hypothesis
// applies at `k`. `tautology` picks whichever holds.
theorem qpowerReachesABaseFromAPredecessor: forall k: peano.Nat;
  (forall a2: Q; k != peano.ZERO -> qpowerGrounded(k))
  -> (forall a: Q; peano.succ(k) != peano.ZERO -> qpowerGrounded(peano.succ(k)))
proof
  @the-generated-clause |
    forall n3: peano.Nat; qpowerGrounded(n3) iff (qpowerGrounded(peano.prev(n3)) or peano.prev(n3) = peano.ZERO)
    [by definition qpowerGrounded]
  @prev-undoes-succ |
    forall n: peano.Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: peano.Nat; peano.succ(a) != peano.ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: peano.Nat {
      @given-the-inductive-hypothesis |
        assume forall a2: Q; k != peano.ZERO -> qpowerGrounded(k) {
          @inductive-hypothesis |
            forall a2: Q; k != peano.ZERO -> qpowerGrounded(k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so this must precede every term writing `peano.prev(peano.succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != peano.ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-a |
            fix a: Q {
              @given-succ-k-nonzero |
                assume peano.succ(k) != peano.ZERO {
                  @clause-at-a-and-succ-k |
                    qpowerGrounded(peano.succ(k)) iff
                      (qpowerGrounded(peano.prev(peano.succ(k))) or peano.prev(peano.succ(k)) = peano.ZERO)
                    [using specialize the-generated-clause(peano.succ(k))]
                  @clause-with-the-predecessor-collapsed |
                    qpowerGrounded(peano.succ(k)) iff (qpowerGrounded(k) or k = peano.ZERO)
                    [by rewrite prev-of-succ-k-is-k clause-at-a-and-succ-k]
                  @the-inductive-hypothesis-at-a |
                    k != peano.ZERO -> qpowerGrounded(k)
                    [using specialize inductive-hypothesis(a)]
                  @conclusion-grounded-at-succ-k |
                    qpowerGrounded(peano.succ(k))
                    [using tautology clause-with-the-predecessor-collapsed
                      the-inductive-hypothesis-at-a]
                }
              @nonzero-implies-grounded-at-succ-k |
                peano.succ(k) != peano.ZERO -> qpowerGrounded(peano.succ(k))
                [by discharge given-succ-k-nonzero]
            }
          @conclusion-for-all-a |
            forall a: Q; peano.succ(k) != peano.ZERO -> qpowerGrounded(peano.succ(k))
            [by generalize generalize-a]
        }
      @the-hypothesis-implies-the-step |
        (forall a2: Q; k != peano.ZERO -> qpowerGrounded(k))
          -> (forall a: Q; peano.succ(k) != peano.ZERO -> qpowerGrounded(peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: peano.Nat;
      (forall a2: Q; k != peano.ZERO -> qpowerGrounded(k))
      -> (forall a: Q; peano.succ(k) != peano.ZERO -> qpowerGrounded(peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the exponent. The base is VACUOUS — at n = zero the
// antecedent demands `peano.ZERO != peano.ZERO` — so every bit of content is in the step above.
theorem qpowerIsGrounded: forall a: Q; forall n: peano.Nat;
  n != peano.ZERO -> qpowerGrounded(n)
proof
  @zero-is-itself |
    peano.ZERO = peano.ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binder is opened before the
  // vacuous antecedent can be refuted inside it.
  @base-case-proof |
    fix a: Q {
      @conclusion-vacuously-grounded-at-zero |
        peano.ZERO != peano.ZERO -> qpowerGrounded(peano.ZERO)
        [using tautology zero-is-itself]
    }
  @base-case |
    forall a: Q; peano.ZERO != peano.ZERO -> qpowerGrounded(peano.ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: peano.Nat;
      (forall a2: Q; k != peano.ZERO -> qpowerGrounded(k))
      -> (forall a: Q; peano.succ(k) != peano.ZERO -> qpowerGrounded(peano.succ(k)))
    [by cite qpowerReachesABaseFromAPredecessor]
  @grounded-for-every-exponent |
    forall n: peano.Nat; forall a: Q; n != peano.ZERO -> qpowerGrounded(n)
    [using instantiation peano.induction((fun n: peano.Nat => (forall a: Q; n != peano.ZERO -> qpowerGrounded(n)))) base-case induction-step-for-all-k]
  @generalize-a |
    fix a: Q {
      @generalize-n |
        fix n: peano.Nat {
          @grounded-at-n-and-a |
            n != peano.ZERO -> qpowerGrounded(n)
            [using specialize grounded-for-every-exponent(n, a)]
        }
      @discharge-n |
        forall n: peano.Nat; n != peano.ZERO -> qpowerGrounded(n)
        [by generalize generalize-n]
    }
  @conclusion |
    forall a: Q; forall n: peano.Nat; n != peano.ZERO -> qpowerGrounded(n)
    [by generalize generalize-a]
qed

theorem qEvalZero:
  forall p: QPoly; forall a: Q;
  qevalUpTo(p, a, peano.ZERO) = ZERO
proof
  @conclusion |
    forall p: QPoly; forall a: Q;
      qevalUpTo(p, a, peano.ZERO) = ZERO
    [by definition(0) qevalUpTo]
qed

// The successor step, now DERIVED rather than transcribed: the definition descends by
// `peano.prev`, so this restates it at a successor, where `prevOfSucc` collapses all three
// `peano.prev`s at once — one rewrite, since they are the same term. The STATEMENT is
// unchanged, which keeps the migration confined: every call site cites this theorem rather
// than the clause, so the clause's `k != peano.ZERO` guard never reaches them.
theorem qEvalSucc:
  forall p: QPoly; forall a: Q; forall k: peano.Nat;
  qevalUpTo(p, a, peano.succ(k)) =
  rational.add(qevalUpTo(p, a, k), rational.mul(qcoeff(p, k), qpower(a, k)))
proof
  @the-recursive-clause |
    forall p2: QPoly; forall a2: Q; forall k2: peano.Nat;
      k2 != peano.ZERO ->
      qevalUpTo(p2, a2, k2) =
      rational.add(qevalUpTo(p2, a2, peano.prev(k2)),
      rational.mul(qcoeff(p2, peano.prev(k2)), qpower(a2, peano.prev(k2))))
    [by definition(1) qevalUpTo]
  @prev-undoes-successor |
    forall n: peano.Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: peano.Nat; peano.succ(a) != peano.ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: QPoly {
      @generalize-a |
        fix a: Q {
          @generalize-k |
            fix k: peano.Nat {
              @succ-k-is-nonzero |
                peano.succ(k) != peano.ZERO
                [using specialize a-successor-is-never-zero(k)]
              @clause-at-the-successor |
                qevalUpTo(p, a, peano.succ(k)) =
                  rational.add(qevalUpTo(p, a, peano.prev(peano.succ(k))),
                  rational.mul(qcoeff(p, peano.prev(peano.succ(k))), qpower(a, peano.prev(peano.succ(k)))))
                [using specialize the-recursive-clause(p, a, peano.succ(k)) succ-k-is-nonzero]
              @prev-of-succ-k |
                peano.prev(peano.succ(k)) = k
                [using specialize prev-undoes-successor(k)]
              @conclusion-step-at-p-a-k |
                qevalUpTo(p, a, peano.succ(k)) =
                  rational.add(qevalUpTo(p, a, k), rational.mul(qcoeff(p, k), qpower(a, k)))
                [by rewrite prev-of-succ-k clause-at-the-successor]
            }
          @discharge-k |
            forall k: peano.Nat;
              qevalUpTo(p, a, peano.succ(k)) =
              rational.add(qevalUpTo(p, a, k), rational.mul(qcoeff(p, k), qpower(a, k)))
            [by generalize generalize-k]
        }
      @discharge-a |
        forall a: Q; forall k: peano.Nat;
          qevalUpTo(p, a, peano.succ(k)) =
          rational.add(qevalUpTo(p, a, k), rational.mul(qcoeff(p, k), qpower(a, k)))
        [by generalize generalize-a]
    }
  @conclusion |
    forall p: QPoly; forall a: Q; forall k: peano.Nat;
      qevalUpTo(p, a, peano.succ(k)) =
      rational.add(qevalUpTo(p, a, k), rational.mul(qcoeff(p, k), qpower(a, k)))
    [by generalize generalize-p]
qed

// -- the TERMINATION obligation for `qevalUpTo` ------------------------------------------------
//
// `termination(peano):` names `qevalUpToIsGrounded`, and the checker SYNTHESIZES the statement it
// must have — the recursive arm's own guard implying the generated predicate:
//
//     forall p: QPoly; forall a: Q; forall k: peano.Nat;
//       k != peano.ZERO -> qevalUpToGrounded(k)
//
// `qevalUpToGrounded` is GENERATED from the arm's one recursive call site, a disjunction of that
// call grounded with its argument hitting the terminating arm's pattern:
//
//     qevalUpToGrounded(k) iff
//       (qevalUpToGrounded(peano.prev(k)) or peano.prev(k) = peano.ZERO)
//
// The two non-descending binders (`p`, `a`) ride along untouched; only `k` descends.

// Strategy: the step of an induction on the term count. At `peano.succ(k)` the predecessor is `k`,
// so either `k = peano.ZERO` and the base disjunct fires outright, or the inductive hypothesis
// applies at `k`. `tautology` picks whichever holds.
theorem qevalUpToReachesABaseFromAPredecessor: forall k: peano.Nat;
  (forall p2: QPoly; forall a2: Q; k != peano.ZERO -> qevalUpToGrounded(k))
  -> (forall p: QPoly; forall a: Q;
  peano.succ(k) != peano.ZERO -> qevalUpToGrounded(peano.succ(k)))
proof
  @the-generated-clause |
    forall k3: peano.Nat; qevalUpToGrounded(k3) iff
      (qevalUpToGrounded(peano.prev(k3)) or peano.prev(k3) = peano.ZERO)
    [by definition qevalUpToGrounded]
  @prev-undoes-successor |
    forall n: peano.Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: peano.Nat; peano.succ(a) != peano.ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: peano.Nat {
      @given-the-inductive-hypothesis |
        assume forall p2: QPoly; forall a2: Q;
          k != peano.ZERO -> qevalUpToGrounded(k) {
          @inductive-hypothesis |
            forall p2: QPoly; forall a2: Q; k != peano.ZERO -> qevalUpToGrounded(k)
            [by hypothesis given-the-inductive-hypothesis]
          // `peano.prev` is guarded, so this must precede every term writing
          // `peano.prev(peano.succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != peano.ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-successor(k)]
          @generalize-p |
            fix p: QPoly {
              @generalize-a |
                fix a: Q {
                  @given-succ-k-nonzero |
                    assume peano.succ(k) != peano.ZERO {
                      @clause-at-p-a-and-succ-k |
                        qevalUpToGrounded(peano.succ(k)) iff
                          (qevalUpToGrounded(peano.prev(peano.succ(k)))
                          or peano.prev(peano.succ(k)) = peano.ZERO)
                        [using specialize the-generated-clause(peano.succ(k))]
                      @clause-with-the-predecessor-collapsed |
                        qevalUpToGrounded(peano.succ(k)) iff
                          (qevalUpToGrounded(k) or k = peano.ZERO)
                        [by rewrite prev-of-succ-k-is-k clause-at-p-a-and-succ-k]
                      @the-inductive-hypothesis-at-p-and-a |
                        k != peano.ZERO -> qevalUpToGrounded(k)
                        [using specialize inductive-hypothesis(p, a)]
                      @conclusion-grounded-at-succ-k |
                        qevalUpToGrounded(peano.succ(k))
                        [using tautology clause-with-the-predecessor-collapsed
                          the-inductive-hypothesis-at-p-and-a]
                    }
                  @nonzero-implies-grounded-at-succ-k |
                    peano.succ(k) != peano.ZERO -> qevalUpToGrounded(peano.succ(k))
                    [by discharge given-succ-k-nonzero]
                }
              @discharge-a |
                forall a: Q; peano.succ(k) != peano.ZERO -> qevalUpToGrounded(peano.succ(k))
                [by generalize generalize-a]
            }
          @conclusion-for-all-p-and-a |
            forall p: QPoly; forall a: Q;
              peano.succ(k) != peano.ZERO -> qevalUpToGrounded(peano.succ(k))
            [by generalize generalize-p]
        }
      @the-hypothesis-implies-the-step |
        (forall p2: QPoly; forall a2: Q; k != peano.ZERO -> qevalUpToGrounded(k))
          -> (forall p: QPoly; forall a: Q;
          peano.succ(k) != peano.ZERO -> qevalUpToGrounded(peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: peano.Nat;
      (forall p2: QPoly; forall a2: Q; k != peano.ZERO -> qevalUpToGrounded(k))
      -> (forall p: QPoly; forall a: Q;
      peano.succ(k) != peano.ZERO -> qevalUpToGrounded(peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the term count. The base is VACUOUS — at k = peano.ZERO the
// antecedent demands `peano.ZERO != peano.ZERO` — so every bit of content is in the step above.
theorem qevalUpToIsGrounded: forall p: QPoly; forall a: Q; forall k: peano.Nat;
  k != peano.ZERO -> qevalUpToGrounded(k)
proof
  @zero-is-itself |
    peano.ZERO = peano.ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix p: QPoly {
      @generalize-a-at-zero |
        fix a: Q {
          @conclusion-vacuously-grounded-at-zero |
            peano.ZERO != peano.ZERO -> qevalUpToGrounded(peano.ZERO)
            [using tautology zero-is-itself]
        }
      @discharge-a-at-zero |
        forall a: Q; peano.ZERO != peano.ZERO -> qevalUpToGrounded(peano.ZERO)
        [by generalize generalize-a-at-zero]
    }
  @base-case |
    forall p: QPoly; forall a: Q; peano.ZERO != peano.ZERO -> qevalUpToGrounded(peano.ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: peano.Nat;
      (forall p2: QPoly; forall a2: Q; k != peano.ZERO -> qevalUpToGrounded(k))
      -> (forall p: QPoly; forall a: Q;
      peano.succ(k) != peano.ZERO -> qevalUpToGrounded(peano.succ(k)))
    [by cite qevalUpToReachesABaseFromAPredecessor]
  @grounded-for-every-term-count |
    forall k: peano.Nat; forall p: QPoly; forall a: Q;
      k != peano.ZERO -> qevalUpToGrounded(k)
    [using instantiation peano.induction((fun k: peano.Nat => (forall p: QPoly; forall a: Q; k != peano.ZERO -> qevalUpToGrounded(k)))) base-case induction-step-for-all-k]
  @generalize-p |
    fix p: QPoly {
      @generalize-a |
        fix a: Q {
          @generalize-k |
            fix k: peano.Nat {
              @grounded-at-p-a-and-k |
                k != peano.ZERO -> qevalUpToGrounded(k)
                [using specialize grounded-for-every-term-count(k, p, a)]
            }
          @discharge-k |
            forall k: peano.Nat; k != peano.ZERO -> qevalUpToGrounded(k)
            [by generalize generalize-k]
        }
      @discharge-a |
        forall a: Q; forall k: peano.Nat; k != peano.ZERO -> qevalUpToGrounded(k)
        [by generalize generalize-a]
    }
  @conclusion |
    forall p: QPoly; forall a: Q; forall k: peano.Nat;
      k != peano.ZERO -> qevalUpToGrounded(k)
    [by generalize generalize-p]
qed

theorem qClearedSumZero:
  forall p: QPoly; forall r, s: Q;
  qclearedSum(p, r, s, peano.ZERO) = ZERO
proof
  @conclusion |
    forall p: QPoly; forall r, s: Q;
      qclearedSum(p, r, s, peano.ZERO) = ZERO
    [by definition(0) qclearedSum]
qed

theorem qClearedSumSucc:
  forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
  qclearedSum(p, r, s, peano.succ(k)) =
  rational.mul(s, rational.add(qclearedSum(p, r, s, k),
  rational.mul(qcoeff(p, k), qpower(r, k))))
proof
  @the-recursive-clause |
    forall p2: QPoly; forall r2, s2: Q; forall k2: peano.Nat;
      k2 != NAT_ZERO -> qclearedSum(p2, r2, s2, k2) =
      rational.mul(s2, rational.add(qclearedSum(p2, r2, s2, peano.prev(k2)),
      rational.mul(qcoeff(p2, peano.prev(k2)), qpower(r2, peano.prev(k2)))))
    [by definition(1) qclearedSum]
  @prev-undoes-succ |
    forall n: peano.Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: peano.Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @generalize-k |
                fix k: peano.Nat {
                  // `prev` is guarded, so the bound precedes every term writing `prev(succ(k))`.
                  @succ-k-is-nonzero |
                    peano.succ(k) != NAT_ZERO
                    [using specialize a-successor-is-never-zero(k)]
                  @clause-at-the-successor |
                    qclearedSum(p, r, s, peano.succ(k)) =
                      rational.mul(s, rational.add(qclearedSum(p, r, s, peano.prev(peano.succ(k))),
                      rational.mul(qcoeff(p, peano.prev(peano.succ(k))), qpower(r, peano.prev(peano.succ(k))))))
                    [using specialize the-recursive-clause(p, r, s, peano.succ(k)) succ-k-is-nonzero]
                  @prev-of-succ-k-is-k |
                    peano.prev(peano.succ(k)) = k
                    [using specialize prev-undoes-succ(k)]
                  @conclusion-peel-at-k |
                    qclearedSum(p, r, s, peano.succ(k)) =
                      rational.mul(s, rational.add(qclearedSum(p, r, s, k),
                      rational.mul(qcoeff(p, k), qpower(r, k))))
                    [by rewrite prev-of-succ-k-is-k clause-at-the-successor]
                }
              @discharge-k |
                forall k: peano.Nat;
                  qclearedSum(p, r, s, peano.succ(k)) =
                  rational.mul(s, rational.add(qclearedSum(p, r, s, k),
                  rational.mul(qcoeff(p, k), qpower(r, k))))
                [by generalize generalize-k]
            }
          @discharge-s |
            forall s: Q; forall k: peano.Nat;
              qclearedSum(p, r, s, peano.succ(k)) =
              rational.mul(s, rational.add(qclearedSum(p, r, s, k),
              rational.mul(qcoeff(p, k), qpower(r, k))))
            [by generalize generalize-s]
        }
      @discharge-r |
        forall r, s: Q; forall k: peano.Nat;
          qclearedSum(p, r, s, peano.succ(k)) =
          rational.mul(s, rational.add(qclearedSum(p, r, s, k),
          rational.mul(qcoeff(p, k), qpower(r, k))))
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
      qclearedSum(p, r, s, peano.succ(k)) =
      rational.mul(s, rational.add(qclearedSum(p, r, s, k),
      rational.mul(qcoeff(p, k), qpower(r, k))))
    [by generalize generalize-p]
qed

// TERMINATION for `qclearedSum`. The generated predicate transcribes the one recursive call
// site, with the terminating arm's pattern as its base alternative:
//
//     qclearedSumGrounded(k) iff (qclearedSumGrounded(peano.prev(k)) or peano.prev(k) = NAT_ZERO)
//
// `p`, `r` and `s` ride through — only the bound `k` descends — so the induction is on `k`.

// The step: groundedness below `peano.succ(k)` gives it at `peano.succ(k)`. Either the predecessor `k` is
// itself the base (the right disjunct fires) or the inductive hypothesis supplies it.
theorem qClearedSumReachesABaseFromAPredecessor: forall k: peano.Nat;
  (forall p2: QPoly; forall r2, s2: Q; k != NAT_ZERO -> qclearedSumGrounded(k))
  -> (forall p: QPoly; forall r, s: Q; peano.succ(k) != NAT_ZERO -> qclearedSumGrounded(peano.succ(k)))
proof
  @the-generated-clause |
    forall k3: peano.Nat; qclearedSumGrounded(k3) iff
      (qclearedSumGrounded(peano.prev(k3)) or peano.prev(k3) = NAT_ZERO)
    [by definition qclearedSumGrounded]
  @prev-undoes-succ |
    forall n: peano.Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: peano.Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: peano.Nat {
      @given-the-inductive-hypothesis |
        assume forall p2: QPoly; forall r2, s2: Q; k != NAT_ZERO -> qclearedSumGrounded(k) {
          @inductive-hypothesis |
            forall p2: QPoly; forall r2, s2: Q; k != NAT_ZERO -> qclearedSumGrounded(k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so these precede every term writing `peano.prev(peano.succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-p |
            fix p: QPoly {
              @generalize-r |
                fix r: Q {
                  @generalize-s |
                    fix s: Q {
                      @given-succ-k-nonzero |
                        assume peano.succ(k) != NAT_ZERO {
                          @clause-at-the-successor |
                            qclearedSumGrounded(peano.succ(k)) iff
                              (qclearedSumGrounded(peano.prev(peano.succ(k))) or peano.prev(peano.succ(k)) = NAT_ZERO)
                            [using specialize the-generated-clause(peano.succ(k))]
                          @clause-with-the-predecessor-collapsed |
                            qclearedSumGrounded(peano.succ(k)) iff
                              (qclearedSumGrounded(k) or k = NAT_ZERO)
                            [by rewrite prev-of-succ-k-is-k clause-at-the-successor]
                          @the-inductive-hypothesis-here |
                            k != NAT_ZERO -> qclearedSumGrounded(k)
                            [using specialize inductive-hypothesis(p, r, s)]
                          @conclusion-grounded-at-the-successor |
                            qclearedSumGrounded(peano.succ(k))
                            [using tautology clause-with-the-predecessor-collapsed the-inductive-hypothesis-here]
                        }
                      @conclusion-nonzero-gives-grounded |
                        peano.succ(k) != NAT_ZERO -> qclearedSumGrounded(peano.succ(k))
                        [by discharge given-succ-k-nonzero]
                    }
                  @discharge-s |
                    forall s: Q; peano.succ(k) != NAT_ZERO -> qclearedSumGrounded(peano.succ(k))
                    [by generalize generalize-s]
                }
              @discharge-r |
                forall r, s: Q; peano.succ(k) != NAT_ZERO -> qclearedSumGrounded(peano.succ(k))
                [by generalize generalize-r]
            }
          @conclusion-grounded-for-every-argument |
            forall p: QPoly; forall r, s: Q; peano.succ(k) != NAT_ZERO -> qclearedSumGrounded(peano.succ(k))
            [by generalize generalize-p]
        }
      @conclusion-the-step-at-k |
        (forall p2: QPoly; forall r2, s2: Q; k != NAT_ZERO -> qclearedSumGrounded(k))
          -> (forall p: QPoly; forall r, s: Q; peano.succ(k) != NAT_ZERO -> qclearedSumGrounded(peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: peano.Nat;
      (forall p2: QPoly; forall r2, s2: Q; k != NAT_ZERO -> qclearedSumGrounded(k))
      -> (forall p: QPoly; forall r, s: Q; peano.succ(k) != NAT_ZERO -> qclearedSumGrounded(peano.succ(k)))
    [by generalize generalize-k]
qed

// THE OBLIGATION. Induction on `k`; the base is VACUOUS, its antecedent `NAT_ZERO != NAT_ZERO` being
// false, and the step is the theorem above.
theorem qClearedSumIsGrounded: forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
  k != NAT_ZERO -> qclearedSumGrounded(k)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix p: QPoly {
      @generalize-r-at-zero |
        fix r: Q {
          @generalize-s-at-zero |
            fix s: Q {
              @conclusion-vacuously-grounded |
                NAT_ZERO != NAT_ZERO -> qclearedSumGrounded(NAT_ZERO)
                [using tautology zero-is-itself]
            }
          @discharge-s-at-zero |
            forall s: Q; NAT_ZERO != NAT_ZERO -> qclearedSumGrounded(NAT_ZERO)
            [by generalize generalize-s-at-zero]
        }
      @discharge-r-at-zero |
        forall r, s: Q; NAT_ZERO != NAT_ZERO -> qclearedSumGrounded(NAT_ZERO)
        [by generalize generalize-r-at-zero]
    }
  @base-case |
    forall p: QPoly; forall r, s: Q; NAT_ZERO != NAT_ZERO -> qclearedSumGrounded(NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: peano.Nat;
      (forall p2: QPoly; forall r2, s2: Q; k != NAT_ZERO -> qclearedSumGrounded(k))
      -> (forall p: QPoly; forall r, s: Q; peano.succ(k) != NAT_ZERO -> qclearedSumGrounded(peano.succ(k)))
    [by cite qClearedSumReachesABaseFromAPredecessor]
  @grounded-for-every-bound |
    forall k: peano.Nat; forall p: QPoly; forall r, s: Q; k != NAT_ZERO -> qclearedSumGrounded(k)
    [using instantiation peano.induction((fun k: peano.Nat => (forall p: QPoly; forall r, s: Q; k != NAT_ZERO -> qclearedSumGrounded(k)))) base-case induction-step-for-all-k]
  @generalize-p |
    fix p: QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @generalize-k |
                fix k: peano.Nat {
                  @grounded-at-k |
                    forall p4: QPoly; forall r4, s4: Q; k != NAT_ZERO -> qclearedSumGrounded(k)
                    [using specialize grounded-for-every-bound(k)]
                  @conclusion-grounded-here |
                    k != NAT_ZERO -> qclearedSumGrounded(k)
                    [using specialize grounded-at-k(p, r, s)]
                }
              @discharge-k |
                forall k: peano.Nat; k != NAT_ZERO -> qclearedSumGrounded(k)
                [by generalize generalize-k]
            }
          @discharge-s |
            forall s: Q; forall k: peano.Nat; k != NAT_ZERO -> qclearedSumGrounded(k)
            [by generalize generalize-s]
        }
      @discharge-r |
        forall r, s: Q; forall k: peano.Nat; k != NAT_ZERO -> qclearedSumGrounded(k)
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: QPoly; forall r, s: Q; forall k: peano.Nat; k != NAT_ZERO -> qclearedSumGrounded(k)
    [by generalize generalize-p]
qed

theorem qmonusAtZero:
  forall i: Nat; qmonus(i, NAT_ZERO) = i
proof
  @conclusion |
    forall i: Nat; qmonus(i, NAT_ZERO) = i
    [by definition(0) qmonus]
qed

// The `succ`/`succ` step, now DERIVED rather than transcribed: the definition descends by
// `prev` (the l-value rule keeps patterns off the left), so this restates it at a successor
// pair, where `prevOfSucc` collapses both `prev`s. The STATEMENT is unchanged, so every call
// site below still cites this theorem and the clause's guard never reaches them.
theorem qmonusSteps:
  forall i, j: Nat;
  qmonus(peano.succ(i), peano.succ(j)) = qmonus(i, j)
proof
  @the-recursive-clause |
    forall i2: Nat; forall j2: Nat;
      (i2 != NAT_ZERO and j2 != NAT_ZERO) ->
      qmonus(i2, j2) = qmonus(peano.prev(i2), peano.prev(j2))
    [by definition(1) qmonus]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @succ-i-is-nonzero |
            peano.succ(i) != NAT_ZERO
            [using specialize a-successor-is-never-zero(i)]
          @succ-j-is-nonzero |
            peano.succ(j) != NAT_ZERO
            [using specialize a-successor-is-never-zero(j)]
          @both-are-nonzero |
            peano.succ(i) != NAT_ZERO and peano.succ(j) != NAT_ZERO
            [by both succ-i-is-nonzero succ-j-is-nonzero]
          @clause-at-the-successor-pair |
            qmonus(peano.succ(i), peano.succ(j)) =
              qmonus(peano.prev(peano.succ(i)), peano.prev(peano.succ(j)))
            [using specialize the-recursive-clause(peano.succ(i), peano.succ(j)) both-are-nonzero]
          @prev-of-succ-i |
            peano.prev(peano.succ(i)) = i
            [using specialize prev-undoes-succ(i)]
          @prev-of-succ-j |
            peano.prev(peano.succ(j)) = j
            [using specialize prev-undoes-succ(j)]
          @first-prev-collapsed |
            qmonus(peano.succ(i), peano.succ(j)) = qmonus(i, peano.prev(peano.succ(j)))
            [by rewrite prev-of-succ-i clause-at-the-successor-pair]
          @conclusion-step-at-i-j |
            qmonus(peano.succ(i), peano.succ(j)) = qmonus(i, j)
            [by rewrite prev-of-succ-j first-prev-collapsed]
        }
      @discharge-j |
        forall j: Nat; qmonus(peano.succ(i), peano.succ(j)) = qmonus(i, j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j: Nat;
      qmonus(peano.succ(i), peano.succ(j)) = qmonus(i, j)
    [by generalize generalize-i]
qed

theorem qTheCofactorIndexAtZero:
  forall i, j: Nat;
  qtheCofactorIndex(i, j, NAT_ZERO) = qmonus(i, j)
proof
  @conclusion |
    forall i, j: Nat;
      qtheCofactorIndex(i, j, NAT_ZERO) = qmonus(i, j)
    [by definition(0) qtheCofactorIndex]
qed

theorem qTheCofactorIndexSteps:
  forall i, j, k: Nat;
  qtheCofactorIndex(i, j, peano.succ(k)) =
  qmonus(qmonus(i, j), peano.succ(k))
proof
  @conclusion |
    forall i, j, k: Nat;
      qtheCofactorIndex(i, j, peano.succ(k)) =
      qmonus(qmonus(i, j), peano.succ(k))
    [by definition(1) qtheCofactorIndex]
qed

theorem qCappedRunZero:
  forall q, r: QPoly; forall g: Nat;
  qcappedRun(q, r, g, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall q, r: QPoly; forall g: Nat;
      qcappedRun(q, r, g, NAT_ZERO) = ZERO
    [by definition(0) qcappedRun]
qed

// The `peano.succ` step, now DERIVED rather than transcribed: the definition descends by `peano.prev`, so
// this restates it at a successor, where `prevOfSucc` collapses all three `peano.prev(peano.succ(n))` sites
// in one rewrite. The STATEMENT is unchanged, which is what keeps the migration confined —
// every call site below cites this theorem, not the clause, so the clause's guard never
// reaches them.
theorem qCappedRunSucc:
  forall q, r: QPoly; forall g, n: Nat;
  qcappedRun(q, r, g, peano.succ(n)) =
  rational.add(qcappedRun(q, r, g, n),
  rational.mul(qcoeff(q, n), qcoeff(r, qmonus(g, n))))
proof
  @the-recursive-clause |
    forall q2, r2: QPoly; forall g2, n2: Nat;
      n2 != NAT_ZERO ->
      qcappedRun(q2, r2, g2, n2) =
      rational.add(qcappedRun(q2, r2, g2, peano.prev(n2)),
      rational.mul(qcoeff(q2, peano.prev(n2)), qcoeff(r2, qmonus(g2, peano.prev(n2)))))
    [by definition(1) qcappedRun]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-q |
    fix q: QPoly {
      @generalize-r |
        fix r: QPoly {
          @generalize-g |
            fix g: Nat {
              @generalize-n |
                fix n: Nat {
                  @succ-n-is-nonzero |
                    peano.succ(n) != NAT_ZERO
                    [using specialize a-successor-is-never-zero(n)]
                  @clause-at-the-successor |
                    qcappedRun(q, r, g, peano.succ(n)) =
                      rational.add(qcappedRun(q, r, g, peano.prev(peano.succ(n))),
                      rational.mul(qcoeff(q, peano.prev(peano.succ(n))), qcoeff(r, qmonus(g, peano.prev(peano.succ(n))))))
                    [using specialize the-recursive-clause(q, r, g, peano.succ(n)) succ-n-is-nonzero]
                  @prev-of-succ-n |
                    peano.prev(peano.succ(n)) = n
                    [using specialize prev-undoes-succ(n)]
                  @conclusion-step-at-n |
                    qcappedRun(q, r, g, peano.succ(n)) =
                      rational.add(qcappedRun(q, r, g, n),
                      rational.mul(qcoeff(q, n), qcoeff(r, qmonus(g, n))))
                    [by rewrite prev-of-succ-n clause-at-the-successor]
                }
              @discharge-n |
                forall n: Nat;
                  qcappedRun(q, r, g, peano.succ(n)) =
                  rational.add(qcappedRun(q, r, g, n),
                  rational.mul(qcoeff(q, n), qcoeff(r, qmonus(g, n))))
                [by generalize generalize-n]
            }
          @discharge-g |
            forall g, n: Nat;
              qcappedRun(q, r, g, peano.succ(n)) =
              rational.add(qcappedRun(q, r, g, n),
              rational.mul(qcoeff(q, n), qcoeff(r, qmonus(g, n))))
            [by generalize generalize-g]
        }
      @discharge-r |
        forall r: QPoly; forall g, n: Nat;
          qcappedRun(q, r, g, peano.succ(n)) =
          rational.add(qcappedRun(q, r, g, n),
          rational.mul(qcoeff(q, n), qcoeff(r, qmonus(g, n))))
        [by generalize generalize-r]
    }
  @conclusion |
    forall q, r: QPoly; forall g, n: Nat;
      qcappedRun(q, r, g, peano.succ(n)) =
      rational.add(qcappedRun(q, r, g, n),
      rational.mul(qcoeff(q, n), qcoeff(r, qmonus(g, n))))
    [by generalize generalize-q]
qed

// -- the capped run's TERMINATION obligation ----------------------------------------------
//
// `termination(peano):` names `qcappedRunIsGrounded`, and the checker SYNTHESIZES the statement it
// must have: the recursive arm's own guard at the declaration's parameters. The generated
// `qcappedRunGrounded` transcribes the single call site, with the terminating arm's pattern as its base
// alternative:
//
//     qcappedRunGrounded(n) iff (qcappedRunGrounded(peano.prev(n)) or peano.prev(n) = NAT_ZERO)
//
// `q`, `r` and `g` ride through untouched; only `n` descends, so the induction is on `n` alone.

// The step: groundedness below `peano.succ(n)` gives it at `peano.succ(n)`. Either the predecessor `n` is
// itself the base (the right disjunct fires) or the inductive hypothesis supplies it.
theorem qcappedRunReachesABaseFromAPredecessor: forall n: Nat;
  (forall q2, r2: QPoly; forall g2: Nat; n != NAT_ZERO -> qcappedRunGrounded(n))
  -> (forall q, r: QPoly; forall g: Nat; peano.succ(n) != NAT_ZERO -> qcappedRunGrounded(peano.succ(n)))
proof
  @the-generated-clause |
    forall n3: Nat; qcappedRunGrounded(n3) iff
      (qcappedRunGrounded(peano.prev(n3)) or peano.prev(n3) = NAT_ZERO)
    [by definition qcappedRunGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-n |
    fix n: Nat {
      @given-the-inductive-hypothesis |
        assume forall q2, r2: QPoly; forall g2: Nat; n != NAT_ZERO -> qcappedRunGrounded(n) {
          @inductive-hypothesis |
            forall q2, r2: QPoly; forall g2: Nat; n != NAT_ZERO -> qcappedRunGrounded(n)
            [by hypothesis given-the-inductive-hypothesis]
          // `peano.prev` is guarded, so these precede every term that writes `peano.prev(peano.succ(n))`.
          @succ-n-is-nonzero |
            peano.succ(n) != NAT_ZERO
            [using specialize a-successor-is-never-zero(n)]
          @prev-of-succ-n-is-n |
            peano.prev(peano.succ(n)) = n
            [using specialize prev-undoes-succ(n)]
          @generalize-q |
            fix q: QPoly {
              @generalize-r |
                fix r: QPoly {
                  @generalize-g |
                    fix g: Nat {
                      @given-succ-n-nonzero |
                        assume peano.succ(n) != NAT_ZERO {
                          @clause-at-the-successor |
                            qcappedRunGrounded(peano.succ(n)) iff
                              (qcappedRunGrounded(peano.prev(peano.succ(n))) or peano.prev(peano.succ(n)) = NAT_ZERO)
                            [using specialize the-generated-clause(peano.succ(n))]
                          @clause-with-the-predecessor-collapsed |
                            qcappedRunGrounded(peano.succ(n)) iff
                              (qcappedRunGrounded(n) or n = NAT_ZERO)
                            [by rewrite prev-of-succ-n-is-n clause-at-the-successor]
                          @the-inductive-hypothesis-here |
                            n != NAT_ZERO -> qcappedRunGrounded(n)
                            [using specialize inductive-hypothesis(q, r, g)]
                          @conclusion-grounded-at-succ-n |
                            qcappedRunGrounded(peano.succ(n))
                            [using tautology clause-with-the-predecessor-collapsed
                              the-inductive-hypothesis-here]
                        }
                      @conclusion-nonzero-gives-grounded |
                        peano.succ(n) != NAT_ZERO -> qcappedRunGrounded(peano.succ(n))
                        [by discharge given-succ-n-nonzero]
                    }
                  @discharge-g |
                    forall g: Nat; peano.succ(n) != NAT_ZERO -> qcappedRunGrounded(peano.succ(n))
                    [by generalize generalize-g]
                }
              @discharge-r |
                forall r: QPoly; forall g: Nat; peano.succ(n) != NAT_ZERO -> qcappedRunGrounded(peano.succ(n))
                [by generalize generalize-r]
            }
          @conclusion-grounded-for-every-argument |
            forall q, r: QPoly; forall g: Nat; peano.succ(n) != NAT_ZERO -> qcappedRunGrounded(peano.succ(n))
            [by generalize generalize-q]
        }
      @conclusion-the-step-at-n |
        (forall q2, r2: QPoly; forall g2: Nat; n != NAT_ZERO -> qcappedRunGrounded(n))
          -> (forall q, r: QPoly; forall g: Nat; peano.succ(n) != NAT_ZERO -> qcappedRunGrounded(peano.succ(n)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall n: Nat;
      (forall q2, r2: QPoly; forall g2: Nat; n != NAT_ZERO -> qcappedRunGrounded(n))
      -> (forall q, r: QPoly; forall g: Nat; peano.succ(n) != NAT_ZERO -> qcappedRunGrounded(peano.succ(n)))
    [by generalize generalize-n]
qed

// THE OBLIGATION. Induction on `n`; the base is VACUOUS, its antecedent `NAT_ZERO != NAT_ZERO` being
// false, and the step is the theorem above.
theorem qcappedRunIsGrounded: forall q, r: QPoly; forall g, n: Nat;
  n != NAT_ZERO -> qcappedRunGrounded(n)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix q: QPoly {
      @generalize-r-at-zero |
        fix r: QPoly {
          @generalize-g-at-zero |
            fix g: Nat {
              @conclusion-vacuously-grounded |
                NAT_ZERO != NAT_ZERO -> qcappedRunGrounded(NAT_ZERO)
                [using tautology zero-is-itself]
            }
          @discharge-g-at-zero |
            forall g: Nat; NAT_ZERO != NAT_ZERO -> qcappedRunGrounded(NAT_ZERO)
            [by generalize generalize-g-at-zero]
        }
      @discharge-r-at-zero |
        forall r: QPoly; forall g: Nat; NAT_ZERO != NAT_ZERO -> qcappedRunGrounded(NAT_ZERO)
        [by generalize generalize-r-at-zero]
    }
  @base-case |
    forall q, r: QPoly; forall g: Nat; NAT_ZERO != NAT_ZERO -> qcappedRunGrounded(NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-n |
    forall n: Nat;
      (forall q2, r2: QPoly; forall g2: Nat; n != NAT_ZERO -> qcappedRunGrounded(n))
      -> (forall q, r: QPoly; forall g: Nat; peano.succ(n) != NAT_ZERO -> qcappedRunGrounded(peano.succ(n)))
    [by cite qcappedRunReachesABaseFromAPredecessor]
  @grounded-for-every-run-length |
    forall n: Nat; forall q, r: QPoly; forall g: Nat; n != NAT_ZERO -> qcappedRunGrounded(n)
    [using instantiation peano.induction((fun n: Nat => (forall q, r: QPoly; forall g: Nat; n != NAT_ZERO -> qcappedRunGrounded(n)))) base-case induction-step-for-all-n]
  @generalize-q |
    fix q: QPoly {
      @generalize-r |
        fix r: QPoly {
          @generalize-g |
            fix g: Nat {
              @generalize-n |
                fix n: Nat {
                  @grounded-at-n |
                    forall q4, r4: QPoly; forall g4: Nat; n != NAT_ZERO -> qcappedRunGrounded(n)
                    [using specialize grounded-for-every-run-length(n)]
                  @conclusion-grounded-here |
                    n != NAT_ZERO -> qcappedRunGrounded(n)
                    [using specialize grounded-at-n(q, r, g)]
                }
              @discharge-n |
                forall n: Nat; n != NAT_ZERO -> qcappedRunGrounded(n)
                [by generalize generalize-n]
            }
          @discharge-g |
            forall g, n: Nat; n != NAT_ZERO -> qcappedRunGrounded(n)
            [by generalize generalize-g]
        }
      @discharge-r |
        forall r: QPoly; forall g, n: Nat; n != NAT_ZERO -> qcappedRunGrounded(n)
        [by generalize generalize-r]
    }
  @conclusion |
    forall q, r: QPoly; forall g, n: Nat; n != NAT_ZERO -> qcappedRunGrounded(n)
    [by generalize generalize-q]
qed

theorem qTripleTermMeaning:
  forall p, q, r: QPoly; forall i, j, k: Nat;
  qtripleTerm(p, q, r, i, j, k) =
  rational.mul(rational.mul(qcoeff(p, j), qcoeff(q, k)),
  qcoeff(r, qtheCofactorIndex(i, j, k)))
proof
  @conclusion |
    forall p, q, r: QPoly; forall i, j, k: Nat;
      qtripleTerm(p, q, r, i, j, k) =
      rational.mul(rational.mul(qcoeff(p, j), qcoeff(q, k)),
      qcoeff(r, qtheCofactorIndex(i, j, k)))
    [by definition qtripleTerm]
qed

theorem qTripleRowZero:
  forall p, q, r: QPoly; forall i, j: Nat;
  qtripleRow(p, q, r, i, j, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: QPoly; forall i, j: Nat;
      qtripleRow(p, q, r, i, j, NAT_ZERO) = ZERO
    [by definition(0) qtripleRow]
qed

// The successor step, now DERIVED rather than transcribed: the definition descends by `prev`,
// so this restates it at a successor, where `prevOfSucc` collapses both `prev`s in one rewrite
// (they are the same term). The STATEMENT is unchanged, which keeps the migration confined —
// every call site cites this theorem rather than the clause, so the clause's `n != NAT_ZERO` guard
// never reaches them.
theorem qTripleRowSucc:
  forall p, q, r: QPoly; forall i, j, n: Nat;
  qtripleRow(p, q, r, i, j, peano.succ(n)) =
  rational.add(qtripleRow(p, q, r, i, j, n), qtripleTerm(p, q, r, i, j, n))
proof
  @the-recursive-clause |
    forall p2, q2, r2: QPoly; forall i2, j2, n2: Nat;
      n2 != NAT_ZERO ->
      qtripleRow(p2, q2, r2, i2, j2, n2) =
      rational.add(qtripleRow(p2, q2, r2, i2, j2, peano.prev(n2)), qtripleTerm(p2, q2, r2, i2, j2, peano.prev(n2)))
    [by definition(1) qtripleRow]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-r |
            fix r: QPoly {
              @generalize-i |
                fix i: Nat {
                  @generalize-j |
                    fix j: Nat {
                      @generalize-n |
                        fix n: Nat {
                          @succ-n-is-nonzero |
                            peano.succ(n) != NAT_ZERO
                            [using specialize a-successor-is-never-zero(n)]
                          @clause-at-the-successor |
                            qtripleRow(p, q, r, i, j, peano.succ(n)) =
                              rational.add(qtripleRow(p, q, r, i, j, peano.prev(peano.succ(n))),
                              qtripleTerm(p, q, r, i, j, peano.prev(peano.succ(n))))
                            [using specialize the-recursive-clause(p, q, r, i, j, peano.succ(n))
                              succ-n-is-nonzero]
                          @prev-of-succ-n |
                            peano.prev(peano.succ(n)) = n
                            [using specialize prev-undoes-succ(n)]
                          @conclusion-step-at-n |
                            qtripleRow(p, q, r, i, j, peano.succ(n)) =
                              rational.add(qtripleRow(p, q, r, i, j, n), qtripleTerm(p, q, r, i, j, n))
                            [by rewrite prev-of-succ-n clause-at-the-successor]
                        }
                      @discharge-n |
                        forall n: Nat;
                          qtripleRow(p, q, r, i, j, peano.succ(n)) =
                          rational.add(qtripleRow(p, q, r, i, j, n), qtripleTerm(p, q, r, i, j, n))
                        [by generalize generalize-n]
                    }
                  @discharge-j |
                    forall j, n: Nat;
                      qtripleRow(p, q, r, i, j, peano.succ(n)) =
                      rational.add(qtripleRow(p, q, r, i, j, n), qtripleTerm(p, q, r, i, j, n))
                    [by generalize generalize-j]
                }
              @discharge-i |
                forall i, j, n: Nat;
                  qtripleRow(p, q, r, i, j, peano.succ(n)) =
                  rational.add(qtripleRow(p, q, r, i, j, n), qtripleTerm(p, q, r, i, j, n))
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: QPoly; forall i, j, n: Nat;
              qtripleRow(p, q, r, i, j, peano.succ(n)) =
              rational.add(qtripleRow(p, q, r, i, j, n), qtripleTerm(p, q, r, i, j, n))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: QPoly; forall i, j, n: Nat;
          qtripleRow(p, q, r, i, j, peano.succ(n)) =
          rational.add(qtripleRow(p, q, r, i, j, n), qtripleTerm(p, q, r, i, j, n))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: QPoly; forall i, j, n: Nat;
      qtripleRow(p, q, r, i, j, peano.succ(n)) =
      rational.add(qtripleRow(p, q, r, i, j, n), qtripleTerm(p, q, r, i, j, n))
    [by generalize generalize-p]
qed

theorem qTripleDiagZero:
  forall p, q, r: QPoly; forall i, m: Nat;
  qtripleDiag(p, q, r, i, m, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: QPoly; forall i, m: Nat;
      qtripleDiag(p, q, r, i, m, NAT_ZERO) = ZERO
    [by definition(0) qtripleDiag]
qed

// The successor step, now DERIVED rather than transcribed: the definition descends by `prev`,
// so this restates it at a successor, where `prevOfSucc` collapses all three `prev`s in one
// rewrite (they are the same term). The STATEMENT is unchanged, which keeps the migration
// confined — every call site cites this theorem rather than the clause.
theorem qTripleDiagSucc:
  forall p, q, r: QPoly; forall i, m, c: Nat;
  qtripleDiag(p, q, r, i, m, peano.succ(c)) =
  rational.add(qtripleDiag(p, q, r, i, m, c),
  qtripleTerm(p, q, r, i, c, qmonus(m, c)))
proof
  @the-recursive-clause |
    forall p2, q2, r2: QPoly; forall i2, m2, c2: Nat;
      c2 != NAT_ZERO ->
      qtripleDiag(p2, q2, r2, i2, m2, c2) =
      rational.add(qtripleDiag(p2, q2, r2, i2, m2, peano.prev(c2)),
      qtripleTerm(p2, q2, r2, i2, peano.prev(c2), qmonus(m2, peano.prev(c2))))
    [by definition(1) qtripleDiag]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-r |
            fix r: QPoly {
              @generalize-i |
                fix i: Nat {
                  @generalize-m |
                    fix m: Nat {
                      @generalize-c |
                        fix c: Nat {
                          @succ-c-is-nonzero |
                            peano.succ(c) != NAT_ZERO
                            [using specialize a-successor-is-never-zero(c)]
                          @clause-at-the-successor |
                            qtripleDiag(p, q, r, i, m, peano.succ(c)) =
                              rational.add(qtripleDiag(p, q, r, i, m, peano.prev(peano.succ(c))),
                              qtripleTerm(p, q, r, i, peano.prev(peano.succ(c)), qmonus(m, peano.prev(peano.succ(c)))))
                            [using specialize the-recursive-clause(p, q, r, i, m, peano.succ(c))
                              succ-c-is-nonzero]
                          @prev-of-succ-c |
                            peano.prev(peano.succ(c)) = c
                            [using specialize prev-undoes-succ(c)]
                          @conclusion-step-at-c |
                            qtripleDiag(p, q, r, i, m, peano.succ(c)) =
                              rational.add(qtripleDiag(p, q, r, i, m, c),
                              qtripleTerm(p, q, r, i, c, qmonus(m, c)))
                            [by rewrite prev-of-succ-c clause-at-the-successor]
                        }
                      @discharge-c |
                        forall c: Nat;
                          qtripleDiag(p, q, r, i, m, peano.succ(c)) =
                          rational.add(qtripleDiag(p, q, r, i, m, c),
                          qtripleTerm(p, q, r, i, c, qmonus(m, c)))
                        [by generalize generalize-c]
                    }
                  @discharge-m |
                    forall m, c: Nat;
                      qtripleDiag(p, q, r, i, m, peano.succ(c)) =
                      rational.add(qtripleDiag(p, q, r, i, m, c),
                      qtripleTerm(p, q, r, i, c, qmonus(m, c)))
                    [by generalize generalize-m]
                }
              @discharge-i |
                forall i, m, c: Nat;
                  qtripleDiag(p, q, r, i, m, peano.succ(c)) =
                  rational.add(qtripleDiag(p, q, r, i, m, c),
                  qtripleTerm(p, q, r, i, c, qmonus(m, c)))
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: QPoly; forall i, m, c: Nat;
              qtripleDiag(p, q, r, i, m, peano.succ(c)) =
              rational.add(qtripleDiag(p, q, r, i, m, c),
              qtripleTerm(p, q, r, i, c, qmonus(m, c)))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: QPoly; forall i, m, c: Nat;
          qtripleDiag(p, q, r, i, m, peano.succ(c)) =
          rational.add(qtripleDiag(p, q, r, i, m, c),
          qtripleTerm(p, q, r, i, c, qmonus(m, c)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: QPoly; forall i, m, c: Nat;
      qtripleDiag(p, q, r, i, m, peano.succ(c)) =
      rational.add(qtripleDiag(p, q, r, i, m, c),
      qtripleTerm(p, q, r, i, c, qmonus(m, c)))
    [by generalize generalize-p]
qed

theorem qTripleTriZero:
  forall p, q, r: QPoly; forall i: Nat;
  qtripleTri(p, q, r, i, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: QPoly; forall i: Nat;
      qtripleTri(p, q, r, i, NAT_ZERO) = ZERO
    [by definition(0) qtripleTri]
qed

// The successor step, now DERIVED rather than transcribed. One `rewrite` collapses the single
// `peano.prev(peano.succ(n))` the clause writes; the anti-diagonal's length argument is already `peano.succ(n)`
// in both forms and needs nothing. The STATEMENT is unchanged, which keeps the migration
// confined — every call site cites this theorem rather than the clause.
theorem qTripleTriSucc:
  forall p, q, r: QPoly; forall i, n: Nat;
  qtripleTri(p, q, r, i, peano.succ(n)) =
  rational.add(qtripleTri(p, q, r, i, n), qtripleDiag(p, q, r, i, n, peano.succ(n)))
proof
  @the-recursive-clause |
    forall p2, q2, r2: QPoly; forall i2, n2: Nat;
      n2 != NAT_ZERO ->
      qtripleTri(p2, q2, r2, i2, n2) =
      rational.add(qtripleTri(p2, q2, r2, i2, peano.prev(n2)), qtripleDiag(p2, q2, r2, i2, peano.prev(n2), n2))
    [by definition(1) qtripleTri]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-r |
            fix r: QPoly {
              @generalize-i |
                fix i: Nat {
                  @generalize-n |
                    fix n: Nat {
                      @succ-n-is-nonzero |
                        peano.succ(n) != NAT_ZERO
                        [using specialize a-successor-is-never-zero(n)]
                      @clause-at-the-successor |
                        qtripleTri(p, q, r, i, peano.succ(n)) =
                          rational.add(qtripleTri(p, q, r, i, peano.prev(peano.succ(n))),
                          qtripleDiag(p, q, r, i, peano.prev(peano.succ(n)), peano.succ(n)))
                        [using specialize the-recursive-clause(p, q, r, i, peano.succ(n))
                          succ-n-is-nonzero]
                      @prev-of-succ-n |
                        peano.prev(peano.succ(n)) = n
                        [using specialize prev-undoes-succ(n)]
                      @conclusion-step-at-n |
                        qtripleTri(p, q, r, i, peano.succ(n)) =
                          rational.add(qtripleTri(p, q, r, i, n), qtripleDiag(p, q, r, i, n, peano.succ(n)))
                        [by rewrite prev-of-succ-n clause-at-the-successor]
                    }
                  @discharge-n |
                    forall n: Nat;
                      qtripleTri(p, q, r, i, peano.succ(n)) =
                      rational.add(qtripleTri(p, q, r, i, n), qtripleDiag(p, q, r, i, n, peano.succ(n)))
                    [by generalize generalize-n]
                }
              @discharge-i |
                forall i, n: Nat;
                  qtripleTri(p, q, r, i, peano.succ(n)) =
                  rational.add(qtripleTri(p, q, r, i, n), qtripleDiag(p, q, r, i, n, peano.succ(n)))
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: QPoly; forall i, n: Nat;
              qtripleTri(p, q, r, i, peano.succ(n)) =
              rational.add(qtripleTri(p, q, r, i, n), qtripleDiag(p, q, r, i, n, peano.succ(n)))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: QPoly; forall i, n: Nat;
          qtripleTri(p, q, r, i, peano.succ(n)) =
          rational.add(qtripleTri(p, q, r, i, n), qtripleDiag(p, q, r, i, n, peano.succ(n)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: QPoly; forall i, n: Nat;
      qtripleTri(p, q, r, i, peano.succ(n)) =
      rational.add(qtripleTri(p, q, r, i, n), qtripleDiag(p, q, r, i, n, peano.succ(n)))
    [by generalize generalize-p]
qed

theorem qTripleRowsZero:
  forall p, q, r: QPoly; forall i, n: Nat;
  qtripleRows(p, q, r, i, NAT_ZERO, n) = ZERO
proof
  @conclusion |
    forall p, q, r: QPoly; forall i, n: Nat;
      qtripleRows(p, q, r, i, NAT_ZERO, n) = ZERO
    [by definition(0) qtripleRows]
qed

// The successor step, now DERIVED rather than transcribed: the definition descends by `prev`
// on `m`, so this restates it at a successor there, where `prevOfSucc` collapses all three
// `prev`s in one rewrite. The STATEMENT is unchanged, which keeps the migration confined.
theorem qTripleRowsSucc:
  forall p, q, r: QPoly; forall i, m, n: Nat;
  qtripleRows(p, q, r, i, peano.succ(m), n) =
  rational.add(qtripleRows(p, q, r, i, m, n),
  qtripleRow(p, q, r, i, m, qmonus(n, m)))
proof
  @the-recursive-clause |
    forall p2, q2, r2: QPoly; forall i2, m2, n2: Nat;
      m2 != NAT_ZERO ->
      qtripleRows(p2, q2, r2, i2, m2, n2) =
      rational.add(qtripleRows(p2, q2, r2, i2, peano.prev(m2), n2),
      qtripleRow(p2, q2, r2, i2, peano.prev(m2), qmonus(n2, peano.prev(m2))))
    [by definition(1) qtripleRows]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-r |
            fix r: QPoly {
              @generalize-i |
                fix i: Nat {
                  @generalize-m |
                    fix m: Nat {
                      @generalize-n |
                        fix n: Nat {
                          @succ-m-is-nonzero |
                            peano.succ(m) != NAT_ZERO
                            [using specialize a-successor-is-never-zero(m)]
                          @clause-at-the-successor |
                            qtripleRows(p, q, r, i, peano.succ(m), n) =
                              rational.add(qtripleRows(p, q, r, i, peano.prev(peano.succ(m)), n),
                              qtripleRow(p, q, r, i, peano.prev(peano.succ(m)), qmonus(n, peano.prev(peano.succ(m)))))
                            [using specialize the-recursive-clause(p, q, r, i, peano.succ(m), n)
                              succ-m-is-nonzero]
                          @prev-of-succ-m |
                            peano.prev(peano.succ(m)) = m
                            [using specialize prev-undoes-succ(m)]
                          @conclusion-step-at-m |
                            qtripleRows(p, q, r, i, peano.succ(m), n) =
                              rational.add(qtripleRows(p, q, r, i, m, n),
                              qtripleRow(p, q, r, i, m, qmonus(n, m)))
                            [by rewrite prev-of-succ-m clause-at-the-successor]
                        }
                      @discharge-n |
                        forall n: Nat;
                          qtripleRows(p, q, r, i, peano.succ(m), n) =
                          rational.add(qtripleRows(p, q, r, i, m, n),
                          qtripleRow(p, q, r, i, m, qmonus(n, m)))
                        [by generalize generalize-n]
                    }
                  @discharge-m |
                    forall m, n: Nat;
                      qtripleRows(p, q, r, i, peano.succ(m), n) =
                      rational.add(qtripleRows(p, q, r, i, m, n),
                      qtripleRow(p, q, r, i, m, qmonus(n, m)))
                    [by generalize generalize-m]
                }
              @discharge-i |
                forall i, m, n: Nat;
                  qtripleRows(p, q, r, i, peano.succ(m), n) =
                  rational.add(qtripleRows(p, q, r, i, m, n),
                  qtripleRow(p, q, r, i, m, qmonus(n, m)))
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: QPoly; forall i, m, n: Nat;
              qtripleRows(p, q, r, i, peano.succ(m), n) =
              rational.add(qtripleRows(p, q, r, i, m, n),
              qtripleRow(p, q, r, i, m, qmonus(n, m)))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: QPoly; forall i, m, n: Nat;
          qtripleRows(p, q, r, i, peano.succ(m), n) =
          rational.add(qtripleRows(p, q, r, i, m, n),
          qtripleRow(p, q, r, i, m, qmonus(n, m)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: QPoly; forall i, m, n: Nat;
      qtripleRows(p, q, r, i, peano.succ(m), n) =
      rational.add(qtripleRows(p, q, r, i, m, n),
      qtripleRow(p, q, r, i, m, qmonus(n, m)))
    [by generalize generalize-p]
qed

// -- the TERMINATION obligation for `qmonus` ------------------------------------------------
//
// `termination(peano):` names `qmonusIsGrounded`, and the checker SYNTHESIZES the statement it
// must have — the recursive arm's own guard implying the generated predicate. The predicate
// itself is generated from the arm's call sites, one conjunct per site, each a disjunction of
// that call grounded with its arguments hitting a terminating arm's pattern. Those base
// disjuncts let the recursion bottom out, and all three are needed: `j` running out fires the
// third, `i` running out first fires the second.

// Strategy: induction on the SECOND argument. The one subtlety is that `peano.prev(i) != NAT_ZERO`
// does NOT follow from `i != NAT_ZERO` (take i = 1), so the inductive hypothesis is not
// applicable at `peano.prev(i)` — and need not be, since that is exactly the case the second
// disjunct covers. `tautology` picks whichever disjunct holds.
theorem qmonusReachesABaseFromAPredecessor: forall k: Nat;
  (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> qmonusGrounded(i2, k))
  -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> qmonusGrounded(i, peano.succ(k)))
proof
  @the-generated-clause |
    forall i3: Nat; forall j3: Nat;
      qmonusGrounded(i3, j3) iff
      (qmonusGrounded(peano.prev(i3), peano.prev(j3)) or peano.prev(i3) = NAT_ZERO
      or peano.prev(j3) = NAT_ZERO)
    [by definition qmonusGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> qmonusGrounded(i2, k) {
          @inductive-hypothesis |
            forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> qmonusGrounded(i2, k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so this must precede every term writing `peano.prev(peano.succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-i |
            fix i: Nat {
              @given-i-nonzero-and-succ-k-nonzero |
                assume i != NAT_ZERO and peano.succ(k) != NAT_ZERO {
                  @i-is-nonzero-and-so-is-succ-k |
                    i != NAT_ZERO and peano.succ(k) != NAT_ZERO
                    [by hypothesis given-i-nonzero-and-succ-k-nonzero]
                  @i-is-nonzero |
                    i != NAT_ZERO
                    [by and_lhs i-is-nonzero-and-so-is-succ-k]
                  @clause-at-i-and-succ-k |
                    qmonusGrounded(i, peano.succ(k)) iff
                      (qmonusGrounded(peano.prev(i), peano.prev(peano.succ(k))) or peano.prev(i) = NAT_ZERO
                      or peano.prev(peano.succ(k)) = NAT_ZERO)
                    [using specialize the-generated-clause(i, peano.succ(k))]
                  @clause-with-the-predecessor-collapsed |
                    qmonusGrounded(i, peano.succ(k)) iff
                      (qmonusGrounded(peano.prev(i), k) or peano.prev(i) = NAT_ZERO or k = NAT_ZERO)
                    [by rewrite prev-of-succ-k-is-k clause-at-i-and-succ-k]
                  @the-inductive-hypothesis-at-the-predecessor |
                    (peano.prev(i) != NAT_ZERO and k != NAT_ZERO) -> qmonusGrounded(peano.prev(i), k)
                    [using specialize inductive-hypothesis(peano.prev(i))]
                  @conclusion-grounded-at-succ-k |
                    qmonusGrounded(i, peano.succ(k))
                    [using tautology clause-with-the-predecessor-collapsed
                      the-inductive-hypothesis-at-the-predecessor]
                }
              @nonzero-implies-grounded-at-succ-k |
                (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> qmonusGrounded(i, peano.succ(k))
                [by discharge given-i-nonzero-and-succ-k-nonzero]
            }
          @conclusion-for-all-i |
            forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> qmonusGrounded(i, peano.succ(k))
            [by generalize generalize-i]
        }
      @the-hypothesis-implies-the-step |
        (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> qmonusGrounded(i2, k))
          -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> qmonusGrounded(i, peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> qmonusGrounded(i2, k))
      -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> qmonusGrounded(i, peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the second argument. The base is VACUOUS — at j = NAT_ZERO the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so all the content is in the step above.
theorem qmonusIsGrounded: forall i: Nat; forall j: Nat;
  (i != NAT_ZERO and j != NAT_ZERO) -> qmonusGrounded(i, j)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binder is opened before the
  // vacuous antecedent can be refuted inside it.
  @base-case-proof |
    fix i: Nat {
      @conclusion-vacuously-grounded-at-zero |
        (i != NAT_ZERO and NAT_ZERO != NAT_ZERO) -> qmonusGrounded(i, NAT_ZERO)
        [using tautology zero-is-itself]
    }
  @base-case |
    forall i: Nat; (i != NAT_ZERO and NAT_ZERO != NAT_ZERO) -> qmonusGrounded(i, NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> qmonusGrounded(i2, k))
      -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> qmonusGrounded(i, peano.succ(k)))
    [by cite qmonusReachesABaseFromAPredecessor]
  @grounded-for-every-second-argument |
    forall j: Nat; forall i: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> qmonusGrounded(i, j)
    [using instantiation peano.induction((fun j: Nat => (forall i: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> qmonusGrounded(i, j)))) base-case induction-step-for-all-k]
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @grounded-at-j-and-i |
            (i != NAT_ZERO and j != NAT_ZERO) -> qmonusGrounded(i, j)
            [using specialize grounded-for-every-second-argument(j, i)]
        }
      @discharge-j |
        forall j: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> qmonusGrounded(i, j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> qmonusGrounded(i, j)
    [by generalize generalize-i]
qed

// -- qconvolution's TERMINATION obligation ------------------------------------------
//
// The checker GENERATES the predicate from the recursive arm's one call site:
//
//     qconvolutionGrounded(m) iff
//       (qconvolutionGrounded(peano.prev(m))
//        or peano.prev(m) = NAT_ZERO)
//
// The `peano.prev(m) = NAT_ZERO` disjunct is the base — the NAT_ZERO arm is the only terminating
// one — and it is what lets the recursion bottom out. The ASCENDING `j` costs nothing: it
// rides along untouched, because termination asks only whether the DESCENT reaches a base.

// Strategy: the inductive step on the descending index. At `succ(k)` the clause's `prev`
// collapses to `k`, leaving either `k = NAT_ZERO` (base disjunct) or the hypothesis at `k`;
// `tautology` picks whichever holds. The ascending index is read at `succ(j)`.
theorem qConvolutionReachesZeroFromAPredecessor: forall k: Nat;
  (forall p2: QPoly; forall q2: QPoly; forall j2: Nat;
  k != NAT_ZERO -> qconvolutionGrounded(k))
  -> (forall p: QPoly; forall q: QPoly; forall j: Nat;
  peano.succ(k) != NAT_ZERO -> qconvolutionGrounded(peano.succ(k)))
proof
  @the-generated-clause |
    forall m3: Nat; qconvolutionGrounded(m3) iff
      (qconvolutionGrounded(peano.prev(m3))
      or peano.prev(m3) = NAT_ZERO)
    [by definition qconvolutionGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall p2: QPoly; forall q2: QPoly; forall j2: Nat;
          k != NAT_ZERO -> qconvolutionGrounded(k) {
          @inductive-hypothesis |
            forall p2: QPoly; forall q2: QPoly; forall j2: Nat;
              k != NAT_ZERO -> qconvolutionGrounded(k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so the guard fact precedes every term writing `peano.prev(succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-p |
            fix p: QPoly {
              @generalize-q |
                fix q: QPoly {
                  @generalize-j |
                    fix j: Nat {
                      @clause-at-succ-k |
                        qconvolutionGrounded(peano.succ(k)) iff
                          (qconvolutionGrounded(peano.prev(peano.succ(k)))
                          or peano.prev(peano.succ(k)) = NAT_ZERO)
                        [using specialize the-generated-clause(peano.succ(k))]
                      @clause-with-the-predecessor-collapsed |
                        qconvolutionGrounded(peano.succ(k)) iff
                          (qconvolutionGrounded(k) or k = NAT_ZERO)
                        [by rewrite prev-of-succ-k-is-k clause-at-succ-k]
                      @the-inductive-hypothesis-at-the-raised-index |
                        k != NAT_ZERO -> qconvolutionGrounded(k)
                        [using specialize inductive-hypothesis(p, q, peano.succ(j))]
                      @grounded-at-succ-k |
                        qconvolutionGrounded(peano.succ(k))
                        [using tautology clause-with-the-predecessor-collapsed
                          the-inductive-hypothesis-at-the-raised-index]
                      @conclusion-nonzero-implies-grounded |
                        peano.succ(k) != NAT_ZERO
                          -> qconvolutionGrounded(peano.succ(k))
                        [using tautology grounded-at-succ-k]
                    }
                  @discharge-j |
                    forall j: Nat;
                      peano.succ(k) != NAT_ZERO
                      -> qconvolutionGrounded(peano.succ(k))
                    [by generalize generalize-j]
                }
              @discharge-q |
                forall q: QPoly; forall j: Nat;
                  peano.succ(k) != NAT_ZERO
                  -> qconvolutionGrounded(peano.succ(k))
                [by generalize generalize-q]
            }
          @conclusion-for-all-polynomials |
            forall p: QPoly; forall q: QPoly; forall j: Nat;
              peano.succ(k) != NAT_ZERO -> qconvolutionGrounded(peano.succ(k))
            [by generalize generalize-p]
        }
      @the-hypothesis-implies-the-step |
        (forall p2: QPoly; forall q2: QPoly; forall j2: Nat;
          k != NAT_ZERO -> qconvolutionGrounded(k))
          -> (forall p: QPoly; forall q: QPoly; forall j: Nat;
          peano.succ(k) != NAT_ZERO -> qconvolutionGrounded(peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall p2: QPoly; forall q2: QPoly; forall j2: Nat;
      k != NAT_ZERO -> qconvolutionGrounded(k))
      -> (forall p: QPoly; forall q: QPoly; forall j: Nat;
      peano.succ(k) != NAT_ZERO -> qconvolutionGrounded(peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the descending index. The base is VACUOUS — at NAT_ZERO the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so all the content is in the step above.
theorem qConvolutionIsGrounded:
  forall p: QPoly; forall q: QPoly; forall j: Nat; forall m: Nat;
  m != NAT_ZERO -> qconvolutionGrounded(m)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix p: QPoly {
      @generalize-q-at-zero |
        fix q: QPoly {
          @generalize-j-at-zero |
            fix j: Nat {
              @conclusion-vacuously-grounded-at-zero |
                NAT_ZERO != NAT_ZERO -> qconvolutionGrounded(NAT_ZERO)
                [using tautology zero-is-itself]
            }
          @discharge-j-at-zero |
            forall j: Nat;
              NAT_ZERO != NAT_ZERO -> qconvolutionGrounded(NAT_ZERO)
            [by generalize generalize-j-at-zero]
        }
      @discharge-q-at-zero |
        forall q: QPoly; forall j: Nat;
          NAT_ZERO != NAT_ZERO -> qconvolutionGrounded(NAT_ZERO)
        [by generalize generalize-q-at-zero]
    }
  @base-case |
    forall p: QPoly; forall q: QPoly; forall j: Nat;
      NAT_ZERO != NAT_ZERO -> qconvolutionGrounded(NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall p2: QPoly; forall q2: QPoly; forall j2: Nat;
      k != NAT_ZERO -> qconvolutionGrounded(k))
      -> (forall p: QPoly; forall q: QPoly; forall j: Nat;
      peano.succ(k) != NAT_ZERO -> qconvolutionGrounded(peano.succ(k)))
    [by cite qConvolutionReachesZeroFromAPredecessor]
  @grounded-for-every-descending-index |
    forall m: Nat; forall p: QPoly; forall q: QPoly; forall j: Nat;
      m != NAT_ZERO -> qconvolutionGrounded(m)
    [using instantiation peano.induction((fun m: Nat => (forall p: QPoly; forall q: QPoly; forall j: Nat; m != NAT_ZERO -> qconvolutionGrounded(m)))) base-case induction-step-for-all-k]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @grounded-at-these-indices |
                    m != NAT_ZERO -> qconvolutionGrounded(m)
                    [using specialize grounded-for-every-descending-index(m, p, q, j)]
                }
              @discharge-m |
                forall m: Nat; m != NAT_ZERO -> qconvolutionGrounded(m)
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j: Nat; forall m: Nat;
              m != NAT_ZERO -> qconvolutionGrounded(m)
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: QPoly; forall j: Nat; forall m: Nat;
          m != NAT_ZERO -> qconvolutionGrounded(m)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p: QPoly; forall q: QPoly; forall j: Nat; forall m: Nat;
      m != NAT_ZERO -> qconvolutionGrounded(m)
    [by generalize generalize-p]
qed

// -- qtailConvolution's TERMINATION obligation ---------------------------------------------
//
// The generated predicate transcribes the recursive arm's one call site, with the NAT_ZERO arm's
// pattern as its base alternative:
//
//   qtailConvolutionGrounded(j) iff
//     (qtailConvolutionGrounded(peano.prev(j)) or peano.prev(j) = NAT_ZERO)
//
// The `peano.prev(j) = NAT_ZERO` disjunct is the base — the NAT_ZERO arm is the only terminating one, and it
// narrows the THIRD slot — and it is what lets the recursion bottom out.
//
// Note what the ASCENDING `m` costs: nothing, exactly as `convolution`'s ascending `j` cost
// nothing. It rides along in both the predicate and the obligation, because termination asks
// only whether the DESCENT reaches a base.

// Strategy: the inductive step on the descending index. At `peano.succ(k)` the generated clause's
// `prev` collapses to `k`, leaving either `k = NAT_ZERO` (the base disjunct fires) or the
// inductive hypothesis at `k`. `tautology` picks whichever holds. The ascending `m` is
// specialized at `peano.succ(m)`, which is where the hypothesis has to be read.
theorem qTailConvolutionReachesZeroFromAPredecessor: forall k: Nat;
  (forall p2: QPoly; forall q2: QPoly; forall m2: Nat;
  k != NAT_ZERO -> qtailConvolutionGrounded(k))
  -> (forall p: QPoly; forall q: QPoly; forall m: Nat;
  peano.succ(k) != NAT_ZERO -> qtailConvolutionGrounded(peano.succ(k)))
proof
  @the-generated-clause |
    forall j3: Nat; qtailConvolutionGrounded(j3) iff
      (qtailConvolutionGrounded(peano.prev(j3)) or peano.prev(j3) = NAT_ZERO)
    [by definition qtailConvolutionGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall p2: QPoly; forall q2: QPoly; forall m2: Nat;
          k != NAT_ZERO -> qtailConvolutionGrounded(k) {
          @inductive-hypothesis |
            forall p2: QPoly; forall q2: QPoly; forall m2: Nat;
              k != NAT_ZERO -> qtailConvolutionGrounded(k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so BOTH of these precede every term writing `peano.prev(peano.succ(k))`:
          // the guard fact first, then the collapse.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-p |
            fix p: QPoly {
              @generalize-q |
                fix q: QPoly {
                  @generalize-m |
                    fix m: Nat {
                      @clause-at-succ-k |
                        qtailConvolutionGrounded(peano.succ(k)) iff
                          (qtailConvolutionGrounded(peano.prev(peano.succ(k)))
                          or peano.prev(peano.succ(k)) = NAT_ZERO)
                        [using specialize the-generated-clause(peano.succ(k))]
                      @clause-with-the-predecessor-collapsed |
                        qtailConvolutionGrounded(peano.succ(k)) iff
                          (qtailConvolutionGrounded(k) or k = NAT_ZERO)
                        [by rewrite prev-of-succ-k-is-k clause-at-succ-k]
                      @the-inductive-hypothesis-at-the-raised-index |
                        k != NAT_ZERO -> qtailConvolutionGrounded(k)
                        [using specialize inductive-hypothesis(p, q, peano.succ(m))]
                      @grounded-at-succ-k |
                        qtailConvolutionGrounded(peano.succ(k))
                        [using tautology clause-with-the-predecessor-collapsed
                          the-inductive-hypothesis-at-the-raised-index]
                      @conclusion-nonzero-implies-grounded |
                        peano.succ(k) != NAT_ZERO -> qtailConvolutionGrounded(peano.succ(k))
                        [using tautology grounded-at-succ-k]
                    }
                  @discharge-m |
                    forall m: Nat;
                      peano.succ(k) != NAT_ZERO -> qtailConvolutionGrounded(peano.succ(k))
                    [by generalize generalize-m]
                }
              @discharge-q |
                forall q: QPoly; forall m: Nat;
                  peano.succ(k) != NAT_ZERO -> qtailConvolutionGrounded(peano.succ(k))
                [by generalize generalize-q]
            }
          @conclusion-for-all-polynomials |
            forall p: QPoly; forall q: QPoly; forall m: Nat;
              peano.succ(k) != NAT_ZERO -> qtailConvolutionGrounded(peano.succ(k))
            [by generalize generalize-p]
        }
      @the-hypothesis-implies-the-step |
        (forall p2: QPoly; forall q2: QPoly; forall m2: Nat;
          k != NAT_ZERO -> qtailConvolutionGrounded(k))
          -> (forall p: QPoly; forall q: QPoly; forall m: Nat;
          peano.succ(k) != NAT_ZERO -> qtailConvolutionGrounded(peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall p2: QPoly; forall q2: QPoly; forall m2: Nat;
      k != NAT_ZERO -> qtailConvolutionGrounded(k))
      -> (forall p: QPoly; forall q: QPoly; forall m: Nat;
      peano.succ(k) != NAT_ZERO -> qtailConvolutionGrounded(peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the descending index. The base is VACUOUS — at j = NAT_ZERO the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so all the content is in the step above.
theorem qTailConvolutionIsGrounded: forall p: QPoly; forall q: QPoly; forall j: Nat; forall m: Nat;
  j != NAT_ZERO -> qtailConvolutionGrounded(j)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix p: QPoly {
      @generalize-q-at-zero |
        fix q: QPoly {
          @generalize-m-at-zero |
            fix m: Nat {
              @conclusion-vacuously-grounded-at-zero |
                NAT_ZERO != NAT_ZERO -> qtailConvolutionGrounded(NAT_ZERO)
                [using tautology zero-is-itself]
            }
          @discharge-m-at-zero |
            forall m: Nat; NAT_ZERO != NAT_ZERO -> qtailConvolutionGrounded(NAT_ZERO)
            [by generalize generalize-m-at-zero]
        }
      @discharge-q-at-zero |
        forall q: QPoly; forall m: Nat;
          NAT_ZERO != NAT_ZERO -> qtailConvolutionGrounded(NAT_ZERO)
        [by generalize generalize-q-at-zero]
    }
  @base-case |
    forall p: QPoly; forall q: QPoly; forall m: Nat;
      NAT_ZERO != NAT_ZERO -> qtailConvolutionGrounded(NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall p2: QPoly; forall q2: QPoly; forall m2: Nat;
      k != NAT_ZERO -> qtailConvolutionGrounded(k))
      -> (forall p: QPoly; forall q: QPoly; forall m: Nat;
      peano.succ(k) != NAT_ZERO -> qtailConvolutionGrounded(peano.succ(k)))
    [by cite qTailConvolutionReachesZeroFromAPredecessor]
  @grounded-for-every-descending-index |
    forall j: Nat; forall p: QPoly; forall q: QPoly; forall m: Nat;
      j != NAT_ZERO -> qtailConvolutionGrounded(j)
    [using instantiation peano.induction((fun j: Nat => (forall p: QPoly; forall q: QPoly; forall m: Nat; j != NAT_ZERO -> qtailConvolutionGrounded(j)))) base-case induction-step-for-all-k]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @grounded-at-these-indices |
                    j != NAT_ZERO -> qtailConvolutionGrounded(j)
                    [using specialize grounded-for-every-descending-index(j, p, q, m)]
                }
              @discharge-m |
                forall m: Nat; j != NAT_ZERO -> qtailConvolutionGrounded(j)
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j: Nat; forall m: Nat; j != NAT_ZERO -> qtailConvolutionGrounded(j)
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: QPoly; forall j: Nat; forall m: Nat;
          j != NAT_ZERO -> qtailConvolutionGrounded(j)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p: QPoly; forall q: QPoly; forall j: Nat; forall m: Nat;
      j != NAT_ZERO -> qtailConvolutionGrounded(j)
    [by generalize generalize-p]
qed

// -- the TERMINATION obligation for `qtripleRow` -------------------------------------------
//
// `termination(peano):` names `qtripleRowIsGrounded`, and the checker SYNTHESIZES the statement
// it must have — the recursive arm's own guard implying the generated predicate:
//
//     forall p, q, r: QPoly; forall i, j, n: Nat; n != NAT_ZERO -> qtripleRowGrounded(n)
//
// `qtripleRowGrounded` is GENERATED from the arm's one recursive call site, a disjunction of
// that call grounded with its argument hitting the terminating arm's pattern:
//
//     qtripleRowGrounded(n) iff
//       (qtripleRowGrounded(peano.prev(n)) or peano.prev(n) = NAT_ZERO)
//
// Five of the six binders ride along untouched; only `n` descends, so this is `evalUpTo`'s
// shape with more scaffolding and no more mathematics.

// Strategy: the step of an induction on the row length. At `peano.succ(n)` the predecessor is `n`, so
// either `n = NAT_ZERO` and the base disjunct fires outright, or the inductive hypothesis applies
// at `n`. `tautology` picks whichever holds.
theorem qtripleRowReachesABaseFromAPredecessor: forall n: Nat;
  (forall p2, q2, r2: QPoly; forall i2, j2: Nat; n != NAT_ZERO -> qtripleRowGrounded(n))
  -> (forall p, q, r: QPoly; forall i, j: Nat; peano.succ(n) != NAT_ZERO -> qtripleRowGrounded(peano.succ(n)))
proof
  @the-generated-clause |
    forall n3: Nat; qtripleRowGrounded(n3) iff
      (qtripleRowGrounded(peano.prev(n3)) or peano.prev(n3) = NAT_ZERO)
    [by definition qtripleRowGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-n |
    fix n: Nat {
      @given-the-inductive-hypothesis |
        assume forall p2, q2, r2: QPoly; forall i2, j2: Nat; n != NAT_ZERO -> qtripleRowGrounded(n) {
          @inductive-hypothesis |
            forall p2, q2, r2: QPoly; forall i2, j2: Nat; n != NAT_ZERO -> qtripleRowGrounded(n)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so these precede every term that writes `peano.prev(peano.succ(n))`.
          @succ-n-is-nonzero |
            peano.succ(n) != NAT_ZERO
            [using specialize a-successor-is-never-zero(n)]
          @prev-of-succ-n-is-n |
            peano.prev(peano.succ(n)) = n
            [using specialize prev-undoes-succ(n)]
          @generalize-p |
            fix p: QPoly {
              @generalize-q |
                fix q: QPoly {
                  @generalize-r |
                    fix r: QPoly {
                      @generalize-i |
                        fix i: Nat {
                          @generalize-j |
                            fix j: Nat {
                              @given-succ-n-nonzero |
                                assume peano.succ(n) != NAT_ZERO {
                                  @clause-at-the-successor |
                                    qtripleRowGrounded(peano.succ(n)) iff
                                      (qtripleRowGrounded(peano.prev(peano.succ(n))) or peano.prev(peano.succ(n)) = NAT_ZERO)
                                    [using specialize the-generated-clause(peano.succ(n))]
                                  @clause-with-the-predecessor-collapsed |
                                    qtripleRowGrounded(peano.succ(n)) iff
                                      (qtripleRowGrounded(n) or n = NAT_ZERO)
                                    [by rewrite prev-of-succ-n-is-n clause-at-the-successor]
                                  @the-inductive-hypothesis-here |
                                    n != NAT_ZERO -> qtripleRowGrounded(n)
                                    [using specialize inductive-hypothesis(p, q, r, i, j)]
                                  @conclusion-grounded-at-succ-n |
                                    qtripleRowGrounded(peano.succ(n))
                                    [using tautology clause-with-the-predecessor-collapsed
                                      the-inductive-hypothesis-here]
                                }
                              @nonzero-implies-grounded |
                                peano.succ(n) != NAT_ZERO -> qtripleRowGrounded(peano.succ(n))
                                [by discharge given-succ-n-nonzero]
                            }
                          @discharge-j |
                            forall j: Nat; peano.succ(n) != NAT_ZERO -> qtripleRowGrounded(peano.succ(n))
                            [by generalize generalize-j]
                        }
                      @discharge-i |
                        forall i, j: Nat; peano.succ(n) != NAT_ZERO -> qtripleRowGrounded(peano.succ(n))
                        [by generalize generalize-i]
                    }
                  @discharge-r |
                    forall r: QPoly; forall i, j: Nat; peano.succ(n) != NAT_ZERO -> qtripleRowGrounded(peano.succ(n))
                    [by generalize generalize-r]
                }
              @discharge-q |
                forall q, r: QPoly; forall i, j: Nat; peano.succ(n) != NAT_ZERO -> qtripleRowGrounded(peano.succ(n))
                [by generalize generalize-q]
            }
          @conclusion-for-all-arguments |
            forall p, q, r: QPoly; forall i, j: Nat; peano.succ(n) != NAT_ZERO -> qtripleRowGrounded(peano.succ(n))
            [by generalize generalize-p]
        }
      @the-hypothesis-implies-the-step |
        (forall p2, q2, r2: QPoly; forall i2, j2: Nat; n != NAT_ZERO -> qtripleRowGrounded(n))
          -> (forall p, q, r: QPoly; forall i, j: Nat; peano.succ(n) != NAT_ZERO -> qtripleRowGrounded(peano.succ(n)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall n: Nat;
      (forall p2, q2, r2: QPoly; forall i2, j2: Nat; n != NAT_ZERO -> qtripleRowGrounded(n))
      -> (forall p, q, r: QPoly; forall i, j: Nat; peano.succ(n) != NAT_ZERO -> qtripleRowGrounded(peano.succ(n)))
    [by generalize generalize-n]
qed

// Strategy: `peano.induction` on the row length. The base is VACUOUS — at n = NAT_ZERO the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so every bit of content is in the step above.
theorem qtripleRowIsGrounded: forall p, q, r: QPoly; forall i, j, n: Nat;
  n != NAT_ZERO -> qtripleRowGrounded(n)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix p: QPoly {
      @generalize-q-at-zero |
        fix q: QPoly {
          @generalize-r-at-zero |
            fix r: QPoly {
              @generalize-i-at-zero |
                fix i: Nat {
                  @generalize-j-at-zero |
                    fix j: Nat {
                      @conclusion-vacuously-grounded |
                        NAT_ZERO != NAT_ZERO -> qtripleRowGrounded(NAT_ZERO)
                        [using tautology zero-is-itself]
                    }
                  @discharge-j-at-zero |
                    forall j: Nat; NAT_ZERO != NAT_ZERO -> qtripleRowGrounded(NAT_ZERO)
                    [by generalize generalize-j-at-zero]
                }
              @discharge-i-at-zero |
                forall i, j: Nat; NAT_ZERO != NAT_ZERO -> qtripleRowGrounded(NAT_ZERO)
                [by generalize generalize-i-at-zero]
            }
          @discharge-r-at-zero |
            forall r: QPoly; forall i, j: Nat; NAT_ZERO != NAT_ZERO -> qtripleRowGrounded(NAT_ZERO)
            [by generalize generalize-r-at-zero]
        }
      @discharge-q-at-zero |
        forall q, r: QPoly; forall i, j: Nat; NAT_ZERO != NAT_ZERO -> qtripleRowGrounded(NAT_ZERO)
        [by generalize generalize-q-at-zero]
    }
  @base-case |
    forall p, q, r: QPoly; forall i, j: Nat; NAT_ZERO != NAT_ZERO -> qtripleRowGrounded(NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-n |
    forall n: Nat;
      (forall p2, q2, r2: QPoly; forall i2, j2: Nat; n != NAT_ZERO -> qtripleRowGrounded(n))
      -> (forall p, q, r: QPoly; forall i, j: Nat; peano.succ(n) != NAT_ZERO -> qtripleRowGrounded(peano.succ(n)))
    [by cite qtripleRowReachesABaseFromAPredecessor]
  @grounded-for-every-row-length |
    forall n: Nat; forall p, q, r: QPoly; forall i, j: Nat; n != NAT_ZERO -> qtripleRowGrounded(n)
    [using instantiation peano.induction((fun n: Nat => (forall p, q, r: QPoly; forall i, j: Nat; n != NAT_ZERO -> qtripleRowGrounded(n)))) base-case induction-step-for-all-n]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-r |
            fix r: QPoly {
              @generalize-i |
                fix i: Nat {
                  @generalize-j |
                    fix j: Nat {
                      @generalize-n |
                        fix n: Nat {
                          @grounded-here |
                            n != NAT_ZERO -> qtripleRowGrounded(n)
                            [using specialize grounded-for-every-row-length(n, p, q, r, i, j)]
                        }
                      @discharge-n |
                        forall n: Nat; n != NAT_ZERO -> qtripleRowGrounded(n)
                        [by generalize generalize-n]
                    }
                  @discharge-j |
                    forall j, n: Nat; n != NAT_ZERO -> qtripleRowGrounded(n)
                    [by generalize generalize-j]
                }
              @discharge-i |
                forall i, j, n: Nat; n != NAT_ZERO -> qtripleRowGrounded(n)
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: QPoly; forall i, j, n: Nat; n != NAT_ZERO -> qtripleRowGrounded(n)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: QPoly; forall i, j, n: Nat; n != NAT_ZERO -> qtripleRowGrounded(n)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: QPoly; forall i, j, n: Nat; n != NAT_ZERO -> qtripleRowGrounded(n)
    [by generalize generalize-p]
qed

// -- the TERMINATION obligation for `qtripleDiag` -------------------------------------------
//
// `termination(peano):` names `qtripleDiagIsGrounded`, and the checker SYNTHESIZES the statement
// it must have — the recursive arm's own guard implying the generated predicate:
//
//     forall p, q, r: QPoly; forall i, m, c: Nat; c != NAT_ZERO -> qtripleDiagGrounded(c)
//
// `qtripleDiagGrounded` is GENERATED from the arm's one recursive call site, a disjunction of
// that call grounded with its argument hitting the terminating arm's pattern:
//
//     qtripleDiagGrounded(c) iff
//       (qtripleDiagGrounded(peano.prev(c)) or peano.prev(c) = NAT_ZERO)
//
// Five of the six binders ride along untouched; only `c` descends, so this is `evalUpTo`'s
// shape with more scaffolding and no more mathematics.

// Strategy: the step of an induction on the anti-diagonal length. At `peano.succ(c)` the predecessor is `c`, so
// either `c = NAT_ZERO` and the base disjunct fires outright, or the inductive hypothesis applies
// at `c`. `tautology` picks whichever holds.
theorem qtripleDiagReachesABaseFromAPredecessor: forall c: Nat;
  (forall p2, q2, r2: QPoly; forall i2, m2: Nat; c != NAT_ZERO -> qtripleDiagGrounded(c))
  -> (forall p, q, r: QPoly; forall i, m: Nat; peano.succ(c) != NAT_ZERO -> qtripleDiagGrounded(peano.succ(c)))
proof
  @the-generated-clause |
    forall c3: Nat; qtripleDiagGrounded(c3) iff
      (qtripleDiagGrounded(peano.prev(c3)) or peano.prev(c3) = NAT_ZERO)
    [by definition qtripleDiagGrounded]
  @prev-undoes-succ |
    forall c: Nat; peano.prev(peano.succ(c)) = c
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-c |
    fix c: Nat {
      @given-the-inductive-hypothesis |
        assume forall p2, q2, r2: QPoly; forall i2, m2: Nat; c != NAT_ZERO -> qtripleDiagGrounded(c) {
          @inductive-hypothesis |
            forall p2, q2, r2: QPoly; forall i2, m2: Nat; c != NAT_ZERO -> qtripleDiagGrounded(c)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so these precede every term that writes `peano.prev(peano.succ(c))`.
          @succ-c-is-nonzero |
            peano.succ(c) != NAT_ZERO
            [using specialize a-successor-is-never-zero(c)]
          @prev-of-succ-c-is-c |
            peano.prev(peano.succ(c)) = c
            [using specialize prev-undoes-succ(c)]
          @generalize-p |
            fix p: QPoly {
              @generalize-q |
                fix q: QPoly {
                  @generalize-r |
                    fix r: QPoly {
                      @generalize-i |
                        fix i: Nat {
                          @generalize-m |
                            fix m: Nat {
                              @given-succ-c-nonzero |
                                assume peano.succ(c) != NAT_ZERO {
                                  @clause-at-the-successor |
                                    qtripleDiagGrounded(peano.succ(c)) iff
                                      (qtripleDiagGrounded(peano.prev(peano.succ(c))) or peano.prev(peano.succ(c)) = NAT_ZERO)
                                    [using specialize the-generated-clause(peano.succ(c))]
                                  @clause-with-the-predecessor-collapsed |
                                    qtripleDiagGrounded(peano.succ(c)) iff
                                      (qtripleDiagGrounded(c) or c = NAT_ZERO)
                                    [by rewrite prev-of-succ-c-is-c clause-at-the-successor]
                                  @the-inductive-hypothesis-here |
                                    c != NAT_ZERO -> qtripleDiagGrounded(c)
                                    [using specialize inductive-hypothesis(p, q, r, i, m)]
                                  @conclusion-grounded-at-succ-c |
                                    qtripleDiagGrounded(peano.succ(c))
                                    [using tautology clause-with-the-predecessor-collapsed
                                      the-inductive-hypothesis-here]
                                }
                              @nonzero-implies-grounded |
                                peano.succ(c) != NAT_ZERO -> qtripleDiagGrounded(peano.succ(c))
                                [by discharge given-succ-c-nonzero]
                            }
                          @discharge-m |
                            forall m: Nat; peano.succ(c) != NAT_ZERO -> qtripleDiagGrounded(peano.succ(c))
                            [by generalize generalize-m]
                        }
                      @discharge-i |
                        forall i, m: Nat; peano.succ(c) != NAT_ZERO -> qtripleDiagGrounded(peano.succ(c))
                        [by generalize generalize-i]
                    }
                  @discharge-r |
                    forall r: QPoly; forall i, m: Nat; peano.succ(c) != NAT_ZERO -> qtripleDiagGrounded(peano.succ(c))
                    [by generalize generalize-r]
                }
              @discharge-q |
                forall q, r: QPoly; forall i, m: Nat; peano.succ(c) != NAT_ZERO -> qtripleDiagGrounded(peano.succ(c))
                [by generalize generalize-q]
            }
          @conclusion-for-all-arguments |
            forall p, q, r: QPoly; forall i, m: Nat; peano.succ(c) != NAT_ZERO -> qtripleDiagGrounded(peano.succ(c))
            [by generalize generalize-p]
        }
      @the-hypothesis-implies-the-step |
        (forall p2, q2, r2: QPoly; forall i2, m2: Nat; c != NAT_ZERO -> qtripleDiagGrounded(c))
          -> (forall p, q, r: QPoly; forall i, m: Nat; peano.succ(c) != NAT_ZERO -> qtripleDiagGrounded(peano.succ(c)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall c: Nat;
      (forall p2, q2, r2: QPoly; forall i2, m2: Nat; c != NAT_ZERO -> qtripleDiagGrounded(c))
      -> (forall p, q, r: QPoly; forall i, m: Nat; peano.succ(c) != NAT_ZERO -> qtripleDiagGrounded(peano.succ(c)))
    [by generalize generalize-c]
qed

