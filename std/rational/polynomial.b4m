// std/rational/polynomial.b4m — ℚ[x], WITH INTEGER COEFFICIENTS NAMEABLE.
//
// Judson's §17.3 Lemma 17.12 needs one polynomial seen over ℚ *and* over ℤ: it rewrites a
// rational-coefficient p(x) as (r/s) times an integer-coefficient polynomial. That needs a
// polynomial sort whose coefficients are ℚ, where `isInteger` can pick out the integer ones.
//
// HOW THIS RELATES TO std/field/polynomial.b4m. That file's F[x] is over an opaque field, so
// it cannot say "this coefficient is an integer" — ℚ's `isInteger` has no counterpart in an
// abstract F. ℚ[x] is therefore its OWN sort here, and F[x]'s corpus is transferred onto it
// by `RationalPolynomials` below. What makes that work is mapping the whole POLYNOMIAL layer
// (`Poly`, `coeff`, `ZEROP`, the operations), not just the coefficient field: a transfer
// re-checks the source PROOF, and those proofs mention `coeff`, whose result sort is F.
// Mapping only the field leaves `coeff` at the abstract sort and the transfer fails with
// `expected sort 'Q', got 'Field'`.
//
// Each axiom of F[x] that a transferred proof reaches must be restated here and discharged.
// They are restated as axioms rather than derived because they are ℚ[x]'s own primitives —
// the same posture std/field/polynomial.b4m takes toward its own coefficient equations.
//
// NOTE the transfers CHAIN: a theorem of F[x] that is itself proved by
// `model(FieldPolyModelsRingPoly)` re-checks that inner transfer when carried here, and so
// demands std/ring/polynomial.b4m's layer too. Theorems proved DIRECTLY in F[x] travel with
// only what is mapped below.
theory fieldpoly <<< "std/field/polynomial.b4m"
theory rational <<< "std/rational.b4m"
theory peano <<< "std/peano.b4m"
theory ring <<< "std/ring.b4m"
theory ring_poly <<< "std/ring/polynomial.b4m"
theory ring_mono <<< "std/ring/polynomial/monomial.b4m"
theory ring_leading <<< "std/ring/polynomial/leading.b4m"

sort Q = rational.Q
sort Nat = peano.Nat
const NAT_ZERO = peano.ZERO
const ZERO = rational.ZERO
pred isInteger = rational.isInteger

// -- ℚ[x] ---------------------------------------------------------------------------------
sort QPoly
oper qcoeff(p: QPoly, i: Nat) => Q
const QZEROP: QPoly
oper qaddP(p: QPoly, q: QPoly) => QPoly:
  qcoeff(qaddP(p, q), i) = rational.add(qcoeff(p, i), qcoeff(q, i))
oper qnegP(p: QPoly) => QPoly:
  qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
oper qmulP(p: QPoly, q: QPoly) => QPoly:
  qcoeff(qmulP(p, q), i) = qconvolution(p, q, NAT_ZERO, i)
oper qmonomial(a: Q, k: Nat) => QPoly:
  qcoeff(qmonomial(a, k), k) = a;
  (not (i = k)) -> qcoeff(qmonomial(a, k), i) = ZERO
// the degree layer, restated over ℚ exactly as F[x] states it — needed for Gauss's monic
// bookkeeping, which reads off leading coefficients.
pred qdegreeAtMost(p: QPoly, n: Nat)
oper qdegree(p: QPoly) => Nat
// the convolution, so multiplication has a COEFFICIENT LAW here. `qmulP` was declared and
// mapped into F[x] but its coefficient behaviour never was, so `qcoeff(qmulP(p, q), i)` was
// opaque — nothing could be proved about a product's coefficients. This is the FIFTH
// restatement of the same convolution recursion in std (R[x], F[x], ℤ_p[x], ℤ[x], here),
// which is the duplication a generic polynomial theory removes; see
// `drafts/algebra-layering/README.md`.
oper qconvolution(p: QPoly, q: QPoly, i: Nat, k: Nat) => Q:
  qconvolution(p, q, j, NAT_ZERO) = rational.mul(qcoeff(p, j), qcoeff(q, NAT_ZERO));
  qconvolution(p, q, j, peano.succ(m)) = rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(m))), qconvolution(p, q, peano.succ(j), m))

// the coefficient equations: ℚ[x]'s own primitives
axiom qPolyExtensionality: forall p, q: QPoly;
  (forall i: Nat; qcoeff(p, i) = qcoeff(q, i)) -> p = q
axiom qZeroPolyCoeff: forall i: Nat; qcoeff(QZEROP, i) = ZERO
axiom qDegreeAtMostMeaning: forall p: QPoly; forall n: Nat;
  qdegreeAtMost(p, n) iff
  (forall i: Nat; peano.less_than(n, i) -> qcoeff(p, i) = ZERO)
axiom qDegreeIsALeadingIndex: forall p: QPoly;
  (not (p = QZEROP)) -> (not (qcoeff(p, qdegree(p)) = ZERO))
axiom qDegreeBoundsTheCoefficients: forall p: QPoly;
  (not (p = QZEROP)) -> qdegreeAtMost(p, qdegree(p))

// The same partial sum grown at the BASE rather than the top. `ring_poly` needs it to prove
// `polyMulIsCommutative` — the reversed product's partial sum IS this segment — and a model
// must map every symbol the transferred proof mentions, so ℚ[x] declares it too.
oper qtailConvolution(p: QPoly, q: QPoly, i: Nat, k: Nat) => Q:
  qtailConvolution(p, q, NAT_ZERO, m) = rational.mul(qcoeff(p, NAT_ZERO), qcoeff(q, m));
  qtailConvolution(p, q, peano.succ(j), m) = rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, m)), qtailConvolution(p, q, j, peano.succ(m)))

// And the two-bound generalization `ring_poly` inducts on: the n+1 terms starting at index m,
// grown at the top. Same reason it is here — a transferred proof mentions it.
oper qsegment(p: QPoly, q: QPoly, j: Nat, c: Nat, n: Nat) => Q:
  qsegment(p, q, j, c, NAT_ZERO) = rational.mul(qcoeff(p, j), qcoeff(q, c));
  qsegment(p, q, peano.succ(j), c, peano.succ(n)) = rational.add(rational.mul(qcoeff(p, peano.succ(j)), qcoeff(q, c)), qsegment(p, q, j, peano.succ(c), n))

// the bottom-up capped run, mirror of `qsegment`
oper qrsegment(p: QPoly, q: QPoly, j: Nat, c: Nat, n: Nat) => Q:
  qrsegment(p, q, j, c, NAT_ZERO) = rational.mul(qcoeff(p, j), qcoeff(q, c));
  qrsegment(p, q, j, peano.succ(c), peano.succ(n)) = rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(c))), qrsegment(p, q, peano.succ(j), c, n))

// F[x]'s corpus, transferred. The coefficient field AND the polynomial layer both travel.
model RationalPolynomials {
  fieldpoly.F: Q
  fieldpoly.zeroF: ZERO
  fieldpoly.oneF: rational.ONE
  fieldpoly.addF: rational.add
  fieldpoly.mulF: rational.mul
  fieldpoly.negF: rational.neg
  fieldpoly.recipF: rational.recip
  fieldpoly.Poly: QPoly
  fieldpoly.coeff: qcoeff
  fieldpoly.ZEROP: QZEROP
  fieldpoly.addP: qaddP
  fieldpoly.negP: qnegP
  fieldpoly.mulP: qmulP
  fieldpoly.monomial: qmonomial
  fieldpoly.degreeAtMost: qdegreeAtMost
  fieldpoly.degree: qdegree
  fieldpoly.convolution: qconvolution
  fieldpoly.power: qpower
  fieldpoly.evalUpTo: qevalUpTo
  fieldpoly.isZeroOf: qIsZeroOf
  fieldpoly.polyExtensionality <- qPolyExtensionality
  fieldpoly.zeroPolyCoeff <- qZeroPolyCoeff
  fieldpoly.addP <- qaddP
  fieldpoly.negP <- qnegP
  fieldpoly.monomial <- qmonomial
  fieldpoly.degreeAtMostMeaning <- qDegreeAtMostMeaning
  fieldpoly.degreeIsALeadingIndex <- qDegreeIsALeadingIndex
  fieldpoly.degreeBoundsTheCoefficients <- qDegreeBoundsTheCoefficients
  fieldpoly.convolution <- qconvolution
  fieldpoly.mulP <- qmulP
  fieldpoly.power <- qpower
  fieldpoly.evalUpTo <- qevalUpTo
  fieldpoly.isZeroOfMeaning <- qIsZeroOfMeaning
  fieldpoly.mulIsAssociativeF <- rational.mulIsAssociative
  // the ring layer, because F[x] reaches `ring.mulZeroLeft` — a THEOREM, so a transfer
  // re-checks its proof and needs `ring`'s own symbols mapped.
  ring.Ring: Q
  ring.ZERO: ZERO
  ring.ONE: rational.ONE
  ring.add: rational.add
  ring.mul: rational.mul
  ring.neg: rational.neg
  ring.addIsAssociative <- rational.addIsAssociative
  ring.addZeroLeft <- rational.addZeroLeft
  ring.addNegLeft <- rational.addNegLeft
  ring.addIsCommutative <- rational.addIsCommutative
  ring.mulIsAssociative <- rational.mulIsAssociative
  ring.mulAddDistribLeft <- rational.mulAddDistribLeft
  ring.mulAddDistribRight <- rational.mulAddDistribRight
  // The F-LEVEL ALGEBRA FACTS. Re-transferring a theorem whose own proof is a transfer means
  // the outer model must discharge every axiom the INNER proof reaches, not only those its
  // statement mentions — F[x] discharges these onto `ring_poly`, so ℚ[x] must discharge them
  // onto ℚ in turn. Omitting them does not report an undischarged axiom; it surfaces much
  // later as a sort mismatch inside the source theory's own proof.
  fieldpoly.addIsAssociativeF <- rational.addIsAssociative
  fieldpoly.addIsCommutativeF <- rational.addIsCommutative
  fieldpoly.addZeroLeftF <- rational.addZeroLeft
  fieldpoly.addNegLeftF <- rational.addNegLeft
  fieldpoly.mulIsCommutativeF <- rational.mulIsCommutative
  fieldpoly.mulOneLeftF <- rational.mulOneLeft
  fieldpoly.mulAddDistribLeftF <- rational.mulAddDistribLeft
  fieldpoly.mulAddDistribRightF <- rational.mulAddDistribRight
}

// -- integer coefficients -----------------------------------------------------------------

// `hasIntegerCoefficientsUpTo(p, n)` — every coefficient below n is an integer. Bounded
// because Lemma 17.12 works with a polynomial of some stated degree; `isInteger` is ℚ's own
// subring predicate, so no embedding function is involved.
pred hasIntegerCoefficientsUpTo(p: QPoly, n: Nat)
axiom integerCoefficientsMeaning: forall p: QPoly; forall n: Nat;
  hasIntegerCoefficientsUpTo(p, n) iff
  (forall i: Nat; peano.less_than(i, n) -> isInteger(qcoeff(p, i)))

// What this file proves (verified manifest):
intheory theZeroPolynomialHasIntegerCoefficients
intheory qSubPolyCoeff
intheory everyCoefficientIsARatioOfIntegers
intheory anIntegerDividesItself
intheory oneDividesEveryInteger
intheory aScaledIntegerPolynomialIsRational
intheory aMonicPolynomialIsNonzero
intheory theNegationOfANonzeroPolynomialIsNonzero
intheory theNegationsCoefficientFlips
intheory aNonzeroHasNonzeroNegation
intheory theNegationIsBoundedWhereverTheOriginalIs
intheory negationPreservesTheDegree
intheory negatingALeadingMinusOneMakesItMonic
intheory theMonomialShift
intheory scalingByAConstantScalesTheCoefficients
intheory qTheProductsLeadingCoefficient
intheory theNegationIsTheMinusOneScaling
intheory qMulIsCommutative
intheory theNegationPullsOutOfTheProduct
intheory theTwoNegationsCancelInAProduct
intheory aProductsPowerSplits
intheory aPowerCancelsTheReciprocalsPower
intheory clearingTheDenominatorGivesTheClearedSum
intheory everyPowerOfAnIntegerIsAnInteger
intheory theClearedSumSplitsOffTheConstantTerm
intheory theClearedSumSplitsOffTheLeadingTerm
intheory qMulIsAssociative
intheory theConstantMonomialProductAgreesCoefficientwise
intheory theProductOfConstantMonomials
intheory aNonzeroScalingReflectsTheVanishing
intheory aNonzeroScalingReflectsTheDegreeBound
intheory qAddPolyCoeff
intheory qNegPolyCoeff
intheory qMulPolyCoeff
intheory qMonomialCoeffAtItsIndex
intheory qMonomialCoeffElsewhere
intheory qConvolutionZero
intheory qConvolutionSucc
intheory qTailConvolutionZero
intheory qTailConvolutionSucc
intheory qSegmentZero
intheory qSegmentSucc
intheory qRsegmentZero
intheory qRsegmentSucc
intheory qPowerZero
intheory qPowerSucc
intheory qEvalZero
intheory qEvalSucc
intheory qClearedSumZero
intheory qClearedSumSucc
intheory qTheGapToAtZero
intheory qTheGapToSteps
intheory qTheCofactorIndexAtZero
intheory qTheCofactorIndexSteps
intheory qCappedRunZero
intheory qCappedRunSucc
intheory qTripleTermMeaning
intheory qTripleRowZero
intheory qTripleRowSucc
intheory qTripleDiagZero
intheory qTripleDiagSucc
intheory qTripleTriZero
intheory qTripleTriSucc
intheory qTripleRowsZero
intheory qTripleRowsSucc

// The zero polynomial has integer coefficients: every one of them is ℚ's NAT_ZERO, which is an
// integer. The first fact a consumer needs, and a check that the layer is wired up.
theorem theZeroPolynomialHasIntegerCoefficients: forall n: Nat;
  hasIntegerCoefficientsUpTo(QZEROP, n)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-i |
        fix i: Nat {
          @the-coefficient-is-zero |
            qcoeff(QZEROP, i) = ZERO
            [using specialize qZeroPolyCoeff(i)]
          @zero-is-an-integer |
            isInteger(ZERO)
            [by cite rational.zeroIsAnInteger]
          @the-coefficient-is-an-integer |
            isInteger(qcoeff(QZEROP, i))
            [by rewrite the-coefficient-is-zero zero-is-an-integer]
          @conclusion-below-n-is-an-integer |
            peano.less_than(i, n) -> isInteger(qcoeff(QZEROP, i))
            [using tautology the-coefficient-is-an-integer]
        }
      @every-coefficient-is-an-integer |
        forall i: Nat;
          peano.less_than(i, n) -> isInteger(qcoeff(QZEROP, i))
        [by generalize generalize-i]
      @the-definition |
        hasIntegerCoefficientsUpTo(QZEROP, n) iff
          (forall i: Nat; peano.less_than(i, n) -> isInteger(qcoeff(QZEROP, i)))
        [using specialize integerCoefficientsMeaning(QZEROP, n)]
      @conclusion-the-zero-polynomial-qualifies |
        hasIntegerCoefficientsUpTo(QZEROP, n)
        [using tautology the-definition every-coefficient-is-an-integer]
    }
  @conclusion |
    forall n: Nat; hasIntegerCoefficientsUpTo(QZEROP, n)
    [by generalize generalize-n]
qed

// -- the transfer in action ----------------------------------------------------------------

// A difference's coefficients, carried over from F[x]'s `subPolyCoeff`. This is the file's
// reason to exist in miniature: a theorem proved once over an abstract coefficient field,
// reused at ℚ without restating its proof. It also exercises the three mapped coefficient
// axioms, which otherwise only the model block touches.
theorem qSubPolyCoeff: forall p, q: QPoly; forall i: Nat;
  qcoeff(qaddP(p, qnegP(q)), i) =
  rational.add(qcoeff(p, i), rational.neg(qcoeff(q, i)))
proof
  @conclusion |
    forall p, q: QPoly; forall i: Nat;
      qcoeff(qaddP(p, qnegP(q)), i) =
      rational.add(qcoeff(p, i), rational.neg(qcoeff(q, i)))
    [using model(RationalPolynomials) fieldpoly.subPolyCoeff]
qed

// NOT transferable without more mapping: `polyAddIsCommutative`. F[x] proves it by its own
// `model(FieldPolyModelsRingPoly)`, so carrying it here re-checks that INNER transfer and
// demands std/ring/polynomial.b4m's layer as well — `expected sort 'Field', got 'Q'`.
// Chained transfers need every link mapped, and this file maps one link. A consumer needing
// the ring laws at ℚ[x] should map `ring_poly`'s layer too, or restate the law directly.

// -- integer representations of coefficients ------------------------------------------------

// Every coefficient of a ℚ[x] polynomial is a ratio of integers — the first line of Judson's
// Lemma 17.12, "suppose p(x) = b_0/c_0 + … + b_n/c_n x^n, where the b_i's and c_i's are
// integers". It is ℚ's fraction axiom read at a coefficient.
theorem everyCoefficientIsARatioOfIntegers: forall p: QPoly; forall i: Nat;
  exists b, c: Q;
  isInteger(b) and isInteger(c) and rational.nonzero(c) and
  qcoeff(p, i) = rational.mul(b, rational.recip(c))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-i |
        fix i: Nat {
          @conclusion-the-coefficient-is-a-ratio |
            exists b, c: Q;
              isInteger(b) and isInteger(c) and rational.nonzero(c) and
              qcoeff(p, i) = rational.mul(b, rational.recip(c))
            [using specialize rational.everyRationalIsAQuotientOfIntegers(qcoeff(p, i))]
        }
      @discharge-i |
        forall i9: Nat;
          exists b, c: Q;
          isInteger(b) and isInteger(c) and rational.nonzero(c) and
          qcoeff(p, i9) = rational.mul(b, rational.recip(c))
        [by generalize generalize-i]
    }
  @conclusion |
    forall p: QPoly; forall i: Nat;
      exists b, c: Q;
      isInteger(b) and isInteger(c) and rational.nonzero(c) and
      qcoeff(p, i) = rational.mul(b, rational.recip(c))
    [by generalize generalize-p]
qed

// -- divisibility and coprimality ON THE CUT ------------------------------------------------
//
// Judson's §17.3 Lemma 17.12 speaks of integers dividing each other and of a family of
// coefficients being relatively prime. Both are expressible DIRECTLY over ℚ's integer cut:
// the cut inherits ℚ's own multiplication, so "d divides n" is an existential over the cut
// and needs none of std/integer/divides.b4m transferred across. (rational.b4m's header makes
// the same point — "there is NO new arithmetic here".)

// `d` divides `n` within the integers of ℚ: some integer quotient.
define dividesOnTheCut(d, n) =
  exists k: Q; isInteger(k) and n = rational.mul(d, k)

// A family of coefficients is RELATIVELY PRIME when every integer dividing all of them
// divides ONE — i.e. is a unit. Stated as a QUANTIFICATION over common divisors rather than
// as a constructed gcd, which is both faithful to "the a_i's are relatively prime" and free
// of any fold: no sequence sort, no gcd function, nothing totalized.
define coefficientsAreRelativelyPrimeUpTo(p, n) =
  forall e: Q;
  isInteger(e) ->
  (forall i: Nat; peano.less_than(i, n) -> dividesOnTheCut(e, qcoeff(p, i))) ->
  dividesOnTheCut(e, rational.ONE)

// Every integer divides itself: the witness is ONE.
theorem anIntegerDividesItself: forall n: Q;
  isInteger(n) -> dividesOnTheCut(n, n)
proof
  @generalize-n |
    fix n: Q {
      @given-n-is-an-integer |
        assume isInteger(n) {
          @one-is-an-integer |
            isInteger(rational.ONE)
            [by cite rational.oneIsAnInteger]
          @n-times-one-is-n |
            rational.mul(n, rational.ONE) = n
            [using specialize rational.mulOneRight(n)]
          @n-is-the-product |
            n = rational.mul(n, rational.ONE)
            [by symmetry n-times-one-is-n]
          @the-witness-works |
            isInteger(rational.ONE) and n = rational.mul(n, rational.ONE)
            [by both one-is-an-integer n-is-the-product]
          @conclusion-n-divides-itself |
            exists k: Q; isInteger(k) and n = rational.mul(n, k)
            [by witness(rational.ONE) the-witness-works]
        }
      @integer-implies-self-divides |
        isInteger(n) -> dividesOnTheCut(n, n)
        [by discharge given-n-is-an-integer]
    }
  @conclusion |
    forall n: Q; isInteger(n) -> dividesOnTheCut(n, n)
    [by generalize generalize-n]
qed

// A unit divides everything, which is the reading `coefficientsAreRelativelyPrimeUpTo` needs
// on its right-hand side: ONE divides any integer.
theorem oneDividesEveryInteger: forall n: Q;
  isInteger(n) -> dividesOnTheCut(rational.ONE, n)
proof
  @generalize-n |
    fix n: Q {
      @given-n-is-an-integer |
        assume isInteger(n) {
          @n-is-an-integer |
            isInteger(n)
            [by hypothesis given-n-is-an-integer]
          @one-times-n-is-n |
            rational.mul(rational.ONE, n) = n
            [using specialize rational.mulOneLeft(n)]
          @n-is-the-product |
            n = rational.mul(rational.ONE, n)
            [by symmetry one-times-n-is-n]
          @the-witness-works |
            isInteger(n) and n = rational.mul(rational.ONE, n)
            [by both n-is-an-integer n-is-the-product]
          @conclusion-one-divides-n |
            exists k: Q; isInteger(k) and n = rational.mul(rational.ONE, k)
            [by witness(n) the-witness-works]
        }
      @integer-implies-one-divides |
        isInteger(n) -> dividesOnTheCut(rational.ONE, n)
        [by discharge given-n-is-an-integer]
    }
  @conclusion |
    forall n: Q; isInteger(n) -> dividesOnTheCut(rational.ONE, n)
    [by generalize generalize-n]
qed

// -- Lemma 17.12 -----------------------------------------------------------------------------
//
// "Let p(x) ∈ ℚ[x]. Then p(x) = (r/s)(a_0 + a_1 x + ⋯ + a_n x^n), where r, s, a_0, …, a_n are
// integers, the a_i's are relatively prime, and r and s are relatively prime."
//
// The scaling by r/s is multiplication by the constant monomial carrying r·s⁻¹, the same way
// std/field/poly-units.b4m treats constants. `s` must be nonzero for the reciprocal to mean
// anything, which his `r/s` presupposes.
//
// EXISTENCE IS NOT PROVED HERE. His construction clears denominators by the product
// c_0 ⋯ c_n over the coefficient index range, divides through by the gcd of the resulting
// numerators, and reduces the leading fraction to lowest terms.
//
// An earlier version of this note said the PRODUCT over the index range "has no relational
// substitute" and that std's folds could not express it. That was WRONG, and measured so:
// `std/integer/product.b4m` has `productUpTo` with a real corpus (`everyEntryDividesProduct`,
// `memberDividesProduct`, `primeFactorExists`), and `std/sequence.b4m` instantiates at ℚ
// cleanly — `sequence.Value: Q` is UNGUARDED, so a ℚ-valued fold and `foldOneCombinesIdentity`
// transfer with no cut composition (probed 2026-10-30).
//
// What is actually missing is narrower: `product.b4m`'s ℤ-SPECIFIC theorems — the divisibility
// ones Judson's denominator-clearing needs — are stated over ℤ's own sorts, so reaching them
// at ℚ needs them re-proved or model-mapped onto the `isInteger` cut, and their proofs are
// nonneg-ℤ inductions. That is a real job but a bounded one, and it is the ONLY thing standing
// between here and Lemma 17.12's existence half. The gcd half already has its relational
// form in `std/integer/family-gcd.b4m`.
//
// So the lemma is STATED here, honestly, with its existence left open. What is proved is
// everything the statement rests on: the decomposition's parts are all expressible, and
// `aScaledIntegerPolynomialIsRational` below confirms the shape composes.
// `r` and `s` are relatively prime — Judson's "and $r$ and $s$ are relatively prime", read
// the same way `coefficientsAreRelativelyPrimeUpTo` reads a family: every integer dividing
// BOTH divides ONE.
//
// CORRECTION (2026-10-31): this conjunct previously read
// `coefficientsAreRelativelyPrimeUpTo(qaddP(qmonomial(r, 0), qmonomial(s, 0)), n)`, which is
// WRONG. Both monomials sit at index ZERO, so that polynomial's only nonzero coefficient is
// `r + s` — the condition was about the single number `r + s`, not about `r` and `s` being
// coprime. It type-checked, and would have gone on doing so indefinitely.
define arePairwiseRelativelyPrime(a, b) =
  forall e: Q;
  isInteger(e) ->
  dividesOnTheCut(e, a) -> dividesOnTheCut(e, b) ->
  dividesOnTheCut(e, rational.ONE)

pred isTheIntegerDecomposition(p: QPoly, q: QPoly, r: Q, s: Q, n: Nat)
axiom integerDecompositionMeaning: forall p, q: QPoly; forall r, s: Q; forall n: Nat;
  isTheIntegerDecomposition(p, q, r, s, n) iff
  (isInteger(r) and isInteger(s) and rational.nonzero(s) and
  hasIntegerCoefficientsUpTo(q, n) and
  coefficientsAreRelativelyPrimeUpTo(q, n) and
  arePairwiseRelativelyPrime(r, s) and
  p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q))

// The decomposition's shape composes: given one, p really is the scaled polynomial, and that
// scaling is a ℚ[x] element like any other. A sanity theorem — it is what makes the
// predicate above a statement about p rather than a bag of unrelated conjuncts.
// `nonzero(s)` leads: the conclusion writes the guarded `recip(s)` OUTSIDE the assume, so its
// obligation must be met from the antecedent — the checker reads guards syntactically, and
// `isTheIntegerDecomposition(...)` does not supply one. Callers hold the nonzero as a
// hypothesis of their own and pass it here.
theorem aScaledIntegerPolynomialIsRational: forall p, q: QPoly; forall r, s: Q; forall n: Nat;
  rational.nonzero(s) ->
  isTheIntegerDecomposition(p, q, r, s, n) ->
  p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-r |
            fix r: Q {
              @generalize-s |
                fix s: Q {
                  @generalize-n |
                    fix n: Nat {
                      @given-s-is-nonzero |
                        assume rational.nonzero(s) {
                          @given-the-decomposition |
                            assume isTheIntegerDecomposition(p, q, r, s, n) {
                              @the-decomposition |
                                isTheIntegerDecomposition(p, q, r, s, n)
                                [by hypothesis given-the-decomposition]
                              @the-definition |
                                isTheIntegerDecomposition(p, q, r, s, n) iff
                                  (isInteger(r) and isInteger(s) and rational.nonzero(s) and
                                  hasIntegerCoefficientsUpTo(q, n) and
                                  coefficientsAreRelativelyPrimeUpTo(q, n) and
                                  arePairwiseRelativelyPrime(r, s) and
                                  p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q))
                                [using specialize integerDecompositionMeaning(p, q, r, s, n)]
                              // explicit elimination rather than `tautology`: the tactic's
                              // GENERATED intermediate terms did not discharge a guard a step
                              // in scope has proved.
                              @the-definition-forward |
                                isTheIntegerDecomposition(p, q, r, s, n) ->
                                  (isInteger(r) and isInteger(s) and rational.nonzero(s) and
                                  hasIntegerCoefficientsUpTo(q, n) and
                                  coefficientsAreRelativelyPrimeUpTo(q, n) and
                                  arePairwiseRelativelyPrime(r, s) and
                                  p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q))
                                [by equiv_forward the-definition]
                              @the-conjunction |
                                isInteger(r) and isInteger(s) and rational.nonzero(s) and
                                  hasIntegerCoefficientsUpTo(q, n) and
                                  coefficientsAreRelativelyPrimeUpTo(q, n) and
                                  arePairwiseRelativelyPrime(r, s) and
                                  p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
                                [by modus_ponens the-definition-forward the-decomposition]
                              @conclusion-p-is-the-scaling |
                                p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
                                [by and_rhs the-conjunction]
                            }
                          @the-decomposition-implies |
                            isTheIntegerDecomposition(p, q, r, s, n) ->
                              p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
                            [by discharge given-the-decomposition]
                        }
                      @s-nonzero-implies |
                        rational.nonzero(s) ->
                          isTheIntegerDecomposition(p, q, r, s, n) ->
                          p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
                        [by discharge given-s-is-nonzero]
                    }
                  @discharge-n |
                    forall n9: Nat;
                      rational.nonzero(s) ->
                      isTheIntegerDecomposition(p, q, r, s, n9) ->
                      p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
                    [by generalize generalize-n]
                }
              @discharge-s |
                forall s9: Q; forall n9: Nat;
                  rational.nonzero(s9) ->
                  isTheIntegerDecomposition(p, q, r, s9, n9) ->
                  p = qmulP(qmonomial(rational.mul(r, rational.recip(s9)), NAT_ZERO), q)
                [by generalize generalize-s]
            }
          @discharge-r |
            forall r9, s9: Q; forall n9: Nat;
              rational.nonzero(s9) ->
              isTheIntegerDecomposition(p, q, r9, s9, n9) ->
              p = qmulP(qmonomial(rational.mul(r9, rational.recip(s9)), NAT_ZERO), q)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q9: QPoly; forall r9, s9: Q; forall n9: Nat;
          rational.nonzero(s9) ->
          isTheIntegerDecomposition(p, q9, r9, s9, n9) ->
          p = qmulP(qmonomial(rational.mul(r9, rational.recip(s9)), NAT_ZERO), q9)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; forall r, s: Q; forall n: Nat;
      rational.nonzero(s) ->
      isTheIntegerDecomposition(p, q, r, s, n) ->
      p = qmulP(qmonomial(rational.mul(r, rational.recip(s)), NAT_ZERO), q)
    [by generalize generalize-p]
qed

// -- MONIC POLYNOMIALS OVER ℚ -------------------------------------------------------------
// Gauss's Lemma concludes with monic integer factors, so the monic predicate has to exist at
// ℚ[x]. Same definition as `std/field/monic.b4m` gives it over an abstract field: the leading
// coefficient is one.
pred qIsMonic(p: QPoly)
axiom qMonicMeansTheLeadingCoefficientIsOne: forall p: QPoly;
  qIsMonic(p) iff qcoeff(p, qdegree(p)) = rational.ONE

// A monic polynomial is nonzero: the zero polynomial's coefficients are all NAT_ZERO, and ONE is
// not NAT_ZERO. The first thing any consumer needs, and it exercises the degree layer.
theorem aMonicPolynomialIsNonzero: forall p: QPoly;
  qIsMonic(p) -> (not (p = QZEROP))
proof
  @generalize-p |
    fix p: QPoly {
      @given-p-is-monic |
        assume qIsMonic(p) {
          @p-is-monic |
            qIsMonic(p)
            [by hypothesis given-p-is-monic]
          @monic-meaning |
            qIsMonic(p) iff qcoeff(p, qdegree(p)) = rational.ONE
            [using specialize qMonicMeansTheLeadingCoefficientIsOne(p)]
          @the-leading-coefficient-is-one |
            qcoeff(p, qdegree(p)) = rational.ONE
            [using tautology monic-meaning p-is-monic]
          @given-p-is-zero |
            assume p = QZEROP {
              @p-is-zero |
                p = QZEROP
                [by hypothesis given-p-is-zero]
              @the-zero-coefficient |
                qcoeff(QZEROP, qdegree(p)) = ZERO
                [using specialize qZeroPolyCoeff(qdegree(p))]
              @the-leading-coefficient-at-zero |
                qcoeff(QZEROP, qdegree(p)) = rational.ONE
                [by rewrite p-is-zero the-leading-coefficient-is-one]
              @one-is-zero |
                rational.ONE = ZERO
                [by rewrite the-leading-coefficient-at-zero the-zero-coefficient]
              @one-is-not-zero |
                not (rational.ONE = ZERO)
                [by cite rational.oneNotZero]
            }
          @conclusion-monic-is-nonzero |
            not (p = QZEROP)
            [by contradiction given-p-is-zero one-is-zero one-is-not-zero]
        }
      @monic-implies-nonzero |
        qIsMonic(p) -> (not (p = QZEROP))
        [by discharge given-p-is-monic]
    }
  @conclusion |
    forall p: QPoly; qIsMonic(p) -> (not (p = QZEROP))
    [by generalize generalize-p]
qed

// -- NEGATION PRESERVES THE DEGREE --------------------------------------------------------
// Judson's monic normalization takes a(x) = -α₁(x) when the leading coefficient is -1. For
// that to be the right degree-preserving move, negation must not change the degree — true
// because negation is coefficientwise and only NAT_ZERO negates to NAT_ZERO.

// A nonzero polynomial has a nonzero negation: at the leading index the coefficient is
// nonzero, and negating a nonzero rational keeps it nonzero.
theorem theNegationOfANonzeroPolynomialIsNonzero: forall p: QPoly;
  (not (p = QZEROP)) -> (not (qnegP(p) = QZEROP))
proof
  @generalize-p |
    fix p: QPoly {
      @given-p-nonzero |
        assume not (p = QZEROP) {
          @p-nonzero |
            not (p = QZEROP)
            [by hypothesis given-p-nonzero]
          @the-leading-coefficient-survives |
            not (qcoeff(p, qdegree(p)) = ZERO)
            [using specialize qDegreeIsALeadingIndex(p) p-nonzero]
          @the-negated-coefficient |
            qcoeff(qnegP(p), qdegree(p)) = rational.neg(qcoeff(p, qdegree(p)))
            [using specialize qNegPolyCoeff(p, qdegree(p))]
          // neg is injective on NAT_ZERO: neg(x) = 0 forces x = 0
          @given-the-negation-is-zero |
            assume qnegP(p) = QZEROP {
              @the-negation-is-zero |
                qnegP(p) = QZEROP
                [by hypothesis given-the-negation-is-zero]
              @the-zero-coefficient |
                qcoeff(QZEROP, qdegree(p)) = ZERO
                [using specialize qZeroPolyCoeff(qdegree(p))]
              @the-negated-coefficient-at-zero |
                qcoeff(QZEROP, qdegree(p)) =
                  rational.neg(qcoeff(p, qdegree(p)))
                [by rewrite the-negation-is-zero the-negated-coefficient]
              @the-negation-of-the-leading-coefficient-is-zero |
                ZERO = rational.neg(qcoeff(p, qdegree(p)))
                [by rewrite the-zero-coefficient the-negated-coefficient-at-zero]
              // negate both sides: neg(0) = 0 and neg(neg(x)) = x
              @double-negation |
                rational.neg(rational.neg(qcoeff(p, qdegree(p)))) =
                  qcoeff(p, qdegree(p))
                [using specialize rational.negNeg(qcoeff(p, qdegree(p)))]
              // rewrite NAT_ZERO = neg(c) into the double-negation identity's inner term
              @the-leading-coefficient-is-neg-zero |
                rational.neg(ZERO) = qcoeff(p, qdegree(p))
                [by rewrite the-negation-of-the-leading-coefficient-is-zero double-negation]
              @neg-zero |
                rational.neg(ZERO) = ZERO
                [by cite rational.negZero]
              @the-leading-coefficient-is-zero-flipped |
                qcoeff(p, qdegree(p)) = ZERO
                [by rewrite the-leading-coefficient-is-neg-zero neg-zero]
            }
          @conclusion-the-negation-is-nonzero |
            not (qnegP(p) = QZEROP)
            [by contradiction given-the-negation-is-zero the-leading-coefficient-is-zero-flipped the-leading-coefficient-survives]
        }
      @nonzero-implies-negation-nonzero |
        (not (p = QZEROP)) -> (not (qnegP(p) = QZEROP))
        [by discharge given-p-nonzero]
    }
  @conclusion |
    forall p: QPoly;
      (not (p = QZEROP)) -> (not (qnegP(p) = QZEROP))
    [by generalize generalize-p]
qed

// -- THE NEGATION'S LEADING COEFFICIENT ---------------------------------------------------
// Judson's second case: a_m = -1, so a(x) = -α₁(x) is the monic factor. The degrees agree
// (negation is coefficientwise, so `qdegreeAtMost` transfers and the leading index is the
// same), and the leading coefficient flips sign — turning -1 into 1.

// At a shared degree bound, the negation's coefficient at that index is the negation of the
// original's. Stated at an arbitrary index, which is all the monic step needs.
theorem theNegationsCoefficientFlips: forall p: QPoly; forall i: peano.Nat;
  qcoeff(p, i) = rational.neg(rational.ONE) ->
  qcoeff(qnegP(p), i) = rational.ONE
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-i |
        fix i: peano.Nat {
          @given-the-coefficient-is-minus-one |
            assume qcoeff(p, i) = rational.neg(rational.ONE) {
              @the-coefficient-is-minus-one |
                qcoeff(p, i) = rational.neg(rational.ONE)
                [by hypothesis given-the-coefficient-is-minus-one]
              @the-negated-coefficient |
                qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
                [using specialize qNegPolyCoeff(p, i)]
              @the-negated-coefficient-at-minus-one |
                qcoeff(qnegP(p), i) =
                  rational.neg(rational.neg(rational.ONE))
                [by rewrite the-coefficient-is-minus-one the-negated-coefficient]
              @double-negation |
                rational.neg(rational.neg(rational.ONE)) = rational.ONE
                [using specialize rational.negNeg(rational.ONE)]
              @conclusion-the-coefficient-is-one |
                qcoeff(qnegP(p), i) = rational.ONE
                [by rewrite double-negation the-negated-coefficient-at-minus-one]
            }
          @minus-one-implies-one |
            qcoeff(p, i) = rational.neg(rational.ONE) ->
              qcoeff(qnegP(p), i) = rational.ONE
            [by discharge given-the-coefficient-is-minus-one]
        }
      @discharge-i |
        forall i9: peano.Nat;
          qcoeff(p, i9) = rational.neg(rational.ONE) ->
          qcoeff(qnegP(p), i9) = rational.ONE
        [by generalize generalize-i]
    }
  @conclusion |
    forall p: QPoly; forall i: peano.Nat;
      qcoeff(p, i) = rational.neg(rational.ONE) ->
      qcoeff(qnegP(p), i) = rational.ONE
    [by generalize generalize-p]
qed

// A nonzero rational has a nonzero negation: neg(x) = 0 would give x = neg(neg(x)) = neg(0) = 0.
theorem aNonzeroHasNonzeroNegation: forall x: Q;
  (not (x = ZERO)) -> (not (rational.neg(x) = ZERO))
proof
  @generalize-x |
    fix x: Q {
      @given-x-nonzero |
        assume not (x = ZERO) {
          @x-nonzero |
            not (x = ZERO)
            [by hypothesis given-x-nonzero]
          @given-the-negation-is-zero |
            assume rational.neg(x) = ZERO {
              @the-negation-is-zero |
                rational.neg(x) = ZERO
                [by hypothesis given-the-negation-is-zero]
              @double-negation |
                rational.neg(rational.neg(x)) = x
                [using specialize rational.negNeg(x)]
              @neg-of-zero |
                rational.neg(ZERO) = ZERO
                [by cite rational.negZero]
              @x-is-neg-zero |
                rational.neg(ZERO) = x
                [by rewrite the-negation-is-zero double-negation]
              @x-is-zero |
                x = ZERO
                [by rewrite x-is-neg-zero neg-of-zero]
            }
          @conclusion-the-negation-is-nonzero |
            not (rational.neg(x) = ZERO)
            [by contradiction given-the-negation-is-zero x-is-zero x-nonzero]
        }
      @nonzero-implies |
        (not (x = ZERO)) -> (not (rational.neg(x) = ZERO))
        [by discharge given-x-nonzero]
    }
  @conclusion |
    forall x: Q;
      (not (x = ZERO)) -> (not (rational.neg(x) = ZERO))
    [by generalize generalize-x]
qed

// Whatever bounds a polynomial bounds its negation: above the bound both vanish, the negation
// because neg(NAT_ZERO) = NAT_ZERO.
theorem theNegationIsBoundedWhereverTheOriginalIs: forall p: QPoly; forall n: peano.Nat;
  qdegreeAtMost(p, n) -> qdegreeAtMost(qnegP(p), n)
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-n |
        fix n: peano.Nat {
          @given-the-bound |
            assume qdegreeAtMost(p, n) {
              @the-bound |
                qdegreeAtMost(p, n)
                [by hypothesis given-the-bound]
              @the-bounds-meaning |
                qdegreeAtMost(p, n) iff
                  (forall i: peano.Nat;
                  peano.less_than(n, i) -> qcoeff(p, i) = ZERO)
                [using specialize qDegreeAtMostMeaning(p, n)]
              @the-original-vanishes-above |
                forall i: peano.Nat;
                  peano.less_than(n, i) -> qcoeff(p, i) = ZERO
                [using tautology the-bounds-meaning the-bound]
              @the-negation-vanishes-above |
                fix i: peano.Nat {
                  @given-i-above |
                    assume peano.less_than(n, i) {
                      @i-above |
                        peano.less_than(n, i)
                        [by hypothesis given-i-above]
                      @the-original-at-i |
                        qcoeff(p, i) = ZERO
                        [using specialize the-original-vanishes-above(i) i-above]
                      @the-negated-coefficient |
                        qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
                        [using specialize qNegPolyCoeff(p, i)]
                      @the-negated-coefficient-at-zero |
                        qcoeff(qnegP(p), i) = rational.neg(ZERO)
                        [by rewrite the-original-at-i the-negated-coefficient]
                      @neg-of-zero |
                        rational.neg(ZERO) = ZERO
                        [by cite rational.negZero]
                      @conclusion-the-negation-at-i |
                        qcoeff(qnegP(p), i) = ZERO
                        [by rewrite neg-of-zero the-negated-coefficient-at-zero]
                    }
                  @above-implies-vanishes |
                    peano.less_than(n, i) -> qcoeff(qnegP(p), i) = ZERO
                    [by discharge given-i-above]
                }
              @all-above-vanish |
                forall i: peano.Nat;
                  peano.less_than(n, i) -> qcoeff(qnegP(p), i) = ZERO
                [by generalize the-negation-vanishes-above]
              @the-negations-bound-meaning |
                qdegreeAtMost(qnegP(p), n) iff
                  (forall i: peano.Nat;
                  peano.less_than(n, i) -> qcoeff(qnegP(p), i) = ZERO)
                [using specialize qDegreeAtMostMeaning(qnegP(p), n)]
              @conclusion-the-negation-is-bounded |
                qdegreeAtMost(qnegP(p), n)
                [using tautology the-negations-bound-meaning all-above-vanish]
            }
          @bound-implies-bound |
            qdegreeAtMost(p, n) -> qdegreeAtMost(qnegP(p), n)
            [by discharge given-the-bound]
        }
      @discharge-n |
        forall n9: peano.Nat;
          qdegreeAtMost(p, n9) -> qdegreeAtMost(qnegP(p), n9)
        [by generalize generalize-n]
    }
  @conclusion |
    forall p: QPoly; forall n: peano.Nat;
      qdegreeAtMost(p, n) -> qdegreeAtMost(qnegP(p), n)
    [by generalize generalize-p]
qed

// Negation preserves the degree. The negation is nonzero, its coefficient at the original's
// degree is nonzero (the flip of a nonzero rational), and it is bounded there — so
// `degreeIsUnique` pins the two degrees equal.
theorem negationPreservesTheDegree: forall p: QPoly;
  (not (p = QZEROP)) -> qdegree(qnegP(p)) = qdegree(p)
proof
  @generalize-p |
    fix p: QPoly {
      @given-p-nonzero |
        assume not (p = QZEROP) {
          @p-nonzero |
            not (p = QZEROP)
            [by hypothesis given-p-nonzero]
          @the-negation-is-nonzero |
            not (qnegP(p) = QZEROP)
            [using specialize theNegationOfANonzeroPolynomialIsNonzero(p) p-nonzero]
          // the negation's coefficient at p's degree is nonzero
          @the-leading-coefficient-survives |
            not (qcoeff(p, qdegree(p)) = ZERO)
            [using specialize qDegreeIsALeadingIndex(p) p-nonzero]
          @the-negated-coefficient |
            qcoeff(qnegP(p), qdegree(p)) = rational.neg(qcoeff(p, qdegree(p)))
            [using specialize qNegPolyCoeff(p, qdegree(p))]
          @the-negated-leading-coefficient-survives |
            not (rational.neg(qcoeff(p, qdegree(p))) = ZERO)
            [using specialize aNonzeroHasNonzeroNegation(qcoeff(p, qdegree(p))) the-leading-coefficient-survives]
          @the-negations-coefficient-survives |
            not (qcoeff(qnegP(p), qdegree(p)) = ZERO)
            [by rewrite the-negated-coefficient the-negated-leading-coefficient-survives]
          // and it is bounded there: p's bound carries over coefficientwise
          @the-original-is-bounded |
            qdegreeAtMost(p, qdegree(p))
            [using specialize qDegreeBoundsTheCoefficients(p) p-nonzero]
          @the-negation-is-bounded |
            qdegreeAtMost(qnegP(p), qdegree(p))
            [using specialize theNegationIsBoundedWhereverTheOriginalIs(p, qdegree(p)) the-original-is-bounded]
          @degree-is-unique |
            forall q: QPoly; forall n: peano.Nat;
              (not (q = QZEROP)) -> (not (qcoeff(q, n) = ZERO)) ->
              qdegreeAtMost(q, n) -> n = qdegree(q)
            [using model(RationalPolynomials) fieldpoly.degreeIsUnique]
          @the-degrees-agree-flipped |
            qdegree(p) = qdegree(qnegP(p))
            [using specialize degree-is-unique(qnegP(p), qdegree(p)) the-negation-is-nonzero the-negations-coefficient-survives the-negation-is-bounded]
          @conclusion-the-degrees-agree |
            qdegree(qnegP(p)) = qdegree(p)
            [by symmetry the-degrees-agree-flipped]
        }
      @nonzero-implies-the-degrees-agree |
        (not (p = QZEROP)) -> qdegree(qnegP(p)) = qdegree(p)
        [by discharge given-p-nonzero]
    }
  @conclusion |
    forall p: QPoly;
      (not (p = QZEROP)) -> qdegree(qnegP(p)) = qdegree(p)
    [by generalize generalize-p]
qed

// -- JUDSON'S MONIC NORMALIZATION ---------------------------------------------------------
// "In the second case a(x) = -α₁(x) and b(x) = -β₁(x) are the correct monic polynomials."
// With the degree preserved and the leading coefficient flipped, a polynomial whose leading
// coefficient is -1 negates to a MONIC one of the same degree. That, with the c = 1 /
// a_m = b_n = 1 case being immediate, is the whole of Gauss's monic bookkeeping.
theorem negatingALeadingMinusOneMakesItMonic: forall p: QPoly;
  (not (p = QZEROP)) ->
  qcoeff(p, qdegree(p)) = rational.neg(rational.ONE) ->
  qIsMonic(qnegP(p))
proof
  @generalize-p |
    fix p: QPoly {
      @given-p-nonzero |
        assume not (p = QZEROP) {
          @p-nonzero |
            not (p = QZEROP)
            [by hypothesis given-p-nonzero]
          @given-the-leading-coefficient-is-minus-one |
            assume qcoeff(p, qdegree(p)) = rational.neg(rational.ONE) {
              @the-leading-coefficient-is-minus-one |
                qcoeff(p, qdegree(p)) = rational.neg(rational.ONE)
                [by hypothesis given-the-leading-coefficient-is-minus-one]
              // the negation's coefficient at p's degree is ONE
              @the-flip |
                qcoeff(qnegP(p), qdegree(p)) = rational.ONE
                [using specialize theNegationsCoefficientFlips(p, qdegree(p)) the-leading-coefficient-is-minus-one]
              // and p's degree IS the negation's degree
              @the-degrees-agree |
                qdegree(qnegP(p)) = qdegree(p)
                [using specialize negationPreservesTheDegree(p) p-nonzero]
              @the-negations-leading-coefficient |
                qcoeff(qnegP(p), qdegree(qnegP(p))) = rational.ONE
                [by rewrite the-degrees-agree the-flip]
              @monic-meaning |
                qIsMonic(qnegP(p)) iff
                  qcoeff(qnegP(p), qdegree(qnegP(p))) = rational.ONE
                [using specialize qMonicMeansTheLeadingCoefficientIsOne(qnegP(p))]
              @conclusion-the-negation-is-monic |
                qIsMonic(qnegP(p))
                [using tautology monic-meaning the-negations-leading-coefficient]
            }
          @minus-one-implies-monic |
            qcoeff(p, qdegree(p)) = rational.neg(rational.ONE) ->
              qIsMonic(qnegP(p))
            [by discharge given-the-leading-coefficient-is-minus-one]
        }
      @nonzero-implies |
        (not (p = QZEROP)) ->
          qcoeff(p, qdegree(p)) = rational.neg(rational.ONE) ->
          qIsMonic(qnegP(p))
        [by discharge given-p-nonzero]
    }
  @conclusion |
    forall p: QPoly;
      (not (p = QZEROP)) ->
      qcoeff(p, qdegree(p)) = rational.neg(rational.ONE) ->
      qIsMonic(qnegP(p))
    [by generalize generalize-p]
qed

// -- SCALING BY A CONSTANT ------------------------------------------------------------------
// Multiplying by the constant monomial `c` scales every coefficient by `c`. Lemma 17.12's
// conclusion is exactly such a scaling (`p = (r/s)·q`), so this is the law that makes the
// statement checkable against coefficients.
//
// The convolution at a constant left factor collapses: `monomial(c, 0)` has coefficient `c`
// at index ZERO and ZERO above, so every term of the convolution past the first vanishes.

// Multiplying by a monomial shifts every coefficient. TRANSFERRED from F[x], which has it
// from the generic monomial theory — subtraction-free, since the statement names `k + t`
// rather than reading `qcoeff(q, sub(i, k))`.
theorem theMonomialShift: forall g: QPoly; forall c: Q; forall k, t: Nat;
  qcoeff(qmulP(qmonomial(c, k), g), peano.add(k, t)) = rational.mul(c, qcoeff(g, t))
proof
  @conclusion |
    forall g: QPoly; forall c: Q; forall k, t: Nat;
      qcoeff(qmulP(qmonomial(c, k), g), peano.add(k, t)) =
      rational.mul(c, qcoeff(g, t))
    [using model(RationalPolynomials) fieldpoly.theMonomialShiftsEveryCoefficient]
qed

// Hence the scaling law: every coefficient of c·q is c times q's.
theorem scalingByAConstantScalesTheCoefficients:
  forall q: QPoly; forall c: Q; forall i: Nat;
  qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) =
  rational.mul(c, qcoeff(q, i))
proof
  @generalize-q |
    fix q: QPoly {
      @generalize-c |
        fix c: Q {
          @generalize-i |
            fix i: Nat {
              @the-monomial-shifts |
                qcoeff(qmulP(qmonomial(c, NAT_ZERO), q),
                  peano.add(NAT_ZERO, i)) = rational.mul(c, qcoeff(q, i))
                [using specialize theMonomialShift(q, c, NAT_ZERO, i)]
              @the-index-collapses |
                peano.add(NAT_ZERO, i) = i
                [using specialize peano.addZeroLeft(i)]
              @conclusion-scaled |
                qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) =
                  rational.mul(c, qcoeff(q, i))
                [by rewrite the-index-collapses the-monomial-shifts]
            }
          @discharge-i |
            forall i9: Nat;
              qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i9) =
              rational.mul(c, qcoeff(q, i9))
            [by generalize generalize-i]
        }
      @discharge-c |
        forall c9: Q; forall i9: Nat;
          qcoeff(qmulP(qmonomial(c9, NAT_ZERO), q), i9) =
          rational.mul(c9, qcoeff(q, i9))
        [by generalize generalize-c]
    }
  @conclusion |
    forall q: QPoly; forall c: Q; forall i: Nat;
      qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) =
      rational.mul(c, qcoeff(q, i))
    [by generalize generalize-q]
qed

// -- THE PRODUCT'S DEGREE AND LEADING COEFFICIENT ----------------------------------------
// Gauss's d = 1 branch reads `c·a_m·b_n = 1` off the monic hypothesis, which needs the
// product's leading coefficient to be the product of the leading coefficients.
//
// It is proved in `std/ring/polynomial/leading.b4m` over a commutative ring, and restated in
// `std/field/polynomial.b4m` for F[x] — but F[x]'s version is NOT transferable here, because
// it is itself a model-transfer through `FieldPolyModelsRingPoly`, and 2b4m RE-CHECKS an
// inner transfer rather than composing models. Going through F[x] would therefore demand ℚ
// be mapped onto `ring.Ring` as a nested step, which fails with
// `std/ring.b4m:143: expected sort 'Field', got 'Q'`.
//
// So map ℚ[x] onto `ring_poly` DIRECTLY — one transfer, not two. The extra cost is that
// `ring_poly` carries a ONE polynomial that ℚ[x] does not declare. A model maps a CONST to a
// CONST, never to a term, so `qmonomial(ONE, ZERO)` cannot serve and ℚ[x] gets its own, with
// the two coefficient clauses `ring_poly` demands — which say exactly what the monomial laws
// read at index ZERO would say.
const QONEP: QPoly
axiom qOnePolyCoeffZero: qcoeff(QONEP, peano.ZERO) = rational.ONE
axiom qOnePolyCoeffHigher: forall i: peano.Nat;
  qcoeff(QONEP, peano.succ(i)) = ZERO

// ℚ[x] as a polynomial ring over the commutative ring ℚ. Both namespaces are mapped in one
// block, since `ring_poly.R` ALIASES `ring.Ring` and an alias cannot be mapped apart from
// its origin.
model RationalPolynomialsOverARing {
  ring.Ring: Q
  ring.ZERO: ZERO
  ring.ONE: rational.ONE
  ring.add: rational.add
  ring.mul: rational.mul
  ring.neg: rational.neg
  ring.addIsAssociative <- rational.addIsAssociative
  ring.addZeroLeft <- rational.addZeroLeft
  ring.addNegLeft <- rational.addNegLeft
  ring.addIsCommutative <- rational.addIsCommutative
  ring.mulIsAssociative <- rational.mulIsAssociative
  ring.mulAddDistribLeft <- rational.mulAddDistribLeft
  ring.mulAddDistribRight <- rational.mulAddDistribRight
  ring_poly.mulOneLeftR <- rational.mulOneLeft
  ring_poly.mulIsCommutativeR <- rational.mulIsCommutative
  ring_poly.Nat: peano.Nat
  ring_poly.ZERO: peano.ZERO
  ring_poly.succ: peano.succ
  ring_poly.addN: peano.add
  ring_poly.less_than: peano.less_than
  ring_poly.Poly: QPoly
  ring_poly.coeff: qcoeff
  ring_poly.ZEROP: QZEROP
  ring_poly.ONEP: QONEP
  ring_poly.addP: qaddP
  ring_poly.negP: qnegP
  ring_poly.mulP: qmulP
  ring_poly.convolution: qconvolution
  ring_poly.tailConvolution: qtailConvolution
  ring_poly.segment: qsegment
  ring_poly.rsegment: qrsegment
  ring_mono.monomial: qmonomial
  ring_mono.monomial <- qmonomial
  ring_poly.theGapTo: qtheGapTo
  ring_poly.theCofactorIndex: qtheCofactorIndex
  ring_poly.cappedRun: qcappedRun
  ring_poly.tripleTerm: qtripleTerm
  ring_poly.tripleRow: qtripleRow
  ring_poly.tripleDiag: qtripleDiag
  ring_poly.tripleTri: qtripleTri
  ring_poly.tripleRows: qtripleRows
  ring_poly.theGapTo <- qtheGapTo
  ring_poly.theCofactorIndex <- qtheCofactorIndex
  ring_poly.cappedRun <- qcappedRun
  ring_poly.tripleTerm <- qtripleTerm
  ring_poly.tripleRow <- qtripleRow
  ring_poly.tripleDiag <- qtripleDiag
  ring_poly.tripleTri <- qtripleTri
  ring_poly.tripleRows <- qtripleRows
  ring_poly.degreeAtMost: qdegreeAtMost
  ring_poly.degree: qdegree
  ring_poly.polyExtensionality <- qPolyExtensionality
  ring_poly.zeroPolyCoeff <- qZeroPolyCoeff
  ring_poly.onePolyCoeffZero <- qOnePolyCoeffZero
  ring_poly.onePolyCoeffHigher <- qOnePolyCoeffHigher
  ring_poly.addP <- qaddP
  ring_poly.negP <- qnegP
  ring_poly.degreeAtMostMeaning <- qDegreeAtMostMeaning
  ring_poly.degreeIsALeadingIndex <- qDegreeIsALeadingIndex
  ring_poly.degreeBoundsTheCoefficients <- qDegreeBoundsTheCoefficients
  ring_poly.convolution <- qconvolution
  ring_poly.tailConvolution <- qtailConvolution
  ring_poly.segment <- qsegment
  ring_poly.rsegment <- qrsegment
  ring_poly.mulP <- qmulP
}

theorem qTheProductsLeadingCoefficient: forall p, q: QPoly; forall m, n: peano.Nat;
  qdegreeAtMost(p, m) -> qdegreeAtMost(q, n) ->
  qcoeff(qmulP(p, q), peano.add(m, n)) =
  rational.mul(qcoeff(p, m), qcoeff(q, n))
proof
  @conclusion |
    forall p, q: QPoly; forall m, n: peano.Nat;
      qdegreeAtMost(p, m) -> qdegreeAtMost(q, n) ->
      qcoeff(qmulP(p, q), peano.add(m, n)) =
      rational.mul(qcoeff(p, m), qcoeff(q, n))
    [using model(RationalPolynomialsOverARing) ring_leading.theProductsLeadingCoefficient]
qed

// -- NEGATION AS A SCALING ------------------------------------------------------------------
// Negating a polynomial is scaling it by -1. Gauss's d = 1 branch needs
// (-α)(-β) = αβ, and routing it through the scaling form turns a polynomial identity into
// coefficient algebra: both sides' coefficients are neg(ONE)·neg(ONE)·(…) = (…).
theorem theNegationIsTheMinusOneScaling: forall p: QPoly;
  qnegP(p) = qmulP(qmonomial(rational.neg(rational.ONE), peano.ZERO), p)
proof
  @generalize-p |
    fix p: QPoly {
      @each-index |
        fix i: peano.Nat {
          @the-negations-coefficient |
            qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
            [using specialize qNegPolyCoeff(p, i)]
          @the-scalings-coefficient |
            qcoeff(qmulP(qmonomial(rational.neg(rational.ONE),
              peano.ZERO), p), i) =
              rational.mul(rational.neg(rational.ONE), qcoeff(p, i))
            [using specialize scalingByAConstantScalesTheCoefficients(p, rational.neg(rational.ONE), i)]
          @minus-one-times-is-the-negation |
            rational.mul(rational.neg(rational.ONE), qcoeff(p, i)) =
              rational.neg(qcoeff(p, i))
            [using polynomial(rational)]
          @the-scaling-is-the-negation |
            qcoeff(qmulP(qmonomial(rational.neg(rational.ONE),
              peano.ZERO), p), i) = rational.neg(qcoeff(p, i))
            [using simplify the-scalings-coefficient minus-one-times-is-the-negation]
          @conclusion-agree-at-i |
            qcoeff(qnegP(p), i) =
              qcoeff(qmulP(qmonomial(rational.neg(rational.ONE),
              peano.ZERO), p), i)
            [using simplify the-negations-coefficient the-scaling-is-the-negation]
        }
      @all-coefficients-agree |
        forall i: peano.Nat;
          qcoeff(qnegP(p), i) =
          qcoeff(qmulP(qmonomial(rational.neg(rational.ONE),
          peano.ZERO), p), i)
        [by generalize each-index]
      @the-extensionality |
        forall a, b: QPoly;
          (forall i: peano.Nat; qcoeff(a, i) = qcoeff(b, i)) -> a = b
        [by cite qPolyExtensionality]
      @conclusion-equal |
        qnegP(p) = qmulP(qmonomial(rational.neg(rational.ONE),
          peano.ZERO), p)
        [using specialize the-extensionality(qnegP(p), qmulP(qmonomial(rational.neg(rational.ONE), peano.ZERO), p)) all-coefficients-agree]
    }
  @conclusion |
    forall p: QPoly;
      qnegP(p) = qmulP(qmonomial(rational.neg(rational.ONE), peano.ZERO), p)
    [by generalize generalize-p]
qed

// -- EVALUATION ----------------------------------------------------------------------------
// Corollary 17.14 (the Rational Root Theorem) is about a ZERO of a polynomial, so ℚ[x] needs
// evaluation. F[x] has the whole layer; these are its symbols at ℚ, declared here so the
// `RationalPolynomials` model can map them and F[x]'s evaluation corpus can travel.
oper qpower(a: Q, n: peano.Nat) => Q:
  qpower(a, peano.ZERO) = rational.ONE;
  qpower(a, peano.succ(n)) = rational.mul(a, qpower(a, n))

oper qevalUpTo(p: QPoly, a: Q, k: peano.Nat) => Q:
  qevalUpTo(p, a, peano.ZERO) = ZERO;
  qevalUpTo(p, a, peano.succ(k)) = rational.add(qevalUpTo(p, a, k), rational.mul(qcoeff(p, k), qpower(a, k)))

// Judson's `p(a)`: the sum over every index up to AND INCLUDING the degree, which is what
// the `succ` bound buys.
define qevaluate(p, a) = qevalUpTo(p, a, peano.succ(qdegree(p)))

pred qIsZeroOf(a: Q, p: QPoly)
axiom qIsZeroOfMeaning: forall a: Q; forall p: QPoly;
  qIsZeroOf(a, p) iff qevaluate(p, a) = ZERO

// ℚ[x]'s multiplication is commutative, named locally so callers need not re-open the model.
theorem qMulIsCommutative: forall p, q: QPoly;
  qmulP(p, q) = qmulP(q, p)
proof
  @conclusion |
    forall p, q: QPoly; qmulP(p, q) = qmulP(q, p)
    [using model(RationalPolynomialsOverARing) ring_poly.polyMulIsCommutative]
qed

// At the polynomial level: negating the first factor negates the product.
// -- NEGATION PULLS OUT OF A PRODUCT --------------------------------------------------------
// Judson's d = 1 branch writes p(x) = (-a1(x))(-b1(x)), so the two negations must cancel. The
// step that makes it work is that negation pulls out of ONE factor. TRANSFERRED: the generic
// R[x] proof inducts on the convolution's length, which ℚ[x] once restated locally — 190
// lines that the reindexed convolution made redundant.
theorem theNegationPullsOutOfTheProduct: forall p, q: QPoly;
  qmulP(qnegP(p), q) = qnegP(qmulP(p, q))
proof
  @conclusion |
    forall p, q: QPoly; qmulP(qnegP(p), q) = qnegP(qmulP(p, q))
    [using model(RationalPolynomialsOverARing) ring_poly.negationPullsOutOfTheProduct]
qed

// Judson's `p(x) = (-α₁(x))(-β₁(x))`: both negations cancel. Pull the first out, commute to
// pull the second out, then `negP(negP(_))` is the identity — which follows coefficientwise
// from ℚ's own `negNeg`.
theorem theTwoNegationsCancelInAProduct: forall p, q: QPoly;
  qmulP(qnegP(p), qnegP(q)) = qmulP(p, q)
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @pull-the-first-out |
            qmulP(qnegP(p), qnegP(q)) = qnegP(qmulP(p, qnegP(q)))
            [using specialize theNegationPullsOutOfTheProduct(p, qnegP(q))]
          @the-commutation |
            forall a, b: QPoly; qmulP(a, b) = qmulP(b, a)
            [by cite qMulIsCommutative]
          @commute-the-inner |
            qmulP(p, qnegP(q)) = qmulP(qnegP(q), p)
            [using specialize the-commutation(p, qnegP(q))]
          @pull-the-second-out |
            qmulP(qnegP(q), p) = qnegP(qmulP(q, p))
            [using specialize theNegationPullsOutOfTheProduct(q, p)]
          @the-inner-is-doubly-negated |
            qmulP(p, qnegP(q)) = qnegP(qmulP(q, p))
            [using simplify commute-the-inner pull-the-second-out]
          @the-whole-is-doubly-negated |
            qmulP(qnegP(p), qnegP(q)) = qnegP(qnegP(qmulP(q, p)))
            [by rewrite the-inner-is-doubly-negated pull-the-first-out]
          // negP(negP(_)) is the identity, coefficientwise
          @each-index |
            fix i: peano.Nat {
              @the-outer-negation |
                qcoeff(qnegP(qnegP(qmulP(q, p))), i) =
                  rational.neg(qcoeff(qnegP(qmulP(q, p)), i))
                [using specialize qNegPolyCoeff(qnegP(qmulP(q, p)), i)]
              @the-inner-negation |
                qcoeff(qnegP(qmulP(q, p)), i) =
                  rational.neg(qcoeff(qmulP(q, p), i))
                [using specialize qNegPolyCoeff(qmulP(q, p), i)]
              @the-double-negation |
                qcoeff(qnegP(qnegP(qmulP(q, p))), i) =
                  rational.neg(rational.neg(qcoeff(qmulP(q, p), i)))
                [by rewrite the-inner-negation the-outer-negation]
              @the-negations-undo |
                rational.neg(rational.neg(qcoeff(qmulP(q, p), i))) =
                  qcoeff(qmulP(q, p), i)
                [using specialize rational.negNeg(qcoeff(qmulP(q, p), i))]
              @conclusion-agree-at-i |
                qcoeff(qnegP(qnegP(qmulP(q, p))), i) =
                  qcoeff(qmulP(q, p), i)
                [using simplify the-double-negation the-negations-undo]
            }
          @all-coefficients-agree |
            forall i: peano.Nat;
              qcoeff(qnegP(qnegP(qmulP(q, p))), i) =
              qcoeff(qmulP(q, p), i)
            [by generalize each-index]
          @the-extensionality |
            forall a, b: QPoly;
              (forall i: peano.Nat; qcoeff(a, i) = qcoeff(b, i)) -> a = b
            [by cite qPolyExtensionality]
          @the-double-negation-is-the-identity |
            qnegP(qnegP(qmulP(q, p))) = qmulP(q, p)
            [using specialize the-extensionality(qnegP(qnegP(qmulP(q, p))), qmulP(q, p)) all-coefficients-agree]
          @the-product-commuted-back |
            qmulP(q, p) = qmulP(p, q)
            [using specialize the-commutation(q, p)]
          @the-whole-is-the-commuted-product |
            qmulP(qnegP(p), qnegP(q)) = qmulP(q, p)
            [by rewrite the-double-negation-is-the-identity the-whole-is-doubly-negated]
          @conclusion-cancelled |
            qmulP(qnegP(p), qnegP(q)) = qmulP(p, q)
            [by rewrite the-product-commuted-back the-whole-is-the-commuted-product]
        }
      @discharge-q |
        forall q2: QPoly; qmulP(qnegP(p), qnegP(q2)) = qmulP(p, q2)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: QPoly; qmulP(qnegP(p), qnegP(q)) = qmulP(p, q)
    [by generalize generalize-p]
qed

// -- CLEARING DENOMINATORS FROM AN EVALUATION -----------------------------------------------
// Corollary 17.14's whole move is "multiply p(r/s) = 0 through by s^n". Done with the bound
// as the induction variable, the cleared sum has its own recursion and no subtraction
// anywhere — `sum_{i<k} a_i r^i s^(k-i)` grows at the top as
// `S(k+1) = s·(S(k) + a_k·r^k)`, since the new term's s-exponent is exactly 1.
oper qclearedSum(p: QPoly, r: Q, s: Q, k: peano.Nat) => Q:
  qclearedSum(p, r, s, peano.ZERO) = ZERO;
  qclearedSum(p, r, s, peano.succ(k)) = rational.mul(s, rational.add(qclearedSum(p, r, s, k), rational.mul(qcoeff(p, k), qpower(r, k))))

// A product's power splits, by induction on the exponent.
theorem aProductsPowerSplits: forall a, b: Q; forall k: peano.Nat;
  qpower(rational.mul(a, b), k) =
  rational.mul(qpower(a, k), qpower(b, k))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          // base: all three powers are ONE
          @the-zero-power-of-the-product |
            qpower(rational.mul(a, b), peano.ZERO) = rational.ONE
            [using specialize qPowerZero(rational.mul(a, b))]
          @the-zero-power-of-a |
            qpower(a, peano.ZERO) = rational.ONE
            [using specialize qPowerZero(a)]
          @the-zero-power-of-b |
            qpower(b, peano.ZERO) = rational.ONE
            [using specialize qPowerZero(b)]
          @one-times-one |
            rational.mul(rational.ONE, rational.ONE) = rational.ONE
            [using specialize rational.mulOneLeft(rational.ONE)]
          @the-base-right-side |
            rational.mul(qpower(a, peano.ZERO),
              qpower(b, peano.ZERO)) = rational.ONE
            [using simplify the-zero-power-of-a the-zero-power-of-b one-times-one]
          @base-case |
            qpower(rational.mul(a, b), peano.ZERO) =
              rational.mul(qpower(a, peano.ZERO),
              qpower(b, peano.ZERO))
            [using simplify the-zero-power-of-the-product the-base-right-side]

          @induction-step |
            fix k: peano.Nat {
              @given-inductive-hypothesis |
                assume qpower(rational.mul(a, b), k) =
                  rational.mul(qpower(a, k), qpower(b, k)) {
                  @inductive-hypothesis |
                    qpower(rational.mul(a, b), k) =
                      rational.mul(qpower(a, k), qpower(b, k))
                    [by hypothesis given-inductive-hypothesis]
                  @the-next-power-of-the-product |
                    qpower(rational.mul(a, b), peano.succ(k)) =
                      rational.mul(rational.mul(a, b),
                      qpower(rational.mul(a, b), k))
                    [using specialize qPowerSucc(rational.mul(a, b), k)]
                  @the-next-power-with-the-hypothesis |
                    qpower(rational.mul(a, b), peano.succ(k)) =
                      rational.mul(rational.mul(a, b),
                      rational.mul(qpower(a, k), qpower(b, k)))
                    [by rewrite inductive-hypothesis the-next-power-of-the-product]
                  @the-next-power-of-a |
                    qpower(a, peano.succ(k)) =
                      rational.mul(a, qpower(a, k))
                    [using specialize qPowerSucc(a, k)]
                  @the-next-power-of-b |
                    qpower(b, peano.succ(k)) =
                      rational.mul(b, qpower(b, k))
                    [using specialize qPowerSucc(b, k)]
                  @the-right-side-expanded |
                    rational.mul(qpower(a, peano.succ(k)),
                      qpower(b, peano.succ(k))) =
                      rational.mul(rational.mul(a, qpower(a, k)),
                      rational.mul(b, qpower(b, k)))
                    [using simplify the-next-power-of-a the-next-power-of-b]
                  @the-two-groupings-agree |
                    rational.mul(rational.mul(a, b),
                      rational.mul(qpower(a, k), qpower(b, k))) =
                      rational.mul(rational.mul(a, qpower(a, k)),
                      rational.mul(b, qpower(b, k)))
                    [using polynomial(rational)]
                  @the-next-power-regrouped |
                    qpower(rational.mul(a, b), peano.succ(k)) =
                      rational.mul(rational.mul(a, qpower(a, k)),
                      rational.mul(b, qpower(b, k)))
                    [by rewrite the-two-groupings-agree the-next-power-with-the-hypothesis]
                  @conclusion-the-step |
                    qpower(rational.mul(a, b), peano.succ(k)) =
                      rational.mul(qpower(a, peano.succ(k)),
                      qpower(b, peano.succ(k)))
                    [by rewrite the-right-side-expanded the-next-power-regrouped]
                }
              @induction-step-at-k |
                (qpower(rational.mul(a, b), k) =
                  rational.mul(qpower(a, k), qpower(b, k))) ->
                  (qpower(rational.mul(a, b), peano.succ(k)) =
                  rational.mul(qpower(a, peano.succ(k)),
                  qpower(b, peano.succ(k))))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: peano.Nat;
              (qpower(rational.mul(a, b), k) =
              rational.mul(qpower(a, k), qpower(b, k))) ->
              (qpower(rational.mul(a, b), peano.succ(k)) =
              rational.mul(qpower(a, peano.succ(k)),
              qpower(b, peano.succ(k))))
            [by generalize induction-step]
          @all-exponents |
            forall k: peano.Nat;
              qpower(rational.mul(a, b), k) =
              rational.mul(qpower(a, k), qpower(b, k))
            [using instantiation peano.induction((fun z: peano.Nat => (qpower(rational.mul(a, b), z) = rational.mul(qpower(a, z), qpower(b, z))))) base-case induction-step-for-all-k]
        }
      @discharge-b |
        forall b9: Q; forall k: peano.Nat;
          qpower(rational.mul(a, b9), k) =
          rational.mul(qpower(a, k), qpower(b9, k))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q; forall k: peano.Nat;
      qpower(rational.mul(a, b), k) =
      rational.mul(qpower(a, k), qpower(b, k))
    [by generalize generalize-a]
qed

// A power and its reciprocal's power cancel. The one auxiliary the clearing identity needs.
theorem aPowerCancelsTheReciprocalsPower: forall s: Q; forall k: peano.Nat;
  rational.nonzero(s) ->
  rational.mul(qpower(s, k), qpower(rational.recip(s), k)) = rational.ONE
proof
  @generalize-s |
    fix s: Q {
      @given-s-nonzero |
        assume rational.nonzero(s) {
          @s-nonzero |
            rational.nonzero(s)
            [by hypothesis given-s-nonzero]
          @s-inverts |
            rational.mul(s, rational.recip(s)) = rational.ONE
            [using specialize rational.fieldInverse(s) s-nonzero]
          // base: both powers are ONE
          @the-zero-power |
            qpower(s, peano.ZERO) = rational.ONE
            [using specialize qPowerZero(s)]
          @the-zero-reciprocal-power |
            qpower(rational.recip(s), peano.ZERO) = rational.ONE
            [using specialize qPowerZero(rational.recip(s))]
          @one-times-one |
            rational.mul(rational.ONE, rational.ONE) = rational.ONE
            [using specialize rational.mulOneLeft(rational.ONE)]
          @the-base-product |
            rational.mul(qpower(s, peano.ZERO),
              qpower(rational.recip(s), peano.ZERO)) =
              rational.mul(rational.ONE, rational.ONE)
            [using simplify the-zero-power the-zero-reciprocal-power]
          @base-case |
            rational.mul(qpower(s, peano.ZERO),
              qpower(rational.recip(s), peano.ZERO)) = rational.ONE
            [using simplify the-base-product one-times-one]

          @induction-step |
            fix k: peano.Nat {
              @given-inductive-hypothesis |
                assume rational.mul(qpower(s, k),
                  qpower(rational.recip(s), k)) = rational.ONE {
                  @inductive-hypothesis |
                    rational.mul(qpower(s, k),
                      qpower(rational.recip(s), k)) = rational.ONE
                    [by hypothesis given-inductive-hypothesis]
                  @the-next-power |
                    qpower(s, peano.succ(k)) =
                      rational.mul(s, qpower(s, k))
                    [using specialize qPowerSucc(s, k)]
                  @the-next-reciprocal-power |
                    qpower(rational.recip(s), peano.succ(k)) =
                      rational.mul(rational.recip(s),
                      qpower(rational.recip(s), k))
                    [using specialize qPowerSucc(rational.recip(s), k)]
                  @the-product-expanded |
                    rational.mul(qpower(s, peano.succ(k)),
                      qpower(rational.recip(s), peano.succ(k))) =
                      rational.mul(rational.mul(s, qpower(s, k)),
                      rational.mul(rational.recip(s),
                      qpower(rational.recip(s), k)))
                    [using simplify the-next-power the-next-reciprocal-power]
                  // regroup as (s·recip s)·(s^k·recip(s)^k)
                  @the-regrouping |
                    rational.mul(rational.mul(s, qpower(s, k)),
                      rational.mul(rational.recip(s),
                      qpower(rational.recip(s), k))) =
                      rational.mul(rational.mul(s,
                      rational.recip(s)),
                      rational.mul(qpower(s, k),
                      qpower(rational.recip(s), k)))
                    [using polynomial(rational)]
                  @the-product-regrouped |
                    rational.mul(qpower(s, peano.succ(k)),
                      qpower(rational.recip(s), peano.succ(k))) =
                      rational.mul(rational.mul(s,
                      rational.recip(s)),
                      rational.mul(qpower(s, k),
                      qpower(rational.recip(s), k)))
                    [by rewrite the-regrouping the-product-expanded]
                  @both-halves-are-one |
                    rational.mul(qpower(s, peano.succ(k)),
                      qpower(rational.recip(s), peano.succ(k))) =
                      rational.mul(rational.ONE, rational.ONE)
                    [using simplify the-product-regrouped s-inverts inductive-hypothesis]
                  @conclusion-the-step |
                    rational.mul(qpower(s, peano.succ(k)),
                      qpower(rational.recip(s), peano.succ(k))) =
                      rational.ONE
                    [using simplify both-halves-are-one one-times-one]
                }
              @induction-step-at-k |
                (rational.mul(qpower(s, k),
                  qpower(rational.recip(s), k)) = rational.ONE) ->
                  (rational.mul(qpower(s, peano.succ(k)),
                  qpower(rational.recip(s), peano.succ(k))) =
                  rational.ONE)
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: peano.Nat;
              (rational.mul(qpower(s, k),
              qpower(rational.recip(s), k)) = rational.ONE) ->
              (rational.mul(qpower(s, peano.succ(k)),
              qpower(rational.recip(s), peano.succ(k))) = rational.ONE)
            [by generalize induction-step]
          @all-exponents |
            forall k: peano.Nat;
              rational.mul(qpower(s, k),
              qpower(rational.recip(s), k)) = rational.ONE
            [using instantiation peano.induction((fun z: peano.Nat => (rational.mul(qpower(s, z), qpower(rational.recip(s), z)) = rational.ONE))) base-case induction-step-for-all-k]
        }
      @nonzero-implies |
        rational.nonzero(s) ->
          (forall k: peano.Nat;
          rational.mul(qpower(s, k),
          qpower(rational.recip(s), k)) = rational.ONE)
        [by discharge given-s-nonzero]
      // move the bound binder outside the implication: fix k, re-assume, and
      // specialize the universal the implication delivers
      @each-exponent |
        fix k: peano.Nat {
          @given-s-nonzero-again |
            assume rational.nonzero(s) {
              @s-nonzero-again |
                rational.nonzero(s)
                [by hypothesis given-s-nonzero-again]
              @all-exponents-here |
                forall k2: peano.Nat;
                  rational.mul(qpower(s, k2),
                  qpower(rational.recip(s), k2)) = rational.ONE
                [by modus_ponens nonzero-implies s-nonzero-again]
              @conclusion-at-k |
                rational.mul(qpower(s, k),
                  qpower(rational.recip(s), k)) = rational.ONE
                [using specialize all-exponents-here(k)]
            }
          @nonzero-implies-at-k |
            rational.nonzero(s) ->
              rational.mul(qpower(s, k),
              qpower(rational.recip(s), k)) = rational.ONE
            [by discharge given-s-nonzero-again]
        }
      @discharge-s |
        forall k: peano.Nat;
          rational.nonzero(s) ->
          rational.mul(qpower(s, k),
          qpower(rational.recip(s), k)) = rational.ONE
        [by generalize each-exponent]
    }
  @conclusion |
    forall s: Q; forall k: peano.Nat;
      rational.nonzero(s) ->
      rational.mul(qpower(s, k), qpower(rational.recip(s), k)) =
      rational.ONE
    [by generalize generalize-s]
qed

// The clearing identity: multiplying an evaluation at r/s by s^k gives the cleared sum,
// whose terms are all integers when p's coefficients, r and s are.
theorem clearingTheDenominatorGivesTheClearedSum: forall p: QPoly;
  forall r, s: Q; forall k: peano.Nat;
  rational.nonzero(s) ->
  rational.mul(qpower(s, k),
  qevalUpTo(p, rational.mul(r, rational.recip(s)), k)) =
  qclearedSum(p, r, s, k)
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @given-s-nonzero |
                assume rational.nonzero(s) {
                  @s-nonzero |
                    rational.nonzero(s)
                    [by hypothesis given-s-nonzero]
                  // base: s^0 · 0 = 0
                  @the-zero-power |
                    qpower(s, peano.ZERO) = rational.ONE
                    [using specialize qPowerZero(s)]
                  @the-empty-evaluation |
                    qevalUpTo(p, rational.mul(r, rational.recip(s)),
                      peano.ZERO) = ZERO
                    [using specialize qEvalZero(p, rational.mul(r, rational.recip(s)))]
                  @the-empty-cleared-sum |
                    qclearedSum(p, r, s, peano.ZERO) = ZERO
                    [using specialize qClearedSumZero(p, r, s)]
                  @one-times-zero |
                    rational.mul(rational.ONE, ZERO) = ZERO
                    [using specialize rational.mulOneLeft(ZERO)]
                  @the-base-product |
                    rational.mul(qpower(s, peano.ZERO),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), peano.ZERO)) =
                      rational.mul(rational.ONE, ZERO)
                    [using simplify the-zero-power the-empty-evaluation]
                  @the-base-is-zero |
                    rational.mul(qpower(s, peano.ZERO),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), peano.ZERO)) = ZERO
                    [using simplify the-base-product one-times-zero]
                  @base-case |
                    rational.mul(qpower(s, peano.ZERO),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), peano.ZERO)) =
                      qclearedSum(p, r, s, peano.ZERO)
                    [by rewrite the-empty-cleared-sum the-base-is-zero]

                  @induction-step |
                    fix k: peano.Nat {
                      @given-inductive-hypothesis |
                        assume rational.mul(qpower(s, k),
                          qevalUpTo(p, rational.mul(r,
                          rational.recip(s)), k)) =
                          qclearedSum(p, r, s, k) {
                          @inductive-hypothesis |
                            rational.mul(qpower(s, k),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k)) =
                              qclearedSum(p, r, s, k)
                            [by hypothesis given-inductive-hypothesis]
                          @the-next-evaluation |
                            qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k)) =
                              rational.add(
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k),
                              rational.mul(qcoeff(p, k),
                              qpower(rational.mul(r,
                              rational.recip(s)), k)))
                            [using specialize qEvalSucc(p, rational.mul(r, rational.recip(s)), k)]
                          @the-next-power |
                            qpower(s, peano.succ(k)) =
                              rational.mul(s, qpower(s, k))
                            [using specialize qPowerSucc(s, k)]
                          // the quotient's power splits
                          @the-quotients-power-splits |
                            qpower(rational.mul(r,
                              rational.recip(s)), k) =
                              rational.mul(qpower(r, k),
                              qpower(rational.recip(s), k))
                            [using specialize aProductsPowerSplits(r, rational.recip(s), k)]
                          @the-powers-cancel |
                            rational.mul(qpower(s, k),
                              qpower(rational.recip(s), k)) =
                              rational.ONE
                            [using specialize aPowerCancelsTheReciprocalsPower(s, k) s-nonzero]
                          // s^(k+1) · eval(k+1)
                          //   = s·(s^k·eval k) + s·(s^k·recip(s)^k)·a_k·r^k
                          @the-product-expanded |
                            rational.mul(qpower(s, peano.succ(k)),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k))) =
                              rational.mul(
                              rational.mul(s, qpower(s, k)),
                              rational.add(
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k),
                              rational.mul(qcoeff(p, k),
                              rational.mul(qpower(r, k),
                              qpower(rational.recip(s), k)))))
                            [using simplify the-next-power the-next-evaluation the-quotients-power-splits]
                          @the-regrouping |
                            rational.mul(
                              rational.mul(s, qpower(s, k)),
                              rational.add(
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k),
                              rational.mul(qcoeff(p, k),
                              rational.mul(qpower(r, k),
                              qpower(rational.recip(s), k))))) =
                              rational.mul(s, rational.add(
                              rational.mul(qpower(s, k),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k)),
                              rational.mul(
                              rational.mul(qpower(s, k),
                              qpower(rational.recip(s), k)),
                              rational.mul(qcoeff(p, k),
                              qpower(r, k)))))
                            [using polynomial(rational)]
                          @the-product-regrouped |
                            rational.mul(qpower(s, peano.succ(k)),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k))) =
                              rational.mul(s, rational.add(
                              rational.mul(qpower(s, k),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), k)),
                              rational.mul(
                              rational.mul(qpower(s, k),
                              qpower(rational.recip(s), k)),
                              rational.mul(qcoeff(p, k),
                              qpower(r, k)))))
                            [by rewrite the-regrouping the-product-expanded]
                          // substitute the hypothesis and the cancellation
                          @the-product-with-the-hypothesis |
                            rational.mul(qpower(s, peano.succ(k)),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k))) =
                              rational.mul(s, rational.add(
                              qclearedSum(p, r, s, k),
                              rational.mul(rational.ONE,
                              rational.mul(qcoeff(p, k),
                              qpower(r, k)))))
                            [using simplify the-product-regrouped inductive-hypothesis the-powers-cancel]
                          @the-unit-drops |
                            rational.mul(s, rational.add(
                              qclearedSum(p, r, s, k),
                              rational.mul(rational.ONE,
                              rational.mul(qcoeff(p, k),
                              qpower(r, k))))) =
                              rational.mul(s, rational.add(
                              qclearedSum(p, r, s, k),
                              rational.mul(qcoeff(p, k),
                              qpower(r, k))))
                            [using polynomial(rational)]
                          @the-product-cleaned |
                            rational.mul(qpower(s, peano.succ(k)),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k))) =
                              rational.mul(s, rational.add(
                              qclearedSum(p, r, s, k),
                              rational.mul(qcoeff(p, k),
                              qpower(r, k))))
                            [by rewrite the-unit-drops the-product-with-the-hypothesis]
                          @the-next-cleared-sum |
                            qclearedSum(p, r, s, peano.succ(k)) =
                              rational.mul(s, rational.add(
                              qclearedSum(p, r, s, k),
                              rational.mul(qcoeff(p, k),
                              qpower(r, k))))
                            [using specialize qClearedSumSucc(p, r, s, k)]
                          @conclusion-the-step |
                            rational.mul(qpower(s, peano.succ(k)),
                              qevalUpTo(p, rational.mul(r,
                              rational.recip(s)), peano.succ(k))) =
                              qclearedSum(p, r, s, peano.succ(k))
                            [by rewrite the-next-cleared-sum the-product-cleaned]
                        }
                      @induction-step-at-k |
                        (rational.mul(qpower(s, k),
                          qevalUpTo(p, rational.mul(r,
                          rational.recip(s)), k)) =
                          qclearedSum(p, r, s, k)) ->
                          (rational.mul(qpower(s, peano.succ(k)),
                          qevalUpTo(p, rational.mul(r,
                          rational.recip(s)), peano.succ(k))) =
                          qclearedSum(p, r, s, peano.succ(k)))
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-for-all-k |
                    forall k: peano.Nat;
                      (rational.mul(qpower(s, k),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), k)) =
                      qclearedSum(p, r, s, k)) ->
                      (rational.mul(qpower(s, peano.succ(k)),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), peano.succ(k))) =
                      qclearedSum(p, r, s, peano.succ(k)))
                    [by generalize induction-step]
                  @all-bounds |
                    forall k: peano.Nat;
                      rational.mul(qpower(s, k),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), k)) =
                      qclearedSum(p, r, s, k)
                    [using instantiation peano.induction((fun z: peano.Nat => (rational.mul(qpower(s, z), qevalUpTo(p, rational.mul(r, rational.recip(s)), z)) = qclearedSum(p, r, s, z)))) base-case induction-step-for-all-k]
                }
              @nonzero-implies |
                rational.nonzero(s) ->
                  (forall k: peano.Nat;
                  rational.mul(qpower(s, k),
                  qevalUpTo(p, rational.mul(r,
                  rational.recip(s)), k)) =
                  qclearedSum(p, r, s, k))
                [by discharge given-s-nonzero]
              @each-bound |
                fix k: peano.Nat {
                  @given-s-nonzero-again |
                    assume rational.nonzero(s) {
                      @s-nonzero-again |
                        rational.nonzero(s)
                        [by hypothesis given-s-nonzero-again]
                      @all-bounds-here |
                        forall k2: peano.Nat;
                          rational.mul(qpower(s, k2),
                          qevalUpTo(p, rational.mul(r,
                          rational.recip(s)), k2)) =
                          qclearedSum(p, r, s, k2)
                        [by modus_ponens nonzero-implies s-nonzero-again]
                      @conclusion-at-k |
                        rational.mul(qpower(s, k),
                          qevalUpTo(p, rational.mul(r,
                          rational.recip(s)), k)) =
                          qclearedSum(p, r, s, k)
                        [using specialize all-bounds-here(k)]
                    }
                  @nonzero-implies-at-k |
                    rational.nonzero(s) ->
                      rational.mul(qpower(s, k),
                      qevalUpTo(p, rational.mul(r,
                      rational.recip(s)), k)) =
                      qclearedSum(p, r, s, k)
                    [by discharge given-s-nonzero-again]
                }
              @discharge-s |
                forall k: peano.Nat;
                  rational.nonzero(s) ->
                  rational.mul(qpower(s, k),
                  qevalUpTo(p, rational.mul(r,
                  rational.recip(s)), k)) =
                  qclearedSum(p, r, s, k)
                [by generalize each-bound]
            }
          @discharge-r |
            forall s9: Q; forall k: peano.Nat;
              rational.nonzero(s9) ->
              rational.mul(qpower(s9, k),
              qevalUpTo(p, rational.mul(r, rational.recip(s9)), k)) =
              qclearedSum(p, r, s9, k)
            [by generalize generalize-s]
        }
      @discharge-p |
        forall r9, s9: Q; forall k: peano.Nat;
          rational.nonzero(s9) ->
          rational.mul(qpower(s9, k),
          qevalUpTo(p, rational.mul(r9, rational.recip(s9)), k)) =
          qclearedSum(p, r9, s9, k)
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
      rational.nonzero(s) ->
      rational.mul(qpower(s, k),
      qevalUpTo(p, rational.mul(r, rational.recip(s)), k)) =
      qclearedSum(p, r, s, k)
    [by generalize generalize-p]
qed

// Every power of an integer is an integer — induction on the exponent, `isIntegerMul` at
// each step and `oneIsAnInteger` at the base.
theorem everyPowerOfAnIntegerIsAnInteger: forall a: Q;
  rational.isInteger(a) ->
  (forall k: peano.Nat; rational.isInteger(qpower(a, k)))
proof
  @generalize-a |
    fix a: Q {
      @given-a-is-an-integer |
        assume rational.isInteger(a) {
          @a-is-an-integer |
            rational.isInteger(a)
            [by hypothesis given-a-is-an-integer]
          @the-integer-products |
            forall x, y: Q; rational.isInteger(x) ->
              rational.isInteger(y) ->
              rational.isInteger(rational.mul(x, y))
            [using import(rational) isIntegerMul]
          @the-zero-power |
            qpower(a, peano.ZERO) = rational.ONE
            [using specialize qPowerZero(a)]
          @one-is-an-integer |
            rational.isInteger(rational.ONE)
            [using import(rational) oneIsAnInteger]
          @base-case |
            rational.isInteger(qpower(a, peano.ZERO))
            [by rewrite the-zero-power one-is-an-integer]

          @induction-step |
            fix k: peano.Nat {
              @given-inductive-hypothesis |
                assume rational.isInteger(qpower(a, k)) {
                  @inductive-hypothesis |
                    rational.isInteger(qpower(a, k))
                    [by hypothesis given-inductive-hypothesis]
                  @the-next-power |
                    qpower(a, peano.succ(k)) =
                      rational.mul(a, qpower(a, k))
                    [using specialize qPowerSucc(a, k)]
                  @the-product-is-an-integer |
                    rational.isInteger(rational.mul(a, qpower(a, k)))
                    [using specialize the-integer-products(a, qpower(a, k)) a-is-an-integer inductive-hypothesis]
                  @conclusion-the-step |
                    rational.isInteger(qpower(a, peano.succ(k)))
                    [by rewrite the-next-power the-product-is-an-integer]
                }
              @induction-step-at-k |
                rational.isInteger(qpower(a, k)) ->
                  rational.isInteger(qpower(a, peano.succ(k)))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: peano.Nat;
              rational.isInteger(qpower(a, k)) ->
              rational.isInteger(qpower(a, peano.succ(k)))
            [by generalize induction-step]
          @all-exponents |
            forall k: peano.Nat; rational.isInteger(qpower(a, k))
            [using instantiation peano.induction((fun z: peano.Nat => (rational.isInteger(qpower(a, z))))) base-case induction-step-for-all-k]
        }
      @integer-implies |
        rational.isInteger(a) ->
          (forall k: peano.Nat; rational.isInteger(qpower(a, k)))
        [by discharge given-a-is-an-integer]
    }
  @conclusion |
    forall a: Q;
      rational.isInteger(a) ->
      (forall k: peano.Nat; rational.isInteger(qpower(a, k)))
    [by generalize generalize-a]
qed

// -- SPLITTING THE CLEARED SUM AT EITHER END ------------------------------------------------
// 17.14 reads the cleared sum twice, from opposite ends. Every term but the first carries a
// factor r, and every term but the last carries a factor s, so:
//
//   S(k) = s^k·a_0 + r·t     for some integer t   (k >= 1)
//   S(k+1) = s·u + a_k·r^k   for some integer u
//
// The first is an induction on k; the second is just the defining clause regrouped.
theorem theClearedSumSplitsOffTheConstantTerm: forall p: QPoly;
  forall r, s: Q; forall k: peano.Nat;
  rational.isInteger(r) -> rational.isInteger(s) ->
  (forall i: peano.Nat; rational.isInteger(qcoeff(p, i))) ->
  (exists t: Q; rational.isInteger(t) and
  qclearedSum(p, r, s, peano.succ(k)) =
  rational.add(rational.mul(qpower(s, peano.succ(k)), qcoeff(p, peano.ZERO)),
  rational.mul(r, t)))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @given-the-integrality |
                assume rational.isInteger(r) and rational.isInteger(s) and
                  (forall i: peano.Nat;
                  rational.isInteger(qcoeff(p, i))) {
                  @the-integrality |
                    rational.isInteger(r) and rational.isInteger(s) and
                      (forall i: peano.Nat;
                      rational.isInteger(qcoeff(p, i)))
                    [by hypothesis given-the-integrality]
                  @r-is-an-integer |
                    rational.isInteger(r)
                    [using tautology the-integrality]
                  @s-is-an-integer |
                    rational.isInteger(s)
                    [using tautology the-integrality]
                  @the-coefficients-are-integers |
                    forall i: peano.Nat;
                      rational.isInteger(qcoeff(p, i))
                    [using tautology the-integrality]
                  @the-integer-products |
                    forall x, y: Q; rational.isInteger(x) ->
                      rational.isInteger(y) ->
                      rational.isInteger(rational.mul(x, y))
                    [using import(rational) isIntegerMul]
                  @the-integer-sums |
                    forall x, y: Q; rational.isInteger(x) ->
                      rational.isInteger(y) ->
                      rational.isInteger(rational.add(x, y))
                    [using import(rational) isIntegerAdd]

                  // base: S(1) = s·(0 + a_0·1) = s^1·a_0 + r·0
                  @the-empty-cleared-sum |
                    qclearedSum(p, r, s, peano.ZERO) = ZERO
                    [using specialize qClearedSumZero(p, r, s)]
                  @the-first-cleared-sum |
                    qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.mul(s, rational.add(
                      qclearedSum(p, r, s, peano.ZERO),
                      rational.mul(qcoeff(p, peano.ZERO),
                      qpower(r, peano.ZERO))))
                    [using specialize qClearedSumSucc(p, r, s, peano.ZERO)]
                  @the-zero-power-of-r |
                    qpower(r, peano.ZERO) = rational.ONE
                    [using specialize qPowerZero(r)]
                  @the-first-cleared-sum-expanded |
                    qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.mul(s, rational.add(ZERO,
                      rational.mul(qcoeff(p, peano.ZERO),
                      rational.ONE)))
                    [using simplify the-first-cleared-sum the-empty-cleared-sum the-zero-power-of-r]
                  @the-first-power-of-s |
                    qpower(s, peano.succ(peano.ZERO)) =
                      rational.mul(s, qpower(s, peano.ZERO))
                    [using specialize qPowerSucc(s, peano.ZERO)]
                  @the-zero-power-of-s |
                    qpower(s, peano.ZERO) = rational.ONE
                    [using specialize qPowerZero(s)]
                  @the-first-power-of-s-expanded |
                    qpower(s, peano.succ(peano.ZERO)) =
                      rational.mul(s, rational.ONE)
                    [using simplify the-first-power-of-s the-zero-power-of-s]
                  // r·0 = 0, so the remainder slot takes the witness 0
                  @r-times-zero |
                    rational.mul(r, ZERO) = ZERO
                    [using specialize rational.mulZeroRight(r)]
                  // collapse the right side's own zero first: s·(0 + a_0·1) = s·a_0
                  @s-times-zero |
                    rational.mul(s, ZERO) = ZERO
                    [using specialize rational.mulZeroRight(s)]
                  @the-right-side-collapses |
                    rational.mul(s, rational.add(ZERO,
                      rational.mul(qcoeff(p, peano.ZERO),
                      rational.ONE))) =
                      rational.add(rational.mul(s, ZERO),
                      rational.mul(s, qcoeff(p, peano.ZERO)))
                    [using polynomial(rational)]
                  @the-right-side-without-zero |
                    rational.mul(s, rational.add(ZERO,
                      rational.mul(qcoeff(p, peano.ZERO),
                      rational.ONE))) =
                      rational.add(ZERO,
                      rational.mul(s, qcoeff(p, peano.ZERO)))
                    [by rewrite s-times-zero the-right-side-collapses]
                  @the-base-target-without-r |
                    rational.add(rational.mul(
                      rational.mul(s, rational.ONE),
                      qcoeff(p, peano.ZERO)), ZERO) =
                      rational.add(ZERO,
                      rational.mul(s, qcoeff(p, peano.ZERO)))
                    [using polynomial(rational)]
                  @the-base-target-through-the-right |
                    rational.add(rational.mul(
                      rational.mul(s, rational.ONE),
                      qcoeff(p, peano.ZERO)), ZERO) =
                      rational.mul(s, rational.add(ZERO,
                      rational.mul(qcoeff(p, peano.ZERO),
                      rational.ONE)))
                    [by rewrite the-right-side-without-zero the-base-target-without-r]
                  @the-base-target |
                    rational.add(rational.mul(
                      rational.mul(s, rational.ONE),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, ZERO)) =
                      rational.mul(s, rational.add(ZERO,
                      rational.mul(qcoeff(p, peano.ZERO),
                      rational.ONE)))
                    [by rewrite r-times-zero the-base-target-through-the-right]
                  @the-base-equation |
                    qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.add(rational.mul(
                      rational.mul(s, rational.ONE),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, ZERO))
                    [by rewrite the-base-target the-first-cleared-sum-expanded]
                  @the-base-equation-in-the-power |
                    qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(peano.ZERO)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, ZERO))
                    [by rewrite the-first-power-of-s-expanded the-base-equation]
                  @zero-is-an-integer |
                    rational.isInteger(ZERO)
                    [using import(rational) zeroIsAnInteger]
                  @the-base-witness-works |
                    rational.isInteger(ZERO) and
                      qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(peano.ZERO)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, ZERO))
                    [by both zero-is-an-integer the-base-equation-in-the-power]
                  @base-case |
                    exists t: Q; rational.isInteger(t) and
                      qclearedSum(p, r, s, peano.succ(peano.ZERO)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(peano.ZERO)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t))
                    [by witness(ZERO) the-base-witness-works]

                  // step: S(k+2) = s·(S(k+1) + a_{k+1}·r^{k+1})
                  //              = s^{k+2}·a_0 + r·(s·(t + a_{k+1}·r^k))
                  @induction-step |
                    fix k: peano.Nat {
                      @given-inductive-hypothesis |
                        assume exists t: Q; rational.isInteger(t) and
                          qclearedSum(p, r, s, peano.succ(k)) =
                          rational.add(rational.mul(
                          qpower(s, peano.succ(k)),
                          qcoeff(p, peano.ZERO)),
                          rational.mul(r, t)) {
                          @inductive-hypothesis |
                            exists t: Q; rational.isInteger(t) and
                              qclearedSum(p, r, s, peano.succ(k)) =
                              rational.add(rational.mul(
                              qpower(s, peano.succ(k)),
                              qcoeff(p, peano.ZERO)),
                              rational.mul(r, t))
                            [by hypothesis given-inductive-hypothesis]
                          @conclusion-the-step |
                            unpack t: Q from inductive-hypothesis {
                              @the-split-at-k |
                                rational.isInteger(t) and
                                  qclearedSum(p, r, s, peano.succ(k)) =
                                  rational.add(rational.mul(
                                  qpower(s, peano.succ(k)),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t))
                                [by hypothesis conclusion-the-step]
                              @t-is-an-integer |
                                rational.isInteger(t)
                                [by and_lhs the-split-at-k]
                              @the-sum-at-k |
                                qclearedSum(p, r, s, peano.succ(k)) =
                                  rational.add(rational.mul(
                                  qpower(s, peano.succ(k)),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t))
                                [by and_rhs the-split-at-k]
                              @the-next-sum |
                                qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.mul(s, rational.add(
                                  qclearedSum(p, r, s, peano.succ(k)),
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, peano.succ(k)))))
                                [using specialize qClearedSumSucc(p, r, s, peano.succ(k))]
                              @the-next-sum-expanded |
                                qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.mul(s, rational.add(
                                  rational.add(rational.mul(
                                  qpower(s, peano.succ(k)),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t)),
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, peano.succ(k)))))
                                [by rewrite the-sum-at-k the-next-sum]
                              // r^{k+1} = r·r^k, so the last term carries r
                              @the-next-power-of-r |
                                qpower(r, peano.succ(k)) =
                                  rational.mul(r, qpower(r, k))
                                [using specialize qPowerSucc(r, k)]
                              @the-next-sum-with-r-pulled |
                                qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.mul(s, rational.add(
                                  rational.add(rational.mul(
                                  qpower(s, peano.succ(k)),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t)),
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  rational.mul(r, qpower(r, k)))))
                                [by rewrite the-next-power-of-r the-next-sum-expanded]
                              // regroup: s^{k+2}·a_0 + r·(s·(t + a_{k+1}·r^k))
                              @the-next-power-of-s |
                                qpower(s, peano.succ(peano.succ(k))) =
                                  rational.mul(s,
                                  qpower(s, peano.succ(k)))
                                [using specialize qPowerSucc(s, peano.succ(k))]
                              @the-regrouping |
                                rational.mul(s, rational.add(
                                  rational.add(rational.mul(
                                  qpower(s, peano.succ(k)),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t)),
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  rational.mul(r, qpower(r, k))))) =
                                  rational.add(rational.mul(
                                  rational.mul(s,
                                  qpower(s, peano.succ(k))),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r,
                                  rational.mul(s, rational.add(t,
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))))
                                [using polynomial(rational)]
                              @the-next-sum-regrouped |
                                qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.add(rational.mul(
                                  rational.mul(s,
                                  qpower(s, peano.succ(k))),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r,
                                  rational.mul(s, rational.add(t,
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))))
                                [by rewrite the-regrouping the-next-sum-with-r-pulled]
                              @the-next-sum-in-the-power |
                                qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.add(rational.mul(
                                  qpower(s,
                                  peano.succ(peano.succ(k))),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r,
                                  rational.mul(s, rational.add(t,
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))))
                                [by rewrite the-next-power-of-s the-next-sum-regrouped]
                              // the new witness is an integer
                              @the-powers-of-r-are-integers |
                                forall j: peano.Nat;
                                  rational.isInteger(qpower(r, j))
                                [using specialize everyPowerOfAnIntegerIsAnInteger(r) r-is-an-integer]
                              @the-k-th-power-is-an-integer |
                                rational.isInteger(qpower(r, k))
                                [using specialize the-powers-of-r-are-integers(k)]
                              @the-next-coefficient-is-an-integer |
                                rational.isInteger(
                                  qcoeff(p, peano.succ(k)))
                                [using specialize the-coefficients-are-integers(peano.succ(k))]
                              @the-new-term-is-an-integer |
                                rational.isInteger(rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k)))
                                [using specialize the-integer-products(qcoeff(p, peano.succ(k)), qpower(r, k)) the-next-coefficient-is-an-integer the-k-th-power-is-an-integer]
                              @the-new-sum-is-an-integer |
                                rational.isInteger(rational.add(t,
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))
                                [using specialize the-integer-sums(t, rational.mul(qcoeff(p, peano.succ(k)), qpower(r, k))) t-is-an-integer the-new-term-is-an-integer]
                              @the-new-witness-is-an-integer |
                                rational.isInteger(rational.mul(s,
                                  rational.add(t, rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k)))))
                                [using specialize the-integer-products(s, rational.add(t, rational.mul(qcoeff(p, peano.succ(k)), qpower(r, k)))) s-is-an-integer the-new-sum-is-an-integer]
                              @the-new-witness-works |
                                rational.isInteger(rational.mul(s,
                                  rational.add(t, rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))) and
                                  qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.add(rational.mul(
                                  qpower(s,
                                  peano.succ(peano.succ(k))),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r,
                                  rational.mul(s, rational.add(t,
                                  rational.mul(
                                  qcoeff(p, peano.succ(k)),
                                  qpower(r, k))))))
                                [by both the-new-witness-is-an-integer the-next-sum-in-the-power]
                              @conclusion-extended |
                                exists t2: Q; rational.isInteger(t2) and
                                  qclearedSum(p, r, s,
                                  peano.succ(peano.succ(k))) =
                                  rational.add(rational.mul(
                                  qpower(s,
                                  peano.succ(peano.succ(k))),
                                  qcoeff(p, peano.ZERO)),
                                  rational.mul(r, t2))
                                [by witness(rational.mul(s, rational.add(t, rational.mul(qcoeff(p, peano.succ(k)), qpower(r, k))))) the-new-witness-works]
                            }
                          @the-step-exported |
                            exists t2: Q; rational.isInteger(t2) and
                              qclearedSum(p, r, s,
                              peano.succ(peano.succ(k))) =
                              rational.add(rational.mul(
                              qpower(s, peano.succ(peano.succ(k))),
                              qcoeff(p, peano.ZERO)),
                              rational.mul(r, t2))
                            [by unpacked conclusion-the-step]
                        }
                      @induction-step-at-k |
                        (exists t: Q; rational.isInteger(t) and
                          qclearedSum(p, r, s, peano.succ(k)) =
                          rational.add(rational.mul(
                          qpower(s, peano.succ(k)),
                          qcoeff(p, peano.ZERO)),
                          rational.mul(r, t))) ->
                          (exists t2: Q; rational.isInteger(t2) and
                          qclearedSum(p, r, s,
                          peano.succ(peano.succ(k))) =
                          rational.add(rational.mul(
                          qpower(s, peano.succ(peano.succ(k))),
                          qcoeff(p, peano.ZERO)),
                          rational.mul(r, t2)))
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-for-all-k |
                    forall k: peano.Nat;
                      (exists t: Q; rational.isInteger(t) and
                      qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(k)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t))) ->
                      (exists t2: Q; rational.isInteger(t2) and
                      qclearedSum(p, r, s,
                      peano.succ(peano.succ(k))) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(peano.succ(k))),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t2)))
                    [by generalize induction-step]
                  @all-bounds |
                    forall k: peano.Nat;
                      exists t: Q; rational.isInteger(t) and
                      qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(k)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t))
                    [using instantiation peano.induction((fun z: peano.Nat => (exists t: Q; rational.isInteger(t) and qclearedSum(p, r, s, peano.succ(z)) = rational.add(rational.mul(qpower(s, peano.succ(z)), qcoeff(p, peano.ZERO)), rational.mul(r, t))))) base-case induction-step-for-all-k]
                }
              @the-integrality-implies |
                (rational.isInteger(r) and rational.isInteger(s) and
                  (forall i: peano.Nat;
                  rational.isInteger(qcoeff(p, i)))) ->
                  (forall k: peano.Nat;
                  exists t: Q; rational.isInteger(t) and
                  qclearedSum(p, r, s, peano.succ(k)) =
                  rational.add(rational.mul(
                  qpower(s, peano.succ(k)),
                  qcoeff(p, peano.ZERO)),
                  rational.mul(r, t)))
                [by discharge given-the-integrality]
              // move the bound binder outside the implication
              @each-bound |
                fix k: peano.Nat {
                  @given-the-integrality-again |
                    assume rational.isInteger(r) and
                      rational.isInteger(s) and
                      (forall i: peano.Nat;
                      rational.isInteger(qcoeff(p, i))) {
                      @the-integrality-again |
                        rational.isInteger(r) and
                          rational.isInteger(s) and
                          (forall i: peano.Nat;
                          rational.isInteger(qcoeff(p, i)))
                        [by hypothesis given-the-integrality-again]
                      @all-bounds-here |
                        forall k2: peano.Nat;
                          exists t: Q; rational.isInteger(t) and
                          qclearedSum(p, r, s, peano.succ(k2)) =
                          rational.add(rational.mul(
                          qpower(s, peano.succ(k2)),
                          qcoeff(p, peano.ZERO)),
                          rational.mul(r, t))
                        [by modus_ponens the-integrality-implies the-integrality-again]
                      @conclusion-at-k |
                        exists t: Q; rational.isInteger(t) and
                          qclearedSum(p, r, s, peano.succ(k)) =
                          rational.add(rational.mul(
                          qpower(s, peano.succ(k)),
                          qcoeff(p, peano.ZERO)),
                          rational.mul(r, t))
                        [using specialize all-bounds-here(k)]
                    }
                  @the-implication-at-k |
                    (rational.isInteger(r) and rational.isInteger(s) and
                      (forall i: peano.Nat;
                      rational.isInteger(qcoeff(p, i)))) ->
                      (exists t: Q; rational.isInteger(t) and
                      qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(k)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t)))
                    [by discharge given-the-integrality-again]
                  @curried-at-k |
                    rational.isInteger(r) -> rational.isInteger(s) ->
                      (forall i: peano.Nat;
                      rational.isInteger(qcoeff(p, i))) ->
                      (exists t: Q; rational.isInteger(t) and
                      qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(
                      qpower(s, peano.succ(k)),
                      qcoeff(p, peano.ZERO)),
                      rational.mul(r, t)))
                    [using tautology the-implication-at-k]
                }
              @discharge-s |
                forall k: peano.Nat;
                  rational.isInteger(r) -> rational.isInteger(s) ->
                  (forall i: peano.Nat;
                  rational.isInteger(qcoeff(p, i))) ->
                  (exists t: Q; rational.isInteger(t) and
                  qclearedSum(p, r, s, peano.succ(k)) =
                  rational.add(rational.mul(
                  qpower(s, peano.succ(k)),
                  qcoeff(p, peano.ZERO)),
                  rational.mul(r, t)))
                [by generalize each-bound]
            }
          @discharge-r |
            forall s9: Q; forall k: peano.Nat;
              rational.isInteger(r) -> rational.isInteger(s9) ->
              (forall i: peano.Nat;
              rational.isInteger(qcoeff(p, i))) ->
              (exists t: Q; rational.isInteger(t) and
              qclearedSum(p, r, s9, peano.succ(k)) =
              rational.add(rational.mul(
              qpower(s9, peano.succ(k)),
              qcoeff(p, peano.ZERO)),
              rational.mul(r, t)))
            [by generalize generalize-s]
        }
      @discharge-p |
        forall r9, s9: Q; forall k: peano.Nat;
          rational.isInteger(r9) -> rational.isInteger(s9) ->
          (forall i: peano.Nat; rational.isInteger(qcoeff(p, i))) ->
          (exists t: Q; rational.isInteger(t) and
          qclearedSum(p, r9, s9, peano.succ(k)) =
          rational.add(rational.mul(
          qpower(s9, peano.succ(k)),
          qcoeff(p, peano.ZERO)),
          rational.mul(r9, t)))
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
      rational.isInteger(r) -> rational.isInteger(s) ->
      (forall i: peano.Nat; rational.isInteger(qcoeff(p, i))) ->
      (exists t: Q; rational.isInteger(t) and
      qclearedSum(p, r, s, peano.succ(k)) =
      rational.add(rational.mul(qpower(s, peano.succ(k)),
      qcoeff(p, peano.ZERO)),
      rational.mul(r, t)))
    [by generalize generalize-p]
qed

// The other end: the defining clause already puts every term but the last under a factor s.
theorem theClearedSumSplitsOffTheLeadingTerm: forall p: QPoly;
  forall r, s: Q; forall k: peano.Nat;
  (exists u: Q;
  qclearedSum(p, r, s, peano.succ(k)) =
  rational.add(rational.mul(s, u),
  rational.mul(s, rational.mul(qcoeff(p, k), qpower(r, k)))))
proof
  @generalize-p |
    fix p: QPoly {
      @generalize-r |
        fix r: Q {
          @generalize-s |
            fix s: Q {
              @generalize-k |
                fix k: peano.Nat {
                  @the-defining-clause |
                    qclearedSum(p, r, s, peano.succ(k)) =
                      rational.mul(s, rational.add(
                      qclearedSum(p, r, s, k),
                      rational.mul(qcoeff(p, k), qpower(r, k))))
                    [using specialize qClearedSumSucc(p, r, s, k)]
                  @the-distribution |
                    rational.mul(s, rational.add(
                      qclearedSum(p, r, s, k),
                      rational.mul(qcoeff(p, k), qpower(r, k)))) =
                      rational.add(rational.mul(s,
                      qclearedSum(p, r, s, k)),
                      rational.mul(s, rational.mul(qcoeff(p, k),
                      qpower(r, k))))
                    [using polynomial(rational)]
                  @the-split |
                    qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(s,
                      qclearedSum(p, r, s, k)),
                      rational.mul(s, rational.mul(qcoeff(p, k),
                      qpower(r, k))))
                    [by rewrite the-distribution the-defining-clause]
                  @conclusion-at-k |
                    exists u: Q;
                      qclearedSum(p, r, s, peano.succ(k)) =
                      rational.add(rational.mul(s, u),
                      rational.mul(s, rational.mul(qcoeff(p, k),
                      qpower(r, k))))
                    [by witness(qclearedSum(p, r, s, k)) the-split]
                }
              @discharge-k |
                forall k: peano.Nat;
                  (exists u: Q;
                  qclearedSum(p, r, s, peano.succ(k)) =
                  rational.add(rational.mul(s, u),
                  rational.mul(s, rational.mul(qcoeff(p, k),
                  qpower(r, k)))))
                [by generalize generalize-k]
            }
          @discharge-s |
            forall s9: Q; forall k: peano.Nat;
              (exists u: Q;
              qclearedSum(p, r, s9, peano.succ(k)) =
              rational.add(rational.mul(s9, u),
              rational.mul(s9, rational.mul(qcoeff(p, k),
              qpower(r, k)))))
            [by generalize generalize-s]
        }
      @discharge-r |
        forall r9, s9: Q; forall k: peano.Nat;
          (exists u: Q;
          qclearedSum(p, r9, s9, peano.succ(k)) =
          rational.add(rational.mul(s9, u),
          rational.mul(s9, rational.mul(qcoeff(p, k),
          qpower(r9, k)))))
        [by generalize generalize-r]
    }
  @conclusion |
    forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
      (exists u: Q;
      qclearedSum(p, r, s, peano.succ(k)) =
      rational.add(rational.mul(s, u),
      rational.mul(s, rational.mul(qcoeff(p, k), qpower(r, k)))))
    [by generalize generalize-p]
qed

// -- THE TRIPLE-PRODUCT HELPERS, FOR THE ASSOCIATIVITY TRANSFER ----------------------------
// `std/field/polynomial-associativity.b4m` proves `polyMulIsAssociative` by re-proving
// Judson's double-sum exchange at the concrete triple family, and it inducts on five helper
// funcs of its own. A transfer RE-CHECKS the source proof, so ℚ[x] must declare each of them
// with its defining clauses, exactly as it already does for `qtailConvolution` and `qsegment`.
//
// That file uses nothing field-specific — `--axioms` on `polyMulIsAssociative` shows six
// `std/field.b4m` axioms and every one is a RING axiom — so the development would sit more
// honestly in `std/ring/polynomial*.b4m`. Moving it is queue item 5's territory; declaring the
// helpers here is the cheap route to the same result, and it is the route the corpus already
// takes for the convolution helpers.
// The index arithmetic, NAMED rather than subtracted — the ring proof carries a term's three
// exponents and computes the cofactor index with these, so nothing here writes
// `sub(sub(i,j),k)` and nothing owes a subtraction guard.
oper qtheGapTo(i: Nat, j: Nat) => Nat:
  qtheGapTo(i, NAT_ZERO) = i;
  qtheGapTo(peano.succ(i), peano.succ(j)) = qtheGapTo(i, j)

oper qtheCofactorIndex(i: Nat, j: Nat, k: Nat) => Nat:
  qtheCofactorIndex(i, j, NAT_ZERO) = qtheGapTo(i, j);
  qtheCofactorIndex(i, j, peano.succ(k)) = qtheGapTo(qtheGapTo(i, j), peano.succ(k))

oper qcappedRun(q: QPoly, r: QPoly, g: Nat, n: Nat) => Q:
  qcappedRun(q, r, g, NAT_ZERO) = ZERO;
  qcappedRun(q, r, g, peano.succ(n)) = rational.add(qcappedRun(q, r, g, n), rational.mul(qcoeff(q, n), qcoeff(r, qtheGapTo(g, n))))

oper qtripleTerm(p: QPoly, q: QPoly, r: QPoly, i: Nat, j: Nat, k: Nat) => Q:
  qtripleTerm(p, q, r, i, j, k) = rational.mul(rational.mul(qcoeff(p, j), qcoeff(q, k)), qcoeff(r, qtheCofactorIndex(i, j, k)))

oper qtripleRow(p: QPoly, q: QPoly, r: QPoly, i: Nat, j: Nat, n: Nat) => Q:
  qtripleRow(p, q, r, i, j, NAT_ZERO) = ZERO;
  qtripleRow(p, q, r, i, j, peano.succ(n)) = rational.add(qtripleRow(p, q, r, i, j, n), qtripleTerm(p, q, r, i, j, n))

oper qtripleDiag(p: QPoly, q: QPoly, r: QPoly, i: Nat, m: Nat, c: Nat) => Q:
  qtripleDiag(p, q, r, i, m, NAT_ZERO) = ZERO;
  qtripleDiag(p, q, r, i, m, peano.succ(c)) = rational.add(qtripleDiag(p, q, r, i, m, c), qtripleTerm(p, q, r, i, c, qtheGapTo(m, c)))

oper qtripleTri(p: QPoly, q: QPoly, r: QPoly, i: Nat, n: Nat) => Q:
  qtripleTri(p, q, r, i, NAT_ZERO) = ZERO;
  qtripleTri(p, q, r, i, peano.succ(n)) = rational.add(qtripleTri(p, q, r, i, n), qtripleDiag(p, q, r, i, n, peano.succ(n)))

oper qtripleRows(p: QPoly, q: QPoly, r: QPoly, i: Nat, m: Nat, n: Nat) => Q:
  qtripleRows(p, q, r, i, NAT_ZERO, n) = ZERO;
  qtripleRows(p, q, r, i, peano.succ(m), n) = rational.add(qtripleRows(p, q, r, i, m, n), qtripleRow(p, q, r, i, m, qtheGapTo(n, m)))

// ℚ[x]'s associativity. TRANSFERRED straight from the ring layer: `ring_poly` proves
// `polyMulIsAssociative` over the triple-sum families, and `RationalPolynomialsOverARing`
// already maps ℚ[x] onto them — so the bespoke model this once needed (and the separate F[x]
// associativity file it transferred from) are both retired.
theorem qMulIsAssociative: forall p, q, r: QPoly;
  qmulP(qmulP(p, q), r) = qmulP(p, qmulP(q, r))
proof
  @conclusion |
    forall p, q, r: QPoly;
      qmulP(qmulP(p, q), r) = qmulP(p, qmulP(q, r))
    [using model(RationalPolynomialsOverARing) ring_poly.polyMulIsAssociative]
qed

// -- COMBINING TWO CONSTANT SCALINGS -------------------------------------------------------
// Two constant monomials multiply to the constant monomial of the product. Coefficientwise
// via the scaling law: the left scaling pulls `c` out, and what remains is `d`'s own
// monomial coefficient, so both sides read `mul(c, qcoeff(qmonomial(d, 0), i))`.
theorem theConstantMonomialProductAgreesCoefficientwise: forall c, d: Q; forall i: Nat;
  qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
  qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
proof
  @generalize-c |
    fix c: Q {
      @generalize-d |
        fix d: Q {
          @generalize-i |
            fix i: Nat {
              @the-left-scaling |
                qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
                  rational.mul(c, qcoeff(qmonomial(d, NAT_ZERO), i))
                [using specialize
                  scalingByAConstantScalesTheCoefficients(qmonomial(d, NAT_ZERO), c, i)]
              @the-index-is-zero-or-not |
                i = NAT_ZERO or (not (i = NAT_ZERO))
                [using tautology]
              @the-coefficients-agree |
                qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
                  qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
                [by common_conclusion the-index-is-zero-or-not
                  when-the-index-is-zero when-the-index-is-elsewhere]
              @when-the-index-is-zero |
                assume i = NAT_ZERO {
                  @the-index |
                    i = NAT_ZERO
                    [by hypothesis when-the-index-is-zero]
                  @the-inner-coefficient-is-d |
                    qcoeff(qmonomial(d, NAT_ZERO), NAT_ZERO) = d
                    [using specialize qMonomialCoeffAtItsIndex(d, NAT_ZERO)]
                  @the-outer-coefficient-is-the-product |
                    qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), NAT_ZERO) =
                      rational.mul(c, d)
                    [using specialize qMonomialCoeffAtItsIndex(rational.mul(c, d), NAT_ZERO)]
                  @the-scaling-at-zero |
                    qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), NAT_ZERO) =
                      rational.mul(c, qcoeff(qmonomial(d, NAT_ZERO), NAT_ZERO))
                    [by rewrite the-index the-left-scaling]
                  @conclusion-the-coefficients-agree-at-zero |
                    qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
                      qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
                    [using simplify the-index the-scaling-at-zero
                      the-inner-coefficient-is-d the-outer-coefficient-is-the-product]
                }
              @when-the-index-is-elsewhere |
                assume not (i = NAT_ZERO) {
                  @the-index-misses |
                    not (i = NAT_ZERO)
                    [by hypothesis when-the-index-is-elsewhere]
                  @the-inner-coefficient-vanishes |
                    qcoeff(qmonomial(d, NAT_ZERO), i) = ZERO
                    [using specialize qMonomialCoeffElsewhere(d, NAT_ZERO, i) the-index-misses]
                  @the-outer-coefficient-vanishes |
                    qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i) = ZERO
                    [using specialize
                      qMonomialCoeffElsewhere(rational.mul(c, d), NAT_ZERO, i) the-index-misses]
                  @the-scaled-zero-is-zero |
                    rational.mul(c, ZERO) = ZERO
                    [using specialize rational.mulZeroRight(c)]
                  @conclusion-the-coefficients-agree-elsewhere |
                    qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
                      qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
                    [using simplify the-left-scaling the-inner-coefficient-vanishes
                      the-scaled-zero-is-zero the-outer-coefficient-vanishes]
                }
            }
          @conclusion-for-all-i |
            forall i: Nat;
              qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
              qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
            [by generalize generalize-i]
        }
      @conclusion-for-all-d |
        forall d: Q; forall i: Nat;
          qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
          qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
        [by generalize generalize-d]
    }
  @conclusion |
    forall c, d: Q; forall i: Nat;
      qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
      qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
    [by generalize generalize-c]
qed

// Hence the monomials themselves are equal, by extensionality.
theorem theProductOfConstantMonomials: forall c, d: Q;
  qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)) =
  qmonomial(rational.mul(c, d), NAT_ZERO)
proof
  @generalize-c |
    fix c: Q {
      @generalize-d |
        fix d: Q {
          @the-coefficients-agree |
            forall i: Nat;
              qcoeff(qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)), i) =
              qcoeff(qmonomial(rational.mul(c, d), NAT_ZERO), i)
            [using specialize theConstantMonomialProductAgreesCoefficientwise(c, d)]
          @conclusion-the-monomials-are-equal |
            qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)) =
              qmonomial(rational.mul(c, d), NAT_ZERO)
            [using specialize qPolyExtensionality(
              qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)),
              qmonomial(rational.mul(c, d), NAT_ZERO)) the-coefficients-agree]
        }
      @conclusion-for-all-d |
        forall d: Q;
          qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)) =
          qmonomial(rational.mul(c, d), NAT_ZERO)
        [by generalize generalize-d]
    }
  @conclusion |
    forall c, d: Q;
      qmulP(qmonomial(c, NAT_ZERO), qmonomial(d, NAT_ZERO)) =
      qmonomial(rational.mul(c, d), NAT_ZERO)
    [by generalize generalize-c]
qed

// -- A NONZERO SCALING REFLECTS A DEGREE BOUND ----------------------------------------------
// Coefficientwise first: above the bound the scaled coefficient is ZERO, and
// `mul(c, qcoeff(q, i)) = ZERO` with `c != ZERO` forces `qcoeff(q, i) = ZERO` by
// `noZeroDivisors`.
theorem aNonzeroScalingReflectsTheVanishing: forall q: QPoly; forall c: Q; forall n: Nat;
  (not (c = ZERO)) ->
  (forall i: Nat; peano.less_than(n, i) ->
  qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
  (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
proof
  @generalize-q |
    fix q: QPoly {
      @generalize-c |
        fix c: Q {
          @generalize-n |
            fix n: Nat {
              @given-the-scalar-is-nonzero |
                assume not (c = ZERO) {
                  @the-scalar-is-nonzero |
                    not (c = ZERO)
                    [by hypothesis given-the-scalar-is-nonzero]
                  @given-the-scaled-vanishing |
                    assume forall i: Nat; peano.less_than(n, i) ->
                      qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO {
                      @the-scaled-coefficients-vanish |
                        forall i: Nat; peano.less_than(n, i) ->
                          qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO
                        [by hypothesis given-the-scaled-vanishing]
                      @generalize-i |
                        fix i: Nat {
                          @given-above-the-bound |
                            assume peano.less_than(n, i) {
                              @above-the-bound |
                                peano.less_than(n, i)
                                [by hypothesis given-above-the-bound]
                              @the-scaled-coefficient-vanishes |
                                qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO
                                [using specialize
                                  the-scaled-coefficients-vanish(i) above-the-bound]
                              @the-scaling-law |
                                qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) =
                                  rational.mul(c, qcoeff(q, i))
                                [using specialize
                                  scalingByAConstantScalesTheCoefficients(q, c, i)]
                              @the-product-vanishes |
                                rational.mul(c, qcoeff(q, i)) = ZERO
                                [by rewrite the-scaling-law the-scaled-coefficient-vanishes]
                              @one-factor-vanishes |
                                c = ZERO or qcoeff(q, i) = ZERO
                                [using specialize rational.noZeroDivisors(
                                  c, qcoeff(q, i)) the-product-vanishes]
                              @conclusion-the-coefficient-vanishes |
                                qcoeff(q, i) = ZERO
                                [using tautology one-factor-vanishes the-scalar-is-nonzero]
                            }
                          @conclusion-above-the-bound-it-vanishes |
                            peano.less_than(n, i) -> qcoeff(q, i) = ZERO
                            [by discharge given-above-the-bound]
                        }
                      @conclusion-the-coefficients-vanish |
                        forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO
                        [by generalize generalize-i]
                    }
                  @conclusion-the-scaled-vanishing-gives-it |
                    (forall i: Nat; peano.less_than(n, i) ->
                      qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
                      (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
                    [by discharge given-the-scaled-vanishing]
                }
              @conclusion-nonzero-gives-it |
                (not (c = ZERO)) ->
                  (forall i: Nat; peano.less_than(n, i) ->
                  qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
                  (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
                [by discharge given-the-scalar-is-nonzero]
            }
          @conclusion-for-all-n |
            forall n: Nat;
              (not (c = ZERO)) ->
              (forall i: Nat; peano.less_than(n, i) ->
              qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
              (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
            [by generalize generalize-n]
        }
      @conclusion-for-all-c |
        forall c: Q; forall n: Nat;
          (not (c = ZERO)) ->
          (forall i: Nat; peano.less_than(n, i) ->
          qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
          (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
        [by generalize generalize-c]
    }
  @conclusion |
    forall q: QPoly; forall c: Q; forall n: Nat;
      (not (c = ZERO)) ->
      (forall i: Nat; peano.less_than(n, i) ->
      qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO) ->
      (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
    [by generalize generalize-q]
qed

// Hence the degree bound itself transfers, unfolding `qdegreeAtMost` on both sides.
//
// This is the converse direction a factorization argument needs: Lemma 17.12 hands back a
// primitive part with INTEGER COEFFICIENTS UP TO A BOUND but no degree bound of its own, and
// the bound has to be recovered from the scaling equation.
theorem aNonzeroScalingReflectsTheDegreeBound: forall q: QPoly; forall c: Q; forall n: Nat;
  (not (c = ZERO)) ->
  qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
  qdegreeAtMost(q, n)
proof
  @generalize-q |
    fix q: QPoly {
      @generalize-c |
        fix c: Q {
          @generalize-n |
            fix n: Nat {
              @given-the-scalar-is-nonzero |
                assume not (c = ZERO) {
                  @the-scalar-is-nonzero |
                    not (c = ZERO)
                    [by hypothesis given-the-scalar-is-nonzero]
                  @given-the-scaled-bound |
                    assume qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) {
                      @the-scaled-bound |
                        qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n)
                        [by hypothesis given-the-scaled-bound]
                      @the-scaled-bound-unfolds |
                        qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) iff
                          (forall i: Nat; peano.less_than(n, i) ->
                          qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO)
                        [using specialize qDegreeAtMostMeaning(
                          qmulP(qmonomial(c, NAT_ZERO), q), n)]
                      @the-scaled-bound-forward |
                        qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
                          (forall i: Nat; peano.less_than(n, i) ->
                          qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO)
                        [by equiv_forward the-scaled-bound-unfolds]
                      @the-scaled-coefficients-vanish |
                        forall i: Nat; peano.less_than(n, i) ->
                          qcoeff(qmulP(qmonomial(c, NAT_ZERO), q), i) = ZERO
                        [by modus_ponens the-scaled-bound-forward the-scaled-bound]
                      @the-coefficients-vanish |
                        forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO
                        [using specialize aNonzeroScalingReflectsTheVanishing(q, c, n)
                          the-scalar-is-nonzero the-scaled-coefficients-vanish]
                      @the-bound-unfolds |
                        qdegreeAtMost(q, n) iff
                          (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO)
                        [using specialize qDegreeAtMostMeaning(q, n)]
                      @the-bound-backward |
                        (forall i: Nat; peano.less_than(n, i) -> qcoeff(q, i) = ZERO) ->
                          qdegreeAtMost(q, n)
                        [by equiv_converse the-bound-unfolds]
                      @conclusion-the-bound-holds |
                        qdegreeAtMost(q, n)
                        [by modus_ponens the-bound-backward the-coefficients-vanish]
                    }
                  @conclusion-the-scaled-bound-gives-it |
                    qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
                      qdegreeAtMost(q, n)
                    [by discharge given-the-scaled-bound]
                }
              @conclusion-nonzero-gives-it |
                (not (c = ZERO)) ->
                  qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
                  qdegreeAtMost(q, n)
                [by discharge given-the-scalar-is-nonzero]
            }
          @conclusion-for-all-n |
            forall n: Nat;
              (not (c = ZERO)) ->
              qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
              qdegreeAtMost(q, n)
            [by generalize generalize-n]
        }
      @conclusion-for-all-c |
        forall c: Q; forall n: Nat;
          (not (c = ZERO)) ->
          qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
          qdegreeAtMost(q, n)
        [by generalize generalize-c]
    }
  @conclusion |
    forall q: QPoly; forall c: Q; forall n: Nat;
      (not (c = ZERO)) ->
      qdegreeAtMost(qmulP(qmonomial(c, NAT_ZERO), q), n) ->
      qdegreeAtMost(q, n)
    [by generalize generalize-q]
qed

// -- definition-clause shims ---------------------------------------------------------------
//
// The symbols above are DEFINITION BLOCKS, so `--axioms` reports their clauses as
// definitions rather than as assumptions to weigh. A clause has no user-facing name,
// though, and a model's `<-` and `specialize` both resolve BY NAME — so each clause keeps a
// one-line theorem under the name it had as an axiom. These add no assumption: every one is
// proved `[by definition(N) <symbol>]`.

theorem qAddPolyCoeff:
  forall p, q: QPoly; forall i: Nat;
  qcoeff(qaddP(p, q), i) = rational.add(qcoeff(p, i), qcoeff(q, i))
proof
  @conclusion |
    forall p, q: QPoly; forall i: Nat;
      qcoeff(qaddP(p, q), i) = rational.add(qcoeff(p, i), qcoeff(q, i))
    [by definition qaddP]
qed

theorem qNegPolyCoeff:
  forall p: QPoly; forall i: Nat;
  qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
proof
  @conclusion |
    forall p: QPoly; forall i: Nat;
      qcoeff(qnegP(p), i) = rational.neg(qcoeff(p, i))
    [by definition qnegP]
qed

theorem qMulPolyCoeff:
  forall p, q: QPoly; forall i: Nat;
  qcoeff(qmulP(p, q), i) = qconvolution(p, q, NAT_ZERO, i)
proof
  @conclusion |
    forall p, q: QPoly; forall i: Nat;
      qcoeff(qmulP(p, q), i) = qconvolution(p, q, NAT_ZERO, i)
    [by definition qmulP]
qed

theorem qMonomialCoeffAtItsIndex:
  forall a: Q; forall k: Nat;
  qcoeff(qmonomial(a, k), k) = a
proof
  @conclusion |
    forall a: Q; forall k: Nat;
      qcoeff(qmonomial(a, k), k) = a
    [by definition(0) qmonomial]
qed

theorem qMonomialCoeffElsewhere:
  forall a: Q; forall k, i: Nat;
  (not (i = k)) -> qcoeff(qmonomial(a, k), i) = ZERO
proof
  @conclusion |
    forall a: Q; forall k, i: Nat;
      (not (i = k)) -> qcoeff(qmonomial(a, k), i) = ZERO
    [by definition(1) qmonomial]
qed

theorem qConvolutionZero:
  forall p, q: QPoly; forall j: Nat;
  qconvolution(p, q, j, NAT_ZERO) =
  rational.mul(qcoeff(p, j), qcoeff(q, NAT_ZERO))
proof
  @conclusion |
    forall p, q: QPoly; forall j: Nat;
      qconvolution(p, q, j, NAT_ZERO) =
      rational.mul(qcoeff(p, j), qcoeff(q, NAT_ZERO))
    [by definition(0) qconvolution]
qed

theorem qConvolutionSucc:
  forall p, q: QPoly; forall j, m: Nat;
  qconvolution(p, q, j, peano.succ(m)) =
  rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(m))),
  qconvolution(p, q, peano.succ(j), m))
proof
  @conclusion |
    forall p, q: QPoly; forall j, m: Nat;
      qconvolution(p, q, j, peano.succ(m)) =
      rational.add(rational.mul(qcoeff(p, j), qcoeff(q, peano.succ(m))),
      qconvolution(p, q, peano.succ(j), m))
    [by definition(1) qconvolution]
qed

theorem qTailConvolutionZero:
  forall p, q: QPoly; forall m: Nat;
  qtailConvolution(p, q, NAT_ZERO, m) =
