        }
      @discharge-q |
        forall q, r: QPoly; forall i, n: Nat; n != NAT_ZERO -> qtripleTriGrounded(n)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: QPoly; forall i, n: Nat; n != NAT_ZERO -> qtripleTriGrounded(n)
    [by generalize generalize-p]
qed

// -- the TERMINATION obligation for `qtripleRows` -------------------------------------------
//
// `termination(peano):` names `qtripleRowsIsGrounded`, and the checker SYNTHESIZES the statement
// it must have — the recursive arm's own guard implying the generated predicate:
//
//     forall p, q, r: QPoly; forall i, m, n: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m)
//
// `qtripleRowsGrounded` is GENERATED from the arm's one recursive call site, a disjunction of
// that call grounded with its argument hitting the terminating arm's pattern:
//
//     qtripleRowsGrounded(m) iff
//       (qtripleRowsGrounded(peano.prev(m)) or peano.prev(m) = NAT_ZERO)
//
// The descent is on `m`, the FIFTH of six arguments — `n` rides through AFTER it, which is the
// only way this differs from the three families above.

// Strategy: the step of an induction on the row count. At `peano.succ(m)` the predecessor is `m`, so
// either `m = NAT_ZERO` and the base disjunct fires outright, or the inductive hypothesis applies
// at `m`. `tautology` picks whichever holds.
theorem qtripleRowsReachesABaseFromAPredecessor: forall m: Nat;
  (forall p2, q2, r2: QPoly; forall i2, n2: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m))
  -> (forall p, q, r: QPoly; forall i, n: Nat; peano.succ(m) != NAT_ZERO -> qtripleRowsGrounded(peano.succ(m)))
proof
  @the-generated-clause |
    forall m3: Nat; qtripleRowsGrounded(m3) iff
      (qtripleRowsGrounded(peano.prev(m3)) or peano.prev(m3) = NAT_ZERO)
    [by definition qtripleRowsGrounded]
  @prev-undoes-succ |
    forall k: Nat; peano.prev(peano.succ(k)) = k
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-m |
    fix m: Nat {
      @given-the-inductive-hypothesis |
        assume forall p2, q2, r2: QPoly; forall i2, n2: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m) {
          @inductive-hypothesis |
            forall p2, q2, r2: QPoly; forall i2, n2: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so these precede every term that writes `peano.prev(peano.succ(m))`.
          @succ-m-is-nonzero |
            peano.succ(m) != NAT_ZERO
            [using specialize a-successor-is-never-zero(m)]
          @prev-of-succ-m-is-m |
            peano.prev(peano.succ(m)) = m
            [using specialize prev-undoes-succ(m)]
          @generalize-p |
            fix p: QPoly {
              @generalize-q |
                fix q: QPoly {
                  @generalize-r |
                    fix r: QPoly {
                      @generalize-i |
                        fix i: Nat {
                          @generalize-n |
                            fix n: Nat {
                              @given-succ-m-nonzero |
                                assume peano.succ(m) != NAT_ZERO {
                                  @clause-at-the-successor |
                                    qtripleRowsGrounded(peano.succ(m)) iff
                                      (qtripleRowsGrounded(peano.prev(peano.succ(m))) or peano.prev(peano.succ(m)) = NAT_ZERO)
                                    [using specialize the-generated-clause(peano.succ(m))]
                                  @clause-with-the-predecessor-collapsed |
                                    qtripleRowsGrounded(peano.succ(m)) iff
                                      (qtripleRowsGrounded(m) or m = NAT_ZERO)
                                    [by rewrite prev-of-succ-m-is-m clause-at-the-successor]
                                  @the-inductive-hypothesis-here |
                                    m != NAT_ZERO -> qtripleRowsGrounded(m)
                                    [using specialize inductive-hypothesis(p, q, r, i, n)]
                                  @conclusion-grounded-at-succ-m |
                                    qtripleRowsGrounded(peano.succ(m))
                                    [using tautology clause-with-the-predecessor-collapsed
                                      the-inductive-hypothesis-here]
                                }
                              @nonzero-implies-grounded |
                                peano.succ(m) != NAT_ZERO -> qtripleRowsGrounded(peano.succ(m))
                                [by discharge given-succ-m-nonzero]
                            }
                          @discharge-n |
                            forall n: Nat; peano.succ(m) != NAT_ZERO -> qtripleRowsGrounded(peano.succ(m))
                            [by generalize generalize-n]
                        }
                      @discharge-i |
                        forall i, n: Nat; peano.succ(m) != NAT_ZERO -> qtripleRowsGrounded(peano.succ(m))
                        [by generalize generalize-i]
                    }
                  @discharge-r |
                    forall r: QPoly; forall i, n: Nat; peano.succ(m) != NAT_ZERO -> qtripleRowsGrounded(peano.succ(m))
                    [by generalize generalize-r]
                }
              @discharge-q |
                forall q, r: QPoly; forall i, n: Nat; peano.succ(m) != NAT_ZERO -> qtripleRowsGrounded(peano.succ(m))
                [by generalize generalize-q]
            }
          @conclusion-for-all-arguments |
            forall p, q, r: QPoly; forall i, n: Nat; peano.succ(m) != NAT_ZERO -> qtripleRowsGrounded(peano.succ(m))
            [by generalize generalize-p]
        }
      @the-hypothesis-implies-the-step |
        (forall p2, q2, r2: QPoly; forall i2, n2: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m))
          -> (forall p, q, r: QPoly; forall i, n: Nat; peano.succ(m) != NAT_ZERO -> qtripleRowsGrounded(peano.succ(m)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall m: Nat;
      (forall p2, q2, r2: QPoly; forall i2, n2: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m))
      -> (forall p, q, r: QPoly; forall i, n: Nat; peano.succ(m) != NAT_ZERO -> qtripleRowsGrounded(peano.succ(m)))
    [by generalize generalize-m]
qed

// Strategy: `peano.induction` on the row count. The base is VACUOUS — at m = NAT_ZERO the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so every bit of content is in the step above.
theorem qtripleRowsIsGrounded: forall p, q, r: QPoly; forall i, m, n: Nat;
  m != NAT_ZERO -> qtripleRowsGrounded(m)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix p: QPoly {
      @generalize-q-at-zero |
        fix q: QPoly {
          @generalize-r-at-zero |
            fix r: QPoly {
              @generalize-i-at-zero |
                fix i: Nat {
                  @generalize-n-at-zero |
                    fix n: Nat {
                      @conclusion-vacuously-grounded |
                        NAT_ZERO != NAT_ZERO -> qtripleRowsGrounded(NAT_ZERO)
                        [using tautology zero-is-itself]
                    }
                  @discharge-n-at-zero |
                    forall n: Nat; NAT_ZERO != NAT_ZERO -> qtripleRowsGrounded(NAT_ZERO)
                    [by generalize generalize-n-at-zero]
                }
              @discharge-i-at-zero |
                forall i, n: Nat; NAT_ZERO != NAT_ZERO -> qtripleRowsGrounded(NAT_ZERO)
                [by generalize generalize-i-at-zero]
            }
          @discharge-r-at-zero |
            forall r: QPoly; forall i, n: Nat; NAT_ZERO != NAT_ZERO -> qtripleRowsGrounded(NAT_ZERO)
            [by generalize generalize-r-at-zero]
        }
      @discharge-q-at-zero |
        forall q, r: QPoly; forall i, n: Nat; NAT_ZERO != NAT_ZERO -> qtripleRowsGrounded(NAT_ZERO)
        [by generalize generalize-q-at-zero]
    }
  @base-case |
    forall p, q, r: QPoly; forall i, n: Nat; NAT_ZERO != NAT_ZERO -> qtripleRowsGrounded(NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-m |
    forall m: Nat;
      (forall p2, q2, r2: QPoly; forall i2, n2: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m))
      -> (forall p, q, r: QPoly; forall i, n: Nat; peano.succ(m) != NAT_ZERO -> qtripleRowsGrounded(peano.succ(m)))
    [by cite qtripleRowsReachesABaseFromAPredecessor]
  @grounded-for-every-row-count |
    forall m: Nat; forall p, q, r: QPoly; forall i, n: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m)
    [using instantiation peano.induction((fun m: Nat => (forall p, q, r: QPoly; forall i, n: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m)))) base-case induction-step-for-all-m]
  @generalize-p |
    fix p: QPoly {
      @generalize-q |
        fix q: QPoly {
          @generalize-r |
            fix r: QPoly {
              @generalize-i |
                fix i: Nat {
                  @generalize-m |
                    fix m: Nat {
                      @generalize-n |
                        fix n: Nat {
                          @grounded-here |
                            m != NAT_ZERO -> qtripleRowsGrounded(m)
                            [using specialize grounded-for-every-row-count(m, p, q, r, i, n)]
                        }
                      @discharge-n |
                        forall n: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m)
                        [by generalize generalize-n]
                    }
                  @discharge-m |
                    forall m, n: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m)
                    [by generalize generalize-m]
                }
              @discharge-i |
                forall i, m, n: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m)
                [by generalize generalize-i]
            }
          @discharge-r |
            forall r: QPoly; forall i, m, n: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m)
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: QPoly; forall i, m, n: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: QPoly; forall i, m, n: Nat; m != NAT_ZERO -> qtripleRowsGrounded(m)
    [by generalize generalize-p]
qed
