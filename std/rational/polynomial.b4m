theorem qPowerZero:
  forall a: Q; qpower(a, peano.ZERO) = rational.ONE
proof
  @conclusion |
    forall a: Q; qpower(a, peano.ZERO) = rational.ONE
    [by definition(0) qpower]
qed

theorem qPowerSucc:
  forall a: Q; forall n: peano.Nat;
  qpower(a, peano.succ(n)) = rational.mul(a, qpower(a, n))
proof
  @conclusion |
    forall a: Q; forall n: peano.Nat;
      qpower(a, peano.succ(n)) = rational.mul(a, qpower(a, n))
    [by definition(1) qpower]
qed

theorem qEvalZero:
  forall p: QPoly; forall a: Q;
  qevalUpTo(p, a, peano.ZERO) = ZERO
proof
  @conclusion |
    forall p: QPoly; forall a: Q;
      qevalUpTo(p, a, peano.ZERO) = ZERO
    [by definition(0) qevalUpTo]
qed

theorem qEvalSucc:
  forall p: QPoly; forall a: Q; forall k: peano.Nat;
  qevalUpTo(p, a, peano.succ(k)) =
  rational.add(qevalUpTo(p, a, k),
  rational.mul(qcoeff(p, k), qpower(a, k)))
proof
  @conclusion |
    forall p: QPoly; forall a: Q; forall k: peano.Nat;
      qevalUpTo(p, a, peano.succ(k)) =
      rational.add(qevalUpTo(p, a, k),
      rational.mul(qcoeff(p, k), qpower(a, k)))
    [by definition(1) qevalUpTo]
qed

theorem qClearedSumZero:
  forall p: QPoly; forall r, s: Q;
  qclearedSum(p, r, s, peano.ZERO) = ZERO
proof
  @conclusion |
    forall p: QPoly; forall r, s: Q;
      qclearedSum(p, r, s, peano.ZERO) = ZERO
    [by definition(0) qclearedSum]
qed

theorem qClearedSumSucc:
  forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
  qclearedSum(p, r, s, peano.succ(k)) =
  rational.mul(s, rational.add(qclearedSum(p, r, s, k),
  rational.mul(qcoeff(p, k), qpower(r, k))))
proof
  @conclusion |
    forall p: QPoly; forall r, s: Q; forall k: peano.Nat;
      qclearedSum(p, r, s, peano.succ(k)) =
      rational.mul(s, rational.add(qclearedSum(p, r, s, k),
      rational.mul(qcoeff(p, k), qpower(r, k))))
    [by definition(1) qclearedSum]
qed

theorem qTheGapToAtZero:
  forall i: Nat; qtheGapTo(i, NAT_ZERO) = i
proof
  @conclusion |
    forall i: Nat; qtheGapTo(i, NAT_ZERO) = i
    [by definition(0) qtheGapTo]
qed

theorem qTheGapToSteps:
  forall i, j: Nat;
  qtheGapTo(peano.succ(i), peano.succ(j)) = qtheGapTo(i, j)
proof
  @conclusion |
    forall i, j: Nat;
      qtheGapTo(peano.succ(i), peano.succ(j)) = qtheGapTo(i, j)
    [by definition(1) qtheGapTo]
qed

theorem qTheCofactorIndexAtZero:
  forall i, j: Nat;
  qtheCofactorIndex(i, j, NAT_ZERO) = qtheGapTo(i, j)
proof
  @conclusion |
    forall i, j: Nat;
      qtheCofactorIndex(i, j, NAT_ZERO) = qtheGapTo(i, j)
    [by definition(0) qtheCofactorIndex]
qed

theorem qTheCofactorIndexSteps:
  forall i, j, k: Nat;
  qtheCofactorIndex(i, j, peano.succ(k)) =
  qtheGapTo(qtheGapTo(i, j), peano.succ(k))
proof
  @conclusion |
    forall i, j, k: Nat;
      qtheCofactorIndex(i, j, peano.succ(k)) =
      qtheGapTo(qtheGapTo(i, j), peano.succ(k))
    [by definition(1) qtheCofactorIndex]
qed

theorem qCappedRunZero:
  forall q, r: QPoly; forall g: Nat;
  qcappedRun(q, r, g, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall q, r: QPoly; forall g: Nat;
      qcappedRun(q, r, g, NAT_ZERO) = ZERO
    [by definition(0) qcappedRun]
qed

theorem qCappedRunSucc:
  forall q, r: QPoly; forall g, n: Nat;
  qcappedRun(q, r, g, peano.succ(n)) =
  rational.add(qcappedRun(q, r, g, n),
  rational.mul(qcoeff(q, n), qcoeff(r, qtheGapTo(g, n))))
proof
  @conclusion |
    forall q, r: QPoly; forall g, n: Nat;
      qcappedRun(q, r, g, peano.succ(n)) =
      rational.add(qcappedRun(q, r, g, n),
      rational.mul(qcoeff(q, n), qcoeff(r, qtheGapTo(g, n))))
    [by definition(1) qcappedRun]
qed

theorem qTripleTermMeaning:
  forall p, q, r: QPoly; forall i, j, k: Nat;
  qtripleTerm(p, q, r, i, j, k) =
  rational.mul(rational.mul(qcoeff(p, j), qcoeff(q, k)),
  qcoeff(r, qtheCofactorIndex(i, j, k)))
proof
  @conclusion |
    forall p, q, r: QPoly; forall i, j, k: Nat;
      qtripleTerm(p, q, r, i, j, k) =
      rational.mul(rational.mul(qcoeff(p, j), qcoeff(q, k)),
      qcoeff(r, qtheCofactorIndex(i, j, k)))
    [by definition qtripleTerm]
qed

