// Division with remainder, and Bézout, on ℚ's integer cut.
//
// ℤ has both (`std/integer/divides.b4m`'s `divisionAlgorithmExists` and `coprimeBezout`), but
// NEITHER transfers: each reaches `std/integer.b4m`'s `nonnegCases`, which is itself proved by
// transferring `peano.zeroOrSucc` through ℤ's `NonNeg` cut. Re-transferring anything citing it
// re-checks that INNER transfer, so the composed chain ℕ → ℤ's NonNeg → ℚ's isInteger wants
// `Nat` to be both `Int` and `Q` at once:
//   std/peano.b4m:857: expected sort 'Int', got 'Q'
// 2b4m re-checks an inner transfer rather than composing models, so this is a structural
// limit, not a missing mapping — see `drafts/bezout-on-the-cut/README.md`.
//
// So both are proved NATIVELY here, on `std/rational/natural-wellordering.b4m`'s
// `naturalWellOrdering`. That costs nothing extra: ℚ's cut is discrete
// (`theIntegersInRationalAreDiscrete`), which is exactly what makes a least element behave
// like ℤ's, and it keeps the whole development off `gcd`/`div`/`mod` — none of which the cut
// has, and all of which the de-totalization is about to remove anyway.
//
// Chapter 17's Corollary 17.14 and Theorem 17.15 both rest on the Bézout certificate here,
// via `euclidFromBezoutOnTheCut`.

import rational <<< "std/rational.b4m"
import rational_integer_order <<< "std/rational/integer-order.b4m"
import natural_wellordering <<< "std/rational/natural-wellordering.b4m"
import field_order <<< "std/field/order.b4m"

sort Q = rational.Q
const ZERO = rational.ZERO
const ONE = rational.ONE
func neg = rational.neg
pred less_than = rational.less_than
pred isInteger = rational.isInteger
pred isNatural = rational.isNatural

// -- REACHABLE REMAINDERS ------------------------------------------------------------------
// `isAReachableRemainder(a, b, n)`: n is what's left of a after subtracting some integer
// multiple of b. The division algorithm is then "the LEAST natural reachable remainder is
// below b" — if it were not, subtracting one more b would give a smaller one.
pred isAReachableRemainder(a: Q, b: Q, n: Q)
axiom reachableRemainderMeaning: forall a, b, n: Q;
  isAReachableRemainder(a, b, n) iff
  (exists q: Q; isInteger(q) and n = rational.add(a, neg(rational.mul(b, q))))

// a itself is reachable, at q = ZERO.
theorem theDividendIsReachable: forall a, b: Q;
  isAReachableRemainder(a, b, a)
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @zero-is-an-integer |
            isInteger(ZERO)
            [using import(rational) zeroIsAnInteger]
          @a-at-zero |
            a = rational.add(a, neg(rational.mul(b, ZERO)))
            [using polynomial(rational)]
          @the-zero-witness-works |
            isInteger(ZERO) and
              a = rational.add(a, neg(rational.mul(b, ZERO)))
            [by both zero-is-an-integer a-at-zero]
          @a-quotient-exists |
            exists q: Q; isInteger(q) and
              a = rational.add(a, neg(rational.mul(b, q)))
            [by witness(ZERO) the-zero-witness-works]
          @the-meaning |
            isAReachableRemainder(a, b, a) iff
              (exists q: Q; isInteger(q) and
              a = rational.add(a, neg(rational.mul(b, q))))
            [using specialize reachableRemainderMeaning(a, b, a)]
          @conclusion-reachable |
            isAReachableRemainder(a, b, a)
            [using tautology the-meaning a-quotient-exists]
        }
      @discharge-b |
        forall b9: Q; isAReachableRemainder(a, b9, a)
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q; isAReachableRemainder(a, b, a)
    [by generalize generalize-a]
qed

// Subtracting one more b keeps it reachable: the quotient goes up by one.
theorem subtractingAgainStaysReachable: forall a, b, n: Q;
  isAReachableRemainder(a, b, n) ->
  isAReachableRemainder(a, b, rational.add(n, neg(b)))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @generalize-n |
            fix n: Q {
              @given-reachable |
                assume isAReachableRemainder(a, b, n) {
                  @reachable |
                    isAReachableRemainder(a, b, n)
                    [by hypothesis given-reachable]
                  @the-meaning |
                    isAReachableRemainder(a, b, n) iff
                      (exists q: Q; isInteger(q) and
                      n = rational.add(a,
                      neg(rational.mul(b, q))))
                    [using specialize reachableRemainderMeaning(a, b, n)]
                  @a-quotient-exists |
                    exists q: Q; isInteger(q) and
                      n = rational.add(a, neg(rational.mul(b, q)))
                    [using tautology the-meaning reachable]
                  @conclusion-still-reachable |
                    unpack q: Q from a-quotient-exists {
                      @the-quotient |
                        isInteger(q) and
                          n = rational.add(a,
                          neg(rational.mul(b, q)))
                        [by hypothesis conclusion-still-reachable]
                      @q-is-an-integer |
                        isInteger(q)
                        [by and_lhs the-quotient]
                      @n-factors |
                        n = rational.add(a,
                          neg(rational.mul(b, q)))
                        [by and_rhs the-quotient]
                      @one-is-an-integer |
                        isInteger(ONE)
                        [using import(rational) oneIsAnInteger]
                      @the-next-quotient-is-an-integer |
                        isInteger(rational.add(q, ONE))
                        [using specialize rational.isIntegerAdd(q, ONE) q-is-an-integer one-is-an-integer]
                      // (a - b·q) - b = a - b·(q+1)
                      @the-shifted-value |
                        rational.add(rational.add(a,
                          neg(rational.mul(b, q))), neg(b)) =
                          rational.add(a, neg(rational.mul(b,
                          rational.add(q, ONE))))
                        [using polynomial(rational)]
                      @reflexivity-of-the-difference |
                        rational.add(n, neg(b)) =
                          rational.add(n, neg(b))
                        [by reflexivity]
                      @the-difference-at-the-factorization |
                        rational.add(n, neg(b)) =
                          rational.add(rational.add(a,
                          neg(rational.mul(b, q))), neg(b))
                        [by rewrite n-factors reflexivity-of-the-difference]
                      @the-difference-factors |
                        rational.add(n, neg(b)) =
                          rational.add(a, neg(rational.mul(b,
                          rational.add(q, ONE))))
                        [by rewrite the-shifted-value the-difference-at-the-factorization]
                      @the-next-witness-works |
                        isInteger(rational.add(q, ONE)) and
                          rational.add(n, neg(b)) =
                          rational.add(a, neg(rational.mul(b,
                          rational.add(q, ONE))))
                        [by both the-next-quotient-is-an-integer the-difference-factors]
                      @a-next-quotient-exists |
                        exists q2: Q; isInteger(q2) and
                          rational.add(n, neg(b)) =
                          rational.add(a, neg(rational.mul(b, q2)))
                        [by witness(rational.add(q, ONE)) the-next-witness-works]
                      @the-shifted-meaning |
                        isAReachableRemainder(a, b,
                          rational.add(n, neg(b))) iff
                          (exists q2: Q; isInteger(q2) and
                          rational.add(n, neg(b)) =
                          rational.add(a,
                          neg(rational.mul(b, q2))))
                        [using specialize reachableRemainderMeaning(a, b, rational.add(n, neg(b)))]
                      @conclusion-shifted-reachable |
                        isAReachableRemainder(a, b,
                          rational.add(n, neg(b)))
                        [using tautology the-shifted-meaning a-next-quotient-exists]
                    }
                  @the-shifted-exported |
                    isAReachableRemainder(a, b,
                      rational.add(n, neg(b)))
                    [by unpacked conclusion-still-reachable]
                }
              @the-implication |
                isAReachableRemainder(a, b, n) ->
                  isAReachableRemainder(a, b,
                  rational.add(n, neg(b)))
                [by discharge given-reachable]
            }
          @discharge-n |
            forall n9: Q;
              isAReachableRemainder(a, b, n9) ->
              isAReachableRemainder(a, b, rational.add(n9, neg(b)))
            [by generalize generalize-n]
        }
      @discharge-b |
        forall b9: Q; forall n9: Q;
          isAReachableRemainder(a, b9, n9) ->
          isAReachableRemainder(a, b9, rational.add(n9, neg(b9)))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, n: Q;
      isAReachableRemainder(a, b, n) ->
      isAReachableRemainder(a, b, rational.add(n, neg(b)))
    [by generalize generalize-a]
qed

// Subtracting a positive strictly decreases: from `0 < b`, shifting by `r - b` gives
// `r - b < r`. Pure ℚ order, nothing about the cut.
theorem subtractingAPositiveGoesDown: forall r, b: Q;
  less_than(ZERO, b) -> less_than(rational.add(r, neg(b)), r)
proof
  @generalize-r |
    fix r: Q {
      @generalize-b |
        fix b: Q {
          @given-b-positive |
            assume less_than(ZERO, b) {
              @b-positive |
                less_than(ZERO, b)
                [by hypothesis given-b-positive]
              @shifting-the-order |
                forall x, y, z: Q;
                  less_than(x, y) ->
                  less_than(rational.add(x, z), rational.add(y, z))
                [using import(rational) lessThanAddRight]
              // 0 < b, shifted by (r - b): (r - b) < (r - b) + b = r
              @shifted |
                less_than(rational.add(ZERO,
                  rational.add(r, neg(b))),
                  rational.add(b, rational.add(r, neg(b))))
                [using specialize shifting-the-order(ZERO, b, rational.add(r, neg(b))) b-positive]
              @the-left-collapses |
                rational.add(ZERO, rational.add(r, neg(b))) =
                  rational.add(r, neg(b))
                [using polynomial(rational)]
              @the-right-collapses |
                rational.add(b, rational.add(r, neg(b))) = r
                [using polynomial(rational)]
              @shifted-left |
                less_than(rational.add(r, neg(b)),
                  rational.add(b, rational.add(r, neg(b))))
                [by rewrite the-left-collapses shifted]
              @conclusion-goes-down |
                less_than(rational.add(r, neg(b)), r)
                [by rewrite the-right-collapses shifted-left]
            }
          @the-implication |
            less_than(ZERO, b) ->
              less_than(rational.add(r, neg(b)), r)
            [by discharge given-b-positive]
        }
      @discharge-b |
        forall b9: Q;
          less_than(ZERO, b9) ->
          less_than(rational.add(r, neg(b9)), r)
        [by generalize generalize-b]
    }
  @conclusion |
    forall r, b: Q;
      less_than(ZERO, b) -> less_than(rational.add(r, neg(b)), r)
    [by generalize generalize-r]
qed

// The converse shift: `x < y` makes the gap `y - x` positive.
theorem subtractingAPositiveIsPositiveWhenBelow: forall y, x: Q;
  less_than(x, y) -> less_than(ZERO, rational.add(y, neg(x)))
proof
  @generalize-y |
    fix y: Q {
      @generalize-x |
        fix x: Q {
          @given-x-below-y |
            assume less_than(x, y) {
              @x-below-y |
                less_than(x, y)
                [by hypothesis given-x-below-y]
              @shifting-the-order |
                forall p, q, z: Q;
                  less_than(p, q) ->
                  less_than(rational.add(p, z), rational.add(q, z))
                [using import(rational) lessThanAddRight]
              @shifted-by-minus-x |
                less_than(rational.add(x, neg(x)),
                  rational.add(y, neg(x)))
                [using specialize shifting-the-order(x, y, neg(x)) x-below-y]
              @the-left-vanishes |
                rational.add(x, neg(x)) = ZERO
                [using polynomial(rational)]
              @conclusion-gap-positive |
                less_than(ZERO, rational.add(y, neg(x)))
                [by rewrite the-left-vanishes shifted-by-minus-x]
            }
          @the-implication |
            less_than(x, y) ->
              less_than(ZERO, rational.add(y, neg(x)))
            [by discharge given-x-below-y]
        }
      @discharge-x |
        forall x9: Q;
          less_than(x9, y) ->
          less_than(ZERO, rational.add(y, neg(x9)))
        [by generalize generalize-x]
    }
  @conclusion |
    forall y, x: Q;
      less_than(x, y) -> less_than(ZERO, rational.add(y, neg(x)))
    [by generalize generalize-y]
qed

// -- THE DIVISION ALGORITHM ON THE CUT -----------------------------------------------------
// `0 < b -> ∃q, r; a = b·q + r ∧ 0 ≤ r < b`.
//
// Well-order the NATURAL reachable remainders. One exists when a is itself natural; in
// general subtract enough copies of b, which is what `aReachableNaturalExists` below
// supplies. The least such r must be below b: otherwise r − b is natural, reachable, and
// strictly smaller — contradicting leastness.
theorem theLeastNaturalRemainderIsBelowTheDivisor: forall a, b, r: Q;
  isInteger(a) -> isInteger(b) -> less_than(ZERO, b) ->
  isNatural(r) -> isAReachableRemainder(a, b, r) ->
  (forall m: Q; isNatural(m) -> isAReachableRemainder(a, b, m) ->
  (not less_than(m, r))) ->
  less_than(r, b)
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @generalize-r |
            fix r: Q {
              @given-the-setup |
                assume isInteger(a) and isInteger(b) and
                  less_than(ZERO, b) and isNatural(r) and
                  isAReachableRemainder(a, b, r) and
                  (forall m: Q; isNatural(m) ->
                  isAReachableRemainder(a, b, m) ->
                  (not less_than(m, r))) {
                  @the-setup |
                    isInteger(a) and isInteger(b) and
                      less_than(ZERO, b) and isNatural(r) and
                      isAReachableRemainder(a, b, r) and
                      (forall m: Q; isNatural(m) ->
                      isAReachableRemainder(a, b, m) ->
                      (not less_than(m, r)))
                    [by hypothesis given-the-setup]
                  @b-is-positive |
                    less_than(ZERO, b)
                    [using tautology the-setup]
                  @r-is-natural |
                    isNatural(r)
                    [using tautology the-setup]
                  @r-is-reachable |
                    isAReachableRemainder(a, b, r)
                    [using tautology the-setup]
                  @r-is-least |
                    forall m: Q; isNatural(m) ->
                      isAReachableRemainder(a, b, m) ->
                      (not less_than(m, r))
                    [using tautology the-setup]
                  // suppose r is NOT below b
                  @given-r-not-below-b |
                    assume not less_than(r, b) {
                      @r-not-below-b |
                        not less_than(r, b)
                        [by hypothesis given-r-not-below-b]
                      // then b <= r, so r - b is a natural
                      @the-trichotomy |
                        less_than(r, b) or r = b or less_than(b, r)
                        [using specialize rational.lessThanTrichotomy(r, b)]
                      @b-is-at-most-r |
                        r = b or less_than(b, r)
                        [using tautology the-trichotomy r-not-below-b]
                      @the-difference-is-natural |
                        isNatural(rational.add(r, neg(b)))
                        case b-is-at-most-r {
                          // r = b: the difference is ZERO
                          @when-equal |
                            assume r = b {
                              @r-is-b |
                                r = b
                                [by hypothesis when-equal]
                              @the-difference-vanishes |
                                rational.add(b, neg(b)) = ZERO
                                [using polynomial(rational)]
                              @zero-is-natural |
                                isNatural(ZERO)
                                [using import(rational) isNaturalZero]
                              @the-b-difference-is-natural |
                                isNatural(rational.add(b, neg(b)))
                                [by rewrite the-difference-vanishes zero-is-natural]
                              @conclusion-equal-case |
                                isNatural(rational.add(r, neg(b)))
                                [by rewrite r-is-b the-b-difference-is-natural]
                            }
                          // b < r: the difference is a positive integer
                          @when-below |
                            assume less_than(b, r) {
                              @b-below-r |
                                less_than(b, r)
                                [by hypothesis when-below]
                              @r-is-an-integer |
                                isInteger(r)
                                [using specialize rational.isNaturalIsInteger(r) r-is-natural]
                              @b-is-an-integer-here |
                                isInteger(b)
                                [using tautology the-setup]
                              @minus-b-is-an-integer |
                                isInteger(neg(b))
                                [using specialize rational.isIntegerNeg(b) b-is-an-integer-here]
                              @the-difference-is-an-integer |
                                isInteger(rational.add(r, neg(b)))
                                [using specialize rational.isIntegerAdd(r, neg(b)) r-is-an-integer minus-b-is-an-integer]
                              // b < r makes 0 < r - b
                              @shifting-the-order |
                                forall x, y, z: Q;
                                  less_than(x, y) ->
                                  less_than(rational.add(x, z),
                                  rational.add(y, z))
                                [using import(rational) lessThanAddRight]
                              @shifted-by-minus-b |
                                less_than(rational.add(b, neg(b)),
                                  rational.add(r, neg(b)))
                                [using specialize shifting-the-order(b, r, neg(b)) b-below-r]
                              @the-b-difference-vanishes |
                                rational.add(b, neg(b)) = ZERO
                                [using polynomial(rational)]
                              @the-difference-is-positive |
                                less_than(ZERO,
                                  rational.add(r, neg(b)))
                                [by rewrite the-b-difference-vanishes shifted-by-minus-b]
                              @conclusion-below-case |
                                isNatural(rational.add(r, neg(b)))
                                [using specialize rational_integer_order.aPositiveIntegerIsNatural(rational.add(r, neg(b))) the-difference-is-an-integer the-difference-is-positive]
                            }
                        }
                      // and it is reachable, and strictly below r
                      @the-difference-is-reachable |
                        isAReachableRemainder(a, b,
                          rational.add(r, neg(b)))
                        [using specialize subtractingAgainStaysReachable(a, b, r) r-is-reachable]
                      @the-difference-is-below-r |
                        less_than(rational.add(r, neg(b)), r)
                        [using specialize subtractingAPositiveGoesDown(r, b) b-is-positive]
                      @the-difference-is-not-below-r |
                        not less_than(rational.add(r, neg(b)), r)
                        [using specialize r-is-least(rational.add(r, neg(b))) the-difference-is-natural the-difference-is-reachable]
                    }
                  @r-is-not-not-below-b |
                    not not less_than(r, b)
                    [by contradiction given-r-not-below-b the-difference-is-below-r the-difference-is-not-below-r]
                  @conclusion-r-below-b |
                    less_than(r, b)
                    [by double_negation r-is-not-not-below-b]
                }
              @the-implication |
                (isInteger(a) and isInteger(b) and
                  less_than(ZERO, b) and isNatural(r) and
                  isAReachableRemainder(a, b, r) and
                  (forall m: Q; isNatural(m) ->
                  isAReachableRemainder(a, b, m) ->
                  (not less_than(m, r)))) ->
                  less_than(r, b)
                [by discharge given-the-setup]
              @curried |
                isInteger(a) -> isInteger(b) ->
                  less_than(ZERO, b) -> isNatural(r) ->
                  isAReachableRemainder(a, b, r) ->
                  (forall m: Q; isNatural(m) ->
                  isAReachableRemainder(a, b, m) ->
                  (not less_than(m, r))) ->
                  less_than(r, b)
                [using tautology the-implication]
            }
          @discharge-r |
            forall r9: Q;
              isInteger(a) -> isInteger(b) ->
              less_than(ZERO, b) -> isNatural(r9) ->
              isAReachableRemainder(a, b, r9) ->
              (forall m: Q; isNatural(m) ->
              isAReachableRemainder(a, b, m) ->
              (not less_than(m, r9))) ->
              less_than(r9, b)
            [by generalize generalize-r]
        }
      @discharge-b |
        forall b9, r9: Q;
          isInteger(a) -> isInteger(b9) ->
          less_than(ZERO, b9) -> isNatural(r9) ->
          isAReachableRemainder(a, b9, r9) ->
          (forall m: Q; isNatural(m) ->
          isAReachableRemainder(a, b9, m) ->
          (not less_than(m, r9))) ->
          less_than(r9, b9)
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, r: Q;
      isInteger(a) -> isInteger(b) -> less_than(ZERO, b) ->
      isNatural(r) -> isAReachableRemainder(a, b, r) ->
      (forall m: Q; isNatural(m) -> isAReachableRemainder(a, b, m) ->
      (not less_than(m, r))) ->
      less_than(r, b)
    [by generalize generalize-a]
qed

// A NATURAL reachable remainder exists. For a natural a, a itself serves. For a negative a,
// subtract a sufficiently negative multiple — `b >= 1` on the cut means `a - b·a >= 0` when
// a < 0, i.e. take q = a: then `a - b·a = a·(1 - b)`, a product of two non-positives.
theorem aReachableNaturalExists: forall a, b: Q;
  isInteger(a) -> isInteger(b) -> less_than(ZERO, b) ->
  (exists n: Q; isNatural(n) and isAReachableRemainder(a, b, n))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @given-the-setup |
            assume isInteger(a) and isInteger(b) and
              less_than(ZERO, b) {
              @the-setup |
                isInteger(a) and isInteger(b) and
                  less_than(ZERO, b)
                [by hypothesis given-the-setup]
              @a-is-an-integer |
                isInteger(a)
                [using tautology the-setup]
              @b-is-an-integer |
                isInteger(b)
                [using tautology the-setup]
              @b-is-positive |
                less_than(ZERO, b)
                [using tautology the-setup]
              @the-sign-split |
                less_than(ZERO, a) or ZERO = a or less_than(a, ZERO)
                [using specialize rational.lessThanTrichotomy(ZERO, a)]
              @conclusion-a-natural-exists |
                exists n: Q; isNatural(n) and
                  isAReachableRemainder(a, b, n)
                case the-sign-split {
                  @when-not-negative |
                    assume less_than(ZERO, a) or ZERO = a {
                      @the-nonneg-cases |
                        less_than(ZERO, a) or ZERO = a
                        [by hypothesis when-not-negative]
                      @a-is-natural |
                        isNatural(a)
                        case the-nonneg-cases {
                          @when-positive |
                            assume less_than(ZERO, a) {
                              @a-positive |
                                less_than(ZERO, a)
                                [by hypothesis when-positive]
                              @conclusion-positive-natural |
                                isNatural(a)
                                [using specialize rational_integer_order.aPositiveIntegerIsNatural(a) a-is-an-integer a-positive]
                            }
                          @when-zero |
                            assume ZERO = a {
                              @zero-is-a |
                                ZERO = a
                                [by hypothesis when-zero]
                              @zero-is-natural |
                                isNatural(ZERO)
                                [using import(rational) isNaturalZero]
                              @conclusion-zero-natural |
                                isNatural(a)
                                [by rewrite zero-is-a zero-is-natural]
                            }
                        }
                      @a-is-reachable |
                        isAReachableRemainder(a, b, a)
                        [using specialize theDividendIsReachable(a, b)]
                      @the-dividend-works |
                        isNatural(a) and isAReachableRemainder(a, b, a)
                        [by both a-is-natural a-is-reachable]
                      @conclusion-nonneg |
                        exists n: Q; isNatural(n) and
                          isAReachableRemainder(a, b, n)
                        [by witness(a) the-dividend-works]
                    }
                  // a < 0: take q = a, giving a - b·a = a·(1 - b) >= 0 since
                  // a <= 0 and 1 - b <= 0 (b >= 1 on the cut).
                  @when-negative |
                    assume less_than(a, ZERO) {
                      @a-negative |
                        less_than(a, ZERO)
                        [by hypothesis when-negative]
                      @the-remainder-at-a |
                        rational.add(a, neg(rational.mul(b, a))) =
                          rational.mul(neg(a),
                          rational.add(b, neg(ONE)))
                        [using polynomial(rational)]
                      // -a is a positive integer
                      @negatives-of-negatives |
                        forall x: Q; less_than(x, ZERO) ->
                          less_than(ZERO, neg(x))
                        [using model(rational.RationalOrderedField) field_order.negOfNegativeIsPositive]
                      @minus-a-is-positive |
                        less_than(ZERO, neg(a))
                        [using specialize negatives-of-negatives(a) a-negative]
                      @minus-a-is-an-integer |
                        isInteger(neg(a))
                        [using specialize rational.isIntegerNeg(a) a-is-an-integer]
                      @minus-a-is-natural |
                        isNatural(neg(a))
                        [using specialize rational_integer_order.aPositiveIntegerIsNatural(neg(a)) minus-a-is-an-integer minus-a-is-positive]
                      // b - 1 is a natural: b >= 1 on the cut
                      @b-is-one-or-more |
                        b = ONE or less_than(ONE, b)
                        [using specialize rational_integer_order.aPositiveIntegerIsAtLeastOne(b) b-is-an-integer b-is-positive]
                      @the-gap-is-natural |
                        isNatural(rational.add(b, neg(ONE)))
                        case b-is-one-or-more {
                          @when-b-is-one |
                            assume b = ONE {
                              @b-is-one |
                                b = ONE
                                [by hypothesis when-b-is-one]
                              @the-one-gap-vanishes |
                                rational.add(ONE, neg(ONE)) = ZERO
                                [using polynomial(rational)]
                              @zero-is-natural-here |
                                isNatural(ZERO)
                                [using import(rational) isNaturalZero]
                              @the-one-gap-is-natural |
                                isNatural(rational.add(ONE, neg(ONE)))
                                [by rewrite the-one-gap-vanishes zero-is-natural-here]
                              @conclusion-b-one |
                                isNatural(rational.add(b, neg(ONE)))
                                [by rewrite b-is-one the-one-gap-is-natural]
                            }
                          @when-b-exceeds-one |
                            assume less_than(ONE, b) {
                              @one-below-b |
                                less_than(ONE, b)
                                [by hypothesis when-b-exceeds-one]
                              @one-is-an-integer |
                                isInteger(ONE)
                                [using import(rational) oneIsAnInteger]
                              @minus-one-is-an-integer |
                                isInteger(neg(ONE))
                                [using specialize rational.isIntegerNeg(ONE) one-is-an-integer]
                              @the-gap-is-an-integer |
                                isInteger(rational.add(b, neg(ONE)))
                                [using specialize rational.isIntegerAdd(b, neg(ONE)) b-is-an-integer minus-one-is-an-integer]
                              @the-gap-is-positive |
                                less_than(ZERO,
                                  rational.add(b, neg(ONE)))
                                [using specialize subtractingAPositiveIsPositiveWhenBelow(b, ONE) one-below-b]
                              @conclusion-b-exceeds |
                                isNatural(rational.add(b, neg(ONE)))
                                [using specialize rational_integer_order.aPositiveIntegerIsNatural(rational.add(b, neg(ONE))) the-gap-is-an-integer the-gap-is-positive]
                            }
                        }
                      @the-product-is-natural |
                        isNatural(rational.mul(neg(a),
                          rational.add(b, neg(ONE))))
                        [using specialize rational_integer_order.isNaturalMul(neg(a), rational.add(b, neg(ONE))) minus-a-is-natural the-gap-is-natural]
                      @the-remainder-is-natural |
                        isNatural(rational.add(a,
                          neg(rational.mul(b, a))))
                        [by rewrite the-remainder-at-a the-product-is-natural]
                      // and it IS reachable, at q = a
                      @the-remainder-is-itself |
                        rational.add(a, neg(rational.mul(b, a))) =
                          rational.add(a, neg(rational.mul(b, a)))
                        [by reflexivity]
                      @the-a-witness-works |
                        isInteger(a) and
                          rational.add(a, neg(rational.mul(b, a))) =
                          rational.add(a, neg(rational.mul(b, a)))
                        [by both a-is-an-integer the-remainder-is-itself]
                      @an-a-quotient-exists |
                        exists q: Q; isInteger(q) and
                          rational.add(a, neg(rational.mul(b, a))) =
                          rational.add(a, neg(rational.mul(b, q)))
                        [by witness(a) the-a-witness-works]
                      @the-remainder-meaning |
                        isAReachableRemainder(a, b,
                          rational.add(a,
                          neg(rational.mul(b, a)))) iff
                          (exists q: Q; isInteger(q) and
                          rational.add(a, neg(rational.mul(b, a))) =
                          rational.add(a, neg(rational.mul(b, q))))
                        [using specialize reachableRemainderMeaning(a, b, rational.add(a, neg(rational.mul(b, a))))]
                      @the-remainder-is-reachable |
                        isAReachableRemainder(a, b,
                          rational.add(a,
                          neg(rational.mul(b, a))))
                        [using tautology the-remainder-meaning an-a-quotient-exists]
                      @the-negative-witness-works |
                        isNatural(rational.add(a,
                          neg(rational.mul(b, a)))) and
                          isAReachableRemainder(a, b,
                          rational.add(a,
                          neg(rational.mul(b, a))))
                        [by both the-remainder-is-natural the-remainder-is-reachable]
                      @conclusion-negative |
                        exists n: Q; isNatural(n) and
                          isAReachableRemainder(a, b, n)
                        [by witness(rational.add(a, neg(rational.mul(b, a)))) the-negative-witness-works]
                    }
                }
            }
          @the-implication |
            (isInteger(a) and isInteger(b) and
              less_than(ZERO, b)) ->
              (exists n: Q; isNatural(n) and
              isAReachableRemainder(a, b, n))
            [by discharge given-the-setup]
          @curried |
            isInteger(a) -> isInteger(b) -> less_than(ZERO, b) ->
              (exists n: Q; isNatural(n) and
              isAReachableRemainder(a, b, n))
            [using tautology the-implication]
        }
      @discharge-b |
        forall b9: Q;
          isInteger(a) -> isInteger(b9) -> less_than(ZERO, b9) ->
          (exists n: Q; isNatural(n) and
          isAReachableRemainder(a, b9, n))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q;
      isInteger(a) -> isInteger(b) -> less_than(ZERO, b) ->
      (exists n: Q; isNatural(n) and isAReachableRemainder(a, b, n))
    [by generalize generalize-a]
qed

// The division algorithm. Well-order the natural reachable remainders (inhabited by
// `aReachableNaturalExists`); the least one is below b by
// `theLeastNaturalRemainderIsBelowTheDivisor`, and unfolding `isAReachableRemainder` turns
// `r = a - b·q` into `a = b·q + r`.
theorem theDivisionAlgorithmOnTheCut: forall a, b: Q;
  isInteger(a) -> isInteger(b) -> less_than(ZERO, b) ->
  (exists q, r: Q; isInteger(q) and isNatural(r) and
  a = rational.add(rational.mul(b, q), r) and less_than(r, b))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @given-the-setup |
            assume isInteger(a) and isInteger(b) and
              less_than(ZERO, b) {
              @the-setup |
                isInteger(a) and isInteger(b) and less_than(ZERO, b)
                [by hypothesis given-the-setup]
              @a-is-an-integer |
                isInteger(a)
                [using tautology the-setup]
              @b-is-an-integer |
                isInteger(b)
                [using tautology the-setup]
              @b-is-positive |
                less_than(ZERO, b)
                [using tautology the-setup]
              @inhabited |
                exists n: Q; isNatural(n) and
                  isAReachableRemainder(a, b, n)
                [using specialize aReachableNaturalExists(a, b) a-is-an-integer b-is-an-integer b-is-positive]
              @the-well-ordering |
                (exists n: Q; isNatural(n) and
                  isAReachableRemainder(a, b, n)) ->
                  (exists least: Q; isNatural(least) and
                  isAReachableRemainder(a, b, least) and
                  (forall m: Q; isNatural(m) ->
                  isAReachableRemainder(a, b, m) ->
                  (not less_than(m, least))))
                [using instantiation natural_wellordering.naturalWellOrdering(fun n: Q => isAReachableRemainder(a, b, n))]
              @a-least-exists |
                exists least: Q; isNatural(least) and
                  isAReachableRemainder(a, b, least) and
                  (forall m: Q; isNatural(m) ->
                  isAReachableRemainder(a, b, m) ->
                  (not less_than(m, least)))
                [by modus_ponens the-well-ordering inhabited]
              @conclusion-with-the-least |
                unpack r: Q from a-least-exists {
                  @the-least-parts |
                    isNatural(r) and
                      isAReachableRemainder(a, b, r) and
                      (forall m: Q; isNatural(m) ->
                      isAReachableRemainder(a, b, m) ->
                      (not less_than(m, r)))
                    [by hypothesis conclusion-with-the-least]
                  @r-is-natural |
                    isNatural(r)
                    [using tautology the-least-parts]
                  @r-is-reachable |
                    isAReachableRemainder(a, b, r)
                    [using tautology the-least-parts]
                  @r-is-least |
                    forall m: Q; isNatural(m) ->
                      isAReachableRemainder(a, b, m) ->
                      (not less_than(m, r))
                    [using tautology the-least-parts]
                  @r-is-below-b |
                    less_than(r, b)
                    [using specialize theLeastNaturalRemainderIsBelowTheDivisor(a, b, r) a-is-an-integer b-is-an-integer b-is-positive r-is-natural r-is-reachable r-is-least]
                  @the-reachable-meaning |
                    isAReachableRemainder(a, b, r) iff
                      (exists q: Q; isInteger(q) and
                      r = rational.add(a,
                      neg(rational.mul(b, q))))
                    [using specialize reachableRemainderMeaning(a, b, r)]
                  @a-quotient-exists |
                    exists q: Q; isInteger(q) and
                      r = rational.add(a, neg(rational.mul(b, q)))
                    [using tautology the-reachable-meaning r-is-reachable]
                  @conclusion-with-the-quotient |
                    unpack q: Q from a-quotient-exists {
                      @the-quotient-parts |
                        isInteger(q) and
                          r = rational.add(a,
                          neg(rational.mul(b, q)))
                        [by hypothesis conclusion-with-the-quotient]
                      @q-is-an-integer |
                        isInteger(q)
                        [by and_lhs the-quotient-parts]
                      @r-factors |
                        r = rational.add(a,
                          neg(rational.mul(b, q)))
                        [by and_rhs the-quotient-parts]
                      // r = a - b·q becomes a = b·q + r
                      @adding-back |
                        rational.add(rational.mul(b, q),
                          rational.add(a,
                          neg(rational.mul(b, q)))) = a
                        [using polynomial(rational)]
                      @reflexivity-of-the-sum |
                        rational.add(rational.mul(b, q), r) =
                          rational.add(rational.mul(b, q), r)
                        [by reflexivity]
                      @the-sum-at-the-factorization |
                        rational.add(rational.mul(b, q), r) =
                          rational.add(rational.mul(b, q),
                          rational.add(a,
                          neg(rational.mul(b, q))))
                        [by rewrite r-factors reflexivity-of-the-sum]
                      @the-sum-is-a |
                        rational.add(rational.mul(b, q), r) = a
                        [by rewrite adding-back the-sum-at-the-factorization]
                      @a-is-the-sum |
                        a = rational.add(rational.mul(b, q), r)
                        [by symmetry the-sum-is-a]
                      @the-pair-works |
                        isInteger(q) and isNatural(r) and
                          a = rational.add(rational.mul(b, q), r) and
                          less_than(r, b)
                        [using tautology q-is-an-integer r-is-natural a-is-the-sum r-is-below-b]
                      @the-remainder-witness |
                        exists r2: Q; isInteger(q) and isNatural(r2) and
                          a = rational.add(rational.mul(b, q), r2) and
                          less_than(r2, b)
                        [by witness(r) the-pair-works]
                      @conclusion-both-witnesses |
                        exists q2, r2: Q; isInteger(q2) and
                          isNatural(r2) and
                          a = rational.add(rational.mul(b, q2), r2) and
                          less_than(r2, b)
                        [by witness(q) the-remainder-witness]
                    }
                  @the-quotient-exported |
                    exists q2, r2: Q; isInteger(q2) and isNatural(r2) and
                      a = rational.add(rational.mul(b, q2), r2) and
                      less_than(r2, b)
                    [by unpacked conclusion-with-the-quotient]
                }
              @the-least-exported |
                exists q2, r2: Q; isInteger(q2) and isNatural(r2) and
                  a = rational.add(rational.mul(b, q2), r2) and
                  less_than(r2, b)
                [by unpacked conclusion-with-the-least]
            }
          @the-implication |
            (isInteger(a) and isInteger(b) and less_than(ZERO, b)) ->
              (exists q, r: Q; isInteger(q) and isNatural(r) and
              a = rational.add(rational.mul(b, q), r) and
              less_than(r, b))
            [by discharge given-the-setup]
          @curried |
            isInteger(a) -> isInteger(b) -> less_than(ZERO, b) ->
              (exists q, r: Q; isInteger(q) and isNatural(r) and
              a = rational.add(rational.mul(b, q), r) and
              less_than(r, b))
            [using tautology the-implication]
        }
      @discharge-b |
        forall b9: Q;
          isInteger(a) -> isInteger(b9) -> less_than(ZERO, b9) ->
          (exists q, r: Q; isInteger(q) and isNatural(r) and
          a = rational.add(rational.mul(b9, q), r) and
          less_than(r, b9))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q;
      isInteger(a) -> isInteger(b) -> less_than(ZERO, b) ->
      (exists q, r: Q; isInteger(q) and isNatural(r) and
      a = rational.add(rational.mul(b, q), r) and less_than(r, b))
    [by generalize generalize-a]
qed

// -- BÉZOUT ON THE CUT ---------------------------------------------------------------------
// `isACombination(a, b, n)`: n is an integer combination `a·r + b·s`. Bézout well-orders the
// POSITIVE combinations: the least one divides both a and b (otherwise dividing a by it
// leaves a strictly smaller positive combination), so under coprimality it is ONE.
pred isACombination(a: Q, b: Q, n: Q)
axiom combinationMeaning: forall a, b, n: Q;
  isACombination(a, b, n) iff
  (exists r: Q; exists s: Q; isInteger(r) and isInteger(s) and
  n = rational.add(rational.mul(a, r), rational.mul(b, s)))

// A combination's own multiples and sums are combinations — the two closure facts the
// descent needs.
theorem aMultipleOfACombinationIsACombination: forall a, b, n, k: Q;
  isInteger(k) -> isACombination(a, b, n) ->
  isACombination(a, b, rational.mul(n, k))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @generalize-n |
            fix n: Q {
              @generalize-k |
                fix k: Q {
                  @given-the-setup |
                    assume isInteger(k) and isACombination(a, b, n) {
                      @the-setup |
                        isInteger(k) and isACombination(a, b, n)
                        [by hypothesis given-the-setup]
                      @k-is-an-integer |
                        isInteger(k)
                        [by and_lhs the-setup]
                      @n-is-a-combination |
                        isACombination(a, b, n)
                        [by and_rhs the-setup]
                      @the-meaning |
                        isACombination(a, b, n) iff
                          (exists r: Q; exists s: Q;
                          isInteger(r) and isInteger(s) and
                          n = rational.add(rational.mul(a, r),
                          rational.mul(b, s)))
                        [using specialize combinationMeaning(a, b, n)]
                      @a-pair-exists |
                        exists r: Q; exists s: Q;
                          isInteger(r) and isInteger(s) and
                          n = rational.add(rational.mul(a, r),
                          rational.mul(b, s))
                        [using tautology the-meaning n-is-a-combination]
                      @conclusion-scaled |
                        unpack r: Q from a-pair-exists {
                          @the-s-exists |
                            exists s: Q;
                              isInteger(r) and isInteger(s) and
                              n = rational.add(rational.mul(a, r),
                              rational.mul(b, s))
                            [by hypothesis conclusion-scaled]
                          @conclusion-scaled-inner |
                            unpack s: Q from the-s-exists {
                              @the-pair |
                                isInteger(r) and isInteger(s) and
                                  n = rational.add(
                                  rational.mul(a, r),
                                  rational.mul(b, s))
                                [by hypothesis conclusion-scaled-inner]
                              @r-is-an-integer |
                                isInteger(r)
                                [using tautology the-pair]
                              @s-is-an-integer |
                                isInteger(s)
                                [using tautology the-pair]
                              @n-expands |
                                n = rational.add(rational.mul(a, r),
                                  rational.mul(b, s))
                                [using tautology the-pair]
                              @rk-is-an-integer |
                                isInteger(rational.mul(r, k))
                                [using specialize rational.isIntegerMul(r, k) r-is-an-integer k-is-an-integer]
                              @sk-is-an-integer |
                                isInteger(rational.mul(s, k))
                                [using specialize rational.isIntegerMul(s, k) s-is-an-integer k-is-an-integer]
                              @the-scaled-form |
                                rational.mul(rational.add(
                                  rational.mul(a, r),
                                  rational.mul(b, s)), k) =
                                  rational.add(rational.mul(a,
                                  rational.mul(r, k)),
                                  rational.mul(b,
                                  rational.mul(s, k)))
                                [using polynomial(rational)]
                              @reflexivity-of-the-scaling |
                                rational.mul(n, k) =
                                  rational.mul(n, k)
                                [by reflexivity]
                              @the-scaling-at-the-expansion |
                                rational.mul(n, k) =
                                  rational.mul(rational.add(
                                  rational.mul(a, r),
                                  rational.mul(b, s)), k)
                                [by rewrite n-expands reflexivity-of-the-scaling]
                              @the-scaling-expands |
                                rational.mul(n, k) =
                                  rational.add(rational.mul(a,
                                  rational.mul(r, k)),
                                  rational.mul(b,
                                  rational.mul(s, k)))
                                [by rewrite the-scaled-form the-scaling-at-the-expansion]
                              @the-scaled-pair-works |
                                isInteger(rational.mul(r, k)) and
                                  isInteger(rational.mul(s, k)) and
                                  rational.mul(n, k) =
                                  rational.add(rational.mul(a,
                                  rational.mul(r, k)),
                                  rational.mul(b,
                                  rational.mul(s, k)))
                                [using tautology rk-is-an-integer sk-is-an-integer the-scaling-expands]
                              @the-scaled-s-witness |
                                exists s2: Q;
                                  isInteger(rational.mul(r, k)) and
                                  isInteger(s2) and
                                  rational.mul(n, k) =
                                  rational.add(rational.mul(a,
                                  rational.mul(r, k)),
                                  rational.mul(b, s2))
                                [by witness(rational.mul(s, k)) the-scaled-pair-works]
                              @the-scaled-r-witness |
                                exists r2: Q; exists s2: Q;
                                  isInteger(r2) and isInteger(s2) and
                                  rational.mul(n, k) =
                                  rational.add(rational.mul(a, r2),
                                  rational.mul(b, s2))
                                [by witness(rational.mul(r, k)) the-scaled-s-witness]
                              @the-scaled-meaning |
                                isACombination(a, b,
                                  rational.mul(n, k)) iff
                                  (exists r2: Q; exists s2: Q;
                                  isInteger(r2) and isInteger(s2) and
                                  rational.mul(n, k) =
                                  rational.add(rational.mul(a, r2),
                                  rational.mul(b, s2)))
                                [using specialize combinationMeaning(a, b, rational.mul(n, k))]
                              @conclusion-scaled-combination |
                                isACombination(a, b,
                                  rational.mul(n, k))
                                [using tautology the-scaled-meaning the-scaled-r-witness]
                            }
                          @the-inner-exported |
                            isACombination(a, b, rational.mul(n, k))
                            [by unpacked conclusion-scaled-inner]
                        }
                      @the-outer-exported |
                        isACombination(a, b, rational.mul(n, k))
                        [by unpacked conclusion-scaled]
                    }
                  @the-implication |
                    (isInteger(k) and isACombination(a, b, n)) ->
                      isACombination(a, b, rational.mul(n, k))
                    [by discharge given-the-setup]
                  @curried |
                    isInteger(k) -> isACombination(a, b, n) ->
                      isACombination(a, b, rational.mul(n, k))
                    [using tautology the-implication]
                }
              @discharge-k |
                forall k9: Q;
                  isInteger(k9) -> isACombination(a, b, n) ->
                  isACombination(a, b, rational.mul(n, k9))
                [by generalize generalize-k]
            }
          @discharge-n |
            forall n9, k9: Q;
              isInteger(k9) -> isACombination(a, b, n9) ->
              isACombination(a, b, rational.mul(n9, k9))
            [by generalize generalize-n]
        }
      @discharge-b |
        forall b9: Q; forall n9, k9: Q;
          isInteger(k9) -> isACombination(a, b9, n9) ->
          isACombination(a, b9, rational.mul(n9, k9))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, n, k: Q;
      isInteger(k) -> isACombination(a, b, n) ->
      isACombination(a, b, rational.mul(n, k))
    [by generalize generalize-a]
qed

// A difference of combinations is a combination — the other closure the descent needs.
theorem aDifferenceOfCombinationsIsACombination: forall a, b, m, n: Q;
  isACombination(a, b, m) -> isACombination(a, b, n) ->
  isACombination(a, b, rational.add(m, neg(n)))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @generalize-m |
            fix m: Q {
              @generalize-n |
                fix n: Q {
                  @given-both |
                    assume isACombination(a, b, m) and
                      isACombination(a, b, n) {
                      @both |
                        isACombination(a, b, m) and
                          isACombination(a, b, n)
                        [by hypothesis given-both]
                      @m-is-a-combination |
                        isACombination(a, b, m)
                        [by and_lhs both]
                      @n-is-a-combination |
                        isACombination(a, b, n)
                        [by and_rhs both]
                      @the-m-meaning |
                        isACombination(a, b, m) iff
                          (exists r: Q; exists s: Q;
                          isInteger(r) and isInteger(s) and
                          m = rational.add(rational.mul(a, r),
                          rational.mul(b, s)))
                        [using specialize combinationMeaning(a, b, m)]
                      @an-m-pair-exists |
                        exists r: Q; exists s: Q;
                          isInteger(r) and isInteger(s) and
                          m = rational.add(rational.mul(a, r),
                          rational.mul(b, s))
                        [using tautology the-m-meaning m-is-a-combination]
                      @the-n-meaning |
                        isACombination(a, b, n) iff
                          (exists r: Q; exists s: Q;
                          isInteger(r) and isInteger(s) and
                          n = rational.add(rational.mul(a, r),
                          rational.mul(b, s)))
                        [using specialize combinationMeaning(a, b, n)]
                      @an-n-pair-exists |
                        exists r: Q; exists s: Q;
                          isInteger(r) and isInteger(s) and
                          n = rational.add(rational.mul(a, r),
                          rational.mul(b, s))
                        [using tautology the-n-meaning n-is-a-combination]
                      @conclusion-difference |
                        unpack rm: Q from an-m-pair-exists {
                          @the-m-s-exists |
                            exists s: Q;
                              isInteger(rm) and isInteger(s) and
                              m = rational.add(
                              rational.mul(a, rm),
                              rational.mul(b, s))
                            [by hypothesis conclusion-difference]
                          @conclusion-difference-2 |
                            unpack sm: Q from the-m-s-exists {
                              @the-m-pair |
                                isInteger(rm) and isInteger(sm) and
                                  m = rational.add(
                                  rational.mul(a, rm),
                                  rational.mul(b, sm))
                                [by hypothesis conclusion-difference-2]
                              @rm-is-an-integer |
                                isInteger(rm)
                                [using tautology the-m-pair]
                              @sm-is-an-integer |
                                isInteger(sm)
                                [using tautology the-m-pair]
                              @m-expands |
                                m = rational.add(
                                  rational.mul(a, rm),
                                  rational.mul(b, sm))
                                [using tautology the-m-pair]
                              @conclusion-difference-3 |
                                unpack rn: Q from an-n-pair-exists {
                                  @the-n-s-exists |
                                    exists s: Q;
                                      isInteger(rn) and
                                      isInteger(s) and
                                      n = rational.add(
                                      rational.mul(a, rn),
                                      rational.mul(b, s))
                                    [by hypothesis conclusion-difference-3]
                                  @conclusion-difference-4 |
                                    unpack sn: Q from the-n-s-exists {
                                      @the-n-pair |
                                        isInteger(rn) and
                                          isInteger(sn) and
                                          n = rational.add(
                                          rational.mul(a, rn),
                                          rational.mul(b, sn))
                                        [by hypothesis conclusion-difference-4]
                                      @rn-is-an-integer |
                                        isInteger(rn)
                                        [using tautology the-n-pair]
                                      @sn-is-an-integer |
                                        isInteger(sn)
                                        [using tautology the-n-pair]
                                      @n-expands |
                                        n = rational.add(
                                          rational.mul(a, rn),
                                          rational.mul(b, sn))
                                        [using tautology the-n-pair]
                                      // the difference's coefficients
                                      @minus-rn-is-an-integer |
                                        isInteger(neg(rn))
                                        [using specialize rational.isIntegerNeg(rn) rn-is-an-integer]
                                      @minus-sn-is-an-integer |
                                        isInteger(neg(sn))
                                        [using specialize rational.isIntegerNeg(sn) sn-is-an-integer]
                                      @the-r-difference-is-an-integer |
                                        isInteger(rational.add(rm,
                                          neg(rn)))
                                        [using specialize rational.isIntegerAdd(rm, neg(rn)) rm-is-an-integer minus-rn-is-an-integer]
                                      @the-s-difference-is-an-integer |
                                        isInteger(rational.add(sm,
                                          neg(sn)))
                                        [using specialize rational.isIntegerAdd(sm, neg(sn)) sm-is-an-integer minus-sn-is-an-integer]
                                      @the-difference-form |
                                        rational.add(rational.add(
                                          rational.mul(a, rm),
                                          rational.mul(b, sm)),
                                          neg(rational.add(
                                          rational.mul(a, rn),
                                          rational.mul(b, sn)))) =
                                          rational.add(
                                          rational.mul(a,
                                          rational.add(rm,
                                          neg(rn))),
                                          rational.mul(b,
                                          rational.add(sm,
                                          neg(sn))))
                                        [using polynomial(rational)]
                                      @reflexivity-of-the-difference |
                                        rational.add(m, neg(n)) =
                                          rational.add(m, neg(n))
                                        [by reflexivity]
                                      @the-difference-at-m |
                                        rational.add(m, neg(n)) =
                                          rational.add(
                                          rational.add(
                                          rational.mul(a, rm),
                                          rational.mul(b, sm)),
                                          neg(n))
                                        [by rewrite m-expands reflexivity-of-the-difference]
                                      @the-difference-at-both |
                                        rational.add(m, neg(n)) =
                                          rational.add(
                                          rational.add(
                                          rational.mul(a, rm),
                                          rational.mul(b, sm)),
                                          neg(rational.add(
                                          rational.mul(a, rn),
                                          rational.mul(b, sn))))
                                        [by rewrite n-expands the-difference-at-m]
                                      @the-difference-expands |
                                        rational.add(m, neg(n)) =
                                          rational.add(
                                          rational.mul(a,
                                          rational.add(rm,
                                          neg(rn))),
                                          rational.mul(b,
                                          rational.add(sm,
                                          neg(sn))))
                                        [by rewrite the-difference-form the-difference-at-both]
                                      @the-difference-pair-works |
                                        isInteger(rational.add(rm,
                                          neg(rn))) and
                                          isInteger(rational.add(sm,
                                          neg(sn))) and
                                          rational.add(m, neg(n)) =
                                          rational.add(
                                          rational.mul(a,
                                          rational.add(rm,
                                          neg(rn))),
                                          rational.mul(b,
                                          rational.add(sm,
                                          neg(sn))))
                                        [using tautology the-r-difference-is-an-integer the-s-difference-is-an-integer the-difference-expands]
                                      @the-difference-s-witness |
                                        exists s2: Q;
                                          isInteger(rational.add(rm,
                                          neg(rn))) and
                                          isInteger(s2) and
                                          rational.add(m, neg(n)) =
                                          rational.add(
                                          rational.mul(a,
                                          rational.add(rm,
                                          neg(rn))),
                                          rational.mul(b, s2))
                                        [by witness(rational.add(sm, neg(sn))) the-difference-pair-works]
                                      @the-difference-r-witness |
                                        exists r2: Q; exists s2: Q;
                                          isInteger(r2) and
                                          isInteger(s2) and
                                          rational.add(m, neg(n)) =
                                          rational.add(
                                          rational.mul(a, r2),
                                          rational.mul(b, s2))
                                        [by witness(rational.add(rm, neg(rn))) the-difference-s-witness]
                                      @the-difference-meaning |
                                        isACombination(a, b,
                                          rational.add(m,
                                          neg(n))) iff
                                          (exists r2: Q;
                                          exists s2: Q;
                                          isInteger(r2) and
                                          isInteger(s2) and
                                          rational.add(m, neg(n)) =
                                          rational.add(
                                          rational.mul(a, r2),
                                          rational.mul(b, s2)))
                                        [using specialize combinationMeaning(a, b, rational.add(m, neg(n)))]
                                      @conclusion-difference-combination |
                                        isACombination(a, b,
                                          rational.add(m, neg(n)))
                                        [using tautology the-difference-meaning the-difference-r-witness]
                                    }
                                  @the-4-exported |
                                    isACombination(a, b,
                                      rational.add(m, neg(n)))
                                    [by unpacked conclusion-difference-4]
                                }
                              @the-3-exported |
                                isACombination(a, b,
                                  rational.add(m, neg(n)))
                                [by unpacked conclusion-difference-3]
                            }
                          @the-2-exported |
                            isACombination(a, b,
                              rational.add(m, neg(n)))
                            [by unpacked conclusion-difference-2]
                        }
                      @the-outer-exported |
                        isACombination(a, b, rational.add(m, neg(n)))
                        [by unpacked conclusion-difference]
                    }
                  @the-implication |
                    (isACombination(a, b, m) and
                      isACombination(a, b, n)) ->
                      isACombination(a, b, rational.add(m, neg(n)))
                    [by discharge given-both]
                  @curried |
                    isACombination(a, b, m) ->
                      isACombination(a, b, n) ->
                      isACombination(a, b, rational.add(m, neg(n)))
                    [using tautology the-implication]
                }
              @discharge-n |
                forall n9: Q;
                  isACombination(a, b, m) ->
                  isACombination(a, b, n9) ->
                  isACombination(a, b, rational.add(m, neg(n9)))
                [by generalize generalize-n]
            }
          @discharge-m |
            forall m9, n9: Q;
              isACombination(a, b, m9) ->
              isACombination(a, b, n9) ->
              isACombination(a, b, rational.add(m9, neg(n9)))
            [by generalize generalize-m]
        }
      @discharge-b |
        forall b9: Q; forall m9, n9: Q;
          isACombination(a, b9, m9) ->
          isACombination(a, b9, n9) ->
          isACombination(a, b9, rational.add(m9, neg(n9)))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, m, n: Q;
      isACombination(a, b, m) -> isACombination(a, b, n) ->
      isACombination(a, b, rational.add(m, neg(n)))
    [by generalize generalize-a]
qed

// THE DESCENT. The least POSITIVE combination g divides every combination x: divide x by g,
// and the remainder `x - g·q` is itself a combination (by the two closures) that is natural
// and strictly below g — so by leastness it cannot be positive, hence it is ZERO.
theorem theLeastPositiveCombinationDividesEveryCombination: forall a, b, g, x: Q;
  isInteger(g) -> less_than(ZERO, g) -> isACombination(a, b, g) ->
  (forall m: Q; isInteger(m) -> less_than(ZERO, m) ->
  isACombination(a, b, m) -> (not less_than(m, g))) ->
  isInteger(x) -> isACombination(a, b, x) ->
  (exists k: Q; isInteger(k) and x = rational.mul(g, k))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @generalize-g |
            fix g: Q {
              @generalize-x |
                fix x: Q {
                  @given-the-setup |
                    assume isInteger(g) and less_than(ZERO, g) and
                      isACombination(a, b, g) and
                      (forall m: Q; isInteger(m) ->
                      less_than(ZERO, m) ->
                      isACombination(a, b, m) ->
                      (not less_than(m, g))) and
                      isInteger(x) and isACombination(a, b, x) {
                      @the-setup |
                        isInteger(g) and less_than(ZERO, g) and
                          isACombination(a, b, g) and
                          (forall m: Q; isInteger(m) ->
                          less_than(ZERO, m) ->
                          isACombination(a, b, m) ->
                          (not less_than(m, g))) and
                          isInteger(x) and isACombination(a, b, x)
                        [by hypothesis given-the-setup]
                      @g-is-an-integer |
                        isInteger(g)
                        [using tautology the-setup]
                      @g-is-positive |
                        less_than(ZERO, g)
                        [using tautology the-setup]
                      @g-is-a-combination |
                        isACombination(a, b, g)
                        [using tautology the-setup]
                      @g-is-least |
                        forall m: Q; isInteger(m) ->
                          less_than(ZERO, m) ->
                          isACombination(a, b, m) ->
                          (not less_than(m, g))
                        [using tautology the-setup]
                      @x-is-an-integer |
                        isInteger(x)
                        [using tautology the-setup]
                      @x-is-a-combination |
                        isACombination(a, b, x)
                        [using tautology the-setup]
                      // divide x by g
                      @the-division |
                        exists q, r: Q; isInteger(q) and isNatural(r) and
                          x = rational.add(rational.mul(g, q), r) and
                          less_than(r, g)
                        [using specialize theDivisionAlgorithmOnTheCut(x, g) x-is-an-integer g-is-an-integer g-is-positive]
                      @conclusion-with-the-division |
                        unpack q: Q from the-division {
                          @the-remainder-exists |
                            exists r: Q; isInteger(q) and
                              isNatural(r) and
                              x = rational.add(
                              rational.mul(g, q), r) and
                              less_than(r, g)
                            [by hypothesis conclusion-with-the-division]
                          @conclusion-with-the-remainder |
                            unpack r: Q from the-remainder-exists {
                              @the-division-parts |
                                isInteger(q) and isNatural(r) and
                                  x = rational.add(
                                  rational.mul(g, q), r) and
                                  less_than(r, g)
                                [by hypothesis conclusion-with-the-remainder]
                              @q-is-an-integer |
                                isInteger(q)
                                [using tautology the-division-parts]
                              @r-is-natural |
                                isNatural(r)
                                [using tautology the-division-parts]
                              @x-splits |
                                x = rational.add(
                                  rational.mul(g, q), r)
                                [using tautology the-division-parts]
                              @r-is-below-g |
                                less_than(r, g)
                                [using tautology the-division-parts]
                              // r = x - g·q is a combination
                              @gq-is-a-combination |
                                isACombination(a, b,
                                  rational.mul(g, q))
                                [using specialize aMultipleOfACombinationIsACombination(a, b, g, q) q-is-an-integer g-is-a-combination]
                              @the-remainder-form |
                                rational.add(rational.add(
                                  rational.mul(g, q), r),
                                  neg(rational.mul(g, q))) = r
                                [using polynomial(rational)]
                              @the-difference-is-a-combination |
                                isACombination(a, b,
                                  rational.add(x,
                                  neg(rational.mul(g, q))))
                                [using specialize aDifferenceOfCombinationsIsACombination(a, b, x, rational.mul(g, q)) x-is-a-combination gq-is-a-combination]
                              @reflexivity-of-the-remainder |
                                rational.add(x,
                                  neg(rational.mul(g, q))) =
                                  rational.add(x,
                                  neg(rational.mul(g, q)))
                                [by reflexivity]
                              @the-remainder-at-the-split |
                                rational.add(x,
                                  neg(rational.mul(g, q))) =
                                  rational.add(rational.add(
                                  rational.mul(g, q), r),
                                  neg(rational.mul(g, q)))
                                [by rewrite x-splits reflexivity-of-the-remainder]
                              @the-remainder-is-r |
                                rational.add(x,
                                  neg(rational.mul(g, q))) = r
                                [by rewrite the-remainder-form the-remainder-at-the-split]
                              @r-is-a-combination |
                                isACombination(a, b, r)
                                [by rewrite the-remainder-is-r the-difference-is-a-combination]
                              // r is natural and below g, so leastness forces r = ZERO
                              @r-is-zero-or-positive |
                                r = ZERO or less_than(ZERO, r)
                                [using specialize rational_integer_order.aNaturalIsZeroOrPositive(r) r-is-natural]
                              @r-is-zero |
                                r = ZERO
                                case r-is-zero-or-positive {
                                  @when-zero |
                                    assume r = ZERO {
                                      @conclusion-already-zero |
                                        r = ZERO
                                        [by hypothesis when-zero]
                                    }
                                  @when-positive |
                                    assume less_than(ZERO, r) {
                                      @r-is-positive |
                                        less_than(ZERO, r)
                                        [by hypothesis when-positive]
                                      @r-is-an-integer |
                                        isInteger(r)
                                        [using specialize rational.isNaturalIsInteger(r) r-is-natural]
                                      @r-is-not-below-g |
                                        not less_than(r, g)
                                        [using specialize g-is-least(r) r-is-an-integer r-is-positive r-is-a-combination]
                                      @conclusion-impossible |
                                        r = ZERO
                                        [by ex_falso r-is-below-g r-is-not-below-g]
                                    }
                                }
                              // so x = g·q
                              @x-at-zero-remainder |
                                x = rational.add(
                                  rational.mul(g, q), ZERO)
                                [by rewrite r-is-zero x-splits]
                              @adding-zero |
                                rational.add(rational.mul(g, q),
                                  ZERO) = rational.mul(g, q)
                                [using polynomial(rational)]
                              @x-is-a-multiple |
                                x = rational.mul(g, q)
                                [by rewrite adding-zero x-at-zero-remainder]
                              @the-quotient-works |
                                isInteger(q) and
                                  x = rational.mul(g, q)
                                [by both q-is-an-integer x-is-a-multiple]
                              @conclusion-a-quotient-exists |
                                exists k: Q; isInteger(k) and
                                  x = rational.mul(g, k)
                                [by witness(q) the-quotient-works]
                            }
                          @the-remainder-exported |
                            exists k: Q; isInteger(k) and
                              x = rational.mul(g, k)
                            [by unpacked conclusion-with-the-remainder]
                        }
                      @the-division-exported |
                        exists k: Q; isInteger(k) and
                          x = rational.mul(g, k)
                        [by unpacked conclusion-with-the-division]
                    }
                  @the-implication |
                    (isInteger(g) and less_than(ZERO, g) and
                      isACombination(a, b, g) and
                      (forall m: Q; isInteger(m) ->
                      less_than(ZERO, m) ->
                      isACombination(a, b, m) ->
                      (not less_than(m, g))) and
                      isInteger(x) and isACombination(a, b, x)) ->
                      (exists k: Q; isInteger(k) and
                      x = rational.mul(g, k))
                    [by discharge given-the-setup]
                  @curried |
                    isInteger(g) -> less_than(ZERO, g) ->
                      isACombination(a, b, g) ->
                      (forall m: Q; isInteger(m) ->
                      less_than(ZERO, m) ->
                      isACombination(a, b, m) ->
                      (not less_than(m, g))) ->
                      isInteger(x) -> isACombination(a, b, x) ->
                      (exists k: Q; isInteger(k) and
                      x = rational.mul(g, k))
                    [using tautology the-implication]
                }
              @discharge-x |
                forall x9: Q;
                  isInteger(g) -> less_than(ZERO, g) ->
                  isACombination(a, b, g) ->
                  (forall m: Q; isInteger(m) ->
                  less_than(ZERO, m) ->
                  isACombination(a, b, m) ->
                  (not less_than(m, g))) ->
                  isInteger(x9) -> isACombination(a, b, x9) ->
                  (exists k: Q; isInteger(k) and
                  x9 = rational.mul(g, k))
                [by generalize generalize-x]
            }
          @discharge-g |
            forall g9, x9: Q;
              isInteger(g9) -> less_than(ZERO, g9) ->
              isACombination(a, b, g9) ->
              (forall m: Q; isInteger(m) ->
              less_than(ZERO, m) ->
              isACombination(a, b, m) ->
              (not less_than(m, g9))) ->
              isInteger(x9) -> isACombination(a, b, x9) ->
              (exists k: Q; isInteger(k) and
              x9 = rational.mul(g9, k))
            [by generalize generalize-g]
        }
      @discharge-b |
        forall b9: Q; forall g9, x9: Q;
          isInteger(g9) -> less_than(ZERO, g9) ->
          isACombination(a, b9, g9) ->
          (forall m: Q; isInteger(m) ->
          less_than(ZERO, m) ->
          isACombination(a, b9, m) ->
          (not less_than(m, g9))) ->
          isInteger(x9) -> isACombination(a, b9, x9) ->
          (exists k: Q; isInteger(k) and
          x9 = rational.mul(g9, k))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, g, x: Q;
      isInteger(g) -> less_than(ZERO, g) -> isACombination(a, b, g) ->
      (forall m: Q; isInteger(m) -> less_than(ZERO, m) ->
      isACombination(a, b, m) -> (not less_than(m, g))) ->
      isInteger(x) -> isACombination(a, b, x) ->
      (exists k: Q; isInteger(k) and x = rational.mul(g, k))
    [by generalize generalize-a]
qed

// a and b are themselves combinations, at (1, 0) and (0, 1).
theorem bothArgumentsAreCombinations: forall a, b: Q;
  isInteger(a) -> isInteger(b) ->
  (isACombination(a, b, a) and isACombination(a, b, b))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @given-both-integers |
            assume isInteger(a) and isInteger(b) {
              @zero-is-an-integer |
                isInteger(ZERO)
                [using import(rational) zeroIsAnInteger]
              @one-is-an-integer |
                isInteger(ONE)
                [using import(rational) oneIsAnInteger]
              // a = a·1 + b·0
              @a-at-one-zero |
                a = rational.add(rational.mul(a, ONE),
                  rational.mul(b, ZERO))
                [using polynomial(rational)]
              @the-a-pair-works |
                isInteger(ONE) and isInteger(ZERO) and
                  a = rational.add(rational.mul(a, ONE),
                  rational.mul(b, ZERO))
                [using tautology one-is-an-integer zero-is-an-integer a-at-one-zero]
              @the-a-s-witness |
                exists s: Q; isInteger(ONE) and isInteger(s) and
                  a = rational.add(rational.mul(a, ONE),
                  rational.mul(b, s))
                [by witness(ZERO) the-a-pair-works]
              @the-a-r-witness |
                exists r: Q; exists s: Q;
                  isInteger(r) and isInteger(s) and
                  a = rational.add(rational.mul(a, r),
                  rational.mul(b, s))
                [by witness(ONE) the-a-s-witness]
              @the-a-meaning |
                isACombination(a, b, a) iff
                  (exists r: Q; exists s: Q;
                  isInteger(r) and isInteger(s) and
                  a = rational.add(rational.mul(a, r),
                  rational.mul(b, s)))
                [using specialize combinationMeaning(a, b, a)]
              @a-is-a-combination |
                isACombination(a, b, a)
                [using tautology the-a-meaning the-a-r-witness]
              // b = a·0 + b·1
              @b-at-zero-one |
                b = rational.add(rational.mul(a, ZERO),
                  rational.mul(b, ONE))
                [using polynomial(rational)]
              @the-b-pair-works |
                isInteger(ZERO) and isInteger(ONE) and
                  b = rational.add(rational.mul(a, ZERO),
                  rational.mul(b, ONE))
                [using tautology zero-is-an-integer one-is-an-integer b-at-zero-one]
              @the-b-s-witness |
                exists s: Q; isInteger(ZERO) and isInteger(s) and
                  b = rational.add(rational.mul(a, ZERO),
                  rational.mul(b, s))
                [by witness(ONE) the-b-pair-works]
              @the-b-r-witness |
                exists r: Q; exists s: Q;
                  isInteger(r) and isInteger(s) and
                  b = rational.add(rational.mul(a, r),
                  rational.mul(b, s))
                [by witness(ZERO) the-b-s-witness]
              @the-b-meaning |
                isACombination(a, b, b) iff
                  (exists r: Q; exists s: Q;
                  isInteger(r) and isInteger(s) and
                  b = rational.add(rational.mul(a, r),
                  rational.mul(b, s)))
                [using specialize combinationMeaning(a, b, b)]
              @b-is-a-combination |
                isACombination(a, b, b)
                [using tautology the-b-meaning the-b-r-witness]
              @conclusion-both |
                isACombination(a, b, a) and isACombination(a, b, b)
                [by both a-is-a-combination b-is-a-combination]
            }
          @the-implication |
            (isInteger(a) and isInteger(b)) ->
              (isACombination(a, b, a) and isACombination(a, b, b))
            [by discharge given-both-integers]
          @curried |
            isInteger(a) -> isInteger(b) ->
              (isACombination(a, b, a) and isACombination(a, b, b))
            [using tautology the-implication]
        }
      @discharge-b |
        forall b9: Q;
          isInteger(a) -> isInteger(b9) ->
          (isACombination(a, b9, a) and isACombination(a, b9, b9))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q;
      isInteger(a) -> isInteger(b) ->
      (isACombination(a, b, a) and isACombination(a, b, b))
    [by generalize generalize-a]
qed

// The well-ordering hands back leastness over NATURALS; the descent wants it over positive
// INTEGERS. They are the same set (`aPositiveIntegerIsNatural`), so this just re-shapes the
// quantifier — a step that would be invisible in prose but is real here, because `tautology`
// sees a `forall` as one opaque atom and cannot reindex it.
theorem theLeastnessReshapes: forall a, b, g: Q;
  (forall m: Q; isNatural(m) ->
  (less_than(ZERO, m) and isACombination(a, b, m)) ->
  (not less_than(m, g))) ->
  (forall m: Q; isInteger(m) -> less_than(ZERO, m) ->
  isACombination(a, b, m) -> (not less_than(m, g)))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @generalize-g |
            fix g: Q {
              @given-natural-leastness |
                assume forall m: Q; isNatural(m) ->
                  (less_than(ZERO, m) and
                  isACombination(a, b, m)) ->
                  (not less_than(m, g)) {
                  @natural-leastness |
                    forall m: Q; isNatural(m) ->
                      (less_than(ZERO, m) and
                      isACombination(a, b, m)) ->
                      (not less_than(m, g))
                    [by hypothesis given-natural-leastness]
                  @each-integer |
                    fix m: Q {
                      @given-m-is-a-positive-combination |
                        assume isInteger(m) and less_than(ZERO, m) and
                          isACombination(a, b, m) {
                          @the-m-setup |
                            isInteger(m) and less_than(ZERO, m) and
                              isACombination(a, b, m)
                            [by hypothesis given-m-is-a-positive-combination]
                          @m-is-an-integer |
                            isInteger(m)
                            [using tautology the-m-setup]
                          @m-is-positive |
                            less_than(ZERO, m)
                            [using tautology the-m-setup]
                          @m-is-a-combination |
                            isACombination(a, b, m)
                            [using tautology the-m-setup]
                          @m-is-natural |
                            isNatural(m)
                            [using specialize rational_integer_order.aPositiveIntegerIsNatural(m) m-is-an-integer m-is-positive]
                          @the-m-conjunction |
                            less_than(ZERO, m) and
                              isACombination(a, b, m)
                            [by both m-is-positive m-is-a-combination]
                          @conclusion-not-below |
                            not less_than(m, g)
                            [using specialize natural-leastness(m) m-is-natural the-m-conjunction]
                        }
                      @the-m-implication |
                        (isInteger(m) and less_than(ZERO, m) and
                          isACombination(a, b, m)) ->
                          (not less_than(m, g))
                        [by discharge given-m-is-a-positive-combination]
                      @curried-at-m |
                        isInteger(m) -> less_than(ZERO, m) ->
                          isACombination(a, b, m) ->
                          (not less_than(m, g))
                        [using tautology the-m-implication]
                    }
                  @conclusion-reshaped |
                    forall m: Q; isInteger(m) ->
                      less_than(ZERO, m) ->
                      isACombination(a, b, m) ->
                      (not less_than(m, g))
                    [by generalize each-integer]
                }
              @the-implication |
                (forall m: Q; isNatural(m) ->
                  (less_than(ZERO, m) and
                  isACombination(a, b, m)) ->
                  (not less_than(m, g))) ->
                  (forall m: Q; isInteger(m) ->
                  less_than(ZERO, m) ->
                  isACombination(a, b, m) ->
                  (not less_than(m, g)))
                [by discharge given-natural-leastness]
            }
          @discharge-g |
            forall g9: Q;
              (forall m: Q; isNatural(m) ->
              (less_than(ZERO, m) and isACombination(a, b, m)) ->
              (not less_than(m, g9))) ->
              (forall m: Q; isInteger(m) -> less_than(ZERO, m) ->
              isACombination(a, b, m) -> (not less_than(m, g9)))
            [by generalize generalize-g]
        }
      @discharge-b |
        forall b9: Q; forall g9: Q;
          (forall m: Q; isNatural(m) ->
          (less_than(ZERO, m) and isACombination(a, b9, m)) ->
          (not less_than(m, g9))) ->
          (forall m: Q; isInteger(m) -> less_than(ZERO, m) ->
          isACombination(a, b9, m) -> (not less_than(m, g9)))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, g: Q;
      (forall m: Q; isNatural(m) ->
      (less_than(ZERO, m) and isACombination(a, b, m)) ->
      (not less_than(m, g))) ->
      (forall m: Q; isInteger(m) -> less_than(ZERO, m) ->
      isACombination(a, b, m) -> (not less_than(m, g)))
    [by generalize generalize-a]
qed

// A POSITIVE integer dividing ONE is ONE. `anIntegerDividingOneIsAUnit` gives ±1; positivity
// rules out -1, since -1 < 0.
theorem aPositiveIntegerDividingOneIsOneHere: forall e: Q;
  isInteger(e) -> less_than(ZERO, e) ->
  (exists k: Q; isInteger(k) and ONE = rational.mul(e, k)) ->
  e = ONE
proof
  @generalize-e |
    fix e: Q {
      @given-the-setup |
        assume isInteger(e) and less_than(ZERO, e) and
          (exists k: Q; isInteger(k) and
          ONE = rational.mul(e, k)) {
          @the-setup |
            isInteger(e) and less_than(ZERO, e) and
              (exists k: Q; isInteger(k) and
              ONE = rational.mul(e, k))
            [by hypothesis given-the-setup]
          @e-is-an-integer |
            isInteger(e)
            [using tautology the-setup]
          @e-is-positive |
            less_than(ZERO, e)
            [using tautology the-setup]
          @a-quotient-exists |
            exists k: Q; isInteger(k) and
              ONE = rational.mul(e, k)
            [using tautology the-setup]
          @conclusion-with-the-quotient |
            unpack k: Q from a-quotient-exists {
              @the-quotient |
                isInteger(k) and ONE = rational.mul(e, k)
                [by hypothesis conclusion-with-the-quotient]
              @k-is-an-integer |
                isInteger(k)
                [by and_lhs the-quotient]
              @one-factors |
                ONE = rational.mul(e, k)
                [by and_rhs the-quotient]
              @e-is-a-unit |
                e = ONE or e = neg(ONE)
                [using specialize rational_integer_order.anIntegerDividingOneIsAUnit(e, k) e-is-an-integer k-is-an-integer one-factors]
              @conclusion-e-is-one |
                e = ONE
                case e-is-a-unit {
                  @when-one |
                    assume e = ONE {
                      @conclusion-already |
                        e = ONE
                        [by hypothesis when-one]
                    }
                  // e = -1 contradicts 0 < e
                  @when-minus-one |
                    assume e = neg(ONE) {
                      @e-is-minus-one |
                        e = neg(ONE)
                        [by hypothesis when-minus-one]
                      @minus-one-is-positive |
                        less_than(ZERO, neg(ONE))
                        [by rewrite e-is-minus-one e-is-positive]
                      @zero-below-one |
                        less_than(ZERO, ONE)
                        [using model(rational.RationalOrderedField) field_order.zeroLessThanOne]
                      // 0 < -1 and 0 < 1 give 0 < 0 by transitivity through
                      // the shift, which irreflexivity forbids
                      @shifting-the-order |
                        forall p, q, z: Q;
                          less_than(p, q) ->
                          less_than(rational.add(p, z),
                          rational.add(q, z))
                        [using import(rational) lessThanAddRight]
                      @shifted-by-one |
                        less_than(rational.add(ZERO, ONE),
                          rational.add(neg(ONE), ONE))
                        [using specialize shifting-the-order(ZERO, neg(ONE), ONE) minus-one-is-positive]
                      @the-left-is-one |
                        rational.add(ZERO, ONE) = ONE
                        [using polynomial(rational)]
                      @the-right-is-zero |
                        rational.add(neg(ONE), ONE) = ZERO
                        [using polynomial(rational)]
                      @one-below-the-right |
                        less_than(ONE, rational.add(neg(ONE), ONE))
                        [by rewrite the-left-is-one shifted-by-one]
                      @one-below-zero |
                        less_than(ONE, ZERO)
                        [by rewrite the-right-is-zero one-below-the-right]
                      @the-transitivity |
                        forall p, q, z: Q;
                          less_than(p, q) -> less_than(q, z) ->
                          less_than(p, z)
                        [using import(rational) lessThanTransitive]
                      @zero-below-zero |
                        less_than(ZERO, ZERO)
                        [using specialize the-transitivity(ZERO, ONE, ZERO) zero-below-one one-below-zero]
                      @zero-not-below-zero |
                        not less_than(ZERO, ZERO)
                        [using specialize rational.lessThanIrreflexive(ZERO)]
                      @conclusion-impossible |
                        e = ONE
                        [by ex_falso zero-below-zero zero-not-below-zero]
                    }
                }
            }
          @the-exported |
            e = ONE
            [by unpacked conclusion-with-the-quotient]
        }
      @the-implication |
        (isInteger(e) and less_than(ZERO, e) and
          (exists k: Q; isInteger(k) and
          ONE = rational.mul(e, k))) ->
          e = ONE
        [by discharge given-the-setup]
      @curried |
        isInteger(e) -> less_than(ZERO, e) ->
          (exists k: Q; isInteger(k) and
          ONE = rational.mul(e, k)) ->
          e = ONE
        [using tautology the-implication]
    }
  @conclusion |
    forall e: Q;
      isInteger(e) -> less_than(ZERO, e) ->
      (exists k: Q; isInteger(k) and ONE = rational.mul(e, k)) ->
      e = ONE
    [by generalize generalize-e]
qed

// -- BÉZOUT ---------------------------------------------------------------------------------
// For a POSITIVE a and any integer b, a coprime pair admits a Bézout certificate.
//
// Positivity of a (rather than mere nonzeroness) is what 17.14's caller actually has —
// `aReducedFractionExists` delivers a positive numerator — and it saves an `abs` layer the
// cut does not have: a itself is then the positive combination the well-ordering starts from.
//
// Coprimality is the QUANTIFIED reading, matching `arePairwiseRelativelyPrime`: every integer
// dividing both divides ONE. That is exactly what the descent's conclusion feeds.
theorem bezoutOnTheCut: forall a, b: Q;
  isInteger(a) -> isInteger(b) -> less_than(ZERO, a) ->
  (forall e: Q; isInteger(e) ->
  (exists k: Q; isInteger(k) and a = rational.mul(e, k)) ->
  (exists k: Q; isInteger(k) and b = rational.mul(e, k)) ->
  (exists k: Q; isInteger(k) and ONE = rational.mul(e, k))) ->
  (exists r, s: Q; isInteger(r) and isInteger(s) and
  rational.add(rational.mul(a, r), rational.mul(b, s)) = ONE)
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @given-the-setup |
            assume isInteger(a) and isInteger(b) and
              less_than(ZERO, a) and
              (forall e: Q; isInteger(e) ->
              (exists k: Q; isInteger(k) and
              a = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              b = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              ONE = rational.mul(e, k))) {
              @the-setup |
                isInteger(a) and isInteger(b) and
                  less_than(ZERO, a) and
                  (forall e: Q; isInteger(e) ->
                  (exists k: Q; isInteger(k) and
                  a = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  b = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  ONE = rational.mul(e, k)))
                [by hypothesis given-the-setup]
              @a-is-an-integer |
                isInteger(a)
                [using tautology the-setup]
              @b-is-an-integer |
                isInteger(b)
                [using tautology the-setup]
              @a-is-positive |
                less_than(ZERO, a)
                [using tautology the-setup]
              @the-coprimality |
                forall e: Q; isInteger(e) ->
                  (exists k: Q; isInteger(k) and
                  a = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  b = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  ONE = rational.mul(e, k))
                [using tautology the-setup]
              @both-are-combinations |
                isACombination(a, b, a) and isACombination(a, b, b)
                [using specialize bothArgumentsAreCombinations(a, b) a-is-an-integer b-is-an-integer]
              @a-is-a-combination |
                isACombination(a, b, a)
                [by and_lhs both-are-combinations]
              @b-is-a-combination |
                isACombination(a, b, b)
                [by and_rhs both-are-combinations]
              // a is a POSITIVE combination, so the set is inhabited
              @a-is-natural |
                isNatural(a)
                [using specialize rational_integer_order.aPositiveIntegerIsNatural(a) a-is-an-integer a-is-positive]
              @the-inhabitant |
                isNatural(a) and (less_than(ZERO, a) and
                  isACombination(a, b, a))
                [using tautology a-is-natural a-is-positive a-is-a-combination]
              @inhabited |
                exists n: Q; isNatural(n) and
                  (less_than(ZERO, n) and isACombination(a, b, n))
                [by witness(a) the-inhabitant]
              // well-order the POSITIVE combinations
              @the-well-ordering |
                (exists n: Q; isNatural(n) and
                  (less_than(ZERO, n) and
                  isACombination(a, b, n))) ->
                  (exists least: Q; isNatural(least) and
                  (less_than(ZERO, least) and
                  isACombination(a, b, least)) and
                  (forall m: Q; isNatural(m) ->
                  (less_than(ZERO, m) and
                  isACombination(a, b, m)) ->
                  (not less_than(m, least))))
                [using instantiation natural_wellordering.naturalWellOrdering(fun n: Q => (less_than(ZERO, n) and isACombination(a, b, n)))]
              @a-least-exists |
                exists least: Q; isNatural(least) and
                  (less_than(ZERO, least) and
                  isACombination(a, b, least)) and
                  (forall m: Q; isNatural(m) ->
                  (less_than(ZERO, m) and
                  isACombination(a, b, m)) ->
                  (not less_than(m, least)))
                [by modus_ponens the-well-ordering inhabited]
              @conclusion-with-the-least |
                unpack g: Q from a-least-exists {
                  @the-least-parts |
                    isNatural(g) and
                      (less_than(ZERO, g) and
                      isACombination(a, b, g)) and
                      (forall m: Q; isNatural(m) ->
                      (less_than(ZERO, m) and
                      isACombination(a, b, m)) ->
                      (not less_than(m, g)))
                    [by hypothesis conclusion-with-the-least]
                  @g-is-natural |
                    isNatural(g)
                    [using tautology the-least-parts]
                  @g-is-positive |
                    less_than(ZERO, g)
                    [using tautology the-least-parts]
                  @g-is-a-combination |
                    isACombination(a, b, g)
                    [using tautology the-least-parts]
                  @g-is-least-among-naturals |
                    forall m: Q; isNatural(m) ->
                      (less_than(ZERO, m) and
                      isACombination(a, b, m)) ->
                      (not less_than(m, g))
                    [using tautology the-least-parts]
                  @g-is-an-integer |
                    isInteger(g)
                    [using specialize rational.isNaturalIsInteger(g) g-is-natural]
                  // re-shape leastness to the descent's interface: over INTEGERS
                  // rather than naturals (a positive integer IS natural)
                  @g-is-least |
                    forall m: Q; isInteger(m) ->
                      less_than(ZERO, m) ->
                      isACombination(a, b, m) ->
                      (not less_than(m, g))
                    [using specialize theLeastnessReshapes(a, b, g) g-is-least-among-naturals]
                  // g divides both a and b
                  @g-divides-a |
                    exists k: Q; isInteger(k) and
                      a = rational.mul(g, k)
                    [using specialize theLeastPositiveCombinationDividesEveryCombination(a, b, g, a) g-is-an-integer g-is-positive g-is-a-combination g-is-least a-is-an-integer a-is-a-combination]
                  @g-divides-b |
                    exists k: Q; isInteger(k) and
                      b = rational.mul(g, k)
                    [using specialize theLeastPositiveCombinationDividesEveryCombination(a, b, g, b) g-is-an-integer g-is-positive g-is-a-combination g-is-least b-is-an-integer b-is-a-combination]
                  // so coprimality makes g divide ONE, hence g = ONE
                  @g-divides-one |
                    exists k: Q; isInteger(k) and
                      ONE = rational.mul(g, k)
                    [using specialize the-coprimality(g) g-is-an-integer g-divides-a g-divides-b]
                  @g-is-one |
                    g = ONE
                    [using specialize aPositiveIntegerDividingOneIsOneHere(g) g-is-an-integer g-is-positive g-divides-one]
                  // unfold g's own combination at g = ONE
                  @the-g-meaning |
                    isACombination(a, b, g) iff
                      (exists r: Q; exists s: Q;
                      isInteger(r) and isInteger(s) and
                      g = rational.add(rational.mul(a, r),
                      rational.mul(b, s)))
                    [using specialize combinationMeaning(a, b, g)]
                  @a-g-pair-exists |
                    exists r: Q; exists s: Q;
                      isInteger(r) and isInteger(s) and
                      g = rational.add(rational.mul(a, r),
                      rational.mul(b, s))
                    [using tautology the-g-meaning g-is-a-combination]
                  @conclusion-with-the-pair |
                    unpack r: Q from a-g-pair-exists {
                      @the-s-exists |
                        exists s: Q;
                          isInteger(r) and isInteger(s) and
                          g = rational.add(rational.mul(a, r),
                          rational.mul(b, s))
                        [by hypothesis conclusion-with-the-pair]
                      @conclusion-with-the-pair-inner |
                        unpack s: Q from the-s-exists {
                          @the-pair |
                            isInteger(r) and isInteger(s) and
                              g = rational.add(
                              rational.mul(a, r),
                              rational.mul(b, s))
                            [by hypothesis conclusion-with-the-pair-inner]
                          @r-is-an-integer |
                            isInteger(r)
                            [using tautology the-pair]
                          @s-is-an-integer |
                            isInteger(s)
                            [using tautology the-pair]
                          @g-expands |
                            g = rational.add(rational.mul(a, r),
                              rational.mul(b, s))
                            [using tautology the-pair]
                          @one-expands |
                            ONE = rational.add(
                              rational.mul(a, r),
                              rational.mul(b, s))
                            [by rewrite g-is-one g-expands]
                          @the-combination-is-one |
                            rational.add(rational.mul(a, r),
                              rational.mul(b, s)) = ONE
                            [by symmetry one-expands]
                          @the-pair-works |
                            isInteger(r) and isInteger(s) and
                              rational.add(rational.mul(a, r),
                              rational.mul(b, s)) = ONE
                            [using tautology r-is-an-integer s-is-an-integer the-combination-is-one]
                          @the-s-witness |
                            exists s2: Q; isInteger(r) and
                              isInteger(s2) and
                              rational.add(rational.mul(a, r),
                              rational.mul(b, s2)) = ONE
                            [by witness(s) the-pair-works]
                          @conclusion-the-certificate |
                            exists r2, s2: Q; isInteger(r2) and
                              isInteger(s2) and
                              rational.add(rational.mul(a, r2),
                              rational.mul(b, s2)) = ONE
                            [by witness(r) the-s-witness]
                        }
                      @the-inner-exported |
                        exists r2, s2: Q; isInteger(r2) and
                          isInteger(s2) and
                          rational.add(rational.mul(a, r2),
                          rational.mul(b, s2)) = ONE
                        [by unpacked conclusion-with-the-pair-inner]
                    }
                  @the-pair-exported |
                    exists r2, s2: Q; isInteger(r2) and
                      isInteger(s2) and
                      rational.add(rational.mul(a, r2),
                      rational.mul(b, s2)) = ONE
                    [by unpacked conclusion-with-the-pair]
                }
              @the-least-exported |
                exists r2, s2: Q; isInteger(r2) and isInteger(s2) and
                  rational.add(rational.mul(a, r2),
                  rational.mul(b, s2)) = ONE
                [by unpacked conclusion-with-the-least]
            }
          @the-implication |
            (isInteger(a) and isInteger(b) and
              less_than(ZERO, a) and
              (forall e: Q; isInteger(e) ->
              (exists k: Q; isInteger(k) and
              a = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              b = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              ONE = rational.mul(e, k)))) ->
              (exists r, s: Q; isInteger(r) and isInteger(s) and
              rational.add(rational.mul(a, r),
              rational.mul(b, s)) = ONE)
            [by discharge given-the-setup]
          @curried |
            isInteger(a) -> isInteger(b) -> less_than(ZERO, a) ->
              (forall e: Q; isInteger(e) ->
              (exists k: Q; isInteger(k) and
              a = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              b = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              ONE = rational.mul(e, k))) ->
              (exists r, s: Q; isInteger(r) and isInteger(s) and
              rational.add(rational.mul(a, r),
              rational.mul(b, s)) = ONE)
            [using tautology the-implication]
        }
      @discharge-b |
        forall b9: Q;
          isInteger(a) -> isInteger(b9) -> less_than(ZERO, a) ->
          (forall e: Q; isInteger(e) ->
          (exists k: Q; isInteger(k) and a = rational.mul(e, k)) ->
          (exists k: Q; isInteger(k) and b9 = rational.mul(e, k)) ->
          (exists k: Q; isInteger(k) and ONE = rational.mul(e, k))) ->
          (exists r, s: Q; isInteger(r) and isInteger(s) and
          rational.add(rational.mul(a, r),
          rational.mul(b9, s)) = ONE)
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q;
      isInteger(a) -> isInteger(b) -> less_than(ZERO, a) ->
      (forall e: Q; isInteger(e) ->
      (exists k: Q; isInteger(k) and a = rational.mul(e, k)) ->
      (exists k: Q; isInteger(k) and b = rational.mul(e, k)) ->
      (exists k: Q; isInteger(k) and ONE = rational.mul(e, k))) ->
      (exists r, s: Q; isInteger(r) and isInteger(s) and
      rational.add(rational.mul(a, r), rational.mul(b, s)) = ONE)
    [by generalize generalize-a]
qed

// -- SMALL ALGEBRAIC LAWS, STATED ABSTRACTLY -----------------------------------------------
// `polynomial(rational)` cannot look inside a term whose subterm has a `Nat` argument (a
// power's exponent): it reports `expected sort 'Q', got 'Nat'`. Stating the law over ABSTRACT
// ℚ variables and specializing at the compound term keeps the tactic away from the exponent.
theorem addingAndSubtractingCancels: forall x, y: Q;
  rational.add(rational.add(x, y), neg(y)) = x
proof
  @generalize-x |
    fix x: Q {
      @generalize-y |
        fix y: Q {
          @conclusion-cancels |
            rational.add(rational.add(x, y), neg(y)) = x
            [using polynomial(rational)]
        }
      @discharge-y |
        forall y9: Q;
          rational.add(rational.add(x, y9), neg(y9)) = x
        [by generalize generalize-y]
    }
  @conclusion |
    forall x, y: Q;
      rational.add(rational.add(x, y), neg(y)) = x
    [by generalize generalize-x]
qed

// `0 + (-(a·b)) = a·(-b)` — same reason.
theorem theNegatedProductFromZero: forall a, b: Q;
  rational.add(ZERO, neg(rational.mul(a, b))) =
  rational.mul(a, neg(b))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @conclusion-negated |
            rational.add(ZERO, neg(rational.mul(a, b))) =
              rational.mul(a, neg(b))
            [using polynomial(rational)]
        }
      @discharge-b |
        forall b9: Q;
          rational.add(ZERO, neg(rational.mul(a, b9))) =
          rational.mul(a, neg(b9))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Q;
      rational.add(ZERO, neg(rational.mul(a, b))) =
      rational.mul(a, neg(b))
    [by generalize generalize-a]
qed

// `n = a·b` with a and b integers makes n an integer — the form the cleared-sum induction
// needs, where n is named by a defining clause rather than written as the product.
theorem theScaledIntegerIsAnInteger: forall a, b, n: Q;
  isInteger(a) -> isInteger(b) -> n = rational.mul(a, b) ->
  isInteger(n)
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @generalize-n |
            fix n: Q {
              @given-the-setup |
                assume isInteger(a) and isInteger(b) and
                  n = rational.mul(a, b) {
                  @the-setup |
                    isInteger(a) and isInteger(b) and
                      n = rational.mul(a, b)
                    [by hypothesis given-the-setup]
                  @a-is-an-integer |
                    isInteger(a)
                    [using tautology the-setup]
                  @b-is-an-integer |
                    isInteger(b)
                    [using tautology the-setup]
                  @n-factors |
                    n = rational.mul(a, b)
                    [using tautology the-setup]
                  @the-product-is-an-integer |
                    isInteger(rational.mul(a, b))
                    [using specialize rational.isIntegerMul(a, b) a-is-an-integer b-is-an-integer]
                  @conclusion-n-is-an-integer |
                    isInteger(n)
                    [by rewrite n-factors the-product-is-an-integer]
                }
              @the-implication |
                (isInteger(a) and isInteger(b) and
                  n = rational.mul(a, b)) -> isInteger(n)
                [by discharge given-the-setup]
              @curried |
                isInteger(a) -> isInteger(b) ->
                  n = rational.mul(a, b) -> isInteger(n)
                [using tautology the-implication]
            }
          @discharge-n |
            forall n9: Q;
              isInteger(a) -> isInteger(b) ->
              n9 = rational.mul(a, b) -> isInteger(n9)
            [by generalize generalize-n]
        }
      @discharge-b |
        forall b9, n9: Q;
          isInteger(a) -> isInteger(b9) ->
          n9 = rational.mul(a, b9) -> isInteger(n9)
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b, n: Q;
      isInteger(a) -> isInteger(b) -> n = rational.mul(a, b) ->
      isInteger(n)
    [by generalize generalize-a]
qed

// The negation of a multiple is a multiple.
theorem theNegationOfAMultipleIsAMultiple: forall d, n: Q;
  (exists k: Q; isInteger(k) and n = rational.mul(d, k)) ->
  (exists k: Q; isInteger(k) and neg(n) = rational.mul(d, k))
proof
  @generalize-d |
    fix d: Q {
      @generalize-n |
        fix n: Q {
          @given-a-multiple |
            assume exists k: Q; isInteger(k) and
              n = rational.mul(d, k) {
              @a-multiple |
                exists k: Q; isInteger(k) and
                  n = rational.mul(d, k)
                [by hypothesis given-a-multiple]
              @conclusion-negated |
                unpack k: Q from a-multiple {
                  @the-quotient |
                    isInteger(k) and n = rational.mul(d, k)
                    [by hypothesis conclusion-negated]
                  @k-is-an-integer |
                    isInteger(k)
                    [by and_lhs the-quotient]
                  @n-factors |
                    n = rational.mul(d, k)
                    [by and_rhs the-quotient]
                  @minus-k-is-an-integer |
                    isInteger(neg(k))
                    [using specialize rational.isIntegerNeg(k) k-is-an-integer]
                  @the-negated-product |
                    neg(rational.mul(d, k)) =
                      rational.mul(d, neg(k))
                    [using polynomial(rational)]
                  @reflexivity-of-the-negation |
                    neg(n) = neg(n)
                    [by reflexivity]
                  @the-negation-at-the-factorization |
                    neg(n) = neg(rational.mul(d, k))
                    [by rewrite n-factors reflexivity-of-the-negation]
                  @the-negation-factors |
                    neg(n) = rational.mul(d, neg(k))
                    [by rewrite the-negated-product the-negation-at-the-factorization]
                  @the-negated-quotient-works |
                    isInteger(neg(k)) and
                      neg(n) = rational.mul(d, neg(k))
                    [by both minus-k-is-an-integer the-negation-factors]
                  @conclusion-a-negated-quotient |
                    exists k2: Q; isInteger(k2) and
                      neg(n) = rational.mul(d, k2)
                    [by witness(neg(k)) the-negated-quotient-works]
                }
              @the-exported |
                exists k2: Q; isInteger(k2) and
                  neg(n) = rational.mul(d, k2)
                [by unpacked conclusion-negated]
            }
          @the-implication |
            (exists k: Q; isInteger(k) and
              n = rational.mul(d, k)) ->
              (exists k: Q; isInteger(k) and
              neg(n) = rational.mul(d, k))
            [by discharge given-a-multiple]
        }
      @discharge-n |
        forall n9: Q;
          (exists k: Q; isInteger(k) and
          n9 = rational.mul(d, k)) ->
          (exists k: Q; isInteger(k) and
          neg(n9) = rational.mul(d, k))
        [by generalize generalize-n]
    }
  @conclusion |
    forall d, n: Q;
      (exists k: Q; isInteger(k) and n = rational.mul(d, k)) ->
      (exists k: Q; isInteger(k) and neg(n) = rational.mul(d, k))
    [by generalize generalize-d]
qed

// From `x + y = 0`, y is the negation of x.
theorem theOtherSummandIsTheNegation: forall x, y: Q;
  rational.add(x, y) = ZERO -> y = neg(x)
proof
  @generalize-x |
    fix x: Q {
      @generalize-y |
        fix y: Q {
          @given-the-sum-vanishes |
            assume rational.add(x, y) = ZERO {
              @the-sum-vanishes |
                rational.add(x, y) = ZERO
                [by hypothesis given-the-sum-vanishes]
              @the-isolation |
                rational.add(neg(x), rational.add(x, y)) = y
                [using polynomial(rational)]
              @the-isolation-at-zero |
                rational.add(neg(x), ZERO) = y
                [by rewrite the-sum-vanishes the-isolation]
              @adding-zero |
                rational.add(neg(x), ZERO) = neg(x)
                [using polynomial(rational)]
              @the-negation-is-y |
                neg(x) = y
                [by rewrite adding-zero the-isolation-at-zero]
              @conclusion-y-is-the-negation |
                y = neg(x)
                [by symmetry the-negation-is-y]
            }
          @the-implication |
            rational.add(x, y) = ZERO -> y = neg(x)
            [by discharge given-the-sum-vanishes]
        }
      @discharge-y |
        forall y9: Q;
          rational.add(x, y9) = ZERO -> y9 = neg(x)
        [by generalize generalize-y]
    }
  @conclusion |
    forall x, y: Q;
      rational.add(x, y) = ZERO -> y = neg(x)
    [by generalize generalize-x]
qed

// -- BÉZOUT WITH THE ROLES SWAPPED ---------------------------------------------------------
// `bezoutOnTheCut` wants its FIRST argument positive (that is what makes it the positive
// combination the well-ordering starts from). 17.14's denominator half needs the certificate
// with s first, and has only `s != 0` for it — but it DOES have `0 < r`. So run the original
// at (r, s) and commute the sum: `r·x + s·y = 1` is `s·y + r·x = 1`.
//
// The coprimality argument order also flips, which is why this is not a one-line alias: the
// quantified reading is symmetric in content but not in the order its two premises appear.
theorem bezoutOnTheCutSwapped: forall s, r: Q;
  isInteger(s) -> isInteger(r) -> less_than(ZERO, r) ->
  (forall e: Q; isInteger(e) ->
  (exists k: Q; isInteger(k) and r = rational.mul(e, k)) ->
  (exists k: Q; isInteger(k) and s = rational.mul(e, k)) ->
  (exists k: Q; isInteger(k) and ONE = rational.mul(e, k))) ->
  (exists cs, cr: Q; isInteger(cs) and isInteger(cr) and
  rational.add(rational.mul(s, cs), rational.mul(r, cr)) = ONE)
proof
  @generalize-s |
    fix s: Q {
      @generalize-r |
        fix r: Q {
          @given-the-setup |
            assume isInteger(s) and isInteger(r) and
              less_than(ZERO, r) and
              (forall e: Q; isInteger(e) ->
              (exists k: Q; isInteger(k) and
              r = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              s = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              ONE = rational.mul(e, k))) {
              @the-setup |
                isInteger(s) and isInteger(r) and
                  less_than(ZERO, r) and
                  (forall e: Q; isInteger(e) ->
                  (exists k: Q; isInteger(k) and
                  r = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  s = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  ONE = rational.mul(e, k)))
                [by hypothesis given-the-setup]
              @s-is-an-integer |
                isInteger(s)
                [using tautology the-setup]
              @r-is-an-integer |
                isInteger(r)
                [using tautology the-setup]
              @r-is-positive |
                less_than(ZERO, r)
                [using tautology the-setup]
              @the-coprimality |
                forall e: Q; isInteger(e) ->
                  (exists k: Q; isInteger(k) and
                  r = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  s = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  ONE = rational.mul(e, k))
                [using tautology the-setup]
              @the-certificate-at-r-first |
                exists cr, cs: Q; isInteger(cr) and isInteger(cs) and
                  rational.add(rational.mul(r, cr),
                  rational.mul(s, cs)) = ONE
                [using specialize bezoutOnTheCut(r, s) r-is-an-integer s-is-an-integer r-is-positive the-coprimality]
              @conclusion-swapped |
                unpack cr: Q from the-certificate-at-r-first {
                  @the-s-coefficient-exists |
                    exists cs: Q; isInteger(cr) and isInteger(cs) and
                      rational.add(rational.mul(r, cr),
                      rational.mul(s, cs)) = ONE
                    [by hypothesis conclusion-swapped]
                  @conclusion-swapped-inner |
                    unpack cs: Q from the-s-coefficient-exists {
                      @the-certificate-parts |
                        isInteger(cr) and isInteger(cs) and
                          rational.add(rational.mul(r, cr),
                          rational.mul(s, cs)) = ONE
                        [by hypothesis conclusion-swapped-inner]
                      @cr-is-an-integer |
                        isInteger(cr)
                        [using tautology the-certificate-parts]
                      @cs-is-an-integer |
                        isInteger(cs)
                        [using tautology the-certificate-parts]
                      @the-certificate |
                        rational.add(rational.mul(r, cr),
                          rational.mul(s, cs)) = ONE
                        [using tautology the-certificate-parts]
                      @the-commuted-sum |
                        rational.add(rational.mul(s, cs),
                          rational.mul(r, cr)) =
                          rational.add(rational.mul(r, cr),
                          rational.mul(s, cs))
                        [using polynomial(rational)]
                      @the-swapped-certificate |
                        rational.add(rational.mul(s, cs),
                          rational.mul(r, cr)) = ONE
                        [by rewrite the-commuted-sum the-certificate]
                      @the-swapped-pair-works |
                        isInteger(cs) and isInteger(cr) and
                          rational.add(rational.mul(s, cs),
                          rational.mul(r, cr)) = ONE
                        [using tautology cs-is-an-integer cr-is-an-integer the-swapped-certificate]
                      @the-cr-witness |
                        exists cr2: Q; isInteger(cs) and
                          isInteger(cr2) and
                          rational.add(rational.mul(s, cs),
                          rational.mul(r, cr2)) = ONE
                        [by witness(cr) the-swapped-pair-works]
                      @conclusion-both-swapped |
                        exists cs2, cr2: Q; isInteger(cs2) and
                          isInteger(cr2) and
                          rational.add(rational.mul(s, cs2),
                          rational.mul(r, cr2)) = ONE
                        [by witness(cs) the-cr-witness]
                    }
                  @the-inner-exported |
                    exists cs2, cr2: Q; isInteger(cs2) and
                      isInteger(cr2) and
                      rational.add(rational.mul(s, cs2),
                      rational.mul(r, cr2)) = ONE
                    [by unpacked conclusion-swapped-inner]
                }
              @the-outer-exported |
                exists cs2, cr2: Q; isInteger(cs2) and
                  isInteger(cr2) and
                  rational.add(rational.mul(s, cs2),
                  rational.mul(r, cr2)) = ONE
                [by unpacked conclusion-swapped]
            }
          @the-implication |
            (isInteger(s) and isInteger(r) and
              less_than(ZERO, r) and
              (forall e: Q; isInteger(e) ->
              (exists k: Q; isInteger(k) and
              r = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              s = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              ONE = rational.mul(e, k)))) ->
              (exists cs, cr: Q; isInteger(cs) and isInteger(cr) and
              rational.add(rational.mul(s, cs),
              rational.mul(r, cr)) = ONE)
            [by discharge given-the-setup]
          @curried |
            isInteger(s) -> isInteger(r) -> less_than(ZERO, r) ->
              (forall e: Q; isInteger(e) ->
              (exists k: Q; isInteger(k) and
              r = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              s = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              ONE = rational.mul(e, k))) ->
              (exists cs, cr: Q; isInteger(cs) and isInteger(cr) and
              rational.add(rational.mul(s, cs),
              rational.mul(r, cr)) = ONE)
            [using tautology the-implication]
        }
      @discharge-r |
        forall r9: Q;
          isInteger(s) -> isInteger(r9) -> less_than(ZERO, r9) ->
          (forall e: Q; isInteger(e) ->
          (exists k: Q; isInteger(k) and r9 = rational.mul(e, k)) ->
          (exists k: Q; isInteger(k) and s = rational.mul(e, k)) ->
          (exists k: Q; isInteger(k) and ONE = rational.mul(e, k))) ->
          (exists cs, cr: Q; isInteger(cs) and isInteger(cr) and
          rational.add(rational.mul(s, cs),
          rational.mul(r9, cr)) = ONE)
        [by generalize generalize-r]
    }
  @conclusion |
    forall s, r: Q;
      isInteger(s) -> isInteger(r) -> less_than(ZERO, r) ->
      (forall e: Q; isInteger(e) ->
      (exists k: Q; isInteger(k) and r = rational.mul(e, k)) ->
      (exists k: Q; isInteger(k) and s = rational.mul(e, k)) ->
      (exists k: Q; isInteger(k) and ONE = rational.mul(e, k))) ->
      (exists cs, cr: Q; isInteger(cs) and isInteger(cr) and
      rational.add(rational.mul(s, cs), rational.mul(r, cr)) = ONE)
    [by generalize generalize-s]
qed

// -- PRIMALITY ON THE CUT ------------------------------------------------------------------
// Eisenstein's sign argument needs "p prime and p | ab implies p | a or p | b" for a modulus
// living on ℚ's integer cut. `std/primes.b4m`'s `is_prime` is over `Int` and cannot transfer
// (its corpus reaches the nested-transfer wall), so primality is restated here.
//
// Defined the IRREDUCIBILITY way, matching `std/primes.b4m`: bigger than one, and its only
// positive divisors are one and itself. Euclid's product property is then PROVED from it via
// `bezoutOnTheCut`, not assumed — which is the point of doing it this way rather than
// defining a prime element by the product property directly.
define isPrimeOnTheCut(p) =
  less_than(ONE, p) and
  (forall d: Q; isInteger(d) -> less_than(ZERO, d) ->
  (exists k: Q; isInteger(k) and p = rational.mul(d, k)) ->
  (d = ONE or d = p))

// Negating a divisor keeps it a divisor: `n = e·k` is `n = (-e)·(-k)`. Stated on the raw
// existential because `dividesIntegrally` lives downstream in `integer-product.b4m`, which
// imports this file.
theorem theNegationStillDivides: forall e, n: Q;
  (exists k: Q; isInteger(k) and n = rational.mul(e, k)) ->
  (exists k: Q; isInteger(k) and n = rational.mul(neg(e), k))
proof
  @generalize-e |
    fix e: Q {
      @generalize-n |
        fix n: Q {
          @given-a-quotient |
            assume exists k: Q; isInteger(k) and
              n = rational.mul(e, k) {
              @a-quotient |
                exists k: Q; isInteger(k) and
                  n = rational.mul(e, k)
                [by hypothesis given-a-quotient]
              @with-the-quotient |
                unpack k: Q from a-quotient {
                  @the-quotient |
                    isInteger(k) and n = rational.mul(e, k)
                    [by hypothesis with-the-quotient]
                  @k-is-an-integer |
                    isInteger(k)
                    [by and_lhs the-quotient]
                  @n-factors |
                    n = rational.mul(e, k)
                    [by and_rhs the-quotient]
                  @minus-k-is-an-integer |
                    isInteger(neg(k))
                    [using specialize rational.isIntegerNeg(k) k-is-an-integer]
                  @the-double-negation |
                    rational.mul(e, k) =
                      rational.mul(neg(e), neg(k))
                    [using polynomial(rational)]
                  @n-factors-negated |
                    n = rational.mul(neg(e), neg(k))
                    [by rewrite the-double-negation n-factors]
                  @the-negated-quotient-works |
                    isInteger(neg(k)) and
                      n = rational.mul(neg(e), neg(k))
                    [by both minus-k-is-an-integer n-factors-negated]
                  @conclusion-a-negated-quotient |
                    exists k2: Q; isInteger(k2) and
                      n = rational.mul(neg(e), k2)
                    [by witness(neg(k)) the-negated-quotient-works]
                }
              @the-exported |
                exists k2: Q; isInteger(k2) and
                  n = rational.mul(neg(e), k2)
                [by unpacked with-the-quotient]
            }
          @the-implication |
            (exists k: Q; isInteger(k) and
              n = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              n = rational.mul(neg(e), k))
            [by discharge given-a-quotient]
        }
      @discharge-n |
        forall n9: Q;
          (exists k: Q; isInteger(k) and
          n9 = rational.mul(e, k)) ->
          (exists k: Q; isInteger(k) and
          n9 = rational.mul(neg(e), k))
        [by generalize generalize-n]
    }
  @conclusion |
    forall e, n: Q;
      (exists k: Q; isInteger(k) and n = rational.mul(e, k)) ->
      (exists k: Q; isInteger(k) and n = rational.mul(neg(e), k))
    [by generalize generalize-e]
qed

// The negative arm of the trichotomy: for e < 0, run primality on -e > 0. Then -e = 1 gives
// e = -1, and -e = p is ruled out because it would make p divide `a`.
theorem theNegativeDivisorCase: forall p, a, e: Q;
  isInteger(e) -> less_than(ONE, p) ->
  (forall d: Q; isInteger(d) -> less_than(ZERO, d) ->
  (exists k: Q; isInteger(k) and p = rational.mul(d, k)) ->
  (d = ONE or d = p)) ->
  (not (exists k: Q; isInteger(k) and a = rational.mul(p, k))) ->
  (exists k: Q; isInteger(k) and p = rational.mul(e, k)) ->
  (exists k: Q; isInteger(k) and a = rational.mul(e, k)) ->
  less_than(e, ZERO) ->
  (e = ONE or e = neg(ONE))
proof
  @generalize-p |
    fix p: Q {
      @generalize-a |
        fix a: Q {
          @generalize-e |
            fix e: Q {
              @given-the-setup |
                assume isInteger(e) and less_than(ONE, p) and
                  (forall d: Q; isInteger(d) ->
                  less_than(ZERO, d) ->
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(d, k)) ->
                  (d = ONE or d = p)) and
                  (not (exists k: Q; isInteger(k) and
                  a = rational.mul(p, k))) and
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(e, k)) and
                  (exists k: Q; isInteger(k) and
                  a = rational.mul(e, k)) and
                  less_than(e, ZERO) {
                  @the-setup |
                    isInteger(e) and less_than(ONE, p) and
                      (forall d: Q; isInteger(d) ->
                      less_than(ZERO, d) ->
                      (exists k: Q; isInteger(k) and
                      p = rational.mul(d, k)) ->
                      (d = ONE or d = p)) and
                      (not (exists k: Q; isInteger(k) and
                      a = rational.mul(p, k))) and
                      (exists k: Q; isInteger(k) and
                      p = rational.mul(e, k)) and
                      (exists k: Q; isInteger(k) and
                      a = rational.mul(e, k)) and
                      less_than(e, ZERO)
                    [by hypothesis given-the-setup]
                  @e-is-an-integer |
                    isInteger(e)
                    [using tautology the-setup]
                  @the-only-divisors |
                    forall d: Q; isInteger(d) ->
                      less_than(ZERO, d) ->
                      (exists k: Q; isInteger(k) and
                      p = rational.mul(d, k)) ->
                      (d = ONE or d = p)
                    [using tautology the-setup]
                  @p-misses-a |
                    not (exists k: Q; isInteger(k) and
                      a = rational.mul(p, k))
                    [using tautology the-setup]
                  @e-divides-p |
                    exists k: Q; isInteger(k) and
                      p = rational.mul(e, k)
                    [using tautology the-setup]
                  @e-divides-a |
                    exists k: Q; isInteger(k) and
                      a = rational.mul(e, k)
                    [using tautology the-setup]
                  @e-is-negative |
                    less_than(e, ZERO)
                    [using tautology the-setup]
                  // -e is a positive integer dividing both
                  @negatives-of-negatives |
                    forall x: Q; less_than(x, ZERO) ->
                      less_than(ZERO, neg(x))
                    [using model(rational.RationalOrderedField) field_order.negOfNegativeIsPositive]
                  @minus-e-is-positive |
                    less_than(ZERO, neg(e))
                    [using specialize negatives-of-negatives(e) e-is-negative]
                  @minus-e-is-an-integer |
                    isInteger(neg(e))
                    [using specialize rational.isIntegerNeg(e) e-is-an-integer]
                  @minus-e-divides-p |
                    exists k: Q; isInteger(k) and
                      p = rational.mul(neg(e), k)
                    [using specialize theNegationStillDivides(e, p) e-divides-p]
                  @minus-e-divides-a |
                    exists k: Q; isInteger(k) and
                      a = rational.mul(neg(e), k)
                    [using specialize theNegationStillDivides(e, a) e-divides-a]
                  @minus-e-is-one-or-p |
                    neg(e) = ONE or neg(e) = p
                    [using specialize the-only-divisors(neg(e)) minus-e-is-an-integer minus-e-is-positive minus-e-divides-p]
                  @conclusion-the-negative-case |
                    e = ONE or e = neg(ONE)
                    case minus-e-is-one-or-p {
                      // -e = 1 gives e = -1
                      @when-minus-e-is-one |
                        assume neg(e) = ONE {
                          @minus-e-is-one |
                            neg(e) = ONE
                            [by hypothesis when-minus-e-is-one]
                          @e-doubly-negated |
                            neg(neg(e)) = e
                            [using specialize rational.negNeg(e)]
                          @minus-one-is-e |
                            neg(ONE) = e
                            [by rewrite minus-e-is-one e-doubly-negated]
                          @e-is-minus-one |
                            e = neg(ONE)
                            [by symmetry minus-one-is-e]
                          @conclusion-at-minus-one |
                            e = ONE or e = neg(ONE)
                            [using tautology e-is-minus-one]
                        }
                      // -e = p would make p divide a
                      @when-minus-e-is-p |
                        assume neg(e) = p {
                          @minus-e-is-p |
                            neg(e) = p
                            [by hypothesis when-minus-e-is-p]
                          @p-divides-a |
                            exists k: Q; isInteger(k) and
                              a = rational.mul(p, k)
                            [by rewrite minus-e-is-p minus-e-divides-a]
                          @conclusion-impossible |
                            e = ONE or e = neg(ONE)
                            [by ex_falso p-divides-a p-misses-a]
                        }
                    }
                }
              @the-implication |
                (isInteger(e) and less_than(ONE, p) and
                  (forall d: Q; isInteger(d) ->
                  less_than(ZERO, d) ->
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(d, k)) ->
                  (d = ONE or d = p)) and
                  (not (exists k: Q; isInteger(k) and
                  a = rational.mul(p, k))) and
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(e, k)) and
                  (exists k: Q; isInteger(k) and
                  a = rational.mul(e, k)) and
                  less_than(e, ZERO)) ->
                  (e = ONE or e = neg(ONE))
                [by discharge given-the-setup]
              @curried |
                isInteger(e) -> less_than(ONE, p) ->
                  (forall d: Q; isInteger(d) ->
                  less_than(ZERO, d) ->
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(d, k)) ->
                  (d = ONE or d = p)) ->
                  (not (exists k: Q; isInteger(k) and
                  a = rational.mul(p, k))) ->
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  a = rational.mul(e, k)) ->
                  less_than(e, ZERO) ->
                  (e = ONE or e = neg(ONE))
                [using tautology the-implication]
            }
          @discharge-e |
            forall e9: Q;
              isInteger(e9) -> less_than(ONE, p) ->
              (forall d: Q; isInteger(d) -> less_than(ZERO, d) ->
              (exists k: Q; isInteger(k) and
              p = rational.mul(d, k)) ->
              (d = ONE or d = p)) ->
              (not (exists k: Q; isInteger(k) and
              a = rational.mul(p, k))) ->
              (exists k: Q; isInteger(k) and
              p = rational.mul(e9, k)) ->
              (exists k: Q; isInteger(k) and
              a = rational.mul(e9, k)) ->
              less_than(e9, ZERO) ->
              (e9 = ONE or e9 = neg(ONE))
            [by generalize generalize-e]
        }
      @discharge-a |
        forall a9: Q; forall e9: Q;
          isInteger(e9) -> less_than(ONE, p) ->
          (forall d: Q; isInteger(d) -> less_than(ZERO, d) ->
          (exists k: Q; isInteger(k) and
          p = rational.mul(d, k)) ->
          (d = ONE or d = p)) ->
          (not (exists k: Q; isInteger(k) and
          a9 = rational.mul(p, k))) ->
          (exists k: Q; isInteger(k) and
          p = rational.mul(e9, k)) ->
          (exists k: Q; isInteger(k) and
          a9 = rational.mul(e9, k)) ->
          less_than(e9, ZERO) ->
          (e9 = ONE or e9 = neg(ONE))
        [by generalize generalize-a]
    }
  @conclusion |
    forall p, a, e: Q;
      isInteger(e) -> less_than(ONE, p) ->
      (forall d: Q; isInteger(d) -> less_than(ZERO, d) ->
      (exists k: Q; isInteger(k) and p = rational.mul(d, k)) ->
      (d = ONE or d = p)) ->
      (not (exists k: Q; isInteger(k) and a = rational.mul(p, k))) ->
      (exists k: Q; isInteger(k) and p = rational.mul(e, k)) ->
      (exists k: Q; isInteger(k) and a = rational.mul(e, k)) ->
      less_than(e, ZERO) ->
      (e = ONE or e = neg(ONE))
    [by generalize generalize-p]
qed

// The trichotomy core: a common divisor of a prime and something the prime misses is a unit.
// For e > 0 primality gives e = 1 or e = p, and e = p would make p divide `a`; for e < 0 the
// same applies to -e (divisibility is sign-blind); e = 0 would force p = 0, against p > 1.
theorem aCommonDivisorOfAPrimeAndAMissIsAUnit: forall p, a, e: Q;
  isInteger(p) -> isInteger(e) -> less_than(ONE, p) ->
  (forall d: Q; isInteger(d) -> less_than(ZERO, d) ->
  (exists k: Q; isInteger(k) and p = rational.mul(d, k)) ->
  (d = ONE or d = p)) ->
  (not (exists k: Q; isInteger(k) and a = rational.mul(p, k))) ->
  (exists k: Q; isInteger(k) and p = rational.mul(e, k)) ->
  (exists k: Q; isInteger(k) and a = rational.mul(e, k)) ->
  (e = ONE or e = neg(ONE))
proof
  @generalize-p |
    fix p: Q {
      @generalize-a |
        fix a: Q {
          @generalize-e |
            fix e: Q {
              @given-the-setup |
                assume isInteger(p) and isInteger(e) and
                  less_than(ONE, p) and
                  (forall d: Q; isInteger(d) ->
                  less_than(ZERO, d) ->
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(d, k)) ->
                  (d = ONE or d = p)) and
                  (not (exists k: Q; isInteger(k) and
                  a = rational.mul(p, k))) and
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(e, k)) and
                  (exists k: Q; isInteger(k) and
                  a = rational.mul(e, k)) {
                  @the-setup |
                    isInteger(p) and isInteger(e) and
                      less_than(ONE, p) and
                      (forall d: Q; isInteger(d) ->
                      less_than(ZERO, d) ->
                      (exists k: Q; isInteger(k) and
                      p = rational.mul(d, k)) ->
                      (d = ONE or d = p)) and
                      (not (exists k: Q; isInteger(k) and
                      a = rational.mul(p, k))) and
                      (exists k: Q; isInteger(k) and
                      p = rational.mul(e, k)) and
                      (exists k: Q; isInteger(k) and
                      a = rational.mul(e, k))
                    [by hypothesis given-the-setup]
                  @e-is-an-integer |
                    isInteger(e)
                    [using tautology the-setup]
                  @one-below-p |
                    less_than(ONE, p)
                    [using tautology the-setup]
                  @the-only-divisors |
                    forall d: Q; isInteger(d) ->
                      less_than(ZERO, d) ->
                      (exists k: Q; isInteger(k) and
                      p = rational.mul(d, k)) ->
                      (d = ONE or d = p)
                    [using tautology the-setup]
                  @p-misses-a |
                    not (exists k: Q; isInteger(k) and
                      a = rational.mul(p, k))
                    [using tautology the-setup]
                  @e-divides-p |
                    exists k: Q; isInteger(k) and
                      p = rational.mul(e, k)
                    [using tautology the-setup]
                  @e-divides-a |
                    exists k: Q; isInteger(k) and
                      a = rational.mul(e, k)
                    [using tautology the-setup]
                  @the-sign-split |
                    less_than(ZERO, e) or ZERO = e or
                      less_than(e, ZERO)
                    [using specialize rational.lessThanTrichotomy(ZERO, e)]
                  @conclusion-e-is-a-unit |
                    e = ONE or e = neg(ONE)
                    case the-sign-split {
                      @when-not-negative |
                        assume less_than(ZERO, e) or ZERO = e {
                          @the-nonneg-cases |
                            less_than(ZERO, e) or ZERO = e
                            [by hypothesis when-not-negative]
                          @conclusion-nonneg |
                            e = ONE or e = neg(ONE)
                            case the-nonneg-cases {
                              // e > 0: primality applies directly; e = p is ruled out
                              @when-positive |
                                assume less_than(ZERO, e) {
                                  @e-is-positive |
                                    less_than(ZERO, e)
                                    [by hypothesis when-positive]
                                  @e-is-one-or-p |
                                    e = ONE or e = p
                                    [using specialize the-only-divisors(e) e-is-an-integer e-is-positive e-divides-p]
                                  @conclusion-positive-case |
                                    e = ONE or e = neg(ONE)
                                    case e-is-one-or-p {
                                      @when-e-is-one |
                                        assume e = ONE {
                                          @e-is-one |
                                            e = ONE
                                            [by hypothesis when-e-is-one]
                                          @conclusion-already-a-unit |
                                            e = ONE or e = neg(ONE)
                                            [using tautology e-is-one]
                                        }
                                      // e = p would make p divide a
                                      @when-e-is-p |
                                        assume e = p {
                                          @e-is-p |
                                            e = p
                                            [by hypothesis when-e-is-p]
                                          @p-divides-a |
                                            exists k: Q; isInteger(k) and
                                              a = rational.mul(p, k)
                                            [by rewrite e-is-p e-divides-a]
                                          @conclusion-impossible |
                                            e = ONE or e = neg(ONE)
                                            [by ex_falso p-divides-a p-misses-a]
                                        }
                                    }
                                }
                              // e = 0 would make p = 0, against 1 < p
                              @when-zero |
                                assume ZERO = e {
                                  @zero-is-e |
                                    ZERO = e
                                    [by hypothesis when-zero]
                                  @with-the-quotient |
                                    unpack k: Q from e-divides-p {
                                      @the-quotient |
                                        isInteger(k) and
                                          p = rational.mul(e, k)
                                        [by hypothesis with-the-quotient]
                                      @p-factors |
                                        p = rational.mul(e, k)
                                        [by and_rhs the-quotient]
                                      @p-is-zero-times |
                                        p = rational.mul(ZERO, k)
                                        [by rewrite zero-is-e p-factors]
                                      @zero-times-k |
                                        rational.mul(ZERO, k) = ZERO
                                        [using specialize rational.mulZeroLeft(k)]
                                      @p-is-zero |
                                        p = ZERO
                                        [using simplify p-is-zero-times zero-times-k]
                                      @one-below-zero |
                                        less_than(ONE, ZERO)
                                        [by rewrite p-is-zero one-below-p]
                                      @zero-below-one |
                                        less_than(ZERO, ONE)
                                        [using model(rational.RationalOrderedField) field_order.zeroLessThanOne]
                                      @the-transitivity |
                                        forall x, y, z: Q;
                                          less_than(x, y) ->
                                          less_than(y, z) ->
                                          less_than(x, z)
                                        [using import(rational) lessThanTransitive]
                                      @zero-below-zero |
                                        less_than(ZERO, ZERO)
                                        [using specialize the-transitivity(ZERO, ONE, ZERO) zero-below-one one-below-zero]
                                      @zero-not-below-zero |
                                        not less_than(ZERO, ZERO)
                                        [using specialize rational.lessThanIrreflexive(ZERO)]
                                      @conclusion-zero-impossible |
                                        e = ONE or e = neg(ONE)
                                        [by ex_falso zero-below-zero zero-not-below-zero]
                                    }
                                  @conclusion-zero-case |
                                    e = ONE or e = neg(ONE)
                                    [by unpacked with-the-quotient]
                                }
                            }
                        }
                      // e < 0: run the positive case on -e, then flip
                      @when-negative |
                        assume less_than(e, ZERO) {
                          @e-is-negative |
                            less_than(e, ZERO)
                            [by hypothesis when-negative]
                          @conclusion-negative-case |
                            e = ONE or e = neg(ONE)
                            [using specialize theNegativeDivisorCase(p, a, e) e-is-an-integer one-below-p the-only-divisors p-misses-a e-divides-p e-divides-a e-is-negative]
                        }
                    }
                }
              @the-implication |
                (isInteger(p) and isInteger(e) and
                  less_than(ONE, p) and
                  (forall d: Q; isInteger(d) ->
                  less_than(ZERO, d) ->
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(d, k)) ->
                  (d = ONE or d = p)) and
                  (not (exists k: Q; isInteger(k) and
                  a = rational.mul(p, k))) and
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(e, k)) and
                  (exists k: Q; isInteger(k) and
                  a = rational.mul(e, k))) ->
                  (e = ONE or e = neg(ONE))
                [by discharge given-the-setup]
              @curried |
                isInteger(p) -> isInteger(e) ->
                  less_than(ONE, p) ->
                  (forall d: Q; isInteger(d) ->
                  less_than(ZERO, d) ->
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(d, k)) ->
                  (d = ONE or d = p)) ->
                  (not (exists k: Q; isInteger(k) and
                  a = rational.mul(p, k))) ->
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  a = rational.mul(e, k)) ->
                  (e = ONE or e = neg(ONE))
                [using tautology the-implication]
            }
          @discharge-e |
            forall e9: Q;
              isInteger(p) -> isInteger(e9) ->
              less_than(ONE, p) ->
              (forall d: Q; isInteger(d) -> less_than(ZERO, d) ->
              (exists k: Q; isInteger(k) and
              p = rational.mul(d, k)) ->
              (d = ONE or d = p)) ->
              (not (exists k: Q; isInteger(k) and
              a = rational.mul(p, k))) ->
              (exists k: Q; isInteger(k) and
              p = rational.mul(e9, k)) ->
              (exists k: Q; isInteger(k) and
              a = rational.mul(e9, k)) ->
              (e9 = ONE or e9 = neg(ONE))
            [by generalize generalize-e]
        }
      @discharge-a |
        forall a9: Q; forall e9: Q;
          isInteger(p) -> isInteger(e9) ->
          less_than(ONE, p) ->
          (forall d: Q; isInteger(d) -> less_than(ZERO, d) ->
          (exists k: Q; isInteger(k) and
          p = rational.mul(d, k)) ->
          (d = ONE or d = p)) ->
          (not (exists k: Q; isInteger(k) and
          a9 = rational.mul(p, k))) ->
          (exists k: Q; isInteger(k) and
          p = rational.mul(e9, k)) ->
          (exists k: Q; isInteger(k) and
          a9 = rational.mul(e9, k)) ->
          (e9 = ONE or e9 = neg(ONE))
        [by generalize generalize-a]
    }
  @conclusion |
    forall p, a, e: Q;
      isInteger(p) -> isInteger(e) -> less_than(ONE, p) ->
      (forall d: Q; isInteger(d) -> less_than(ZERO, d) ->
      (exists k: Q; isInteger(k) and p = rational.mul(d, k)) ->
      (d = ONE or d = p)) ->
      (not (exists k: Q; isInteger(k) and a = rational.mul(p, k))) ->
      (exists k: Q; isInteger(k) and p = rational.mul(e, k)) ->
      (exists k: Q; isInteger(k) and a = rational.mul(e, k)) ->
      (e = ONE or e = neg(ONE))
    [by generalize generalize-p]
qed

// A prime missing `a` is coprime to it: a common divisor is 1 or p by primality, and p is
// ruled out because it would divide `a`. The negative case comes back by sign-blindness, and
// zero is impossible since p > 0. This is the hypothesis `bezoutOnTheCut` wants.
theorem coprimalityFromPrimalityOnTheCut: forall p, a: Q;
  isInteger(p) -> isInteger(a) -> isPrimeOnTheCut(p) ->
  (not (exists k: Q; isInteger(k) and a = rational.mul(p, k))) ->
  (forall e: Q; isInteger(e) ->
  (exists k: Q; isInteger(k) and p = rational.mul(e, k)) ->
  (exists k: Q; isInteger(k) and a = rational.mul(e, k)) ->
  (exists k: Q; isInteger(k) and ONE = rational.mul(e, k)))
proof
  @generalize-p |
    fix p: Q {
      @generalize-a |
        fix a: Q {
          @given-the-setup |
            assume isInteger(p) and isInteger(a) and
              isPrimeOnTheCut(p) and
              (not (exists k: Q; isInteger(k) and
              a = rational.mul(p, k))) {
              @the-setup |
                isInteger(p) and isInteger(a) and
                  isPrimeOnTheCut(p) and
                  (not (exists k: Q; isInteger(k) and
                  a = rational.mul(p, k)))
                [by hypothesis given-the-setup]
              @p-is-an-integer |
                isInteger(p)
                [using tautology the-setup]
              @p-is-prime |
                isPrimeOnTheCut(p)
                [using tautology the-setup]
              @p-misses-a |
                not (exists k: Q; isInteger(k) and
                  a = rational.mul(p, k))
                [using tautology the-setup]
              @one-below-p |
                less_than(ONE, p)
                [using tautology p-is-prime]
              @the-only-divisors |
                forall d: Q; isInteger(d) -> less_than(ZERO, d) ->
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(d, k)) ->
                  (d = ONE or d = p)
                [using tautology p-is-prime]
              @each-divisor |
                fix e: Q {
                  @given-e-divides-both |
                    assume isInteger(e) and
                      (exists k: Q; isInteger(k) and
                      p = rational.mul(e, k)) and
                      (exists k: Q; isInteger(k) and
                      a = rational.mul(e, k)) {
                      @the-divisor-setup |
                        isInteger(e) and
                          (exists k: Q; isInteger(k) and
                          p = rational.mul(e, k)) and
                          (exists k: Q; isInteger(k) and
                          a = rational.mul(e, k))
                        [by hypothesis given-e-divides-both]
                      @e-is-an-integer |
                        isInteger(e)
                        [using tautology the-divisor-setup]
                      @e-divides-p |
                        exists k: Q; isInteger(k) and
                          p = rational.mul(e, k)
                        [using tautology the-divisor-setup]
                      @e-divides-a |
                        exists k: Q; isInteger(k) and
                          a = rational.mul(e, k)
                        [using tautology the-divisor-setup]
                      // e = 1 or -1, by trichotomy on e
                      @e-is-a-unit |
                        e = ONE or e = neg(ONE)
                        [using specialize aCommonDivisorOfAPrimeAndAMissIsAUnit(p, a, e) p-is-an-integer e-is-an-integer one-below-p the-only-divisors p-misses-a e-divides-p e-divides-a]
                      @one-is-an-integer |
                        isInteger(ONE)
                        [using import(rational) oneIsAnInteger]
                      @conclusion-e-divides-one |
                        exists k: Q; isInteger(k) and
                          ONE = rational.mul(e, k)
                        case e-is-a-unit {
                          @when-one |
                            assume e = ONE {
                              @e-is-one |
                                e = ONE
                                [by hypothesis when-one]
                              @one-is-one-times-one |
                                ONE = rational.mul(ONE, ONE)
                                [using polynomial(rational)]
                              @the-unit-quotient-works |
                                isInteger(ONE) and
                                  ONE = rational.mul(ONE, ONE)
                                [by both one-is-an-integer one-is-one-times-one]
                              @a-unit-quotient-exists |
                                exists k: Q; isInteger(k) and
                                  ONE = rational.mul(ONE, k)
                                [by witness(ONE) the-unit-quotient-works]
                              @conclusion-at-one |
                                exists k: Q; isInteger(k) and
                                  ONE = rational.mul(e, k)
                                [by rewrite e-is-one a-unit-quotient-exists]
                            }
                          @when-minus-one |
                            assume e = neg(ONE) {
                              @e-is-minus-one |
                                e = neg(ONE)
                                [by hypothesis when-minus-one]
                              @minus-one-is-an-integer |
                                isInteger(neg(ONE))
                                [using specialize rational.isIntegerNeg(ONE) one-is-an-integer]
                              @one-is-minus-times-minus |
                                ONE = rational.mul(neg(ONE),
                                  neg(ONE))
                                [using polynomial(rational)]
                              @the-negated-quotient-works |
                                isInteger(neg(ONE)) and
                                  ONE = rational.mul(neg(ONE),
                                  neg(ONE))
                                [by both minus-one-is-an-integer one-is-minus-times-minus]
                              @a-negated-quotient-exists |
                                exists k: Q; isInteger(k) and
                                  ONE = rational.mul(neg(ONE), k)
                                [by witness(neg(ONE)) the-negated-quotient-works]
                              @conclusion-at-minus-one |
                                exists k: Q; isInteger(k) and
                                  ONE = rational.mul(e, k)
                                [by rewrite e-is-minus-one a-negated-quotient-exists]
                            }
                        }
                    }
                  @the-divisor-implication |
                    (isInteger(e) and
                      (exists k: Q; isInteger(k) and
                      p = rational.mul(e, k)) and
                      (exists k: Q; isInteger(k) and
                      a = rational.mul(e, k))) ->
                      (exists k: Q; isInteger(k) and
                      ONE = rational.mul(e, k))
                    [by discharge given-e-divides-both]
                  @curried-at-e |
                    isInteger(e) ->
                      (exists k: Q; isInteger(k) and
                      p = rational.mul(e, k)) ->
                      (exists k: Q; isInteger(k) and
                      a = rational.mul(e, k)) ->
                      (exists k: Q; isInteger(k) and
                      ONE = rational.mul(e, k))
                    [using tautology the-divisor-implication]
                }
              @conclusion-all-divisors |
                forall e: Q; isInteger(e) ->
                  (exists k: Q; isInteger(k) and
                  p = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  a = rational.mul(e, k)) ->
                  (exists k: Q; isInteger(k) and
                  ONE = rational.mul(e, k))
                [by generalize each-divisor]
            }
          @the-implication |
            (isInteger(p) and isInteger(a) and
              isPrimeOnTheCut(p) and
              (not (exists k: Q; isInteger(k) and
              a = rational.mul(p, k)))) ->
              (forall e: Q; isInteger(e) ->
              (exists k: Q; isInteger(k) and
              p = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              a = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              ONE = rational.mul(e, k)))
            [by discharge given-the-setup]
          @curried |
            isInteger(p) -> isInteger(a) ->
              isPrimeOnTheCut(p) ->
              (not (exists k: Q; isInteger(k) and
              a = rational.mul(p, k))) ->
              (forall e: Q; isInteger(e) ->
              (exists k: Q; isInteger(k) and
              p = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              a = rational.mul(e, k)) ->
              (exists k: Q; isInteger(k) and
              ONE = rational.mul(e, k)))
            [using tautology the-implication]
        }
      @discharge-a |
        forall a9: Q;
          isInteger(p) -> isInteger(a9) ->
          isPrimeOnTheCut(p) ->
          (not (exists k: Q; isInteger(k) and
          a9 = rational.mul(p, k))) ->
          (forall e: Q; isInteger(e) ->
          (exists k: Q; isInteger(k) and
          p = rational.mul(e, k)) ->
          (exists k: Q; isInteger(k) and
          a9 = rational.mul(e, k)) ->
          (exists k: Q; isInteger(k) and
          ONE = rational.mul(e, k)))
        [by generalize generalize-a]
    }
  @conclusion |
    forall p, a: Q;
      isInteger(p) -> isInteger(a) -> isPrimeOnTheCut(p) ->
      (not (exists k: Q; isInteger(k) and a = rational.mul(p, k))) ->
      (forall e: Q; isInteger(e) ->
      (exists k: Q; isInteger(k) and p = rational.mul(e, k)) ->
      (exists k: Q; isInteger(k) and a = rational.mul(e, k)) ->
      (exists k: Q; isInteger(k) and ONE = rational.mul(e, k)))
    [by generalize generalize-p]
qed
