// Worked examples for `std/rational.bpa`'s integer and natural CUTS and its postulated
// induction principle.
//
// Why this file exists: the closure axioms (`isIntegerMul`, `isNaturalSucc`, …), the
// discrete-step definition and the induction schema are stated so that a future
// `Q where isInteger` carve and its ℤ/ℕ model transfers have something to stand on.
// Nothing in `rational.bpa` itself builds on them, so nothing exercises them — and an
// axiom no derivation ever touches is one whose binders, guards and direction have never
// been checked. Each theorem below is the smallest derivation that genuinely needs the
// axiom it names.
import rational <<< "std/rational.bpa"

sort Q = rational.Q
const ZERO = rational.ZERO
const ONE = rational.ONE
func add = rational.add
func mul = rational.mul
func neg = rational.neg
func succ = rational.succ
func prev = rational.prev
func sub = rational.sub
pred isInteger = rational.isInteger
pred isNatural = rational.isNatural

axiom isIntegerZero = rational.isIntegerZero
axiom isIntegerOne = rational.isIntegerOne
axiom isIntegerAdd = rational.isIntegerAdd
axiom isIntegerMul = rational.isIntegerMul
axiom isIntegerNeg = rational.isIntegerNeg
axiom isIntegerSucc = rational.isIntegerSucc
axiom isIntegerPrev = rational.isIntegerPrev
axiom isNaturalZero = rational.isNaturalZero
axiom isNaturalSucc = rational.isNaturalSucc
axiom isNaturalIsInteger = rational.isNaturalIsInteger
axiom isNaturalSuccNotZero = rational.isNaturalSuccNotZero
axiom integerCases = rational.integerCases
axiom subDefinition = rational.subDefinition
axiom naturalInduction = rational.naturalInduction

// -- the integer cut: a subRING (closed under +, ×, neg — never recip) -------

// −(1·1) is an integer: the ring operations only. The cut is deliberately NOT closed
// under recip, which is what separates it from the rational cut above.
theorem negOneIsInteger: isInteger(neg(mul(ONE, ONE)))
proof
  @one-is-integer |
    isInteger(ONE)
    [by cite isIntegerOne]
  @product-is-integer |
    isInteger(mul(ONE, ONE))
    [using specialize isIntegerMul(ONE, ONE) one-is-integer one-is-integer]
  @conclusion |
    isInteger(neg(mul(ONE, ONE)))
    [using specialize isIntegerNeg(mul(ONE, ONE)) product-is-integer]
qed

// the discrete step keeps you in the cut, in both directions.
theorem stepsStayInteger: forall q: Q; isInteger(q) -> isInteger(prev(succ(q)))
proof
  @generalize-q |
    fix q: Q {
      @given-q-integer |
        assume isInteger(q) {
          @q-is-integer |
            isInteger(q)
            [by hypothesis given-q-integer]
          @successor-is-integer |
            isInteger(succ(q))
            [using specialize isIntegerSucc(q) q-is-integer]
          @conclusion-predecessor-of-successor |
            isInteger(prev(succ(q)))
            [using specialize isIntegerPrev(succ(q)) successor-is-integer]
        }
      @conclusion-integer-implies |
        isInteger(q) -> isInteger(prev(succ(q)))
        [by implies_intro given-q-integer]
    }
  @conclusion |
    forall q: Q; isInteger(q) -> isInteger(prev(succ(q)))
    [by forall_intro generalize-q]
qed

// a difference of integers is an integer: `sub` unfolds to add-of-neg, so the ring
// closure axioms carry it — the definition axiom is what makes the unfolding available.
theorem differenceIsInteger: forall a, b: Q; isInteger(a) -> isInteger(b) -> isInteger(sub(a, b))
proof
  @generalize-a |
    fix a: Q {
      @generalize-b |
        fix b: Q {
          @given-a-integer |
            assume isInteger(a) {
              @given-b-integer |
                assume isInteger(b) {
                  @a-is-integer |
                    isInteger(a)
                    [by hypothesis given-a-integer]
                  @b-is-integer |
                    isInteger(b)
                    [by hypothesis given-b-integer]
                  @negated-b-is-integer |
                    isInteger(neg(b))
                    [using specialize isIntegerNeg(b) b-is-integer]
                  @sum-with-negation-is-integer |
                    isInteger(add(a, neg(b)))
                    [using specialize isIntegerAdd(a, neg(b)) a-is-integer negated-b-is-integer]
                  @difference-unfolds |
                    sub(a, b) = add(a, neg(b))
                    [using specialize subDefinition(a, b)]
                  @conclusion-difference-is-integer |
                    isInteger(sub(a, b))
                    [by rewrite difference-unfolds sum-with-negation-is-integer]
                }
              @b-integer-implies-difference |
                isInteger(b) -> isInteger(sub(a, b))
                [by implies_intro given-b-integer]
            }
          @conclusion-both-integers |
            isInteger(a) -> isInteger(b) -> isInteger(sub(a, b))
            [by implies_intro given-a-integer]
        }
      @discharge-b |
        forall b: Q; isInteger(a) -> isInteger(b) -> isInteger(sub(a, b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Q; isInteger(a) -> isInteger(b) -> isInteger(sub(a, b))
    [by forall_intro generalize-a]
qed

// -- the natural cut: ℕ inside ℤ inside ℝ ------------------------------------

// succ(0) is a natural, hence an integer: the ℕ base case, its closure step, and the
// inclusion that ties the two cuts together.
theorem oneIsNaturalAndInteger: isNatural(succ(ZERO)) and isInteger(succ(ZERO))
proof
  @zero-is-natural |
    isNatural(ZERO)
    [by cite isNaturalZero]
  @successor-of-zero-is-natural |
    isNatural(succ(ZERO))
    [using specialize isNaturalSucc(ZERO) zero-is-natural]
  @successor-of-zero-is-integer |
    isInteger(succ(ZERO))
    [using specialize isNaturalIsInteger(succ(ZERO)) successor-of-zero-is-natural]
  @conclusion |
    isNatural(succ(ZERO)) and isInteger(succ(ZERO))
    [by and_intro successor-of-zero-is-natural successor-of-zero-is-integer]
qed

// no natural steps back to zero — the cut's discreteness at the bottom.
theorem successorOfZeroIsNonzero: succ(ZERO) != ZERO
proof
  @zero-is-natural |
    isNatural(ZERO)
    [by cite isNaturalZero]
  @conclusion |
    succ(ZERO) != ZERO
    [using specialize isNaturalSuccNotZero(ZERO) zero-is-natural]
qed

// ℤ = ℕ ∪ −ℕ: every integer is a natural or negates one. At 0 the disjunction is what
// the integer model's case analysis rests on.
theorem zeroIsNaturalOrNegatesOne: isNatural(ZERO) or isNatural(neg(ZERO))
proof
  @zero-is-integer |
    isInteger(ZERO)
    [by cite isIntegerZero]
  @conclusion |
    isNatural(ZERO) or isNatural(neg(ZERO))
    [using specialize integerCases(ZERO) zero-is-integer]
qed

// -- the postulated minimality principle -------------------------------------

// natural induction instantiated at `isInteger`: every natural is an integer, derived by
// induction rather than by citing the inclusion axiom. The schema's smallest honest use —
// base case and step both discharged from the closure axioms.
theorem naturalsAreIntegersByInduction: forall n: Q; isNatural(n) -> isInteger(n)
proof
  @base-case |
    isInteger(ZERO)
    [by cite isIntegerZero]
  @induction-step |
    fix k: Q {
      @given-k-natural |
        assume isNatural(k) {
          @given-inductive-hypothesis |
            assume isInteger(k) {
              @inductive-hypothesis |
                isInteger(k)
                [by hypothesis given-inductive-hypothesis]
              @conclusion-successor-is-integer |
                isInteger(succ(k))
                [using specialize isIntegerSucc(k) inductive-hypothesis]
            }
          @conclusion-induction-step-at-k |
            isInteger(k) -> isInteger(succ(k))
            [by implies_intro given-inductive-hypothesis]
        }
      @conclusion-step-guarded |
        isNatural(k) -> isInteger(k) -> isInteger(succ(k))
        [by implies_intro given-k-natural]
    }
  @induction-step-for-all-k |
    forall k: Q; isNatural(k) -> isInteger(k) -> isInteger(succ(k))
    [by forall_intro induction-step]
  @conclusion |
    forall n: Q; isNatural(n) -> isInteger(n)
    [using instantiation naturalInduction(fun q: Q => isInteger(q)) base-case induction-step-for-all-k]
qed
