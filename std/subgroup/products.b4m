// A subgroup is closed under PRODUCTS OF SEQUENCES, not just pairs.
//
// `std/subgroup.b4m` axiomatizes `inSubgroup` with the two closure conditions a subgroup
// is defined by — the identity, a pair's product, an inverse. What a proof usually wants
// is the iterated form: if every entry of a sequence is in the subgroup, so is the
// product of the whole run. That is an induction on the run LENGTH, and it is the step
// that lets "H contains every generator" reach "H contains every element", since a
// generating claim hands you a SEQUENCE of generators whose product is the element.
//
// Judson's §10.2 needs exactly this: a normal subgroup containing every 3-cycle of a
// fixed family contains every product of them, hence (with A_n generated by 3-cycles) all
// of A_n. Nothing here is specific to permutations — it is a fact about any subgroup.
import group <<< "std/group.b4m"
import group_sequence <<< "std/group/sequence.b4m"
import subgroup <<< "std/subgroup.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

sort Grp = group.Grp
const E = group.E
func op = group.op
func inverse = group.inverse

sort Seq = group_sequence.Seq
func at = group_sequence.at
func productUpTo = group_sequence.productUpTo
axiom productUpToZero = group_sequence.productUpToZero
axiom productUpToSucc = group_sequence.productUpToSucc

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
pred less_than = peano.less_than
axiom induction = peano.induction
theorem lessThanSuccSplit = peano_order.lessThanSuccSplit
theorem lessThanSelf = peano_order.lessThanSelf
theorem lessThanSuccRight = peano_order.lessThanSuccRight

pred inSubgroup = subgroup.inSubgroup
axiom subgroupHasIdentity = subgroup.subgroupHasIdentity
axiom subgroupClosedOp = subgroup.subgroupClosedOp

// The empty product is the identity, which is in the subgroup; extending a run multiplies
// by one more entry, and the pair-closure axiom carries it. So: every entry in, product in.
theorem aProductOfSubgroupEntriesIsInTheSubgroup: forall s: Seq; forall m: Nat;
  (forall i: Nat; less_than(i, m) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, m))
proof
  @generalize-s |
    fix s: Seq {
      // base: the empty product is E.
      @empty-product |
        productUpTo(s, ZERO) = E
        [using specialize productUpToZero(s)]
      @identity-in |
        inSubgroup(E)
        [by cite subgroupHasIdentity]
      @base-at-zero |
        inSubgroup(productUpTo(s, ZERO))
        [by rewrite empty-product identity-in]
      @base-case |
        (forall i: Nat; less_than(i, ZERO) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, ZERO))
        [using tautology base-at-zero]
      // step: assume the claim at k; at succ(k) the run is (run up to k) · entry k.
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume (forall i: Nat; less_than(i, k) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, k)) {
              @inductive-hypothesis |
                (forall i: Nat; less_than(i, k) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, k))
                [by hypothesis given-inductive-hypothesis]
              @given-all-below-succ-k |
                assume forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i)) {
                  @all-below-succ-k |
                    forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i))
                    [by hypothesis given-all-below-succ-k]
                  // the entries below k are among those below succ(k)
                  @entries-below-k |
                    forall i: Nat; less_than(i, k) -> inSubgroup(at(s, i))
                    [using specialize entriesBelowKAreBelowSuccK(s, k) all-below-succ-k]
                  @prefix-in |
                    inSubgroup(productUpTo(s, k))
                    [by modus_ponens inductive-hypothesis entries-below-k]
                  @k-below-succ-k |
                    less_than(k, succ(k))
                    [using specialize lessThanSelf(k)]
                  @entry-k-in |
                    inSubgroup(at(s, k))
                    [using specialize all-below-succ-k(k) k-below-succ-k]
                  @run-splits |
                    productUpTo(s, succ(k)) = op(productUpTo(s, k), at(s, k))
                    [using specialize productUpToSucc(s, k)]
                  @product-in |
                    inSubgroup(op(productUpTo(s, k), at(s, k)))
                    [using specialize subgroupClosedOp(productUpTo(s, k), at(s, k)) prefix-in entry-k-in]
                  @conclusion-at-succ-k |
                    inSubgroup(productUpTo(s, succ(k)))
                    [by rewrite run-splits product-in]
                }
              @conclusion-implication |
                (forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, succ(k)))
                [by implies_intro given-all-below-succ-k]
            }
          @conclusion-step-at-k |
            ((forall i: Nat; less_than(i, k) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, k))) ->
              ((forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, succ(k))))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat;
          ((forall i: Nat; less_than(i, k) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, k))) ->
          ((forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, succ(k))))
        [by forall_intro induction-step]
      @conclusion-for-s |
        forall m: Nat; (forall i: Nat; less_than(i, m) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, m))
        [using instantiation induction((fun m: Nat => (forall i: Nat; less_than(i, m) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, m)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Seq; forall m: Nat;
      (forall i: Nat; less_than(i, m) -> inSubgroup(at(s, i))) -> inSubgroup(productUpTo(s, m))
    [by forall_intro generalize-s]
qed

// An entry below k is below succ(k), so the hypothesis for the longer run covers the
// shorter one. Stated separately because the induction step needs it at a fixed k.
theorem entriesBelowKAreBelowSuccK: forall s: Seq; forall k: Nat;
  (forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i))) ->
  (forall i: Nat; less_than(i, k) -> inSubgroup(at(s, i)))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-k |
        fix k: Nat {
          @given-all-below-succ-k |
            assume forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i)) {
              @all-below-succ-k |
                forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i))
                [by hypothesis given-all-below-succ-k]
              @generalize-i |
                fix i: Nat {
                  @given-i-below-k |
                    assume less_than(i, k) {
                      @i-below-k |
                        less_than(i, k)
                        [by hypothesis given-i-below-k]
                      @i-below-succ-k |
                        less_than(i, succ(k))
                        [using specialize lessThanSuccRight(i, k) i-below-k]
                      @conclusion-entry-in |
                        inSubgroup(at(s, i))
                        [using specialize all-below-succ-k(i) i-below-succ-k]
                    }
                  @conclusion-entry-implication |
                    less_than(i, k) -> inSubgroup(at(s, i))
                    [by implies_intro given-i-below-k]
                }
              @conclusion-all-below-k |
                forall i: Nat; less_than(i, k) -> inSubgroup(at(s, i))
                [by forall_intro generalize-i]
            }
          @conclusion-implication |
            (forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i))) ->
              (forall i: Nat; less_than(i, k) -> inSubgroup(at(s, i)))
            [by implies_intro given-all-below-succ-k]
        }
      @discharge-k |
        forall k: Nat; (forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i))) ->
          (forall i: Nat; less_than(i, k) -> inSubgroup(at(s, i)))
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall s: Seq; forall k: Nat;
      (forall i: Nat; less_than(i, succ(k)) -> inSubgroup(at(s, i))) ->
      (forall i: Nat; less_than(i, k) -> inSubgroup(at(s, i)))
    [by forall_intro generalize-s]
qed
