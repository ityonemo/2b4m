// std/indexed.b4m — THE ABSTRACT INDEXED CONTAINER: a finite list read by index, and the
// facts that say such lists can be BUILT.
//
// This is the pattern every finite-list sort in std was re-declaring by hand. A carrier
// supplies its own sort and its own `at`, and MODELS this theory to get the building
// postulates; it no longer restates them. (Seven carriers restated some subset of them
// before this file existed — `Seq` over groups, over permutations, over ℤ, `ZnSeq`,
// `SetSeq`, `Points` — each with a comment explaining why it could not inherit.)
//
// WHY THIS IS SEPARATE FROM THE FOLD. `std/sequence.b4m` bundles the container with a
// fold (`IDENTITY`/`combine`/`foldUpTo`), and three of its four existence postulates carry
// a fold clause. That bundling is what stopped `Points` (a list of set ELEMENTS, which have
// no monoid structure) from modeling it: there is nothing to fold. So the container is here,
// the fold stays in `std/sequence.b4m`, and a carrier takes whichever it needs. Two of the
// current carriers (`std/permutation/cycle.b4m`'s `Points`, `std/set/subsets.b4m`'s
// `SetSeq`) use NO fold clause at all and want exactly this file.
//
// WHAT A CARRIER STILL OWNS. These are AXIOMS, so a model must DISCHARGE them, not inherit
// them — a model transfers theorems and discharges assumptions. That is the honest shape: a
// concrete list sort is asserting that its own lists can be built, and `--axioms` names that
// assertion at the carrier. What the carrier gains is that the SHAPE is stated once here, so
// a generic lemma proved over `Indexed` transfers to every model of it, and a carrier cannot
// silently ship a THINNER postulate set than its constructions need (the `Points` trap:
// having only singleton+prepend made two different induction shapes unavailable, and the
// failure looked like a wrong proof rather than a missing axiom).

import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
pred less_than = peano.less_than
define at_most(a, b) = peano_order.less_or_equal(a, b)

// -- the container ----------------------------------------------------------------------------
// `Indexed` is observe-only on its own: `at` reads an entry, but nothing produces a list. The
// postulates below are what produce them.
sort Indexed
sort Item
func at(s: Indexed, i: Nat) => Item

// -- the building postulates ------------------------------------------------------------------
// Each states that a list with the given entry-graph EXISTS, and claims NOTHING about entries
// outside the stated range. These are obviously true of the intended model (finite lists) and
// are axioms because the sort carries no first-class builder.

// SINGLETON [x]: one entry, x.
axiom indexedSingleton: forall x: Item;
  exists s: Indexed; at(s, ZERO) = x

// PREPEND x :: s: head x, the rest of s shifted up by one.
axiom indexedPrepend: forall x: Item; forall s: Indexed;
  exists u: Indexed;
  at(u, ZERO) = x
  and (forall i: Nat; at(u, succ(i)) = at(s, i))

// CONCATENATION: the first j entries of s, then the first k of t.
//
// This is the one whose absence is least obvious and most damaging. Without it a list cannot
// be grown from its FRONT — only prepended to — so any construction that walks UP an index
// range ("the list whose i-th entry is f(sᵢ)") is unavailable, and so is a list's TAIL. That
// is exactly the hole `Points` had.
axiom indexedConcat: forall s: Indexed; forall t: Indexed; forall j: Nat; forall k: Nat;
  exists u: Indexed;
  (forall i: Nat; less_than(i, j) -> at(u, i) = at(s, i))
  and (forall i: Nat; less_than(i, k) -> at(u, add(j, i)) = at(t, i))

// REVERSAL: the first n entries of s, in reverse order.
axiom indexedReverse: forall s: Indexed; forall n: Nat;
  exists r: Indexed;
  forall i: Nat; less_than(i, n) -> at(r, i) = at(s, peano.sub(n, succ(i)))

// REMOVAL: s with the entry at index m deleted — unchanged below m, shifted down at and above.
axiom indexedRemove: forall s: Indexed; forall k: Nat; forall m: Nat;
  less_than(m, succ(k)) ->
  exists t: Indexed;
  (forall i: Nat; less_than(i, m) -> at(t, i) = at(s, i))
  and (forall i: Nat; at_most(m, i) -> less_than(i, k) -> at(t, i) = at(s, succ(i)))

// -- what the container PROVES ----------------------------------------------------------------
// The payoff of naming the pattern: generic facts proved ONCE here. Before this file, the
// mapped-list existence below was written out longhand FOUR times
// (`group_sequence.translatedSequenceExists`, `counting.powersAreListed`,
// `permutation_sequence.mappedSequenceExists`, and an attempt for `Points` that revealed the
// missing concat postulate).
//
// It is a SCHEMA over the map, because the first-order kernel cannot quantify over a function
// `Item -> Item` — and that is exactly what makes it reusable: a carrier instantiates it at
// whatever index-indexed family it needs (translation by a group element, powers of a
// generator, images under a permutation).

// THE MAPPED LIST: for any map f and list s there is a list whose first m entries are
// f(s₀), …, f(s_{m−1}). Induction on m, extending by concatenating a singleton — which is why
// `indexedConcat` is load-bearing: with prepend alone a prefix cannot be grown.
theorem mappedListExists(f(Item) => Item): forall s: Indexed; forall m: Nat;
  exists t: Indexed; forall i: Nat; less_than(i, m) -> at(t, i) = f(at(s, i))
proof
  @generalize-s |
    fix s: Indexed {
      // base: nothing is below ZERO, so any list serves — and a singleton exists.
      @some-list-exists |
        exists t: Indexed; at(t, ZERO) = f(at(s, ZERO))
        [using specialize indexedSingleton(f(at(s, ZERO)))]
      @base-case |
        exists t: Indexed; forall i: Nat; less_than(i, ZERO) -> at(t, i) = f(at(s, i))
        [by unpacked with-some-list]
      @with-some-list |
        unpack t0: Indexed from some-list-exists {
          @vacuous |
            forall i: Nat; less_than(i, ZERO) -> at(t0, i) = f(at(s, i))
            [by generalize nothing-below-zero]
          @nothing-below-zero |
            fix i: Nat {
              @given-below-zero |
                assume less_than(i, ZERO) {
                  @below-zero |
                    less_than(i, ZERO)
                    [by hypothesis given-below-zero]
                  @not-below-zero |
                    not less_than(i, ZERO)
                    [using specialize peano_order.notLessThanZero(i)]
                  @conclusion-vacuous |
                    at(t0, i) = f(at(s, i))
                    [using tautology below-zero not-below-zero]
                }
              @below-zero-implies |
                less_than(i, ZERO) -> at(t0, i) = f(at(s, i))
                [by discharge given-below-zero]
            }
          @conclusion-base-inner |
            exists t: Indexed; forall i: Nat; less_than(i, ZERO) -> at(t, i) = f(at(s, i))
            [by witness(t0) vacuous]
        }
      // step: concatenate the singleton holding f(s_k) after the first k entries.
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume exists t: Indexed; forall i: Nat; less_than(i, k) -> at(t, i) = f(at(s, i)) {
              @inductive-hypothesis |
                exists t: Indexed; forall i: Nat; less_than(i, k) -> at(t, i) = f(at(s, i))
                [by hypothesis given-inductive-hypothesis]
              @with-prefix |
                unpack t: Indexed from inductive-hypothesis {
                  @prefix-matches |
                    forall i: Nat; less_than(i, k) -> at(t, i) = f(at(s, i))
                    [by hypothesis with-prefix]
                  @singleton-exists |
                    exists w: Indexed; at(w, ZERO) = f(at(s, k))
                    [using specialize indexedSingleton(f(at(s, k)))]
                  @with-singleton |
                    unpack w: Indexed from singleton-exists {
                      @singleton-head |
                        at(w, ZERO) = f(at(s, k))
                        [by hypothesis with-singleton]
                      @joined-exists |
                        exists u: Indexed; (forall i: Nat; less_than(i, k) -> at(u, i) = at(t, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(w, i))
                        [using specialize indexedConcat(t, w, k, succ(ZERO))]
                      @with-joined |
                        unpack u: Indexed from joined-exists {
                          @joined-facts |
                            (forall i: Nat; less_than(i, k) -> at(u, i) = at(t, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(w, i))
                            [by hypothesis with-joined]
                          @joined-below |
                            forall i: Nat; less_than(i, k) -> at(u, i) = at(t, i)
                            [by and_lhs joined-facts]
                          @joined-above |
                            forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(k, i)) = at(w, i)
                            [by and_rhs joined-facts]
                          // the new entry sits at index k = k + 0
                          @zero-below-one |
                            less_than(ZERO, succ(ZERO))
                            [using specialize peano_order.lessThanSelf(ZERO)]
                          @joined-at-k-plus-zero |
                            at(u, add(k, ZERO)) = at(w, ZERO)
                            [using specialize joined-above(ZERO) zero-below-one]
                          @k-plus-zero |
                            add(k, ZERO) = k
                            [using specialize peano.addZeroRight(k)]
                          @joined-at-k |
                            at(u, k) = at(w, ZERO)
                            [by rewrite k-plus-zero joined-at-k-plus-zero]
                          @joined-at-k-is-the-image |
                            at(u, k) = f(at(s, k))
                            [using chain joined-at-k singleton-head]
                          // every index below succ(k) is below k or is k
                          @matches-below-succ-k |
                            forall i: Nat; less_than(i, succ(k)) -> at(u, i) = f(at(s, i))
                            [by generalize matches-at-i]
                          @matches-at-i |
                            fix i: Nat {
                              @given-i-below-succ-k |
                                assume less_than(i, succ(k)) {
                                  @i-below-succ-k |
                                    less_than(i, succ(k))
                                    [by hypothesis given-i-below-succ-k]
                                  @i-splits |
                                    less_than(i, k) or i = k
                                    [using specialize peano_order.lessThanSuccSplit(i, k) i-below-succ-k]
                                  @conclusion-matches-at-i |
                                    at(u, i) = f(at(s, i))
                                    case i-splits {
                                      @when-i-is-in-the-prefix |
                                        assume less_than(i, k) {
                                          @i-below-k |
                                            less_than(i, k)
                                            [by hypothesis when-i-is-in-the-prefix]
                                          @joined-agrees-with-prefix |
                                            at(u, i) = at(t, i)
                                            [using specialize joined-below(i) i-below-k]
                                          @prefix-at-i |
                                            at(t, i) = f(at(s, i))
                                            [using specialize prefix-matches(i) i-below-k]
                                          @conclusion-prefix-case |
                                            at(u, i) = f(at(s, i))
                                            [using chain joined-agrees-with-prefix prefix-at-i]
                                        }
                                      @when-i-is-the-new-entry |
                                        assume i = k {
                                          @i-is-k |
                                            i = k
                                            [by hypothesis when-i-is-the-new-entry]
                                          @conclusion-new-entry-case |
                                            at(u, i) = f(at(s, i))
                                            [by rewrite i-is-k joined-at-k-is-the-image]
                                        }
                                    }
                                }
                              @i-below-succ-k-implies |
                                less_than(i, succ(k)) -> at(u, i) = f(at(s, i))
                                [by discharge given-i-below-succ-k]
                            }
                          @conclusion-extended-inner |
                            exists t2: Indexed; forall i: Nat; less_than(i, succ(k)) -> at(t2, i) = f(at(s, i))
                            [by witness(u) matches-below-succ-k]
                        }
                      @conclusion-with-joined |
                        exists t2: Indexed; forall i: Nat; less_than(i, succ(k)) -> at(t2, i) = f(at(s, i))
                        [by unpacked with-joined]
                    }
                  @conclusion-with-singleton |
                    exists t2: Indexed; forall i: Nat; less_than(i, succ(k)) -> at(t2, i) = f(at(s, i))
                    [by unpacked with-singleton]
                }
              @conclusion-step |
                exists t: Indexed; forall i: Nat; less_than(i, succ(k)) -> at(t, i) = f(at(s, i))
                [by unpacked with-prefix]
            }
          @induction-step-at-k |
            (exists t: Indexed; forall i: Nat; less_than(i, k) -> at(t, i) = f(at(s, i))) -> (exists t: Indexed; forall i: Nat; less_than(i, succ(k)) -> at(t, i) = f(at(s, i)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; (exists t: Indexed; forall i: Nat; less_than(i, k) -> at(t, i) = f(at(s, i))) -> (exists t: Indexed; forall i: Nat; less_than(i, succ(k)) -> at(t, i) = f(at(s, i)))
        [by generalize induction-step]
      @conclusion-for-all-m |
        forall m: Nat; exists t: Indexed; forall i: Nat; less_than(i, m) -> at(t, i) = f(at(s, i))
        [using instantiation peano.induction((fun m: Nat => exists t: Indexed; forall i: Nat; less_than(i, m) -> at(t, i) = f(at(s, i)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Indexed; forall m: Nat; exists t: Indexed; forall i: Nat; less_than(i, m) -> at(t, i) = f(at(s, i))
    [by generalize generalize-s]
qed

// -- GENERIC LISTING LEMMAS: index bookkeeping, no carrier structure ---------------------------
// These were written out TWICE, once per carrier (`std/group/listing.b4m` over `Grp`,
// `std/permutation/listing.b4m` over `Fn`) — 168 lines whose entire diff was the schema
// parameter's sort token. They cite only Peano order facts and `at`: nothing about the
// carrier's own operation, identity or inverses. So they belong here, proved once over
// `Indexed`, and each carrier gets them by modelling this theory.

theorem skippingAnEntry(prop(Item)): forall w: Indexed; forall k: Nat; (not prop(at(w, k))) ->
  forall v: Indexed; forall p: Nat;
  ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i)))
  and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
  and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
  ->
  ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i)))
  and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
  and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
proof
  @generalize-w |
    fix w: Indexed {
      @generalize-k |
        fix k: Nat {
          @given-entry-fails |
            assume not prop(at(w, k)) {
              @entry-fails |
                not prop(at(w, k))
                [by hypothesis given-entry-fails]
              @generalize-v |
                fix v: Indexed {
                  @generalize-p |
                    fix p: Nat {
                      @given-sublisting |
                        assume (forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)) {
                          @sublisting |
                            (forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))
                            [by hypothesis given-sublisting]
                          @entries |
                            forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                            [using tautology sublisting]
                          @injective |
                            forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j
                            [using tautology sublisting]
                          @covers |
                            forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                            [using tautology sublisting]

                          // entries: the source index moves up a range
                          @generalize-j-for-entries |
                            fix j: Nat {
                              @given-j-in-range |
                                assume less_than(j, p) {
                                  @j-in-range |
                                    less_than(j, p)
                                    [by hypothesis given-j-in-range]
                                  @source-exists |
                                    exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                    [using specialize entries(j) j-in-range]
                                  @with-source-i |
                                    unpack i: Nat from source-exists {
                                      @source-facts |
                                        less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                        [by hypothesis with-source-i]
                                      @i-below-k |
                                        less_than(i, k)
                                        [using tautology source-facts]
                                      @i-below-succ-k |
                                        less_than(i, succ(k))
                                        [using specialize peano_order.lessThanSuccRight(i, k) i-below-k]
                                      @source-facts-moved |
                                        less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))
                                        [using tautology source-facts i-below-succ-k]
                                      @conclusion-witness-i |
                                        exists i2: Nat; less_than(i2, succ(k)) and at(v, j) = at(w, i2) and prop(at(w, i2))
                                        [by witness(i) source-facts-moved]
                                    }
                                  @conclusion-source-moved |
                                    exists i2: Nat; less_than(i2, succ(k)) and at(v, j) = at(w, i2) and prop(at(w, i2))
                                    [by unpacked with-source-i]
                                }
                              @conclusion-entry-clause |
                                less_than(j, p) -> exists i2: Nat; less_than(i2, succ(k)) and at(v, j) = at(w, i2) and prop(at(w, i2))
                                [by discharge given-j-in-range]
                            }
                          @entries-moved |
                            forall j: Nat; less_than(j, p) -> exists i2: Nat; less_than(i2, succ(k)) and at(v, j) = at(w, i2) and prop(at(w, i2))
                            [by generalize generalize-j-for-entries]

                          // covering: the new index k fails prop, so nothing new to cover
                          @generalize-i-for-covers |
                            fix i: Nat {
                              @given-i-below-succ-k |
                                assume less_than(i, succ(k)) {
                                  @given-i-satisfies |
                                    assume prop(at(w, i)) {
                                      @i-below-succ-k |
                                        less_than(i, succ(k))
                                        [by hypothesis given-i-below-succ-k]
                                      @i-satisfies |
                                        prop(at(w, i))
                                        [by hypothesis given-i-satisfies]
                                      @i-splits |
                                        less_than(i, k) or i = k
                                        [using specialize peano_order.lessThanSuccSplit(i, k) i-below-succ-k]
                                      @conclusion-covered |
                                        exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                        case i-splits {
                                          @when-i-below-k |
                                            assume less_than(i, k) {
                                              @i-below-k |
                                                less_than(i, k)
                                                [by hypothesis when-i-below-k]
                                              @conclusion-covered-below |
                                                exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                                [using specialize covers(i) i-below-k i-satisfies]
                                            }
                                          @when-i-is-k |
                                            assume i = k {
                                              @i-is-k |
                                                i = k
                                                [by hypothesis when-i-is-k]
                                              @k-satisfies |
                                                prop(at(w, k))
                                                [by rewrite i-is-k i-satisfies]
                                              @conclusion-covered-absurdly |
                                                exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                                [by ex_falso k-satisfies entry-fails]
                                            }
                                        }
                                    }
                                  @conclusion-given-satisfies |
                                    prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                    [by discharge given-i-satisfies]
                                }
                              @conclusion-covers-at-i |
                                less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                [by discharge given-i-below-succ-k]
                            }
                          @covers-moved |
                            forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                            [by generalize generalize-i-for-covers]
                          @conclusion-sublisting-moved |
                            (forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))
                            [using tautology entries-moved injective covers-moved]
                        }
                      @conclusion-at-p |
                        ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                        [by discharge given-sublisting]
                    }
                  @discharge-p |
                    forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                    [by generalize generalize-p]
                }
              @discharge-v |
                forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                [by generalize generalize-v]
            }
          @conclusion-at-k |
            (not prop(at(w, k))) -> forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
            [by discharge given-entry-fails]
        }
      @discharge-k |
        forall k: Nat; (not prop(at(w, k))) -> forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
        [by generalize generalize-k]
    }
  @conclusion |
    forall w: Indexed; forall k: Nat; (not prop(at(w, k))) ->
      forall v: Indexed; forall p: Nat;
      ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i)))
      and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
      and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
      ->
      ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, succ(k)) and at(v, j) = at(w, i) and prop(at(w, i)))
      and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j)
      and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
    [by generalize generalize-w]
qed

theorem extendingASublisting(prop(Item)): forall w: Indexed; forall m: Nat;
  (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) ->
  forall k: Nat; less_than(k, m) -> prop(at(w, k)) ->
  forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) ->
  exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
proof
  @generalize-w |
    fix w: Indexed {
      @generalize-m |
        fix m: Nat {
          @given-w-injective |
            assume (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) {
              @w-injective |
                (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j)
                [by hypothesis given-w-injective]
              @generalize-k |
                fix k: Nat {
                  @given-k-in-range |
                    assume less_than(k, m) {
                      @given-entry-satisfies |
                        assume prop(at(w, k)) {
                          @k-in-range |
                            less_than(k, m)
                            [by hypothesis given-k-in-range]
                          @entry-k-satisfies |
                            prop(at(w, k))
                            [by hypothesis given-entry-satisfies]
                          @generalize-v |
                            fix v: Indexed {
                              @generalize-p |
                                fix p: Nat {
                                  @given-sublisting |
                                    assume ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) {
                                      @sublisting |
                                        ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)))
                                        [by hypothesis given-sublisting]
                                      @entries |
                                        forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                        [using tautology sublisting]
                                      @injective |
                                        forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j
                                        [using tautology sublisting]
                                      @covers |
                                        forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                        [using tautology sublisting]
                                      @singleton-exists |
                                        exists s: Indexed; at(s, ZERO) = at(w, k)
                                        [using specialize indexedSingleton(at(w, k))]
                                      @k-below-succ-k |
                                        less_than(k, succ(k))
                                        [using specialize peano_order.lessThanSelf(k)]
                                      @p-below-succ-p |
                                        less_than(p, succ(p))
                                        [using specialize peano_order.lessThanSelf(p)]
                                      @with-singleton-s |
                                        unpack s: Indexed from singleton-exists {
                                          @singleton-head |
                                            at(s, ZERO) = at(w, k)
                                            [by hypothesis with-singleton-s]
                                          @concatenation-exists |
                                            exists u: Indexed; (forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i))
                                            [using specialize indexedConcat(v, s, p, succ(ZERO))]
                                          @with-concatenation-u |
                                            unpack u: Indexed from concatenation-exists {
                                              @agreement-pair |
                                                (forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)) and (forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i))
                                                [by hypothesis with-concatenation-u]
                                              @prefix-agrees |
                                                forall i: Nat; less_than(i, p) -> at(u, i) = at(v, i)
                                                [by and_lhs agreement-pair]
                                              @block-agrees |
                                                forall i: Nat; less_than(i, succ(ZERO)) -> at(u, add(p, i)) = at(s, i)
                                                [by and_rhs agreement-pair]
                                              @zero-below-one |
                                                less_than(ZERO, succ(ZERO))
                                                [using specialize peano_order.lessThanSelf(ZERO)]
                                              @u-at-p-plus-zero |
                                                at(u, add(p, ZERO)) = at(s, ZERO)
                                                [using specialize block-agrees(ZERO) zero-below-one]
                                              @p-plus-zero-is-p |
                                                add(p, ZERO) = p
                                                [using specialize peano.addZeroRight(p)]
                                              @u-at-p |
                                                at(u, p) = at(s, ZERO)
                                                [by rewrite p-plus-zero-is-p u-at-p-plus-zero]
                                              @last-entry-is-entry-k |
                                                at(u, p) = at(w, k)
                                                [using chain u-at-p singleton-head]

                                              // entries: the old ones, and the new last one
                                              @generalize-j-for-entries |
                                                fix j: Nat {
                                                  @given-j-in-range |
                                                    assume less_than(j, succ(p)) {
                                                      @j-in-range |
                                                        less_than(j, succ(p))
                                                        [by hypothesis given-j-in-range]
                                                      @j-splits |
                                                        less_than(j, p) or j = p
                                                        [using specialize peano_order.lessThanSuccSplit(j, p) j-in-range]
                                                      @conclusion-entry-has-a-source |
                                                        exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                        case j-splits {
                                                          @when-j-old |
                                                            assume less_than(j, p) {
                                                              @j-old |
                                                                less_than(j, p)
                                                                [by hypothesis when-j-old]
                                                              @entry-is-old-entry |
                                                                at(u, j) = at(v, j)
                                                                [using specialize prefix-agrees(j) j-old]
                                                              @source-exists |
                                                                exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                                                [using specialize entries(j) j-old]
                                                              @with-source-i |
                                                                unpack i: Nat from source-exists {
                                                                  @source-facts |
                                                                    less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))
                                                                    [by hypothesis with-source-i]
                                                                  @i-below-k |
                                                                    less_than(i, k)
                                                                    [using tautology source-facts]
                                                                  @old-entry-is-source |
                                                                    at(v, j) = at(w, i)
                                                                    [using tautology source-facts]
                                                                  @i-below-succ-k |
                                                                    less_than(i, succ(k))
                                                                    [using specialize peano_order.lessThanSuccRight(i, k) i-below-k]
                                                                  @entry-is-source |
                                                                    at(u, j) = at(w, i)
                                                                    [using chain entry-is-old-entry old-entry-is-source]
                                                                  @source-facts-for-u |
                                                                    less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                                    [using tautology source-facts i-below-succ-k entry-is-source]
                                                                  @conclusion-witness-i |
                                                                    exists i2: Nat; less_than(i2, succ(k)) and at(u, j) = at(w, i2) and prop(at(w, i2))
                                                                    [by witness(i) source-facts-for-u]
                                                                }
                                                              @conclusion-old-source |
                                                                exists i2: Nat; less_than(i2, succ(k)) and at(u, j) = at(w, i2) and prop(at(w, i2))
                                                                [by unpacked with-source-i]
                                                            }
                                                          @when-j-new |
                                                            assume j = p {
                                                              @j-new |
                                                                j = p
                                                                [by hypothesis when-j-new]
                                                              @entry-is-entry-k |
                                                                at(u, j) = at(w, k)
                                                                [by rewrite j-new last-entry-is-entry-k]
                                                              @source-facts-for-k |
                                                                less_than(k, succ(k)) and at(u, j) = at(w, k) and prop(at(w, k))
                                                                [using tautology k-below-succ-k entry-is-entry-k entry-k-satisfies]
                                                              @conclusion-new-source |
                                                                exists i2: Nat; less_than(i2, succ(k)) and at(u, j) = at(w, i2) and prop(at(w, i2))
                                                                [by witness(k) source-facts-for-k]
                                                            }
                                                        }
                                                    }
                                                  @conclusion-entry-clause |
                                                    less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                    [by discharge given-j-in-range]
                                                }
                                              @entries-extended |
                                                forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))
                                                [by generalize generalize-j-for-entries]

                                              // no repeats: an old entry is some at(w, i0) with i0 < k, never at(w, k)
                                              @generalize-i-for-injective |
                                                fix i: Nat {
                                                  @generalize-j-for-injective |
                                                    fix j: Nat {
                                                      @given-i-in-range |
                                                        assume less_than(i, succ(p)) {
                                                          @given-j-in-range-too |
                                                            assume less_than(j, succ(p)) {
                                                              @given-entries-equal |
                                                                assume at(u, i) = at(u, j) {
                                                                  @i-in-range |
                                                                    less_than(i, succ(p))
                                                                    [by hypothesis given-i-in-range]
                                                                  @j-in-range-too |
                                                                    less_than(j, succ(p))
                                                                    [by hypothesis given-j-in-range-too]
                                                                  @entries-equal |
                                                                    at(u, i) = at(u, j)
                                                                    [by hypothesis given-entries-equal]
                                                                  @i-splits |
                                                                    less_than(i, p) or i = p
                                                                    [using specialize peano_order.lessThanSuccSplit(i, p) i-in-range]
                                                                  @j-splits |
                                                                    less_than(j, p) or j = p
                                                                    [using specialize peano_order.lessThanSuccSplit(j, p) j-in-range-too]
                                                                  @conclusion-indices-equal |
                                                                    i = j
                                                                    case i-splits {
                                                                      @when-i-old |
                                                                        assume less_than(i, p) {
                                                                          @i-old |
                                                                            less_than(i, p)
                                                                            [by hypothesis when-i-old]
                                                                          @entry-i-is-old |
                                                                            at(u, i) = at(v, i)
                                                                            [using specialize prefix-agrees(i) i-old]
                                                                          @conclusion-from-old-i |
                                                                            i = j
                                                                            case j-splits {
                                                                              @when-j-old |
                                                                                assume less_than(j, p) {
                                                                                  @j-old |
                                                                                    less_than(j, p)
                                                                                    [by hypothesis when-j-old]
                                                                                  @entry-j-is-old |
                                                                                    at(u, j) = at(v, j)
                                                                                    [using specialize prefix-agrees(j) j-old]
                                                                                  @old-i-is-entry-j |
                                                                                    at(v, i) = at(u, j)
                                                                                    [by rewrite entry-i-is-old entries-equal]
                                                                                  @old-entries-equal |
                                                                                    at(v, i) = at(v, j)
                                                                                    [by rewrite entry-j-is-old old-i-is-entry-j]
                                                                                  @conclusion-both-old |
                                                                                    i = j
                                                                                    [using specialize injective(i, j) i-old j-old old-entries-equal]
                                                                                }
                                                                              @when-j-new |
                                                                                assume j = p {
                                                                                  @j-new |
                                                                                    j = p
                                                                                    [by hypothesis when-j-new]
                                                                                  @entry-j-is-entry-k |
                                                                                    at(u, j) = at(w, k)
                                                                                    [by rewrite j-new last-entry-is-entry-k]
                                                                                  @old-i-is-entry-j |
                                                                                    at(v, i) = at(u, j)
                                                                                    [by rewrite entry-i-is-old entries-equal]
                                                                                  @old-i-is-entry-k |
                                                                                    at(v, i) = at(w, k)
                                                                                    [by rewrite entry-j-is-entry-k old-i-is-entry-j]
                                                                                  @source-exists |
                                                                                    exists i0: Nat; less_than(i0, k) and at(v, i) = at(w, i0) and prop(at(w, i0))
                                                                                    [using specialize entries(i) i-old]
                                                                                  @with-source-i0 |
                                                                                    unpack i0: Nat from source-exists {
                                                                                      @source-facts |
                                                                                        less_than(i0, k) and at(v, i) = at(w, i0) and prop(at(w, i0))
                                                                                        [by hypothesis with-source-i0]
                                                                                      @i0-below-k |
                                                                                        less_than(i0, k)
                                                                                        [using tautology source-facts]
                                                                                      @old-i-is-source |
                                                                                        at(v, i) = at(w, i0)
                                                                                        [using tautology source-facts]
                                                                                      @i0-in-range |
                                                                                        less_than(i0, m)
                                                                                        [using specialize peano_order.lessThanTransitive(i0, k, m) i0-below-k k-in-range]
                                                                                      @source-is-entry-k |
                                                                                        at(w, i0) = at(w, k)
                                                                                        [by rewrite old-i-is-source old-i-is-entry-k]
                                                                                      @i0-is-k |
                                                                                        i0 = k
                                                                                        [using specialize w-injective(i0, k) i0-in-range k-in-range source-is-entry-k]
                                                                                      @k-below-itself |
                                                                                        less_than(k, k)
                                                                                        [by rewrite i0-is-k i0-below-k]
                                                                                      @k-not-below-itself |
                                                                                        not less_than(k, k)
                                                                                        [using specialize peano_order.lessThanIrreflexive(k)]
                                                                                      @conclusion-old-new-ex_falso |
                                                                                        i = j
                                                                                        [by ex_falso k-below-itself k-not-below-itself]
                                                                                    }
                                                                                  @conclusion-old-then-new |
                                                                                    i = j
                                                                                    [by unpacked with-source-i0]
                                                                                }
                                                                            }
                                                                        }
                                                                      @when-i-new |
                                                                        assume i = p {
                                                                          @i-new |
                                                                            i = p
                                                                            [by hypothesis when-i-new]
                                                                          @entry-i-is-entry-k |
                                                                            at(u, i) = at(w, k)
                                                                            [by rewrite i-new last-entry-is-entry-k]
                                                                          @conclusion-from-new-i |
                                                                            i = j
                                                                            case j-splits {
                                                                              @when-j-old |
                                                                                assume less_than(j, p) {
                                                                                  @j-old |
                                                                                    less_than(j, p)
                                                                                    [by hypothesis when-j-old]
                                                                                  @entry-j-is-old |
                                                                                    at(u, j) = at(v, j)
                                                                                    [using specialize prefix-agrees(j) j-old]
                                                                                  @entry-i-is-old-j |
                                                                                    at(u, i) = at(v, j)
                                                                                    [by rewrite entry-j-is-old entries-equal]
                                                                                  @old-j-is-entry-k |
                                                                                    at(v, j) = at(w, k)
                                                                                    [by rewrite entry-i-is-old-j entry-i-is-entry-k]
                                                                                  @source-exists |
                                                                                    exists j0: Nat; less_than(j0, k) and at(v, j) = at(w, j0) and prop(at(w, j0))
                                                                                    [using specialize entries(j) j-old]
                                                                                  @with-source-j0 |
                                                                                    unpack j0: Nat from source-exists {
                                                                                      @source-facts |
                                                                                        less_than(j0, k) and at(v, j) = at(w, j0) and prop(at(w, j0))
                                                                                        [by hypothesis with-source-j0]
                                                                                      @j0-below-k |
                                                                                        less_than(j0, k)
                                                                                        [using tautology source-facts]
                                                                                      @old-j-is-source |
                                                                                        at(v, j) = at(w, j0)
                                                                                        [using tautology source-facts]
                                                                                      @j0-in-range |
                                                                                        less_than(j0, m)
                                                                                        [using specialize peano_order.lessThanTransitive(j0, k, m) j0-below-k k-in-range]
                                                                                      @source-is-entry-k |
                                                                                        at(w, j0) = at(w, k)
                                                                                        [by rewrite old-j-is-source old-j-is-entry-k]
                                                                                      @j0-is-k |
                                                                                        j0 = k
                                                                                        [using specialize w-injective(j0, k) j0-in-range k-in-range source-is-entry-k]
                                                                                      @k-below-itself |
                                                                                        less_than(k, k)
                                                                                        [by rewrite j0-is-k j0-below-k]
                                                                                      @k-not-below-itself |
                                                                                        not less_than(k, k)
                                                                                        [using specialize peano_order.lessThanIrreflexive(k)]
                                                                                      @conclusion-new-old-ex_falso |
                                                                                        i = j
                                                                                        [by ex_falso k-below-itself k-not-below-itself]
                                                                                    }
                                                                                  @conclusion-new-then-old |
                                                                                    i = j
                                                                                    [by unpacked with-source-j0]
                                                                                }
                                                                              @when-j-new |
                                                                                assume j = p {
                                                                                  @j-new |
                                                                                    j = p
                                                                                    [by hypothesis when-j-new]
                                                                                  @conclusion-both-new |
                                                                                    i = j
                                                                                    [by rewrite j-new i-new]
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                              @conclusion-given-equal |
                                                                at(u, i) = at(u, j) -> i = j
                                                                [by discharge given-entries-equal]
                                                            }
                                                          @conclusion-given-j |
                                                            less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                            [by discharge given-j-in-range-too]
                                                        }
                                                      @conclusion-injective-at-i-j |
                                                        less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                        [by discharge given-i-in-range]
                                                    }
                                                  @discharge-j-for-injective |
                                                    forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                    [by generalize generalize-j-for-injective]
                                                }
                                              @injective-extended |
                                                forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j
                                                [by generalize generalize-i-for-injective]

                                              // covering: an old source is covered as before, the new one by the last entry
                                              @generalize-i-for-covers |
                                                fix i: Nat {
                                                  @given-i-below-succ-k |
                                                    assume less_than(i, succ(k)) {
                                                      @given-i-satisfies |
                                                        assume prop(at(w, i)) {
                                                          @i-below-succ-k |
                                                            less_than(i, succ(k))
                                                            [by hypothesis given-i-below-succ-k]
                                                          @i-satisfies |
                                                            prop(at(w, i))
                                                            [by hypothesis given-i-satisfies]
                                                          @i-splits |
                                                            less_than(i, k) or i = k
                                                            [using specialize peano_order.lessThanSuccSplit(i, k) i-below-succ-k]
                                                          @conclusion-covered |
                                                            exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                            case i-splits {
                                                              @when-i-below-k |
                                                                assume less_than(i, k) {
                                                                  @i-below-k |
                                                                    less_than(i, k)
                                                                    [by hypothesis when-i-below-k]
                                                                  @old-index-exists |
                                                                    exists j: Nat; less_than(j, p) and at(v, j) = at(w, i)
                                                                    [using specialize covers(i) i-below-k i-satisfies]
                                                                  @with-old-index-j |
                                                                    unpack j: Nat from old-index-exists {
                                                                      @old-index-facts |
                                                                        less_than(j, p) and at(v, j) = at(w, i)
                                                                        [by hypothesis with-old-index-j]
                                                                      @j-old |
                                                                        less_than(j, p)
                                                                        [by and_lhs old-index-facts]
                                                                      @old-entry-is-source |
                                                                        at(v, j) = at(w, i)
                                                                        [by and_rhs old-index-facts]
                                                                      @j-in-range |
                                                                        less_than(j, succ(p))
                                                                        [using specialize peano_order.lessThanSuccRight(j, p) j-old]
                                                                      @entry-is-old-entry |
                                                                        at(u, j) = at(v, j)
                                                                        [using specialize prefix-agrees(j) j-old]
                                                                      @entry-is-source |
                                                                        at(u, j) = at(w, i)
                                                                        [using chain entry-is-old-entry old-entry-is-source]
                                                                      @j-in-range-and-hits |
                                                                        less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                                        [by both j-in-range entry-is-source]
                                                                      @conclusion-witness-j |
                                                                        exists j2: Nat; less_than(j2, succ(p)) and at(u, j2) = at(w, i)
                                                                        [by witness(j) j-in-range-and-hits]
                                                                    }
                                                                  @conclusion-covered-below |
                                                                    exists j2: Nat; less_than(j2, succ(p)) and at(u, j2) = at(w, i)
                                                                    [by unpacked with-old-index-j]
                                                                }
                                                              @when-i-is-k |
                                                                assume i = k {
                                                                  @i-is-k |
                                                                    i = k
                                                                    [by hypothesis when-i-is-k]
                                                                  @last-entry-is-source |
                                                                    at(u, p) = at(w, i)
                                                                    [by rewrite i-is-k last-entry-is-entry-k]
                                                                  @p-in-range-and-hits |
                                                                    less_than(p, succ(p)) and at(u, p) = at(w, i)
                                                                    [by both p-below-succ-p last-entry-is-source]
                                                                  @conclusion-covered-by-last |
                                                                    exists j2: Nat; less_than(j2, succ(p)) and at(u, j2) = at(w, i)
                                                                    [by witness(p) p-in-range-and-hits]
                                                                }
                                                            }
                                                        }
                                                      @conclusion-given-satisfies |
                                                        prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                        [by discharge given-i-satisfies]
                                                    }
                                                  @conclusion-covers-at-i |
                                                    less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                    [by discharge given-i-below-succ-k]
                                                }
                                              @covers-extended |
                                                forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)
                                                [by generalize generalize-i-for-covers]
                                              @extended-sublisting |
                                                ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(u, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(u, i) = at(u, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(u, j) = at(w, i)))
                                                [using tautology entries-extended injective-extended covers-extended]
                                              @conclusion-witness-u |
                                                exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                                [by witness(u) extended-sublisting]
                                            }
                                          @conclusion-with-u |
                                            exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                            [by unpacked with-concatenation-u]
                                        }
                                      @conclusion-with-s |
                                        exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                        [by unpacked with-singleton-s]
                                    }
                                  @conclusion-at-p |
                                    ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                    [by discharge given-sublisting]
                                }
                              @discharge-p |
                                forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                                [by generalize generalize-p]
                            }
                          @discharge-v |
                            forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                            [by generalize generalize-v]
                        }
                      @conclusion-given-satisfies |
                        prop(at(w, k)) -> forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                        [by discharge given-entry-satisfies]
                    }
                  @conclusion-at-k |
                    less_than(k, m) -> prop(at(w, k)) -> forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                    [by discharge given-k-in-range]
                }
              @discharge-k |
                forall k: Nat; less_than(k, m) -> prop(at(w, k)) -> forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
                [by generalize generalize-k]
            }
          @conclusion-at-m |
            (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, m) -> prop(at(w, k)) -> forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
            [by discharge given-w-injective]
        }
      @discharge-m |
        forall m: Nat; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, m) -> prop(at(w, k)) -> forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) -> exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
        [by generalize generalize-m]
    }
  @conclusion |
    forall w: Indexed; forall m: Nat;
      (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) ->
      forall k: Nat; less_than(k, m) -> prop(at(w, k)) ->
      forall v: Indexed; forall p: Nat; ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) ->
      exists v2: Indexed; ((forall j: Nat; less_than(j, succ(p)) -> exists i: Nat; less_than(i, succ(k)) and at(v2, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, succ(p)) -> less_than(j, succ(p)) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, succ(k)) -> prop(at(w, i)) -> exists j: Nat; less_than(j, succ(p)) and at(v2, j) = at(w, i)))
    [by generalize generalize-w]
qed

theorem splittingAPrefix(prop(Item)): forall w: Indexed; forall m: Nat; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> forall k: Nat; less_than(k, succ(m)) -> exists v: Indexed; exists p: Nat; exists v2: Indexed; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
proof
  @generalize-w |
    fix w: Indexed {
      @generalize-m |
        fix m: Nat {
          @given-w-injective |
            assume (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) {
              @w-injective |
                (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j)
                [by hypothesis given-w-injective]

              // base case: nothing below ZERO, so the empty sub-listings (any sequence, length ZERO)
              @base-case-proof |
                assume less_than(ZERO, succ(m)) {
                  @some-sequence-exists |
                    exists u: Indexed; at(u, ZERO) = at(w, ZERO)
                    [using specialize indexedSingleton(at(w, ZERO))]
                  @zero-plus-zero |
                    add(ZERO, ZERO) = ZERO
                    [using specialize peano.addZeroLeft(ZERO)]
                  @with-any-u |
                    unpack u: Indexed from some-sequence-exists {
                      @vacuous-entries |
                        fix j: Nat {
                          @nothing-below-zero |
                            not less_than(j, ZERO)
                            [using specialize peano_order.notLessThanZero(j)]
                          @conclusion-vacuous-entry |
                            less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))
                            [using tautology nothing-below-zero]
                        }
                      @no-entries |
                        forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and prop(at(w, i))
                        [by generalize vacuous-entries]
                      @vacuous-entries-complement |
                        fix j: Nat {
                          @nothing-below-zero |
                            not less_than(j, ZERO)
                            [using specialize peano_order.notLessThanZero(j)]
                          @conclusion-vacuous-entry-complement |
                            less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and (not prop(at(w, i)))
                            [using tautology nothing-below-zero]
                        }
                      @no-entries-complement |
                        forall j: Nat; less_than(j, ZERO) -> exists i: Nat; less_than(i, ZERO) and at(u, j) = at(w, i) and (not prop(at(w, i)))
                        [by generalize vacuous-entries-complement]
                      @vacuous-injective |
                        fix i: Nat {
                          @vacuous-injective-inner |
                            fix j: Nat {
                              @nothing-below-zero |
                                not less_than(i, ZERO)
                                [using specialize peano_order.notLessThanZero(i)]
                              @conclusion-vacuous-injective-clause |
                                less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j
                                [using tautology nothing-below-zero]
                            }
                          @discharge-j-vacuous |
                            forall j: Nat; less_than(i, ZERO) -> less_than(j, ZERO) -> at(u, i) = at(u, j) -> i = j
                            [by generalize vacuous-injective-inner]
                        }
                      @no-collisions |
