theorem splittingAListing(prop(Item)): forall m: Nat; forall w: Indexed; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> exists v: Indexed; exists p: Nat; exists v2: Indexed; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-w |
        fix w: Indexed {
          @given-w-injective |
            assume (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) {
              @w-injective |
                (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j)
                [by hypothesis given-w-injective]
              @m-below-succ-m |
                less_than(m, succ(m))
                [using specialize peano_order.lessThanSelf(m)]
              @prefix-splitting |
                forall w0: Indexed; forall m0: Nat; (forall i: Nat; forall j: Nat; less_than(i, m0) -> less_than(j, m0) -> at(w0, i) = at(w0, j) -> i = j) -> forall k0: Nat; less_than(k0, succ(m0)) -> exists v0: Indexed; exists p0: Nat; exists v20: Indexed; exists q0: Nat; add(p0, q0) = k0 and ((forall j: Nat; less_than(j, p0) -> exists i: Nat; less_than(i, k0) and at(v0, j) = at(w0, i) and prop(at(w0, i))) and (forall i: Nat; forall j: Nat; less_than(i, p0) -> less_than(j, p0) -> at(v0, i) = at(v0, j) -> i = j) and (forall i: Nat; less_than(i, k0) -> prop(at(w0, i)) -> exists j: Nat; less_than(j, p0) and at(v0, j) = at(w0, i))) and ((forall j: Nat; less_than(j, q0) -> exists i: Nat; less_than(i, k0) and at(v20, j) = at(w0, i) and (not prop(at(w0, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q0) -> less_than(j, q0) -> at(v20, i) = at(v20, j) -> i = j) and (forall i: Nat; less_than(i, k0) -> (not prop(at(w0, i))) -> exists j: Nat; less_than(j, q0) and at(v20, j) = at(w0, i)))
                [using instantiation splittingAPrefix((fun v: Item => prop(v)))]
              @conclusion-split |
                exists v: Indexed; exists p: Nat; exists v2: Indexed; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
                [using specialize prefix-splitting(w, m, m) w-injective m-below-succ-m]
            }
          @conclusion-at-w |
            (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> exists v: Indexed; exists p: Nat; exists v2: Indexed; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
            [by discharge given-w-injective]
        }
      @discharge-w |
        forall w: Indexed; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> exists v: Indexed; exists p: Nat; exists v2: Indexed; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall m: Nat; forall w: Indexed; (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> at(w, i) = at(w, j) -> i = j) -> exists v: Indexed; exists p: Nat; exists v2: Indexed; exists q: Nat; add(p, q) = m and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, m) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, m) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, m) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, m) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i)))
    [by generalize generalize-m]
qed
