                [using instantiation peano.induction((fun k: Nat => less_than(k, succ(m)) -> exists v: Indexed; exists p: Nat; exists v2: Indexed; exists q: Nat; add(p, q) = k and ((forall j: Nat; less_than(j, p) -> exists i: Nat; less_than(i, k) and at(v, j) = at(w, i) and prop(at(w, i))) and (forall i: Nat; forall j: Nat; less_than(i, p) -> less_than(j, p) -> at(v, i) = at(v, j) -> i = j) and (forall i: Nat; less_than(i, k) -> prop(at(w, i)) -> exists j: Nat; less_than(j, p) and at(v, j) = at(w, i))) and ((forall j: Nat; less_than(j, q) -> exists i: Nat; less_than(i, k) and at(v2, j) = at(w, i) and (not prop(at(w, i)))) and (forall i: Nat; forall j: Nat; less_than(i, q) -> less_than(j, q) -> at(v2, i) = at(v2, j) -> i = j) and (forall i: Nat; less_than(i, k) -> (not prop(at(w, i))) -> exists j: Nat; less_than(j, q) and at(v2, j) = at(w, i))))) base-case induction-step-for-all-k]
