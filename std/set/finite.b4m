// std/set/finite.b4m — EQUINUMEROSITY and finite cardinality.
//
// Cardinality is defined the USUAL way — by BIJECTION, not by an inductive count. Two
// sets are equinumerous when some map is a bijection from one ONTO the other, and a set
// is finite of size n when it is equinumerous with the initial segment {0, …, n-1}.
//
// Why bijection rather than a `hasSize(s, n)` recursion on `insert`: the inductive
// definition is structurally finite — its second argument is a `Nat`, so it can never
// relate two INFINITE sets. Defining equinumerosity first makes finiteness the special
// case where the counterpart is an initial segment, and leaves Cantor, Schröder–Bernstein
// and countability expressible in the same vocabulary later.
//
// The maps are ordinary `std/function.b4m` `Fn`s. A bijection BETWEEN SETS is not a new
// kind of object: it is a total `Fn` whose behavior is CONSTRAINED ON a source set —
// injective on it, and carrying it exactly onto a target set. What the function does
// outside the source is irrelevant and never reasoned about, which is the same device
// `inverse` already uses for a non-invertible argument. This works because
// `std/set.b4m` and `std/function.b4m` share `std/element.b4m`'s `Element` sort.

import set <<< "std/set.b4m"
import element <<< "std/element.b4m"
import function <<< "std/function.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

sort Element = element.Element
sort Set = set.Set
const emptyset = set.emptyset
pred member = set.member
axiom emptysetMember = set.emptysetMember
axiom extensionality = set.extensionality
func union = set.union
func intersection = set.intersection
func difference = set.difference
func singleton = set.singleton
axiom unionMember = set.unionMember
axiom intersectionMember = set.intersectionMember
axiom differenceMember = set.differenceMember
axiom singletonMember = set.singletonMember
theorem unionEmpty = set.unionEmpty
define subset(a, b) = set.subset(a, b)
theorem unionSingletonMember = set.unionSingletonMember
theorem differenceSingletonMember = set.differenceSingletonMember
theorem memberIsNotTheOutsider = set.memberIsNotTheOutsider
theorem restoringAnElement = set.restoringAnElement
theorem splittingOffAnElement = set.splittingOffAnElement
theorem disjointMeansNotBoth = set.disjointMeansNotBoth
theorem disjointWithSubset = set.disjointWithSubset
theorem removalLeavesASubset = set.removalLeavesASubset
theorem properSubsetHasAnOutsider = set.properSubsetHasAnOutsider

sort Fn = function.Fn
func apply = function.apply
func compose = function.compose
axiom composeApply = function.composeApply
const identityFn = function.identityFn
axiom identityApply = function.identityApply
axiom functionFromGraph = function.functionFromGraph

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
pred less_than = peano.less_than
theorem notLessThanZero = peano.notLessThanZero
theorem lessThanSuccSplit = peano_order.lessThanSuccSplit
theorem lessThanSuccRight = peano_order.lessThanSuccRight
theorem lessThanSelf = peano_order.lessThanSelf
theorem lessThanIrreflexive = peano_order.lessThanIrreflexive
theorem zeroOrSucc = peano.zeroOrSucc
func add = peano.add
define less_or_equal(a, b) = peano.less_or_equal(a, b)
theorem addZeroRight = peano.addZeroRight
theorem addSuccRight = peano.addSuccRight
theorem lessOrEqualRefl = peano_order.lessOrEqualRefl
theorem lessThanToLessOrEqual = peano_order.lessThanToLessOrEqual
theorem lessOrEqualToLessThanSucc = peano_order.lessOrEqualToLessThanSucc
theorem lessThanSuccToLessOrEqual = peano_order.lessThanSuccToLessOrEqual
theorem succPreservesOrder = peano_order.succPreservesOrder
axiom induction = peano.induction

// -- maps between sets ------------------------------------------------------

// `f` sends every element of `a` into `b`. (A total Fn does something everywhere; this
// constrains it only ON `a`, which is all a set-to-set map means here.)
define mapsInto(f, a, b) = forall x: Element; member(x, a) -> member(apply(f, x), b)

// `f` is INJECTIVE ON `a`: distinct elements of `a` have distinct images. The relativized
// twin of `function.injective`, and weaker than
// `function.injective`, which demands it everywhere — a map may collide outside `a` and
// still biject `a`.
define injectiveOn(f, a) =
  forall x: Element; forall y: Element;
  member(x, a) -> member(y, a) -> apply(f, x) = apply(f, y) -> x = y

// `f` is SURJECTIVE from `a` ONTO `b`: every element of `b` is the image of some element
// of `a`. The relativized twin of `function.surjective`, which demands every element of the
// whole universe be hit.
define surjectiveOnto(f, a, b) =
  forall y: Element; member(y, b) -> exists x: Element; member(x, a) and apply(f, x) = y

// `f` BIJECTS `a` onto `b`. The textbook pair — INJECTIVE and SURJECTIVE — both
// relativized to the two sets, plus `mapsInto` to say where `f` sends `a` at all (a total
// `Fn` does something everywhere; this pins the codomain).
define bijectsOnto(f, a, b) = mapsInto(f, a, b) and injectiveOn(f, a) and surjectiveOnto(f, a, b)

// -- the transposition map ---------------------------------------------------
//
// `swap(u, v)` exchanges `u` and `v` and fixes everything else — a TRANSPOSITION.
//
// It is the one map the counting argument must BUILD. Showing two segments of different
// length cannot be equinumerous goes by induction: from a bijection
// `segment(m+1) -> segment(n+1)`, produce one `segment(m) -> segment(n)` by dropping the
// top element of each. But the bijection may send the source's top into the MIDDLE of the
// target, so the tops do not line up. Composing with a swap that exchanges wherever the top
// landed with the actual top fixes that, and then the restriction is a bijection.
//
// Note what this route AVOIDS: the map is pinned by EQUATIONS on its values, so nothing
// here needs an inverse, a definite description, or choice.
func swap(u: Element, v: Element) => Fn:
  apply(swap(u, v), x) = v when x = u;
  apply(swap(u, v), x) = u when x = v;
  apply(swap(u, v), x) = x when x != u and x != v

// -- equinumerosity ---------------------------------------------------------

// `a` and `b` have the SAME SIZE: some map bijects one onto the other. This is the
// relation cardinality is built from, and it is meaningful for infinite sets too.
define equinumerous(a, b) = exists f: Fn; bijectsOnto(f, a, b)

// -- finiteness -------------------------------------------------------------

// The initial segment {0, …, n-1} as a SET. This needs the naturals to BE elements, so
// the theory takes an injection `numeral` from Nat into Element and cuts the segment
// membershipwise through it. (An abstract Element sort has no numbers of its own; naming
// them this way keeps sets of ANYTHING countable, which assuming Element = Nat would not.)
func numeral(n: Nat) => Element
axiom numeralInjective: forall m: Nat; forall n: Nat; numeral(m) = numeral(n) -> m = n

func segment(n: Nat) => Set
axiom segmentMember: forall n: Nat; forall x: Element;
  member(x, segment(n)) iff (exists k: Nat; less_than(k, n) and x = numeral(k))

// `a` HAS SIZE n when it is equinumerous with {0, …, n-1}.
define hasSize(a, n) = equinumerous(a, segment(n))

// `a` is FINITE when it has some size.
define isFinite(a) = exists n: Nat; hasSize(a, n)

// -- the first facts --------------------------------------------------------

// No natural is below ZERO, so no witness for the segment-ZERO membership body exists.
theorem noElementBelowZero: forall x: Element; not (exists k: Nat; less_than(k, ZERO) and x = numeral(k))
proof
  @generalize-x |
    fix x: Element {
      @suppose-a-witness |
        assume exists k: Nat; less_than(k, ZERO) and x = numeral(k) {
          @the-witness |
            exists k: Nat; less_than(k, ZERO) and x = numeral(k)
            [by hypothesis suppose-a-witness]
          @with-witness |
            unpack k: Nat from the-witness {
              @witness-facts |
                less_than(k, ZERO) and x = numeral(k)
                [by hypothesis with-witness]
              @witness-is-below-zero |
                less_than(k, ZERO)
                [by and_elim_left witness-facts]
              @nothing-is-below-zero |
                not less_than(k, ZERO)
                [using specialize notLessThanZero(k)]
              @conclusion-absurd |
                succ(ZERO) = ZERO
                [by absurd witness-is-below-zero nothing-is-below-zero]
            }
          @conclusion-contradiction |
            succ(ZERO) = ZERO
            [by exists_elim with-witness]
        }
      @zero-is-not-a-successor |
        succ(ZERO) != ZERO
        [using specialize peano.succNotZero(ZERO)]
      @conclusion-no-witness |
        not (exists k: Nat; less_than(k, ZERO) and x = numeral(k))
        [by not_intro suppose-a-witness conclusion-contradiction zero-is-not-a-successor]
    }
  @conclusion |
    forall x: Element; not (exists k: Nat; less_than(k, ZERO) and x = numeral(k))
    [by forall_intro generalize-x]
qed

// The empty segment is empty: nothing is below ZERO.
theorem segmentZeroIsEmpty: segment(ZERO) = emptyset
proof
  @pointwise-forward |
    fix x: Element {
      @membership-unfolds |
        member(x, segment(ZERO)) iff (exists k: Nat; less_than(k, ZERO) and x = numeral(k))
        [using specialize segmentMember(ZERO, x)]
      // no witness can exist: any k below ZERO contradicts notLessThanZero.
      @no-witness |
        not (exists k: Nat; less_than(k, ZERO) and x = numeral(k))
        [using specialize noElementBelowZero(x)]
      @not-in-the-empty-segment |
        not member(x, segment(ZERO))
        [using tautology membership-unfolds no-witness]
      @segment-into-empty |
        member(x, segment(ZERO)) -> member(x, emptyset)
        [using tautology not-in-the-empty-segment]
    }
  @discharge-forward |
    forall x: Element; member(x, segment(ZERO)) -> member(x, emptyset)
    [by forall_intro pointwise-forward]
  @pointwise-backward |
    fix x: Element {
      @not-in-the-empty-set |
        not member(x, emptyset)
        [using specialize emptysetMember(x)]
      @empty-into-segment |
        member(x, emptyset) -> member(x, segment(ZERO))
        [using tautology not-in-the-empty-set]
    }
  @discharge-backward |
    forall x: Element; member(x, emptyset) -> member(x, segment(ZERO))
    [by forall_intro pointwise-backward]
  @conclusion |
    segment(ZERO) = emptyset
    [using specialize extensionality(segment(ZERO), emptyset) discharge-forward discharge-backward]
qed

// The three identity facts, each pointwise from id(x) = x.
theorem identityMapsInto: forall a: Set; forall x: Element; member(x, a) -> member(apply(identityFn, x), a)
proof
  @generalize-a |
    fix a: Set {
      @generalize-x |
        fix x: Element {
          @given-member |
            assume member(x, a) {
              @x-is-a-member |
                member(x, a)
                [by hypothesis given-member]
              @identity-fixes-x |
                apply(identityFn, x) = x
                [using specialize identityApply(x)]
              @conclusion-image-is-a-member |
                member(apply(identityFn, x), a)
                [by rewrite identity-fixes-x x-is-a-member]
            }
          @conclusion-implication |
            member(x, a) -> member(apply(identityFn, x), a)
            [by implies_intro given-member]
        }
      @discharge-x |
        forall x: Element; member(x, a) -> member(apply(identityFn, x), a)
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall a: Set; forall x: Element; member(x, a) -> member(apply(identityFn, x), a)
    [by forall_intro generalize-a]
qed

theorem identityIsInjectiveOn: forall a: Set; forall x: Element; forall y: Element;
  member(x, a) -> member(y, a) -> apply(identityFn, x) = apply(identityFn, y) -> x = y
proof
  @generalize-a |
    fix a: Set {
      @generalize-x |
        fix x: Element {
          @generalize-y |
            fix y: Element {
              @given-x-member |
                assume member(x, a) {
                  @given-y-member |
                    assume member(y, a) {
                      @given-images-equal |
                        assume apply(identityFn, x) = apply(identityFn, y) {
                          @images-equal |
                            apply(identityFn, x) = apply(identityFn, y)
                            [by hypothesis given-images-equal]
                          @identity-fixes-x |
                            apply(identityFn, x) = x
                            [using specialize identityApply(x)]
                          @identity-fixes-y |
                            apply(identityFn, y) = y
                            [using specialize identityApply(y)]
                          @x-equals-image-of-y |
                            x = apply(identityFn, y)
                            [by rewrite identity-fixes-x images-equal]
                          @conclusion-equal |
                            x = y
                            [by rewrite identity-fixes-y x-equals-image-of-y]
                        }
                      @conclusion-images |
                        apply(identityFn, x) = apply(identityFn, y) -> x = y
                        [by implies_intro given-images-equal]
                    }
                  @conclusion-y |
                    member(y, a) -> apply(identityFn, x) = apply(identityFn, y) -> x = y
                    [by implies_intro given-y-member]
                }
              @conclusion-x |
                member(x, a) -> member(y, a) -> apply(identityFn, x) = apply(identityFn, y) -> x = y
                [by implies_intro given-x-member]
            }
          @discharge-y |
            forall y: Element; member(x, a) -> member(y, a) -> apply(identityFn, x) = apply(identityFn, y) -> x = y
            [by forall_intro generalize-y]
        }
      @discharge-x |
        forall x: Element; forall y: Element; member(x, a) -> member(y, a) -> apply(identityFn, x) = apply(identityFn, y) -> x = y
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall a: Set; forall x: Element; forall y: Element;
      member(x, a) -> member(y, a) -> apply(identityFn, x) = apply(identityFn, y) -> x = y
    [by forall_intro generalize-a]
qed

theorem identityCovers: forall a: Set; forall y: Element;
  member(y, a) -> exists x: Element; member(x, a) and apply(identityFn, x) = y
proof
  @generalize-a |
    fix a: Set {
      @generalize-y |
        fix y: Element {
          @given-y-member |
            assume member(y, a) {
              @y-is-a-member |
                member(y, a)
                [by hypothesis given-y-member]
              @identity-fixes-y |
                apply(identityFn, y) = y
                [using specialize identityApply(y)]
              @y-witnesses-itself |
                member(y, a) and apply(identityFn, y) = y
                [by and_intro y-is-a-member identity-fixes-y]
              @conclusion-witness |
                exists x: Element; member(x, a) and apply(identityFn, x) = y
                [by exists_intro(y) y-witnesses-itself]
            }
          @conclusion-implication |
            member(y, a) -> exists x: Element; member(x, a) and apply(identityFn, x) = y
            [by implies_intro given-y-member]
        }
      @discharge-y |
        forall y: Element; member(y, a) -> exists x: Element; member(x, a) and apply(identityFn, x) = y
        [by forall_intro generalize-y]
    }
  @conclusion |
    forall a: Set; forall y: Element; member(y, a) -> exists x: Element; member(x, a) and apply(identityFn, x) = y
    [by forall_intro generalize-a]
qed

// EVERY set is equinumerous with itself — the identity map bijects it onto itself.
// (Reflexivity: the first of the three properties that make equinumerosity an
// equivalence, and the one the empty-set size below needs.)
theorem equinumerousReflexive: forall a: Set; equinumerous(a, a)
proof
  @generalize-a |
    fix a: Set {
      // each of the three, pointwise: id(x) = x turns every obligation into a triviality.
      @identity-maps-into |
        forall x: Element; member(x, a) -> member(apply(identityFn, x), a)
        [using specialize identityMapsInto(a)]
      @identity-is-injective-on-a |
        forall x: Element; forall y: Element;
          member(x, a) -> member(y, a) -> apply(identityFn, x) = apply(identityFn, y) -> x = y
        [using specialize identityIsInjectiveOn(a)]
      @identity-covers |
        forall y: Element; member(y, a) -> exists x: Element; member(x, a) and apply(identityFn, x) = y
        [using specialize identityCovers(a)]
      @into-and-injective |
        mapsInto(identityFn, a, a) and injectiveOn(identityFn, a)
        [by and_intro identity-maps-into identity-is-injective-on-a]
      @identity-bijects |
        mapsInto(identityFn, a, a) and injectiveOn(identityFn, a) and surjectiveOnto(identityFn, a, a)
        [by and_intro into-and-injective identity-covers]
      @conclusion-witness |
        exists f: Fn; bijectsOnto(f, a, a)
        [by exists_intro(identityFn) identity-bijects]
    }
  @conclusion |
    forall a: Set; equinumerous(a, a)
    [by forall_intro generalize-a]
qed

// The empty set has size ZERO.
theorem emptysetHasSizeZero: hasSize(emptyset, ZERO)
proof
  @empty-segment |
    segment(ZERO) = emptyset
    [by cite segmentZeroIsEmpty]
  @empty-is-equinumerous-with-itself |
    equinumerous(emptyset, emptyset)
    [using specialize equinumerousReflexive(emptyset)]
  @conclusion |
    hasSize(emptyset, ZERO)
    [by rewrite empty-segment empty-is-equinumerous-with-itself]
qed

// A set of size ZERO is empty. (With `emptysetHasSizeZero` this pins size ZERO exactly:
// the empty set is the ONLY set of size zero — the base case of size uniqueness.)
theorem sizeZeroIsEmpty: forall a: Set; hasSize(a, ZERO) -> a = emptyset
proof
  @generalize-a |
    fix a: Set {
      @given-size-zero |
        assume hasSize(a, ZERO) {
          @the-bijection-exists |
            exists f: Fn; bijectsOnto(f, a, segment(ZERO))
            [by hypothesis given-size-zero]
          @with-bijection |
            unpack f: Fn from the-bijection-exists {
              @bijection-facts |
                mapsInto(f, a, segment(ZERO)) and injectiveOn(f, a) and surjectiveOnto(f, a, segment(ZERO))
                [by hypothesis with-bijection]
              @into-and-injective |
                mapsInto(f, a, segment(ZERO)) and injectiveOn(f, a)
                [by and_elim_left bijection-facts]
              @f-maps-into-the-empty-segment |
                forall x: Element; member(x, a) -> member(apply(f, x), segment(ZERO))
                [by and_elim_left into-and-injective]
              // every member of `a` would land in the EMPTY segment — so `a` has none.
              @pointwise-empty |
                fix x: Element {
                  @image-lands-in-the-segment |
                    member(x, a) -> member(apply(f, x), segment(ZERO))
                    [using specialize f-maps-into-the-empty-segment(x)]
                  @the-segment-is-empty |
                    segment(ZERO) = emptyset
                    [by cite segmentZeroIsEmpty]
                  @image-lands-in-the-empty-set |
                    member(x, a) -> member(apply(f, x), emptyset)
                    [by rewrite the-segment-is-empty image-lands-in-the-segment]
                  @nothing-is-in-the-empty-set |
                    not member(apply(f, x), emptyset)
                    [using specialize emptysetMember(apply(f, x))]
                  @x-is-not-a-member |
                    member(x, a) -> member(x, emptyset)
                    [using tautology image-lands-in-the-empty-set nothing-is-in-the-empty-set]
                }
              @a-is-included-in-empty |
                forall x: Element; member(x, a) -> member(x, emptyset)
                [by forall_intro pointwise-empty]
              @pointwise-backward |
                fix x: Element {
                  @not-in-the-empty-set |
                    not member(x, emptyset)
                    [using specialize emptysetMember(x)]
                  @empty-into-a |
                    member(x, emptyset) -> member(x, a)
                    [using tautology not-in-the-empty-set]
                }
              @empty-is-included-in-a |
                forall x: Element; member(x, emptyset) -> member(x, a)
                [by forall_intro pointwise-backward]
              @conclusion-equal |
                a = emptyset
                [using specialize extensionality(a, emptyset) a-is-included-in-empty empty-is-included-in-a]
            }
          @conclusion-unpacked |
            a = emptyset
            [by exists_elim with-bijection]
        }
      @conclusion-implication |
        hasSize(a, ZERO) -> a = emptyset
        [by implies_intro given-size-zero]
    }
  @conclusion |
    forall a: Set; hasSize(a, ZERO) -> a = emptyset
    [by forall_intro generalize-a]
qed

// The numerals below n are exactly the members of segment(n) — the bridge between the
// Nat-side bound and the Element-side membership, and the one place `numeralInjective`
// earns its keep (it is what makes `numeral(k) = numeral(j)` recover `k = j`).
theorem numeralInSegment: forall n: Nat; forall k: Nat;
  member(numeral(k), segment(n)) iff less_than(k, n)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-k |
        fix k: Nat {
          @membership-unfolds |
            member(numeral(k), segment(n)) iff (exists j: Nat; less_than(j, n) and numeral(k) = numeral(j))
            [using specialize segmentMember(n, numeral(k))]
          // forward: a witness j has numeral(k) = numeral(j), so k = j by injectivity.
          @given-member |
            assume member(numeral(k), segment(n)) {
              @is-a-member |
                member(numeral(k), segment(n))
                [by hypothesis given-member]
              @the-witness |
                exists j: Nat; less_than(j, n) and numeral(k) = numeral(j)
                [using tautology membership-unfolds is-a-member]
              @with-witness |
                unpack j: Nat from the-witness {
                  @witness-facts |
                    less_than(j, n) and numeral(k) = numeral(j)
                    [by hypothesis with-witness]
                  @witness-below-n |
                    less_than(j, n)
                    [by and_elim_left witness-facts]
                  @numerals-agree |
                    numeral(k) = numeral(j)
                    [by and_elim_right witness-facts]
                  @k-is-j |
                    k = j
                    [using specialize numeralInjective(k, j) numerals-agree]
                  @conclusion-below |
                    less_than(k, n)
                    [by rewrite k-is-j witness-below-n]
                }
              @conclusion-forward |
                less_than(k, n)
                [by exists_elim with-witness]
            }
          @member-implies-below |
            member(numeral(k), segment(n)) -> less_than(k, n)
            [by implies_intro given-member]
          // backward: k itself is the witness.
          @given-below |
            assume less_than(k, n) {
              @k-below-n |
                less_than(k, n)
                [by hypothesis given-below]
              @numeral-is-itself |
                numeral(k) = numeral(k)
                [by reflexivity]
              @k-witnesses |
                less_than(k, n) and numeral(k) = numeral(k)
                [by and_intro k-below-n numeral-is-itself]
              @the-witness-exists |
                exists j: Nat; less_than(j, n) and numeral(k) = numeral(j)
                [by exists_intro(k) k-witnesses]
              @conclusion-member |
                member(numeral(k), segment(n))
                [using tautology membership-unfolds the-witness-exists]
            }
          @below-implies-member |
            less_than(k, n) -> member(numeral(k), segment(n))
            [by implies_intro given-below]
          @conclusion-iff |
            member(numeral(k), segment(n)) iff less_than(k, n)
            [by iff_intro member-implies-below below-implies-member]
        }
      @discharge-k |
        forall k: Nat; member(numeral(k), segment(n)) iff less_than(k, n)
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall n: Nat; forall k: Nat; member(numeral(k), segment(n)) iff less_than(k, n)
    [by forall_intro generalize-n]
qed

// -- equinumerosity is an EQUIVALENCE ----------------------------------------
//
// Reflexivity is above (`equinumerousReflexive`). TRANSITIVITY composes the two
// bijections; SYMMETRY needs an inverse map and is harder — see below.

// The composite of a bijection a -> b with one b -> c bijects a -> c. Each of the three
// conditions transfers: into by chaining, injective by peeling the outer map's injectivity
// then the inner's, covering by pulling a c-element back through g and then through f.
// INTO: x in a sends through f into b, then through g into c.
theorem composeMapsInto: forall f: Fn; forall g: Fn; forall a: Set; forall b: Set; forall c: Set;
  mapsInto(f, a, b) -> mapsInto(g, b, c) -> mapsInto(compose(g, f), a, c)
proof
  @generalize-f |
    fix f: Fn {
      @generalize-g |
        fix g: Fn {
          @generalize-a |
            fix a: Set {
              @generalize-b |
                fix b: Set {
                  @generalize-c |
                    fix c: Set {
                      @given-f-into |
                        assume mapsInto(f, a, b) {
                          @given-g-into |
                            assume mapsInto(g, b, c) {
                              @f-into |
                                forall x: Element; member(x, a) -> member(apply(f, x), b)
                                [by hypothesis given-f-into]
                              @g-into |
                                forall x: Element; member(x, b) -> member(apply(g, x), c)
                                [by hypothesis given-g-into]
                              @pointwise |
                                fix x: Element {
                                  @given-x-in-a |
                                    assume member(x, a) {
                                      @x-in-a |
                                        member(x, a)
                                        [by hypothesis given-x-in-a]
                                      @fx-in-b |
                                        member(apply(f, x), b)
                                        [using specialize f-into(x) x-in-a]
                                      @gfx-in-c |
                                        member(apply(g, apply(f, x)), c)
                                        [using specialize g-into(apply(f, x)) fx-in-b]
                                      @composite-applies |
                                        apply(compose(g, f), x) = apply(g, apply(f, x))
                                        [using specialize composeApply(g, f, x)]
                                      @conclusion-x |
                                        member(apply(compose(g, f), x), c)
                                        [by rewrite composite-applies gfx-in-c]
                                    }
                                  @conclusion-implication |
                                    member(x, a) -> member(apply(compose(g, f), x), c)
                                    [by implies_intro given-x-in-a]
                                }
                              @conclusion-into |
                                forall x: Element; member(x, a) -> member(apply(compose(g, f), x), c)
                                [by forall_intro pointwise]
                            }
                          @conclusion-g |
                            mapsInto(g, b, c) -> mapsInto(compose(g, f), a, c)
                            [by implies_intro given-g-into]
                        }
                      @conclusion-f |
                        mapsInto(f, a, b) -> mapsInto(g, b, c) -> mapsInto(compose(g, f), a, c)
                        [by implies_intro given-f-into]
                    }
                  @discharge-c |
                    forall c: Set; mapsInto(f, a, b) -> mapsInto(g, b, c) -> mapsInto(compose(g, f), a, c)
                    [by forall_intro generalize-c]
                }
              @discharge-b |
                forall b: Set; forall c: Set; mapsInto(f, a, b) -> mapsInto(g, b, c) -> mapsInto(compose(g, f), a, c)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a: Set; forall b: Set; forall c: Set; mapsInto(f, a, b) -> mapsInto(g, b, c) -> mapsInto(compose(g, f), a, c)
            [by forall_intro generalize-a]
        }
      @discharge-g |
        forall g: Fn; forall a: Set; forall b: Set; forall c: Set; mapsInto(f, a, b) -> mapsInto(g, b, c) -> mapsInto(compose(g, f), a, c)
        [by forall_intro generalize-g]
    }
  @conclusion |
    forall f: Fn; forall g: Fn; forall a: Set; forall b: Set; forall c: Set;
      mapsInto(f, a, b) -> mapsInto(g, b, c) -> mapsInto(compose(g, f), a, c)
    [by forall_intro generalize-f]
qed

// INJECTIVE ON: if (g∘f)(x) = (g∘f)(y) for x, y in a, then g's injectivity on b (where f
// lands them) gives f(x) = f(y), and f's injectivity on a gives x = y.
theorem composeIsInjectiveOn: forall f: Fn; forall g: Fn; forall a: Set; forall b: Set;
  mapsInto(f, a, b) -> injectiveOn(f, a) -> injectiveOn(g, b) -> injectiveOn(compose(g, f), a)
proof
  @generalize-f |
    fix f: Fn {
      @generalize-g |
        fix g: Fn {
          @generalize-a |
            fix a: Set {
              @generalize-b |
                fix b: Set {
                  @given-into |
                    assume mapsInto(f, a, b) {
                      @given-f-injective |
                        assume injectiveOn(f, a) {
                          @given-g-injective |
                            assume injectiveOn(g, b) {
                              @f-into |
                                forall x: Element; member(x, a) -> member(apply(f, x), b)
                                [by hypothesis given-into]
                              @f-injective |
                                forall x: Element; forall y: Element;
                                  member(x, a) -> member(y, a) -> apply(f, x) = apply(f, y) -> x = y
                                [by hypothesis given-f-injective]
                              @g-injective |
                                forall x: Element; forall y: Element;
                                  member(x, b) -> member(y, b) -> apply(g, x) = apply(g, y) -> x = y
                                [by hypothesis given-g-injective]
                              @pointwise |
                                fix x: Element {
                                  @inner |
                                    fix y: Element {
                                      @given-x |
                                        assume member(x, a) {
                                          @given-y |
                                            assume member(y, a) {
                                              @given-images |
                                                assume apply(compose(g, f), x) = apply(compose(g, f), y) {
                                                  @x-in-a |
                                                    member(x, a)
                                                    [by hypothesis given-x]
                                                  @y-in-a |
                                                    member(y, a)
                                                    [by hypothesis given-y]
                                                  @images-equal |
                                                    apply(compose(g, f), x) = apply(compose(g, f), y)
                                                    [by hypothesis given-images]
                                                  @unfold-x |
                                                    apply(compose(g, f), x) = apply(g, apply(f, x))
                                                    [using specialize composeApply(g, f, x)]
                                                  @unfold-y |
                                                    apply(compose(g, f), y) = apply(g, apply(f, y))
                                                    [using specialize composeApply(g, f, y)]
                                                  // g(f(x)) = (g∘f)(x) = (g∘f)(y) = g(f(y))
                                                  @unfold-x-flipped |
                                                    apply(g, apply(f, x)) = apply(compose(g, f), x)
                                                    [by symmetry unfold-x]
                                                  @through-the-composite |
                                                    apply(g, apply(f, x)) = apply(compose(g, f), y)
                                                    [using chain unfold-x-flipped images-equal]
                                                  @g-images-equal |
                                                    apply(g, apply(f, x)) = apply(g, apply(f, y))
                                                    [using chain through-the-composite unfold-y]
                                                  @fx-in-b |
                                                    member(apply(f, x), b)
                                                    [using specialize f-into(x) x-in-a]
                                                  @fy-in-b |
                                                    member(apply(f, y), b)
                                                    [using specialize f-into(y) y-in-a]
                                                  @f-images-equal |
                                                    apply(f, x) = apply(f, y)
                                                    [using specialize g-injective(apply(f, x), apply(f, y)) fx-in-b fy-in-b g-images-equal]
                                                  @conclusion-equal |
                                                    x = y
                                                    [using specialize f-injective(x, y) x-in-a y-in-a f-images-equal]
                                                }
                                              @conclusion-images |
                                                apply(compose(g, f), x) = apply(compose(g, f), y) -> x = y
                                                [by implies_intro given-images]
                                            }
                                          @conclusion-y |
                                            member(y, a) -> apply(compose(g, f), x) = apply(compose(g, f), y) -> x = y
                                            [by implies_intro given-y]
                                        }
                                      @conclusion-x |
                                        member(x, a) -> member(y, a) -> apply(compose(g, f), x) = apply(compose(g, f), y) -> x = y
                                        [by implies_intro given-x]
                                    }
                                  @discharge-y |
                                    forall y: Element; member(x, a) -> member(y, a) -> apply(compose(g, f), x) = apply(compose(g, f), y) -> x = y
                                    [by forall_intro inner]
                                }
                              @conclusion-injective |
                                forall x: Element; forall y: Element;
                                  member(x, a) -> member(y, a) -> apply(compose(g, f), x) = apply(compose(g, f), y) -> x = y
                                [by forall_intro pointwise]
                            }
                          @conclusion-g |
                            injectiveOn(g, b) -> injectiveOn(compose(g, f), a)
                            [by implies_intro given-g-injective]
                        }
                      @conclusion-f |
                        injectiveOn(f, a) -> injectiveOn(g, b) -> injectiveOn(compose(g, f), a)
                        [by implies_intro given-f-injective]
                    }
                  @conclusion-into |
                    mapsInto(f, a, b) -> injectiveOn(f, a) -> injectiveOn(g, b) -> injectiveOn(compose(g, f), a)
                    [by implies_intro given-into]
                }
              @discharge-b |
                forall b: Set; mapsInto(f, a, b) -> injectiveOn(f, a) -> injectiveOn(g, b) -> injectiveOn(compose(g, f), a)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a: Set; forall b: Set; mapsInto(f, a, b) -> injectiveOn(f, a) -> injectiveOn(g, b) -> injectiveOn(compose(g, f), a)
            [by forall_intro generalize-a]
        }
      @discharge-g |
        forall g: Fn; forall a: Set; forall b: Set; mapsInto(f, a, b) -> injectiveOn(f, a) -> injectiveOn(g, b) -> injectiveOn(compose(g, f), a)
        [by forall_intro generalize-g]
    }
  @conclusion |
    forall f: Fn; forall g: Fn; forall a: Set; forall b: Set;
      mapsInto(f, a, b) -> injectiveOn(f, a) -> injectiveOn(g, b) -> injectiveOn(compose(g, f), a)
    [by forall_intro generalize-f]
qed

// COVERS: a z in c is g(y) for some y in b, and that y is f(x) for some x in a — so z is
// (g∘f)(x).
theorem composeIsSurjectiveOnto: forall f: Fn; forall g: Fn; forall a: Set; forall b: Set; forall c: Set;
  surjectiveOnto(f, a, b) -> surjectiveOnto(g, b, c) -> surjectiveOnto(compose(g, f), a, c)
proof
  @generalize-f |
    fix f: Fn {
      @generalize-g |
        fix g: Fn {
          @generalize-a |
            fix a: Set {
              @generalize-b |
                fix b: Set {
                  @generalize-c |
                    fix c: Set {
                      @given-f-covers |
                        assume surjectiveOnto(f, a, b) {
                          @given-g-covers |
                            assume surjectiveOnto(g, b, c) {
                              @f-covers |
                                forall y: Element; member(y, b) -> exists x: Element; member(x, a) and apply(f, x) = y
                                [by hypothesis given-f-covers]
                              @g-covers |
                                forall y: Element; member(y, c) -> exists x: Element; member(x, b) and apply(g, x) = y
                                [by hypothesis given-g-covers]
                              @pointwise |
                                fix z: Element {
                                  @given-z-in-c |
                                    assume member(z, c) {
                                      @z-in-c |
                                        member(z, c)
                                        [by hypothesis given-z-in-c]
                                      @g-preimage-exists |
                                        exists y: Element; member(y, b) and apply(g, y) = z
                                        [using specialize g-covers(z) z-in-c]
                                      @with-g-preimage |
                                        unpack y: Element from g-preimage-exists {
                                          @y-facts |
                                            member(y, b) and apply(g, y) = z
                                            [by hypothesis with-g-preimage]
                                          @y-in-b |
                                            member(y, b)
                                            [by and_elim_left y-facts]
                                          @g-of-y |
                                            apply(g, y) = z
                                            [by and_elim_right y-facts]
                                          @f-preimage-exists |
                                            exists x: Element; member(x, a) and apply(f, x) = y
                                            [using specialize f-covers(y) y-in-b]
                                          @with-f-preimage |
                                            unpack x: Element from f-preimage-exists {
                                              @x-facts |
                                                member(x, a) and apply(f, x) = y
                                                [by hypothesis with-f-preimage]
                                              @x-in-a |
                                                member(x, a)
                                                [by and_elim_left x-facts]
                                              @f-of-x |
                                                apply(f, x) = y
                                                [by and_elim_right x-facts]
                                              @composite-at-x |
                                                apply(compose(g, f), x) = apply(g, apply(f, x))
                                                [using specialize composeApply(g, f, x)]
                                              @composite-through-y |
                                                apply(compose(g, f), x) = apply(g, y)
                                                [by rewrite f-of-x composite-at-x]
                                              @composite-is-z |
                                                apply(compose(g, f), x) = z
                                                [using chain composite-through-y g-of-y]
                                              @x-witnesses |
                                                member(x, a) and apply(compose(g, f), x) = z
                                                [by and_intro x-in-a composite-is-z]
                                              @conclusion-witness |
                                                exists x2: Element; member(x2, a) and apply(compose(g, f), x2) = z
                                                [by exists_intro(x) x-witnesses]
                                            }
                                          @conclusion-f-preimage |
                                            exists x2: Element; member(x2, a) and apply(compose(g, f), x2) = z
                                            [by exists_elim with-f-preimage]
                                        }
                                      @conclusion-g-preimage |
                                        exists x2: Element; member(x2, a) and apply(compose(g, f), x2) = z
                                        [by exists_elim with-g-preimage]
                                    }
                                  @conclusion-implication |
                                    member(z, c) -> exists x2: Element; member(x2, a) and apply(compose(g, f), x2) = z
                                    [by implies_intro given-z-in-c]
                                }
                              @conclusion-covers |
                                forall z: Element; member(z, c) -> exists x2: Element; member(x2, a) and apply(compose(g, f), x2) = z
                                [by forall_intro pointwise]
                            }
                          @conclusion-g |
                            surjectiveOnto(g, b, c) -> surjectiveOnto(compose(g, f), a, c)
                            [by implies_intro given-g-covers]
                        }
                      @conclusion-f |
                        surjectiveOnto(f, a, b) -> surjectiveOnto(g, b, c) -> surjectiveOnto(compose(g, f), a, c)
                        [by implies_intro given-f-covers]
                    }
                  @discharge-c |
                    forall c: Set; surjectiveOnto(f, a, b) -> surjectiveOnto(g, b, c) -> surjectiveOnto(compose(g, f), a, c)
                    [by forall_intro generalize-c]
                }
              @discharge-b |
                forall b: Set; forall c: Set; surjectiveOnto(f, a, b) -> surjectiveOnto(g, b, c) -> surjectiveOnto(compose(g, f), a, c)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a: Set; forall b: Set; forall c: Set; surjectiveOnto(f, a, b) -> surjectiveOnto(g, b, c) -> surjectiveOnto(compose(g, f), a, c)
            [by forall_intro generalize-a]
        }
      @discharge-g |
        forall g: Fn; forall a: Set; forall b: Set; forall c: Set; surjectiveOnto(f, a, b) -> surjectiveOnto(g, b, c) -> surjectiveOnto(compose(g, f), a, c)
        [by forall_intro generalize-g]
    }
  @conclusion |
    forall f: Fn; forall g: Fn; forall a: Set; forall b: Set; forall c: Set;
      surjectiveOnto(f, a, b) -> surjectiveOnto(g, b, c) -> surjectiveOnto(compose(g, f), a, c)
    [by forall_intro generalize-f]
qed

// TRANSITIVITY: the composite of the two bijections is one.
theorem equinumerousTransitive: forall a: Set; forall b: Set; forall c: Set;
  equinumerous(a, b) -> equinumerous(b, c) -> equinumerous(a, c)
proof
  @generalize-a |
    fix a: Set {
      @generalize-b |
        fix b: Set {
          @generalize-c |
            fix c: Set {
              @given-a-b |
                assume equinumerous(a, b) {
                  @given-b-c |
                    assume equinumerous(b, c) {
                      @f-exists |
                        exists f: Fn; bijectsOnto(f, a, b)
                        [by hypothesis given-a-b]
                      @g-exists |
                        exists g: Fn; bijectsOnto(g, b, c)
                        [by hypothesis given-b-c]
                      @with-f |
                        unpack f: Fn from f-exists {
                          @f-bijects |
                            mapsInto(f, a, b) and injectiveOn(f, a) and surjectiveOnto(f, a, b)
                            [by hypothesis with-f]
                          @f-pair |
                            mapsInto(f, a, b) and injectiveOn(f, a)
                            [by and_elim_left f-bijects]
                          @f-into |
                            mapsInto(f, a, b)
                            [by and_elim_left f-pair]
                          @f-injective |
                            injectiveOn(f, a)
                            [by and_elim_right f-pair]
                          @f-covers |
                            surjectiveOnto(f, a, b)
                            [by and_elim_right f-bijects]
                          @with-g |
                            unpack g: Fn from g-exists {
                              @g-bijects |
                                mapsInto(g, b, c) and injectiveOn(g, b) and surjectiveOnto(g, b, c)
                                [by hypothesis with-g]
                              @g-pair |
                                mapsInto(g, b, c) and injectiveOn(g, b)
                                [by and_elim_left g-bijects]
                              @g-into |
                                mapsInto(g, b, c)
                                [by and_elim_left g-pair]
                              @g-injective |
                                injectiveOn(g, b)
                                [by and_elim_right g-pair]
                              @g-covers |
                                surjectiveOnto(g, b, c)
                                [by and_elim_right g-bijects]
                              @composite-into |
                                mapsInto(compose(g, f), a, c)
                                [using specialize composeMapsInto(f, g, a, b, c) f-into g-into]
                              @composite-injective |
                                injectiveOn(compose(g, f), a)
                                [using specialize composeIsInjectiveOn(f, g, a, b) f-into f-injective g-injective]
                              @composite-covers |
                                surjectiveOnto(compose(g, f), a, c)
                                [using specialize composeIsSurjectiveOnto(f, g, a, b, c) f-covers g-covers]
                              @composite-pair |
                                mapsInto(compose(g, f), a, c) and injectiveOn(compose(g, f), a)
                                [by and_intro composite-into composite-injective]
                              @composite-bijects |
                                mapsInto(compose(g, f), a, c) and injectiveOn(compose(g, f), a) and surjectiveOnto(compose(g, f), a, c)
                                [by and_intro composite-pair composite-covers]
                              @conclusion-witness |
                                exists h: Fn; bijectsOnto(h, a, c)
                                [by exists_intro(compose(g, f)) composite-bijects]
                            }
                          @conclusion-g |
                            exists h: Fn; bijectsOnto(h, a, c)
                            [by exists_elim with-g]
                        }
                      @conclusion-f |
                        exists h: Fn; bijectsOnto(h, a, c)
                        [by exists_elim with-f]
                    }
                  @conclusion-b-c |
                    equinumerous(b, c) -> equinumerous(a, c)
                    [by implies_intro given-b-c]
                }
              @conclusion-a-b |
                equinumerous(a, b) -> equinumerous(b, c) -> equinumerous(a, c)
                [by implies_intro given-a-b]
            }
          @discharge-c |
            forall c: Set; equinumerous(a, b) -> equinumerous(b, c) -> equinumerous(a, c)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b: Set; forall c: Set; equinumerous(a, b) -> equinumerous(b, c) -> equinumerous(a, c)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a: Set; forall b: Set; forall c: Set; equinumerous(a, b) -> equinumerous(b, c) -> equinumerous(a, c)
    [by forall_intro generalize-a]
qed

// `swap`'s three values, as ordinary theorems — each clause with its guard discharged, so
// downstream proofs cite a plain equation instead of re-deriving the case every time.
theorem swapAtFirst: forall u: Element; forall v: Element; apply(swap(u, v), u) = v
proof
  @clause |
    forall u: Element; forall v: Element; forall x: Element;
      x = u -> apply(swap(u, v), x) = v
    [by definition(0) swap]
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @at-u |
            u = u -> apply(swap(u, v), u) = v
            [by forall_elim(u, v, u) clause]
          @u-is-u |
            u = u
            [by reflexivity]
          @conclusion-uv |
            apply(swap(u, v), u) = v
            [by modus_ponens at-u u-is-u]
        }
      @discharge-v |
        forall v: Element; apply(swap(u, v), u) = v
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall u: Element; forall v: Element; apply(swap(u, v), u) = v
    [by forall_intro generalize-u]
qed

theorem swapAtSecond: forall u: Element; forall v: Element; apply(swap(u, v), v) = u
proof
  @clause |
    forall u: Element; forall v: Element; forall x: Element;
      x = v -> apply(swap(u, v), x) = u
    [by definition(1) swap]
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @at-v |
            v = v -> apply(swap(u, v), v) = u
            [by forall_elim(u, v, v) clause]
          @v-is-v |
            v = v
            [by reflexivity]
          @conclusion-uv |
            apply(swap(u, v), v) = u
            [by modus_ponens at-v v-is-v]
        }
      @discharge-v |
        forall v: Element; apply(swap(u, v), v) = u
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall u: Element; forall v: Element; apply(swap(u, v), v) = u
    [by forall_intro generalize-u]
qed

theorem swapElsewhere: forall u: Element; forall v: Element; forall x: Element;
  x != u -> x != v -> apply(swap(u, v), x) = x
proof
  @clause |
    forall u: Element; forall v: Element; forall x: Element;
      (x != u and x != v) -> apply(swap(u, v), x) = x
    [by definition(2) swap]
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @generalize-x |
            fix x: Element {
              @given-not-u |
                assume x != u {
                  @given-not-v |
                    assume x != v {
                      @not-u |
                        x != u
                        [by hypothesis given-not-u]
                      @not-v |
                        x != v
                        [by hypothesis given-not-v]
                      @neither |
                        x != u and x != v
                        [by and_intro not-u not-v]
                      @at-x |
                        (x != u and x != v) -> apply(swap(u, v), x) = x
                        [by forall_elim(u, v, x) clause]
                      @conclusion-x |
                        apply(swap(u, v), x) = x
                        [by modus_ponens at-x neither]
                    }
                  @conclusion-not-v |
                    x != v -> apply(swap(u, v), x) = x
                    [by implies_intro given-not-v]
                }
              @conclusion-not-u |
                x != u -> x != v -> apply(swap(u, v), x) = x
                [by implies_intro given-not-u]
            }
          @discharge-x |
            forall x: Element; x != u -> x != v -> apply(swap(u, v), x) = x
            [by forall_intro generalize-x]
        }
      @discharge-v |
        forall v: Element; forall x: Element; x != u -> x != v -> apply(swap(u, v), x) = x
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall u: Element; forall v: Element; forall x: Element;
      x != u -> x != v -> apply(swap(u, v), x) = x
    [by forall_intro generalize-u]
qed

// swap is an INVOLUTION: applying it twice returns the original. Three cases on x.
theorem swapIsAnInvolution: forall u: Element; forall v: Element; forall x: Element;
  apply(swap(u, v), apply(swap(u, v), x)) = x
proof
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @generalize-x |
            fix x: Element {
              @cases |
                x = u or x = v or (x != u and x != v)
                [using tautology]
              @conclusion-x |
                apply(swap(u, v), apply(swap(u, v), x)) = x
                case cases {
                  @when-x-is-u |
                    assume x = u {
                      @x-is-u |
                        x = u
                        [by hypothesis when-x-is-u]
                      @first-application |
                        apply(swap(u, v), u) = v
                        [using specialize swapAtFirst(u, v)]
                      @second-application |
                        apply(swap(u, v), v) = u
                        [using specialize swapAtSecond(u, v)]
                      @twice-at-u |
                        apply(swap(u, v), apply(swap(u, v), u)) = u
                        [by rewrite first-application second-application]
                      @conclusion-u |
                        apply(swap(u, v), apply(swap(u, v), x)) = x
                        [by rewrite x-is-u twice-at-u]
                    }
                  @when-x-is-v |
                    assume x = v {
                      @x-is-v |
                        x = v
                        [by hypothesis when-x-is-v]
                      @first-application |
                        apply(swap(u, v), v) = u
                        [using specialize swapAtSecond(u, v)]
                      @second-application |
                        apply(swap(u, v), u) = v
                        [using specialize swapAtFirst(u, v)]
                      @twice-at-v |
                        apply(swap(u, v), apply(swap(u, v), v)) = v
                        [by rewrite first-application second-application]
                      @conclusion-v |
                        apply(swap(u, v), apply(swap(u, v), x)) = x
                        [by rewrite x-is-v twice-at-v]
                    }
                  @when-x-is-neither |
                    assume x != u and x != v {
                      @neither |
                        x != u and x != v
                        [by hypothesis when-x-is-neither]
                      @not-u |
                        x != u
                        [by and_elim_left neither]
                      @not-v |
                        x != v
                        [by and_elim_right neither]
                      @fixed |
                        apply(swap(u, v), x) = x
                        [using specialize swapElsewhere(u, v, x) not-u not-v]
                      @conclusion-neither |
                        apply(swap(u, v), apply(swap(u, v), x)) = x
                        [by rewrite fixed fixed]
                    }
                }
            }
          @discharge-x |
            forall x: Element; apply(swap(u, v), apply(swap(u, v), x)) = x
            [by forall_intro generalize-x]
        }
      @discharge-v |
        forall v: Element; forall x: Element; apply(swap(u, v), apply(swap(u, v), x)) = x
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall u: Element; forall v: Element; forall x: Element;
      apply(swap(u, v), apply(swap(u, v), x)) = x
    [by forall_intro generalize-u]
qed

// INJECTIVE everywhere, hence on any set: if swap sends x and y to the same place, apply
// swap again — the involution returns x and y themselves, so they were equal.
theorem swapIsInjectiveOn: forall u: Element; forall v: Element; forall a: Set;
  injectiveOn(swap(u, v), a)
proof
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @generalize-a |
            fix a: Set {
              @pointwise |
                fix x: Element {
                  @inner |
                    fix y: Element {
                      @given-x |
                        assume member(x, a) {
                          @given-y |
                            assume member(y, a) {
                              @given-images |
                                assume apply(swap(u, v), x) = apply(swap(u, v), y) {
                                  @images-equal |
                                    apply(swap(u, v), x) = apply(swap(u, v), y)
                                    [by hypothesis given-images]
                                  @twice-x |
                                    apply(swap(u, v), apply(swap(u, v), x)) = x
                                    [using specialize swapIsAnInvolution(u, v, x)]
                                  @twice-y |
                                    apply(swap(u, v), apply(swap(u, v), y)) = y
                                    [using specialize swapIsAnInvolution(u, v, y)]
                                  @x-through-y |
                                    apply(swap(u, v), apply(swap(u, v), y)) = x
                                    [by rewrite images-equal twice-x]
                                  // y = swap(swap(y)) = x
                                  @twice-y-flipped |
                                    y = apply(swap(u, v), apply(swap(u, v), y))
                                    [by symmetry twice-y]
                                  @y-equals-x |
                                    y = x
                                    [using chain twice-y-flipped x-through-y]
                                  @conclusion-equal |
                                    x = y
                                    [by symmetry y-equals-x]
                                }
                              @conclusion-images |
                                apply(swap(u, v), x) = apply(swap(u, v), y) -> x = y
                                [by implies_intro given-images]
                            }
                          @conclusion-y |
                            member(y, a) -> apply(swap(u, v), x) = apply(swap(u, v), y) -> x = y
                            [by implies_intro given-y]
                        }
                      @conclusion-x |
                        member(x, a) -> member(y, a) -> apply(swap(u, v), x) = apply(swap(u, v), y) -> x = y
                        [by implies_intro given-x]
                    }
                  @discharge-y |
                    forall y: Element; member(x, a) -> member(y, a) -> apply(swap(u, v), x) = apply(swap(u, v), y) -> x = y
                    [by forall_intro inner]
                }
              @conclusion-injective |
                forall x: Element; forall y: Element;
                  member(x, a) -> member(y, a) -> apply(swap(u, v), x) = apply(swap(u, v), y) -> x = y
                [by forall_intro pointwise]
            }
          @discharge-a |
            forall a: Set; injectiveOn(swap(u, v), a)
            [by forall_intro generalize-a]
        }
      @discharge-v |
        forall v: Element; forall a: Set; injectiveOn(swap(u, v), a)
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall u: Element; forall v: Element; forall a: Set; injectiveOn(swap(u, v), a)
    [by forall_intro generalize-u]
qed

// SURJECTIVE onto the swapped image: for y in the target, `swap(u,v)` applied to
// `swap(u,v)(y)` IS y, so the preimage is that — no search, no choice, the involution
// hands it over.
theorem swapCoversItsImage: forall u: Element; forall v: Element; forall a: Set; forall b: Set;
  (forall y: Element; member(y, b) -> member(apply(swap(u, v), y), a)) ->
  surjectiveOnto(swap(u, v), a, b)
proof
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @generalize-a |
            fix a: Set {
              @generalize-b |
                fix b: Set {
                  @given-lands |
                    assume forall y: Element; member(y, b) -> member(apply(swap(u, v), y), a) {
                      @lands |
                        forall y: Element; member(y, b) -> member(apply(swap(u, v), y), a)
                        [by hypothesis given-lands]
                      @pointwise |
                        fix y: Element {
                          @given-y-in-b |
                            assume member(y, b) {
                              @y-in-b |
                                member(y, b)
                                [by hypothesis given-y-in-b]
                              @preimage-in-a |
                                member(apply(swap(u, v), y), a)
                                [using specialize lands(y) y-in-b]
                              @preimage-maps-back |
                                apply(swap(u, v), apply(swap(u, v), y)) = y
                                [using specialize swapIsAnInvolution(u, v, y)]
                              @witness |
                                member(apply(swap(u, v), y), a)
                                  and apply(swap(u, v), apply(swap(u, v), y)) = y
                                [by and_intro preimage-in-a preimage-maps-back]
                              @conclusion-y |
                                exists x: Element; member(x, a) and apply(swap(u, v), x) = y
                                [by exists_intro(apply(swap(u, v), y)) witness]
                            }
                          @conclusion-implication |
                            member(y, b) -> exists x: Element; member(x, a) and apply(swap(u, v), x) = y
                            [by implies_intro given-y-in-b]
                        }
                      @conclusion-surjective |
                        forall y: Element; member(y, b) -> exists x: Element; member(x, a) and apply(swap(u, v), x) = y
                        [by forall_intro pointwise]
                    }
                  @conclusion-implication |
                    (forall y: Element; member(y, b) -> member(apply(swap(u, v), y), a)) ->
                      surjectiveOnto(swap(u, v), a, b)
                    [by implies_intro given-lands]
                }
              @discharge-b |
                forall b: Set;
                  (forall y: Element; member(y, b) -> member(apply(swap(u, v), y), a)) ->
                  surjectiveOnto(swap(u, v), a, b)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a: Set; forall b: Set;
              (forall y: Element; member(y, b) -> member(apply(swap(u, v), y), a)) ->
              surjectiveOnto(swap(u, v), a, b)
            [by forall_intro generalize-a]
        }
      @discharge-v |
        forall v: Element; forall a: Set; forall b: Set;
          (forall y: Element; member(y, b) -> member(apply(swap(u, v), y), a)) ->
          surjectiveOnto(swap(u, v), a, b)
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall u: Element; forall v: Element; forall a: Set; forall b: Set;
      (forall y: Element; member(y, b) -> member(apply(swap(u, v), y), a)) ->
      surjectiveOnto(swap(u, v), a, b)
    [by forall_intro generalize-u]
qed

// -- segment STRUCTURE (what the counting induction peels) -------------------

// A swap of two members of `a` keeps `a` inside itself: x is u (goes to v, a member), or
// v (goes to u, a member), or neither (stays put).
theorem swapMapsInto: forall u: Element; forall v: Element; forall a: Set;
  member(u, a) -> member(v, a) -> mapsInto(swap(u, v), a, a)
proof
  @generalize-u |
    fix u: Element {
      @generalize-v |
        fix v: Element {
          @generalize-a |
            fix a: Set {
              @given-u |
                assume member(u, a) {
                  @given-v |
                    assume member(v, a) {
                      @u-in-a |
                        member(u, a)
                        [by hypothesis given-u]
                      @v-in-a |
                        member(v, a)
                        [by hypothesis given-v]
                      @pointwise |
                        fix x: Element {
                          @given-x |
                            assume member(x, a) {
                              @x-in-a |
                                member(x, a)
                                [by hypothesis given-x]
                              @x-is-u-or-v-or-neither |
                                x = u or x = v or (x != u and x != v)
                                [using tautology]
                              @conclusion-image-in-a |
                                member(apply(swap(u, v), x), a)
                                case x-is-u-or-v-or-neither {
                                  @when-first |
                                    assume x = u {
                                      @x-is-u |
                                        x = u
                                        [by hypothesis when-first]
                                      @u-goes-to-v |
                                        apply(swap(u, v), u) = v
                                        [using specialize swapAtFirst(u, v)]
                                      @x-goes-to-v |
                                        apply(swap(u, v), x) = v
                                        [by rewrite x-is-u u-goes-to-v]
                                      @conclusion-first |
                                        member(apply(swap(u, v), x), a)
                                        [by rewrite x-goes-to-v v-in-a]
                                    }
                                  @when-second |
                                    assume x = v {
                                      @x-is-v |
                                        x = v
                                        [by hypothesis when-second]
                                      @v-goes-to-u |
                                        apply(swap(u, v), v) = u
                                        [using specialize swapAtSecond(u, v)]
                                      @x-goes-to-u |
                                        apply(swap(u, v), x) = u
                                        [by rewrite x-is-v v-goes-to-u]
                                      @conclusion-second |
                                        member(apply(swap(u, v), x), a)
                                        [by rewrite x-goes-to-u u-in-a]
                                    }
                                  @when-neither |
                                    assume x != u and x != v {
                                      @x-is-neither |
                                        x != u and x != v
                                        [by hypothesis when-neither]
                                      @x-is-not-u |
                                        x != u
                                        [by and_elim_left x-is-neither]
                                      @x-is-not-v |
                                        x != v
                                        [by and_elim_right x-is-neither]
                                      @x-stays-put |
                                        apply(swap(u, v), x) = x
                                        [using specialize swapElsewhere(u, v, x) x-is-not-u x-is-not-v]
                                      @conclusion-neither |
                                        member(apply(swap(u, v), x), a)
                                        [by rewrite x-stays-put x-in-a]
                                    }
                                }
                            }
                          @conclusion-implication |
                            member(x, a) -> member(apply(swap(u, v), x), a)
                            [by implies_intro given-x]
                        }
                      @conclusion-into |
                        forall x: Element; member(x, a) -> member(apply(swap(u, v), x), a)
                        [by forall_intro pointwise]
                    }
                  @conclusion-v |
                    member(v, a) -> mapsInto(swap(u, v), a, a)
                    [by implies_intro given-v]
                }
              @conclusion-u |
                member(u, a) -> member(v, a) -> mapsInto(swap(u, v), a, a)
                [by implies_intro given-u]
            }
          @discharge-a |
            forall a: Set; member(u, a) -> member(v, a) -> mapsInto(swap(u, v), a, a)
            [by forall_intro generalize-a]
        }
      @discharge-v |
        forall v: Element; forall a: Set; member(u, a) -> member(v, a) -> mapsInto(swap(u, v), a, a)
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall u: Element; forall v: Element; forall a: Set;
      member(u, a) -> member(v, a) -> mapsInto(swap(u, v), a, a)
    [by forall_intro generalize-u]
qed

// SEGMENT DECOMPOSITION: a member of segment(succ n) is either a member of segment(n) or
// the top element numeral(n). This is what lets the induction PEEL the top off.
theorem segmentSuccSplits: forall n: Nat; forall x: Element;
  member(x, segment(succ(n))) -> (member(x, segment(n)) or x = numeral(n))
proof
  @generalize-n |
    fix n: Nat {
      @generalize-x |
        fix x: Element {
          @given-member |
            assume member(x, segment(succ(n))) {
              @is-member |
                member(x, segment(succ(n)))
                [by hypothesis given-member]
              @unfold |
                member(x, segment(succ(n))) iff (exists k: Nat; less_than(k, succ(n)) and x = numeral(k))
                [using specialize segmentMember(succ(n), x)]
              @the-witness |
                exists k: Nat; less_than(k, succ(n)) and x = numeral(k)
                [using tautology unfold is-member]
              @with-witness |
                unpack k: Nat from the-witness {
                  @facts |
                    less_than(k, succ(n)) and x = numeral(k)
                    [by hypothesis with-witness]
                  @k-below-succ |
                    less_than(k, succ(n))
                    [by and_elim_left facts]
                  @x-is-numeral-k |
                    x = numeral(k)
                    [by and_elim_right facts]
                  @split |
                    less_than(k, n) or k = n
                    [using specialize lessThanSuccSplit(k, n) k-below-succ]
                  @conclusion-split |
                    member(x, segment(n)) or x = numeral(n)
                    case split {
                      @when-below |
                        assume less_than(k, n) {
                          @k-below-n |
                            less_than(k, n)
                            [by hypothesis when-below]
                          @numeral-is-in |
                            member(numeral(k), segment(n)) iff less_than(k, n)
                            [using specialize numeralInSegment(n, k)]
                          @in-segment |
                            member(numeral(k), segment(n))
                            [using tautology numeral-is-in k-below-n]
                          @x-in-segment |
                            member(x, segment(n))
                            [by rewrite x-is-numeral-k in-segment]
                          @conclusion-below |
                            member(x, segment(n)) or x = numeral(n)
                            [by or_intro_left x-in-segment]
                        }
                      @when-equal |
                        assume k = n {
                          @k-is-n |
                            k = n
                            [by hypothesis when-equal]
                          @x-is-numeral-n |
                            x = numeral(n)
                            [by rewrite k-is-n x-is-numeral-k]
                          @conclusion-equal |
                            member(x, segment(n)) or x = numeral(n)
                            [by or_intro_right x-is-numeral-n]
                        }
                    }
                }
              @conclusion-unpacked |
                member(x, segment(n)) or x = numeral(n)
                [by exists_elim with-witness]
            }
          @conclusion-implication |
            member(x, segment(succ(n))) -> (member(x, segment(n)) or x = numeral(n))
            [by implies_intro given-member]
        }
      @discharge-x |
        forall x: Element; member(x, segment(succ(n))) -> (member(x, segment(n)) or x = numeral(n))
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall n: Nat; forall x: Element;
      member(x, segment(succ(n))) -> (member(x, segment(n)) or x = numeral(n))
    [by forall_intro generalize-n]
qed

// ...and the converse: segment(n) sits inside segment(succ n), and so does its top.
theorem segmentGrows: forall n: Nat; forall x: Element;
  member(x, segment(n)) -> member(x, segment(succ(n)))
proof
  @generalize-n |
    fix n: Nat {
      @generalize-x |
        fix x: Element {
          @given-member |
            assume member(x, segment(n)) {
              @is-member |
                member(x, segment(n))
                [by hypothesis given-member]
              @unfold-n |
                member(x, segment(n)) iff (exists k: Nat; less_than(k, n) and x = numeral(k))
                [using specialize segmentMember(n, x)]
              @the-witness |
                exists k: Nat; less_than(k, n) and x = numeral(k)
                [using tautology unfold-n is-member]
              @with-witness |
                unpack k: Nat from the-witness {
                  @facts |
                    less_than(k, n) and x = numeral(k)
                    [by hypothesis with-witness]
                  @k-below-n |
                    less_than(k, n)
                    [by and_elim_left facts]
                  @x-is-numeral-k |
                    x = numeral(k)
                    [by and_elim_right facts]
                  @k-below-succ |
                    less_than(k, succ(n))
                    [using specialize lessThanSuccRight(k, n) k-below-n]
                  @still-a-witness |
                    less_than(k, succ(n)) and x = numeral(k)
                    [by and_intro k-below-succ x-is-numeral-k]
                  @witness-exists |
                    exists j: Nat; less_than(j, succ(n)) and x = numeral(j)
                    [by exists_intro(k) still-a-witness]
                  @unfold-succ |
                    member(x, segment(succ(n))) iff (exists j: Nat; less_than(j, succ(n)) and x = numeral(j))
                    [using specialize segmentMember(succ(n), x)]
                  @conclusion-member |
                    member(x, segment(succ(n)))
                    [using tautology unfold-succ witness-exists]
                }
              @conclusion-unpacked |
                member(x, segment(succ(n)))
                [by exists_elim with-witness]
            }
          @conclusion-implication |
            member(x, segment(n)) -> member(x, segment(succ(n)))
            [by implies_intro given-member]
        }
      @discharge-x |
        forall x: Element; member(x, segment(n)) -> member(x, segment(succ(n)))
        [by forall_intro generalize-x]
    }
  @conclusion |
    forall n: Nat; forall x: Element; member(x, segment(n)) -> member(x, segment(succ(n)))
    [by forall_intro generalize-n]
qed

// the TOP element is in the bigger segment but not the smaller — what makes the peel a
// genuine split rather than a no-op.
theorem topIsInTheBiggerSegment: forall n: Nat; member(numeral(n), segment(succ(n)))
proof
  @generalize-n |
    fix n: Nat {
      @n-below-succ |
        less_than(n, succ(n))
        [using specialize lessThanSelf(n)]
      @characterization |
        member(numeral(n), segment(succ(n))) iff less_than(n, succ(n))
        [using specialize numeralInSegment(succ(n), n)]
      @conclusion-n |
        member(numeral(n), segment(succ(n)))
        [using tautology characterization n-below-succ]
    }
  @conclusion |
    forall n: Nat; member(numeral(n), segment(succ(n)))
    [by forall_intro generalize-n]
qed

theorem topIsNotInTheSmallerSegment: forall n: Nat; not member(numeral(n), segment(n))
proof
  @generalize-n |
    fix n: Nat {
      @not-below-self |
        not less_than(n, n)
        [using specialize lessThanIrreflexive(n)]
      @characterization |
        member(numeral(n), segment(n)) iff less_than(n, n)
        [using specialize numeralInSegment(n, n)]
      @conclusion-n |
        not member(numeral(n), segment(n))
        [using tautology characterization not-below-self]
    }
  @conclusion |
    forall n: Nat; not member(numeral(n), segment(n))
    [by forall_intro generalize-n]
qed

// -- restriction: peeling the top off a bijection ----------------------------

// THE RESTRICTION LEMMA. A bijection segment(succ m) -> segment(succ n) that sends the top
// to the top restricts to a bijection segment(m) -> segment(n).
//
// INTO is the delicate half: x in segment(m) goes somewhere in segment(succ n), and it
// cannot be the top — if it were, injectivity would force x = numeral(m), which is not in
// segment(m). So it lands in segment(n).
theorem restrictionMapsInto: forall f: Fn; forall m: Nat; forall n: Nat;
  mapsInto(f, segment(succ(m)), segment(succ(n))) ->
  injectiveOn(f, segment(succ(m))) ->
  apply(f, numeral(m)) = numeral(n) ->
  mapsInto(f, segment(m), segment(n))
proof
  @generalize-f |
    fix f: Fn {
      @generalize-m |
        fix m: Nat {
          @generalize-n |
            fix n: Nat {
              @given-into |
                assume mapsInto(f, segment(succ(m)), segment(succ(n))) {
                  @given-injective |
                    assume injectiveOn(f, segment(succ(m))) {
                      @given-top |
                        assume apply(f, numeral(m)) = numeral(n) {
                          @into |
                            forall x: Element; member(x, segment(succ(m))) -> member(apply(f, x), segment(succ(n)))
                            [by hypothesis given-into]
                          @injective |
                            forall x: Element; forall y: Element;
                              member(x, segment(succ(m))) -> member(y, segment(succ(m))) ->
                              apply(f, x) = apply(f, y) -> x = y
                            [by hypothesis given-injective]
                          @top-to-top |
                            apply(f, numeral(m)) = numeral(n)
                            [by hypothesis given-top]
                          @pointwise |
                            fix x: Element {
                              @given-x |
                                assume member(x, segment(m)) {
                                  @x-in-small |
                                    member(x, segment(m))
                                    [by hypothesis given-x]
                                  @x-in-big |
                                    member(x, segment(succ(m)))
                                    [using specialize segmentGrows(m, x) x-in-small]
                                  @image-in-big |
                                    member(apply(f, x), segment(succ(n)))
                                    [using specialize into(x) x-in-big]
                                  @image-splits |
                                    member(apply(f, x), segment(n)) or apply(f, x) = numeral(n)
                                    [using specialize segmentSuccSplits(n, apply(f, x)) image-in-big]
                                  @conclusion-x |
                                    member(apply(f, x), segment(n))
                                    case image-splits {
                                      @when-in-small |
                                        assume member(apply(f, x), segment(n)) {
                                          @conclusion-small |
                                            member(apply(f, x), segment(n))
                                            [by hypothesis when-in-small]
                                        }
                                      @when-at-top |
                                        assume apply(f, x) = numeral(n) {
                                          // x would have to BE the top, which is not in segment(m)
                                          @x-image-is-top |
                                            apply(f, x) = numeral(n)
                                            [by hypothesis when-at-top]
                                          @top-in-big |
                                            member(numeral(m), segment(succ(m)))
                                            [using specialize topIsInTheBiggerSegment(m)]
                                          @same-image |
                                            apply(f, x) = apply(f, numeral(m))
                                            [by rewrite top-to-top x-image-is-top]
                                          @x-is-top |
                                            x = numeral(m)
                                            [using specialize injective(x, numeral(m)) x-in-big top-in-big same-image]
                                          @top-not-in-small |
                                            not member(numeral(m), segment(m))
                                            [using specialize topIsNotInTheSmallerSegment(m)]
                                          @x-not-in-small |
                                            not member(x, segment(m))
                                            [by rewrite x-is-top top-not-in-small]
                                          @conclusion-absurd |
                                            member(apply(f, x), segment(n))
                                            [by absurd x-in-small x-not-in-small]
                                        }
                                    }
                                }
                              @conclusion-implication |
                                member(x, segment(m)) -> member(apply(f, x), segment(n))
                                [by implies_intro given-x]
                            }
                          @conclusion-into |
                            forall x: Element; member(x, segment(m)) -> member(apply(f, x), segment(n))
                            [by forall_intro pointwise]
                        }
                      @conclusion-top |
                        apply(f, numeral(m)) = numeral(n) -> mapsInto(f, segment(m), segment(n))
                        [by implies_intro given-top]
                    }
                  @conclusion-injective |
                    injectiveOn(f, segment(succ(m))) -> apply(f, numeral(m)) = numeral(n) -> mapsInto(f, segment(m), segment(n))
                    [by implies_intro given-injective]
                }
              @conclusion-into-hyp |
                mapsInto(f, segment(succ(m)), segment(succ(n))) -> injectiveOn(f, segment(succ(m))) -> apply(f, numeral(m)) = numeral(n) -> mapsInto(f, segment(m), segment(n))
                [by implies_intro given-into]
            }
          @discharge-n |
            forall n: Nat; mapsInto(f, segment(succ(m)), segment(succ(n))) -> injectiveOn(f, segment(succ(m))) -> apply(f, numeral(m)) = numeral(n) -> mapsInto(f, segment(m), segment(n))
            [by forall_intro generalize-n]
        }
      @discharge-m |
        forall m: Nat; forall n: Nat; mapsInto(f, segment(succ(m)), segment(succ(n))) -> injectiveOn(f, segment(succ(m))) -> apply(f, numeral(m)) = numeral(n) -> mapsInto(f, segment(m), segment(n))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall f: Fn; forall m: Nat; forall n: Nat;
      mapsInto(f, segment(succ(m)), segment(succ(n))) ->
      injectiveOn(f, segment(succ(m))) ->
      apply(f, numeral(m)) = numeral(n) ->
      mapsInto(f, segment(m), segment(n))
    [by forall_intro generalize-f]
qed

// INJECTIVE is nearly free: injectivity on a set restricts to any subset, and segment(m)
// sits inside segment(succ m).
theorem restrictionIsInjectiveOn: forall f: Fn; forall m: Nat;
  injectiveOn(f, segment(succ(m))) -> injectiveOn(f, segment(m))
proof
  @generalize-f |
    fix f: Fn {
      @generalize-m |
        fix m: Nat {
          @given-injective |
            assume injectiveOn(f, segment(succ(m))) {
              @injective |
                forall x: Element; forall y: Element;
                  member(x, segment(succ(m))) -> member(y, segment(succ(m))) ->
                  apply(f, x) = apply(f, y) -> x = y
                [by hypothesis given-injective]
              @pointwise |
                fix x: Element {
                  @inner |
                    fix y: Element {
                      @given-x |
                        assume member(x, segment(m)) {
                          @given-y |
                            assume member(y, segment(m)) {
                              @given-images |
                                assume apply(f, x) = apply(f, y) {
                                  @x-in-small |
                                    member(x, segment(m))
                                    [by hypothesis given-x]
                                  @y-in-small |
                                    member(y, segment(m))
                                    [by hypothesis given-y]
                                  @images-equal |
                                    apply(f, x) = apply(f, y)
                                    [by hypothesis given-images]
                                  @x-in-big |
                                    member(x, segment(succ(m)))
                                    [using specialize segmentGrows(m, x) x-in-small]
                                  @y-in-big |
                                    member(y, segment(succ(m)))
                                    [using specialize segmentGrows(m, y) y-in-small]
                                  @conclusion-equal |
                                    x = y
                                    [using specialize injective(x, y) x-in-big y-in-big images-equal]
                                }
                              @conclusion-images |
                                apply(f, x) = apply(f, y) -> x = y
                                [by implies_intro given-images]
                            }
                          @conclusion-y |
                            member(y, segment(m)) -> apply(f, x) = apply(f, y) -> x = y
                            [by implies_intro given-y]
                        }
                      @conclusion-x |
                        member(x, segment(m)) -> member(y, segment(m)) -> apply(f, x) = apply(f, y) -> x = y
                        [by implies_intro given-x]
                    }
                  @discharge-y |
                    forall y: Element; member(x, segment(m)) -> member(y, segment(m)) -> apply(f, x) = apply(f, y) -> x = y
                    [by forall_intro inner]
                }
              @conclusion-injective |
                forall x: Element; forall y: Element;
                  member(x, segment(m)) -> member(y, segment(m)) -> apply(f, x) = apply(f, y) -> x = y
                [by forall_intro pointwise]
            }
          @conclusion-restricts |
            injectiveOn(f, segment(succ(m))) -> injectiveOn(f, segment(m))
            [by implies_intro given-injective]
        }
      @discharge-m |
        forall m: Nat; injectiveOn(f, segment(succ(m))) -> injectiveOn(f, segment(m))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall f: Fn; forall m: Nat; injectiveOn(f, segment(succ(m))) -> injectiveOn(f, segment(m))
    [by forall_intro generalize-f]
qed

// SURJECTIVE runs the top-unreachable idea the other way: y in segment(n) has a preimage x
// in segment(succ m), and x cannot be the top — the top goes to numeral(n), which is not
// in segment(n) where y lives. So x is in segment(m).
theorem restrictionIsSurjectiveOnto: forall f: Fn; forall m: Nat; forall n: Nat;
  surjectiveOnto(f, segment(succ(m)), segment(succ(n))) ->
  apply(f, numeral(m)) = numeral(n) ->
  surjectiveOnto(f, segment(m), segment(n))
proof
  @generalize-f |
    fix f: Fn {
      @generalize-m |
        fix m: Nat {
          @generalize-n |
            fix n: Nat {
              @given-covers |
                assume surjectiveOnto(f, segment(succ(m)), segment(succ(n))) {
                  @given-top |
                    assume apply(f, numeral(m)) = numeral(n) {
                      @covers |
                        forall y: Element; member(y, segment(succ(n))) ->
                          exists x: Element; member(x, segment(succ(m))) and apply(f, x) = y
                        [by hypothesis given-covers]
                      @top-to-top |
                        apply(f, numeral(m)) = numeral(n)
                        [by hypothesis given-top]
                      @pointwise |
                        fix y: Element {
                          @given-y |
                            assume member(y, segment(n)) {
                              @y-in-small |
                                member(y, segment(n))
                                [by hypothesis given-y]
                              @y-in-big |
                                member(y, segment(succ(n)))
                                [using specialize segmentGrows(n, y) y-in-small]
                              @preimage-exists |
                                exists x: Element; member(x, segment(succ(m))) and apply(f, x) = y
                                [using specialize covers(y) y-in-big]
                              @with-preimage-x |
                                unpack x: Element from preimage-exists {
                                  @preimage-facts |
                                    member(x, segment(succ(m))) and apply(f, x) = y
                                    [by hypothesis with-preimage-x]
                                  @x-in-big |
                                    member(x, segment(succ(m)))
                                    [by and_elim_left preimage-facts]
                                  @x-maps-to-y |
                                    apply(f, x) = y
                                    [by and_elim_right preimage-facts]
                                  @x-splits |
                                    member(x, segment(m)) or x = numeral(m)
                                    [using specialize segmentSuccSplits(m, x) x-in-big]
                                  @conclusion-preimage-in-small |
                                    exists x2: Element; member(x2, segment(m)) and apply(f, x2) = y
                                    case x-splits {
                                      @when-in-small |
                                        assume member(x, segment(m)) {
                                          @x-in-small |
                                            member(x, segment(m))
                                            [by hypothesis when-in-small]
                                          @x-is-a-preimage-in-small |
                                            member(x, segment(m)) and apply(f, x) = y
                                            [by and_intro x-in-small x-maps-to-y]
                                          @conclusion-small |
                                            exists x2: Element; member(x2, segment(m)) and apply(f, x2) = y
                                            [by exists_intro(x) x-is-a-preimage-in-small]
                                        }
                                      @when-at-top |
                                        assume x = numeral(m) {
                                          // then y would be numeral(n), which is not in segment(n)
                                          @x-is-top |
                                            x = numeral(m)
                                            [by hypothesis when-at-top]
                                          @top-maps-to-y |
                                            apply(f, numeral(m)) = y
                                            [by rewrite x-is-top x-maps-to-y]
                                          @y-is-top |
                                            numeral(n) = y
                                            [by rewrite top-to-top top-maps-to-y]
                                          @top-in-small |
                                            member(numeral(n), segment(n))
                                            [by rewrite y-is-top y-in-small]
                                          @top-not-in-small |
                                            not member(numeral(n), segment(n))
                                            [using specialize topIsNotInTheSmallerSegment(n)]
                                          @conclusion-absurd |
                                            exists x2: Element; member(x2, segment(m)) and apply(f, x2) = y
                                            [by absurd top-in-small top-not-in-small]
                                        }
                                    }
                                }
                              @conclusion-y-has-a-preimage |
                                exists x2: Element; member(x2, segment(m)) and apply(f, x2) = y
                                [by exists_elim with-preimage-x]
                            }
                          @conclusion-implication |
                            member(y, segment(n)) -> exists x2: Element; member(x2, segment(m)) and apply(f, x2) = y
                            [by implies_intro given-y]
                        }
                      @conclusion-covers |
                        forall y: Element; member(y, segment(n)) ->
                          exists x2: Element; member(x2, segment(m)) and apply(f, x2) = y
                        [by forall_intro pointwise]
                    }
                  @conclusion-top |
                    apply(f, numeral(m)) = numeral(n) -> surjectiveOnto(f, segment(m), segment(n))
                    [by implies_intro given-top]
                }
              @conclusion-covers-hyp |
                surjectiveOnto(f, segment(succ(m)), segment(succ(n))) -> apply(f, numeral(m)) = numeral(n) -> surjectiveOnto(f, segment(m), segment(n))
                [by implies_intro given-covers]
            }
          @discharge-n |
            forall n: Nat; surjectiveOnto(f, segment(succ(m)), segment(succ(n))) -> apply(f, numeral(m)) = numeral(n) -> surjectiveOnto(f, segment(m), segment(n))
            [by forall_intro generalize-n]
        }
      @discharge-m |
        forall m: Nat; forall n: Nat; surjectiveOnto(f, segment(succ(m)), segment(succ(n))) -> apply(f, numeral(m)) = numeral(n) -> surjectiveOnto(f, segment(m), segment(n))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall f: Fn; forall m: Nat; forall n: Nat;
      surjectiveOnto(f, segment(succ(m)), segment(succ(n))) ->
      apply(f, numeral(m)) = numeral(n) ->
      surjectiveOnto(f, segment(m), segment(n))
    [by forall_intro generalize-f]
qed

// THE RESTRICTION LEMMA, assembled: the three halves together say the restriction of a
// top-preserving bijection is a bijection.
theorem restrictionBijects: forall f: Fn; forall m: Nat; forall n: Nat;
  bijectsOnto(f, segment(succ(m)), segment(succ(n))) ->
  apply(f, numeral(m)) = numeral(n) ->
  bijectsOnto(f, segment(m), segment(n))
proof
  @generalize-f |
    fix f: Fn {
      @generalize-m |
        fix m: Nat {
          @generalize-n |
            fix n: Nat {
              @given-bijection |
                assume bijectsOnto(f, segment(succ(m)), segment(succ(n))) {
                  @given-top |
                    assume apply(f, numeral(m)) = numeral(n) {
                      @bijection-facts |
                        mapsInto(f, segment(succ(m)), segment(succ(n))) and injectiveOn(f, segment(succ(m))) and surjectiveOnto(f, segment(succ(m)), segment(succ(n)))
                        [by hypothesis given-bijection]
                      @top-to-top |
                        apply(f, numeral(m)) = numeral(n)
                        [by hypothesis given-top]
                      @into-and-injective |
                        mapsInto(f, segment(succ(m)), segment(succ(n))) and injectiveOn(f, segment(succ(m)))
                        [by and_elim_left bijection-facts]
                      @into |
                        mapsInto(f, segment(succ(m)), segment(succ(n)))
                        [by and_elim_left into-and-injective]
                      @injective |
                        injectiveOn(f, segment(succ(m)))
                        [by and_elim_right into-and-injective]
                      @covers |
                        surjectiveOnto(f, segment(succ(m)), segment(succ(n)))
                        [by and_elim_right bijection-facts]
                      @restriction-maps-into |
                        mapsInto(f, segment(m), segment(n))
                        [using specialize restrictionMapsInto(f, m, n) into injective top-to-top]
                      @restriction-is-injective |
                        injectiveOn(f, segment(m))
                        [using specialize restrictionIsInjectiveOn(f, m) injective]
                      @restriction-covers |
                        surjectiveOnto(f, segment(m), segment(n))
                        [using specialize restrictionIsSurjectiveOnto(f, m, n) covers top-to-top]
                      @restriction-into-and-injective |
                        mapsInto(f, segment(m), segment(n)) and injectiveOn(f, segment(m))
                        [by and_intro restriction-maps-into restriction-is-injective]
                      @conclusion-bijects |
                        bijectsOnto(f, segment(m), segment(n))
                        [by and_intro restriction-into-and-injective restriction-covers]
                    }
                  @conclusion-top |
                    apply(f, numeral(m)) = numeral(n) -> bijectsOnto(f, segment(m), segment(n))
                    [by implies_intro given-top]
                }
              @conclusion-bijection-hyp |
                bijectsOnto(f, segment(succ(m)), segment(succ(n))) -> apply(f, numeral(m)) = numeral(n) -> bijectsOnto(f, segment(m), segment(n))
                [by implies_intro given-bijection]
            }
          @discharge-n |
            forall n: Nat; bijectsOnto(f, segment(succ(m)), segment(succ(n))) -> apply(f, numeral(m)) = numeral(n) -> bijectsOnto(f, segment(m), segment(n))
            [by forall_intro generalize-n]
        }
      @discharge-m |
        forall m: Nat; forall n: Nat; bijectsOnto(f, segment(succ(m)), segment(succ(n))) -> apply(f, numeral(m)) = numeral(n) -> bijectsOnto(f, segment(m), segment(n))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall f: Fn; forall m: Nat; forall n: Nat;
      bijectsOnto(f, segment(succ(m)), segment(succ(n))) ->
      apply(f, numeral(m)) = numeral(n) ->
      bijectsOnto(f, segment(m), segment(n))
    [by forall_intro generalize-f]
qed

// SIZE IS UNIQUE: equinumerous segments have the same length. Induction on m, with n
// universally quantified INSIDE the induction predicate so the step can pick n's
// predecessor. Base: segment(ZERO) is empty, so it bijects onto nothing but segment(ZERO).
// Step: a bijection segment(succ k) -> segment(succ j), composed with the swap that moves
// wherever the top landed onto numeral(j), sends top to top — so it restricts to a
// bijection segment(k) -> segment(j), and the inductive hypothesis gives k = j.
theorem segmentSizeIsUnique: forall m: Nat; forall n: Nat;
  equinumerous(segment(m), segment(n)) -> m = n
proof
  // base case: nothing in segment(ZERO) can cover a member of a nonempty segment(n)
  @base-case-proof |
    fix n: Nat {
      @given-equinumerous-with-zero |
        assume equinumerous(segment(ZERO), segment(n)) {
          @the-bijection-exists |
            exists f: Fn; bijectsOnto(f, segment(ZERO), segment(n))
            [by hypothesis given-equinumerous-with-zero]
          @n-is-zero-or-a-successor |
            n = ZERO or (exists j: Nat; n = succ(j))
            [using specialize zeroOrSucc(n)]
          @conclusion-zero-is-n |
            ZERO = n
            case n-is-zero-or-a-successor {
              @when-zero |
                assume n = ZERO {
                  @n-is-zero |
                    n = ZERO
                    [by hypothesis when-zero]
                  @conclusion-flipped |
                    ZERO = n
                    [by symmetry n-is-zero]
                }
              @when-successor |
                assume exists j: Nat; n = succ(j) {
                  @successor-exists |
                    exists j: Nat; n = succ(j)
                    [by hypothesis when-successor]
                  @with-predecessor-j |
                    unpack j: Nat from successor-exists {
                      @n-is-succ-j |
                        n = succ(j)
                        [by hypothesis with-predecessor-j]
                      @top-in-segment-succ-j |
                        member(numeral(j), segment(succ(j)))
                        [using specialize topIsInTheBiggerSegment(j)]
                      @top-in-segment-n |
                        member(numeral(j), segment(n))
                        [by rewrite n-is-succ-j top-in-segment-succ-j]
                      @with-bijection-g |
                        unpack g: Fn from the-bijection-exists {
                          @bijection-facts |
                            mapsInto(g, segment(ZERO), segment(n)) and injectiveOn(g, segment(ZERO)) and surjectiveOnto(g, segment(ZERO), segment(n))
                            [by hypothesis with-bijection-g]
                          @covers |
                            surjectiveOnto(g, segment(ZERO), segment(n))
                            [by and_elim_right bijection-facts]
                          @preimage-exists |
                            exists x: Element; member(x, segment(ZERO)) and apply(g, x) = numeral(j)
                            [using specialize covers(numeral(j)) top-in-segment-n]
                          @with-preimage-x |
                            unpack x: Element from preimage-exists {
                              @preimage-facts |
                                member(x, segment(ZERO)) and apply(g, x) = numeral(j)
                                [by hypothesis with-preimage-x]
                              @x-in-segment-zero |
                                member(x, segment(ZERO))
                                [by and_elim_left preimage-facts]
                              @segment-zero-is-empty |
                                segment(ZERO) = emptyset
                                [by cite segmentZeroIsEmpty]
                              @x-in-emptyset |
                                member(x, emptyset)
                                [by rewrite segment-zero-is-empty x-in-segment-zero]
                              @nothing-in-emptyset |
                                not member(x, emptyset)
                                [using specialize emptysetMember(x)]
                              @conclusion-absurd |
                                ZERO = n
                                [by absurd x-in-emptyset nothing-in-emptyset]
                            }
                          @conclusion-no-preimage |
                            ZERO = n
                            [by exists_elim with-preimage-x]
                        }
                      @conclusion-no-bijection |
                        ZERO = n
                        [by exists_elim with-bijection-g]
                    }
                  @conclusion-no-predecessor |
                    ZERO = n
                    [by exists_elim with-predecessor-j]
                }
            }
        }
      @conclusion-base-implication |
        equinumerous(segment(ZERO), segment(n)) -> ZERO = n
        [by implies_intro given-equinumerous-with-zero]
    }
  @base-case |
    forall n: Nat; equinumerous(segment(ZERO), segment(n)) -> ZERO = n
    [by forall_intro base-case-proof]

  // inductive step: straighten the bijection with a swap, restrict, apply the hypothesis
  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume forall n: Nat; equinumerous(segment(k), segment(n)) -> k = n {
          @inductive-hypothesis |
            forall n: Nat; equinumerous(segment(k), segment(n)) -> k = n
            [by hypothesis given-inductive-hypothesis]
          @generalize-n |
            fix n: Nat {
              @given-equinumerous |
                assume equinumerous(segment(succ(k)), segment(n)) {
                  @the-bijection-exists |
                    exists f: Fn; bijectsOnto(f, segment(succ(k)), segment(n))
                    [by hypothesis given-equinumerous]
                  @n-is-zero-or-a-successor |
                    n = ZERO or (exists j: Nat; n = succ(j))
                    [using specialize zeroOrSucc(n)]
                  @top-in-segment-succ-k |
                    member(numeral(k), segment(succ(k)))
                    [using specialize topIsInTheBiggerSegment(k)]
                  @conclusion-succ-k-is-n |
                    succ(k) = n
                    case n-is-zero-or-a-successor {
                      @when-zero |
                        assume n = ZERO {
                          // the top of segment(succ k) would have to land in the empty segment
                          @n-is-zero |
                            n = ZERO
                            [by hypothesis when-zero]
                          @with-bijection-g |
                            unpack g: Fn from the-bijection-exists {
                              @bijection-facts |
                                mapsInto(g, segment(succ(k)), segment(n)) and injectiveOn(g, segment(succ(k))) and surjectiveOnto(g, segment(succ(k)), segment(n))
                                [by hypothesis with-bijection-g]
                              @into-and-injective |
                                mapsInto(g, segment(succ(k)), segment(n)) and injectiveOn(g, segment(succ(k)))
                                [by and_elim_left bijection-facts]
                              @into |
                                mapsInto(g, segment(succ(k)), segment(n))
                                [by and_elim_left into-and-injective]
                              @top-lands-in-segment-n |
                                member(apply(g, numeral(k)), segment(n))
                                [using specialize into(numeral(k)) top-in-segment-succ-k]
                              @top-lands-in-segment-zero |
                                member(apply(g, numeral(k)), segment(ZERO))
                                [by rewrite n-is-zero top-lands-in-segment-n]
                              @segment-zero-is-empty |
                                segment(ZERO) = emptyset
                                [by cite segmentZeroIsEmpty]
                              @top-lands-in-emptyset |
                                member(apply(g, numeral(k)), emptyset)
                                [by rewrite segment-zero-is-empty top-lands-in-segment-zero]
                              @nothing-in-emptyset |
                                not member(apply(g, numeral(k)), emptyset)
                                [using specialize emptysetMember(apply(g, numeral(k)))]
                              @conclusion-absurd |
                                succ(k) = n
                                [by absurd top-lands-in-emptyset nothing-in-emptyset]
                            }
                          @conclusion-no-bijection-onto-empty |
                            succ(k) = n
                            [by exists_elim with-bijection-g]
                        }
                      @when-successor |
                        assume exists j: Nat; n = succ(j) {
                          @successor-exists |
                            exists j: Nat; n = succ(j)
                            [by hypothesis when-successor]
                          @with-predecessor-j |
                            unpack j: Nat from successor-exists {
                              @n-is-succ-j |
                                n = succ(j)
                                [by hypothesis with-predecessor-j]
                              @with-bijection-g |
                                unpack g: Fn from the-bijection-exists {
                                  @bijection-facts-in-n |
                                    mapsInto(g, segment(succ(k)), segment(n)) and injectiveOn(g, segment(succ(k))) and surjectiveOnto(g, segment(succ(k)), segment(n))
                                    [by hypothesis with-bijection-g]
                                  @bijection-facts |
                                    mapsInto(g, segment(succ(k)), segment(succ(j))) and injectiveOn(g, segment(succ(k))) and surjectiveOnto(g, segment(succ(k)), segment(succ(j)))
                                    [by rewrite n-is-succ-j bijection-facts-in-n]
                                  @into-and-injective |
                                    mapsInto(g, segment(succ(k)), segment(succ(j))) and injectiveOn(g, segment(succ(k)))
                                    [by and_elim_left bijection-facts]
                                  @into |
                                    mapsInto(g, segment(succ(k)), segment(succ(j)))
                                    [by and_elim_left into-and-injective]
                                  @injective |
                                    injectiveOn(g, segment(succ(k)))
                                    [by and_elim_right into-and-injective]
                                  @covers |
                                    surjectiveOnto(g, segment(succ(k)), segment(succ(j)))
                                    [by and_elim_right bijection-facts]

                                  // where the top lands, and the swap that moves it onto numeral(j)
                                  @top-lands-in-segment-succ-j |
                                    member(apply(g, numeral(k)), segment(succ(j)))
                                    [using specialize into(numeral(k)) top-in-segment-succ-k]
                                  @top-in-segment-succ-j |
                                    member(numeral(j), segment(succ(j)))
                                    [using specialize topIsInTheBiggerSegment(j)]
                                  @swap-maps-into |
                                    mapsInto(swap(apply(g, numeral(k)), numeral(j)), segment(succ(j)), segment(succ(j)))
                                    [using specialize swapMapsInto(apply(g, numeral(k)), numeral(j), segment(succ(j))) top-lands-in-segment-succ-j top-in-segment-succ-j]
                                  @swap-is-injective |
                                    injectiveOn(swap(apply(g, numeral(k)), numeral(j)), segment(succ(j)))
                                    [using specialize swapIsInjectiveOn(apply(g, numeral(k)), numeral(j), segment(succ(j)))]
                                  @swap-covers |
                                    surjectiveOnto(swap(apply(g, numeral(k)), numeral(j)), segment(succ(j)), segment(succ(j)))
                                    [using specialize swapCoversItsImage(apply(g, numeral(k)), numeral(j), segment(succ(j)), segment(succ(j))) swap-maps-into]

                                  // the composite is a bijection that sends top to top
                                  @composite-maps-into |
                                    mapsInto(compose(swap(apply(g, numeral(k)), numeral(j)), g), segment(succ(k)), segment(succ(j)))
                                    [using specialize composeMapsInto(g, swap(apply(g, numeral(k)), numeral(j)), segment(succ(k)), segment(succ(j)), segment(succ(j))) into swap-maps-into]
                                  @composite-is-injective |
                                    injectiveOn(compose(swap(apply(g, numeral(k)), numeral(j)), g), segment(succ(k)))
                                    [using specialize composeIsInjectiveOn(g, swap(apply(g, numeral(k)), numeral(j)), segment(succ(k)), segment(succ(j))) into injective swap-is-injective]
                                  @composite-covers |
                                    surjectiveOnto(compose(swap(apply(g, numeral(k)), numeral(j)), g), segment(succ(k)), segment(succ(j)))
                                    [using specialize composeIsSurjectiveOnto(g, swap(apply(g, numeral(k)), numeral(j)), segment(succ(k)), segment(succ(j)), segment(succ(j))) covers swap-covers]
                                  @composite-into-and-injective |
                                    mapsInto(compose(swap(apply(g, numeral(k)), numeral(j)), g), segment(succ(k)), segment(succ(j))) and injectiveOn(compose(swap(apply(g, numeral(k)), numeral(j)), g), segment(succ(k)))
                                    [by and_intro composite-maps-into composite-is-injective]
                                  @composite-bijects |
                                    bijectsOnto(compose(swap(apply(g, numeral(k)), numeral(j)), g), segment(succ(k)), segment(succ(j)))
                                    [by and_intro composite-into-and-injective composite-covers]
                                  @composite-at-top |
                                    apply(compose(swap(apply(g, numeral(k)), numeral(j)), g), numeral(k)) = apply(swap(apply(g, numeral(k)), numeral(j)), apply(g, numeral(k)))
                                    [using specialize composeApply(swap(apply(g, numeral(k)), numeral(j)), g, numeral(k))]
                                  @swap-moves-the-image-to-top |
                                    apply(swap(apply(g, numeral(k)), numeral(j)), apply(g, numeral(k))) = numeral(j)
                                    [using specialize swapAtFirst(apply(g, numeral(k)), numeral(j))]
                                  @composite-sends-top-to-top |
                                    apply(compose(swap(apply(g, numeral(k)), numeral(j)), g), numeral(k)) = numeral(j)
                                    [by rewrite swap-moves-the-image-to-top composite-at-top]

                                  // restrict, and the inductive hypothesis finishes
                                  @restriction-bijects |
                                    bijectsOnto(compose(swap(apply(g, numeral(k)), numeral(j)), g), segment(k), segment(j))
                                    [using specialize restrictionBijects(compose(swap(apply(g, numeral(k)), numeral(j)), g), k, j) composite-bijects composite-sends-top-to-top]
                                  @segments-k-and-j-are-equinumerous |
                                    equinumerous(segment(k), segment(j))
                                    [by exists_intro(compose(swap(apply(g, numeral(k)), numeral(j)), g)) restriction-bijects]
                                  @k-is-j |
                                    k = j
                                    [using specialize inductive-hypothesis(j) segments-k-and-j-are-equinumerous]
                                  @n-is-succ-k |
                                    n = succ(k)
                                    [by rewrite k-is-j n-is-succ-j]
                                  @conclusion-flipped |
                                    succ(k) = n
                                    [by symmetry n-is-succ-k]
                                }
                              @conclusion-via-bijection |
                                succ(k) = n
                                [by exists_elim with-bijection-g]
                            }
                          @conclusion-via-predecessor |
                            succ(k) = n
                            [by exists_elim with-predecessor-j]
                        }
                    }
                }
              @conclusion-step-implication |
                equinumerous(segment(succ(k)), segment(n)) -> succ(k) = n
                [by implies_intro given-equinumerous]
            }
          @discharge-n |
            forall n: Nat; equinumerous(segment(succ(k)), segment(n)) -> succ(k) = n
            [by forall_intro generalize-n]
        }
      @induction-step-at-k |
        (forall n: Nat; equinumerous(segment(k), segment(n)) -> k = n) -> (forall n: Nat; equinumerous(segment(succ(k)), segment(n)) -> succ(k) = n)
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; (forall n: Nat; equinumerous(segment(k), segment(n)) -> k = n) -> (forall n: Nat; equinumerous(segment(succ(k)), segment(n)) -> succ(k) = n)
    [by forall_intro induction-step]
  @conclusion |
    forall m: Nat; forall n: Nat; equinumerous(segment(m), segment(n)) -> m = n
    [using instantiation induction((fun k: Nat => forall n: Nat; equinumerous(segment(k), segment(n)) -> k = n)) base-case induction-step-for-all-k]
qed

// -- inverting a bijection between sets ----------------------------------------
//
// A bijection a -> b has an inverse b -> a. Nothing here needs choice: the inverse is
// pinned POINTWISE by the spec below — on b, the unique preimage (unique by injectivity,
// present by surjectivity); off b, the identity, which is what makes the spec total on
// the whole Element sort — and `functionFromGraph` realizes a proven total-and-unique
// spec as an Fn.
define inverseSpec(f, a, b, y, x) =
  (member(y, b) and member(x, a) and apply(f, x) = y) or ((not member(y, b)) and x = y)

// The spec is TOTAL and SINGLE-VALUED: every y has exactly one x meeting it.
theorem inverseSpecIsTotalAndSingleValued: forall f: Fn; forall a: Set; forall b: Set;
  bijectsOnto(f, a, b) ->
  forall y: Element; exists x: Element;
  inverseSpec(f, a, b, y, x) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x = x2)
proof
  @generalize-f |
    fix f: Fn {
      @generalize-a |
        fix a: Set {
          @generalize-b |
            fix b: Set {
              @given-bijection |
                assume bijectsOnto(f, a, b) {
                  @bijection-facts |
                    mapsInto(f, a, b) and injectiveOn(f, a) and surjectiveOnto(f, a, b)
                    [by hypothesis given-bijection]
                  @into-and-injective |
                    mapsInto(f, a, b) and injectiveOn(f, a)
                    [by and_elim_left bijection-facts]
                  @injective |
                    injectiveOn(f, a)
                    [by and_elim_right into-and-injective]
                  @covers |
                    surjectiveOnto(f, a, b)
                    [by and_elim_right bijection-facts]
                  @pointwise |
                    fix y: Element {
                      @y-in-b-or-not |
                        member(y, b) or (not member(y, b))
                        [using tautology]
                      @conclusion-unique-witness |
                        exists x: Element; inverseSpec(f, a, b, y, x) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x = x2)
                        case y-in-b-or-not {
                          @when-in-b |
                            assume member(y, b) {
                              // the witness is y's preimage, unique by injectivity
                              @y-in-b |
                                member(y, b)
                                [by hypothesis when-in-b]
                              @preimage-exists |
                                exists x: Element; member(x, a) and apply(f, x) = y
                                [using specialize covers(y) y-in-b]
                              @with-preimage-x |
                                unpack x: Element from preimage-exists {
                                  @preimage-facts |
                                    member(x, a) and apply(f, x) = y
                                    [by hypothesis with-preimage-x]
                                  @x-in-a |
                                    member(x, a)
                                    [by and_elim_left preimage-facts]
                                  @x-maps-to-y |
                                    apply(f, x) = y
                                    [by and_elim_right preimage-facts]
                                  @x-meets-the-spec |
                                    inverseSpec(f, a, b, y, x)
                                    [using tautology y-in-b x-in-a x-maps-to-y]
                                  @generalize-candidate |
                                    fix x2: Element {
                                      @given-candidate-meets-spec |
                                        assume inverseSpec(f, a, b, y, x2) {
                                          @candidate-meets-spec |
                                            inverseSpec(f, a, b, y, x2)
                                            [by hypothesis given-candidate-meets-spec]
                                          @candidate-in-a |
                                            member(x2, a)
                                            [using tautology candidate-meets-spec y-in-b]
                                          @candidate-maps-to-y |
                                            apply(f, x2) = y
                                            [using tautology candidate-meets-spec y-in-b]
                                          @same-image |
                                            apply(f, x) = apply(f, x2)
                                            [by rewrite candidate-maps-to-y x-maps-to-y]
                                          @conclusion-candidate-is-x |
                                            x = x2
                                            [using specialize injective(x, x2) x-in-a candidate-in-a same-image]
                                        }
                                      @conclusion-candidate-implication |
                                        inverseSpec(f, a, b, y, x2) -> x = x2
                                        [by implies_intro given-candidate-meets-spec]
                                    }
                                  @x-is-the-only-one |
                                    forall x2: Element; inverseSpec(f, a, b, y, x2) -> x = x2
                                    [by forall_intro generalize-candidate]
                                  @witness-clauses |
                                    inverseSpec(f, a, b, y, x) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x = x2)
                                    [by and_intro x-meets-the-spec x-is-the-only-one]
                                  @conclusion-preimage-is-the-witness |
                                    exists x3: Element; inverseSpec(f, a, b, y, x3) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x3 = x2)
                                    [by exists_intro(x) witness-clauses]
                                }
                              @conclusion-in-b |
                                exists x3: Element; inverseSpec(f, a, b, y, x3) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x3 = x2)
                                [by exists_elim with-preimage-x]
                            }
                          @when-not-in-b |
                            assume not member(y, b) {
                              // the witness is y itself
                              @y-not-in-b |
                                not member(y, b)
                                [by hypothesis when-not-in-b]
                              @y-is-y |
                                y = y
                                [by reflexivity]
                              @y-meets-the-spec |
                                inverseSpec(f, a, b, y, y)
                                [using tautology y-not-in-b y-is-y]
                              @generalize-candidate |
                                fix x2: Element {
                                  @given-candidate-meets-spec |
                                    assume inverseSpec(f, a, b, y, x2) {
                                      @candidate-meets-spec |
                                        inverseSpec(f, a, b, y, x2)
                                        [by hypothesis given-candidate-meets-spec]
                                      @candidate-is-y |
                                        x2 = y
                                        [using tautology candidate-meets-spec y-not-in-b]
                                      @conclusion-y-is-candidate |
                                        y = x2
                                        [by symmetry candidate-is-y]
                                    }
                                  @conclusion-candidate-implication |
                                    inverseSpec(f, a, b, y, x2) -> y = x2
                                    [by implies_intro given-candidate-meets-spec]
                                }
                              @y-is-the-only-one |
                                forall x2: Element; inverseSpec(f, a, b, y, x2) -> y = x2
                                [by forall_intro generalize-candidate]
                              @witness-clauses |
                                inverseSpec(f, a, b, y, y) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> y = x2)
                                [by and_intro y-meets-the-spec y-is-the-only-one]
                              @conclusion-not-in-b |
                                exists x3: Element; inverseSpec(f, a, b, y, x3) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x3 = x2)
                                [by exists_intro(y) witness-clauses]
                            }
                        }
                    }
                  @conclusion-total-and-single-valued |
                    forall y: Element; exists x: Element;
                      inverseSpec(f, a, b, y, x) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x = x2)
                    [by forall_intro pointwise]
                }
              @conclusion-bijection-implication |
                bijectsOnto(f, a, b) -> forall y: Element; exists x: Element; inverseSpec(f, a, b, y, x) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x = x2)
                [by implies_intro given-bijection]
            }
          @discharge-b |
            forall b: Set; bijectsOnto(f, a, b) -> forall y: Element; exists x: Element; inverseSpec(f, a, b, y, x) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x = x2)
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a: Set; forall b: Set; bijectsOnto(f, a, b) -> forall y: Element; exists x: Element; inverseSpec(f, a, b, y, x) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x = x2)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall f: Fn; forall a: Set; forall b: Set;
      bijectsOnto(f, a, b) ->
      forall y: Element; exists x: Element;
      inverseSpec(f, a, b, y, x) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x = x2)
    [by forall_intro generalize-f]
qed

// Any map realizing the spec bijects b onto a. Into and injective read straight off the
// spec's b-branch; surjective sends x in a to y = f(x), whose spec-value is x by
// injectivity of f.
theorem inverseSpecBijects: forall f: Fn; forall g: Fn; forall a: Set; forall b: Set;
  bijectsOnto(f, a, b) ->
  (forall y: Element; inverseSpec(f, a, b, y, apply(g, y))) ->
  bijectsOnto(g, b, a)
proof
  @generalize-f |
    fix f: Fn {
      @generalize-g |
        fix g: Fn {
          @generalize-a |
            fix a: Set {
              @generalize-b |
                fix b: Set {
                  @given-bijection |
                    assume bijectsOnto(f, a, b) {
                      @given-spec |
                        assume forall y: Element; inverseSpec(f, a, b, y, apply(g, y)) {
                          @bijection-facts |
                            mapsInto(f, a, b) and injectiveOn(f, a) and surjectiveOnto(f, a, b)
                            [by hypothesis given-bijection]
                          @into-and-injective |
                            mapsInto(f, a, b) and injectiveOn(f, a)
                            [by and_elim_left bijection-facts]
                          @into |
                            mapsInto(f, a, b)
                            [by and_elim_left into-and-injective]
                          @injective |
                            injectiveOn(f, a)
                            [by and_elim_right into-and-injective]
                          @spec |
                            forall y: Element; inverseSpec(f, a, b, y, apply(g, y))
                            [by hypothesis given-spec]

                          // INTO: on b the spec's first branch holds, and it says g(y) is in a
                          @pointwise-into |
                            fix y: Element {
                              @given-y-in-b |
                                assume member(y, b) {
                                  @y-in-b |
                                    member(y, b)
                                    [by hypothesis given-y-in-b]
                                  @spec-at-y |
                                    inverseSpec(f, a, b, y, apply(g, y))
                                    [using specialize spec(y)]
                                  @conclusion-image-in-a |
                                    member(apply(g, y), a)
                                    [using tautology spec-at-y y-in-b]
                                }
                              @conclusion-into-implication |
                                member(y, b) -> member(apply(g, y), a)
                                [by implies_intro given-y-in-b]
                            }
                          @g-maps-into |
                            mapsInto(g, b, a)
                            [by forall_intro pointwise-into]

                          // INJECTIVE: y = f(g(y)) = f(g(y2)) = y2
                          @pointwise-injective |
                            fix y: Element {
                              @inner |
                                fix y2: Element {
                                  @given-y |
                                    assume member(y, b) {
                                      @given-y2 |
                                        assume member(y2, b) {
                                          @given-images |
                                            assume apply(g, y) = apply(g, y2) {
                                              @y-in-b |
                                                member(y, b)
                                                [by hypothesis given-y]
                                              @y2-in-b |
                                                member(y2, b)
                                                [by hypothesis given-y2]
                                              @images-equal |
                                                apply(g, y) = apply(g, y2)
                                                [by hypothesis given-images]
                                              @spec-at-y |
                                                inverseSpec(f, a, b, y, apply(g, y))
                                                [using specialize spec(y)]
                                              @spec-at-y2 |
                                                inverseSpec(f, a, b, y2, apply(g, y2))
                                                [using specialize spec(y2)]
                                              @f-undoes-g-at-y |
                                                apply(f, apply(g, y)) = y
                                                [using tautology spec-at-y y-in-b]
                                              @f-undoes-g-at-y2 |
                                                apply(f, apply(g, y2)) = y2
                                                [using tautology spec-at-y2 y2-in-b]
                                              @f-of-shared-image-is-y2 |
                                                apply(f, apply(g, y)) = y2
                                                [by rewrite images-equal f-undoes-g-at-y2]
                                              @conclusion-equal |
                                                y = y2
                                                [by rewrite f-undoes-g-at-y f-of-shared-image-is-y2]
                                            }
                                          @conclusion-images |
                                            apply(g, y) = apply(g, y2) -> y = y2
                                            [by implies_intro given-images]
                                        }
                                      @conclusion-y2 |
                                        member(y2, b) -> apply(g, y) = apply(g, y2) -> y = y2
                                        [by implies_intro given-y2]
                                    }
                                  @conclusion-y |
                                    member(y, b) -> member(y2, b) -> apply(g, y) = apply(g, y2) -> y = y2
                                    [by implies_intro given-y]
                                }
                              @discharge-y2 |
                                forall y2: Element; member(y, b) -> member(y2, b) -> apply(g, y) = apply(g, y2) -> y = y2
                                [by forall_intro inner]
                            }
                          @g-is-injective |
                            injectiveOn(g, b)
                            [by forall_intro pointwise-injective]

                          // SURJECTIVE: x in a is g(f(x)), because f(g(f(x))) = f(x) and f is injective on a
                          @pointwise-covers |
                            fix x: Element {
                              @given-x-in-a |
                                assume member(x, a) {
                                  @x-in-a |
                                    member(x, a)
                                    [by hypothesis given-x-in-a]
                                  @image-in-b |
                                    member(apply(f, x), b)
                                    [using specialize into(x) x-in-a]
                                  @spec-at-image |
                                    inverseSpec(f, a, b, apply(f, x), apply(g, apply(f, x)))
                                    [using specialize spec(apply(f, x))]
                                  @g-of-image-in-a |
                                    member(apply(g, apply(f, x)), a)
                                    [using tautology spec-at-image image-in-b]
                                  @f-undoes-g-at-image |
                                    apply(f, apply(g, apply(f, x))) = apply(f, x)
                                    [using tautology spec-at-image image-in-b]
                                  @g-undoes-f-at-x |
                                    apply(g, apply(f, x)) = x
                                    [using specialize injective(apply(g, apply(f, x)), x) g-of-image-in-a x-in-a f-undoes-g-at-image]
                                  @image-is-a-preimage |
                                    member(apply(f, x), b) and apply(g, apply(f, x)) = x
                                    [by and_intro image-in-b g-undoes-f-at-x]
                                  @conclusion-x-is-covered |
                                    exists y: Element; member(y, b) and apply(g, y) = x
                                    [by exists_intro(apply(f, x)) image-is-a-preimage]
                                }
                              @conclusion-covers-implication |
                                member(x, a) -> exists y: Element; member(y, b) and apply(g, y) = x
                                [by implies_intro given-x-in-a]
                            }
                          @g-covers |
                            surjectiveOnto(g, b, a)
                            [by forall_intro pointwise-covers]

                          @g-into-and-injective |
                            mapsInto(g, b, a) and injectiveOn(g, b)
                            [by and_intro g-maps-into g-is-injective]
                          @conclusion-g-bijects |
                            bijectsOnto(g, b, a)
                            [by and_intro g-into-and-injective g-covers]
                        }
                      @conclusion-spec-implication |
                        (forall y: Element; inverseSpec(f, a, b, y, apply(g, y))) -> bijectsOnto(g, b, a)
                        [by implies_intro given-spec]
                    }
                  @conclusion-bijection-implication |
                    bijectsOnto(f, a, b) -> (forall y: Element; inverseSpec(f, a, b, y, apply(g, y))) -> bijectsOnto(g, b, a)
                    [by implies_intro given-bijection]
                }
              @discharge-b |
                forall b: Set; bijectsOnto(f, a, b) -> (forall y: Element; inverseSpec(f, a, b, y, apply(g, y))) -> bijectsOnto(g, b, a)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a: Set; forall b: Set; bijectsOnto(f, a, b) -> (forall y: Element; inverseSpec(f, a, b, y, apply(g, y))) -> bijectsOnto(g, b, a)
            [by forall_intro generalize-a]
        }
      @discharge-g |
        forall g: Fn; forall a: Set; forall b: Set; bijectsOnto(f, a, b) -> (forall y: Element; inverseSpec(f, a, b, y, apply(g, y))) -> bijectsOnto(g, b, a)
        [by forall_intro generalize-g]
    }
  @conclusion |
    forall f: Fn; forall g: Fn; forall a: Set; forall b: Set;
      bijectsOnto(f, a, b) ->
      (forall y: Element; inverseSpec(f, a, b, y, apply(g, y))) ->
      bijectsOnto(g, b, a)
    [by forall_intro generalize-f]
qed

// A bijection a -> b has an inverse bijection b -> a: realize the spec.
theorem bijectionInvertsOnSets: forall f: Fn; forall a: Set; forall b: Set;
  bijectsOnto(f, a, b) -> exists g: Fn; bijectsOnto(g, b, a)
proof
  @generalize-f |
    fix f: Fn {
      @generalize-a |
        fix a: Set {
          @generalize-b |
            fix b: Set {
              @given-bijection |
                assume bijectsOnto(f, a, b) {
                  @bijection |
                    bijectsOnto(f, a, b)
                    [by hypothesis given-bijection]
                  @spec-is-total-and-single-valued |
                    forall y: Element; exists x: Element;
                      inverseSpec(f, a, b, y, x) and (forall x2: Element; inverseSpec(f, a, b, y, x2) -> x = x2)
                    [using specialize inverseSpecIsTotalAndSingleValued(f, a, b) bijection]
                  @a-realization-exists |
                    exists g: Fn; forall y: Element; inverseSpec(f, a, b, y, apply(g, y))
                    [using instantiation functionFromGraph(fun y, x: Element => inverseSpec(f, a, b, y, x)) spec-is-total-and-single-valued]
                  @with-realization-g |
                    unpack g: Fn from a-realization-exists {
                      @g-realizes-the-spec |
                        forall y: Element; inverseSpec(f, a, b, y, apply(g, y))
                        [by hypothesis with-realization-g]
                      @g-bijects |
                        bijectsOnto(g, b, a)
                        [using specialize inverseSpecBijects(f, g, a, b) bijection g-realizes-the-spec]
                      @conclusion-g-is-an-inverse |
                        exists g2: Fn; bijectsOnto(g2, b, a)
                        [by exists_intro(g) g-bijects]
                    }
                  @conclusion-inverse-exists |
                    exists g2: Fn; bijectsOnto(g2, b, a)
                    [by exists_elim with-realization-g]
                }
              @conclusion-bijection-implication |
                bijectsOnto(f, a, b) -> exists g2: Fn; bijectsOnto(g2, b, a)
                [by implies_intro given-bijection]
            }
          @discharge-b |
            forall b: Set; bijectsOnto(f, a, b) -> exists g2: Fn; bijectsOnto(g2, b, a)
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a: Set; forall b: Set; bijectsOnto(f, a, b) -> exists g2: Fn; bijectsOnto(g2, b, a)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall f: Fn; forall a: Set; forall b: Set;
      bijectsOnto(f, a, b) -> exists g: Fn; bijectsOnto(g, b, a)
    [by forall_intro generalize-f]
qed

// SYMMETRY: equinumerosity runs both ways, because bijections invert.
theorem equinumerousSymmetric: forall a: Set; forall b: Set;
  equinumerous(a, b) -> equinumerous(b, a)
proof
  @generalize-a |
    fix a: Set {
      @generalize-b |
        fix b: Set {
          @given-equinumerous |
            assume equinumerous(a, b) {
              @the-bijection-exists |
                exists f: Fn; bijectsOnto(f, a, b)
                [by hypothesis given-equinumerous]
              @with-bijection-f |
                unpack f: Fn from the-bijection-exists {
                  @f-bijects |
                    bijectsOnto(f, a, b)
                    [by hypothesis with-bijection-f]
                  @conclusion-inverse-bijects-back |
                    exists g: Fn; bijectsOnto(g, b, a)
                    [using specialize bijectionInvertsOnSets(f, a, b) f-bijects]
                }
              @conclusion-symmetric |
                exists g: Fn; bijectsOnto(g, b, a)
                [by exists_elim with-bijection-f]
            }
          @conclusion-implication |
            equinumerous(a, b) -> equinumerous(b, a)
            [by implies_intro given-equinumerous]
        }
      @discharge-b |
        forall b: Set; equinumerous(a, b) -> equinumerous(b, a)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a: Set; forall b: Set; equinumerous(a, b) -> equinumerous(b, a)
    [by forall_intro generalize-a]
qed

// SIZE IS UNIQUE for ANY set: two sizes give segment(m) ~ a ~ segment(n), and equinumerous
// segments have the same length.
theorem hasSizeIsUnique: forall a: Set; forall m: Nat; forall n: Nat;
  hasSize(a, m) -> hasSize(a, n) -> m = n
proof
  @generalize-a |
    fix a: Set {
      @generalize-m |
        fix m: Nat {
          @generalize-n |
            fix n: Nat {
              @given-size-m |
                assume hasSize(a, m) {
                  @given-size-n |
                    assume hasSize(a, n) {
                      @a-matches-segment-m |
                        equinumerous(a, segment(m))
                        [by hypothesis given-size-m]
                      @a-matches-segment-n |
                        equinumerous(a, segment(n))
                        [by hypothesis given-size-n]
                      @segment-m-matches-a |
                        equinumerous(segment(m), a)
                        [using specialize equinumerousSymmetric(a, segment(m)) a-matches-segment-m]
                      @segments-match |
                        equinumerous(segment(m), segment(n))
                        [using specialize equinumerousTransitive(segment(m), a, segment(n)) segment-m-matches-a a-matches-segment-n]
                      @conclusion-same-length |
                        m = n
                        [using specialize segmentSizeIsUnique(m, n) segments-match]
                    }
                  @conclusion-size-n |
                    hasSize(a, n) -> m = n
                    [by implies_intro given-size-n]
                }
              @conclusion-size-m |
                hasSize(a, m) -> hasSize(a, n) -> m = n
                [by implies_intro given-size-m]
            }
          @discharge-n |
            forall n: Nat; hasSize(a, m) -> hasSize(a, n) -> m = n
            [by forall_intro generalize-n]
        }
      @discharge-m |
        forall m: Nat; forall n: Nat; hasSize(a, m) -> hasSize(a, n) -> m = n
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall a: Set; forall m: Nat; forall n: Nat; hasSize(a, m) -> hasSize(a, n) -> m = n
    [by forall_intro generalize-a]
qed

// -- the counting function ------------------------------------------------------
//
// `size(a)` is THE size of a finite set. The symbol is total (every Set has some
// `size`), but its value is pinned only when `a` is finite: then `size(a)` is a size of
// `a` — and by `hasSizeIsUnique` the only one, so this is definite description, not
// choice, in exactly the way `function.inverse` is. For an infinite set `size(a)` is an
// unconstrained value that nothing reasons about.
func size(a: Set) => Nat:
  hasSize(a, size(a)) when isFinite(a)

// A set's size is whatever size it has: `size` agrees with `hasSize`.
theorem sizeIsTheSize: forall a: Set; forall n: Nat; hasSize(a, n) -> size(a) = n
proof
  @size-clause |
    forall a: Set; isFinite(a) -> hasSize(a, size(a))
    [by definition(0) size]
  @generalize-a |
    fix a: Set {
      @generalize-n |
        fix n: Nat {
          @given-size |
            assume hasSize(a, n) {
              @a-has-size-n |
                hasSize(a, n)
                [by hypothesis given-size]
              @a-is-finite |
                isFinite(a)
                [by exists_intro(n) a-has-size-n]
              @a-has-its-size |
                hasSize(a, size(a))
                [using specialize size-clause(a) a-is-finite]
              @conclusion-sizes-agree |
                size(a) = n
                [using specialize hasSizeIsUnique(a, size(a), n) a-has-its-size a-has-size-n]
            }
          @conclusion-implication |
            hasSize(a, n) -> size(a) = n
            [by implies_intro given-size]
        }
      @discharge-n |
        forall n: Nat; hasSize(a, n) -> size(a) = n
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall a: Set; forall n: Nat; hasSize(a, n) -> size(a) = n
    [by forall_intro generalize-a]
qed

// The segment {0, …, n-1} has size n — the identity bijects it onto itself.
theorem sizeOfSegment: forall n: Nat; size(segment(n)) = n
proof
  @generalize-n |
    fix n: Nat {
      @segment-matches-itself |
        equinumerous(segment(n), segment(n))
        [using specialize equinumerousReflexive(segment(n))]
      @conclusion-size-n |
        size(segment(n)) = n
        [using specialize sizeIsTheSize(segment(n), n) segment-matches-itself]
    }
  @conclusion |
    forall n: Nat; size(segment(n)) = n
    [by forall_intro generalize-n]
qed

// The empty set has size ZERO.
theorem sizeOfEmptyset: size(emptyset) = ZERO
proof
  @emptyset-has-size-zero |
    hasSize(emptyset, ZERO)
    [by cite emptysetHasSizeZero]
  @conclusion |
    size(emptyset) = ZERO
    [using specialize sizeIsTheSize(emptyset, ZERO) emptyset-has-size-zero]
qed

// -- counting one element at a time ------------------------------------------------------
//
// The combinatorics of finite sets — a subset of a finite set is finite and no larger, a
// proper subset is strictly smaller, disjoint sizes add — all reduce to two moves: REMOVING
// one element from a set of size n+1 leaves size n, and ADDING a fresh element to a set of
// size n gives size n+1. Both are bijection surgery at a single point.

// RESTRICTION OFF A POINT: a bijection b -> segment(succ n) that sends t to the top restricts
// to a bijection b \ {t} -> segment(n). The restriction lemma with a SET as the source: into
// because nothing but t can hit the top (injectivity); injective as a subset; onto because a
// preimage of a point below the top is not t.
theorem restrictionOffAPoint: forall f: Fn; forall b: Set; forall t: Element; forall n: Nat;
  bijectsOnto(f, b, segment(succ(n))) -> member(t, b) -> apply(f, t) = numeral(n) ->
  bijectsOnto(f, difference(b, singleton(t)), segment(n))
proof
  @generalize-f |
    fix f: Fn {
      @generalize-b |
        fix b: Set {
          @generalize-t |
            fix t: Element {
              @generalize-n |
                fix n: Nat {
                  @given-bijection |
                    assume bijectsOnto(f, b, segment(succ(n))) {
                      @given-t-in-b |
                        assume member(t, b) {
                          @given-top |
                            assume apply(f, t) = numeral(n) {
                              @bijection-facts |
                                mapsInto(f, b, segment(succ(n))) and injectiveOn(f, b) and surjectiveOnto(f, b, segment(succ(n)))
                                [by hypothesis given-bijection]
                              @into-and-injective |
                                mapsInto(f, b, segment(succ(n))) and injectiveOn(f, b)
                                [by and_elim_left bijection-facts]
                              @into |
                                mapsInto(f, b, segment(succ(n)))
                                [by and_elim_left into-and-injective]
                              @injective |
                                injectiveOn(f, b)
                                [by and_elim_right into-and-injective]
                              @covers |
                                surjectiveOnto(f, b, segment(succ(n)))
                                [by and_elim_right bijection-facts]
                              @t-in-b |
                                member(t, b)
                                [by hypothesis given-t-in-b]
                              @top-to-top |
                                apply(f, t) = numeral(n)
                                [by hypothesis given-top]
                              @top-not-in-small |
                                not member(numeral(n), segment(n))
                                [using specialize topIsNotInTheSmallerSegment(n)]

                              // INTO
                              @pointwise-into |
                                fix x: Element {
                                  @given-x |
                                    assume member(x, difference(b, singleton(t))) {
                                      @x-in-rest |
                                        member(x, difference(b, singleton(t)))
                                        [by hypothesis given-x]
                                      @rest-membership |
                                        member(x, difference(b, singleton(t))) iff (member(x, b) and (not member(x, singleton(t))))
                                        [using specialize differenceMember(b, singleton(t), x)]
                                      @singleton-membership |
                                        member(x, singleton(t)) iff x = t
                                        [using specialize singletonMember(t, x)]
                                      @x-in-b |
                                        member(x, b)
                                        [using tautology x-in-rest rest-membership]
                                      @x-is-not-t |
                                        x != t
                                        [using tautology x-in-rest rest-membership singleton-membership]
                                      @image-in-big |
                                        member(apply(f, x), segment(succ(n)))
                                        [using specialize into(x) x-in-b]
                                      @image-splits |
                                        member(apply(f, x), segment(n)) or apply(f, x) = numeral(n)
                                        [using specialize segmentSuccSplits(n, apply(f, x)) image-in-big]
                                      @conclusion-image-in-small |
                                        member(apply(f, x), segment(n))
                                        case image-splits {
                                          @when-in-small |
                                            assume member(apply(f, x), segment(n)) {
                                              @conclusion-small |
                                                member(apply(f, x), segment(n))
                                                [by hypothesis when-in-small]
                                            }
                                          @when-at-top |
                                            assume apply(f, x) = numeral(n) {
                                              @x-hits-top |
                                                apply(f, x) = numeral(n)
                                                [by hypothesis when-at-top]
                                              @same-image-as-t |
                                                apply(f, x) = apply(f, t)
                                                [by rewrite top-to-top x-hits-top]
                                              @x-is-t |
                                                x = t
                                                [using specialize injective(x, t) x-in-b t-in-b same-image-as-t]
                                              @conclusion-absurd |
                                                member(apply(f, x), segment(n))
                                                [by absurd x-is-t x-is-not-t]
                                            }
                                        }
                                    }
                                  @conclusion-into-implication |
                                    member(x, difference(b, singleton(t))) -> member(apply(f, x), segment(n))
                                    [by implies_intro given-x]
                                }
                              @restriction-into |
                                mapsInto(f, difference(b, singleton(t)), segment(n))
                                [by forall_intro pointwise-into]

                              // INJECTIVE: a subset of b
                              @pointwise-injective |
                                fix x: Element {
                                  @inner |
                                    fix y: Element {
                                      @given-x-in-rest |
                                        assume member(x, difference(b, singleton(t))) {
                                          @given-y-in-rest |
                                            assume member(y, difference(b, singleton(t))) {
                                              @given-images |
                                                assume apply(f, x) = apply(f, y) {
                                                  @x-in-rest |
                                                    member(x, difference(b, singleton(t)))
                                                    [by hypothesis given-x-in-rest]
                                                  @y-in-rest |
                                                    member(y, difference(b, singleton(t)))
                                                    [by hypothesis given-y-in-rest]
                                                  @images-equal |
                                                    apply(f, x) = apply(f, y)
                                                    [by hypothesis given-images]
                                                  @x-rest-membership |
                                                    member(x, difference(b, singleton(t))) iff (member(x, b) and (not member(x, singleton(t))))
                                                    [using specialize differenceMember(b, singleton(t), x)]
                                                  @y-rest-membership |
                                                    member(y, difference(b, singleton(t))) iff (member(y, b) and (not member(y, singleton(t))))
                                                    [using specialize differenceMember(b, singleton(t), y)]
                                                  @x-in-b |
                                                    member(x, b)
                                                    [using tautology x-in-rest x-rest-membership]
                                                  @y-in-b |
                                                    member(y, b)
                                                    [using tautology y-in-rest y-rest-membership]
                                                  @conclusion-equal |
                                                    x = y
                                                    [using specialize injective(x, y) x-in-b y-in-b images-equal]
                                                }
                                              @conclusion-images |
                                                apply(f, x) = apply(f, y) -> x = y
                                                [by implies_intro given-images]
                                            }
                                          @conclusion-y |
                                            member(y, difference(b, singleton(t))) -> apply(f, x) = apply(f, y) -> x = y
                                            [by implies_intro given-y-in-rest]
                                        }
                                      @conclusion-x |
                                        member(x, difference(b, singleton(t))) -> member(y, difference(b, singleton(t))) -> apply(f, x) = apply(f, y) -> x = y
                                        [by implies_intro given-x-in-rest]
                                    }
                                  @discharge-y |
                                    forall y: Element; member(x, difference(b, singleton(t))) -> member(y, difference(b, singleton(t))) -> apply(f, x) = apply(f, y) -> x = y
                                    [by forall_intro inner]
                                }
                              @restriction-injective |
                                injectiveOn(f, difference(b, singleton(t)))
                                [by forall_intro pointwise-injective]

                              // ONTO: a preimage of a point below the top is not t
                              @pointwise-covers |
                                fix y: Element {
                                  @given-y |
                                    assume member(y, segment(n)) {
                                      @y-in-small |
                                        member(y, segment(n))
                                        [by hypothesis given-y]
                                      @y-in-big |
                                        member(y, segment(succ(n)))
                                        [using specialize segmentGrows(n, y) y-in-small]
                                      @preimage-exists |
                                        exists x: Element; member(x, b) and apply(f, x) = y
                                        [using specialize covers(y) y-in-big]
                                      @with-preimage-x |
                                        unpack x: Element from preimage-exists {
                                          @preimage-facts |
                                            member(x, b) and apply(f, x) = y
                                            [by hypothesis with-preimage-x]
                                          @x-in-b |
                                            member(x, b)
                                            [by and_elim_left preimage-facts]
                                          @x-maps-to-y |
                                            apply(f, x) = y
                                            [by and_elim_right preimage-facts]
                                          // if x were t, y = f(t) would be the top, which is not below it
                                          @suppose-x-is-t |
                                            assume x = t {
                                              @x-is-t |
                                                x = t
                                                [by hypothesis suppose-x-is-t]
                                              @t-maps-to-y |
                                                apply(f, t) = y
                                                [by rewrite x-is-t x-maps-to-y]
                                              @y-is-top |
                                                numeral(n) = y
                                                [by rewrite top-to-top t-maps-to-y]
                                              @top-in-small |
                                                member(numeral(n), segment(n))
                                                [by rewrite y-is-top y-in-small]
                                            }
                                          @x-is-not-t |
                                            x != t
                                            [by not_intro suppose-x-is-t top-in-small top-not-in-small]
                                          @x-rest-membership |
                                            member(x, difference(b, singleton(t))) iff (member(x, b) and (not member(x, singleton(t))))
                                            [using specialize differenceMember(b, singleton(t), x)]
                                          @singleton-membership |
                                            member(x, singleton(t)) iff x = t
                                            [using specialize singletonMember(t, x)]
                                          @x-in-rest |
                                            member(x, difference(b, singleton(t)))
                                            [using tautology x-in-b x-is-not-t x-rest-membership singleton-membership]
                                          @x-is-a-preimage-in-rest |
                                            member(x, difference(b, singleton(t))) and apply(f, x) = y
                                            [by and_intro x-in-rest x-maps-to-y]
                                          @conclusion-covered |
                                            exists x2: Element; member(x2, difference(b, singleton(t))) and apply(f, x2) = y
                                            [by exists_intro(x) x-is-a-preimage-in-rest]
                                        }
                                      @conclusion-y-covered |
                                        exists x2: Element; member(x2, difference(b, singleton(t))) and apply(f, x2) = y
                                        [by exists_elim with-preimage-x]
                                    }
                                  @conclusion-covers-implication |
                                    member(y, segment(n)) -> exists x2: Element; member(x2, difference(b, singleton(t))) and apply(f, x2) = y
                                    [by implies_intro given-y]
                                }
                              @restriction-covers |
                                surjectiveOnto(f, difference(b, singleton(t)), segment(n))
                                [by forall_intro pointwise-covers]

                              @restriction-into-and-injective |
                                mapsInto(f, difference(b, singleton(t)), segment(n)) and injectiveOn(f, difference(b, singleton(t)))
                                [by and_intro restriction-into restriction-injective]
                              @conclusion-restriction-bijects |
                                bijectsOnto(f, difference(b, singleton(t)), segment(n))
                                [by and_intro restriction-into-and-injective restriction-covers]
                            }
                          @conclusion-top |
                            apply(f, t) = numeral(n) -> bijectsOnto(f, difference(b, singleton(t)), segment(n))
                            [by implies_intro given-top]
                        }
                      @conclusion-t |
                        member(t, b) -> apply(f, t) = numeral(n) -> bijectsOnto(f, difference(b, singleton(t)), segment(n))
                        [by implies_intro given-t-in-b]
                    }
                  @conclusion-bijection |
                    bijectsOnto(f, b, segment(succ(n))) -> member(t, b) -> apply(f, t) = numeral(n) -> bijectsOnto(f, difference(b, singleton(t)), segment(n))
                    [by implies_intro given-bijection]
                }
              @discharge-n |
                forall n: Nat; bijectsOnto(f, b, segment(succ(n))) -> member(t, b) -> apply(f, t) = numeral(n) -> bijectsOnto(f, difference(b, singleton(t)), segment(n))
                [by forall_intro generalize-n]
            }
          @discharge-t |
            forall t: Element; forall n: Nat; bijectsOnto(f, b, segment(succ(n))) -> member(t, b) -> apply(f, t) = numeral(n) -> bijectsOnto(f, difference(b, singleton(t)), segment(n))
            [by forall_intro generalize-t]
        }
      @discharge-b |
        forall b: Set; forall t: Element; forall n: Nat; bijectsOnto(f, b, segment(succ(n))) -> member(t, b) -> apply(f, t) = numeral(n) -> bijectsOnto(f, difference(b, singleton(t)), segment(n))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall f: Fn; forall b: Set; forall t: Element; forall n: Nat;
      bijectsOnto(f, b, segment(succ(n))) -> member(t, b) -> apply(f, t) = numeral(n) ->
      bijectsOnto(f, difference(b, singleton(t)), segment(n))
    [by forall_intro generalize-f]
qed

// REMOVING an element from a set of size n+1 leaves size n: straighten the bijection with a
// swap so the element goes to the top, then restrict off it.
theorem removingAnElementDropsTheSize: forall b: Set; forall t: Element; forall n: Nat;
  hasSize(b, succ(n)) -> member(t, b) -> hasSize(difference(b, singleton(t)), n)
proof
  @generalize-b |
    fix b: Set {
      @generalize-t |
        fix t: Element {
          @generalize-n |
            fix n: Nat {
              @given-size |
                assume hasSize(b, succ(n)) {
                  @given-t-in-b |
                    assume member(t, b) {
                      @the-bijection-exists |
                        exists f: Fn; bijectsOnto(f, b, segment(succ(n)))
                        [by hypothesis given-size]
                      @t-in-b |
                        member(t, b)
                        [by hypothesis given-t-in-b]
                      @with-bijection-f |
                        unpack f: Fn from the-bijection-exists {
                          @bijection-facts |
                            mapsInto(f, b, segment(succ(n))) and injectiveOn(f, b) and surjectiveOnto(f, b, segment(succ(n)))
                            [by hypothesis with-bijection-f]
                          @into-and-injective |
                            mapsInto(f, b, segment(succ(n))) and injectiveOn(f, b)
                            [by and_elim_left bijection-facts]
                          @into |
                            mapsInto(f, b, segment(succ(n)))
                            [by and_elim_left into-and-injective]
                          @injective |
                            injectiveOn(f, b)
                            [by and_elim_right into-and-injective]
                          @covers |
                            surjectiveOnto(f, b, segment(succ(n)))
                            [by and_elim_right bijection-facts]

                          // the swap that moves t's image onto the top
                          @image-of-t-in-big |
                            member(apply(f, t), segment(succ(n)))
                            [using specialize into(t) t-in-b]
                          @top-in-big |
                            member(numeral(n), segment(succ(n)))
                            [using specialize topIsInTheBiggerSegment(n)]
                          @swap-maps-into |
                            mapsInto(swap(apply(f, t), numeral(n)), segment(succ(n)), segment(succ(n)))
                            [using specialize swapMapsInto(apply(f, t), numeral(n), segment(succ(n))) image-of-t-in-big top-in-big]
                          @swap-is-injective |
                            injectiveOn(swap(apply(f, t), numeral(n)), segment(succ(n)))
                            [using specialize swapIsInjectiveOn(apply(f, t), numeral(n), segment(succ(n)))]
                          @swap-covers |
                            surjectiveOnto(swap(apply(f, t), numeral(n)), segment(succ(n)), segment(succ(n)))
                            [using specialize swapCoversItsImage(apply(f, t), numeral(n), segment(succ(n)), segment(succ(n))) swap-maps-into]

                          // the composite bijects b onto segment(succ n) and sends t to the top
                          @composite-maps-into |
                            mapsInto(compose(swap(apply(f, t), numeral(n)), f), b, segment(succ(n)))
                            [using specialize composeMapsInto(f, swap(apply(f, t), numeral(n)), b, segment(succ(n)), segment(succ(n))) into swap-maps-into]
                          @composite-is-injective |
                            injectiveOn(compose(swap(apply(f, t), numeral(n)), f), b)
                            [using specialize composeIsInjectiveOn(f, swap(apply(f, t), numeral(n)), b, segment(succ(n))) into injective swap-is-injective]
                          @composite-covers |
                            surjectiveOnto(compose(swap(apply(f, t), numeral(n)), f), b, segment(succ(n)))
                            [using specialize composeIsSurjectiveOnto(f, swap(apply(f, t), numeral(n)), b, segment(succ(n)), segment(succ(n))) covers swap-covers]
                          @composite-into-and-injective |
                            mapsInto(compose(swap(apply(f, t), numeral(n)), f), b, segment(succ(n))) and injectiveOn(compose(swap(apply(f, t), numeral(n)), f), b)
                            [by and_intro composite-maps-into composite-is-injective]
                          @composite-bijects |
                            bijectsOnto(compose(swap(apply(f, t), numeral(n)), f), b, segment(succ(n)))
                            [by and_intro composite-into-and-injective composite-covers]
                          @composite-at-t |
                            apply(compose(swap(apply(f, t), numeral(n)), f), t) = apply(swap(apply(f, t), numeral(n)), apply(f, t))
                            [using specialize composeApply(swap(apply(f, t), numeral(n)), f, t)]
                          @swap-moves-the-image-to-top |
                            apply(swap(apply(f, t), numeral(n)), apply(f, t)) = numeral(n)
                            [using specialize swapAtFirst(apply(f, t), numeral(n))]
                          @composite-sends-t-to-top |
                            apply(compose(swap(apply(f, t), numeral(n)), f), t) = numeral(n)
                            [by rewrite swap-moves-the-image-to-top composite-at-t]

                          @restriction-bijects |
                            bijectsOnto(compose(swap(apply(f, t), numeral(n)), f), difference(b, singleton(t)), segment(n))
                            [using specialize restrictionOffAPoint(compose(swap(apply(f, t), numeral(n)), f), b, t, n) composite-bijects t-in-b composite-sends-t-to-top]
                          @conclusion-witness |
                            exists g: Fn; bijectsOnto(g, difference(b, singleton(t)), segment(n))
                            [by exists_intro(compose(swap(apply(f, t), numeral(n)), f)) restriction-bijects]
                        }
                      @conclusion-rest-has-size-n |
                        exists g: Fn; bijectsOnto(g, difference(b, singleton(t)), segment(n))
                        [by exists_elim with-bijection-f]
                    }
                  @conclusion-t |
                    member(t, b) -> hasSize(difference(b, singleton(t)), n)
                    [by implies_intro given-t-in-b]
                }
              @conclusion-size |
                hasSize(b, succ(n)) -> member(t, b) -> hasSize(difference(b, singleton(t)), n)
                [by implies_intro given-size]
            }
          @discharge-n |
            forall n: Nat; hasSize(b, succ(n)) -> member(t, b) -> hasSize(difference(b, singleton(t)), n)
            [by forall_intro generalize-n]
        }
      @discharge-t |
        forall t: Element; forall n: Nat; hasSize(b, succ(n)) -> member(t, b) -> hasSize(difference(b, singleton(t)), n)
        [by forall_intro generalize-t]
    }
  @conclusion |
    forall b: Set; forall t: Element; forall n: Nat;
      hasSize(b, succ(n)) -> member(t, b) -> hasSize(difference(b, singleton(t)), n)
    [by forall_intro generalize-b]
qed

// ADDING a fresh element: extend a bijection c -> segment(m) by t -> numeral(m). The
// extension is pinned pointwise by a spec (at t, the new top; elsewhere, the old map) that
// is trivially total and single-valued, and `functionFromGraph` realizes it.
define extensionSpec(h, t, m, x, y) = (x = t and y = numeral(m)) or (x != t and y = apply(h, x))

theorem extensionSpecIsTotalAndSingleValued: forall h: Fn; forall t: Element; forall m: Nat;
  forall x: Element; exists y: Element;
  extensionSpec(h, t, m, x, y) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> y = y2)
proof
  @generalize-h |
    fix h: Fn {
      @generalize-t |
        fix t: Element {
          @generalize-m |
            fix m: Nat {
              @pointwise |
                fix x: Element {
                  @x-is-t-or-not |
                    x = t or x != t
                    [using tautology]
                  @conclusion-unique-value |
                    exists y: Element; extensionSpec(h, t, m, x, y) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> y = y2)
                    case x-is-t-or-not {
                      @when-at-t |
                        assume x = t {
                          @x-is-t |
                            x = t
                            [by hypothesis when-at-t]
                          @top-is-itself |
                            numeral(m) = numeral(m)
                            [by reflexivity]
                          @top-meets-the-spec |
                            extensionSpec(h, t, m, x, numeral(m))
                            [using tautology x-is-t top-is-itself]
                          @generalize-candidate |
                            fix y2: Element {
                              @given-candidate |
                                assume extensionSpec(h, t, m, x, y2) {
                                  @candidate-meets-spec |
                                    extensionSpec(h, t, m, x, y2)
                                    [by hypothesis given-candidate]
                                  @candidate-is-top |
                                    y2 = numeral(m)
                                    [using tautology candidate-meets-spec x-is-t]
                                  @conclusion-top-is-candidate |
                                    numeral(m) = y2
                                    [by symmetry candidate-is-top]
                                }
                              @conclusion-candidate-implication |
                                extensionSpec(h, t, m, x, y2) -> numeral(m) = y2
                                [by implies_intro given-candidate]
                            }
                          @top-is-the-only-value |
                            forall y2: Element; extensionSpec(h, t, m, x, y2) -> numeral(m) = y2
                            [by forall_intro generalize-candidate]
                          @witness-clauses |
                            extensionSpec(h, t, m, x, numeral(m)) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> numeral(m) = y2)
                            [by and_intro top-meets-the-spec top-is-the-only-value]
                          @conclusion-at-t |
                            exists y: Element; extensionSpec(h, t, m, x, y) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> y = y2)
                            [by exists_intro(numeral(m)) witness-clauses]
                        }
                      @when-elsewhere |
                        assume x != t {
                          @x-is-not-t |
                            x != t
                            [by hypothesis when-elsewhere]
                          @old-value-is-itself |
                            apply(h, x) = apply(h, x)
                            [by reflexivity]
                          @old-value-meets-the-spec |
                            extensionSpec(h, t, m, x, apply(h, x))
                            [using tautology x-is-not-t old-value-is-itself]
                          @generalize-candidate |
                            fix y2: Element {
                              @given-candidate |
                                assume extensionSpec(h, t, m, x, y2) {
                                  @candidate-meets-spec |
                                    extensionSpec(h, t, m, x, y2)
                                    [by hypothesis given-candidate]
                                  @candidate-is-old-value |
                                    y2 = apply(h, x)
                                    [using tautology candidate-meets-spec x-is-not-t]
                                  @conclusion-old-value-is-candidate |
                                    apply(h, x) = y2
                                    [by symmetry candidate-is-old-value]
                                }
                              @conclusion-candidate-implication |
                                extensionSpec(h, t, m, x, y2) -> apply(h, x) = y2
                                [by implies_intro given-candidate]
                            }
                          @old-value-is-the-only-value |
                            forall y2: Element; extensionSpec(h, t, m, x, y2) -> apply(h, x) = y2
                            [by forall_intro generalize-candidate]
                          @witness-clauses |
                            extensionSpec(h, t, m, x, apply(h, x)) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> apply(h, x) = y2)
                            [by and_intro old-value-meets-the-spec old-value-is-the-only-value]
                          @conclusion-elsewhere |
                            exists y: Element; extensionSpec(h, t, m, x, y) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> y = y2)
                            [by exists_intro(apply(h, x)) witness-clauses]
                        }
                    }
                }
              @conclusion-total-and-single-valued |
                forall x: Element; exists y: Element; extensionSpec(h, t, m, x, y) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> y = y2)
                [by forall_intro pointwise]
            }
          @discharge-m |
            forall m: Nat; forall x: Element; exists y: Element; extensionSpec(h, t, m, x, y) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> y = y2)
            [by forall_intro generalize-m]
        }
      @discharge-t |
        forall t: Element; forall m: Nat; forall x: Element; exists y: Element; extensionSpec(h, t, m, x, y) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> y = y2)
        [by forall_intro generalize-t]
    }
  @conclusion |
    forall h: Fn; forall t: Element; forall m: Nat;
      forall x: Element; exists y: Element;
      extensionSpec(h, t, m, x, y) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> y = y2)
    [by forall_intro generalize-h]
qed
// Any map realizing the extension spec bijects c ∪ {t} onto segment(succ m): on c it is the
// old bijection into segment(m); at t it is the new top, which nothing in c reaches.
theorem extensionSpecBijects: forall h: Fn; forall g: Fn; forall c: Set; forall t: Element; forall m: Nat;
  bijectsOnto(h, c, segment(m)) -> (not member(t, c)) ->
  (forall x: Element; extensionSpec(h, t, m, x, apply(g, x))) ->
  bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
proof
  @generalize-h |
    fix h: Fn {
      @generalize-g |
        fix g: Fn {
          @generalize-c |
            fix c: Set {
              @generalize-t |
                fix t: Element {
                  @generalize-m |
                    fix m: Nat {
                      @given-bijection |
                        assume bijectsOnto(h, c, segment(m)) {
                          @given-t-outside |
                            assume not member(t, c) {
                              @given-spec |
                                assume forall x: Element; extensionSpec(h, t, m, x, apply(g, x)) {
                                  @bijection-facts |
                                    mapsInto(h, c, segment(m)) and injectiveOn(h, c) and surjectiveOnto(h, c, segment(m))
                                    [by hypothesis given-bijection]
                                  @into-and-injective |
                                    mapsInto(h, c, segment(m)) and injectiveOn(h, c)
                                    [by and_elim_left bijection-facts]
                                  @into |
                                    mapsInto(h, c, segment(m))
                                    [by and_elim_left into-and-injective]
                                  @injective |
                                    injectiveOn(h, c)
                                    [by and_elim_right into-and-injective]
                                  @covers |
                                    surjectiveOnto(h, c, segment(m))
                                    [by and_elim_right bijection-facts]
                                  @t-outside |
                                    not member(t, c)
                                    [by hypothesis given-t-outside]
                                  @spec |
                                    forall x: Element; extensionSpec(h, t, m, x, apply(g, x))
                                    [by hypothesis given-spec]
                                  @top-in-big |
                                    member(numeral(m), segment(succ(m)))
                                    [using specialize topIsInTheBiggerSegment(m)]
                                  @top-not-in-small |
                                    not member(numeral(m), segment(m))
                                    [using specialize topIsNotInTheSmallerSegment(m)]

                                  // INTO
                                  @pointwise-into |
                                    fix x: Element {
                                      @given-x |
                                        assume member(x, union(c, singleton(t))) {
                                          @x-in-union |
                                            member(x, union(c, singleton(t)))
                                            [by hypothesis given-x]
                                          @union-membership |
                                            member(x, union(c, singleton(t))) iff (member(x, c) or x = t)
                                            [using specialize unionSingletonMember(c, t, x)]
                                          @x-in-c-or-is-t |
                                            member(x, c) or x = t
                                            [using tautology x-in-union union-membership]
                                          @spec-at-x |
                                            extensionSpec(h, t, m, x, apply(g, x))
                                            [using specialize spec(x)]
                                          @conclusion-image-in-big |
                                            member(apply(g, x), segment(succ(m)))
                                            case x-in-c-or-is-t {
                                              @when-in-c |
                                                assume member(x, c) {
                                                  @x-in-c |
                                                    member(x, c)
                                                    [by hypothesis when-in-c]
                                                  @x-is-not-t |
                                                    x != t
                                                    [using specialize memberIsNotTheOutsider(c, t, x) x-in-c t-outside]
                                                  @g-agrees-with-h |
                                                    apply(g, x) = apply(h, x)
                                                    [using tautology spec-at-x x-is-not-t]
                                                  @old-image-in-small |
                                                    member(apply(h, x), segment(m))
                                                    [using specialize into(x) x-in-c]
                                                  @image-in-small |
                                                    member(apply(g, x), segment(m))
                                                    [by rewrite g-agrees-with-h old-image-in-small]
                                                  @conclusion-in-c |
                                                    member(apply(g, x), segment(succ(m)))
                                                    [using specialize segmentGrows(m, apply(g, x)) image-in-small]
                                                }
                                              @when-at-t |
                                                assume x = t {
                                                  @x-is-t |
                                                    x = t
                                                    [by hypothesis when-at-t]
                                                  @g-sends-x-to-top |
                                                    apply(g, x) = numeral(m)
                                                    [using tautology spec-at-x x-is-t]
                                                  @conclusion-at-t |
                                                    member(apply(g, x), segment(succ(m)))
                                                    [by rewrite g-sends-x-to-top top-in-big]
                                                }
                                            }
                                        }
                                      @conclusion-into-implication |
                                        member(x, union(c, singleton(t))) -> member(apply(g, x), segment(succ(m)))
                                        [by implies_intro given-x]
                                    }
                                  @g-maps-into |
                                    mapsInto(g, union(c, singleton(t)), segment(succ(m)))
                                    [by forall_intro pointwise-into]

                                  // INJECTIVE: four cases on which of x, y is t
                                  @pointwise-injective |
                                    fix x: Element {
                                      @inner |
                                        fix y: Element {
                                          @given-x-in-union |
                                            assume member(x, union(c, singleton(t))) {
                                              @given-y-in-union |
                                                assume member(y, union(c, singleton(t))) {
                                                  @given-images |
                                                    assume apply(g, x) = apply(g, y) {
                                                      @x-in-union |
                                                        member(x, union(c, singleton(t)))
                                                        [by hypothesis given-x-in-union]
                                                      @y-in-union |
                                                        member(y, union(c, singleton(t)))
                                                        [by hypothesis given-y-in-union]
                                                      @images-equal |
                                                        apply(g, x) = apply(g, y)
                                                        [by hypothesis given-images]
                                                      @x-union-membership |
                                                        member(x, union(c, singleton(t))) iff (member(x, c) or x = t)
                                                        [using specialize unionSingletonMember(c, t, x)]
                                                      @y-union-membership |
                                                        member(y, union(c, singleton(t))) iff (member(y, c) or y = t)
                                                        [using specialize unionSingletonMember(c, t, y)]
                                                      @x-in-c-or-is-t |
                                                        member(x, c) or x = t
                                                        [using tautology x-in-union x-union-membership]
                                                      @y-in-c-or-is-t |
                                                        member(y, c) or y = t
                                                        [using tautology y-in-union y-union-membership]
                                                      @spec-at-x |
                                                        extensionSpec(h, t, m, x, apply(g, x))
                                                        [using specialize spec(x)]
                                                      @spec-at-y |
                                                        extensionSpec(h, t, m, y, apply(g, y))
                                                        [using specialize spec(y)]
                                                      @conclusion-equal |
                                                        x = y
                                                        case x-in-c-or-is-t {
                                                          @when-x-in-c |
                                                            assume member(x, c) {
                                                              @x-in-c |
                                                                member(x, c)
                                                                [by hypothesis when-x-in-c]
                                                              @x-is-not-t |
                                                                x != t
                                                                [using specialize memberIsNotTheOutsider(c, t, x) x-in-c t-outside]
                                                              @g-x-is-h-x |
                                                                apply(g, x) = apply(h, x)
                                                                [using tautology spec-at-x x-is-not-t]
                                                              @h-x-in-small |
                                                                member(apply(h, x), segment(m))
                                                                [using specialize into(x) x-in-c]
                                                              @h-x-is-g-y |
                                                                apply(h, x) = apply(g, y)
                                                                [by rewrite g-x-is-h-x images-equal]
                                                              @conclusion-x-in-c |
                                                                x = y
                                                                case y-in-c-or-is-t {
                                                                  @when-y-in-c |
                                                                    assume member(y, c) {
                                                                      @y-in-c |
                                                                        member(y, c)
                                                                        [by hypothesis when-y-in-c]
                                                                      @y-is-not-t |
                                                                        y != t
                                                                        [using specialize memberIsNotTheOutsider(c, t, y) y-in-c t-outside]
                                                                      @g-y-is-h-y |
                                                                        apply(g, y) = apply(h, y)
                                                                        [using tautology spec-at-y y-is-not-t]
                                                                      @h-images-equal |
                                                                        apply(h, x) = apply(h, y)
                                                                        [by rewrite g-y-is-h-y h-x-is-g-y]
                                                                      @conclusion-both-in-c |
                                                                        x = y
                                                                        [using specialize injective(x, y) x-in-c y-in-c h-images-equal]
                                                                    }
                                                                  @when-y-at-t |
                                                                    assume y = t {
                                                                      // then h(x) would be the top, which is not in segment(m)
                                                                      @y-is-t |
                                                                        y = t
                                                                        [by hypothesis when-y-at-t]
                                                                      @g-y-is-top |
                                                                        apply(g, y) = numeral(m)
                                                                        [using tautology spec-at-y y-is-t]
                                                                      @h-x-is-top |
                                                                        apply(h, x) = numeral(m)
                                                                        [by rewrite g-y-is-top h-x-is-g-y]
                                                                      @top-in-small |
                                                                        member(numeral(m), segment(m))
                                                                        [by rewrite h-x-is-top h-x-in-small]
                                                                      @conclusion-absurd-x |
                                                                        x = y
                                                                        [by absurd top-in-small top-not-in-small]
                                                                    }
                                                                }
                                                            }
                                                          @when-x-at-t |
                                                            assume x = t {
                                                              @x-is-t |
                                                                x = t
                                                                [by hypothesis when-x-at-t]
                                                              @g-x-is-top |
                                                                apply(g, x) = numeral(m)
                                                                [using tautology spec-at-x x-is-t]
                                                              @top-is-g-y |
                                                                numeral(m) = apply(g, y)
                                                                [by rewrite g-x-is-top images-equal]
                                                              @conclusion-x-at-t |
                                                                x = y
                                                                case y-in-c-or-is-t {
                                                                  @when-y-in-c |
                                                                    assume member(y, c) {
                                                                      @y-in-c |
                                                                        member(y, c)
                                                                        [by hypothesis when-y-in-c]
                                                                      @y-is-not-t |
                                                                        y != t
                                                                        [using specialize memberIsNotTheOutsider(c, t, y) y-in-c t-outside]
                                                                      @g-y-is-h-y |
                                                                        apply(g, y) = apply(h, y)
                                                                        [using tautology spec-at-y y-is-not-t]
                                                                      @h-y-in-small |
                                                                        member(apply(h, y), segment(m))
                                                                        [using specialize into(y) y-in-c]
                                                                      @top-is-h-y |
                                                                        numeral(m) = apply(h, y)
                                                                        [by rewrite g-y-is-h-y top-is-g-y]
                                                                      @top-in-small |
                                                                        member(numeral(m), segment(m))
                                                                        [by rewrite top-is-h-y h-y-in-small]
                                                                      @conclusion-absurd-y |
                                                                        x = y
                                                                        [by absurd top-in-small top-not-in-small]
                                                                    }
                                                                  @when-y-at-t |
                                                                    assume y = t {
                                                                      @y-is-t |
                                                                        y = t
                                                                        [by hypothesis when-y-at-t]
                                                                      @conclusion-both-t |
                                                                        x = y
                                                                        [by rewrite y-is-t x-is-t]
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                  @conclusion-images |
                                                    apply(g, x) = apply(g, y) -> x = y
                                                    [by implies_intro given-images]
                                                }
                                              @conclusion-y |
                                                member(y, union(c, singleton(t))) -> apply(g, x) = apply(g, y) -> x = y
                                                [by implies_intro given-y-in-union]
                                            }
                                          @conclusion-x |
                                            member(x, union(c, singleton(t))) -> member(y, union(c, singleton(t))) -> apply(g, x) = apply(g, y) -> x = y
                                            [by implies_intro given-x-in-union]
                                        }
                                      @discharge-y |
                                        forall y: Element; member(x, union(c, singleton(t))) -> member(y, union(c, singleton(t))) -> apply(g, x) = apply(g, y) -> x = y
                                        [by forall_intro inner]
                                    }
                                  @g-is-injective |
                                    injectiveOn(g, union(c, singleton(t)))
                                    [by forall_intro pointwise-injective]

                                  // ONTO: below the top, h's preimage; at the top, t
                                  @pointwise-covers |
                                    fix y: Element {
                                      @given-y |
                                        assume member(y, segment(succ(m))) {
                                          @y-in-big |
                                            member(y, segment(succ(m)))
                                            [by hypothesis given-y]
                                          @y-splits |
                                            member(y, segment(m)) or y = numeral(m)
                                            [using specialize segmentSuccSplits(m, y) y-in-big]
                                          @conclusion-y-covered |
                                            exists x: Element; member(x, union(c, singleton(t))) and apply(g, x) = y
                                            case y-splits {
                                              @when-below-top |
                                                assume member(y, segment(m)) {
                                                  @y-in-small |
                                                    member(y, segment(m))
                                                    [by hypothesis when-below-top]
                                                  @preimage-exists |
                                                    exists x: Element; member(x, c) and apply(h, x) = y
                                                    [using specialize covers(y) y-in-small]
                                                  @with-preimage-x |
                                                    unpack x: Element from preimage-exists {
                                                      @preimage-facts |
                                                        member(x, c) and apply(h, x) = y
                                                        [by hypothesis with-preimage-x]
                                                      @x-in-c |
                                                        member(x, c)
                                                        [by and_elim_left preimage-facts]
                                                      @h-x-is-y |
                                                        apply(h, x) = y
                                                        [by and_elim_right preimage-facts]
                                                      @x-is-not-t |
                                                        x != t
                                                        [using specialize memberIsNotTheOutsider(c, t, x) x-in-c t-outside]
                                                      @spec-at-x |
                                                        extensionSpec(h, t, m, x, apply(g, x))
                                                        [using specialize spec(x)]
                                                      @g-x-is-h-x |
                                                        apply(g, x) = apply(h, x)
                                                        [using tautology spec-at-x x-is-not-t]
                                                      @g-x-is-y |
                                                        apply(g, x) = y
                                                        [using chain g-x-is-h-x h-x-is-y]
                                                      @union-membership-at-x |
                                                        member(x, union(c, singleton(t))) iff (member(x, c) or x = t)
                                                        [using specialize unionSingletonMember(c, t, x)]
                                                      @x-in-union |
                                                        member(x, union(c, singleton(t)))
                                                        [using tautology x-in-c union-membership-at-x]
                                                      @x-is-a-preimage |
                                                        member(x, union(c, singleton(t))) and apply(g, x) = y
                                                        [by and_intro x-in-union g-x-is-y]
                                                      @conclusion-witness-x |
                                                        exists x2: Element; member(x2, union(c, singleton(t))) and apply(g, x2) = y
                                                        [by exists_intro(x) x-is-a-preimage]
                                                    }
                                                  @conclusion-below-top |
                                                    exists x2: Element; member(x2, union(c, singleton(t))) and apply(g, x2) = y
                                                    [by exists_elim with-preimage-x]
                                                }
                                              @when-at-top |
                                                assume y = numeral(m) {
                                                  @y-is-top |
                                                    y = numeral(m)
                                                    [by hypothesis when-at-top]
                                                  @t-is-t |
                                                    t = t
                                                    [by reflexivity]
                                                  @spec-at-t |
                                                    extensionSpec(h, t, m, t, apply(g, t))
                                                    [using specialize spec(t)]
                                                  @g-t-is-top |
                                                    apply(g, t) = numeral(m)
                                                    [using tautology spec-at-t t-is-t]
                                                  @g-t-is-y |
                                                    apply(g, t) = y
                                                    [by rewrite y-is-top g-t-is-top]
                                                  @union-membership-at-t |
                                                    member(t, union(c, singleton(t))) iff (member(t, c) or t = t)
                                                    [using specialize unionSingletonMember(c, t, t)]
                                                  @t-in-union |
                                                    member(t, union(c, singleton(t)))
                                                    [using tautology union-membership-at-t t-is-t]
                                                  @t-is-a-preimage |
                                                    member(t, union(c, singleton(t))) and apply(g, t) = y
                                                    [by and_intro t-in-union g-t-is-y]
                                                  @conclusion-witness-t |
                                                    exists x2: Element; member(x2, union(c, singleton(t))) and apply(g, x2) = y
                                                    [by exists_intro(t) t-is-a-preimage]
                                                }
                                            }
                                        }
                                      @conclusion-covers-implication |
                                        member(y, segment(succ(m))) -> exists x: Element; member(x, union(c, singleton(t))) and apply(g, x) = y
                                        [by implies_intro given-y]
                                    }
                                  @g-covers |
                                    surjectiveOnto(g, union(c, singleton(t)), segment(succ(m)))
                                    [by forall_intro pointwise-covers]

                                  @g-into-and-injective |
                                    mapsInto(g, union(c, singleton(t)), segment(succ(m))) and injectiveOn(g, union(c, singleton(t)))
                                    [by and_intro g-maps-into g-is-injective]
                                  @conclusion-g-bijects |
                                    bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
                                    [by and_intro g-into-and-injective g-covers]
                                }
                              @conclusion-spec |
                                (forall x: Element; extensionSpec(h, t, m, x, apply(g, x))) -> bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
                                [by implies_intro given-spec]
                            }
                          @conclusion-outside |
                            (not member(t, c)) -> (forall x: Element; extensionSpec(h, t, m, x, apply(g, x))) -> bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
                            [by implies_intro given-t-outside]
                        }
                      @conclusion-bijection |
                        bijectsOnto(h, c, segment(m)) -> (not member(t, c)) -> (forall x: Element; extensionSpec(h, t, m, x, apply(g, x))) -> bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
                        [by implies_intro given-bijection]
                    }
                  @discharge-m |
                    forall m: Nat; bijectsOnto(h, c, segment(m)) -> (not member(t, c)) -> (forall x: Element; extensionSpec(h, t, m, x, apply(g, x))) -> bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
                    [by forall_intro generalize-m]
                }
              @discharge-t |
                forall t: Element; forall m: Nat; bijectsOnto(h, c, segment(m)) -> (not member(t, c)) -> (forall x: Element; extensionSpec(h, t, m, x, apply(g, x))) -> bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
                [by forall_intro generalize-t]
            }
          @discharge-c |
            forall c: Set; forall t: Element; forall m: Nat; bijectsOnto(h, c, segment(m)) -> (not member(t, c)) -> (forall x: Element; extensionSpec(h, t, m, x, apply(g, x))) -> bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
            [by forall_intro generalize-c]
        }
      @discharge-g |
        forall g: Fn; forall c: Set; forall t: Element; forall m: Nat; bijectsOnto(h, c, segment(m)) -> (not member(t, c)) -> (forall x: Element; extensionSpec(h, t, m, x, apply(g, x))) -> bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
        [by forall_intro generalize-g]
    }
  @conclusion |
    forall h: Fn; forall g: Fn; forall c: Set; forall t: Element; forall m: Nat;
      bijectsOnto(h, c, segment(m)) -> (not member(t, c)) ->
      (forall x: Element; extensionSpec(h, t, m, x, apply(g, x))) ->
      bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
    [by forall_intro generalize-h]
qed

// ADDING a fresh element to a set of size m gives size m+1: realize the extension spec.
theorem addingAnElementRaisesTheSize: forall c: Set; forall t: Element; forall m: Nat;
  hasSize(c, m) -> (not member(t, c)) -> hasSize(union(c, singleton(t)), succ(m))
proof
  @generalize-c |
    fix c: Set {
      @generalize-t |
        fix t: Element {
          @generalize-m |
            fix m: Nat {
              @given-size |
                assume hasSize(c, m) {
                  @given-t-outside |
                    assume not member(t, c) {
                      @the-bijection-exists |
                        exists h: Fn; bijectsOnto(h, c, segment(m))
                        [by hypothesis given-size]
                      @t-outside |
                        not member(t, c)
                        [by hypothesis given-t-outside]
                      @with-bijection-h |
                        unpack h: Fn from the-bijection-exists {
                          @h-bijects |
                            bijectsOnto(h, c, segment(m))
                            [by hypothesis with-bijection-h]
                          @spec-is-total-and-single-valued |
                            forall x: Element; exists y: Element;
                              extensionSpec(h, t, m, x, y) and (forall y2: Element; extensionSpec(h, t, m, x, y2) -> y = y2)
                            [using specialize extensionSpecIsTotalAndSingleValued(h, t, m)]
                          @a-realization-exists |
                            exists g: Fn; forall x: Element; extensionSpec(h, t, m, x, apply(g, x))
                            [using instantiation functionFromGraph(fun x, y: Element => extensionSpec(h, t, m, x, y)) spec-is-total-and-single-valued]
                          @with-realization-g |
                            unpack g: Fn from a-realization-exists {
                              @g-realizes-the-spec |
                                forall x: Element; extensionSpec(h, t, m, x, apply(g, x))
                                [by hypothesis with-realization-g]
                              @g-bijects |
                                bijectsOnto(g, union(c, singleton(t)), segment(succ(m)))
                                [using specialize extensionSpecBijects(h, g, c, t, m) h-bijects t-outside g-realizes-the-spec]
                              @conclusion-witness |
                                exists g2: Fn; bijectsOnto(g2, union(c, singleton(t)), segment(succ(m)))
                                [by exists_intro(g) g-bijects]
                            }
                          @conclusion-realized |
                            exists g2: Fn; bijectsOnto(g2, union(c, singleton(t)), segment(succ(m)))
                            [by exists_elim with-realization-g]
                        }
                      @conclusion-enlarged-has-size |
                        exists g2: Fn; bijectsOnto(g2, union(c, singleton(t)), segment(succ(m)))
                        [by exists_elim with-bijection-h]
                    }
                  @conclusion-outside |
                    (not member(t, c)) -> hasSize(union(c, singleton(t)), succ(m))
                    [by implies_intro given-t-outside]
                }
              @conclusion-size |
                hasSize(c, m) -> (not member(t, c)) -> hasSize(union(c, singleton(t)), succ(m))
                [by implies_intro given-size]
            }
          @discharge-m |
            forall m: Nat; hasSize(c, m) -> (not member(t, c)) -> hasSize(union(c, singleton(t)), succ(m))
            [by forall_intro generalize-m]
        }
      @discharge-t |
        forall t: Element; forall m: Nat; hasSize(c, m) -> (not member(t, c)) -> hasSize(union(c, singleton(t)), succ(m))
        [by forall_intro generalize-t]
    }
  @conclusion |
    forall c: Set; forall t: Element; forall m: Nat;
      hasSize(c, m) -> (not member(t, c)) -> hasSize(union(c, singleton(t)), succ(m))
    [by forall_intro generalize-c]
qed

// A set of size n+1 has a member: the preimage of the top.
theorem sizedSetHasAMember: forall b: Set; forall n: Nat; hasSize(b, succ(n)) -> exists t: Element; member(t, b)
proof
  @generalize-b |
    fix b: Set {
      @generalize-n |
        fix n: Nat {
          @given-size |
            assume hasSize(b, succ(n)) {
              @the-bijection-exists |
                exists f: Fn; bijectsOnto(f, b, segment(succ(n)))
                [by hypothesis given-size]
              @with-bijection-f |
                unpack f: Fn from the-bijection-exists {
                  @bijection-facts |
                    mapsInto(f, b, segment(succ(n))) and injectiveOn(f, b) and surjectiveOnto(f, b, segment(succ(n)))
                    [by hypothesis with-bijection-f]
                  @covers |
                    surjectiveOnto(f, b, segment(succ(n)))
                    [by and_elim_right bijection-facts]
                  @top-in-big |
                    member(numeral(n), segment(succ(n)))
                    [using specialize topIsInTheBiggerSegment(n)]
                  @preimage-exists |
                    exists x: Element; member(x, b) and apply(f, x) = numeral(n)
                    [using specialize covers(numeral(n)) top-in-big]
                  @with-preimage-x |
                    unpack x: Element from preimage-exists {
                      @preimage-facts |
                        member(x, b) and apply(f, x) = numeral(n)
                        [by hypothesis with-preimage-x]
                      @x-in-b |
                        member(x, b)
                        [by and_elim_left preimage-facts]
                      @conclusion-witness |
                        exists t: Element; member(t, b)
                        [by exists_intro(x) x-in-b]
                    }
                  @conclusion-preimage |
                    exists t: Element; member(t, b)
                    [by exists_elim with-preimage-x]
                }
              @conclusion-member |
                exists t: Element; member(t, b)
                [by exists_elim with-bijection-f]
            }
          @conclusion-implication |
            hasSize(b, succ(n)) -> exists t: Element; member(t, b)
            [by implies_intro given-size]
        }
      @discharge-n |
        forall n: Nat; hasSize(b, succ(n)) -> exists t: Element; member(t, b)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall b: Set; forall n: Nat; hasSize(b, succ(n)) -> exists t: Element; member(t, b)
    [by forall_intro generalize-b]
qed

// -- the three counting principles ------------------------------------------------------

// A SUBSET OF A FINITE SET IS FINITE, and no larger. Induction on the size n of the whole:
// remove a member t of the whole; if t is outside the subset, the subset sits inside the
// remainder (size n-1); if t is inside, remove it from the subset too, count the rest inside
// the remainder, and put t back.
theorem subsetOfFiniteIsFinite: forall n: Nat; forall b: Set; forall a: Set;
  hasSize(b, n) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, n)
proof
  // base case: the whole is empty, so the subset is empty, of size ZERO
  @base-case-proof |
    fix b: Set {
      @inner-base |
        fix a: Set {
          @given-size-zero |
            assume hasSize(b, ZERO) {
              @given-subset |
                assume subset(a, b) {
                  @b-has-size-zero |
                    hasSize(b, ZERO)
                    [by hypothesis given-size-zero]
                  @a-in-b |
                    forall x: Element; member(x, a) -> member(x, b)
                    [by hypothesis given-subset]
                  @b-is-empty |
                    b = emptyset
                    [using specialize sizeZeroIsEmpty(b) b-has-size-zero]
                  @a-in-empty |
                    forall x: Element; member(x, a) -> member(x, emptyset)
                    [by rewrite b-is-empty a-in-b]
                  @pointwise-backward |
                    fix x: Element {
                      @nothing-in-emptyset |
                        not member(x, emptyset)
                        [using specialize emptysetMember(x)]
                      @empty-into-a |
                        member(x, emptyset) -> member(x, a)
                        [using tautology nothing-in-emptyset]
                    }
                  @empty-in-a |
                    forall x: Element; member(x, emptyset) -> member(x, a)
                    [by forall_intro pointwise-backward]
                  @a-is-empty |
                    a = emptyset
                    [using specialize extensionality(a, emptyset) a-in-empty empty-in-a]
                  @empty-has-size-zero |
                    hasSize(emptyset, ZERO)
                    [by cite emptysetHasSizeZero]
                  @a-has-size-zero |
                    hasSize(a, ZERO)
                    [by rewrite a-is-empty empty-has-size-zero]
                  @zero-is-at-most-zero |
                    less_or_equal(ZERO, ZERO)
                    [using specialize lessOrEqualRefl(ZERO)]
                  @witness-clauses |
                    hasSize(a, ZERO) and less_or_equal(ZERO, ZERO)
                    [by and_intro a-has-size-zero zero-is-at-most-zero]
                  @conclusion-base-witness |
                    exists m: Nat; hasSize(a, m) and less_or_equal(m, ZERO)
                    [by exists_intro(ZERO) witness-clauses]
                }
              @conclusion-base-subset |
                subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, ZERO)
                [by implies_intro given-subset]
            }
          @conclusion-base-size |
            hasSize(b, ZERO) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, ZERO)
            [by implies_intro given-size-zero]
        }
      @discharge-base-a |
        forall a: Set; hasSize(b, ZERO) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, ZERO)
        [by forall_intro inner-base]
    }
  @base-case |
    forall b: Set; forall a: Set; hasSize(b, ZERO) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, ZERO)
    [by forall_intro base-case-proof]

  // inductive step: remove one member of the whole and count inside the remainder
  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume forall b: Set; forall a: Set; hasSize(b, k) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, k) {
          @inductive-hypothesis |
            forall b: Set; forall a: Set; hasSize(b, k) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, k)
            [by hypothesis given-inductive-hypothesis]
          @generalize-b |
            fix b: Set {
              @generalize-a |
                fix a: Set {
                  @given-size |
                    assume hasSize(b, succ(k)) {
                      @given-subset |
                        assume subset(a, b) {
                          @b-has-size |
                            hasSize(b, succ(k))
                            [by hypothesis given-size]
                          @a-in-b |
                            forall x: Element; member(x, a) -> member(x, b)
                            [by hypothesis given-subset]
                          @some-member-exists |
                            exists t: Element; member(t, b)
                            [using specialize sizedSetHasAMember(b, k) b-has-size]
                          @with-member-t |
                            unpack t: Element from some-member-exists {
                              @t-in-b |
                                member(t, b)
                                [by hypothesis with-member-t]
                              @rest-has-size-k |
                                hasSize(difference(b, singleton(t)), k)
                                [using specialize removingAnElementDropsTheSize(b, t, k) b-has-size t-in-b]
                              @t-in-a-or-not |
                                (not member(t, a)) or member(t, a)
                                [using tautology]
                              @conclusion-a-is-sized |
                                exists m: Nat; hasSize(a, m) and less_or_equal(m, succ(k))
                                case t-in-a-or-not {
                                  @when-t-outside-a |
                                    assume not member(t, a) {
                                      // a sits inside the remainder
                                      @t-not-in-a |
                                        not member(t, a)
                                        [by hypothesis when-t-outside-a]
                                      @pointwise-a-in-rest |
                                        fix x: Element {
                                          @given-x-in-a |
                                            assume member(x, a) {
                                              @x-in-a |
                                                member(x, a)
                                                [by hypothesis given-x-in-a]
                                              @x-in-b |
                                                member(x, b)
                                                [using specialize a-in-b(x) x-in-a]
                                              @x-is-not-t |
                                                x != t
                                                [using specialize memberIsNotTheOutsider(a, t, x) x-in-a t-not-in-a]
                                              @rest-membership |
                                                member(x, difference(b, singleton(t))) iff (member(x, b) and x != t)
                                                [using specialize differenceSingletonMember(b, t, x)]
                                              @conclusion-x-in-rest |
                                                member(x, difference(b, singleton(t)))
                                                [using tautology rest-membership x-in-b x-is-not-t]
                                            }
                                          @conclusion-a-into-rest |
                                            member(x, a) -> member(x, difference(b, singleton(t)))
                                            [by implies_intro given-x-in-a]
                                        }
                                      @a-in-rest |
                                        subset(a, difference(b, singleton(t)))
                                        [by forall_intro pointwise-a-in-rest]
                                      @a-sized-in-rest |
                                        exists m: Nat; hasSize(a, m) and less_or_equal(m, k)
                                        [using specialize inductive-hypothesis(difference(b, singleton(t)), a) rest-has-size-k a-in-rest]
                                      @with-size-m |
                                        unpack m: Nat from a-sized-in-rest {
                                          @size-facts |
                                            hasSize(a, m) and less_or_equal(m, k)
                                            [by hypothesis with-size-m]
                                          @a-has-size-m |
                                            hasSize(a, m)
                                            [by and_elim_left size-facts]
                                          @m-at-most-k |
                                            less_or_equal(m, k)
                                            [by and_elim_right size-facts]
                                          @m-below-succ-k |
                                            less_than(m, succ(k))
                                            [using specialize lessOrEqualToLessThanSucc(m, k) m-at-most-k]
                                          @m-at-most-succ-k |
                                            less_or_equal(m, succ(k))
                                            [using specialize lessThanToLessOrEqual(m, succ(k)) m-below-succ-k]
                                          @witness-clauses |
                                            hasSize(a, m) and less_or_equal(m, succ(k))
                                            [by and_intro a-has-size-m m-at-most-succ-k]
                                          @conclusion-witness-m |
                                            exists m2: Nat; hasSize(a, m2) and less_or_equal(m2, succ(k))
                                            [by exists_intro(m) witness-clauses]
                                        }
                                      @conclusion-t-outside |
                                        exists m2: Nat; hasSize(a, m2) and less_or_equal(m2, succ(k))
                                        [by exists_elim with-size-m]
                                    }
                                  @when-t-inside-a |
                                    assume member(t, a) {
                                      // remove t from a as well, count, and put it back
                                      @t-in-a |
                                        member(t, a)
                                        [by hypothesis when-t-inside-a]
                                      @pointwise-rest-in-rest |
                                        fix x: Element {
                                          @given-x-in-rest-of-a |
                                            assume member(x, difference(a, singleton(t))) {
                                              @x-in-rest-of-a |
                                                member(x, difference(a, singleton(t)))
                                                [by hypothesis given-x-in-rest-of-a]
                                              @a-rest-membership |
                                                member(x, difference(a, singleton(t))) iff (member(x, a) and x != t)
                                                [using specialize differenceSingletonMember(a, t, x)]
                                              @x-in-a |
                                                member(x, a)
                                                [using tautology a-rest-membership x-in-rest-of-a]
                                              @x-is-not-t |
                                                x != t
                                                [using tautology a-rest-membership x-in-rest-of-a]
                                              @x-in-b |
                                                member(x, b)
                                                [using specialize a-in-b(x) x-in-a]
                                              @b-rest-membership |
                                                member(x, difference(b, singleton(t))) iff (member(x, b) and x != t)
                                                [using specialize differenceSingletonMember(b, t, x)]
                                              @conclusion-x-in-rest-of-b |
                                                member(x, difference(b, singleton(t)))
                                                [using tautology b-rest-membership x-in-b x-is-not-t]
                                            }
                                          @conclusion-rest-into-rest |
                                            member(x, difference(a, singleton(t))) -> member(x, difference(b, singleton(t)))
                                            [by implies_intro given-x-in-rest-of-a]
                                        }
                                      @rest-of-a-in-rest-of-b |
                                        subset(difference(a, singleton(t)), difference(b, singleton(t)))
                                        [by forall_intro pointwise-rest-in-rest]
                                      @rest-of-a-sized |
                                        exists m: Nat; hasSize(difference(a, singleton(t)), m) and less_or_equal(m, k)
                                        [using specialize inductive-hypothesis(difference(b, singleton(t)), difference(a, singleton(t))) rest-has-size-k rest-of-a-in-rest-of-b]
                                      @with-size-m |
                                        unpack m: Nat from rest-of-a-sized {
                                          @size-facts |
                                            hasSize(difference(a, singleton(t)), m) and less_or_equal(m, k)
                                            [by hypothesis with-size-m]
                                          @rest-of-a-has-size-m |
                                            hasSize(difference(a, singleton(t)), m)
                                            [by and_elim_left size-facts]
                                          @m-at-most-k |
                                            less_or_equal(m, k)
                                            [by and_elim_right size-facts]
                                          @t-rest-membership |
                                            member(t, difference(a, singleton(t))) iff (member(t, a) and t != t)
                                            [using specialize differenceSingletonMember(a, t, t)]
                                          @t-is-t |
                                            t = t
                                            [by reflexivity]
                                          @t-not-in-rest-of-a |
                                            not member(t, difference(a, singleton(t)))
                                            [using tautology t-rest-membership t-is-t]
                                          @restored-has-size |
                                            hasSize(union(difference(a, singleton(t)), singleton(t)), succ(m))
                                            [using specialize addingAnElementRaisesTheSize(difference(a, singleton(t)), t, m) rest-of-a-has-size-m t-not-in-rest-of-a]
                                          @restored-is-a |
                                            union(difference(a, singleton(t)), singleton(t)) = a
                                            [using specialize restoringAnElement(a, t) t-in-a]
                                          @a-has-size-succ-m |
                                            hasSize(a, succ(m))
                                            [by rewrite restored-is-a restored-has-size]
                                          @m-below-succ-k |
                                            less_than(m, succ(k))
                                            [using specialize lessOrEqualToLessThanSucc(m, k) m-at-most-k]
                                          @succ-m-below-succ-succ-k |
                                            less_than(succ(m), succ(succ(k)))
                                            [using specialize succPreservesOrder(m, succ(k)) m-below-succ-k]
                                          @succ-m-at-most-succ-k |
                                            less_or_equal(succ(m), succ(k))
                                            [using specialize lessThanSuccToLessOrEqual(succ(m), succ(k)) succ-m-below-succ-succ-k]
                                          @witness-clauses |
                                            hasSize(a, succ(m)) and less_or_equal(succ(m), succ(k))
                                            [by and_intro a-has-size-succ-m succ-m-at-most-succ-k]
                                          @conclusion-witness-succ-m |
                                            exists m2: Nat; hasSize(a, m2) and less_or_equal(m2, succ(k))
                                            [by exists_intro(succ(m)) witness-clauses]
                                        }
                                      @conclusion-t-inside |
                                        exists m2: Nat; hasSize(a, m2) and less_or_equal(m2, succ(k))
                                        [by exists_elim with-size-m]
                                    }
                                }
                            }
                          @conclusion-with-member |
                            exists m: Nat; hasSize(a, m) and less_or_equal(m, succ(k))
                            [by exists_elim with-member-t]
                        }
                      @conclusion-step-subset |
                        subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, succ(k))
                        [by implies_intro given-subset]
                    }
                  @conclusion-step-size |
                    hasSize(b, succ(k)) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, succ(k))
                    [by implies_intro given-size]
                }
              @discharge-a |
                forall a: Set; hasSize(b, succ(k)) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, succ(k))
                [by forall_intro generalize-a]
            }
          @discharge-b |
            forall b: Set; forall a: Set; hasSize(b, succ(k)) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, succ(k))
            [by forall_intro generalize-b]
        }
      @induction-step-at-k |
        (forall b: Set; forall a: Set; hasSize(b, k) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, k)) -> (forall b: Set; forall a: Set; hasSize(b, succ(k)) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, succ(k)))
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; (forall b: Set; forall a: Set; hasSize(b, k) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, k)) -> (forall b: Set; forall a: Set; hasSize(b, succ(k)) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, succ(k)))
    [by forall_intro induction-step]
  @conclusion |
    forall n: Nat; forall b: Set; forall a: Set; hasSize(b, n) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, n)
    [using instantiation induction((fun k: Nat => forall b: Set; forall a: Set; hasSize(b, k) -> subset(a, b) -> exists m: Nat; hasSize(a, m) and less_or_equal(m, k))) base-case induction-step-for-all-k]
qed

// A PROPER SUBSET IS STRICTLY SMALLER: it misses some t of the whole, so it sits inside the
// whole with t removed, which has one fewer element.
theorem properSubsetIsSmaller: forall a: Set; forall b: Set; forall m: Nat; forall n: Nat;
  subset(a, b) -> a != b -> hasSize(a, m) -> hasSize(b, n) -> less_than(m, n)
proof
  @generalize-a |
    fix a: Set {
      @generalize-b |
        fix b: Set {
          @generalize-m |
            fix m: Nat {
              @generalize-n |
                fix n: Nat {
                  @given-subset |
                    assume subset(a, b) {
                      @given-proper |
                        assume a != b {
                          @given-size-a |
                            assume hasSize(a, m) {
                              @given-size-b |
                                assume hasSize(b, n) {
                                  @a-in-b |
                                    subset(a, b)
                                    [by hypothesis given-subset]
                                  @proper |
                                    a != b
                                    [by hypothesis given-proper]
                                  @a-has-size-m |
                                    hasSize(a, m)
                                    [by hypothesis given-size-a]
                                  @b-has-size-n |
                                    hasSize(b, n)
                                    [by hypothesis given-size-b]
                                  @outsider-exists |
                                    exists t: Element; member(t, b) and (not member(t, a))
                                    [using specialize properSubsetHasAnOutsider(a, b) a-in-b proper]
                                  @with-outsider-t |
                                    unpack t: Element from outsider-exists {
                                      @outsider-facts |
                                        member(t, b) and (not member(t, a))
                                        [by hypothesis with-outsider-t]
                                      @t-in-b |
                                        member(t, b)
                                        [by and_elim_left outsider-facts]
                                      @t-not-in-a |
                                        not member(t, a)
                                        [by and_elim_right outsider-facts]
                                      @n-is-zero-or-a-successor |
                                        n = ZERO or (exists k: Nat; n = succ(k))
                                        [using specialize zeroOrSucc(n)]
                                      @conclusion-m-below-n |
                                        less_than(m, n)
                                        case n-is-zero-or-a-successor {
                                          @when-zero |
                                            assume n = ZERO {
                                              // b would be empty, yet t is in it
                                              @n-is-zero |
                                                n = ZERO
                                                [by hypothesis when-zero]
                                              @b-has-size-zero |
                                                hasSize(b, ZERO)
                                                [by rewrite n-is-zero b-has-size-n]
                                              @b-is-empty |
                                                b = emptyset
                                                [using specialize sizeZeroIsEmpty(b) b-has-size-zero]
                                              @t-in-emptyset |
                                                member(t, emptyset)
                                                [by rewrite b-is-empty t-in-b]
                                              @nothing-in-emptyset |
                                                not member(t, emptyset)
                                                [using specialize emptysetMember(t)]
                                              @conclusion-absurd |
                                                less_than(m, n)
                                                [by absurd t-in-emptyset nothing-in-emptyset]
                                            }
                                          @when-successor |
                                            assume exists k: Nat; n = succ(k) {
                                              @successor-exists |
                                                exists k: Nat; n = succ(k)
                                                [by hypothesis when-successor]
                                              @with-predecessor-k |
                                                unpack k: Nat from successor-exists {
                                                  @n-is-succ-k |
                                                    n = succ(k)
                                                    [by hypothesis with-predecessor-k]
                                                  @b-has-size-succ-k |
                                                    hasSize(b, succ(k))
                                                    [by rewrite n-is-succ-k b-has-size-n]
                                                  @rest-has-size-k |
                                                    hasSize(difference(b, singleton(t)), k)
                                                    [using specialize removingAnElementDropsTheSize(b, t, k) b-has-size-succ-k t-in-b]
                                                  @pointwise-a-in-rest |
                                                    fix x: Element {
                                                      @given-x-in-a |
                                                        assume member(x, a) {
                                                          @x-in-a |
                                                            member(x, a)
                                                            [by hypothesis given-x-in-a]
                                                          @x-in-b |
                                                            member(x, b)
                                                            [using specialize a-in-b(x) x-in-a]
                                                          @x-is-not-t |
                                                            x != t
                                                            [using specialize memberIsNotTheOutsider(a, t, x) x-in-a t-not-in-a]
                                                          @rest-membership |
                                                            member(x, difference(b, singleton(t))) iff (member(x, b) and x != t)
                                                            [using specialize differenceSingletonMember(b, t, x)]
                                                          @conclusion-x-in-rest |
                                                            member(x, difference(b, singleton(t)))
                                                            [using tautology rest-membership x-in-b x-is-not-t]
                                                        }
                                                      @conclusion-a-into-rest |
                                                        member(x, a) -> member(x, difference(b, singleton(t)))
                                                        [by implies_intro given-x-in-a]
                                                    }
                                                  @a-in-rest |
                                                    subset(a, difference(b, singleton(t)))
                                                    [by forall_intro pointwise-a-in-rest]
                                                  @a-sized-in-rest |
                                                    exists m2: Nat; hasSize(a, m2) and less_or_equal(m2, k)
                                                    [using specialize subsetOfFiniteIsFinite(k, difference(b, singleton(t)), a) rest-has-size-k a-in-rest]
                                                  @with-size-m2 |
                                                    unpack m2: Nat from a-sized-in-rest {
                                                      @size-facts |
                                                        hasSize(a, m2) and less_or_equal(m2, k)
                                                        [by hypothesis with-size-m2]
                                                      @a-has-size-m2 |
                                                        hasSize(a, m2)
                                                        [by and_elim_left size-facts]
                                                      @m2-at-most-k |
                                                        less_or_equal(m2, k)
                                                        [by and_elim_right size-facts]
                                                      @m-is-m2 |
                                                        m = m2
                                                        [using specialize hasSizeIsUnique(a, m, m2) a-has-size-m a-has-size-m2]
                                                      @m-at-most-k |
                                                        less_or_equal(m, k)
                                                        [by rewrite m-is-m2 m2-at-most-k]
                                                      @m-below-succ-k |
                                                        less_than(m, succ(k))
                                                        [using specialize lessOrEqualToLessThanSucc(m, k) m-at-most-k]
                                                      @conclusion-m-below-n-at-k |
                                                        less_than(m, n)
                                                        [by rewrite n-is-succ-k m-below-succ-k]
                                                    }
                                                  @conclusion-with-size |
                                                    less_than(m, n)
                                                    [by exists_elim with-size-m2]
                                                }
                                              @conclusion-successor |
                                                less_than(m, n)
                                                [by exists_elim with-predecessor-k]
                                            }
                                        }
                                    }
                                  @conclusion-with-outsider |
                                    less_than(m, n)
                                    [by exists_elim with-outsider-t]
                                }
                              @conclusion-size-b |
                                hasSize(b, n) -> less_than(m, n)
                                [by implies_intro given-size-b]
                            }
                          @conclusion-size-a |
                            hasSize(a, m) -> hasSize(b, n) -> less_than(m, n)
                            [by implies_intro given-size-a]
                        }
                      @conclusion-proper |
                        a != b -> hasSize(a, m) -> hasSize(b, n) -> less_than(m, n)
                        [by implies_intro given-proper]
                    }
                  @conclusion-subset |
                    subset(a, b) -> a != b -> hasSize(a, m) -> hasSize(b, n) -> less_than(m, n)
                    [by implies_intro given-subset]
                }
              @discharge-n |
                forall n: Nat; subset(a, b) -> a != b -> hasSize(a, m) -> hasSize(b, n) -> less_than(m, n)
                [by forall_intro generalize-n]
            }
          @discharge-m |
            forall m: Nat; forall n: Nat; subset(a, b) -> a != b -> hasSize(a, m) -> hasSize(b, n) -> less_than(m, n)
            [by forall_intro generalize-m]
        }
      @discharge-b |
        forall b: Set; forall m: Nat; forall n: Nat; subset(a, b) -> a != b -> hasSize(a, m) -> hasSize(b, n) -> less_than(m, n)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a: Set; forall b: Set; forall m: Nat; forall n: Nat;
      subset(a, b) -> a != b -> hasSize(a, m) -> hasSize(b, n) -> less_than(m, n)
    [by forall_intro generalize-a]
qed

// DISJOINT SIZES ADD: |a ∪ b| = |a| + |b| when a and b share nothing. Induction on |b|:
// split one member t off b, count a ∪ (b \ {t}) by the hypothesis, and add t back — it is
// new to that union, since it is in b (so not in a) and not in b \ {t}.
theorem disjointUnionSizesAdd: forall a: Set; forall m: Nat; hasSize(a, m) ->
  forall n: Nat; forall b: Set; hasSize(b, n) -> intersection(a, b) = emptyset ->
  hasSize(union(a, b), add(m, n))
proof
  @generalize-a |
    fix a: Set {
      @generalize-m |
        fix m: Nat {
          @given-size-a |
            assume hasSize(a, m) {
              @a-has-size-m |
                hasSize(a, m)
                [by hypothesis given-size-a]

              // base case: b is empty, so a ∪ b = a and m + 0 = m
              @base-case-proof |
                fix b: Set {
                  @given-size-zero |
                    assume hasSize(b, ZERO) {
                      @given-disjoint-zero |
                        assume intersection(a, b) = emptyset {
                          @b-has-size-zero |
                            hasSize(b, ZERO)
                            [by hypothesis given-size-zero]
                          @b-is-empty |
                            b = emptyset
                            [using specialize sizeZeroIsEmpty(b) b-has-size-zero]
                          @union-with-empty |
                            union(a, emptyset) = a
                            [using specialize unionEmpty(a)]
                          @union-is-a |
                            union(a, b) = a
                            [by rewrite b-is-empty union-with-empty]
                          @m-plus-zero |
                            add(m, ZERO) = m
                            [using specialize addZeroRight(m)]
                          @union-has-size-m |
                            hasSize(union(a, b), m)
                            [by rewrite union-is-a a-has-size-m]
                          @conclusion-base-size |
                            hasSize(union(a, b), add(m, ZERO))
                            [by rewrite m-plus-zero union-has-size-m]
                        }
                      @conclusion-base-disjoint |
                        intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, ZERO))
                        [by implies_intro given-disjoint-zero]
                    }
                  @conclusion-base-implication |
                    hasSize(b, ZERO) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, ZERO))
                    [by implies_intro given-size-zero]
                }
              @base-case |
                forall b: Set; hasSize(b, ZERO) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, ZERO))
                [by forall_intro base-case-proof]

              // inductive step
              @induction-step |
                fix k: Nat {
                  @given-inductive-hypothesis |
                    assume forall b: Set; hasSize(b, k) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, k)) {
                      @inductive-hypothesis |
                        forall b: Set; hasSize(b, k) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, k))
                        [by hypothesis given-inductive-hypothesis]
                      @generalize-b |
                        fix b: Set {
                          @given-size |
                            assume hasSize(b, succ(k)) {
                              @given-disjoint |
                                assume intersection(a, b) = emptyset {
                                  @b-has-size |
                                    hasSize(b, succ(k))
                                    [by hypothesis given-size]
                                  @disjoint |
                                    intersection(a, b) = emptyset
                                    [by hypothesis given-disjoint]
                                  @some-member-exists |
                                    exists t: Element; member(t, b)
                                    [using specialize sizedSetHasAMember(b, k) b-has-size]
                                  @with-member-t |
                                    unpack t: Element from some-member-exists {
                                      @t-in-b |
                                        member(t, b)
                                        [by hypothesis with-member-t]
                                      @rest-has-size-k |
                                        hasSize(difference(b, singleton(t)), k)
                                        [using specialize removingAnElementDropsTheSize(b, t, k) b-has-size t-in-b]
                                      @rest-in-b |
                                        subset(difference(b, singleton(t)), b)
                                        [using specialize removalLeavesASubset(b, t)]
                                      @disjoint-with-rest |
                                        intersection(a, difference(b, singleton(t))) = emptyset
                                        [using specialize disjointWithSubset(a, b, difference(b, singleton(t))) disjoint rest-in-b]
                                      @union-with-rest-has-size |
                                        hasSize(union(a, difference(b, singleton(t))), add(m, k))
                                        [using specialize inductive-hypothesis(difference(b, singleton(t))) rest-has-size-k disjoint-with-rest]
                                      // t is new to a ∪ (b \ {t})
                                      @t-not-in-a |
                                        not member(t, a)
                                        [using specialize disjointMeansNotBoth(a, b, t) disjoint t-in-b]
                                      @t-rest-membership |
                                        member(t, difference(b, singleton(t))) iff (member(t, b) and t != t)
                                        [using specialize differenceSingletonMember(b, t, t)]
                                      @t-is-t |
                                        t = t
                                        [by reflexivity]
                                      @t-not-in-rest |
                                        not member(t, difference(b, singleton(t)))
                                        [using tautology t-rest-membership t-is-t]
                                      @union-membership-at-t |
                                        member(t, union(a, difference(b, singleton(t)))) iff (member(t, a) or member(t, difference(b, singleton(t))))
                                        [using specialize unionMember(a, difference(b, singleton(t)), t)]
                                      @t-not-in-the-union |
                                        not member(t, union(a, difference(b, singleton(t))))
                                        [using tautology union-membership-at-t t-not-in-a t-not-in-rest]
                                      @enlarged-has-size |
                                        hasSize(union(union(a, difference(b, singleton(t))), singleton(t)), succ(add(m, k)))
                                        [using specialize addingAnElementRaisesTheSize(union(a, difference(b, singleton(t))), t, add(m, k)) union-with-rest-has-size t-not-in-the-union]
                                      @split-is-the-union |
                                        union(union(a, difference(b, singleton(t))), singleton(t)) = union(a, b)
                                        [using specialize splittingOffAnElement(a, b, t) t-in-b]
                                      @union-has-size |
                                        hasSize(union(a, b), succ(add(m, k)))
                                        [by rewrite split-is-the-union enlarged-has-size]
                                      @sum-at-successor |
                                        add(m, succ(k)) = succ(add(m, k))
                                        [using specialize addSuccRight(m, k)]
                                      @conclusion-step-size |
                                        hasSize(union(a, b), add(m, succ(k)))
                                        [by rewrite sum-at-successor union-has-size]
                                    }
                                  @conclusion-with-member |
                                    hasSize(union(a, b), add(m, succ(k)))
                                    [by exists_elim with-member-t]
                                }
                              @conclusion-step-disjoint |
                                intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, succ(k)))
                                [by implies_intro given-disjoint]
                            }
                          @conclusion-step-implication |
                            hasSize(b, succ(k)) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, succ(k)))
                            [by implies_intro given-size]
                        }
                      @discharge-b |
                        forall b: Set; hasSize(b, succ(k)) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, succ(k)))
                        [by forall_intro generalize-b]
                    }
                  @induction-step-at-k |
                    (forall b: Set; hasSize(b, k) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, k))) -> (forall b: Set; hasSize(b, succ(k)) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, succ(k))))
                    [by implies_intro given-inductive-hypothesis]
                }
              @induction-step-for-all-k |
                forall k: Nat; (forall b: Set; hasSize(b, k) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, k))) -> (forall b: Set; hasSize(b, succ(k)) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, succ(k))))
                [by forall_intro induction-step]
              @conclusion-for-all-n |
                forall n: Nat; forall b: Set; hasSize(b, n) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, n))
                [using instantiation induction((fun k: Nat => forall b: Set; hasSize(b, k) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, k)))) base-case induction-step-for-all-k]
            }
          @conclusion-size-a |
            hasSize(a, m) -> forall n: Nat; forall b: Set; hasSize(b, n) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, n))
            [by implies_intro given-size-a]
        }
      @discharge-m |
        forall m: Nat; hasSize(a, m) -> forall n: Nat; forall b: Set; hasSize(b, n) -> intersection(a, b) = emptyset -> hasSize(union(a, b), add(m, n))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall a: Set; forall m: Nat; hasSize(a, m) ->
      forall n: Nat; forall b: Set; hasSize(b, n) -> intersection(a, b) = emptyset ->
      hasSize(union(a, b), add(m, n))
    [by forall_intro generalize-a]
qed

// -- the pigeonhole principle -------------------------------------------------------------
//
// A map from a set of size n+1 into a set of size n sends two DIFFERENT points to the same
// place. Induction on n: the smaller set is empty at the base, so the larger set's member has
// nowhere to go; at the step, take a member t of the larger set and its image u — either
// some other point already shares the image u (a collision), or removing t and u leaves a
// map from size n+1 into size n, and the hypothesis finds a collision there.
theorem pigeonhole: forall n: Nat; forall a: Set; forall b: Set; forall g: Fn;
  hasSize(a, succ(n)) -> hasSize(b, n) -> mapsInto(g, a, b) ->
  exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
proof
  // base case: b is empty, so a's member has no image
  @base-case-proof |
    fix a: Set {
      @inner-b |
        fix b: Set {
          @inner-g |
            fix g: Fn {
              @given-size-a |
                assume hasSize(a, succ(ZERO)) {
                  @given-size-b |
                    assume hasSize(b, ZERO) {
                      @given-into |
                        assume mapsInto(g, a, b) {
                          @a-has-size-one |
                            hasSize(a, succ(ZERO))
                            [by hypothesis given-size-a]
                          @b-has-size-zero |
                            hasSize(b, ZERO)
                            [by hypothesis given-size-b]
                          @into |
                            forall x: Element; member(x, a) -> member(apply(g, x), b)
                            [by hypothesis given-into]
                          @b-is-empty |
                            b = emptyset
                            [using specialize sizeZeroIsEmpty(b) b-has-size-zero]
                          @some-member-exists |
                            exists t: Element; member(t, a)
                            [using specialize sizedSetHasAMember(a, ZERO) a-has-size-one]
                          @with-member-t |
                            unpack t: Element from some-member-exists {
                              @t-in-a |
                                member(t, a)
                                [by hypothesis with-member-t]
                              @image-in-b |
                                member(apply(g, t), b)
                                [using specialize into(t) t-in-a]
                              @image-in-emptyset |
                                member(apply(g, t), emptyset)
                                [by rewrite b-is-empty image-in-b]
                              @nothing-in-emptyset |
                                not member(apply(g, t), emptyset)
                                [using specialize emptysetMember(apply(g, t))]
                              @conclusion-absurd |
                                exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                                [by absurd image-in-emptyset nothing-in-emptyset]
                            }
                          @conclusion-base-collision |
                            exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                            [by exists_elim with-member-t]
                        }
                      @conclusion-base-into |
                        mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                        [by implies_intro given-into]
                    }
                  @conclusion-base-size-b |
                    hasSize(b, ZERO) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                    [by implies_intro given-size-b]
                }
              @conclusion-base-size-a |
                hasSize(a, succ(ZERO)) -> hasSize(b, ZERO) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                [by implies_intro given-size-a]
            }
          @discharge-base-g |
            forall g: Fn; hasSize(a, succ(ZERO)) -> hasSize(b, ZERO) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
            [by forall_intro inner-g]
        }
      @discharge-base-b |
        forall b: Set; forall g: Fn; hasSize(a, succ(ZERO)) -> hasSize(b, ZERO) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
        [by forall_intro inner-b]
    }
  @base-case |
    forall a: Set; forall b: Set; forall g: Fn; hasSize(a, succ(ZERO)) -> hasSize(b, ZERO) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
    [by forall_intro base-case-proof]

  // inductive step
  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume forall a: Set; forall b: Set; forall g: Fn; hasSize(a, succ(k)) -> hasSize(b, k) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y) {
          @inductive-hypothesis |
            forall a: Set; forall b: Set; forall g: Fn; hasSize(a, succ(k)) -> hasSize(b, k) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
            [by hypothesis given-inductive-hypothesis]
          @generalize-a |
            fix a: Set {
              @generalize-b |
                fix b: Set {
                  @generalize-g |
                    fix g: Fn {
                      @given-size-a |
                        assume hasSize(a, succ(succ(k))) {
                          @given-size-b |
                            assume hasSize(b, succ(k)) {
                              @given-into |
                                assume mapsInto(g, a, b) {
                                  @a-has-size |
                                    hasSize(a, succ(succ(k)))
                                    [by hypothesis given-size-a]
                                  @b-has-size |
                                    hasSize(b, succ(k))
                                    [by hypothesis given-size-b]
                                  @into |
                                    forall x: Element; member(x, a) -> member(apply(g, x), b)
                                    [by hypothesis given-into]
                                  @some-member-exists |
                                    exists t: Element; member(t, a)
                                    [using specialize sizedSetHasAMember(a, succ(k)) a-has-size]
                                  @with-member-t |
                                    unpack t: Element from some-member-exists {
                                      @t-in-a |
                                        member(t, a)
                                        [by hypothesis with-member-t]
                                      @image-of-t-in-b |
                                        member(apply(g, t), b)
                                        [using specialize into(t) t-in-a]
                                      @rest-of-a-has-size |
                                        hasSize(difference(a, singleton(t)), succ(k))
                                        [using specialize removingAnElementDropsTheSize(a, t, succ(k)) a-has-size t-in-a]
                                      @rest-of-b-has-size |
                                        hasSize(difference(b, singleton(apply(g, t))), k)
                                        [using specialize removingAnElementDropsTheSize(b, apply(g, t), k) b-has-size image-of-t-in-b]
                                      @shares-image-or-not |
                                        (exists x: Element; member(x, difference(a, singleton(t))) and apply(g, x) = apply(g, t)) or (not (exists x: Element; member(x, difference(a, singleton(t))) and apply(g, x) = apply(g, t)))
                                        [using tautology]
                                      @conclusion-collision |
                                        exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                                        case shares-image-or-not {
                                          @when-shared |
                                            assume exists x: Element; member(x, difference(a, singleton(t))) and apply(g, x) = apply(g, t) {
                                              // some other point already collides with t
                                              @sharer-exists |
                                                exists x: Element; member(x, difference(a, singleton(t))) and apply(g, x) = apply(g, t)
                                                [by hypothesis when-shared]
                                              @with-sharer-x |
                                                unpack x: Element from sharer-exists {
                                                  @sharer-facts |
                                                    member(x, difference(a, singleton(t))) and apply(g, x) = apply(g, t)
                                                    [by hypothesis with-sharer-x]
                                                  @x-in-rest |
                                                    member(x, difference(a, singleton(t)))
                                                    [by and_elim_left sharer-facts]
                                                  @x-shares-image |
                                                    apply(g, x) = apply(g, t)
                                                    [by and_elim_right sharer-facts]
                                                  @rest-membership |
                                                    member(x, difference(a, singleton(t))) iff (member(x, a) and x != t)
                                                    [using specialize differenceSingletonMember(a, t, x)]
                                                  @x-in-a |
                                                    member(x, a)
                                                    [using tautology rest-membership x-in-rest]
                                                  @x-is-not-t |
                                                    x != t
                                                    [using tautology rest-membership x-in-rest]
                                                  @both-in-a |
                                                    member(x, a) and member(t, a)
                                                    [by and_intro x-in-a t-in-a]
                                                  @both-in-and-different |
                                                    member(x, a) and member(t, a) and x != t
                                                    [by and_intro both-in-a x-is-not-t]
                                                  @collision-clauses |
                                                    member(x, a) and member(t, a) and x != t and apply(g, x) = apply(g, t)
                                                    [by and_intro both-in-and-different x-shares-image]
                                                  @inner-witness |
                                                    exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                                                    [by exists_intro(t) collision-clauses]
                                                  @conclusion-witness-pair |
                                                    exists x2: Element; exists y: Element; member(x2, a) and member(y, a) and x2 != y and apply(g, x2) = apply(g, y)
                                                    [by exists_intro(x) inner-witness]
                                                }
                                              @conclusion-shared |
                                                exists x2: Element; exists y: Element; member(x2, a) and member(y, a) and x2 != y and apply(g, x2) = apply(g, y)
                                                [by exists_elim with-sharer-x]
                                            }
                                          @when-unshared |
                                            assume not (exists x: Element; member(x, difference(a, singleton(t))) and apply(g, x) = apply(g, t)) {
                                              // nothing else hits u = g(t), so g maps a \ {t} into b \ {u}
                                              @no-sharer |
                                                not (exists x: Element; member(x, difference(a, singleton(t))) and apply(g, x) = apply(g, t))
                                                [by hypothesis when-unshared]
                                              @pointwise-into-rest |
                                                fix x: Element {
                                                  @given-x-in-rest |
                                                    assume member(x, difference(a, singleton(t))) {
                                                      @x-in-rest |
                                                        member(x, difference(a, singleton(t)))
                                                        [by hypothesis given-x-in-rest]
                                                      @rest-membership |
                                                        member(x, difference(a, singleton(t))) iff (member(x, a) and x != t)
                                                        [using specialize differenceSingletonMember(a, t, x)]
                                                      @x-in-a |
                                                        member(x, a)
                                                        [using tautology rest-membership x-in-rest]
                                                      @image-in-b |
                                                        member(apply(g, x), b)
                                                        [using specialize into(x) x-in-a]
                                                      @suppose-x-shares-image |
                                                        assume apply(g, x) = apply(g, t) {
                                                          @x-shares-image |
                                                            apply(g, x) = apply(g, t)
                                                            [by hypothesis suppose-x-shares-image]
                                                          @x-is-a-sharer |
                                                            member(x, difference(a, singleton(t))) and apply(g, x) = apply(g, t)
                                                            [by and_intro x-in-rest x-shares-image]
                                                          @a-sharer-exists |
                                                            exists x2: Element; member(x2, difference(a, singleton(t))) and apply(g, x2) = apply(g, t)
                                                            [by exists_intro(x) x-is-a-sharer]
                                                        }
                                                      @image-is-not-u |
                                                        apply(g, x) != apply(g, t)
                                                        [by not_intro suppose-x-shares-image a-sharer-exists no-sharer]
                                                      @rest-of-b-membership |
                                                        member(apply(g, x), difference(b, singleton(apply(g, t)))) iff (member(apply(g, x), b) and apply(g, x) != apply(g, t))
                                                        [using specialize differenceSingletonMember(b, apply(g, t), apply(g, x))]
                                                      @conclusion-image-in-rest-of-b |
                                                        member(apply(g, x), difference(b, singleton(apply(g, t))))
                                                        [using tautology rest-of-b-membership image-in-b image-is-not-u]
                                                    }
                                                  @conclusion-into-rest-implication |
                                                    member(x, difference(a, singleton(t))) -> member(apply(g, x), difference(b, singleton(apply(g, t))))
                                                    [by implies_intro given-x-in-rest]
                                                }
                                              @g-maps-rest-into-rest |
                                                mapsInto(g, difference(a, singleton(t)), difference(b, singleton(apply(g, t))))
                                                [by forall_intro pointwise-into-rest]
                                              @collision-in-rest |
                                                exists x: Element; exists y: Element; member(x, difference(a, singleton(t))) and member(y, difference(a, singleton(t))) and x != y and apply(g, x) = apply(g, y)
                                                [using specialize inductive-hypothesis(difference(a, singleton(t)), difference(b, singleton(apply(g, t))), g) rest-of-a-has-size rest-of-b-has-size g-maps-rest-into-rest]
                                              @with-colliding-x |
                                                unpack x: Element from collision-in-rest {
                                                  @inner-collision |
                                                    exists y: Element; member(x, difference(a, singleton(t))) and member(y, difference(a, singleton(t))) and x != y and apply(g, x) = apply(g, y)
                                                    [by hypothesis with-colliding-x]
                                                  @with-colliding-y |
                                                    unpack y: Element from inner-collision {
                                                      @collision-facts |
                                                        member(x, difference(a, singleton(t))) and member(y, difference(a, singleton(t))) and x != y and apply(g, x) = apply(g, y)
                                                        [by hypothesis with-colliding-y]
                                                      @first-three |
                                                        member(x, difference(a, singleton(t))) and member(y, difference(a, singleton(t))) and x != y
                                                        [by and_elim_left collision-facts]
                                                      @same-image |
                                                        apply(g, x) = apply(g, y)
                                                        [by and_elim_right collision-facts]
                                                      @both-in-rest |
                                                        member(x, difference(a, singleton(t))) and member(y, difference(a, singleton(t)))
                                                        [by and_elim_left first-three]
                                                      @different |
                                                        x != y
                                                        [by and_elim_right first-three]
                                                      @x-in-rest |
                                                        member(x, difference(a, singleton(t)))
                                                        [by and_elim_left both-in-rest]
                                                      @y-in-rest |
                                                        member(y, difference(a, singleton(t)))
                                                        [by and_elim_right both-in-rest]
                                                      @x-rest-membership |
                                                        member(x, difference(a, singleton(t))) iff (member(x, a) and x != t)
                                                        [using specialize differenceSingletonMember(a, t, x)]
                                                      @y-rest-membership |
                                                        member(y, difference(a, singleton(t))) iff (member(y, a) and y != t)
                                                        [using specialize differenceSingletonMember(a, t, y)]
                                                      @x-in-a |
                                                        member(x, a)
                                                        [using tautology x-rest-membership x-in-rest]
                                                      @y-in-a |
                                                        member(y, a)
                                                        [using tautology y-rest-membership y-in-rest]
                                                      @both-in-a |
                                                        member(x, a) and member(y, a)
                                                        [by and_intro x-in-a y-in-a]
                                                      @both-in-and-different |
                                                        member(x, a) and member(y, a) and x != y
                                                        [by and_intro both-in-a different]
                                                      @collision-clauses |
                                                        member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                                                        [by and_intro both-in-and-different same-image]
                                                      @inner-witness |
                                                        exists y2: Element; member(x, a) and member(y2, a) and x != y2 and apply(g, x) = apply(g, y2)
                                                        [by exists_intro(y) collision-clauses]
                                                      @conclusion-witness-pair |
                                                        exists x2: Element; exists y2: Element; member(x2, a) and member(y2, a) and x2 != y2 and apply(g, x2) = apply(g, y2)
                                                        [by exists_intro(x) inner-witness]
                                                    }
                                                  @conclusion-with-x |
                                                    exists x2: Element; exists y2: Element; member(x2, a) and member(y2, a) and x2 != y2 and apply(g, x2) = apply(g, y2)
                                                    [by exists_elim with-colliding-y]
                                                }
                                              @conclusion-unshared |
                                                exists x2: Element; exists y2: Element; member(x2, a) and member(y2, a) and x2 != y2 and apply(g, x2) = apply(g, y2)
                                                [by exists_elim with-colliding-x]
                                            }
                                        }
                                    }
                                  @conclusion-with-member |
                                    exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                                    [by exists_elim with-member-t]
                                }
                              @conclusion-step-into |
                                mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                                [by implies_intro given-into]
                            }
                          @conclusion-step-size-b |
                            hasSize(b, succ(k)) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                            [by implies_intro given-size-b]
                        }
                      @conclusion-step-size-a |
                        hasSize(a, succ(succ(k))) -> hasSize(b, succ(k)) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                        [by implies_intro given-size-a]
                    }
                  @discharge-g |
                    forall g: Fn; hasSize(a, succ(succ(k))) -> hasSize(b, succ(k)) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                    [by forall_intro generalize-g]
                }
              @discharge-b |
                forall b: Set; forall g: Fn; hasSize(a, succ(succ(k))) -> hasSize(b, succ(k)) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
                [by forall_intro generalize-b]
            }
          @discharge-a |
            forall a: Set; forall b: Set; forall g: Fn; hasSize(a, succ(succ(k))) -> hasSize(b, succ(k)) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
            [by forall_intro generalize-a]
        }
      @induction-step-at-k |
        (forall a: Set; forall b: Set; forall g: Fn; hasSize(a, succ(k)) -> hasSize(b, k) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)) -> (forall a: Set; forall b: Set; forall g: Fn; hasSize(a, succ(succ(k))) -> hasSize(b, succ(k)) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y))
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; (forall a: Set; forall b: Set; forall g: Fn; hasSize(a, succ(k)) -> hasSize(b, k) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)) -> (forall a: Set; forall b: Set; forall g: Fn; hasSize(a, succ(succ(k))) -> hasSize(b, succ(k)) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y))
    [by forall_intro induction-step]
  @conclusion |
    forall n: Nat; forall a: Set; forall b: Set; forall g: Fn;
      hasSize(a, succ(n)) -> hasSize(b, n) -> mapsInto(g, a, b) ->
      exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y)
    [using instantiation induction((fun k: Nat => forall a: Set; forall b: Set; forall g: Fn; hasSize(a, succ(k)) -> hasSize(b, k) -> mapsInto(g, a, b) -> exists x: Element; exists y: Element; member(x, a) and member(y, a) and x != y and apply(g, x) = apply(g, y))) base-case induction-step-for-all-k]
qed
