// Worked example for `std/field.bpa`'s nondegeneracy axiom.
//
// Why this file exists: `oneNotZero` is what stops the one-element ring from counting as
// a field. Every concrete field discharges it when modeling this theory, but no theorem
// in `field.bpa` cites it, so nothing here ever depends on the field being nontrivial.
import field <<< "std/field.bpa"

sort Field = field.Field
const ZERO = field.ZERO
const ONE = field.ONE
func mul = field.mul
func recip = field.recip

axiom oneNotZero = field.oneNotZero
axiom fieldInverse = field.fieldInverse

// Because 1 ≠ 0, the inverse axiom applies AT one: 1 · 1⁻¹ = 1. A degenerate "field"
// where 1 = 0 could not take this step, which is exactly what the axiom rules out.
theorem oneHasAnInverse: mul(ONE, recip(ONE)) = ONE
proof
  @one-is-not-zero |
    ONE != ZERO
    [by cite oneNotZero]
  @conclusion |
    mul(ONE, recip(ONE)) = ONE
    [using specialize fieldInverse(ONE) one-is-not-zero]
qed
