// std/sequence.bpa — abstract, ℕ-indexed sequences and a generic FOLD.
//
// bpa has no lists and a `func` cannot take a `Nat -> Value` parameter, so a
// sequence is REIFIED as an opaque sort `Seq` with an accessor `at`. The value
// domain `Value` is abstract, and the fold operator is abstract: a `combine`
// with an `IDENTITY`. `foldUpTo(s, k)` = combine(… combine(combine(IDENTITY,
// at(s,0)), at(s,1)) …, at(s,k-1)), the left fold of the first k entries.
//
// This is the STRUCTURE a concrete caller MODELS: std/integer-sequence.bpa maps
// Value:Int, combine:mul, IDENTITY:ONE, foldUpTo:productUpTo to recover the
// finite product, and transfers the fold-structure facts. (A second caller could
// map combine:add, IDENTITY:ZERO to get finite sums — two folds over one Seq are
// two named models, each supplied by the caller.) The index is `Nat` (peano), so
// it is inherently nonneg — no is_nonneg guard appears on any index.
//
// The bare-sequence entry-graph axioms (seqPrependExists, seqShiftPastExists)
// carry NO fold clause — a Seq is modelable without any fold. The fold-existence
// axioms (seqSingletonExists, seqConcatExists, seqRemoveExists) add a foldUpTo
// clause and live in the fold layer.

import peano <<< "std/peano.bpa"
import ordering <<< "std/peano-order.bpa"

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add

pred less_than = ordering.less_than
define at_most(a: Nat, b: Nat) = ordering.less_or_equal(a, b)

// -- the bare sequence sort -------------------------------------------------

sort Seq
sort Value
func at(s: Seq, i: Nat): Value

// -- bare-sequence reification-existence axioms (NO fold clause) ------------
//
// `Seq` is otherwise observe-only: `at` reads a sequence but no rule produces
// one. Constructing the factorizing sequences the FTA-uniqueness index map σ is
// built from must BUILD sequences, so we disclose — exactly as `functionFromGraph`
// reifies a function from its graph — that a `Seq` with each stated entry-graph
// EXISTS. Nothing about entries outside the stated range is claimed. This is an
// obviously-true fact about the intended model (finite sequences), taken as an
// axiom because the sort carries no first-class sequence-builder. It does not
// mention the fold, so a Seq is modelable with no fold at all.
//
// (A caller whose Value domain IS the index domain — where entries are indices,
// as in the FTA-uniqueness index map σ — additionally needs a "reindex past a
// threshold" builder whose entries are `less_than`/`succ`-manipulated. That
// builder is not generic over an abstract `Value` and lives in the caller, not
// here.)

// The prepend x :: s: a sequence whose head is x and whose tail (indices shifted
// up by one) is s. at(result, 0) = x, and at(result, succ i) = at(s, i).
axiom seqPrependExists: forall x: Value; forall s: Seq;
  exists u: Seq;
  at(u, ZERO) = x
  and (forall i: Nat; at(u, succ(i)) = at(s, i))

// -- the fold layer ---------------------------------------------------------

const IDENTITY: Value
func combine(a: Value, b: Value): Value
func foldUpTo(s: Seq, k: Nat): Value

// foldUpTo by recursion on the (nonneg) upper bound k:
//   foldUpTo(s, 0)      = IDENTITY
//   foldUpTo(s, succ k) = combine(foldUpTo(s, k), at(s, k))
axiom foldZero: forall s: Seq; foldUpTo(s, ZERO) = IDENTITY
axiom foldSucc: forall s: Seq; forall k: Nat; foldUpTo(s, succ(k)) = combine(foldUpTo(s, k), at(s, k))

// -- fold-existence axioms (WITH a foldUpTo clause) -------------------------

// The singleton sequence [x]: its first entry is x and its length-one fold is x.
axiom seqSingletonExists: forall x: Value;
  exists s: Seq; at(s, ZERO) = x and foldUpTo(s, succ(ZERO)) = x

// -- fold-structure theorems (transfer onto a modeling caller) --------------

// The length-one fold combines IDENTITY with the sole entry: foldUpTo(s, 1) =
// combine(IDENTITY, at(s, 0)). Unfold foldSucc at ZERO, then foldZero. A caller
// modeling combine:mul, IDENTITY:ONE transfers this to productUpTo(s, 1) =
// mul(ONE, at(s, 0)) via [using model(…) sequence.foldOneCombinesIdentity].
theorem foldOneCombinesIdentity: forall s: Seq; foldUpTo(s, succ(ZERO)) = combine(IDENTITY, at(s, ZERO))
proof
  @generalize-s |
    fix s: Seq {
      @fold-succ-at-zero |
        foldUpTo(s, succ(ZERO)) = combine(foldUpTo(s, ZERO), at(s, ZERO))
        [using specialize foldSucc(s, ZERO)]
      @fold-at-zero-is-identity |
        foldUpTo(s, ZERO) = IDENTITY
        [using specialize foldZero(s)]
      @fold-one-combines-identity |
        foldUpTo(s, succ(ZERO)) = combine(IDENTITY, at(s, ZERO))
        [by rewrite fold-at-zero-is-identity fold-succ-at-zero]
    }
  @conclusion |
    forall s: Seq; foldUpTo(s, succ(ZERO)) = combine(IDENTITY, at(s, ZERO))
    [by forall_intro generalize-s]
qed

// The concatenation s ++ t of the first j entries of s with the first k entries
// of t: the result agrees with s below j, agrees with (shifted) t on the next k
// slots, and its length-(j+k) fold is the combine of the two pieces.
axiom seqConcatExists: forall s: Seq; forall t: Seq; forall j: Nat; forall k: Nat;
  exists u: Seq;
  (forall i: Nat; less_than(i, j) -> at(u, i) = at(s, i))
  and (forall i: Nat; less_than(i, k) -> at(u, add(j, i)) = at(t, i))
  and foldUpTo(u, add(j, k)) = combine(foldUpTo(s, j), foldUpTo(t, k))

// The sequence s with the entry at index m (0 ≤ m ≤ k) deleted: its length-k
// fold combined with the removed entry recovers s's length-(k+1) fold, and its
// entries are those of s with index m skipped (unchanged below m, shifted up by
// one at and above m). The entry-agreement clauses let a per-entry hypothesis on
// s's first k+1 entries transfer to t's first k entries.
axiom seqRemoveExists: forall s: Seq; forall k: Nat; forall m: Nat;
  less_than(m, succ(k)) ->
  exists t: Seq;
  combine(foldUpTo(t, k), at(s, m)) = foldUpTo(s, succ(k))
  and (forall i: Nat; less_than(i, m) -> at(t, i) = at(s, i))
  and (forall i: Nat; at_most(m, i) -> less_than(i, k) -> at(t, i) = at(s, succ(i)))
