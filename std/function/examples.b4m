// Worked example for `std/function.b4m`'s graph-to-function principle.
//
// Why this file exists: `functionFromGraph` is the one construction axiom in the theory —
// a specification that is total and single-valued yields an actual `Fn` realizing it. It
// is shaped as a schema because a `func` cannot take a `-> Prop` parameter, and nothing in
// `function.b4m` instantiates it, so the schema's antecedent shape has never been checked
// against a real spec. The theorem below instantiates it at the identity spec, which is
// the smallest spec that is genuinely total and single-valued.
import function <<< "std/function.b4m"

sort Element = function.Element
sort Fn = function.Fn
const identityFn = function.identityFn
func apply = function.apply

axiom functionFromGraph = function.functionFromGraph

// The spec `spec(y, x) = (x = y)` is total (take x := y) and single-valued (anything
// meeting it equals y), so the schema hands back a function realizing it — one that maps
// every y to y. Both antecedents are discharged, which is the point: the schema's
// uniqueness clause is what a caller has to supply, and this shows the shape it takes.
theorem theIdentitySpecIsRealized: exists g: Fn; forall y: Element; apply(g, y) = y
proof
  @generalize-y |
    fix y: Element {
      @y-equals-itself |
        y = y
        [by reflexivity]
      @generalize-candidate |
        fix x2: Element {
          @given-candidate-meets-spec |
            assume x2 = y {
              @candidate-equals-y |
                x2 = y
                [by hypothesis given-candidate-meets-spec]
              @conclusion-y-equals-candidate |
                y = x2
                [by symmetry candidate-equals-y]
            }
          @conclusion-candidate-is-unique |
            x2 = y -> y = x2
            [by implies_intro given-candidate-meets-spec]
        }
      @every-candidate-is-y |
        forall x2: Element; x2 = y -> y = x2
        [by forall_intro generalize-candidate]
      @witness-clauses |
        y = y and (forall x2: Element; x2 = y -> y = x2)
        [by and_intro y-equals-itself every-candidate-is-y]
      @spec-is-met-at-y |
        exists x: Element; x = y and (forall x2: Element; x2 = y -> x = x2)
        [by exists_intro(y) witness-clauses]
    }
  @spec-is-total-and-single-valued |
    forall y: Element; exists x: Element; x = y and (forall x2: Element; x2 = y -> x = x2)
    [by forall_intro generalize-y]
  @conclusion |
    exists g: Fn; forall y: Element; apply(g, y) = y
    [using instantiation functionFromGraph(fun y, x: Element => x = y) spec-is-total-and-single-valued]
qed
