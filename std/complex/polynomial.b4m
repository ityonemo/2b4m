// std/complex/polynomial.b4m — ℂ[x], as a model of F[x].
//
// ℂ is a field (`std/complex.b4m`'s `ComplexField`), so every theorem
// `std/field/polynomial.b4m` proves about F[x] is a theorem about ℂ[x]. This file declares
// ℂ[x]'s own symbols and the model that connects them; the corpus then transfers rather than
// being restated. Nothing here is specific to ℂ beyond the coefficient theory — ℂ[x] is a
// polynomial ring over a field like any other, and the algebraic closure of ℂ (which WOULD
// distinguish it: every nonconstant polynomial has a root) is not assumed anywhere below.
//
// WHAT A POLYNOMIAL LAYER OWES. A model must map every symbol a transferred proof mentions
// and discharge every axiom it reaches — including the axioms of theories BELOW F[x], since
// F[x]'s own theorems are often one-line transfers from `std/ring/polynomial.b4m` and a
// re-transfer re-elaborates those proofs. That is why the block below names the field-level
// algebra facts (`addZeroLeftF`, `mulAddDistribLeftF`, …) and not only the polynomial ones.
// Omitting one does not report an undischarged axiom; it surfaces as a sort mismatch inside
// whichever source file the re-elaboration lands in. See
// `PAINPOINTS.md`.
//
// The operations are DEFINITION BLOCKS, not axioms: each says what a symbol COMPUTES, and a
// definition's clause set discharges F[x]'s corresponding one arm-for-arm
// (`fieldpoly.addP <- caddP`). So `--axioms` reports ℂ[x] as resting on three assumptions of
// its own, not forty — a definition block pairs arm-for-arm with the source's.
theory complex <<< "std/complex.b4m"
theory fieldpoly <<< "std/field/polynomial.b4m"
theory ring <<< "std/ring.b4m"
theory ring_poly <<< "std/ring/polynomial.b4m"
theory peano <<< "std/peano.b4m"

sort Complex = complex.Complex
sort Nat = peano.Nat
const ZERO = complex.ZERO
const NAT_ZERO = peano.ZERO

// -- ℂ[x] ----------------------------------------------------------------------------------
sort CPoly
oper ccoeff(p: CPoly, i: Nat) => Complex
const CZEROP: CPoly
oper caddP(p: CPoly, q: CPoly) => CPoly:
  ccoeff(caddP(p, q), i) = complex.add(ccoeff(p, i), ccoeff(q, i)).
  existence: aCaddPExists,
  uniqueness: cPolyExtensionality
oper cnegP(p: CPoly) => CPoly:
  ccoeff(cnegP(p), i) = complex.neg(ccoeff(p, i)).
  existence: aCnegPExists,
  uniqueness: cPolyExtensionality
oper cmulP(p: CPoly, q: CPoly) => CPoly:
  ccoeff(cmulP(p, q), i) = cconvolution(p, q, NAT_ZERO, i).
  existence: aCmulPExists,
  uniqueness: cPolyExtensionality
oper cmonomial(a: Complex, k: Nat) => CPoly:
  ccoeff(cmonomial(a, k), k) = a;
  (not (i = k)) -> ccoeff(cmonomial(a, k), i) = ZERO.
  existence: aCmonomialExists,
  uniqueness: cPolyExtensionality
pred cdegreeAtMost(p: CPoly, n: Nat)
oper cdegree(p: CPoly) => Nat
// Descends by `peano.prev` on the SECOND index rather than matching `succ` on the left:
// the l-value rule requires a recursive definition's l-value arguments to be parameters
// or closed terms, so the descent must be readable on the RIGHT. The arm's own
// `m != NAT_ZERO` discharges `prev`'s guard. `m` descends while `j` ascends; termination
// asks only about the descent.
oper cconvolution(p: CPoly, q: CPoly, j: Nat, m: Nat) => Complex:
  cconvolution(p, q, j, NAT_ZERO) = complex.mul(ccoeff(p, j), ccoeff(q, NAT_ZERO));
  cconvolution(p, q, j, m) = complex.add(complex.mul(ccoeff(p, j), ccoeff(q, m)), cconvolution(p, q, peano.succ(j), peano.prev(m))) when m != NAT_ZERO.
  termination(peano): _, {cConvolutionIsGrounded, cconvolutionGrounded}

// the coefficient equations: ℂ[x]'s own primitives
axiom cPolyExtensionality: forall p, q: CPoly;
  (forall i: Nat; ccoeff(p, i) = ccoeff(q, i)) -> p = q

axiom aCaddPExists: forall p: CPoly; forall q: CPoly;
  exists r: CPoly; forall i: Nat; (ccoeff(r, i) = complex.add(ccoeff(p, i), ccoeff(q, i)))
axiom aCnegPExists: forall p: CPoly;
  exists r: CPoly; forall i: Nat; (ccoeff(r, i) = complex.neg(ccoeff(p, i)))
axiom aCmulPExists: forall p: CPoly; forall q: CPoly;
  exists r: CPoly; forall i: Nat; (ccoeff(r, i) = cconvolution(p, q, NAT_ZERO, i))
axiom aCmonomialExists: forall a: Complex; forall k: Nat;
  exists r: CPoly; ((ccoeff(r, k) = a)) and (forall i: Nat; ((not (i = k)) -> ccoeff(r, i) = ZERO))
axiom cZeroPolyCoeff: forall i: Nat; ccoeff(CZEROP, i) = ZERO
axiom cDegreeAtMostMeaning: forall p: CPoly; forall n: Nat;
  cdegreeAtMost(p, n) iff
  (forall i: Nat; peano.less_than(n, i) -> ccoeff(p, i) = ZERO)
axiom cDegreeIsALeadingIndex: forall p: CPoly;
  (not (p = CZEROP)) -> (not (ccoeff(p, cdegree(p)) = ZERO))
axiom cDegreeBoundsTheCoefficients: forall p: CPoly;
  (not (p = CZEROP)) -> cdegreeAtMost(p, cdegree(p))

// the convolution, reindexed as F[x] states it: a BASE and a LENGTH whose sum is invariant,
// so no index is ever subtracted.

// -- evaluation ----------------------------------------------------------------------------
// The recursion descends by `peano.prev` rather than matching `peano.succ` on the left: the
// l-value rule requires a recursive definition to keep patterns off its left side, so the
// descent is readable on the RIGHT where the termination check can see it. `prev` is
// guarded (`requires n != ZERO`), and the arm's own condition discharges it.
oper cpower(a: Complex, n: Nat) => Complex:
  cpower(a, NAT_ZERO) = complex.ONE;
  cpower(a, n) = complex.mul(a, cpower(a, peano.prev(n))) when n != NAT_ZERO.
  termination(peano): _, {cpowerIsGrounded, cpowerGrounded}

oper cevalUpTo(p: CPoly, a: Complex, k: Nat) => Complex:
  cevalUpTo(p, a, NAT_ZERO) = ZERO;
  cevalUpTo(p, a, peano.succ(k)) = complex.add(cevalUpTo(p, a, k), complex.mul(ccoeff(p, k), cpower(a, k))).

// `p(a)`: the sum over every index up to AND INCLUDING the degree.
define revaluate(p, a) = cevalUpTo(p, a, peano.succ(cdegree(p)))

pred cIsZeroOf(a: Complex, p: CPoly)
axiom cIsZeroOfMeaning: forall a: Complex; forall p: CPoly;
  cIsZeroOf(a, p) iff revaluate(p, a) = ZERO

// -- the run families a transferred proof mentions -----------------------------------------
// F[x] declares these because `std/ring/polynomial.b4m`'s proofs induct on them (the sum
// reversal behind commutativity, the triple sums behind associativity). A model must map
// every symbol a transferred proof names, so ℂ[x] declares them too. None involves a
// subtraction: each decrementing index is a `succ` pattern, and the index arithmetic the
// triple sums need is NAMED (`cmonus`, `ctheCofactorIndex`).
oper ctailConvolution(p: CPoly, q: CPoly, j: Nat, m: Nat) => Complex:
  ctailConvolution(p, q, NAT_ZERO, m) = complex.mul(ccoeff(p, NAT_ZERO), ccoeff(q, m));
  ctailConvolution(p, q, peano.succ(j), m) = complex.add(complex.mul(ccoeff(p, peano.succ(j)), ccoeff(q, m)), ctailConvolution(p, q, j, peano.succ(m))).

oper csegmentOf(p: CPoly, q: CPoly, j: Nat, c: Nat, n: Nat) => Complex:
  csegmentOf(p, q, j, c, NAT_ZERO) = complex.mul(ccoeff(p, j), ccoeff(q, c));
  csegmentOf(p, q, peano.succ(j), c, peano.succ(n)) = complex.add(complex.mul(ccoeff(p, peano.succ(j)), ccoeff(q, c)), csegmentOf(p, q, j, peano.succ(c), n)).

oper crsegmentOf(p: CPoly, q: CPoly, j: Nat, c: Nat, n: Nat) => Complex:
  crsegmentOf(p, q, j, c, NAT_ZERO) = complex.mul(ccoeff(p, j), ccoeff(q, c));
  crsegmentOf(p, q, j, peano.succ(c), peano.succ(n)) = complex.add(complex.mul(ccoeff(p, j), ccoeff(q, peano.succ(c))), crsegmentOf(p, q, peano.succ(j), c, n)).

oper cmonus(i: Nat, j: Nat) => Nat:
  cmonus(i, NAT_ZERO) = i;
  cmonus(i, j) = cmonus(peano.prev(i), peano.prev(j)) when i != NAT_ZERO and j != NAT_ZERO;
  cmonus(NAT_ZERO, j) = NAT_ZERO when j != NAT_ZERO.
  termination(peano): _, {cmonusIsGrounded, cmonusGrounded}, _

oper ctheCofactorIndex(i: Nat, j: Nat, k: Nat) => Nat:
  ctheCofactorIndex(i, j, NAT_ZERO) = cmonus(i, j);
  ctheCofactorIndex(i, j, peano.succ(k)) = cmonus(cmonus(i, j), peano.succ(k)).

oper ccappedRun(q: CPoly, r: CPoly, g: Nat, n: Nat) => Complex:
  ccappedRun(q, r, g, NAT_ZERO) = ZERO;
  ccappedRun(q, r, g, peano.succ(n)) = complex.add(ccappedRun(q, r, g, n), complex.mul(ccoeff(q, n), ccoeff(r, cmonus(g, n)))).

oper ctripleTerm(p: CPoly, q: CPoly, r: CPoly, i: Nat, j: Nat, k: Nat) => Complex:
  ctripleTerm(p, q, r, i, j, k) = complex.mul(complex.mul(ccoeff(p, j), ccoeff(q, k)), ccoeff(r, ctheCofactorIndex(i, j, k))).

oper ctripleRow(p: CPoly, q: CPoly, r: CPoly, i: Nat, j: Nat, n: Nat) => Complex:
  ctripleRow(p, q, r, i, j, NAT_ZERO) = ZERO;
  ctripleRow(p, q, r, i, j, peano.succ(n)) = complex.add(ctripleRow(p, q, r, i, j, n), ctripleTerm(p, q, r, i, j, n)).

oper ctripleDiag(p: CPoly, q: CPoly, r: CPoly, i: Nat, m: Nat, c: Nat) => Complex:
  ctripleDiag(p, q, r, i, m, NAT_ZERO) = ZERO;
  ctripleDiag(p, q, r, i, m, peano.succ(c)) = complex.add(ctripleDiag(p, q, r, i, m, c), ctripleTerm(p, q, r, i, c, cmonus(m, c))).

oper ctripleTri(p: CPoly, q: CPoly, r: CPoly, i: Nat, n: Nat) => Complex:
  ctripleTri(p, q, r, i, NAT_ZERO) = ZERO;
  ctripleTri(p, q, r, i, peano.succ(n)) = complex.add(ctripleTri(p, q, r, i, n), ctripleDiag(p, q, r, i, n, peano.succ(n))).

oper ctripleRows(p: CPoly, q: CPoly, r: CPoly, i: Nat, m: Nat, n: Nat) => Complex:
  ctripleRows(p, q, r, i, NAT_ZERO, n) = ZERO;
  ctripleRows(p, q, r, i, peano.succ(m), n) = complex.add(ctripleRows(p, q, r, i, m, n), ctripleRow(p, q, r, i, m, cmonus(n, m))).

// The unit polynomial, as its OWN constant with its own coefficient axioms — the shape
// `ring_poly.ONEP` maps onto. F[x] instead derives it from `monomial(oneF, ZERO)`, which
// makes its unit a defined expression; a model target must be a SYMBOL, so ℂ[x] declares the
// constant directly, exactly as ℚ[x] does.
const CONEP: CPoly
axiom cOnePolyCoeffZero: ccoeff(CONEP, NAT_ZERO) = complex.ONE
axiom cOnePolyCoeffHigher: forall i: Nat;
  ccoeff(CONEP, peano.succ(i)) = ZERO

// What this file proves (verified manifest):
intheory cOneIsTheUnitMonomial
intheory cMulIsCommutative
intheory cMulIsAssociative
intheory cAddIsCommutative
intheory cAddIsAssociative
intheory cMulOneLeft
intheory cAddPolyCoeff
intheory cNegPolyCoeff
intheory cMulPolyCoeff
intheory cMonomialCoeffAtItsIndex
intheory cMonomialCoeffElsewhere
intheory cConvolutionZero
intheory cConvolutionSucc
intheory cConvolutionReachesZeroFromAPredecessor
intheory cConvolutionIsGrounded
intheory cpowerReachesABaseFromAPredecessor
intheory cpowerIsGrounded
intheory cPowerZero
intheory cPowerSucc
intheory cEvalZero
intheory cEvalSucc
intheory cTailConvolutionZero
intheory cTailConvolutionSucc
intheory cSegmentZero
intheory cSegmentSucc
intheory cRsegmentZero
intheory cRsegmentSucc
intheory cmonusAtZero
intheory cmonusSteps
intheory cmonusReachesABaseFromAPredecessor
intheory cmonusIsGrounded
intheory cTheCofactorIndexAtZero
intheory cTheCofactorIndexSteps
intheory cCappedRunZero
intheory cCappedRunSucc
intheory cTripleTermMeaning
intheory cTripleRowZero
intheory cTripleRowSucc
intheory cTripleDiagZero
intheory cTripleDiagSucc
intheory cTripleTriZero
intheory cTripleTriSucc
intheory cTripleRowsZero
intheory cTripleRowsSucc

// CONEP IS the unit monomial: both have ONE at index 0 and vanish elsewhere, so
// extensionality identifies them. This is what the model owes for mapping F[x]'s
// `monomialOne` onto ℂ[x]'s own constant.
theorem cOneIsTheUnitMonomial: CONEP = cmonomial(complex.ONE, NAT_ZERO)
proof
  @the-coefficients-agree |
    fix i: Nat {
      @the-case-split |
        i = NAT_ZERO or (exists w: Nat; i = peano.succ(w))
        [using specialize peano.zeroOrSucc(i)]
      @when-zero |
        assume i = NAT_ZERO {
          @i-is-zero |
            i = NAT_ZERO
            [by hypothesis when-zero]
          @the-unit-at-zero |
            ccoeff(CONEP, NAT_ZERO) = complex.ONE
            [by cite cOnePolyCoeffZero]
          @the-monomial-at-zero |
            ccoeff(cmonomial(complex.ONE, NAT_ZERO), NAT_ZERO) = complex.ONE
            [using specialize cMonomialCoeffAtItsIndex(complex.ONE, NAT_ZERO)]
          @agree-at-zero |
            ccoeff(CONEP, NAT_ZERO) =
              ccoeff(cmonomial(complex.ONE, NAT_ZERO), NAT_ZERO)
            [using simplify the-unit-at-zero the-monomial-at-zero]
          @conclusion-zero |
            ccoeff(CONEP, i) = ccoeff(cmonomial(complex.ONE, NAT_ZERO), i)
            [by rewrite i-is-zero agree-at-zero]
        }
      @when-positive |
        assume exists w: Nat; i = peano.succ(w) {
          @the-predecessor-exists |
            exists w: Nat; i = peano.succ(w)
            [by hypothesis when-positive]
          @with-the-predecessor |
            unpack w: Nat from the-predecessor-exists {
              @i-steps |
                i = peano.succ(w)
                [by hypothesis with-the-predecessor]
              @the-unit-above |
                ccoeff(CONEP, peano.succ(w)) = ZERO
                [using specialize cOnePolyCoeffHigher(w)]
              @the-index-differs |
                not (peano.succ(w) = NAT_ZERO)
                [using specialize peano.succNotZero(w)]
              @the-monomial-above |
                ccoeff(cmonomial(complex.ONE, NAT_ZERO), peano.succ(w)) = ZERO
                [using specialize cMonomialCoeffElsewhere(complex.ONE,
                  NAT_ZERO, peano.succ(w)) the-index-differs]
              @agree-above |
                ccoeff(CONEP, peano.succ(w)) =
                  ccoeff(cmonomial(complex.ONE, NAT_ZERO), peano.succ(w))
                [using simplify the-unit-above the-monomial-above]
              @conclusion-positive |
                ccoeff(CONEP, i) =
                  ccoeff(cmonomial(complex.ONE, NAT_ZERO), i)
                [by rewrite i-steps agree-above]
            }
          @conclusion-the-positive-case |
            ccoeff(CONEP, i) = ccoeff(cmonomial(complex.ONE, NAT_ZERO), i)
            [by unpacked with-the-predecessor]
        }
      @conclusion-at-i |
        ccoeff(CONEP, i) = ccoeff(cmonomial(complex.ONE, NAT_ZERO), i)
        [by common_conclusion the-case-split when-zero when-positive]
    }
  @all-coefficients-agree |
    forall i: Nat;
      ccoeff(CONEP, i) = ccoeff(cmonomial(complex.ONE, NAT_ZERO), i)
    [by generalize the-coefficients-agree]
  @conclusion |
    CONEP = cmonomial(complex.ONE, NAT_ZERO)
    [using specialize cPolyExtensionality(CONEP,
      cmonomial(complex.ONE, NAT_ZERO)) all-coefficients-agree]
qed

// -- F[x]'s corpus, transferred ------------------------------------------------------------
// The coefficient field AND the polynomial layer both travel.
model ComplexPolynomials {
  fieldpoly.F: Complex
  fieldpoly.zeroF: ZERO
  fieldpoly.oneF: complex.ONE
  fieldpoly.addF: complex.add
  fieldpoly.mulF: complex.mul
  fieldpoly.negF: complex.neg
  fieldpoly.recipF: complex.recip
  fieldpoly.Poly: CPoly
  fieldpoly.coeff: ccoeff
  fieldpoly.ZEROP: CZEROP
  fieldpoly.addP: caddP
  fieldpoly.negP: cnegP
  fieldpoly.mulP: cmulP
  fieldpoly.monomial: cmonomial
  fieldpoly.degreeAtMost: cdegreeAtMost
  fieldpoly.degree: cdegree
  fieldpoly.convolution: cconvolution
  fieldpoly.power: cpower
  fieldpoly.evalUpTo: cevalUpTo
  fieldpoly.isZeroOf: cIsZeroOf
  fieldpoly.tailConvolution: ctailConvolution
  fieldpoly.segment: csegmentOf
  fieldpoly.rsegment: crsegmentOf
  fieldpoly.monus: cmonus
  fieldpoly.theCofactorIndex: ctheCofactorIndex
  fieldpoly.cappedRun: ccappedRun
  fieldpoly.tripleTerm: ctripleTerm
  fieldpoly.tripleRow: ctripleRow
  fieldpoly.tripleDiag: ctripleDiag
  fieldpoly.tripleTri: ctripleTri
  fieldpoly.tripleRows: ctripleRows
  fieldpoly.monomialOne: CONEP
  fieldpoly.monomialOneIsTheUnitMonomial <- cOneIsTheUnitMonomial
  // the field-level algebra, which F[x]'s own transferred proofs reach
  fieldpoly.addIsAssociativeF <- complex.addIsAssociative
  fieldpoly.addIsCommutativeF <- complex.addIsCommutative
  fieldpoly.addZeroLeftF <- complex.addZeroLeft
  fieldpoly.addNegLeftF <- complex.addNegLeft
  fieldpoly.mulIsAssociativeF <- complex.mulIsAssociative
  fieldpoly.mulIsCommutativeF <- complex.mulIsCommutative
  fieldpoly.mulOneLeftF <- complex.mulOneLeft
  fieldpoly.mulAddDistribLeftF <- complex.mulAddDistribLeft
  fieldpoly.mulAddDistribRightF <- complex.mulAddDistribRight
  // the polynomial layer
  fieldpoly.polyExtensionality <- cPolyExtensionality
  fieldpoly.zeroPolyCoeff <- cZeroPolyCoeff
  fieldpoly.addP <- caddP
  fieldpoly.negP <- cnegP
  fieldpoly.monomial <- cmonomial
  fieldpoly.degreeAtMostMeaning <- cDegreeAtMostMeaning
  fieldpoly.degreeIsALeadingIndex <- cDegreeIsALeadingIndex
  fieldpoly.degreeBoundsTheCoefficients <- cDegreeBoundsTheCoefficients
  fieldpoly.convolution <- cconvolution
  fieldpoly.mulP <- cmulP
  fieldpoly.power <- cpower
  fieldpoly.evalUpTo <- cevalUpTo
  fieldpoly.isZeroOfMeaning <- cIsZeroOfMeaning
  fieldpoly.tailConvolution <- ctailConvolution
  fieldpoly.segment <- csegmentOf
  fieldpoly.rsegment <- crsegmentOf
  fieldpoly.monus <- cmonus
  fieldpoly.theCofactorIndex <- ctheCofactorIndex
  fieldpoly.cappedRun <- ccappedRun
  fieldpoly.tripleTerm <- ctripleTerm
  fieldpoly.tripleRow <- ctripleRow
  fieldpoly.tripleDiag <- ctripleDiag
  fieldpoly.tripleTri <- ctripleTri
  fieldpoly.tripleRows <- ctripleRows
}

// -- the transferred ring structure, named locally -----------------------------------------
// Callers should not have to re-open the model; these give ℂ[x]'s ring laws bare names.
theorem cMulIsCommutative: forall p, q: CPoly; cmulP(p, q) = cmulP(q, p)
proof
  @conclusion |
    forall p, q: CPoly; cmulP(p, q) = cmulP(q, p)
    [using model(ComplexPolynomials) fieldpoly.polyMulIsCommutative]
qed

theorem cMulIsAssociative: forall p, q, r: CPoly;
  cmulP(cmulP(p, q), r) = cmulP(p, cmulP(q, r))
proof
  @conclusion |
    forall p, q, r: CPoly; cmulP(cmulP(p, q), r) = cmulP(p, cmulP(q, r))
    [using model(ComplexPolynomials) fieldpoly.polyMulIsAssociative]
qed

theorem cAddIsCommutative: forall p, q: CPoly; caddP(p, q) = caddP(q, p)
proof
  @conclusion |
    forall p, q: CPoly; caddP(p, q) = caddP(q, p)
    [using model(ComplexPolynomials) fieldpoly.polyAddIsCommutative]
qed

theorem cAddIsAssociative: forall p, q, r: CPoly;
  caddP(caddP(p, q), r) = caddP(p, caddP(q, r))
proof
  @conclusion |
    forall p, q, r: CPoly; caddP(caddP(p, q), r) = caddP(p, caddP(q, r))
    [using model(ComplexPolynomials) fieldpoly.polyAddIsAssociative]
qed

// -- the ring layer, for the facts stated over `ring_poly.ONEP` ----------------------------
// `polyMulOneLeft` is stated in `std/ring/polynomial.b4m` over its own `ONEP`, which F[x]
// maps onto a DERIVED unit (`monomial(oneF, ZERO)`). Re-transferring through F[x] therefore
// re-elaborates a proof in F[x]'s names, which ℂ[x]'s model cannot re-point. ℚ[x] solved
// this the same way: map the ring layer DIRECTLY, where the unit is a plain constant.
model ComplexPolynomialsOverARing {
  ring.Ring: Complex
  ring.ZERO: ZERO
  ring.ONE: complex.ONE
  ring.add: complex.add
  ring.mul: complex.mul
  ring.neg: complex.neg
  ring.addIsAssociative <- complex.addIsAssociative
  ring.addZeroLeft <- complex.addZeroLeft
  ring.addNegLeft <- complex.addNegLeft
  ring.addIsCommutative <- complex.addIsCommutative
  ring.mulIsAssociative <- complex.mulIsAssociative
  ring.mulAddDistribLeft <- complex.mulAddDistribLeft
  ring.mulAddDistribRight <- complex.mulAddDistribRight
  ring_poly.mulOneLeftR <- complex.mulOneLeft
  ring_poly.mulIsCommutativeR <- complex.mulIsCommutative
  ring_poly.Nat: Nat
  ring_poly.ZERO: NAT_ZERO
  ring_poly.succ: peano.succ
  ring_poly.addN: peano.add
  ring_poly.less_than: peano.less_than
  ring_poly.Poly: CPoly
  ring_poly.coeff: ccoeff
  ring_poly.ZEROP: CZEROP
  ring_poly.ONEP: CONEP
  ring_poly.addP: caddP
  ring_poly.negP: cnegP
  ring_poly.mulP: cmulP
  ring_poly.convolution: cconvolution
  ring_poly.tailConvolution: ctailConvolution
  ring_poly.segment: csegmentOf
  ring_poly.rsegment: crsegmentOf
  ring_poly.degreeAtMost: cdegreeAtMost
  ring_poly.degree: cdegree
  ring_poly.polyExtensionality <- cPolyExtensionality
  ring_poly.zeroPolyCoeff <- cZeroPolyCoeff
  ring_poly.onePolyCoeffZero <- cOnePolyCoeffZero
  ring_poly.onePolyCoeffHigher <- cOnePolyCoeffHigher
  ring_poly.addP <- caddP
  ring_poly.negP <- cnegP
  ring_poly.degreeAtMostMeaning <- cDegreeAtMostMeaning
  ring_poly.degreeIsALeadingIndex <- cDegreeIsALeadingIndex
  ring_poly.degreeBoundsTheCoefficients <- cDegreeBoundsTheCoefficients
  ring_poly.convolution <- cconvolution
  ring_poly.tailConvolution <- ctailConvolution
  ring_poly.segment <- csegmentOf
  ring_poly.rsegment <- crsegmentOf
  ring_poly.mulP <- cmulP
}

theorem cMulOneLeft: forall p: CPoly; cmulP(CONEP, p) = p
proof
  @conclusion |
    forall p: CPoly; cmulP(CONEP, p) = p
    [using model(ComplexPolynomialsOverARing) ring_poly.polyMulOneLeft]
qed

// -- definition-clause shims ---------------------------------------------------------------
//
// The symbols above are DEFINITION BLOCKS, so `--axioms` reports their clauses as
// definitions rather than as assumptions to weigh. A clause has no user-facing name,
// though, and a model's `<-` and `specialize` both resolve BY NAME — so each clause keeps a
// one-line theorem under the name it had as an axiom. These add no assumption: every one is
// proved `[by definition(N) <symbol>]`.

theorem cAddPolyCoeff:
  forall p, q: CPoly; forall i: Nat;
  ccoeff(caddP(p, q), i) = complex.add(ccoeff(p, i), ccoeff(q, i))
proof
  @conclusion |
    forall p, q: CPoly; forall i: Nat;
      ccoeff(caddP(p, q), i) = complex.add(ccoeff(p, i), ccoeff(q, i))
    [by definition caddP]
qed

theorem cNegPolyCoeff:
  forall p: CPoly; forall i: Nat;
  ccoeff(cnegP(p), i) = complex.neg(ccoeff(p, i))
proof
  @conclusion |
    forall p: CPoly; forall i: Nat;
      ccoeff(cnegP(p), i) = complex.neg(ccoeff(p, i))
    [by definition cnegP]
qed

theorem cMulPolyCoeff:
  forall p, q: CPoly; forall i: Nat;
  ccoeff(cmulP(p, q), i) = cconvolution(p, q, NAT_ZERO, i)
proof
  @conclusion |
    forall p, q: CPoly; forall i: Nat;
      ccoeff(cmulP(p, q), i) = cconvolution(p, q, NAT_ZERO, i)
    [by definition cmulP]
qed

theorem cMonomialCoeffAtItsIndex:
  forall a: Complex; forall k: Nat;
  ccoeff(cmonomial(a, k), k) = a
proof
  @conclusion |
    forall a: Complex; forall k: Nat;
      ccoeff(cmonomial(a, k), k) = a
    [by definition(0) cmonomial]
qed

theorem cMonomialCoeffElsewhere:
  forall a: Complex; forall k, i: Nat;
  (not (i = k)) -> ccoeff(cmonomial(a, k), i) = ZERO
proof
  @conclusion |
    forall a: Complex; forall k, i: Nat;
      (not (i = k)) -> ccoeff(cmonomial(a, k), i) = ZERO
    [by definition(1) cmonomial]
qed

theorem cConvolutionZero:
  forall p, q: CPoly; forall j: Nat;
  cconvolution(p, q, j, NAT_ZERO) =
  complex.mul(ccoeff(p, j), ccoeff(q, NAT_ZERO))
proof
  @conclusion |
    forall p, q: CPoly; forall j: Nat;
      cconvolution(p, q, j, NAT_ZERO) =
      complex.mul(ccoeff(p, j), ccoeff(q, NAT_ZERO))
    [by definition(0) cconvolution]
qed

// DERIVED, not transcribed: the clause descends by `peano.prev`, so this restates it at a
// successor where `prevOfSucc` collapses the `prev`. The STATEMENT is unchanged, which keeps
// the clause's `m != NAT_ZERO` guard from reaching any call site.
theorem cConvolutionSucc:
  forall p, q: CPoly; forall j, m: Nat;
  cconvolution(p, q, j, peano.succ(m)) =
  complex.add(complex.mul(ccoeff(p, j), ccoeff(q, peano.succ(m))),
  cconvolution(p, q, peano.succ(j), m))
proof
  @the-recursive-clause |
    forall p2: CPoly; forall q2: CPoly; forall j2: Nat; forall m2: Nat;
      m2 != NAT_ZERO ->
      cconvolution(p2, q2, j2, m2) =
      complex.add(complex.mul(ccoeff(p2, j2), ccoeff(q2, m2)),
      cconvolution(p2, q2, peano.succ(j2), peano.prev(m2)))
    [by definition(1) cconvolution]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: CPoly {
      @generalize-q |
        fix q: CPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @succ-m-is-nonzero |
                    peano.succ(m) != NAT_ZERO
                    [using specialize a-successor-is-never-zero(m)]
                  @clause-at-the-successor |
                    cconvolution(p, q, j, peano.succ(m)) =
                      complex.add(complex.mul(ccoeff(p, j), ccoeff(q, peano.succ(m))),
                      cconvolution(p, q, peano.succ(j), peano.prev(peano.succ(m))))
                    [using specialize the-recursive-clause(p, q, j, peano.succ(m)) succ-m-is-nonzero]
                  @prev-of-succ-m |
                    peano.prev(peano.succ(m)) = m
                    [using specialize prev-undoes-succ(m)]
                  @conclusion-step-at-m |
                    cconvolution(p, q, j, peano.succ(m)) =
                      complex.add(complex.mul(ccoeff(p, j), ccoeff(q, peano.succ(m))),
                      cconvolution(p, q, peano.succ(j), m))
                    [by rewrite prev-of-succ-m clause-at-the-successor]
                }
              @discharge-m |
                forall m: Nat;
                  cconvolution(p, q, j, peano.succ(m)) =
                  complex.add(complex.mul(ccoeff(p, j), ccoeff(q, peano.succ(m))),
                  cconvolution(p, q, peano.succ(j), m))
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j, m: Nat;
              cconvolution(p, q, j, peano.succ(m)) =
              complex.add(complex.mul(ccoeff(p, j), ccoeff(q, peano.succ(m))),
              cconvolution(p, q, peano.succ(j), m))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: CPoly; forall j, m: Nat;
          cconvolution(p, q, j, peano.succ(m)) =
          complex.add(complex.mul(ccoeff(p, j), ccoeff(q, peano.succ(m))),
          cconvolution(p, q, peano.succ(j), m))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: CPoly; forall j, m: Nat;
      cconvolution(p, q, j, peano.succ(m)) =
      complex.add(complex.mul(ccoeff(p, j), ccoeff(q, peano.succ(m))),
      cconvolution(p, q, peano.succ(j), m))
    [by generalize generalize-p]
qed

theorem cPowerZero:
  forall a: Complex; cpower(a, NAT_ZERO) = complex.ONE
proof
  @conclusion |
    forall a: Complex; cpower(a, NAT_ZERO) = complex.ONE
    [by definition(0) cpower]
qed

// The successor step, now DERIVED rather than transcribed: the definition descends by `prev`,
// so this restates it at a successor, where `prevOfSucc` collapses the `prev`. The STATEMENT is
// unchanged, which keeps the migration confined — every call site cites this theorem rather
// than the clause, so the clause's guard never reaches them.
theorem cPowerSucc:
  forall a: Complex; forall n: Nat;
  cpower(a, peano.succ(n)) = complex.mul(a, cpower(a, n))
proof
  @the-recursive-clause |
    forall a2: Complex; forall n2: Nat;
      n2 != NAT_ZERO -> cpower(a2, n2) = complex.mul(a2, cpower(a2, peano.prev(n2)))
    [by definition(1) cpower]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-a |
    fix a: Complex {
      @generalize-n |
        fix n: Nat {
          @succ-n-is-nonzero |
            peano.succ(n) != NAT_ZERO
            [using specialize a-successor-is-never-zero(n)]
          @clause-at-the-successor |
            cpower(a, peano.succ(n)) = complex.mul(a, cpower(a, peano.prev(peano.succ(n))))
            [using specialize the-recursive-clause(a, peano.succ(n)) succ-n-is-nonzero]
          @prev-of-succ-n |
            peano.prev(peano.succ(n)) = n
            [using specialize prev-undoes-succ(n)]
          @conclusion-step-at-a-n |
            cpower(a, peano.succ(n)) = complex.mul(a, cpower(a, n))
            [by rewrite prev-of-succ-n clause-at-the-successor]
        }
      @discharge-n |
        forall n: Nat; cpower(a, peano.succ(n)) = complex.mul(a, cpower(a, n))
        [by generalize generalize-n]
    }
  @conclusion |
    forall a: Complex; forall n: Nat;
      cpower(a, peano.succ(n)) = complex.mul(a, cpower(a, n))
    [by generalize generalize-a]
qed

// -- the TERMINATION obligation for `cpower` ---------------------------------------------
//
// `termination(peano):` names `cpowerIsGrounded`, and the checker SYNTHESIZES the statement it must
// have — the recursive arm's own guard implying the generated predicate:
//
//     forall a: Complex; forall n: Nat; n != NAT_ZERO -> cpowerGrounded(a, n)
//
// `cpowerGrounded` is GENERATED from the arm's one call site, a disjunction of that call grounded
// with its argument hitting the terminating arm's pattern:
//
//     cpowerGrounded(a, n) iff (cpowerGrounded(a, peano.prev(n)) or peano.prev(n) = NAT_ZERO)
//
// The base disjunct is what lets the recursion bottom out: at n = 1 the predecessor IS zero.

// Strategy: the step of an induction on the exponent. At `peano.succ(k)` the predecessor is `k`,
// so either `k` is zero and the base disjunct fires outright, or the inductive hypothesis
// applies at `k`. `tautology` picks whichever holds.
theorem cpowerReachesABaseFromAPredecessor: forall k: Nat;
  (forall a2: Complex; k != NAT_ZERO -> cpowerGrounded(a2, k))
  -> (forall a: Complex; peano.succ(k) != NAT_ZERO -> cpowerGrounded(a, peano.succ(k)))
proof
  @the-generated-clause |
    forall a3: Complex; forall n3: Nat;
      cpowerGrounded(a3, n3) iff (cpowerGrounded(a3, peano.prev(n3)) or peano.prev(n3) = NAT_ZERO)
    [by definition cpowerGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall a2: Complex; k != NAT_ZERO -> cpowerGrounded(a2, k) {
          @inductive-hypothesis |
            forall a2: Complex; k != NAT_ZERO -> cpowerGrounded(a2, k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so this must precede every term writing `prev(peano.succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-a |
            fix a: Complex {
              @given-succ-k-nonzero |
                assume peano.succ(k) != NAT_ZERO {
                  @clause-at-a-and-succ-k |
                    cpowerGrounded(a, peano.succ(k)) iff
                      (cpowerGrounded(a, peano.prev(peano.succ(k))) or peano.prev(peano.succ(k)) = NAT_ZERO)
                    [using specialize the-generated-clause(a, peano.succ(k))]
                  @clause-with-the-predecessor-collapsed |
                    cpowerGrounded(a, peano.succ(k)) iff (cpowerGrounded(a, k) or k = NAT_ZERO)
                    [by rewrite prev-of-succ-k-is-k clause-at-a-and-succ-k]
                  @the-inductive-hypothesis-at-a |
                    k != NAT_ZERO -> cpowerGrounded(a, k)
                    [using specialize inductive-hypothesis(a)]
                  @conclusion-grounded-at-succ-k |
                    cpowerGrounded(a, peano.succ(k))
                    [using tautology clause-with-the-predecessor-collapsed
                      the-inductive-hypothesis-at-a]
                }
              @nonzero-implies-grounded-at-succ-k |
                peano.succ(k) != NAT_ZERO -> cpowerGrounded(a, peano.succ(k))
                [by discharge given-succ-k-nonzero]
            }
          @conclusion-for-all-a |
            forall a: Complex; peano.succ(k) != NAT_ZERO -> cpowerGrounded(a, peano.succ(k))
            [by generalize generalize-a]
        }
      @the-hypothesis-implies-the-step |
        (forall a2: Complex; k != NAT_ZERO -> cpowerGrounded(a2, k))
          -> (forall a: Complex; peano.succ(k) != NAT_ZERO -> cpowerGrounded(a, peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall a2: Complex; k != NAT_ZERO -> cpowerGrounded(a2, k))
      -> (forall a: Complex; peano.succ(k) != NAT_ZERO -> cpowerGrounded(a, peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the exponent. The base is VACUOUS — at n = zero the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so every bit of content is in the step above.
theorem cpowerIsGrounded: forall a: Complex; forall n: Nat;
  n != NAT_ZERO -> cpowerGrounded(a, n)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binder is opened before the
  // vacuous antecedent can be refuted inside it.
  @base-case-proof |
    fix a: Complex {
      @conclusion-vacuously-grounded-at-zero |
        NAT_ZERO != NAT_ZERO -> cpowerGrounded(a, NAT_ZERO)
        [using tautology zero-is-itself]
    }
  @base-case |
    forall a: Complex; NAT_ZERO != NAT_ZERO -> cpowerGrounded(a, NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall a2: Complex; k != NAT_ZERO -> cpowerGrounded(a2, k))
      -> (forall a: Complex; peano.succ(k) != NAT_ZERO -> cpowerGrounded(a, peano.succ(k)))
    [by cite cpowerReachesABaseFromAPredecessor]
  @grounded-for-every-exponent |
    forall n: Nat; forall a: Complex; n != NAT_ZERO -> cpowerGrounded(a, n)
    [using instantiation peano.induction((fun n: Nat => (forall a: Complex; n != NAT_ZERO -> cpowerGrounded(a, n)))) base-case induction-step-for-all-k]
  @generalize-a |
    fix a: Complex {
      @generalize-n |
        fix n: Nat {
          @grounded-at-n-and-a |
            n != NAT_ZERO -> cpowerGrounded(a, n)
            [using specialize grounded-for-every-exponent(n, a)]
        }
      @discharge-n |
        forall n: Nat; n != NAT_ZERO -> cpowerGrounded(a, n)
        [by generalize generalize-n]
    }
  @conclusion |
    forall a: Complex; forall n: Nat; n != NAT_ZERO -> cpowerGrounded(a, n)
    [by generalize generalize-a]
qed

theorem cEvalZero:
  forall p: CPoly; forall a: Complex;
  cevalUpTo(p, a, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p: CPoly; forall a: Complex;
      cevalUpTo(p, a, NAT_ZERO) = ZERO
    [by definition(0) cevalUpTo]
qed

theorem cEvalSucc:
  forall p: CPoly; forall a: Complex; forall k: Nat;
  cevalUpTo(p, a, peano.succ(k)) =
  complex.add(cevalUpTo(p, a, k), complex.mul(ccoeff(p, k), cpower(a, k)))
proof
  @conclusion |
    forall p: CPoly; forall a: Complex; forall k: Nat;
      cevalUpTo(p, a, peano.succ(k)) =
      complex.add(cevalUpTo(p, a, k), complex.mul(ccoeff(p, k), cpower(a, k)))
    [by definition(1) cevalUpTo]
qed

theorem cTailConvolutionZero:
  forall p, q: CPoly; forall m: Nat;
  ctailConvolution(p, q, NAT_ZERO, m) =
  complex.mul(ccoeff(p, NAT_ZERO), ccoeff(q, m))
proof
  @conclusion |
    forall p, q: CPoly; forall m: Nat;
      ctailConvolution(p, q, NAT_ZERO, m) =
      complex.mul(ccoeff(p, NAT_ZERO), ccoeff(q, m))
    [by definition(0) ctailConvolution]
qed

theorem cTailConvolutionSucc:
  forall p, q: CPoly; forall j, m: Nat;
  ctailConvolution(p, q, peano.succ(j), m) =
  complex.add(complex.mul(ccoeff(p, peano.succ(j)), ccoeff(q, m)),
  ctailConvolution(p, q, j, peano.succ(m)))
proof
  @conclusion |
    forall p, q: CPoly; forall j, m: Nat;
      ctailConvolution(p, q, peano.succ(j), m) =
      complex.add(complex.mul(ccoeff(p, peano.succ(j)), ccoeff(q, m)),
      ctailConvolution(p, q, j, peano.succ(m)))
    [by definition(1) ctailConvolution]
qed

theorem cSegmentZero:
  forall p, q: CPoly; forall j, c: Nat;
  csegmentOf(p, q, j, c, NAT_ZERO) = complex.mul(ccoeff(p, j), ccoeff(q, c))
proof
  @conclusion |
    forall p, q: CPoly; forall j, c: Nat;
      csegmentOf(p, q, j, c, NAT_ZERO) = complex.mul(ccoeff(p, j), ccoeff(q, c))
    [by definition(0) csegmentOf]
qed

theorem cSegmentSucc:
  forall p, q: CPoly; forall j, c, n: Nat;
  csegmentOf(p, q, peano.succ(j), c, peano.succ(n)) =
  complex.add(complex.mul(ccoeff(p, peano.succ(j)), ccoeff(q, c)),
  csegmentOf(p, q, j, peano.succ(c), n))
proof
  @conclusion |
    forall p, q: CPoly; forall j, c, n: Nat;
      csegmentOf(p, q, peano.succ(j), c, peano.succ(n)) =
      complex.add(complex.mul(ccoeff(p, peano.succ(j)), ccoeff(q, c)),
      csegmentOf(p, q, j, peano.succ(c), n))
    [by definition(1) csegmentOf]
qed

theorem cRsegmentZero:
  forall p, q: CPoly; forall j, c: Nat;
  crsegmentOf(p, q, j, c, NAT_ZERO) = complex.mul(ccoeff(p, j), ccoeff(q, c))
proof
  @conclusion |
    forall p, q: CPoly; forall j, c: Nat;
      crsegmentOf(p, q, j, c, NAT_ZERO) = complex.mul(ccoeff(p, j), ccoeff(q, c))
    [by definition(0) crsegmentOf]
qed

theorem cRsegmentSucc:
  forall p, q: CPoly; forall j, c, n: Nat;
  crsegmentOf(p, q, j, peano.succ(c), peano.succ(n)) =
  complex.add(complex.mul(ccoeff(p, j), ccoeff(q, peano.succ(c))),
  crsegmentOf(p, q, peano.succ(j), c, n))
proof
  @conclusion |
    forall p, q: CPoly; forall j, c, n: Nat;
      crsegmentOf(p, q, j, peano.succ(c), peano.succ(n)) =
      complex.add(complex.mul(ccoeff(p, j), ccoeff(q, peano.succ(c))),
      crsegmentOf(p, q, peano.succ(j), c, n))
    [by definition(1) crsegmentOf]
qed

theorem cmonusAtZero:
  forall i: Nat; cmonus(i, NAT_ZERO) = i
proof
  @conclusion |
    forall i: Nat; cmonus(i, NAT_ZERO) = i
    [by definition(0) cmonus]
qed

// The `succ`/`succ` step, now DERIVED rather than transcribed: the definition descends by
// `prev` (the l-value rule keeps patterns off the left), so this restates it at a successor
// pair, where `prevOfSucc` collapses both `prev`s. The STATEMENT is unchanged, so every call
// site below still cites this theorem and the clause's guard never reaches them.
theorem cmonusSteps:
  forall i, j: Nat;
  cmonus(peano.succ(i), peano.succ(j)) = cmonus(i, j)
proof
  @the-recursive-clause |
    forall i2: Nat; forall j2: Nat;
      (i2 != NAT_ZERO and j2 != NAT_ZERO) ->
      cmonus(i2, j2) = cmonus(peano.prev(i2), peano.prev(j2))
    [by definition(1) cmonus]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @succ-i-is-nonzero |
            peano.succ(i) != NAT_ZERO
            [using specialize a-successor-is-never-zero(i)]
          @succ-j-is-nonzero |
            peano.succ(j) != NAT_ZERO
            [using specialize a-successor-is-never-zero(j)]
          @both-are-nonzero |
            peano.succ(i) != NAT_ZERO and peano.succ(j) != NAT_ZERO
            [by both succ-i-is-nonzero succ-j-is-nonzero]
          @clause-at-the-successor-pair |
            cmonus(peano.succ(i), peano.succ(j)) =
              cmonus(peano.prev(peano.succ(i)), peano.prev(peano.succ(j)))
            [using specialize the-recursive-clause(peano.succ(i), peano.succ(j)) both-are-nonzero]
          @prev-of-succ-i |
            peano.prev(peano.succ(i)) = i
            [using specialize prev-undoes-succ(i)]
          @prev-of-succ-j |
            peano.prev(peano.succ(j)) = j
            [using specialize prev-undoes-succ(j)]
          @first-prev-collapsed |
            cmonus(peano.succ(i), peano.succ(j)) = cmonus(i, peano.prev(peano.succ(j)))
            [by rewrite prev-of-succ-i clause-at-the-successor-pair]
          @conclusion-step-at-i-j |
            cmonus(peano.succ(i), peano.succ(j)) = cmonus(i, j)
            [by rewrite prev-of-succ-j first-prev-collapsed]
        }
      @discharge-j |
        forall j: Nat; cmonus(peano.succ(i), peano.succ(j)) = cmonus(i, j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i, j: Nat;
      cmonus(peano.succ(i), peano.succ(j)) = cmonus(i, j)
    [by generalize generalize-i]
qed

theorem cTheCofactorIndexAtZero:
  forall i, j: Nat;
  ctheCofactorIndex(i, j, NAT_ZERO) = cmonus(i, j)
proof
  @conclusion |
    forall i, j: Nat;
      ctheCofactorIndex(i, j, NAT_ZERO) = cmonus(i, j)
    [by definition(0) ctheCofactorIndex]
qed

theorem cTheCofactorIndexSteps:
  forall i, j, k: Nat;
  ctheCofactorIndex(i, j, peano.succ(k)) =
  cmonus(cmonus(i, j), peano.succ(k))
proof
  @conclusion |
    forall i, j, k: Nat;
      ctheCofactorIndex(i, j, peano.succ(k)) =
      cmonus(cmonus(i, j), peano.succ(k))
    [by definition(1) ctheCofactorIndex]
qed

theorem cCappedRunZero:
  forall q, r: CPoly; forall g: Nat;
  ccappedRun(q, r, g, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall q, r: CPoly; forall g: Nat;
      ccappedRun(q, r, g, NAT_ZERO) = ZERO
    [by definition(0) ccappedRun]
qed

theorem cCappedRunSucc:
  forall q, r: CPoly; forall g, n: Nat;
  ccappedRun(q, r, g, peano.succ(n)) =
  complex.add(ccappedRun(q, r, g, n),
  complex.mul(ccoeff(q, n), ccoeff(r, cmonus(g, n))))
proof
  @conclusion |
    forall q, r: CPoly; forall g, n: Nat;
      ccappedRun(q, r, g, peano.succ(n)) =
      complex.add(ccappedRun(q, r, g, n),
      complex.mul(ccoeff(q, n), ccoeff(r, cmonus(g, n))))
    [by definition(1) ccappedRun]
qed

theorem cTripleTermMeaning:
  forall p, q, r: CPoly; forall i, j, k: Nat;
  ctripleTerm(p, q, r, i, j, k) =
  complex.mul(complex.mul(ccoeff(p, j), ccoeff(q, k)),
  ccoeff(r, ctheCofactorIndex(i, j, k)))
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, j, k: Nat;
      ctripleTerm(p, q, r, i, j, k) =
      complex.mul(complex.mul(ccoeff(p, j), ccoeff(q, k)),
      ccoeff(r, ctheCofactorIndex(i, j, k)))
    [by definition ctripleTerm]
qed

theorem cTripleRowZero:
  forall p, q, r: CPoly; forall i, j: Nat;
  ctripleRow(p, q, r, i, j, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, j: Nat;
      ctripleRow(p, q, r, i, j, NAT_ZERO) = ZERO
    [by definition(0) ctripleRow]
qed

theorem cTripleRowSucc:
  forall p, q, r: CPoly; forall i, j, n: Nat;
  ctripleRow(p, q, r, i, j, peano.succ(n)) =
  complex.add(ctripleRow(p, q, r, i, j, n), ctripleTerm(p, q, r, i, j, n))
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, j, n: Nat;
      ctripleRow(p, q, r, i, j, peano.succ(n)) =
      complex.add(ctripleRow(p, q, r, i, j, n), ctripleTerm(p, q, r, i, j, n))
    [by definition(1) ctripleRow]
qed

theorem cTripleDiagZero:
  forall p, q, r: CPoly; forall i, m: Nat;
  ctripleDiag(p, q, r, i, m, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, m: Nat;
      ctripleDiag(p, q, r, i, m, NAT_ZERO) = ZERO
    [by definition(0) ctripleDiag]
qed

theorem cTripleDiagSucc:
  forall p, q, r: CPoly; forall i, m, c: Nat;
  ctripleDiag(p, q, r, i, m, peano.succ(c)) =
  complex.add(ctripleDiag(p, q, r, i, m, c),
  ctripleTerm(p, q, r, i, c, cmonus(m, c)))
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, m, c: Nat;
      ctripleDiag(p, q, r, i, m, peano.succ(c)) =
      complex.add(ctripleDiag(p, q, r, i, m, c),
      ctripleTerm(p, q, r, i, c, cmonus(m, c)))
    [by definition(1) ctripleDiag]
qed

theorem cTripleTriZero:
  forall p, q, r: CPoly; forall i: Nat;
  ctripleTri(p, q, r, i, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: CPoly; forall i: Nat;
      ctripleTri(p, q, r, i, NAT_ZERO) = ZERO
    [by definition(0) ctripleTri]
qed

theorem cTripleTriSucc:
  forall p, q, r: CPoly; forall i, n: Nat;
  ctripleTri(p, q, r, i, peano.succ(n)) =
  complex.add(ctripleTri(p, q, r, i, n),
  ctripleDiag(p, q, r, i, n, peano.succ(n)))
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, n: Nat;
      ctripleTri(p, q, r, i, peano.succ(n)) =
      complex.add(ctripleTri(p, q, r, i, n),
      ctripleDiag(p, q, r, i, n, peano.succ(n)))
    [by definition(1) ctripleTri]
qed

theorem cTripleRowsZero:
  forall p, q, r: CPoly; forall i, n: Nat;
  ctripleRows(p, q, r, i, NAT_ZERO, n) = ZERO
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, n: Nat;
      ctripleRows(p, q, r, i, NAT_ZERO, n) = ZERO
    [by definition(0) ctripleRows]
qed

theorem cTripleRowsSucc:
  forall p, q, r: CPoly; forall i, m, n: Nat;
  ctripleRows(p, q, r, i, peano.succ(m), n) =
  complex.add(ctripleRows(p, q, r, i, m, n),
  ctripleRow(p, q, r, i, m, cmonus(n, m)))
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, m, n: Nat;
      ctripleRows(p, q, r, i, peano.succ(m), n) =
      complex.add(ctripleRows(p, q, r, i, m, n),
      ctripleRow(p, q, r, i, m, cmonus(n, m)))
    [by definition(1) ctripleRows]
qed

// -- the TERMINATION obligation for `cmonus` ------------------------------------------------
//
// `termination(peano):` names `cmonusIsGrounded`, and the checker SYNTHESIZES the statement it
// must have — the recursive arm's own guard implying the generated predicate. The predicate
// itself is generated from the arm's call sites, one conjunct per site, each a disjunction of
// that call grounded with its arguments hitting a terminating arm's pattern. Those base
// disjuncts let the recursion bottom out, and all three are needed: `j` running out fires the
// third, `i` running out first fires the second.

// Strategy: induction on the SECOND argument. The one subtlety is that `peano.prev(i) != NAT_ZERO`
// does NOT follow from `i != NAT_ZERO` (take i = 1), so the inductive hypothesis is not
// applicable at `peano.prev(i)` — and need not be, since that is exactly the case the second
// disjunct covers. `tautology` picks whichever disjunct holds.
theorem cmonusReachesABaseFromAPredecessor: forall k: Nat;
  (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> cmonusGrounded(i2, k))
  -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> cmonusGrounded(i, peano.succ(k)))
proof
  @the-generated-clause |
    forall i3: Nat; forall j3: Nat;
      cmonusGrounded(i3, j3) iff
      (cmonusGrounded(peano.prev(i3), peano.prev(j3)) or peano.prev(i3) = NAT_ZERO
      or peano.prev(j3) = NAT_ZERO)
    [by definition cmonusGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> cmonusGrounded(i2, k) {
          @inductive-hypothesis |
            forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> cmonusGrounded(i2, k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so this must precede every term writing `peano.prev(peano.succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-i |
            fix i: Nat {
              @given-i-nonzero-and-succ-k-nonzero |
                assume i != NAT_ZERO and peano.succ(k) != NAT_ZERO {
                  @i-is-nonzero-and-so-is-succ-k |
                    i != NAT_ZERO and peano.succ(k) != NAT_ZERO
                    [by hypothesis given-i-nonzero-and-succ-k-nonzero]
                  @i-is-nonzero |
                    i != NAT_ZERO
                    [by and_lhs i-is-nonzero-and-so-is-succ-k]
                  @clause-at-i-and-succ-k |
                    cmonusGrounded(i, peano.succ(k)) iff
                      (cmonusGrounded(peano.prev(i), peano.prev(peano.succ(k))) or peano.prev(i) = NAT_ZERO
                      or peano.prev(peano.succ(k)) = NAT_ZERO)
                    [using specialize the-generated-clause(i, peano.succ(k))]
                  @clause-with-the-predecessor-collapsed |
                    cmonusGrounded(i, peano.succ(k)) iff
                      (cmonusGrounded(peano.prev(i), k) or peano.prev(i) = NAT_ZERO or k = NAT_ZERO)
                    [by rewrite prev-of-succ-k-is-k clause-at-i-and-succ-k]
                  @the-inductive-hypothesis-at-the-predecessor |
                    (peano.prev(i) != NAT_ZERO and k != NAT_ZERO) -> cmonusGrounded(peano.prev(i), k)
                    [using specialize inductive-hypothesis(peano.prev(i))]
                  @conclusion-grounded-at-succ-k |
                    cmonusGrounded(i, peano.succ(k))
                    [using tautology clause-with-the-predecessor-collapsed
                      the-inductive-hypothesis-at-the-predecessor]
                }
              @nonzero-implies-grounded-at-succ-k |
                (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> cmonusGrounded(i, peano.succ(k))
                [by discharge given-i-nonzero-and-succ-k-nonzero]
            }
          @conclusion-for-all-i |
            forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> cmonusGrounded(i, peano.succ(k))
            [by generalize generalize-i]
        }
      @the-hypothesis-implies-the-step |
        (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> cmonusGrounded(i2, k))
          -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> cmonusGrounded(i, peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> cmonusGrounded(i2, k))
      -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> cmonusGrounded(i, peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the second argument. The base is VACUOUS — at j = NAT_ZERO the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so all the content is in the step above.
theorem cmonusIsGrounded: forall i: Nat; forall j: Nat;
  (i != NAT_ZERO and j != NAT_ZERO) -> cmonusGrounded(i, j)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binder is opened before the
  // vacuous antecedent can be refuted inside it.
  @base-case-proof |
    fix i: Nat {
      @conclusion-vacuously-grounded-at-zero |
        (i != NAT_ZERO and NAT_ZERO != NAT_ZERO) -> cmonusGrounded(i, NAT_ZERO)
        [using tautology zero-is-itself]
    }
  @base-case |
    forall i: Nat; (i != NAT_ZERO and NAT_ZERO != NAT_ZERO) -> cmonusGrounded(i, NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall i2: Nat; (i2 != NAT_ZERO and k != NAT_ZERO) -> cmonusGrounded(i2, k))
      -> (forall i: Nat; (i != NAT_ZERO and peano.succ(k) != NAT_ZERO) -> cmonusGrounded(i, peano.succ(k)))
    [by cite cmonusReachesABaseFromAPredecessor]
  @grounded-for-every-second-argument |
    forall j: Nat; forall i: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> cmonusGrounded(i, j)
    [using instantiation peano.induction((fun j: Nat => (forall i: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> cmonusGrounded(i, j)))) base-case induction-step-for-all-k]
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @grounded-at-j-and-i |
            (i != NAT_ZERO and j != NAT_ZERO) -> cmonusGrounded(i, j)
            [using specialize grounded-for-every-second-argument(j, i)]
        }
      @discharge-j |
        forall j: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> cmonusGrounded(i, j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; (i != NAT_ZERO and j != NAT_ZERO) -> cmonusGrounded(i, j)
    [by generalize generalize-i]
qed

// -- cconvolution's TERMINATION obligation ------------------------------------------
//
// The checker GENERATES the predicate from the recursive arm's one call site:
//
//     cconvolutionGrounded(p, q, j, m) iff
//       (cconvolutionGrounded(p, q, peano.succ(j), peano.prev(m))
//        or peano.prev(m) = NAT_ZERO)
//
// The `prev(m) = NAT_ZERO` disjunct is the base — the NAT_ZERO arm is the only terminating
// one — and it is what lets the recursion bottom out. The ASCENDING `j` costs nothing: it
// rides along untouched, because termination asks only whether the DESCENT reaches a base.

// Strategy: the inductive step on the descending index. At `succ(k)` the clause's `prev`
// collapses to `k`, leaving either `k = NAT_ZERO` (base disjunct) or the hypothesis at `k`;
// `tautology` picks whichever holds. The ascending index is read at `succ(j)`.
theorem cConvolutionReachesZeroFromAPredecessor: forall k: Nat;
  (forall p2: CPoly; forall q2: CPoly; forall j2: Nat;
  k != NAT_ZERO -> cconvolutionGrounded(p2, q2, j2, k))
  -> (forall p: CPoly; forall q: CPoly; forall j: Nat;
  peano.succ(k) != NAT_ZERO -> cconvolutionGrounded(p, q, j, peano.succ(k)))
proof
  @the-generated-clause |
    forall p3: CPoly; forall q3: CPoly; forall j3: Nat; forall m3: Nat;
      cconvolutionGrounded(p3, q3, j3, m3) iff
      (cconvolutionGrounded(p3, q3, peano.succ(j3), peano.prev(m3))
      or peano.prev(m3) = NAT_ZERO)
    [by definition cconvolutionGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != NAT_ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall p2: CPoly; forall q2: CPoly; forall j2: Nat;
          k != NAT_ZERO -> cconvolutionGrounded(p2, q2, j2, k) {
          @inductive-hypothesis |
            forall p2: CPoly; forall q2: CPoly; forall j2: Nat;
              k != NAT_ZERO -> cconvolutionGrounded(p2, q2, j2, k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so the guard fact precedes every term writing `prev(succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != NAT_ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-p |
            fix p: CPoly {
              @generalize-q |
                fix q: CPoly {
                  @generalize-j |
                    fix j: Nat {
                      @clause-at-succ-k |
                        cconvolutionGrounded(p, q, j, peano.succ(k)) iff
                          (cconvolutionGrounded(p, q, peano.succ(j),
                          peano.prev(peano.succ(k)))
                          or peano.prev(peano.succ(k)) = NAT_ZERO)
                        [using specialize the-generated-clause(p, q, j, peano.succ(k))]
                      @clause-with-the-predecessor-collapsed |
                        cconvolutionGrounded(p, q, j, peano.succ(k)) iff
                          (cconvolutionGrounded(p, q, peano.succ(j), k) or k = NAT_ZERO)
                        [by rewrite prev-of-succ-k-is-k clause-at-succ-k]
                      @the-inductive-hypothesis-at-the-raised-index |
                        k != NAT_ZERO -> cconvolutionGrounded(p, q, peano.succ(j), k)
                        [using specialize inductive-hypothesis(p, q, peano.succ(j))]
                      @grounded-at-succ-k |
                        cconvolutionGrounded(p, q, j, peano.succ(k))
                        [using tautology clause-with-the-predecessor-collapsed
                          the-inductive-hypothesis-at-the-raised-index]
                      @conclusion-nonzero-implies-grounded |
                        peano.succ(k) != NAT_ZERO
                          -> cconvolutionGrounded(p, q, j, peano.succ(k))
                        [using tautology grounded-at-succ-k]
                    }
                  @discharge-j |
                    forall j: Nat;
                      peano.succ(k) != NAT_ZERO
                      -> cconvolutionGrounded(p, q, j, peano.succ(k))
                    [by generalize generalize-j]
                }
              @discharge-q |
                forall q: CPoly; forall j: Nat;
                  peano.succ(k) != NAT_ZERO
                  -> cconvolutionGrounded(p, q, j, peano.succ(k))
                [by generalize generalize-q]
            }
          @conclusion-for-all-polynomials |
            forall p: CPoly; forall q: CPoly; forall j: Nat;
              peano.succ(k) != NAT_ZERO -> cconvolutionGrounded(p, q, j, peano.succ(k))
            [by generalize generalize-p]
        }
      @the-hypothesis-implies-the-step |
        (forall p2: CPoly; forall q2: CPoly; forall j2: Nat;
          k != NAT_ZERO -> cconvolutionGrounded(p2, q2, j2, k))
          -> (forall p: CPoly; forall q: CPoly; forall j: Nat;
          peano.succ(k) != NAT_ZERO -> cconvolutionGrounded(p, q, j, peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall p2: CPoly; forall q2: CPoly; forall j2: Nat;
      k != NAT_ZERO -> cconvolutionGrounded(p2, q2, j2, k))
      -> (forall p: CPoly; forall q: CPoly; forall j: Nat;
      peano.succ(k) != NAT_ZERO -> cconvolutionGrounded(p, q, j, peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the descending index. The base is VACUOUS — at NAT_ZERO the
// antecedent demands `NAT_ZERO != NAT_ZERO` — so all the content is in the step above.
theorem cConvolutionIsGrounded:
  forall p: CPoly; forall q: CPoly; forall j: Nat; forall m: Nat;
  m != NAT_ZERO -> cconvolutionGrounded(p, q, j, m)
proof
  @zero-is-itself |
    NAT_ZERO = NAT_ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix p: CPoly {
      @generalize-q-at-zero |
        fix q: CPoly {
          @generalize-j-at-zero |
            fix j: Nat {
              @conclusion-vacuously-grounded-at-zero |
                NAT_ZERO != NAT_ZERO -> cconvolutionGrounded(p, q, j, NAT_ZERO)
                [using tautology zero-is-itself]
            }
          @discharge-j-at-zero |
            forall j: Nat;
              NAT_ZERO != NAT_ZERO -> cconvolutionGrounded(p, q, j, NAT_ZERO)
            [by generalize generalize-j-at-zero]
        }
      @discharge-q-at-zero |
        forall q: CPoly; forall j: Nat;
          NAT_ZERO != NAT_ZERO -> cconvolutionGrounded(p, q, j, NAT_ZERO)
        [by generalize generalize-q-at-zero]
    }
  @base-case |
    forall p: CPoly; forall q: CPoly; forall j: Nat;
      NAT_ZERO != NAT_ZERO -> cconvolutionGrounded(p, q, j, NAT_ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall p2: CPoly; forall q2: CPoly; forall j2: Nat;
      k != NAT_ZERO -> cconvolutionGrounded(p2, q2, j2, k))
      -> (forall p: CPoly; forall q: CPoly; forall j: Nat;
      peano.succ(k) != NAT_ZERO -> cconvolutionGrounded(p, q, j, peano.succ(k)))
    [by cite cConvolutionReachesZeroFromAPredecessor]
  @grounded-for-every-descending-index |
    forall m: Nat; forall p: CPoly; forall q: CPoly; forall j: Nat;
      m != NAT_ZERO -> cconvolutionGrounded(p, q, j, m)
    [using instantiation peano.induction((fun m: Nat => (forall p: CPoly; forall q: CPoly; forall j: Nat; m != NAT_ZERO -> cconvolutionGrounded(p, q, j, m)))) base-case induction-step-for-all-k]
  @generalize-p |
    fix p: CPoly {
      @generalize-q |
        fix q: CPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @grounded-at-these-indices |
                    m != NAT_ZERO -> cconvolutionGrounded(p, q, j, m)
                    [using specialize grounded-for-every-descending-index(m, p, q, j)]
                }
              @discharge-m |
                forall m: Nat; m != NAT_ZERO -> cconvolutionGrounded(p, q, j, m)
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j: Nat; forall m: Nat;
              m != NAT_ZERO -> cconvolutionGrounded(p, q, j, m)
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: CPoly; forall j: Nat; forall m: Nat;
          m != NAT_ZERO -> cconvolutionGrounded(p, q, j, m)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p: CPoly; forall q: CPoly; forall j: Nat; forall m: Nat;
      m != NAT_ZERO -> cconvolutionGrounded(p, q, j, m)
    [by generalize generalize-p]
qed
