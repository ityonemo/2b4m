  forall p, q, r: CPoly; forall i: Nat;
  ctripleTri(p, q, r, i, NAT_ZERO) = ZERO
proof
  @conclusion |
    forall p, q, r: CPoly; forall i: Nat;
      ctripleTri(p, q, r, i, NAT_ZERO) = ZERO
    [by definition(0) ctripleTri]
qed

theorem cTripleTriSucc:
  forall p, q, r: CPoly; forall i, n: Nat;
  ctripleTri(p, q, r, i, peano.succ(n)) =
  complex.add(ctripleTri(p, q, r, i, n),
  ctripleDiag(p, q, r, i, n, peano.succ(n)))
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, n: Nat;
      ctripleTri(p, q, r, i, peano.succ(n)) =
      complex.add(ctripleTri(p, q, r, i, n),
      ctripleDiag(p, q, r, i, n, peano.succ(n)))
    [by definition(1) ctripleTri]
qed

theorem cTripleRowsZero:
  forall p, q, r: CPoly; forall i, n: Nat;
  ctripleRows(p, q, r, i, NAT_ZERO, n) = ZERO
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, n: Nat;
      ctripleRows(p, q, r, i, NAT_ZERO, n) = ZERO
    [by definition(0) ctripleRows]
qed

theorem cTripleRowsSucc:
  forall p, q, r: CPoly; forall i, m, n: Nat;
  ctripleRows(p, q, r, i, peano.succ(m), n) =
  complex.add(ctripleRows(p, q, r, i, m, n),
  ctripleRow(p, q, r, i, m, ctheGapTo(n, m)))
proof
  @conclusion |
    forall p, q, r: CPoly; forall i, m, n: Nat;
      ctripleRows(p, q, r, i, peano.succ(m), n) =
      complex.add(ctripleRows(p, q, r, i, m, n),
      ctripleRow(p, q, r, i, m, ctheGapTo(n, m)))
    [by definition(1) ctripleRows]
qed
