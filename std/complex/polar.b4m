// std/complex/polar.b4m — POLAR FORM on ℂ (Judson §4.2): cis θ = cos θ + i sin θ, the
// product rule cis θ · cis φ = cis(θ + φ), |cis θ| = 1, DeMoivre's theorem
// (r cis θ)^n = r^n cis(nθ), the n-th roots of unity cis(2kπ/n), and the circle group.
//
// Trigonometry is std/real/trig.b4m (axiomatic sin, cos, π); "nθ" is std/real/scaling.b4m's
// natural multiple; the modulus is std/complex/modulus.b4m.

import complex <<< "std/complex.b4m"
import real <<< "std/real.b4m"
import real_trig <<< "std/real/trig.b4m"
import real_scaling <<< "std/real/scaling.b4m"
import complex_modulus <<< "std/complex/modulus.b4m"
import peano <<< "std/peano.b4m"
import real_units <<< "std/real/units.b4m"

sort Complex = complex.Complex
const ZERO = complex.ZERO
const ONE = complex.ONE
const i = complex.i
func add = complex.add
func mul = complex.mul
func recip = complex.recip
func fromReal = complex.fromReal
func re = complex.re
func im = complex.im
func conj = complex.conj
fact complexEq = complex.complexEq
fact reAdd = complex.reAdd
fact imAdd = complex.imAdd
fact reMul = complex.reMul
fact imMul = complex.imMul
fact reOfReal = complex.reOfReal
fact imOfReal = complex.imOfReal
fact reOfI = complex.reOfI
fact imOfI = complex.imOfI
fact fromRealOne = complex.fromRealOne
fact fromRealZero = complex.fromRealZero
fact fromRealMul = complex.fromRealMul
fact fieldInverse = complex.fieldInverse
fact mulOneLeft = complex.mulOneLeft
fact mulOneRight = complex.mulOneRight

sort Real = real.Real
const REAL_ZERO = real.ZERO
const RONE = real.ONE
func real_add = real.add
func rmul = real.mul
func rneg = real.neg
func rrecip = real.recip
// `rrecip`'s guard: an application owes this where it is written
pred rnonzero = real.nonzero
func sin = real_trig.sin
func cos = real_trig.cos
const pi = real_trig.pi
define twoPi = real_trig.twoPi
fact cosZero = real_trig.cosZero
fact sinZero = real_trig.sinZero
fact cosAdd = real_trig.cosAdd
fact sinAdd = real_trig.sinAdd
fact pythagorean = real_trig.pythagorean
fact cosTwoPi = real_trig.cosTwoPi
fact sinTwoPi = real_trig.sinTwoPi
func scale = real_scaling.scale
func toReal = real_scaling.toReal
fact scaleZero = real_scaling.scaleZero
fact scaleSucc = real_scaling.scaleSucc
fact scaleIsProduct = real_scaling.scaleIsProduct
fact scaleSwap = real_scaling.scaleSwap
fact toRealOfSuccIsPositive = real_scaling.toRealOfSuccIsPositive
define normSq(z) = complex_modulus.normSq(z)
func abs = complex_modulus.abs
fact normSqMul = complex_modulus.normSqMul
fact normSqConj = complex_modulus.normSqConj
fact recipIsConjOverNormSq = complex_modulus.recipIsConjOverNormSq
func rpow = real_units.pow
fact rpowZero = real_units.powZero
fact rpowSucc = real_units.powSucc

sort Nat = peano.Nat
const NAT_ZERO = peano.ZERO
func succ = peano.succ
fact induction = peano.induction

// cis θ = cos θ + i sin θ.
define cis(t) = add(fromReal(cos(t)), mul(fromReal(sin(t)), i))

// natural powers z^n on ℂ.
func cpow(z: Complex, n: Nat) => Complex
axiom cpowZero: forall z: Complex; cpow(z, NAT_ZERO) = ONE
axiom cpowSucc: forall z: Complex; forall n: Nat; cpow(z, succ(n)) = mul(cpow(z, n), z)

// -- the parts of cis ------------------------------------------------------------------------

// re(x·i) = 0 and im(x·i) = x for a real x.
theorem reOfImaginaryTerm: forall x: Real; re(mul(fromReal(x), i)) = REAL_ZERO
proof
  @generalize-x |
    fix x: Real {
      @product-parts |
        re(mul(fromReal(x), i)) = real_add(rmul(re(fromReal(x)), re(i)), rneg(rmul(im(fromReal(x)), im(i))))
        [using specialize reMul(fromReal(x), i)]
      @re-of-x |
        re(fromReal(x)) = x
        [using specialize reOfReal(x)]
      @im-of-x |
        im(fromReal(x)) = REAL_ZERO
        [using specialize imOfReal(x)]
      @re-of-i |
        re(i) = REAL_ZERO
        [by cite reOfI]
      @im-of-i |
        im(i) = RONE
        [by cite imOfI]
      @with-re-x |
        re(mul(fromReal(x), i)) = real_add(rmul(x, re(i)), rneg(rmul(im(fromReal(x)), im(i))))
        [by rewrite re-of-x product-parts]
      @with-im-x |
        re(mul(fromReal(x), i)) = real_add(rmul(x, re(i)), rneg(rmul(REAL_ZERO, im(i))))
        [by rewrite im-of-x with-re-x]
      @with-re-i |
        re(mul(fromReal(x), i)) = real_add(rmul(x, REAL_ZERO), rneg(rmul(REAL_ZERO, im(i))))
        [by rewrite re-of-i with-im-x]
      @with-parts |
        re(mul(fromReal(x), i)) = real_add(rmul(x, REAL_ZERO), rneg(rmul(REAL_ZERO, RONE)))
        [by rewrite im-of-i with-re-i]
      @arithmetic |
        real_add(rmul(x, REAL_ZERO), rneg(rmul(REAL_ZERO, RONE))) = REAL_ZERO
        [using polynomial(real)]
      @conclusion-re |
        re(mul(fromReal(x), i)) = REAL_ZERO
        [using chain with-parts arithmetic]
    }
  @conclusion |
    forall x: Real; re(mul(fromReal(x), i)) = REAL_ZERO
    [by generalize generalize-x]
qed

theorem imOfImaginaryTerm: forall x: Real; im(mul(fromReal(x), i)) = x
proof
  @generalize-x |
    fix x: Real {
      @product-parts |
        im(mul(fromReal(x), i)) = real_add(rmul(re(fromReal(x)), im(i)), rmul(im(fromReal(x)), re(i)))
        [using specialize imMul(fromReal(x), i)]
      @re-of-x |
        re(fromReal(x)) = x
        [using specialize reOfReal(x)]
      @im-of-x |
        im(fromReal(x)) = REAL_ZERO
        [using specialize imOfReal(x)]
      @re-of-i |
        re(i) = REAL_ZERO
        [by cite reOfI]
      @im-of-i |
        im(i) = RONE
        [by cite imOfI]
      @with-re-x |
        im(mul(fromReal(x), i)) = real_add(rmul(x, im(i)), rmul(im(fromReal(x)), re(i)))
        [by rewrite re-of-x product-parts]
      @with-im-x |
        im(mul(fromReal(x), i)) = real_add(rmul(x, im(i)), rmul(REAL_ZERO, re(i)))
        [by rewrite im-of-x with-re-x]
      @with-re-i |
        im(mul(fromReal(x), i)) = real_add(rmul(x, im(i)), rmul(REAL_ZERO, REAL_ZERO))
        [by rewrite re-of-i with-im-x]
      @with-parts |
        im(mul(fromReal(x), i)) = real_add(rmul(x, RONE), rmul(REAL_ZERO, REAL_ZERO))
        [by rewrite im-of-i with-re-i]
      @arithmetic |
        real_add(rmul(x, RONE), rmul(REAL_ZERO, REAL_ZERO)) = x
        [using polynomial(real)]
      @conclusion-im |
        im(mul(fromReal(x), i)) = x
        [using chain with-parts arithmetic]
    }
  @conclusion |
    forall x: Real; im(mul(fromReal(x), i)) = x
    [by generalize generalize-x]
qed

theorem reOfCis: forall t: Real; re(cis(t)) = cos(t)
proof
  @generalize-t |
    fix t: Real {
      @sum-parts |
        re(add(fromReal(cos(t)), mul(fromReal(sin(t)), i))) = real_add(re(fromReal(cos(t))), re(mul(fromReal(sin(t)), i)))
        [using specialize reAdd(fromReal(cos(t)), mul(fromReal(sin(t)), i))]
      @re-of-cos |
        re(fromReal(cos(t))) = cos(t)
        [using specialize reOfReal(cos(t))]
      @re-of-sin-term |
        re(mul(fromReal(sin(t)), i)) = REAL_ZERO
        [using specialize reOfImaginaryTerm(sin(t))]
      @with-cos |
        re(add(fromReal(cos(t)), mul(fromReal(sin(t)), i))) = real_add(cos(t), re(mul(fromReal(sin(t)), i)))
        [by rewrite re-of-cos sum-parts]
      @with-parts |
        re(add(fromReal(cos(t)), mul(fromReal(sin(t)), i))) = real_add(cos(t), REAL_ZERO)
        [by rewrite re-of-sin-term with-cos]
      @plus-zero |
        real_add(cos(t), REAL_ZERO) = cos(t)
        [using specialize real.addZeroRight(cos(t))]
      @conclusion-re-of-cis |
        re(cis(t)) = cos(t)
        [using chain with-parts plus-zero]
    }
  @conclusion |
    forall t: Real; re(cis(t)) = cos(t)
    [by generalize generalize-t]
qed

theorem imOfCis: forall t: Real; im(cis(t)) = sin(t)
proof
  @generalize-t |
    fix t: Real {
      @sum-parts |
        im(add(fromReal(cos(t)), mul(fromReal(sin(t)), i))) = real_add(im(fromReal(cos(t))), im(mul(fromReal(sin(t)), i)))
        [using specialize imAdd(fromReal(cos(t)), mul(fromReal(sin(t)), i))]
      @im-of-cos |
        im(fromReal(cos(t))) = REAL_ZERO
        [using specialize imOfReal(cos(t))]
      @im-of-sin-term |
        im(mul(fromReal(sin(t)), i)) = sin(t)
        [using specialize imOfImaginaryTerm(sin(t))]
      @with-cos |
        im(add(fromReal(cos(t)), mul(fromReal(sin(t)), i))) = real_add(REAL_ZERO, im(mul(fromReal(sin(t)), i)))
        [by rewrite im-of-cos sum-parts]
      @with-parts |
        im(add(fromReal(cos(t)), mul(fromReal(sin(t)), i))) = real_add(REAL_ZERO, sin(t))
        [by rewrite im-of-sin-term with-cos]
      @zero-plus |
        real_add(REAL_ZERO, sin(t)) = sin(t)
        [using specialize real.addZeroLeft(sin(t))]
      @conclusion-im-of-cis |
        im(cis(t)) = sin(t)
        [using chain with-parts zero-plus]
    }
  @conclusion |
    forall t: Real; im(cis(t)) = sin(t)
    [by generalize generalize-t]
qed

// the parts of 1.
theorem reOfOne: re(ONE) = RONE
proof
  @one-embedded |
    fromReal(RONE) = ONE
    [by cite fromRealOne]
  @re-of-embedded |
    re(fromReal(RONE)) = RONE
    [using specialize reOfReal(RONE)]
  @conclusion |
    re(ONE) = RONE
    [by rewrite one-embedded re-of-embedded]
qed

theorem imOfOne: im(ONE) = REAL_ZERO
proof
  @one-embedded |
    fromReal(RONE) = ONE
    [by cite fromRealOne]
  @im-of-embedded |
    im(fromReal(RONE)) = REAL_ZERO
    [using specialize imOfReal(RONE)]
  @conclusion |
    im(ONE) = REAL_ZERO
    [by rewrite one-embedded im-of-embedded]
qed

// a complex number whose parts are cos θ, sin θ IS cis θ (extensionality).
theorem cisByParts: forall t: Real; forall z: Complex; re(z) = cos(t) -> im(z) = sin(t) -> z = cis(t)
proof
  @generalize-t |
    fix t: Real {
      @generalize-z |
        fix z: Complex {
          @given-re |
            assume re(z) = cos(t) {
              @given-im |
                assume im(z) = sin(t) {
                  @re-z |
                    re(z) = cos(t)
                    [by hypothesis given-re]
                  @im-z |
                    im(z) = sin(t)
                    [by hypothesis given-im]
                  @re-of-cis |
                    re(cis(t)) = cos(t)
                    [using specialize reOfCis(t)]
                  @im-of-cis |
                    im(cis(t)) = sin(t)
                    [using specialize imOfCis(t)]
                  @cos-is-re-of-cis |
                    cos(t) = re(cis(t))
                    [by symmetry re-of-cis]
                  @sin-is-im-of-cis |
                    sin(t) = im(cis(t))
                    [by symmetry im-of-cis]
                  @res-agree |
                    re(z) = re(cis(t))
                    [using chain re-z cos-is-re-of-cis]
                  @ims-agree |
                    im(z) = im(cis(t))
                    [using chain im-z sin-is-im-of-cis]
                  @conclusion-equal |
                    z = cis(t)
                    [using specialize complexEq(z, cis(t)) res-agree ims-agree]
                }
              @im-implies |
                im(z) = sin(t) -> z = cis(t)
                [by discharge given-im]
            }
          @re-implies |
            re(z) = cos(t) -> im(z) = sin(t) -> z = cis(t)
            [by discharge given-re]
        }
      @discharge-z |
        forall z: Complex; re(z) = cos(t) -> im(z) = sin(t) -> z = cis(t)
        [by generalize generalize-z]
    }
  @conclusion |
    forall t: Real; forall z: Complex; re(z) = cos(t) -> im(z) = sin(t) -> z = cis(t)
    [by generalize generalize-t]
qed

// cis 0 = 1 and cis 2π = 1.
theorem cisZero: ONE = cis(REAL_ZERO)
proof
  @re-of-one |
    re(ONE) = RONE
    [by cite reOfOne]
  @im-of-one |
    im(ONE) = REAL_ZERO
    [by cite imOfOne]
  @cos-zero |
    cos(REAL_ZERO) = RONE
    [by cite cosZero]
  @sin-zero |
    sin(REAL_ZERO) = REAL_ZERO
    [by cite sinZero]
  @re-matches |
    re(ONE) = cos(REAL_ZERO)
    [by rewrite cos-zero re-of-one]
  @im-matches |
    im(ONE) = sin(REAL_ZERO)
    [by rewrite sin-zero im-of-one]
  @conclusion |
    ONE = cis(REAL_ZERO)
    [using specialize cisByParts(REAL_ZERO, ONE) re-matches im-matches]
qed

theorem cisTwoPi: ONE = cis(twoPi)
proof
  @re-of-one |
    re(ONE) = RONE
    [by cite reOfOne]
  @im-of-one |
    im(ONE) = REAL_ZERO
    [by cite imOfOne]
  @cos-two-pi |
    cos(twoPi) = RONE
    [by cite cosTwoPi]
  @sin-two-pi |
    sin(twoPi) = REAL_ZERO
    [by cite sinTwoPi]
  @re-matches |
    re(ONE) = cos(twoPi)
    [by rewrite cos-two-pi re-of-one]
  @im-matches |
    im(ONE) = sin(twoPi)
    [by rewrite sin-two-pi im-of-one]
  @conclusion |
    ONE = cis(twoPi)
    [using specialize cisByParts(twoPi, ONE) re-matches im-matches]
qed

// -- the product rule: cis θ · cis φ = cis(θ + φ) ---------------------------------------------
theorem cisAdd: forall a, b: Real; mul(cis(a), cis(b)) = cis(real_add(a, b))
proof
  @generalize-a |
    fix a: Real {
      @generalize-b |
        fix b: Real {
          @re-of-cis-a |
            re(cis(a)) = cos(a)
            [using specialize reOfCis(a)]
          @im-of-cis-a |
            im(cis(a)) = sin(a)
            [using specialize imOfCis(a)]
          @re-of-cis-b |
            re(cis(b)) = cos(b)
            [using specialize reOfCis(b)]
          @im-of-cis-b |
            im(cis(b)) = sin(b)
            [using specialize imOfCis(b)]
          // the real part.
          @re-of-product |
            re(mul(cis(a), cis(b))) = real_add(rmul(re(cis(a)), re(cis(b))), rneg(rmul(im(cis(a)), im(cis(b)))))
            [using specialize reMul(cis(a), cis(b))]
          @re-of-product-1 |
            re(mul(cis(a), cis(b))) = real_add(rmul(cos(a), re(cis(b))), rneg(rmul(im(cis(a)), im(cis(b)))))
            [by rewrite re-of-cis-a re-of-product]
          @re-of-product-2 |
            re(mul(cis(a), cis(b))) = real_add(rmul(cos(a), cos(b)), rneg(rmul(im(cis(a)), im(cis(b)))))
            [by rewrite re-of-cis-b re-of-product-1]
          @re-of-product-3 |
            re(mul(cis(a), cis(b))) = real_add(rmul(cos(a), cos(b)), rneg(rmul(sin(a), im(cis(b)))))
            [by rewrite im-of-cis-a re-of-product-2]
          @re-of-product-parts |
            re(mul(cis(a), cis(b))) = real_add(rmul(cos(a), cos(b)), rneg(rmul(sin(a), sin(b))))
            [by rewrite im-of-cis-b re-of-product-3]
          @cos-of-sum |
            cos(real_add(a, b)) = real_add(rmul(cos(a), cos(b)), rneg(rmul(sin(a), sin(b))))
            [using specialize cosAdd(a, b)]
          @cos-of-sum-flipped |
            real_add(rmul(cos(a), cos(b)), rneg(rmul(sin(a), sin(b)))) = cos(real_add(a, b))
            [by symmetry cos-of-sum]
          @re-matches |
            re(mul(cis(a), cis(b))) = cos(real_add(a, b))
            [using chain re-of-product-parts cos-of-sum-flipped]
          // the imaginary part.
          @im-of-product |
            im(mul(cis(a), cis(b))) = real_add(rmul(re(cis(a)), im(cis(b))), rmul(im(cis(a)), re(cis(b))))
            [using specialize imMul(cis(a), cis(b))]
          @im-of-product-1 |
            im(mul(cis(a), cis(b))) = real_add(rmul(cos(a), im(cis(b))), rmul(im(cis(a)), re(cis(b))))
            [by rewrite re-of-cis-a im-of-product]
          @im-of-product-2 |
            im(mul(cis(a), cis(b))) = real_add(rmul(cos(a), sin(b)), rmul(im(cis(a)), re(cis(b))))
            [by rewrite im-of-cis-b im-of-product-1]
          @im-of-product-3 |
            im(mul(cis(a), cis(b))) = real_add(rmul(cos(a), sin(b)), rmul(sin(a), re(cis(b))))
            [by rewrite im-of-cis-a im-of-product-2]
          @im-of-product-parts |
            im(mul(cis(a), cis(b))) = real_add(rmul(cos(a), sin(b)), rmul(sin(a), cos(b)))
            [by rewrite re-of-cis-b im-of-product-3]
          @sin-of-sum |
            sin(real_add(a, b)) = real_add(rmul(sin(a), cos(b)), rmul(cos(a), sin(b)))
            [using specialize sinAdd(a, b)]
          @summands-commute |
            real_add(rmul(cos(a), sin(b)), rmul(sin(a), cos(b))) = real_add(rmul(sin(a), cos(b)), rmul(cos(a), sin(b)))
            [using specialize real.addIsCommutative(rmul(cos(a), sin(b)), rmul(sin(a), cos(b)))]
          @sin-of-sum-flipped |
            real_add(rmul(sin(a), cos(b)), rmul(cos(a), sin(b))) = sin(real_add(a, b))
            [by symmetry sin-of-sum]
          @im-matches |
            im(mul(cis(a), cis(b))) = sin(real_add(a, b))
            [using chain im-of-product-parts summands-commute sin-of-sum-flipped]
          @conclusion-product-is-cis |
            mul(cis(a), cis(b)) = cis(real_add(a, b))
            [using specialize cisByParts(real_add(a, b), mul(cis(a), cis(b))) re-matches im-matches]
        }
      @discharge-b |
        forall b: Real; mul(cis(a), cis(b)) = cis(real_add(a, b))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Real; mul(cis(a), cis(b)) = cis(real_add(a, b))
    [by generalize generalize-a]
qed

// |cis θ| = 1.
theorem normSqOfCis: forall t: Real; normSq(cis(t)) = RONE
proof
  @generalize-t |
    fix t: Real {
      @re-of-cis |
        re(cis(t)) = cos(t)
        [using specialize reOfCis(t)]
      @im-of-cis |
        im(cis(t)) = sin(t)
        [using specialize imOfCis(t)]
      @unfolded |
        normSq(cis(t)) = real_add(rmul(re(cis(t)), re(cis(t))), rmul(im(cis(t)), im(cis(t))))
        [by reflexivity]
      @with-re |
        normSq(cis(t)) = real_add(rmul(cos(t), cos(t)), rmul(im(cis(t)), im(cis(t))))
        [by rewrite re-of-cis unfolded]
      @with-parts |
        normSq(cis(t)) = real_add(rmul(cos(t), cos(t)), rmul(sin(t), sin(t)))
        [by rewrite im-of-cis with-re]
      @pythagoras |
        real_add(rmul(cos(t), cos(t)), rmul(sin(t), sin(t))) = RONE
        [using specialize pythagorean(t)]
      @conclusion-unit |
        normSq(cis(t)) = RONE
        [using chain with-parts pythagoras]
    }
  @conclusion |
    forall t: Real; normSq(cis(t)) = RONE
    [by generalize generalize-t]
qed

theorem absOfCis: forall t: Real; abs(cis(t)) = RONE
proof
  @generalize-t |
    fix t: Real {
      @unit-normsq |
        normSq(cis(t)) = RONE
        [using specialize normSqOfCis(t)]
      // `abs` is a function now, not a macro, so its unfolding is a CITATION — and the
      // `sqrt` it unfolds to owes its argument be nonnegative.
      @norm-nonneg-everywhere |
        forall z: complex.Complex; real.less_or_equal(REAL_ZERO, normSq(z))
        [using import(complex_modulus) normSqNonneg]
      @the-norm-is-nonneg |
        real.less_or_equal(REAL_ZERO, normSq(cis(t)))
        [using specialize norm-nonneg-everywhere(cis(t))]
      @abs-unfolds-everywhere |
        forall z: complex.Complex; abs(z) = real.sqrt(normSq(z))
        [using import(complex_modulus) absIsTheRootOfTheNormSquare]
      @unfolded |
        abs(cis(t)) = real.sqrt(normSq(cis(t)))
        [using specialize abs-unfolds-everywhere(cis(t))]
      @zero-le-one |
        real.less_or_equal(REAL_ZERO, RONE)
        [using import(real) zeroLessOrEqualOne]
      @root-of-one-form |
        abs(cis(t)) = real.sqrt(RONE)
        [by rewrite unit-normsq unfolded]
      @root-of-one |
        real.sqrt(RONE) = RONE
        [using import(real) sqrtOne]
      @conclusion-unit |
        abs(cis(t)) = RONE
        [using chain root-of-one-form root-of-one]
    }
  @conclusion |
    forall t: Real; abs(cis(t)) = RONE
    [by generalize generalize-t]
qed

// -- products in polar form: (r cis θ)(s cis φ) = rs cis(θ + φ) --------------------------------
theorem polarProduct: forall r, s, a, b: Real; mul(mul(fromReal(r), cis(a)), mul(fromReal(s), cis(b))) = mul(fromReal(rmul(r, s)), cis(real_add(a, b)))
proof
  @generalize-r |
    fix r: Real {
      @generalize-s |
        fix s: Real {
          @generalize-a |
            fix a: Real {
              @generalize-b |
                fix b: Real {
                  @regrouped |
                    mul(mul(fromReal(r), cis(a)), mul(fromReal(s), cis(b))) = mul(mul(fromReal(r), fromReal(s)), mul(cis(a), cis(b)))
                    [using assoc_commut(complex.mulIsAssociative, complex.mulIsCommutative, complex.mulLeftSwap)]
                  @moduli-embed |
                    fromReal(rmul(r, s)) = mul(fromReal(r), fromReal(s))
                    [using specialize fromRealMul(r, s)]
                  @moduli-combined |
                    mul(mul(fromReal(r), cis(a)), mul(fromReal(s), cis(b))) = mul(fromReal(rmul(r, s)), mul(cis(a), cis(b)))
                    [by rewrite moduli-embed regrouped]
                  @angles-add |
                    mul(cis(a), cis(b)) = cis(real_add(a, b))
                    [using specialize cisAdd(a, b)]
                  @conclusion-polar-product |
                    mul(mul(fromReal(r), cis(a)), mul(fromReal(s), cis(b))) = mul(fromReal(rmul(r, s)), cis(real_add(a, b)))
                    [by rewrite angles-add moduli-combined]
                }
              @discharge-b |
                forall b: Real; mul(mul(fromReal(r), cis(a)), mul(fromReal(s), cis(b))) = mul(fromReal(rmul(r, s)), cis(real_add(a, b)))
                [by generalize generalize-b]
            }
          @discharge-a |
            forall a, b: Real; mul(mul(fromReal(r), cis(a)), mul(fromReal(s), cis(b))) = mul(fromReal(rmul(r, s)), cis(real_add(a, b)))
            [by generalize generalize-a]
        }
      @discharge-s |
        forall s, a, b: Real; mul(mul(fromReal(r), cis(a)), mul(fromReal(s), cis(b))) = mul(fromReal(rmul(r, s)), cis(real_add(a, b)))
        [by generalize generalize-s]
    }
  @conclusion |
    forall r, s, a, b: Real; mul(mul(fromReal(r), cis(a)), mul(fromReal(s), cis(b))) = mul(fromReal(rmul(r, s)), cis(real_add(a, b)))
    [by generalize generalize-r]
qed

// -- DeMoivre's theorem: (cis θ)^n = cis(nθ) ---------------------------------------------------
theorem deMoivre: forall t: Real; forall n: Nat; cpow(cis(t), n) = cis(scale(n, t))
proof
  @generalize-t |
    fix t: Real {
      @zeroth-power |
        cpow(cis(t), NAT_ZERO) = ONE
        [using specialize cpowZero(cis(t))]
      @zero-scale |
        scale(NAT_ZERO, t) = REAL_ZERO
        [using specialize scaleZero(t)]
      @one-is-cis-zero |
        ONE = cis(REAL_ZERO)
        [by cite cisZero]
      @zeroth-power-is-cis-zero |
        cpow(cis(t), NAT_ZERO) = cis(REAL_ZERO)
        [using chain zeroth-power one-is-cis-zero]
      @base-case |
        cpow(cis(t), NAT_ZERO) = cis(scale(NAT_ZERO, t))
        [by rewrite zero-scale zeroth-power-is-cis-zero]
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume cpow(cis(t), k) = cis(scale(k, t)) {
              @inductive-hypothesis |
                cpow(cis(t), k) = cis(scale(k, t))
                [by hypothesis given-inductive-hypothesis]
              @next-power |
                cpow(cis(t), succ(k)) = mul(cpow(cis(t), k), cis(t))
                [using specialize cpowSucc(cis(t), k)]
              @next-power-with-hypothesis |
                cpow(cis(t), succ(k)) = mul(cis(scale(k, t)), cis(t))
                [by rewrite inductive-hypothesis next-power]
              @angles-add |
                mul(cis(scale(k, t)), cis(t)) = cis(real_add(scale(k, t), t))
                [using specialize cisAdd(scale(k, t), t)]
              @next-power-as-cis |
                cpow(cis(t), succ(k)) = cis(real_add(scale(k, t), t))
                [using chain next-power-with-hypothesis angles-add]
              @next-scale |
                scale(succ(k), t) = real_add(scale(k, t), t)
                [using specialize scaleSucc(k, t)]
              @conclusion-step |
                cpow(cis(t), succ(k)) = cis(scale(succ(k), t))
                [by rewrite next-scale next-power-as-cis]
            }
          @induction-step-at-k |
            cpow(cis(t), k) = cis(scale(k, t)) -> cpow(cis(t), succ(k)) = cis(scale(succ(k), t))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; cpow(cis(t), k) = cis(scale(k, t)) -> cpow(cis(t), succ(k)) = cis(scale(succ(k), t))
        [by generalize induction-step]
      @conclusion-all-n |
        forall n: Nat; cpow(cis(t), n) = cis(scale(n, t))
        [using instantiation induction((fun k: Nat => cpow(cis(t), k) = cis(scale(k, t)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall t: Real; forall n: Nat; cpow(cis(t), n) = cis(scale(n, t))
    [by generalize generalize-t]
qed

// DeMoivre with a modulus: (r cis θ)^n = r^n cis(nθ).
theorem deMoivrePolar: forall r, t: Real; forall n: Nat; cpow(mul(fromReal(r), cis(t)), n) = mul(fromReal(rpow(r, n)), cis(scale(n, t)))
proof
  @generalize-r |
    fix r: Real {
      @generalize-t |
        fix t: Real {
          @zeroth-power |
            cpow(mul(fromReal(r), cis(t)), NAT_ZERO) = ONE
            [using specialize cpowZero(mul(fromReal(r), cis(t)))]
          @zeroth-real-power |
            rpow(r, NAT_ZERO) = RONE
            [using specialize rpowZero(r)]
          @zero-scale |
            scale(NAT_ZERO, t) = REAL_ZERO
            [using specialize scaleZero(t)]
          @one-is-cis-zero |
            ONE = cis(REAL_ZERO)
            [by cite cisZero]
          @one-embedded |
            fromReal(RONE) = ONE
            [by cite fromRealOne]
          @one-times-one |
            mul(ONE, ONE) = ONE
            [using specialize mulOneLeft(ONE)]
          @rhs-reflexive |
            mul(fromReal(rpow(r, NAT_ZERO)), cis(scale(NAT_ZERO, t))) = mul(fromReal(rpow(r, NAT_ZERO)), cis(scale(NAT_ZERO, t)))
            [by reflexivity]
          @rhs-with-one |
            mul(fromReal(rpow(r, NAT_ZERO)), cis(scale(NAT_ZERO, t))) = mul(fromReal(RONE), cis(scale(NAT_ZERO, t)))
            [by rewrite zeroth-real-power rhs-reflexive]
          @rhs-with-embedded-one |
            mul(fromReal(rpow(r, NAT_ZERO)), cis(scale(NAT_ZERO, t))) = mul(ONE, cis(scale(NAT_ZERO, t)))
            [by rewrite one-embedded rhs-with-one]
          @rhs-with-zero-angle |
            mul(fromReal(rpow(r, NAT_ZERO)), cis(scale(NAT_ZERO, t))) = mul(ONE, cis(REAL_ZERO))
            [by rewrite zero-scale rhs-with-embedded-one]
          @cis-zero-is-one |
            cis(REAL_ZERO) = ONE
            [by symmetry one-is-cis-zero]
          @rhs-with-ones |
            mul(fromReal(rpow(r, NAT_ZERO)), cis(scale(NAT_ZERO, t))) = mul(ONE, ONE)
            [by rewrite cis-zero-is-one rhs-with-zero-angle]
          @rhs-collapses |
            mul(fromReal(rpow(r, NAT_ZERO)), cis(scale(NAT_ZERO, t))) = ONE
            [using chain rhs-with-ones one-times-one]
          @rhs-flipped |
            ONE = mul(fromReal(rpow(r, NAT_ZERO)), cis(scale(NAT_ZERO, t)))
            [by symmetry rhs-collapses]
          @base-case |
            cpow(mul(fromReal(r), cis(t)), NAT_ZERO) = mul(fromReal(rpow(r, NAT_ZERO)), cis(scale(NAT_ZERO, t)))
            [using chain zeroth-power rhs-flipped]
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume cpow(mul(fromReal(r), cis(t)), k) = mul(fromReal(rpow(r, k)), cis(scale(k, t))) {
                  @inductive-hypothesis |
                    cpow(mul(fromReal(r), cis(t)), k) = mul(fromReal(rpow(r, k)), cis(scale(k, t)))
                    [by hypothesis given-inductive-hypothesis]
                  @next-power |
                    cpow(mul(fromReal(r), cis(t)), succ(k)) = mul(cpow(mul(fromReal(r), cis(t)), k), mul(fromReal(r), cis(t)))
                    [using specialize cpowSucc(mul(fromReal(r), cis(t)), k)]
                  @next-power-with-hypothesis |
                    cpow(mul(fromReal(r), cis(t)), succ(k)) = mul(mul(fromReal(rpow(r, k)), cis(scale(k, t))), mul(fromReal(r), cis(t)))
                    [by rewrite inductive-hypothesis next-power]
                  @polar-step |
                    mul(mul(fromReal(rpow(r, k)), cis(scale(k, t))), mul(fromReal(r), cis(t))) = mul(fromReal(rmul(rpow(r, k), r)), cis(real_add(scale(k, t), t)))
                    [using specialize polarProduct(rpow(r, k), r, scale(k, t), t)]
                  @next-power-polar |
                    cpow(mul(fromReal(r), cis(t)), succ(k)) = mul(fromReal(rmul(rpow(r, k), r)), cis(real_add(scale(k, t), t)))
                    [using chain next-power-with-hypothesis polar-step]
                  @next-real-power |
                    rpow(r, succ(k)) = rmul(rpow(r, k), r)
                    [using specialize rpowSucc(r, k)]
                  @next-scale |
                    scale(succ(k), t) = real_add(scale(k, t), t)
                    [using specialize scaleSucc(k, t)]
                  @next-power-with-real-power |
                    cpow(mul(fromReal(r), cis(t)), succ(k)) = mul(fromReal(rpow(r, succ(k))), cis(real_add(scale(k, t), t)))
                    [by rewrite next-real-power next-power-polar]
                  @conclusion-step |
                    cpow(mul(fromReal(r), cis(t)), succ(k)) = mul(fromReal(rpow(r, succ(k))), cis(scale(succ(k), t)))
                    [by rewrite next-scale next-power-with-real-power]
                }
              @induction-step-at-k |
                cpow(mul(fromReal(r), cis(t)), k) = mul(fromReal(rpow(r, k)), cis(scale(k, t))) -> cpow(mul(fromReal(r), cis(t)), succ(k)) = mul(fromReal(rpow(r, succ(k))), cis(scale(succ(k), t)))
                [by discharge given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat; cpow(mul(fromReal(r), cis(t)), k) = mul(fromReal(rpow(r, k)), cis(scale(k, t))) -> cpow(mul(fromReal(r), cis(t)), succ(k)) = mul(fromReal(rpow(r, succ(k))), cis(scale(succ(k), t)))
            [by generalize induction-step]
          @conclusion-all-n |
            forall n: Nat; cpow(mul(fromReal(r), cis(t)), n) = mul(fromReal(rpow(r, n)), cis(scale(n, t)))
            [using instantiation induction((fun k: Nat => cpow(mul(fromReal(r), cis(t)), k) = mul(fromReal(rpow(r, k)), cis(scale(k, t))))) base-case induction-step-for-all-k]
        }
      @discharge-t |
        forall t: Real; forall n: Nat; cpow(mul(fromReal(r), cis(t)), n) = mul(fromReal(rpow(r, n)), cis(scale(n, t)))
        [by generalize generalize-t]
    }
  @conclusion |
    forall r, t: Real; forall n: Nat; cpow(mul(fromReal(r), cis(t)), n) = mul(fromReal(rpow(r, n)), cis(scale(n, t)))
    [by generalize generalize-r]
qed

// -- the n-th roots of unity: cis(2kπ/n)^n = 1 ---------------------------------------------------

// 1^k = 1.
theorem cpowOfOne: forall k: Nat; cpow(ONE, k) = ONE
proof
  @base-case |
    cpow(ONE, NAT_ZERO) = ONE
    [using specialize cpowZero(ONE)]
  @induction-step |
    fix m: Nat {
      @given-inductive-hypothesis |
        assume cpow(ONE, m) = ONE {
          @inductive-hypothesis |
            cpow(ONE, m) = ONE
            [by hypothesis given-inductive-hypothesis]
          @next-power |
            cpow(ONE, succ(m)) = mul(cpow(ONE, m), ONE)
            [using specialize cpowSucc(ONE, m)]
          @next-power-with-hypothesis |
            cpow(ONE, succ(m)) = mul(ONE, ONE)
            [by rewrite inductive-hypothesis next-power]
          @one-times-one |
            mul(ONE, ONE) = ONE
            [using specialize mulOneLeft(ONE)]
          @conclusion-step |
            cpow(ONE, succ(m)) = ONE
            [using chain next-power-with-hypothesis one-times-one]
        }
      @induction-step-at-m |
        cpow(ONE, m) = ONE -> cpow(ONE, succ(m)) = ONE
        [by discharge given-inductive-hypothesis]
    }
  @induction-step-for-all-m |
    forall m: Nat; cpow(ONE, m) = ONE -> cpow(ONE, succ(m)) = ONE
    [by generalize induction-step]
  @conclusion |
    forall k: Nat; cpow(ONE, k) = ONE
    [using instantiation induction((fun m: Nat => cpow(ONE, m) = ONE)) base-case induction-step-for-all-m]
qed

// if nθ = 2π then every cis(kθ) is an n-th root of unity: cis(kθ)^n = cis(n·kθ) = cis(k·2π) =
// cis(2π)^k = 1.
theorem rootsOfUnity: forall n: Nat; forall theta: Real; scale(n, theta) = twoPi -> forall k: Nat; cpow(cis(scale(k, theta)), n) = ONE
proof
  @generalize-n |
    fix n: Nat {
      @generalize-theta |
        fix theta: Real {
          @given-full-turn |
            assume scale(n, theta) = twoPi {
              @full-turn |
                scale(n, theta) = twoPi
                [by hypothesis given-full-turn]
              @generalize-k |
                fix k: Nat {
                  @de-moivre |
                    cpow(cis(scale(k, theta)), n) = cis(scale(n, scale(k, theta)))
                    [using specialize deMoivre(scale(k, theta), n)]
                  @scales-swap |
                    scale(n, scale(k, theta)) = scale(k, scale(n, theta))
                    [using specialize scaleSwap(k, theta, n)]
                  @as-k-full-turns |
                    cpow(cis(scale(k, theta)), n) = cis(scale(k, scale(n, theta)))
                    [using chain de-moivre scales-swap]
                  @as-k-two-pi |
                    cpow(cis(scale(k, theta)), n) = cis(scale(k, twoPi))
                    [by rewrite full-turn as-k-full-turns]
                  @de-moivre-at-two-pi |
                    cpow(cis(twoPi), k) = cis(scale(k, twoPi))
                    [using specialize deMoivre(twoPi, k)]
                  @two-pi-power-flipped |
                    cis(scale(k, twoPi)) = cpow(cis(twoPi), k)
                    [by symmetry de-moivre-at-two-pi]
                  @one-is-cis-two-pi |
                    ONE = cis(twoPi)
                    [by cite cisTwoPi]
                  @one-power |
                    cpow(ONE, k) = ONE
                    [using specialize cpowOfOne(k)]
                  @cis-two-pi-power |
                    cpow(cis(twoPi), k) = ONE
                    [by rewrite one-is-cis-two-pi one-power]
                  @conclusion-root |
                    cpow(cis(scale(k, theta)), n) = ONE
                    [using chain as-k-two-pi two-pi-power-flipped cis-two-pi-power]
                }
              @discharge-k |
                forall k: Nat; cpow(cis(scale(k, theta)), n) = ONE
                [by generalize generalize-k]
            }
          @full-turn-implies |
            scale(n, theta) = twoPi -> forall k: Nat; cpow(cis(scale(k, theta)), n) = ONE
            [by discharge given-full-turn]
        }
      @discharge-theta |
        forall theta: Real; scale(n, theta) = twoPi -> forall k: Nat; cpow(cis(scale(k, theta)), n) = ONE
        [by generalize generalize-theta]
    }
  @conclusion |
    forall n: Nat; forall theta: Real; scale(n, theta) = twoPi -> forall k: Nat; cpow(cis(scale(k, theta)), n) = ONE
    [by generalize generalize-n]
qed

// and such a θ exists for every n ≥ 1: θ = 2π/n.
theorem rootAngleExists: forall m: Nat; exists theta: Real; scale(succ(m), theta) = twoPi
proof
  @generalize-m |
    fix m: Nat {
      @n-positive |
        real.less_than(REAL_ZERO, toReal(succ(m)))
        [using specialize toRealOfSuccIsPositive(m)]
      @zero-not-below-itself |
        not real.less_than(REAL_ZERO, REAL_ZERO)
        [using specialize real.lessThanIrreflexive(REAL_ZERO)]
      @given-n-zero |
        assume toReal(succ(m)) = REAL_ZERO {
          @n-zero |
            toReal(succ(m)) = REAL_ZERO
            [by hypothesis given-n-zero]
          @zero-below-itself |
            real.less_than(REAL_ZERO, REAL_ZERO)
            [by rewrite n-zero n-positive]
        }
      @n-zero-implies |
        toReal(succ(m)) = REAL_ZERO -> real.less_than(REAL_ZERO, REAL_ZERO)
        [by discharge given-n-zero]
      @n-nonzero |
        toReal(succ(m)) != REAL_ZERO
        [using tautology n-zero-implies zero-not-below-itself]
      // as the PREDICATE `rrecip` is guarded by, matched syntactically
      @n-characterized |
        rnonzero(toReal(succ(m))) iff (not (toReal(succ(m)) = REAL_ZERO))
        [using specialize real.nonzeroMeaning(toReal(succ(m)))]
      @n-is-nonzero |
        rnonzero(toReal(succ(m)))
        [using tautology n-characterized n-nonzero]
      @scale-as-product |
        scale(succ(m), rmul(twoPi, rrecip(toReal(succ(m))))) = rmul(toReal(succ(m)), rmul(twoPi, rrecip(toReal(succ(m)))))
        [using specialize scaleIsProduct(rmul(twoPi, rrecip(toReal(succ(m)))), succ(m))]
      @swapped |
        rmul(toReal(succ(m)), rmul(twoPi, rrecip(toReal(succ(m))))) = rmul(twoPi, rmul(toReal(succ(m)), rrecip(toReal(succ(m)))))
        [using specialize real.mulLeftSwap(toReal(succ(m)), twoPi, rrecip(toReal(succ(m))))]
      @n-times-recip |
        rmul(toReal(succ(m)), rrecip(toReal(succ(m)))) = RONE
        [using specialize real.fieldInverse(toReal(succ(m))) n-is-nonzero]
      @swapped-cancelled |
        rmul(toReal(succ(m)), rmul(twoPi, rrecip(toReal(succ(m))))) = rmul(twoPi, RONE)
        [by rewrite n-times-recip swapped]
      @times-one |
        rmul(twoPi, RONE) = twoPi
        [using specialize real.mulOneRight(twoPi)]
      @full-turn |
        scale(succ(m), rmul(twoPi, rrecip(toReal(succ(m))))) = twoPi
        [using chain scale-as-product swapped-cancelled times-one]
      @conclusion-angle-exists |
        exists theta: Real; scale(succ(m), theta) = twoPi
        [by witness(rmul(twoPi, rrecip(toReal(succ(m))))) full-turn]
    }
  @conclusion |
    forall m: Nat; exists theta: Real; scale(succ(m), theta) = twoPi
    [by generalize generalize-m]
qed

// -- the circle group T = { z : |z| = 1 } is a subgroup of ℂ* ---------------------------------
define onCircle(z) = normSq(z) = RONE

theorem circleHasOne: onCircle(ONE)
proof
  @re-of-one |
    re(ONE) = RONE
    [by cite reOfOne]
  @im-of-one |
    im(ONE) = REAL_ZERO
    [by cite imOfOne]
  @unfolded |
    normSq(ONE) = real_add(rmul(re(ONE), re(ONE)), rmul(im(ONE), im(ONE)))
    [by reflexivity]
  @with-re |
    normSq(ONE) = real_add(rmul(RONE, RONE), rmul(im(ONE), im(ONE)))
    [by rewrite re-of-one unfolded]
  @with-parts |
    normSq(ONE) = real_add(rmul(RONE, RONE), rmul(REAL_ZERO, REAL_ZERO))
    [by rewrite im-of-one with-re]
  @arithmetic |
    real_add(rmul(RONE, RONE), rmul(REAL_ZERO, REAL_ZERO)) = RONE
    [using polynomial(real)]
  @conclusion |
    onCircle(ONE)
    [using chain with-parts arithmetic]
qed

theorem circleClosedUnderProduct: forall z, w: Complex; onCircle(z) -> onCircle(w) -> onCircle(mul(z, w))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @given-z |
            assume onCircle(z) {
              @given-w |
                assume onCircle(w) {
                  @z-unit |
                    normSq(z) = RONE
                    [by hypothesis given-z]
                  @w-unit |
                    normSq(w) = RONE
                    [by hypothesis given-w]
                  @product-normsq |
                    normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
                    [using specialize normSqMul(z, w)]
                  @product-normsq-z |
                    normSq(mul(z, w)) = rmul(RONE, normSq(w))
                    [by rewrite z-unit product-normsq]
                  @product-normsq-both |
                    normSq(mul(z, w)) = rmul(RONE, RONE)
                    [by rewrite w-unit product-normsq-z]
                  @one-times-one |
                    rmul(RONE, RONE) = RONE
                    [using specialize real.mulOneLeft(RONE)]
                  @conclusion-product-unit |
                    onCircle(mul(z, w))
                    [using chain product-normsq-both one-times-one]
                }
              @w-implies |
                onCircle(w) -> onCircle(mul(z, w))
                [by discharge given-w]
            }
          @z-implies |
            onCircle(z) -> onCircle(w) -> onCircle(mul(z, w))
            [by discharge given-z]
        }
      @discharge-w |
        forall w: Complex; onCircle(z) -> onCircle(w) -> onCircle(mul(z, w))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; onCircle(z) -> onCircle(w) -> onCircle(mul(z, w))
    [by generalize generalize-z]
qed

// on the circle the inverse is the conjugate: z⁻¹ = z̄ / |z|² = z̄.
// `nonzero(z)` leads because the conclusion writes `recip(z)`, which lives OUTSIDE the
// assume: a guard on a term in a discharged conclusion must be met from the antecedent. The
// proof still derives the disequation itself (a circle point has |z|² = 1 != 0), so this
// hypothesis is not new mathematical content — only the syntactic form the guard needs.
theorem circleClosedUnderInverse: forall z: Complex;
  complex.nonzero(z) -> onCircle(z) -> onCircle(recip(z))
proof
  @generalize-z |
    fix z: Complex {
      @given-z-nonzero |
        assume complex.nonzero(z) {
          @given-z |
            assume onCircle(z) {
              @z-unit |
                normSq(z) = RONE
                [by hypothesis given-z]
              // z ≠ 0, since |0|² = 0 ≠ 1.
              @zero-embedded |
                fromReal(REAL_ZERO) = ZERO
                [by cite fromRealZero]
              @re-of-embedded-zero |
                re(fromReal(REAL_ZERO)) = REAL_ZERO
                [using specialize reOfReal(REAL_ZERO)]
              @im-of-embedded-zero |
                im(fromReal(REAL_ZERO)) = REAL_ZERO
                [using specialize imOfReal(REAL_ZERO)]
              @re-of-zero |
                re(ZERO) = REAL_ZERO
                [by rewrite zero-embedded re-of-embedded-zero]
              @im-of-zero |
                im(ZERO) = REAL_ZERO
                [by rewrite zero-embedded im-of-embedded-zero]
              @normsq-zero-unfolded |
                normSq(ZERO) = real_add(rmul(re(ZERO), re(ZERO)), rmul(im(ZERO), im(ZERO)))
                [by reflexivity]
              @normsq-zero-re |
                normSq(ZERO) = real_add(rmul(REAL_ZERO, REAL_ZERO), rmul(im(ZERO), im(ZERO)))
                [by rewrite re-of-zero normsq-zero-unfolded]
              @normsq-zero-parts |
                normSq(ZERO) = real_add(rmul(REAL_ZERO, REAL_ZERO), rmul(REAL_ZERO, REAL_ZERO))
                [by rewrite im-of-zero normsq-zero-re]
              @zero-arithmetic |
                real_add(rmul(REAL_ZERO, REAL_ZERO), rmul(REAL_ZERO, REAL_ZERO)) = REAL_ZERO
                [using polynomial(real)]
              @normsq-of-zero |
                normSq(ZERO) = REAL_ZERO
                [using chain normsq-zero-parts zero-arithmetic]
              @one-not-zero |
                RONE != REAL_ZERO
                [using import(real) oneNotZero]
              @given-z-zero |
                assume z = ZERO {
                  @z-zero |
                    z = ZERO
                    [by hypothesis given-z-zero]
                  @normsq-z-is-zero |
                    normSq(z) = REAL_ZERO
                    [by rewrite z-zero normsq-of-zero]
                  @one-is-normsq |
                    RONE = normSq(z)
                    [by symmetry z-unit]
                  @one-is-zero |
                    RONE = REAL_ZERO
                    [using chain one-is-normsq normsq-z-is-zero]
                }
              @z-zero-implies |
                z = ZERO -> RONE = REAL_ZERO
                [by discharge given-z-zero]
              @z-nonzero |
                z != ZERO
                [using tautology z-zero-implies one-not-zero]
              // as the PREDICATE `recip` is guarded by
              @z-characterized |
                complex.nonzero(z) iff (not (z = ZERO))
                [using specialize complex.nonzeroMeaning(z)]
              @z-is-nonzero |
                complex.nonzero(z)
                [using tautology z-characterized z-nonzero]
              // recip(z) = z̄ · recip(1) = z̄.
              // the second antecedent: |z|² embeds to a nonzero complex, which `recip` needs as a
              // guard on the conclusion's own term
              @the-norm-is-nonzero |
                complex.nonzero(fromReal(normSq(z)))
                [using specialize complex_modulus.theEmbeddedNormSqIsNonzero(z) z-is-nonzero]
              @recip-formula |
                recip(z) = mul(conj(z), recip(fromReal(normSq(z))))
                [using specialize recipIsConjOverNormSq(z) z-is-nonzero the-norm-is-nonzero]
              // the rewrite introduces `recip(fromReal(RONE))`, a fresh guarded term, so its
              // obligation is owed here: fromReal(1) = 1 and 1 != 0.
              @one-embedded |
                fromReal(RONE) = ONE
                [by cite fromRealOne]
              @the-unit-is-not-zero |
                ONE != ZERO
                [using import(complex) oneNotZero]
              @the-embedded-unit-is-not-zero |
                fromReal(RONE) != ZERO
                [by rewrite one-embedded the-unit-is-not-zero]
              @the-embedded-unit-characterized |
                complex.nonzero(fromReal(RONE)) iff (not (fromReal(RONE) = ZERO))
                [using specialize complex.nonzeroMeaning(fromReal(RONE))]
              @the-embedded-unit-is-nonzero |
                complex.nonzero(fromReal(RONE))
                [using tautology the-embedded-unit-characterized the-embedded-unit-is-not-zero]
              @recip-formula-unit |
                recip(z) = mul(conj(z), recip(fromReal(RONE)))
                [by rewrite z-unit recip-formula]
              // and `recip(ONE)` after the next rewrite
              @the-unit-characterized |
                complex.nonzero(ONE) iff (not (ONE = ZERO))
                [using specialize complex.nonzeroMeaning(ONE)]
              @the-unit-is-nonzero |
                complex.nonzero(ONE)
                [using tautology the-unit-characterized the-unit-is-not-zero]
              @recip-formula-one |
                recip(z) = mul(conj(z), recip(ONE))
                [by rewrite one-embedded recip-formula-unit]
              @complex-one-not-zero |
                ONE != ZERO
                [using import(complex) oneNotZero]
              @complex-one-characterized |
                complex.nonzero(ONE) iff (not (ONE = ZERO))
                [using specialize complex.nonzeroMeaning(ONE)]
              @complex-one-is-nonzero |
                complex.nonzero(ONE)
                [using tautology complex-one-characterized complex-one-not-zero]
              @one-times-recip-one |
                mul(ONE, recip(ONE)) = ONE
                [using specialize fieldInverse(ONE) complex-one-is-nonzero]
              @one-times-recip-one-unfolds |
                mul(ONE, recip(ONE)) = recip(ONE)
                [using specialize mulOneLeft(recip(ONE))]
              @recip-one-is-product |
                recip(ONE) = mul(ONE, recip(ONE))
                [by symmetry one-times-recip-one-unfolds]
              @recip-of-one |
                recip(ONE) = ONE
                [using chain recip-one-is-product one-times-recip-one]
              @recip-is-conj-times-one |
                recip(z) = mul(conj(z), ONE)
                [by rewrite recip-of-one recip-formula-one]
              @conj-times-one |
                mul(conj(z), ONE) = conj(z)
                [using specialize mulOneRight(conj(z))]
              @recip-is-conj |
                recip(z) = conj(z)
                [using chain recip-is-conj-times-one conj-times-one]
              @conj-normsq |
                normSq(conj(z)) = normSq(z)
                [using specialize normSqConj(z)]
              @conj-unit |
                normSq(conj(z)) = RONE
                [using chain conj-normsq z-unit]
              @conclusion-recip-unit |
                onCircle(recip(z))
                [by rewrite recip-is-conj conj-unit]
            }
          @z-implies |
            onCircle(z) -> onCircle(recip(z))
            [by discharge given-z]
        }
      @z-nonzero-implies |
        complex.nonzero(z) -> onCircle(z) -> onCircle(recip(z))
        [by discharge given-z-nonzero]
    }
  @conclusion |
    forall z: Complex; complex.nonzero(z) -> onCircle(z) -> onCircle(recip(z))
    [by generalize generalize-z]
qed
