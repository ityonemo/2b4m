// std/complex/modulus.b4m — the MODULUS |z| on ℂ and its multiplicative structure.
//
// Built on std/complex.b4m (ℂ as a field with re/im projections + conjugation as a
// derived ring involution) and std/real/sqrt.b4m (√ on the nonnegative reals). The
// norm-square normSq(z) = re(z)² + im(z)² is a nonnegative real; the modulus is its
// square root, abs(z) = √(normSq z). We prove the coordinate-free identities the
// AATA §4.2 exercises ask for: |z̄| = |z|, z·z̄ = |z|², and |zw| = |z|·|w|.
//
// The multiplicative identities go through CONJUGATION (conjMul + zTimesConj), never
// through re/im of a product, so no imaginary-unit cross terms arise; the remaining
// real-algebra obligations are discharged by `polynomial(real)`. `define` is
// definitional, so normSq/abs unfold on contact — no explicit fold steps needed.

import complex <<< "std/complex.b4m"
import real <<< "std/real.b4m"
import real_sqrt <<< "std/real.b4m"

sort Complex = complex.Complex
const ZERO = complex.ZERO
func mul = complex.mul
func conj = complex.conj
func fromReal = complex.fromReal
func re = complex.re
func im = complex.im

sort Real = real.Real
func radd = real.add
func rmul = real.mul
func sqrt = real_sqrt.sqrt
pred less_or_equal = real.less_or_equal
pred less_than = real.less_than
const ONE = complex.ONE
func recip = complex.recip
func cadd = complex.add
const i = complex.i
func cneg = complex.neg
func rneg = real.neg
axiom sqrtNonneg = real_sqrt.sqrtNonneg
axiom sqrtSquare = real_sqrt.sqrtSquare
axiom sqrtOfSquare = real_sqrt.sqrtOfSquare
theorem sqrtMonotone = real_sqrt.sqrtMonotone

// the norm-square (a real) and the modulus (its nonnegative square root).
define normSq(z) = radd(rmul(re(z), re(z)), rmul(im(z), im(z)))
define abs(z) = sqrt(normSq(z))

// normSq is nonnegative: a sum of two squares, each ≥ 0.
theorem normSqNonneg: forall z: Complex; less_or_equal(real.ZERO, normSq(z))
proof
  @generalize-z |
    fix z: Complex {
      @re-square-nonneg |
        less_or_equal(real.ZERO, rmul(re(z), re(z)))
        [using specialize real.squareNonneg(re(z))]
      @im-square-nonneg |
        less_or_equal(real.ZERO, rmul(im(z), im(z)))
        [using specialize real.squareNonneg(im(z))]
      @conclusion-normsq-nonneg |
        less_or_equal(real.ZERO, normSq(z))
        [using specialize real.addNonneg(rmul(re(z), re(z)), rmul(im(z), im(z))) re-square-nonneg im-square-nonneg]
    }
  @conclusion |
    forall z: Complex; less_or_equal(real.ZERO, normSq(z))
    [by generalize generalize-z]
qed

// z·z̄ = |z|² (as an embedded real). This is complex.zTimesConj, whose RHS is
// definitionally normSq(z).
theorem zTimesConjIsNormSq: forall z: Complex; mul(z, conj(z)) = fromReal(normSq(z))
proof
  @generalize-z |
    fix z: Complex {
      @conclusion-zzconj |
        mul(z, conj(z)) = fromReal(normSq(z))
        [using specialize complex.zTimesConj(z)]
    }
  @conclusion |
    forall z: Complex; mul(z, conj(z)) = fromReal(normSq(z))
    [by generalize generalize-z]
qed

// normSq(z̄) = normSq(z): re(z̄)² + im(z̄)² = re(z)² + (−im z)² = re(z)² + im(z)².
theorem normSqConj: forall z: Complex; normSq(conj(z)) = normSq(z)
proof
  @generalize-z |
    fix z: Complex {
      @re-conj |
        re(conj(z)) = re(z)
        [using specialize complex.reOfConj(z)]
      @im-conj |
        im(conj(z)) = real.neg(im(z))
        [using specialize complex.imOfConj(z)]
      // normSq(conj z) unfolds definitionally to re(conj z)² + im(conj z)².
      @normsq-conj-refl |
        normSq(conj(z)) = radd(rmul(re(conj(z)), re(conj(z))), rmul(im(conj(z)), im(conj(z))))
        [by reflexivity]
      @with-re |
        normSq(conj(z)) = radd(rmul(re(z), re(z)), rmul(im(conj(z)), im(conj(z))))
        [by rewrite re-conj normsq-conj-refl]
      @with-im |
        normSq(conj(z)) = radd(rmul(re(z), re(z)), rmul(real.neg(im(z)), real.neg(im(z))))
        [by rewrite im-conj with-re]
      @neg-square-is-square |
        radd(rmul(re(z), re(z)), rmul(real.neg(im(z)), real.neg(im(z)))) = normSq(z)
        [using polynomial(real)]
      @conclusion-normsq-conj |
        normSq(conj(z)) = normSq(z)
        [using chain with-im neg-square-is-square]
    }
  @conclusion |
    forall z: Complex; normSq(conj(z)) = normSq(z)
    [by generalize generalize-z]
qed

// |z̄| = |z|: immediate from normSqConj under √ (abs unfolds definitionally to √∘normSq).
theorem absConj: forall z: Complex; abs(conj(z)) = abs(z)
proof
  @generalize-z |
    fix z: Complex {
      @normsq-conj |
        normSq(conj(z)) = normSq(z)
        [using specialize normSqConj(z)]
      @abs-conj-refl |
        abs(conj(z)) = sqrt(normSq(conj(z)))
        [by reflexivity]
      @conclusion-abs-conj |
        abs(conj(z)) = abs(z)
        [by rewrite normsq-conj abs-conj-refl]
    }
  @conclusion |
    forall z: Complex; abs(conj(z)) = abs(z)
    [by generalize generalize-z]
qed

// normSq is multiplicative: normSq(zw) = normSq(z)·normSq(w). Via conjugation:
// fromReal(normSq(zw)) = zw·conj(zw) = (z z̄)(w w̄) = fromReal(normSq z)·fromReal(normSq w)
// = fromReal(normSq z · normSq w); then fromRealInjective.
theorem normSqMul: forall z, w: Complex; normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @zz |
            mul(z, conj(z)) = fromReal(normSq(z))
            [using specialize zTimesConjIsNormSq(z)]
          @ww |
            mul(w, conj(w)) = fromReal(normSq(w))
            [using specialize zTimesConjIsNormSq(w)]
          @zwzw |
            mul(mul(z, w), conj(mul(z, w))) = fromReal(normSq(mul(z, w)))
            [using specialize zTimesConjIsNormSq(mul(z, w))]
          @conj-zw |
            conj(mul(z, w)) = mul(conj(z), conj(w))
            [using specialize complex.conjMul(z, w)]
          // (zw)·conj(zw) = (zw)·(z̄ w̄) = (z z̄)·(w w̄) by commutative reassociation.
          @zwconj-refl |
            mul(mul(z, w), conj(mul(z, w))) = mul(mul(z, w), conj(mul(z, w)))
            [by reflexivity]
          @expand-with-conj |
            mul(mul(z, w), conj(mul(z, w))) = mul(mul(z, w), mul(conj(z), conj(w)))
            [by rewrite conj-zw zwconj-refl]
          @regroup |
            mul(mul(z, w), mul(conj(z), conj(w))) = mul(mul(z, conj(z)), mul(w, conj(w)))
            [using polynomial(complex)]
          @regroup-to-norms |
            mul(mul(z, w), conj(mul(z, w))) = mul(mul(z, conj(z)), mul(w, conj(w)))
            [using chain expand-with-conj regroup]
          @with-zz |
            mul(mul(z, w), conj(mul(z, w))) = mul(fromReal(normSq(z)), mul(w, conj(w)))
            [by rewrite zz regroup-to-norms]
          @with-ww |
            mul(mul(z, w), conj(mul(z, w))) = mul(fromReal(normSq(z)), fromReal(normSq(w)))
            [by rewrite ww with-zz]
          // fromReal is multiplicative: fromReal(a)·fromReal(b) = fromReal(a·b).
          @fromreal-mul |
            fromReal(rmul(normSq(z), normSq(w))) = mul(fromReal(normSq(z)), fromReal(normSq(w)))
            [using specialize complex.fromRealMul(normSq(z), normSq(w))]
          @zwconj-is-fromreal-prod |
            mul(mul(z, w), conj(mul(z, w))) = fromReal(rmul(normSq(z), normSq(w)))
            [by rewrite fromreal-mul with-ww]
          // fromReal(normSq zw) = fromReal(normSq z · normSq w), then injectivity.
          @zwzw-flipped |
            fromReal(normSq(mul(z, w))) = mul(mul(z, w), conj(mul(z, w)))
            [by symmetry zwzw]
          @fromreal-eq |
            fromReal(normSq(mul(z, w))) = fromReal(rmul(normSq(z), normSq(w)))
            [using chain zwzw-flipped zwconj-is-fromreal-prod]
          @conclusion-normsq-mul |
            normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
            [using specialize complex.fromRealInjective(normSq(mul(z, w)), rmul(normSq(z), normSq(w))) fromreal-eq]
        }
      @discharge-w |
        forall w: Complex; normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
    [by generalize generalize-z]
qed

// |zw| = |z|·|w|: √(normSq(zw)) = √(normSq z · normSq w) = √(normSq z)·√(normSq w)
// (sqrtMulNonneg, both norm-squares ≥ 0).
theorem absMul: forall z, w: Complex; abs(mul(z, w)) = rmul(abs(z), abs(w))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @normsq-mul |
            normSq(mul(z, w)) = rmul(normSq(z), normSq(w))
            [using specialize normSqMul(z, w)]
          @z-norm-nonneg |
            less_or_equal(real.ZERO, normSq(z))
            [using specialize normSqNonneg(z)]
          @w-norm-nonneg |
            less_or_equal(real.ZERO, normSq(w))
            [using specialize normSqNonneg(w)]
          // abs(zw) unfolds to √(normSq zw); rewrite normSq(zw) = normSq z · normSq w.
          @abs-mul-refl |
            abs(mul(z, w)) = sqrt(normSq(mul(z, w)))
            [by reflexivity]
          @abs-mul-rewritten |
            abs(mul(z, w)) = sqrt(rmul(normSq(z), normSq(w)))
            [by rewrite normsq-mul abs-mul-refl]
          @sqrt-splits |
            sqrt(rmul(normSq(z), normSq(w))) = rmul(abs(z), abs(w))
            [using specialize real_sqrt.sqrtMulNonneg(normSq(z), normSq(w)) z-norm-nonneg w-norm-nonneg]
          @conclusion-abs-mul |
            abs(mul(z, w)) = rmul(abs(z), abs(w))
            [using chain abs-mul-rewritten sqrt-splits]
        }
      @discharge-w |
        forall w: Complex; abs(mul(z, w)) = rmul(abs(z), abs(w))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; abs(mul(z, w)) = rmul(abs(z), abs(w))
    [by generalize generalize-z]
qed

// -- the norm-square vanishes only at 0 --------------------------------------------------
// normSq(z) = re² + im² is a sum of two nonnegative reals, so it is 0 only when both
// squares are, i.e. when re(z) = im(z) = 0, i.e. z = 0. This is what makes z̄/|z|² a
// legitimate expression for z⁻¹ (Exercise 19(c)).

// (real) a ≥ 0, b ≥ 0, a + b = 0 ⟹ a = 0: otherwise 0 < a gives b = 0 + b < a + b = 0,
// against b ≥ 0.
theorem nonnegSummandOfZeroIsZero: forall a, b: Real; less_or_equal(real.ZERO, a) -> less_or_equal(real.ZERO, b) -> radd(a, b) = real.ZERO -> a = real.ZERO
proof
  @generalize-a |
    fix a: Real {
      @generalize-b |
        fix b: Real {
          @given-a-nonneg |
            assume less_or_equal(real.ZERO, a) {
              @given-b-nonneg |
                assume less_or_equal(real.ZERO, b) {
                  @given-sum-zero |
                    assume radd(a, b) = real.ZERO {
                      @a-nonneg |
                        less_than(real.ZERO, a) or real.ZERO = a
                        [by hypothesis given-a-nonneg]
                      @b-nonneg |
                        less_than(real.ZERO, b) or real.ZERO = b
                        [by hypothesis given-b-nonneg]
                      @sum-zero |
                        radd(a, b) = real.ZERO
                        [by hypothesis given-sum-zero]
                      @zero-not-below-itself |
                        not less_than(real.ZERO, real.ZERO)
                        [using specialize real.lessThanIrreflexive(real.ZERO)]
                      @conclusion-a-zero |
                        a = real.ZERO
                        case a-nonneg {
                          @when-a-positive |
                            assume less_than(real.ZERO, a) {
                              @a-positive |
                                less_than(real.ZERO, a)
                                [by hypothesis when-a-positive]
                              @shifted-by-b |
                                less_than(radd(real.ZERO, b), radd(a, b))
                                [using specialize real.lessThanAddRight(real.ZERO, a, b) a-positive]
                              @zero-plus-b |
                                radd(real.ZERO, b) = b
                                [using specialize real.addZeroLeft(b)]
                              @b-below-sum |
                                less_than(b, radd(a, b))
                                [by rewrite zero-plus-b shifted-by-b]
                              @b-below-zero |
                                less_than(b, real.ZERO)
                                [by rewrite sum-zero b-below-sum]
                              @zero-below-itself |
                                less_than(real.ZERO, real.ZERO)
                                case b-nonneg {
                                  @when-b-positive |
                                    assume less_than(real.ZERO, b) {
                                      @b-positive |
                                        less_than(real.ZERO, b)
                                        [by hypothesis when-b-positive]
                                      @zero-below-itself-via-b |
                                        less_than(real.ZERO, real.ZERO)
                                        [using specialize real.lessThanTransitive(real.ZERO, b, real.ZERO) b-positive b-below-zero]
                                    }
                                  @when-b-zero |
                                    assume real.ZERO = b {
                                      @b-zero |
                                        real.ZERO = b
                                        [by hypothesis when-b-zero]
                                      @zero-below-itself-at-b |
                                        less_than(real.ZERO, real.ZERO)
                                        [by rewrite b-zero b-below-zero]
                                    }
                                }
                              @conclusion-a-zero-absurdly |
                                a = real.ZERO
                                [by ex_falso zero-below-itself zero-not-below-itself]
                            }
                          @when-a-zero |
                            assume real.ZERO = a {
                              @a-zero |
                                real.ZERO = a
                                [by hypothesis when-a-zero]
                              @conclusion-a-is-zero |
                                a = real.ZERO
                                [by symmetry a-zero]
                            }
                        }
                    }
                  @sum-zero-implies |
                    radd(a, b) = real.ZERO -> a = real.ZERO
                    [by discharge given-sum-zero]
                }
              @b-nonneg-implies |
                less_or_equal(real.ZERO, b) -> radd(a, b) = real.ZERO -> a = real.ZERO
                [by discharge given-b-nonneg]
            }
          @a-nonneg-implies |
            less_or_equal(real.ZERO, a) -> less_or_equal(real.ZERO, b) -> radd(a, b) = real.ZERO -> a = real.ZERO
            [by discharge given-a-nonneg]
        }
      @discharge-b |
        forall b: Real; less_or_equal(real.ZERO, a) -> less_or_equal(real.ZERO, b) -> radd(a, b) = real.ZERO -> a = real.ZERO
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Real; less_or_equal(real.ZERO, a) -> less_or_equal(real.ZERO, b) -> radd(a, b) = real.ZERO -> a = real.ZERO
    [by generalize generalize-a]
qed

// normSq(z) = 0 ⟹ z = 0: both squares vanish, so both parts do (no zero divisors), so
// z = re + im·i = 0.
theorem normSqZeroGivesZero: forall z: Complex; normSq(z) = real.ZERO -> z = ZERO
proof
  @generalize-z |
    fix z: Complex {
      @given-normsq-zero |
        assume normSq(z) = real.ZERO {
          @squares-sum-to-zero |
            radd(rmul(re(z), re(z)), rmul(im(z), im(z))) = real.ZERO
            [by hypothesis given-normsq-zero]
          @re-square-nonneg |
            less_or_equal(real.ZERO, rmul(re(z), re(z)))
            [using specialize real.squareNonneg(re(z))]
          @im-square-nonneg |
            less_or_equal(real.ZERO, rmul(im(z), im(z)))
            [using specialize real.squareNonneg(im(z))]
          @re-square-zero |
            rmul(re(z), re(z)) = real.ZERO
            [using specialize nonnegSummandOfZeroIsZero(rmul(re(z), re(z)), rmul(im(z), im(z))) re-square-nonneg im-square-nonneg squares-sum-to-zero]
          @squares-commute |
            radd(rmul(re(z), re(z)), rmul(im(z), im(z))) = radd(rmul(im(z), im(z)), rmul(re(z), re(z)))
            [using specialize real.addIsCommutative(rmul(re(z), re(z)), rmul(im(z), im(z)))]
          @squares-sum-to-zero-swapped |
            radd(rmul(im(z), im(z)), rmul(re(z), re(z))) = real.ZERO
            [by rewrite squares-commute squares-sum-to-zero]
          @im-square-zero |
            rmul(im(z), im(z)) = real.ZERO
            [using specialize nonnegSummandOfZeroIsZero(rmul(im(z), im(z)), rmul(re(z), re(z))) im-square-nonneg re-square-nonneg squares-sum-to-zero-swapped]
          @re-zero-or-zero |
            re(z) = real.ZERO or re(z) = real.ZERO
            [using specialize real.noZeroDivisors(re(z), re(z)) re-square-zero]
          @re-zero |
            re(z) = real.ZERO
            [using tautology re-zero-or-zero]
          @im-zero-or-zero |
            im(z) = real.ZERO or im(z) = real.ZERO
            [using specialize real.noZeroDivisors(im(z), im(z)) im-square-zero]
          @im-zero |
            im(z) = real.ZERO
            [using tautology im-zero-or-zero]
          @z-from-parts |
            z = cadd(fromReal(re(z)), mul(fromReal(im(z)), i))
            [using specialize complex.complexParts(z)]
          @z-from-zero-real-part |
            z = cadd(fromReal(real.ZERO), mul(fromReal(im(z)), i))
            [by rewrite re-zero z-from-parts]
          @z-from-zero-parts |
            z = cadd(fromReal(real.ZERO), mul(fromReal(real.ZERO), i))
            [by rewrite im-zero z-from-zero-real-part]
          @real-zero-embeds |
            fromReal(real.ZERO) = ZERO
            [using import(complex) fromRealZero]
          @z-from-zeros |
            z = cadd(ZERO, mul(ZERO, i))
            [by rewrite real-zero-embeds z-from-zero-parts]
          @zero-times-i |
            mul(ZERO, i) = ZERO
            [using specialize complex.mulZeroLeft(i)]
          @z-is-zero-plus-zero |
            z = cadd(ZERO, ZERO)
            [by rewrite zero-times-i z-from-zeros]
          @zero-plus-zero |
            cadd(ZERO, ZERO) = ZERO
            [using specialize complex.addZeroLeft(ZERO)]
          @conclusion-z-zero |
            z = ZERO
            [using chain z-is-zero-plus-zero zero-plus-zero]
        }
      @normsq-zero-implies |
        normSq(z) = real.ZERO -> z = ZERO
        [by discharge given-normsq-zero]
    }
  @conclusion |
    forall z: Complex; normSq(z) = real.ZERO -> z = ZERO
    [by generalize generalize-z]
qed

// EXERCISE 19(c): z⁻¹ = z̄ / |z|², i.e. recip(z) = z̄ · recip(|z|²) for z ≠ 0. The candidate
// w = z̄ · recip(|z|²) satisfies z·w = (z z̄)·recip(|z|²) = |z|²·recip(|z|²) = 1, and the
// inverse is unique: recip(z) = recip(z)·(z·w) = (recip(z)·z)·w = w.
theorem recipIsConjOverNormSq: forall z: Complex; z != ZERO -> recip(z) = mul(conj(z), recip(fromReal(normSq(z))))
proof
  @generalize-z |
    fix z: Complex {
      @given-z-nonzero |
        assume z != ZERO {
          @z-nonzero |
            z != ZERO
            [by hypothesis given-z-nonzero]
          // |z|² ≠ 0, so its embedding is a nonzero complex number with a reciprocal.
          @normsq-zero-implies-zero |
            normSq(z) = real.ZERO -> z = ZERO
            [using specialize normSqZeroGivesZero(z)]
          @normsq-nonzero |
            normSq(z) != real.ZERO
            [using tautology normsq-zero-implies-zero z-nonzero]
          @real-zero-embeds |
            fromReal(real.ZERO) = ZERO
            [using import(complex) fromRealZero]
          @given-embedding-zero |
            assume fromReal(normSq(z)) = ZERO {
              @embedding-zero |
                fromReal(normSq(z)) = ZERO
                [by hypothesis given-embedding-zero]
              @zero-is-embedded-zero |
                ZERO = fromReal(real.ZERO)
                [by symmetry real-zero-embeds]
              @embeddings-agree |
                fromReal(normSq(z)) = fromReal(real.ZERO)
                [using chain embedding-zero zero-is-embedded-zero]
              @normsq-zero |
                normSq(z) = real.ZERO
                [using specialize complex.fromRealInjective(normSq(z), real.ZERO) embeddings-agree]
            }
          @embedding-zero-implies |
            fromReal(normSq(z)) = ZERO -> normSq(z) = real.ZERO
            [by discharge given-embedding-zero]
          @embedding-nonzero |
            fromReal(normSq(z)) != ZERO
            [using tautology embedding-zero-implies normsq-nonzero]
          @embedding-times-recip |
            mul(fromReal(normSq(z)), recip(fromReal(normSq(z)))) = ONE
            [using specialize complex.fieldInverse(fromReal(normSq(z))) embedding-nonzero]
          // z · w = 1 for w = z̄ · recip(|z|²).
          @z-times-conj |
            mul(z, conj(z)) = fromReal(normSq(z))
            [using specialize zTimesConjIsNormSq(z)]
          @z-times-w-regrouped |
            mul(z, mul(conj(z), recip(fromReal(normSq(z))))) = mul(mul(z, conj(z)), recip(fromReal(normSq(z))))
            [using assoc(complex.mulIsAssociative)]
          @z-times-w-via-normsq |
            mul(z, mul(conj(z), recip(fromReal(normSq(z))))) = mul(fromReal(normSq(z)), recip(fromReal(normSq(z))))
            [by rewrite z-times-conj z-times-w-regrouped]
          @z-times-w |
            mul(z, mul(conj(z), recip(fromReal(normSq(z))))) = ONE
            [using chain z-times-w-via-normsq embedding-times-recip]
          // recip(z) = recip(z)·1 = recip(z)·(z·w) = (recip(z)·z)·w = 1·w = w.
          @z-times-recip |
            mul(z, recip(z)) = ONE
            [using specialize complex.fieldInverse(z) z-nonzero]
          @recip-times-z-commuted |
            mul(recip(z), z) = mul(z, recip(z))
            [using specialize complex.mulIsCommutative(recip(z), z)]
          @recip-times-z |
            mul(recip(z), z) = ONE
            [using chain recip-times-z-commuted z-times-recip]
          @recip-times-one |
            mul(recip(z), ONE) = recip(z)
            [using specialize complex.mulOneRight(recip(z))]
          @recip-as-product-with-one |
            recip(z) = mul(recip(z), ONE)
            [by symmetry recip-times-one]
          @recip-as-product-with-z-w |
            recip(z) = mul(recip(z), mul(z, mul(conj(z), recip(fromReal(normSq(z))))))
            [by rewrite z-times-w recip-as-product-with-one]
          @recip-product-regrouped |
            mul(recip(z), mul(z, mul(conj(z), recip(fromReal(normSq(z)))))) = mul(mul(recip(z), z), mul(conj(z), recip(fromReal(normSq(z)))))
            [using assoc(complex.mulIsAssociative)]
          @recip-as-regrouped-product |
            recip(z) = mul(mul(recip(z), z), mul(conj(z), recip(fromReal(normSq(z)))))
            [using chain recip-as-product-with-z-w recip-product-regrouped]
          @recip-as-one-times-w |
            recip(z) = mul(ONE, mul(conj(z), recip(fromReal(normSq(z)))))
            [by rewrite recip-times-z recip-as-regrouped-product]
          @one-times-w |
            mul(ONE, mul(conj(z), recip(fromReal(normSq(z))))) = mul(conj(z), recip(fromReal(normSq(z))))
            [using specialize complex.mulOneLeft(mul(conj(z), recip(fromReal(normSq(z)))))]
          @conclusion-recip-is-w |
            recip(z) = mul(conj(z), recip(fromReal(normSq(z))))
            [using chain recip-as-one-times-w one-times-w]
        }
      @z-nonzero-implies |
        z != ZERO -> recip(z) = mul(conj(z), recip(fromReal(normSq(z))))
        [by discharge given-z-nonzero]
    }
  @conclusion |
    forall z: Complex; z != ZERO -> recip(z) = mul(conj(z), recip(fromReal(normSq(z))))
    [by generalize generalize-z]
qed

// -- the triangle inequality (EXERCISE 19(d)) and its reverse (19(e)) ------------------------
// |z + w|² = |z|² + |w|² + 2 re(z w̄), and re(z w̄) ≤ |z||w| (Cauchy–Schwarz: re(z w̄)² ≤
// |z w̄|² = |z|²|w|²), so |z + w|² ≤ (|z| + |w|)²; sqrt is monotone, so |z + w| ≤ |z| + |w|.

// re(z w̄) = re(z) re(w) + im(z) im(w).
theorem reOfProductWithConjugate: forall z, w: Complex; re(mul(z, conj(w))) = radd(rmul(re(z), re(w)), rmul(im(z), im(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @re-of-product |
            re(mul(z, conj(w))) = radd(rmul(re(z), re(conj(w))), rneg(rmul(im(z), im(conj(w)))))
            [using specialize complex.reMul(z, conj(w))]
          @re-of-conjugate |
            re(conj(w)) = re(w)
            [using specialize complex.reOfConj(w)]
          @im-of-conjugate |
            im(conj(w)) = rneg(im(w))
            [using specialize complex.imOfConj(w)]
          @re-of-product-real-parts |
            re(mul(z, conj(w))) = radd(rmul(re(z), re(w)), rneg(rmul(im(z), im(conj(w)))))
            [by rewrite re-of-conjugate re-of-product]
          @re-of-product-parts |
            re(mul(z, conj(w))) = radd(rmul(re(z), re(w)), rneg(rmul(im(z), rneg(im(w)))))
            [by rewrite im-of-conjugate re-of-product-real-parts]
          @signs-cancel |
            radd(rmul(re(z), re(w)), rneg(rmul(im(z), rneg(im(w))))) = radd(rmul(re(z), re(w)), rmul(im(z), im(w)))
            [using polynomial(real)]
          @conclusion-re-of-product |
            re(mul(z, conj(w))) = radd(rmul(re(z), re(w)), rmul(im(z), im(w)))
            [using chain re-of-product-parts signs-cancel]
        }
      @discharge-w |
        forall w: Complex; re(mul(z, conj(w))) = radd(rmul(re(z), re(w)), rmul(im(z), im(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; re(mul(z, conj(w))) = radd(rmul(re(z), re(w)), rmul(im(z), im(w)))
    [by generalize generalize-z]
qed

// Cauchy–Schwarz: re(z w̄)² ≤ |z w̄|² = |z|²|w|².
theorem realPartSquaredIsBoundedByNormSqProduct: forall z, w: Complex; less_or_equal(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), rmul(normSq(z), normSq(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @im-square-nonneg |
            less_or_equal(real.ZERO, rmul(im(mul(z, conj(w))), im(mul(z, conj(w)))))
            [using specialize real.squareNonneg(im(mul(z, conj(w))))]
          @re-square-refl |
            less_or_equal(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))))
            [using specialize real.lessOrEqualRefl(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))))]
          @re-square-plus-zero-bounded |
            less_or_equal(radd(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real.ZERO), radd(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), rmul(im(mul(z, conj(w))), im(mul(z, conj(w))))))
            [using specialize real.lessOrEqualAddBoth(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real.ZERO, rmul(im(mul(z, conj(w))), im(mul(z, conj(w))))) re-square-refl im-square-nonneg]
          @re-square-plus-zero |
            radd(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real.ZERO) = rmul(re(mul(z, conj(w))), re(mul(z, conj(w))))
            [using specialize real.addZeroRight(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))))]
          @re-square-bounded-by-normsq |
            less_or_equal(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), normSq(mul(z, conj(w))))
            [by rewrite re-square-plus-zero re-square-plus-zero-bounded]
          @normsq-of-product |
            normSq(mul(z, conj(w))) = rmul(normSq(z), normSq(conj(w)))
            [using specialize normSqMul(z, conj(w))]
          @normsq-of-conjugate |
            normSq(conj(w)) = normSq(w)
            [using specialize normSqConj(w)]
          @normsq-of-product-plain |
            normSq(mul(z, conj(w))) = rmul(normSq(z), normSq(w))
            [by rewrite normsq-of-conjugate normsq-of-product]
          @conclusion-cauchy-schwarz |
            less_or_equal(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), rmul(normSq(z), normSq(w)))
            [by rewrite normsq-of-product-plain re-square-bounded-by-normsq]
        }
      @discharge-w |
        forall w: Complex; less_or_equal(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), rmul(normSq(z), normSq(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; less_or_equal(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), rmul(normSq(z), normSq(w)))
    [by generalize generalize-z]
qed

// re(z w̄) ≤ |z||w|: both sides' squares compare, and |z||w| ≥ 0.
theorem realPartIsBoundedByModuli: forall z, w: Complex; less_or_equal(re(mul(z, conj(w))), rmul(abs(z), abs(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @normsq-z-nonneg |
            less_or_equal(real.ZERO, normSq(z))
            [using specialize normSqNonneg(z)]
          @normsq-w-nonneg |
            less_or_equal(real.ZERO, normSq(w))
            [using specialize normSqNonneg(w)]
          @abs-z-nonneg |
            less_or_equal(real.ZERO, abs(z))
            [using specialize sqrtNonneg(normSq(z)) normsq-z-nonneg]
          @abs-w-nonneg |
            less_or_equal(real.ZERO, abs(w))
            [using specialize sqrtNonneg(normSq(w)) normsq-w-nonneg]
          @product-nonneg |
            less_or_equal(real.ZERO, rmul(abs(z), abs(w)))
            [using specialize real.mulNonneg(abs(z), abs(w)) abs-z-nonneg abs-w-nonneg]
          @abs-z-squares |
            rmul(abs(z), abs(z)) = normSq(z)
            [using specialize sqrtSquare(normSq(z)) normsq-z-nonneg]
          @abs-w-squares |
            rmul(abs(w), abs(w)) = normSq(w)
            [using specialize sqrtSquare(normSq(w)) normsq-w-nonneg]
          @product-square-regrouped |
            rmul(rmul(abs(z), abs(w)), rmul(abs(z), abs(w))) = rmul(rmul(abs(z), abs(z)), rmul(abs(w), abs(w)))
            [using assoc_commut(real.mulIsAssociative, real.mulIsCommutative, real.mulLeftSwap)]
          @product-square-z |
            rmul(rmul(abs(z), abs(w)), rmul(abs(z), abs(w))) = rmul(normSq(z), rmul(abs(w), abs(w)))
            [by rewrite abs-z-squares product-square-regrouped]
          @product-square |
            rmul(rmul(abs(z), abs(w)), rmul(abs(z), abs(w))) = rmul(normSq(z), normSq(w))
            [by rewrite abs-w-squares product-square-z]
          @cauchy-schwarz |
            less_or_equal(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), rmul(normSq(z), normSq(w)))
            [using specialize realPartSquaredIsBoundedByNormSqProduct(z, w)]
          @squares-compare |
            less_or_equal(rmul(re(mul(z, conj(w))), re(mul(z, conj(w)))), rmul(rmul(abs(z), abs(w)), rmul(abs(z), abs(w))))
            [by rewrite product-square cauchy-schwarz]
          @conclusion-bounded |
            less_or_equal(re(mul(z, conj(w))), rmul(abs(z), abs(w)))
            [using specialize real.squareBoundGivesBound(re(mul(z, conj(w))), rmul(abs(z), abs(w))) product-nonneg squares-compare]
        }
      @discharge-w |
        forall w: Complex; less_or_equal(re(mul(z, conj(w))), rmul(abs(z), abs(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; less_or_equal(re(mul(z, conj(w))), rmul(abs(z), abs(w)))
    [by generalize generalize-z]
qed

// |z + w|² = |z|² + |w|² + 2 re(z w̄).
theorem normSqOfSum: forall z, w: Complex; normSq(cadd(z, w)) = radd(radd(normSq(z), normSq(w)), radd(re(mul(z, conj(w))), re(mul(z, conj(w)))))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @re-of-sum |
            re(cadd(z, w)) = radd(re(z), re(w))
            [using specialize complex.reAdd(z, w)]
          @im-of-sum |
            im(cadd(z, w)) = radd(im(z), im(w))
            [using specialize complex.imAdd(z, w)]
          @re-of-product |
            re(mul(z, conj(w))) = radd(rmul(re(z), re(w)), rmul(im(z), im(w)))
            [using specialize reOfProductWithConjugate(z, w)]
          @unfolded |
            normSq(cadd(z, w)) = radd(rmul(re(cadd(z, w)), re(cadd(z, w))), rmul(im(cadd(z, w)), im(cadd(z, w))))
            [by reflexivity]
          @re-expanded |
            normSq(cadd(z, w)) = radd(rmul(radd(re(z), re(w)), radd(re(z), re(w))), rmul(im(cadd(z, w)), im(cadd(z, w))))
            [by rewrite re-of-sum unfolded]
          @parts-expanded |
            normSq(cadd(z, w)) = radd(rmul(radd(re(z), re(w)), radd(re(z), re(w))), rmul(radd(im(z), im(w)), radd(im(z), im(w))))
            [by rewrite im-of-sum re-expanded]
          @squares-expand |
            radd(rmul(radd(re(z), re(w)), radd(re(z), re(w))), rmul(radd(im(z), im(w)), radd(im(z), im(w)))) = radd(radd(radd(rmul(re(z), re(z)), rmul(im(z), im(z))), radd(rmul(re(w), re(w)), rmul(im(w), im(w)))), radd(radd(rmul(re(z), re(w)), rmul(im(z), im(w))), radd(rmul(re(z), re(w)), rmul(im(z), im(w)))))
            [using polynomial(real)]
          @expanded |
            normSq(cadd(z, w)) = radd(radd(radd(rmul(re(z), re(z)), rmul(im(z), im(z))), radd(rmul(re(w), re(w)), rmul(im(w), im(w)))), radd(radd(rmul(re(z), re(w)), rmul(im(z), im(w))), radd(rmul(re(z), re(w)), rmul(im(z), im(w)))))
            [using chain parts-expanded squares-expand]
          @conclusion-normsq-of-sum |
            normSq(cadd(z, w)) = radd(radd(normSq(z), normSq(w)), radd(re(mul(z, conj(w))), re(mul(z, conj(w)))))
            [by rewrite re-of-product expanded]
        }
      @discharge-w |
        forall w: Complex; normSq(cadd(z, w)) = radd(radd(normSq(z), normSq(w)), radd(re(mul(z, conj(w))), re(mul(z, conj(w)))))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; normSq(cadd(z, w)) = radd(radd(normSq(z), normSq(w)), radd(re(mul(z, conj(w))), re(mul(z, conj(w)))))
    [by generalize generalize-z]
qed

// EXERCISE 19(d): |z + w| ≤ |z| + |w|.
theorem triangleInequality: forall z, w: Complex; less_or_equal(abs(cadd(z, w)), radd(abs(z), abs(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @real-part-bounded |
            less_or_equal(re(mul(z, conj(w))), rmul(abs(z), abs(w)))
            [using specialize realPartIsBoundedByModuli(z, w)]
          @twice-bounded |
            less_or_equal(radd(re(mul(z, conj(w))), re(mul(z, conj(w)))), radd(rmul(abs(z), abs(w)), rmul(abs(z), abs(w))))
            [using specialize real.lessOrEqualAddBoth(re(mul(z, conj(w))), rmul(abs(z), abs(w)), re(mul(z, conj(w))), rmul(abs(z), abs(w))) real-part-bounded real-part-bounded]
          @squares-refl |
            less_or_equal(radd(normSq(z), normSq(w)), radd(normSq(z), normSq(w)))
            [using specialize real.lessOrEqualRefl(radd(normSq(z), normSq(w)))]
          @expansion-bounded |
            less_or_equal(radd(radd(normSq(z), normSq(w)), radd(re(mul(z, conj(w))), re(mul(z, conj(w))))), radd(radd(normSq(z), normSq(w)), radd(rmul(abs(z), abs(w)), rmul(abs(z), abs(w)))))
            [using specialize real.lessOrEqualAddBoth(radd(normSq(z), normSq(w)), radd(normSq(z), normSq(w)), radd(re(mul(z, conj(w))), re(mul(z, conj(w)))), radd(rmul(abs(z), abs(w)), rmul(abs(z), abs(w)))) squares-refl twice-bounded]
          @normsq-of-sum |
            normSq(cadd(z, w)) = radd(radd(normSq(z), normSq(w)), radd(re(mul(z, conj(w))), re(mul(z, conj(w)))))
            [using specialize normSqOfSum(z, w)]
          @normsq-of-sum-bounded |
            less_or_equal(normSq(cadd(z, w)), radd(radd(normSq(z), normSq(w)), radd(rmul(abs(z), abs(w)), rmul(abs(z), abs(w)))))
            [by rewrite normsq-of-sum expansion-bounded]
          @normsq-z-nonneg |
            less_or_equal(real.ZERO, normSq(z))
            [using specialize normSqNonneg(z)]
          @normsq-w-nonneg |
            less_or_equal(real.ZERO, normSq(w))
            [using specialize normSqNonneg(w)]
          @abs-z-squares |
            rmul(abs(z), abs(z)) = normSq(z)
            [using specialize sqrtSquare(normSq(z)) normsq-z-nonneg]
          @abs-w-squares |
            rmul(abs(w), abs(w)) = normSq(w)
            [using specialize sqrtSquare(normSq(w)) normsq-w-nonneg]
          @square-of-sum-expands |
            rmul(radd(abs(z), abs(w)), radd(abs(z), abs(w))) = radd(radd(rmul(abs(z), abs(z)), rmul(abs(w), abs(w))), radd(rmul(abs(z), abs(w)), rmul(abs(z), abs(w))))
            [using polynomial(real)]
          @square-of-sum-z |
            rmul(radd(abs(z), abs(w)), radd(abs(z), abs(w))) = radd(radd(normSq(z), rmul(abs(w), abs(w))), radd(rmul(abs(z), abs(w)), rmul(abs(z), abs(w))))
            [by rewrite abs-z-squares square-of-sum-expands]
          @square-of-sum |
            rmul(radd(abs(z), abs(w)), radd(abs(z), abs(w))) = radd(radd(normSq(z), normSq(w)), radd(rmul(abs(z), abs(w)), rmul(abs(z), abs(w))))
            [by rewrite abs-w-squares square-of-sum-z]
          @normsq-of-sum-at-most-square |
            less_or_equal(normSq(cadd(z, w)), rmul(radd(abs(z), abs(w)), radd(abs(z), abs(w))))
            [by rewrite square-of-sum normsq-of-sum-bounded]
          @normsq-of-sum-nonneg |
            less_or_equal(real.ZERO, normSq(cadd(z, w)))
            [using specialize normSqNonneg(cadd(z, w))]
          @roots-ordered |
            less_or_equal(sqrt(normSq(cadd(z, w))), sqrt(rmul(radd(abs(z), abs(w)), radd(abs(z), abs(w)))))
            [using specialize sqrtMonotone(normSq(cadd(z, w)), rmul(radd(abs(z), abs(w)), radd(abs(z), abs(w)))) normsq-of-sum-nonneg normsq-of-sum-at-most-square]
          @abs-z-nonneg |
            less_or_equal(real.ZERO, abs(z))
            [using specialize sqrtNonneg(normSq(z)) normsq-z-nonneg]
          @abs-w-nonneg |
            less_or_equal(real.ZERO, abs(w))
            [using specialize sqrtNonneg(normSq(w)) normsq-w-nonneg]
          @sum-of-moduli-nonneg |
            less_or_equal(real.ZERO, radd(abs(z), abs(w)))
            [using specialize real.addNonneg(abs(z), abs(w)) abs-z-nonneg abs-w-nonneg]
          @root-of-square |
            sqrt(rmul(radd(abs(z), abs(w)), radd(abs(z), abs(w)))) = radd(abs(z), abs(w))
            [using specialize sqrtOfSquare(radd(abs(z), abs(w))) sum-of-moduli-nonneg]
          @conclusion-triangle |
            less_or_equal(abs(cadd(z, w)), radd(abs(z), abs(w)))
            [by rewrite root-of-square roots-ordered]
        }
      @discharge-w |
        forall w: Complex; less_or_equal(abs(cadd(z, w)), radd(abs(z), abs(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; less_or_equal(abs(cadd(z, w)), radd(abs(z), abs(w)))
    [by generalize generalize-z]
qed

// |w − z| = |z − w|: the parts are negated, and squares forget signs.
theorem normSqOfDifferenceIsSymmetric: forall z, w: Complex; normSq(cadd(w, cneg(z))) = normSq(cadd(z, cneg(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @re-of-wz |
            re(cadd(w, cneg(z))) = radd(re(w), re(cneg(z)))
            [using specialize complex.reAdd(w, cneg(z))]
          @im-of-wz |
            im(cadd(w, cneg(z))) = radd(im(w), im(cneg(z)))
            [using specialize complex.imAdd(w, cneg(z))]
          @re-of-neg-z |
            re(cneg(z)) = rneg(re(z))
            [using specialize complex.reNeg(z)]
          @im-of-neg-z |
            im(cneg(z)) = rneg(im(z))
            [using specialize complex.imNeg(z)]
          @re-of-zw |
            re(cadd(z, cneg(w))) = radd(re(z), re(cneg(w)))
            [using specialize complex.reAdd(z, cneg(w))]
          @im-of-zw |
            im(cadd(z, cneg(w))) = radd(im(z), im(cneg(w)))
            [using specialize complex.imAdd(z, cneg(w))]
          @re-of-neg-w |
            re(cneg(w)) = rneg(re(w))
            [using specialize complex.reNeg(w)]
          @im-of-neg-w |
            im(cneg(w)) = rneg(im(w))
            [using specialize complex.imNeg(w)]
          @wz-unfolded |
            normSq(cadd(w, cneg(z))) = radd(rmul(re(cadd(w, cneg(z))), re(cadd(w, cneg(z)))), rmul(im(cadd(w, cneg(z))), im(cadd(w, cneg(z)))))
            [by reflexivity]
          @wz-re |
            normSq(cadd(w, cneg(z))) = radd(rmul(radd(re(w), re(cneg(z))), radd(re(w), re(cneg(z)))), rmul(im(cadd(w, cneg(z))), im(cadd(w, cneg(z)))))
            [by rewrite re-of-wz wz-unfolded]
          @wz-re-im |
            normSq(cadd(w, cneg(z))) = radd(rmul(radd(re(w), re(cneg(z))), radd(re(w), re(cneg(z)))), rmul(radd(im(w), im(cneg(z))), radd(im(w), im(cneg(z)))))
            [by rewrite im-of-wz wz-re]
          @wz-re-neg |
            normSq(cadd(w, cneg(z))) = radd(rmul(radd(re(w), rneg(re(z))), radd(re(w), rneg(re(z)))), rmul(radd(im(w), im(cneg(z))), radd(im(w), im(cneg(z)))))
            [by rewrite re-of-neg-z wz-re-im]
          @wz-parts |
            normSq(cadd(w, cneg(z))) = radd(rmul(radd(re(w), rneg(re(z))), radd(re(w), rneg(re(z)))), rmul(radd(im(w), rneg(im(z))), radd(im(w), rneg(im(z)))))
            [by rewrite im-of-neg-z wz-re-neg]
          @zw-unfolded |
            normSq(cadd(z, cneg(w))) = radd(rmul(re(cadd(z, cneg(w))), re(cadd(z, cneg(w)))), rmul(im(cadd(z, cneg(w))), im(cadd(z, cneg(w)))))
            [by reflexivity]
          @zw-re |
            normSq(cadd(z, cneg(w))) = radd(rmul(radd(re(z), re(cneg(w))), radd(re(z), re(cneg(w)))), rmul(im(cadd(z, cneg(w))), im(cadd(z, cneg(w)))))
            [by rewrite re-of-zw zw-unfolded]
          @zw-re-im |
            normSq(cadd(z, cneg(w))) = radd(rmul(radd(re(z), re(cneg(w))), radd(re(z), re(cneg(w)))), rmul(radd(im(z), im(cneg(w))), radd(im(z), im(cneg(w)))))
            [by rewrite im-of-zw zw-re]
          @zw-re-neg |
            normSq(cadd(z, cneg(w))) = radd(rmul(radd(re(z), rneg(re(w))), radd(re(z), rneg(re(w)))), rmul(radd(im(z), im(cneg(w))), radd(im(z), im(cneg(w)))))
            [by rewrite re-of-neg-w zw-re-im]
          @zw-parts |
            normSq(cadd(z, cneg(w))) = radd(rmul(radd(re(z), rneg(re(w))), radd(re(z), rneg(re(w)))), rmul(radd(im(z), rneg(im(w))), radd(im(z), rneg(im(w)))))
            [by rewrite im-of-neg-w zw-re-neg]
          @parts-agree |
            radd(rmul(radd(re(w), rneg(re(z))), radd(re(w), rneg(re(z)))), rmul(radd(im(w), rneg(im(z))), radd(im(w), rneg(im(z))))) = radd(rmul(radd(re(z), rneg(re(w))), radd(re(z), rneg(re(w)))), rmul(radd(im(z), rneg(im(w))), radd(im(z), rneg(im(w)))))
            [using polynomial(real)]
          @zw-parts-flipped |
            radd(rmul(radd(re(z), rneg(re(w))), radd(re(z), rneg(re(w)))), rmul(radd(im(z), rneg(im(w))), radd(im(z), rneg(im(w))))) = normSq(cadd(z, cneg(w)))
            [by symmetry zw-parts]
          @conclusion-symmetric |
            normSq(cadd(w, cneg(z))) = normSq(cadd(z, cneg(w)))
            [using chain wz-parts parts-agree zw-parts-flipped]
        }
      @discharge-w |
        forall w: Complex; normSq(cadd(w, cneg(z))) = normSq(cadd(z, cneg(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; normSq(cadd(w, cneg(z))) = normSq(cadd(z, cneg(w)))
    [by generalize generalize-z]
qed

// EXERCISE 19(e): |z| − |w| ≤ |z − w| and |w| − |z| ≤ |z − w|, i.e. ||z| − |w|| ≤ |z − w|.
// From the triangle inequality at z = (z − w) + w and at w = (w − z) + z.
theorem reverseTriangleInequality: forall z, w: Complex; less_or_equal(radd(abs(z), rneg(abs(w))), abs(cadd(z, cneg(w)))) and less_or_equal(radd(abs(w), rneg(abs(z))), abs(cadd(z, cneg(w))))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          // |z| ≤ |z − w| + |w|.
          @z-recovered |
            cadd(cadd(z, cneg(w)), w) = z
            [using polynomial(complex)]
          @triangle-at-z |
            less_or_equal(abs(cadd(cadd(z, cneg(w)), w)), radd(abs(cadd(z, cneg(w))), abs(w)))
            [using specialize triangleInequality(cadd(z, cneg(w)), w)]
          @abs-z-bounded |
            less_or_equal(abs(z), radd(abs(cadd(z, cneg(w))), abs(w)))
            [by rewrite z-recovered triangle-at-z]
          @abs-z-shifted |
            less_or_equal(radd(abs(z), rneg(abs(w))), radd(radd(abs(cadd(z, cneg(w))), abs(w)), rneg(abs(w))))
            [using specialize real.lessOrEqualAddRight(abs(z), radd(abs(cadd(z, cneg(w))), abs(w)), rneg(abs(w))) abs-z-bounded]
          @w-regrouped |
            radd(radd(abs(cadd(z, cneg(w))), abs(w)), rneg(abs(w))) = radd(abs(cadd(z, cneg(w))), radd(abs(w), rneg(abs(w))))
            [using specialize real.addIsAssociative(abs(cadd(z, cneg(w))), abs(w), rneg(abs(w)))]
          @w-minus-w |
            radd(abs(w), rneg(abs(w))) = real.ZERO
            [using specialize real.addNegRight(abs(w))]
          @w-cancelled-to-zero |
            radd(radd(abs(cadd(z, cneg(w))), abs(w)), rneg(abs(w))) = radd(abs(cadd(z, cneg(w))), real.ZERO)
            [by rewrite w-minus-w w-regrouped]
          @plus-zero-w |
            radd(abs(cadd(z, cneg(w))), real.ZERO) = abs(cadd(z, cneg(w)))
            [using specialize real.addZeroRight(abs(cadd(z, cneg(w))))]
          @w-cancels |
            radd(radd(abs(cadd(z, cneg(w))), abs(w)), rneg(abs(w))) = abs(cadd(z, cneg(w)))
            [using chain w-cancelled-to-zero plus-zero-w]
          @first-bound |
            less_or_equal(radd(abs(z), rneg(abs(w))), abs(cadd(z, cneg(w))))
            [by rewrite w-cancels abs-z-shifted]
          // |w| ≤ |w − z| + |z|, and |w − z| = |z − w|.
          @w-recovered |
            cadd(cadd(w, cneg(z)), z) = w
            [using polynomial(complex)]
          @triangle-at-w |
            less_or_equal(abs(cadd(cadd(w, cneg(z)), z)), radd(abs(cadd(w, cneg(z))), abs(z)))
            [using specialize triangleInequality(cadd(w, cneg(z)), z)]
          @abs-w-bounded-raw |
            less_or_equal(abs(w), radd(abs(cadd(w, cneg(z))), abs(z)))
            [by rewrite w-recovered triangle-at-w]
          @difference-symmetric |
            normSq(cadd(w, cneg(z))) = normSq(cadd(z, cneg(w)))
            [using specialize normSqOfDifferenceIsSymmetric(z, w)]
          @abs-w-bounded |
            less_or_equal(abs(w), radd(abs(cadd(z, cneg(w))), abs(z)))
            [by rewrite difference-symmetric abs-w-bounded-raw]
          @abs-w-shifted |
            less_or_equal(radd(abs(w), rneg(abs(z))), radd(radd(abs(cadd(z, cneg(w))), abs(z)), rneg(abs(z))))
            [using specialize real.lessOrEqualAddRight(abs(w), radd(abs(cadd(z, cneg(w))), abs(z)), rneg(abs(z))) abs-w-bounded]
          @z-regrouped |
            radd(radd(abs(cadd(z, cneg(w))), abs(z)), rneg(abs(z))) = radd(abs(cadd(z, cneg(w))), radd(abs(z), rneg(abs(z))))
            [using specialize real.addIsAssociative(abs(cadd(z, cneg(w))), abs(z), rneg(abs(z)))]
          @z-minus-z |
            radd(abs(z), rneg(abs(z))) = real.ZERO
            [using specialize real.addNegRight(abs(z))]
          @z-cancelled-to-zero |
            radd(radd(abs(cadd(z, cneg(w))), abs(z)), rneg(abs(z))) = radd(abs(cadd(z, cneg(w))), real.ZERO)
            [by rewrite z-minus-z z-regrouped]
          @plus-zero-z |
            radd(abs(cadd(z, cneg(w))), real.ZERO) = abs(cadd(z, cneg(w)))
            [using specialize real.addZeroRight(abs(cadd(z, cneg(w))))]
          @z-cancels |
            radd(radd(abs(cadd(z, cneg(w))), abs(z)), rneg(abs(z))) = abs(cadd(z, cneg(w)))
            [using chain z-cancelled-to-zero plus-zero-z]
          @second-bound |
            less_or_equal(radd(abs(w), rneg(abs(z))), abs(cadd(z, cneg(w))))
            [by rewrite z-cancels abs-w-shifted]
          @conclusion-reverse-triangle |
            less_or_equal(radd(abs(z), rneg(abs(w))), abs(cadd(z, cneg(w)))) and less_or_equal(radd(abs(w), rneg(abs(z))), abs(cadd(z, cneg(w))))
            [by both first-bound second-bound]
        }
      @discharge-w |
        forall w: Complex; less_or_equal(radd(abs(z), rneg(abs(w))), abs(cadd(z, cneg(w)))) and less_or_equal(radd(abs(w), rneg(abs(z))), abs(cadd(z, cneg(w))))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; less_or_equal(radd(abs(z), rneg(abs(w))), abs(cadd(z, cneg(w)))) and less_or_equal(radd(abs(w), rneg(abs(z))), abs(cadd(z, cneg(w))))
    [by generalize generalize-z]
qed
