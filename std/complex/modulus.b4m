// std/complex/modulus.b4m — the MODULUS |z| on ℂ and its multiplicative structure.
//
// Built on std/complex.b4m (ℂ as a field with re/im projections + conjugation as a
// derived ring involution) and std/real/sqrt.b4m (√ on the nonnegative reals). The
// norm-square normSq(z) = re(z)² + im(z)² is a nonnegative real; the modulus is its
// square root, abs(z) = √(normSq z). We prove the coordinate-free identities the
// AATA §4.2 exercises ask for: |z̄| = |z|, z·z̄ = |z|², and |zw| = |z|·|w|.
//
// The multiplicative identities go through CONJUGATION (conjMul + zTimesConj), never
// through re/im of a product, so no imaginary-unit cross terms arise; the remaining
// real-algebra obligations are discharged by `polynomial(real)`. `define` is
// definitional, so normSq/abs unfold on contact — no explicit fold steps needed.

import complex <<< "std/complex.b4m"
import real <<< "std/real.b4m"
import real_sqrt <<< "std/real.b4m"

sort Complex = complex.Complex
const ZERO = complex.ZERO
func mul = complex.mul
func conj = complex.conj
func fromReal = complex.fromReal
func re = complex.re
func im = complex.im

sort Real = real.Real
func real_add = real.add
func real_mul = real.mul
func sqrt = real_sqrt.sqrt
pred less_or_equal = real.less_or_equal
pred less_than = real.less_than
const ONE = complex.ONE
func recip = complex.recip
func add = complex.add
const i = complex.i
func cneg = complex.neg
func rneg = real.neg
fact sqrtNonneg = real_sqrt.sqrtNonneg
fact sqrtSquare = real_sqrt.sqrtSquare
fact sqrtOfSquare = real_sqrt.sqrtOfSquare
fact sqrtMonotone = real_sqrt.sqrtMonotone

// the norm-square (a real) and the modulus (its nonnegative square root).
define normSq(z) = real_add(real_mul(re(z), re(z)), real_mul(im(z), im(z)))

// `abs` is a REAL FUNCTION, not a `define`, and that is forced by `sqrt` being GUARDED. A
// `define` is a macro: every `abs(z)` would expand to `sqrt(normSq(z))` and re-raise the
// guard `0 <= normSq(z)` at the use site — including inside a DISCHARGED CONCLUSION, where
// nothing can discharge it. As a function the obligation is met ONCE, here, against the
// unconditional `normSqNonneg`; callers then write `abs(z)` freely, which is exactly right
// because the modulus really is total on ℂ.
func abs(z: Complex) => Real
axiom absIsTheRootOfTheNormSquare: forall z: Complex; abs(z) = sqrt(normSq(z))

// The modulus is nonnegative — `sqrt` lands in the nonnegatives and `normSq` is always in its
// domain. A THEOREM now rather than an inline `sqrtNonneg` citation: `abs` is an opaque
// function since `sqrt` became guarded, so `0 <= sqrt(normSq(z))` no longer reads as
// `0 <= abs(z)` on sight.
intheory absNonneg
intheory absOfDifferenceIsSymmetric
intheory absSquared

// normSq is nonnegative: a sum of two squares, each ≥ 0.
theorem normSqNonneg: forall z: Complex; less_or_equal(real.ZERO, normSq(z))
proof
  @generalize-z |
    fix z: Complex {
      @re-square-nonneg |
        less_or_equal(real.ZERO, real_mul(re(z), re(z)))
        [using specialize real.squareNonneg(re(z))]
      @im-square-nonneg |
        less_or_equal(real.ZERO, real_mul(im(z), im(z)))
        [using specialize real.squareNonneg(im(z))]
      @conclusion-normsq-nonneg |
        less_or_equal(real.ZERO, normSq(z))
        [using specialize real.addNonneg(real_mul(re(z), re(z)), real_mul(im(z), im(z))) re-square-nonneg im-square-nonneg]
    }
  @conclusion |
    forall z: Complex; less_or_equal(real.ZERO, normSq(z))
    [by generalize generalize-z]
qed

theorem absNonneg: forall z: Complex; less_or_equal(real.ZERO, abs(z))
proof
  @generalize-z |
    fix z: Complex {
      @the-norm-is-nonneg |
        less_or_equal(real.ZERO, normSq(z))
        [using specialize normSqNonneg(z)]
      @the-root-is-nonneg |
        less_or_equal(real.ZERO, sqrt(normSq(z)))
        [using specialize sqrtNonneg(normSq(z)) the-norm-is-nonneg]
      @abs-unfolds |
        abs(z) = sqrt(normSq(z))
        [using specialize absIsTheRootOfTheNormSquare(z)]
      @conclusion-abs-nonneg |
        less_or_equal(real.ZERO, abs(z))
        [by rewrite abs-unfolds the-root-is-nonneg]
    }
  @conclusion |
    forall z: Complex; less_or_equal(real.ZERO, abs(z))
    [by generalize generalize-z]
qed

// |z|² = normSq(z): the modulus squares back, since normSq is in `sqrt`'s domain. Also a
// theorem now, for the same reason as `absNonneg`.
theorem absSquared: forall z: Complex; real_mul(abs(z), abs(z)) = normSq(z)
proof
  @generalize-z |
    fix z: Complex {
      @the-norm-is-nonneg |
        less_or_equal(real.ZERO, normSq(z))
        [using specialize normSqNonneg(z)]
      @the-root-squares-back |
        real_mul(sqrt(normSq(z)), sqrt(normSq(z))) = normSq(z)
        [using specialize sqrtSquare(normSq(z)) the-norm-is-nonneg]
      @abs-unfolds |
        abs(z) = sqrt(normSq(z))
        [using specialize absIsTheRootOfTheNormSquare(z)]
      @conclusion-abs-squared |
        real_mul(abs(z), abs(z)) = normSq(z)
        [by rewrite abs-unfolds the-root-squares-back]
    }
  @conclusion |
    forall z: Complex; real_mul(abs(z), abs(z)) = normSq(z)
    [by generalize generalize-z]
qed

// z·z̄ = |z|² (as an embedded real). This is complex.zTimesConj, whose RHS is
// definitionally normSq(z).
theorem zTimesConjIsNormSq: forall z: Complex; mul(z, conj(z)) = fromReal(normSq(z))
proof
  @generalize-z |
    fix z: Complex {
      @conclusion-zzconj |
        mul(z, conj(z)) = fromReal(normSq(z))
        [using specialize complex.zTimesConj(z)]
    }
  @conclusion |
    forall z: Complex; mul(z, conj(z)) = fromReal(normSq(z))
    [by generalize generalize-z]
qed

// normSq(z̄) = normSq(z): re(z̄)² + im(z̄)² = re(z)² + (−im z)² = re(z)² + im(z)².
theorem normSqConj: forall z: Complex; normSq(conj(z)) = normSq(z)
proof
  @generalize-z |
    fix z: Complex {
      @re-conj |
        re(conj(z)) = re(z)
        [using specialize complex.reOfConj(z)]
      @im-conj |
        im(conj(z)) = real.neg(im(z))
        [using specialize complex.imOfConj(z)]
      // normSq(conj z) unfolds definitionally to re(conj z)² + im(conj z)².
      @with-re |
        normSq(conj(z)) = real_add(real_mul(re(z), re(z)), real_mul(im(conj(z)), im(conj(z))))
        [by rewrite re-conj]
      @with-im |
        normSq(conj(z)) = real_add(real_mul(re(z), re(z)), real_mul(real.neg(im(z)), real.neg(im(z))))
        [by rewrite im-conj with-re]
      @neg-square-is-square |
        real_add(real_mul(re(z), re(z)), real_mul(real.neg(im(z)), real.neg(im(z)))) = normSq(z)
        [using polynomial(real)]
      @conclusion-normsq-conj |
        normSq(conj(z)) = normSq(z)
        [using chain with-im neg-square-is-square]
    }
  @conclusion |
    forall z: Complex; normSq(conj(z)) = normSq(z)
    [by generalize generalize-z]
qed

// |z̄| = |z|: immediate from normSqConj under √ (abs unfolds definitionally to √∘normSq).
theorem absConj: forall z: Complex; abs(conj(z)) = abs(z)
proof
  @generalize-z |
    fix z: Complex {
      @normsq-conj |
        normSq(conj(z)) = normSq(z)
        [using specialize normSqConj(z)]
      // `sqrt` is GUARDED: every application owes `0 <= its argument` where written, and a
      // norm-square is always nonnegative.
      @conj-normsq-nonneg |
        less_or_equal(real.ZERO, normSq(conj(z)))
        [using specialize normSqNonneg(conj(z))]
      @z-normsq-nonneg |
        less_or_equal(real.ZERO, normSq(z))
        [using specialize normSqNonneg(z)]
      @abs-conj-refl |
        abs(conj(z)) = sqrt(normSq(conj(z)))
        [using specialize absIsTheRootOfTheNormSquare(conj(z))]
      @abs-z-refl |
        abs(z) = sqrt(normSq(z))
        [using specialize absIsTheRootOfTheNormSquare(z)]
      // rewrite normSq(conj z) -> normSq z INSIDE the unfolded form, then fold back to abs
      @abs-conj-as-the-z-root |
        abs(conj(z)) = sqrt(normSq(z))
        [by rewrite normsq-conj abs-conj-refl]
      @the-z-root-is-abs-z |
        sqrt(normSq(z)) = abs(z)
        [by symmetry abs-z-refl]
      @conclusion-abs-conj |
        abs(conj(z)) = abs(z)
        [using chain abs-conj-as-the-z-root the-z-root-is-abs-z]
    }
  @conclusion |
    forall z: Complex; abs(conj(z)) = abs(z)
    [by generalize generalize-z]
qed

// normSq is multiplicative: normSq(zw) = normSq(z)·normSq(w). Via conjugation:
// fromReal(normSq(zw)) = zw·conj(zw) = (z z̄)(w w̄) = fromReal(normSq z)·fromReal(normSq w)
// = fromReal(normSq z · normSq w); then fromRealInjective.
theorem normSqMul: forall z, w: Complex; normSq(mul(z, w)) = real_mul(normSq(z), normSq(w))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @zz |
            mul(z, conj(z)) = fromReal(normSq(z))
            [using specialize zTimesConjIsNormSq(z)]
          @ww |
            mul(w, conj(w)) = fromReal(normSq(w))
            [using specialize zTimesConjIsNormSq(w)]
          @zwzw |
            mul(mul(z, w), conj(mul(z, w))) = fromReal(normSq(mul(z, w)))
            [using specialize zTimesConjIsNormSq(mul(z, w))]
          @conj-zw |
            conj(mul(z, w)) = mul(conj(z), conj(w))
            [using specialize complex.conjMul(z, w)]
          // (zw)·conj(zw) = (zw)·(z̄ w̄) = (z z̄)·(w w̄) by commutative reassociation.
          @expand-with-conj |
            mul(mul(z, w), conj(mul(z, w))) = mul(mul(z, w), mul(conj(z), conj(w)))
            [by rewrite conj-zw]
          @regroup |
            mul(mul(z, w), mul(conj(z), conj(w))) = mul(mul(z, conj(z)), mul(w, conj(w)))
            [using polynomial(complex)]
          @regroup-to-norms |
            mul(mul(z, w), conj(mul(z, w))) = mul(mul(z, conj(z)), mul(w, conj(w)))
            [using chain expand-with-conj regroup]
          @with-zz |
            mul(mul(z, w), conj(mul(z, w))) = mul(fromReal(normSq(z)), mul(w, conj(w)))
            [by rewrite zz regroup-to-norms]
          @with-ww |
            mul(mul(z, w), conj(mul(z, w))) = mul(fromReal(normSq(z)), fromReal(normSq(w)))
            [by rewrite ww with-zz]
          // fromReal is multiplicative: fromReal(a)·fromReal(b) = fromReal(a·b).
          @fromreal-mul |
            fromReal(real_mul(normSq(z), normSq(w))) = mul(fromReal(normSq(z)), fromReal(normSq(w)))
            [using specialize complex.fromRealMul(normSq(z), normSq(w))]
          @zwconj-is-fromreal-prod |
            mul(mul(z, w), conj(mul(z, w))) = fromReal(real_mul(normSq(z), normSq(w)))
            [by rewrite fromreal-mul with-ww]
          // fromReal(normSq zw) = fromReal(normSq z · normSq w), then injectivity.
          @zwzw-flipped |
            fromReal(normSq(mul(z, w))) = mul(mul(z, w), conj(mul(z, w)))
            [by symmetry zwzw]
          @fromreal-eq |
            fromReal(normSq(mul(z, w))) = fromReal(real_mul(normSq(z), normSq(w)))
            [using chain zwzw-flipped zwconj-is-fromreal-prod]
          @conclusion-normsq-mul |
            normSq(mul(z, w)) = real_mul(normSq(z), normSq(w))
            [using specialize complex.fromRealInjective(normSq(mul(z, w)), real_mul(normSq(z), normSq(w))) fromreal-eq]
        }
      @discharge-w |
        forall w: Complex; normSq(mul(z, w)) = real_mul(normSq(z), normSq(w))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; normSq(mul(z, w)) = real_mul(normSq(z), normSq(w))
    [by generalize generalize-z]
qed

// |zw| = |z|·|w|: √(normSq(zw)) = √(normSq z · normSq w) = √(normSq z)·√(normSq w)
// (sqrtMulNonneg, both norm-squares ≥ 0).
theorem absMul: forall z, w: Complex; abs(mul(z, w)) = real_mul(abs(z), abs(w))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @normsq-mul |
            normSq(mul(z, w)) = real_mul(normSq(z), normSq(w))
            [using specialize normSqMul(z, w)]
          @z-norm-nonneg |
            less_or_equal(real.ZERO, normSq(z))
            [using specialize normSqNonneg(z)]
          @w-norm-nonneg |
            less_or_equal(real.ZERO, normSq(w))
            [using specialize normSqNonneg(w)]
          // `sqrt` is GUARDED, so each application owes `0 <= its argument`: the product's
          // own norm-square, and the product of the two norm-squares (which is also
          // `sqrtMulNonneg`'s third premise now).
          @product-norm-nonneg |
            less_or_equal(real.ZERO, normSq(mul(z, w)))
            [using specialize normSqNonneg(mul(z, w))]
          @norms-product-nonneg |
            less_or_equal(real.ZERO, real_mul(normSq(z), normSq(w)))
            [using specialize real.mulNonneg(normSq(z), normSq(w)) z-norm-nonneg w-norm-nonneg]
          // abs(zw) unfolds to √(normSq zw); rewrite normSq(zw) = normSq z · normSq w.
          @abs-mul-refl |
            abs(mul(z, w)) = sqrt(normSq(mul(z, w)))
            [using specialize absIsTheRootOfTheNormSquare(mul(z, w))]
          @abs-mul-rewritten |
            abs(mul(z, w)) = sqrt(real_mul(normSq(z), normSq(w)))
            [by rewrite normsq-mul abs-mul-refl]
          @abs-z-unfolds |
            abs(z) = sqrt(normSq(z))
            [using specialize absIsTheRootOfTheNormSquare(z)]
          @abs-w-unfolds |
            abs(w) = sqrt(normSq(w))
            [using specialize absIsTheRootOfTheNormSquare(w)]
          @sqrt-splits |
            sqrt(real_mul(normSq(z), normSq(w))) = real_mul(sqrt(normSq(z)), sqrt(normSq(w)))
            [using specialize real_sqrt.sqrtMulNonneg(normSq(z), normSq(w)) z-norm-nonneg w-norm-nonneg norms-product-nonneg]
          // fold the two roots back to abs: rewrite each factor by its defining equation
          @the-split-with-abs-z |
            sqrt(real_mul(normSq(z), normSq(w))) = real_mul(abs(z), sqrt(normSq(w)))
            [by rewrite abs-z-unfolds sqrt-splits]
          @the-split-with-both |
            sqrt(real_mul(normSq(z), normSq(w))) = real_mul(abs(z), abs(w))
            [by rewrite abs-w-unfolds the-split-with-abs-z]
          @conclusion-abs-mul |
            abs(mul(z, w)) = real_mul(abs(z), abs(w))
            [using chain abs-mul-rewritten the-split-with-both]
        }
      @discharge-w |
        forall w: Complex; abs(mul(z, w)) = real_mul(abs(z), abs(w))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; abs(mul(z, w)) = real_mul(abs(z), abs(w))
    [by generalize generalize-z]
qed

// -- the norm-square vanishes only at 0 --------------------------------------------------
// normSq(z) = re² + im² is a sum of two nonnegative reals, so it is 0 only when both
// squares are, i.e. when re(z) = im(z) = 0, i.e. z = 0. This is what makes z̄/|z|² a
// legitimate expression for z⁻¹ (Exercise 19(c)).

// (real) a ≥ 0, b ≥ 0, a + b = 0 ⟹ a = 0: otherwise 0 < a gives b = 0 + b < a + b = 0,
// against b ≥ 0.
theorem nonnegSummandOfZeroIsZero: forall a, b: Real; less_or_equal(real.ZERO, a) -> less_or_equal(real.ZERO, b) -> real_add(a, b) = real.ZERO -> a = real.ZERO
proof
  @generalize-a |
    fix a: Real {
      @generalize-b |
        fix b: Real {
          @given-a-nonneg |
            assume less_or_equal(real.ZERO, a) {
              @given-b-nonneg |
                assume less_or_equal(real.ZERO, b) {
                  @given-sum-zero |
                    assume real_add(a, b) = real.ZERO {
                      @a-nonneg |
                        less_than(real.ZERO, a) or real.ZERO = a
                        [by hypothesis given-a-nonneg]
                      @b-nonneg |
                        less_than(real.ZERO, b) or real.ZERO = b
                        [by hypothesis given-b-nonneg]
                      @sum-zero |
                        real_add(a, b) = real.ZERO
                        [by hypothesis given-sum-zero]
                      @zero-not-below-itself |
                        not less_than(real.ZERO, real.ZERO)
                        [using specialize real.lessThanIrreflexive(real.ZERO)]
                      @conclusion-a-zero |
                        a = real.ZERO
                        case a-nonneg {
                          @when-a-positive |
                            assume less_than(real.ZERO, a) {
                              @a-positive |
                                less_than(real.ZERO, a)
                                [by hypothesis when-a-positive]
                              @shifted-by-b |
                                less_than(real_add(real.ZERO, b), real_add(a, b))
                                [using specialize real.lessThanAddRight(real.ZERO, a, b) a-positive]
                              @zero-plus-b |
                                real_add(real.ZERO, b) = b
                                [using specialize real.addZeroLeft(b)]
                              @b-below-sum |
                                less_than(b, real_add(a, b))
                                [by rewrite zero-plus-b shifted-by-b]
                              @b-below-zero |
                                less_than(b, real.ZERO)
                                [by rewrite sum-zero b-below-sum]
                              @zero-below-itself |
                                less_than(real.ZERO, real.ZERO)
                                case b-nonneg {
                                  @when-b-positive |
                                    assume less_than(real.ZERO, b) {
                                      @b-positive |
                                        less_than(real.ZERO, b)
                                        [by hypothesis when-b-positive]
                                      @zero-below-itself-via-b |
                                        less_than(real.ZERO, real.ZERO)
                                        [using specialize real.lessThanTransitive(real.ZERO, b, real.ZERO) b-positive b-below-zero]
                                    }
                                  @when-b-zero |
                                    assume real.ZERO = b {
                                      @b-zero |
                                        real.ZERO = b
                                        [by hypothesis when-b-zero]
                                      @zero-below-itself-at-b |
                                        less_than(real.ZERO, real.ZERO)
                                        [by rewrite b-zero b-below-zero]
                                    }
                                }
                              @conclusion-a-zero-absurdly |
                                a = real.ZERO
                                [by ex_falso zero-below-itself zero-not-below-itself]
                            }
                          @when-a-zero |
                            assume real.ZERO = a {
                              @a-zero |
                                real.ZERO = a
                                [by hypothesis when-a-zero]
                              @conclusion-a-is-zero |
                                a = real.ZERO
                                [by symmetry a-zero]
                            }
                        }
                    }
                  @sum-zero-implies |
                    real_add(a, b) = real.ZERO -> a = real.ZERO
                    [by discharge given-sum-zero]
                }
              @b-nonneg-implies |
                less_or_equal(real.ZERO, b) -> real_add(a, b) = real.ZERO -> a = real.ZERO
                [by discharge given-b-nonneg]
            }
          @a-nonneg-implies |
            less_or_equal(real.ZERO, a) -> less_or_equal(real.ZERO, b) -> real_add(a, b) = real.ZERO -> a = real.ZERO
            [by discharge given-a-nonneg]
        }
      @discharge-b |
        forall b: Real; less_or_equal(real.ZERO, a) -> less_or_equal(real.ZERO, b) -> real_add(a, b) = real.ZERO -> a = real.ZERO
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Real; less_or_equal(real.ZERO, a) -> less_or_equal(real.ZERO, b) -> real_add(a, b) = real.ZERO -> a = real.ZERO
    [by generalize generalize-a]
qed

// normSq(z) = 0 ⟹ z = 0: both squares vanish, so both parts do (no zero divisors), so
// z = re + im·i = 0.
theorem normSqZeroGivesZero: forall z: Complex; normSq(z) = real.ZERO -> z = ZERO
proof
  @generalize-z |
    fix z: Complex {
      @given-normsq-zero |
        assume normSq(z) = real.ZERO {
          @squares-sum-to-zero |
            real_add(real_mul(re(z), re(z)), real_mul(im(z), im(z))) = real.ZERO
            [by hypothesis given-normsq-zero]
          @re-square-nonneg |
            less_or_equal(real.ZERO, real_mul(re(z), re(z)))
            [using specialize real.squareNonneg(re(z))]
          @im-square-nonneg |
            less_or_equal(real.ZERO, real_mul(im(z), im(z)))
            [using specialize real.squareNonneg(im(z))]
          @re-square-zero |
            real_mul(re(z), re(z)) = real.ZERO
            [using specialize nonnegSummandOfZeroIsZero(real_mul(re(z), re(z)), real_mul(im(z), im(z))) re-square-nonneg im-square-nonneg squares-sum-to-zero]
          @squares-commute |
            real_add(real_mul(re(z), re(z)), real_mul(im(z), im(z))) = real_add(real_mul(im(z), im(z)), real_mul(re(z), re(z)))
            [using specialize real.addIsCommutative(real_mul(re(z), re(z)), real_mul(im(z), im(z)))]
          @squares-sum-to-zero-swapped |
            real_add(real_mul(im(z), im(z)), real_mul(re(z), re(z))) = real.ZERO
            [by rewrite squares-commute squares-sum-to-zero]
          @im-square-zero |
            real_mul(im(z), im(z)) = real.ZERO
            [using specialize nonnegSummandOfZeroIsZero(real_mul(im(z), im(z)), real_mul(re(z), re(z))) im-square-nonneg re-square-nonneg squares-sum-to-zero-swapped]
          @re-zero-or-zero |
            re(z) = real.ZERO or re(z) = real.ZERO
            [using specialize real.noZeroDivisors(re(z), re(z)) re-square-zero]
          @re-zero |
            re(z) = real.ZERO
            [using tautology re-zero-or-zero]
          @im-zero-or-zero |
            im(z) = real.ZERO or im(z) = real.ZERO
            [using specialize real.noZeroDivisors(im(z), im(z)) im-square-zero]
          @im-zero |
            im(z) = real.ZERO
            [using tautology im-zero-or-zero]
          @z-from-parts |
            z = add(fromReal(re(z)), mul(fromReal(im(z)), i))
            [using specialize complex.complexParts(z)]
          @z-from-zero-real-part |
            z = add(fromReal(real.ZERO), mul(fromReal(im(z)), i))
            [by rewrite re-zero z-from-parts]
          @z-from-zero-parts |
            z = add(fromReal(real.ZERO), mul(fromReal(real.ZERO), i))
            [by rewrite im-zero z-from-zero-real-part]
          @real-zero-embeds |
            fromReal(real.ZERO) = ZERO
            [using import(complex) fromRealZero]
          @z-from-zeros |
            z = add(ZERO, mul(ZERO, i))
            [by rewrite real-zero-embeds z-from-zero-parts]
          @zero-times-i |
            mul(ZERO, i) = ZERO
            [using specialize complex.mulZeroLeft(i)]
          @z-is-zero-plus-zero |
            z = add(ZERO, ZERO)
            [by rewrite zero-times-i z-from-zeros]
          @zero-plus-zero |
            add(ZERO, ZERO) = ZERO
            [using specialize complex.addZeroLeft(ZERO)]
          @conclusion-z-zero |
            z = ZERO
            [using chain z-is-zero-plus-zero zero-plus-zero]
        }
      @normsq-zero-implies |
        normSq(z) = real.ZERO -> z = ZERO
        [by discharge given-normsq-zero]
    }
  @conclusion |
    forall z: Complex; normSq(z) = real.ZERO -> z = ZERO
    [by generalize generalize-z]
qed

// EXERCISE 19(c): z⁻¹ = z̄ / |z|², i.e. recip(z) = z̄ · recip(|z|²) for z ≠ 0. The candidate
// w = z̄ · recip(|z|²) satisfies z·w = (z z̄)·recip(|z|²) = |z|²·recip(|z|²) = 1, and the
// inverse is unique: recip(z) = recip(z)·(z·w) = (recip(z)·z)·w = w.
// BOTH reciprocals in the conclusion live outside the assume, so BOTH guards must be met
// from the antecedent — `recip` is guarded and the checker matches obligations syntactically.
// The second is derivable from the first (a nonzero complex has nonzero norm², proved below as
// `theEmbeddedNormSqIsNonzero`) but a derivation inside the proof cannot discharge a guard in
// the CONCLUSION, so it is stated.
// |z|² ≠ 0 for z ≠ 0, as the PREDICATE: `recip(fromReal(normSq(z)))` owes this guard, and a
// caller of `recipIsConjOverNormSq` needs it in the antecedent (the conclusion's term lies
// outside the assume). Extracted so that theorem keeps a single hypothesis.
theorem theEmbeddedNormSqIsNonzero: forall z: Complex;
  complex.nonzero(z) -> complex.nonzero(fromReal(normSq(z)))
proof
  @generalize-z |
    fix z: Complex {
      @given-z-nonzero |
        assume complex.nonzero(z) {
          @z-is-nonzero |
            complex.nonzero(z)
            [by hypothesis given-z-nonzero]
          @z-characterized |
            complex.nonzero(z) iff (not (z = ZERO))
            [using specialize complex.nonzeroMeaning(z)]
          @z-nonzero |
            z != ZERO
            [using tautology z-characterized z-is-nonzero]
          @normsq-zero-implies-zero |
            normSq(z) = real.ZERO -> z = ZERO
            [using specialize normSqZeroGivesZero(z)]
          @normsq-nonzero |
            normSq(z) != real.ZERO
            [using tautology normsq-zero-implies-zero z-nonzero]
          @real-zero-embeds |
            fromReal(real.ZERO) = ZERO
            [using import(complex) fromRealZero]
          @given-embedding-zero |
            assume fromReal(normSq(z)) = ZERO {
              @embedding-zero |
                fromReal(normSq(z)) = ZERO
                [by hypothesis given-embedding-zero]
              @zero-is-embedded-zero |
                ZERO = fromReal(real.ZERO)
                [by symmetry real-zero-embeds]
              @embeddings-agree |
                fromReal(normSq(z)) = fromReal(real.ZERO)
                [using chain embedding-zero zero-is-embedded-zero]
              @normsq-zero |
                normSq(z) = real.ZERO
                [using specialize complex.fromRealInjective(normSq(z), real.ZERO) embeddings-agree]
            }
          @embedding-zero-implies |
            fromReal(normSq(z)) = ZERO -> normSq(z) = real.ZERO
            [by discharge given-embedding-zero]
          @embedding-nonzero |
            fromReal(normSq(z)) != ZERO
            [using tautology embedding-zero-implies normsq-nonzero]
          @embedding-characterized |
            complex.nonzero(fromReal(normSq(z))) iff (not (fromReal(normSq(z)) = ZERO))
            [using specialize complex.nonzeroMeaning(fromReal(normSq(z)))]
          @conclusion-the-embedding-is-nonzero |
            complex.nonzero(fromReal(normSq(z)))
            [using tautology embedding-characterized embedding-nonzero]
        }
      @z-nonzero-implies |
        complex.nonzero(z) -> complex.nonzero(fromReal(normSq(z)))
        [by discharge given-z-nonzero]
    }
  @conclusion |
    forall z: Complex; complex.nonzero(z) -> complex.nonzero(fromReal(normSq(z)))
    [by generalize generalize-z]
qed

theorem recipIsConjOverNormSq: forall z: Complex; complex.nonzero(z) -> complex.nonzero(fromReal(normSq(z))) -> recip(z) = mul(conj(z), recip(fromReal(normSq(z))))
proof
  @generalize-z |
    fix z: Complex {
      @given-z-nonzero |
        assume complex.nonzero(z) {
          @given-the-norm-is-nonzero |
            assume complex.nonzero(fromReal(normSq(z))) {
              @z-is-nonzero |
                complex.nonzero(z)
                [by hypothesis given-z-nonzero]
              // the disequation too: the normSq argument is derived from it
              @z-characterized |
                complex.nonzero(z) iff (not (z = ZERO))
                [using specialize complex.nonzeroMeaning(z)]
              @z-nonzero |
                z != ZERO
                [using tautology z-characterized z-is-nonzero]
              // |z|² ≠ 0, so its embedding is a nonzero complex number with a reciprocal.
              @normsq-zero-implies-zero |
                normSq(z) = real.ZERO -> z = ZERO
                [using specialize normSqZeroGivesZero(z)]
              @normsq-nonzero |
                normSq(z) != real.ZERO
                [using tautology normsq-zero-implies-zero z-nonzero]
              @real-zero-embeds |
                fromReal(real.ZERO) = ZERO
                [using import(complex) fromRealZero]
              @given-embedding-zero |
                assume fromReal(normSq(z)) = ZERO {
                  @embedding-zero |
                    fromReal(normSq(z)) = ZERO
                    [by hypothesis given-embedding-zero]
                  @zero-is-embedded-zero |
                    ZERO = fromReal(real.ZERO)
                    [by symmetry real-zero-embeds]
                  @embeddings-agree |
                    fromReal(normSq(z)) = fromReal(real.ZERO)
                    [using chain embedding-zero zero-is-embedded-zero]
                  @normsq-zero |
                    normSq(z) = real.ZERO
                    [using specialize complex.fromRealInjective(normSq(z), real.ZERO) embeddings-agree]
                }
              @embedding-zero-implies |
                fromReal(normSq(z)) = ZERO -> normSq(z) = real.ZERO
                [by discharge given-embedding-zero]
              @embedding-nonzero |
                fromReal(normSq(z)) != ZERO
                [using tautology embedding-zero-implies normsq-nonzero]
              // `recip` is guarded by the PREDICATE, matched syntactically — bridge via its clause
              @embedding-characterized |
                complex.nonzero(fromReal(normSq(z))) iff (not (fromReal(normSq(z)) = ZERO))
                [using specialize complex.nonzeroMeaning(fromReal(normSq(z)))]
              @embedding-is-nonzero |
                complex.nonzero(fromReal(normSq(z)))
                [using tautology embedding-characterized embedding-nonzero]
              @embedding-times-recip |
                mul(fromReal(normSq(z)), recip(fromReal(normSq(z)))) = ONE
                [using specialize complex.fieldInverse(fromReal(normSq(z))) embedding-is-nonzero]
              // z · w = 1 for w = z̄ · recip(|z|²).
              @z-times-conj |
                mul(z, conj(z)) = fromReal(normSq(z))
                [using specialize zTimesConjIsNormSq(z)]
              @z-times-w-regrouped |
                mul(z, mul(conj(z), recip(fromReal(normSq(z))))) = mul(mul(z, conj(z)), recip(fromReal(normSq(z))))
                [using assoc(complex.mulIsAssociative)]
              @z-times-w-via-normsq |
                mul(z, mul(conj(z), recip(fromReal(normSq(z))))) = mul(fromReal(normSq(z)), recip(fromReal(normSq(z))))
                [by rewrite z-times-conj z-times-w-regrouped]
              @z-times-w |
                mul(z, mul(conj(z), recip(fromReal(normSq(z))))) = ONE
                [using chain z-times-w-via-normsq embedding-times-recip]
              // recip(z) = recip(z)·1 = recip(z)·(z·w) = (recip(z)·z)·w = 1·w = w.
              @z-times-recip |
                mul(z, recip(z)) = ONE
                [using specialize complex.fieldInverse(z) z-is-nonzero]
              @recip-times-z-commuted |
                mul(recip(z), z) = mul(z, recip(z))
                [using specialize complex.mulIsCommutative(recip(z), z)]
              @recip-times-z |
                mul(recip(z), z) = ONE
                [using chain recip-times-z-commuted z-times-recip]
              @recip-times-one |
                mul(recip(z), ONE) = recip(z)
                [using specialize complex.mulOneRight(recip(z))]
              @recip-as-product-with-one |
                recip(z) = mul(recip(z), ONE)
                [by symmetry recip-times-one]
              @recip-as-product-with-z-w |
                recip(z) = mul(recip(z), mul(z, mul(conj(z), recip(fromReal(normSq(z))))))
                [by rewrite z-times-w recip-as-product-with-one]
              @recip-product-regrouped |
                mul(recip(z), mul(z, mul(conj(z), recip(fromReal(normSq(z)))))) = mul(mul(recip(z), z), mul(conj(z), recip(fromReal(normSq(z)))))
                [using assoc(complex.mulIsAssociative)]
              @recip-as-regrouped-product |
                recip(z) = mul(mul(recip(z), z), mul(conj(z), recip(fromReal(normSq(z)))))
                [using chain recip-as-product-with-z-w recip-product-regrouped]
              @recip-as-one-times-w |
                recip(z) = mul(ONE, mul(conj(z), recip(fromReal(normSq(z)))))
                [by rewrite recip-times-z recip-as-regrouped-product]
              @one-times-w |
                mul(ONE, mul(conj(z), recip(fromReal(normSq(z))))) = mul(conj(z), recip(fromReal(normSq(z))))
                [using specialize complex.mulOneLeft(mul(conj(z), recip(fromReal(normSq(z)))))]
              @conclusion-recip-is-w |
                recip(z) = mul(conj(z), recip(fromReal(normSq(z))))
                [using chain recip-as-one-times-w one-times-w]
            }
          @the-norm-implies |
            complex.nonzero(fromReal(normSq(z))) -> recip(z) = mul(conj(z), recip(fromReal(normSq(z))))
            [by discharge given-the-norm-is-nonzero]
        }
      @z-nonzero-implies |
        complex.nonzero(z) -> complex.nonzero(fromReal(normSq(z))) -> recip(z) = mul(conj(z), recip(fromReal(normSq(z))))
        [by discharge given-z-nonzero]
    }
  @conclusion |
    forall z: Complex; complex.nonzero(z) -> complex.nonzero(fromReal(normSq(z))) -> recip(z) = mul(conj(z), recip(fromReal(normSq(z))))
    [by generalize generalize-z]
qed

// -- the triangle inequality (EXERCISE 19(d)) and its reverse (19(e)) ------------------------
// |z + w|² = |z|² + |w|² + 2 re(z w̄), and re(z w̄) ≤ |z||w| (Cauchy–Schwarz: re(z w̄)² ≤
// |z w̄|² = |z|²|w|²), so |z + w|² ≤ (|z| + |w|)²; sqrt is monotone, so |z + w| ≤ |z| + |w|.

// re(z w̄) = re(z) re(w) + im(z) im(w).
theorem reOfProductWithConjugate: forall z, w: Complex; re(mul(z, conj(w))) = real_add(real_mul(re(z), re(w)), real_mul(im(z), im(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @re-of-product |
            re(mul(z, conj(w))) = real_add(real_mul(re(z), re(conj(w))), rneg(real_mul(im(z), im(conj(w)))))
            [using specialize complex.reMul(z, conj(w))]
          @re-of-conjugate |
            re(conj(w)) = re(w)
            [using specialize complex.reOfConj(w)]
          @im-of-conjugate |
            im(conj(w)) = rneg(im(w))
            [using specialize complex.imOfConj(w)]
          @re-of-product-real-parts |
            re(mul(z, conj(w))) = real_add(real_mul(re(z), re(w)), rneg(real_mul(im(z), im(conj(w)))))
            [by rewrite re-of-conjugate re-of-product]
          @re-of-product-parts |
            re(mul(z, conj(w))) = real_add(real_mul(re(z), re(w)), rneg(real_mul(im(z), rneg(im(w)))))
            [by rewrite im-of-conjugate re-of-product-real-parts]
          @signs-cancel |
            real_add(real_mul(re(z), re(w)), rneg(real_mul(im(z), rneg(im(w))))) = real_add(real_mul(re(z), re(w)), real_mul(im(z), im(w)))
            [using polynomial(real)]
          @conclusion-re-of-product |
            re(mul(z, conj(w))) = real_add(real_mul(re(z), re(w)), real_mul(im(z), im(w)))
            [using chain re-of-product-parts signs-cancel]
        }
      @discharge-w |
        forall w: Complex; re(mul(z, conj(w))) = real_add(real_mul(re(z), re(w)), real_mul(im(z), im(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; re(mul(z, conj(w))) = real_add(real_mul(re(z), re(w)), real_mul(im(z), im(w)))
    [by generalize generalize-z]
qed

// Cauchy–Schwarz: re(z w̄)² ≤ |z w̄|² = |z|²|w|².
theorem realPartSquaredIsBoundedByNormSqProduct: forall z, w: Complex; less_or_equal(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_mul(normSq(z), normSq(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @im-square-nonneg |
            less_or_equal(real.ZERO, real_mul(im(mul(z, conj(w))), im(mul(z, conj(w)))))
            [using specialize real.squareNonneg(im(mul(z, conj(w))))]
          @re-square-refl |
            less_or_equal(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))))
            [using specialize real.lessOrEqualRefl(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))))]
          @re-square-plus-zero-bounded |
            less_or_equal(real_add(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real.ZERO), real_add(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_mul(im(mul(z, conj(w))), im(mul(z, conj(w))))))
            [using specialize real.lessOrEqualAddBoth(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real.ZERO, real_mul(im(mul(z, conj(w))), im(mul(z, conj(w))))) re-square-refl im-square-nonneg]
          @re-square-plus-zero |
            real_add(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real.ZERO) = real_mul(re(mul(z, conj(w))), re(mul(z, conj(w))))
            [using specialize real.addZeroRight(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))))]
          @re-square-bounded-by-normsq |
            less_or_equal(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), normSq(mul(z, conj(w))))
            [by rewrite re-square-plus-zero re-square-plus-zero-bounded]
          @normsq-of-product |
            normSq(mul(z, conj(w))) = real_mul(normSq(z), normSq(conj(w)))
            [using specialize normSqMul(z, conj(w))]
          @normsq-of-conjugate |
            normSq(conj(w)) = normSq(w)
            [using specialize normSqConj(w)]
          @normsq-of-product-plain |
            normSq(mul(z, conj(w))) = real_mul(normSq(z), normSq(w))
            [by rewrite normsq-of-conjugate normsq-of-product]
          @conclusion-cauchy-schwarz |
            less_or_equal(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_mul(normSq(z), normSq(w)))
            [by rewrite normsq-of-product-plain re-square-bounded-by-normsq]
        }
      @discharge-w |
        forall w: Complex; less_or_equal(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_mul(normSq(z), normSq(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; less_or_equal(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_mul(normSq(z), normSq(w)))
    [by generalize generalize-z]
qed

// re(z w̄) ≤ |z||w|: both sides' squares compare, and |z||w| ≥ 0.
theorem realPartIsBoundedByModuli: forall z, w: Complex; less_or_equal(re(mul(z, conj(w))), real_mul(abs(z), abs(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @abs-z-nonneg |
            less_or_equal(real.ZERO, abs(z))
            [using specialize absNonneg(z)]
          @abs-w-nonneg |
            less_or_equal(real.ZERO, abs(w))
            [using specialize absNonneg(w)]
          @product-nonneg |
            less_or_equal(real.ZERO, real_mul(abs(z), abs(w)))
            [using specialize real.mulNonneg(abs(z), abs(w)) abs-z-nonneg abs-w-nonneg]
          @abs-z-squares |
            real_mul(abs(z), abs(z)) = normSq(z)
            [using specialize absSquared(z)]
          @abs-w-squares |
            real_mul(abs(w), abs(w)) = normSq(w)
            [using specialize absSquared(w)]
          @product-square-regrouped |
            real_mul(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w))) = real_mul(real_mul(abs(z), abs(z)), real_mul(abs(w), abs(w)))
            [using assoc_commut(real.mulIsAssociative, real.mulIsCommutative, real.mulLeftSwap)]
          @product-square-z |
            real_mul(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w))) = real_mul(normSq(z), real_mul(abs(w), abs(w)))
            [by rewrite abs-z-squares product-square-regrouped]
          @product-square |
            real_mul(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w))) = real_mul(normSq(z), normSq(w))
            [by rewrite abs-w-squares product-square-z]
          @cauchy-schwarz |
            less_or_equal(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_mul(normSq(z), normSq(w)))
            [using specialize realPartSquaredIsBoundedByNormSqProduct(z, w)]
          @squares-compare |
            less_or_equal(real_mul(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_mul(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w))))
            [by rewrite product-square cauchy-schwarz]
          @conclusion-bounded |
            less_or_equal(re(mul(z, conj(w))), real_mul(abs(z), abs(w)))
            [using specialize real.squareBoundGivesBound(re(mul(z, conj(w))), real_mul(abs(z), abs(w))) product-nonneg squares-compare]
        }
      @discharge-w |
        forall w: Complex; less_or_equal(re(mul(z, conj(w))), real_mul(abs(z), abs(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; less_or_equal(re(mul(z, conj(w))), real_mul(abs(z), abs(w)))
    [by generalize generalize-z]
qed

// |z + w|² = |z|² + |w|² + 2 re(z w̄).
theorem normSqOfSum: forall z, w: Complex; normSq(add(z, w)) = real_add(real_add(normSq(z), normSq(w)), real_add(re(mul(z, conj(w))), re(mul(z, conj(w)))))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @re-of-sum |
            re(add(z, w)) = real_add(re(z), re(w))
            [using specialize complex.reAdd(z, w)]
          @im-of-sum |
            im(add(z, w)) = real_add(im(z), im(w))
            [using specialize complex.imAdd(z, w)]
          @re-of-product |
            re(mul(z, conj(w))) = real_add(real_mul(re(z), re(w)), real_mul(im(z), im(w)))
            [using specialize reOfProductWithConjugate(z, w)]
          @re-expanded |
            normSq(add(z, w)) = real_add(real_mul(real_add(re(z), re(w)), real_add(re(z), re(w))), real_mul(im(add(z, w)), im(add(z, w))))
            [by rewrite re-of-sum]
          @parts-expanded |
            normSq(add(z, w)) = real_add(real_mul(real_add(re(z), re(w)), real_add(re(z), re(w))), real_mul(real_add(im(z), im(w)), real_add(im(z), im(w))))
            [by rewrite im-of-sum re-expanded]
          @squares-expand |
            real_add(real_mul(real_add(re(z), re(w)), real_add(re(z), re(w))), real_mul(real_add(im(z), im(w)), real_add(im(z), im(w)))) = real_add(real_add(real_add(real_mul(re(z), re(z)), real_mul(im(z), im(z))), real_add(real_mul(re(w), re(w)), real_mul(im(w), im(w)))), real_add(real_add(real_mul(re(z), re(w)), real_mul(im(z), im(w))), real_add(real_mul(re(z), re(w)), real_mul(im(z), im(w)))))
            [using polynomial(real)]
          @expanded |
            normSq(add(z, w)) = real_add(real_add(real_add(real_mul(re(z), re(z)), real_mul(im(z), im(z))), real_add(real_mul(re(w), re(w)), real_mul(im(w), im(w)))), real_add(real_add(real_mul(re(z), re(w)), real_mul(im(z), im(w))), real_add(real_mul(re(z), re(w)), real_mul(im(z), im(w)))))
            [using chain parts-expanded squares-expand]
          @conclusion-normsq-of-sum |
            normSq(add(z, w)) = real_add(real_add(normSq(z), normSq(w)), real_add(re(mul(z, conj(w))), re(mul(z, conj(w)))))
            [by rewrite re-of-product expanded]
        }
      @discharge-w |
        forall w: Complex; normSq(add(z, w)) = real_add(real_add(normSq(z), normSq(w)), real_add(re(mul(z, conj(w))), re(mul(z, conj(w)))))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; normSq(add(z, w)) = real_add(real_add(normSq(z), normSq(w)), real_add(re(mul(z, conj(w))), re(mul(z, conj(w)))))
    [by generalize generalize-z]
qed

// EXERCISE 19(d): |z + w| ≤ |z| + |w|.
theorem triangleInequality: forall z, w: Complex; less_or_equal(abs(add(z, w)), real_add(abs(z), abs(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @real-part-bounded |
            less_or_equal(re(mul(z, conj(w))), real_mul(abs(z), abs(w)))
            [using specialize realPartIsBoundedByModuli(z, w)]
          @twice-bounded |
            less_or_equal(real_add(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_add(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w))))
            [using specialize real.lessOrEqualAddBoth(re(mul(z, conj(w))), real_mul(abs(z), abs(w)), re(mul(z, conj(w))), real_mul(abs(z), abs(w))) real-part-bounded real-part-bounded]
          @squares-refl |
            less_or_equal(real_add(normSq(z), normSq(w)), real_add(normSq(z), normSq(w)))
            [using specialize real.lessOrEqualRefl(real_add(normSq(z), normSq(w)))]
          @expansion-bounded |
            less_or_equal(real_add(real_add(normSq(z), normSq(w)), real_add(re(mul(z, conj(w))), re(mul(z, conj(w))))), real_add(real_add(normSq(z), normSq(w)), real_add(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w)))))
            [using specialize real.lessOrEqualAddBoth(real_add(normSq(z), normSq(w)), real_add(normSq(z), normSq(w)), real_add(re(mul(z, conj(w))), re(mul(z, conj(w)))), real_add(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w)))) squares-refl twice-bounded]
          @normsq-of-sum |
            normSq(add(z, w)) = real_add(real_add(normSq(z), normSq(w)), real_add(re(mul(z, conj(w))), re(mul(z, conj(w)))))
            [using specialize normSqOfSum(z, w)]
          @normsq-of-sum-bounded |
            less_or_equal(normSq(add(z, w)), real_add(real_add(normSq(z), normSq(w)), real_add(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w)))))
            [by rewrite normsq-of-sum expansion-bounded]
          @abs-z-squares |
            real_mul(abs(z), abs(z)) = normSq(z)
            [using specialize absSquared(z)]
          @abs-w-squares |
            real_mul(abs(w), abs(w)) = normSq(w)
            [using specialize absSquared(w)]
          @square-of-sum-expands |
            real_mul(real_add(abs(z), abs(w)), real_add(abs(z), abs(w))) = real_add(real_add(real_mul(abs(z), abs(z)), real_mul(abs(w), abs(w))), real_add(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w))))
            [using polynomial(real)]
          @square-of-sum-z |
            real_mul(real_add(abs(z), abs(w)), real_add(abs(z), abs(w))) = real_add(real_add(normSq(z), real_mul(abs(w), abs(w))), real_add(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w))))
            [by rewrite abs-z-squares square-of-sum-expands]
          @square-of-sum |
            real_mul(real_add(abs(z), abs(w)), real_add(abs(z), abs(w))) = real_add(real_add(normSq(z), normSq(w)), real_add(real_mul(abs(z), abs(w)), real_mul(abs(z), abs(w))))
            [by rewrite abs-w-squares square-of-sum-z]
          @normsq-of-sum-at-most-square |
            less_or_equal(normSq(add(z, w)), real_mul(real_add(abs(z), abs(w)), real_add(abs(z), abs(w))))
            [by rewrite square-of-sum normsq-of-sum-bounded]
          @normsq-of-sum-nonneg |
            less_or_equal(real.ZERO, normSq(add(z, w)))
            [using specialize normSqNonneg(add(z, w))]
          // `sqrtMonotone` now takes `0 <= y` too (its conclusion writes `sqrt(y)`), and here
          // y is a SQUARE — nonnegative regardless of the sum's sign.
          @the-bound-square-is-nonneg |
            less_or_equal(real.ZERO, real_mul(real_add(abs(z), abs(w)), real_add(abs(z), abs(w))))
            [using specialize real.squareNonneg(real_add(abs(z), abs(w)))]
          @roots-ordered |
            less_or_equal(sqrt(normSq(add(z, w))), sqrt(real_mul(real_add(abs(z), abs(w)), real_add(abs(z), abs(w)))))
            [using specialize sqrtMonotone(normSq(add(z, w)), real_mul(real_add(abs(z), abs(w)), real_add(abs(z), abs(w)))) normsq-of-sum-nonneg the-bound-square-is-nonneg normsq-of-sum-at-most-square]
          @abs-z-nonneg |
            less_or_equal(real.ZERO, abs(z))
            [using specialize absNonneg(z)]
          @abs-w-nonneg |
            less_or_equal(real.ZERO, abs(w))
            [using specialize absNonneg(w)]
          @sum-of-moduli-nonneg |
            less_or_equal(real.ZERO, real_add(abs(z), abs(w)))
            [using specialize real.addNonneg(abs(z), abs(w)) abs-z-nonneg abs-w-nonneg]
          @root-of-square |
            sqrt(real_mul(real_add(abs(z), abs(w)), real_add(abs(z), abs(w)))) = real_add(abs(z), abs(w))
            [using specialize sqrtOfSquare(real_add(abs(z), abs(w))) sum-of-moduli-nonneg]
          // fold BOTH sides back to abs: the RHS root collapses by `sqrtOfSquare`, and the
          // LHS is `abs(z+w)` by its defining equation.
          @the-rhs-folded |
            less_or_equal(sqrt(normSq(add(z, w))), real_add(abs(z), abs(w)))
            [by rewrite root-of-square roots-ordered]
          @abs-of-the-sum-unfolds |
            abs(add(z, w)) = sqrt(normSq(add(z, w)))
            [using specialize absIsTheRootOfTheNormSquare(add(z, w))]
          @conclusion-triangle |
            less_or_equal(abs(add(z, w)), real_add(abs(z), abs(w)))
            [by rewrite abs-of-the-sum-unfolds the-rhs-folded]
        }
      @discharge-w |
        forall w: Complex; less_or_equal(abs(add(z, w)), real_add(abs(z), abs(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; less_or_equal(abs(add(z, w)), real_add(abs(z), abs(w)))
    [by generalize generalize-z]
qed

// |w − z| = |z − w|: the parts are negated, and squares forget signs.
theorem normSqOfDifferenceIsSymmetric: forall z, w: Complex; normSq(add(w, cneg(z))) = normSq(add(z, cneg(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          @re-of-wz |
            re(add(w, cneg(z))) = real_add(re(w), re(cneg(z)))
            [using specialize complex.reAdd(w, cneg(z))]
          @im-of-wz |
            im(add(w, cneg(z))) = real_add(im(w), im(cneg(z)))
            [using specialize complex.imAdd(w, cneg(z))]
          @re-of-neg-z |
            re(cneg(z)) = rneg(re(z))
            [using specialize complex.reNeg(z)]
          @im-of-neg-z |
            im(cneg(z)) = rneg(im(z))
            [using specialize complex.imNeg(z)]
          @re-of-zw |
            re(add(z, cneg(w))) = real_add(re(z), re(cneg(w)))
            [using specialize complex.reAdd(z, cneg(w))]
          @im-of-zw |
            im(add(z, cneg(w))) = real_add(im(z), im(cneg(w)))
            [using specialize complex.imAdd(z, cneg(w))]
          @re-of-neg-w |
            re(cneg(w)) = rneg(re(w))
            [using specialize complex.reNeg(w)]
          @im-of-neg-w |
            im(cneg(w)) = rneg(im(w))
            [using specialize complex.imNeg(w)]
          @wz-re |
            normSq(add(w, cneg(z))) = real_add(real_mul(real_add(re(w), re(cneg(z))), real_add(re(w), re(cneg(z)))), real_mul(im(add(w, cneg(z))), im(add(w, cneg(z)))))
            [by rewrite re-of-wz]
          @wz-re-im |
            normSq(add(w, cneg(z))) = real_add(real_mul(real_add(re(w), re(cneg(z))), real_add(re(w), re(cneg(z)))), real_mul(real_add(im(w), im(cneg(z))), real_add(im(w), im(cneg(z)))))
            [by rewrite im-of-wz wz-re]
          @wz-re-neg |
            normSq(add(w, cneg(z))) = real_add(real_mul(real_add(re(w), rneg(re(z))), real_add(re(w), rneg(re(z)))), real_mul(real_add(im(w), im(cneg(z))), real_add(im(w), im(cneg(z)))))
            [by rewrite re-of-neg-z wz-re-im]
          @wz-parts |
            normSq(add(w, cneg(z))) = real_add(real_mul(real_add(re(w), rneg(re(z))), real_add(re(w), rneg(re(z)))), real_mul(real_add(im(w), rneg(im(z))), real_add(im(w), rneg(im(z)))))
            [by rewrite im-of-neg-z wz-re-neg]
          @zw-re |
            normSq(add(z, cneg(w))) = real_add(real_mul(real_add(re(z), re(cneg(w))), real_add(re(z), re(cneg(w)))), real_mul(im(add(z, cneg(w))), im(add(z, cneg(w)))))
            [by rewrite re-of-zw]
          @zw-re-im |
            normSq(add(z, cneg(w))) = real_add(real_mul(real_add(re(z), re(cneg(w))), real_add(re(z), re(cneg(w)))), real_mul(real_add(im(z), im(cneg(w))), real_add(im(z), im(cneg(w)))))
            [by rewrite im-of-zw zw-re]
          @zw-re-neg |
            normSq(add(z, cneg(w))) = real_add(real_mul(real_add(re(z), rneg(re(w))), real_add(re(z), rneg(re(w)))), real_mul(real_add(im(z), im(cneg(w))), real_add(im(z), im(cneg(w)))))
            [by rewrite re-of-neg-w zw-re-im]
          @zw-parts |
            normSq(add(z, cneg(w))) = real_add(real_mul(real_add(re(z), rneg(re(w))), real_add(re(z), rneg(re(w)))), real_mul(real_add(im(z), rneg(im(w))), real_add(im(z), rneg(im(w)))))
            [by rewrite im-of-neg-w zw-re-neg]
          @parts-agree |
            real_add(real_mul(real_add(re(w), rneg(re(z))), real_add(re(w), rneg(re(z)))), real_mul(real_add(im(w), rneg(im(z))), real_add(im(w), rneg(im(z))))) = real_add(real_mul(real_add(re(z), rneg(re(w))), real_add(re(z), rneg(re(w)))), real_mul(real_add(im(z), rneg(im(w))), real_add(im(z), rneg(im(w)))))
            [using polynomial(real)]
          @zw-parts-flipped |
            real_add(real_mul(real_add(re(z), rneg(re(w))), real_add(re(z), rneg(re(w)))), real_mul(real_add(im(z), rneg(im(w))), real_add(im(z), rneg(im(w))))) = normSq(add(z, cneg(w)))
            [by symmetry zw-parts]
          @conclusion-symmetric |
            normSq(add(w, cneg(z))) = normSq(add(z, cneg(w)))
            [using chain wz-parts parts-agree zw-parts-flipped]
        }
      @discharge-w |
        forall w: Complex; normSq(add(w, cneg(z))) = normSq(add(z, cneg(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; normSq(add(w, cneg(z))) = normSq(add(z, cneg(w)))
    [by generalize generalize-z]
qed

// |w − z| = |z − w|, the abs-level companion. Needed as its own theorem because `abs` is an
// opaque function now (`sqrt` being guarded), so the normSq symmetry above no longer rewrites
// underneath it.
theorem absOfDifferenceIsSymmetric: forall z, w: Complex;
  abs(add(w, cneg(z))) = abs(add(z, cneg(w)))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          // both roots owe their argument be nonnegative, which a norm-square always is
          @left-norm-nonneg |
            less_or_equal(real.ZERO, normSq(add(w, cneg(z))))
            [using specialize normSqNonneg(add(w, cneg(z)))]
          @right-norm-nonneg |
            less_or_equal(real.ZERO, normSq(add(z, cneg(w))))
            [using specialize normSqNonneg(add(z, cneg(w)))]
          @the-norms-agree |
            normSq(add(w, cneg(z))) = normSq(add(z, cneg(w)))
            [using specialize normSqOfDifferenceIsSymmetric(z, w)]
          @left-unfolds |
            abs(add(w, cneg(z))) = sqrt(normSq(add(w, cneg(z))))
            [using specialize absIsTheRootOfTheNormSquare(add(w, cneg(z)))]
          @right-unfolds |
            abs(add(z, cneg(w))) = sqrt(normSq(add(z, cneg(w))))
            [using specialize absIsTheRootOfTheNormSquare(add(z, cneg(w)))]
          @left-as-the-right-root |
            abs(add(w, cneg(z))) = sqrt(normSq(add(z, cneg(w))))
            [by rewrite the-norms-agree left-unfolds]
          @the-right-root-is-abs |
            sqrt(normSq(add(z, cneg(w)))) = abs(add(z, cneg(w)))
            [by symmetry right-unfolds]
          @conclusion-symmetric |
            abs(add(w, cneg(z))) = abs(add(z, cneg(w)))
            [using chain left-as-the-right-root the-right-root-is-abs]
        }
      @discharge-w |
        forall w: Complex; abs(add(w, cneg(z))) = abs(add(z, cneg(w)))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; abs(add(w, cneg(z))) = abs(add(z, cneg(w)))
    [by generalize generalize-z]
qed

// EXERCISE 19(e): |z| − |w| ≤ |z − w| and |w| − |z| ≤ |z − w|, i.e. ||z| − |w|| ≤ |z − w|.
// From the triangle inequality at z = (z − w) + w and at w = (w − z) + z.
theorem reverseTriangleInequality: forall z, w: Complex; less_or_equal(real_add(abs(z), rneg(abs(w))), abs(add(z, cneg(w)))) and less_or_equal(real_add(abs(w), rneg(abs(z))), abs(add(z, cneg(w))))
proof
  @generalize-z |
    fix z: Complex {
      @generalize-w |
        fix w: Complex {
          // |z| ≤ |z − w| + |w|.
          @z-recovered |
            add(add(z, cneg(w)), w) = z
            [using polynomial(complex)]
          @triangle-at-z |
            less_or_equal(abs(add(add(z, cneg(w)), w)), real_add(abs(add(z, cneg(w))), abs(w)))
            [using specialize triangleInequality(add(z, cneg(w)), w)]
          @abs-z-bounded |
            less_or_equal(abs(z), real_add(abs(add(z, cneg(w))), abs(w)))
            [by rewrite z-recovered triangle-at-z]
          @abs-z-shifted |
            less_or_equal(real_add(abs(z), rneg(abs(w))), real_add(real_add(abs(add(z, cneg(w))), abs(w)), rneg(abs(w))))
            [using specialize real.lessOrEqualAddRight(abs(z), real_add(abs(add(z, cneg(w))), abs(w)), rneg(abs(w))) abs-z-bounded]
          @w-regrouped |
            real_add(real_add(abs(add(z, cneg(w))), abs(w)), rneg(abs(w))) = real_add(abs(add(z, cneg(w))), real_add(abs(w), rneg(abs(w))))
            [using specialize real.addIsAssociative(abs(add(z, cneg(w))), abs(w), rneg(abs(w)))]
          @w-minus-w |
            real_add(abs(w), rneg(abs(w))) = real.ZERO
            [using specialize real.addNegRight(abs(w))]
          @w-cancelled-to-zero |
            real_add(real_add(abs(add(z, cneg(w))), abs(w)), rneg(abs(w))) = real_add(abs(add(z, cneg(w))), real.ZERO)
            [by rewrite w-minus-w w-regrouped]
          @plus-zero-w |
            real_add(abs(add(z, cneg(w))), real.ZERO) = abs(add(z, cneg(w)))
            [using specialize real.addZeroRight(abs(add(z, cneg(w))))]
          @w-cancels |
            real_add(real_add(abs(add(z, cneg(w))), abs(w)), rneg(abs(w))) = abs(add(z, cneg(w)))
            [using chain w-cancelled-to-zero plus-zero-w]
          @first-bound |
            less_or_equal(real_add(abs(z), rneg(abs(w))), abs(add(z, cneg(w))))
            [by rewrite w-cancels abs-z-shifted]
          // |w| ≤ |w − z| + |z|, and |w − z| = |z − w|.
          @w-recovered |
            add(add(w, cneg(z)), z) = w
            [using polynomial(complex)]
          @triangle-at-w |
            less_or_equal(abs(add(add(w, cneg(z)), z)), real_add(abs(add(w, cneg(z))), abs(z)))
            [using specialize triangleInequality(add(w, cneg(z)), z)]
          @abs-w-bounded-raw |
            less_or_equal(abs(w), real_add(abs(add(w, cneg(z))), abs(z)))
            [by rewrite w-recovered triangle-at-w]
          @difference-symmetric |
            abs(add(w, cneg(z))) = abs(add(z, cneg(w)))
            [using specialize absOfDifferenceIsSymmetric(z, w)]
          @abs-w-bounded |
            less_or_equal(abs(w), real_add(abs(add(z, cneg(w))), abs(z)))
            [by rewrite difference-symmetric abs-w-bounded-raw]
          @abs-w-shifted |
            less_or_equal(real_add(abs(w), rneg(abs(z))), real_add(real_add(abs(add(z, cneg(w))), abs(z)), rneg(abs(z))))
            [using specialize real.lessOrEqualAddRight(abs(w), real_add(abs(add(z, cneg(w))), abs(z)), rneg(abs(z))) abs-w-bounded]
          @z-regrouped |
            real_add(real_add(abs(add(z, cneg(w))), abs(z)), rneg(abs(z))) = real_add(abs(add(z, cneg(w))), real_add(abs(z), rneg(abs(z))))
            [using specialize real.addIsAssociative(abs(add(z, cneg(w))), abs(z), rneg(abs(z)))]
          @z-minus-z |
            real_add(abs(z), rneg(abs(z))) = real.ZERO
            [using specialize real.addNegRight(abs(z))]
          @z-cancelled-to-zero |
            real_add(real_add(abs(add(z, cneg(w))), abs(z)), rneg(abs(z))) = real_add(abs(add(z, cneg(w))), real.ZERO)
            [by rewrite z-minus-z z-regrouped]
          @plus-zero-z |
            real_add(abs(add(z, cneg(w))), real.ZERO) = abs(add(z, cneg(w)))
            [using specialize real.addZeroRight(abs(add(z, cneg(w))))]
          @z-cancels |
            real_add(real_add(abs(add(z, cneg(w))), abs(z)), rneg(abs(z))) = abs(add(z, cneg(w)))
            [using chain z-cancelled-to-zero plus-zero-z]
          @second-bound |
            less_or_equal(real_add(abs(w), rneg(abs(z))), abs(add(z, cneg(w))))
            [by rewrite z-cancels abs-w-shifted]
          @conclusion-reverse-triangle |
            less_or_equal(real_add(abs(z), rneg(abs(w))), abs(add(z, cneg(w)))) and less_or_equal(real_add(abs(w), rneg(abs(z))), abs(add(z, cneg(w))))
            [by both first-bound second-bound]
        }
      @discharge-w |
        forall w: Complex; less_or_equal(real_add(abs(z), rneg(abs(w))), abs(add(z, cneg(w)))) and less_or_equal(real_add(abs(w), rneg(abs(z))), abs(add(z, cneg(w))))
        [by generalize generalize-w]
    }
  @conclusion |
    forall z, w: Complex; less_or_equal(real_add(abs(z), rneg(abs(w))), abs(add(z, cneg(w)))) and less_or_equal(real_add(abs(w), rneg(abs(z))), abs(add(z, cneg(w))))
    [by generalize generalize-z]
qed
