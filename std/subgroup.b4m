// std/subgroup.b4m — the theory of a SUBGROUP of a group.
//
// A subgroup is a subset of a group's underlying sort that is itself a group under the
// restricted operation. Here it is the membership predicate `inSubgroup` over the ambient
// group's own sort, characterized by Judson's three criteria (identity, closure under the
// operation, closure under inverses), plus what follows: the predicated sort `Sub`, the five
// group laws PROVEN to hold on it, the division criterion, the one-step test, and that an
// intersection of subgroups is a subgroup.
//
// Consumed two ways. A concrete subgroup over this same group ALIASES `inSubgroup` and gets
// everything directly (`aata/3.3-subgroups.md`, `std/group/coset.b4m`). A concrete subgroup
// over a DIFFERENT group — or a subgroup OF a subgroup, the iterated K < H < G case — MODELS
// this theory onto its own predicate, and `group` then plugs onto that via a second model
// layer, transferring the whole group corpus onto the subgroup
// (`tests/cases/model_subgroup_transfer.b4m` demonstrates the stack end to end).
//
// HISTORY: this file used to declare its OWN abstract parent group and re-prove the group
// corpus over it — a deliberate "dependency inversion" so group and subgroup were peer
// theories joined only by models. That cost 255 lines of verbatim re-proof, made the file the
// one place in std that re-declared a sort another theory already owned, and produced the
// useless `expected sort 'Grp', got 'Grp'` diagnostic for anyone who imported it as a base.
// The cycle it was avoiding does not exist: none of the six sub-theories `std/group.b4m`
// forwards reaches subgroup. So it aliases now, like the rest of std.

import group <<< "std/group.b4m"

// The ambient group, ALIASED (not re-declared): one origin, so this theory is MORE group
// theory rather than a second structure satisfying the group axioms. The parent axioms keep
// their `grp*` spellings because the like-named `op*` THEOREMS below are a different claim —
// they say each law holds ON THE SUBGROUP (over `Sub`) — and a file cannot hold both under
// one name. The corpus `group` already proves (inverseUnique, invInvolution, invProduct,
// cancelRight, cancelLeft and the right-sided laws) is aliased rather than reproved.
sort Grp = group.Grp
const E = group.E
func op = group.op
func inverse = group.inverse
axiom grpAssoc = group.opAssoc
axiom grpIdentityLeft = group.opIdentityLeft
axiom grpInverseLeft = group.opInverseLeft
theorem grpInverseRight = group.opInverseRight
theorem grpIdentityRight = group.opIdentityRight
theorem inverseUnique = group.inverseUnique
theorem invInvolution = group.invInvolution
theorem invProduct = group.invProduct
theorem cancelRight = group.cancelRight
theorem cancelLeft = group.cancelLeft

// The subgroup, as a membership predicate over the group's sort, characterized by
// the three subgroup-criterion conditions.
pred inSubgroup(g: Grp)

axiom subgroupHasIdentity: inSubgroup(E)
axiom subgroupClosedOp: forall a, b: Grp; inSubgroup(a) -> inSubgroup(b) -> inSubgroup(op(a, b))
axiom subgroupClosedInverse: forall a: Grp; inSubgroup(a) -> inSubgroup(inverse(a))

// The subgroup's underlying sort as a PREDICATED SORT: `Sub` is `Grp` restricted to members.
// A statement `∀g: Sub; …` reads as "for every subgroup element" and desugars to
// `∀g: Grp; inSubgroup(g) -> …` — the same theorem, but the membership hypotheses
// stay implicit in the binder (surfaced in a proof with `[by predicate <fix>]`).
// NOTE: we do NOT give `op`/`inverse` a `Sub` result — closure is PROVEN below, not
// asserted by a signature. `Sub` is used only for legibility of the statements.
sort Sub = Grp where inSubgroup

// ── THE FIVE GROUP AXIOMS, PROVEN ON THE SUBGROUP. ───────────────────────────
// Each states that a group axiom holds over the subgroup sort `Sub` (the law
// holds on all of Grp, so it restricts to the subset). These are the five theorems
// HGroup @-projects to discharge group's axiom obligations onto the subgroup.
theorem opAssoc: forall a, b, c: Sub; op(op(a, b), c) = op(a, op(b, c))
proof
  @generalize-a |
    fix p: Sub {
      @generalize-b |
        fix q: Sub {
          @generalize-c |
            fix r: Sub {
              @conclusion-at-pqr |
                op(op(p, q), r) = op(p, op(q, r))
                [using specialize grpAssoc(p, q, r)]
            }
          @discharge-c |
            forall c: Sub; op(op(p, q), c) = op(p, op(q, c))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Sub; op(op(p, b), c) = op(p, op(b, c))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Sub; op(op(a, b), c) = op(a, op(b, c))
    [by forall_intro generalize-a]
qed

theorem opIdentityLeft: forall a: Sub; op(E, a) = a
proof
  @generalize-a |
    fix p: Sub {
      @conclusion-at-p |
        op(E, p) = p
        [using specialize grpIdentityLeft(p)]
    }
  @conclusion |
    forall a: Sub; op(E, a) = a
    [by forall_intro generalize-a]
qed

theorem opIdentityRight: forall a: Sub; op(a, E) = a
proof
  @generalize-a |
    fix p: Sub {
      @conclusion-at-p |
        op(p, E) = p
        [using specialize grpIdentityRight(p)]
    }
  @conclusion |
    forall a: Sub; op(a, E) = a
    [by forall_intro generalize-a]
qed

theorem opInverseLeft: forall a: Sub; op(inverse(a), a) = E
proof
  @generalize-a |
    fix p: Sub {
      @conclusion-at-p |
        op(inverse(p), p) = E
        [using specialize grpInverseLeft(p)]
    }
  @conclusion |
    forall a: Sub; op(inverse(a), a) = E
    [by forall_intro generalize-a]
qed

theorem opInverseRight: forall a: Sub; op(a, inverse(a)) = E
proof
  @generalize-a |
    fix p: Sub {
      @conclusion-at-p |
        op(p, inverse(p)) = E
        [using specialize grpInverseRight(p)]
    }
  @conclusion |
    forall a: Sub; op(a, inverse(a)) = E
    [by forall_intro generalize-a]
qed

// One-step subgroup test, FORWARD: a subgroup is closed under
// the "divide" operation g·h⁻¹. Since h ∈ H, its inverse h⁻¹ ∈ H (closedInverse);
// then by closure under the operation, g·h⁻¹ ∈ H (closedOp).
theorem subgroupClosedDivide: forall g, h: Sub; inSubgroup(op(g, inverse(h)))
proof
  @generalize-g |
    fix g: Sub {
      @g-is-a-member |
        inSubgroup(g)
        [by predicate generalize-g]
      @generalize-h |
        fix h: Sub {
          @h-is-a-member |
            inSubgroup(h)
            [by predicate generalize-h]
          @inverse-of-h-in-H |
            inSubgroup(inverse(h))
            [using specialize subgroupClosedInverse(h) h-is-a-member]
          @divide-is-a-member |
            inSubgroup(op(g, inverse(h)))
            [using specialize subgroupClosedOp(g, inverse(h)) g-is-a-member inverse-of-h-in-H]
        }
      @discharge-h |
        forall h: Sub; inSubgroup(op(g, inverse(h)))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Sub; inSubgroup(op(g, inverse(h)))
    [by forall_intro generalize-g]
qed

// ── One-step test, CONVERSE ──────────────────────────────────────────────────
// The other half of the test: a NONEMPTY subset closed under g·h⁻¹ satisfies the
// three subgroup conditions, hence is a subgroup. Since 2b4m cannot quantify over
// predicates, we express "an arbitrary subset with those two properties" as a
// second membership predicate `oneStepSubset` constrained by exactly the one-step
// hypotheses, and derive the three conditions as theorems.
pred oneStepSubset(g: Grp)

axiom oneStepInhabited: exists g: Grp; oneStepSubset(g)
axiom oneStepClosedDivide: forall a, b: Grp; oneStepSubset(a) -> oneStepSubset(b) -> oneStepSubset(op(a, inverse(b)))

// Condition 1 (identity): pick any member g; then g·g⁻¹ = e is in the subset.
theorem oneStepHasIdentity: oneStepSubset(E)
proof
  @some-member-exists |
    exists g: Grp; oneStepSubset(g)
    [by cite oneStepInhabited]
  @with-member |
    unpack g: Grp from some-member-exists {
      @member-in-subset |
        oneStepSubset(g)
        [by hypothesis with-member]
      @self-divide-in-subset |
        oneStepSubset(op(g, inverse(g)))
        [using specialize oneStepClosedDivide(g, g) member-in-subset member-in-subset]
      @self-divide-is-identity |
        op(g, inverse(g)) = E
        [using specialize grpInverseRight(g)]
      @conclusion-identity-in-subset |
        oneStepSubset(E)
        [by rewrite self-divide-is-identity self-divide-in-subset]
    }
  @conclusion |
    oneStepSubset(E)
    [by exists_elim with-member]
qed

// Condition 3 (inverses): for any member g, dividing the identity by g gives
// e·g⁻¹ = g⁻¹, which is in the subset. (Uses condition 1: e is in the subset.)
theorem oneStepClosedInverse: forall g: Grp; oneStepSubset(g) -> oneStepSubset(inverse(g))
proof
  @generalize-g |
    fix g: Grp {
      @given-g-in-subset |
        assume oneStepSubset(g) {
          @g-in-subset |
            oneStepSubset(g)
            [by hypothesis given-g-in-subset]
          @identity-in-subset |
            oneStepSubset(E)
            [by cite oneStepHasIdentity]
          @identity-divide-g-in-subset |
            oneStepSubset(op(E, inverse(g)))
            [using specialize oneStepClosedDivide(E, g) identity-in-subset g-in-subset]
          @identity-divide-g-is-inverse |
            op(E, inverse(g)) = inverse(g)
            [using specialize grpIdentityLeft(inverse(g))]
          @conclusion-inverse-in-subset |
            oneStepSubset(inverse(g))
            [by rewrite identity-divide-g-is-inverse identity-divide-g-in-subset]
        }
      @g-in-subset-implies-inverse |
        oneStepSubset(g) -> oneStepSubset(inverse(g))
        [by implies_intro given-g-in-subset]
    }
  @conclusion |
    forall g: Grp; oneStepSubset(g) -> oneStepSubset(inverse(g))
    [by forall_intro generalize-g]
qed

// Condition 2 (products): given h1, h2 in the subset, h2⁻¹ is in it (condition 3),
// so dividing h1 by h2⁻¹ gives h1·(h2⁻¹)⁻¹ = h1·h2, which is in the subset. The
// double inverse (h2⁻¹)⁻¹ = h2 is `invInvolution`.
theorem oneStepClosedOp: forall h1, h2: Grp; oneStepSubset(h1) -> oneStepSubset(h2) -> oneStepSubset(op(h1, h2))
proof
  @generalize-h1 |
    fix h1: Grp {
      @generalize-h2 |
        fix h2: Grp {
          @given-h1-in-subset |
            assume oneStepSubset(h1) {
              @given-h2-in-subset |
                assume oneStepSubset(h2) {
                  @h1-in-subset |
                    oneStepSubset(h1)
                    [by hypothesis given-h1-in-subset]
                  @h2-in-subset |
                    oneStepSubset(h2)
                    [by hypothesis given-h2-in-subset]
                  @inverse-h2-in-subset |
                    oneStepSubset(inverse(h2))
                    [using specialize oneStepClosedInverse(h2) h2-in-subset]
                  @h1-divide-inverse-h2-in-subset |
                    oneStepSubset(op(h1, inverse(inverse(h2))))
                    [using specialize oneStepClosedDivide(h1, inverse(h2)) h1-in-subset inverse-h2-in-subset]
                  @double-inverse-h2 |
                    inverse(inverse(h2)) = h2
                    [using specialize invInvolution(h2)]
                  @conclusion-product-in-subset |
                    oneStepSubset(op(h1, h2))
                    [by rewrite double-inverse-h2 h1-divide-inverse-h2-in-subset]
                }
              @h2-in-subset-implies-product |
                oneStepSubset(h2) -> oneStepSubset(op(h1, h2))
                [by implies_intro given-h2-in-subset]
            }
          @h1-in-subset-implies-rest |
            oneStepSubset(h1) -> oneStepSubset(h2) -> oneStepSubset(op(h1, h2))
            [by implies_intro given-h1-in-subset]
        }
      @discharge-h2 |
        forall h2: Grp; oneStepSubset(h1) -> oneStepSubset(h2) -> oneStepSubset(op(h1, h2))
        [by forall_intro generalize-h2]
    }
  @conclusion |
    forall h1, h2: Grp; oneStepSubset(h1) -> oneStepSubset(h2) -> oneStepSubset(op(h1, h2))
    [by forall_intro generalize-h1]
qed

// ── Intersection of subgroups ────────────────────────────────────────────────
// The intersection H ∩ K of two subgroups is a subgroup. We model a SECOND
// subgroup with its own membership predicate `inSubgroup2` (same three axioms),
// define intersection membership as the conjunction, and prove the three subgroup
// conditions for the conjunction — each follows by applying the corresponding
// condition in H and in K.
pred inSubgroup2(g: Grp)

axiom subgroup2HasIdentity: inSubgroup2(E)
axiom subgroup2ClosedOp: forall a, b: Grp; inSubgroup2(a) -> inSubgroup2(b) -> inSubgroup2(op(a, b))
axiom subgroup2ClosedInverse: forall a: Grp; inSubgroup2(a) -> inSubgroup2(inverse(a))

// Intersection, condition 1: e is in both, hence in the intersection.
theorem intersectionHasIdentity: inSubgroup(E) and inSubgroup2(E)
proof
  @identity-in-first |
    inSubgroup(E)
    [by cite subgroupHasIdentity]
  @identity-in-second |
    inSubgroup2(E)
    [by cite subgroup2HasIdentity]
  @conclusion |
    inSubgroup(E) and inSubgroup2(E)
    [by and_intro identity-in-first identity-in-second]
qed

// Intersection, condition 2: if a and b are in both, their product is in both.
theorem intersectionClosedOp: forall a, b: Grp; (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(b) and inSubgroup2(b)) -> (inSubgroup(op(a, b)) and inSubgroup2(op(a, b)))
proof
  @generalize-a |
    fix a: Grp {
      @generalize-b |
        fix b: Grp {
          @given-a-in-both |
            assume inSubgroup(a) and inSubgroup2(a) {
              @given-b-in-both |
                assume inSubgroup(b) and inSubgroup2(b) {
                  @a-in-both |
                    inSubgroup(a) and inSubgroup2(a)
                    [by hypothesis given-a-in-both]
                  @b-in-both |
                    inSubgroup(b) and inSubgroup2(b)
                    [by hypothesis given-b-in-both]
                  @a-in-first |
                    inSubgroup(a)
                    [by and_elim_left a-in-both]
                  @a-in-second |
                    inSubgroup2(a)
                    [by and_elim_right a-in-both]
                  @b-in-first |
                    inSubgroup(b)
                    [by and_elim_left b-in-both]
                  @b-in-second |
                    inSubgroup2(b)
                    [by and_elim_right b-in-both]
                  @product-in-first |
                    inSubgroup(op(a, b))
                    [using specialize subgroupClosedOp(a, b) a-in-first b-in-first]
                  @product-in-second |
                    inSubgroup2(op(a, b))
                    [using specialize subgroup2ClosedOp(a, b) a-in-second b-in-second]
                  @conclusion-product-in-both |
                    inSubgroup(op(a, b)) and inSubgroup2(op(a, b))
                    [by and_intro product-in-first product-in-second]
                }
              @b-in-both-implies-product |
                (inSubgroup(b) and inSubgroup2(b)) -> (inSubgroup(op(a, b)) and inSubgroup2(op(a, b)))
                [by implies_intro given-b-in-both]
            }
          @a-in-both-implies-rest |
            (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(b) and inSubgroup2(b)) -> (inSubgroup(op(a, b)) and inSubgroup2(op(a, b)))
            [by implies_intro given-a-in-both]
        }
      @discharge-b |
        forall b: Grp; (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(b) and inSubgroup2(b)) -> (inSubgroup(op(a, b)) and inSubgroup2(op(a, b)))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Grp; (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(b) and inSubgroup2(b)) -> (inSubgroup(op(a, b)) and inSubgroup2(op(a, b)))
    [by forall_intro generalize-a]
qed

// Intersection, condition 3: if a is in both, its inverse is in both.
theorem intersectionClosedInverse: forall a: Grp; (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(inverse(a)) and inSubgroup2(inverse(a)))
proof
  @generalize-a |
    fix a: Grp {
      @given-a-in-both |
        assume inSubgroup(a) and inSubgroup2(a) {
          @a-in-both |
            inSubgroup(a) and inSubgroup2(a)
            [by hypothesis given-a-in-both]
          @a-in-first |
            inSubgroup(a)
            [by and_elim_left a-in-both]
          @a-in-second |
            inSubgroup2(a)
            [by and_elim_right a-in-both]
          @inverse-in-first |
            inSubgroup(inverse(a))
            [using specialize subgroupClosedInverse(a) a-in-first]
          @inverse-in-second |
            inSubgroup2(inverse(a))
            [using specialize subgroup2ClosedInverse(a) a-in-second]
          @conclusion-inverse-in-both |
            inSubgroup(inverse(a)) and inSubgroup2(inverse(a))
            [by and_intro inverse-in-first inverse-in-second]
        }
      @a-in-both-implies-inverse |
        (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(inverse(a)) and inSubgroup2(inverse(a)))
        [by implies_intro given-a-in-both]
    }
  @conclusion |
    forall a: Grp; (inSubgroup(a) and inSubgroup2(a)) -> (inSubgroup(inverse(a)) and inSubgroup2(inverse(a)))
    [by forall_intro generalize-a]
qed

// ── CANARY (do NOT cite) ─────────────────────────────────────────────────────
// A liveness check for the PREDICATED-SORT machinery on the real `Sub` sort. It
// declares Sub-RESULT operations (which ASSERT closure by their signature — the
// opposite of the proofs above, which PROVE it) and shows a downstream use composes
// through the result-postcondition surfacing: `subCombine(g, h)` lands in `Sub`, so
// the `Sub`-argument `subConsume` accepts it with no explicit closure step. If
// predicated sorts ever regress, this canary breaks first. It is NOT part of the
// subgroup theory — nothing cites it, and it may be deleted/rewritten freely
// (tectonic shifts to this file are expected).
func subCombine(a: Sub, b: Sub) => Sub // asserts: Sub is closed under this op
func subConsume(x: Sub) => Grp // needs a Sub argument

theorem canaryClosureComposes: forall g, h: Sub; subConsume(subCombine(g, h)) = subConsume(subCombine(g, h))
proof
  @generalize-g |
    fix g: Sub {
      @generalize-h |
        fix h: Sub {
          @reflexive |
            subConsume(subCombine(g, h)) = subConsume(subCombine(g, h))
            [by reflexivity]
        }
      @discharge-h |
        forall h: Sub; subConsume(subCombine(g, h)) = subConsume(subCombine(g, h))
        [by forall_intro generalize-h]
    }
  @conclusion |
    forall g, h: Sub; subConsume(subCombine(g, h)) = subConsume(subCombine(g, h))
    [by forall_intro generalize-g]
qed
