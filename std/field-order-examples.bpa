// Worked example for `std/field-order.bpa`'s translation-cancellation axiom.
//
// Why this file exists: `lessThanAddRight` and `lessThanAddCancel` are the two halves of
// "addition is translation-invariant". The forward half is used throughout the ordered
// field theory; the cancelling half is stated for callers and never exercised here — so
// the one whose hypothesis and conclusion could be swapped unnoticed is the untested one.
import field_order <<< "std/field-order.bpa"

sort OrderedField = field_order.OrderedField
const ZERO = field_order.ZERO
const ONE = field_order.ONE
func add = field_order.add
pred less_than = field_order.less_than

axiom lessThanAddRight = field_order.lessThanAddRight
axiom lessThanAddCancel = field_order.lessThanAddCancel

// Translating and then cancelling is the identity on an order fact: shift a < b up by c,
// then cancel c back off. Both halves in sequence, which is the only way to catch a
// direction error in either.
theorem translationRoundTrips: forall a, b, c: OrderedField; less_than(a, b) -> less_than(a, b)
proof
  @generalize-a |
    fix a: OrderedField {
      @generalize-b |
        fix b: OrderedField {
          @generalize-c |
            fix c: OrderedField {
              @given-a-below-b |
                assume less_than(a, b) {
                  @a-is-below-b |
                    less_than(a, b)
                    [by hypothesis given-a-below-b]
                  @translated-up-by-c |
                    less_than(add(a, c), add(b, c))
                    [using specialize lessThanAddRight(a, b, c) a-is-below-b]
                  @conclusion-cancelled-back |
                    less_than(a, b)
                    [using specialize lessThanAddCancel(a, b, c) translated-up-by-c]
                }
              @conclusion-round-trip |
                less_than(a, b) -> less_than(a, b)
                [by implies_intro given-a-below-b]
            }
          @discharge-c |
            forall c: OrderedField; less_than(a, b) -> less_than(a, b)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: OrderedField; less_than(a, b) -> less_than(a, b)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: OrderedField; less_than(a, b) -> less_than(a, b)
    [by forall_intro generalize-a]
qed
