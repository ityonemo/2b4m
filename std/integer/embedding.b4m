// std/integer/embedding.b4m — the embedding ℕ → ℤ.
//
// Sequences (and every listing/counting argument) are indexed by ℕ, while orders of group
// elements, representatives of residue classes, and exponents are integers. `toInt` carries
// an index to its integer by the two recursion clauses; it is order-preserving and
// -reflecting, additive, injective, and hits every nonnegative integer. (Moved out of
// std/integer/mod-n-listing.b4m so std/group can count with it too.)

theory integer <<< "std/integer.b4m"
theory int_order <<< "std/integer/order.b4m"
theory peano <<< "std/peano.b4m"
theory peano_order <<< "std/peano/order.b4m"

// ℤ and its order
sort Int = integer.Int
const ZERO = integer.ZERO
oper succ = integer.succ
oper add = integer.add
oper mul = integer.mul
fact intMulZeroRight = integer.mulZeroRight
fact intMulSuccRight = integer.mulSuccRight
pred less_than = int_order.less_than
pred nonneg = integer.nonneg
fact nonnegZero = integer.nonnegZero
fact nonnegSucc = integer.nonnegSucc
fact nonnegInduction = int_order.nonnegInduction
fact intLessThanIntro = int_order.lessThanIntro
fact intLessThanElim = int_order.lessThanElim
fact intLessThanIrreflexive = int_order.lessThanIrreflexive
fact intTrichotomy = int_order.trichotomy
fact intAddSuccRight = int_order.addSuccRight
fact intAddZeroRight = int_order.addZeroRight
fact intLessThanTransitive = int_order.lessThanTransitive

// ℕ, the index sort
sort Nat = peano.Nat
const NAT_ZERO = peano.ZERO
oper nat_succ = peano.succ
oper nat_add = peano.add
oper nat_mul = peano.mul
fact mulZeroRight = peano.mulZeroRight
fact mulSuccRight = peano.mulSuccRight
pred nat_less_than = peano.less_than
fact induction = peano.induction
fact addZeroRight = peano.addZeroRight
fact addSuccRight = peano.addSuccRight
fact lessThanElim = peano_order.lessThanElim
fact trichotomy = peano_order.trichotomy

oper toInt(n: Nat) => Int
axiom toIntZero: toInt(NAT_ZERO) = ZERO
axiom toIntSucc: forall n: Nat; toInt(nat_succ(n)) = succ(toInt(n))

theorem toIntNonneg: forall n: Nat; nonneg(toInt(n))
proof
  @zero-image |
    toInt(NAT_ZERO) = ZERO
    [by cite toIntZero]
  @zero-nonneg |
    nonneg(ZERO)
    [by cite nonnegZero]
  @base-case |
    nonneg(toInt(NAT_ZERO))
    [by rewrite zero-image zero-nonneg]
  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume nonneg(toInt(k)) {
          @inductive-hypothesis |
            nonneg(toInt(k))
            [by hypothesis given-inductive-hypothesis]
          @next-image |
            toInt(nat_succ(k)) = succ(toInt(k))
            [using specialize toIntSucc(k)]
          @next-nonneg |
            nonneg(succ(toInt(k)))
            [using specialize nonnegSucc(toInt(k)) inductive-hypothesis]
          @conclusion-step |
            nonneg(toInt(nat_succ(k)))
            [by rewrite next-image next-nonneg]
        }
      @induction-step-at-k |
        nonneg(toInt(k)) -> nonneg(toInt(nat_succ(k)))
        [by discharge given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; nonneg(toInt(k)) -> nonneg(toInt(nat_succ(k)))
    [by generalize induction-step]
  @conclusion |
    forall n: Nat; nonneg(toInt(n))
    [using instantiation induction((fun k: Nat => nonneg(toInt(k)))) base-case induction-step-for-all-k]
qed

theorem toIntAdd: forall a: Nat; forall b: Nat; toInt(nat_add(a, b)) = add(toInt(a), toInt(b))
proof
  @generalize-a |
    fix a: Nat {
      @a-plus-zero |
        nat_add(a, NAT_ZERO) = a
        [using specialize addZeroRight(a)]
      @zero-image |
        toInt(NAT_ZERO) = ZERO
        [by cite toIntZero]
      @image-plus-zero |
        add(toInt(a), ZERO) = toInt(a)
        [using specialize intAddZeroRight(toInt(a))]
      @base-case |
        toInt(nat_add(a, NAT_ZERO)) = add(toInt(a), toInt(NAT_ZERO))
        [using simplify a-plus-zero zero-image image-plus-zero]
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume toInt(nat_add(a, k)) = add(toInt(a), toInt(k)) {
              @inductive-hypothesis |
                toInt(nat_add(a, k)) = add(toInt(a), toInt(k))
                [by hypothesis given-inductive-hypothesis]
              @sum-steps |
                nat_add(a, nat_succ(k)) = nat_succ(nat_add(a, k))
                [using specialize addSuccRight(a, k)]
              @image-of-successor |
                toInt(nat_succ(nat_add(a, k))) = succ(toInt(nat_add(a, k)))
                [using specialize toIntSucc(nat_add(a, k))]
              @image-of-k-successor |
                toInt(nat_succ(k)) = succ(toInt(k))
                [using specialize toIntSucc(k)]
              @integer-sum-steps |
                add(toInt(a), succ(toInt(k))) = succ(add(toInt(a), toInt(k)))
                [using specialize intAddSuccRight(toInt(a), toInt(k))]
              @conclusion-step |
                toInt(nat_add(a, nat_succ(k))) = add(toInt(a), toInt(nat_succ(k)))
                [using simplify sum-steps image-of-successor inductive-hypothesis image-of-k-successor integer-sum-steps]
            }
          @induction-step-at-k |
            toInt(nat_add(a, k)) = add(toInt(a), toInt(k)) -> toInt(nat_add(a, nat_succ(k))) = add(toInt(a), toInt(nat_succ(k)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; toInt(nat_add(a, k)) = add(toInt(a), toInt(k)) -> toInt(nat_add(a, nat_succ(k))) = add(toInt(a), toInt(nat_succ(k)))
        [by generalize induction-step]
      @conclusion-for-all-b |
        forall b: Nat; toInt(nat_add(a, b)) = add(toInt(a), toInt(b))
        [using instantiation induction((fun k: Nat => toInt(nat_add(a, k)) = add(toInt(a), toInt(k)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall a: Nat; forall b: Nat; toInt(nat_add(a, b)) = add(toInt(a), toInt(b))
    [by generalize generalize-a]
qed

// The embedding preserves the order: a gap of d + 1 in ℕ is a gap of toInt(d) + 1 in ℤ.
theorem toIntPreservesOrder: forall i: Nat; forall j: Nat; nat_less_than(i, j) -> less_than(toInt(i), toInt(j))
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @given-below |
            assume nat_less_than(i, j) {
              @below |
                nat_less_than(i, j)
                [by hypothesis given-below]
              @gap-exists |
                exists d: Nat; nat_add(i, nat_succ(d)) = j
                [using specialize lessThanElim(i, j) below]
              @with-gap-d |
                unpack d: Nat from gap-exists {
                  @gap |
                    nat_add(i, nat_succ(d)) = j
                    [by hypothesis with-gap-d]
                  @image-of-sum |
                    toInt(nat_add(i, nat_succ(d))) = add(toInt(i), toInt(nat_succ(d)))
                    [using specialize toIntAdd(i, nat_succ(d))]
                  @image-of-gap |
                    toInt(nat_succ(d)) = succ(toInt(d))
                    [using specialize toIntSucc(d)]
                  @image-of-j-a |
                    toInt(j) = add(toInt(i), toInt(nat_succ(d)))
                    [by rewrite gap image-of-sum]
                  @image-of-j |
                    toInt(j) = add(toInt(i), succ(toInt(d)))
                    [by rewrite image-of-gap image-of-j-a]
                  @image-gap-form |
                    add(toInt(i), succ(toInt(d))) = toInt(j)
                    [by symmetry image-of-j]
                  @gap-nonneg |
                    nonneg(toInt(d))
                    [using specialize toIntNonneg(d)]
                  @conclusion-images-ordered |
                    less_than(toInt(i), toInt(j))
                    [using specialize intLessThanIntro(toInt(i), toInt(d), toInt(j)) gap-nonneg image-gap-form]
                }
              @conclusion-ordered |
                less_than(toInt(i), toInt(j))
                [by unpacked with-gap-d]
            }
          @conclusion-at-j |
            nat_less_than(i, j) -> less_than(toInt(i), toInt(j))
            [by discharge given-below]
        }
      @discharge-j |
        forall j: Nat; nat_less_than(i, j) -> less_than(toInt(i), toInt(j))
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; nat_less_than(i, j) -> less_than(toInt(i), toInt(j))
    [by generalize generalize-i]
qed

// And reflects it (trichotomy in ℕ, irreflexivity in ℤ); so it is injective.
theorem toIntReflectsOrder: forall i: Nat; forall j: Nat; less_than(toInt(i), toInt(j)) -> nat_less_than(i, j)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @given-images-ordered |
            assume less_than(toInt(i), toInt(j)) {
              @images-ordered |
                less_than(toInt(i), toInt(j))
                [by hypothesis given-images-ordered]
              @three-ways |
                nat_less_than(i, j) or i = j or nat_less_than(j, i)
                [using specialize trichotomy(i, j)]
              @image-not-below-itself |
                not less_than(toInt(i), toInt(i))
                [using specialize intLessThanIrreflexive(toInt(i))]
              @conclusion-below |
                nat_less_than(i, j)
                case three-ways {
                  @when-below |
                    assume nat_less_than(i, j) {
                      @conclusion-when-below |
                        nat_less_than(i, j)
                        [by hypothesis when-below]
                    }
                  @when-equal |
                    assume i = j {
                      @equal |
                        i = j
                        [by hypothesis when-equal]
                      @image-below-itself |
                        less_than(toInt(i), toInt(i))
                        [by rewrite equal images-ordered]
                      @conclusion-when-equal |
                        nat_less_than(i, j)
                        [by ex_falso image-below-itself image-not-below-itself]
                    }
                  @when-above |
                    assume nat_less_than(j, i) {
                      @above |
                        nat_less_than(j, i)
                        [by hypothesis when-above]
                      @images-reversed |
                        less_than(toInt(j), toInt(i))
                        [using specialize toIntPreservesOrder(j, i) above]
                      @image-below-itself |
                        less_than(toInt(i), toInt(i))
                        [using specialize intLessThanTransitive(toInt(i), toInt(j), toInt(i)) images-ordered images-reversed]
                      @conclusion-when-above |
                        nat_less_than(i, j)
                        [by ex_falso image-below-itself image-not-below-itself]
                    }
                }
            }
          @conclusion-at-j |
            less_than(toInt(i), toInt(j)) -> nat_less_than(i, j)
            [by discharge given-images-ordered]
        }
      @discharge-j |
        forall j: Nat; less_than(toInt(i), toInt(j)) -> nat_less_than(i, j)
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; less_than(toInt(i), toInt(j)) -> nat_less_than(i, j)
    [by generalize generalize-i]
qed

theorem toIntInjective: forall i: Nat; forall j: Nat; toInt(i) = toInt(j) -> i = j
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @given-images-equal |
            assume toInt(i) = toInt(j) {
              @images-equal |
                toInt(i) = toInt(j)
                [by hypothesis given-images-equal]
              @three-ways |
                nat_less_than(i, j) or i = j or nat_less_than(j, i)
                [using specialize trichotomy(i, j)]
              @image-not-below-itself |
                not less_than(toInt(j), toInt(j))
                [using specialize intLessThanIrreflexive(toInt(j))]
              @conclusion-equal |
                i = j
                case three-ways {
                  @when-below |
                    assume nat_less_than(i, j) {
                      @below |
                        nat_less_than(i, j)
                        [by hypothesis when-below]
                      @images-ordered |
                        less_than(toInt(i), toInt(j))
                        [using specialize toIntPreservesOrder(i, j) below]
                      @image-below-itself |
                        less_than(toInt(j), toInt(j))
                        [by rewrite images-equal images-ordered]
                      @conclusion-when-below |
                        i = j
                        [by ex_falso image-below-itself image-not-below-itself]
                    }
                  @when-equal |
                    assume i = j {
                      @conclusion-when-equal |
                        i = j
                        [by hypothesis when-equal]
                    }
                  @when-above |
                    assume nat_less_than(j, i) {
                      @above |
                        nat_less_than(j, i)
                        [by hypothesis when-above]
                      @images-ordered |
                        less_than(toInt(j), toInt(i))
                        [using specialize toIntPreservesOrder(j, i) above]
                      @image-below-itself |
                        less_than(toInt(j), toInt(j))
                        [by rewrite images-equal images-ordered]
                      @conclusion-when-above |
                        i = j
                        [by ex_falso image-below-itself image-not-below-itself]
                    }
                }
            }
          @conclusion-at-j |
            toInt(i) = toInt(j) -> i = j
            [by discharge given-images-equal]
        }
      @discharge-j |
        forall j: Nat; toInt(i) = toInt(j) -> i = j
        [by generalize generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; toInt(i) = toInt(j) -> i = j
    [by generalize generalize-i]
qed

// Every nonnegative integer is the image of some index: induction on the nonnegatives.
theorem everyNonnegIsAnImage: forall a: Int; nonneg(a) -> exists m: Nat; toInt(m) = a
proof
  @zero-image |
    toInt(NAT_ZERO) = ZERO
    [by cite toIntZero]
  @base-case |
    exists m: Nat; toInt(m) = ZERO
    [by witness(NAT_ZERO) zero-image]
  @induction-step |
    fix k: Int {
      @given-nonneg |
        assume nonneg(k) {
          @given-inductive-hypothesis |
            assume exists m: Nat; toInt(m) = k {
              @inductive-hypothesis |
                exists m: Nat; toInt(m) = k
                [by hypothesis given-inductive-hypothesis]
              @with-index-m |
                unpack m: Nat from inductive-hypothesis {
                  @image-is-k |
                    toInt(m) = k
                    [by hypothesis with-index-m]
                  @next-image |
                    toInt(nat_succ(m)) = succ(toInt(m))
                    [using specialize toIntSucc(m)]
                  @next-image-is-nat_succ-k |
                    toInt(nat_succ(m)) = succ(k)
                    [by rewrite image-is-k next-image]
                  @conclusion-witness |
                    exists m2: Nat; toInt(m2) = succ(k)
                    [by witness(nat_succ(m)) next-image-is-nat_succ-k]
                }
              @conclusion-step |
                exists m2: Nat; toInt(m2) = succ(k)
                [by unpacked with-index-m]
            }
          @conclusion-given-hypothesis |
            (exists m: Nat; toInt(m) = k) -> (exists m2: Nat; toInt(m2) = succ(k))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-at-k |
        nonneg(k) -> (exists m: Nat; toInt(m) = k) -> (exists m2: Nat; toInt(m2) = succ(k))
        [by discharge given-nonneg]
    }
  @induction-step-for-all-k |
    forall k: Int; nonneg(k) -> (exists m: Nat; toInt(m) = k) -> (exists m2: Nat; toInt(m2) = succ(k))
    [by generalize induction-step]
  @conclusion |
    forall a: Int; nonneg(a) -> exists m: Nat; toInt(m) = a
    [using instantiation nonnegInduction((fun a: Int => exists m: Nat; toInt(m) = a)) base-case induction-step-for-all-k]
qed

// -- the embedding is MULTIPLICATIVE ----------------------------------------------------------
// toInt(a·b) = toInt(a)·toInt(b), by induction on b: the base is both sides zero, and the step
// is mulSuccRight on each side plus toIntAdd (so this is where the additive homomorphism is
// reused). Needed to carry a ℕ divisibility fact into ℤ, where primality lives — a group
// order is a ℕ (a listing length) but `is_prime` is stated over ℤ.
theorem toIntMul: forall a: Nat; forall b: Nat; toInt(nat_mul(a, b)) = mul(toInt(a), toInt(b))
proof
  @generalize-a |
    fix a: Nat {
      // base: a·0 = 0 and toInt(a)·0 = 0
      @a-times-zero |
        nat_mul(a, NAT_ZERO) = NAT_ZERO
        [using specialize mulZeroRight(a)]
      @zero-image |
        toInt(NAT_ZERO) = ZERO
        [by cite toIntZero]
      @image-of-a-times-zero |
        toInt(nat_mul(a, NAT_ZERO)) = ZERO
        [by rewrite a-times-zero zero-image]
      @int-a-times-zero |
        mul(toInt(a), ZERO) = ZERO
        [using specialize intMulZeroRight(toInt(a))]
      @int-a-times-zero-flipped |
        ZERO = mul(toInt(a), ZERO)
        [by symmetry int-a-times-zero]
      @base-with-zero |
        toInt(nat_mul(a, NAT_ZERO)) = mul(toInt(a), ZERO)
        [using chain image-of-a-times-zero int-a-times-zero-flipped]
      @base-case |
        toInt(nat_mul(a, NAT_ZERO)) = mul(toInt(a), toInt(NAT_ZERO))
        [by rewrite zero-image base-with-zero]
      // step: a·(k+1) = a·k + a, and toInt(a)·(toInt(k)+1) = toInt(a)·toInt(k) + toInt(a)
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume toInt(nat_mul(a, k)) = mul(toInt(a), toInt(k)) {
              @inductive-hypothesis |
                toInt(nat_mul(a, k)) = mul(toInt(a), toInt(k))
                [by hypothesis given-inductive-hypothesis]
              @nat-mul-nat_succ |
                nat_mul(a, nat_succ(k)) = nat_add(nat_mul(a, k), a)
                [using specialize mulSuccRight(a, k)]
              @image-of-sum |
                toInt(nat_add(nat_mul(a, k), a)) = add(toInt(nat_mul(a, k)), toInt(a))
                [using specialize toIntAdd(nat_mul(a, k), a)]
              @image-of-mul-nat_succ |
                toInt(nat_mul(a, nat_succ(k))) = add(toInt(nat_mul(a, k)), toInt(a))
                [by rewrite nat-mul-nat_succ image-of-sum]
              @image-with-hypothesis |
                toInt(nat_mul(a, nat_succ(k))) = add(mul(toInt(a), toInt(k)), toInt(a))
                [by rewrite inductive-hypothesis image-of-mul-nat_succ]
              @int-mul-nat_succ |
                mul(toInt(a), succ(toInt(k))) = add(mul(toInt(a), toInt(k)), toInt(a))
                [using specialize intMulSuccRight(toInt(a), toInt(k))]
              @int-mul-nat_succ-flipped |
                add(mul(toInt(a), toInt(k)), toInt(a)) = mul(toInt(a), succ(toInt(k)))
                [by symmetry int-mul-nat_succ]
              @image-is-int-mul-nat_succ |
                toInt(nat_mul(a, nat_succ(k))) = mul(toInt(a), succ(toInt(k)))
                [using chain image-with-hypothesis int-mul-nat_succ-flipped]
              @nat_succ-image |
                toInt(nat_succ(k)) = succ(toInt(k))
                [using specialize toIntSucc(k)]
              @conclusion-step |
                toInt(nat_mul(a, nat_succ(k))) = mul(toInt(a), toInt(nat_succ(k)))
                [by rewrite nat_succ-image image-is-int-mul-nat_succ]
            }
          @induction-step-at-k |
            toInt(nat_mul(a, k)) = mul(toInt(a), toInt(k)) -> toInt(nat_mul(a, nat_succ(k))) = mul(toInt(a), toInt(nat_succ(k)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; toInt(nat_mul(a, k)) = mul(toInt(a), toInt(k)) -> toInt(nat_mul(a, nat_succ(k))) = mul(toInt(a), toInt(nat_succ(k)))
        [by generalize induction-step]
      @conclusion-for-all-b |
        forall b: Nat; toInt(nat_mul(a, b)) = mul(toInt(a), toInt(b))
        [using instantiation induction((fun b: Nat => toInt(nat_mul(a, b)) = mul(toInt(a), toInt(b)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall a: Nat; forall b: Nat; toInt(nat_mul(a, b)) = mul(toInt(a), toInt(b))
    [by generalize generalize-a]
qed

// -- DIVISIBILITY TRANSPORTS ACROSS THE EMBEDDING ----------------------------------------------
// d | n in ℕ gives toInt(d) | toInt(n) in ℤ: the ℕ witness k maps to toInt(k), and `toIntMul`
// turns n = d·k into toInt(n) = toInt(d)·toInt(k). This is the bridge a group-theoretic
// divisibility fact needs to meet `std/primes.b4m`, whose `is_prime` is stated over ℤ.
theorem dividesTransports: forall d: Nat; forall n: Nat;
  (exists k: Nat; n = nat_mul(d, k)) -> exists k: Int; toInt(n) = mul(toInt(d), k)
proof
  @generalize-d |
    fix d: Nat {
      @generalize-n |
        fix n: Nat {
          @given-divides |
            assume exists k: Nat; n = nat_mul(d, k) {
              @nat-witness-exists |
                exists k: Nat; n = nat_mul(d, k)
                [by hypothesis given-divides]
              @with-nat-witness |
                unpack k: Nat from nat-witness-exists {
                  @n-is-product |
                    n = nat_mul(d, k)
                    [by hypothesis with-nat-witness]
                  @image-of-product |
                    toInt(nat_mul(d, k)) = mul(toInt(d), toInt(k))
                    [using specialize toIntMul(d, k)]
                  @image-of-n |
                    toInt(n) = mul(toInt(d), toInt(k))
                    [by rewrite n-is-product image-of-product]
                  @conclusion-int-witness |
                    exists k2: Int; toInt(n) = mul(toInt(d), k2)
                    [by witness(toInt(k)) image-of-n]
                }
              @conclusion-transported |
                exists k: Int; toInt(n) = mul(toInt(d), k)
                [by unpacked with-nat-witness]
            }
          @divides-implies |
            (exists k: Nat; n = nat_mul(d, k)) -> exists k: Int; toInt(n) = mul(toInt(d), k)
            [by discharge given-divides]
        }
      @discharge-n |
        forall n: Nat; (exists k: Nat; n = nat_mul(d, k)) -> exists k: Int; toInt(n) = mul(toInt(d), k)
        [by generalize generalize-n]
    }
  @conclusion |
    forall d: Nat; forall n: Nat; (exists k: Nat; n = nat_mul(d, k)) -> exists k: Int; toInt(n) = mul(toInt(d), k)
    [by generalize generalize-d]
qed
