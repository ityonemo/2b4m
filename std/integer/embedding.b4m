// std/integer/embedding.b4m — the embedding ℕ → ℤ.
//
// Sequences (and every listing/counting argument) are indexed by ℕ, while orders of group
// elements, representatives of residue classes, and exponents are integers. `toInt` carries
// an index to its integer by the two recursion clauses; it is order-preserving and
// -reflecting, additive, injective, and hits every nonnegative integer. (Moved out of
// std/integer/mod-n-listing.b4m so std/group can count with it too.)

import integer <<< "std/integer.b4m"
import int_order <<< "std/integer/order.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

// ℤ and its order
sort Int = integer.Int
const IZERO = integer.ZERO
func isucc = integer.succ
func iadd = integer.add
pred int_less_than = int_order.less_than
pred nonneg = integer.nonneg
axiom nonnegZero = integer.nonnegZero
axiom nonnegSucc = integer.nonnegSucc
axiom nonnegInduction = int_order.nonnegInduction
axiom intLessThanIntro = int_order.lessThanIntro
axiom intLessThanElim = int_order.lessThanElim
theorem intLessThanIrreflexive = int_order.lessThanIrreflexive
theorem intTrichotomy = int_order.trichotomy
theorem intAddSuccRight = int_order.addSuccRight
theorem intAddZeroRight = int_order.addZeroRight
theorem intLessThanTransitive = int_order.lessThanTransitive

// ℕ, the index sort
sort Nat = peano.Nat
const NZERO = peano.ZERO
func succ = peano.succ
func nadd = peano.add
pred less_than = peano.less_than
axiom induction = peano.induction
theorem addZeroRight = peano.addZeroRight
theorem addSuccRight = peano.addSuccRight
axiom lessThanElim = peano_order.lessThanElim
theorem trichotomy = peano_order.trichotomy

func toInt(n: Nat) => Int
axiom toIntZero: toInt(NZERO) = IZERO
axiom toIntSucc: forall n: Nat; toInt(succ(n)) = isucc(toInt(n))

theorem toIntNonneg: forall n: Nat; nonneg(toInt(n))
proof
  @zero-image |
    toInt(NZERO) = IZERO
    [by cite toIntZero]
  @zero-nonneg |
    nonneg(IZERO)
    [by cite nonnegZero]
  @base-case |
    nonneg(toInt(NZERO))
    [by rewrite zero-image zero-nonneg]
  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume nonneg(toInt(k)) {
          @inductive-hypothesis |
            nonneg(toInt(k))
            [by hypothesis given-inductive-hypothesis]
          @next-image |
            toInt(succ(k)) = isucc(toInt(k))
            [using specialize toIntSucc(k)]
          @next-nonneg |
            nonneg(isucc(toInt(k)))
            [using specialize nonnegSucc(toInt(k)) inductive-hypothesis]
          @conclusion-step |
            nonneg(toInt(succ(k)))
            [by rewrite next-image next-nonneg]
        }
      @induction-step-at-k |
        nonneg(toInt(k)) -> nonneg(toInt(succ(k)))
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; nonneg(toInt(k)) -> nonneg(toInt(succ(k)))
    [by forall_intro induction-step]
  @conclusion |
    forall n: Nat; nonneg(toInt(n))
    [using instantiation induction((fun k: Nat => nonneg(toInt(k)))) base-case induction-step-for-all-k]
qed

theorem toIntAdd: forall a: Nat; forall b: Nat; toInt(nadd(a, b)) = iadd(toInt(a), toInt(b))
proof
  @generalize-a |
    fix a: Nat {
      @a-plus-zero |
        nadd(a, NZERO) = a
        [using specialize addZeroRight(a)]
      @zero-image |
        toInt(NZERO) = IZERO
        [by cite toIntZero]
      @image-plus-zero |
        iadd(toInt(a), IZERO) = toInt(a)
        [using specialize intAddZeroRight(toInt(a))]
      @base-case |
        toInt(nadd(a, NZERO)) = iadd(toInt(a), toInt(NZERO))
        [using simplify a-plus-zero zero-image image-plus-zero]
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume toInt(nadd(a, k)) = iadd(toInt(a), toInt(k)) {
              @inductive-hypothesis |
                toInt(nadd(a, k)) = iadd(toInt(a), toInt(k))
                [by hypothesis given-inductive-hypothesis]
              @sum-steps |
                nadd(a, succ(k)) = succ(nadd(a, k))
                [using specialize addSuccRight(a, k)]
              @image-of-successor |
                toInt(succ(nadd(a, k))) = isucc(toInt(nadd(a, k)))
                [using specialize toIntSucc(nadd(a, k))]
              @image-of-k-successor |
                toInt(succ(k)) = isucc(toInt(k))
                [using specialize toIntSucc(k)]
              @integer-sum-steps |
                iadd(toInt(a), isucc(toInt(k))) = isucc(iadd(toInt(a), toInt(k)))
                [using specialize intAddSuccRight(toInt(a), toInt(k))]
              @conclusion-step |
                toInt(nadd(a, succ(k))) = iadd(toInt(a), toInt(succ(k)))
                [using simplify sum-steps image-of-successor inductive-hypothesis image-of-k-successor integer-sum-steps]
            }
          @induction-step-at-k |
            toInt(nadd(a, k)) = iadd(toInt(a), toInt(k)) -> toInt(nadd(a, succ(k))) = iadd(toInt(a), toInt(succ(k)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; toInt(nadd(a, k)) = iadd(toInt(a), toInt(k)) -> toInt(nadd(a, succ(k))) = iadd(toInt(a), toInt(succ(k)))
        [by forall_intro induction-step]
      @conclusion-for-all-b |
        forall b: Nat; toInt(nadd(a, b)) = iadd(toInt(a), toInt(b))
        [using instantiation induction((fun k: Nat => toInt(nadd(a, k)) = iadd(toInt(a), toInt(k)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall a: Nat; forall b: Nat; toInt(nadd(a, b)) = iadd(toInt(a), toInt(b))
    [by forall_intro generalize-a]
qed

// The embedding preserves the order: a gap of d + 1 in ℕ is a gap of toInt(d) + 1 in ℤ.
theorem toIntPreservesOrder: forall i: Nat; forall j: Nat; less_than(i, j) -> int_less_than(toInt(i), toInt(j))
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @given-below |
            assume less_than(i, j) {
              @below |
                less_than(i, j)
                [by hypothesis given-below]
              @gap-exists |
                exists d: Nat; nadd(i, succ(d)) = j
                [using specialize lessThanElim(i, j) below]
              @with-gap-d |
                unpack d: Nat from gap-exists {
                  @gap |
                    nadd(i, succ(d)) = j
                    [by hypothesis with-gap-d]
                  @image-of-sum |
                    toInt(nadd(i, succ(d))) = iadd(toInt(i), toInt(succ(d)))
                    [using specialize toIntAdd(i, succ(d))]
                  @image-of-gap |
                    toInt(succ(d)) = isucc(toInt(d))
                    [using specialize toIntSucc(d)]
                  @image-of-j-a |
                    toInt(j) = iadd(toInt(i), toInt(succ(d)))
                    [by rewrite gap image-of-sum]
                  @image-of-j |
                    toInt(j) = iadd(toInt(i), isucc(toInt(d)))
                    [by rewrite image-of-gap image-of-j-a]
                  @image-gap-form |
                    iadd(toInt(i), isucc(toInt(d))) = toInt(j)
                    [by symmetry image-of-j]
                  @gap-nonneg |
                    nonneg(toInt(d))
                    [using specialize toIntNonneg(d)]
                  @conclusion-images-ordered |
                    int_less_than(toInt(i), toInt(j))
                    [using specialize intLessThanIntro(toInt(i), toInt(d), toInt(j)) gap-nonneg image-gap-form]
                }
              @conclusion-ordered |
                int_less_than(toInt(i), toInt(j))
                [by exists_elim with-gap-d]
            }
          @conclusion-at-j |
            less_than(i, j) -> int_less_than(toInt(i), toInt(j))
            [by implies_intro given-below]
        }
      @discharge-j |
        forall j: Nat; less_than(i, j) -> int_less_than(toInt(i), toInt(j))
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; less_than(i, j) -> int_less_than(toInt(i), toInt(j))
    [by forall_intro generalize-i]
qed

// And reflects it (trichotomy in ℕ, irreflexivity in ℤ); so it is injective.
theorem toIntReflectsOrder: forall i: Nat; forall j: Nat; int_less_than(toInt(i), toInt(j)) -> less_than(i, j)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @given-images-ordered |
            assume int_less_than(toInt(i), toInt(j)) {
              @images-ordered |
                int_less_than(toInt(i), toInt(j))
                [by hypothesis given-images-ordered]
              @three-ways |
                less_than(i, j) or i = j or less_than(j, i)
                [using specialize trichotomy(i, j)]
              @image-not-below-itself |
                not int_less_than(toInt(i), toInt(i))
                [using specialize intLessThanIrreflexive(toInt(i))]
              @conclusion-below |
                less_than(i, j)
                case three-ways {
                  @when-below |
                    assume less_than(i, j) {
                      @conclusion-when-below |
                        less_than(i, j)
                        [by hypothesis when-below]
                    }
                  @when-equal |
                    assume i = j {
                      @equal |
                        i = j
                        [by hypothesis when-equal]
                      @image-below-itself |
                        int_less_than(toInt(i), toInt(i))
                        [by rewrite equal images-ordered]
                      @conclusion-when-equal |
                        less_than(i, j)
                        [by absurd image-below-itself image-not-below-itself]
                    }
                  @when-above |
                    assume less_than(j, i) {
                      @above |
                        less_than(j, i)
                        [by hypothesis when-above]
                      @images-reversed |
                        int_less_than(toInt(j), toInt(i))
                        [using specialize toIntPreservesOrder(j, i) above]
                      @image-below-itself |
                        int_less_than(toInt(i), toInt(i))
                        [using specialize intLessThanTransitive(toInt(i), toInt(j), toInt(i)) images-ordered images-reversed]
                      @conclusion-when-above |
                        less_than(i, j)
                        [by absurd image-below-itself image-not-below-itself]
                    }
                }
            }
          @conclusion-at-j |
            int_less_than(toInt(i), toInt(j)) -> less_than(i, j)
            [by implies_intro given-images-ordered]
        }
      @discharge-j |
        forall j: Nat; int_less_than(toInt(i), toInt(j)) -> less_than(i, j)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; int_less_than(toInt(i), toInt(j)) -> less_than(i, j)
    [by forall_intro generalize-i]
qed

theorem toIntInjective: forall i: Nat; forall j: Nat; toInt(i) = toInt(j) -> i = j
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @given-images-equal |
            assume toInt(i) = toInt(j) {
              @images-equal |
                toInt(i) = toInt(j)
                [by hypothesis given-images-equal]
              @three-ways |
                less_than(i, j) or i = j or less_than(j, i)
                [using specialize trichotomy(i, j)]
              @image-not-below-itself |
                not int_less_than(toInt(j), toInt(j))
                [using specialize intLessThanIrreflexive(toInt(j))]
              @conclusion-equal |
                i = j
                case three-ways {
                  @when-below |
                    assume less_than(i, j) {
                      @below |
                        less_than(i, j)
                        [by hypothesis when-below]
                      @images-ordered |
                        int_less_than(toInt(i), toInt(j))
                        [using specialize toIntPreservesOrder(i, j) below]
                      @image-below-itself |
                        int_less_than(toInt(j), toInt(j))
                        [by rewrite images-equal images-ordered]
                      @conclusion-when-below |
                        i = j
                        [by absurd image-below-itself image-not-below-itself]
                    }
                  @when-equal |
                    assume i = j {
                      @conclusion-when-equal |
                        i = j
                        [by hypothesis when-equal]
                    }
                  @when-above |
                    assume less_than(j, i) {
                      @above |
                        less_than(j, i)
                        [by hypothesis when-above]
                      @images-ordered |
                        int_less_than(toInt(j), toInt(i))
                        [using specialize toIntPreservesOrder(j, i) above]
                      @image-below-itself |
                        int_less_than(toInt(j), toInt(j))
                        [by rewrite images-equal images-ordered]
                      @conclusion-when-above |
                        i = j
                        [by absurd image-below-itself image-not-below-itself]
                    }
                }
            }
          @conclusion-at-j |
            toInt(i) = toInt(j) -> i = j
            [by implies_intro given-images-equal]
        }
      @discharge-j |
        forall j: Nat; toInt(i) = toInt(j) -> i = j
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; toInt(i) = toInt(j) -> i = j
    [by forall_intro generalize-i]
qed

// Every nonnegative integer is the image of some index: induction on the nonnegatives.
theorem everyNonnegIsAnImage: forall a: Int; nonneg(a) -> exists m: Nat; toInt(m) = a
proof
  @zero-image |
    toInt(NZERO) = IZERO
    [by cite toIntZero]
  @base-case |
    exists m: Nat; toInt(m) = IZERO
    [by exists_intro(NZERO) zero-image]
  @induction-step |
    fix k: Int {
      @given-nonneg |
        assume nonneg(k) {
          @given-inductive-hypothesis |
            assume exists m: Nat; toInt(m) = k {
              @inductive-hypothesis |
                exists m: Nat; toInt(m) = k
                [by hypothesis given-inductive-hypothesis]
              @with-index-m |
                unpack m: Nat from inductive-hypothesis {
                  @image-is-k |
                    toInt(m) = k
                    [by hypothesis with-index-m]
                  @next-image |
                    toInt(succ(m)) = isucc(toInt(m))
                    [using specialize toIntSucc(m)]
                  @next-image-is-succ-k |
                    toInt(succ(m)) = isucc(k)
                    [by rewrite image-is-k next-image]
                  @conclusion-witness |
                    exists m2: Nat; toInt(m2) = isucc(k)
                    [by exists_intro(succ(m)) next-image-is-succ-k]
                }
              @conclusion-step |
                exists m2: Nat; toInt(m2) = isucc(k)
                [by exists_elim with-index-m]
            }
          @conclusion-given-hypothesis |
            (exists m: Nat; toInt(m) = k) -> (exists m2: Nat; toInt(m2) = isucc(k))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-at-k |
        nonneg(k) -> (exists m: Nat; toInt(m) = k) -> (exists m2: Nat; toInt(m2) = isucc(k))
        [by implies_intro given-nonneg]
    }
  @induction-step-for-all-k |
    forall k: Int; nonneg(k) -> (exists m: Nat; toInt(m) = k) -> (exists m2: Nat; toInt(m2) = isucc(k))
    [by forall_intro induction-step]
  @conclusion |
    forall a: Int; nonneg(a) -> exists m: Nat; toInt(m) = a
    [using instantiation nonnegInduction((fun a: Int => exists m: Nat; toInt(m) = a)) base-case induction-step-for-all-k]
qed
