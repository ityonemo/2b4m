// std/integer/mod-n-polynomial.b4m — ℤ_p[x], AND ITS DOMAIN PROPERTY.
//
// Gauss's Lemma (AATA §17.3) reduces the coefficients of a ℤ[x] factorisation modulo a prime
// and argues in ℤ_p[x], where "neither factor is the zero polynomial, and ℤ_p[x] is an
// integral domain" gives the contradiction. This file is that ℤ_p[x].
//
// ℤ_p[x] is its OWN sort with `std/ring/polynomial.b4m`'s corpus transferred onto it, the
// same shape as `std/rational/polynomial.b4m`'s ℚ[x]: the whole POLYNOMIAL layer travels
// (`Poly`, `coeff`, `ZEROP`, the operations), not just the coefficient ring, because a
// transfer re-checks the source PROOF and those proofs mention `coeff`, whose result sort is
// the coefficient ring.
//
// THE DOMAIN PROPERTY is the point. It needs two things, both now available:
//   * ℤ_p has no zero divisors — `std/integer/mod-n-domain.b4m`;
//   * the product's leading coefficient is the product of the leadings —
//     `std/ring/polynomial/leading.b4m`'s `theProductsLeadingCoefficient`.
// Together: for nonzero p, q the coefficient at deg p + deg q is a product of two surviving
// leading coefficients, so it survives, so the product is not the zero polynomial.
theory ring <<< "std/ring.b4m"
theory ring_poly <<< "std/ring/polynomial.b4m"
theory ring_leading <<< "std/ring/polynomial/leading.b4m"
theory mod_n <<< "std/integer/mod-n.b4m"
theory mod_n_domain <<< "std/integer/mod-n-domain.b4m"
theory primes <<< "std/primes.b4m"
theory peano <<< "std/peano.b4m"

sort Zn = mod_n.Zn
sort Nat = peano.Nat
const N = mod_n.N
const ZERO = peano.ZERO
oper add = peano.add
pred is_prime = primes.is_prime

// -- ℤ_p[x] --------------------------------------------------------------------------------
sort ZnPoly
oper zcoeff(p: ZnPoly, i: Nat) => Zn
const ZZEROP: ZnPoly
const ZONEP: ZnPoly
oper zaddP(p: ZnPoly, q: ZnPoly) => ZnPoly:
  zcoeff(zaddP(p, q), i) = mod_n.add(zcoeff(p, i), zcoeff(q, i)).
  existence: aZaddPExists,
  uniqueness: zPolyExtensionality
oper znegP(p: ZnPoly) => ZnPoly:
  zcoeff(znegP(p), i) = mod_n.neg(zcoeff(p, i)).
  existence: aZnegPExists,
  uniqueness: zPolyExtensionality
oper zmulP(p: ZnPoly, q: ZnPoly) => ZnPoly:
  zcoeff(zmulP(p, q), i) = zconvolution(p, q, ZERO, i).
  existence: aZmulPExists,
  uniqueness: zPolyExtensionality
oper zconvolution(p: ZnPoly, q: ZnPoly, j: Nat, m: Nat) => Zn:
  zconvolution(p, q, j, ZERO) = mod_n.mul(zcoeff(p, j), zcoeff(q, ZERO));
  zconvolution(p, q, j, m) = mod_n.add(mod_n.mul(zcoeff(p, j), zcoeff(q, m)), zconvolution(p, q, peano.succ(j), peano.prev(m))) when m != ZERO.
  termination(peano): _, {zConvolutionIsGrounded, zconvolutionGrounded}
oper zdegree(p: ZnPoly) => Nat
pred zdegreeAtMost(p: ZnPoly, n: Nat)

// the coefficient equations: ℤ_p[x]'s own primitives, mirroring ring/polynomial.b4m's
axiom zPolyExtensionality: forall p, q: ZnPoly;
  (forall i: Nat; zcoeff(p, i) = zcoeff(q, i)) -> p = q

axiom aZaddPExists: forall p: ZnPoly; forall q: ZnPoly;
  exists r: ZnPoly; forall i: Nat; (zcoeff(r, i) = mod_n.add(zcoeff(p, i), zcoeff(q, i)))
axiom aZnegPExists: forall p: ZnPoly;
  exists r: ZnPoly; forall i: Nat; (zcoeff(r, i) = mod_n.neg(zcoeff(p, i)))
axiom aZmulPExists: forall p: ZnPoly; forall q: ZnPoly;
  exists r: ZnPoly; forall i: Nat; (zcoeff(r, i) = zconvolution(p, q, ZERO, i))
axiom zDegreeAtMostMeaning: forall p: ZnPoly; forall n: Nat;
  zdegreeAtMost(p, n) iff
  (forall i: Nat; peano.less_than(n, i) -> zcoeff(p, i) = mod_n.ZERO)
axiom zZeroPolyCoeff: forall i: Nat; zcoeff(ZZEROP, i) = mod_n.ZERO
axiom zOnePolyCoeffZero: zcoeff(ZONEP, ZERO) = mod_n.ONE
axiom zOnePolyCoeffHigher: forall i: Nat;
  zcoeff(ZONEP, peano.succ(i)) = mod_n.ZERO
axiom zDegreeIsALeadingIndex: forall p: ZnPoly;
  (not (p = ZZEROP)) -> (not (zcoeff(p, zdegree(p)) = mod_n.ZERO))
axiom zDegreeBoundsTheCoefficients: forall p: ZnPoly;
  (not (p = ZZEROP)) -> zdegreeAtMost(p, zdegree(p))

// What this file proves (verified manifest):
intheory theProductsLeadingCoefficientInZn
intheory aSurvivingCoefficientMakesItNonzero
intheory modNPolynomialsHaveNoZeroDivisors
intheory zAddPolyCoeff
intheory zNegPolyCoeff
intheory zMulPolyCoeff
intheory zConvolutionZero
intheory zConvolutionSucc
intheory zConvolutionReachesZeroFromAPredecessor
intheory zConvolutionIsGrounded

// -- the domain property -------------------------------------------------------------------

// R[x]'s corpus, transferred. ℤ_p is the coefficient ring; the polynomial layer travels too.
model ModNPolynomials {
  ring_poly.R: Zn
  ring_poly.zeroR: mod_n.ZERO
  ring_poly.oneR: mod_n.ONE
  ring_poly.addR: mod_n.add
  ring_poly.mulR: mod_n.mul
  ring_poly.negR: mod_n.neg
  ring_poly.mulOneLeftR <- mod_n.mulOneLeft
  ring_poly.mulIsCommutativeR <- mod_n_domain.mulIsCommutativeInZn

  // ring.b4m's own axioms: ring_poly aliases ring.Ring, so the ring theory under it
  // travels too. ℤ_n proves all seven, under its own names.
  ring.Ring: Zn
  ring.ZERO: mod_n.ZERO
  ring.ONE: mod_n.ONE
  ring.add: mod_n.add
  ring.mul: mod_n.mul
  ring.neg: mod_n.neg
  ring.addIsAssociative <- mod_n.addAssoc
  ring.addZeroLeft <- mod_n.addIdentityLeft
  ring.addNegLeft <- mod_n.addInverseLeft
  ring.addIsCommutative <- mod_n.addCommutes
  ring.mulIsAssociative <- mod_n.mulAssoc
  ring.mulAddDistribLeft <- mod_n.mulDistribLeft
  ring.mulAddDistribRight <- mod_n.mulDistribRight
  ring_poly.Nat: Nat
  ring_poly.ZERO: ZERO
  ring_poly.succ: peano.succ
  ring_poly.addN: add
  ring_poly.Poly: ZnPoly
  ring_poly.coeff: zcoeff
  ring_poly.ZEROP: ZZEROP
  ring_poly.ONEP: ZONEP
  ring_poly.addP: zaddP
  ring_poly.negP: znegP
  ring_poly.mulP: zmulP
  ring_poly.convolution: zconvolution
  ring_poly.degree: zdegree
  ring_poly.degreeAtMost: zdegreeAtMost
  ring_poly.polyExtensionality <- zPolyExtensionality
  ring_poly.degreeAtMostMeaning <- zDegreeAtMostMeaning
  ring_poly.zeroPolyCoeff <- zZeroPolyCoeff
  ring_poly.onePolyCoeffZero <- zOnePolyCoeffZero
  ring_poly.onePolyCoeffHigher <- zOnePolyCoeffHigher
  ring_poly.addP <- zaddP
  ring_poly.negP <- znegP
  ring_poly.convolution <- zconvolution
  ring_poly.mulP <- zmulP
  ring_poly.degreeIsALeadingIndex <- zDegreeIsALeadingIndex
  ring_poly.degreeBoundsTheCoefficients <- zDegreeBoundsTheCoefficients
}

// The product's leading coefficient, transferred.
theorem theProductsLeadingCoefficientInZn: forall p, q: ZnPoly; forall m, n: Nat;
  zdegreeAtMost(p, m) -> zdegreeAtMost(q, n) ->
  zcoeff(zmulP(p, q), add(m, n)) =
  mod_n.mul(zcoeff(p, m), zcoeff(q, n))
proof
  @conclusion |
    forall p, q: ZnPoly; forall m, n: Nat;
      zdegreeAtMost(p, m) -> zdegreeAtMost(q, n) ->
      zcoeff(zmulP(p, q), add(m, n)) =
      mod_n.mul(zcoeff(p, m), zcoeff(q, n))
    [using model(ModNPolynomials) ring_leading.theProductsLeadingCoefficient]
qed

// A polynomial with a surviving coefficient is not the zero polynomial.
theorem aSurvivingCoefficientMakesItNonzero: forall p: ZnPoly; forall i: Nat;
  (not (zcoeff(p, i) = mod_n.ZERO)) -> (not (p = ZZEROP))
proof
  @conclusion |
    forall p: ZnPoly; forall i: Nat;
      (not (zcoeff(p, i) = mod_n.ZERO)) -> (not (p = ZZEROP))
    [using model(ModNPolynomials) ring_poly.aNonvanishingCoefficientMakesItNonzero]
qed

// ℤ_p[x] IS AN INTEGRAL DOMAIN: for prime N, a product of nonzero polynomials is nonzero.
// This is what Gauss's Lemma needs — his "this is impossible since neither α₁'(x) nor
// β₁'(x) is the zero polynomial and ℤ_p[x] is an integral domain".
theorem modNPolynomialsHaveNoZeroDivisors: forall p, q: ZnPoly;
  is_prime(N) -> (not (p = ZZEROP)) -> (not (q = ZZEROP)) ->
  (not (zmulP(p, q) = ZZEROP))
proof
  @generalize-p |
    fix p: ZnPoly {
      @generalize-q |
        fix q: ZnPoly {
          @given-the-modulus-is-prime |
            assume is_prime(N) {
              @the-modulus-is-prime |
                is_prime(N)
                [by hypothesis given-the-modulus-is-prime]
              @given-p-nonzero |
                assume not (p = ZZEROP) {
                  @p-nonzero |
                    not (p = ZZEROP)
                    [by hypothesis given-p-nonzero]
                  @given-q-nonzero |
                    assume not (q = ZZEROP) {
                      @q-nonzero |
                        not (q = ZZEROP)
                        [by hypothesis given-q-nonzero]
                      // each is bounded by its degree, with a surviving leading coefficient
                      @p-bounded |
                        zdegreeAtMost(p, zdegree(p))
                        [using specialize zDegreeBoundsTheCoefficients(p) p-nonzero]
                      @q-bounded |
                        zdegreeAtMost(q, zdegree(q))
                        [using specialize zDegreeBoundsTheCoefficients(q) q-nonzero]
                      @p-leads |
                        not (zcoeff(p, zdegree(p)) = mod_n.ZERO)
                        [using specialize zDegreeIsALeadingIndex(p) p-nonzero]
                      @q-leads |
                        not (zcoeff(q, zdegree(q)) = mod_n.ZERO)
                        [using specialize zDegreeIsALeadingIndex(q) q-nonzero]
                      // the product's coefficient at the degree sum
                      @the-leading-product |
                        zcoeff(zmulP(p, q), add(zdegree(p), zdegree(q))) =
                          mod_n.mul(zcoeff(p, zdegree(p)), zcoeff(q, zdegree(q)))
                        [using specialize theProductsLeadingCoefficientInZn(p, q, zdegree(p), zdegree(q)) p-bounded q-bounded]
                      // ℤ_p has no zero divisors
                      @the-coefficients-have-no-zero-divisors |
                        mod_n.mul(zcoeff(p, zdegree(p)), zcoeff(q, zdegree(q))) =
                          mod_n.ZERO ->
                          (zcoeff(p, zdegree(p)) = mod_n.ZERO or
                          zcoeff(q, zdegree(q)) = mod_n.ZERO)
                        [using specialize mod_n_domain.aPrimeModulusHasNoZeroDivisors(zcoeff(p, zdegree(p)), zcoeff(q, zdegree(q))) the-modulus-is-prime]
                      @the-leading-product-survives |
                        not (mod_n.mul(zcoeff(p, zdegree(p)),
                          zcoeff(q, zdegree(q))) = mod_n.ZERO)
                        [using tautology the-coefficients-have-no-zero-divisors p-leads q-leads]
                      @the-products-coefficient-survives |
                        not (zcoeff(zmulP(p, q),
                          add(zdegree(p), zdegree(q))) = mod_n.ZERO)
                        [by rewrite the-leading-product the-leading-product-survives]
                      @conclusion-the-product-is-nonzero |
                        not (zmulP(p, q) = ZZEROP)
                        [using specialize aSurvivingCoefficientMakesItNonzero(zmulP(p, q), add(zdegree(p), zdegree(q))) the-products-coefficient-survives]
                    }
                  @q-nonzero-implies |
                    (not (q = ZZEROP)) -> (not (zmulP(p, q) = ZZEROP))
                    [by discharge given-q-nonzero]
                }
              @p-nonzero-implies |
                (not (p = ZZEROP)) -> (not (q = ZZEROP)) ->
                  (not (zmulP(p, q) = ZZEROP))
                [by discharge given-p-nonzero]
            }
          @prime-implies |
            is_prime(N) -> (not (p = ZZEROP)) -> (not (q = ZZEROP)) ->
              (not (zmulP(p, q) = ZZEROP))
            [by discharge given-the-modulus-is-prime]
        }
      @discharge-q |
        forall q9: ZnPoly;
          is_prime(N) -> (not (p = ZZEROP)) -> (not (q9 = ZZEROP)) ->
          (not (zmulP(p, q9) = ZZEROP))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: ZnPoly;
      is_prime(N) -> (not (p = ZZEROP)) -> (not (q = ZZEROP)) ->
      (not (zmulP(p, q) = ZZEROP))
    [by generalize generalize-p]
qed

// -- definition-clause shims ---------------------------------------------------------------
//
// The symbols above are DEFINITION BLOCKS, so `--axioms` reports their clauses as
// definitions rather than as assumptions to weigh. A clause has no user-facing name,
// though, and a model's `<-` and `specialize` both resolve BY NAME — so each clause keeps a
// one-line theorem under the name it had as an axiom. These add no assumption: every one is
// proved `[by definition(N) <symbol>]`.

theorem zAddPolyCoeff:
  forall p, q: ZnPoly; forall i: Nat;
  zcoeff(zaddP(p, q), i) = mod_n.add(zcoeff(p, i), zcoeff(q, i))
proof
  @conclusion |
    forall p, q: ZnPoly; forall i: Nat;
      zcoeff(zaddP(p, q), i) = mod_n.add(zcoeff(p, i), zcoeff(q, i))
    [by definition zaddP]
qed

theorem zNegPolyCoeff:
  forall p: ZnPoly; forall i: Nat;
  zcoeff(znegP(p), i) = mod_n.neg(zcoeff(p, i))
proof
  @conclusion |
    forall p: ZnPoly; forall i: Nat;
      zcoeff(znegP(p), i) = mod_n.neg(zcoeff(p, i))
    [by definition znegP]
qed

theorem zMulPolyCoeff:
  forall p, q: ZnPoly; forall i: Nat;
  zcoeff(zmulP(p, q), i) = zconvolution(p, q, ZERO, i)
proof
  @conclusion |
    forall p, q: ZnPoly; forall i: Nat;
      zcoeff(zmulP(p, q), i) = zconvolution(p, q, ZERO, i)
    [by definition zmulP]
qed

theorem zConvolutionZero:
  forall p, q: ZnPoly; forall j: Nat;
  zconvolution(p, q, j, ZERO) =
  mod_n.mul(zcoeff(p, j), zcoeff(q, ZERO))
proof
  @conclusion |
    forall p, q: ZnPoly; forall j: Nat;
      zconvolution(p, q, j, ZERO) =
      mod_n.mul(zcoeff(p, j), zcoeff(q, ZERO))
    [by definition(0) zconvolution]
qed

theorem zConvolutionSucc:
  forall p, q: ZnPoly; forall j, m: Nat;
  zconvolution(p, q, j, peano.succ(m)) =
  mod_n.add(mod_n.mul(zcoeff(p, j), zcoeff(q, peano.succ(m))),
  zconvolution(p, q, peano.succ(j), m))
proof
  @the-recursive-clause |
    forall p2: ZnPoly; forall q2: ZnPoly; forall j2: Nat; forall m2: Nat;
      m2 != ZERO ->
      zconvolution(p2, q2, j2, m2) =
      mod_n.add(mod_n.mul(zcoeff(p2, j2), zcoeff(q2, m2)),
      zconvolution(p2, q2, peano.succ(j2), peano.prev(m2)))
    [by definition(1) zconvolution]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != ZERO
    [using import(peano) succNotZero]
  @generalize-p |
    fix p: ZnPoly {
      @generalize-q |
        fix q: ZnPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @succ-m-is-nonzero |
                    peano.succ(m) != ZERO
                    [using specialize a-successor-is-never-zero(m)]
                  @clause-at-the-successor |
                    zconvolution(p, q, j, peano.succ(m)) =
                      mod_n.add(mod_n.mul(zcoeff(p, j), zcoeff(q, peano.succ(m))),
                      zconvolution(p, q, peano.succ(j), peano.prev(peano.succ(m))))
                    [using specialize the-recursive-clause(p, q, j, peano.succ(m)) succ-m-is-nonzero]
                  @prev-of-succ-m |
                    peano.prev(peano.succ(m)) = m
                    [using specialize prev-undoes-succ(m)]
                  @conclusion-step-at-m |
                    zconvolution(p, q, j, peano.succ(m)) =
                      mod_n.add(mod_n.mul(zcoeff(p, j), zcoeff(q, peano.succ(m))),
                      zconvolution(p, q, peano.succ(j), m))
                    [by rewrite prev-of-succ-m clause-at-the-successor]
                }
              @discharge-m |
                forall m: Nat;
                  zconvolution(p, q, j, peano.succ(m)) =
                  mod_n.add(mod_n.mul(zcoeff(p, j), zcoeff(q, peano.succ(m))),
                  zconvolution(p, q, peano.succ(j), m))
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j, m: Nat;
              zconvolution(p, q, j, peano.succ(m)) =
              mod_n.add(mod_n.mul(zcoeff(p, j), zcoeff(q, peano.succ(m))),
              zconvolution(p, q, peano.succ(j), m))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: ZnPoly; forall j, m: Nat;
          zconvolution(p, q, j, peano.succ(m)) =
          mod_n.add(mod_n.mul(zcoeff(p, j), zcoeff(q, peano.succ(m))),
          zconvolution(p, q, peano.succ(j), m))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: ZnPoly; forall j, m: Nat;
      zconvolution(p, q, j, peano.succ(m)) =
      mod_n.add(mod_n.mul(zcoeff(p, j), zcoeff(q, peano.succ(m))),
      zconvolution(p, q, peano.succ(j), m))
    [by generalize generalize-p]
qed

// -- zconvolution's TERMINATION obligation ------------------------------------------
//
// The checker GENERATES the predicate from the recursive arm's one call site:
//
//     zconvolutionGrounded(m) iff
//       (zconvolutionGrounded(peano.prev(m))
//        or peano.prev(m) = ZERO)
//
// The `prev(m) = ZERO` disjunct is the base — the ZERO arm is the only terminating one — and
// it is what lets the recursion bottom out. The ASCENDING `j` costs nothing: termination asks
// only whether the DESCENT reaches a base.

// Strategy: the inductive step on the descending index. At `succ(k)` the clause's `prev`
// collapses to `k`, leaving either `k = ZERO` (base disjunct) or the hypothesis at `k`;
// `tautology` picks whichever holds.
theorem zConvolutionReachesZeroFromAPredecessor: forall k: Nat;
  (forall p2: ZnPoly; forall q2: ZnPoly; forall j2: Nat;
  k != ZERO -> zconvolutionGrounded(k))
  -> (forall p: ZnPoly; forall q: ZnPoly; forall j: Nat;
  peano.succ(k) != ZERO -> zconvolutionGrounded(peano.succ(k)))
proof
  @the-generated-clause |
    forall m3: Nat; zconvolutionGrounded(m3) iff
      (zconvolutionGrounded(peano.prev(m3))
      or peano.prev(m3) = ZERO)
    [by definition zconvolutionGrounded]
  @prev-undoes-succ |
    forall n: Nat; peano.prev(peano.succ(n)) = n
    [using import(peano) prevOfSucc]
  @a-successor-is-never-zero |
    forall a: Nat; peano.succ(a) != ZERO
    [using import(peano) succNotZero]
  @generalize-k |
    fix k: Nat {
      @given-the-inductive-hypothesis |
        assume forall p2: ZnPoly; forall q2: ZnPoly; forall j2: Nat;
          k != ZERO -> zconvolutionGrounded(k) {
          @inductive-hypothesis |
            forall p2: ZnPoly; forall q2: ZnPoly; forall j2: Nat;
              k != ZERO -> zconvolutionGrounded(k)
            [by hypothesis given-the-inductive-hypothesis]
          // `prev` is guarded, so the guard fact precedes every term writing `prev(succ(k))`.
          @succ-k-is-nonzero |
            peano.succ(k) != ZERO
            [using specialize a-successor-is-never-zero(k)]
          @prev-of-succ-k-is-k |
            peano.prev(peano.succ(k)) = k
            [using specialize prev-undoes-succ(k)]
          @generalize-p |
            fix p: ZnPoly {
              @generalize-q |
                fix q: ZnPoly {
                  @generalize-j |
                    fix j: Nat {
                      @clause-at-succ-k |
                        zconvolutionGrounded(peano.succ(k)) iff
                          (zconvolutionGrounded(peano.prev(peano.succ(k)))
                          or peano.prev(peano.succ(k)) = ZERO)
                        [using specialize the-generated-clause(peano.succ(k))]
                      @clause-with-the-predecessor-collapsed |
                        zconvolutionGrounded(peano.succ(k)) iff
                          (zconvolutionGrounded(k) or k = ZERO)
                        [by rewrite prev-of-succ-k-is-k clause-at-succ-k]
                      @the-inductive-hypothesis-at-the-raised-index |
                        k != ZERO -> zconvolutionGrounded(k)
                        [using specialize inductive-hypothesis(p, q, peano.succ(j))]
                      @grounded-at-succ-k |
                        zconvolutionGrounded(peano.succ(k))
                        [using tautology clause-with-the-predecessor-collapsed
                          the-inductive-hypothesis-at-the-raised-index]
                      @conclusion-nonzero-implies-grounded |
                        peano.succ(k) != ZERO
                          -> zconvolutionGrounded(peano.succ(k))
                        [using tautology grounded-at-succ-k]
                    }
                  @discharge-j |
                    forall j: Nat;
                      peano.succ(k) != ZERO
                      -> zconvolutionGrounded(peano.succ(k))
                    [by generalize generalize-j]
                }
              @discharge-q |
                forall q: ZnPoly; forall j: Nat;
                  peano.succ(k) != ZERO
                  -> zconvolutionGrounded(peano.succ(k))
                [by generalize generalize-q]
            }
          @conclusion-for-all-polynomials |
            forall p: ZnPoly; forall q: ZnPoly; forall j: Nat;
              peano.succ(k) != ZERO -> zconvolutionGrounded(peano.succ(k))
            [by generalize generalize-p]
        }
      @the-hypothesis-implies-the-step |
        (forall p2: ZnPoly; forall q2: ZnPoly; forall j2: Nat;
          k != ZERO -> zconvolutionGrounded(k))
          -> (forall p: ZnPoly; forall q: ZnPoly; forall j: Nat;
          peano.succ(k) != ZERO -> zconvolutionGrounded(peano.succ(k)))
        [by discharge given-the-inductive-hypothesis]
    }
  @conclusion |
    forall k: Nat;
      (forall p2: ZnPoly; forall q2: ZnPoly; forall j2: Nat;
      k != ZERO -> zconvolutionGrounded(k))
      -> (forall p: ZnPoly; forall q: ZnPoly; forall j: Nat;
      peano.succ(k) != ZERO -> zconvolutionGrounded(peano.succ(k)))
    [by generalize generalize-k]
qed

// Strategy: `peano.induction` on the descending index. The base is VACUOUS — at ZERO the
// antecedent demands `ZERO != ZERO` — so all the content is in the step above.
theorem zConvolutionIsGrounded:
  forall p: ZnPoly; forall q: ZnPoly; forall j: Nat; forall m: Nat;
  m != ZERO -> zconvolutionGrounded(m)
proof
  @zero-is-itself |
    ZERO = ZERO
    [by reflexivity]
  // `tautology` reads a `forall` as one opaque atom, so the binders are opened before the
  // vacuous antecedent can be refuted inside them.
  @base-case-proof |
    fix p: ZnPoly {
      @generalize-q-at-zero |
        fix q: ZnPoly {
          @generalize-j-at-zero |
            fix j: Nat {
              @conclusion-vacuously-grounded-at-zero |
                ZERO != ZERO -> zconvolutionGrounded(ZERO)
                [using tautology zero-is-itself]
            }
          @discharge-j-at-zero |
            forall j: Nat; ZERO != ZERO -> zconvolutionGrounded(ZERO)
            [by generalize generalize-j-at-zero]
        }
      @discharge-q-at-zero |
        forall q: ZnPoly; forall j: Nat;
          ZERO != ZERO -> zconvolutionGrounded(ZERO)
        [by generalize generalize-q-at-zero]
    }
  @base-case |
    forall p: ZnPoly; forall q: ZnPoly; forall j: Nat;
      ZERO != ZERO -> zconvolutionGrounded(ZERO)
    [by generalize base-case-proof]
  @induction-step-for-all-k |
    forall k: Nat;
      (forall p2: ZnPoly; forall q2: ZnPoly; forall j2: Nat;
      k != ZERO -> zconvolutionGrounded(k))
      -> (forall p: ZnPoly; forall q: ZnPoly; forall j: Nat;
      peano.succ(k) != ZERO -> zconvolutionGrounded(peano.succ(k)))
    [by cite zConvolutionReachesZeroFromAPredecessor]
  @grounded-for-every-descending-index |
    forall m: Nat; forall p: ZnPoly; forall q: ZnPoly; forall j: Nat;
      m != ZERO -> zconvolutionGrounded(m)
    [using instantiation peano.induction((fun m: Nat => (forall p: ZnPoly; forall q: ZnPoly; forall j: Nat; m != ZERO -> zconvolutionGrounded(m)))) base-case induction-step-for-all-k]
  @generalize-p |
    fix p: ZnPoly {
      @generalize-q |
        fix q: ZnPoly {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @grounded-at-these-indices |
                    m != ZERO -> zconvolutionGrounded(m)
                    [using specialize grounded-for-every-descending-index(m, p, q, j)]
                }
              @discharge-m |
                forall m: Nat; m != ZERO -> zconvolutionGrounded(m)
                [by generalize generalize-m]
            }
          @discharge-j |
            forall j: Nat; forall m: Nat; m != ZERO -> zconvolutionGrounded(m)
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: ZnPoly; forall j: Nat; forall m: Nat;
          m != ZERO -> zconvolutionGrounded(m)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p: ZnPoly; forall q: ZnPoly; forall j: Nat; forall m: Nat;
      m != ZERO -> zconvolutionGrounded(m)
    [by generalize generalize-p]
qed
