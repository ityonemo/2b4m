// std/integer/polynomial.b4m — ℤ[x], AND REDUCTION OF COEFFICIENTS MODULO N.
//
// Gauss's Lemma (AATA §17.3) factors a monic ℤ[x] polynomial through ℚ[x], then — when the
// denominator does not come out to 1 — reduces the coefficients modulo a prime and derives a
// contradiction in ℤ_p[x]. This file is that ℤ[x], and the reduction map into
// `std/integer/mod-n-polynomial.b4m`'s ℤ_p[x].
//
// ℤ[x] is its own sort with `std/ring/polynomial.b4m`'s corpus transferred onto it — the
// fourth such layer in std, after R[x], F[x], ℚ[x] and ℤ_p[x]. Each restates the same
// coefficient equations over a different coefficient ring, which is the duplication a
// generic polynomial theory would remove; see `drafts/algebra-layering/README.md`.
//
// NOTE the transfer must map `std/ring.b4m`'s OWN layer as well, because
// `std/ring/polynomial.b4m` aliases `ring.Ring` rather than treating it as a parameter. The
// error for omitting it surfaces inside `std/ring.b4m`, not here.
import ring <<< "std/ring.b4m"
import ring_poly <<< "std/ring/polynomial.b4m"
import ring_leading <<< "std/ring/polynomial/leading.b4m"
import integer <<< "std/integer.b4m"
import int_divides <<< "std/integer/divides.b4m"
import mod_n <<< "std/integer/mod-n.b4m"
import mod_n_domain <<< "std/integer/mod-n-domain.b4m"
import mod_n_poly <<< "std/integer/mod-n-polynomial.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"

sort Int = integer.Int
sort ZnPoly = mod_n_poly.ZnPoly
sort Nat = peano.Nat
const N = mod_n.N
const ZERO = peano.ZERO
const INT_ZERO = integer.ZERO
oper add = peano.add
pred divides = int_divides.divides
pred is_prime = mod_n_domain.is_prime

// -- ℤ[x] ----------------------------------------------------------------------------------
sort IntPoly
oper icoeff(p: IntPoly, i: Nat) => Int
const IZEROP: IntPoly
const IONEP: IntPoly
oper iaddP(p: IntPoly, q: IntPoly) => IntPoly:
  icoeff(iaddP(p, q), i) = integer.add(icoeff(p, i), icoeff(q, i))
oper inegP(p: IntPoly) => IntPoly:
  icoeff(inegP(p), i) = integer.neg(icoeff(p, i))
oper imulP(p: IntPoly, q: IntPoly) => IntPoly:
  icoeff(imulP(p, q), i) = iconvolution(p, q, ZERO, i)
oper iconvolution(p: IntPoly, q: IntPoly, i: Nat, k: Nat) => Int:
  iconvolution(p, q, j, ZERO) = integer.mul(icoeff(p, j), icoeff(q, ZERO));
  iconvolution(p, q, j, peano.succ(m)) = integer.add(integer.mul(icoeff(p, j), icoeff(q, peano.succ(m))), iconvolution(p, q, peano.succ(j), m))
oper idegree(p: IntPoly) => Nat
pred idegreeAtMost(p: IntPoly, n: Nat)

axiom iPolyExtensionality: forall p, q: IntPoly;
  (forall i: Nat; icoeff(p, i) = icoeff(q, i)) -> p = q
axiom iDegreeAtMostMeaning: forall p: IntPoly; forall n: Nat;
  idegreeAtMost(p, n) iff
  (forall i: Nat; peano.less_than(n, i) -> icoeff(p, i) = INT_ZERO)
axiom iZeroPolyCoeff: forall i: Nat; icoeff(IZEROP, i) = INT_ZERO
axiom iOnePolyCoeffZero: icoeff(IONEP, ZERO) = integer.ONE
axiom iOnePolyCoeffHigher: forall i: Nat;
  icoeff(IONEP, peano.succ(i)) = INT_ZERO
axiom iDegreeIsALeadingIndex: forall p: IntPoly;
  (not (p = IZEROP)) -> (not (icoeff(p, idegree(p)) = INT_ZERO))
axiom iDegreeBoundsTheCoefficients: forall p: IntPoly;
  (not (p = IZEROP)) -> idegreeAtMost(p, idegree(p))

model IntegerPolynomials {
  ring.Ring: Int
  ring.ZERO: INT_ZERO
  ring.ONE: integer.ONE
  ring.add: integer.add
  ring.mul: integer.mul
  ring.neg: integer.neg
  ring.addIsAssociative <- integer.addIsAssociative
  ring.addZeroLeft <- integer.addZeroLeft
  ring.addNegLeft <- integer.addNegLeft
  ring.addIsCommutative <- integer.addIsCommutative
  ring.mulIsAssociative <- integer.mulIsAssociative
  ring.mulAddDistribLeft <- integer.mulAddDistribLeft
  ring.mulAddDistribRight <- integer.mulAddDistribRight
  ring_poly.R: Int
  ring_poly.zeroR: INT_ZERO
  ring_poly.oneR: integer.ONE
  ring_poly.addR: integer.add
  ring_poly.mulR: integer.mul
  ring_poly.negR: integer.neg
  ring_poly.mulOneLeftR <- integer.mulOneLeft
  ring_poly.mulIsCommutativeR <- integer.mulIsCommutative
  ring_poly.Nat: Nat
  ring_poly.ZERO: ZERO
  ring_poly.succ: peano.succ
  ring_poly.addN: add
  ring_poly.Poly: IntPoly
  ring_poly.coeff: icoeff
  ring_poly.ZEROP: IZEROP
  ring_poly.ONEP: IONEP
  ring_poly.addP: iaddP
  ring_poly.negP: inegP
  ring_poly.mulP: imulP
  ring_poly.convolution: iconvolution
  ring_poly.degree: idegree
  ring_poly.degreeAtMost: idegreeAtMost
  ring_poly.polyExtensionality <- iPolyExtensionality
  ring_poly.degreeAtMostMeaning <- iDegreeAtMostMeaning
  ring_poly.zeroPolyCoeff <- iZeroPolyCoeff
  ring_poly.onePolyCoeffZero <- iOnePolyCoeffZero
  ring_poly.onePolyCoeffHigher <- iOnePolyCoeffHigher
  ring_poly.addP <- iaddP
  ring_poly.negP <- inegP
  ring_poly.convolution <- iconvolution
  ring_poly.mulP <- imulP
  ring_poly.degreeIsALeadingIndex <- iDegreeIsALeadingIndex
  ring_poly.degreeBoundsTheCoefficients <- iDegreeBoundsTheCoefficients
}

// -- reduction of coefficients modulo N ----------------------------------------------------
// `reduce(f)` applies `cls` to every coefficient. Judson's "let α₁'(x) be the polynomial in
// ℤ_p[x] obtained by reducing the coefficients of α₁(x) modulo p".
oper reduce(p: IntPoly) => ZnPoly:
  mod_n_poly.zcoeff(reduce(p), i) = mod_n.cls(icoeff(p, i))

// A polynomial with a coefficient the modulus misses reduces to something nonzero — which is
// how Judson's "there exists a coefficient a_i such that p ∤ a_i" gives α₁'(x) ≠ 0.
theorem aSurvivingCoefficientSurvivesReduction: forall p: IntPoly; forall i: Nat;
  (not divides(N, icoeff(p, i))) -> (not (reduce(p) = mod_n_poly.ZZEROP))
proof
  @generalize-p |
    fix p: IntPoly {
      @generalize-i |
        fix i: Nat {
          @given-the-modulus-misses |
            assume not divides(N, icoeff(p, i)) {
              @the-modulus-misses |
                not divides(N, icoeff(p, i))
                [by hypothesis given-the-modulus-misses]
              // the class of that coefficient survives
              @vanishing-means-divisible |
                mod_n.cls(icoeff(p, i)) = mod_n.ZERO iff
                  divides(N, icoeff(p, i))
                [using specialize mod_n_domain.aClassIsZeroWhenTheModulusDivides(icoeff(p, i))]
              @the-class-survives |
                not (mod_n.cls(icoeff(p, i)) = mod_n.ZERO)
                [using tautology vanishing-means-divisible the-modulus-misses]
              @the-reduced-coefficient |
                mod_n_poly.zcoeff(reduce(p), i) = mod_n.cls(icoeff(p, i))
                [using specialize reduceCoefficientwise(p, i)]
              @the-reduced-coefficient-survives |
                not (mod_n_poly.zcoeff(reduce(p), i) = mod_n.ZERO)
                [by rewrite the-reduced-coefficient the-class-survives]
              @conclusion-the-reduction-is-nonzero |
                not (reduce(p) = mod_n_poly.ZZEROP)
                [using specialize mod_n_poly.aSurvivingCoefficientMakesItNonzero(reduce(p), i) the-reduced-coefficient-survives]
            }
          @misses-implies-nonzero |
            (not divides(N, icoeff(p, i))) ->
              (not (reduce(p) = mod_n_poly.ZZEROP))
            [by discharge given-the-modulus-misses]
        }
      @discharge-i |
        forall i9: Nat;
          (not divides(N, icoeff(p, i9))) ->
          (not (reduce(p) = mod_n_poly.ZZEROP))
        [by generalize generalize-i]
    }
  @conclusion |
    forall p: IntPoly; forall i: Nat;
      (not divides(N, icoeff(p, i))) ->
      (not (reduce(p) = mod_n_poly.ZZEROP))
    [by generalize generalize-p]
qed

// -- the transferred corpus ------------------------------------------------------------------
// R[x]'s results at ℤ, which is what the model buys and what exercises the coefficient
// equations above. The first three are the ring laws Gauss's algebra runs on; the last two
// are the degree facts its contradiction needs.

theorem integerPolyAddIsCommutative: forall p, q: IntPoly;
  iaddP(p, q) = iaddP(q, p)
proof
  @conclusion |
    forall p, q: IntPoly; iaddP(p, q) = iaddP(q, p)
    [using model(IntegerPolynomials) ring_poly.polyAddIsCommutative]
qed

// NOT transferred: `polyMulIsCommutative`. R[x] proves it through `tailConvolution` and
// `segment` — two further layers of its own — so carrying it here would mean restating both.
// Gauss does not need it, and a generic polynomial theory would make it free; see
// `drafts/algebra-layering/README.md`.

theorem integerPolyMulOneLeft: forall p: IntPoly;
  imulP(IONEP, p) = p
proof
  @conclusion |
    forall p: IntPoly; imulP(IONEP, p) = p
    [using model(IntegerPolynomials) ring_poly.polyMulOneLeft]
qed

// the leading-product step at ℤ — what Gauss's leading-coefficient reasoning uses
theorem theIntegerProductsLeadingCoefficient: forall p, q: IntPoly; forall m, n: Nat;
  idegreeAtMost(p, m) -> idegreeAtMost(q, n) ->
  icoeff(imulP(p, q), add(m, n)) =
  integer.mul(icoeff(p, m), icoeff(q, n))
proof
  @conclusion |
    forall p, q: IntPoly; forall m, n: Nat;
      idegreeAtMost(p, m) -> idegreeAtMost(q, n) ->
      icoeff(imulP(p, q), add(m, n)) =
      integer.mul(icoeff(p, m), icoeff(q, n))
    [using model(IntegerPolynomials) ring_leading.theProductsLeadingCoefficient]
qed

// and the degree bound
theorem theIntegerProductVanishesAboveTheDegreeSum: forall p, q: IntPoly;
  forall m, n, i: Nat;
  idegreeAtMost(p, m) -> idegreeAtMost(q, n) ->
  peano.less_than(add(m, n), i) ->
  icoeff(imulP(p, q), i) = INT_ZERO
proof
  @conclusion |
    forall p, q: IntPoly; forall m, n, i: Nat;
      idegreeAtMost(p, m) -> idegreeAtMost(q, n) ->
      peano.less_than(add(m, n), i) ->
      icoeff(imulP(p, q), i) = INT_ZERO
    [using model(IntegerPolynomials) ring_leading.theProductVanishesAboveTheDegreeSum]
qed

// -- reduction is a ring homomorphism ------------------------------------------------------
// Judson writes "let α₁'(x) and β₁'(x) be the polynomials in ℤ_p[x] obtained by reducing the
// coefficients of α₁(x) and β₁(x) modulo p", then uses α₁'·β₁' where he means (α₁·β₁)'. That
// step is only legitimate because `reduce` commutes with multiplication, which he leaves to
// the reader. It does, and this is the proof: the two convolution recursions are the same
// recursion, and `cls` is an add- and mul-homomorphism at every step, so induct on the
// convolution's second index.

// Strategy: induction on the LENGTH, with the BASE index quantified inside the hypothesis so
// the step can fire it one higher — the reindexed recursion moves the base, where the old one
// kept it fixed and moved a subtraction.
theorem reduceCommutesWithTheConvolution: forall p, q: IntPoly; forall m, j: Nat;
  mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
  mod_n.cls(iconvolution(p, q, j, m))
proof
  @generalize-p |
    fix p: IntPoly {
      @generalize-q |
        fix q: IntPoly {
          @base-case |
            forall j: Nat;
              mod_n_poly.zconvolution(reduce(p), reduce(q), j, ZERO) =
              mod_n.cls(iconvolution(p, q, j, ZERO))
            [using specialize theReductionBase(p, q)]
          @induction-step-for-all-m |
            forall m: Nat;
              (forall j: Nat;
              mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
              mod_n.cls(iconvolution(p, q, j, m))) ->
              (forall j: Nat;
              mod_n_poly.zconvolution(reduce(p), reduce(q), j, peano.succ(m)) =
              mod_n.cls(iconvolution(p, q, j, peano.succ(m))))
            [using specialize theReductionStep(p, q)]
          @all-lengths |
            forall m: Nat; forall j: Nat;
              mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
              mod_n.cls(iconvolution(p, q, j, m))
            [using instantiation peano.induction((fun t: Nat => forall j: Nat; mod_n_poly.zconvolution(reduce(p), reduce(q), j, t) = mod_n.cls(iconvolution(p, q, j, t)))) base-case induction-step-for-all-m]
        }
      @discharge-q |
        forall q: IntPoly; forall m, j: Nat;
          mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
          mod_n.cls(iconvolution(p, q, j, m))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: IntPoly; forall m, j: Nat;
      mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
      mod_n.cls(iconvolution(p, q, j, m))
    [by generalize generalize-p]
qed

// The base: a single coefficient product on each side, bridged by `mulHom`.
theorem theReductionBase: forall p, q: IntPoly; forall j: Nat;
  mod_n_poly.zconvolution(reduce(p), reduce(q), j, ZERO) =
  mod_n.cls(iconvolution(p, q, j, ZERO))
proof
  @generalize-p |
    fix p: IntPoly {
      @generalize-q |
        fix q: IntPoly {
          @generalize-j |
            fix j: Nat {
              @the-reduced-convolution |
                mod_n_poly.zconvolution(reduce(p), reduce(q), j, ZERO) =
                  mod_n.mul(mod_n_poly.zcoeff(reduce(p), j),
                  mod_n_poly.zcoeff(reduce(q), ZERO))
                [using specialize mod_n_poly.zConvolutionZero(reduce(p), reduce(q), j)]
              @the-integer-convolution |
                iconvolution(p, q, j, ZERO) =
                  integer.mul(icoeff(p, j), icoeff(q, ZERO))
                [using specialize iConvolutionZero(p, q, j)]
              @the-reduced-coefficient-at-j |
                mod_n_poly.zcoeff(reduce(p), j) = mod_n.cls(icoeff(p, j))
                [using specialize reduceCoefficientwise(p, j)]
              @the-reduced-coefficient-at-zero |
                mod_n_poly.zcoeff(reduce(q), ZERO) = mod_n.cls(icoeff(q, ZERO))
                [using specialize reduceCoefficientwise(q, ZERO)]
              @the-product-of-classes |
                mod_n.mul(mod_n.cls(icoeff(p, j)), mod_n.cls(icoeff(q, ZERO))) =
                  mod_n.cls(integer.mul(icoeff(p, j), icoeff(q, ZERO)))
                [using specialize mod_n.mulHom(icoeff(p, j), icoeff(q, ZERO))]
              @conclusion-the-base-agrees |
                mod_n_poly.zconvolution(reduce(p), reduce(q), j, ZERO) =
                  mod_n.cls(iconvolution(p, q, j, ZERO))
                [using simplify the-reduced-convolution
                  the-reduced-coefficient-at-j
                  the-reduced-coefficient-at-zero
                  the-product-of-classes
                  the-integer-convolution]
            }
          @discharge-j |
            forall j: Nat;
              mod_n_poly.zconvolution(reduce(p), reduce(q), j, ZERO) =
              mod_n.cls(iconvolution(p, q, j, ZERO))
            [by generalize generalize-j]
        }
      @discharge-q |
        forall q: IntPoly; forall j: Nat;
          mod_n_poly.zconvolution(reduce(p), reduce(q), j, ZERO) =
          mod_n.cls(iconvolution(p, q, j, ZERO))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: IntPoly; forall j: Nat;
      mod_n_poly.zconvolution(reduce(p), reduce(q), j, ZERO) =
      mod_n.cls(iconvolution(p, q, j, ZERO))
    [by generalize generalize-p]
qed

// The step: each recursion peels its top term, the two peeled terms correspond by `mulHom`,
// the two tails by the hypothesis at base succ(j), and the two sums by `addHom`.
theorem theReductionStep: forall p, q: IntPoly; forall m: Nat;
  (forall j: Nat;
  mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
  mod_n.cls(iconvolution(p, q, j, m))) ->
  (forall j: Nat;
  mod_n_poly.zconvolution(reduce(p), reduce(q), j, peano.succ(m)) =
  mod_n.cls(iconvolution(p, q, j, peano.succ(m))))
proof
  @generalize-p |
    fix p: IntPoly {
      @generalize-q |
        fix q: IntPoly {
          @generalize-m |
            fix m: Nat {
              @given-inductive-hypothesis |
                assume forall j: Nat;
                  mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
                  mod_n.cls(iconvolution(p, q, j, m)) {
                  @inductive-hypothesis |
                    forall j: Nat;
                      mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
                      mod_n.cls(iconvolution(p, q, j, m))
                    [by hypothesis given-inductive-hypothesis]
                  @generalize-j |
                    fix j: Nat {
                      @the-reduced-convolution-peels |
                        mod_n_poly.zconvolution(reduce(p), reduce(q), j,
                          peano.succ(m)) =
                          mod_n.add(
                          mod_n.mul(mod_n_poly.zcoeff(reduce(p), j),
                          mod_n_poly.zcoeff(reduce(q), peano.succ(m))),
                          mod_n_poly.zconvolution(reduce(p), reduce(q),
                          peano.succ(j), m))
                        [using specialize
                          mod_n_poly.zConvolutionSucc(reduce(p), reduce(q), j, m)]
                      @the-integer-convolution-peels |
                        iconvolution(p, q, j, peano.succ(m)) =
                          integer.add(
                          integer.mul(icoeff(p, j), icoeff(q, peano.succ(m))),
                          iconvolution(p, q, peano.succ(j), m))
                        [using specialize iConvolutionSucc(p, q, j, m)]
                      @the-reduced-coefficient-at-j |
                        mod_n_poly.zcoeff(reduce(p), j) = mod_n.cls(icoeff(p, j))
                        [using specialize reduceCoefficientwise(p, j)]
                      @the-reduced-coefficient-at-the-top |
                        mod_n_poly.zcoeff(reduce(q), peano.succ(m)) =
                          mod_n.cls(icoeff(q, peano.succ(m)))
                        [using specialize reduceCoefficientwise(q, peano.succ(m))]
                      @the-peeled-product-of-classes |
                        mod_n.mul(mod_n.cls(icoeff(p, j)),
                          mod_n.cls(icoeff(q, peano.succ(m)))) =
                          mod_n.cls(integer.mul(icoeff(p, j),
                          icoeff(q, peano.succ(m))))
                        [using specialize mod_n.mulHom(icoeff(p, j),
                          icoeff(q, peano.succ(m)))]
                      @the-tails-agree |
                        mod_n_poly.zconvolution(reduce(p), reduce(q),
                          peano.succ(j), m) =
                          mod_n.cls(iconvolution(p, q, peano.succ(j), m))
                        [using specialize inductive-hypothesis(peano.succ(j))]
                      @the-sum-of-classes |
                        mod_n.add(
                          mod_n.cls(integer.mul(icoeff(p, j),
                          icoeff(q, peano.succ(m)))),
                          mod_n.cls(iconvolution(p, q, peano.succ(j), m))) =
                          mod_n.cls(integer.add(
                          integer.mul(icoeff(p, j), icoeff(q, peano.succ(m))),
                          iconvolution(p, q, peano.succ(j), m)))
                        [using specialize mod_n.addHom(
                          integer.mul(icoeff(p, j), icoeff(q, peano.succ(m))),
                          iconvolution(p, q, peano.succ(j), m))]
                      @conclusion-the-step-agrees |
                        mod_n_poly.zconvolution(reduce(p), reduce(q), j,
                          peano.succ(m)) =
                          mod_n.cls(iconvolution(p, q, j, peano.succ(m)))
                        [using simplify the-reduced-convolution-peels
                          the-reduced-coefficient-at-j
                          the-reduced-coefficient-at-the-top
                          the-peeled-product-of-classes
                          the-tails-agree
                          the-sum-of-classes
                          the-integer-convolution-peels]
                    }
                  @all-bases |
                    forall j: Nat;
                      mod_n_poly.zconvolution(reduce(p), reduce(q), j,
                      peano.succ(m)) =
                      mod_n.cls(iconvolution(p, q, j, peano.succ(m)))
                    [by generalize generalize-j]
                }
              @the-hypothesis-gives-it |
                (forall j: Nat;
                  mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
                  mod_n.cls(iconvolution(p, q, j, m))) ->
                  (forall j: Nat;
                  mod_n_poly.zconvolution(reduce(p), reduce(q), j,
                  peano.succ(m)) =
                  mod_n.cls(iconvolution(p, q, j, peano.succ(m))))
                [by discharge given-inductive-hypothesis]
            }
          @discharge-m |
            forall m: Nat;
              (forall j: Nat;
              mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
              mod_n.cls(iconvolution(p, q, j, m))) ->
              (forall j: Nat;
              mod_n_poly.zconvolution(reduce(p), reduce(q), j,
              peano.succ(m)) =
              mod_n.cls(iconvolution(p, q, j, peano.succ(m))))
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: IntPoly; forall m: Nat;
          (forall j: Nat;
          mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
          mod_n.cls(iconvolution(p, q, j, m))) ->
          (forall j: Nat;
          mod_n_poly.zconvolution(reduce(p), reduce(q), j, peano.succ(m)) =
          mod_n.cls(iconvolution(p, q, j, peano.succ(m))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: IntPoly; forall m: Nat;
      (forall j: Nat;
      mod_n_poly.zconvolution(reduce(p), reduce(q), j, m) =
      mod_n.cls(iconvolution(p, q, j, m))) ->
      (forall j: Nat;
      mod_n_poly.zconvolution(reduce(p), reduce(q), j, peano.succ(m)) =
      mod_n.cls(iconvolution(p, q, j, peano.succ(m))))
    [by generalize generalize-p]
qed

// reduce(p·q) = reduce(p)·reduce(q): the convolution result read off through `mulPolyCoeff`
// on both sides, then extensionality. This is the step Judson's α₁'·β₁' silently assumes.
theorem reduceIsMultiplicative: forall p, q: IntPoly;
  mod_n_poly.zmulP(reduce(p), reduce(q)) = reduce(imulP(p, q))
proof
  @generalize-p |
    fix p: IntPoly {
      @generalize-q |
        fix q: IntPoly {
          @the-coefficients-agree |
            fix i: Nat {
              @the-reduced-product-coefficient |
                mod_n_poly.zcoeff(mod_n_poly.zmulP(reduce(p), reduce(q)), i) =
                  mod_n_poly.zconvolution(reduce(p), reduce(q), ZERO, i)
                [using specialize mod_n_poly.zMulPolyCoeff(reduce(p), reduce(q), i)]
              @the-convolutions-agree |
                mod_n_poly.zconvolution(reduce(p), reduce(q), ZERO, i) =
                  mod_n.cls(iconvolution(p, q, ZERO, i))
                [using specialize reduceCommutesWithTheConvolution(p, q, i, ZERO)]
              @the-integer-product-coefficient |
                icoeff(imulP(p, q), i) = iconvolution(p, q, ZERO, i)
                [using specialize iMulPolyCoeff(p, q, i)]
              @the-reduction-of-the-product |
                mod_n_poly.zcoeff(reduce(imulP(p, q)), i) =
                  mod_n.cls(icoeff(imulP(p, q), i))
                [using specialize reduceCoefficientwise(imulP(p, q), i)]
              @conclusion-this-coefficient-agrees |
                mod_n_poly.zcoeff(mod_n_poly.zmulP(reduce(p), reduce(q)), i) =
                  mod_n_poly.zcoeff(reduce(imulP(p, q)), i)
                [using simplify the-reduced-product-coefficient
                  the-convolutions-agree
                  the-reduction-of-the-product
                  the-integer-product-coefficient]
            }
          @discharge-i |
            forall i9: Nat;
              mod_n_poly.zcoeff(mod_n_poly.zmulP(reduce(p), reduce(q)), i9) =
              mod_n_poly.zcoeff(reduce(imulP(p, q)), i9)
            [by generalize the-coefficients-agree]
          @conclusion-the-products-agree |
            mod_n_poly.zmulP(reduce(p), reduce(q)) = reduce(imulP(p, q))
            [using specialize mod_n_poly.zPolyExtensionality(mod_n_poly.zmulP(reduce(p), reduce(q)), reduce(imulP(p, q))) discharge-i]
        }
      @discharge-q |
        forall q9: IntPoly;
          mod_n_poly.zmulP(reduce(p), reduce(q9)) = reduce(imulP(p, q9))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: IntPoly;
      mod_n_poly.zmulP(reduce(p), reduce(q)) = reduce(imulP(p, q))
    [by generalize generalize-p]
qed

// A polynomial all of whose coefficients the modulus divides reduces to the zero polynomial.
// This is Judson's "since p | d, α₁'(x) β₁'(x) = 0 in ℤ_p[x]": every coefficient of
// d·p(x) = c α₁(x) β₁(x) carries the factor d, so each one dies under reduction.
theorem aPolynomialTheModulusDividesReducesToZero: forall f: IntPoly;
  (forall i: Nat; divides(N, icoeff(f, i))) -> reduce(f) = mod_n_poly.ZZEROP
proof
  @generalize-f |
    fix f: IntPoly {
      @given-the-modulus-divides-every-coefficient |
        assume forall i: Nat; divides(N, icoeff(f, i)) {
          @the-modulus-divides-every-coefficient |
            forall i: Nat; divides(N, icoeff(f, i))
            [by hypothesis given-the-modulus-divides-every-coefficient]
          @every-reduced-coefficient-vanishes |
            fix i: Nat {
              @the-modulus-divides-this-coefficient |
                divides(N, icoeff(f, i))
                [using specialize the-modulus-divides-every-coefficient(i)]
              @vanishing-means-divisible |
                mod_n.cls(icoeff(f, i)) = mod_n.ZERO iff divides(N, icoeff(f, i))
                [using specialize mod_n_domain.aClassIsZeroWhenTheModulusDivides(icoeff(f, i))]
              @the-class-vanishes |
                mod_n.cls(icoeff(f, i)) = mod_n.ZERO
                [using tautology vanishing-means-divisible the-modulus-divides-this-coefficient]
              @the-reduced-coefficient |
                mod_n_poly.zcoeff(reduce(f), i) = mod_n.cls(icoeff(f, i))
                [using specialize reduceCoefficientwise(f, i)]
              @the-zero-polynomials-coefficient |
                mod_n_poly.zcoeff(mod_n_poly.ZZEROP, i) = mod_n.ZERO
                [using specialize mod_n_poly.zZeroPolyCoeff(i)]
              @conclusion-this-coefficient-agrees |
                mod_n_poly.zcoeff(reduce(f), i) =
                  mod_n_poly.zcoeff(mod_n_poly.ZZEROP, i)
                [using simplify the-reduced-coefficient the-class-vanishes
                  the-zero-polynomials-coefficient]
            }
          @discharge-i |
            forall i9: Nat;
              mod_n_poly.zcoeff(reduce(f), i9) =
              mod_n_poly.zcoeff(mod_n_poly.ZZEROP, i9)
            [by generalize every-reduced-coefficient-vanishes]
          @conclusion-the-reduction-is-zero |
            reduce(f) = mod_n_poly.ZZEROP
            [using specialize mod_n_poly.zPolyExtensionality(reduce(f), mod_n_poly.ZZEROP) discharge-i]
        }
      @divisible-implies-reduces-to-zero |
        (forall i: Nat; divides(N, icoeff(f, i))) -> reduce(f) = mod_n_poly.ZZEROP
        [by discharge given-the-modulus-divides-every-coefficient]
    }
  @conclusion |
    forall f: IntPoly;
      (forall i: Nat; divides(N, icoeff(f, i))) -> reduce(f) = mod_n_poly.ZZEROP
    [by generalize generalize-f]
qed

// -- GAUSS'S LEMMA: the d ≠ 1 case is impossible -------------------------------------------
// Judson's closing paragraph, which is the whole substance of the lemma. Suppose the
// denominator does not come out to 1. Then some prime N divides it, and because α₁'s
// coefficients are relatively prime (and likewise β₁'s) there is a coefficient of each that
// N misses. Reduce both modulo N: the product α₁'β₁' is zero, because N divides every
// coefficient of α₁β₁ (that is what N | d buys). But ℤ_N[x] is an integral domain and
// neither factor reduced to zero. Contradiction — so d = 1.
//
// The hypotheses are exactly Judson's three: N is prime, N misses a coefficient of each
// factor, and N divides every coefficient of the product. The conclusion is the absurdity.
theorem theDenominatorCannotExceedOne: forall f, g: IntPoly; forall i, j: Nat;
  is_prime(N) ->
  (not divides(N, icoeff(f, i))) ->
  (not divides(N, icoeff(g, j))) ->
  (not (forall t: Nat; divides(N, icoeff(imulP(f, g), t))))
proof
  @generalize-f |
    fix f: IntPoly {
      @generalize-g |
        fix g: IntPoly {
          @generalize-i |
            fix i: Nat {
              @generalize-j |
                fix j: Nat {
                  @given-the-modulus-is-prime |
                    assume is_prime(N) {
                      @the-modulus-is-prime |
                        is_prime(N)
                        [by hypothesis given-the-modulus-is-prime]
                      @given-the-modulus-misses-f |
                        assume not divides(N, icoeff(f, i)) {
                          @the-modulus-misses-f |
                            not divides(N, icoeff(f, i))
                            [by hypothesis given-the-modulus-misses-f]
                          @given-the-modulus-misses-g |
                            assume not divides(N, icoeff(g, j)) {
                              @the-modulus-misses-g |
                                not divides(N, icoeff(g, j))
                                [by hypothesis given-the-modulus-misses-g]
                              // each factor survives reduction
                              @the-reduction-of-f-is-nonzero |
                                not (reduce(f) = mod_n_poly.ZZEROP)
                                [using specialize aSurvivingCoefficientSurvivesReduction(f, i) the-modulus-misses-f]
                              @the-reduction-of-g-is-nonzero |
                                not (reduce(g) = mod_n_poly.ZZEROP)
                                [using specialize aSurvivingCoefficientSurvivesReduction(g, j) the-modulus-misses-g]
                              // so, ℤ_N[x] being a domain, their product does too
                              @the-product-of-the-reductions-is-nonzero |
                                not (mod_n_poly.zmulP(reduce(f), reduce(g)) = mod_n_poly.ZZEROP)
                                [using specialize mod_n_poly.modNPolynomialsHaveNoZeroDivisors(reduce(f), reduce(g)) the-modulus-is-prime the-reduction-of-f-is-nonzero the-reduction-of-g-is-nonzero]
                              @the-reductions-multiply |
                                mod_n_poly.zmulP(reduce(f), reduce(g)) = reduce(imulP(f, g))
                                [using specialize reduceIsMultiplicative(f, g)]
                              @the-reduction-of-the-product-is-nonzero |
                                not (reduce(imulP(f, g)) = mod_n_poly.ZZEROP)
                                [by rewrite the-reductions-multiply the-product-of-the-reductions-is-nonzero]
                              // but if the modulus divided every coefficient of the product
                              // it WOULD have reduced to zero
                              @given-the-modulus-divides-the-product |
                                assume forall t: Nat; divides(N, icoeff(imulP(f, g), t)) {
                                  @the-modulus-divides-the-product |
                                    forall t: Nat; divides(N, icoeff(imulP(f, g), t))
                                    [by hypothesis given-the-modulus-divides-the-product]
                                  @conclusion-the-reduction-of-the-product-is-zero |
                                    reduce(imulP(f, g)) = mod_n_poly.ZZEROP
                                    [using specialize aPolynomialTheModulusDividesReducesToZero(imulP(f, g)) the-modulus-divides-the-product]
                                }
                              @divides-the-product-implies-it-reduces-to-zero |
                                (forall t: Nat; divides(N, icoeff(imulP(f, g), t))) ->
                                  reduce(imulP(f, g)) = mod_n_poly.ZZEROP
                                [by discharge given-the-modulus-divides-the-product]
                              @conclusion-the-modulus-misses-the-product |
                                not (forall t: Nat; divides(N, icoeff(imulP(f, g), t)))
                                [using tautology divides-the-product-implies-it-reduces-to-zero the-reduction-of-the-product-is-nonzero]
                            }
                          @misses-g-implies-misses-the-product |
                            (not divides(N, icoeff(g, j))) ->
                              (not (forall t: Nat; divides(N, icoeff(imulP(f, g), t))))
                            [by discharge given-the-modulus-misses-g]
                        }
                      @misses-f-implies-misses-the-product |
                        (not divides(N, icoeff(f, i))) ->
                          (not divides(N, icoeff(g, j))) ->
                          (not (forall t: Nat; divides(N, icoeff(imulP(f, g), t))))
                        [by discharge given-the-modulus-misses-f]
                    }
                  @prime-implies-misses-the-product |
                    is_prime(N) ->
                      (not divides(N, icoeff(f, i))) ->
                      (not divides(N, icoeff(g, j))) ->
                      (not (forall t: Nat; divides(N, icoeff(imulP(f, g), t))))
                    [by discharge given-the-modulus-is-prime]
                }
              @discharge-j |
                forall j9: Nat;
                  is_prime(N) ->
                  (not divides(N, icoeff(f, i))) ->
                  (not divides(N, icoeff(g, j9))) ->
                  (not (forall t: Nat; divides(N, icoeff(imulP(f, g), t))))
                [by generalize generalize-j]
            }
          @discharge-i |
            forall i9: Nat; forall j: Nat;
              is_prime(N) ->
              (not divides(N, icoeff(f, i9))) ->
              (not divides(N, icoeff(g, j))) ->
              (not (forall t: Nat; divides(N, icoeff(imulP(f, g), t))))
            [by generalize generalize-i]
        }
      @discharge-g |
        forall g9: IntPoly; forall i, j: Nat;
          is_prime(N) ->
          (not divides(N, icoeff(f, i))) ->
          (not divides(N, icoeff(g9, j))) ->
          (not (forall t: Nat; divides(N, icoeff(imulP(f, g9), t))))
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g: IntPoly; forall i, j: Nat;
      is_prime(N) ->
      (not divides(N, icoeff(f, i))) ->
      (not divides(N, icoeff(g, j))) ->
      (not (forall t: Nat; divides(N, icoeff(imulP(f, g), t))))
    [by generalize generalize-f]
qed

// -- EISENSTEIN'S CRITERION, THE CORE STEP -------------------------------------------------
// AATA Theorem 17.15. Judson: "If p | a_i for i = 0, …, n-1, but p ∤ a_n and p² ∤ a_0, then
// f(x) is irreducible over ℚ."
//
// Gauss's Lemma reduces irreducibility over ℚ to irreducibility over ℤ, so what has to be
// ruled out is `f = g·h` in ℤ[x] with both factors of degree below n. This is where
// Eisenstein's hypotheses bite, and the shape is the MINIMAL-INDEX argument:
//
//   p | a_0 = b_0·c_0 but p² ∤ a_0, so p divides EXACTLY ONE of b_0, c_0. Say p | b_0 and
//   p ∤ c_0 (the other case is symmetric, taken by swapping the factors — `imulP` is
//   commutative, so the swap is free).
//
//   p ∤ a_n = b_m·c_k, so p misses the leading coefficient of each factor; in particular
//   p ∤ b_m. So p misses a coefficient of g (at m) and of h (at 0).
//
//   `theDenominatorCannotExceedOne` then says p cannot divide EVERY coefficient of g·h = f.
//   But p divides a_0 … a_{n-1} by hypothesis, so the coefficient p misses is at index n or
//   above — and above the degree sum every coefficient vanishes, which p divides. Since both
//   factors have degree below n, their degree sum is below n too. Contradiction.
//
// What is stated here is that core step. The reduction FROM irreducibility over ℚ is Gauss's
// Lemma, already proved (`std/rational/gauss.b4m`).
//
// This wrapper restates `theIntegerProductVanishesAboveTheDegreeSum` with the degree bounds
// pulled OUT of the index quantifier, which is the order the Eisenstein proof reads: it fixes
// the two factors once, then walks every index above the sum. The name still says
// "convolution" for continuity with the citing proof, but both now conclude about the
// COEFFICIENT — reindexing removed the convolution's own appearance here.
theorem theConvolutionVanishesAboveTheSum: forall p, q: IntPoly;
  forall m, n: Nat;
  idegreeAtMost(p, m) -> idegreeAtMost(q, n) ->
  (forall i: Nat;
  peano.less_than(add(m, n), i) -> icoeff(imulP(p, q), i) = INT_ZERO)
proof
  @generalize-p |
    fix p: IntPoly {
      @generalize-q |
        fix q: IntPoly {
          @generalize-m |
            fix m: Nat {
              @generalize-n |
                fix n: Nat {
                  @given-p-bounded |
                    assume idegreeAtMost(p, m) {
                      @p-is-bounded |
                        idegreeAtMost(p, m)
                        [by hypothesis given-p-bounded]
                      @given-q-bounded |
                        assume idegreeAtMost(q, n) {
                          @q-is-bounded |
                            idegreeAtMost(q, n)
                            [by hypothesis given-q-bounded]
                          @each-index |
                            fix i: Nat {
                              @given-above |
                                assume peano.less_than(add(m, n), i) {
                                  @above |
                                    peano.less_than(add(m, n), i)
                                    [by hypothesis given-above]
                                  @conclusion-vanishes |
                                    icoeff(imulP(p, q), i) = INT_ZERO
                                    [using specialize
                                      theIntegerProductVanishesAboveTheDegreeSum(
                                      p, q, m, n, i)
                                      p-is-bounded q-is-bounded above]
                                }
                              @above-implies |
                                peano.less_than(add(m, n), i) ->
                                  icoeff(imulP(p, q), i) = INT_ZERO
                                [by discharge given-above]
                            }
                          @all-indices |
                            forall i: Nat;
                              peano.less_than(add(m, n), i) ->
                              icoeff(imulP(p, q), i) = INT_ZERO
                            [by generalize each-index]
                        }
                      @q-bounded-gives-it |
                        idegreeAtMost(q, n) ->
                          (forall i: Nat;
                          peano.less_than(add(m, n), i) ->
                          icoeff(imulP(p, q), i) = INT_ZERO)
                        [by discharge given-q-bounded]
                    }
                  @p-bounded-gives-it |
                    idegreeAtMost(p, m) -> idegreeAtMost(q, n) ->
                      (forall i: Nat;
                      peano.less_than(add(m, n), i) ->
                      icoeff(imulP(p, q), i) = INT_ZERO)
                    [by discharge given-p-bounded]
                }
              @discharge-n |
                forall n: Nat;
                  idegreeAtMost(p, m) -> idegreeAtMost(q, n) ->
                  (forall i: Nat;
                  peano.less_than(add(m, n), i) ->
                  icoeff(imulP(p, q), i) = INT_ZERO)
                [by generalize generalize-n]
            }
          @discharge-m |
            forall m, n: Nat;
              idegreeAtMost(p, m) -> idegreeAtMost(q, n) ->
              (forall i: Nat;
              peano.less_than(add(m, n), i) ->
              icoeff(imulP(p, q), i) = INT_ZERO)
            [by generalize generalize-m]
        }
      @discharge-q |
        forall q: IntPoly; forall m, n: Nat;
          idegreeAtMost(p, m) -> idegreeAtMost(q, n) ->
          (forall i: Nat;
          peano.less_than(add(m, n), i) ->
          icoeff(imulP(p, q), i) = INT_ZERO)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: IntPoly; forall m, n: Nat;
      idegreeAtMost(p, m) -> idegreeAtMost(q, n) ->
      (forall i: Nat;
      peano.less_than(add(m, n), i) -> icoeff(imulP(p, q), i) = INT_ZERO)
    [by generalize generalize-p]
qed

// Moved to `std/peano/order.b4m` — it is a pure `Nat` order fact with nothing polynomial in
// it, and the ℚ[x] Eisenstein argument needs the same lemma.
fact theBoundIsBelowAnythingNotBelowIt = peano_order.theBoundIsBelowAnythingNotBelowIt

// Stated as the positive fact rather than an absurdity: under Eisenstein's divisibility
// hypotheses, the two factors' degree bound CANNOT stay below n. That is the form Gauss's
// reduction consumes, and it avoids an `ONE = ONE`-style fake conclusion.
theorem eisensteinForcesTheFullDegree: forall f, g, h: IntPoly;
  forall n, m, k: Nat;
  is_prime(N) ->
  f = imulP(g, h) ->
  idegreeAtMost(g, m) -> idegreeAtMost(h, k) ->
  (forall i: Nat; peano.less_than(i, n) -> divides(N, icoeff(f, i))) ->
  (not divides(N, icoeff(g, m))) ->
  (not divides(N, icoeff(h, ZERO))) ->
  (not peano.less_than(add(m, k), n))
proof
  @generalize-f |
    fix f: IntPoly {
      @generalize-g |
        fix g: IntPoly {
          @generalize-h |
            fix h: IntPoly {
              @generalize-n |
                fix n: Nat {
                  @generalize-m |
                    fix m: Nat {
                      @generalize-k |
                        fix k: Nat {
                          @given-the-setup |
                            assume is_prime(N) and
                              f = imulP(g, h) and
                              idegreeAtMost(g, m) and
                              idegreeAtMost(h, k) and
                              (forall i: Nat; peano.less_than(i, n) ->
                              divides(N, icoeff(f, i))) and
                              (not divides(N, icoeff(g, m))) and
                              (not divides(N,
                              icoeff(h, ZERO))) {
                              @the-setup |
                                is_prime(N) and
                                  f = imulP(g, h) and
                                  idegreeAtMost(g, m) and
                                  idegreeAtMost(h, k) and
                                  (forall i: Nat;
                                  peano.less_than(i, n) ->
                                  divides(N, icoeff(f, i))) and
                                  (not divides(N,
                                  icoeff(g, m))) and
                                  (not divides(N,
                                  icoeff(h, ZERO)))
                                [by hypothesis given-the-setup]
                              @the-modulus-is-prime |
                                is_prime(N)
                                [using tautology the-setup]
                              @f-factors |
                                f = imulP(g, h)
                                [using tautology the-setup]
                              @g-is-bounded |
                                idegreeAtMost(g, m)
                                [using tautology the-setup]
                              @h-is-bounded |
                                idegreeAtMost(h, k)
                                [using tautology the-setup]
                              @the-low-coefficients-are-divisible |
                                forall i: Nat; peano.less_than(i, n) ->
                                  divides(N, icoeff(f, i))
                                [using tautology the-setup]
                              @the-modulus-misses-g |
                                not divides(N, icoeff(g, m))
                                [using tautology the-setup]
                              @the-modulus-misses-h |
                                not divides(N, icoeff(h, ZERO))
                                [using tautology the-setup]
                              // N misses a coefficient of the PRODUCT
                              @the-product-is-not-all-divisible |
                                not (forall t: Nat;
                                  divides(N,
                                  icoeff(imulP(g, h), t)))
                                [using specialize theDenominatorCannotExceedOne(g, h, m, ZERO) the-modulus-is-prime the-modulus-misses-g the-modulus-misses-h]
                              @f-is-not-all-divisible |
                                not (forall t: Nat;
                                  divides(N, icoeff(f, t)))
                                [by rewrite f-factors the-product-is-not-all-divisible]
                              // suppose the degree sum stayed below n
                              @given-the-sum-is-below |
                                assume peano.less_than(add(m, k), n) {
                                  @the-sum-is-below |
                                    peano.less_than(add(m, k), n)
                                    [by hypothesis given-the-sum-is-below]
                                  // then EVERY coefficient of f is divisible:
                                  // below n by hypothesis, above the degree sum
                                  // because it vanishes: the reindexed theorem
                                  // concludes about the COEFFICIENT directly
                                  @the-coefficients-vanish-above |
                                    forall t: Nat;
                                      peano.less_than(add(m, k), t) ->
                                      icoeff(imulP(g, h), t) = INT_ZERO
                                    [using specialize theConvolutionVanishesAboveTheSum(g, h, m, k) g-is-bounded h-is-bounded]
                                  @each-index |
                                    fix t: Nat {
                                      @the-position-split |
                                        peano.less_than(t, n) or
                                          (not peano.less_than(t, n))
                                        [using tautology]
                                      @conclusion-divisible-at-t |
                                        divides(N, icoeff(f, t))
                                        case the-position-split {
                                          // below n: the hypothesis
                                          @when-below |
                                            assume peano.less_than(t, n) {
                                              @t-below-n |
                                                peano.less_than(t, n)
                                                [by hypothesis when-below]
                                              @conclusion-below |
                                                divides(N,
                                                  icoeff(f, t))
                                                [using specialize the-low-coefficients-are-divisible(t) t-below-n]
                                            }
                                          // not below n: then it is above the
                                          // degree sum, so it vanishes
                                          @when-not-below |
                                            assume not peano.less_than(t, n) {
                                              @t-not-below-n |
                                                not peano.less_than(t, n)
                                                [by hypothesis when-not-below]
                                              @the-sum-is-below-t |
                                                peano.less_than(add(m, k), t)
                                                [using specialize theBoundIsBelowAnythingNotBelowIt(add(m, k), n, t) the-sum-is-below t-not-below-n]
                                              @the-product-vanishes-at-t |
                                                icoeff(imulP(g, h), t) =
                                                  INT_ZERO
                                                [using specialize the-coefficients-vanish-above(t) the-sum-is-below-t]
                                              @f-vanishes-at-t |
                                                icoeff(f, t) =
                                                  INT_ZERO
                                                [by rewrite f-factors the-product-vanishes-at-t]
                                              @the-modulus-divides-zero |
                                                divides(N, INT_ZERO)
                                                [using specialize int_divides.dividesZero(N)]
                                              @conclusion-not-below |
                                                divides(N,
                                                  icoeff(f, t))
                                                [by rewrite f-vanishes-at-t the-modulus-divides-zero]
                                            }
                                        }
                                    }
                                  @all-coefficients-divisible |
                                    forall t: Nat;
                                      divides(N, icoeff(f, t))
                                    [by generalize each-index]
                                }
                              @conclusion-the-degree-is-forced |
                                not peano.less_than(add(m, k), n)
                                [by contradiction given-the-sum-is-below all-coefficients-divisible f-is-not-all-divisible]
                            }
                          @the-implication |
                            (is_prime(N) and f = imulP(g, h) and
                              idegreeAtMost(g, m) and
                              idegreeAtMost(h, k) and
                              (forall i: Nat; peano.less_than(i, n) ->
                              divides(N, icoeff(f, i))) and
                              (not divides(N, icoeff(g, m))) and
                              (not divides(N,
                              icoeff(h, ZERO)))) ->
                              (not peano.less_than(add(m, k), n))
                            [by discharge given-the-setup]
                          @curried |
                            is_prime(N) -> f = imulP(g, h) ->
                              idegreeAtMost(g, m) ->
                              idegreeAtMost(h, k) ->
                              (forall i: Nat; peano.less_than(i, n) ->
                              divides(N, icoeff(f, i))) ->
                              (not divides(N, icoeff(g, m))) ->
                              (not divides(N, icoeff(h, ZERO))) ->
                              (not peano.less_than(add(m, k), n))
                            [using tautology the-implication]
                        }
                      @discharge-k |
                        forall k9: Nat;
                          is_prime(N) -> f = imulP(g, h) ->
                          idegreeAtMost(g, m) ->
                          idegreeAtMost(h, k9) ->
                          (forall i: Nat; peano.less_than(i, n) ->
                          divides(N, icoeff(f, i))) ->
                          (not divides(N, icoeff(g, m))) ->
                          (not divides(N, icoeff(h, ZERO))) ->
                          (not peano.less_than(add(m, k9), n))
                        [by generalize generalize-k]
                    }
                  @discharge-m |
                    forall m9, k9: Nat;
                      is_prime(N) -> f = imulP(g, h) ->
                      idegreeAtMost(g, m9) ->
                      idegreeAtMost(h, k9) ->
                      (forall i: Nat; peano.less_than(i, n) ->
                      divides(N, icoeff(f, i))) ->
                      (not divides(N, icoeff(g, m9))) ->
                      (not divides(N, icoeff(h, ZERO))) ->
                      (not peano.less_than(add(m9, k9), n))
                    [by generalize generalize-m]
                }
              @discharge-n |
                forall n9: Nat; forall m9, k9: Nat;
                  is_prime(N) -> f = imulP(g, h) ->
                  idegreeAtMost(g, m9) ->
                  idegreeAtMost(h, k9) ->
                  (forall i: Nat; peano.less_than(i, n9) ->
                  divides(N, icoeff(f, i))) ->
                  (not divides(N, icoeff(g, m9))) ->
                  (not divides(N, icoeff(h, ZERO))) ->
                  (not peano.less_than(add(m9, k9), n9))
                [by generalize generalize-n]
            }
          @discharge-h |
            forall h9: IntPoly; forall n9, m9, k9: Nat;
              is_prime(N) -> f = imulP(g, h9) ->
              idegreeAtMost(g, m9) -> idegreeAtMost(h9, k9) ->
              (forall i: Nat; peano.less_than(i, n9) ->
              divides(N, icoeff(f, i))) ->
              (not divides(N, icoeff(g, m9))) ->
              (not divides(N, icoeff(h9, ZERO))) ->
              (not peano.less_than(add(m9, k9), n9))
            [by generalize generalize-h]
        }
      @discharge-g |
        forall g9, h9: IntPoly; forall n9, m9, k9: Nat;
          is_prime(N) -> f = imulP(g9, h9) ->
          idegreeAtMost(g9, m9) -> idegreeAtMost(h9, k9) ->
          (forall i: Nat; peano.less_than(i, n9) ->
          divides(N, icoeff(f, i))) ->
          (not divides(N, icoeff(g9, m9))) ->
          (not divides(N, icoeff(h9, ZERO))) ->
          (not peano.less_than(add(m9, k9), n9))
        [by generalize generalize-g]
    }
  @conclusion |
    forall f, g, h: IntPoly; forall n, m, k: Nat;
      is_prime(N) -> f = imulP(g, h) ->
      idegreeAtMost(g, m) -> idegreeAtMost(h, k) ->
      (forall i: Nat; peano.less_than(i, n) -> divides(N, icoeff(f, i))) ->
      (not divides(N, icoeff(g, m))) ->
      (not divides(N, icoeff(h, ZERO))) ->
      (not peano.less_than(add(m, k), n))
    [by generalize generalize-f]
qed

// -- definition-clause shims ---------------------------------------------------------------
//
// The symbols above are DEFINITION BLOCKS, so `--axioms` reports their clauses as
// definitions rather than as assumptions to weigh. A clause has no user-facing name,
// though, and a model's `<-` and `specialize` both resolve BY NAME — so each clause keeps a
// one-line theorem under the name it had as an axiom. These add no assumption: every one is
// proved `[by definition(N) <symbol>]`.

theorem iAddPolyCoeff:
  forall p, q: IntPoly; forall i: Nat;
  icoeff(iaddP(p, q), i) = integer.add(icoeff(p, i), icoeff(q, i))
proof
  @conclusion |
    forall p, q: IntPoly; forall i: Nat;
      icoeff(iaddP(p, q), i) = integer.add(icoeff(p, i), icoeff(q, i))
    [by definition iaddP]
qed

theorem iNegPolyCoeff:
  forall p: IntPoly; forall i: Nat;
  icoeff(inegP(p), i) = integer.neg(icoeff(p, i))
proof
  @conclusion |
    forall p: IntPoly; forall i: Nat;
      icoeff(inegP(p), i) = integer.neg(icoeff(p, i))
    [by definition inegP]
qed

theorem iMulPolyCoeff:
  forall p, q: IntPoly; forall i: Nat;
  icoeff(imulP(p, q), i) = iconvolution(p, q, ZERO, i)
proof
  @conclusion |
    forall p, q: IntPoly; forall i: Nat;
      icoeff(imulP(p, q), i) = iconvolution(p, q, ZERO, i)
    [by definition imulP]
qed

theorem iConvolutionZero:
  forall p, q: IntPoly; forall j: Nat;
  iconvolution(p, q, j, ZERO) =
  integer.mul(icoeff(p, j), icoeff(q, ZERO))
proof
  @conclusion |
    forall p, q: IntPoly; forall j: Nat;
      iconvolution(p, q, j, ZERO) =
      integer.mul(icoeff(p, j), icoeff(q, ZERO))
    [by definition(0) iconvolution]
qed

theorem iConvolutionSucc:
  forall p, q: IntPoly; forall j, m: Nat;
  iconvolution(p, q, j, peano.succ(m)) =
  integer.add(integer.mul(icoeff(p, j), icoeff(q, peano.succ(m))),
  iconvolution(p, q, peano.succ(j), m))
proof
  @conclusion |
    forall p, q: IntPoly; forall j, m: Nat;
      iconvolution(p, q, j, peano.succ(m)) =
      integer.add(integer.mul(icoeff(p, j), icoeff(q, peano.succ(m))),
      iconvolution(p, q, peano.succ(j), m))
    [by definition(1) iconvolution]
qed

theorem reduceCoefficientwise:
  forall p: IntPoly; forall i: Nat;
  mod_n_poly.zcoeff(reduce(p), i) = mod_n.cls(icoeff(p, i))
proof
  @conclusion |
    forall p: IntPoly; forall i: Nat;
      mod_n_poly.zcoeff(reduce(p), i) = mod_n.cls(icoeff(p, i))
    [by definition reduce]
qed
