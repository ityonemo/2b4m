// std/integer/sum.b4m — the finite SUM of an integer sequence (Σ), one of the two
// folds over std/sequence.b4m (the other, in std/integer/product.b4m, is the
// product). It MODELS the abstract fold with Value:Int, combine:add, IDENTITY:ZERO
// → sumUpTo(s, n) = at(s,0) + at(s,1) + … + at(s,n-1), the sum of the first n
// entries. The index domain is NonNegZ (the nonneg integers, a Peano image), so
// every index sits under an is_nonneg guard — the same nonneg-induction discipline
// the product uses.
//
// The sequence SORT comes from std/integer/sequence.b4m, shared with the product,
// so one sequence has both folds and both reach the entry-graph builders. (Before
// the split this file declared its own `Seq`, incompatible with the product's.)

import sequence <<< "std/sequence.b4m"
import seq <<< "std/integer/sequence.b4m"
import integer <<< "std/integer.b4m"
import order <<< "std/integer/order.b4m"
import wellordering <<< "std/integer/wellordering.b4m"

sort Int = integer.Int
const ZERO = integer.ZERO
const ONE = integer.ONE
func succ = integer.succ
func prev = integer.prev
func add = integer.add
func mul = integer.mul
func neg = integer.neg

sort NonNegZ = integer.NonNeg
pred is_nonneg = order.nonneg
axiom nonnegZero = order.nonnegZero
axiom nonnegSucc = order.nonnegSucc
axiom nonnegInduction = order.nonnegInduction

axiom mulZeroLeft = integer.mulZeroLeft
theorem mulZeroRight = order.mulZeroRight

// ring vocabulary the arithmetic/polynomial accelerants resolve for the Gauss
// algebra (distribution, commutativity, the numeral/prev/succ folds).
axiom prevSucc = integer.prevSucc
axiom oneIsSuccZero = integer.oneIsSuccZero
axiom addZeroLeft = integer.addZeroLeft
theorem addZeroRight = integer.addZeroRight
theorem addIsCommutative = integer.addIsCommutative
theorem addIsAssociative = integer.addIsAssociative
theorem mulOneRight = integer.mulOneRight
theorem mulAddDistribLeft = integer.mulAddDistribLeft
theorem mulAddDistribRight = integer.mulAddDistribRight
theorem mulIsCommutative = order.mulIsCommutative
theorem mulIsAssociative = integer.mulIsAssociative
axiom mulSuccLeft = integer.mulSuccLeft
theorem mulSuccRight = integer.mulSuccRight
theorem addLeftSwap = integer.addLeftSwap
theorem mulLeftSwap = integer.mulLeftSwap
theorem mulOneLeft = integer.mulOneLeft
theorem mulPrevRight = integer.mulPrevRight
// neg/sub folds so `polynomial` can expand and cancel the -k term.
theorem negAdd = integer.negAdd
theorem negNeg = integer.negNeg
theorem mulNegLeft = order.mulNegLeft
theorem mulNegRight = integer.mulNegRight
theorem addNegRight = integer.addNegRight
theorem addNegLeft = integer.addNegLeft
axiom definitionOfSubtraction = order.definitionOfSubtraction
axiom negZero = integer.negZero
axiom negSucc = integer.negSucc
axiom negPrev = integer.negPrev
theorem addSuccRight = integer.addSuccRight
axiom addSuccLeft = integer.addSuccLeft
theorem addPrevRight = integer.addPrevRight

// -- the finite sum (models sequence.b4m's fold with add/ZERO) --------------

sort Seq = seq.Seq
func at = seq.at
func sumUpTo(s: Seq, k: NonNegZ) => Int
axiom sumUpToZero: forall s: Seq; sumUpTo(s, ZERO) = ZERO
axiom sumUpToSucc: forall s: Seq; forall k: NonNegZ; sumUpTo(s, succ(k)) = add(sumUpTo(s, k), at(s, k))

model IntSum {
  sequence.Nat: NonNegZ
  sequence.ZERO: ZERO(nonnegZero)
  sequence.succ: succ -| nonnegSucc
  sequence.Value: Int
  sequence.Seq: Seq
  sequence.at: at
  sequence.IDENTITY: ZERO
  sequence.combine: add
  sequence.foldUpTo: sumUpTo
  sequence.foldZero <- sumUpToZero
  sequence.foldSucc <- sumUpToSucc
}

// nonneg(succ(ZERO)) as an in-scope fact for the length-one concrete index.
theorem nonnegSuccZero: is_nonneg(succ(ZERO))
proof
  @zero-nonneg |
    is_nonneg(ZERO)
    [by cite nonnegZero]
  @conclusion |
    is_nonneg(succ(ZERO))
    [using specialize nonnegSucc(ZERO) zero-nonneg]
qed

// the length-one sum combines the identity with the sole entry: sumUpTo(s, 1) =
// add(ZERO, at(s, 0)). Transferred from the abstract fold through IntSum.
theorem sumOneCombinesIdentity: forall s: Seq; sumUpTo(s, succ(ZERO)) = add(ZERO, at(s, ZERO))
proof
  // the concrete indices succ(ZERO) and ZERO are stated nonneg before the step that uses them.
  @zero-nonneg |
    is_nonneg(ZERO)
    [by cite nonnegZero]
  @succ-zero-nonneg |
    is_nonneg(succ(ZERO))
    [by cite nonnegSuccZero]
  @conclusion |
    forall s: Seq; sumUpTo(s, succ(ZERO)) = add(ZERO, at(s, ZERO))
    [using model(IntSum) sequence.foldOneCombinesIdentity]
qed

// numerals used as division-free multipliers (2, 4, 6). Spelled as succ-towers
// over ONE so `polynomial` folds them.
define TWO = succ(ONE)
define THREE = succ(succ(ONE))
define FOUR = succ(succ(succ(ONE)))
define SIX = succ(succ(succ(succ(succ(ONE)))))
func sub = integer.sub

// a fixed scalar for the arithmetic-progression sum (Ex 4).
const X: Int

// -- the identity sequence and the Gauss sum --------------------------------

// idSeq: the sequence whose i-th entry is i itself. Then sumUpTo(idSeq, n) is the
// running sum 0 + 1 + … + (n-1) = Σ_{i<n} i.
const idSeq: Seq
axiom idSeqEntry: forall i: NonNegZ; at(idSeq, i) = i

// Gauss (division-free): 2·Σ_{i<n} i = n·(n-1) = mul(n, prev(n)). Nonneg-induction
// on n with the guard folded into the predicate.
//   base n=0:  2·0 = 0 = 0·(0-1).
//   step:      2·Σ_{i<k+1} = 2·(Σ_{i<k} + k) = k(k-1) + 2k = k(k+1) = (k+1)·k,
//              and (k+1)-1 = k, so the RHS is (k+1)·((k+1)-1).  [using arithmetic]
theorem gaussSum: forall n: NonNegZ;
  is_nonneg(n) -> mul(succ(ONE), sumUpTo(idSeq, n)) = mul(n, prev(n))
proof
  @given-zero-nonneg |
    assume is_nonneg(ZERO) {
      @sum-at-zero-is-zero |
        sumUpTo(idSeq, ZERO) = ZERO
        [using specialize sumUpToZero(idSeq)]
      // 2·Σ_0 = 2·0 = 0, and 0·(0-1) = 0, so both sides are ZERO.
      @two-times-empty-sum |
        mul(succ(ONE), sumUpTo(idSeq, ZERO)) = ZERO
        [using simplify sum-at-zero-is-zero mulZeroRight]
      @zero-times-anything |
        mul(ZERO, prev(ZERO)) = ZERO
        [using specialize mulZeroLeft(prev(ZERO))]
      @gauss-at-zero |
        mul(succ(ONE), sumUpTo(idSeq, ZERO)) = mul(ZERO, prev(ZERO))
        [using chain two-times-empty-sum zero-times-anything]
    }
  @base-case |
    is_nonneg(ZERO) -> mul(succ(ONE), sumUpTo(idSeq, ZERO)) = mul(ZERO, prev(ZERO))
    [by implies_intro given-zero-nonneg]
  @induction-step |
    fix k: Int {
      @given-k-nonneg |
        assume is_nonneg(k) {
          @k-nonneg |
            is_nonneg(k)
            [by hypothesis given-k-nonneg]
          @given-inductive-hypothesis |
            assume is_nonneg(k) -> mul(succ(ONE), sumUpTo(idSeq, k)) = mul(k, prev(k)) {
              @guarded-inductive-hypothesis |
                is_nonneg(k) -> mul(succ(ONE), sumUpTo(idSeq, k)) = mul(k, prev(k))
                [by hypothesis given-inductive-hypothesis]
              @inductive-hypothesis |
                mul(succ(ONE), sumUpTo(idSeq, k)) = mul(k, prev(k))
                [using specialize guarded-inductive-hypothesis k-nonneg]
              @successor-nonneg |
                is_nonneg(succ(k))
                [using specialize nonnegSucc(k) k-nonneg]
              @sum-at-successor |
                sumUpTo(idSeq, succ(k)) = add(sumUpTo(idSeq, k), at(idSeq, k))
                [using specialize sumUpToSucc(idSeq, k) k-nonneg]
              @entry-at-k-is-k |
                at(idSeq, k) = k
                [using specialize idSeqEntry(k) k-nonneg]
              @sum-at-successor-adds-k |
                sumUpTo(idSeq, succ(k)) = add(sumUpTo(idSeq, k), k)
                [by rewrite entry-at-k-is-k sum-at-successor]
              // 2·Σ_{k+1} = 2·(Σ_k + k) = 2·Σ_k + 2k.  Expose the 2·Σ_k so the IH
              // can substitute k·(k-1) for it.
              @two-times-sum-successor |
                mul(succ(ONE), sumUpTo(idSeq, succ(k))) = add(mul(succ(ONE), sumUpTo(idSeq, k)), mul(succ(ONE), k))
                [using arithmetic sum-at-successor-adds-k]
              // substitute the IH 2·Σ_k = k·(k-1): now 2·Σ_{k+1} = k·(k-1) + 2·k.
              @two-times-sum-successor-with-ih |
                mul(succ(ONE), sumUpTo(idSeq, succ(k))) = add(mul(k, prev(k)), mul(succ(ONE), k))
                [by rewrite inductive-hypothesis two-times-sum-successor]
              // prev(k) = k-1, prev(succ(k)) = k. Package the ring identity
              // k·(k-1) + 2·k = (k+1)·k with prev normalized to a successor offset.
              @prev-of-successor-is-k |
                prev(succ(k)) = k
                [using specialize prevSucc(k)]
              // expand k·(k-1) = k·k + (-k) so the identity is pure add/mul/neg/succ.
              @k-times-prev-k |
                mul(k, prev(k)) = add(mul(k, k), neg(k))
                [using specialize mulPrevRight(k, k)]
              @ring-identity-expanded |
                add(add(mul(k, k), neg(k)), mul(succ(ONE), k)) = mul(succ(k), k)
                [using polynomial]
              // k·(k-1) + 2k = k² + k = (k+1)·k, folding the expanded prev term.
              @ring-identity |
                add(mul(k, prev(k)), mul(succ(ONE), k)) = mul(succ(k), k)
                [by rewrite k-times-prev-k ring-identity-expanded]
              @gauss-at-successor-in-k |
                mul(succ(ONE), sumUpTo(idSeq, succ(k))) = mul(succ(k), k)
                [using chain two-times-sum-successor-with-ih ring-identity]
              // wrap the body under is_nonneg(succ(k)) to match the predicate
              // shape P(succ k) = is_nonneg(succ k) -> body(succ k). The body is
              // already unconditional, so the guard is vacuously discharged.
              @given-successor-nonneg |
                assume is_nonneg(succ(k)) {
                  @gauss-at-successor |
                    mul(succ(ONE), sumUpTo(idSeq, succ(k))) = mul(succ(k), prev(succ(k)))
                    [by rewrite prev-of-successor-is-k gauss-at-successor-in-k]
                }
              @predicate-at-successor |
                is_nonneg(succ(k)) -> mul(succ(ONE), sumUpTo(idSeq, succ(k))) = mul(succ(k), prev(succ(k)))
                [by implies_intro given-successor-nonneg]
            }
          @inductive-hypothesis-implies-successor |
            (is_nonneg(k) -> mul(succ(ONE), sumUpTo(idSeq, k)) = mul(k, prev(k))) ->
              (is_nonneg(succ(k)) -> mul(succ(ONE), sumUpTo(idSeq, succ(k))) = mul(succ(k), prev(succ(k))))
            [by implies_intro given-inductive-hypothesis]
        }
      @discharge-successor |
        is_nonneg(k) ->
          ((is_nonneg(k) -> mul(succ(ONE), sumUpTo(idSeq, k)) = mul(k, prev(k))) ->
          (is_nonneg(succ(k)) -> mul(succ(ONE), sumUpTo(idSeq, succ(k))) = mul(succ(k), prev(succ(k)))))
        [by implies_intro given-k-nonneg]
    }
  @induction-step-for-all-k |
    forall k: Int;
      is_nonneg(k) ->
      (is_nonneg(k) -> mul(succ(ONE), sumUpTo(idSeq, k)) = mul(k, prev(k))) ->
      (is_nonneg(succ(k)) -> mul(succ(ONE), sumUpTo(idSeq, succ(k))) = mul(succ(k), prev(succ(k))))
    [by forall_intro induction-step]
  @conclusion |
    forall n: NonNegZ; is_nonneg(n) -> mul(succ(ONE), sumUpTo(idSeq, n)) = mul(n, prev(n))
    [using instantiation nonnegInduction((fun n: Int => is_nonneg(n) -> mul(succ(ONE), sumUpTo(idSeq, n)) = mul(n, prev(n)))) base-case induction-step-for-all-k]
qed

// -- sum of squares (AATA §2.1 Ex 1) ----------------------------------------
//
// idSqSeq: the sequence whose i-th entry is i². Σ_{i<n} i² = sumUpTo(idSqSeq, n).
const idSqSeq: Seq
axiom idSqSeqEntry: forall i: NonNegZ; at(idSqSeq, i) = mul(i, i)

// 6·Σ_{i<n} i² = (n-1)·n·(2n-1), the DIVISION-FREE form of Σ_{i=1}^{m} i² =
// m(m+1)(2m+1)/6 (reindexed to i<n). ℚ is NOT needed — multiplying through by 6
// keeps it in ℤ; only the fractional NOTATION would need ℚ. Nonneg-induction on n;
// the cubic ring step closes by `polynomial` (with prev written as sub so the
// factors expand).
theorem sumOfSquares: forall n: NonNegZ;
  is_nonneg(n) -> mul(SIX, sumUpTo(idSqSeq, n)) = mul(sub(n, ONE), mul(n, sub(mul(TWO, n), ONE)))
proof
  @given-zero-nonneg |
    assume is_nonneg(ZERO) {
      @sum-at-zero-is-zero |
        sumUpTo(idSqSeq, ZERO) = ZERO
        [using specialize sumUpToZero(idSqSeq)]
      @six-times-empty-sum |
        mul(SIX, sumUpTo(idSqSeq, ZERO)) = ZERO
        [using simplify sum-at-zero-is-zero mulZeroRight]
      // (0-1)·0·(2·0-1) = 0 since the middle factor is 0.
      @rhs-at-zero-is-zero |
        mul(sub(ZERO, ONE), mul(ZERO, sub(mul(TWO, ZERO), ONE))) = ZERO
        [using polynomial]
      @sum-of-squares-at-zero |
        mul(SIX, sumUpTo(idSqSeq, ZERO)) = mul(sub(ZERO, ONE), mul(ZERO, sub(mul(TWO, ZERO), ONE)))
        [using chain six-times-empty-sum rhs-at-zero-is-zero]
    }
  @base-case |
    is_nonneg(ZERO) -> mul(SIX, sumUpTo(idSqSeq, ZERO)) = mul(sub(ZERO, ONE), mul(ZERO, sub(mul(TWO, ZERO), ONE)))
    [by implies_intro given-zero-nonneg]
  @induction-step |
    fix k: Int {
      @given-k-nonneg |
        assume is_nonneg(k) {
          @k-nonneg |
            is_nonneg(k)
            [by hypothesis given-k-nonneg]
          @given-inductive-hypothesis |
            assume is_nonneg(k) -> mul(SIX, sumUpTo(idSqSeq, k)) = mul(sub(k, ONE), mul(k, sub(mul(TWO, k), ONE))) {
              @guarded-inductive-hypothesis |
                is_nonneg(k) -> mul(SIX, sumUpTo(idSqSeq, k)) = mul(sub(k, ONE), mul(k, sub(mul(TWO, k), ONE)))
                [by hypothesis given-inductive-hypothesis]
              @inductive-hypothesis |
                mul(SIX, sumUpTo(idSqSeq, k)) = mul(sub(k, ONE), mul(k, sub(mul(TWO, k), ONE)))
                [using specialize guarded-inductive-hypothesis k-nonneg]
              @successor-nonneg |
                is_nonneg(succ(k))
                [using specialize nonnegSucc(k) k-nonneg]
              @sum-at-successor |
                sumUpTo(idSqSeq, succ(k)) = add(sumUpTo(idSqSeq, k), at(idSqSeq, k))
                [using specialize sumUpToSucc(idSqSeq, k) k-nonneg]
              @entry-at-k-is-k-squared |
                at(idSqSeq, k) = mul(k, k)
                [using specialize idSqSeqEntry(k) k-nonneg]
              @sum-at-successor-adds-k-squared |
                sumUpTo(idSqSeq, succ(k)) = add(sumUpTo(idSqSeq, k), mul(k, k))
                [by rewrite entry-at-k-is-k-squared sum-at-successor]
              // 6·Σ_{k+1} = 6·(Σ_k + k²) = 6·Σ_k + 6k².
              @six-times-sum-successor |
                mul(SIX, sumUpTo(idSqSeq, succ(k))) = add(mul(SIX, sumUpTo(idSqSeq, k)), mul(SIX, mul(k, k)))
                [using arithmetic sum-at-successor-adds-k-squared]
              // substitute the IH: 6·Σ_{k+1} = (k-1)k(2k-1) + 6k².
              @six-times-sum-successor-with-ih |
                mul(SIX, sumUpTo(idSqSeq, succ(k))) = add(mul(sub(k, ONE), mul(k, sub(mul(TWO, k), ONE))), mul(SIX, mul(k, k)))
                [by rewrite inductive-hypothesis six-times-sum-successor]
              // normalize the successor RHS factors to add-form (each a LINEAR
              // identity), rewriting them into the product one at a time.
              // these three are numeral/succ folds where a bare ONE meets a symbolic
              // succ(k): `arithmetic`/`polynomial` keep ONE opaque against a
              // succ-of-variable (a known certifier gap — see FINDINGS), so unfold
              // by `simplify` with the succ/prev/neg recursion lemmas.
              @first-factor-is-k |
                sub(succ(k), ONE) = k
                [using simplify definitionOfSubtraction oneIsSuccZero negSucc negZero addPrevRight prevSucc addZeroRight]
              @successor-is-k-plus-one |
                succ(k) = add(k, ONE)
                [using simplify oneIsSuccZero addSuccRight addZeroRight]
              @third-factor-is-two-k-plus-one |
                sub(mul(TWO, succ(k)), ONE) = add(mul(TWO, k), ONE)
                [using simplify definitionOfSubtraction oneIsSuccZero mulSuccRight negSucc negZero addSuccRight addPrevRight prevSucc addZeroRight addZeroLeft]
              @rhs-reflexive |
                mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE))) = mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE)))
                [by reflexivity]
              @rhs-first-normalized |
                mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE))) = mul(k, mul(succ(k), sub(mul(TWO, succ(k)), ONE)))
                [by rewrite first-factor-is-k rhs-reflexive]
              @rhs-third-normalized |
                mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE))) = mul(k, mul(succ(k), add(mul(TWO, k), ONE)))
                [by rewrite third-factor-is-two-k-plus-one rhs-first-normalized]
              @rhs-successor-normalized |
                mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE))) = mul(k, mul(add(k, ONE), add(mul(TWO, k), ONE)))
                [by rewrite successor-is-k-plus-one rhs-third-normalized]
              // the pure cubic ring identity: (k-1)k(2k-1) + 6k² = k(k+1)(2k+1). All
              // sub written as add(_, neg) so polynomial expands + folds numerals.
              @cubic-identity |
                add(mul(sub(k, ONE), mul(k, sub(mul(TWO, k), ONE))), mul(SIX, mul(k, k))) = mul(k, mul(add(k, ONE), add(mul(TWO, k), ONE)))
                [using polynomial]
              @cubic-identity-in-successor-form |
                add(mul(sub(k, ONE), mul(k, sub(mul(TWO, k), ONE))), mul(SIX, mul(k, k))) = mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE)))
                [using chain cubic-identity rhs-successor-normalized]
              @given-successor-nonneg |
                assume is_nonneg(succ(k)) {
                  @sum-of-squares-at-successor |
                    mul(SIX, sumUpTo(idSqSeq, succ(k))) = mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE)))
                    [using chain six-times-sum-successor-with-ih cubic-identity-in-successor-form]
                }
              @predicate-at-successor |
                is_nonneg(succ(k)) -> mul(SIX, sumUpTo(idSqSeq, succ(k))) = mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE)))
                [by implies_intro given-successor-nonneg]
            }
          @inductive-hypothesis-implies-successor |
            (is_nonneg(k) -> mul(SIX, sumUpTo(idSqSeq, k)) = mul(sub(k, ONE), mul(k, sub(mul(TWO, k), ONE)))) ->
              (is_nonneg(succ(k)) -> mul(SIX, sumUpTo(idSqSeq, succ(k))) = mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE))))
            [by implies_intro given-inductive-hypothesis]
        }
      @discharge-successor |
        is_nonneg(k) ->
          ((is_nonneg(k) -> mul(SIX, sumUpTo(idSqSeq, k)) = mul(sub(k, ONE), mul(k, sub(mul(TWO, k), ONE)))) ->
          (is_nonneg(succ(k)) -> mul(SIX, sumUpTo(idSqSeq, succ(k))) = mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE)))))
        [by implies_intro given-k-nonneg]
    }
  @induction-step-for-all-k |
    forall k: Int;
      is_nonneg(k) ->
      (is_nonneg(k) -> mul(SIX, sumUpTo(idSqSeq, k)) = mul(sub(k, ONE), mul(k, sub(mul(TWO, k), ONE)))) ->
      (is_nonneg(succ(k)) -> mul(SIX, sumUpTo(idSqSeq, succ(k))) = mul(sub(succ(k), ONE), mul(succ(k), sub(mul(TWO, succ(k)), ONE))))
    [by forall_intro induction-step]
  @conclusion |
    forall n: NonNegZ; is_nonneg(n) -> mul(SIX, sumUpTo(idSqSeq, n)) = mul(sub(n, ONE), mul(n, sub(mul(TWO, n), ONE)))
    [using instantiation nonnegInduction((fun n: Int => is_nonneg(n) -> mul(SIX, sumUpTo(idSqSeq, n)) = mul(sub(n, ONE), mul(n, sub(mul(TWO, n), ONE))))) base-case induction-step-for-all-k]
qed

// -- sum of cubes (AATA §2.1 Ex 2) ------------------------------------------
//
// idCubeSeq: i-th entry is i³. Σ_{i<n} i³ = sumUpTo(idCubeSeq, n).
const idCubeSeq: Seq
axiom idCubeSeqEntry: forall i: NonNegZ; at(idCubeSeq, i) = mul(i, mul(i, i))

// 4·Σ_{i<n} i³ = (n·(n-1))², the DIVISION-FREE form of Σ_{i=1}^{m} i³ =
// (m(m+1)/2)² (reindexed to i<n). ℚ NOT needed. Nonneg-induction; the quartic
// ring step (k(k-1))² + 4k³ = (k(k+1))² closes by `polynomial`.
theorem sumOfCubes: forall n: NonNegZ;
  is_nonneg(n) -> mul(FOUR, sumUpTo(idCubeSeq, n)) = mul(mul(n, sub(n, ONE)), mul(n, sub(n, ONE)))
proof
  @given-zero-nonneg |
    assume is_nonneg(ZERO) {
      @sum-at-zero-is-zero |
        sumUpTo(idCubeSeq, ZERO) = ZERO
        [using specialize sumUpToZero(idCubeSeq)]
      @four-times-empty-sum |
        mul(FOUR, sumUpTo(idCubeSeq, ZERO)) = ZERO
        [using simplify sum-at-zero-is-zero mulZeroRight]
      // (0·(0-1))² = 0² = 0.
      @rhs-at-zero-is-zero |
        mul(mul(ZERO, sub(ZERO, ONE)), mul(ZERO, sub(ZERO, ONE))) = ZERO
        [using polynomial]
      @sum-of-cubes-at-zero |
        mul(FOUR, sumUpTo(idCubeSeq, ZERO)) = mul(mul(ZERO, sub(ZERO, ONE)), mul(ZERO, sub(ZERO, ONE)))
        [using chain four-times-empty-sum rhs-at-zero-is-zero]
    }
  @base-case |
    is_nonneg(ZERO) -> mul(FOUR, sumUpTo(idCubeSeq, ZERO)) = mul(mul(ZERO, sub(ZERO, ONE)), mul(ZERO, sub(ZERO, ONE)))
    [by implies_intro given-zero-nonneg]
  @induction-step |
    fix k: Int {
      @given-k-nonneg |
        assume is_nonneg(k) {
          @k-nonneg |
            is_nonneg(k)
            [by hypothesis given-k-nonneg]
          @given-inductive-hypothesis |
            assume is_nonneg(k) -> mul(FOUR, sumUpTo(idCubeSeq, k)) = mul(mul(k, sub(k, ONE)), mul(k, sub(k, ONE))) {
              @guarded-inductive-hypothesis |
                is_nonneg(k) -> mul(FOUR, sumUpTo(idCubeSeq, k)) = mul(mul(k, sub(k, ONE)), mul(k, sub(k, ONE)))
                [by hypothesis given-inductive-hypothesis]
              @inductive-hypothesis |
                mul(FOUR, sumUpTo(idCubeSeq, k)) = mul(mul(k, sub(k, ONE)), mul(k, sub(k, ONE)))
                [using specialize guarded-inductive-hypothesis k-nonneg]
              @successor-nonneg |
                is_nonneg(succ(k))
                [using specialize nonnegSucc(k) k-nonneg]
              @sum-at-successor |
                sumUpTo(idCubeSeq, succ(k)) = add(sumUpTo(idCubeSeq, k), at(idCubeSeq, k))
                [using specialize sumUpToSucc(idCubeSeq, k) k-nonneg]
              @entry-at-k-is-k-cubed |
                at(idCubeSeq, k) = mul(k, mul(k, k))
                [using specialize idCubeSeqEntry(k) k-nonneg]
              @sum-at-successor-adds-k-cubed |
                sumUpTo(idCubeSeq, succ(k)) = add(sumUpTo(idCubeSeq, k), mul(k, mul(k, k)))
                [by rewrite entry-at-k-is-k-cubed sum-at-successor]
              // 4·Σ_{k+1} = 4·(Σ_k + k³) = 4·Σ_k + 4k³.
              @four-times-sum-successor |
                mul(FOUR, sumUpTo(idCubeSeq, succ(k))) = add(mul(FOUR, sumUpTo(idCubeSeq, k)), mul(FOUR, mul(k, mul(k, k))))
                [using arithmetic sum-at-successor-adds-k-cubed]
              // substitute the IH: 4·Σ_{k+1} = (k(k-1))² + 4k³.
              @four-times-sum-successor-with-ih |
                mul(FOUR, sumUpTo(idCubeSeq, succ(k))) = add(mul(mul(k, sub(k, ONE)), mul(k, sub(k, ONE))), mul(FOUR, mul(k, mul(k, k))))
                [by rewrite inductive-hypothesis four-times-sum-successor]
              // normalize the successor RHS factors: (succ k)-1 = k, succ k = k+1.
              @first-factor-is-k |
                sub(succ(k), ONE) = k
                [using simplify definitionOfSubtraction oneIsSuccZero negSucc negZero addPrevRight prevSucc addZeroRight]
              @successor-is-k-plus-one |
                succ(k) = add(k, ONE)
                [using simplify oneIsSuccZero addSuccRight addZeroRight]
              @rhs-reflexive |
                mul(mul(succ(k), sub(succ(k), ONE)), mul(succ(k), sub(succ(k), ONE))) = mul(mul(succ(k), sub(succ(k), ONE)), mul(succ(k), sub(succ(k), ONE)))
                [by reflexivity]
              @rhs-inner-normalized |
                mul(mul(succ(k), sub(succ(k), ONE)), mul(succ(k), sub(succ(k), ONE))) = mul(mul(succ(k), k), mul(succ(k), k))
                [by rewrite first-factor-is-k rhs-reflexive]
              @rhs-successor-normalized |
                mul(mul(succ(k), sub(succ(k), ONE)), mul(succ(k), sub(succ(k), ONE))) = mul(mul(add(k, ONE), k), mul(add(k, ONE), k))
                [by rewrite successor-is-k-plus-one rhs-inner-normalized]
              // the quartic ring identity: (k(k-1))² + 4k³ = (k(k+1))². sub form for
              // k-1, add(k,ONE) for k+1 so polynomial expands + folds numerals.
              @quartic-identity |
                add(mul(mul(k, sub(k, ONE)), mul(k, sub(k, ONE))), mul(FOUR, mul(k, mul(k, k)))) = mul(mul(add(k, ONE), k), mul(add(k, ONE), k))
                [using polynomial]
              @quartic-identity-in-successor-form |
                add(mul(mul(k, sub(k, ONE)), mul(k, sub(k, ONE))), mul(FOUR, mul(k, mul(k, k)))) = mul(mul(succ(k), sub(succ(k), ONE)), mul(succ(k), sub(succ(k), ONE)))
                [using chain quartic-identity rhs-successor-normalized]
              @given-successor-nonneg |
                assume is_nonneg(succ(k)) {
                  @sum-of-cubes-at-successor |
                    mul(FOUR, sumUpTo(idCubeSeq, succ(k))) = mul(mul(succ(k), sub(succ(k), ONE)), mul(succ(k), sub(succ(k), ONE)))
                    [using chain four-times-sum-successor-with-ih quartic-identity-in-successor-form]
                }
              @predicate-at-successor |
                is_nonneg(succ(k)) -> mul(FOUR, sumUpTo(idCubeSeq, succ(k))) = mul(mul(succ(k), sub(succ(k), ONE)), mul(succ(k), sub(succ(k), ONE)))
                [by implies_intro given-successor-nonneg]
            }
          @inductive-hypothesis-implies-successor |
            (is_nonneg(k) -> mul(FOUR, sumUpTo(idCubeSeq, k)) = mul(mul(k, sub(k, ONE)), mul(k, sub(k, ONE)))) ->
              (is_nonneg(succ(k)) -> mul(FOUR, sumUpTo(idCubeSeq, succ(k))) = mul(mul(succ(k), sub(succ(k), ONE)), mul(succ(k), sub(succ(k), ONE))))
            [by implies_intro given-inductive-hypothesis]
        }
      @discharge-successor |
        is_nonneg(k) ->
          ((is_nonneg(k) -> mul(FOUR, sumUpTo(idCubeSeq, k)) = mul(mul(k, sub(k, ONE)), mul(k, sub(k, ONE)))) ->
          (is_nonneg(succ(k)) -> mul(FOUR, sumUpTo(idCubeSeq, succ(k))) = mul(mul(succ(k), sub(succ(k), ONE)), mul(succ(k), sub(succ(k), ONE)))))
        [by implies_intro given-k-nonneg]
    }
  @induction-step-for-all-k |
    forall k: Int;
      is_nonneg(k) ->
      (is_nonneg(k) -> mul(FOUR, sumUpTo(idCubeSeq, k)) = mul(mul(k, sub(k, ONE)), mul(k, sub(k, ONE)))) ->
      (is_nonneg(succ(k)) -> mul(FOUR, sumUpTo(idCubeSeq, succ(k))) = mul(mul(succ(k), sub(succ(k), ONE)), mul(succ(k), sub(succ(k), ONE))))
    [by forall_intro induction-step]
  @conclusion |
    forall n: NonNegZ; is_nonneg(n) -> mul(FOUR, sumUpTo(idCubeSeq, n)) = mul(mul(n, sub(n, ONE)), mul(n, sub(n, ONE)))
    [using instantiation nonnegInduction((fun n: Int => is_nonneg(n) -> mul(FOUR, sumUpTo(idCubeSeq, n)) = mul(mul(n, sub(n, ONE)), mul(n, sub(n, ONE))))) base-case induction-step-for-all-k]
qed

// -- arithmetic-progression sum (AATA §2.1 Ex 4) ----------------------------
//
// idApSeq: i-th entry is (3i+1)·X — the terms X, 4X, 7X, … of the progression
// (0-indexed: term i is (3i+1)X). Σ_{i<n} (3i+1)X = sumUpTo(idApSeq, n).
const idApSeq: Seq
axiom idApSeqEntry: forall i: NonNegZ; at(idApSeq, i) = mul(add(mul(THREE, i), ONE), X)

// 2·Σ_{i<n} (3i+1)X = n·(3n-1)·X, the DIVISION-FREE form of Judson's
// X + 4X + … + (3n-2)X = n(3n-1)X/2. ℚ NOT needed. Nonneg-induction; the ring
// step k(3k-1)X + 2(3k+1)X = (k+1)(3k+2)X closes by `polynomial`.
theorem sumOfArithmeticProgression: forall n: NonNegZ;
  is_nonneg(n) -> mul(TWO, sumUpTo(idApSeq, n)) = mul(mul(n, sub(mul(THREE, n), ONE)), X)
proof
  @given-zero-nonneg |
    assume is_nonneg(ZERO) {
      @sum-at-zero-is-zero |
        sumUpTo(idApSeq, ZERO) = ZERO
        [using specialize sumUpToZero(idApSeq)]
      @two-times-empty-sum |
        mul(TWO, sumUpTo(idApSeq, ZERO)) = ZERO
        [using simplify sum-at-zero-is-zero mulZeroRight]
      // (0·(3·0-1))·X = 0·X = 0.
      @rhs-at-zero-is-zero |
        mul(mul(ZERO, sub(mul(THREE, ZERO), ONE)), X) = ZERO
        [using polynomial]
      @sum-at-zero |
        mul(TWO, sumUpTo(idApSeq, ZERO)) = mul(mul(ZERO, sub(mul(THREE, ZERO), ONE)), X)
        [using chain two-times-empty-sum rhs-at-zero-is-zero]
    }
  @base-case |
    is_nonneg(ZERO) -> mul(TWO, sumUpTo(idApSeq, ZERO)) = mul(mul(ZERO, sub(mul(THREE, ZERO), ONE)), X)
    [by implies_intro given-zero-nonneg]
  @induction-step |
    fix k: Int {
      @given-k-nonneg |
        assume is_nonneg(k) {
          @k-nonneg |
            is_nonneg(k)
            [by hypothesis given-k-nonneg]
          @given-inductive-hypothesis |
            assume is_nonneg(k) -> mul(TWO, sumUpTo(idApSeq, k)) = mul(mul(k, sub(mul(THREE, k), ONE)), X) {
              @guarded-inductive-hypothesis |
                is_nonneg(k) -> mul(TWO, sumUpTo(idApSeq, k)) = mul(mul(k, sub(mul(THREE, k), ONE)), X)
                [by hypothesis given-inductive-hypothesis]
              @inductive-hypothesis |
                mul(TWO, sumUpTo(idApSeq, k)) = mul(mul(k, sub(mul(THREE, k), ONE)), X)
                [using specialize guarded-inductive-hypothesis k-nonneg]
              @successor-nonneg |
                is_nonneg(succ(k))
                [using specialize nonnegSucc(k) k-nonneg]
              @sum-at-successor |
                sumUpTo(idApSeq, succ(k)) = add(sumUpTo(idApSeq, k), at(idApSeq, k))
                [using specialize sumUpToSucc(idApSeq, k) k-nonneg]
              @entry-at-k |
                at(idApSeq, k) = mul(add(mul(THREE, k), ONE), X)
                [using specialize idApSeqEntry(k) k-nonneg]
              @sum-at-successor-adds-term |
                sumUpTo(idApSeq, succ(k)) = add(sumUpTo(idApSeq, k), mul(add(mul(THREE, k), ONE), X))
                [by rewrite entry-at-k sum-at-successor]
              // 2·Σ_{k+1} = 2·Σ_k + 2·(3k+1)X.
              @two-times-sum-successor |
                mul(TWO, sumUpTo(idApSeq, succ(k))) = add(mul(TWO, sumUpTo(idApSeq, k)), mul(TWO, mul(add(mul(THREE, k), ONE), X)))
                [using arithmetic sum-at-successor-adds-term]
              // substitute the IH: 2·Σ_{k+1} = k(3k-1)X + 2(3k+1)X.
              @two-times-sum-successor-with-ih |
                mul(TWO, sumUpTo(idApSeq, succ(k))) = add(mul(mul(k, sub(mul(THREE, k), ONE)), X), mul(TWO, mul(add(mul(THREE, k), ONE), X)))
                [by rewrite inductive-hypothesis two-times-sum-successor]
              // normalize the successor RHS factors: 3·succ(k)-1 = 3k+2, succ k = k+1.
              @successor-is-k-plus-one |
                succ(k) = add(k, ONE)
                [using simplify oneIsSuccZero addSuccRight addZeroRight]
              @three-successor-minus-one |
                sub(mul(THREE, succ(k)), ONE) = add(mul(THREE, k), TWO)
                [using simplify definitionOfSubtraction oneIsSuccZero mulSuccRight negSucc negZero addSuccRight addPrevRight prevSucc addZeroRight addZeroLeft]
              @rhs-reflexive |
                mul(mul(succ(k), sub(mul(THREE, succ(k)), ONE)), X) = mul(mul(succ(k), sub(mul(THREE, succ(k)), ONE)), X)
                [by reflexivity]
              @rhs-third-normalized |
                mul(mul(succ(k), sub(mul(THREE, succ(k)), ONE)), X) = mul(mul(succ(k), add(mul(THREE, k), TWO)), X)
                [by rewrite three-successor-minus-one rhs-reflexive]
              @rhs-successor-normalized |
                mul(mul(succ(k), sub(mul(THREE, succ(k)), ONE)), X) = mul(mul(add(k, ONE), add(mul(THREE, k), TWO)), X)
                [by rewrite successor-is-k-plus-one rhs-third-normalized]
              // the ring identity: k(3k-1)X + 2(3k+1)X = (k+1)(3k+2)X.
              @progression-identity |
                add(mul(mul(k, sub(mul(THREE, k), ONE)), X), mul(TWO, mul(add(mul(THREE, k), ONE), X))) = mul(mul(add(k, ONE), add(mul(THREE, k), TWO)), X)
                [using polynomial]
              @progression-identity-in-successor-form |
                add(mul(mul(k, sub(mul(THREE, k), ONE)), X), mul(TWO, mul(add(mul(THREE, k), ONE), X))) = mul(mul(succ(k), sub(mul(THREE, succ(k)), ONE)), X)
                [using chain progression-identity rhs-successor-normalized]
              @given-successor-nonneg |
                assume is_nonneg(succ(k)) {
                  @sum-at-successor-folded |
                    mul(TWO, sumUpTo(idApSeq, succ(k))) = mul(mul(succ(k), sub(mul(THREE, succ(k)), ONE)), X)
                    [using chain two-times-sum-successor-with-ih progression-identity-in-successor-form]
                }
              @predicate-at-successor |
                is_nonneg(succ(k)) -> mul(TWO, sumUpTo(idApSeq, succ(k))) = mul(mul(succ(k), sub(mul(THREE, succ(k)), ONE)), X)
                [by implies_intro given-successor-nonneg]
            }
          @inductive-hypothesis-implies-successor |
            (is_nonneg(k) -> mul(TWO, sumUpTo(idApSeq, k)) = mul(mul(k, sub(mul(THREE, k), ONE)), X)) ->
              (is_nonneg(succ(k)) -> mul(TWO, sumUpTo(idApSeq, succ(k))) = mul(mul(succ(k), sub(mul(THREE, succ(k)), ONE)), X))
            [by implies_intro given-inductive-hypothesis]
        }
      @discharge-successor |
        is_nonneg(k) ->
          ((is_nonneg(k) -> mul(TWO, sumUpTo(idApSeq, k)) = mul(mul(k, sub(mul(THREE, k), ONE)), X)) ->
          (is_nonneg(succ(k)) -> mul(TWO, sumUpTo(idApSeq, succ(k))) = mul(mul(succ(k), sub(mul(THREE, succ(k)), ONE)), X)))
        [by implies_intro given-k-nonneg]
    }
  @induction-step-for-all-k |
    forall k: Int;
      is_nonneg(k) ->
      (is_nonneg(k) -> mul(TWO, sumUpTo(idApSeq, k)) = mul(mul(k, sub(mul(THREE, k), ONE)), X)) ->
      (is_nonneg(succ(k)) -> mul(TWO, sumUpTo(idApSeq, succ(k))) = mul(mul(succ(k), sub(mul(THREE, succ(k)), ONE)), X))
    [by forall_intro induction-step]
  @conclusion |
    forall n: NonNegZ; is_nonneg(n) -> mul(TWO, sumUpTo(idApSeq, n)) = mul(mul(n, sub(mul(THREE, n), ONE)), X)
    [using instantiation nonnegInduction((fun n: Int => is_nonneg(n) -> mul(TWO, sumUpTo(idApSeq, n)) = mul(mul(n, sub(mul(THREE, n), ONE)), X))) base-case induction-step-for-all-k]
qed
