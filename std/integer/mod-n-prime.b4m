// std/integer/mod-n-prime.b4m — ℤ_p for a PRIME modulus has no proper nontrivial subgroups
// (Judson §4.1, exercise 26).
//
// A subgroup H of ℤ_n is a predicate closed under 0, + and −. It is closed under all
// integer multiples (k·x = znPower(x, k)), so if it contains some cls(a) ≠ 0 with a
// coprime to N — and for PRIME N every nonzero class is — then by Bézout 1 = ra + sN it
// contains cls(1) = r·cls(a), which generates ℤ_n. So H is {0} or everything.

theory integer <<< "std/integer.b4m"
theory int_divides <<< "std/integer/divides.b4m"
theory primes <<< "std/primes.b4m"
theory mod_n <<< "std/integer/mod-n.b4m"

sort Int = integer.Int
const INT_ZERO = integer.ZERO
const INT_ONE = integer.ONE
oper int_add = integer.add
oper int_mul = integer.mul
oper int_sub = integer.sub
oper int_neg = integer.neg
oper int_succ = integer.succ
oper int_prev = integer.prev
fact intInduction = integer.induction
pred less_than = int_divides.less_than
define divides(d, k) = int_divides.divides(d, k)
define is_prime(p) = primes.is_prime(p)

sort Zn = mod_n.Zn
oper cls = mod_n.cls
const N = mod_n.N
const ZERO = mod_n.ZERO
oper add = mod_n.add
oper neg = mod_n.neg
oper znPower = mod_n.znPower

// What this file proves (verified manifest):
intheory subgroupClosedUnderPowers
intheory subZeroRight
intheory multipleOfModulusIsZero
intheory primeModulusHasNoProperSubgroups
intheory primeModulusSubgroupIsTrivialOrEverything

// -- a subgroup is closed under integer multiples ------------------------------------------
// prop(x) ⟹ prop(k·x) for every k ∈ ℤ: 0·x = 0 ∈ H; (k+1)·x = k·x + x; (k−1)·x = k·x + (−x).
theorem subgroupClosedUnderPowers(prop(Zn)): prop(ZERO) -> (forall x, y: Zn; prop(x) -> prop(y) -> prop(add(x, y))) -> (forall x: Zn; prop(x) -> prop(neg(x))) -> forall x: Zn; prop(x) -> forall k: Int; prop(znPower(x, k))
proof
  @given-zero |
    assume prop(ZERO) {
      @given-closed-add |
        assume forall x, y: Zn; prop(x) -> prop(y) -> prop(add(x, y)) {
          @given-closed-neg |
            assume forall x: Zn; prop(x) -> prop(neg(x)) {
              @zero-in |
                prop(ZERO)
                [by hypothesis given-zero]
              @closed-add |
                forall x, y: Zn; prop(x) -> prop(y) -> prop(add(x, y))
                [by hypothesis given-closed-add]
              @closed-neg |
                forall x: Zn; prop(x) -> prop(neg(x))
                [by hypothesis given-closed-neg]
              @generalize-x |
                fix x: Zn {
                  @given-x-in |
                    assume prop(x) {
                      @x-in |
                        prop(x)
                        [by hypothesis given-x-in]
                      @neg-x-in |
                        prop(neg(x))
                        [using specialize closed-neg(x) x-in]
                      @zeroth-multiple |
                        znPower(x, INT_ZERO) = ZERO
                        [using specialize mod_n.znPowerZero(x)]
                      @base-case |
                        prop(znPower(x, INT_ZERO))
                        [by rewrite zeroth-multiple zero-in]
                      @step-up |
                        fix k: Int {
                          @given-multiple-in |
                            assume prop(znPower(x, k)) {
                              @multiple-in |
                                prop(znPower(x, k))
                                [by hypothesis given-multiple-in]
                              @next-multiple-unfolds |
                                znPower(x, int_succ(k)) = add(znPower(x, k), x)
                                [using specialize mod_n.znPowerSucc(x, k)]
                              @sum-in |
                                prop(add(znPower(x, k), x))
                                [using specialize closed-add(znPower(x, k), x) multiple-in x-in]
                              @conclusion-next-multiple-in |
                                prop(znPower(x, int_succ(k)))
                                [by rewrite next-multiple-unfolds sum-in]
                            }
                          @conclusion-step-up |
                            prop(znPower(x, k)) -> prop(znPower(x, int_succ(k)))
                            [by discharge given-multiple-in]
                        }
                      @step-up-for-all-k |
                        forall k: Int; prop(znPower(x, k)) -> prop(znPower(x, int_succ(k)))
                        [by generalize step-up]
                      @step-down |
                        fix k: Int {
                          @given-multiple-in |
                            assume prop(znPower(x, k)) {
                              @multiple-in |
                                prop(znPower(x, k))
                                [by hypothesis given-multiple-in]
                              @previous-multiple-unfolds |
                                znPower(x, int_prev(k)) = add(znPower(x, k), neg(x))
                                [using specialize mod_n.znPowerPrev(x, k)]
                              @difference-in |
                                prop(add(znPower(x, k), neg(x)))
                                [using specialize closed-add(znPower(x, k), neg(x)) multiple-in neg-x-in]
                              @conclusion-previous-multiple-in |
                                prop(znPower(x, int_prev(k)))
                                [by rewrite previous-multiple-unfolds difference-in]
                            }
                          @conclusion-step-down |
                            prop(znPower(x, k)) -> prop(znPower(x, int_prev(k)))
                            [by discharge given-multiple-in]
                        }
                      @step-down-for-all-k |
                        forall k: Int; prop(znPower(x, k)) -> prop(znPower(x, int_prev(k)))
                        [by generalize step-down]
                      @conclusion-all-multiples-in |
                        forall k: Int; prop(znPower(x, k))
                        [using instantiation intInduction((fun k: Int => prop(znPower(x, k)))) base-case step-up-for-all-k step-down-for-all-k]
                    }
                  @x-in-implies |
                    prop(x) -> forall k: Int; prop(znPower(x, k))
                    [by discharge given-x-in]
                }
              @discharge-x |
                forall x: Zn; prop(x) -> forall k: Int; prop(znPower(x, k))
                [by generalize generalize-x]
            }
          @closed-neg-implies |
            (forall x: Zn; prop(x) -> prop(neg(x))) -> forall x: Zn; prop(x) -> forall k: Int; prop(znPower(x, k))
            [by discharge given-closed-neg]
        }
      @closed-add-implies |
        (forall x, y: Zn; prop(x) -> prop(y) -> prop(add(x, y))) -> (forall x: Zn; prop(x) -> prop(neg(x))) -> forall x: Zn; prop(x) -> forall k: Int; prop(znPower(x, k))
        [by discharge given-closed-add]
    }
  @conclusion |
    prop(ZERO) -> (forall x, y: Zn; prop(x) -> prop(y) -> prop(add(x, y))) -> (forall x: Zn; prop(x) -> prop(neg(x))) -> forall x: Zn; prop(x) -> forall k: Int; prop(znPower(x, k))
    [by discharge given-zero]
qed

// -- a multiple of the modulus is the zero class --------------------------------------------

// a − 0 = a.
theorem subZeroRight: forall a: Int; int_sub(a, INT_ZERO) = a
proof
  @generalize-a |
    fix a: Int {
      @unfolded |
        int_sub(a, INT_ZERO) = int_add(a, int_neg(INT_ZERO))
        [using specialize integer.definitionOfSubtraction(a, INT_ZERO)]
      @neg-zero |
        int_neg(INT_ZERO) = INT_ZERO
        [using import(integer) negZero]
      @plus-zero |
        int_add(a, INT_ZERO) = a
        [using specialize integer.addZeroRight(a)]
      @conclusion-sub-zero |
        int_sub(a, INT_ZERO) = a
        [using simplify unfolded neg-zero plus-zero]
    }
  @conclusion |
    forall a: Int; int_sub(a, INT_ZERO) = a
    [by generalize generalize-a]
qed

// N | a ⟹ cls(a) = 0.
theorem multipleOfModulusIsZero: forall a: Int; divides(N, a) -> cls(a) = ZERO
proof
  @generalize-a |
    fix a: Int {
      @given-divides |
        assume divides(N, a) {
          @n-divides-a |
            divides(N, a)
            [by hypothesis given-divides]
          @a-minus-zero |
            int_sub(a, INT_ZERO) = a
            [using specialize subZeroRight(a)]
          @n-divides-difference |
            divides(N, int_sub(a, INT_ZERO))
            [by rewrite a-minus-zero n-divides-a]
          @congruent-iff |
            cls(a) = cls(INT_ZERO) iff divides(N, int_sub(a, INT_ZERO))
            [using specialize mod_n.clsCongruent(a, INT_ZERO)]
          @a-is-zero-class |
            cls(a) = cls(INT_ZERO)
            [using tautology congruent-iff n-divides-difference]
          @zero-is-zero-class |
            ZERO = cls(INT_ZERO)
            [using import(mod_n) zeroIsClsZero]
          @zero-class-is-zero |
            cls(INT_ZERO) = ZERO
            [by symmetry zero-is-zero-class]
          @conclusion-a-is-zero |
            cls(a) = ZERO
            [using chain a-is-zero-class zero-class-is-zero]
        }
      @divides-implies |
        divides(N, a) -> cls(a) = ZERO
        [by discharge given-divides]
    }
  @conclusion |
    forall a: Int; divides(N, a) -> cls(a) = ZERO
    [by generalize generalize-a]
qed

// -- ℤ_p has no proper nontrivial subgroups -------------------------------------------------
// For H a subgroup (0 ∈ H, closed under + and −) and N prime: H = {0} or H = ℤ_N. If some
// cls(a) ∈ H is nonzero then N ∤ a, so a and N are coprime (N is prime); Bézout gives
// r a + s N = 1, so cls(1) = r·cls(a) + cls(sN) = r·cls(a) ∈ H, and cls(1) generates ℤ_N.
theorem primeModulusHasNoProperSubgroups(prop(Zn)): prop(ZERO) -> (forall x, y: Zn; prop(x) -> prop(y) -> prop(add(x, y))) -> (forall x: Zn; prop(x) -> prop(neg(x))) -> is_prime(N) -> ((forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x)))
proof
  @given-zero |
    assume prop(ZERO) {
      @given-closed-add |
        assume forall x, y: Zn; prop(x) -> prop(y) -> prop(add(x, y)) {
          @given-closed-neg |
            assume forall x: Zn; prop(x) -> prop(neg(x)) {
              @given-prime |
                assume is_prime(N) {
                  @zero-in |
                    prop(ZERO)
                    [by hypothesis given-zero]
                  @closed-add |
                    forall x, y: Zn; prop(x) -> prop(y) -> prop(add(x, y))
                    [by hypothesis given-closed-add]
                  @closed-neg |
                    forall x: Zn; prop(x) -> prop(neg(x))
                    [by hypothesis given-closed-neg]
                  @n-prime |
                    is_prime(N)
                    [by hypothesis given-prime]
                  @closed-under-multiples |
                    forall x: Zn; prop(x) -> forall k: Int; prop(znPower(x, k))
                    [using instantiation subgroupClosedUnderPowers((fun w: Zn => prop(w))) zero-in closed-add closed-neg]
                  @trivial-or-not |
                    (forall x: Zn; prop(x) -> x = ZERO) or (not (forall x: Zn; prop(x) -> x = ZERO))
                    [using tautology]
                  @conclusion-trivial-or-everything |
                    (forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x))
                    case trivial-or-not {
                      @when-trivial |
                        assume forall x: Zn; prop(x) -> x = ZERO {
                          @trivial |
                            forall x: Zn; prop(x) -> x = ZERO
                            [by hypothesis when-trivial]
                          @conclusion-left |
                            (forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x))
                            [by either_lhs trivial]
                        }
                      @when-not-trivial |
                        assume not (forall x: Zn; prop(x) -> x = ZERO) {
                          @not-trivial |
                            not (forall x: Zn; prop(x) -> x = ZERO)
                            [by hypothesis when-not-trivial]
                          // classically, some member is nonzero.
                          @given-no-nonzero-member |
                            assume not (exists z: Zn; prop(z) and z != ZERO) {
                              @no-nonzero-member |
                                not (exists z: Zn; prop(z) and z != ZERO)
                                [by hypothesis given-no-nonzero-member]
                              @generalize-y |
                                fix y: Zn {
                                  @given-y-in |
                                    assume prop(y) {
                                      @y-in |
                                        prop(y)
                                        [by hypothesis given-y-in]
                                      @given-y-nonzero |
                                        assume y != ZERO {
                                          @y-nonzero |
                                            y != ZERO
                                            [by hypothesis given-y-nonzero]
                                          @y-is-a-nonzero-member |
                                            prop(y) and y != ZERO
                                            [by both y-in y-nonzero]
                                          @some-nonzero-member |
                                            exists z: Zn; prop(z) and z != ZERO
                                            [by witness(y) y-is-a-nonzero-member]
                                        }
                                      @y-nonzero-implies |
                                        y != ZERO -> exists z: Zn; prop(z) and z != ZERO
                                        [by discharge given-y-nonzero]
                                      @y-is-zero |
                                        y = ZERO
                                        [using tautology y-nonzero-implies no-nonzero-member]
                                    }
                                  @y-in-implies |
                                    prop(y) -> y = ZERO
                                    [by discharge given-y-in]
                                }
                              @trivial-after-all |
                                forall x: Zn; prop(x) -> x = ZERO
                                [by generalize generalize-y]
                            }
                          @no-nonzero-member-implies-trivial |
                            (not (exists z: Zn; prop(z) and z != ZERO)) -> (forall x: Zn; prop(x) -> x = ZERO)
                            [by discharge given-no-nonzero-member]
                          @nonzero-member-exists |
                            exists z: Zn; prop(z) and z != ZERO
                            [using tautology no-nonzero-member-implies-trivial not-trivial]
                          @with-nonzero-member-z |
                            unpack z: Zn from nonzero-member-exists {
                              @z-facts |
                                prop(z) and z != ZERO
                                [by hypothesis with-nonzero-member-z]
                              @z-in |
                                prop(z)
                                [by and_lhs z-facts]
                              @z-nonzero |
                                z != ZERO
                                [by and_rhs z-facts]
                              @z-has-representative |
                                exists k: Int; z = cls(k)
                                [using specialize mod_n.clsSurjective(z)]
                              @with-representative-a |
                                unpack a: Int from z-has-representative {
                                  @z-is-cls-a |
                                    z = cls(a)
                                    [by hypothesis with-representative-a]
                                  @cls-a-in |
                                    prop(cls(a))
                                    [by rewrite z-is-cls-a z-in]
                                  @cls-a-nonzero |
                                    cls(a) != ZERO
                                    [by rewrite z-is-cls-a z-nonzero]
                                  // N ∤ a, so (N prime) every common divisor of a and N is ±1.
                                  @multiple-would-be-zero |
                                    divides(N, a) -> cls(a) = ZERO
                                    [using specialize multipleOfModulusIsZero(a)]
                                  @n-does-not-divide-a |
                                    not divides(N, a)
                                    [using tautology multiple-would-be-zero cls-a-nonzero]
                                  @common-divisors-are-units |
                                    forall d: Int; divides(d, a) -> divides(d, N) -> (d = INT_ONE or d = int_neg(INT_ONE))
                                    [using specialize primes.coprimalityFromPrime(N, a) n-prime n-does-not-divide-a]
                                  // a ≠ 0 (N | 0) and N ≠ 0 (N > 0), so Bézout applies.
                                  @n-divides-zero |
                                    divides(N, INT_ZERO)
                                    [using specialize int_divides.dividesZero(N)]
                                  @given-a-zero |
                                    assume a = INT_ZERO {
                                      @a-zero |
                                        a = INT_ZERO
                                        [by hypothesis given-a-zero]
                                      @n-divides-a-after-all |
                                        divides(N, a)
                                        [by rewrite a-zero n-divides-zero]
                                    }
                                  @a-zero-implies |
                                    a = INT_ZERO -> divides(N, a)
                                    [by discharge given-a-zero]
                                  @a-nonzero |
                                    a != INT_ZERO
                                    [using tautology a-zero-implies n-does-not-divide-a]
                                  @n-positive |
                                    less_than(INT_ZERO, N)
                                    [using import(mod_n) nPositive]
                                  @zero-not-below-itself |
                                    not less_than(INT_ZERO, INT_ZERO)
                                    [using specialize int_divides.lessThanIrreflexive(INT_ZERO)]
                                  @given-n-zero |
                                    assume N = INT_ZERO {
                                      @n-zero |
                                        N = INT_ZERO
                                        [by hypothesis given-n-zero]
                                      @zero-below-itself |
                                        less_than(INT_ZERO, INT_ZERO)
                                        [by rewrite n-zero n-positive]
                                    }
                                  @n-zero-implies |
                                    N = INT_ZERO -> less_than(INT_ZERO, INT_ZERO)
                                    [by discharge given-n-zero]
                                  @n-nonzero |
                                    N != INT_ZERO
                                    [using tautology n-zero-implies zero-not-below-itself]
                                  @bezout-exists |
                                    exists r: Int; exists s: Int; int_add(int_mul(a, r), int_mul(N, s)) = INT_ONE
                                    [using specialize int_divides.coprimeBezout(a, N) a-nonzero n-nonzero common-divisors-are-units]
                                  @with-bezout-r |
                                    unpack r: Int from bezout-exists {
                                      @s-exists |
                                        exists s: Int; int_add(int_mul(a, r), int_mul(N, s)) = INT_ONE
                                        [by hypothesis with-bezout-r]
                                      @with-bezout-s |
                                        unpack s: Int from s-exists {
                                          @bezout-identity |
                                            int_add(int_mul(a, r), int_mul(N, s)) = INT_ONE
                                            [by hypothesis with-bezout-s]
                                          // cls(1) = cls(ar) + cls(sN) = r·cls(a) + 0.
                                          @one-class-splits |
                                            add(cls(int_mul(a, r)), cls(int_mul(N, s))) = cls(int_add(int_mul(a, r), int_mul(N, s)))
                                            [using specialize mod_n.addHom(int_mul(a, r), int_mul(N, s))]
                                          @one-class-as-sum |
                                            add(cls(int_mul(a, r)), cls(int_mul(N, s))) = cls(INT_ONE)
                                            [by rewrite bezout-identity one-class-splits]
                                          @n-divides-ns |
                                            divides(N, int_mul(N, s))
                                            [using specialize int_divides.dividesMul(N, N, s) n-divides-n]
                                          @n-divides-n |
                                            divides(N, N)
                                            [using specialize int_divides.dividesRefl(N)]
                                          @ns-class-is-zero |
                                            cls(int_mul(N, s)) = ZERO
                                            [using specialize multipleOfModulusIsZero(int_mul(N, s)) n-divides-ns]
                                          @ar-commutes |
                                            int_mul(a, r) = int_mul(r, a)
                                            [using specialize int_divides.mulIsCommutative(a, r)]
                                          @r-multiple-of-cls-a |
                                            znPower(cls(a), r) = cls(int_mul(r, a))
                                            [using specialize mod_n.znPowerDef(a, r)]
                                          @ar-class-is-multiple |
                                            cls(int_mul(a, r)) = znPower(cls(a), r)
                                            [using simplify ar-commutes r-multiple-of-cls-a]
                                          @one-class-as-sum-with-zero |
                                            add(cls(int_mul(a, r)), ZERO) = cls(INT_ONE)
                                            [by rewrite ns-class-is-zero one-class-as-sum]
                                          @one-class-as-multiple-plus-zero |
                                            add(znPower(cls(a), r), ZERO) = cls(INT_ONE)
                                            [by rewrite ar-class-is-multiple one-class-as-sum-with-zero]
                                          @multiple-plus-zero |
                                            add(znPower(cls(a), r), ZERO) = znPower(cls(a), r)
                                            [using specialize mod_n.addIdentityRight(znPower(cls(a), r))]
                                          @one-class-is-multiple-plus-zero |
                                            cls(INT_ONE) = add(znPower(cls(a), r), ZERO)
                                            [by symmetry one-class-as-multiple-plus-zero]
                                          @one-class-is-multiple |
                                            cls(INT_ONE) = znPower(cls(a), r)
                                            [using chain one-class-is-multiple-plus-zero multiple-plus-zero]
                                          @multiples-of-cls-a-in |
                                            forall k: Int; prop(znPower(cls(a), k))
                                            [using specialize closed-under-multiples(cls(a)) cls-a-in]
                                          @r-multiple-in |
                                            prop(znPower(cls(a), r))
                                            [using specialize multiples-of-cls-a-in(r)]
                                          @one-class-in |
                                            prop(cls(INT_ONE))
                                            [by rewrite one-class-is-multiple r-multiple-in]
                                          // cls(1) generates ℤ_N, so everything is in.
                                          @multiples-of-one-in |
                                            forall k: Int; prop(znPower(cls(INT_ONE), k))
                                            [using specialize closed-under-multiples(cls(INT_ONE)) one-class-in]
                                          @generalize-w |
                                            fix w: Zn {
                                              @w-is-a-multiple-of-one |
                                                exists k: Int; w = znPower(cls(INT_ONE), k)
                                                [using specialize mod_n.znIsCyclic(w)]
                                              @with-exponent-k |
                                                unpack k: Int from w-is-a-multiple-of-one {
                                                  @w-is-k-multiple |
                                                    w = znPower(cls(INT_ONE), k)
                                                    [by hypothesis with-exponent-k]
                                                  @k-multiple-in |
                                                    prop(znPower(cls(INT_ONE), k))
                                                    [using specialize multiples-of-one-in(k)]
                                                  @conclusion-w-in |
                                                    prop(w)
                                                    [by rewrite w-is-k-multiple k-multiple-in]
                                                }
                                              @w-in |
                                                prop(w)
                                                [by unpacked with-exponent-k]
                                            }
                                          @everything-in |
                                            forall x: Zn; prop(x)
                                            [by generalize generalize-w]
                                          @conclusion-right |
                                            (forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x))
                                            [by either_rhs everything-in]
                                        }
                                      @conclusion-with-r |
                                        (forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x))
                                        [by unpacked with-bezout-s]
                                    }
                                  @conclusion-with-representative |
                                    (forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x))
                                    [by unpacked with-bezout-r]
                                }
                              @conclusion-with-z |
                                (forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x))
                                [by unpacked with-representative-a]
                            }
                          @conclusion-not-trivial |
                            (forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x))
                            [by unpacked with-nonzero-member-z]
                        }
                    }
                }
              @prime-implies |
                is_prime(N) -> ((forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x)))
                [by discharge given-prime]
            }
          @closed-neg-implies |
            (forall x: Zn; prop(x) -> prop(neg(x))) -> is_prime(N) -> ((forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x)))
            [by discharge given-closed-neg]
        }
      @closed-add-implies |
        (forall x, y: Zn; prop(x) -> prop(y) -> prop(add(x, y))) -> (forall x: Zn; prop(x) -> prop(neg(x))) -> is_prime(N) -> ((forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x)))
        [by discharge given-closed-add]
    }
  @conclusion |
    prop(ZERO) -> (forall x, y: Zn; prop(x) -> prop(y) -> prop(add(x, y))) -> (forall x: Zn; prop(x) -> prop(neg(x))) -> is_prime(N) -> ((forall x: Zn; prop(x) -> x = ZERO) or (forall x: Zn; prop(x)))
    [by discharge given-zero]
qed

// -- the exhibiting instance: an arbitrary subgroup H of ℤ_N --------------------------------
// H is an opaque predicate with the subgroup criterion as its axioms; the schema instantiated
// at it says H = {0} or H = ℤ_N whenever N is prime.
pred inH(x: Zn)
axiom subgroupHasZero: inH(ZERO)
axiom subgroupClosedAdd: forall x, y: Zn; inH(x) -> inH(y) -> inH(add(x, y))
axiom subgroupClosedNeg: forall x: Zn; inH(x) -> inH(neg(x))

theorem primeModulusSubgroupIsTrivialOrEverything: is_prime(N) -> ((forall x: Zn; inH(x) -> x = ZERO) or (forall x: Zn; inH(x)))
proof
  @zero-in-h |
    inH(ZERO)
    [by cite subgroupHasZero]
  @h-closed-add |
    forall x, y: Zn; inH(x) -> inH(y) -> inH(add(x, y))
    [by cite subgroupClosedAdd]
  @h-closed-neg |
    forall x: Zn; inH(x) -> inH(neg(x))
    [by cite subgroupClosedNeg]
  @conclusion |
    is_prime(N) -> ((forall x: Zn; inH(x) -> x = ZERO) or (forall x: Zn; inH(x)))
    [using instantiation primeModulusHasNoProperSubgroups(inH) zero-in-h h-closed-add h-closed-neg]
qed
