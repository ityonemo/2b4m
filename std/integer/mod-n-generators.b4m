// std/integer/mod-n-generators.b4m — WHICH classes generate ℤ_N, and HOW MANY when N = pq
// (Judson §4.1: the corollary "r generates ℤ_n iff gcd(r, n) = 1", and exercise 24).
//
// cls(r) generates ℤ_N iff r is Bézout-coprime to N (r s + N t = 1 for some s, t): the
// identity puts cls(1) = s·cls(r) in ⟨cls(r)⟩, and conversely cls(1) = k·cls(r) IS such an
// identity. For N = pq with p ≠ q prime, cls(r) fails to generate exactly when p | r or
// q | r; the non-generators are listed explicitly — cls(kp) for k < q and cls(kq) for
// 0 < k < p, p + q − 1 in all — so the generators number pq − (p + q − 1) = (p − 1)(q − 1).

theory integer <<< "std/integer.b4m"
theory int_order <<< "std/integer/order.b4m"
theory int_divides <<< "std/integer/divides.b4m"
theory int_embedding <<< "std/integer/embedding.b4m"
theory primes <<< "std/primes.b4m"
theory mod_n <<< "std/integer/mod-n.b4m"
theory mod_n_listing <<< "std/integer/mod-n-listing.b4m"
theory mod_n_prime <<< "std/integer/mod-n-prime.b4m"
theory peano <<< "std/peano.b4m"
theory peano_order <<< "std/peano/order.b4m"
theory permutation_count <<< "std/permutation/count.b4m"

// ℤ
sort Int = integer.Int
const INT_ZERO = integer.ZERO
const INT_ONE = integer.ONE
oper int_add = integer.add
oper int_mul = integer.mul
oper int_sub = integer.sub
oper int_neg = integer.neg
oper int_succ = integer.succ
pred int_less_than = int_order.less_than
pred nonneg = integer.nonneg
define divides(d, k) = int_divides.divides(d, k)
define is_prime(p) = primes.is_prime(p)
fact definitionOfSubtraction = integer.definitionOfSubtraction
fact intLessThanIrreflexive = int_order.lessThanIrreflexive
fact intLessThanTransitive = int_order.lessThanTransitive
fact intZeroLessThanOne = int_order.zeroLessThanOne
fact dividesZero = int_divides.dividesZero
fact dividesAdd = int_divides.dividesAdd
fact dividesMul = int_divides.dividesMul
fact dividesIntro = int_divides.dividesIntro
fact coprimeBezout = int_divides.coprimeBezout
fact coprimalityFromPrime = primes.coprimalityFromPrime
fact primeDoesNotDivideOne = primes.primeDoesNotDivideOne
fact intMulIsAssociative = int_divides.mulIsAssociative
fact intMulIsCommutative = int_divides.mulIsCommutative
fact dividesNeg = int_divides.dividesNeg
fact negOfDifferenceSwaps = int_divides.negOfDifferenceSwaps
fact boundedRemainderDifferenceIsZero = int_divides.boundedRemainderDifferenceIsZero
fact intLessOrEqualIsGapExistential = int_order.lessOrEqualIsGapExistential
fact atMostThenLessThan = int_divides.atMostThenLessThan
fact mulCancelLeft = int_divides.mulCancelLeft
fact divisorAtMost = int_divides.divisorAtMost
fact dividesSubtracts = int_divides.dividesSubtracts
fact divisionAlgorithmExists = int_divides.divisionAlgorithmExists
fact euclidsLemma = primes.euclidsLemma
fact intAddZeroLeft = integer.addZeroLeft
fact intMulZeroLeft = integer.mulZeroLeft
fact succOfNonnegIsPositive = int_divides.succOfNonnegIsPositive
define int_at_most(a, b) = int_order.less_or_equal(a, b)
oper toInt = int_embedding.toInt
fact toIntZero = int_embedding.toIntZero
fact toIntSucc = int_embedding.toIntSucc
fact toIntNonneg = int_embedding.toIntNonneg
fact toIntPreservesOrder = int_embedding.toIntPreservesOrder
fact toIntReflectsOrder = int_embedding.toIntReflectsOrder
fact toIntInjective = int_embedding.toIntInjective
fact everyNonnegIsAnImage = int_embedding.everyNonnegIsAnImage
fact zeroDifferenceMeansEqual = integer.zeroDifferenceMeansEqual
fact lessThanGivesNonnegDifference = int_divides.lessThanGivesNonnegDifference
fact positiveIsNonneg = int_order.positiveIsNonneg
fact toIntAdd = int_embedding.toIntAdd
fact oneIsSuccZero = integer.oneIsSuccZero
fact intAddSuccRight = integer.addSuccRight
fact intAddZeroRight = integer.addZeroRight
fact znIsListedByItsRepresentatives = mod_n_listing.znIsListedByItsRepresentatives
fact znGeneratorsAndNonGeneratorsAreListed = mod_n_listing.znGeneratorsAndNonGeneratorsAreListed
fact znListingsOfTheSameClassHaveEqualLength = mod_n_listing.znListingsOfTheSameClassHaveEqualLength
oper pow = int_divides.pow
fact powZero = int_divides.powZero
fact powSucc = int_divides.powSucc
fact nonnegInduction = int_order.nonnegInduction
fact nonnegSucc = integer.nonnegSucc
fact productWithPositiveIsPositive = int_divides.productWithPositiveIsPositive

// ℕ, the index sort
sort Nat = peano.Nat
const NAT_ZERO = peano.ZERO
oper succ = peano.succ
oper nat_add = peano.add
pred less_than = peano.less_than
fact induction = peano.induction
fact succInjective = peano.succInjective
fact zeroOrSucc = peano.zeroOrSucc
fact addZeroRight = peano.addZeroRight
fact notLessThanZero = peano_order.notLessThanZero
fact lessThanSelf = peano_order.lessThanSelf
fact lessThanSuccSplit = peano_order.lessThanSuccSplit
fact lessThanIrreflexive = peano_order.lessThanIrreflexive
fact trichotomy = peano_order.trichotomy
fact succPreservesOrder = peano_order.succPreservesOrder
fact succReflectsOrder = peano_order.succReflectsOrder
fact additionPreservesOrder = peano_order.additionPreservesOrder
fact indexSplits = permutation_count.indexSplits
fact belowTheBaseIsBelowTheSum = permutation_count.belowTheBaseIsBelowTheSum

// sequences of classes
sort ZnSeq = mod_n_listing.ZnSeq
oper znAt = mod_n_listing.znAt
oper znProductUpTo = mod_n_listing.znProductUpTo
fact znSeqSingleton = mod_n_listing.znSeqSingleton
fact znSeqConcat = mod_n_listing.znSeqConcat

// ℤ_N
sort Zn = mod_n.Zn
oper cls = mod_n.cls
const N = mod_n.N
const ZERO = mod_n.ZERO
oper add = mod_n.add
oper znPower = mod_n.znPower
fact nPositive = mod_n.nPositive
fact clsSurjective = mod_n.clsSurjective
fact clsCongruent = mod_n.clsCongruent
fact addHom = mod_n.addHom
fact znPowerDef = mod_n.znPowerDef
fact zeroIsClsZero = mod_n.zeroIsClsZero
fact addIdentityRight = mod_n.addIdentityRight
fact znIsCyclic = mod_n.znIsCyclic
fact multipleOfModulusIsZero = mod_n_prime.multipleOfModulusIsZero
define generates(z) = mod_n_listing.generates(z)

// r is BÉZOUT-COPRIME to n: r s + n t = 1 for some integers s, t (equivalently gcd(r, n) = 1).
define bezoutCoprime(r, n) = exists s: Int; exists t: Int; int_add(int_mul(r, s), int_mul(n, t)) = INT_ONE

// -- powers of powers in ℤ_N: k·(s·cls(r)) = (k s)·cls(r) ------------------------------------
theorem znPowerOfPower: forall r, s, k: Int; znPower(znPower(cls(r), s), k) = znPower(cls(r), int_mul(k, s))
proof
  @generalize-r |
    fix r: Int {
      @generalize-s |
        fix s: Int {
          @generalize-k |
            fix k: Int {
              @inner |
                znPower(cls(r), s) = cls(int_mul(s, r))
                [using specialize znPowerDef(r, s)]
              @outer-with-inner |
                znPower(znPower(cls(r), s), k) = znPower(cls(int_mul(s, r)), k)
                [by rewrite inner]
              @outer-unfolds |
                znPower(cls(int_mul(s, r)), k) = cls(int_mul(k, int_mul(s, r)))
                [using specialize znPowerDef(int_mul(s, r), k)]
              @regrouped |
                int_mul(k, int_mul(s, r)) = int_mul(int_mul(k, s), r)
                [using polynomial(integer)]
              @outer-as-class |
                znPower(znPower(cls(r), s), k) = cls(int_mul(int_mul(k, s), r))
                [using simplify outer-with-inner outer-unfolds regrouped]
              @combined-power |
                znPower(cls(r), int_mul(k, s)) = cls(int_mul(int_mul(k, s), r))
                [using specialize znPowerDef(r, int_mul(k, s))]
              @combined-power-flipped |
                cls(int_mul(int_mul(k, s), r)) = znPower(cls(r), int_mul(k, s))
                [by symmetry combined-power]
              @conclusion-power-of-power |
                znPower(znPower(cls(r), s), k) = znPower(cls(r), int_mul(k, s))
                [using chain outer-as-class combined-power-flipped]
            }
          @discharge-k |
            forall k: Int; znPower(znPower(cls(r), s), k) = znPower(cls(r), int_mul(k, s))
            [by generalize generalize-k]
        }
      @discharge-s |
        forall s, k: Int; znPower(znPower(cls(r), s), k) = znPower(cls(r), int_mul(k, s))
        [by generalize generalize-s]
    }
  @conclusion |
    forall r, s, k: Int; znPower(znPower(cls(r), s), k) = znPower(cls(r), int_mul(k, s))
    [by generalize generalize-r]
qed

// -- THE GENERATOR CRITERION: cls(r) generates ℤ_N ⟺ r is Bézout-coprime to N --------------
theorem generatesIffBezoutCoprime: forall r: Int; generates(cls(r)) iff bezoutCoprime(r, N)
proof
  @generalize-r |
    fix r: Int {
      // ⟸: cls(1) = cls(r s + N t) = s·cls(r), and cls(1) generates.
      @given-coprime |
        assume bezoutCoprime(r, N) {
          @bezout-exists |
            exists s: Int; exists t: Int; int_add(int_mul(r, s), int_mul(N, t)) = INT_ONE
            [by hypothesis given-coprime]
          @with-bezout-s |
            unpack s: Int from bezout-exists {
              @t-exists |
                exists t: Int; int_add(int_mul(r, s), int_mul(N, t)) = INT_ONE
                [by hypothesis with-bezout-s]
              @with-bezout-t |
                unpack t: Int from t-exists {
                  @bezout-identity |
                    int_add(int_mul(r, s), int_mul(N, t)) = INT_ONE
                    [by hypothesis with-bezout-t]
                  @one-class-splits |
                    add(cls(int_mul(r, s)), cls(int_mul(N, t))) = cls(int_add(int_mul(r, s), int_mul(N, t)))
                    [using specialize addHom(int_mul(r, s), int_mul(N, t))]
                  @one-class-as-sum |
                    add(cls(int_mul(r, s)), cls(int_mul(N, t))) = cls(INT_ONE)
                    [by rewrite bezout-identity one-class-splits]
                  @n-divides-n |
                    divides(N, N)
                    [using specialize int_divides.dividesRefl(N)]
                  @n-divides-nt |
                    divides(N, int_mul(N, t))
                    [using specialize dividesMul(N, N, t) n-divides-n]
                  @nt-class-is-zero |
                    cls(int_mul(N, t)) = ZERO
                    [using specialize multipleOfModulusIsZero(int_mul(N, t)) n-divides-nt]
                  @rs-commutes |
                    int_mul(r, s) = int_mul(s, r)
                    [using specialize intMulIsCommutative(r, s)]
                  @s-multiple |
                    znPower(cls(r), s) = cls(int_mul(s, r))
                    [using specialize znPowerDef(r, s)]
                  @rs-class-is-multiple |
                    cls(int_mul(r, s)) = znPower(cls(r), s)
                    [using simplify rs-commutes s-multiple]
                  @one-class-as-sum-with-zero |
                    add(cls(int_mul(r, s)), ZERO) = cls(INT_ONE)
                    [by rewrite nt-class-is-zero one-class-as-sum]
                  @one-class-as-multiple-plus-zero |
                    add(znPower(cls(r), s), ZERO) = cls(INT_ONE)
                    [by rewrite rs-class-is-multiple one-class-as-sum-with-zero]
                  @multiple-plus-zero |
                    add(znPower(cls(r), s), ZERO) = znPower(cls(r), s)
                    [using specialize addIdentityRight(znPower(cls(r), s))]
                  @one-class-is-multiple-plus-zero |
                    cls(INT_ONE) = add(znPower(cls(r), s), ZERO)
                    [by symmetry one-class-as-multiple-plus-zero]
                  @one-class-is-multiple |
                    cls(INT_ONE) = znPower(cls(r), s)
                    [using chain one-class-is-multiple-plus-zero multiple-plus-zero]
                  @generalize-y |
                    fix y: Zn {
                      @y-is-multiple-of-one |
                        exists k: Int; y = znPower(cls(INT_ONE), k)
                        [using specialize znIsCyclic(y)]
                      @with-exponent-k |
                        unpack k: Int from y-is-multiple-of-one {
                          @y-is-k-multiple-of-one |
                            y = znPower(cls(INT_ONE), k)
                            [by hypothesis with-exponent-k]
                          @y-is-k-multiple-of-s-multiple |
                            y = znPower(znPower(cls(r), s), k)
                            [by rewrite one-class-is-multiple y-is-k-multiple-of-one]
                          @power-of-power |
                            znPower(znPower(cls(r), s), k) = znPower(cls(r), int_mul(k, s))
                            [using specialize znPowerOfPower(r, s, k)]
                          @y-is-multiple-of-r |
                            y = znPower(cls(r), int_mul(k, s))
                            [using chain y-is-k-multiple-of-s-multiple power-of-power]
                          @conclusion-y-generated-inner |
                            exists k2: Int; y = znPower(cls(r), k2)
                            [by witness(int_mul(k, s)) y-is-multiple-of-r]
                        }
                      @conclusion-y-generated |
                        exists k2: Int; y = znPower(cls(r), k2)
                        [by unpacked with-exponent-k]
                    }
                  @conclusion-generates-inner |
                    generates(cls(r))
                    [by generalize generalize-y]
                }
              @conclusion-with-t |
                generates(cls(r))
                [by unpacked with-bezout-t]
            }
          @conclusion-generates |
            generates(cls(r))
            [by unpacked with-bezout-s]
        }
      @backward |
        bezoutCoprime(r, N) -> generates(cls(r))
        [by discharge given-coprime]
      // ⟹: cls(1) = k·cls(r) = cls(k r), so N | 1 − k r, i.e. r k + N t = 1.
      @given-generates |
        assume generates(cls(r)) {
          @generates-r |
            forall y: Zn; exists k: Int; y = znPower(cls(r), k)
            [by hypothesis given-generates]
          @one-generated |
            exists k: Int; cls(INT_ONE) = znPower(cls(r), k)
            [using specialize generates-r(cls(INT_ONE))]
          @with-exponent-k |
            unpack k: Int from one-generated {
              @one-is-k-multiple |
                cls(INT_ONE) = znPower(cls(r), k)
                [by hypothesis with-exponent-k]
              @k-multiple |
                znPower(cls(r), k) = cls(int_mul(k, r))
                [using specialize znPowerDef(r, k)]
              @one-class-is-kr-class |
                cls(INT_ONE) = cls(int_mul(k, r))
                [using chain one-is-k-multiple k-multiple]
              @congruent-iff |
                cls(INT_ONE) = cls(int_mul(k, r)) iff divides(N, int_sub(INT_ONE, int_mul(k, r)))
                [using specialize clsCongruent(INT_ONE, int_mul(k, r))]
              @n-divides-difference |
                divides(N, int_sub(INT_ONE, int_mul(k, r)))
                [using tautology congruent-iff one-class-is-kr-class]
              @with-cofactor-t |
                unpack t: Int from n-divides-difference {
                  @difference-is-nt |
                    int_sub(INT_ONE, int_mul(k, r)) = int_mul(N, t)
                    [by hypothesis with-cofactor-t]
                  @difference-unfolds |
                    int_sub(INT_ONE, int_mul(k, r)) = int_add(INT_ONE, int_neg(int_mul(k, r)))
                    [using specialize definitionOfSubtraction(INT_ONE, int_mul(k, r))]
                  @unfolded-is-difference |
                    int_add(INT_ONE, int_neg(int_mul(k, r))) = int_sub(INT_ONE, int_mul(k, r))
                    [by symmetry difference-unfolds]
                  @unfolded-is-nt |
                    int_add(INT_ONE, int_neg(int_mul(k, r))) = int_mul(N, t)
                    [using chain unfolded-is-difference difference-is-nt]
                  @one-recovered |
                    INT_ONE = int_add(int_mul(r, k), int_add(INT_ONE, int_neg(int_mul(k, r))))
                    [using polynomial(integer)]
                  @one-as-bezout |
                    INT_ONE = int_add(int_mul(r, k), int_mul(N, t))
                    [by rewrite unfolded-is-nt one-recovered]
                  @bezout-identity |
                    int_add(int_mul(r, k), int_mul(N, t)) = INT_ONE
                    [by symmetry one-as-bezout]
                  @t-witnesses |
                    exists t2: Int; int_add(int_mul(r, k), int_mul(N, t2)) = INT_ONE
                    [by witness(t) bezout-identity]
                  @conclusion-coprime-inner |
                    bezoutCoprime(r, N)
                    [by witness(k) t-witnesses]
                }
              @conclusion-with-t |
                bezoutCoprime(r, N)
                [by unpacked with-cofactor-t]
            }
          @conclusion-coprime |
            bezoutCoprime(r, N)
            [by unpacked with-exponent-k]
        }
      @forward |
        generates(cls(r)) -> bezoutCoprime(r, N)
        [by discharge given-generates]
      @conclusion-iff |
        generates(cls(r)) iff bezoutCoprime(r, N)
        [by make_equivalence forward backward]
    }
  @conclusion |
    forall r: Int; generates(cls(r)) iff bezoutCoprime(r, N)
    [by generalize generalize-r]
qed

// -- for N = pq with p ≠ q prime: cls(r) fails to generate ⟺ p | r or q | r ------------------

// a prime is nonzero (it exceeds 1).
theorem primeIsNonzero: forall p: Int; is_prime(p) -> p != INT_ZERO
proof
  @generalize-p |
    fix p: Int {
      @given-prime |
        assume is_prime(p) {
          @prime-facts |
            int_less_than(INT_ONE, p) and (forall d: Int; int_less_than(INT_ZERO, d) -> divides(d, p) -> (d = INT_ONE or d = p))
            [by hypothesis given-prime]
          @one-below-p |
            int_less_than(INT_ONE, p)
            [using tautology prime-facts]
          @zero-below-one |
            int_less_than(INT_ZERO, INT_ONE)
            [by cite intZeroLessThanOne]
          @zero-not-below-itself |
            not int_less_than(INT_ZERO, INT_ZERO)
            [using specialize intLessThanIrreflexive(INT_ZERO)]
          @given-p-zero |
            assume p = INT_ZERO {
              @p-zero |
                p = INT_ZERO
                [by hypothesis given-p-zero]
              @one-below-zero |
                int_less_than(INT_ONE, INT_ZERO)
                [by rewrite p-zero one-below-p]
              @zero-below-itself |
                int_less_than(INT_ZERO, INT_ZERO)
                [using specialize intLessThanTransitive(INT_ZERO, INT_ONE, INT_ZERO) zero-below-one one-below-zero]
            }
          @p-zero-implies |
            p = INT_ZERO -> int_less_than(INT_ZERO, INT_ZERO)
            [by discharge given-p-zero]
          @conclusion-nonzero |
            p != INT_ZERO
            [using tautology p-zero-implies zero-not-below-itself]
        }
      @prime-implies |
        is_prime(p) -> p != INT_ZERO
        [by discharge given-prime]
    }
  @conclusion |
    forall p: Int; is_prime(p) -> p != INT_ZERO
    [by generalize generalize-p]
qed

// p ∤ r ⟹ r is Bézout-coprime to p (the only common divisors are ±1).
theorem primeNotDividingGivesBezout: forall p, r: Int; is_prime(p) -> (not divides(p, r)) -> bezoutCoprime(r, p)
proof
  @generalize-p |
    fix p: Int {
      @generalize-r |
        fix r: Int {
          @given-prime |
            assume is_prime(p) {
              @given-not-dividing |
                assume not divides(p, r) {
                  @prime |
                    is_prime(p)
                    [by hypothesis given-prime]
                  @not-dividing |
                    not divides(p, r)
                    [by hypothesis given-not-dividing]
                  @p-nonzero |
                    p != INT_ZERO
                    [using specialize primeIsNonzero(p) prime]
                  @p-divides-zero |
                    divides(p, INT_ZERO)
                    [using specialize dividesZero(p)]
                  @given-r-zero |
                    assume r = INT_ZERO {
                      @r-zero |
                        r = INT_ZERO
                        [by hypothesis given-r-zero]
                      @p-divides-r |
                        divides(p, r)
                        [by rewrite r-zero p-divides-zero]
                    }
                  @r-zero-implies |
                    r = INT_ZERO -> divides(p, r)
                    [by discharge given-r-zero]
                  @r-nonzero |
                    r != INT_ZERO
                    [using tautology r-zero-implies not-dividing]
                  @common-divisors-are-units |
                    forall e: Int; divides(e, r) -> divides(e, p) -> (e = INT_ONE or e = int_neg(INT_ONE))
                    [using specialize coprimalityFromPrime(p, r) prime not-dividing]
                  @conclusion-bezout |
                    bezoutCoprime(r, p)
                    [using specialize coprimeBezout(r, p) r-nonzero p-nonzero common-divisors-are-units]
                }
              @not-dividing-implies |
                (not divides(p, r)) -> bezoutCoprime(r, p)
                [by discharge given-not-dividing]
            }
          @prime-implies |
            is_prime(p) -> (not divides(p, r)) -> bezoutCoprime(r, p)
            [by discharge given-prime]
        }
      @discharge-r |
        forall r: Int; is_prime(p) -> (not divides(p, r)) -> bezoutCoprime(r, p)
        [by generalize generalize-r]
    }
  @conclusion |
    forall p, r: Int; is_prime(p) -> (not divides(p, r)) -> bezoutCoprime(r, p)
    [by generalize generalize-p]
qed

// Bézout-coprime to p and to q ⟹ Bézout-coprime to pq (multiply the two identities).
theorem bezoutCoprimeMultiplies: forall r, p, q: Int; bezoutCoprime(r, p) -> bezoutCoprime(r, q) -> bezoutCoprime(r, int_mul(p, q))
proof
  @generalize-r |
    fix r: Int {
      @generalize-p |
        fix p: Int {
          @generalize-q |
            fix q: Int {
              @given-p |
                assume bezoutCoprime(r, p) {
                  @given-q |
                    assume bezoutCoprime(r, q) {
                      @p-identity-exists |
                        exists s: Int; exists t: Int; int_add(int_mul(r, s), int_mul(p, t)) = INT_ONE
                        [by hypothesis given-p]
                      @q-identity-exists |
                        exists s: Int; exists t: Int; int_add(int_mul(r, s), int_mul(q, t)) = INT_ONE
                        [by hypothesis given-q]
                      @with-a |
                        unpack a: Int from p-identity-exists {
                          @b-exists |
                            exists t: Int; int_add(int_mul(r, a), int_mul(p, t)) = INT_ONE
                            [by hypothesis with-a]
                          @with-b |
                            unpack b: Int from b-exists {
                              @p-identity |
                                int_add(int_mul(r, a), int_mul(p, b)) = INT_ONE
                                [by hypothesis with-b]
                              @with-c |
                                unpack c: Int from q-identity-exists {
                                  @d-exists |
                                    exists t: Int; int_add(int_mul(r, c), int_mul(q, t)) = INT_ONE
                                    [by hypothesis with-c]
                                  @with-d |
                                    unpack d: Int from d-exists {
                                      @q-identity |
                                        int_add(int_mul(r, c), int_mul(q, d)) = INT_ONE
                                        [by hypothesis with-d]
                                      @product-expands |
                                        int_mul(int_add(int_mul(r, a), int_mul(p, b)), int_add(int_mul(r, c), int_mul(q, d))) = int_add(int_mul(r, int_add(int_add(int_mul(int_mul(a, r), c), int_mul(int_mul(a, q), d)), int_mul(int_mul(p, b), c))), int_mul(int_mul(p, q), int_mul(b, d)))
                                        [using polynomial(integer)]
                                      @product-with-p-identity |
                                        int_mul(INT_ONE, int_add(int_mul(r, c), int_mul(q, d))) = int_add(int_mul(r, int_add(int_add(int_mul(int_mul(a, r), c), int_mul(int_mul(a, q), d)), int_mul(int_mul(p, b), c))), int_mul(int_mul(p, q), int_mul(b, d)))
                                        [by rewrite p-identity product-expands]
                                      @product-of-ones |
                                        int_mul(INT_ONE, INT_ONE) = int_add(int_mul(r, int_add(int_add(int_mul(int_mul(a, r), c), int_mul(int_mul(a, q), d)), int_mul(int_mul(p, b), c))), int_mul(int_mul(p, q), int_mul(b, d)))
                                        [by rewrite q-identity product-with-p-identity]
                                      @one-times-one |
                                        int_mul(INT_ONE, INT_ONE) = INT_ONE
                                        [using specialize integer.mulOneLeft(INT_ONE)]
                                      @combined-flipped |
                                        int_add(int_mul(r, int_add(int_add(int_mul(int_mul(a, r), c), int_mul(int_mul(a, q), d)), int_mul(int_mul(p, b), c))), int_mul(int_mul(p, q), int_mul(b, d))) = int_mul(INT_ONE, INT_ONE)
                                        [by symmetry product-of-ones]
                                      @combined-identity |
                                        int_add(int_mul(r, int_add(int_add(int_mul(int_mul(a, r), c), int_mul(int_mul(a, q), d)), int_mul(int_mul(p, b), c))), int_mul(int_mul(p, q), int_mul(b, d))) = INT_ONE
                                        [using chain combined-flipped one-times-one]
                                      @t-witnesses |
                                        exists t: Int; int_add(int_mul(r, int_add(int_add(int_mul(int_mul(a, r), c), int_mul(int_mul(a, q), d)), int_mul(int_mul(p, b), c))), int_mul(int_mul(p, q), t)) = INT_ONE
                                        [by witness(int_mul(b, d)) combined-identity]
                                      @conclusion-coprime-inner |
                                        bezoutCoprime(r, int_mul(p, q))
                                        [by witness(int_add(int_add(int_mul(int_mul(a, r), c), int_mul(int_mul(a, q), d)), int_mul(int_mul(p, b), c))) t-witnesses]
                                    }
                                  @conclusion-with-d |
                                    bezoutCoprime(r, int_mul(p, q))
                                    [by unpacked with-d]
                                }
                              @conclusion-with-c |
                                bezoutCoprime(r, int_mul(p, q))
                                [by unpacked with-c]
                            }
                          @conclusion-with-b |
                            bezoutCoprime(r, int_mul(p, q))
                            [by unpacked with-b]
                        }
                      @conclusion-with-a |
                        bezoutCoprime(r, int_mul(p, q))
                        [by unpacked with-a]
                    }
                  @q-implies |
                    bezoutCoprime(r, q) -> bezoutCoprime(r, int_mul(p, q))
                    [by discharge given-q]
                }
              @p-implies |
                bezoutCoprime(r, p) -> bezoutCoprime(r, q) -> bezoutCoprime(r, int_mul(p, q))
                [by discharge given-p]
            }
          @discharge-q |
            forall q: Int; bezoutCoprime(r, p) -> bezoutCoprime(r, q) -> bezoutCoprime(r, int_mul(p, q))
            [by generalize generalize-q]
        }
      @discharge-p |
        forall p, q: Int; bezoutCoprime(r, p) -> bezoutCoprime(r, q) -> bezoutCoprime(r, int_mul(p, q))
        [by generalize generalize-p]
    }
  @conclusion |
    forall r, p, q: Int; bezoutCoprime(r, p) -> bezoutCoprime(r, q) -> bezoutCoprime(r, int_mul(p, q))
    [by generalize generalize-r]
qed

// a prime dividing r blocks any Bézout identity r s + pq t = 1 (it would divide 1).
theorem primeFactorBlocksBezout: forall p, q, r: Int; is_prime(p) -> divides(p, r) -> (not bezoutCoprime(r, int_mul(p, q)))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @generalize-r |
            fix r: Int {
              @given-prime |
                assume is_prime(p) {
                  @given-divides |
                    assume divides(p, r) {
                      @prime |
                        is_prime(p)
                        [by hypothesis given-prime]
                      @p-divides-r |
                        divides(p, r)
                        [by hypothesis given-divides]
                      @p-not-dividing-one |
                        not divides(p, INT_ONE)
                        [using specialize primeDoesNotDivideOne(p) prime]
                      @given-bezout |
                        assume bezoutCoprime(r, int_mul(p, q)) {
                          @identity-exists |
                            exists s: Int; exists t: Int; int_add(int_mul(r, s), int_mul(int_mul(p, q), t)) = INT_ONE
                            [by hypothesis given-bezout]
                          @with-s |
                            unpack s: Int from identity-exists {
                              @t-exists |
                                exists t: Int; int_add(int_mul(r, s), int_mul(int_mul(p, q), t)) = INT_ONE
                                [by hypothesis with-s]
                              @with-t |
                                unpack t: Int from t-exists {
                                  @identity |
                                    int_add(int_mul(r, s), int_mul(int_mul(p, q), t)) = INT_ONE
                                    [by hypothesis with-t]
                                  @p-divides-rs |
                                    divides(p, int_mul(r, s))
                                    [using specialize dividesMul(p, r, s) p-divides-r]
                                  @p-divides-p |
                                    divides(p, p)
                                    [using specialize int_divides.dividesRefl(p)]
                                  @p-divides-pq |
                                    divides(p, int_mul(p, q))
                                    [using specialize dividesMul(p, p, q) p-divides-p]
                                  @p-divides-pqt |
                                    divides(p, int_mul(int_mul(p, q), t))
                                    [using specialize dividesMul(p, int_mul(p, q), t) p-divides-pq]
                                  @p-divides-sum |
                                    divides(p, int_add(int_mul(r, s), int_mul(int_mul(p, q), t)))
                                    [using specialize dividesAdd(p, int_mul(r, s), int_mul(int_mul(p, q), t)) p-divides-rs p-divides-pqt]
                                  @conclusion-p-divides-one-inner |
                                    divides(p, INT_ONE)
                                    [by rewrite identity p-divides-sum]
                                }
                              @conclusion-with-t |
                                divides(p, INT_ONE)
                                [by unpacked with-t]
                            }
                          @conclusion-with-s |
                            divides(p, INT_ONE)
                            [by unpacked with-s]
                        }
                      @bezout-implies |
                        bezoutCoprime(r, int_mul(p, q)) -> divides(p, INT_ONE)
                        [by discharge given-bezout]
                      @conclusion-not-bezout |
                        not bezoutCoprime(r, int_mul(p, q))
                        [using tautology bezout-implies p-not-dividing-one]
                    }
                  @divides-implies |
                    divides(p, r) -> (not bezoutCoprime(r, int_mul(p, q)))
                    [by discharge given-divides]
                }
              @prime-implies |
                is_prime(p) -> divides(p, r) -> (not bezoutCoprime(r, int_mul(p, q)))
                [by discharge given-prime]
            }
          @discharge-r |
            forall r: Int; is_prime(p) -> divides(p, r) -> (not bezoutCoprime(r, int_mul(p, q)))
            [by generalize generalize-r]
        }
      @discharge-q |
        forall q, r: Int; is_prime(p) -> divides(p, r) -> (not bezoutCoprime(r, int_mul(p, q)))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q, r: Int; is_prime(p) -> divides(p, r) -> (not bezoutCoprime(r, int_mul(p, q)))
    [by generalize generalize-p]
qed

// THE NON-GENERATORS OF ℤ_pq are the classes of multiples of p or of q.
theorem nonGeneratorIffPrimeDivides: forall p, q: Int; is_prime(p) -> is_prime(q) -> N = int_mul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @given-p-prime |
            assume is_prime(p) {
              @given-q-prime |
                assume is_prime(q) {
                  @given-modulus |
                    assume N = int_mul(p, q) {
                      @p-prime |
                        is_prime(p)
                        [by hypothesis given-p-prime]
                      @q-prime |
                        is_prime(q)
                        [by hypothesis given-q-prime]
                      @modulus |
                        N = int_mul(p, q)
                        [by hypothesis given-modulus]
                      @generalize-r |
                        fix r: Int {
                          @criterion-at-n |
                            generates(cls(r)) iff bezoutCoprime(r, N)
                            [using specialize generatesIffBezoutCoprime(r)]
                          @criterion |
                            generates(cls(r)) iff bezoutCoprime(r, int_mul(p, q))
                            [by rewrite modulus criterion-at-n]
                          // p | r or q | r ⟹ no Bézout identity ⟹ not a generator.
                          @p-blocks |
                            divides(p, r) -> (not bezoutCoprime(r, int_mul(p, q)))
                            [using specialize primeFactorBlocksBezout(p, q, r) p-prime]
                          @q-blocks-swapped |
                            divides(q, r) -> (not bezoutCoprime(r, int_mul(q, p)))
                            [using specialize primeFactorBlocksBezout(q, p, r) q-prime]
                          @factors-commute |
                            int_mul(q, p) = int_mul(p, q)
                            [using specialize intMulIsCommutative(q, p)]
                          @q-blocks |
                            divides(q, r) -> (not bezoutCoprime(r, int_mul(p, q)))
                            [by rewrite factors-commute q-blocks-swapped]
                          // neither divides ⟹ Bézout identities with p and with q ⟹ with pq.
                          @given-neither |
                            assume (not divides(p, r)) and (not divides(q, r)) {
                              @neither |
                                (not divides(p, r)) and (not divides(q, r))
                                [by hypothesis given-neither]
                              @p-not-dividing |
                                not divides(p, r)
                                [by and_lhs neither]
                              @q-not-dividing |
                                not divides(q, r)
                                [by and_rhs neither]
                              @coprime-to-p |
                                bezoutCoprime(r, p)
                                [using specialize primeNotDividingGivesBezout(p, r) p-prime p-not-dividing]
                              @coprime-to-q |
                                bezoutCoprime(r, q)
                                [using specialize primeNotDividingGivesBezout(q, r) q-prime q-not-dividing]
                              @conclusion-coprime-to-product |
                                bezoutCoprime(r, int_mul(p, q))
                                [using specialize bezoutCoprimeMultiplies(r, p, q) coprime-to-p coprime-to-q]
                            }
                          @neither-implies |
                            ((not divides(p, r)) and (not divides(q, r))) -> bezoutCoprime(r, int_mul(p, q))
                            [by discharge given-neither]
                          @conclusion-characterized |
                            (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                            [using tautology criterion p-blocks q-blocks neither-implies]
                        }
                      @discharge-r |
                        forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                        [by generalize generalize-r]
                    }
                  @modulus-implies |
                    N = int_mul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                    [by discharge given-modulus]
                }
              @q-prime-implies |
                is_prime(q) -> N = int_mul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                [by discharge given-q-prime]
            }
          @p-prime-implies |
            is_prime(p) -> is_prime(q) -> N = int_mul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
            [by discharge given-p-prime]
        }
      @discharge-q |
        forall q: Int; is_prime(p) -> is_prime(q) -> N = int_mul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Int; is_prime(p) -> is_prime(q) -> N = int_mul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
    [by generalize generalize-p]
qed

// -- index arithmetic --------------------------------------------------------------------------

// two indices below m whose images differ by a multiple of toInt(m) are equal: the difference
// is a bounded multiple, hence 0.
theorem boundedIndicesWithDivisibleDifferenceAreEqual: forall b: Int; forall m: Nat; toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, int_sub(toInt(i), toInt(j))) -> i = j
proof
  @generalize-b |
    fix b: Int {
      @generalize-m |
        fix m: Nat {
          @given-image |
            assume toInt(m) = b {
              @image |
                toInt(m) = b
                [by hypothesis given-image]
              // the core: for i < j below m, b ∤ toInt(j) − toInt(i) unless they are equal.
              @generalize-i0 |
                fix i0: Nat {
                  @generalize-j0 |
                    fix j0: Nat {
                      @given-i0-below-j0 |
                        assume less_than(i0, j0) {
                          @given-j0-below-m |
                            assume less_than(j0, m) {
                              @given-divides |
                                assume divides(b, int_sub(toInt(j0), toInt(i0))) {
                                  @i0-below-j0 |
                                    less_than(i0, j0)
                                    [by hypothesis given-i0-below-j0]
                                  @j0-below-m |
                                    less_than(j0, m)
                                    [by hypothesis given-j0-below-m]
                                  @b-divides |
                                    divides(b, int_sub(toInt(j0), toInt(i0)))
                                    [by hypothesis given-divides]
                                  @i0-image-nonneg |
                                    nonneg(toInt(i0))
                                    [using specialize toIntNonneg(i0)]
                                  @images-ordered |
                                    int_less_than(toInt(i0), toInt(j0))
                                    [using specialize toIntPreservesOrder(i0, j0) i0-below-j0]
                                  @j0-image-below-b-raw |
                                    int_less_than(toInt(j0), toInt(m))
                                    [using specialize toIntPreservesOrder(j0, m) j0-below-m]
                                  @j0-image-below-b |
                                    int_less_than(toInt(j0), b)
                                    [by rewrite image j0-image-below-b-raw]
                                  // b > 0: 0 ≤ toInt(i0) < toInt(j0) < b.
                                  @zero-plus-image |
                                    int_add(INT_ZERO, toInt(i0)) = toInt(i0)
                                    [using specialize intAddZeroLeft(toInt(i0))]
                                  @gap-witnessed |
                                    nonneg(toInt(i0)) and int_add(INT_ZERO, toInt(i0)) = toInt(i0)
                                    [by both i0-image-nonneg zero-plus-image]
                                  @gap-exists |
                                    exists d: Int; nonneg(d) and int_add(INT_ZERO, d) = toInt(i0)
                                    [by witness(toInt(i0)) gap-witnessed]
                                  @gap-iff |
                                    int_at_most(INT_ZERO, toInt(i0)) iff (exists d: Int; nonneg(d) and int_add(INT_ZERO, d) = toInt(i0))
                                    [using specialize intLessOrEqualIsGapExistential(INT_ZERO, toInt(i0))]
                                  @zero-at-most-i0-image |
                                    int_at_most(INT_ZERO, toInt(i0))
                                    [using tautology gap-iff gap-exists]
                                  @zero-below-j0-image |
                                    int_less_than(INT_ZERO, toInt(j0))
                                    [using specialize atMostThenLessThan(INT_ZERO, toInt(i0), toInt(j0)) zero-at-most-i0-image images-ordered]
                                  @b-positive |
                                    int_less_than(INT_ZERO, b)
                                    [using specialize intLessThanTransitive(INT_ZERO, toInt(j0), b) zero-below-j0-image j0-image-below-b]
                                  @difference-is-zero |
                                    int_sub(toInt(j0), toInt(i0)) = INT_ZERO
                                    [using specialize boundedRemainderDifferenceIsZero(b, toInt(i0), toInt(j0)) b-positive i0-image-nonneg j0-image-below-b images-ordered b-divides]
                                  @images-equal |
                                    toInt(j0) = toInt(i0)
                                    [using specialize zeroDifferenceMeansEqual(toInt(j0), toInt(i0)) difference-is-zero]
                                  @conclusion-indices-equal-core |
                                    j0 = i0
                                    [using specialize toIntInjective(j0, i0) images-equal]
                                }
                              @divides-implies |
                                divides(b, int_sub(toInt(j0), toInt(i0))) -> j0 = i0
                                [by discharge given-divides]
                            }
                          @j0-below-m-implies |
                            less_than(j0, m) -> divides(b, int_sub(toInt(j0), toInt(i0))) -> j0 = i0
                            [by discharge given-j0-below-m]
                        }
                      @i0-below-j0-implies |
                        less_than(i0, j0) -> less_than(j0, m) -> divides(b, int_sub(toInt(j0), toInt(i0))) -> j0 = i0
                        [by discharge given-i0-below-j0]
                    }
                  @discharge-j0 |
                    forall j0: Nat; less_than(i0, j0) -> less_than(j0, m) -> divides(b, int_sub(toInt(j0), toInt(i0))) -> j0 = i0
                    [by generalize generalize-j0]
                }
              @core |
                forall i0: Nat; forall j0: Nat; less_than(i0, j0) -> less_than(j0, m) -> divides(b, int_sub(toInt(j0), toInt(i0))) -> j0 = i0
                [by generalize generalize-i0]
              // trichotomy on the two indices.
              @generalize-i |
                fix i: Nat {
                  @generalize-j |
                    fix j: Nat {
                      @given-i-below-m |
                        assume less_than(i, m) {
                          @given-j-below-m |
                            assume less_than(j, m) {
                              @given-divides |
                                assume divides(b, int_sub(toInt(i), toInt(j))) {
                                  @i-below-m |
                                    less_than(i, m)
                                    [by hypothesis given-i-below-m]
                                  @j-below-m |
                                    less_than(j, m)
                                    [by hypothesis given-j-below-m]
                                  @b-divides-ij |
                                    divides(b, int_sub(toInt(i), toInt(j)))
                                    [by hypothesis given-divides]
                                  @negated-iff |
                                    divides(b, int_sub(toInt(i), toInt(j))) iff divides(b, int_neg(int_sub(toInt(i), toInt(j))))
                                    [using specialize dividesNeg(b, int_sub(toInt(i), toInt(j)))]
                                  @b-divides-negated |
                                    divides(b, int_neg(int_sub(toInt(i), toInt(j))))
                                    [using tautology negated-iff b-divides-ij]
                                  @negation-swaps |
                                    int_neg(int_sub(toInt(i), toInt(j))) = int_sub(toInt(j), toInt(i))
                                    [using specialize negOfDifferenceSwaps(toInt(i), toInt(j))]
                                  @b-divides-ji |
                                    divides(b, int_sub(toInt(j), toInt(i)))
                                    [by rewrite negation-swaps b-divides-negated]
                                  @i-versus-j |
                                    less_than(i, j) or i = j or less_than(j, i)
                                    [using specialize trichotomy(i, j)]
                                  @conclusion-equal |
                                    i = j
                                    case i-versus-j {
                                      @when-below |
                                        assume less_than(i, j) {
                                          @i-below-j |
                                            less_than(i, j)
                                            [by hypothesis when-below]
                                          @j-is-i |
                                            j = i
                                            [using specialize core(i, j) i-below-j j-below-m b-divides-ji]
                                          @conclusion-when-below |
                                            i = j
                                            [by symmetry j-is-i]
                                        }
                                      @when-equal |
                                        assume i = j {
                                          @conclusion-when-equal |
                                            i = j
                                            [by hypothesis when-equal]
                                        }
                                      @when-above |
                                        assume less_than(j, i) {
                                          @j-below-i |
                                            less_than(j, i)
                                            [by hypothesis when-above]
                                          @conclusion-when-above |
                                            i = j
                                            [using specialize core(j, i) j-below-i i-below-m b-divides-ij]
                                        }
                                    }
                                }
                              @divides-implies |
                                divides(b, int_sub(toInt(i), toInt(j))) -> i = j
                                [by discharge given-divides]
                            }
                          @j-below-m-implies |
                            less_than(j, m) -> divides(b, int_sub(toInt(i), toInt(j))) -> i = j
                            [by discharge given-j-below-m]
                        }
                      @i-below-m-implies |
                        less_than(i, m) -> less_than(j, m) -> divides(b, int_sub(toInt(i), toInt(j))) -> i = j
                        [by discharge given-i-below-m]
                    }
                  @discharge-j |
                    forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, int_sub(toInt(i), toInt(j))) -> i = j
                    [by generalize generalize-j]
                }
              @discharge-i |
                forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, int_sub(toInt(i), toInt(j))) -> i = j
                [by generalize generalize-i]
            }
          @image-implies |
            toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, int_sub(toInt(i), toInt(j))) -> i = j
            [by discharge given-image]
        }
      @discharge-m |
        forall m: Nat; toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, int_sub(toInt(i), toInt(j))) -> i = j
        [by generalize generalize-m]
    }
  @conclusion |
    forall b: Int; forall m: Nat; toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, int_sub(toInt(i), toInt(j))) -> i = j
    [by generalize generalize-b]
qed

// the classes of 0·a, 1·a, …, (m−1)·a, listed.
theorem sequenceOfMultiplesExists: forall a: Int; forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(i), a))
proof
  @generalize-a |
    fix a: Int {
      @some-sequence-exists |
        exists s: ZnSeq; znAt(s, NAT_ZERO) = ZERO and znProductUpTo(s, succ(NAT_ZERO)) = ZERO
        [using specialize znSeqSingleton(ZERO)]
      @base-case-proof |
        unpack s0: ZnSeq from some-sequence-exists {
          @vacuous |
            fix i: Nat {
              @nothing-below-zero |
                not less_than(i, NAT_ZERO)
                [using specialize notLessThanZero(i)]
              @conclusion-vacuous-entry |
                less_than(i, NAT_ZERO) -> znAt(s0, i) = cls(int_mul(toInt(i), a))
                [using tautology nothing-below-zero]
            }
          @no-entries |
            forall i: Nat; less_than(i, NAT_ZERO) -> znAt(s0, i) = cls(int_mul(toInt(i), a))
            [by generalize vacuous]
          @conclusion-base-witness |
            exists w: ZnSeq; forall i: Nat; less_than(i, NAT_ZERO) -> znAt(w, i) = cls(int_mul(toInt(i), a))
            [by witness(s0) no-entries]
        }
      @base-case |
        exists w: ZnSeq; forall i: Nat; less_than(i, NAT_ZERO) -> znAt(w, i) = cls(int_mul(toInt(i), a))
        [by unpacked base-case-proof]
      @induction-step |
        fix m: Nat {
          @given-inductive-hypothesis |
            assume exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(i), a)) {
              @inductive-hypothesis |
                exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(i), a))
                [by hypothesis given-inductive-hypothesis]
              @with-prefix-w |
                unpack w: ZnSeq from inductive-hypothesis {
                  @prefix-entries |
                    forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(i), a))
                    [by hypothesis with-prefix-w]
                  @singleton-exists |
                    exists s: ZnSeq; znAt(s, NAT_ZERO) = cls(int_mul(toInt(m), a)) and znProductUpTo(s, succ(NAT_ZERO)) = cls(int_mul(toInt(m), a))
                    [using specialize znSeqSingleton(cls(int_mul(toInt(m), a)))]
                  @with-singleton-s |
                    unpack s: ZnSeq from singleton-exists {
                      @singleton-facts |
                        znAt(s, NAT_ZERO) = cls(int_mul(toInt(m), a)) and znProductUpTo(s, succ(NAT_ZERO)) = cls(int_mul(toInt(m), a))
                        [by hypothesis with-singleton-s]
                      @singleton-head |
                        znAt(s, NAT_ZERO) = cls(int_mul(toInt(m), a))
                        [by and_lhs singleton-facts]
                      @concatenation-exists |
                        exists u: ZnSeq; (forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)) and (forall i: Nat; less_than(i, succ(NAT_ZERO)) -> znAt(u, nat_add(m, i)) = znAt(s, i)) and znProductUpTo(u, nat_add(m, succ(NAT_ZERO))) = add(znProductUpTo(w, m), znProductUpTo(s, succ(NAT_ZERO)))
                        [using specialize znSeqConcat(w, s, m, succ(NAT_ZERO))]
                      @with-concatenation-u |
                        unpack u: ZnSeq from concatenation-exists {
                          @concatenation-facts |
                            (forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)) and (forall i: Nat; less_than(i, succ(NAT_ZERO)) -> znAt(u, nat_add(m, i)) = znAt(s, i)) and znProductUpTo(u, nat_add(m, succ(NAT_ZERO))) = add(znProductUpTo(w, m), znProductUpTo(s, succ(NAT_ZERO)))
                            [by hypothesis with-concatenation-u]
                          @prefix-agrees |
                            forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)
                            [using tautology concatenation-facts]
                          @block-agrees |
                            forall i: Nat; less_than(i, succ(NAT_ZERO)) -> znAt(u, nat_add(m, i)) = znAt(s, i)
                            [using tautology concatenation-facts]
                          @zero-below-one |
                            less_than(NAT_ZERO, succ(NAT_ZERO))
                            [using specialize lessThanSelf(NAT_ZERO)]
                          @u-at-m-plus-zero |
                            znAt(u, nat_add(m, NAT_ZERO)) = znAt(s, NAT_ZERO)
                            [using specialize block-agrees(NAT_ZERO) zero-below-one]
                          @m-plus-zero-is-m |
                            nat_add(m, NAT_ZERO) = m
                            [using specialize addZeroRight(m)]
                          @u-at-m |
                            znAt(u, m) = znAt(s, NAT_ZERO)
                            [by rewrite m-plus-zero-is-m u-at-m-plus-zero]
                          @last-entry |
                            znAt(u, m) = cls(int_mul(toInt(m), a))
                            [using chain u-at-m singleton-head]
                          @generalize-i |
                            fix i: Nat {
                              @given-i-in-range |
                                assume less_than(i, succ(m)) {
                                  @i-in-range |
                                    less_than(i, succ(m))
                                    [by hypothesis given-i-in-range]
                                  @i-splits |
                                    less_than(i, m) or i = m
                                    [using specialize lessThanSuccSplit(i, m) i-in-range]
                                  @conclusion-entry-i |
                                    znAt(u, i) = cls(int_mul(toInt(i), a))
                                    case i-splits {
                                      @when-old |
                                        assume less_than(i, m) {
                                          @i-old |
                                            less_than(i, m)
                                            [by hypothesis when-old]
                                          @entry-is-old-entry |
                                            znAt(u, i) = znAt(w, i)
                                            [using specialize prefix-agrees(i) i-old]
                                          @old-entry |
                                            znAt(w, i) = cls(int_mul(toInt(i), a))
                                            [using specialize prefix-entries(i) i-old]
                                          @conclusion-when-old |
                                            znAt(u, i) = cls(int_mul(toInt(i), a))
                                            [using chain entry-is-old-entry old-entry]
                                        }
                                      @when-new |
                                        assume i = m {
                                          @i-is-m |
                                            i = m
                                            [by hypothesis when-new]
                                          @conclusion-when-new |
                                            znAt(u, i) = cls(int_mul(toInt(i), a))
                                            [by rewrite i-is-m last-entry]
                                        }
                                    }
                                }
                              @conclusion-entry-clause |
                                less_than(i, succ(m)) -> znAt(u, i) = cls(int_mul(toInt(i), a))
                                [by discharge given-i-in-range]
                            }
                          @all-entries |
                            forall i: Nat; less_than(i, succ(m)) -> znAt(u, i) = cls(int_mul(toInt(i), a))
                            [by generalize generalize-i]
                          @conclusion-witness-u |
                            exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(i), a))
                            [by witness(u) all-entries]
                        }
                      @conclusion-with-u |
                        exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(i), a))
                        [by unpacked with-concatenation-u]
                    }
                  @conclusion-with-s |
                    exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(i), a))
                    [by unpacked with-singleton-s]
                }
              @conclusion-step |
                exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(i), a))
                [by unpacked with-prefix-w]
            }
          @induction-step-at-m |
            (exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(i), a))) -> (exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(i), a)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-m |
        forall m: Nat; (exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(i), a))) -> (exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(i), a)))
        [by generalize induction-step]
      @conclusion-all-lengths |
        forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(i), a))
        [using instantiation induction((fun m: Nat => exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(i), a)))) base-case induction-step-for-all-m]
    }
  @conclusion |
    forall a: Int; forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(i), a))
    [by generalize generalize-a]
qed

// the classes of 1·a, 2·a, …, m·a, listed.
theorem sequenceOfShiftedMultiplesExists: forall a: Int; forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a))
proof
  @generalize-a |
    fix a: Int {
      @some-sequence-exists |
        exists s: ZnSeq; znAt(s, NAT_ZERO) = ZERO and znProductUpTo(s, succ(NAT_ZERO)) = ZERO
        [using specialize znSeqSingleton(ZERO)]
      @base-case-proof |
        unpack s0: ZnSeq from some-sequence-exists {
          @vacuous |
            fix i: Nat {
              @nothing-below-zero |
                not less_than(i, NAT_ZERO)
                [using specialize notLessThanZero(i)]
              @conclusion-vacuous-entry |
                less_than(i, NAT_ZERO) -> znAt(s0, i) = cls(int_mul(toInt(succ(i)), a))
                [using tautology nothing-below-zero]
            }
          @no-entries |
            forall i: Nat; less_than(i, NAT_ZERO) -> znAt(s0, i) = cls(int_mul(toInt(succ(i)), a))
            [by generalize vacuous]
          @conclusion-base-witness |
            exists w: ZnSeq; forall i: Nat; less_than(i, NAT_ZERO) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a))
            [by witness(s0) no-entries]
        }
      @base-case |
        exists w: ZnSeq; forall i: Nat; less_than(i, NAT_ZERO) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a))
        [by unpacked base-case-proof]
      @induction-step |
        fix m: Nat {
          @given-inductive-hypothesis |
            assume exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a)) {
              @inductive-hypothesis |
                exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a))
                [by hypothesis given-inductive-hypothesis]
              @with-prefix-w |
                unpack w: ZnSeq from inductive-hypothesis {
                  @prefix-entries |
                    forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a))
                    [by hypothesis with-prefix-w]
                  @singleton-exists |
                    exists s: ZnSeq; znAt(s, NAT_ZERO) = cls(int_mul(toInt(succ(m)), a)) and znProductUpTo(s, succ(NAT_ZERO)) = cls(int_mul(toInt(succ(m)), a))
                    [using specialize znSeqSingleton(cls(int_mul(toInt(succ(m)), a)))]
                  @with-singleton-s |
                    unpack s: ZnSeq from singleton-exists {
                      @singleton-facts |
                        znAt(s, NAT_ZERO) = cls(int_mul(toInt(succ(m)), a)) and znProductUpTo(s, succ(NAT_ZERO)) = cls(int_mul(toInt(succ(m)), a))
                        [by hypothesis with-singleton-s]
                      @singleton-head |
                        znAt(s, NAT_ZERO) = cls(int_mul(toInt(succ(m)), a))
                        [by and_lhs singleton-facts]
                      @concatenation-exists |
                        exists u: ZnSeq; (forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)) and (forall i: Nat; less_than(i, succ(NAT_ZERO)) -> znAt(u, nat_add(m, i)) = znAt(s, i)) and znProductUpTo(u, nat_add(m, succ(NAT_ZERO))) = add(znProductUpTo(w, m), znProductUpTo(s, succ(NAT_ZERO)))
                        [using specialize znSeqConcat(w, s, m, succ(NAT_ZERO))]
                      @with-concatenation-u |
                        unpack u: ZnSeq from concatenation-exists {
                          @concatenation-facts |
                            (forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)) and (forall i: Nat; less_than(i, succ(NAT_ZERO)) -> znAt(u, nat_add(m, i)) = znAt(s, i)) and znProductUpTo(u, nat_add(m, succ(NAT_ZERO))) = add(znProductUpTo(w, m), znProductUpTo(s, succ(NAT_ZERO)))
                            [by hypothesis with-concatenation-u]
                          @prefix-agrees |
                            forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)
                            [using tautology concatenation-facts]
                          @block-agrees |
                            forall i: Nat; less_than(i, succ(NAT_ZERO)) -> znAt(u, nat_add(m, i)) = znAt(s, i)
                            [using tautology concatenation-facts]
                          @zero-below-one |
                            less_than(NAT_ZERO, succ(NAT_ZERO))
                            [using specialize lessThanSelf(NAT_ZERO)]
                          @u-at-m-plus-zero |
                            znAt(u, nat_add(m, NAT_ZERO)) = znAt(s, NAT_ZERO)
                            [using specialize block-agrees(NAT_ZERO) zero-below-one]
                          @m-plus-zero-is-m |
                            nat_add(m, NAT_ZERO) = m
                            [using specialize addZeroRight(m)]
                          @u-at-m |
                            znAt(u, m) = znAt(s, NAT_ZERO)
                            [by rewrite m-plus-zero-is-m u-at-m-plus-zero]
                          @last-entry |
                            znAt(u, m) = cls(int_mul(toInt(succ(m)), a))
                            [using chain u-at-m singleton-head]
                          @generalize-i |
                            fix i: Nat {
                              @given-i-in-range |
                                assume less_than(i, succ(m)) {
                                  @i-in-range |
                                    less_than(i, succ(m))
                                    [by hypothesis given-i-in-range]
                                  @i-splits |
                                    less_than(i, m) or i = m
                                    [using specialize lessThanSuccSplit(i, m) i-in-range]
                                  @conclusion-entry-i |
                                    znAt(u, i) = cls(int_mul(toInt(succ(i)), a))
                                    case i-splits {
                                      @when-old |
                                        assume less_than(i, m) {
                                          @i-old |
                                            less_than(i, m)
                                            [by hypothesis when-old]
                                          @entry-is-old-entry |
                                            znAt(u, i) = znAt(w, i)
                                            [using specialize prefix-agrees(i) i-old]
                                          @old-entry |
                                            znAt(w, i) = cls(int_mul(toInt(succ(i)), a))
                                            [using specialize prefix-entries(i) i-old]
                                          @conclusion-when-old |
                                            znAt(u, i) = cls(int_mul(toInt(succ(i)), a))
                                            [using chain entry-is-old-entry old-entry]
                                        }
                                      @when-new |
                                        assume i = m {
                                          @i-is-m |
                                            i = m
                                            [by hypothesis when-new]
                                          @conclusion-when-new |
                                            znAt(u, i) = cls(int_mul(toInt(succ(i)), a))
                                            [by rewrite i-is-m last-entry]
                                        }
                                    }
                                }
                              @conclusion-entry-clause |
                                less_than(i, succ(m)) -> znAt(u, i) = cls(int_mul(toInt(succ(i)), a))
                                [by discharge given-i-in-range]
                            }
                          @all-entries |
                            forall i: Nat; less_than(i, succ(m)) -> znAt(u, i) = cls(int_mul(toInt(succ(i)), a))
                            [by generalize generalize-i]
                          @conclusion-witness-u |
                            exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(succ(i)), a))
                            [by witness(u) all-entries]
                        }
                      @conclusion-with-u |
                        exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(succ(i)), a))
                        [by unpacked with-concatenation-u]
                    }
                  @conclusion-with-s |
                    exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(succ(i)), a))
                    [by unpacked with-singleton-s]
                }
              @conclusion-step |
                exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(succ(i)), a))
                [by unpacked with-prefix-w]
            }
          @induction-step-at-m |
            (exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a))) -> (exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(succ(i)), a)))
            [by discharge given-inductive-hypothesis]
        }
      @induction-step-for-all-m |
        forall m: Nat; (exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a))) -> (exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(int_mul(toInt(succ(i)), a)))
        [by generalize induction-step]
      @conclusion-all-lengths |
        forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a))
        [using instantiation induction((fun m: Nat => exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a)))) base-case induction-step-for-all-m]
    }
  @conclusion |
    forall a: Int; forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), a))
    [by generalize generalize-a]
qed

// -- congruent multiples of a factor of N have congruent coefficients -------------------------
// N = ab with a > 0: cls(x a) = cls(y a) ⟹ ab | (x − y) a ⟹ b | x − y.
theorem congruentMultiplesHaveCongruentCoefficients: forall a, b: Int; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> forall x, y: Int; cls(int_mul(x, a)) = cls(int_mul(y, a)) -> divides(b, int_sub(x, y))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @given-modulus |
            assume N = int_mul(a, b) {
              @given-a-positive |
                assume int_less_than(INT_ZERO, a) {
                  @modulus |
                    N = int_mul(a, b)
                    [by hypothesis given-modulus]
                  @a-positive |
                    int_less_than(INT_ZERO, a)
                    [by hypothesis given-a-positive]
                  @generalize-x |
                    fix x: Int {
                      @generalize-y |
                        fix y: Int {
                          @given-congruent |
                            assume cls(int_mul(x, a)) = cls(int_mul(y, a)) {
                              @congruent |
                                cls(int_mul(x, a)) = cls(int_mul(y, a))
                                [by hypothesis given-congruent]
                              @congruent-iff |
                                cls(int_mul(x, a)) = cls(int_mul(y, a)) iff divides(N, int_sub(int_mul(x, a), int_mul(y, a)))
                                [using specialize clsCongruent(int_mul(x, a), int_mul(y, a))]
                              @n-divides-difference |
                                divides(N, int_sub(int_mul(x, a), int_mul(y, a)))
                                [using tautology congruent-iff congruent]
                              @ab-divides-difference |
                                divides(int_mul(a, b), int_sub(int_mul(x, a), int_mul(y, a)))
                                [by rewrite modulus n-divides-difference]
                              @with-cofactor-c |
                                unpack c: Int from ab-divides-difference {
                                  @difference-is-abc |
                                    int_sub(int_mul(x, a), int_mul(y, a)) = int_mul(int_mul(a, b), c)
                                    [by hypothesis with-cofactor-c]
                                  @difference-unfolds |
                                    int_sub(int_mul(x, a), int_mul(y, a)) = int_add(int_mul(x, a), int_neg(int_mul(y, a)))
                                    [using specialize definitionOfSubtraction(int_mul(x, a), int_mul(y, a))]
                                  @unfolded-is-difference |
                                    int_add(int_mul(x, a), int_neg(int_mul(y, a))) = int_sub(int_mul(x, a), int_mul(y, a))
                                    [by symmetry difference-unfolds]
                                  @unfolded-is-abc |
                                    int_add(int_mul(x, a), int_neg(int_mul(y, a))) = int_mul(int_mul(a, b), c)
                                    [using chain unfolded-is-difference difference-is-abc]
                                  @factored-left |
                                    int_mul(a, int_add(x, int_neg(y))) = int_add(int_mul(x, a), int_neg(int_mul(y, a)))
                                    [using polynomial(integer)]
                                  @factored-right |
                                    int_mul(int_mul(a, b), c) = int_mul(a, int_mul(b, c))
                                    [using polynomial(integer)]
                                  @scaled-equation |
                                    int_mul(a, int_add(x, int_neg(y))) = int_mul(a, int_mul(b, c))
                                    [using chain factored-left unfolded-is-abc factored-right]
                                  @cancelled |
                                    int_add(x, int_neg(y)) = int_mul(b, c)
                                    [using specialize mulCancelLeft(a, int_add(x, int_neg(y)), int_mul(b, c)) a-positive scaled-equation]
                                  @b-divides-unfolded |
                                    divides(b, int_add(x, int_neg(y)))
                                    [using specialize dividesIntro(int_add(x, int_neg(y)), b, c) cancelled]
                                  @xy-difference-unfolds |
                                    int_sub(x, y) = int_add(x, int_neg(y))
                                    [using specialize definitionOfSubtraction(x, y)]
                                  @conclusion-b-divides |
                                    divides(b, int_sub(x, y))
                                    [by rewrite xy-difference-unfolds b-divides-unfolded]
                                }
                              @conclusion-with-c |
                                divides(b, int_sub(x, y))
                                [by unpacked with-cofactor-c]
                            }
                          @congruent-implies |
                            cls(int_mul(x, a)) = cls(int_mul(y, a)) -> divides(b, int_sub(x, y))
                            [by discharge given-congruent]
                        }
                      @discharge-y |
                        forall y: Int; cls(int_mul(x, a)) = cls(int_mul(y, a)) -> divides(b, int_sub(x, y))
                        [by generalize generalize-y]
                    }
                  @discharge-x |
                    forall x, y: Int; cls(int_mul(x, a)) = cls(int_mul(y, a)) -> divides(b, int_sub(x, y))
                    [by generalize generalize-x]
                }
              @a-positive-implies |
                int_less_than(INT_ZERO, a) -> forall x, y: Int; cls(int_mul(x, a)) = cls(int_mul(y, a)) -> divides(b, int_sub(x, y))
                [by discharge given-a-positive]
            }
          @modulus-implies |
            N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> forall x, y: Int; cls(int_mul(x, a)) = cls(int_mul(y, a)) -> divides(b, int_sub(x, y))
            [by discharge given-modulus]
        }
      @discharge-b |
        forall b: Int; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> forall x, y: Int; cls(int_mul(x, a)) = cls(int_mul(y, a)) -> divides(b, int_sub(x, y))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Int; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> forall x, y: Int; cls(int_mul(x, a)) = cls(int_mul(y, a)) -> divides(b, int_sub(x, y))
    [by generalize generalize-a]
qed

// the listing cls(0·a), …, cls((m−1)·a) does not repeat when N = a·toInt(m), a > 0.
theorem multiplesDoNotRepeat: forall a, b: Int; forall m: Nat; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @generalize-m |
            fix m: Nat {
              @given-modulus |
                assume N = int_mul(a, b) {
                  @given-a-positive |
                    assume int_less_than(INT_ZERO, a) {
                      @given-image |
                        assume toInt(m) = b {
                          @modulus |
                            N = int_mul(a, b)
                            [by hypothesis given-modulus]
                          @a-positive |
                            int_less_than(INT_ZERO, a)
                            [by hypothesis given-a-positive]
                          @image |
                            toInt(m) = b
                            [by hypothesis given-image]
                          @coefficients-congruent |
                            forall x, y: Int; cls(int_mul(x, a)) = cls(int_mul(y, a)) -> divides(b, int_sub(x, y))
                            [using specialize congruentMultiplesHaveCongruentCoefficients(a, b) modulus a-positive]
                          @bounded-indices |
                            forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, int_sub(toInt(i), toInt(j))) -> i = j
                            [using specialize boundedIndicesWithDivisibleDifferenceAreEqual(b, m) image]
                          @generalize-i |
                            fix i: Nat {
                              @generalize-j |
                                fix j: Nat {
                                  @given-i-below |
                                    assume less_than(i, m) {
                                      @given-j-below |
                                        assume less_than(j, m) {
                                          @given-equal-classes |
                                            assume cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) {
                                              @i-below |
                                                less_than(i, m)
                                                [by hypothesis given-i-below]
                                              @j-below |
                                                less_than(j, m)
                                                [by hypothesis given-j-below]
                                              @equal-classes |
                                                cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a))
                                                [by hypothesis given-equal-classes]
                                              @b-divides-difference |
                                                divides(b, int_sub(toInt(i), toInt(j)))
                                                [using specialize coefficients-congruent(toInt(i), toInt(j)) equal-classes]
                                              @conclusion-indices-equal |
                                                i = j
                                                [using specialize bounded-indices(i, j) i-below j-below b-divides-difference]
                                            }
                                          @equal-classes-implies |
                                            cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
                                            [by discharge given-equal-classes]
                                        }
                                      @j-below-implies |
                                        less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
                                        [by discharge given-j-below]
                                    }
                                  @i-below-implies |
                                    less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
                                    [by discharge given-i-below]
                                }
                              @discharge-j |
                                forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
                                [by generalize generalize-j]
                            }
                          @discharge-i |
                            forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
                            [by generalize generalize-i]
                        }
                      @image-implies |
                        toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
                        [by discharge given-image]
                    }
                  @a-positive-implies |
                    int_less_than(INT_ZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
                    [by discharge given-a-positive]
                }
              @modulus-implies |
                N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
                [by discharge given-modulus]
            }
          @discharge-m |
            forall m: Nat; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
            [by generalize generalize-m]
        }
      @discharge-b |
        forall b: Int; forall m: Nat; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Int; forall m: Nat; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
    [by generalize generalize-a]
qed

// the shifted listing cls(1·a), …, cls(m·a) does not repeat when N = a·toInt(m+1), a > 0.
theorem shiftedMultiplesDoNotRepeat: forall a, b: Int; forall m: Nat; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @generalize-m |
            fix m: Nat {
              @given-modulus |
                assume N = int_mul(a, b) {
                  @given-a-positive |
                    assume int_less_than(INT_ZERO, a) {
                      @given-image |
                        assume toInt(succ(m)) = b {
                          @modulus |
                            N = int_mul(a, b)
                            [by hypothesis given-modulus]
                          @a-positive |
                            int_less_than(INT_ZERO, a)
                            [by hypothesis given-a-positive]
                          @image |
                            toInt(succ(m)) = b
                            [by hypothesis given-image]
                          @unshifted |
                            forall i: Nat; forall j: Nat; less_than(i, succ(m)) -> less_than(j, succ(m)) -> cls(int_mul(toInt(i), a)) = cls(int_mul(toInt(j), a)) -> i = j
                            [using specialize multiplesDoNotRepeat(a, b, succ(m)) modulus a-positive image]
                          @generalize-i |
                            fix i: Nat {
                              @generalize-j |
                                fix j: Nat {
                                  @given-i-below |
                                    assume less_than(i, m) {
                                      @given-j-below |
                                        assume less_than(j, m) {
                                          @given-equal-classes |
                                            assume cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) {
                                              @i-below |
                                                less_than(i, m)
                                                [by hypothesis given-i-below]
                                              @j-below |
                                                less_than(j, m)
                                                [by hypothesis given-j-below]
                                              @equal-classes |
                                                cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a))
                                                [by hypothesis given-equal-classes]
                                              @succ-i-below |
                                                less_than(succ(i), succ(m))
                                                [using specialize succPreservesOrder(i, m) i-below]
                                              @succ-j-below |
                                                less_than(succ(j), succ(m))
                                                [using specialize succPreservesOrder(j, m) j-below]
                                              @successors-equal |
                                                succ(i) = succ(j)
                                                [using specialize unshifted(succ(i), succ(j)) succ-i-below succ-j-below equal-classes]
                                              @conclusion-indices-equal |
                                                i = j
                                                [using specialize succInjective(i, j) successors-equal]
                                            }
                                          @equal-classes-implies |
                                            cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
                                            [by discharge given-equal-classes]
                                        }
                                      @j-below-implies |
                                        less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
                                        [by discharge given-j-below]
                                    }
                                  @i-below-implies |
                                    less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
                                    [by discharge given-i-below]
                                }
                              @discharge-j |
                                forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
                                [by generalize generalize-j]
                            }
                          @discharge-i |
                            forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
                            [by generalize generalize-i]
                        }
                      @image-implies |
                        toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
                        [by discharge given-image]
                    }
                  @a-positive-implies |
                    int_less_than(INT_ZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
                    [by discharge given-a-positive]
                }
              @modulus-implies |
                N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
                [by discharge given-modulus]
            }
          @discharge-m |
            forall m: Nat; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
            [by generalize generalize-m]
        }
      @discharge-b |
        forall b: Int; forall m: Nat; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Int; forall m: Nat; N = int_mul(a, b) -> int_less_than(INT_ZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(int_mul(toInt(succ(i)), a)) = cls(int_mul(toInt(succ(j)), a)) -> i = j
    [by generalize generalize-a]
qed

// -- small prime facts -------------------------------------------------------------------------
theorem primeIsPositive: forall p: Int; is_prime(p) -> int_less_than(INT_ZERO, p)
proof
  @generalize-p |
    fix p: Int {
      @given-prime |
        assume is_prime(p) {
          @prime-facts |
            int_less_than(INT_ONE, p) and (forall d: Int; int_less_than(INT_ZERO, d) -> divides(d, p) -> (d = INT_ONE or d = p))
            [by hypothesis given-prime]
          @one-below-p |
            int_less_than(INT_ONE, p)
            [using tautology prime-facts]
          @zero-below-one |
            int_less_than(INT_ZERO, INT_ONE)
            [by cite intZeroLessThanOne]
          @conclusion-positive |
            int_less_than(INT_ZERO, p)
            [using specialize intLessThanTransitive(INT_ZERO, INT_ONE, p) zero-below-one one-below-p]
        }
      @prime-implies |
        is_prime(p) -> int_less_than(INT_ZERO, p)
        [by discharge given-prime]
    }
  @conclusion |
    forall p: Int; is_prime(p) -> int_less_than(INT_ZERO, p)
    [by generalize generalize-p]
qed

// a prime does not divide a different prime (its only positive divisors are 1 and itself).
theorem primeDoesNotDivideAnotherPrime: forall p, q: Int; is_prime(p) -> is_prime(q) -> p != q -> (not divides(p, q))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @given-p-prime |
            assume is_prime(p) {
              @given-q-prime |
                assume is_prime(q) {
                  @given-distinct |
                    assume p != q {
                      @p-prime |
                        is_prime(p)
                        [by hypothesis given-p-prime]
                      @q-prime-facts |
                        int_less_than(INT_ONE, q) and (forall d: Int; int_less_than(INT_ZERO, d) -> divides(d, q) -> (d = INT_ONE or d = q))
                        [by hypothesis given-q-prime]
                      @distinct |
                        p != q
                        [by hypothesis given-distinct]
                      @p-prime-facts |
                        int_less_than(INT_ONE, p) and (forall d: Int; int_less_than(INT_ZERO, d) -> divides(d, p) -> (d = INT_ONE or d = p))
                        [by hypothesis given-p-prime]
                      @one-below-p |
                        int_less_than(INT_ONE, p)
                        [using tautology p-prime-facts]
                      @q-divisors |
                        forall d: Int; int_less_than(INT_ZERO, d) -> divides(d, q) -> (d = INT_ONE or d = q)
                        [using tautology q-prime-facts]
                      @p-positive |
                        int_less_than(INT_ZERO, p)
                        [using specialize primeIsPositive(p) p-prime]
                      @one-not-below-itself |
                        not int_less_than(INT_ONE, INT_ONE)
                        [using specialize intLessThanIrreflexive(INT_ONE)]
                      @given-divides |
                        assume divides(p, q) {
                          @p-divides-q |
                            divides(p, q)
                            [by hypothesis given-divides]
                          @p-is-one-or-q |
                            p = INT_ONE or p = q
                            [using specialize q-divisors(p) p-positive p-divides-q]
                          @p-is-one |
                            p = INT_ONE
                            [using tautology p-is-one-or-q distinct]
                          @one-below-itself |
                            int_less_than(INT_ONE, INT_ONE)
                            [by rewrite p-is-one one-below-p]
                        }
                      @divides-implies |
                        divides(p, q) -> int_less_than(INT_ONE, INT_ONE)
                        [by discharge given-divides]
                      @conclusion-not-dividing |
                        not divides(p, q)
                        [using tautology divides-implies one-not-below-itself]
                    }
                  @distinct-implies |
                    p != q -> (not divides(p, q))
                    [by discharge given-distinct]
                }
              @q-prime-implies |
                is_prime(q) -> p != q -> (not divides(p, q))
                [by discharge given-q-prime]
            }
          @p-prime-implies |
            is_prime(p) -> is_prime(q) -> p != q -> (not divides(p, q))
            [by discharge given-p-prime]
        }
      @discharge-q |
        forall q: Int; is_prime(p) -> is_prime(q) -> p != q -> (not divides(p, q))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Int; is_prime(p) -> is_prime(q) -> p != q -> (not divides(p, q))
    [by generalize generalize-p]
qed

// -- the two parts of the listing never meet: cls(i p) ≠ cls((j+1) q) for j + 1 < p ---------------
// pq | i p − (j+1) q would give p | (j+1) q, so p | j+1 (Euclid; p ∤ q), impossible for 0 < j+1 < p.
theorem multipleOfPIsNotAShiftedMultipleOfQ: forall p, q: Int; forall pm: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @generalize-pm |
            fix pm: Nat {
              @given-p-prime |
                assume is_prime(p) {
                  @given-q-prime |
                    assume is_prime(q) {
                      @given-distinct |
                        assume p != q {
                          @given-modulus |
                            assume N = int_mul(p, q) {
                              @given-image |
                                assume toInt(succ(pm)) = p {
                                  @p-prime |
                                    is_prime(p)
                                    [by hypothesis given-p-prime]
                                  @q-prime |
                                    is_prime(q)
                                    [by hypothesis given-q-prime]
                                  @distinct |
                                    p != q
                                    [by hypothesis given-distinct]
                                  @modulus |
                                    N = int_mul(p, q)
                                    [by hypothesis given-modulus]
                                  @image |
                                    toInt(succ(pm)) = p
                                    [by hypothesis given-image]
                                  @p-positive |
                                    int_less_than(INT_ZERO, p)
                                    [using specialize primeIsPositive(p) p-prime]
                                  @p-not-dividing-q |
                                    not divides(p, q)
                                    [using specialize primeDoesNotDivideAnotherPrime(p, q) p-prime q-prime distinct]
                                  @p-not-below-itself |
                                    not int_less_than(p, p)
                                    [using specialize intLessThanIrreflexive(p)]
                                  @generalize-i |
                                    fix i: Nat {
                                      @generalize-j |
                                        fix j: Nat {
                                          @given-j-below |
                                            assume less_than(j, pm) {
                                              @j-below |
                                                less_than(j, pm)
                                                [by hypothesis given-j-below]
                                              // 0 < toInt(j+1) < p.
                                              @j-image-nonneg |
                                                nonneg(toInt(j))
                                                [using specialize toIntNonneg(j)]
                                              @succ-j-image |
                                                toInt(succ(j)) = int_succ(toInt(j))
                                                [using specialize toIntSucc(j)]
                                              @succ-j-image-positive-raw |
                                                int_less_than(INT_ZERO, int_succ(toInt(j)))
                                                [using specialize succOfNonnegIsPositive(toInt(j)) j-image-nonneg]
                                              @succ-j-image-positive |
                                                int_less_than(INT_ZERO, toInt(succ(j)))
                                                [by rewrite succ-j-image succ-j-image-positive-raw]
                                              @succ-j-below |
                                                less_than(succ(j), succ(pm))
                                                [using specialize succPreservesOrder(j, pm) j-below]
                                              @succ-j-image-below-p-raw |
                                                int_less_than(toInt(succ(j)), toInt(succ(pm)))
                                                [using specialize toIntPreservesOrder(succ(j), succ(pm)) succ-j-below]
                                              @succ-j-image-below-p |
                                                int_less_than(toInt(succ(j)), p)
                                                [by rewrite image succ-j-image-below-p-raw]
                                              @given-equal |
                                                assume cls(int_mul(toInt(i), p)) = cls(int_mul(toInt(succ(j)), q)) {
                                                  @equal |
                                                    cls(int_mul(toInt(i), p)) = cls(int_mul(toInt(succ(j)), q))
                                                    [by hypothesis given-equal]
                                                  @congruent-iff |
                                                    cls(int_mul(toInt(i), p)) = cls(int_mul(toInt(succ(j)), q)) iff divides(N, int_sub(int_mul(toInt(i), p), int_mul(toInt(succ(j)), q)))
                                                    [using specialize clsCongruent(int_mul(toInt(i), p), int_mul(toInt(succ(j)), q))]
                                                  @n-divides |
                                                    divides(N, int_sub(int_mul(toInt(i), p), int_mul(toInt(succ(j)), q)))
                                                    [using tautology congruent-iff equal]
                                                  @pq-divides |
                                                    divides(int_mul(p, q), int_sub(int_mul(toInt(i), p), int_mul(toInt(succ(j)), q)))
                                                    [by rewrite modulus n-divides]
                                                  @with-cofactor-c |
                                                    unpack c: Int from pq-divides {
                                                      @difference-is-pqc |
                                                        int_sub(int_mul(toInt(i), p), int_mul(toInt(succ(j)), q)) = int_mul(int_mul(p, q), c)
                                                        [by hypothesis with-cofactor-c]
                                                      @difference-unfolds |
                                                        int_sub(int_mul(toInt(i), p), int_mul(toInt(succ(j)), q)) = int_add(int_mul(toInt(i), p), int_neg(int_mul(toInt(succ(j)), q)))
                                                        [using specialize definitionOfSubtraction(int_mul(toInt(i), p), int_mul(toInt(succ(j)), q))]
                                                      @unfolded-is-difference |
                                                        int_add(int_mul(toInt(i), p), int_neg(int_mul(toInt(succ(j)), q))) = int_sub(int_mul(toInt(i), p), int_mul(toInt(succ(j)), q))
                                                        [by symmetry difference-unfolds]
                                                      @unfolded-is-pqc |
                                                        int_add(int_mul(toInt(i), p), int_neg(int_mul(toInt(succ(j)), q))) = int_mul(int_mul(p, q), c)
                                                        [using chain unfolded-is-difference difference-is-pqc]
                                                      // (j+1) q = i p − pq c = p (i − q c).
                                                      @shifted-recovered |
                                                        int_mul(toInt(succ(j)), q) = int_add(int_mul(toInt(i), p), int_neg(int_add(int_mul(toInt(i), p), int_neg(int_mul(toInt(succ(j)), q)))))
                                                        [using polynomial(integer)]
                                                      @shifted-as-difference |
                                                        int_mul(toInt(succ(j)), q) = int_add(int_mul(toInt(i), p), int_neg(int_mul(int_mul(p, q), c)))
                                                        [by rewrite unfolded-is-pqc shifted-recovered]
                                                      @factored |
                                                        int_add(int_mul(toInt(i), p), int_neg(int_mul(int_mul(p, q), c))) = int_mul(p, int_add(toInt(i), int_neg(int_mul(q, c))))
                                                        [using polynomial(integer)]
                                                      @shifted-as-multiple-of-p |
                                                        int_mul(toInt(succ(j)), q) = int_mul(p, int_add(toInt(i), int_neg(int_mul(q, c))))
                                                        [using chain shifted-as-difference factored]
                                                      @p-divides-product |
                                                        divides(p, int_mul(toInt(succ(j)), q))
                                                        [using specialize dividesIntro(int_mul(toInt(succ(j)), q), p, int_add(toInt(i), int_neg(int_mul(q, c)))) shifted-as-multiple-of-p]
                                                      @euclid |
                                                        divides(p, toInt(succ(j))) or divides(p, q)
                                                        [using specialize euclidsLemma(toInt(succ(j)), q, p) p-prime p-divides-product]
                                                      @p-divides-shift |
                                                        divides(p, toInt(succ(j)))
                                                        [using tautology euclid p-not-dividing-q]
                                                      @p-at-most-shift |
                                                        int_at_most(p, toInt(succ(j)))
                                                        [using specialize divisorAtMost(p, toInt(succ(j))) p-positive succ-j-image-positive p-divides-shift]
                                                      @conclusion-p-below-itself-inner |
                                                        int_less_than(p, p)
                                                        [using specialize atMostThenLessThan(p, toInt(succ(j)), p) p-at-most-shift succ-j-image-below-p]
                                                    }
                                                  @p-below-itself |
                                                    int_less_than(p, p)
                                                    [by unpacked with-cofactor-c]
                                                }
                                              @equal-implies |
                                                cls(int_mul(toInt(i), p)) = cls(int_mul(toInt(succ(j)), q)) -> int_less_than(p, p)
                                                [by discharge given-equal]
                                              @conclusion-different |
                                                cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
                                                [using tautology equal-implies p-not-below-itself]
                                            }
                                          @j-below-implies |
                                            less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
                                            [by discharge given-j-below]
                                        }
                                      @discharge-j |
                                        forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
                                        [by generalize generalize-j]
                                    }
                                  @discharge-i |
                                    forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
                                    [by generalize generalize-i]
                                }
                              @image-implies |
                                toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
                                [by discharge given-image]
                            }
                          @modulus-implies |
                            N = int_mul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
                            [by discharge given-modulus]
                        }
                      @distinct-implies |
                        p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
                        [by discharge given-distinct]
                    }
                  @q-prime-implies |
                    is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
                    [by discharge given-q-prime]
                }
              @p-prime-implies |
                is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
                [by discharge given-p-prime]
            }
          @discharge-pm |
            forall pm: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
            [by generalize generalize-pm]
        }
      @discharge-q |
        forall q: Int; forall pm: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Int; forall pm: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
    [by generalize generalize-p]
qed

// -- reducing a coefficient modulo the cofactor: cls(c a) = cls(e a) with 0 ≤ e < b when N = ab --
theorem coefficientReducesModCofactor: forall a, b: Int; N = int_mul(a, b) -> int_less_than(INT_ZERO, b) -> forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(int_mul(c, a)) = cls(int_mul(e, a))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @given-modulus |
            assume N = int_mul(a, b) {
              @given-b-positive |
                assume int_less_than(INT_ZERO, b) {
                  @modulus |
                    N = int_mul(a, b)
                    [by hypothesis given-modulus]
                  @b-positive |
                    int_less_than(INT_ZERO, b)
                    [by hypothesis given-b-positive]
                  @generalize-c |
                    fix c: Int {
                      @division |
                        exists q0: Int; exists e: Int; c = int_add(int_mul(b, q0), e) and nonneg(e) and int_less_than(e, b)
                        [using specialize divisionAlgorithmExists(c, b) b-positive]
                      @with-quotient-q0 |
                        unpack q0: Int from division {
                          @remainder-exists |
                            exists e: Int; c = int_add(int_mul(b, q0), e) and nonneg(e) and int_less_than(e, b)
                            [by hypothesis with-quotient-q0]
                          @with-remainder-e |
                            unpack e: Int from remainder-exists {
                              @division-facts |
                                c = int_add(int_mul(b, q0), e) and nonneg(e) and int_less_than(e, b)
                                [by hypothesis with-remainder-e]
                              @c-decomposes |
                                c = int_add(int_mul(b, q0), e)
                                [using tautology division-facts]
                              @e-nonneg |
                                nonneg(e)
                                [using tautology division-facts]
                              @e-below-b |
                                int_less_than(e, b)
                                [using tautology division-facts]
                              @difference-unfolds |
                                int_sub(int_mul(c, a), int_mul(e, a)) = int_add(int_mul(c, a), int_neg(int_mul(e, a)))
                                [using specialize definitionOfSubtraction(int_mul(c, a), int_mul(e, a))]
                              @difference-with-c |
                                int_sub(int_mul(c, a), int_mul(e, a)) = int_add(int_mul(int_add(int_mul(b, q0), e), a), int_neg(int_mul(e, a)))
                                [by rewrite c-decomposes difference-unfolds]
                              @difference-is-multiple |
                                int_add(int_mul(int_add(int_mul(b, q0), e), a), int_neg(int_mul(e, a))) = int_mul(int_mul(a, b), q0)
                                [using polynomial(integer)]
                              @difference-is-abq |
                                int_sub(int_mul(c, a), int_mul(e, a)) = int_mul(int_mul(a, b), q0)
                                [using chain difference-with-c difference-is-multiple]
                              @ab-divides-difference |
                                divides(int_mul(a, b), int_sub(int_mul(c, a), int_mul(e, a)))
                                [using specialize dividesIntro(int_sub(int_mul(c, a), int_mul(e, a)), int_mul(a, b), q0) difference-is-abq]
                              @n-divides-difference |
                                divides(N, int_sub(int_mul(c, a), int_mul(e, a)))
                                [by rewrite modulus ab-divides-difference]
                              @congruent-iff |
                                cls(int_mul(c, a)) = cls(int_mul(e, a)) iff divides(N, int_sub(int_mul(c, a), int_mul(e, a)))
                                [using specialize clsCongruent(int_mul(c, a), int_mul(e, a))]
                              @classes-agree |
                                cls(int_mul(c, a)) = cls(int_mul(e, a))
                                [using tautology congruent-iff n-divides-difference]
                              @e-witnesses |
                                nonneg(e) and int_less_than(e, b) and cls(int_mul(c, a)) = cls(int_mul(e, a))
                                [using tautology e-nonneg e-below-b classes-agree]
                              @conclusion-reduced-inner |
                                exists e2: Int; nonneg(e2) and int_less_than(e2, b) and cls(int_mul(c, a)) = cls(int_mul(e2, a))
                                [by witness(e) e-witnesses]
                            }
                          @conclusion-with-e |
                            exists e2: Int; nonneg(e2) and int_less_than(e2, b) and cls(int_mul(c, a)) = cls(int_mul(e2, a))
                            [by unpacked with-remainder-e]
                        }
                      @conclusion-reduced |
                        exists e2: Int; nonneg(e2) and int_less_than(e2, b) and cls(int_mul(c, a)) = cls(int_mul(e2, a))
                        [by unpacked with-quotient-q0]
                    }
                  @discharge-c |
                    forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(int_mul(c, a)) = cls(int_mul(e, a))
                    [by generalize generalize-c]
                }
              @b-positive-implies |
                int_less_than(INT_ZERO, b) -> forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(int_mul(c, a)) = cls(int_mul(e, a))
                [by discharge given-b-positive]
            }
          @modulus-implies |
            N = int_mul(a, b) -> int_less_than(INT_ZERO, b) -> forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(int_mul(c, a)) = cls(int_mul(e, a))
            [by discharge given-modulus]
        }
      @discharge-b |
        forall b: Int; N = int_mul(a, b) -> int_less_than(INT_ZERO, b) -> forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(int_mul(c, a)) = cls(int_mul(e, a))
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Int; N = int_mul(a, b) -> int_less_than(INT_ZERO, b) -> forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(int_mul(c, a)) = cls(int_mul(e, a))
    [by generalize generalize-a]
qed

// -- every non-generator of ℤ_pq is a listed multiple ----------------------------------------
theorem nonGeneratorIsAListedMultiple: forall p, q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @generalize-pm |
            fix pm: Nat {
              @generalize-qn |
                fix qn: Nat {
                  @given-p-prime |
                    assume is_prime(p) {
                      @given-q-prime |
                        assume is_prime(q) {
                          @given-modulus |
                            assume N = int_mul(p, q) {
                              @given-p-image |
                                assume toInt(succ(pm)) = p {
                                  @given-q-image |
                                    assume toInt(qn) = q {
                                      @p-prime |
                                        is_prime(p)
                                        [by hypothesis given-p-prime]
                                      @q-prime |
                                        is_prime(q)
                                        [by hypothesis given-q-prime]
                                      @modulus |
                                        N = int_mul(p, q)
                                        [by hypothesis given-modulus]
                                      @p-image |
                                        toInt(succ(pm)) = p
                                        [by hypothesis given-p-image]
                                      @q-image |
                                        toInt(qn) = q
                                        [by hypothesis given-q-image]
                                      @p-positive |
                                        int_less_than(INT_ZERO, p)
                                        [using specialize primeIsPositive(p) p-prime]
                                      @q-positive |
                                        int_less_than(INT_ZERO, q)
                                        [using specialize primeIsPositive(q) q-prime]
                                      @factors-commute |
                                        int_mul(p, q) = int_mul(q, p)
                                        [using specialize intMulIsCommutative(p, q)]
                                      @modulus-commuted |
                                        N = int_mul(q, p)
                                        [using chain modulus factors-commute]
                                      @characterization |
                                        forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                                        [using specialize nonGeneratorIffPrimeDivides(p, q) p-prime q-prime modulus]
                                      @reduce-mod-q |
                                        forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, q) and cls(int_mul(c, p)) = cls(int_mul(e, p))
                                        [using specialize coefficientReducesModCofactor(p, q) modulus q-positive]
                                      @reduce-mod-p |
                                        forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, p) and cls(int_mul(c, q)) = cls(int_mul(e, q))
                                        [using specialize coefficientReducesModCofactor(q, p) modulus-commuted p-positive]
                                      @zero-image |
                                        toInt(NAT_ZERO) = INT_ZERO
                                        [by cite toIntZero]
                                      @generalize-z |
                                        fix z: Zn {
                                          @given-non-generator |
                                            assume not generates(z) {
                                              @non-generator |
                                                not generates(z)
                                                [by hypothesis given-non-generator]
                                              @z-has-representative |
                                                exists k: Int; z = cls(k)
                                                [using specialize clsSurjective(z)]
                                              @with-representative-r |
                                                unpack r: Int from z-has-representative {
                                                  @z-is-cls-r |
                                                    z = cls(r)
                                                    [by hypothesis with-representative-r]
                                                  @cls-r-non-generator |
                                                    not generates(cls(r))
                                                    [by rewrite z-is-cls-r non-generator]
                                                  @r-characterized |
                                                    (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                                                    [using specialize characterization(r)]
                                                  @some-prime-divides |
                                                    divides(p, r) or divides(q, r)
                                                    [using tautology r-characterized cls-r-non-generator]
                                                  @conclusion-listed-inner |
                                                    (exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q)))
                                                    case some-prime-divides {
                                                      // p | r: r = p c, reduce c modulo q.
                                                      @when-p-divides |
                                                        assume divides(p, r) {
                                                          @p-divides-r |
                                                            divides(p, r)
                                                            [by hypothesis when-p-divides]
                                                          @with-cofactor-c |
                                                            unpack c: Int from p-divides-r {
                                                              @r-is-pc |
                                                                r = int_mul(p, c)
                                                                [by hypothesis with-cofactor-c]
                                                              @pc-commutes |
                                                                int_mul(p, c) = int_mul(c, p)
                                                                [using specialize intMulIsCommutative(p, c)]
                                                              @r-is-cp |
                                                                r = int_mul(c, p)
                                                                [using chain r-is-pc pc-commutes]
                                                              @reduced |
                                                                exists e: Int; nonneg(e) and int_less_than(e, q) and cls(int_mul(c, p)) = cls(int_mul(e, p))
                                                                [using specialize reduce-mod-q(c)]
                                                              @with-remainder-e |
                                                                unpack e: Int from reduced {
                                                                  @remainder-facts |
                                                                    nonneg(e) and int_less_than(e, q) and cls(int_mul(c, p)) = cls(int_mul(e, p))
                                                                    [by hypothesis with-remainder-e]
                                                                  @e-nonneg |
                                                                    nonneg(e)
                                                                    [using tautology remainder-facts]
                                                                  @e-below-q |
                                                                    int_less_than(e, q)
                                                                    [using tautology remainder-facts]
                                                                  @classes-agree |
                                                                    cls(int_mul(c, p)) = cls(int_mul(e, p))
                                                                    [using tautology remainder-facts]
                                                                  @e-is-an-image |
                                                                    exists k: Nat; toInt(k) = e
                                                                    [using specialize everyNonnegIsAnImage(e) e-nonneg]
                                                                  @with-index-k |
                                                                    unpack k: Nat from e-is-an-image {
                                                                      @k-image |
                                                                        toInt(k) = e
                                                                        [by hypothesis with-index-k]
                                                                      @k-image-below-q |
                                                                        int_less_than(toInt(k), q)
                                                                        [by rewrite k-image e-below-q]
                                                                      @k-image-below-q-image |
                                                                        int_less_than(toInt(k), toInt(qn))
                                                                        [by rewrite q-image k-image-below-q]
                                                                      @k-below-qn |
                                                                        less_than(k, qn)
                                                                        [using specialize toIntReflectsOrder(k, qn) k-image-below-q-image]
                                                                      @z-is-cls-cp |
                                                                        z = cls(int_mul(c, p))
                                                                        [by rewrite r-is-cp z-is-cls-r]
                                                                      @z-is-cls-ep |
                                                                        z = cls(int_mul(e, p))
                                                                        [using chain z-is-cls-cp classes-agree]
                                                                      @z-is-listed |
                                                                        z = cls(int_mul(toInt(k), p))
                                                                        [by rewrite k-image z-is-cls-ep]
                                                                      @k-witnesses |
                                                                        less_than(k, qn) and z = cls(int_mul(toInt(k), p))
                                                                        [by both k-below-qn z-is-listed]
                                                                      @left-disjunct |
                                                                        exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))
                                                                        [by witness(k) k-witnesses]
                                                                      @conclusion-when-p-inner |
                                                                        (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                                        [by either_lhs left-disjunct]
                                                                    }
                                                                  @conclusion-with-k |
                                                                    (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                                    [by unpacked with-index-k]
                                                                }
                                                              @conclusion-with-e |
                                                                (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                                [by unpacked with-remainder-e]
                                                            }
                                                          @conclusion-when-p |
                                                            (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                            [by unpacked with-cofactor-c]
                                                        }
                                                      // q | r: r = q c, reduce c modulo p; a zero remainder is cls(0) = cls(0·p).
                                                      @when-q-divides |
                                                        assume divides(q, r) {
                                                          @q-divides-r |
                                                            divides(q, r)
                                                            [by hypothesis when-q-divides]
                                                          @with-cofactor-c |
                                                            unpack c: Int from q-divides-r {
                                                              @r-is-qc |
                                                                r = int_mul(q, c)
                                                                [by hypothesis with-cofactor-c]
                                                              @qc-commutes |
                                                                int_mul(q, c) = int_mul(c, q)
                                                                [using specialize intMulIsCommutative(q, c)]
                                                              @r-is-cq |
                                                                r = int_mul(c, q)
                                                                [using chain r-is-qc qc-commutes]
                                                              @reduced |
                                                                exists e: Int; nonneg(e) and int_less_than(e, p) and cls(int_mul(c, q)) = cls(int_mul(e, q))
                                                                [using specialize reduce-mod-p(c)]
                                                              @with-remainder-e |
                                                                unpack e: Int from reduced {
                                                                  @remainder-facts |
                                                                    nonneg(e) and int_less_than(e, p) and cls(int_mul(c, q)) = cls(int_mul(e, q))
                                                                    [by hypothesis with-remainder-e]
                                                                  @e-nonneg |
                                                                    nonneg(e)
                                                                    [using tautology remainder-facts]
                                                                  @e-below-p |
                                                                    int_less_than(e, p)
                                                                    [using tautology remainder-facts]
                                                                  @classes-agree |
                                                                    cls(int_mul(c, q)) = cls(int_mul(e, q))
                                                                    [using tautology remainder-facts]
                                                                  @z-is-cls-cq |
                                                                    z = cls(int_mul(c, q))
                                                                    [by rewrite r-is-cq z-is-cls-r]
                                                                  @z-is-cls-eq |
                                                                    z = cls(int_mul(e, q))
                                                                    [using chain z-is-cls-cq classes-agree]
                                                                  @e-is-an-image |
                                                                    exists k: Nat; toInt(k) = e
                                                                    [using specialize everyNonnegIsAnImage(e) e-nonneg]
                                                                  @with-index-k0 |
                                                                    unpack k0: Nat from e-is-an-image {
                                                                      @k0-image |
                                                                        toInt(k0) = e
                                                                        [by hypothesis with-index-k0]
                                                                      @z-is-k0-multiple |
                                                                        z = cls(int_mul(toInt(k0), q))
                                                                        [by rewrite k0-image z-is-cls-eq]
                                                                      @k0-zero-or-succ |
                                                                        k0 = NAT_ZERO or (exists k: Nat; k0 = succ(k))
                                                                        [using specialize zeroOrSucc(k0)]
                                                                      @conclusion-when-q-inner |
                                                                        (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                                        case k0-zero-or-succ {
                                                                          @when-zero |
                                                                            assume k0 = NAT_ZERO {
                                                                              @k0-zero |
                                                                                k0 = NAT_ZERO
                                                                                [by hypothesis when-zero]
                                                                              @z-is-zero-multiple-of-q |
                                                                                z = cls(int_mul(toInt(NAT_ZERO), q))
                                                                                [by rewrite k0-zero z-is-k0-multiple]
                                                                              @z-is-cls-zero-times-q |
                                                                                z = cls(int_mul(INT_ZERO, q))
                                                                                [by rewrite zero-image z-is-zero-multiple-of-q]
                                                                              @zero-times-q |
                                                                                int_mul(INT_ZERO, q) = INT_ZERO
                                                                                [using specialize intMulZeroLeft(q)]
                                                                              @z-is-cls-zero |
                                                                                z = cls(INT_ZERO)
                                                                                [by rewrite zero-times-q z-is-cls-zero-times-q]
                                                                              @zero-times-p |
                                                                                int_mul(INT_ZERO, p) = INT_ZERO
                                                                                [using specialize intMulZeroLeft(p)]
                                                                              @zero-is-zero-times-p |
                                                                                INT_ZERO = int_mul(INT_ZERO, p)
                                                                                [by symmetry zero-times-p]
                                                                              @z-is-cls-zero-times-p |
                                                                                z = cls(int_mul(INT_ZERO, p))
                                                                                [by rewrite zero-is-zero-times-p z-is-cls-zero]
                                                                              @z-is-zero-multiple-of-p |
                                                                                z = cls(int_mul(toInt(NAT_ZERO), p))
                                                                                [by rewrite zero-image z-is-cls-zero-times-p]
                                                                              @zero-image-below-q |
                                                                                int_less_than(toInt(NAT_ZERO), q)
                                                                                [by rewrite zero-image q-positive]
                                                                              @zero-image-below-q-image |
                                                                                int_less_than(toInt(NAT_ZERO), toInt(qn))
                                                                                [by rewrite q-image zero-image-below-q]
                                                                              @zero-below-qn |
                                                                                less_than(NAT_ZERO, qn)
                                                                                [using specialize toIntReflectsOrder(NAT_ZERO, qn) zero-image-below-q-image]
                                                                              @zero-witnesses |
                                                                                less_than(NAT_ZERO, qn) and z = cls(int_mul(toInt(NAT_ZERO), p))
                                                                                [by both zero-below-qn z-is-zero-multiple-of-p]
                                                                              @left-disjunct |
                                                                                exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))
                                                                                [by witness(NAT_ZERO) zero-witnesses]
                                                                              @conclusion-when-zero |
                                                                                (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                                                [by either_lhs left-disjunct]
                                                                            }
                                                                          @when-succ |
                                                                            assume exists k: Nat; k0 = succ(k) {
                                                                              @predecessor-exists |
                                                                                exists k: Nat; k0 = succ(k)
                                                                                [by hypothesis when-succ]
                                                                              @with-predecessor-k |
                                                                                unpack k: Nat from predecessor-exists {
                                                                                  @k0-is-succ-k |
                                                                                    k0 = succ(k)
                                                                                    [by hypothesis with-predecessor-k]
                                                                                  @z-is-succ-k-multiple |
                                                                                    z = cls(int_mul(toInt(succ(k)), q))
                                                                                    [by rewrite k0-is-succ-k z-is-k0-multiple]
                                                                                  @succ-k-image |
                                                                                    toInt(succ(k)) = e
                                                                                    [by rewrite k0-is-succ-k k0-image]
                                                                                  @succ-k-image-below-p |
                                                                                    int_less_than(toInt(succ(k)), p)
                                                                                    [by rewrite succ-k-image e-below-p]
                                                                                  @succ-k-image-below-p-image |
                                                                                    int_less_than(toInt(succ(k)), toInt(succ(pm)))
                                                                                    [by rewrite p-image succ-k-image-below-p]
                                                                                  @succ-k-below-succ-pm |
                                                                                    less_than(succ(k), succ(pm))
                                                                                    [using specialize toIntReflectsOrder(succ(k), succ(pm)) succ-k-image-below-p-image]
                                                                                  @k-below-pm |
                                                                                    less_than(k, pm)
                                                                                    [using specialize succReflectsOrder(k, pm) succ-k-below-succ-pm]
                                                                                  @k-witnesses |
                                                                                    less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))
                                                                                    [by both k-below-pm z-is-succ-k-multiple]
                                                                                  @right-disjunct |
                                                                                    exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q))
                                                                                    [by witness(k) k-witnesses]
                                                                                  @conclusion-when-succ-inner |
                                                                                    (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                                                    [by either_rhs right-disjunct]
                                                                                }
                                                                              @conclusion-when-succ |
                                                                                (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                                                [by unpacked with-predecessor-k]
                                                                            }
                                                                        }
                                                                    }
                                                                  @conclusion-with-k0 |
                                                                    (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                                    [by unpacked with-index-k0]
                                                                }
                                                              @conclusion-with-e |
                                                                (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                                [by unpacked with-remainder-e]
                                                            }
                                                          @conclusion-when-q |
                                                            (exists k2: Nat; less_than(k2, qn) and z = cls(int_mul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(int_mul(toInt(succ(k2)), q)))
                                                            [by unpacked with-cofactor-c]
                                                        }
                                                    }
                                                }
                                              @conclusion-listed |
                                                (exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q)))
                                                [by unpacked with-representative-r]
                                            }
                                          @non-generator-implies |
                                            (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
                                            [by discharge given-non-generator]
                                        }
                                      @discharge-z |
                                        forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
                                        [by generalize generalize-z]
                                    }
                                  @q-image-implies |
                                    toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
                                    [by discharge given-q-image]
                                }
                              @p-image-implies |
                                toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
                                [by discharge given-p-image]
                            }
                          @modulus-implies |
                            N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
                            [by discharge given-modulus]
                        }
                      @q-prime-implies |
                        is_prime(q) -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
                        [by discharge given-q-prime]
                    }
                  @p-prime-implies |
                    is_prime(p) -> is_prime(q) -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
                    [by discharge given-p-prime]
                }
              @discharge-qn |
                forall qn: Nat; is_prime(p) -> is_prime(q) -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
                [by generalize generalize-qn]
            }
          @discharge-pm |
            forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
            [by generalize generalize-pm]
        }
      @discharge-q |
        forall q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
    [by generalize generalize-p]
qed

// -- entries of a concatenation, by index -----------------------------------------------------
theorem concatenationEntries: forall w1: ZnSeq; forall w2: ZnSeq; forall m1: Nat; forall m2: Nat; forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nat_add(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nat_add(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)))
proof
  @generalize-w1 |
    fix w1: ZnSeq {
      @generalize-w2 |
        fix w2: ZnSeq {
          @generalize-m1 |
            fix m1: Nat {
              @generalize-m2 |
                fix m2: Nat {
                  @generalize-u |
                    fix u: ZnSeq {
                      @given-prefix |
                        assume forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i) {
                          @given-block |
                            assume forall i: Nat; less_than(i, m2) -> znAt(u, nat_add(m1, i)) = znAt(w2, i) {
                              @prefix |
                                forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)
                                [by hypothesis given-prefix]
                              @block |
                                forall i: Nat; less_than(i, m2) -> znAt(u, nat_add(m1, i)) = znAt(w2, i)
                                [by hypothesis given-block]
                              @generalize-j |
                                fix j: Nat {
                                  @given-j-below |
                                    assume less_than(j, nat_add(m1, m2)) {
                                      @j-below |
                                        less_than(j, nat_add(m1, m2))
                                        [by hypothesis given-j-below]
                                      @j-splits |
                                        less_than(j, m1) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i))
                                        [using specialize indexSplits(m1, m2, j) j-below]
                                      @conclusion-entry |
                                        (less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i))
                                        case j-splits {
                                          @when-prefix |
                                            assume less_than(j, m1) {
                                              @j-in-prefix |
                                                less_than(j, m1)
                                                [by hypothesis when-prefix]
                                              @entry-from-prefix |
                                                znAt(u, j) = znAt(w1, j)
                                                [using specialize prefix(j) j-in-prefix]
                                              @prefix-witnessed |
                                                less_than(j, m1) and znAt(u, j) = znAt(w1, j)
                                                [by both j-in-prefix entry-from-prefix]
                                              @conclusion-when-prefix |
                                                (less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i))
                                                [by either_lhs prefix-witnessed]
                                            }
                                          @when-block |
                                            assume exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) {
                                              @offset-exists |
                                                exists i: Nat; less_than(i, m2) and j = nat_add(m1, i)
                                                [by hypothesis when-block]
                                              @with-offset-i |
                                                unpack i: Nat from offset-exists {
                                                  @offset-facts |
                                                    less_than(i, m2) and j = nat_add(m1, i)
                                                    [by hypothesis with-offset-i]
                                                  @i-below |
                                                    less_than(i, m2)
                                                    [by and_lhs offset-facts]
                                                  @j-is-offset |
                                                    j = nat_add(m1, i)
                                                    [by and_rhs offset-facts]
                                                  @entry-from-block-raw |
                                                    znAt(u, nat_add(m1, i)) = znAt(w2, i)
                                                    [using specialize block(i) i-below]
                                                  @entry-from-block |
                                                    znAt(u, j) = znAt(w2, i)
                                                    [by rewrite j-is-offset entry-from-block-raw]
                                                  @block-witnessed |
                                                    less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)
                                                    [using tautology i-below j-is-offset entry-from-block]
                                                  @conclusion-when-block-inner |
                                                    (less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i2: Nat; less_than(i2, m2) and j = nat_add(m1, i2) and znAt(u, j) = znAt(w2, i2))
                                                    [by either_rhs block-exists]
                                                  @block-exists |
                                                    exists i2: Nat; less_than(i2, m2) and j = nat_add(m1, i2) and znAt(u, j) = znAt(w2, i2)
                                                    [by witness(i) block-witnessed]
                                                }
                                              @conclusion-when-block |
                                                (less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i2: Nat; less_than(i2, m2) and j = nat_add(m1, i2) and znAt(u, j) = znAt(w2, i2))
                                                [by unpacked with-offset-i]
                                            }
                                        }
                                    }
                                  @j-below-implies |
                                    less_than(j, nat_add(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)))
                                    [by discharge given-j-below]
                                }
                              @discharge-j |
                                forall j: Nat; less_than(j, nat_add(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)))
                                [by generalize generalize-j]
                            }
                          @block-implies |
                            (forall i: Nat; less_than(i, m2) -> znAt(u, nat_add(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nat_add(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)))
                            [by discharge given-block]
                        }
                      @prefix-implies |
                        (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nat_add(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nat_add(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)))
                        [by discharge given-prefix]
                    }
                  @discharge-u |
                    forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nat_add(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nat_add(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)))
                    [by generalize generalize-u]
                }
              @discharge-m2 |
                forall m2: Nat; forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nat_add(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nat_add(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)))
                [by generalize generalize-m2]
            }
          @discharge-m1 |
            forall m1: Nat; forall m2: Nat; forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nat_add(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nat_add(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)))
            [by generalize generalize-m1]
        }
      @discharge-w2 |
        forall w2: ZnSeq; forall m1: Nat; forall m2: Nat; forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nat_add(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nat_add(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)))
        [by generalize generalize-w2]
    }
  @conclusion |
    forall w1: ZnSeq; forall w2: ZnSeq; forall m1: Nat; forall m2: Nat; forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nat_add(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nat_add(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nat_add(m1, i) and znAt(u, j) = znAt(w2, i)))
    [by generalize generalize-w1]
qed

// -- THE NON-GENERATORS OF ℤ_pq, LISTED: cls(kp) for k < q, then cls(kq) for 0 < k < p ------------
// q + (p − 1) entries, no repetition (within each part by the bounded-difference lemma, across
// the parts because p ∤ k for 0 < k < p), and every non-generator appears.
theorem nonGeneratorsOfZpqAreListed: forall p, q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z)
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @generalize-pm |
            fix pm: Nat {
              @generalize-qn |
                fix qn: Nat {
                  @given-p-prime |
                    assume is_prime(p) {
                      @given-q-prime |
                        assume is_prime(q) {
                          @given-distinct |
                            assume p != q {
                              @given-modulus |
                                assume N = int_mul(p, q) {
                                  @given-p-image |
                                    assume toInt(succ(pm)) = p {
                                      @given-q-image |
                                        assume toInt(qn) = q {
                                          @p-prime |
                                            is_prime(p)
                                            [by hypothesis given-p-prime]
                                          @q-prime |
                                            is_prime(q)
                                            [by hypothesis given-q-prime]
                                          @distinct |
                                            p != q
                                            [by hypothesis given-distinct]
                                          @modulus |
                                            N = int_mul(p, q)
                                            [by hypothesis given-modulus]
                                          @p-image |
                                            toInt(succ(pm)) = p
                                            [by hypothesis given-p-image]
                                          @q-image |
                                            toInt(qn) = q
                                            [by hypothesis given-q-image]
                                          @p-positive |
                                            int_less_than(INT_ZERO, p)
                                            [using specialize primeIsPositive(p) p-prime]
                                          @q-positive |
                                            int_less_than(INT_ZERO, q)
                                            [using specialize primeIsPositive(q) q-prime]
                                          @factors-commute |
                                            int_mul(p, q) = int_mul(q, p)
                                            [using specialize intMulIsCommutative(p, q)]
                                          @modulus-commuted |
                                            N = int_mul(q, p)
                                            [using chain modulus factors-commute]
                                          @characterization |
                                            forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                                            [using specialize nonGeneratorIffPrimeDivides(p, q) p-prime q-prime modulus]
                                          @coverage |
                                            forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))))
                                            [using specialize nonGeneratorIsAListedMultiple(p, q, pm, qn) p-prime q-prime modulus p-image q-image]
                                          @parts-never-meet |
                                            forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j)), q))
                                            [using specialize multipleOfPIsNotAShiftedMultipleOfQ(p, q, pm) p-prime q-prime distinct modulus p-image]
                                          @first-part-injective |
                                            forall i: Nat; forall j: Nat; less_than(i, qn) -> less_than(j, qn) -> cls(int_mul(toInt(i), p)) = cls(int_mul(toInt(j), p)) -> i = j
                                            [using specialize multiplesDoNotRepeat(p, q, qn) modulus p-positive q-image]
                                          @second-part-injective |
                                            forall i: Nat; forall j: Nat; less_than(i, pm) -> less_than(j, pm) -> cls(int_mul(toInt(succ(i)), q)) = cls(int_mul(toInt(succ(j)), q)) -> i = j
                                            [using specialize shiftedMultiplesDoNotRepeat(q, p, pm) modulus-commuted q-positive p-image]
                                          @first-part-exists |
                                            exists w: ZnSeq; forall i: Nat; less_than(i, qn) -> znAt(w, i) = cls(int_mul(toInt(i), p))
                                            [using specialize sequenceOfMultiplesExists(p, qn)]
                                          @second-part-exists |
                                            exists w: ZnSeq; forall i: Nat; less_than(i, pm) -> znAt(w, i) = cls(int_mul(toInt(succ(i)), q))
                                            [using specialize sequenceOfShiftedMultiplesExists(q, pm)]
                                          @with-first-part-w1 |
                                            unpack w1: ZnSeq from first-part-exists {
                                              @w1-entries |
                                                forall i: Nat; less_than(i, qn) -> znAt(w1, i) = cls(int_mul(toInt(i), p))
                                                [by hypothesis with-first-part-w1]
                                              @with-second-part-w2 |
                                                unpack w2: ZnSeq from second-part-exists {
                                                  @w2-entries |
                                                    forall i: Nat; less_than(i, pm) -> znAt(w2, i) = cls(int_mul(toInt(succ(i)), q))
                                                    [by hypothesis with-second-part-w2]
                                                  @concatenation-exists |
                                                    exists u: ZnSeq; (forall i: Nat; less_than(i, qn) -> znAt(u, i) = znAt(w1, i)) and (forall i: Nat; less_than(i, pm) -> znAt(u, nat_add(qn, i)) = znAt(w2, i)) and znProductUpTo(u, nat_add(qn, pm)) = add(znProductUpTo(w1, qn), znProductUpTo(w2, pm))
                                                    [using specialize znSeqConcat(w1, w2, qn, pm)]
                                                  @with-concatenation-u |
                                                    unpack u: ZnSeq from concatenation-exists {
                                                      @concatenation-facts |
                                                        (forall i: Nat; less_than(i, qn) -> znAt(u, i) = znAt(w1, i)) and (forall i: Nat; less_than(i, pm) -> znAt(u, nat_add(qn, i)) = znAt(w2, i)) and znProductUpTo(u, nat_add(qn, pm)) = add(znProductUpTo(w1, qn), znProductUpTo(w2, pm))
                                                        [by hypothesis with-concatenation-u]
                                                      @prefix-agrees |
                                                        forall i: Nat; less_than(i, qn) -> znAt(u, i) = znAt(w1, i)
                                                        [using tautology concatenation-facts]
                                                      @block-agrees |
                                                        forall i: Nat; less_than(i, pm) -> znAt(u, nat_add(qn, i)) = znAt(w2, i)
                                                        [using tautology concatenation-facts]
                                                      @entries-by-index |
                                                        forall j: Nat; less_than(j, nat_add(qn, pm)) -> ((less_than(j, qn) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = znAt(w2, i)))
                                                        [using specialize concatenationEntries(w1, w2, qn, pm, u) prefix-agrees block-agrees]
                                                      // the entry at j, in closed form.
                                                      @generalize-j-form |
                                                        fix j: Nat {
                                                          @given-j-below-form |
                                                            assume less_than(j, nat_add(qn, pm)) {
                                                              @j-below-form |
                                                                less_than(j, nat_add(qn, pm))
                                                                [by hypothesis given-j-below-form]
                                                              @j-entry |
                                                                (less_than(j, qn) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = znAt(w2, i))
                                                                [using specialize entries-by-index(j) j-below-form]
                                                              @conclusion-j-form |
                                                                (less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))) or (exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = cls(int_mul(toInt(succ(i)), q)))
                                                                case j-entry {
                                                                  @when-first |
                                                                    assume less_than(j, qn) and znAt(u, j) = znAt(w1, j) {
                                                                      @first-facts |
                                                                        less_than(j, qn) and znAt(u, j) = znAt(w1, j)
                                                                        [by hypothesis when-first]
                                                                      @j-below-qn |
                                                                        less_than(j, qn)
                                                                        [by and_lhs first-facts]
                                                                      @u-j-is-w1-j |
                                                                        znAt(u, j) = znAt(w1, j)
                                                                        [by and_rhs first-facts]
                                                                      @w1-j |
                                                                        znAt(w1, j) = cls(int_mul(toInt(j), p))
                                                                        [using specialize w1-entries(j) j-below-qn]
                                                                      @u-j-closed |
                                                                        znAt(u, j) = cls(int_mul(toInt(j), p))
                                                                        [using chain u-j-is-w1-j w1-j]
                                                                      @first-closed |
                                                                        less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))
                                                                        [by both j-below-qn u-j-closed]
                                                                      @conclusion-when-first |
                                                                        (less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))) or (exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = cls(int_mul(toInt(succ(i)), q)))
                                                                        [by either_lhs first-closed]
                                                                    }
                                                                  @when-second |
                                                                    assume exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = znAt(w2, i) {
                                                                      @second-exists |
                                                                        exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = znAt(w2, i)
                                                                        [by hypothesis when-second]
                                                                      @with-offset-i |
                                                                        unpack i: Nat from second-exists {
                                                                          @second-facts |
                                                                            less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = znAt(w2, i)
                                                                            [by hypothesis with-offset-i]
                                                                          @i-below-pm |
                                                                            less_than(i, pm)
                                                                            [using tautology second-facts]
                                                                          @j-is-offset |
                                                                            j = nat_add(qn, i)
                                                                            [using tautology second-facts]
                                                                          @u-j-is-w2-i |
                                                                            znAt(u, j) = znAt(w2, i)
                                                                            [using tautology second-facts]
                                                                          @w2-i |
                                                                            znAt(w2, i) = cls(int_mul(toInt(succ(i)), q))
                                                                            [using specialize w2-entries(i) i-below-pm]
                                                                          @u-j-closed |
                                                                            znAt(u, j) = cls(int_mul(toInt(succ(i)), q))
                                                                            [using chain u-j-is-w2-i w2-i]
                                                                          @second-closed |
                                                                            less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = cls(int_mul(toInt(succ(i)), q))
                                                                            [using tautology i-below-pm j-is-offset u-j-closed]
                                                                          @second-closed-exists |
                                                                            exists i2: Nat; less_than(i2, pm) and j = nat_add(qn, i2) and znAt(u, j) = cls(int_mul(toInt(succ(i2)), q))
                                                                            [by witness(i) second-closed]
                                                                          @conclusion-when-second-inner |
                                                                            (less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))) or (exists i2: Nat; less_than(i2, pm) and j = nat_add(qn, i2) and znAt(u, j) = cls(int_mul(toInt(succ(i2)), q)))
                                                                            [by either_rhs second-closed-exists]
                                                                        }
                                                                      @conclusion-when-second |
                                                                        (less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))) or (exists i2: Nat; less_than(i2, pm) and j = nat_add(qn, i2) and znAt(u, j) = cls(int_mul(toInt(succ(i2)), q)))
                                                                        [by unpacked with-offset-i]
                                                                    }
                                                                }
                                                            }
                                                          @j-form-implies |
                                                            less_than(j, nat_add(qn, pm)) -> ((less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))) or (exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = cls(int_mul(toInt(succ(i)), q))))
                                                            [by discharge given-j-below-form]
                                                        }
                                                      @entry-form |
                                                        forall j: Nat; less_than(j, nat_add(qn, pm)) -> ((less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))) or (exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = cls(int_mul(toInt(succ(i)), q))))
                                                        [by generalize generalize-j-form]
                                                      // (a) no entry generates.
                                                      @generalize-j-a |
                                                        fix j: Nat {
                                                          @given-j-below-a |
                                                            assume less_than(j, nat_add(qn, pm)) {
                                                              @j-below-a |
                                                                less_than(j, nat_add(qn, pm))
                                                                [by hypothesis given-j-below-a]
                                                              @j-form |
                                                                (less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))) or (exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = cls(int_mul(toInt(succ(i)), q)))
                                                                [using specialize entry-form(j) j-below-a]
                                                              @conclusion-j-non-generator |
                                                                not generates(znAt(u, j))
                                                                case j-form {
                                                                  @when-first |
                                                                    assume less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p)) {
                                                                      @first-facts |
                                                                        less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))
                                                                        [by hypothesis when-first]
                                                                      @u-j-closed |
                                                                        znAt(u, j) = cls(int_mul(toInt(j), p))
                                                                        [by and_rhs first-facts]
                                                                      @multiple-commutes |
                                                                        int_mul(toInt(j), p) = int_mul(p, toInt(j))
                                                                        [using specialize intMulIsCommutative(toInt(j), p)]
                                                                      @p-divides-multiple |
                                                                        divides(p, int_mul(toInt(j), p))
                                                                        [using specialize dividesIntro(int_mul(toInt(j), p), p, toInt(j)) multiple-commutes]
                                                                      @some-prime-divides |
                                                                        divides(p, int_mul(toInt(j), p)) or divides(q, int_mul(toInt(j), p))
                                                                        [by either_lhs p-divides-multiple]
                                                                      @entry-characterized |
                                                                        (not generates(cls(int_mul(toInt(j), p)))) iff (divides(p, int_mul(toInt(j), p)) or divides(q, int_mul(toInt(j), p)))
                                                                        [using specialize characterization(int_mul(toInt(j), p))]
                                                                      @closed-non-generator |
                                                                        not generates(cls(int_mul(toInt(j), p)))
                                                                        [using tautology entry-characterized some-prime-divides]
                                                                      @conclusion-when-first |
                                                                        not generates(znAt(u, j))
                                                                        [by rewrite u-j-closed closed-non-generator]
                                                                    }
                                                                  @when-second |
                                                                    assume exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = cls(int_mul(toInt(succ(i)), q)) {
                                                                      @second-exists |
                                                                        exists i: Nat; less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = cls(int_mul(toInt(succ(i)), q))
                                                                        [by hypothesis when-second]
                                                                      @with-offset-i |
                                                                        unpack i: Nat from second-exists {
                                                                          @second-facts |
                                                                            less_than(i, pm) and j = nat_add(qn, i) and znAt(u, j) = cls(int_mul(toInt(succ(i)), q))
                                                                            [by hypothesis with-offset-i]
                                                                          @u-j-closed |
                                                                            znAt(u, j) = cls(int_mul(toInt(succ(i)), q))
                                                                            [using tautology second-facts]
                                                                          @multiple-commutes |
                                                                            int_mul(toInt(succ(i)), q) = int_mul(q, toInt(succ(i)))
                                                                            [using specialize intMulIsCommutative(toInt(succ(i)), q)]
                                                                          @q-divides-multiple |
                                                                            divides(q, int_mul(toInt(succ(i)), q))
                                                                            [using specialize dividesIntro(int_mul(toInt(succ(i)), q), q, toInt(succ(i))) multiple-commutes]
                                                                          @some-prime-divides |
                                                                            divides(p, int_mul(toInt(succ(i)), q)) or divides(q, int_mul(toInt(succ(i)), q))
                                                                            [by either_rhs q-divides-multiple]
                                                                          @entry-characterized |
                                                                            (not generates(cls(int_mul(toInt(succ(i)), q)))) iff (divides(p, int_mul(toInt(succ(i)), q)) or divides(q, int_mul(toInt(succ(i)), q)))
                                                                            [using specialize characterization(int_mul(toInt(succ(i)), q))]
                                                                          @closed-non-generator |
                                                                            not generates(cls(int_mul(toInt(succ(i)), q)))
                                                                            [using tautology entry-characterized some-prime-divides]
                                                                          @conclusion-when-second-inner |
                                                                            not generates(znAt(u, j))
                                                                            [by rewrite u-j-closed closed-non-generator]
                                                                        }
                                                                      @conclusion-when-second |
                                                                        not generates(znAt(u, j))
                                                                        [by unpacked with-offset-i]
                                                                    }
                                                                }
                                                            }
                                                          @j-a-implies |
                                                            less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u, j)))
                                                            [by discharge given-j-below-a]
                                                        }
                                                      @no-entry-generates |
                                                        forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u, j)))
                                                        [by generalize generalize-j-a]
                                                      // (b) no repetition.
                                                      @generalize-i-b |
                                                        fix i: Nat {
                                                          @generalize-j-b |
                                                            fix j: Nat {
                                                              @given-i-below-b |
                                                                assume less_than(i, nat_add(qn, pm)) {
                                                                  @given-j-below-b |
                                                                    assume less_than(j, nat_add(qn, pm)) {
                                                                      @given-entries-equal |
                                                                        assume znAt(u, i) = znAt(u, j) {
                                                                          @i-below-b |
                                                                            less_than(i, nat_add(qn, pm))
                                                                            [by hypothesis given-i-below-b]
                                                                          @j-below-b |
                                                                            less_than(j, nat_add(qn, pm))
                                                                            [by hypothesis given-j-below-b]
                                                                          @entries-equal |
                                                                            znAt(u, i) = znAt(u, j)
                                                                            [by hypothesis given-entries-equal]
                                                                          @i-form |
                                                                            (less_than(i, qn) and znAt(u, i) = cls(int_mul(toInt(i), p))) or (exists i2: Nat; less_than(i2, pm) and i = nat_add(qn, i2) and znAt(u, i) = cls(int_mul(toInt(succ(i2)), q)))
                                                                            [using specialize entry-form(i) i-below-b]
                                                                          @j-form |
                                                                            (less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))) or (exists j2: Nat; less_than(j2, pm) and j = nat_add(qn, j2) and znAt(u, j) = cls(int_mul(toInt(succ(j2)), q)))
                                                                            [using specialize entry-form(j) j-below-b]
                                                                          @conclusion-indices-equal |
                                                                            i = j
                                                                            case i-form {
                                                                              @when-i-first |
                                                                                assume less_than(i, qn) and znAt(u, i) = cls(int_mul(toInt(i), p)) {
                                                                                  @i-first-facts |
                                                                                    less_than(i, qn) and znAt(u, i) = cls(int_mul(toInt(i), p))
                                                                                    [by hypothesis when-i-first]
                                                                                  @i-below-qn |
                                                                                    less_than(i, qn)
                                                                                    [by and_lhs i-first-facts]
                                                                                  @u-i-closed |
                                                                                    znAt(u, i) = cls(int_mul(toInt(i), p))
                                                                                    [by and_rhs i-first-facts]
                                                                                  @closed-i-is-u-i |
                                                                                    cls(int_mul(toInt(i), p)) = znAt(u, i)
                                                                                    [by symmetry u-i-closed]
                                                                                  @conclusion-i-first |
                                                                                    i = j
                                                                                    case j-form {
                                                                                      @when-j-first |
                                                                                        assume less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p)) {
                                                                                          @j-first-facts |
                                                                                            less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))
                                                                                            [by hypothesis when-j-first]
                                                                                          @j-below-qn |
                                                                                            less_than(j, qn)
                                                                                            [by and_lhs j-first-facts]
                                                                                          @u-j-closed |
                                                                                            znAt(u, j) = cls(int_mul(toInt(j), p))
                                                                                            [by and_rhs j-first-facts]
                                                                                          @closed-entries-equal |
                                                                                            cls(int_mul(toInt(i), p)) = cls(int_mul(toInt(j), p))
                                                                                            [using chain closed-i-is-u-i entries-equal u-j-closed]
                                                                                          @conclusion-both-first |
                                                                                            i = j
                                                                                            [using specialize first-part-injective(i, j) i-below-qn j-below-qn closed-entries-equal]
                                                                                        }
                                                                                      @when-j-second |
                                                                                        assume exists j2: Nat; less_than(j2, pm) and j = nat_add(qn, j2) and znAt(u, j) = cls(int_mul(toInt(succ(j2)), q)) {
                                                                                          @j-second-exists |
                                                                                            exists j2: Nat; less_than(j2, pm) and j = nat_add(qn, j2) and znAt(u, j) = cls(int_mul(toInt(succ(j2)), q))
                                                                                            [by hypothesis when-j-second]
                                                                                          @with-offset-j2 |
                                                                                            unpack j2: Nat from j-second-exists {
                                                                                              @j-second-facts |
                                                                                                less_than(j2, pm) and j = nat_add(qn, j2) and znAt(u, j) = cls(int_mul(toInt(succ(j2)), q))
                                                                                                [by hypothesis with-offset-j2]
                                                                                              @j2-below-pm |
                                                                                                less_than(j2, pm)
                                                                                                [using tautology j-second-facts]
                                                                                              @u-j-closed |
                                                                                                znAt(u, j) = cls(int_mul(toInt(succ(j2)), q))
                                                                                                [using tautology j-second-facts]
                                                                                              @closed-entries-equal |
                                                                                                cls(int_mul(toInt(i), p)) = cls(int_mul(toInt(succ(j2)), q))
                                                                                                [using chain closed-i-is-u-i entries-equal u-j-closed]
                                                                                              @closed-entries-differ |
                                                                                                cls(int_mul(toInt(i), p)) != cls(int_mul(toInt(succ(j2)), q))
                                                                                                [using specialize parts-never-meet(i, j2) j2-below-pm]
                                                                                              @conclusion-first-second-inner |
                                                                                                i = j
                                                                                                [by ex_falso closed-entries-equal closed-entries-differ]
                                                                                            }
                                                                                          @conclusion-first-second |
                                                                                            i = j
                                                                                            [by unpacked with-offset-j2]
                                                                                        }
                                                                                    }
                                                                                }
                                                                              @when-i-second |
                                                                                assume exists i2: Nat; less_than(i2, pm) and i = nat_add(qn, i2) and znAt(u, i) = cls(int_mul(toInt(succ(i2)), q)) {
                                                                                  @i-second-exists |
                                                                                    exists i2: Nat; less_than(i2, pm) and i = nat_add(qn, i2) and znAt(u, i) = cls(int_mul(toInt(succ(i2)), q))
                                                                                    [by hypothesis when-i-second]
                                                                                  @with-offset-i2 |
                                                                                    unpack i2: Nat from i-second-exists {
                                                                                      @i-second-facts |
                                                                                        less_than(i2, pm) and i = nat_add(qn, i2) and znAt(u, i) = cls(int_mul(toInt(succ(i2)), q))
                                                                                        [by hypothesis with-offset-i2]
                                                                                      @i2-below-pm |
                                                                                        less_than(i2, pm)
                                                                                        [using tautology i-second-facts]
                                                                                      @i-is-offset |
                                                                                        i = nat_add(qn, i2)
                                                                                        [using tautology i-second-facts]
                                                                                      @u-i-closed |
                                                                                        znAt(u, i) = cls(int_mul(toInt(succ(i2)), q))
                                                                                        [using tautology i-second-facts]
                                                                                      @closed-i-is-u-i |
                                                                                        cls(int_mul(toInt(succ(i2)), q)) = znAt(u, i)
                                                                                        [by symmetry u-i-closed]
                                                                                      @conclusion-i-second-inner |
                                                                                        i = j
                                                                                        case j-form {
                                                                                          @when-j-first |
                                                                                            assume less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p)) {
                                                                                              @j-first-facts |
                                                                                                less_than(j, qn) and znAt(u, j) = cls(int_mul(toInt(j), p))
                                                                                                [by hypothesis when-j-first]
                                                                                              @u-j-closed |
                                                                                                znAt(u, j) = cls(int_mul(toInt(j), p))
                                                                                                [by and_rhs j-first-facts]
                                                                                              @closed-entries-equal |
                                                                                                cls(int_mul(toInt(succ(i2)), q)) = cls(int_mul(toInt(j), p))
                                                                                                [using chain closed-i-is-u-i entries-equal u-j-closed]
                                                                                              @closed-entries-equal-flipped |
                                                                                                cls(int_mul(toInt(j), p)) = cls(int_mul(toInt(succ(i2)), q))
                                                                                                [by symmetry closed-entries-equal]
                                                                                              @closed-entries-differ |
                                                                                                cls(int_mul(toInt(j), p)) != cls(int_mul(toInt(succ(i2)), q))
                                                                                                [using specialize parts-never-meet(j, i2) i2-below-pm]
                                                                                              @conclusion-second-first |
                                                                                                i = j
                                                                                                [by ex_falso closed-entries-equal-flipped closed-entries-differ]
                                                                                            }
                                                                                          @when-j-second |
                                                                                            assume exists j2: Nat; less_than(j2, pm) and j = nat_add(qn, j2) and znAt(u, j) = cls(int_mul(toInt(succ(j2)), q)) {
                                                                                              @j-second-exists |
                                                                                                exists j2: Nat; less_than(j2, pm) and j = nat_add(qn, j2) and znAt(u, j) = cls(int_mul(toInt(succ(j2)), q))
                                                                                                [by hypothesis when-j-second]
                                                                                              @with-offset-j2 |
                                                                                                unpack j2: Nat from j-second-exists {
                                                                                                  @j-second-facts |
                                                                                                    less_than(j2, pm) and j = nat_add(qn, j2) and znAt(u, j) = cls(int_mul(toInt(succ(j2)), q))
                                                                                                    [by hypothesis with-offset-j2]
                                                                                                  @j2-below-pm |
                                                                                                    less_than(j2, pm)
                                                                                                    [using tautology j-second-facts]
                                                                                                  @j-is-offset |
                                                                                                    j = nat_add(qn, j2)
                                                                                                    [using tautology j-second-facts]
                                                                                                  @u-j-closed |
                                                                                                    znAt(u, j) = cls(int_mul(toInt(succ(j2)), q))
                                                                                                    [using tautology j-second-facts]
                                                                                                  @closed-entries-equal |
                                                                                                    cls(int_mul(toInt(succ(i2)), q)) = cls(int_mul(toInt(succ(j2)), q))
                                                                                                    [using chain closed-i-is-u-i entries-equal u-j-closed]
                                                                                                  @offsets-equal |
                                                                                                    i2 = j2
                                                                                                    [using specialize second-part-injective(i2, j2) i2-below-pm j2-below-pm closed-entries-equal]
                                                                                                  @i-is-j-offset |
                                                                                                    i = nat_add(qn, j2)
                                                                                                    [by rewrite offsets-equal i-is-offset]
                                                                                                  @j-offset-is-j |
                                                                                                    nat_add(qn, j2) = j
                                                                                                    [by symmetry j-is-offset]
                                                                                                  @conclusion-both-second-inner |
                                                                                                    i = j
                                                                                                    [using chain i-is-j-offset j-offset-is-j]
                                                                                                }
                                                                                              @conclusion-both-second |
                                                                                                i = j
                                                                                                [by unpacked with-offset-j2]
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                  @conclusion-i-second |
                                                                                    i = j
                                                                                    [by unpacked with-offset-i2]
                                                                                }
                                                                            }
                                                                        }
                                                                      @entries-equal-implies |
                                                                        znAt(u, i) = znAt(u, j) -> i = j
                                                                        [by discharge given-entries-equal]
                                                                    }
                                                                  @j-below-b-implies |
                                                                    less_than(j, nat_add(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j
                                                                    [by discharge given-j-below-b]
                                                                }
                                                              @i-below-b-implies |
                                                                less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j
                                                                [by discharge given-i-below-b]
                                                            }
                                                          @discharge-j-b |
                                                            forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j
                                                            [by generalize generalize-j-b]
                                                        }
                                                      @no-repetition |
                                                        forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j
                                                        [by generalize generalize-i-b]
                                                      // (c) every non-generator appears.
                                                      @generalize-z |
                                                        fix z: Zn {
                                                          @given-non-generator |
                                                            assume not generates(z) {
                                                              @non-generator |
                                                                not generates(z)
                                                                [by hypothesis given-non-generator]
                                                              @z-listed |
                                                                (exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q)))
                                                                [using specialize coverage(z) non-generator]
                                                              @conclusion-z-appears |
                                                                exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z
                                                                case z-listed {
                                                                  @when-first |
                                                                    assume exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p)) {
                                                                      @first-exists |
                                                                        exists k: Nat; less_than(k, qn) and z = cls(int_mul(toInt(k), p))
                                                                        [by hypothesis when-first]
                                                                      @with-index-k |
                                                                        unpack k: Nat from first-exists {
                                                                          @first-facts |
                                                                            less_than(k, qn) and z = cls(int_mul(toInt(k), p))
                                                                            [by hypothesis with-index-k]
                                                                          @k-below-qn |
                                                                            less_than(k, qn)
                                                                            [by and_lhs first-facts]
                                                                          @z-closed |
                                                                            z = cls(int_mul(toInt(k), p))
                                                                            [by and_rhs first-facts]
                                                                          @k-below-total |
                                                                            less_than(k, nat_add(qn, pm))
                                                                            [using specialize belowTheBaseIsBelowTheSum(qn, pm, k) k-below-qn]
                                                                          @u-k-is-w1-k |
                                                                            znAt(u, k) = znAt(w1, k)
                                                                            [using specialize prefix-agrees(k) k-below-qn]
                                                                          @w1-k |
                                                                            znAt(w1, k) = cls(int_mul(toInt(k), p))
                                                                            [using specialize w1-entries(k) k-below-qn]
                                                                          @closed-is-z |
                                                                            cls(int_mul(toInt(k), p)) = z
                                                                            [by symmetry z-closed]
                                                                          @u-k-is-z |
                                                                            znAt(u, k) = z
                                                                            [using chain u-k-is-w1-k w1-k closed-is-z]
                                                                          @k-witnesses |
                                                                            less_than(k, nat_add(qn, pm)) and znAt(u, k) = z
                                                                            [by both k-below-total u-k-is-z]
                                                                          @conclusion-when-first-inner |
                                                                            exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z
                                                                            [by witness(k) k-witnesses]
                                                                        }
                                                                      @conclusion-when-first |
                                                                        exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z
                                                                        [by unpacked with-index-k]
                                                                    }
                                                                  @when-second |
                                                                    assume exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q)) {
                                                                      @second-exists |
                                                                        exists k: Nat; less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))
                                                                        [by hypothesis when-second]
                                                                      @with-index-k |
                                                                        unpack k: Nat from second-exists {
                                                                          @second-facts |
                                                                            less_than(k, pm) and z = cls(int_mul(toInt(succ(k)), q))
                                                                            [by hypothesis with-index-k]
                                                                          @k-below-pm |
                                                                            less_than(k, pm)
                                                                            [by and_lhs second-facts]
                                                                          @z-closed |
                                                                            z = cls(int_mul(toInt(succ(k)), q))
                                                                            [by and_rhs second-facts]
                                                                          @offset-below-total |
                                                                            less_than(nat_add(qn, k), nat_add(qn, pm))
                                                                            [using specialize additionPreservesOrder(k, pm, qn) k-below-pm]
                                                                          @u-offset-is-w2-k |
                                                                            znAt(u, nat_add(qn, k)) = znAt(w2, k)
                                                                            [using specialize block-agrees(k) k-below-pm]
                                                                          @w2-k |
                                                                            znAt(w2, k) = cls(int_mul(toInt(succ(k)), q))
                                                                            [using specialize w2-entries(k) k-below-pm]
                                                                          @closed-is-z |
                                                                            cls(int_mul(toInt(succ(k)), q)) = z
                                                                            [by symmetry z-closed]
                                                                          @u-offset-is-z |
                                                                            znAt(u, nat_add(qn, k)) = z
                                                                            [using chain u-offset-is-w2-k w2-k closed-is-z]
                                                                          @offset-witnesses |
                                                                            less_than(nat_add(qn, k), nat_add(qn, pm)) and znAt(u, nat_add(qn, k)) = z
                                                                            [by both offset-below-total u-offset-is-z]
                                                                          @conclusion-when-second-inner |
                                                                            exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z
                                                                            [by witness(nat_add(qn, k)) offset-witnesses]
                                                                        }
                                                                      @conclusion-when-second |
                                                                        exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z
                                                                        [by unpacked with-index-k]
                                                                    }
                                                                }
                                                            }
                                                          @non-generator-implies |
                                                            (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z
                                                            [by discharge given-non-generator]
                                                        }
                                                      @every-non-generator-appears |
                                                        forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z
                                                        [by generalize generalize-z]
                                                      @u-lists-the-non-generators |
                                                        (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z)
                                                        [using tautology no-entry-generates no-repetition every-non-generator-appears]
                                                      @conclusion-with-u-inner |
                                                        exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                                                        [by witness(u) u-lists-the-non-generators]
                                                    }
                                                  @conclusion-with-u |
                                                    exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                                                    [by unpacked with-concatenation-u]
                                                }
                                              @conclusion-with-w2 |
                                                exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                                                [by unpacked with-second-part-w2]
                                            }
                                          @conclusion-listed |
                                            exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                                            [by unpacked with-first-part-w1]
                                        }
                                      @q-image-implies |
                                        toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                                        [by discharge given-q-image]
                                    }
                                  @p-image-implies |
                                    toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                                    [by discharge given-p-image]
                                }
                              @modulus-implies |
                                N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                                [by discharge given-modulus]
                            }
                          @distinct-implies |
                            p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                            [by discharge given-distinct]
                        }
                      @q-prime-implies |
                        is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                        [by discharge given-q-prime]
                    }
                  @p-prime-implies |
                    is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                    [by discharge given-p-prime]
                }
              @discharge-qn |
                forall qn: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
                [by generalize generalize-qn]
            }
          @discharge-pm |
            forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
            [by generalize generalize-pm]
        }
      @discharge-q |
        forall q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u2, j) = z)
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z)
    [by generalize generalize-p]
qed

// -- (x − 1) + 1 = x, in successor form ----------------------------------------------------------
theorem succOfPredecessor: forall x: Int; int_succ(int_sub(x, INT_ONE)) = x
proof
  @generalize-x |
    fix x: Int {
      @one-is-succ-zero |
        INT_ONE = int_succ(INT_ZERO)
        [by cite oneIsSuccZero]
      @plus-succ-zero |
        int_add(int_sub(x, INT_ONE), int_succ(INT_ZERO)) = int_succ(int_add(int_sub(x, INT_ONE), INT_ZERO))
        [using specialize intAddSuccRight(int_sub(x, INT_ONE), INT_ZERO)]
      @plus-zero |
        int_add(int_sub(x, INT_ONE), INT_ZERO) = int_sub(x, INT_ONE)
        [using specialize intAddZeroRight(int_sub(x, INT_ONE))]
      @plus-succ-zero-collapsed |
        int_add(int_sub(x, INT_ONE), int_succ(INT_ZERO)) = int_succ(int_sub(x, INT_ONE))
        [by rewrite plus-zero plus-succ-zero]
      @plus-one |
        int_add(int_sub(x, INT_ONE), INT_ONE) = int_succ(int_sub(x, INT_ONE))
        [by rewrite one-is-succ-zero plus-succ-zero-collapsed]
      @succ-as-plus-one |
        int_succ(int_sub(x, INT_ONE)) = int_add(int_sub(x, INT_ONE), INT_ONE)
        [by symmetry plus-one]
      @difference-unfolds |
        int_sub(x, INT_ONE) = int_add(x, int_neg(INT_ONE))
        [using specialize definitionOfSubtraction(x, INT_ONE)]
      @succ-unfolded |
        int_succ(int_sub(x, INT_ONE)) = int_add(int_add(x, int_neg(INT_ONE)), INT_ONE)
        [by rewrite difference-unfolds succ-as-plus-one]
      @cancels |
        int_add(int_add(x, int_neg(INT_ONE)), INT_ONE) = x
        [using polynomial(integer)]
      @conclusion-recovered |
        int_succ(int_sub(x, INT_ONE)) = x
        [using chain succ-unfolded cancels]
    }
  @conclusion |
    forall x: Int; int_succ(int_sub(x, INT_ONE)) = x
    [by generalize generalize-x]
qed

// -- THE COUNT: ℤ_pq has (p − 1)(q − 1) generators (Judson §4.1, exercise 24) -------------------
// Split the listing of ℤ_pq (pq classes) into generators and non-generators; the non-generators
// are also listed by the explicit q + (p − 1) multiples, and two injective listings of one class
// have the same length; so the generators number pq − q − (p − 1) = (p − 1)(q − 1).
theorem generatorCountOfZpq: forall p, q: Int; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> exists v: ZnSeq; exists c: Nat; (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @given-p-prime |
            assume is_prime(p) {
              @given-q-prime |
                assume is_prime(q) {
                  @given-distinct |
                    assume p != q {
                      @given-modulus |
                        assume N = int_mul(p, q) {
                          @p-prime |
                            is_prime(p)
                            [by hypothesis given-p-prime]
                          @q-prime |
                            is_prime(q)
                            [by hypothesis given-q-prime]
                          @distinct |
                            p != q
                            [by hypothesis given-distinct]
                          @modulus |
                            N = int_mul(p, q)
                            [by hypothesis given-modulus]
                          @p-prime-facts |
                            int_less_than(INT_ONE, p) and (forall d: Int; int_less_than(INT_ZERO, d) -> divides(d, p) -> (d = INT_ONE or d = p))
                            [by hypothesis given-p-prime]
                          @one-below-p |
                            int_less_than(INT_ONE, p)
                            [using tautology p-prime-facts]
                          @q-positive |
                            int_less_than(INT_ZERO, q)
                            [using specialize primeIsPositive(q) q-prime]
                          @q-nonneg |
                            nonneg(q)
                            [using specialize positiveIsNonneg(q) q-positive]
                          @p-predecessor-nonneg |
                            nonneg(int_sub(p, INT_ONE))
                            [using specialize lessThanGivesNonnegDifference(INT_ONE, p) one-below-p]
                          @pm-exists |
                            exists m: Nat; toInt(m) = int_sub(p, INT_ONE)
                            [using specialize everyNonnegIsAnImage(int_sub(p, INT_ONE)) p-predecessor-nonneg]
                          @qn-exists |
                            exists m: Nat; toInt(m) = q
                            [using specialize everyNonnegIsAnImage(q) q-nonneg]
                          @listing-exists |
                            exists m: Nat; exists w: ZnSeq; toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                            [by cite znIsListedByItsRepresentatives]
                          @with-pm |
                            unpack pm: Nat from pm-exists {
                              @pm-image |
                                toInt(pm) = int_sub(p, INT_ONE)
                                [by hypothesis with-pm]
                              @succ-pm-image-raw |
                                toInt(succ(pm)) = int_succ(toInt(pm))
                                [using specialize toIntSucc(pm)]
                              @succ-pm-image-unfolded |
                                toInt(succ(pm)) = int_succ(int_sub(p, INT_ONE))
                                [by rewrite pm-image succ-pm-image-raw]
                              @predecessor-recovers |
                                int_succ(int_sub(p, INT_ONE)) = p
                                [using specialize succOfPredecessor(p)]
                              @p-image |
                                toInt(succ(pm)) = p
                                [using chain succ-pm-image-unfolded predecessor-recovers]
                              @with-qn |
                                unpack qn: Nat from qn-exists {
                                  @q-image |
                                    toInt(qn) = q
                                    [by hypothesis with-qn]
                                  @u-exists |
                                    exists u: ZnSeq; (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z)
                                    [using specialize nonGeneratorsOfZpqAreListed(p, q, pm, qn) p-prime q-prime distinct modulus p-image q-image]
                                  @with-m |
                                    unpack m: Nat from listing-exists {
                                      @after-m |
                                        exists w: ZnSeq; toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                                        [by hypothesis with-m]
                                      @with-w |
                                        unpack w: ZnSeq from after-m {
                                          @listing-facts |
                                            toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                                            [by hypothesis with-w]
                                          @m-image |
                                            toInt(m) = N
                                            [using tautology listing-facts]
                                          @w-injective |
                                            forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j
                                            [using tautology listing-facts]
                                          @w-covers |
                                            forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g
                                            [using tautology listing-facts]
                                          @split |
                                            exists v: ZnSeq; exists c: Nat; exists v2: ZnSeq; exists d: Nat; nat_add(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                            [using specialize znGeneratorsAndNonGeneratorsAreListed(m, w) w-injective w-covers]
                                          @with-v |
                                            unpack v: ZnSeq from split {
                                              @after-v |
                                                exists c: Nat; exists v2: ZnSeq; exists d: Nat; nat_add(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                [by hypothesis with-v]
                                              @with-c |
                                                unpack c: Nat from after-v {
                                                  @after-c |
                                                    exists v2: ZnSeq; exists d: Nat; nat_add(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                    [by hypothesis with-c]
                                                  @with-v2 |
                                                    unpack v2: ZnSeq from after-c {
                                                      @after-v2 |
                                                        exists d: Nat; nat_add(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                        [by hypothesis with-v2]
                                                      @with-d |
                                                        unpack d: Nat from after-v2 {
                                                          @split-facts |
                                                            nat_add(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                            [by hypothesis with-d]
                                                          @lengths-add |
                                                            nat_add(c, d) = m
                                                            [using tautology split-facts]
                                                          @v-generates |
                                                            forall j: Nat; less_than(j, c) -> generates(znAt(v, j))
                                                            [using tautology split-facts]
                                                          @v-injective |
                                                            forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j
                                                            [using tautology split-facts]
                                                          @v-covers |
                                                            forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g
                                                            [using tautology split-facts]
                                                          @v2-non-generators |
                                                            forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))
                                                            [using tautology split-facts]
                                                          @v2-injective |
                                                            forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j
                                                            [using tautology split-facts]
                                                          @v2-covers |
                                                            forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g
                                                            [using tautology split-facts]
                                                          @with-u |
                                                            unpack u: ZnSeq from u-exists {
                                                              @u-facts |
                                                                (forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z)
                                                                [by hypothesis with-u]
                                                              @u-non-generators |
                                                                forall j: Nat; less_than(j, nat_add(qn, pm)) -> (not generates(znAt(u, j)))
                                                                [using tautology u-facts]
                                                              @u-injective |
                                                                forall i: Nat; forall j: Nat; less_than(i, nat_add(qn, pm)) -> less_than(j, nat_add(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j
                                                                [using tautology u-facts]
                                                              @u-covers |
                                                                forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nat_add(qn, pm)) and znAt(u, j) = z
                                                                [using tautology u-facts]
                                                              // v2 is drawn from u.
                                                              @generalize-j-v2 |
                                                                fix j: Nat {
                                                                  @given-j-below-d |
                                                                    assume less_than(j, d) {
                                                                      @j-below-d |
                                                                        less_than(j, d)
                                                                        [by hypothesis given-j-below-d]
                                                                      @v2-j-non-generator |
                                                                        not generates(znAt(v2, j))
                                                                        [using specialize v2-non-generators(j) j-below-d]
                                                                      @v2-j-in-u |
                                                                        exists i: Nat; less_than(i, nat_add(qn, pm)) and znAt(u, i) = znAt(v2, j)
                                                                        [using specialize u-covers(znAt(v2, j)) v2-j-non-generator]
                                                                      @with-match-i |
                                                                        unpack i: Nat from v2-j-in-u {
                                                                          @match-facts |
                                                                            less_than(i, nat_add(qn, pm)) and znAt(u, i) = znAt(v2, j)
                                                                            [by hypothesis with-match-i]
                                                                          @i-below |
                                                                            less_than(i, nat_add(qn, pm))
                                                                            [by and_lhs match-facts]
                                                                          @u-i-is-v2-j |
                                                                            znAt(u, i) = znAt(v2, j)
                                                                            [by and_rhs match-facts]
                                                                          @v2-j-is-u-i |
                                                                            znAt(v2, j) = znAt(u, i)
                                                                            [by symmetry u-i-is-v2-j]
                                                                          @match-witnessed |
                                                                            less_than(i, nat_add(qn, pm)) and znAt(v2, j) = znAt(u, i)
                                                                            [by both i-below v2-j-is-u-i]
                                                                          @conclusion-j-drawn-inner |
                                                                            exists i2: Nat; less_than(i2, nat_add(qn, pm)) and znAt(v2, j) = znAt(u, i2)
                                                                            [by witness(i) match-witnessed]
                                                                        }
                                                                      @conclusion-j-drawn |
                                                                        exists i2: Nat; less_than(i2, nat_add(qn, pm)) and znAt(v2, j) = znAt(u, i2)
                                                                        [by unpacked with-match-i]
                                                                    }
                                                                  @j-below-d-implies |
                                                                    less_than(j, d) -> exists i2: Nat; less_than(i2, nat_add(qn, pm)) and znAt(v2, j) = znAt(u, i2)
                                                                    [by discharge given-j-below-d]
                                                                }
                                                              @v2-drawn-from-u |
                                                                forall j: Nat; less_than(j, d) -> exists i2: Nat; less_than(i2, nat_add(qn, pm)) and znAt(v2, j) = znAt(u, i2)
                                                                [by generalize generalize-j-v2]
                                                              // u is drawn from v2.
                                                              @generalize-j-u |
                                                                fix j: Nat {
                                                                  @given-j-below-total |
                                                                    assume less_than(j, nat_add(qn, pm)) {
                                                                      @j-below-total |
                                                                        less_than(j, nat_add(qn, pm))
                                                                        [by hypothesis given-j-below-total]
                                                                      @u-j-non-generator |
                                                                        not generates(znAt(u, j))
                                                                        [using specialize u-non-generators(j) j-below-total]
                                                                      @u-j-in-v2 |
                                                                        exists i: Nat; less_than(i, d) and znAt(v2, i) = znAt(u, j)
                                                                        [using specialize v2-covers(znAt(u, j)) u-j-non-generator]
                                                                      @with-match-i |
                                                                        unpack i: Nat from u-j-in-v2 {
                                                                          @match-facts |
                                                                            less_than(i, d) and znAt(v2, i) = znAt(u, j)
                                                                            [by hypothesis with-match-i]
                                                                          @i-below |
                                                                            less_than(i, d)
                                                                            [by and_lhs match-facts]
                                                                          @v2-i-is-u-j |
                                                                            znAt(v2, i) = znAt(u, j)
                                                                            [by and_rhs match-facts]
                                                                          @u-j-is-v2-i |
                                                                            znAt(u, j) = znAt(v2, i)
                                                                            [by symmetry v2-i-is-u-j]
                                                                          @match-witnessed |
                                                                            less_than(i, d) and znAt(u, j) = znAt(v2, i)
                                                                            [by both i-below u-j-is-v2-i]
                                                                          @conclusion-j-drawn-inner |
                                                                            exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                            [by witness(i) match-witnessed]
                                                                        }
                                                                      @conclusion-j-drawn |
                                                                        exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                        [by unpacked with-match-i]
                                                                    }
                                                                  @j-below-total-implies |
                                                                    less_than(j, nat_add(qn, pm)) -> exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                    [by discharge given-j-below-total]
                                                                }
                                                              @u-drawn-from-v2 |
                                                                forall j: Nat; less_than(j, nat_add(qn, pm)) -> exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                [by generalize generalize-j-u]
                                                              @lengths-equal |
                                                                d = nat_add(qn, pm)
                                                                [using specialize znListingsOfTheSameClassHaveEqualLength(d, v2, nat_add(qn, pm), u) v2-injective u-injective v2-drawn-from-u u-drawn-from-v2]
                                                              // arithmetic: pq = c + q + (p − 1).
                                                              @sum-with-parts |
                                                                nat_add(c, nat_add(qn, pm)) = m
                                                                [by rewrite lengths-equal lengths-add]
                                                              @sum-image-raw |
                                                                toInt(nat_add(c, nat_add(qn, pm))) = int_add(toInt(c), toInt(nat_add(qn, pm)))
                                                                [using specialize toIntAdd(c, nat_add(qn, pm))]
                                                              @m-image-as-sum |
                                                                toInt(m) = int_add(toInt(c), toInt(nat_add(qn, pm)))
                                                                [by rewrite sum-with-parts sum-image-raw]
                                                              @parts-image-raw |
                                                                toInt(nat_add(qn, pm)) = int_add(toInt(qn), toInt(pm))
                                                                [using specialize toIntAdd(qn, pm)]
                                                              @parts-image-q |
                                                                toInt(nat_add(qn, pm)) = int_add(q, toInt(pm))
                                                                [by rewrite q-image parts-image-raw]
                                                              @parts-image |
                                                                toInt(nat_add(qn, pm)) = int_add(q, int_sub(p, INT_ONE))
                                                                [by rewrite pm-image parts-image-q]
                                                              @m-image-closed |
                                                                toInt(m) = int_add(toInt(c), int_add(q, int_sub(p, INT_ONE)))
                                                                [by rewrite parts-image m-image-as-sum]
                                                              @n-is-m-image |
                                                                N = toInt(m)
                                                                [by symmetry m-image]
                                                              @pq-is-sum-raw |
                                                                int_mul(p, q) = toInt(m)
                                                                [by rewrite modulus n-is-m-image]
                                                              @pq-is-sum |
                                                                int_mul(p, q) = int_add(toInt(c), int_add(q, int_sub(p, INT_ONE)))
                                                                [using chain pq-is-sum-raw m-image-closed]
                                                              @sum-is-pq |
                                                                int_add(toInt(c), int_add(q, int_sub(p, INT_ONE))) = int_mul(p, q)
                                                                [by symmetry pq-is-sum]
                                                              @c-recovered |
                                                                toInt(c) = int_add(int_add(toInt(c), int_add(q, int_sub(p, INT_ONE))), int_neg(int_add(q, int_sub(p, INT_ONE))))
                                                                [using polynomial(integer)]
                                                              @c-from-pq |
                                                                toInt(c) = int_add(int_mul(p, q), int_neg(int_add(q, int_sub(p, INT_ONE))))
                                                                [by rewrite sum-is-pq c-recovered]
                                                              @closed-form |
                                                                int_add(int_mul(p, q), int_neg(int_add(q, int_sub(p, INT_ONE)))) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                                                [using polynomial(integer)]
                                                              @count |
                                                                toInt(c) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                                                [using chain c-from-pq closed-form]
                                                              @packaged |
                                                                (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                                                [using tautology v-generates v-injective v-covers count]
                                                              @conclusion-with-count |
                                                                exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                                                [by witness(c) packaged]
                                                            }
                                                          @conclusion-with-u |
                                                            exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                                            [by unpacked with-u]
                                                        }
                                                      @conclusion-with-d |
                                                        exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                                        [by unpacked with-d]
                                                    }
                                                  @conclusion-with-v2 |
                                                    exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                                    [by unpacked with-v2]
                                                }
                                              @conclusion-with-c |
                                                exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                                [by unpacked with-c]
                                              @conclusion-with-v-inner |
                                                exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                                [by witness(v) conclusion-with-c]
                                            }
                                          @conclusion-with-v |
                                            exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                            [by unpacked with-v]
                                        }
                                      @conclusion-with-w |
                                        exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                        [by unpacked with-w]
                                    }
                                  @conclusion-with-m |
                                    exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                    [by unpacked with-m]
                                }
                              @conclusion-with-qn |
                                exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                                [by unpacked with-qn]
                            }
                          @conclusion-counted |
                            exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                            [by unpacked with-pm]
                        }
                      @modulus-implies |
                        N = int_mul(p, q) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                        [by discharge given-modulus]
                    }
                  @distinct-implies |
                    p != q -> N = int_mul(p, q) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                    [by discharge given-distinct]
                }
              @q-prime-implies |
                is_prime(q) -> p != q -> N = int_mul(p, q) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
                [by discharge given-q-prime]
            }
          @p-prime-implies |
            is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
            [by discharge given-p-prime]
        }
      @discharge-q |
        forall q: Int; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
        [by generalize generalize-q]
    }
  @conclusion |
    forall p, q: Int; is_prime(p) -> is_prime(q) -> p != q -> N = int_mul(p, q) -> exists v: ZnSeq; exists c: Nat; (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = int_mul(int_sub(p, INT_ONE), int_sub(q, INT_ONE))
    [by generalize generalize-p]
qed

// -- prime powers (Judson §4.1, exercise 25) ---------------------------------------------------

// b > 0 ⟹ b^e > 0 for e ≥ 0.
theorem powOfPositiveIsPositive: forall b: Int; int_less_than(INT_ZERO, b) -> forall e: Int; nonneg(e) -> int_less_than(INT_ZERO, pow(b, e))
proof
  @generalize-b |
    fix b: Int {
      @given-positive |
        assume int_less_than(INT_ZERO, b) {
          @positive |
            int_less_than(INT_ZERO, b)
            [by hypothesis given-positive]
          @zeroth-power |
            pow(b, INT_ZERO) = INT_ONE
            [using specialize powZero(b)]
          @zero-below-one |
            int_less_than(INT_ZERO, INT_ONE)
            [by cite intZeroLessThanOne]
          @base-case |
            int_less_than(INT_ZERO, pow(b, INT_ZERO))
            [by rewrite zeroth-power zero-below-one]
          @induction-step |
            fix k: Int {
              @given-nonneg |
                assume nonneg(k) {
                  @given-inductive-hypothesis |
                    assume int_less_than(INT_ZERO, pow(b, k)) {
                      @inductive-hypothesis |
                        int_less_than(INT_ZERO, pow(b, k))
                        [by hypothesis given-inductive-hypothesis]
                      @next-unfolds |
                        pow(b, int_succ(k)) = int_mul(pow(b, k), b)
                        [using specialize powSucc(b, k)]
                      @product-positive |
                        int_less_than(INT_ZERO, int_mul(pow(b, k), b))
                        [using specialize productWithPositiveIsPositive(pow(b, k), b) inductive-hypothesis positive]
                      @conclusion-step |
                        int_less_than(INT_ZERO, pow(b, int_succ(k)))
                        [by rewrite next-unfolds product-positive]
                    }
                  @conclusion-given-hypothesis |
                    int_less_than(INT_ZERO, pow(b, k)) -> int_less_than(INT_ZERO, pow(b, int_succ(k)))
                    [by discharge given-inductive-hypothesis]
                }
              @induction-step-at-k |
                nonneg(k) -> int_less_than(INT_ZERO, pow(b, k)) -> int_less_than(INT_ZERO, pow(b, int_succ(k)))
                [by discharge given-nonneg]
            }
          @induction-step-for-all-k |
            forall k: Int; nonneg(k) -> int_less_than(INT_ZERO, pow(b, k)) -> int_less_than(INT_ZERO, pow(b, int_succ(k)))
            [by generalize induction-step]
          @conclusion-all-exponents |
            forall e: Int; nonneg(e) -> int_less_than(INT_ZERO, pow(b, e))
            [using instantiation nonnegInduction((fun e: Int => int_less_than(INT_ZERO, pow(b, e)))) base-case induction-step-for-all-k]
        }
      @positive-implies |
        int_less_than(INT_ZERO, b) -> forall e: Int; nonneg(e) -> int_less_than(INT_ZERO, pow(b, e))
        [by discharge given-positive]
    }
  @conclusion |
    forall b: Int; int_less_than(INT_ZERO, b) -> forall e: Int; nonneg(e) -> int_less_than(INT_ZERO, pow(b, e))
    [by generalize generalize-b]
qed

// Bézout-coprime to p ⟹ Bézout-coprime to every p^e (multiply the identities up).
theorem bezoutCoprimeToPowers: forall r, p: Int; bezoutCoprime(r, p) -> forall e: Int; nonneg(e) -> bezoutCoprime(r, pow(p, e))
proof
  @generalize-r |
    fix r: Int {
      @generalize-p |
        fix p: Int {
          @given-coprime |
            assume bezoutCoprime(r, p) {
              @coprime |
                bezoutCoprime(r, p)
                [by hypothesis given-coprime]
              @zeroth-power |
                pow(p, INT_ZERO) = INT_ONE
                [using specialize powZero(p)]
              @one-identity |
                int_add(int_mul(r, INT_ZERO), int_mul(INT_ONE, INT_ONE)) = INT_ONE
                [using polynomial(integer)]
              @one-identity-t |
                exists t: Int; int_add(int_mul(r, INT_ZERO), int_mul(INT_ONE, t)) = INT_ONE
                [by witness(INT_ONE) one-identity]
              @coprime-to-one |
                bezoutCoprime(r, INT_ONE)
                [by witness(INT_ZERO) one-identity-t]
              @base-case |
                bezoutCoprime(r, pow(p, INT_ZERO))
                [by rewrite zeroth-power coprime-to-one]
              @induction-step |
                fix k: Int {
                  @given-nonneg |
                    assume nonneg(k) {
                      @given-inductive-hypothesis |
                        assume bezoutCoprime(r, pow(p, k)) {
                          @inductive-hypothesis |
                            bezoutCoprime(r, pow(p, k))
                            [by hypothesis given-inductive-hypothesis]
                          @next-unfolds |
                            pow(p, int_succ(k)) = int_mul(pow(p, k), p)
                            [using specialize powSucc(p, k)]
                          @coprime-to-product |
                            bezoutCoprime(r, int_mul(pow(p, k), p))
                            [using specialize bezoutCoprimeMultiplies(r, pow(p, k), p) inductive-hypothesis coprime]
                          @conclusion-step |
                            bezoutCoprime(r, pow(p, int_succ(k)))
                            [by rewrite next-unfolds coprime-to-product]
                        }
                      @conclusion-given-hypothesis |
                        bezoutCoprime(r, pow(p, k)) -> bezoutCoprime(r, pow(p, int_succ(k)))
                        [by discharge given-inductive-hypothesis]
                    }
                  @induction-step-at-k |
                    nonneg(k) -> bezoutCoprime(r, pow(p, k)) -> bezoutCoprime(r, pow(p, int_succ(k)))
                    [by discharge given-nonneg]
                }
              @induction-step-for-all-k |
                forall k: Int; nonneg(k) -> bezoutCoprime(r, pow(p, k)) -> bezoutCoprime(r, pow(p, int_succ(k)))
                [by generalize induction-step]
              @conclusion-all-exponents |
                forall e: Int; nonneg(e) -> bezoutCoprime(r, pow(p, e))
                [using instantiation nonnegInduction((fun e: Int => bezoutCoprime(r, pow(p, e)))) base-case induction-step-for-all-k]
            }
          @coprime-implies |
            bezoutCoprime(r, p) -> forall e: Int; nonneg(e) -> bezoutCoprime(r, pow(p, e))
            [by discharge given-coprime]
        }
      @discharge-p |
        forall p: Int; bezoutCoprime(r, p) -> forall e: Int; nonneg(e) -> bezoutCoprime(r, pow(p, e))
        [by generalize generalize-p]
    }
  @conclusion |
    forall r, p: Int; bezoutCoprime(r, p) -> forall e: Int; nonneg(e) -> bezoutCoprime(r, pow(p, e))
    [by generalize generalize-r]
qed

// for N = p^(e+1): cls(r) fails to generate ⟺ p | r.
theorem nonGeneratorOfPrimePowerIffPrimeDivides: forall p, e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
proof
  @generalize-p |
    fix p: Int {
      @generalize-e |
        fix e: Int {
          @given-prime |
            assume is_prime(p) {
              @given-nonneg |
                assume nonneg(e) {
                  @given-modulus |
                    assume N = pow(p, int_succ(e)) {
                      @prime |
                        is_prime(p)
                        [by hypothesis given-prime]
                      @e-nonneg |
                        nonneg(e)
                        [by hypothesis given-nonneg]
                      @modulus |
                        N = pow(p, int_succ(e))
                        [by hypothesis given-modulus]
                      @succ-e-nonneg |
                        nonneg(int_succ(e))
                        [using specialize nonnegSucc(e) e-nonneg]
                      @power-unfolds |
                        pow(p, int_succ(e)) = int_mul(pow(p, e), p)
                        [using specialize powSucc(p, e)]
                      @factors-commute |
                        int_mul(pow(p, e), p) = int_mul(p, pow(p, e))
                        [using specialize intMulIsCommutative(pow(p, e), p)]
                      @modulus-factored |
                        N = int_mul(p, pow(p, e))
                        [using chain modulus power-unfolds factors-commute]
                      @generalize-r |
                        fix r: Int {
                          @criterion-at-n |
                            generates(cls(r)) iff bezoutCoprime(r, N)
                            [using specialize generatesIffBezoutCoprime(r)]
                          @criterion |
                            generates(cls(r)) iff bezoutCoprime(r, pow(p, int_succ(e)))
                            [by rewrite modulus criterion-at-n]
                          @criterion-factored |
                            generates(cls(r)) iff bezoutCoprime(r, int_mul(p, pow(p, e)))
                            [by rewrite modulus-factored criterion-at-n]
                          @p-blocks |
                            divides(p, r) -> (not bezoutCoprime(r, int_mul(p, pow(p, e))))
                            [using specialize primeFactorBlocksBezout(p, pow(p, e), r) prime]
                          @given-not-dividing |
                            assume not divides(p, r) {
                              @not-dividing |
                                not divides(p, r)
                                [by hypothesis given-not-dividing]
                              @coprime-to-p |
                                bezoutCoprime(r, p)
                                [using specialize primeNotDividingGivesBezout(p, r) prime not-dividing]
                              @conclusion-coprime-to-power |
                                bezoutCoprime(r, pow(p, int_succ(e)))
                                [using specialize bezoutCoprimeToPowers(r, p, int_succ(e)) coprime-to-p succ-e-nonneg]
                            }
                          @not-dividing-implies |
                            (not divides(p, r)) -> bezoutCoprime(r, pow(p, int_succ(e)))
                            [by discharge given-not-dividing]
                          @conclusion-characterized |
                            (not generates(cls(r))) iff divides(p, r)
                            [using tautology criterion criterion-factored p-blocks not-dividing-implies]
                        }
                      @discharge-r |
                        forall r: Int; (not generates(cls(r))) iff divides(p, r)
                        [by generalize generalize-r]
                    }
                  @modulus-implies |
                    N = pow(p, int_succ(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
                    [by discharge given-modulus]
                }
              @nonneg-implies |
                nonneg(e) -> N = pow(p, int_succ(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
                [by discharge given-nonneg]
            }
          @prime-implies |
            is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
            [by discharge given-prime]
        }
      @discharge-e |
        forall e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
        [by generalize generalize-e]
    }
  @conclusion |
    forall p, e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
    [by generalize generalize-p]
qed

// THE NON-GENERATORS OF ℤ_{p^(e+1)}, LISTED: cls(kp) for k < p^e.
theorem nonGeneratorsOfZPrimePowerAreListed: forall p, e: Int; forall mn: Nat; is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> toInt(mn) = pow(p, e) -> exists u: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z)
proof
  @generalize-p |
    fix p: Int {
      @generalize-e |
        fix e: Int {
          @generalize-mn |
            fix mn: Nat {
              @given-prime |
                assume is_prime(p) {
                  @given-nonneg |
                    assume nonneg(e) {
                      @given-modulus |
                        assume N = pow(p, int_succ(e)) {
                          @given-image |
                            assume toInt(mn) = pow(p, e) {
                              @prime |
                                is_prime(p)
                                [by hypothesis given-prime]
                              @e-nonneg |
                                nonneg(e)
                                [by hypothesis given-nonneg]
                              @modulus |
                                N = pow(p, int_succ(e))
                                [by hypothesis given-modulus]
                              @image |
                                toInt(mn) = pow(p, e)
                                [by hypothesis given-image]
                              @p-positive |
                                int_less_than(INT_ZERO, p)
                                [using specialize primeIsPositive(p) prime]
                              @cofactor-positive |
                                int_less_than(INT_ZERO, pow(p, e))
                                [using specialize powOfPositiveIsPositive(p, e) p-positive e-nonneg]
                              @power-unfolds |
                                pow(p, int_succ(e)) = int_mul(pow(p, e), p)
                                [using specialize powSucc(p, e)]
                              @factors-commute |
                                int_mul(pow(p, e), p) = int_mul(p, pow(p, e))
                                [using specialize intMulIsCommutative(pow(p, e), p)]
                              @modulus-factored |
                                N = int_mul(p, pow(p, e))
                                [using chain modulus power-unfolds factors-commute]
                              @characterization |
                                forall r: Int; (not generates(cls(r))) iff divides(p, r)
                                [using specialize nonGeneratorOfPrimePowerIffPrimeDivides(p, e) prime e-nonneg modulus]
                              @injective-multiples |
                                forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> cls(int_mul(toInt(i), p)) = cls(int_mul(toInt(j), p)) -> i = j
                                [using specialize multiplesDoNotRepeat(p, pow(p, e), mn) modulus-factored p-positive image]
                              @reduce |
                                forall c: Int; exists e2: Int; nonneg(e2) and int_less_than(e2, pow(p, e)) and cls(int_mul(c, p)) = cls(int_mul(e2, p))
                                [using specialize coefficientReducesModCofactor(p, pow(p, e)) modulus-factored cofactor-positive]
                              @listing-exists |
                                exists w: ZnSeq; forall i: Nat; less_than(i, mn) -> znAt(w, i) = cls(int_mul(toInt(i), p))
                                [using specialize sequenceOfMultiplesExists(p, mn)]
                              @with-u |
                                unpack u: ZnSeq from listing-exists {
                                  @u-entries |
                                    forall i: Nat; less_than(i, mn) -> znAt(u, i) = cls(int_mul(toInt(i), p))
                                    [by hypothesis with-u]
                                  // (a) no entry generates.
                                  @generalize-j-a |
                                    fix j: Nat {
                                      @given-j-below-a |
                                        assume less_than(j, mn) {
                                          @j-below-a |
                                            less_than(j, mn)
                                            [by hypothesis given-j-below-a]
                                          @u-j |
                                            znAt(u, j) = cls(int_mul(toInt(j), p))
                                            [using specialize u-entries(j) j-below-a]
                                          @multiple-commutes |
                                            int_mul(toInt(j), p) = int_mul(p, toInt(j))
                                            [using specialize intMulIsCommutative(toInt(j), p)]
                                          @p-divides-multiple |
                                            divides(p, int_mul(toInt(j), p))
                                            [using specialize dividesIntro(int_mul(toInt(j), p), p, toInt(j)) multiple-commutes]
                                          @entry-characterized |
                                            (not generates(cls(int_mul(toInt(j), p)))) iff divides(p, int_mul(toInt(j), p))
                                            [using specialize characterization(int_mul(toInt(j), p))]
                                          @closed-non-generator |
                                            not generates(cls(int_mul(toInt(j), p)))
                                            [using tautology entry-characterized p-divides-multiple]
                                          @conclusion-j-non-generator |
                                            not generates(znAt(u, j))
                                            [by rewrite u-j closed-non-generator]
                                        }
                                      @j-a-implies |
                                        less_than(j, mn) -> (not generates(znAt(u, j)))
                                        [by discharge given-j-below-a]
                                    }
                                  @no-entry-generates |
                                    forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))
                                    [by generalize generalize-j-a]
                                  // (b) no repetition.
                                  @generalize-i-b |
                                    fix i: Nat {
                                      @generalize-j-b |
                                        fix j: Nat {
                                          @given-i-below-b |
                                            assume less_than(i, mn) {
                                              @given-j-below-b |
                                                assume less_than(j, mn) {
                                                  @given-entries-equal |
                                                    assume znAt(u, i) = znAt(u, j) {
                                                      @i-below-b |
                                                        less_than(i, mn)
                                                        [by hypothesis given-i-below-b]
                                                      @j-below-b |
                                                        less_than(j, mn)
                                                        [by hypothesis given-j-below-b]
                                                      @entries-equal |
                                                        znAt(u, i) = znAt(u, j)
                                                        [by hypothesis given-entries-equal]
                                                      @u-i |
                                                        znAt(u, i) = cls(int_mul(toInt(i), p))
                                                        [using specialize u-entries(i) i-below-b]
                                                      @u-j |
                                                        znAt(u, j) = cls(int_mul(toInt(j), p))
                                                        [using specialize u-entries(j) j-below-b]
                                                      @closed-i-is-u-i |
                                                        cls(int_mul(toInt(i), p)) = znAt(u, i)
                                                        [by symmetry u-i]
                                                      @closed-entries-equal |
                                                        cls(int_mul(toInt(i), p)) = cls(int_mul(toInt(j), p))
                                                        [using chain closed-i-is-u-i entries-equal u-j]
                                                      @conclusion-indices-equal |
                                                        i = j
                                                        [using specialize injective-multiples(i, j) i-below-b j-below-b closed-entries-equal]
                                                    }
                                                  @entries-equal-implies |
                                                    znAt(u, i) = znAt(u, j) -> i = j
                                                    [by discharge given-entries-equal]
                                                }
                                              @j-below-b-implies |
                                                less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j
                                                [by discharge given-j-below-b]
                                            }
                                          @i-below-b-implies |
                                            less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j
                                            [by discharge given-i-below-b]
                                        }
                                      @discharge-j-b |
                                        forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j
                                        [by generalize generalize-j-b]
                                    }
                                  @no-repetition |
                                    forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j
                                    [by generalize generalize-i-b]
                                  // (c) every non-generator appears.
                                  @generalize-z |
                                    fix z: Zn {
                                      @given-non-generator |
                                        assume not generates(z) {
                                          @non-generator |
                                            not generates(z)
                                            [by hypothesis given-non-generator]
                                          @z-has-representative |
                                            exists k: Int; z = cls(k)
                                            [using specialize clsSurjective(z)]
                                          @with-representative-r |
                                            unpack r: Int from z-has-representative {
                                              @z-is-cls-r |
                                                z = cls(r)
                                                [by hypothesis with-representative-r]
                                              @cls-r-non-generator |
                                                not generates(cls(r))
                                                [by rewrite z-is-cls-r non-generator]
                                              @r-characterized |
                                                (not generates(cls(r))) iff divides(p, r)
                                                [using specialize characterization(r)]
                                              @p-divides-r |
                                                divides(p, r)
                                                [using tautology r-characterized cls-r-non-generator]
                                              @with-cofactor-c |
                                                unpack c: Int from p-divides-r {
                                                  @r-is-pc |
                                                    r = int_mul(p, c)
                                                    [by hypothesis with-cofactor-c]
                                                  @pc-commutes |
                                                    int_mul(p, c) = int_mul(c, p)
                                                    [using specialize intMulIsCommutative(p, c)]
                                                  @r-is-cp |
                                                    r = int_mul(c, p)
                                                    [using chain r-is-pc pc-commutes]
                                                  @reduced |
                                                    exists e2: Int; nonneg(e2) and int_less_than(e2, pow(p, e)) and cls(int_mul(c, p)) = cls(int_mul(e2, p))
                                                    [using specialize reduce(c)]
                                                  @with-remainder-e2 |
                                                    unpack e2: Int from reduced {
                                                      @remainder-facts |
                                                        nonneg(e2) and int_less_than(e2, pow(p, e)) and cls(int_mul(c, p)) = cls(int_mul(e2, p))
                                                        [by hypothesis with-remainder-e2]
                                                      @e2-nonneg |
                                                        nonneg(e2)
                                                        [using tautology remainder-facts]
                                                      @e2-below |
                                                        int_less_than(e2, pow(p, e))
                                                        [using tautology remainder-facts]
                                                      @classes-agree |
                                                        cls(int_mul(c, p)) = cls(int_mul(e2, p))
                                                        [using tautology remainder-facts]
                                                      @e2-is-an-image |
                                                        exists k: Nat; toInt(k) = e2
                                                        [using specialize everyNonnegIsAnImage(e2) e2-nonneg]
                                                      @with-index-k |
                                                        unpack k: Nat from e2-is-an-image {
                                                          @k-image |
                                                            toInt(k) = e2
                                                            [by hypothesis with-index-k]
                                                          @k-image-below |
                                                            int_less_than(toInt(k), pow(p, e))
                                                            [by rewrite k-image e2-below]
                                                          @k-image-below-mn-image |
                                                            int_less_than(toInt(k), toInt(mn))
                                                            [by rewrite image k-image-below]
                                                          @k-below-mn |
                                                            less_than(k, mn)
                                                            [using specialize toIntReflectsOrder(k, mn) k-image-below-mn-image]
                                                          @u-k |
                                                            znAt(u, k) = cls(int_mul(toInt(k), p))
                                                            [using specialize u-entries(k) k-below-mn]
                                                          @u-k-is-e2-multiple |
                                                            znAt(u, k) = cls(int_mul(e2, p))
                                                            [by rewrite k-image u-k]
                                                          @e2-multiple-is-c-multiple |
                                                            cls(int_mul(e2, p)) = cls(int_mul(c, p))
                                                            [by symmetry classes-agree]
                                                          @cp-is-r |
                                                            int_mul(c, p) = r
                                                            [by symmetry r-is-cp]
                                                          @c-multiple-is-cls-r |
                                                            cls(int_mul(c, p)) = cls(r)
                                                            [by rewrite cp-is-r]
                                                          @cls-r-is-z |
                                                            cls(r) = z
                                                            [by symmetry z-is-cls-r]
                                                          @u-k-is-z |
                                                            znAt(u, k) = z
                                                            [using chain u-k-is-e2-multiple e2-multiple-is-c-multiple c-multiple-is-cls-r cls-r-is-z]
                                                          @k-witnesses |
                                                            less_than(k, mn) and znAt(u, k) = z
                                                            [by both k-below-mn u-k-is-z]
                                                          @conclusion-z-appears-inner |
                                                            exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                                            [by witness(k) k-witnesses]
                                                        }
                                                      @conclusion-with-k |
                                                        exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                                        [by unpacked with-index-k]
                                                    }
                                                  @conclusion-with-e2 |
                                                    exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                                    [by unpacked with-remainder-e2]
                                                }
                                              @conclusion-with-c |
                                                exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                                [by unpacked with-cofactor-c]
                                            }
                                          @conclusion-z-appears |
                                            exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                            [by unpacked with-representative-r]
                                        }
                                      @non-generator-implies |
                                        (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                        [by discharge given-non-generator]
                                    }
                                  @every-non-generator-appears |
                                    forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                    [by generalize generalize-z]
                                  @u-lists-the-non-generators |
                                    (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z)
                                    [using tautology no-entry-generates no-repetition every-non-generator-appears]
                                  @conclusion-with-u-inner |
                                    exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                                    [by witness(u) u-lists-the-non-generators]
                                }
                              @conclusion-listed |
                                exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                                [by unpacked with-u]
                            }
                          @image-implies |
                            toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                            [by discharge given-image]
                        }
                      @modulus-implies |
                        N = pow(p, int_succ(e)) -> toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                        [by discharge given-modulus]
                    }
                  @nonneg-implies |
                    nonneg(e) -> N = pow(p, int_succ(e)) -> toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                    [by discharge given-nonneg]
                }
              @prime-implies |
                is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                [by discharge given-prime]
            }
          @discharge-mn |
            forall mn: Nat; is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
            [by generalize generalize-mn]
        }
      @discharge-e |
        forall e: Int; forall mn: Nat; is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
        [by generalize generalize-e]
    }
  @conclusion |
    forall p, e: Int; forall mn: Nat; is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> toInt(mn) = pow(p, e) -> exists u: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z)
    [by generalize generalize-p]
qed

// THE COUNT: ℤ_{p^(e+1)} has p^e (p − 1) generators (Judson §4.1, exercise 25).
theorem generatorCountOfZPrimePower: forall p, e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> exists v: ZnSeq; exists c: Nat; (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = int_mul(pow(p, e), int_sub(p, INT_ONE))
proof
  @generalize-p |
    fix p: Int {
      @generalize-e |
        fix e: Int {
          @given-prime |
            assume is_prime(p) {
              @given-nonneg |
                assume nonneg(e) {
                  @given-modulus |
                    assume N = pow(p, int_succ(e)) {
                      @prime |
                        is_prime(p)
                        [by hypothesis given-prime]
                      @e-nonneg |
                        nonneg(e)
                        [by hypothesis given-nonneg]
                      @modulus |
                        N = pow(p, int_succ(e))
                        [by hypothesis given-modulus]
                      @p-positive |
                        int_less_than(INT_ZERO, p)
                        [using specialize primeIsPositive(p) prime]
                      @cofactor-positive |
                        int_less_than(INT_ZERO, pow(p, e))
                        [using specialize powOfPositiveIsPositive(p, e) p-positive e-nonneg]
                      @cofactor-nonneg |
                        nonneg(pow(p, e))
                        [using specialize positiveIsNonneg(pow(p, e)) cofactor-positive]
                      @mn-exists |
                        exists m: Nat; toInt(m) = pow(p, e)
                        [using specialize everyNonnegIsAnImage(pow(p, e)) cofactor-nonneg]
                      @power-unfolds |
                        pow(p, int_succ(e)) = int_mul(pow(p, e), p)
                        [using specialize powSucc(p, e)]
                      @listing-exists |
                        exists m: Nat; exists w: ZnSeq; toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                        [by cite znIsListedByItsRepresentatives]
                      @with-mn |
                        unpack mn: Nat from mn-exists {
                          @mn-image |
                            toInt(mn) = pow(p, e)
                            [by hypothesis with-mn]
                          @u-exists |
                            exists u: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z)
                            [using specialize nonGeneratorsOfZPrimePowerAreListed(p, e, mn) prime e-nonneg modulus mn-image]
                          @with-m |
                            unpack m: Nat from listing-exists {
                              @after-m |
                                exists w: ZnSeq; toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                                [by hypothesis with-m]
                              @with-w |
                                unpack w: ZnSeq from after-m {
                                  @listing-facts |
                                    toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                                    [by hypothesis with-w]
                                  @m-image |
                                    toInt(m) = N
                                    [using tautology listing-facts]
                                  @w-injective |
                                    forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j
                                    [using tautology listing-facts]
                                  @w-covers |
                                    forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g
                                    [using tautology listing-facts]
                                  @split |
                                    exists v: ZnSeq; exists c: Nat; exists v2: ZnSeq; exists d: Nat; nat_add(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                    [using specialize znGeneratorsAndNonGeneratorsAreListed(m, w) w-injective w-covers]
                                  @with-v |
                                    unpack v: ZnSeq from split {
                                      @after-v |
                                        exists c: Nat; exists v2: ZnSeq; exists d: Nat; nat_add(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                        [by hypothesis with-v]
                                      @with-c |
                                        unpack c: Nat from after-v {
                                          @after-c |
                                            exists v2: ZnSeq; exists d: Nat; nat_add(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                            [by hypothesis with-c]
                                          @with-v2 |
                                            unpack v2: ZnSeq from after-c {
                                              @after-v2 |
                                                exists d: Nat; nat_add(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                [by hypothesis with-v2]
                                              @with-d |
                                                unpack d: Nat from after-v2 {
                                                  @split-facts |
                                                    nat_add(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                    [by hypothesis with-d]
                                                  @lengths-add |
                                                    nat_add(c, d) = m
                                                    [using tautology split-facts]
                                                  @v-generates |
                                                    forall j: Nat; less_than(j, c) -> generates(znAt(v, j))
                                                    [using tautology split-facts]
                                                  @v-injective |
                                                    forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j
                                                    [using tautology split-facts]
                                                  @v-covers |
                                                    forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g
                                                    [using tautology split-facts]
                                                  @v2-non-generators |
                                                    forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))
                                                    [using tautology split-facts]
                                                  @v2-injective |
                                                    forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j
                                                    [using tautology split-facts]
                                                  @v2-covers |
                                                    forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g
                                                    [using tautology split-facts]
                                                  @with-u |
                                                    unpack u: ZnSeq from u-exists {
                                                      @u-facts |
                                                        (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z)
                                                        [by hypothesis with-u]
                                                      @u-non-generators |
                                                        forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))
                                                        [using tautology u-facts]
                                                      @u-injective |
                                                        forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j
                                                        [using tautology u-facts]
                                                      @u-covers |
                                                        forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                                        [using tautology u-facts]
                                                      @generalize-j-v2 |
                                                        fix j: Nat {
                                                          @given-j-below-d |
                                                            assume less_than(j, d) {
                                                              @j-below-d |
                                                                less_than(j, d)
                                                                [by hypothesis given-j-below-d]
                                                              @v2-j-non-generator |
                                                                not generates(znAt(v2, j))
                                                                [using specialize v2-non-generators(j) j-below-d]
                                                              @v2-j-in-u |
                                                                exists i: Nat; less_than(i, mn) and znAt(u, i) = znAt(v2, j)
                                                                [using specialize u-covers(znAt(v2, j)) v2-j-non-generator]
                                                              @with-match-i |
                                                                unpack i: Nat from v2-j-in-u {
                                                                  @match-facts |
                                                                    less_than(i, mn) and znAt(u, i) = znAt(v2, j)
                                                                    [by hypothesis with-match-i]
                                                                  @i-below |
                                                                    less_than(i, mn)
                                                                    [by and_lhs match-facts]
                                                                  @u-i-is-v2-j |
                                                                    znAt(u, i) = znAt(v2, j)
                                                                    [by and_rhs match-facts]
                                                                  @v2-j-is-u-i |
                                                                    znAt(v2, j) = znAt(u, i)
                                                                    [by symmetry u-i-is-v2-j]
                                                                  @match-witnessed |
                                                                    less_than(i, mn) and znAt(v2, j) = znAt(u, i)
                                                                    [by both i-below v2-j-is-u-i]
                                                                  @conclusion-j-drawn-inner |
                                                                    exists i2: Nat; less_than(i2, mn) and znAt(v2, j) = znAt(u, i2)
                                                                    [by witness(i) match-witnessed]
                                                                }
                                                              @conclusion-j-drawn |
                                                                exists i2: Nat; less_than(i2, mn) and znAt(v2, j) = znAt(u, i2)
                                                                [by unpacked with-match-i]
                                                            }
                                                          @j-below-d-implies |
                                                            less_than(j, d) -> exists i2: Nat; less_than(i2, mn) and znAt(v2, j) = znAt(u, i2)
                                                            [by discharge given-j-below-d]
                                                        }
                                                      @v2-drawn-from-u |
                                                        forall j: Nat; less_than(j, d) -> exists i2: Nat; less_than(i2, mn) and znAt(v2, j) = znAt(u, i2)
                                                        [by generalize generalize-j-v2]
                                                      @generalize-j-u |
                                                        fix j: Nat {
                                                          @given-j-below-mn |
                                                            assume less_than(j, mn) {
                                                              @j-below-mn |
                                                                less_than(j, mn)
                                                                [by hypothesis given-j-below-mn]
                                                              @u-j-non-generator |
                                                                not generates(znAt(u, j))
                                                                [using specialize u-non-generators(j) j-below-mn]
                                                              @u-j-in-v2 |
                                                                exists i: Nat; less_than(i, d) and znAt(v2, i) = znAt(u, j)
                                                                [using specialize v2-covers(znAt(u, j)) u-j-non-generator]
                                                              @with-match-i |
                                                                unpack i: Nat from u-j-in-v2 {
                                                                  @match-facts |
                                                                    less_than(i, d) and znAt(v2, i) = znAt(u, j)
                                                                    [by hypothesis with-match-i]
                                                                  @i-below |
                                                                    less_than(i, d)
                                                                    [by and_lhs match-facts]
                                                                  @v2-i-is-u-j |
                                                                    znAt(v2, i) = znAt(u, j)
                                                                    [by and_rhs match-facts]
                                                                  @u-j-is-v2-i |
                                                                    znAt(u, j) = znAt(v2, i)
                                                                    [by symmetry v2-i-is-u-j]
                                                                  @match-witnessed |
                                                                    less_than(i, d) and znAt(u, j) = znAt(v2, i)
                                                                    [by both i-below u-j-is-v2-i]
                                                                  @conclusion-j-drawn-inner |
                                                                    exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                    [by witness(i) match-witnessed]
                                                                }
                                                              @conclusion-j-drawn |
                                                                exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                [by unpacked with-match-i]
                                                            }
                                                          @j-below-mn-implies |
                                                            less_than(j, mn) -> exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                            [by discharge given-j-below-mn]
                                                        }
                                                      @u-drawn-from-v2 |
                                                        forall j: Nat; less_than(j, mn) -> exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                        [by generalize generalize-j-u]
                                                      @lengths-equal |
                                                        d = mn
                                                        [using specialize znListingsOfTheSameClassHaveEqualLength(d, v2, mn, u) v2-injective u-injective v2-drawn-from-u u-drawn-from-v2]
                                                      @sum-with-mn |
                                                        nat_add(c, mn) = m
                                                        [by rewrite lengths-equal lengths-add]
                                                      @sum-image-raw |
                                                        toInt(nat_add(c, mn)) = int_add(toInt(c), toInt(mn))
                                                        [using specialize toIntAdd(c, mn)]
                                                      @m-image-as-sum |
                                                        toInt(m) = int_add(toInt(c), toInt(mn))
                                                        [by rewrite sum-with-mn sum-image-raw]
                                                      @m-image-closed |
                                                        toInt(m) = int_add(toInt(c), pow(p, e))
                                                        [by rewrite mn-image m-image-as-sum]
                                                      @n-is-m-image |
                                                        N = toInt(m)
                                                        [by symmetry m-image]
                                                      @power-is-m-image |
                                                        pow(p, int_succ(e)) = toInt(m)
                                                        [by rewrite modulus n-is-m-image]
                                                      @product-is-sum |
                                                        int_mul(pow(p, e), p) = int_add(toInt(c), pow(p, e))
                                                        [using chain power-unfolds-flipped power-is-m-image m-image-closed]
                                                      @power-unfolds-flipped |
                                                        int_mul(pow(p, e), p) = pow(p, int_succ(e))
                                                        [by symmetry power-unfolds]
                                                      @sum-is-product |
                                                        int_add(toInt(c), pow(p, e)) = int_mul(pow(p, e), p)
                                                        [by symmetry product-is-sum]
                                                      @c-recovered |
                                                        toInt(c) = int_add(int_add(toInt(c), pow(p, e)), int_neg(pow(p, e)))
                                                        [using polynomial(integer)]
                                                      @c-from-product |
                                                        toInt(c) = int_add(int_mul(pow(p, e), p), int_neg(pow(p, e)))
                                                        [by rewrite sum-is-product c-recovered]
                                                      @closed-form |
                                                        int_add(int_mul(pow(p, e), p), int_neg(pow(p, e))) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                                        [using polynomial(integer)]
                                                      @count |
                                                        toInt(c) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                                        [using chain c-from-product closed-form]
                                                      @packaged |
                                                        (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                                        [using tautology v-generates v-injective v-covers count]
                                                      @conclusion-with-count |
                                                        exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                                        [by witness(c) packaged]
                                                    }
                                                  @conclusion-with-u |
                                                    exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                                    [by unpacked with-u]
                                                }
                                              @conclusion-with-d |
                                                exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                                [by unpacked with-d]
                                            }
                                          @conclusion-with-v2 |
                                            exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                            [by unpacked with-v2]
                                        }
                                      @conclusion-with-c |
                                        exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                        [by unpacked with-c]
                                      @conclusion-with-v-inner |
                                        exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                        [by witness(v) conclusion-with-c]
                                    }
                                  @conclusion-with-v |
                                    exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                    [by unpacked with-v]
                                }
                              @conclusion-with-w |
                                exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                                [by unpacked with-w]
                            }
                          @conclusion-with-m |
                            exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                            [by unpacked with-m]
                        }
                      @conclusion-counted |
                        exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                        [by unpacked with-mn]
                    }
                  @modulus-implies |
                    N = pow(p, int_succ(e)) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                    [by discharge given-modulus]
                }
              @nonneg-implies |
                nonneg(e) -> N = pow(p, int_succ(e)) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
                [by discharge given-nonneg]
            }
          @prime-implies |
            is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
            [by discharge given-prime]
        }
      @discharge-e |
        forall e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = int_mul(pow(p, e), int_sub(p, INT_ONE))
        [by generalize generalize-e]
    }
  @conclusion |
    forall p, e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, int_succ(e)) -> exists v: ZnSeq; exists c: Nat; (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = int_mul(pow(p, e), int_sub(p, INT_ONE))
    [by generalize generalize-p]
qed
