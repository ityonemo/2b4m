// std/integer/mod-n-generators.b4m — WHICH classes generate ℤ_N, and HOW MANY when N = pq
// (Judson §4.1: the corollary "r generates ℤ_n iff gcd(r, n) = 1", and exercise 24).
//
// cls(r) generates ℤ_N iff r is Bézout-coprime to N (r s + N t = 1 for some s, t): the
// identity puts cls(1) = s·cls(r) in ⟨cls(r)⟩, and conversely cls(1) = k·cls(r) IS such an
// identity. For N = pq with p ≠ q prime, cls(r) fails to generate exactly when p | r or
// q | r; the non-generators are listed explicitly — cls(kp) for k < q and cls(kq) for
// 0 < k < p, p + q − 1 in all — so the generators number pq − (p + q − 1) = (p − 1)(q − 1).

import integer <<< "std/integer.b4m"
import int_order <<< "std/integer/order.b4m"
import int_divides <<< "std/integer/divides.b4m"
import int_embedding <<< "std/integer/embedding.b4m"
import primes <<< "std/primes.b4m"
import mod_n <<< "std/integer/mod-n.b4m"
import mod_n_listing <<< "std/integer/mod-n-listing.b4m"
import mod_n_prime <<< "std/integer/mod-n-prime.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import permutation_count <<< "std/permutation/count.b4m"

// ℤ
sort Int = integer.Int
const IZERO = integer.ZERO
const IONE = integer.ONE
func iadd = integer.add
func imul = integer.mul
func isub = integer.sub
func ineg = integer.neg
func isucc = integer.succ
pred int_less_than = int_order.less_than
pred nonneg = integer.nonneg
define divides(d, k) = int_divides.divides(d, k)
define is_prime(p) = primes.is_prime(p)
axiom definitionOfSubtraction = integer.definitionOfSubtraction
theorem intLessThanIrreflexive = int_order.lessThanIrreflexive
theorem intLessThanTransitive = int_order.lessThanTransitive
theorem intZeroLessThanOne = int_order.zeroLessThanOne
theorem dividesZero = int_divides.dividesZero
theorem dividesAdd = int_divides.dividesAdd
theorem dividesMul = int_divides.dividesMul
theorem dividesIntro = int_divides.dividesIntro
theorem coprimeBezout = int_divides.coprimeBezout
theorem coprimalityFromPrime = primes.coprimalityFromPrime
theorem primeDoesNotDivideOne = primes.primeDoesNotDivideOne
theorem intMulIsAssociative = int_divides.mulIsAssociative
theorem intMulIsCommutative = int_divides.mulIsCommutative
theorem dividesNeg = int_divides.dividesNeg
theorem negOfDifferenceSwaps = int_divides.negOfDifferenceSwaps
theorem boundedRemainderDifferenceIsZero = int_divides.boundedRemainderDifferenceIsZero
theorem intLessOrEqualIsGapExistential = int_order.lessOrEqualIsGapExistential
theorem atMostThenLessThan = int_divides.atMostThenLessThan
theorem mulCancelLeft = int_divides.mulCancelLeft
theorem divisorAtMost = int_divides.divisorAtMost
theorem dividesSubtracts = int_divides.dividesSubtracts
theorem divisionAlgorithmExists = int_divides.divisionAlgorithmExists
theorem euclidsLemma = primes.euclidsLemma
theorem intAddZeroLeft = integer.addZeroLeft
theorem intMulZeroLeft = integer.mulZeroLeft
theorem succOfNonnegIsPositive = int_divides.succOfNonnegIsPositive
define int_at_most(a, b) = int_order.less_or_equal(a, b)
func toInt = int_embedding.toInt
axiom toIntZero = int_embedding.toIntZero
axiom toIntSucc = int_embedding.toIntSucc
theorem toIntNonneg = int_embedding.toIntNonneg
theorem toIntPreservesOrder = int_embedding.toIntPreservesOrder
theorem toIntReflectsOrder = int_embedding.toIntReflectsOrder
theorem toIntInjective = int_embedding.toIntInjective
theorem everyNonnegIsAnImage = int_embedding.everyNonnegIsAnImage
theorem zeroDifferenceMeansEqual = mod_n_listing.zeroDifferenceMeansEqual
theorem lessThanGivesNonnegDifference = int_divides.lessThanGivesNonnegDifference
theorem positiveIsNonneg = int_order.positiveIsNonneg
theorem toIntAdd = int_embedding.toIntAdd
axiom oneIsSuccZero = integer.oneIsSuccZero
theorem intAddSuccRight = integer.addSuccRight
theorem intAddZeroRight = integer.addZeroRight
theorem znIsListedByItsRepresentatives = mod_n_listing.znIsListedByItsRepresentatives
theorem znGeneratorsAndNonGeneratorsAreListed = mod_n_listing.znGeneratorsAndNonGeneratorsAreListed
theorem znListingsOfTheSameClassHaveEqualLength = mod_n_listing.znListingsOfTheSameClassHaveEqualLength
func pow = int_divides.pow
axiom powZero = int_divides.powZero
axiom powSucc = int_divides.powSucc
axiom nonnegInduction = int_order.nonnegInduction
axiom nonnegSucc = integer.nonnegSucc
theorem productWithPositiveIsPositive = int_divides.productWithPositiveIsPositive

// ℕ, the index sort
sort Nat = peano.Nat
const NZERO = peano.ZERO
func succ = peano.succ
func nadd = peano.add
pred less_than = peano.less_than
axiom induction = peano.induction
axiom succInjective = peano.succInjective
theorem zeroOrSucc = peano.zeroOrSucc
theorem addZeroRight = peano.addZeroRight
theorem notLessThanZero = peano_order.notLessThanZero
theorem lessThanSelf = peano_order.lessThanSelf
theorem lessThanSuccSplit = peano_order.lessThanSuccSplit
theorem lessThanIrreflexive = peano_order.lessThanIrreflexive
theorem trichotomy = peano_order.trichotomy
theorem succPreservesOrder = peano_order.succPreservesOrder
theorem succReflectsOrder = peano_order.succReflectsOrder
theorem additionPreservesOrder = peano_order.additionPreservesOrder
theorem indexSplits = permutation_count.indexSplits
theorem belowTheBaseIsBelowTheSum = permutation_count.belowTheBaseIsBelowTheSum

// sequences of classes
sort ZnSeq = mod_n_listing.ZnSeq
func znAt = mod_n_listing.znAt
func znProductUpTo = mod_n_listing.znProductUpTo
axiom znSeqSingleton = mod_n_listing.znSeqSingleton
axiom znSeqConcat = mod_n_listing.znSeqConcat

// ℤ_N
sort Zn = mod_n.Zn
func cls = mod_n.cls
const N = mod_n.N
const ZERO = mod_n.ZERO
func add = mod_n.add
func znPower = mod_n.znPower
axiom nPositive = mod_n.nPositive
axiom clsSurjective = mod_n.clsSurjective
axiom clsCongruent = mod_n.clsCongruent
axiom addHom = mod_n.addHom
axiom znPowerDef = mod_n.znPowerDef
axiom zeroIsClsZero = mod_n.zeroIsClsZero
theorem addIdentityRight = mod_n.addIdentityRight
theorem znIsCyclic = mod_n.znIsCyclic
theorem multipleOfModulusIsZero = mod_n_prime.multipleOfModulusIsZero
define generates(z) = mod_n_listing.generates(z)

// r is BÉZOUT-COPRIME to n: r s + n t = 1 for some integers s, t (equivalently gcd(r, n) = 1).
define bezoutCoprime(r, n) = exists s: Int; exists t: Int; iadd(imul(r, s), imul(n, t)) = IONE

// -- powers of powers in ℤ_N: k·(s·cls(r)) = (k s)·cls(r) ------------------------------------
theorem znPowerOfPower: forall r, s, k: Int; znPower(znPower(cls(r), s), k) = znPower(cls(r), imul(k, s))
proof
  @generalize-r |
    fix r: Int {
      @generalize-s |
        fix s: Int {
          @generalize-k |
            fix k: Int {
              @inner |
                znPower(cls(r), s) = cls(imul(s, r))
                [using specialize znPowerDef(r, s)]
              @outer-reflexive |
                znPower(znPower(cls(r), s), k) = znPower(znPower(cls(r), s), k)
                [by reflexivity]
              @outer-with-inner |
                znPower(znPower(cls(r), s), k) = znPower(cls(imul(s, r)), k)
                [by rewrite inner outer-reflexive]
              @outer-unfolds |
                znPower(cls(imul(s, r)), k) = cls(imul(k, imul(s, r)))
                [using specialize znPowerDef(imul(s, r), k)]
              @regrouped |
                imul(k, imul(s, r)) = imul(imul(k, s), r)
                [using polynomial(integer)]
              @outer-as-class |
                znPower(znPower(cls(r), s), k) = cls(imul(imul(k, s), r))
                [using simplify outer-with-inner outer-unfolds regrouped]
              @combined-power |
                znPower(cls(r), imul(k, s)) = cls(imul(imul(k, s), r))
                [using specialize znPowerDef(r, imul(k, s))]
              @combined-power-flipped |
                cls(imul(imul(k, s), r)) = znPower(cls(r), imul(k, s))
                [by symmetry combined-power]
              @conclusion-power-of-power |
                znPower(znPower(cls(r), s), k) = znPower(cls(r), imul(k, s))
                [using chain outer-as-class combined-power-flipped]
            }
          @discharge-k |
            forall k: Int; znPower(znPower(cls(r), s), k) = znPower(cls(r), imul(k, s))
            [by forall_intro generalize-k]
        }
      @discharge-s |
        forall s, k: Int; znPower(znPower(cls(r), s), k) = znPower(cls(r), imul(k, s))
        [by forall_intro generalize-s]
    }
  @conclusion |
    forall r, s, k: Int; znPower(znPower(cls(r), s), k) = znPower(cls(r), imul(k, s))
    [by forall_intro generalize-r]
qed

// -- THE GENERATOR CRITERION: cls(r) generates ℤ_N ⟺ r is Bézout-coprime to N --------------
theorem generatesIffBezoutCoprime: forall r: Int; generates(cls(r)) iff bezoutCoprime(r, N)
proof
  @generalize-r |
    fix r: Int {
      // ⟸: cls(1) = cls(r s + N t) = s·cls(r), and cls(1) generates.
      @given-coprime |
        assume bezoutCoprime(r, N) {
          @bezout-exists |
            exists s: Int; exists t: Int; iadd(imul(r, s), imul(N, t)) = IONE
            [by hypothesis given-coprime]
          @with-bezout-s |
            unpack s: Int from bezout-exists {
              @t-exists |
                exists t: Int; iadd(imul(r, s), imul(N, t)) = IONE
                [by hypothesis with-bezout-s]
              @with-bezout-t |
                unpack t: Int from t-exists {
                  @bezout-identity |
                    iadd(imul(r, s), imul(N, t)) = IONE
                    [by hypothesis with-bezout-t]
                  @one-class-splits |
                    add(cls(imul(r, s)), cls(imul(N, t))) = cls(iadd(imul(r, s), imul(N, t)))
                    [using specialize addHom(imul(r, s), imul(N, t))]
                  @one-class-as-sum |
                    add(cls(imul(r, s)), cls(imul(N, t))) = cls(IONE)
                    [by rewrite bezout-identity one-class-splits]
                  @n-divides-n |
                    divides(N, N)
                    [using specialize int_divides.dividesRefl(N)]
                  @n-divides-nt |
                    divides(N, imul(N, t))
                    [using specialize dividesMul(N, N, t) n-divides-n]
                  @nt-class-is-zero |
                    cls(imul(N, t)) = ZERO
                    [using specialize multipleOfModulusIsZero(imul(N, t)) n-divides-nt]
                  @rs-commutes |
                    imul(r, s) = imul(s, r)
                    [using specialize intMulIsCommutative(r, s)]
                  @s-multiple |
                    znPower(cls(r), s) = cls(imul(s, r))
                    [using specialize znPowerDef(r, s)]
                  @rs-class-is-multiple |
                    cls(imul(r, s)) = znPower(cls(r), s)
                    [using simplify rs-commutes s-multiple]
                  @one-class-as-sum-with-zero |
                    add(cls(imul(r, s)), ZERO) = cls(IONE)
                    [by rewrite nt-class-is-zero one-class-as-sum]
                  @one-class-as-multiple-plus-zero |
                    add(znPower(cls(r), s), ZERO) = cls(IONE)
                    [by rewrite rs-class-is-multiple one-class-as-sum-with-zero]
                  @multiple-plus-zero |
                    add(znPower(cls(r), s), ZERO) = znPower(cls(r), s)
                    [using specialize addIdentityRight(znPower(cls(r), s))]
                  @one-class-is-multiple-plus-zero |
                    cls(IONE) = add(znPower(cls(r), s), ZERO)
                    [by symmetry one-class-as-multiple-plus-zero]
                  @one-class-is-multiple |
                    cls(IONE) = znPower(cls(r), s)
                    [using chain one-class-is-multiple-plus-zero multiple-plus-zero]
                  @generalize-y |
                    fix y: Zn {
                      @y-is-multiple-of-one |
                        exists k: Int; y = znPower(cls(IONE), k)
                        [using specialize znIsCyclic(y)]
                      @with-exponent-k |
                        unpack k: Int from y-is-multiple-of-one {
                          @y-is-k-multiple-of-one |
                            y = znPower(cls(IONE), k)
                            [by hypothesis with-exponent-k]
                          @y-is-k-multiple-of-s-multiple |
                            y = znPower(znPower(cls(r), s), k)
                            [by rewrite one-class-is-multiple y-is-k-multiple-of-one]
                          @power-of-power |
                            znPower(znPower(cls(r), s), k) = znPower(cls(r), imul(k, s))
                            [using specialize znPowerOfPower(r, s, k)]
                          @y-is-multiple-of-r |
                            y = znPower(cls(r), imul(k, s))
                            [using chain y-is-k-multiple-of-s-multiple power-of-power]
                          @conclusion-y-generated-inner |
                            exists k2: Int; y = znPower(cls(r), k2)
                            [by exists_intro(imul(k, s)) y-is-multiple-of-r]
                        }
                      @conclusion-y-generated |
                        exists k2: Int; y = znPower(cls(r), k2)
                        [by exists_elim with-exponent-k]
                    }
                  @conclusion-generates-inner |
                    generates(cls(r))
                    [by forall_intro generalize-y]
                }
              @conclusion-with-t |
                generates(cls(r))
                [by exists_elim with-bezout-t]
            }
          @conclusion-generates |
            generates(cls(r))
            [by exists_elim with-bezout-s]
        }
      @backward |
        bezoutCoprime(r, N) -> generates(cls(r))
        [by implies_intro given-coprime]
      // ⟹: cls(1) = k·cls(r) = cls(k r), so N | 1 − k r, i.e. r k + N t = 1.
      @given-generates |
        assume generates(cls(r)) {
          @generates-r |
            forall y: Zn; exists k: Int; y = znPower(cls(r), k)
            [by hypothesis given-generates]
          @one-generated |
            exists k: Int; cls(IONE) = znPower(cls(r), k)
            [using specialize generates-r(cls(IONE))]
          @with-exponent-k |
            unpack k: Int from one-generated {
              @one-is-k-multiple |
                cls(IONE) = znPower(cls(r), k)
                [by hypothesis with-exponent-k]
              @k-multiple |
                znPower(cls(r), k) = cls(imul(k, r))
                [using specialize znPowerDef(r, k)]
              @one-class-is-kr-class |
                cls(IONE) = cls(imul(k, r))
                [using chain one-is-k-multiple k-multiple]
              @congruent-iff |
                cls(IONE) = cls(imul(k, r)) iff divides(N, isub(IONE, imul(k, r)))
                [using specialize clsCongruent(IONE, imul(k, r))]
              @n-divides-difference |
                divides(N, isub(IONE, imul(k, r)))
                [using tautology congruent-iff one-class-is-kr-class]
              @with-cofactor-t |
                unpack t: Int from n-divides-difference {
                  @difference-is-nt |
                    isub(IONE, imul(k, r)) = imul(N, t)
                    [by hypothesis with-cofactor-t]
                  @difference-unfolds |
                    isub(IONE, imul(k, r)) = iadd(IONE, ineg(imul(k, r)))
                    [using specialize definitionOfSubtraction(IONE, imul(k, r))]
                  @unfolded-is-difference |
                    iadd(IONE, ineg(imul(k, r))) = isub(IONE, imul(k, r))
                    [by symmetry difference-unfolds]
                  @unfolded-is-nt |
                    iadd(IONE, ineg(imul(k, r))) = imul(N, t)
                    [using chain unfolded-is-difference difference-is-nt]
                  @one-recovered |
                    IONE = iadd(imul(r, k), iadd(IONE, ineg(imul(k, r))))
                    [using polynomial(integer)]
                  @one-as-bezout |
                    IONE = iadd(imul(r, k), imul(N, t))
                    [by rewrite unfolded-is-nt one-recovered]
                  @bezout-identity |
                    iadd(imul(r, k), imul(N, t)) = IONE
                    [by symmetry one-as-bezout]
                  @t-witnesses |
                    exists t2: Int; iadd(imul(r, k), imul(N, t2)) = IONE
                    [by exists_intro(t) bezout-identity]
                  @conclusion-coprime-inner |
                    bezoutCoprime(r, N)
                    [by exists_intro(k) t-witnesses]
                }
              @conclusion-with-t |
                bezoutCoprime(r, N)
                [by exists_elim with-cofactor-t]
            }
          @conclusion-coprime |
            bezoutCoprime(r, N)
            [by exists_elim with-exponent-k]
        }
      @forward |
        generates(cls(r)) -> bezoutCoprime(r, N)
        [by implies_intro given-generates]
      @conclusion-iff |
        generates(cls(r)) iff bezoutCoprime(r, N)
        [by iff_intro forward backward]
    }
  @conclusion |
    forall r: Int; generates(cls(r)) iff bezoutCoprime(r, N)
    [by forall_intro generalize-r]
qed

// -- for N = pq with p ≠ q prime: cls(r) fails to generate ⟺ p | r or q | r ------------------

// a prime is nonzero (it exceeds 1).
theorem primeIsNonzero: forall p: Int; is_prime(p) -> p != IZERO
proof
  @generalize-p |
    fix p: Int {
      @given-prime |
        assume is_prime(p) {
          @prime-facts |
            int_less_than(IONE, p) and (forall d: Int; int_less_than(IZERO, d) -> divides(d, p) -> (d = IONE or d = p))
            [by hypothesis given-prime]
          @one-below-p |
            int_less_than(IONE, p)
            [using tautology prime-facts]
          @zero-below-one |
            int_less_than(IZERO, IONE)
            [by cite intZeroLessThanOne]
          @zero-not-below-itself |
            not int_less_than(IZERO, IZERO)
            [using specialize intLessThanIrreflexive(IZERO)]
          @given-p-zero |
            assume p = IZERO {
              @p-zero |
                p = IZERO
                [by hypothesis given-p-zero]
              @one-below-zero |
                int_less_than(IONE, IZERO)
                [by rewrite p-zero one-below-p]
              @zero-below-itself |
                int_less_than(IZERO, IZERO)
                [using specialize intLessThanTransitive(IZERO, IONE, IZERO) zero-below-one one-below-zero]
            }
          @p-zero-implies |
            p = IZERO -> int_less_than(IZERO, IZERO)
            [by implies_intro given-p-zero]
          @conclusion-nonzero |
            p != IZERO
            [using tautology p-zero-implies zero-not-below-itself]
        }
      @prime-implies |
        is_prime(p) -> p != IZERO
        [by implies_intro given-prime]
    }
  @conclusion |
    forall p: Int; is_prime(p) -> p != IZERO
    [by forall_intro generalize-p]
qed

// p ∤ r ⟹ r is Bézout-coprime to p (the only common divisors are ±1).
theorem primeNotDividingGivesBezout: forall p, r: Int; is_prime(p) -> (not divides(p, r)) -> bezoutCoprime(r, p)
proof
  @generalize-p |
    fix p: Int {
      @generalize-r |
        fix r: Int {
          @given-prime |
            assume is_prime(p) {
              @given-not-dividing |
                assume not divides(p, r) {
                  @prime |
                    is_prime(p)
                    [by hypothesis given-prime]
                  @not-dividing |
                    not divides(p, r)
                    [by hypothesis given-not-dividing]
                  @p-nonzero |
                    p != IZERO
                    [using specialize primeIsNonzero(p) prime]
                  @p-divides-zero |
                    divides(p, IZERO)
                    [using specialize dividesZero(p)]
                  @given-r-zero |
                    assume r = IZERO {
                      @r-zero |
                        r = IZERO
                        [by hypothesis given-r-zero]
                      @p-divides-r |
                        divides(p, r)
                        [by rewrite r-zero p-divides-zero]
                    }
                  @r-zero-implies |
                    r = IZERO -> divides(p, r)
                    [by implies_intro given-r-zero]
                  @r-nonzero |
                    r != IZERO
                    [using tautology r-zero-implies not-dividing]
                  @common-divisors-are-units |
                    forall e: Int; divides(e, r) -> divides(e, p) -> (e = IONE or e = ineg(IONE))
                    [using specialize coprimalityFromPrime(p, r) prime not-dividing]
                  @conclusion-bezout |
                    bezoutCoprime(r, p)
                    [using specialize coprimeBezout(r, p) r-nonzero p-nonzero common-divisors-are-units]
                }
              @not-dividing-implies |
                (not divides(p, r)) -> bezoutCoprime(r, p)
                [by implies_intro given-not-dividing]
            }
          @prime-implies |
            is_prime(p) -> (not divides(p, r)) -> bezoutCoprime(r, p)
            [by implies_intro given-prime]
        }
      @discharge-r |
        forall r: Int; is_prime(p) -> (not divides(p, r)) -> bezoutCoprime(r, p)
        [by forall_intro generalize-r]
    }
  @conclusion |
    forall p, r: Int; is_prime(p) -> (not divides(p, r)) -> bezoutCoprime(r, p)
    [by forall_intro generalize-p]
qed

// Bézout-coprime to p and to q ⟹ Bézout-coprime to pq (multiply the two identities).
theorem bezoutCoprimeMultiplies: forall r, p, q: Int; bezoutCoprime(r, p) -> bezoutCoprime(r, q) -> bezoutCoprime(r, imul(p, q))
proof
  @generalize-r |
    fix r: Int {
      @generalize-p |
        fix p: Int {
          @generalize-q |
            fix q: Int {
              @given-p |
                assume bezoutCoprime(r, p) {
                  @given-q |
                    assume bezoutCoprime(r, q) {
                      @p-identity-exists |
                        exists s: Int; exists t: Int; iadd(imul(r, s), imul(p, t)) = IONE
                        [by hypothesis given-p]
                      @q-identity-exists |
                        exists s: Int; exists t: Int; iadd(imul(r, s), imul(q, t)) = IONE
                        [by hypothesis given-q]
                      @with-a |
                        unpack a: Int from p-identity-exists {
                          @b-exists |
                            exists t: Int; iadd(imul(r, a), imul(p, t)) = IONE
                            [by hypothesis with-a]
                          @with-b |
                            unpack b: Int from b-exists {
                              @p-identity |
                                iadd(imul(r, a), imul(p, b)) = IONE
                                [by hypothesis with-b]
                              @with-c |
                                unpack c: Int from q-identity-exists {
                                  @d-exists |
                                    exists t: Int; iadd(imul(r, c), imul(q, t)) = IONE
                                    [by hypothesis with-c]
                                  @with-d |
                                    unpack d: Int from d-exists {
                                      @q-identity |
                                        iadd(imul(r, c), imul(q, d)) = IONE
                                        [by hypothesis with-d]
                                      @product-expands |
                                        imul(iadd(imul(r, a), imul(p, b)), iadd(imul(r, c), imul(q, d))) = iadd(imul(r, iadd(iadd(imul(imul(a, r), c), imul(imul(a, q), d)), imul(imul(p, b), c))), imul(imul(p, q), imul(b, d)))
                                        [using polynomial(integer)]
                                      @product-with-p-identity |
                                        imul(IONE, iadd(imul(r, c), imul(q, d))) = iadd(imul(r, iadd(iadd(imul(imul(a, r), c), imul(imul(a, q), d)), imul(imul(p, b), c))), imul(imul(p, q), imul(b, d)))
                                        [by rewrite p-identity product-expands]
                                      @product-of-ones |
                                        imul(IONE, IONE) = iadd(imul(r, iadd(iadd(imul(imul(a, r), c), imul(imul(a, q), d)), imul(imul(p, b), c))), imul(imul(p, q), imul(b, d)))
                                        [by rewrite q-identity product-with-p-identity]
                                      @one-times-one |
                                        imul(IONE, IONE) = IONE
                                        [using specialize integer.mulOneLeft(IONE)]
                                      @combined-flipped |
                                        iadd(imul(r, iadd(iadd(imul(imul(a, r), c), imul(imul(a, q), d)), imul(imul(p, b), c))), imul(imul(p, q), imul(b, d))) = imul(IONE, IONE)
                                        [by symmetry product-of-ones]
                                      @combined-identity |
                                        iadd(imul(r, iadd(iadd(imul(imul(a, r), c), imul(imul(a, q), d)), imul(imul(p, b), c))), imul(imul(p, q), imul(b, d))) = IONE
                                        [using chain combined-flipped one-times-one]
                                      @t-witnesses |
                                        exists t: Int; iadd(imul(r, iadd(iadd(imul(imul(a, r), c), imul(imul(a, q), d)), imul(imul(p, b), c))), imul(imul(p, q), t)) = IONE
                                        [by exists_intro(imul(b, d)) combined-identity]
                                      @conclusion-coprime-inner |
                                        bezoutCoprime(r, imul(p, q))
                                        [by exists_intro(iadd(iadd(imul(imul(a, r), c), imul(imul(a, q), d)), imul(imul(p, b), c))) t-witnesses]
                                    }
                                  @conclusion-with-d |
                                    bezoutCoprime(r, imul(p, q))
                                    [by exists_elim with-d]
                                }
                              @conclusion-with-c |
                                bezoutCoprime(r, imul(p, q))
                                [by exists_elim with-c]
                            }
                          @conclusion-with-b |
                            bezoutCoprime(r, imul(p, q))
                            [by exists_elim with-b]
                        }
                      @conclusion-with-a |
                        bezoutCoprime(r, imul(p, q))
                        [by exists_elim with-a]
                    }
                  @q-implies |
                    bezoutCoprime(r, q) -> bezoutCoprime(r, imul(p, q))
                    [by implies_intro given-q]
                }
              @p-implies |
                bezoutCoprime(r, p) -> bezoutCoprime(r, q) -> bezoutCoprime(r, imul(p, q))
                [by implies_intro given-p]
            }
          @discharge-q |
            forall q: Int; bezoutCoprime(r, p) -> bezoutCoprime(r, q) -> bezoutCoprime(r, imul(p, q))
            [by forall_intro generalize-q]
        }
      @discharge-p |
        forall p, q: Int; bezoutCoprime(r, p) -> bezoutCoprime(r, q) -> bezoutCoprime(r, imul(p, q))
        [by forall_intro generalize-p]
    }
  @conclusion |
    forall r, p, q: Int; bezoutCoprime(r, p) -> bezoutCoprime(r, q) -> bezoutCoprime(r, imul(p, q))
    [by forall_intro generalize-r]
qed

// a prime dividing r blocks any Bézout identity r s + pq t = 1 (it would divide 1).
theorem primeFactorBlocksBezout: forall p, q, r: Int; is_prime(p) -> divides(p, r) -> (not bezoutCoprime(r, imul(p, q)))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @generalize-r |
            fix r: Int {
              @given-prime |
                assume is_prime(p) {
                  @given-divides |
                    assume divides(p, r) {
                      @prime |
                        is_prime(p)
                        [by hypothesis given-prime]
                      @p-divides-r |
                        divides(p, r)
                        [by hypothesis given-divides]
                      @p-not-dividing-one |
                        not divides(p, IONE)
                        [using specialize primeDoesNotDivideOne(p) prime]
                      @given-bezout |
                        assume bezoutCoprime(r, imul(p, q)) {
                          @identity-exists |
                            exists s: Int; exists t: Int; iadd(imul(r, s), imul(imul(p, q), t)) = IONE
                            [by hypothesis given-bezout]
                          @with-s |
                            unpack s: Int from identity-exists {
                              @t-exists |
                                exists t: Int; iadd(imul(r, s), imul(imul(p, q), t)) = IONE
                                [by hypothesis with-s]
                              @with-t |
                                unpack t: Int from t-exists {
                                  @identity |
                                    iadd(imul(r, s), imul(imul(p, q), t)) = IONE
                                    [by hypothesis with-t]
                                  @p-divides-rs |
                                    divides(p, imul(r, s))
                                    [using specialize dividesMul(p, r, s) p-divides-r]
                                  @p-divides-p |
                                    divides(p, p)
                                    [using specialize int_divides.dividesRefl(p)]
                                  @p-divides-pq |
                                    divides(p, imul(p, q))
                                    [using specialize dividesMul(p, p, q) p-divides-p]
                                  @p-divides-pqt |
                                    divides(p, imul(imul(p, q), t))
                                    [using specialize dividesMul(p, imul(p, q), t) p-divides-pq]
                                  @p-divides-sum |
                                    divides(p, iadd(imul(r, s), imul(imul(p, q), t)))
                                    [using specialize dividesAdd(p, imul(r, s), imul(imul(p, q), t)) p-divides-rs p-divides-pqt]
                                  @conclusion-p-divides-one-inner |
                                    divides(p, IONE)
                                    [by rewrite identity p-divides-sum]
                                }
                              @conclusion-with-t |
                                divides(p, IONE)
                                [by exists_elim with-t]
                            }
                          @conclusion-with-s |
                            divides(p, IONE)
                            [by exists_elim with-s]
                        }
                      @bezout-implies |
                        bezoutCoprime(r, imul(p, q)) -> divides(p, IONE)
                        [by implies_intro given-bezout]
                      @conclusion-not-bezout |
                        not bezoutCoprime(r, imul(p, q))
                        [using tautology bezout-implies p-not-dividing-one]
                    }
                  @divides-implies |
                    divides(p, r) -> (not bezoutCoprime(r, imul(p, q)))
                    [by implies_intro given-divides]
                }
              @prime-implies |
                is_prime(p) -> divides(p, r) -> (not bezoutCoprime(r, imul(p, q)))
                [by implies_intro given-prime]
            }
          @discharge-r |
            forall r: Int; is_prime(p) -> divides(p, r) -> (not bezoutCoprime(r, imul(p, q)))
            [by forall_intro generalize-r]
        }
      @discharge-q |
        forall q, r: Int; is_prime(p) -> divides(p, r) -> (not bezoutCoprime(r, imul(p, q)))
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall p, q, r: Int; is_prime(p) -> divides(p, r) -> (not bezoutCoprime(r, imul(p, q)))
    [by forall_intro generalize-p]
qed

// THE NON-GENERATORS OF ℤ_pq are the classes of multiples of p or of q.
theorem nonGeneratorIffPrimeDivides: forall p, q: Int; is_prime(p) -> is_prime(q) -> N = imul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @given-p-prime |
            assume is_prime(p) {
              @given-q-prime |
                assume is_prime(q) {
                  @given-modulus |
                    assume N = imul(p, q) {
                      @p-prime |
                        is_prime(p)
                        [by hypothesis given-p-prime]
                      @q-prime |
                        is_prime(q)
                        [by hypothesis given-q-prime]
                      @modulus |
                        N = imul(p, q)
                        [by hypothesis given-modulus]
                      @generalize-r |
                        fix r: Int {
                          @criterion-at-n |
                            generates(cls(r)) iff bezoutCoprime(r, N)
                            [using specialize generatesIffBezoutCoprime(r)]
                          @criterion |
                            generates(cls(r)) iff bezoutCoprime(r, imul(p, q))
                            [by rewrite modulus criterion-at-n]
                          // p | r or q | r ⟹ no Bézout identity ⟹ not a generator.
                          @p-blocks |
                            divides(p, r) -> (not bezoutCoprime(r, imul(p, q)))
                            [using specialize primeFactorBlocksBezout(p, q, r) p-prime]
                          @q-blocks-swapped |
                            divides(q, r) -> (not bezoutCoprime(r, imul(q, p)))
                            [using specialize primeFactorBlocksBezout(q, p, r) q-prime]
                          @factors-commute |
                            imul(q, p) = imul(p, q)
                            [using specialize intMulIsCommutative(q, p)]
                          @q-blocks |
                            divides(q, r) -> (not bezoutCoprime(r, imul(p, q)))
                            [by rewrite factors-commute q-blocks-swapped]
                          // neither divides ⟹ Bézout identities with p and with q ⟹ with pq.
                          @given-neither |
                            assume (not divides(p, r)) and (not divides(q, r)) {
                              @neither |
                                (not divides(p, r)) and (not divides(q, r))
                                [by hypothesis given-neither]
                              @p-not-dividing |
                                not divides(p, r)
                                [by and_elim_left neither]
                              @q-not-dividing |
                                not divides(q, r)
                                [by and_elim_right neither]
                              @coprime-to-p |
                                bezoutCoprime(r, p)
                                [using specialize primeNotDividingGivesBezout(p, r) p-prime p-not-dividing]
                              @coprime-to-q |
                                bezoutCoprime(r, q)
                                [using specialize primeNotDividingGivesBezout(q, r) q-prime q-not-dividing]
                              @conclusion-coprime-to-product |
                                bezoutCoprime(r, imul(p, q))
                                [using specialize bezoutCoprimeMultiplies(r, p, q) coprime-to-p coprime-to-q]
                            }
                          @neither-implies |
                            ((not divides(p, r)) and (not divides(q, r))) -> bezoutCoprime(r, imul(p, q))
                            [by implies_intro given-neither]
                          @conclusion-characterized |
                            (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                            [using tautology criterion p-blocks q-blocks neither-implies]
                        }
                      @discharge-r |
                        forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                        [by forall_intro generalize-r]
                    }
                  @modulus-implies |
                    N = imul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                    [by implies_intro given-modulus]
                }
              @q-prime-implies |
                is_prime(q) -> N = imul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                [by implies_intro given-q-prime]
            }
          @p-prime-implies |
            is_prime(p) -> is_prime(q) -> N = imul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
            [by implies_intro given-p-prime]
        }
      @discharge-q |
        forall q: Int; is_prime(p) -> is_prime(q) -> N = imul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall p, q: Int; is_prime(p) -> is_prime(q) -> N = imul(p, q) -> forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
    [by forall_intro generalize-p]
qed

// -- index arithmetic --------------------------------------------------------------------------

// two indices below m whose images differ by a multiple of toInt(m) are equal: the difference
// is a bounded multiple, hence 0.
theorem boundedIndicesWithDivisibleDifferenceAreEqual: forall b: Int; forall m: Nat; toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, isub(toInt(i), toInt(j))) -> i = j
proof
  @generalize-b |
    fix b: Int {
      @generalize-m |
        fix m: Nat {
          @given-image |
            assume toInt(m) = b {
              @image |
                toInt(m) = b
                [by hypothesis given-image]
              // the core: for i < j below m, b ∤ toInt(j) − toInt(i) unless they are equal.
              @generalize-i0 |
                fix i0: Nat {
                  @generalize-j0 |
                    fix j0: Nat {
                      @given-i0-below-j0 |
                        assume less_than(i0, j0) {
                          @given-j0-below-m |
                            assume less_than(j0, m) {
                              @given-divides |
                                assume divides(b, isub(toInt(j0), toInt(i0))) {
                                  @i0-below-j0 |
                                    less_than(i0, j0)
                                    [by hypothesis given-i0-below-j0]
                                  @j0-below-m |
                                    less_than(j0, m)
                                    [by hypothesis given-j0-below-m]
                                  @b-divides |
                                    divides(b, isub(toInt(j0), toInt(i0)))
                                    [by hypothesis given-divides]
                                  @i0-image-nonneg |
                                    nonneg(toInt(i0))
                                    [using specialize toIntNonneg(i0)]
                                  @images-ordered |
                                    int_less_than(toInt(i0), toInt(j0))
                                    [using specialize toIntPreservesOrder(i0, j0) i0-below-j0]
                                  @j0-image-below-b-raw |
                                    int_less_than(toInt(j0), toInt(m))
                                    [using specialize toIntPreservesOrder(j0, m) j0-below-m]
                                  @j0-image-below-b |
                                    int_less_than(toInt(j0), b)
                                    [by rewrite image j0-image-below-b-raw]
                                  // b > 0: 0 ≤ toInt(i0) < toInt(j0) < b.
                                  @zero-plus-image |
                                    iadd(IZERO, toInt(i0)) = toInt(i0)
                                    [using specialize intAddZeroLeft(toInt(i0))]
                                  @gap-witnessed |
                                    nonneg(toInt(i0)) and iadd(IZERO, toInt(i0)) = toInt(i0)
                                    [by and_intro i0-image-nonneg zero-plus-image]
                                  @gap-exists |
                                    exists d: Int; nonneg(d) and iadd(IZERO, d) = toInt(i0)
                                    [by exists_intro(toInt(i0)) gap-witnessed]
                                  @gap-iff |
                                    int_at_most(IZERO, toInt(i0)) iff (exists d: Int; nonneg(d) and iadd(IZERO, d) = toInt(i0))
                                    [using specialize intLessOrEqualIsGapExistential(IZERO, toInt(i0))]
                                  @zero-at-most-i0-image |
                                    int_at_most(IZERO, toInt(i0))
                                    [using tautology gap-iff gap-exists]
                                  @zero-below-j0-image |
                                    int_less_than(IZERO, toInt(j0))
                                    [using specialize atMostThenLessThan(IZERO, toInt(i0), toInt(j0)) zero-at-most-i0-image images-ordered]
                                  @b-positive |
                                    int_less_than(IZERO, b)
                                    [using specialize intLessThanTransitive(IZERO, toInt(j0), b) zero-below-j0-image j0-image-below-b]
                                  @difference-is-zero |
                                    isub(toInt(j0), toInt(i0)) = IZERO
                                    [using specialize boundedRemainderDifferenceIsZero(b, toInt(i0), toInt(j0)) b-positive i0-image-nonneg j0-image-below-b images-ordered b-divides]
                                  @images-equal |
                                    toInt(j0) = toInt(i0)
                                    [using specialize zeroDifferenceMeansEqual(toInt(j0), toInt(i0)) difference-is-zero]
                                  @conclusion-indices-equal-core |
                                    j0 = i0
                                    [using specialize toIntInjective(j0, i0) images-equal]
                                }
                              @divides-implies |
                                divides(b, isub(toInt(j0), toInt(i0))) -> j0 = i0
                                [by implies_intro given-divides]
                            }
                          @j0-below-m-implies |
                            less_than(j0, m) -> divides(b, isub(toInt(j0), toInt(i0))) -> j0 = i0
                            [by implies_intro given-j0-below-m]
                        }
                      @i0-below-j0-implies |
                        less_than(i0, j0) -> less_than(j0, m) -> divides(b, isub(toInt(j0), toInt(i0))) -> j0 = i0
                        [by implies_intro given-i0-below-j0]
                    }
                  @discharge-j0 |
                    forall j0: Nat; less_than(i0, j0) -> less_than(j0, m) -> divides(b, isub(toInt(j0), toInt(i0))) -> j0 = i0
                    [by forall_intro generalize-j0]
                }
              @core |
                forall i0: Nat; forall j0: Nat; less_than(i0, j0) -> less_than(j0, m) -> divides(b, isub(toInt(j0), toInt(i0))) -> j0 = i0
                [by forall_intro generalize-i0]
              // trichotomy on the two indices.
              @generalize-i |
                fix i: Nat {
                  @generalize-j |
                    fix j: Nat {
                      @given-i-below-m |
                        assume less_than(i, m) {
                          @given-j-below-m |
                            assume less_than(j, m) {
                              @given-divides |
                                assume divides(b, isub(toInt(i), toInt(j))) {
                                  @i-below-m |
                                    less_than(i, m)
                                    [by hypothesis given-i-below-m]
                                  @j-below-m |
                                    less_than(j, m)
                                    [by hypothesis given-j-below-m]
                                  @b-divides-ij |
                                    divides(b, isub(toInt(i), toInt(j)))
                                    [by hypothesis given-divides]
                                  @negated-iff |
                                    divides(b, isub(toInt(i), toInt(j))) iff divides(b, ineg(isub(toInt(i), toInt(j))))
                                    [using specialize dividesNeg(b, isub(toInt(i), toInt(j)))]
                                  @b-divides-negated |
                                    divides(b, ineg(isub(toInt(i), toInt(j))))
                                    [using tautology negated-iff b-divides-ij]
                                  @negation-swaps |
                                    ineg(isub(toInt(i), toInt(j))) = isub(toInt(j), toInt(i))
                                    [using specialize negOfDifferenceSwaps(toInt(i), toInt(j))]
                                  @b-divides-ji |
                                    divides(b, isub(toInt(j), toInt(i)))
                                    [by rewrite negation-swaps b-divides-negated]
                                  @i-versus-j |
                                    less_than(i, j) or i = j or less_than(j, i)
                                    [using specialize trichotomy(i, j)]
                                  @conclusion-equal |
                                    i = j
                                    case i-versus-j {
                                      @when-below |
                                        assume less_than(i, j) {
                                          @i-below-j |
                                            less_than(i, j)
                                            [by hypothesis when-below]
                                          @j-is-i |
                                            j = i
                                            [using specialize core(i, j) i-below-j j-below-m b-divides-ji]
                                          @conclusion-when-below |
                                            i = j
                                            [by symmetry j-is-i]
                                        }
                                      @when-equal |
                                        assume i = j {
                                          @conclusion-when-equal |
                                            i = j
                                            [by hypothesis when-equal]
                                        }
                                      @when-above |
                                        assume less_than(j, i) {
                                          @j-below-i |
                                            less_than(j, i)
                                            [by hypothesis when-above]
                                          @conclusion-when-above |
                                            i = j
                                            [using specialize core(j, i) j-below-i i-below-m b-divides-ij]
                                        }
                                    }
                                }
                              @divides-implies |
                                divides(b, isub(toInt(i), toInt(j))) -> i = j
                                [by implies_intro given-divides]
                            }
                          @j-below-m-implies |
                            less_than(j, m) -> divides(b, isub(toInt(i), toInt(j))) -> i = j
                            [by implies_intro given-j-below-m]
                        }
                      @i-below-m-implies |
                        less_than(i, m) -> less_than(j, m) -> divides(b, isub(toInt(i), toInt(j))) -> i = j
                        [by implies_intro given-i-below-m]
                    }
                  @discharge-j |
                    forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, isub(toInt(i), toInt(j))) -> i = j
                    [by forall_intro generalize-j]
                }
              @discharge-i |
                forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, isub(toInt(i), toInt(j))) -> i = j
                [by forall_intro generalize-i]
            }
          @image-implies |
            toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, isub(toInt(i), toInt(j))) -> i = j
            [by implies_intro given-image]
        }
      @discharge-m |
        forall m: Nat; toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, isub(toInt(i), toInt(j))) -> i = j
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall b: Int; forall m: Nat; toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, isub(toInt(i), toInt(j))) -> i = j
    [by forall_intro generalize-b]
qed

// the classes of 0·a, 1·a, …, (m−1)·a, listed.
theorem sequenceOfMultiplesExists: forall a: Int; forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(i), a))
proof
  @generalize-a |
    fix a: Int {
      @some-sequence-exists |
        exists s: ZnSeq; znAt(s, NZERO) = ZERO and znProductUpTo(s, succ(NZERO)) = ZERO
        [using specialize znSeqSingleton(ZERO)]
      @base-case-proof |
        unpack s0: ZnSeq from some-sequence-exists {
          @vacuous |
            fix i: Nat {
              @nothing-below-zero |
                not less_than(i, NZERO)
                [using specialize notLessThanZero(i)]
              @conclusion-vacuous-entry |
                less_than(i, NZERO) -> znAt(s0, i) = cls(imul(toInt(i), a))
                [using tautology nothing-below-zero]
            }
          @no-entries |
            forall i: Nat; less_than(i, NZERO) -> znAt(s0, i) = cls(imul(toInt(i), a))
            [by forall_intro vacuous]
          @conclusion-base-witness |
            exists w: ZnSeq; forall i: Nat; less_than(i, NZERO) -> znAt(w, i) = cls(imul(toInt(i), a))
            [by exists_intro(s0) no-entries]
        }
      @base-case |
        exists w: ZnSeq; forall i: Nat; less_than(i, NZERO) -> znAt(w, i) = cls(imul(toInt(i), a))
        [by exists_elim base-case-proof]
      @induction-step |
        fix m: Nat {
          @given-inductive-hypothesis |
            assume exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(i), a)) {
              @inductive-hypothesis |
                exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(i), a))
                [by hypothesis given-inductive-hypothesis]
              @with-prefix-w |
                unpack w: ZnSeq from inductive-hypothesis {
                  @prefix-entries |
                    forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(i), a))
                    [by hypothesis with-prefix-w]
                  @singleton-exists |
                    exists s: ZnSeq; znAt(s, NZERO) = cls(imul(toInt(m), a)) and znProductUpTo(s, succ(NZERO)) = cls(imul(toInt(m), a))
                    [using specialize znSeqSingleton(cls(imul(toInt(m), a)))]
                  @with-singleton-s |
                    unpack s: ZnSeq from singleton-exists {
                      @singleton-facts |
                        znAt(s, NZERO) = cls(imul(toInt(m), a)) and znProductUpTo(s, succ(NZERO)) = cls(imul(toInt(m), a))
                        [by hypothesis with-singleton-s]
                      @singleton-head |
                        znAt(s, NZERO) = cls(imul(toInt(m), a))
                        [by and_elim_left singleton-facts]
                      @concatenation-exists |
                        exists u: ZnSeq; (forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)) and (forall i: Nat; less_than(i, succ(NZERO)) -> znAt(u, nadd(m, i)) = znAt(s, i)) and znProductUpTo(u, nadd(m, succ(NZERO))) = add(znProductUpTo(w, m), znProductUpTo(s, succ(NZERO)))
                        [using specialize znSeqConcat(w, s, m, succ(NZERO))]
                      @with-concatenation-u |
                        unpack u: ZnSeq from concatenation-exists {
                          @concatenation-facts |
                            (forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)) and (forall i: Nat; less_than(i, succ(NZERO)) -> znAt(u, nadd(m, i)) = znAt(s, i)) and znProductUpTo(u, nadd(m, succ(NZERO))) = add(znProductUpTo(w, m), znProductUpTo(s, succ(NZERO)))
                            [by hypothesis with-concatenation-u]
                          @prefix-agrees |
                            forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)
                            [using tautology concatenation-facts]
                          @block-agrees |
                            forall i: Nat; less_than(i, succ(NZERO)) -> znAt(u, nadd(m, i)) = znAt(s, i)
                            [using tautology concatenation-facts]
                          @zero-below-one |
                            less_than(NZERO, succ(NZERO))
                            [using specialize lessThanSelf(NZERO)]
                          @u-at-m-plus-zero |
                            znAt(u, nadd(m, NZERO)) = znAt(s, NZERO)
                            [using specialize block-agrees(NZERO) zero-below-one]
                          @m-plus-zero-is-m |
                            nadd(m, NZERO) = m
                            [using specialize addZeroRight(m)]
                          @u-at-m |
                            znAt(u, m) = znAt(s, NZERO)
                            [by rewrite m-plus-zero-is-m u-at-m-plus-zero]
                          @last-entry |
                            znAt(u, m) = cls(imul(toInt(m), a))
                            [using chain u-at-m singleton-head]
                          @generalize-i |
                            fix i: Nat {
                              @given-i-in-range |
                                assume less_than(i, succ(m)) {
                                  @i-in-range |
                                    less_than(i, succ(m))
                                    [by hypothesis given-i-in-range]
                                  @i-splits |
                                    less_than(i, m) or i = m
                                    [using specialize lessThanSuccSplit(i, m) i-in-range]
                                  @conclusion-entry-i |
                                    znAt(u, i) = cls(imul(toInt(i), a))
                                    case i-splits {
                                      @when-old |
                                        assume less_than(i, m) {
                                          @i-old |
                                            less_than(i, m)
                                            [by hypothesis when-old]
                                          @entry-is-old-entry |
                                            znAt(u, i) = znAt(w, i)
                                            [using specialize prefix-agrees(i) i-old]
                                          @old-entry |
                                            znAt(w, i) = cls(imul(toInt(i), a))
                                            [using specialize prefix-entries(i) i-old]
                                          @conclusion-when-old |
                                            znAt(u, i) = cls(imul(toInt(i), a))
                                            [using chain entry-is-old-entry old-entry]
                                        }
                                      @when-new |
                                        assume i = m {
                                          @i-is-m |
                                            i = m
                                            [by hypothesis when-new]
                                          @conclusion-when-new |
                                            znAt(u, i) = cls(imul(toInt(i), a))
                                            [by rewrite i-is-m last-entry]
                                        }
                                    }
                                }
                              @conclusion-entry-clause |
                                less_than(i, succ(m)) -> znAt(u, i) = cls(imul(toInt(i), a))
                                [by implies_intro given-i-in-range]
                            }
                          @all-entries |
                            forall i: Nat; less_than(i, succ(m)) -> znAt(u, i) = cls(imul(toInt(i), a))
                            [by forall_intro generalize-i]
                          @conclusion-witness-u |
                            exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(i), a))
                            [by exists_intro(u) all-entries]
                        }
                      @conclusion-with-u |
                        exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(i), a))
                        [by exists_elim with-concatenation-u]
                    }
                  @conclusion-with-s |
                    exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(i), a))
                    [by exists_elim with-singleton-s]
                }
              @conclusion-step |
                exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(i), a))
                [by exists_elim with-prefix-w]
            }
          @induction-step-at-m |
            (exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(i), a))) -> (exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(i), a)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-m |
        forall m: Nat; (exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(i), a))) -> (exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(i), a)))
        [by forall_intro induction-step]
      @conclusion-all-lengths |
        forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(i), a))
        [using instantiation induction((fun m: Nat => exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(i), a)))) base-case induction-step-for-all-m]
    }
  @conclusion |
    forall a: Int; forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(i), a))
    [by forall_intro generalize-a]
qed

// the classes of 1·a, 2·a, …, m·a, listed.
theorem sequenceOfShiftedMultiplesExists: forall a: Int; forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(succ(i)), a))
proof
  @generalize-a |
    fix a: Int {
      @some-sequence-exists |
        exists s: ZnSeq; znAt(s, NZERO) = ZERO and znProductUpTo(s, succ(NZERO)) = ZERO
        [using specialize znSeqSingleton(ZERO)]
      @base-case-proof |
        unpack s0: ZnSeq from some-sequence-exists {
          @vacuous |
            fix i: Nat {
              @nothing-below-zero |
                not less_than(i, NZERO)
                [using specialize notLessThanZero(i)]
              @conclusion-vacuous-entry |
                less_than(i, NZERO) -> znAt(s0, i) = cls(imul(toInt(succ(i)), a))
                [using tautology nothing-below-zero]
            }
          @no-entries |
            forall i: Nat; less_than(i, NZERO) -> znAt(s0, i) = cls(imul(toInt(succ(i)), a))
            [by forall_intro vacuous]
          @conclusion-base-witness |
            exists w: ZnSeq; forall i: Nat; less_than(i, NZERO) -> znAt(w, i) = cls(imul(toInt(succ(i)), a))
            [by exists_intro(s0) no-entries]
        }
      @base-case |
        exists w: ZnSeq; forall i: Nat; less_than(i, NZERO) -> znAt(w, i) = cls(imul(toInt(succ(i)), a))
        [by exists_elim base-case-proof]
      @induction-step |
        fix m: Nat {
          @given-inductive-hypothesis |
            assume exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(succ(i)), a)) {
              @inductive-hypothesis |
                exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(succ(i)), a))
                [by hypothesis given-inductive-hypothesis]
              @with-prefix-w |
                unpack w: ZnSeq from inductive-hypothesis {
                  @prefix-entries |
                    forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(succ(i)), a))
                    [by hypothesis with-prefix-w]
                  @singleton-exists |
                    exists s: ZnSeq; znAt(s, NZERO) = cls(imul(toInt(succ(m)), a)) and znProductUpTo(s, succ(NZERO)) = cls(imul(toInt(succ(m)), a))
                    [using specialize znSeqSingleton(cls(imul(toInt(succ(m)), a)))]
                  @with-singleton-s |
                    unpack s: ZnSeq from singleton-exists {
                      @singleton-facts |
                        znAt(s, NZERO) = cls(imul(toInt(succ(m)), a)) and znProductUpTo(s, succ(NZERO)) = cls(imul(toInt(succ(m)), a))
                        [by hypothesis with-singleton-s]
                      @singleton-head |
                        znAt(s, NZERO) = cls(imul(toInt(succ(m)), a))
                        [by and_elim_left singleton-facts]
                      @concatenation-exists |
                        exists u: ZnSeq; (forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)) and (forall i: Nat; less_than(i, succ(NZERO)) -> znAt(u, nadd(m, i)) = znAt(s, i)) and znProductUpTo(u, nadd(m, succ(NZERO))) = add(znProductUpTo(w, m), znProductUpTo(s, succ(NZERO)))
                        [using specialize znSeqConcat(w, s, m, succ(NZERO))]
                      @with-concatenation-u |
                        unpack u: ZnSeq from concatenation-exists {
                          @concatenation-facts |
                            (forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)) and (forall i: Nat; less_than(i, succ(NZERO)) -> znAt(u, nadd(m, i)) = znAt(s, i)) and znProductUpTo(u, nadd(m, succ(NZERO))) = add(znProductUpTo(w, m), znProductUpTo(s, succ(NZERO)))
                            [by hypothesis with-concatenation-u]
                          @prefix-agrees |
                            forall i: Nat; less_than(i, m) -> znAt(u, i) = znAt(w, i)
                            [using tautology concatenation-facts]
                          @block-agrees |
                            forall i: Nat; less_than(i, succ(NZERO)) -> znAt(u, nadd(m, i)) = znAt(s, i)
                            [using tautology concatenation-facts]
                          @zero-below-one |
                            less_than(NZERO, succ(NZERO))
                            [using specialize lessThanSelf(NZERO)]
                          @u-at-m-plus-zero |
                            znAt(u, nadd(m, NZERO)) = znAt(s, NZERO)
                            [using specialize block-agrees(NZERO) zero-below-one]
                          @m-plus-zero-is-m |
                            nadd(m, NZERO) = m
                            [using specialize addZeroRight(m)]
                          @u-at-m |
                            znAt(u, m) = znAt(s, NZERO)
                            [by rewrite m-plus-zero-is-m u-at-m-plus-zero]
                          @last-entry |
                            znAt(u, m) = cls(imul(toInt(succ(m)), a))
                            [using chain u-at-m singleton-head]
                          @generalize-i |
                            fix i: Nat {
                              @given-i-in-range |
                                assume less_than(i, succ(m)) {
                                  @i-in-range |
                                    less_than(i, succ(m))
                                    [by hypothesis given-i-in-range]
                                  @i-splits |
                                    less_than(i, m) or i = m
                                    [using specialize lessThanSuccSplit(i, m) i-in-range]
                                  @conclusion-entry-i |
                                    znAt(u, i) = cls(imul(toInt(succ(i)), a))
                                    case i-splits {
                                      @when-old |
                                        assume less_than(i, m) {
                                          @i-old |
                                            less_than(i, m)
                                            [by hypothesis when-old]
                                          @entry-is-old-entry |
                                            znAt(u, i) = znAt(w, i)
                                            [using specialize prefix-agrees(i) i-old]
                                          @old-entry |
                                            znAt(w, i) = cls(imul(toInt(succ(i)), a))
                                            [using specialize prefix-entries(i) i-old]
                                          @conclusion-when-old |
                                            znAt(u, i) = cls(imul(toInt(succ(i)), a))
                                            [using chain entry-is-old-entry old-entry]
                                        }
                                      @when-new |
                                        assume i = m {
                                          @i-is-m |
                                            i = m
                                            [by hypothesis when-new]
                                          @conclusion-when-new |
                                            znAt(u, i) = cls(imul(toInt(succ(i)), a))
                                            [by rewrite i-is-m last-entry]
                                        }
                                    }
                                }
                              @conclusion-entry-clause |
                                less_than(i, succ(m)) -> znAt(u, i) = cls(imul(toInt(succ(i)), a))
                                [by implies_intro given-i-in-range]
                            }
                          @all-entries |
                            forall i: Nat; less_than(i, succ(m)) -> znAt(u, i) = cls(imul(toInt(succ(i)), a))
                            [by forall_intro generalize-i]
                          @conclusion-witness-u |
                            exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(succ(i)), a))
                            [by exists_intro(u) all-entries]
                        }
                      @conclusion-with-u |
                        exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(succ(i)), a))
                        [by exists_elim with-concatenation-u]
                    }
                  @conclusion-with-s |
                    exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(succ(i)), a))
                    [by exists_elim with-singleton-s]
                }
              @conclusion-step |
                exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(succ(i)), a))
                [by exists_elim with-prefix-w]
            }
          @induction-step-at-m |
            (exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(succ(i)), a))) -> (exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(succ(i)), a)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-m |
        forall m: Nat; (exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(succ(i)), a))) -> (exists w2: ZnSeq; forall i: Nat; less_than(i, succ(m)) -> znAt(w2, i) = cls(imul(toInt(succ(i)), a)))
        [by forall_intro induction-step]
      @conclusion-all-lengths |
        forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(succ(i)), a))
        [using instantiation induction((fun m: Nat => exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(succ(i)), a)))) base-case induction-step-for-all-m]
    }
  @conclusion |
    forall a: Int; forall m: Nat; exists w: ZnSeq; forall i: Nat; less_than(i, m) -> znAt(w, i) = cls(imul(toInt(succ(i)), a))
    [by forall_intro generalize-a]
qed

// -- congruent multiples of a factor of N have congruent coefficients -------------------------
// N = ab with a > 0: cls(x a) = cls(y a) ⟹ ab | (x − y) a ⟹ b | x − y.
theorem congruentMultiplesHaveCongruentCoefficients: forall a, b: Int; N = imul(a, b) -> int_less_than(IZERO, a) -> forall x, y: Int; cls(imul(x, a)) = cls(imul(y, a)) -> divides(b, isub(x, y))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @given-modulus |
            assume N = imul(a, b) {
              @given-a-positive |
                assume int_less_than(IZERO, a) {
                  @modulus |
                    N = imul(a, b)
                    [by hypothesis given-modulus]
                  @a-positive |
                    int_less_than(IZERO, a)
                    [by hypothesis given-a-positive]
                  @generalize-x |
                    fix x: Int {
                      @generalize-y |
                        fix y: Int {
                          @given-congruent |
                            assume cls(imul(x, a)) = cls(imul(y, a)) {
                              @congruent |
                                cls(imul(x, a)) = cls(imul(y, a))
                                [by hypothesis given-congruent]
                              @congruent-iff |
                                cls(imul(x, a)) = cls(imul(y, a)) iff divides(N, isub(imul(x, a), imul(y, a)))
                                [using specialize clsCongruent(imul(x, a), imul(y, a))]
                              @n-divides-difference |
                                divides(N, isub(imul(x, a), imul(y, a)))
                                [using tautology congruent-iff congruent]
                              @ab-divides-difference |
                                divides(imul(a, b), isub(imul(x, a), imul(y, a)))
                                [by rewrite modulus n-divides-difference]
                              @with-cofactor-c |
                                unpack c: Int from ab-divides-difference {
                                  @difference-is-abc |
                                    isub(imul(x, a), imul(y, a)) = imul(imul(a, b), c)
                                    [by hypothesis with-cofactor-c]
                                  @difference-unfolds |
                                    isub(imul(x, a), imul(y, a)) = iadd(imul(x, a), ineg(imul(y, a)))
                                    [using specialize definitionOfSubtraction(imul(x, a), imul(y, a))]
                                  @unfolded-is-difference |
                                    iadd(imul(x, a), ineg(imul(y, a))) = isub(imul(x, a), imul(y, a))
                                    [by symmetry difference-unfolds]
                                  @unfolded-is-abc |
                                    iadd(imul(x, a), ineg(imul(y, a))) = imul(imul(a, b), c)
                                    [using chain unfolded-is-difference difference-is-abc]
                                  @factored-left |
                                    imul(a, iadd(x, ineg(y))) = iadd(imul(x, a), ineg(imul(y, a)))
                                    [using polynomial(integer)]
                                  @factored-right |
                                    imul(imul(a, b), c) = imul(a, imul(b, c))
                                    [using polynomial(integer)]
                                  @scaled-equation |
                                    imul(a, iadd(x, ineg(y))) = imul(a, imul(b, c))
                                    [using chain factored-left unfolded-is-abc factored-right]
                                  @cancelled |
                                    iadd(x, ineg(y)) = imul(b, c)
                                    [using specialize mulCancelLeft(a, iadd(x, ineg(y)), imul(b, c)) a-positive scaled-equation]
                                  @b-divides-unfolded |
                                    divides(b, iadd(x, ineg(y)))
                                    [using specialize dividesIntro(iadd(x, ineg(y)), b, c) cancelled]
                                  @xy-difference-unfolds |
                                    isub(x, y) = iadd(x, ineg(y))
                                    [using specialize definitionOfSubtraction(x, y)]
                                  @conclusion-b-divides |
                                    divides(b, isub(x, y))
                                    [by rewrite xy-difference-unfolds b-divides-unfolded]
                                }
                              @conclusion-with-c |
                                divides(b, isub(x, y))
                                [by exists_elim with-cofactor-c]
                            }
                          @congruent-implies |
                            cls(imul(x, a)) = cls(imul(y, a)) -> divides(b, isub(x, y))
                            [by implies_intro given-congruent]
                        }
                      @discharge-y |
                        forall y: Int; cls(imul(x, a)) = cls(imul(y, a)) -> divides(b, isub(x, y))
                        [by forall_intro generalize-y]
                    }
                  @discharge-x |
                    forall x, y: Int; cls(imul(x, a)) = cls(imul(y, a)) -> divides(b, isub(x, y))
                    [by forall_intro generalize-x]
                }
              @a-positive-implies |
                int_less_than(IZERO, a) -> forall x, y: Int; cls(imul(x, a)) = cls(imul(y, a)) -> divides(b, isub(x, y))
                [by implies_intro given-a-positive]
            }
          @modulus-implies |
            N = imul(a, b) -> int_less_than(IZERO, a) -> forall x, y: Int; cls(imul(x, a)) = cls(imul(y, a)) -> divides(b, isub(x, y))
            [by implies_intro given-modulus]
        }
      @discharge-b |
        forall b: Int; N = imul(a, b) -> int_less_than(IZERO, a) -> forall x, y: Int; cls(imul(x, a)) = cls(imul(y, a)) -> divides(b, isub(x, y))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; N = imul(a, b) -> int_less_than(IZERO, a) -> forall x, y: Int; cls(imul(x, a)) = cls(imul(y, a)) -> divides(b, isub(x, y))
    [by forall_intro generalize-a]
qed

// the listing cls(0·a), …, cls((m−1)·a) does not repeat when N = a·toInt(m), a > 0.
theorem multiplesDoNotRepeat: forall a, b: Int; forall m: Nat; N = imul(a, b) -> int_less_than(IZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @generalize-m |
            fix m: Nat {
              @given-modulus |
                assume N = imul(a, b) {
                  @given-a-positive |
                    assume int_less_than(IZERO, a) {
                      @given-image |
                        assume toInt(m) = b {
                          @modulus |
                            N = imul(a, b)
                            [by hypothesis given-modulus]
                          @a-positive |
                            int_less_than(IZERO, a)
                            [by hypothesis given-a-positive]
                          @image |
                            toInt(m) = b
                            [by hypothesis given-image]
                          @coefficients-congruent |
                            forall x, y: Int; cls(imul(x, a)) = cls(imul(y, a)) -> divides(b, isub(x, y))
                            [using specialize congruentMultiplesHaveCongruentCoefficients(a, b) modulus a-positive]
                          @bounded-indices |
                            forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> divides(b, isub(toInt(i), toInt(j))) -> i = j
                            [using specialize boundedIndicesWithDivisibleDifferenceAreEqual(b, m) image]
                          @generalize-i |
                            fix i: Nat {
                              @generalize-j |
                                fix j: Nat {
                                  @given-i-below |
                                    assume less_than(i, m) {
                                      @given-j-below |
                                        assume less_than(j, m) {
                                          @given-equal-classes |
                                            assume cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) {
                                              @i-below |
                                                less_than(i, m)
                                                [by hypothesis given-i-below]
                                              @j-below |
                                                less_than(j, m)
                                                [by hypothesis given-j-below]
                                              @equal-classes |
                                                cls(imul(toInt(i), a)) = cls(imul(toInt(j), a))
                                                [by hypothesis given-equal-classes]
                                              @b-divides-difference |
                                                divides(b, isub(toInt(i), toInt(j)))
                                                [using specialize coefficients-congruent(toInt(i), toInt(j)) equal-classes]
                                              @conclusion-indices-equal |
                                                i = j
                                                [using specialize bounded-indices(i, j) i-below j-below b-divides-difference]
                                            }
                                          @equal-classes-implies |
                                            cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
                                            [by implies_intro given-equal-classes]
                                        }
                                      @j-below-implies |
                                        less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
                                        [by implies_intro given-j-below]
                                    }
                                  @i-below-implies |
                                    less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
                                    [by implies_intro given-i-below]
                                }
                              @discharge-j |
                                forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
                                [by forall_intro generalize-j]
                            }
                          @discharge-i |
                            forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
                            [by forall_intro generalize-i]
                        }
                      @image-implies |
                        toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
                        [by implies_intro given-image]
                    }
                  @a-positive-implies |
                    int_less_than(IZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
                    [by implies_intro given-a-positive]
                }
              @modulus-implies |
                N = imul(a, b) -> int_less_than(IZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
                [by implies_intro given-modulus]
            }
          @discharge-m |
            forall m: Nat; N = imul(a, b) -> int_less_than(IZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
            [by forall_intro generalize-m]
        }
      @discharge-b |
        forall b: Int; forall m: Nat; N = imul(a, b) -> int_less_than(IZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; forall m: Nat; N = imul(a, b) -> int_less_than(IZERO, a) -> toInt(m) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
    [by forall_intro generalize-a]
qed

// the shifted listing cls(1·a), …, cls(m·a) does not repeat when N = a·toInt(m+1), a > 0.
theorem shiftedMultiplesDoNotRepeat: forall a, b: Int; forall m: Nat; N = imul(a, b) -> int_less_than(IZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @generalize-m |
            fix m: Nat {
              @given-modulus |
                assume N = imul(a, b) {
                  @given-a-positive |
                    assume int_less_than(IZERO, a) {
                      @given-image |
                        assume toInt(succ(m)) = b {
                          @modulus |
                            N = imul(a, b)
                            [by hypothesis given-modulus]
                          @a-positive |
                            int_less_than(IZERO, a)
                            [by hypothesis given-a-positive]
                          @image |
                            toInt(succ(m)) = b
                            [by hypothesis given-image]
                          @unshifted |
                            forall i: Nat; forall j: Nat; less_than(i, succ(m)) -> less_than(j, succ(m)) -> cls(imul(toInt(i), a)) = cls(imul(toInt(j), a)) -> i = j
                            [using specialize multiplesDoNotRepeat(a, b, succ(m)) modulus a-positive image]
                          @generalize-i |
                            fix i: Nat {
                              @generalize-j |
                                fix j: Nat {
                                  @given-i-below |
                                    assume less_than(i, m) {
                                      @given-j-below |
                                        assume less_than(j, m) {
                                          @given-equal-classes |
                                            assume cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) {
                                              @i-below |
                                                less_than(i, m)
                                                [by hypothesis given-i-below]
                                              @j-below |
                                                less_than(j, m)
                                                [by hypothesis given-j-below]
                                              @equal-classes |
                                                cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a))
                                                [by hypothesis given-equal-classes]
                                              @succ-i-below |
                                                less_than(succ(i), succ(m))
                                                [using specialize succPreservesOrder(i, m) i-below]
                                              @succ-j-below |
                                                less_than(succ(j), succ(m))
                                                [using specialize succPreservesOrder(j, m) j-below]
                                              @successors-equal |
                                                succ(i) = succ(j)
                                                [using specialize unshifted(succ(i), succ(j)) succ-i-below succ-j-below equal-classes]
                                              @conclusion-indices-equal |
                                                i = j
                                                [using specialize succInjective(i, j) successors-equal]
                                            }
                                          @equal-classes-implies |
                                            cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
                                            [by implies_intro given-equal-classes]
                                        }
                                      @j-below-implies |
                                        less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
                                        [by implies_intro given-j-below]
                                    }
                                  @i-below-implies |
                                    less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
                                    [by implies_intro given-i-below]
                                }
                              @discharge-j |
                                forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
                                [by forall_intro generalize-j]
                            }
                          @discharge-i |
                            forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
                            [by forall_intro generalize-i]
                        }
                      @image-implies |
                        toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
                        [by implies_intro given-image]
                    }
                  @a-positive-implies |
                    int_less_than(IZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
                    [by implies_intro given-a-positive]
                }
              @modulus-implies |
                N = imul(a, b) -> int_less_than(IZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
                [by implies_intro given-modulus]
            }
          @discharge-m |
            forall m: Nat; N = imul(a, b) -> int_less_than(IZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
            [by forall_intro generalize-m]
        }
      @discharge-b |
        forall b: Int; forall m: Nat; N = imul(a, b) -> int_less_than(IZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; forall m: Nat; N = imul(a, b) -> int_less_than(IZERO, a) -> toInt(succ(m)) = b -> forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> cls(imul(toInt(succ(i)), a)) = cls(imul(toInt(succ(j)), a)) -> i = j
    [by forall_intro generalize-a]
qed

// -- small prime facts -------------------------------------------------------------------------
theorem primeIsPositive: forall p: Int; is_prime(p) -> int_less_than(IZERO, p)
proof
  @generalize-p |
    fix p: Int {
      @given-prime |
        assume is_prime(p) {
          @prime-facts |
            int_less_than(IONE, p) and (forall d: Int; int_less_than(IZERO, d) -> divides(d, p) -> (d = IONE or d = p))
            [by hypothesis given-prime]
          @one-below-p |
            int_less_than(IONE, p)
            [using tautology prime-facts]
          @zero-below-one |
            int_less_than(IZERO, IONE)
            [by cite intZeroLessThanOne]
          @conclusion-positive |
            int_less_than(IZERO, p)
            [using specialize intLessThanTransitive(IZERO, IONE, p) zero-below-one one-below-p]
        }
      @prime-implies |
        is_prime(p) -> int_less_than(IZERO, p)
        [by implies_intro given-prime]
    }
  @conclusion |
    forall p: Int; is_prime(p) -> int_less_than(IZERO, p)
    [by forall_intro generalize-p]
qed

// a prime does not divide a different prime (its only positive divisors are 1 and itself).
theorem primeDoesNotDivideAnotherPrime: forall p, q: Int; is_prime(p) -> is_prime(q) -> p != q -> (not divides(p, q))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @given-p-prime |
            assume is_prime(p) {
              @given-q-prime |
                assume is_prime(q) {
                  @given-distinct |
                    assume p != q {
                      @p-prime |
                        is_prime(p)
                        [by hypothesis given-p-prime]
                      @q-prime-facts |
                        int_less_than(IONE, q) and (forall d: Int; int_less_than(IZERO, d) -> divides(d, q) -> (d = IONE or d = q))
                        [by hypothesis given-q-prime]
                      @distinct |
                        p != q
                        [by hypothesis given-distinct]
                      @p-prime-facts |
                        int_less_than(IONE, p) and (forall d: Int; int_less_than(IZERO, d) -> divides(d, p) -> (d = IONE or d = p))
                        [by hypothesis given-p-prime]
                      @one-below-p |
                        int_less_than(IONE, p)
                        [using tautology p-prime-facts]
                      @q-divisors |
                        forall d: Int; int_less_than(IZERO, d) -> divides(d, q) -> (d = IONE or d = q)
                        [using tautology q-prime-facts]
                      @p-positive |
                        int_less_than(IZERO, p)
                        [using specialize primeIsPositive(p) p-prime]
                      @one-not-below-itself |
                        not int_less_than(IONE, IONE)
                        [using specialize intLessThanIrreflexive(IONE)]
                      @given-divides |
                        assume divides(p, q) {
                          @p-divides-q |
                            divides(p, q)
                            [by hypothesis given-divides]
                          @p-is-one-or-q |
                            p = IONE or p = q
                            [using specialize q-divisors(p) p-positive p-divides-q]
                          @p-is-one |
                            p = IONE
                            [using tautology p-is-one-or-q distinct]
                          @one-below-itself |
                            int_less_than(IONE, IONE)
                            [by rewrite p-is-one one-below-p]
                        }
                      @divides-implies |
                        divides(p, q) -> int_less_than(IONE, IONE)
                        [by implies_intro given-divides]
                      @conclusion-not-dividing |
                        not divides(p, q)
                        [using tautology divides-implies one-not-below-itself]
                    }
                  @distinct-implies |
                    p != q -> (not divides(p, q))
                    [by implies_intro given-distinct]
                }
              @q-prime-implies |
                is_prime(q) -> p != q -> (not divides(p, q))
                [by implies_intro given-q-prime]
            }
          @p-prime-implies |
            is_prime(p) -> is_prime(q) -> p != q -> (not divides(p, q))
            [by implies_intro given-p-prime]
        }
      @discharge-q |
        forall q: Int; is_prime(p) -> is_prime(q) -> p != q -> (not divides(p, q))
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall p, q: Int; is_prime(p) -> is_prime(q) -> p != q -> (not divides(p, q))
    [by forall_intro generalize-p]
qed

// -- the two parts of the listing never meet: cls(i p) ≠ cls((j+1) q) for j + 1 < p ---------------
// pq | i p − (j+1) q would give p | (j+1) q, so p | j+1 (Euclid; p ∤ q), impossible for 0 < j+1 < p.
theorem multipleOfPIsNotAShiftedMultipleOfQ: forall p, q: Int; forall pm: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @generalize-pm |
            fix pm: Nat {
              @given-p-prime |
                assume is_prime(p) {
                  @given-q-prime |
                    assume is_prime(q) {
                      @given-distinct |
                        assume p != q {
                          @given-modulus |
                            assume N = imul(p, q) {
                              @given-image |
                                assume toInt(succ(pm)) = p {
                                  @p-prime |
                                    is_prime(p)
                                    [by hypothesis given-p-prime]
                                  @q-prime |
                                    is_prime(q)
                                    [by hypothesis given-q-prime]
                                  @distinct |
                                    p != q
                                    [by hypothesis given-distinct]
                                  @modulus |
                                    N = imul(p, q)
                                    [by hypothesis given-modulus]
                                  @image |
                                    toInt(succ(pm)) = p
                                    [by hypothesis given-image]
                                  @p-positive |
                                    int_less_than(IZERO, p)
                                    [using specialize primeIsPositive(p) p-prime]
                                  @p-not-dividing-q |
                                    not divides(p, q)
                                    [using specialize primeDoesNotDivideAnotherPrime(p, q) p-prime q-prime distinct]
                                  @p-not-below-itself |
                                    not int_less_than(p, p)
                                    [using specialize intLessThanIrreflexive(p)]
                                  @generalize-i |
                                    fix i: Nat {
                                      @generalize-j |
                                        fix j: Nat {
                                          @given-j-below |
                                            assume less_than(j, pm) {
                                              @j-below |
                                                less_than(j, pm)
                                                [by hypothesis given-j-below]
                                              // 0 < toInt(j+1) < p.
                                              @j-image-nonneg |
                                                nonneg(toInt(j))
                                                [using specialize toIntNonneg(j)]
                                              @succ-j-image |
                                                toInt(succ(j)) = isucc(toInt(j))
                                                [using specialize toIntSucc(j)]
                                              @succ-j-image-positive-raw |
                                                int_less_than(IZERO, isucc(toInt(j)))
                                                [using specialize succOfNonnegIsPositive(toInt(j)) j-image-nonneg]
                                              @succ-j-image-positive |
                                                int_less_than(IZERO, toInt(succ(j)))
                                                [by rewrite succ-j-image succ-j-image-positive-raw]
                                              @succ-j-below |
                                                less_than(succ(j), succ(pm))
                                                [using specialize succPreservesOrder(j, pm) j-below]
                                              @succ-j-image-below-p-raw |
                                                int_less_than(toInt(succ(j)), toInt(succ(pm)))
                                                [using specialize toIntPreservesOrder(succ(j), succ(pm)) succ-j-below]
                                              @succ-j-image-below-p |
                                                int_less_than(toInt(succ(j)), p)
                                                [by rewrite image succ-j-image-below-p-raw]
                                              @given-equal |
                                                assume cls(imul(toInt(i), p)) = cls(imul(toInt(succ(j)), q)) {
                                                  @equal |
                                                    cls(imul(toInt(i), p)) = cls(imul(toInt(succ(j)), q))
                                                    [by hypothesis given-equal]
                                                  @congruent-iff |
                                                    cls(imul(toInt(i), p)) = cls(imul(toInt(succ(j)), q)) iff divides(N, isub(imul(toInt(i), p), imul(toInt(succ(j)), q)))
                                                    [using specialize clsCongruent(imul(toInt(i), p), imul(toInt(succ(j)), q))]
                                                  @n-divides |
                                                    divides(N, isub(imul(toInt(i), p), imul(toInt(succ(j)), q)))
                                                    [using tautology congruent-iff equal]
                                                  @pq-divides |
                                                    divides(imul(p, q), isub(imul(toInt(i), p), imul(toInt(succ(j)), q)))
                                                    [by rewrite modulus n-divides]
                                                  @with-cofactor-c |
                                                    unpack c: Int from pq-divides {
                                                      @difference-is-pqc |
                                                        isub(imul(toInt(i), p), imul(toInt(succ(j)), q)) = imul(imul(p, q), c)
                                                        [by hypothesis with-cofactor-c]
                                                      @difference-unfolds |
                                                        isub(imul(toInt(i), p), imul(toInt(succ(j)), q)) = iadd(imul(toInt(i), p), ineg(imul(toInt(succ(j)), q)))
                                                        [using specialize definitionOfSubtraction(imul(toInt(i), p), imul(toInt(succ(j)), q))]
                                                      @unfolded-is-difference |
                                                        iadd(imul(toInt(i), p), ineg(imul(toInt(succ(j)), q))) = isub(imul(toInt(i), p), imul(toInt(succ(j)), q))
                                                        [by symmetry difference-unfolds]
                                                      @unfolded-is-pqc |
                                                        iadd(imul(toInt(i), p), ineg(imul(toInt(succ(j)), q))) = imul(imul(p, q), c)
                                                        [using chain unfolded-is-difference difference-is-pqc]
                                                      // (j+1) q = i p − pq c = p (i − q c).
                                                      @shifted-recovered |
                                                        imul(toInt(succ(j)), q) = iadd(imul(toInt(i), p), ineg(iadd(imul(toInt(i), p), ineg(imul(toInt(succ(j)), q)))))
                                                        [using polynomial(integer)]
                                                      @shifted-as-difference |
                                                        imul(toInt(succ(j)), q) = iadd(imul(toInt(i), p), ineg(imul(imul(p, q), c)))
                                                        [by rewrite unfolded-is-pqc shifted-recovered]
                                                      @factored |
                                                        iadd(imul(toInt(i), p), ineg(imul(imul(p, q), c))) = imul(p, iadd(toInt(i), ineg(imul(q, c))))
                                                        [using polynomial(integer)]
                                                      @shifted-as-multiple-of-p |
                                                        imul(toInt(succ(j)), q) = imul(p, iadd(toInt(i), ineg(imul(q, c))))
                                                        [using chain shifted-as-difference factored]
                                                      @p-divides-product |
                                                        divides(p, imul(toInt(succ(j)), q))
                                                        [using specialize dividesIntro(imul(toInt(succ(j)), q), p, iadd(toInt(i), ineg(imul(q, c)))) shifted-as-multiple-of-p]
                                                      @euclid |
                                                        divides(p, toInt(succ(j))) or divides(p, q)
                                                        [using specialize euclidsLemma(toInt(succ(j)), q, p) p-prime p-divides-product]
                                                      @p-divides-shift |
                                                        divides(p, toInt(succ(j)))
                                                        [using tautology euclid p-not-dividing-q]
                                                      @p-at-most-shift |
                                                        int_at_most(p, toInt(succ(j)))
                                                        [using specialize divisorAtMost(p, toInt(succ(j))) p-positive succ-j-image-positive p-divides-shift]
                                                      @conclusion-p-below-itself-inner |
                                                        int_less_than(p, p)
                                                        [using specialize atMostThenLessThan(p, toInt(succ(j)), p) p-at-most-shift succ-j-image-below-p]
                                                    }
                                                  @p-below-itself |
                                                    int_less_than(p, p)
                                                    [by exists_elim with-cofactor-c]
                                                }
                                              @equal-implies |
                                                cls(imul(toInt(i), p)) = cls(imul(toInt(succ(j)), q)) -> int_less_than(p, p)
                                                [by implies_intro given-equal]
                                              @conclusion-different |
                                                cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
                                                [using tautology equal-implies p-not-below-itself]
                                            }
                                          @j-below-implies |
                                            less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
                                            [by implies_intro given-j-below]
                                        }
                                      @discharge-j |
                                        forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
                                        [by forall_intro generalize-j]
                                    }
                                  @discharge-i |
                                    forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
                                    [by forall_intro generalize-i]
                                }
                              @image-implies |
                                toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
                                [by implies_intro given-image]
                            }
                          @modulus-implies |
                            N = imul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
                            [by implies_intro given-modulus]
                        }
                      @distinct-implies |
                        p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
                        [by implies_intro given-distinct]
                    }
                  @q-prime-implies |
                    is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
                    [by implies_intro given-q-prime]
                }
              @p-prime-implies |
                is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
                [by implies_intro given-p-prime]
            }
          @discharge-pm |
            forall pm: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
            [by forall_intro generalize-pm]
        }
      @discharge-q |
        forall q: Int; forall pm: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall p, q: Int; forall pm: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
    [by forall_intro generalize-p]
qed

// -- reducing a coefficient modulo the cofactor: cls(c a) = cls(e a) with 0 ≤ e < b when N = ab --
theorem coefficientReducesModCofactor: forall a, b: Int; N = imul(a, b) -> int_less_than(IZERO, b) -> forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(imul(c, a)) = cls(imul(e, a))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @given-modulus |
            assume N = imul(a, b) {
              @given-b-positive |
                assume int_less_than(IZERO, b) {
                  @modulus |
                    N = imul(a, b)
                    [by hypothesis given-modulus]
                  @b-positive |
                    int_less_than(IZERO, b)
                    [by hypothesis given-b-positive]
                  @generalize-c |
                    fix c: Int {
                      @division |
                        exists q0: Int; exists e: Int; c = iadd(imul(b, q0), e) and nonneg(e) and int_less_than(e, b)
                        [using specialize divisionAlgorithmExists(c, b) b-positive]
                      @with-quotient-q0 |
                        unpack q0: Int from division {
                          @remainder-exists |
                            exists e: Int; c = iadd(imul(b, q0), e) and nonneg(e) and int_less_than(e, b)
                            [by hypothesis with-quotient-q0]
                          @with-remainder-e |
                            unpack e: Int from remainder-exists {
                              @division-facts |
                                c = iadd(imul(b, q0), e) and nonneg(e) and int_less_than(e, b)
                                [by hypothesis with-remainder-e]
                              @c-decomposes |
                                c = iadd(imul(b, q0), e)
                                [using tautology division-facts]
                              @e-nonneg |
                                nonneg(e)
                                [using tautology division-facts]
                              @e-below-b |
                                int_less_than(e, b)
                                [using tautology division-facts]
                              @difference-unfolds |
                                isub(imul(c, a), imul(e, a)) = iadd(imul(c, a), ineg(imul(e, a)))
                                [using specialize definitionOfSubtraction(imul(c, a), imul(e, a))]
                              @difference-with-c |
                                isub(imul(c, a), imul(e, a)) = iadd(imul(iadd(imul(b, q0), e), a), ineg(imul(e, a)))
                                [by rewrite c-decomposes difference-unfolds]
                              @difference-is-multiple |
                                iadd(imul(iadd(imul(b, q0), e), a), ineg(imul(e, a))) = imul(imul(a, b), q0)
                                [using polynomial(integer)]
                              @difference-is-abq |
                                isub(imul(c, a), imul(e, a)) = imul(imul(a, b), q0)
                                [using chain difference-with-c difference-is-multiple]
                              @ab-divides-difference |
                                divides(imul(a, b), isub(imul(c, a), imul(e, a)))
                                [using specialize dividesIntro(isub(imul(c, a), imul(e, a)), imul(a, b), q0) difference-is-abq]
                              @n-divides-difference |
                                divides(N, isub(imul(c, a), imul(e, a)))
                                [by rewrite modulus ab-divides-difference]
                              @congruent-iff |
                                cls(imul(c, a)) = cls(imul(e, a)) iff divides(N, isub(imul(c, a), imul(e, a)))
                                [using specialize clsCongruent(imul(c, a), imul(e, a))]
                              @classes-agree |
                                cls(imul(c, a)) = cls(imul(e, a))
                                [using tautology congruent-iff n-divides-difference]
                              @e-witnesses |
                                nonneg(e) and int_less_than(e, b) and cls(imul(c, a)) = cls(imul(e, a))
                                [using tautology e-nonneg e-below-b classes-agree]
                              @conclusion-reduced-inner |
                                exists e2: Int; nonneg(e2) and int_less_than(e2, b) and cls(imul(c, a)) = cls(imul(e2, a))
                                [by exists_intro(e) e-witnesses]
                            }
                          @conclusion-with-e |
                            exists e2: Int; nonneg(e2) and int_less_than(e2, b) and cls(imul(c, a)) = cls(imul(e2, a))
                            [by exists_elim with-remainder-e]
                        }
                      @conclusion-reduced |
                        exists e2: Int; nonneg(e2) and int_less_than(e2, b) and cls(imul(c, a)) = cls(imul(e2, a))
                        [by exists_elim with-quotient-q0]
                    }
                  @discharge-c |
                    forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(imul(c, a)) = cls(imul(e, a))
                    [by forall_intro generalize-c]
                }
              @b-positive-implies |
                int_less_than(IZERO, b) -> forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(imul(c, a)) = cls(imul(e, a))
                [by implies_intro given-b-positive]
            }
          @modulus-implies |
            N = imul(a, b) -> int_less_than(IZERO, b) -> forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(imul(c, a)) = cls(imul(e, a))
            [by implies_intro given-modulus]
        }
      @discharge-b |
        forall b: Int; N = imul(a, b) -> int_less_than(IZERO, b) -> forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(imul(c, a)) = cls(imul(e, a))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; N = imul(a, b) -> int_less_than(IZERO, b) -> forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, b) and cls(imul(c, a)) = cls(imul(e, a))
    [by forall_intro generalize-a]
qed

// -- every non-generator of ℤ_pq is a listed multiple ----------------------------------------
theorem nonGeneratorIsAListedMultiple: forall p, q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @generalize-pm |
            fix pm: Nat {
              @generalize-qn |
                fix qn: Nat {
                  @given-p-prime |
                    assume is_prime(p) {
                      @given-q-prime |
                        assume is_prime(q) {
                          @given-modulus |
                            assume N = imul(p, q) {
                              @given-p-image |
                                assume toInt(succ(pm)) = p {
                                  @given-q-image |
                                    assume toInt(qn) = q {
                                      @p-prime |
                                        is_prime(p)
                                        [by hypothesis given-p-prime]
                                      @q-prime |
                                        is_prime(q)
                                        [by hypothesis given-q-prime]
                                      @modulus |
                                        N = imul(p, q)
                                        [by hypothesis given-modulus]
                                      @p-image |
                                        toInt(succ(pm)) = p
                                        [by hypothesis given-p-image]
                                      @q-image |
                                        toInt(qn) = q
                                        [by hypothesis given-q-image]
                                      @p-positive |
                                        int_less_than(IZERO, p)
                                        [using specialize primeIsPositive(p) p-prime]
                                      @q-positive |
                                        int_less_than(IZERO, q)
                                        [using specialize primeIsPositive(q) q-prime]
                                      @factors-commute |
                                        imul(p, q) = imul(q, p)
                                        [using specialize intMulIsCommutative(p, q)]
                                      @modulus-commuted |
                                        N = imul(q, p)
                                        [using chain modulus factors-commute]
                                      @characterization |
                                        forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                                        [using specialize nonGeneratorIffPrimeDivides(p, q) p-prime q-prime modulus]
                                      @reduce-mod-q |
                                        forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, q) and cls(imul(c, p)) = cls(imul(e, p))
                                        [using specialize coefficientReducesModCofactor(p, q) modulus q-positive]
                                      @reduce-mod-p |
                                        forall c: Int; exists e: Int; nonneg(e) and int_less_than(e, p) and cls(imul(c, q)) = cls(imul(e, q))
                                        [using specialize coefficientReducesModCofactor(q, p) modulus-commuted p-positive]
                                      @zero-image |
                                        toInt(NZERO) = IZERO
                                        [by cite toIntZero]
                                      @generalize-z |
                                        fix z: Zn {
                                          @given-non-generator |
                                            assume not generates(z) {
                                              @non-generator |
                                                not generates(z)
                                                [by hypothesis given-non-generator]
                                              @z-has-representative |
                                                exists k: Int; z = cls(k)
                                                [using specialize clsSurjective(z)]
                                              @with-representative-r |
                                                unpack r: Int from z-has-representative {
                                                  @z-is-cls-r |
                                                    z = cls(r)
                                                    [by hypothesis with-representative-r]
                                                  @cls-r-non-generator |
                                                    not generates(cls(r))
                                                    [by rewrite z-is-cls-r non-generator]
                                                  @r-characterized |
                                                    (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                                                    [using specialize characterization(r)]
                                                  @some-prime-divides |
                                                    divides(p, r) or divides(q, r)
                                                    [using tautology r-characterized cls-r-non-generator]
                                                  @conclusion-listed-inner |
                                                    (exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q)))
                                                    case some-prime-divides {
                                                      // p | r: r = p c, reduce c modulo q.
                                                      @when-p-divides |
                                                        assume divides(p, r) {
                                                          @p-divides-r |
                                                            divides(p, r)
                                                            [by hypothesis when-p-divides]
                                                          @with-cofactor-c |
                                                            unpack c: Int from p-divides-r {
                                                              @r-is-pc |
                                                                r = imul(p, c)
                                                                [by hypothesis with-cofactor-c]
                                                              @pc-commutes |
                                                                imul(p, c) = imul(c, p)
                                                                [using specialize intMulIsCommutative(p, c)]
                                                              @r-is-cp |
                                                                r = imul(c, p)
                                                                [using chain r-is-pc pc-commutes]
                                                              @reduced |
                                                                exists e: Int; nonneg(e) and int_less_than(e, q) and cls(imul(c, p)) = cls(imul(e, p))
                                                                [using specialize reduce-mod-q(c)]
                                                              @with-remainder-e |
                                                                unpack e: Int from reduced {
                                                                  @remainder-facts |
                                                                    nonneg(e) and int_less_than(e, q) and cls(imul(c, p)) = cls(imul(e, p))
                                                                    [by hypothesis with-remainder-e]
                                                                  @e-nonneg |
                                                                    nonneg(e)
                                                                    [using tautology remainder-facts]
                                                                  @e-below-q |
                                                                    int_less_than(e, q)
                                                                    [using tautology remainder-facts]
                                                                  @classes-agree |
                                                                    cls(imul(c, p)) = cls(imul(e, p))
                                                                    [using tautology remainder-facts]
                                                                  @e-is-an-image |
                                                                    exists k: Nat; toInt(k) = e
                                                                    [using specialize everyNonnegIsAnImage(e) e-nonneg]
                                                                  @with-index-k |
                                                                    unpack k: Nat from e-is-an-image {
                                                                      @k-image |
                                                                        toInt(k) = e
                                                                        [by hypothesis with-index-k]
                                                                      @k-image-below-q |
                                                                        int_less_than(toInt(k), q)
                                                                        [by rewrite k-image e-below-q]
                                                                      @k-image-below-q-image |
                                                                        int_less_than(toInt(k), toInt(qn))
                                                                        [by rewrite q-image k-image-below-q]
                                                                      @k-below-qn |
                                                                        less_than(k, qn)
                                                                        [using specialize toIntReflectsOrder(k, qn) k-image-below-q-image]
                                                                      @z-is-cls-cp |
                                                                        z = cls(imul(c, p))
                                                                        [by rewrite r-is-cp z-is-cls-r]
                                                                      @z-is-cls-ep |
                                                                        z = cls(imul(e, p))
                                                                        [using chain z-is-cls-cp classes-agree]
                                                                      @z-is-listed |
                                                                        z = cls(imul(toInt(k), p))
                                                                        [by rewrite k-image z-is-cls-ep]
                                                                      @k-witnesses |
                                                                        less_than(k, qn) and z = cls(imul(toInt(k), p))
                                                                        [by and_intro k-below-qn z-is-listed]
                                                                      @left-disjunct |
                                                                        exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))
                                                                        [by exists_intro(k) k-witnesses]
                                                                      @conclusion-when-p-inner |
                                                                        (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                                        [by or_intro_left left-disjunct]
                                                                    }
                                                                  @conclusion-with-k |
                                                                    (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                                    [by exists_elim with-index-k]
                                                                }
                                                              @conclusion-with-e |
                                                                (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                                [by exists_elim with-remainder-e]
                                                            }
                                                          @conclusion-when-p |
                                                            (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                            [by exists_elim with-cofactor-c]
                                                        }
                                                      // q | r: r = q c, reduce c modulo p; a zero remainder is cls(0) = cls(0·p).
                                                      @when-q-divides |
                                                        assume divides(q, r) {
                                                          @q-divides-r |
                                                            divides(q, r)
                                                            [by hypothesis when-q-divides]
                                                          @with-cofactor-c |
                                                            unpack c: Int from q-divides-r {
                                                              @r-is-qc |
                                                                r = imul(q, c)
                                                                [by hypothesis with-cofactor-c]
                                                              @qc-commutes |
                                                                imul(q, c) = imul(c, q)
                                                                [using specialize intMulIsCommutative(q, c)]
                                                              @r-is-cq |
                                                                r = imul(c, q)
                                                                [using chain r-is-qc qc-commutes]
                                                              @reduced |
                                                                exists e: Int; nonneg(e) and int_less_than(e, p) and cls(imul(c, q)) = cls(imul(e, q))
                                                                [using specialize reduce-mod-p(c)]
                                                              @with-remainder-e |
                                                                unpack e: Int from reduced {
                                                                  @remainder-facts |
                                                                    nonneg(e) and int_less_than(e, p) and cls(imul(c, q)) = cls(imul(e, q))
                                                                    [by hypothesis with-remainder-e]
                                                                  @e-nonneg |
                                                                    nonneg(e)
                                                                    [using tautology remainder-facts]
                                                                  @e-below-p |
                                                                    int_less_than(e, p)
                                                                    [using tautology remainder-facts]
                                                                  @classes-agree |
                                                                    cls(imul(c, q)) = cls(imul(e, q))
                                                                    [using tautology remainder-facts]
                                                                  @z-is-cls-cq |
                                                                    z = cls(imul(c, q))
                                                                    [by rewrite r-is-cq z-is-cls-r]
                                                                  @z-is-cls-eq |
                                                                    z = cls(imul(e, q))
                                                                    [using chain z-is-cls-cq classes-agree]
                                                                  @e-is-an-image |
                                                                    exists k: Nat; toInt(k) = e
                                                                    [using specialize everyNonnegIsAnImage(e) e-nonneg]
                                                                  @with-index-k0 |
                                                                    unpack k0: Nat from e-is-an-image {
                                                                      @k0-image |
                                                                        toInt(k0) = e
                                                                        [by hypothesis with-index-k0]
                                                                      @z-is-k0-multiple |
                                                                        z = cls(imul(toInt(k0), q))
                                                                        [by rewrite k0-image z-is-cls-eq]
                                                                      @k0-zero-or-succ |
                                                                        k0 = NZERO or (exists k: Nat; k0 = succ(k))
                                                                        [using specialize zeroOrSucc(k0)]
                                                                      @conclusion-when-q-inner |
                                                                        (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                                        case k0-zero-or-succ {
                                                                          @when-zero |
                                                                            assume k0 = NZERO {
                                                                              @k0-zero |
                                                                                k0 = NZERO
                                                                                [by hypothesis when-zero]
                                                                              @z-is-zero-multiple-of-q |
                                                                                z = cls(imul(toInt(NZERO), q))
                                                                                [by rewrite k0-zero z-is-k0-multiple]
                                                                              @z-is-cls-zero-times-q |
                                                                                z = cls(imul(IZERO, q))
                                                                                [by rewrite zero-image z-is-zero-multiple-of-q]
                                                                              @zero-times-q |
                                                                                imul(IZERO, q) = IZERO
                                                                                [using specialize intMulZeroLeft(q)]
                                                                              @z-is-cls-zero |
                                                                                z = cls(IZERO)
                                                                                [by rewrite zero-times-q z-is-cls-zero-times-q]
                                                                              @zero-times-p |
                                                                                imul(IZERO, p) = IZERO
                                                                                [using specialize intMulZeroLeft(p)]
                                                                              @zero-is-zero-times-p |
                                                                                IZERO = imul(IZERO, p)
                                                                                [by symmetry zero-times-p]
                                                                              @z-is-cls-zero-times-p |
                                                                                z = cls(imul(IZERO, p))
                                                                                [by rewrite zero-is-zero-times-p z-is-cls-zero]
                                                                              @z-is-zero-multiple-of-p |
                                                                                z = cls(imul(toInt(NZERO), p))
                                                                                [by rewrite zero-image z-is-cls-zero-times-p]
                                                                              @zero-image-below-q |
                                                                                int_less_than(toInt(NZERO), q)
                                                                                [by rewrite zero-image q-positive]
                                                                              @zero-image-below-q-image |
                                                                                int_less_than(toInt(NZERO), toInt(qn))
                                                                                [by rewrite q-image zero-image-below-q]
                                                                              @zero-below-qn |
                                                                                less_than(NZERO, qn)
                                                                                [using specialize toIntReflectsOrder(NZERO, qn) zero-image-below-q-image]
                                                                              @zero-witnesses |
                                                                                less_than(NZERO, qn) and z = cls(imul(toInt(NZERO), p))
                                                                                [by and_intro zero-below-qn z-is-zero-multiple-of-p]
                                                                              @left-disjunct |
                                                                                exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))
                                                                                [by exists_intro(NZERO) zero-witnesses]
                                                                              @conclusion-when-zero |
                                                                                (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                                                [by or_intro_left left-disjunct]
                                                                            }
                                                                          @when-succ |
                                                                            assume exists k: Nat; k0 = succ(k) {
                                                                              @predecessor-exists |
                                                                                exists k: Nat; k0 = succ(k)
                                                                                [by hypothesis when-succ]
                                                                              @with-predecessor-k |
                                                                                unpack k: Nat from predecessor-exists {
                                                                                  @k0-is-succ-k |
                                                                                    k0 = succ(k)
                                                                                    [by hypothesis with-predecessor-k]
                                                                                  @z-is-succ-k-multiple |
                                                                                    z = cls(imul(toInt(succ(k)), q))
                                                                                    [by rewrite k0-is-succ-k z-is-k0-multiple]
                                                                                  @succ-k-image |
                                                                                    toInt(succ(k)) = e
                                                                                    [by rewrite k0-is-succ-k k0-image]
                                                                                  @succ-k-image-below-p |
                                                                                    int_less_than(toInt(succ(k)), p)
                                                                                    [by rewrite succ-k-image e-below-p]
                                                                                  @succ-k-image-below-p-image |
                                                                                    int_less_than(toInt(succ(k)), toInt(succ(pm)))
                                                                                    [by rewrite p-image succ-k-image-below-p]
                                                                                  @succ-k-below-succ-pm |
                                                                                    less_than(succ(k), succ(pm))
                                                                                    [using specialize toIntReflectsOrder(succ(k), succ(pm)) succ-k-image-below-p-image]
                                                                                  @k-below-pm |
                                                                                    less_than(k, pm)
                                                                                    [using specialize succReflectsOrder(k, pm) succ-k-below-succ-pm]
                                                                                  @k-witnesses |
                                                                                    less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))
                                                                                    [by and_intro k-below-pm z-is-succ-k-multiple]
                                                                                  @right-disjunct |
                                                                                    exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q))
                                                                                    [by exists_intro(k) k-witnesses]
                                                                                  @conclusion-when-succ-inner |
                                                                                    (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                                                    [by or_intro_right right-disjunct]
                                                                                }
                                                                              @conclusion-when-succ |
                                                                                (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                                                [by exists_elim with-predecessor-k]
                                                                            }
                                                                        }
                                                                    }
                                                                  @conclusion-with-k0 |
                                                                    (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                                    [by exists_elim with-index-k0]
                                                                }
                                                              @conclusion-with-e |
                                                                (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                                [by exists_elim with-remainder-e]
                                                            }
                                                          @conclusion-when-q |
                                                            (exists k2: Nat; less_than(k2, qn) and z = cls(imul(toInt(k2), p))) or (exists k2: Nat; less_than(k2, pm) and z = cls(imul(toInt(succ(k2)), q)))
                                                            [by exists_elim with-cofactor-c]
                                                        }
                                                    }
                                                }
                                              @conclusion-listed |
                                                (exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q)))
                                                [by exists_elim with-representative-r]
                                            }
                                          @non-generator-implies |
                                            (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
                                            [by implies_intro given-non-generator]
                                        }
                                      @discharge-z |
                                        forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
                                        [by forall_intro generalize-z]
                                    }
                                  @q-image-implies |
                                    toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
                                    [by implies_intro given-q-image]
                                }
                              @p-image-implies |
                                toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
                                [by implies_intro given-p-image]
                            }
                          @modulus-implies |
                            N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
                            [by implies_intro given-modulus]
                        }
                      @q-prime-implies |
                        is_prime(q) -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
                        [by implies_intro given-q-prime]
                    }
                  @p-prime-implies |
                    is_prime(p) -> is_prime(q) -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
                    [by implies_intro given-p-prime]
                }
              @discharge-qn |
                forall qn: Nat; is_prime(p) -> is_prime(q) -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
                [by forall_intro generalize-qn]
            }
          @discharge-pm |
            forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
            [by forall_intro generalize-pm]
        }
      @discharge-q |
        forall q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall p, q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
    [by forall_intro generalize-p]
qed

// -- entries of a concatenation, by index -----------------------------------------------------
theorem concatenationEntries: forall w1: ZnSeq; forall w2: ZnSeq; forall m1: Nat; forall m2: Nat; forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nadd(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nadd(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)))
proof
  @generalize-w1 |
    fix w1: ZnSeq {
      @generalize-w2 |
        fix w2: ZnSeq {
          @generalize-m1 |
            fix m1: Nat {
              @generalize-m2 |
                fix m2: Nat {
                  @generalize-u |
                    fix u: ZnSeq {
                      @given-prefix |
                        assume forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i) {
                          @given-block |
                            assume forall i: Nat; less_than(i, m2) -> znAt(u, nadd(m1, i)) = znAt(w2, i) {
                              @prefix |
                                forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)
                                [by hypothesis given-prefix]
                              @block |
                                forall i: Nat; less_than(i, m2) -> znAt(u, nadd(m1, i)) = znAt(w2, i)
                                [by hypothesis given-block]
                              @generalize-j |
                                fix j: Nat {
                                  @given-j-below |
                                    assume less_than(j, nadd(m1, m2)) {
                                      @j-below |
                                        less_than(j, nadd(m1, m2))
                                        [by hypothesis given-j-below]
                                      @j-splits |
                                        less_than(j, m1) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i))
                                        [using specialize indexSplits(m1, m2, j) j-below]
                                      @conclusion-entry |
                                        (less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i))
                                        case j-splits {
                                          @when-prefix |
                                            assume less_than(j, m1) {
                                              @j-in-prefix |
                                                less_than(j, m1)
                                                [by hypothesis when-prefix]
                                              @entry-from-prefix |
                                                znAt(u, j) = znAt(w1, j)
                                                [using specialize prefix(j) j-in-prefix]
                                              @prefix-witnessed |
                                                less_than(j, m1) and znAt(u, j) = znAt(w1, j)
                                                [by and_intro j-in-prefix entry-from-prefix]
                                              @conclusion-when-prefix |
                                                (less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i))
                                                [by or_intro_left prefix-witnessed]
                                            }
                                          @when-block |
                                            assume exists i: Nat; less_than(i, m2) and j = nadd(m1, i) {
                                              @offset-exists |
                                                exists i: Nat; less_than(i, m2) and j = nadd(m1, i)
                                                [by hypothesis when-block]
                                              @with-offset-i |
                                                unpack i: Nat from offset-exists {
                                                  @offset-facts |
                                                    less_than(i, m2) and j = nadd(m1, i)
                                                    [by hypothesis with-offset-i]
                                                  @i-below |
                                                    less_than(i, m2)
                                                    [by and_elim_left offset-facts]
                                                  @j-is-offset |
                                                    j = nadd(m1, i)
                                                    [by and_elim_right offset-facts]
                                                  @entry-from-block-raw |
                                                    znAt(u, nadd(m1, i)) = znAt(w2, i)
                                                    [using specialize block(i) i-below]
                                                  @entry-from-block |
                                                    znAt(u, j) = znAt(w2, i)
                                                    [by rewrite j-is-offset entry-from-block-raw]
                                                  @block-witnessed |
                                                    less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)
                                                    [using tautology i-below j-is-offset entry-from-block]
                                                  @conclusion-when-block-inner |
                                                    (less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i2: Nat; less_than(i2, m2) and j = nadd(m1, i2) and znAt(u, j) = znAt(w2, i2))
                                                    [by or_intro_right block-exists]
                                                  @block-exists |
                                                    exists i2: Nat; less_than(i2, m2) and j = nadd(m1, i2) and znAt(u, j) = znAt(w2, i2)
                                                    [by exists_intro(i) block-witnessed]
                                                }
                                              @conclusion-when-block |
                                                (less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i2: Nat; less_than(i2, m2) and j = nadd(m1, i2) and znAt(u, j) = znAt(w2, i2))
                                                [by exists_elim with-offset-i]
                                            }
                                        }
                                    }
                                  @j-below-implies |
                                    less_than(j, nadd(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)))
                                    [by implies_intro given-j-below]
                                }
                              @discharge-j |
                                forall j: Nat; less_than(j, nadd(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)))
                                [by forall_intro generalize-j]
                            }
                          @block-implies |
                            (forall i: Nat; less_than(i, m2) -> znAt(u, nadd(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nadd(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)))
                            [by implies_intro given-block]
                        }
                      @prefix-implies |
                        (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nadd(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nadd(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)))
                        [by implies_intro given-prefix]
                    }
                  @discharge-u |
                    forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nadd(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nadd(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)))
                    [by forall_intro generalize-u]
                }
              @discharge-m2 |
                forall m2: Nat; forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nadd(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nadd(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)))
                [by forall_intro generalize-m2]
            }
          @discharge-m1 |
            forall m1: Nat; forall m2: Nat; forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nadd(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nadd(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)))
            [by forall_intro generalize-m1]
        }
      @discharge-w2 |
        forall w2: ZnSeq; forall m1: Nat; forall m2: Nat; forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nadd(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nadd(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)))
        [by forall_intro generalize-w2]
    }
  @conclusion |
    forall w1: ZnSeq; forall w2: ZnSeq; forall m1: Nat; forall m2: Nat; forall u: ZnSeq; (forall i: Nat; less_than(i, m1) -> znAt(u, i) = znAt(w1, i)) -> (forall i: Nat; less_than(i, m2) -> znAt(u, nadd(m1, i)) = znAt(w2, i)) -> forall j: Nat; less_than(j, nadd(m1, m2)) -> ((less_than(j, m1) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, m2) and j = nadd(m1, i) and znAt(u, j) = znAt(w2, i)))
    [by forall_intro generalize-w1]
qed

// -- THE NON-GENERATORS OF ℤ_pq, LISTED: cls(kp) for k < q, then cls(kq) for 0 < k < p ------------
// q + (p − 1) entries, no repetition (within each part by the bounded-difference lemma, across
// the parts because p ∤ k for 0 < k < p), and every non-generator appears.
theorem nonGeneratorsOfZpqAreListed: forall p, q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z)
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @generalize-pm |
            fix pm: Nat {
              @generalize-qn |
                fix qn: Nat {
                  @given-p-prime |
                    assume is_prime(p) {
                      @given-q-prime |
                        assume is_prime(q) {
                          @given-distinct |
                            assume p != q {
                              @given-modulus |
                                assume N = imul(p, q) {
                                  @given-p-image |
                                    assume toInt(succ(pm)) = p {
                                      @given-q-image |
                                        assume toInt(qn) = q {
                                          @p-prime |
                                            is_prime(p)
                                            [by hypothesis given-p-prime]
                                          @q-prime |
                                            is_prime(q)
                                            [by hypothesis given-q-prime]
                                          @distinct |
                                            p != q
                                            [by hypothesis given-distinct]
                                          @modulus |
                                            N = imul(p, q)
                                            [by hypothesis given-modulus]
                                          @p-image |
                                            toInt(succ(pm)) = p
                                            [by hypothesis given-p-image]
                                          @q-image |
                                            toInt(qn) = q
                                            [by hypothesis given-q-image]
                                          @p-positive |
                                            int_less_than(IZERO, p)
                                            [using specialize primeIsPositive(p) p-prime]
                                          @q-positive |
                                            int_less_than(IZERO, q)
                                            [using specialize primeIsPositive(q) q-prime]
                                          @factors-commute |
                                            imul(p, q) = imul(q, p)
                                            [using specialize intMulIsCommutative(p, q)]
                                          @modulus-commuted |
                                            N = imul(q, p)
                                            [using chain modulus factors-commute]
                                          @characterization |
                                            forall r: Int; (not generates(cls(r))) iff (divides(p, r) or divides(q, r))
                                            [using specialize nonGeneratorIffPrimeDivides(p, q) p-prime q-prime modulus]
                                          @coverage |
                                            forall z: Zn; (not generates(z)) -> ((exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))))
                                            [using specialize nonGeneratorIsAListedMultiple(p, q, pm, qn) p-prime q-prime modulus p-image q-image]
                                          @parts-never-meet |
                                            forall i: Nat; forall j: Nat; less_than(j, pm) -> cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j)), q))
                                            [using specialize multipleOfPIsNotAShiftedMultipleOfQ(p, q, pm) p-prime q-prime distinct modulus p-image]
                                          @first-part-injective |
                                            forall i: Nat; forall j: Nat; less_than(i, qn) -> less_than(j, qn) -> cls(imul(toInt(i), p)) = cls(imul(toInt(j), p)) -> i = j
                                            [using specialize multiplesDoNotRepeat(p, q, qn) modulus p-positive q-image]
                                          @second-part-injective |
                                            forall i: Nat; forall j: Nat; less_than(i, pm) -> less_than(j, pm) -> cls(imul(toInt(succ(i)), q)) = cls(imul(toInt(succ(j)), q)) -> i = j
                                            [using specialize shiftedMultiplesDoNotRepeat(q, p, pm) modulus-commuted q-positive p-image]
                                          @first-part-exists |
                                            exists w: ZnSeq; forall i: Nat; less_than(i, qn) -> znAt(w, i) = cls(imul(toInt(i), p))
                                            [using specialize sequenceOfMultiplesExists(p, qn)]
                                          @second-part-exists |
                                            exists w: ZnSeq; forall i: Nat; less_than(i, pm) -> znAt(w, i) = cls(imul(toInt(succ(i)), q))
                                            [using specialize sequenceOfShiftedMultiplesExists(q, pm)]
                                          @with-first-part-w1 |
                                            unpack w1: ZnSeq from first-part-exists {
                                              @w1-entries |
                                                forall i: Nat; less_than(i, qn) -> znAt(w1, i) = cls(imul(toInt(i), p))
                                                [by hypothesis with-first-part-w1]
                                              @with-second-part-w2 |
                                                unpack w2: ZnSeq from second-part-exists {
                                                  @w2-entries |
                                                    forall i: Nat; less_than(i, pm) -> znAt(w2, i) = cls(imul(toInt(succ(i)), q))
                                                    [by hypothesis with-second-part-w2]
                                                  @concatenation-exists |
                                                    exists u: ZnSeq; (forall i: Nat; less_than(i, qn) -> znAt(u, i) = znAt(w1, i)) and (forall i: Nat; less_than(i, pm) -> znAt(u, nadd(qn, i)) = znAt(w2, i)) and znProductUpTo(u, nadd(qn, pm)) = add(znProductUpTo(w1, qn), znProductUpTo(w2, pm))
                                                    [using specialize znSeqConcat(w1, w2, qn, pm)]
                                                  @with-concatenation-u |
                                                    unpack u: ZnSeq from concatenation-exists {
                                                      @concatenation-facts |
                                                        (forall i: Nat; less_than(i, qn) -> znAt(u, i) = znAt(w1, i)) and (forall i: Nat; less_than(i, pm) -> znAt(u, nadd(qn, i)) = znAt(w2, i)) and znProductUpTo(u, nadd(qn, pm)) = add(znProductUpTo(w1, qn), znProductUpTo(w2, pm))
                                                        [by hypothesis with-concatenation-u]
                                                      @prefix-agrees |
                                                        forall i: Nat; less_than(i, qn) -> znAt(u, i) = znAt(w1, i)
                                                        [using tautology concatenation-facts]
                                                      @block-agrees |
                                                        forall i: Nat; less_than(i, pm) -> znAt(u, nadd(qn, i)) = znAt(w2, i)
                                                        [using tautology concatenation-facts]
                                                      @entries-by-index |
                                                        forall j: Nat; less_than(j, nadd(qn, pm)) -> ((less_than(j, qn) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = znAt(w2, i)))
                                                        [using specialize concatenationEntries(w1, w2, qn, pm, u) prefix-agrees block-agrees]
                                                      // the entry at j, in closed form.
                                                      @generalize-j-form |
                                                        fix j: Nat {
                                                          @given-j-below-form |
                                                            assume less_than(j, nadd(qn, pm)) {
                                                              @j-below-form |
                                                                less_than(j, nadd(qn, pm))
                                                                [by hypothesis given-j-below-form]
                                                              @j-entry |
                                                                (less_than(j, qn) and znAt(u, j) = znAt(w1, j)) or (exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = znAt(w2, i))
                                                                [using specialize entries-by-index(j) j-below-form]
                                                              @conclusion-j-form |
                                                                (less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))) or (exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = cls(imul(toInt(succ(i)), q)))
                                                                case j-entry {
                                                                  @when-first |
                                                                    assume less_than(j, qn) and znAt(u, j) = znAt(w1, j) {
                                                                      @first-facts |
                                                                        less_than(j, qn) and znAt(u, j) = znAt(w1, j)
                                                                        [by hypothesis when-first]
                                                                      @j-below-qn |
                                                                        less_than(j, qn)
                                                                        [by and_elim_left first-facts]
                                                                      @u-j-is-w1-j |
                                                                        znAt(u, j) = znAt(w1, j)
                                                                        [by and_elim_right first-facts]
                                                                      @w1-j |
                                                                        znAt(w1, j) = cls(imul(toInt(j), p))
                                                                        [using specialize w1-entries(j) j-below-qn]
                                                                      @u-j-closed |
                                                                        znAt(u, j) = cls(imul(toInt(j), p))
                                                                        [using chain u-j-is-w1-j w1-j]
                                                                      @first-closed |
                                                                        less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))
                                                                        [by and_intro j-below-qn u-j-closed]
                                                                      @conclusion-when-first |
                                                                        (less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))) or (exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = cls(imul(toInt(succ(i)), q)))
                                                                        [by or_intro_left first-closed]
                                                                    }
                                                                  @when-second |
                                                                    assume exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = znAt(w2, i) {
                                                                      @second-exists |
                                                                        exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = znAt(w2, i)
                                                                        [by hypothesis when-second]
                                                                      @with-offset-i |
                                                                        unpack i: Nat from second-exists {
                                                                          @second-facts |
                                                                            less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = znAt(w2, i)
                                                                            [by hypothesis with-offset-i]
                                                                          @i-below-pm |
                                                                            less_than(i, pm)
                                                                            [using tautology second-facts]
                                                                          @j-is-offset |
                                                                            j = nadd(qn, i)
                                                                            [using tautology second-facts]
                                                                          @u-j-is-w2-i |
                                                                            znAt(u, j) = znAt(w2, i)
                                                                            [using tautology second-facts]
                                                                          @w2-i |
                                                                            znAt(w2, i) = cls(imul(toInt(succ(i)), q))
                                                                            [using specialize w2-entries(i) i-below-pm]
                                                                          @u-j-closed |
                                                                            znAt(u, j) = cls(imul(toInt(succ(i)), q))
                                                                            [using chain u-j-is-w2-i w2-i]
                                                                          @second-closed |
                                                                            less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = cls(imul(toInt(succ(i)), q))
                                                                            [using tautology i-below-pm j-is-offset u-j-closed]
                                                                          @second-closed-exists |
                                                                            exists i2: Nat; less_than(i2, pm) and j = nadd(qn, i2) and znAt(u, j) = cls(imul(toInt(succ(i2)), q))
                                                                            [by exists_intro(i) second-closed]
                                                                          @conclusion-when-second-inner |
                                                                            (less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))) or (exists i2: Nat; less_than(i2, pm) and j = nadd(qn, i2) and znAt(u, j) = cls(imul(toInt(succ(i2)), q)))
                                                                            [by or_intro_right second-closed-exists]
                                                                        }
                                                                      @conclusion-when-second |
                                                                        (less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))) or (exists i2: Nat; less_than(i2, pm) and j = nadd(qn, i2) and znAt(u, j) = cls(imul(toInt(succ(i2)), q)))
                                                                        [by exists_elim with-offset-i]
                                                                    }
                                                                }
                                                            }
                                                          @j-form-implies |
                                                            less_than(j, nadd(qn, pm)) -> ((less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))) or (exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = cls(imul(toInt(succ(i)), q))))
                                                            [by implies_intro given-j-below-form]
                                                        }
                                                      @entry-form |
                                                        forall j: Nat; less_than(j, nadd(qn, pm)) -> ((less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))) or (exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = cls(imul(toInt(succ(i)), q))))
                                                        [by forall_intro generalize-j-form]
                                                      // (a) no entry generates.
                                                      @generalize-j-a |
                                                        fix j: Nat {
                                                          @given-j-below-a |
                                                            assume less_than(j, nadd(qn, pm)) {
                                                              @j-below-a |
                                                                less_than(j, nadd(qn, pm))
                                                                [by hypothesis given-j-below-a]
                                                              @j-form |
                                                                (less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))) or (exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = cls(imul(toInt(succ(i)), q)))
                                                                [using specialize entry-form(j) j-below-a]
                                                              @conclusion-j-non-generator |
                                                                not generates(znAt(u, j))
                                                                case j-form {
                                                                  @when-first |
                                                                    assume less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p)) {
                                                                      @first-facts |
                                                                        less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))
                                                                        [by hypothesis when-first]
                                                                      @u-j-closed |
                                                                        znAt(u, j) = cls(imul(toInt(j), p))
                                                                        [by and_elim_right first-facts]
                                                                      @multiple-commutes |
                                                                        imul(toInt(j), p) = imul(p, toInt(j))
                                                                        [using specialize intMulIsCommutative(toInt(j), p)]
                                                                      @p-divides-multiple |
                                                                        divides(p, imul(toInt(j), p))
                                                                        [using specialize dividesIntro(imul(toInt(j), p), p, toInt(j)) multiple-commutes]
                                                                      @some-prime-divides |
                                                                        divides(p, imul(toInt(j), p)) or divides(q, imul(toInt(j), p))
                                                                        [by or_intro_left p-divides-multiple]
                                                                      @entry-characterized |
                                                                        (not generates(cls(imul(toInt(j), p)))) iff (divides(p, imul(toInt(j), p)) or divides(q, imul(toInt(j), p)))
                                                                        [using specialize characterization(imul(toInt(j), p))]
                                                                      @closed-non-generator |
                                                                        not generates(cls(imul(toInt(j), p)))
                                                                        [using tautology entry-characterized some-prime-divides]
                                                                      @conclusion-when-first |
                                                                        not generates(znAt(u, j))
                                                                        [by rewrite u-j-closed closed-non-generator]
                                                                    }
                                                                  @when-second |
                                                                    assume exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = cls(imul(toInt(succ(i)), q)) {
                                                                      @second-exists |
                                                                        exists i: Nat; less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = cls(imul(toInt(succ(i)), q))
                                                                        [by hypothesis when-second]
                                                                      @with-offset-i |
                                                                        unpack i: Nat from second-exists {
                                                                          @second-facts |
                                                                            less_than(i, pm) and j = nadd(qn, i) and znAt(u, j) = cls(imul(toInt(succ(i)), q))
                                                                            [by hypothesis with-offset-i]
                                                                          @u-j-closed |
                                                                            znAt(u, j) = cls(imul(toInt(succ(i)), q))
                                                                            [using tautology second-facts]
                                                                          @multiple-commutes |
                                                                            imul(toInt(succ(i)), q) = imul(q, toInt(succ(i)))
                                                                            [using specialize intMulIsCommutative(toInt(succ(i)), q)]
                                                                          @q-divides-multiple |
                                                                            divides(q, imul(toInt(succ(i)), q))
                                                                            [using specialize dividesIntro(imul(toInt(succ(i)), q), q, toInt(succ(i))) multiple-commutes]
                                                                          @some-prime-divides |
                                                                            divides(p, imul(toInt(succ(i)), q)) or divides(q, imul(toInt(succ(i)), q))
                                                                            [by or_intro_right q-divides-multiple]
                                                                          @entry-characterized |
                                                                            (not generates(cls(imul(toInt(succ(i)), q)))) iff (divides(p, imul(toInt(succ(i)), q)) or divides(q, imul(toInt(succ(i)), q)))
                                                                            [using specialize characterization(imul(toInt(succ(i)), q))]
                                                                          @closed-non-generator |
                                                                            not generates(cls(imul(toInt(succ(i)), q)))
                                                                            [using tautology entry-characterized some-prime-divides]
                                                                          @conclusion-when-second-inner |
                                                                            not generates(znAt(u, j))
                                                                            [by rewrite u-j-closed closed-non-generator]
                                                                        }
                                                                      @conclusion-when-second |
                                                                        not generates(znAt(u, j))
                                                                        [by exists_elim with-offset-i]
                                                                    }
                                                                }
                                                            }
                                                          @j-a-implies |
                                                            less_than(j, nadd(qn, pm)) -> (not generates(znAt(u, j)))
                                                            [by implies_intro given-j-below-a]
                                                        }
                                                      @no-entry-generates |
                                                        forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u, j)))
                                                        [by forall_intro generalize-j-a]
                                                      // (b) no repetition.
                                                      @generalize-i-b |
                                                        fix i: Nat {
                                                          @generalize-j-b |
                                                            fix j: Nat {
                                                              @given-i-below-b |
                                                                assume less_than(i, nadd(qn, pm)) {
                                                                  @given-j-below-b |
                                                                    assume less_than(j, nadd(qn, pm)) {
                                                                      @given-entries-equal |
                                                                        assume znAt(u, i) = znAt(u, j) {
                                                                          @i-below-b |
                                                                            less_than(i, nadd(qn, pm))
                                                                            [by hypothesis given-i-below-b]
                                                                          @j-below-b |
                                                                            less_than(j, nadd(qn, pm))
                                                                            [by hypothesis given-j-below-b]
                                                                          @entries-equal |
                                                                            znAt(u, i) = znAt(u, j)
                                                                            [by hypothesis given-entries-equal]
                                                                          @i-form |
                                                                            (less_than(i, qn) and znAt(u, i) = cls(imul(toInt(i), p))) or (exists i2: Nat; less_than(i2, pm) and i = nadd(qn, i2) and znAt(u, i) = cls(imul(toInt(succ(i2)), q)))
                                                                            [using specialize entry-form(i) i-below-b]
                                                                          @j-form |
                                                                            (less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))) or (exists j2: Nat; less_than(j2, pm) and j = nadd(qn, j2) and znAt(u, j) = cls(imul(toInt(succ(j2)), q)))
                                                                            [using specialize entry-form(j) j-below-b]
                                                                          @conclusion-indices-equal |
                                                                            i = j
                                                                            case i-form {
                                                                              @when-i-first |
                                                                                assume less_than(i, qn) and znAt(u, i) = cls(imul(toInt(i), p)) {
                                                                                  @i-first-facts |
                                                                                    less_than(i, qn) and znAt(u, i) = cls(imul(toInt(i), p))
                                                                                    [by hypothesis when-i-first]
                                                                                  @i-below-qn |
                                                                                    less_than(i, qn)
                                                                                    [by and_elim_left i-first-facts]
                                                                                  @u-i-closed |
                                                                                    znAt(u, i) = cls(imul(toInt(i), p))
                                                                                    [by and_elim_right i-first-facts]
                                                                                  @closed-i-is-u-i |
                                                                                    cls(imul(toInt(i), p)) = znAt(u, i)
                                                                                    [by symmetry u-i-closed]
                                                                                  @conclusion-i-first |
                                                                                    i = j
                                                                                    case j-form {
                                                                                      @when-j-first |
                                                                                        assume less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p)) {
                                                                                          @j-first-facts |
                                                                                            less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))
                                                                                            [by hypothesis when-j-first]
                                                                                          @j-below-qn |
                                                                                            less_than(j, qn)
                                                                                            [by and_elim_left j-first-facts]
                                                                                          @u-j-closed |
                                                                                            znAt(u, j) = cls(imul(toInt(j), p))
                                                                                            [by and_elim_right j-first-facts]
                                                                                          @closed-entries-equal |
                                                                                            cls(imul(toInt(i), p)) = cls(imul(toInt(j), p))
                                                                                            [using chain closed-i-is-u-i entries-equal u-j-closed]
                                                                                          @conclusion-both-first |
                                                                                            i = j
                                                                                            [using specialize first-part-injective(i, j) i-below-qn j-below-qn closed-entries-equal]
                                                                                        }
                                                                                      @when-j-second |
                                                                                        assume exists j2: Nat; less_than(j2, pm) and j = nadd(qn, j2) and znAt(u, j) = cls(imul(toInt(succ(j2)), q)) {
                                                                                          @j-second-exists |
                                                                                            exists j2: Nat; less_than(j2, pm) and j = nadd(qn, j2) and znAt(u, j) = cls(imul(toInt(succ(j2)), q))
                                                                                            [by hypothesis when-j-second]
                                                                                          @with-offset-j2 |
                                                                                            unpack j2: Nat from j-second-exists {
                                                                                              @j-second-facts |
                                                                                                less_than(j2, pm) and j = nadd(qn, j2) and znAt(u, j) = cls(imul(toInt(succ(j2)), q))
                                                                                                [by hypothesis with-offset-j2]
                                                                                              @j2-below-pm |
                                                                                                less_than(j2, pm)
                                                                                                [using tautology j-second-facts]
                                                                                              @u-j-closed |
                                                                                                znAt(u, j) = cls(imul(toInt(succ(j2)), q))
                                                                                                [using tautology j-second-facts]
                                                                                              @closed-entries-equal |
                                                                                                cls(imul(toInt(i), p)) = cls(imul(toInt(succ(j2)), q))
                                                                                                [using chain closed-i-is-u-i entries-equal u-j-closed]
                                                                                              @closed-entries-differ |
                                                                                                cls(imul(toInt(i), p)) != cls(imul(toInt(succ(j2)), q))
                                                                                                [using specialize parts-never-meet(i, j2) j2-below-pm]
                                                                                              @conclusion-first-second-inner |
                                                                                                i = j
                                                                                                [by absurd closed-entries-equal closed-entries-differ]
                                                                                            }
                                                                                          @conclusion-first-second |
                                                                                            i = j
                                                                                            [by exists_elim with-offset-j2]
                                                                                        }
                                                                                    }
                                                                                }
                                                                              @when-i-second |
                                                                                assume exists i2: Nat; less_than(i2, pm) and i = nadd(qn, i2) and znAt(u, i) = cls(imul(toInt(succ(i2)), q)) {
                                                                                  @i-second-exists |
                                                                                    exists i2: Nat; less_than(i2, pm) and i = nadd(qn, i2) and znAt(u, i) = cls(imul(toInt(succ(i2)), q))
                                                                                    [by hypothesis when-i-second]
                                                                                  @with-offset-i2 |
                                                                                    unpack i2: Nat from i-second-exists {
                                                                                      @i-second-facts |
                                                                                        less_than(i2, pm) and i = nadd(qn, i2) and znAt(u, i) = cls(imul(toInt(succ(i2)), q))
                                                                                        [by hypothesis with-offset-i2]
                                                                                      @i2-below-pm |
                                                                                        less_than(i2, pm)
                                                                                        [using tautology i-second-facts]
                                                                                      @i-is-offset |
                                                                                        i = nadd(qn, i2)
                                                                                        [using tautology i-second-facts]
                                                                                      @u-i-closed |
                                                                                        znAt(u, i) = cls(imul(toInt(succ(i2)), q))
                                                                                        [using tautology i-second-facts]
                                                                                      @closed-i-is-u-i |
                                                                                        cls(imul(toInt(succ(i2)), q)) = znAt(u, i)
                                                                                        [by symmetry u-i-closed]
                                                                                      @conclusion-i-second-inner |
                                                                                        i = j
                                                                                        case j-form {
                                                                                          @when-j-first |
                                                                                            assume less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p)) {
                                                                                              @j-first-facts |
                                                                                                less_than(j, qn) and znAt(u, j) = cls(imul(toInt(j), p))
                                                                                                [by hypothesis when-j-first]
                                                                                              @u-j-closed |
                                                                                                znAt(u, j) = cls(imul(toInt(j), p))
                                                                                                [by and_elim_right j-first-facts]
                                                                                              @closed-entries-equal |
                                                                                                cls(imul(toInt(succ(i2)), q)) = cls(imul(toInt(j), p))
                                                                                                [using chain closed-i-is-u-i entries-equal u-j-closed]
                                                                                              @closed-entries-equal-flipped |
                                                                                                cls(imul(toInt(j), p)) = cls(imul(toInt(succ(i2)), q))
                                                                                                [by symmetry closed-entries-equal]
                                                                                              @closed-entries-differ |
                                                                                                cls(imul(toInt(j), p)) != cls(imul(toInt(succ(i2)), q))
                                                                                                [using specialize parts-never-meet(j, i2) i2-below-pm]
                                                                                              @conclusion-second-first |
                                                                                                i = j
                                                                                                [by absurd closed-entries-equal-flipped closed-entries-differ]
                                                                                            }
                                                                                          @when-j-second |
                                                                                            assume exists j2: Nat; less_than(j2, pm) and j = nadd(qn, j2) and znAt(u, j) = cls(imul(toInt(succ(j2)), q)) {
                                                                                              @j-second-exists |
                                                                                                exists j2: Nat; less_than(j2, pm) and j = nadd(qn, j2) and znAt(u, j) = cls(imul(toInt(succ(j2)), q))
                                                                                                [by hypothesis when-j-second]
                                                                                              @with-offset-j2 |
                                                                                                unpack j2: Nat from j-second-exists {
                                                                                                  @j-second-facts |
                                                                                                    less_than(j2, pm) and j = nadd(qn, j2) and znAt(u, j) = cls(imul(toInt(succ(j2)), q))
                                                                                                    [by hypothesis with-offset-j2]
                                                                                                  @j2-below-pm |
                                                                                                    less_than(j2, pm)
                                                                                                    [using tautology j-second-facts]
                                                                                                  @j-is-offset |
                                                                                                    j = nadd(qn, j2)
                                                                                                    [using tautology j-second-facts]
                                                                                                  @u-j-closed |
                                                                                                    znAt(u, j) = cls(imul(toInt(succ(j2)), q))
                                                                                                    [using tautology j-second-facts]
                                                                                                  @closed-entries-equal |
                                                                                                    cls(imul(toInt(succ(i2)), q)) = cls(imul(toInt(succ(j2)), q))
                                                                                                    [using chain closed-i-is-u-i entries-equal u-j-closed]
                                                                                                  @offsets-equal |
                                                                                                    i2 = j2
                                                                                                    [using specialize second-part-injective(i2, j2) i2-below-pm j2-below-pm closed-entries-equal]
                                                                                                  @i-is-j-offset |
                                                                                                    i = nadd(qn, j2)
                                                                                                    [by rewrite offsets-equal i-is-offset]
                                                                                                  @j-offset-is-j |
                                                                                                    nadd(qn, j2) = j
                                                                                                    [by symmetry j-is-offset]
                                                                                                  @conclusion-both-second-inner |
                                                                                                    i = j
                                                                                                    [using chain i-is-j-offset j-offset-is-j]
                                                                                                }
                                                                                              @conclusion-both-second |
                                                                                                i = j
                                                                                                [by exists_elim with-offset-j2]
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                  @conclusion-i-second |
                                                                                    i = j
                                                                                    [by exists_elim with-offset-i2]
                                                                                }
                                                                            }
                                                                        }
                                                                      @entries-equal-implies |
                                                                        znAt(u, i) = znAt(u, j) -> i = j
                                                                        [by implies_intro given-entries-equal]
                                                                    }
                                                                  @j-below-b-implies |
                                                                    less_than(j, nadd(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j
                                                                    [by implies_intro given-j-below-b]
                                                                }
                                                              @i-below-b-implies |
                                                                less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j
                                                                [by implies_intro given-i-below-b]
                                                            }
                                                          @discharge-j-b |
                                                            forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j
                                                            [by forall_intro generalize-j-b]
                                                        }
                                                      @no-repetition |
                                                        forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j
                                                        [by forall_intro generalize-i-b]
                                                      // (c) every non-generator appears.
                                                      @generalize-z |
                                                        fix z: Zn {
                                                          @given-non-generator |
                                                            assume not generates(z) {
                                                              @non-generator |
                                                                not generates(z)
                                                                [by hypothesis given-non-generator]
                                                              @z-listed |
                                                                (exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))) or (exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q)))
                                                                [using specialize coverage(z) non-generator]
                                                              @conclusion-z-appears |
                                                                exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z
                                                                case z-listed {
                                                                  @when-first |
                                                                    assume exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p)) {
                                                                      @first-exists |
                                                                        exists k: Nat; less_than(k, qn) and z = cls(imul(toInt(k), p))
                                                                        [by hypothesis when-first]
                                                                      @with-index-k |
                                                                        unpack k: Nat from first-exists {
                                                                          @first-facts |
                                                                            less_than(k, qn) and z = cls(imul(toInt(k), p))
                                                                            [by hypothesis with-index-k]
                                                                          @k-below-qn |
                                                                            less_than(k, qn)
                                                                            [by and_elim_left first-facts]
                                                                          @z-closed |
                                                                            z = cls(imul(toInt(k), p))
                                                                            [by and_elim_right first-facts]
                                                                          @k-below-total |
                                                                            less_than(k, nadd(qn, pm))
                                                                            [using specialize belowTheBaseIsBelowTheSum(qn, pm, k) k-below-qn]
                                                                          @u-k-is-w1-k |
                                                                            znAt(u, k) = znAt(w1, k)
                                                                            [using specialize prefix-agrees(k) k-below-qn]
                                                                          @w1-k |
                                                                            znAt(w1, k) = cls(imul(toInt(k), p))
                                                                            [using specialize w1-entries(k) k-below-qn]
                                                                          @closed-is-z |
                                                                            cls(imul(toInt(k), p)) = z
                                                                            [by symmetry z-closed]
                                                                          @u-k-is-z |
                                                                            znAt(u, k) = z
                                                                            [using chain u-k-is-w1-k w1-k closed-is-z]
                                                                          @k-witnesses |
                                                                            less_than(k, nadd(qn, pm)) and znAt(u, k) = z
                                                                            [by and_intro k-below-total u-k-is-z]
                                                                          @conclusion-when-first-inner |
                                                                            exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z
                                                                            [by exists_intro(k) k-witnesses]
                                                                        }
                                                                      @conclusion-when-first |
                                                                        exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z
                                                                        [by exists_elim with-index-k]
                                                                    }
                                                                  @when-second |
                                                                    assume exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q)) {
                                                                      @second-exists |
                                                                        exists k: Nat; less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))
                                                                        [by hypothesis when-second]
                                                                      @with-index-k |
                                                                        unpack k: Nat from second-exists {
                                                                          @second-facts |
                                                                            less_than(k, pm) and z = cls(imul(toInt(succ(k)), q))
                                                                            [by hypothesis with-index-k]
                                                                          @k-below-pm |
                                                                            less_than(k, pm)
                                                                            [by and_elim_left second-facts]
                                                                          @z-closed |
                                                                            z = cls(imul(toInt(succ(k)), q))
                                                                            [by and_elim_right second-facts]
                                                                          @offset-below-total |
                                                                            less_than(nadd(qn, k), nadd(qn, pm))
                                                                            [using specialize additionPreservesOrder(k, pm, qn) k-below-pm]
                                                                          @u-offset-is-w2-k |
                                                                            znAt(u, nadd(qn, k)) = znAt(w2, k)
                                                                            [using specialize block-agrees(k) k-below-pm]
                                                                          @w2-k |
                                                                            znAt(w2, k) = cls(imul(toInt(succ(k)), q))
                                                                            [using specialize w2-entries(k) k-below-pm]
                                                                          @closed-is-z |
                                                                            cls(imul(toInt(succ(k)), q)) = z
                                                                            [by symmetry z-closed]
                                                                          @u-offset-is-z |
                                                                            znAt(u, nadd(qn, k)) = z
                                                                            [using chain u-offset-is-w2-k w2-k closed-is-z]
                                                                          @offset-witnesses |
                                                                            less_than(nadd(qn, k), nadd(qn, pm)) and znAt(u, nadd(qn, k)) = z
                                                                            [by and_intro offset-below-total u-offset-is-z]
                                                                          @conclusion-when-second-inner |
                                                                            exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z
                                                                            [by exists_intro(nadd(qn, k)) offset-witnesses]
                                                                        }
                                                                      @conclusion-when-second |
                                                                        exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z
                                                                        [by exists_elim with-index-k]
                                                                    }
                                                                }
                                                            }
                                                          @non-generator-implies |
                                                            (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z
                                                            [by implies_intro given-non-generator]
                                                        }
                                                      @every-non-generator-appears |
                                                        forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z
                                                        [by forall_intro generalize-z]
                                                      @u-lists-the-non-generators |
                                                        (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z)
                                                        [using tautology no-entry-generates no-repetition every-non-generator-appears]
                                                      @conclusion-with-u-inner |
                                                        exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                                                        [by exists_intro(u) u-lists-the-non-generators]
                                                    }
                                                  @conclusion-with-u |
                                                    exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                                                    [by exists_elim with-concatenation-u]
                                                }
                                              @conclusion-with-w2 |
                                                exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                                                [by exists_elim with-second-part-w2]
                                            }
                                          @conclusion-listed |
                                            exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                                            [by exists_elim with-first-part-w1]
                                        }
                                      @q-image-implies |
                                        toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                                        [by implies_intro given-q-image]
                                    }
                                  @p-image-implies |
                                    toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                                    [by implies_intro given-p-image]
                                }
                              @modulus-implies |
                                N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                                [by implies_intro given-modulus]
                            }
                          @distinct-implies |
                            p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                            [by implies_intro given-distinct]
                        }
                      @q-prime-implies |
                        is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                        [by implies_intro given-q-prime]
                    }
                  @p-prime-implies |
                    is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                    [by implies_intro given-p-prime]
                }
              @discharge-qn |
                forall qn: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
                [by forall_intro generalize-qn]
            }
          @discharge-pm |
            forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
            [by forall_intro generalize-pm]
        }
      @discharge-q |
        forall q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u2: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u2, j) = z)
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall p, q: Int; forall pm: Nat; forall qn: Nat; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> toInt(succ(pm)) = p -> toInt(qn) = q -> exists u: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z)
    [by forall_intro generalize-p]
qed

// -- (x − 1) + 1 = x, in successor form ----------------------------------------------------------
theorem succOfPredecessor: forall x: Int; isucc(isub(x, IONE)) = x
proof
  @generalize-x |
    fix x: Int {
      @one-is-succ-zero |
        IONE = isucc(IZERO)
        [by cite oneIsSuccZero]
      @plus-succ-zero |
        iadd(isub(x, IONE), isucc(IZERO)) = isucc(iadd(isub(x, IONE), IZERO))
        [using specialize intAddSuccRight(isub(x, IONE), IZERO)]
      @plus-zero |
        iadd(isub(x, IONE), IZERO) = isub(x, IONE)
        [using specialize intAddZeroRight(isub(x, IONE))]
      @plus-succ-zero-collapsed |
        iadd(isub(x, IONE), isucc(IZERO)) = isucc(isub(x, IONE))
        [by rewrite plus-zero plus-succ-zero]
      @plus-one |
        iadd(isub(x, IONE), IONE) = isucc(isub(x, IONE))
        [by rewrite one-is-succ-zero plus-succ-zero-collapsed]
      @succ-as-plus-one |
        isucc(isub(x, IONE)) = iadd(isub(x, IONE), IONE)
        [by symmetry plus-one]
      @difference-unfolds |
        isub(x, IONE) = iadd(x, ineg(IONE))
        [using specialize definitionOfSubtraction(x, IONE)]
      @succ-unfolded |
        isucc(isub(x, IONE)) = iadd(iadd(x, ineg(IONE)), IONE)
        [by rewrite difference-unfolds succ-as-plus-one]
      @cancels |
        iadd(iadd(x, ineg(IONE)), IONE) = x
        [using polynomial(integer)]
      @conclusion-recovered |
        isucc(isub(x, IONE)) = x
        [using chain succ-unfolded cancels]
    }
  @conclusion |
    forall x: Int; isucc(isub(x, IONE)) = x
    [by forall_intro generalize-x]
qed

// -- THE COUNT: ℤ_pq has (p − 1)(q − 1) generators (Judson §4.1, exercise 24) -------------------
// Split the listing of ℤ_pq (pq classes) into generators and non-generators; the non-generators
// are also listed by the explicit q + (p − 1) multiples, and two injective listings of one class
// have the same length; so the generators number pq − q − (p − 1) = (p − 1)(q − 1).
theorem generatorCountOfZpq: forall p, q: Int; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> exists v: ZnSeq; exists c: Nat; (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = imul(isub(p, IONE), isub(q, IONE))
proof
  @generalize-p |
    fix p: Int {
      @generalize-q |
        fix q: Int {
          @given-p-prime |
            assume is_prime(p) {
              @given-q-prime |
                assume is_prime(q) {
                  @given-distinct |
                    assume p != q {
                      @given-modulus |
                        assume N = imul(p, q) {
                          @p-prime |
                            is_prime(p)
                            [by hypothesis given-p-prime]
                          @q-prime |
                            is_prime(q)
                            [by hypothesis given-q-prime]
                          @distinct |
                            p != q
                            [by hypothesis given-distinct]
                          @modulus |
                            N = imul(p, q)
                            [by hypothesis given-modulus]
                          @p-prime-facts |
                            int_less_than(IONE, p) and (forall d: Int; int_less_than(IZERO, d) -> divides(d, p) -> (d = IONE or d = p))
                            [by hypothesis given-p-prime]
                          @one-below-p |
                            int_less_than(IONE, p)
                            [using tautology p-prime-facts]
                          @q-positive |
                            int_less_than(IZERO, q)
                            [using specialize primeIsPositive(q) q-prime]
                          @q-nonneg |
                            nonneg(q)
                            [using specialize positiveIsNonneg(q) q-positive]
                          @p-predecessor-nonneg |
                            nonneg(isub(p, IONE))
                            [using specialize lessThanGivesNonnegDifference(IONE, p) one-below-p]
                          @pm-exists |
                            exists m: Nat; toInt(m) = isub(p, IONE)
                            [using specialize everyNonnegIsAnImage(isub(p, IONE)) p-predecessor-nonneg]
                          @qn-exists |
                            exists m: Nat; toInt(m) = q
                            [using specialize everyNonnegIsAnImage(q) q-nonneg]
                          @listing-exists |
                            exists m: Nat; exists w: ZnSeq; toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                            [by cite znIsListedByItsRepresentatives]
                          @with-pm |
                            unpack pm: Nat from pm-exists {
                              @pm-image |
                                toInt(pm) = isub(p, IONE)
                                [by hypothesis with-pm]
                              @succ-pm-image-raw |
                                toInt(succ(pm)) = isucc(toInt(pm))
                                [using specialize toIntSucc(pm)]
                              @succ-pm-image-unfolded |
                                toInt(succ(pm)) = isucc(isub(p, IONE))
                                [by rewrite pm-image succ-pm-image-raw]
                              @predecessor-recovers |
                                isucc(isub(p, IONE)) = p
                                [using specialize succOfPredecessor(p)]
                              @p-image |
                                toInt(succ(pm)) = p
                                [using chain succ-pm-image-unfolded predecessor-recovers]
                              @with-qn |
                                unpack qn: Nat from qn-exists {
                                  @q-image |
                                    toInt(qn) = q
                                    [by hypothesis with-qn]
                                  @u-exists |
                                    exists u: ZnSeq; (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z)
                                    [using specialize nonGeneratorsOfZpqAreListed(p, q, pm, qn) p-prime q-prime distinct modulus p-image q-image]
                                  @with-m |
                                    unpack m: Nat from listing-exists {
                                      @after-m |
                                        exists w: ZnSeq; toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                                        [by hypothesis with-m]
                                      @with-w |
                                        unpack w: ZnSeq from after-m {
                                          @listing-facts |
                                            toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                                            [by hypothesis with-w]
                                          @m-image |
                                            toInt(m) = N
                                            [using tautology listing-facts]
                                          @w-injective |
                                            forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j
                                            [using tautology listing-facts]
                                          @w-covers |
                                            forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g
                                            [using tautology listing-facts]
                                          @split |
                                            exists v: ZnSeq; exists c: Nat; exists v2: ZnSeq; exists d: Nat; nadd(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                            [using specialize znGeneratorsAndNonGeneratorsAreListed(m, w) w-injective w-covers]
                                          @with-v |
                                            unpack v: ZnSeq from split {
                                              @after-v |
                                                exists c: Nat; exists v2: ZnSeq; exists d: Nat; nadd(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                [by hypothesis with-v]
                                              @with-c |
                                                unpack c: Nat from after-v {
                                                  @after-c |
                                                    exists v2: ZnSeq; exists d: Nat; nadd(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                    [by hypothesis with-c]
                                                  @with-v2 |
                                                    unpack v2: ZnSeq from after-c {
                                                      @after-v2 |
                                                        exists d: Nat; nadd(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                        [by hypothesis with-v2]
                                                      @with-d |
                                                        unpack d: Nat from after-v2 {
                                                          @split-facts |
                                                            nadd(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                            [by hypothesis with-d]
                                                          @lengths-add |
                                                            nadd(c, d) = m
                                                            [using tautology split-facts]
                                                          @v-generates |
                                                            forall j: Nat; less_than(j, c) -> generates(znAt(v, j))
                                                            [using tautology split-facts]
                                                          @v-injective |
                                                            forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j
                                                            [using tautology split-facts]
                                                          @v-covers |
                                                            forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g
                                                            [using tautology split-facts]
                                                          @v2-non-generators |
                                                            forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))
                                                            [using tautology split-facts]
                                                          @v2-injective |
                                                            forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j
                                                            [using tautology split-facts]
                                                          @v2-covers |
                                                            forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g
                                                            [using tautology split-facts]
                                                          @with-u |
                                                            unpack u: ZnSeq from u-exists {
                                                              @u-facts |
                                                                (forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z)
                                                                [by hypothesis with-u]
                                                              @u-non-generators |
                                                                forall j: Nat; less_than(j, nadd(qn, pm)) -> (not generates(znAt(u, j)))
                                                                [using tautology u-facts]
                                                              @u-injective |
                                                                forall i: Nat; forall j: Nat; less_than(i, nadd(qn, pm)) -> less_than(j, nadd(qn, pm)) -> znAt(u, i) = znAt(u, j) -> i = j
                                                                [using tautology u-facts]
                                                              @u-covers |
                                                                forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, nadd(qn, pm)) and znAt(u, j) = z
                                                                [using tautology u-facts]
                                                              // v2 is drawn from u.
                                                              @generalize-j-v2 |
                                                                fix j: Nat {
                                                                  @given-j-below-d |
                                                                    assume less_than(j, d) {
                                                                      @j-below-d |
                                                                        less_than(j, d)
                                                                        [by hypothesis given-j-below-d]
                                                                      @v2-j-non-generator |
                                                                        not generates(znAt(v2, j))
                                                                        [using specialize v2-non-generators(j) j-below-d]
                                                                      @v2-j-in-u |
                                                                        exists i: Nat; less_than(i, nadd(qn, pm)) and znAt(u, i) = znAt(v2, j)
                                                                        [using specialize u-covers(znAt(v2, j)) v2-j-non-generator]
                                                                      @with-match-i |
                                                                        unpack i: Nat from v2-j-in-u {
                                                                          @match-facts |
                                                                            less_than(i, nadd(qn, pm)) and znAt(u, i) = znAt(v2, j)
                                                                            [by hypothesis with-match-i]
                                                                          @i-below |
                                                                            less_than(i, nadd(qn, pm))
                                                                            [by and_elim_left match-facts]
                                                                          @u-i-is-v2-j |
                                                                            znAt(u, i) = znAt(v2, j)
                                                                            [by and_elim_right match-facts]
                                                                          @v2-j-is-u-i |
                                                                            znAt(v2, j) = znAt(u, i)
                                                                            [by symmetry u-i-is-v2-j]
                                                                          @match-witnessed |
                                                                            less_than(i, nadd(qn, pm)) and znAt(v2, j) = znAt(u, i)
                                                                            [by and_intro i-below v2-j-is-u-i]
                                                                          @conclusion-j-drawn-inner |
                                                                            exists i2: Nat; less_than(i2, nadd(qn, pm)) and znAt(v2, j) = znAt(u, i2)
                                                                            [by exists_intro(i) match-witnessed]
                                                                        }
                                                                      @conclusion-j-drawn |
                                                                        exists i2: Nat; less_than(i2, nadd(qn, pm)) and znAt(v2, j) = znAt(u, i2)
                                                                        [by exists_elim with-match-i]
                                                                    }
                                                                  @j-below-d-implies |
                                                                    less_than(j, d) -> exists i2: Nat; less_than(i2, nadd(qn, pm)) and znAt(v2, j) = znAt(u, i2)
                                                                    [by implies_intro given-j-below-d]
                                                                }
                                                              @v2-drawn-from-u |
                                                                forall j: Nat; less_than(j, d) -> exists i2: Nat; less_than(i2, nadd(qn, pm)) and znAt(v2, j) = znAt(u, i2)
                                                                [by forall_intro generalize-j-v2]
                                                              // u is drawn from v2.
                                                              @generalize-j-u |
                                                                fix j: Nat {
                                                                  @given-j-below-total |
                                                                    assume less_than(j, nadd(qn, pm)) {
                                                                      @j-below-total |
                                                                        less_than(j, nadd(qn, pm))
                                                                        [by hypothesis given-j-below-total]
                                                                      @u-j-non-generator |
                                                                        not generates(znAt(u, j))
                                                                        [using specialize u-non-generators(j) j-below-total]
                                                                      @u-j-in-v2 |
                                                                        exists i: Nat; less_than(i, d) and znAt(v2, i) = znAt(u, j)
                                                                        [using specialize v2-covers(znAt(u, j)) u-j-non-generator]
                                                                      @with-match-i |
                                                                        unpack i: Nat from u-j-in-v2 {
                                                                          @match-facts |
                                                                            less_than(i, d) and znAt(v2, i) = znAt(u, j)
                                                                            [by hypothesis with-match-i]
                                                                          @i-below |
                                                                            less_than(i, d)
                                                                            [by and_elim_left match-facts]
                                                                          @v2-i-is-u-j |
                                                                            znAt(v2, i) = znAt(u, j)
                                                                            [by and_elim_right match-facts]
                                                                          @u-j-is-v2-i |
                                                                            znAt(u, j) = znAt(v2, i)
                                                                            [by symmetry v2-i-is-u-j]
                                                                          @match-witnessed |
                                                                            less_than(i, d) and znAt(u, j) = znAt(v2, i)
                                                                            [by and_intro i-below u-j-is-v2-i]
                                                                          @conclusion-j-drawn-inner |
                                                                            exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                            [by exists_intro(i) match-witnessed]
                                                                        }
                                                                      @conclusion-j-drawn |
                                                                        exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                        [by exists_elim with-match-i]
                                                                    }
                                                                  @j-below-total-implies |
                                                                    less_than(j, nadd(qn, pm)) -> exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                    [by implies_intro given-j-below-total]
                                                                }
                                                              @u-drawn-from-v2 |
                                                                forall j: Nat; less_than(j, nadd(qn, pm)) -> exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                [by forall_intro generalize-j-u]
                                                              @lengths-equal |
                                                                d = nadd(qn, pm)
                                                                [using specialize znListingsOfTheSameClassHaveEqualLength(d, v2, nadd(qn, pm), u) v2-injective u-injective v2-drawn-from-u u-drawn-from-v2]
                                                              // arithmetic: pq = c + q + (p − 1).
                                                              @sum-with-parts |
                                                                nadd(c, nadd(qn, pm)) = m
                                                                [by rewrite lengths-equal lengths-add]
                                                              @sum-image-raw |
                                                                toInt(nadd(c, nadd(qn, pm))) = iadd(toInt(c), toInt(nadd(qn, pm)))
                                                                [using specialize toIntAdd(c, nadd(qn, pm))]
                                                              @m-image-as-sum |
                                                                toInt(m) = iadd(toInt(c), toInt(nadd(qn, pm)))
                                                                [by rewrite sum-with-parts sum-image-raw]
                                                              @parts-image-raw |
                                                                toInt(nadd(qn, pm)) = iadd(toInt(qn), toInt(pm))
                                                                [using specialize toIntAdd(qn, pm)]
                                                              @parts-image-q |
                                                                toInt(nadd(qn, pm)) = iadd(q, toInt(pm))
                                                                [by rewrite q-image parts-image-raw]
                                                              @parts-image |
                                                                toInt(nadd(qn, pm)) = iadd(q, isub(p, IONE))
                                                                [by rewrite pm-image parts-image-q]
                                                              @m-image-closed |
                                                                toInt(m) = iadd(toInt(c), iadd(q, isub(p, IONE)))
                                                                [by rewrite parts-image m-image-as-sum]
                                                              @n-is-m-image |
                                                                N = toInt(m)
                                                                [by symmetry m-image]
                                                              @pq-is-sum-raw |
                                                                imul(p, q) = toInt(m)
                                                                [by rewrite modulus n-is-m-image]
                                                              @pq-is-sum |
                                                                imul(p, q) = iadd(toInt(c), iadd(q, isub(p, IONE)))
                                                                [using chain pq-is-sum-raw m-image-closed]
                                                              @sum-is-pq |
                                                                iadd(toInt(c), iadd(q, isub(p, IONE))) = imul(p, q)
                                                                [by symmetry pq-is-sum]
                                                              @c-recovered |
                                                                toInt(c) = iadd(iadd(toInt(c), iadd(q, isub(p, IONE))), ineg(iadd(q, isub(p, IONE))))
                                                                [using polynomial(integer)]
                                                              @c-from-pq |
                                                                toInt(c) = iadd(imul(p, q), ineg(iadd(q, isub(p, IONE))))
                                                                [by rewrite sum-is-pq c-recovered]
                                                              @closed-form |
                                                                iadd(imul(p, q), ineg(iadd(q, isub(p, IONE)))) = imul(isub(p, IONE), isub(q, IONE))
                                                                [using polynomial(integer)]
                                                              @count |
                                                                toInt(c) = imul(isub(p, IONE), isub(q, IONE))
                                                                [using chain c-from-pq closed-form]
                                                              @packaged |
                                                                (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = imul(isub(p, IONE), isub(q, IONE))
                                                                [using tautology v-generates v-injective v-covers count]
                                                              @conclusion-with-count |
                                                                exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                                                                [by exists_intro(c) packaged]
                                                            }
                                                          @conclusion-with-u |
                                                            exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                                                            [by exists_elim with-u]
                                                        }
                                                      @conclusion-with-d |
                                                        exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                                                        [by exists_elim with-d]
                                                    }
                                                  @conclusion-with-v2 |
                                                    exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                                                    [by exists_elim with-v2]
                                                }
                                              @conclusion-with-c |
                                                exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                                                [by exists_elim with-c]
                                              @conclusion-with-v-inner |
                                                exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                                                [by exists_intro(v) conclusion-with-c]
                                            }
                                          @conclusion-with-v |
                                            exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                                            [by exists_elim with-v]
                                        }
                                      @conclusion-with-w |
                                        exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                                        [by exists_elim with-w]
                                    }
                                  @conclusion-with-m |
                                    exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                                    [by exists_elim with-m]
                                }
                              @conclusion-with-qn |
                                exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                                [by exists_elim with-qn]
                            }
                          @conclusion-counted |
                            exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                            [by exists_elim with-pm]
                        }
                      @modulus-implies |
                        N = imul(p, q) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                        [by implies_intro given-modulus]
                    }
                  @distinct-implies |
                    p != q -> N = imul(p, q) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                    [by implies_intro given-distinct]
                }
              @q-prime-implies |
                is_prime(q) -> p != q -> N = imul(p, q) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
                [by implies_intro given-q-prime]
            }
          @p-prime-implies |
            is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
            [by implies_intro given-p-prime]
        }
      @discharge-q |
        forall q: Int; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(isub(p, IONE), isub(q, IONE))
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall p, q: Int; is_prime(p) -> is_prime(q) -> p != q -> N = imul(p, q) -> exists v: ZnSeq; exists c: Nat; (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = imul(isub(p, IONE), isub(q, IONE))
    [by forall_intro generalize-p]
qed

// -- prime powers (Judson §4.1, exercise 25) ---------------------------------------------------

// b > 0 ⟹ b^e > 0 for e ≥ 0.
theorem powOfPositiveIsPositive: forall b: Int; int_less_than(IZERO, b) -> forall e: Int; nonneg(e) -> int_less_than(IZERO, pow(b, e))
proof
  @generalize-b |
    fix b: Int {
      @given-positive |
        assume int_less_than(IZERO, b) {
          @positive |
            int_less_than(IZERO, b)
            [by hypothesis given-positive]
          @zeroth-power |
            pow(b, IZERO) = IONE
            [using specialize powZero(b)]
          @zero-below-one |
            int_less_than(IZERO, IONE)
            [by cite intZeroLessThanOne]
          @base-case |
            int_less_than(IZERO, pow(b, IZERO))
            [by rewrite zeroth-power zero-below-one]
          @induction-step |
            fix k: Int {
              @given-nonneg |
                assume nonneg(k) {
                  @given-inductive-hypothesis |
                    assume int_less_than(IZERO, pow(b, k)) {
                      @inductive-hypothesis |
                        int_less_than(IZERO, pow(b, k))
                        [by hypothesis given-inductive-hypothesis]
                      @next-unfolds |
                        pow(b, isucc(k)) = imul(pow(b, k), b)
                        [using specialize powSucc(b, k)]
                      @product-positive |
                        int_less_than(IZERO, imul(pow(b, k), b))
                        [using specialize productWithPositiveIsPositive(pow(b, k), b) inductive-hypothesis positive]
                      @conclusion-step |
                        int_less_than(IZERO, pow(b, isucc(k)))
                        [by rewrite next-unfolds product-positive]
                    }
                  @conclusion-given-hypothesis |
                    int_less_than(IZERO, pow(b, k)) -> int_less_than(IZERO, pow(b, isucc(k)))
                    [by implies_intro given-inductive-hypothesis]
                }
              @induction-step-at-k |
                nonneg(k) -> int_less_than(IZERO, pow(b, k)) -> int_less_than(IZERO, pow(b, isucc(k)))
                [by implies_intro given-nonneg]
            }
          @induction-step-for-all-k |
            forall k: Int; nonneg(k) -> int_less_than(IZERO, pow(b, k)) -> int_less_than(IZERO, pow(b, isucc(k)))
            [by forall_intro induction-step]
          @conclusion-all-exponents |
            forall e: Int; nonneg(e) -> int_less_than(IZERO, pow(b, e))
            [using instantiation nonnegInduction((fun e: Int => int_less_than(IZERO, pow(b, e)))) base-case induction-step-for-all-k]
        }
      @positive-implies |
        int_less_than(IZERO, b) -> forall e: Int; nonneg(e) -> int_less_than(IZERO, pow(b, e))
        [by implies_intro given-positive]
    }
  @conclusion |
    forall b: Int; int_less_than(IZERO, b) -> forall e: Int; nonneg(e) -> int_less_than(IZERO, pow(b, e))
    [by forall_intro generalize-b]
qed

// Bézout-coprime to p ⟹ Bézout-coprime to every p^e (multiply the identities up).
theorem bezoutCoprimeToPowers: forall r, p: Int; bezoutCoprime(r, p) -> forall e: Int; nonneg(e) -> bezoutCoprime(r, pow(p, e))
proof
  @generalize-r |
    fix r: Int {
      @generalize-p |
        fix p: Int {
          @given-coprime |
            assume bezoutCoprime(r, p) {
              @coprime |
                bezoutCoprime(r, p)
                [by hypothesis given-coprime]
              @zeroth-power |
                pow(p, IZERO) = IONE
                [using specialize powZero(p)]
              @one-identity |
                iadd(imul(r, IZERO), imul(IONE, IONE)) = IONE
                [using polynomial(integer)]
              @one-identity-t |
                exists t: Int; iadd(imul(r, IZERO), imul(IONE, t)) = IONE
                [by exists_intro(IONE) one-identity]
              @coprime-to-one |
                bezoutCoprime(r, IONE)
                [by exists_intro(IZERO) one-identity-t]
              @base-case |
                bezoutCoprime(r, pow(p, IZERO))
                [by rewrite zeroth-power coprime-to-one]
              @induction-step |
                fix k: Int {
                  @given-nonneg |
                    assume nonneg(k) {
                      @given-inductive-hypothesis |
                        assume bezoutCoprime(r, pow(p, k)) {
                          @inductive-hypothesis |
                            bezoutCoprime(r, pow(p, k))
                            [by hypothesis given-inductive-hypothesis]
                          @next-unfolds |
                            pow(p, isucc(k)) = imul(pow(p, k), p)
                            [using specialize powSucc(p, k)]
                          @coprime-to-product |
                            bezoutCoprime(r, imul(pow(p, k), p))
                            [using specialize bezoutCoprimeMultiplies(r, pow(p, k), p) inductive-hypothesis coprime]
                          @conclusion-step |
                            bezoutCoprime(r, pow(p, isucc(k)))
                            [by rewrite next-unfolds coprime-to-product]
                        }
                      @conclusion-given-hypothesis |
                        bezoutCoprime(r, pow(p, k)) -> bezoutCoprime(r, pow(p, isucc(k)))
                        [by implies_intro given-inductive-hypothesis]
                    }
                  @induction-step-at-k |
                    nonneg(k) -> bezoutCoprime(r, pow(p, k)) -> bezoutCoprime(r, pow(p, isucc(k)))
                    [by implies_intro given-nonneg]
                }
              @induction-step-for-all-k |
                forall k: Int; nonneg(k) -> bezoutCoprime(r, pow(p, k)) -> bezoutCoprime(r, pow(p, isucc(k)))
                [by forall_intro induction-step]
              @conclusion-all-exponents |
                forall e: Int; nonneg(e) -> bezoutCoprime(r, pow(p, e))
                [using instantiation nonnegInduction((fun e: Int => bezoutCoprime(r, pow(p, e)))) base-case induction-step-for-all-k]
            }
          @coprime-implies |
            bezoutCoprime(r, p) -> forall e: Int; nonneg(e) -> bezoutCoprime(r, pow(p, e))
            [by implies_intro given-coprime]
        }
      @discharge-p |
        forall p: Int; bezoutCoprime(r, p) -> forall e: Int; nonneg(e) -> bezoutCoprime(r, pow(p, e))
        [by forall_intro generalize-p]
    }
  @conclusion |
    forall r, p: Int; bezoutCoprime(r, p) -> forall e: Int; nonneg(e) -> bezoutCoprime(r, pow(p, e))
    [by forall_intro generalize-r]
qed

// for N = p^(e+1): cls(r) fails to generate ⟺ p | r.
theorem nonGeneratorOfPrimePowerIffPrimeDivides: forall p, e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
proof
  @generalize-p |
    fix p: Int {
      @generalize-e |
        fix e: Int {
          @given-prime |
            assume is_prime(p) {
              @given-nonneg |
                assume nonneg(e) {
                  @given-modulus |
                    assume N = pow(p, isucc(e)) {
                      @prime |
                        is_prime(p)
                        [by hypothesis given-prime]
                      @e-nonneg |
                        nonneg(e)
                        [by hypothesis given-nonneg]
                      @modulus |
                        N = pow(p, isucc(e))
                        [by hypothesis given-modulus]
                      @succ-e-nonneg |
                        nonneg(isucc(e))
                        [using specialize nonnegSucc(e) e-nonneg]
                      @power-unfolds |
                        pow(p, isucc(e)) = imul(pow(p, e), p)
                        [using specialize powSucc(p, e)]
                      @factors-commute |
                        imul(pow(p, e), p) = imul(p, pow(p, e))
                        [using specialize intMulIsCommutative(pow(p, e), p)]
                      @modulus-factored |
                        N = imul(p, pow(p, e))
                        [using chain modulus power-unfolds factors-commute]
                      @generalize-r |
                        fix r: Int {
                          @criterion-at-n |
                            generates(cls(r)) iff bezoutCoprime(r, N)
                            [using specialize generatesIffBezoutCoprime(r)]
                          @criterion |
                            generates(cls(r)) iff bezoutCoprime(r, pow(p, isucc(e)))
                            [by rewrite modulus criterion-at-n]
                          @criterion-factored |
                            generates(cls(r)) iff bezoutCoprime(r, imul(p, pow(p, e)))
                            [by rewrite modulus-factored criterion-at-n]
                          @p-blocks |
                            divides(p, r) -> (not bezoutCoprime(r, imul(p, pow(p, e))))
                            [using specialize primeFactorBlocksBezout(p, pow(p, e), r) prime]
                          @given-not-dividing |
                            assume not divides(p, r) {
                              @not-dividing |
                                not divides(p, r)
                                [by hypothesis given-not-dividing]
                              @coprime-to-p |
                                bezoutCoprime(r, p)
                                [using specialize primeNotDividingGivesBezout(p, r) prime not-dividing]
                              @conclusion-coprime-to-power |
                                bezoutCoprime(r, pow(p, isucc(e)))
                                [using specialize bezoutCoprimeToPowers(r, p, isucc(e)) coprime-to-p succ-e-nonneg]
                            }
                          @not-dividing-implies |
                            (not divides(p, r)) -> bezoutCoprime(r, pow(p, isucc(e)))
                            [by implies_intro given-not-dividing]
                          @conclusion-characterized |
                            (not generates(cls(r))) iff divides(p, r)
                            [using tautology criterion criterion-factored p-blocks not-dividing-implies]
                        }
                      @discharge-r |
                        forall r: Int; (not generates(cls(r))) iff divides(p, r)
                        [by forall_intro generalize-r]
                    }
                  @modulus-implies |
                    N = pow(p, isucc(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
                    [by implies_intro given-modulus]
                }
              @nonneg-implies |
                nonneg(e) -> N = pow(p, isucc(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
                [by implies_intro given-nonneg]
            }
          @prime-implies |
            is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
            [by implies_intro given-prime]
        }
      @discharge-e |
        forall e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
        [by forall_intro generalize-e]
    }
  @conclusion |
    forall p, e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> forall r: Int; (not generates(cls(r))) iff divides(p, r)
    [by forall_intro generalize-p]
qed

// THE NON-GENERATORS OF ℤ_{p^(e+1)}, LISTED: cls(kp) for k < p^e.
theorem nonGeneratorsOfZPrimePowerAreListed: forall p, e: Int; forall mn: Nat; is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> toInt(mn) = pow(p, e) -> exists u: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z)
proof
  @generalize-p |
    fix p: Int {
      @generalize-e |
        fix e: Int {
          @generalize-mn |
            fix mn: Nat {
              @given-prime |
                assume is_prime(p) {
                  @given-nonneg |
                    assume nonneg(e) {
                      @given-modulus |
                        assume N = pow(p, isucc(e)) {
                          @given-image |
                            assume toInt(mn) = pow(p, e) {
                              @prime |
                                is_prime(p)
                                [by hypothesis given-prime]
                              @e-nonneg |
                                nonneg(e)
                                [by hypothesis given-nonneg]
                              @modulus |
                                N = pow(p, isucc(e))
                                [by hypothesis given-modulus]
                              @image |
                                toInt(mn) = pow(p, e)
                                [by hypothesis given-image]
                              @p-positive |
                                int_less_than(IZERO, p)
                                [using specialize primeIsPositive(p) prime]
                              @cofactor-positive |
                                int_less_than(IZERO, pow(p, e))
                                [using specialize powOfPositiveIsPositive(p, e) p-positive e-nonneg]
                              @power-unfolds |
                                pow(p, isucc(e)) = imul(pow(p, e), p)
                                [using specialize powSucc(p, e)]
                              @factors-commute |
                                imul(pow(p, e), p) = imul(p, pow(p, e))
                                [using specialize intMulIsCommutative(pow(p, e), p)]
                              @modulus-factored |
                                N = imul(p, pow(p, e))
                                [using chain modulus power-unfolds factors-commute]
                              @characterization |
                                forall r: Int; (not generates(cls(r))) iff divides(p, r)
                                [using specialize nonGeneratorOfPrimePowerIffPrimeDivides(p, e) prime e-nonneg modulus]
                              @injective-multiples |
                                forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> cls(imul(toInt(i), p)) = cls(imul(toInt(j), p)) -> i = j
                                [using specialize multiplesDoNotRepeat(p, pow(p, e), mn) modulus-factored p-positive image]
                              @reduce |
                                forall c: Int; exists e2: Int; nonneg(e2) and int_less_than(e2, pow(p, e)) and cls(imul(c, p)) = cls(imul(e2, p))
                                [using specialize coefficientReducesModCofactor(p, pow(p, e)) modulus-factored cofactor-positive]
                              @listing-exists |
                                exists w: ZnSeq; forall i: Nat; less_than(i, mn) -> znAt(w, i) = cls(imul(toInt(i), p))
                                [using specialize sequenceOfMultiplesExists(p, mn)]
                              @with-u |
                                unpack u: ZnSeq from listing-exists {
                                  @u-entries |
                                    forall i: Nat; less_than(i, mn) -> znAt(u, i) = cls(imul(toInt(i), p))
                                    [by hypothesis with-u]
                                  // (a) no entry generates.
                                  @generalize-j-a |
                                    fix j: Nat {
                                      @given-j-below-a |
                                        assume less_than(j, mn) {
                                          @j-below-a |
                                            less_than(j, mn)
                                            [by hypothesis given-j-below-a]
                                          @u-j |
                                            znAt(u, j) = cls(imul(toInt(j), p))
                                            [using specialize u-entries(j) j-below-a]
                                          @multiple-commutes |
                                            imul(toInt(j), p) = imul(p, toInt(j))
                                            [using specialize intMulIsCommutative(toInt(j), p)]
                                          @p-divides-multiple |
                                            divides(p, imul(toInt(j), p))
                                            [using specialize dividesIntro(imul(toInt(j), p), p, toInt(j)) multiple-commutes]
                                          @entry-characterized |
                                            (not generates(cls(imul(toInt(j), p)))) iff divides(p, imul(toInt(j), p))
                                            [using specialize characterization(imul(toInt(j), p))]
                                          @closed-non-generator |
                                            not generates(cls(imul(toInt(j), p)))
                                            [using tautology entry-characterized p-divides-multiple]
                                          @conclusion-j-non-generator |
                                            not generates(znAt(u, j))
                                            [by rewrite u-j closed-non-generator]
                                        }
                                      @j-a-implies |
                                        less_than(j, mn) -> (not generates(znAt(u, j)))
                                        [by implies_intro given-j-below-a]
                                    }
                                  @no-entry-generates |
                                    forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))
                                    [by forall_intro generalize-j-a]
                                  // (b) no repetition.
                                  @generalize-i-b |
                                    fix i: Nat {
                                      @generalize-j-b |
                                        fix j: Nat {
                                          @given-i-below-b |
                                            assume less_than(i, mn) {
                                              @given-j-below-b |
                                                assume less_than(j, mn) {
                                                  @given-entries-equal |
                                                    assume znAt(u, i) = znAt(u, j) {
                                                      @i-below-b |
                                                        less_than(i, mn)
                                                        [by hypothesis given-i-below-b]
                                                      @j-below-b |
                                                        less_than(j, mn)
                                                        [by hypothesis given-j-below-b]
                                                      @entries-equal |
                                                        znAt(u, i) = znAt(u, j)
                                                        [by hypothesis given-entries-equal]
                                                      @u-i |
                                                        znAt(u, i) = cls(imul(toInt(i), p))
                                                        [using specialize u-entries(i) i-below-b]
                                                      @u-j |
                                                        znAt(u, j) = cls(imul(toInt(j), p))
                                                        [using specialize u-entries(j) j-below-b]
                                                      @closed-i-is-u-i |
                                                        cls(imul(toInt(i), p)) = znAt(u, i)
                                                        [by symmetry u-i]
                                                      @closed-entries-equal |
                                                        cls(imul(toInt(i), p)) = cls(imul(toInt(j), p))
                                                        [using chain closed-i-is-u-i entries-equal u-j]
                                                      @conclusion-indices-equal |
                                                        i = j
                                                        [using specialize injective-multiples(i, j) i-below-b j-below-b closed-entries-equal]
                                                    }
                                                  @entries-equal-implies |
                                                    znAt(u, i) = znAt(u, j) -> i = j
                                                    [by implies_intro given-entries-equal]
                                                }
                                              @j-below-b-implies |
                                                less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j
                                                [by implies_intro given-j-below-b]
                                            }
                                          @i-below-b-implies |
                                            less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j
                                            [by implies_intro given-i-below-b]
                                        }
                                      @discharge-j-b |
                                        forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j
                                        [by forall_intro generalize-j-b]
                                    }
                                  @no-repetition |
                                    forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j
                                    [by forall_intro generalize-i-b]
                                  // (c) every non-generator appears.
                                  @generalize-z |
                                    fix z: Zn {
                                      @given-non-generator |
                                        assume not generates(z) {
                                          @non-generator |
                                            not generates(z)
                                            [by hypothesis given-non-generator]
                                          @z-has-representative |
                                            exists k: Int; z = cls(k)
                                            [using specialize clsSurjective(z)]
                                          @with-representative-r |
                                            unpack r: Int from z-has-representative {
                                              @z-is-cls-r |
                                                z = cls(r)
                                                [by hypothesis with-representative-r]
                                              @cls-r-non-generator |
                                                not generates(cls(r))
                                                [by rewrite z-is-cls-r non-generator]
                                              @r-characterized |
                                                (not generates(cls(r))) iff divides(p, r)
                                                [using specialize characterization(r)]
                                              @p-divides-r |
                                                divides(p, r)
                                                [using tautology r-characterized cls-r-non-generator]
                                              @with-cofactor-c |
                                                unpack c: Int from p-divides-r {
                                                  @r-is-pc |
                                                    r = imul(p, c)
                                                    [by hypothesis with-cofactor-c]
                                                  @pc-commutes |
                                                    imul(p, c) = imul(c, p)
                                                    [using specialize intMulIsCommutative(p, c)]
                                                  @r-is-cp |
                                                    r = imul(c, p)
                                                    [using chain r-is-pc pc-commutes]
                                                  @reduced |
                                                    exists e2: Int; nonneg(e2) and int_less_than(e2, pow(p, e)) and cls(imul(c, p)) = cls(imul(e2, p))
                                                    [using specialize reduce(c)]
                                                  @with-remainder-e2 |
                                                    unpack e2: Int from reduced {
                                                      @remainder-facts |
                                                        nonneg(e2) and int_less_than(e2, pow(p, e)) and cls(imul(c, p)) = cls(imul(e2, p))
                                                        [by hypothesis with-remainder-e2]
                                                      @e2-nonneg |
                                                        nonneg(e2)
                                                        [using tautology remainder-facts]
                                                      @e2-below |
                                                        int_less_than(e2, pow(p, e))
                                                        [using tautology remainder-facts]
                                                      @classes-agree |
                                                        cls(imul(c, p)) = cls(imul(e2, p))
                                                        [using tautology remainder-facts]
                                                      @e2-is-an-image |
                                                        exists k: Nat; toInt(k) = e2
                                                        [using specialize everyNonnegIsAnImage(e2) e2-nonneg]
                                                      @with-index-k |
                                                        unpack k: Nat from e2-is-an-image {
                                                          @k-image |
                                                            toInt(k) = e2
                                                            [by hypothesis with-index-k]
                                                          @k-image-below |
                                                            int_less_than(toInt(k), pow(p, e))
                                                            [by rewrite k-image e2-below]
                                                          @k-image-below-mn-image |
                                                            int_less_than(toInt(k), toInt(mn))
                                                            [by rewrite image k-image-below]
                                                          @k-below-mn |
                                                            less_than(k, mn)
                                                            [using specialize toIntReflectsOrder(k, mn) k-image-below-mn-image]
                                                          @u-k |
                                                            znAt(u, k) = cls(imul(toInt(k), p))
                                                            [using specialize u-entries(k) k-below-mn]
                                                          @u-k-is-e2-multiple |
                                                            znAt(u, k) = cls(imul(e2, p))
                                                            [by rewrite k-image u-k]
                                                          @e2-multiple-is-c-multiple |
                                                            cls(imul(e2, p)) = cls(imul(c, p))
                                                            [by symmetry classes-agree]
                                                          @cp-is-r |
                                                            imul(c, p) = r
                                                            [by symmetry r-is-cp]
                                                          @c-multiple-is-cls-r |
                                                            cls(imul(c, p)) = cls(r)
                                                            [by rewrite cp-is-r cls-r-reflexive]
                                                          @cls-r-reflexive |
                                                            cls(r) = cls(r)
                                                            [by reflexivity]
                                                          @cls-r-is-z |
                                                            cls(r) = z
                                                            [by symmetry z-is-cls-r]
                                                          @u-k-is-z |
                                                            znAt(u, k) = z
                                                            [using chain u-k-is-e2-multiple e2-multiple-is-c-multiple c-multiple-is-cls-r cls-r-is-z]
                                                          @k-witnesses |
                                                            less_than(k, mn) and znAt(u, k) = z
                                                            [by and_intro k-below-mn u-k-is-z]
                                                          @conclusion-z-appears-inner |
                                                            exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                                            [by exists_intro(k) k-witnesses]
                                                        }
                                                      @conclusion-with-k |
                                                        exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                                        [by exists_elim with-index-k]
                                                    }
                                                  @conclusion-with-e2 |
                                                    exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                                    [by exists_elim with-remainder-e2]
                                                }
                                              @conclusion-with-c |
                                                exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                                [by exists_elim with-cofactor-c]
                                            }
                                          @conclusion-z-appears |
                                            exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                            [by exists_elim with-representative-r]
                                        }
                                      @non-generator-implies |
                                        (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                        [by implies_intro given-non-generator]
                                    }
                                  @every-non-generator-appears |
                                    forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                    [by forall_intro generalize-z]
                                  @u-lists-the-non-generators |
                                    (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z)
                                    [using tautology no-entry-generates no-repetition every-non-generator-appears]
                                  @conclusion-with-u-inner |
                                    exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                                    [by exists_intro(u) u-lists-the-non-generators]
                                }
                              @conclusion-listed |
                                exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                                [by exists_elim with-u]
                            }
                          @image-implies |
                            toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                            [by implies_intro given-image]
                        }
                      @modulus-implies |
                        N = pow(p, isucc(e)) -> toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                        [by implies_intro given-modulus]
                    }
                  @nonneg-implies |
                    nonneg(e) -> N = pow(p, isucc(e)) -> toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                    [by implies_intro given-nonneg]
                }
              @prime-implies |
                is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
                [by implies_intro given-prime]
            }
          @discharge-mn |
            forall mn: Nat; is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
            [by forall_intro generalize-mn]
        }
      @discharge-e |
        forall e: Int; forall mn: Nat; is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> toInt(mn) = pow(p, e) -> exists u2: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u2, i) = znAt(u2, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u2, j) = z)
        [by forall_intro generalize-e]
    }
  @conclusion |
    forall p, e: Int; forall mn: Nat; is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> toInt(mn) = pow(p, e) -> exists u: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z)
    [by forall_intro generalize-p]
qed

// THE COUNT: ℤ_{p^(e+1)} has p^e (p − 1) generators (Judson §4.1, exercise 25).
theorem generatorCountOfZPrimePower: forall p, e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> exists v: ZnSeq; exists c: Nat; (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = imul(pow(p, e), isub(p, IONE))
proof
  @generalize-p |
    fix p: Int {
      @generalize-e |
        fix e: Int {
          @given-prime |
            assume is_prime(p) {
              @given-nonneg |
                assume nonneg(e) {
                  @given-modulus |
                    assume N = pow(p, isucc(e)) {
                      @prime |
                        is_prime(p)
                        [by hypothesis given-prime]
                      @e-nonneg |
                        nonneg(e)
                        [by hypothesis given-nonneg]
                      @modulus |
                        N = pow(p, isucc(e))
                        [by hypothesis given-modulus]
                      @p-positive |
                        int_less_than(IZERO, p)
                        [using specialize primeIsPositive(p) prime]
                      @cofactor-positive |
                        int_less_than(IZERO, pow(p, e))
                        [using specialize powOfPositiveIsPositive(p, e) p-positive e-nonneg]
                      @cofactor-nonneg |
                        nonneg(pow(p, e))
                        [using specialize positiveIsNonneg(pow(p, e)) cofactor-positive]
                      @mn-exists |
                        exists m: Nat; toInt(m) = pow(p, e)
                        [using specialize everyNonnegIsAnImage(pow(p, e)) cofactor-nonneg]
                      @power-unfolds |
                        pow(p, isucc(e)) = imul(pow(p, e), p)
                        [using specialize powSucc(p, e)]
                      @listing-exists |
                        exists m: Nat; exists w: ZnSeq; toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                        [by cite znIsListedByItsRepresentatives]
                      @with-mn |
                        unpack mn: Nat from mn-exists {
                          @mn-image |
                            toInt(mn) = pow(p, e)
                            [by hypothesis with-mn]
                          @u-exists |
                            exists u: ZnSeq; (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z)
                            [using specialize nonGeneratorsOfZPrimePowerAreListed(p, e, mn) prime e-nonneg modulus mn-image]
                          @with-m |
                            unpack m: Nat from listing-exists {
                              @after-m |
                                exists w: ZnSeq; toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                                [by hypothesis with-m]
                              @with-w |
                                unpack w: ZnSeq from after-m {
                                  @listing-facts |
                                    toInt(m) = N and (forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j) and (forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g)
                                    [by hypothesis with-w]
                                  @m-image |
                                    toInt(m) = N
                                    [using tautology listing-facts]
                                  @w-injective |
                                    forall i: Nat; forall j: Nat; less_than(i, m) -> less_than(j, m) -> znAt(w, i) = znAt(w, j) -> i = j
                                    [using tautology listing-facts]
                                  @w-covers |
                                    forall g: Zn; exists i: Nat; less_than(i, m) and znAt(w, i) = g
                                    [using tautology listing-facts]
                                  @split |
                                    exists v: ZnSeq; exists c: Nat; exists v2: ZnSeq; exists d: Nat; nadd(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                    [using specialize znGeneratorsAndNonGeneratorsAreListed(m, w) w-injective w-covers]
                                  @with-v |
                                    unpack v: ZnSeq from split {
                                      @after-v |
                                        exists c: Nat; exists v2: ZnSeq; exists d: Nat; nadd(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                        [by hypothesis with-v]
                                      @with-c |
                                        unpack c: Nat from after-v {
                                          @after-c |
                                            exists v2: ZnSeq; exists d: Nat; nadd(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                            [by hypothesis with-c]
                                          @with-v2 |
                                            unpack v2: ZnSeq from after-c {
                                              @after-v2 |
                                                exists d: Nat; nadd(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                [by hypothesis with-v2]
                                              @with-d |
                                                unpack d: Nat from after-v2 {
                                                  @split-facts |
                                                    nadd(c, d) = m and (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and (forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))) and (forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j) and (forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g)
                                                    [by hypothesis with-d]
                                                  @lengths-add |
                                                    nadd(c, d) = m
                                                    [using tautology split-facts]
                                                  @v-generates |
                                                    forall j: Nat; less_than(j, c) -> generates(znAt(v, j))
                                                    [using tautology split-facts]
                                                  @v-injective |
                                                    forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j
                                                    [using tautology split-facts]
                                                  @v-covers |
                                                    forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g
                                                    [using tautology split-facts]
                                                  @v2-non-generators |
                                                    forall j: Nat; less_than(j, d) -> (not generates(znAt(v2, j)))
                                                    [using tautology split-facts]
                                                  @v2-injective |
                                                    forall i: Nat; forall j: Nat; less_than(i, d) -> less_than(j, d) -> znAt(v2, i) = znAt(v2, j) -> i = j
                                                    [using tautology split-facts]
                                                  @v2-covers |
                                                    forall g: Zn; (not generates(g)) -> exists j: Nat; less_than(j, d) and znAt(v2, j) = g
                                                    [using tautology split-facts]
                                                  @with-u |
                                                    unpack u: ZnSeq from u-exists {
                                                      @u-facts |
                                                        (forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))) and (forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j) and (forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z)
                                                        [by hypothesis with-u]
                                                      @u-non-generators |
                                                        forall j: Nat; less_than(j, mn) -> (not generates(znAt(u, j)))
                                                        [using tautology u-facts]
                                                      @u-injective |
                                                        forall i: Nat; forall j: Nat; less_than(i, mn) -> less_than(j, mn) -> znAt(u, i) = znAt(u, j) -> i = j
                                                        [using tautology u-facts]
                                                      @u-covers |
                                                        forall z: Zn; (not generates(z)) -> exists j: Nat; less_than(j, mn) and znAt(u, j) = z
                                                        [using tautology u-facts]
                                                      @generalize-j-v2 |
                                                        fix j: Nat {
                                                          @given-j-below-d |
                                                            assume less_than(j, d) {
                                                              @j-below-d |
                                                                less_than(j, d)
                                                                [by hypothesis given-j-below-d]
                                                              @v2-j-non-generator |
                                                                not generates(znAt(v2, j))
                                                                [using specialize v2-non-generators(j) j-below-d]
                                                              @v2-j-in-u |
                                                                exists i: Nat; less_than(i, mn) and znAt(u, i) = znAt(v2, j)
                                                                [using specialize u-covers(znAt(v2, j)) v2-j-non-generator]
                                                              @with-match-i |
                                                                unpack i: Nat from v2-j-in-u {
                                                                  @match-facts |
                                                                    less_than(i, mn) and znAt(u, i) = znAt(v2, j)
                                                                    [by hypothesis with-match-i]
                                                                  @i-below |
                                                                    less_than(i, mn)
                                                                    [by and_elim_left match-facts]
                                                                  @u-i-is-v2-j |
                                                                    znAt(u, i) = znAt(v2, j)
                                                                    [by and_elim_right match-facts]
                                                                  @v2-j-is-u-i |
                                                                    znAt(v2, j) = znAt(u, i)
                                                                    [by symmetry u-i-is-v2-j]
                                                                  @match-witnessed |
                                                                    less_than(i, mn) and znAt(v2, j) = znAt(u, i)
                                                                    [by and_intro i-below v2-j-is-u-i]
                                                                  @conclusion-j-drawn-inner |
                                                                    exists i2: Nat; less_than(i2, mn) and znAt(v2, j) = znAt(u, i2)
                                                                    [by exists_intro(i) match-witnessed]
                                                                }
                                                              @conclusion-j-drawn |
                                                                exists i2: Nat; less_than(i2, mn) and znAt(v2, j) = znAt(u, i2)
                                                                [by exists_elim with-match-i]
                                                            }
                                                          @j-below-d-implies |
                                                            less_than(j, d) -> exists i2: Nat; less_than(i2, mn) and znAt(v2, j) = znAt(u, i2)
                                                            [by implies_intro given-j-below-d]
                                                        }
                                                      @v2-drawn-from-u |
                                                        forall j: Nat; less_than(j, d) -> exists i2: Nat; less_than(i2, mn) and znAt(v2, j) = znAt(u, i2)
                                                        [by forall_intro generalize-j-v2]
                                                      @generalize-j-u |
                                                        fix j: Nat {
                                                          @given-j-below-mn |
                                                            assume less_than(j, mn) {
                                                              @j-below-mn |
                                                                less_than(j, mn)
                                                                [by hypothesis given-j-below-mn]
                                                              @u-j-non-generator |
                                                                not generates(znAt(u, j))
                                                                [using specialize u-non-generators(j) j-below-mn]
                                                              @u-j-in-v2 |
                                                                exists i: Nat; less_than(i, d) and znAt(v2, i) = znAt(u, j)
                                                                [using specialize v2-covers(znAt(u, j)) u-j-non-generator]
                                                              @with-match-i |
                                                                unpack i: Nat from u-j-in-v2 {
                                                                  @match-facts |
                                                                    less_than(i, d) and znAt(v2, i) = znAt(u, j)
                                                                    [by hypothesis with-match-i]
                                                                  @i-below |
                                                                    less_than(i, d)
                                                                    [by and_elim_left match-facts]
                                                                  @v2-i-is-u-j |
                                                                    znAt(v2, i) = znAt(u, j)
                                                                    [by and_elim_right match-facts]
                                                                  @u-j-is-v2-i |
                                                                    znAt(u, j) = znAt(v2, i)
                                                                    [by symmetry v2-i-is-u-j]
                                                                  @match-witnessed |
                                                                    less_than(i, d) and znAt(u, j) = znAt(v2, i)
                                                                    [by and_intro i-below u-j-is-v2-i]
                                                                  @conclusion-j-drawn-inner |
                                                                    exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                    [by exists_intro(i) match-witnessed]
                                                                }
                                                              @conclusion-j-drawn |
                                                                exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                                [by exists_elim with-match-i]
                                                            }
                                                          @j-below-mn-implies |
                                                            less_than(j, mn) -> exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                            [by implies_intro given-j-below-mn]
                                                        }
                                                      @u-drawn-from-v2 |
                                                        forall j: Nat; less_than(j, mn) -> exists i2: Nat; less_than(i2, d) and znAt(u, j) = znAt(v2, i2)
                                                        [by forall_intro generalize-j-u]
                                                      @lengths-equal |
                                                        d = mn
                                                        [using specialize znListingsOfTheSameClassHaveEqualLength(d, v2, mn, u) v2-injective u-injective v2-drawn-from-u u-drawn-from-v2]
                                                      @sum-with-mn |
                                                        nadd(c, mn) = m
                                                        [by rewrite lengths-equal lengths-add]
                                                      @sum-image-raw |
                                                        toInt(nadd(c, mn)) = iadd(toInt(c), toInt(mn))
                                                        [using specialize toIntAdd(c, mn)]
                                                      @m-image-as-sum |
                                                        toInt(m) = iadd(toInt(c), toInt(mn))
                                                        [by rewrite sum-with-mn sum-image-raw]
                                                      @m-image-closed |
                                                        toInt(m) = iadd(toInt(c), pow(p, e))
                                                        [by rewrite mn-image m-image-as-sum]
                                                      @n-is-m-image |
                                                        N = toInt(m)
                                                        [by symmetry m-image]
                                                      @power-is-m-image |
                                                        pow(p, isucc(e)) = toInt(m)
                                                        [by rewrite modulus n-is-m-image]
                                                      @product-is-sum |
                                                        imul(pow(p, e), p) = iadd(toInt(c), pow(p, e))
                                                        [using chain power-unfolds-flipped power-is-m-image m-image-closed]
                                                      @power-unfolds-flipped |
                                                        imul(pow(p, e), p) = pow(p, isucc(e))
                                                        [by symmetry power-unfolds]
                                                      @sum-is-product |
                                                        iadd(toInt(c), pow(p, e)) = imul(pow(p, e), p)
                                                        [by symmetry product-is-sum]
                                                      @c-recovered |
                                                        toInt(c) = iadd(iadd(toInt(c), pow(p, e)), ineg(pow(p, e)))
                                                        [using polynomial(integer)]
                                                      @c-from-product |
                                                        toInt(c) = iadd(imul(pow(p, e), p), ineg(pow(p, e)))
                                                        [by rewrite sum-is-product c-recovered]
                                                      @closed-form |
                                                        iadd(imul(pow(p, e), p), ineg(pow(p, e))) = imul(pow(p, e), isub(p, IONE))
                                                        [using polynomial(integer)]
                                                      @count |
                                                        toInt(c) = imul(pow(p, e), isub(p, IONE))
                                                        [using chain c-from-product closed-form]
                                                      @packaged |
                                                        (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = imul(pow(p, e), isub(p, IONE))
                                                        [using tautology v-generates v-injective v-covers count]
                                                      @conclusion-with-count |
                                                        exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                                                        [by exists_intro(c) packaged]
                                                    }
                                                  @conclusion-with-u |
                                                    exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                                                    [by exists_elim with-u]
                                                }
                                              @conclusion-with-d |
                                                exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                                                [by exists_elim with-d]
                                            }
                                          @conclusion-with-v2 |
                                            exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                                            [by exists_elim with-v2]
                                        }
                                      @conclusion-with-c |
                                        exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                                        [by exists_elim with-c]
                                      @conclusion-with-v-inner |
                                        exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                                        [by exists_intro(v) conclusion-with-c]
                                    }
                                  @conclusion-with-v |
                                    exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                                    [by exists_elim with-v]
                                }
                              @conclusion-with-w |
                                exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                                [by exists_elim with-w]
                            }
                          @conclusion-with-m |
                            exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                            [by exists_elim with-m]
                        }
                      @conclusion-counted |
                        exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                        [by exists_elim with-mn]
                    }
                  @modulus-implies |
                    N = pow(p, isucc(e)) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                    [by implies_intro given-modulus]
                }
              @nonneg-implies |
                nonneg(e) -> N = pow(p, isucc(e)) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
                [by implies_intro given-nonneg]
            }
          @prime-implies |
            is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
            [by implies_intro given-prime]
        }
      @discharge-e |
        forall e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> exists v3: ZnSeq; exists c2: Nat; (forall j: Nat; less_than(j, c2) -> generates(znAt(v3, j))) and (forall i: Nat; forall j: Nat; less_than(i, c2) -> less_than(j, c2) -> znAt(v3, i) = znAt(v3, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c2) and znAt(v3, j) = g) and toInt(c2) = imul(pow(p, e), isub(p, IONE))
        [by forall_intro generalize-e]
    }
  @conclusion |
    forall p, e: Int; is_prime(p) -> nonneg(e) -> N = pow(p, isucc(e)) -> exists v: ZnSeq; exists c: Nat; (forall j: Nat; less_than(j, c) -> generates(znAt(v, j))) and (forall i: Nat; forall j: Nat; less_than(i, c) -> less_than(j, c) -> znAt(v, i) = znAt(v, j) -> i = j) and (forall g: Zn; generates(g) -> exists j: Nat; less_than(j, c) and znAt(v, j) = g) and toInt(c) = imul(pow(p, e), isub(p, IONE))
    [by forall_intro generalize-p]
qed
