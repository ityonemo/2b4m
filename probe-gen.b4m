theory peano <<< "std/peano.b4m"
theory ordering <<< "std/peano/order.b4m"
sort Nat = peano.Nat
const ZERO = peano.ZERO
const ONE = peano.ONE
oper succ = peano.succ
oper add = peano.add
pred less_than = ordering.less_than
fact strongInduction = ordering.strongInduction
fact zeroOrSucc = peano.zeroOrSucc

oper fib(n: Nat) => Nat:
  fib(ZERO) = ZERO;
  fib(succ(ZERO)) = ONE;
  fib(succ(succ(k))) = add(fib(succ(k)), fib(k)).

// ===== WHAT THE CHECKER WOULD GENERATE =====

// (1) the terminating arms' conditions, as one predicate
pred fibIsBase(n: Nat):
  fibIsBase(n) iff (n = ZERO or n = succ(ZERO)).

// (2) "n grounds": every recursive descent from n reaches a base arm.
// This is the "exists N" rolled into a predicate, so no closure operator is needed.
pred fibGrounds(n: Nat)

// (3) the arms' contributions, as axioms the checker emits
axiom fibGroundsBase: forall n: Nat; fibIsBase(n) -> fibGrounds(n)
axiom fibGroundsStep: forall k: Nat;
  fibGrounds(succ(k)) -> fibGrounds(k) -> fibGrounds(succ(succ(k)))

// ===== THE OBLIGATION the author must prove =====
intheory fibTerminates
theorem fibTerminates: forall n: Nat; fibGrounds(n)
proof
  @step | forall n: Nat;
    (forall m: Nat; less_than(m, n) -> fibGrounds(m)) -> fibGrounds(n)
    [by cite theDescent]
  @conclusion | forall n: Nat; fibGrounds(n)
    [using instantiation strongInduction((fun n: Nat => fibGrounds(n))) step]
qed

// depth-2 coverage: a LOCAL lemma, from zeroOrSucc twice (needed only because fib has
// two base arms)
hole natShapes: forall n: Nat;
  n = ZERO or n = succ(ZERO) or (exists k: Nat; n = succ(succ(k)))
// and that a two-plus number's predecessors are below it
hole predsBelow: forall k: Nat;
  less_than(succ(k), succ(succ(k))) and less_than(k, succ(succ(k)))

intheory theDescent
theorem theDescent: forall n: Nat;
  (forall m: Nat; less_than(m, n) -> fibGrounds(m)) -> fibGrounds(n)
proof
  @generalize-n |
    fix n: Nat {
      @given |
        assume (forall m: Nat; less_than(m, n) -> fibGrounds(m)) {
          @below | forall m: Nat; less_than(m, n) -> fibGrounds(m)
            [by hypothesis given]
          @shapes | n = ZERO or n = succ(ZERO) or (exists k: Nat; n = succ(succ(k)))
            [using specialize natShapes(n)]
          @baseDef | forall m: Nat; fibIsBase(m) iff (m = ZERO or m = succ(ZERO))
            [by definition(0) fibIsBase]
          @baseGrounds | forall m: Nat; fibIsBase(m) -> fibGrounds(m)
            [by cite fibGroundsBase]
          @stepGrounds | forall k: Nat;
            fibGrounds(succ(k)) -> fibGrounds(k) -> fibGrounds(succ(succ(k)))
            [by cite fibGroundsStep]
          @pb | forall k: Nat;
            less_than(succ(k), succ(succ(k))) and less_than(k, succ(succ(k)))
            [by cite predsBelow]
          @conclusion-cases |
            fibGrounds(n)
            case shapes {
              @is-base |
                assume (n = ZERO or n = succ(ZERO)) {
                  @e | n = ZERO or n = succ(ZERO) [by hypothesis is-base]
                  @bd | fibIsBase(n) iff (n = ZERO or n = succ(ZERO))
                    [by apply_at(n) baseDef]
                  @isb | fibIsBase(n) [using tautology bd e]
                  @out | fibGrounds(n) [using specialize baseGrounds(n) isb]
                }
              @is-rec |
                assume (exists k: Nat; n = succ(succ(k))) {
                  @d | exists k: Nat; n = succ(succ(k)) [by hypothesis is-rec]
                  @out | fibGrounds(n) [using specialize theRest(n) d below]
                }
            }
        }
      @disc | (forall m: Nat; less_than(m, n) -> fibGrounds(m)) -> fibGrounds(n)
        [by discharge given]
    }
  @conclusion | forall n: Nat;
    (forall m: Nat; less_than(m, n) -> fibGrounds(m)) -> fibGrounds(n)
    [by generalize generalize-n]
qed

// the remaining split: n = succ(ZERO) (second base arm) or n = succ(succ(k)) (the
// recursive arm, where the strong hypothesis supplies both predecessors)
intheory theRest
// THE RECURSIVE CASE: unpack k, get both predecessors from the strong hypothesis, and
// apply the arm's own axiom.
theorem theRest: forall m: Nat;
  (exists k: Nat; m = succ(succ(k))) ->
  (forall j: Nat; less_than(j, m) -> fibGrounds(j)) ->
  fibGrounds(m)
proof
  @generalize-m |
    fix m: Nat {
      @gex | assume (exists k: Nat; m = succ(succ(k))) {
      @gbe | assume (forall j: Nat; less_than(j, m) -> fibGrounds(j)) {
        @ex | exists k: Nat; m = succ(succ(k)) [by hypothesis gex]
        @be | forall j: Nat; less_than(j, m) -> fibGrounds(j) [by hypothesis gbe]
        @sg | forall k: Nat;
          fibGrounds(succ(k)) -> fibGrounds(k) -> fibGrounds(succ(succ(k)))
          [by cite fibGroundsStep]
        @pb2 | forall k: Nat;
          less_than(succ(k), succ(succ(k))) and less_than(k, succ(succ(k)))
          [by cite predsBelow]
        @res |
          unpack k: Nat from ex {
            @mk | m = succ(succ(k)) [by hypothesis res]
            @bo | less_than(succ(k), succ(succ(k))) and less_than(k, succ(succ(k)))
              [by apply_at(k) pb2]
            @b1 | less_than(succ(k), succ(succ(k))) [by and_lhs bo]
            @b2 | less_than(k, succ(succ(k))) [by and_rhs bo]
            @m1 | less_than(succ(k), m) [by rewrite mk b1]
            @m2 | less_than(k, m) [by rewrite mk b2]
            @g1 | fibGrounds(succ(k)) [using specialize be(succ(k)) m1]
            @g2 | fibGrounds(k) [using specialize be(k) m2]
            @gss | fibGrounds(succ(succ(k))) [using specialize sg(k) g1 g2]
            @out | fibGrounds(m) [by rewrite mk gss]
          }
        @got | fibGrounds(m) [by unpacked res]
      }
      @d2 | (forall j: Nat; less_than(j, m) -> fibGrounds(j)) -> fibGrounds(m)
        [by discharge gbe]
      }
      @d1 | (exists k: Nat; m = succ(succ(k))) ->
        ((forall j: Nat; less_than(j, m) -> fibGrounds(j)) -> fibGrounds(m))
        [by discharge gex]
    }
  @conclusion | forall m: Nat;
    (exists k: Nat; m = succ(succ(k))) ->
    (forall j: Nat; less_than(j, m) -> fibGrounds(j)) ->
    fibGrounds(m)
    [by generalize generalize-m]
qed
