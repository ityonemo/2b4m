theory peano <<< "std/peano.b4m"
theory ordering <<< "std/peano/order.b4m"
sort Nat = peano.Nat
const ZERO = peano.ZERO
const ONE = peano.ONE
oper succ = peano.succ
oper add = peano.add
pred less_than = ordering.less_than
fact strongInduction = ordering.strongInduction

oper fib(n: Nat) => Nat:
  fib(ZERO) = ZERO;
  fib(succ(ZERO)) = ONE;
  fib(succ(succ(k))) = add(fib(succ(k)), fib(k)).

// ===== GENERATED =====
// `fibCovered(n)` — the DISJUNCTION of the arms' patterns. A real definition block:
// exhaustive, non-recursive, and it traps zero/one explicitly.
pred fibCovered(n: Nat):
  fibCovered(n) iff (n = ZERO or n = succ(ZERO) or (exists k: Nat; n = succ(succ(k)))).

// `fibCallsBelow(n)` — every recursive call from n goes to a SMALLER argument, in the
// well-order the theory selector supplies. Also a real definition block.
pred fibCallsBelow(n: Nat):
  fibCallsBelow(n) iff
    (forall k: Nat; n = succ(succ(k)) ->
      (less_than(succ(k), n) and less_than(k, n))).

// ===== THE OBLIGATION =====
intheory fibTerminates
theorem fibTerminates: forall n: Nat; fibCovered(n) and fibCallsBelow(n)
proof
  @conclusion | forall n: Nat; fibCovered(n) and fibCallsBelow(n) [by cite stub]
qed
