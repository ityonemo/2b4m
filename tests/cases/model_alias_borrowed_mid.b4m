// The MIDDLE theory: borrows the base's symbols, axiom AND theorem by alias, and proves
// something citing the borrowed THEOREM. A model of this theory must remap that citation
// too — the theorem lives in another file, but its symbols are under the mapping.
import base <<< "model_alias_borrowed_base.b4m"

sort S = base.S
const U = base.U
func op = base.op
axiom opUnitLeft = base.opUnitLeft
theorem unitTwice = base.unitTwice

theorem unitThrice: op(U, op(U, U)) = U
proof
  @law |
    forall a: S; op(U, a) = a
    [by cite opUnitLeft]
  @unit-absorbs-the-square |
    op(U, op(U, U)) = op(U, U)
    [by forall_elim(op(U, U)) law]
  @square-is-unit |
    op(U, U) = U
    [by cite unitTwice]
  @conclusion |
    op(U, op(U, U)) = U
    [using chain unit-absorbs-the-square square-is-unit]
qed
