// NEGATIVE: knowledge is BLOCK-SCOPED. `inH(UNIT)` is known inside the `assume` block (the
// inner step is fine) and in the exported implication's consequent (its antecedent teaches
// it) — but not after the block closes, so the final step's use is rejected.
sort G
const UNIT: G
pred inH(g: G)
sort H = G where inH
func shift(h: H): G

theorem scopeEnds: shift(UNIT) = shift(UNIT)
proof
  @given |
    assume inH(UNIT) {
      @inner |
        shift(UNIT) = shift(UNIT)
        [by reflexivity]
    }
  @exported |
    inH(UNIT) -> shift(UNIT) = shift(UNIT)
    [by implies_intro given]
  @conclusion |
    shift(UNIT) = shift(UNIT)
    [by reflexivity]
qed
