// A tiny abstract theory to exercise `model` transfer: a sort with a binary
// `op`, a left-identity `UNIT`, and one PROVEN theorem over it. The theorem is
// what a `model` of this theory transfers to a concrete sort.
sort Sort
const UNIT: Sort
func op(a: Sort, b: Sort): Sort
// a transparent abbreviation — NOT a symbol a model may map (see model_define_source_bad).
define TWICE = op(UNIT, UNIT)

// left-identity axiom: op(UNIT, a) = a
axiom opUnitLeft: forall a: Sort; op(UNIT, a) = a

// a derived theorem over the abstract sort — transferable by `model`.
// (from the axiom at `op(UNIT, a)`: op(UNIT, op(UNIT, a)) = op(UNIT, a).)
theorem opUnitLeftTwice: forall a: Sort; op(UNIT, op(UNIT, a)) = op(UNIT, a)
proof
  @generalize-a |
    fix a: Sort {
      @unit-left |
        forall b: Sort; op(UNIT, b) = b
        [by cite opUnitLeft]
      @conclusion-twice |
        op(UNIT, op(UNIT, a)) = op(UNIT, a)
        [by forall_elim(op(UNIT, a)) unit-left]
    }
  @conclusion |
    forall a: Sort; op(UNIT, op(UNIT, a)) = op(UNIT, a)
    [by forall_intro generalize-a]
qed

// a theorem whose proof CITES another theorem (opUnitLeftTwice) — transferring
// it forces `model` materialization to recurse into that dependency (memoized).
// op(UNIT, op(UNIT, op(UNIT, a))) = op(UNIT, a): rewrite the inner double-UNIT
// via opUnitLeftTwice, leaving op(UNIT, op(UNIT, a)), then again.
theorem opUnitLeftThrice: forall a: Sort; op(UNIT, op(UNIT, op(UNIT, a))) = op(UNIT, a)
proof
  @generalize-a |
    fix a: Sort {
      @twice |
        forall b: Sort; op(UNIT, op(UNIT, b)) = op(UNIT, b)
        [by cite opUnitLeftTwice]
      @inner-collapses |
        op(UNIT, op(UNIT, op(UNIT, a))) = op(UNIT, op(UNIT, a))
        [by forall_elim(op(UNIT, a)) twice]
      @outer-collapses |
        op(UNIT, op(UNIT, a)) = op(UNIT, a)
        [by forall_elim(a) twice]
      @conclusion-thrice |
        op(UNIT, op(UNIT, op(UNIT, a))) = op(UNIT, a)
        [by rewrite outer-collapses inner-collapses]
    }
  @conclusion |
    forall a: Sort; op(UNIT, op(UNIT, op(UNIT, a))) = op(UNIT, a)
    [by forall_intro generalize-a]
qed
