// `define` names a term; every use expands transparently at elaboration —
// the kernel only ever sees the underlying term, so certificates (and
// therefore --pure) are unaffected
sort Nat
const ZERO: Nat
oper succ(n: Nat) => Nat
oper add(a: Nat, b: Nat) => Nat
axiom addZeroLeft: forall b: Nat; add(ZERO, b) = b
axiom addSuccLeft: forall a, b: Nat; add(succ(a), b) = succ(add(a, b))
define TWO = succ(succ(ZERO))
define FOUR = succ(succ(TWO))

// What this file proves (verified manifest):
intheory twoAndTwo

theorem twoAndTwo: add(TWO, TWO) = FOUR
proof
  @conclusion |
    add(TWO, TWO) = FOUR
    [using arithmetic]
qed
