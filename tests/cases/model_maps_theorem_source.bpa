// Source theory for model_maps_theorem_bad.bpa: a sort with a left-unit AXIOM
// and a left-unit THEOREM (trivially derived from the axiom). A model may map the
// axiom but not the theorem.
sort Sort
const UNIT: Sort
func op(a: Sort, b: Sort): Sort

axiom leftUnitAxiom: forall a: Sort; op(UNIT, a) = a

theorem leftUnit: forall a: Sort; op(UNIT, a) = a
proof
  @conclusion |
    forall a: Sort; op(UNIT, a) = a
    [by cite leftUnitAxiom]
qed
