import peano <<< "std/peano.bpa"
sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
func mul = peano.mul

// `arithmetic` cited with a local premise the CERTIFIER never needs. Both `a = b`
// and `c = ZERO` are cited; the equation certifier joins the sides rewriting with
// `a = b` alone (`c` does not occur in the goal), so `c = ZERO`'s rewrite never
// fires. The generated schema must not then carry an antecedent whose restated
// hypothesis nothing cites — that trips its own use-all-facts pass ("unused fact:
// step 'prem-N'"). A premise the cert does not use is simply not an antecedent.
theorem unusedPremise: forall a, b, c: Nat; a = b -> c = ZERO -> add(a, ZERO) = b
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-c |
            fix c: Nat {
              @given-ab |
                assume a = b {
                  @given-c |
                    assume c = ZERO {
                      @a-is-b |
                        a = b
                        [by hypothesis given-ab]
                      @c-is-zero |
                        c = ZERO
                        [by hypothesis given-c]
                      @sum-before |
                        add(a, ZERO) = b
                        [using arithmetic(peano) a-is-b c-is-zero]
                      @conclusion-sum |
                        add(a, ZERO) = b
                        [using tautology sum-before c-is-zero]
                    }
                  @discharge-c |
                    c = ZERO -> add(a, ZERO) = b
                    [by implies_intro given-c]
                }
              @discharge-ab |
                a = b -> c = ZERO -> add(a, ZERO) = b
                [by implies_intro given-ab]
            }
          @all-c |
            forall c: Nat; a = b -> c = ZERO -> add(a, ZERO) = b
            [by forall_intro generalize-c]
        }
      @all-b |
        forall b, c: Nat; a = b -> c = ZERO -> add(a, ZERO) = b
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Nat; a = b -> c = ZERO -> add(a, ZERO) = b
    [by forall_intro generalize-a]
qed
