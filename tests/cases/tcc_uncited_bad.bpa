// NEGATIVE: an obligation is never discharged by an UNCITED fact. `unitInH` states exactly
// `inH(UNIT)`, but nothing in the proof brings it in — the use is rejected. The author must
// state it as a step first (`@u | inH(UNIT) [by cite unitInH]`), see tcc_teach.bpa (2).
sort G
const UNIT: G
pred inH(g: G)
sort H = G where inH
func shift(h: H): G

axiom unitInH: inH(UNIT)

theorem viaUncitedAxiom: shift(UNIT) = shift(UNIT)
proof
  @conclusion |
    shift(UNIT) = shift(UNIT)
    [by reflexivity]
qed
