// Farkas: QF-linear INFEASIBILITY certifies purely under the default. These
// goals combine several hypothesis inequalities into a contradiction — the
// shape the equation/order certifiers cannot do (they normalize ONE
// (in)equality; Farkas combines several). Today they fall to the accelerated path.
//
// The vocabulary + lemmas are NOT aliased into local scope: the theory is
// named explicitly via `by arithmetic(ordering)`, and the certifier resolves
// its roles (lessThanTransitive, lessThanIrreflexive, additionPreservesOrder,
// ...) against the `ordering` module — so purity does not depend on this file
// re-exposing the arithmetic vocabulary locally.
import ordering <<< "std/peano/order.b4m"

sort Nat = ordering.Nat
pred less_than = ordering.less_than

// the degenerate Farkas case (all multipliers 1): a<b ∧ b<a is infeasible.
// Refutation: transitivity collapses the two bounds to less_than(a, a),
// which lessThanIrreflexive forbids — absurd.
theorem belowBothWaysIsAbsurd: forall a, b: Nat; less_than(a, b) -> less_than(b, a) -> less_than(a, a)
proof
  @conclusion |
    forall a, b: Nat; less_than(a, b) -> less_than(b, a) -> less_than(a, a)
    [using arithmetic(ordering)]
qed

// a difference-logic chain: a<b, b<c, c<a is infeasible (a<a after the chain).
theorem cyclicChainIsAbsurd: forall a, b, c: Nat; less_than(a, b) -> less_than(b, c) -> less_than(c, a) -> less_than(a, a)
proof
  @conclusion |
    forall a, b, c: Nat; less_than(a, b) -> less_than(b, c) -> less_than(c, a) -> less_than(a, a)
    [using arithmetic(ordering)]
qed
