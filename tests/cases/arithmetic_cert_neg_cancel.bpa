// The arithmetic equation certifier must cancel an additive-inverse pair
// x + (-x) even when the two are NOT syntactically adjacent in the normalized
// sum. `add(a, sub(b, a)) = b` unfolds (definitionOfSubtraction) to
// `add(a, add(b, neg(a))) = b`: the normal-form summand multiset is
// {a, b, neg(a)}, which must reduce to {b} by cancelling a with neg(a) across
// the intervening b. A pure linear ℤ identity — [using arithmetic] should certify
// it strict (not just decide it under --fast).
import integer <<< "std/integer.bpa"
import order <<< "std/integer-order.bpa"
sort Int = integer.Int
const ZERO = integer.ZERO
func add = integer.add
func neg = integer.neg
func sub = order.sub
axiom definitionOfSubtraction = integer.definitionOfSubtraction
theorem addNegRight = integer.addNegRight
theorem addNegLeft = integer.addNegLeft
theorem negNeg = integer.negNeg
axiom addZeroLeft = integer.addZeroLeft
theorem addZeroRight = integer.addZeroRight
theorem addIsAssociative = integer.addIsAssociative
theorem addIsCommutative = integer.addIsCommutative
theorem addLeftSwap = integer.addLeftSwap

theorem diffReaches: forall a, b: Int; add(a, sub(b, a)) = b
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @conclusion-diff-reaches |
            add(a, sub(b, a)) = b
            [using arithmetic]
        }
      @discharge-b |
        forall b: Int; add(a, sub(b, a)) = b
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; add(a, sub(b, a)) = b
    [by forall_intro generalize-a]
qed
