// citing a hole-tainted theorem inherits the hole: this file has no `hole` of
// its own, but rests on hole.bpa's zeroIsEven through restsOnHole.
import h <<< "hole.bpa"
sort Nat = h.Nat
const ZERO = h.ZERO
pred even = h.even
theorem restsOnHole = h.restsOnHole
theorem transitiveHole: even(ZERO)
proof
  @c |
    even(ZERO)
    [by cite restsOnHole]
qed
