// The `iff` surface sugar and its interaction with `tautology`.
//
// `P iff Q` is SURFACE-ONLY: it desugars at elaborate time to
// `(P -> Q) and (Q -> P)` and never reaches the kernel. So a biconditional is
// proved with iff_intro (the two directions) and eliminated with
// iff_elim_forward / iff_elim_backward — thin renames of the `and` rules that
// read as what they mean. Critically, `tautology` sees the desugared
// conjunction, so it decides iff goals AND consumes iff hypotheses for free —
// the property the set/collection membership-axiom sweep relies on.

pred A
pred B
pred C

// -- intro / elim -----------------------------------------------------------

// iff_intro from the two directions.
theorem introFromDirections: (A -> B) -> (B -> A) -> (A iff B)
proof
  @given-forward |
    assume A -> B {
      @given-backward |
        assume B -> A {
          @forward-direction | A -> B [by hypothesis given-forward]
          @backward-direction | B -> A [by hypothesis given-backward]
          @the-iff | A iff B [by iff_intro forward-direction backward-direction]
        }
      @backward-gives-iff | (B -> A) -> (A iff B) [by implies_intro given-backward]
    }
  @conclusion | (A -> B) -> (B -> A) -> (A iff B) [by implies_intro given-forward]
qed

// iff_elim_forward / iff_elim_backward recover each direction; iff_intro puts
// them back — a round-trip through the sugar.
theorem elimThenIntroRoundTrips: (A iff B) -> (A iff B)
proof
  @given-iff |
    assume A iff B {
      @the-iff | A iff B [by hypothesis given-iff]
      @forward-direction | A -> B [by iff_elim_forward the-iff]
      @backward-direction | B -> A [by iff_elim_backward the-iff]
      @rebuilt | A iff B [by iff_intro forward-direction backward-direction]
    }
  @conclusion | (A iff B) -> (A iff B) [by implies_intro given-iff]
qed

// -- tautology closes iff goals ---------------------------------------------

// A propositional biconditional is decided by tautology directly.
theorem tautologyProvesIff: (A and B) iff (B and A)
proof
  @conclusion | (A and B) iff (B and A) [using tautology]
qed

// -- tautology CONSUMES iff hypotheses (the membership-axiom pattern) --------

// given `A iff B` and `A`, conclude `B` — tautology reads the desugared iff.
theorem tautologyConsumesForward: (A iff B) -> A -> B
proof
  @given-iff |
    assume A iff B {
      @the-iff | A iff B [by hypothesis given-iff]
      @given-a |
        assume A {
          @the-a | A [by hypothesis given-a]
          @b | B [using tautology the-iff the-a]
        }
      @a-implies-b | A -> B [by implies_intro given-a]
    }
  @conclusion | (A iff B) -> A -> B [by implies_intro given-iff]
qed

// backward direction too.
theorem tautologyConsumesBackward: (A iff B) -> B -> A
proof
  @given-iff |
    assume A iff B {
      @the-iff | A iff B [by hypothesis given-iff]
      @given-b |
        assume B {
          @the-b | B [by hypothesis given-b]
          @a | A [using tautology the-iff the-b]
        }
      @b-implies-a | B -> A [by implies_intro given-b]
    }
  @conclusion | (A iff B) -> B -> A [by implies_intro given-iff]
qed

// iff transitivity — iff mixed with the connective machinery, via tautology.
theorem tautologyIffChain: (A iff B) -> (B iff C) -> (A iff C)
proof
  @given-a-iff-b |
    assume A iff B {
      @given-b-iff-c |
        assume B iff C {
          @a-iff-b | A iff B [by hypothesis given-a-iff-b]
          @b-iff-c | B iff C [by hypothesis given-b-iff-c]
          @a-iff-c | A iff C [using tautology a-iff-b b-iff-c]
        }
      @b-iff-c-gives-a-iff-c | (B iff C) -> (A iff C) [by implies_intro given-b-iff-c]
    }
  @conclusion | (A iff B) -> (B iff C) -> (A iff C) [by implies_intro given-a-iff-b]
qed
