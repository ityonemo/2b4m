// quantifier manipulation: apply_at instantiates, fix + generalize rebuild
sort Nat
pred r(a: Nat, b: Nat)
axiom rAll: forall x, y: Nat; r(x, y)
theorem swap: forall y, x: Nat; r(x, y)
proof
  @fy |
    fix b: Nat {
      @fx |
        fix a: Nat {
          @all |
            forall x, y: Nat; r(x, y)
            [by cite rAll]
          @one |
            forall y: Nat; r(a, y)
            [by apply_at(a) all]
          @two |
            r(a, b)
            [by apply_at(b) one]
        }
      @inner |
        forall x: Nat; r(x, b)
        [by generalize fx]
    }
  @conc |
    forall y, x: Nat; r(x, y)
    [by generalize fy]
qed
