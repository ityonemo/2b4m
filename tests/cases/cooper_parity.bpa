// Cooper-replay layer 3 (periodicity direction, ⟹): a `forall x; exists y; …`
// goal whose Cooper elimination has period 2 — the residue classes are the
// even/odd parity split. Certifying it needs an INDUCTION on x (the −∞
// residue's soundness over Nat is exactly the periodicity, provable only
// inductively). The cooper link SYNTHESIZES that induction: predicate
// P(k) = exists y; k = 2y or k = 2y+1, base P(ZERO), step P(k) -> P(succ(k))
// by the parity shift, then `instantiate induction`.
//
//   forall x; exists y; x = add(y, y) or x = succ(add(y, y))
//
// This is `evenOrOdd` in add-form (the same theorem examples/peano.bpa proves,
// there via the accelerated tactic). Checks ELABORATED in default mode once layer 3 lands.
sort Nat
const ZERO: Nat
const ONE: Nat
func succ(n: Nat) => Nat
func add(a: Nat, b: Nat) => Nat
func mul(a: Nat, b: Nat) => Nat
axiom addZeroLeft: forall b: Nat; add(ZERO, b) = b
axiom addSuccLeft: forall a, b: Nat; add(succ(a), b) = succ(add(a, b))
axiom addZeroRight: forall a: Nat; add(a, ZERO) = a
axiom addSuccRight: forall a, b: Nat; add(a, succ(b)) = succ(add(a, b))
axiom mulZeroLeft: forall b: Nat; mul(ZERO, b) = ZERO
axiom mulSuccLeft: forall a, b: Nat; mul(succ(a), b) = add(mul(a, b), b)
axiom oneIsSuccZero: ONE = succ(ZERO)
axiom induction(prop: Nat -> Prop):
  prop(ZERO) -> (forall k: Nat; prop(k) -> prop(succ(k))) -> forall n: Nat; prop(n)

theorem evenOrOddArith: forall x: Nat; exists y: Nat; x = add(y, y) or x = succ(add(y, y))
proof
  @conclusion |
    forall x: Nat; exists y: Nat; x = add(y, y) or x = succ(add(y, y))
    [using arithmetic]
qed
