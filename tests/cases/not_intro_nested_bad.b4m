// deliberately broken: the contradiction lives under a NESTED assumption, so
// it depends on q and not q as well as p — it may not justify not p
pred p
pred q
theorem falsum: not p
proof
  @b |
    assume p {
      @b2 |
        assume q and (not q) {
          @h |
            q and (not q)
            [by hypothesis b2]
          @s1 |
            q
            [by and_elim_left h]
          @s2 |
            not q
            [by and_elim_right h]
        }
    }
  @conc |
    not p
    [by not_intro b s1 s2]
qed
