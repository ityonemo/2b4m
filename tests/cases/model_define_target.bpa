// A `define`d symbol as a model mapping TARGET is LEGITIMATE — mapping a source
// symbol onto a defined target EXPRESSION is fine; the target expands to its body.
// This exercises it end to end: the source theorem transfers, with the target
// `define` DOUBLED expanding to combine(ZED, ZED) in the materialized result.

import source <<< "model_source.bpa"

sort Thing
const ZED: Thing
func combine(a: Thing, b: Thing): Thing
// the target's UNIT-analogue is a DEFINED expression, not an opaque const.
define DOUBLED = combine(ZED, ZED)

// discharge the source's opUnitLeft at DOUBLED (= combine(ZED, ZED)).
axiom combineDoubledLeft: forall a: Thing; combine(DOUBLED, a) = a

model ThingModel {
  source.Sort: Thing
  source.UNIT: DOUBLED
  source.op: combine
  source.opUnitLeft <- combineDoubledLeft
}

// transfer opUnitLeftTwice: the source `UNIT` becomes DOUBLED (expanded to
// combine(ZED, ZED)) in the goal.
theorem combineDoubledLeftTwice: forall a: Thing; combine(combine(ZED, ZED), combine(combine(ZED, ZED), a)) = combine(combine(ZED, ZED), a)
proof
  @conclusion |
    forall a: Thing; combine(combine(ZED, ZED), combine(combine(ZED, ZED), a)) = combine(combine(ZED, ZED), a)
    [using model(ThingModel) source.opUnitLeftTwice]
qed
