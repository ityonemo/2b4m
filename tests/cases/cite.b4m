// `by cite` — the KIND-AGNOSTIC fact citation. Cites an axiom OR a theorem without naming
// which; the kernel picks its arm by the RESOLVED fact's kind (the word was never trusted).
// This is the word generated accelerant certs emit (they can't know a lemma's kind), and a
// convenience for authors. (`by axiom`/`by theorem` are being deprecated in its favor.)
sort Nat
const ZERO: Nat
func succ(n: Nat) => Nat

axiom succCong: forall n: Nat; succ(n) = succ(n)

// cite an AXIOM with `cite`.
theorem viaCiteAxiom: forall n: Nat; succ(n) = succ(n)
proof
  @conclusion |
    forall n: Nat; succ(n) = succ(n)
    [by cite succCong]
qed

// cite a THEOREM with the SAME word, then specialize it.
theorem viaCiteTheorem: succ(ZERO) = succ(ZERO)
proof
  @cong |
    forall n: Nat; succ(n) = succ(n)
    [by cite viaCiteAxiom]
  @conclusion |
    succ(ZERO) = succ(ZERO)
    [by forall_elim(ZERO) cong]
qed
