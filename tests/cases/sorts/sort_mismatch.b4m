// deliberately broken: succ expects a Nat, p is a proposition. The demand
// engine only elaborates a declaration when something USES it, so a theorem
// cites the ill-typed axiom to force the sort error to surface.
sort Nat
oper succ(n: Nat) => Nat
pred p()
axiom bad: succ(p()) = succ(p())

// What this file proves (verified manifest):
intheory forceBadElaboration

theorem forceBadElaboration: succ(p()) = succ(p())
proof
  @conclusion |
    succ(p()) = succ(p())
    [by cite bad]
qed
