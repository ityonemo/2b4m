// deliberately broken: nested guarded applications — BOTH obligations are
// reported at the step that uses the term, the inner one and the outer one.
// (The axiom's STATEMENT is a claim and owes nothing; the step does.)
sort Nat
const ZERO: Nat
oper div(a: Nat, b: Nat) => Nat requires b != ZERO
axiom outerOk: div(ZERO, div(ZERO, ZERO)) = ZERO

// What this file proves (verified manifest):
intheory usesIt

theorem usesIt: div(ZERO, div(ZERO, ZERO)) = ZERO
proof
  @conclusion |
    div(ZERO, div(ZERO, ZERO)) = ZERO
    [by cite outerOk]
qed
