// FACT ALIAS (Foundation C): `axiom/theorem LOCAL = TARGET` binds LOCAL to the origin
// fact's Index — a citation of LOCAL resolves to the same proven fact (identity by origin;
// the origin was kernel-checked by its own ProveTask). Here `leftId` re-exports the source
// axiom; a local proof cites the LOCAL name and the kernel matches the origin's formula.
import src <<< "alias_ident_source.b4m"

sort G = src.G
const E = src.E
func op = src.op

axiom leftId = src.opIdentityLeft

theorem useAlias: op(E, E) = E
proof
  @elim | forall a: G; op(E, a) = a [by cite leftId]
  @goal | op(E, E) = E [by forall_elim(E) elim]
qed
