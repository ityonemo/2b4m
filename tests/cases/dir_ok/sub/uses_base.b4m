// nested one level down; cites the sibling above, so `base.b4m` is both a root and an
// import of the same pass — proved once.
import base <<< "../base.b4m"
sort Nat = base.Nat
const ZERO = base.ZERO
pred even = base.even

theorem stillEven: even(ZERO)
proof
  @conclusion |
    even(ZERO)
    [using import(base) zeroIsEven]
qed
