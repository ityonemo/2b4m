// FIXTURE for `2b4m query instance`: ONE schema instantiated at TWO different arguments.
//
// A schema instance is NAMED by hashing its arguments, so these two instantiations get two
// distinct `atBoth{<hash>}` names. The test decodes each hash and asserts the recovered
// argument is the one actually written — which is the whole claim the subcommand makes.
//
// Deliberately minimal: a declared schema (whose hash is stable across runs, unlike an
// accelerant-minted one) over a VALUE parameter, so the decoded line is a plain term rather
// than a lambda.
sort N
const A: N
const B: N
pred p(x: N)

axiom everythingHoldsP: forall x: N; p(x)

// The schema: a parameter `t` instantiated at a concrete constant.
axiom atBoth(t: N):
  p(t)

intheory holdsAtA
intheory holdsAtB

// instantiation 1: t := A
theorem holdsAtA: p(A)
proof
  @conclusion |
    p(A)
    [using instantiation atBoth(A)]
qed

// instantiation 2: t := B — same schema, different argument, so a DIFFERENT hash.
theorem holdsAtB: p(B)
proof
  @conclusion |
    p(B)
    [using instantiation atBoth(B)]
qed
