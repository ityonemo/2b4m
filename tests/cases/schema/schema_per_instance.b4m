// comptime semantics demo: a proof-carrying schema whose proof only works for
// SOME instantiations — exactly like a Zig generic that fails for some T.
sort Nat
const ZERO: Nat
func succ(n: Nat) => Nat

// claims t = ZERO for any t; the proof only survives t := ZERO
theorem zeroLike(t: Nat): t = ZERO
proof
  @c |
    t = ZERO
    [by reflexivity]
qed

// t := ZERO — monomorphizes to ZERO = ZERO; reflexivity holds; checks
theorem ok: ZERO = ZERO
proof
  @c |
    ZERO = ZERO
    [using instantiation zeroLike(ZERO)]
qed

// t := succ(ZERO) — monomorphizes to succ(ZERO) = ZERO; the schema proof FAILS at
// this instantiation
theorem no: succ(ZERO) = ZERO
proof
  @c |
    succ(ZERO) = ZERO
    [using instantiation zeroLike(succ(ZERO))]
qed
