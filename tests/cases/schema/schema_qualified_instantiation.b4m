// Instantiating a schema by QUALIFIED name from another file: its parameter sorts resolve in
// the SCHEMA's namespace, which the instantiation must demand first (a schema is checked only
// at an instantiation, so nothing has fetched them). Regression: "unknown sort 'Fn'" AT THE
// SCHEMA'S DECLARATION; aliasing first (`theorem tauto = base.tauto`) only worked when the
// citing file happened to declare the same sort name. This file declares NO `Fn` of its own.
import base <<< "schema_qualified_instantiation_base.b4m"

theorem identityIsItself: forall g: base.Fn; g = base.identityFn -> g = base.identityFn
proof
  @conclusion |
    forall g: base.Fn; g = base.identityFn -> g = base.identityFn
    [using instantiation base.tauto((fun h: base.Fn => h = base.identityFn))]
qed
