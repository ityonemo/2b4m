// Distributivity normalization: `ac`/`ac_quantified` accept cited rewrite
// lemmas (here mulAddDistribRight) as PRE-NORMALIZATION applied L→R to each
// side before the AC bubble-sort. So a goal that distributes to a sum of
// products AND reorders them certifies in one step: distribute, then sort.
import peano <<< "std/peano.b4m"

sort Nat = peano.Nat
func mul = peano.mul
func add = peano.add
theorem mulAddDistribRight = peano.mulAddDistribRight
theorem addIsAssociative = peano.addIsAssociative
theorem addIsCommutative = peano.addIsCommutative
theorem addLeftSwap = peano.addLeftSwap

// LHS distributes to add(mul(a,c), mul(b,c)); RHS is the reordered sum.
theorem distributeAndReorder: forall a, b, c: Nat; mul(add(a, b), c) = add(mul(b, c), mul(a, c))
proof
  @conclusion |
    forall a, b, c: Nat; mul(add(a, b), c) = add(mul(b, c), mul(a, c))
    [using assoc_commut_quantified mulAddDistribRight]
qed
