// The schema's parameter sort `Fn` lives HERE; a citer in another file never names it.
sort Fn
const identityFn: Fn

theorem tauto(prop(Fn)): forall g: Fn; prop(g) -> prop(g)
proof
  @generalize-g |
    fix g: Fn {
      @given-prop |
        assume prop(g) {
          @conclusion-prop |
            prop(g)
            [by hypothesis given-prop]
        }
      @conclusion-implies |
        prop(g) -> prop(g)
        [by discharge given-prop]
    }
  @conclusion |
    forall g: Fn; prop(g) -> prop(g)
    [by generalize generalize-g]
qed
