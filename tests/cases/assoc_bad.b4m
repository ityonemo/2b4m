// sides differ by MORE than associativity (the operands are permuted, not just
// re-nested) — assoc must reject with a located error, never accelerated.
sort T
func op(a: T, b: T) => T
axiom opAssoc: forall c, b, a: T; op(op(a, b), c) = op(a, op(b, c))

theorem notAssoc: forall a, b: T; op(a, b) = op(b, a)
proof
  @conclusion |
    forall a, b: T; op(a, b) = op(b, a)
    [using assoc_quantified(opAssoc)]
qed
