// `assoc_commut` takes EITHER no args (well-known add/mul) OR exactly three
// (assoc, comm, swap). No partials — two args is a located error.
sort T
func join(a: T, b: T): T
axiom joinComm: forall b, a: T; join(a, b) = join(b, a)
axiom joinSwap: forall r, y, x: T; join(x, join(y, r)) = join(y, join(x, r))

theorem partial: forall a, b: T; join(a, b) = join(b, a)
proof
  @conclusion |
    forall a, b: T; join(a, b) = join(b, a)
    [using assoc_commut_quantified(joinComm, joinSwap)]
qed
