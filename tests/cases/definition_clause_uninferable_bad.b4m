// A clause variable that fills no argument of a declared symbol (and is equated with no
// declared call) has no sort to infer from — diagnosed at the variable, not silently sorted by
// the first param. `y` only ever meets itself.
sort T
func pick(a: T) => T:
  pick(a) = a when y = y

// citing the clause demands the axiom, which is where the variable is diagnosed.
theorem pickIsIdentity: forall a: T; forall y: T; y = y -> pick(a) = a
proof
  @conclusion |
    forall a: T; forall y: T; y = y -> pick(a) = a
    [by definition(0) pick]
qed
