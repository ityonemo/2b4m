// SCHEMA WELL-FORMEDNESS — the strict-mode declaration check.
//
// A schema theorem (a `prop` parameter) whose PROOF BODY has a malformed step: a
// 4-reference `or_elim` (the kernel's or_elim is binary — 3 refs). The schema is
// NEVER instantiated in this file. Historically the body was checked only at
// instantiation, so this error lay dormant and `2b4m check` reported success.
//
// In STRICT mode (default) the body is now verified at declaration by
// instantiating at opaque parameters, so this is REJECTED. In `--fast` the body
// stays lazy and the file is accepted (see schema_wellformed_fast in the gates).
// The correct way to split a 3-way disjunction is `case` (which fans out to
// nested binary or_elims) — see tests/cases/case_split.b4m.

sort T
pred a_holds(x: T)
pred b_holds(x: T)
pred c_holds(x: T)
pred goal(x: T)
axiom trichotomy: forall x: T; a_holds(x) or b_holds(x) or c_holds(x)
axiom a_gives_goal: forall x: T; a_holds(x) -> goal(x)
axiom b_gives_goal: forall x: T; b_holds(x) -> goal(x)
axiom c_gives_goal: forall x: T; c_holds(x) -> goal(x)

theorem everywhereGoal(prop: T -> Prop): forall x: T; goal(x)
proof
  @generalize-x |
    fix x: T {
      @cases-rule |
        forall y: T; a_holds(y) or b_holds(y) or c_holds(y)
        [by cite trichotomy]
      @the-cases |
        a_holds(x) or b_holds(x) or c_holds(x)
        [by forall_elim(x) cases-rule]
      @a-rule |
        forall y: T; a_holds(y) -> goal(y)
        [by cite a_gives_goal]
      @a-implies-goal |
        a_holds(x) -> goal(x)
        [by forall_elim(x) a-rule]
      @b-rule |
        forall y: T; b_holds(y) -> goal(y)
        [by cite b_gives_goal]
      @b-implies-goal |
        b_holds(x) -> goal(x)
        [by forall_elim(x) b-rule]
      @c-rule |
        forall y: T; c_holds(y) -> goal(y)
        [by cite c_gives_goal]
      @c-implies-goal |
        c_holds(x) -> goal(x)
        [by forall_elim(x) c-rule]
      @when-a |
        assume a_holds(x) {
          @a-here |
            a_holds(x)
            [by hypothesis when-a]
          @goal-a |
            goal(x)
            [by modus_ponens a-implies-goal a-here]
        }
      @when-b |
        assume b_holds(x) {
          @b-here |
            b_holds(x)
            [by hypothesis when-b]
          @goal-b |
            goal(x)
            [by modus_ponens b-implies-goal b-here]
        }
      @when-c |
        assume c_holds(x) {
          @c-here |
            c_holds(x)
            [by hypothesis when-c]
          @goal-c |
            goal(x)
            [by modus_ponens c-implies-goal c-here]
        }
      @goal-holds |
        goal(x)
        [by or_elim the-cases when-a when-b when-c]
    }
  @conclusion |
    forall x: T; goal(x)
    [by forall_intro generalize-x]
qed

// a trivially-valid concrete theorem, so the file proves something (a non-schema
// proof; keeps --fast's summary at "1 theorems proven", exit 0). Strict still
// rejects the file on the malformed schema above.
theorem trichotomyIsTrichotomy: forall x: T; a_holds(x) or b_holds(x) or c_holds(x)
proof
  @conclusion |
    forall x: T; a_holds(x) or b_holds(x) or c_holds(x)
    [by cite trichotomy]
qed
