// exercises std/peano-induction.bpa: instantiating strongInduction re-checks
// its stored proof (comptime semantics), and the derived order helpers are
// cited across the import boundary. All elaborated.
import si <<< "std/peano-order.bpa"
sort Nat = si.Nat
const ZERO = si.ZERO
func succ = si.succ
pred less_than = si.less_than

pred myPred(n: Nat)

// instantiating the schema forces its full stored proof to re-check here
theorem myStrong:
  (forall n: Nat; (forall m: Nat; less_than(m, n) -> myPred(m)) -> myPred(n))
  -> forall n: Nat; myPred(n)
proof
  @conclusion |
    (forall n: Nat; (forall m: Nat; less_than(m, n) -> myPred(m)) -> myPred(n)) -> forall n: Nat; myPred(n)
    [using instantiation si.strongInduction((fun x: Nat => myPred(x)))]
qed

// the order helpers are ordinary proven theorems, cited directly
theorem useSelf: forall n: Nat; less_than(n, succ(n))
proof
  @conclusion |
    forall n: Nat; less_than(n, succ(n))
    [by theorem si.lessThanSelf]
qed
