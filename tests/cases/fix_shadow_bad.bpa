// deliberately broken: inner fix reuses the outer eigenvariable name
sort Nat
pred r(a: Nat, b: Nat)
axiom rAll: forall x, y: Nat; r(x, y)
theorem bad: forall y, x: Nat; r(x, y)
proof
  @fy |
    fix a: Nat {
      @fx |
        fix a: Nat {
          @all |
            forall x, y: Nat; r(x, y)
            [by cite rAll]
        }
      @inner |
        forall x: Nat; r(x, a)
        [by forall_intro fx]
    }
  @conc |
    forall y, x: Nat; r(x, y)
    [by forall_intro fy]
qed
