// `model` transfer soundness: even under --fast (which trusts the transfer
// without re-deriving the source proof or checking obligations), the remapped
// source theorem must α-match the stated goal. Here the goal is the source
// theorem's equation FLIPPED, so the transfer is rejected — you cannot use
// `model` to prove something the source theorem does not say.
import source <<< "model_source.bpa"

sort Thing
const ZED: Thing
func combine(a: Thing, b: Thing): Thing
axiom combineZedLeft: forall a: Thing; combine(ZED, a) = a

model ThingModel {
  source.Sort: Thing
  source.UNIT: ZED
  source.op: combine
  source.opUnitLeft <- combineZedLeft
  }

theorem wrongGoal: forall a: Thing; combine(ZED, a) = combine(ZED, combine(ZED, a))
proof
  @conclusion |
    forall a: Thing; combine(ZED, a) = combine(ZED, combine(ZED, a))
    [using model(ThingModel) source.opUnitLeftTwice]
qed
