// qualified use, aliases, and view-equality: good(NIL) and good(lib.NIL) are
// the same formula because aliases denote the same entities
import lib <<< "lib.bpa"
sort Item = lib.Item
const NIL = lib.NIL
pred good = lib.good
theorem stillGood: good(NIL)
proof
  @conclusion |
    good(lib.NIL)
    [by cite lib.nilIsGood]
qed
