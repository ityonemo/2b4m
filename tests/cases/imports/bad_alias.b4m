// deliberately broken: aliasing a constant as a sort is a kind error. A
// theorem quantifies over the bogus sort to force the alias to be resolved.
import lib <<< "lib.b4m"
sort Wrong = lib.NIL

theorem forceBadAlias: forall x: Wrong; x = x
proof
  @generalize-x |
    fix x: Wrong {
      @conclusion-reflexive |
        x = x
        [by reflexivity]
    }
  @conclusion |
    forall x: Wrong; x = x
    [by forall_intro generalize-x]
qed
