// A library exporting a theorem, cited across the file boundary by `using import(I)`.
sort Nat
const ZERO: Nat
func succ(n: Nat) => Nat
axiom succCong: forall n: Nat; succ(n) = succ(n)

theorem congThm: forall n: Nat; succ(n) = succ(n)
proof
  @conclusion |
    forall n: Nat; succ(n) = succ(n)
    [by cite succCong]
qed
