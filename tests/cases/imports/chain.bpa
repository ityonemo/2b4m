// imports from a SUBdirectory, which itself imports from its parent —
// both directory boundaries in one chain, sharing one lib
import child <<< "sub/child.bpa"
import lib <<< "lib.bpa"
theorem chainGood: lib.good(lib.NIL)
proof
  @conclusion |
    lib.good(lib.NIL)
    [by cite child.childGood]
qed
