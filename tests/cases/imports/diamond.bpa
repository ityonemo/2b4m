// diamond imports: lib is loaded once; left and right re-export the SAME
// entities, so a formula mixing both spellings is the lib formula, and lib's
// theorem proves it across two re-export hops.
import left <<< "diamond_left.bpa"
import right <<< "diamond_right.bpa"
theorem diamondGood: left.good(right.NIL)
proof
  @conclusion |
    left.good(right.NIL)
    [by cite left.nilIsGood]
qed
