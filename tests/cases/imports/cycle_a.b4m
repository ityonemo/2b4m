// cycle_a and cycle_b import each other — cyclic file imports are ALLOWED (no proof cycle).
// Each cites the other's sort: an uncited import is itself an error now (parser.zig
// `unused_imports`), and a cycle only means anything when the files really do reference
// across it.
import b <<< "cycle_b.b4m"
sort A
sort BHere = b.B
