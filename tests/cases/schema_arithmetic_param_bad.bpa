// A schema whose proof uses `[using arithmetic]` on a goal mentioning the schema's
// VALUE parameter `k`. Under the eager engine this was a deliberate NEGATIVE: the
// decl-time wellformedness self-check reified `k` as an OPAQUE symbol, which the
// Presburger fragment could not treat as a Nat variable ("cannot yet decide this
// goal over the schema parameter 'k'"). The demand engine has no opaque path — a
// schema is checked PER INSTANCE at the citer's actual arguments, where `k` is an
// ordinary term — so the goal certifies and the file is simply OK. (The name keeps
// its history; the gate now pins the acceptance.)
sort Nat
const ZERO: Nat
const ONE: Nat
func succ(n: Nat): Nat
func add(a: Nat, b: Nat): Nat
axiom addZeroLeft: forall b: Nat; add(ZERO, b) = b
axiom addSuccLeft: forall a, b: Nat; add(succ(a), b) = succ(add(a, b))
axiom oneIsSuccZero: ONE = succ(ZERO)

theorem valArith(k: Nat): add(k, ONE) = succ(k)
proof
  @arith-step |
    add(k, ONE) = succ(k)
    [using arithmetic]
qed

// the instance that actually runs the schema's proof (uncited code isn't checked).
theorem valArithAtZero: add(ZERO, ONE) = succ(ZERO)
proof
  @conclusion |
    add(ZERO, ONE) = succ(ZERO)
    [using instantiation valArith(ZERO)]
qed
