// GUARDED model transfer (`model … where <guard>`): `Thing` models the abstract
// theory from model_guarded_source.b4m, but ZED is a left identity only on the
// guarded subset `good`. A transferred theorem is RELATIVIZED — its statement
// carries `good(a) ->` at each binder over the sort — and (strict mode) its
// materialized proof discharges the guard obligation at every instantiation:
//   - a constant  → the model's base closure fact (good(ZED))
//   - a fixed var → the guard assumption in the eigenvariable's scope
//   - a composite → a closure fact (good(a) -> good(combine(ZED,a)))
// recursing over the term. Kernel-checked.
import source <<< "model_guarded_source.b4m"

sort Thing
const ZED: Thing
func combine(a: Thing, b: Thing) => Thing
pred good(x: Thing)

// the discharge fact carries the guard: ZED is a left identity for `good` things.
axiom combineZedLeftGuarded: forall a: Thing; good(a) -> combine(ZED, a) = a

// guard-discharger facts the model NOMINATES (13e) to discharge `good(t)` obligations:
axiom goodZed: good(ZED)                                             // base (for the const ZED)
axiom combineClosure: forall a, b: Thing; (good(a) and good(b)) -> good(combine(a, b)) // closure (for combine)

sort ThingGood = Thing where good

model ThingModel {
  source.Sort: ThingGood
  source.UNIT: ZED(goodZed)              // const → base fact
  source.op: combine -| combineClosure   // func → closure fact
  source.opUnitLeft <- combineZedLeftGuarded
  }

// L1 (ground): transfer opUnitAtUnit — the proof instantiates at the constant
// UNIT→ZED, so materialization discharges good(ZED) from goodZed. Statement is
// unrelativized (no binder over the sort).
theorem combineZedAtZed: combine(ZED, ZED) = ZED
proof
  @conclusion |
    combine(ZED, ZED) = ZED
    [using model(ThingModel) source.opUnitAtUnit]
qed

// L2 (fix + eigenvariable): transfer opUnitLeftOnce — its proof `fix a { …
// forall_elim(a) … }`. The materialized proof wraps the sort's fix as
// `fix a { assume good(a) { … } }` and discharges good(a) from that assumption.
// Statement is relativized.
theorem combineZedLeftForGood: forall a: Thing; good(a) -> combine(ZED, a) = a
proof
  @conclusion |
    forall a: Thing; good(a) -> combine(ZED, a) = a
    [using model(ThingModel) source.opUnitLeftOnce]
qed

// L3 (composite): transfer opUnitLeftTwice — the proof forall_elims at the
// composite op(UNIT,a)→combine(ZED,a), so materialization discharges
// good(combine(ZED,a)) via goodCombineZed, recursing to good(a) (the assumption).
theorem combineZedTwiceForGood:
  forall a: Thing; good(a) -> combine(ZED, combine(ZED, a)) = combine(ZED, a)
proof
  @conclusion |
    forall a: Thing; good(a) -> combine(ZED, combine(ZED, a)) = combine(ZED, a)
    [using model(ThingModel) source.opUnitLeftTwice]
qed

// L4 (recursive citation + rewrite): transfer opUnitLeftThrice — its proof cites
// opUnitLeftTwice (forcing recursive guarded materialization of that dependency)
// and uses `rewrite`. Exercises the memoized recursion + the rewrite re-emit path.
theorem combineZedThriceForGood:
  forall a: Thing; good(a) -> combine(ZED, combine(ZED, combine(ZED, a))) = combine(ZED, a)
proof
  @conclusion |
    forall a: Thing; good(a) -> combine(ZED, combine(ZED, combine(ZED, a))) = combine(ZED, a)
    [using model(ThingModel) source.opUnitLeftThrice]
qed
