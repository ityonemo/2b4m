// MODEL TRANSFER OF AN ACCELERANT-USING THEOREM — `assoc_commut` (GUARDED model).
//
// A source theorem proved with the explicit-triple `assoc_commut(assoc, comm,
// swap)` form (a custom operator, no well-known names) is transferred through a
// GUARDED model (sort restricted to `good`). The transfer must materialize a
// MODEL-MANGLED, relativized synthetic AC-normalization for the step.
//
// The accelerant builds its synthetic in SOURCE space; the instance ProveTask adopts the
// model and injects the target sort's guard on each value param (the parent model's `good`),
// the call site discharges it. The transferred cert is a source proof relativized under the
// model, so — exactly like a hand-written transfer — the model must NOMINATE closure
// dischargers (`C: TC(baseFact)`, `f: tf -| closureFact`) for the guard to close.

sort Src
func join(a: Src, b: Src): Src
axiom joinAssoc: forall a, b, c: Src; join(join(a, b), c) = join(a, join(b, c))
axiom joinComm: forall a, b: Src; join(a, b) = join(b, a)
axiom joinSwap: forall x, y, r: Src; join(x, join(y, r)) = join(y, join(x, r))

// proved with the explicit-triple `assoc_commut` — reorder a join-sum.
theorem reorder: forall a, b, c, d: Src;
  join(join(a, b), join(c, d)) = join(join(a, c), join(b, d))
proof
  @conclusion |
    forall a, b, c, d: Src; join(join(a, b), join(c, d)) = join(join(a, c), join(b, d))
    [using assoc_commut_quantified(joinAssoc, joinComm, joinSwap)]
qed

// a concrete sort with a membership guard `good`.
sort Tgt
func tjoin(a: Tgt, b: Tgt): Tgt
pred good(x: Tgt)
sort GoodTgt = Tgt where good
// closure of the guard, so the ONLY remaining transfer failure is the accelerant.
axiom goodClosed: forall a, b: Tgt; good(a) -> good(b) -> good(tjoin(a, b))
axiom tjoinAssoc: forall a, b, c: Tgt; tjoin(tjoin(a, b), c) = tjoin(a, tjoin(b, c))
axiom tjoinComm: forall a, b: Tgt; tjoin(a, b) = tjoin(b, a)
axiom tjoinSwap: forall x, y, r: Tgt; tjoin(x, tjoin(y, r)) = tjoin(y, tjoin(x, r))

model SrcIsGood {
  Src: GoodTgt
  join: tjoin -| goodClosed
  joinAssoc <- tjoinAssoc
  joinComm <- tjoinComm
  joinSwap <- tjoinSwap
}

theorem transferred: forall a, b, c, d: GoodTgt;
  tjoin(tjoin(a, b), tjoin(c, d)) = tjoin(tjoin(a, c), tjoin(b, d))
proof
  @conclusion |
    forall a, b, c, d: GoodTgt; tjoin(tjoin(a, b), tjoin(c, d)) = tjoin(tjoin(a, c), tjoin(b, d))
    [using model(SrcIsGood) reorder]
qed
