// `model` obligation discharge uses `<-` (distinct from `:` symbol/sort maps):
//   `src : tgt`       — interpret a source SORT or SYMBOL as a local one
//   `src <- localThm` — discharge a source AXIOM obligation with a local fact
// Happy path: a concrete `Thing` models the source theory, symbols via `:`, the
// axiom obligation via `<-`, and the source theorem transfers through the model.
import source <<< "model_source.bpa"

sort Thing
const ZED: Thing
func combine(a: Thing, b: Thing): Thing

axiom combineZedLeft: forall a: Thing; combine(ZED, a) = a

model ThingModel {
  source.Sort: Thing
  source.UNIT: ZED
  source.op: combine
  source.opUnitLeft <- combineZedLeft
}

theorem combineZedLeftTwice: forall a: Thing; combine(ZED, combine(ZED, a)) = combine(ZED, a)
proof
  @conclusion |
    forall a: Thing; combine(ZED, combine(ZED, a)) = combine(ZED, a)
    [using model(ThingModel) source.opUnitLeftTwice]
qed
