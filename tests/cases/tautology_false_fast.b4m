import peano <<< "std/peano.b4m"
const ZERO = peano.ZERO
pred p(n: peano.Nat)
axiom pZero: p(ZERO)

// FALSE: p(ZERO) does not propositionally imply its negation
theorem tautFalse: not p(ZERO)
proof
  @given |
    p(ZERO)
    [by cite pZero]
  @conclusion |
    not p(ZERO)
    [using tautology given]
qed
