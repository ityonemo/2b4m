// SOURCE for the definitional-discharge gate: a theory whose operation is a DEFINITION
// BLOCK, so its "axioms" are clauses with no user-facing name. A model over this theory
// cannot name them one by one — it discharges the whole clause set by naming the symbol.
sort N
const NZ: N
func nsucc(a: N) => N

func nadd(a: N, b: N) => N:
  nadd(NZ, b) = b;
  nadd(nsucc(k), b) = nsucc(nadd(k, b))

// Two theorems resting on DIFFERENT clauses, so a transfer that paired the arms wrongly
// would prove one and fail the other rather than passing by luck.
theorem addAtZero: forall b: N; nadd(NZ, b) = b
proof
  @conclusion |
    forall b: N; nadd(NZ, b) = b
    [by definition(0) nadd]
qed

theorem addSteps: forall b: N; forall k: N; nadd(nsucc(k), b) = nsucc(nadd(k, b))
proof
  @conclusion |
    forall b: N; forall k: N; nadd(nsucc(k), b) = nsucc(nadd(k, b))
    [by definition(1) nadd]
qed
