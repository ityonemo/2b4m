// The provider half of the cross-file lemma fixture: `helper` is a LEMMA, so another
// file must not be able to cite it.
sort Nat
const ZERO: Nat
oper succ(n: Nat) => Nat
axiom succNotZero: forall n: Nat; succ(n) != ZERO
lemma helper: forall n: Nat; succ(n) != ZERO
proof
  @conclusion |
    forall n: Nat; succ(n) != ZERO
    [by cite succNotZero]
qed

// What this file proves (verified manifest):
intheory usesTheHelperLocally

// a lemma must still be exercised by its own file (push 2 makes that a rule)
theorem usesTheHelperLocally: succ(ZERO) != ZERO
proof
  @conclusion |
    succ(ZERO) != ZERO
    [using specialize helper(ZERO)]
qed
