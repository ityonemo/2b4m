// EXPECTED TO FAIL: a `fact` alias is a RE-EXPORT, so it is the other way a lemma could
// leave its file. The citation that reads the alias is LOCAL (and so passes the
// citation-side check); the alias itself is what crosses the boundary, and that is where
// this is caught.
theory provider <<< "lemma_cross_file_provider.b4m"
fact borrowed = provider.helper

intheory viaAlias

theorem viaAlias: forall n: provider.Nat; provider.succ(n) != provider.ZERO
proof
  @conclusion |
    forall n: provider.Nat; provider.succ(n) != provider.ZERO
    [by cite borrowed]
qed
