// EXPECTED TO FAIL once the non-export rule lands (the next push): a `lemma` is not
// citable from another file. Today it still resolves, which is exactly what makes this
// the waiting red test — when push 2 enforces the rule, this file must start failing.
theory provider <<< "lemma_cross_file_provider.b4m"

// What this file proves (verified manifest):
intheory reachesIntoAnotherFilesLemma

theorem reachesIntoAnotherFilesLemma: forall n: provider.Nat; provider.succ(n) != provider.ZERO
proof
  @conclusion |
    forall n: provider.Nat; provider.succ(n) != provider.ZERO
    [using import(provider) helper]
