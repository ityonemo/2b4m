// EXPECTED TO FAIL: a `lemma` that nothing in its own file cites is dead weight. It cannot
// be cited from anywhere else (that is what `lemma` means), so an uncited one is reachable
// by nobody — the proof carries no load and nothing would report it.
//
// `--draft` relaxes this, like the other author-hygiene rules.
sort Nat
const ZERO: Nat
oper succ(n: Nat) => Nat
axiom succNotZero: forall n: Nat; succ(n) != ZERO

intheory theRealResult

lemma nobodyCitesThis: forall n: Nat; succ(n) != ZERO
proof
  @conclusion |
    forall n: Nat; succ(n) != ZERO
    [by cite succNotZero]
qed

theorem theRealResult: succ(ZERO) != ZERO
proof
  @conclusion |
    succ(ZERO) != ZERO
    [using specialize succNotZero(ZERO)]
qed
