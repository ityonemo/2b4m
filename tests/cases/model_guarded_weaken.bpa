// GUARDED model — AUTO-WEAKENING of an unconditional axiom. A source axiom that
// holds on ALL of the sort (here `absorbs`: op(E, a) = a for every a) is mapped
// to ITSELF. Under the guard `inH`, the transferred theorem's statement is
// relativized (`inH(a) -> …`), so the mapped axiom's obligation is the relativized
// `forall a; inH(a) -> op(E, a) = a`. That is a TRIVIAL WEAKENING of the
// unconditional axiom — `forall a; P(a)` entails `forall a; guard(a) -> P(a)` for
// any guard — so the materializer synthesizes it automatically (fix a; assume
// inH(a); forall_elim; implies_intro; forall_intro). The author does NOT hand-write
// a pre-relativized copy.
import source <<< "model_guarded_weaken_source.bpa"

sort Grp = source.Grp
const E = source.E
func op = source.op
pred inH(g: Grp)

// closure obligation for the constant E, discharged from a base membership fact.
axiom identityInH: inH(E)

sort GrpH = Grp where inH

model SubgroupIsGroup {
  source.Grp: GrpH
  source.E: E(identityInH)
  source.absorbs <- source.absorbs
  }

// transferred: op(E, E) = E holds on H. The proof (in the source) forall_elims
// `absorbs` at E, so materialization needs the relativized `inH(a) -> op(E,a)=a`
// — synthesized by weakening the unconditional `absorbs` — and discharges inH(E)
// from identityInH.
theorem identityFixesItself: op(E, E) = E
proof
  @conclusion |
    op(E, E) = E
    [using model(SubgroupIsGroup) source.absorbsAtIdentity]
qed
