// The `ext` accelerated tactic on the SET model: a set equation LHS = RHS is
// proved by extensionality — reduce to the two pointwise inclusions, fix an
// element, unfold `member` via the operator lemmas, and close the propositional
// residue with tautology. One line replaces the ~85-line hand element-chase.
import set <<< "std/set.b4m"
sort Element = set.Element
sort Set = set.Set
const emptyset = set.emptyset
func union = set.union
func intersection = set.intersection
pred member = set.member
axiom unionMember = set.unionMember
axiom intersectionMember = set.intersectionMember
axiom extensionality = set.extensionality

theorem intersectionCommutative: forall a, b: Set; intersection(a, b) = intersection(b, a)
proof
  @conclusion |
    forall a, b: Set; intersection(a, b) = intersection(b, a)
    [using extensionality_quantified(extensionality) intersectionMember]
qed

theorem unionAssociative: forall a, b, c: Set; union(union(a, b), c) = union(a, union(b, c))
proof
  @conclusion |
    forall a, b, c: Set; union(union(a, b), c) = union(a, union(b, c))
    [using extensionality_quantified(extensionality) unionMember]
qed
