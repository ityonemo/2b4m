// Farkas coefficient scaling: a hypothesis is multiplied by a
// literal (via multiplicationPreservesOrder) before combining. Here a<b scaled
// by THREE gives 3a<3b, which with 3b<3a (a second hypothesis) contradicts —
// the scaled edge feeds the same transitivity/irreflexivity fold as the
// difference-logic case.
import ordering <<< "std/peano/order.bpa"

sort Nat = ordering.Nat
const ZERO = ordering.ZERO
func succ = ordering.succ
func mul = ordering.mul
pred less_than = ordering.less_than
define THREE = succ(succ(succ(ZERO)))

theorem scaledInfeasible: forall a, b: Nat; less_than(a, b) -> less_than(mul(THREE, b), mul(THREE, a)) -> less_than(a, a)
proof
  @conclusion |
    forall a, b: Nat; less_than(a, b) -> less_than(mul(THREE, b), mul(THREE, a)) -> less_than(a, a)
    [using arithmetic(ordering)]
qed
