// A VALID proof whose step exists ONLY to discharge a guarded-application obligation.
// `apply(h: H)` requires `inH(<arg>)`. Inside `fix g: H` the step @g-in-subset restates the
// binder's guard `inH(g)`; the use `apply(g)` looks that obligation up BY IDENTITY and finds
// its most recent teacher — that step — consuming it. A reachability walk that followed only
// citations would wrongly flag @g-in-subset as dead. It IS used, so this must PASS.
sort G
pred inH(g: G)
sort H = G where inH
func apply(h: H) => G
pred Q(g: G)

// `qEverywhere` is stated over the raw sort G, so IT emits no guard obligation.
axiom qEverywhere: forall x: G; Q(x)

theorem allGGiveQ: forall g: H; Q(apply(g))
proof
  @generalize-g |
    fix g: H {
      // discharges the `inH(g)` obligation that `apply(g)` owes below.
      @g-in-subset |
        inH(g)
        [by predicate generalize-g]
      @q-everywhere |
        forall x: G; Q(x)
        [by cite qEverywhere]
      @conclusion-q |
        Q(apply(g))
        [by forall_elim(apply(g)) q-everywhere]
    }
  @conclusion |
    forall g: H; Q(apply(g))
    [by forall_intro generalize-g]
qed
