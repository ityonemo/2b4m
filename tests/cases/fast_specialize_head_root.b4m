// A step consumed ONLY as a `specialize` HEAD must not be reported dead under `--fast`.
//
// `specialize HEAD(args)` carries its head in the claim's `schema` slot, not in `refs`, and
// the head may be a LOCAL STEP LABEL. An ADMITTED accelerant (`--fast`) builds no
// certificate, so the use-all-facts walk has no citation edge for what it consumed — the
// admit path seeds those as reachability roots, and it used to seed `refs` only. A step like
// `@the-universal` below, cited solely as a head, was then called unused.
//
// The invariant: `--fast` must never report an error that strict does not. So this file is
// gated BOTH ways.
sort Nat
const ZERO: Nat
pred big(n: Nat)

axiom everythingIsBig: forall n: Nat; big(n)

theorem aLocalUniversalUsedOnlyAsASpecializeHead: big(ZERO)
proof
  @the-universal |
    forall n: Nat; big(n)
    [by cite everythingIsBig]
  @conclusion |
    big(ZERO)
    [using specialize the-universal(ZERO)]
qed
