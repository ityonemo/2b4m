// `polynomial` on a NON-identity: the two sides expand to different
// polynomials, so the tactic emits a located error (never accelerated — polynomial
// has no accelerated step).
import peano <<< "std/peano.b4m"

sort Nat = peano.Nat
func add = peano.add
func mul = peano.mul

// mul(add(a,b), add(a,b)) expands to a*a + a*b + a*b + b*b, which is NOT
// a*a + b*b — the cross terms are missing. polynomial must reject this.
theorem notAnIdentity: forall a, b: Nat;
  mul(add(a, b), add(a, b)) = add(mul(a, a), mul(b, b))
proof
  @conclusion |
    forall a, b: Nat;
      mul(add(a, b), add(a, b)) = add(mul(a, a), mul(b, b))
    [using polynomial_quantified(peano)]
qed
