// EXPECTED TO FAIL: every theorem must be forward-declared with `intheory`, so a file's
// header is a verified table of contents. `provedButNotDeclared` has no `intheory` line.
//
// `--draft` relaxes this (it is author hygiene, not soundness), which is what makes a
// work-in-progress file writable.
sort Nat
const ZERO: Nat
oper succ(n: Nat) => Nat
axiom succNotZero: forall n: Nat; succ(n) != ZERO

theorem provedButNotDeclared: succ(ZERO) != ZERO
proof
  @conclusion |
    succ(ZERO) != ZERO
    [using specialize succNotZero(ZERO)]
qed
