// The same file with its manifest entry present: the header declares what the file proves.
sort Nat
const ZERO: Nat
oper succ(n: Nat) => Nat
axiom succNotZero: forall n: Nat; succ(n) != ZERO

intheory properlyDeclared

theorem properlyDeclared: succ(ZERO) != ZERO
proof
  @conclusion |
    succ(ZERO) != ZERO
    [using specialize succNotZero(ZERO)]
qed
