// An inline `where` guard that is an ALIAS to a REMOTE define, appearing INSIDE another
// define's body. Expanding the outer define resolves the guard in that define's home file,
// where it is an alias; following the alias needs the alias's own import fetched. While
// that demand is outstanding `resolveDefine` reports PENDING — and the guard desugaring
// must not read PENDING as "not a define" and leave it an opaque binder guard, which then
// demands the name as an IDENTIFIER (FetchTask's misuse arm: "'isBig' is a define").
import src <<< "define_alias_nested_guard_src.bpa"

sort Nat = src.Nat
const ZERO = src.ZERO
func succ = src.succ
pred big = src.isBig

define allBigAre(p) = forall x: Nat where big; p

axiom useIt: allBigAre(ZERO = ZERO)
