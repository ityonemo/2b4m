// D2: mixed goals replay as elaborated certificates — opaque atoms case-split
// with an inline excluded middle, and arithmetic dead ends close by
// deriving the conflicting literal from the branch's assumptions. No
// accelerated tactic, so --pure is satisfied.
theory peano <<< "std/peano.b4m"
theory ordering <<< "std/peano/order.b4m"
sort Nat = peano.Nat
const ZERO = peano.ZERO
const ONE = peano.ONE
oper succ = peano.succ
oper add = peano.add
oper mul = peano.mul
pred less_than = ordering.less_than
fact addZeroLeft = peano.addZeroLeft
fact addSuccLeft = peano.addSuccLeft
fact mulZeroLeft = peano.mulZeroLeft
fact mulSuccLeft = peano.mulSuccLeft
fact oneIsSuccZero = peano.oneIsSuccZero
fact lessThanIntro = ordering.lessThanIntro
fact lessThanElim = ordering.lessThanElim
fact addZeroRight = peano.addZeroRight
fact addSuccRight = peano.addSuccRight
fact mulZeroRight = peano.mulZeroRight
fact mulSuccRight = peano.mulSuccRight
fact addIsAssociative = peano.addIsAssociative
fact addIsCommutative = peano.addIsCommutative
fact addLeftSwap = peano.addLeftSwap
pred p()

theorem mixedStepUp: forall a, b: Nat; less_than(a, b) -> (p() or less_than(a, succ(b)))
proof
  @conclusion |
    forall a, b: Nat; less_than(a, b) -> (p() or less_than(a, succ(b)))
    [using arithmetic]
qed

theorem conflictPure: forall a: Nat; (p() and less_than(a, succ(a))) or ((not p()) and less_than(a, add(a, ONE)))
proof
  @conclusion |
    forall a: Nat; (p() and less_than(a, succ(a))) or ((not p()) and less_than(a, add(a, ONE)))
    [using arithmetic]
qed
