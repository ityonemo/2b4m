// deliberately broken: the two rules rewrite back and forth forever; the
// tactic hits its hard rewrite cap instead of hanging
sort Nat
func flip(n: Nat) => Nat
func flop(n: Nat) => Nat
const START: Nat
axiom flipToFlop: forall n: Nat; flip(n) = flop(n)
axiom flopToFlip: forall n: Nat; flop(n) = flip(n)
theorem bad: flip(START) = flop(START)
proof
  @conclusion |
    flip(START) = flop(START)
    [using simplify flipToFlop flopToFlip]
qed
