// The arithmetic equation certifier must cancel an additive-inverse pair
// x + (-x) even when the two are NOT syntactically adjacent in the normalized
// sum. `add(a, sub(b, a)) = b` unfolds (definitionOfSubtraction) to
// `add(a, add(b, neg(a))) = b`: the normal-form summand multiset is
// {a, b, neg(a)}, which must reduce to {b} by cancelling a with neg(a) across
// the intervening b. A pure linear ℤ identity — [using arithmetic] should certify
// it strict (not just decide it under --fast).
theory integer <<< "std/integer.b4m"
theory order <<< "std/integer/order.b4m"
sort Int = integer.Int
const ZERO = integer.ZERO
oper add = integer.add
oper neg = integer.neg
oper sub = order.sub
fact definitionOfSubtraction = integer.definitionOfSubtraction
fact addNegRight = integer.addNegRight
fact addNegLeft = integer.addNegLeft
fact negNeg = integer.negNeg
fact addZeroLeft = integer.addZeroLeft
fact addZeroRight = integer.addZeroRight
fact addIsAssociative = integer.addIsAssociative
fact addIsCommutative = integer.addIsCommutative
fact addLeftSwap = integer.addLeftSwap

theorem diffReaches: forall a, b: Int; add(a, sub(b, a)) = b
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @conclusion-diff-reaches |
            add(a, sub(b, a)) = b
            [using arithmetic]
        }
      @discharge-b |
        forall b: Int; add(a, sub(b, a)) = b
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Int; add(a, sub(b, a)) = b
    [by generalize generalize-a]
qed
