// The arithmetic equation certifier must cancel an additive-inverse pair when
// one side of the pair is a NUMERAL — `add(ONE, sub(b, ONE)) = b`. `sub(b, ONE)`
// unfolds to `add(b, neg(ONE))`, so the summand multiset is {ONE, b, neg(ONE)}
// with ONE = succ(ZERO). The ONE / neg(ONE) pair must cancel, leaving {b}.
//
// The wrinkle this exercises: `succ(ZERO)` is a `succ`-tower sitting as an INNER
// summand of the sum (not the top-level succ prefix parseTower folds into its
// `succs` count). The tower parser must recognize a numeral summand and fold it
// into the tower's constant offset, so ONE and neg(ONE) meet and cancel. A pure
// linear ℤ identity — [using arithmetic] should certify it strict.
import integer <<< "std/integer.b4m"
import order <<< "std/integer/order.b4m"
sort Int = integer.Int
const ZERO = integer.ZERO
const ONE = integer.ONE
func succ = integer.succ
func add = integer.add
func neg = integer.neg
func sub = order.sub
fact definitionOfSubtraction = integer.definitionOfSubtraction
fact addNegRight = integer.addNegRight
fact addNegLeft = integer.addNegLeft
fact negNeg = integer.negNeg
fact addZeroLeft = integer.addZeroLeft
fact addZeroRight = integer.addZeroRight
fact addIsAssociative = integer.addIsAssociative
fact addIsCommutative = integer.addIsCommutative
fact addLeftSwap = integer.addLeftSwap
fact oneIsSuccZero = integer.oneIsSuccZero
func prev = integer.prev
fact addSuccLeft = integer.addSuccLeft
fact addSuccRight = integer.addSuccRight
fact addPrevLeft = integer.addPrevLeft
fact addPrevRight = integer.addPrevRight
fact negZero = integer.negZero
fact negSucc = integer.negSucc
fact negPrev = integer.negPrev
fact prevSucc = integer.prevSucc
fact succPrev = integer.succPrev

theorem oneReaches: forall b: Int; add(ONE, sub(b, ONE)) = b
proof
  @generalize-b |
    fix b: Int {
      @conclusion-one-reaches |
        add(ONE, sub(b, ONE)) = b
        [using arithmetic]
    }
  @conclusion |
    forall b: Int; add(ONE, sub(b, ONE)) = b
    [by generalize generalize-b]
qed
