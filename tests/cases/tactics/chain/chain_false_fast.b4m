// Regression: `chain`'s BFS decision runs under `--fast`.
//
// `--fast` declines only to EMIT the join certificate; the search for a path from the goal's
// left side to its right side over the cited equations still runs. Admitting before it accepted
// any equation goal with at least one cited equation, however unrelated.
import peano <<< "std/peano.b4m"

const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add

// a genuine ground equation to cite, and a goal it cannot reach
const A: peano.Nat
const B: peano.Nat
axiom aIsB: A = B

theorem chainCannotConnect: succ(ZERO) = add(succ(ZERO), succ(ZERO))
proof
  @the-equation |
    A = B
    [by cite aIsB]
  @conclusion |
    succ(ZERO) = add(succ(ZERO), succ(ZERO))
    [using chain the-equation]
qed
