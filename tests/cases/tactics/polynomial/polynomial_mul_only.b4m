// `polynomial` on a MUL-ONLY ring identity — no `add` anywhere in the goal. A single
// monomial: the canonicalizer's monomial phase (mul assoc/comm/swap, neg-push through
// mul, negNeg) is all that is needed; the sum phases have one leaf. RED until the op
// reader stops demanding BOTH add and mul ("the goal has no add/mul structure").
import int_divides <<< "std/integer/divides.b4m"

sort Int = int_divides.Int
func mul = int_divides.mul
func neg = int_divides.neg

// a product of negations is the product (mulNegLeft/Right + negNeg), no add.
theorem negTimesNegMulOnly: forall e, k: Int; mul(e, k) = mul(neg(e), neg(k))
proof
  @conclusion |
    forall e, k: Int; mul(e, k) = mul(neg(e), neg(k))
    [using polynomial_quantified(int_divides)]
qed

// a product regroups (the mul triple), no add.
theorem productRegroupsMulOnly: forall d, k, m: Int; mul(mul(d, k), m) = mul(k, mul(d, m))
proof
  @conclusion |
    forall d, k, m: Int; mul(mul(d, k), m) = mul(k, mul(d, m))
    [using polynomial_quantified(int_divides)]
qed
