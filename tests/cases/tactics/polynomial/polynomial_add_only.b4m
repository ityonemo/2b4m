// `polynomial` on an ADD-ONLY ring identity — no `mul` anywhere in the goal. A ring
// identity in one operator is still a polynomial identity: the canonicalizer's sum
// phases (neg-push, right-nesting, sorting, inverse cancellation) never need `mul`,
// and the rules that mention it are simply not applicable. RED until the op reader
// stops demanding BOTH add and mul ("the goal has no add/mul structure").
import int_divides <<< "std/integer/divides.b4m"

sort Int = int_divides.Int
const ZERO = int_divides.ZERO
func add = int_divides.add
func neg = int_divides.neg

// neg distributes over a sum (negAdd), no mul in sight.
theorem negOverSumAddOnly: forall a, b: Int; neg(add(a, b)) = add(neg(a), neg(b))
proof
  @conclusion |
    forall a, b: Int; neg(add(a, b)) = add(neg(a), neg(b))
    [using polynomial_quantified(int_divides)]
qed

// a sum reassociates + commutes (the add triple), no mul.
theorem sumRegroupsAddOnly: forall a, b, c: Int; add(add(a, b), c) = add(c, add(b, a))
proof
  @conclusion |
    forall a, b, c: Int; add(add(a, b), c) = add(c, add(b, a))
    [using polynomial_quantified(int_divides)]
qed

// a sum cancels against its negation to ZERO (ZERO IS in the goal here).
theorem sumCancelsAddOnly: forall a, b: Int; add(add(a, b), add(neg(a), neg(b))) = ZERO
proof
  @conclusion |
    forall a, b: Int; add(add(a, b), add(neg(a), neg(b))) = ZERO
    [using polynomial_quantified(int_divides)]
qed
