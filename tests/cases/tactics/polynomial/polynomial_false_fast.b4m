theory peano <<< "std/peano.b4m"
oper add = peano.add
oper mul = peano.mul

// What this file proves (verified manifest):
intheory polyFalse

// FALSE: (a+b)*(a+b) is a^2 + 2ab + b^2, not a^2 + b^2
theorem polyFalse: forall a, b: peano.Nat; mul(add(a, b), add(a, b)) = add(mul(a, a), mul(b, b))
proof
  @conclusion |
    forall a, b: peano.Nat; mul(add(a, b), add(a, b)) = add(mul(a, a), mul(b, b))
    [using polynomial_quantified(peano)]
qed
