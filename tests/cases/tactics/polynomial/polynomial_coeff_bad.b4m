// Negative: a WRONG coefficient must still be rejected. q + q is 2·q, not 3·q —
// the coefficient arithmetic is real, not a rubber stamp. Locks the fold count.
import int_divides <<< "std/integer/divides.b4m"

sort Int = int_divides.Int
func add = int_divides.add
func mul = int_divides.mul
define THREE = int_divides.THREE

theorem qPlusQisNotThreeQ: forall q: Int;
  add(q, q) = mul(THREE, q)
proof
  @conclusion |
    forall q: Int; add(q, q) = mul(THREE, q)
    [using polynomial_quantified(int_divides)]
qed
