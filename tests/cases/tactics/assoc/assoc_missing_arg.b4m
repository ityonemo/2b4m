// assoc REQUIRES its associativity lemma — bare `[using assoc]` is an error.
sort T
oper op(a: T, b: T) => T
axiom opAssoc: forall c, b, a: T; op(op(a, b), c) = op(a, op(b, c))

// What this file proves (verified manifest):
intheory needsArg

theorem needsArg: forall a, b, c: T; op(op(a, b), c) = op(a, op(b, c))
proof
  @conclusion |
    forall a, b, c: T; op(op(a, b), c) = op(a, op(b, c))
    [using assoc_quantified]
qed
