// assoc: sides differ by more than associativity (a genuine non-identity).
theory peano <<< "std/peano.b4m"
const ZERO = peano.ZERO
oper succ = peano.succ
oper add = peano.add
fact addIsAssociative = peano.addIsAssociative

// What this file proves (verified manifest):
intheory bad

theorem bad: forall a, b: peano.Nat; add(a, b) = add(b, succ(a))
proof
  @conclusion |
    forall a, b: peano.Nat; add(a, b) = add(b, succ(a))
    [using assoc_quantified(addIsAssociative)]
qed
