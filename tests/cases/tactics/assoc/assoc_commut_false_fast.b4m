// assoc_commut: the two sides have DIFFERENT summands.
theory peano <<< "std/peano.b4m"
oper succ = peano.succ
oper add = peano.add

theorem bad: forall a, b: peano.Nat; add(a, b) = add(a, succ(b))
proof
  @conclusion |
    forall a, b: peano.Nat; add(a, b) = add(a, succ(b))
    [using assoc_commut_quantified]
qed
