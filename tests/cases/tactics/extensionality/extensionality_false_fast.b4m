// extensionality: a set identity that is FALSE (union is not intersection).
import set <<< "std/set.b4m"

sort Set = set.Set
func union = set.union
func intersection = set.intersection
fact extensionality = set.extensionality
fact unionMember = set.unionMember
fact intersectionMember = set.intersectionMember

theorem bad: forall a, b: Set; union(a, b) = intersection(a, b)
proof
  @conclusion |
    forall a, b: Set; union(a, b) = intersection(a, b)
    [using extensionality_quantified(extensionality) unionMember intersectionMember]
qed
