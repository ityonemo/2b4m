// ac_quantified: peel the forall prefix, run the ac core on the equation
// body, close with generalize. Handles both add and mul (same operator
// detection as bare ac). Replaces the hand-written fix-block tower.
import peano <<< "std/peano.b4m"

sort Nat = peano.Nat
func mul = peano.mul
func add = peano.add
fact mulIsAssociative = peano.mulIsAssociative
fact mulIsCommutative = peano.mulIsCommutative
fact mulLeftSwap = peano.mulLeftSwap
fact addIsAssociative = peano.addIsAssociative
fact addIsCommutative = peano.addIsCommutative
fact addLeftSwap = peano.addLeftSwap

theorem productReorders: forall a, b, c: Nat; mul(mul(a, b), c) = mul(c, mul(b, a))
proof
  @conclusion |
    forall a, b, c: Nat; mul(mul(a, b), c) = mul(c, mul(b, a))
    [using assoc_commut_quantified]
qed

theorem sumReorders: forall a, b, c: Nat; add(add(a, b), c) = add(c, add(b, a))
proof
  @conclusion |
    forall a, b, c: Nat; add(add(a, b), c) = add(c, add(b, a))
    [using assoc_commut_quantified]
qed
