// specialize: the instance's conclusion does NOT match the claim.
theory peano <<< "std/peano.b4m"
const ZERO = peano.ZERO
oper succ = peano.succ
fact succInjective = peano.succInjective

theorem bad: succ(ZERO) = ZERO
proof
  @conclusion |
    succ(ZERO) = ZERO
    [using specialize succInjective(ZERO, ZERO)]
qed
