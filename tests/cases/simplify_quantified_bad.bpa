// deliberately broken: simplify_quantified on a bare (unquantified)
// equation should redirect the user to plain simplify
sort Nat
const ZERO: Nat
func add(a: Nat, b: Nat): Nat
axiom addZeroLeft: forall b: Nat; add(ZERO, b) = b

theorem bare: add(ZERO, ZERO) = ZERO
proof
  @conclusion |
    add(ZERO, ZERO) = ZERO
    [using simplify_quantified addZeroLeft]
qed
