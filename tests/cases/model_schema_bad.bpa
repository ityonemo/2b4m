// RED: a schema source must be discharged by a SCHEMA (with a matching predicate
// parameter). Here `elemInduction` (a schema) is mapped to `notASchema` (a plain
// axiom), so the model decl rejects the mapping.
import source <<< "model_schema_source.bpa"

sort Number
const ZED: Number
func next(n: Number) => Number
pred good(x: Number)

sort NumberGood = Number where good

// a plain axiom (NOT a schema) — cannot discharge a schema source.
axiom notASchema: forall n: Number; good(n) -> good(next(n))

model NumberModel {
  source.Elem: NumberGood
  source.ZE: ZED
  source.step: next
  source.elemInduction <- notASchema
}

// the model is built only when cited.
theorem numberInductionTransferred(prop: Number -> Prop):
  prop(ZED)
  -> (forall k: Number; good(k) -> prop(k) -> prop(next(k)))
  -> forall n: Number; good(n) -> prop(n)
proof
  @conclusion |
    prop(ZED)
      -> (forall k: Number; good(k) -> prop(k) -> prop(next(k)))
      -> forall n: Number; good(n) -> prop(n)
    [using model(NumberModel) source.elemInduction]
qed

// a schema body is checked per instance: instantiating it is what builds the model.
theorem goodInductionInstance:
  good(ZED)
  -> (forall k: Number; good(k) -> good(k) -> good(next(k)))
  -> forall n: Number; good(n) -> good(n)
proof
  @conclusion |
    good(ZED)
      -> (forall k: Number; good(k) -> good(k) -> good(next(k)))
      -> forall n: Number; good(n) -> good(n)
    [using instantiation numberInductionTransferred(fun n: Number => good(n))]
qed
