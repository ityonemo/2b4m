// mul-AC: the `ac` tactic reorders a multiplication product the same way it
// reorders a sum — associativity + commutativity + mulLeftSwap. The goal's
// left side heads with `mul`, so ac picks the mul lemma triple.
import peano <<< "std/peano.b4m"

sort Nat = peano.Nat
func mul = peano.mul
func add = peano.add
theorem mulIsAssociative = peano.mulIsAssociative
theorem mulIsCommutative = peano.mulIsCommutative
theorem mulLeftSwap = peano.mulLeftSwap
theorem addIsAssociative = peano.addIsAssociative
theorem addIsCommutative = peano.addIsCommutative
theorem addLeftSwap = peano.addLeftSwap

// a product reassociated and reordered (ac on the fixed-variable equation)
theorem productReorders: forall a, b, c: Nat; mul(mul(a, b), c) = mul(c, mul(b, a))
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-c |
            fix c: Nat {
              @reordered |
                mul(mul(a, b), c) = mul(c, mul(b, a))
                [using assoc_commut]
            }
          @discharge-c |
            forall c: Nat; mul(mul(a, b), c) = mul(c, mul(b, a))
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Nat; mul(mul(a, b), c) = mul(c, mul(b, a))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Nat; mul(mul(a, b), c) = mul(c, mul(b, a))
    [by forall_intro generalize-a]
qed
