import peano <<< "std/peano.b4m"
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
fact addZeroLeft = peano.addZeroLeft

theorem falseSimplify: add(ZERO, succ(ZERO)) = succ(succ(ZERO))
proof
  @conclusion |
    add(ZERO, succ(ZERO)) = succ(succ(ZERO))
    [using simplify addZeroLeft]
qed
