// `fact X = ns.y` — ONE keyword for re-exporting a named fact, whatever its origin kind.
//
// The kind of an alias is the TARGET's property: the alias cannot know it, nothing checked
// it, and restating it went stale (it was wrong in 10 of std/'s 2345 aliases before this
// keyword existed). `--axioms` resolves every fact to its ORIGIN and reports the true kind
// there, so nothing is lost by dropping the local claim.
//
// ALIAS-ONLY: a bare `fact X: formula` is refused, because a LOCAL claim always has a kind.
import base <<< "fact_alias_base.b4m"

sort T = base.T
const A = base.A

// all three origin kinds re-export through the same keyword
fact anAxiom = base.anAxiom
fact aTheorem = base.aTheorem
fact aCitedHole = base.aCitedHole

theorem usesAll: A = A
proof
  @from-the-axiom |
    A = A
    [by cite base.anAxiom]
qed
