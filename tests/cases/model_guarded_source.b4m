// Source theory for the GUARDED `model … where` fixtures. A sort with a
// binary `op` and left-identity `UNIT`, plus two derived theorems whose proofs
// forall_elim the axiom at (a) the bound variable only, and (b) a composite
// term over the sort — the two shapes that stress guarded materialization differently.
sort Sort
const UNIT: Sort
func op(a: Sort, b: Sort) => Sort

axiom opUnitLeft: forall a: Sort; op(UNIT, a) = a

// (L1) GROUND: proof forall_elims the axiom at the CONSTANT UNIT only — no fix,
// no eigenvariable. The guard obligation to discharge is `good(UNIT)`, from the
// model's base closure fact. Smallest guarded case (isolates discharge from any
// block surgery).
theorem opUnitAtUnit: op(UNIT, UNIT) = UNIT
proof
  @unit-left |
    forall a: Sort; op(UNIT, a) = a
    [by cite opUnitLeft]
  @at-unit |
    op(UNIT, UNIT) = UNIT
    [by forall_elim(UNIT) unit-left]
qed

// (a) proof forall_elims the axiom at the BOUND variable `a` only: the injected
// guard antecedent is exactly the one the relativized statement binds.
theorem opUnitLeftOnce: forall a: Sort; op(UNIT, a) = a
proof
  @generalize-a |
    fix a: Sort {
      @unit-left |
        forall b: Sort; op(UNIT, b) = b
        [by cite opUnitLeft]
      @at-a |
        op(UNIT, a) = a
        [by forall_elim(a) unit-left]
    }
  @conclusion |
    forall a: Sort; op(UNIT, a) = a
    [by forall_intro generalize-a]
qed

// (L3) COMPOSITE: proof forall_elims the axiom at the composite term op(UNIT, a).
// Guarded materialization must discharge good(op(UNIT, a)) via a closure fact,
// recursing to good(UNIT) [base] and good(a) [the fix assumption].
theorem opUnitLeftTwice: forall a: Sort; op(UNIT, op(UNIT, a)) = op(UNIT, a)
proof
  @generalize-a |
    fix a: Sort {
      @unit-left |
        forall b: Sort; op(UNIT, b) = b
        [by cite opUnitLeft]
      @at-op-unit-a |
        op(UNIT, op(UNIT, a)) = op(UNIT, a)
        [by forall_elim(op(UNIT, a)) unit-left]
    }
  @conclusion |
    forall a: Sort; op(UNIT, op(UNIT, a)) = op(UNIT, a)
    [by forall_intro generalize-a]
qed

// (L4) RECURSIVE CITATION: a theorem whose proof CITES another (opUnitLeftTwice),
// forcing guarded materialization to recurse into that dependency (memoized) and
// materialize IT guardedly too. Also instantiates the cited universal at op(UNIT,a).
theorem opUnitLeftThrice: forall a: Sort; op(UNIT, op(UNIT, op(UNIT, a))) = op(UNIT, a)
proof
  @generalize-a |
    fix a: Sort {
      @twice |
        forall b: Sort; op(UNIT, op(UNIT, b)) = op(UNIT, b)
        [by cite opUnitLeftTwice]
      @inner-collapses |
        op(UNIT, op(UNIT, op(UNIT, a))) = op(UNIT, op(UNIT, a))
        [by forall_elim(op(UNIT, a)) twice]
      @outer-collapses |
        op(UNIT, op(UNIT, a)) = op(UNIT, a)
        [by forall_elim(a) twice]
      @conclusion-thrice |
        op(UNIT, op(UNIT, op(UNIT, a))) = op(UNIT, a)
        [by rewrite outer-collapses inner-collapses]
    }
  @conclusion |
    forall a: Sort; op(UNIT, op(UNIT, op(UNIT, a))) = op(UNIT, a)
    [by forall_intro generalize-a]
qed
