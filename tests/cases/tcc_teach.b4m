// OBLIGATION DISCHARGE BY IDENTITY. `H` is a refined sort; every use of `shift` (whose
// parameter is `H`) requires `inH(<arg>)`. That proposition is never searched for: it must
// be KNOWN where the use sits — taught by an enclosing `assume`, a prior step, a binder at
// `H`, or a refined result — and it is looked up by identity. The four ways, all green.
sort G
const UNIT: G
func succ(g: G) => G
pred inH(g: G)

sort H = G where inH
func shift(h: H) => G
// a refined RESULT: `lift(g)` is known to be in H wherever it is written.
func lift(g: G) => H

axiom unitInH: inH(UNIT)
axiom succInH: forall g: G; inH(g) -> inH(succ(g))

// (1) taught by the enclosing assumption.
theorem viaAssumption: forall x: G; inH(x) -> shift(x) = shift(x)
proof
  @generalize |
    fix x: G {
      @given |
        assume inH(x) {
          @conclusion-inner |
            shift(x) = shift(x)
            [by reflexivity]
        }
      @discharge |
        inH(x) -> shift(x) = shift(x)
        [by implies_intro given]
    }
  @conclusion |
    forall x: G; inH(x) -> shift(x) = shift(x)
    [by forall_intro generalize]
qed

// (2) taught by a prior step — and that step counts as USED by the discharge.
theorem viaPriorStep: shift(UNIT) = shift(UNIT)
proof
  @unit-in-h |
    inH(UNIT)
    [by cite unitInH]
  @conclusion |
    shift(UNIT) = shift(UNIT)
    [by reflexivity]
qed

// (3) taught by the binder: `fix x: H` knows `inH(x)` throughout its block.
theorem viaBinder: forall x: H; shift(x) = shift(x)
proof
  @generalize |
    fix x: H {
      @conclusion-inner |
        shift(x) = shift(x)
        [by reflexivity]
    }
  @conclusion |
    forall x: H; shift(x) = shift(x)
    [by forall_intro generalize]
qed

// (4) a COMPOUND subject: derive `inH(succ(UNIT))` explicitly, then the use finds it — the
// two spellings of `succ(UNIT)` are one term.
theorem viaDerivedFact: shift(succ(UNIT)) = shift(succ(UNIT))
proof
  @unit-in-h |
    inH(UNIT)
    [by cite unitInH]
  @succ-law |
    forall g: G; inH(g) -> inH(succ(g))
    [by cite succInH]
  @succ-at-unit |
    inH(UNIT) -> inH(succ(UNIT))
    [by forall_elim(UNIT) succ-law]
  @succ-unit-in-h |
    inH(succ(UNIT))
    [by modus_ponens succ-at-unit unit-in-h]
  @conclusion |
    shift(succ(UNIT)) = shift(succ(UNIT))
    [by reflexivity]
qed

// (5) a refined RESULT teaches its application: `lift(UNIT)` is in H by declaration.
theorem viaRefinedResult: shift(lift(UNIT)) = shift(lift(UNIT))
proof
  @conclusion |
    shift(lift(UNIT)) = shift(lift(UNIT))
    [by reflexivity]
qed
