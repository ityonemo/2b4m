// The `ext` accelerated tactic on the FUNCTION model: a function equation
// f = g is proved by function extensionality — reduce to pointwise agreement,
// fix an element, unfold `apply` via the operator lemmas (composeApply,
// identityApply), and close the resulting EQUATION with the equation certifier.
// Same `ext` tactic as the set model; only the residue closer differs.
import function <<< "std/function.bpa"
sort Element = function.Element
sort Fn = function.Fn
const identityFn = function.identityFn
func apply = function.apply
func compose = function.compose
axiom composeApply = function.composeApply
axiom identityApply = function.identityApply
axiom funcExtensionality = function.funcExtensionality

theorem composeAssociative: forall h, g, f: Fn; compose(compose(h, g), f) = compose(h, compose(g, f))
proof
  @conclusion |
    forall h, g, f: Fn; compose(compose(h, g), f) = compose(h, compose(g, f))
    [using ext_quantified(function)]
qed

// the identity laws: unfolding needs `identityApply` to fire on the `identityFn`
// CONST (a nullary head), not just `<op>Apply` on compound operators.
theorem composeIdentityRight: forall f: Fn; compose(f, identityFn) = f
proof
  @conclusion |
    forall f: Fn; compose(f, identityFn) = f
    [using ext_quantified(function)]
qed

theorem composeIdentityLeft: forall f: Fn; compose(identityFn, f) = f
proof
  @conclusion |
    forall f: Fn; compose(identityFn, f) = f
    [using ext_quantified(function)]
qed
