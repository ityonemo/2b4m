// Zig's no-shadowing rule: two DISJOINT sibling subproofs may reuse a fix
// variable name (`bb`). Neither eigenvariable escapes its own block subtree,
// so the kernel's checkEigen accepts it; only enclosing-scope shadowing is
// forbidden. (Previously this errored: "variable 'bb' was already used".)
sort Nat
const Z: Nat
pred p(n: Nat)
pred q(n: Nat)

axiom either: p(Z) or q(Z)
axiom pall: forall x: Nat; p(x)
axiom qall: forall x: Nat; q(x)

theorem g: p(Z) or q(Z)
proof
  @disj |
    p(Z) or q(Z)
    [by cite either]
  @result |
    p(Z) or q(Z)
    case disj {
      @when-p-holds |
        assume p(Z) {
          @generalize-bb |
            fix bb: Nat {
              @p-holds-everywhere |
                forall x: Nat; p(x)
                [by cite pall]
              @p-holds-at-bb |
                p(bb)
                [by apply_at(bb) p-holds-everywhere]
            }
          @discharge-bb |
            forall bb: Nat; p(bb)
            [by generalize generalize-bb]
          @p-holds-at-Z |
            p(Z)
            [by apply_at(Z) discharge-bb]
          @conclusion-left-disjunct |
            p(Z) or q(Z)
            [by either_left p-holds-at-Z]
        }
      @when-q-holds |
        assume q(Z) {
          @generalize-bb |
            fix bb: Nat {
              @q-holds-everywhere |
                forall x: Nat; q(x)
                [by cite qall]
              @q-holds-at-bb |
                q(bb)
                [by apply_at(bb) q-holds-everywhere]
            }
          @discharge-bb |
            forall bb: Nat; q(bb)
            [by generalize generalize-bb]
          @q-holds-at-Z |
            q(Z)
            [by apply_at(Z) discharge-bb]
          @conclusion-right-disjunct |
            p(Z) or q(Z)
            [by either_right q-holds-at-Z]
        }
    }
qed

// The harder case: two disjoint sibling `fix x` blocks EACH closed by
// `generalize`. The kernel identifies an eigenvariable by name, so before
// the elaborator disambiguated fix vars (`x` -> `x#n` internally, rendered
// back to `x`), closing the SECOND block tripped checkEigen on the FIRST
// block's still-`x` steps. This is the pattern every two-direction
// extensionality proof uses; both directions may now reuse `x`.
theorem bothGeneralize:
  (forall x: Nat; p(x)) and (forall x: Nat; q(x))
proof
  @fwd |
    fix x: Nat {
      @pa |
        forall y: Nat; p(y)
        [by cite pall]
      @px |
        p(x)
        [by apply_at(x) pa]
    }
  @fwd-all |
    forall x: Nat; p(x)
    [by generalize fwd]
  @bwd |
    fix x: Nat {
      @qa |
        forall y: Nat; q(y)
        [by cite qall]
      @qx |
        q(x)
        [by apply_at(x) qa]
    }
  @bwd-all |
    forall x: Nat; q(x)
    [by generalize bwd]
  @both |
    (forall x: Nat; p(x)) and (forall x: Nat; q(x))
    [by both fwd-all bwd-all]
qed
