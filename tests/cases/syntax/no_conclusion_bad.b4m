// deliberately broken: the assume block's only content is a nested subproof —
// it has no concluding step of its own to discharge
pred p()
pred q()

// What this file proves (verified manifest):
intheory t

theorem t: p() -> q()
proof
  @b |
    assume p() {
      @b2 |
        assume q() {
          @x |
            q()
            [by hypothesis b2]
        }
    }
  @conc |
    p() -> q()
    [by discharge b]
qed
