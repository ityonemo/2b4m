// simplify: the certificate-producing rewrite tactic. One step replaces the
// refl/forall_elim/rewrite chains that used to take a dozen lines — and the
// kernel still checks every synthesized step.
sort Nat
const ZERO: Nat
func succ(n: Nat): Nat
func add(a: Nat, b: Nat): Nat
func mul(a: Nat, b: Nat): Nat
const ONE: Nat
axiom addZeroLeft: forall b: Nat; add(ZERO, b) = b
axiom addSuccLeft: forall a, b: Nat; add(succ(a), b) = succ(add(a, b))
axiom mulZeroLeft: forall b: Nat; mul(ZERO, b) = ZERO
axiom mulSuccLeft: forall a, b: Nat; mul(succ(a), b) = add(mul(a, b), b)
axiom oneIsSuccZero: ONE = succ(ZERO)

// ground arithmetic computes: 2 + 1 = 3, by unfolding the recursion axioms
theorem twoPlusOne: add(succ(succ(ZERO)), succ(ZERO)) = succ(succ(succ(ZERO)))
proof
  @conclusion |
    add(succ(succ(ZERO)), succ(ZERO)) = succ(succ(succ(ZERO)))
    [using simplify addSuccLeft addZeroLeft]
qed

// the entire mulOneLeft proof chain, in one step
theorem oneTimes: forall n: Nat; mul(ONE, n) = n
proof
  @generalize-n |
    fix n: Nat {
      @collapsed |
        mul(ONE, n) = n
        [using simplify oneIsSuccZero mulSuccLeft mulZeroLeft addZeroLeft]
    }
  @conclusion |
    forall n: Nat; mul(ONE, n) = n
    [by forall_intro generalize-n]
qed
