// GUARDRAIL: a transparent (`define`d) symbol cannot be a model mapping SOURCE.
// A define IS its body, so it rides along on the primitive symbols in that body
// (which the model maps). Nominally remapping the NAME would ignore the
// definition — definition-blind and unsound. The model must reject it and tell
// the writer to map the body's primitives instead. (The model is built only when
// cited, so a theorem cites it.)
import source <<< "model_source.b4m"

sort Thing
const ZED: Thing
func combine(a: Thing, b: Thing) => Thing
axiom combineZedLeft: forall a: Thing; combine(ZED, a) = a

// source.TWICE is transparent — it IS op(UNIT, UNIT), not an opaque symbol.
model ThingModel {
  source.Sort: Thing
  source.UNIT: ZED
  source.op: combine
  source.TWICE: ZED
  source.opUnitLeft <- combineZedLeft
}

theorem combineZedLeftTwice: forall a: Thing; combine(ZED, combine(ZED, a)) = combine(ZED, a)
proof
  @conclusion |
    forall a: Thing; combine(ZED, combine(ZED, a)) = combine(ZED, a)
    [using model(ThingModel) source.opUnitLeftTwice]
qed
