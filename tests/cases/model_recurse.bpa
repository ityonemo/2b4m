// `model` strict materialization with a DEPENDENCY WALK: transferring
// opUnitLeftThrice (whose proof cites opUnitLeftTwice) forces the materializer to
// recurse into opUnitLeftTwice and emit it too — memoized, so transferring BOTH
// here materializes the shared opUnitLeftTwice only once. Kernel-checked (default
// mode), no taint.
import source <<< "model_source.bpa"

sort Thing
const ZED: Thing
func combine(a: Thing, b: Thing): Thing
axiom combineZedLeft: forall a: Thing; combine(ZED, a) = a

model ThingModel {
  source.Sort: Thing
  source.UNIT: ZED
  source.op: combine
  source.opUnitLeft <- combineZedLeft
  }

theorem combineZedLeftTwice: forall a: Thing; combine(ZED, combine(ZED, a)) = combine(ZED, a)
proof
  @conclusion |
    forall a: Thing; combine(ZED, combine(ZED, a)) = combine(ZED, a)
    [using model(ThingModel) source.opUnitLeftTwice]
qed

theorem combineZedLeftThrice: forall a: Thing; combine(ZED, combine(ZED, combine(ZED, a))) = combine(ZED, a)
proof
  @conclusion |
    forall a: Thing; combine(ZED, combine(ZED, combine(ZED, a))) = combine(ZED, a)
    [using model(ThingModel) source.opUnitLeftThrice]
qed
