// SCHEMA transfer through a guarded `model`. `Number` has ZED/next, and `good`
// is the guarded subset that models the source's Elem. The source's induction
// SCHEMA (elemInduction) is transferred onto the guarded subset — discharged by
// a locally-declared, guard-relativized schema `goodInduction` (whose statement
// is exactly the `good(...) ->`-relativized remap of elemInduction's body). The
// model records the schema discharge like any axiom obligation; a downstream
// [using model(...) source.elemInduction] resolves through it, untainted.
import source <<< "model_schema_source.b4m"

sort Number
const ZED: Number
func next(n: Number) => Number
pred good(x: Number)

sort NumberGood = Number where good

// the guard-relativized induction schema — the discharge for elemInduction. Its
// body is elemInduction's, remapped ZE->ZED, step->next, Elem-binders guarded by
// good(...). Posited here (an axiom discharge; a proven theorem-schema would also
// be accepted by the model).
axiom goodInduction(prop: Number -> Prop):
  prop(ZED)
  -> (forall k: Number; good(k) -> prop(k) -> prop(next(k)))
  -> forall n: Number; good(n) -> prop(n)

model NumberModel {
  source.Elem: NumberGood
  source.ZE: ZED
  source.step: next
  source.elemInduction <- goodInduction
}

// the payoff: cite the transferred schema. Its statement is goodInduction's — the
// guard-relativized remap of source.elemInduction. Transfer resolves through the
// model's schema discharge (stmt_map), kernel-clean.
theorem numberInductionTransferred(prop: Number -> Prop):
  prop(ZED)
  -> (forall k: Number; good(k) -> prop(k) -> prop(next(k)))
  -> forall n: Number; good(n) -> prop(n)
proof
  @conclusion |
    prop(ZED)
      -> (forall k: Number; good(k) -> prop(k) -> prop(next(k)))
      -> forall n: Number; good(n) -> prop(n)
    [using model(NumberModel) source.elemInduction]
qed

// the payoff is only real once the transferring schema is INSTANTIATED: its body's
// `[using model(...) source.elemInduction]` step is then the discharging schema
// (goodInduction) instantiated at the same argument, kernel-checked against the claim.
theorem goodInductionInstance:
  good(ZED)
  -> (forall k: Number; good(k) -> good(k) -> good(next(k)))
  -> forall n: Number; good(n) -> good(n)
proof
  @conclusion |
    good(ZED)
      -> (forall k: Number; good(k) -> good(k) -> good(next(k)))
      -> forall n: Number; good(n) -> good(n)
    [using instantiation numberInductionTransferred(fun n: Number => good(n))]
qed
