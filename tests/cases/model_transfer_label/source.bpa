// The SOURCE theory for the transfer-label gate. Its theorem rests on an axiom the
// importing model does NOT discharge, so the transfer cannot succeed — the point is what
// the REJECTION says, not that it happens.
sort SrcVal
const SRCE: SrcVal
func scomb(a: SrcVal, b: SrcVal) => SrcVal

axiom srcIdentityRight: forall x: SrcVal; scomb(x, SRCE) = x

theorem srcPlain: forall x: SrcVal; scomb(x, SRCE) = x
proof
  @conclusion |
    forall x: SrcVal; scomb(x, SRCE) = x
    [by cite srcIdentityRight]
qed
