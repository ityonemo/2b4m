// A model TRANSFER re-proves the source theorem with every global redirected through the
// overlay, so its claims are in TARGET terms while a fact the model does not map stays in
// SOURCE terms. A rejection then compares two vocabularies, at a line in the SOURCE file
// the reader never wrote. The `Model@theorem` prefix is the only thing that makes that
// legible — this gate pins it.
import source <<< "source.bpa"
import group <<< "std/group.bpa"

sort Grp = group.Grp
const E = group.E
func op = group.op

model M {
  source.SrcVal: Grp
  source.SRCE: E
  source.scomb: op
}

theorem transferred: forall x: Grp; op(x, E) = x
proof
  @conclusion |
    forall x: Grp; op(x, E) = x
    [using model(M) source.srcPlain]
qed
