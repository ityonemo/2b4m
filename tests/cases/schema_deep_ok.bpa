// a terminating chain of 10 distinct schema instantiations (s1's proof
// instantiates s2, ..., s9 instantiates s10, s10 proves directly). The old
// inst_depth >= 8 cap wrongly rejected this; with real cycle detection it
// passes (no schema appears in its own chain).
pred base

theorem s1(q: Prop): q -> q
proof
  @conclusion |
    q -> q
    [using instantiation s2(q)]
qed

theorem s2(q: Prop): q -> q
proof
  @conclusion |
    q -> q
    [using instantiation s3(q)]
qed

theorem s3(q: Prop): q -> q
proof
  @conclusion |
    q -> q
    [using instantiation s4(q)]
qed

theorem s4(q: Prop): q -> q
proof
  @conclusion |
    q -> q
    [using instantiation s5(q)]
qed

theorem s5(q: Prop): q -> q
proof
  @conclusion |
    q -> q
    [using instantiation s6(q)]
qed

theorem s6(q: Prop): q -> q
proof
  @conclusion |
    q -> q
    [using instantiation s7(q)]
qed

theorem s7(q: Prop): q -> q
proof
  @conclusion |
    q -> q
    [using instantiation s8(q)]
qed

theorem s8(q: Prop): q -> q
proof
  @conclusion |
    q -> q
    [using instantiation s9(q)]
qed

theorem s9(q: Prop): q -> q
proof
  @conclusion |
    q -> q
    [using instantiation s10(q)]
qed

theorem s10(q: Prop): q -> q
proof
  @h |
    assume q {
      @hh |
        q
        [by hypothesis h]
    }
  @conclusion |
    q -> q
    [by implies_intro h]
qed

theorem trigger: base -> base
proof
  @conclusion |
    base -> base
    [using instantiation s1(base)]
qed
