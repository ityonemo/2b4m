// MODEL TRANSFER OF AN ACCELERANT-USING THEOREM — `assoc` (GUARDED model).
//
// A source theorem proved with `assoc` (a single-operator reassociation) is
// transferred through a GUARDED model (sort restricted to `good`). The
// transfer must materialize a MODEL-MANGLED, relativized synthetic rewrite chain
// for the `assoc` step.
//
// The accelerant builds its synthetic in SOURCE space; the instance ProveTask adopts the
// model and injects the target sort's guard on each value param (the parent model's `good`),
// the call site discharges it. The transferred cert is a source proof relativized under the
// model, so — exactly like a hand-written transfer — the model must NOMINATE closure
// dischargers (`C: TC(baseFact)`, `f: tf -| closureFact`) for the guard to close.

sort Src
func op(a: Src, b: Src) => Src
axiom opAssoc: forall a, b, c: Src; op(op(a, b), c) = op(a, op(b, c))

// proved with `assoc` — a deeper right-nesting.
theorem reassociate: forall a, b, c, d: Src;
  op(op(op(a, b), c), d) = op(a, op(b, op(c, d)))
proof
  @conclusion |
    forall a, b, c, d: Src; op(op(op(a, b), c), d) = op(a, op(b, op(c, d)))
    [using assoc_quantified(opAssoc)]
qed

// a concrete sort with a membership guard `good`.
sort Tgt
func top(a: Tgt, b: Tgt) => Tgt
pred good(x: Tgt)
sort GoodTgt = Tgt where good
// closure of the guard, so the ONLY remaining transfer failure is the accelerant.
axiom goodClosed: forall a, b: Tgt; good(a) -> good(b) -> good(top(a, b))
axiom topAssoc: forall a, b, c: Tgt; top(top(a, b), c) = top(a, top(b, c))

model SrcIsGood {
  Src: GoodTgt
  op: top -| goodClosed
  opAssoc <- topAssoc
}

theorem transferred: forall a, b, c, d: GoodTgt;
  top(top(top(a, b), c), d) = top(a, top(b, top(c, d)))
proof
  @conclusion |
    forall a, b, c, d: GoodTgt; top(top(top(a, b), c), d) = top(a, top(b, top(c, d)))
    [using model(SrcIsGood) reassociate]
qed
