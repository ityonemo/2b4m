import base <<< "model_import_cite_base.b4m"

sort S = base.S
const U = base.U
func op = base.op

// cites base's theorem through the `import(I)` accelerant word (not a bare `by cite`).
theorem unitThrice: op(U, op(U, U)) = U
proof
  @twice |
    op(U, U) = U
    [using import(base) unitTwice]
  @conclusion |
    op(U, op(U, U)) = U
    [by rewrite twice twice]
qed
