// EXPECTED TO FAIL under --library: an `axiom` after the first proof. A library file's
// header is its interface — what it assumes and what it promises — so the assumption
// surface must be declared before any of it is used.
//
// Checked only under `--library` (a published library's structure) and only for `.b4m`
// files: a literate `.md` is a document whose prose drives its order.
sort Nat
const ZERO: Nat
oper succ(n: Nat) => Nat
axiom succNotZero: forall n: Nat; succ(n) != ZERO

intheory first
intheory second

theorem first: succ(ZERO) != ZERO
proof
  @conclusion |
    succ(ZERO) != ZERO
    [using specialize succNotZero(ZERO)]
qed

// the violation: an assumption declared after the proofs have started
axiom lateAssumption: forall n: Nat; succ(succ(n)) != ZERO

theorem second: succ(succ(ZERO)) != ZERO
proof
  @conclusion |
    succ(succ(ZERO)) != ZERO
    [using specialize lateAssumption(ZERO)]
qed
