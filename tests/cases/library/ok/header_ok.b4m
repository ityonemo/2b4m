// The same file with its assumption surface in the header: everything the file assumes
// (`axiom`) and promises (`intheory`) is declared before the first proof. Vocabulary —
// sorts, opers, consts, preds, defines, `fact` aliases — stays legal anywhere.
sort Nat
const ZERO: Nat
oper succ(n: Nat) => Nat
axiom succNotZero: forall n: Nat; succ(n) != ZERO
axiom succSuccNotZero: forall n: Nat; succ(succ(n)) != ZERO

intheory first
intheory second

theorem first: succ(ZERO) != ZERO
proof
  @conclusion |
    succ(ZERO) != ZERO
    [using specialize succNotZero(ZERO)]
qed

// vocabulary after a proof is fine — it adds no assumption and no promise
oper twice(n: Nat) => Nat

theorem second: succ(succ(ZERO)) != ZERO
proof
  @conclusion |
    succ(succ(ZERO)) != ZERO
    [using specialize succSuccNotZero(ZERO)]
qed
