// GUARD: `iff_intro` requires a biconditional-shape goal. Applying it to a
// plain conjunction `A and B` (not two mutual implications) is a mistake — that
// is `and_intro`'s job.

pred A
pred B
axiom haveA: A
axiom haveB: B

theorem plainConjunction: A and B
proof
  @the-a | A [by cite haveA]
  @the-b | B [by cite haveB]
  @conclusion | A and B [by iff_intro the-a the-b]
qed
