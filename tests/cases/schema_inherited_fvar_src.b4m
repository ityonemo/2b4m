// the SOURCE schema for schema_inherited_fvar.b4m: its proof uses `tautology` over the
// generator param `prop`. When the schema is instantiated at a lambda that CAPTURES a
// variable from the instantiating proof (`fun j => nonneg(f(j, b))`, `b` an enclosing
// `fix`), the monomorphized body carries that free `b` — and the accelerant must bind it
// at the call site, exactly as `specialize` does (Synthetic.fvar_binds).
sort Int
pred nonneg(x: Int)
axiom trivial: forall q: Int; nonneg(q)
theorem schemaWithTautology(prop(Int)):
  (forall n: Int; nonneg(n) -> prop(n)) -> forall n: Int; nonneg(n) -> prop(n)
proof
  @given |
    assume forall n: Int; nonneg(n) -> prop(n) {
      @all-holds |
        forall n: Int; nonneg(n) -> prop(n)
        [by hypothesis given]
      @generalize-n |
        fix n: Int {
          @at-n |
            nonneg(n) -> prop(n)
            [by apply_at(n) all-holds]
          @n-nonneg |
            nonneg(n)
            [using specialize trivial(n)]
          @prop-n |
            prop(n)
            [using tautology at-n n-nonneg]
          @conclusion-implies |
            nonneg(n) -> prop(n)
            [using tautology prop-n]
        }
      @conclusion-inner |
        forall n: Int; nonneg(n) -> prop(n)
        [by generalize generalize-n]
    }
  @conclusion |
    (forall n: Int; nonneg(n) -> prop(n)) -> forall n: Int; nonneg(n) -> prop(n)
    [by discharge given]
qed
