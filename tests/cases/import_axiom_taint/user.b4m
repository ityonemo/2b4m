// The consumer: `viaImport` rests on lib's `pZero` through an `import(lib)` citation,
// exactly as it would through `[by cite lib.pZero]`. The `--axioms` report must list
// it, and `--library` over this directory must count it as used.
import lib <<< "lib.b4m"
sort Nat = lib.Nat
const ZERO = lib.ZERO
pred p = lib.p

theorem viaImport: p(ZERO)
proof
  @conclusion |
    p(ZERO)
    [using import(lib) pZero]
qed
