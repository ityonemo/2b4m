// `iff_rewrite` — the propositional analogue of `=`-rewrite. From a
// biconditional `P iff Q` (desugared to `(P -> Q) and (Q -> P)`) and a target,
// it replaces the sub-PROPOSITION P by Q at ANY position (subformula
// congruence, under connectives and quantifiers), reusing the same congruence
// walker `=`-rewrite uses. It is a kernel-checked proof rule — NOT an accelerant
// (no --fast taint) — sound because `iff` is a full congruence in classical FOL.

sort S
pred P
pred Q
pred R
pred W(x: S)

// (1) whole-goal rewrite: from P and `P iff Q`, derive Q.
theorem wholeGoal: P -> (P iff Q) -> Q
proof
  @given-p |
    assume P {
      @given-iff |
        assume P iff Q {
          @the-p | P [by hypothesis given-p]
          @the-iff | P iff Q [by hypothesis given-iff]
          @q | Q [by iff_rewrite the-iff the-p]
        }
      @iff-gives-q | (P iff Q) -> Q [by implies_intro given-iff]
    }
  @conclusion | P -> (P iff Q) -> Q [by implies_intro given-p]
qed

// (2) under a connective: from `R and P` and `P iff Q`, derive `R and Q` —
// P is rewritten in place inside the conjunction.
theorem underConnective: (R and P) -> (P iff Q) -> (R and Q)
proof
  @given-r-and-p |
    assume R and P {
      @given-iff |
        assume P iff Q {
          @the-r-and-p | R and P [by hypothesis given-r-and-p]
          @the-iff | P iff Q [by hypothesis given-iff]
          @r-and-q | R and Q [by iff_rewrite the-iff the-r-and-p]
        }
      @iff-gives-r-and-q | (P iff Q) -> (R and Q) [by implies_intro given-iff]
    }
  @conclusion | (R and P) -> (P iff Q) -> (R and Q) [by implies_intro given-r-and-p]
qed

// (3) under a QUANTIFIER: rewrite the closed atom P where it appears inside a
// `forall x; W(x) -> P` — congruence descending under a binder.
theorem underQuantifier: (forall x: S; W(x) -> P) -> (P iff Q) -> (forall x: S; W(x) -> Q)
proof
  @given-all |
    assume forall x: S; W(x) -> P {
      @given-iff |
        assume P iff Q {
          @the-all | forall x: S; W(x) -> P [by hypothesis given-all]
          @the-iff | P iff Q [by hypothesis given-iff]
          @all-q | forall x: S; W(x) -> Q [by iff_rewrite the-iff the-all]
        }
      @iff-gives-all-q | (P iff Q) -> (forall x: S; W(x) -> Q) [by implies_intro given-iff]
    }
  @conclusion | (forall x: S; W(x) -> P) -> (P iff Q) -> (forall x: S; W(x) -> Q) [by implies_intro given-all]
qed
