// ac_quantified: peel the forall prefix, run the ac core on the equation
// body, close with forall_intro. Handles both add and mul (same operator
// detection as bare ac). Replaces the hand-written fix-block tower.
import peano <<< "std/peano.b4m"

sort Nat = peano.Nat
func mul = peano.mul
func add = peano.add
theorem mulIsAssociative = peano.mulIsAssociative
theorem mulIsCommutative = peano.mulIsCommutative
theorem mulLeftSwap = peano.mulLeftSwap
theorem addIsAssociative = peano.addIsAssociative
theorem addIsCommutative = peano.addIsCommutative
theorem addLeftSwap = peano.addLeftSwap

theorem productReorders: forall a, b, c: Nat; mul(mul(a, b), c) = mul(c, mul(b, a))
proof
  @conclusion |
    forall a, b, c: Nat; mul(mul(a, b), c) = mul(c, mul(b, a))
    [using assoc_commut_quantified]
qed

theorem sumReorders: forall a, b, c: Nat; add(add(a, b), c) = add(c, add(b, a))
proof
  @conclusion |
    forall a, b, c: Nat; add(add(a, b), c) = add(c, add(b, a))
    [using assoc_commut_quantified]
qed
