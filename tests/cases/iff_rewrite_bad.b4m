// `iff_rewrite` is SOUND: the claim must actually be reachable from the target
// by replacing P with Q. Here `R` is unrelated to `P`/`Q`, so the rewrite cannot
// produce it — rejected.

pred P
pred Q
pred R

theorem bogus: P -> (P iff Q) -> R
proof
  @given-p |
    assume P {
      @given-iff |
        assume P iff Q {
          @the-p | P [by hypothesis given-p]
          @the-iff | P iff Q [by hypothesis given-iff]
          @r | R [by iff_rewrite the-iff the-p]
        }
      @iff-gives-r | (P iff Q) -> R [by implies_intro given-iff]
    }
  @conclusion | P -> (P iff Q) -> R [by implies_intro given-p]
qed
