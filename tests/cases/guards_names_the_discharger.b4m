// `guards(<step>, …)` names the step that discharges a GUARDED-SORT obligation, instead
// of leaving it to be found among whatever the proof happens to know.
//
// `permFixesPoint` binds `forall f: Perm`, and `sort Perm = Fn where invertible`, so
// applying it at the plain `Fn` `g` owes `invertible(g)`. That obligation does NOT appear
// in the fact's `->` chain — it comes from the BINDER's sort refinement — so it has no
// position among the trailing hyp refs, and gets its own slot.
//
// Naming it puts the citation in the proof text, where both checking modes see it: strict
// finds it while building the certificate, and `--fast` (which builds none, so searches
// for nothing) still credits the step. Hence this file is gated BOTH ways, unlike
// guarded_sort_obligation_root.b4m, which leaves the slot empty and is strict-only.
sort Element
sort Fn
pred invertible(f: Fn)
sort Perm = Fn where invertible
func apply(f: Fn, x: Element) => Element
const point: Element

axiom permFixesPoint: forall f: Perm; apply(f, point) = point

theorem aNamedDischargerIsCredited: forall g: Fn; invertible(g) -> apply(g, point) = point
proof
  @generalize-g |
    fix g: Fn {
      @given-invertible |
        assume invertible(g) {
          @g-is-invertible |
            invertible(g)
            [by hypothesis given-invertible]
          @applied |
            apply(g, point) = point
            [using specialize permFixesPoint(g) guards(g-is-invertible)]
        }
      @conclusion-implication |
        invertible(g) -> apply(g, point) = point
        [by implies_intro given-invertible]
    }
  @conclusion |
    forall g: Fn; invertible(g) -> apply(g, point) = point
    [by forall_intro generalize-g]
qed
