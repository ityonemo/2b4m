// A model must map only the source theory's AXIOMS. A source THEOREM is derived,
// so it materializes automatically through the mapped axioms — mapping it
// explicitly is misusing `model`. Here `SourceModel` maps `src.leftUnit`, which is
// a THEOREM in the source theory, via a `:` symbol mapping.
//
// Under the demand prover a model is only built when it is CITED, so the theorem
// below transfers `src.leftUnit` through `SourceModel` — forcing the model to
// build and rejecting the malformed mapping (a fact cannot be a `:` symbol target).
import src <<< "model_maps_theorem_source.bpa"

sort Thing
const NEUTRAL: Thing
func combine(a: Thing, b: Thing) => Thing

axiom combineUnitAxiom: forall a: Thing; combine(NEUTRAL, a) = a

model SourceModel {
  src.Sort: Thing
  src.UNIT: NEUTRAL
  src.op: combine
  src.leftUnitAxiom <- combineUnitAxiom
  src.leftUnit: combineUnitAxiom
}

theorem combineLeftUnit: forall a: Thing; combine(NEUTRAL, a) = a
proof
  @conclusion |
    forall a: Thing; combine(NEUTRAL, a) = a
    [using model(SourceModel) src.leftUnit]
qed
