// Cooper certification with a NEGATIVE ℤ witness. `exists y; x = succ(y)` holds
// for every integer x — the witness is y = x - 1 = prev(x), which is negative
// when x ≤ 0. The engine is pure ℤ (no nonneg), so the existential is genuinely
// over all integers; the certifier builds the witness as a `prev`-tower and
// discharges the body via succPrev. (A ℕ theory could not certify this — succ is
// not surjective on ℕ — which is why the witness must be built with `prev`.)
import integer <<< "std/integer.bpa"
import order <<< "std/integer-order.bpa"
sort Int = integer.Int
const ZERO = integer.ZERO
const ONE = integer.ONE
func succ = integer.succ
func prev = integer.prev
func add = integer.add
func neg = integer.neg
pred less_than = order.less_than
axiom addZeroLeft = integer.addZeroLeft
axiom lessThanIntro = order.lessThanIntro
axiom succPrev = integer.succPrev
axiom prevSucc = integer.prevSucc

theorem hasPredecessor: forall x: Int; exists y: Int; x = succ(y)
proof
  @conclusion |
    forall x: Int; exists y: Int; x = succ(y)
    [using arithmetic]
qed
