// deliberately broken: the imported file does not exist. An import is READ only when
// something cites into it (uncited files never parse), so the citation below is what
// surfaces the missing file — reported at the import token that named it.
theory ghost <<< "nope.b4m"
sort T

// What this file proves (verified manifest):
intheory usesGhost

theorem usesGhost: forall x: T; x = x
proof
  @conclusion |
    forall x: T; x = x
    [using import(ghost) reflexive]
qed
