// cycle_a and cycle_b import each other — cyclic file imports are ALLOWED (no proof cycle).
// Each file both IMPORTS the other and USES what it imports: an uncited import and an unused
// alias are each an error now (parser.zig `unused_imports` / `unused_aliases`), and a cycle
// only means anything when the files really do reference across it.
import b <<< "cycle_b.b4m"
sort A
sort BHere = b.B
const Here: BHere
