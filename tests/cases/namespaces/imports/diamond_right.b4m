// the other side of the diamond: re-exports a different selection.
//
// It also PROVES something about what it re-exports, rather than only forwarding. A file that
// is nothing but aliases is an antipattern — identity is by origin (`alias-collapse`), so a
// pure façade just gives consumers a second name for the same entity — and the unused-alias
// check now says so. Here the theorem below is what uses `NIL`; `diamond.b4m` then cites
// `right.NIL` across the re-export hop, which is the property under test.
import lib <<< "lib.b4m"
const NIL = lib.NIL

theorem nilIsStillGood: lib.good(NIL)
proof
  @conclusion |
    lib.good(NIL)
    [by cite lib.nilIsGood]
qed
