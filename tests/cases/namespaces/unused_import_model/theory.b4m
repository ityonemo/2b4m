// an abstract one-op theory, to be modeled by the consumer below.
sort Carrier
const UNIT: Carrier
func op(a: Carrier, b: Carrier) => Carrier
axiom unitLeft: forall a: Carrier; op(UNIT, a) = a
theorem unitLeftAgain: forall a: Carrier; op(UNIT, a) = a
proof
  @conclusion |
    forall a: Carrier; op(UNIT, a) = a
    [by cite unitLeft]
qed
