// REGRESSION FIXTURE for the unused-import check (parser.zig `unused_imports`).
// The ONLY mention of `theory` in this file is inside the `model` block below — no `theory.x`
// appears anywhere else, and there is no `using import(theory) …` citation. In the corpus six
// imports are used exactly this way (4 of them under std/), so if a future change stops
// counting a model block's `src.name` qualifier as a use, this file starts failing and says so.
import theory <<< "theory.b4m"

sort T
const Z: T
func add(a: T, b: T) => T
axiom addZeroLeft: forall a: T; add(Z, a) = a

model AsOneOpTheory {
  theory.Carrier: T
  theory.UNIT: Z
  theory.op: add
  theory.unitLeft <- addZeroLeft
}

theorem zeroIsLeftNeutral: forall a: T; add(Z, a) = a
proof
  @conclusion |
    forall a: T; add(Z, a) = a
    [using model(AsOneOpTheory) theory.unitLeftAgain]
qed
