// REGRESSION FIXTURE for the unused-import check (parser.zig `unused_imports`).
// The ONLY mention of `abstract` in this file is inside the `model` block below — no other
// `abstract.x` appears, and there is no `using import(abstract) …` citation. In the corpus six
// theory declarations are used exactly this way (4 under std/), so if a future change stops
// counting a model block's `src.name` qualifier as a use, this file starts failing and says so.
theory abstract <<< "theory.b4m"

sort T
const Z: T
oper add(a: T, b: T) => T
axiom addZeroLeft: forall a: T; add(Z, a) = a

model AsOneOpTheory {
  abstract.Carrier: T
  abstract.UNIT: Z
  abstract.op: add
  abstract.unitLeft <- addZeroLeft
}

theorem zeroIsLeftNeutral: forall a: T; add(Z, a) = a
proof
  @conclusion |
    forall a: T; add(Z, a) = a
    [using model(AsOneOpTheory) abstract.unitLeftAgain]
qed
