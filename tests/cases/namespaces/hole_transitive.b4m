// citing a hole-tainted theorem inherits the hole: this file has no `hole` of
// its own, but rests on hole.b4m's zeroIsEven through restsOnHole.
theory h <<< "hole.b4m"
sort Nat = h.Nat
const ZERO = h.ZERO
pred even = h.even
fact restsOnHole = h.restsOnHole

// What this file proves (verified manifest):
intheory transitiveHole

theorem transitiveHole: even(ZERO)
proof
  @c |
    even(ZERO)
    [by cite restsOnHole]
qed
