// A library whose ONLY consumer cites its axiom through `[using import(I) ax]` — the
// accelerant-shaped cross-file citation. Nothing here rests on `pZero` itself, so
// the `--library` sweep and the consumer's `--axioms` report both depend on the
// import citation recording the axiom.
sort Nat
const ZERO: Nat
pred p(n: Nat)
axiom pZero: p(ZERO)
