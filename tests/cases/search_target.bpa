// fixture for `bpa query search` — a small, stable set of theorems/axioms so
// the search golden doesn't shift as std grows. `search <thisfile> cancel`
// ranks the name-matching lemma first.
sort Nat
const ZERO: Nat
func add(a: Nat, b: Nat): Nat
func mul(a: Nat, b: Nat): Nat

axiom addComm: forall a, b: Nat; add(a, b) = add(b, a)
axiom mulComm: forall a, b: Nat; mul(a, b) = mul(b, a)

// the axiom the theorem cites; its NAME also contains "cancel"
axiom cancelAxiom: forall c, a, b: Nat; add(c, a) = add(c, b) -> a = b

// a theorem whose NAME contains "cancel"
theorem addCancelLeft: forall c, a, b: Nat; add(c, a) = add(c, b) -> a = b
proof
  @conclusion |
    forall c, a, b: Nat; add(c, a) = add(c, b) -> a = b
    [by cite cancelAxiom]
qed
