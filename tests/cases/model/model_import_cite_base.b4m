// A source theory in TWO files: this one states the algebra; model_import_cite_mid.b4m proves a
// theorem citing this file's theorem with `[using import(base) unitTwice]`.
sort S
const U: S
oper op(a: S, b: S) => S
axiom opUnitLeft: forall a: S; op(U, a) = a

// What this file proves (verified manifest):
intheory unitTwice

theorem unitTwice: op(U, U) = U
proof
  @conclusion |
    op(U, U) = U
    [using specialize opUnitLeft(U)]
qed
