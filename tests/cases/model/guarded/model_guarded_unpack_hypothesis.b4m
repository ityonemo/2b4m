// REGRESSION: a GUARDED model must transfer a theorem whose proof restates an UNPACK block's
// opened body with `[by hypothesis]`. A relativized `∃x: H` opens as `inH(w) and <body>`, so
// that restatement has to and_elim past the guard conjunct. `refForKnown` already did this for
// a known prop, but `projectBlockGuard` — the path an EXPLICIT `[by hypothesis]` takes — only
// handled `.fix` and `.assume` blocks and returned null for `.unpack`. Every ℤ-order theorem
// citing `lessThanElim` broke on it (std/integer/order.b4m:802).
theory src <<< "model_guarded_unpack_hypothesis_src.b4m"

sort Carrier
pred inCut(x: Carrier)
pred okT(x: Carrier)
pred PT(x: Carrier)
pred GoalT(x: Carrier)

sort Cut = Carrier where inCut

axiom bodyExistsT: forall a: Carrier; okT(a) ->
  (exists w: Carrier; inCut(w) and (okT(w) and PT(w)))
axiom bodyGivesGoalT: forall a, w: Carrier; PT(w) -> GoalT(a)

model GuardedUnpack {
  src.Src: Cut
  src.ok: okT
  src.P: PT
  src.Goal: GoalT
  src.bodyExists <- bodyExistsT
  src.bodyGivesGoal <- bodyGivesGoalT
}

// What this file proves (verified manifest):
intheory transferred

theorem transferred: forall a: Carrier; inCut(a) -> okT(a) -> GoalT(a)
proof
  @conclusion |
    forall a: Carrier; inCut(a) -> okT(a) -> GoalT(a)
    [using model(GuardedUnpack) src.reached]
qed
