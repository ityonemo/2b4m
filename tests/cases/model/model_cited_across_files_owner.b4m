// The file that DECLARES the model (and deliberately proves NOTHING off it, so the consumer
// cannot be getting its result by aliasing a theorem).
import abstract <<< "model_cited_across_files.b4m"

sort Num
const ZED: Num
func plus(a: Num, b: Num) => Num
axiom plusZedLeft: forall a: Num; plus(ZED, a) = a

model NumCarrier {
  abstract.Carrier: Num
  abstract.UNIT: ZED
  abstract.combine: plus
  abstract.combineUnitLeft <- plusZedLeft
}
