// A THIRD file citing the owner's model by qualified name. The owner proves nothing off
// `NumCarrier`, so this result exists only because the model itself crossed the boundary.
theory owner <<< "model_cited_across_files_owner.b4m"
theory abstract <<< "model_cited_across_files.b4m"

sort Num = owner.Num
const ZED = owner.ZED
oper plus = owner.plus

// What this file proves (verified manifest):
intheory zedIsNeutral

theorem zedIsNeutral: forall a: Num; plus(ZED, a) = a
proof
  @conclusion |
    forall a: Num; plus(ZED, a) = a
    [using model(owner.NumCarrier) abstract.unitIsNeutral]
qed
