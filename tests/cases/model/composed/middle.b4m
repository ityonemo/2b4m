// LAYER 2: a concrete sort modelling layer 1, re-exporting its theorem as a TRANSFER.
// The transferred proof is what layer 3 will cite, so layer 3 must discharge whatever
// THIS proof reaches, not only what its statement mentions.
theory inner <<< "inner.b4m"

sort Mid
const MZ: Mid
oper mop(a: Mid, b: Mid) => Mid
axiom mopUnitLeft: forall a: Mid; mop(MZ, a) = a
axiom mopAssoc: forall a, b, c: Mid; mop(mop(a, b), c) = mop(a, mop(b, c))

intheory midNeedsAssoc

model MidIsBase {
  inner.Base: Mid
  inner.Z: MZ
  inner.op: mop
  inner.opUnitLeft <- mopUnitLeft
  inner.opAssoc <- mopAssoc
}

theorem midNeedsAssoc: forall a, b: Mid; mop(mop(MZ, a), b) = mop(a, b)
proof
  @conclusion |
    forall a, b: Mid; mop(mop(MZ, a), b) = mop(a, b)
    [using model(MidIsBase) inner.needsAssoc]
qed
