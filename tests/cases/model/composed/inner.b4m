// LAYER 1: the abstract theory, with a theorem proved over its own axioms.
sort Base
const Z: Base
oper op(a: Base, b: Base) => Base
axiom opUnitLeft: forall a: Base; op(Z, a) = a
axiom opAssoc: forall a, b, c: Base; op(op(a, b), c) = op(a, op(b, c))

intheory needsAssoc

// uses BOTH axioms: associativity to regroup, then the unit law
theorem needsAssoc: forall a, b: Base; op(op(Z, a), b) = op(a, b)
proof
  @generalize-a |
    fix a: Base {
      @generalize-b |
        fix b: Base {
          @regroup |
            op(op(Z, a), b) = op(Z, op(a, b))
            [using specialize opAssoc(Z, a, b)]
          @drop-unit |
            op(Z, op(a, b)) = op(a, b)
            [using specialize opUnitLeft(op(a, b))]
          @conclusion-at-a-b |
            op(op(Z, a), b) = op(a, b)
            [using chain regroup drop-unit]
        }
      @discharge-b |
        forall b: Base; op(op(Z, a), b) = op(a, b)
        [by generalize generalize-b]
    }
  @conclusion |
    forall a, b: Base; op(op(Z, a), b) = op(a, b)
    [by generalize generalize-a]
qed
