// REJECTION: a definitional discharge pairs clauses ARM FOR ARM, so the two definitions
// must have the same number of them. Here `madd` defines one clause against `base.nadd`'s
// two, so there is no pairing to make.
import base <<< "model_definition_source.b4m"

sort M
const MZ: M
func msucc(a: M) => M

func madd(a: M, b: M) => M:
  madd(MZ, b) = b

model Mod {
  base.N: M
  base.NZ: MZ
  base.nsucc: msucc
  base.nadd: madd
  base.nadd <- madd
}

theorem theZeroArmTransfers: forall b: M; madd(MZ, b) = b
proof
  @conclusion |
    forall b: M; madd(MZ, b) = b
    [using model(Mod) base.addAtZero]
qed
