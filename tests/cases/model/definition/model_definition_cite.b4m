// CITING a source definition clause through a model: `[using model(M) definition(N) src.f]`.
//
// The other direction from `model_definition_discharge.b4m`. There, a local definition
// DISCHARGES the source's clause set and the local clause is what the proof rests on. Here
// `tdbl` is an opaque `func` with no clauses, so nothing overloads the source's — the only
// route to the equation is to cite the source clause itself, interpreted through the model.
//
// Since nothing local replaces it, the source clause IS an assumption this file inherits,
// and `--axioms` reports it (as a DEFINITION, from the source's file). That is the honest
// reading rather than a loophole.
theory base <<< "model_definition_source.b4m"

sort M
const MZ: M
oper msucc(a: M) => M
oper madd(a: M, b: M) => M

model Mod {
  base.N: M
  base.NZ: MZ
  base.nsucc: msucc
  base.nadd: madd
}

// What this file proves (verified manifest):
intheory theZeroClauseTransfers
intheory theStepClauseTransfers

theorem theZeroClauseTransfers: forall b: M; madd(MZ, b) = b
proof
  @conclusion |
    forall b: M; madd(MZ, b) = b
    [using model(Mod) definition(0) base.nadd]
qed

theorem theStepClauseTransfers: forall b: M; forall k: M;
  madd(msucc(k), b) = msucc(madd(k, b))
proof
  @conclusion |
    forall b: M; forall k: M; madd(msucc(k), b) = msucc(madd(k, b))
    [using model(Mod) definition(1) base.nadd]
qed
