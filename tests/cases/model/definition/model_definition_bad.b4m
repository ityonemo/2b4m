// REJECTION: a definitional axiom is overloadable ONLY by a definition.
//
// `madd` here is a bare `func` with a separately-named axiom, so it cannot discharge
// `base.nadd`'s clause set — there are no arms to pair. The model is built only when
// CITED, so the theorem below forces it.
import base <<< "model_definition_source.b4m"

sort M
const MZ: M
oper msucc(a: M) => M
oper madd(a: M, b: M) => M
axiom maddAtZero: forall b: M; madd(MZ, b) = b

model Mod {
  base.N: M
  base.NZ: MZ
  base.nsucc: msucc
  base.nadd: madd
  base.nadd <- madd
}

theorem theZeroArmTransfers: forall b: M; madd(MZ, b) = b
proof
  @conclusion |
    forall b: M; madd(MZ, b) = b
    [using model(Mod) base.addAtZero]
qed
