// A source theory with a sort, one axiom, and TWO theorems proved from it: one PLAIN, one a
// SCHEMA over a predicate. Both proofs cite the same axiom the same way.
sort Elem
const SEED: Elem
pred marks(x: Elem)
axiom seedIsMarked: marks(SEED)

// PLAIN: transfers through a model today.
theorem somethingIsMarked: exists x: Elem; marks(x)
proof
  @seed-marked |
    marks(SEED)
    [by cite seedIsMarked]
  @conclusion |
    exists x: Elem; marks(x)
    [by witness(SEED) seed-marked]
qed

// SCHEMA: same shape, but the conclusion is about an arbitrary predicate. Its proof needs the
// hypothesis, so it still cites nothing but local facts.
theorem somethingHolds(prop(Elem)): prop(SEED) -> exists x: Elem; prop(x)
proof
  @given |
    assume prop(SEED) {
      @holds |
        prop(SEED)
        [by hypothesis given]
      @conclusion-witnessed |
        exists x: Elem; prop(x)
        [by witness(SEED) holds]
    }
  @conclusion |
    prop(SEED) -> exists x: Elem; prop(x)
    [by discharge given]
qed
