// A `[using model(M) ns.thm]` citation whose namespace `ns` appears NOWHERE ELSE in the file:
// mid re-exports base by alias only, so the model block maps base's entities and never names
// mid — yet mid.unitThrice must transfer. The import `mid` is demanded by the citation itself
// (racked and suspended on, like every other qualified reference), not looked up passively.
import mid <<< "model_alias_borrowed_mid.b4m"
import base <<< "model_alias_borrowed_base.b4m"

sort T
const Z: T
func add(a: T, b: T) => T
axiom addZeroLeft: forall a: T; add(Z, a) = a

model M {
  base.S: T
  base.U: Z
  base.op: add
  base.opUnitLeft <- addZeroLeft
}

theorem zeroThrice: add(Z, add(Z, Z)) = Z
proof
  @conclusion |
    add(Z, add(Z, Z)) = Z
    [using model(M) mid.unitThrice]
qed
