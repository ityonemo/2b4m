// A model is an OVERLAY over the whole universe, not scoped to one file. The block below
// names entities from THREE namespaces — top's, mid's and base's aliases are the same
// entities by origin — and transferring top.unitFourth must remap the BORROWED theorems
// down the alias chain: unitFourth cites mid's unitThrice (aliased in top), whose proof
// cites base's unitTwice (aliased in mid). Each is re-proved under the model in the file
// that declares it, rather than handing the transferred proof base's untransferred
// `op(U, U) = U` against a target-sort claim.
import top <<< "model_alias_borrowed_top.b4m"
import mid <<< "model_alias_borrowed_mid.b4m"
import base <<< "model_alias_borrowed_base.b4m"

sort T
const Z: T
func add(a: T, b: T) => T
axiom addZeroLeft: forall a: T; add(Z, a) = a

model M {
  top.S: T
  mid.U: Z
  base.op: add
  base.opUnitLeft <- addZeroLeft
}

theorem zeroFourth: add(Z, add(Z, add(Z, Z))) = Z
proof
  @conclusion |
    add(Z, add(Z, add(Z, Z))) = Z
    [using model(M) top.unitFourth]
qed

// one hop only, cited through the middle namespace
theorem zeroThrice: add(Z, add(Z, Z)) = Z
proof
  @conclusion |
    add(Z, add(Z, Z)) = Z
    [using model(M) mid.unitThrice]
qed
