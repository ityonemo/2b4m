// The overlay's CONSISTENCY condition: EVERY axiom a transferred proof transitively rests
// on must be discharged, wherever it was declared. This model maps the symbols but leaves
// base's `opUnitLeft` undischarged; top.unitFourth rests on it two alias hops down (through
// mid.unitThrice → base.unitTwice), so the transfer must be REJECTED, not let through.
import top <<< "model_alias_borrowed_top.b4m"
import base <<< "model_alias_borrowed_base.b4m"

sort T
const Z: T
func add(a: T, b: T) => T

model Undischarged {
  top.S: T
  top.U: Z
  top.op: add
}

theorem zeroFourth: add(Z, add(Z, add(Z, Z))) = Z
proof
  @conclusion |
    add(Z, add(Z, add(Z, Z))) = Z
    [using model(Undischarged) top.unitFourth]
qed
