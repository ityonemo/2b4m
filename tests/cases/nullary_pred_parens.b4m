// A PREDICATE always writes its parentheses — a zero-argument one included. One
// spelling serves all four positions, and this file exercises each:
//
//   declaration     pred base()
//   formula use     base() -> base()
//   schema param    theorem t(q()): …
//   schema argument [using instantiation t(base())]
//
// A nullary FUNC is the deliberate exception (its zero-arity form is `const`),
// so `nil` below applies bare. The rejected spellings are in
// nullary_pred_bare_bad.b4m.
sort Nat
func nil() => Nat
pred base()
pred other()

axiom baseImpliesOther: base() -> other()

// the parameter is used in the statement, in the proof, and passed onward
theorem selfImplication(q()): q() -> q()
proof
  @conclusion |
    q() -> q()
    [using tautology]
qed

theorem passesItsParameterOnward(q()): q() -> q()
proof
  @conclusion |
    q() -> q()
    [using instantiation selfImplication(q())]
qed

theorem aNullaryPredInstantiatesASchema: base() -> base()
proof
  @conclusion |
    base() -> base()
    [using instantiation passesItsParameterOnward(base())]
qed

// a nullary pred reaches the kernel as an ordinary atom
theorem aNullaryPredChainsThroughModusPonens: base() -> other()
proof
  @conclusion |
    base() -> other()
    [by cite baseImpliesOther]
qed

// the nullary FUNC exception: `nil` is const-shaped and applies bare
theorem aNullaryFuncAppliesBare: nil = nil
proof
  @conclusion |
    nil = nil
    [by reflexivity]
qed
