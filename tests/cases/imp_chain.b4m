// nested Fitch blocks: implies_intro discharges an assumption block
pred p
pred q
theorem impExample: p -> (q -> p)
proof
  @outer |
    assume p {
      @inner |
        assume q {
          // strategy: p is still in scope from the outer block
          @got-p |
            p
            [by hypothesis outer]
        }
      @qtop |
        q -> p
        [by implies_intro inner]
    }
  @done |
    p -> (q -> p)
    [by implies_intro outer]
qed
