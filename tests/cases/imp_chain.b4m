// nested Fitch blocks: discharge discharges an assumption block
pred p()
pred q()
theorem impExample: p() -> (q() -> p())
proof
  @outer |
    assume p() {
      @inner |
        assume q() {
          // strategy: p is still in scope from the outer block
          @got-p |
            p()
            [by hypothesis outer]
        }
      @qtop |
        q() -> p()
        [by discharge inner]
    }
  @done |
    p() -> (q() -> p())
    [by discharge outer]
qed
