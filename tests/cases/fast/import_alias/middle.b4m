// A re-exporting layer: `zeroIsBig` here is an ALIAS, so it has no stated formula of its own
// (identity-by-origin — std does this throughout, e.g. `theorem sqrtOne = sqrt_theory.sqrtOne`).
import origin <<< "origin.b4m"

sort Nat = origin.Nat
const ZERO = origin.ZERO
pred big = origin.big

fact zeroIsBig = origin.zeroIsBig
