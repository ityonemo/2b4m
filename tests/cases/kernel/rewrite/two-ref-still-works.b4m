// The TWO-ref form must keep working: rewriting inside an already-proved fact is a
// different move from congruence on a fresh claim, and both are wanted.
sort Thing
const A: Thing
const B: Thing
pred p(x: Thing)
axiom aIsB: A = B
axiom pOfA: p(A)

// What this file proves (verified manifest):
intheory rewriteInsideAFact

theorem rewriteInsideAFact: p(B)
proof
  @a-is-b |
    A = B
    [by cite aIsB]
  @p-of-a |
    p(A)
    [by cite pOfA]
  @conclusion |
    p(B)
    [by rewrite a-is-b p-of-a]
qed
