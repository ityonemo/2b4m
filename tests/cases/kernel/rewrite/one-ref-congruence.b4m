// `[by rewrite EQ]` with ONE ref: the target is the claim's own reflexive instance.
//
// Today congruence must be hand-rolled in two steps — a `t = t` proved by `reflexivity`
// purely so `rewrite` has something to rewrite IN, then the rewrite itself. That reflexive
// step asserts nothing; it is scaffolding, and a reader has to recognize it as such. 265 of
// std's 376 `reflexivity` steps exist only to serve a following `rewrite`.
//
// The two-ref form stays — rewriting inside an ALREADY-PROVED fact is a different move.
sort Thing
const A: Thing
const B: Thing
func f(x: Thing) => Thing
axiom aIsB: A = B

// what the one-ref form should prove in a single step
theorem congruence: f(A) = f(B)
proof
  @a-is-b |
    A = B
    [by cite aIsB]
  @conclusion |
    f(A) = f(B)
    [by rewrite a-is-b]
qed
