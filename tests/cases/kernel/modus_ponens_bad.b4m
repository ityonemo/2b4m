// deliberately broken: refs swapped — first ref must be the implication
pred p()
pred q()
axiom pHolds: p()
axiom pImpliesQ: p() -> q()

// What this file proves (verified manifest):
intheory qHolds

theorem qHolds: q()
proof
  @have-p |
    p()
    [by cite pHolds]
  @have-imp |
    p() -> q()
    [by cite pImpliesQ]
  @conc |
    q()
    [by modus_ponens have-p have-imp]
qed
