// GUARD: `both` is forbidden from producing a biconditional-shape goal
// `(X -> Y) and (Y -> X)` — that shape is canonically an iff, so it must be
// built with `make_equivalence`. This keeps the surface honest: a proof that concludes
// a biconditional says `iff`.

pred A()
pred B()
axiom aImpliesB: A() -> B()
axiom bImpliesA: B() -> A()

theorem handRolledBiconditional: (A() -> B()) and (B() -> A())
proof
  @forward-direction | A() -> B() [by cite aImpliesB]
  @backward-direction | B() -> A() [by cite bImpliesA]
  @conclusion | (A() -> B()) and (B() -> A()) [by both forward-direction backward-direction]
qed
