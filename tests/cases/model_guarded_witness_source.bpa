// Source for the EXISTENTIAL-WITNESS failure boundary. A sort with `op`,
// left-identity `UNIT`, and an existence axiom `something` (∃ x; …). A theorem
// unpacks that witness `w` and instantiates the identity axiom AT `w` — so a
// guarded transfer would owe `guard(w)`, which nothing establishes (the witness
// is not known to be in the guarded subset). This is the boundary case.
sort Sort
const UNIT: Sort
func op(a: Sort, b: Sort): Sort
pred marked(x: Sort)

axiom opUnitLeft: forall a: Sort; op(UNIT, a) = a
// there exists SOME element (an unconstrained witness).
axiom something: exists x: Sort; marked(x)

// unpack the witness w, then forall_elim opUnitLeft AT w → op(UNIT, w) = w.
// The conclusion `exists x; op(UNIT, x) = x` hides w, so the statement itself is
// witness-free, but the PROOF instantiates the guarded axiom at the witness.
theorem someUnitFixed: exists x: Sort; op(UNIT, x) = x
proof
  @exists-marked |
    exists x: Sort; marked(x)
    [by cite something]
  @with-w |
    unpack w: Sort from exists-marked {
      @unit-left |
        forall b: Sort; op(UNIT, b) = b
        [by cite opUnitLeft]
      @at-w |
        op(UNIT, w) = w
        [by forall_elim(w) unit-left]
      @exists-fixed |
        exists x: Sort; op(UNIT, x) = x
        [by exists_intro(w) at-w]
    }
  @conclusion |
    exists x: Sort; op(UNIT, x) = x
    [by exists_elim with-w]
qed
