// A theory whose theorem `ownFact` is proved by a model transfer, and TWO later theorems
// that each cite `ownFact` by name. When a concrete layer transfers both of those, the two
// re-proofs race for the ONE transferred copy of `ownFact`: the first demands it (and
// suspends on it), the second's read pass finds it in flight — and must suspend too, not
// proceed and cite the untransferred copy (whose statement is in THIS sort, not the target's).
import base <<< "base.bpa"

sort T
const E: T
func op(a: T, b: T): T
axiom opIdent: forall a: T; op(E, a) = a

model BaseModel {
  base.B: T
  base.BE: E
  base.bop: op
  base.bopIdent <- opIdent
}

theorem ownFact: forall a: T; op(E, a) = a
proof
  @conclusion |
    forall a: T; op(E, a) = a
    [using model(BaseModel) base.baseFact]
qed

theorem firstUse: op(E, E) = E
proof
  @the-fact |
    forall a: T; op(E, a) = a
    [by cite ownFact]
  @conclusion |
    op(E, E) = E
    [by forall_elim(E) the-fact]
qed

// a second transfer-proved fact that ONLY `secondUse` cites: demanding it (and its transferred
// copy) is what delays `secondUse`'s re-proof until `ownFact`'s transferred copy is already
// claimed and suspended — the interleaving the bug needs.
theorem spare: forall a: T; op(E, a) = a
proof
  @conclusion |
    forall a: T; op(E, a) = a
    [using model(BaseModel) base.baseFact]
qed

theorem secondUse: op(E, op(E, E)) = op(E, E)
proof
  @spare-fact |
    forall a: T; op(E, a) = a
    [by cite spare]
  @spare-at-e |
    op(E, E) = E
    [by forall_elim(E) spare-fact]
  @the-fact |
    forall a: T; op(E, a) = a
    [by cite ownFact]
  @at-the-inner |
    op(E, op(E, E)) = op(E, E)
    [by forall_elim(op(E, E)) the-fact]
  @conclusion |
    op(E, op(E, E)) = op(E, E)
    [by rewrite spare-at-e at-the-inner]
qed
