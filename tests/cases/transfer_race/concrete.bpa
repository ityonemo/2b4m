// Transfers BOTH of theory's `ownFact`-citing theorems and nothing else. The two transferred
// re-proofs both need `(ConcreteT, theory.bpa).ownFact`; whichever demands it second sees it
// in flight. Deterministic under the engine's FIFO queue: this file alone reproduces it.
import theory <<< "theory.bpa"

sort C
const Z: C
func plus(a: C, b: C): C
axiom plusIdent: forall a: C; plus(Z, a) = a

model ConcreteT {
  theory.T: C
  theory.E: Z
  theory.op: plus
  theory.opIdent <- plusIdent
}

theorem first: plus(Z, Z) = Z
proof
  @conclusion |
    plus(Z, Z) = Z
    [using model(ConcreteT) theory.firstUse]
qed

theorem second: plus(Z, plus(Z, Z)) = plus(Z, Z)
proof
  @conclusion |
    plus(Z, plus(Z, Z)) = plus(Z, Z)
    [using model(ConcreteT) theory.secondUse]
qed
