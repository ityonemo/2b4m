// deliberately broken: the two sides have different summands (left has two
// a's, right has one) — not an AC-rearrangement, so ac reports the mismatch
import peano <<< "std/peano.b4m"
sort Nat = peano.Nat
func add = peano.add
theorem addIsAssociative = peano.addIsAssociative
theorem addIsCommutative = peano.addIsCommutative
theorem addLeftSwap = peano.addLeftSwap

theorem bad: forall b, a: Nat; add(a, add(a, b)) = add(a, b)
proof
  @gen-b |
    fix b: Nat {
      @gen-a |
        fix a: Nat {
          @nope |
            add(a, add(a, b)) = add(a, b)
            [using assoc_commut]
        }
      @all-a |
        forall a: Nat; add(a, add(a, b)) = add(a, b)
        [by forall_intro gen-a]
    }
  @conclusion |
    forall b, a: Nat; add(a, add(a, b)) = add(a, b)
    [by forall_intro gen-b]
qed
