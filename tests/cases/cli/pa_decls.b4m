// Peano arithmetic signature: exercises every declaration form.
sort Nat
const ZERO: Nat
oper succ(n: Nat) => Nat
oper add(a: Nat, b: Nat) => Nat
// partial function: applications will owe a proof that b != ZERO (M5)
oper div(a: Nat, b: Nat) => Nat requires b != ZERO
pred even(n: Nat)
axiom addZeroRight: forall a: Nat; add(a, ZERO) = a
axiom evenZero: even(ZERO)
// comptime-style: a parameterized axiom is a stored form, instantiated on use
axiom induction(prop(Nat)):
  prop(ZERO) -> (forall k: Nat; prop(k) -> prop(succ(k))) -> forall n: Nat; prop(n)
