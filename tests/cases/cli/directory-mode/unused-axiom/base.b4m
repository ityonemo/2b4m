// a directory check's first file: the theorem the sibling in `sub/` cites.
sort Nat
const ZERO: Nat
pred even(n: Nat)
axiom zeroEven: even(ZERO)

// What this file proves (verified manifest):
intheory zeroIsEven

theorem zeroIsEven: even(ZERO)
proof
  @conclusion |
    even(ZERO)
    [by cite zeroEven]
qed
