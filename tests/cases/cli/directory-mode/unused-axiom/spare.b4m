// deliberately broken under --library: `spare` is an axiom no theorem in the directory
// rests on (`used` is cited; `spare` is not — a library ships no unused assumptions).
pred p()
pred q()
axiom used: p()
axiom spare: q()

// What this file proves (verified manifest):
intheory pHolds

theorem pHolds: p()
proof
  @conclusion |
    p()
    [by cite used]
qed
