// Fixture for `2b4m index`: the header is everything above the first theorem.
sort Nat
const ZERO: Nat
oper succ(n: Nat) => Nat
axiom succNotZero: forall n: Nat; succ(n) != ZERO

intheory indexed

theorem indexed: succ(ZERO) != ZERO
proof
  @conclusion |
    succ(ZERO) != ZERO
    [using specialize succNotZero(ZERO)]
qed
