// Bidirectional `iff_rewrite`: a biconditional cited to replace Q by P (the
// `q -> p` direction), not just P by Q. From `Q` and `P iff Q`, derive `P` by
// replacing the sub-proposition Q with P. The directional kernel only did P->Q;
// the bidirectional kernel accepts the reverse orientation too (iff is symmetric).
sort S
pred P
pred Q
pred R

// (1) whole-goal reverse: from Q and `P iff Q`, derive P.
theorem wholeGoalReverse: Q -> (P iff Q) -> P
proof
  @given-q |
    assume Q {
      @given-iff |
        assume P iff Q {
          @the-q |
            Q
            [by hypothesis given-q]
          @the-iff |
            P iff Q
            [by hypothesis given-iff]
          @p |
            P
            [by iff_rewrite the-iff the-q]
        }
      @iff-gives-p |
        (P iff Q) -> P
        [by implies_intro given-iff]
    }
  @conclusion |
    Q -> (P iff Q) -> P
    [by implies_intro given-q]
qed

// (2) under a connective, reverse: from `R and Q` and `P iff Q`, derive `R and P`.
theorem underConnectiveReverse: (R and Q) -> (P iff Q) -> (R and P)
proof
  @given-r-and-q |
    assume R and Q {
      @given-iff |
        assume P iff Q {
          @the-r-and-q |
            R and Q
            [by hypothesis given-r-and-q]
          @the-iff |
            P iff Q
            [by hypothesis given-iff]
          @r-and-p |
            R and P
            [by iff_rewrite the-iff the-r-and-q]
        }
      @iff-gives-r-and-p |
        (P iff Q) -> (R and P)
        [by implies_intro given-iff]
    }
  @conclusion |
    (R and Q) -> (P iff Q) -> (R and P)
    [by implies_intro given-r-and-q]
qed
