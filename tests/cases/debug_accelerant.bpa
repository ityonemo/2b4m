// fixture for `bpa debug accelerant`: a single ground `simplify` step whose
// synthetic theorem is small and predictable. `debug accelerant` reprints the
// theorem that `simplify` produced (statement + proof) as valid bpa source.
sort Nat
const ZERO: Nat
func succ(n: Nat) => Nat
func add(a: Nat, b: Nat) => Nat
axiom addZeroLeft: forall b: Nat; add(ZERO, b) = b
axiom addSuccLeft: forall a, b: Nat; add(succ(a), b) = succ(add(a, b))

// ground: 1 + 1 = 2, one simplify step. No eigenvariables, no premises, so the
// synthetic theorem's statement is exactly this equation.
theorem onePlusOne: add(succ(ZERO), succ(ZERO)) = succ(succ(ZERO))
proof
  @conclusion |
    add(succ(ZERO), succ(ZERO)) = succ(succ(ZERO))
    [using simplify addSuccLeft addZeroLeft]
qed
