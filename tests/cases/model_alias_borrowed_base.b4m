// The BASE theory: a unit and an operation, one axiom, one theorem.
sort S
const U: S
func op(a: S, b: S) => S
axiom opUnitLeft: forall a: S; op(U, a) = a

theorem unitTwice: op(U, U) = U
proof
  @law |
    forall a: S; op(U, a) = a
    [by cite opUnitLeft]
  @conclusion |
    op(U, U) = U
    [by forall_elim(U) law]
qed
