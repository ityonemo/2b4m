// LOCAL-CONTEXT DISCHARGE — already works (regression guard for the auto-elim landed
// 2026-09-02). A refined-sort `forall_elim`'s guard `good(t)` discharges WITHOUT any global
// fact when t's guard is available locally:
//   (1) a PRIOR STEP already asserting good(t);
//   (2) a FIX EIGENVARIABLE whose block carries the guard.
sort G
pred good(x: G)
sort H = G where good
const c: G
func f(x: G): G

axiom goodC: good(c)
axiom fLaw: forall h: H; f(h) = h

// (1) prior-step discharge: @c-is-good proves good(c); the elim cites it.
theorem fromPriorStep: f(c) = c
proof
  @c-is-good | good(c) [by cite goodC]
  @the-law | forall h: H; f(h) = h [by cite fLaw]
  @conclusion | f(c) = c [by forall_elim(c) the-law]
qed

// (2) fix-eigenvariable discharge: good(a) comes from the fix block guard.
theorem fromFixGuard: forall a: H; f(a) = a
proof
  @generalize-a |
    fix a: H {
      @the-law | forall h: H; f(h) = h [by cite fLaw]
      @at-a | f(a) = a [by forall_elim(a) the-law]
    }
  @conclusion | forall a: H; f(a) = a [by forall_intro generalize-a]
qed
