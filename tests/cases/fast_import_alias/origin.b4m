// the ORIGIN of the fact: where it is actually stated and proved.
sort Nat
const ZERO: Nat
pred big(n: Nat)

axiom everythingIsBig: forall n: Nat; big(n)

theorem zeroIsBig: big(ZERO)
proof
  @the-universal |
    forall n: Nat; big(n)
    [by cite everythingIsBig]
  @conclusion |
    big(ZERO)
    [by forall_elim(ZERO) the-universal]
qed
