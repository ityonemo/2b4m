// `--fast` must never report an error strict does not.
//
// `[using import(I) thm]` is ADMITTED under `--fast` by alpha-matching the imported
// statement — which reads `thm`'s STATED formula. When `thm` is an ALIAS it has none, and
// admission used to fail with "'zeroIsBig' has no stated formula (an alias or a non-fact)"
// while strict passed, because strict follows the alias to its origin.
//
// Gated BOTH ways. Reproduced from std/complex/polar.b4m, which cites std/real.b4m's
// `sqrtOne` -- itself an alias of std/real/sqrt.b4m's.
import middle <<< "middle.b4m"

sort Nat = middle.Nat
const ZERO = middle.ZERO
pred big = middle.big

theorem theAliasedFactIsCitableAcrossAnImport: big(ZERO)
proof
  @conclusion |
    big(ZERO)
    [using import(middle) zeroIsBig]
qed
