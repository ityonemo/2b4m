// `polynomial` cancelling a CROSS-TERM pair: `a·b + neg(b·a)`. The two monomials are the
// same up to commutativity, but one of them sits INSIDE `neg(…)` — its factors must be
// sorted there too (the sort lifting through the neg context in the certificate), or the
// cancellation never sees the pair. The strict/--fast divergence memory records as the
// polynomial cross-term cancel bug; RED until the neg-wrapped monomial is canonicalized.
import int_divides <<< "std/integer/divides.bpa"

sort Int = int_divides.Int
const ZERO = int_divides.ZERO
func add = int_divides.add
func mul = int_divides.mul
func neg = int_divides.neg

theorem crossTermCancels: forall a, b: Int; add(mul(a, b), neg(mul(b, a))) = ZERO
proof
  @conclusion |
    forall a, b: Int; add(mul(a, b), neg(mul(b, a))) = ZERO
    [using polynomial_quantified(int_divides)]
qed

// the same pair buried under a surviving summand and a triple product.
theorem crossTermCancelsUnderRemainder: forall a, b, c, x: Int;
  add(x, add(mul(mul(a, b), c), neg(mul(c, mul(b, a))))) = x
proof
  @conclusion |
    forall a, b, c, x: Int; add(x, add(mul(mul(a, b), c), neg(mul(c, mul(b, a))))) = x
    [using polynomial_quantified(int_divides)]
qed
