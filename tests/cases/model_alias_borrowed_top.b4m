// The TOP theory: borrows the middle theory's symbols and theorem by alias — a SECOND hop
// away from the base — and cites the borrowed theorem.
import mid <<< "model_alias_borrowed_mid.b4m"

sort S = mid.S
const U = mid.U
func op = mid.op
axiom opUnitLeft = mid.opUnitLeft
theorem unitThrice = mid.unitThrice

theorem unitFourth: op(U, op(U, op(U, U))) = U
proof
  @law |
    forall a: S; op(U, a) = a
    [by cite opUnitLeft]
  @unit-absorbs-the-cube |
    op(U, op(U, op(U, U))) = op(U, op(U, U))
    [by forall_elim(op(U, op(U, U))) law]
  @cube-is-unit |
    op(U, op(U, U)) = U
    [by cite unitThrice]
  @conclusion |
    op(U, op(U, op(U, U))) = U
    [using chain unit-absorbs-the-cube cube-is-unit]
qed
