// deliberately broken: `guards(…)` names two steps where the cited fact has ONE guard
// obligation (its single refined binder `f: Perm`). Naming more dischargers than there
// are obligations is a hard error, not a silently ignored extra — the count is read off
// the fact's binder list, so a mismatch means the author misread the signature.
sort Element
sort Fn
pred invertible(f: Fn)
sort Perm = Fn where invertible
func apply(f: Fn, x: Element) => Element
const point: Element

axiom permFixesPoint: forall f: Perm; apply(f, point) = point

theorem aNamedDischargerIsCredited: forall g: Fn; invertible(g) -> apply(g, point) = point
proof
  @generalize-g |
    fix g: Fn {
      @given-invertible |
        assume invertible(g) {
          @g-is-invertible |
            invertible(g)
            [by hypothesis given-invertible]
          @applied |
            apply(g, point) = point
            [using specialize permFixesPoint(g) guards(g-is-invertible, g-is-invertible)]
        }
      @conclusion-implication |
        invertible(g) -> apply(g, point) = point
        [by implies_intro given-invertible]
    }
  @conclusion |
    forall g: Fn; invertible(g) -> apply(g, point) = point
    [by forall_intro generalize-g]
qed
