// Citation rule — the ALLOWED cases. Transferring `unitCollapsesAndMarks`
// materializes a proof citing: opUnitLeft (substituted axiom -> local THEOREM,
// case 4), opUnitRight (substituted axiom -> local AXIOM, case 5), pointStays
// (substitution-invariant theorem, walk ends, case 2), pointMarked (invariant
// axiom, walk ends, case 3). All legal → kernel-checks in strict mode.
import cite <<< "model_cite_source.bpa"

sort Thing
const NEUTRAL: Thing
func combine(a: Thing, b: Thing): Thing

// discharges opUnitLeft with a THEOREM (case 4).
axiom combineNeutralLeftAxiom: forall a: Thing; combine(NEUTRAL, a) = a
theorem combineNeutralLeft: forall a: Thing; combine(NEUTRAL, a) = a
proof
  @conclusion |
    forall a: Thing; combine(NEUTRAL, a) = a
    [by axiom combineNeutralLeftAxiom]
qed

// discharges opUnitRight with an AXIOM (case 5).
axiom combineNeutralRight: forall a: Thing; combine(a, NEUTRAL) = a

// `Untouched`, `POINT`, `marks`, `pointMarked`, `pointStays` are NOT mapped —
// they are substitution-invariant, so the materialized proof cites them as-is.
model ThingModel {
  cite.Sort: Thing
  cite.UNIT: NEUTRAL
  cite.op: combine
  cite.opUnitLeft <- combineNeutralLeft
  cite.opUnitRight <- combineNeutralRight
  }

theorem combineCollapsesAndMarks:
  (forall a: Thing; combine(NEUTRAL, combine(a, NEUTRAL)) = combine(NEUTRAL, a)) and cite.marks(cite.POINT)
proof
  @conclusion |
    (forall a: Thing; combine(NEUTRAL, combine(a, NEUTRAL)) = combine(NEUTRAL, a)) and cite.marks(cite.POINT)
    [using model(ThingModel) cite.unitCollapsesAndMarks]
qed
