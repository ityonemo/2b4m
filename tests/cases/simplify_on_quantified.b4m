// deliberately broken: plain simplify on a forall-over-equation goal should
// redirect the user to simplify_quantified
sort Nat
const ZERO: Nat
func add(a: Nat, b: Nat) => Nat
axiom addZeroLeft: forall b: Nat; add(ZERO, b) = b

theorem quantified: forall n: Nat; add(ZERO, n) = n
proof
  @conclusion |
    forall n: Nat; add(ZERO, n) = n
    [using simplify addZeroLeft]
qed
