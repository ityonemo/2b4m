// The anonymous inline `where` (a statement binder `x: G where D`) accepts a
// define'd guard too (`where`-reification, task #125). Same as the named-sort
// case — a define'd pred rides along as a qualifier symbol and expands at its
// uses. The inline-`where` goal desugars to `forall x; isBig(x) -> x = x`, so we
// fix a plain `x`, assume the (expanded) guard, and close by reflexivity.

sort Nat
const ZERO: Nat
func succ(n: Nat): Nat

define isBig(n) = exists m: Nat; n = succ(m)

theorem inlineGuard: forall x: Nat where isBig; x = x
proof
  @generalize-x |
    fix x: Nat {
      @given-guard |
        assume exists m: Nat; x = succ(m) {
          @reflexive |
            x = x
            [by reflexivity]
        }
      @guarded |
        (exists m: Nat; x = succ(m)) -> x = x
        [by implies_intro given-guard]
    }
  @conclusion |
    forall x: Nat where isBig; x = x
    [by forall_intro generalize-x]
qed
