// The anonymous inline `where` (a statement binder `x: G where D`) accepts a
// define'd guard too: the expansion pass DESUGARS the binder to its meaning —
// `forall x: Nat; isBig(x) -> x = x` with the call expanded — so we fix a plain
// `x`, assume the (expanded) guard, and close by reflexivity.

sort Nat
const ZERO: Nat
func succ(n: Nat): Nat

define isBig(n) = exists m: Nat; n = succ(m)

theorem inlineGuard: forall x: Nat where isBig; x = x
proof
  @generalize-x |
    fix x: Nat {
      @given-guard |
        assume exists m: Nat; x = succ(m) {
          @reflexive |
            x = x
            [by reflexivity]
        }
      @guarded |
        (exists m: Nat; x = succ(m)) -> x = x
        [by implies_intro given-guard]
    }
  @conclusion |
    forall x: Nat where isBig; x = x
    [by forall_intro generalize-x]
qed
