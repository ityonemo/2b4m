// Farkas sum path: sum two order hypotheses over DISTINCT variables
// into a combined bound. a<b and c<d give add(a,c) < add(b,d) — each
// hypothesis lifted by additionPreservesOrder, commuted to align, and chained
// by transitivity. Needs addIsCommutative in the theory scope.
import ordering <<< "std/peano/order.bpa"

sort Nat = ordering.Nat
func add = ordering.add
pred less_than = ordering.less_than

theorem sumOrders: forall a, b, c, d: Nat; less_than(a, b) -> less_than(c, d) -> less_than(add(a, c), add(b, d))
proof
  @conclusion |
    forall a, b, c, d: Nat; less_than(a, b) -> less_than(c, d) -> less_than(add(a, c), add(b, d))
    [using arithmetic(ordering)]
qed
