// accelerated tactic: 'arithmetic' is a small SMT solver — linear-arithmetic
// atoms go to the Presburger engine, everything else is an opaque
// propositional atom (see ACCELERATION.md)
sort Nat
const ZERO: Nat
const ONE: Nat
func succ(n: Nat): Nat
func add(a: Nat, b: Nat): Nat
pred less_than(a: Nat, b: Nat)
pred p

theorem mixed: forall a, b: Nat; less_than(a, b) -> (p or less_than(a, succ(b)))
proof
  @conclusion |
    forall a, b: Nat; less_than(a, b) -> (p or less_than(a, succ(b)))
    [using arithmetic]
qed

theorem conflict: forall a: Nat; (p and less_than(a, succ(a))) or ((not p) and less_than(a, add(a, ONE)))
proof
  @conclusion |
    forall a: Nat; (p and less_than(a, succ(a))) or ((not p) and less_than(a, add(a, ONE)))
    [using arithmetic]
qed
