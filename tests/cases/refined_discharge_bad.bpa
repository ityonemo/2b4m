// NEGATIVE — the guard is NOT dischargeable, so the refined-sort elim must be REJECTED
// (soundness: `forall h: H` may not be eliminated at a witness not shown to be in H).
// Here `c` is a plain G with NO good(c) fact anywhere (no axiom, no step, no closure), so
// `forall_elim(c) the-law` owes `good(c)` and cannot discharge it. MUST FAIL with an
// unproved obligation — not silently accept the bare consequent.
sort G
pred good(x: G)
sort H = G where good
const c: G
func f(x: G): G

axiom fLaw: forall h: H; f(h) = h

theorem fAtUnprovenConst: f(c) = c
proof
  @the-law |
    forall h: H; f(h) = h
    [by axiom fLaw]
  @conclusion |
    f(c) = c
    [by forall_elim(c) the-law]
qed
