// SOUNDNESS negative for `iff` + `tautology`: an iff must not license an
// unrelated conclusion. Given `A iff B` and `A`, you get `B` — NOT `C`.
// tautology must reject with a countermodel that RESPECTS the iff (A and B
// agree) while falsifying C — proving it reasons about the biconditional's
// semantics rather than rubber-stamping any goal that mentions an iff.

pred A
pred B
pred C

theorem iffDoesNotGiveUnrelated: (A iff B) -> A -> C
proof
  @given-iff |
    assume A iff B {
      @the-iff | A iff B [by hypothesis given-iff]
      @given-a |
        assume A {
          @the-a | A [by hypothesis given-a]
          @c | C [using tautology the-iff the-a]
        }
      @a-implies-c | A -> C [by implies_intro given-a]
    }
  @conclusion | (A iff B) -> A -> C [by implies_intro given-iff]
qed
