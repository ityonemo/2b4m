// deliberately broken: an inner-block label reuses an ENCLOSING label name
// (`base`). Zig's no-shadowing rule forbids this. (Disjoint sibling blocks may
// still reuse a label — that is not shadowing; see fix_sibling_reuse.bpa.)
sort Nat
const Z: Nat
pred p(n: Nat)

axiom pp: p(Z)

theorem g: p(Z) -> p(Z)
proof
  @base |
    p(Z)
    [by cite pp]
  @outer |
    assume p(Z) {
      @base |
        p(Z)
        [by hypothesis outer]
      @c |
        p(Z)
        [by hypothesis outer]
    }
  @done |
    p(Z) -> p(Z)
    [by implies_intro outer]
qed
