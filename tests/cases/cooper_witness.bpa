// Cooper-replay layer 2 (witness direction, ⟸): a `forall x; exists y; …`
// goal whose Cooper elimination has period 1 — the existential is discharged by
// a single concrete witness, no induction. The `cooper` certifier emits an
// `exists_intro` under an `or_elim`, so this checks ELABORATED in default mode.
//
//   forall x; exists y; x = y or x = succ(y)
//
// (witness y := x, left disjunct by reflexivity). Contrast the period-2 parity
// goal in cooper_parity.bpa, which needs the layer-3 induction.
sort Nat
const ZERO: Nat
const ONE: Nat
func succ(n: Nat): Nat
func add(a: Nat, b: Nat): Nat
func mul(a: Nat, b: Nat): Nat
axiom addZeroLeft: forall b: Nat; add(ZERO, b) = b
axiom addSuccLeft: forall a, b: Nat; add(succ(a), b) = succ(add(a, b))
axiom mulZeroLeft: forall b: Nat; mul(ZERO, b) = ZERO
axiom mulSuccLeft: forall a, b: Nat; mul(succ(a), b) = add(mul(a, b), b)
axiom oneIsSuccZero: ONE = succ(ZERO)

theorem existsPredecessorOrZero: forall x: Nat; exists y: Nat; x = y or x = succ(y)
proof
  @conclusion |
    forall x: Nat; exists y: Nat; x = y or x = succ(y)
    [using arithmetic]
qed
