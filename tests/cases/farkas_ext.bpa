// Farkas extensions: order-composition and false-concluding infeasibility.
// Both build on the difference-logic cycle machinery in the base farkas link.
import ordering <<< "std/peano/order.bpa"

sort Nat = ordering.Nat
pred less_than = ordering.less_than

// #50 order composition: the conclusion is a genuine less_than(x, y) (NOT a
// self-loop). Fold the chain a<b, b<c into a<c by transitivity — no cycle,
// no irreflexivity. This is what plain transitivity to a third variable needs.
theorem chainComposes: forall a, b, c: Nat; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
proof
  @conclusion |
    forall a, b, c: Nat; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
    [using arithmetic(ordering)]
qed

// a longer composition: a<b, b<c, c<d -> a<d
theorem chainComposesLong: forall a, b, c, d: Nat; less_than(a, b) -> less_than(b, c) -> less_than(c, d) -> less_than(a, d)
proof
  @conclusion |
    forall a, b, c, d: Nat; less_than(a, b) -> less_than(b, c) -> less_than(c, d) -> less_than(a, d)
    [using arithmetic(ordering)]
qed

// #49 false-concluding infeasibility: the conclusion is `not less_than(a, a)`?
// No — the honest infeasibility shape is: the hypotheses are contradictory, so
// ANY conclusion follows. Here the conclusion is a foreign atom that does NOT
// follow arithmetically except via the contradiction. Use a fresh predicate.
pred unrelated(a: Nat)
theorem contradictionProvesAnything: forall a, b: Nat; less_than(a, b) -> less_than(b, a) -> unrelated(a)
proof
  @conclusion |
    forall a, b: Nat; less_than(a, b) -> less_than(b, a) -> unrelated(a)
    [using arithmetic(ordering)]
qed
