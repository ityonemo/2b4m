// deliberately broken: the countermodel mixes arithmetic values and opaque
// atom truth values
sort Nat
func succ(n: Nat) => Nat
pred less_than(a: Nat, b: Nat)
pred p

theorem bad: forall a: Nat; p or less_than(succ(a), a)
proof
  @conclusion |
    forall a: Nat; p or less_than(succ(a), a)
    [using arithmetic]
qed
