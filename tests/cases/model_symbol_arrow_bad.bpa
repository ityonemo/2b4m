// REJECTION: using `<-` to map a SORT or SYMBOL is an error — `<-` is for axiom
// obligation discharges only; sorts and symbols are interpreted with `:`. Here
// `source.op` is a function symbol, so the `<-` on its line must be rejected.
//
// Under the demand prover a model builds only when CITED, so the theorem below
// transfers a source theorem through `ThingModel` — forcing the build and
// rejecting the malformed `source.op <- combine` line.
import source <<< "model_source.bpa"

sort Thing
const ZED: Thing
func combine(a: Thing, b: Thing): Thing

axiom combineZedLeft: forall a: Thing; combine(ZED, a) = a

model ThingModel {
  source.Sort: Thing
  source.UNIT: ZED
  source.op <- combine
  source.opUnitLeft <- combineZedLeft
}

theorem combineZedLeftTwice: forall a: Thing; combine(ZED, combine(ZED, a)) = combine(ZED, a)
proof
  @conclusion |
    forall a: Thing; combine(ZED, combine(ZED, a)) = combine(ZED, a)
    [using model(ThingModel) source.opUnitLeftTwice]
qed
