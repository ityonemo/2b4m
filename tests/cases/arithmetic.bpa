// accelerated tactic: 'arithmetic' decides linear (Presburger) arithmetic over
// Nat by quantifier elimination (see ACCELERATION.md). The symbols ZERO, succ,
// add, mul, ONE, and less_than are recognized by name in the current scope.
// The engine is pure ℤ; `nonneg` is the well-known predicate that supplies ℕ's
// x ≥ 0 (injected per variable), so ℕ-only-valid goals still decide.
sort Nat
const ZERO: Nat
func succ(n: Nat) => Nat
func add(a: Nat, b: Nat) => Nat
pred less_than(a: Nat, b: Nat)
pred nonneg(n: Nat)

theorem lessThanAddSucc: forall a, b: Nat; less_than(a, add(a, succ(b)))
proof
  @conclusion |
    forall a, b: Nat; less_than(a, add(a, succ(b)))
    [using arithmetic]
qed

theorem evenOrOdd: forall x: Nat; exists y: Nat; x = add(y, y) or x = succ(add(y, y))
proof
  @conclusion |
    forall x: Nat; exists y: Nat; x = add(y, y) or x = succ(add(y, y))
    [using arithmetic]
qed

theorem twoPlusThree: add(succ(succ(ZERO)), succ(succ(succ(ZERO)))) = succ(succ(succ(succ(succ(ZERO)))))
proof
  @conclusion |
    add(succ(succ(ZERO)), succ(succ(succ(ZERO)))) = succ(succ(succ(succ(succ(ZERO)))))
    [using arithmetic]
qed

theorem stepUp: forall a, b: Nat; less_than(a, b) -> less_than(a, succ(b))
proof
  @gen-a |
    fix a: Nat {
      @gen-b |
        fix b: Nat {
          @hyp |
            assume less_than(a, b) {
              @have |
                less_than(a, b)
                [by hypothesis hyp]
              @conc-in |
                less_than(a, succ(b))
                [using arithmetic have]
            }
          @imp |
            less_than(a, b) -> less_than(a, succ(b))
            [by implies_intro hyp]
        }
      @all-b |
        forall b: Nat; less_than(a, b) -> less_than(a, succ(b))
        [by forall_intro gen-b]
    }
  @conclusion |
    forall a, b: Nat; less_than(a, b) -> less_than(a, succ(b))
    [by forall_intro gen-a]
qed
