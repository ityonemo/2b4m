// A FALSE set "identity": union is not intersection. `ext` reduces via
// extensionality, unfolds membership, but the propositional residue has a
// countermodel — the tautology closer reports it, exit 1 (not accepted).
import set <<< "std/set.bpa"
sort Element = set.Element
sort Set = set.Set
func union = set.union
func intersection = set.intersection
pred member = set.member
axiom unionMember = set.unionMember
axiom intersectionMember = set.intersectionMember
axiom extensionality = set.extensionality

theorem wrong: forall a, b: Set; union(a, b) = intersection(a, b)
proof
  @conclusion |
    forall a, b: Set; union(a, b) = intersection(a, b)
    [using ext_quantified(set)]
qed
