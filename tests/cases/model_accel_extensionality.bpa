// MODEL TRANSFER OF AN ACCELERANT-USING THEOREM — `ext` (GUARDED model).
//
// A source theorem proved with `ext` (function extensionality) is transferred
// through a GUARDED model (sort of functions restricted to `good`). The
// transfer must materialize a MODEL-MANGLED, relativized synthetic extensionality
// certificate for the step — but today the accelerant builds its synthetic
// theorem at elaboration in the SOURCE space, blind to the model, so the guarded
// re-emission escapes an eigenvariable.
//
// The source is a self-contained function algebra: `ext` finds the
// extensionality lemma and the `apply`-characterization lemmas by enumerating
// local scope, no theory arg needed.
//
// RED: this is the characterization test for making accelerants model-aware.

sort Element
sort Fn
func apply(f: Fn, x: Element) => Element
func compose(g: Fn, f: Fn) => Fn
axiom composeApply: forall g, f: Fn; forall x: Element;
  apply(compose(g, f), x) = apply(g, apply(f, x))
axiom funcExtensionality: forall f, g: Fn;
  (forall x: Element; apply(f, x) = apply(g, x)) -> f = g

// proved with `ext` — associativity of composition by extensionality.
theorem composeAssociative: forall h, g, f: Fn;
  compose(compose(h, g), f) = compose(h, compose(g, f))
proof
  @conclusion |
    forall h, g, f: Fn; compose(compose(h, g), f) = compose(h, compose(g, f))
    [using extensionality_quantified(funcExtensionality) composeApply]
qed

// a concrete sort of functions with a membership guard `good`.
sort TElement
sort Tfn
func tapply(f: Tfn, x: TElement) => TElement
func tcompose(g: Tfn, f: Tfn) => Tfn
pred good(f: Tfn)
sort GoodFn = Tfn where good
// closure of the guard, so the ONLY remaining transfer failure is the accelerant.
axiom goodComposeClosed: forall g, f: Tfn; good(g) -> good(f) -> good(tcompose(g, f))
axiom tcomposeApply: forall g, f: Tfn; forall x: TElement;
  tapply(tcompose(g, f), x) = tapply(g, tapply(f, x))
axiom tfuncExtensionality: forall f, g: Tfn;
  (forall x: TElement; tapply(f, x) = tapply(g, x)) -> f = g

model SrcIsGood {
  Element: TElement
  Fn: GoodFn
  apply: tapply
  compose: tcompose -| goodComposeClosed
  composeApply <- tcomposeApply
  funcExtensionality <- tfuncExtensionality
}

theorem transferred: forall h, g, f: GoodFn;
  tcompose(tcompose(h, g), f) = tcompose(h, tcompose(g, f))
proof
  @conclusion |
    forall h, g, f: GoodFn; tcompose(tcompose(h, g), f) = tcompose(h, tcompose(g, f))
    [using model(SrcIsGood) composeAssociative]
qed
