// deliberately broken: a theorem schema whose stored proof instantiates
// itself. The cycle is only discovered when the schema is instantiated (its
// proof is re-checked then, comptime semantics). Reported as a named cycle,
// not a blunt "too deep".
pred p

theorem loopy(q: Prop): q -> q
proof
  @conclusion |
    q -> q
    [using instantiation loopy(q)]
qed

// force the stored proof to be re-checked
theorem trigger: p -> p
proof
  @conclusion |
    p -> p
    [using instantiation loopy(p)]
qed
