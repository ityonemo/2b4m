// lint fixture: canonical binder order. `good` binds in first-appearance order;
// `bad` reverses it (proof-convenience order). `bpa lint` flags only `bad`.
sort Nat
const ZERO: Nat
func add(a: Nat, b: Nat) => Nat

// first-appearance order a, b — canonical.
axiom good: forall a, b: Nat; add(a, b) = add(b, a)

// first-appearance order a, b (a leads `add(a, b)`), but declared b, a.
axiom bad: forall b, a: Nat; add(a, b) = add(b, a)
