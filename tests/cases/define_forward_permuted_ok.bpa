// A define that forwards an opaque predicate with its arguments PERMUTED is a
// genuine macro (`gt(a, b)` means `less_than(b, a)`), NOT an alias — accepted.
// Only the exact same-order forward (`define lt(a, b) = ordering.less_than(a, b)`)
// is rejected as an alias in disguise (see define_alias_bad.bpa).
import ordering <<< "../../std/peano-order.bpa"
sort Nat = ordering.Nat
define gt(a, b) = ordering.less_than(b, a)
theorem usesIt: forall a, b: Nat; gt(a, b) -> ordering.less_than(b, a)
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @given-gt |
            assume gt(a, b) {
              @b-less-than-a |
                ordering.less_than(b, a)
                [by hypothesis given-gt]
            }
          @conclusion-gt-unfolds |
            gt(a, b) -> ordering.less_than(b, a)
            [by implies_intro given-gt]
        }
      @discharge-b |
        forall b: Nat; gt(a, b) -> ordering.less_than(b, a)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Nat; gt(a, b) -> ordering.less_than(b, a)
    [by forall_intro generalize-a]
qed
