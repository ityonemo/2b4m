// SPIKE probe: a proof-carrying SCHEMA whose proof uses `polynomial` (a
// structural accelerant). We want `bpa debug accelerant <file> polySchema
// <step>` to reprint the synthetic. polynomial operates on shape, so an opaque
// schema param should admit it.
import peano <<< "std/peano.bpa"

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
func mul = peano.mul

// a proof-carrying schema (the `prop` param makes it a schema); the proof body
// uses `polynomial` at @poly-step over a generic term `n`.
theorem polySchema(prop: Nat -> Prop): forall n: Nat; mul(add(n, n), n) = add(mul(n, n), mul(n, n))
proof
  @generalize-n |
    fix n: Nat {
      @poly-step |
        mul(add(n, n), n) = add(mul(n, n), mul(n, n))
        [using polynomial(peano)]
    }
  @conclusion |
    forall n: Nat; mul(add(n, n), n) = add(mul(n, n), mul(n, n))
    [by forall_intro generalize-n]
qed

// a schema is checked PER INSTANCE (there is no decl-time self-check: uncited code
// isn't checked), so instantiate it — that is what produces @poly-step's synthetic.
theorem polyInstance: forall n: Nat; mul(add(n, n), n) = add(mul(n, n), mul(n, n))
proof
  @conclusion |
    forall n: Nat; mul(add(n, n), n) = add(mul(n, n), mul(n, n))
    [using instantiation polySchema(fun x: Nat => x = x)]
qed
