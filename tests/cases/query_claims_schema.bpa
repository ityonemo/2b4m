// Fixture for `bpa query claims` on a proof-carrying SCHEMA (a parameterized
// theorem — a `theorem name(param): …` with a proof). The schema's proof has a
// `fix` block, so `claims` must render both the block header and the claim
// formulas of the steps inside it — from a schema, not just a plain theorem.
sort Nat
const ZERO: Nat
func succ(n: Nat) => Nat
pred P(n: Nat)

axiom pAll: forall n: Nat; P(n)

// a proof-carrying schema in `x`: for any x, everything satisfies P.
theorem everythingP(x: Nat): forall n: Nat; P(n)
proof
  @generalize-n |
    fix n: Nat {
      @p-holds-everywhere |
        forall m: Nat; P(m)
        [by cite pAll]
      @p-at-n |
        P(n)
        [by forall_elim(n) p-holds-everywhere]
    }
  @conclusion |
    forall n: Nat; P(n)
    [by forall_intro generalize-n]
qed
