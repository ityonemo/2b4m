// EXPECTED TO FAIL under --draft --library: the `termination:` theorem is a HOLE, and it
// states something other than the synthesized obligation.
//
// REGRESSION. The facts table holds PROVEN facts only, so a hole is absent from it and the
// check used to report "names no fact in this file" -- wrong twice over: the declaration is
// right there, and its stated formula is comparable whether or not anything proved it. A hole
// stating the WRONG obligation settles nothing either, and saying so is the whole value of
// the check. (The same bug was in the `consistency:` collector, which was this one's
// template; fixed alongside.)
sort N
const Z: N
oper s(a: N) => N

hole gTerminates cites "exercise: by induction over N": forall n: N; gGrounded(n)

oper g(n: N) => N:
  g(Z) = Z;
  g(n) = s(g(n)).
  termination(peano): _, {
  gTerminates, gGrounded
}
