// EXPECTED TO FAIL: one quantifier, so there is no clause-pair shape to recognize.
// The obligation always binds at least the matched variable and its predecessor.
theory peano <<< "std/peano.b4m"
intheory tooFew
theorem tooFew: forall k: peano.Nat; (k = peano.ZERO and k = peano.ZERO) -> k = k
proof
  @conclusion |
    forall k: peano.Nat; (k = peano.ZERO and k = peano.ZERO) -> k = k
    [using definition_consistency(peano)]
qed
