// An implicit definition WITH its obligations named. `bogus` is characterized by a property
// rather than given by a rewrite, so it owes existence and uniqueness.
sort F
const ONE: F
oper mul(a: F, b: F) => F

hole inversesExist: forall a: F; exists y: F; mul(a, y) = ONE
hole inversesAreUnique: forall a: F; forall y, z: F;
  mul(a, y) = ONE -> mul(a, z) = ONE -> y = z

oper bogus(a: F) => F:
  mul(a, bogus(a)) = ONE.
  existence: inversesExist,
  uniqueness: inversesAreUnique
