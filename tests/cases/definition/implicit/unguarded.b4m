// EXPECTED TO FAIL: an IMPLICIT definition (the defined symbol is not the clause's l-value)
// must declare `existence:` and `uniqueness:`. Without them nothing checks that such a value
// exists, and a user can derive a contradiction — see PAINPOINTS 16f.
sort F
const ONE: F
oper mul(a: F, b: F) => F

oper bogus(a: F) => F:
  mul(a, bogus(a)) = ONE.
