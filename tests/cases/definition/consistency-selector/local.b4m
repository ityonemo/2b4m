// NO SELECTOR, because the file owns its own constructors: `Z` and `s` are declared here, and
// the vacuity schema is stated here too. Omitting `consistency(...)` means local resolution,
// which is correct — there is no other theory to name.
sort N
const Z: N
oper s(a: N) => N
axiom sNotZero: forall n: N; not (s(n) = Z)
axiom zeroSuccSplitIsVacuous(prop(N, N)):
  forall k, n: N; (k = Z and k = s(n)) -> prop(k, n)

intheory fBase

// NOT RECURSIVE: the step arm returns `s(a)` rather than recursing. What this fixture tests
// is the `consistency:` SELECTOR over a two-arm block whose patterns are `Z` and `s(n)`, and
// that shape is preserved. Recursion was incidental scaffolding, and a recursive block now
// owes a `termination:` obligation that an ABSTRACT sort cannot discharge — nothing here says
// `N` is inductively generated, so a predecessor chain need never reach `Z`.
oper f(a: N, n: N) => N:
  f(a, Z) = a;
  f(a, s(n)) = s(a).
  consistency: _

theorem fBase: forall a: N; f(a, Z) = a
proof
  @conclusion |
    forall a: N; f(a, Z) = a
    [by definition(0) f]
qed
