// NO SELECTOR, because the file owns its own constructors: `Z` and `s` are declared here, and
// the vacuity schema is stated here too. Omitting `consistency(...)` means local resolution,
// which is correct — there is no other theory to name.
sort N
const Z: N
oper s(a: N) => N
axiom sNotZero: forall n: N; not (s(n) = Z)
axiom zeroSuccSplitIsVacuous(prop(N, N)):
  forall k, n: N; (k = Z and k = s(n)) -> prop(k, n)

intheory fBase

oper f(a: N, n: N) => N:
  f(a, Z) = a;
  f(a, s(n)) = s(f(a, n)).
  consistency: _

theorem fBase: forall a: N; f(a, Z) = a
proof
  @conclusion |
    forall a: N; f(a, Z) = a
    [by definition(0) f]
qed
