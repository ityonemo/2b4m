// THE SNIFFING DEFECT: this is `nrep` with LOCAL ALIASES for the constructors instead of
// qualified `peano.ZERO` / `peano.succ`. Same definition, same mathematics — but
// `constructorTheory` reads the theory off whether a clause token happens to carry a
// qualifier, so here it finds none and the `_` entry is staged with NO vacuity schema.
//
// With an explicit `consistency(peano): _` the selector is stated rather than sniffed, and
// this checks exactly as the qualified form does.
theory peano <<< "std/peano.b4m"

sort Nat = peano.Nat
const ZERO = peano.ZERO
oper succ = peano.succ

intheory nrepCovers
intheory nrepBase

// NOT RECURSIVE: the step arm returns `succ(a)` rather than recursing. What this fixture
// tests is the `consistency:` SELECTOR reading `peano` off the DECLARATION instead of
// sniffing it from a clause token's qualifier, and that needs only a two-arm block whose
// patterns are the aliased `ZERO` and `succ(n)` — which is preserved exactly. Recursion was
// incidental scaffolding, and a recursive block now owes a `termination:` obligation that
// would be beside the point here (ℕ could discharge it, but proving it would bury the one
// line this fixture exists to exercise).
oper nrep(a: Nat, n: Nat) => Nat:
  nrep(a, ZERO) = a;
  nrep(a, succ(n)) = succ(a).
  consistency(peano): _
  totality(peano): nrepCovers

theorem nrepBase: forall a: Nat; nrep(a, ZERO) = a
proof
  @conclusion |
    forall a: Nat; nrep(a, ZERO) = a
    [by definition(0) nrep]
qed

// COVERAGE: the arms split on `n` being ZERO or a successor, which is `peano.zeroOrSucc`.
// Not propositional — the two conditions are unrelated atoms — so autodetection declines and
// this is proved. The riding binder `a` is quantified because the obligation covers the whole
// parameter list, though only the last slot is narrowed.
theorem nrepCovers: forall a: Nat; forall n: Nat;
  n = ZERO or (exists n_at2: Nat; n = succ(n_at2))
proof
  @generalize-a |
    fix a: Nat {
      @conclusion-covered-for-this-a |
        forall n: Nat; n = ZERO or (exists n_at2: Nat; n = succ(n_at2))
        [using import(peano) zeroOrSucc]
    }
  @conclusion |
    forall a: Nat; forall n: Nat;
      n = ZERO or (exists n_at2: Nat; n = succ(n_at2))
    [by generalize generalize-a]
qed
