// EXPECTED TO FAIL: a `termination:` entry must MATCH its arm. Here entry 3 is `_` while
// clause 2 recurses, so the obligation would be stated about a terminating arm and the
// recursion would go unchecked. Positional declarations drift silently otherwise -- an
// author who reorders the clauses leaves the recursive arm with no obligation at all.
sort N
const Z: N
const ONE: N
oper s(a: N) => N
oper add(a: N, b: N) => N
oper sub(a: N, b: N) => N

oper fib(n: N) => N:
  fib(Z) = Z;
  fib(s(Z)) = ONE;
  fib(k) = add(fib(sub(k, ONE)), fib(sub(k, ONE))).
  termination(peano): _, _, _
