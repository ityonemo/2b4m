// EXPECTED TO FAIL: `termination:` on a block that does not recurse. There is nothing to
// terminate, so the declaration names an obligation about a predicate the checker would not
// generate -- a typo'd symbol name reads exactly this way, which is why it fails loudly.
sort N
const Z: N
oper s(a: N) => N
oper helper(n: N) => N

oper twice(n: N) => N:
  twice(Z) = Z;
  twice(s(n)) = s(s(helper(n))).
  termination(peano): _, {
  twiceTerminates, twiceGrounded
  }
