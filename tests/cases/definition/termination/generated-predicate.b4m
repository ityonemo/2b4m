// What `termination(<theory>):` GENERATES for a recursive definition, and what the author owes.
//
// THE PREDICATE is synthesized as a transcription of the recursive arm's call sites, with one
// conjunct per call site and each conjunct a DISJUNCTION: that call grounded, or its argument
// hitting one of the terminating arms' patterns. The base alternatives are what make the
// recursion bottom out -- at k = TWO, sub(k, TWO) = ZERO fires its base branch with no
// recursive premise. An earlier form conjoined the bare grounded calls, had a step and no
// base, and made the obligation unprovable.
//
// THE OBLIGATION is the recursive arm's own guard, stated at the declaration's parameters:
// `less_than(ONE, n) -> fibGrounded(n)`. One antecedent, the author's own text, and directly
// usable -- `less_than(ONE, n)` is exactly what discharges `sub`'s guard in the proof.
//
// This file states both and confirms them with `by definition`. The obligation's PROOF is a
// separate exercise (strong induction; done and green elsewhere) -- here the point is the
// generated shape.
theory peano <<< "std/peano.b4m"
theory order <<< "std/peano/order.b4m"
theory subtraction <<< "std/peano/subtraction.b4m"
sort Nat = peano.Nat
const ZERO = peano.ZERO
const ONE = peano.ONE
const TWO: Nat
oper add = peano.add
oper sub = subtraction.sub
pred less_than = order.less_than

oper fib(n: Nat) => Nat:
  fib(ZERO) = ZERO;
  fib(ONE) = ONE;
  fib(n) = add(fib(sub(n, ONE)), fib(sub(n, TWO))) when less_than(ONE, n).
  totality(peano): fibCovers
  termination(peano): _, _, {
  fibIsGroundedAboveOne, fibGrounded
  }

// The obligation the declaration demands. Stated here as the thing `termination:` names, so
// `--library` checks this statement against the synthesized one.
hole fibIsGroundedAboveOne
  cites "exercise: proved by strong induction over the sort; the full proof is green elsewhere, and design/definition-wellformedness.md records its shape. This fixture is about the GENERATED statement, not its discharge":
  forall n: Nat; less_than(ONE, n) -> fibGrounded(n)

// The generated predicate, confirmed verbatim: two conjuncts (two call sites), each carrying
// both terminating arms' patterns as base alternatives.
intheory fibCovers
intheory theGeneratedPredicateTranscribesBothCallSites
theorem theGeneratedPredicateTranscribesBothCallSites: forall n: Nat;
  fibGrounded(n) iff
  ((fibGrounded(sub(n, ONE)) or sub(n, ONE) = ZERO or sub(n, ONE) = ONE)
  and (fibGrounded(sub(n, TWO)) or sub(n, TWO) = ZERO or sub(n, TWO) = ONE))
proof
  @conclusion |
    forall n: Nat;
      fibGrounded(n) iff
      ((fibGrounded(sub(n, ONE)) or sub(n, ONE) = ZERO or sub(n, ONE) = ONE)
      and (fibGrounded(sub(n, TWO)) or sub(n, TWO) = ZERO or sub(n, TWO) = ONE))
    [by definition fibGrounded]
qed

// COVERAGE. The three arms condition on `n = ZERO`, `n = ONE` and `less_than(ONE, n)`, which
// exhaust ℕ — but NOT propositionally: the three are unrelated atoms, so autodetection
// correctly declines and this must be proved. `trichotomy` at (ONE, n) supplies the split, and
// `belowOneMeansZero` turns its `n < ONE` arm into `n = ZERO`.
//
// Contrast the `cappedRun`-shaped blocks, where a base pattern sits beside its exact negation
// and coverage IS propositional — 56 of the corpus's blocks are that shape and owe nothing.
theorem fibCovers: forall n: Nat; n = ZERO or n = ONE or less_than(ONE, n)
proof
  @one-compares-with-every-nat |
    forall a: Nat; forall b: Nat; less_than(a, b) or a = b or less_than(b, a)
    [using import(order) trichotomy]
  @below-one-is-zero |
    forall i: Nat; less_than(i, peano.succ(ZERO)) -> i = ZERO
    [using import(order) belowOneMeansZero]
  @one-is-the-successor-of-zero |
    ONE = peano.succ(ZERO)
    [using import(peano) oneIsSuccZero]
  @generalize-n |
    fix n: Nat {
      @one-against-n |
        less_than(ONE, n) or ONE = n or less_than(n, ONE)
        [using specialize one-compares-with-every-nat(ONE, n)]
      @below-one-at-n |
        less_than(n, peano.succ(ZERO)) -> n = ZERO
        [using specialize below-one-is-zero(n)]
      @below-one-written-with-one |
        less_than(n, ONE) -> n = ZERO
        [by rewrite one-is-the-successor-of-zero below-one-at-n]
      // `tautology` reads `ONE = n` and `n = ONE` as UNRELATED atoms, so the orientation
      // trichotomy hands back must be flipped before it can close the disjunction.
      @given-one-equals-n |
        assume ONE = n {
          @one-equals-n |
            ONE = n
            [by hypothesis given-one-equals-n]
          @conclusion-n-equals-one |
            n = ONE
            [by symmetry one-equals-n]
        }
      @one-equals-n-gives-n-equals-one |
        ONE = n -> n = ONE
        [by discharge given-one-equals-n]
      @conclusion-covered-at-n |
        n = ZERO or n = ONE or less_than(ONE, n)
        [using tautology one-against-n below-one-written-with-one one-equals-n-gives-n-equals-one]
    }
  @conclusion |
    forall n: Nat; n = ZERO or n = ONE or less_than(ONE, n)
    [by generalize generalize-n]
qed
