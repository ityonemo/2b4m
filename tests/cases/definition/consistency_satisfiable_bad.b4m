// EXPECTED TO FAIL. THE soundness property of `definition_consistency`: it proves
// nothing itself, so it cannot be unsound.
//
// The conditions here (`k = ZERO and k = ZERO`) CAN both hold, and the consequent
// `ZERO = succ(ZERO)` is FALSE. The tactic does not inspect whether the conditions
// are contradictory — it emits an instantiation of the shared vacuity schema and the
// KERNEL checks the fit. A goal whose conditions are satisfiable does not match the
// schema's `(k = <base> and k = <step>(n))` shape, so the statement match fails and
// the error names both formulas.
theory peano <<< "std/peano.b4m"

intheory mustNotProve

theorem mustNotProve: forall k, n: peano.Nat;
  (k = peano.ZERO and k = peano.ZERO) -> peano.ZERO = peano.succ(peano.ZERO)
proof
  @conclusion |
    forall k, n: peano.Nat;
      (k = peano.ZERO and k = peano.ZERO) -> peano.ZERO = peano.succ(peano.ZERO)
    [using definition_consistency(peano)]
qed
