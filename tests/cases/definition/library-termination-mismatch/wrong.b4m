// EXPECTED TO FAIL under --library: the `termination:` theorem resolves and is TRUE, but it
// states something other than the synthesized obligation, so it settles nothing about the
// recursion. Both sides are reported, because the author never writes the obligation.
sort N
const Z: N
oper s(a: N) => N
pred unrelated(a: N)

// COVERAGE on an abstract sort: `N` has `Z`/`s` declared and nothing saying it is inductively
// generated, so the `Z` / `s(n)` split is not PROVABLE here. Stated as an axiom, the honest
// form — it is the assumption a two-arm split over this sort always rested on.
axiom nIsZeroOrSucc: forall n: N; n = Z or (exists m: N; n = s(m))

oper g(n: N) => N:
  g(Z) = Z;
  g(s(n)) = s(g(n)).
  totality(peano): gCovers
  termination(peano): _, {gTerminates, gGrounded}

axiom everythingIsUnrelated: forall a: N; unrelated(a)

intheory gCovers
intheory gTerminates
theorem gTerminates: forall a: N; unrelated(a)
proof
  @conclusion |
    forall a: N; unrelated(a)
    [by cite everythingIsUnrelated]
qed

theorem gCovers: forall n: N; n = Z or (exists n_at1: N; n = s(n_at1))
proof
  @conclusion |
    forall n: N; n = Z or (exists n_at1: N; n = s(n_at1))
    [by cite nIsZeroOrSucc]
qed
