// EXPECTED TO FAIL under `--library`: the named theorem RESOLVES and is TRUE, but states
// something other than the clause pair's obligation. A theorem proving something else
// settles nothing.
//
// The diagnostic shows BOTH sides, because the author never wrote the obligation — the
// checker synthesized it, so naming only what they did write would leave them guessing at
// the target. The `wanted` line is pasteable: ../library-ok/nrep.b4m was built from it.
theory peano <<< "std/peano.b4m"

intheory nrepCovers
intheory wrongStatement
intheory nrepBase
intheory nrepStep

// NOT RECURSIVE: the step arm returns `succ(a)` rather than recursing. What this fixture
// tests is the DIAGNOSTIC when a named theorem resolves but states something else, and that
// needs only a multi-clause block with a declaration — the recursion was incidental. A
// recursive block now owes a `termination:` obligation whose proof would bury the one
// diagnostic this fixture exists to pin.
oper nrep(a: peano.Nat, n: peano.Nat) => peano.Nat:
  nrep(a, peano.ZERO) = a;
  nrep(a, peano.succ(n)) = peano.succ(a).
  consistency: wrongStatement
  totality(peano): nrepCovers

theorem wrongStatement: peano.ZERO = peano.ZERO
proof
  @conclusion |
    peano.ZERO = peano.ZERO
    [by reflexivity]
qed

theorem nrepBase: forall a: peano.Nat; nrep(a, peano.ZERO) = a
proof
  @conclusion |
    forall a: peano.Nat; nrep(a, peano.ZERO) = a
    [by definition(0) nrep]
qed

theorem nrepStep: forall a, n: peano.Nat; nrep(a, peano.succ(n)) = peano.succ(a)
proof
  @conclusion |
    forall a, n: peano.Nat; nrep(a, peano.succ(n)) = peano.succ(a)
    [by definition(1) nrep]
qed

// COVERAGE: the arms split on `n` being peano.ZERO or a successor, which is `peano.zeroOrSucc`.
// Not propositional — the two conditions are unrelated atoms — so autodetection declines and
// this is proved. The riding binder `a` is quantified because the obligation covers the whole
// parameter list, though only the last slot is narrowed.
theorem nrepCovers: forall a: peano.Nat; forall n: peano.Nat;
  n = peano.ZERO or (exists n_at2: peano.Nat; n = peano.succ(n_at2))
proof
  @generalize-a |
    fix a: peano.Nat {
      @conclusion-covered-for-this-a |
        forall n: peano.Nat; n = peano.ZERO or (exists n_at2: peano.Nat; n = peano.succ(n_at2))
        [using import(peano) zeroOrSucc]
    }
  @conclusion |
    forall a: peano.Nat; forall n: peano.Nat;
      n = peano.ZERO or (exists n_at2: peano.Nat; n = peano.succ(n_at2))
    [by generalize generalize-a]
qed
