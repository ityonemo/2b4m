// THE WHOLE PIPELINE, passing `--library`: synthesize -> match -> discharge.
//
// The block declares `consistency: nrepConsistent`; that theorem states EXACTLY the
// obligation the checker synthesizes for clause pair (0,1) — binders in the order the
// synthesizer emits (non-matched params, then the positional slot binder `arg2`, then the
// clause variable), conditions conjoined into one flat antecedent, consequent equating the
// two arms' right-hand sides. A theorem stating anything else is rejected with both sides
// shown (see ../library-consistency-mismatch/).
//
// The proof is one `definition_consistency(peano)` step: the conditions are ℕ's two
// constructors, so peano's vacuity schema discharges it.
//
// Both clauses are also CITED, because --library's other rule rejects an unused definition.
theory peano <<< "std/peano.b4m"

intheory nrepCovers
intheory nrepConsistent
intheory nrepBase
intheory nrepStep

// NOT RECURSIVE: the step arm returns `succ(a)` rather than recursing. The pipeline this
// fixture exercises — synthesize the obligation, match it against the named theorem,
// discharge it with peano's vacuity schema — needs only a two-arm block over ℕ whose
// patterns are `ZERO` and `succ(n)`, which is preserved. Recursion was incidental, and a
// recursive block now owes a `termination:` obligation whose proof would bury the three
// lines this fixture exists to check.
oper nrep(a: peano.Nat, n: peano.Nat) => peano.Nat:
  nrep(a, peano.ZERO) = a;
  nrep(a, peano.succ(n)) = peano.succ(a).
  consistency: nrepConsistent
  totality(peano): nrepCovers

theorem nrepConsistent: forall a: peano.Nat; forall arg2: peano.Nat; forall n: peano.Nat;
  (arg2 = peano.ZERO and arg2 = peano.succ(n)) -> a = peano.succ(a)
proof
  @conclusion |
    forall a: peano.Nat; forall arg2: peano.Nat; forall n: peano.Nat;
      (arg2 = peano.ZERO and arg2 = peano.succ(n)) -> a = peano.succ(a)
    [using definition_consistency(peano)]
qed

// cite both clauses so the definition is USED (the library's other rule)
theorem nrepBase: forall a: peano.Nat; nrep(a, peano.ZERO) = a
proof
  @conclusion |
    forall a: peano.Nat; nrep(a, peano.ZERO) = a
    [by definition(0) nrep]
qed

theorem nrepStep: forall a, n: peano.Nat; nrep(a, peano.succ(n)) = peano.succ(a)
proof
  @conclusion |
    forall a, n: peano.Nat; nrep(a, peano.succ(n)) = peano.succ(a)
    [by definition(1) nrep]
qed

// COVERAGE: the arms split on `n` being peano.ZERO or a successor, which is `peano.zeroOrSucc`.
// Not propositional — the two conditions are unrelated atoms — so autodetection declines and
// this is proved. The riding binder `a` is quantified because the obligation covers the whole
// parameter list, though only the last slot is narrowed.
theorem nrepCovers: forall a: peano.Nat; forall n: peano.Nat;
  n = peano.ZERO or (exists n_at2: peano.Nat; n = peano.succ(n_at2))
proof
  @generalize-a |
    fix a: peano.Nat {
      @conclusion-covered-for-this-a |
        forall n: peano.Nat; n = peano.ZERO or (exists n_at2: peano.Nat; n = peano.succ(n_at2))
        [using import(peano) zeroOrSucc]
    }
  @conclusion |
    forall a: peano.Nat; forall n: peano.Nat;
      n = peano.ZERO or (exists n_at2: peano.Nat; n = peano.succ(n_at2))
    [by generalize generalize-a]
qed
