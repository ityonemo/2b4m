// EXPECTED TO FAIL under `--library`: the `consistency:` declaration names a theorem that
// does not exist. A library's definitions must be sound, and a declaration pointing at
// nothing settles nothing.
//
// The sibling half of this check — a multi-clause block with NO declaration at all — is not
// enforced yet: the obligations cannot be paid until the synthesizer lands, and turning it on
// early would fail `std --library` on all 72 multi-clause blocks at once. See
// DEFINITION-SOUNDNESS-PLAN.md's build order.
sort N
const Z: N
oper s(a: N) => N

oper f(n: N) => N:
  f(Z) = Z;
  f(s(n)) = s(f(n)).
  consistency: noSuchTheorem
