// deliberately broken: the cited rule rewrites ZERO on the LEFT, so the goal's
// normal forms never join — the diagnostic shows both, copy-pasteable
sort Nat
const ZERO: Nat
func succ(n: Nat): Nat
func add(a: Nat, b: Nat): Nat
axiom addZeroLeft: forall b: Nat; add(ZERO, b) = b
theorem bad: forall n: Nat; add(n, ZERO) = n
proof
  @generalize-n |
    fix n: Nat {
      @nope |
        add(n, ZERO) = n
        [using simplify addZeroLeft]
    }
  @conclusion |
    forall n: Nat; add(n, ZERO) = n
    [by forall_intro generalize-n]
qed
