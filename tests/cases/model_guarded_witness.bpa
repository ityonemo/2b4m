// BOUNDARY — existential witness (NOW HANDLED). Transferring `someUnitFixed` to a
// guarded model: its proof unpacks a witness `w` and instantiates the guarded
// axiom at `w`, so materialization owes `good(w)`. The sound relativization of the
// unpacked existential is `∃x; good(x) and P(x)` (∃ takes `and`), so unpacking `w`
// surfaces `good(w) and P(w)` — the materializer splits off `good(w)` via
// and_elim_left, registers it as the witness's guard hypothesis (discharging the
// forall_elim at `w`), and re-guards the closing `exists_intro` by conjoining
// `good(w)` back on. No author obligation needed: the guard rides in the existential.
import source <<< "model_guarded_witness_source.bpa"

sort Thing
const ZED: Thing
func combine(a: Thing, b: Thing) => Thing
pred good(x: Thing)
pred flagged(x: Thing)

axiom combineZedLeftGuarded: forall a: Thing; good(a) -> combine(ZED, a) = a
// the discharge for `something` must be the RELATIVIZED existential (∃ takes
// `and`): there is a `good` thing that is flagged.
axiom somethingThing: exists x: Thing; good(x) and flagged(x)

sort ThingGood = Thing where good

model ThingModel {
  source.Sort: ThingGood
  source.UNIT: ZED
  source.op: combine
  source.marked: flagged
  source.opUnitLeft <- combineZedLeftGuarded
  source.something <- somethingThing
  }

// the correctly-relativized statement: ∃ an x that is BOTH in the subset AND
// fixed by ZED. (The `and` — not `->` — is the sound relativization of ∃.)
theorem someCombineZedFixed: exists x: Thing; good(x) and combine(ZED, x) = x
proof
  @conclusion |
    exists x: Thing; good(x) and combine(ZED, x) = x
    [using model(ThingModel) source.someUnitFixed]
qed
