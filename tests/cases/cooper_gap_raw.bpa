// The cooper link's declared boundary WITHOUT a fallback: a multi-fixed-
// variable ∀∀∃ that Presburger decides valid but no certifier can emit, so
// default mode is a hard error (and --fast takes the accelerated verdict). The
// fallback variant that closes it purely is cooper_gap.bpa.
sort Nat
const ZERO: Nat
const ONE: Nat
func succ(n: Nat): Nat
func add(a: Nat, b: Nat): Nat
func mul(a: Nat, b: Nat): Nat
axiom addZeroLeft: forall b: Nat; add(ZERO, b) = b
axiom addSuccLeft: forall a, b: Nat; add(succ(a), b) = succ(add(a, b))
axiom addZeroRight: forall a: Nat; add(a, ZERO) = a
axiom addSuccRight: forall a, b: Nat; add(a, succ(b)) = succ(add(a, b))
axiom mulZeroLeft: forall b: Nat; mul(ZERO, b) = ZERO
axiom mulSuccLeft: forall a, b: Nat; mul(succ(a), b) = add(mul(a, b), b)
axiom oneIsSuccZero: ONE = succ(ZERO)
axiom induction(prop: Nat -> Prop):
  prop(ZERO) -> (forall k: Nat; prop(k) -> prop(succ(k))) -> forall n: Nat; prop(n)

theorem sumParity: forall a, b: Nat; exists c: Nat; add(a, b) = add(c, c) or add(a, b) = succ(add(c, c))
proof
  @conclusion |
    forall a, b: Nat; exists c: Nat; add(a, b) = add(c, c) or add(a, b) = succ(add(c, c))
    [using arithmetic]
qed
