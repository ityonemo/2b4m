// deliberately broken: a schema that transfers `source.elemInduction` through NumberModel but
// CLAIMS more than the discharging schema (goodInduction) gives — the conclusion without its
// `good(n) ->` guard. The transferred step is goodInduction's instance at the same argument,
// so the claim must be exactly that instance; instantiating the schema exposes the mismatch.
import source <<< "model_schema_source.bpa"

sort Number
const ZED: Number
func next(n: Number): Number
pred good(x: Number)

sort NumberGood = Number where good

// the guard-relativized induction schema — the discharge for elemInduction. Its
// body is elemInduction's, remapped ZE->ZED, step->next, Elem-binders guarded by
// good(...). Posited here (an axiom discharge; a proven theorem-schema would also
// be accepted by the model).
axiom goodInduction(prop: Number -> Prop):
  prop(ZED)
  -> (forall k: Number; good(k) -> prop(k) -> prop(next(k)))
  -> forall n: Number; good(n) -> prop(n)

model NumberModel {
  source.Elem: NumberGood
  source.ZE: ZED
  source.step: next
  source.elemInduction <- goodInduction
}

// the payoff: cite the transferred schema. Its statement is goodInduction's — the
// guard-relativized remap of source.elemInduction. Transfer resolves through the
// model's schema discharge (stmt_map), kernel-clean.
theorem numberInductionTransferred(prop: Number -> Prop):
  prop(ZED)
  -> (forall k: Number; good(k) -> prop(k) -> prop(next(k)))
  -> forall n: Number; prop(n)
proof
  @conclusion |
    prop(ZED)
      -> (forall k: Number; good(k) -> prop(k) -> prop(next(k)))
      -> forall n: Number; prop(n)
    [using model(NumberModel) source.elemInduction]
qed

theorem goodInductionInstance:
  good(ZED)
  -> (forall k: Number; good(k) -> good(k) -> good(next(k)))
  -> forall n: Number; good(n)
proof
  @conclusion |
    good(ZED)
      -> (forall k: Number; good(k) -> good(k) -> good(next(k)))
      -> forall n: Number; good(n)
    [using instantiation numberInductionTransferred(fun n: Number => good(n))]
qed
