// GREEN: a valid proof where @conj feeds `and_lhs` -> @left, and @left is
// consumed ONLY as a premise to a `tautology`, all inside a `fix x` block closed
// by `generalize`. The FTA proof is full of this shape; this guards that a
// live accelerant-premise chain is NOT flagged as dead. Must PASS.
sort T
pred P(x: T)
pred Q(x: T)
pred R(x: T)
const W: T

axiom pqW: forall x: T; P(x) and Q(x)
axiom rIfP: forall x: T; P(x) -> R(x)

theorem allR: forall x: T; R(x)
proof
  @generalize-x |
    fix x: T {
      @pq-at-x |
        forall y: T; P(y) and Q(y)
        [by cite pqW]
      @conj |
        P(x) and Q(x)
        [by apply_at(x) pq-at-x]
      @left |
        P(x)
        [by and_lhs conj]
      @r-if-p-all |
        forall y: T; P(y) -> R(y)
        [by cite rIfP]
      @r-if-p |
        P(x) -> R(x)
        [by apply_at(x) r-if-p-all]
      // @left is consumed ONLY as a tautology premise here.
      @conclusion-r |
        R(x)
        [using tautology r-if-p left]
    }
  @conclusion |
    forall x: T; R(x)
    [by generalize generalize-x]
qed
