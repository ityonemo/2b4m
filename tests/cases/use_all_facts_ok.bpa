// GREEN: every step is used. @bEqA is cited by @conclusion's rewrite, so no step
// is dead. The mirror of use_all_facts_bad.bpa — this one must PASS.
sort Thing
const A: Thing
const B: Thing
const C: Thing
axiom aEqB: A = B
axiom bEqC: B = C

theorem chained: A = C
proof
  @a-equals-b |
    A = B
    [by cite aEqB]
  @b-equals-c |
    B = C
    [by cite bEqC]
  @conclusion |
    A = C
    [by rewrite b-equals-c a-equals-b]
qed
