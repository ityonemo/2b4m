// MULTI-BINDER auto-weakening: a mapped axiom with TWO binders over the sort, mapped to
// ITSELF, whose relativized obligation is `∀a; inH(a) -> ∀b; inH(b) -> P` — a free
// weakening synthesized by nested fix/assume. (Single-binder is handled already;
// this exercises N-binder, needed for group axioms like opAssoc/opCommutative.)
import source <<< "model_guarded_weaken_multi_source.bpa"

sort Grp = source.Grp
const E = source.E
func op = source.op
pred inH(g: Grp)

axiom identityInH: inH(E)

sort GrpH = Grp where inH

model M {
  source.Grp: GrpH
  source.E: E(identityInH)
  source.opSwapsToE <- source.opSwapsToE
  }

// transferred: op(E,E) = op(E,E) on H. Materialization weakens the two-binder
// opSwapsToE to `∀a; inH(a) -> ∀b; inH(b) -> op(a,b)=op(b,a)` and discharges inH(E).
theorem swapAtIdentityOnH: op(E, E) = op(E, E)
proof
  @conclusion |
    op(E, E) = op(E, E)
    [using model(M) source.swapAtIdentity]
qed
