// PROBE: can Lemma 17.12 be applied to TWO different polynomials, by mapping
// `theSubject` through two different models?
//
// I claimed it could not, reasoning that a fixed `func` cannot be instantiated twice. But
// `theSubject` has NO defining axiom — nothing says which polynomial it is — so it is a
// PARAMETER, and a model maps parameters. Testing rather than reasoning this time.
import qpoly <<< "std/rational/polynomial.b4m"
import rational <<< "std/rational.b4m"
import qproduct <<< "std/rational/integer-product.b4m"
import peano <<< "std/peano.b4m"

sort Q = rational.Q
sort QPoly = qpoly.QPoly
sort Nat = peano.Nat

// two arbitrary polynomials of our own
const ALPHA: QPoly
const BETA: QPoly

// `isADenominatorFor` is an uninterpreted pred whose DEFINING AXIOM mentions `theSubject`, so
// remapping the func alone leaves the pred pointing at the old term. Each model therefore
// needs its own instance of the pred, with the corresponding axiom as the discharge.
pred alphaDenominatorFor(i: Nat, v: Q)
axiom alphaDenominatorMeaning: forall i: Nat; forall v: Q;
  alphaDenominatorFor(i, v) iff
  (rational.isInteger(v) and
  rational.less_than(rational.ZERO, v) and
  (not (v = rational.ZERO)) and
  (exists b: Q; rational.isInteger(b) and
  qpoly.qcoeff(ALPHA, i) = rational.mul(b, rational.recip(v))))

pred betaDenominatorFor(i: Nat, v: Q)
axiom betaDenominatorMeaning: forall i: Nat; forall v: Q;
  betaDenominatorFor(i, v) iff
  (rational.isInteger(v) and
  rational.less_than(rational.ZERO, v) and
  (not (v = rational.ZERO)) and
  (exists b: Q; rational.isInteger(b) and
  qpoly.qcoeff(BETA, i) = rational.mul(b, rational.recip(v))))

model SubjectIsAlpha {
  qproduct.theSubject: ALPHA
  qproduct.isADenominatorFor: alphaDenominatorFor
  qproduct.denominatorMeaning <- alphaDenominatorMeaning
}

model SubjectIsBeta {
  qproduct.theSubject: BETA
  qproduct.isADenominatorFor: betaDenominatorFor
  qproduct.denominatorMeaning <- betaDenominatorMeaning
}

// 17.12 at ALPHA
theorem alphaDecomposes: forall n: Nat;
  qpoly.qdegreeAtMost(ALPHA, n) ->
  rational.less_than(rational.ZERO, qpoly.qcoeff(ALPHA, peano.ZERO)) ->
  (exists q: QPoly; exists r, s: Q;
  qpoly.isTheIntegerDecomposition(ALPHA, q, r, s, peano.succ(n)))
proof
  @conclusion |
    forall n: Nat;
      qpoly.qdegreeAtMost(ALPHA, n) ->
      rational.less_than(rational.ZERO,
      qpoly.qcoeff(ALPHA, peano.ZERO)) ->
      (exists q: QPoly; exists r, s: Q;
      qpoly.isTheIntegerDecomposition(ALPHA, q, r, s, peano.succ(n)))
    [using model(SubjectIsAlpha) qproduct.theIntegerDecompositionExists]
qed

// and at BETA, in the SAME file
theorem betaDecomposes: forall n: Nat;
  qpoly.qdegreeAtMost(BETA, n) ->
  rational.less_than(rational.ZERO, qpoly.qcoeff(BETA, peano.ZERO)) ->
  (exists q: QPoly; exists r, s: Q;
  qpoly.isTheIntegerDecomposition(BETA, q, r, s, peano.succ(n)))
proof
  @conclusion |
    forall n: Nat;
      qpoly.qdegreeAtMost(BETA, n) ->
      rational.less_than(rational.ZERO,
      qpoly.qcoeff(BETA, peano.ZERO)) ->
      (exists q: QPoly; exists r, s: Q;
      qpoly.isTheIntegerDecomposition(BETA, q, r, s, peano.succ(n)))
    [using model(SubjectIsBeta) qproduct.theIntegerDecompositionExists]
qed
