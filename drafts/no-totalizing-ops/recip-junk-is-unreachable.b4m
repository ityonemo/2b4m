import field <<< "std/field.b4m"
sort F = field.Field
const ZERO = field.ZERO
func recip = field.recip
fact fieldInverse = field.fieldInverse

// can we say ANYTHING about recip(ZERO)? Try the analogous claim.
theorem recipOfZeroIsZero: recip(ZERO) = ZERO
proof
  @conclusion |
    recip(ZERO) = ZERO
    [using specialize fieldInverse(ZERO)]
qed
