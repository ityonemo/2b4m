import peano <<< "std/peano.b4m"
sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func sub = peano.sub
fact subZeroLeft = peano.subZeroLeft

// 0 - 1 = 0 is PROVABLE today. That is the totalizing lie.
theorem zeroMinusOneIsZero: sub(ZERO, succ(ZERO)) = ZERO
proof
  @conclusion |
    sub(ZERO, succ(ZERO)) = ZERO
    [using specialize subZeroLeft(succ(ZERO))]
qed
