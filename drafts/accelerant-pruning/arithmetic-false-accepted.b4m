// PROBE: does `using arithmetic` on a FALSE goal fail under --fast?
import peano <<< "std/peano.b4m"

const ZERO = peano.ZERO
func succ = peano.succ

// ONE = TWO is false. Does the accelerant decide it even when admitting?
theorem oneIsTwo: succ(ZERO) = succ(succ(ZERO))
proof
  @conclusion |
    succ(ZERO) = succ(succ(ZERO))
    [using arithmetic]
qed
