// PROBE: is the problem the schema's CONSTANTS, or schemas in general? This schema's body
// mentions NO source constant — the parameter is applied to a bound variable only.
sort Elem
pred marks(x: Elem)
axiom everythingIsMarked: forall x: Elem; marks(x)

theorem allHold(prop: Elem -> Prop): (forall x: Elem; prop(x)) -> forall y: Elem; prop(y)
proof
  @given |
    assume forall x: Elem; prop(x) {
      @all |
        forall x: Elem; prop(x)
        [by hypothesis given]
      @conclusion-renamed |
        forall y: Elem; prop(y)
        [by cite shuffle]
    }
  @conclusion |
    (forall x: Elem; prop(x)) -> forall y: Elem; prop(y)
    [by implies_intro given]
qed
