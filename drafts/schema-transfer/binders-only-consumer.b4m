import p <<< "binders-only.b4m"
sort Thing
pred flagged(x: Thing)
model M { p.Elem: Thing  p.marks: flagged }
theorem viaSchema: (forall x: Thing; flagged(x)) -> forall y: Thing; flagged(y)
proof
  @conclusion |
    (forall x: Thing; flagged(x)) -> forall y: Thing; flagged(y)
    [using model(M) p.allHold((fun z: p.Elem => flagged(z)))]
qed
