import lib <<< "no-such-file.b4m"
sort A = lib.X

// `2b4m check` prints "OK: 2 declarations, 0 theorems proven", exit 0 — the file
// "no-such-file.b4m" does not exist. The 2026-10-20 unused-import check correctly stays
// quiet: the import IS mentioned, by this very alias. Only RESOLUTION would catch it.
//
// Measured: sort / pred / func / const / fact all behave this way. The cause is
// ParseTask.zig:255-262 — the root scan racks a ProveTask for `.theorem => .local` only,
// and `.alias => {}` is an explicit no-op, so nothing ever demands an alias.
