// RED TEST: `chain` re-owes a guard that a step in scope has proved.
//
// Everything here is well-formed, and the SAME term elaborates fine one step earlier:
//
//   * `theClosedForm` binds `f` at the REFINED sort `OkFn`, so `inv(inv(f))` is defined at
//     every instance — the statement owes nothing;
//   * `ok(s)` is proved by `@s-is-ok` and `ok(inv(s))` by `@the-inverse-is-ok`, both before
//     any use, both in the SAME (and only) block — the proof is ground, so no `fix`, no
//     `assume`, and no discharged conclusion can be implicated;
//   * `@the-closed-form-at-s` writes `compose(compose(inv(s), swap(a, b)), inv(inv(s)))` and
//     is accepted via `[by apply_at …]`.
//
// Only the final `[using chain …]` rejects it, reporting `unproved obligation: 'ok(s)'`.
// Replacing that one step with two `[by rewrite …]` steps — the same substitutions the
// tactic performs — proves the identical goal, so the goal is true and the defect is on the
// accelerant's own path.
//
// EXPECTED (the behaviour being built): an accelerant relativizes its generated statement to
// `guard(...) -> <statement>` and discharges the guard at the call site from what is in
// scope. See the `accelerant-guard-relativization` note and SIMPLIFY-ISSUES.md.
//
// Models the three live sites in std/permutation/alternating-identities.b4m
// (`theLongCycleCommutatorIsAThreeCycle`, `theTwoThreeCyclesCommutatorIsAFiveCycle`,
// `theTwoCycleCommutatorRegrouped`): a commutator closed form containing
// `inverse(inverse(sigma))` with its point images substituted by one `simplify`.

sort Point
sort Fn
pred ok(f: Fn)
sort OkFn = Fn where ok
func inv(f: Fn) => Fn requires ok(f)
func compose(f: Fn, g: Fn) => Fn
func at(f: Fn, p: Point) => Point
func swap(p: Point, q: Point) => Fn

const s: Fn
const a: Point
const b: Point
const c: Point

axiom sIsOk: ok(s)
axiom invIsOk: forall f: Fn; ok(f) -> ok(inv(f))

// `f` at the REFINED sort, so the double inverse is defined at every instance.
axiom theClosedForm: forall f: OkFn; forall p: Point; forall q: Point;
  compose(compose(inv(f), swap(p, q)), inv(inv(f)))
    = swap(at(inv(f), p), at(inv(f), q))

axiom theFirstImage: at(inv(s), a) = c
axiom theSecondImage: at(inv(s), b) = c

theorem theImagesCollapseToOnePoint:
  compose(compose(inv(s), swap(a, b)), inv(inv(s))) = swap(c, c)
proof
  @s-is-ok |
    ok(s)
    [by cite sIsOk]
  @the-inverse-is-ok |
    ok(inv(s))
    [using specialize invIsOk(s) s-is-ok]
  @the-closed-form |
    forall f: OkFn; forall p: Point; forall q: Point;
      compose(compose(inv(f), swap(p, q)), inv(inv(f)))
        = swap(at(inv(f), p), at(inv(f), q))
    [by cite theClosedForm]
  @the-closed-form-at-s |
    compose(compose(inv(s), swap(a, b)), inv(inv(s)))
      = swap(at(inv(s), a), at(inv(s), b))
    [by apply_at(s, a, b) the-closed-form]
  @first-image |
    at(inv(s), a) = c
    [by cite theFirstImage]
  @second-image |
    at(inv(s), b) = c
    [by cite theSecondImage]
  @conclusion |
    compose(compose(inv(s), swap(a, b)), inv(inv(s))) = swap(c, c)
    [using chain the-closed-form-at-s first-image second-image]
qed
