// Can a schema-arg lambda bind two DIFFERENT sorts?
import peano <<< "std/peano.b4m"
sort Nat = peano.Nat
sort Thing
pred spec2(i: Nat, t: Thing)
theorem usesIt(p(Nat, Thing)): forall i: Nat; forall t: Thing; p(i, t) -> p(i, t)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-t |
        fix t: Thing {
          @given |
            assume p(i, t) {
              @restate |
                p(i, t)
                [by hypothesis given]
            }
          @imp |
            p(i, t) -> p(i, t)
            [by discharge given]
        }
      @dt |
        forall t: Thing; p(i, t) -> p(i, t)
        [by generalize generalize-t]
    }
  @conclusion |
    forall i: Nat; forall t: Thing; p(i, t) -> p(i, t)
    [by generalize generalize-i]
qed

// THE QUESTION: instantiate at a lambda binding Nat and Thing.
theorem probeMixedLambda: forall i: Nat; forall t: Thing; spec2(i, t) -> spec2(i, t)
proof
  @conclusion |
    forall i: Nat; forall t: Thing; spec2(i, t) -> spec2(i, t)
    [using instantiation usesIt(fun i: Nat, t: Thing => spec2(i, t))]
qed
