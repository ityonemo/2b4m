// SCHEMA INSTANCE KEYING — one bug FIXED, one still OPEN. Both found while writing Lemma
// 10.9's conjugation step in std/permutation/alternating.b4m.
//
// FIXED: `instanceHash` was NONDETERMINISTIC across runs.
//
//   It hashed entity `Index`es (`v.sort`, `v.name`, `ap.sym`). Sorts, constants, funcs and
//   preds are MINTED, not deduped (InternPool.Key), so their Index is
//   `@enumFromInt(items.len)` at first demand — allocation-ordered, hence dependent on the
//   demand SCHEDULE. Measured on this file before the fix: 4 distinct `aSchema{...}` hashes
//   across 5 whole-file runs, stable in single-theorem mode.
//
//   SEVERITY, measured rather than assumed: within any SINGLE run there was always exactly
//   ONE hash (`sort -u | wc -l` = 1 every time), so no run ever minted two instances for one
//   instantiation. Soundness was never at risk either way — the hash only names a cache slot,
//   and the kernel re-checks each instance body against its actual formula, so a mis-binding
//   would REJECT rather than falsely accept.
//
//   And the hash is NOT in user-facing output — measured across every surface: plain `check`
//   errors, `--axioms` and `--draft` show it ZERO times; only `--trace-facts`, a debug flag,
//   prints it (the cyclic-instantiation diagnostic uses the schema's SOURCE name, not the
//   instance's). So the instability was visible only under a debug flag.
//
//   What is left, and the only honest reason this was worth fixing: `termHash`'s doc comment
//   promised "deterministic, re-entry-stable" and it was not, and hashing an allocation-
//   ordered Index is a latent hazard for any future caller that keys on it across runs —
//   caching to disk, a reproducible-build check, or comparing two runs' traces.
//
//   Fix: `Schema.hashEntity` hashes `(nameOf, locOf)` — a string id, which IS content-deduped,
//   plus the source position. `termHash` took the same fix; its doc comment already claimed
//   "deterministic, re-entry-stable" and was not. `InternPool.locOf` is new.
//
//   This file now produces ONE stable hash across runs. Verify with:
//     for i in 1 2 3 4 5; do 2b4m check --trace-facts drafts/schema-instance-crosstalk.b4m \
//       2>&1 | grep -oE "aSchema\{[0-9a-f]+\}" | sort -u; done
//
// STILL OPEN: the premise mismatch below.
//
//   2b4m check drafts/schema-instance-crosstalk.b4m
//     -> error: instantiate: expected premise 'inA(e)',
//               got 'forall a: T; forall b: T; inA(a) -> inA(b) -> inA(op(a, b))'
//
//   Now DETERMINISTIC (it was not before), so the hash was a separate fault. The premises are
//   reported swapped. src/kernel.zig's `.schema_instance` arm walks `r.premises`
//   left-to-right against the instance's antecedents, which is correct — so the instance
//   formula handed to it has its antecedents in the wrong order, or a premise unsubstituted.
//
//   In the wild it also appeared as "cannot discharge the guard premise '<the whole statement
//   of a theorem>'", from `withGuardPremises` (Prove.zig) counting real premises as guards
//   when the peel loop over-runs.
//
//   NOT reproduced by a smaller fixture yet: a schema body that specializes one of its own
//   hypotheses passes on its own, and so does one specializing at a computed argument. The
//   extra ingredient here is a SECOND theorem that also specializes the same declared fact.
//
//   WORKAROUND, used in alternating.b4m: state the theorem as a single implication rather
//   than a conjunction of two results. The conjunction form triggered it; the implication
//   form does not, and is the better statement anyway since the halves compose at the call
//   site.

sort T
pred inA(x: T)
func op(a: T, b: T) => T

axiom closedOp: forall a: T; forall b: T; inA(a) -> inA(b) -> inA(op(a, b))
axiom idIn: inA(e)
const e: T

theorem aSchema(inN(T)):
  inN(e) ->
  (forall a: T; forall b: T; inN(a) -> inN(b) -> inN(op(a, b))) ->
  forall x: T; inN(x) -> inN(x)
proof
  @given-id |
    assume inN(e) {
      @given-closed |
        assume forall a: T; forall b: T; inN(a) -> inN(b) -> inN(op(a, b)) {
          @closed |
            forall a: T; forall b: T; inN(a) -> inN(b) -> inN(op(a, b))
            [by hypothesis given-closed]
          @id-in |
            inN(e)
            [by hypothesis given-id]
          @sq |
            inN(op(e, e))
            [using specialize closed(e, e) id-in id-in]
          @generalize-x |
            fix x: T {
              @given-x |
                assume inN(x) {
                  @conclusion-x |
                    inN(x)
                    [by hypothesis given-x]
                }
              @conclusion-at-x |
                inN(x) -> inN(x)
                [by discharge given-x]
            }
          @discharge-x |
            forall x: T; inN(x) -> inN(x)
            [by generalize generalize-x]
        }
      @conclusion-inner |
        (forall a: T; forall b: T; inN(a) -> inN(b) -> inN(op(a, b))) ->
          (forall x: T; inN(x) -> inN(x))
        [by discharge given-closed]
    }
  @conclusion |
    inN(e) ->
      ((forall a: T; forall b: T; inN(a) -> inN(b) -> inN(op(a, b))) ->
      (forall x: T; inN(x) -> inN(x)))
    [by discharge given-id]
qed

// INSTANTIATE the schema at inA — this is the step that poisons the next theorem
theorem theInstantiation: forall x: T; inA(x) -> inA(x)
proof
  @id |
    inA(e)
    [by cite idIn]
  @closed |
    forall a: T; forall b: T; inA(a) -> inA(b) -> inA(op(a, b))
    [by cite closedOp]
  @conclusion |
    forall x: T; inA(x) -> inA(x)
    [using instantiation aSchema((fun x: T => inA(x))) id closed]
qed

// a LATER theorem that specializes closedOp directly
theorem later: forall s: T; inA(s) -> inA(op(s, s))
proof
  @generalize-s |
    fix s: T {
      @given-s |
        assume inA(s) {
          @s-in |
            inA(s)
            [by hypothesis given-s]
          @conclusion-sq |
            inA(op(s, s))
            [using specialize closedOp(s, s) s-in s-in]
        }
      @conclusion-at-s |
        inA(s) -> inA(op(s, s))
        [by discharge given-s]
    }
  @conclusion |
    forall s: T; inA(s) -> inA(op(s, s))
    [by generalize generalize-s]
qed
