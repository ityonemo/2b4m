import mid3 <<< "mid3.b4m"
sort T
sort TS
const TZ: T
func top(a: T, b: T) => T
func tread(s: TS) => T
const TUNIT: TS
axiom topZeroLeft: forall a: T; top(TZ, a) = a
axiom tReadsTheZero: tread(TUNIT) = TZ
axiom topIsCommutative: forall a, b: T; top(a, b) = top(b, a)
model T3 {
  mid3.M: T
  mid3.MS: TS
  mid3.MZ: TZ
  mid3.mop: top
  mid3.mread: tread
  mid3.MUNIT: TUNIT
  mid3.mopZeroLeft <- topZeroLeft
  mid3.mReadsTheZero <- tReadsTheZero
  mid3.mopIsCommutative <- topIsCommutative
}
theorem tViaRewrite: forall a: T; top(tread(TUNIT), a) = a
proof
  @conclusion |
    forall a: T; top(tread(TUNIT), a) = a
    [using model(T3) mid3.mViaRewrite]
qed
