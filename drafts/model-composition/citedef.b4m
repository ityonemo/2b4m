// Can a SOURCE definition clause be cited through a model?
sort S
const SZ: S
func sop(a: S, b: S) => S
// base's op is DEFINED, not axiomatised
func sdbl(a: S) => S:
  sdbl(a) = sop(a, a)

// LOCAL citation of a definition clause — the form the cheatsheet documents.
theorem localCite: forall a: S; sdbl(a) = sop(a, a)
proof
  @conclusion |
    forall a: S; sdbl(a) = sop(a, a)
    [by definition sdbl]
qed
