// LEVEL 2 — models Base, and re-exports the theorem as a ONE-LINE TRANSFER.
import base <<< "base.b4m"

sort Mid
const MZ: Mid
func mop(a: Mid, b: Mid) => Mid
axiom mopZeroLeft: forall a: Mid; mop(MZ, a) = a
axiom mopIsCommutative: forall a, b: Mid; mop(a, b) = mop(b, a)

model MidModelsBase {
  base.Base: Mid
  base.Z: MZ
  base.op: mop
  base.opZeroLeft <- mopZeroLeft
  base.opIsCommutative <- mopIsCommutative
}

// The transfer-proved theorem. LEVEL 3 will try to re-transfer THIS.
theorem mopZeroRight: forall a: Mid; mop(a, MZ) = a
proof
  @conclusion |
    forall a: Mid; mop(a, MZ) = a
    [using model(MidModelsBase) base.opZeroRight]
qed
