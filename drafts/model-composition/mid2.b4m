// CONTROL: same as before but the carrier is OWNED, not aliased from a third theory.
import base2 <<< "base2.b4m"

sort MScalar
sort MStruct
const MSZ: MScalar
func msop(a: MScalar, b: MScalar) => MScalar
axiom msopZeroLeft: forall a: MScalar; msop(MSZ, a) = a
axiom msopIsCommutative: forall a, b: MScalar; msop(a, b) = msop(b, a)
func mreadOff(s: MStruct) => MScalar
const MSUNIT: MStruct
axiom mReadsTheZero: mreadOff(MSUNIT) = MSZ

model Mid2ModelsBase2 {
  base2.Scalar: MScalar
  base2.Struct: MStruct
  base2.SZ: MSZ
  base2.sop: msop
  base2.readOff: mreadOff
  base2.SUNIT: MSUNIT
  base2.sopZeroLeft <- msopZeroLeft
  base2.sopIsCommutative <- msopIsCommutative
  base2.readsTheZero <- mReadsTheZero
}

theorem mReadingTheUnitIsNeutral: forall a: MScalar;
  msop(mreadOff(MSUNIT), a) = a
proof
  @conclusion |
    forall a: MScalar; msop(mreadOff(MSUNIT), a) = a
    [using model(Mid2ModelsBase2) base2.readingTheUnitIsNeutral]
qed
