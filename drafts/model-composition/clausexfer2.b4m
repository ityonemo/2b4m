import base <<< "clausexfer.b4m"
sort H
const HE: H
func hop(a: H, b: H) => H
pred hnz(a: H):
  hnz(a) iff (not (a = HE))
axiom hopIdent: forall a: H; hop(HE, a) = a

model M {
  base.G: H
  base.E: HE
  base.op: hop
  base.gnz: hnz
  base.gnz <- hnz
  base.opIdent <- hopIdent
}

// does the theorem whose proof cites a clause-proved theorem transfer?
theorem transferred: forall a: H; hnz(a) -> (not (a = HE))
proof
  @conclusion |
    forall a: H; hnz(a) -> (not (a = HE))
    [using model(M) base.usesIt]
qed
