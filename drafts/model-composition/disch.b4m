// Can a model discharge a source AXIOM with a target THEOREM?
import base <<< "base.b4m"

sort T
const TZ: T
func top(a: T, b: T) => T
axiom topZeroLeftAx: forall a: T; top(TZ, a) = a
axiom topCommAx: forall a, b: T; top(a, b) = top(b, a)

// a THEOREM, not an axiom
theorem topZeroLeftThm: forall a: T; top(TZ, a) = a
proof
  @conclusion |
    forall a: T; top(TZ, a) = a
    [by cite topZeroLeftAx]
qed

model TModelsBase {
  base.Base: T
  base.Z: TZ
  base.op: top
  base.opZeroLeft <- topZeroLeftThm
  base.opIsCommutative <- topCommAx
}

theorem probe: forall a: T; top(a, TZ) = a
proof
  @conclusion |
    forall a: T; top(a, TZ) = a
    [using model(TModelsBase) base.opZeroRight]
qed
