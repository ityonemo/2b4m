import base3 <<< "base3.b4m"
sort M
sort MS
const MZ: M
func mop(a: M, b: M) => M
func mread(s: MS) => M
const MUNIT: MS
axiom mopZeroLeft: forall a: M; mop(MZ, a) = a
axiom mReadsTheZero: mread(MUNIT) = MZ
axiom mopIsCommutative: forall a, b: M; mop(a, b) = mop(b, a)
model M3 {
  base3.Scalar: M
  base3.Struct: MS
  base3.SZ: MZ
  base3.sop: mop
  base3.readOff: mread
  base3.SUNIT: MUNIT
  base3.sopZeroLeft <- mopZeroLeft
  base3.readsTheZero <- mReadsTheZero
  base3.sopIsCommutative <- mopIsCommutative
}
theorem mViaRewrite: forall a: M; mop(mread(MUNIT), a) = a
proof
  @conclusion |
    forall a: M; mop(mread(MUNIT), a) = a
    [using model(M3) base3.viaRewrite]
qed
