// KNOWN GAP (recorded in DEFINITIONS-IN-MODELS-ISSUE.md, not yet fixed): a local ALIAS of a
// definition block cannot discharge a definitional obligation. EXPECTED TO FAIL, with
//
//   'hnz' discharges the definition 'base.gnz', so it must itself be a definition block
//
// The cause is mechanical: `definitionArmCount` re-mangles the token's OWN name, so it probes
// for `definition{hnz}{0}` where the clause was published as `definition{gnz}{0}` in the
// origin file. Fix = resolve to the origin decl before probing. Workaround = name the origin
// on the discharge, qualified (`<- base.gnz`), which is what std/real/units.b4m does.
import base <<< "clausexfer.b4m"
sort H = base.G
const HE = base.E
func hop = base.op
pred hnz = base.gnz

model M {
  base.G: H
  base.E: HE
  base.op: hop
  base.gnz: hnz
  base.gnz <- hnz
  base.opIdent <- base.opIdent
}

theorem transferred: forall a: H; hnz(a) -> (not (a = HE))
proof
  @conclusion |
    forall a: H; hnz(a) -> (not (a = HE))
    [using model(M) base.usesIt]
qed
