// Can a SOURCE definition clause be CITED through a model?
//
// The companion to `defsrc2.b4m`, which covers the DISCHARGE direction. Here the local
// `tdbl` is an OPAQUE func carrying no clauses of its own, so the only route to the equation
// is the source's clause, transferred — `[using model(M) definition(0) base.sdbl]`. (A local
// definition block would make the goal true locally and prove nothing about the transfer.)
//
// Because nothing local overloads it, the source clause IS an assumption the citer inherits,
// and `--axioms` reports it as such. That is the honest reading: contrast `defsrc2.b4m`,
// where the local definition discharges it and the report names the LOCAL clause instead.
import base <<< "citedef.b4m"

sort T
const TZ: T
func top(a: T, b: T) => T
func tdbl(a: T) => T

model M {
  base.S: T
  base.SZ: TZ
  base.sop: top
  base.sdbl: tdbl
}

theorem probe: forall a: T; tdbl(a) = top(a, a)
proof
  @conclusion |
    forall a: T; tdbl(a) = top(a, a)
    [using model(M) definition(0) base.sdbl]
qed
