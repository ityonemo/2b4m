// LEVEL 1, TWO SORTS — a carrier plus a structure over it, like R and Poly.
sort Scalar
sort Struct
const SZ: Scalar
func sop(a: Scalar, b: Scalar) => Scalar
axiom sopZeroLeft: forall a: Scalar; sop(SZ, a) = a
axiom sopIsCommutative: forall a, b: Scalar; sop(a, b) = sop(b, a)

func readOff(s: Struct) => Scalar
const SUNIT: Struct
axiom readsTheZero: readOff(SUNIT) = SZ

// A real proof touching BOTH sorts.
theorem readingTheUnitIsNeutral: forall a: Scalar;
  sop(readOff(SUNIT), a) = a
proof
  @generalize-a |
    fix a: Scalar {
      @the-reading |
        readOff(SUNIT) = SZ
        [by cite readsTheZero]
      @the-neutral |
        sop(SZ, a) = a
        [using specialize sopZeroLeft(a)]
      @conclusion-inner |
        sop(readOff(SUNIT), a) = a
        [by rewrite the-reading the-neutral]
    }
  @conclusion |
    forall a: Scalar; sop(readOff(SUNIT), a) = a
    [by generalize generalize-a]
qed
