// LEVEL 1 — the abstract theory, with a real proof over its own axioms.
sort Base
const Z: Base
func op(a: Base, b: Base) => Base
axiom opZeroLeft: forall a: Base; op(Z, a) = a
axiom opIsCommutative: forall a, b: Base; op(a, b) = op(b, a)

// A THEOREM with a real proof — the thing we want to transfer twice.
theorem opZeroRight: forall a: Base; op(a, Z) = a
proof
  @generalize-a |
    fix a: Base {
      @commute |
        op(a, Z) = op(Z, a)
        [using specialize opIsCommutative(a, Z)]
      @left |
        op(Z, a) = a
        [using specialize opZeroLeft(a)]
      @conclusion-inner |
        op(a, Z) = a
        [using chain commute left]
    }
  @conclusion |
    forall a: Base; op(a, Z) = a
    [by generalize generalize-a]
qed
