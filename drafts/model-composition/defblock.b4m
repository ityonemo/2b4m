// Probe: can a definition clause carry an INNER quantifier?
import peano <<< "std/peano.b4m"
sort Nat = peano.Nat
sort P
const Z: Nat
func cf(p: P, i: Nat) => Nat

// the recursion shapes DO work as definition blocks
func run(p: P, j: Nat, m: Nat) => Nat:
  run(p, j, Z) = cf(p, j);
  run(p, j, peano.succ(m)) = peano.add(cf(p, j), run(p, peano.succ(j), m))
