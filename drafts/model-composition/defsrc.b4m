// Can a model map an obligation whose SOURCE is a definition block's clause?
// This is the shape every polynomial layer actually needs: BOTH sides definitional.
sort S
const SZ: S
func sop(a: S, b: S) => S
// the source's op is DEFINED, so its "axiom" has no user-facing name
func sdbl(a: S) => S:
  sdbl(a) = sop(a, a)

theorem sdblIsSelfOp: forall a: S; sdbl(a) = sop(a, a)
proof
  @conclusion |
    forall a: S; sdbl(a) = sop(a, a)
    [by definition sdbl]
qed
