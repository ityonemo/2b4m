import base <<< "defsrc.b4m"
sort T
const TZ: T
func top(a: T, b: T) => T
func tdbl(a: T) => T:
  tdbl(a) = top(a, a)

// Can the SOURCE side of a `<-` name a definition clause?
model M {
  base.S: T
  base.SZ: TZ
  base.sop: top
  base.sdbl: tdbl
  base.sdbl <- tdbl
}

theorem probe: forall a: T; tdbl(a) = top(a, a)
proof
  @conclusion |
    forall a: T; tdbl(a) = top(a, a)
    [using model(M) base.sdblIsSelfOp]
qed
