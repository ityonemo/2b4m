// LEVEL 3 — re-transfers the transfer-proved theorem across TWO sorts.
import mid2 <<< "mid2.b4m"

sort TScalar
sort TStruct
const TSZ: TScalar
func tsop(a: TScalar, b: TScalar) => TScalar
axiom tsopZeroLeft: forall a: TScalar; tsop(TSZ, a) = a
axiom tsopIsCommutative: forall a, b: TScalar; tsop(a, b) = tsop(b, a)
func treadOff(s: TStruct) => TScalar
const TSUNIT: TStruct
axiom tReadsTheZero: treadOff(TSUNIT) = TSZ

model Top2ModelsMid2 {
  mid2.MScalar: TScalar
  mid2.MStruct: TStruct
  mid2.MSZ: TSZ
  mid2.msop: tsop
  mid2.mreadOff: treadOff
  mid2.MSUNIT: TSUNIT
  mid2.msopZeroLeft <- tsopZeroLeft
  mid2.msopIsCommutative <- tsopIsCommutative
  mid2.mReadsTheZero <- tReadsTheZero
}

theorem tReadingTheUnitIsNeutral: forall a: TScalar;
  tsop(treadOff(TSUNIT), a) = a
proof
  @conclusion |
    forall a: TScalar; tsop(treadOff(TSUNIT), a) = a
    [using model(Top2ModelsMid2) mid2.mReadingTheUnitIsNeutral]
qed
