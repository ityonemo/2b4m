// LEVEL 3 — models Mid, and re-transfers Mid's TRANSFER-PROVED theorem.
// This is the composition under test: Top -> Mid -> Base.
import mid <<< "mid.b4m"

sort Top
const TZ: Top
func top(a: Top, b: Top) => Top
axiom topZeroLeft: forall a: Top; top(TZ, a) = a
axiom topIsCommutative: forall a, b: Top; top(a, b) = top(b, a)

model TopModelsMid {
  mid.Mid: Top
  mid.MZ: TZ
  mid.mop: top
  mid.mopZeroLeft <- topZeroLeft
  mid.mopIsCommutative <- topIsCommutative
}

// TWO HOPS onto a theorem whose own proof is a transfer.
theorem topZeroRight: forall a: Top; top(a, TZ) = a
proof
  @conclusion |
    forall a: Top; top(a, TZ) = a
    [using model(TopModelsMid) mid.mopZeroRight]
qed
