// model: the claim does not match the model transfer of the cited theorem.
import ring <<< "std/ring.b4m"
import group <<< "std/group.b4m"

sort R = ring.Ring
const zeroR = ring.ZERO
func addR = ring.add
func mulR = ring.mul

// cancelLeft transferred is about ADD; claim it about MUL
theorem bad: forall a, b, c: R; mulR(a, b) = mulR(a, c) -> b = c
proof
  @conclusion |
    forall a, b, c: R; mulR(a, b) = mulR(a, c) -> b = c
    [using model(ring.AdditiveGroup) group.cancelLeft]
qed
