// drafts/parity-lemma.b4m — JUDSON'S PARITY LEMMA, top-down, WITH HOLES.
//
// Lives outside std/ ON PURPOSE. A hole anywhere in std/ makes the whole `check std --library`
// sweep require --draft, which would blind the library gate to every other file. So the PROVED
// machinery stays in std/permutation/parity.b4m and this file carries only the scaffold that is
// still conditional.
//
// The lemma itself is PROVED here, modulo two holes: `invariantHoldsAtTheTop` (clearing the tail
// so the loop can start) and `loopTerminates` (the descent and its termination). Everything else
// — the outer strong induction, the five arithmetic facts, the four rewrite identities, the
// classification, the surgery, the fixed-point argument — is proved, most of it in std.
//
// Check with: 2b4m check --draft drafts/parity-lemma.b4m
// When the holes are filled, move the whole file into std/permutation/parity.b4m and restore
// the plain `check` gate.

import function <<< "std/function.b4m"
import permutation <<< "std/permutation.b4m"
import permutation_sequence <<< "std/permutation/sequence.b4m"
import permutation_parity <<< "std/permutation/parity.b4m"
import element <<< "std/element.b4m"
import peano <<< "std/peano.b4m"
import peano_order <<< "std/peano/order.b4m"
import peano_divides <<< "std/peano/divides.b4m"

sort Element = element.Element
sort Fn = function.Fn
const identityFn = function.identityFn
func compose = function.compose
func apply = function.apply
func transposition = permutation.transposition
theorem transpositionAtFirst = permutation.transpositionAtFirst

sort Nat = peano.Nat
const NZERO = peano.ZERO
func succ = peano.succ
func nadd = peano.add
pred nat_less_than = peano.less_than
define NTWO = succ(succ(NZERO))
define ndivides(d, n) = peano_divides.divides(d, n)
theorem strongInduction = peano_order.strongInduction
theorem natLessThanSelf = peano_order.lessThanSelf

sort Seq = permutation_sequence.Seq
func at = permutation_sequence.at
func productUpTo = permutation_sequence.productUpTo
axiom productUpToZero = permutation_sequence.productUpToZero
axiom productUpToSucc = permutation_sequence.productUpToSucc
theorem composeIdentityLeft = permutation_sequence.composeIdentityLeft

define isTransposition(t) = permutation_parity.isTransposition(t)
define allTranspositions(s, n) = permutation_parity.allTranspositions(s, n)
define someProductOfLengthIsIdentity(n) = permutation_parity.someProductOfLengthIsIdentity(n)
theorem transpositionIsNotIdentity = permutation_parity.transpositionIsNotIdentity
theorem succKIsBelowTheTail = permutation_parity.succKIsBelowTheTail
theorem aTranspositionMovesSomething = permutation_parity.aTranspositionMovesSomething
theorem zeroOrPositive = permutation_parity.zeroOrPositive
theorem transpositionsAreInvertible = permutation_parity.transpositionsAreInvertible
pred invertible = function.invertible

// -- TOP-DOWN: the inner loop as a HOLE, so the outer induction fixes its statement -----------
// Stated as what the OUTER induction needs, not as what the pieces happen to provide: from a
// product of r transpositions equal to the identity, with r at least 2, SOME product of r − 2
// transpositions is the identity. That is the whole content of Judson's inner loop, and it is
// the only thing the outer strong induction consumes.
// The four arithmetic/structural facts the outer proof turned out to need. Stated as holes
// FIRST — the outer induction dictated each signature — then discharged below.
// Every natural is 0, 1, or of the form (m+2)+d — peel two successors and take d = 0.
theorem atLeastTwoOrSmall: forall r: Nat; r = NZERO or r = succ(NZERO) or (exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d))
proof
  @generalize-r |
    fix r: Nat {
      @outer-cases |
        r = NZERO or (exists p: Nat; r = succ(p))
        [using specialize peano.zeroOrSucc(r)]
      @conclusion-shape |
        r = NZERO or r = succ(NZERO) or (exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d))
        case outer-cases {
          @when-zero |
            assume r = NZERO {
              @is-zero |
                r = NZERO
                [by hypothesis when-zero]
              @conclusion-zero |
                r = NZERO or r = succ(NZERO) or (exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d))
                [using tautology is-zero]
            }
          @when-successor |
            assume exists p: Nat; r = succ(p) {
              @has-predecessor |
                exists p: Nat; r = succ(p)
                [by hypothesis when-successor]
              @with-predecessor |
                unpack p: Nat from has-predecessor {
                  @r-is-succ-p |
                    r = succ(p)
                    [by hypothesis with-predecessor]
                  @inner-cases |
                    p = NZERO or (exists q: Nat; p = succ(q))
                    [using specialize peano.zeroOrSucc(p)]
                  @conclusion-successor |
                    r = NZERO or r = succ(NZERO) or (exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d))
                    case inner-cases {
                      @when-p-zero |
                        assume p = NZERO {
                          @p-is-zero |
                            p = NZERO
                            [by hypothesis when-p-zero]
                          @r-is-one |
                            r = succ(NZERO)
                            [by rewrite p-is-zero r-is-succ-p]
                          @conclusion-one |
                            r = NZERO or r = succ(NZERO) or (exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d))
                            [using tautology r-is-one]
                        }
                      @when-p-successor |
                        assume exists q: Nat; p = succ(q) {
                          @p-has-predecessor |
                            exists q: Nat; p = succ(q)
                            [by hypothesis when-p-successor]
                          @with-p-predecessor |
                            unpack q: Nat from p-has-predecessor {
                              @p-is-succ-q |
                                p = succ(q)
                                [by hypothesis with-p-predecessor]
                              @r-is-two-more |
                                r = succ(succ(q))
                                [by rewrite p-is-succ-q r-is-succ-p]
                              @sum-at-zero |
                                nadd(succ(succ(q)), NZERO) = succ(succ(q))
                                [using specialize peano.addZeroRight(succ(succ(q)))]
                              @sum-flipped |
                                succ(succ(q)) = nadd(succ(succ(q)), NZERO)
                                [by symmetry sum-at-zero]
                              @r-is-the-sum |
                                r = nadd(succ(succ(q)), NZERO)
                                [using chain r-is-two-more sum-flipped]
                              @inner-witness |
                                exists d: Nat; r = nadd(succ(succ(q)), d)
                                [by exists_intro(NZERO) r-is-the-sum]
                              @outer-witness |
                                exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d)
                                [by exists_intro(q) inner-witness]
                              @conclusion-at-least-two-inner |
                                r = NZERO or r = succ(NZERO) or (exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d))
                                [using tautology outer-witness]
                            }
                          @conclusion-at-least-two |
                            r = NZERO or r = succ(NZERO) or (exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d))
                            [by exists_elim with-p-predecessor]
                        }
                    }
                }
              @conclusion-with-predecessor |
                r = NZERO or r = succ(NZERO) or (exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d))
                [by exists_elim with-predecessor]
            }
        }
    }
  @conclusion |
    forall r: Nat; r = NZERO or r = succ(NZERO) or (exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d))
    [by forall_intro generalize-r]
qed
// A ONE-factor product is its single transposition, which is not the identity.
theorem noOneFactorIdentity: not someProductOfLengthIsIdentity(succ(NZERO))
proof
  @given-such-a-product |
    assume someProductOfLengthIsIdentity(succ(NZERO)) {
      @such-a-product |
        someProductOfLengthIsIdentity(succ(NZERO))
        [by hypothesis given-such-a-product]
      @sequence-exists |
        exists t: Seq; allTranspositions(t, succ(NZERO)) and productUpTo(t, succ(NZERO)) = identityFn
        [using tautology such-a-product]
      @with-sequence |
        unpack t: Seq from sequence-exists {
          @t-facts |
            allTranspositions(t, succ(NZERO)) and productUpTo(t, succ(NZERO)) = identityFn
            [by hypothesis with-sequence]
          @t-all |
            allTranspositions(t, succ(NZERO))
            [by and_elim_left t-facts]
          @t-product-is-identity |
            productUpTo(t, succ(NZERO)) = identityFn
            [by and_elim_right t-facts]
          @zero-below-one |
            nat_less_than(NZERO, succ(NZERO))
            [using specialize natLessThanSelf(NZERO)]
          @entry-is-a-transposition |
            isTransposition(at(t, NZERO))
            [using specialize t-all(NZERO) zero-below-one]
          // the one-factor product IS that entry: identity ∘ at(t,0) = at(t,0).
          @unfolds |
            productUpTo(t, succ(NZERO)) = compose(productUpTo(t, NZERO), at(t, NZERO))
            [using specialize productUpToSucc(t, NZERO)]
          @empty-is-identity |
            productUpTo(t, NZERO) = identityFn
            [using specialize productUpToZero(t)]
          @with-identity |
            productUpTo(t, succ(NZERO)) = compose(identityFn, at(t, NZERO))
            [by rewrite empty-is-identity unfolds]
          @identity-composes-away |
            compose(identityFn, at(t, NZERO)) = at(t, NZERO)
            [using specialize composeIdentityLeft(at(t, NZERO))]
          @product-is-the-entry |
            productUpTo(t, succ(NZERO)) = at(t, NZERO)
            [using chain with-identity identity-composes-away]
          @entry-is-identity |
            at(t, NZERO) = identityFn
            [using chain product-is-the-entry-flipped t-product-is-identity]
          @product-is-the-entry-flipped |
            at(t, NZERO) = productUpTo(t, succ(NZERO))
            [by symmetry product-is-the-entry]
          @entry-is-not-identity |
            at(t, NZERO) != identityFn
            [using specialize transpositionIsNotIdentity(at(t, NZERO)) entry-is-a-transposition]
          @conclusion-contradiction |
            nat_less_than(NZERO, NZERO)
            [using tautology entry-is-identity entry-is-not-identity]
        }
      @contradiction |
        nat_less_than(NZERO, NZERO)
        [by exists_elim with-sequence]
    }
  @product-implies-absurdity |
    someProductOfLengthIsIdentity(succ(NZERO)) -> nat_less_than(NZERO, NZERO)
    [by implies_intro given-such-a-product]
  @zero-not-below-itself |
    not nat_less_than(NZERO, NZERO)
    [using specialize peano_order.lessThanIrreflexive(NZERO)]
  @conclusion |
    not someProductOfLengthIsIdentity(succ(NZERO))
    [using tautology product-implies-absurdity zero-not-below-itself]
qed
theorem twoMoreCommutes: forall m: Nat; forall d: Nat; nadd(succ(succ(m)), d) = succ(succ(nadd(m, d)))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-d |
        fix d: Nat {
          @peel-outer |
            nadd(succ(succ(m)), d) = succ(nadd(succ(m), d))
            [using specialize peano.addSuccLeft(succ(m), d)]
          @peel-inner |
            nadd(succ(m), d) = succ(nadd(m, d))
            [using specialize peano.addSuccLeft(m, d)]
          @conclusion-commutes |
            nadd(succ(succ(m)), d) = succ(succ(nadd(m, d)))
            [by rewrite peel-inner peel-outer]
        }
      @discharge-d |
        forall d: Nat; nadd(succ(succ(m)), d) = succ(succ(nadd(m, d)))
        [by forall_intro generalize-d]
    }
  @conclusion |
    forall m: Nat; forall d: Nat; nadd(succ(succ(m)), d) = succ(succ(nadd(m, d)))
    [by forall_intro generalize-m]
qed

theorem droppingTwoIsSmaller: forall m: Nat; forall d: Nat; nat_less_than(nadd(m, d), nadd(succ(succ(m)), d))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-d |
        fix d: Nat {
          @sum-is-two-more |
            nadd(succ(succ(m)), d) = succ(succ(nadd(m, d)))
            [using specialize twoMoreCommutes(m, d)]
          @below-own-successor |
            nat_less_than(nadd(m, d), succ(nadd(m, d)))
            [using specialize natLessThanSelf(nadd(m, d))]
          @below-two-more |
            nat_less_than(nadd(m, d), succ(succ(nadd(m, d))))
            [using specialize peano_order.lessThanSuccRight(nadd(m, d), succ(nadd(m, d))) below-own-successor]
          @conclusion-smaller |
            nat_less_than(nadd(m, d), nadd(succ(succ(m)), d))
            [by rewrite sum-is-two-more below-two-more]
        }
      @discharge-d |
        forall d: Nat; nat_less_than(nadd(m, d), nadd(succ(succ(m)), d))
        [by forall_intro generalize-d]
    }
  @conclusion |
    forall m: Nat; forall d: Nat; nat_less_than(nadd(m, d), nadd(succ(succ(m)), d))
    [by forall_intro generalize-m]
qed

theorem twoDividesPlusTwo: forall n: Nat; forall r: Nat; ndivides(NTWO, n) -> r = succ(succ(n)) -> ndivides(NTWO, r)
proof
  @generalize-n |
    fix n: Nat {
      @generalize-r |
        fix r: Nat {
          @given-divides |
            assume ndivides(NTWO, n) {
              @given-two-more |
                assume r = succ(succ(n)) {
                  @divides-n |
                    ndivides(NTWO, n)
                    [by hypothesis given-divides]
                  @is-two-more |
                    r = succ(succ(n))
                    [by hypothesis given-two-more]
                  @two-divides-two |
                    ndivides(NTWO, NTWO)
                    [using specialize peano_divides.dividesRefl(NTWO)]
                  @divides-the-sum |
                    ndivides(NTWO, nadd(n, NTWO))
                    [using specialize peano_divides.dividesAdd(NTWO, n, NTWO) divides-n two-divides-two]
                  // n + 2 = succ(succ(n))
                  @sum-peels-once |
                    nadd(n, succ(succ(NZERO))) = succ(nadd(n, succ(NZERO)))
                    [using specialize peano.addSuccRight(n, succ(NZERO))]
                  @sum-peels-twice |
                    nadd(n, succ(NZERO)) = succ(nadd(n, NZERO))
                    [using specialize peano.addSuccRight(n, NZERO)]
                  @sum-at-zero |
                    nadd(n, NZERO) = n
                    [using specialize peano.addZeroRight(n)]
                  @sum-is-succ-n |
                    nadd(n, succ(NZERO)) = succ(n)
                    [by rewrite sum-at-zero sum-peels-twice]
                  @sum-is-two-more |
                    nadd(n, succ(succ(NZERO))) = succ(succ(n))
                    [by rewrite sum-is-succ-n sum-peels-once]
                  @divides-two-more |
                    ndivides(NTWO, succ(succ(n)))
                    [by rewrite sum-is-two-more divides-the-sum]
                  @conclusion-divides-r |
                    ndivides(NTWO, r)
                    [by rewrite is-two-more divides-two-more]
                }
              @two-more-implies |
                r = succ(succ(n)) -> ndivides(NTWO, r)
                [by implies_intro given-two-more]
            }
          @divides-implies |
            ndivides(NTWO, n) -> r = succ(succ(n)) -> ndivides(NTWO, r)
            [by implies_intro given-divides]
        }
      @discharge-r |
        forall r: Nat; ndivides(NTWO, n) -> r = succ(succ(n)) -> ndivides(NTWO, r)
        [by forall_intro generalize-r]
    }
  @conclusion |
    forall n: Nat; forall r: Nat; ndivides(NTWO, n) -> r = succ(succ(n)) -> ndivides(NTWO, r)
    [by forall_intro generalize-n]
qed

// -- STEP 4: THE PARITY LEMMA, by strong induction on the factor count ------------------------
// r = 0 is even. r = 1 is impossible: a one-factor product is its single transposition, which is
// not the identity. For r >= 2 the inner loop gives a product of r − 2, even by the hypothesis,
// so r is even.
theorem identityIsEvenLength: forall r: Nat; someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r)
proof
  @strong-step |
    fix r: Nat {
      @given-smaller-cases |
        assume forall q: Nat; nat_less_than(q, r) -> (someProductOfLengthIsIdentity(q) -> ndivides(NTWO, q)) {
          @smaller-cases |
            forall q: Nat; nat_less_than(q, r) -> (someProductOfLengthIsIdentity(q) -> ndivides(NTWO, q))
            [by hypothesis given-smaller-cases]
          @given-identity-product |
            assume someProductOfLengthIsIdentity(r) {
              @identity-product |
                someProductOfLengthIsIdentity(r)
                [by hypothesis given-identity-product]
              // r is 0, 1, or at least 2 — and only the last needs the loop.
              @r-shape |
                r = NZERO or r = succ(NZERO) or (exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d))
                [using specialize atLeastTwoOrSmall(r)]
              @conclusion-even |
                ndivides(NTWO, r)
                case r-shape {
                  @when-zero |
                    assume r = NZERO {
                      @is-zero |
                        r = NZERO
                        [by hypothesis when-zero]
                      @two-divides-zero |
                        ndivides(NTWO, NZERO)
                        [using specialize peano_divides.dividesZero(NTWO)]
                      @conclusion-zero-is-even |
                        ndivides(NTWO, r)
                        [by rewrite is-zero two-divides-zero]
                    }
                  @when-one |
                    assume r = succ(NZERO) {
                      @is-one |
                        r = succ(NZERO)
                        [by hypothesis when-one]
                      @one-product |
                        someProductOfLengthIsIdentity(succ(NZERO))
                        [by rewrite is-one identity-product]
                      @no-single-transposition |
                        not someProductOfLengthIsIdentity(succ(NZERO))
                        [by cite noOneFactorIdentity]
                      @conclusion-one-absurd |
                        ndivides(NTWO, r)
                        [using tautology one-product no-single-transposition]
                    }
                  @when-at-least-two |
                    assume exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d) {
                      @decomposes |
                        exists m: Nat; exists d: Nat; r = nadd(succ(succ(m)), d)
                        [by hypothesis when-at-least-two]
                      @with-m |
                        unpack m: Nat from decomposes {
                          @d-exists |
                            exists d: Nat; r = nadd(succ(succ(m)), d)
                            [by hypothesis with-m]
                          @with-d |
                            unpack d: Nat from d-exists {
                              @r-is-sum |
                                r = nadd(succ(succ(m)), d)
                                [by hypothesis with-d]
                              @product-at-sum |
                                someProductOfLengthIsIdentity(nadd(succ(succ(m)), d))
                                [by rewrite r-is-sum identity-product]
                              @shorter-product |
                                someProductOfLengthIsIdentity(nadd(m, d))
                                [using specialize innerLoopDropsTwo(m, d) product-at-sum]
                              @shorter-is-smaller |
                                nat_less_than(nadd(m, d), r)
                                [by rewrite r-is-sum shorter-below-sum]
                              @shorter-below-sum |
                                nat_less_than(nadd(m, d), nadd(succ(succ(m)), d))
                                [using specialize droppingTwoIsSmaller(m, d)]
                              @shorter-is-even |
                                ndivides(NTWO, nadd(m, d))
                                [using specialize smaller-cases(nadd(m, d)) shorter-is-smaller shorter-product]
                              @conclusion-sum-is-even |
                                ndivides(NTWO, r)
                                [using specialize twoDividesPlusTwo(nadd(m, d), r) shorter-is-even r-is-two-more]
                              @r-is-two-more |
                                r = succ(succ(nadd(m, d)))
                                [using chain r-is-sum sum-is-two-more]
                              @sum-is-two-more |
                                nadd(succ(succ(m)), d) = succ(succ(nadd(m, d)))
                                [using specialize twoMoreCommutes(m, d)]
                            }
                          @conclusion-with-d |
                            ndivides(NTWO, r)
                            [by exists_elim with-d]
                        }
                      @conclusion-at-least-two |
                        ndivides(NTWO, r)
                        [by exists_elim with-m]
                    }
                }
            }
          @product-implies |
            someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r)
            [by implies_intro given-identity-product]
        }
      @strong-step-at-r |
        (forall q: Nat; nat_less_than(q, r) -> (someProductOfLengthIsIdentity(q) -> ndivides(NTWO, q))) -> (someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r))
        [by implies_intro given-smaller-cases]
    }
  @strong-step-for-all |
    forall r: Nat; (forall q: Nat; nat_less_than(q, r) -> (someProductOfLengthIsIdentity(q) -> ndivides(NTWO, q))) -> (someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r))
    [by forall_intro strong-step]
  @conclusion |
    forall r: Nat; someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r)
    [using instantiation strongInduction((fun r: Nat => someProductOfLengthIsIdentity(r) -> ndivides(NTWO, r))) strong-step-for-all]
qed

// -- the loop invariant, and the descending loop as its own hole -------------------------------
// Writing the ENDPOINT first exposed what two bottom-up attempts had missed: the invariant must
// be TWO-SIDED. "Every entry above j fixes `a`" alone is not contradictory at j = 0 — STEP 3
// then says entry 0 fixes `a`, which is merely true. The contradiction needs the other half,
// that entry j MOVES `a`: at j = 0 the letter is moved by entry 0 and by nothing above it, so
// the product moves it, and the product is the identity.
// FIFTH CONJUNCT `nat_less_than(j, r)`, added 2026-09-30: without it the invariant does not
// place j inside the sequence, so the body cannot conclude that entries j and j+1 are
// transpositions (allTranspositions only speaks about indices below the length). It is not
// derivable from the other four — `at(w, j)` is defined at every index, so "entry j moves `a`"
// says nothing about j being in range. It comes free wherever the invariant is established.
define loopInvariant(a, j, r) = exists w: Seq; allTranspositions(w, r) and productUpTo(w, r) = identityFn and apply(at(w, j), a) != a and (forall i: Nat; nat_less_than(j, i) -> nat_less_than(i, r) -> apply(at(w, i), a) = a) and nat_less_than(j, r)

// The invariant holds at the TOP INDEX, for free — and getting this right needed a correction.
// I first stated it at index m+1 of a length-((m+2)+d) product, which is WRONG: the d entries
// above m+1 are not known to fix `a`, so the invariant's "above" clause is unmet. The fix is to
// take the letter from the LAST entry. Over a length `succ(q)` the top index is q, and "every
// entry strictly above q and below succ(q)" is VACUOUS — there are no such indices. So the
// sequence itself witnesses the invariant, with no tail to clear.
theorem invariantHoldsAtTheTop: forall a: Element; forall s: Seq; forall q: Nat;
  allTranspositions(s, succ(q)) ->
  productUpTo(s, succ(q)) = identityFn ->
  apply(at(s, q), a) != a ->
  loopInvariant(a, q, succ(q))
proof
  @generalize-a |
    fix a: Element {
      @generalize-s |
        fix s: Seq {
          @generalize-q |
            fix q: Nat {
              @given-all |
                assume allTranspositions(s, succ(q)) {
                  @given-identity |
                    assume productUpTo(s, succ(q)) = identityFn {
                      @given-moves |
                        assume apply(at(s, q), a) != a {
                          @all-transpositions |
                            allTranspositions(s, succ(q))
                            [by hypothesis given-all]
                          @is-identity |
                            productUpTo(s, succ(q)) = identityFn
                            [by hypothesis given-identity]
                          @top-moves-a |
                            apply(at(s, q), a) != a
                            [by hypothesis given-moves]
                          // nothing is strictly above q and strictly below succ(q).
                          @nothing-above |
                            forall i: Nat; nat_less_than(q, i) -> nat_less_than(i, succ(q)) -> apply(at(s, i), a) = a
                            [by forall_intro vacuous]
                          @vacuous |
                            fix i: Nat {
                              @given-above-q |
                                assume nat_less_than(q, i) {
                                  @given-below-succ-q |
                                    assume nat_less_than(i, succ(q)) {
                                      @above-q |
                                        nat_less_than(q, i)
                                        [by hypothesis given-above-q]
                                      @below-succ-q |
                                        nat_less_than(i, succ(q))
                                        [by hypothesis given-below-succ-q]
                                      @at-most-q |
                                        nat_less_than(i, q) or i = q
                                        [using specialize peano_order.lessThanSuccSplit(i, q) below-succ-q]
                                      @q-below-q |
                                        nat_less_than(q, q)
                                        [using tautology at-most-q above-q q-transitive q-self]
                                      @q-transitive |
                                        nat_less_than(q, i) -> nat_less_than(i, q) -> nat_less_than(q, q)
                                        [using specialize transitivityAsImplication(q, i, q)]
                                      @q-self |
                                        i = q -> nat_less_than(q, q)
                                        [using specialize rewriteAboveIntoSelf(q, i) above-q]
                                      @not-q-below-q |
                                        not nat_less_than(q, q)
                                        [using specialize peano_order.lessThanIrreflexive(q)]
                                      @conclusion-vacuously |
                                        apply(at(s, i), a) = a
                                        [using tautology q-below-q not-q-below-q]
                                    }
                                  @below-implies |
                                    nat_less_than(i, succ(q)) -> apply(at(s, i), a) = a
                                    [by implies_intro given-below-succ-q]
                                }
                              @above-implies |
                                nat_less_than(q, i) -> nat_less_than(i, succ(q)) -> apply(at(s, i), a) = a
                                [by implies_intro given-above-q]
                            }
                          @q-below-succ-q |
                            nat_less_than(q, succ(q))
                            [using specialize natLessThanSelf(q)]
                          @all-facts |
                            allTranspositions(s, succ(q)) and productUpTo(s, succ(q)) = identityFn and apply(at(s, q), a) != a and (forall i: Nat; nat_less_than(q, i) -> nat_less_than(i, succ(q)) -> apply(at(s, i), a) = a) and nat_less_than(q, succ(q))
                            [using tautology all-transpositions is-identity top-moves-a nothing-above q-below-succ-q]
                          @conclusion-invariant |
                            loopInvariant(a, q, succ(q))
                            [by exists_intro(s) all-facts]
                        }
                      @moves-implies |
                        apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
                        [by implies_intro given-moves]
                    }
                  @identity-implies |
                    productUpTo(s, succ(q)) = identityFn -> apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
                    [by implies_intro given-identity]
                }
              @all-implies |
                allTranspositions(s, succ(q)) -> productUpTo(s, succ(q)) = identityFn -> apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
                [by implies_intro given-all]
            }
          @discharge-q |
            forall q: Nat; allTranspositions(s, succ(q)) -> productUpTo(s, succ(q)) = identityFn -> apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
            [by forall_intro generalize-q]
        }
      @discharge-s |
        forall s: Seq; forall q: Nat; allTranspositions(s, succ(q)) -> productUpTo(s, succ(q)) = identityFn -> apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
        [by forall_intro generalize-s]
    }
  @conclusion |
    forall a: Element; forall s: Seq; forall q: Nat; allTranspositions(s, succ(q)) -> productUpTo(s, succ(q)) = identityFn -> apply(at(s, q), a) != a -> loopInvariant(a, q, succ(q))
    [by forall_intro generalize-a]
qed

theorem transitivityAsImplication = peano_order.lessThanTransitive

// q < i and i = q give q < q — a rewrite, packaged as the implication `tautology` needs
// (it cannot see that an equation relates two of its atoms).
theorem rewriteAboveIntoSelf: forall q: Nat; forall i: Nat; nat_less_than(q, i) -> (i = q -> nat_less_than(q, q))
proof
  @generalize-q |
    fix q: Nat {
      @generalize-i |
        fix i: Nat {
          @given-above |
            assume nat_less_than(q, i) {
              @above |
                nat_less_than(q, i)
                [by hypothesis given-above]
              @given-equal |
                assume i = q {
                  @equal |
                    i = q
                    [by hypothesis given-equal]
                  @conclusion-self |
                    nat_less_than(q, q)
                    [by rewrite equal above]
                }
              @equal-implies |
                i = q -> nat_less_than(q, q)
                [by implies_intro given-equal]
            }
          @above-implies |
            nat_less_than(q, i) -> (i = q -> nat_less_than(q, q))
            [by implies_intro given-above]
        }
      @discharge-i |
        forall i: Nat; nat_less_than(q, i) -> (i = q -> nat_less_than(q, q))
        [by forall_intro generalize-i]
    }
  @conclusion |
    forall q: Nat; forall i: Nat; nat_less_than(q, i) -> (i = q -> nat_less_than(q, q))
    [by forall_intro generalize-q]
qed

// NOTE on a hole that turned out to be unnecessary. I first stated a separate `loopDescends`
// for the loop BODY (invariant at succ(j) gives either the drop or the invariant at j). Nothing
// cites it: `loopTerminates` below is the descent AND its termination in one statement, and its
// proof will do the body inline. The checker did not complain — an uncited hole is simply not a
// hole anyone depends on — so it was removed by hand. Worth knowing: holes are disclosed by what
// DEPENDS on them, which means a stub you never wire up is invisible rather than flagged.

// A length above succ(j) decomposes as (j+2)+e — the form the surgery states its product
// equality in. Straight from lessThanElim's gap.
theorem lengthDecomposesAboveThePair: forall j: Nat; forall r: Nat;
  nat_less_than(succ(j), r) -> exists e: Nat; r = nadd(succ(succ(j)), e)
proof
  @generalize-j |
    fix j: Nat {
      @generalize-r |
        fix r: Nat {
          @given-above |
            assume nat_less_than(succ(j), r) {
              @above |
                nat_less_than(succ(j), r)
                [by hypothesis given-above]
              @gap-exists |
                exists g: Nat; nadd(succ(j), succ(g)) = r
                [using specialize peano_order.lessThanElim(succ(j), r) above]
              @with-gap |
                unpack g: Nat from gap-exists {
                  @gap |
                    nadd(succ(j), succ(g)) = r
                    [by hypothesis with-gap]
                  // (j+1) + (g+1) = (j+2) + g
                  @shift-the-successor |
                    nadd(succ(j), succ(g)) = succ(nadd(succ(j), g))
                    [using specialize peano.addSuccRight(succ(j), g)]
                  @peel-the-left |
                    nadd(succ(succ(j)), g) = succ(nadd(succ(j), g))
                    [using specialize peano.addSuccLeft(succ(j), g)]
                  @same-value |
                    nadd(succ(j), succ(g)) = nadd(succ(succ(j)), g)
                    [using chain shift-the-successor peel-the-left-flipped]
                  @peel-the-left-flipped |
                    succ(nadd(succ(j), g)) = nadd(succ(succ(j)), g)
                    [by symmetry peel-the-left]
                  @r-is-the-sum |
                    r = nadd(succ(succ(j)), g)
                    [using chain gap-flipped same-value]
                  @gap-flipped |
                    r = nadd(succ(j), succ(g))
                    [by symmetry gap]
                  @conclusion-witnessed |
                    exists e: Nat; r = nadd(succ(succ(j)), e)
                    [by exists_intro(g) r-is-the-sum]
                }
              @conclusion-decomposes |
                exists e: Nat; r = nadd(succ(succ(j)), e)
                [by exists_elim with-gap]
            }
          @above-implies |
            nat_less_than(succ(j), r) -> exists e: Nat; r = nadd(succ(succ(j)), e)
            [by implies_intro given-above]
        }
      @discharge-r |
        forall r: Nat; nat_less_than(succ(j), r) -> exists e: Nat; r = nadd(succ(succ(j)), e)
        [by forall_intro generalize-r]
    }
  @conclusion |
    forall j: Nat; forall r: Nat; nat_less_than(succ(j), r) -> exists e: Nat; r = nadd(succ(succ(j)), e)
    [by forall_intro generalize-j]
qed

// -- DELETING the cancelling pair ------------------------------------------------------------
// The cancel branch needs a sequence of length r − 2. Deleting positions (j, j+1) gives one,
// and — following this layer's idiom, where a sequence postulate carries its own product law
// (compare `seqConcat`, `seqReverse` in std/permutation/sequence.b4m) — the postulate states
// the product directly rather than leaving a fold argument to the caller. Sound because the
// deleted pair composes to the identity, so it contributes nothing to the fold.
axiom seqDeleteCancellingPair: forall s: Seq; forall j: Nat; forall e: Nat;
  compose(at(s, j), at(s, succ(j))) = identityFn ->
  exists v: Seq;
  (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i))
  and (forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i)))
  and productUpTo(v, nadd(j, e)) = productUpTo(s, nadd(succ(succ(j)), e))

// Its entries are all transpositions when `s`'s are: every entry is copied from `s`, either
// from below j or from two positions further up.
theorem deletedSequenceIsAllTranspositions: forall s: Seq; forall v: Seq; forall j: Nat; forall n: Nat; forall e: Nat;
  allTranspositions(s, nadd(succ(succ(j)), e)) ->
  (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i)) ->
  (forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i))) ->
  n = nadd(j, e) ->
  allTranspositions(v, n)
proof
  @generalize-s |
    fix s: Seq {
      @generalize-v |
        fix v: Seq {
          @generalize-j |
            fix j: Nat {
              @generalize-n |
                fix n: Nat {
                  @generalize-e |
                    fix e: Nat {
                      @given-all |
                        assume allTranspositions(s, nadd(succ(succ(j)), e)) {
                          @given-below |
                            assume forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i) {
                              @given-tail |
                                assume forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i)) {
                                  @given-length |
                                    assume n = nadd(j, e) {
                                      @s-all |
                                        allTranspositions(s, nadd(succ(succ(j)), e))
                                        [by hypothesis given-all]
                                      @v-below |
                                        forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i)
                                        [by hypothesis given-below]
                                      @v-tail |
                                        forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i))
                                        [by hypothesis given-tail]
                                      @length |
                                        n = nadd(j, e)
                                        [by hypothesis given-length]
                                      @generalize-i |
                                        fix i: Nat {
                                          @given-below-n |
                                            assume nat_less_than(i, n) {
                                              @i-below-n |
                                                nat_less_than(i, n)
                                                [by hypothesis given-below-n]
                                              @i-below-sum |
                                                nat_less_than(i, nadd(j, e))
                                                [by rewrite length i-below-n]
                                              @i-position |
                                                nat_less_than(i, j) or (exists g: Nat; i = nadd(j, g) and nat_less_than(g, e))
                                                [using specialize splitBelowASum(i, j, e) i-below-sum]
                                              @conclusion-i-is-a-transposition |
                                                isTransposition(at(v, i))
                                                case i-position {
                                                  @when-below |
                                                    assume nat_less_than(i, j) {
                                                      @below |
                                                        nat_less_than(i, j)
                                                        [by hypothesis when-below]
                                                      @copied |
                                                        at(v, i) = at(s, i)
                                                        [using specialize v-below(i) below]
                                                      @i-below-the-length |
                                                        nat_less_than(i, nadd(succ(succ(j)), e))
                                                        [using specialize belowJIsBelowTheLength(i, j, e) below]
                                                      @s-at-i |
                                                        isTransposition(at(s, i))
                                                        [using specialize s-all(i) i-below-the-length]
                                                      @conclusion-below |
                                                        isTransposition(at(v, i))
                                                        [by rewrite copied s-at-i]
                                                    }
                                                  @when-in-the-tail |
                                                    assume exists g: Nat; i = nadd(j, g) and nat_less_than(g, e) {
                                                      @tail-index-exists |
                                                        exists g: Nat; i = nadd(j, g) and nat_less_than(g, e)
                                                        [by hypothesis when-in-the-tail]
                                                      @with-tail-index |
                                                        unpack g: Nat from tail-index-exists {
                                                          @g-facts |
                                                            i = nadd(j, g) and nat_less_than(g, e)
                                                            [by hypothesis with-tail-index]
                                                          @i-is-shifted |
                                                            i = nadd(j, g)
                                                            [by and_elim_left g-facts]
                                                          @g-below-e |
                                                            nat_less_than(g, e)
                                                            [by and_elim_right g-facts]
                                                          @copied-from-the-tail |
                                                            at(v, nadd(j, g)) = at(s, nadd(succ(succ(j)), g))
                                                            [using specialize v-tail(g)]
                                                          @source-below-the-length |
                                                            nat_less_than(nadd(succ(succ(j)), g), nadd(succ(succ(j)), e))
                                                            [using specialize additionPreservesOrderOnTheRight(g, e, succ(succ(j))) g-below-e]
                                                          @s-at-the-source |
                                                            isTransposition(at(s, nadd(succ(succ(j)), g)))
                                                            [using specialize s-all(nadd(succ(succ(j)), g)) source-below-the-length]
                                                          @v-at-shifted |
                                                            isTransposition(at(v, nadd(j, g)))
                                                            [by rewrite copied-from-the-tail s-at-the-source]
                                                          @conclusion-in-the-tail-inner |
                                                            isTransposition(at(v, i))
                                                            [by rewrite i-is-shifted v-at-shifted]
                                                        }
                                                      @conclusion-in-the-tail |
                                                        isTransposition(at(v, i))
                                                        [by exists_elim with-tail-index]
                                                    }
                                                }
                                            }
                                          @below-n-implies |
                                            nat_less_than(i, n) -> isTransposition(at(v, i))
                                            [by implies_intro given-below-n]
                                        }
                                      @conclusion-v-all |
                                        allTranspositions(v, n)
                                        [by forall_intro generalize-i]
                                    }
                                  @length-implies |
                                    n = nadd(j, e) -> allTranspositions(v, n)
                                    [by implies_intro given-length]
                                }
                              @tail-implies |
                                (forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i))) -> n = nadd(j, e) -> allTranspositions(v, n)
                                [by implies_intro given-tail]
                            }
                          @below-implies |
                            (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i))) -> n = nadd(j, e) -> allTranspositions(v, n)
                            [by implies_intro given-below]
                        }
                      @all-implies |
                        allTranspositions(s, nadd(succ(succ(j)), e)) -> (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i))) -> n = nadd(j, e) -> allTranspositions(v, n)
                        [by implies_intro given-all]
                    }
                  @discharge-e |
                    forall e: Nat; allTranspositions(s, nadd(succ(succ(j)), e)) -> (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i))) -> n = nadd(j, e) -> allTranspositions(v, n)
                    [by forall_intro generalize-e]
                }
              @discharge-n |
                forall n: Nat; forall e: Nat; allTranspositions(s, nadd(succ(succ(j)), e)) -> (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i))) -> n = nadd(j, e) -> allTranspositions(v, n)
                [by forall_intro generalize-n]
            }
          @discharge-j |
            forall j: Nat; forall n: Nat; forall e: Nat; allTranspositions(s, nadd(succ(succ(j)), e)) -> (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i))) -> n = nadd(j, e) -> allTranspositions(v, n)
            [by forall_intro generalize-j]
        }
      @discharge-v |
        forall v: Seq; forall j: Nat; forall n: Nat; forall e: Nat; allTranspositions(s, nadd(succ(succ(j)), e)) -> (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i))) -> n = nadd(j, e) -> allTranspositions(v, n)
        [by forall_intro generalize-v]
    }
  @conclusion |
    forall s: Seq; forall v: Seq; forall j: Nat; forall n: Nat; forall e: Nat; allTranspositions(s, nadd(succ(succ(j)), e)) -> (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(s, i)) -> (forall i: Nat; at(v, nadd(j, i)) = at(s, nadd(succ(succ(j)), i))) -> n = nadd(j, e) -> allTranspositions(v, n)
    [by forall_intro generalize-s]
qed

theorem additionPreservesOrderOnTheRight = peano_order.additionPreservesOrder

// i < j gives i < (j+2)+e: j <= j+2 <= (j+2)+e.
theorem belowJIsBelowTheLength: forall i: Nat; forall j: Nat; forall e: Nat; nat_less_than(i, j) -> nat_less_than(i, nadd(succ(succ(j)), e))
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @generalize-e |
            fix e: Nat {
              @given-below |
                assume nat_less_than(i, j) {
                  @below |
                    nat_less_than(i, j)
                    [by hypothesis given-below]
                  @j-below-succ |
                    nat_less_than(j, succ(j))
                    [using specialize natLessThanSelf(j)]
                  @j-below-two-more |
                    nat_less_than(j, succ(succ(j)))
                    [using specialize peano_order.lessThanSuccRight(j, succ(j)) j-below-succ]
                  @i-below-two-more |
                    nat_less_than(i, succ(succ(j)))
                    [using specialize peano_order.lessThanTransitive(i, j, succ(succ(j))) below j-below-two-more]
                  @bound-at-every-overshoot |
                    forall e2: Nat; nat_less_than(i, nadd(succ(succ(j)), e2))
                    [using specialize permutation_parity.weakLeftBound(i, succ(succ(j))) i-below-two-more]
                  @conclusion-below-the-length |
                    nat_less_than(i, nadd(succ(succ(j)), e))
                    [using specialize bound-at-every-overshoot(e)]
                }
              @below-implies |
                nat_less_than(i, j) -> nat_less_than(i, nadd(succ(succ(j)), e))
                [by implies_intro given-below]
            }
          @discharge-e |
            forall e: Nat; nat_less_than(i, j) -> nat_less_than(i, nadd(succ(succ(j)), e))
            [by forall_intro generalize-e]
        }
      @discharge-j |
        forall j: Nat; forall e: Nat; nat_less_than(i, j) -> nat_less_than(i, nadd(succ(succ(j)), e))
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; forall e: Nat; nat_less_than(i, j) -> nat_less_than(i, nadd(succ(succ(j)), e))
    [by forall_intro generalize-i]
qed

// An index below j+e is either below j, or is j+g for some g below e. Trichotomy splits at j;
// on the upper side `lessOrEqualIsGapExistential` names the gap, and cancelling j off the
// original bound puts the gap below e.
theorem splitBelowASum: forall i: Nat; forall j: Nat; forall e: Nat; nat_less_than(i, nadd(j, e)) -> (nat_less_than(i, j) or (exists g: Nat; i = nadd(j, g) and nat_less_than(g, e)))
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @generalize-e |
            fix e: Nat {
              @given-below-sum |
                assume nat_less_than(i, nadd(j, e)) {
                  @below-sum |
                    nat_less_than(i, nadd(j, e))
                    [by hypothesis given-below-sum]
                  @split-at-j |
                    nat_less_than(i, j) or i = j or nat_less_than(j, i)
                    [using specialize peano_order.trichotomy(i, j)]
                  @conclusion-split |
                    nat_less_than(i, j) or (exists g: Nat; i = nadd(j, g) and nat_less_than(g, e))
                    case split-at-j {
                      @when-below-j |
                        assume nat_less_than(i, j) {
                          @below-j |
                            nat_less_than(i, j)
                            [by hypothesis when-below-j]
                          @conclusion-below |
                            nat_less_than(i, j) or (exists g: Nat; i = nadd(j, g) and nat_less_than(g, e))
                            [by or_intro_left below-j]
                        }
                      @when-equal |
                        assume i = j {
                          @equal |
                            i = j
                            [by hypothesis when-equal]
                          // i = j = j + 0, and 0 < e because i < j+e forces e positive.
                          @j-plus-zero |
                            nadd(j, NZERO) = j
                            [using specialize peano.addZeroRight(j)]
                          @j-is-j-plus-zero |
                            j = nadd(j, NZERO)
                            [by symmetry j-plus-zero]
                          @i-is-j-plus-zero |
                            i = nadd(j, NZERO)
                            [using chain equal j-is-j-plus-zero]
                          @zero-below-e |
                            nat_less_than(NZERO, e)
                            [using specialize overshootIsPositive(i, j, e) below-sum equal]
                          @witnessed |
                            i = nadd(j, NZERO) and nat_less_than(NZERO, e)
                            [by and_intro i-is-j-plus-zero zero-below-e]
                          @gap-exists |
                            exists g: Nat; i = nadd(j, g) and nat_less_than(g, e)
                            [by exists_intro(NZERO) witnessed]
                          @conclusion-equal |
                            nat_less_than(i, j) or (exists g: Nat; i = nadd(j, g) and nat_less_than(g, e))
                            [by or_intro_right gap-exists]
                        }
                      @when-above-j |
                        assume nat_less_than(j, i) {
                          @above-j |
                            nat_less_than(j, i)
                            [by hypothesis when-above-j]
                          @gap-to-i-exists |
                            exists g: Nat; nadd(j, succ(g)) = i
                            [using specialize peano_order.lessThanElim(j, i) above-j]
                          @with-gap |
                            unpack g: Nat from gap-to-i-exists {
                              @gap |
                                nadd(j, succ(g)) = i
                                [by hypothesis with-gap]
                              @i-is-shifted |
                                i = nadd(j, succ(g))
                                [by symmetry gap]
                              // j + succ(g) < j + e cancels to succ(g) < e.
                              @shifted-below-sum |
                                nat_less_than(nadd(j, succ(g)), nadd(j, e))
                                [by rewrite i-is-shifted below-sum]
                              @overshoot-below-e |
                                nat_less_than(succ(g), e)
                                [using specialize peano_order.lessThanAddCancelLeft(j, succ(g), e) shifted-below-sum]
                              @witnessed |
                                i = nadd(j, succ(g)) and nat_less_than(succ(g), e)
                                [by and_intro i-is-shifted overshoot-below-e]
                              @gap-witnessed |
                                exists g2: Nat; i = nadd(j, g2) and nat_less_than(g2, e)
                                [by exists_intro(succ(g)) witnessed]
                              @conclusion-above-inner |
                                nat_less_than(i, j) or (exists g2: Nat; i = nadd(j, g2) and nat_less_than(g2, e))
                                [by or_intro_right gap-witnessed]
                            }
                          @conclusion-above |
                            nat_less_than(i, j) or (exists g: Nat; i = nadd(j, g) and nat_less_than(g, e))
                            [by exists_elim with-gap]
                        }
                    }
                }
              @below-sum-implies |
                nat_less_than(i, nadd(j, e)) -> (nat_less_than(i, j) or (exists g: Nat; i = nadd(j, g) and nat_less_than(g, e)))
                [by implies_intro given-below-sum]
            }
          @discharge-e |
            forall e: Nat; nat_less_than(i, nadd(j, e)) -> (nat_less_than(i, j) or (exists g: Nat; i = nadd(j, g) and nat_less_than(g, e)))
            [by forall_intro generalize-e]
        }
      @discharge-j |
        forall j: Nat; forall e: Nat; nat_less_than(i, nadd(j, e)) -> (nat_less_than(i, j) or (exists g: Nat; i = nadd(j, g) and nat_less_than(g, e)))
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; forall e: Nat; nat_less_than(i, nadd(j, e)) -> (nat_less_than(i, j) or (exists g: Nat; i = nadd(j, g) and nat_less_than(g, e)))
    [by forall_intro generalize-i]
qed

// i = j and i < j+e force 0 < e: were e ZERO, j+e would be j and j < j.
theorem overshootIsPositive: forall i: Nat; forall j: Nat; forall e: Nat; nat_less_than(i, nadd(j, e)) -> i = j -> nat_less_than(NZERO, e)
proof
  @generalize-i |
    fix i: Nat {
      @generalize-j |
        fix j: Nat {
          @generalize-e |
            fix e: Nat {
              @given-below |
                assume nat_less_than(i, nadd(j, e)) {
                  @given-equal |
                    assume i = j {
                      @below |
                        nat_less_than(i, nadd(j, e))
                        [by hypothesis given-below]
                      @equal |
                        i = j
                        [by hypothesis given-equal]
                      @j-below-sum |
                        nat_less_than(j, nadd(j, e))
                        [by rewrite equal below]
                      @e-shape |
                        e = NZERO or nat_less_than(NZERO, e)
                        [using specialize zeroOrPositive(e)]
                      @conclusion-positive |
                        nat_less_than(NZERO, e)
                        case e-shape {
                          @when-zero |
                            assume e = NZERO {
                              @e-is-zero |
                                e = NZERO
                                [by hypothesis when-zero]
                              @j-plus-zero |
                                nadd(j, NZERO) = j
                                [using specialize peano.addZeroRight(j)]
                              @j-below-j-plus-zero |
                                nat_less_than(j, nadd(j, NZERO))
                                [by rewrite e-is-zero j-below-sum]
                              @j-below-itself |
                                nat_less_than(j, j)
                                [by rewrite j-plus-zero j-below-j-plus-zero]
                              @not-below-itself |
                                not nat_less_than(j, j)
                                [using specialize peano_order.lessThanIrreflexive(j)]
                              @conclusion-absurd |
                                nat_less_than(NZERO, e)
                                [using tautology j-below-itself not-below-itself]
                            }
                          @when-positive |
                            assume nat_less_than(NZERO, e) {
                              @conclusion-directly |
                                nat_less_than(NZERO, e)
                                [by hypothesis when-positive]
                            }
                        }
                    }
                  @equal-implies |
                    i = j -> nat_less_than(NZERO, e)
                    [by implies_intro given-equal]
                }
              @below-implies |
                nat_less_than(i, nadd(j, e)) -> i = j -> nat_less_than(NZERO, e)
                [by implies_intro given-below]
            }
          @discharge-e |
            forall e: Nat; nat_less_than(i, nadd(j, e)) -> i = j -> nat_less_than(NZERO, e)
            [by forall_intro generalize-e]
        }
      @discharge-j |
        forall j: Nat; forall e: Nat; nat_less_than(i, nadd(j, e)) -> i = j -> nat_less_than(NZERO, e)
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall i: Nat; forall j: Nat; forall e: Nat; nat_less_than(i, nadd(j, e)) -> i = j -> nat_less_than(NZERO, e)
    [by forall_intro generalize-i]
qed

// A transposition that MOVES `a` can be written with `a` FIRST — which is the form the
// classification demands of its right factor. `a` is one of the two letters
// (movedBySwapIsOneOfItsLetters); if it is the second, transpositionIsSymmetric swaps them.
theorem movingTranspositionWithTheLetterFirst: forall t: Fn; forall a: Element;
  isTransposition(t) -> apply(t, a) != a ->
  (exists b: Element; a != b and t = transposition(a, b))
proof
  @generalize-t |
    fix t: Fn {
      @generalize-a |
        fix a: Element {
          @given-transposition |
            assume isTransposition(t) {
              @given-moves |
                assume apply(t, a) != a {
                  @is-a-transposition |
                    isTransposition(t)
                    [by hypothesis given-transposition]
                  @moves-a |
                    apply(t, a) != a
                    [by hypothesis given-moves]
                  @letters-exist |
                    exists x: Element; exists y: Element; x != y and t = transposition(x, y)
                    [using tautology is-a-transposition]
                  @with-first |
                    unpack x: Element from letters-exist {
                      @second-exists |
                        exists y: Element; x != y and t = transposition(x, y)
                        [by hypothesis with-first]
                      @with-second |
                        unpack y: Element from second-exists {
                          @facts |
                            x != y and t = transposition(x, y)
                            [by hypothesis with-second]
                          @xy |
                            x != y
                            [by and_elim_left facts]
                          @t-is-the-swap |
                            t = transposition(x, y)
                            [by and_elim_right facts]
                          @swap-moves-a |
                            apply(transposition(x, y), a) != a
                            [by rewrite t-is-the-swap moves-a]
                          @a-is-a-letter |
                            a = x or a = y
                            [using specialize permutation_parity.movedBySwapIsOneOfItsLetters(x, y, a) swap-moves-a]
                          @conclusion-normalized |
                            exists b: Element; a != b and t = transposition(a, b)
                            case a-is-a-letter {
                              @when-a-is-x |
                                assume a = x {
                                  @a-is-x |
                                    a = x
                                    [by hypothesis when-a-is-x]
                                  @distinct-at-a |
                                    a != y
                                    [by rewrite a-is-x xy]
                                  @swap-at-a |
                                    t = transposition(a, y)
                                    [by rewrite a-is-x t-is-the-swap]
                                  @witnessed |
                                    a != y and t = transposition(a, y)
                                    [by and_intro distinct-at-a swap-at-a]
                                  @conclusion-a-first |
                                    exists b: Element; a != b and t = transposition(a, b)
                                    [by exists_intro(y) witnessed]
                                }
                              @when-a-is-y |
                                assume a = y {
                                  @a-is-y |
                                    a = y
                                    [by hypothesis when-a-is-y]
                                  // t = (x y) = (y x) = (a x), and x != a.
                                  @reversed |
                                    transposition(x, y) = transposition(y, x)
                                    [using specialize permutation_parity.transpositionIsSymmetric(x, y)]
                                  @t-reversed |
                                    t = transposition(y, x)
                                    [using chain t-is-the-swap reversed]
                                  @t-at-a |
                                    t = transposition(a, x)
                                    [by rewrite a-is-y t-reversed]
                                  @y-not-x |
                                    y != x
                                    [using specialize permutation_parity.distinctSymmetric(x, y) xy]
                                  @distinct-at-a |
                                    a != x
                                    [by rewrite a-is-y y-not-x]
                                  @witnessed |
                                    a != x and t = transposition(a, x)
                                    [by and_intro distinct-at-a t-at-a]
                                  @conclusion-a-first |
                                    exists b: Element; a != b and t = transposition(a, b)
                                    [by exists_intro(x) witnessed]
                                }
                            }
                        }
                      @conclusion-second |
                        exists b: Element; a != b and t = transposition(a, b)
                        [by exists_elim with-second]
                    }
                  @conclusion-normalized-outer |
                    exists b: Element; a != b and t = transposition(a, b)
                    [by exists_elim with-first]
                }
              @moves-implies |
                apply(t, a) != a -> (exists b: Element; a != b and t = transposition(a, b))
                [by implies_intro given-moves]
            }
          @transposition-implies |
            isTransposition(t) -> apply(t, a) != a -> (exists b: Element; a != b and t = transposition(a, b))
            [by implies_intro given-transposition]
        }
      @discharge-a |
        forall a: Element; isTransposition(t) -> apply(t, a) != a -> (exists b: Element; a != b and t = transposition(a, b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall t: Fn; forall a: Element; isTransposition(t) -> apply(t, a) != a -> (exists b: Element; a != b and t = transposition(a, b))
    [by forall_intro generalize-t]
qed

// -- the CANCEL branch, on its own ------------------------------------------------------------
// The pair at (j, j+1) composes to the identity: delete it. The shortened sequence has length
// (m+d), is all transpositions, and its product is the original's — the identity.
theorem cancelBranchDropsTwo: forall w: Seq; forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat;
  allTranspositions(w, nadd(succ(succ(m)), d)) ->
  productUpTo(w, nadd(succ(succ(m)), d)) = identityFn ->
  nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) ->
  nadd(m, d) = nadd(j, e) ->
  compose(at(w, j), at(w, succ(j))) = identityFn ->
  someProductOfLengthIsIdentity(nadd(m, d))
proof
  @generalize-w |
    fix w: Seq {
      @generalize-j |
        fix j: Nat {
          @generalize-m |
            fix m: Nat {
              @generalize-d |
                fix d: Nat {
                  @generalize-e |
                    fix e: Nat {
                      @given-all |
                        assume allTranspositions(w, nadd(succ(succ(m)), d)) {
                          @given-identity |
                            assume productUpTo(w, nadd(succ(succ(m)), d)) = identityFn {
                              @given-length |
                                assume nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) {
                                  @given-short |
                                    assume nadd(m, d) = nadd(j, e) {
                                      @given-cancels |
                                        assume compose(at(w, j), at(w, succ(j))) = identityFn {
                                          @w-all |
                                            allTranspositions(w, nadd(succ(succ(m)), d))
                                            [by hypothesis given-all]
                                          @w-identity |
                                            productUpTo(w, nadd(succ(succ(m)), d)) = identityFn
                                            [by hypothesis given-identity]
                                          @length-form |
                                            nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e)
                                            [by hypothesis given-length]
                                          @short-form |
                                            nadd(m, d) = nadd(j, e)
                                            [by hypothesis given-short]
                                          @cancels |
                                            compose(at(w, j), at(w, succ(j))) = identityFn
                                            [by hypothesis given-cancels]
                                          @w-all-at-form |
                                            allTranspositions(w, nadd(succ(succ(j)), e))
                                            [by rewrite length-form w-all]
                                          @w-identity-at-form |
                                            productUpTo(w, nadd(succ(succ(j)), e)) = identityFn
                                            [by rewrite length-form w-identity]
                                          @deleted-exists |
                                            exists v: Seq; (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(w, i)) and (forall i: Nat; at(v, nadd(j, i)) = at(w, nadd(succ(succ(j)), i))) and productUpTo(v, nadd(j, e)) = productUpTo(w, nadd(succ(succ(j)), e))
                                            [using specialize seqDeleteCancellingPair(w, j, e) cancels]
                                          @with-deleted |
                                            unpack v: Seq from deleted-exists {
                                              @v-facts |
                                                (forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(w, i)) and (forall i: Nat; at(v, nadd(j, i)) = at(w, nadd(succ(succ(j)), i))) and productUpTo(v, nadd(j, e)) = productUpTo(w, nadd(succ(succ(j)), e))
                                                [by hypothesis with-deleted]
                                              @v-below |
                                                forall i: Nat; nat_less_than(i, j) -> at(v, i) = at(w, i)
                                                [using tautology v-facts]
                                              @v-tail |
                                                forall i: Nat; at(v, nadd(j, i)) = at(w, nadd(succ(succ(j)), i))
                                                [using tautology v-facts]
                                              @v-product |
                                                productUpTo(v, nadd(j, e)) = productUpTo(w, nadd(succ(succ(j)), e))
                                                [using tautology v-facts]
                                              @v-product-is-identity |
                                                productUpTo(v, nadd(j, e)) = identityFn
                                                [using chain v-product w-identity-at-form]
                                              @v-product-at-short |
                                                productUpTo(v, nadd(m, d)) = identityFn
                                                [by rewrite short-form v-product-is-identity]
                                              @v-all |
                                                allTranspositions(v, nadd(m, d))
                                                [using specialize deletedSequenceIsAllTranspositions(w, v, j, nadd(m, d), e) w-all-at-form v-below v-tail short-form]
                                              @witnessed |
                                                allTranspositions(v, nadd(m, d)) and productUpTo(v, nadd(m, d)) = identityFn
                                                [by and_intro v-all v-product-at-short]
                                              @conclusion-shorter-inner |
                                                someProductOfLengthIsIdentity(nadd(m, d))
                                                [by exists_intro(v) witnessed]
                                            }
                                          @conclusion-shorter |
                                            someProductOfLengthIsIdentity(nadd(m, d))
                                            [by exists_elim with-deleted]
                                        }
                                      @cancels-implies |
                                        compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(nadd(m, d))
                                        [by implies_intro given-cancels]
                                    }
                                  @short-implies |
                                    nadd(m, d) = nadd(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(nadd(m, d))
                                    [by implies_intro given-short]
                                }
                              @length-implies |
                                nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(nadd(m, d))
                                [by implies_intro given-length]
                            }
                          @identity-implies |
                            productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(nadd(m, d))
                            [by implies_intro given-identity]
                        }
                      @all-implies |
                        allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(nadd(m, d))
                        [by implies_intro given-all]
                    }
                  @discharge-e |
                    forall e: Nat; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(nadd(m, d))
                    [by forall_intro generalize-e]
                }
              @discharge-d |
                forall d: Nat; forall e: Nat; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(nadd(m, d))
                [by forall_intro generalize-d]
            }
          @discharge-m |
            forall m: Nat; forall d: Nat; forall e: Nat; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(nadd(m, d))
            [by forall_intro generalize-m]
        }
      @discharge-j |
        forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(nadd(m, d))
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall w: Seq; forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e) -> compose(at(w, j), at(w, succ(j))) = identityFn -> someProductOfLengthIsIdentity(nadd(m, d))
    [by forall_intro generalize-w]
qed


// -- the SHIFT branch, on its own -------------------------------------------------------------
// The pair at (j, j+1) equals (p, q) with q FIXING `a` and p MOVING it. Rewrite it in place:
// the product is unchanged (still the identity), entries outside {j, j+1} are untouched (so
// everything above j+1 still fixes `a`), position j+1 now holds q which fixes `a`, and
// position j holds p which moves it. That is exactly the invariant at j.
theorem shiftBranchKeepsTheInvariant: forall w: Seq; forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
proof
  @generalize-w |
    fix w: Seq {
      @generalize-a |
        fix a: Element {
          @generalize-j |
            fix j: Nat {
              @generalize-m |
                fix m: Nat {
                  @generalize-d |
                    fix d: Nat {
                      @generalize-e |
                        fix e: Nat {
                          @generalize-p |
                            fix p: Fn {
                              @generalize-q |
                                fix q: Fn {
                                    @given-all |
                                      assume allTranspositions(w, nadd(succ(succ(m)), d)) {
                                        @given-identity |
                                          assume productUpTo(w, nadd(succ(succ(m)), d)) = identityFn {
                                            @given-above |
                                              assume forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a {
                                                @given-length |
                                                  assume nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) {
                                                    @given-p-trans |
                                                      assume isTransposition(p) {
                                                        @given-q-trans |
                                                          assume isTransposition(q) {
                                                            @given-pair |
                                                              assume compose(p, q) = compose(at(w, j), at(w, succ(j))) {
                                                                @given-q-fixes |
                                                                  assume apply(q, a) = a {
                                                                    @given-p-moves |
                                                                      assume apply(p, a) != a {
                                                                          @all |
                                                                            allTranspositions(w, nadd(succ(succ(m)), d))
                                                                            [by hypothesis given-all]
                                                                          @identity |
                                                                            productUpTo(w, nadd(succ(succ(m)), d)) = identityFn
                                                                            [by hypothesis given-identity]
                                                                          @above |
                                                                            forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a
                                                                            [by hypothesis given-above]
                                                                          @length |
                                                                            nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e)
                                                                            [by hypothesis given-length]
                                                                          @p-trans |
                                                                            isTransposition(p)
                                                                            [by hypothesis given-p-trans]
                                                                          @q-trans |
                                                                            isTransposition(q)
                                                                            [by hypothesis given-q-trans]
                                                                          @pair |
                                                                            compose(p, q) = compose(at(w, j), at(w, succ(j)))
                                                                            [by hypothesis given-pair]
                                                                          @q-fixes |
                                                                            apply(q, a) = a
                                                                            [by hypothesis given-q-fixes]
                                                                          @p-moves |
                                                                            apply(p, a) != a
                                                                            [by hypothesis given-p-moves]
                                                                          @p-invertible |
                                                                            invertible(p)
                                                                            [using specialize transpositionsAreInvertible(p) p-trans]
                                                                          @q-invertible |
                                                                            invertible(q)
                                                                            [using specialize transpositionsAreInvertible(q) q-trans]
                                                                          @rewritten-exists |
                                                                            exists u: Seq; at(u, j) = p and at(u, succ(j)) = q and (forall i: Nat; nat_less_than(i, j) -> at(u, i) = at(w, i)) and (forall i: Nat; nat_less_than(succ(j), i) -> at(u, i) = at(w, i)) and productUpTo(u, nadd(succ(succ(j)), e)) = productUpTo(w, nadd(succ(succ(j)), e))
                                                                            [using specialize permutation_parity.rewritingAPairKeepsTheWholeProduct(w, j, e, p, q) p-invertible q-invertible pair]
                                                                          @with-rewritten |
                                                                            unpack u: Seq from rewritten-exists {
                                                                              @u-facts |
                                                                                at(u, j) = p and at(u, succ(j)) = q and (forall i: Nat; nat_less_than(i, j) -> at(u, i) = at(w, i)) and (forall i: Nat; nat_less_than(succ(j), i) -> at(u, i) = at(w, i)) and productUpTo(u, nadd(succ(succ(j)), e)) = productUpTo(w, nadd(succ(succ(j)), e))
                                                                                [by hypothesis with-rewritten]
                                                                              @u-at-j |
                                                                                at(u, j) = p
                                                                                [using tautology u-facts]
                                                                              @u-at-succ-j |
                                                                                at(u, succ(j)) = q
                                                                                [using tautology u-facts]
                                                                              @u-below |
                                                                                forall i: Nat; nat_less_than(i, j) -> at(u, i) = at(w, i)
                                                                                [using tautology u-facts]
                                                                              @u-above |
                                                                                forall i: Nat; nat_less_than(succ(j), i) -> at(u, i) = at(w, i)
                                                                                [using tautology u-facts]
                                                                              @u-product |
                                                                                productUpTo(u, nadd(succ(succ(j)), e)) = productUpTo(w, nadd(succ(succ(j)), e))
                                                                                [using tautology u-facts]
                                                                              @u-at-j-is-a-transposition |
                                                                                isTransposition(at(u, j))
                                                                                [by rewrite u-at-j p-trans]
                                                                              @u-at-succ-j-is-a-transposition |
                                                                                isTransposition(at(u, succ(j)))
                                                                                [by rewrite u-at-succ-j q-trans]
                                                                              @u-all |
                                                                                allTranspositions(u, nadd(succ(succ(m)), d))
                                                                                [using specialize permutation_parity.rewrittenSequenceIsAllTranspositions(w, u, j, nadd(succ(succ(m)), d)) all u-at-j-is-a-transposition u-at-succ-j-is-a-transposition u-below u-above]
                                                                              @w-product-at-form |
                                                                                productUpTo(w, nadd(succ(succ(j)), e)) = identityFn
                                                                                [by rewrite length identity]
                                                                              @u-product-at-form |
                                                                                productUpTo(u, nadd(succ(succ(j)), e)) = identityFn
                                                                                [using chain u-product w-product-at-form]
                                                                              @u-product-at-the-length |
                                                                                productUpTo(u, nadd(succ(succ(m)), d)) = identityFn
                                                                                [by rewrite length u-product-at-form]
                                                                              @u-at-j-moves-a |
                                                                                apply(at(u, j), a) != a
                                                                                [by rewrite u-at-j p-moves]
                                                                              @u-above-fixes |
                                                                                forall i: Nat; nat_less_than(j, i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(u, i), a) = a
                                                                                [by forall_intro above-j-fixes]
                                                                              @above-j-fixes |
                                                                                fix i: Nat {
                                                                                  @given-above-j |
                                                                                    assume nat_less_than(j, i) {
                                                                                      @given-below-length |
                                                                                        assume nat_less_than(i, nadd(succ(succ(m)), d)) {
                                                                                          @above-j |
                                                                                            nat_less_than(j, i)
                                                                                            [by hypothesis given-above-j]
                                                                                          @below-length |
                                                                                            nat_less_than(i, nadd(succ(succ(m)), d))
                                                                                            [by hypothesis given-below-length]
                                                                                          @position |
                                                                                            i = succ(j) or nat_less_than(succ(j), i)
                                                                                            [using specialize permutation_parity.successorSplit(j, i) above-j]
                                                                                          @conclusion-fixes |
                                                                                            apply(at(u, i), a) = a
                                                                                            case position {
                                                                                              @when-at-succ-j |
                                                                                                assume i = succ(j) {
                                                                                                  @at-succ-j |
                                                                                                    i = succ(j)
                                                                                                    [by hypothesis when-at-succ-j]
                                                                                                  @entry-is-q |
                                                                                                    at(u, i) = q
                                                                                                    [by rewrite at-succ-j u-at-succ-j]
                                                                                                  @conclusion-q-fixes |
                                                                                                    apply(at(u, i), a) = a
                                                                                                    [by rewrite entry-is-q q-fixes]
                                                                                                }
                                                                                              @when-strictly-above |
                                                                                                assume nat_less_than(succ(j), i) {
                                                                                                  @strictly-above |
                                                                                                    nat_less_than(succ(j), i)
                                                                                                    [by hypothesis when-strictly-above]
                                                                                                  @copied |
                                                                                                    at(u, i) = at(w, i)
                                                                                                    [using specialize u-above(i) strictly-above]
                                                                                                  @w-fixes |
                                                                                                    apply(at(w, i), a) = a
                                                                                                    [using specialize above(i) strictly-above below-length]
                                                                                                  @conclusion-copied-fixes |
                                                                                                    apply(at(u, i), a) = a
                                                                                                    [by rewrite copied w-fixes]
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                      @below-implies |
                                                                                        nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(u, i), a) = a
                                                                                        [by implies_intro given-below-length]
                                                                                    }
                                                                                  @above-implies |
                                                                                    nat_less_than(j, i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(u, i), a) = a
                                                                                    [by implies_intro given-above-j]
                                                                                }
                                                                              @j-below-succ-j |
              nat_less_than(j, succ(j))
              [using specialize natLessThanSelf(j)]
            @succ-j-below-the-length |
              nat_less_than(succ(j), nadd(succ(succ(m)), d))
              [by rewrite length succ-j-below-at-form]
            @succ-j-below-at-form |
              nat_less_than(succ(j), nadd(succ(succ(j)), e))
              [using specialize permutation_parity.succKIsBelowTheTail(j, e)]
            @j-below-the-length |
              nat_less_than(j, nadd(succ(succ(m)), d))
              [using specialize peano_order.lessThanTransitive(j, succ(j), nadd(succ(succ(m)), d)) j-below-succ-j succ-j-below-the-length]
            @all-four |
                                                                                allTranspositions(u, nadd(succ(succ(m)), d)) and productUpTo(u, nadd(succ(succ(m)), d)) = identityFn and apply(at(u, j), a) != a and (forall i: Nat; nat_less_than(j, i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(u, i), a) = a) and nat_less_than(j, nadd(succ(succ(m)), d))
                                                                                [using tautology u-all u-product-at-the-length u-at-j-moves-a u-above-fixes j-below-the-length]
                                                                              @conclusion-invariant-inner |
                                                                                loopInvariant(a, j, nadd(succ(succ(m)), d))
                                                                                [by exists_intro(u) all-four]
                                                                            }
                                                                          @conclusion-invariant |
                                                                            loopInvariant(a, j, nadd(succ(succ(m)), d))
                                                                            [by exists_elim with-rewritten]
                                                                      }
                                                                    @p-moves-implies |
                                                                      apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                                                                      [by implies_intro given-p-moves]
                                                                  }
                                                                @q-fixes-implies |
                                                                  apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                                                                  [by implies_intro given-q-fixes]
                                                              }
                                                            @pair-implies |
                                                              compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                                                              [by implies_intro given-pair]
                                                          }
                                                        @q-trans-implies |
                                                          isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                                                          [by implies_intro given-q-trans]
                                                      }
                                                    @p-trans-implies |
                                                      isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                                                      [by implies_intro given-p-trans]
                                                  }
                                                @length-implies |
                                                  nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                                                  [by implies_intro given-length]
                                              }
                                            @above-implies |
                                              (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                                              [by implies_intro given-above]
                                          }
                                        @identity-implies |
                                          productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                                          [by implies_intro given-identity]
                                      }
                                    @all-implies |
                                      allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                                      [by implies_intro given-all]
                                }
                              @discharge-q |
                                forall q: Fn; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                                [by forall_intro generalize-q]
                            }
                          @discharge-p |
                            forall p: Fn; forall q: Fn; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                            [by forall_intro generalize-p]
                        }
                      @discharge-e |
                        forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                        [by forall_intro generalize-e]
                    }
                  @discharge-d |
                    forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                    [by forall_intro generalize-d]
                }
              @discharge-m |
                forall m: Nat; forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
                [by forall_intro generalize-m]
            }
          @discharge-j |
            forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
            [by forall_intro generalize-j]
        }
      @discharge-a |
        forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall w: Seq; forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; forall e: Nat; forall p: Fn; forall q: Fn; allTranspositions(w, nadd(succ(succ(m)), d)) -> productUpTo(w, nadd(succ(succ(m)), d)) = identityFn -> (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) -> nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> isTransposition(p) -> isTransposition(q) -> compose(p, q) = compose(at(w, j), at(w, succ(j))) -> apply(q, a) = a -> apply(p, a) != a -> loopInvariant(a, j, nadd(succ(succ(m)), d))
    [by forall_intro generalize-w]
qed

// (m+2)+d = (j+2)+e cancels the two successors: m+d = j+e. Both sides are
// succ(succ(·)) of the shorter sums (twoMoreCommutes), so succInjective twice finishes it.
theorem shortLengthMatches: forall m: Nat; forall d: Nat; forall j: Nat; forall e: Nat;
  nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e)
proof
  @generalize-m |
    fix m: Nat {
      @generalize-d |
        fix d: Nat {
          @generalize-j |
            fix j: Nat {
              @generalize-e |
                fix e: Nat {
                  @given-equal |
                    assume nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) {
                      @equal |
                        nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e)
                        [by hypothesis given-equal]
                      @left-form |
                        nadd(succ(succ(m)), d) = succ(succ(nadd(m, d)))
                        [using specialize twoMoreCommutes(m, d)]
                      @right-form |
                        nadd(succ(succ(j)), e) = succ(succ(nadd(j, e)))
                        [using specialize twoMoreCommutes(j, e)]
                      @left-is-right-form |
                        succ(succ(nadd(m, d))) = nadd(succ(succ(j)), e)
                        [using chain left-form-flipped equal]
                      @left-form-flipped |
                        succ(succ(nadd(m, d))) = nadd(succ(succ(m)), d)
                        [by symmetry left-form]
                      @successors-equal |
                        succ(succ(nadd(m, d))) = succ(succ(nadd(j, e)))
                        [using chain left-is-right-form right-form]
                      @once-cancelled |
                        succ(nadd(m, d)) = succ(nadd(j, e))
                        [using specialize peano.succInjective(succ(nadd(m, d)), succ(nadd(j, e))) successors-equal]
                      @conclusion-cancelled |
                        nadd(m, d) = nadd(j, e)
                        [using specialize peano.succInjective(nadd(m, d), nadd(j, e)) once-cancelled]
                    }
                  @equal-implies |
                    nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e)
                    [by implies_intro given-equal]
                }
              @discharge-e |
                forall e: Nat; nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e)
                [by forall_intro generalize-e]
            }
          @discharge-j |
            forall j: Nat; forall e: Nat; nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e)
            [by forall_intro generalize-j]
        }
      @discharge-d |
        forall d: Nat; forall j: Nat; forall e: Nat; nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e)
        [by forall_intro generalize-d]
    }
  @conclusion |
    forall m: Nat; forall d: Nat; forall j: Nat; forall e: Nat; nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e) -> nadd(m, d) = nadd(j, e)
    [by forall_intro generalize-m]
qed

// The loop BODY: from the invariant at succ(j), either the length has dropped or the
// invariant holds at j. This is where the classification meets the surgery.
// loopBody's conclusion stated with the `loopInvariant` DEFINE rather than expanded, which is
// the form loopTerminates cites (the expanded form binds its witness under a generated name).
theorem loopBodyAsInvariant: forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat;
  loopInvariant(a, succ(j), nadd(succ(succ(m)), d)) ->
  (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
proof
  @conclusion |
    forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; loopInvariant(a, succ(j), nadd(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
    [by cite loopBody]
qed

// -- THE LOOP BODY, assembled -----------------------------------------------------------------
// One turn of Judson's loop. Unpack the invariant at j+1, name the letters of the two entries,
// normalize entry j+1 so the letter comes first, classify the pair, and dispatch to whichever
// branch the classification returns. Both branches are proved above.
theorem loopBody: forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; loopInvariant(a, succ(j), nadd(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
proof
  @generalize-a |
    fix a: Element {
      @generalize-j |
        fix j: Nat {
          @generalize-m |
            fix m: Nat {
              @generalize-d |
                fix d: Nat {
                    @given-invariant |
                      assume loopInvariant(a, succ(j), nadd(succ(succ(m)), d)) {
                        @invariant |
                          loopInvariant(a, succ(j), nadd(succ(succ(m)), d))
                          [by hypothesis given-invariant]
                        @witness-exists |
                          exists w: Seq; allTranspositions(w, nadd(succ(succ(m)), d)) and productUpTo(w, nadd(succ(succ(m)), d)) = identityFn and apply(at(w, succ(j)), a) != a and (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) and nat_less_than(succ(j), nadd(succ(succ(m)), d))
                          [using tautology invariant]
                        @with-witness |
                          unpack w: Seq from witness-exists {
                            @w-facts |
                              allTranspositions(w, nadd(succ(succ(m)), d)) and productUpTo(w, nadd(succ(succ(m)), d)) = identityFn and apply(at(w, succ(j)), a) != a and (forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a) and nat_less_than(succ(j), nadd(succ(succ(m)), d))
                              [by hypothesis with-witness]
                            @w-all |
                              allTranspositions(w, nadd(succ(succ(m)), d))
                              [using tautology w-facts]
                            @w-identity |
                              productUpTo(w, nadd(succ(succ(m)), d)) = identityFn
                              [using tautology w-facts]
                            @top-moves-a |
                              apply(at(w, succ(j)), a) != a
                              [using tautology w-facts]
                            @above-fixed |
                              forall i: Nat; nat_less_than(succ(j), i) -> nat_less_than(i, nadd(succ(succ(m)), d)) -> apply(at(w, i), a) = a
                              [using tautology w-facts]
                            @succ-j-below |
                              nat_less_than(succ(j), nadd(succ(succ(m)), d))
                              [using tautology w-facts]
                            @j-below-succ-j |
                              nat_less_than(j, succ(j))
                              [using specialize natLessThanSelf(j)]
                            @j-below |
                              nat_less_than(j, nadd(succ(succ(m)), d))
                              [using specialize peano_order.lessThanTransitive(j, succ(j), nadd(succ(succ(m)), d)) j-below-succ-j succ-j-below]
                            @entry-j-trans |
                              isTransposition(at(w, j))
                              [using specialize w-all(j) j-below]
                            @entry-top-trans |
                              isTransposition(at(w, succ(j)))
                              [using specialize w-all(succ(j)) succ-j-below]
                            @length-decomposes |
                              exists e: Nat; nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e)
                              [using specialize lengthDecomposesAboveThePair(j, nadd(succ(succ(m)), d)) succ-j-below]
                            @top-normalized |
                              exists b: Element; a != b and at(w, succ(j)) = transposition(a, b)
                              [using specialize movingTranspositionWithTheLetterFirst(at(w, succ(j)), a) entry-top-trans top-moves-a]
                            @j-letters |
                              exists x: Element; exists y: Element; x != y and at(w, j) = transposition(x, y)
                              [using tautology entry-j-trans]
                            @with-e |
                              unpack e: Nat from length-decomposes {
                                @length-form |
                                  nadd(succ(succ(m)), d) = nadd(succ(succ(j)), e)
                                  [by hypothesis with-e]
                                @short-form |
                                  nadd(m, d) = nadd(j, e)
                                  [using specialize shortLengthMatches(m, d, j, e) length-form]
                                @with-b |
                                  unpack b: Element from top-normalized {
                                    @b-facts |
                                      a != b and at(w, succ(j)) = transposition(a, b)
                                      [by hypothesis with-b]
                                    @ab |
                                      a != b
                                      [by and_elim_left b-facts]
                                    @top-is-ab |
                                      at(w, succ(j)) = transposition(a, b)
                                      [by and_elim_right b-facts]
                                    @with-x |
                                      unpack x: Element from j-letters {
                                        @y-exists |
                                          exists y: Element; x != y and at(w, j) = transposition(x, y)
                                          [by hypothesis with-x]
                                        @with-y |
                                          unpack y: Element from y-exists {
                                            @xy-facts |
                                              x != y and at(w, j) = transposition(x, y)
                                              [by hypothesis with-y]
                                            @xy |
                                              x != y
                                              [by and_elim_left xy-facts]
                                            @j-is-xy |
                                              at(w, j) = transposition(x, y)
                                              [by and_elim_right xy-facts]
                                            @classified |
                                              (compose(transposition(x, y), transposition(a, b)) = identityFn or (exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(x, y), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a))
                                              [using specialize permutation_parity.adjacentPairCancelsOrShiftsOff(a, b, x, y) ab xy]
                                            @pair-is-the-entries |
                                              compose(at(w, j), at(w, succ(j))) = compose(transposition(x, y), transposition(a, b))
                                              [using chain pair-with-j pair-with-top]
                                            @pair-with-j |
                                              compose(at(w, j), at(w, succ(j))) = compose(transposition(x, y), at(w, succ(j)))
                                              [by rewrite j-is-xy pair-reflexive]
                                            @pair-reflexive |
                                              compose(at(w, j), at(w, succ(j))) = compose(at(w, j), at(w, succ(j)))
                                              [by reflexivity]
                                            @pair-with-top |
                                              compose(transposition(x, y), at(w, succ(j))) = compose(transposition(x, y), transposition(a, b))
                                              [by rewrite top-is-ab pair-with-top-reflexive]
                                            @pair-with-top-reflexive |
                                              compose(transposition(x, y), at(w, succ(j))) = compose(transposition(x, y), at(w, succ(j)))
                                              [by reflexivity]
                                            @conclusion-dispatch |
                                              (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                                              case classified {
                                                @when-cancels |
                                                  assume compose(transposition(x, y), transposition(a, b)) = identityFn {
                                                    @cancels-at-letters |
                                                      compose(transposition(x, y), transposition(a, b)) = identityFn
                                                      [by hypothesis when-cancels]
                                                    @cancels |
                                                      compose(at(w, j), at(w, succ(j))) = identityFn
                                                      [using chain pair-is-the-entries cancels-at-letters]
                                                    @shorter |
                                                      someProductOfLengthIsIdentity(nadd(m, d))
                                                      [using specialize cancelBranchDropsTwo(w, j, m, d, e) w-all w-identity length-form short-form cancels]
                                                    @conclusion-cancel |
                                                      (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                                                      [by or_intro_left shorter]
                                                  }
                                                @when-shifts |
                                                  assume exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(x, y), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a {
                                                    @shift-exists |
                                                      exists p: Fn; exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(x, y), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                                      [by hypothesis when-shifts]
                                                    @with-p |
                                                      unpack p: Fn from shift-exists {
                                                        @q-exists |
                                                          exists q: Fn; isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(x, y), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                                          [by hypothesis with-p]
                                                        @with-q |
                                                          unpack q: Fn from q-exists {
                                                            @pq-facts |
                                                              isTransposition(p) and isTransposition(q) and compose(p, q) = compose(transposition(x, y), transposition(a, b)) and apply(q, a) = a and apply(p, a) != a
                                                              [by hypothesis with-q]
                                                            @p-trans |
                                                              isTransposition(p)
                                                              [using tautology pq-facts]
                                                            @q-trans |
                                                              isTransposition(q)
                                                              [using tautology pq-facts]
                                                            @pq-composes-at-letters |
                                                              compose(p, q) = compose(transposition(x, y), transposition(a, b))
                                                              [using tautology pq-facts]
                                                            @q-fixes |
                                                              apply(q, a) = a
                                                              [using tautology pq-facts]
                                                            @p-moves |
                                                              apply(p, a) != a
                                                              [using tautology pq-facts]
                                                            @entries-flipped |
                                                              compose(transposition(x, y), transposition(a, b)) = compose(at(w, j), at(w, succ(j)))
                                                              [by symmetry pair-is-the-entries]
                                                            @pq-composes |
                                                              compose(p, q) = compose(at(w, j), at(w, succ(j)))
                                                              [using chain pq-composes-at-letters entries-flipped]
                                                            @invariant-at-j |
                                                              loopInvariant(a, j, nadd(succ(succ(m)), d))
                                                              [using specialize shiftBranchKeepsTheInvariant(w, a, j, m, d, e, p, q) w-all w-identity above-fixed length-form p-trans q-trans pq-composes q-fixes p-moves]
                                                            @conclusion-shift-inner |
                                                              (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                                                              [by or_intro_right invariant-at-j]
                                                          }
                                                        @conclusion-shift-q |
                                                          (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                                                          [by exists_elim with-q]
                                                      }
                                                    @conclusion-shift |
                                                      (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                                                      [by exists_elim with-p]
                                                  }
                                            }
                                          }
                                        @conclusion-y |
                                          (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                                          [by exists_elim with-y]
                                      }
                                    @conclusion-x |
                                      (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                                      [by exists_elim with-x]
                                  }
                                @conclusion-b |
                                  (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                                  [by exists_elim with-b]
                              }
                            @conclusion-e |
                              (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                              [by exists_elim with-e]
                          }
                        @conclusion-witness |
                          (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                          [by exists_elim with-witness]
                      }
                    @invariant-implies |
                      loopInvariant(a, succ(j), nadd(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                      [by implies_intro given-invariant]
                }
              @discharge-d |
                forall d: Nat; loopInvariant(a, succ(j), nadd(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
                [by forall_intro generalize-d]
            }
          @discharge-m |
            forall m: Nat; forall d: Nat; loopInvariant(a, succ(j), nadd(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
            [by forall_intro generalize-m]
        }
      @discharge-j |
        forall j: Nat; forall m: Nat; forall d: Nat; loopInvariant(a, succ(j), nadd(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
        [by forall_intro generalize-j]
    }
  @conclusion |
    forall a: Element; forall j: Nat; forall m: Nat; forall d: Nat; loopInvariant(a, succ(j), nadd(succ(succ(m)), d)) -> (someProductOfLengthIsIdentity(nadd(m, d)) or loopInvariant(a, j, nadd(succ(succ(m)), d)))
    [by forall_intro generalize-a]
qed

// At position ZERO the invariant is IMPOSSIBLE: entry 0 moves `a` and everything above it
// fixes `a`, so the product moves `a` — but the product is the identity. STEP 3, packaged.
theorem invariantFailsAtZero: forall a: Element; forall r: Nat;
  nat_less_than(NZERO, r) -> (not loopInvariant(a, NZERO, r))
proof
  @generalize-a |
    fix a: Element {
      @generalize-r |
        fix r: Nat {
          @given-positive |
            assume nat_less_than(NZERO, r) {
              @positive |
                nat_less_than(NZERO, r)
                [by hypothesis given-positive]
              @given-invariant |
                assume loopInvariant(a, NZERO, r) {
                  @invariant |
                    loopInvariant(a, NZERO, r)
                    [by hypothesis given-invariant]
                  @witness-exists |
                    exists w: Seq; allTranspositions(w, r) and productUpTo(w, r) = identityFn and apply(at(w, NZERO), a) != a and (forall i: Nat; nat_less_than(NZERO, i) -> nat_less_than(i, r) -> apply(at(w, i), a) = a) and nat_less_than(NZERO, r)
                    [using tautology invariant]
                  @with-witness |
                    unpack w: Seq from witness-exists {
                      @w-facts |
                        allTranspositions(w, r) and productUpTo(w, r) = identityFn and apply(at(w, NZERO), a) != a and (forall i: Nat; nat_less_than(NZERO, i) -> nat_less_than(i, r) -> apply(at(w, i), a) = a) and nat_less_than(NZERO, r)
                        [by hypothesis with-witness]
                      @is-identity |
                        productUpTo(w, r) = identityFn
                        [using tautology w-facts]
                      @first-moves-a |
                        apply(at(w, NZERO), a) != a
                        [using tautology w-facts]
                      @above-fixed |
                        forall i: Nat; nat_less_than(NZERO, i) -> nat_less_than(i, r) -> apply(at(w, i), a) = a
                        [using tautology w-facts]
                      // STEP 3: the product is the identity and everything above 0 fixes `a`,
                      // so entry 0 fixes `a` — contradicting that it moves it.
                      @first-fixes-a |
                        apply(at(w, NZERO), a) = a
                        [using specialize permutation_parity.identityProductForcesFirstFactorToFix(w, a, r) is-identity above-fixed positive]
                      @conclusion-contradiction |
                        nat_less_than(NZERO, NZERO)
                        [using tautology first-fixes-a first-moves-a]
                    }
                  @contradiction |
                    nat_less_than(NZERO, NZERO)
                    [by exists_elim with-witness]
                }
              @invariant-implies-absurdity |
                loopInvariant(a, NZERO, r) -> nat_less_than(NZERO, NZERO)
                [by implies_intro given-invariant]
              @zero-not-below-itself |
                not nat_less_than(NZERO, NZERO)
                [using specialize peano_order.lessThanIrreflexive(NZERO)]
              @conclusion-impossible |
                not loopInvariant(a, NZERO, r)
                [using tautology invariant-implies-absurdity zero-not-below-itself]
            }
          @positive-implies |
            nat_less_than(NZERO, r) -> (not loopInvariant(a, NZERO, r))
            [by implies_intro given-positive]
        }
      @discharge-r |
        forall r: Nat; nat_less_than(NZERO, r) -> (not loopInvariant(a, NZERO, r))
        [by forall_intro generalize-r]
    }
  @conclusion |
    forall a: Element; forall r: Nat; nat_less_than(NZERO, r) -> (not loopInvariant(a, NZERO, r))
    [by forall_intro generalize-a]
qed

// The loop RUN: strong induction on the position. At 0 the invariant is impossible, so the
// length must already have dropped; above 0 the body either drops it or descends.
theorem loopTerminates: forall a: Element; forall base: Nat; forall d: Nat; forall j: Nat;
  loopInvariant(a, j, nadd(succ(succ(base)), d)) ->
  someProductOfLengthIsIdentity(nadd(base, d))
proof
  @generalize-a |
    fix a: Element {
      @generalize-base |
        fix base: Nat {
          @generalize-d |
            fix d: Nat {
              @length-is-positive |
                nat_less_than(NZERO, nadd(succ(succ(base)), d))
                [using specialize zeroIsBelowTheLength(base, d)]
              @strong-step |
                fix j: Nat {
                  @given-smaller |
                    assume forall k: Nat; nat_less_than(k, j) -> (loopInvariant(a, k, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d))) {
                      @smaller-cases |
                        forall k: Nat; nat_less_than(k, j) -> (loopInvariant(a, k, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d)))
                        [by hypothesis given-smaller]
                      @given-invariant |
                        assume loopInvariant(a, j, nadd(succ(succ(base)), d)) {
                          @invariant |
                            loopInvariant(a, j, nadd(succ(succ(base)), d))
                            [by hypothesis given-invariant]
                          @j-shape |
                            j = NZERO or (exists p: Nat; j = succ(p))
                            [using specialize peano.zeroOrSucc(j)]
                          @conclusion-drops |
                            someProductOfLengthIsIdentity(nadd(base, d))
                            case j-shape {
                              @when-zero |
                                assume j = NZERO {
                                  @j-is-zero |
                                    j = NZERO
                                    [by hypothesis when-zero]
                                  @invariant-at-zero |
                                    loopInvariant(a, NZERO, nadd(succ(succ(base)), d))
                                    [by rewrite j-is-zero invariant]
                                  @impossible |
                                    not loopInvariant(a, NZERO, nadd(succ(succ(base)), d))
                                    [using specialize invariantFailsAtZero(a, nadd(succ(succ(base)), d)) length-is-positive]
                                  @conclusion-absurd |
                                    someProductOfLengthIsIdentity(nadd(base, d))
                                    [using tautology invariant-at-zero impossible]
                                }
                              @when-successor |
                                assume exists p: Nat; j = succ(p) {
                                  @has-predecessor |
                                    exists p: Nat; j = succ(p)
                                    [by hypothesis when-successor]
                                  @with-predecessor |
                                    unpack p: Nat from has-predecessor {
                                      @j-is-succ-p |
                                        j = succ(p)
                                        [by hypothesis with-predecessor]
                                      @invariant-at-succ-p |
                                        loopInvariant(a, succ(p), nadd(succ(succ(base)), d))
                                        [by rewrite j-is-succ-p invariant]
                                      @body |
                                        someProductOfLengthIsIdentity(nadd(base, d)) or loopInvariant(a, p, nadd(succ(succ(base)), d))
                                        [using specialize loopBodyAsInvariant(a, p, base, d) invariant-at-succ-p]
                                      @p-below-j |
                                        nat_less_than(p, j)
                                        [by rewrite j-is-succ-p p-below-succ-p]
                                      @p-below-succ-p |
                                        nat_less_than(p, succ(p))
                                        [using specialize natLessThanSelf(p)]
                                      @descend |
                                        loopInvariant(a, p, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d))
                                        [using specialize smaller-cases(p) p-below-j]
                                      @conclusion-either-way |
                                        someProductOfLengthIsIdentity(nadd(base, d))
                                        [using tautology body descend]
                                    }
                                  @conclusion-with-predecessor |
                                    someProductOfLengthIsIdentity(nadd(base, d))
                                    [by exists_elim with-predecessor]
                                }
                            }
                        }
                      @invariant-implies |
                        loopInvariant(a, j, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d))
                        [by implies_intro given-invariant]
                    }
                  @strong-step-at-j |
                    (forall k: Nat; nat_less_than(k, j) -> (loopInvariant(a, k, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d)))) -> (loopInvariant(a, j, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d)))
                    [by implies_intro given-smaller]
                }
              @strong-step-for-all |
                forall j: Nat; (forall k: Nat; nat_less_than(k, j) -> (loopInvariant(a, k, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d)))) -> (loopInvariant(a, j, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d)))
                [by forall_intro strong-step]
              @conclusion-for-all-j |
                forall j: Nat; loopInvariant(a, j, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d))
                [using instantiation strongInduction((fun j: Nat => loopInvariant(a, j, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d)))) strong-step-for-all]
            }
          @discharge-d |
            forall d: Nat; forall j: Nat; loopInvariant(a, j, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d))
            [by forall_intro generalize-d]
        }
      @discharge-base |
        forall base: Nat; forall d: Nat; forall j: Nat; loopInvariant(a, j, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d))
        [by forall_intro generalize-base]
    }
  @conclusion |
    forall a: Element; forall base: Nat; forall d: Nat; forall j: Nat; loopInvariant(a, j, nadd(succ(succ(base)), d)) -> someProductOfLengthIsIdentity(nadd(base, d))
    [by forall_intro generalize-a]
qed

theorem zeroIsBelowTheLength: forall m: Nat; forall d: Nat; nat_less_than(NZERO, nadd(succ(succ(m)), d))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-d |
        fix d: Nat {
          @length-is-a-successor |
            nadd(succ(succ(m)), d) = succ(nadd(succ(m), d))
            [using specialize peano.addSuccLeft(succ(m), d)]
          @zero-below-successor |
            nat_less_than(NZERO, succ(nadd(succ(m), d)))
            [using specialize permutation_parity.zeroIsBelowEverySuccessor(nadd(succ(m), d))]
          @conclusion-positive |
            nat_less_than(NZERO, nadd(succ(succ(m)), d))
            [by rewrite length-is-a-successor zero-below-successor]
        }
      @discharge-d |
        forall d: Nat; nat_less_than(NZERO, nadd(succ(succ(m)), d))
        [by forall_intro generalize-d]
    }
  @conclusion |
    forall m: Nat; forall d: Nat; nat_less_than(NZERO, nadd(succ(succ(m)), d))
    [by forall_intro generalize-m]
qed

// -- and the hole the outer induction consumes, now PROVED from those --------------------------
theorem innerLoopDropsTwo: forall m: Nat; forall d: Nat;
  someProductOfLengthIsIdentity(nadd(succ(succ(m)), d)) ->
  someProductOfLengthIsIdentity(nadd(m, d))
proof
  @generalize-m |
    fix m: Nat {
      @generalize-d |
        fix d: Nat {
          @given-product |
            assume someProductOfLengthIsIdentity(nadd(succ(succ(m)), d)) {
              @product |
                someProductOfLengthIsIdentity(nadd(succ(succ(m)), d))
                [by hypothesis given-product]
              @sequence-exists |
                exists w: Seq; allTranspositions(w, nadd(succ(succ(m)), d)) and productUpTo(w, nadd(succ(succ(m)), d)) = identityFn
                [using tautology product]
              @with-sequence |
                unpack s: Seq from sequence-exists {
                  @s-facts |
                    allTranspositions(s, nadd(succ(succ(m)), d)) and productUpTo(s, nadd(succ(succ(m)), d)) = identityFn
                    [by hypothesis with-sequence]
                  @s-all |
                    allTranspositions(s, nadd(succ(succ(m)), d))
                    [by and_elim_left s-facts]
                  @s-identity |
                    productUpTo(s, nadd(succ(succ(m)), d)) = identityFn
                    [by and_elim_right s-facts]
                  // The length is a SUCCESSOR: (m+2)+d = succ(succ(m)+d). Write q for its
                  // predecessor — the LAST index — and take `a` from that last entry, so the
                  // invariant's "every entry above q" clause is vacuous (see
                  // invariantHoldsAtTheTop; taking the letter from entry m+1 instead was the
                  // error this restatement fixes).
                  @length-is-a-successor |
                    nadd(succ(succ(m)), d) = succ(nadd(succ(m), d))
                    [using specialize peano.addSuccLeft(succ(m), d)]
                  @s-all-at-successor |
                    allTranspositions(s, succ(nadd(succ(m), d)))
                    [by rewrite length-is-a-successor s-all]
                  @s-identity-at-successor |
                    productUpTo(s, succ(nadd(succ(m), d))) = identityFn
                    [by rewrite length-is-a-successor s-identity]
                  @top-below-length |
                    nat_less_than(nadd(succ(m), d), succ(nadd(succ(m), d)))
                    [using specialize natLessThanSelf(nadd(succ(m), d))]
                  @top-entry-is-a-transposition |
                    isTransposition(at(s, nadd(succ(m), d)))
                    [using specialize s-all-at-successor(nadd(succ(m), d)) top-below-length]
                  @moved-letter-exists |
                    exists a: Element; apply(at(s, nadd(succ(m), d)), a) != a
                    [using specialize aTranspositionMovesSomething(at(s, nadd(succ(m), d))) top-entry-is-a-transposition]
                  @with-moved-letter |
                    unpack a: Element from moved-letter-exists {
                      @top-moves-a |
                        apply(at(s, nadd(succ(m), d)), a) != a
                        [by hypothesis with-moved-letter]
                      @invariant-at-top |
                        loopInvariant(a, nadd(succ(m), d), succ(nadd(succ(m), d)))
                        [using specialize invariantHoldsAtTheTop(a, s, nadd(succ(m), d)) s-all-at-successor s-identity-at-successor top-moves-a]
                      @invariant-at-the-original-length |
                        loopInvariant(a, nadd(succ(m), d), nadd(succ(succ(m)), d))
                        [by rewrite length-is-a-successor invariant-at-top]
                      @conclusion-drops |
                        someProductOfLengthIsIdentity(nadd(m, d))
                        [using specialize loopTerminates(a, m, d, nadd(succ(m), d)) invariant-at-the-original-length]
                    }
                  @conclusion-with-letter |
                    someProductOfLengthIsIdentity(nadd(m, d))
                    [by exists_elim with-moved-letter]
                }
              @conclusion-unpacked |
                someProductOfLengthIsIdentity(nadd(m, d))
                [by exists_elim with-sequence]
            }
          @product-implies |
            someProductOfLengthIsIdentity(nadd(succ(succ(m)), d)) -> someProductOfLengthIsIdentity(nadd(m, d))
            [by implies_intro given-product]
        }
      @discharge-d |
        forall d: Nat; someProductOfLengthIsIdentity(nadd(succ(succ(m)), d)) -> someProductOfLengthIsIdentity(nadd(m, d))
        [by forall_intro generalize-d]
    }
  @conclusion |
    forall m: Nat; forall d: Nat; someProductOfLengthIsIdentity(nadd(succ(succ(m)), d)) -> someProductOfLengthIsIdentity(nadd(m, d))
    [by forall_intro generalize-m]
qed
