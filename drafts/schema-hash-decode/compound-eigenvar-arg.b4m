// Does a COMPOUND argument mentioning an eigenvar also split the hash?
// (bare `a` is the probed case; this is `add(a, ZERO)`, which collectArgFvars does
// NOT skip -- so it is the case freeFvarParams would see under a model.)
import peano <<< "std/peano.b4m"
sort Nat = peano.Nat
const ZERO = peano.ZERO
func add = peano.add

theorem addZeroOnTheRight(n: Nat): add(n, ZERO) = n
proof
  @conclusion |
    add(n, ZERO) = n
    [using arithmetic(peano)]
qed

theorem compoundFirst: forall a: Nat; add(add(a, ZERO), ZERO) = add(a, ZERO)
proof
  @the-block |
    fix a: Nat {
      @at-a |
        add(add(a, ZERO), ZERO) = add(a, ZERO)
        [using instantiation addZeroOnTheRight(add(a, ZERO))]
    }
  @conclusion |
    forall a: Nat; add(add(a, ZERO), ZERO) = add(a, ZERO)
    [by generalize the-block]
qed

theorem compoundSecond: forall z: Nat; add(add(z, ZERO), ZERO) = add(z, ZERO)
proof
  @the-block |
    fix z: Nat {
      @at-z |
        add(add(z, ZERO), ZERO) = add(z, ZERO)
        [using instantiation addZeroOnTheRight(add(z, ZERO))]
    }
  @conclusion |
    forall z: Nat; add(add(z, ZERO), ZERO) = add(z, ZERO)
    [by generalize the-block]
qed
