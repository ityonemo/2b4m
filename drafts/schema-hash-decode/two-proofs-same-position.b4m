// If eigenvars hash BY BINDING POSITION, two proofs whose first-fix eigenvar has the
// same sort would give the SAME hash for the same instantiation. Is that correct?
//
// YES -- and it is the same reason lambda params canonicalize: the instance's STATEMENT
// is `add(<the bound var>, ZERO) = <the bound var>`, which is alpha-equivalent in both.
// One instance serving both is the DESIRED outcome (today they mint two).
import peano <<< "std/peano.b4m"
sort Nat = peano.Nat
const ZERO = peano.ZERO
func add = peano.add

theorem addZeroOnTheRight(n: Nat): add(n, ZERO) = n
proof
  @conclusion |
    add(n, ZERO) = n
    [using arithmetic(peano)]
qed

// two DIFFERENT theorems, each instantiating at its own first-fix eigenvar
theorem first: forall a: Nat; add(a, ZERO) = a
proof
  @the-block |
    fix a: Nat {
      @at-a |
        add(a, ZERO) = a
        [using instantiation addZeroOnTheRight(a)]
    }
  @conclusion |
    forall a: Nat; add(a, ZERO) = a
    [by generalize the-block]
qed

theorem second: forall z: Nat; add(z, ZERO) = z
proof
  @the-block |
    fix z: Nat {
      @at-z |
        add(z, ZERO) = z
        [using instantiation addZeroOnTheRight(z)]
    }
  @conclusion |
    forall z: Nat; add(z, ZERO) = z
    [by generalize the-block]
qed
