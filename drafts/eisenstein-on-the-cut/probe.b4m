// PROBE: map std/ring/polynomial.b4m onto the ℚ[x] integer-coefficient cut.
// Shallowest useful source (going DOWN a layer, per the ch17 lesson). If this works,
// ℤ[x] exists INSIDE ℚ[x] and the two-sort vocabulary gap is gone.
import qpoly <<< "std/rational/polynomial.b4m"
import rational <<< "std/rational.b4m"
import ring <<< "std/ring.b4m"
import ring_poly <<< "std/ring/polynomial.b4m"
import peano <<< "std/peano.b4m"
import closure <<< "closure.b4m"

sort QPoly = qpoly.QPoly

pred hasIntegerCoefficients = closure.hasIntegerCoefficients

sort ZPolyCut = QPoly where hasIntegerCoefficients
sort Integer = rational.Q where rational.isInteger

// the closure facts, proved in closure.b4m
fact theZeroPolynomialIsIntegral = closure.theZeroPolynomialIsIntegral
fact theUnitPolynomialIsIntegral = closure.theUnitPolynomialIsIntegral
fact theSumIsIntegral = closure.theSumIsIntegral
fact theNegationIsIntegral = closure.theNegationIsIntegral
fact theProductIsIntegral = closure.theProductIsIntegral

model ZPolyInQPoly {
  // the coefficient ring: ℚ's integer cut
  ring.Ring: Integer
  ring.ZERO: qpoly.ZERO(rational.zeroIsAnInteger)
  ring.ONE: rational.ONE(rational.oneIsAnInteger)
  ring.add: rational.add -| rational.isIntegerAdd
  ring.mul: rational.mul -| rational.isIntegerMul
  ring.neg: rational.neg -| rational.isIntegerNeg
  ring.addIsAssociative <- rational.addIsAssociative
  ring.addIsCommutative <- rational.addIsCommutative
  ring.addZeroLeft <- rational.addZeroLeft
  ring.addNegLeft <- rational.addNegLeft
  ring.mulIsAssociative <- rational.mulIsAssociative
  ring.mulAddDistribLeft <- rational.mulAddDistribLeft
  ring.mulAddDistribRight <- rational.mulAddDistribRight

  ring_poly.mulOneLeftR <- rational.mulOneLeft
  ring_poly.mulIsCommutativeR <- rational.mulIsCommutative

  ring_poly.Nat: peano.Nat
  ring_poly.ZERO: peano.ZERO
  ring_poly.succ: peano.succ
  ring_poly.addN: peano.add
  ring_poly.less_than: peano.less_than

  // the polynomial carrier: the CUT
  ring_poly.Poly: ZPolyCut
  ring_poly.coeff: qpoly.qcoeff
  ring_poly.ZEROP: qpoly.QZEROP(theZeroPolynomialIsIntegral)
  ring_poly.ONEP: qpoly.QONEP(theUnitPolynomialIsIntegral)
  ring_poly.addP: qpoly.qaddP -| theSumIsIntegral
  ring_poly.negP: qpoly.qnegP -| theNegationIsIntegral
  ring_poly.mulP: qpoly.qmulP -| theProductIsIntegral
  ring_poly.convolution: qpoly.qconvolution
  ring_poly.tailConvolution: qpoly.qtailConvolution
  ring_poly.segment: qpoly.qsegment
  ring_poly.degreeAtMost: qpoly.qdegreeAtMost
  ring_poly.degree: qpoly.qdegree
  ring_poly.polyExtensionality <- qpoly.qPolyExtensionality
  ring_poly.zeroPolyCoeff <- qpoly.qZeroPolyCoeff
  ring_poly.onePolyCoeffZero <- qpoly.qOnePolyCoeffZero
  ring_poly.onePolyCoeffHigher <- qpoly.qOnePolyCoeffHigher
  ring_poly.addPolyCoeff <- qpoly.qAddPolyCoeff
  ring_poly.negPolyCoeff <- qpoly.qNegPolyCoeff
  ring_poly.degreeAtMostMeaning <- qpoly.qDegreeAtMostMeaning
  ring_poly.degreeIsALeadingIndex <- qpoly.qDegreeIsALeadingIndex
  ring_poly.degreeBoundsTheCoefficients <- qpoly.qDegreeBoundsTheCoefficients
  ring_poly.convolutionZero <- qpoly.qConvolutionZero
  ring_poly.convolutionSucc <- qpoly.qConvolutionSucc
  ring_poly.mulPolyCoeff <- qpoly.qMulPolyCoeff
  ring_poly.tailConvolutionZero <- qpoly.qTailConvolutionZero
  ring_poly.tailConvolutionSucc <- qpoly.qTailConvolutionSucc
  ring_poly.segmentZero <- qpoly.qSegmentZero
  ring_poly.segmentSucc <- qpoly.qSegmentSucc
}

// the probe: does a ring_poly theorem transfer onto the cut?
theorem probeCommutativityOnTheCut: forall p: QPoly;
  hasIntegerCoefficients(p) -> forall q: QPoly;
  hasIntegerCoefficients(q) ->
  qpoly.qmulP(p, q) = qpoly.qmulP(q, p)
proof
  @conclusion |
    forall p: QPoly; hasIntegerCoefficients(p) ->
      forall q: QPoly; hasIntegerCoefficients(q) ->
      qpoly.qmulP(p, q) = qpoly.qmulP(q, p)
    [using model(ZPolyInQPoly) ring_poly.polyMulIsCommutative]
qed
