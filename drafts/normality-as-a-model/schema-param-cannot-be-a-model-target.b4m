// PROBE: can a model appear INSIDE a schema, targeting its parameter?
import group <<< "std/group.b4m"
import permutation <<< "std/permutation.b4m"

sort Fn = permutation.Fn
func compose = permutation.compose

theorem schemaWithAModel(inN(Fn)):
  inN(permutation.identityFn) -> forall g: Fn; inN(g) -> inN(g)
proof
  @conclusion |
    inN(permutation.identityFn) -> forall g: Fn; inN(g) -> inN(g)
    [using tautology]
qed

// a model cannot name inN -- it is not in file scope
sort SubN = Fn where inN

theorem useTheSortNow: forall g: SubN; g = g
proof
  @generalize-g |
    fix g: SubN {
      @reflexive | g = g [by reflexivity]
    }
  @conclusion | forall g: SubN; g = g [by generalize generalize-g]
qed
