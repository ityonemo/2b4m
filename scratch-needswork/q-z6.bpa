// q-z6.bpa — the ACTUAL target of the overload experiment: ℤ_6 built over the ℚ-CUT
// ℤ (`rational.Integer = Q where isInteger`) instead of standalone ℤ. This composes
// the tower — ℤ_6 → ℤ → ℚ — and is the honest test of whether integer-mod-n is
// parametric over "an ℤ".
//
// It gets FAR: rational.bpa already carves `sort Integer = Q where isInteger` and runs
// the guarded model `IntegersInRational` that transfers ALL of ℤ's axioms onto the cut
// (addZeroLeft, mulSuccLeft, …). So every ℤ-ring/order obligation integer-mod-n's
// proofs cite IS dischargeable on the cut — via `IntegersInRational@integer.<axiom>`.
//
// It is BLOCKED at the model system, not the mathematics — and the ℚ-cut path in fact
// hits TWO layers of obstruction, both dischargeable-in-principle but not expressible
// today:
//
//   (1) CUT-CLOSURE OBLIGATIONS. Because the substrate is `ZInQ = Q where isInteger`
//       (a guarded/predicated sort), mapping `mod_n`'s operations onto it makes the
//       transfer demand that the operations STAY IN THE CUT — e.g.
//       `forall a,b: Q; isInteger(a) -> isInteger(b) -> isInteger(add(a,b))`. These are
//       exactly rational.bpa's `isIntegerAdd`/`isIntegerMul` axioms (so they ARE
//       provable on the cut), but the model does not thread them in automatically; they
//       surface as `unproved obligation` at the addHom/power6Def lines below.
//
//   (2) MULTI-SOURCE-THEORY DISCHARGE. integer-mod-n's transferred theorems also cite
//       axioms of the `integer` theory (a DIFFERENT source than `mod_n`), which under
//       the substrate remap must be discharged on the cut (via rational's guarded
//       `IntegersInRational` model). But a single `model` block may not draw mapping
//       sources from more than one theory (`src/elaborate.zig:661-663`, "all model
//       mappings must come from one source theory"), so the `integer.<axiom> <- …`
//       lines below cannot sit alongside the `mod_n.*` mappings.
//
// Both are model-system limitations the NAMESPACING REFACTOR must address (guarded
// cut-closure obligations threaded automatically; multi-source-theory discharge
// allowed). The mathematics is complete — the ℚ-cut satisfies every obligation. See
// README.md and the `namespaces-reorg-model-decisions` note.
//
// This file is left in the state that reaches the wall, as the concrete motivating case
// (it does NOT check — that is the point).

import integer <<< "../std/integer.bpa"
import rational <<< "../std/rational.bpa"
import mod_n <<< "../std/integer-mod-n.bpa"

// the ℚ-cut integers as the substrate ℤ.
sort ZInQ = rational.Integer
const QIZERO = rational.ZERO
const QIONE = rational.ONE
func qiadd = rational.add
func qineg = rational.neg
func qisub = rational.sub
func qimul = rational.mul
func qisucc = rational.succ
func qiprev = rational.prev

// ℤ_6's carrier over the ℚ-cut: class map, zero, ops, and the modulus 6.
sort Zn6
const ZN6ZERO: Zn6
func cls6(k: ZInQ): Zn6
func add6(x: Zn6, y: Zn6): Zn6
func neg6(x: Zn6): Zn6
func power6(x: Zn6, k: ZInQ): Zn6
const SIX: ZInQ
axiom sixIsSix: SIX = qisucc(qisucc(qisucc(qisucc(qisucc(qisucc(QIZERO))))))

// ℤ_6's own defining axioms at n = 6 over the ℚ-cut ℤ (the structural posits).
axiom sixPositive: rational.less_than(QIZERO, SIX)
axiom cls6Surjective: forall z: Zn6; exists k: ZInQ; z = cls6(k)
axiom zero6IsCls6Zero: ZN6ZERO = cls6(QIZERO)
axiom add6Hom: forall a, b: ZInQ; add6(cls6(a), cls6(b)) = cls6(qiadd(a, b))
axiom neg6Hom: forall a: ZInQ; neg6(cls6(a)) = cls6(qineg(a))
axiom power6Def: forall a, k: ZInQ; power6(cls6(a), k) = cls6(qimul(k, a))

// ℤ_6-over-ℚcut IS a ℤ_n: model integer-mod-n, mapping its ℤ substrate onto the ℚ-cut
// ℤ and its ℤ_n symbols onto the concrete ones.
//
// >>> THIS IS WHERE IT BREAKS. <<<
// The `mod_n.addAssoc`-style transferred theorems cite `integer.addZeroLeft`,
// `integer.mulSuccLeft`, … — axioms of the `integer` theory. Under the substrate
// remap (mod_n.Int -> ZInQ = rational.Integer) those obligations must be discharged on
// the cut, which rational's guarded `IntegersInRational` model PROVES. But the
// discharges below draw from TWO source theories (`mod_n` and `integer`), and the
// elaborator rejects that: "all model mappings must come from one source theory".
//
// The discharges are written out to show they are all AVAILABLE (each via the
// `@`-projection through rational's IntegersInRational model) — the mathematics is
// complete; only the model system's single-source-theory restriction stands in the way.
model Zn6IsModN {
  mod_n.Int: ZInQ
  mod_n.iadd: qiadd
  mod_n.ineg: qineg
  mod_n.isub: qisub
  mod_n.imul: qimul
  mod_n.isucc: qisucc
  mod_n.iprev: qiprev
  mod_n.IZERO: QIZERO
  mod_n.IONE: QIONE
  mod_n.N: SIX
  mod_n.Zn: Zn6
  mod_n.ZERO: ZN6ZERO
  mod_n.cls: cls6
  mod_n.add: add6
  mod_n.neg: neg6
  mod_n.znPower: power6
  mod_n.nPositive <- sixPositive
  mod_n.clsSurjective <- cls6Surjective
  mod_n.zeroIsClsZero <- zero6IsCls6Zero
  mod_n.addHom <- add6Hom
  mod_n.negHom <- neg6Hom
  mod_n.znPowerDef <- power6Def
  // --- the ℤ-substrate obligations, dischargeable on the cut but from the WRONG
  //     source theory (`integer`, not `mod_n`) — the elaborator rejects these lines: ---
  integer.addZeroLeft <- rational.IntegersInRational@integer.addZeroLeft
  integer.addIsAssociative <- rational.IntegersInRational@integer.addIsAssociative
  integer.addNegLeft <- rational.IntegersInRational@integer.addNegLeft
  integer.mulZeroLeft <- rational.IntegersInRational@integer.mulZeroLeft
  integer.mulSuccLeft <- rational.IntegersInRational@integer.mulSuccLeft
  integer.mulPrevLeft <- rational.IntegersInRational@integer.mulPrevLeft
  integer.mulOneRight <- rational.IntegersInRational@integer.mulOneRight
}

// If the model went through, this would transfer for free (as it does in z6.bpa over
// standalone ℤ):
theorem qz6IsCyclic: forall z: Zn6; exists k: ZInQ; z = power6(cls6(QIONE), k)
proof
  @conclusion |
    forall z: Zn6; exists k: ZInQ; z = power6(cls6(QIONE), k)
    [by model(Zn6IsModN) mod_n.znIsCyclic]
qed
