// z6.bpa — a CONCRETE ℤ_6, obtained by MODELING std/integer/mod-n.bpa at n = 6.
//
// This is the INTENDED, minimal instantiation of the abstract ℤ_n template. The only
// thing genuinely supplied is the modulus 6; everything else — the quotient sort, the
// class map, the operations, and their defining axioms — comes FROM the template.
//
// The key point: discharge is DEMAND-DRIVEN — the model only requires discharging the
// source axioms that the TRANSFERRED theorems actually reach. ℤ_n's structural axioms
// (the homomorphism laws, `clsSurjective`, `zeroIsClsZero`) do not mention `N`, so their
// interpreted form under `N ↦ 6` is unchanged and the materializer carries them with no
// mapping line needed; `clsCongruent` is used by no transferred theorem at all. The ONLY
// axiom that needs an explicit, instance-specific discharge is `nPositive`, the one
// axiom about the fixed value — here `0 < 6`, via the `sixPositive` theorem. So the
// entire model body is two lines.
//
// Consequence: `Zn`/`cls`/`add`/`neg`/`znPower` stay mapped to the template's own
// symbols (no concrete re-declaration), so this instance is "the ℤ_n theory with N
// pinned to 6," not a fresh distinct sort. That is exactly what you want to
// INSTANTIATE the theory at 6 and use its theorems. (To have several DISTINCT moduli
// coexist as separate sorts in one file — ℤ_6 and ℤ_5 side by side — you would give
// each its own carrier symbols; that fuller form, and one-line functor-style
// instantiation, is the parameterized-module / model-spaces direction.)

import integer <<< "../std/integer.bpa"
import int_divides <<< "../std/integer/divides.bpa"
import mod_n <<< "../std/integer/mod-n.bpa"

const IZERO = integer.ZERO
func isucc = integer.succ
pred is_nonneg = int_divides.is_nonneg

// the concrete modulus: 6 = succ⁶(0). A `define` (not a posited const), so SIX
// unfolds to the tower — no defining axiom is assumed.
define SIX = isucc(isucc(isucc(isucc(isucc(isucc(IZERO))))))

// 0 < 6 is a THEOREM, not an axiom: succ⁵(0) is nonnegative (nonnegZero + five
// nonnegSucc), so succ of it — namely 6 — is positive (succOfNonnegIsPositive).
theorem sixPositive: mod_n.less_than(IZERO, SIX)
proof
  @zero-nonneg |
    is_nonneg(IZERO)
    [by axiom int_divides.nonnegZero]
  @one-nonneg |
    is_nonneg(isucc(IZERO))
    [by specialize int_divides.nonnegSucc(IZERO) zero-nonneg]
  @two-nonneg |
    is_nonneg(isucc(isucc(IZERO)))
    [by specialize int_divides.nonnegSucc(isucc(IZERO)) one-nonneg]
  @three-nonneg |
    is_nonneg(isucc(isucc(isucc(IZERO))))
    [by specialize int_divides.nonnegSucc(isucc(isucc(IZERO))) two-nonneg]
  @four-nonneg |
    is_nonneg(isucc(isucc(isucc(isucc(IZERO)))))
    [by specialize int_divides.nonnegSucc(isucc(isucc(isucc(IZERO)))) three-nonneg]
  @five-nonneg |
    is_nonneg(isucc(isucc(isucc(isucc(isucc(IZERO))))))
    [by specialize int_divides.nonnegSucc(isucc(isucc(isucc(isucc(IZERO))))) four-nonneg]
  @conclusion |
    mod_n.less_than(IZERO, SIX)
    [by specialize int_divides.succOfNonnegIsPositive(isucc(isucc(isucc(isucc(isucc(IZERO)))))) five-nonneg]
qed

// ℤ_6 = the ℤ_n theory at N := 6. Map ONLY the parameter N to 6; leave the sort and
// operations as the template's own symbols; discharge the structural axioms by
// self-mapping and the single value-dependent axiom (nPositive) with sixPositive.
model Z6 {
  mod_n.N: SIX
  mod_n.nPositive <- sixPositive
}

// PAYOFF — the corpus transfers to the N := 6 instance for free.

// ℤ_6 is a group (associativity, as one representative fact).
theorem z6AddAssoc: forall x, y, z: mod_n.Zn; mod_n.add(mod_n.add(x, y), z) = mod_n.add(x, mod_n.add(y, z))
proof
  @conclusion |
    forall x, y, z: mod_n.Zn; mod_n.add(mod_n.add(x, y), z) = mod_n.add(x, mod_n.add(y, z))
    [by model(Z6) mod_n.addAssoc]
qed

// ℤ_6 is cyclic, generated by cls(1).
theorem z6IsCyclic: forall z: mod_n.Zn; exists k: integer.Int; z = mod_n.znPower(mod_n.cls(integer.ONE), k)
proof
  @conclusion |
    forall z: mod_n.Zn; exists k: integer.Int; z = mod_n.znPower(mod_n.cls(integer.ONE), k)
    [by model(Z6) mod_n.znIsCyclic]
qed
