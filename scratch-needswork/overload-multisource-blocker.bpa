import integer <<< "../std/integer.bpa"
import int_divides <<< "../std/integer/divides.bpa"
import mod_n <<< "../std/integer/mod-n.bpa"

// foreign "integer" carrier + ops
sort MyInt
const MZERO: MyInt
const MONE: MyInt
func madd(a: MyInt, b: MyInt): MyInt
func mneg(a: MyInt): MyInt
func msub(a: MyInt, b: MyInt): MyInt
func mmul(a: MyInt, b: MyInt): MyInt
func msucc(a: MyInt): MyInt
func mprev(a: MyInt): MyInt
pred mless(a: MyInt, b: MyInt)

// foreign Zn carrier + ops
sort MyZn
const MZnZERO: MyZn
func mzadd(x: MyZn, y: MyZn): MyZn
func mzneg(x: MyZn): MyZn
func mcls(k: MyInt): MyZn
func mzpower(x: MyZn, k: MyInt): MyZn
const MN: MyInt

// discharge mod_n's OWN axioms (posit the foreign versions)
axiom mnPos: mless(MZERO, MN)
axiom mclsSurj: forall z: MyZn; exists k: MyInt; z = mcls(k)
axiom mzeroCls: MZnZERO = mcls(MZERO)
axiom maddHom: forall a, b: MyInt; mzadd(mcls(a), mcls(b)) = mcls(madd(a, b))
axiom maddZeroLeft: forall a: MyInt; madd(MZERO, a) = a

model TryTransfer {
  mod_n.Int: MyInt
  mod_n.iadd: madd
  mod_n.ineg: mneg
  mod_n.isub: msub
  mod_n.imul: mmul
  mod_n.isucc: msucc
  mod_n.iprev: mprev
  mod_n.IZERO: MZERO
  mod_n.IONE: MONE
  mod_n.N: MN
  mod_n.Zn: MyZn
  mod_n.ZERO: MZnZERO
  mod_n.add: mzadd
  mod_n.neg: mzneg
  mod_n.cls: mcls
  mod_n.znPower: mzpower
  mod_n.nPositive <- mnPos
  mod_n.clsSurjective <- mclsSurj
  mod_n.zeroIsClsZero <- mzeroCls
  mod_n.addHom <- maddHom
  integer.addZeroLeft <- maddZeroLeft
}

// TRANSFER addAssoc — with NO ℤ ring-axiom discharge provided. Does it error?
theorem myZnAddAssoc: forall x, y, z: MyZn; mzadd(mzadd(x, y), z) = mzadd(x, mzadd(y, z))
proof
  @conclusion |
    forall x, y, z: MyZn; mzadd(mzadd(x, y), z) = mzadd(x, mzadd(y, z))
    [by model(TryTransfer) mod_n.addAssoc]
qed
